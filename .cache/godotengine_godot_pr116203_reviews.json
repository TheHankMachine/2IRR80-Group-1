[{"id":4048601283,"node_id":"PRR_kwDOAO6SJc7xUMDD","user":{"login":"clayjohn","id":16521339,"node_id":"MDQ6VXNlcjE2NTIxMzM5","avatar_url":"https://avatars.githubusercontent.com/u/16521339?u=e44a465cbebabb9ea2be80b59e6dc07966bef5b7&v=4","gravatar_id":"","url":"https://api.github.com/users/clayjohn","html_url":"https://github.com/clayjohn","followers_url":"https://api.github.com/users/clayjohn/followers","following_url":"https://api.github.com/users/clayjohn/following{/other_user}","gists_url":"https://api.github.com/users/clayjohn/gists{/gist_id}","starred_url":"https://api.github.com/users/clayjohn/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/clayjohn/subscriptions","organizations_url":"https://api.github.com/users/clayjohn/orgs","repos_url":"https://api.github.com/users/clayjohn/repos","events_url":"https://api.github.com/users/clayjohn/events{/privacy}","received_events_url":"https://api.github.com/users/clayjohn/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"Seems fine to me, but I would appreciate @DarioSamo taking a look before merging","state":"APPROVED","html_url":"https://github.com/godotengine/godot/pull/116203#pullrequestreview-4048601283","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/116203","author_association":"MEMBER","_links":{"html":{"href":"https://github.com/godotengine/godot/pull/116203#pullrequestreview-4048601283"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/116203"}},"submitted_at":"2026-04-02T06:19:31Z","commit_id":"16e30a445a6b74c48cea2392eb0de48dc45a9018"},{"id":4182177562,"node_id":"PRR_kwDOAO6SJc75Rvca","user":{"login":"DarioSamo","id":538504,"node_id":"MDQ6VXNlcjUzODUwNA==","avatar_url":"https://avatars.githubusercontent.com/u/538504?u=45f09996711edf524a11181d136e38113210b6ce&v=4","gravatar_id":"","url":"https://api.github.com/users/DarioSamo","html_url":"https://github.com/DarioSamo","followers_url":"https://api.github.com/users/DarioSamo/followers","following_url":"https://api.github.com/users/DarioSamo/following{/other_user}","gists_url":"https://api.github.com/users/DarioSamo/gists{/gist_id}","starred_url":"https://api.github.com/users/DarioSamo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/DarioSamo/subscriptions","organizations_url":"https://api.github.com/users/DarioSamo/orgs","repos_url":"https://api.github.com/users/DarioSamo/repos","events_url":"https://api.github.com/users/DarioSamo/events{/privacy}","received_events_url":"https://api.github.com/users/DarioSamo/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"The core problem here is that `material_set_shader` is not following a read-only constraint on shader and modifying it instead. Pushing the call to the command queue introduces a race between the mesh loading and the server thread where it'll fail to precompile pipelines in time if the command queue hasn't gotten to it yet.\r\n\r\nThe proper fix would be to fix `material_set_shader` instead. As it stands, the PR introduces a potential performance/stutter regression that will be very difficult to detect in the future as to why it happens.","state":"CHANGES_REQUESTED","html_url":"https://github.com/godotengine/godot/pull/116203#pullrequestreview-4182177562","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/116203","author_association":"CONTRIBUTOR","_links":{"html":{"href":"https://github.com/godotengine/godot/pull/116203#pullrequestreview-4182177562"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/116203"}},"submitted_at":"2026-04-27T15:28:21Z","commit_id":"16e30a445a6b74c48cea2392eb0de48dc45a9018"},{"id":4354508098,"node_id":"PRR_kwDOAO6SJc8AAAABA4yFQg","user":{"login":"clayjohn","id":16521339,"node_id":"MDQ6VXNlcjE2NTIxMzM5","avatar_url":"https://avatars.githubusercontent.com/u/16521339?u=e44a465cbebabb9ea2be80b59e6dc07966bef5b7&v=4","gravatar_id":"","url":"https://api.github.com/users/clayjohn","html_url":"https://github.com/clayjohn","followers_url":"https://api.github.com/users/clayjohn/followers","following_url":"https://api.github.com/users/clayjohn/following{/other_user}","gists_url":"https://api.github.com/users/clayjohn/gists{/gist_id}","starred_url":"https://api.github.com/users/clayjohn/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/clayjohn/subscriptions","organizations_url":"https://api.github.com/users/clayjohn/orgs","repos_url":"https://api.github.com/users/clayjohn/repos","events_url":"https://api.github.com/users/clayjohn/events{/privacy}","received_events_url":"https://api.github.com/users/clayjohn/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"This makes sense to me. The fact that we need a mutex here points to a design flaw IMO which should be explored later. But for now, this is a minimal safe fix for the issue. \n\nI tested locally and can confirm that this fixes https://github.com/godotengine/godot/issues/114896. Before this change I could repro the crash on about 20% of loads. After testing this code I tried loading the test scene a few dozen times and never experienced the crash once. \n\nI think we should merge this for 4.7 since this race condition is something that we see in the wild and haven't been able to debug well until now. ","state":"APPROVED","html_url":"https://github.com/godotengine/godot/pull/116203#pullrequestreview-4354508098","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/116203","author_association":"MEMBER","_links":{"html":{"href":"https://github.com/godotengine/godot/pull/116203#pullrequestreview-4354508098"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/116203"}},"submitted_at":"2026-05-25T06:03:05Z","commit_id":"f379b8400484cda50f245ab8fa07816950b96982"}]