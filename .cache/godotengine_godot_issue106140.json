roduce\n\nImport any texture with VRAM compression mode set.\n\n### Minimal reproduction project (MRP)\n\nAny empty project would fit.","closed_by":{"login":"longPtrCall","id":97166933,"node_id":"U_kgDOBcqmVQ","avatar_url":"https://avatars.githubusercontent.com/u/97166933?v=4","gravatar_id":"","url":"https://api.github.com/users/longPtrCall","html_url":"https://github.com/longPtrCall","followers_url":"https://api.github.com/users/longPtrCall/followers","following_url":"https://api.github.com/users/longPtrCall/following{/other_user}","gists_url":"https://api.github.com/users/longPtrCall/gists{/gist_id}","starred_url":"https://api.github.com/users/longPtrCall/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/longPtrCall/subscriptions","organizations_url":"https://api.github.com/users/longPtrCall/orgs","repos_url":"https://api.github.com/users/longPtrCall/repos","events_url":"https://api.github.com/users/longPtrCall/events{/privacy}","received_events_url":"https://api.github.com/users/longPtrCall/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/106140/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/godotengine/godot/issues/106140/timeline","performed_via_github_app":null,"state_reason":"completed","pinned_comment":null}