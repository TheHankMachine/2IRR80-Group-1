d8f8c2-5ac1-4957-9c38-5369103023c0\" />\r\n","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2576156607/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2576169906","html_url":"https://github.com/godotengine/godot/pull/101243#issuecomment-2576169906","issue_url":"https://api.github.com/repos/godotengine/godot/issues/101243","id":2576169906,"node_id":"IC_kwDOAO6SJc6ZjTuy","user":{"login":"Ivorforce","id":2308167,"node_id":"MDQ6VXNlcjIzMDgxNjc=","avatar_url":"https://avatars.githubusercontent.com/u/2308167?v=4","gravatar_id":"","url":"https://api.github.com/users/Ivorforce","html_url":"https://github.com/Ivorforce","followers_url":"https://api.github.com/users/Ivorforce/followers","following_url":"https://api.github.com/users/Ivorforce/following{/other_user}","gists_url":"https://api.github.com/users/Ivorforce/gists{/gist_id}","starred_url":"https://api.github.com/users/Ivorforce/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Ivorforce/subscriptions","organizations_url":"https://api.github.com/users/Ivorforce/orgs","repos_url":"https://api.github.com/users/Ivorforce/repos","events_url":"https://api.github.com/users/Ivorforce/events{/privacy}","received_events_url":"https://api.github.com/users/Ivorforce/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-01-07T20:32:59Z","updated_at":"2025-01-07T20:38:11Z","body":"I tested cache misses on `p_font_data->cache.find(p_size)` and I get no duplicate misses.\r\n\r\nI think a sanity check on my PR is in order.\r\n@bruvzg Can you confirm that the LRU cache (this branch) is reducing the time spent on `get_height`? I admit I'm not super experienced with profilers so perhaps I made a mistake somewhere along the way.\r\n\