[{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3299231337","html_url":"https://github.com/godotengine/godot/pull/110013#issuecomment-3299231337","issue_url":"https://api.github.com/repos/godotengine/godot/issues/110013","id":3299231337,"node_id":"IC_kwDOAO6SJc7EpkZp","user":{"login":"kilian-diener","id":58468519,"node_id":"MDQ6VXNlcjU4NDY4NTE5","avatar_url":"https://avatars.githubusercontent.com/u/58468519?v=4","gravatar_id":"","url":"https://api.github.com/users/kilian-diener","html_url":"https://github.com/kilian-diener","followers_url":"https://api.github.com/users/kilian-diener/followers","following_url":"https://api.github.com/users/kilian-diener/following{/other_user}","gists_url":"https://api.github.com/users/kilian-diener/gists{/gist_id}","starred_url":"https://api.github.com/users/kilian-diener/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/kilian-diener/subscriptions","organizations_url":"https://api.github.com/users/kilian-diener/orgs","repos_url":"https://api.github.com/users/kilian-diener/repos","events_url":"https://api.github.com/users/kilian-diener/events{/privacy}","received_events_url":"https://api.github.com/users/kilian-diener/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-09-16T15:12:56Z","updated_at":"2025-09-16T15:12:56Z","body":"Hei can somebody help me on the dbus/udev topic on Linux? Or give me some pointers how to test and find out if the current setup is sufficient? Maybe @Nintorch you have some insights into it form doing it for 4.x","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3299231337/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3299245159","html_url":"https://github.com/godotengine/g