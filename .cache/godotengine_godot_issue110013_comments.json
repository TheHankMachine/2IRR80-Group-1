ithubusercontent.com/u/21999379?v=4","gravatar_id":"","url":"https://api.github.com/users/lawnjelly","html_url":"https://github.com/lawnjelly","followers_url":"https://api.github.com/users/lawnjelly/followers","following_url":"https://api.github.com/users/lawnjelly/following{/other_user}","gists_url":"https://api.github.com/users/lawnjelly/gists{/gist_id}","starred_url":"https://api.github.com/users/lawnjelly/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/lawnjelly/subscriptions","organizations_url":"https://api.github.com/users/lawnjelly/orgs","repos_url":"https://api.github.com/users/lawnjelly/repos","events_url":"https://api.github.com/users/lawnjelly/events{/privacy}","received_events_url":"https://api.github.com/users/lawnjelly/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-10-21T17:00:27Z","updated_at":"2025-10-21T17:00:27Z","body":"I must admit I'm slightly concerned this adds 153K lines of code for presumably fixing a few bugs in gamepad handling, which is presumably only needing small changes. :thinking: \r\n\r\nMaster has had large increases in the time taken to compile the engine so we have to ensure this doesn't spread to 3.x .. what are the compile times for a full rebuild before / after for comparison?","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3427801010/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3431418787","html_url":"https://github.com/godotengine/godot/pull/110013#issuecomment-3431418787","issue_url":"https://api.github.com/repos/godotengine/godot/issues/110013","id":3431418787,"node_id":"IC_kwDOAO6SJc7Mh0uj","user":{"login":"kilian-diener","id":58468519,"node_id":"MDQ6VXNlcjU4NDY4NTE5","avatar_url":"https://avatars.githubusercontent.com/u/58468519?v=4","gravatar_id":"","url":"https://api.github.com/users/kilian-diener","html_url":"https://github.com/kilian-diener","followers_url":"https://api.github.com/users/kilian-diener/followers","following_url":"https://api.github.com/users/kilian-diener/following{/other_user}","gists_url":"https://api.github.com/users/kilian-diener/gists{/gist_id}","starred_url":"https://api.github.com/users/kilian-diener/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/kilian-diener/subscriptions","organizations_url":"https://api.github.com/users/kilian-diener/orgs","repos_url":"https://api.github.com/users/kilian-diener/repos","events_url":"https://api.github.com/users/kilian-diener/events{/privacy}","received_events_url":"https://api.github.com/users/kilian-diener/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-10-22T09:47:14Z","updated_at":"2025-10-22T09:47:14Z","body":"Did some measurements on my laptop: Intel Core Ultra 9 185H (22 threads) - 30.73 GiB memory - Nvidia 4070 Laptop - Arch 6.17.2 with GCC 15.2.1\r\nEditor command: scons platform=x11/windows target=release_debug\r\nTemplate command: scons platform=x11/windows tools=no target=release bits=64\r\nInbetween each run did the same command with -c to clean up.\r\n\r\nLinux:\r\n|         | Editor Build Time | Editor Size | Editor Size Stripped | Template Build Time | Template Size | Template Size Stripped |\r\n|---------|-------------|-------------|----------------------|---------------|---------------|------------------------|\r\n| 3.x     |        5:18 |       889.1MB |                 71.5MB |          3:23 |         514.3MB |                   39.7MB |\r\n| 3.x SDL |        5:25 |       891.2MB |                   72MB |          3:27 |         516.7MB |                   40.2MB |\r\n| Difference |        0:07 |       2.1MB |                0.5MB |          0:04 |         2.4MB |                  0.5MB |\r\n\r\nWindows:\r\n|         | Editor Build Time | Editor Size | Editor Size Stripped | Template Build Time | Template Size | Template Size Stripped |\r\n|---------|-------------|-------------|----------------------|---------------|---------------|------------------------|\r\n| 3.x     |        5:19 |       939.5MB |                 71.7MB |          3:22 |           530MB |                   38.8MB |\r\n| 3.x SDL |        5:25 |       942.9MB |                 72.2MB |          3:27 |         534.5MB |                   39.4MB |\r\n| Difference |        0:06 |       3.4MB |                0.5MB |          0:05 |         4.5MB |                  0.6MB |\r\n\r\nLet me know if you need more information.","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3431418787/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3432339017","html_url":"https://github.com/godotengine/godot/pull/110013#issuecomment-3432339017","issue_url":"https://api.github.com/repos/godotengine/godot/issues/110013","id":3432339017,"node_id":"IC_kwDOAO6SJc7MlVZJ","user":{"login":"lawnjelly","id":21999379,"node_id":"MDQ6VXNlcjIxOTk5Mzc5","avatar_url":"https://avatars.githubusercontent.com/u/21999379?v=4","gravatar_id":"","url":"https://api.github.com/users/lawnjelly","html_url":"https://github.com/lawnjelly","followers_url":"https://api.github.com/users/lawnjelly/followers","following_url":"https://api.github.com/users/lawnjelly/following{/other_user}","gists_url":"https://api.github.com/users/lawnjelly/gists{/gist_id}","starred_url":"https://api.github.com/users/lawnjelly/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/lawnjelly/subscriptions","organizations_url":"https://api.github.com/users/lawnjelly/orgs","repos_url":"https://api.github.com/users/lawnj