sers/Repiteo/subscriptions","organizations_url":"https://api.github.com/users/Repiteo/orgs","repos_url":"https://api.github.com/users/Repiteo/repos","events_url":"https://api.github.com/users/Repiteo/events{/privacy}","received_events_url":"https://api.github.com/users/Repiteo/received_events","type":"User","user_view_type":"public","site_admin":false},"open_issues":345,"closed_issues":2336,"state":"open","created_at":"2026-04-13T15:59:35Z","updated_at":"2026-10-22T08:21:32Z","due_on":null,"closed_at":null},"comments":5,"created_at":"2026-09-22T11:56:23Z","updated_at":"2026-10-02T08:35:15Z","closed_at":"2026-10-01T15:58:31Z","assignee":null,"author_association":"NONE","issue_field_values":[],"type":null,"active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"### Tested versions\n\n- Reproducible in: 4.8-dev6\n- Not reproducible in: 4.8-dev5\n\n### System information\n\nSteam Deck / SteamOS Linux x86_64 export\n\n### Issue description\n\nAfter updating my build from 4.8-dev5 to 4.8-dev6, the Steam Deck built-in controls stopped working in my exported Linux build.\n\nThe game still launches and runs normally, but it does not respond to the Deck controls. Building the same project with 4.8-dev5 restores input.\n\nThe only relevant change in my build pipeline was moving from the 4.8-dev5 export image to 4.8-dev6. Since 4.8-dev6 includes the SDL 3.4.16 update from #120373, this may be related.\n\nI also tried launching with:\n\nSDL_JOYSTICK_HIDAPI_STEAMDECK=0 SDL_JOYSTICK_HIDAPI_STEAM=0 %command%\n\nThat did not change the behavior.\n\n### Steps to reproduce\n\n1. Export a Linux x86_64 build with Godot 4.8-dev6.\n2. Run it on Steam Deck.\n3. Try to use the built-in Steam Deck controls.\n4. The game runs, but does not respond to input.\n5. Export the same project with Godot 4.8-dev5.\n6. Run that build on the same Steam Deck.\n7. Input works again.\n\n### Minimal reproduction project (MRP)\n\nI don't have a minimal project yet. This was found in my game project, but the same project works when exported with 4.8-dev5 and breaks when exported with 4.8-dev6.","closed_by":{"login":"Repiteo","id":17489292,"node_id":"MDQ6VXNlcjE3NDg5Mjky","avatar_url":"https://avatars.githubusercontent.com/u/17489292?v=4","gravatar_id":"","url":"https://api.github.com/users/Repiteo","html_url":"https://github.com/Repiteo","followers_url":"https://api.github.com/users/Repiteo/followers","following_url":"https://api.github.com/users/Repiteo/following{/other_user}","gists_url":"https://api.github.com/users/Repiteo/gists{/gist_id}","starred_url":"https://api.github.com/users/Repiteo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Repiteo/subscriptions","organizations_url":"https://api.github.com/users/Repiteo/orgs","repos_url":"https://api.github.com/users/Repiteo/repos","events_url":"https://api.github.com/users/Repiteo/events{/privacy}","received_events_url":"https://api.github.com/users/Repiteo/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/123704/reactions","total_count":3,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":3},"timeline_url":"https://api.github.com/repos/godotengine/godot/issues/123704/timeline","performed_via_github_app":null,"state_reason":"completed","pinned_comment":null}