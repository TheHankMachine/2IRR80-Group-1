120481.patch","merged_at":"2026-06-22T17:34:12Z"},"body":"## What problem(s) does this PR solve?\r\n\r\n- Closes https://github.com/godotengine/godot/issues/120414\r\n\r\n## Additional information\r\nRight-clicking a section header inside the \"Favorites\" category did not open the context menu.\r\n\r\nThis was caused by an over-guard in EditorInspectorSection::gui_input, which checked for !inspector_path.is_empty(). The right-click event was ignored since favorites don't use inspector_path,\r\n\r\nThis PR removes the !inspector_path.is_empty() condition from the else if block.\r\n\r\nThere shoud be no side effects because the methods in this block do not rely on inspector_path and the remaining conditions are mutually exclusive to the other logic paths in this function.","closed_by":{"login":"Repiteo","id":17489292,"node_id":"MDQ6VXNlcjE3NDg5Mjky","avatar_url":"https://avatars.githubusercontent.com/u/17489292?v=4","gravatar_id":"","url":"https://api.github.com/users/Repiteo","html_url":"https://github.com/Repiteo","followers_url":"https://api.github.com/users/Repiteo/followers","following_url":"https://api.github.com/users/Repiteo/following{/other_user}","gists_url":"https://api.github.com/users/Repiteo/gists{/gist_id}","starred_url":"https://api.github.com/users/Repiteo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Repiteo/subscriptions","organizations_url":"https://api.github.com/users/Repiteo/orgs","repos_url":"https://api.github.com/users/Repiteo/repos","events_url":"https://api.github.com/users/Repiteo/events{/privacy}","received_events_url":"https://api.github.com/users/Repiteo/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/120481/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/godotengine/godot/issues/120481/timeline","performe