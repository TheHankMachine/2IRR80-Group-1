BldY","user":{"login":"comminux","id":14937307,"node_id":"MDQ6VXNlcjE0OTM3MzA3","avatar_url":"https://avatars.githubusercontent.com/u/14937307?v=4","gravatar_id":"","url":"https://api.github.com/users/comminux","html_url":"https://github.com/comminux","followers_url":"https://api.github.com/users/comminux/followers","following_url":"https://api.github.com/users/comminux/following{/other_user}","gists_url":"https://api.github.com/users/comminux/gists{/gist_id}","starred_url":"https://api.github.com/users/comminux/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/comminux/subscriptions","organizations_url":"https://api.github.com/users/comminux/orgs","repos_url":"https://api.github.com/users/comminux/repos","events_url":"https://api.github.com/users/comminux/events{/privacy}","received_events_url":"https://api.github.com/users/comminux/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-01-04T15:26:56Z","updated_at":"2026-01-04T15:26:56Z","body":"@deralmas Excuse me, could you look at this problem?","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3708180312/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3712067991","html_url":"https://github.com/godotengine/godot/issues/111560#issuecomment-3712067991","issue_url":"https://api.github.com/repos/godotengine/godot/issues/111560","id":3712067991,"node_id":"IC_kwDOAO6SJc7dQamX","user":{"login":"deralmas","id":31065808,"node_id":"MDQ6VXNlcjMxMDY1ODA4","avatar_url":"https://avatars.githubusercontent.com/u/31065808?v=4","gravatar_id":"","url":"https://api.github.com/users/deralmas","html_url":"https://github.com/deralmas","followers_url":"https://api.github.com/users/deralmas/followers","following_url":"https://api.github.com/users/deralmas/following{/other_user}","gists_url":"https://api.github.com/users/deralmas/gists{/gist_id}","starred_url":"https://api.github.com/users/deralmas/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/deralmas/subscriptions","organizations_url":"https://api.github.com/users/deralmas/orgs","repos_url":"https://api.github.com/users/deralmas/repos","events_url":"https://api.github.com/users/deralmas/events{/privacy}","received_events_url":"https://api.github.com/users/deralmas/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-01-05T21:00:07Z","updated_at":"2026-01-05T21:00:07Z","body":"Hi, thank you for reporting!\n\nI can't seem to replicate it as of commit 5cb1ec590 on sway 1.11.\n\nCould you please send me a debug log?\n\n```\nWAYLAND_DEBUG=1 path/to/godot --verbose 2>&1 | tee debug.log\n```\n\nPlease note that this is a Wayland protocol dump and will include any input sent to the editor.","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3712067991/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3727732852","html_url":"https://github.com/godotengine/godot/issues/111560#issuecomment-3727732852","issue_url":"https://api.github.com/repos/godotengine/godot/issues/111560","id":3727732852,"node_id":"IC_kwDOAO6SJc7eMLB0","user":{"login":"comminux","id":14937307,"node_id":"MDQ6VXNlcjE0OTM3MzA3","avatar_url":"https://avatars.githubusercontent.com/u/14937307?v=4","gravatar_id":"","url":"https://api.github.com/users/comminux","html_url":"https://github.com/comminux","followers_url":"https://api.github.com/users/comminux/followers","following_url":"https://api.github.com/users/comminux/following{/other_user}","gists_url":"https://api.github.com/users/comminux/gists{/gist_id}","starred_url":"https://api.github.com/users/comminux/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/comminux/subscriptions","organizations_url":"https://api.github.com/users/comminux/orgs","repos_url":"https://api.github.com/users/comminux/repos","events_url":"https://api.github.com/users/comminux/events{/privacy}","received_events_url":"https://api.github.com/users/comminux/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-01-09T08:24:05Z","updated_at":"2026-01-09T08:36:33Z","body":"I have prepared the required log and screen recording.\n\n[debug.log](https://github.com/user-attachments/files/24522655/debug.log)\n\nhttps://youtu.be/aqrQrwoG5jg\n\ngnome-shell 49.2\ngodot v4.6.beta.custom_build [6f15a05b6]","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3727732852/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3765247206","html_url":"https://github.com/godotengine/godot/issues/111560#issuecomment-3765247206","issue_url":"https://api.github.com/repos/godotengine/godot/issues/111560","id":3765247206,"node_id":"IC_kwDOAO6SJc7gbRzm","user":{"login":"deralmas","id":31065808,"node_id":"MDQ6VXNlcjMxMDY1ODA4","avatar_url":"https://avatars.githubusercontent.com/u/31065808?v=4","gravatar_id":"","url":"https://api.github.com/users/deralmas","html_url":"https://github.com/deralmas","followers_url":"https://api.github.com/users/deralmas/followers","following_url":"https://api.github.com/users/deralmas/following{/other_user}","gists_url":"https://api.github.com/users/deralmas/gists{/gist_id}","starred_url":"https://api.github.com/users/deralmas/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/deralmas/subscriptions","organizations_url":"https://api.github.com/users/deralmas/orgs","repos_url":"https://api.github.com/users/deralmas/repos","events_url":"https://api.github.com/users/deralmas/events{/privacy}","received_events_url":"https://api.github.com/users/deralmas/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-01-18T12:37:10Z","updated_at":"2026-01-18T12:37:10Z","body":"Hi, I can replicate this in a VM with Fedora 43, gnome 49.2. The weird thing is that this seems to happen only at 1.25 scale. Grepping for `xdg_popup` in `WAYLAND_DEBUG`, I can see an infinite loop where the popup gets immediately dismissed by the compositor `(xdg_popup.popup_done)` after it gets configured. Note that it does not happen on sway even with various fractional scales.\n\nI'm seriously not sure what (if anything) we are doing wrong. As a matter of fact, [`xdg_popup::popup_done`](https://wayland.app/protocols/xdg-shell#xdg_popup:event:popup_done) is an event that we can't trigger ourselves. The spec talks about dismissing a popup by destroying it, but I'm pretty sure that deleting an `xdg_popup` does not trigger said event. It's more like a server-initiated destructor.\n\nMaybe it's a compositor bug? Can't find much in the bug tracker and I'm not even sure where to start. It's so oddly specific and precise. Moving and resizing the window around doesn't change much either.\n\nI tried running the latest mutter commit in the VM from a `toolbx` container like per the docs, but I could not figure out how to enable fractional scale there. Maybe you could give `mutter-git` a try since you have the AUR at hand.","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3765247206/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3765498017","html_url":"https://github.com/godotengine/godot/issues/111560#issuecomment-3765498017","issue_url":"https://api.github.com/repos/godotengine/godot/issues/111560","id":3765498017,"node_id":"IC_kwDOAO6SJc7gcPCh","user":{"login":"comminux","id":14937307,"node_id":"MDQ6VXNlcjE0OTM3MzA3","avatar_url":"https://avatars.githubusercontent.com/u/14937307?v=4","gravatar_id":"","url":"https://api.github.com/users/comminux","html_url":"https://github.com/comminux","followers_url":"https://api.github.com/users/comminux/followers","following_url":"https://api.github.com/users/comminux/following{/other_user}","gists_url":"https://api.github.com/users/comminux/gists{/gist_id}","starred_url":"https://api.github.com/users/comminux/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/comminux/subscriptions","organizations_url":"https://api.github.com/users/comminux/orgs","repos_url":"https://api.github.com/users/comminux/repos","events_url":"https://api.github.com/users/comminux/events{/privacy}","received_events_url":"https://api.github.com/users/comminux/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-01-18T17:01:53Z","updated_at":"2026-01-18T17:09:24Z","body":"I enabled the gnome-unstable repository and replicated the issue on gnome-shell 50alpha-1.\nI'm currently using KDE, where even at 125% zoom, all menus open correctly.\n\nNothing to add yet, but if I have anything useful, I'll share it in this issue.\n\nI might check this patch a little later: https://gitlab.gnome.org/GNOME/mutter/-/issues/4465#note_2621375\nDon't know how relevant it will be.","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3765498017/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3765583371","html_url":"https://github.com/godotengine/godot/issues/111560#issuecomment-3765583371","issue_url":"https://api.github.com/repos/godotengine/godot/issues/111560","id":3765583371,"node_id":"IC_kwDOAO6SJc7gcj4L","user":{"login":"comminux","id":14937307,"node_id":"MDQ6VXNlcjE0OTM3MzA3","avatar_url":"https://avatars.githubusercontent.com/u/14937307?v=4","gravatar_id":"","url":"https://api.github.com/users/comminux","html_url":"https://github.com/comminux","followers_url":"https://api.github.com/users/comminux/followers","following_url":"https://api.github.com/users/comminux/following{/other_user}","gists_url":"https://api.github.com/users/comminux/gists{/gist_id}","starred_url":"https://api.github.com/users/comminux/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/comminux/subscriptions","organizations_url":"https://api.github.com/users/comminux/orgs","repos_url":"https://api.github.com/users/comminux/repos","events_url":"https://api.github.com/users/comminux/events{/privacy}","received_events_url":"https://api.github.com/users/comminux/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-01-18T18:32:51Z","updated_at":"2026-01-18T20:39:49Z","body":"Patch for mutter didn't change the behavior in any way.\n\nHowever, I'd like to point out that the issue with the View menu items only occurs in the 2D toolbar, not in 3D. It seems to me there's some difference between the two menus. Could you please tell me which engine files define this behavior?\n\nScaling settings can be accessed by right-clicking on the desktop in the Display Settings submenu.\n\nUpdate. You are right, the scaling settings in Gnome also have an effect.\n\n<img width=\"1920\" height=\"1080\" alt=\"Image\" src=\"https://github.com/user-attachments/assets/2af097cd-0c58-4463-b90a-b8806afef80f\" />\n\nGnome scale 100%, Godot 125%:\n<img width=\"1188\" height=\"589\" alt=\"Image\" src=\"https://github.com/user-attachments/assets/22c0ee01-e31a-47a5-b817-3d7a1854b6ff\" />\n\nGnome scale 125%, Godot 125%:\n<img width=\"1485\" height=\"736\" alt=\"Image\" src=\"https://github.com/user-attachments/assets/cea5c03e-d0a8-48af-990d-baa63bae500c\" />\n\nI was also able to reproduce the problem with 125% scaling in Gnome and 100% scaling in Godot.\n\nOpen issue in the Mutter repository: https://gitlab.gnome.org/GNOME/mutter/-/issues/4562","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3765583371/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3767832740","html_url":"https://github.com/godotengine/godot/issues/111560#issuecomment-3767832740","issue_url":"https://api.github.com/repos/godotengine/godot/issues/111560","id":3767832740,"node_id":"IC_kwDOAO6SJc7glJCk","user":{"login":"deralmas","id":31065808,"node_id":"MDQ6VXNlcjMxMDY1ODA4","avatar_url":"https://avatars.githubusercontent.com/u/31065808?v=4","gravatar_id":"","url":"https://api.github.com/users/deralmas","html_url":"https://github.com/deralmas","followers_url":"https://api.github.com/users/deralmas/followers","following_url":"https://api.github.com/users/deralmas/following{/other_user}","gists_url":"https://api.github.com/users/deralmas/gists{/gist_id}","starred_url":"https://api.github.com/users/deralmas/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/deralmas/subscriptions","organizations_url":"https://api.github.com/users/deralmas/orgs","repos_url":"https://api.github.com/users/deralmas/repos","events_url":"https://api.github.com/users/deralmas/events{/privacy}","received_events_url":"https://api.github.com/users/deralmas/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-01-19T11:23:21Z","updated_at":"2026-01-19T11:23:21Z","body":"> However, I'd like to point out that the issue with the View menu items only occurs in the 2D toolbar, not in 3D. It seems to me there's some difference between the two menus.\n\nI'm not aware of any substantial difference, outside of the relative position in the window. The protocol dump didn't report anything out of the ordinary either. I just now noticed a warning but it feels like a consequence of the bug, not the way around:\n\n```\nWARNING: _activate_submenu should not be called on an open submenu - index: 0.\n     at: _activate_submenu (scene/gui/popup_menu.cpp:356)\n```\n\n> Could you please tell me which engine files define this behavior?\n\nHere is the initialization logic for the \"Grid\" submenu:\n\nhttps://github.com/godotengine/godot/blob/5f9a510441dec2322f68427cb73b13da9357eb73/editor/scene/canvas_item_editor_plugin.cpp#L5912-L5920\n\nAnd here is the initialization logic for the \"Gizmos\" submenu (before getting procedurally filled with other stuff):\n\nhttps://github.com/godotengine/godot/blob/5f9a510441dec2322f68427cb73b13da9357eb73/editor/scene/3d/node_3d_editor_plugin.cpp#L10008-L10012\n\nIt's all pretty generic stuff through the `PopupMenu` API. The fact that this works on other compositors is weird. Maybe it's a compositor bug but I'm not really sure how.\n\n> Scaling settings can be accessed by right-clicking on the desktop in the Display Settings submenu.\n\nI tried but unfortunately the dummy display used for the mutter devkit option seems to enable only integer scale by default. I'm not sure how to make it accept fractional scales. When run directly in the VM it accepts fractional scaling fine.","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3767832740/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4470206580","html_url":"https://github.com/godotengine/godot/issues/111560#issuecomment-4470206580","issue_url":"https://api.github.com/repos/godotengine/godot/issues/111560","id":4470206580,"node_id":"IC_kwDOAO6SJc8AAAABCnHwdA","user":{"login":"comminux","id":14937307,"node_id":"MDQ6VXNlcjE0OTM3MzA3","avatar_url":"https://avatars.githubusercontent.com/u/14937307?v=4","gravatar_id":"","url":"https://api.github.com/users/comminux","html_url":"https://github.com/comminux","followers_url":"https://api.github.com/users/comminux/followers","following_url":"https://api.github.com/users/comminux/following{/other_user}","gists_url":"https://api.github.com/users/comminux/gists{/gist_id}","starred_url":"https://api.github.com/users/comminux/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/comminux/subscriptions","organizations_url":"https://api.github.com/users/comminux/orgs","repos_url":"https://api.github.com/users/comminux/repos","events_url":"https://api.github.com/users/comminux/events{/privacy}","received_events_url":"https://api.github.com/users/comminux/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-05-17T09:52:07Z","updated_at":"2026-05-17T09:52:07Z","body":"I ran a fresh test of godot v4.7.beta.custom_build [321b8c944] in Gnome 50.1 and the problem is solved!","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4470206580/reactions","total_count":1,"+1":0,"-1":0,"laugh":0,"hooray":1,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null}]