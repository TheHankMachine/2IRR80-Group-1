[{"id":2831657425,"node_id":"PRR_kwDOAO6SJc6ox6nR","user":{"login":"raulsntos","id":3903059,"node_id":"MDQ6VXNlcjM5MDMwNTk=","avatar_url":"https://avatars.githubusercontent.com/u/3903059?u=1b0467024f137e562b21748eb6bf12f97dfa5bf6&v=4","gravatar_id":"","url":"https://api.github.com/users/raulsntos","html_url":"https://github.com/raulsntos","followers_url":"https://api.github.com/users/raulsntos/followers","following_url":"https://api.github.com/users/raulsntos/following{/other_user}","gists_url":"https://api.github.com/users/raulsntos/gists{/gist_id}","starred_url":"https://api.github.com/users/raulsntos/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/raulsntos/subscriptions","organizations_url":"https://api.github.com/users/raulsntos/orgs","repos_url":"https://api.github.com/users/raulsntos/repos","events_url":"https://api.github.com/users/raulsntos/events{/privacy}","received_events_url":"https://api.github.com/users/raulsntos/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"Thanks for contributing to the .NET module. I read through the issue and it seems like you've looked a lot into this.\r\n\r\nThe PR https://github.com/godotengine/godot/pull/105262 adds a preload hook to retrieve the assemblies directly from the APK, so it shouldn't load the assemblies from the cache directory. However, we're using `api_assemblies_dir`:\r\n\r\nhttps://github.com/godotengine/godot/blob/19bb18716ef08b811fec330cba4d35fbdb027bcc/modules/mono/mono_gd/gd_mono.cpp#L497-L498\r\n\r\nAs you found, we left the code for extracting assemblies to the cache directory. It seems this sets the `api_assemblies_dir` value to the cache path, defeating the purpose of https://github.com/godotengine/godot/pull/105262:\r\n\r\nhttps://github.com/godotengine/godot/blob/19bb18716ef08b811fec330cba4d35fbdb027bcc/modules/mono/godotsharp_dirs.cpp#L206\r\n\r\nAt the time I was thinking leaving that code as-is would serve as a fallback, but it's taking precedence instead. That was an oversight on my part.\r\n\r\nI think Android is the only platform where we were using the extracting mechanism, so we should consider removing it altogether. But I would have to confirm this, since a lot has changed since this code was introduced.\r\n\r\nFor the time being, your PR addresses the issue nicely.","state":"APPROVED","html_url":"https://github.com/godotengine/godot/pull/105853#pullrequestreview-2831657425","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/105853","author_association":"MEMBER","_links":{"html":{"href":"https://github.com/godotengine/godot/pull/105853#pullrequestreview-2831657425"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/105853"}},"submitted_at":"2025-05-12T03:11:50Z","commit_id":null},{"id":2832790211,"node_id":"PRR_kwDOAO6SJc6o2PLD","user":{"login":"akien-mga","id":4701338,"node_id":"MDQ6VXNlcjQ3MDEzMzg=","avatar_url":"https://avatars.githubusercontent.com/u/4701338?u=4a42fd867f2c449fcc23adf635dd574dae98e6c2&v=4","gravatar_id":"","url":"https://api.github.com/users/akien-mga","html_url":"https://github.com/akien-mga","followers_url":"https://api.github.com/users/akien-mga/followers","following_url":"https://api.github.com/users/akien-mga/following{/other_user}","gists_url":"https://api.github.com/users/akien-mga/gists{/gist_id}","starred_url":"https://api.github.com/users/akien-mga/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/akien-mga/subscriptions","organizations_url":"https://api.github.com/users/akien-mga/orgs","repos_url":"https://api.github.com/users/akien-mga/repos","events_url":"https://api.github.com/users/akien-mga/events{/privacy}","received_events_url":"https://api.github.com/users/akien-mga/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"","state":"APPROVED","html_url":"https://github.com/godotengine/godot/pull/105853#pullrequestreview-2832790211","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/105853","author_association":"MEMBER","_links":{"html":{"href":"https://github.com/godotengine/godot/pull/105853#pullrequestreview-2832790211"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/105853"}},"submitted_at":"2025-05-12T10:53:46Z","commit_id":"b99baa38f11e10534a9401f82184cae742702858"}]