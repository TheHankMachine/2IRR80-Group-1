api.github.com/users/Calinou/followers","following_url":"https://api.github.com/users/Calinou/following{/other_user}","gists_url":"https://api.github.com/users/Calinou/gists{/gist_id}","starred_url":"https://api.github.com/users/Calinou/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Calinou/subscriptions","organizations_url":"https://api.github.com/users/Calinou/orgs","repos_url":"https://api.github.com/users/Calinou/repos","events_url":"https://api.github.com/users/Calinou/events{/privacy}","received_events_url":"https://api.github.com/users/Calinou/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-08-20T16:25:21Z","updated_at":"2026-08-20T16:25:21Z","body":"Rebased and tested again, it works as expected.\r\n\r\n> I think once the comment from Kaleb about `bg_energy_multiplier` has been addressed this should be good to merge.\r\n\r\nDone.","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5358738203/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5359753948","html_url":"https://github.com/godotengine/godot/pull/112178#issuecomment-5359753948","issue_url":"https://api.github.com/repos/godotengine/godot/issues/112178","id":5359753948,"node_id":"IC_kwDOAO6SJc8AAAABP3da3A","user":{"login":"allenwp","id":17506573,"node_id":"MDQ6VXNlcjE3NTA2NTcz","avatar_url":"https://avatars.githubusercontent.com/u/17506573?v=4","gravatar_id":"","url":"https://api.github.com/users/allenwp","html_url":"https://github.com/allenwp","followers_url":"https://api.github.com/users/allenwp/followers","following_url":"https://api.github.com/users/allenwp/following{/other_user}","gists_url":"https://api.github.com/users/allenwp/gists{/gist_id}","starred_url":"https://api.github.com/users/allenwp/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/allenwp/subscriptions","organizations_url":"https://api.github.com/users/allenwp/orgs","repos_url":"https://api.github.com/users/allenwp/repos","events_url":"https://api.github.com/users/allenwp/events{/privacy}","received_events_url":"https://api.github.com/users/allenwp/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-08-20T18:00:20Z","updated_at":"2026-08-20T18:00:20Z","body":"> > I think once the comment from Kaleb about `bg_energy_multiplier` has been addressed this should be good to merge.\r\n> \r\n> Done.\r\n\r\nHmm. I assumed in my comment that this needed to be applied to both Compatibility and RD... But doing so causes a difference between Compatibility and Mobile...\r\n\r\nLeft is compatibility, right is Mobile:\r\n<img width=\"3838\" height=\"2095\" alt=\"image\" src=\"https://github.com/user-attachments/assets/580394b4-5880-495d-a9a0-cb6c0cfb487a\" />\r\n\r\nIs that maybe because of `ubo.ambient_light_color_energy` being used in the shader such that it's not needed for the `color` in this case or something?\r\n\r\nIf I remove multiplying in the background energy in Compatibility only, I get this:\r\n\r\n<img width=\"3838\" height=\"2092\" alt=\"image\" src=\"https://github.com/user-attachments/assets/186b95dd-bf65-427f-96ba-fdec7a670161\" />\r\n\r\nSo maybe I was wrong in believing it was needed in both cases?","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5359753948/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5528252364","html_url":"https://github.com/godotengine/godot/pull/112178#issuecomment-5528252364","issue_url":"https://api.github.com/repos/godotengine/godot/issues/112178","id":5528252364,"node_id":"IC_kwDOAO6SJc8AAAABSYJvzA","user":{"login":"Calinou","id":180032,"node_id":"MDQ6VXNlcjE4MDAzMg==","avatar_url":"https://avatars.githubusercontent.com/u/180032?v=4","gravatar_id":"","url":"https://api.github.com/users/Calinou","html_url":"https://github.com/Calinou","followers_url":"https://api.github.com/users/Calinou/followers","following_url":"https://api.github.com/users/Calinou/following{/other_user}","gists_url":"https://api.github.com/users/Calinou/gists{/gist_id}","starred_url":"https://api.github.com/users/Calinou/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Calinou/subscriptions","organizations_url":"https://api.github.com/users/Calinou/orgs","repos_url":"https://api.github.com/users/Calinou/repos","events_url":"https://api.github.com/users/Calinou/events{/privacy}","received_events_url":"https://api.github.com/users/Calinou/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-09-03T15:45:11Z","updated_at":"2026-09-07T23:04:10Z","body":"I rebased this PR and removed the multiplication by `bg_energy_multiplier` in Compatibility. However, since another specialization constant was added outside this PR (`material_feedback`), I get this in Mobile now:\r\n\r\n```\r\nERROR: This render pipeline requires (32) bytes of push constant data, supplied: (36)\r\n   at: draw_list_set_push_constant (servers/rendering/rendering_device.cpp:6114)\r\nERROR: The shader in this pipeline requires a push constant to be set before drawing, but it's not present.\r\n   at: draw_list_draw (servers/rendering/rendering_device.cpp:6147)\r\n```\r\n\r\nIt seems there's no more space in the push constant.","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5528252364/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5538309155","html_url":"https://github.com/godotengine/godot/pull/112178#issuecomment-5538309155","issue_url":"https://api.github.com/repos/godotengine/godot/issues/112178","id":5538309155,"node_id":"IC_kwDOAO6SJc8AAAABShvkIw","user":{"login":"blueskythlikesclouds","id":19259897,"node_id":"MDQ6VXNlcjE5MjU5ODk3","avatar_url":"https://avatars.githubusercontent.com/u/19259897?v=4","gravatar_id":"","url":"https://api.github.com/users/blueskythlikesclouds","html_url":"https://github.com/blueskythlikesclouds","followers_url":"https://api.github.com/users/blueskythlikesclouds/followers","following_url":"https://api.github.com/users/blueskythlikesclouds/following{/other_user}","gists_url":"https://api.github.com/users/blueskythlikesclouds/gists{/gist_id}","starred_url":"https://api.github.com/users/blueskythlikesclouds/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/blueskythlikesclouds/subscriptions","organizations_url":"https://api.github.com/users/blueskythlikesclouds/orgs","repos_url":"https://api.github.com/users/blueskythlikesclouds/repos","events_url":"https://api.github.com/users/blueskythlikesclouds/events{/privacy}","received_events_url":"https://api.github.com/users/blueskythlikesclouds/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-09-04T09:15:05Z","updated_at":"2026-09-04T09:15:05Z","body":"> It seems there's no more space in the push constant.\r\n\r\nLuminance multiplier can probably be turned into a bool since it's either 1.0 or 2.0, it doesn't need to use all the 32 bits. That'd free up 31 bits for you to use.","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5538309155/reactions","total_count":2,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":1,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5576721786","html_url":"https://github.com/godotengine/godot/pull/112178#issuecomment-5576721786","issue_url":"https://api.github.com/repos/godotengine/godot/issues/112178","id":5576721786,"node_id":"IC_kwDOAO6SJc8AAAABTGYFeg","user":{"login":"Calinou","id":180032,"node_id":"MDQ6VXNlcjE4MDAzMg==","avatar_url":"https://avatars.githubusercontent.com/u/180032?v=4","gravatar_id":"","url":"https://api.github.com/users/Calinou","html_url":"https://github.com/Calinou","followers_url":"https://api.github.com/users/Calinou/followers","following_url":"https://api.github.com/users/Calinou/following{/other_user}","gists_url":"https://api.github.com/users/Calinou/gists{/gist_id}","starred_url":"https://api.github.com/users/Calinou/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Calinou/subscriptions","organizations_url":"https://api.github.com/users/Calinou/orgs","repos_url":"https://api.github.com/users/Calinou/repos","events_url":"https://api.github.com/users/Calinou/events{/privacy}","received_events_url":"https://api.github.com/users/Calinou/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-09-07T23:30:49Z","updated_at":"2026-09-07T23:35:19Z","body":"> Luminance multiplier can probably be turned into a bool since it's either 1.0 or 2.0, it doesn't need to use all the 32 bits. That'd free up 31 bits for you to use.\r\n\r\nDone (tested with and without HDR 2D enabled). However, the whole image is too bright when HDR 2D is disabled now. I don't know why, because the specialization constant is being toggled correctly.","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5576721786/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5581760853","html_url":"https://github.com/godotengine/godot/pull/112178#issuecomment-5581760853","issue_url":"https://api.github.com/repos/godotengine/godot/issues/112178","id":5581760853,"node_id":"IC_kwDOAO6SJc8AAAABTLLpVQ","user":{"login":"blueskythlikesclouds","id":19259897,"node_id":"MDQ6VXNlcjE5MjU5ODk3","avatar_url":"https://avatars.githubusercontent.com/u/19259897?v=4","gravatar_id":"","url":"https://api.github.com/users/blueskythlikesclouds","html_url":"https://github.com/blueskythlikesclouds","followers_url":"https://api.github.com/users/blueskythlikesclouds/followers","following_url":"https://api.github.com/users/blueskythlikesclouds/following{/other_user}","gists_url":"https://api.github.com/users/blueskythlikesclouds/gists{/gist_id}","starred_url":"https://api.github.com/users/blueskythlikesclouds/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/blueskythlikesclouds/subscriptions","organizations_url":"https://api.github.com/users/blueskythlikesclouds/orgs","repos_url":"https://api.github.com/users/blueskythlikesclouds/repos","events_url":"https://api.github.com/users/blueskythlikesclouds/events{/privacy}","received_events_url":"https://api.github.com/users/blueskythlikesclouds/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-09-08T08:25:43Z","updated_at":"2026-09-08T08:25:43Z","body":"You forgot to assign it as an int value in the spec constant struct:\r\n\r\n`sc.float_value = p_pipeline_key.shader_specialization.packed_2;`\r\n\r\nThis is converting an int to a float now so the bits will get messed up.","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5581760853/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5590532641","html_url":"https://github.com/godotengine/godot/pull/112178#issuecomment-5590532641","issue_url":"https://api.github.com/repos/godotengine/godot/issues/112178","id":5590532641,"node_id":"IC_kwDOAO6SJc8AAAABTTjCIQ","user":{"login":"Calinou","id":180032,"node_id":"MDQ6VXNlcjE4MDAzMg==","avatar_url":"https://avatars.githubusercontent.com/u/180032?v=4","gravatar_id":"","url":"https://api.github.com/users/Calinou","html_url":"https://github.com/Calinou","followers_url":"https://api.github.com/users/Calinou/followers","following_url":"https://api.github.com/users/Calinou/following{/other_user}","gists_url":"https://api.github.com/users/Calinou/gists{/gist_id}","starred_url":"https://api.github.com/users/Calinou/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Calinou/subscriptions","organizations_url":"https://api.github.com/users/Calinou/orgs","repos_url":"https://api.github.com/users/Calinou/repos","events_url":"https://api.github.com/users/Calinou/events{/privacy}","received_events_url":"https://api.github.com/users/Calinou/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-09-08T19:19:24Z","updated_at":"2026-09-08T19:21:49Z","body":"> You forgot to assign it as an int value in the spec constant struct:\r\n> \r\n> `sc.float_value = p_pipeline_key.shader_specialization.packed_2;`\r\n> \r\n> This is converting an int to a float now so the bits will get messed up.\r\n\r\nWorks great now, thanks :slightly_smiling_face: \r\n\r\nDo you have any insights as for the color mismatch between the reflection color and the background in Mobile and Compatibility? It's not an issue specific to this PR (it also occurs when using a PanoramaSkyMaterial background with the same color for all properties), but I noticed that multiplying the reflection energy by `2.2` gets it to match the background more or less.","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5590532641/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5600930760","html_url":"https://github.com/godotengine/godot/pull/112178#issuecomment-5600930760","issue_url":"https://api.github.com/repos/godotengine/godot/issues/112178","id":5600930760,"node_id":"IC_kwDOAO6SJc8AAAABTddryA","user":{"login":"blueskythlikesclouds","id":19259897,"node_id":"MDQ6VXNlcjE5MjU5ODk3","avatar_url":"https://avatars.githubusercontent.com/u/19259897?v=4","gravatar_id":"","url":"https://api.github.com/users/blueskythlikesclouds","html_url":"https://github.com/blueskythlikesclouds","followers_url":"https://api.github.com/users/blueskythlikesclouds/followers","following_url":"https://api.github.com/users/blueskythlikesclouds/following{/other_user}","gists_url":"https://api.github.com/users/blueskythlikesclouds/gists{/gist_id}","starred_url":"https://api.github.com/users/blueskythlikesclouds/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/blueskythlikesclouds/subscriptions","organizations_url":"https://api.github.com/users/blueskythlikesclouds/orgs","repos_url":"https://api.github.com/users/blueskythlikesclouds/repos","events_url":"https://api.github.com/users/blueskythlikesclouds/events{/privacy}","received_events_url":"https://api.github.com/users/blueskythlikesclouds/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-09-09T11:15:13Z","updated_at":"2026-09-09T11:15:13Z","body":"> Do you have any insights as for the color mismatch between the reflection color and the background in Mobile and Compatibility? It's not an issue specific to this PR (it also occurs when using a PanoramaSkyMaterial background with the same color for all properties), but I noticed that multiplying the reflection energy by 2.2 gets it to match the background more or less.\r\n\r\nIt's due to Forward+ using multi scattering, but Mobile/Compatibility using single scattering. Clay explained it here: https://github.com/godotengine/godot/issues/117833#issuecomment-5317868070","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5600930760/reactions","total_count":2,"+1":2,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5762730499","html_url":"https://github.com/godotengine/godot/pull/112178#issuecomment-5762730499","issue_url":"https://api.github.com/repos/godotengine/godot/issues/112178","id":5762730499,"node_id":"IC_kwDOAO6SJc8AAAABV3xKAw","user":{"login":"Repiteo","id":17489292,"node_id":"MDQ6VXNlcjE3NDg5Mjky","avatar_url":"https://avatars.githubusercontent.com/u/17489292?v=4","gravatar_id":"","url":"https://api.github.com/users/Repiteo","html_url":"https://github.com/Repiteo","followers_url":"https://api.github.com/users/Repiteo/followers","following_url":"https://api.github.com/users/Repiteo/following{/other_user}","gists_url":"https://api.github.com/users/Repiteo/gists{/gist_id}","starred_url":"https://api.github.com/users/Repiteo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Repiteo/subscriptions","organizations_url":"https://api.github.com/users/Repiteo/orgs","repos_url":"https://api.github.com/users/Repiteo/repos","events_url":"https://api.github.com/users/Repiteo/events{/privacy}","received_events_url":"https://api.github.com/users/Repiteo/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-09-21T15:07:23Z","updated_at":"2026-09-21T15:07:23Z","body":"Thanks!","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5762730499/reactions","total_count":1,"+1":0,"-1":0,"laugh":0,"hooray":1,"confused":0,"heart":0,"rocket":0,