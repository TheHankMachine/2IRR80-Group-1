s":0,"total_private_repos":0,"url":"https://api.github.com/users/MartinDelille"},"body":"","html_url":"https://github.com/godotengine/godot/pull/112736#pullrequestreview-3701549440","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/112736","author_association":"CONTRIBUTOR","submitted_at":"2026-01-24T13:02:41Z"},{"id":3704679997,"node_id":"PRR_kwDOAO6SJc7c0O49","state":"APPROVED","user":{"site_admin":false,"suspended":false,"updated_at":"0001-01-01T00:00:00Z","avatar_url":"https://avatars.githubusercontent.com/u/10379307?u=7db9f18df8354568cbcf381bb38b5037fab7212e&v=4","created_at":"0001-01-01T00:00:00Z","followers":0,"following":0,"html_url":"https://github.com/jgill88","id":10379307,"node_id":"MDQ6VXNlcjEwMzc5MzA3","login":"jgill88","type":"User","owned_private_repos":0,"public_gists":0,"public_repos":0,"total_private_repos":0,"url":"https://api.github.com/users/jgill88"},"body":"thanks for adding my proposal, @MartinDelille !\r\n\r\nTested the following (bfcf4562e293609761910336007d095df5df3e63) on intel mbp 15.7:\r\n\r\n# Global quick open\r\n\r\n## Repeated shortcuts\r\n\r\neach correctly simulates a keydown press. \r\n\r\n- global quick open (cmd+p+p+p+p+p release) - works perfectly\r\n- global scene quick open (shift+cmd+o+o+o+o release) - works perfectly\r\n- global script quick open (opt+cmd+o+o+o+o release) - works perfectly!\r\n\r\n## Switching types\r\n\r\n- Switched between all quick open types using shortcuts, once global quick open was opened - works as expected\r\n\r\n# Non-global quick open \r\n\r\nRight click a theme in the inspector-> quick load... \r\n\r\nAs expected, no shortcuts caused the dialog's file type filters to change, and no shortcuts caused the 'keydown' keypress simulation to occur. \r\n\r\n## tested all shortcuts:\r\n\r\n- global cmd+p: no change of open type, no navigation motion\r\n- global script cmd+opt+o: no change of open type, no navigation motion\r\n- global scene shift+cmd+o: no change of open type, no navigation motion\r\n\r\nreally nice improvement :)","html_url":"https://github.com/godotengine/godot/pull/112736#pullrequestreview-3704679997","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/112736","author_association":"CONTRIBUTOR","submitted_at":"2026-01-26T05:29:08Z"},{"id":3990449967,"node_id":"PRR_kwDOAO6SJc7t2W8v","state":"COMMENTED","user":{"site_admin":false,"suspended":false,"updated_at":"0001-01-01T00:00:00Z","avatar_url":"https://avatars.githubusercontent.com/u/96648715?u=af70f5d107e9c1447f296643d5a566dab53d25e8&v=4","created_at":"0001-01-01T00:00:00Z","followers":0,"following":0,"html_url":"https://github.com/AThousandShips","id":96648715,"node_id":"U_kgDOBcK-Cw","login":"AThousandShips","type":"User","owned_private_repos":0,"public_gists":0,"public_repos":0,"total_private_repos":0,"url":"https://api.github.com/users/AThousandShips"},"body":"","html_url":"https://github.com/godotengine/godot/pull/112736#pullrequestreview-3990449967","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/112736","author_association":"MEMBER","submitted_at":"2026-03-23T09:36:03Z"},{"id":3993509680,"node_id":"PRR_kwDOAO6SJc7uCB8w","state":"APPROVED","user":{"site_admin":false,"suspended":false,"updated_at":"0001-01-01T00:00:00Z","avatar_url":"https://avatars.githubusercontent.com/u/2223172?u=fc85633b469acb6e7baef4dba5171f19a2a4ff85&v=4","created_at":"0001-01-01T00:00:00Z","followers":0,"following":0,"html_url":"https://github.com/KoBeWi","id":2223172,"node_id":"MDQ6VXNlcjIyMjMxNzI=","login":"KoBeWi","type":"User","owned_private_repos":0,"public_gists":0,"public_repos":0,"total_private_repos":0,"url":"https://api.github.com/users/KoBeWi"},"body":"Works correctly now.","html_url":"https://github.com/godotengine/godot/pull/112736#pullrequestreview-3993509680","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/112736","author_association":"MEMBER","submitted_at":"2026-03-23T17:48:17Z"},{"id":3998907973,"node_id