thub.com/AThousandShips","id":96648715,"node_id":"U_kgDOBcK-Cw","login":"AThousandShips","type":"User","owned_private_repos":0,"public_gists":0,"public_repos":0,"total_private_repos":0,"url":"https://api.github.com/users/AThousandShips"},"body":"","html_url":"https://github.com/godotengine/godot/pull/103100#pullrequestreview-2913344933","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/103100","author_association":"MEMBER","submitted_at":"2025-12-01T16:41:04Z"},{"id":3540651915,"node_id":"PRR_kwDOAO6SJc7TCg-L","state":"COMMENTED","user":{"site_admin":false,"suspended":false,"updated_at":"0001-01-01T00:00:00Z","avatar_url":"https://avatars.githubusercontent.com/u/2223172?u=fc85633b469acb6e7baef4dba5171f19a2a4ff85&v=4","created_at":"0001-01-01T00:00:00Z","followers":0,"following":0,"html_url":"https://github.com/KoBeWi","id":2223172,"node_id":"MDQ6VXNlcjIyMjMxNzI=","login":"KoBeWi","type":"User","owned_private_repos":0,"public_gists":0,"public_repos":0,"total_private_repos":0,"url":"https://api.github.com/users/KoBeWi"},"body":"","html_url":"https://github.com/godotengine/godot/pull/103100#pullrequestreview-3540651915","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/103100","author_association":"MEMBER","submitted_at":"2025-12-04T15:40:30Z"},{"id":5058614705,"node_id":"PRR_kwDOAO6SJc8AAAABLYRVsQ","state":"APPROVED","commit_id":"3d195b099ed9e02eca0001b2ec23111b70d25726","user":{"site_admin":false,"suspended":false,"updated_at":"0001-01-01T00:00:00Z","avatar_url":"https://avatars.githubusercontent.com/u/180032?u=68d23e7ee9cdf810da125e8510b72f845b9dccc8&v=4","created_at":"0001-01-01T00:00:00Z","followers":0,"following":0,"html_url":"https://github.com/Calinou","id":180032,"node_id":"MDQ6VXNlcjE4MDAzMg==","login":"Calinou","type":"User","owned_private_repos":0,"public_gists":0,"public_repos":0,"total_private_repos":0,"url":"https://api.github.com/users/Calinou"},"body":"Tested again (rebased on top of `master` ), it works as expected. Code looks good to me.\r\n\r\nLinux x86_64 release export template stripped binary size (`production=yes lto=full`):\r\n\r\n- Default: 80,584,560 bytes\r\n- `forward_mobile_renderer=no`: 80,028,440 bytes\r\n- `forward_plus_renderer=no`: 77,694,480 bytes\r\n- `vulkan=no`: 77,344,232 bytes\r\n- `vulkan=no opengl3=no`: 75,392,904 bytes\r\n- `forward_plus_renderer=no forward_mobile_renderer=no`: 73,273,104 bytes\r\n- `rendering_device=no`: 69,974,120 bytes\r\n- `rendering_device=no opengl3=no`: 67,954,168 bytes\r\n- `rendering_device=no opengl3=no x11=no wayland=no alsa=no pulseaudio=no accesskit=no` (pure headless binary): 65,394,904 bytes\r\n\r\n`rendering_device=no` and `forward_plus_renderer=no forward_mobile_renderer=no` automatically fall back to Compatibility on projects using Forward+/Mobile, as one would expect.","html_url":"https://github.com/godotengine/godot/pull/103100#pullrequestreview-5058614705","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/103100","author_association":"MEMBER","submitted_at":"2026-08-29T16:33:40Z"},{"id":5090760566,"node_id":"PRR_kwDOAO6SJc8AAAABL27Xdg","state":"APPROVED","commit_id":"3d195b099ed9e02eca0001b2ec23111b70d25726","user":{"site_admin":false,"suspended":false,"updated_at":"0001-01-01T00:00:00Z","avatar_url":"https://avatars.githubusercontent.com/u/17489292?u=34072b401722100a7c0c0d61e37b376cf22b4545&v=4","created_at":"0001-01-01T00:00:00Z","followers":0,"following":0,"html_url":"https://github.com/Repiteo","id":17489292,"node_id":"MDQ6VXNlcjE3NDg5Mjky","login":"Repiteo","type":"User","owned_private_repos":0,"public_gists":0,"public_repos":0,"total_private_repos":0,"url":"https://api.github.com/users/Repiteo"},"body":"Seems like this is as close to stable as it can get, considering the way everything surrounding it was already implemented. Let's get this live so other people can start stress-testing their personal build environments","html_url":"https://github.com/godotengine/godot/pull/103100#pullrequestreview-5090760566","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/103100","author_association":"CONTRIBUTOR","submitted_at":"2026-09-02T14:08:45Z"}]