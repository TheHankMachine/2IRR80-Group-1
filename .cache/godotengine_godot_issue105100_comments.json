[{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2781495200","html_url":"https://github.com/godotengine/godot/issues/105100#issuecomment-2781495200","issue_url":"https://api.github.com/repos/godotengine/godot/issues/105100","id":2781495200,"node_id":"IC_kwDOAO6SJc6lyj-g","user":{"login":"clayjohn","id":16521339,"node_id":"MDQ6VXNlcjE2NTIxMzM5","avatar_url":"https://avatars.githubusercontent.com/u/16521339?v=4","gravatar_id":"","url":"https://api.github.com/users/clayjohn","html_url":"https://github.com/clayjohn","followers_url":"https://api.github.com/users/clayjohn/followers","following_url":"https://api.github.com/users/clayjohn/following{/other_user}","gists_url":"https://api.github.com/users/clayjohn/gists{/gist_id}","starred_url":"https://api.github.com/users/clayjohn/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/clayjohn/subscriptions","organizations_url":"https://api.github.com/users/clayjohn/orgs","repos_url":"https://api.github.com/users/clayjohn/repos","events_url":"https://api.github.com/users/clayjohn/events{/privacy}","received_events_url":"https://api.github.com/users/clayjohn/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-04-06T16:14:15Z","updated_at":"2025-04-06T16:14:15Z","body":"You are forgetting to enable indirect drawing when calling [`multimesh_allocate_data`](https://docs.godotengine.org/en/latest/classes/class_renderingserver.html#class-renderingserver-method-multimesh-allocate-data). Therefore the engine thinks you want to use a regular draw call and needs the instance count passed in from the CPU. Since you never set an instance count nothing gets drawn. \n\nIf you only want to update the data from the GPU, you must either set the instance count in advance, then update the data. Or use indirect drawing and set the instance count from the GPU in the indirect buffer","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2781495200/reactions","total_count":2,"+1":2,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null}]