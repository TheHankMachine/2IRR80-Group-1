n-mga/gists{/gist_id}","starred_url":"https://api.github.com/users/akien-mga/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/akien-mga/subscriptions","organizations_url":"https://api.github.com/users/akien-mga/orgs","repos_url":"https://api.github.com/users/akien-mga/repos","events_url":"https://api.github.com/users/akien-mga/events{/privacy}","received_events_url":"https://api.github.com/users/akien-mga/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-05-24T22:46:51Z","updated_at":"2025-05-24T22:46:51Z","body":"> Despite the icon optimisation mentioned above seemingly being in this build, `EditorNode::get_class_icon` is the main issue.\n\nCC @KoBeWi - we should look into optimizing this further.\n\nIf `EditorNode::get_class_icon` itself can't be optimized significantly, we could:\n- Cache the results so we only query this once per node in the debugger, and not on every scene tree sync.\n- Bypass it if the scene tree has 1000+ nodes or some threshold that makes it a performance issue.","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2907271784/reactions","total_count":2,"+1":2,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2907906570","html_url":"https://github.com/godotengine/godot/issues/102525#issuecomment-2907906570","issue_url":"https://api.github.com/repos/godotengine/godot/issues/102525","id":2907906570,"node_id":"IC_kwDOAO6SJc6tUyIK","user":{"login":"KoBeWi","id":2223172,"node_id":"MDQ6VXNlcjIyMjMxNzI=","avatar_url":"https://avatars.githubusercontent.com/u/2223172?v=4","gravatar_id":"","url":"https://api.github.com/users/KoBeWi","html_url":"https://github.com/KoBeWi","followers_url":"https://api.github.com/users/KoBeWi/followers","following_url":"https://api.github.com