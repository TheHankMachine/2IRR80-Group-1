","html_url":"https://github.com/godotengine/godot/pull/100024#issuecomment-2520817581","issue_url":"https://api.github.com/repos/godotengine/godot/issues/100024","id":2520817581,"node_id":"IC_kwDOAO6SJc6WQJ-t","user":{"login":"AThousandShips","id":96648715,"node_id":"U_kgDOBcK-Cw","avatar_url":"https://avatars.githubusercontent.com/u/96648715?v=4","gravatar_id":"","url":"https://api.github.com/users/AThousandShips","html_url":"https://github.com/AThousandShips","followers_url":"https://api.github.com/users/AThousandShips/followers","following_url":"https://api.github.com/users/AThousandShips/following{/other_user}","gists_url":"https://api.github.com/users/AThousandShips/gists{/gist_id}","starred_url":"https://api.github.com/users/AThousandShips/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/AThousandShips/subscriptions","organizations_url":"https://api.github.com/users/AThousandShips/orgs","repos_url":"https://api.github.com/users/AThousandShips/repos","events_url":"https://api.github.com/users/AThousandShips/events{/privacy}","received_events_url":"https://api.github.com/users/AThousandShips/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2024-12-05T16:20:54Z","updated_at":"2024-12-05T16:20:54Z","body":"The rest of the code would be very useful though! Will go through that","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2520817581/reactions","total_count":1,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":1,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2520857204","html_url":"https://github.com/godotengine/godot/pull/100024#issuecomment-2520857204","issue_url":"https://api.github.com/repos/godotengine/godot/issues/100024","id":2520857204,"node_id":"IC_kwDOAO6SJc6WQTp0","user":{"login":"Ivorforce","id":2308167,"node_id":"MDQ6VXNl