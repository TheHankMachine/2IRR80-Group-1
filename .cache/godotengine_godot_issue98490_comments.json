.com/users/timothyqiu/followers","following_url":"https://api.github.com/users/timothyqiu/following{/other_user}","gists_url":"https://api.github.com/users/timothyqiu/gists{/gist_id}","starred_url":"https://api.github.com/users/timothyqiu/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/timothyqiu/subscriptions","organizations_url":"https://api.github.com/users/timothyqiu/orgs","repos_url":"https://api.github.com/users/timothyqiu/repos","events_url":"https://api.github.com/users/timothyqiu/events{/privacy}","received_events_url":"https://api.github.com/users/timothyqiu/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2024-10-24T13:12:37Z","updated_at":"2024-10-24T13:12:37Z","body":"This method was added in #4854, I guess these coordinate names were not yet sorted out like today.\r\n\r\nI think we can deprecate this method as the name is not optimal and we have better alternatives now:\r\n\r\n```gdscript\r\nvar local_pos = viewport_pos * get_global_transform_with_canvas()\r\n\r\nvar viewport_pos = get_global_transform_with_canvas() * local_pos\r\n```","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2435262773/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2436077242","html_url":"https://github.com/godotengine/godot/pull/98490#issuecomment-2436077242","issue_url":"https://api.github.com/repos/godotengine/godot/issues/98490","id":2436077242,"node_id":"IC_kwDOAO6SJc6RM5a6","user":{"login":"Repiteo","id":17489292,"node_id":"MDQ6VXNlcjE3NDg5Mjky","avatar_url":"https://avatars.githubusercontent.com/u/17489292?v=4","gravatar_id":"","url":"https://api.github.com/users/Repiteo","html_url":"https://github.com/Repiteo","followers_url":"https://api.github.com/users/Repiteo/followers","following_url":"https://api.github.com/users/Repiteo/following{/other_user}","gists_url":"https://api.github.com/users/Repiteo/gists{/gist_id}","starred_url":"https://api.github.com/users/Repiteo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Repiteo/subscriptions","organizations_url":"https://api.github.com/users/Repiteo/orgs","repos_url":"https://api.github.com/users/Repiteo/repos","events_url":"https://api.github.com/users/Repiteo/events{/privacy}","received_events_url":"https://api.github.com/users/Repiteo/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2024-10-24T18:29:42Z","updated_at":"2024-10-24T18:29:42Z","body":"Thanks!","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2436077242/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2439483728","html_url":"https://github.com/godotengine/godot/pull/98490#issuecomment-2439483728","issue_url":"https://api.github.com/repos/godotengine/godot/issues/98490","id":2439483728,"node_id":"IC_kwDOAO6SJc6RZ5FQ","user":{"login":"Razzlegames","id":8754559,"node_id":"MDQ6VXNlcjg3NTQ1NTk=","avatar_url":"https://avatars.githubusercontent.com/u/8754559?v=4","gravatar_id":"","url":"https://api.github.com/users/Razzlegames","html_url":"https://github.com/Razzlegames","followers_url":"https://api.github.com/users/Razzlegames/followers","following_url":"https://api.github.com/users/Razzlegames/following{/other_user}","gists_url":"https://api.github.com/users/Razzlegames/gists{/gist_id}","starred_url":"https://api.github.com/users/Razzlegames/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Razzlegames/subscriptions","organizations_url":"https://api.github.com/users/Razzlegames/orgs","repos_url":"https://api.github.com/users/Razzlegames/repos","events_url":"https://api.github.com/users/Razzlegames/events{/privacy}","received_events_url":"https://api.github.com/users/Razzlegames/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2024-10-26T10:35:02Z","updated_at":"2024-10-26T10:53:56Z","body":"Yeah I'm fine deprecating this API as it's from edits I made 8 years ago or so before many things were established.  But I was hoping to bring about a pattern of a more abstracted conversion, where users didn't need to understand the linear algebra and make any order dependant mistakes etc. \r\n\r\nOne correction just for anyone reading this, I think it should be:\r\n\r\n```gdscript\r\nlocal_pos = get_global_transform().affine_inverse() * canvas_pos\r\n```\r\nEdit: oh but your example probably works most of the time with orthonormal matrixes (since transpose== inverse and reordering mult == same as transpose, if I recall).\r\n\r\nMy hopes were to avoid any common mistakes by abstraction to a single function with minimal parameters. `canvas.make_canvas_pos_local(canvas_pos)` etc.\r\n\r\nAny thoughts on this?","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2439483728/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2439501966","html_url":"https://github.com/godotengine/godot/pull/98490#issuecomment-2439501966","issue_url":"https://api.github.com/repos/godotengine/godot/issues/98490","id":2439501966,"node_id":"IC_kwDOAO6SJc6RZ9iO","user":{"login":"KoBeWi","id":2223172,"node_id":"MDQ6VXNlcjIyMjMxNzI=","avatar_url":"https://avatars.githubusercontent.com/u/2223172?v=4","gravatar_id":"","url":"https://api.github.com/users/KoBeWi","html_url":"https://github.com/KoBeWi","followers_url"