[{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5763645627","html_url":"https://github.com/godotengine/godot/issues/123643#issuecomment-5763645627","issue_url":"https://api.github.com/repos/godotengine/godot/issues/123643","id":5763645627,"node_id":"IC_kwDOAO6SJc8AAAABV4pAuw","user":{"login":"clayjohn","id":16521339,"node_id":"MDQ6VXNlcjE2NTIxMzM5","avatar_url":"https://avatars.githubusercontent.com/u/16521339?v=4","gravatar_id":"","url":"https://api.github.com/users/clayjohn","html_url":"https://github.com/clayjohn","followers_url":"https://api.github.com/users/clayjohn/followers","following_url":"https://api.github.com/users/clayjohn/following{/other_user}","gists_url":"https://api.github.com/users/clayjohn/gists{/gist_id}","starred_url":"https://api.github.com/users/clayjohn/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/clayjohn/subscriptions","organizations_url":"https://api.github.com/users/clayjohn/orgs","repos_url":"https://api.github.com/users/clayjohn/repos","events_url":"https://api.github.com/users/clayjohn/events{/privacy}","received_events_url":"https://api.github.com/users/clayjohn/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-09-21T16:09:53Z","updated_at":"2026-09-21T16:09:53Z","body":"I can't reproduce on linux. It is possible that this is a Windows filesystem specific behaviour.\n\nI opened the MRP in the editor and observed low CPU-usage and then I profiled the editor with a CPU profiler and observed that it was basically doing no work. Certainly nothing related to SVGs","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5763645627/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5768429315","html_url":"https://github.com/godotengine/godot/issues/123643#issuecomment-5768429315","issue_url":"https://api.github.com/repos/godotengine/godot/issues/123643","id":5768429315,"node_id":"IC_kwDOAO6SJc8AAAABV9M_Aw","user":{"login":"Devenor","id":11620504,"node_id":"MDQ6VXNlcjExNjIwNTA0","avatar_url":"https://avatars.githubusercontent.com/u/11620504?v=4","gravatar_id":"","url":"https://api.github.com/users/Devenor","html_url":"https://github.com/Devenor","followers_url":"https://api.github.com/users/Devenor/followers","following_url":"https://api.github.com/users/Devenor/following{/other_user}","gists_url":"https://api.github.com/users/Devenor/gists{/gist_id}","starred_url":"https://api.github.com/users/Devenor/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Devenor/subscriptions","organizations_url":"https://api.github.com/users/Devenor/orgs","repos_url":"https://api.github.com/users/Devenor/repos","events_url":"https://api.github.com/users/Devenor/events{/privacy}","received_events_url":"https://api.github.com/users/Devenor/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-09-21T22:31:59Z","updated_at":"2026-09-21T22:31:59Z","body":"I found the culprit: it was the \"Import Resources When Unfocused\" editor setting being enabled. It makes sense that the more files considered resources you have, the higher the CPU usage will be, given that the setting's tooltip explicitly warns that enabling it will increase idle CPU usage.\n\nI guess there's no issue after all, so I'm closing this as not planned.","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5768429315/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null}]