rchived_at":null,"archived_by":null},{"id":1732720779,"node_id":"MDU6TGFiZWwxNzMyNzIwNzc5","url":"https://api.github.com/repos/godotengine/godot/labels/topic:gui","name":"topic:gui","color":"ffee88","default":false,"description":"","archived_at":null,"archived_by":null}],"state":"open","locked":false,"assignees":[],"milestone":null,"comments":0,"created_at":"2025-08-19T09:31:52Z","updated_at":"2025-08-19T10:05:53Z","closed_at":null,"assignee":null,"author_association":"NONE","issue_field_values":[],"type":null,"active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"### Tested versions\n\nReproducible in v4.4.1.stable.official [49a5bc7b6]\n\n### System information\n\nWindows 11\n\n### Issue description\n\nIf a TextureButton has a child, and that child is a Control node with mouse filter set as Pass, TextureButton ignore Click Mask and (I think) uses child's rect instead.\n\n### Steps to reproduce\n\n- Create a TextureButton\n- Add a Click Mask to the TextureButton\n- Create a child Control node to the TextureButton. I tried empty VBoxContainer and an empty TextureRect seperately.\n- Make sure child node size is same as the TextureButton size, that it occupies the same space.\n- When you run the project, Click Mask will be ignored.\n- If you make the child node invisible, or if you change child node's mouse filter to Ignore, then Click Mask works ok.\n\n### Minimal reproduction project (MRP)\n\n[clickmaskissue.zip](https://github.com/user-attachments/files/21852678/clickmaskissue.zip)","closed_by":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/109767/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/godotengine/godot/issues/109767/timeline","performed_via_github_app":null,"state_reason":null,"pinned_comment":null}