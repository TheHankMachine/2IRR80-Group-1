eo/gists{/gist_id}","starred_url":"https://api.github.com/users/Repiteo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Repiteo/subscriptions","organizations_url":"https://api.github.com/users/Repiteo/orgs","repos_url":"https://api.github.com/users/Repiteo/repos","events_url":"https://api.github.com/users/Repiteo/events{/privacy}","received_events_url":"https://api.github.com/users/Repiteo/received_events","type":"User","user_view_type":"public","site_admin":false},"open_issues":343,"closed_issues":2335,"state":"open","created_at":"2026-04-13T15:59:35Z","updated_at":"2026-10-22T06:28:22Z","due_on":null,"closed_at":null},"comments":1,"created_at":"2026-08-13T11:22:16Z","updated_at":"2026-08-24T19:51:16Z","closed_at":"2026-08-24T19:51:16Z","assignee":{"login":"bruvzg","id":7645683,"node_id":"MDQ6VXNlcjc2NDU2ODM=","avatar_url":"https://avatars.githubusercontent.com/u/7645683?v=4","gravatar_id":"","url":"https://api.github.com/users/bruvzg","html_url":"https://github.com/bruvzg","followers_url":"https://api.github.com/users/bruvzg/followers","following_url":"https://api.github.com/users/bruvzg/following{/other_user}","gists_url":"https://api.github.com/users/bruvzg/gists{/gist_id}","starred_url":"https://api.github.com/users/bruvzg/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/bruvzg/subscriptions","organizations_url":"https://api.github.com/users/bruvzg/orgs","repos_url":"https://api.github.com/users/bruvzg/repos","events_url":"https://api.github.com/users/bruvzg/events{/privacy}","received_events_url":"https://api.github.com/users/bruvzg/received_events","type":"User","user_view_type":"public","site_admin":false},"author_association":"NONE","issue_field_values":[],"type":null,"active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"### Tested versions\n\nReproducible in v4.7.1.stable.steam [a13da4feb]\nNot reproducible in v4.6.3.stable.steam [7d41c59c4]\n\n### System information\n\nGodot v4.7.1.stable (a13da4feb) - Windows 11 (build 26200) - Multi-window, 1 monitor - OpenGL 3 (Compatibility) - NVIDIA GeForce RTX 4060 Ti (NVIDIA; 32.0.16.1088) - 12th Gen Intel(R) Core(TM) i5-12490F (12 threads) - 15.81 GiB memory - WASAPI (48000 Hz, Stereo/mono)\n\n### Issue description\n\nWhen vertical_alignment in RichTextLabel is set to Bottom or Center, the text moves upward instead of being positioned correctly. This bug was introduced in v4.7.1.stable.steam [a13da4feb] and did not occur in v4.6.3.stable.steam [7d41c59c4].\n\nThis is a critical issue for my project. After upgrading my game from v4.6.3 to v4.7.1, almost all text elements were shifted upward. Manually adjusting each item one by one is unfeasible, so I am forced to wait for a fix or downgrade back to v4.6.3.\n\n### Steps to reproduce\n\nThis is the .fnt font I used. It is a strictly vertically aligned font with a 2-pixel margin (padding) at both the top and bottom.\n<img width=\"1010\" height=\"623\" alt=\"Image\" src=\"https://github.com/user-attachments/assets/d063f98f-6cb6-4914-adc3-cd665683fad5\" />\n\nIn v4.6.3.stable.steam [7d41c59c4], everything worked as expected.\nTop is OK.\n<img width=\"1415\" height=\"652\" alt=\"Image\" src=\"https://github.com/user-attachments/assets/471fd9bc-6cb9-4305-88c1-aa0f8aef9a55\" />\nBottom is OK.\n<img width=\"1379\" height=\"640\" alt=\"Image\" src=\"https://github.com/user-attachments/assets/a1935372-ba1c-45d7-a87d-338356d01d71\" />\nCenter is OK.\n<img width=\"1419\" height=\"683\" alt=\"Image\" src=\"https://github.com/user-attachments/assets/87b9ab3c-1a7a-4999-b025-ee06d5a1d0d8\" />\n<img width=\"1364\" height=\"682\" alt=\"Image\" src=\"https://github.com/user-attachments/assets/d9fdc9ff-2457-472e-8f6a-4162cd2044c5\" />\n\nHowever, in v4.7.1.stable.steam [a13da4feb], a severe issue occurs.\nTop is OK.\n<img width=\"1378\" height=\"658\" alt=\"Image\" src=\"https://github.com/user-attachments/assets/7e8682da-888e-41b7-a1aa-da3b19933df6\" />\nBottom is Error!\n<img width=\"1380\" height=\"681\" alt=\"Image\" src=\"https://github.com/user-attachments/assets/98ed9bfa-50a7-464d-b0de-a10041c8d8db\" />\nCenter is Error!\n<img width=\"1416\" height=\"672\" alt=\"Image\" src=\"https://github.com/user-attachments/assets/1c5e0ebb-4fa6-421a-b7a6-ea167ec26a3c\" />\n<img width=\"1410\" height=\"698\" alt=\"Image\" src=\"https://github.com/user-attachments/assets/69fe1aea-f06e-49c7-a252-a043a700fd36\" />\n\n### Minimal reproduction project (MRP)\n\n[richlabel-vertical-alignment-bug.zip](https://github.com/user-attachments/files/31026535/richlabel-vertical-alignment-bug.zip)","closed_by":{"login":"Repiteo","id":17489292,"node_id":"MDQ6VXNlcjE3NDg5Mjky","avatar_url":"https://avatars.githubusercontent.com/u/17489292?v=4","gravatar_id":"","url":"https://api.github.com/users/Repiteo","html_url":"https://github.com/Repiteo","followers_url":"https://api.github.com/users/Repiteo/followers","following_url":"https://api.github.com/users/Repiteo/following{/other_user}","gists_url":"https://api.github.com/users/Repiteo/gists{/gist_id}","starred_url":"https://api.github.com/users/Repiteo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Repiteo/subscriptions","organizations_url":"https://api.github.com/users/Repiteo/orgs","repos_url":"https://api.github.com/users/Repiteo/repos","events_url":"https://api.github.com/users/Repiteo/events{/privacy}","received_events_url":"https://api.github.com/users/Repiteo/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/122374/reactions","total_count":4,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":4},"timeline_url":"https://api.github.com/repos/godotengine/godot/issues/122374/timeline","performed_via_github_app":null,"state_reason":"compl