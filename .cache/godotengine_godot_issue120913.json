hived_at":null,"archived_by":null},{"id":1732720779,"node_id":"MDU6TGFiZWwxNzMyNzIwNzc5","url":"https://api.github.com/repos/godotengine/godot/labels/topic:gui","name":"topic:gui","color":"ffee88","default":false,"description":"","archived_at":null,"archived_by":null}],"state":"closed","locked":false,"assignees":[],"milestone":{"url":"https://api.github.com/repos/godotengine/godot/milestones/25","html_url":"https://github.com/godotengine/godot/milestone/25","labels_url":"https://api.github.com/repos/godotengine/godot/milestones/25/labels","id":15520464,"node_id":"MI_kwDOAO6SJc4A7NLQ","number":25,"title":"4.8","description":"","creator":{"login":"Repiteo","id":17489292,"node_id":"MDQ6VXNlcjE3NDg5Mjky","avatar_url":"https://avatars.githubusercontent.com/u/17489292?v=4","gravatar_id":"","url":"https://api.github.com/users/Repiteo","html_url":"https://github.com/Repiteo","followers_url":"https://api.github.com/users/Repiteo/followers","following_url":"https://api.github.com/users/Repiteo/following{/other_user}","gists_url":"https://api.github.com/users/Repiteo/gists{/gist_id}","starred_url":"https://api.github.com/users/Repiteo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Repiteo/subscriptions","organizations_url":"https://api.github.com/users/Repiteo/orgs","repos_url":"https://api.github.com/users/Repiteo/repos","events_url":"https://api.github.com/users/Repiteo/events{/privacy}","received_events_url":"https://api.github.com/users/Repiteo/received_events","type":"User","user_view_type":"public","site_admin":false},"open_issues":343,"closed_issues":2335,"state":"open","created_at":"2026-04-13T15:59:35Z","updated_at":"2026-10-22T06:28:22Z","due_on":null,"closed_at":null},"comments":1,"created_at":"2026-07-03T21:45:20Z","updated_at":"2026-07-05T17:57:50Z","closed_at":"2026-07-05T16:00:27Z","assignee":null,"author_association":"CONTRIBUTOR","issue_field_values":[],"type":null,"active_lock_reason":null,"draft":false,"pull_request":{"url":"https://api.github.com/repos/godotengine/godot/pulls/120913","html_url":"https://github.com/godotengine/godot/pull/120913","diff_url":"https://github.com/godotengine/godot/pull/120913.diff","patch_url":"https://github.com/godotengine/godot/pull/120913.patch","merged_at":"2026-07-05T16:00:27Z"},"body":"## What problem(s) does this PR solve?\r\n\r\n- Follow up to #120640 \r\n\r\nIn that PR, I made `BoxContainer` and `GridContainer` (and `FlowContainer`, but that one isn't bugged) allocate space to children whose desired sizes were greater than their minimum sizes. \r\nAs described in the PR, the flow would go: \r\n1. Give each child its minimum size\r\n2. From the remaining space, distribute to children with a desired size\r\n3. If any, from the remaining space, distribute to children with the SIZE_EXPAND flag\r\n\r\nThe problem is, in both cases, the \"remaining space\" computed for step 3, which I used for step 2, also includes the space occupied by the minimum size of the children who have the `SIZE_EXPAND` flag. This is done such that their final sizes are computed irrespective of their minimum sizes, and only take into account the stretch ratios. \r\nHowever, using that in step 2 resulted in the children in step 2 overallocating, using the minimum size of the expanding children as free space to stretch into. This is completely erroneous and results in the step 2 children taking up more space than is available. \r\n\r\nThe images below use `HBoxContainer`, the project has both, but they look the same, so I only put images for one.\r\nBefore:\r\n<img width=\"641\" height=\"52\" alt=\"image\" src=\"https://github.com/user-attachments/assets/6552ea8e-9a48-4a37-82b0-de1fd918d132\" />\r\n\r\nAfter PR:\r\n<img width=\"459\" height=\"54\" alt=\"image\" src=\"https://github.com/user-attachments/assets/38c706be-2410-40b6-80b8-d8bd9aa29dc4\" />\r\n\r\nProject:\r\n[respect-desired-sizes-mrp.zip](https://github.com/user-attachments/files/29649228/respect-desired-sizes-mrp.zip)\r\n\r\n\r\n## Additional information\r\n\r\nThe project additionally contains the previous tests from #120640 to ensure no regressions against that PR. \r\n\r\nThis bug slipped through because of a lack of test coverage for the new system, which I should have added earlier. I will work to expand test coverage for these containers so that this kind of oversight does not happen again. ","closed_by":{"login":"Repiteo","id":17489292,"node_id":"MDQ6VXNlcjE3NDg5Mjky","avatar_url":"https://avatars.githubusercontent.com/u/17489292?v=4","gravatar_id":"","url":"https://api.github.com/users/Repiteo","html_url":"https://github.com/Repiteo","followers_url":"https://api.github.com/users/Repiteo/followers","following_url":"https://api.github.com/users/Repiteo/following{/other_user}","gists_url":"https://api.github.com/users/Repiteo/gists{/gist_id}","starred_url":"https://api.github.com/users/Repiteo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Repiteo/subscriptions","organizations_url":"https://api.github.com/users/Repiteo/orgs","repos_url":"https://api.github.com/users/Repiteo/repos","events_url":"https://api.github.com/users/Repiteo/events{/privacy}","received_events_url":"https://api.github.com/users/Repiteo/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/120913/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/godotengine/godot/issues/120913/timeline","performed_via_github_app":null,"state_reason":null}