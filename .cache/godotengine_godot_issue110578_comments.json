lcjc4OTQ1OTA0","avatar_url":"https://avatars.githubusercontent.com/u/78945904?v=4","gravatar_id":"","url":"https://api.github.com/users/Kaleb-Reid","html_url":"https://github.com/Kaleb-Reid","followers_url":"https://api.github.com/users/Kaleb-Reid/followers","following_url":"https://api.github.com/users/Kaleb-Reid/following{/other_user}","gists_url":"https://api.github.com/users/Kaleb-Reid/gists{/gist_id}","starred_url":"https://api.github.com/users/Kaleb-Reid/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Kaleb-Reid/subscriptions","organizations_url":"https://api.github.com/users/Kaleb-Reid/orgs","repos_url":"https://api.github.com/users/Kaleb-Reid/repos","events_url":"https://api.github.com/users/Kaleb-Reid/events{/privacy}","received_events_url":"https://api.github.com/users/Kaleb-Reid/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-09-20T17:29:23Z","updated_at":"2025-09-20T17:29:23Z","body":"@codevogel Are you calling ```update_configuration_warnings()``` when necessary?","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3315127438/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3315149342","html_url":"https://github.com/godotengine/godot/issues/110578#issuecomment-3315149342","issue_url":"https://api.github.com/repos/godotengine/godot/issues/110578","id":3315149342,"node_id":"IC_kwDOAO6SJc7FmSoe","user":{"login":"codevogel","id":8700780,"node_id":"MDQ6VXNlcjg3MDA3ODA=","avatar_url":"https://avatars.githubusercontent.com/u/8700780?v=4","gravatar_id":"","url":"https://api.github.com/users/codevogel","html_url":"https://github.com/codevogel","followers_url":"https://api.github.com/users/codevogel/followers","following_url":"https://api.github.com/users/codevogel/following{/other_user}","gists_url":"https://api.github.com/users/codevogel/gists{/gist_id}","starred_url":"https://api.github.com/users/codevogel/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/codevogel/subscriptions","organizations_url":"https://api.github.com/users/codevogel/orgs","repos_url":"https://api.github.com/users/codevogel/repos","events_url":"https://api.github.com/users/codevogel/events{/privacy}","received_events_url":"https://api.github.com/users/codevogel/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-09-20T18:11:58Z","updated_at":"2025-09-20T18:12:11Z","body":"@Kaleb-Reid \n> [@codevogel](https://github.com/codevogel) Are you calling `update_configuration_warnings()` when necessary?\n\nHmmm, `update_configuration_warnings()` is new to me. I must have read over that part in the documentation.\nNot sure where would be the appropriate place to call it, in this case then, maybe `NOTIFICATION_EDITOR_POST_SAVE `?\n\nThe docs list it in a setter, but that can become quite cumbersome when you have multiple properties that need a configuration check to run.\n\nIt seems a bit intuitive that `_get_configuration_warnings` runs on save when it's a root scene, but doesn't when it's a child scene.\nThis _may_ not be a bug if this behavior is intended.","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3315149342/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3315227902","html_url":"https://github.com/godotengine/godot/issues/110578#issuecomment-3315227902","issue_url":"https://api.github.com/repos/godotengine/godot/issues/110578","id":3315227902,"node_id":"IC_kwDOAO6SJc7Fmlz-","user":{"login":"codevogel","id":8700780,"node_id":"MDQ6VXNlcjg3MDA3ODA=","avatar_url":"https://avatars.githubusercontent.com/u/8700780?v=4","gravatar_id":"","url":"https://api.github.com/users/codevogel","html_url":"https://github.com/codevogel","followers_url":"https://api.github.com/users/codevogel/followers","following_url":"https://api.github.com/users/codevogel/following{/other_user}","gists_url":"https://api.github.com/users/codevogel/gists{/gist_id}","starred_url":"https://api.github.com/users/codevogel/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/codevogel/subscriptions","organizations_url":"https://api.github.com/users/codevogel/orgs","repos_url":"https://api.github.com/users/codevogel/repos","events_url":"https://api.github.com/users/codevogel/events{/privacy}","received_events_url":"https://api.github.com/users/codevogel/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-09-20T20:07:27Z","updated_at":"2025-09-20T20:07:27Z","body":"@Kaleb-Reid \n\nI can confirm that adding\n\n```\nfunc _notification(what: int) -> void:\n\tif what == NOTIFICATION_EDITOR_POST_SAVE:\n\t\tupdate_configuration_warnings()\n```\n\nResolves this issue, so it's definitely a good idea to add that to any script that provides configuration warnings.\n\nHowever, I'll leave the bug report open for now, as I'm still wondering whether there's a bug here. Because the configuration icon stays alive even if the warnings have already cleared up. This occurs when you haven't added the above example code, and the script that triggered the configuration warning is a child node.\nThe icon does clear away on save when attached to the root node.\n\nSo it seems as if `_get_configuration_warning` doesn't run for children on save, but it does for root nodes.","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3315227902/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3315244891","html_url":"https://github.com/godotengine/godot/issues/110578#issuecomment-3315244891","issue_url":"https://api.github.com/repos/godotengine/godot/issues/110578","id":3315244891,"node_id":"IC_kwDOAO6SJc7Fmp9b","user":{"login":"Kaleb-Reid","id":78945904,"node_id":"MDQ6VXNlcjc4OTQ1OTA0","avatar_url":"https://avatars.githubusercontent.com/u/78945904?v=4","gravatar_id":"","url":"https://api.github.com/users/Kaleb-Reid","html_url":"https://github.com/Kaleb-Reid","followers_url":"https://api.github.com/users/Kaleb-Reid/followers","following_url":"https://api.github.com/users/Kaleb-Reid/following{/other_user}","gists_url":"https://api.github.com/users/Kaleb-Reid/gists{/gist_id}","starred_url":"https://api.github.com/users/Kaleb-Reid/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Kaleb-Reid/subscriptions","organizations_url":"https://api.github.com/users/Kaleb-Reid/orgs","repos_url":"https://api.github.com/users/Kaleb-Reid/repos","events_url":"https://api.github.com/users/Kaleb-Reid/events{/privacy}","received_events_url":"https://api.github.com/users/Kaleb-Reid/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-09-20T20:37:10Z","updated_at":"2025-09-20T20:58:55Z","body":"@codevogel Yeah I honestly don't think this is a bug per se, I think this is more of a side effect of incorrect usage of the warnings. The engine internally calls ```update_configuration_warnings()``` at different times depending on what type of node it is. When you want the warnings to be updated you are supposed to call ```update_configuration_warnings()``` or else you should not have any expectations for behaviour.\n\nOne example that might cause this specific behaviour you're referring to is how setting a non-zero position of a Node3D as the scene root causes a warning to appear only after you save the scene. I'm guessing when you save a scene it calls ```get_configuration_warnings()``` internally only on the scene root to see if ```position != Vector3.ZERO```, which also calls the gdscript ```_get_configuration_warnings()``` therefore updating the user-defined warnings as well only for the scene root.","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3315244891/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3938985229","html_url":"https://github.com/godotengine/godot/issues/110578#issuecomment-3938985229","issue_url":"https://api.github.com/repos/godotengine/godot/issues/110578","id":3938985229,"node_id":"IC_kwDOAO6SJc7qyCUN","user":{"login":"codevogel","id":8700780,"node_id":"MDQ6VXNlcjg3MDA3ODA=","avatar_url":"https://avatars.githubusercontent.com/u/8700780?v=4","gravatar_id":"","url":"https://api.github.com/users/codevogel","html_url":"https://github.com/codevogel","followers_url":"https://api.github.com/users/codevogel/followers","following_url":"https://api.github.com/users/codevogel/following{/other_user}","gists_url":"https://api.github.com/users/codevogel/gists{/gist_id}","starred_url":"https://api.github.com/users/codevogel/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/codevogel/subscriptions","organizations_url":"https://api.github.com/users/codevogel/orgs","repos_url":"https://api.github.com/users/codevogel/repos","events_url":"https://api.github.com/users/codevogel/events{/privacy}","received_events_url":"https://api.github.com/users/codevogel/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-02-21T15:45:46Z","updated_at":"2026-02-21T15:45:46Z","body":"Still the case on Godot 4.6\n\n@Kaleb-Reid I get your point, but just keeping the issue open for now until we can confirm this is expected behaviour\n\nhttps://github.com/user-attachments/assets/c8f25507-3445-4594-baaf-fad06a0f2fd8","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3938985229/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3939478802","html_url":"https://github.com/godotengine/godot/issues/110578#issuecomment-3939478802","issue_url":"https://api.github.com/repos/godotengine/godot/issues/110578","id":3939478802,"node_id":"IC_kwDOAO6SJc7qz60S","user":{"login":"KoBeWi","id":2223172,"node_id":"MDQ6VXNlcjIyMjMxNzI=","avatar_url":"https://avatars.githubusercontent.com/u/2223172?v=4","gravatar_id":"","url":"https://api.github.com/users/KoBeWi","html_url":"https://github.com/KoBeWi","followers_url":"https://api.github.com/users/KoBeWi/followers","following_url":"https://api.github.com/users/KoBeWi/following{/other_user}","gists_url":"https://api.github.com/users/KoBeWi/gists{/gist_id}","starred_url":"https://api.github.com/users/KoBeWi/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/KoBeWi/subscriptions","organizations_url":"https://api.github.com/users/KoBeWi/orgs","repos_url":"https://api.github.com/users/KoBeWi/repos","events_url":"https://api.github.com/users/KoBeWi/events{/privacy}","received_events_url":"https://api.github.com/users/KoBeWi/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-02-21T20:59:10Z","updated_at":"2026-02-21T20:59:10Z","body":"`_get_configuration_warnings()` is called for each node in the scene when the scene is loaded. It is not called afterwards, because it's potentially expensive and node warnings are only updated when necessary. A node is supposed to call `update_configuration_warnings()` whenever the warnings state may change. E.g. when you have a warning that depends on a property, you should update the warnings every time the property is set. (the documentation tells you that btw, just with less details)\n\nAs for scene root calls, this is because of #81892 The editor shows a warning if a scene root is transformed, but updating the warning with every move would be too expensive, so it updates on each save as a compromise.","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3939478802/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null}]