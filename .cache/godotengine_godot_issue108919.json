efault":false,"description":"","archived_at":null,"archived_by":null},{"id":279098111,"node_id":"MDU6TGFiZWwyNzkwOTgxMTE=","url":"https://api.github.com/repos/godotengine/godot/labels/topic:rendering","name":"topic:rendering","color":"ffee88","default":false,"description":"","archived_at":null,"archived_by":null},{"id":279098255,"node_id":"MDU6TGFiZWwyNzkwOTgyNTU=","url":"https://api.github.com/repos/godotengine/godot/labels/topic:platforms","name":"topic:platforms","color":"ffee88","default":false,"description":"","archived_at":null,"archived_by":null},{"id":8089024095,"node_id":"LA_kwDOAO6SJc8AAAAB4iS2Xw","url":"https://api.github.com/repos/godotengine/godot/labels/cherrypick:4.4","name":"cherrypick:4.4","color":"446699","default":false,"description":"Considered for cherry-picking into a future 4.4.x release","archived_at":null,"archived_by":null}],"state":"closed","locked":false,"assignees":[],"milestone":{"url":"https://api.github.com/repos/godotengine/godot/milestones/22","html_url":"https://github.com/godotengine/godot/milestone/22","labels_url":"https://api.github.com/repos/godotengine/godot/milestones/22/labels","id":12070367,"node_id":"MI_kwDOAO6SJc4AuC3f","number":22,"title":"4.5","description":"","creator":{"login":"Sauermann","id":6299227,"node_id":"MDQ6VXNlcjYyOTkyMjc=","avatar_url":"https://avatars.githubusercontent.com/u/6299227?v=4","gravatar_id":"","url":"https://api.github.com/users/Sauermann","html_url":"https://github.com/Sauermann","followers_url":"https://api.github.com/users/Sauermann/followers","following_url":"https://api.github.com/users/Sauermann/following{/other_user}","gists_url":"https://api.github.com/users/Sauermann/gists{/gist_id}","starred_url":"https://api.github.com/users/Sauermann/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Sauermann/subscriptions","organizations_url":"https://api.github.com/users/Sauermann/orgs","repos_url":"https://api.github.com/users/Sauermann/repos","events_url":"https://api.github.com/users/Sauermann/events{/privacy}","received_events_url":"https://api.github.com/users/Sauermann/received_events","type":"User","user_view_type":"public","site_admin":false},"open_issues":3,"closed_issues":3687,"state":"closed","created_at":"2024-12-19T08:51:28Z","updated_at":"2026-09-04T21:48:38Z","due_on":"2025-09-15T00:00:00Z","closed_at":"2025-09-18T17:13:14Z"},"comments":15,"created_at":"2025-07-23T22:02:01Z","updated_at":"2025-08-01T16:50:31Z","closed_at":"2025-08-01T16:49:59Z","assignee":null,"author_association":"CONTRIBUTOR","issue_field_values":[],"type":null,"active_lock_reason":null,"draft":false,"pull_request":{"url":"https://api.github.com/repos/godotengine/godot/pulls/108919","html_url":"https://github.com/godotengine/godot/pull/108919","diff_url":"https://github.com/godotengine/godot/pull/108919.diff","patch_url":"https://github.com/godotengine/godot/pull/108919.patch","merged_at":"2025-08-01T16:49:59Z"},"body":"Partial fix for #98207 and #98848\r\n\r\nThe D3D12 initialization code was checking whether the calls to `CheckFeatureSupport()` succeeded, but not the actual returned data, so it would continue initializing even if the Shader Model of the device was too old.\r\n\r\nAdditionally, if this code were to throw an initialization error, Godot would crash trying to uninitialize partially initialized data, due either to missing checks or bad init/deinit order.\r\n\r\nThis is only a partial fix because it doesn't automatically fallback to GL, but it at least displays a friendly error dialog (with instructions on switching renderer) instead of crashing, which is better than nothing.\r\n\r\nIn order for the automatic fallback to work, the Shader Model version check would have to be moved into the ContextDriver, but that requires the `ID3D12Device` which lives in (and is initialized by) the DeviceDriver.\r\n\r\n~~I also bumped the minimum required Shader Model version from 6.0 to 6.1 per [this comment](https://github.com/godotengine/godot/issues/98848#issuecomment-2459449786).~~","closed_by":{"login":"Repiteo","id":17489292,"node_id":"MDQ6VXNlcjE3NDg5Mjky","avatar_url":"https://avatars.githubusercontent.com/u/17489292?v=4","gravatar_id":"","url":"https://api.github.com/users/Repiteo","html_url":"https://github.com/Repiteo","followers_url":"https://api.github.com/users/Repiteo/followers","following_url":"https://api.github.com/users/Repiteo/following{/other_user}","gists_url":"https://api.github.com/users/Repiteo/gists{/gist_id}","starred_url":"https://api.github.com/users/Repiteo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Repiteo/subscriptions","organizations_url":"https://api.github.com/users/Repiteo/orgs","repos_url":"https://api.github.com/users/Repiteo/repos","events_url":"https://api.github.com/users/Repiteo/events{/privacy}","received_events_url":"https://api.github.com/users/Repiteo/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/108919/reactions","total_count":5,"+1":5,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/godotengine/godot/issues/108919/timeline","performed_via_github_app":null,"state_reason":null}