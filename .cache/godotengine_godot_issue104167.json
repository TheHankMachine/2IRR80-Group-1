09-04T21:48:38Z","due_on":"2025-09-15T00:00:00Z","closed_at":"2025-09-18T17:13:14Z"},"comments":1,"created_at":"2025-03-15T08:24:49Z","updated_at":"2026-06-26T16:53:47Z","closed_at":"2025-04-03T14:34:54Z","assignee":null,"author_association":"MEMBER","issue_field_values":[],"type":null,"active_lock_reason":null,"draft":false,"pull_request":{"url":"https://api.github.com/repos/godotengine/godot/pulls/104167","html_url":"https://github.com/godotengine/godot/pull/104167","diff_url":"https://github.com/godotengine/godot/pull/104167.diff","patch_url":"https://github.com/godotengine/godot/pull/104167.patch","merged_at":"2025-04-03T14:34:54Z"},"body":"- Fixes https://github.com/godotengine/godot/issues/103818\r\n- Fixes https://github.com/godotengine/godot/issues/101707\r\n\r\nA `SkeletonModifier3D` that may get the global transform of the external Node target needs an `is_inside_tree()` check, `LookAtModifier3D` already has this check in `_process_modification()`, so it is not a problem.\r\n\r\nI think it is debatable whether the base class `SkeletonModifier3D` should have a check in `_process_modification()`. For now, my opinion is that it is okay to have individual checks, since there is no issue with `SkeletonModifier3D` which does not target external Nodes.","closed_by":{"login":"Repiteo","id":17489292,"node_id":"MDQ6VXNlcjE3NDg5Mjky","avatar_url":"https://avatars.githubusercontent.com/u/17489292?v=4","gravatar_id":"","url":"https://api.github.com/users/Repiteo","html_url":"https://github.com/Repiteo","followers_url":"https://api.github.com/users/Repiteo/followers","following_url":"https://api.github.com/users/Repiteo/following{/other_user}","gists_url":"https://api.github.com/users/Repiteo/gists{/gist_id}","starred_url":"https://api.github.com/users/Repiteo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Repiteo/subscriptions","organizations_url":"https://api.github.com/users/Repiteo/orgs","repos_url":"https://api.github.com/users/Repiteo/re