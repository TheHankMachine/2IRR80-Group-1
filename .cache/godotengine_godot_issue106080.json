ariables back to null. (Some advice as to how this could be implemented would be greatly appreciated 🙏)","closed_by":{"login":"cruglet","id":175854316,"node_id":"U_kgDOCntS7A","avatar_url":"https://avatars.githubusercontent.com/u/175854316?v=4","gravatar_id":"","url":"https://api.github.com/users/cruglet","html_url":"https://github.com/cruglet","followers_url":"https://api.github.com/users/cruglet/followers","following_url":"https://api.github.com/users/cruglet/following{/other_user}","gists_url":"https://api.github.com/users/cruglet/gists{/gist_id}","starred_url":"https://api.github.com/users/cruglet/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/cruglet/subscriptions","organizations_url":"https://api.github.com/users/cruglet/orgs","repos_url":"https://api.github.com/users/cruglet/repos","events_url":"https://api.github.com/users/cruglet/events{/privacy}","received_events_url":"https://api.github.com/users/cruglet/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/106080/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/godotengine/godot/issues/106080/timeline","performed_via_github_app":null,"state_reason":null}