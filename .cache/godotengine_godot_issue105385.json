-09-15T00:00:00Z","closed_at":"2025-09-18T17:13:14Z"},"comments":4,"created_at":"2025-04-14T15:01:05Z","updated_at":"2025-04-25T12:43:11Z","closed_at":"2025-04-24T22:23:38Z","assignee":null,"author_association":"NONE","issue_field_values":[],"type":null,"active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"### Tested versions\n\n- Reproducible in Godot v4.4.1.stable\n\n### System information\n\nGodot v4.4.1.stable - Gentoo 2.17 on X11 - X11 display driver, Multi-window, 1 monitor - Vulkan (Forward+) - dedicated NVIDIA RTX A6000 (nvidia; 570.86.16) - AMD Ryzen 9 5950X 16-Core Processor (32 threads)\n\n### Issue description\n\nThe `Optimize Animation` operation does not respect the interpolation mode of the track (specifically tested with the `nearest` mode).\n\nKeys, that move on a linear trajectory (so essentially keys that *would not* be necessary for linear interpolation, but *are* in fact required for nearest interpolation) are optimized away, causing big discrepancy between before and after optimization, essentially breaking the animation.\n\n### Steps to reproduce\n\n- Create gltf with keys on linear trajectory, but on nearest interpolation.\n- import the file on the correct framerate with or without optimization in the advanced import settings enabled\n\nBefore optimization:\n![Image](https://github.com/user-attachments/assets/27226f0b-076b-41b4-833d-5a9e760b3eaf)\n\nAfter optimization:\n![Image](https://github.com/user-attachments/assets/43aeaa7d-2faa-44b1-9f33-411923145554)\n\n### Minimal reproduction project (MRP)\n\n[bug-animation_optimization_interpolation_mode-mrp.zip](https://github.com/user-attachments/files/19737754/bug-animation_optimization_interpolation_mode-mrp.zip)","closed_by":{"login":"Repiteo","id":17489292,"node_id":"MDQ6VXNlcjE3NDg5Mjky","avatar_url":"https://avatars.githubusercontent.com/u/17489292?v=4","gravatar_id":"","url":"https://api.github.com/users/Repiteo","html_url":"https://github.com/Repiteo","followers_url":"https://api.github.com/users/Repiteo/followers","following_url":"https://api.github.com/users/Repiteo/following{/other_user}","gists_url":"https://api.github.com/users/Repiteo/gists{/gist_id}","starred_url":"https://api.github.com/users/Repiteo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Repiteo/subscriptions","organizations_url":"https://api.github.com/users/Repiteo/orgs","repos_url":"https://api.github.com/users/Repiteo/repos","events_url":"https://api.github.com/users/Repiteo/events{/privacy}","received_events_url":"https://api.github.com/users/Repiteo/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/105385/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/godotengine/godot/issues/105385/timeline","performed_via_github_app":null,"state_reason":"completed","pinned_comment":null}