2749,"node_id":"U_kgDOBtiqnQ","avatar_url":"https://avatars.githubusercontent.com/u/114862749?v=4","gravatar_id":"","url":"https://api.github.com/users/Amogh-2404","html_url":"https://github.com/Amogh-2404","followers_url":"https://api.github.com/users/Amogh-2404/followers","following_url":"https://api.github.com/users/Amogh-2404/following{/other_user}","gists_url":"https://api.github.com/users/Amogh-2404/gists{/gist_id}","starred_url":"https://api.github.com/users/Amogh-2404/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Amogh-2404/subscriptions","organizations_url":"https://api.github.com/users/Amogh-2404/orgs","repos_url":"https://api.github.com/users/Amogh-2404/repos","events_url":"https://api.github.com/users/Amogh-2404/events{/privacy}","received_events_url":"https://api.github.com/users/Amogh-2404/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-11-18T06:41:02Z","updated_at":"2025-11-18T06:41:02Z","body":"I understand the concern. However, debug_fill was introduced in commit 0fc082e for v4.4 - it didn't exist in v4.3. This change restores the v4.3 behavior (wireframe-only gizmos) while keeping the feature available for users who want it.\n\nThe issue thread shows this regression was bisected to that exact commit. Scenes with many collision shapes see exponential draw call increases with filled gizmos enabled.\n\nProjects that explicitly set debug_fill=true will keep working. Only projects relying on the default get the performance fix.\n\nThat said, if changing defaults isn't acceptable, I'm happy to investigate optimizing the gizmo rendering instead. Just wanted to fix the immediate regression first. What would you prefer?","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3545627405/reactions","total_count":1,"+1":0,"-1":1,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3545797883","html_url":"https://github.com/godotengine/godot/pull/112876#issuecomment-3545797883","issue_url":"https://api.github.com/repos/godotengine/godot/issues/112876","id":3545797883,"node_id":"IC_kwDOAO6SJc7TWJT7","user":{"login":"clayjohn","id":16521339,"node_id":"MDQ6VXNlcjE2NTIxMzM5","avatar_url":"https://avatars.githubusercontent.com/u/16521339?v=4","gravatar_id":"","url":"https://api.github.com/users/clayjohn","html_url":"https://github.com/clayjohn","followers_url":"https://api.github.com/users/clayjohn/followers","following_url":"https://api.github.com/users/clayjohn/following{/other_user}","gists_url":"https://api.github.com/users/clayjohn/gists{/gist_id}","starred_url":"https://api.github.com/users/clayjohn/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/clayjohn/subscriptions","organizations_url":"https://api.github.com/users/clayjohn/orgs","repos_url":"https://api.github.com/users/clayjohn/repos","events_url":"https://api.github.com/users/clayjohn/events{/privacy}","received_events_url":"https://api.github.com/users/clayjohn/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-11-18T07:12:49Z","updated_at":"2025-11-18T07:12:49Z","body":"> That said, if changing defaults isn't acceptable, I'm happy to investigate optimizing the gizmo rendering instead. Just wanted to fix the immediate regression first. What would you prefer?\r\n\r\nDefinitely fixing the underlying bug is preferred over just hiding it by changing default settings. ","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3545797883/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3545910442","html