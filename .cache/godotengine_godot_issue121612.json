r\n- Added a ScriptEditor handler that:\r\n\t- Checks whether the change affects debug/gdscript/warnings.\r\n\t- Iterates open script tabs.\r\n\t- Calls validate_script() on each ScriptEditorBase instance.","closed_by":{"login":"kian-g","id":75186370,"node_id":"MDQ6VXNlcjc1MTg2Mzcw","avatar_url":"https://avatars.githubusercontent.com/u/75186370?v=4","gravatar_id":"","url":"https://api.github.com/users/kian-g","html_url":"https://github.com/kian-g","followers_url":"https://api.github.com/users/kian-g/followers","following_url":"https://api.github.com/users/kian-g/following{/other_user}","gists_url":"https://api.github.com/users/kian-g/gists{/gist_id}","starred_url":"https://api.github.com/users/kian-g/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/kian-g/subscriptions","organizations_url":"https://api.github.com/users/kian-g/orgs","repos_url":"https://api.github.com/users/kian-g/repos","events_url":"https://api.github.com/users/kian-g/events{/privacy}","received_events_url":"https://api.github.com/users/kian-g/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/121612/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/godotengine/godot/issues/121612/timeline","performed_via_github_app":null,"state_reason":null}