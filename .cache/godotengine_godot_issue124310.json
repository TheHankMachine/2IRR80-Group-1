ion":"","archived_at":null,"archived_by":null},{"id":1332303119,"node_id":"MDU6TGFiZWwxMzMyMzAzMTE5","url":"https://api.github.com/repos/godotengine/godot/labels/regression","name":"regression","color":"ff63ac","default":false,"description":"","archived_at":null,"archived_by":null},{"id":2666708289,"node_id":"MDU6TGFiZWwyNjY2NzA4Mjg5","url":"https://api.github.com/repos/godotengine/godot/labels/topic:3d","name":"topic:3d","color":"ffee88","default":false,"description":"","archived_at":null,"archived_by":null},{"id":3240950060,"node_id":"MDU6TGFiZWwzMjQwOTUwMDYw","url":"https://api.github.com/repos/godotengine/godot/labels/performance","name":"performance","color":"447777","default":false,"description":"","archived_at":null,"archived_by":null}],"state":"closed","locked":false,"assignees":[],"milestone":{"url":"https://api.github.com/repos/godotengine/godot/milestones/25","html_url":"https://github.com/godotengine/godot/milestone/25","labels_url":"https://api.github.com/repos/godotengine/godot/milestones/25/labels","id":15520464,"node_id":"MI_kwDOAO6SJc4A7NLQ","number":25,"title":"4.8","description":"","creator":{"login":"Repiteo","id":17489292,"node_id":"MDQ6VXNlcjE3NDg5Mjky","avatar_url":"https://avatars.githubusercontent.com/u/17489292?v=4","gravatar_id":"","url":"https://api.github.com/users/Repiteo","html_url":"https://github.com/Repiteo","followers_url":"https://api.github.com/users/Repiteo/followers","following_url":"https://api.github.com/users/Repiteo/following{/other_user}","gists_url":"https://api.github.com/users/Repiteo/gists{/gist_id}","starred_url":"https://api.github.com/users/Repiteo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Repiteo/subscriptions","organizations_url":"https://api.github.com/users/Repiteo/orgs","repos_url":"https://api.github.com/users/Repiteo/repos","events_url":"https://api.github.com/users/Repiteo/events{/privacy}","received_events_url":"https://api.github.com/users/Repiteo/received_events","type":"User","user_view_type":"public","site_admin":false},"open_issues":345,"closed_issues":2336,"state":"open","created_at":"2026-04-13T15:59:35Z","updated_at":"2026-10-22T08:21:32Z","due_on":null,"closed_at":null},"comments":4,"created_at":"2026-10-09T00:29:01Z","updated_at":"2026-10-09T16:09:00Z","closed_at":"2026-10-09T14:41:47Z","assignee":null,"author_association":"MEMBER","issue_field_values":[],"type":null,"active_lock_reason":null,"draft":false,"pull_request":{"url":"https://api.github.com/repos/godotengine/godot/pulls/124310","html_url":"https://github.com/godotengine/godot/pull/124310","diff_url":"https://github.com/godotengine/godot/pull/124310.diff","patch_url":"https://github.com/godotengine/godot/pull/124310.patch","merged_at":"2026-10-09T14:41:47Z"},"body":"Fixes: https://github.com/godotengine/godot/issues/119317\n\n#119317 is a regression from https://github.com/godotengine/godot/pull/80710\n\nWhen both the depth and stencil bits are present and the texture is being upscaled during a blit, then ANGLE falls back on this code path https://github.com/google/angle/blob/d2e5e488da0c6215f8276e5b8d992a4a6ec20c32/src/libANGLE/renderer/d3d/d3d11/Blit11.cpp#L1229-L1341\n\nWhich copies the stencil bits to a staging buffer, then upscales on the CPU and re-uploads the new texture. This absolutely kills performance. \n\nYou can reproduce the issue both on web, or on desktop when using gles3_angle. \n\nThis fix is a safe and minimal and should be included in 4.8. However, I question why we would upscale depth in the first place. It doesn't make any sense to me. @BastiaanOlij do you remember why you added upscaling for depth in https://github.com/godotengine/godot/pull/83976? It seems like a total waste since it happens after post processing, so the depth buffer isn't used anymore. \n\nWe could save a bunch more performance by removing the blit entirely, but I am not comfortable doing that until I know why it is there in the first place. \n\nWith this change, running a basic scene with 0.1 scaling with gles3_angle goes from 350 FPS to 7000 FPS (matching 1.0 scaling)","closed_by":{"login":"Repiteo","id":17489292,"node_id":"MDQ6VXNlcjE3NDg5Mjky","avatar_url":"https://avatars.githubusercontent.com/u/17489292?v=4","gravatar_id":"","url":"https://api.github.com/users/Repiteo","html_url":"https://github.com/Repiteo","followers_url":"https://api.github.com/users/Repiteo/followers","following_url":"https://api.github.com/users/Repiteo/following{/other_user}","gists_url":"https://api.github.com/users/Repiteo/gists{/gist_id}","starred_url":"https://api.github.com/users/Repiteo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Repiteo/subscriptions","organizations_url":"https://api.github.com/users/Repiteo/orgs","repos_url":"https://api.github.com/users/Repiteo/repos","events_url":"https://api.github.com/users/Repiteo/events{/privacy}","received_events_url":"https://api.github.com/users/Repiteo/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/124310/reactions","total_count":4,"+1":0,"-1":0,"laugh":0,"hooray":1,"confused":0,"heart":0,"rocket":0,"eyes":3},"timeline_url":"https://api.github.com/repos/godotengine/godot/issues/124310/timeline","performed_via_github_app":null,"state_reason":null}