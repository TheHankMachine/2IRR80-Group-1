b15c0a48d90ab2954f2869eaf4eda79","original_commit_id":"31832ba3db15c0a48d90ab2954f2869eaf4eda79","user":{"login":"HolonProduction","id":99511741,"node_id":"U_kgDOBe5tvQ","avatar_url":"https://avatars.githubusercontent.com/u/99511741?v=4","gravatar_id":"","url":"https://api.github.com/users/HolonProduction","html_url":"https://github.com/HolonProduction","followers_url":"https://api.github.com/users/HolonProduction/followers","following_url":"https://api.github.com/users/HolonProduction/following{/other_user}","gists_url":"https://api.github.com/users/HolonProduction/gists{/gist_id}","starred_url":"https://api.github.com/users/HolonProduction/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/HolonProduction/subscriptions","organizations_url":"https://api.github.com/users/HolonProduction/orgs","repos_url":"https://api.github.com/users/HolonProduction/repos","events_url":"https://api.github.com/users/HolonProduction/events{/privacy}","received_events_url":"https://api.github.com/users/HolonProduction/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"It's not, so I'd say this should have a `is_hard_type` check for now.","created_at":"2026-09-08T12:15:08Z","updated_at":"2026-09-08T12:15:08Z","html_url":"https://github.com/godotengine/godot/pull/121322#discussion_r3957766997","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/121322","_links":{"self":{"href":"https://api.github.com/repos/godotengine/godot/pulls/comments/3957766997"},"html":{"href":"https://github.com/godotengine/godot/pull/121322#discussion_r3957766997"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/121322"}},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/3957766997/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":null,"original_line":834,"side":"RIGHT","in_reply_to_id":3956713176,"author_association":"MEMBER","original_position":1,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/3958205466","pull_request_review_id":5142083337,"id":3958205466,"node_id":"PRRC_kwDOAO6SJc7r7Wwa","diff_hunk":"@@ -144,6 +144,16 @@ class GDScriptParser {\n \t\t_FORCE_INLINE_ bool is_variant() const { return kind == VARIANT || kind == RESOLVING || kind == UNRESOLVED; }\n \t\t_FORCE_INLINE_ bool is_hard_type() const { return type_source > INFERRED; }\n \n+\t\t_FORCE_INLINE_ GDScriptParser::DataType as_hard_type() const {\n+\t\t\tif (!is_set() || has_no_type() || is_hard_type()) {","path":"modules/gdscript/gdscript_parser.h","commit_id":"3f32c9ace912849ad253cffb37f1f4ed7e92603b","original_commit_id":"31832ba3db15c0a48d90ab2954f2869eaf4eda79","user":{"login":"HolonProduction","id":99511741,"node_id":"U_kgDOBe5tvQ","avatar_url":"https://avatars.githubusercontent.com/u/99511741?v=4","gravatar_id":"","url":"https://api.github.com/users/HolonProduction","html_url":"https://github.com/HolonProduction","followers_url":"https://api.github.com/users/HolonProduction/followers","following_url":"https://api.github.com/users/HolonProduction/following{/other_user}","gists_url":"https://api.github.com/users/HolonProduction/gists{/gist_id}","starred_url":"https://api.github.com/users/HolonProduction/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/HolonProduction/subscriptions","organizations_url":"https://api.github.com/users/HolonProduction/orgs","repos_url":"https://api.github.com/users/HolonProduction/repos","events_url":"https://api.github.com/users/HolonProduction/events{/privacy}","received_events_url":"https://api.github.com/users/HolonProduction/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"I don't know if you are aware in what a rabbit hole you send me with this :sweat_smile: \r\n\r\ntl;dr:\r\n- usually `type_source == UNDETECTED` is paired with `kind == UNRESOLVED` which makes checking both just some defensive programming on my side against invalid state (this is obviously not an original intention, but it's how I mentally modeled this for myself and the assumption under which I wrote the code)\r\n- However there are some rogue initializations that pair `UNDETECTED` with `kind == VARIABLE` in the code paths related to soft suite types which would in theory break my assumption (there is another obvious initialization like this, but that would be removed by https://github.com/godotengine/godot/pull/121164 so it does not matter)\r\n- Those rogue initialization is however bugged because it misuses `DataType operator!=` which considers all `INFERRED` types equal, and since those suite types are always inferred the intended fallback to `VARIANT` never happens. Instead the first return statement of the function dictates the soft type.\r\n\r\nEasily verifiable without this PR:\r\n\r\n```\r\nfunc get_f_wrong(): # Fails as setter because the soft type is int\r\n    if x:\r\n        return 1\r\n    else:\r\n        return \"s\"\r\n\r\nfunc get_f_right(): # Is allowed as setter because the soft type is String\r\n    if x:\r\n        return \"s\"\r\n    else:\r\n        return 1\r\n```\r\n\r\nSo overall it all falls together well because my `type_source == UNDETECTED && kind == UNRESOLVED` assumption is true in practice.\r\n\r\nI'd lean towards not changing this as part of this PR, since `as_hard_type` is a method on `DataType` so we'd run the risk that someone misuses it and it breaks code like `if type_source == UNDETECTED: analyze_this_now()` by silently upgrading the type_source.\r\n\r\nI've put the whole `type_source == UNDETECTED && kind == UNRESOLVED` assumption on my todo list. If I read into that a bit more and remove the few offenders I'd expect we can just merge `is_set` and `is_hard_type` into one function in the future.","created_at":"2026-09-08T13:07:03Z","updated_at":"2026-09-08T13:08:30Z","html_url":"https://github.com/godotengine/godot/pull/121322#discussion_r3958205466","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/121322","_links":{"self":{"href":"https://api.github.com/repos/godotengine/godot/pulls/comments/3958205466"},"html":{"href":"https://github.com/godotengine/godot/pull/121322#discussion_r3958205466"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/121322"}},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/3958205466/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":148,"original_line":148,"side":"RIGHT","in_reply_to_id":3956691699,"author_association":"MEMBER","original_position":5,"position":5,"subject_type":"line"},{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/3958246353","pull_request_review_id":5142140479,"id":3958246353,"node_id":"PRRC_kwDOAO6SJc7r7gvR","diff_hunk":"@@ -144,6 +144,16 @@ class GDScriptParser {\n \t\t_FORCE_INLINE_ bool is_variant() const { return kind == VARIANT || kind == RESOLVING || kind == UNRESOLVED; }\n \t\t_FORCE_INLINE_ bool is_hard_type() const { return type_source > INFERRED; }\n \n+\t\t_FORCE_INLINE_ GDScriptParser::DataType as_hard_type() const {\n+\t\t\tif (!is_set() || has_no_type() || is_hard_type()) {","path":"modules/gdscript/gdscript_parser.h","commit_id":"3f32c9ace912849ad253cffb37f1f4ed7e92603b","original_commit_id":"31832ba3db15c0a48d90ab2954f2869eaf4eda79","user":{"login":"Ivorforce","id":2308167,"node_id":"MDQ6VXNlcjIzMDgxNjc=","avatar_url":"https://avatars.githubusercontent.com/u/2308167?v=4","gravatar_id":"","url":"https://api.github.com/users/Ivorforce","html_url":"https://github.com/Ivorforce","followers_url":"https://api.github.com/users/Ivorforce/followers","following_url":"https://api.github.com/users/Ivorforce/following{/other_use