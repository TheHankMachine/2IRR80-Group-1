[{"id":3474696943,"node_id":"PRR_kwDOAO6SJc7PG6rv","user":{"login":"dsnopek","id":191561,"node_id":"MDQ6VXNlcjE5MTU2MQ==","avatar_url":"https://avatars.githubusercontent.com/u/191561?v=4","gravatar_id":"","url":"https://api.github.com/users/dsnopek","html_url":"https://github.com/dsnopek","followers_url":"https://api.github.com/users/dsnopek/followers","following_url":"https://api.github.com/users/dsnopek/following{/other_user}","gists_url":"https://api.github.com/users/dsnopek/gists{/gist_id}","starred_url":"https://api.github.com/users/dsnopek/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/dsnopek/subscriptions","organizations_url":"https://api.github.com/users/dsnopek/orgs","repos_url":"https://api.github.com/users/dsnopek/repos","events_url":"https://api.github.com/users/dsnopek/events{/privacy}","received_events_url":"https://api.github.com/users/dsnopek/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"Thanks!\r\n\r\nThis is working great in my testing on a Samsung Galaxy XR. For the most part the XR code looks good to me, but I have one question below.\r\n\r\nRegarding the use of `VulkanHooks`: @m4gr3d, @BastiaanOlij and I discussed this, and we can't think of another graphics API or platform aside from OpenXR that would need to use offsets for a VRS texture. So, in our opinion, using `VulkanHooks` is fine for now. It's also completely internal and so if another use case comes up, we can rework this without causing any compatibility issues for developers.\r\n\r\nBut I'm curious to hear what folks on the rendering team think!\r\n\r\n(FYI, the code from the revert of https://github.com/dsnopek/godot/commit/820b5a583993d83d435b38e00ba8de9ca16f88fe was written by @DarioSamo - just to give proper credit :-))","state":"COMMENTED","html_url":"https://github.com/godotengine/godot/pull/112888#pullrequestreview-3474696943","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/112888","auth