i.github.com/users/TrueJole/followers","following_url":"https://api.github.com/users/TrueJole/following{/other_user}","gists_url":"https://api.github.com/users/TrueJole/gists{/gist_id}","starred_url":"https://api.github.com/users/TrueJole/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/TrueJole/subscriptions","organizations_url":"https://api.github.com/users/TrueJole/orgs","repos_url":"https://api.github.com/users/TrueJole/repos","events_url":"https://api.github.com/users/TrueJole/events{/privacy}","received_events_url":"https://api.github.com/users/TrueJole/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-03-11T16:46:05Z","updated_at":"2026-03-11T16:46:05Z","body":"Can confirm on master, and it does not seem to be a regression:\nGodot v4.7.dev (9095a76ff) - Fedora Linux 43 (KDE Plasma Desktop Edition) on Wayland - X11 display driver, Multi-window, 2 monitors - Vulkan (Forward+) - dedicated AMD Radeon RX 9070 XT (RADV GFX1201) - AMD Ryzen 5 9600X 6-Core Processor (6 threads) - 30.42 GiB memory","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4040594895/reactions","total_count":2,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":1},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4040653788","html_url":"https://github.com/godotengine/godot/issues/117327#issuecomment-4040653788","issue_url":"https://api.github.com/repos/godotengine/godot/issues/117327","id":4040653788,"node_id":"IC_kwDOAO6SJc7w13vc","user":{"login":"TrueJole","id":121569485,"node_id":"U_kgDOBz8AzQ","avatar_url":"https://avatars.githubusercontent.com/u/121569485?v=4","gravatar_id":"","url":"https://api.github.com/users/TrueJole","html_url":"https://github.com/TrueJole","followers_url":"https://api.github.com/users/TrueJole/followers","following_url":"https://api.github.com/users/TrueJole/following{/other_user}","gists_url":"https://api.github.com/users/TrueJole/gists{/gist_id}","starred_url":"https://api.github.com/users/TrueJole/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/TrueJole/subscriptions","organizations_url":"https://api.github.com/users/TrueJole/orgs","repos_url":"https://api.github.com/users/TrueJole/repos","events_url":"https://api.github.com/users/TrueJole/events{/privacy}","received_events_url":"https://api.github.com/users/TrueJole/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-03-11T16:55:04Z","updated_at":"2026-03-11T16:55:04Z","body":"Even calling `get_tree().root.remove_child(self)` doesn't fix it, I will look into this","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4040653788/reactions","total_count":2,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":1,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4041234711","html_url":"https://github.com/godotengine/godot/issues/117327#issuecomment-4041234711","issue_url":"https://api.github.com/repos/godotengine/godot/issues/117327","id":4041234711,"node_id":"IC_kwDOAO6SJc7w4FkX","user":{"login":"TrueJole","id":121569485,"node_id":"U_kgDOBz8AzQ","avatar_url":"https://avatars.githubusercontent.com/u/121569485?v=4","gravatar_id":"","url":"https://api.github.com/users/TrueJole","html_url":"https://github.com/TrueJole","followers_url":"https://api.github.com/users/TrueJole/followers","following_url":"https://api.github.com/users/TrueJole/following{/other_user}","gists_url":"https://api.github.com/users/TrueJole/gists{/gist_id}","starred_url":"https://api.github.com/users/TrueJole/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/TrueJole/subscriptions","organizations_url":"https://api.github.com/users/TrueJole/orgs","repos_url":"https://api.github.com/users/TrueJole/repos","events_url":"https://api.github.com/users/TrueJole/events{/privacy}","received_events_url":"https://api.github.com/users/TrueJole/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-03-11T18:25:27Z","updated_at":"2026-03-11T18:25:27Z","body":"Manually calling `get_tree().current_scene = other_scene` works, but this is not reflected in the [documentation](https://docs.godotengine.org/en/stable/tutorials/scripting/change_scenes_manually.html#change-scenes-manually).\nI tried a change that replaces the current_scene with the last added scene if the current scene is removed, as right now it is simply set to null. The problem with that approach is that at that time, the removed the is still in the scene tree as well as any singletons etc. So removing a node could set the current_scene to something else then the main theme.\nPerhaps someone wiser can help out, but I definitely think that this should at least be mentioned in the documentation.\nIf you are interested, take a look at scene/main/scene_tree.cpp:159","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4041234711/reactions","total_count":2,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":1,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4041878348","html_url":"https://github.com/godotengine/godot/issues/117327#issuecomment-4041878348","issue_url":"https://api.github.com/repos/godotengine/godot/issues/117327","id":4041878348,"node_id":"IC_kwDOAO6SJc7w6itM","user":{"login":"jordedwards","id":29870473,"node_id":"MDQ6VXNlcjI5ODcwNDcz","avatar_url":"https://avatars.githubusercontent.com/u/29870473?v=4","gravatar_id":"","url":"https://api.github.com/users/jordedwards","html_url":"https://github.com/jordedwards","followers_url":"https://api.github.com/users/jordedwards/followers","following_url":"https://api.github.com/users/jordedwards/following{/other_user}","gists_url":"https://api.github.com/users/jordedwards/gists{/gist_id}","starred_url":"https://api.github.com/users/jordedwards/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/jordedwards/subscriptions","organizations_url":"https://api.github.com/users/jordedwards/orgs","repos_url":"https://api.github.com/users/jordedwards/repos","events_url":"https://api.github.com/users/jordedwards/events{/privacy}","received_events_url":"https://api.github.com/users/jordedwards/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-03-11T20:06:37Z","updated_at":"2026-03-11T20:06:37Z","body":"IMO setting the `current_scene` to anything other than `null` if the current scene node is removed would be unintuitive. If it's something other than `null`, then adding a node should make it the `current_scene` if it's the only node to exist as well. Having  this behaviour exist implicitly in the add/remove logic is confusing, I think.\n\nI do agree that the documentation around changing scenes is a little confusing though, elaborating how to safely change scenes manually would help.","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4041878348/reactions","total_count":1,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":1,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4041961285","html_url":"https://github.com/godotengine/godot/issues/117327#issuecomment-4041961285","issue_url":"https://api.github.com/repos/godotengine/godot/issues/117327","id":4041961285,"node_id":"IC_kwDOAO6SJc7w629F","user":{"login":"TrueJole","id":121569485,"node_id":"U_kgDOBz8AzQ","avatar_url":"https://avatars.githubusercontent.com/u/121569485?v=4","gravatar_id":"","url":"https://api.github.com/users/TrueJole","html_url":"https://github.com/TrueJole","followers_url":"https://api.github.com/users/TrueJole/followers","following_url":"https://api.github.com/users/TrueJole/following{/other_user}","gists_url":"https://api.github.com/users/TrueJole/gists{/gist_id}","starred_url":"https://api.github.com/users/TrueJole/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/TrueJole/subscriptions","organizations_url":"https://api.github.com/users/TrueJole/orgs","repos_url":"https://api.github.com/users/TrueJole/repos","events_url":"https://api.github.com/users/TrueJole/events{/privacy}","received_events_url":"https://api.github.com/users/TrueJole/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-03-11T20:21:00Z","updated_at":"2026-03-11T20:21:00Z","body":"Setting it to null and then making the next added scene the current_scene worked as well during testing","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4041961285/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4042618630","html_url":"https://github.com/godotengine/godot/issues/117327#issuecomment-4042618630","issue_url":"https://api.github.com/repos/godotengine/godot/issues/117327","id":4042618630,"node_id":"IC_kwDOAO6SJc7w9XcG","user":{"login":"kleonc","id":9283098,"node_id":"MDQ6VXNlcjkyODMwOTg=","avatar_url":"https://avatars.githubusercontent.com/u/9283098?v=4","gravatar_id":"","url":"https://api.github.com/users/kleonc","html_url":"https://github.com/kleonc","followers_url":"https://api.github.com/users/kleonc/followers","following_url":"https://api.github.com/users/kleonc/following{/other_user}","gists_url":"https://api.github.com/users/kleonc/gists{/gist_id}","starred_url":"https://api.github.com/users/kleonc/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/kleonc/subscriptions","organizations_url":"https://api.github.com/users/kleonc/orgs","repos_url":"https://api.github.com/users/kleonc/repos","events_url":"https://api.github.com/users/kleonc/events{/privacy}","received_events_url":"https://api.github.com/users/kleonc/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-03-11T22:21:58Z","updated_at":"2026-03-11T22:21:58Z","body":"> Unable to access `current_scene` anymore\n\nIn what version(s) did this work differently?","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4042618630/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4042631392","html_url":"https://github.com/godotengine/godot/issues/117327#issuecomment-4042631392","issue_url":"https://api.github.com/repos/godotengine/godot/issues/117327","id":4042631392,"node_id":"IC_kwDOAO6SJc7w9ajg","user":{"login":"TrueJole","id":121569485,"node_id":"U_kgDOBz8AzQ","avatar_url":"https://avatars.githubusercontent.com/u/121569485?v=4","gravatar_id":"","url":"https://api.github.com/users/TrueJole","html_url":"https://github.com/TrueJole","followers_url":"https://api.github.com/users/TrueJole/followers","following_url":"https://api.github.com/users/TrueJole/following{/other_user}","gists_url":"https://api.github.com/users/TrueJole/gists{/gist_id}","starred_url":"https://api.github.com/users/TrueJole/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/TrueJole/subscriptions","organizations_url":"https://api.github.com/users/TrueJole/orgs","repos_url":"https://api.github.com/users/TrueJole/repos","events_url":"https://api.github.com/users/TrueJole/events{/privacy}","received_events_url":"https://api.github.com/users/TrueJole/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-03-11T22:24:55Z","updated_at":"2026-03-11T22:26:03Z","body":"I would have to look at the blame, but from what I can tell at least 4.0.4 or even since ever\n\nI was confused by the title too, but I think it means that they can't access current_scene later on in the code, not that the behaviour was ever different","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4042631392/reactions","total_count":2,"+1":2,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4042796097","html_url":"https://github.com/godotengine/godot/issues/117327#issuecomment-4042796097","issue_url":"https://api.github.com/repos/godotengine/godot/issues/117327","id":4042796097,"node_id":"IC_kwDOAO6SJc7w-CxB","user":{"login":"kleonc","id":9283098,"node_id":"MDQ6VXNlcjkyODMwOTg=","avatar_url":"https://avatars.githubusercontent.com/u/9283098?v=4","gravatar_id":"","url":"https://api.github.com/users/kleonc","html_url":"https://github.com/kleonc","followers_url":"https://api.github.com/users/kleonc/followers","following_url":"https://api.github.com/users/kleonc/following{/other_user}","gists_url":"https://api.github.com/users/kleonc/gists{/gist_id}","starred_url":"https://api.github.com/users/kleonc/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/kleonc/subscriptions","organizations_url":"https://api.github.com/users/kleonc/orgs","repos_url":"https://api.github.com/users/kleonc/repos","events_url":"https://api.github.com/users/kleonc/events{/privacy}","received_events_url":"https://api.github.com/users/kleonc/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-03-11T23:06:16Z","updated_at":"2026-03-11T23:06:16Z","body":"> I was confused by the title too, but I think it means that they can't access current_scene later on in the code, not that the behaviour was ever different\n\nAh, you're probably right. I've understood it as _\"in the previous version(s) `current_scene` would not be `null` in such case\"_, not as _\"after manual change `current_scene` is `null` hence I can no longer use it (or methods using it)\"_.\n\nAnyway, I've tested in all latest `4.x` stable versions (`4.0.4`, ..., `4.6.1`), it behaves the same in all of them. Same behavior in v3.6.2.stable.official [3cd3caab6] so it's not like it was changed in `4.0`.\n\nI don't think that's a bug.\n\nThe docs probably could be clarified, suggestions which docs/parts are unclear, need more details, etc. welcomed.","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4042796097/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4042885683","html_url":"https://github.com/godotengine/godot/issues/117327#issuecomment-4042885683","issue_url":"https://api.github.com/repos/godotengine/godot/issues/117327","id":4042885683,"node_id":"IC_kwDOAO6SJc7w-Yoz","user":{"login":"MadeScientist","id":190612698,"node_id":"U_kgDOC1yE2g","avatar_url":"https://avatars.githubusercontent.com/u/190612698?v=4","gravatar_id":"","url":"https://api.github.com/users/MadeScientist","html_url":"https://github.com/MadeScientist","followers_url":"https://api.github.com/users/MadeScientist/followers","following_url":"https://api.github.com/users/MadeScientist/following{/other_user}","gists_url":"https://api.github.com/users/MadeScientist/gists{/gist_id}","starred_url":"https://api.github.com/users/MadeScientist/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/MadeScientist/subscriptions","organizations_url":"https://api.github.com/users/MadeScientist/orgs","repos_url":"https://api.github.com/users/MadeScientist/repos","events_url":"https://api.github.com/users/MadeScientist/events{/privacy}","received_events_url":"https://api.github.com/users/MadeScientist/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-03-11T23:30:11Z","updated_at":"2026-03-11T23:31:44Z","body":"> > I was confused by the title too, but I think it means that they can't access current_scene later on in the code, not that the behaviour was ever different\n> \n> Ah, you're probably right. I've understood it as _\"in the previous version(s) `current_scene` would not be `null` in such case\"_, not as _\"after manual change `current_scene` is `null` hence I can no longer use it (or methods using it)\"_.\n> \n> Anyway, I've tested in all latest `4.x` stable versions (`4.0.4`, ..., `4.6.1`), it behaves the same in all of them. Same behavior in v3.6.2.stable.official [[3cd3caa](https://github.com/godotengine/godot/commit/3cd3caab6779a7f3ec3bbeb9f200db50c735cfc8)] so it's not like it was changed in `4.0`.\n> \n> I don't think that's a bug.\n> \n> The docs probably could be clarified, suggestions which docs/parts are unclear, need more details, etc. welcomed.\n\nTweaked the title. I want to convey that manually removing/adding the root node of a scene causes current_scene to become null (since the documentation states: \"Setting this property directly may not work as expected, as it does not add or remove any nodes from this tree.\" Therefore, I did not assign a value to it manually). As a result, after switching to other.tscn in the example, if you try to use features such as reload_current_scene, an error is thrown indicating that current_scene is null. However, using change_scene_* methods seems that it automatically assign the \"new\" current_scene during the process.","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4042885683/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null}]