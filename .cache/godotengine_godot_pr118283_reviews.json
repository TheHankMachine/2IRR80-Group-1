[{"id":4093554596,"node_id":"PRR_kwDOAO6SJc7z_q-k","user":{"login":"syntaxerror247","id":176927541,"node_id":"U_kgDOCouzNQ","avatar_url":"https://avatars.githubusercontent.com/u/176927541?u=25817fe797fcc7a812ba9d7f58f593f5a003abbb&v=4","gravatar_id":"","url":"https://api.github.com/users/syntaxerror247","html_url":"https://github.com/syntaxerror247","followers_url":"https://api.github.com/users/syntaxerror247/followers","following_url":"https://api.github.com/users/syntaxerror247/following{/other_user}","gists_url":"https://api.github.com/users/syntaxerror247/gists{/gist_id}","starred_url":"https://api.github.com/users/syntaxerror247/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/syntaxerror247/subscriptions","organizations_url":"https://api.github.com/users/syntaxerror247/orgs","repos_url":"https://api.github.com/users/syntaxerror247/repos","events_url":"https://api.github.com/users/syntaxerror247/events{/privacy}","received_events_url":"https://api.github.com/users/syntaxerror247/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"Look good to me.\n\nI did a cursory review of the plugin too and tried to test it, but I wasn't able to. I keep running into errors related to files not loading.\n\nI also couldn't test it with 4.6 because the manually placed OBB file gets deleted on app start. Additionally, I don't have any apps on the Play Store that use OBB, so I can't validate it that way either.\n\nAs I mentioned in the last meeting, I strongly believe that we should consider removing OBB support altogether. The Play Store deprecated it in 2021, and Godot 4 was released in 2023. It's unlikely we'd be breaking compatibility, anyone still relying on OBB is probably using Godot 3.\n\nThat said, since you've already created a plugin for it, if someone does report that they're using OBB, we can ask them to help test and validate the plugin.","state":"APPROVED","html_url":"https://github.com/godotengine/godot/pull/118283#pullrequestreview-4093554596","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/118283","author_association":"MEMBER","_links":{"html":{"href":"https://github.com/godotengine/godot/pull/118283#pullrequestreview-4093554596"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/118283"}},"submitted_at":"2026-04-11T08:06:51Z","commit_id":"31b595cd5eef41cd56f5235aabceb760e6084ac3"},{"id":4112050883,"node_id":"PRR_kwDOAO6SJc71GOrD","user":{"login":"akien-mga","id":4701338,"node_id":"MDQ6VXNlcjQ3MDEzMzg=","avatar_url":"https://avatars.githubusercontent.com/u/4701338?u=4a42fd867f2c449fcc23adf635dd574dae98e6c2&v=4","gravatar_id":"","url":"https://api.github.com/users/akien-mga","html_url":"https://github.com/akien-mga","followers_url":"https://api.github.com/users/akien-mga/followers","following_url":"https://api.github.com/users/akien-mga/following{/other_user}","gists_url":"https://api.github.com/users/akien-mga/gists{/gist_id}","starred_url":"https://api.github.com/users/akien-mga/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/akien-mga/subscriptions","organizations_url":"https://api.github.com/users/akien-mga/orgs","repos_url":"https://api.github.com/users/akien-mga/repos","events_url":"https://api.github.com/users/akien-mga/events{/privacy}","received_events_url":"https://api.github.com/users/akien-mga/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"I agree with the rationale to remove this.\r\n\r\nSmall pedantic terminology note, AFAIUI, \"deprecate\" means \"put a note that something will be removed, but don't remove it\". This PR doesn't deprecate the feature in Godot, it removes it outright without warning. It is however deprecated _by Google Play_ so we're removing a Google-deprecated feature.","state":"APPROVED","html_url":"https://github.com/godotengine/godot/pull/118283#pullrequestreview-4112050883","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/118283","author_association":"MEMBER","_links":{"html":{"href":"https://github.com/godotengine/godot/pull/118283#pullrequestreview-4112050883"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/118283"}},"submitted_at":"2026-04-15T08:38:30Z","commit_id":"31b595cd5eef41cd56f5235aabceb760e6084ac3"}]