b.com/users/PabloNeirotti","html_url":"https://github.com/PabloNeirotti","followers_url":"https://api.github.com/users/PabloNeirotti/followers","following_url":"https://api.github.com/users/PabloNeirotti/following{/other_user}","gists_url":"https://api.github.com/users/PabloNeirotti/gists{/gist_id}","starred_url":"https://api.github.com/users/PabloNeirotti/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/PabloNeirotti/subscriptions","organizations_url":"https://api.github.com/users/PabloNeirotti/orgs","repos_url":"https://api.github.com/users/PabloNeirotti/repos","events_url":"https://api.github.com/users/PabloNeirotti/events{/privacy}","received_events_url":"https://api.github.com/users/PabloNeirotti/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-03-05T09:32:53Z","updated_at":"2025-03-05T09:32:53Z","body":"Ah I see. Might not be related to Godot but the plugin then, as it also seems to be a problem in Godot 4.3. I wasn't sure if Godot was feeding wrong paths or the other way around. Now I know.\n\nI'll close this then. Thank you all for the input!","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2700360398/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2705254568","html_url":"https://github.com/godotengine/godot/issues/103565#issuecomment-2705254568","issue_url":"https://api.github.com/repos/godotengine/godot/issues/103565","id":2705254568,"node_id":"IC_kwDOAO6SJc6hPuio","user":{"login":"DaelonSuzuka","id":18042232,"node_id":"MDQ6VXNlcjE4MDQyMjMy","avatar_url":"https://avatars.githubusercontent.com/u/18042232?v=4","gravatar_id":"","url":"https://api.github.com/users/DaelonSuzuka","html_url":"https://github.com/DaelonSuzuka","followers_url":"https://api.github.com/users/DaelonSuzuka/followers","following_url":"https://api.github.com/users/DaelonSuzuka/following{/other_user}","gists_url":"https://api.github.com/users/DaelonSuzuka/gists{/gist_id}","starred_url":"https://api.github.com/users/DaelonSuzuka/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/DaelonSuzuka/subscriptions","organizations_url":"https://api.github.com/users/DaelonSuzuka/orgs","repos_url":"https://api.github.com/users/DaelonSuzuka/repos","events_url":"https://api.github.com/users/DaelonSuzuka/events{/privacy}","received_events_url":"https://api.github.com/users/DaelonSuzuka/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-03-07T00:39:42Z","updated_at":"2025-03-07T00:57:10Z","body":"@AThousandShips \n\nThis is 100% an engine bug.\n\nhttps://github.com/godotengine/godot/blob/30b0aadab65fcafb9a160dba2c9abfd005bb62a5/modules/gdscript/language_server/gdscript_workspace.cpp#L561-L566\n\nI added debug prints:\n\n```cpp\nString GDScriptWorkspace::get_file_path(const String &p_uri) const {\n    WARN_PRINT(vformat(\"uri: %s\", p_uri));\n\tString path = p_uri.uri_decode();\n    WARN_PRINT(vformat(\"path: %s\", path));\n\tString base_uri = root_uri.uri_decode();\n    WARN_PRINT(vformat(\"base_uri: %s\", base_uri));\n\tpath = path.replacen(base_uri + \"/\", \"res://\");\n    WARN_PRINT(vformat(\"result: %s\", path));\n\treturn path;\n}\n```\n\nThat produces this output, proving that the URI is arriving inside the engine properly and being mangled on line 564:\n\n```\n  WARNING: modules\\gdscript\\language_server\\gdscript_workspace.cpp:562 - uri: file:///p%3A/isotope2/game/world_avatar/AvatarManager.gd\n  WARNING: modules\\gdscript\\language_server\\gdscript_workspace.cpp:564 - path: file:///p:/isotope2/game/world_avatar/AvatarManager.gd\n  WARNING: modules\\gdscript\\language_server\\gdscript_workspace.cpp:566 - base_uri: \n  WARNING: modules\\gdscript\\language_server\\gdscript_workspace.cpp:568 - result: file:res://res://res://p:res://isotope2res://gameres://world_avatarres://AvatarManager.gd\n```\n\n\n![Image](https://github.com/user-attachments/assets/05e6ba53-82cb-497d-a727-200289660cb9)\n\n\n# Edit\n\nThis problem is also appearing in other places, like hover results: https://github.com/godotengine/godot-vscode-plugin/issues/799#issuecomment-2698339194\n","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2705254568/reactions","total_count":2,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":2},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2708969967","html_url":"https://github.com/godotengine/godot/issues/103565#issuecomment-2708969967","issue_url":"https://api.github.com/repos/godotengine/godot/issues/103565","id":2708969967,"node_id":"IC_kwDOAO6SJc6hd5nv","user":{"login":"frostblooded","id":8089067,"node_id":"MDQ6VXNlcjgwODkwNjc=","avatar_url":"https://avatars.githubusercontent.com/u/8089067?v=4","gravatar_id":"","url":"https://api.github.com/users/frostblooded","html_url":"https://github.com/frostblooded","followers_url":"https://api.github.com/users/frostblooded/followers","following_url":"https://api.github.com/users/frostblooded/following{/other_user}","gists_url":"https://api.github.com/users/frostblooded/gists{/gist_id}","starred_url":"https://api.github.com/users/frostblooded/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/frostblooded/subscriptions","organizations_url":"https://api.github.com/users/frostblooded/orgs","repos_url":"https://api.github.com/users/frostblooded/repos","events_url":"https://api.github.com/users/frostblooded/events{/privacy}","received_events_url":"https://api.github.com/users/frostblooded/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-03-09T17:18:02Z","up