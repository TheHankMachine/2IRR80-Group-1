[{"id":3230094738,"node_id":"PRR_kwDOAO6SJc7Ah1WS","user":{"login":"Ivorforce","id":2308167,"node_id":"MDQ6VXNlcjIzMDgxNjc=","avatar_url":"https://avatars.githubusercontent.com/u/2308167?u=f7f8e0273f784f5ec6f6b7fe4a88d449896eb48a&v=4","gravatar_id":"","url":"https://api.github.com/users/Ivorforce","html_url":"https://github.com/Ivorforce","followers_url":"https://api.github.com/users/Ivorforce/followers","following_url":"https://api.github.com/users/Ivorforce/following{/other_user}","gists_url":"https://api.github.com/users/Ivorforce/gists{/gist_id}","starred_url":"https://api.github.com/users/Ivorforce/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Ivorforce/subscriptions","organizations_url":"https://api.github.com/users/Ivorforce/orgs","repos_url":"https://api.github.com/users/Ivorforce/repos","events_url":"https://api.github.com/users/Ivorforce/events{/privacy}","received_events_url":"https://api.github.com/users/Ivorforce/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"Good find! But I don't think this is the best way to approach optimizing this function.\r\n\r\nI'm guessing the bottleneck is the repeated `get_child` call, both because of the thread guard, but also because it does a lot of unnecessary checks.\r\n\r\nI think the best way to optimize this function would be to continue using the children cache, but do so directly with a plain old loop.\r\n\r\nFirst call `_update_children_cache`.\r\n\r\nThen, it should determine start and end index in the children cache based on `p_include_internal` (either `0` and `data.children_cache.size()`, or based on `data.internal_children_front_count_cache` and `data.internal_children_back_count_cache`).\r\n\r\nFinally, it should loop from start to end, appending to the array the child in the cache at the corresponding index.\r\nThis should come out cleaner and faster than your current solution.\r\n\r\nLet me know if you want to adjust the PR accordingly, or if I should make a superseding PR.","state":"CHANGES_REQUESTED","html_url":"https://github.com/godotengine/godot/pull/110571#pullrequestreview-3230094738","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/110571","author_association":"MEMBER","_links":{"html":{"href":"https://github.com/godotengine/godot/pull/110571#pullrequestreview-3230094738"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/110571"}},"submitted_at":"2025-09-16T13:46:16Z","commit_id":null},{"id":3231322367,"node_id":"PRR_kwDOAO6SJc7AmhD_","user":{"login":"Ivorforce","id":2308167,"node_id":"MDQ6VXNlcjIzMDgxNjc=","avatar_url":"https://avatars.githubusercontent.com/u/2308167?u=f7f8e0273f784f5ec6f6b7fe4a88d449896eb48a&v=4","gravatar_id":"","url":"https://api.github.com/users/Ivorforce","html_url":"https://github.com/Ivorforce","followers_url":"https://api.github.com/users/Ivorforce/followers","following_url":"https://api.github.com/users/Ivorforce/following{/other_user}","gists_url":"https://api.github.com/users/Ivorforce/gists{/gist_id}","starred_url":"https://api.github.com/users/Ivorforce/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Ivorforce/subscriptions","organizations_url":"https://api.github.com/users/Ivorforce/orgs","repos_url":"https://api.github.com/users/Ivorforce/repos","events_url":"https://api.github.com/users/Ivorforce/events{/privacy}","received_events_url":"https://api.github.com/users/Ivorforce/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"","state":"COMMENTED","html_url":"https://github.com/godotengine/godot/pull/110571#pullrequestreview-3231322367","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/110571","author_association":"MEMBER","_links":{"html":{"href":"https://github.com/godotengine/godot/pull/110571#pullrequestreview-3231322367"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/110571"}},"submitted_at":"2025-09-16T19:09:17Z","commit_id":null},{"id":3231719627,"node_id":"PRR_kwDOAO6SJc7AoCDL","user":{"login":"Ivorforce","id":2308167,"node_id":"MDQ6VXNlcjIzMDgxNjc=","avatar_url":"https://avatars.githubusercontent.com/u/2308167?u=f7f8e0273f784f5ec6f6b7fe4a88d449896eb48a&v=4","gravatar_id":"","url":"https://api.github.com/users/Ivorforce","html_url":"https://github.com/Ivorforce","followers_url":"https://api.github.com/users/Ivorforce/followers","following_url":"https://api.github.com/users/Ivorforce/following{/other_user}","gists_url":"https://api.github.com/users/Ivorforce/gists{/gist_id}","starred_url":"https://api.github.com/users/Ivorforce/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Ivorforce/subscriptions","organizations_url":"https://api.github.com/users/Ivorforce/orgs","repos_url":"https://api.github.com/users/Ivorforce/repos","events_url":"https://api.github.com/users/Ivorforce/events{/privacy}","received_events_url":"https://api.github.com/users/Ivorforce/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"","state":"COMMENTED","html_url":"https://github.com/godotengine/godot/pull/110571#pullrequestreview-3231719627","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/110571","author_association":"MEMBER","_links":{"html":{"href":"https://github.com/godotengine/godot/pull/110571#pullrequestreview-3231719627"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/110571"}},"submitted_at":"2025-09-16T21:12:21Z","commit_id":null},{"id":3231905847,"node_id":"PRR_kwDOAO6SJc7Aovg3","user":{"login":"Ivorforce","id":2308167,"node_id":"MDQ6VXNlcjIzMDgxNjc=","avatar_url":"https://avatars.githubusercontent.com/u/2308167?u=f7f8e0273f784f5ec6f6b7fe4a88d449896eb48a&v=4","gravatar_id":"","url":"https://api.github.com/users/Ivorforce","html_url":"https://github.com/Ivorforce","followers_url":"https://api.github.com/users/Ivorforce/followers","following_url":"https://api.github.com/users/Ivorforce/following{/other_user}","gists_url":"https://api.github.com/users/Ivorforce/gists{/gist_id}","starred_url":"https://api.github.com/users/Ivorforce/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Ivorforce/subscriptions","organizations_url":"https://api.github.com/users/Ivorforce/orgs","repos_url":"https://api.github.com/users/Ivorforce/repos","events_url":"https://api.github.com/users/Ivorforce/events{/privacy}","received_events_url":"https://api.github.com/users/Ivorforce/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"Looks good to me! Thanks for being open about changing the implementation in this way.\r\n\r\nFor completion's sake, I'd be interested in a benchmark of the current version against `master`, just to make sure it's a substantial improvement still. But we can merge without it; I'm pretty confident `get_child` was the major bottleneck to solve here.","state":"APPROVED","html_url":"https://github.com/godotengine/godot/pull/110571#pullrequestreview-3231905847","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/110571","author_association":"MEMBER","_links":{"html":{"href":"https://github.com/godotengine/godot/pull/110571#pullrequestreview-3231905847"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/110571"}},"submitted_at":"2025-09-16T22:36:48Z","commit_id":null},{"id":3231970699,"node_id":"PRR_kwDOAO6SJc7Ao_WL","user":{"login":"Calinou","id":180032,"node_id":"MDQ6VXNlcjE4MDAzMg==","avatar_url":"https://avatars.githubusercontent.com/u/180032?u=68d23e7ee9cdf810da125e8510b72f845b9dccc8&v=4","gravatar_id":"","url":"https://api.github.com/users/Calinou","html_url":"https://github.com/Calinou","followers_url":"https://api.github.com/users/Calinou/followers","following_url":"https://api.github.com/users/Calinou/following{/other_user}","gists_url":"https://api.github.com/users/Calinou/gists{/gist_id}","starred_url":"https://api.github.com/users/Calinou/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Calinou/subscriptions","organizations_url":"https://api.github.com/users/Calinou/orgs","repos_url":"https://api.github.com/users/Calinou/repos","events_url":"https://api.github.com/users/Calinou/events{/privacy}","received_events_url":"https://api.github.com/users/Calinou/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"Tested locally, it works as expected. Code looks good to me.\r\n\r\n## Benchmark\r\n\r\n<details open>\r\n\r\n<summary>PC specifications</summary>\r\n\r\n- **CPU:** AMD Ryzen 9 9950X3D\r\n- **GPU:** NVIDIA GeForce RTX 5090\r\n- **RAM:** 64 GB (2×32 GB DDR5-6000 CL30)\r\n- **SSD:** Solidigm P44 Pro 2 TB\r\n- **OS:** Linux (Fedora 42)\r\n</details>\r\n\r\nUsing a release export template binary with LTO with the GDScript code from the first comment. 300,000 *total* iterations on each run (higher values cause a crash due to the message queue running out of memory). Values shown are an average of 5 runs for each.\r\n\r\n### Include internal\r\n\r\nBefore | After\r\n-|-\r\n6603 µs | 6529 µs\r\n\r\n### Exclude internal\r\n\r\nBefore | After\r\n-|-\r\n1892 µs | 1855 µs\r\n\r\nThe performance improvement is very small (within margin of error possibly, as there's some variance).","state":"COMMENTED","html_url":"https://github.com/godotengine/godot/pull/110571#pullrequestreview-3231970699","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/110571","author_association":"MEMBER","_links":{"html":{"href":"https://github.com/godotengine/godot/pull/110571#pullrequestreview-3231970699"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/110571"}},"submitted_at":"2025-09-16T23:13:22Z","commit_id":null},{"id":3233102588,"node_id":"PRR_kwDOAO6SJc7AtTr8","user":{"login":"Ivorforce","id":2308167,"node_id":"MDQ6VXNlcjIzMDgxNjc=","avatar_url":"https://avatars.githubusercontent.com/u/2308167?u=f7f8e0273f784f5ec6f6b7fe4a88d449896eb48a&v=4","gravatar_id":"","url":"https://api.github.com/users/Ivorforce","html_url":"https://github.com/Ivorforce","followers_url":"https://api.github.com/users/Ivorforce/followers","following_url":"https://api.github.com/users/Ivorforce/following{/other_user}","gists_url":"https://api.github.com/users/Ivorforce/gists{/gist_id}","starred_url":"https://api.github.com/users/Ivorforce/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Ivorforce/subscriptions","organizations_url":"https://api.github.com/users/Ivorforce/orgs","repos_url":"https://api.github.com/users/Ivorforce/repos","events_url":"https://api.github.com/users/Ivorforce/events{/privacy}","received_events_url":"https://api.github.com/users/Ivorforce/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"The `Array::Iterator` approach should eliminate the unnecessary `CoW` / `Array` interface checks, so I'm guessing it will speed up the implementation some more. But now I'd like to see a benchmark again.\r\n\r\nAnyway, I don't think your new approach (separate loops + iterator for `Array` is more complicated than the previous one, so this still works for me either way.\r\n\r\n> it appears that separating both loops results in faster execution\r\n\r\nNote that `1ms` execution time difference is neglibigle in CPU terms. We expect fluctuations of up to ~10ms every run (highly depending on the benchmark of course). You should increase the number of iterations in your benchmark to reach the upper hundreds of milliseconds, or even single digit seconds range. The same holds for @Calinou's benchmark, which appears to be in the millisecond range.","state":"APPROVED","html_url":"https://github.com/godotengine/godot/pull/110571#pullrequestreview-3233102588","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/110571","author_association":"MEMBER","_links":{"html":{"href":"https://github.com/godotengine/godot/pull/110571#pullrequestreview-3233102588"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/110571"}},"submitted_at":"2025-09-17T07:43:21Z","commit_id":null},{"id":3233886866,"node_id":"PRR_kwDOAO6SJc7AwTKS","user":{"login":"Ivorforce","id":2308167,"node_id":"MDQ6VXNlcjIzMDgxNjc=","avatar_url":"https://avatars.githubusercontent.com/u/2308167?u=f7f8e0273f784f5ec6f6b7fe4a88d449896eb48a&v=4","gravatar_id":"","url":"https://api.github.com/users/Ivorforce","html_url":"https://github.com/Ivorforce","followers_url":"https://api.github.com/users/Ivorforce/followers","following_url":"https://api.github.com/users/Ivorforce/following{/other_user}","gists_url":"https://api.github.com/users/Ivorforce/gists{/gist_id}","starred_url":"https://api.github.com/users/Ivorforce/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Ivorforce/subscriptions","organizations_url":"https://api.github.com/users/Ivorforce/orgs","repos_url":"https://api.github.com/users/Ivorforce/repos","events_url":"https://api.github.com/users/Ivorforce/events{/privacy}","received_events_url":"https://api.github.com/users/Ivorforce/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"Re-approving latest version.","state":"APPROVED","html_url":"https://github.com/godotengine/godot/pull/110571#pullrequestreview-3233886866","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/110571","author_association":"MEMBER","_links":{"html":{"href":"https://github.com/godotengine/godot/pull/110571#pullrequestreview-3233886866"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/110571"}},"submitted_at":"2025-09-17T11:04:07Z","commit_id":"7dc6df3051ab9e36abd8c5fbd30fc49f6d6434db"}]