t":null,"archived_by":null},{"id":1609442062,"node_id":"MDU6TGFiZWwxNjA5NDQyMDYy","url":"https://api.github.com/repos/godotengine/godot/labels/topic:shaders","name":"topic:shaders","color":"ffee88","default":false,"description":"","archived_at":null,"archived_by":null},{"id":3240950060,"node_id":"MDU6TGFiZWwzMjQwOTUwMDYw","url":"https://api.github.com/repos/godotengine/godot/labels/performance","name":"performance","color":"447777","default":false,"description":"","archived_at":null,"archived_by":null}],"state":"closed","locked":false,"assignees":[],"milestone":{"url":"https://api.github.com/repos/godotengine/godot/milestones/25","html_url":"https://github.com/godotengine/godot/milestone/25","labels_url":"https://api.github.com/repos/godotengine/godot/milestones/25/labels","id":15520464,"node_id":"MI_kwDOAO6SJc4A7NLQ","number":25,"title":"4.8","description":"","creator":{"login":"Repiteo","id":17489292,"node_id":"MDQ6VXNlcjE3NDg5Mjky","avatar_url":"https://avatars.githubusercontent.com/u/17489292?v=4","gravatar_id":"","url":"https://api.github.com/users/Repiteo","html_url":"https://github.com/Repiteo","followers_url":"https://api.github.com/users/Repiteo/followers","following_url":"https://api.github.com/users/Repiteo/following{/other_user}","gists_url":"https://api.github.com/users/Repiteo/gists{/gist_id}","starred_url":"https://api.github.com/users/Repiteo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Repiteo/subscriptions","organizations_url":"https://api.github.com/users/Repiteo/orgs","repos_url":"https://api.github.com/users/Repiteo/repos","events_url":"https://api.github.com/users/Repiteo/events{/privacy}","received_events_url":"https://api.github.com/users/Repiteo/received_events","type":"User","user_view_type":"public","site_admin":false},"open_issues":350,"closed_issues":2337,"state":"open","created_at":"2026-04-13T15:59:35Z","updated_at":"2026-10-22T14:39:02Z","due_on":null,"closed_at":null},"comments":18,"created_at":"2025-05-11T11:31:04Z","updated_at":"2026-06-18T15:26:36Z","closed_at":"2026-06-18T15:25:18Z","assignee":null,"author_association":"NONE","issue_field_values":[],"type":null,"active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"### Tested versions\n\n4.4.0\n\n### System information\n\nNot relevant\n\n### Issue description\n\nWhen creating an ArrayMesh with only vertex data and then using `NORMAL_MAP` in the fragment shader, the following message is logged:\n\n> Attempting to use a shader %s that requires tangents with a mesh %s that doesn't contain tangents.\n\n1. This error message is incorrect because the `NORMAL`, `TANGENT` and `BINORMAL` variable is writable from the vertex shader and works when subsequently using `NORMAL_MAP` in the fragment shader. (See reproduction project.)\n2. The constant printing of this error message is causing a major performance hog, dropping from 100 fps to 60 on my small-scale test project whenever the meshes update. (Note, this is NOT the MRP, but an actual real-life project.)\n\nThe reason behind not generating the normals / tangents as part of the mesh is the desire to send less data to the GPU in order to optimize throughput. In my use case, the normals can be generated on the GPU (along with vertex displacement) so the data doesn't need to be sent along.\n\nThis message gets logged both in debug and release builds and there seems to be no way to disable it or work around it. I believe, this should either be made dev-only, or ideally removed/put behind a project settings/render_mode flag.\n\n\n### Steps to reproduce\n\n(See MRP)\n \n- Create a mesh using ArrayMesh with only vertex data.\n- Generate `NORMAL`, `TANGENT` and `BINORMAL` data in the vertex shader.\n- Use `NORMAL_MAP` in the fragment shader.\n\n### Minimal reproduction project (MRP)\n\n[tangent-shader-gen-repro.zip](https://github.com/user-attachments/files/20148617/tangent-shader-gen-repro.zip)\n\n| Normals + tangents generated | Normals generated | Nothing generated |\n|------------------------------|-------------------|-------------------|\n| ![Image](https://github.com/user-attachments/assets/81a75bb3-ab27-4346-a3ff-b914f02513e2) | ![Image](https://github.com/user-attachments/assets/99d89579-cc5d-4cf3-810d-11bec52839ba) | ![Image](https://github.com/user-attachments/assets/4720e6eb-6d62-4f64-8bcb-ad15c970115d) |\n\n[Textures from PolyHaven under CC0](https://polyhaven.com/a/rocky_terrain_02)","closed_by":{"login":"Repiteo","id":17489292,"node_id":"MDQ6VXNlcjE3NDg5Mjky","avatar_url":"https://avatars.githubusercontent.com/u/17489292?v=4","gravatar_id":"","url":"https://api.github.com/users/Repiteo","html_url":"https://github.com/Repiteo","followers_url":"https://api.github.com/users/Repiteo/followers","following_url":"https://api.github.com/users/Repiteo/following{/other_user}","gists_url":"https://api.github.com/users/Repiteo/gists{/gist_id}","starred_url":"https://api.github.com/users/Repiteo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Repiteo/subscriptions","organizations_url":"https://api.github.com/users/Repiteo/orgs","repos_url":"https://api.github.com/users/Repiteo/repos","events_url":"https://api.github.com/users/Repiteo/events{/privacy}","received_events_url":"https://api.github.com/users/Repiteo/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/106276/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/godotengine/godot/issues/106276/timeline","performed_via_github_app":null,"state_reason":"completed","pinned_comment":null}