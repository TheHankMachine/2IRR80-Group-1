[{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2532271564","html_url":"https://github.com/godotengine/godot/pull/100248#issuecomment-2532271564","issue_url":"https://api.github.com/repos/godotengine/godot/issues/100248","id":2532271564,"node_id":"IC_kwDOAO6SJc6W72XM","user":{"login":"Calinou","id":180032,"node_id":"MDQ6VXNlcjE4MDAzMg==","avatar_url":"https://avatars.githubusercontent.com/u/180032?v=4","gravatar_id":"","url":"https://api.github.com/users/Calinou","html_url":"https://github.com/Calinou","followers_url":"https://api.github.com/users/Calinou/followers","following_url":"https://api.github.com/users/Calinou/following{/other_user}","gists_url":"https://api.github.com/users/Calinou/gists{/gist_id}","starred_url":"https://api.github.com/users/Calinou/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Calinou/subscriptions","organizations_url":"https://api.github.com/users/Calinou/orgs","repos_url":"https://api.github.com/users/Calinou/repos","events_url":"https://api.github.com/users/Calinou/events{/privacy}","received_events_url":"https://api.github.com/users/Calinou/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2024-12-10T16:50:45Z","updated_at":"2024-12-10T16:51:34Z","body":"> Unfortunately, there is no WARN output state for github actions, or at least https://github.com/godotengine/godot/pull/99126 I didn't find a good way to do it.\r\n\r\nYou can have GitHub Actions post a comment on the PR if the threshold is reached, but it should only do this once and edit its comment if one already exists.\r\n\r\nYou could also have GitHub Actions edit the first post (as done in https://github.com/godotengine/godot/pull/76762), but this is more involved.","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2532271564/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2532279212","html_url":"https://github.com/godotengine/godot/pull/100248#issuecomment-2532279212","issue_url":"https://api.github.com/repos/godotengine/godot/issues/100248","id":2532279212,"node_id":"IC_kwDOAO6SJc6W74Os","user":{"login":"AThousandShips","id":96648715,"node_id":"U_kgDOBcK-Cw","avatar_url":"https://avatars.githubusercontent.com/u/96648715?v=4","gravatar_id":"","url":"https://api.github.com/users/AThousandShips","html_url":"https://github.com/AThousandShips","followers_url":"https://api.github.com/users/AThousandShips/followers","following_url":"https://api.github.com/users/AThousandShips/following{/other_user}","gists_url":"https://api.github.com/users/AThousandShips/gists{/gist_id}","starred_url":"https://api.github.com/users/AThousandShips/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/AThousandShips/subscriptions","organizations_url":"https://api.github.com/users/AThousandShips/orgs","repos_url":"https://api.github.com/users/AThousandShips/repos","events_url":"https://api.github.com/users/AThousandShips/events{/privacy}","received_events_url":"https://api.github.com/users/AThousandShips/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2024-12-10T16:54:19Z","updated_at":"2024-12-10T16:54:19Z","body":"Doesn't commenting on a PR require write access?","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2532279212/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2532344993","html_url":"https://github.com/godotengine/godot/pull/100248#issuecomment-2532344993","issue_url":"https://api.github.com/repos/godotengine/godot/issues/100248","id":2532344993,"node_id":"IC_kwDOAO6SJc6W8ISh","user":{"login":"Ivorforce","id":2308167,"node_id":"MDQ6VXNlcjIzMDgxNjc=","avatar_url":"https://avatars.githubusercontent.com/u/2308167?v=4","gravatar_id":"","url":"https://api.github.com/users/Ivorforce","html_url":"https://github.com/Ivorforce","followers_url":"https://api.github.com/users/Ivorforce/followers","following_url":"https://api.github.com/users/Ivorforce/following{/other_user}","gists_url":"https://api.github.com/users/Ivorforce/gists{/gist_id}","starred_url":"https://api.github.com/users/Ivorforce/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Ivorforce/subscriptions","organizations_url":"https://api.github.com/users/Ivorforce/orgs","repos_url":"https://api.github.com/users/Ivorforce/repos","events_url":"https://api.github.com/users/Ivorforce/events{/privacy}","received_events_url":"https://api.github.com/users/Ivorforce/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2024-12-10T17:23:47Z","updated_at":"2024-12-12T00:47:45Z","body":"Ok, this was more complicated than hoped (as is always, lol).\r\nBut the check now works consistently across macOS and Linux (idk about Windows).\r\n\r\n@Calinou and @fire, does this reflect your original vision?\r\n\r\nEdit: I think the \"larger\" detections are because the upload action avoids uploading some meta files or something that is not present locally.\r\nWe could download the binary we just uploaded, but i think it would be smarter to just loosen the equal check to like 200 bytes and call it a day.\r\nEdit 2: actually no I think it would be best to just define an output on build and ask that from the ref, without downloading anything. Would require a bit of restructure though. ","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2532344993/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3355669564","html_url":"https://github.com/godotengine/godot/pull/100248#issuecomment-3355669564","issue_url":"https://api.github.com/repos/godotengine/godot/issues/100248","id":3355669564,"node_id":"IC_kwDOAO6SJc7IA3Q8","user":{"login":"Ivorforce","id":2308167,"node_id":"MDQ6VXNlcjIzMDgxNjc=","avatar_url":"https://avatars.githubusercontent.com/u/2308167?v=4","gravatar_id":"","url":"https://api.github.com/users/Ivorforce","html_url":"https://github.com/Ivorforce","followers_url":"https://api.github.com/users/Ivorforce/followers","following_url":"https://api.github.com/users/Ivorforce/following{/other_user}","gists_url":"https://api.github.com/users/Ivorforce/gists{/gist_id}","starred_url":"https://api.github.com/users/Ivorforce/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Ivorforce/subscriptions","organizations_url":"https://api.github.com/users/Ivorforce/orgs","repos_url":"https://api.github.com/users/Ivorforce/repos","events_url":"https://api.github.com/users/Ivorforce/events{/privacy}","received_events_url":"https://api.github.com/users/Ivorforce/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-10-01T10:18:50Z","updated_at":"2025-10-01T10:18:50Z","body":"Closing this because this problem happens rarely, there's no good solution for it, and we're (now) tracking binary size in a graph at https://benchmarks.godotengine.org. Regressions should be traceable well enough using that method.","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3355669564/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null}]