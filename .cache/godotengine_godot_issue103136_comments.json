.github.com/users/beicause/following{/other_user}","gists_url":"https://api.github.com/users/beicause/gists{/gist_id}","starred_url":"https://api.github.com/users/beicause/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/beicause/subscriptions","organizations_url":"https://api.github.com/users/beicause/orgs","repos_url":"https://api.github.com/users/beicause/repos","events_url":"https://api.github.com/users/beicause/events{/privacy}","received_events_url":"https://api.github.com/users/beicause/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-02-23T12:10:43Z","updated_at":"2025-02-23T12:40:47Z","body":"<img src=\"https://github.com/user-attachments/assets/3063db88-bbc7-442d-b0ca-4ea88a72b26c\" height=300/>\n\nI find the reason. It should be set in \"Scene\" import defaults, not AnimationLibrary.\nAlthough this is not a bug, I think the unused import settings in the AnimationLibrary should be hidden.","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2676826798/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2676874470","html_url":"https://github.com/godotengine/godot/issues/103136#issuecomment-2676874470","issue_url":"https://api.github.com/repos/godotengine/godot/issues/103136","id":2676874470,"node_id":"IC_kwDOAO6SJc6fjdzm","user":{"login":"prominentdetail","id":10412778,"node_id":"MDQ6VXNlcjEwNDEyNzc4","avatar_url":"https://avatars.githubusercontent.com/u/10412778?v=4","gravatar_id":"","url":"https://api.github.com/users/prominentdetail","html_url":"https://github.com/prominentdetail","followers_url":"https://api.github.com/users/prominentdetail/followers","following_url":"https://api.github.com/users/prominentdetail/following{/other_user}"