4701338?v=4","gravatar_id":"","url":"https://api.github.com/users/akien-mga","html_url":"https://github.com/akien-mga","followers_url":"https://api.github.com/users/akien-mga/followers","following_url":"https://api.github.com/users/akien-mga/following{/other_user}","gists_url":"https://api.github.com/users/akien-mga/gists{/gist_id}","starred_url":"https://api.github.com/users/akien-mga/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/akien-mga/subscriptions","organizations_url":"https://api.github.com/users/akien-mga/orgs","repos_url":"https://api.github.com/users/akien-mga/repos","events_url":"https://api.github.com/users/akien-mga/events{/privacy}","received_events_url":"https://api.github.com/users/akien-mga/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-01-22T20:40:20Z","updated_at":"2026-01-22T20:40:36Z","body":"I assume you can work it around by assigning a placeholder shortcut that you won't hit when navigating (e.g. Windows key or `;`) instead of deleting the default one.\n\nSo this doesn't seem a critical issue as it happens only on a non standard config, has a workaround, and thus not a priority at RC stage (with the potential for regressions that come from any last minute change).","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3786595088/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3786675802","html_url":"https://github.com/godotengine/godot/issues/114997#issuecomment-3786675802","issue_url":"https://api.github.com/repos/godotengine/godot/issues/114997","id":3786675802,"node_id":"IC_kwDOAO6SJc7htBZa","user":{"login":"Nodragem","id":10520249,"node_id":"MDQ6VXNlcjEwNTIwMjQ5","avatar_url":"https://avatars.githubusercontent.com/u/10520249?v=4","gravatar_id":"","url":"https://api.github.com/users/Nodragem","html_url":"https://github.com/Nodragem","followers_url":"https://api.github.com/users/Nodragem/followers","following_url":"https://api.github.com/users/Nodragem/following{/other_user}","gists_url":"https://api.github.com/users/Nodragem/gists{/gist_id}","starred_url":"https://api.github.com/users/Nodragem/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Nodragem/subscriptions","organizations_url":"https://api.github.com/users/Nodragem/orgs","repos_url":"https://api.github.com/users/Nodragem/repos","events_url":"https://api.github.com/users/Nodragem/events{/privacy}","received_events_url":"https://api.github.com/users/Nodragem/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-01-22T21:03:52Z","updated_at":"2026-01-22T21:03:52Z","body":"The workaround is working, didn't think of that 😄 yet, I would not say that my config is non standard: the Modo navigation scheme is part of the standard options given to the users in the editor settings.","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3786675802/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3787382726","html_url":"https://github.com/godotengine/godot/issues/114997#issuecomment-3787382726","issue_url":"https://api.github.com/repos/godotengine/godot/issues/114997","id":3787382726,"node_id":"IC_kwDOAO6SJc7hvt_G","user":{"login":"ryevdokimov","id":105675984,"node_id":"U_kgDOBkx80A","avatar_url":"https://avatars.githubusercontent.com/u/105675984?v=4","gravatar_id":"","url":"https://api.github.com/users/ryevdokimov","html_url":"https://github.com/ryevdokimov","followers_url":"https://api.github.com/users/ryevdokimov/followers","following_url":"https://api.github.com/users/ryevdokimov/following{/other_user}","gists_url":"https://api.github.com/users/ryevdokimov/gists{/gist_id}","starred_url":"https://api.github.com/users/ryevdokimov/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/ryevdokimov/subscriptions","organizations_url":"https://api.github.com/users/ryevdokimov/orgs","repos_url":"https://api.github.com/users/ryevdokimov/repos","events_url":"https://api.github.com/users/ryevdokimov/events{/privacy}","received_events_url":"https://api.github.com/users/ryevdokimov/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-01-22T23:46:25Z","updated_at":"2026-01-22T23:47:14Z","body":"We should probably track this as at least a noncritical release blocker though, since it is technically a DX regression that affects Modo and Maya users. My PR doesn't actually address the real nature of this regression in that there is a default conflict with those navigation modes that now requires a work around that might not be obvious. That will require a different fix, separate from the linked PR. ","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3787382726/reactions","total_count":2,"+1":2,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3789156228","html_url":"https://github.com/godotengine/godot/issues/114997#issuecomment-3789156228","issue_url":"https://api.github.com/repos/godotengine/godot/issues/114997","id":3789156228,"node_id":"IC_kwDOAO6SJc7h2e-E","user":{"login":"Nodragem","id":10520249,"node_id":"MDQ6VXNlcjEwNTIwMjQ5","avatar_url":"https://avatars.githubusercontent.com/u/10520249?v=4","gravatar_id":"","url":"https://api.github.com/users/Nodragem","html_url":"https://github.com/Nodragem","followers_url":