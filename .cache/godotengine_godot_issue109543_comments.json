[{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3178902510","html_url":"https://github.com/godotengine/godot/issues/109543#issuecomment-3178902510","issue_url":"https://api.github.com/repos/godotengine/godot/issues/109543","id":3178902510,"node_id":"IC_kwDOAO6SJc69ejPu","user":{"login":"AThousandShips","id":96648715,"node_id":"U_kgDOBcK-Cw","avatar_url":"https://avatars.githubusercontent.com/u/96648715?v=4","gravatar_id":"","url":"https://api.github.com/users/AThousandShips","html_url":"https://github.com/AThousandShips","followers_url":"https://api.github.com/users/AThousandShips/followers","following_url":"https://api.github.com/users/AThousandShips/following{/other_user}","gists_url":"https://api.github.com/users/AThousandShips/gists{/gist_id}","starred_url":"https://api.github.com/users/AThousandShips/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/AThousandShips/subscriptions","organizations_url":"https://api.github.com/users/AThousandShips/orgs","repos_url":"https://api.github.com/users/AThousandShips/repos","events_url":"https://api.github.com/users/AThousandShips/events{/privacy}","received_events_url":"https://api.github.com/users/AThousandShips/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-08-12T11:20:59Z","updated_at":"2025-08-12T11:20:59Z","body":"Sounds related to:\n* https://github.com/godotengine/godot/issues/99383","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3178902510/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3182389368","html_url":"https://github.com/godotengine/godot/issues/109543#issuecomment-3182389368","issue_url":"https://api.github.com/repos/godotengine/godot/issues/109543","id":3182389368,"node_id":"IC_kwDOAO6SJc69r2h4","user":{"login":"timothyqiu","id":372476,"node_id":"MDQ6VXNlcjM3MjQ3Ng==","avatar_url":"https://avatars.githubusercontent.com/u/372476?v=4","gravatar_id":"","url":"https://api.github.com/users/timothyqiu","html_url":"https://github.com/timothyqiu","followers_url":"https://api.github.com/users/timothyqiu/followers","following_url":"https://api.github.com/users/timothyqiu/following{/other_user}","gists_url":"https://api.github.com/users/timothyqiu/gists{/gist_id}","starred_url":"https://api.github.com/users/timothyqiu/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/timothyqiu/subscriptions","organizations_url":"https://api.github.com/users/timothyqiu/orgs","repos_url":"https://api.github.com/users/timothyqiu/repos","events_url":"https://api.github.com/users/timothyqiu/events{/privacy}","received_events_url":"https://api.github.com/users/timothyqiu/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-08-13T06:45:49Z","updated_at":"2025-08-13T06:50:57Z","body":"This is expected behavior.\n\n`Tween`s created by `Node.create_tween()` are bound to the calling node (unlike those created by `SceneTree.create_tween()`). That is, the tween will be paused when the node is not inside the tree. Since the node is explicitly removed from the tree (`get_parent().remove_child(self)`), a paused `Tween` object is created by the timer every 0.01 seconds, waiting for the node to be back to the tree.","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3182389368/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3189694773","html_url":"https://github.com/godotengine/godot/issues/109543#issuecomment-3189694773","issue_url":"https://api.github.com/repos/godotengine/godot/issues/109543","id":3189694773,"node_id":"IC_kwDOAO6SJc6-HuE1","user":{"login":"samsface","id":4586101,"node_id":"MDQ6VXNlcjQ1ODYxMDE=","avatar_url":"https://avatars.githubusercontent.com/u/4586101?v=4","gravatar_id":"","url":"https://api.github.com/users/samsface","html_url":"https://github.com/samsface","followers_url":"https://api.github.com/users/samsface/followers","following_url":"https://api.github.com/users/samsface/following{/other_user}","gists_url":"https://api.github.com/users/samsface/gists{/gist_id}","starred_url":"https://api.github.com/users/samsface/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/samsface/subscriptions","organizations_url":"https://api.github.com/users/samsface/orgs","repos_url":"https://api.github.com/users/samsface/repos","events_url":"https://api.github.com/users/samsface/events{/privacy}","received_events_url":"https://api.github.com/users/samsface/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-08-14T19:51:25Z","updated_at":"2025-08-14T19:51:25Z","body":"Ok that makes sense. Would it be possible that this could cause performance issues? I need to double check but 90% sure I’m seeing this. The Visual studio profiler is showing 1000s of calls to Tween::can_process every physics frame and causes the overall physics time to shoot up and up. Might be nice to have some error like when you start a tween without tweeners.","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3189694773/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3197113268","html_url":"https://github.com/godotengine/godot/issues/109543#issuecomment-3197113268","issue_url":"https://api.github.com/repos/godotengin