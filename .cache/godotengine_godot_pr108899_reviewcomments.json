s/comments/2239549354"},"html":{"href":"https://github.com/godotengine/godot/pull/108899#discussion_r2239549354"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/108899"}},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/2239549354/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":null,"original_line":150,"side":"RIGHT","author_association":"CONTRIBUTOR","original_position":12,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/2239570333","pull_request_review_id":3067075637,"id":2239570333,"node_id":"PRRC_kwDOAO6SJc6FfSGd","diff_hunk":"","path":"modules/gdscript/tests/scripts/analyzer/warnings/init_with_required_param.gd","commit_id":"58337b182159cce3938905dc1033709c9aa9b7e4","original_commit_id":"58337b182159cce3938905dc1033709c9aa9b7e4","user":{"login":"dalexeev","id":47700418,"node_id":"MDQ6VXNlcjQ3NzAwNDE4","avatar_url":"https://avatars.githubusercontent.com/u/47700418?v=4","gravatar_id":"","url":"https://api.github.com/users/dalexeev","html_url":"https://github.com/dalexeev","followers_url":"https://api.github.com/users/dalexeev/followers","following_url":"https://api.github.com/users/dalexeev/following{/other_user}","gists_url":"https://api.github.com/users/dalexeev/gists{/gist_id}","starred_url":"https://api.github.com/users/dalexeev/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/dalexeev/subscriptions","organizations_url":"https://api.github.com/users/dalexeev/orgs","repos_url":"https://api.github.com/users/dalexeev/repos","events_url":"https://api.github.com/users/dalexeev/events{/privacy}","received_events_url":"https://api.github.com/users/dalexeev/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"The test is missing negative cases (when the warning should **not** be produced):\r\n\r\n1. `_init()` without parameters (1.1) and with optional parameters (1.2) in classes inheriting `Node` and `Resource`.\r\n2. `_init()` with required parameters in a class that doesn't inherit `Node` or `Resource`.","created_at":"2025-07-29T11:58:28Z","updated_at":"2025-07-29T11:58:42Z","html_url":"https://github.com/godotengine/godot/pull/108899#discussion_r2239570333","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/108899","_links":{"self":{"href":"https://api.github.com/repos/godotengine/godot/pulls/comments/2239570333"},"html":{"href":"https://github.com/godotengine/godot/pull/108899#discussion_r2239570333"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/108899"}},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/2239570333/reactions","total_count":2,"+1":2,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":1,"original_line":1,"side":"RIGHT","author_association":"CONTRIBUTOR","original_position":1,"position":1,"subject_type":"file"},{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/2241211697","pull_request_review_id":3069464199,"id":2241211697,"node_id":"PRRC_kwDOAO6SJc6Fli0x","diff_hunk":"@@ -3627,6 +3630,10 @@ void GDScriptAnalyzer::reduce_call(GDScriptParser::CallNode *p_call, bool p_is_a\n \t\t\t}\n \t\t}\n \n+\t\tif (base_type.class_type && !base_type.class_type->allows_implicit_new && (p_call->function_name == SNAME(\"duplicate\") || p_call->function_name == SNAME(\"duplicate_deep\"))) {\n+\t\t\tparser->push_warning(p_call, GDScriptWarning::INIT_WITH_REQUIRED_PARAM);\n+\t\t}\n+","path":"modules/gdscript/gdscript_analyzer.cpp","commit_id":"27ac237c0637981bcb199c0def8db70584eb2a9a","original_commit_id":"58337b182159cce3938905dc1033709c9aa9b7e4","user":{"login":"IphStich","id":5625804,"node_id":"MDQ6VXNlcjU2MjU4MDQ=","avatar_url":"https://avatars.githubusercontent.com/u/5625804?v=4","gravatar_id":"","url":"https://api.github.com/users/IphStich","html_url":"https://github.com/IphStich","followers_url":"https://api.github.com/users/IphStich/followers","following_url":"https://api.github.com/users/IphStich/following{/other_user}","gists_url":"https://api.github.com/users/IphStich/gists{/gist_id}","starred_url":"https://api.github.com/users/IphStich/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/IphStich/subscriptions","organizations_url":"https://api.github.com/users/IphStich/orgs","repos_url":"https://api.github.com/users/IphStich/repos","events_url":"https://api.github.com/users/IphStich/events{/privacy}","received_events_url":"https://api.github.com/users/IphStich/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"Redundancy is the intention.\r\n\r\nRequired params on `_init()` is valid, so a way to suppress the warning is provided. Calling `duplicate()` on such an object will always result in a failure. This redundancy helps to catch such errors ahead of time, should somebody have supressed the warning.\r\n\r\nThis is important for reducing the possibility of errors in projects built over a long period of time (so a person might forget about all this) or projects worked on by multiple people (where somebody else might not have been aware of this).\r\n\r\nThere is no harm in this redundancy, but there is definite harm without it.","created_at":"2025-07-29T23:20:00Z","updated_at":"2025-07-29T23:20:00Z","html_url":"https://github.com/godotengine/godot/pull/108899#discussion_r2241211697","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/108899","_links":{"self":{"href":"https://api.github.com/repos/godotengine/godot/pulls/comments/2241211697"},"html":{"href":"https://github.com/godotengine/godot/pull/108899#discussion_r2241211697"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/108899"}},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/2241211697/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":3633,"start_side":"RIGHT","line":null,"original_line":3636,"side":"RIGHT","in_reply_to_id":2239517439,"author_association":"CONTRIBUTOR","original_position":17,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/2241230101","pull_request_review_id":3069487139,"id":2241230101,"node_id":"PRRC_kwDOAO6SJc6FlnUV","diff_hunk":"@@ -750,6 +750,7 @@ class GDScriptParser {\n \t\tbool is_abstract = false;\n \t\tbool has_static_data = false;\n \t\tbool annotated_static_unload = false;\n+\t\tbool allows_implicit_new = true;","path":"modules/gdscript/gdscript_parser.h","commit_id":"27ac237c0637981bcb199c0def8db70584eb2a9a","original_commit_id":"58337b182159cce3938905dc1033709c9aa9b7e4","user":{"login":"IphStich","id":5625804,"node_id":"MDQ6VXNlcjU2MjU4MDQ=","avatar_url":"https://avatars.githubusercontent.com/u/5625804?v=4","gravatar_id":"","url":"https://api.github.com/users/IphStich","html_url":"https://github.com/IphStich","followers_url":"https://api.github.com/users/IphStich/followers","following_url":"https://api.github.com/users/IphStich/following{/other_user}","gists_url":"https://api.github.com/users/IphStich/gists{/gist_id}","starred_url":"https://api.github.com/users/IphStich/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/IphStich/subscriptions","organizations_url":"https://api.github.com/users/IphStich/orgs","repos_url":"https://api.github.com/users/IphStich/repos","events_url":"https://api.github.com/users/IphStich/events{/privacy}","received_events_url":"https://api.github.com/users/IphStich/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"I think this could only be considered a redundant field if the `duplicate()` warning was removed, because that would mean that the warning is only shown for the `_init()` function itself?\r\n\r\nThere are 3 problems with this:\r\n* The analyzer doesn't always know what type of class the object extends from when `_init()` is being parsed. This means that detecting whether or not it matters that `_init()` has required parameters cannot be known until later.\r\n* If we want to show warnings and errors anywhere else, it would mean we would have to duplicate the logic to those places, or otherwise apply this logic by using a method which would mean an increased performance cost.\r\n* Whether or not a class allows for implicit new is not dis-similar to whether it is abstract or has static data. It is something that is determined during the parse/analyse process, and so should likewise have a known place in that process where the status is determined.","created_at":"2025-07-29T23:37:42Z","updated_at":"2025-07-29T23:37:42Z","html_url":"https://github.com/godotengine/godot/pull/108899#discussion_r2241230101","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/108899","_links":{"self":{"href":"https://api.github.com/repos/godotengine/godot/pulls/comments/2241230101"},"html":{"href":"https://github.com/godotengine/godot/pull/108899#discussion_r2241230101"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/108899"}},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/2241230101/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":null,"original_line":753,"side":"RIGHT","in_reply_to_id":2239530913,"author_association":"CONTRIBUTOR","original_position":4,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/2241482687","pull_request_review_id":3069825475,"id":2241482687,"node_id":"PRRC_kwDOAO6SJc6Fmk-_","diff_hunk":"@@ -3627,6 +3630,10 @@ void GDScriptAnalyzer::reduce_call(GDScriptParser::CallNode *p_call, bool p_is_a\n \t\t\t}\n \t\t}\n \n+\t\tif (base_type.class_type && !base_type.class_type->allows_implicit_new && (p_call->function_name == SNAME(\"duplicate\") || p_call->function_name == SNAME(\"duplicate_deep\"))) {\n+\t\t\tparser->push_warning(p_call, GDScriptWarning::INIT_WITH_REQUIRED_PARAM);\n+\t\t}\n+","path":"modules/gdscript/gdscript_analyzer.cpp","commit_id":"27ac237c0637981bcb199c0def8db70584eb2a9a","original_commit_id":"58337b182159cce3938905dc1033709c9aa9b7e4","user":{"login":"dalexeev","id":47700418,"node_id":"MDQ6VXNlcjQ3NzAwNDE4","avatar_url":"https://avatars.githubusercontent.com/u/47700418?v=4","gravatar_id":"","url":"https://api.github.com/users/dalexeev","html_url":"https://github.com/dalexeev","followers_url":"https://api.github.com/users/dalexeev/followers","following_url":"https://api.github.com/users/dalexeev/following{/other_user}","gists_url":"https://api.github.com/users/dalexeev/gists{/gist_id}","starred_url":"https://api.github.com/users/dalexeev/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/dalexeev/subscriptions","organizations_url":"https://api.github.com/users/dalexeev/orgs","repos_url":"https://api.github.com/users/dalexeev/repos","events_url":"https://api.github.com/users/dalexeev/events{/privacy}","received_events_url":"https://api.github.com/users/dalexeev/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"I disagree:\r\n\r\n1. The error when calling `duplicate()` is a consequence, not a cause. We don't need to fight both the cause and the consequence. The ability to ignore the warning is normal, the user should predict the consequences of their own choices, which are specified in the warning description.\r\n2. We don't have another example of such cascading warnings. Even if we decided to add a warning in both cases, they should have different names. The analyzer should not spam the same warnings with the same descriptions in different situations (declaring an incompatible constructor and calling the duplicate method on such an object).\r\n3. Unlike the warning on the constructor declaration, the warning on calls can cause false negatives due to dynamic typing when `base` in `base.duplicate()` is a strong supertype of `Node` or `Resource`.\r\n4. I think the runtime error for the consequence should be enough, given that there is a compile-time warning on the cause. We could clarify the runtime error text if the constructor call returned the code `CALL_ERROR_TOO_MANY_ARGUMENTS`.\r\n5. A constructor with required parameters in classes inheriting `Node` or `Resource` is already a highly discouraged case and one might even say undefined behavior. If the user goes against our recommendations, we can disclaim responsibility for subsequent events and not provide a new recommendation in an already discouraged situation.\r\n6. This is an overengineered solution for this problem. Let's start with the minimal solution, and then look at more complex solutions if the minimal one fails.","created_at":"2025-07-30T04:08:56Z","updated_at":"2025-07-30T04:08:57Z","html_url":"https://github.com/godotengine/godot/pull/108899#discussion_r2241482687","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/108899","_links":{"self":{"href":"https://api.github.com/repos/godotengine/godot/pulls/comments/2241482687"},"html":{"href":"https://github.com/godotengine/godot/pull/108899#discussion_r2241482687"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/108899"}},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/2241482687/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":3633,"start_side":"RIGHT","line":null,"original_line":3636,"side":"RIGHT","in_reply_to_id":2239517439,"author_association":"CONTRIBUTOR","original_position":17,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/2241493069","pull_request_review_id":3069838428,"id":2241493069,"node_id":"PRRC_kwDOAO6SJc6FmnhN","diff_hunk":"@@ -3627,6 +3630,10 @@ void GDScriptAnalyzer::reduce_call(GDScriptParser::CallNode *p_call, bool p_is_a\n \t\t\t}\n \t\t}\n \n+\t\tif (base_type.class_type && !base_type.class_type->allows_implicit_new && (p_call->function_name == SNAME(\"duplicate\") || p_call->function_name == SNAME(\"duplicate_deep\"))) {\n+\t\t\tparser->push_warning(p_call, GDScriptWarning::INIT_WITH_REQUIRED_PARAM);\n+\t\t}\n+","path":"modules/gdscript/gdscript_analyzer.cpp","commit_id":"27ac237c0637981bcb199c0def8db70584eb2a9a","original_commit_id":"58337b182159cce3938905dc1033709c9aa9b7e4","user":{"login":"IphStich","id":5625804,"node_id":"MDQ6VXNlcjU2MjU4MDQ=","avatar_url":"https://avatars.githubusercontent.com/u/5625804?v=4","gravatar_id":"","url":"https://api.github.com/users/IphStich","html_url":"https://github.com/IphStich","followers_url":"https://api.github.com/users/IphStich/followers","following_url":"https://api.github.com/users/IphStich/following{/other_user}","gists_url":"https://api.github.com/users/IphStich/gists{/gist_id}","starred_url":"https://api.github.com/users/IphStich/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/IphStich/subscriptions","organizations_url":"https://api.github.com/users/IphStich/orgs","repos_url":"https://api.github.com/users/IphStich/repos","events_url":"https://api.github.com/users/IphStich/events{/privacy}","received_events_url":"https://api.github.com/users/IphStich/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"You make a good case. I think your argument is more compelling.\r\n\r\nI have now removed this from the TODOs list, and it will be removed from the PR next update.","created_at":"2025-07-30T04:20:35Z","updated_at":"2025-07-30T04:20:35Z","html_url":"https://github.com/godotengine/godot/pull/108899#discussion_r2241493069","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/108899","_links":{"self":{"href":"https://api.github.com/repos/godotengine/godot/pulls/comments/2241493069"},"html":{"href":"https://github.com/godotengine/godot/pull/108899#discussion_r2241493069"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/108899"}},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/2241493069/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":3633,"start_side":"RIGHT","line":null,"original_line":3636,"side":"RIGHT","in_reply_to_id":2239517439,"author_association":"CONTRIBUTOR","original_position":17,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/2244011757","pull_request_review_id":3073558340,"id":2244011757,"node_id":"PRRC_kwDOAO6SJc6FwObt","diff_hunk":"@@ -162,6 +162,8 @@ String GDScriptWarning::get_message() const {\n \t\t\treturn vformat(R\"*(The default value uses \"%s\" which won't return nodes in the scene tree before \"_ready()\" is called. Use the \"@onready\" annotation to solve this.)*\", symbols[0]);\n \t\tcase ONREADY_WITH_EXPORT:\n \t\t\treturn R\"(\"@onready\" will set the default value after \"@export\" takes effect and will override it.)\";\n+\t\tcase INIT_WITH_REQUIRED_PARAM:\n+\t\t\treturn R\"*(Using parameters without default values prevents implicit construction. Instances can only be created by calling \"new()\". This causes errors when loading resources and scenes. Will also cause errors with some functions and behaviours, such as with \"duplicate()\".)*\";","path":"modules/gdscript/gdscript_warning.cpp","commit_id":"27ac237c0637981bcb199c0def8db70584eb2a9a","original_commit_id":"58337b182159cce3938905dc1033709c9aa9b7e4","user":{"login":"IphS