[{"id":4874235142,"node_id":"PRR_kwDOAO6SJc8AAAABIobtBg","user":{"login":"Synzorasize","id":60207816,"node_id":"MDQ6VXNlcjYwMjA3ODE2","avatar_url":"https://avatars.githubusercontent.com/u/60207816?v=4","gravatar_id":"","url":"https://api.github.com/users/Synzorasize","html_url":"https://github.com/Synzorasize","followers_url":"https://api.github.com/users/Synzorasize/followers","following_url":"https://api.github.com/users/Synzorasize/following{/other_user}","gists_url":"https://api.github.com/users/Synzorasize/gists{/gist_id}","starred_url":"https://api.github.com/users/Synzorasize/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Synzorasize/subscriptions","organizations_url":"https://api.github.com/users/Synzorasize/orgs","repos_url":"https://api.github.com/users/Synzorasize/repos","events_url":"https://api.github.com/users/Synzorasize/events{/privacy}","received_events_url":"https://api.github.com/users/Synzorasize/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"Works good! I just wonder, it doesn't work with `local_to_scene` on. I guess it's for the case of pasting between scenes (it already gets duplicated with `local_to_scene`). But I think when pasting in the same scene, it should be allowed. I was wondering why it didn't work at first until I saw the code and realized the resource was set to `local_to_scene` on.","state":"COMMENTED","html_url":"https://github.com/godotengine/godot/pull/121873#pullrequestreview-4874235142","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/121873","author_association":"CONTRIBUTOR","_links":{"html":{"href":"https://github.com/godotengine/godot/pull/121873#pullrequestreview-4874235142"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/121873"}},"submitted_at":"2026-08-06T11:45:23Z","commit_id":"d2c28d8ef190d12af10e6da45f3df41042911174"},{"id":4892205091,"node_id":"PRR_kwDOAO6SJc8AAAABI5kgIw","user":{"login":"Synzoras