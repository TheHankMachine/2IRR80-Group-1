i.github.com/users/SteveSmith16384/gists{/gist_id}","starred_url":"https://api.github.com/users/SteveSmith16384/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/SteveSmith16384/subscriptions","organizations_url":"https://api.github.com/users/SteveSmith16384/orgs","repos_url":"https://api.github.com/users/SteveSmith16384/repos","events_url":"https://api.github.com/users/SteveSmith16384/events{/privacy}","received_events_url":"https://api.github.com/users/SteveSmith16384/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-01-22T11:15:20Z","updated_at":"2026-01-22T11:17:58Z","body":"I've updated the description.  It only seems to fail if `dir = DirAccess.open(\"res://\")` is used, i.e. NOT `dir = DirAccess.open(\"c:/\")` - I'm sure it failed before though :(.","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3783850429/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3783858019","html_url":"https://github.com/godotengine/godot/issues/115255#issuecomment-3783858019","issue_url":"https://api.github.com/repos/godotengine/godot/issues/115255","id":3783858019,"node_id":"IC_kwDOAO6SJc7hiRdj","user":{"login":"AThousandShips","id":96648715,"node_id":"U_kgDOBcK-Cw","avatar_url":"https://avatars.githubusercontent.com/u/96648715?v=4","gravatar_id":"","url":"https://api.github.com/users/AThousandShips","html_url":"https://github.com/AThousandShips","followers_url":"https://api.github.com/users/AThousandShips/followers","following_url":"https://api.github.com/users/AThousandShips/following{/other_user}","gists_url":"https://api.github.com/users/AThousandShips/gists{/gist_id}","starred_url":"https://api.github.com/users/AThousandShips/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/AThousandShips/subscriptions","organizations_url":"https://api.github.com/users/AThousandShips/orgs","repos_url":"https://api.github.com/users/AThousandShips/repos","events_url":"https://api.github.com/users/AThousandShips/events{/privacy}","received_events_url":"https://api.github.com/users/AThousandShips/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-01-22T11:17:26Z","updated_at":"2026-01-22T11:19:03Z","body":"That is to be expected I'd say, if you create a `DirAccess` in the resource file scope it won't work with other scopes, that's by design (and the `_absolute` version naturally works as it's static)","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3783858019/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3783873789","html_url":"https://github.com/godotengine/godot/issues/115255#issuecomment-3783873789","issue_url":"https://api.github.com/repos/godotengine/godot/issues/115255","id":3783873789,"node_id":"IC_kwDOAO6SJc7hiVT9","user":{"login":"SteveSmith16384","id":8761942,"node_id":"MDQ6VXNlcjg3NjE5NDI=","avatar_url":"https://avatars.githubusercontent.com/u/8761942?v=4","gravatar_id":"","url":"https://api.github.com/users/SteveSmith16384","html_url":"https://github.com/SteveSmith16384","followers_url":"https://api.github.com/users/SteveSmith16384/followers","following_url":"https://api.github.com/users/SteveSmith16384/following{/other_user}","gists_url":"https://api.github.com/users/SteveSmith16384/gists{/gist_id}","starred_url":"https://api.github.com/users/SteveSmith16384/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/SteveSmith16384/subscriptions","organizations_url":"https://api.github.com/users/SteveSmith16384/orgs","repos_url":"https://api.github.com/users/SteveSmith16384/repos","events_url":"https://api.github.com/users/SteveSmith16384/events{/privacy}","received_events_url":"https://api.github.com/users/SteveSmith16384/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-01-22T11:21:45Z","updated_at":"2026-01-22T11:21:45Z","body":"Maybe, but an absolute path is an absolute path, and ideally should work regardless of whatever scope the DirAccess has been created in.  In addition, it should preferably also fail in the Editor (nothing worse than exporting your project that works perfectly in the editor and then finding everything is suddenly broken).","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3783873789/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3783884761","html_url":"https://github.com/godotengine/godot/issues/115255#issuecomment-3783884761","issue_url":"https://api.github.com/repos/godotengine/godot/issues/115255","id":3783884761,"node_id":"IC_kwDOAO6SJc7hiX_Z","user":{"login":"AThousandShips","id":96648715,"node_id":"U_kgDOBcK-Cw","avatar_url":"https://avatars.githubusercontent.com/u/96648715?v=4","gravatar_id":"","url":"https://api.github.com/users/AThousandShips","html_url":"https://github.com/AThousandShips","followers_url":"https://api.github.com/users/AThousandShips/followers","following_url":"https://api.github.com/users/AThousandShips/following{/other_user}","gists_url":"https://api.github.com/users/AThousandShips/gists{/gist_id}","starred_url":"https://api.github.com/users/AThousandShips/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/AThousandShips/subscriptions","organizations_url":"https://api.github.com/users/AThousandShips/orgs","repos_url":"https://api.github.com/users/AThousandShips/repos","events_url":"https://api.github.com/users/AThousandShips/events{/privacy}","received_events_url":"https://api.github.com/users/AThousandShips/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-01-22T11:24:37Z","updated_at":"2026-01-22T11:39:33Z","body":"I'd say this needs to be documented more clearly, but it's not meant to work\n\nThis is a place where it *does* return the unavailable error because you can't write to the `res://` namespace, so that's expected\n\nIt should be more clearly documented that `DirAccess` is scoped\n\nEdit: For anyone taking this on, the details to document are that accessing `res://` in exported projects is limited to that scope, and cannot write to files at all regardless of the absolute path, and potentially that other restrictions apply, so generally absolute paths in the non-static methods are only in the same scope as the `DirAccess` was created in, a good example to work from would be the description of [`change_dir`](https://docs.godotengine.org/en/latest/classes/class_diraccess.html#class-diraccess-method-change-dir)\n\nAt minimum a note in the main description of `DirAccess` should be added, but a note to each relative method could be good, potentially linking to `change_dir` or some common example to avoid duplication\n\nIt might also be useful to add some additional error clarifications but that might be adding too much overhead","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3783884761/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null}]