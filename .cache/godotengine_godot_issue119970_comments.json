[{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4604251470","html_url":"https://github.com/godotengine/godot/pull/119970#issuecomment-4604251470","issue_url":"https://api.github.com/repos/godotengine/godot/issues/119970","id":4604251470,"node_id":"IC_kwDOAO6SJc8AAAABEm9NTg","user":{"login":"Calinou","id":180032,"node_id":"MDQ6VXNlcjE4MDAzMg==","avatar_url":"https://avatars.githubusercontent.com/u/180032?v=4","gravatar_id":"","url":"https://api.github.com/users/Calinou","html_url":"https://github.com/Calinou","followers_url":"https://api.github.com/users/Calinou/followers","following_url":"https://api.github.com/users/Calinou/following{/other_user}","gists_url":"https://api.github.com/users/Calinou/gists{/gist_id}","starred_url":"https://api.github.com/users/Calinou/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Calinou/subscriptions","organizations_url":"https://api.github.com/users/Calinou/orgs","repos_url":"https://api.github.com/users/Calinou/repos","events_url":"https://api.github.com/users/Calinou/events{/privacy}","received_events_url":"https://api.github.com/users/Calinou/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-06-02T16:00:16Z","updated_at":"2026-06-02T16:00:16Z","body":"> Area lights have a massive VGPR footprint, the amount of registers go from 85~ to 150~ and the shader becomes twice as long.\r\n\r\nWe should probably document this in the area light documentation, in the sense that the *first* visible AreaLight3D in a scene will have a much more significant performance cost than subsequent AreaLight3Ds.","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4604251470/reactions","total_count":4,"+1":4,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4604656313","html_url":"https://github.com/godotengine/godot/pull/119970#issuecomment-4604656313","issue_url":"https://api.github.com/repos/godotengine/godot/issues/119970","id":4604656313,"node_id":"IC_kwDOAO6SJc8AAAABEnV6uQ","user":{"login":"Image-unavailable","id":56268917,"node_id":"MDQ6VXNlcjU2MjY4OTE3","avatar_url":"https://avatars.githubusercontent.com/u/56268917?v=4","gravatar_id":"","url":"https://api.github.com/users/Image-unavailable","html_url":"https://github.com/Image-unavailable","followers_url":"https://api.github.com/users/Image-unavailable/followers","following_url":"https://api.github.com/users/Image-unavailable/following{/other_user}","gists_url":"https://api.github.com/users/Image-unavailable/gists{/gist_id}","starred_url":"https://api.github.com/users/Image-unavailable/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Image-unavailable/subscriptions","organizations_url":"https://api.github.com/users/Image-unavailable/orgs","repos_url":"https://api.github.com/users/Image-unavailable/repos","events_url":"https://api.github.com/users/Image-unavailable/events{/privacy}","received_events_url":"https://api.github.com/users/Image-unavailable/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-06-02T16:46:22Z","updated_at":"2026-06-02T16:46:22Z","body":"- 4.7 beta 4: 75fps\r\n- 4.6.3: 189fps\r\n- this PR: 210fps\r\n- pre-arealights commit: 212fps (somehow)\r\n\r\nSo yes, seems to be working fine on my end, save for a negligible performance loss of ~2fps between the pre-arealight commit and this one. I have no idea why that difference is there, but it doesn't seem like enough of an issue to really be worth looking into.","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4604656313/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4604702733","html_url":"https://github.com/godotengine/godot/pull/119970#issuecomment-4604702733","issue_url":"https://api.github.com/repos/godotengine/godot/issues/119970","id":4604702733,"node_id":"IC_kwDOAO6SJc8AAAABEnYwDQ","user":{"login":"AThousandShips","id":96648715,"node_id":"U_kgDOBcK-Cw","avatar_url":"https://avatars.githubusercontent.com/u/96648715?v=4","gravatar_id":"","url":"https://api.github.com/users/AThousandShips","html_url":"https://github.com/AThousandShips","followers_url":"https://api.github.com/users/AThousandShips/followers","following_url":"https://api.github.com/users/AThousandShips/following{/other_user}","gists_url":"https://api.github.com/users/AThousandShips/gists{/gist_id}","starred_url":"https://api.github.com/users/AThousandShips/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/AThousandShips/subscriptions","organizations_url":"https://api.github.com/users/AThousandShips/orgs","repos_url":"https://api.github.com/users/AThousandShips/repos","events_url":"https://api.github.com/users/AThousandShips/events{/privacy}","received_events_url":"https://api.github.com/users/AThousandShips/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-06-02T16:50:55Z","updated_at":"2026-06-02T16:55:54Z","body":"How did you measure the performance? A 2 fps variation would be tiny and well within natural variability of any testing (it represents a difference of about 45 us)","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4604702733/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4604793375","html_url":"https://github.com/godotengine/godot/pull/119970#issuecomment-4604793375","issue_url":"https://api.github.com/repos/godotengine/godot/issues/119970","id":4604793375,"node_id":"IC_kwDOAO6SJc8AAAABEneSHw","user":{"login":"Image-unavailable","id":56268917,"node_id":"MDQ6VXNlcjU2MjY4OTE3","avatar_url":"https://avatars.githubusercontent.com/u/56268917?v=4","gravatar_id":"","url":"https://api.github.com/users/Image-unavailable","html_url":"https://github.com/Image-unavailable","followers_url":"https://api.github.com/users/Image-unavailable/followers","following_url":"https://api.github.com/users/Image-unavailable/following{/other_user}","gists_url":"https://api.github.com/users/Image-unavailable/gists{/gist_id}","starred_url":"https://api.github.com/users/Image-unavailable/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Image-unavailable/subscriptions","organizations_url":"https://api.github.com/users/Image-unavailable/orgs","repos_url":"https://api.github.com/users/Image-unavailable/repos","events_url":"https://api.github.com/users/Image-unavailable/events{/privacy}","received_events_url":"https://api.github.com/users/Image-unavailable/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-06-02T16:59:27Z","updated_at":"2026-06-02T16:59:27Z","body":"I just run the test scene as specified in the issue. The PR gets 210-211, pre-light commit gets 212 with the occasional blip to 213. I reran them several times and I keep getting the same numbers.\r\n\r\nI'm building by using `scons` with no parameters. Thinking about it, it could be completely unrelated to GPU workload (CPU side?) since it's such a small difference.","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4604793375/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4605248357","html_url":"https://github.com/godotengine/godot/pull/119970#issuecomment-4605248357","issue_url":"https://api.github.com/repos/godotengine/godot/issues/119970","id":4605248357,"node_id":"IC_kwDOAO6SJc8AAAABEn6DZQ","user":{"login":"Image-unavailable","id":56268917,"node_id":"MDQ6VXNlcjU2MjY4OTE3","avatar_url":"https://avatars.githubusercontent.com/u/56268917?v=4","gravatar_id":"","url":"https://api.github.com/users/Image-unavailable","html_url":"https://github.com/Image-unavailable","followers_url":"https://api.github.com/users/Image-unavailable/followers","following_url":"https://api.github.com/users/Image-unavailable/following{/other_user}","gists_url":"https://api.github.com/users/Image-unavailable/gists{/gist_id}","starred_url":"https://api.github.com/users/Image-unavailable/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Image-unavailable/subscriptions","organizations_url":"https://api.github.com/users/Image-unavailable/orgs","repos_url":"https://api.github.com/users/Image-unavailable/repos","events_url":"https://api.github.com/users/Image-unavailable/events{/privacy}","received_events_url":"https://api.github.com/users/Image-unavailable/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-06-02T17:35:29Z","updated_at":"2026-06-02T17:35:29Z","body":"> It seems most modern hardware has a much more acceptable performance tradeoff that is more in line with expectations (10% or so)\r\n\r\nThat's when compared to 4.6.3, but compared to this PR, the loss is a bit larger than that. Reusing numbers from the tests posted here:\r\n- Windows 10, GTX 970M, Vulkan, 1920×1080: 83 -> 54 (-35%)\r\n- Windows 11, RTX 2080, D3D12, 3840×2160: 170 -> 139 (-18%)\r\n- Fedora 44, RTX 5090: 1053 -> 848 (-19%)\r\n- M4, Metal, 5120×2880: 79 -> 73 (-8%)\r\n\r\nEven disregarding the special case of my RX570, it seems like it's more like ~20% fps loss. More tests on more hardware are probably needed in this regard.\r\n\r\nThough of course this drop is also in a fairly barebone scene. In real use-cases, things like higher-res shadows, point shadows, GI, SSAO, SSR, bloom, and so on, would make this less perceivable.\r\n\r\n...That is, with the exception of some cards like the RX570 (and who knows which others) which really dislike area lights.","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4605248357/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4607573444","html_url":"https://github.com/godotengine/godot/pull/119970#issuecomment-4607573444","issue_url":"https://api.github.com/repos/godotengine/godot/issues/119970","id":4607573444,"node_id":"IC_kwDOAO6SJc8AAAABEqH9xA","user":{"login":"Repiteo","id":17489292,"node_id":"MDQ6VXNlcjE3NDg5Mjky","avatar_url":"https://avatars.githubusercontent.com/u/17489292?v=4","gravatar_id":"","url":"https://api.github.com/users/Repiteo","html_url":"https://github.com/Repiteo","followers_url":"https://api.github.com/users/Repiteo/followers","following_url":"https://api.github.com/users/Repiteo/following{/other_user}","gists_url":"https://api.github.com/users/Repiteo/gists{/gist_id}","starred_url":"https://api.github.com/users/Repiteo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Repiteo/subscriptions","organizations_url":"https://api.github.com/users/Repiteo/orgs","repos_url":"https://api.github.com/users/Repiteo/repos","events_url":"https://api.github.com/users/Repiteo/events{/privacy}","received_events_url":"https://api.github.com/users/Repiteo/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-06-02T22:42:33Z","updated_at":"2026-06-02T22:42:33Z","body":"Thanks!","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4607573444/reactions","total_count":2,"+1":0,"-1":0,"laugh":0,"hooray":2,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null}]