thub.com/users/Ivorforce/events{/privacy}","received_events_url":"https://api.github.com/users/Ivorforce/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"I think `mutable CommandQueueMT command_queue{true};` also works.","created_at":"2025-11-07T11:50:18Z","updated_at":"2025-11-07T11:50:18Z","html_url":"https://github.com/godotengine/godot/pull/112506#discussion_r2503058000","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/112506","_links":{"self":{"href":"https://api.github.com/repos/godotengine/godot/pulls/comments/2503058000"},"html":{"href":"https://github.com/godotengine/godot/pull/112506#discussion_r2503058000"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/112506"}},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/2503058000/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":null,"original_line":77,"side":"RIGHT","in_reply_to_id":2503049020,"author_association":"MEMBER","original_position":5,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/2504733769","pull_request_review_id":3435386299,"id":2504733769,"node_id":"PRRC_kwDOAO6SJc6VSzRJ","diff_hunk":"@@ -154,29 +155,38 @@ class CommandQueueMT {\n \t}\n \n \tvoid _flush() {\n+\t\tMutexLock lock(mutex);\n+\n \t\tif (unlikely(flush_read_ptr)) {\n \t\t\t// Re-entrant call.\n \t\t\treturn;\n \t\t}\n \n-\t\tMutexLock lock(mutex);\n-\n \t\twhile (flush_read_ptr < command_mem.size()) {\n \t\t\tuint64_t size = *(uint64_t *)&command_mem[flush_read_ptr];\n \t\t\tflush_read_ptr += 8;\n \t\t\tCommandBase *cmd = reinterpret_cast<CommandBase *>(&command_mem[flush_read_ptr]);\n-\t\t\tuint32_t allowance_id = WorkerThreadPool::thread_enter_unlock_allowance_zone(lock);\n-\t\t\tcmd->call();\n-\t\t\tWorkerThreadPool::thread_exit_unlock_allowance_zone(allowance_id);\n+\n+\t\t\tif (unique_flusher) {\n+\t\t\t\t// A single thread will pump; the lock is only needed for the command queue itself.\n+\t\t\t\tlock.temp_unlock();\n+\t\t\t\tcmd->call();","path":"core/templates/command_queue_mt.h","commit_id":"bf84697e9d9edb28e581bccf29e2cbbac5a7b438","original_commit_id":"bf84697e9d9edb28e581bccf29e2cbbac5a7b438","user":{"login":"brycehutchings","id":5100250,"node_id":"MDQ6VXNlcjUxMDAyNTA=","avatar_url":"https://avatars.githubusercontent.com/u/5100250?v=4","gravatar_id":"","url":"https://api.github.com/users/brycehutchings","html_url":"https://github.com/brycehutchings","followers_url":"https://api.github.com/users/brycehutchings/followers","following_url":"https://api.github.com/users/brycehutchings/following{/other_user}","gists_url":"https://api.github.com/users/brycehutchings/gists{/gist_id}","starred_url":"https://api.github.com/users/brycehutchings/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/brycehutchings/subscriptions","organizations_url":"https://api.github.com/users/brycehutchings/orgs","repos_url":"https://api.github.com/users/brycehutchings/repos","events_url":"https://api.github.com/users/brycehutchings/events{/privacy}","received_events_url":"https://api.github.com/users/brycehutchings/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"here `cmd` is pointing to memory in the `command_mem` LocalVector. Is there a risk that while unlocked, the vector could resize and invalidate this memory address? If so, I think a different collection type would be needed that has pointer stability around resizes (like a std::deque). Although those types might have less CPU caching benefits.","created_at":"2025-11-07T17:33:51Z","updated_at":"2025-11-07T17:33:52Z","html_url":"https://github.com/godotengine/godot/pull/112506#discussion_r2504733769","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/112506","_links":{"self":{"href":"https://api.github.com/repos/godotengine/godot/pulls/comments/2504733769"},"html":{"href":"https://github.com/godotengine/godot/pull/112506#discussion_r2504733769"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/112506"}},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/2504733769/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":null,"original_line":173,"side":"RIGHT","author_association":"CONTRIBUTOR","original_position":32,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/2505905602","pull_request_review_id":3436943954,"id":2505905602,"node_id":"PRRC_kwDOAO6SJc6VXRXC","diff_hunk":"@@ -154,29 +155,38 @@ class CommandQueueMT {\n \t}\n \n \tvoid _flush() {\n+\t\tMutexLock lock(mutex);\n+\n \t\tif (unlikely(flush_read_ptr)) {\n \t\t\t// Re-entrant call.\n \t\t\treturn;\n \t\t}\n \n-\t\tMutexLock lock(mutex);\n-\n \t\twhile (flush_read_ptr < command_mem.size()) {\n \t\t\tuint64_t size = *(uint64_t *)&command_mem[flush_read_ptr];\n \t\t\tflush_read_ptr += 8;\n \t\t\tCommandBase *cmd = reinterpret_cast<CommandBase *>(&command_mem[flush_read_ptr]);\n-\t\t\tuint32_t allowance_id = WorkerThreadPool::thread_enter_unlock_allowance_zone(lock);\n-\t\t\tcmd->call();\n-\t\t\tWorkerThreadPool::thread_exit_unlock_allowance_zone(allowance_id);\n+\n+\t\t\tif (unique_flusher) {\n+\t\t\t\t// A single thread will pump; the lock is only needed for the command queue itself.\n+\t\t\t\tlock.temp_unlock();\n+\t\t\t\tcmd->call();","path":"core/templates/command_queue_mt.h","commit_id":"bf84697e9d9edb28e581bccf29e2cbbac5a7b438","original_commit_id":"bf84697e9d9edb28e581bccf29e2cbbac5a7b438","user":{"login":"RandomShaper","id":11797174,"node_id":"MDQ6VXNlcjExNzk3MTc0","avatar_url":"https://avatars.githubusercontent.com/u/11797174?v=4","gravatar_id":"","url":"https://api.github.com/users/RandomShaper","html_url":"https://github.com/RandomShaper","followers_url":"https://api.github.com/users/RandomShaper/followers","following_url":"https://api.github.com/users/RandomShaper/following{/other_user}","gists_url":"https://api.github.com/users/RandomShaper/gists{/gist_id}","starred_url":"https://api.github.com/users/RandomShaper/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/RandomShaper/subscriptions","organizations_url":"https://api.github.com/users/RandomShaper/orgs","repos_url":"https://api.github.com/users/RandomShaper/repos","events_url":"https://api.github.com/users/RandomShaper/events{/privacy}","received_events_url":"https://api.github.com/users/RandomShaper/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"You're right about the potential pointer invalidation. However, we're trusting the call-and-back itself is immune to that, so the line below about handling realloc should be enough. It'd be good to prove the former point more formally, though.","created_at":"2025-11-08T00:23:56Z","updated_at":"2025-11-08T00:23:56Z","html_url":"https://github.com/godotengine/godot/pull/112506#discussion_r2505905602","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/112506","_links":{"self":{"href":"https://api.github.com/repos/godotengine/godot/pulls/comments/2505905602"},"html":{"href":"https://github.com/godotengine/godot/pull/112506#discussion_r2505905602"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/112506"}},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/2505905602/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":null,"original_line":173,"side":"RIGHT","in_reply_to_id":2504733769,"author_association":"MEMBER","original_position":32,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/2512814268","pull_request_review_id":3446219585,"id":2512814268,"node_id":"PRRC_kwDOAO6SJc6VxoC8","diff_hunk":"@@ -154,29 +155,38 @@ class CommandQueueMT {\n \t}\n \n \tvoid _flush() {\n+\t\tMutexLock lock(mutex);\n+\n \t\tif (unlikely(flush_read_ptr)) {\n \t\t\t// Re-entrant call.\n \t\t\treturn;\n \t\t}\n \n-\t\tMutexLock lock(mutex);\n-\n \t\twhile (flush_read_ptr < command_mem.size()) {\n \t\t\tuint64_t size = *(uint64_t *)&command_mem[flush_read_ptr];\n \t\t\tflush_read_ptr += 8;\n \t\t\tCommandBase *cmd = reinterpret_cast<CommandBase *>(&command_mem[flush_read_ptr]);\n-\t\t\tuint32_t allowance_id = WorkerThreadPool::thread_enter_unlock_allowance_zone(lock);\n-\t\t\tcmd->call();\n-\t\t\tWorkerThreadPool::thread_exit_unlock_allowance_zone(allowance_id);\n+\n+\t\t\tif (unique_flusher) {\n+\t\t\t\t// A single thread will pump; the lock is only needed for the command queue itself.\n+\t\t\t\tlock.temp_unlock();\n+\t\t\t\tcmd->call();","path":"core/templates/command_queue_mt.h","commit_id":"bf84697e9d9edb28e581bccf29e2cbbac5a7b438","original_commit_id":"bf84697e9d9edb28e581bccf29e2cbbac5a7b438","user":{"login":"brycehutchings","id":5100250,"node_id":"MDQ6VXNlcjUxMDAyNTA=","avatar_url":"https://avatars.githubusercontent.com/u/5100250?v=4","gravatar_id":"","url":"https://api.github.com/users/brycehutchings","html_url":"https://github.com/brycehutchings","followers_url":"https://api.github.com/users/brycehutchings/followers","following_url":"https://api.github.com/users/brycehutchings/following{/other_user}","gists_url":"https://api.github.com/users/brycehutchings/gists{/gist_id}","starred_url":"https://api.github.com/users/brycehutchings/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/brycehutchings/subscriptions","organizations_url":"https://api.github.com/users/brycehutchings/orgs","repos_url":"https://api.github.com/users/brycehutchings/repos","events_url":"https://api.github.com/users/brycehutchings/events{/privacy}","received_events_url":"https://api.github.com/users/brycehutchings/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"Here's the sequence that I am concerned about:\r\n1. Thread A pushes a command\r\n2. Thread B starts flushing. It completes `lock.temp_unlock();`\r\n3. Thread A or C pushes another command but the LocalVector can't hold it so it resizes. In the process the `realloc` call has to create a new block of memory and copy the old contents into it. The old memory block is now freed\r\n4. Thread B continues running. It now does `cmd->call()` but `cmd` is pointing to memory in the old block that was freed (and potentially reused for something else)\r\n\r\nI think we'd have to make a copy of the contents of the struct to a local variable before unlocking to avoid risk of the pointer pointing to a stale memory address. Maybe this extra copy is worth it, compared to the alternative solutions?","created_at":"2025-11-11T04:40:09Z","updated_at":"2025-11-11T04:40:31Z","html_url":"https://github.com/godotengine/godot/pull/112506#discussion_r2512814268","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/112506","_links":{"self":{"href":"https://api.github.com/repos/godotengine/godot/pulls/comments/2512814268"},"html":{"href":"https://github.com/godotengine/godot/pull/112506#discussion_r2512814268"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/112506"}},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/2512814268/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":null,"original_line":173,"side":"RIGHT","in_reply_to_id":2504733769,"author_association":"CONTRIBUTOR","original_position":32,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/2513999144","pull_request_review_id":3447764543,"id":2513999144,"node_id":"PRRC_kwDOAO6SJc6V2JUo","diff_hunk":"@@ -154,29 +155,38 @@ class CommandQueueMT {\n \t}\n \n \tvoid _flush() {\n+\t\tMutexLock lock(mutex);\n+\n \t\tif (unlikely(flush_read_ptr)) {\n \t\t\t// Re-entrant call.\n \t\t\treturn;\n \t\t}\n \n-\t\tMutexLock lock(mutex);\n-\n \t\twhile (flush_read_ptr < command_mem.size()) {\n \t\t\tuint64_t size = *(uint64_t *)&command_mem[flush_read_ptr];\n \t\t\tflush_read_ptr += 8;\n \t\t\tCommandBase *cmd = reinterpret_cast<CommandBase *>(&command_mem[flush_read_ptr]);\n-\t\t\tuint32_t allowance_id = WorkerThreadPool::thread_enter_unlock_allowance_zone(lock);\n-\t\t\tcmd->call();\n-\t\t\tWorkerThreadPool::thread_exit_unlock_allowance_zone(allowance_id);\n+\n+\t\t\tif (unique_flusher) {\n+\t\t\t\t// A single thread will pump; the lock is only needed for the command queue itself.\n+\t\t\t\tlock.temp_unlock();\n+\t\t\t\tcmd->call();","path":"core/templates/command_queue_mt.h","commit_id":"bf84697e9d9edb28e581bccf29e2cbbac5a7b438","original_commit_id":"bf84697e9d9edb28e581bccf29e2cbbac5a7b438","user":{"login":"RandomShaper","id":11797174,"node_id":"MDQ6VXNlcjExNzk3MTc0","avatar_url":"https://avatars.githubusercontent.com/u/11797174?v=4","gravatar_id":"","url":"https://api.github.com/users/RandomShaper","html_url":"https://github.com/RandomShaper","followers_url":"https://api.github.com/users/RandomShaper/followers","following_url":"https://api.github.com/users/RandomShaper/following{/other_user}","gists_url":"https://api.github.com/users/RandomShaper/gists{/gist_id}","starred_url":"https://api.github.com/users/RandomShaper/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/RandomShaper/subscriptions","organizations_url":"https://api.github.com/users/RandomShaper/orgs","repos_url":"https://api.github.com/users/RandomShaper/repos","events_url":"https://api.github.com/users/RandomShaper/events{/privacy}","recei