id = WorkerThreadPool::thread_enter_unlock_allowance_zone(lock);\n-\t\t\tcmd->call();\n-\t\t\tWorkerThreadPool::thread_exit_unlock_allowance_zone(allowance_id);\n+\n+\t\t\t// Protect against against race condition between this thread\n+\t\t\t// during the call to the command and other threads potentially\n+\t\t\t// invalidating the pointer due to reallocs.\n+\t\t\tmemcpy(cmd_backup, (char *)cmd, size);\n+\n+\t\t\tif (unique_flusher) {\n+\t\t\t\t// A single thread will pump; the lock is only needed for the command queue itself.","path":"core/templates/command_queue_mt.h","commit_id":"4ba4558cf6e0550190ee2cb7fbc3c6af3fa2e677","original_commit_id":"bd615b42d4d986526cc8d5cd462ed6ffb60b4473","user":{"login":"brycehutchings","id":5100250,"node_id":"MDQ6VXNlcjUxMDAyNTA=","avatar_url":"https://avatars.githubusercontent.com/u/5100250?v=4","gravatar_id":"","url":"https://api.github.com/users/brycehutchings","html_url":"https://github.com/brycehutchings","followers_url":"https://api.github.com/users/brycehutchings/followers","following_url":"https://api.github.com/users/brycehutchings/following{/other_user}","gists_url":"https://api.github.com/users/brycehutchings/gists{/gist_id}","starred_url":"https://api.github.com/users/brycehutchings/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/brycehutchings/subscriptions","organizations_url":"https://api.github.com/users/brycehutchings/orgs","repos_url":"https://api.github.com/users/brycehutchings/repos","events_url":"https://api.github.com/users/brycehutchings/events{/privacy}","received_events_url":"https://api.github.com/users/brycehutchings/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"The `if (unlikely(flush_read_ptr)) {` at the top of the function already exists so that only one pump/flush happens at a time. So why can't this be simplified to always do the unique_flusher code path (temp_unlock/temp_lock) and not even have the `else` case with the WTP allowance zon