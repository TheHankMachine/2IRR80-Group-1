[{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4978431104","html_url":"https://github.com/godotengine/godot/pull/121392#issuecomment-4978431104","issue_url":"https://api.github.com/repos/godotengine/godot/issues/121392","id":4978431104,"node_id":"IC_kwDOAO6SJc8AAAABKLzUgA","user":{"login":"AThousandShips","id":96648715,"node_id":"U_kgDOBcK-Cw","avatar_url":"https://avatars.githubusercontent.com/u/96648715?v=4","gravatar_id":"","url":"https://api.github.com/users/AThousandShips","html_url":"https://github.com/AThousandShips","followers_url":"https://api.github.com/users/AThousandShips/followers","following_url":"https://api.github.com/users/AThousandShips/following{/other_user}","gists_url":"https://api.github.com/users/AThousandShips/gists{/gist_id}","starred_url":"https://api.github.com/users/AThousandShips/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/AThousandShips/subscriptions","organizations_url":"https://api.github.com/users/AThousandShips/orgs","repos_url":"https://api.github.com/users/AThousandShips/repos","events_url":"https://api.github.com/users/AThousandShips/events{/privacy}","received_events_url":"https://api.github.com/users/AThousandShips/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-07-15T08:22:11Z","updated_at":"2026-07-16T07:33:11Z","body":"> AI was only used to help me write a summarised PR description from my own hand-written notes. I wrote all the code.\r\n\r\nPlease do not use AI to write human to human communication ","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4978431104/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":{"reason":"resolved"}},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4984834371","html_url":"https://github.com/godotengine/godot/pull/121392#issuecomment-4984834371","issue_url":"https://api.github.com/repos/godotengine/godot/issues/121392","id":4984834371,"node_id":"IC_kwDOAO6SJc8AAAABKR6JQw","user":{"login":"stuartcarnie","id":52852,"node_id":"MDQ6VXNlcjUyODUy","avatar_url":"https://avatars.githubusercontent.com/u/52852?v=4","gravatar_id":"","url":"https://api.github.com/users/stuartcarnie","html_url":"https://github.com/stuartcarnie","followers_url":"https://api.github.com/users/stuartcarnie/followers","following_url":"https://api.github.com/users/stuartcarnie/following{/other_user}","gists_url":"https://api.github.com/users/stuartcarnie/gists{/gist_id}","starred_url":"https://api.github.com/users/stuartcarnie/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/stuartcarnie/subscriptions","organizations_url":"https://api.github.com/users/stuartcarnie/orgs","repos_url":"https://api.github.com/users/stuartcarnie/repos","events_url":"https://api.github.com/users/stuartcarnie/events{/privacy}","received_events_url":"https://api.github.com/users/stuartcarnie/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-07-15T20:09:34Z","updated_at":"2026-07-16T07:33:17Z","body":"> > AI was only used to help me write a summarised PR description from my own hand-written notes. I wrote all the code.\r\n> \r\n> Please do not use AI to write human to human communication\r\n\r\n@AThousandShips if it wasn't clear, I still wrote and edited the final PR description, but I used AI to help distill my notes from various design documents. AI did not write it.","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4984834371/reactions","total_count":2,"+1":2,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":{"reason":"resolved"}},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5136798117","html_url":"https://github.com/godotengine/godot/pull/121392#issuecomment-5136798117","issue_url":"https://api.github.com/repos/godotengine/godot/issues/121392","id":5136798117,"node_id":"IC_kwDOAO6SJc8AAAABMi1RpQ","user":{"login":"stuartcarnie","id":52852,"node_id":"MDQ6VXNlcjUyODUy","avatar_url":"https://avatars.githubusercontent.com/u/52852?v=4","gravatar_id":"","url":"https://api.github.com/users/stuartcarnie","html_url":"https://github.com/stuartcarnie","followers_url":"https://api.github.com/users/stuartcarnie/followers","following_url":"https://api.github.com/users/stuartcarnie/following{/other_user}","gists_url":"https://api.github.com/users/stuartcarnie/gists{/gist_id}","starred_url":"https://api.github.com/users/stuartcarnie/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/stuartcarnie/subscriptions","organizations_url":"https://api.github.com/users/stuartcarnie/orgs","repos_url":"https://api.github.com/users/stuartcarnie/repos","events_url":"https://api.github.com/users/stuartcarnie/events{/privacy}","received_events_url":"https://api.github.com/users/stuartcarnie/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-07-30T22:12:02Z","updated_at":"2026-07-30T22:12:02Z","body":"Thanks @blueskythlikesclouds – will make the requested changes","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5136798117/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5292707291","html_url":"https://github.com/godotengine/godot/pull/121392#issuecomment-5292707291","issue_url":"https://api.github.com/repos/godotengine/godot/issues/121392","id":5292707291,"node_id":"IC_kwDOAO6SJc8AAAABO3hN2w","user":{"login":"blueskythlikesclouds","id":19259897,"node_id":"MDQ6VXNlcjE5MjU5ODk3","avatar_url":"https://avatars.githubusercontent.com/u/19259897?v=4","gravatar_id":"","url":"https://api.github.com/users/blueskythlikesclouds","html_url":"https://github.com/blueskythlikesclouds","followers_url":"https://api.github.com/users/blueskythlikesclouds/followers","following_url":"https://api.github.com/users/blueskythlikesclouds/following{/other_user}","gists_url":"https://api.github.com/users/blueskythlikesclouds/gists{/gist_id}","starred_url":"https://api.github.com/users/blueskythlikesclouds/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/blueskythlikesclouds/subscriptions","organizations_url":"https://api.github.com/users/blueskythlikesclouds/orgs","repos_url":"https://api.github.com/users/blueskythlikesclouds/repos","events_url":"https://api.github.com/users/blueskythlikesclouds/events{/privacy}","received_events_url":"https://api.github.com/users/blueskythlikesclouds/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-08-14T11:19:39Z","updated_at":"2026-08-14T11:19:52Z","body":"Are you gonna be doing any more changes? If not, I'll start re-reviewing the PR.","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5292707291/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5309374429","html_url":"https://github.com/godotengine/godot/pull/121392#issuecomment-5309374429","issue_url":"https://api.github.com/repos/godotengine/godot/issues/121392","id":5309374429,"node_id":"IC_kwDOAO6SJc8AAAABPHaf3Q","user":{"login":"stuartcarnie","id":52852,"node_id":"MDQ6VXNlcjUyODUy","avatar_url":"https://avatars.githubusercontent.com/u/52852?v=4","gravatar_id":"","url":"https://api.github.com/users/stuartcarnie","html_url":"https://github.com/stuartcarnie","followers_url":"https://api.github.com/users/stuartcarnie/followers","following_url":"https://api.github.com/users/stuartcarnie/following{/other_user}","gists_url":"https://api.github.com/users/stuartcarnie/gists{/gist_id}","starred_url":"https://api.github.com/users/stuartcarnie/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/stuartcarnie/subscriptions","organizations_url":"https://api.github.com/users/stuartcarnie/orgs","repos_url":"https://api.github.com/users/stuartcarnie/repos","events_url":"https://api.github.com/users/stuartcarnie/events{/privacy}","received_events_url":"https://api.github.com/users/stuartcarnie/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-08-16T19:55:47Z","updated_at":"2026-08-16T19:55:47Z","body":"> Are you gonna be doing any more changes? If not, I'll start re-reviewing the PR.\r\n\r\n@blueskythlikesclouds no, that's it, as I ended up rebasing it on the following, as I needed the `TextureInfo` wrapper for that PR to track if it was a Rasterization Rate Map:\r\n\r\n- #122248","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5309374429/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5309456934","html_url":"https://github.com/godotengine/godot/pull/121392#issuecomment-5309456934","issue_url":"https://api.github.com/repos/godotengine/godot/issues/121392","id":5309456934,"node_id":"IC_kwDOAO6SJc8AAAABPHfiJg","user":{"login":"stuartcarnie","id":52852,"node_id":"MDQ6VXNlcjUyODUy","avatar_url":"https://avatars.githubusercontent.com/u/52852?v=4","gravatar_id":"","url":"https://api.github.com/users/stuartcarnie","html_url":"https://github.com/stuartcarnie","followers_url":"https://api.github.com/users/stuartcarnie/followers","following_url":"https://api.github.com/users/stuartcarnie/following{/other_user}","gists_url":"https://api.github.com/users/stuartcarnie/gists{/gist_id}","starred_url":"https://api.github.com/users/stuartcarnie/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/stuartcarnie/subscriptions","organizations_url":"https://api.github.com/users/stuartcarnie/orgs","repos_url":"https://api.github.com/users/stuartcarnie/repos","events_url":"https://api.github.com/users/stuartcarnie/events{/privacy}","received_events_url":"https://api.github.com/users/stuartcarnie/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-08-16T20:14:09Z","updated_at":"2026-08-16T20:15:35Z","body":"## Performance\r\n\r\nUsing the MRP in [this comment](https://github.com/godotengine/godot/issues/119436#issuecomment-5309393640), which renders 1,000s of animated, skinned meshes.\r\n\r\n> [!NOTE]\r\n>\r\n> I included my in-progress Metal 4 driver for comparison, which is showing a lot of promise!\r\n>\r\n> The **vs hazard+concurrent** is comparing to the current Metal 3 renderer using Apple's hazard tracking and concurrent dispatch compute encoders. \r\n\r\n**MacBook Pro M4 Max**\r\n\r\n| Config | fps | vs Base |\r\n| :--- | :--- | :--- |\r\n| Metal 4 | 42.63 | +21.7% |\r\n| Metal 3 + barriers | 36.79 | +5.1% |\r\n| Vulkan / MoltenVK | 35.09 | +0.2% |\r\n| Base (Metal 3 + hazard tracking) | 35.02 | — |\r\n\r\n**MacBook Pro M1 Max**\r\n\r\n| Config | fps | vs Base |\r\n| :--- | :--- | :--- |\r\n| Metal 4 | 27.49 | +15.3% |\r\n| Metal 3 + barriers | 24.80 | +4.0% |\r\n| hazard + serial | 24.33 | +2.0% |\r\n| Vulkan / MoltenVK | 23.87 | +0.1% |\r\n| Base (Metal 3 + hazard tracking) | 23.85 | — |","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5309456934/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5311106378","html_url":"https://github.com/godotengine/godot/pull/121392#issuecomment-5311106378","issue_url":"https://api.github.com/repos/godotengine/godot/issues/121392","id":5311106378,"node_id":"IC_kwDOAO6SJc8AAAABPJENSg","user":{"login":"stuartcarnie","id":52852,"node_id":"MDQ6VXNlcjUyODUy","avatar_url":"https://avatars.githubusercontent.com/u/52852?v=4","gravatar_id":"","url":"https://api.github.com/users/stuartcarnie","html_url":"https://github.com/stuartcarnie","followers_url":"https://api.github.com/users/stuartcarnie/followers","following_url":"https://api.github.com/users/stuartcarnie/following{/other_user}","gists_url":"https://api.github.com/users/stuartcarnie/gists{/gist_id}","starred_url":"https://api.github.com/users/stuartcarnie/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/stuartcarnie/subscriptions","organizations_url":"https://api.github.com/users/stuartcarnie/orgs","repos_url":"https://api.github.com/users/stuartcarnie/repos","events_url":"https://api.github.com/users/stuartcarnie/events{/privacy}","received_events_url":"https://api.github.com/users/stuartcarnie/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-08-17T02:31:28Z","updated_at":"2026-08-17T03:12:51Z","body":"# Performance: iPhone 12 Pro + iOS 18.7.8\r\n\r\n> [!IMPORTANT]\r\n>\r\n> Further analysis determined this is with API validation enabled, so it appears hazard tracking takes a much more significant hit.\r\n\r\n208 animated meshes, each producing one GPU skinning dispatch per frame it moves — 208 dispatches per frame, batched into a single compute encoder.\r\n\r\n- 8 continuous — 1,176 vertices, 31- and 62-bone chains, pose changes every frame, so they skin every frame.\r\n- 200 staggered — 72 vertices, 3-bone chains plus 2 blend shapes, pose changes every 1–6 frames (re-rolled each second, some hidden), so they skin only on the frames they move.\r\n\r\nRendering was Forward Mobile, MSAA off, plus a ground plane, one directional light and three shadow-casting omni lights.\r\n\r\nBoth groups draw as the same green tapered tube — the names describe how often each skins and how heavy each is, since that's what the bug responds to, not what they look like on screen.\r\n\r\n| Config | fps |\r\n| :--- | :--- |\r\n| Metal 3, hazard tracking | ~34 (31–39) |\r\n| Metal 3, barriers + placement heaps (this branch) | 60.0 |","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5311106378/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5312378001","html_url":"https://github.com/godotengine/godot/pull/121392#issuecomment-5312378001","issue_url":"https://api.github.com/repos/godotengine/godot/issues/121392","id":5312378001,"node_id":"IC_kwDOAO6SJc8AAAABPKR0kQ","user":{"login":"stuartcarnie","id":52852,"node_id":"MDQ6VXNlcjUyODUy","avatar_url":"https://avatars.githubusercontent.com/u/52852?v=4","gravatar_id":"","url":"https://api.github.com/users/stuartcarnie","html_url":"https://github.com/stuartcarnie","followers_url":"https://api.github.com/users/stuartcarnie/followers","following_url":"https://api.github.com/users/stuartcarnie/following{/other_user}","gists_url":"https://api.github.com/users/stuartcarnie/gists{/gist_id}","starred_url":"https://api.github.com/users/stuartcarnie/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/stuartcarnie/subscriptions","organizations_url":"https://api.github.com/users/stuartcarnie/orgs","repos_url":"https://api.github.com/users/stuartcarnie/repos","events_url":"https://api.github.com/users/stuartcarnie/events{/privacy}","received_events_url":"https://api.github.com/users/stuartcarnie/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-08-17T05:55:14Z","updated_at":"2026-08-17T05:55:14Z","body":"# Barriers versus hazard tracking\r\n\r\niPhone 12 Pro, 410 animated meshes, Forward Mobile. Each configuration ran twice in alternating order, 30 s per run; CPU and GPU recorded separately.\r\n\r\n| Measure | Hazard tracking | Barriers | Change |\r\n| :--- | ---: | ---: | ---: |\r\n| Compute (skinning) per frame | 2.06 ms | 0.22 ms | −89% |\r\n| Render (vertex + fragment) per frame | 13.2 ms | 13.6 ms | ~unchanged |\r\n| Frames per second | ~53 | ~59 | +11% |\r\n| CPU | 106% | 91% | −14% |\r\n\r\n\r\nRender dominates the frame at ~13 ms, which caps the win at ~11%; a compute-heavier scene would see proportionally more. CPU drops 14%, which is most likely hazard tracking overhead.\r\n","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5312378001/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5313218569","html_url":"https://github.com/godotengine/godot/pull/121392#issuecomment-5313218569","issue_url":"https://api.github.com/repos/godotengine/godot/issues/121392","id":5313218569,"node_id":"IC_kwDOAO6SJc8AAAABPLFICQ","user":{"login":"stuartcarnie","id":52852,"node_id":"MDQ6VXNlcjUyODUy","avatar_url":"https://avatars.githubusercontent.com/u/52852?v=4","gravatar_id":"","url":"https://api.github.com/users/stuartcarnie","html_url":"https://github.com/stuartcarnie","followers_url":"https://api.github.com/users/stuartcarnie/followers","following_url":"https://api.github.com/users/stuartcarnie/following{/other_user}","gists_url":"https://api.github.com/users/stuartcarnie/gists{/gist_id}","starred_url":"https://api.github.com/users/stuartcarnie/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/stuartcarnie/subscriptions","organizations_url":"https://api.github.com/users/stuartcarnie/orgs","repos_url":"https://api.github.com/users/stuartcarnie/repos","events_url":"https://api.github.com/users/stuartcarnie/events{/privacy}","received_events_url":"https://api.github.com/users/stuartcarnie/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-08-17T07:40:44Z","updated_at":"2026-08-17T07:40:55Z","body":"I decided to dig into the CPU costs and improvements by this PR:\r\n\r\nBarriers use about 13% less CPU than hazard tracking. Profiling shows the saving comes from two places, and neither has anything to do with drawing.\r\n\r\n### Bookkeeping\r\n\r\nUnder hazard tracking, Metal only knows about resources the encoder references directly. Anything reached indirectly via argument buffers must be declared to each encoder before it runs. Godot tracks that itself, in a per-encoder table keyed by resource pointer. Building and resetting that table costs about half a second per thirty seconds of running. With barriers and heaps, the table is never populated, and that cost disappears entirely.\r\n\r\n### Driver API usage\r\n\r\nDeclaring resources one at a time means multiple calls to inform Metal. Those calls dominate the difference: time spent calling Metal falls by roughly 1.3 seconds per thirty seconds. Heaps replace thousands of individual declarations with a few, so the traffic largely stops.\r\n\r\nTogether these account for the whole saving. Time spent on drawing is unchanged, as expected.\r\n\r\n<details>\r\n<summary>Profile data (iPhone 12 Pro, iOS 18.7.8, 410 skinned meshes, Forward Mobile, 30 s per configuration)</summary>\r\n\r\nRecorded with Instruments' Time Profiler via `xctrace`, launched with `devicectl` so no debugger or Metal API validation is attached.\r\n\r\n**Total CPU sampled:** 27,695 ms → 24,195 ms (−12.6%)\r\n\r\n**By thread**\r\n\r\n| Thread | Hazard | Barriers |\r\n| :--- | ---: | ---: |\r\n| Main | 25,047 ms | 22,795 ms |\r\n| Render | 2,243 ms | 977 ms |\r\n\r\n**Largest self-time reductions**\r\n\r\n| Symbol | Hazard | Barriers | Δ |\r\n| :--- | ---: | ---: | ---: |\r\n| `mach_msg2_trap` | 1614 ms | 576 ms | −1038 |\r\n| `iokit_user_client_trap` | 282 ms | 9 ms | −273 |\r\n| `HashMap<MTL::Resource*, ResourceUsageEntry>` | 171 ms | 0 ms | −171 |\r\n| `MDCommandBuffer::_render_set_dirty_state()` | 312 ms | 161 ms | −151 |\r\n| `HashMap<StageResourceUsage, LocalVector<MTL::Resource*>>` | 144 ms | 0 ms | −144 |\r\n| `ResourceTracker::reset()` | 122 ms | 1 ms | −121 |\r\n| `_ioGPUResourceListAddResourceEntry` | 81 ms | 8 ms | −73 |\r\n| `RenderingDeviceGraph::_run_draw_list_command()` | 281 ms | 218 ms | −63 |\r\n| `MDCommandBuffer::render_bind_vertex_buffers()` | 145 ms | 87 ms | −58 |\r\n| `MTLResourceListAddResource` | 189 ms | 132 ms | −57 |\r\n| `ResourceTracker::encode(RenderCommandEncoder*)` | 56 ms | 0 ms | −56 |\r\n| `RenderingDeviceGraph::_allocate_draw_list_instruction()` | 123 ms | 69 ms | −54 |\r\n\r\n**Inclusive time by area**\r\n\r\n| Area | Hazard | Barriers | Δ |\r\n| :--- | ---: | ---: | ---: |\r\n| `MDCommandBuffer` | 10,478 ms | 5,524 ms | −4,954 |\r\n| `RenderingDevice::` | 22,683 ms | 18,352 ms | −4,331 |\r\n| `RenderingDeviceDriverMetal` | 5,400 ms | 3,628 ms | −1,772 |\r\n| `mach_msg2_trap` | 1,614 ms | 576 ms | −1,038 |\r\n| `AGX::` | 2,058 ms | 1,578 ms | −480 |\r\n\r\n`ResourceTracker::reset()`, `ResourceTracker::encode()` and the two `HashMap` instantiations backing them total ~493 ms under hazard tracking and ~1 ms with barriers. The remainder is kernel and driver residency traffic: `mach_msg2_trap`, `iokit_user_client_trap`, `_ioGPUResourceListAddResourceEntry` and `MTLResourceListAddResource` together fall by ~1,441 ms.\r\n\r\n</details>\r\n","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5313218569/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5406938072","html_url":"https://github.com/godotengine/godot/pull/121392#issuecomment-5406938072","issue_url":"https://api.github.com/repos/godotengine/godot/issues/121392","id":5406938072,"node_id":"IC_kwDOAO6SJc8AAAABQkdT2A","user":{"login":"stuartcarnie","id":52852,"node_id":"MDQ6VXNlcjUyODUy","avatar_url":"https://avatars.githubusercontent.com/u/52852?v=4","gravatar_id":"","url":"https://api.github.com/users/stuartcarnie","html_url":"https://github.com/stuartcarnie","followers_url":"https://api.github.com/users/stuartcarnie/followers","following_url":"https://api.github.com/users/stuartcarnie/following{/other_user}","gists_url":"https://api.github.com/users/stuartcarnie/gists{/gist_id}","starred_url":"https://api.github.com/users/stuartcarnie/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/stuartcarnie/subscriptions","organizations_url":"https://api.github.com/users/stuartcarnie/orgs","repos_url":"https://api.github.com/users/stuartcarnie/repos","events_url":"https://api.github.com/users/stuartcarnie/events{/privacy}","received_events_url":"https://api.github.com/users/stuartcarnie/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-08-25T07:23:04Z","updated_at":"2026-08-25T07:23:04Z","body":"@blueskythlikesclouds entirely up to you, but you could just review these two commits and merge this PR, rather than reviewing #122248 if you want?\r\n\r\nBarrier mode is now the default for Metal 3 in this PR, which means GPU timestamps will Just Work™ for all users.","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5406938072/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github