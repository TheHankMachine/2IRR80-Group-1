ays whether extension is reloadable and whether its version is compatible with the current one.\n\nI know this dialog was already reviewed and approved as part of #90979, but upon re-review I just noticed some problems 🙃","html_url":"https://github.com/godotengine/godot/pull/115846#pullrequestreview-3751333356","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/115846","author_association":"MEMBER","submitted_at":"2026-02-04T15:39:20Z"},{"id":3752945044,"node_id":"PRR_kwDOAO6SJc7fsWWU","state":"COMMENTED","user":{"site_admin":false,"suspended":false,"updated_at":"0001-01-01T00:00:00Z","avatar_url":"https://avatars.githubusercontent.com/u/1646875?u=24618295fece29a0bf5c850faf2555985232f5f2&v=4","created_at":"0001-01-01T00:00:00Z","followers":0,"following":0,"html_url":"https://github.com/aaronfranke","id":1646875,"node_id":"MDQ6VXNlcjE2NDY4NzU=","login":"aaronfranke","type":"User","owned_private_repos":0,"public_gists":0,"public_repos":0,"total_private_repos":0,"url":"https://api.github.com/users/aaronfranke"},"body":"","html_url":"https://github.com/godotengine/godot/pull/115846#pullrequestreview-3752945044","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/115846","author_association":"MEMBER","submitted_at":"2026-02-04T19:26:04Z"},{"id":3753002122,"node_id":"PRR_kwDOAO6SJc7fskSK","state":"COMMENTED","user":{"site_admin":false,"suspended":false,"updated_at":"0001-01-01T00:00:00Z","avatar_url":"https://avatars.githubusercontent.com/u/1646875?u=24618295fece29a0bf5c850faf2555985232f5f2&v=4","created_at":"0001-01-01T00:00:00Z","followers":0,"following":0,"html_url":"https://github.com/aaronfranke","id":1646875,"node_id":"MDQ6VXNlcjE2NDY4NzU=","login":"aaronfranke","type":"User","owned_private_repos":0,"public_gists":0,"public_repos":0,"total_private_repos":0,"url":"https://api.github.com/users/aaronfranke"},"body":"","html_url":"https://github.com/godotengine/godot/pull/115846#pullrequestreview-3753002122","pull_request_url":