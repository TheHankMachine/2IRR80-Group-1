hived_by":null},{"id":279098219,"node_id":"MDU6TGFiZWwyNzkwOTgyMTk=","url":"https://api.github.com/repos/godotengine/godot/labels/topic:editor","name":"topic:editor","color":"ffee88","default":false,"description":"","archived_at":null,"archived_by":null}],"state":"open","locked":false,"assignees":[],"milestone":{"url":"https://api.github.com/repos/godotengine/godot/milestones/16","html_url":"https://github.com/godotengine/godot/milestone/16","labels_url":"https://api.github.com/repos/godotengine/godot/milestones/16/labels","id":8237783,"node_id":"MI_kwDOAO6SJc4AfbLX","number":16,"title":"4.x","description":"Issues and pull requests slated for an undetermined Godot 4 release.","creator":{"login":"akien-mga","id":4701338,"node_id":"MDQ6VXNlcjQ3MDEzMzg=","avatar_url":"https://avatars.githubusercontent.com/u/4701338?v=4","gravatar_id":"","url":"https://api.github.com/users/akien-mga","html_url":"https://github.com/akien-mga","followers_url":"https://api.github.com/users/akien-mga/followers","following_url":"https://api.github.com/users/akien-mga/following{/other_user}","gists_url":"https://api.github.com/users/akien-mga/gists{/gist_id}","starred_url":"https://api.github.com/users/akien-mga/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/akien-mga/subscriptions","organizations_url":"https://api.github.com/users/akien-mga/orgs","repos_url":"https://api.github.com/users/akien-mga/repos","events_url":"https://api.github.com/users/akien-mga/events{/privacy}","received_events_url":"https://api.github.com/users/akien-mga/received_events","type":"User","user_view_type":"public","site_admin":false},"open_issues":5791,"closed_issues":0,"state":"open","created_at":"2022-07-26T12:42:05Z","updated_at":"2026-10-21T22:40:26Z","due_on":null,"closed_at":null},"comments":0,"created_at":"2026-01-29T08:23:45Z","updated_at":"2026-02-17T20:09:48Z","closed_at":null,"assignee":null,"author_association":"CONTRIBUTOR","issue_field_values":[],"type":null,"active_lock_reason":null,"draft":false,"pull_request":{"url":"https://api.github.com/repos/godotengine/godot/pulls/115562","html_url":"https://github.com/godotengine/godot/pull/115562","diff_url":"https://github.com/godotengine/godot/pull/115562.diff","patch_url":"https://github.com/godotengine/godot/pull/115562.patch","merged_at":null},"body":"Fixes: https://github.com/godotengine/godot/issues/112609\r\n\r\n\r\n## Example\r\n\r\n| Before | After |\r\n|-------------|-------------|\r\n| <img width=\"658\" height=\"579\" alt=\"before_fix\" src=\"https://github.com/user-attachments/assets/1fb76540-ec3b-43bf-a695-436a684f7ecc\" />    | <img width=\"658\" height=\"579\" alt=\"after_fix\" src=\"https://github.com/user-attachments/assets/4904bd4f-0f46-4fca-a881-ad13dab97508\" />    |\r\n\r\n<details>\r\n<summary>GDScript source code</summary>\r\n\r\n```gdscript\r\nextends Node\r\n\r\n@onready var normal_path: Node = %Test\r\n\r\nfunc _ready() -> void:\r\n\tvar normal_parent_path := ^\"Parent\"\r\n\tvar normal_node := %Node\r\n\t\r\n\t# Bugs things:\r\n\tvar c1 = 3 \\\r\n\t^ 1\r\n\t\r\n\tvar separated_line: String = \"fromatted text %d\" \\\r\n\t% 5\r\n\t\r\n\tvar multiline_formatted_text = \"first line %s\" \\\r\n\t\\\r\n\t\\\r\n\t\r\n\t% \"it's not green\"\r\n```\r\n\r\n</details>\r\n\r\n## Details \r\n\r\nThe issue caused incorrect syntax highlighting for the `%` and `^` operators when using line continuations `\\`. \r\n\r\nThe previous implementation only searched for the left operand within the current line when detecting binary operations, so any line continuation would break this logic.\r\n\r\n## Fix\r\n\r\nAdded search for the left operand across all previous lines containing line continuations `\\` or empty lines. \r\n\r\nAlso discovered that an empty line (including tabs `\\t`) after a continuation is treated as continuation line too (see last example case, it's correct code).","closed_by":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/115562/reactions","total_count":1,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":1},"timeline_url":"https://api.github.com/repos/godotengine/godot/issues/115562/timeline","performed_via_github_app":null,"state_reason":null}