chived_at":null,"archived_by":null},{"id":2666708289,"node_id":"MDU6TGFiZWwyNjY2NzA4Mjg5","url":"https://api.github.com/repos/godotengine/godot/labels/topic:3d","name":"topic:3d","color":"ffee88","default":false,"description":"","archived_at":null,"archived_by":null}],"state":"closed","locked":false,"assignees":[],"milestone":{"url":"https://api.github.com/repos/godotengine/godot/milestones/23","html_url":"https://github.com/godotengine/godot/milestone/23","labels_url":"https://api.github.com/repos/godotengine/godot/milestones/23/labels","id":12939969,"node_id":"MI_kwDOAO6SJc4AxXLB","number":23,"title":"4.6","description":"","creator":{"login":"Repiteo","id":17489292,"node_id":"MDQ6VXNlcjE3NDg5Mjky","avatar_url":"https://avatars.githubusercontent.com/u/17489292?v=4","gravatar_id":"","url":"https://api.github.com/users/Repiteo","html_url":"https://github.com/Repiteo","followers_url":"https://api.github.com/users/Repiteo/followers","following_url":"https://api.github.com/users/Repiteo/following{/other_user}","gists_url":"https://api.github.com/users/Repiteo/gists{/gist_id}","starred_url":"https://api.github.com/users/Repiteo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Repiteo/subscriptions","organizations_url":"https://api.github.com/users/Repiteo/orgs","repos_url":"https://api.github.com/users/Repiteo/repos","events_url":"https://api.github.com/users/Repiteo/events{/privacy}","received_events_url":"https://api.github.com/users/Repiteo/received_events","type":"User","user_view_type":"public","site_admin":false},"open_issues":3,"closed_issues":2978,"state":"closed","created_at":"2025-05-22T16:25:52Z","updated_at":"2026-10-04T16:23:23Z","due_on":null,"closed_at":"2026-01-26T18:09:14Z"},"comments":5,"created_at":"2025-06-22T07:23:06Z","updated_at":"2025-10-14T00:47:07Z","closed_at":"2025-10-14T00:35:28Z","assignee":null,"author_association":"MEMBER","issue_field_values":[],"type":null,"active_lock_reason":null,"draft":false,"pull_request":{"url":"https://api.github.com/repos/godotengine/godot/pulls/107836","html_url":"https://github.com/godotengine/godot/pull/107836","diff_url":"https://github.com/godotengine/godot/pull/107836.diff","patch_url":"https://github.com/godotengine/godot/pull/107836.patch","merged_at":"2025-10-14T00:35:28Z"},"body":"This PR allows parsing glTF files that contain no nodes. Such files, well, have no nodes, so the best we can do is import an empty scene. However, this adds flexibility, allowing for us to support non-scene glTF files in the engine in the future, and allows users to handle such files in their own code if they wish.\r\n\r\nI think this is best explained with a diagram:\r\n\r\n![GLTF_with_no_Nodes drawio](https://github.com/user-attachments/assets/4fb9873f-1ab7-44b8-adac-84c312e94cdb)\r\n\r\nglTF files without nodes are explicitly supported by the glTF specification:\r\n* https://github.com/KhronosGroup/glTF/blob/main/specification/2.0/schema/glTF.schema.json\r\n* https://github.com/KhronosGroup/glTF/blob/main/specification/2.0/schema/scene.schema.json\r\n\r\n... so this allows Godot to parse such files, even if they have no nodes so result in an empty Godot scene.\r\n\r\nTrivial example. This imports correctly with this PR, but errors too early in the current master, which makes it fail to import, even though the file is spec-compliant. [gltf_file_without_nodes_imported_as_a_mesh_instance.zip](https://github.com/user-attachments/files/20851558/gltf_file_without_nodes_imported_as_a_mesh_instance.zip)\r\n\r\nAnother trivial example. This file can now be imported:\r\n\r\n```gltf\r\n{\r\n    \"asset\": {\r\n        \"version\": \"2.0\"\r\n    }\r\n}\r\n```\r\n\r\nI also renamed some variables in `GLTFDocument::generate_scene` for clarity, including a duplicated `state` vs `p_state`.\r\n","closed_by":{"login":"Repiteo","id":17489292,"node_id":"MDQ6VXNlcjE3NDg5Mjky","avatar_url":"https://avatars.githubusercontent.com/u/17489292?v=4","gravatar_id":"","url":"https://api.github.com/users/Repiteo","html_url":"https://github.com/Repiteo","followers_url":"https://api.github.com/users/Repiteo/followers","following_url":"https://api.github.com/users/Repiteo/following{/other_user}","gists_url":"https://api.github.com/users/Repiteo/gists{/gist_id}","starred_url":"https://api.github.com/users/Repiteo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Repiteo/subscriptions","organizations_url":"https://api.github.com/users/Repiteo/orgs","repos_url":"https://api.github.com/users/Repiteo/repos","events_url":"https://api.github.com/users/Repiteo/events{/privacy}","received_events_url":"https://api.github.com/users/Repiteo/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/107836/reactions","total_count":4,"+1":4,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/godotengine/godot/issues/107836/timeline","performed_via_github_app":null,"state_reason":null}