DQ6VXNlcjU0MjExMTQ1","avatar_url":"https://avatars.githubusercontent.com/u/54211145?v=4","gravatar_id":"","url":"https://api.github.com/users/Garg-Shashwat","html_url":"https://github.com/Garg-Shashwat","followers_url":"https://api.github.com/users/Garg-Shashwat/followers","following_url":"https://api.github.com/users/Garg-Shashwat/following{/other_user}","gists_url":"https://api.github.com/users/Garg-Shashwat/gists{/gist_id}","starred_url":"https://api.github.com/users/Garg-Shashwat/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Garg-Shashwat/subscriptions","organizations_url":"https://api.github.com/users/Garg-Shashwat/orgs","repos_url":"https://api.github.com/users/Garg-Shashwat/repos","events_url":"https://api.github.com/users/Garg-Shashwat/events{/privacy}","received_events_url":"https://api.github.com/users/Garg-Shashwat/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-12-23T23:29:02Z","updated_at":"2025-12-23T23:29:02Z","body":"Tested this with v4.4.1.stable for Android and the issue is there too","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3688205059/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4845814093","html_url":"https://github.com/godotengine/godot/issues/109615#issuecomment-4845814093","issue_url":"https://api.github.com/repos/godotengine/godot/issues/109615","id":4845814093,"node_id":"IC_kwDOAO6SJc8AAAABINVBTQ","user":{"login":"duisterethomas","id":86431053,"node_id":"MDQ6VXNlcjg2NDMxMDUz","avatar_url":"https://avatars.githubusercontent.com/u/86431053?v=4","gravatar_id":"","url":"https://api.github.com/users/duisterethomas","html_url":"https://github.com/duisterethomas","followers_url":"https://api.github.com/users/duisterethomas/followers","following_url":"https://api.github.com/users/duisterethomas/following{/other_user}","gists_url":"https://api.github.com/users/duisterethomas/gists{/gist_id}","starred_url":"https://api.github.com/users/duisterethomas/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/duisterethomas/subscriptions","organizations_url":"https://api.github.com/users/duisterethomas/orgs","repos_url":"https://api.github.com/users/duisterethomas/repos","events_url":"https://api.github.com/users/duisterethomas/events{/privacy}","received_events_url":"https://api.github.com/users/duisterethomas/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-06-30T16:37:40Z","updated_at":"2026-06-30T20:21:02Z","body":"I tested it with 4.7.stable built for Android and the issue is still there. \n\nI have done some more testing though with some interesting results. For my further testing I've added `print(event)` to the `InputEvent` function in the project provided by @NovaSoftInteractive above to be able to see what events got triggered.\n\nFor my second test I enabled `input_devices/pointing/emulate_touch_from_mouse` in the project settings. Then it does trigger an `InputEventScreenTouch` event on my linux pc with a mouse click. So it seems to be an issue with running it on real hardware.\n\nFor my third test I plugged a usb mouse into my Android phone (a Google Pixel 10a running Android 17). Then I disabled `input_devices/pointing/emulate_touch_from_mouse`. Clicking on the Area2D triggers an `InputEventMouseButton` event, not what we're after, but good to know that that works. Strangely though, if I move or click the mouse and then tap on the Area2D with my finger it does trigger an `InputEventScreenTouch` event. Even if the cursor didn't touch the Area2D, or if I unplug the mouse afterwards.\n\nI hope my findings help with fixing this bug!","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4845814093/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4926536794","html_url":"https://github.com/godotengine/godot/issues/109615#issuecomment-4926536794","issue_url":"https://api.github.com/repos/godotengine/godot/issues/109615","id":4926536794,"node_id":"IC_kwDOAO6SJc8AAAABJaT8Wg","user":{"login":"duisterethomas","id":86431053,"node_id":"MDQ6VXNlcjg2NDMxMDUz","avatar_url":"https://avatars.githubusercontent.com/u/86431053?v=4","gravatar_id":"","url":"https://api.github.com/users/duisterethomas","html_url":"https://github.com/duisterethomas","followers_url":"https://api.github.com/users/duisterethomas/followers","following_url":"https://api.github.com/users/duisterethomas/following{/other_user}","gists_url":"https://api.github.com/users/duisterethomas/gists{/gist_id}","starred_url":"https://api.github.com/users/duisterethomas/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/duisterethomas/subscriptions","organizations_url":"https://api.github.com/users/duisterethomas/orgs","repos_url":"https://api.github.com/users/duisterethomas/repos","events_url":"https://api.github.com/users/duisterethomas/events{/privacy}","received_events_url":"https://api.github.com/users/duisterethomas/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-07-09T15:05:52Z","updated_at":"2026-07-10T15:48:16Z","body":"Update: I went trough the Godot source code at the 4.7-stable tag and found this part in the file `scene/main/viewport.cpp` at lines 790-795:\nhttps://github.com/godotengine/godot/blob/4.7-stable/scene/main/viewport.cpp#L790\n```cpp\nif (!gui.mouse_in_viewport || gui.subwindow_over) {\n\t// Clear picking events if the mouse has left the viewport or is over an embedded window.\n\t// These are locations, that are expected to not trigger physics picking.\n\tphysics_picking_events.clear();\n\treturn;\n}\n```\n(I also checked in the master branch and it's still the same: https://github.com/godotengine/godot/blob/master/scene/main/viewport.cpp#L791, same for the 4.7 branch: https://github.com/godotengine/godot/blob/4.7/scene/main/viewport.cpp#L790)\n\nThere Godot specifically checks if the mouse is in the viewport, and if not returns out of the `Viewport::_process_picking()` function. On a phone this check will trigger almost all of the time, because normally you don't have a mouse connected to a phone. So to test this theory I removed `!gui.mouse_in_viewport || ` from line 790 in the 4.7-stable tag, built the Android debug template following the official Godot documentation, selected the custom build template in the export templates of the MRP and exported it. Then the touch input worked on my phone! \n\nNow obviously this isn't a perfect fix as this check is obviously there for a reason, but I do think this gets us a step closer to fixing the bug. A proper fix would probably be to check if the viewport has touch focus or something.","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4926536794/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null}]