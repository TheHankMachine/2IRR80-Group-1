s/DigitalMan171/followers","following_url":"https://api.github.com/users/DigitalMan171/following{/other_user}","gists_url":"https://api.github.com/users/DigitalMan171/gists{/gist_id}","starred_url":"https://api.github.com/users/DigitalMan171/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/DigitalMan171/subscriptions","organizations_url":"https://api.github.com/users/DigitalMan171/orgs","repos_url":"https://api.github.com/users/DigitalMan171/repos","events_url":"https://api.github.com/users/DigitalMan171/events{/privacy}","received_events_url":"https://api.github.com/users/DigitalMan171/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-10-06T17:35:35Z","updated_at":"2025-10-06T17:35:35Z","body":"As a temp fix, you can add a long line of tabs to the bottom of your code, this only effects the longest line. Hopefully this will get an easy fix, but for now this is a simple way to avoid the issue, and keep your project going smoothly!","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3373014328/reactions","total_count":4,"+1":4,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3562747137","html_url":"https://github.com/godotengine/godot/issues/110577#issuecomment-3562747137","issue_url":"https://api.github.com/repos/godotengine/godot/issues/110577","id":3562747137,"node_id":"IC_kwDOAO6SJc7UWzUB","user":{"login":"Griiimon","id":25064539,"node_id":"MDQ6VXNlcjI1MDY0NTM5","avatar_url":"https://avatars.githubusercontent.com/u/25064539?v=4","gravatar_id":"","url":"https://api.github.com/users/Griiimon","html_url":"https://github.com/Griiimon","followers_url":"https://api.github.com/users/Griiimon/followers","following_url":"https://api.github.com/users/Griiimon/following{/other_user}","gists_url":"https://api.github.com/users/Griiimon/gists{/gist_id}","starred_url":"https://api.github.com/users/Griiimon/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Griiimon/subscriptions","organizations_url":"https://api.github.com/users/Griiimon/orgs","repos_url":"https://api.github.com/users/Griiimon/repos","events_url":"https://api.github.com/users/Griiimon/events{/privacy}","received_events_url":"https://api.github.com/users/Griiimon/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-11-21T12:10:02Z","updated_at":"2025-11-21T12:10:02Z","body":"Just adding it to this thread since it isn't explicitly mentioned here: the issue seems to originate from the editor display scale being < 100%\n\nfound out thanks to this title #110916\n","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3562747137/reactions","total_count":1,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":1},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3679544964","html_url":"https://github.com/godotengine/godot/issues/110577#issuecomment-3679544964","issue_url":"https://api.github.com/repos/godotengine/godot/issues/110577","id":3679544964,"node_id":"IC_kwDOAO6SJc7bUWaE","user":{"login":"dmauldin","id":6395,"node_id":"MDQ6VXNlcjYzOTU=","avatar_url":"https://avatars.githubusercontent.com/u/6395?v=4","gravatar_id":"","url":"https://api.github.com/users/dmauldin","html_url":"https://github.com/dmauldin","followers_url":"https://api.github.com/users/dmauldin/followers","following_url":"https://api.github.com/users/dmauldin/following{/other_user}","gists_url":"https://api.github.com/users/dmauldin/gists{/gist_id}","starred_url":"https://api.github.com/users/dmauldin/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/dmauldin/subscriptions","organizations_url":"https://api.github.com/users/dmauldin/orgs","repos_url":"https://api.github.com/users/dmauldin/repos","events_url":"https://api.github.com/users/dmauldin/events{/privacy}","received_events_url":"https://api.github.com/users/dmauldin/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-12-21T21:39:40Z","updated_at":"2025-12-21T21:39:40Z","body":"Still happening on 4.6.dev3\n\nThis is happening with interface/editor/display_scale set to Auto, which is 225% (very high DPI screen).  So definitely not less than 100%.  If I set the display scale to 100%, then create line long enough to cause a horizontal scroll bar to appear, it displays the final char as expected.  So it may be caused with any scaling that's not 100%.\n\nAnother detail is that this only happens for me when there's a horizontal scroll bar and only for the longest line.  You cannot scroll to the right to get the last character of the longest line to be visible.  If you adjust the rest of the UI so that the code editor is wide enough to not have a horizontal scroll bar, you can see the right most character.\n\nI tried turning off the mini-map and adjusting the UI layout in other ways, but it's simply just that if the longest line in the code does not fit, the final character is not displayed.\n\nSo, any display scale that's not 100% and any text lines are long enough to cause the editor to have horizontal scroll, the last character of the longest line cannot be seen when scrolled fully to the right.","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3679544964/reactions","total_count":2,"+1":2,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3802561805","html_url":"https://github.com/godotengine/godot/issues/110577#issuecomment-3802561805","issue_url":"https://api.github.com/repos/godotengine/godot/issues/110577","id":3802561805,"node_id":"IC_kwDOAO6SJc7ipn0N","user":{"login":"PRYZMwubs","id":47482618,"node_id":"MDQ6VXNlcjQ3NDgyNjE4","avatar_url":"https://avatars.githubusercontent.com/u/47482618?v=4","gravatar_id":"","url":"https://api.github.com/users/PRYZMwubs","html_url":"https://github.com/PRYZMwubs","followers_url":"https://api.github.com/users/PRYZMwubs/followers","following_url":"https://api.github.com/users/PRYZMwubs/following{/other_user}","gists_url":"https://api.github.com/users/PRYZMwubs/gists{/gist_id}","starred_url":"https://api.github.com/users/PRYZMwubs/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/PRYZMwubs/subscriptions","organizations_url":"https://api.github.com/users/PRYZMwubs/orgs","repos_url":"https://api.github.com/users/PRYZMwubs/repos","events_url":"https://api.github.com/users/PRYZMwubs/events{/privacy}","received_events_url":"https://api.github.com/users/PRYZMwubs/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-01-27T01:13:28Z","updated_at":"2026-01-27T01:22:12Z","body":"Now happens on 4.6 stable if editor display scale is set to 150% or above, but the same doesn't happen on 4.5 stable, even at 150% scale or above.\n\nEDIT: Using custom display scale, the exact point where this issue occurs is at 148% scale or above.","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3802561805/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3834888038","html_url":"https://github.com/godotengine/godot/issues/110577#issuecomment-3834888038","issue_url":"https://api.github.com/repos/godotengine/godot/issues/110577","id":3834888038,"node_id":"IC_kwDOAO6SJc7kk79m","user":{"login":"rsubtil","id":6501975,"node_id":"MDQ6VXNlcjY1MDE5NzU=","avatar_url":"https://avatars.githubusercontent.com/u/6501975?v=4","gravatar_id":"","url":"https://api.github.com/users/rsubtil","html_url":"https://github.com/rsubtil","followers_url":"https://api.github.com/users/rsubtil/followers","following_url":"https://api.github.com/users/rsubtil/following{/other_user}","gists_url":"https://api.github.com/users/rsubtil/gists{/gist_id}","starred_url":"https://api.github.com/users/rsubtil/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/rsubtil/subscriptions","organizations_url":"https://api.github.com/users/rsubtil/orgs","repos_url":"https://api.github.com/users/rsubtil/repos","events_url":"https://api.github.com/users/rsubtil/events{/privacy}","received_events_url":"https://api.github.com/users/rsubtil/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-02-02T12:39:44Z","updated_at":"2026-02-02T12:39:44Z","body":"Can confirm that non-default editor scales have been causing this since v4.5.1.stable (tested with 75%, 125% and 150%). Still present in v4.6.stable.","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3834888038/reactions","total_count":5,"+1":3,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":2},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3881602066","html_url":"https://github.com/godotengine/godot/issues/110577#issuecomment-3881602066","issue_url":"https://api.github.com/repos/godotengine/godot/issues/110577","id":3881602066,"node_id":"IC_kwDOAO6SJc7nXIwS","user":{"login":"EdwardChanCH","id":97891482,"node_id":"U_kgDOBdW0mg","avatar_url":"https://avatars.githubusercontent.com/u/97891482?v=4","gravatar_id":"","url":"https://api.github.com/users/EdwardChanCH","html_url":"https://github.com/EdwardChanCH","followers_url":"https://api.github.com/users/EdwardChanCH/followers","following_url":"https://api.github.com/users/EdwardChanCH/following{/other_user}","gists_url":"https://api.github.com/users/EdwardChanCH/gists{/gist_id}","starred_url":"https://api.github.com/users/EdwardChanCH/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/EdwardChanCH/subscriptions","organizations_url":"https://api.github.com/users/EdwardChanCH/orgs","repos_url":"https://api.github.com/users/EdwardChanCH/repos","events_url":"https://api.github.com/users/EdwardChanCH/events{/privacy}","received_events_url":"https://api.github.com/users/EdwardChanCH/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-02-11T01:19:24Z","updated_at":"2026-02-11T01:19:24Z","body":"I did some more testing in `v4.6 stable`.\n\nSome of the comments above seem to be no longer true, so here is an updated summary:\n- The bug triggers when \"Editor Settings > Interface > Display Scale\" is not a multiple of 100%.\n- The bug triggers regardless of whether the script editor's scroll bar appears or not.\n- The bug triggers regardless of the script's zoom level.\n\nTest Method: (steps to reproduce)\n1. Change \"Editor Settings > Interface > Display Scale\" to not a multiple of 100%.\n2. Restart the editor.\n3. Change the script's zoom level to 100% (or any value, it doesn't actually matter).\n4. Minimise the width of all vertical tabs/panels by dragging their resize handle all the way to the left/right.\n(i.e. the Scene Tree tab, Recent Scripts tab, and Inspector tab)\n5. Type a very long comment with a 'z' at the end, e.g. `# aaaaaaaaaaz`, until the script's scroll bar appears.\n6. Save the script and wait for a few seconds. If the script automatically resizes itself, try step 5 again.\n7. Remove 1 character so that the script's scroll bar disappears.\n8. Very slowly drag the Scene Tree's resize handle to the right until the last character 'z' disappears, without the script's scroll bar appearing (or very slowly wiggle the handle left and right; it may take a few tries). If the scroll bar always appears when 'z' disappears, then scroll to the right and check if the 'z' is missing.\n9. If step 8 is successful, then the bug is still here.\n\nTest Results: (at different combinations of settings)\n| (Custom) display scale | Script zoom level          | Is scroll bar visible? | Is bug trigged?           |\n|------------------------|------------------------------|------------------------|---------------------------|\n| any of 100%, 200%, 3.0 | any of 50%, 100%, 150%, 200% | any of Yes or No       | No, for all combinations  |\n| any of 75%, 125%, 150% | any of 50%, 100%, 150%, 200% | any of Yes or No       | Yes, for all combinations |\n\nScreenshot: (v4.6 stable, display scale 150%, script zoom level 200%, scroll bar not visible, bug is triggered)\n\n<img width=\"1280\" height=\"747\" alt=\"Image\" src=\"https://github.com/user-attachments/assets/c8f478c5-6a29-499a-99bb-82f27db3a4de\" />\n\n(I typed this comment; no AI was used.)","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3881602066/reactions","total_count":2,"+1":0,"-1":0,"laugh":0,"hooray":2,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3885089777","html_url":"https://github.com/godotengine/godot/issues/110577#issuecomment-3885089777","issue_url":"https://api.github.com/repos/godotengine/godot/issues/110577","id":3885089777,"node_id":"IC_kwDOAO6SJc7nkcPx","user":{"login":"kitbdev","id":10054226,"node_id":"MDQ6VXNlcjEwMDU0MjI2","avatar_url":"https://avatars.githubusercontent.com/u/10054226?v=4","gravatar_id":"","url":"https://api.github.com/users/kitbdev","html_url":"https://github.com/kitbdev","followers_url":"https://api.github.com/users/kitbdev/followers","following_url":"https://api.github.com/users/kitbdev/following{/other_user}","gists_url":"https://api.github.com/users/kitbdev/gists{/gist_id}","starred_url":"https://api.github.com/users/kitbdev/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/kitbdev/subscriptions","organizations_url":"https://api.github.com/users/kitbdev/orgs","repos_url":"https://api.github.com/users/kitbdev/repos","events_url":"https://api.github.com/users/kitbdev/events{/privacy}","received_events_url":"https://api.github.com/users/kitbdev/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-02-11T15:13:45Z","updated_at":"2026-02-11T15:16:38Z","body":"Thanks for testing!\n\nI want to note that this has an open PR to fix it (multiple actually). \n- I recommend this one: https://github.com/godotengine/godot/pull/114221 but I can make a smaller, more minimal fix if wanted.\n\nThe cause of this is the script editor's CodeEdit stylebox content margin is set to certain float values but it isn't handled correctly in TextEdit.\n\nAs a workaround, running this in a tool script should fix it:\n```gdscript\nEditorInterface.get_base_control().get_theme_stylebox(\"normal\", \"CodeEdit\").set_content_margin_all(1)\n```\nIt will take a second to run since it updates the theme.","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3885089777/reactions","total_count":5,"+1":5,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3973910449","html_url":"https://github.com/godotengine/godot/issues/110577#issuecomment-3973910449","issue_url":"https://api.github.com/repos/godotengine/godot/issues/110577","id":3973910449,"node_id":"IC_kwDOAO6SJc7s3Q-x","user":{"login":"CarrotOfPower","id":260066004,"node_id":"U_kgDOD4BK1A","avatar_url":"https://avatars.githubusercontent.com/u/260066004?v=4","gravatar_id":"","url":"https://api.github.com/users/CarrotOfPower","html_url":"https://github.com/CarrotOfPower","followers_url":"https://api.github.com/users/CarrotOfPower/followers","following_url":"https://api.github.com/users/CarrotOfPower/following{/other_user}","gists_url":"https://api.github.com/users/CarrotOfPower/gists{/gist_id}","starred_url":"https://api.github.com/users/CarrotOfPower/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/CarrotOfPower/subscriptions","organizations_url":"https://api.github.com/users/CarrotOfPower/orgs","repos_url":"https://api.github.com/users/CarrotOfPower/repos","events_url":"https://api.github.com/users/CarrotOfPower/events{/privacy}","received_events_url":"https://api.github.com/users/CarrotOfPower/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-02-27T16:37:49Z","updated_at":"2026-03-01T20:41:55Z","body":"- Bisect result: commit 1794098b47a42237452963bb6a641cfe6af46a15.\n- Affected scales I tested (up to 3.0): 0.5, 0.6, 1.1, 1.3, 1.5, 1.6, 1.7, 1.8, 2.1, 2.2, 2.5, 2.8, 2.9.\n\nI've just opened a pull request that should solve the problem (I tested it and it worked!).\n- Pull request: #116850\n\nIf there is a better way to do this, I'm happy to see another pull request merged instead.\nThe main thing is that it's fixed.\nIt would be such a relief to see all the characters.","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3973910449/reactions","total_count":6,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":6,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3978699733","html_url":"https://github.com/godotengine/godot/issues/110577#issuecomment-3978699733","issue_url":"https://api.github.com/repos/godotengine/godot/issues/110577","id":3978699733,"node_id":"IC_kwDOAO6SJc7tJiPV","user":{"login":"WhalesState","id":53877170,"node_id":"MDQ6VXNlcjUzODc3MTcw","avatar_url":"https://avatars.githubusercontent.com/u/53877170?v=4","gravatar_id":"","url":"https://api.github.com/users/WhalesState","html_url":"https://github.com/WhalesState","followers_url":"https://api.github.com/users/WhalesState/followers","following_url":"https://api.github.com/users/WhalesState/following{/other_user}","gists_url":"https://api.github.com/users/WhalesState/gists{/gist_id}","starred_url":"https://api.github.com/users/WhalesState/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/WhalesState/subscriptions","organizations_url":"https://api.github.com/users/WhalesState/orgs","repos_url":"https://api.github.com/users/WhalesState/repos","events_url":"https://api.github.com/users/WhalesState/events{/privacy}","received_events_url":"https://api.github.com/users/WhalesState/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-03-01T00:25:42Z","updated_at":"2026-03-01T00:25:42Z","body":"The core issue is that StyleBox uses floating-point values for margins. See https://github.com/godotengine/godot/issues/111019.","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3978699733/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null}]