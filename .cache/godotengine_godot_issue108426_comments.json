com/Repiteo","followers_url":"https://api.github.com/users/Repiteo/followers","following_url":"https://api.github.com/users/Repiteo/following{/other_user}","gists_url":"https://api.github.com/users/Repiteo/gists{/gist_id}","starred_url":"https://api.github.com/users/Repiteo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Repiteo/subscriptions","organizations_url":"https://api.github.com/users/Repiteo/orgs","repos_url":"https://api.github.com/users/Repiteo/repos","events_url":"https://api.github.com/users/Repiteo/events{/privacy}","received_events_url":"https://api.github.com/users/Repiteo/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-07-09T22:08:33Z","updated_at":"2025-07-09T22:08:33Z","body":" > I'm sort of surprised that the build has worked up until now, given that code in core/ depends on symbols from modules/, scene/ and servers/.\r\n\r\nOut of curiosity: how did you go about finding these? Was it from the compile errors alone, or is there an SCons command/tool you used? I've tried using the latter with `--tree`, but it was always waaay too much to parse in any meaningful way","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3054237363/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3054557963","html_url":"https://github.com/godotengine/godot/pull/108426#issuecomment-3054557963","issue_url":"https://api.github.com/repos/godotengine/godot/issues/108426","id":3054557963,"node_id":"IC_kwDOAO6SJc62ENsL","user":{"login":"simpkins","id":163549,"node_id":"MDQ6VXNlcjE2MzU0OQ==","avatar_url":"https://avatars.githubusercontent.com/u/163549?v=4","gravatar_id":"","url":"https://api.github.com/users/simpkins","html_url":"https://github.com/simpkins","followers_url":"https://api.github.com/users/simpkins/followers","following_url":"https://api.github.com/users/simpkins/following{/other_user}","gists_url":"https://api.github.com/users/simpkins/gists{/gist_id}","starred_url":"https://api.github.com/users/simpkins/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/simpkins/subscriptions","organizations_url":"https://api.github.com/users/simpkins/orgs","repos_url":"https://api.github.com/users/simpkins/repos","events_url":"https://api.github.com/users/simpkins/events{/privacy}","received_events_url":"https://api.github.com/users/simpkins/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-07-10T00:15:33Z","updated_at":"2025-07-10T00:15:33Z","body":"> Out of curiosity: how did you go about finding these? Was it from the compile errors alone, or is there an SCons command/tool you used? I've tried using the latter with --tree, but it was always waaay too much to parse in any meaningful way\r\n\r\nInitially some of it was just from the build errors while working on #108415, but then I just did a pretty dumb grep to look for includes that shouldn't be there.  e.g. `rg '#include \"(main|modules|scene|servers)/' core`\r\n(You can use `grep -Er` instead of `rg` if you don't have ripgrep installed.)\r\n\r\nGrepping for all the includes and sorting the results by include path is also helpful to look for things that shouldn't be there:\r\n```\r\nrg '#include' core | awk -F : '{ print $2 \" : \" $1 }' | sort\r\n```\r\n","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3054557963/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null}]