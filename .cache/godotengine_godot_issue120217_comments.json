[{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4711368185","html_url":"https://github.com/godotengine/godot/issues/120217#issuecomment-4711368185","issue_url":"https://api.github.com/repos/godotengine/godot/issues/120217","id":4711368185,"node_id":"IC_kwDOAO6SJc8AAAABGNHF-Q","user":{"login":"jack-klein-5","id":56490766,"node_id":"MDQ6VXNlcjU2NDkwNzY2","avatar_url":"https://avatars.githubusercontent.com/u/56490766?v=4","gravatar_id":"","url":"https://api.github.com/users/jack-klein-5","html_url":"https://github.com/jack-klein-5","followers_url":"https://api.github.com/users/jack-klein-5/followers","following_url":"https://api.github.com/users/jack-klein-5/following{/other_user}","gists_url":"https://api.github.com/users/jack-klein-5/gists{/gist_id}","starred_url":"https://api.github.com/users/jack-klein-5/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/jack-klein-5/subscriptions","organizations_url":"https://api.github.com/users/jack-klein-5/orgs","repos_url":"https://api.github.com/users/jack-klein-5/repos","events_url":"https://api.github.com/users/jack-klein-5/events{/privacy}","received_events_url":"https://api.github.com/users/jack-klein-5/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-06-15T19:02:56Z","updated_at":"2026-06-15T19:02:56Z","body":"I looked into this a bit. I was able to reproduce the behavior with the MRP and it looks like Windows specifically dislikes multiple shift keys with the KEYUP event. If multiple shift keys are pressed only the last KEYUP will fire. So previously there was an edge case put in for if there's still a shift key pressed fire the KEYUP anyway. This worked for when one shift was released after another, but when both are released simultaneously there isn't a shift being pressed for the edge case, and Windows still only fires one KEYUP event. I made a pull request #120327 that would change all shift up cases to checking raw keyboard input instead, so we wouldn't have to depend on Windows KEYUP.","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4711368185/reactions","total_count":3,"+1":2,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":1},"performed_via_github_app":null,"minimized":null}]