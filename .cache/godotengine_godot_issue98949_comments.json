/godot/issues/comments/2465073174/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2466070522","html_url":"https://github.com/godotengine/godot/pull/98949#issuecomment-2466070522","issue_url":"https://api.github.com/repos/godotengine/godot/issues/98949","id":2466070522,"node_id":"IC_kwDOAO6SJc6S_T_6","user":{"login":"Meorge","id":9957987,"node_id":"MDQ6VXNlcjk5NTc5ODc=","avatar_url":"https://avatars.githubusercontent.com/u/9957987?v=4","gravatar_id":"","url":"https://api.github.com/users/Meorge","html_url":"https://github.com/Meorge","followers_url":"https://api.github.com/users/Meorge/followers","following_url":"https://api.github.com/users/Meorge/following{/other_user}","gists_url":"https://api.github.com/users/Meorge/gists{/gist_id}","starred_url":"https://api.github.com/users/Meorge/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Meorge/subscriptions","organizations_url":"https://api.github.com/users/Meorge/orgs","repos_url":"https://api.github.com/users/Meorge/repos","events_url":"https://api.github.com/users/Meorge/events{/privacy}","received_events_url":"https://api.github.com/users/Meorge/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2024-11-09T06:07:27Z","updated_at":"2024-11-09T23:55:03Z","body":"Thanks, I've added a warning for that as well! It continues moving up the tree until both warnings have been triggered, so that if someone happens to meet both conditions, they are aware of both instead of thinking that there was only one they needed to satisfy.\r\n\r\nIt did get me wondering, though - do CanvasGroups behave incorrectly if they are children of a clipping node or another CanvasGroup, and if so, should warnings for those cases also be added to this PR?\r\n\r\nEdit: Just tested, and yes it appears that Godot does not like nested CanvasGroups. I'll add a warning for CanvasGroup when they detect an ancestor also being a CanvasGroup or having a clip setting other than disabled.","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2466070522/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2466572488","html_url":"https://github.com/godotengine/godot/pull/98949#issuecomment-2466572488","issue_url":"https://api.github.com/repos/godotengine/godot/issues/98949","id":2466572488,"node_id":"IC_kwDOAO6SJc6TBOjI","user":{"login":"Meorge","id":9957987,"node_id":"MDQ6VXNlcjk5NTc5ODc=","avatar_url":"https://avatars.githubusercontent.com/u/9957987?v=4","gravatar_id":"","url":"https://api.github.com/users/Meorge","html_url":"https://github.com/Meorge","followers_url":"https://api.github.com/users/Meorge/followers","following_url":"https://api.github.com/users/Meorge/following{/other_user}","gists_url":"https://api.github.com/users/Meorge/gists{/gist_id}","starred_url":"https://api.github.com/users/Meorge/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Meorge/subscriptions","organizations_url":"https://api.github.com/users/Meorge/orgs","repos_url":"https://api.github.com/users/Meorge/repos","events_url":"https://api.github.com/users/Meorge/events{/privacy}","received_events_url":"https://api.github.com/users/Meorge/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2024-11-10T03:59:15Z","updated_at":"2024-11-10T03:59:15Z","body":"Warnings have been added for:\r\n- CanvasItems, when an ancestor is a CanvasGroup\r\n- CanvasGroups, when an ancestor is either a CanvasGroup or clips its children\r\n\r\n![CleanShot 2024-11-09 at 19 55 09@2x](https://github.com/user-attachments/assets/d06