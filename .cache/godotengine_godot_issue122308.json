d_events_url":"https://api.github.com/users/Repiteo/received_events","type":"User","user_view_type":"public","site_admin":false},"open_issues":343,"closed_issues":2335,"state":"open","created_at":"2026-04-13T15:59:35Z","updated_at":"2026-10-22T06:28:22Z","due_on":null,"closed_at":null},"comments":1,"created_at":"2026-08-11T15:37:32Z","updated_at":"2026-09-03T20:58:35Z","closed_at":"2026-09-02T14:42:28Z","assignee":null,"author_association":"MEMBER","issue_field_values":[],"type":null,"active_lock_reason":null,"draft":false,"pull_request":{"url":"https://api.github.com/repos/godotengine/godot/pulls/122308","html_url":"https://github.com/godotengine/godot/pull/122308","diff_url":"https://github.com/godotengine/godot/pull/122308.diff","patch_url":"https://github.com/godotengine/godot/pull/122308.patch","merged_at":"2026-09-02T14:42:28Z"},"body":"## What problem(s) does this PR solve?\r\n\r\n- Part of https://github.com/godotengine/godot-proposals/issues/14566\r\n- Followup to https://github.com/godotengine/godot/pull/117946\r\n\r\n## Additional information\r\n\r\n`ScriptLanguage::CodeCompletionOption` did take a double role as both the representation used by providers of options and internally by `CodeEdit`. With this PR I did end up splitting this into `EditorLanguage::CompletionOption` for language implementations and `CodeEdit::CodeCompletionOption` for the internal representation used by code edit.\r\n\r\nFor both structs it was possible to remove some fields that were only relevant to the other usecase. E.g. languages do provide colors as theme names but `CodeEdit` uses raw colors, so previously we had both `font_color` and `theme_color_name`. Now each struct only contains what it needs. (It's not like the language provided options were used by `CodeEdit` in-place, they were mapped and new instances were created. So a `font_color` on the language provided option did not have any effect, since it was not handled by the mapping.)\r\n\r\nThe shader code does not seem to have a clear boundary between editor code and runtime code. I did `ifdef` and split to the best of my understanding. I'm not sure what/how to test though.\r\n","closed_by":{"login":"Repiteo","id":17489292,"node_id":"MDQ6VXNlcjE3NDg5Mjky","avatar_url":"https://avatars.githubusercontent.com/u/17489292?v=4","gravatar_id":"","url":"https://api.github.com/users/Repiteo","html_url":"https://github.com/Repiteo","followers_url":"https://api.github.com/users/Repiteo/followers","following_url":"https://api.github.com/users/Repiteo/following{/other_user}","gists_url":"https://api.github.com/users/Repiteo/gists{/gist_id}","starred_url":"https://api.github.com/users/Repiteo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Repiteo/subscriptions","organizations_url":"https://api.github.com/users/Repiteo/orgs","repos_url":"https://api.github.com/users/Repiteo/repos","events_url":"https://api.github.com/users/Repiteo/events{/privacy}","received_events_url":"https://api.github.com/users/Repiteo/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/122308/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/godotengine/godot/issues/122308/timeline","performed_via_github_app":null,"state_reason":null}