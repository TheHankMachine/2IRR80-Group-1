":"platform:ios","color":"e4e4e4","default":false,"description":"","archived_at":null,"archived_by":null},{"id":279098009,"node_id":"MDU6TGFiZWwyNzkwOTgwMDk=","url":"https://api.github.com/repos/godotengine/godot/labels/topic:buildsystem","name":"topic:buildsystem","color":"ffee88","default":false,"description":"","archived_at":null,"archived_by":null},{"id":279098255,"node_id":"MDU6TGFiZWwyNzkwOTgyNTU=","url":"https://api.github.com/repos/godotengine/godot/labels/topic:platforms","name":"topic:platforms","color":"ffee88","default":false,"description":"","archived_at":null,"archived_by":null},{"id":1332303119,"node_id":"MDU6TGFiZWwxMzMyMzAzMTE5","url":"https://api.github.com/repos/godotengine/godot/labels/regression","name":"regression","color":"ff63ac","default":false,"description":"","archived_at":null,"archived_by":null}],"state":"closed","locked":false,"assignees":[],"milestone":{"url":"https://api.github.com/repos/godotengine/godot/milestones/25","html_url":"https://github.com/godotengine/godot/milestone/25","labels_url":"https://api.github.com/repos/godotengine/godot/milestones/25/labels","id":15520464,"node_id":"MI_kwDOAO6SJc4A7NLQ","number":25,"title":"4.8","description":"","creator":{"login":"Repiteo","id":17489292,"node_id":"MDQ6VXNlcjE3NDg5Mjky","avatar_url":"https://avatars.githubusercontent.com/u/17489292?v=4","gravatar_id":"","url":"https://api.github.com/users/Repiteo","html_url":"https://github.com/Repiteo","followers_url":"https://api.github.com/users/Repiteo/followers","following_url":"https://api.github.com/users/Repiteo/following{/other_user}","gists_url":"https://api.github.com/users/Repiteo/gists{/gist_id}","starred_url":"https://api.github.com/users/Repiteo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Repiteo/subscriptions","organizations_url":"https://api.github.com/users/Repiteo/orgs","repos_url":"https://api.github.com/users/Repiteo/repos","events_url":"https://api.github.com/users/Repiteo/events{/privacy}","received_events_url":"https://api.github.com/users/Repiteo/received_events","type":"User","user_view_type":"public","site_admin":false},"open_issues":343,"closed_issues":2335,"state":"open","created_at":"2026-04-13T15:59:35Z","updated_at":"2026-10-22T06:28:22Z","due_on":null,"closed_at":null},"comments":8,"created_at":"2026-08-18T15:21:35Z","updated_at":"2026-09-28T18:41:54Z","closed_at":"2026-09-28T18:37:40Z","assignee":null,"author_association":"NONE","issue_field_values":[],"type":null,"active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"### Tested versions\n\n- Reproducible in 4.7.stable and 4.7.1.stable iOS export templates\n- Not reproducible in 4.6.stable\n\n\n\n### System information\n\nmacOS 15.7.7, Xcode 26.3 (17C529), iOS SDK 26.2, iPad Pro 11\" (4th gen), Godot 4.7.1.stable, Mobile renderer\n\n### Issue description\n\nLinking an exported iOS project fails with two undefined symbols:\n```\nUndefined symbols for architecture arm64:\n  \"_SDL_IsIPad\", referenced from: SDL.ios.template_debug.arm64.o in libgodot.a\n  \"_SDL_IsAppleTV\", referenced from: SDL.ios.template_debug.arm64.o in libgodot.a\nld: symbol(s) not found for architecture arm64\n```\n\nThe `libgodot.a` shipped in the iOS template defines 869 SDL symbols, but not these two, they are the only SDL symbols in the archive left undefined. Upstream they live in `SDL_uikitvideo.m`, which isn't part of Godot's SDL build since only the joystick subsystem is compiled. Both the debug and release xcframeworks are affected.\n\nThis looks like it comes from #114316 (SDL3 joystick driver for iOS, merged for 4.7). CI builds the static library but never links an iOS app, linking only happens at export time, so the missing symbols pass CI.\n\n### Steps to reproduce\n\n1. Export any project for iOS with 4.7.1 templates, \"Export Project Only\"\n2. Build for an arm64 device in Xcode\n3. Linking fails with the symbols above\n\nThis can be confirmed without exporting anything, straight from the installed template:\n```\nnm libgodot.ios.debug.xcframework/ios-arm64/libgodot.a | grep -c ' T _SDL_IsIPad'   # 0\nnm -u libgodot.ios.debug.xcframework/ios-arm64/libgodot.a | grep -c '_SDL_IsIPad'   # 1\n```\n\nProviding the two functions in the exported Xcode project makes it link, and the app runs on device with gamepad paths behaving normally:\n```objective-c\n#import <UIKit/UIKit.h>\n#include <stdbool.h>\n\nbool SDL_IsIPad(void)            { return UIDevice.currentDevice.userInterfaceIdiom == UIUserInterfaceIdiomPad; }\nbool SDL_IsAppleTV(void)     { return false; }\n```\n\n### Minimal reproduction project (MRP)\n\nNot needed, any project exported with the official 4.7.1 iOS templates reproduces it, and the `nm` check above confirms it on the shipped template alone.","closed_by":{"login":"Repiteo","id":17489292,"node_id":"MDQ6VXNlcjE3NDg5Mjky","avatar_url":"https://avatars.githubusercontent.com/u/17489292?v=4","gravatar_id":"","url":"https://api.github.com/users/Repiteo","html_url":"https://github.com/Repiteo","followers_url":"https://api.github.com/users/Repiteo/followers","following_url":"https://api.github.com/users/Repiteo/following{/other_user}","gists_url":"https://api.github.com/users/Repiteo/gists{/gist_id}","starred_url":"https://api.github.com/users/Repiteo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Repiteo/subscriptions","organizations_url":"https://api.github.com/users/Repiteo/orgs","repos_url":"https://api.github.com/users/Repiteo/repos","events_url":"https://api.github.com/users/Repiteo/events{/privacy}","received_events_url":"https://api.github.com/users/Repiteo/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/122549/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"