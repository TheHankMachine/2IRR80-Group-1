m/users/groud/followers","following_url":"https://api.github.com/users/groud/following{/other_user}","gists_url":"https://api.github.com/users/groud/gists{/gist_id}","starred_url":"https://api.github.com/users/groud/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/groud/subscriptions","organizations_url":"https://api.github.com/users/groud/orgs","repos_url":"https://api.github.com/users/groud/repos","events_url":"https://api.github.com/users/groud/events{/privacy}","received_events_url":"https://api.github.com/users/groud/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2024-10-24T07:29:59Z","updated_at":"2024-10-24T07:29:59Z","body":"The documentation is wrong, those are supposed to be INTs. This is because this value is in pixel and sprites/controls that are not aligned to the grid would could look blurry.\r\n\r\nChanging this to float requires a proposal, but the documentation should be fixed for now.","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2434508841/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2434553827","html_url":"https://github.com/godotengine/godot/pull/98443#issuecomment-2434553827","issue_url":"https://api.github.com/repos/godotengine/godot/issues/98443","id":2434553827,"node_id":"IC_kwDOAO6SJc6RHFfj","user":{"login":"timoschwarzer","id":8849554,"node_id":"MDQ6VXNlcjg4NDk1NTQ=","avatar_url":"https://avatars.githubusercontent.com/u/8849554?v=4","gravatar_id":"","url":"https://api.github.com/users/timoschwarzer","html_url":"https://github.com/timoschwarzer","followers_url":"https://api.github.com/users/timoschwarzer/followers","following_url":"https://api.github.com/users/timoschwarzer/following{/other_user}","gists_url":"https://api.githu