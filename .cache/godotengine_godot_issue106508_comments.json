508","id":3136985852,"node_id":"IC_kwDOAO6SJc66-pr8","user":{"login":"catprisbrey","id":43008564,"node_id":"MDQ6VXNlcjQzMDA4NTY0","avatar_url":"https://avatars.githubusercontent.com/u/43008564?v=4","gravatar_id":"","url":"https://api.github.com/users/catprisbrey","html_url":"https://github.com/catprisbrey","followers_url":"https://api.github.com/users/catprisbrey/followers","following_url":"https://api.github.com/users/catprisbrey/following{/other_user}","gists_url":"https://api.github.com/users/catprisbrey/gists{/gist_id}","starred_url":"https://api.github.com/users/catprisbrey/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/catprisbrey/subscriptions","organizations_url":"https://api.github.com/users/catprisbrey/orgs","repos_url":"https://api.github.com/users/catprisbrey/repos","events_url":"https://api.github.com/users/catprisbrey/events{/privacy}","received_events_url":"https://api.github.com/users/catprisbrey/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-07-30T16:14:19Z","updated_at":"2025-07-30T16:14:37Z","body":"This can lead to crashes as well. I ran into this signal issue freezing my editor when making a script/tool that would update settings when the curve_changed was emitted. Led to silent infinite recursion and would leave the editor frozen in a forever change/update loop. Ended up needing to make separate signals to avoid it since the built-ins we too hyper.","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3136985852/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null}]