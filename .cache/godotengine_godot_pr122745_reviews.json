[{"id":5003371255,"node_id":"PRR_kwDOAO6SJc8AAAABKjli9w","user":{"login":"smix8","id":52464204,"node_id":"MDQ6VXNlcjUyNDY0MjA0","avatar_url":"https://avatars.githubusercontent.com/u/52464204?u=4854f17c9d330a8a9d274f0cb7b943fc2bb6dd44&v=4","gravatar_id":"","url":"https://api.github.com/users/smix8","html_url":"https://github.com/smix8","followers_url":"https://api.github.com/users/smix8/followers","following_url":"https://api.github.com/users/smix8/following{/other_user}","gists_url":"https://api.github.com/users/smix8/gists{/gist_id}","starred_url":"https://api.github.com/users/smix8/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/smix8/subscriptions","organizations_url":"https://api.github.com/users/smix8/orgs","repos_url":"https://api.github.com/users/smix8/repos","events_url":"https://api.github.com/users/smix8/events{/privacy}","received_events_url":"https://api.github.com/users/smix8/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"Approve for the change, still needs a code yada.\r\n\r\nA mentioned before it is a performance problem and threading hazard to directly return objects like that. The server should never have to do any of that.\r\n\r\nUsers should only ever get object ids and rids from queries and do with those ids manually what they want at their own risk.","state":"APPROVED","html_url":"https://github.com/godotengine/godot/pull/122745#pullrequestreview-5003371255","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/122745","author_association":"CONTRIBUTOR","_links":{"html":{"href":"https://github.com/godotengine/godot/pull/122745#pullrequestreview-5003371255"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/122745"}},"submitted_at":"2026-08-23T21:07:14Z","commit_id":"7cf45d68c90df40b83829776ea1439fed404455b"},{"id":5122306458,"node_id":"PRR_kwDOAO6SJc8AAAABMVAxmg","user":{"login":"mihe","id":4884246,"node_id":"MDQ6VXNlcjQ4ODQyNDY=","avata