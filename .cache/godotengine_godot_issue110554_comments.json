[{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3296553329","html_url":"https://github.com/godotengine/godot/issues/110554#issuecomment-3296553329","issue_url":"https://api.github.com/repos/godotengine/godot/issues/110554","id":3296553329,"node_id":"IC_kwDOAO6SJc7EfWlx","user":{"login":"barthy-koeln","id":10552683,"node_id":"MDQ6VXNlcjEwNTUyNjgz","avatar_url":"https://avatars.githubusercontent.com/u/10552683?v=4","gravatar_id":"","url":"https://api.github.com/users/barthy-koeln","html_url":"https://github.com/barthy-koeln","followers_url":"https://api.github.com/users/barthy-koeln/followers","following_url":"https://api.github.com/users/barthy-koeln/following{/other_user}","gists_url":"https://api.github.com/users/barthy-koeln/gists{/gist_id}","starred_url":"https://api.github.com/users/barthy-koeln/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/barthy-koeln/subscriptions","organizations_url":"https://api.github.com/users/barthy-koeln/orgs","repos_url":"https://api.github.com/users/barthy-koeln/repos","events_url":"https://api.github.com/users/barthy-koeln/events{/privacy}","received_events_url":"https://api.github.com/users/barthy-koeln/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-09-16T08:25:51Z","updated_at":"2025-09-16T08:25:51Z","body":"Just chiming in with some potentially helpful info.\n\nI've had this issue during 4.5 beta phases and found out the character was a \"Six-Per-Em Space (U+2006)\" (decimal 8198).\n\nThat was missing in my font file, and I was seeing an unknown char.\nI fixed it by adding a range of “invisible” characters to the font file, namely decimal range 8192-8203.\n\nUsing a fully-featured `.ttf` file (e.g., just a simple `Arial.ttf` from your system) does not show this additional character in your MRP — can you double-check?","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/is