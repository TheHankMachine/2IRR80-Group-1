_type":"public","site_admin":false},"open_issues":343,"closed_issues":2335,"state":"open","created_at":"2026-04-13T15:59:35Z","updated_at":"2026-10-22T06:28:22Z","due_on":null,"closed_at":null},"comments":2,"created_at":"2026-07-02T21:10:36Z","updated_at":"2026-07-04T01:29:14Z","closed_at":"2026-07-03T21:50:57Z","assignee":null,"author_association":"MEMBER","issue_field_values":[],"type":null,"active_lock_reason":null,"draft":false,"pull_request":{"url":"https://api.github.com/repos/godotengine/godot/pulls/120870","html_url":"https://github.com/godotengine/godot/pull/120870","diff_url":"https://github.com/godotengine/godot/pull/120870.diff","patch_url":"https://github.com/godotengine/godot/pull/120870.patch","merged_at":"2026-07-03T21:50:57Z"},"body":"## What problem(s) does this PR solve?\r\n\r\n- Fixes #120382\r\n\r\n## Additional information\r\n\r\nPR #115528 made it so that materials not present in `p_material_data` would be skipped and not extracted to external files. This could be argued to be better than the previous version of the code because it avoids an error, however, `p_material_data` does not contain information for materials that are not individually overridden in the Advanced Import Settings dialog, so when only using the Import dock, materials could not be extracted to files.\r\n\r\nI looked into what populates `p_material_data`, and I believe it is correct to keep this empty for simple use cases involving only the Import dock. So, upon closer investigation, we *should* allow this to be empty, we just need to handle this case better, in a way that doesn't show any error messages.\r\n\r\nThis PR fixes the code to handle this case, reads existing file paths instead of always overwriting them, permits individual materials to opt-out of extracting, and adds several comments to improve the clarity of the code.\r\n","closed_by":{"login":"Repiteo","id":17489292,"node_id":"MDQ6VXNlcjE3NDg5Mjky","avatar_url":"https://avatars.githubusercontent.com/u/17489292?v=4","gravatar_id":"","url":"https://api.github.com/users/Repiteo","html_url":"https://github.com/Repiteo","followers_url":"https://api.github.com/users/Repiteo/followers","following_url":"https://api.github.com/users/Repiteo/following{/other_user}","gists_url":"https://api.github.com/users/Repiteo/gists{/gist_id}","starred_url":"https://api.github.com/users/Repiteo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Repiteo/subscriptions","organizations_url":"https://api.github.com/users/Repiteo/orgs","repos_url":"https://api.github.com/users/Repiteo/repos","events_url":"https://api.github.com/users/Repiteo/events{/privacy}","received_events_url":"https://api.github.com/users/Repiteo/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/120870/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/godotengine/godot/issues/120870/timeline","performed_via_github_app":null,"state_reason":null}