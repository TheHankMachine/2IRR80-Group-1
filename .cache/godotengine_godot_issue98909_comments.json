[{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2460930515","html_url":"https://github.com/godotengine/godot/pull/98909#issuecomment-2460930515","issue_url":"https://api.github.com/repos/godotengine/godot/issues/98909","id":2460930515,"node_id":"IC_kwDOAO6SJc6SrtHT","user":{"login":"fire","id":32321,"node_id":"MDQ6VXNlcjMyMzIx","avatar_url":"https://avatars.githubusercontent.com/u/32321?v=4","gravatar_id":"","url":"https://api.github.com/users/fire","html_url":"https://github.com/fire","followers_url":"https://api.github.com/users/fire/followers","following_url":"https://api.github.com/users/fire/following{/other_user}","gists_url":"https://api.github.com/users/fire/gists{/gist_id}","starred_url":"https://api.github.com/users/fire/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/fire/subscriptions","organizations_url":"https://api.github.com/users/fire/orgs","repos_url":"https://api.github.com/users/fire/repos","events_url":"https://api.github.com/users/fire/events{/privacy}","received_events_url":"https://api.github.com/users/fire/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2024-11-06T22:35:11Z","updated_at":"2024-11-06T22:35:11Z","body":"I think this makes sense, but what was the original problem being solved?","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2460930515/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2460936413","html_url":"https://github.com/godotengine/godot/pull/98909#issuecomment-2460936413","issue_url":"https://api.github.com/repos/godotengine/godot/issues/98909","id":2460936413,"node_id":"IC_kwDOAO6SJc6Srujd","user":{"login":"demolke","id":153469044,"node_id":"U_kgDOCSXAdA","avatar_url":"https://avatars.githubusercontent.com/u/153469044?v=4","gravatar_id":"","url":"https://api.github.com/users/demolke","html_url":"https://github.com/demolke","followers_url":"https://api.github.com/users/demolke/followers","following_url":"https://api.github.com/users/demolke/following{/other_user}","gists_url":"https://api.github.com/users/demolke/gists{/gist_id}","starred_url":"https://api.github.com/users/demolke/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/demolke/subscriptions","organizations_url":"https://api.github.com/users/demolke/orgs","repos_url":"https://api.github.com/users/demolke/repos","events_url":"https://api.github.com/users/demolke/events{/privacy}","received_events_url":"https://api.github.com/users/demolke/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2024-11-06T22:39:04Z","updated_at":"2024-11-06T22:39:04Z","body":"This is the issue https://github.com/godotengine/godot/pull/96778#issuecomment-2458415635 \r\n\r\nAfter https://github.com/godotengine/godot/pull/96778 all textures imported from blend files will get duplicated in the res:// folder.","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2460936413/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2461018477","html_url":"https://github.com/godotengine/godot/pull/98909#issuecomment-2461018477","issue_url":"https://api.github.com/repos/godotengine/godot/issues/98909","id":2461018477,"node_id":"IC_kwDOAO6SJc6SsClt","user":{"login":"demolke","id":153469044,"node_id":"U_kgDOCSXAdA","avatar_url":"https://avatars.githubusercontent.com/u/153469044?v=4","gravatar_id":"","url":"https://api.github.com/users/demolke","html_url":"https://github.com/demolke","followers_url":"https://api.github.com/users/demolke/followers","following_url":"https://api.github.com/users/demolke/following{/other_user}","gists_url":"https://api.github.com/users/demolke/gists{/gist_id}","starred_url":"https://api.github.com/users/demolke/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/demolke/subscriptions","organizations_url":"https://api.github.com/users/demolke/orgs","repos_url":"https://api.github.com/users/demolke/repos","events_url":"https://api.github.com/users/demolke/events{/privacy}","received_events_url":"https://api.github.com/users/demolke/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2024-11-06T23:41:33Z","updated_at":"2024-11-06T23:41:33Z","body":"Ah, me and github - I've uploaded only a part of the change, let me switch it to draft while I try to fix it.","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2461018477/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2461599053","html_url":"https://github.com/godotengine/godot/pull/98909#issuecomment-2461599053","issue_url":"https://api.github.com/repos/godotengine/godot/issues/98909","id":2461599053,"node_id":"IC_kwDOAO6SJc6SuQVN","user":{"login":"lyuma","id":39946030,"node_id":"MDQ6VXNlcjM5OTQ2MDMw","avatar_url":"https://avatars.githubusercontent.com/u/39946030?v=4","gravatar_id":"","url":"https://api.github.com/users/lyuma","html_url":"https://github.com/lyuma","followers_url":"https://api.github.com/users/lyuma/followers","following_url":"https://api.github.com/users/lyuma/following{/other_user}","gists_url":"https://api.github.com/users/lyuma/gists{/gist_id}","starred_url":"https://api.github.com/users/lyuma/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/lyuma/subscriptions","organizations_url":"https://api.github.com/users/lyuma/orgs","repos_url":"https://api.github.com/users/lyuma/repos","events_url":"https://api.github.com/users/lyuma/events{/privacy}","received_events_url":"https://api.github.com/users/lyuma/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2024-11-07T08:22:46Z","updated_at":"2024-11-07T08:22:46Z","body":"Please file a new issue for the bug, with an attached reproduction project, and link to that bug in this PR.\r\n\r\nA link to a PR comment makes it difficult to have a meaningful conversation on this issue, and there is enough nuance with this issue that I don't want to merge a PR without an issue\r\n\r\n---\r\nI'm missing some information here. For example, the issue purports to affect blend files, but the PR here only touches gltf_document code, which means that the issue must be reproducible from a standalone gltf file. I want to understand what cases are being changed.\r\n\r\nGenerally speaking, there are two cases for gltf:\r\n1. either the images are embedded, in which case they are extracted with the model name prefixed (`texture` inside `model.gltf` is extracted to `model_texture.png`), or\r\n2. the images are referenced externally from the gltf file, in which case, they are not extracted since they are external references. In this case, `model.gltf` would directly reference `texture.png` which already exists.\r\n\r\nThis PR is hinting at a possible third case, which I do not understand, in which `model.gltf` (or `model.blend`) references `texture.png` but somehow the gltf_document code also extracts `model_texture.png`.\r\n\r\nI am skeptical about this fix, and we should also keep in mind that when blender gltf exports embed a texture file, there is sometimes a reason for it. I believe that, for example, blender will at times make modifications to the texture and embed it to comply with the gltf spec or to handle certain shader nodes.","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2461599053/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2462921762","html_url":"https://github.com/godotengine/godot/pull/98909#issuecomment-2462921762","issue_url":"https://api.github.com/repos/godotengine/godot/issues/98909","id":2462921762,"node_id":"IC_kwDOAO6SJc6SzTQi","user":{"login":"demolke","id":153469044,"node_id":"U_kgDOCSXAdA","avatar_url":"https://avatars.githubusercontent.com/u/153469044?v=4","gravatar_id":"","url":"https://api.github.com/users/demolke","html_url":"https://github.com/demolke","followers_url":"https://api.github.com/users/demolke/followers","following_url":"https://api.github.com/users/demolke/following{/other_user}","gists_url":"https://api.github.com/users/demolke/gists{/gist_id}","starred_url":"https://api.github.com/users/demolke/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/demolke/subscriptions","organizations_url":"https://api.github.com/users/demolke/orgs","repos_url":"https://api.github.com/users/demolke/repos","events_url":"https://api.github.com/users/demolke/events{/privacy}","received_events_url":"https://api.github.com/users/demolke/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2024-11-07T18:14:31Z","updated_at":"2024-11-07T18:58:40Z","body":"The part about blender is somewhat significant, because `.blend` will get converted to `.gltf` and placed in res://.godot/imported - something the https://github.com/godotengine/godot/pull/96778 considers as impossible to import https://github.com/godotengine/godot/blob/77d6283d22731398e23c3f1e1b4eeedd22a93152/modules/gltf/gltf_document.cpp#L4089 so what happens we fail this check because texture linked from a blend file is considered as placed in imported folder and we fall through to writing it to the disk.\r\n\r\n(It's very much possible to trigger this if you call gltf import methods yourself with paths relative to res://.godot/imported but no one is probably doing that.)\r\n\r\nhttps://github.com/user-attachments/files/17640095/nonembed.zip\r\n\r\nSo on disk it looks like this before the image processing\r\n\r\n.godot/imported/model.gltf\r\nassets/model.blend\r\nassets/texture.png\r\n\r\nThe code above will get res://.godot/imported/../../assets/texture.png dismisses it as unimportable, writes the data to the disk res://assets/model-texture.png and imports that.\r\n\r\n> This PR is hinting at a possible third case, which I do not understand, in which model.gltf (or model.blend) references texture.png but somehow the gltf_document code also extracts model_texture.png.\r\n\r\nYes, exactly - that's the behavior https://github.com/godotengine/godot/pull/96778 introduced.\r\n\r\nI'll port it into an issue - https://github.com/godotengine/godot/issues/98932","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2462921762/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2463007816","html_url":"https://github.com/godotengine/godot/pull/98909#issuecomment-2463007816","issue_url":"https://api.github.com/repos/godotengine/godot/issues/98909","id":2463007816,"node_id":"IC_kwDOAO6SJc6SzoRI","user":{"login":"demolke","id":153469044,"node_id":"U_kgDOCSXAdA","avatar_url":"https://avatars.githubusercontent.com/u/153469044?v=4","gravatar_id":"","url":"https://api.github.com/users/demolke","html_url":"https://github.com/demolke","followers_url":"https://api.github.com/users/demolke/followers","following_url":"https://api.github.com/users/demolke/following{/other_user}","gists_url":"https://api.github.com/users/demolke/gists{/gist_id}","starred_url":"https://api.github.com/users/demolke/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/demolke/subscriptions","organizations_url":"https://api.github.com/users/demolke/orgs","repos_url":"https://api.github.com/users/demolke/repos","events_url":"https://api.github.com/users/demolke/events{/privacy}","received_events_url":"https://api.github.com/users/demolke/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2024-11-07T19:04:08Z","updated_at":"2024-11-07T19:04:49Z","body":"The change \r\n- does `uri.simplify_path();` to make uri absolute\r\n- removes the `p_base_path.begins_with(\"res://.godot/imported\")` check - I think it's meaningless - ResourceLoader will tell you if the texture has been imported or not\r\n- if I've would have left `_parse_image_save_image` as is, all un-imported textures that have valid uri would get read from the disk and then written back for no reason\r\n\r\n","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2463007816/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2465728411","html_url":"https://github.com/godotengine/godot/pull/98909#issuecomment-2465728411","issue_url":"https://api.github.com/repos/godotengine/godot/issues/98909","id":2465728411,"node_id":"IC_kwDOAO6SJc6S-Aeb","user":{"login":"demolke","id":153469044,"node_id":"U_kgDOCSXAdA","avatar_url":"https://avatars.githubusercontent.com/u/153469044?v=4","gravatar_id":"","url":"https://api.github.com/users/demolke","html_url":"https://github.com/demolke","followers_url":"https://api.github.com/users/demolke/followers","following_url":"https://api.github.com/users/demolke/following{/other_user}","gists_url":"https://api.github.com/users/demolke/gists{/gist_id}","starred_url":"https://api.github.com/users/demolke/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/demolke/subscriptions","organizations_url":"https://api.github.com/users/demolke/orgs","repos_url":"https://api.github.com/users/demolke/repos","events_url":"https://api.github.com/users/demolke/events{/privacy}","received_events_url":"https://api.github.com/users/demolke/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2024-11-08T20:49:54Z","updated_at":"2024-11-08T20:49:54Z","body":"@aaronfranke thanks for the pointer. I only tested it with embedded textures and unpack enabled, so will take a look.","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2465728411/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2475100484","html_url":"https://github.com/godotengine/godot/pull/98909#issuecomment-2475100484","issue_url":"https://api.github.com/repos/godotengine/godot/issues/98909","id":2475100484,"node_id":"IC_kwDOAO6SJc6ThwlE","user":{"login":"demolke","id":153469044,"node_id":"U_kgDOCSXAdA","avatar_url":"https://avatars.githubusercontent.com/u/153469044?v=4","gravatar_id":"","url":"https://api.github.com/users/demolke","html_url":"https://github.com/demolke","followers_url":"https://api.github.com/users/demolke/followers","following_url":"https://api.github.com/users/demolke/following{/other_user}","gists_url":"https://api.github.com/users/demolke/gists{/gist_id}","starred_url":"https://api.github.com/users/demolke/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/demolke/subscriptions","organizations_url":"https://api.github.com/users/demolke/orgs","repos_url":"https://api.github.com/users/demolke/repos","events_url":"https://api.github.com/users/demolke/events{/privacy}","received_events_url":"https://api.github.com/users/demolke/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2024-11-14T00:28:53Z","updated_at":"2024-11-14T00:51:59Z","body":"I think I've addressed all the permutations. Added a couple of tests, but they do not capture the full breadth of the problem (that would require blender installation during unit test) - only some of the basic use cases. I am not very happy with them - they write to disk, so are not idempotent. I'm wondering if to include them at all. It would be nice if we had memory backed res:// support.\r\n\r\nOne interesting thing to note is that there is a race condition in `_parse_image_save_image` with \"Materials -> Unpack Enabled\" set to true (i.e. the implicit default) even before https://github.com/godotengine/godot/pull/96778. On first run the blender gltf export will create `textures` directory which will not be scanned by the time we try to parse it, so `EditorFileSystem::get_singleton()->reimport_append` will not find those files. On the import we will load the textures directly and on the second re-import the folder will be found and the resource linkage succeeds.","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2475100484/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2480505046","html_url":"https://github.com/godotengine/godot/pull/98909#issuecomment-2480505046","issue_url":"https://api.github.com/repos/godotengine/godot/issues/98909","id":2480505046,"node_id":"IC_kwDOAO6SJc6T2YDW","user":{"login":"demolke","id":153469044,"node_id":"U_kgDOCSXAdA","avatar_url":"https://avatars.githubusercontent.com/u/153469044?v=4","gravatar_id":"","url":"https://api.github.com/users/demolke","html_url":"https://github.com/demolke","followers_url":"https://api.github.com/users/demolke/followers","following_url":"https://api.github.com/users/demolke/following{/other_user}","gists_url":"https://api.github.com/users/demolke/gists{/gist_id}","starred_url":"https://api.github.com/users/demolke/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/demolke/subscriptions","organizations_url":"https://api.github.com/users/demolke/orgs","repos_url":"https://api.github.com/users/demolke/repos","events_url":"https://api.github.com/users/demolke/events{/privacy}","received_events_url":"https://api.github.com/users/demolke/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2024-11-16T10:19:01Z","updated_at":"2024-11-16T10:19:01Z","body":"Actually adding the `DirAccess` interface to `FileAccessMemory` wasn't that hard, so have done that to make the tests self-contained. I've left it separated in a different commit for easier review.","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2480505046/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2486886084","html_url":"https://github.com/godotengine/godot/pull/98909#issuecomment-2486886084","issue_url":"https://api.github.com/repos/godotengine/godot/issues/98909","id":2486886084,"node_id":"IC_kwDOAO6SJc6UOt7E","user":{"login":"demolke","id":153469044,"node_id":"U_kgDOCSXAdA","avatar_url":"https://avatars.githubusercontent.com/u/153469044?v=4","gravatar_id":"","url":"https://api.github.com/users/demolke","html_url":"https://github.com/demolke","followers_url":"https://api.github.com/users/demolke/followers","following_url":"https://api.github.com/users/demolke/following{/other_user}","gists_url":"https://api.github.com/users/demolke/gists{/gist_id}","starred_url":"https://api.github.com/users/demolke/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/demolke/subscriptions","organizations_url":"https://api.github.com/users/demolke/orgs","repos_url":"https://api.github.com/users/demolke/repos","events_url":"https://api.github.com/users/demolke/events{/privacy}","received_events_url":"https://api.github.com/users/demolke/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2024-11-19T22:32:09Z","updated_at":"2024-11-19T22:32:09Z","body":"Friendly bump @aaronfranke ","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2486886084/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2497353629","html_url":"https://github.com/godotengine/godot/pull/98909#issuecomment-2497353629","issue_url":"https://api.github.com/repos/godotengine/godot/issues/98909","id":2497353629,"node_id":"IC_kwDOAO6SJc6U2ped","user":{"login":"aaronfranke","id":1646875,"node_id":"MDQ6VXNlcjE2NDY4NzU=","avatar_url":"https://avatars.githubusercontent.com/u/1646875?v=4","gravatar_id":"","url":"https://api.github.com/users/aaronfranke","html_url":"https://github.com/aaronfranke","followers_url":"https://api.github.com/users/aaronfranke/followers","following_url":"https://api.github.com/users/aaronfranke/following{/other_user}","gists_url":"https://api.github.com/users/aaronfranke/gists{/gist_id}","starred_url":"https://api.github.com/users/aaronfranke/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/aaronfranke/subscriptions","organizations_url":"https://api.github.com/users/aaronfranke/orgs","repos_url":"https://api.github.com/users/aaronfranke/repos","events_url":"https://api.github.com/users/aaronfranke/events{/privacy}","received_events_url":"https://api.github.com/users/aaronfranke/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2024-11-25T09:11:44Z","updated_at":"2024-11-25T09:16:48Z","body":"Apologies for the delay. I re-tested the PR and it's the same behavior as I described above here https://github.com/godotengine/godot/pull/98909#pullrequestreview-2422354127\r\n\r\nAdditionally:\r\n* The changes outside of the GLTF module are out-of-scope and must be made as a separate PR. We can't have a GLTF PR modifying `core/os/os.h`.\r\n* This PR has been modified to include [PR #96782](https://github.com/godotengine/godot/pull/96782), so [PR #96782](https://github.com/godotengine/godot/pull/96782) should be merged first. As far as I know [PR #96782](https://github.com/godotengine/godot/pull/96782) is all good, the bug trying to be fixed here is related but ultimately tangental to it.\r\n\r\nAs for the discussion on RocketChat about the importance of fixing this regression, I agree. Worst case scenario we can revert just the second commit in [PR #96778 as described here](https://github.com/godotengine/godot/pull/96778#issuecomment-2446425221), but I think we can find a better solution thanks to your efforts.","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2497353629/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2502205556","html_url":"https://github.com/godotengine/godot/pull/98909#issuecomment-2502205556","issue_url":"https://api.github.com/repos/godotengine/godot/issues/98909","id":2502205556,"node_id":"IC_kwDOAO6SJc6VJKB0","user":{"login":"demolke","id":153469044,"node_id":"U_kgDOCSXAdA","avatar_url":"https://avatars.githubusercontent.com/u/153469044?v=4","gravatar_id":"","url":"https://api.github.com/users/demolke","html_url":"https://github.com/demolke","followers_url":"https://api.github.com/users/demolke/followers","following_url":"https://api.github.com/users/demolke/following{/other_user}","gists_url":"https://api.github.com/users/demolke/gists{/gist_id}","starred_url":"https://api.github.com/users/demolke/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/demolke/subscriptions","organizations_url":"https://api.github.com/users/demolke/orgs","repos_url":"https://api.github.com/users/demolke/repos","events_url":"https://api.github.com/users/demolke/events{/privacy}","received_events_url":"https://api.github.com/users/demolke/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2024-11-26T23:52:03Z","updated_at":"2024-11-27T00:12:30Z","body":"> Apologies for the delay. I re-tested the PR and it's the same behavior as I described above here [#98909 (review)](https://github.com/godotengine/godot/pull/98909#pullrequestreview-2422354127)\r\n\r\nSorry about that - should be fixed now, I've added a test that captures running gltf import from `.godot/imported` to make the handling explicit.\r\n\r\n> The changes outside of the GLTF module are out-of-scope and must be made as a separate PR. We can't have a GLTF PR modifying `core/os/os.h`.\r\n\r\nRemoved the in-memory DirAccess and the test changes.\r\n\r\nI need to keep the other changes outside of gltf to\r\n\r\n- `editor/*` to handle the memory cleanup to make sanitizers happy. \r\n- `core/config/engine.h` to add a hint if we're running tests similar to editor hint. The way the texture import happens within existing import for embedded resources is quite hard to set up the same way - see the change to `editor/editor_file_system.cpp`. I wonder if the assert (`!importing`) has to be there in the first place, but it's quite hard to gauge what the side effect would be.\r\n\r\n>  This PR has been modified to include [PR #96782](https://github.com/godotengine/godot/pull/96782), so [PR #96782](https://github.com/godotengine/godot/pull/96782) should be merged first. As far as I know [PR #96782](https://github.com/godotengine/godot/pull/96782) is all good, the bug trying to be fixed here is related but ultimately tangental to it.\r\n\r\nYeah, I was not planning on leaving that in, had it there for testing, removed it now.\r\n\r\n> As for the discussion on RocketChat about the importance of fixing this regression, I agree. Worst case scenario we can revert just the second commit in [PR #96778 as described here](https://github.com/godotengine/godot/pull/96778#issuecomment-2446425221), but I think we can find a better solution thanks to your efforts.\r\n\r\n","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2502205556/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2508206278","html_url":"https://github.com/godotengine/godot/pull/98909#issuecomment-2508206278","issue_url":"https://api.github.com/repos/godotengine/godot/issues/98909","id":2508206278,"node_id":"IC_kwDOAO6SJc6VgDDG","user":{"login":"aaronfranke","id":1646875,"node_id":"MDQ6VXNlcjE2NDY4NzU=","avatar_url":"https://avatars.githubusercontent.com/u/1646875?v=4","gravatar_id":"","url":"https://api.github.com/users/aaronfranke","html_url":"https://github.com/aaronfranke","followers_url":"https://api.github.com/users/aaronfranke/followers","following_url":"https://api.github.com/users/aaronfranke/following{/other_user}","gists_url":"https://api.github.com/users/aaronfranke/gists{/gist_id}","starred_url":"https://api.github.com/users/aaronfranke/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/aaronfranke/subscriptions","organizations_url":"https://api.github.com/users/aaronfranke/orgs","repos_url":"https://api.github.com/users/aaronfranke/repos","events_url":"https://api.github.com/users/aaronfranke/events{/privacy}","received_events_url":"https://api.github.com/users/aaronfranke/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2024-11-29T17:48:34Z","updated_at":"2024-11-29T17:48:34Z","body":"I tested this PR and it works correctly now. The code makes sense and a quick review of the test cases looks good. I like how it tests the full editor import pipeline. The call to `unregister_all_gltf_document_extensions` is a bit unfortunate since it removes our ability to unit test extensions like physics from then on, however we can just ensure that any tests for glTF extensions run before the tests added by this PR.\r\n\r\nThe main thing is that the non-GLTF changes should be in their own PR, including `core/`, `engine/`, and the relevant lines in the `tests/` folder like `Engine::get_singleton()->set_tests_hint(true);`, and then that separate PR should be reviewed by the godotengine/core and godotengine/tests teams.","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2508206278/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2508653493","html_url":"https://github.com/godotengine/godot/pull/98909#issuecomment-2508653493","issue_url":"https://api.github.com/repos/godotengine/godot/issues/98909","id":2508653493,"node_id":"IC_kwDOAO6SJc6VhwO1","user":{"login":"demolke","id":153469044,"node_id":"U_kgDOCSXAdA","avatar_url":"https://avatars.githubusercontent.com/u/153469044?v=4","gravatar_id":"","url":"https://api.github.com/users/demolke","html_url":"https://github.com/demolke","followers_url":"https://api.github.com/users/demolke/followers","following_url":"https://api.github.com/users/demolke/following{/other_user}","gists_url":"https://api.github.com/users/demolke/gists{/gist_id}","starred_url":"https://api.github.com/users/demolke/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/demolke/subscriptions","organizations_url":"https://api.github.com/users/demolke/orgs","repos_url":"https://api.github.com/users/demolke/repos","events_url":"https://api.github.com/users/demolke/events{/privacy}","received_events_url":"https://api.github.com/users/demolke/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2024-11-29T20:50:14Z","updated_at":"2024-11-30T00:01:26Z","body":"> The call to `unregister_all_gltf_document_extensions` is a bit unfortunate since it removes our ability to unit test extensions like physics from then on, however we can just ensure that any tests for glTF extensions run before the tests added by this PR.\r\n\r\nActually turns out it's no longer necessary - it was needed back when I introduced the tests, but it's able to find the right nodes after this PR without the unregistration.\r\n\r\n> The main thing is that the non-GLTF changes should be in their own PR, including `core/`, `engine/`, and the relevant lines in the `tests/` folder like `Engine::get_singleton()->set_tests_hint(true);`, and then that separate PR should be reviewed by the godotengine/core and godotengine/tests teams.\r\n\r\nI did split it now\r\n\r\nhttps://github.com/godotengine/godot/pull/99846\r\nhttps://github.com/godotengine/godot/pull/99847 \r\n~~https://github.com/godotengine/godot/pull/99848~~ https://github.com/godotengine/godot/pull/99858\r\n\r\nbut it feels the individual PRs lack context and when someone is going to investigate the reason for the changes, they just end up here anyway.\r\n\r\n(this change now has four commits because it can't work without the prerequisites, but once the other PRs get merged it will be back to one commit)","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2508653493/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2552206210","html_url":"https://github.com/godotengine/godot/pull/98909#issuecomment-2552206210","issue_url":"https://api.github.com/repos/godotengine/godot/issues/98909","id":2552206210,"node_id":"IC_kwDOAO6SJc6YH5OC","user":{"login":"demolke","id":153469044,"node_id":"U_kgDOCSXAdA","avatar_url":"https://avatars.githubusercontent.com/u/153469044?v=4","gravatar_id":"","url":"https://api.github.com/users/demolke","html_url":"https://github.com/demolke","followers_url":"https://api.github.com/users/demolke/followers","following_url":"https://api.github.com/users/demolke/following{/other_user}","gists_url":"https://api.github.com/users/demolke/gists{/gist_id}","starred_url":"https://api.github.com/users/demolke/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/demolke/subscriptions","organizations_url":"https://api.github.com/users/demolke/orgs","repos_url":"https://api.github.com/users/demolke/repos","events_url":"https://api.github.com/users/demolke/events{/privacy}","received_events_url":"https://api.github.com/users/demolke/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2024-12-18T20:25:58Z","updated_at":"2024-12-18T20:25:58Z","body":"Thanks for the review and the suggestions.","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2552206210/reactions","total_count":1,"+1":0,"-1":0,"laugh":0,"hooray":1,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2574004850","html_url"