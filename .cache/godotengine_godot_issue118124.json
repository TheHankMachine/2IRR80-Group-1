b","name":"platform:web","color":"e4e4e4","default":false,"description":"","archived_at":null,"archived_by":null},{"id":279098255,"node_id":"MDU6TGFiZWwyNzkwOTgyNTU=","url":"https://api.github.com/repos/godotengine/godot/labels/topic:platforms","name":"topic:platforms","color":"ffee88","default":false,"description":"","archived_at":null,"archived_by":null},{"id":709269775,"node_id":"MDU6TGFiZWw3MDkyNjk3NzU=","url":"https://api.github.com/repos/godotengine/godot/labels/topic:dotnet","name":"topic:dotnet","color":"ffee88","default":false,"description":"","archived_at":null,"archived_by":null}],"state":"open","locked":false,"assignees":[],"milestone":{"url":"https://api.github.com/repos/godotengine/godot/milestones/14","html_url":"https://github.com/godotengine/godot/milestone/14","labels_url":"https://api.github.com/repos/godotengine/godot/milestones/14/labels","id":7806203,"node_id":"MI_kwDOAO6SJc4Adxz7","number":14,"title":"3.x","description":"Issues and pull requests slated for an undetermined Godot 3 release.","creator":{"login":"akien-mga","id":4701338,"node_id":"MDQ6VXNlcjQ3MDEzMzg=","avatar_url":"https://avatars.githubusercontent.com/u/4701338?v=4","gravatar_id":"","url":"https://api.github.com/users/akien-mga","html_url":"https://github.com/akien-mga","followers_url":"https://api.github.com/users/akien-mga/followers","following_url":"https://api.github.com/users/akien-mga/following{/other_user}","gists_url":"https://api.github.com/users/akien-mga/gists{/gist_id}","starred_url":"https://api.github.com/users/akien-mga/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/akien-mga/subscriptions","organizations_url":"https://api.github.com/users/akien-mga/orgs","repos_url":"https://api.github.com/users/akien-mga/repos","events_url":"https://api.github.com/users/akien-mga/events{/privacy}","received_events_url":"https://api.github.com/users/akien-mga/received_events","type":"User","user_view_type":"public","site_admin":false},"open_issues":1264,"closed_issues":0,"state":"open","created_at":"2022-03-26T10:06:00Z","updated_at":"2026-10-20T07:55:25Z","due_on":null,"closed_at":null},"comments":0,"created_at":"2026-04-02T18:07:24Z","updated_at":"2026-08-20T17:55:59Z","closed_at":null,"assignee":null,"author_association":"NONE","issue_field_values":[],"type":null,"active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"### Tested versions\n\nReproducible in 3.6.2, 3.7-dev1\n\n### System information\n\nWindows 11, Firefox\n\n### Issue description\n\nAfter creating a thread via Task.Run or ThreadPool.UnsafeQueueUserWorkItem the current ApplicationDomain permanently switches from GodotEngine.Domain.Scripts to mono, which results in weird and hard to debug issues, such as:\n\n- Static field reset\n- Type duplication\n- WebRTC breaking with uninformative error messages\n\nWhile I know that C# HTML exports don't support multithreading, this kind of outcome when trying to use it makes it extremely difficult to debug. It would be best if in HTML exports Task.Run just executed immediately in the main thread (which it does now), but without changing current ApplicationDomain. If that's not possible, then at least some sensible error messages would be very helpful.\n\nIn my case, it took me very long to debug because:\n\n- I didn't know that using threads is not allowed in C# HTML exports. I suspected to see stuff like immediate execution / queuing on the main thread, but definitely not this.\n- I didn't even use threads in my own code, I just imported Microsoft.Extensions.DependencyInjection which happened to use it under the hood when resolving the same service ***twice***\n- Error message were very cryptic and uninformative\n\n### Steps to reproduce\n\nCall Task.Run or ThreadPool.UnsafeQueueUserWorkItem anywhere, then all future lifetime events and signal callbacks will execute in mono AppDomain.\n\n### Minimal reproduction project (MRP)\n\n[ApplicationDomainSwitchAfterTaskRun.zip](https://github.com/user-attachments/files/26445680/ApplicationDomainSwitchAfterTaskRun.zip)","closed_by":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/118124/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/godotengine/godot/issues/118124/timeline","performed_via_github_app":null,"state_reason":null,"pinned_comment":null}