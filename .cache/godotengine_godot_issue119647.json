,"node_id":"MDU6TGFiZWwzMjQwOTUwMDYw","url":"https://api.github.com/repos/godotengine/godot/labels/performance","name":"performance","color":"447777","default":false,"description":"","archived_at":null,"archived_by":null}],"state":"open","locked":false,"assignees":[],"milestone":{"url":"https://api.github.com/repos/godotengine/godot/milestones/16","html_url":"https://github.com/godotengine/godot/milestone/16","labels_url":"https://api.github.com/repos/godotengine/godot/milestones/16/labels","id":8237783,"node_id":"MI_kwDOAO6SJc4AfbLX","number":16,"title":"4.x","description":"Issues and pull requests slated for an undetermined Godot 4 release.","creator":{"login":"akien-mga","id":4701338,"node_id":"MDQ6VXNlcjQ3MDEzMzg=","avatar_url":"https://avatars.githubusercontent.com/u/4701338?v=4","gravatar_id":"","url":"https://api.github.com/users/akien-mga","html_url":"https://github.com/akien-mga","followers_url":"https://api.github.com/users/akien-mga/followers","following_url":"https://api.github.com/users/akien-mga/following{/other_user}","gists_url":"https://api.github.com/users/akien-mga/gists{/gist_id}","starred_url":"https://api.github.com/users/akien-mga/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/akien-mga/subscriptions","organizations_url":"https://api.github.com/users/akien-mga/orgs","repos_url":"https://api.github.com/users/akien-mga/repos","events_url":"https://api.github.com/users/akien-mga/events{/privacy}","received_events_url":"https://api.github.com/users/akien-mga/received_events","type":"User","user_view_type":"public","site_admin":false},"open_issues":5791,"closed_issues":0,"state":"open","created_at":"2022-07-26T12:42:05Z","updated_at":"2026-10-21T22:40:26Z","due_on":null,"closed_at":null},"comments":4,"created_at":"2026-05-22T04:45:32Z","updated_at":"2026-06-28T10:14:30Z","closed_at":null,"assignee":null,"author_association":"NONE","issue_field_values":[],"type":null,"active_lock_reason":null,"draft":false,"pull_request":{"url":"https://api.github.com/repos/godotengine/godot/pulls/119647","html_url":"https://github.com/godotengine/godot/pull/119647","diff_url":"https://github.com/godotengine/godot/pull/119647.diff","patch_url":"https://github.com/godotengine/godot/pull/119647.patch","merged_at":null},"body":"## What problem(s) does this PR solve?\r\n\r\nCurrent Godot SCons implementation heavily uses non-trivial python function actions.\r\nIn general this is not advised by the SCons project for a couple reasons:\r\n1) GIL and other issues will reduce effective parallelism\r\n2) ninja builds will have to call back to SCons to run this logic, once again reducing parallelism as the call from ninja -> SCons is 1 at a time and not parallel.\r\n3) By switching to calling these functions as scripts, it will allow simpler debugging and testing of their functionality\r\n\r\n## Additional information\r\n\r\nGemini was used to help identify and apply the fix methodology to the code.\r\nThere was review of all the Gemini driven code changes, and in some case manual edits after review.\r\n\r\nUser Diamond from SCons discord has doe some benchmarking of earlier versions of these changes.\r\nHopefully he'll paste them in a comment.\r\n\r\nNote there are a small handful of additional python function actions to be converted before this PR is complete","closed_by":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/119647/reactions","total_count":13,"+1":4,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":5,"eyes":4},"timeline_url":"https://api.github.com/repos/godotengine/godot/issues/119647/timeline","performed_via_github_app":null,"state_reason":null}