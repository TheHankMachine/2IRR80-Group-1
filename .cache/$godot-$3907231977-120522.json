l":"https://avatars.githubusercontent.com/u/2308167?u=f7f8e0273f784f5ec6f6b7fe4a88d449896eb48a&v=4","created_at":"0001-01-01T00:00:00Z","followers":0,"following":0,"html_url":"https://github.com/Ivorforce","id":2308167,"node_id":"MDQ6VXNlcjIzMDgxNjc=","login":"Ivorforce","type":"User","owned_private_repos":0,"public_gists":0,"public_repos":0,"total_private_repos":0,"url":"https://api.github.com/users/Ivorforce"},"body":"","html_url":"https://github.com/godotengine/godot/pull/120522#pullrequestreview-4608647099","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/120522","author_association":"MEMBER","submitted_at":"2026-07-01T11:54:02Z"},{"id":4608674375,"node_id":"PRR_kwDOAO6SJc8AAAABErLKRw","state":"COMMENTED","commit_id":"0399a779d277739bbdba6e5439dc9ad9afb116dc","user":{"site_admin":false,"suspended":false,"updated_at":"0001-01-01T00:00:00Z","avatar_url":"https://avatars.githubusercontent.com/u/190293561?u=081190c3a30acaf77c8531e0c6b9dae737767f58&v=4","created_at":"0001-01-01T00:00:00Z","followers":0,"following":0,"html_url":"https://github.com/NoNormalDev","id":190293561,"node_id":"U_kgDOC1emOQ","login":"NoNormalDev","type":"User","owned_private_repos":0,"public_gists":0,"public_repos":0,"total_private_repos":0,"url":"https://api.github.com/users/NoNormalDev"},"body":"","html_url":"https://github.com/godotengine/godot/pull/120522#pullrequestreview-4608674375","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/120522","author_association":"CONTRIBUTOR","submitted_at":"2026-07-01T11:57:38Z"},{"id":5002214241,"node_id":"PRR_kwDOAO6SJc8AAAABKie7YQ","state":"COMMENTED","commit_id":"0399a779d277739bbdba6e5439dc9ad9afb116dc","user":{"site_admin":false,"suspended":false,"updated_at":"0001-01-01T00:00:00Z","avatar_url":"https://avatars.githubusercontent.com/u/190293561?u=081190c3a30acaf77c8531e0c6b9dae737767f58&v=4","created_at":"0001-01-01T00:00:00Z","followers":0,"following":0,"html_url":"https://github.com/NoNormalDev","id":190293561,"node_id":"U_kgDOC1emOQ","login":"NoNormalDev","type":"User","owned_private_repos":0,"public_gists":0,"public_repos":0,"total_private_repos":0,"url":"https://api.github.com/users/NoNormalDev"},"body":"","html_url":"https://github.com/godotengine/godot/pull/120522#pullrequestreview-5002214241","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/120522","author_association":"CONTRIBUTOR","submitted_at":"2026-08-23T10:51:42Z"},{"id":5087689477,"node_id":"PRR_kwDOAO6SJc8AAAABLz_7BQ","state":"CHANGES_REQUESTED","commit_id":"f1bf788ae50eb8d23e9b1992073bf3656e9ea928","user":{"site_admin":false,"suspended":false,"updated_at":"0001-01-01T00:00:00Z","avatar_url":"https://avatars.githubusercontent.com/u/708488?v=4","created_at":"0001-01-01T00:00:00Z","followers":0,"following":0,"html_url":"https://github.com/Bromeon","id":708488,"node_id":"MDQ6VXNlcjcwODQ4OA==","login":"Bromeon","type":"User","owned_private_repos":0,"public_gists":0,"public_repos":0,"total_private_repos":0,"url":"https://api.github.com/users/Bromeon"},"body":"While I see the problem described in #120521, I don't think this PR is the right approach.\r\n\r\n- **Current** API uses `uint16_t` for port, i.e. `0..65535` -- this is _exactly_ the valid range.\r\n- **New** API in this PR uses `int64_t` instead, i.e. `-9223372036854775808..9223372036854775807`, far too wide.\r\n- The new range weakens type safety across GDExtension and C# bindings.\r\n\r\nThe problem is not that the current API is wrong. But rather:\r\n1. GDScript does not have a `uint16_t` type.\r\n2. There is no engine validation happening when casting a wider type (like `int64_t`) _into_ a narrower type, instead silently converting.\r\n\r\nThe PR here fights a symptom of this rather than the underlying issue (2), and it makes APIs actively worse in GDExtension and C#, which previously could rely on compile-time type safety.\r\n\r\nThe argument from #120521 technically applies to _all_ Godot APIs that use a `meta`  annotation to narrow a parameter/return type (here `uint16_t`): \"Since GDScript allows silent conversions, we need to use a wider type and runtime-check\". But this defeats type safety; the conclusion should be \"we need to fix silent conversions for APIs that explicitly require a narrow type\".\r\n\r\nEdit: I changed the PR title because this is primarily an API change, not an additional check.","html_url":"https://github.com/godotengine/godot/pull/120522#pullrequestreview-5087689477","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/120522","author_association":"CONTRIBUTOR","submitted_at":"2026-09-02T09:05:52Z"}]