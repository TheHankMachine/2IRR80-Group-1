ainteiners will use another or want to keep the current","closed_by":{"login":"RgeditV1","id":63971812,"node_id":"MDQ6VXNlcjYzOTcxODEy","avatar_url":"https://avatars.githubusercontent.com/u/63971812?v=4","gravatar_id":"","url":"https://api.github.com/users/RgeditV1","html_url":"https://github.com/RgeditV1","followers_url":"https://api.github.com/users/RgeditV1/followers","following_url":"https://api.github.com/users/RgeditV1/following{/other_user}","gists_url":"https://api.github.com/users/RgeditV1/gists{/gist_id}","starred_url":"https://api.github.com/users/RgeditV1/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/RgeditV1/subscriptions","organizations_url":"https://api.github.com/users/RgeditV1/orgs","repos_url":"https://api.github.com/users/RgeditV1/repos","events_url":"https://api.github.com/users/RgeditV1/events{/privacy}","received_events_url":"https://api.github.com/users/RgeditV1/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/119031/reactions","total_count":4,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":3,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/godotengine/godot/issues/119031/timeline","performed_via_github_app":null,"state_reason":null}