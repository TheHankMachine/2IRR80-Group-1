9,"node_id":"MDU6TGFiZWwyNjY2NzA4Mjg5","url":"https://api.github.com/repos/godotengine/godot/labels/topic:3d","name":"topic:3d","color":"ffee88","default":false,"description":"","archived_at":null,"archived_by":null}],"state":"open","locked":false,"assignees":[],"milestone":{"url":"https://api.github.com/repos/godotengine/godot/milestones/16","html_url":"https://github.com/godotengine/godot/milestone/16","labels_url":"https://api.github.com/repos/godotengine/godot/milestones/16/labels","id":8237783,"node_id":"MI_kwDOAO6SJc4AfbLX","number":16,"title":"4.x","description":"Issues and pull requests slated for an undetermined Godot 4 release.","creator":{"login":"akien-mga","id":4701338,"node_id":"MDQ6VXNlcjQ3MDEzMzg=","avatar_url":"https://avatars.githubusercontent.com/u/4701338?v=4","gravatar_id":"","url":"https://api.github.com/users/akien-mga","html_url":"https://github.com/akien-mga","followers_url":"https://api.github.com/users/akien-mga/followers","following_url":"https://api.github.com/users/akien-mga/following{/other_user}","gists_url":"https://api.github.com/users/akien-mga/gists{/gist_id}","starred_url":"https://api.github.com/users/akien-mga/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/akien-mga/subscriptions","organizations_url":"https://api.github.com/users/akien-mga/orgs","repos_url":"https://api.github.com/users/akien-mga/repos","events_url":"https://api.github.com/users/akien-mga/events{/privacy}","received_events_url":"https://api.github.com/users/akien-mga/received_events","type":"User","user_view_type":"public","site_admin":false},"open_issues":5791,"closed_issues":0,"state":"open","created_at":"2022-07-26T12:42:05Z","updated_at":"2026-10-21T22:40:26Z","due_on":null,"closed_at":null},"comments":0,"created_at":"2026-02-11T02:17:47Z","updated_at":"2026-02-17T20:09:44Z","closed_at":null,"assignee":null,"author_association":"NONE","issue_field_values":[],"type":null,"active_lock_reason":null,"draft":false,"pull_request":{"url":"https://api.github.com/repos/godotengine/godot/pulls/116158","html_url":"https://github.com/godotengine/godot/pull/116158","diff_url":"https://github.com/godotengine/godot/pull/116158.diff","patch_url":"https://github.com/godotengine/godot/pull/116158.patch","merged_at":null},"body":"In Blender, it is easy to accidentally change the active collection, breaking imports when \"active_collection_only\" is enabled. This new setting can be used instead to ensure that the same collection gets exported every time.\r\n\r\nWhen importing a model via Blender, providing a string to this setting causes Blender to export only the contents of the specified collection. This makes Godot's import settings more consistent with Blender's GLTF export settings, and has parity with Godot's \"blender/nodes/active_collection_only\" import setting.\r\n\r\nThis setting is supported in Blender 4.2+. Prior to 4.2, it does nothing. \r\n\r\nTests:\r\n- Tested in Blender 4.1 and 4.2.\r\n- Tested with a model with and without a collection with the specified name. \r\n- Tested with an animated, skinned character with a skeleton and animations. \r\n- Tested with the setting disabled.\r\n- Tested with both \"Active Collection Only\" and \"Named Collection Only\" enabled. The latter takes precedence, which is the underlying functionality of the Blender GLTF export API.\r\n\r\nCloses: https://github.com/godotengine/godot-proposals/issues/14151","closed_by":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/116158/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/godotengine/godot/issues/116158/timeline","performed_via_github_app":null,"state_reason":null}