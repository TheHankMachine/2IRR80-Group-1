":"MDU6TGFiZWwyNzkwOTgyMTk=","url":"https://api.github.com/repos/godotengine/godot/labels/topic:editor","name":"topic:editor","color":"ffee88","default":false,"description":"","archived_at":null,"archived_by":null},{"id":3240950060,"node_id":"MDU6TGFiZWwzMjQwOTUwMDYw","url":"https://api.github.com/repos/godotengine/godot/labels/performance","name":"performance","color":"447777","default":false,"description":"","archived_at":null,"archived_by":null}],"state":"closed","locked":false,"assignees":[],"milestone":{"url":"https://api.github.com/repos/godotengine/godot/milestones/25","html_url":"https://github.com/godotengine/godot/milestone/25","labels_url":"https://api.github.com/repos/godotengine/godot/milestones/25/labels","id":15520464,"node_id":"MI_kwDOAO6SJc4A7NLQ","number":25,"title":"4.8","description":"","creator":{"login":"Repiteo","id":17489292,"node_id":"MDQ6VXNlcjE3NDg5Mjky","avatar_url":"https://avatars.githubusercontent.com/u/17489292?v=4","gravatar_id":"","url":"https://api.github.com/users/Repiteo","html_url":"https://github.com/Repiteo","followers_url":"https://api.github.com/users/Repiteo/followers","following_url":"https://api.github.com/users/Repiteo/following{/other_user}","gists_url":"https://api.github.com/users/Repiteo/gists{/gist_id}","starred_url":"https://api.github.com/users/Repiteo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Repiteo/subscriptions","organizations_url":"https://api.github.com/users/Repiteo/orgs","repos_url":"https://api.github.com/users/Repiteo/repos","events_url":"https://api.github.com/users/Repiteo/events{/privacy}","received_events_url":"https://api.github.com/users/Repiteo/received_events","type":"User","user_view_type":"public","site_admin":false},"open_issues":343,"closed_issues":2335,"state":"open","created_at":"2026-04-13T15:59:35Z","updated_at":"2026-10-22T06:28:22Z","due_on":null,"closed_at":null},"comments":1,"created_at":"2026-07-29T06:29:54Z","updated_at":"2026-07-29T18:12:56Z","closed_at":"2026-07-29T17:25:30Z","assignee":null,"author_association":"MEMBER","issue_field_values":[],"type":null,"active_lock_reason":null,"draft":false,"pull_request":{"url":"https://api.github.com/repos/godotengine/godot/pulls/121879","html_url":"https://github.com/godotengine/godot/pull/121879","diff_url":"https://github.com/godotengine/godot/pull/121879.diff","patch_url":"https://github.com/godotengine/godot/pull/121879.patch","merged_at":"2026-07-29T17:25:30Z"},"body":"This does two major optimizations for gizmos:\r\n1. Defer `optimize_incremental()` to only be called at most once per frame for Node3DEditor BVH. Previously it was called any time any gizmo was updated. `optimize_incremental()` is an expensive operation and should only be done once all updates have finished\r\n2. Use the existing TriangleMesh AABB instead of transforming every vertex and re-calculating the AABB. This was extremely expensive for big meshes. (I looked into this at the request of @tdaven who has been having issues with the performance here)\r\n\r\nA bonus optimization, I switched to using the global position of the node when originally inserting into the BVH. This helps avoid collisions at insertion time (and is technically more correct, since it makes no sense to use the local position).\r\n\r\nIn the MRP in https://github.com/godotengine/godot/issues/107123, the time spent updating the BVH goes from 9.2 seconds to 1.8 seconds with no change in behaviour (combined with https://github.com/godotengine/godot/pull/109514, loading that scene becomes instant).\r\n\r\nI also tested loading a single very large mesh and measured an improvement of about 100 ms in the BVH update function (140ms->40ms). But I would like to see if it benefits @tdaven's game even more. Since I struggled to make an MRP that really stressed that part of the function \r\n\r\n## What problem(s) does this PR solve?\r\n\r\n- Fixes a major performance regression from https://github.com/godotengine/godot/pull/94553\r\n- Fixes: https://github.com/godotengine/godot/issues/107123\r\n\r\n## Additional information\r\n\r\nSupersedes: https://github.com/godotengine/godot/pull/98590\r\nKind of a follow up to https://github.com/godotengine/godot/pull/96934 since it addresses many of the performance issues that https://github.com/godotengine/godot/pull/96934 solved for PlaneMesh.\r\n","closed_by":{"login":"Repiteo","id":17489292,"node_id":"MDQ6VXNlcjE3NDg5Mjky","avatar_url":"https://avatars.githubusercontent.com/u/17489292?v=4","gravatar_id":"","url":"https://api.github.com/users/Repiteo","html_url":"https://github.com/Repiteo","followers_url":"https://api.github.com/users/Repiteo/followers","following_url":"https://api.github.com/users/Repiteo/following{/other_user}","gists_url":"https://api.github.com/users/Repiteo/gists{/gist_id}","starred_url":"https://api.github.com/users/Repiteo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Repiteo/subscriptions","organizations_url":"https://api.github.com/users/Repiteo/orgs","repos_url":"https://api.github.com/users/Repiteo/repos","events_url":"https://api.github.com/users/Repiteo/events{/privacy}","received_events_url":"https://api.github.com/users/Repiteo/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/121879/reactions","total_count":7,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":6,"eyes":0},"timeline_url":"https://api.github.com/repos/godotengine/godot/issues/121879/timeline","performed_via_github_app":null,"state_reason":null}