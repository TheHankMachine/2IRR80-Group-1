:02Z","updated_at":"2026-04-26T14:44:02Z","html_url":"https://github.com/godotengine/godot/pull/118964#discussion_r3143647445","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/118964","_links":{"self":{"href":"https://api.github.com/repos/godotengine/godot/pulls/comments/3143647445"},"html":{"href":"https://github.com/godotengine/godot/pull/118964#discussion_r3143647445"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/118964"}},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/3143647445/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":null,"original_line":73,"side":"RIGHT","in_reply_to_id":3143470195,"author_association":"MEMBER","original_position":6,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/3143668315","pull_request_review_id":4177067128,"id":3143668315,"node_id":"PRRC_kwDOAO6SJc67YJJb","diff_hunk":"@@ -68,6 +68,30 @@ Error PacketPeerUDP::leave_multicast_group(IPAddress p_multi_address, const Stri\n \treturn _sock->leave_multicast_group(p_multi_address, p_if_name);\n }\n \n+Error PacketPeerUDP::set_multicast_send_interface(const String &p_if_name) {\n+\tERR_FAIL_COND_V(_sock.is_null(), ERR_UNAVAILABLE);\n+    ERR_FAIL_COND_V(!_sock.is_valid(), ERR_UNCONFIGURED);","path":"core/io/packet_peer_udp.cpp","commit_id":"99f71b3d50c60391a276505778d3daadcf9b70da","original_commit_id":"99f71b3d50c60391a276505778d3daadcf9b70da","user":{"login":"alexfacciorusso","id":4479527,"node_id":"MDQ6VXNlcjQ0Nzk1Mjc=","avatar_url":"https://avatars.githubusercontent.com/u/4479527?v=4","gravatar_id":"","url":"https://api.github.com/users/alexfacciorusso","html_url":"https://github.com/alexfacciorusso","followers_url":"https://api.github.com/users/alexfacciorusso/followers","following_url":"https://api.github.com/users/alexfacciorusso/following{/other_user}","gists_url":"https://api.github.com/users/alexfacciorusso/gists{/gist_id}","starred_url":"https://api.github.com/users/alexfacciorusso/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/alexfacciorusso/subscriptions","organizations_url":"https://api.github.com/users/alexfacciorusso/orgs","repos_url":"https://api.github.com/users/alexfacciorusso/repos","events_url":"https://api.github.com/users/alexfacciorusso/events{/privacy}","received_events_url":"https://api.github.com/users/alexfacciorusso/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"the code referenced in this comment was\r\n\r\n```\r\nERR_FAIL_COND_V(_sock.is_null(), ERR_UNAVAILABLE);\r\nERR_FAIL_COND_V(!_sock.is_valid(), ERR_UNCONFIGURED);\r\n```\r\n\r\nIf I read this code, it's checking:\r\n1. if the sock is null (e.g. not being set)\r\n2. if the sock is not valid\r\n\r\nwhich are two different checks, are they not?\r\n\r\nBy reading your comment:\r\n\r\n> But `_sock.is_null()` is the same as `!_sock.is_valid()`, what were you trying to do here?\r\n\r\nFrom a dev perspective, to me doing those two checks aren't the same, are they?\r\n\r\nBut again, my comment wasn't specifically about this PR (even though it happened to be this one by chance!) but in general on the approach: OP is trying to contribute, and was instead pushed to explain if, how and why they used AI to help themselves for this code. Again, I absolutely get we all want to stop AI slop, but it's also not nice for people who actually want to help to hear\r\n\r\n> Immediately here we find something that makes no sense\r\n\r\nand\r\n\r\n> indicates not understanding what the code actually does, which isn't a good start\r\n\r\nI incredibly respect Godot as a project and their maintainers, but my opinionated question is: is it right to treat potential contributors like that on the basis anybody thinks they used AI, and even if was AI, the AI did something a real human also would have done if they were contributors for the first time and didn't know 100% of the internal API functioning?","created_at":"2026-04-26T14:59:53Z","updated_at":"2026-04-26T15:00:39Z","html_url":"https://github.com/godotengine/godot/pull/118964#discussion_r3143668315","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/118964","_links":{"self":{"href":"https://api.github.com/repos/godotengine/godot/pulls/comments/3143668315"},"html":{"href":"https://github.com/godotengine/godot/pull/118964#discussion_r3143668315"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/118964"}},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/3143668315/reactions","total_count":3,"+1":2,"-1":0,"laugh":0,"hooray":0,"confused":1,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":null,"original_line":73,"side":"RIGHT","in_reply_to_id":3143470195,"author_association":"NONE","original_position":6,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/3143675983","pull_request_review_id":4177073210,"id":3143675983,"node_id":"PRRC_kwDOAO6SJc67YLBP","diff_hunk":"@@ -68,6 +68,30 @@ Error PacketPeerUDP::leave_multicast_group(IPAddress p_multi_address, const Stri\n \treturn _sock->leave_multicast_group(p_multi_address, p_if_name);\n }\n \n+Error PacketPeerUDP::set_multicast_send_interface(const String &p_if_name) {\n+\tERR_FAIL_COND_V(_sock.is_null(), ERR_UNAVAILABLE);\n+    ERR_FAIL_COND_V(!_sock.is_valid(), ERR_UNCONFIGURED);","path":"core/io/packet_peer_udp.cpp","commit_id":"99f71b3d50c60391a276505778d3daadcf9b70da","original_commit_id":"99f71b3d50c60391a276505778d3daadcf9b70da","user":{"login":"NoNormalDev","id":190293561,"node_id":"U_kgDOC1emOQ","avatar_url":"https://avatars.githubusercontent.com/u/190293561?v=4","gravatar_id":"","url":"https://api.github.com/users/NoNormalDev","html_