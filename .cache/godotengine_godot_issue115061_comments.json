to `~/Library/Fonts/` manually). But we probably should filter out fonts if no valid path regardless of it, Godot does not recognize either of these files if loaded directly.","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4647359470/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4647387964","html_url":"https://github.com/godotengine/godot/issues/115061#issuecomment-4647387964","issue_url":"https://api.github.com/repos/godotengine/godot/issues/115061","id":4647387964,"node_id":"IC_kwDOAO6SJc8AAAABFQGDPA","user":{"login":"bruvzg","id":7645683,"node_id":"MDQ6VXNlcjc2NDU2ODM=","avatar_url":"https://avatars.githubusercontent.com/u/7645683?v=4","gravatar_id":"","url":"https://api.github.com/users/bruvzg","html_url":"https://github.com/bruvzg","followers_url":"https://api.github.com/users/bruvzg/followers","following_url":"https://api.github.com/users/bruvzg/following{/other_user}","gists_url":"https://api.github.com/users/bruvzg/gists{/gist_id}","starred_url":"https://api.github.com/users/bruvzg/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/bruvzg/subscriptions","organizations_url":"https://api.github.com/users/bruvzg/orgs","repos_url":"https://api.github.com/users/bruvzg/repos","events_url":"https://api.github.com/users/bruvzg/events{/privacy}","received_events_url":"https://api.github.com/users/bruvzg/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-06-08T09:35:32Z","updated_at":"2026-06-08T09:35:32Z","body":"Actually, all files in both archives are zero size.","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4647387964/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4648251991","html_url":"https://github.com/godotengine/godot/issues/115061#issuecomment-4648251991","issue_url":"https://api.github.com/repos/godotengine/godot/issues/115061","id":4648251991,"node_id":"IC_kwDOAO6SJc8AAAABFQ6yVw","user":{"login":"lostminds","id":17763524,"node_id":"MDQ6VXNlcjE3NzYzNTI0","avatar_url":"https://avatars.githubusercontent.com/u/17763524?v=4","gravatar_id":"","url":"https://api.github.com/users/lostminds","html_url":"https://github.com/lostminds","followers_url":"https://api.github.com/users/lostminds/followers","following_url":"https://api.github.com/users/lostminds/following{/other_user}","gists_url":"https://api.github.com/users/lostminds/gists{/gist_id}","starred_url":"https://api.github.com/users/lostminds/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/lostminds/subscriptions","organizations_url":"https://api.github.com/users/lostminds/orgs","repos_url":"https://api.github.com/users/lostminds/repos","events_url":"https://api.github.com/users/lostminds/events{/privacy}","received_events_url":"https://api.github.com/users/lostminds/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-06-08T11:05:37Z","updated_at":"2026-06-08T11:05:37Z","body":"> macOS version? It is possible support for these were removed in 26. Since it does not install or show these fonts in Font Book or `OS.get_system_fonts()` (if added to `~/Library/Fonts/` manually). But we probably should filter out fonts if no valid path regardless of it, Godot does not recognize either of these files if loaded directly.\n\nIt is possible support was removed for these old format fonts in macOS 26. This is on macOS 15.7.5\n\n> Actually, all files in both archives are zero size.\n\nThey are not all zero size for me, even if I re-download the archives linked above. \n\n<img width=\"1364\" height=\"228\" alt=\"Image\" src=\"https://github.com/user-attachments/assets/31120827-427c-4793-9863-dd3e07b6f29f\" />\n\nCould it be some sort of resource-fork trickery? Since I'm guessing these are very old macOS font files (due to the missing file extension) it could be they have font data stored in the resource fork, which has been deprecated more or less since OS X. Perhaps macOS 26 finally got rid of support of even accessing this data, and therefore showing the file size as 0 for you? \n\nIn this case reading loading the font files is probably not really relevant, but at least they should be flagged as invalid and not included in the list of system fonts. ","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4648251991/reactions","total_count":1,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":1},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4648393025","html_url":"https://github.com/godotengine/godot/issues/115061#issuecomment-4648393025","issue_url":"https://api.github.com/repos/godotengine/godot/issues/115061","id":4648393025,"node_id":"IC_kwDOAO6SJc8AAAABFRDZQQ","user":{"login":"bruvzg","id":7645683,"node_id":"MDQ6VXNlcjc2NDU2ODM=","avatar_url":"https://avatars.githubusercontent.com/u/7645683?v=4","gravatar_id":"","url":"https://api.github.com/users/bruvzg","html_url":"https://github.com/bruvzg","followers_url":"https://api.github.com/users/bruvzg/followers","following_url":"https://api.github.com/users/bruvzg/following{/other_user}","gists_url":"https://api.github.com/users/bruvzg/gists{/gist_id}","starred_url":"https://api.github.com/users/bruvzg/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/bruvzg/subscriptions","organizations_url":"https://api.github.com/users/bruvzg/orgs","repos_url":"https://api.github.com/users/bruvzg/repos","events_url":"https://api.github.com/users/bruvzg/events{/privacy}","received_events_url":"https://api.github.com/users/bruvzg/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-06-08T11:16:35Z","updated_at":"2026-06-08T11:16:35Z","body":"Indeed, there seems to be some data in the resource fork (Finder do show size, `ls -l` does not). It's readable using `..namedfork/rsrc`, but might be unsupported by new version of Font Book (and definitely not supported by Godot).","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4648393025/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null}]