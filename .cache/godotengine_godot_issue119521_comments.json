[{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4472291653","html_url":"https://github.com/godotengine/godot/issues/119521#issuecomment-4472291653","issue_url":"https://api.github.com/repos/godotengine/godot/issues/119521","id":4472291653,"node_id":"IC_kwDOAO6SJc8AAAABCpHBRQ","user":{"login":"CreatedBySeb","id":11736217,"node_id":"MDQ6VXNlcjExNzM2MjE3","avatar_url":"https://avatars.githubusercontent.com/u/11736217?v=4","gravatar_id":"","url":"https://api.github.com/users/CreatedBySeb","html_url":"https://github.com/CreatedBySeb","followers_url":"https://api.github.com/users/CreatedBySeb/followers","following_url":"https://api.github.com/users/CreatedBySeb/following{/other_user}","gists_url":"https://api.github.com/users/CreatedBySeb/gists{/gist_id}","starred_url":"https://api.github.com/users/CreatedBySeb/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/CreatedBySeb/subscriptions","organizations_url":"https://api.github.com/users/CreatedBySeb/orgs","repos_url":"https://api.github.com/users/CreatedBySeb/repos","events_url":"https://api.github.com/users/CreatedBySeb/events{/privacy}","received_events_url":"https://api.github.com/users/CreatedBySeb/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-05-17T19:41:14Z","updated_at":"2026-05-17T19:41:14Z","body":"@ProPro9 This seems to be due to the `RigidBody2D` child you have attached to your character. Having it as a child of the CharacterBody2D that you are moving via script while it also has its own script controlling its movement is probably causing some buggy collisions between the `CharacterBody2D` node, your `TileMapLayer` and the `RigidBody2D`. If you want the `RigidBody2D` to be some sort of moving box obstacle, you should put it in its own scene so it can move independently rather than having it as a child of the player.","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/godo