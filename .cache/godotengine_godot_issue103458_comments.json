gem/following{/other_user}","gists_url":"https://api.github.com/users/Nodragem/gists{/gist_id}","starred_url":"https://api.github.com/users/Nodragem/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Nodragem/subscriptions","organizations_url":"https://api.github.com/users/Nodragem/orgs","repos_url":"https://api.github.com/users/Nodragem/repos","events_url":"https://api.github.com/users/Nodragem/events{/privacy}","received_events_url":"https://api.github.com/users/Nodragem/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-03-02T14:53:13Z","updated_at":"2025-03-02T14:53:13Z","body":"the difference is already observeable in the thumbnail of the imported texture, so the material's setting have no effect on it. I added a minimal project.","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2692767718/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2692792978","html_url":"https://github.com/godotengine/godot/issues/103458#issuecomment-2692792978","issue_url":"https://api.github.com/repos/godotengine/godot/issues/103458","id":2692792978,"node_id":"IC_kwDOAO6SJc6ggMKS","user":{"login":"AThousandShips","id":96648715,"node_id":"U_kgDOBcK-Cw","avatar_url":"https://avatars.githubusercontent.com/u/96648715?v=4","gravatar_id":"","url":"https://api.github.com/users/AThousandShips","html_url":"https://github.com/AThousandShips","followers_url":"https://api.github.com/users/AThousandShips/followers","following_url":"https://api.github.com/users/AThousandShips/following{/other_user}","gists_url":"https://api.github.com/users/AThousandShips/gists{/gist_id}","starred_url":"https://api.github.com/users/AThousandShips/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/AThousandShips/subscriptions","organizations_url":"https://api.github.com/users/AThousandShips/orgs","repos_url":"https://api.github.com/users/AThousandShips/repos","events_url":"https://api.github.com/users/AThousandShips/events{/privacy}","received_events_url":"https://api.github.com/users/AThousandShips/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-03-02T15:57:35Z","updated_at":"2025-03-02T15:57:35Z","body":"As asked previously an MRP should be a *complete project* next time uploading an MRP please upload a project, not just loose files, especially since the paths in this zip are invalid as you put the files in the root folder instead\n\nAfter fixing the project I'm unsure what I'm supposed to see, the two cubes are the same color, what is the expected result?","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2692792978/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2692878534","html_url":"https://github.com/godotengine/godot/issues/103458#issuecomment-2692878534","issue_url":"https://api.github.com/repos/godotengine/godot/issues/103458","id":2692878534,"node_id":"IC_kwDOAO6SJc6gghDG","user":{"login":"Lielay9","id":40064911,"node_id":"MDQ6VXNlcjQwMDY0OTEx","avatar_url":"https://avatars.githubusercontent.com/u/40064911?v=4","gravatar_id":"","url":"https://api.github.com/users/Lielay9","html_url":"https://github.com/Lielay9","followers_url":"https://api.github.com/users/Lielay9/followers","following_url":"https://api.github.com/users/Lielay9/following{/other_user}","gists_url":"https://api.github.com/users/Lielay9/gists{/gist_id}","starred_url":"https://api.github.com/users/Lielay9/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Lielay9/subscriptions","organizations_url":"https://api.github.com/users/Lielay9/orgs","repos_url":"https://api.github.com/users/Lielay9/repos","events_url":"https://api.github.com/users/Lielay9/events{/privacy}","received_events_url":"https://api.github.com/users/Lielay9/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-03-02T19:52:04Z","updated_at":"2025-03-02T19:52:04Z","body":"The images import setting compress/mode is set to \"VRAM Compressed\" which has the effect of reducing the images quality in favor of smaller size. Changing the setting to either \"Lossless\" or \"VRAM Uncompressed\" will retain the original pixel color. This is explained in the tooltip, the documentation of `CompressedTexture2D` and in the \"importing images\" documentation https://docs.godotengine.org/en/stable/tutorials/assets_pipeline/importing_images.html#compress-mode.","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2692878534/reactions","total_count":2,"+1":2,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2692896903","html_url":"https://github.com/godotengine/godot/issues/103458#issuecomment-2692896903","issue_url":"https://api.github.com/repos/godotengine/godot/issues/103458","id":2692896903,"node_id":"IC_kwDOAO6SJc6ggliH","user":{"login":"Nodragem","id":10520249,"node_id":"MDQ6VXNlcjEwNTIwMjQ5","avatar_url":"https://avatars.githubusercontent.com/u/10520249?v=4","gravatar_id":"","url":"https://api.github.com/users/Nodragem","html_url":"https://github.com/Nodragem","followers_url":"https://api.github.com/users/Nodragem/followers","following_url":"https://api.github.com/users/Nodragem/following{/other_user}","gists_url":"https://api.github.com/users/Nodragem/gists{/gist_id}","starred_url":"https://api.github.com/users/Nodragem/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Nodragem/subscriptions","organizations_url":"https://api.github.com/users/Nodragem/orgs","repos_url":"https://api.github.com/users/Nodragem/repos","events_url":"https://api.github.com/users/Nodragem/events{/privacy}","received_events_url":"https://api.github.com/users/Nodragem/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-03-02T20:39:05Z","updated_at":"2025-03-02T21:09:21Z","body":"> As asked previously an MRP should be a _complete project_ next time uploading an MRP please upload a project, not just loose files, especially since the paths in this zip are invalid as you put the files in the root folder instead\n> \n> After fixing the project I'm unsure what I'm supposed to see, the two cubes are the same color, what is the expected result?\n\nAs explained in the first message you need to use a color picker to read the color of the imported texture and notice the difference.\n\nThe difference is not necessarily visible by the naked eye in the default environment. But when working on textures with tone mapping and post processing, the difference can become noticeable.\n\nEDIT: you can see an animated GIF below to demonstrate the difference I was observing.","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2692896903/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2692908906","html_url":"https://github.com/godotengine/godot/issues/103458#issuecomment-2692908906","issue_url":"https://api.github.com/repos/godotengine/godot/issues/103458","id":2692908906,"node_id":"IC_kwDOAO6SJc6ggodq","user":{"login":"Nodragem","id":10520249,"node_id":"MDQ6VXNlcjEwNTIwMjQ5","avatar_url":"https://avatars.githubusercontent.com/u/10520249?v=4","gravatar_id":"","url":"https://api.github.com/users/Nodragem","html_url":"https://github.com/Nodragem","followers_url":"https://api.github.com/users/Nodragem/followers","following_url":"https://api.github.com/users/Nodragem/following{/other_user}","gists_url":"https://api.github.com/users/Nodragem/gists{/gist_id}","starred_url":"https://api.github.com/users/Nodragem/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Nodragem/subscriptions","organizations_url":"https://api.github.com/users/Nodragem/orgs","repos_url":"https://api.github.com/users/Nodragem/repos","events_url":"https://api.github.com/users/Nodragem/events{/privacy}","received_events_url":"https://api.github.com/users/Nodragem/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-03-02T21:08:43Z","updated_at":"2025-03-02T21:08:43Z","body":"> The images import setting compress/mode is set to \"VRAM Compressed\" which has the effect of reducing the images quality in favor of smaller size. Changing the setting to either \"Lossless\" or \"VRAM Uncompressed\" will retain the original pixel color. This is explained in the tooltip, the documentation of `CompressedTexture2D` and in the \"importing images\" documentation https://docs.godotengine.org/en/stable/tutorials/assets_pipeline/importing_images.html#compress-mode.\n\nI tried Lossless before I posted, but I was trying with the Thumbnail Preview of the texture. Just checked again now that I set up a better test (with 2 cubes, one using Albedo color, the other using a texture filled with the color). It seems that to use Lossless resolves the issue for the cubes, but not for the Thumbnail Preview.\n\nMaybe the thumbnail is not being updated after import, but that would be another type of bug?\n\nHere below, I recorded myself checking the colors with a color picker when the mode is VRAM Compressed, or Lossless.\n\n![Image](https://github.com/user-attachments/assets/8976ff74-4270-4aea-8aa2-94246c165901)\n\nThe tested color is a33c3c. The left cube has its albedo color set to a33c3c, while the right cube is using a texture filled with the color a33c3c. We expect a difference between the color of the cubes in the viewport and the tested color, because of the lighting. However, we expect both cubes to share the same color in the viewport, because they have the same rotation. Finally we would expect the thumbnail to display the color a33c3c. \n\nWhen using VRAM Compressed, you can see that my color picker reads the color c1524e from the left cube and c0534e from the right cube. The Thumbnail reads as a74444.\n\nWhen I change to Lossless,  you can see that my color picker reads the color c1524e from both cubes. The Thumbnail stil reads as a74444.\n\nHope that helps.\n\n","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2692908906/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2692910120","html_url":"https://github.com/godotengine/godot/issues/103458#issuecomment-2692910120","issue_url":"https://api.github.com/repos/godotengine/godot/issues/103458","id":2692910120,"node_id":"IC_kwDOAO6SJc6ggowo","user":{"login":"Calinou","id":180032,"node_id":"MDQ6VXNlcjE4MDAzMg==","avatar_url":"https://avatars.githubusercontent.com/u/180032?v=4","gravatar_id":"","url":"https://api.github.com/users/Calinou","html_url":"https://github.com/Calinou","followers_url":"https://api.github.com/users/Calinou/followers","following_url":"https://api.github.com/users/Calinou/following{/other_user}","gists_url":"https://api.github.com/users/Calinou/gists{/gist_id}","starred_url":"https://api.github.com/users/Calinou/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Calinou/subscriptions","organizations_url":"https://api.github.com/users/Calinou/orgs","repos_url":"https://api.github.com/users/Calinou/repos","events_url":"https://api.github.com/users/Calinou/events{/privacy}","received_events_url":"https://api.github.com/users/Calinou/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-03-02T21:11:56Z","updated_at":"2025-03-02T21:13:26Z","body":"See this forum post: https://forum.godotengine.org/t/wrong-texture-colors-after-import-png-jpg/103771/3\n\nTry disabling color management on your display and see if the issue persists. If the issue is gone after disabling color management, then this needs https://github.com/godotengine/godot-proposals/issues/903 to be implemented to be resolved.\n\nHowever, if disabling VRAM compression fixes the issue already, it's also possible that resource thumbnails don't get updated correctly after changing import options.","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2692910120/reactions","total_count":3,"+1":3,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2692912546","html_url":"https://github.com/godotengine/godot/issues/103458#issuecomment-2692912546","issue_url":"https://api.github.com/repos/godotengine/godot/issues/103458","id":2692912546,"node_id":"IC_kwDOAO6SJc6ggpWi","user":{"login":"Nodragem","id":10520249,"node_id":"MDQ6VXNlcjEwNTIwMjQ5","avatar_url":"https://avatars.githubusercontent.com/u/10520249?v=4","gravatar_id":"","url":"https://api.github.com/users/Nodragem","html_url":"https://github.com/Nodragem","followers_url":"https://api.github.com/users/Nodragem/followers","following_url":"https://api.github.com/users/Nodragem/following{/other_user}","gists_url":"https://api.github.com/users/Nodragem/gists{/gist_id}","starred_url":"https://api.github.com/users/Nodragem/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Nodragem/subscriptions","organizations_url":"https://api.github.com/users/Nodragem/orgs","repos_url":"https://api.github.com/users/Nodragem/repos","events_url":"https://api.github.com/users/Nodragem/events{/privacy}","received_events_url":"https://api.github.com/users/Nodragem/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-03-02T21:18:01Z","updated_at":"2025-03-02T21:18:01Z","body":"I use DisplayCAL, and it does not seem to change what the color picker is reading on the screen when I deactivate the profile.\n\nAs I experience often that the thumbnails do not update correctly when modifying my materials, I would suspect it could be the source of the issue.","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2692912546/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null}]