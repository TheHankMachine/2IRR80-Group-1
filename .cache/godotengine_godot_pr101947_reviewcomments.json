. ","created_at":"2025-01-24T05:40:18Z","updated_at":"2025-01-24T05:40:18Z","html_url":"https://github.com/godotengine/godot/pull/101947#discussion_r1928114685","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/101947","_links":{"self":{"href":"https://api.github.com/repos/godotengine/godot/pulls/comments/1928114685"},"html":{"href":"https://github.com/godotengine/godot/pull/101947#discussion_r1928114685"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/101947"}},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/1928114685/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":null,"original_line":3992,"side":"RIGHT","author_association":"MEMBER","original_position":5,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/1929106600","pull_request_review_id":2573368622,"id":1929106600,"node_id":"PRRC_kwDOAO6SJc5y-9So","diff_hunk":"@@ -3988,6 +3988,11 @@ void RendererSceneCull::render_particle_colliders() {\n \t\t\t\tif (!instance || !((1 << instance->base_type) & (RS::INSTANCE_GEOMETRY_MASK & (~(1 << RS::INSTANCE_PARTICLES))))) { //all but particles to avoid self collision\n \t\t\t\t\tcontinue;\n \t\t\t\t}\n+\n+\t\t\t\tif (!(instance->layer_mask & hfpc->layer_mask)) {","path":"servers/rendering/renderer_scene_cull.cpp","commit_id":"b162c59097e7771e8d8d62df9b705b13ef770901","original_commit_id":"a5a7c0044903c2de29d3973788dc88c915457b24","user":{"login":"Rudolph-B","id":52322745,"node_id":"MDQ6VXNlcjUyMzIyNzQ1","avatar_url":"https://avatars.githubusercontent.com/u/52322745?v=4","gravatar_id":"","url":"https://api.github.com/users/Rudolph-B","html_url":"https://github.com/Rudolph-B","followers_url":"https://api.github.com/users/Rudolph-B/followers","following_url":"https://api.github.com/users/Rudolph-B/following{/oth