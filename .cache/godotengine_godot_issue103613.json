l/103613.diff","patch_url":"https://github.com/godotengine/godot/pull/103613.patch","merged_at":"2025-03-05T18:08:45Z"},"body":"This does not resolve the errors noted in #101696, as the project is incorrectly binding incompatible uniform set descriptors, as set 0 and set 1 have a single `readonly` image and set 2 has a single `writeonly` texture. The `RenderingDevice` is reporting the errors with Metal, as it uses a different `_reflect_spirv`, which correctly determines the read / write attribute. A separate PR will be required to fix the shared `_reflect_spirv`\r\n\r\nHelps #101696\r\n","closed_by":{"login":"Repiteo","id":17489292,"node_id":"MDQ6VXNlcjE3NDg5Mjky","avatar_url":"https://avatars.githubusercontent.com/u/17489292?v=4","gravatar_id":"","url":"https://api.github.com/users/Repiteo","html_url":"https://github.com/Repiteo","followers_url":"https://api.github.com/users/Repiteo/followers","following_url":"https://api.github.com/users/Repiteo/following{/other_user}","gists_url":"https://api.github.com/users/Repiteo/gists{/gist_id}","starred_url":"https://api.github.com/users/Repiteo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Repiteo/subscriptions","organizations_url":"https://api.github.com/users/Repiteo/orgs","repos_url":"https://api.github.com/users/Repiteo/repos","events_url":"https://api.github.com/users/Repiteo/events{/privacy}","received_events_url":"https://api.github.com/users/Repiteo/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/103613/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/godotengine/godot/issues/103613/timeline","performed_via_github_app":null,"state_reason":null}