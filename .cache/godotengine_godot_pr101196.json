for external headers. It turns out that separation is no longer necessary; msvc has an equivalent implementation! Moreover, because this is now universal, the process can be safely applied to *all* thirdparty/external includes; this PR achieves that via `AddExternalIncludes`. In practice, this replaced the lion's share of Append/Prepend `CPPPATH` calls. This means that all remaining warning suppression wrappers around external `#include *` files are no longer necessary, and have also been cleaned up!","labels":[{"id":73330066,"node_id":"MDU6TGFiZWw3MzMzMDA2Ng==","url":"https://api.github.com/repos/godotengine/godot/labels/enhancement","name":"enhancement","description":"","color":"aaccff","default":true,"archived_at":null,"archived_by":null},{"id":279096997,"node_id":"MDU6TGFiZWwyNzkwOTY5OTc=","url":"https://api.github.com/repos/godotengine/godot/labels/archived","name":"archived","description":"","color":"aaaaaa","default":false,"archived_at":null,"archived_by":null},{"id":279098009,"node_id":"MDU6TGFiZWwyNzkwOTgwMDk=","url":"https://api.github.com/repos/godotengine/godot/labels/topic:buildsystem","name":"topic:buildsystem","description":"","color":"ffee88","default":false,"archived_at":null,"archived_by":null},{"id":370471795,"node_id":"MDU6TGFiZWwzNzA0NzE3OTU=","url":"https://api.github.com/repos/godotengine/godot/labels/topic:thirdparty","name":"topic:thirdparty","description":"","color":"ffee88","default":false,"archived_at":null,"archived_by":null}],"milestone":null,"active_lock_reason":null,"created_at":"2025-01-06T23:51:17Z","updated_at":"2025-04-02T08:49:53Z","closed_at":"2025-04-01T19:05:55Z","merged_at":null,"merge_commit_sha":null,"assignee":null,"assignees":[],"requested_reviewers":[],"requested_teams":[],"head":{"label":"Repiteo:scons/external-includes","ref":"scons/external-includes","repo":{"id":607282518,"node_id":"R_kgDOJDJlVg","name":"godot","full_name":"Repiteo/godot","owner":{"login":"Repiteo","id":17489292,"node_id":"MDQ6VXNlcjE3NDg5Mjky","avat