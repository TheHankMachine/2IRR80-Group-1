XNlcjM5OTQ2MDMw","avatar_url":"https://avatars.githubusercontent.com/u/39946030?v=4","gravatar_id":"","url":"https://api.github.com/users/lyuma","html_url":"https://github.com/lyuma","followers_url":"https://api.github.com/users/lyuma/followers","following_url":"https://api.github.com/users/lyuma/following{/other_user}","gists_url":"https://api.github.com/users/lyuma/gists{/gist_id}","starred_url":"https://api.github.com/users/lyuma/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/lyuma/subscriptions","organizations_url":"https://api.github.com/users/lyuma/orgs","repos_url":"https://api.github.com/users/lyuma/repos","events_url":"https://api.github.com/users/lyuma/events{/privacy}","received_events_url":"https://api.github.com/users/lyuma/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-08-01T17:37:11Z","updated_at":"2026-08-01T17:37:11Z","body":"we should avoid setting in the constructor because it can have weird impacts on ClassDB and serialization.\r\nThe documentation shouldn't have changed.\r\n\r\ni would mimic the same approach as XRNode by copying what they do with the setter","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5152589892/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5153106036","html_url":"https://github.com/godotengine/godot/pull/119509#issuecomment-5153106036","issue_url":"https://api.github.com/repos/godotengine/godot/issues/119509","id":5153106036,"node_id":"IC_kwDOAO6SJc8AAAABMyYodA","user":{"login":"lawnjelly","id":21999379,"node_id":"MDQ6VXNlcjIxOTk5Mzc5","avatar_url":"https://avatars.githubusercontent.com/u/21999379?v=4","gravatar_id":"","url":"https://api.github.com/users/lawnjelly","html_url":"https://github.com/lawnjelly","followers_url":"https://api.github.com/users/lawnjelly/followers","following_url":"https://api.github.com/users/lawnjelly/following{/other_user}","gists_url":"https://api.github.com/users/lawnjelly/gists{/gist_id}","starred_url":"https://api.github.com/users/lawnjelly/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/lawnjelly/subscriptions","organizations_url":"https://api.github.com/users/lawnjelly/orgs","repos_url":"https://api.github.com/users/lawnjelly/repos","events_url":"https://api.github.com/users/lawnjelly/events{/privacy}","received_events_url":"https://api.github.com/users/lawnjelly/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-08-01T19:43:27Z","updated_at":"2026-08-01T19:43:27Z","body":"> we should avoid setting in the constructor because it can have weird impacts on ClassDB and serialization.\r\n> The documentation shouldn't have changed.\r\n> i would mimic the same approach as XRNode by copying what they do with the setter\r\n\r\nWe do the same in the XR nodes afaik, and all the other nodes that turn off physics interpolation. Docs change is correct, because, the default has changed for these nodes.\r\n\r\nHaven't checked whether it adds an extra line on serialization though, I'll admit. ","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5153106036/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5153691670","html_url":"https://github.com/godotengine/godot/pull/119509#issuecomment-5153691670","issue_url":"https://api.github.com/repos/godotengine/godot/issues/119509","id":5153691670,"node_id":"IC_kwDOAO6SJc8AAAABMy8YFg","user":{"login":"TokageItLab","id":61938263,"node_id":"MDQ6VXNlcjYxOTM4MjYz","avatar_url":"https://avatars.githubusercontent.com/u/61938263?v=4","gravatar_id":"","url":"https://api.github.com/users/TokageItLab","html_url":"https://github.com/TokageItLab","followers_url":"https://api.github.com/users/TokageItLab/followers","following_url":"https://api.github.com/users/TokageItLab/following{/other_user}","gists_url":"https://api.github.com/users/TokageItLab/gists{/gist_id}","starred_url":"https://api.github.com/users/TokageItLab/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/TokageItLab/subscriptions","organizations_url":"https://api.github.com/users/TokageItLab/orgs","repos_url":"https://api.github.com/users/TokageItLab/repos","events_url":"https://api.github.com/users/TokageItLab/events{/privacy}","received_events_url":"https://api.github.com/users/TokageItLab/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-08-01T22:14:15Z","updated_at":"2026-08-01T22:14:40Z","body":"@lawnjelly lyuma's concern is that, even though this PR only changed the default value of `physics_interpolation_mode` in the constructors of a few subclasses, the class reference is being output as if the default value of `physics_interpolation_mode` in unrelated classes had been changed. This is not correct behavior for C++, and I suspect there is a bug in the way the class reference retrieves default values, but I won't know for sure until I investigate.","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5153691670/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5153876965","html_url":"https://github.com/godotengine/godot/pull/119509#issuecomment-5153876965","issue_url":"https://api.github.com/repos/godotengine/godot/issues/119509","id":5153876965,"node_id":"IC_kwDOAO6SJc8AAAABMzHr5Q","user":{"login":"TokageItLab","id":61938263,"node_id":"MDQ6VXNlcjYxOTM4MjYz","avatar_url":"https://avatars.githubusercontent.com/u/61938263?v=4","gravatar_id":"","url":"https://api.github.com/users/TokageItLab","html_url":"https://github.com/TokageItLab","followers_url":"https://api.github.com/users/TokageItLab/followers","following_url":"https://api.github.com/users/TokageItLab/following{/other_user}","gists_url":"https://api.github.com/users/TokageItLab/gists{/gist_id}","starred_url":"https://api.github.com/users/TokageItLab/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/TokageItLab/subscriptions","organizations_url":"https://api.github.com/users/TokageItLab/orgs","repos_url":"https://api.github.com/users/TokageItLab/repos","events_url":"https://api.github.com/users/TokageItLab/events{/privacy}","received_events_url":"https://api.github.com/users/TokageItLab/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-08-01T22:59:08Z","updated_at":"2026-08-01T23:09:17Z","body":"> lyuma's concern is that, even though this PR only changed the default value of physics_interpolation_mode in the constructors of a few subclasses, the class reference is being output as if the default value of physics_interpolation_mode in unrelated classes had been changed.\r\n\r\nThis seems to be a bug caused by ClassDB not being able to read the contents of abstract classes.\r\n\r\nLooking at the diff of the class reference, it appears that the default value of physics_interpolation_mode in SkeletonModifier3D was set to 0, but the actual default value of SkeletonModifier3D remains 2.\r\n\r\nThis strange state seems to happen because when ClassDB collects default values for documentation, since abstract classes can't be instantiated on the Godot editor, it collects default values from the first instantiable child class (meaning it relies on guesswork rather than the actual value). So the default value above was an incorrect guess.\r\n\r\nChanging the registration order of ModifierBoneTarget3D to be last of the SkeletonModifier's subclass completely resolved the issue, it should be there is no more problem; Overriding the default value of the parent class in constructors to is already a common practice in some classes.","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5153876965/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5156336151","html_url":"https://github.com/godotengine/godot/pull/119509#issuecomment-5156336151","issue_url":"https://api.github.com/repos/godotengine/godot/issues/119509","id":5156336151,"node_id":"IC_kwDOAO6SJc8AAAABM1dyFw","user":{"login":"lawnjelly","id":21999379,"node_id":"MDQ6VXNlcjIxOTk5Mzc5","avatar_url":"https://avatars.githubusercontent.com/u/21999379?v=4","gravatar_id":"","url":"https://api.github.com/users/lawnjelly","html_url":"https://github.com/lawnjelly","followers_url":"https://api.github.com/users/lawnjelly/followers","following_url":"https://api.github.com/users/lawnjelly/following{/other_user}","gists_url":"https://api.github.com/users/lawnjelly/gists{/gist_id}","starred_url":"https://api.github.com/users/lawnjelly/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/lawnjelly/subscriptions","organizations_url":"https://api.github.com/users/lawnjelly/orgs","repos_url":"https://api.github.com/users/lawnjelly/repos","events_url":"https://api.github.com/users/lawnjelly/events{/privacy}","received_events_url":"https://api.github.com/users/lawnjelly/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-08-02T07:51:12Z","updated_at":"2026-08-02T07:51:12Z","body":"> This is not correct behavior for C++, and I suspect there is a bug in the way the class reference retrieves default values, but I won't know for sure until I investigate.\r\n\r\nAh that makes sense. I'm not familiar with the inheritance hierarchy in this area, but well spotted. :+1: ","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5156336151/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5327984778","html_url":"https://github.com/godotengine/godot/pull/119509#issuecomment-5327984778","issue_url":"https://api.github.com/repos/godotengine/godot/issues/119509","id":5327984778,"node_id":"IC_kwDOAO6SJc8AAAABPZKYig","user":{"login":"Repiteo","id":17489292,"node_id":"MDQ6VXNlcjE3NDg5Mjky","avatar_url":"https://avatars.githubusercontent.com/u/17489292?v=4","gravatar_id":"","url":"https://api.github.com/users/Repiteo","html_url":"https://github.com/Repiteo","followers_url":"https://api.github.com/users/Repiteo/followers","following_url":"https://api.github.com/users/Repiteo/following{/other_user}","gists_url":"https://api.github.com/users/Repiteo/gists{/gist_id}","starred_url":"https://api.github.com/users/Repiteo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Repiteo/subscriptions","organizations_url":"https://api.github.com/users/Repiteo/orgs","repos_url":"https://api.github.com/users/Repiteo/repos","events_url":"https://api.github.com/users/Repiteo/events{/privacy}","received_events_url":"https://api.github.com/users/Repiteo/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-08-18T12:11:43Z","updated_at":"2026-08-18T12:11:43Z","body":"Thanks!","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5327984778/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,