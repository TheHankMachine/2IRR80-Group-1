/following{/other_user}","gists_url":"https://api.github.com/users/KoBeWi/gists{/gist_id}","starred_url":"https://api.github.com/users/KoBeWi/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/KoBeWi/subscriptions","organizations_url":"https://api.github.com/users/KoBeWi/orgs","repos_url":"https://api.github.com/users/KoBeWi/repos","events_url":"https://api.github.com/users/KoBeWi/events{/privacy}","received_events_url":"https://api.github.com/users/KoBeWi/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-09-02T22:30:59Z","updated_at":"2025-09-02T22:30:59Z","body":"Does it need to be a setting? Why would someone want to turn it off?","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3247002678/reactions","total_count":2,"+1":2,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3247052304","html_url":"https://github.com/godotengine/godot/pull/110185#issuecomment-3247052304","issue_url":"https://api.github.com/repos/godotengine/godot/issues/110185","id":3247052304,"node_id":"IC_kwDOAO6SJc7BihYQ","user":{"login":"Calinou","id":180032,"node_id":"MDQ6VXNlcjE4MDAzMg==","avatar_url":"https://avatars.githubusercontent.com/u/180032?v=4","gravatar_id":"","url":"https://api.github.com/users/Calinou","html_url":"https://github.com/Calinou","followers_url":"https://api.github.com/users/Calinou/followers","following_url":"https://api.github.com/users/Calinou/following{/other_user}","gists_url":"https://api.github.com/users/Calinou/gists{/gist_id}","starred_url":"https://api.github.com/users/Calinou/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Calinou/subscriptions","organizations_url":"https://api.github.com/users/Calinou/orgs","repos_url":"https://api.github.com/users/Calinou/repos","events_url":"https://api.github.com/users/Calinou/events{/privacy}","received_events_url":"https://api.github.com/users/Calinou/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-09-02T22:56:25Z","updated_at":"2025-09-02T22:56:25Z","body":"> Does it need to be a setting? Why would someone want to turn it off?\r\n\r\nI can't see a reason to turn it off, so I think the setting should be removed too. We can introduce it in a future PR if there's a proven need for it.","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3247052304/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3247261934","html_url":"https://github.com/godotengine/godot/pull/110185#issuecomment-3247261934","issue_url":"https://api.github.com/repos/godotengine/godot/issues/110185","id":3247261934,"node_id":"IC_kwDOAO6SJc7BjUju","user":{"login":"vaner-org","id":9658355,"node_id":"MDQ6VXNlcjk2NTgzNTU=","avatar_url":"https://avatars.githubusercontent.com/u/9658355?v=4","gravatar_id":"","url":"https://api.github.com/users/vaner-org","html_url":"https://github.com/vaner-org","followers_url":"https://api.github.com/users/vaner-org/followers","following_url":"https://api.github.com/users/vaner-org/following{/other_user}","gists_url":"https://api.github.com/users/vaner-org/gists{/gist_id}","starred_url":"https://api.github.com/users/vaner-org/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/vaner-org/subscriptions","organizations_url":"https://api.github.com/users/vaner-org/orgs","repos_url":"https://api.github.com/users/vaner-org/repos","events_url":"https://api.github.com/users/vaner-org/events{/privacy}","received_events_url":"https://api.github.com/users/vaner-org/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-09-03T00:48:07Z","updated_at":"2025-09-03T00:48:07Z","body":"I've removed the editor setting and hardcoded our two calls to `intersect_ray` to ignore backfaces.","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3247261934/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3355973062","html_url":"https://github.com/godotengine/godot/pull/110185#issuecomment-3355973062","issue_url":"https://api.github.com/repos/godotengine/godot/issues/110185","id":3355973062,"node_id":"IC_kwDOAO6SJc7ICBXG","user":{"login":"kleonc","id":9283098,"node_id":"MDQ6VXNlcjkyODMwOTg=","avatar_url":"https://avatars.githubusercontent.com/u/9283098?v=4","gravatar_id":"","url":"https://api.github.com/users/kleonc","html_url":"https://github.com/kleonc","followers_url":"https://api.github.com/users/kleonc/followers","following_url":"https://api.github.com/users/kleonc/following{/other_user}","gists_url":"https://api.github.com/users/kleonc/gists{/gist_id}","starred_url":"https://api.github.com/users/kleonc/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/kleonc/subscriptions","organizations_url":"https://api.github.com/users/kleonc/orgs","repos_url":"https://api.github.com/users/kleonc/repos","events_url":"https://api.github.com/users/kleonc/events{/privacy}","received_events_url":"https://api.github.com/users/kleonc/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-10-01T11:55:10Z","updated_at":"2025-10-01T11:55:10Z","body":"Note that the cull mode the given mesh is rendered with is not being accounted for anyhow (it's the same before/after this PR though).\r\n\r\nSo while this PR fixes the behavior for the `CULL_BACK/back` case from the tables below, it breaks `CULL_FRONT/back` and `CULL_DISABLED/back` cases.\r\nIf `CULL_BACK/back` case is more common/annoying than `CULL_FRONT/back` and `CULL_DISABLED/back` cases together, then this PR could be considered as an improvement even in it's current state. Whether this is actually the case I have no idea.\r\n\r\nWithout this PR (v4.5.stable.official [876b29033]):\r\n\r\nCull mode | mesh faces looked at from | visible | selectable | correct\r\n-|-|-|-|-\r\n`CULL_FRONT` | front | ✗ | ✓ | ❌\r\n`CULL_FRONT` | back | ✓ | ✓ | ✅\r\n`CULL_BACK` | front | ✓ | ✓ | ✅\r\n`CULL_BACK` | back | ✗ | ✓ | ❌\r\n`CULL_DISABLED` | front | ✓ | ✓ | ✅\r\n`CULL_DISABLED` | back | ✓ | ✓ | ✅\r\n\r\nWith this PR (v4.5.beta.`gh-110185` [4d10a6550]):\r\n\r\nCull mode | mesh faces looked at from | visible | selectable | correct\r\n-|-|-|-|-\r\n`CULL_FRONT` | front | ✗ | ✓ | ❌\r\n`CULL_FRONT` | back | ✓ | ✗ | ❌\r\n`CULL_BACK` | front | ✓ | ✓ | ✅\r\n`CULL_BACK` | back | ✗ | ✗ | ✅\r\n`CULL_DISABLED` | front | ✓ | ✓ | ✅\r\n`CULL_DISABLED` | back | ✓ | ✗ | ❌\r\n\r\nE.g. selection for double sided Sprite3D (by default `double_sided = true`; it uses `CULL_DISABLED` mode internally) gets broken with this PR as it makes the sprite selectable only from the front side.\r\n\r\nBefore:\r\n\r\nhttps://github.com/user-attachments/assets/3bc3fb80-86df-4496-bec0-087d4be179cb\r\n\r\nAfter:\r\n\r\nhttps://github.com/user-attachments/assets/877f1788-381a-49c8-a59d-98342e4a7cc6","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3355973062/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3357343059","html_url":"https://github.com/godotengine/godot/pull/110185#issuecomment-3357343059","issue_url":"https://api.github.com/repos/godotengine/godot/issues/110185","id":3357343059,"node_id":"IC_kwDOAO6SJc7IHP1T","user":{"login":"ratkingsminion","id":3142253,"node_id":"MDQ6VXNlcjMxNDIyNTM=","avatar_url":"https://avatars.githubusercontent.com/u/3142253?v=4","gravatar_id":"","url":"https://api.github.com/users/ratkingsminion","html_url":"https://github.com/ratkingsminion","followers_url":"https://api.github.com/users/ratkingsminion/followers","following_url":"https://api.github.com/users/ratkingsminion/following{/other_user}","gists_url":"https://api.github.com/users/ratkingsminion/gists{/gist_id}","starred_url":"https://api.github.com/users/ratkingsminion/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/ratkingsminion/subscriptions","organizations_url":"https://api.github.com/users/ratkingsminion/orgs","repos_url":"https://api.github.com/users/ratkingsminion/repos","events_url":"https://api.github.com/users/ratkingsminion/events{/privacy}","received_events_url":"https://api.github.com/users/ratkingsminion/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-10-01T17:15:39Z","updated_at":"2025-10-01T17:15:39Z","body":"In our case the PR would be an improvement, we have levels full of 3D models (each wall, floor, ceiling is a mesh on its own) and none of them have front face culling. I think that will be the case for the majority of users, at least I can't imagine otherwise. We use Sprite3Ds mostly as billboards, and I guess the PR does not account for that either (it's already a problem in the current way of selecting).","author_association":"NONE","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3357343059/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3419145095","html_url":"https://github.com/godotengine/godot/pull/110185#issuecomment-3419145095","issue_url":"https://api.github.com/repos/godotengine/godot/issues/110185","id":3419145095,"node_id":"IC_kwDOAO6SJc7LzAOH","user":{"login":"vaner-org","id":9658355,"node_id":"MDQ6VXNlcjk2NTgzNTU=","avatar_url":"https://avatars.githubusercontent.com/u/9658355?v=4","gravatar_id":"","url":"https://api.github.com/users/vaner-org","html_url":"https://github.com/vaner-org","followers_url":"https://api.github.com/users/vaner-org/followers","following_url":"https://api.github.com/users/vaner-org/following{/other_user}","gists_url":"https://api.github.com/users/vaner-org/gists{/gist_id}","starred_url":"https://api.github.com/users/vaner-org/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/vaner-org/subscriptions","organizations_url":"https://api.github.com/users/vaner-org/orgs","repos_url":"https://api.github.com/users/vaner-org/repos","events_url":"https://api.github.com/users/vaner-org/events{/privacy}","received_events_url":"https://api.github.com/users/vaner-org/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-10-19T02:15:11Z","updated_at":"2025-10-19T02:41:59Z","body":"Addressing @kleonc's concerns, I've added an extra commit on which I'd appreciate some feedback.\r\nAssuming the precedence used in MeshInstance3D's `get_active_material()`, for each case, from highest to lowest priority in how the cull mode is inferred:\r\n\r\n| MeshInstance3D | Sprite3D | CSGPrimitive3D |\r\n| ------------- | ------------- | ------------- |\r\n| GeometryInstance3D material override | Geometry3DInstance material_override | Geometry3DInstance material_override |\r\n| MeshInstance3D surface (0) override | SpriteBase3D double_sided | CSGShape's specific get_material |\r\n| MeshInstance3D mesh material | | |\r\n\r\nThis means that the new parameter accepted by `intersect_ray` is now an enum, one of `CULL_BACK`, `CULL_FRONT` and `CULL_DISABLED`.\r\n\r\nAll of this can be tested in the scene here: [backface_test.zip](https://github.com/user-attachments/files/22987974/backface_test.zip)\r\n\r\n**Here's the problem:**\r\nIt seriously hurts editor performance, adding a noticeable delay when selecting nodes. If anyone here is aware of a more performant way of doing this, please let me know.\r\n\r\nAlternatively, I can revert this commit, retaining the bandaid fix for Sprite3D, and then branch off the remaining functionality into another draft PR, where an optimised way of doing this can be discussed, and the fix for Sprite3D can be replaced with something that can represent all mesh planes.","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3419145095/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3457509442","html_url":"https://github.com/godotengine/godot/pull/110185#issuecomment-3457509442","issue_url":"https://api.github.com/repos/godotengine/godot/issues/110185","id":3457509442,"node_id":"IC_kwDOAO6SJc7OFWhC","user":{"login":"Repiteo","id":17489292,"node_id":"MDQ6VXNlcjE3NDg5Mjky","avatar_url":"https://avatars.githubusercontent.com/u/17489292?v=4","gravatar_id":"","url":"https://api.github.com/users/Repiteo","html_url":"https://github.com/Repiteo","followers_url":"https://api.github.com/users/Repiteo/followers","following_url":"https://api.github.com/users/Repiteo/following{/other_user}","gists_url":"https://api.github.com/users/Repiteo/gists{/gist_id}","starred_url":"https://api.github.com/users/Repiteo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Repiteo/subscriptions","organizations_url":"https://api.github.com/users/Repiteo/orgs","repos_url":"https://api.github.com/users/Repiteo/repos","events_url":"https://api.github.com/users/Repiteo/events{/privacy}","received_events_url":"https://api.github.com/users/Repiteo/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-10-28T16:55:21Z","updated_at":"2025-10-28T16:55:21Z","body":"@Calinou @kleonc What's the call then? I don't think we should integrate something that hurts editor performance, so this is more about if we should allow the standalone version to exist with known issues or if a fully optimized implementation is necessary to start","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3457509442/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3457734605","html_url":"https://github.com/godotengine/godot/pull/110185#issuecomment-3457734605","issue_url":"https://api.github.com/repos/godotengine/godot/issues/110185","id":3457734605,"node_id":"IC_kwDOAO6SJc7OGNfN","user":{"login":"Calinou","id":180032,"node_id":"MDQ6VXNlcjE4MDAzMg==","avatar_url":"https://avatars.githubusercontent.com/u/180032?v=4","gravatar_id":"","url":"https://api.github.com/users/Calinou","html_url":"https://github.com/Calinou","followers_url":"https://api.github.com/users/Calinou/followers","following_url":"https://api.github.com/users/Calinou/following{/other_user}","gists_url":"https://api.github.com/users/Calinou/gists{/gist_id}","starred_url":"https://api.github.com/users/Calinou/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Calinou/subscriptions","organizations_url":"https://api.github.com/users/Calinou/orgs","repos_url":"https://api.github.com/users/Calinou/repos","events_url":"https://api.github.com/users/Calinou/events{/privacy}","received_events_url":"https://api.github.com/users/Calinou/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-10-28T17:47:38Z","updated_at":"2025-10-28T17:47:38Z","body":"> What's the call then? I don't think we should integrate something that hurts editor performance, so this is more about if we should allow the standalone version to exist with known issues or if a fully optimized implementation is necessary to start\r\n\r\nIndeed, this will introduce usability issues in large projects even if they didn't run into any issues previously. In this sense, it would be a regression.\r\n\r\nI think we should hold off on merging this until we find a more optimized approach. Maybe reusing the depth buffer is something we should do eventually...","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3457734605/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null}]