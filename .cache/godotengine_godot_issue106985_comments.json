rs/YeldhamDev/following{/other_user}","gists_url":"https://api.github.com/users/YeldhamDev/gists{/gist_id}","starred_url":"https://api.github.com/users/YeldhamDev/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/YeldhamDev/subscriptions","organizations_url":"https://api.github.com/users/YeldhamDev/orgs","repos_url":"https://api.github.com/users/YeldhamDev/repos","events_url":"https://api.github.com/users/YeldhamDev/events{/privacy}","received_events_url":"https://api.github.com/users/YeldhamDev/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-12-12T01:06:19Z","updated_at":"2025-12-12T01:06:19Z","body":"@KoBeWi Correct, but it's a decent (and I think only one in the engine) indicator.","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3644462870/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3644836515","html_url":"https://github.com/godotengine/godot/pull/106985#issuecomment-3644836515","issue_url":"https://api.github.com/repos/godotengine/godot/issues/106985","id":3644836515,"node_id":"IC_kwDOAO6SJc7ZP8qj","user":{"login":"AdriaandeJongh","id":5611323,"node_id":"MDQ6VXNlcjU2MTEzMjM=","avatar_url":"https://avatars.githubusercontent.com/u/5611323?v=4","gravatar_id":"","url":"https://api.github.com/users/AdriaandeJongh","html_url":"https://github.com/AdriaandeJongh","followers_url":"https://api.github.com/users/AdriaandeJongh/followers","following_url":"https://api.github.com/users/AdriaandeJongh/following{/other_user}","gists_url":"https://api.github.com/users/AdriaandeJongh/gists{/gist_id}","starred_url":"https://api.github.com/users/AdriaandeJongh/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/AdriaandeJongh/subscriptions","organizations_url":"https://api.github.com/users/AdriaandeJongh/orgs","repos_url":"https://api.github.com/users/AdriaandeJongh/repos","events_url":"https://api.github.com/users/AdriaandeJongh/events{/privacy}","received_events_url":"https://api.github.com/users/AdriaandeJongh/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-12-12T04:16:16Z","updated_at":"2025-12-12T04:16:16Z","body":"because i was so excited about this feature above, i want to point out that @KoBeWi ’s point above about this being an incomplete solution, was very convincing to me to not add this in its current state - unless i am missing something.\r\n\r\nthe larger issue this is only a partial solution to, is to have a system to automate moving the focus to visible controls. \r\n\r\nin particular, this doesn’t ‘fix’ the case where a panel has a button with focus and then a popup appears with a control with autofocus - when the popup disappears again later, the underlying panel doesn’t regain focus, because it was always visible and thus didn’t autofocus.","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3644836515/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3644847542","html_url":"https://github.com/godotengine/godot/pull/106985#issuecomment-3644847542","issue_url":"https://api.github.com/repos/godotengine/godot/issues/106985","id":3644847542,"node_id":"IC_kwDOAO6SJc7ZP_W2","user":{"login":"AdriaandeJongh","id":5611323,"node_id":"MDQ6VXNlcjU2MTEzMjM=","avatar_url":"https://avatars.githubusercontent.com/u/5611323?v=4","gravatar_id":"","url":"https://api.github.com/users/AdriaandeJongh","html_url":"https://github.com/AdriaandeJongh","followers_url":"https://api.github.com/users/AdriaandeJongh/followers","following_url":"https://api.github.com/users/AdriaandeJongh/following{/other_user}","gists_url":"https://api.github.com/users/AdriaandeJongh/gists{/gist_id}","starred_url":"https://api.github.com/users/AdriaandeJongh/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/AdriaandeJongh/subscriptions","organizations_url":"https://api.github.com/users/AdriaandeJongh/orgs","repos_url":"https://api.github.com/users/AdriaandeJongh/repos","events_url":"https://api.github.com/users/AdriaandeJongh/events{/privacy}","received_events_url":"https://api.github.com/users/AdriaandeJongh/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-12-12T04:22:20Z","updated_at":"2025-12-12T04:22:20Z","body":"perhaps this requires a separate proposal, but one way this currently-partial feature could be made complete is if in any autofocus control’s visibility change some system goes over all controls with autofocus, checks whether they are visible, and selects the one rendered on top (taking both hierarchy and z-index into account). but i suspect this is an implementation that’s far away from this current PR…","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3644847542/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3973104325","html_url":"https://github.com/godotengine/godot/pull/106985#issuecomment-3973104325","issue_url":"https://api.github.com/repos/godotengine/godot/issues/106985","id":3973104325,"node_id":"IC_kwDOAO6SJc7s0MLF","user":{"login":"AdriaandeJongh","id":5611323,"node_id":"MDQ6VXNlcjU2MTEzMjM=","avatar_url":"https://avatars.githubusercontent.com/u/5611323?v=4","gravatar_id":"","url":"https://api.github.com/users/AdriaandeJongh","html_url":"https://github.com/AdriaandeJongh","followers_url":"https://api.github.com/users/AdriaandeJongh/followers","following_url":"https://api.github.com/users/AdriaandeJongh/following{/other_user}","gists_url":"https://api.github.com/users/AdriaandeJongh/gists{/gist_id}","starred_url":"https://api.github.com/users/AdriaandeJongh/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/AdriaandeJongh/subscriptions","organizations_url":"https://api.github.com/users/AdriaandeJongh/orgs","repos_url":"https://api.github.com/users/AdriaandeJongh/repos","events_url":"https://api.github.com/users/AdriaandeJongh/events{/privacy}","received_events_url":"https://api.github.com/users/AdriaandeJongh/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-02-27T13:59:00Z","updated_at":"2026-02-27T13:59:00Z","body":"Before there's more reviews, I would like to reiterate @KoBeWi's point that this is an incomplete solution and I think there should be consensus on whether that's OK or not. My 50c is that this solution hints at a complete solution, but because it isn't, will still require users to write their own complete solution, meaning that this can only ever be an annoying feature devs try and then roll their own. I don't thin that's what we should aim for.","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3973104325/reactions","total_count":2,"+1":2,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null}]