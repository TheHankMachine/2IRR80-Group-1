ithub.com/users/akien-mga/followers","following_url":"https://api.github.com/users/akien-mga/following{/other_user}","gists_url":"https://api.github.com/users/akien-mga/gists{/gist_id}","starred_url":"https://api.github.com/users/akien-mga/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/akien-mga/subscriptions","organizations_url":"https://api.github.com/users/akien-mga/orgs","repos_url":"https://api.github.com/users/akien-mga/repos","events_url":"https://api.github.com/users/akien-mga/events{/privacy}","received_events_url":"https://api.github.com/users/akien-mga/received_events","type":"User","user_view_type":"public","site_admin":false},"open_issues":8,"closed_issues":4466,"state":"closed","created_at":"2024-02-14T11:52:07Z","updated_at":"2026-10-05T23:48:31Z","due_on":"2025-03-03T00:00:00Z","closed_at":"2025-03-19T09:35:35Z"},"comments":11,"created_at":"2025-01-17T21:21:17Z","updated_at":"2025-05-19T10:08:10Z","closed_at":"2025-01-26T17:57:10Z","assignee":{"login":"mihe","id":4884246,"node_id":"MDQ6VXNlcjQ4ODQyNDY=","avatar_url":"https://avatars.githubusercontent.com/u/4884246?v=4","gravatar_id":"","url":"https://api.github.com/users/mihe","html_url":"https://github.com/mihe","followers_url":"https://api.github.com/users/mihe/followers","following_url":"https://api.github.com/users/mihe/following{/other_user}","gists_url":"https://api.github.com/users/mihe/gists{/gist_id}","starred_url":"https://api.github.com/users/mihe/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/mihe/subscriptions","organizations_url":"https://api.github.com/users/mihe/orgs","repos_url":"https://api.github.com/users/mihe/repos","events_url":"https://api.github.com/users/mihe/events{/privacy}","received_events_url":"https://api.github.com/users/mihe/received_events","type":"User","user_view_type":"public","site_admin":false},"author_association":"CONTRIBUTOR","issue_field_values":[],"type":null,"active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"### Tested versions\n\nGodot v4.4.beta1, regression from 4.3 stable with Jolt addon.\n\n### System information\n\nWindows 10 (build 19044) - Single-window, 1 monitor - Vulkan (Forward+) - dedicated NVIDIA GeForce RTX 3080 (NVIDIA; 32.0.15.6636) - AMD Ryzen 9 5950X 16-Core Processor (32 threads)\n\n### Issue description\n\nI have two scenes that work as parametrized stair and ladder generators. They both use most of the same code, with the stairs generated as arranged StaticBody3Ds, and ladders generated as arranged CSGCylinders with collision enabled.\n\nIn 4.3 stable with the Jolt addon, using an Area3D with \"Areas Detect Static Bodies\" enabled in settings gave mostly reliable results, as the Area3D came into proximity with the ladders and stairs they triggered the enter and exit signals with reasonable stability. The ladders give phantom exit signals when they shouldn't, but these only occur when the Area3D is moved, so they do not impact performance very much.\n\nHowever, in 4.4, while the ladder bodies (composed of CSGCylinders) detect the same way, but the steps made of StaticBodies all enter and exit repeatedly every  frame, adding a massive performance drop in my project whenever they are encountered by my player.\n\n### Steps to reproduce\n\nFor the purposes of demonstration, I have arranged my ladder constructor, an ordinary StaticBody, and my stairs constructor side by side.\n\n![Image](https://github.com/user-attachments/assets/f6d9ce31-c154-4bee-b585-9ddce4f6bc00)\n\nIn both projects, pressing \"A\" or \"D\" on the keyboard will move the Area3D, and the game will print entrances and exits to output.\n\n\n### Minimal reproduction project (MRP)\n\nExpected behavior in 4.3 can be seen with [jolt-staticbody-mrp-4.3.zip](https://github.com/user-attachments/files/18459848/jolt-staticbody-mrp-4.3.zip), addon is included.\nProblem can be seen in 4.4 with [jolt-staticbody-mrp-4.4.zip](https://github.com/user-attachments/files/18465925/jolt-staticbody-mrp-4.4.zip).","closed_by":{"login":"Repiteo","id":17489292,"node_id":"MDQ6VXNlcjE3NDg5Mjky","avatar_url":"https://avatars.githubusercontent.com/u/17489292?v=4","gravatar_id":"","url":"https://api.github.com/users/Repiteo","html_url":"https://github.com/Repiteo","followers_url":"https://api.github.com/users/Repiteo/followers","following_url":"https://api.github.com/users/Repiteo/following{/other_user}","gists_url":"https://api.github.com/users/Repiteo/gists{/gist_id}","starred_url":"https://api.github.com/users/Repiteo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Repiteo/subscriptions","organizations_url":"https://api.github.com/users/Repiteo/orgs","repos_url":"https://api.github.com/users/Repiteo/repos","events_url":"https://api.github.com/users/Repiteo/events{/privacy}","received_events_url":"https://api.github.com/users/Repiteo/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/101721/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/godotengine/godot/issues/101721/timeline","performed_via_github_app":null,"state_reason":"completed","pinned_comment":null}