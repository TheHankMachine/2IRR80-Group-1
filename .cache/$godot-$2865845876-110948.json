https://github.com/Ivorforce","id":2308167,"node_id":"MDQ6VXNlcjIzMDgxNjc=","login":"Ivorforce","type":"User","owned_private_repos":0,"public_gists":0,"public_repos":0,"total_private_repos":0,"url":"https://api.github.com/users/Ivorforce"},"body":"","html_url":"https://github.com/godotengine/godot/pull/110948#pullrequestreview-3275039745","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/110948","author_association":"MEMBER","submitted_at":"2025-09-27T17:36:10Z"},{"id":3276402871,"node_id":"PRR_kwDOAO6SJc7DSfC3","state":"COMMENTED","user":{"site_admin":false,"suspended":false,"updated_at":"0001-01-01T00:00:00Z","avatar_url":"https://avatars.githubusercontent.com/u/191561?v=4","created_at":"0001-01-01T00:00:00Z","followers":0,"following":0,"html_url":"https://github.com/dsnopek","id":191561,"node_id":"MDQ6VXNlcjE5MTU2MQ==","login":"dsnopek","type":"User","owned_private_repos":0,"public_gists":0,"public_repos":0,"total_private_repos":0,"url":"https://api.github.com/users/dsnopek"},"body":"Thanks!\r\n\r\nI'm largely in support of this change! The inconsistent use of `const Type &` in function arguments in the OpenXR code has bothered me for a long time, and making this consistent with the rest of Godot's code base which consistently uses this style is great.\r\n\r\nAnd great catch on the incorrect `p_` vs `r_` prefix, and some of the arguments missing a prefix altogether :-)\r\n\r\nHowever, I'm not totally sure about making `Array`'s copy constructor be explicit. Since `Array` does its own internal reference counting, making copies isn't as bad as with other data types? But that's something we can discuss elsewhere.","html_url":"https://github.com/godotengine/godot/pull/110948#pullrequestreview-3276402871","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/110948","author_association":"CONTRIBUTOR","submitted_at":"2025-09-28T11:56:31Z"},{"id":3276776511,"node_id":"PRR_kwDOAO6SJc7DT6Q_","state":"COMMENTED","user":{"site_admin