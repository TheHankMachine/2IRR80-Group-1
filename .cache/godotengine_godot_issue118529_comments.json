[{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4239054073","html_url":"https://github.com/godotengine/godot/pull/118529#issuecomment-4239054073","issue_url":"https://api.github.com/repos/godotengine/godot/issues/118529","id":4239054073,"node_id":"IC_kwDOAO6SJc78qtT5","user":{"login":"HolonProduction","id":99511741,"node_id":"U_kgDOBe5tvQ","avatar_url":"https://avatars.githubusercontent.com/u/99511741?v=4","gravatar_id":"","url":"https://api.github.com/users/HolonProduction","html_url":"https://github.com/HolonProduction","followers_url":"https://api.github.com/users/HolonProduction/followers","following_url":"https://api.github.com/users/HolonProduction/following{/other_user}","gists_url":"https://api.github.com/users/HolonProduction/gists{/gist_id}","starred_url":"https://api.github.com/users/HolonProduction/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/HolonProduction/subscriptions","organizations_url":"https://api.github.com/users/HolonProduction/orgs","repos_url":"https://api.github.com/users/HolonProduction/repos","events_url":"https://api.github.com/users/HolonProduction/events{/privacy}","received_events_url":"https://api.github.com/users/HolonProduction/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-04-13T19:26:05Z","updated_at":"2026-04-13T19:26:05Z","body":"Why should this be a node that's available in production templates?","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4239054073/reactions","total_count":4,"+1":3,"-1":1,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4241287609","html_url":"https://github.com/godotengine/godot/pull/118529#issuecomment-4241287609","issue_url":"https://api.github.com/repos/godotengine/godot/issues/118529","id":4241287609,"node_id":"IC_kwDOAO6SJc78zOm5","user":{"login":"boycher","id":274249743,"node_id":"U_kgDOEFi4Dw","avatar_url":"https://avatars.githubusercontent.com/u/274249743?v=4","gravatar_id":"","url":"https://api.github.com/users/boycher","html_url":"https://github.com/boycher","followers_url":"https://api.github.com/users/boycher/followers","following_url":"https://api.github.com/users/boycher/following{/other_user}","gists_url":"https://api.github.com/users/boycher/gists{/gist_id}","starred_url":"https://api.github.com/users/boycher/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/boycher/subscriptions","organizations_url":"https://api.github.com/users/boycher/orgs","repos_url":"https://api.github.com/users/boycher/repos","events_url":"https://api.github.com/users/boycher/events{/privacy}","received_events_url":"https://api.github.com/users/boycher/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-04-14T04:23:18Z","updated_at":"2026-04-14T04:23:18Z","body":"@AThousandShips Thanks, I fixed all the broken up lines and made all the changes as you suggested. Also removed `Control::` from `log->set_anchor()`. \r\n\r\nActually I was using`Control::` for `log->set_offset()` because it exists in both RichTextLabel and Control. But after your suggestion I realised that `set_anchor()` only exists in Control and it's not necessary to use `Control::` for `log->set_anchor()` and I removed it.","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4241287609/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4319767831","html_url":"https://github.com/godotengine/godot/pull/118529#issuecomment-4319767831","issue_url":"https://api.github.com/repos/godotengine/godot/issues/118529","id":4319767831,"node_id":"IC_kwDOAO6SJc8AAAABAXptFw","user":{"login":"boycher","id":274249743,"node_id":"U_kgDOEFi4Dw","avatar_url":"https://avatars.githubusercontent.com/u/274249743?v=4","gravatar_id":"","url":"https://api.github.com/users/boycher","html_url":"https://github.com/boycher","followers_url":"https://api.github.com/users/boycher/followers","following_url":"https://api.github.com/users/boycher/following{/other_user}","gists_url":"https://api.github.com/users/boycher/gists{/gist_id}","starred_url":"https://api.github.com/users/boycher/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/boycher/subscriptions","organizations_url":"https://api.github.com/users/boycher/orgs","repos_url":"https://api.github.com/users/boycher/repos","events_url":"https://api.github.com/users/boycher/events{/privacy}","received_events_url":"https://api.github.com/users/boycher/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-04-25T13:59:26Z","updated_at":"2026-04-25T13:59:26Z","body":"> Why should this be a node that's available in production templates?\r\n\r\nCan you please explain me properly what do you mean?","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4319767831/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4319810231","html_url":"https://github.com/godotengine/godot/pull/118529#issuecomment-4319810231","issue_url":"https://api.github.com/repos/godotengine/godot/issues/118529","id":4319810231,"node_id":"IC_kwDOAO6SJc8AAAABAXsStw","user":{"login":"HolonProduction","id":99511741,"node_id":"U_kgDOBe5tvQ","avatar_url":"https://avatars.githubusercontent.com/u/99511741?v=4","gravatar_id":"","url":"https://api.github.com/users/HolonProduction","html_url":"https://github.com/HolonProduction","followers_url":"https://api.github.com/users/HolonProduction/followers","following_url":"https://api.github.com/users/HolonProduction/following{/other_user}","gists_url":"https://api.github.com/users/HolonProduction/gists{/gist_id}","starred_url":"https://api.github.com/users/HolonProduction/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/HolonProduction/subscriptions","organizations_url":"https://api.github.com/users/HolonProduction/orgs","repos_url":"https://api.github.com/users/HolonProduction/repos","events_url":"https://api.github.com/users/HolonProduction/events{/privacy}","received_events_url":"https://api.github.com/users/HolonProduction/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-04-25T14:19:30Z","updated_at":"2026-04-25T14:19:30Z","body":"> Can you please explain me properly what do you mean?\r\n\r\nWell the proposal describes a usecase that seems limited to developers debugging their project, so there really is no need to include it in the final shipped game, since players are not the target audience.\r\n\r\nImplementing this as a node however means, that this feature will be included in all builds that are shipped to users. I don't see any sufficient reason to increase the binary size for a feature that's only aimed at developers.","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4319810231/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4319940626","html_url":"https://github.com/godotengine/godot/pull/118529#issuecomment-4319940626","issue_url":"https://api.github.com/repos/godotengine/godot/issues/118529","id":4319940626,"node_id":"IC_kwDOAO6SJc8AAAABAX0QEg","user":{"login":"boycher","id":274249743,"node_id":"U_kgDOEFi4Dw","avatar_url":"https://avatars.githubusercontent.com/u/274249743?v=4","gravatar_id":"","url":"https://api.github.com/users/boycher","html_url":"https://github.com/boycher","followers_url":"https://api.github.com/users/boycher/followers","following_url":"https://api.github.com/users/boycher/following{/other_user}","gists_url":"https://api.github.com/users/boycher/gists{/gist_id}","starred_url":"https://api.github.com/users/boycher/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/boycher/subscriptions","organizations_url":"https://api.github.com/users/boycher/orgs","repos_url":"https://api.github.com/users/boycher/repos","events_url":"https://api.github.com/users/boycher/events{/privacy}","received_events_url":"https://api.github.com/users/boycher/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-04-25T15:22:30Z","updated_at":"2026-04-25T16:17:33Z","body":"> Well the proposal describes a usecase that seems limited to developers debugging their project, so there really is no need to include it in the final shipped game, since players are not the target audience.\r\n> \r\n> Implementing this as a node however means, that this feature will be included in all builds that are shipped to users. I don't see any sufficient reason to increase the binary size for a feature that's only aimed at developers.\r\n\r\nThat's really an important point to keep in mind and I completely agree that we should avoid any unnecessary files in production templates. But would it be possible to limit this node to be only included in editor or debug builds? Or any other approach we can follow to address this problem?\r\n\r\nAs you can see I already have a `Debug Only` toggle which makes the node invisible in the release builds but it is still included as a node. I don't think there is a way to strip out the node completely from the release builds.\r\n\r\nIf there is no solution, maybe I can look forward to convert this into a plugin so that people can use it if they really need it.","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4319940626/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4320183165","html_url":"https://github.com/godotengine/godot/pull/118529#issuecomment-4320183165","issue_url":"https://api.github.com/repos/godotengine/godot/issues/118529","id":4320183165,"node_id":"IC_kwDOAO6SJc8AAAABAYDDfQ","user":{"login":"Zireael07","id":4525388,"node_id":"MDQ6VXNlcjQ1MjUzODg=","avatar_url":"https://avatars.githubusercontent.com/u/4525388?v=4","gravatar_id":"","url":"https://api.github.com/users/Zireael07","html_url":"https://github.com/Zireael07","followers_url":"https://api.github.com/users/Zireael07/followers","following_url":"https://api.github.com/users/Zireael07/following{/other_user}","gists_url":"https://api.github.com/users/Zireael07/gists{/gist_id}","starred_url":"https://api.github.com/users/Zireael07/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Zireael07/subscriptions","organizations_url":"https://api.github.com/users/Zireael07/orgs","repos_url":"https://api.github.com/users/Zireael07/repos","events_url":"https://api.github.com/users/Zireael07/events{/privacy}","received_events_url":"https://api.github.com/users/Zireael07/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-04-25T17:32:27Z","updated_at":"2026-04-25T17:32:27Z","body":"@HolonProduction Note that a lot of games have a dev mode, cheats console, whatever you call it, so there *is* reason to include it in production builds","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4320183165/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4320327735","html_url":"https://github.com/godotengine/godot/pull/118529#issuecomment-4320327735","issue_url":"https://api.github.com/repos/godotengine/godot/issues/118529","id":4320327735,"node_id":"IC_kwDOAO6SJc8AAAABAYL4Nw","user":{"login":"HolonProduction","id":99511741,"node_id":"U_kgDOBe5tvQ","avatar_url":"https://avatars.githubusercontent.com/u/99511741?v=4","gravatar_id":"","url":"https://api.github.com/users/HolonProduction","html_url":"https://github.com/HolonProduction","followers_url":"https://api.github.com/users/HolonProduction/followers","following_url":"https://api.github.com/users/HolonProduction/following{/other_user}","gists_url":"https://api.github.com/users/HolonProduction/gists{/gist_id}","starred_url":"https://api.github.com/users/HolonProduction/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/HolonProduction/subscriptions","organizations_url":"https://api.github.com/users/HolonProduction/orgs","repos_url":"https://api.github.com/users/HolonProduction/repos","events_url":"https://api.github.com/users/HolonProduction/events{/privacy}","received_events_url":"https://api.github.com/users/HolonProduction/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-04-25T18:53:46Z","updated_at":"2026-04-25T18:53:46Z","body":"> I don't think there is a way to strip out the node completely from the release builds.\r\n\r\nIt would be technically possible somehow I think. But it really isn't a great idea, since it might break scenes that were created when the node was available.\r\n\r\n> Note that a lot of games have a dev mode, cheats console, whatever you call it, so there _is_ reason to include it in production builds\r\n\r\nThis PR is not a fully fledged console and the linked proposal isn't about that either. So I'm gonna look at this through the lens of what it is today, and not what it could become if we ever reach a consensus on whether we want to have a builtin debug-console.","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4320327735/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4321288153","html_url":"https://github.com/godotengine/godot/pull/118529#issuecomment-4321288153","issue_url":"https://api.github.com/repos/godotengine/godot/issues/118529","id":4321288153,"node_id":"IC_kwDOAO6SJc8AAAABAZGf2Q","user":{"login":"boycher","id":274249743,"node_id":"U_kgDOEFi4Dw","avatar_url":"https://avatars.githubusercontent.com/u/274249743?v=4","gravatar_id":"","url":"https://api.github.com/users/boycher","html_url":"https://github.com/boycher","followers_url":"https://api.github.com/users/boycher/followers","following_url":"https://api.github.com/users/boycher/following{/other_user}","gists_url":"https://api.github.com/users/boycher/gists{/gist_id}","starred_url":"https://api.github.com/users/boycher/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/boycher/subscriptions","organizations_url":"https://api.github.com/users/boycher/orgs","repos_url":"https://api.github.com/users/boycher/repos","events_url":"https://api.github.com/users/boycher/events{/privacy}","received_events_url":"https://api.github.com/users/boycher/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-04-26T04:56:05Z","updated_at":"2026-04-26T09:44:21Z","body":"@HolonProduction I know it's a feature aimed for the developers but not completely. I think there is a reason we can include this in the final shipped product and @Zireael07 makes a great point. Its not a proper console for now but it's a window to see whats happening inside the engine. And I believe we can turn this into a full fledged console in the future.\r\n\r\nAs we can see Godot is not only used for making games but also used for making a variety of tools. In those types of applications, having a built in way to display logs is often a requirement for the final shipped product.","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4321288153/reactions","total_count":3,"+1":3,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4321721713","html_url":"https://github.com/godotengine/godot/pull/118529#issuecomment-4321721713","issue_url":"https://api.github.com/repos/godotengine/godot/issues/118529","id":4321721713,"node_id":"IC_kwDOAO6SJc8AAAABAZg9cQ","user":{"login":"Zireael07","id":4525388,"node_id":"MDQ6VXNlcjQ1MjUzODg=","avatar_url":"https://avatars.githubusercontent.com/u/4525388?v=4","gravatar_id":"","url":"https://api.github.com/users/Zireael07","html_url":"https://github.com/Zireael07","followers_url":"https://api.github.com/users/Zireael07/followers","following_url":"https://api.github.com/users/Zireael07/following{/other_user}","gists_url":"https://api.github.com/users/Zireael07/gists{/gist_id}","starred_url":"https://api.github.com/users/Zireael07/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Zireael07/subscriptions","organizations_url":"https://api.github.com/users/Zireael07/orgs","repos_url":"https://api.github.com/users/Zireael07/repos","events_url":"https://api.github.com/users/Zireael07/events{/privacy}","received_events_url":"https://api.github.com/users/Zireael07/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-04-26T09:27:07Z","updated_at":"2026-04-26T09:27:07Z","body":"Even if it's not a full fledged console I believe it may be useful in production ","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4321721713/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4394112783","html_url":"https://github.com/godotengine/godot/pull/118529#issuecomment-4394112783","issue_url":"https://api.github.com/repos/godotengine/godot/issues/118529","id":4394112783,"node_id":"IC_kwDOAO6SJc8AAAABBejXDw","user":{"login":"chocola-mint","id":56677134,"node_id":"MDQ6VXNlcjU2Njc3MTM0","avatar_url":"https://avatars.githubusercontent.com/u/56677134?v=4","gravatar_id":"","url":"https://api.github.com/users/chocola-mint","html_url":"https://github.com/chocola-mint","followers_url":"https://api.github.com/users/chocola-mint/followers","following_url":"https://api.github.com/users/chocola-mint/following{/other_user}","gists_url":"https://api.github.com/users/chocola-mint/gists{/gist_id}","starred_url":"https://api.github.com/users/chocola-mint/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/chocola-mint/subscriptions","organizations_url":"https://api.github.com/users/chocola-mint/orgs","repos_url":"https://api.github.com/users/chocola-mint/repos","events_url":"https://api.github.com/users/chocola-mint/events{/privacy}","received_events_url":"https://api.github.com/users/chocola-mint/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-05-07T04:11:44Z","updated_at":"2026-05-07T04:11:44Z","body":"Some feedback:\r\n* Requiring the user to add the `OutputPanel` node manually means it is near impossible to erase traces of it from a release build, even with compile flags. (Since otherwise the scene wouldn't be loadable)\r\n* This `OutputPanel` is also very awkward to work with if your project is set up with very low viewport resolution. (for pixel art aesthetics)\r\n  * If the engine is going to provide ingame console capabilities I do think it should take advantage of being within the engine core and be always rendered as a resolution-independent overlay over your game. In this case it should not even be a Node at all. Note that this is something that you can't easily achieve with a plugin so I do think there's value here.\r\n* However, do keep in mind that there are already existing plugins for ingame debug consoles such as https://github.com/limbonaut/limbo_console . If this is to be added it *really* should provide better value otherwise it'll just end up bloating the core without helping anyone.","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4394112783/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4406918486","html_url":"https://github.com/godotengine/godot/pull/118529#issuecomment-4406918486","issue_url":"https://api.github.com/repos/godotengine/godot/issues/118529","id":4406918486,"node_id":"IC_kwDOAO6SJc8AAAABBqw9Vg","user":{"login":"boycher","id":274249743,"node_id":"U_kgDOEFi4Dw","avatar_url":"https://avatars.githubusercontent.com/u/274249743?v=4","gravatar_id":"","url":"https://api.github.com/users/boycher","html_url":"https://github.com/boycher","followers_url":"https://api.github.com/users/boycher/followers","following_url":"https://api.github.com/users/boycher/following{/other_user}","gists_url":"https://api.github.com/users/boycher/gists{/gist_id}","starred_url":"https://api.github.com/users/boycher/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/boycher/subscriptions","organizations_url":"https://api.github.com/users/boycher/orgs","repos_url":"https://api.github.com/users/boycher/repos","events_url":"https://api.github.com/users/boycher/events{/privacy}","received_events_url":"https://api.github.com/users/boycher/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-05-08T13:48:41Z","updated_at":"2026-05-08T13:48:41Z","body":"Thanks for the feedback, those are actually good points. I see why a Node is a bad idea. But now I think I have a much better approach to get the prints and errors in-game that avoids those problems entirely.\r\n\r\nInstead of adding a Control Node, what if we just expose the print and error calls to GDScript? This way, the developers can choose exactly how to display or log the data (like appending to a RichTextLabel or saving to a file) only when they actually need it.\r\n\r\n```\r\nfunc _ready():\r\n    OS.add_print_callback(_on_print)\r\n    OS.add_error_callback(_on_error)\r\n\r\nfunc _on_print(text: String, is_error: bool, is_rich: bool):\r\n    $RichTextLabel.append_text(text + \"\\n\")\r\n\r\nfunc _on_error(file: String, line: int, error: String, expression: String, type: int):\r\n    var prefix = \"WARNING: \" if type == 1 else \"ERROR: \"\r\n    var msg = expression if expression else \"%s:%d - %s\" % [file, line, error]\r\n    $RichTextLabel.append_text(prefix + msg + \"\\n\")\r\n```\r\n\r\nI don't know if this is a great idea but just asking.\r\nLet me know your thoughts on this so I can start working on this.\r\n\r\n","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4406918486/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4407057353","html_url":"https://github.com/godotengine/godot/pull/118529#issuecomment-4407057353","issue_url":"https://api.github.com/repos/godotengine/godot/issues/118529","id":4407057353,"node_id":"IC_kwDOAO6SJc8AAAABBq5byQ","user":{"login":"chocola-mint","id":56677134,"node_id":"MDQ6VXNlcjU2Njc3MTM0","avatar_url":"https://avatars.githubusercontent.com/u/56677134?v=4","gravatar_id":"","url":"https://api.github.com/users/chocola-mint","html_url":"https://github.com/chocola-mint","followers_url":"https://api.github.com/users/chocola-mint/followers","following_url":"https://api.github.com/users/chocola-mint/following{/other_user}","gists_url":"https://api.github.com/users/chocola-mint/gists{/gist_id}","starred_url":"https://api.github.com/users/chocola-mint/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/chocola-mint/subscriptions","organizations_url":"https://api.github.com/users/chocola-mint/orgs","repos_url":"https://api.github.com/users/chocola-mint/repos","events_url":"https://api.github.com/users/chocola-mint/events{/privacy}","received_events_url":"https://api.github.com/users/chocola-mint/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-05-08T14:09:44Z","updated_at":"2026-05-08T14:09:44Z","body":"> Instead of adding a Control Node, what if we just expose the print and error calls to GDScript? This way, the developers can choose exactly how to display or log the data (like appending to a RichTextLabel or saving to a file) only when they actually need it.\r\n\r\nSo... Basically [custom loggers](https://docs.godotengine.org/en/stable/tutorials/scripting/logging.html#creating-custom-loggers). Likely completely unnecessary in this case, then.","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4407057353/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4407544228","html_url":"https://github.com/godotengine/godot/pull/118529#issuecomment-4407544228","issue_url":"https://api.github.com/repos/godotengine/godot/issues/118529","id":4407544228,"node_id":"IC_kwDOAO6SJc8AAAABBrXJpA","user":{"login":"boycher","id":274249743,"node_id":"U_kgDOEFi4Dw","avatar_url":"https://avatars.githubusercontent.com/u/274249743?v=4","gravatar_id":"","url":"https://api.github.com/users/boycher","html_url":"https://github.com/boycher","followers_url":"https://api.github.com/users/boycher/followers","following_url":"https://api.github.com/users/boycher/following{/other_user}","gists_url":"https://api.github.com/users/boycher/gists{/gist_id}","starred_url":"https://api.github.com/users/boycher/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/boycher/subscriptions","organizations_url":"https://api.github.com/users/boycher/orgs","repos_url":"https://api.github.com/users/boycher/repos","events_url":"https://api.github.com/users/boycher/events{/privacy}","received_events_url":"https://api.github.com/users/boycher/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-05-08T15:16:43Z","updated_at":"2026-05-08T15:16:43Z","body":"Closed this because `OutputPanel` is a node that has a use case only limited to the developers and not for the final players of the game. It will end up with unnecessary bloat in the engine's core and the final shipped game. If someone really wanted to show up the output logs in-game, they can use custom logger or plugins available in the Godot asset library.","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4407544228/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null}]