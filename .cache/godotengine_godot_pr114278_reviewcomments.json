12-22T18:04:42Z","html_url":"https://github.com/godotengine/godot/pull/114278#discussion_r2640762119","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/114278","_links":{"self":{"href":"https://api.github.com/repos/godotengine/godot/pulls/comments/2640762119"},"html":{"href":"https://github.com/godotengine/godot/pull/114278#discussion_r2640762119"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/114278"}},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/2640762119/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":2955,"start_side":"RIGHT","line":null,"original_line":2962,"side":"RIGHT","in_reply_to_id":2639618205,"author_association":"MEMBER","original_position":11,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/2667787941","pull_request_review_id":3634136693,"id":2667787941,"node_id":"PRRC_kwDOAO6SJc6fAzal","diff_hunk":"@@ -2952,7 +2952,7 @@ bool EditorInspectorPluginTileData::parse_property(Object *p_object, const Varia\n \t\t\tint polygon_index = components[1].trim_prefix(\"polygon_\").to_int();\n \t\t\tERR_FAIL_COND_V(polygon_index < 0, false);\n \t\t\tif (components[2] == \"points\") {\n-\t\t\t\treturn true;\n+\t\t\t\treturn false;","path":"editor/scene/2d/tiles/tile_set_atlas_source_editor.cpp","commit_id":"caf7a2e0984487a2f41054fa1deb6b450ba38814","original_commit_id":"caf7a2e0984487a2f41054fa1deb6b450ba38814","user":{"login":"groud","id":6093119,"node_id":"MDQ6VXNlcjYwOTMxMTk=","avatar_url":"https://avatars.githubusercontent.com/u/6093119?v=4","gravatar_id":"","url":"https://api.github.com/users/groud","html_url":"https://github.com/groud","followers_url":"https://api.github.com/users/groud/followers","following_url":"https://api.github.com/users/groud/following{/other_user}","gists_url":"https://api.github.com/users/groud/gists{/gist_id}","starred_url":"https://api.github.com/users/groud/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/groud/subscriptions","organizations_url":"https://api.github.com/users/groud/orgs","repos_url":"https://api.github.com/users/groud/repos","events_url":"https://api.github.com/users/groud/events{/privacy}","received_events_url":"https://api.github.com/users/groud/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"You can remove the whole condition there, the default behavior of the function is to return `false`.","created_at":"2026-01-07T10:00:26Z","updated_at":"2026-01-07T10:00:27Z","html_url":"https://github.com/godotengine/godot/pull/114278#discussion_r2667787941","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/114278","_links":{"self":{"href":"https://api.github.com/repos/godotengine/godot/pulls/comments/2667787941"},"html":{"href":"https://github.com/godotengine/godot/pull/114278#discussion_r2667787941"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/114278"}},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/2667787941/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":null,"original_line":2955,"side":"RIGHT","author_association":"MEMBER","original_position":5,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/2667801469","pull_request_review_id":3634151241,"id":2667801469,"node_id":"PRRC_kwDOAO6SJc6fA2t9","diff_hunk":"@@ -6399,11 +6399,10 @@ void TileData::remove_collision_polygon(int p_layer_id, int p_polygon_index) {\n void TileData::set_collision_polygon_points(int p_layer_id, int p_polygon_index, Vector<Vector2> p_polygon) {\n \tERR_FAIL_INDEX(p_layer_id, physics.size());\n \tERR_FAIL_INDEX(p_polygon_index, physics[p_layer_id].polygons.size());\n-\tERR_FAIL_COND_MSG(p_polygon.size() != 0 && p_polygon.size() < 3, \"Invalid polygon. Needs either 0 or at least 3 points.\");","path":"scene/resources/2d/tile_set.cpp","commit_id":"20dc1ee875b88bc80c3c52af38fabe3360c1bb97","original_commit_id":"caf7a2e0984487a2f41054fa1deb6b450ba38814","user":{"login":"groud","id":6093119,"node_id":"MDQ6VXNlcjYwOTMxMTk=","avatar_url":"https://avatars.githubusercontent.com/u/6093119?v=4","gravatar_id":"","url":"https://api.github.com/users/groud","html_url":"https://github.com/groud","followers_url":"https://api.github.com/users/groud/followers","following_url":"https://api.github.com/users/groud/following{/other_user}","gists_url":"https://api.github.com/users/groud/gists{/gist_id}","starred_url":"https://api.github.com/users/groud/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/groud/subscriptions","organizations_url":"https://api.github.com/users/groud/orgs","repos_url":"https://api.github.com/users/groud/repos","events_url":"https://api.github.com/users/groud/events{/privacy}","received_events_url":"https://api.github.com/users/groud/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"That's not the right way to do it. Either TileData should fully support story polygons with `size < 3` (and TileMapLayer and editors should check before using it), or it should throw an error.\r\n\r\nYou can't just remove the error message and just make the function internally clear the polygon, this is just hiding an unexpected behavior to the user.\r\n\r\nEdit: to make it clearer. If you call a setter like `set_something(my_data)` and it shows no error, then a call to `get_something()` should return `my_data`, otherwise that is quite a confusing behavior for an API.","created_at":"2026-01-07T10:03:17Z","updated_at":"2026-01-07T10:05:52Z","html_url":"https://github.com/godotengine/godot/pull/114278#discussion_r2667801469","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/114278","_links":{"self":{"href":"https://api.github.com/repos/godotengine/godot/pulls/comments/2667801469"},"html":{"href":"https://github.com/godotengine/godot/pull/114278#discussion_r2667801469"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/114278"}},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/2667801469/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":6415,"original_line":6402,"side":"LEFT","author_association":"MEMBER","original_position":4,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/2669047285","pull_request_review_id":3635591527,"id":2669047285,"node_id":"PRRC_kwDOAO6SJc6fFm31","diff_hunk":"@@ -6399,11 +6399,10 @@ void TileData::remove_collision_polygon(int p_layer_id, int p_polygon_index) {\n void TileData::set_collision_polygon_points(int p_layer_id, int p_polygon_index, Vector<Vector2> p_polygon) {\n \tERR_FAIL_INDEX(p_layer_id, physics.size());\n \tERR_FAIL_INDEX(p_polygon_index, physics[p_layer_id].polygons.size());\n-\tERR_FAIL_COND_MSG(p_polygon.size() != 0 && p_polygon.size() < 3, \"Invalid polygon. Needs either 0 or at least 3 points.\");","path":"scene/resources/2d/tile_set.cpp","commit_id":"20dc1ee875b88bc80c3c52af38fabe3360c1bb97","original_commit_id":"caf7a2e0984487a2f41054fa1deb6b450ba38814","user":{"login":"Meorge","id":9957987,"node_id":"MDQ6VXNlcjk5NTc5ODc=","avatar_url":"https://avatars.githubusercontent.com/u/9957987?v=4","gravatar_id":"","url":"https://api.github.com/users/Meorge","html_url":"https://github.com/Meorge","followers_url":"https://api.github.com/users/Meorge/followers","following_url":"https://api.github.com/users/Meorge/following{/other_user}","gists_url":"https://api.github.com/users/Meorge/gists{/gist_id}","starred_url":"https://api.github.com/users/Meorge/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Meorge/subscriptions","organizations_url":"https://api.github.com/users/Meorge/orgs","repos_url":"https://api.github.com/users/Meorge/repos","events_url":"https://api.github.com/users/Meorge/events{/privacy}","received_events_url":"https://api.github.com/users/Meorge/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"Ah yes, that does make sense, thanks!\r\n\r\nTo address this, I'm currently thinking of saving incomplete polygons (i.e., `size < 3`) to a separate internal data structure from the one used by the physics engine. This way, if the getter is called, it can return that incomplete polygon, while on the internal physics engine side no polygon is processed; since collision for polygons with `size < 3` is ill-defined to my knowledge, it doesn't make sense to try to give it any such polygons. Does this sound like it'd be an OK approach? I can try to clarify or just implement it and push it to the PR if my explanation was confusing 😅","created_at":"2026-01-07T16:01:24Z","updated_at":"2026-01-07T16:01:24Z","html_url":"https://github.com/godotengine/godot/pull/114278#discussion_r2669047285","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/114278","_links":{"self":{"href":"https://api.github.com/repos/godotengine/godot/pulls/comments/2669047285"},"html":{"href":"https://github.com/godotengine/godot/pull/114278#discussion_r2669047285"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/114278"}},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/2669047285/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":6415,"original_line":6402,"side":"LEFT","in_reply_to_id":2667801469,"author_association":"CONTRIBUTOR","original_position":4,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/2669075298","pull_request_review_id":3635625410,"id":2669075298,"node_id":"PRRC_kwDOAO6SJc6fFtti","diff_hunk":"@@ -6399,11 +6399,10 @@ void TileData::remove_collision_polygon(int p_layer_id, int p_polygon_index) {\n void TileData::set_collision_polygon_points(int p_layer_id, int p_polygon_index, Vector<Vector2> p_polygon) {\n \tERR_FAIL_INDEX(p_layer_id, physics.size());\n \tERR_FAIL_INDEX(p_polygon_index, physics[p_layer_id].polygons.size());\n-\tERR_FAIL_COND_MSG(p_polygon.size() != 0 && p_polygon.size() < 3, \"Invalid polygon. Needs either 0 or at least 3 points.\");","path":"scene/resources/2d/tile_set.cpp","commit_id":"20dc1ee875b88bc80c3c52af38fabe3360c1bb97","original_commit_id":"caf7a2e0984487a2f41054fa1deb6b450ba38814","user":{"login":"groud","id":6093119,"node_id":"MDQ6VXNlcjYwOTMxMTk=","avatar_url":"https://avatars.githubusercontent.com/u/6093119?v=4","gravatar_id":"","url":"https://api.github.com/users/groud","html_url":"https://github.com/groud","followers_url":"https://api.github.com/users/groud/followers","following_url":"https://api.github.com/users/groud/following{/other_user}","gists_url":"https://api.github.com/users/groud/gists{/gist_id}","starred_url":"https://api.github.com/users/groud/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/groud/subscriptions","organizations_url":"https://api.github.com/users/groud/orgs","repos_url":"https://api.github.com/users/groud/repos","events_url":"https://api.github.com/users/groud/events{/privacy}","received_events_url":"https://api.github.com/users/groud/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"I don't think there's a need to overcomplicate it. Just check where `get_collision_polygon_points()` is called (or `physics[p_layer_id].polygons[p_polygon_index].polygon` is used directly) in the codebase and replace checks for `size == 0` for `size < 3`. (