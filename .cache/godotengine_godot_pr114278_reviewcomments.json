[{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/2639618205","pull_request_review_id":3603759448,"id":2639618205,"node_id":"PRRC_kwDOAO6SJc6dVWCd","diff_hunk":"@@ -2952,6 +2952,13 @@ bool EditorInspectorPluginTileData::parse_property(Object *p_object, const Varia\n \t\t\tint polygon_index = components[1].trim_prefix(\"polygon_\").to_int();\n \t\t\tERR_FAIL_COND_V(polygon_index < 0, false);\n \t\t\tif (components[2] == \"points\") {\n+\t\t\t\tEditorProperty *ep = EditorInspectorDefaultPlugin::get_editor_for_property(p_object, p_type, p_path, PROPERTY_HINT_NONE, \"\", PROPERTY_USAGE_DEFAULT);\n+\t\t\t\tconst TileSetAtlasSourceEditor::AtlasTileProxyObject *proxy_obj = Object::cast_to<TileSetAtlasSourceEditor::AtlasTileProxyObject>(p_object);\n+\t\t\t\tconst TileSetAtlasSource *atlas_source = *proxy_obj->get_edited_tile_set_atlas_source();\n+\t\t\t\tERR_FAIL_NULL_V(atlas_source, false);\n+\t\t\t\tconst TileSet *tile_set = atlas_source->get_tile_set();\n+\t\t\t\tERR_FAIL_NULL_V(tile_set, false);\n+\t\t\t\tadd_property_editor(p_path, ep);\n \t\t\t\treturn true;","path":"editor/scene/2d/tiles/tile_set_atlas_source_editor.cpp","commit_id":"5d69138c54aa9d3d8896d8d2c44bd9f44bcb62c6","original_commit_id":"5d69138c54aa9d3d8896d8d2c44bd9f44bcb62c6","user":{"login":"kleonc","id":9283098,"node_id":"MDQ6VXNlcjkyODMwOTg=","avatar_url":"https://avatars.githubusercontent.com/u/9283098?v=4","gravatar_id":"","url":"https://api.github.com/users/kleonc","html_url":"https://github.com/kleonc","followers_url":"https://api.github.com/users/kleonc/followers","following_url":"https://api.github.com/users/kleonc/following{/other_user}","gists_url":"https://api.github.com/users/kleonc/gists{/gist_id}","starred_url":"https://api.github.com/users/kleonc/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/kleonc/subscriptions","organizations_url":"https://api.github.com/users/kleonc/orgs","repos_url":"https://api.github.com/users/kleonc/repos","events_url