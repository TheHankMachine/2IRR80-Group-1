":410064485,"node_id":"MDU6TGFiZWw0MTAwNjQ0ODU=","url":"https://api.github.com/repos/godotengine/godot/labels/needs%20testing","name":"needs testing","color":"ffcc44","default":false,"description":"","archived_at":null,"archived_by":null},{"id":1332303119,"node_id":"MDU6TGFiZWwxMzMyMzAzMTE5","url":"https://api.github.com/repos/godotengine/godot/labels/regression","name":"regression","color":"ff63ac","default":false,"description":"","archived_at":null,"archived_by":null}],"state":"open","locked":false,"assignees":[],"milestone":{"url":"https://api.github.com/repos/godotengine/godot/milestones/16","html_url":"https://github.com/godotengine/godot/milestone/16","labels_url":"https://api.github.com/repos/godotengine/godot/milestones/16/labels","id":8237783,"node_id":"MI_kwDOAO6SJc4AfbLX","number":16,"title":"4.x","description":"Issues and pull requests slated for an undetermined Godot 4 release.","creator":{"login":"akien-mga","id":4701338,"node_id":"MDQ6VXNlcjQ3MDEzMzg=","avatar_url":"https://avatars.githubusercontent.com/u/4701338?v=4","gravatar_id":"","url":"https://api.github.com/users/akien-mga","html_url":"https://github.com/akien-mga","followers_url":"https://api.github.com/users/akien-mga/followers","following_url":"https://api.github.com/users/akien-mga/following{/other_user}","gists_url":"https://api.github.com/users/akien-mga/gists{/gist_id}","starred_url":"https://api.github.com/users/akien-mga/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/akien-mga/subscriptions","organizations_url":"https://api.github.com/users/akien-mga/orgs","repos_url":"https://api.github.com/users/akien-mga/repos","events_url":"https://api.github.com/users/akien-mga/events{/privacy}","received_events_url":"https://api.github.com/users/akien-mga/received_events","type":"User","user_view_type":"public","site_admin":false},"open_issues":5790,"closed_issues":0,"state":"open","created_at":"2022-07-26T12:42:05Z","updated_at":"2026-10-22T08:16:48Z","due_on":null,"closed_at":null},"comments":3,"created_at":"2026-10-09T03:33:29Z","updated_at":"2026-10-09T12:32:12Z","closed_at":null,"assignee":null,"author_association":"NONE","issue_field_values":[],"type":null,"active_lock_reason":null,"draft":false,"pull_request":{"url":"https://api.github.com/repos/godotengine/godot/pulls/124313","html_url":"https://github.com/godotengine/godot/pull/124313","diff_url":"https://github.com/godotengine/godot/pull/124313.diff","patch_url":"https://github.com/godotengine/godot/pull/124313.patch","merged_at":null},"body":"Fixed CommandQueueMT race condition/thread deadlock during physics sync processing. Issue [123654](https://github.com/godotengine/godot/issues/123654)\r\n\r\nPR #117268 changed the time-ordering rules so that any physics command sent while physics processing is active forces an immediate, synchronous flush. This was meant to keep queries from reading stale data, but it completely broke when high-level script callbacks like _integrate_forces called an immediate method like apply_torque.\r\n\r\nBecause _integrate_forces executes directly on the background physics thread, calling apply_torque triggers the new flush rule recursively. The queue looks at its own binary flushing flag, sees a flush is already active, and tells the thread to wait on itself via sync(). This hits a wall where the physics thread goes to sleep and waits for itself to wake up.\r\n\r\nI fixed this by making the command queue template self-aware. I replaced the boolean flag with a thread ID tracker ('flushing_thread_id'). Now at the start of _flush() the queue checks who called it using Thread::get_caller_id(). If the thread demanding a synchronous flush is the same thread already processing the active flush loop, the queue recognizes the self-referential call, bypasses the lock condition entirely, and returns safely.\r\n\r\nVerified via core unit test suite (418,881 assertions passed) and the torque_callback_repro test project.\r\n\r\nI used Gemini for research concerning all of these functions.\r\n\r\n* *Bugsquad edit, fixes: https://github.com/godotengine/godot/issues/123654*","closed_by":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/124313/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/godotengine/godot/issues/124313/timeline","performed_via_github_app":null,"state_reason":null}