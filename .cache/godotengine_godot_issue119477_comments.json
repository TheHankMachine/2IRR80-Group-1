=\"image\" src=\"https://github.com/user-attachments/assets/a582c042-d20f-4563-bf22-ec0f8192ddb9\" />\r\n<img width=\"222\" height=\"415\" alt=\"image\" src=\"https://github.com/user-attachments/assets/6ff44057-3a0a-4421-803b-31ba1fee28af\" />\r\n\r\n","author_association":"NONE","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4665834268/reactions","total_count":3,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":3,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4670239334","html_url":"https://github.com/godotengine/godot/pull/119477#issuecomment-4670239334","issue_url":"https://api.github.com/repos/godotengine/godot/issues/119477","id":4670239334,"node_id":"IC_kwDOAO6SJc8AAAABFl4yZg","user":{"login":"KoBeWi","id":2223172,"node_id":"MDQ6VXNlcjIyMjMxNzI=","avatar_url":"https://avatars.githubusercontent.com/u/2223172?v=4","gravatar_id":"","url":"https://api.github.com/users/KoBeWi","html_url":"https://github.com/KoBeWi","followers_url":"https://api.github.com/users/KoBeWi/followers","following_url":"https://api.github.com/users/KoBeWi/following{/other_user}","gists_url":"https://api.github.com/users/KoBeWi/gists{/gist_id}","starred_url":"https://api.github.com/users/KoBeWi/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/KoBeWi/subscriptions","organizations_url":"https://api.github.com/users/KoBeWi/orgs","repos_url":"https://api.github.com/users/KoBeWi/repos","events_url":"https://api.github.com/users/KoBeWi/events{/privacy}","received_events_url":"https://api.github.com/users/KoBeWi/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-06-10T12:35:34Z","updated_at":"2026-06-10T12:36:53Z","body":"The search is cumbersome to use in the current form. You need to type the class name exactly, so e.g. if you want to search for textures, you need to type `t:CompressedTexture2D`, and that won't even list all textures depending on how they are imported.\r\n\r\nYou could take inspiration from Scene dock's type filtering. It matches base types and allows partial matches, so e.g. `t:phys` will show all physics-based nodes (CharacterBody3D, StaticBody2D etc.).\r\n\r\nAs for the original filter options, a list of _all_ classes does not look useful, and filter buttons take too much space. However the category filters from the comment above look neat, so that could be implemented too (not in this PR though).","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4670239334/reactions","total_count":5,"+1":5,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4672588141","html_url":"https://github.com/godotengine/godot/pull/119477#issuecomment-4672588141","issue_url":"https://api.github.com/repos/godotengine/godot/issues/119477","id":4672588141,"node_id":"IC_kwDOAO6SJc8AAAABFoIJbQ","user":{"login":"Quatumus","id":82884848,"node_id":"MDQ6VXNlcjgyODg0ODQ4","avatar_url":"https://avatars.githubusercontent.com/u/82884848?v=4","gravatar_id":"","url":"https://api.github.com/users/Quatumus","html_url":"https://github.com/Quatumus","followers_url":"https://api.github.com/users/Quatumus/followers","following_url":"https://api.github.com/users/Quatumus/following{/other_user}","gists_url":"https://api.github.com/users/Quatumus/gists{/gist_id}","starred_url":"https://api.github.com/users/Quatumus/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Quatumus/subscriptions","organizations_url":"https://api.github.com/users/Quatumus/orgs","repos_url":"https://api.github.com/users/Quatumus/repos","events_url":"https://api.github.com/users/Quatumus/events{/privacy}","received_events_url":"https://api.github.com/users/Quatumus/received_events","type