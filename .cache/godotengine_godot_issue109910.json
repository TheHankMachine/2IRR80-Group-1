-mga/gists{/gist_id}","starred_url":"https://api.github.com/users/akien-mga/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/akien-mga/subscriptions","organizations_url":"https://api.github.com/users/akien-mga/orgs","repos_url":"https://api.github.com/users/akien-mga/repos","events_url":"https://api.github.com/users/akien-mga/events{/privacy}","received_events_url":"https://api.github.com/users/akien-mga/received_events","type":"User","user_view_type":"public","site_admin":false},"open_issues":3,"closed_issues":2535,"state":"closed","created_at":"2025-11-27T20:29:18Z","updated_at":"2026-10-20T18:39:31Z","due_on":null,"closed_at":"2026-06-19T16:54:35Z"},"comments":1,"created_at":"2025-08-23T14:50:39Z","updated_at":"2026-01-28T22:19:50Z","closed_at":"2026-01-28T18:33:19Z","assignee":{"login":"bruvzg","id":7645683,"node_id":"MDQ6VXNlcjc2NDU2ODM=","avatar_url":"https://avatars.githubusercontent.com/u/7645683?v=4","gravatar_id":"","url":"https://api.github.com/users/bruvzg","html_url":"https://github.com/bruvzg","followers_url":"https://api.github.com/users/bruvzg/followers","following_url":"https://api.github.com/users/bruvzg/following{/other_user}","gists_url":"https://api.github.com/users/bruvzg/gists{/gist_id}","starred_url":"https://api.github.com/users/bruvzg/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/bruvzg/subscriptions","organizations_url":"https://api.github.com/users/bruvzg/orgs","repos_url":"https://api.github.com/users/bruvzg/repos","events_url":"https://api.github.com/users/bruvzg/events{/privacy}","received_events_url":"https://api.github.com/users/bruvzg/received_events","type":"User","user_view_type":"public","site_admin":false},"author_association":"CONTRIBUTOR","issue_field_values":[],"type":null,"active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"### Tested versions\n\n- Reproducible in b432e108d50fd436d04d0f79b0a7cab8985032f7 and 4.4.1 (haven't tested other versions)\n\n### System information\n\nmacOS 15.6.1 (24G90)\n\n### Issue description\n\nThe macOS version of godot exports a lot of unneeded symbols. This causes executable size bloat and inefficiencies as these symbols need to be resolved at run-time. It can also cause crashes when using an external shared library that includes the same symbols. In the case that I ran into, there is a conflict between JoltPhysicsSharp (a C# wrapper around Jolt Physics) and the godot_jolt module. For some reason, some symbols in JoltPhysicsSharp resolved by accident to a symbol in godot_jolt causing a crash due to code mismatch.\n\nSee conversation at https://github.com/jrouwe/JoltPhysics/issues/1617\n\nOn Windows the exported symbol list is very small:\n\n```\ndumpbin /exports Godot_v4.4.1-stable_mono_win64.exe > windows.txt\n```\n\n[windows.txt](https://github.com/user-attachments/files/21949795/windows.txt)\n\nOn Linux it is also very small:\n\n```\nobjdump -T Godot_v4.4.1-stable_mono_linux.x86_64 > linux.txt\n```\n\n[linux.txt](https://github.com/user-attachments/files/21949797/linux.txt)\n\nOn macOS the list is very large and includes many internal libraries (e.g. zlib):\n\n```\nnm -gU Godot_mono.app/Contents/MacOS/Godot > macos.txt\n```\n\n[macos.txt](https://github.com/user-attachments/files/21949796/macos.txt)\n\nThis seems to be caused by the default symbol visibility on mac being 'default' instead of 'hidden'. This means that all functions (even those not explicitly marked for export) are exported.\n\nIt is possible to fix this by adding the `-fvisibility=hidden` compile option, and I have verified that if I set this for the jolt module:\n\nhttps://github.com/godotengine/godot/compare/master...jrouwe:godot:visibility_hidden\n\nthat the Jolt exported symbols and crash go away. I think this flag should be set on a more global scope, which I'm happy to do, but I first wanted to start a discussion if this is indeed unintended.\n\ncc @mihe \n\n### Steps to reproduce\n\nOn an ARM mac run the JoltCrash project and observe it crashing.\n\n### Minimal reproduction project (MRP)\n\n[JoltCrash.zip](https://github.com/user-attachments/files/21076162/JoltCrash.zip)","closed_by":{"login":"Repiteo","id":17489292,"node_id":"MDQ6VXNlcjE3NDg5Mjky","avatar_url":"https://avatars.githubusercontent.com/u/17489292?v=4","gravatar_id":"","url":"https://api.github.com/users/Repiteo","html_url":"https://github.com/Repiteo","followers_url":"https://api.github.com/users/Repiteo/followers","following_url":"https://api.github.com/users/Repiteo/following{/other_user}","gists_url":"https://api.github.com/users/Repiteo/gists{/gist_id}","starred_url":"https://api.github.com/users/Repiteo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Repiteo/subscriptions","organizations_url":"https://api.github.com/users/Repiteo/orgs","repos_url":"https://api.github.com/users/Repiteo/repos","events_url":"https://api.github.com/users/Repiteo/events{/privacy}","received_events_url":"https://api.github.com/users/Repiteo/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/109910/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/godotengine/godot/issues/109910/timeline","performed_via_github_app":null,"state_reason":"completed","pinned_comment":null}