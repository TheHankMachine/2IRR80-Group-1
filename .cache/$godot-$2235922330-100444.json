 just moves the mouse into a rectangle).","html_url":"https://github.com/godotengine/godot/pull/100444#pullrequestreview-2506178762","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/100444","author_association":"MEMBER","submitted_at":"2024-12-16T13:50:28Z"},{"id":2512892799,"node_id":"PRR_kwDOAO6SJc6Vx7N_","state":"APPROVED","user":{"site_admin":false,"suspended":false,"updated_at":"0001-01-01T00:00:00Z","avatar_url":"https://avatars.githubusercontent.com/u/50084500?u=188e88b24d6994108226c9c94ad225775258d6ef&v=4","created_at":"0001-01-01T00:00:00Z","followers":0,"following":0,"html_url":"https://github.com/Geometror","id":50084500,"node_id":"MDQ6VXNlcjUwMDg0NTAw","login":"Geometror","type":"User","owned_private_repos":0,"public_gists":0,"public_repos":0,"total_private_repos":0,"url":"https://api.github.com/users/Geometror"},"body":"","html_url":"https://github.com/godotengine/godot/pull/100444#pullrequestreview-2512892799","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/100444","author_association":"MEMBER","submitted_at":"2024-12-18T21:24:26Z"},{"id":2514928150,"node_id":"PRR_kwDOAO6SJc6V5sIW","state":"COMMENTED","user":{"site_admin":false,"suspended":false,"updated_at":"0001-01-01T00:00:00Z","avatar_url":"https://avatars.githubusercontent.com/u/2223172?u=fc85633b469acb6e7baef4dba5171f19a2a4ff85&v=4","created_at":"0001-01-01T00:00:00Z","followers":0,"following":0,"html_url":"https://github.com/KoBeWi","id":2223172,"node_id":"MDQ6VXNlcjIyMjMxNzI=","login":"KoBeWi","type":"User","owned_private_repos":0,"public_gists":0,"public_repos":0,"total_private_repos":0,"url":"https://api.github.com/users/KoBeWi"},"body":"","html_url":"https://github.com/godotengine/godot/pull/100444#pullrequestreview-2514928150","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/100444","author_association":"MEMBER","submitted_at":"2024-12-19T14:22:34Z"},{"id":2514934497,"node_id":"PRR_kwDOAO6SJc6V5trh","state":"COMMENTED"