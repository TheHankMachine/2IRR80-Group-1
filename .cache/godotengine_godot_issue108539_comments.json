[{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3064581119","html_url":"https://github.com/godotengine/godot/issues/108539#issuecomment-3064581119","issue_url":"https://api.github.com/repos/godotengine/godot/issues/108539","id":3064581119,"node_id":"IC_kwDOAO6SJc62qcv_","user":{"login":"dalexeev","id":47700418,"node_id":"MDQ6VXNlcjQ3NzAwNDE4","avatar_url":"https://avatars.githubusercontent.com/u/47700418?v=4","gravatar_id":"","url":"https://api.github.com/users/dalexeev","html_url":"https://github.com/dalexeev","followers_url":"https://api.github.com/users/dalexeev/followers","following_url":"https://api.github.com/users/dalexeev/following{/other_user}","gists_url":"https://api.github.com/users/dalexeev/gists{/gist_id}","starred_url":"https://api.github.com/users/dalexeev/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/dalexeev/subscriptions","organizations_url":"https://api.github.com/users/dalexeev/orgs","repos_url":"https://api.github.com/users/dalexeev/repos","events_url":"https://api.github.com/users/dalexeev/events{/privacy}","received_events_url":"https://api.github.com/users/dalexeev/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-07-12T03:20:03Z","updated_at":"2025-07-12T03:20:03Z","body":"This is expected behavior, the `for` loop never filters the elements it iterates over. If the collection might encounter an element of the \"wrong\" type, then you should use type checking and a local variable inside the loop block instead:\n\n```gdscript\nfor node: Node in parent.get_children():\n    if node is not Control:\n        continue\n    var control: Control = node\n    # ...\n```","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3064581119/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized"