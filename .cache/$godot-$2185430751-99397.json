[{"id":2479941632,"node_id":"PRR_kwDOAO6SJc6T0OgA","state":"COMMENTED","user":{"site_admin":false,"suspended":false,"updated_at":"0001-01-01T00:00:00Z","avatar_url":"https://avatars.githubusercontent.com/u/229837?u=380bea11a30c8cb9a25651d120a4a85904ced8e3&v=4","created_at":"0001-01-01T00:00:00Z","followers":0,"following":0,"html_url":"https://github.com/rburing","id":229837,"node_id":"MDQ6VXNlcjIyOTgzNw==","login":"rburing","type":"User","owned_private_repos":0,"public_gists":0,"public_repos":0,"total_private_repos":0,"url":"https://api.github.com/users/rburing"},"body":"","html_url":"https://github.com/godotengine/godot/pull/99397#pullrequestreview-2479941632","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/99397","author_association":"MEMBER","submitted_at":"2024-12-04T21:27:42Z"},{"id":2480048579,"node_id":"PRR_kwDOAO6SJc6T0onD","state":"APPROVED","user":{"site_admin":false,"suspended":false,"updated_at":"0001-01-01T00:00:00Z","avatar_url":"https://avatars.githubusercontent.com/u/229837?u=380bea11a30c8cb9a25651d120a4a85904ced8e3&v=4","created_at":"0001-01-01T00:00:00Z","followers":0,"following":0,"html_url":"https://github.com/rburing","id":229837,"node_id":"MDQ6VXNlcjIyOTgzNw==","login":"rburing","type":"User","owned_private_repos":0,"public_gists":0,"public_repos":0,"total_private_repos":0,"url":"https://api.github.com/users/rburing"},"body":"The change makes sense to me. Indeed floor snapping should only move the body along the up axis. Any motion orthogonal to the up axis is from the \"free the body if stuck\" phase of `body_test_motion`. It should be fine to cancel that motion, because the previous (non-floor-snapping) `move_and_collide` (from the loop in `_move_and_slide_grounded`) already took care of freeing the body if stuck.\r\n\r\nEdit: Something equivalent to the previous sentence should be added to the code comment as well.\r\n\r\nEdit 2: I guess the original idea may have been to use the depenetration of the body to intentionally cause some sliding.","html_url":"https://github.com/godotengine/godot/pull/99397#pullrequestreview-2480048579","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/99397","author_association":"MEMBER","submitted_at":"2024-12-04T22:30:10Z"},{"id":2482081523,"node_id":"PRR_kwDOAO6SJc6T8Y7z","state":"COMMENTED","user":{"site_admin":false,"suspended":false,"updated_at":"0001-01-01T00:00:00Z","avatar_url":"https://avatars.githubusercontent.com/u/64601424?u=8d8af5b5584732e4d456c26a9f1a9790d3eab65b&v=4","created_at":"0001-01-01T00:00:00Z","followers":0,"following":0,"html_url":"https://github.com/yosoyfreeman","id":64601424,"node_id":"MDQ6VXNlcjY0NjAxNDI0","login":"yosoyfreeman","type":"User","owned_private_repos":0,"public_gists":0,"public_repos":0,"total_private_repos":0,"url":"https://api.github.com/users/yosoyfreeman"},"body":"","html_url":"https://github.com/godotengine/godot/pull/99397#pullrequestreview-2482081523","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/99397","author_association":"CONTRIBUTOR","submitted_at":"2024-12-05T15:37:58Z"},{"id":2486692672,"node_id":"PRR_kwDOAO6SJc6UN-tA","state":"APPROVED","commit_id":"72650f9787f880353245a0630ba5ba25f814fe71","user":{"site_admin":false,"suspended":false,"updated_at":"0001-01-01T00:00:00Z","avatar_url":"https://avatars.githubusercontent.com/u/229837?u=380bea11a30c8cb9a25651d120a4a85904ced8e3&v=4","created_at":"0001-01-01T00:00:00Z","followers":0,"following":0,"html_url":"https://github.com/rburing","id":229837,"node_id":"MDQ6VXNlcjIyOTgzNw==","login":"rburing","type":"User","owned_private_repos":0,"public_gists":0,"public_repos":0,"total_private_repos":0,"url":"https://api.github.com/users/rburing"},"body":"Looks good. Thanks for working on this!","html_url":"https://github.com/godotengine/godot/pull/99397#pullrequestreview-2486692672","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/99397","author_association":"MEMBER","submitted_at":"2024