[{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4463201475","html_url":"https://github.com/godotengine/godot/issues/119499#issuecomment-4463201475","issue_url":"https://api.github.com/repos/godotengine/godot/issues/119499","id":4463201475,"node_id":"IC_kwDOAO6SJc8AAAABCgcMww","user":{"login":"NoNormalDev","id":190293561,"node_id":"U_kgDOC1emOQ","avatar_url":"https://avatars.githubusercontent.com/u/190293561?v=4","gravatar_id":"","url":"https://api.github.com/users/NoNormalDev","html_url":"https://github.com/NoNormalDev","followers_url":"https://api.github.com/users/NoNormalDev/followers","following_url":"https://api.github.com/users/NoNormalDev/following{/other_user}","gists_url":"https://api.github.com/users/NoNormalDev/gists{/gist_id}","starred_url":"https://api.github.com/users/NoNormalDev/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/NoNormalDev/subscriptions","organizations_url":"https://api.github.com/users/NoNormalDev/orgs","repos_url":"https://api.github.com/users/NoNormalDev/repos","events_url":"https://api.github.com/users/NoNormalDev/events{/privacy}","received_events_url":"https://api.github.com/users/NoNormalDev/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-05-15T20:14:27Z","updated_at":"2026-05-15T20:18:39Z","body":"Can you check what the `factor` property is on the `InputEvent`?\n\n<img width=\"916\" height=\"164\" alt=\"Image\" src=\"https://github.com/user-attachments/assets/7c2ef896-f8fb-4590-ae69-371abb70c844\" />","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4463201475/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4463250996","html_url":"https://github.com/godotengine/godot/issues/119499#issuecomment-4463250996","issue_url":"https://api.github.com/repos/godotengine/godot/issues/119499","id":4463250996,"node_id":"IC_kwDOAO6SJc8AAAABCgfONA","user":{"login":"SpiceOctopus","id":59936251,"node_id":"MDQ6VXNlcjU5OTM2MjUx","avatar_url":"https://avatars.githubusercontent.com/u/59936251?v=4","gravatar_id":"","url":"https://api.github.com/users/SpiceOctopus","html_url":"https://github.com/SpiceOctopus","followers_url":"https://api.github.com/users/SpiceOctopus/followers","following_url":"https://api.github.com/users/SpiceOctopus/following{/other_user}","gists_url":"https://api.github.com/users/SpiceOctopus/gists{/gist_id}","starred_url":"https://api.github.com/users/SpiceOctopus/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/SpiceOctopus/subscriptions","organizations_url":"https://api.github.com/users/SpiceOctopus/orgs","repos_url":"https://api.github.com/users/SpiceOctopus/repos","events_url":"https://api.github.com/users/SpiceOctopus/events{/privacy}","received_events_url":"https://api.github.com/users/SpiceOctopus/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-05-15T20:20:11Z","updated_at":"2026-05-15T20:20:11Z","body":"`factor` is always 1.0 on events where `pressed=false`.\nOn events where `pressed=true` it alternates between 0.125 and 0.25. \nMost of the time it is 0.125.\n\n\n<img width=\"1134\" height=\"752\" alt=\"Image\" src=\"https://github.com/user-attachments/assets/4ddca1cd-ca47-40ce-89d1-ce2a6e83fe32\" />","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4463250996/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4463467172","html_url":"https://github.com/godotengine/godot/issues/119499#issuecomment-4463467172","issue_url":"https://api.github.com/repos/godotengine/godot/issues/119499","id":4463467172,"node_id":"IC_kwDOAO6SJc8AAAABCgsapA","user":{"login":"NoNormalDev","id":190293561,"node_id":"U_kgDOC1emOQ","avatar_url":"https://avatars.githubusercontent.com/u/190293561?v=4","gravatar_id":"","url":"https://api.github.com/users/NoNormalDev","html_url":"https://github.com/NoNormalDev","followers_url":"https://api.github.com/users/NoNormalDev/followers","following_url":"https://api.github.com/users/NoNormalDev/following{/other_user}","gists_url":"https://api.github.com/users/NoNormalDev/gists{/gist_id}","starred_url":"https://api.github.com/users/NoNormalDev/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/NoNormalDev/subscriptions","organizations_url":"https://api.github.com/users/NoNormalDev/orgs","repos_url":"https://api.github.com/users/NoNormalDev/repos","events_url":"https://api.github.com/users/NoNormalDev/events{/privacy}","received_events_url":"https://api.github.com/users/NoNormalDev/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-05-15T20:44:46Z","updated_at":"2026-05-15T20:46:38Z","body":"It seems like your hardware registers smaller changes than one tick (`1/8` of a tick), so that is why you are getting multiple events per one scroll wheel tick. Use the `factor` property to find out the actual scroll amount.\n\nBut it is weird that when `pressed=false` it reports it as `1.0`. On my **Windows** device, it's the same value as when it's `true`. so this may require a fix. But I personally don't see any usage for scroll events with `pressed=false`.\n\nThe code handling mouse events in Wayland is `platform\\linuxbsd\\wayland\\display_server_wayland.cpp` I think.\n\nOn my machine (Win11 Build 26200):\n<img width=\"504\" height=\"517\" alt=\"Image\" src=\"https://github.com/user-attachments/assets/e25e3e05-6efa-498b-ab01-5bfa68cc9874\" />","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4463467172/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4466583714","html_url":"https://github.com/godotengine/godot/issues/119499#issuecomment-4466583714","issue_url":"https://api.github.com/repos/godotengine/godot/issues/119499","id":4466583714,"node_id":"IC_kwDOAO6SJc8AAAABCjqoog","user":{"login":"SpiceOctopus","id":59936251,"node_id":"MDQ6VXNlcjU5OTM2MjUx","avatar_url":"https://avatars.githubusercontent.com/u/59936251?v=4","gravatar_id":"","url":"https://api.github.com/users/SpiceOctopus","html_url":"https://github.com/SpiceOctopus","followers_url":"https://api.github.com/users/SpiceOctopus/followers","following_url":"https://api.github.com/users/SpiceOctopus/following{/other_user}","gists_url":"https://api.github.com/users/SpiceOctopus/gists{/gist_id}","starred_url":"https://api.github.com/users/SpiceOctopus/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/SpiceOctopus/subscriptions","organizations_url":"https://api.github.com/users/SpiceOctopus/orgs","repos_url":"https://api.github.com/users/SpiceOctopus/repos","events_url":"https://api.github.com/users/SpiceOctopus/events{/privacy}","received_events_url":"https://api.github.com/users/SpiceOctopus/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-05-16T10:28:43Z","updated_at":"2026-05-16T10:28:43Z","body":"To make sure I understand this correctly, factor is always the scroll amount, where a factor of 1.0 equals one full scroll action? (Though according to the documentation it might also be 0 if partial scrolling is unsupported.)\n\nThis seems to me like something that could be simplified. Right now simply having a scroll up/down action requires manually filtering the events to discard the non pressed ones and keeping of the factor value.\nMaybe something like a \"simplified scrolling\" project setting that handles the factor internally and discards non-pressed events could make sense here. ","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4466583714/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4466626212","html_url":"https://github.com/godotengine/godot/issues/119499#issuecomment-4466626212","issue_url":"https://api.github.com/repos/godotengine/godot/issues/119499","id":4466626212,"node_id":"IC_kwDOAO6SJc8AAAABCjtOpA","user":{"login":"NoNormalDev","id":190293561,"node_id":"U_kgDOC1emOQ","avatar_url":"https://avatars.githubusercontent.com/u/190293561?v=4","gravatar_id":"","url":"https://api.github.com/users/NoNormalDev","html_url":"https://github.com/NoNormalDev","followers_url":"https://api.github.com/users/NoNormalDev/followers","following_url":"https://api.github.com/users/NoNormalDev/following{/other_user}","gists_url":"https://api.github.com/users/NoNormalDev/gists{/gist_id}","starred_url":"https://api.github.com/users/NoNormalDev/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/NoNormalDev/subscriptions","organizations_url":"https://api.github.com/users/NoNormalDev/orgs","repos_url":"https://api.github.com/users/NoNormalDev/repos","events_url":"https://api.github.com/users/NoNormalDev/events{/privacy}","received_events_url":"https://api.github.com/users/NoNormalDev/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-05-16T10:50:26Z","updated_at":"2026-05-16T10:50:26Z","body":"> To make sure I understand this correctly, factor is always the scroll amount, where a factor of 1.0 equals one full scroll action? (Though according to the documentation it might also be 0 if partial scrolling is unsupported.)\n\nYes. Personally I think that the `0` fallback value should be replaced by `1`.\n\n> This seems to me like something that could be simplified. Right now simply having a scroll up/down action requires manually filtering the events to discard the non pressed ones and keeping of the factor value. Maybe something like a \"simplified scrolling\" project setting that handles the factor internally and discards non-pressed events could make sense here.\n\nBut how would the factor part be implemented? Like it waits until it adds up to 1 and then it sends the event?\n\nSadly, I was unable to replicate the issue on my VM, the drivers ignore my touchpad precision, so I can't help much.\n\nGodot v4.6.2.stable - Fedora Linux 43 (Workstation Edition) on Wayland - X11 display driver, Multi-window, 1 monitor - Vulkan (Mobile) - (software emulation on CPU) llvmpipe (LLVM 21.1.2, 256 bits) - AMD Ryzen 5 5600H with Radeon Graphics (3 threads) - 5.58 GiB memory","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4466626212/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4466647890","html_url":"https://github.com/godotengine/godot/issues/119499#issuecomment-4466647890","issue_url":"https://api.github.com/repos/godotengine/godot/issues/119499","id":4466647890,"node_id":"IC_kwDOAO6SJc8AAAABCjujUg","user":{"login":"SpiceOctopus","id":59936251,"node_id":"MDQ6VXNlcjU5OTM2MjUx","avatar_url":"https://avatars.githubusercontent.com/u/59936251?v=4","gravatar_id":"","url":"https://api.github.com/users/SpiceOctopus","html_url":"https://github.com/SpiceOctopus","followers_url":"https://api.github.com/users/SpiceOctopus/followers","following_url":"https://api.github.com/users/SpiceOctopus/following{/other_user}","gists_url":"https://api.github.com/users/SpiceOctopus/gists{/gist_id}","starred_url":"https://api.github.com/users/SpiceOctopus/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/SpiceOctopus/subscriptions","organizations_url":"https://api.github.com/users/SpiceOctopus/orgs","repos_url":"https://api.github.com/users/SpiceOctopus/repos","events_url":"https://api.github.com/users/SpiceOctopus/events{/privacy}","received_events_url":"https://api.github.com/users/SpiceOctopus/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-05-16T11:01:27Z","updated_at":"2026-05-16T11:01:27Z","body":"> Yes. Personally I think that the 0 fallback value should be replaced by 1.\n\nAgreed. If it was 1.0 it could at least use the same math in code.\n\n> But how would the factor part be implemented? Like it waits until it adds up to 1 and then it sends the event?\n\nYes, since that is what we now have to implement anyway.\n\n> Sadly, I was unable to replicate the issue on my VM, the drivers ignore my touchpad precision, so I can't help much.\n\nTouchpads are another issue on wayland. At least on my laptop (Framework 13). On wayland they do not send InputEventMouseButton when I use two finger scrolling. I get InputEventPanGesture instead. Which is intended as far as I understand the docs.\nThis introduces a problem with event assignments since godot currently defaults to X11.\nIf you assign the scroll event in the project settings, then build with the display server set to wayland, that event will not work in the actual program.\n\nFully implementing scrolling that works across devices requires a lot of code at the moment.","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4466647890/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4466758319","html_url":"https://github.com/godotengine/godot/issues/119499#issuecomment-4466758319","issue_url":"https://api.github.com/repos/godotengine/godot/issues/119499","id":4466758319,"node_id":"IC_kwDOAO6SJc8AAAABCj1Srw","user":{"login":"CreatedBySeb","id":11736217,"node_id":"MDQ6VXNlcjExNzM2MjE3","avatar_url":"https://avatars.githubusercontent.com/u/11736217?v=4","gravatar_id":"","url":"https://api.github.com/users/CreatedBySeb","html_url":"https://github.com/CreatedBySeb","followers_url":"https://api.github.com/users/CreatedBySeb/followers","following_url":"https://api.github.com/users/CreatedBySeb/following{/other_user}","gists_url":"https://api.github.com/users/CreatedBySeb/gists{/gist_id}","starred_url":"https://api.github.com/users/CreatedBySeb/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/CreatedBySeb/subscriptions","organizations_url":"https://api.github.com/users/CreatedBySeb/orgs","repos_url":"https://api.github.com/users/CreatedBySeb/repos","events_url":"https://api.github.com/users/CreatedBySeb/events{/privacy}","received_events_url":"https://api.github.com/users/CreatedBySeb/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-05-16T11:47:01Z","updated_at":"2026-05-16T11:47:01Z","body":"Given it sounds like this may be intended functionality, but that it could be improved upon to make it easier to work with, I'll swap bug for enhancement + discussion.","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4466758319/reactions","total_count":2,"+1":2,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null}]