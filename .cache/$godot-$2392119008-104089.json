lation only if there's a significant distance difference between the previous frame and the current frame.\r\n","html_url":"https://github.com/godotengine/godot/pull/104089#pullrequestreview-2683758091","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/104089","author_association":"MEMBER","submitted_at":"2025-03-14T01:20:03Z"},{"id":2684490211,"node_id":"PRR_kwDOAO6SJc6gAhHj","state":"APPROVED","commit_id":"6c586d20df93ad7c4a4535b0b04e238b7444f72a","user":{"site_admin":false,"suspended":false,"updated_at":"0001-01-01T00:00:00Z","avatar_url":"https://avatars.githubusercontent.com/u/21999379?u=2b8b17ce969861380874563b333a546e0bbaab56&v=4","created_at":"0001-01-01T00:00:00Z","followers":0,"following":0,"html_url":"https://github.com/lawnjelly","id":21999379,"node_id":"MDQ6VXNlcjIxOTk5Mzc5","login":"lawnjelly","type":"User","owned_private_repos":0,"public_gists":0,"public_repos":0,"total_private_repos":0,"url":"https://api.github.com/users/lawnjelly"},"body":"","html_url":"https://github.com/godotengine/godot/pull/104089#pullrequestreview-2684490211","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/104089","author_association":"MEMBER","submitted_at":"2025-03-14T06:56:53Z"}]