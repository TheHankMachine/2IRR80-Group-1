[{"id":4678013527,"node_id":"PRR_kwDOAO6SJc8AAAABFtTSVw","user":{"login":"Ivorforce","id":2308167,"node_id":"MDQ6VXNlcjIzMDgxNjc=","avatar_url":"https://avatars.githubusercontent.com/u/2308167?u=f7f8e0273f784f5ec6f6b7fe4a88d449896eb48a&v=4","gravatar_id":"","url":"https://api.github.com/users/Ivorforce","html_url":"https://github.com/Ivorforce","followers_url":"https://api.github.com/users/Ivorforce/followers","following_url":"https://api.github.com/users/Ivorforce/following{/other_user}","gists_url":"https://api.github.com/users/Ivorforce/gists{/gist_id}","starred_url":"https://api.github.com/users/Ivorforce/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Ivorforce/subscriptions","organizations_url":"https://api.github.com/users/Ivorforce/orgs","repos_url":"https://api.github.com/users/Ivorforce/repos","events_url":"https://api.github.com/users/Ivorforce/events{/privacy}","received_events_url":"https://api.github.com/users/Ivorforce/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"An alternative to this would be to make `AudioEffectEQ` and `AudioEffectFilter` abstract.\n\nThis should remove them from the list, fix potential similar issues, and still be GDExtension compatible.\nHowever, this would compat break for users who instantiate these classes directly, which looks to be identical to using `AudioEffectEQ6` / `AudioEffectLowPassFilter` instead.\n\nSince there is no benefit to breaking compat for this, I think the fix at hand is the right approach.\n(it would be nice to be able to provide an auto-migration path to auto-change e.g. `AudioEffectEQ` -> `AudioEffectEQ6`, but we don't have this yet.","state":"APPROVED","html_url":"https://github.com/godotengine/godot/pull/120277#pullrequestreview-4678013527","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/120277","author_association":"MEMBER","_links":{"html":{"href":"https://github.com/godotengine/godot/pull/120277#pullrequestrevi