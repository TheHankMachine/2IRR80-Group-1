[{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/1887606794","pull_request_review_id":2507394402,"id":1887606794,"node_id":"PRRC_kwDOAO6SJc5wgpgK","diff_hunk":"@@ -1664,7 +1670,7 @@ void main() {\n \t\t\t\t\trim, rim_tint,\n #endif // LIGHT_RIM_USED\n #ifdef LIGHT_CLEARCOAT_USED\n-\t\t\t\t\tclearcoat, clearcoat_roughness, normalize(normal_interp),\n+\t\t\t\t\tclearcoat, clearcoat_roughness, geo_normal,","path":"servers/rendering/renderer_rd/shaders/forward_mobile/scene_forward_mobile.glsl","commit_id":"ed0e3d7da837e8b4a3bcb393f9d22dfd57831b1f","original_commit_id":"4d1656bb1ce1d193369eb084cbc3cd095f601fbc","user":{"login":"clayjohn","id":16521339,"node_id":"MDQ6VXNlcjE2NTIxMzM5","avatar_url":"https://avatars.githubusercontent.com/u/16521339?v=4","gravatar_id":"","url":"https://api.github.com/users/clayjohn","html_url":"https://github.com/clayjohn","followers_url":"https://api.github.com/users/clayjohn/followers","following_url":"https://api.github.com/users/clayjohn/following{/other_user}","gists_url":"https://api.github.com/users/clayjohn/gists{/gist_id}","starred_url":"https://api.github.com/users/clayjohn/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/clayjohn/subscriptions","organizations_url":"https://api.github.com/users/clayjohn/orgs","repos_url":"https://api.github.com/users/clayjohn/repos","events_url":"https://api.github.com/users/clayjohn/events{/privacy}","received_events_url":"https://api.github.com/users/clayjohn/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"Did you measure a performance difference from this? The reason normal_interp is used here is that it allows the compiler to optimize VGPR usage. Storing `geo_normal` allows us to avoid a couple calls to `normalize()` but it increases the VGPR usage during all of the hot paths in the shader which can significantly reduce performance since we already have a very high VGPR usage. ","created_at":"2024-12-16T21:27:57Z","updated_at":"2024-12-16T21:30:39Z","html_url":"https://github.com/godotengine/godot/pull/100441#discussion_r1887606794","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/100441","_links":{"self":{"href":"https://api.github.com/repos/godotengine/godot/pulls/comments/1887606794"},"html":{"href":"https://github.com/godotengine/godot/pull/100441#discussion_r1887606794"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/100441"}},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/1887606794/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":1668,"original_line":1668,"side":"RIGHT","author_association":"MEMBER","original_position":94,"position":109,"subject_type":"line"},{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/1888092251","pull_request_review_id":2508158265,"id":1888092251,"node_id":"PRRC_kwDOAO6SJc5wigBb","diff_hunk":"@@ -1664,7 +1670,7 @@ void main() {\n \t\t\t\t\trim, rim_tint,\n #endif // LIGHT_RIM_USED\n #ifdef LIGHT_CLEARCOAT_USED\n-\t\t\t\t\tclearcoat, clearcoat_roughness, normalize(normal_interp),\n+\t\t\t\t\tclearcoat, clearcoat_roughness, geo_normal,","path":"servers/rendering/renderer_rd/shaders/forward_mobile/scene_forward_mobile.glsl","commit_id":"ed0e3d7da837e8b4a3bcb393f9d22dfd57831b1f","original_commit_id":"4d1656bb1ce1d193369eb084cbc3cd095f601fbc","user":{"login":"StaydMcMuffin","id":38304659,"node_id":"MDQ6VXNlcjM4MzA0NjU5","avatar_url":"https://avatars.githubusercontent.com/u/38304659?v=4","gravatar_id":"","url":"https://api.github.com/users/StaydMcMuffin","html_url":"https://github.com/StaydMcMuffin","followers_url":"https://api.github.com/users/StaydMcMuffin/followers","following_url":"https://api.github.com/users/StaydMcMuffin/following{/other_user}","gists_url":"https://api.github.com/users/StaydMcMuffin/gists{/gi