[{"id":3163887247,"node_id":"PRR_kwDOAO6SJc68lRaP","state":"COMMENTED","user":{"site_admin":false,"suspended":false,"updated_at":"0001-01-01T00:00:00Z","avatar_url":"https://avatars.githubusercontent.com/u/2308167?u=f7f8e0273f784f5ec6f6b7fe4a88d449896eb48a&v=4","created_at":"0001-01-01T00:00:00Z","followers":0,"following":0,"html_url":"https://github.com/Ivorforce","id":2308167,"node_id":"MDQ6VXNlcjIzMDgxNjc=","login":"Ivorforce","type":"User","owned_private_repos":0,"public_gists":0,"public_repos":0,"total_private_repos":0,"url":"https://api.github.com/users/Ivorforce"},"body":"This makes sense to me. `orphan_node_count` is almost guaranteed to be mangled by multiple threads if we do not use atomics for it. We should either remove this variable entirely or wrap it with atomics. If we _are_ moving to atomics (probably the better move), it would be better to touch this variable as little as possible, leading to `total_node_count` instead of `orphan_node_count`. \r\nSo yes, as long as we allow `Node` instantiation on separate threads, I think this change is necessary.","html_url":"https://github.com/godotengine/godot/pull/109900#pullrequestreview-3163887247","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/109900","author_association":"MEMBER","submitted_at":"2025-08-28T08:49:21Z"},{"id":3268791179,"node_id":"PRR_kwDOAO6SJc7C1cuL","state":"APPROVED","user":{"site_admin":false,"suspended":false,"updated_at":"0001-01-01T00:00:00Z","avatar_url":"https://avatars.githubusercontent.com/u/2308167?u=f7f8e0273f784f5ec6f6b7fe4a88d449896eb48a&v=4","created_at":"0001-01-01T00:00:00Z","followers":0,"following":0,"html_url":"https://github.com/Ivorforce","id":2308167,"node_id":"MDQ6VXNlcjIzMDgxNjc=","login":"Ivorforce","type":"User","owned_private_repos":0,"public_gists":0,"public_repos":0,"total_private_repos":0,"url":"https://api.github.com/users/Ivorforce"},"body":"Looks good to me. Thanks for your work on this. I've got just one more nitpick, then I think it's ready to merge.","html_url":"https://github.com/godotengine/godot/pull/109900#pullrequestreview-3268791179","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/109900","author_association":"MEMBER","submitted_at":"2025-09-25T17:31:49Z"},{"id":3282055168,"node_id":"PRR_kwDOAO6SJc7DoDAA","state":"APPROVED","commit_id":"6ebef31b3c0c26ee1275eb3e0a6f0f21a7fef494","user":{"site_admin":false,"suspended":false,"updated_at":"0001-01-01T00:00:00Z","avatar_url":"https://avatars.githubusercontent.com/u/2308167?u=f7f8e0273f784f5ec6f6b7fe4a88d449896eb48a&v=4","created_at":"0001-01-01T00:00:00Z","followers":0,"following":0,"html_url":"https://github.com/Ivorforce","id":2308167,"node_id":"MDQ6VXNlcjIzMDgxNjc=","login":"Ivorforce","type":"User","owned_private_repos":0,"public_gists":0,"public_repos":0,"total_private_repos":0,"url":"https://api.github.com/users/Ivorforce"},"body":"","html_url":"https://github.com/godotengine/godot/pull/109900#pullrequestreview-3282055168","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/109900","author_association":"MEMBER","submitted_at":"2025-09-29T22:50:24Z"},{"id":3284416648,"node_id":"PRR_kwDOAO6SJc7DxDiI","state":"APPROVED","commit_id":"6ebef31b3c0c26ee1275eb3e0a6f0f21a7fef494","user":{"site_admin":false,"suspended":false,"updated_at":"0001-01-01T00:00:00Z","avatar_url":"https://avatars.githubusercontent.com/u/66727710?u=8069d9b7bc6ab503ce83dfcfa53fd021672aeccf&v=4","created_at":"0001-01-01T00:00:00Z","followers":0,"following":0,"html_url":"https://github.com/Mickeon","id":66727710,"node_id":"MDQ6VXNlcjY2NzI3NzEw","login":"Mickeon","type":"User","owned_private_repos":0,"public_gists":0,"public_repos":0,"total_private_repos":0,"url":"https://api.github.com/users/Mickeon"},"body":"","html_url":"https://github.com/godotengine/godot/pull/109900#pullrequestreview-3284416648","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/109900","author_association":"MEMBER","submitted_at"