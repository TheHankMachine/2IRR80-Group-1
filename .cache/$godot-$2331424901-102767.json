[{"id":2614326099,"node_id":"PRR_kwDOAO6SJc6b03NT","state":"COMMENTED","user":{"site_admin":false,"suspended":false,"updated_at":"0001-01-01T00:00:00Z","avatar_url":"https://avatars.githubusercontent.com/u/3176062?v=4","created_at":"0001-01-01T00:00:00Z","followers":0,"following":0,"html_url":"https://github.com/kiroxas","id":3176062,"node_id":"MDQ6VXNlcjMxNzYwNjI=","login":"kiroxas","type":"User","owned_private_repos":0,"public_gists":0,"public_repos":0,"total_private_repos":0,"url":"https://api.github.com/users/kiroxas"},"body":"Maybe I'm not reading this correctly, but it seems like the path and radius limits are only here to clamp the result at the end. We could instead use this to limit iterations during the search path, because it seems like if we have a huge navmesh, this won't help on the performance side, as the whole map will be searched, and then we clamp. We should use it to limit the A* search.","html_url":"https://github.com/godotengine/godot/pull/102767#pullrequestreview-2614326099","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/102767","author_association":"CONTRIBUTOR","submitted_at":"2025-02-13T09:22:11Z"},{"id":2619227207,"node_id":"PRR_kwDOAO6SJc6cHjxH","state":"COMMENTED","user":{"site_admin":false,"suspended":false,"updated_at":"0001-01-01T00:00:00Z","avatar_url":"https://avatars.githubusercontent.com/u/52464204?u=4854f17c9d330a8a9d274f0cb7b943fc2bb6dd44&v=4","created_at":"0001-01-01T00:00:00Z","followers":0,"following":0,"html_url":"https://github.com/smix8","id":52464204,"node_id":"MDQ6VXNlcjUyNDY0MjA0","login":"smix8","type":"User","owned_private_repos":0,"public_gists":0,"public_repos":0,"total_private_repos":0,"url":"https://api.github.com/users/smix8"},"body":"","html_url":"https://github.com/godotengine/godot/pull/102767#pullrequestreview-2619227207","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/102767","author_association":"CONTRIBUTOR","submitted_at":"2025-02-15T02:07:22Z"},{"id":261