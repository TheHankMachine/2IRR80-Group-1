[{"id":3778368827,"node_id":"PRR_kwDOAO6SJc7hNVU7","user":{"login":"dalexeev","id":47700418,"node_id":"MDQ6VXNlcjQ3NzAwNDE4","avatar_url":"https://avatars.githubusercontent.com/u/47700418?u=0565b5d99d54afd5fda6712cd8eb05893572baed&v=4","gravatar_id":"","url":"https://api.github.com/users/dalexeev","html_url":"https://github.com/dalexeev","followers_url":"https://api.github.com/users/dalexeev/followers","following_url":"https://api.github.com/users/dalexeev/following{/other_user}","gists_url":"https://api.github.com/users/dalexeev/gists{/gist_id}","starred_url":"https://api.github.com/users/dalexeev/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/dalexeev/subscriptions","organizations_url":"https://api.github.com/users/dalexeev/orgs","repos_url":"https://api.github.com/users/dalexeev/repos","events_url":"https://api.github.com/users/dalexeev/events{/privacy}","received_events_url":"https://api.github.com/users/dalexeev/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"The implementation overall looks good to me. But I'm not entirely sure if using the `<name> (<value>)` format is a good idea. Perhaps we should only have constant names (without values ​​in parentheses) if we don't think users should rely on \"magic\" numbers? This change definitely improves readability, but:\n\n1. Constant values ​​are no longer valid expressions.\n   * `GDScriptDocGen` already partially breaks this rule, displaying identifiers/calls in simple cases, hiding deeply nested or non-constant contents of arrays/dictionaries with `...`, or using `<unknown>` and `<Object>` placeholders.\n2. This somewhat goes beyond the original meaning of the `value` attribute. It is now not just a reduced value the constant or variable/parameter default value, but a complex expression.\n   * We cannot add clickable links for constants in the expression.\n   * Third-party addons reading the XML documentation may break if they rely on the current `value` attribute semantics.\n\nWe also need to make sure that this works correctly for GDExtension documentation and that `make_rst.py` doesn't break.","state":"COMMENTED","html_url":"https://github.com/godotengine/godot/pull/115958#pullrequestreview-3778368827","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/115958","author_association":"CONTRIBUTOR","_links":{"html":{"href":"https://github.com/godotengine/godot/pull/115958#pullrequestreview-3778368827"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/115958"}},"submitted_at":"2026-02-10T11:56:53Z","commit_id":null},{"id":3778695435,"node_id":"PRR_kwDOAO6SJc7hOlEL","user":{"login":"bruvzg","id":7645683,"node_id":"MDQ6VXNlcjc2NDU2ODM=","avatar_url":"https://avatars.githubusercontent.com/u/7645683?u=2867ee7fcd920bc19b7d1cbf4b10264b9bbc9326&v=4","gravatar_id":"","url":"https://api.github.com/users/bruvzg","html_url":"https://github.com/bruvzg","followers_url":"https://api.github.com/users/bruvzg/followers","following_url":"https://api.github.com/users/bruvzg/following{/other_user}","gists_url":"https://api.github.com/users/bruvzg/gists{/gist_id}","starred_url":"https://api.github.com/users/bruvzg/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/bruvzg/subscriptions","organizations_url":"https://api.github.com/users/bruvzg/orgs","repos_url":"https://api.github.com/users/bruvzg/repos","events_url":"https://api.github.com/users/bruvzg/events{/privacy}","received_events_url":"https://api.github.com/users/bruvzg/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"","state":"COMMENTED","html_url":"https://github.com/godotengine/godot/pull/115958#pullrequestreview-3778695435","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/115958","author_association":"MEMBER","_links":{"html":{"href":"https://github.com/godotengine/godot/pull/115958#pullrequestreview-3778695435"},"pull_request":{"href":"http