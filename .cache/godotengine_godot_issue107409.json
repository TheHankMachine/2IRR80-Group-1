iption":"","archived_at":null,"archived_by":null},{"id":1332303119,"node_id":"MDU6TGFiZWwxMzMyMzAzMTE5","url":"https://api.github.com/repos/godotengine/godot/labels/regression","name":"regression","color":"ff63ac","default":false,"description":"","archived_at":null,"archived_by":null},{"id":2666708059,"node_id":"MDU6TGFiZWwyNjY2NzA4MDU5","url":"https://api.github.com/repos/godotengine/godot/labels/topic:2d","name":"topic:2d","color":"ffee88","default":false,"description":"","archived_at":null,"archived_by":null}],"state":"closed","locked":false,"assignees":[],"milestone":{"url":"https://api.github.com/repos/godotengine/godot/milestones/22","html_url":"https://github.com/godotengine/godot/milestone/22","labels_url":"https://api.github.com/repos/godotengine/godot/milestones/22/labels","id":12070367,"node_id":"MI_kwDOAO6SJc4AuC3f","number":22,"title":"4.5","description":"","creator":{"login":"Sauermann","id":6299227,"node_id":"MDQ6VXNlcjYyOTkyMjc=","avatar_url":"https://avatars.githubusercontent.com/u/6299227?v=4","gravatar_id":"","url":"https://api.github.com/users/Sauermann","html_url":"https://github.com/Sauermann","followers_url":"https://api.github.com/users/Sauermann/followers","following_url":"https://api.github.com/users/Sauermann/following{/other_user}","gists_url":"https://api.github.com/users/Sauermann/gists{/gist_id}","starred_url":"https://api.github.com/users/Sauermann/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Sauermann/subscriptions","organizations_url":"https://api.github.com/users/Sauermann/orgs","repos_url":"https://api.github.com/users/Sauermann/repos","events_url":"https://api.github.com/users/Sauermann/events{/privacy}","received_events_url":"https://api.github.com/users/Sauermann/received_events","type":"User","user_view_type":"public","site_admin":false},"open_issues":3,"closed_issues":3687,"state":"closed","created_at":"2024-12-19T08:51:28Z","updated_at":"2026-09-04T21:48:38Z","due_on":"2025-09-15T00:00:00Z","closed_at":"2025-09-18T17:13:14Z"},"comments":2,"created_at":"2025-06-11T14:27:55Z","updated_at":"2025-06-12T23:39:46Z","closed_at":"2025-06-12T23:39:46Z","assignee":null,"author_association":"CONTRIBUTOR","issue_field_values":[],"type":null,"active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"### Tested versions\n\n- Reproducible in: 4.5.dev5\n- Not reproducible in: 4.4.1.stable\n\n### System information\n\nGodot v4.5.dev5 - Windows 11 (build 22631) - Multi-window, 1 monitor - OpenGL 3 (Compatibility) - NVIDIA GeForce GTX 1050 Ti (NVIDIA; 32.0.15.7283) - 12th Gen Intel(R) Core(TM) i3-12100F (8 threads)\n\n### Issue description\n\nHere's how the editor 2D viewport scrollbars looks normally\n\n![Image](https://github.com/user-attachments/assets/8321f100-e8af-4b34-8a44-392e76eb59d9)\nlong, adjust/shrink itself based on the scene size\n\nHowever, when there's a single visible Camera2D node on the scene, the scrollbar will shrink to the minimum size\n\n![Image](https://github.com/user-attachments/assets/9176c766-79d5-4b2f-950f-b3ccca51c0ab)\n\nAdditional info:\n- turning on/off the limit checkbox does nothing, it'll still the minimum size\n\n![Image](https://github.com/user-attachments/assets/5e3a2168-06cc-4644-b528-f7f2b1eb4b45)\n\n- if i turn the limit into reasonable size, the scrollbar returns to normal (even if the limit checkbox is off). So it might have something to do with the camera limits.\n\n![Image](https://github.com/user-attachments/assets/4c2b3037-7916-43f4-8092-7b649bea4d6c)\n\n### Steps to reproduce\n\n- create a new project\n- make a new scene with Node2D as root node\n- notice how the 2D viewport's scrollbars looks normal\n- add a Camera2D as a child of Node2D\n- notice how the 2D viewport's scrollbars shrinks to minimum size\n- hiding the Camera2D node (visible false) will make the viewport scrollbar looks normal again\n\n![Image](https://github.com/user-attachments/assets/50529aea-63b4-4b13-ad6c-4a98ff2d0ee3)\n\n### Minimal reproduction project (MRP)\n\nN/A","closed_by":{"login":"akien-mga","id":4701338,"node_id":"MDQ6VXNlcjQ3MDEzMzg=","avatar_url":"https://avatars.githubusercontent.com/u/4701338?v=4","gravatar_id":"","url":"https://api.github.com/users/akien-mga","html_url":"https://github.com/akien-mga","followers_url":"https://api.github.com/users/akien-mga/followers","following_url":"https://api.github.com/users/akien-mga/following{/other_user}","gists_url":"https://api.github.com/users/akien-mga/gists{/gist_id}","starred_url":"https://api.github.com/users/akien-mga/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/akien-mga/subscriptions","organizations_url":"https://api.github.com/users/akien-mga/orgs","repos_url":"https://api.github.com/users/akien-mga/repos","events_url":"https://api.github.com/users/akien-mga/events{/privacy}","received_events_url":"https://api.github.com/users/akien-mga/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/107409/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/godotengine/godot/issues/107409/timeline","performed_via_github_app":null,"state_reason":"completed","pinned_comment":null}