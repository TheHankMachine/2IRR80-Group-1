nt.com/u/43543909?v=4","gravatar_id":"","url":"https://api.github.com/users/arkology","html_url":"https://github.com/arkology","followers_url":"https://api.github.com/users/arkology/followers","following_url":"https://api.github.com/users/arkology/following{/other_user}","gists_url":"https://api.github.com/users/arkology/gists{/gist_id}","starred_url":"https://api.github.com/users/arkology/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/arkology/subscriptions","organizations_url":"https://api.github.com/users/arkology/orgs","repos_url":"https://api.github.com/users/arkology/repos","events_url":"https://api.github.com/users/arkology/events{/privacy}","received_events_url":"https://api.github.com/users/arkology/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-10-20T15:47:36Z","updated_at":"2025-10-20T15:47:36Z","body":"This PR https://github.com/godotengine/godot/pull/109396 may fix the issue (but I'm not entirely happy with how exactly this PR will fix it – the original idea is great, but details need more discussion).","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3422668180/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3423558799","html_url":"https://github.com/godotengine/godot/issues/102359#issuecomment-3423558799","issue_url":"https://api.github.com/repos/godotengine/godot/issues/102359","id":3423558799,"node_id":"IC_kwDOAO6SJc7MD1yP","user":{"login":"akien-mga","id":4701338,"node_id":"MDQ6VXNlcjQ3MDEzMzg=","avatar_url":"https://avatars.githubusercontent.com/u/4701338?v=4","gravatar_id":"","url":"https://api.github.com/users/akien-mga","html_url":"https://github.com/akien-mga","followers_url":"https://api.github.com/users/akien-mga/followers","following_url":"https://api.github.com/users/akien-mga/following{/other_user}","gists_url":"https://api.github.com/users/akien-mga/gists{/gist_id}","starred_url":"https://api.github.com/users/akien-mga/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/akien-mga/subscriptions","organizations_url":"https://api.github.com/users/akien-mga/orgs","repos_url":"https://api.github.com/users/akien-mga/repos","events_url":"https://api.github.com/users/akien-mga/events{/privacy}","received_events_url":"https://api.github.com/users/akien-mga/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-10-20T20:10:14Z","updated_at":"2025-10-20T20:11:31Z","body":"I think we should work on making most components support smaller minimum sizes, either by wrapping their contents, or folding them somehow.\n\nFor example the main plugin buttons (2D, 3D, Script, AssetLib) could lose their text when resized small enough and be left only with icons. This would help especially with huge translations for \"AssetLib\" in various languages (we should put a `TRANSLATORS` comment recommending to keep it as short as possible, possibly keeping AssetLib as a brand name).\n\nThe play buttons could be folded to only show the most commonly used ones, and put the rest in a kebab menu.\n\n*Edit:* I just noticed arkology's comment linking #109396 which does some of what I suggest, or other similar solutions.","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3423558799/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4932169037","html_url":"https://github.com/godotengine/godot/issues/102359#issuecomment-4932169037","issue_url":"https://api.github.com/repos/godotengine/godot/issues/102359","id":4932169037,"node_id":"IC_kwDOAO6SJc8AAAABJfrtTQ","user":{"login":"a690089735","id":34900141,"node_id":"MDQ6VXNlcjM0OTAwMTQx","avatar_url":"https://avatars.githubusercontent.com/u/34900141?v=4","gravatar_id":"","url":"https://api.github.com/users/a690089735","html_url":"https://github.com/a690089735","followers_url":"https://api.github.com/users/a690089735/followers","following_url":"https://api.github.com/users/a690089735/following{/other_user}","gists_url":"https://api.github.com/users/a690089735/gists{/gist_id}","starred_url":"https://api.github.com/users/a690089735/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/a690089735/subscriptions","organizations_url":"https://api.github.com/users/a690089735/orgs","repos_url":"https://api.github.com/users/a690089735/repos","events_url":"https://api.github.com/users/a690089735/events{/privacy}","received_events_url":"https://api.github.com/users/a690089735/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-07-10T05:05:10Z","updated_at":"2026-07-10T05:05:10Z","body":"https://github.com/user-attachments/assets/8f742539-83c5-4817-a11c-8eb8278a4da4\n\nI think simply making the toolbar draggable and scrollable would be sufficient, similar to the toolbar interaction in 3ds Max. This way, the window size would not be limited.\n\nIn 3ds Max, you can drag the toolbar with the middle mouse button to scroll through the collapsed toolbar.\n\nJust a suggestion.\n\n--AI translate\n\n#121079 \n","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4932169037/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null}]