22#pullrequestreview-3663259224","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/114922","author_association":"CONTRIBUTOR","_links":{"html":{"href":"https://github.com/godotengine/godot/pull/114922#pullrequestreview-3663259224"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/114922"}},"submitted_at":"2026-01-14T23:16:13Z","commit_id":null},{"id":3664212101,"node_id":"PRR_kwDOAO6SJc7aZ3CF","user":{"login":"bruvzg","id":7645683,"node_id":"MDQ6VXNlcjc2NDU2ODM=","avatar_url":"https://avatars.githubusercontent.com/u/7645683?u=2867ee7fcd920bc19b7d1cbf4b10264b9bbc9326&v=4","gravatar_id":"","url":"https://api.github.com/users/bruvzg","html_url":"https://github.com/bruvzg","followers_url":"https://api.github.com/users/bruvzg/followers","following_url":"https://api.github.com/users/bruvzg/following{/other_user}","gists_url":"https://api.github.com/users/bruvzg/gists{/gist_id}","starred_url":"https://api.github.com/users/bruvzg/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/bruvzg/subscriptions","organizations_url":"https://api.github.com/users/bruvzg/orgs","repos_url":"https://api.github.com/users/bruvzg/repos","events_url":"https://api.github.com/users/bruvzg/events{/privacy}","received_events_url":"https://api.github.com/users/bruvzg/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"Have not checked Android specific code, but generic code looks good.\n\nSince we now have `get_current_rendering_driver_name_source`/`get_current_rendering_method_source` and it is logged on Android, might be worth adding verbose print with sources in the main for other platforms as well.","state":"APPROVED","html_url":"https://github.com/godotengine/godot/pull/114922#pullrequestreview-3664212101","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/114922","author_association":"MEMBER","_links":{"html":{"href":"https://github.com/godotengine/godot/pull/114922