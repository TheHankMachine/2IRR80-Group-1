ml_url":"https://github.com/godotengine/godot/pull/114129","diff_url":"https://github.com/godotengine/godot/pull/114129.diff","patch_url":"https://github.com/godotengine/godot/pull/114129.patch","merged_at":"2026-04-29T17:34:17Z"},"body":"In C++, enum AudioStreamInteractive::TransitionToTime has three \"real\" members, plus MAX. Previously only TRANSITION_TO_TIME_SAME_POSITION and TRANSITION_TO_TIME_START were bound for GDScript. But TRANSITION_TO_TIME_PREVIOUS_POSITION can be set via the editor, so can easily appear in an AudioStreamInteractive resource without needing to drop down to C++. I can't see anything to suggest that it was deliberately not exposed.\r\n\r\nBind this enum member. Add documentation.\r\n","closed_by":{"login":"Repiteo","id":17489292,"node_id":"MDQ6VXNlcjE3NDg5Mjky","avatar_url":"https://avatars.githubusercontent.com/u/17489292?v=4","gravatar_id":"","url":"https://api.github.com/users/Repiteo","html_url":"https://github.com/Repiteo","followers_url":"https://api.github.com/users/Repiteo/followers","following_url":"https://api.github.com/users/Repiteo/following{/other_user}","gists_url":"https://api.github.com/users/Repiteo/gists{/gist_id}","starred_url":"https://api.github.com/users/Repiteo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Repiteo/subscriptions","organizations_url":"https://api.github.com/users/Repiteo/orgs","repos_url":"https://api.github.com/users/Repiteo/repos","events_url":"https://api.github.com/users/Repiteo/events{/privacy}","received_events_url":"https://api.github.com/users/Repiteo/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/114129/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/godotengine/godot/issues/114129/timeline","performed_via_github_app":null,"state_reason":null}