:"archived","color":"aaaaaa","default":false,"description":"","archived_at":null,"archived_by":null},{"id":279098219,"node_id":"MDU6TGFiZWwyNzkwOTgyMTk=","url":"https://api.github.com/repos/godotengine/godot/labels/topic:editor","name":"topic:editor","color":"ffee88","default":false,"description":"","archived_at":null,"archived_by":null},{"id":4442850752,"node_id":"LA_kwDOAO6SJc8AAAABCNCFwA","url":"https://api.github.com/repos/godotengine/godot/labels/topic:particles","name":"topic:particles","color":"ffee88","default":false,"description":"","archived_at":null,"archived_by":null}],"state":"closed","locked":false,"assignees":[],"milestone":null,"comments":5,"created_at":"2025-01-27T05:37:51Z","updated_at":"2025-01-28T15:11:37Z","closed_at":"2025-01-28T15:11:30Z","assignee":null,"author_association":"NONE","issue_field_values":[],"type":null,"active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"### Tested versions\n\n- Reproducible in v4.3.stable.mono.official [77dcf97d8]\n\n### System information\n\nGodot v4.3.stable.mono - Windows 10.0.26100 - Vulkan (Mobile) - dedicated NVIDIA GeForce RTX 4060 Laptop GPU (NVIDIA; 32.0.15.5612) - Intel(R) Core(TM) Ultra 7 155H (22 Threads)\n\n### Issue description\n\nWhen in the editor, enabling emitting on a one-shot particle effect causes the effect to play once and the emitting checkbox to uncheck itself (which is expected behaviour and should remain unchanged). However it also unsaves the scene, as denoted by the asterisk on the scenes tab and the Godot editors window title (if you decide to close the scene, you will also be prompted to save).\n\nSince (to my knowledge) simply emitting a one-shot particle effect in the editor will have no changes on the scene, expected behaviour would be for the scene to remain saved. \n\n### Steps to reproduce\n\n1. Create a new project\n2. Create a scene with either a CPUParticles2D or GPUParticles2D, or the 3D equivalents\n3. Enable 'Time>One Shot' in the Inspector\n4. Save the scene\n5. Enable 'Emitting'\nNote that the scene is now marked as unsaved (the asterisk on the scene tab and the Godot window's title.\n\n(MRP contains an example of each of the 4 particle effects with no graphics)\n\n### Minimal reproduction project (MRP)\n\n[OneShotParticlesMRP.zip](https://github.com/user-attachments/files/18553836/OneShotParticlesMRP.zip)","closed_by":{"login":"Calinou","id":180032,"node_id":"MDQ6VXNlcjE4MDAzMg==","avatar_url":"https://avatars.githubusercontent.com/u/180032?v=4","gravatar_id":"","url":"https://api.github.com/users/Calinou","html_url":"https://github.com/Calinou","followers_url":"https://api.github.com/users/Calinou/followers","following_url":"https://api.github.com/users/Calinou/following{/other_user}","gists_url":"https://api.github.com/users/Calinou/gists{/gist_id}","starred_url":"https://api.github.com/users/Calinou/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Calinou/subscriptions","organizations_url":"https://api.github.com/users/Calinou/orgs","repos_url":"https://api.github.com/users/Calinou/repos","events_url":"https://api.github.com/users/Calinou/events{/privacy}","received_events_url":"https://api.github.com/users/Calinou/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/102075/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/godotengine/godot/issues/102075/timeline","performed_via_github_app":null,"state_reason":"completed","pinned_comment":null}