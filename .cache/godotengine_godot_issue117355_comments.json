[{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4044806939","html_url":"https://github.com/godotengine/godot/pull/117355#issuecomment-4044806939","issue_url":"https://api.github.com/repos/godotengine/godot/issues/117355","id":4044806939,"node_id":"IC_kwDOAO6SJc7xFtsb","user":{"login":"akien-mga","id":4701338,"node_id":"MDQ6VXNlcjQ3MDEzMzg=","avatar_url":"https://avatars.githubusercontent.com/u/4701338?v=4","gravatar_id":"","url":"https://api.github.com/users/akien-mga","html_url":"https://github.com/akien-mga","followers_url":"https://api.github.com/users/akien-mga/followers","following_url":"https://api.github.com/users/akien-mga/following{/other_user}","gists_url":"https://api.github.com/users/akien-mga/gists{/gist_id}","starred_url":"https://api.github.com/users/akien-mga/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/akien-mga/subscriptions","organizations_url":"https://api.github.com/users/akien-mga/orgs","repos_url":"https://api.github.com/users/akien-mga/repos","events_url":"https://api.github.com/users/akien-mga/events{/privacy}","received_events_url":"https://api.github.com/users/akien-mga/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-03-12T08:13:11Z","updated_at":"2026-03-12T08:13:11Z","body":"What percentage of current users would that exclude for e.g. the Godot Editor on Google Play?","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4044806939/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4047112083","html_url":"https://github.com/godotengine/godot/pull/117355#issuecomment-4047112083","issue_url":"https://api.github.com/repos/godotengine/godot/issues/117355","id":4047112083,"node_id":"IC_kwDOAO6SJc7xOgeT","user":{"login":"Alex2782","id":41921395,"node_id":"MDQ6VXNlcjQxOTIxMzk1","avatar_url":"https://avatars.githubusercontent.com/u/41921395?v=4","gravatar_id":"","url":"https://api.github.com/users/Alex2782","html_url":"https://github.com/Alex2782","followers_url":"https://api.github.com/users/Alex2782/followers","following_url":"https://api.github.com/users/Alex2782/following{/other_user}","gists_url":"https://api.github.com/users/Alex2782/gists{/gist_id}","starred_url":"https://api.github.com/users/Alex2782/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Alex2782/subscriptions","organizations_url":"https://api.github.com/users/Alex2782/orgs","repos_url":"https://api.github.com/users/Alex2782/repos","events_url":"https://api.github.com/users/Alex2782/events{/privacy}","received_events_url":"https://api.github.com/users/Alex2782/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-03-12T14:15:32Z","updated_at":"2026-03-12T14:15:32Z","body":"> What percentage of current users would that exclude for e.g. the Godot Editor on Google Play?\r\n\r\n**2.8%** active installations --> _(4454 / 185570 x 100)_\r\n \r\n<img width=\"279\" height=\"98\" alt=\"Bildschirmfoto 2026-03-12 um 14 33 39\" src=\"https://github.com/user-attachments/assets/26aa2f4d-be0a-49d1-a61d-4ef6ef06381f\" />\r\n\r\nThese Android versions have caused approximately 450 crash/ANR events in the last 28 days.\r\nAndroid 10+ versions have caused a rough estimate of more than 5k events.","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4047112083/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4048011061","html_url":"https://github.com/godotengine/godot/pull/117355#issuecomment-4048011061","issue_url":"https://api.github.com/repos/godotengine/godot/issues/117355","id":4048011061,"node_id":"IC_kwDOAO6SJc7xR781","user":{"login":"akien-mga","id":4701338,"node_id":"MDQ6VXNlcjQ3MDEzMzg=","avatar_url":"https://avatars.githubusercontent.com/u/4701338?v=4","gravatar_id":"","url":"https://api.github.com/users/akien-mga","html_url":"https://github.com/akien-mga","followers_url":"https://api.github.com/users/akien-mga/followers","following_url":"https://api.github.com/users/akien-mga/following{/other_user}","gists_url":"https://api.github.com/users/akien-mga/gists{/gist_id}","starred_url":"https://api.github.com/users/akien-mga/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/akien-mga/subscriptions","organizations_url":"https://api.github.com/users/akien-mga/orgs","repos_url":"https://api.github.com/users/akien-mga/repos","events_url":"https://api.github.com/users/akien-mga/events{/privacy}","received_events_url":"https://api.github.com/users/akien-mga/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-03-12T16:10:55Z","updated_at":"2026-03-12T16:10:55Z","body":"I'm all for upping the min recommended version to use the Vulkan driver, but doesn't this mean that it wouldn't be possible to install an app with fallback to OpenGL on these devices?\r\n\r\nThis might go against what we're trying to do in #114926, allowing users to support both Vulkan and OpenGL depending on the device. (That's not necessarily very practical for 3D games, but for 2D it can have similar visuals and helps maximize device support, which can be important for some games.)\r\n\r\nCC @mihe @DarioSamo ","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4048011061/reactions","total_count":2,"+1":2,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4054585159","html_url":"https://github.com/godotengine/godot/pull/117355#issuecomment-4054585159","issue_url":"https://api.github.com/repos/godotengine/godot/issues/117355","id":4054585159,"node_id":"IC_kwDOAO6SJc7xrA9H","user":{"login":"DarioSamo","id":538504,"node_id":"MDQ6VXNlcjUzODUwNA==","avatar_url":"https://avatars.githubusercontent.com/u/538504?v=4","gravatar_id":"","url":"https://api.github.com/users/DarioSamo","html_url":"https://github.com/DarioSamo","followers_url":"https://api.github.com/users/DarioSamo/followers","following_url":"https://api.github.com/users/DarioSamo/following{/other_user}","gists_url":"https://api.github.com/users/DarioSamo/gists{/gist_id}","starred_url":"https://api.github.com/users/DarioSamo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/DarioSamo/subscriptions","organizations_url":"https://api.github.com/users/DarioSamo/orgs","repos_url":"https://api.github.com/users/DarioSamo/repos","events_url":"https://api.github.com/users/DarioSamo/events{/privacy}","received_events_url":"https://api.github.com/users/DarioSamo/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-03-13T11:57:49Z","updated_at":"2026-03-13T11:59:28Z","body":"> I'm all for upping the min recommended version to use the Vulkan driver, but doesn't this mean that it wouldn't be possible to install an app with fallback to OpenGL on these devices?\r\n\r\nAs far as I can tell, the correct behavior here would be to remove this requirement altogether if fallback to OpenGL is enabled in the configuration, thus respecting what the user wants. Otherwise I don't see how it could ever trigger the fallback if it doesn't even let you install the application unless Vulkan is supported.\r\n\r\nOn the C++ side, you could also make the Vulkan context fail to initialize if this version requirement isn't matched (which I believe we support 1.0 at the moment), thus triggering the OpenGL fallback if enabled.","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4054585159/reactions","total_count":2,"+1":2,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4087665946","html_url":"https://github.com/godotengine/godot/pull/117355#issuecomment-4087665946","issue_url":"https://api.github.com/repos/godotengine/godot/issues/117355","id":4087665946,"node_id":"IC_kwDOAO6SJc7zpNUa","user":{"login":"m4gr3d","id":914968,"node_id":"MDQ6VXNlcjkxNDk2OA==","avatar_url":"https://avatars.githubusercontent.com/u/914968?v=4","gravatar_id":"","url":"https://api.github.com/users/m4gr3d","html_url":"https://github.com/m4gr3d","followers_url":"https://api.github.com/users/m4gr3d/followers","following_url":"https://api.github.com/users/m4gr3d/following{/other_user}","gists_url":"https://api.github.com/users/m4gr3d/gists{/gist_id}","starred_url":"https://api.github.com/users/m4gr3d/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/m4gr3d/subscriptions","organizations_url":"https://api.github.com/users/m4gr3d/orgs","repos_url":"https://api.github.com/users/m4gr3d/repos","events_url":"https://api.github.com/users/m4gr3d/events{/privacy}","received_events_url":"https://api.github.com/users/m4gr3d/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-03-19T04:02:47Z","updated_at":"2026-03-19T04:02:47Z","body":"> As far as I can tell, the correct behavior here would be to remove this requirement altogether if fallback to OpenGL is enabled in the configuration, thus respecting what the user wants. Otherwise I don't see how it could ever trigger the fallback if it doesn't even let you install the application unless Vulkan is supported.\r\n\r\nThe manifest changes are now optional (`required=false`) when fallback to opengl is enabled, and the warning about the min version being too low for vulkan support is also removed.\r\n\r\n> On the C++ side, you could also make the Vulkan context fail to initialize if this version requirement isn't matched (which I believe we support 1.0 at the moment), thus triggering the OpenGL fallback if enabled.\r\n\r\n`p_vulkan_requirements_met==false` when the version requirement are not matched in [`DisplayServerAndroid::check_vulkan_global_context(...)`](https://github.com/godotengine/godot/blob/456bdea954ee24e48cb562bfbf531de1cd96e371/platform/android/display_server_android.cpp#L686) so we skip trying to init the vulkan context, and directly fallback to opengl if enabled, or fail otherwise. ","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4087665946/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4090929998","html_url":"https://github.com/godotengine/godot/pull/117355#issuecomment-4090929998","issue_url":"https://api.github.com/repos/godotengine/godot/issues/117355","id":4090929998,"node_id":"IC_kwDOAO6SJc7z1qNO","user":{"login":"Repiteo","id":17489292,"node_id":"MDQ6VXNlcjE3NDg5Mjky","avatar_url":"https://avatars.githubusercontent.com/u/17489292?v=4","gravatar_id":"","url":"https://api.github.com/users/Repiteo","html_url":"https://github.com/Repiteo","followers_url":"https://api.github.com/users/Repiteo/followers","following_url":"https://api.github.com/users/Repiteo/following{/other_user}","gists_url":"https://api.github.com/users/Repiteo/gists{/gist_id}","starred_url":"https://api.github.com/users/Repiteo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Repiteo/subscriptions","organizations_url":"https://api.github.com/users/Repiteo/orgs","repos_url":"https://api.github.com/users/Repiteo/repos","events_url":"https://api.github.com/users/Repiteo/events{/privacy}","received_events_url":"https://api.github.com/users/Repiteo/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-03-19T15:24:30Z","updated_at":"2026-03-19T15:24:30Z","body":"Thanks!","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4090929998/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null}]