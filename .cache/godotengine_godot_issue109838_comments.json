":"https://api.github.com/users/jan-kapoli/following{/other_user}","gists_url":"https://api.github.com/users/jan-kapoli/gists{/gist_id}","starred_url":"https://api.github.com/users/jan-kapoli/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/jan-kapoli/subscriptions","organizations_url":"https://api.github.com/users/jan-kapoli/orgs","repos_url":"https://api.github.com/users/jan-kapoli/repos","events_url":"https://api.github.com/users/jan-kapoli/events{/privacy}","received_events_url":"https://api.github.com/users/jan-kapoli/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-08-29T17:37:05Z","updated_at":"2025-08-29T17:37:05Z","body":"It's worse now in v4.5.beta7.official [4ebf67c12]. Entering in ```0.000001``` (that is 1×10^-6) via the editor then pressing enter results in the editor displaying ```0.000012```. That is 12 times the entered value or one order of magnitude larger. Furthermore when running the scene the statement ```print_debug(f)``` prints ```0.00001084202172```. This is nowhere near to either of the previous values.\n@Calinou sorry, but can we bump the severity of this issue? I feel this is quite a serious usability bug. Or should I report a new issue?","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3237753189/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3238084965","html_url":"https://github.com/godotengine/godot/issues/109838#issuecomment-3238084965","issue_url":"https://api.github.com/repos/godotengine/godot/issues/109838","id":3238084965,"node_id":"IC_kwDOAO6SJc7BAUFl","user":{"login":"Calinou","id":180032,"node_id":"MDQ6VXNlcjE4MDAzMg==","avatar_url":"https://avatars.githubusercontent.com/u/180032?v=4","gravatar_id":"","url":"https://api.github.com/users/Calinou","html_url":"https://github.com/Calinou","followers_url":"https://api.github.com/users/Calinou/followers","following_url":"https://api.github.com/users/Calinou/following{/other_user}","gists_url":"https://api.github.com/users/Calinou/gists{/gist_id}","starred_url":"https://api.github.com/users/Calinou/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Calinou/subscriptions","organizations_url":"https://api.github.com/users/Calinou/orgs","repos_url":"https://api.github.com/users/Calinou/repos","events_url":"https://api.github.com/users/Calinou/events{/privacy}","received_events_url":"https://api.github.com/users/Calinou/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-08-29T19:50:52Z","updated_at":"2025-08-29T19:52:16Z","body":"cc @aaronfranke \n\nThis may be a regression from https://github.com/godotengine/godot/pull/109887.","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3238084965/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3238917665","html_url":"https://github.com/godotengine/godot/issues/109838#issuecomment-3238917665","issue_url":"https://api.github.com/repos/godotengine/godot/issues/109838","id":3238917665,"node_id":"IC_kwDOAO6SJc7BDfYh","user":{"login":"aaronfranke","id":1646875,"node_id":"MDQ6VXNlcjE2NDY4NzU=","avatar_url":"https://avatars.githubusercontent.com/u/1646875?v=4","gravatar_id":"","url":"https://api.github.com/users/aaronfranke","html_url":"https://github.com/aaronfranke","followers_url":"https://api.github.com/users/aaronfranke/followers","following_url":"https://api.github.com/users/aaronfranke/following{/other_user}","gists_url":"https://api.github.com/users/aaronfranke/gists{/gist_id}","starred_url":"https://api.github.com/users/aaronfranke/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/aaronfranke/subscriptions","organizations_url":"https://api.github.com/users/aaronfranke/orgs","repos_url":"https://api.github.com/users/aaronfranke/repos","events_url":"https://api.github.com/users/aaronfranke/events{/privacy}","received_events_url":"https://api.github.com/users/aaronfranke/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-08-30T03:54:52Z","updated_at":"2025-08-31T16:57:25Z","body":"The regression part is fixed in PR #110107.","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3238917665/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3240259031","html_url":"https://github.com/godotengine/godot/issues/109838#issuecomment-3240259031","issue_url":"https://api.github.com/repos/godotengine/godot/issues/109838","id":3240259031,"node_id":"IC_kwDOAO6SJc7BIm3X","user":{"login":"aaronfranke","id":1646875,"node_id":"MDQ6VXNlcjE2NDY4NzU=","avatar_url":"https://avatars.githubusercontent.com/u/1646875?v=4","gravatar_id":"","url":"https://api.github.com/users/aaronfranke","html_url":"https://github.com/aaronfranke","followers_url":"https://api.github.com/users/aaronfranke/followers","following_url":"https://api.github.com/users/aaronfranke/following{/other_user}","gists_url":"https://api.github.com/users/aaronfranke/gists{/gist_id}","starred_url":"https://api.github.com/users/aaronfranke/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/aaronfranke/subscriptions","organizations_url":"https://api.github.com/users/aaronfranke/orgs","repos_url":"https://api.github.com/users/aaronfranke/repos","events_url":"https://api.github.com/users/aaronfranke/events{/privacy}","received_events_url":"https://api.github.com/users/aaronfranke/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-08-31T16:31:22Z","updated_at":"2025-08-31T16:31:22Z","body":"As for the issue where 0.000001 is converted to 0.00000099999306 or similar, unfortunately, R128 does not have enough precision to solve this problem. We can't simultaneously store extremely large values and extremely small precise values in a fixed-precision format. PR #110107 fixes the regression but the full fix to the original issue will have to wait until Godot upgrades to a C++ version that has 128-bit floats.","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3240259031/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3240295902","html_url":"https://github.com/godotengine/godot/issues/109838#issuecomment-3240295902","issue_url":"https://api.github.com/repos/godotengine/godot/issues/109838","id":3240295902,"node_id":"IC_kwDOAO6SJc7BIv3e","user":{"login":"jan-kapoli","id":192364375,"node_id":"U_kgDOC3c_Vw","avatar_url":"https://avatars.githubusercontent.com/u/192364375?v=4","gravatar_id":"","url":"https://api.github.com/users/jan-kapoli","html_url":"https://github.com/jan-kapoli","followers_url":"https://api.github.com/users/jan-kapoli/followers","following_url":"https://api.github.com/users/jan-kapoli/following{/other_user}","gists_url":"https://api.github.com/users/jan-kapoli/gists{/gist_id}","starred_url":"https://api.github.com/users/jan-kapoli/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/jan-kapoli/subscriptions","organizations_url":"https://api.github.com/users/jan-kapoli/orgs","repos_url":"https://api.github.com/users/jan-kapoli/repos","events_url":"https://api.github.com/users/jan-kapoli/events{/privacy}","received_events_url":"https://api.github.com/users/jan-kapoli/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-08-31T17:36:28Z","updated_at":"2025-08-31T17:36:53Z","body":"@aaronfranke That's not the problem. The original issue is that small values which are handled correctly by gdscript (i.e. variable ```g``` set to ```0.00_000_1``` is correctly stored and correctly compared to ```0.0```) are rounded when set via the inspector.\n\nTo reiterate: following the setup in the original post, I would expect ```print_debug(f)``` to print a value that is _close enough_ to ```0.00_000_1``` within reason as to how floating point works. Printing ```0.00000099999306``` was mentioned as an expected result. The unexpected things is that the apparent precision differs when setting the variables through gdscript and the inspector, namely the inspector being far far less precise. I fell this is a bug, or at the least a poorly documented limitation of the inspector.\n\nI compiled the PR for Linux and could reproduce the original issue.","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3240295902/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3240298941","html_url":"https://github.com/godotengine/godot/issues/109838#issuecomment-3240298941","issue_url":"https://api.github.com/repos/godotengine/godot/issues/109838","id":3240298941,"node_id":"IC_kwDOAO6SJc7BIwm9","user":{"login":"aaronfranke","id":1646875,"node_id":"MDQ6VXNlcjE2NDY4NzU=","avatar_url":"https://avatars.githubusercontent.com/u/1646875?v=4","gravatar_id":"","url":"https://api.github.com/users/aaronfranke","html_url":"https://github.com/aaronfranke","followers_url":"https://api.github.com/users/aaronfranke/followers","following_url":"https://api.github.com/users/aaronfranke/following{/other_user}","gists_url":"https://api.github.com/users/aaronfranke/gists{/gist_id}","starred_url":"https://api.github.com/users/aaronfranke/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/aaronfranke/subscriptions","organizations_url":"https://api.github.com/users/aaronfranke/orgs","repos_url":"https://api.github.com/users/aaronfranke/repos","events_url":"https://api.github.com/users/aaronfranke/events{/privacy}","received_events_url":"https://api.github.com/users/aaronfranke/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-08-31T17:42:37Z","updated_at":"2025-08-31T17:42:37Z","body":"@jan-kapoli The reason this happens is because Godot is **not** storing the value as-is directly as you might expect.\n\nFirst it snaps the value to a multiple of the step size. This process is imprecise because the step size itself is a float which does not perfectly reflect the desired decimal step size. The workaround I have tried to employ is to stringify the step size to restore the true decimal value, then convert that decimal string into a higher precision type, then use that to snap, then convert the snapped value back to double. Unfortunately, the only type in Godot's codebase with higher precision than double is the fixed-precision R128, which is not a floating-point format, and therefore has limitations on its range of values.","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3240298941/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3242979790","html_url":"https://github.com/godotengine/godot/issues/109838#issuecomment-3242979790","issue_url":"https://api.github.com/repos/godotengine/godot/issues/109838","id":3242979790,"node_id":"IC_kwDOAO6SJc7BS_HO","user":{"login":"Repiteo","id":17489292,"node_id":"MDQ6VXNlcjE3NDg5Mjky","avatar_url":"https://avatars.githubusercontent.com/u/17489292?v=4","gravatar_id":"","url":"https://api.github.com/users/Repiteo","html_url":"https://github.com/Repiteo","followers_url":"https://api.github.com/users/Repiteo/followers","following_url":"https://api.github.com/users/Repiteo/following{/other_user}","gists_url":"https://api.github.com/users/Repiteo/gists{/gist_id}","starred_url":"https://api.github.com/users/Repiteo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Repiteo/subscriptions","organizations_url":"https://api.github.com/users/Repiteo/orgs","repos_url":"https://api.github.com/users/Repiteo/repos","events_url":"https://api.github.com/users/Repiteo/events{/privacy}","received_events_url":"https://api.github.com/users/Repiteo/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-09-01T17:29:05Z","updated_at":"2025-09-01T17:29:05Z","body":"Regression fixed in #110107; original issue remains","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3242979790/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3243138404","html_url":"https://github.com/godotengine/godot/issues/109838#issuecomment-3243138404","issue_url":"https://api.github.com/repos/godotengine/godot/issues/109838","id":3243138404,"node_id":"IC_kwDOAO6SJc7BTl1k","user":{"login":"aaronfranke","id":1646875,"node_id":"MDQ6VXNlcjE2NDY4NzU=","avatar_url":"https://avatars.githubusercontent.com/u/1646875?v=4","gravatar_id":"","url":"https://api.github.com/users/aaronfranke","html_url":"https://github.com/aaronfranke","followers_url":"https://api.github.com/users/aaronfranke/followers","following_url":"https://api.github.com/users/aaronfranke/following{/other_user}","gists_url":"https://api.github.com/users/aaronfranke/gists{/gist_id}","starred_url":"https://api.github.com/users/aaronfranke/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/aaronfranke/subscriptions","organizations_url":"https://api.github.com/users/aaronfranke/orgs","repos_url":"https://api.github.com/users/aaronfranke/repos","events_url":"https://api.github.com/users/aaronfranke/events{/privacy}","received_events_url":"https://api.github.com/users/aaronfranke/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-09-01T19:25:40Z","updated_at":"2025-09-01T19:25:40Z","body":"More fixed in PR #110176","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3243138404/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3243843315","html_url":"https://github.com/godotengine/godot/issues/109838#issuecomment-3243843315","issue_url":"https://api.github.com/repos/godotengine/godot/issues/109838","id":3243843315,"node_id":"IC_kwDOAO6SJc7BWR7z","user":{"login":"beicause","id":75941842,"node_id":"MDQ6VXNlcjc1OTQxODQy","avatar_url":"https://avatars.githubusercontent.com/u/75941842?v=4","gravatar_id":"","url":"https://api.github.com/users/beicause","html_url":"https://github.com/beicause","followers_url":"https://api.github.com/users/beicause/followers","following_url":"https://api.github.com/users/beicause/following{/other_user}","gists_url":"https://api.github.com/users/beicause/gists{/gist_id}","starred_url":"https://api.github.com/users/beicause/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/beicause/subscriptions","organizations_url":"https://api.github.com/users/beicause/orgs","repos_url":"https://api.github.com/users/beicause/repos","events_url":"https://api.github.com/users/beicause/events{/privacy}","received_events_url":"https://api.github.com/users/beicause/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-09-02T05:36:42Z","updated_at":"2025-09-02T05:38:25Z","body":"There is an another issue (See https://github.com/godotengine/godot/pull/110107#issuecomment-3241395702) because of `can_property_revert`:\n\nhttps://github.com/godotengine/godot/blob/6339f31a0217038ce6ed5e16776e34654895edc6/editor/inspector/editor_inspector.cpp#L734-L742\n\nhttps://github.com/godotengine/godot/blob/6339f31a0217038ce6ed5e16776e34654895edc6/scene/property_utils.cpp#L42-L45\n\nThat is to say, if the default value is too close to the value set by the editor, it will not be saved at all.","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3243843315/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null}]