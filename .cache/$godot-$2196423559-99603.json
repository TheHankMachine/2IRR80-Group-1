vatar_url":"https://avatars.githubusercontent.com/u/52852?v=4","created_at":"0001-01-01T00:00:00Z","followers":0,"following":0,"html_url":"https://github.com/stuartcarnie","id":52852,"node_id":"MDQ6VXNlcjUyODUy","login":"stuartcarnie","type":"User","owned_private_repos":0,"public_gists":0,"public_repos":0,"total_private_repos":0,"url":"https://api.github.com/users/stuartcarnie"},"body":"","html_url":"https://github.com/godotengine/godot/pull/99603#pullrequestreview-2530751058","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/99603","author_association":"CONTRIBUTOR","submitted_at":"2025-01-04T14:40:20Z"},{"id":2530751212,"node_id":"PRR_kwDOAO6SJc6W2DLs","state":"COMMENTED","user":{"site_admin":false,"suspended":false,"updated_at":"0001-01-01T00:00:00Z","avatar_url":"https://avatars.githubusercontent.com/u/52852?v=4","created_at":"0001-01-01T00:00:00Z","followers":0,"following":0,"html_url":"https://github.com/stuartcarnie","id":52852,"node_id":"MDQ6VXNlcjUyODUy","login":"stuartcarnie","type":"User","owned_private_repos":0,"public_gists":0,"public_repos":0,"total_private_repos":0,"url":"https://api.github.com/users/stuartcarnie"},"body":"Removed the `enum` in the `RendererSceneRenderRD::_render_buffers_post_process_and_tonemap` function. I also introduced a `SpatialScaler` base class, so we can reuse the upscaling code:\r\n\r\n```cpp\r\n\tif (rb.is_valid() && spatial_upscaler) {\r\n\t\tspatial_upscaler->ensure_context(rb);\r\n\r\n\t\tRD::get_singleton()->draw_command_begin_label(spatial_upscaler->get_label());\r\n\r\n\t\tfor (uint32_t v = 0; v < rb->get_view_count(); v++) {\r\n\t\t\tRID source_texture = rb->get_texture_slice(SNAME(\"Tonemapper\"), SNAME(\"destination\"), v, 0);\r\n\t\t\tRID dest_texture = texture_storage->render_target_get_rd_texture_slice(render_target, v);\r\n\r\n\t\t\tspatial_upscaler->process(rb, source_texture, dest_texture);\r\n\t\t}\r\n\r\n\t\tif (dest_is_msaa_2d) {\r\n\t\t\t// We can't upscale directly into our MSAA buffer so we need to do a copy\r\n\t\t\tRID source_texture = texture_storage->render_target_get_rd_texture(render_target);\r\n\t\t\tRID dest_fb = FramebufferCacheRD::get_singleton()->get_cache(texture_storage->render_target_get_rd_texture_msaa(render_target));\r\n\t\t\tcopy_effects->copy_to_fb_rect(source_texture, dest_fb, Rect2i(Point2i(), rb->get_target_size()));\r\n\r\n\t\t\ttexture_storage->render_target_set_msaa_needs_resolve(render_target, true); // Make sure this gets resolved.\r\n\t\t}\r\n\r\n\t\tRD::get_singleton()->draw_command_end_label();\r\n\t}\r\n```\r\n\r\nrather than two separate blocks which did the same thing.","html_url":"https://github.com/godotengine/godot/pull/99603#pullrequestreview-2530751212","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/99603","author_association":"CONTRIBUTOR","submitted_at":"2025-01-04T14:46:19Z"},{"id":2532028404,"node_id":"PRR_kwDOAO6SJc6W66_0","state":"COMMENTED","user":{"site_admin":false,"suspended":false,"updated_at":"0001-01-01T00:00:00Z","avatar_url":"https://avatars.githubusercontent.com/u/538504?u=45f09996711edf524a11181d136e38113210b6ce&v=4","created_at":"0001-01-01T00:00:00Z","followers":0,"following":0,"html_url":"https://github.com/DarioSamo","id":538504,"node_id":"MDQ6VXNlcjUzODUwNA==","login":"DarioSamo","type":"User","owned_private_repos":0,"public_gists":0,"public_repos":0,"total_private_repos":0,"url":"https://api.github.com/users/DarioSamo"},"body":"","html_url":"https://github.com/godotengine/godot/pull/99603#pullrequestreview-2532028404","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/99603","author_association":"CONTRIBUTOR","submitted_at":"2025-01-06T12:20:24Z"},{"id":2532032332,"node_id":"PRR_kwDOAO6SJc6W679M","state":"CHANGES_REQUESTED","user":{"site_admin":false,"suspended":false,"updated_at":"0001-01-01T00:00:00Z","avatar_url":"https://avatars.githubusercontent.com/u/538504?u=45f09996711edf524a11181d136e38113210b6ce&v=4","created_at":"0001-01-01