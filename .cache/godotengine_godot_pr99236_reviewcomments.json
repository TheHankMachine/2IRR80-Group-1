stood something :sweat_smile: ","created_at":"2024-11-14T15:33:09Z","updated_at":"2024-11-14T15:33:09Z","html_url":"https://github.com/godotengine/godot/pull/99236#discussion_r1842431241","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/99236","_links":{"self":{"href":"https://api.github.com/repos/godotengine/godot/pulls/comments/1842431241"},"html":{"href":"https://github.com/godotengine/godot/pull/99236#discussion_r1842431241"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/99236"}},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/1842431241/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":null,"original_line":null,"side":"RIGHT","in_reply_to_id":1842417930,"author_association":"CONTRIBUTOR","original_position":6,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/1842438462","pull_request_review_id":2436441159,"id":1842438462,"node_id":"PRRC_kwDOAO6SJc5t0WE-","diff_hunk":"@@ -206,6 +206,9 @@ void Label::_shape() {\n \t\t\tcase TextServer::OVERRUN_NO_TRIMMING:\n \t\t\t\tbreak;\n \t\t}\n+\t\tif (horizontal_alignment == HORIZONTAL_ALIGNMENT_RIGHT) {\n+\t\t\toverrun_flags.set_flag(TextServer::OVERRUN_ELLIPSIS_AT_START);\n+\t\t}","path":"scene/gui/label.cpp","commit_id":"5636941c6d72faba10a04e4ccebf8908af58def6","original_commit_id":"c3483dc30c401c29c787fc7e5536e80271506487","user":{"login":"bruvzg","id":7645683,"node_id":"MDQ6VXNlcjc2NDU2ODM=","avatar_url":"https://avatars.githubusercontent.com/u/7645683?v=4","gravatar_id":"","url":"https://api.github.com/users/bruvzg","html_url":"https://github.com/bruvzg","followers_url":"https://api.github.com/users/bruvzg/followers","following_url":"https://api.github.com/users/bruvzg/following{/other_user}","gists_url":"https://api.github.com/users/bruvzg/gists{/gis