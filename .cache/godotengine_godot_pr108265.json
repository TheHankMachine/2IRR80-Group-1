ess than NavigatinAgent3D.path_desired_distance, use the smaller value in NavigationAgent3D::_is_within_waypoint_distance() when matching the last waypoint.  This allows the agent to get closer to the final position while still allowing flexibility when matching waypoints.\r\n\r\nPrior to this change, the navigation would finish outside the target_desired_distance when it was less than path_desired_distance.\r\n\r\nfixes #108261\r\n\r\n<!--\r\nPlease target the `master` branch in priority.\r\n\r\nRelevant fixes are cherry-picked for stable branches as needed by maintainers.\r\n\r\nTo speed up the contribution process and avoid CI errors, please set up pre-commit hooks locally:\r\nhttps://docs.godotengine.org/en/latest/contributing/development/code_style_guidelines.html\r\n-->\r\n","labels":[{"id":279096997,"node_id":"MDU6TGFiZWwyNzkwOTY5OTc=","url":"https://api.github.com/repos/godotengine/godot/labels/archived","name":"archived","description":"","color":"aaaaaa","default":false,"archived_at":null,"archived_by":null},{"id":1752040694,"node_id":"MDU6TGFiZWwxNzUyMDQwNjk0","url":"https://api.github.com/repos/godotengine/godot/labels/topic:navigation","name":"topic:navigation","description":"","color":"ffee88","default":false,"archived_at":null,"archived_by":null},{"id":2666708289,"node_id":"MDU6TGFiZWwyNjY2NzA4Mjg5","url":"https://api.github.com/repos/godotengine/godot/labels/topic:3d","name":"topic:3d","description":"","color":"ffee88","default":false,"archived_at":null,"archived_by":null}],"milestone":null,"active_lock_reason":null,"created_at":"2025-07-04T04:30:39Z","updated_at":"2025-07-11T18:16:30Z","closed_at":"2025-07-11T18:13:44Z","merged_at":null,"merge_commit_sha":"7249d6b42bdac954787895ca81365c7c3e163f38","assignee":null,"assignees":[],"requested_reviewers":[],"requested_teams":[],"head":{"label":"dmlary:nav-agent-last-waypoint-distance-fix","ref":"nav-agent-last-waypoint-distance-fix","repo":{"id":798476797,"node_id":"R_kgDOL5fJ_Q","name":"godot","full_name