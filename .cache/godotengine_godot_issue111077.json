ect (MRP)\n\nno specific godot project apart from a base godot-mono with built solutions.","closed_by":{"login":"jamesonBradfield","id":113628216,"node_id":"U_kgDOBsXUOA","avatar_url":"https://avatars.githubusercontent.com/u/113628216?v=4","gravatar_id":"","url":"https://api.github.com/users/jamesonBradfield","html_url":"https://github.com/jamesonBradfield","followers_url":"https://api.github.com/users/jamesonBradfield/followers","following_url":"https://api.github.com/users/jamesonBradfield/following{/other_user}","gists_url":"https://api.github.com/users/jamesonBradfield/gists{/gist_id}","starred_url":"https://api.github.com/users/jamesonBradfield/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/jamesonBradfield/subscriptions","organizations_url":"https://api.github.com/users/jamesonBradfield/orgs","repos_url":"https://api.github.com/users/jamesonBradfield/repos","events_url":"https://api.github.com/users/jamesonBradfield/events{/privacy}","received_events_url":"https://api.github.com/users/jamesonBradfield/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/111077/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/godotengine/godot/issues/111077/timeline","performed_via_github_app":null,"state_reason":"completed","pinned_comment":null}