tps://api.github.com/users/Sauermann/events{/privacy}","received_events_url":"https://api.github.com/users/Sauermann/received_events","type":"User","user_view_type":"public","site_admin":false},"open_issues":3,"closed_issues":3687,"state":"closed","created_at":"2024-12-19T08:51:28Z","updated_at":"2026-09-04T21:48:38Z","due_on":"2025-09-15T00:00:00Z","closed_at":"2025-09-18T17:13:14Z"},"comments":7,"created_at":"2025-07-29T16:47:38Z","updated_at":"2025-08-22T17:44:22Z","closed_at":"2025-08-22T17:39:17Z","assignee":{"login":"bruvzg","id":7645683,"node_id":"MDQ6VXNlcjc2NDU2ODM=","avatar_url":"https://avatars.githubusercontent.com/u/7645683?v=4","gravatar_id":"","url":"https://api.github.com/users/bruvzg","html_url":"https://github.com/bruvzg","followers_url":"https://api.github.com/users/bruvzg/followers","following_url":"https://api.github.com/users/bruvzg/following{/other_user}","gists_url":"https://api.github.com/users/bruvzg/gists{/gist_id}","starred_url":"https://api.github.com/users/bruvzg/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/bruvzg/subscriptions","organizations_url":"https://api.github.com/users/bruvzg/orgs","repos_url":"https://api.github.com/users/bruvzg/repos","events_url":"https://api.github.com/users/bruvzg/events{/privacy}","received_events_url":"https://api.github.com/users/bruvzg/received_events","type":"User","user_view_type":"public","site_admin":false},"author_association":"CONTRIBUTOR","issue_field_values":[],"type":null,"active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"### Tested versions\n\nReproducible in 4.5beta3 and 4.4.1 (although 4.4.1 does not have the emoji baseline fix).\n\n### System information\n\nMacOS and iOS. Not verified on Windows, but likely applies.\n\n### Issue description\n\nThe `allow_system_fallback` font import setting is ignored when multichannel signed distance field is enabled. This prevents emojis from showing by falling back to the system font.\n\nThe workaround (other than to not use MSDF) is to manually supply a fallback font in the `Fallbacks` array, but two issues arise with this workaround:\n1) The MacOS/iOS fix for incorrect emoji baseline vertical alignment isn't applied.\n2) Memory use can go up dramatically, because unlike the system font used with `allow_system_fallback`, the manually specified system font name is not cached, so every font falling back to this font name consumes an additional 350MB of memory (at least on MacOS/iOS). This is a big problem on mobile platforms.\n\nIt's seems like both of these issues would be moot if the `allow_system_fallback` were working for MSDF fonts. It seems like for most use cases, the manual `Fallbacks` are unnecessary when `allow_system_fallbacks` is working.\n\n<img width=\"1150\" height=\"645\" alt=\"Image\" src=\"https://github.com/user-attachments/assets/8971cc6c-7b6f-4512-b8ea-1558807395af\" />\n\n### Steps to reproduce\n\nSee MRP.\n\n### Minimal reproduction project (MRP)\n\n[msdf_fonts_ignore_allow_system_fallback_MRP.zip](https://github.com/user-attachments/files/21493662/msdf_fonts_ignore_allow_system_fallback_MRP.zip)","closed_by":{"login":"Repiteo","id":17489292,"node_id":"MDQ6VXNlcjE3NDg5Mjky","avatar_url":"https://avatars.githubusercontent.com/u/17489292?v=4","gravatar_id":"","url":"https://api.github.com/users/Repiteo","html_url":"https://github.com/Repiteo","followers_url":"https://api.github.com/users/Repiteo/followers","following_url":"https://api.github.com/users/Repiteo/following{/other_user}","gists_url":"https://api.github.com/users/Repiteo/gists{/gist_id}","starred_url":"https://api.github.com/users/Repiteo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Repiteo/subscriptions","organizations_url":"https://api.github.com/users/Repiteo/orgs","repos_url":"https://api.github.com/users/Repiteo/repos","events_url":"https://api.github.com/users/Repiteo/events{/privacy}","received_events_url":"https://api.github.com/users/Repiteo/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/109091/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/godotengine/godot/issues/109091/timeline","performed_via_github_app":null,"state_reason":"completed","pinned_comment":null}