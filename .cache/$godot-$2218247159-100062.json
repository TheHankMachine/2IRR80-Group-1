EVICE_ADDRESS\r\nSUPPORTS_BUFFER_DEVICE_ADDRESS\r\n```","html_url":"https://github.com/godotengine/godot/pull/100062#pullrequestreview-2532097425","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/100062","author_association":"CONTRIBUTOR","submitted_at":"2025-01-06T13:02:37Z"},{"id":2547203517,"node_id":"PRR_kwDOAO6SJc6X0z29","state":"APPROVED","user":{"site_admin":false,"suspended":false,"updated_at":"0001-01-01T00:00:00Z","avatar_url":"https://avatars.githubusercontent.com/u/538504?u=45f09996711edf524a11181d136e38113210b6ce&v=4","created_at":"0001-01-01T00:00:00Z","followers":0,"following":0,"html_url":"https://github.com/DarioSamo","id":538504,"node_id":"MDQ6VXNlcjUzODUwNA==","login":"DarioSamo","type":"User","owned_private_repos":0,"public_gists":0,"public_repos":0,"total_private_repos":0,"url":"https://api.github.com/users/DarioSamo"},"body":"","html_url":"https://github.com/godotengine/godot/pull/100062#pullrequestreview-2547203517","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/100062","author_association":"CONTRIBUTOR","submitted_at":"2025-01-13T16:40:51Z"},{"id":2485619593,"node_id":"PRR_kwDOAO6SJc6UJ4uJ","state":"APPROVED","user":{"site_admin":false,"suspended":false,"updated_at":"0001-01-01T00:00:00Z","avatar_url":"https://avatars.githubusercontent.com/u/96648715?u=af70f5d107e9c1447f296643d5a566dab53d25e8&v=4","created_at":"0001-01-01T00:00:00Z","followers":0,"following":0,"html_url":"https://github.com/AThousandShips","id":96648715,"node_id":"U_kgDOBcK-Cw","login":"AThousandShips","type":"User","owned_private_repos":0,"public_gists":0,"public_repos":0,"total_private_repos":0,"url":"https://api.github.com/users/AThousandShips"},"body":"","html_url":"https://github.com/godotengine/godot/pull/100062#pullrequestreview-2485619593","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/100062","author_association":"MEMBER","submitted_at":"2025-01-13T16:43:26Z"}]