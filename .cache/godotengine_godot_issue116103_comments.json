[{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3874214268","html_url":"https://github.com/godotengine/godot/issues/116103#issuecomment-3874214268","issue_url":"https://api.github.com/repos/godotengine/godot/issues/116103","id":3874214268,"node_id":"IC_kwDOAO6SJc7m69F8","user":{"login":"cdemirer","id":41021322,"node_id":"MDQ6VXNlcjQxMDIxMzIy","avatar_url":"https://avatars.githubusercontent.com/u/41021322?v=4","gravatar_id":"","url":"https://api.github.com/users/cdemirer","html_url":"https://github.com/cdemirer","followers_url":"https://api.github.com/users/cdemirer/followers","following_url":"https://api.github.com/users/cdemirer/following{/other_user}","gists_url":"https://api.github.com/users/cdemirer/gists{/gist_id}","starred_url":"https://api.github.com/users/cdemirer/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/cdemirer/subscriptions","organizations_url":"https://api.github.com/users/cdemirer/orgs","repos_url":"https://api.github.com/users/cdemirer/repos","events_url":"https://api.github.com/users/cdemirer/events{/privacy}","received_events_url":"https://api.github.com/users/cdemirer/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-02-09T22:31:08Z","updated_at":"2026-02-09T22:31:08Z","body":"Can't reproduce (on a non-mono version). Would you please share a repro script?","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3874214268/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3875520112","html_url":"https://github.com/godotengine/godot/issues/116103#issuecomment-3875520112","issue_url":"https://api.github.com/repos/godotengine/godot/issues/116103","id":3875520112,"node_id":"IC_kwDOAO6SJc7m_75w","user":{"login":"QuirinusInvictus","id":93449411,"node_id":"U_kgDOBZHsww","avatar_url":"https://avatars.githubusercontent.com/u/93449411?v=4","gravatar_id":"","url":"https://api.github.com/users/QuirinusInvictus","html_url":"https://github.com/QuirinusInvictus","followers_url":"https://api.github.com/users/QuirinusInvictus/followers","following_url":"https://api.github.com/users/QuirinusInvictus/following{/other_user}","gists_url":"https://api.github.com/users/QuirinusInvictus/gists{/gist_id}","starred_url":"https://api.github.com/users/QuirinusInvictus/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/QuirinusInvictus/subscriptions","organizations_url":"https://api.github.com/users/QuirinusInvictus/orgs","repos_url":"https://api.github.com/users/QuirinusInvictus/repos","events_url":"https://api.github.com/users/QuirinusInvictus/events{/privacy}","received_events_url":"https://api.github.com/users/QuirinusInvictus/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-02-10T06:05:37Z","updated_at":"2026-02-10T06:06:16Z","body":"Double-check on the newly created Godot project in v4.6.stable.official [89cea1439]\nThe bug is there, as well as on mono version.\nHere is the script I used to test it:\n```\nextends Node\n@export var ExportVariable: int #set to 4 in the editor. I checked in the scene file to confirm and it is set 4\nvar MyDic = {ExportVariable: \"export key\", 1 : ExportVariable}\n\nfunc _ready() -> void:\n\tprint(ExportVariable)#Correctly prints 4\n#\tprint(MyDic[ExportVariable]) #will result in error: Invalid access to property or key '4' on a base object of type 'Dictionary'.\n\tprint(MyDic[0])#Prints \"export key\".\n\tprint(MyDic[1])#Prints 0\n```\n(Github don't let me share the .gd file)\nI just attach it to any object and run the game. \nThe bug is espetially anoying with resources, as export variables are more imporntant there. (Thats how I discover it)","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3875520112/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3875637422","html_url":"https://github.com/godotengine/godot/issues/116103#issuecomment-3875637422","issue_url":"https://api.github.com/repos/godotengine/godot/issues/116103","id":3875637422,"node_id":"IC_kwDOAO6SJc7nAYiu","user":{"login":"dalexeev","id":47700418,"node_id":"MDQ6VXNlcjQ3NzAwNDE4","avatar_url":"https://avatars.githubusercontent.com/u/47700418?v=4","gravatar_id":"","url":"https://api.github.com/users/dalexeev","html_url":"https://github.com/dalexeev","followers_url":"https://api.github.com/users/dalexeev/followers","following_url":"https://api.github.com/users/dalexeev/following{/other_user}","gists_url":"https://api.github.com/users/dalexeev/gists{/gist_id}","starred_url":"https://api.github.com/users/dalexeev/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/dalexeev/subscriptions","organizations_url":"https://api.github.com/users/dalexeev/orgs","repos_url":"https://api.github.com/users/dalexeev/repos","events_url":"https://api.github.com/users/dalexeev/events{/privacy}","received_events_url":"https://api.github.com/users/dalexeev/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-02-10T06:35:35Z","updated_at":"2026-02-10T06:35:35Z","body":"Please note that the assignment of exported variables occurs significantly after the object is instantiated. This means that when the `MyDic` variable is initialized, the `ExportVariable` will still be equal to `0`, not `4`. See the [documentation](https://docs.godotengine.org/en/stable/tutorials/scripting/gdscript/gdscript_basics.html#initialization-order).","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3875637422/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3875690790","html_url":"https://github.com/godotengine/godot/issues/116103#issuecomment-3875690790","issue_url":"https://api.github.com/repos/godotengine/godot/issues/116103","id":3875690790,"node_id":"IC_kwDOAO6SJc7nAlkm","user":{"login":"QuirinusInvictus","id":93449411,"node_id":"U_kgDOBZHsww","avatar_url":"https://avatars.githubusercontent.com/u/93449411?v=4","gravatar_id":"","url":"https://api.github.com/users/QuirinusInvictus","html_url":"https://github.com/QuirinusInvictus","followers_url":"https://api.github.com/users/QuirinusInvictus/followers","following_url":"https://api.github.com/users/QuirinusInvictus/following{/other_user}","gists_url":"https://api.github.com/users/QuirinusInvictus/gists{/gist_id}","starred_url":"https://api.github.com/users/QuirinusInvictus/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/QuirinusInvictus/subscriptions","organizations_url":"https://api.github.com/users/QuirinusInvictus/orgs","repos_url":"https://api.github.com/users/QuirinusInvictus/repos","events_url":"https://api.github.com/users/QuirinusInvictus/events{/privacy}","received_events_url":"https://api.github.com/users/QuirinusInvictus/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-02-10T06:48:11Z","updated_at":"2026-02-10T06:48:11Z","body":"I see. If I understand correctly, the dictionary _init is called first, before the export values are set. But I assumed that GDScript did not differentiate between value and reference types. When I used a variable in a dictionary, shouldn't the dictionary just point at the value, rather than copy the value from the variable?","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3875690790/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3875842720","html_url":"https://github.com/godotengine/godot/issues/116103#issuecomment-3875842720","issue_url":"https://api.github.com/repos/godotengine/godot/issues/116103","id":3875842720,"node_id":"IC_kwDOAO6SJc7nBKqg","user":{"login":"dalexeev","id":47700418,"node_id":"MDQ6VXNlcjQ3NzAwNDE4","avatar_url":"https://avatars.githubusercontent.com/u/47700418?v=4","gravatar_id":"","url":"https://api.github.com/users/dalexeev","html_url":"https://github.com/dalexeev","followers_url":"https://api.github.com/users/dalexeev/followers","following_url":"https://api.github.com/users/dalexeev/following{/other_user}","gists_url":"https://api.github.com/users/dalexeev/gists{/gist_id}","starred_url":"https://api.github.com/users/dalexeev/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/dalexeev/subscriptions","organizations_url":"https://api.github.com/users/dalexeev/orgs","repos_url":"https://api.github.com/users/dalexeev/repos","events_url":"https://api.github.com/users/dalexeev/events{/privacy}","received_events_url":"https://api.github.com/users/dalexeev/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-02-10T07:29:49Z","updated_at":"2026-02-10T07:42:55Z","body":"> If I understand correctly, the dictionary _init is called first, before the export values are set.\n\nNo, `Dictionary` doesn't have `_init()`.\n\nNon-static class properties are initialized in the order they are defined in the code, with the exception of `@onready` variables, whose initialization is deferred until `_ready()`.\n\n`@export` merely tells the engine that this property can be set in the scene/resource file and displayed in the editor. `@export` doesn't defer initialization of the property, much less any properties that depend on it. So, your initialization code is:\n\n```gdscript\nvar ExportVariable: int # `@export` doesn't matter here.\nvar MyDic = {ExportVariable: \"export key\", 1 : ExportVariable}\n```\n\n1. `ExportVariable` is initialized to `0` because it is the default value of type `int`.\n2. `MyDic` is initialized with a dictionary at the moment when the variable `ExportVariable` is still equal to `0`.\n\nAssigning values ​​specified in the scene/resource file to exported variables is a separate process that occurs after the instance is fully initialized. Since `int` is passed by value, not by reference, changing `ExportVariable` does not affect the previously created dictionary pointed to by the `MyDic` variable.\n\nYou can fix this by using `@onready` or assigning `MyDic` in `_ready()`. But I'd recommend first understanding what effect you want to achieve and what options the engine provides.\n\n```gdscript\n@export var ExportVariable: int\n@onready var MyDic = {ExportVariable: \"export key\", 1 : ExportVariable}\n\nfunc _ready() -> void:\n    # ...\n```\n\nor\n\n```gdscript\n@export var ExportVariable: int\nvar MyDic\n\nfunc _ready() -> void:\n    MyDic = {ExportVariable: \"export key\", 1 : ExportVariable}\n    # ...\n```\n\nPlease note that this tracker is intended for reporting engine bugs, not for helping users with their problems while learning or using the engine. If you're unsure whether some engine behavior is a bug, you can ask for help in the [community channels](https://godotengine.org/community/). Good luck with your projects!","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3875842720/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3875886151","html_url":"https://github.com/godotengine/godot/issues/116103#issuecomment-3875886151","issue_url":"https://api.github.com/repos/godotengine/godot/issues/116103","id":3875886151,"node_id":"IC_kwDOAO6SJc7nBVRH","user":{"login":"QuirinusInvictus","id":93449411,"node_id":"U_kgDOBZHsww","avatar_url":"https://avatars.githubusercontent.com/u/93449411?v=4","gravatar_id":"","url":"https://api.github.com/users/QuirinusInvictus","html_url":"https://github.com/QuirinusInvictus","followers_url":"https://api.github.com/users/QuirinusInvictus/followers","following_url":"https://api.github.com/users/QuirinusInvictus/following{/other_user}","gists_url":"https://api.github.com/users/QuirinusInvictus/gists{/gist_id}","starred_url":"https://api.github.com/users/QuirinusInvictus/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/QuirinusInvictus/subscriptions","organizations_url":"https://api.github.com/users/QuirinusInvictus/orgs","repos_url":"https://api.github.com/users/QuirinusInvictus/repos","events_url":"https://api.github.com/users/QuirinusInvictus/events{/privacy}","received_events_url":"https://api.github.com/users/QuirinusInvictus/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-02-10T07:37:33Z","updated_at":"2026-02-10T07:37:33Z","body":"Thanks for the clarification.","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3875886151/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null}]