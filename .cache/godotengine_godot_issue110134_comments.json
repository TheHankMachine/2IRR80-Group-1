[{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3240173892","html_url":"https://github.com/godotengine/godot/issues/110134#issuecomment-3240173892","issue_url":"https://api.github.com/repos/godotengine/godot/issues/110134","id":3240173892,"node_id":"IC_kwDOAO6SJc7BISFE","user":{"login":"Calinou","id":180032,"node_id":"MDQ6VXNlcjE4MDAzMg==","avatar_url":"https://avatars.githubusercontent.com/u/180032?v=4","gravatar_id":"","url":"https://api.github.com/users/Calinou","html_url":"https://github.com/Calinou","followers_url":"https://api.github.com/users/Calinou/followers","following_url":"https://api.github.com/users/Calinou/following{/other_user}","gists_url":"https://api.github.com/users/Calinou/gists{/gist_id}","starred_url":"https://api.github.com/users/Calinou/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Calinou/subscriptions","organizations_url":"https://api.github.com/users/Calinou/orgs","repos_url":"https://api.github.com/users/Calinou/repos","events_url":"https://api.github.com/users/Calinou/events{/privacy}","received_events_url":"https://api.github.com/users/Calinou/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-08-31T14:12:31Z","updated_at":"2025-08-31T14:12:31Z","body":"This is not a bug. This occurs because your project uses the `viewport` stretch mode, but zooming in the 2D editor will not replicate the pixelation that occurs when upscaling. The animation looks different at a low viewport resolution due to all the pixel snapping going on.\n\nIf you want the game appearance to match the editor appearance when zooming in, use the `canvas_items` stretch mode in the project settings instead.\n\nThere's already another issue where this was discussed, but I can't find it right now. Either way, having some kind of toggle to emulate the pixelation that would occur when scaling (according to the zoom level) could be useful, but it's [proposal](https://github.com/godotengine/godot-proposals) territory.","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3240173892/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3240724146","html_url":"https://github.com/godotengine/godot/issues/110134#issuecomment-3240724146","issue_url":"https://api.github.com/repos/godotengine/godot/issues/110134","id":3240724146,"node_id":"IC_kwDOAO6SJc7BKYay","user":{"login":"zkcrescent","id":14883259,"node_id":"MDQ6VXNlcjE0ODgzMjU5","avatar_url":"https://avatars.githubusercontent.com/u/14883259?v=4","gravatar_id":"","url":"https://api.github.com/users/zkcrescent","html_url":"https://github.com/zkcrescent","followers_url":"https://api.github.com/users/zkcrescent/followers","following_url":"https://api.github.com/users/zkcrescent/following{/other_user}","gists_url":"https://api.github.com/users/zkcrescent/gists{/gist_id}","starred_url":"https://api.github.com/users/zkcrescent/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/zkcrescent/subscriptions","organizations_url":"https://api.github.com/users/zkcrescent/orgs","repos_url":"https://api.github.com/users/zkcrescent/repos","events_url":"https://api.github.com/users/zkcrescent/events{/privacy}","received_events_url":"https://api.github.com/users/zkcrescent/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-09-01T03:00:07Z","updated_at":"2025-09-01T03:00:07Z","body":"Thanks a lot for replay! It's really helpful for me. I'll try canvas_items stretch mode later.","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3240724146/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes