304\r\n\r\nThe person of the shadow mask is to mask out positional lights, in https://github.com/godotengine/godot/pull/98835 I wrongly used the same mask for directional lights even though it doesn't make sense to do so as the mask is calculated for each item-light pair. The result is that every DirectionalLight shadow gets culled\r\n\r\nDirectionalLight2Ds can't mask out Canvasitems anyway, so no check is needed at all. ","labels":[{"id":73330064,"node_id":"MDU6TGFiZWw3MzMzMDA2NA==","url":"https://api.github.com/repos/godotengine/godot/labels/bug","name":"bug","description":"","color":"ff6055","default":true,"archived_at":null,"archived_by":null},{"id":279098111,"node_id":"MDU6TGFiZWwyNzkwOTgxMTE=","url":"https://api.github.com/repos/godotengine/godot/labels/topic:rendering","name":"topic:rendering","description":"","color":"ffee88","default":false,"archived_at":null,"archived_by":null},{"id":1332303119,"node_id":"MDU6TGFiZWwxMzMyMzAzMTE5","url":"https://api.github.com/repos/godotengine/godot/labels/regression","name":"regression","description":"","color":"ff63ac","default":false,"archived_at":null,"archived_by":null}],"milestone":{"id":10558797,"node_id":"MI_kwDOAO6SJc4AoR1N","url":"https://api.github.com/repos/godotengine/godot/milestones/20","html_url":"https://github.com/godotengine/godot/milestone/20","labels_url":"https://api.github.com/repos/godotengine/godot/milestones/20/labels","number":20,"state":"closed","title":"4.4","description":"","creator":{"login":"akien-mga","id":4701338,"node_id":"MDQ6VXNlcjQ3MDEzMzg=","avatar_url":"https://avatars.githubusercontent.com/u/4701338?v=4","gravatar_id":"","url":"https://api.github.com/users/akien-mga","html_url":"https://github.com/akien-mga","followers_url":"https://api.github.com/users/akien-mga/followers","following_url":"https://api.github.com/users/akien-mga/following{/other_user}","gists_url":"https://api.github.com/users/akien-mga/gists{/gist_id}","starred_url":"https://api.github.com/users/akien-mga/starred