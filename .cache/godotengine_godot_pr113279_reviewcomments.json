ot/pull/113279#discussion_r2571983291"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/113279"}},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/2571983291/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":null,"original_line":37,"side":"RIGHT","author_association":"MEMBER","original_position":7,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/2586213342","pull_request_review_id":3536405593,"id":2586213342,"node_id":"PRRC_kwDOAO6SJc6aJnve","diff_hunk":"@@ -1147,6 +1147,8 @@ static void handle_interrupt(int sig) {\n }\n \n void OS_MacOS_NSApp::terminate() {\n+\tgodot_cleanup_profiler();","path":"platform/macos/os_macos.mm","commit_id":"acefbbbbcdadc23b229ab91ebd52385551a8fcfc","original_commit_id":"acefbbbbcdadc23b229ab91ebd52385551a8fcfc","user":{"login":"mihe","id":4884246,"node_id":"MDQ6VXNlcjQ4ODQyNDY=","avatar_url":"https://avatars.githubusercontent.com/u/4884246?v=4","gravatar_id":"","url":"https://api.github.com/users/mihe","html_url":"https://github.com/mihe","followers_url":"https://api.github.com/users/mihe/followers","following_url":"https://api.github.com/users/mihe/following{/other_user}","gists_url":"https://api.github.com/users/mihe/gists{/gist_id}","starred_url":"https://api.github.com/users/mihe/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/mihe/subscriptions","organizations_url":"https://api.github.com/users/mihe/orgs","repos_url":"https://api.github.com/users/mihe/repos","events_url":"https://api.github.com/users/mihe/events{/privacy}","received_events_url":"https://api.github.com/users/mihe/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"I believe the placement of this is problematic.\n\nI just tried backporting this to 4.5 and ran it in a fairly large real-world project, and in this particular project you run into a crash here when shutting down the game:\n\nhttps://github.com/godotengine/godot/blob/8105ff7ac735f83be221296a6bb9b22caa7d9253/core/profiling/profiling.cpp#L82\n\n... because `OS_MacOS_NSApp::cleanup` is what tears down the `MainLoop` (i.e. `SceneTree`), which can involve GDScript stuff, and which is called as part of `[NSApp terminate:nil]` *after* `godot_cleanup_profiler` has been called in `OS_MacOS_NSApp::terminate`.\n\nSo I would imagine that `godot_cleanup_profiler` should be called at the bottom of `OS_MacOS_NSApp::cleanup` instead, unless I'm missing something?\n\n(I'll make an actual issue for it shortly.)","created_at":"2025-12-03T18:36:14Z","updated_at":"2025-12-03T18:36:14Z","html_url":"https://github.com/godotengine/godot/pull/113279#discussion_r2586213342","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/113279","_links":{"self":{"href":"https://api.github.com/repos/godotengine/godot/pulls/comments/2586213342"},"html":{"href":"https://github.com/godotengine/godot/pull/113279#discussion_r2586213342"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/113279"}},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/2586213342/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":1150,"original_line":1150,"side":"RIGHT","author_association":"CONTRIBUTOR","original_position":4,"position":4,"subject_type":"line"},{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/2586267822","pull_request_review_id":3536471028,"id":2586267822,"node_id":"PRRC_kwDOAO6SJc6aJ1Cu","diff_hunk":"@@ -1147,6 +1147,8 @@ static void handle_interrupt(int sig) {\n }\n \n void OS_MacOS_NSApp::terminate() {\n+\tgodot_cleanup_profiler();","path":"platform/macos/os_macos.mm","commit_id":"acefbbbbcdadc