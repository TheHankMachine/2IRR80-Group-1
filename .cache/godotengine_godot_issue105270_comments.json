6VXNlcjEwNjc3NzI=","avatar_url":"https://avatars.githubusercontent.com/u/1067772?v=4","gravatar_id":"","url":"https://api.github.com/users/hsandt","html_url":"https://github.com/hsandt","followers_url":"https://api.github.com/users/hsandt/followers","following_url":"https://api.github.com/users/hsandt/following{/other_user}","gists_url":"https://api.github.com/users/hsandt/gists{/gist_id}","starred_url":"https://api.github.com/users/hsandt/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/hsandt/subscriptions","organizations_url":"https://api.github.com/users/hsandt/orgs","repos_url":"https://api.github.com/users/hsandt/repos","events_url":"https://api.github.com/users/hsandt/events{/privacy}","received_events_url":"https://api.github.com/users/hsandt/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-05-08T17:14:23Z","updated_at":"2026-05-08T17:14:23Z","body":"Still in Godot 4.6. I was about to open an issue about Grid Step being forgotten when you reopen the project, but now I wonder if it wasn't due to changing scene.\n\nI need to try a MRP to see if it's only forgetting Grid Step when changing scene, when restarting the editor, or both.","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4408385031/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4855970818","html_url":"https://github.com/godotengine/godot/issues/105270#issuecomment-4855970818","issue_url":"https://api.github.com/repos/godotengine/godot/issues/105270","id":4855970818,"node_id":"IC_kwDOAO6SJc8AAAABIXA8Ag","user":{"login":"hsandt","id":1067772,"node_id":"MDQ6VXNlcjEwNjc3NzI=","avatar_url":"https://avatars.githubusercontent.com/u/1067772?v=4","gravatar_id":"","url":"https://api.github.com/users/hsandt","html_url":"https://github.com/hsandt","followers_url":"https://api.github.com/users/hsandt/followers","following_url":"https://api.github.com/users/hsandt/following{/other_user}","gists_url":"https://api.github.com/users/hsandt/gists{/gist_id}","starred_url":"https://api.github.com/users/hsandt/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/hsandt/subscriptions","organizations_url":"https://api.github.com/users/hsandt/orgs","repos_url":"https://api.github.com/users/hsandt/repos","events_url":"https://api.github.com/users/hsandt/events{/privacy}","received_events_url":"https://api.github.com/users/hsandt/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-07-01T14:08:17Z","updated_at":"2026-07-01T14:08:17Z","body":"Waiting for the PR just above to be merged, I found a **workaround** by editing .godot cfg text files directly.\n\nNote: I'm giving the format for Godot 4, I don't know if it's the same as Godot 3.\n\nBasically, the canvas item editor settings is also saved in the temporary `.godot/editor/(scene_name).tscn-editstate-(uid).cfg` file for a given scene. Note that this uid is not related to scene UID.\n\nThe file looks like this:\n\n```cfg\n[editor_states]\n\n2D={\n\"grid_offset\": Vector2(0, 0),\n\"grid_snap_active\": true,\n\"grid_step\": Vector2(96, 96),\n\"grid_visibility\": 1,\n...\n}\n```\n\nTherefore, we can edit those text files directly via some script. I tested it with some manual change, and it worked without having to restart editor! Just (re)open the scene or Reload Saved Scene (alt+shift+R) (make sure not to save your scene before to avoid overwriting your changes in external tool) to see the grid setting change!\n\nI opened the folder in a code editor like VS Code then applied a simple text Find and Replace over all .cfg files:\n\nReplace\n`\"grid_step\": Vector2(8, 8),`\nwith\n`\"grid_step\": Vector2(96, 96),`\n\nor whichever value you want. You may also set the other grid parameters if needed.","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4855970818/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null}]