[{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2727445858","html_url":"https://github.com/godotengine/godot/pull/104210#issuecomment-2727445858","issue_url":"https://api.github.com/repos/godotengine/godot/issues/104210","id":2727445858,"node_id":"IC_kwDOAO6SJc6ikYVi","user":{"login":"smix8","id":52464204,"node_id":"MDQ6VXNlcjUyNDY0MjA0","avatar_url":"https://avatars.githubusercontent.com/u/52464204?v=4","gravatar_id":"","url":"https://api.github.com/users/smix8","html_url":"https://github.com/smix8","followers_url":"https://api.github.com/users/smix8/followers","following_url":"https://api.github.com/users/smix8/following{/other_user}","gists_url":"https://api.github.com/users/smix8/gists{/gist_id}","starred_url":"https://api.github.com/users/smix8/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/smix8/subscriptions","organizations_url":"https://api.github.com/users/smix8/orgs","repos_url":"https://api.github.com/users/smix8/repos","events_url":"https://api.github.com/users/smix8/events{/privacy}","received_events_url":"https://api.github.com/users/smix8/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-03-16T13:39:17Z","updated_at":"2025-03-17T00:00:33Z","body":"Added a new bake dialog. It now processed the regions in a queue with the threaded baking.\r\n\r\nThe warning and exklusive popup Window hopefully enough to keep users from messing up the editor in the meantime.\r\n\r\nSorry but we cant allow users editing the scene while the baking runs. Doing edits in the middle of the node parsing is an easy way to cause crashes or data corruption. Switching scenes alone is trouble as the editor does too much problematic stuff in the background with the nodes on a scene switch. We also cant do all the parsing at the begin because that is also an easy way to run into memory crashes later.","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2727445858/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2727551468","html_url":"https://github.com/godotengine/godot/pull/104210#issuecomment-2727551468","issue_url":"https://api.github.com/repos/godotengine/godot/issues/104210","id":2727551468,"node_id":"IC_kwDOAO6SJc6ikyHs","user":{"login":"smix8","id":52464204,"node_id":"MDQ6VXNlcjUyNDY0MjA0","avatar_url":"https://avatars.githubusercontent.com/u/52464204?v=4","gravatar_id":"","url":"https://api.github.com/users/smix8","html_url":"https://github.com/smix8","followers_url":"https://api.github.com/users/smix8/followers","following_url":"https://api.github.com/users/smix8/following{/other_user}","gists_url":"https://api.github.com/users/smix8/gists{/gist_id}","starred_url":"https://api.github.com/users/smix8/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/smix8/subscriptions","organizations_url":"https://api.github.com/users/smix8/orgs","repos_url":"https://api.github.com/users/smix8/repos","events_url":"https://api.github.com/users/smix8/events{/privacy}","received_events_url":"https://api.github.com/users/smix8/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-03-16T17:22:40Z","updated_at":"2025-03-16T17:22:40Z","body":"Now that we have a new Window dialog added back in the bake state for the steps of the navmesh baking process.","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2727551468/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2889098260","html_url":"https://github.com/godotengine/godo