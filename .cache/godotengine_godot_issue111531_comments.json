31388,"node_id":"MDQ6VXNlcjM4NDMxMzg4","avatar_url":"https://avatars.githubusercontent.com/u/38431388?v=4","gravatar_id":"","url":"https://api.github.com/users/Joonnas","html_url":"https://github.com/Joonnas","followers_url":"https://api.github.com/users/Joonnas/followers","following_url":"https://api.github.com/users/Joonnas/following{/other_user}","gists_url":"https://api.github.com/users/Joonnas/gists{/gist_id}","starred_url":"https://api.github.com/users/Joonnas/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Joonnas/subscriptions","organizations_url":"https://api.github.com/users/Joonnas/orgs","repos_url":"https://api.github.com/users/Joonnas/repos","events_url":"https://api.github.com/users/Joonnas/events{/privacy}","received_events_url":"https://api.github.com/users/Joonnas/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-01-16T16:37:40Z","updated_at":"2026-01-16T16:37:40Z","body":"I finally found some time to implement my new approach. I adressed the blitting/performance issues and I found out how to render the already rendered scene as a background quad. I put the details in the PR description :)","author_association":"NONE","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3760878722/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4503959027","html_url":"https://github.com/godotengine/godot/pull/111531#issuecomment-4503959027","issue_url":"https://api.github.com/repos/godotengine/godot/issues/111531","id":4503959027,"node_id":"IC_kwDOAO6SJc8AAAABDHT18w","user":{"login":"BastiaanOlij","id":1945449,"node_id":"MDQ6VXNlcjE5NDU0NDk=","avatar_url":"https://avatars.githubusercontent.com/u/1945449?v=4","gravatar_id":"","url":"https://api.github.com/users/BastiaanOlij","html_url":"https://github.com/BastiaanOlij","followers_url":"https://api.github.com/users/BastiaanOlij/followers","following_url":"https://api.github.com/users/BastiaanOlij/following{/other_user}","gists_url":"https://api.github.com/users/BastiaanOlij/gists{/gist_id}","starred_url":"https://api.github.com/users/BastiaanOlij/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/BastiaanOlij/subscriptions","organizations_url":"https://api.github.com/users/BastiaanOlij/orgs","repos_url":"https://api.github.com/users/BastiaanOlij/repos","events_url":"https://api.github.com/users/BastiaanOlij/events{/privacy}","received_events_url":"https://api.github.com/users/BastiaanOlij/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-05-21T01:23:06Z","updated_at":"2026-05-21T01:23:06Z","body":"Looks good in broad strokes, my two cents here are:\r\n\r\n- Probably not solvable due to our architecture but if you are rendering 3D into an MSAA buffer, it has to resolve, and then copy back into the 2D MSAA buffer to add the 2D rendering bits. Which is very wasteful. In theory the 2D render pass could continue rendering into the 3D MSAA buffer and delay resolving that till we're finish. But I fear that would require a serious rewrite of some internals.\r\n- In the 3D MSAA implementation we make sure of certain extensions that allow automatic resolve with the MSAA data never being written out of tile memory, which is a significant performance improvement over doing the resolve with a blit, especially on phones. It would be good to see that solution replicated for 2D as well. ","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4503959027/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4561989959","html_url":"https://github.com/godotengine/godot/pull/111531#issuecomment-4561989959","issue_url":"https://api.github.com/repos/godotengine/godot/issues/111531","id":4561989959,"node_id":"IC_kwDOAO6SJc8AAAABD-pxRw","user":{"login":"Joonnas","id":38431388,"node_id":"MDQ6VXNlcjM4NDMxMzg4","avatar_url":"https://avatars.githubusercontent.com/u/38431388?v=4","gravatar_id":"","url":"https://api.github.com/users/Joonnas","html_url":"https://github.com/Joonnas","followers_url":"https://api.github.com/users/Joonnas/followers","following_url":"https://api.github.com/users/Joonnas/following{/other_user}","gists_url":"https://api.github.com/users/Joonnas/gists{/gist_id}","starred_url":"https://api.github.com/users/Joonnas/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Joonnas/subscriptions","organizations_url":"https://api.github.com/users/Joonnas/orgs","repos_url":"https://api.github.com/users/Joonnas/repos","events_url":"https://api.github.com/users/Joonnas/events{/privacy}","received_events_url":"https://api.github.com/users/Joonnas/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-05-28T08:10:37Z","updated_at":"2026-05-28T08:10:37Z","body":"@BastiaanOlij While I would need to spend more time on that, I think it would be possible to implement one MSAA buffer for 2D and 3D. However, this would mean that we could only have one MSAA setting for both, 2D and 3D, instead of separate ones and the post processing of the 3D scene would be needed to be applied after the final resolve which then would affect the 2D scene as well which I am not sure if we would want this. (Maybe it would be also possible to solve these issues but, as you mentioned, this would be probably much more involved).\r\n\r\nIf you are refering to `GL_EXT_multisampled_render_to_texture` I already use that. The extension for the multiview is not used since this PR does not yet support multiview.","author_association":"NONE","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4561989959/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5183673684","html_url":"https://github.com/godotengine/godot/pull/111531#issuecomment-5183673684","issue_url":"https://api.github.com/repos/godotengine/godot/issues/111531","id":5183673684,"node_id":"IC_kwDOAO6SJc8AAAABNPiVVA","user":{"login":"Zephilinox","id":2060863,"node_id":"MDQ6VXNlcjIwNjA4NjM=","avatar_url":"https://avatars.githubusercontent.com/u/2060863?v=4","gravatar_id":"","url":"https://api.github.com/users/Zephilinox","html_url":"https://github.com/Zephilinox","followers_url":"https://api.github.com/users/Zephilinox/followers","following_url":"https://api.github.com/users/Zephilinox/following{/other_user}","gists_url":"https://api.github.com/users/Zephilinox/gists{/gist_id}","starred_url":"https://api.github.com/users/Zephilinox/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Zephilinox/subscriptions","organizations_url":"https://api.github.com/users/Zephilinox/orgs","repos_url":"https://api.github.com/users/Zephilinox/repos","events_url":"https://api.github.com/users/Zephilinox/events{/privacy}","received_events_url":"https://api.github.com/users/Zephilinox/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-08-04T19:30:27Z","updated_at":"2026-08-04T19:30:27Z","body":"thanks, I might have to yoink this into my fork. are there any know limitations or is the concern only performance atm? ","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5183673684/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null}]