ithub.com/user-attachments/files/29500612/test_alert_source.zip)\r\n\r\nAs I'm still relatively new to the Godot codebase, I'd really appreciate your feedback! If you have any questions or suggestions for a better approach, please let me know.","author_association":"NONE","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4842149482/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4844283461","html_url":"https://github.com/godotengine/godot/pull/120756#issuecomment-4844283461","issue_url":"https://api.github.com/repos/godotengine/godot/issues/120756","id":4844283461,"node_id":"IC_kwDOAO6SJc8AAAABIL3mRQ","user":{"login":"AThousandShips","id":96648715,"node_id":"U_kgDOBcK-Cw","avatar_url":"https://avatars.githubusercontent.com/u/96648715?v=4","gravatar_id":"","url":"https://api.github.com/users/AThousandShips","html_url":"https://github.com/AThousandShips","followers_url":"https://api.github.com/users/AThousandShips/followers","following_url":"https://api.github.com/users/AThousandShips/following{/other_user}","gists_url":"https://api.github.com/users/AThousandShips/gists{/gist_id}","starred_url":"https://api.github.com/users/AThousandShips/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/AThousandShips/subscriptions","organizations_url":"https://api.github.com/users/AThousandShips/orgs","repos_url":"https://api.github.com/users/AThousandShips/repos","events_url":"https://api.github.com/users/AThousandShips/events{/privacy}","received_events_url":"https://api.github.com/users/AThousandShips/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-06-30T13:59:55Z","updated_at":"2026-06-30T13:59:55Z","body":"> Yes, the code was written by AI. However, I did personally review the logic and test it to e