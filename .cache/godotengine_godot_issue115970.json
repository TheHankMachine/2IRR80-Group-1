)\n\n### Steps to reproduce\n\nDownload Godot_mono Mac\nInstall the latest dotnet package (10.0.102 Arm was used)\nCreate a new project\nCreate a sample scene\nCreate a test C# script\nClick build\n\n### Minimal reproduction project (MRP)\n\n[Test Game.zip](https://github.com/user-attachments/files/25134577/Test.Game.zip)","closed_by":{"login":"Saabir14","id":64490729,"node_id":"MDQ6VXNlcjY0NDkwNzI5","avatar_url":"https://avatars.githubusercontent.com/u/64490729?v=4","gravatar_id":"","url":"https://api.github.com/users/Saabir14","html_url":"https://github.com/Saabir14","followers_url":"https://api.github.com/users/Saabir14/followers","following_url":"https://api.github.com/users/Saabir14/following{/other_user}","gists_url":"https://api.github.com/users/Saabir14/gists{/gist_id}","starred_url":"https://api.github.com/users/Saabir14/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Saabir14/subscriptions","organizations_url":"https://api.github.com/users/Saabir14/orgs","repos_url":"https://api.github.com/users/Saabir14/repos","events_url":"https://api.github.com/users/Saabir14/events{/privacy}","received_events_url":"https://api.github.com/users/Saabir14/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/115970/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/godotengine/godot/issues/115970/timeline","performed_via_github_app":null,"state_reason":"completed","pinned_comment":null}