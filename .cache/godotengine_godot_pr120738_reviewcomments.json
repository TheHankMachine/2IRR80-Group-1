hin enums, rather than a flat list of constants with an additional enum specified. See #98233.","created_at":"2026-06-29T17:27:19Z","updated_at":"2026-06-29T17:27:19Z","html_url":"https://github.com/godotengine/godot/pull/120738#discussion_r3493556915","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/120738","_links":{"self":{"href":"https://api.github.com/repos/godotengine/godot/pulls/comments/3493556915"},"html":{"href":"https://github.com/godotengine/godot/pull/120738#discussion_r3493556915"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/120738"}},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/3493556915/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":1696,"original_line":1696,"side":"RIGHT","author_association":"CONTRIBUTOR","original_position":5,"position":5,"subject_type":"line"},{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/3493734707","pull_request_review_id":4594219667,"id":3493734707,"node_id":"PRRC_kwDOAO6SJc7QPikz","diff_hunk":"@@ -1693,7 +1693,7 @@ void EditorHelp::_update_doc() {\n \t\t\tif (!is_documented && constant.name.begins_with(\"_\")) {\n \t\t\t\tcontinue;\n \t\t\t}\n-\t\t\tif (!constant.enumeration.is_empty()) {\n+\t\t\tif (!constant.enumeration.is_empty() && !constant.enumeration.contains(\".\")) {","path":"editor/doc/editor_help.cpp","commit_id":"d7fc128a706e6e9cd35fe639064d629691fe3a68","original_commit_id":"d7fc128a706e6e9cd35fe639064d629691fe3a68","user":{"login":"mattigu","id":47303532,"node_id":"MDQ6VXNlcjQ3MzAzNTMy","avatar_url":"https://avatars.githubusercontent.com/u/47303532?v=4","gravatar_id":"","url":"https://api.github.com/users/mattigu","html_url":"https://github.com/mattigu","followers_url":"https://api.github.com/users/mattigu/followers","following_url":"https://api.github.com/users/mattig