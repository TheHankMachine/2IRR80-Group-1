.com/users/bruvzg/followers","following_url":"https://api.github.com/users/bruvzg/following{/other_user}","gists_url":"https://api.github.com/users/bruvzg/gists{/gist_id}","starred_url":"https://api.github.com/users/bruvzg/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/bruvzg/subscriptions","organizations_url":"https://api.github.com/users/bruvzg/orgs","repos_url":"https://api.github.com/users/bruvzg/repos","events_url":"https://api.github.com/users/bruvzg/events{/privacy}","received_events_url":"https://api.github.com/users/bruvzg/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-04-16T06:09:04Z","updated_at":"2025-04-16T06:09:04Z","body":"I can reproduce it on real X11, but it's also reproducible with https://github.com/godotengine/godot/pull/101980 reverted.","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2808478769/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2808561072","html_url":"https://github.com/godotengine/godot/issues/105433#issuecomment-2808561072","issue_url":"https://api.github.com/repos/godotengine/godot/issues/105433","id":2808561072,"node_id":"IC_kwDOAO6SJc6nZz2w","user":{"login":"bruvzg","id":7645683,"node_id":"MDQ6VXNlcjc2NDU2ODM=","avatar_url":"https://avatars.githubusercontent.com/u/7645683?v=4","gravatar_id":"","url":"https://api.github.com/users/bruvzg","html_url":"https://github.com/bruvzg","followers_url":"https://api.github.com/users/bruvzg/followers","following_url":"https://api.github.com/users/bruvzg/following{/other_user}","gists_url":"https://api.github.com/users/bruvzg/gists{/gist_id}","starred_url":"https://api.github.com/users/bruvzg/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/bruvzg/subscriptions","organizations_url":"https://api.github.com/users/bruvzg/orgs","repos_url":"https://api.github.com/users/bruvzg/repos","events_url":"https://api.github.com/users/bruvzg/events{/privacy}","received_events_url":"https://api.github.com/users/bruvzg/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-04-16T06:47:54Z","updated_at":"2025-04-16T06:47:54Z","body":"Seems like in entirely depends on maximize animation timing.","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2808561072/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2809805981","html_url":"https://github.com/godotengine/godot/issues/105433#issuecomment-2809805981","issue_url":"https://api.github.com/repos/godotengine/godot/issues/105433","id":2809805981,"node_id":"IC_kwDOAO6SJc6nejyd","user":{"login":"darksylinc","id":3395130,"node_id":"MDQ6VXNlcjMzOTUxMzA=","avatar_url":"https://avatars.githubusercontent.com/u/3395130?v=4","gravatar_id":"","url":"https://api.github.com/users/darksylinc","html_url":"https://github.com/darksylinc","followers_url":"https://api.github.com/users/darksylinc/followers","following_url":"https://api.github.com/users/darksylinc/following{/other_user}","gists_url":"https://api.github.com/users/darksylinc/gists{/gist_id}","starred_url":"https://api.github.com/users/darksylinc/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/darksylinc/subscriptions","organizations_url":"https://api.github.com/users/darksylinc/orgs","repos_url":"https://api.github.com/users/darksylinc/repos","events_url":"https://api.github.com/users/darksylinc/events{/privacy}","received_events_url":"https://api.github.com/users/darksylinc/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-04-16T14:39:23Z","updated_at":"2025-04-16T14:39:23Z","body":"While chatting with Clay, it is worth mentioning that (at least on a real X11) there was a race condition where once in a while the boot splash would be stretched. However when this happened, often it would stretch to cover 100% of the window (i.e. it was stretched in a different way as how it does now).\n\nAfter this PR, the stretch is 100% always the same, and looks more like a hardcoded size being displayed.","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2809805981/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2809841348","html_url":"https://github.com/godotengine/godot/issues/105433#issuecomment-2809841348","issue_url":"https://api.github.com/repos/godotengine/godot/issues/105433","id":2809841348,"node_id":"IC_kwDOAO6SJc6nesbE","user":{"login":"bruvzg","id":7645683,"node_id":"MDQ6VXNlcjc2NDU2ODM=","avatar_url":"https://avatars.githubusercontent.com/u/7645683?v=4","gravatar_id":"","url":"https://api.github.com/users/bruvzg","html_url":"https://github.com/bruvzg","followers_url":"https://api.github.com/users/bruvzg/followers","following_url":"https://api.github.com/users/bruvzg/following{/other_user}","gists_url":"https://api.github.com/users/bruvzg/gists{/gist_id}","starred_url":"https://api.github.com/users/bruvzg/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/bruvzg/subscriptions","organizations_url":"https://api.github.com/users/bruvzg/orgs","repos_url":"https://api.github.com/users/bruvzg/repos","events_url":"https://api.github.com/users/bruvzg/events{/privacy}","received_events_url":"https://api.github.com/users/bruvzg/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-04-16T14:51:16Z","updated_at":"2025-04-16T14:51:16Z","body":"Not sure about race condition, but for me, it's always stretched the same way both with and without https://github.com/godotengine/godot/pull/101980 if windows is maximized. I was not able to get any other behavior. The cause of this is maximization animation, X11 return pre-maximization window size before animation is completed, and it is stretched (in case of Vulkan) or displayed off center (in case of OpenGL) if aspect ratio of old size is deferent from maximized window size. Two `ConfigureNotify` events (for old and new size) are both received after splash screen is already gone.","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2809841348/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2809850921","html_url":"https://github.com/godotengine/godot/issues/105433#issuecomment-2809850921","issue_url":"https://api.github.com/repos/godotengine/godot/issues/105433","id":2809850921,"node_id":"IC_kwDOAO6SJc6neuwp","user":{"login":"bruvzg","id":7645683,"node_id":"MDQ6VXNlcjc2NDU2ODM=","avatar_url":"https://avatars.githubusercontent.com/u/7645683?v=4","gravatar_id":"","url":"https://api.github.com/users/bruvzg","html_url":"https://github.com/bruvzg","followers_url":"https://api.github.com/users/bruvzg/followers","following_url":"https://api.github.com/users/bruvzg/following{/other_user}","gists_url":"https://api.github.com/users/bruvzg/gists{/gist_id}","starred_url":"https://api.github.com/users/bruvzg/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/bruvzg/subscriptions","organizations_url":"https://api.github.com/users/bruvzg/orgs","repos_url":"https://api.github.com/users/bruvzg/repos","events_url":"https://api.github.com/users/bruvzg/events{/privacy}","received_events_url":"https://api.github.com/users/bruvzg/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-04-16T14:54:30Z","updated_at":"2025-04-16T14:54:30Z","body":"I see only two options - either guess maximized window size based on screen size (https://github.com/godotengine/godot/pull/105451, seems to be working in all conditions I have tested), or wait until both `ConfigureNotify` events are received, which probably will result in black window during maximization animation.","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2809850921/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null}]