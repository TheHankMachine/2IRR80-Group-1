88","default":false,"description":"","archived_at":null,"archived_by":null},{"id":1332303119,"node_id":"MDU6TGFiZWwxMzMyMzAzMTE5","url":"https://api.github.com/repos/godotengine/godot/labels/regression","name":"regression","color":"ff63ac","default":false,"description":"","archived_at":null,"archived_by":null},{"id":1732720779,"node_id":"MDU6TGFiZWwxNzMyNzIwNzc5","url":"https://api.github.com/repos/godotengine/godot/labels/topic:gui","name":"topic:gui","color":"ffee88","default":false,"description":"","archived_at":null,"archived_by":null}],"state":"closed","locked":false,"assignees":[],"milestone":{"url":"https://api.github.com/repos/godotengine/godot/milestones/25","html_url":"https://github.com/godotengine/godot/milestone/25","labels_url":"https://api.github.com/repos/godotengine/godot/milestones/25/labels","id":15520464,"node_id":"MI_kwDOAO6SJc4A7NLQ","number":25,"title":"4.8","description":"","creator":{"login":"Repiteo","id":17489292,"node_id":"MDQ6VXNlcjE3NDg5Mjky","avatar_url":"https://avatars.githubusercontent.com/u/17489292?v=4","gravatar_id":"","url":"https://api.github.com/users/Repiteo","html_url":"https://github.com/Repiteo","followers_url":"https://api.github.com/users/Repiteo/followers","following_url":"https://api.github.com/users/Repiteo/following{/other_user}","gists_url":"https://api.github.com/users/Repiteo/gists{/gist_id}","starred_url":"https://api.github.com/users/Repiteo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Repiteo/subscriptions","organizations_url":"https://api.github.com/users/Repiteo/orgs","repos_url":"https://api.github.com/users/Repiteo/repos","events_url":"https://api.github.com/users/Repiteo/events{/privacy}","received_events_url":"https://api.github.com/users/Repiteo/received_events","type":"User","user_view_type":"public","site_admin":false},"open_issues":343,"closed_issues":2335,"state":"open","created_at":"2026-04-13T15:59:35Z","updated_at":"2026-10-22T06:28:22Z","due_on":null,"closed_at":null},"comments":8,"created_at":"2026-07-05T11:35:36Z","updated_at":"2026-07-24T15:16:23Z","closed_at":"2026-07-10T19:10:33Z","assignee":null,"author_association":"MEMBER","issue_field_values":[],"type":null,"active_lock_reason":null,"draft":false,"pull_request":{"url":"https://api.github.com/repos/godotengine/godot/pulls/120962","html_url":"https://github.com/godotengine/godot/pull/120962","diff_url":"https://github.com/godotengine/godot/pull/120962.diff","patch_url":"https://github.com/godotengine/godot/pull/120962.patch","merged_at":"2026-07-10T19:10:33Z"},"body":"This PR fixes a touch behavior issue that occurs when `enable_long_press_as_right_click` is enabled.\r\nregression from https://github.com/godotengine/godot/pull/110893\r\n\r\nThe following describes the behavior before and after this change. A normal tap always generates a press event.\r\n\r\nWhen `Action Mode = Button Release` and `Button Mask = Mouse Left`\r\n\r\n- Before this PR: A long press triggers a button press action even though the button has not been released yet.\r\n- After this PR: A long press does not trigger any action. When a long press is detected, the original touch is canceled and `enable_long_press_as_right_click` generates a `Mouse Right` event instead. Since the button is configured for `Mouse Left`, no action is triggered.\r\n\r\nWhen `Action Mode = Button Release` and `Button Mask = Mouse Right`\r\n\r\n- Before this PR: A long press triggers a button press action before the touch is released, and another press action is triggered when the touch is released.\r\n- After this PR: A long press triggers a single button press action when the touch is released.\r\n\r\nWhen `Action Mode = Button Press`, the behavior remains unchanged:\r\n\r\n- `Button Mask = Mouse Left`: A press action is triggered immediately on touch.\r\n- `Button Mask = Mouse Right`: A press action is triggered immediately on touch. If the touch is held long enough to become a long press, an additional press action is triggered for the right-click event.","closed_by":{"login":"Repiteo","id":17489292,"node_id":"MDQ6VXNlcjE3NDg5Mjky","avatar_url":"https://avatars.githubusercontent.com/u/17489292?v=4","gravatar_id":"","url":"https://api.github.com/users/Repiteo","html_url":"https://github.com/Repiteo","followers_url":"https://api.github.com/users/Repiteo/followers","following_url":"https://api.github.com/users/Repiteo/following{/other_user}","gists_url":"https://api.github.com/users/Repiteo/gists{/gist_id}","starred_url":"https://api.github.com/users/Repiteo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Repiteo/subscriptions","organizations_url":"https://api.github.com/users/Repiteo/orgs","repos_url":"https://api.github.com/users/Repiteo/repos","events_url":"https://api.github.com/users/Repiteo/events{/privacy}","received_events_url":"https://api.github.com/users/Repiteo/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/120962/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/godotengine/godot/issues/120962/timeline","performed_via_github_app":null,"state_reason":null}