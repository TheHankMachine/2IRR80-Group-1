[{"id":2500818944,"node_id":"PRR_kwDOAO6SJc6VD3gA","user":{"login":"hpvb","id":2591099,"node_id":"MDQ6VXNlcjI1OTEwOTk=","avatar_url":"https://avatars.githubusercontent.com/u/2591099?u=7bcd4921b265b0b8cc1d8a15638a3fac93c87e68&v=4","gravatar_id":"","url":"https://api.github.com/users/hpvb","html_url":"https://github.com/hpvb","followers_url":"https://api.github.com/users/hpvb/followers","following_url":"https://api.github.com/users/hpvb/following{/other_user}","gists_url":"https://api.github.com/users/hpvb/gists{/gist_id}","starred_url":"https://api.github.com/users/hpvb/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/hpvb/subscriptions","organizations_url":"https://api.github.com/users/hpvb/orgs","repos_url":"https://api.github.com/users/hpvb/repos","events_url":"https://api.github.com/users/hpvb/events{/privacy}","received_events_url":"https://api.github.com/users/hpvb/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"At the risk of bikeshedding, I think we might as well just set `-mssse3` that is supported by every CPU that has at least 2 cores. The newest cpu to support it is AMD's \"bobcat\" architecture which is from early 2011.\r\n\r\nEvery single \"atom\" branded CPU has it too. On the Intel side this makes the oldest required CPU a \"Core 2 duo\" or a 64bit capable P4.\r\n\r\nNow I don't want this to bikeshed forever, I am just approving this. But I would also just approve an `-mssse3` if presented! ","state":"APPROVED","html_url":"https://github.com/godotengine/godot/pull/100337#pullrequestreview-2500818944","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/100337","author_association":"MEMBER","_links":{"html":{"href":"https://github.com/godotengine/godot/pull/100337#pullrequestreview-2500818944"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/100337"}},"submitted_at":"2024-12-12T21:31:27Z","commit_id":null},{"id":2500825185,"node_id":"PRR_kwDOA