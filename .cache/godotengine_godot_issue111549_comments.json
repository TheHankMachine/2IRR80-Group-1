[{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3395141420","html_url":"https://github.com/godotengine/godot/pull/111549#issuecomment-3395141420","issue_url":"https://api.github.com/repos/godotengine/godot/issues/111549","id":3395141420,"node_id":"IC_kwDOAO6SJc7KXb8s","user":{"login":"JekSun97","id":130399274,"node_id":"U_kgDOB8W8Kg","avatar_url":"https://avatars.githubusercontent.com/u/130399274?v=4","gravatar_id":"","url":"https://api.github.com/users/JekSun97","html_url":"https://github.com/JekSun97","followers_url":"https://api.github.com/users/JekSun97/followers","following_url":"https://api.github.com/users/JekSun97/following{/other_user}","gists_url":"https://api.github.com/users/JekSun97/gists{/gist_id}","starred_url":"https://api.github.com/users/JekSun97/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/JekSun97/subscriptions","organizations_url":"https://api.github.com/users/JekSun97/orgs","repos_url":"https://api.github.com/users/JekSun97/repos","events_url":"https://api.github.com/users/JekSun97/events{/privacy}","received_events_url":"https://api.github.com/users/JekSun97/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-10-12T18:06:24Z","updated_at":"2025-10-12T18:07:55Z","body":"Won't this be cumbersome? For small screens, the node tree is always set to its minimum width; the more new icons the nodes have, the more information is hidden on some displays.\r\nI just don't think notes are important enough information to be placed in the node tree.","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3395141420/reactions","total_count":2,"+1":2,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3395196504","html_url":"https://github.com/godotengine/godot/pull/111549#issuecomment-3395196504","issue_url":"https://api.github.com/repos/godotengine/godot/issues/111549","id":3395196504,"node_id":"IC_kwDOAO6SJc7KXpZY","user":{"login":"blazejhanzel","id":29534847,"node_id":"MDQ6VXNlcjI5NTM0ODQ3","avatar_url":"https://avatars.githubusercontent.com/u/29534847?v=4","gravatar_id":"","url":"https://api.github.com/users/blazejhanzel","html_url":"https://github.com/blazejhanzel","followers_url":"https://api.github.com/users/blazejhanzel/followers","following_url":"https://api.github.com/users/blazejhanzel/following{/other_user}","gists_url":"https://api.github.com/users/blazejhanzel/gists{/gist_id}","starred_url":"https://api.github.com/users/blazejhanzel/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/blazejhanzel/subscriptions","organizations_url":"https://api.github.com/users/blazejhanzel/orgs","repos_url":"https://api.github.com/users/blazejhanzel/repos","events_url":"https://api.github.com/users/blazejhanzel/events{/privacy}","received_events_url":"https://api.github.com/users/blazejhanzel/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-10-12T18:22:33Z","updated_at":"2025-10-12T18:22:33Z","body":"Maybe notes are not that critical, but currently they appear at the very end of the inspector, and there’s no visual indication that a node even has one — so it’s easy to miss them.\r\nHow important they are really depends on the project, and on whether people use them for permanent documentation or just temporary comments.\r\n\r\nAt smaller editor widths, showing all icons (groups, visibility, signals, etc.) can already feel a bit crowded — four icons are often enough to fill the space.\r\n\r\n<img width=\"178\" height=\"213\" alt=\"Zrzut ekranu 2025-10-12 o 20 15 58\" src=\"https://github.com/user-attachments/assets/50115c97-72dc-4a27-92b9-528b5da40c33\" />\r\n\r\nSomeone in the linked proposal threads also suggested adding a way to filter or toggle which indicators are visible in the SceneTree. Maybe that could be a good future improvement.\r\n\r\nInitially I planned to make this as an editor addon, but it seems there’s no API to add custom icons to the SceneTree from GDScript.","author_association":"NONE","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3395196504/reactions","total_count":3,"+1":3,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3419868680","html_url":"https://github.com/godotengine/godot/pull/111549#issuecomment-3419868680","issue_url":"https://api.github.com/repos/godotengine/godot/issues/111549","id":3419868680,"node_id":"IC_kwDOAO6SJc7L1w4I","user":{"login":"blazejhanzel","id":29534847,"node_id":"MDQ6VXNlcjI5NTM0ODQ3","avatar_url":"https://avatars.githubusercontent.com/u/29534847?v=4","gravatar_id":"","url":"https://api.github.com/users/blazejhanzel","html_url":"https://github.com/blazejhanzel","followers_url":"https://api.github.com/users/blazejhanzel/followers","following_url":"https://api.github.com/users/blazejhanzel/following{/other_user}","gists_url":"https://api.github.com/users/blazejhanzel/gists{/gist_id}","starred_url":"https://api.github.com/users/blazejhanzel/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/blazejhanzel/subscriptions","organizations_url":"https://api.github.com/users/blazejhanzel/orgs","repos_url":"https://api.github.com/users/blazejhanzel/repos","events_url":"https://api.github.com/users/blazejhanzel/events{/privacy}","received_events_url":"https://api.github.com/users/blazejhanzel/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-10-19T18:37:41Z","updated_at":"2025-10-19T18:37:50Z","body":"I pushed two changes: I changed icon colors, because it doesn't work with light theme and fixed one problem with dictionary being null sometimes.","author_association":"NONE","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3419868680/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4367430967","html_url":"https://github.com/godotengine/godot/pull/111549#issuecomment-4367430967","issue_url":"https://api.github.com/repos/godotengine/godot/issues/111549","id":4367430967,"node_id":"IC_kwDOAO6SJc8AAAABBFG1Nw","user":{"login":"Errorbot1122","id":65428515,"node_id":"MDQ6VXNlcjY1NDI4NTE1","avatar_url":"https://avatars.githubusercontent.com/u/65428515?v=4","gravatar_id":"","url":"https://api.github.com/users/Errorbot1122","html_url":"https://github.com/Errorbot1122","followers_url":"https://api.github.com/users/Errorbot1122/followers","following_url":"https://api.github.com/users/Errorbot1122/following{/other_user}","gists_url":"https://api.github.com/users/Errorbot1122/gists{/gist_id}","starred_url":"https://api.github.com/users/Errorbot1122/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Errorbot1122/subscriptions","organizations_url":"https://api.github.com/users/Errorbot1122/orgs","repos_url":"https://api.github.com/users/Errorbot1122/repos","events_url":"https://api.github.com/users/Errorbot1122/events{/privacy}","received_events_url":"https://api.github.com/users/Errorbot1122/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-05-03T23:21:57Z","updated_at":"2026-05-03T23:21:57Z","body":"Are there any updates to this pr?","author_association":"NONE","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4367430967/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null}]