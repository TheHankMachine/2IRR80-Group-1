[{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2485418348","html_url":"https://github.com/godotengine/godot/issues/99422#issuecomment-2485418348","issue_url":"https://api.github.com/repos/godotengine/godot/issues/99422","id":2485418348,"node_id":"IC_kwDOAO6SJc6UJHls","user":{"login":"smix8","id":52464204,"node_id":"MDQ6VXNlcjUyNDY0MjA0","avatar_url":"https://avatars.githubusercontent.com/u/52464204?v=4","gravatar_id":"","url":"https://api.github.com/users/smix8","html_url":"https://github.com/smix8","followers_url":"https://api.github.com/users/smix8/followers","following_url":"https://api.github.com/users/smix8/following{/other_user}","gists_url":"https://api.github.com/users/smix8/gists{/gist_id}","starred_url":"https://api.github.com/users/smix8/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/smix8/subscriptions","organizations_url":"https://api.github.com/users/smix8/orgs","repos_url":"https://api.github.com/users/smix8/repos","events_url":"https://api.github.com/users/smix8/events{/privacy}","received_events_url":"https://api.github.com/users/smix8/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2024-11-19T11:12:06Z","updated_at":"2024-11-19T11:12:06Z","body":"The issue here is that you are creating a new Resource within the scope of a function so when the function is finished it deletes itself as a RefCounted object.\r\n\r\nYou need to store that Arraymesh somewhere. Functions like draw_mesh() will not store your resources and prevent them from b eing freed.","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2485418348/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2485458867","html_url":"https://github.com/godotengine/godot/issues/99422#issuecomment-2485458867","issue_url":"https://api.github.com/repos/godotengine/godot/issues/99422","id":2485458867,"node_id":"IC_kwDOAO6SJc6UJRez","user":{"login":"tntscreed","id":126970474,"node_id":"U_kgDOB5Fqag","avatar_url":"https://avatars.githubusercontent.com/u/126970474?v=4","gravatar_id":"","url":"https://api.github.com/users/tntscreed","html_url":"https://github.com/tntscreed","followers_url":"https://api.github.com/users/tntscreed/followers","following_url":"https://api.github.com/users/tntscreed/following{/other_user}","gists_url":"https://api.github.com/users/tntscreed/gists{/gist_id}","starred_url":"https://api.github.com/users/tntscreed/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/tntscreed/subscriptions","organizations_url":"https://api.github.com/users/tntscreed/orgs","repos_url":"https://api.github.com/users/tntscreed/repos","events_url":"https://api.github.com/users/tntscreed/events{/privacy}","received_events_url":"https://api.github.com/users/tntscreed/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2024-11-19T11:30:10Z","updated_at":"2024-11-19T11:30:10Z","body":"> The issue here is that you are creating a new Resource within the scope of a function so when the function is finished it deletes itself as a RefCounted object.\r\n> \r\n> You need to store that Arraymesh somewhere. Functions like draw_mesh() will not store your resources and prevent them from b eing freed.\r\n\r\nOh. I'm sorry, I posted my problem to three different platforms and no one wrote back, and I eventually got convinced that this was a bug. I'm very sorry. Issue solved. And thank you a lot. :)","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2485458867/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},