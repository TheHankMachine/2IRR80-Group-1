th.cpp\",\n         \"src/renderer/sw_engine/tvgSwMemPool.cpp\",\n+        \"src/renderer/sw_engine/tvgSwPostEffect.cpp\",\n         \"src/renderer/sw_engine/tvgSwRaster.cpp\",\n         \"src/renderer/sw_engine/tvgSwRenderer.cpp\",\n         \"src/renderer/sw_engine/tvgSwRle.cpp\",\n```","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2551850948/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2551865386","html_url":"https://github.com/godotengine/godot/issues/100566#issuecomment-2551865386","issue_url":"https://api.github.com/repos/godotengine/godot/issues/100566","id":2551865386,"node_id":"IC_kwDOAO6SJc6YGmAq","user":{"login":"AThousandShips","id":96648715,"node_id":"U_kgDOBcK-Cw","avatar_url":"https://avatars.githubusercontent.com/u/96648715?v=4","gravatar_id":"","url":"https://api.github.com/users/AThousandShips","html_url":"https://github.com/AThousandShips","followers_url":"https://api.github.com/users/AThousandShips/followers","following_url":"https://api.github.com/users/AThousandShips/following{/other_user}","gists_url":"https://api.github.com/users/AThousandShips/gists{/gist_id}","starred_url":"https://api.github.com/users/AThousandShips/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/AThousandShips/subscriptions","organizations_url":"https://api.github.com/users/AThousandShips/orgs","repos_url":"https://api.github.com/users/AThousandShips/repos","events_url":"https://api.github.com/users/AThousandShips/events{/privacy}","received_events_url":"https://api.github.com/users/AThousandShips/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2024-12-18T17:12:30Z","updated_at":"2024-12-18T17:12:30Z","body":"Will give a fix a test this week and if 