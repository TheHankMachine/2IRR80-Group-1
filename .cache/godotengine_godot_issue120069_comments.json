":"User","user_view_type":"public","site_admin":false},"created_at":"2026-06-08T14:15:03Z","updated_at":"2026-06-08T14:15:03Z","body":"Thanks! Congratulations on your first merged contribution! 🎉 ","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4649885592/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null}]