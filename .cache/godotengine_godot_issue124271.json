aaaaaa","default":false,"description":"","archived_at":null,"archived_by":null},{"id":279097326,"node_id":"MDU6TGFiZWwyNzkwOTczMjY=","url":"https://api.github.com/repos/godotengine/godot/labels/platform:linuxbsd","name":"platform:linuxbsd","color":"e4e4e4","default":false,"description":"","archived_at":null,"archived_by":null},{"id":279098219,"node_id":"MDU6TGFiZWwyNzkwOTgyMTk=","url":"https://api.github.com/repos/godotengine/godot/labels/topic:editor","name":"topic:editor","color":"ffee88","default":false,"description":"","archived_at":null,"archived_by":null},{"id":279098255,"node_id":"MDU6TGFiZWwyNzkwOTgyNTU=","url":"https://api.github.com/repos/godotengine/godot/labels/topic:platforms","name":"topic:platforms","color":"ffee88","default":false,"description":"","archived_at":null,"archived_by":null},{"id":1332303119,"node_id":"MDU6TGFiZWwxMzMyMzAzMTE5","url":"https://api.github.com/repos/godotengine/godot/labels/regression","name":"regression","color":"ff63ac","default":false,"description":"","archived_at":null,"archived_by":null}],"state":"closed","locked":false,"assignees":[],"milestone":null,"comments":2,"created_at":"2026-10-08T00:05:28Z","updated_at":"2026-10-08T09:10:36Z","closed_at":"2026-10-08T09:09:47Z","assignee":null,"author_association":"NONE","issue_field_values":[],"type":null,"active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"### Tested versions\n\n- Reproducible in: 4.8 dev7 (maybe earlier, haven't checked)\n- Not reproducible in: 4.7.2\n\n\n\n### System information\n\nGodot v4.8.dev7 - CachyOS Linux #1 SMP PREEMPT_DYNAMIC Sat, 26 Sep 2026 19:43:45 +0000 on Wayland - Wayland display driver, Multi-window, 1 monitor (2560x1440 @ 120.00 Hz) - Vulkan (Forward+) - dedicated AMD Radeon RX 6700 (RADV NAVI22) - AMD Ryzen 7 5700G with Radeon Graphics (16 threads) - 31.20 GiB memory - PulseAudio (44100 Hz, Stereo/mono)\n\n### Issue description\n\nI would be surprised if this was not already reported, but I couldn't find an open issue talking about it, so just in case I'm making one myself.\nMy game typically has the mouse mode as MOUSE_MODE_CAPTURED. In 4.7.2, and in 4.8 *on exported builds*, this works fine. However in the editor, it seems to instead be treating it as if it was MOUSE_MODE_HIDDEN instead, hiding the mouse but allowing it to exit the window. \n\nThis happens with the windows with the toolbar, both the one embedded in the editor and the floating toolbar window, but does NOT happen to the native window without the toolbar, so this appears to very specifically be an editor issue. I suspect it may have something to do with Wayland behavior as that tends to be the culprit for problems like this, but I would not know how to test this.\n\n### Steps to reproduce\n\n1. Open project in editor\n2. Playtest the game, within an embedded window\n3. Do something that makes the mouse mode change to MOUSE_MODE_CAPTURED if it isn't already that\n4. Weep in horror as it behaves in an inconvenient fashion\n\n### Minimal reproduction project (MRP)\n\n[MouseCursorBugReportProject.zip](https://github.com/user-attachments/files/33181902/MouseCursorBugReportProject.zip)","closed_by":{"login":"ScottCarammell","id":66961806,"node_id":"MDQ6VXNlcjY2OTYxODA2","avatar_url":"https://avatars.githubusercontent.com/u/66961806?v=4","gravatar_id":"","url":"https://api.github.com/users/ScottCarammell","html_url":"https://github.com/ScottCarammell","followers_url":"https://api.github.com/users/ScottCarammell/followers","following_url":"https://api.github.com/users/ScottCarammell/following{/other_user}","gists_url":"https://api.github.com/users/ScottCarammell/gists{/gist_id}","starred_url":"https://api.github.com/users/ScottCarammell/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/ScottCarammell/subscriptions","organizations_url":"https://api.github.com/users/ScottCara