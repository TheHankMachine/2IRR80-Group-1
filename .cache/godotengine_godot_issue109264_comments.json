0248056","html_url":"https://github.com/godotengine/godot/issues/109264#issuecomment-5660248056","issue_url":"https://api.github.com/repos/godotengine/godot/issues/109264","id":5660248056,"node_id":"IC_kwDOAO6SJc8AAAABUWCH-A","user":{"login":"SerLinkzero","id":5407442,"node_id":"MDQ6VXNlcjU0MDc0NDI=","avatar_url":"https://avatars.githubusercontent.com/u/5407442?v=4","gravatar_id":"","url":"https://api.github.com/users/SerLinkzero","html_url":"https://github.com/SerLinkzero","followers_url":"https://api.github.com/users/SerLinkzero/followers","following_url":"https://api.github.com/users/SerLinkzero/following{/other_user}","gists_url":"https://api.github.com/users/SerLinkzero/gists{/gist_id}","starred_url":"https://api.github.com/users/SerLinkzero/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/SerLinkzero/subscriptions","organizations_url":"https://api.github.com/users/SerLinkzero/orgs","repos_url":"https://api.github.com/users/SerLinkzero/repos","events_url":"https://api.github.com/users/SerLinkzero/events{/privacy}","received_events_url":"https://api.github.com/users/SerLinkzero/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-09-14T07:02:28Z","updated_at":"2026-09-14T07:04:18Z","body":"This issue also occurs with BetterTouchTool (and interestingly BTT actually notifies me it detects there is a significant delay with Godot, and if I want to disable window snapping for it). Godot version is 4.7.2.\n\nI wonder if it is something more fundamental rather than an app-specific issue.","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5660248056/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5668011216","html_url":"https://github.com/godotengine/godot/issues/109264#issuecomment-5668011216","issue_url":"https://api.github.com/repos/godotengine/godot/issues/109264","id":5668011216,"node_id":"IC_kwDOAO6SJc8AAAABUdb80A","user":{"login":"bruvzg","id":7645683,"node_id":"MDQ6VXNlcjc2NDU2ODM=","avatar_url":"https://avatars.githubusercontent.com/u/7645683?v=4","gravatar_id":"","url":"https://api.github.com/users/bruvzg","html_url":"https://github.com/bruvzg","followers_url":"https://api.github.com/users/bruvzg/followers","following_url":"https://api.github.com/users/bruvzg/following{/other_user}","gists_url":"https://api.github.com/users/bruvzg/gists{/gist_id}","starred_url":"https://api.github.com/users/bruvzg/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/bruvzg/subscriptions","organizations_url":"https://api.github.com/users/bruvzg/orgs","repos_url":"https://api.github.com/users/bruvzg/repos","events_url":"https://api.github.com/users/bruvzg/events{/privacy}","received_events_url":"https://api.github.com/users/bruvzg/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-09-14T17:29:47Z","updated_at":"2026-09-14T17:29:47Z","body":"Currently we use two frame delay methods, one is used when screen reader (or Magnet) is detected (and can wake for events), and another one that is used on all other cases (and can't wake). Since there are more apps abusing accessibility API in the same way, we probably should check if there are any negative effects from using first method, and either fully switch to it or at least add an option to do so manually.","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5668011216/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null}]