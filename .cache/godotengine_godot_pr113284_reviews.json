s://api.github.com/users/fire/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"Reviewed the math on the twist.\r\n\r\nRegarding the before and after of IK vs BoneTwistDisperser3D, a documentation solution was devised - see relevant comments above.\r\n\r\n@lyuma is also reviewing.\r\n\r\nLooks good to me.","state":"APPROVED","html_url":"https://github.com/godotengine/godot/pull/113284#pullrequestreview-3527411985","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/113284","author_association":"MEMBER","_links":{"html":{"href":"https://github.com/godotengine/godot/pull/113284#pullrequestreview-3527411985"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/113284"}},"submitted_at":"2025-12-01T22:57:53Z","commit_id":"8fafdec0736d217d95b95ca56172513ea6408e12"},{"id":3529037495,"node_id":"PRR_kwDOAO6SJc7SWNa3","user":{"login":"lyuma","id":39946030,"node_id":"MDQ6VXNlcjM5OTQ2MDMw","avatar_url":"https://avatars.githubusercontent.com/u/39946030?v=4","gravatar_id":"","url":"https://api.github.com/users/lyuma","html_url":"https://github.com/lyuma","followers_url":"https://api.github.com/users/lyuma/followers","following_url":"https://api.github.com/users/lyuma/following{/other_user}","gists_url":"https://api.github.com/users/lyuma/gists{/gist_id}","starred_url":"https://api.github.com/users/lyuma/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/lyuma/subscriptions","organizations_url":"https://api.github.com/users/lyuma/orgs","repos_url":"https://api.github.com/users/lyuma/repos","events_url":"https://api.github.com/users/lyuma/events{/privacy}","received_events_url":"https://api.github.com/users/lyuma/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"It looks correct.\r\n\r\nThere are some parts of the design that are unintuitive: notably, BoneTwistDisperser3D is difficult to use on many skeletons unless `extend_end_bone` is true, since otherwise you have to target a child of the target bone.\r\n\r\nAlso I found that it does not function as I would expect when targeting root_bone = Hips (due to Hips having a large origin relative to 0,0,0), but I'm not sure it's wrong, but rather this is mostly a documentation issue.\r\n\r\nExample showing how it can be used for twisting the spine of a character when solving IK for a character's spine.\r\n<img width=\"1920\" height=\"1080\" alt=\"godot_twist_disperser_renik2\" src=\"https://github.com/user-attachments/assets/0297ed06-b834-4de2-b7f5-30ecceae40fb\" />\r\n","state":"APPROVED","html_url":"https://github.com/godotengine/godot/pull/113284#pullrequestreview-3529037495","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/113284","author_association":"CONTRIBUTOR","_links":{"html":{"href":"https://github.com/godotengine/godot/pull/113284#pullrequestreview-3529037495"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/113284"}},"submitted_at":"2025-12-02T09:13:49Z","commit_id":null},{"id":3520610198,"node_id":"PRR_kwDOAO6SJc7R2D-W","user":{"login":"AThousandShips","id":96648715,"node_id":"U_kgDOBcK-Cw","avatar_url":"https://avatars.githubusercontent.com/u/96648715?u=af70f5d107e9c1447f296643d5a566dab53d25e8&v=4","gravatar_id":"","url":"https://api.github.com/users/AThousandShips","html_url":"https://github.com/AThousandShips","followers_url":"https://api.github.com/users/AThousandShips/followers","following_url":"https://api.github.com/users/AThousandShips/following{/other_user}","gists_url":"https://api.github.com/users/AThousandShips/gists{/gist_id}","starred_url":"https://api.github.com/users/AThousandShips/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/AThousandShips/subscriptions","organizations_url":"https://api.github.com/users/AThousandShips/orgs","repos_url":"https://api.github.com/users/AThousandShips/repos","events_url":"https://api.github.com/users/AThousandShips/events