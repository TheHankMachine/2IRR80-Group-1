[{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3646523710","html_url":"https://github.com/godotengine/godot/pull/113931#issuecomment-3646523710","issue_url":"https://api.github.com/repos/godotengine/godot/issues/113931","id":3646523710,"node_id":"IC_kwDOAO6SJc7ZWYk-","user":{"login":"AThousandShips","id":96648715,"node_id":"U_kgDOBcK-Cw","avatar_url":"https://avatars.githubusercontent.com/u/96648715?v=4","gravatar_id":"","url":"https://api.github.com/users/AThousandShips","html_url":"https://github.com/AThousandShips","followers_url":"https://api.github.com/users/AThousandShips/followers","following_url":"https://api.github.com/users/AThousandShips/following{/other_user}","gists_url":"https://api.github.com/users/AThousandShips/gists{/gist_id}","starred_url":"https://api.github.com/users/AThousandShips/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/AThousandShips/subscriptions","organizations_url":"https://api.github.com/users/AThousandShips/orgs","repos_url":"https://api.github.com/users/AThousandShips/repos","events_url":"https://api.github.com/users/AThousandShips/events{/privacy}","received_events_url":"https://api.github.com/users/AThousandShips/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-12-12T13:38:27Z","updated_at":"2025-12-12T13:38:27Z","body":"Can you provide some results showing this improvement in performance? See [this page](https://contributing.godotengine.org/en/latest/engine/guidelines/optimization.html)\r\n\r\nJust looking at this I don't expect this to provide much of a measurable improvement if any, especially as this is not a very heavily used method in general, and the rest of the behavior in the method are far more expensive","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3646523710/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3646573936","html_url":"https://github.com/godotengine/godot/pull/113931#issuecomment-3646573936","issue_url":"https://api.github.com/repos/godotengine/godot/issues/113931","id":3646573936,"node_id":"IC_kwDOAO6SJc7ZWk1w","user":{"login":"fereidani","id":3057665,"node_id":"MDQ6VXNlcjMwNTc2NjU=","avatar_url":"https://avatars.githubusercontent.com/u/3057665?v=4","gravatar_id":"","url":"https://api.github.com/users/fereidani","html_url":"https://github.com/fereidani","followers_url":"https://api.github.com/users/fereidani/followers","following_url":"https://api.github.com/users/fereidani/following{/other_user}","gists_url":"https://api.github.com/users/fereidani/gists{/gist_id}","starred_url":"https://api.github.com/users/fereidani/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/fereidani/subscriptions","organizations_url":"https://api.github.com/users/fereidani/orgs","repos_url":"https://api.github.com/users/fereidani/repos","events_url":"https://api.github.com/users/fereidani/events{/privacy}","received_events_url":"https://api.github.com/users/fereidani/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-12-12T13:53:01Z","updated_at":"2025-12-12T13:53:01Z","body":"Hey,\r\nFrom my knowledge of c++ this happens to the memory allocator:\r\nStart: capacity = 0\r\n1st push_back => resize = 1\r\n2nd push_back => resize = 2\r\n3rd push_back => resize = 4\r\n5th push_back => resize = 8\r\n9th push_back => resize = 16\r\nDepending on the underlying system allocator, sticking strictly to this pattern can lead to unnecessary performance overhead (reallocations, fragmentation) without the benefits of tighter memory usage in all scenarios.\r\nIn my free time, I do optimization and security code reviews for open-source projects. I'd like to know if contributions of this nature (performance-focused reviews or suggestions) align well with Godot's current development process and priorities. That would help me decide whether it's worth continuing to invest time in reviewing and contributing to Godot.\r\nThanks!","author_association":"NONE","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3646573936/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3646581583","html_url":"https://github.com/godotengine/godot/pull/113931#issuecomment-3646581583","issue_url":"https://api.github.com/repos/godotengine/godot/issues/113931","id":3646581583,"node_id":"IC_kwDOAO6SJc7ZWmtP","user":{"login":"AThousandShips","id":96648715,"node_id":"U_kgDOBcK-Cw","avatar_url":"https://avatars.githubusercontent.com/u/96648715?v=4","gravatar_id":"","url":"https://api.github.com/users/AThousandShips","html_url":"https://github.com/AThousandShips","followers_url":"https://api.github.com/users/AThousandShips/followers","following_url":"https://api.github.com/users/AThousandShips/following{/other_user}","gists_url":"https://api.github.com/users/AThousandShips/gists{/gist_id}","starred_url":"https://api.github.com/users/AThousandShips/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/AThousandShips/subscriptions","organizations_url":"https://api.github.com/users/AThousandShips/orgs","repos_url":"https://api.github.com/users/AThousandShips/repos","events_url":"https://api.github.com/users/AThousandShips/events{/privacy}","received_events_url":"https://api.github.com/users/AThousandShips/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-12-12T13:55:22Z","updated_at":"2025-12-12T13:55:22Z","body":"I understand the theoretical reason behind it, but please see the link for our philosophy with performance focused contributions","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3646581583/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3646672729","html_url":"https://github.com/godotengine/godot/pull/113931#issuecomment-3646672729","issue_url":"https://api.github.com/repos/godotengine/godot/issues/113931","id":3646672729,"node_id":"IC_kwDOAO6SJc7ZW89Z","user":{"login":"fereidani","id":3057665,"node_id":"MDQ6VXNlcjMwNTc2NjU=","avatar_url":"https://avatars.githubusercontent.com/u/3057665?v=4","gravatar_id":"","url":"https://api.github.com/users/fereidani","html_url":"https://github.com/fereidani","followers_url":"https://api.github.com/users/fereidani/followers","following_url":"https://api.github.com/users/fereidani/following{/other_user}","gists_url":"https://api.github.com/users/fereidani/gists{/gist_id}","starred_url":"https://api.github.com/users/fereidani/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/fereidani/subscriptions","organizations_url":"https://api.github.com/users/fereidani/orgs","repos_url":"https://api.github.com/users/fereidani/repos","events_url":"https://api.github.com/users/fereidani/events{/privacy}","received_events_url":"https://api.github.com/users/fereidani/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-12-12T14:21:23Z","updated_at":"2025-12-12T14:21:23Z","body":"Sure and I completely respect you sticking to your guidelines, I do the same in my repositories.\r\nPlease close the PR if it doesn't fit Godot project.\r\nThank you for your time reviewing this PR.","author_association":"NONE","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3646672729/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3647756092","html_url":"https://github.com/godotengine/godot/pull/113931#issuecomment-3647756092","issue_url":"https://api.github.com/repos/godotengine/godot/issues/113931","id":3647756092,"node_id":"IC_kwDOAO6SJc7ZbFc8","user":{"login":"clayjohn","id":16521339,"node_id":"MDQ6VXNlcjE2NTIxMzM5","avatar_url":"https://avatars.githubusercontent.com/u/16521339?v=4","gravatar_id":"","url":"https://api.github.com/users/clayjohn","html_url":"https://github.com/clayjohn","followers_url":"https://api.github.com/users/clayjohn/followers","following_url":"https://api.github.com/users/clayjohn/following{/other_user}","gists_url":"https://api.github.com/users/clayjohn/gists{/gist_id}","starred_url":"https://api.github.com/users/clayjohn/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/clayjohn/subscriptions","organizations_url":"https://api.github.com/users/clayjohn/orgs","repos_url":"https://api.github.com/users/clayjohn/repos","events_url":"https://api.github.com/users/clayjohn/events{/privacy}","received_events_url":"https://api.github.com/users/clayjohn/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-12-12T18:58:30Z","updated_at":"2025-12-12T18:58:30Z","body":"> Sure and I completely respect you sticking to your guidelines, I do the same in my repositories. Please close the PR if it doesn't fit Godot project. Thank you for your time reviewing this PR.\r\n\r\nThe PR fits with the direction we are going in the project. We just need to see the results of your performance testing before we merge it. \r\n\r\nIf you are implying that you are _refusing_ to test performance, then indeed, we would just close the PR","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3647756092/reactions","total_count":4,"+1":4,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3649663191","html_url":"https://github.com/godotengine/godot/pull/113931#issuecomment-3649663191","issue_url":"https://api.github.com/repos/godotengine/godot/issues/113931","id":3649663191,"node_id":"IC_kwDOAO6SJc7ZiXDX","user":{"login":"fereidani","id":3057665,"node_id":"MDQ6VXNlcjMwNTc2NjU=","avatar_url":"https://avatars.githubusercontent.com/u/3057665?v=4","gravatar_id":"","url":"https://api.github.com/users/fereidani","html_url":"https://github.com/fereidani","followers_url":"https://api.github.com/users/fereidani/followers","following_url":"https://api.github.com/users/fereidani/following{/other_user}","gists_url":"https://api.github.com/users/fereidani/gists{/gist_id}","starred_url":"https://api.github.com/users/fereidani/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/fereidani/subscriptions","organizations_url":"https://api.github.com/users/fereidani/orgs","repos_url":"https://api.github.com/users/fereidani/repos","events_url":"https://api.github.com/users/fereidani/events{/privacy}","received_events_url":"https://api.github.com/users/fereidani/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-12-13T17:51:08Z","updated_at":"2025-12-13T17:51:08Z","body":"Hey, Don't get me wrong if it was some complicated algorithm I would have provided detailed explanation and benchmarks about why it is faster, But this PR is just a single line change based on correctness.\r\n\r\nLet me explain why I think it's a good change and why if I provide you some benchmark that would be **deceiving**:\r\n\r\nThis change would have different effects in different compilers and even different optimization flags and even different versions of the same compiler. And also libstd implementation change things alot too.\r\nA smart compiler might inline this function and even turns the result array to stack allocated array, other one might not understand and rely on system/program allocator for resizing too many times.\r\nsomeone might change some other part in Godot and that inlining become obsolete in those range of compilers in the future, and they have to use heap allocator again.\r\nIf a compiler is smart enough to optimize the loop to find vector size, it will be smart enough to ignore that we are reserving same amount of memory, If not this change improves the performance for that less capable compiler.\r\n\r\nI simply don't want to provide you with that \"**It's faster on my system bro**\" logic.\r\n\r\nSo in the end you should see if you like this change or not,\r\nI prefer explicit design as compiler can optimize it better in different cases, but I completely understand if your philosophy is different for optimization. It doesn't mean that either of us are wrong, It means that we approach the problem with different insights.","author_association":"NONE","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3649663191/reactions","total_count":2,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":2,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3649683781","html_url":"https://github.com/godotengine/godot/pull/113931#issuecomment-3649683781","issue_url":"https://api.github.com/repos/godotengine/godot/issues/113931","id":3649683781,"node_id":"IC_kwDOAO6SJc7ZicFF","user":{"login":"arkology","id":43543909,"node_id":"MDQ6VXNlcjQzNTQzOTA5","avatar_url":"https://avatars.githubusercontent.com/u/43543909?v=4","gravatar_id":"","url":"https://api.github.com/users/arkology","html_url":"https://github.com/arkology","followers_url":"https://api.github.com/users/arkology/followers","following_url":"https://api.github.com/users/arkology/following{/other_user}","gists_url":"https://api.github.com/users/arkology/gists{/gist_id}","starred_url":"https://api.github.com/users/arkology/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/arkology/subscriptions","organizations_url":"https://api.github.com/users/arkology/orgs","repos_url":"https://api.github.com/users/arkology/repos","events_url":"https://api.github.com/users/arkology/events{/privacy}","received_events_url":"https://api.github.com/users/arkology/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-12-13T18:18:50Z","updated_at":"2025-12-13T18:24:37Z","body":"Let me copy-paste the official guidelines for you, since you've managed to write a long explanation but haven't bothered to read the guidelines. With respect to you.\r\n\r\n\r\n> When assessing optimization opportunities, we need to take into account:\r\n> \r\n> Benefits[](https://contributing.godotengine.org/en/latest/engine/guidelines/optimization.html#benefits)\r\n> Is the optimization worth doing in this case?\r\n> \r\n> How often is this code called?\r\n> \r\n> How much of a bottleneck is it to overall performance?\r\n> \r\n> Does profiling show it to be a bottleneck?\r\n\r\nI had at least 3 branches with optimization stuff, but every time I got to creating a PR, I stopped at the fact that the optimized code is not a bottleneck of called too rarely to cause any problems. And that's okay.","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3649683781/reactions","total_count":2,"+1":2,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3649713496","html_url":"https://github.com/godotengine/godot/pull/113931#issuecomment-3649713496","issue_url":"https://api.github.com/repos/godotengine/godot/issues/113931","id":3649713496,"node_id":"IC_kwDOAO6SJc7ZijVY","user":{"login":"Ivorforce","id":2308167,"node_id":"MDQ6VXNlcjIzMDgxNjc=","avatar_url":"https://avatars.githubusercontent.com/u/2308167?v=4","gravatar_id":"","url":"https://api.github.com/users/Ivorforce","html_url":"https://github.com/Ivorforce","followers_url":"https://api.github.com/users/Ivorforce/followers","following_url":"https://api.github.com/users/Ivorforce/following{/other_user}","gists_url":"https://api.github.com/users/Ivorforce/gists{/gist_id}","starred_url":"https://api.github.com/users/Ivorforce/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Ivorforce/subscriptions","organizations_url":"https://api.github.com/users/Ivorforce/orgs","repos_url":"https://api.github.com/users/Ivorforce/repos","events_url":"https://api.github.com/users/Ivorforce/events{/privacy}","received_events_url":"https://api.github.com/users/Ivorforce/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-12-13T19:00:19Z","updated_at":"2025-12-13T19:03:54Z","body":"What arkology said is a good description. I'll try to rephrase it anyway:\nIt's not (necessarily) that we don't believe the new code should be faster. It's that we want to optimize spots that will have an actual measurable impact. There's millions of other changes we could make that would make the engine a teeny tiny bit faster, but it just isn't impactful in most cases (and thus not worth the risk and effort of the change itself). That's why we expect to see a proof of improvement for optimization PRs.\n","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3649713496/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3649727846","html_url":"https://github.com/godotengine/godot/pull/113931#issuecomment-3649727846","issue_url":"https://api.github.com/repos/godotengine/godot/issues/113931","id":3649727846,"node_id":"IC_kwDOAO6SJc7Zim1m","user":{"login":"fereidani","id":3057665,"node_id":"MDQ6VXNlcjMwNTc2NjU=","avatar_url":"https://avatars.githubusercontent.com/u/3057665?v=4","gravatar_id":"","url":"https://api.github.com/users/fereidani","html_url":"https://github.com/fereidani","followers_url":"https://api.github.com/users/fereidani/followers","following_url":"https://api.github.com/users/fereidani/following{/other_user}","gists_url":"https://api.github.com/users/fereidani/gists{/gist_id}","starred_url":"https://api.github.com/users/fereidani/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/fereidani/subscriptions","organizations_url":"https://api.github.com/users/fereidani/orgs","repos_url":"https://api.github.com/users/fereidani/repos","events_url":"https://api.github.com/users/fereidani/events{/privacy}","received_events_url":"https://api.github.com/users/fereidani/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-12-13T19:17:55Z","updated_at":"2025-12-13T19:17:55Z","body":"[arkology](https://github.com/arkology) I read Godot guideline after first response from AThousandShips, that's why I respectfully asked to close the PR if it doesn't fit your project.\r\nYour behavior and tone is childish, disrespectful and unprofessional.\r\nI will not respond to any messages here anymore, feel free to close the PR or not.","author_association":"NONE","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3649727846/reactions","total_count":1,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":1,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3649731212","html_url":"https://github.com/godotengine/godot/pull/113931#issuecomment-3649731212","issue_url":"https://api.github.com/repos/godotengine/godot/issues/113931","id":3649731212,"node_id":"IC_kwDOAO6SJc7ZinqM","user":{"login":"AThousandShips","id":96648715,"node_id":"U_kgDOBcK-Cw","avatar_url":"https://avatars.githubusercontent.com/u/96648715?v=4","gravatar_id":"","url":"https://api.github.com/users/AThousandShips","html_url":"https://github.com/AThousandShips","followers_url":"https://api.github.com/users/AThousandShips/followers","following_url":"https://api.github.com/users/AThousandShips/following{/other_user}","gists_url":"https://api.github.com/users/AThousandShips/gists{/gist_id}","starred_url":"https://api.github.com/users/AThousandShips/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/AThousandShips/subscriptions","organizations_url":"https://api.github.com/users/AThousandShips/orgs","repos_url":"https://api.github.com/users/AThousandShips/repos","events_url":"https://api.github.com/users/AThousandShips/events{/privacy}","received_events_url":"https://api.github.com/users/AThousandShips/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-12-13T19:22:11Z","updated_at":"2025-12-13T19:22:11Z","body":"Closing as per above, thank you for your contribution nonetheless ","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3649731212/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null}]