[{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3053600523","html_url":"https://github.com/godotengine/godot/issues/108438#issuecomment-3053600523","issue_url":"https://api.github.com/repos/godotengine/godot/issues/108438","id":3053600523,"node_id":"IC_kwDOAO6SJc62Aj8L","user":{"login":"syntaxerror247","id":176927541,"node_id":"U_kgDOCouzNQ","avatar_url":"https://avatars.githubusercontent.com/u/176927541?v=4","gravatar_id":"","url":"https://api.github.com/users/syntaxerror247","html_url":"https://github.com/syntaxerror247","followers_url":"https://api.github.com/users/syntaxerror247/followers","following_url":"https://api.github.com/users/syntaxerror247/following{/other_user}","gists_url":"https://api.github.com/users/syntaxerror247/gists{/gist_id}","starred_url":"https://api.github.com/users/syntaxerror247/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/syntaxerror247/subscriptions","organizations_url":"https://api.github.com/users/syntaxerror247/orgs","repos_url":"https://api.github.com/users/syntaxerror247/repos","events_url":"https://api.github.com/users/syntaxerror247/events{/privacy}","received_events_url":"https://api.github.com/users/syntaxerror247/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-07-09T18:25:58Z","updated_at":"2025-07-09T18:25:58Z","body":"> Is there a different way to override the splash screen colour that I am missing?\n\nYou can change it by setting `adaptive_background` icon, but in my testing, it doesn’t work reliably across all devices.\n\nI had planned to add export settings to customize the splash screen, but the feature freeze hit before I could open a PR. That's now in 4.6 roadmap.","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3053600523/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_gi