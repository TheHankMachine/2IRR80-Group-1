we see with the bugs this fixes).\r\n\r\nI think it's easier to reason about if the code is like this:\r\n```cpp\r\nif (some cond) {\r\n  // ensure this always returns true or false\r\n}\r\n\r\nif (some mutually exclusive cond) {\r\n  // ensure this always returns true or false\r\n}\r\n\r\nreturn true; // Nothing was matched.\r\n```","created_at":"2025-04-25T09:08:41Z","updated_at":"2025-04-25T09:10:05Z","html_url":"https://github.com/godotengine/godot/pull/105537#discussion_r2059861427","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/105537","_links":{"self":{"href":"https://api.github.com/repos/godotengine/godot/pulls/comments/2059861427"},"html":{"href":"https://github.com/godotengine/godot/pull/105537#discussion_r2059861427"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/105537"}},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/2059861427/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":665,"start_side":"RIGHT","line":null,"original_line":669,"side":"RIGHT","in_reply_to_id":2059839714,"author_association":"MEMBER","original_position":8,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/2059993517","pull_request_review_id":2793701089,"id":2059993517,"node_id":"PRRC_kwDOAO6SJc56yQGt","diff_hunk":"@@ -67,7 +67,9 @@ bool SkeletonModification2DPhysicalBones::_get(const StringName &p_path, Variant\n #ifdef TOOLS_ENABLED\n \tif (Engine::get_singleton()->is_editor_hint()) {\n \t\tif (path.begins_with(\"fetch_bones\")) {\n-\t\t\treturn true; // Do nothing!\n+\t\t\t// Do nothing!\n+\t\t\tr_ret = false;\n+\t\t\treturn true;","path":"scene/resources/2d/skeleton/skeleton_modification_2d_physicalbones.cpp","commit_id":"143db328e7a70ebe94e7072694f080f9745fcc83","original_commit_id":"58cc58a7f8dd1865062d96df95a4a012a7b0ddc4","user":{"login"