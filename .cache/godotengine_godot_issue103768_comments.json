48715,"node_id":"U_kgDOBcK-Cw","avatar_url":"https://avatars.githubusercontent.com/u/96648715?v=4","gravatar_id":"","url":"https://api.github.com/users/AThousandShips","html_url":"https://github.com/AThousandShips","followers_url":"https://api.github.com/users/AThousandShips/followers","following_url":"https://api.github.com/users/AThousandShips/following{/other_user}","gists_url":"https://api.github.com/users/AThousandShips/gists{/gist_id}","starred_url":"https://api.github.com/users/AThousandShips/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/AThousandShips/subscriptions","organizations_url":"https://api.github.com/users/AThousandShips/orgs","repos_url":"https://api.github.com/users/AThousandShips/repos","events_url":"https://api.github.com/users/AThousandShips/events{/privacy}","received_events_url":"https://api.github.com/users/AThousandShips/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-06-28T09:34:30Z","updated_at":"2025-06-28T09:34:30Z","body":"That's my personal opinion and was about *hard* access specifiers, not soft access specifiers like this","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3015143739/reactions","total_count":3,"+1":3,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3076073777","html_url":"https://github.com/godotengine/godot/pull/103768#issuecomment-3076073777","issue_url":"https://api.github.com/repos/godotengine/godot/issues/103768","id":3076073777,"node_id":"IC_kwDOAO6SJc63WSkx","user":{"login":"Lazy-Rabbit-2001","id":22123964,"node_id":"MDQ6VXNlcjIyMTIzOTY0","avatar_url":"https://avatars.githubusercontent.com/u/22123964?v=4","gravatar_id":"","url":"https://api.github.com/users/Lazy-Rabbit-2001","html_url":"https://github.com/Lazy-Rabbit-2001","followers_url":"https://api.github.com/users/Lazy-Rabbit-2001/followers","following_url":"https://api.github.com/users/Lazy-Rabbit-2001/following{/other_user}","gists_url":"https://api.github.com/users/Lazy-Rabbit-2001/gists{/gist_id}","starred_url":"https://api.github.com/users/Lazy-Rabbit-2001/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Lazy-Rabbit-2001/subscriptions","organizations_url":"https://api.github.com/users/Lazy-Rabbit-2001/orgs","repos_url":"https://api.github.com/users/Lazy-Rabbit-2001/repos","events_url":"https://api.github.com/users/Lazy-Rabbit-2001/events{/privacy}","received_events_url":"https://api.github.com/users/Lazy-Rabbit-2001/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-07-15T23:39:15Z","updated_at":"2025-07-15T23:39:15Z","body":"Ok, since vnen agreed the implementation of this pr, I'm gonna squash it tonight to make this ready to merge. Maybe it will be in 4.5, or in 4.6. But no matter in which version, this pr can be finally done.","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3076073777/reactions","total_count":4,"+1":2,"-1":0,"laugh":0,"hooray":2,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3077988276","html_url":"https://github.com/godotengine/godot/pull/103768#issuecomment-3077988276","issue_url":"https://api.github.com/repos/godotengine/godot/issues/103768","id":3077988276,"node_id":"IC_kwDOAO6SJc63dl-0","user":{"login":"produno","id":8760003,"node_id":"MDQ6VXNlcjg3NjAwMDM=","avatar_url":"https://avatars.githubusercontent.com/u/8760003?v=4","gravatar_id":"","url":"https://api.github.com/users/produno","html_url":"https://github.com/produno","followers_url":"https://api.github.com/users/produno/followers","following_url":"https://api.github.com/users/produno/following{/other_user}","gists_url":"https://api.github.com/users/produno/gists{/gist_id}","starred_url":"https://api.github.com/users/produno/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/produno/subscriptions","organizations_url":"https://api.github.com/users/produno/orgs","repos_url":"https://api.github.com/users/produno/repos","events_url":"https://api.github.com/users/produno/events{/privacy}","received_events_url":"https://api.github.com/users/produno/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-07-16T10:42:15Z","updated_at":"2025-07-16T10:42:15Z","body":"Does this mean we will no longer get proper access modifiers?\r\n\r\nUsing an underscore as a private variable means every time I want to change a var from private to public, or vice versa, I now break save game compatibility with my next update. The options now are to either wrap each saveable variable in a getter/setter (Which are extremely slow in GDScript) or check each variable when I save or load and adjust the saved/loaded name.\r\n\r\nThese are both bad for a language specific to an environment where save game compatibility is extremely important as are save/load times. I have seen the arguments before 'But Python uses it', sure, but Python is not a language created specifically for game development.\r\n\r\nUsing an access modifier causes me or anyone else none of these problems.","author_association":"NONE","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3077988276/reactions","total_count":7,"+1":7,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3136798334","html_url":"https://github.com/godotengine/godot/pull/103768#issuecomment-3136798334","issue_url":"https://api.github.com/repos/godotengine/godot/issues/103768","id":3136798334,"node_id":"IC_kwDOAO6SJc66975-","user":{"login":"Lazy-Rabbit-2001","id":22123964,"node_id":"MDQ6VXNlcjIyMTIzOTY0","avatar_url":"https://avatars.githubusercontent.com/u/22123964?v=4","gravatar_id":"","url":"https://api.github.com/users/Lazy-Rabbit-2001","html_url":"https://github.com/Lazy-Rabbit-2001","followers_url":"https://api.github.com/users/Lazy-Rabbit-2001/followers","following_url":"https://api.github.com/users/Lazy-Rabbit-2001/following{/other_user}","gists_url":"https://api.github.com/users/Lazy-Rabbit-2001/gists{/gist_id}","starred_url":"https://api.github.com/users/Lazy-Rabbit-2001/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Lazy-Rabbit-2001/subscriptions","organizations_url":"https://api.github.com/users/Lazy-Rabbit-2001/orgs","repos_url":"https://api.github.com/users/Lazy-Rabbit-2001/repos","events_url":"https://api.github.com/users/Lazy-Rabbit-2001/events{/privacy}","received_events_url":"https://api.github.com/users/Lazy-Rabbit-2001/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-07-30T15:16:08Z","updated_at":"2025-07-30T15:16:44Z","body":"> Does this mean we will no longer get proper access modifiers?\r\n\r\nWe don't introduce the feature in a forced way (whether by adding `private` or `@private`) because of runtime check which will reduce extra performance during your gameplay. Maybe in GDScript 3.x this could get solved, hopefully.\r\n\r\n> Using an underscore as a private variable means every time I want to change a var from private to public, or vice versa, I now break save game compatibility with my next update. The options now are to either wrap each saveable variable in a getter/setter (Which are extremely slow in GDScript) or check each variable when I save or load and adjust the saved/loaded name.\r\n\r\nYeah, I understand your point, but as I said this **does not break compatibility as possible** and **you can configure it and turn it off**. So you can keep the current codestyle you've been using.\r\n\r\n> I have seen the arguments before 'But Python uses it', sure, but Python is not a language created specifically for game development.\r\n\r\nHow does Python has anything to do with this topic? I don't understand. :/\r\n","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3136798334/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3136820177","html_url":"https://github.com/godotengine/godot/pull/103768#issuecomment-3136820177","issue_url":"https://api.github.com/repos/godotengine/godot/issues/103768","id":3136820177,"node_id":"IC_kwDOAO6SJc66-BPR","user":{"login":"AThousandShips","id":96648715,"node_id":"U_kgDOBcK-Cw","avatar_url":"https://avatars.githubusercontent.com/u/96648715?v=4","gravatar_id":"","url":"https://api.github.com/users/AThousandShips","html_url":"https://github.com/AThousandShips","followers_url":"https://api.github.com/users/AThousandShips/followers","following_url":"https://api.github.com/users/AThousandShips/following{/other_user}","gists_url":"https://api.github.com/users/AThousandShips/gists{/gist_id}","starred_url":"https://api.github.com/users/AThousandShips/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/AThousandShips/subscriptions","organizations_url":"https://api.github.com/users/AThousandShips/orgs","repos_url":"https://api.github.com/users/AThousandShips/repos","events_url":"https://api.github.com/users/AThousandShips/events{/privacy}","received_events_url":"https://api.github.com/users/AThousandShips/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-07-30T15:22:32Z","updated_at":"2025-07-30T15:22:32Z","body":"> How does Python has anything to do with this topic?\r\n\r\nThey mentioned it because it's a common argument in favor of this, they're not making the argument, they're referencing it","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3136820177/reactions","total_count":2,"+1":2,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3414435228","html_url":"https://github.com/godotengine/godot/pull/103768#issuecomment-3414435228","issue_url":"https://api.github.com/repos/godotengine/godot/issues/103768","id":3414435228,"node_id":"IC_kwDOAO6SJc7LhCWc","user":{"login":"pleucell","id":97208800,"node_id":"U_kgDOBctJ4A","avatar_url":"https://avatars.githubusercontent.com/u/97208800?v=4","gravatar_id":"","url":"https://api.github.com/users/pleucell","html_url":"https://github.com/pleucell","followers_url":"https://api.github.com/users/pleucell/followers","following_url":"https://api.github.com/users/pleucell/following{/other_user}","gists_url":"https://api.github.com/users/pleucell/gists{/gist_id}","starred_url":"https://api.github.com/users/pleucell/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/pleucell/subscriptions","organizations_url":"https://api.github.com/users/pleucell/orgs","repos_url":"https://api.github.com/users/pleucell/repos","events_url":"https://api.github.com/users/pleucell/events{/privacy}","received_events_url":"https://api.github.com/users/pleucell/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-10-17T08:34:10Z","updated_at":"2025-10-17T08:34:10Z","body":"Are there any plans to merge this in 4.6?","author_association":"NONE","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3414435228/reactions","total_count":4,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":4},"performed_via_github_app":null,"minimized":null},{"url":"https:/