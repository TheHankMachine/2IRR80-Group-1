sted that PR but the issue still occurs (example with 4× MSAA):\n\n<img width=\"1032\" height=\"590\" alt=\"Image\" src=\"https://github.com/user-attachments/assets/f183f90f-613a-45ed-b1de-583920a36027\" />","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3276493570/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null}]