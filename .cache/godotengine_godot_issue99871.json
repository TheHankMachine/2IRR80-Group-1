_values":[],"type":null,"active_lock_reason":null,"draft":false,"pull_request":{"url":"https://api.github.com/repos/godotengine/godot/pulls/99871","html_url":"https://github.com/godotengine/godot/pull/99871","diff_url":"https://github.com/godotengine/godot/pull/99871.diff","patch_url":"https://github.com/godotengine/godot/pull/99871.patch","merged_at":"2024-12-09T20:36:39Z"},"body":"On Windows, a fresh checkout of master with a brand new project was having the CPU sleep for a large amount of time.\r\n\r\nRoot cause is this math that subtracts target_ticks from the delay resolution, but does not check if target_ticks is less than the delay resolution. The resulting math of: `(target_ticks - delay_resolution) - current_ticks` will then be < 0 and wrap around to max uint64_t. This causes the delay_usec to sleep for around 4 million milliseconds.","closed_by":{"login":"Repiteo","id":17489292,"node_id":"MDQ6VXNlcjE3NDg5Mjky","avatar_url":"https://avatars.githubusercontent.com/u/17489292?v=4","gravatar_id":"","url":"https://api.github.com/users/Repiteo","html_url":"https://github.com/Repiteo","followers_url":"https://api.github.com/users/Repiteo/followers","following_url":"https://api.github.com/users/Repiteo/following{/other_user}","gists_url":"https://api.github.com/users/Repiteo/gists{/gist_id}","starred_url":"https://api.github.com/users/Repiteo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Repiteo/subscriptions","organizations_url":"https://api.github.com/users/Repiteo/orgs","repos_url":"https://api.github.com/users/Repiteo/repos","events_url":"https://api.github.com/users/Repiteo/events{/privacy}","received_events_url":"https://api.github.com/users/Repiteo/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/99871/reactions","total_count":2,"+1":2,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://