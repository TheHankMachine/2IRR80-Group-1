[{"id":3163887247,"node_id":"PRR_kwDOAO6SJc68lRaP","user":{"login":"Ivorforce","id":2308167,"node_id":"MDQ6VXNlcjIzMDgxNjc=","avatar_url":"https://avatars.githubusercontent.com/u/2308167?u=f7f8e0273f784f5ec6f6b7fe4a88d449896eb48a&v=4","gravatar_id":"","url":"https://api.github.com/users/Ivorforce","html_url":"https://github.com/Ivorforce","followers_url":"https://api.github.com/users/Ivorforce/followers","following_url":"https://api.github.com/users/Ivorforce/following{/other_user}","gists_url":"https://api.github.com/users/Ivorforce/gists{/gist_id}","starred_url":"https://api.github.com/users/Ivorforce/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Ivorforce/subscriptions","organizations_url":"https://api.github.com/users/Ivorforce/orgs","repos_url":"https://api.github.com/users/Ivorforce/repos","events_url":"https://api.github.com/users/Ivorforce/events{/privacy}","received_events_url":"https://api.github.com/users/Ivorforce/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"This makes sense to me. `orphan_node_count` is almost guaranteed to be mangled by multiple threads if we do not use atomics for it. We should either remove this variable entirely or wrap it with atomics. If we _are_ moving to atomics (probably the better move), it would be better to touch this variable as little as possible, leading to `total_node_count` instead of `orphan_node_count`. \r\nSo yes, as long as we allow `Node` instantiation on separate threads, I think this change is necessary.","state":"COMMENTED","html_url":"https://github.com/godotengine/godot/pull/109900#pullrequestreview-3163887247","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/109900","author_association":"MEMBER","_links":{"html":{"href":"https://github.com/godotengine/godot/pull/109900#pullrequestreview-3163887247"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/109900"}},"submitted_at":"2025-08-28T08:49:2