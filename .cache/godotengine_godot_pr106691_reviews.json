[{"id":2858994653,"node_id":"PRR_kwDOAO6SJc6qaMvd","user":{"login":"Ivorforce","id":2308167,"node_id":"MDQ6VXNlcjIzMDgxNjc=","avatar_url":"https://avatars.githubusercontent.com/u/2308167?u=f7f8e0273f784f5ec6f6b7fe4a88d449896eb48a&v=4","gravatar_id":"","url":"https://api.github.com/users/Ivorforce","html_url":"https://github.com/Ivorforce","followers_url":"https://api.github.com/users/Ivorforce/followers","following_url":"https://api.github.com/users/Ivorforce/following{/other_user}","gists_url":"https://api.github.com/users/Ivorforce/gists{/gist_id}","starred_url":"https://api.github.com/users/Ivorforce/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Ivorforce/subscriptions","organizations_url":"https://api.github.com/users/Ivorforce/orgs","repos_url":"https://api.github.com/users/Ivorforce/repos","events_url":"https://api.github.com/users/Ivorforce/events{/privacy}","received_events_url":"https://api.github.com/users/Ivorforce/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"Looks correct. I haven't tested the code but I see the same mismatch.\r\n\r\nLooking into it, the bug can only manifest when `DEBUG_ENABLED` is not defined, because otherwise, `pre_pad` in `alloc_static` will always be true (and it is assumed to be false in `memdelete`, but true in `memdelete_arr`). Pair that with this code only running for when call stack tracking is enabled, and it's probably why nobody else ran into this problem yet.\r\n\r\nNote: I think this is a regression from https://github.com/godotengine/godot/pull/76582","state":"APPROVED","html_url":"https://github.com/godotengine/godot/pull/106691#pullrequestreview-2858994653","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/106691","author_association":"MEMBER","_links":{"html":{"href":"https://github.com/godotengine/godot/pull/106691#pullrequestreview-2858994653"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/106691"}},"submitted_at":"2025-05-21T20:13:25Z","commit_id":"67d97dab5bfc78b6eb640cda43d1bb2b9f6c2ef7"}]