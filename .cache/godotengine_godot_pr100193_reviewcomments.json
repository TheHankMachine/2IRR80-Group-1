6Z","updated_at":"2024-12-16T21:40:47Z","html_url":"https://github.com/godotengine/godot/pull/100193#discussion_r1887618432","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/100193","_links":{"self":{"href":"https://api.github.com/repos/godotengine/godot/pulls/comments/1887618432"},"html":{"href":"https://github.com/godotengine/godot/pull/100193#discussion_r1887618432"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/100193"}},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/1887618432/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":214,"start_side":"RIGHT","line":null,"original_line":218,"side":"RIGHT","author_association":"CONTRIBUTOR","original_position":7,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/1888036770","pull_request_review_id":2508069922,"id":1888036770,"node_id":"PRRC_kwDOAO6SJc5wiSei","diff_hunk":"@@ -210,6 +210,10 @@ void GDExtensionManager::initialize_extensions(GDExtension::InitializationLevel\n \tERR_FAIL_COND(int32_t(p_level) - 1 != level);\n \tfor (KeyValue<String, Ref<GDExtension>> &E : gdextension_map) {\n \t\tE.value->initialize_library(p_level);\n+\n+\t\tfor (const KeyValue<String, String> &kv : E.value->class_icon_paths) {\n+\t\t\tgdextension_class_icon_paths[kv.key] = kv.value;\n+\t\t}","path":"core/extension/gdextension_manager.cpp","commit_id":"69f1cc10b60a5aabef65bfdda26c4bac3f7b0dd9","original_commit_id":"b0c4e740ecbdb722a3e2ac313e8018f1ae161d31","user":{"login":"raulsntos","id":3903059,"node_id":"MDQ6VXNlcjM5MDMwNTk=","avatar_url":"https://avatars.githubusercontent.com/u/3903059?v=4","gravatar_id":"","url":"https://api.github.com/users/raulsntos","html_url":"https://github.com/raulsntos","followers_url":"https://api.github.com/users/raulsntos/followers","following_url":"https://api.github.com/u