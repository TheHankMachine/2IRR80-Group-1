engine/godot/issues/comments/2576348816/reactions","total_count":1,"+1":0,"-1":0,"laugh":0,"hooray":1,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2577371593","html_url":"https://github.com/godotengine/godot/pull/101066#issuecomment-2577371593","issue_url":"https://api.github.com/repos/godotengine/godot/issues/101066","id":2577371593,"node_id":"IC_kwDOAO6SJc6Zn5HJ","user":{"login":"YuriSizov","id":11782833,"node_id":"MDQ6VXNlcjExNzgyODMz","avatar_url":"https://avatars.githubusercontent.com/u/11782833?v=4","gravatar_id":"","url":"https://api.github.com/users/YuriSizov","html_url":"https://github.com/YuriSizov","followers_url":"https://api.github.com/users/YuriSizov/followers","following_url":"https://api.github.com/users/YuriSizov/following{/other_user}","gists_url":"https://api.github.com/users/YuriSizov/gists{/gist_id}","starred_url":"https://api.github.com/users/YuriSizov/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/YuriSizov/subscriptions","organizations_url":"https://api.github.com/users/YuriSizov/orgs","repos_url":"https://api.github.com/users/YuriSizov/repos","events_url":"https://api.github.com/users/YuriSizov/events{/privacy}","received_events_url":"https://api.github.com/users/YuriSizov/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-01-08T10:50:33Z","updated_at":"2025-01-08T10:51:37Z","body":"This is completely wrong, btw, because `has_theme_item` should not behave differently from any of specialized `has_*` theme methods. The problem is that behavior for font and font size properties differs from everything else, breaking expectations. The solution cannot be to differ it further, breaking even more expectations.","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2577371593/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2577674244","html_url":"https://github.com/godotengine/godot/pull/101066#issuecomment-2577674244","issue_url":"https://api.github.com/repos/godotengine/godot/issues/101066","id":2577674244,"node_id":"IC_kwDOAO6SJc6ZpDAE","user":{"login":"dagarsar","id":32908423,"node_id":"MDQ6VXNlcjMyOTA4NDIz","avatar_url":"https://avatars.githubusercontent.com/u/32908423?v=4","gravatar_id":"","url":"https://api.github.com/users/dagarsar","html_url":"https://github.com/dagarsar","followers_url":"https://api.github.com/users/dagarsar/followers","following_url":"https://api.github.com/users/dagarsar/following{/other_user}","gists_url":"https://api.github.com/users/dagarsar/gists{/gist_id}","starred_url":"https://api.github.com/users/dagarsar/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/dagarsar/subscriptions","organizations_url":"https://api.github.com/users/dagarsar/orgs","repos_url":"https://api.github.com/users/dagarsar/repos","events_url":"https://api.github.com/users/dagarsar/events{/privacy}","received_events_url":"https://api.github.com/users/dagarsar/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-01-08T13:28:35Z","updated_at":"2025-01-08T13:28:35Z","body":"Should the change be in the `ThemeOwner`'s `get_theme_item_in_types` instead? I don't see a way of minimizing side effects other than moving the check for variation or base type up the call stack, but I think that's the furthest it could go.","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2577674244/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2577961460","html_url":"https://github.com/godotengine/godot/pull/101066#issuecomment-2577961460","issue_url":"https://api.github.com/repos/godotengine/godot/issues/101066","id":2577961460,"node_id":"IC_kwDOAO6SJc6ZqJH0","user":{"login":"YuriSizov","id":11782833,"node_id":"MDQ6VXNlcjExNzgyODMz","avatar_url":"https://avatars.githubusercontent.com/u/11782833?v=4","gravatar_id":"","url":"https://api.github.com/users/YuriSizov","html_url":"https://github.com/YuriSizov","followers_url":"https://api.github.com/users/YuriSizov/followers","following_url":"https://api.github.com/users/YuriSizov/following{/other_user}","gists_url":"https://api.github.com/users/YuriSizov/gists{/gist_id}","starred_url":"https://api.github.com/users/YuriSizov/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/YuriSizov/subscriptions","organizations_url":"https://api.github.com/users/YuriSizov/orgs","repos_url":"https://api.github.com/users/YuriSizov/repos","events_url":"https://api.github.com/users/YuriSizov/events{/privacy}","received_events_url":"https://api.github.com/users/YuriSizov/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-01-08T15:29:38Z","updated_at":"2025-01-08T15:29:38Z","body":"@DanielGSilva I think it can be solved in `ThemeOwner` by first evaluating the class chain without the default value, and then evaluating default values from all affecting themes. So first you'd check every affecting theme and global themes for the exact definition, like any other theme property. Then, before falling back, do the same for the default font/font size value. And only then do the fallback.\r\n\r\nThis would maintain most expectations while fixing the current issue. This would also be the least compatibility breaking option, as it would only affect property resolution and only where it's not doing what is normally desired. Also, obviously, should happen with both has-calls and get-calls, if this is applicable.","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2577961460/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3576193686","html_url":"https://github.com/godotengine/godot/pull/101066#issuecomment-3576193686","issue_url":"https://api.github.com/repos/godotengine/godot/issues/101066","id":3576193686,"node_id":"IC_kwDOAO6SJc7VKGKW","user":{"login":"YuriSizov","id":11782833,"node_id":"MDQ6VXNlcjExNzgyODMz","avatar_url":"https://avatars.githubusercontent.com/u/11782833?v=4","gravatar_id":"","url":"https://api.github.com/users/YuriSizov","html_url":"https://github.com/YuriSizov","followers_url":"https://api.github.com/users/YuriSizov/followers","following_url":"https://api.github.com/users/YuriSizov/following{/other_user}","gists_url":"https://api.github.com/users/YuriSizov/gists{/gist_id}","starred_url":"https://api.github.com/users/YuriSizov/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/YuriSizov/subscriptions","organizations_url":"https://api.github.com/users/YuriSizov/orgs","repos_url":"https://api.github.com/users/YuriSizov/repos","events_url":"https://api.github.com/users/YuriSizov/events{/privacy}","received_events_url":"https://api.github.com/users/YuriSizov/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-11-25T15:18:32Z","updated_at":"2025-11-25T15:25:10Z","body":"So I'm not really sure why this hasn't been at least reverted for 4.4, but I believe the problem can still be properly fixed with the solution suggested above, with a minimal impact on user projects.\r\n\r\nJust to underline that this is not an appropriate fix: the problem remains for built-in types which inherit each other. There aren't that many examples of that, but there are two: buttons and dialog windows. I think buttons are set up in such a way that it hides the problem: all built-in button types have explicit style definitions in the default theme, even if they duplicate what is set on the parent type.\r\n\r\nDialogs, however, have gaps. `ConfirmationDialog` does not have its styling explicitly set in the default theme, instead fully relying on inheritance from `AcceptDialog`. And that exposes the same issue as type variations do — font and font size definitions are not propagated as expected when there is a theme default.\r\n\r\n<img width=\"1328\" height=\"760\" alt=\"image\" src=\"https://github.com/user-attachments/assets/9b82a6b1-a36e-4946-9dc9-82ee53bf5754\" />\r\n\r\nIn this example, only `AcceptDialog` has theme definitions configured. In the top row, the applied theme has no default font size. In the bottom row, the theme has the default font size configured. Only color and font size are configured for `AcceptDialog`, and you can clearly see how propagation differs between these two theme item types.\r\n\r\nThe last window is an `AcceptDialog` with a theme type variation applied, and you can see that there is a difference once again. Unlike the built-in type, `ConfirmationDialog`, a user-defined type variation for `AcceptDialog` receives the inherited definition over the default font size. Feel free to check the repro project to confirm:\r\n\r\n[theme-font-inheritance.zip](https://github.com/user-attachments/files/23750043/theme-font-inheritance.zip)\r\n\r\nThis is exactly why I felt compelled to post before and let the engine team know that this is not an appropriate solution. Defaults should be applied consistently and only after the initial resolution, including inheritance, fails. I'm not comfortable contributing code to this project myself. I hoped that my concerns would at least be enough to justify a reversal before 4.4 was to be released, so the introduction of inconsistency is avoided. Now, I can only hope for a proper fix.","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3576193686/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null}]