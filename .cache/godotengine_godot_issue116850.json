ed_at":"2026-06-19T16:54:35Z"},"comments":6,"created_at":"2026-02-27T16:13:04Z","updated_at":"2026-03-18T18:19:28Z","closed_at":"2026-03-16T16:42:18Z","assignee":null,"author_association":"CONTRIBUTOR","issue_field_values":[],"type":null,"active_lock_reason":null,"draft":false,"pull_request":{"url":"https://api.github.com/repos/godotengine/godot/pulls/116850","html_url":"https://github.com/godotengine/godot/pull/116850","diff_url":"https://github.com/godotengine/godot/pull/116850.diff","patch_url":"https://github.com/godotengine/godot/pull/116850.patch","merged_at":"2026-03-16T16:42:18Z"},"body":"This fixes an off-by-one clipping issue introduced in commit 1794098.\r\nUsing ceil() on the right margin reduces the visible text area by up to 1 px,\r\ncausing the last character of long lines to be clipped.\r\n\r\nThis restores the previous behavior by using floor() for SIDE_RIGHT while\r\nkeeping ceil() for SIDE_LEFT.\r\n\r\n- Fixes #110577.\r\n\r\nSee also:\r\n-  #114221\r\n- https://github.com/godotengine/godot/pull/110791\r\n\r\nThis pull request resolves the issue without affecting other behavior: it only adjusts the one extra pixel needed at the end of `TextEdit` on custom scales so the last character is visible again. Probably using floats is a proper solution (#114221), but if that is not planned in the near future, this is a simple, low-risk improvement to the currently severely impacted usability.","closed_by":{"login":"Repiteo","id":17489292,"node_id":"MDQ6VXNlcjE3NDg5Mjky","avatar_url":"https://avatars.githubusercontent.com/u/17489292?v=4","gravatar_id":"","url":"https://api.github.com/users/Repiteo","html_url":"https://github.com/Repiteo","followers_url":"https://api.github.com/users/Repiteo/followers","following_url":"https://api.github.com/users/Repiteo/following{/other_user}","gists_url":"https://api.github.com/users/Repiteo/gists{/gist_id}","starred_url":"https://api.github.com/users/Repiteo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Repiteo/subscriptions","organizations_url":"https://api.github.com/users/Repiteo/orgs","repos_url":"https://api.github.com/users/Repiteo/repos","events_url":"https://api.github.com/users/Repiteo/events{/privacy}","received_events_url":"https://api.github.com/users/Repiteo/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/116850/reactions","total_count":8,"+1":0,"-1":0,"laugh":0,"hooray":8,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/godotengine/godot/issues/116850/timeline","performed_via_github_app":null,"state_reason":null}