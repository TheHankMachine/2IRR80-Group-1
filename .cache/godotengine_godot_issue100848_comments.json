[{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2566635132","html_url":"https://github.com/godotengine/godot/pull/100848#issuecomment-2566635132","issue_url":"https://api.github.com/repos/godotengine/godot/issues/100848","id":2566635132,"node_id":"IC_kwDOAO6SJc6Y-758","user":{"login":"fire","id":32321,"node_id":"MDQ6VXNlcjMyMzIx","avatar_url":"https://avatars.githubusercontent.com/u/32321?v=4","gravatar_id":"","url":"https://api.github.com/users/fire","html_url":"https://github.com/fire","followers_url":"https://api.github.com/users/fire/followers","following_url":"https://api.github.com/users/fire/following{/other_user}","gists_url":"https://api.github.com/users/fire/gists{/gist_id}","starred_url":"https://api.github.com/users/fire/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/fire/subscriptions","organizations_url":"https://api.github.com/users/fire/orgs","repos_url":"https://api.github.com/users/fire/repos","events_url":"https://api.github.com/users/fire/events{/privacy}","received_events_url":"https://api.github.com/users/fire/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2024-12-31T18:10:31Z","updated_at":"2024-12-31T18:10:31Z","body":"How would you recommend testing this?","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2566635132/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2566727162","html_url":"https://github.com/godotengine/godot/pull/100848#issuecomment-2566727162","issue_url":"https://api.github.com/repos/godotengine/godot/issues/100848","id":2566727162,"node_id":"IC_kwDOAO6SJc6Y_SX6","user":{"login":"BlueCube3310","id":53150244,"node_id":"MDQ6VXNlcjUzMTUwMjQ0","avatar_url":"https://avatars.githubusercontent.com/u/53150244?v=4","gravatar_id":"","url":"https://api.github.com/users/BlueCube3310","html_url":"https://github.com/BlueCube3310","followers_url":"https://api.github.com/users/BlueCube3310/followers","following_url":"https://api.github.com/users/BlueCube3310/following{/other_user}","gists_url":"https://api.github.com/users/BlueCube3310/gists{/gist_id}","starred_url":"https://api.github.com/users/BlueCube3310/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/BlueCube3310/subscriptions","organizations_url":"https://api.github.com/users/BlueCube3310/orgs","repos_url":"https://api.github.com/users/BlueCube3310/repos","events_url":"https://api.github.com/users/BlueCube3310/events{/privacy}","received_events_url":"https://api.github.com/users/BlueCube3310/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2024-12-31T21:55:50Z","updated_at":"2024-12-31T21:55:50Z","body":"> How would you recommend testing this?\r\n\r\nOn Desktop: This project [astc-decompress.zip](https://github.com/user-attachments/files/18283773/astc-decompress.zip) has some .hdr files imported as images. The main scene's root node has an editor script with 3 buttons: ![scr](https://github.com/user-attachments/assets/01d60f4d-c049-49fb-9bbb-5e17ec068d32)\r\n\r\nThe first one will load the source images and compress them into ASTC HDR, then save them to the project's location as .res files. The second will apply the compressed textures to some sprite3D nodes. Since most desktop devices don't support ASTC HDR, the engine will decompress them internally and use that data instead. (This can be verified by using RenderDoc and checking the image's format). \r\n\r\nBefore, HDR images would be decompressed into RGBA8: \r\n![prev](https://github.com/user-attachments/assets/decbf977-acc7-4b6d-8810-3b255d43adb8)\r\n\r\nWith this PR, they are decompressed into RGBAH:\r\n![now](https://github.com/user-attachments/assets/08a4fafb-b255-48b6-b708-4099d34c5ee3)\r\n\r\nFor reference, this is how they should look like:\r\n![ref](https://github.com/user-attachments/assets/28a5444f-f25c-4185-a02e-d52d41317706)\r\n\r\n","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2566727162/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2568544834","html_url":"https://github.com/godotengine/godot/pull/100848#issuecomment-2568544834","issue_url":"https://api.github.com/repos/godotengine/godot/issues/100848","id":2568544834,"node_id":"IC_kwDOAO6SJc6ZGOJC","user":{"login":"akien-mga","id":4701338,"node_id":"MDQ6VXNlcjQ3MDEzMzg=","avatar_url":"https://avatars.githubusercontent.com/u/4701338?v=4","gravatar_id":"","url":"https://api.github.com/users/akien-mga","html_url":"https://github.com/akien-mga","followers_url":"https://api.github.com/users/akien-mga/followers","following_url":"https://api.github.com/users/akien-mga/following{/other_user}","gists_url":"https://api.github.com/users/akien-mga/gists{/gist_id}","starred_url":"https://api.github.com/users/akien-mga/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/akien-mga/subscriptions","organizations_url":"https://api.github.com/users/akien-mga/orgs","repos_url":"https://api.github.com/users/akien-mga/repos","events_url":"https://api.github.com/users/akien-mga/events{/privacy}","received_events_url":"https://api.github.com/users/akien-mga/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-01-03T00:12:33Z","updated_at":"2025-01-03T00:12:33Z","body":"Thanks!","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2568544834/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0