[{"id":3342497712,"node_id":"PRR_kwDOAO6SJc7HOnew","user":{"login":"Ivorforce","id":2308167,"node_id":"MDQ6VXNlcjIzMDgxNjc=","avatar_url":"https://avatars.githubusercontent.com/u/2308167?u=f7f8e0273f784f5ec6f6b7fe4a88d449896eb48a&v=4","gravatar_id":"","url":"https://api.github.com/users/Ivorforce","html_url":"https://github.com/Ivorforce","followers_url":"https://api.github.com/users/Ivorforce/followers","following_url":"https://api.github.com/users/Ivorforce/following{/other_user}","gists_url":"https://api.github.com/users/Ivorforce/gists{/gist_id}","starred_url":"https://api.github.com/users/Ivorforce/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Ivorforce/subscriptions","organizations_url":"https://api.github.com/users/Ivorforce/orgs","repos_url":"https://api.github.com/users/Ivorforce/repos","events_url":"https://api.github.com/users/Ivorforce/events{/privacy}","received_events_url":"https://api.github.com/users/Ivorforce/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"Makes sense in principle.\r\n\r\nI haven't seen anyone mention it, but I think we have a policy to end include chains in `typedefs.h`. Or at least this seems to hold true throughout the codebase right now. So I think what would be better is an include to `typedefs.h`. `<type_traits>` is included transitively through other includes (and explicitly if #111557 is merged).\r\n","state":"COMMENTED","html_url":"https://github.com/godotengine/godot/pull/111697#pullrequestreview-3342497712","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/111697","author_association":"MEMBER","_links":{"html":{"href":"https://github.com/godotengine/godot/pull/111697#pullrequestreview-3342497712"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/111697"}},"submitted_at":"2025-10-15T21:59:44Z","commit_id":null}]