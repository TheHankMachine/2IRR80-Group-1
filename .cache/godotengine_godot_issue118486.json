lor":"ffee88","default":false,"description":"","archived_at":null,"archived_by":null},{"id":1327318271,"node_id":"MDU6TGFiZWwxMzI3MzE4Mjcx","url":"https://api.github.com/repos/godotengine/godot/labels/crash","name":"crash","color":"885544","default":false,"description":"","archived_at":null,"archived_by":null}],"state":"closed","locked":false,"assignees":[],"milestone":{"url":"https://api.github.com/repos/godotengine/godot/milestones/25","html_url":"https://github.com/godotengine/godot/milestone/25","labels_url":"https://api.github.com/repos/godotengine/godot/milestones/25/labels","id":15520464,"node_id":"MI_kwDOAO6SJc4A7NLQ","number":25,"title":"4.8","description":"","creator":{"login":"Repiteo","id":17489292,"node_id":"MDQ6VXNlcjE3NDg5Mjky","avatar_url":"https://avatars.githubusercontent.com/u/17489292?v=4","gravatar_id":"","url":"https://api.github.com/users/Repiteo","html_url":"https://github.com/Repiteo","followers_url":"https://api.github.com/users/Repiteo/followers","following_url":"https://api.github.com/users/Repiteo/following{/other_user}","gists_url":"https://api.github.com/users/Repiteo/gists{/gist_id}","starred_url":"https://api.github.com/users/Repiteo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Repiteo/subscriptions","organizations_url":"https://api.github.com/users/Repiteo/orgs","repos_url":"https://api.github.com/users/Repiteo/repos","events_url":"https://api.github.com/users/Repiteo/events{/privacy}","received_events_url":"https://api.github.com/users/Repiteo/received_events","type":"User","user_view_type":"public","site_admin":false},"open_issues":341,"closed_issues":2335,"state":"open","created_at":"2026-04-13T15:59:35Z","updated_at":"2026-10-22T03:07:42Z","due_on":null,"closed_at":null},"comments":9,"created_at":"2026-04-12T13:02:54Z","updated_at":"2026-07-25T14:41:08Z","closed_at":"2026-07-25T14:38:02Z","assignee":null,"author_association":"MEMBER","issue_field_values":[],"type":null,"active_lock_reason":null,"draft":false,"pull_request":{"url":"https://api.github.com/repos/godotengine/godot/pulls/118486","html_url":"https://github.com/godotengine/godot/pull/118486","diff_url":"https://github.com/godotengine/godot/pull/118486.diff","patch_url":"https://github.com/godotengine/godot/pull/118486.patch","merged_at":"2026-07-25T14:38:02Z"},"body":"Fixes https://github.com/godotengine/godot/issues/115055 (I'm not able to actually reproduce the infinite instance loop, but this should address the root cause.)\r\nFixes https://github.com/godotengine/godot-vscode-plugin/issues/973\r\n\r\n`OccluderInstance3D::set_occluder` contains code which re-edits the last object from the editor selection history. This is meant to force refresh relevant editor plugins when the property is changed in the inspector. It must not be run for all instances in an editor process though, because it can cause unwanted side effects if the top of the editor history is another object.\r\n\r\nFor example the GDScript language server might instantiate scenes. When such a scene contained an OccluderInstance3D it would call the problematic code and if the current top of the editor selection history is a script this would open the script again in the external editor.\r\n\r\nThis PR limits this code to only run for scenes that are currently edited to prevent side effects for the language server.\r\n\r\nIn general this still feels hacky to me and should probably be a `PropertyUsageFlag` instead to ensure that it only applies to inspector edits, but I dunno. Would be out of scope for this PR anyway.","closed_by":{"login":"Repiteo","id":17489292,"node_id":"MDQ6VXNlcjE3NDg5Mjky","avatar_url":"https://avatars.githubusercontent.com/u/17489292?v=4","gravatar_id":"","url":"https://api.github.com/users/Repiteo","html_url":"https://github.com/Repiteo","followers_url":"https://api.github.com/users/Repiteo/followers","following_url":"https://api.github.com/users/Repiteo/following{/other_user}","gists_url":"https://api.github.com/users/Repiteo/gists{/gist_id}","starred_url":"https://api.github.com/users/Repiteo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Repiteo/subscriptions","organizations_url":"https://api.github.com/users/Repiteo/orgs","repos_url":"https://api.github.com/users/Repiteo/repos","events_url":"https://api.github.com/users/Repiteo/events{/privacy}","received_events_url":"https://api.github.com/users/Repiteo/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/118486/reactions","total_count":5,"+1":5,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/godotengine/godot/issues/118486/timeline","performed_via_github_app":null,"state_reason":null}