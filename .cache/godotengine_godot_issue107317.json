 white cube even though there is no physics involved\n\n### Minimal reproduction project (MRP)\n\n[InterpolationBug.zip](https://github.com/user-attachments/files/20653890/InterpolationBug.zip)","closed_by":{"login":"Alexofp","id":14040378,"node_id":"MDQ6VXNlcjE0MDQwMzc4","avatar_url":"https://avatars.githubusercontent.com/u/14040378?v=4","gravatar_id":"","url":"https://api.github.com/users/Alexofp","html_url":"https://github.com/Alexofp","followers_url":"https://api.github.com/users/Alexofp/followers","following_url":"https://api.github.com/users/Alexofp/following{/other_user}","gists_url":"https://api.github.com/users/Alexofp/gists{/gist_id}","starred_url":"https://api.github.com/users/Alexofp/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Alexofp/subscriptions","organizations_url":"https://api.github.com/users/Alexofp/orgs","repos_url":"https://api.github.com/users/Alexofp/repos","events_url":"https://api.github.com/users/Alexofp/events{/privacy}","received_events_url":"https://api.github.com/users/Alexofp/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/107317/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/godotengine/godot/issues/107317/timeline","performed_via_github_app":null,"state_reason":"duplicate","pinned_comment":null}