[{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4326212193","html_url":"https://github.com/godotengine/godot/issues/118938#issuecomment-4326212193","issue_url":"https://api.github.com/repos/godotengine/godot/issues/118938","id":4326212193,"node_id":"IC_kwDOAO6SJc8AAAABAdzCYQ","user":{"login":"AThousandShips","id":96648715,"node_id":"U_kgDOBcK-Cw","avatar_url":"https://avatars.githubusercontent.com/u/96648715?v=4","gravatar_id":"","url":"https://api.github.com/users/AThousandShips","html_url":"https://github.com/AThousandShips","followers_url":"https://api.github.com/users/AThousandShips/followers","following_url":"https://api.github.com/users/AThousandShips/following{/other_user}","gists_url":"https://api.github.com/users/AThousandShips/gists{/gist_id}","starred_url":"https://api.github.com/users/AThousandShips/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/AThousandShips/subscriptions","organizations_url":"https://api.github.com/users/AThousandShips/orgs","repos_url":"https://api.github.com/users/AThousandShips/repos","events_url":"https://api.github.com/users/AThousandShips/events{/privacy}","received_events_url":"https://api.github.com/users/AThousandShips/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-04-27T10:31:01Z","updated_at":"2026-04-27T10:31:01Z","body":"Sounds like:\n* https://github.com/godotengine/godot/issues/118765","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4326212193/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4366872159","html_url":"https://github.com/godotengine/godot/issues/118938#issuecomment-4366872159","issue_url":"https://api.github.com/repos/godotengine/godot/issues/118938","id":4366872159,"node_id":"IC_kwDOAO6SJc8AAAABBEkuXw","user":{"login":"deralmas","id":31065808,"node_id":"MDQ6VXNlcjMxMDY1ODA4","avatar_url":"https://avatars.githubusercontent.com/u/31065808?v=4","gravatar_id":"","url":"https://api.github.com/users/deralmas","html_url":"https://github.com/deralmas","followers_url":"https://api.github.com/users/deralmas/followers","following_url":"https://api.github.com/users/deralmas/following{/other_user}","gists_url":"https://api.github.com/users/deralmas/gists{/gist_id}","starred_url":"https://api.github.com/users/deralmas/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/deralmas/subscriptions","organizations_url":"https://api.github.com/users/deralmas/orgs","repos_url":"https://api.github.com/users/deralmas/repos","events_url":"https://api.github.com/users/deralmas/events{/privacy}","received_events_url":"https://api.github.com/users/deralmas/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-05-03T18:33:58Z","updated_at":"2026-05-03T18:38:37Z","body":"Thank you for your report!\n\nUnfortunately this seems to be a limitation of how touch is handled, both on Godot and on Wayland.\n\nGodot exposes a generic `DisplayServer::is_touchscreen_available` method. It doesn't support any parameter to specify the screen, and even then touch optimization is only enabled at startup. This means that hypothetically, even if we could do all the above, it still wouldn't toggle between screen changes with the current logic without a full editor restart.\n\nWayland-side, there isn't the concept of a \"touch-capable screen\". It just exposed a global touch input capability. I guess that a compositor could unset the touch capability when a window is outside of any touch screen, but if you initialize the editor on your big monitor and nothing changes, that is likely not the case.\n\nThis seems like a tricky situation and I'm not sure what would be the best approach here. If you mainly use the big monitor, I'm afraid that the simplest workaround would be to disable touch optimizations in the editor settings.\n\nIn general, I think that this might require some more thorough usability discussions, along with various other needed improvements for users with touch screens.\n\nEdit: interestingly, I just noticed that at least _some_ optimizations can be toggled at runtime! That's interesting. I can't seem to find a way to enable/disable the 3D \"joysticks\" though, which might be the biggest issue.","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4366872159/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4389812165","html_url":"https://github.com/godotengine/godot/issues/118938#issuecomment-4389812165","issue_url":"https://api.github.com/repos/godotengine/godot/issues/118938","id":4389812165,"node_id":"IC_kwDOAO6SJc8AAAABBac3xQ","user":{"login":"syntaxerror247","id":176927541,"node_id":"U_kgDOCouzNQ","avatar_url":"https://avatars.githubusercontent.com/u/176927541?v=4","gravatar_id":"","url":"https://api.github.com/users/syntaxerror247","html_url":"https://github.com/syntaxerror247","followers_url":"https://api.github.com/users/syntaxerror247/followers","following_url":"https://api.github.com/users/syntaxerror247/following{/other_user}","gists_url":"https://api.github.com/users/syntaxerror247/gists{/gist_id}","starred_url":"https://api.github.com/users/syntaxerror247/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/syntaxerror247/subscriptions","organizations_url":"https://api.github.com/users/syntaxerror247/orgs","repos_url":"https://api.github.com/users/syntaxerror247/repos","events_url":"https://api.github.com/users/syntaxerror247/events{/privacy}","received_events_url":"https://api.github.com/users/syntaxerror247/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-05-06T15:54:04Z","updated_at":"2026-05-06T15:54:04Z","body":"> I can't seem to find a way to enable/disable the 3D \"joysticks\" though, which might be the biggest issue.\n\nIt's under `editors/3d/navigation/show_viewport_navigation_gizmo`.","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4389812165/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4396234912","html_url":"https://github.com/godotengine/godot/issues/118938#issuecomment-4396234912","issue_url":"https://api.github.com/repos/godotengine/godot/issues/118938","id":4396234912,"node_id":"IC_kwDOAO6SJc8AAAABBgk4oA","user":{"login":"Franz-Inc","id":140611427,"node_id":"U_kgDOCGGPYw","avatar_url":"https://avatars.githubusercontent.com/u/140611427?v=4","gravatar_id":"","url":"https://api.github.com/users/Franz-Inc","html_url":"https://github.com/Franz-Inc","followers_url":"https://api.github.com/users/Franz-Inc/followers","following_url":"https://api.github.com/users/Franz-Inc/following{/other_user}","gists_url":"https://api.github.com/users/Franz-Inc/gists{/gist_id}","starred_url":"https://api.github.com/users/Franz-Inc/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Franz-Inc/subscriptions","organizations_url":"https://api.github.com/users/Franz-Inc/orgs","repos_url":"https://api.github.com/users/Franz-Inc/repos","events_url":"https://api.github.com/users/Franz-Inc/events{/privacy}","received_events_url":"https://api.github.com/users/Franz-Inc/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-05-07T10:17:17Z","updated_at":"2026-05-07T10:17:17Z","body":"I ran into this issue myself running Linux and 4.7 Beta 1, where I launch Godot forcing wayland with: `godot_4-7-beta1.x86_64 --display-driver wayland`. I am running Godot on my non-touch external monitor, but my PC (Dell XPS 16) has a touch screen.\n\nThis issue was particularly painful and noticeable when I was trying to drag and drop a node from a scene tree into an @export field in the Inspector.\n\nHere are two video examples: 1st as expected without using Wayland, and the 2nd with it bugged, thinking I was using touch screen input:\n\nhttps://github.com/user-attachments/assets/1701042f-b574-46db-951b-dd972220c65f\n\nhttps://github.com/user-attachments/assets/97d760c9-f22a-4f29-ac16-035556b52536\n\n Obvious work around for now is to not enable wayland.","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4396234912/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4491613844","html_url":"https://github.com/godotengine/godot/issues/118938#issuecomment-4491613844","issue_url":"https://api.github.com/repos/godotengine/godot/issues/118938","id":4491613844,"node_id":"IC_kwDOAO6SJc8AAAABC7iWlA","user":{"login":"sommerper","id":1512048,"node_id":"MDQ6VXNlcjE1MTIwNDg=","avatar_url":"https://avatars.githubusercontent.com/u/1512048?v=4","gravatar_id":"","url":"https://api.github.com/users/sommerper","html_url":"https://github.com/sommerper","followers_url":"https://api.github.com/users/sommerper/followers","following_url":"https://api.github.com/users/sommerper/following{/other_user}","gists_url":"https://api.github.com/users/sommerper/gists{/gist_id}","starred_url":"https://api.github.com/users/sommerper/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/sommerper/subscriptions","organizations_url":"https://api.github.com/users/sommerper/orgs","repos_url":"https://api.github.com/users/sommerper/repos","events_url":"https://api.github.com/users/sommerper/events{/privacy}","received_events_url":"https://api.github.com/users/sommerper/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-05-19T20:09:21Z","updated_at":"2026-05-19T20:09:21Z","body":"This is also a problem when using a drawing tablet. It makes Godot completely unusable because I can no longer drag stuff from the file browser. 🫠","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4491613844/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4491627952","html_url":"https://github.com/godotengine/godot/issues/118938#issuecomment-4491627952","issue_url":"https://api.github.com/repos/godotengine/godot/issues/118938","id":4491627952,"node_id":"IC_kwDOAO6SJc8AAAABC7jNsA","user":{"login":"sommerper","id":1512048,"node_id":"MDQ6VXNlcjE1MTIwNDg=","avatar_url":"https://avatars.githubusercontent.com/u/1512048?v=4","gravatar_id":"","url":"https://api.github.com/users/sommerper","html_url":"https://github.com/sommerper","followers_url":"https://api.github.com/users/sommerper/followers","following_url":"https://api.github.com/users/sommerper/following{/other_user}","gists_url":"https://api.github.com/users/sommerper/gists{/gist_id}","starred_url":"https://api.github.com/users/sommerper/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/sommerper/subscriptions","organizations_url":"https://api.github.com/users/sommerper/orgs","repos_url":"https://api.github.com/users/sommerper/repos","events_url":"https://api.github.com/users/sommerper/events{/privacy}","received_events_url":"https://api.github.com/users/sommerper/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-05-19T20:11:17Z","updated_at":"2026-05-19T20:11:42Z","body":"> This seems like a tricky situation and I'm not sure what would be the best approach here.\n\n@deralmas Why not just have an On/Off Editor Setting for that? Or enable/disable it via command line?","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4491627952/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4493011441","html_url":"https://github.com/godotengine/godot/issues/118938#issuecomment-4493011441","issue_url":"https://api.github.com/repos/godotengine/godot/issues/118938","id":4493011441,"node_id":"IC_kwDOAO6SJc8AAAABC83p8Q","user":{"login":"deralmas","id":31065808,"node_id":"MDQ6VXNlcjMxMDY1ODA4","avatar_url":"https://avatars.githubusercontent.com/u/31065808?v=4","gravatar_id":"","url":"https://api.github.com/users/deralmas","html_url":"https://github.com/deralmas","followers_url":"https://api.github.com/users/deralmas/followers","following_url":"https://api.github.com/users/deralmas/following{/other_user}","gists_url":"https://api.github.com/users/deralmas/gists{/gist_id}","starred_url":"https://api.github.com/users/deralmas/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/deralmas/subscriptions","organizations_url":"https://api.github.com/users/deralmas/orgs","repos_url":"https://api.github.com/users/deralmas/repos","events_url":"https://api.github.com/users/deralmas/events{/privacy}","received_events_url":"https://api.github.com/users/deralmas/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-05-19T23:24:03Z","updated_at":"2026-05-19T23:24:03Z","body":"> This is also a problem when using a drawing tablet. It makes Godot completely unusable because I can no longer drag stuff from the file browser. 🫠\n\nThat's a different bug, which has a fix here: #119507.\n\nI haven't had a chance to test it yet cause my touch setup is very clunky and I've been busy with other stuff lately.\n\n> Why not just have an On/Off Editor Setting for that?\n\nTurns out there is, as @syntaxerror247 pointed out above. IMO the issue is discoverability and general UX.\n\nI think these issues have always been there under other touch-enabled platforms, namely web and android. It's just that reporting touch support in a major desktop platform (X11 supports it but still reports `false` in `is_touchscreen_available` IIRC, disabling touch optimizations) exposed this issue more broadly.","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4493011441/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4496282295","html_url":"https://github.com/godotengine/godot/issues/118938#issuecomment-4496282295","issue_url":"https://api.github.com/repos/godotengine/godot/issues/118938","id":4496282295,"node_id":"IC_kwDOAO6SJc8AAAABC__Stw","user":{"login":"Franz-Inc","id":140611427,"node_id":"U_kgDOCGGPYw","avatar_url":"https://avatars.githubusercontent.com/u/140611427?v=4","gravatar_id":"","url":"https://api.github.com/users/Franz-Inc","html_url":"https://github.com/Franz-Inc","followers_url":"https://api.github.com/users/Franz-Inc/followers","following_url":"https://api.github.com/users/Franz-Inc/following{/other_user}","gists_url":"https://api.github.com/users/Franz-Inc/gists{/gist_id}","starred_url":"https://api.github.com/users/Franz-Inc/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Franz-Inc/subscriptions","organizations_url":"https://api.github.com/users/Franz-Inc/orgs","repos_url":"https://api.github.com/users/Franz-Inc/repos","events_url":"https://api.github.com/users/Franz-Inc/events{/privacy}","received_events_url":"https://api.github.com/users/Franz-Inc/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-05-20T08:34:36Z","updated_at":"2026-05-20T08:34:36Z","body":"My use case that I mentioned above appears to be fixed by https://github.com/godotengine/godot/pull/119507.","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4496282295/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4500294445","html_url":"https://github.com/godotengine/godot/issues/118938#issuecomment-4500294445","issue_url":"https://api.github.com/repos/godotengine/godot/issues/118938","id":4500294445,"node_id":"IC_kwDOAO6SJc8AAAABDD0LLQ","user":{"login":"syntaxerror247","id":176927541,"node_id":"U_kgDOCouzNQ","avatar_url":"https://avatars.githubusercontent.com/u/176927541?v=4","gravatar_id":"","url":"https://api.github.com/users/syntaxerror247","html_url":"https://github.com/syntaxerror247","followers_url":"https://api.github.com/users/syntaxerror247/followers","following_url":"https://api.github.com/users/syntaxerror247/following{/other_user}","gists_url":"https://api.github.com/users/syntaxerror247/gists{/gist_id}","starred_url":"https://api.github.com/users/syntaxerror247/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/syntaxerror247/subscriptions","organizations_url":"https://api.github.com/users/syntaxerror247/orgs","repos_url":"https://api.github.com/users/syntaxerror247/repos","events_url":"https://api.github.com/users/syntaxerror247/events{/privacy}","received_events_url":"https://api.github.com/users/syntaxerror247/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-05-20T16:05:59Z","updated_at":"2026-05-20T16:05:59Z","body":"So far I've only seen these issues reported in this thread:\n1. Can't find the option to disable viewport navigation joysticks: It's under `editors/3d/navigation/show_viewport_navigation_gizmo`.\n2. Drag and drop not working: This is fixed by https://github.com/godotengine/godot/pull/119507 for mouse input.\n\nis there any other issues?\n","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4500294445/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4885484173","html_url":"https://github.com/godotengine/godot/issues/118938#issuecomment-4885484173","issue_url":"https://api.github.com/repos/godotengine/godot/issues/118938","id":4885484173,"node_id":"IC_kwDOAO6SJc8AAAABIzKSjQ","user":{"login":"Cautami","id":219921783,"node_id":"U_kgDODRu9dw","avatar_url":"https://avatars.githubusercontent.com/u/219921783?v=4","gravatar_id":"","url":"https://api.github.com/users/Cautami","html_url":"https://github.com/Cautami","followers_url":"https://api.github.com/users/Cautami/followers","following_url":"https://api.github.com/users/Cautami/following{/other_user}","gists_url":"https://api.github.com/users/Cautami/gists{/gist_id}","starred_url":"https://api.github.com/users/Cautami/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Cautami/subscriptions","organizations_url":"https://api.github.com/users/Cautami/orgs","repos_url":"https://api.github.com/users/Cautami/repos","events_url":"https://api.github.com/users/Cautami/events{/privacy}","received_events_url":"https://api.github.com/users/Cautami/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-07-05T09:06:54Z","updated_at":"2026-07-05T09:07:35Z","body":"I have a dual monitor setup and neither of them are touchscreen, yet Godot seems to reaaaallly want to recognize my computer as a touchscreen device, which forces the mouse drag thing to happen, making the editor rather infuriating. This occurs even on 4.7-rc1 with #119507 merged. I have a screenless tablet (which is completely turned off as of now), however Plasma does not pick this up as an actual display, so I frankly have no idea where it's getting the idea I'm on a touchscreen 🥲 \nI've went into the engine and hard coded DisplayServerWayland::is_touchscreen_available to return false to get around this for now, if anyone has any interesting tests they want me to run I would be more than happy to do so, but I mostly just wanted to not get driven up a wall by the mouse dragging...","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4885484173/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4885550150","html_url":"https://github.com/godotengine/godot/issues/118938#issuecomment-4885550150","issue_url":"https://api.github.com/repos/godotengine/godot/issues/118938","id":4885550150,"node_id":"IC_kwDOAO6SJc8AAAABIzOURg","user":{"login":"deralmas","id":31065808,"node_id":"MDQ6VXNlcjMxMDY1ODA4","avatar_url":"https://avatars.githubusercontent.com/u/31065808?v=4","gravatar_id":"","url":"https://api.github.com/users/deralmas","html_url":"https://github.com/deralmas","followers_url":"https://api.github.com/users/deralmas/followers","following_url":"https://api.github.com/users/deralmas/following{/other_user}","gists_url":"https://api.github.com/users/deralmas/gists{/gist_id}","starred_url":"https://api.github.com/users/deralmas/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/deralmas/subscriptions","organizations_url":"https://api.github.com/users/deralmas/orgs","repos_url":"https://api.github.com/users/deralmas/repos","events_url":"https://api.github.com/users/deralmas/events{/privacy}","received_events_url":"https://api.github.com/users/deralmas/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-07-05T09:33:01Z","updated_at":"2026-07-05T09:33:01Z","body":"@Cautami `DisplayServerWayland::is_touchscreen_available` is based entirely on the compositor explicitly saying \"there's a touchscreen\", so there's not much we can do. Drawing tablets are a different class of device so I don't think that's the issue.\n\nCan you please attach the output of `wayland-info`? It's usually under the `wayland-utils` package.","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4885550150/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4886984343","html_url":"https://github.com/godotengine/godot/issues/118938#issuecomment-4886984343","issue_url":"https://api.github.com/repos/godotengine/godot/issues/118938","id":4886984343,"node_id":"IC_kwDOAO6SJc8AAAABI0l2lw","user":{"login":"Cautami","id":219921783,"node_id":"U_kgDODRu9dw","avatar_url":"https://avatars.githubusercontent.com/u/219921783?v=4","gravatar_id":"","url":"https://api.github.com/users/Cautami","html_url":"https://github.com/Cautami","followers_url":"https://api.github.com/users/Cautami/followers","following_url":"https://api.github.com/users/Cautami/following{/other_user}","gists_url":"https://api.github.com/users/Cautami/gists{/gist_id}","starred_url":"https://api.github.com/users/Cautami/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Cautami/subscriptions","organizations_url":"https://api.github.com/users/Cautami/orgs","repos_url":"https://api.github.com/users/Cautami/repos","events_url":"https://api.github.com/users/Cautami/events{/privacy}","received_events_url":"https://api.github.com/users/Cautami/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-07-05T17:33:34Z","updated_at":"2026-07-05T17:33:34Z","body":"@deralmas \n[wayland-info.txt](https://github.com/user-attachments/files/29678010/wayland-info.txt) ","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4886984343/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4887025435","html_url":"https://github.com/godotengine/godot/issues/118938#issuecomment-4887025435","issue_url":"https://api.github.com/repos/godotengine/godot/issues/118938","id":4887025435,"node_id":"IC_kwDOAO6SJc8AAAABI0oXGw","user":{"login":"deralmas","id":31065808,"node_id":"MDQ6VXNlcjMxMDY1ODA4","avatar_url":"https://avatars.githubusercontent.com/u/31065808?v=4","gravatar_id":"","url":"https://api.github.com/users/deralmas","html_url":"https://github.com/deralmas","followers_url":"https://api.github.com/users/deralmas/followers","following_url":"https://api.github.com/users/deralmas/following{/other_user}","gists_url":"https://api.github.com/users/deralmas/gists{/gist_id}","starred_url":"https://api.github.com/users/deralmas/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/deralmas/subscriptions","organizations_url":"https://api.github.com/users/deralmas/orgs","repos_url":"https://api.github.com/users/deralmas/repos","events_url":"https://api.github.com/users/deralmas/events{/privacy}","received_events_url":"https://api.github.com/users/deralmas/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-07-05T17:47:46Z","updated_at":"2026-07-05T17:47:46Z","body":"@Cautami welp it looks like the compositor is actually reporting touch for some reason. Sorry, I know that's not much. Perhaps you can look at the output of `libinput list-device` as root and see if there's any weird device in there.\n\nAnyways, that's a rabbit hole that we don't need to fall into right now. It isn't intended for the drag thing to happen with a mouse, touch screen or not (think of android devices).\n\nWhen you wrote \"4.7-rc1\" did you mean 4.7.1-rc1? It includes #120728 which is supposed to fix the issue.","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4887025435/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4887281575","html_url":"https://github.com/godotengine/godot/issues/118938#issuecomment-4887281575","issue_url":"https://api.github.com/repos/godotengine/godot/issues/118938","id":4887281575,"node_id":"IC_kwDOAO6SJc8AAAABI03_pw","user":{"login":"Cautami","id":219921783,"node_id":"U_kgDODRu9dw","avatar_url":"https://avatars.githubusercontent.com/u/219921783?v=4","gravatar_id":"","url":"https://api.github.com/users/Cautami","html_url":"https://github.com/Cautami","followers_url":"https://api.github.com/users/Cautami/followers","following_url":"https://api.github.com/users/Cautami/following{/other_user}","gists_url":"https://api.github.com/users/Cautami/gists{/gist_id}","starred_url":"https://api.github.com/users/Cautami/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Cautami/subscriptions","organizations_url":"https://api.github.com/users/Cautami/orgs","repos_url":"https://api.github.com/users/Cautami/repos","events_url":"https://api.github.com/users/Cautami/events{/privacy}","received_events_url":"https://api.github.com/users/Cautami/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-07-05T19:15:14Z","updated_at":"2026-07-05T19:15:14Z","body":"Yes sorry I meant 4.7.1-rc1, the issue persists. \nI can't seem to find anything out of the ordinary with libinput list-devices, aside from my (screenless) drawing tablet and pen. \n\nDespite that, I entertained the idea of it and disabled the drawing tablet entirely, this actually fixed the issue. \nAfter re-enabling it, the tablet still retains functionality in the apps I use it in (Krita), but Godot in particularly seems to not accept pen input now, which I guess is a curse and a blessing. \nI cannot seem to find out why that is, as wayland-info and libinput are now showing the same devices they once were, so I'm chalking this up to Wayland nonsense. \n\nRegardless, it is strange that rc1 didn't fix the issue and I worry for users who may be more heavy artists who may run into such a thing, as it is rather infuriating. I'll try to figure out why that is once Wayland decides I'm not allowed to have fun anymore again, I suppose. ","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4887281575/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4887681128","html_url":"https://github.com/godotengine/godot/issues/118938#issuecomment-4887681128","issue_url":"https://api.github.com/repos/godotengine/godot/issues/118938","id":4887681128,"node_id":"IC_kwDOAO6SJc8AAAABI1QYaA","user":{"login":"deralmas","id":31065808,"node_id":"MDQ6VXNlcjMxMDY1ODA4","avatar_url":"https://avatars.githubusercontent.com/u/31065808?v=4","gravatar_id":"","url":"https://api.github.com/users/deralmas","html_url":"https://github.com/deralmas","followers_url":"https://api.github.com/users/deralmas/followers","following_url":"https://api.github.com/users/deralmas/following{/other_user}","gists_url":"https://api.github.com/users/deralmas/gists{/gist_id}","starred_url":"https://api.github.com/users/deralmas/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/deralmas/subscriptions","organizations_url":"https://api.github.com/users/deralmas/orgs","repos_url":"https://api.github.com/users/deralmas/repos","events_url":"https://api.github.com/users/deralmas/events{/privacy}","received_events_url":"https://api.github.com/users/deralmas/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-07-05T21:39:22Z","updated_at":"2026-07-05T21:39:22Z","body":"> Yes sorry I meant 4.7.1-rc1, the issue persists.\n>\n> I can't seem to find anything out of the ordinary with libinput list-devices, aside from my (screenless) drawing tablet and pen.\n>\n> Despite that, I entertained the idea of it and disabled the drawing tablet entirely, this actually fixed the issue.\n\nThat's very weird, yeah. As I said, standard Wayland extensions handle tablets very differently than touch screens, so I'm really not sure why your specific setup is insisting on reporting a touchscreen.\n\n> After re-enabling it, the tablet still retains functionality in the apps I use it in (Krita), but Godot in particularly seems to not accept pen input now, which I guess is a curse and a blessing.\n\nOh if you're referring to broken tablet input in the editor, that's a known issue. I'm on it right now, so you can expect a PR soon!\n\n> I cannot seem to find out why that is, as wayland-info and libinput are now showing the same devices they once were, so I'm chalking this up to Wayland nonsense.\n>\n> Regardless, it is strange that rc1 didn't fix the issue and I worry for users who may be more heavy artists who may run into such a thing, as it is rather infuriating. I'll try to figure out why that is once Wayland decides I'm not allowed to have fun anymore again, I suppose.\n\nFor the record, there is nothing Wayland-specific behind this issue. The wayland backend just emits touch events like every other platform. Everything except X11/Windows exposes the same touchscreen hint and, AFAICT, have the same dragging issue (it has been confirmed on Android, for example).","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4887681128/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5030309035","html_url":"https://github.com/godotengine/godot/issues/118938#issuecomment-5030309035","issue_url":"https://api.github.com/repos/godotengine/godot/issues/118938","id":5030309035,"node_id":"IC_kwDOAO6SJc8AAAABK9Rsqw","user":{"login":"Cautami","id":219921783,"node_id":"U_kgDODRu9dw","avatar_url":"https://avatars.githubusercontent.com/u/219921783?v=4","gravatar_id":"","url":"https://api.github.com/users/Cautami","html_url":"https://github.com/Cautami","followers_url":"https://api.github.com/users/Cautami/followers","following_url":"https://api.github.com/users/Cautami/following{/other_user}","gists_url":"https://api.github.com/users/Cautami/gists{/gist_id}","starred_url":"https://api.github.com/users/Cautami/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Cautami/subscriptions","organizations_url":"https://api.github.com/users/Cautami/orgs","repos_url":"https://api.github.com/users/Cautami/repos","events_url":"https://api.github.com/users/Cautami/events{/privacy}","received_events_url":"https://api.github.com/users/Cautami/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-07-21T04:56:56Z","updated_at":"2026-07-21T04:57:16Z","body":"@deralmas Had this happen again, I haven't turned on my tablet since this originally happened, but it seems Wayland (or whatever handles input) happened to pick it up again automatically and Godot was more than happy to oblige. \nWould a PR for exposing the ability to disable this manually be on the table? \n","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5030309035/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5199042211","html_url":"https://github.com/godotengine/godot/issues/118938#issuecomment-5199042211","issue_url":"https://api.github.com/repos/godotengine/godot/issues/118938","id":5199042211,"node_id":"IC_kwDOAO6SJc8AAAABNeMWow","user":{"login":"sinni800","id":2879097,"node_id":"MDQ6VXNlcjI4NzkwOTc=","avatar_url":"https://avatars.githubusercontent.com/u/2879097?v=4","gravatar_id":"","url":"https://api.github.com/users/sinni800","html_url":"https://github.com/sinni800","followers_url":"https://api.github.com/users/sinni800/followers","following_url":"https://api.github.com/users/sinni800/following{/other_user}","gists_url":"https://api.github.com/users/sinni800/gists{/gist_id}","starred_url":"https://api.github.com/users/sinni800/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/sinni800/subscriptions","organizations_url":"https://api.github.com/users/sinni800/orgs","repos_url":"https://api.github.com/users/sinni800/repos","events_url":"https://api.github.com/users/sinni800/events{/privacy}","received_events_url":"https://api.github.com/users/sinni800/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-08-06T00:36:31Z","updated_at":"2026-08-06T00:36:31Z","body":"I have a related issue where as long as a touch device is installed, dragging, for example, on a scrolling textbox will BOTH select and drag the box contents. But this is a different issue, I suppose, and I will report that separately. ","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5199042211/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null}]