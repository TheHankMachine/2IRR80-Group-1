[{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2884061764","html_url":"https://github.com/godotengine/godot/issues/106427#issuecomment-2884061764","issue_url":"https://api.github.com/repos/godotengine/godot/issues/106427","id":2884061764,"node_id":"IC_kwDOAO6SJc6r50pE","user":{"login":"Alex2782","id":41921395,"node_id":"MDQ6VXNlcjQxOTIxMzk1","avatar_url":"https://avatars.githubusercontent.com/u/41921395?v=4","gravatar_id":"","url":"https://api.github.com/users/Alex2782","html_url":"https://github.com/Alex2782","followers_url":"https://api.github.com/users/Alex2782/followers","following_url":"https://api.github.com/users/Alex2782/following{/other_user}","gists_url":"https://api.github.com/users/Alex2782/gists{/gist_id}","starred_url":"https://api.github.com/users/Alex2782/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Alex2782/subscriptions","organizations_url":"https://api.github.com/users/Alex2782/orgs","repos_url":"https://api.github.com/users/Alex2782/repos","events_url":"https://api.github.com/users/Alex2782/events{/privacy}","received_events_url":"https://api.github.com/users/Alex2782/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-05-15T14:36:55Z","updated_at":"2025-05-15T14:36:55Z","body":"\nI think they should be disabled in production settings. Logs are disabled by default, but are enforced on PCs.\nProduction builds also generate fewer errors and warnings than debug builds.\n\n![Image](https://github.com/user-attachments/assets/30f14c53-303f-4973-a459-ef438942a35f)","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2884061764/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3138017476","html_url":"https://github.com/godotengine/godot/issues/106427#issuecomment-3138017476","issue_url":"https://api.github.com/repos/godotengine/godot/issues/106427","id":3138017476,"node_id":"IC_kwDOAO6SJc67CljE","user":{"login":"Calinou","id":180032,"node_id":"MDQ6VXNlcjE4MDAzMg==","avatar_url":"https://avatars.githubusercontent.com/u/180032?v=4","gravatar_id":"","url":"https://api.github.com/users/Calinou","html_url":"https://github.com/Calinou","followers_url":"https://api.github.com/users/Calinou/followers","following_url":"https://api.github.com/users/Calinou/following{/other_user}","gists_url":"https://api.github.com/users/Calinou/gists{/gist_id}","starred_url":"https://api.github.com/users/Calinou/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Calinou/subscriptions","organizations_url":"https://api.github.com/users/Calinou/orgs","repos_url":"https://api.github.com/users/Calinou/repos","events_url":"https://api.github.com/users/Calinou/events{/privacy}","received_events_url":"https://api.github.com/users/Calinou/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-07-30T22:33:02Z","updated_at":"2025-07-30T22:33:29Z","body":"Logs are enabled by default on platforms where files are easily accessible, so that players can give you the log files to report issues without needing specific instructions.\n\nYou should look at the source of error spam and fix it, as error spam in general *will* decrease game performance even if the errors are never visible to the player.","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3138017476/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4103523700","html_url":"https://github.com/godotengine/godot/issues/106427#issuecomment-4103523700","i