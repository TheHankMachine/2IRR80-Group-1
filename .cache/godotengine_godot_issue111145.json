efault":false,"description":"","archived_at":null,"archived_by":null},{"id":2666708059,"node_id":"MDU6TGFiZWwyNjY2NzA4MDU5","url":"https://api.github.com/repos/godotengine/godot/labels/topic:2d","name":"topic:2d","color":"ffee88","default":false,"description":"","archived_at":null,"archived_by":null}],"state":"open","locked":false,"assignees":[],"milestone":{"url":"https://api.github.com/repos/godotengine/godot/milestones/16","html_url":"https://github.com/godotengine/godot/milestone/16","labels_url":"https://api.github.com/repos/godotengine/godot/milestones/16/labels","id":8237783,"node_id":"MI_kwDOAO6SJc4AfbLX","number":16,"title":"4.x","description":"Issues and pull requests slated for an undetermined Godot 4 release.","creator":{"login":"akien-mga","id":4701338,"node_id":"MDQ6VXNlcjQ3MDEzMzg=","avatar_url":"https://avatars.githubusercontent.com/u/4701338?v=4","gravatar_id":"","url":"https://api.github.com/users/akien-mga","html_url":"https://github.com/akien-mga","followers_url":"https://api.github.com/users/akien-mga/followers","following_url":"https://api.github.com/users/akien-mga/following{/other_user}","gists_url":"https://api.github.com/users/akien-mga/gists{/gist_id}","starred_url":"https://api.github.com/users/akien-mga/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/akien-mga/subscriptions","organizations_url":"https://api.github.com/users/akien-mga/orgs","repos_url":"https://api.github.com/users/akien-mga/repos","events_url":"https://api.github.com/users/akien-mga/events{/privacy}","received_events_url":"https://api.github.com/users/akien-mga/received_events","type":"User","user_view_type":"public","site_admin":false},"open_issues":5793,"closed_issues":0,"state":"open","created_at":"2022-07-26T12:42:05Z","updated_at":"2026-10-22T14:39:14Z","due_on":null,"closed_at":null},"comments":0,"created_at":"2025-10-02T06:07:33Z","updated_at":"2026-02-17T20:10:08Z","closed_at":null,"assignee":null,"author_association":"NONE","issue_field_values":[],"type":null,"active_lock_reason":null,"draft":true,"pull_request":{"url":"https://api.github.com/repos/godotengine/godot/pulls/111145","html_url":"https://github.com/godotengine/godot/pull/111145","diff_url":"https://github.com/godotengine/godot/pull/111145.diff","patch_url":"https://github.com/godotengine/godot/pull/111145.patch","merged_at":null},"body":"related to #49497 \r\n\r\n![stacked_character_body](https://github.com/user-attachments/assets/1397507f-39cf-404a-a9f3-92b374b1d45f)\r\n\r\nThis PR is a try to improve the stability of stacked CharacterBody2D boxes.\r\n\r\nMoving with platform in horizontal is now much better. Vertical one is still hard to fix as it's highly related to the processing order of each body nodes, I cannot figure out any easy solution. I guess adding some kind of iteration methods in the PhysicsServer is necessary for vertical one, which will be a lot of work.\r\n\r\nFor horizontal situation, the issue is mainly caused by two reasons, both related to the recovery motion. \r\n\r\nFirst, for the box clamped in the middle, snapping may fail as the recovery motion would trigger a collision with the ceiling box. We can try to ignore these ceiling in the snapping process, guaranteeing a floor is detected successfully.\r\n\r\nSecond, the platform velocity from another CharacterBody2D is likely to include a recovery motion e.g. the platform has speed (200,0) but the box on it travels with speed (200, -0.xx) due to recovery motion. With the minor recovery part, a single move_and_collide is easily to hit with another ceiling, so we have to do some kind of sliding here.\r\n\r\nI'm not sure if my patches make sense, it looks so tricky. So I'm just opening a draft here, any suggestions would be graceful.","closed_by":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/111145/reactions","total_count":5,"+1":1,"-1":0,"laugh":0,"hooray":4,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/godotengine/godot/issues/111145/timeline","performed_via_github_app":null,"state_reason":null}