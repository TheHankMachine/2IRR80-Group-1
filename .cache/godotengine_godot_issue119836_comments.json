398958,"node_id":"IC_kwDOAO6SJc8AAAABEW4nLg","user":{"login":"45DegreeAngl","id":154566159,"node_id":"U_kgDOCTZ-Dw","avatar_url":"https://avatars.githubusercontent.com/u/154566159?v=4","gravatar_id":"","url":"https://api.github.com/users/45DegreeAngl","html_url":"https://github.com/45DegreeAngl","followers_url":"https://api.github.com/users/45DegreeAngl/followers","following_url":"https://api.github.com/users/45DegreeAngl/following{/other_user}","gists_url":"https://api.github.com/users/45DegreeAngl/gists{/gist_id}","starred_url":"https://api.github.com/users/45DegreeAngl/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/45DegreeAngl/subscriptions","organizations_url":"https://api.github.com/users/45DegreeAngl/orgs","repos_url":"https://api.github.com/users/45DegreeAngl/repos","events_url":"https://api.github.com/users/45DegreeAngl/events{/privacy}","received_events_url":"https://api.github.com/users/45DegreeAngl/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-05-31T16:49:37Z","updated_at":"2026-05-31T16:49:37Z","body":"> I just tested and this fails: `const vec2 DEFAULT_TEXEL = vec2(1.0 / 1024.0);` While this works: `uniform vec2 texel = vec2(0.0009765625);`\n\nThats weird!\nI tried on 4.7 beta and 4.6 stable but it doesnt error, which error did you get?\nEither way this issue thread is uniform variables not recognizing constant variables as constant, I would open up a separate bug for that","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4587398958/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4587455788","html_url":"https://github.com/godotengine/godot/issues/119836#issuecomment-4587455788","issue_url":"https://api.github.com/repos/godotengine/godot/issues/119836","id":4587455788,"node_id":"IC_kwDOAO6SJc8AAAABEW8FLA","user":{"login":"45DegreeAngl","id":154566159,"node_id":"U_kgDOCTZ-Dw","avatar_url":"https://avatars.githubusercontent.com/u/154566159?v=4","gravatar_id":"","url":"https://api.github.com/users/45DegreeAngl","html_url":"https://github.com/45DegreeAngl","followers_url":"https://api.github.com/users/45DegreeAngl/followers","following_url":"https://api.github.com/users/45DegreeAngl/following{/other_user}","gists_url":"https://api.github.com/users/45DegreeAngl/gists{/gist_id}","starred_url":"https://api.github.com/users/45DegreeAngl/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/45DegreeAngl/subscriptions","organizations_url":"https://api.github.com/users/45DegreeAngl/orgs","repos_url":"https://api.github.com/users/45DegreeAngl/repos","events_url":"https://api.github.com/users/45DegreeAngl/events{/privacy}","received_events_url":"https://api.github.com/users/45DegreeAngl/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-05-31T17:13:25Z","updated_at":"2026-06-01T18:11:49Z","body":"Through searching in the code there is only one instance of the error: \n\"Expected constant expression after '='.\" \n\nshader_language.cpp lines 10224 to 10233\n```cpp\nNode *expr = _parse_and_reduce_expression(nullptr, constants);\nif (!expr) {\n\treturn ERR_PARSE_ERROR;\n}\nif (expr->type != Node::NODE_TYPE_CONSTANT) {\n\t_set_error(RTR(\"Expected constant expression after '='.\"));//**<--------- This line right here**\n\treturn ERR_PARSE_ERROR;\n}\n\nConstantNode *cn = static_cast<ConstantNode *>(expr);\n\n```\n\n\nBecause this issue is not present in constant variable declaration (from the versions that I tested) I suspect that the way constant variables determine if they're equal to a constant is how uniforms should detect whether it is constant or not.\n\n\n","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4587455788/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4588007337","html_url":"https://github.com/godotengine/godot/issues/119836#issuecomment-4588007337","issue_url":"https://api.github.com/repos/godotengine/godot/issues/119836","id":4588007337,"node_id":"IC_kwDOAO6SJc8AAAABEXdvqQ","user":{"login":"saint11","id":4672703,"node_id":"MDQ6VXNlcjQ2NzI3MDM=","avatar_url":"https://avatars.githubusercontent.com/u/4672703?v=4","gravatar_id":"","url":"https://api.github.com/users/saint11","html_url":"https://github.com/saint11","followers_url":"https://api.github.com/users/saint11/followers","following_url":"https://api.github.com/users/saint11/following{/other_user}","gists_url":"https://api.github.com/users/saint11/gists{/gist_id}","starred_url":"https://api.github.com/users/saint11/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/saint11/subscriptions","organizations_url":"https://api.github.com/users/saint11/orgs","repos_url":"https://api.github.com/users/saint11/repos","events_url":"https://api.github.com/users/saint11/events{/privacy}","received_events_url":"https://api.github.com/users/saint11/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-05-31T20:36:19Z","updated_at":"2026-05-31T20:36:19Z","body":"I'm on 4.6.3.stable.mono right now!\nI'm sorry, I think I had it wrong:\nThis fails:\n`uniform vec2 DEFAULT_TEXEL = vec2(1.0 / 1024.0);`\nbut this works:\n`const vec2 DEFAULT_TEXEL = vec2(1.0 / 1024.0);`\n\nI'll edit my previous comment to avoid any future confusion.","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4588007337/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4595199229","html_url":"https://github.com/godotengine/godot/issues/119836#issuecomment-4595199229","issue_url":"https://api.github.com/repos/godotengine/godot/issues/119836","id":4595199229,"node_id":"IC_kwDOAO6SJc8AAAABEeUs_Q","user":{"login":"45DegreeAngl","id":154566159,"node_id":"U_kgDOCTZ-Dw","avatar_url":"https://avatars.githubusercontent.com/u/154566159?v=4","gravatar_id":"","url":"https://api.github.com/users/45DegreeAngl","html_url":"https://github.com/45DegreeAngl","followers_url":"https://api.github.com/users/45DegreeAngl/followers","following_url":"https://api.github.com/users/45DegreeAngl/following{/other_user}","gists_url":"https://api.github.com/users/45DegreeAngl/gists{/gist_id}","starred_url":"https://api.github.com/users/45DegreeAngl/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/45DegreeAngl/subscriptions","organizations_url":"https://api.github.com/users/45DegreeAngl/orgs","repos_url":"https://api.github.com/users/45DegreeAngl/repos","events_url":"https://api.github.com/users/45DegreeAngl/events{/privacy}","received_events_url":"https://api.github.com/users/45DegreeAngl/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-06-01T18:03:30Z","updated_at":"2026-06-01T18:03:30Z","body":"Update for this issue! So the current code to display this error is incapable of receiving a Node Type that is not exactly a constant. (which is why it errors when receiving an expression like 1.0*1.0 or a previously defined const variable) What this means is that only the case where the function _parse_and_reduce_expression() returns a Node::NODE_TYPE_CONSTANT is allowed as its the only case where its possible. My first thought is some sort of switch statement to handle the assignment of the uniform.default_value in the multiple cases.\n\nSome scratch paper code provided:\n```cpp\n//starts at line 10224 in Godot\\servers\\rendering\\shader_language.cpp\n//assume indenting is proper. (everything is in the same scope)\nNode *expr = _parse_and_reduce_expression(nullptr, constants);\nif (!expr) {\n\treturn ERR_PARSE_ERROR;\n}\n//if we get here we have a valid node that can be any of the node types\n//to be robust we would want to handle every type case as best we can\n\nswitch(expr->type){\n\t//simple case that is already handled by the code, the simplified expression is a constant (1.0, vec2(1.0), etc.)\n\tcase Node::NODE_TYPE_CONSTANT: {\n\t\tConstantNode *cn = static_cast<ConstantNode *>(expr);\n\t\tuniform.default_value.resize(cn->values.size());\n\t\t\n\t\tif (!convert_constant(cn, uniform.type, uniform.default_value.ptrw())) {\n\t\t\t_set_error(vformat(RTR(\"Can't convert constant to '%s'.\"), get_datatype_name(uniform.type)));\n\t\t\treturn ERR_PARSE_ERROR;\n\t\t}\n\t}break;\n\tcase Node::NODE_TYPE_VARIABLE: {\n\t\t//check scope, if global:\n\t\t\t//take its current value and set that value to the uniform's default value\n\t}break;\n\tcase Node::NODE_TYPE_OPERATOR: {\n\t\t//Evaluate expression (Im unsure why the _parse_and_reduce_expression doesn't reduce operators)\n\t}break;\n\tdefault: {\n\t\t_set_error(RTR(\"Expected constant expression after '='.\"));\n\t\treturn ERR_PARSE_ERROR;\n\t}break;\n}\n//get next token\ntk = _get_token();\n\t\n}\n\n```\n\n\n","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4595199229/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4615775302","html_url":"https://github.com/godotengine/godot/issues/119836#issuecomment-4615775302","issue_url":"https://api.github.com/repos/godotengine/godot/issues/119836","id":4615775302,"node_id":"IC_kwDOA