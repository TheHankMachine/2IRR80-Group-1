/godot/issues/comments/4029613042/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4030553365","html_url":"https://github.com/godotengine/godot/pull/117268#issuecomment-4030553365","issue_url":"https://api.github.com/repos/godotengine/godot/issues/117268","id":4030553365,"node_id":"IC_kwDOAO6SJc7wPV0V","user":{"login":"mihe","id":4884246,"node_id":"MDQ6VXNlcjQ4ODQyNDY=","avatar_url":"https://avatars.githubusercontent.com/u/4884246?v=4","gravatar_id":"","url":"https://api.github.com/users/mihe","html_url":"https://github.com/mihe","followers_url":"https://api.github.com/users/mihe/followers","following_url":"https://api.github.com/users/mihe/following{/other_user}","gists_url":"https://api.github.com/users/mihe/gists{/gist_id}","starred_url":"https://api.github.com/users/mihe/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/mihe/subscriptions","organizations_url":"https://api.github.com/users/mihe/orgs","repos_url":"https://api.github.com/users/mihe/repos","events_url":"https://api.github.com/users/mihe/events{/privacy}","received_events_url":"https://api.github.com/users/mihe/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-03-10T11:01:22Z","updated_at":"2026-03-10T11:47:52Z","body":"> The same code is found in `servers/physics_2d/physics_server_2d_wrap_mt.h` so this change currently would only affect 3D, is that expected?\r\n\r\nNo, you're absolutely right, that should be changed there as well, my bad. I was too fixated on the issues at hand.\r\n\r\n> For the record the rendering server has the same macros, but there none check for main thread, so I guess it doesn't need to be changed.\r\n\r\nThe rendering server does not need to be changed, no. The `ASYNC_COND_*` macros were introduced by me in #109591 specifically to allow the physics servers to diverge in this way. In fact, they could probably be collapsed into a single macro now that all three are the same, but I didn't want to make this change any messier than it has to be.","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4030553365/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4037336872","html_url":"https://github.com/godotengine/godot/pull/117268#issuecomment-4037336872","issue_url":"https://api.github.com/repos/godotengine/godot/issues/117268","id":4037336872,"node_id":"IC_kwDOAO6SJc7wpN8o","user":{"login":"akien-mga","id":4701338,"node_id":"MDQ6VXNlcjQ3MDEzMzg=","avatar_url":"https://avatars.githubusercontent.com/u/4701338?v=4","gravatar_id":"","url":"https://api.github.com/users/akien-mga","html_url":"https://github.com/akien-mga","followers_url":"https://api.github.com/users/akien-mga/followers","following_url":"https://api.github.com/users/akien-mga/following{/other_user}","gists_url":"https://api.github.com/users/akien-mga/gists{/gist_id}","starred_url":"https://api.github.com/users/akien-mga/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/akien-mga/subscriptions","organizations_url":"https://api.github.com/users/akien-mga/orgs","repos_url":"https://api.github.com/users/akien-mga/repos","events_url":"https://api.github.com/users/akien-mga/events{/privacy}","received_events_url":"https://api.github.com/users/akien-mga/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-03-11T08:17:06Z","updated_at":"2026-03-11T08:17:06Z","body":"> In fact, they could probably be collapsed into a single macro now that all three are the same, but I didn't want to make this change any messier than it has to be.\r\n\r\nWell they're not all the same in the end, the rendering ones don't check for main thread. And keeping them separate is probably best to avoid adding coupling to a common header.","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4037336872/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4037345652","html_url":"https://github.com/godotengine/godot/pull/117268#issuecomment-4037345652","issue_url":"https://api.github.com/repos/godotengine/godot/issues/117268","id":4037345652,"node_id":"IC_kwDOAO6SJc7wpQF0","user":{"login":"akien-mga","id":4701338,"node_id":"MDQ6VXNlcjQ3MDEzMzg=","avatar_url":"https://avatars.githubusercontent.com/u/4701338?v=4","gravatar_id":"","url":"https://api.github.com/users/akien-mga","html_url":"https://github.com/akien-mga","followers_url":"https://api.github.com/users/akien-mga/followers","following_url":"https://api.github.com/users/akien-mga/following{/other_user}","gists_url":"https://api.github.com/users/akien-mga/gists{/gist_id}","starred_url":"https://api.github.com/users/akien-mga/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/akien-mga/subscriptions","organizations_url":"https://api.github.com/users/akien-mga/orgs","repos_url":"https://api.github.com/users/akien-mga/repos","events_url":"https://api.github.com/users/akien-mga/events{/privacy}","received_events_url":"https://api.github.com/users/akien-mga/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-03-11T08:18:45Z","updated_at":"2026-03-11T08:18:45Z","body":"Before merging, I think it would be helpful to quantify roughly what kind of performance downgrade we're expecting for projects which were relying on `physics/*d/run_on_separate_thread`.\r\nI don't know if we have an open source project/demo around that uses it where it makes a significant difference?","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4037345652/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4040639172","html_url":"https://github.com/godotengine/godot/pull/117268#issuecomment-4040639172","issue_url":"https://api.github.com/repos/godotengine/godot/issues/117268","id":4040639172,"node_id":"IC_kwDOAO6SJc7w10LE","user":{"login":"mihe","id":4884246,"node_id":"MDQ6VXNlcjQ4ODQyNDY=","avatar_url":"https://avatars.githubusercontent.com/u/4884246?v=4","gravatar_id":"","url":"https://api.github.com/users/mihe","html_url":"https://github.com/mihe","followers_url":"https://api.github.com/users/mihe/followers","following_url":"https://api.github.com/users/mihe/following{/other_user}","gists_url":"https://api.github.com/users/mihe/gists{/gist_id}","starred_url":"https://api.github.com/users/mihe/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/mihe/subscriptions","organizations_url":"https://api.github.com/users/mihe/orgs","repos_url":"https://api.github.com/users/mihe/repos","events_url":"https://api.github.com/users/mihe/events{/privacy}","received_events_url":"https://api.github.com/users/mihe/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-03-11T16:52:39Z","updated_at":"2026-03-11T17:01:13Z","body":"> Well they're not all the same in the end, the rendering ones don't check for main thread.\r\n\r\nYeah, no, I meant that `ASYNC_COND_PUSH`, `ASYNC_COND_PUSH_AND_RET` and `ASYNC_COND_PUSH_AND_SYNC` could be collapsed into an `ASYNC_COND` macro instead. There's no reason for them to be distinct anymore. It wouldn't really change anything though.\r\n\r\n> I don't know if we have an open source project/demo around that uses it where it makes a significant difference?\r\n\r\nI can't think of any off the top of my head that would be applicable here, but here's a somewhat contrived MRP for a scenario where this ends up costing you quite a bit, where you have a lot of expensive shape changes happening in a single physics frame: [many-expensive-shape-changes.zip](https://github.com/user-attachments/files/25909807/many-expensive-shape-changes.zip)\r\n\r\nThese are the physics processing numbers I'm seeing on my machine, when using Jolt Physics[^1]:\r\n\r\n- **Without** this change and `run_on_separate_thread` **disabled**: 10 ms\r\n- **Without** this change and `run_on_separate_thread` **enabled**: 4 ms\r\n- **With** this change and `run_on_separate_thread` **disabled**: 10 ms\r\n- **With** this change and `run_on_separate_thread` **enabled**: 10 ms\r\n\r\nThe numbers with #116897 would instead be 4 ms with or without that change, but as soon as you add a `RayCast3D` anywhere in the scene tree (or do any other physics query) it would instead become 10 ms. In my mind at least, this kind of performance volatility seemed worse than the option of just relegating everything but the simulation step to always run on the main thread.\r\n\r\n---\r\n\r\nConversely, here's an MRP with a bunch of simulated/dynamic bodies instead, where you have no server commands being queued up, but with an expensive step of the simulation instead, which I would probably argue is what the majority of projects hope to escape from when they enable `run_on_separate_thread`: [many-simulated-bodies.zip](https://github.com/user-attachments/files/25912549/many-simulated-bodies.zip)\r\n\r\nThese are the physics processing numbers I'm seeing on my machine, when using Jolt Physics:\r\n\r\n- **Without** this change and `run_on_separate_thread` **disabled**: 5.5 ms\r\n- **Without** this change and `run_on_separate_thread` **enabled**: 2.3 ms\r\n- **With** this change and `run_on_separate_thread` **disabled**: 5.5 ms\r\n- **With** this change and `run_on_separate_thread` **enabled**: 2.3 ms\r\n\r\n[^1]: Godot Physics does a lot better in this particular MRP, by virtue of shape changes not being nearly as expensive.","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4040639172/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4289128792","html_url":"https://github.com/godotengine/godot/pull/117268#issuecomment-4289128792","issue_url":"https://api.github.com/repos/godotengine/godot/issues/117268","id":4289128792,"node_id":"IC_kwDOAO6SJc7_pulY","user":{"login":"Repiteo","id":17489292,"node_id":"MDQ6VXNlcjE3NDg5Mjky","avatar_url":"https://avatars.githubusercontent.com/u/17489292?v=4","gravatar_id":"","url":"https://api.github.com/users/Repiteo","html_url":"https://github.com/Repiteo","followers_url":"https://api.github.com/users/Repiteo/followers","following_url":"https://api.github.com/users/Repiteo/following{/other_user}","gists_url":"https://api.github.com/users/Repiteo/gists{/gist_id}","starred_url":"https://api.github.com/users/Repiteo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Repiteo/subscriptions","organizations_url":"https://api.github.com/users/Repiteo/orgs","repos_url":"https://api.github.com/users/Repiteo/repos","events_url":"https://api.github.com/users/Repiteo/events{/privacy}","received_events_url":"https://api.github.com/users/Repiteo/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-04-21T14:00:20Z","updated_at":"2026-04-21T14:00:20Z","body":"Thanks!","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4289128792/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5080011347","html_url":"https://github.com/godotengine/godot/pull/117268#issuecomment-5080011347","issue_url":"https://api.github.com/repos/godotengine/godot/issues/117268","id":5080011347,"node_id":"IC_kwDOAO6SJc8AAAABLsrSUw","user":{"login":"Repiteo","id":17489292,"node_id":"MDQ6VXNlcjE3NDg5Mjky","avatar_url":"https://avatars.githubusercontent.com/u/17489292?v=4","gravatar_id":"","url":"https://api.github.com/users/Repiteo","html_url":"https://github.com/Repiteo","followers_url":"https://api.github.com/users/Repiteo/followers","following_url":"https://api.github.com/users/Repiteo/following{/other_user}","gists_url":"https://api.github.com/users/Repiteo/gists{/gist_id}","starred_url":"https://api.github.com/users/Repiteo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Repiteo/subscriptions","organizations_url":"https://api.github.com/users/Repiteo/orgs","repos_url":"https://api.github.com/users/Repiteo/repos","events_url":"https://api.github.com/users/Repiteo/events{/privacy}","received_events_url":"https://api.github.com/users/Repiteo/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-07-25T18:37:01Z","updated_at":"2026-07-25T18:37:01Z","body":"Cherry-picked for 4.6.4.","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5080011347/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null}]