ub.com/users/ominousllama/following{/other_user}","gists_url":"https://api.github.com/users/ominousllama/gists{/gist_id}","starred_url":"https://api.github.com/users/ominousllama/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/ominousllama/subscriptions","organizations_url":"https://api.github.com/users/ominousllama/orgs","repos_url":"https://api.github.com/users/ominousllama/repos","events_url":"https://api.github.com/users/ominousllama/events{/privacy}","received_events_url":"https://api.github.com/users/ominousllama/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-08-06T10:25:00Z","updated_at":"2026-08-06T10:25:00Z","body":"Maybe renaming a resource triggers a reimport of that resource in Godot -> that might send work to GPU that then triggers the panic. Maybe try renaming a few different resource types (does it happen with renaming directories and scene files too or just textures like the icon?).\n\nEither way, a userspace app shouldnt be able to panic the kernel afaik, so Id still report it to Apple.\n\nCould you also try launching with `--rendering-driver vulkan` to use MoltenVK instead of Metal backend, and separately with the Mobile renderer?","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5203398246/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5212127255","html_url":"https://github.com/godotengine/godot/issues/122111#issuecomment-5212127255","issue_url":"https://api.github.com/repos/godotengine/godot/issues/122111","id":5212127255,"node_id":"IC_kwDOAO6SJc8AAAABNqrAFw","user":{"login":"mr-dreich","id":23221964,"node_id":"MDQ6VXNlcjIzMjIxOTY0","avatar_url":"https://avatars.githubusercontent.com/u/23221964?v=4","gravatar_id":"","url":"https://api.github.com/users/mr-dreich","html_url":"https://github.com/mr-dreich","followers_url":"https://api.github.com/users/mr-dreich/followers","following_url":"https://api.github.com/users/mr-dreich/following{/other_user}","gists_url":"https://api.github.com/users/mr-dreich/gists{/gist_id}","starred_url":"https://api.github.com/users/mr-dreich/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/mr-dreich/subscriptions","organizations_url":"https://api.github.com/users/mr-dreich/orgs","repos_url":"https://api.github.com/users/mr-dreich/repos","events_url":"https://api.github.com/users/mr-dreich/events{/privacy}","received_events_url":"https://api.github.com/users/mr-dreich/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-08-07T03:51:16Z","updated_at":"2026-08-07T04:28:59Z","body":"@ominousllama I have tried using terminal and same result - oddly enough, if I unplug my 2nd monitor and only use the laptop it works just fine. I also tried not using my dock and just plugging my monitor straight into the machine - same issue.\n\nBut I also did find out something strange; if I rename a file called node2d.tscn the black bars don't appear. But if I rename an image file like icon.svg they do and they only appear when the popup that quickly shows the progress appears.\n\nI would normally write this off as my machine acting up, but I only have this issue with Godot and only when using Forward/Mobile Renderer. I can play games and do other machine intensive tasks without issue, it feels like some weird video driver issue that metal has with dual monitors and since Godot wants to use the GPU it takes issue with that.\n\n@bruvzg @ominousllama  I went all the way back to 4.3 and the black bars don't appear when renaming or moving files, both the forward and mobile renderer work fine.","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5212127255/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5213748617","html_url":"https://github.com/godotengine/godot/issues/122111#issuecomment-5213748617","issue_url":"https://api.github.com/repos/godotengine/godot/issues/122111","id":5213748617,"node_id":"IC_kwDOAO6SJc8AAAABNsN9iQ","user":{"login":"ominousllama","id":149961466,"node_id":"U_kgDOCPA6-g","avatar_url":"https://avatars.githubusercontent.com/u/149961466?v=4","gravatar_id":"","url":"https://api.github.com/users/ominousllama","html_url":"https://github.com/ominousllama","followers_url":"https://api.github.com/users/ominousllama/followers","following_url":"https://api.github.com/users/ominousllama/following{/other_user}","gists_url":"https://api.github.com/users/ominousllama/gists{/gist_id}","starred_url":"https://api.github.com/users/ominousllama/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/ominousllama/subscriptions","organizations_url":"https://api.github.com/users/ominousllama/orgs","repos_url":"https://api.github.com/users/ominousllama/repos","events_url":"https://api.github.com/users/ominousllama/events{/privacy}","received_events_url":"https://api.github.com/users/ominousllama/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-08-07T07:12:01Z","updated_at":"2026-08-07T07:12:01Z","body":"Thanks for testing even back to 4.3. I'll take a look at the changes made since then, maybe I can dig something up that could be cause of this.\n\nIn meantime, can you also try enabling \"Single Window Mode\" in Editor Settings? Helps me narrow it down if the problem is related to the import logic or the import popup window creation.","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5213748617/reac