ent.com/u/136735040?v=4","gravatar_id":"","url":"https://api.github.com/users/Infini-Creation","html_url":"https://github.com/Infini-Creation","followers_url":"https://api.github.com/users/Infini-Creation/followers","following_url":"https://api.github.com/users/Infini-Creation/following{/other_user}","gists_url":"https://api.github.com/users/Infini-Creation/gists{/gist_id}","starred_url":"https://api.github.com/users/Infini-Creation/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Infini-Creation/subscriptions","organizations_url":"https://api.github.com/users/Infini-Creation/orgs","repos_url":"https://api.github.com/users/Infini-Creation/repos","events_url":"https://api.github.com/users/Infini-Creation/events{/privacy}","received_events_url":"https://api.github.com/users/Infini-Creation/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-02-25T21:52:35Z","updated_at":"2025-02-25T21:52:35Z","body":"Unfortunately #102922 didn't actually address the user part of the issue which is most of this issue.\n\nConversion allegedly works but the user sees nothing at all, after asked for conversion.\nRelying on the console alone is very bad from user's point of view.\n\nFor the project used as test subject, I've got this in console **ONLY**:\n\n> Starting conversion.\nTrying to convert       1/4 file - \"default_env.tres\" with size - 0 KB\n    File was changed, conversion took 0 ms.\nTrying to convert       2/4 file - \"project.godot\" with size - 0 KB\n    File was changed, conversion took 0 ms.\nTrying to convert       3/4 file - \"test_noise.gd\" with size - 4 KB\n    File was changed, conversion took 9 ms.\nTrying to convert       4/4 file - \"test_noise.tscn\" with size - 4668 KB\n    Checking file took 0 ms.\n    **ERROR: File has exceeded the maximum size allowed - 4096 KB**\nConversion ended - all files(4), converted files: (3), not converted files: (1).\nConversion of all files took      0.514 seconds.\n\nBy the way, a hard-coded limit to such a quite \"small\" size is not very great (this scene is big because the author had the bad idea to include a texture inside it), especially it will lead to a failed/aborted conversion.\n\nReopening/importing the project again works more or less with a few issues irrelevant here.\n\nIt would be better to add just another sub window with the result of the conversion as displayed in the console, at least OR a text area similar to the standard output area of the editor at the bottom of the conversion window with all the output.","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2683378666/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2683390818","html_url":"https://github.com/godotengine/godot/issues/102050#issuecomment-2683390818","issue_url":"https://api.github.com/repos/godotengine/godot/issues/102050","id":2683390818,"node_id":"IC_kwDOAO6SJc6f8Uti","user":{"login":"KoBeWi","id":2223172,"node_id":"MDQ6VXNlcjIyMjMxNzI=","avatar_url":"https://avatars.githubusercontent.com/u/2223172?v=4","gravatar_id":"","url":"https://api.github.com/users/KoBeWi","html_url":"https://github.com/KoBeWi","followers_url":"https://api.github.com/users/KoBeWi/followers","following_url":"https://api.github.com/users/KoBeWi/following{/other_user}","gists_url":"https://api.github.com/users/KoBeWi/gists{/gist_id}","starred_url":"https://api.github.com/users/KoBeWi/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/KoBeWi/subscriptions","organizations_url":"https://api.github.com/users/KoBeWi/orgs","repos_url":"https://api.github.com/users/KoBeWi/repos","events_url":"https://api.github.com/users/KoBeWi/events{/privacy}","received_events_url":"https://api.github.com/users/KoBeWi/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-02-25T22:00:01Z","updated_at":"2025-02-25T22:00:01Z","body":"I think the user part deserves a new issue. The converter is working, poor feedback is *technically* not a bug. Not sure how feasible it is to implement; we could easily display converter's output, but not the errors that appear in the console.","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2683390818/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2684788905","html_url":"https://github.com/godotengine/godot/issues/102050#issuecomment-2684788905","issue_url":"https://api.github.com/repos/godotengine/godot/issues/102050","id":2684788905,"node_id":"IC_kwDOAO6SJc6gBqCp","user":{"login":"Infini-Creation","id":136735040,"node_id":"U_kgDOCCZpQA","avatar_url":"https://avatars.githubusercontent.com/u/136735040?v=4","gravatar_id":"","url":"https://api.github.com/users/Infini-Creation","html_url":"https://github.com/Infini-Creation","followers_url":"https://api.github.com/users/Infini-Creation/followers","following_url":"https://api.github.com/users/Infini-Creation/following{/other_user}","gists_url":"https://api.github.com/users/Infini-Creation/gists{/gist_id}","starred_url":"https://api.github.com/users/Infini-Creation/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Infini-Creation/subscriptions","organizations_url":"https://api.github.com/users/Infini-Creation/orgs","repos_url":"https://api.github.com/users/Infini-Creation/repos","events_url":"https://api.github.com/users/Infini-Creation/events{/privacy}","received_events_url":"https://api.github.com/users/Infini-Creation/received_events","type":"User","user_view_type":"public","site_admin":fa