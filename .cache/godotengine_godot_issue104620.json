ved_by":null},{"id":279098219,"node_id":"MDU6TGFiZWwyNzkwOTgyMTk=","url":"https://api.github.com/repos/godotengine/godot/labels/topic:editor","name":"topic:editor","color":"ffee88","default":false,"description":"","archived_at":null,"archived_by":null}],"state":"open","locked":false,"assignees":[],"milestone":null,"comments":1,"created_at":"2025-03-25T18:33:44Z","updated_at":"2025-03-25T18:51:50Z","closed_at":null,"assignee":null,"author_association":"CONTRIBUTOR","issue_field_values":[],"type":null,"active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"### Tested versions\n\n4.4.stable\n\n### System information\n\nWindows 11\n\n### Issue description\n\nWhen extending a script by UID the export variables of the extended script are omitted in the inspector:\n\n![Image](https://github.com/user-attachments/assets/634a4cd9-d584-482b-b0d1-8dda41524c39)\n\nIt works if you use the script path instead:\n\n![Image](https://github.com/user-attachments/assets/67123850-1e83-4599-999b-6e5c77b9d851)\n\n### Steps to reproduce\n\n1) Create \"Base_Script.gd\" and create an export variable\n2) Create \"Script.gd\" that extends from \"Base_Script.gd\" using the UID\n3) Attach \"Script.gd\" to any node in a scene\n4) The export variable won't be visible in the inspector\n\n### Minimal reproduction project (MRP)\n\n[Extend_By_UID_Export.zip](https://github.com/user-attachments/files/19454486/Extend_By_UID_Export.zip)","closed_by":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/104620/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/godotengine/godot/issues/104620/timeline","performed_via_github_app":null,"state_reason":null,"pinned_comment":null}