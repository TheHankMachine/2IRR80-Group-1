ive_lock_reason":null,"draft":false,"pull_request":{"url":"https://api.github.com/repos/godotengine/godot/pulls/98431","html_url":"https://github.com/godotengine/godot/pull/98431","diff_url":"https://github.com/godotengine/godot/pull/98431.diff","patch_url":"https://github.com/godotengine/godot/pull/98431.patch","merged_at":"2024-10-24T18:29:28Z"},"body":"<!--\r\nPlease target the `master` branch in priority.\r\n\r\nRelevant fixes are cherry-picked for stable branches as needed by maintainers.\r\n\r\nTo speed up the contribution process and avoid CI errors, please set up pre-commit hooks locally:\r\nhttps://docs.godotengine.org/en/latest/contributing/development/code_style_guidelines.html\r\n-->\r\n\r\nFixes #76825 \r\n\r\nThe [spec says that `body` can be `null`](https://fetch.spec.whatwg.org/#body-mixin) [for fetch responses](https://fetch.spec.whatwg.org/#responses) (in the event of requests that should have no body, like HEAD requests) and Firefox adheres to it which results in request failure for HEAD requests on Firefox for web exports.\r\n\r\nThis fix addresses that by treating a `null` body as an \"empty\" body (without using a polyfill) and avoids changing the request lifecycle as much as possible.\r\n\r\nMinimal reproduction project: [mrp-gh76825.zip](https://github.com/user-attachments/files/17481158/mrp-gh76825.zip)\r\n","closed_by":{"login":"Repiteo","id":17489292,"node_id":"MDQ6VXNlcjE3NDg5Mjky","avatar_url":"https://avatars.githubusercontent.com/u/17489292?v=4","gravatar_id":"","url":"https://api.github.com/users/Repiteo","html_url":"https://github.com/Repiteo","followers_url":"https://api.github.com/users/Repiteo/followers","following_url":"https://api.github.com/users/Repiteo/following{/other_user}","gists_url":"https://api.github.com/users/Repiteo/gists{/gist_id}","starred_url":"https://api.github.com/users/Repiteo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Repiteo/subscriptions","organizations_url":"https://api.github.com/users/Repiteo/orgs","repos_url":"https://api.github.com/users/Repiteo/repos","events_url":"https://api.github.com/users/Repiteo/events{/privacy}","received_events_url":"https://api.github.com/users/Repiteo/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/98431/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/godotengine/godot/issues/98431/timeline","performed_via_github_app":null,"state_reason":null}