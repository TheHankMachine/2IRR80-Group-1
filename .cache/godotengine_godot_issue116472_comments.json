.github.com/users/NormPlum/orgs","repos_url":"https://api.github.com/users/NormPlum/repos","events_url":"https://api.github.com/users/NormPlum/events{/privacy}","received_events_url":"https://api.github.com/users/NormPlum/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-02-19T11:55:46Z","updated_at":"2026-02-19T11:55:46Z","body":"What if you try to put `global.gd` first?\n\nIn my case, `test.gd` is always put first, so it's not surprising to see that happen in your screencast...","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3926789690/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3926976465","html_url":"https://github.com/godotengine/godot/issues/116472#issuecomment-3926976465","issue_url":"https://api.github.com/repos/godotengine/godot/issues/116472","id":3926976465,"node_id":"IC_kwDOAO6SJc7qEOfR","user":{"login":"Rindbee","id":30386067,"node_id":"MDQ6VXNlcjMwMzg2MDY3","avatar_url":"https://avatars.githubusercontent.com/u/30386067?v=4","gravatar_id":"","url":"https://api.github.com/users/Rindbee","html_url":"https://github.com/Rindbee","followers_url":"https://api.github.com/users/Rindbee/followers","following_url":"https://api.github.com/users/Rindbee/following{/other_user}","gists_url":"https://api.github.com/users/Rindbee/gists{/gist_id}","starred_url":"https://api.github.com/users/Rindbee/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Rindbee/subscriptions","organizations_url":"https://api.github.com/users/Rindbee/orgs","repos_url":"https://api.github.com/users/Rindbee/repos","events_url":"https://api.github.com/users/Rindbee/events{/privacy}","received_events_url":"https://api.github.com/users/Rindbee/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-02-19T12:30:28Z","updated_at":"2026-02-19T12:30:28Z","body":"1. Please check the script order in the `open_scripts` list of the `[ScriptEditor]` section of the `.godot/editor/editor_layout.cfg` file.  \n2. Please save the scene after changing the order.\n3. Repeat step 1.\n\n```cfg\n[ScriptEditor]\n\nopen_scripts=[\"res://test.gd\", \"res://global.gd\"] # Same as the display order.\n```","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3926976465/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3929890217","html_url":"https://github.com/godotengine/godot/issues/116472#issuecomment-3929890217","issue_url":"https://api.github.com/repos/godotengine/godot/issues/116472","id":3929890217,"node_id":"IC_kwDOAO6SJc7qPV2p","user":{"login":"NormPlum","id":162703454,"node_id":"U_kgDOCbKoXg","avatar_url":"https://avatars.githubusercontent.com/u/162703454?v=4","gravatar_id":"","url":"https://api.github.com/users/NormPlum","html_url":"https://github.com/NormPlum","followers_url":"https://api.github.com/users/NormPlum/followers","following_url":"https://api.github.com/users/NormPlum/following{/other_user}","gists_url":"https://api.github.com/users/NormPlum/gists{/gist_id}","starred_url":"https://api.github.com/users/NormPlum/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/NormPlum/subscriptions","organizations_url":"https://api.github.com/users/NormPlum/orgs","repos_url":"https://api.github.com/users/NormPlum/repos","events_url":"https://api.github.com/users/NormPlum/events{/privacy}","received_events_url":"https://api.github.com/users/NormPlum/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-02-19T20:46:30Z","updated_at":"2026-02-19T20:46:30Z","body":"- With Godot closed, the script order in `editor_layout.cfg` is: `open_scripts=[\"res://test.gd\", \"res://global.gd\"]`\n- I manually change it to `open_scripts=[\"res://global.gd\", \"res://test.gd\"]` and save `editor_layout.cfg`\n- I open Godot and the order in the editor is `test.gd` above `global.gd`\n- My text editor says `editor_layout.cfg` has changed. When I reload `editor_layout.cfg` in my text editor the order is back to `open_scripts=[\"res://test.gd\", \"res://global.gd\"]`\n- In Godot, I drag `global.gd` above `test.gd` and save.\n- The text editor again says the file has changed, and when I reload `editor_layout.cfg` it's now showing `open_scripts=[\"res://global.gd\", \"res://test.gd\"]`\n- When I reload the project in Godot, the order of the scripts is back to `test.gd` above `global.gd`, and `editor_layout.cfg` again shows `open_scripts=[\"res://test.gd\", \"res://global.gd\"]`","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3929890217/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3930371946","html_url":"https://github.com/godotengine/godot/issues/116472#issuecomment-3930371946","issue_url":"https://api.github.com/repos/godotengine/godot/issues/116472","id":3930371946,"node_id":"IC_kwDOAO6SJc7qRLdq","user":{"login":"kitbdev","id":10054226,"node_id":"MDQ6VXNlcjEwMDU0MjI2","avatar_url":"https://avatars.githubusercontent.com/u/10054226?v=4","gravatar_id":"","url":"https://api.github.com/users/kitbdev","html_url":"https://github.com/kitbdev","followers_url":"https://api.github.com/users/kitbdev/followers","following_url":"https://api.github.com/users/kitbdev/following{/other_user}","gists_url":"https://api.github.com/users/kitbdev/gists{/gist_id}","starred_url":"https://api.github.com/users/kitbdev/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/kitbdev/subscriptions","organizations_url":"https://api.github.com/users/kitbdev/orgs","repos_url":"https://api.github.com/users/kitbdev/repos","events_url":"https://api.github.com/users/kitbdev/events{/privacy}","received_events_url":"https://api.github.com/users/kitbdev/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-02-19T21:59:41Z","updated_at":"2026-02-19T21:59:41Z","body":"Is `text_editor/behavior/files/open_dominant_script_on_scene_change` set to true? \nI can only reproduce with it set and the scene open. I think this setting is making the connected script open first before the rest of the scripts are opened, so it effectively moves the dominant script to the top on reload.\nAlso saving should happen automatically when closing.","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3930371946/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3930568612","html_url":"https://github.com/godotengine/godot/issues/116472#issuecomment-3930568612","issue_url":"https://api.github.com/repos/godotengine/godot/issues/116472","id":3930568612,"node_id":"IC_kwDOAO6SJc7qR7ek","user":{"login":"NormPlum","id":162703454,"node_id":"U_kgDOCbKoXg","avatar_url":"https://avatars.githubusercontent.com/u/162703454?v=4","gravatar_id":"","url":"https://api.github.com/users/NormPlum","html_url":"https://github.com/NormPlum","followers_url":"https://api.github.com/users/NormPlum/followers","following_url":"https://api.github.com/users/NormPlum/following{/other_user}","gists_url":"https://api.github.com/users/NormPlum/gists{/gist_id}","starred_url":"https://api.github.com/users/NormPlum/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/NormPlum/subscriptions","organizations_url":"https://api.github.com/users/NormPlum/orgs","repos_url":"https://api.github.com/users/NormPlum/repos","events_url":"https://api.github.com/users/NormPlum/events{/privacy}","received_events_url":"https://api.github.com/users/NormPlum/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-02-19T22:43:11Z","updated_at":"2026-02-19T22:43:11Z","body":"> Is text_editor/behavior/files/open_dominant_script_on_scene_change set to true?\n\nIt was, and disabling it fixed the problem! Thank you.\n\nTo avoid others having the same problem, can I suggest adding a note to the help text for the \"Sort Scripts By\" setting that points to the \"Open Dominant Script On Scene Change\" setting? As that latter setting seems to override the way the former works...\n\n>  Also saving should happen automatically when closing.\n\nI suspected that was the case...","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3930568612/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3930695225","html_url":"https://github.com/godotengine/godot/issues/116472#issuecomment-3930695225","issue_url":"https://api.github.com/repos/godotengine/godot/issues/116472","id":3930695225,"node_id":"IC_kwDOAO6SJc7qSaY5","user":{"login":"Rindbee","id":30386067,"node_id":"MDQ6VXNlcjMwMzg2MDY3","avatar_url":"https://avatars.githubusercontent.com/u/30386067?v=4","gravatar_id":"","url":"https://api.github.com/users/Rindbee","html_url":"https://github.com/Rindbee","followers_url":"https://api.github.com/users/Rindbee/followers","following_url":"https://api.github.com/users/Rindbee/following{/other_user}"