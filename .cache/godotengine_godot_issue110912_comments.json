[{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3336070251","html_url":"https://github.com/godotengine/godot/pull/110912#issuecomment-3336070251","issue_url":"https://api.github.com/repos/godotengine/godot/issues/110912","id":3336070251,"node_id":"IC_kwDOAO6SJc7G2GRr","user":{"login":"Ivorforce","id":2308167,"node_id":"MDQ6VXNlcjIzMDgxNjc=","avatar_url":"https://avatars.githubusercontent.com/u/2308167?v=4","gravatar_id":"","url":"https://api.github.com/users/Ivorforce","html_url":"https://github.com/Ivorforce","followers_url":"https://api.github.com/users/Ivorforce/followers","following_url":"https://api.github.com/users/Ivorforce/following{/other_user}","gists_url":"https://api.github.com/users/Ivorforce/gists{/gist_id}","starred_url":"https://api.github.com/users/Ivorforce/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Ivorforce/subscriptions","organizations_url":"https://api.github.com/users/Ivorforce/orgs","repos_url":"https://api.github.com/users/Ivorforce/repos","events_url":"https://api.github.com/users/Ivorforce/events{/privacy}","received_events_url":"https://api.github.com/users/Ivorforce/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-09-25T21:59:07Z","updated_at":"2025-09-25T21:59:07Z","body":"> Change the copy constructor of all container types to explicit (except Vector).\r\n\r\nI'm not seeing this change, did you push this?","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3336070251/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3336075948","html_url":"https://github.com/godotengine/godot/pull/110912#issuecomment-3336075948","issue_url":"https://api.github.com/repos/godotengine/godot/issues/110912","id":3336075948,"node_id":"IC_kwDOAO6SJc7G2Hqs","user":{"login":"aaronfranke","id":1646875,"node_id":"MDQ6VXNlcjE2NDY4NzU=","avatar_url":"https://avatars.githubusercontent.com/u/1646875?v=4","gravatar_id":"","url":"https://api.github.com/users/aaronfranke","html_url":"https://github.com/aaronfranke","followers_url":"https://api.github.com/users/aaronfranke/followers","following_url":"https://api.github.com/users/aaronfranke/following{/other_user}","gists_url":"https://api.github.com/users/aaronfranke/gists{/gist_id}","starred_url":"https://api.github.com/users/aaronfranke/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/aaronfranke/subscriptions","organizations_url":"https://api.github.com/users/aaronfranke/orgs","repos_url":"https://api.github.com/users/aaronfranke/repos","events_url":"https://api.github.com/users/aaronfranke/events{/privacy}","received_events_url":"https://api.github.com/users/aaronfranke/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-09-25T22:02:07Z","updated_at":"2025-09-25T22:02:45Z","body":"@Ivorforce No, please see the part of the PR description where I wrote \"and return the copy constructors to normal\". It's a list of things I did in order, not a list of the final changes in the PR, sorry for the confusion.","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3336075948/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3336093950","html_url":"https://github.com/godotengine/godot/pull/110912#issuecomment-3336093950","issue_url":"https://api.github.com/repos/godotengine/godot/issues/110912","id":3336093950,"node_id":"IC_kwDOAO6SJc7G2MD-","user":{"login":"Ivorforce","id":2308167,"node_id":"MDQ6VXNlcjIzMDgxNjc=","avatar_url":"https://avatars.githubuser