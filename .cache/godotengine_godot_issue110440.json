iteo/orgs","repos_url":"https://api.github.com/users/Repiteo/repos","events_url":"https://api.github.com/users/Repiteo/events{/privacy}","received_events_url":"https://api.github.com/users/Repiteo/received_events","type":"User","user_view_type":"public","site_admin":false},"open_issues":3,"closed_issues":2978,"state":"closed","created_at":"2025-05-22T16:25:52Z","updated_at":"2026-10-04T16:23:23Z","due_on":null,"closed_at":"2026-01-26T18:09:14Z"},"comments":0,"created_at":"2025-09-12T03:31:28Z","updated_at":"2025-10-01T18:21:20Z","closed_at":"2025-10-01T18:20:14Z","assignee":{"login":"bruvzg","id":7645683,"node_id":"MDQ6VXNlcjc2NDU2ODM=","avatar_url":"https://avatars.githubusercontent.com/u/7645683?v=4","gravatar_id":"","url":"https://api.github.com/users/bruvzg","html_url":"https://github.com/bruvzg","followers_url":"https://api.github.com/users/bruvzg/followers","following_url":"https://api.github.com/users/bruvzg/following{/other_user}","gists_url":"https://api.github.com/users/bruvzg/gists{/gist_id}","starred_url":"https://api.github.com/users/bruvzg/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/bruvzg/subscriptions","organizations_url":"https://api.github.com/users/bruvzg/orgs","repos_url":"https://api.github.com/users/bruvzg/repos","events_url":"https://api.github.com/users/bruvzg/events{/privacy}","received_events_url":"https://api.github.com/users/bruvzg/received_events","type":"User","user_view_type":"public","site_admin":false},"author_association":"NONE","issue_field_values":[],"type":null,"active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"### Tested versions\n\nGodot 4.4.1 Stable\n\n### System information\n\nMacOS 15.6.1 | M4 Pro MacBook Pro 24GB \n\n### Issue description\n\nI kept getting an error when working on a scene with several RichTextLabels:\n\n**ERROR: scene/gui/rich_text_label.cpp:4139 - Parameter \"current->parent\" is null.**\n\nI did some debugging and found out the problem line was `[outline_size=0]`. When I changed it to `[outline_size=1]` the error goes away.\n\nIf this isn't a bug then maybe the documentation needs to be updated. Since in the Inspector I can set the Font Outline Size to 0, I'd assume the same would be true in BBCode. I should also add that `[outline_size=0]` does work, but it spawns the error as well.\n\nFor full documentation purposes, this is the error in the debugger when I run the scene with `[outline_size=0]`:\n\n```\nE 0:00:00:915   pop: Parameter \"current->parent\" is null.\n  <C++ Source>  scene/gui/rich_text_label.cpp:4139 @ pop()\n```\n\nSeems mildly similar to [this issue](https://github.com/godotengine/godot/issues/84243).\n\n### Steps to reproduce\n\n1. Add a RichTextLabel to a Scene\n2. Enable BBCode\n3. Add the line: `[outline_size=0][/outline_size]`\n\n### Minimal reproduction project (MRP)\n\n[error-project.zip](https://github.com/user-attachments/files/22289030/error-project.zip)","closed_by":{"login":"Repiteo","id":17489292,"node_id":"MDQ6VXNlcjE3NDg5Mjky","avatar_url":"https://avatars.githubusercontent.com/u/17489292?v=4","gravatar_id":"","url":"https://api.github.com/users/Repiteo","html_url":"https://github.com/Repiteo","followers_url":"https://api.github.com/users/Repiteo/followers","following_url":"https://api.github.com/users/Repiteo/following{/other_user}","gists_url":"https://api.github.com/users/Repiteo/gists{/gist_id}","starred_url":"https://api.github.com/users/Repiteo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Repiteo/subscriptions","organizations_url":"https://api.github.com/users/Repiteo/orgs","repos_url":"https://api.github.com/users/Repiteo/repos","events_url":"https://api.github.com/users/Repiteo/events{/privacy}","received_events_url":"https://api.github.com/users/Repiteo/received_events","type":"User","user_view_type":"public","site_admi