b.com/users/blueskythlikesclouds/events{/privacy}","received_events_url":"https://api.github.com/users/blueskythlikesclouds/received_events","type":"User","user_view_type":"public","site_admin":false}],"milestone":{"url":"https://api.github.com/repos/godotengine/godot/milestones/24","html_url":"https://github.com/godotengine/godot/milestone/24","labels_url":"https://api.github.com/repos/godotengine/godot/milestones/24/labels","id":14236899,"node_id":"MI_kwDOAO6SJc4A2Tzj","number":24,"title":"4.7","description":"","creator":{"login":"akien-mga","id":4701338,"node_id":"MDQ6VXNlcjQ3MDEzMzg=","avatar_url":"https://avatars.githubusercontent.com/u/4701338?v=4","gravatar_id":"","url":"https://api.github.com/users/akien-mga","html_url":"https://github.com/akien-mga","followers_url":"https://api.github.com/users/akien-mga/followers","following_url":"https://api.github.com/users/akien-mga/following{/other_user}","gists_url":"https://api.github.com/users/akien-mga/gists{/gist_id}","starred_url":"https://api.github.com/users/akien-mga/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/akien-mga/subscriptions","organizations_url":"https://api.github.com/users/akien-mga/orgs","repos_url":"https://api.github.com/users/akien-mga/repos","events_url":"https://api.github.com/users/akien-mga/events{/privacy}","received_events_url":"https://api.github.com/users/akien-mga/received_events","type":"User","user_view_type":"public","site_admin":false},"open_issues":3,"closed_issues":2535,"state":"closed","created_at":"2025-11-27T20:29:18Z","updated_at":"2026-10-20T18:39:31Z","due_on":null,"closed_at":"2026-06-19T16:54:35Z"},"comments":15,"created_at":"2026-03-02T23:40:59Z","updated_at":"2026-05-25T16:23:28Z","closed_at":"2026-05-25T16:23:28Z","assignee":{"login":"blueskythlikesclouds","id":19259897,"node_id":"MDQ6VXNlcjE5MjU5ODk3","avatar_url":"https://avatars.githubusercontent.com/u/19259897?v=4","gravatar_id":"","url":"https://api.github.com/users/blueskythlikesclouds","html_url":"https://github.com/blueskythlikesclouds","followers_url":"https://api.github.com/users/blueskythlikesclouds/followers","following_url":"https://api.github.com/users/blueskythlikesclouds/following{/other_user}","gists_url":"https://api.github.com/users/blueskythlikesclouds/gists{/gist_id}","starred_url":"https://api.github.com/users/blueskythlikesclouds/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/blueskythlikesclouds/subscriptions","organizations_url":"https://api.github.com/users/blueskythlikesclouds/orgs","repos_url":"https://api.github.com/users/blueskythlikesclouds/repos","events_url":"https://api.github.com/users/blueskythlikesclouds/events{/privacy}","received_events_url":"https://api.github.com/users/blueskythlikesclouds/received_events","type":"User","user_view_type":"public","site_admin":false},"author_association":"CONTRIBUTOR","issue_field_values":[],"type":null,"active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"### Tested versions\n\n- Reproducible in: v4.6.stable.official [89cea1439], v4.6.1.stable.official [14d19694e]\n- Not reproducible in: v4.5.1.stable.official [f62fdbde1]\n\n### System information\n\nDevice: Samsung Galaxy S20 5G (SCG01), Android 12, Snapdragon 865 (Adreno 650)\n\n### Issue description\n\nWhen a `VisualShader` with `vertex_lighting` render mode enabled is used in a scene, the app crashes immediately on startup on certain Android devices. The crash occurs right after the main loop starts, with a `SIGSEGV (SEGV_MAPERR)` at address `0x18` in a worker thread.\n\nThis is a regression — the same project works without issues on Godot 4.5.1. The crash does **not** occur in the Godot editor on desktop; it only happens on the Android device.\n\n**Expected behavior:** The app should launch and render the scene normally on Android, as it did with Godot 4.5.1.\n\n**Actual behavior:** The app crashes on startup with a segmentation fault. The following is observed in logcat:\n\n```\n03-03 08:26:21.540 16534 16587 V Godot   : OnGodotSetupCompleted\n03-03 08:26:21.540 16534 16587 V Godot   : OnGodotMainLoopStarted\n03-03 08:26:21.700 16534 16570 F libc    : Fatal signal 11 (SIGSEGV), code 1 (SEGV_MAPERR), fault addr 0x18 in tid 16570 (WorkerThread 6), pid 16534 (dvertexlighting)\n03-03 08:26:21.740 16609 16609 F crash_dump64: crash_dump.cpp:270] invalid core_num: -1\n03-03 08:26:21.741   734   734 I tombstoned: received crash request for pid 16570\n03-03 08:26:21.741   734   734 E tombstoned: unexpected dump type: kDebuggerdAnyIntercept\n03-03 08:26:21.741   734   734 E tombstoned: failed to get crash output for type kDebuggerdAnyIntercept\n03-03 08:26:21.741 16609 16609 E libc    : failed to read response to DumpRequest packet: No message of desired type\n03-03 08:26:21.742 16609 16609 E crash_dump64: failed to connected to tombstoned to report failure\n03-03 08:26:21.742 16534 16570 F libc    : crash_dump helper failed to exec, or was killed\n```\n\nNo full call stack could be obtained from the tombstone dump.\n\n### Steps to reproduce\n\n1. Open the attached minimal reproduction project in Godot 4.6 or 4.6.1\n2. Export the project for Android (the project is already configured with Mobile renderer and an Android export preset)\n3. Install and launch the app on a Samsung Galaxy S20 5G (or other Adreno 650 device)\n4. Observe that the app crashes immediately after startup\n\n### Minimal reproduction project (MRP)\n\n[android-vertex-lighting-mrp.zip](https://github.com/user-attachments/files/25697934/android-vertex-lighting-mrp.zip)","closed_by":{"login":"Repiteo","id":17489292,"node_id":"MDQ6VXNlcjE3NDg5Mjky","avatar_url":"https://avatars.githubusercontent.com/u/17489292?v=4","gravatar_id":"","url":"https://api.github.com/users/Repiteo","html_url":"https://github.com/Repiteo","followers_url":"https://api.github.com/users/Repiteo/followers","following_url":"https://api.github.com/users/Repiteo/following{/other_user}","gists_url":"https://api.github.com/users/Repiteo/gists{/gist_id}","starred_url":"https://api.github.com/users/Repiteo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Repiteo/subscriptions","organizations_url":"https://api.github.com/users/Repiteo/orgs","repos_url":"https://api.github.com/users/Repiteo/repos","events_url":"https://api.github.com/users/Repiteo/events{/privacy}","received_events_url":"https://api.github.com/users/Repiteo/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/116990/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/godotengine/godot/issues/116990/timeline","performed_via_github_app":null,"state_reason":"completed","pinned_comment":null}