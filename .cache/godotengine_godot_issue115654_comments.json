[{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3826859928","html_url":"https://github.com/godotengine/godot/pull/115654#issuecomment-3826859928","issue_url":"https://api.github.com/repos/godotengine/godot/issues/115654","id":3826859928,"node_id":"IC_kwDOAO6SJc7kGT-Y","user":{"login":"thygrrr","id":8904620,"node_id":"MDQ6VXNlcjg5MDQ2MjA=","avatar_url":"https://avatars.githubusercontent.com/u/8904620?v=4","gravatar_id":"","url":"https://api.github.com/users/thygrrr","html_url":"https://github.com/thygrrr","followers_url":"https://api.github.com/users/thygrrr/followers","following_url":"https://api.github.com/users/thygrrr/following{/other_user}","gists_url":"https://api.github.com/users/thygrrr/gists{/gist_id}","starred_url":"https://api.github.com/users/thygrrr/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/thygrrr/subscriptions","organizations_url":"https://api.github.com/users/thygrrr/orgs","repos_url":"https://api.github.com/users/thygrrr/repos","events_url":"https://api.github.com/users/thygrrr/events{/privacy}","received_events_url":"https://api.github.com/users/thygrrr/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-01-31T00:46:43Z","updated_at":"2026-01-31T00:52:40Z","body":"> Success status codes other than 0 aren't really expected. We expect Godot to be the only one initializing the .NET host and that should only happen once.\r\n\r\nThis is not the case for the libgodot (shared_library) target. In that case, it would totally need to expect these values (usually return code 1), *also for potential* .NET GDextension loading from within a libgodot, with or possibly without GodotSharp.","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3826859928/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":nul