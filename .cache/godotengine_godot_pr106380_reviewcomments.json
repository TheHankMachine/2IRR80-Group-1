odotengine/godot/pulls/106380"}},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/2088086432/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":null,"original_line":87,"side":"RIGHT","author_association":"CONTRIBUTOR","original_position":4,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/2088304157","pull_request_review_id":2839143342,"id":2088304157,"node_id":"PRRC_kwDOAO6SJc58eP4d","diff_hunk":"@@ -84,6 +84,11 @@ def source_paths(files):\n \n env_jpg.Prepend(CPPEXTPATH=[thirdparty_dir + \"/src\"])\n \n+if env[\"arch\"].endswith(\"32\"):","path":"modules/jpg/SCsub","commit_id":"2a89ec5ccd826157931de6aef1cc66a047731572","original_commit_id":"26afca6ba2474d1575b6752953e7aff33c9a3504","user":{"login":"akien-mga","id":4701338,"node_id":"MDQ6VXNlcjQ3MDEzMzg=","avatar_url":"https://avatars.githubusercontent.com/u/4701338?v=4","gravatar_id":"","url":"https://api.github.com/users/akien-mga","html_url":"https://github.com/akien-mga","followers_url":"https://api.github.com/users/akien-mga/followers","following_url":"https://api.github.com/users/akien-mga/following{/other_user}","gists_url":"https://api.github.com/users/akien-mga/gists{/gist_id}","starred_url":"https://api.github.com/users/akien-mga/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/akien-mga/subscriptions","organizations_url":"https://api.github.com/users/akien-mga/orgs","repos_url":"https://api.github.com/users/akien-mga/repos","events_url":"https://api.github.com/users/akien-mga/events{/privacy}","received_events_url":"https://api.github.com/users/akien-mga/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"Hm yeah that's not great.\r\n\r\nI think it would be better to keep this in `jconfigint.h` somehow and ask the pre-processor for what's the size of `size_t`.\r\nBut from a quick look I couldn't find a reliable, portable way to do this, aside from checking arch-specific macros directly.\r\n\r\nI did find `__SIZEOF_SIZE_T__` which seems to be a non-standard GCC/Clang builtin and which works in my tests on Linux, but that's not defined for MSVC.\r\n\r\nSo we'd have to do something like that:\r\n```cpp\r\n#if defined(__SIZEOF_SIZE_T__)\r\n  #define SIZEOF_SIZE_T __SIZEOF_SIZE_T__\r\n#elif defined(_WIN64)\r\n  #define SIZEOF_SIZE_T 8\r\n#elif defined(_WIN32)\r\n  #define SIZEOF_SIZE_T 4\r\n#else\r\n  #error \"Cannot determine size of size_t\"\r\n#endif\r\n```\r\n\r\nNot sure if it's worth it, but that would be possibly more future proof for potential other LLVM-based platforms with alternative architectures.\r\n\r\nOtherwise, hardcoding it here from SCons is also fine, but maybe we should specify the 32-bit architectures explicitly, in case we later add an arch that doesn't end in `32` or `64`.\r\n\r\nSo that would be\r\n```python\r\nif env[\"arch\"] in [\"x86_32\", \"arm32\", \"ppc32\", \"wasm32\"]\r\n```","created_at":"2025-05-14T07:51:26Z","updated_at":"2025-05-14T07:51:26Z","html_url":"https://github.com/godotengine/godot/pull/106380#discussion_r2088304157","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/106380","_links":{"self":{"href":"https://api.github.com/repos/godotengine/godot/pulls/comments/2088304157"},"html":{"href":"https://github.com/godotengine/godot/pull/106380#discussion_r2088304157"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/106380"}},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/2088304157/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":null,"original_line":87,"side":"RIGHT","in_reply_to_id":2088086432,"author_association":"MEMBER","original_position":4,"positio