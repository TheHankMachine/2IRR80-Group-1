TGFiZWwxMzI3MzE4Mjcx","url":"https://api.github.com/repos/godotengine/godot/labels/crash","name":"crash","color":"885544","default":false,"description":"","archived_at":null,"archived_by":null}],"state":"open","locked":false,"assignees":[],"milestone":{"url":"https://api.github.com/repos/godotengine/godot/milestones/16","html_url":"https://github.com/godotengine/godot/milestone/16","labels_url":"https://api.github.com/repos/godotengine/godot/milestones/16/labels","id":8237783,"node_id":"MI_kwDOAO6SJc4AfbLX","number":16,"title":"4.x","description":"Issues and pull requests slated for an undetermined Godot 4 release.","creator":{"login":"akien-mga","id":4701338,"node_id":"MDQ6VXNlcjQ3MDEzMzg=","avatar_url":"https://avatars.githubusercontent.com/u/4701338?v=4","gravatar_id":"","url":"https://api.github.com/users/akien-mga","html_url":"https://github.com/akien-mga","followers_url":"https://api.github.com/users/akien-mga/followers","following_url":"https://api.github.com/users/akien-mga/following{/other_user}","gists_url":"https://api.github.com/users/akien-mga/gists{/gist_id}","starred_url":"https://api.github.com/users/akien-mga/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/akien-mga/subscriptions","organizations_url":"https://api.github.com/users/akien-mga/orgs","repos_url":"https://api.github.com/users/akien-mga/repos","events_url":"https://api.github.com/users/akien-mga/events{/privacy}","received_events_url":"https://api.github.com/users/akien-mga/received_events","type":"User","user_view_type":"public","site_admin":false},"open_issues":5793,"closed_issues":0,"state":"open","created_at":"2022-07-26T12:42:05Z","updated_at":"2026-10-22T14:39:14Z","due_on":null,"closed_at":null},"comments":0,"created_at":"2025-07-23T14:27:45Z","updated_at":"2026-02-17T20:10:18Z","closed_at":null,"assignee":null,"author_association":"CONTRIBUTOR","issue_field_values":[],"type":null,"active_lock_reason":null,"draft":false,"pull_request":{"url":"https://api.github.com/repos/godotengine/godot/pulls/108902","html_url":"https://github.com/godotengine/godot/pull/108902","diff_url":"https://github.com/godotengine/godot/pull/108902.diff","patch_url":"https://github.com/godotengine/godot/pull/108902.patch","merged_at":null},"body":"I've had some crashes when resolution changes while recording a movie in OGV format. These resolution changes can happen at anytime, sometimes even before the first rendered frame but since we've prepared the video buffers before that, it will cause problems anyway.\r\n\r\nWhen the resolution decreases, the only issue is a distorted image but when the resolution increases buffer overflows can happen, and end in a segmentation fault or malloc error.\r\n\r\nThe underlying issue is described in #107316, initially described for embed game mode, but it can happen with any resolution change.\r\n\r\nWith this PR, I'm checking for resolution changes and throwing an error when they happen, as a workaround.\r\n\r\nI've also made changes to allow using uneven resolutions so that it doesn't get too restrictive, since windows may end up having arbitrary resolutions due to project/hardware constraints. If this is too much I can leave it for another PR.\r\n\r\nI've been doing several tests at many different resolutions and they all worked well with this PR.","closed_by":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/108902/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/godotengine/godot/issues/108902/timeline","performed_via_github_app":null,"state_reason":null}