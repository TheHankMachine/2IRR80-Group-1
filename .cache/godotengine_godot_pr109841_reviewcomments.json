hin `_make_dirty()`, so I think it would be better to explicitly pass the flags there.","created_at":"2025-08-22T00:40:37Z","updated_at":"2025-08-22T00:46:30Z","html_url":"https://github.com/godotengine/godot/pull/109841#discussion_r2292425364","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/109841","_links":{"self":{"href":"https://api.github.com/repos/godotengine/godot/pulls/comments/2292425364"},"html":{"href":"https://github.com/godotengine/godot/pull/109841#discussion_r2292425364"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/109841"}},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/2292425364/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":null,"original_line":94,"side":"RIGHT","author_association":"MEMBER","original_position":5,"position":1,"subject_type":"line"}]