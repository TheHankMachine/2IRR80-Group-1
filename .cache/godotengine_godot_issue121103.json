description":"","archived_at":null,"archived_by":null}],"state":"open","locked":false,"assignees":[],"milestone":{"url":"https://api.github.com/repos/godotengine/godot/milestones/25","html_url":"https://github.com/godotengine/godot/milestone/25","labels_url":"https://api.github.com/repos/godotengine/godot/milestones/25/labels","id":15520464,"node_id":"MI_kwDOAO6SJc4A7NLQ","number":25,"title":"4.8","description":"","creator":{"login":"Repiteo","id":17489292,"node_id":"MDQ6VXNlcjE3NDg5Mjky","avatar_url":"https://avatars.githubusercontent.com/u/17489292?v=4","gravatar_id":"","url":"https://api.github.com/users/Repiteo","html_url":"https://github.com/Repiteo","followers_url":"https://api.github.com/users/Repiteo/followers","following_url":"https://api.github.com/users/Repiteo/following{/other_user}","gists_url":"https://api.github.com/users/Repiteo/gists{/gist_id}","starred_url":"https://api.github.com/users/Repiteo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Repiteo/subscriptions","organizations_url":"https://api.github.com/users/Repiteo/orgs","repos_url":"https://api.github.com/users/Repiteo/repos","events_url":"https://api.github.com/users/Repiteo/events{/privacy}","received_events_url":"https://api.github.com/users/Repiteo/received_events","type":"User","user_view_type":"public","site_admin":false},"open_issues":343,"closed_issues":2335,"state":"open","created_at":"2026-04-13T15:59:35Z","updated_at":"2026-10-22T06:28:22Z","due_on":null,"closed_at":null},"comments":0,"created_at":"2026-07-08T18:18:57Z","updated_at":"2026-09-03T13:28:40Z","closed_at":null,"assignee":null,"author_association":"MEMBER","issue_field_values":[],"type":null,"active_lock_reason":null,"draft":false,"pull_request":{"url":"https://api.github.com/repos/godotengine/godot/pulls/121103","html_url":"https://github.com/godotengine/godot/pull/121103","diff_url":"https://github.com/godotengine/godot/pull/121103.diff","patch_url":"https://github.com/godotengine/godot/pull/121103.patch","merged_at":null},"body":"PR https://github.com/godotengine/godot/pull/82878 is taking too long to be merged, and there is a point of contention on the call to get the target point from GDScript with regards to threading, so I want to split this.\r\n\r\nSince PR #120983 was just merged, I want to get this enum change merged sooner rather than later, so that people rebasing their PRs don't need to update their usage of physics enums multiple times, so I am submitting this PR separately.\r\n\r\n## What problem(s) does this PR solve?\r\n\r\nIn the current master branch of Godot, there are only two types of gravity: Directional and Point. This is currently done with a boolean, but this does not make conceptual sense. There are more than two possible states for gravity, and conceptually it does not make sense why one is more deserving of the true state (there could just as easily be an \"is directional\" boolean instead of an \"is point\" boolean). And a boolean makes it impossible to extend later without heavy refactoring akin to this PR.\r\n\r\n## Additional information\r\n\r\nThis is a refactor that does not change behavior or break compatibility.\r\n\r\nSee also https://github.com/godotengine/godot-proposals/issues/7850 and https://github.com/godotengine/godot-proposals/issues/5714\r\n","closed_by":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/121103/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/godotengine/godot/issues/121103/timeline","performed_via_github_app":null,"state_reason":null}