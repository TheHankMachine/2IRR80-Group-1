otengine/godot/pull/115598#discussion_r2746398417"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/115598"}},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/2746398417/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":null,"original_line":1839,"side":"RIGHT","author_association":"MEMBER","original_position":4,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/3124186310","pull_request_review_id":4154920964,"id":3124186310,"node_id":"PRRC_kwDOAO6SJc66N0zG","diff_hunk":"@@ -2240,6 +2267,8 @@ Input::Input() {\n \tgravity_enabled = GLOBAL_DEF_RST_BASIC(\"input_devices/sensors/enable_gravity\", false);\n \tgyroscope_enabled = GLOBAL_DEF_RST_BASIC(\"input_devices/sensors/enable_gyroscope\", false);\n \tmagnetometer_enabled = GLOBAL_DEF_RST_BASIC(\"input_devices/sensors/enable_magnetometer\", false);\n+\n+\tProjectSettings::get_singleton()->connect(\"settings_changed\", callable_mp(this, &Input::_project_settings_changed));","path":"core/input/input.cpp","commit_id":"e9b0803fe948a6eb22761ec777aeea105efca0b0","original_commit_id":"e9b0803fe948a6eb22761ec777aeea105efca0b0","user":{"login":"Alex2782","id":41921395,"node_id":"MDQ6VXNlcjQxOTIxMzk1","avatar_url":"https://avatars.githubusercontent.com/u/41921395?v=4","gravatar_id":"","url":"https://api.github.com/users/Alex2782","html_url":"https://github.com/Alex2782","followers_url":"https://api.github.com/users/Alex2782/followers","following_url":"https://api.github.com/users/Alex2782/following{/other_user}","gists_url":"https://api.github.com/users/Alex2782/gists{/gist_id}","starred_url":"https://api.github.com/users/Alex2782/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Alex2782/subscriptions","organizations_url":"https://api.github.com/users/Alex2782/orgs","repos_url":"https://api.github.com/users/Alex2782/repos","events_url":"https://api.github.com/users/Alex2782/events{/privacy}","received_events_url":"https://api.github.com/users/Alex2782/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"I believe I already reported a similar issue in your other PR. 😃 \r\nPerhaps you have already fixed it and a rebase needs to be performed to resolve the conflicts.\r\n\r\nI can't set these settings to `true` in `_ready()` because they are then overwritten with project settings set to `false` in the `Input` constructor.\r\n\r\n```gdscript\r\nfunc _ready() -> void:\r\n\tprint(\"GdScript _ready\")\r\n\r\n\t# PR #115598\r\n\tprint(\"is_joycons_separate: \", Input.is_joycons_separate())\r\n\tprint(\"is_joycons_vertical: \", Input.is_joycons_vertical())\r\n\t\r\n\tprint(\"--- set to true ---\")\r\n\tInput.set_joycons_separate(true)\r\n\tInput.set_joycons_vertical(true)\r\n\tprint(\"is_joycons_separate: \", Input.is_joycons_separate())\r\n\tprint(\"is_joycons_vertical: \", Input.is_joycons_vertical())\r\n\r\n```\r\n\r\n### cpp file\r\n\r\n```cpp\r\nvoid Input::_project_settings_changed() {\r\n\tprint_line(\"Input::_project_settings_changed()\");\r\n\tjoycons_separate = GLOBAL_GET(\"input_devices/joypads/treat_joycons_as_separate_joypads\");\r\n\tjoycons_vertical = GLOBAL_GET(\"input_devices/joypads/treat_joycons_as_held_vertically\");\r\n\tprint_line(\"joycons_separate: \", joycons_separate, \", joycons_vertical: \", joycons_vertical);\r\n}\r\n```\r\n\r\n\r\n### Output\r\n\r\n```\r\nGdScript _ready\r\nis_joycons_separate: false\r\nis_joycons_vertical: false\r\n--- set to true ---\r\nis_joycons_separate: true\r\nis_joycons_vertical: true\r\nInput::_project_settings_changed()\r\njoycons_separate:  false , joycons_vertical:  false\r\n+ Found newly connected joypad #0: Xbox One - 050038555e040000130b0000b4756d04\r\n{ \"raw_name\": \"Xbox One\", \"vendor_id\": \"1118\", \"product_id\": \"2835\" }\r\n\r\n```\