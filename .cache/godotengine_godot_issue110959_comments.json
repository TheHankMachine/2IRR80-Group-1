0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3341484671","html_url":"https://github.com/godotengine/godot/issues/110959#issuecomment-3341484671","issue_url":"https://api.github.com/repos/godotengine/godot/issues/110959","id":3341484671,"node_id":"IC_kwDOAO6SJc7HKwJ_","user":{"login":"Nodragem","id":10520249,"node_id":"MDQ6VXNlcjEwNTIwMjQ5","avatar_url":"https://avatars.githubusercontent.com/u/10520249?v=4","gravatar_id":"","url":"https://api.github.com/users/Nodragem","html_url":"https://github.com/Nodragem","followers_url":"https://api.github.com/users/Nodragem/followers","following_url":"https://api.github.com/users/Nodragem/following{/other_user}","gists_url":"https://api.github.com/users/Nodragem/gists{/gist_id}","starred_url":"https://api.github.com/users/Nodragem/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Nodragem/subscriptions","organizations_url":"https://api.github.com/users/Nodragem/orgs","repos_url":"https://api.github.com/users/Nodragem/repos","events_url":"https://api.github.com/users/Nodragem/events{/privacy}","received_events_url":"https://api.github.com/users/Nodragem/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-09-27T10:25:45Z","updated_at":"2025-09-27T10:25:45Z","body":"I just tried and it does the same error when I just right-click and duplicate without additional editing.","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3341484671/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3341529428","html_url":"https://github.com/godotengine/godot/issues/110959#issuecomment-3341529428","issue_url":"https://api.github.com/repos/godotengine/godot/issues/110959","id":3341529428,"node_id":"IC_kwDOAO6SJc7HK7FU","user":{"login":"fstxz","id":47072685,"node_id":"MDQ6VXNlcjQ3MDcyNjg1","avatar_url":"https://avatars.githubusercontent.com/u/47072685?v=4","gravatar_id":"","url":"https://api.github.com/users/fstxz","html_url":"https://github.com/fstxz","followers_url":"https://api.github.com/users/fstxz/followers","following_url":"https://api.github.com/users/fstxz/following{/other_user}","gists_url":"https://api.github.com/users/fstxz/gists{/gist_id}","starred_url":"https://api.github.com/users/fstxz/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/fstxz/subscriptions","organizations_url":"https://api.github.com/users/fstxz/orgs","repos_url":"https://api.github.com/users/fstxz/repos","events_url":"https://api.github.com/users/fstxz/events{/privacy}","received_events_url":"https://api.github.com/users/fstxz/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-09-27T11:09:12Z","updated_at":"2025-09-27T11:10:21Z","body":"I see the same error in one of my projects and it comes from an addon that is symlinked. What is interesting is that if I create a new project and symlink the addon, there is no error. Since it's a symlink, addon's files are the same in both cases.\n\nSo, while I was writing this message I found that it was because I had one of the addon's scripts opened in the script editor. After I closed the script and relaunched the editor, the error was gone. I am not sure if this related to this issue, but I though I would share this anyway.","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3341529428/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3341538656","html_url":"https://github.com/godotengine/godot/issues/110959#issuecomment-3341538656","issue_url":"https://api.github.com/repos/godotengine/godot/issues/110959","id":3341538656,"node_id":"IC_kwDOAO6SJc7HK9Vg","user":{"login":"Nodragem","id":10520249,"node_id":"MDQ6VXNlcjEwNTIwMjQ5","avatar_url":"https://avatars.githubusercontent.com/u/10520249?v=4","gravatar_id":"","url":"https://api.github.com/users/Nodragem","html_url":"https://github.com/Nodragem","followers_url":"https://api.github.com/users/Nodragem/followers","following_url":"https://api.github.com/users/Nodragem/following{/other_user}","gists_url":"https://api.github.com/users/Nodragem/gists{/gist_id}","starred_url":"https://api.github.com/users/Nodragem/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Nodragem/subscriptions","organizations_url":"https://api.github.com/users/Nodragem/orgs","repos_url":"https://api.github.com/users/Nodragem/repos","events_url":"https://api.github.com/users/Nodragem/events{/privacy}","received_events_url":"https://api.github.com/users/Nodragem/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-09-27T11:16:49Z","updated_at":"2025-09-27T11:41:00Z","body":"I found the issue.\n\nIn a Constants.gd, I was preloading the PackedScene:\n```gdscript\nstatic var JohnSkin:PackedScene = preload(\"uid://bogm36tippaev\")\nstatic var JaneSkin:PackedScene = preload(\"uid://c2ivy7xkxcmml\")\n```\nand then using them in my PlayerEntity.gd:\n```gdscript\n\telse:\n\t\tSkin.queue_free()\n\t\tvar new_skin = Constants.JaneSkin.instantiate() as PlayerSkin\n\t\tself.add_child(new_skin)\n\t\tself.model = new_skin\n```\n\nIf I use `preload()` directly in PlayerEntity, no error happens:\n```gdscript\n\telse:\n\t\t$Skin.queue_free()\n\t\tvar new_skin = preload(\"uid://c2ivy7xkxcmml\").instantiate() as PlayerSkin\n\t\tself.add_child(new_skin)\n\t\tself.model = new_skin\n```\n\nWeirdly I could not replicate the problem in the MRP (by trying to add a constants.gd).\n\nEdit: I feel like I always get into troubles when using `static` variables 😄 ","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3341538656/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3707026458","html_url":"https://github.com/godotengine/godot/issues/110959#issuecomment-3707026458","issue_url":"https://api.github.com/repos/godotengine/godot/issues/110959","id":3707026458,"node_id":"IC_kwDOAO6SJc7c9Lwa","user":{"login":"jchrom","id":7213168,"node_id":"MDQ6VXNlcjcyMTMxNjg=","avatar_url":"https://avatars.githubusercontent.com/u/7213168?v=4","gravatar_id":"","url":"https://api.github.com/users/jchrom","html_url":"https://github.com/jchrom","followers_url":"https://api.github.com/users/jchrom/followers","following_url":"https://api.github.com/users/jchrom/following{/other_user}","gists_url":"https://api.github.com/users/jchrom/gists{/gist_id}","starred_url":"https://api.github.com/users/jchrom/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/jchrom/subscriptions","organizations_url":"https://api.github.com/users/jchrom/orgs","repos_url":"https://api.github.com/users/jchrom/repos","events_url":"https://api.github.com/users/jchrom/events{/privacy}","received_events_url":"https://api.github.com/users/jchrom/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-01-03T12:35:27Z","updated_at":"2026-01-03T12:35:27Z","body":"I just experienced the same issue with the same resolution @Nodragem described in the previous comment (v4.5.1.stable). My workaround was making Constants.gd an autoload.","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3707026458/reactions","total_count":