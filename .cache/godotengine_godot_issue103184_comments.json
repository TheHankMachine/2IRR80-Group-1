csartor/followers","following_url":"https://api.github.com/users/ericsartor/following{/other_user}","gists_url":"https://api.github.com/users/ericsartor/gists{/gist_id}","starred_url":"https://api.github.com/users/ericsartor/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/ericsartor/subscriptions","organizations_url":"https://api.github.com/users/ericsartor/orgs","repos_url":"https://api.github.com/users/ericsartor/repos","events_url":"https://api.github.com/users/ericsartor/events{/privacy}","received_events_url":"https://api.github.com/users/ericsartor/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-02-23T22:06:55Z","updated_at":"2025-02-23T22:06:55Z","body":"So, seemingly that explains why it works as expected in the Godot editor and in the Windows build, but not in the Web build? Is there perhaps a reason why someone might've made the behavior different?","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2677140671/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2677185757","html_url":"https://github.com/godotengine/godot/issues/103184#issuecomment-2677185757","issue_url":"https://api.github.com/repos/godotengine/godot/issues/103184","id":2677185757,"node_id":"IC_kwDOAO6SJc6fkpzd","user":{"login":"mooflu","id":693717,"node_id":"MDQ6VXNlcjY5MzcxNw==","avatar_url":"https://avatars.githubusercontent.com/u/693717?v=4","gravatar_id":"","url":"https://api.github.com/users/mooflu","html_url":"https://github.com/mooflu","followers_url":"https://api.github.com/users/mooflu/followers","following_url":"https://api.github.com/users/mooflu/following{/other_user}","gists_url":"https://api.github.com/users/mooflu/gists{/gist_id}","starred_url":"https://api.github.com/users/mooflu/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/mooflu/subscriptions","organizations_url":"https://api.github.com/users/mooflu/orgs","repos_url":"https://api.github.com/users/mooflu/repos","events_url":"https://api.github.com/users/mooflu/events{/privacy}","received_events_url":"https://api.github.com/users/mooflu/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-02-23T23:43:53Z","updated_at":"2025-02-23T23:43:53Z","body":"Possibly related to the changes in 4.3 where web audio uses samples even for streams by default.\nDoes the looping work if you change the \"Playback Type\" from \"Default\" to \"Stream\" so it forces stream even for web?\n","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2677185757/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2678482934","html_url":"https://github.com/godotengine/godot/issues/103184#issuecomment-2678482934","issue_url":"https://api.github.com/repos/godotengine/godot/issues/103184","id":2678482934,"node_id":"IC_kwDOAO6SJc6fpmf2","user":{"login":"ericsartor","id":24692643,"node_id":"MDQ6VXNlcjI0NjkyNjQz","avatar_url":"https://avatars.githubusercontent.com/u/24692643?v=4","gravatar_id":"","url":"https://api.github.com/users/ericsartor","html_url":"https://github.com/ericsartor","followers_url":"https://api.github.com/users/ericsartor/followers","following_url":"https://api.github.com/users/ericsartor/following{/other_user}","gists_url":"https://api.github.com/users/ericsartor/gists{/gist_id}","starred_url":"https://api.github.com/users/ericsartor/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/ericsartor/subscriptions","organizations_url":"https://api.github.com/users/ericsartor/orgs","repos_url":"https://api.github.com/users/ericsartor/repos","events_url":"https://api.github.com/users/ericsartor/events{/privacy}","received_events_url":"https://api.github.com/users/ericsartor/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-02-24T13:54:09Z","updated_at":"2025-02-24T13:54:09Z","body":"Interesting, that does work. So, setting the audio stream player to Stream explicitly instead of Default works in editor, on Web and on Windows. So...I guess the bug is related to how samples are handled on the Web platform? This means the documentation is wrong for this property. it says this:\n\n\"Default: The playback will be considered of the type declared at Audio > General > Default Playback Type.\"\n\nIn the sample project, that is set to \"Stream\". So apparently that is being ignored when building for Web? And either way, defaulting to Sample in any case would be kind of odd, since there are caveats like lack of support for AudioEffects, meaning even if it did loop, I'd suddenly lose my AudioEffects without having opted in to that behavior explicitly?","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2678482934/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2679301658","html_url":"https://github.com/godotengine/godot/issues/103184#issuecomment-2679301658","issue_url":"https://api.github.com/repos/godotengine/godot/issues/103184","id":2679301658,"node_id":"IC_kwDOAO6SJc6fsuYa","user":{"login":"mooflu","id":693717,"node_id":"MDQ6VXNlcjY5MzcxNw==","avatar_url":"https://avatars.githubusercontent.com/u/693717?v=4","gravatar_id":"","url":"https://api.github.com/users/mooflu","html_url":"https://github.com/mooflu","followers_url":"https://api.github.com/users/mooflu/followers","following_url":"https://api.github.com/users/mooflu/following{/other_user}","gists_url":"https://api.github.com/users/mooflu/gists{/gist_id}","starred_url":"https://api.github.com/users/mooflu/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/mooflu/subscriptions","organizations_url":"https://api.github.com/users/mooflu/orgs","repos_url":"https://api.github.com/users/mooflu/repos","events_url":"https://api.github.com/users/mooflu/events{/privacy}","received_events_url":"https://api.github.com/users/mooflu/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-02-24T18:22:21Z","updated_at":"2025-02-24T18:22:21Z","body":"Maybe not super clear, but for web it uses audio/general/default_playback_type.web which defaults to sample. There's a blog post why it's using samples on the web by default. See https://godotengine.org/article/progress-report-web-export-in-4-3/. ","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2679301658/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2679330699","html_url":"https://github.com/godotengine/godot/issues/103184#issuecomment-2679330699","issue_url":"https://api.github.com/repos/godotengine/godot/issues/103184","id":2679330699,"node_id":"IC_kwDOAO6SJc6fs1eL","user":{"login":"ericsartor","id":24692643,"node_id":"MDQ6VXNlcjI0NjkyNjQz","avatar_url":"https://avatars.githubusercontent.com/u/24692643?v=4","gravatar_id":"","url":"https://api.github.com/users/ericsartor","html_url":"https://github.com/ericsartor","followers_url":"https://api.github.com/users/ericsartor/followers","following_url":"https://api.github.com/users/ericsartor/following{/other_user}","gists_url":"https://api.github.com/users/ericsartor/gists{/gist_id}","starred_url":"https://api.github.com/users/ericsartor/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/ericsartor/subscriptions","organizations_url":"https://api.github.com/users/ericsartor/orgs","repos_url":"https://api.github.com/users/ericsartor/repos","events_url":"https://api.github.com/users/ericsartor/events{/privacy}","received_events_url":"https://api.github.com/users/ericsartor/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-02-24T18:35:32Z","updated_at":"2025-02-24T18:35:32Z","body":"Ah, I totally missed that, thanks for clarifying. So, after having read that article, I take it that Samples are the future for how audio gets handled on the Web platform. So, I suppose that means, as far as this bug report is concerned, that the bug here is \"looping audio using Sample playback doesn't seem to work\"?","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2679330699/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2686607292","html_url":"https://github.com/godotengine/godot/issues/103184#issuecomment-2686607292","issue_url":"https://api.github.com/repos/godotengine/godot/issues/103184","id":2686607292,"node_id":"IC_kwDOAO6SJc6gIl-8","user":{"login":"Saulo-de-Souza","id":17336909,"node_id":"MDQ6VXNlcjE3MzM2OTA5","avatar_url":"https://avatars.githubusercontent.com/u/17336909?v=4","gravatar_id":"","url":"https://api.github.com/users/Saulo-de-Souza","html_url":"https://github.com/Saulo-de-Souza","followers_url":"https://api.github.com/users/Saulo-de-Souza/followers","following_url":"https://api.github.com/users/Saulo-de-Souza/following{/other_user}","gists_url":"https://api.github.com/users/Saulo-de-Souza/gist