[{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3339089098","html_url":"https://github.com/godotengine/godot/issues/110929#issuecomment-3339089098","issue_url":"https://api.github.com/repos/godotengine/godot/issues/110929","id":3339089098,"node_id":"IC_kwDOAO6SJc7HBnTK","user":{"login":"tkmfujise","id":106900036,"node_id":"U_kgDOBl8qRA","avatar_url":"https://avatars.githubusercontent.com/u/106900036?v=4","gravatar_id":"","url":"https://api.github.com/users/tkmfujise","html_url":"https://github.com/tkmfujise","followers_url":"https://api.github.com/users/tkmfujise/followers","following_url":"https://api.github.com/users/tkmfujise/following{/other_user}","gists_url":"https://api.github.com/users/tkmfujise/gists{/gist_id}","starred_url":"https://api.github.com/users/tkmfujise/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/tkmfujise/subscriptions","organizations_url":"https://api.github.com/users/tkmfujise/orgs","repos_url":"https://api.github.com/users/tkmfujise/repos","events_url":"https://api.github.com/users/tkmfujise/events{/privacy}","received_events_url":"https://api.github.com/users/tkmfujise/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-09-26T15:04:53Z","updated_at":"2025-09-26T15:04:53Z","body":"Sorry, I thought I had solved the issue, but I was mistaken.\nI got a bit confused, so I'm reopening this now.","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3339089098/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3339913985","html_url":"https://github.com/godotengine/godot/issues/110929#issuecomment-3339913985","issue_url":"https://api.github.com/repos/godotengine/godot/issues/110929","id":3339913985,"node_id":"IC_kwDOAO6SJc7HEwsB","user":{"login":"Jojo-1000","id":33495614,"node_id":"MDQ6VXNlcjMzNDk1NjE0","avatar_url":"https://avatars.githubusercontent.com/u/33495614?v=4","gravatar_id":"","url":"https://api.github.com/users/Jojo-1000","html_url":"https://github.com/Jojo-1000","followers_url":"https://api.github.com/users/Jojo-1000/followers","following_url":"https://api.github.com/users/Jojo-1000/following{/other_user}","gists_url":"https://api.github.com/users/Jojo-1000/gists{/gist_id}","starred_url":"https://api.github.com/users/Jojo-1000/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Jojo-1000/subscriptions","organizations_url":"https://api.github.com/users/Jojo-1000/orgs","repos_url":"https://api.github.com/users/Jojo-1000/repos","events_url":"https://api.github.com/users/Jojo-1000/events{/privacy}","received_events_url":"https://api.github.com/users/Jojo-1000/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-09-26T18:13:03Z","updated_at":"2025-09-26T18:13:03Z","body":"Can reproduce this. This is a byproduct of the \"Safe Save on Backup then Rename\" setting that is on by default. It creates a new file with default permissions instead of the original file permissions. I am not sure if this intentional or just an oversight, but it is confusing in this case. You can turn it off:\n\n<img width=\"911\" height=\"742\" alt=\"Image\" src=\"https://github.com/user-attachments/assets/82da3dad-8233-47b8-9afa-a02e9c50db91\" />\n\nThen reload the project and it should not mess it up afterwards (of course you now have a change of corrupted files when saving is interrupted, make sure to use git to prevent any data loss).\n\nThis is the line that sets default permissions:\nhttps://github.com/godotengine/godot/blob/1f7630f1bfd9a7c65a5c144f85be38b4b64e3717/drivers/unix/file_access_unix.cpp#L151","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3339913985/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3340011172","html_url":"https://github.com/godotengine/godot/issues/110929#issuecomment-3340011172","issue_url":"https://api.github.com/repos/godotengine/godot/issues/110929","id":3340011172,"node_id":"IC_kwDOAO6SJc7HFIak","user":{"login":"tkmfujise","id":106900036,"node_id":"U_kgDOBl8qRA","avatar_url":"https://avatars.githubusercontent.com/u/106900036?v=4","gravatar_id":"","url":"https://api.github.com/users/tkmfujise","html_url":"https://github.com/tkmfujise","followers_url":"https://api.github.com/users/tkmfujise/followers","following_url":"https://api.github.com/users/tkmfujise/following{/other_user}","gists_url":"https://api.github.com/users/tkmfujise/gists{/gist_id}","starred_url":"https://api.github.com/users/tkmfujise/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/tkmfujise/subscriptions","organizations_url":"https://api.github.com/users/tkmfujise/orgs","repos_url":"https://api.github.com/users/tkmfujise/repos","events_url":"https://api.github.com/users/tkmfujise/events{/privacy}","received_events_url":"https://api.github.com/users/tkmfujise/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-09-26T18:42:49Z","updated_at":"2025-09-26T18:42:49Z","body":"@Jojo-1000 \nThanks for looking into this!\nI’ll try working around it by calling Godot through a shell script.","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3340011172/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null}]