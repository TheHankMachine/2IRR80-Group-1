github.com/users/Ivorforce/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Ivorforce/subscriptions","organizations_url":"https://api.github.com/users/Ivorforce/orgs","repos_url":"https://api.github.com/users/Ivorforce/repos","events_url":"https://api.github.com/users/Ivorforce/events{/privacy}","received_events_url":"https://api.github.com/users/Ivorforce/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"","state":"COMMENTED","html_url":"https://github.com/godotengine/godot/pull/120259#pullrequestreview-4508328549","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/120259","author_association":"MEMBER","_links":{"html":{"href":"https://github.com/godotengine/godot/pull/120259#pullrequestreview-4508328549"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/120259"}},"submitted_at":"2026-06-16T16:25:26Z","commit_id":"b496750a27811febf6b0e3701627736992010b59"},{"id":4517176467,"node_id":"PRR_kwDOAO6SJc8AAAABDT6kkw","user":{"login":"allenwp","id":17506573,"node_id":"MDQ6VXNlcjE3NTA2NTcz","avatar_url":"https://avatars.githubusercontent.com/u/17506573?u=6e9313e254649f6dc55e92536596487ac10bf5a2&v=4","gravatar_id":"","url":"https://api.github.com/users/allenwp","html_url":"https://github.com/allenwp","followers_url":"https://api.github.com/users/allenwp/followers","following_url":"https://api.github.com/users/allenwp/following{/other_user}","gists_url":"https://api.github.com/users/allenwp/gists{/gist_id}","starred_url":"https://api.github.com/users/allenwp/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/allenwp/subscriptions","organizations_url":"https://api.github.com/users/allenwp/orgs","repos_url":"https://api.github.com/users/allenwp/repos","events_url":"https://api.github.com/users/allenwp/events{/privacy}","received_events_url":"https://api.github.com/users/allenwp/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"Thanks for the updates, this looks good to me!\n\nI personally see this as an overall improvement. Some of the changes are just minor style changes, so I expect no difference in contributor behaviour in practice.\n\nThe Author disclosure section is something I can't really comment on because I haven't yet been exposed to dealing with PRs that have been created with AI tooling.\n\nOne final note is that the docs should probably do a better job of communicating how fixes will be backported to older branches and versions... With this new PR I would expect this note to be in the [checklist](https://contributing.godotengine.org/en/latest/engine/introduction.html#checklist-for-new-contributors) (since that's linked right after the text that says to target `master`) or in one of the pages that's directly linked from that docs section. But this can be handled in a separate contributing docs PR.","state":"APPROVED","html_url":"https://github.com/godotengine/godot/pull/120259#pullrequestreview-4517176467","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/120259","author_association":"CONTRIBUTOR","_links":{"html":{"href":"https://github.com/godotengine/godot/pull/120259#pullrequestreview-4517176467"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/120259"}},"submitted_at":"2026-06-17T15:35:16Z","commit_id":"89b286e0c2571899a249e4131a8d353449d8d7ee"}]