rgs","repos_url":"https://api.github.com/users/BlueCube3310/repos","events_url":"https://api.github.com/users/BlueCube3310/events{/privacy}","received_events_url":"https://api.github.com/users/BlueCube3310/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-06-17T14:38:01Z","updated_at":"2025-06-17T14:38:01Z","body":"I've added a way to upgrade older lightmaps - a new button will appear next to the \"Bake\" one for incompatible lightmaps, and pressing it will automatically convert the map to the new format","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2980645414/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2981048730","html_url":"https://github.com/godotengine/godot/pull/100790#issuecomment-2981048730","issue_url":"https://api.github.com/repos/godotengine/godot/issues/100790","id":2981048730,"node_id":"IC_kwDOAO6SJc6xrzGa","user":{"login":"michaelharmonart","id":15620900,"node_id":"MDQ6VXNlcjE1NjIwOTAw","avatar_url":"https://avatars.githubusercontent.com/u/15620900?v=4","gravatar_id":"","url":"https://api.github.com/users/michaelharmonart","html_url":"https://github.com/michaelharmonart","followers_url":"https://api.github.com/users/michaelharmonart/followers","following_url":"https://api.github.com/users/michaelharmonart/following{/other_user}","gists_url":"https://api.github.com/users/michaelharmonart/gists{/gist_id}","starred_url":"https://api.github.com/users/michaelharmonart/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/michaelharmonart/subscriptions","organizations_url":"https://api.github.com/users/michaelharmonart/orgs","repos_url":"https://api.github.com/users/michaelharmonart/repos","events_url":"https://api.github.com/users/michaelhar