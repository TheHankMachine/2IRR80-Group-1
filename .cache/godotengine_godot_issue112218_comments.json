,"type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-10-31T09:40:13Z","updated_at":"2025-10-31T09:42:55Z","body":"Something like (not fully tested):\n```diff\ndiff --git a/scene/gui/menu_button.cpp b/scene/gui/menu_button.cpp\nindex eb2e30ad0d..add87bb836 100644\n--- a/scene/gui/menu_button.cpp\n+++ b/scene/gui/menu_button.cpp\n@@ -86,20 +86,17 @@ void MenuButton::show_popup() {\n                rect = xform.xform(rect);\n        }\n        Rect2i scr_usable = DisplayServer::get_singleton()->screen_get_usable_rect(get_window()->get_current_screen());\n-       Size2i max_size;\n-       if (scr_usable.has_area()) {\n-               real_t max_h = scr_usable.get_end().y - rect.position.y;\n-               real_t max_w = scr_usable.get_end().x - rect.position.x;\n-               if (max_h >= 4 * rect.size.height && max_w >= rect.size.width) {\n-                       max_size = Size2i(max_w, max_h);\n-               }\n-       }\n-       popup->set_max_size(max_size);\n-       rect.size.height = 0;\n-       popup->set_size(rect.size);\n        if (is_layout_rtl()) {\n                rect.position.x += rect.size.width - popup->get_size().width;\n        }\n+       if (scr_usable.has_area()) {\n+               if (rect.position.x + rect.size.x > scr_usable.get_end().x) {\n+                       rect.position.x += scr_usable.get_end().x - (rect.position.x + rect.size.x);\n+               }\n+               if (rect.position.y + rect.size.y > scr_usable.get_end().y) {\n+                       rect.position.y += scr_usable.get_end().y - (rect.position.y + rect.size.y);\n+               }\n+       }\n        popup->set_position(rect.position);\n\n        // If not triggered by the mouse, start the popup with its first enabled item focused.\n```","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3472150889/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":{"reason":"outdated"}},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3472161230","html_url":"https://github.com/godotengine/godot/issues/112218#issuecomment-3472161230","issue_url":"https://api.github.com/repos/godotengine/godot/issues/112218","id":3472161230,"node_id":"IC_kwDOAO6SJc7O9PnO","user":{"login":"bruvzg","id":7645683,"node_id":"MDQ6VXNlcjc2NDU2ODM=","avatar_url":"https://avatars.githubusercontent.com/u/7645683?v=4","gravatar_id":"","url":"https://api.github.com/users/bruvzg","html_url":"https://github.com/bruvzg","followers_url":"https://api.github.com/users/bruvzg/followers","following_url":"https://api.github.com/users/bruvzg/following{/other_user}","gists_url":"https://api.github.com/users/bruvzg/gists{/gist_id}","starred_url":"https://api.github.com/users/bruvzg/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/bruvzg/subscriptions","organizations_url":"https://api.github.com/users/bruvzg/orgs","repos_url":"https://api.github.com/users/bruvzg/repos","events_url":"https://api.github.com/users/bruvzg/events{/privacy}","received_events_url":"https://api.github.com/users/bruvzg/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-10-31T09:42:47Z","updated_at":"2025-10-31T09:42:47Z","body":"Actually, not sure if position adjustment is needed at all, it seems like popup is handling it fine on its own.","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3472161230/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3472162044","html_url":"https://github.com/godotengine/godot/issues/112218#issuecomment-3472162044","issue_url":"https://api.github.co