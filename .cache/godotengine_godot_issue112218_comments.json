url":"https://api.github.com/users/bruvzg/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/bruvzg/subscriptions","organizations_url":"https://api.github.com/users/bruvzg/orgs","repos_url":"https://api.github.com/users/bruvzg/repos","events_url":"https://api.github.com/users/bruvzg/events{/privacy}","received_events_url":"https://api.github.com/users/bruvzg/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-10-31T09:38:42Z","updated_at":"2025-10-31T09:38:42Z","body":"Probably change the logic in `MenuButton::show_popup`, it's likely should not set `max_size` or `size` and instead only change `position` based on the size of popup (to fit to screen).","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3472144673/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3472149103","html_url":"https://github.com/godotengine/godot/issues/112218#issuecomment-3472149103","issue_url":"https://api.github.com/repos/godotengine/godot/issues/112218","id":3472149103,"node_id":"IC_kwDOAO6SJc7O9Mpv","user":{"login":"scgm0","id":52148221,"node_id":"MDQ6VXNlcjUyMTQ4MjIx","avatar_url":"https://avatars.githubusercontent.com/u/52148221?v=4","gravatar_id":"","url":"https://api.github.com/users/scgm0","html_url":"https://github.com/scgm0","followers_url":"https://api.github.com/users/scgm0/followers","following_url":"https://api.github.com/users/scgm0/following{/other_user}","gists_url":"https://api.github.com/users/scgm0/gists{/gist_id}","starred_url":"https://api.github.com/users/scgm0/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/scgm0/subscriptions","organizations_url":"https://api.github.com/users/scgm0/orgs","repos_url":"https://api.github.com/user