emy/following{/other_user}","gists_url":"https://api.github.com/users/LuxyCeremy/gists{/gist_id}","starred_url":"https://api.github.com/users/LuxyCeremy/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/LuxyCeremy/subscriptions","organizations_url":"https://api.github.com/users/LuxyCeremy/orgs","repos_url":"https://api.github.com/users/LuxyCeremy/repos","events_url":"https://api.github.com/users/LuxyCeremy/events{/privacy}","received_events_url":"https://api.github.com/users/LuxyCeremy/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-01-05T08:48:53Z","updated_at":"2026-01-05T08:48:53Z","body":"> Can you confirm if the issue happens on the latest NVIDIA driver? I cannot reproduce this on my end.\n\nI just upgraded to 591.59, and it glitch too.","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3709468149/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3799737733","html_url":"https://github.com/godotengine/godot/issues/114608#issuecomment-3799737733","issue_url":"https://api.github.com/repos/godotengine/godot/issues/114608","id":3799737733,"node_id":"IC_kwDOAO6SJc7ie2WF","user":{"login":"Sylfa","id":4145461,"node_id":"MDQ6VXNlcjQxNDU0NjE=","avatar_url":"https://avatars.githubusercontent.com/u/4145461?v=4","gravatar_id":"","url":"https://api.github.com/users/Sylfa","html_url":"https://github.com/Sylfa","followers_url":"https://api.github.com/users/Sylfa/followers","following_url":"https://api.github.com/users/Sylfa/following{/other_user}","gists_url":"https://api.github.com/users/Sylfa/gists{/gist_id}","starred_url":"https://api.github.com/users/Sylfa/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Sylfa/subscriptions","organizations_url":"https://api.github.com/users/Sylfa/orgs","repos_url":"https://api.github.com/users/Sylfa/repos","events_url":"https://api.github.com/users/Sylfa/events{/privacy}","received_events_url":"https://api.github.com/users/Sylfa/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-01-26T13:54:24Z","updated_at":"2026-01-26T13:54:24Z","body":"I've stumbled on this same bug myself recently. Here's the relevant portion of my nvidia driver system information:\n<img width=\"483\" height=\"100\" alt=\"Image\" src=\"https://github.com/user-attachments/assets/9ea58300-4da3-4ca2-a117-904a0e3d5bc6\" />\n\nThe issue with the black flickering lines also happens in 4.5.1, I think the real bug that has been introduced in 4.6 is that it changes your rendering device to d3d12 suddenly.\n\nI've not been able to track down how or when it swaps over to d3d12 driver, I _thought_ it was when I added decals or particles but so far I've not been able to recreate it despite it happening twice on two different toy projects.","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3799737733/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3799786194","html_url":"https://github.com/godotengine/godot/issues/114608#issuecomment-3799786194","issue_url":"https://api.github.com/repos/godotengine/godot/issues/114608","id":3799786194,"node_id":"IC_kwDOAO6SJc7ifCLS","user":{"login":"Sylfa","id":4145461,"node_id":"MDQ6VXNlcjQxNDU0NjE=","avatar_url":"https://avatars.githubusercontent.com/u/4145461?v=4","gravatar_id":"","url":"https://api.github.com/users/Sylfa","html_url":"https://github.com/Sylfa","followers_url":"https://api.github.com/users/Sylfa/followers","following_url":"https://api.github.com/users/Sylfa/following{/other_user}","gists_url":"https://api.github.com/users/Sylfa/gists{/gist_id}","starred_url":"https://api.github.com/users/Sylfa/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Sylfa/subscriptions","organizations_url":"https://api.github.com/users/Sylfa/orgs","repos_url":"https://api.github.com/users/Sylfa/repos","events_url":"https://api.github.com/users/Sylfa/events{/privacy}","received_events_url":"https://api.github.com/users/Sylfa/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-01-26T14:05:51Z","updated_at":"2026-01-26T14:05:51Z","body":"What I mean is, prior to 4.6 it would not change over from vulkan to d3d12 so it wouldn't show up as an issue.\nTwice now I've had a project running without any issues, because it was using the vulkan driver. Then, without me changing it, it swapped over to d3d12 and the bug shows up.\n\nI suspect it does this when you enable some function on the GPUParticle3D that requires it? It's not clear what caused it, but I had 2 projects that had no graphical glitches that then started having the issue after playing around with particle systems. Since I wasn't play testing at the same time it might not have shown up until after I restarted Godot, but it's this silent change in rendering device that makes it _seem_ like Godot 4.6 has a bug.","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3799786194/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3799826472","html_url":"https://github.com/godotengine/godot/issues/114608#issuecomment-3799826472","issue_url":"https://api.github.com/repos/godotengine/godot/issues/114608","id":3799826472,"node_id":"IC_kwDOAO6SJc7ifMAo","user":{"login":"Sylfa","id":4145461,"node_id"