[{"id":2352577299,"node_id":"PRR_kwDOAO6SJc6MOXsT","state":"CHANGES_REQUESTED","user":{"site_admin":false,"suspended":false,"updated_at":"0001-01-01T00:00:00Z","avatar_url":"https://avatars.githubusercontent.com/u/145553014?u=d04f07a57bed4e339dc61c1997dc3a96c3bea8ca&v=4","created_at":"0001-01-01T00:00:00Z","followers":0,"following":0,"html_url":"https://github.com/tetrapod00","id":145553014,"node_id":"U_kgDOCKz2dg","login":"tetrapod00","type":"User","owned_private_repos":0,"public_gists":0,"public_repos":0,"total_private_repos":0,"url":"https://api.github.com/users/tetrapod00"},"body":"Reviewing functionality, not code:\r\nTested the new version with the arrows. It works great for both typical editor usage and the pathological MRP. I like this solution, it feels very natural.\r\n\r\nThe arrows should be either disabled (grayed out and non-interactive) or completely hidden when all the buttons fit horizontally  (which is most of the time, in typical editor usage). I would personally prefer being hidden entirely, since in typical editor usage you should never need to use these arrows. But you can find a precedent for either hiding or disabling within the `BottomPanel` itself (toast notifications are disabled/enabled, but the expand vertically button hides and unhides).","html_url":"https://github.com/godotengine/godot/pull/97878#pullrequestreview-2352577299","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/97878","author_association":"CONTRIBUTOR","submitted_at":"2024-10-07T17:43:33Z"},{"id":2352927115,"node_id":"PRR_kwDOAO6SJc6MPtGL","state":"COMMENTED","user":{"site_admin":false,"suspended":false,"updated_at":"0001-01-01T00:00:00Z","avatar_url":"https://avatars.githubusercontent.com/u/2223172?u=fc85633b469acb6e7baef4dba5171f19a2a4ff85&v=4","created_at":"0001-01-01T00:00:00Z","followers":0,"following":0,"html_url":"https://github.com/KoBeWi","id":2223172,"node_id":"MDQ6VXNlcjIyMjMxNzI=","login":"KoBeWi","type":"User","owned_private_repos":0,"p