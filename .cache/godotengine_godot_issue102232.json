sers/Repiteo/received_events","type":"User","user_view_type":"public","site_admin":false},"open_issues":3,"closed_issues":2978,"state":"closed","created_at":"2025-05-22T16:25:52Z","updated_at":"2026-10-04T16:23:23Z","due_on":null,"closed_at":"2026-01-26T18:09:14Z"},"comments":2,"created_at":"2025-01-31T08:20:08Z","updated_at":"2025-11-25T15:57:14Z","closed_at":"2025-11-25T15:56:49Z","assignee":null,"author_association":"MEMBER","issue_field_values":[],"type":null,"active_lock_reason":null,"draft":false,"pull_request":{"url":"https://api.github.com/repos/godotengine/godot/pulls/102232","html_url":"https://github.com/godotengine/godot/pull/102232","diff_url":"https://github.com/godotengine/godot/pull/102232.diff","patch_url":"https://github.com/godotengine/godot/pull/102232.patch","merged_at":"2025-11-25T15:56:49Z"},"body":"Not sure if there's much practical use for it. But opening this PR, since I have already implemented it while experimenting with UIDs.\r\n\r\n- Can be used to store random data attached to files, or to manipulate some existing properties like macOS `com.apple.quarantine` and Windows `Zone.Identifier`.\r\n\r\nUsage examples:\r\n\r\n```gdscript\r\nvar fn = \"res://test.yml\"\r\n\r\nFileAccess.set_extened_attribute_string(fn, \"org.godot.test1\", \"string 1\") # Store string attribute.\r\nFileAccess.set_extened_attribute(fn, \"org.godot.test2\", [ 20, 20, 50, 60 ]) # Store data attribute.\r\n\r\nvar attribs = FileAccess.list_extened_attributes(fn) # List attributes.\r\nprint(attribs) # Prints [..., \"org.godot.test1\", \"org.godot.test2\"]\r\n\r\nvar str = FileAccess.get_extened_attribute_string(fn, \"org.godot.test1\") # Read string attribute.\r\nvar data = FileAccess.get_extened_attribute(fn, \"org.godot.test2\") # Read data attribute.\r\n\r\nFileAccess.remove_extened_attribute(fn, \"org.godot.test1\") # Remove attrribute.\r\nFileAccess.remove_extened_attribute(fn, \"org.godot.test2\")\r\n```","closed_by":{"login":"Repiteo","id":17489292,"node_id":"