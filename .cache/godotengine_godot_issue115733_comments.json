sts{/gist_id}","starred_url":"https://api.github.com/users/msim/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/msim/subscriptions","organizations_url":"https://api.github.com/users/msim/orgs","repos_url":"https://api.github.com/users/msim/repos","events_url":"https://api.github.com/users/msim/events{/privacy}","received_events_url":"https://api.github.com/users/msim/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-02-03T03:34:39Z","updated_at":"2026-02-03T03:34:39Z","body":"Figured it out.  It's wayland.  Editor -> Editor settings... -> Run -> Platforms -> Linux/*BSD -> Prefer Wayland.\n\nOn ---> Mouse nav buttons are backwards.\nOff ---> Buttons are correct.\n\nConfirmed in a clean user account.","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3838853759/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3838895684","html_url":"https://github.com/godotengine/godot/issues/115733#issuecomment-3838895684","issue_url":"https://api.github.com/repos/godotengine/godot/issues/115733","id":3838895684,"node_id":"IC_kwDOAO6SJc7k0OZE","user":{"login":"msim","id":976957,"node_id":"MDQ6VXNlcjk3Njk1Nw==","avatar_url":"https://avatars.githubusercontent.com/u/976957?v=4","gravatar_id":"","url":"https://api.github.com/users/msim","html_url":"https://github.com/msim","followers_url":"https://api.github.com/users/msim/followers","following_url":"https://api.github.com/users/msim/following{/other_user}","gists_url":"https://api.github.com/users/msim/gists{/gist_id}","starred_url":"https://api.github.com/users/msim/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/msim/subscriptions","organizations_url":"https://api.github.com/users/msim/orgs","