actions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3738331132","html_url":"https://github.com/godotengine/godot/issues/114865#issuecomment-3738331132","issue_url":"https://api.github.com/repos/godotengine/godot/issues/114865","id":3738331132,"node_id":"IC_kwDOAO6SJc7e0mf8","user":{"login":"AThousandShips","id":96648715,"node_id":"U_kgDOBcK-Cw","avatar_url":"https://avatars.githubusercontent.com/u/96648715?v=4","gravatar_id":"","url":"https://api.github.com/users/AThousandShips","html_url":"https://github.com/AThousandShips","followers_url":"https://api.github.com/users/AThousandShips/followers","following_url":"https://api.github.com/users/AThousandShips/following{/other_user}","gists_url":"https://api.github.com/users/AThousandShips/gists{/gist_id}","starred_url":"https://api.github.com/users/AThousandShips/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/AThousandShips/subscriptions","organizations_url":"https://api.github.com/users/AThousandShips/orgs","repos_url":"https://api.github.com/users/AThousandShips/repos","events_url":"https://api.github.com/users/AThousandShips/events{/privacy}","received_events_url":"https://api.github.com/users/AThousandShips/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-01-12T12:31:00Z","updated_at":"2026-01-12T12:31:00Z","body":"That would be relevant on its own agreed, but not related to changing of `ui_cancel`\n\nBut I'd suggest opening a [proposal](https://github.com/godotengine/godot-proposals) *specifically* for the ability to prevent that, and with clear use cases and options\n\nBut there are cases where locking in edit could break things and prevent the user from interacting correctly, so alternatives to discuss would also be ways to restore focus correctly in cases where the focu