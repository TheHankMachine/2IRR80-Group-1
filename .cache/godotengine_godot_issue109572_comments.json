atars.githubusercontent.com/u/96648715?v=4","gravatar_id":"","url":"https://api.github.com/users/AThousandShips","html_url":"https://github.com/AThousandShips","followers_url":"https://api.github.com/users/AThousandShips/followers","following_url":"https://api.github.com/users/AThousandShips/following{/other_user}","gists_url":"https://api.github.com/users/AThousandShips/gists{/gist_id}","starred_url":"https://api.github.com/users/AThousandShips/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/AThousandShips/subscriptions","organizations_url":"https://api.github.com/users/AThousandShips/orgs","repos_url":"https://api.github.com/users/AThousandShips/repos","events_url":"https://api.github.com/users/AThousandShips/events{/privacy}","received_events_url":"https://api.github.com/users/AThousandShips/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-08-13T14:01:54Z","updated_at":"2025-08-13T14:01:54Z","body":"Please describe the problem in more detail, and add an MRP to clarify the specifics, the screenshots are not easy to read and lack context. What do you mean by \"singleton namespace\"? That's not a term I'm familiar with and I can't find it anywhere. GDScript does not have namespaces. Do you mean global classes?","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3184068914/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3184202852","html_url":"https://github.com/godotengine/godot/issues/109572#issuecomment-3184202852","issue_url":"https://api.github.com/repos/godotengine/godot/issues/109572","id":3184202852,"node_id":"IC_kwDOAO6SJc69yxRk","user":{"login":"nbaum","id":335497,"node_id":"MDQ6VXNlcjMzNTQ5Nw==","avatar_url":"https://avatars.githubusercontent.com/u/335497?v=4","gravatar_id":"","url":"https://api.github.com/users/nbaum","html_url":"https://github.com/nbaum","followers_url":"https://api.github.com/users/nbaum/followers","following_url":"https://api.github.com/users/nbaum/following{/other_user}","gists_url":"https://api.github.com/users/nbaum/gists{/gist_id}","starred_url":"https://api.github.com/users/nbaum/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/nbaum/subscriptions","organizations_url":"https://api.github.com/users/nbaum/orgs","repos_url":"https://api.github.com/users/nbaum/repos","events_url":"https://api.github.com/users/nbaum/events{/privacy}","received_events_url":"https://api.github.com/users/nbaum/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-08-13T14:37:20Z","updated_at":"2025-08-13T14:37:20Z","body":"The issue as I understand it: if you add a doc-comment to a class, it'll show up when you hover over the class name in a script. But if you make an autoload global for the class, the doc-comment doesn't show up for that global.\n\nWhile this is probably technically reasonable behaviour - the autoload global isn't actually the class, so it doesn't have the class's documentation - it does mean you can't make in-editor documentation for an autoload global.\n\ne.g. Given Thing is a class_name and TheThing is an autoload global for the same class.\n\n<img width=\"774\" height=\"128\" alt=\"Image\" src=\"https://github.com/user-attachments/assets/4348ed18-8c12-4381-9118-72829c3772ff\" />\n\nbut\n\n<img width=\"797\" height=\"132\" alt=\"Image\" src=\"https://github.com/user-attachments/assets/98018619-9520-43eb-8200-789e1ab8f685\" />\n\nHere's an MRP:\n\n[bug-autoload-doccomment_2025-08-13_15-29-06.zip](https://github.com/user-attachments/files/21756778/bug-autoload-doccomment_2025-08-13_15-29-06.zip)\n\n(Confirmed for me on v4.5.beta.double.custom_build [2d113cc22])","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3184202852/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3184211158","html_url":"https://github.com/godotengine/godot/issues/109572#issuecomment-3184211158","issue_url":"https://api.github.com/repos/godotengine/godot/issues/109572","id":3184211158,"node_id":"IC_kwDOAO6SJc69yzTW","user":{"login":"AThousandShips","id":96648715,"node_id":"U_kgDOBcK-Cw","avatar_url":"https://avatars.githubusercontent.com/u/96648715?v=4","gravatar_id":"","url":"https://api.github.com/users/AThousandShips","html_url":"https://github.com/AThousandShips","followers_url":"https://api.github.com/users/AThousandShips/followers","following_url":"https://api.github.com/users/AThousandShips/following{/other_user}","gists_url":"https://api.github.com/users/AThousandShips/gists{/gist_id}","starred_url":"https://api.github.com/users/AThousandShips/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/AThousandShips/subscriptions","organizations_url":"https://api.github.com/users/AThousandShips/orgs","repos_url":"https://api.github.com/users/AThousandShips/repos","events_url":"https://api.github.com/users/AThousandShips/events{/privacy}","received_events_url":"https://api.github.com/users/AThousandShips/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-08-13T14:39:35Z","updated_at":"2025-08-13T14:39:35Z","body":"That's to be expected I'd say as an autoload global isn't the class but a node, as you can see it's hierarchy isn't shown either, without using `class_name` you don't get a named class and don't get the documentation associated with it\n\nYou can't, for example, do `TheThing.new()` in this case right? That's because it's a node, not a class","author_association":"MEMBER","pin":nul