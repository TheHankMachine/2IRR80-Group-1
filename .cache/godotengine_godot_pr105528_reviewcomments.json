.com/godotengine/godot/pull/105528#discussion_r2061220432"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/105528"}},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/2061220432/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":1324,"start_side":"LEFT","line":null,"original_line":1326,"side":"RIGHT","author_association":"CONTRIBUTOR","original_position":4,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/2061221217","pull_request_review_id":2795822303,"id":2061221217,"node_id":"PRRC_kwDOAO6SJc56271h","diff_hunk":"@@ -1476,8 +1477,10 @@ class GDScriptParser {\n \t// Setting p_force to false will prevent the completion context from being update if a context was already set before.\n \t// This should only be done when we push context before we consumed any tokens for the corresponding structure.\n \t// See parse_precedence for an example.\n-\tvoid make_completion_context(CompletionType p_type, Node *p_node, int p_argument = -1, bool p_force = true);\n-\tvoid make_completion_context(CompletionType p_type, Variant::Type p_builtin_type, bool p_force = true);\n+\tbool make_completion_context(CompletionType p_type, Node *p_node, bool p_force = true);\n+\tvoid make_completion_context_argument(CompletionType p_type, Node *p_node, int p_argument, bool p_force = true);\n+\tvoid make_completion_context_bultin_type(CompletionType p_type, Variant::Type p_builtin_type, bool p_force = true);\n+\tvoid make_completion_context_virtual_method(CompletionType p_type, Node *p_node, bool p_has_param_parenthesis, bool p_force = true);","path":"modules/gdscript/gdscript_parser.h","commit_id":"999c504fa8911d9da1152e72c15ace981f898de5","original_commit_id":"2b4981adf9f60650a00c27ca18c2a5bbe7118d1b","user":{"login":"tehKaiN","id":16180344,"node_id":"MDQ6VXNlcjE2MTgwMzQ0","avatar_url":"https://avatars.githubusercontent.com/u/16180344?v=4","gravatar_id":"","url":"https://api.github.com/users/tehKaiN","html_url":"https://github.com/tehKaiN","followers_url":"https://api.github.com/users/tehKaiN/followers","following_url":"https://api.github.com/users/tehKaiN/following{/other_user}","gists_url":"https://api.github.com/users/tehKaiN/gists{/gist_id}","starred_url":"https://api.github.com/users/tehKaiN/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/tehKaiN/subscriptions","organizations_url":"https://api.github.com/users/tehKaiN/orgs","repos_url":"https://api.github.com/users/tehKaiN/repos","events_url":"https://api.github.com/users/tehKaiN/events{/privacy}","received_events_url":"https://api.github.com/users/tehKaiN/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"Adding another param to `make_completion_context` with my bool felt silly and I couldn't really make an overload without colliding `p_argument` with `p_has_param_parenthesis`, so I figured it's best to split those methods to keep the param count low. This also deduplicates the code a bit.\r\n\r\nUltimately my variant of the method didn't proved to be *that* critical, but I'd argue that this refactor makes the intent more apparent across the codebase.","created_at":"2025-04-26T08:14:57Z","updated_at":"2025-04-26T08:19:16Z","html_url":"https://github.com/godotengine/godot/pull/105528#discussion_r2061221217","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/105528","_links":{"self":{"href":"https://api.github.com/repos/godotengine/godot/pulls/comments/2061221217"},"html":{"href":"https://github.com/godotengine/godot/pull/105528#discussion_r2061221217"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/105528"}},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/2061221217/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":1480,"start_side":"RIGHT","line":null,"original_line":1483,"side":"RIGHT","author_association":"CONTRIBUTOR","original_position":17,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/2061221639","pull_request_review_id":2795822303,"id":2061221639,"node_id":"PRRC_kwDOAO6SJc56278H","diff_hunk":"@@ -1630,7 +1630,7 @@ GDScriptParser::FunctionNode *GDScriptParser::parse_function(bool p_is_static) {\n \tcurrent_suite = body;\n \n \tpush_multiline(true);\n-\tconsume(GDScriptTokenizer::Token::PARENTHESIS_OPEN, R\"(Expected opening \"(\" after function name.)\");\n+\tcompletion_context.has_param_parenthesis = consume(GDScriptTokenizer::Token::PARENTHESIS_OPEN, R\"(Expected opening \"(\" after function name.)\");","path":"modules/gdscript/gdscript_parser.cpp","commit_id":"999c504fa8911d9da1152e72c15ace981f898de5","original_commit_id":"2b4981adf9f60650a00c27ca18c2a5bbe7118d1b","user":{"login":"tehKaiN","id":16180344,"node_id":"MDQ6VXNlcjE2MTgwMzQ0","avatar_url":"https://avatars.githubusercontent.com/u/16180344?v=4","gravatar_id":"","url":"https://api.github.com/users/tehKaiN","html_url":"https://github.com/tehKaiN","followers_url":"https://api.github.com/users/tehKaiN/followers","following_url":"https://api.github.com/users/tehKaiN/following{/other_user}","gists_url":"https://api.github.com/users/tehKaiN/gists{/gist_id}","starred_url":"https://api.github.com/users/tehKaiN/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/tehKaiN/subscriptions","organizations_url":"https://api.github.com/users/tehKaiN/orgs","repos_url":"https://api.github.com/users/tehKaiN/repos","events_url":"https://api.github.com/users/tehKaiN/events{/privacy}","received_events_url":"https://api.github.com/users/tehKaiN/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"I don't like that, because it doesn't mimic creating all the context at once as seen in every other instance, but I'm not sure what to do with it. I could call `make_completion_context_virtual_method()` here with proper bool this time, but seems like an overkill.\r\n\r\nThe previous call must stay where it is due to an early return.\r\nI could get rid of an early return, but I'm not sure what's the policy on `if`s that span across almost whole function body.","created_at":"2025-04-26T08:18:16Z","updated_at":"2025-04-26T08:19:48Z","html_url":"https://github.com/godotengine/godot/pull/105528#discussion_r2061221639","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/105528","_links":{"self":{"href":"https://api.github.com/repos/godotengine/godot/pulls/comments/2061221639"},"html":{"href":"https://github.com/godotengine/godot/pull/105528#discussion_r2061221639"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/105528"}},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/2061221639/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":null,"original_line":1633,"side":"RIGHT","author_association":"CONTRIBUTOR","original_position":98,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/2064456628","pull_request_review_id":2800584648,"id":2064456628,"node_id":"PRRC_kwDOAO6SJc57DRu0","diff_hunk":"@@ -1630,7 +1630,7 @@ GDScriptParser::FunctionNode *GDScriptParser::parse_function(bool p_is_static) {\n \tcurrent_suite = body;\n \n \tpush_multiline(true);\n-\tconsume(GDScriptTokenizer::Token::PARENTHESIS_OPEN, R\"(Expected opening \"(\" after function name.)\");\n+\tcompletion_context.has_param_parenthesis = consume(GDScriptTokenizer::Token::PARENTHESIS_OPEN, R\"(Expected opening \"(\" after function name.)\");","path":"modules/gdscript/gdscript_parser.cpp","commit_id":"999c504fa8911d9da1152e72