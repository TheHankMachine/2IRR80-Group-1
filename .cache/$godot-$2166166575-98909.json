idth=\"1270\" alt=\"Screenshot 2024-11-07 at 3 13 28 PM\" src=\"https://github.com/user-attachments/assets/5874e1d6-0096-45e6-ba77-e6a0a92407ae\">\r\n\r\nWith both PR #96782 and this PR, it errors and does not extract (the material's texture is directly loaded an image):\r\n\r\n<img width=\"1270\" alt=\"Screenshot 2024-11-07 at 3 10 35 PM\" src=\"https://github.com/user-attachments/assets/d620dee0-3a15-49c9-af64-d4aa1c635326\">\r\n\r\nThe test file here is the MRP in issue #82455 with \"Materials -> Unpack Enabled\" set to false (this option should be renamed to \"Unpack Originals\" in the future).","html_url":"https://github.com/godotengine/godot/pull/98909#pullrequestreview-2422354127","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/98909","author_association":"MEMBER","submitted_at":"2024-11-07T23:17:55Z"},{"id":2470358989,"node_id":"PRR_kwDOAO6SJc6TPq_N","state":"COMMENTED","user":{"site_admin":false,"suspended":false,"updated_at":"0001-01-01T00:00:00Z","avatar_url":"https://avatars.githubusercontent.com/u/1646875?u=24618295fece29a0bf5c850faf2555985232f5f2&v=4","created_at":"0001-01-01T00:00:00Z","followers":0,"following":0,"html_url":"https://github.com/aaronfranke","id":1646875,"node_id":"MDQ6VXNlcjE2NDY4NzU=","login":"aaronfranke","type":"User","owned_private_repos":0,"public_gists":0,"public_repos":0,"total_private_repos":0,"url":"https://api.github.com/users/aaronfranke"},"body":"","html_url":"https://github.com/godotengine/godot/pull/98909#pullrequestreview-2470358989","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/98909","author_association":"MEMBER","submitted_at":"2024-11-29T17:38:27Z"},{"id":2508104068,"node_id":"PRR_kwDOAO6SJc6VfqGE","state":"APPROVED","user":{"site_admin":false,"suspended":false,"updated_at":"0001-01-01T00:00:00Z","avatar_url":"https://avatars.githubusercontent.com/u/1646875?u=24618295fece29a0bf5c850faf2555985232f5f2&v=4","created_at":"0001-01-01T00:00:00Z","followers":0,"following":