ate, const Variant &p_variant) {\n \tswitch (p_state) {\n-\t\tcase PhysicsServer::BODY_STATE_TRANSFORM:\n+\t\tcase PhysicsServer::BODY_STATE_TRANSFORM: {\n+\t\t\tuint32_t tick = Engine::get_singleton()->get_physics_frames();\n+\n+\t\t\t// Waking up neighbours at this point is the AABB prior to that when this\n+\t\t\t// new transform has been set.\n+\t\t\t// The \"forward\" move is woken up elsewhere.\n+\t\t\t// As an optimization, only wake up neighbours here if we are not in continuous motion,\n+\t\t\t// as this is more likely to be a situation where we are moving out of the zone of a sleeping body.\n+\t\t\t// This check is not hugely expensive, but would be overkill to do as well as the forward motion\n+\t\t\t// when in continuous motion.\n+\t\t\tif (previous_move_tick < (tick - 1)) {","path":"modules/bullet/rigid_body_bullet.cpp","commit_id":"8972bb10a953a61de099fb88fdff004c1231b6ce","original_commit_id":"b41b45c518b847b2bb58ef5452fad5f397f4e7cc","user":{"login":"jrouwe","id":1621693,"node_id":"MDQ6VXNlcjE2MjE2OTM=","avatar_url":"https://avatars.githubusercontent.com/u/1621693?v=4","gravatar_id":"","url":"https://api.github.com/users/jrouwe","html_url":"https://github.com/jrouwe","followers_url":"https://api.github.com/users/jrouwe/followers","following_url":"https://api.github.com/users/jrouwe/following{/other_user}","gists_url":"https://api.github.com/users/jrouwe/gists{/gist_id}","starred_url":"https://api.github.com/users/jrouwe/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/jrouwe/subscriptions","organizations_url":"https://api.github.com/users/jrouwe/orgs","repos_url":"https://api.github.com/users/jrouwe/repos","events_url":"https://api.github.com/users/jrouwe/events{/privacy}","received_events_url":"https://api.github.com/users/jrouwe/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"I don't understand how this works. The comment seems to suggest something else than what the code does.","created_at":"2026-10-13T19:47:06Z","updated_at":"2026-10-13T19:52:52Z","html_url":"https://github.com/godotengine/godot/pull/124422#discussion_r4263258031","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/124422","_links":{"self":{"href":"https://api.github.com/repos/godotengine/godot/pulls/comments/4263258031"},"html":{"href":"https://github.com/godotengine/godot/pull/124422#discussion_r4263258031"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/124422"}},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/4263258031/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":null,"original_line":603,"side":"RIGHT","author_association":"CONTRIBUTOR","original_position":36,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/4267182596","pull_request_review_id":5513529806,"id":4267182596,"node_id":"PRRC_kwDOAO6SJc7-WAoE","diff_hunk":"@@ -485,6 +485,56 @@ void SpaceBullet::reload_collision_filters(AreaBullet *p_area) {\n \tdynamicsWorld->refreshBroadphaseProxy(ghost_object);\n }\n \n+void SpaceBullet::rigid_body_wake_neighbors(RigidBodyBullet *p_body) {\n+\tstruct WakeNeighborsCallback : public btBroadphaseAabbCallback {","path":"modules/bullet/space_bullet.cpp","commit_id":"702f761cf9b93ad9632d7068d902b1149b298b0c","original_commit_id":"b41b45c518b847b2bb58ef5452fad5f397f4e7cc","user":{"login":"lawnjelly","id":21999379,"node_id":"MDQ6VXNlcjIxOTk5Mzc5","avatar_url":"https://avatars.githubusercontent.com/u/21999379?v=4","gravatar_id":"","url":"https://api.github.com/users/lawnjelly","html_url":"https://github.com/lawnjelly","followers_url":"https://api.github.com/users/lawnjelly/followers","following_url":"https://api.github.com/users/lawnjelly/following{/other_user}","gists_url":"https://api.github.com/users/lawnjelly/gists{/gist_id}","starred_url":"https://api.github.com/users/lawnjelly/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/lawnjelly/subscriptions","organizations_url":"https://api.github.com/users/lawnjelly/orgs","repos_url":"https://api.github.com/users/lawnjelly/repos","events_url":"https://api.github.com/users/lawnjelly/events{/privacy}","received_events_url":"https://api.github.com/users/lawnjelly/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"That's a great idea, I need to check this is the case though with static and kinematics (the main reason for the change). Despite the naming convention in bullet, `RigidBodyBullet` seems to contain the statics and kinematics.\r\n\r\nI'm not sure we will be able to sensibly make use of the awake status though in all cases:\r\n* for statics / kinematics being moved via `set_translate()`, they are effectively being teleported, so the normal waking mechanisms have been bypassed (no forces were involved)\r\n* for rigid bodies, they don't call `set_translate()` (as the data flow is one way from the server to Godot), thus `wake_neighbors()` never gets called, _except_ in the case of explicitly the user calling `set_translate()`, which _is_ a teleport and should call `wake_neighbours()`.\r\n\r\n> in that case you can assume that objects touching it will be awake too\r\n\r\nSo I don't think this assumption holds _in all cases_.\r\n\r\nI'll see whether it can be added though, e.g. just for `RigidBodies`.\r\n","created_at":"2026-10-14T05:40:34Z","updated_at":"2026-10-14T08:05:55Z","html_url":"https://github.com/godotengine/godot/pull/124422#discussion_r4267182596","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/124422","_links":{"self":{"href":"https://api.github.com/repos/godotengine/godot/pulls/comments/4267182596"},"html":{"href":"https://github.com/godotengine/godot/pull/124422#discussion_r4267182596"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/124422"}},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/4267182596/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":489,"original_line":489,"side":"RIGHT","in_reply_to_id":4263249168,"author_association":"MEMBER","original_position":5,"position":5,"subject_type":"line"},{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/4267214560","pull_request_review_id":5513573122,"id":4267214560,"node_id":"PRRC_kwDOAO6SJc7-WIbg","diff_hunk":"@@ -185,6 +185,8 @@ class PhysicsServerSW : public PhysicsServer {\n \tvirtual void body_set_user_flags(RID p_body, uint32_t p_flags);\n \tvirtual uint32_t body_get_user_flags(RID p_body) const;\n \n+\tvirtual void body_wake_neighbors(RID p_body);","path":"servers/physics/physics_server_sw.h","commit_id":"702f761cf9b93ad9632d7068d902b1149b298b0c","original_commit_id":"b41b45c518b847b2bb58ef5452fad5f397f4e7cc","user":{"login":"lawnjelly","id":21999379,"node_id":"MDQ6VXNlcjIxOTk5Mzc5","avatar_url":"https://avatars.githubusercontent.com/u/21999379?v=4","gravatar_id":"","url":"https://api.github.com/users/lawnjelly","html_url":"https://github.com/lawnjelly","followers_url":"https://api.github.com/users/lawnjelly/followers","following_url":"https://api.github.com/users/lawnjelly/following{/other_user}","gists_url":"https://api.github.com/users/lawnjelly/gists{/gist_id}","starred_url":"https://api.github.com/users/lawnjelly/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/lawnjelly/subscriptions","organizations_url":"https://api.github.com/users/lawnjelly/orgs","repos_url":"https://api.github.com/users/lawnjelly/repos","events_url":"https://api.github.com/users/lawnjelly/events{/privacy}","received_events_url":"https://api.github.com/users/lawnjelly/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"Agreed - but is there a case here where we think waking up multiple bodies will be needed? :thinking: \r\n\r\n(I'm assuming here that bodies being _added_ will wakeup via the normal mechanism of `set_translate()` which we've made always cause a wakeup in both backends in this PR).","created_at":"2026-10-14T05:45:30Z","updated_at":"2026-10-14T05:45:31Z","html_url":"https://github.com/godotengine/godot/pull/124422#discussion_r4267214560","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/124422","_links":{"self":{"href":"https://api.github.com/repos/godotengine/godot/pulls/comments/4267214560"},"html":{"href":"https://github.com/godotengine/godot/pull/124422#discussion_r4267214560"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/124422"}},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/4267214560/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":188,"original_line":188,"side":"RIGHT","in_reply_to_id":4263226915,"author_association":"MEMBER","original_position":4,"position":4,"subject_type":"line"},{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/4267248963","pull_request_review_id":5513614452,"id":4267248963,"node_id":"PRRC_kwDOAO6SJc7-WQ1D","diff_hunk":"@@ -583,9 +590,23 @@ PhysicsServer::BodyMode RigidBodyBullet::get_mode() const {\n \n void RigidBodyBullet::set_state(PhysicsServer::BodyState p_state, const Variant &p_variant) {\n \tswitch (p_state) {\n-\t\tcase PhysicsServer::BODY_STATE_TRANSFORM:\n+\t\tcase PhysicsServer::BODY_STATE_TRANSFORM: {\n+\t\t\tuint32_t tick = Engine::get_singleton()->get_physics_frames();\n+\n+\t\t\t// Waking up neighbours at this point is the AABB prior to that when this\n+\t\t\t// new transform has been set.\n+\t\t\t// The \"forward\" move is woken up elsewhere.\n+\t\t\t// As an optimization, only wake up neighbours here if we are not in continuous motion,\n+\t\t\t// as this is more likely to be a situation where we are moving out of the zone of a sleeping body.\n+\t\t\t// This check is not hugely expensive, but would be overkill to do as well as the forward motion\n+\t\t\t// when in continuous motion.\n+\t\t\tif (previous_move_tick < (tick - 1)) {","path":"modules/bullet/rigid_body_bullet.cpp","commit_id":"8972bb10a953a61de099fb88fdff004c1231b6ce","original_commit_id":"b41b45c518b847b2bb58ef5452fad5f397f4e7cc","user":{"login":"lawnjelly","id":21999379,"node_id":"MDQ6VXNlcjIxOTk5Mzc5","avatar_url":"https://avatars.githubusercontent.com/u/21999379?v=4","gravatar_id":"","url":"https://api.github.com/users/lawnjelly","html_url":"https://github.com/lawnjelly","followers_url":"https://api.github.com/users/lawnjelly/followers","following_url":"https://api.github.com/users/lawnjelly/following{/other_user}","gists_url":"https://api.github.com/users/lawnjelly/gists{/gist_id}","starred_url":"https://api.github.com/users/lawnjelly/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/lawnjelly/subscriptions","organizations_url":"https://api.github.com/users/lawnjelly/orgs","repos_url":"https://api.github.com/users/lawnjelly/repos","events_url":"https://api.github.com/users/lawnjelly/events{/privacy}","received_events_url":"https://api.github.com/users/lawnjelly/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"Ah the last comment sentence is outdated, due to revisions on the PR, and the earlier could be clearer, I'll try and improve.\r\n\r\nThis is a common pattern:\r\n* store the tick we last operated on the object\r\n* if the stored \"previous\" tick on the object is less than the previous tick, then we know we aren't hitting this object _per tick_ (and thus it runs the if clause)\r\n\r\nIn most cases if we are moving kinematic / static about continuously, it will be done every tick. When an object has recently been moved, by definition, there is no need to wakeup the previous AABB, because it will have already been woken up as the new AABB in the previous tick.","created_at":"2026-10-14T05:51:07Z","updated_at":"2026-10-14T05:51:07Z","html_url":"https://github.com/godotengine/godot/pull/124422#discussion_r4267248963","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/124422","_links":{"self":{"href":"https://api.github.com/repos/godotengine/godot/pulls/comments/4267248963"},"html":{"href":"https://github.com/godotengine/godot/pull/124422#discussion_r4267248963"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/124422"}},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/4267248963/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":null,"original_line":603,"side":"RIGHT","in_reply_to_id":4263258031,"author_association":"MEMBER","original_position":36,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/4268070303","pull_request_review_id":5514620377,"id":4268070303,"node_id":"PRRC_kwDOAO6SJc7-ZZWf","diff_hunk":"@@ -583,9 +590,23 @@ PhysicsServer::BodyMode RigidBodyBullet::get_mode() const {\n \n void RigidBodyBullet::set_state(PhysicsServer::BodyState p_state, const Variant &p_variant) {\n \tswitch (p_state) {\n-\t\tcase PhysicsServer::BODY_STATE_TRANSFORM:\n+\t\tcase PhysicsServer::BODY_STATE_TRANSFORM: {\n+\t\t\tuint32_t tick = Engine::get_singleton()->get_physics_frames();\n+\n+\t\t\t// Waking up neighbours at this point is the AABB prior to that when this\n+\t\t\t// new transform has been set.\n+\t\t\t// The \"forward\" move is woken up elsewhere.\n+\t\t\t// As an optimization, only wake up neighbours here if we are not in continuous motion,\n+\t\t\t// as this is more likely to be a situation where we are movin