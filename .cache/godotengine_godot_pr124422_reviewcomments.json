ck = Engine::get_singleton()->get_physics_frames();\n+\n+\t\t\t// Waking up neighbours at this point is the AABB prior to that when this\n+\t\t\t// new transform has been set.\n+\t\t\t// The \"forward\" move is woken up elsewhere.\n+\t\t\t// As an optimization, only wake up neighbours here if we are not in continuous motion,\n+\t\t\t// as this is more likely to be a situation where we are moving out of the zone of a sleeping body.\n+\t\t\t// This check is not hugely expensive, but would be overkill to do as well as the forward motion\n+\t\t\t// when in continuous motion.\n+\t\t\tif (previous_move_tick < (tick - 1)) {","path":"modules/bullet/rigid_body_bullet.cpp","commit_id":"8972bb10a953a61de099fb88fdff004c1231b6ce","original_commit_id":"b41b45c518b847b2bb58ef5452fad5f397f4e7cc","user":{"login":"lawnjelly","id":21999379,"node_id":"MDQ6VXNlcjIxOTk5Mzc5","avatar_url":"https://avatars.githubusercontent.com/u/21999379?v=4","gravatar_id":"","url":"https://api.github.com/users/lawnjelly","html_url":"https://github.com/lawnjelly","followers_url":"https://api.github.com/users/lawnjelly/followers","following_url":"https://api.github.com/users/lawnjelly/following{/other_user}","gists_url":"https://api.github.com/users/lawnjelly/gists{/gist_id}","starred_url":"https://api.github.com/users/lawnjelly/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/lawnjelly/subscriptions","organizations_url":"https://api.github.com/users/lawnjelly/orgs","repos_url":"https://api.github.com/users/lawnjelly/repos","events_url":"https://api.github.com/users/lawnjelly/events{/privacy}","received_events_url":"https://api.github.com/users/lawnjelly/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"Yup, that's why I put it in inverted commas. \"previous\" is obvious, but calling it \"new AABB\" seems a bit vague (especially when discussing the previous tick), so I was trying to use a term like \"next\" or \"forward\" (as in forward / backward in time).\r\n\r\nBut any better suggestions for the commenting welcome. :+1: ","created_at":"2026-10-15T04:47:58Z","updated_at":"2026-10-15T05:36:19Z","html_url":"https://github.com/godotengine/godot/pull/124422#discussion_r4279109989","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/124422","_links":{"self":{"href":"https://api.github.com/repos/godotengine/godot/pulls/comments/4279109989"},"html":{"href":"https://github.com/godotengine/godot/pull/124422#discussion_r4279109989"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/124422"}},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/4279109989/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":null,"original_line":603,"side":"RIGHT","in_reply_to_id":4263258031,"author_association":"MEMBER","original_position":36,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/4281897048","pull_request_review_id":5531754641,"id":4281897048,"node_id":"PRRC_kwDOAO6SJc7_OJBY","diff_hunk":"@@ -185,6 +185,8 @@ class PhysicsServerSW : public PhysicsServer {\n \tvirtual void body_set_user_flags(RID p_body, uint32_t p_flags);\n \tvirtual uint32_t body_get_user_flags(RID p_body) const;\n \n+\tvirtual void body_wake_neighbors(RID p_body);","path":"servers/physics/physics_server_sw.h","commit_id":"702f761cf9b93ad9632d7068d902b1149b298b0c","original_commit_id":"b41b45c518b847b2bb58ef5452fad5f397f4e7cc","user":{"login":"lawnjelly","id":21999379,"node_id":"MDQ6VXNlcjIxOTk5Mzc5","avatar_url":"https://avatars.githubusercontent.com/u/21999379?v=4","gravatar_id":"","url":"https://api.github.com/users/lawnjelly","html_url":"https://github.com/lawnjelly","followers_url":"https://api.github.com/users/lawnjelly/followers","following_url":"https://api.github.com/users/lawnjelly/following{/other_user}","gists_url":"https://api.github.com/users/lawnjelly/gists{/gist_id}","starred_url":"https://api.github.com/users/lawnjelly/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/lawnjelly/subscriptions","organizations_url":"https://api.github.com/users/lawnjelly/orgs","repos_url":"https://api.github.com/users/lawnjelly/repos","events_url":"https://api.github.com/users/lawnjelly/events{/privacy}","received_events_url":"https://api.github.com/users/lawnjelly/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"Yes, just been discussing ragdolls with @Schnorg - I wasn't familiar with them and indeed they sound like a pain with multiple bodies.\r\n\r\nSome things we came up with:\r\n* handle ragdolls in a separate API call\r\n* have the backend automatically use knowledge of links to auto-wake up everything connected, so if you e.g. woke up a hip bone it would wake up the whole rag doll\r\n\r\nMy main concern is that the common use case will be `wakeup_neighbors()` for a single body, and it's not super appropriate to be creating e.g. a `vector` each time when the most common case is a single body.\r\n(we are generally moving towards reducing allocations where possible).\r\n\r\nIt would also be possible to pass e.g. a `FixedArray` with a max of say 64 bodies (and use multiple if necessary) but the simpler solution would just be to have another version of the API function for when required, something like `bodies_wakeup_neighbours(Vector<RID> p_bodies)`.\r\n\r\nAnother alternative is to add an additional version like you use in Jolt, something like `wakeup_AABB()` to cope with this case.\r\n\r\nOn the scene side, we could probably have a function on the `Ragdoll` that would do all this transparently.\r\nBut I think that's more appropriate for a follow up PR (unless we do decide to combine into a single API function).","created_at":"2026-10-15T10:33:07Z","updated_at":"2026-10-15T10:35:07Z","html_url":"https://github.com/godotengine/godot/pull/124422#discussion_r4281897048","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/124422","_links":{"self":{"href":"https://api.github.com/repos/godotengine/godot/pulls/comments/4281897048"},"html":{"href":"https://github.com/godotengine/godot/pull/124422#discussion_r4281897048"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/124422"}},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/4281897048/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":188,"original_line":188,"side":"RIGHT","in_reply_to_id":4263226915,"author_association":"MEMBER","original_position":4,"position":4,"subject_type":"line"},{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/4352872117","pull_request_review_id":5620046220,"id":4352872117,"node_id":"PRRC_kwDOAO6SJc8AAAABA3OOtQ","diff_hunk":"@@ -185,6 +185,8 @@ class PhysicsServerSW : public PhysicsServer {\n \tvirtual void body_set_user_flags(RID p_body, uint32_t p_flags);\n \tvirtual uint32_t body_get_user_flags(RID p_body) const;\n \n+\tvirtual void body_wake_neighbors(RID p_body);","path":"servers/physics/physics_server_sw.h","commit_id":"702f761cf9b93ad9632d7068d902b1149b298b0c","original_commit_id":"b41b45c518b847b2bb58ef5452fad5f397f4e7cc","user":{"login":"jrouwe","id":1621693,"node_id":"MDQ6VXNlcjE2MjE2OTM=","avatar_url":"https://avatars.githubusercontent.com/u/1621693?v=4","gravatar_id":"","url":"https://api.github.com/users/jrouwe","html_url":"https://github.com/jrouwe","followers_url":"https://api.github.com/users/jrouwe/followers","following_url":"https://api.github.com/users/jrouwe/following{/other_user}","gists_url":"https://api.github.com/users/jrouwe/gists{/gist_id}","starred_url":"https://api.github.com/users/jrouwe/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/jrouwe/subscriptions","organizations_url":"https://api.github.com/users/jrouwe/orgs","repos_url":"https://api.github.com/users/jrouwe/repos","events_url":"https://api.github.com/users/jrouwe/events{/privacy}","received_events_url":"https://api.github.com/users/jrouwe/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"> have the backend automatically use knowledge of links to auto-wake up everything connected, so if you e.g. woke up a hip bone it would wake up the whole rag doll\n\nNote that Jolt will not be able to do this. By design (to avoid needing mutex locks in multithreading situations) bodies don't know about connected bodies. The `wakeup_AABB` (additional) function seems to make more sense to me.","created_at":"2026-10-22T19:55:10Z","updated_at":"2026-10-22T19:55:10Z","html_url":"https://github.com/godotengine/godot/pull/124422#discussion_r4352872117","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/124422","_links":{"self":{"href":"https://api.github.com/repos/godotengine/godot/pulls/comments/4352872117"},"html":{"href":"https://github.com/godotengine/godot/pull/124422#discussion_r4352872117"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/124422"}},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/4352872117/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":188,"original_line":188,"side":"RIGHT","in_reply_to_id":4263226915,"author_association":"CONTRIBUTOR","original_position":4,"position":4,"subject_type":"line"}]