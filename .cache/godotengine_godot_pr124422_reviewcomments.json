` objects are always active, so we can't use this shortcut for them.\r\n\r\nIt does appear to be valid for `RIGID BODIES`, so I've added it, although there is at least the potential for inconsistencies here so I've added a note to watch for these just in case.\r\n\r\n`CHARACTER BODY` I'm assuming is the same as `RIGID BODY` with some tweaks, and can also be deactivated.","created_at":"2026-10-14T08:41:23Z","updated_at":"2026-10-14T08:41:24Z","html_url":"https://github.com/godotengine/godot/pull/124422#discussion_r4268582069","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/124422","_links":{"self":{"href":"https://api.github.com/repos/godotengine/godot/pulls/comments/4268582069"},"html":{"href":"https://github.com/godotengine/godot/pull/124422#discussion_r4268582069"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/124422"}},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/4268582069/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":489,"original_line":489,"side":"RIGHT","in_reply_to_id":4263249168,"author_association":"MEMBER","original_position":5,"position":5,"subject_type":"line"},{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/4275902963","pull_request_review_id":5524227399,"id":4275902963,"node_id":"PRRC_kwDOAO6SJc7-3Rnz","diff_hunk":"@@ -185,6 +185,8 @@ class PhysicsServerSW : public PhysicsServer {\n \tvirtual void body_set_user_flags(RID p_body, uint32_t p_flags);\n \tvirtual uint32_t body_get_user_flags(RID p_body) const;\n \n+\tvirtual void body_wake_neighbors(RID p_body);","path":"servers/physics/physics_server_sw.h","commit_id":"702f761cf9b93ad9632d7068d902b1149b298b0c","original_commit_id":"b41b45c518b847b2bb58ef5452fad5f397f4e7cc","user":{"login":"jrouwe","id":1621693,"node_id":"MDQ6VXNlcjE2MjE2OTM=","avatar_url":"https:/