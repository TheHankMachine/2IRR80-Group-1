ounding box of this body.\n+\tbtVector3 aabbMin, aabbMax;\n+\tbt_body->getAabb(aabbMin, aabbMax);\n+\n+\t// Pad the top of the bounding box slightly upward (e.g., by 0.05 units)\n+\t// to capture the bounding boxes of anything physically resting on it.\n+\taabbMax.setY(aabbMax.getY() + 0.05f);","path":"modules/bullet/space_bullet.cpp","commit_id":"b41b45c518b847b2bb58ef5452fad5f397f4e7cc","original_commit_id":"b41b45c518b847b2bb58ef5452fad5f397f4e7cc","user":{"login":"jrouwe","id":1621693,"node_id":"MDQ6VXNlcjE2MjE2OTM=","avatar_url":"https://avatars.githubusercontent.com/u/1621693?v=4","gravatar_id":"","url":"https://api.github.com/users/jrouwe","html_url":"https://github.com/jrouwe","followers_url":"https://api.github.com/users/jrouwe/followers","following_url":"https://api.github.com/users/jrouwe/following{/other_user}","gists_url":"https://api.github.com/users/jrouwe/gists{/gist_id}","starred_url":"https://api.github.com/users/jrouwe/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/jrouwe/subscriptions","organizations_url":"https://api.github.com/users/jrouwe/orgs","repos_url":"https://api.github.com/users/jrouwe/repos","events_url":"https://api.github.com/users/jrouwe/events{/privacy}","received_events_url":"https://api.github.com/users/jrouwe/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"Makes the assumption that gravity is -Y. Gravity is configurable in the project settings and bodies can have 'constant forces' in any direction (in 4.x, don't know about 3.x). I think you'll want to pad in all directions.","created_at":"2026-10-13T19:41:55Z","updated_at":"2026-10-13T19:52:52Z","html_url":"https://github.com/godotengine/godot/pull/124422#discussion_r4263208385","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/124422","_links":{"self":{"href":"https://api.github.com/repos/godotengine/godot/pulls/comments/4263208385"},"html":{"href":"https://github.com/godotengine/godot/pull/1