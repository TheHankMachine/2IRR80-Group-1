[{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2736607743","html_url":"https://github.com/godotengine/godot/issues/104202#issuecomment-2736607743","issue_url":"https://api.github.com/repos/godotengine/godot/issues/104202","id":2736607743,"node_id":"IC_kwDOAO6SJc6jHVH_","user":{"login":"Alex2782","id":41921395,"node_id":"MDQ6VXNlcjQxOTIxMzk1","avatar_url":"https://avatars.githubusercontent.com/u/41921395?v=4","gravatar_id":"","url":"https://api.github.com/users/Alex2782","html_url":"https://github.com/Alex2782","followers_url":"https://api.github.com/users/Alex2782/followers","following_url":"https://api.github.com/users/Alex2782/following{/other_user}","gists_url":"https://api.github.com/users/Alex2782/gists{/gist_id}","starred_url":"https://api.github.com/users/Alex2782/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Alex2782/subscriptions","organizations_url":"https://api.github.com/users/Alex2782/orgs","repos_url":"https://api.github.com/users/Alex2782/repos","events_url":"https://api.github.com/users/Alex2782/events{/privacy}","received_events_url":"https://api.github.com/users/Alex2782/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-03-19T13:18:02Z","updated_at":"2025-03-19T13:20:02Z","body":"`Steps to reproduce / Minimal reproduction project (MRP)` might be helpful. \nFrom what it looks like in the video, these aren't the default settings (colors, etc.).","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2736607743/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2737424104","html_url":"https://github.com/godotengine/godot/issues/104202#issuecomment-2737424104","issue_url":"https://api.github.com/repos/godotengine/godot/issues/104202","id":2737424104,"node_id":"IC_kwDOAO6SJc6jKcbo","user":{"login":"Calinou","id":180032,"node_id":"MDQ6VXNlcjE4MDAzMg==","avatar_url":"https://avatars.githubusercontent.com/u/180032?v=4","gravatar_id":"","url":"https://api.github.com/users/Calinou","html_url":"https://github.com/Calinou","followers_url":"https://api.github.com/users/Calinou/followers","following_url":"https://api.github.com/users/Calinou/following{/other_user}","gists_url":"https://api.github.com/users/Calinou/gists{/gist_id}","starred_url":"https://api.github.com/users/Calinou/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Calinou/subscriptions","organizations_url":"https://api.github.com/users/Calinou/orgs","repos_url":"https://api.github.com/users/Calinou/repos","events_url":"https://api.github.com/users/Calinou/events{/privacy}","received_events_url":"https://api.github.com/users/Calinou/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-03-19T17:06:29Z","updated_at":"2025-03-21T23:34:39Z","body":"I can confirm this on 4.4.stable (Linux) in all rendering methods.\n\nThe Overdraw, Lighting and PSSM Splits debug draw modes override the shader for all visible 3D nodes in the scene, so the grid and origin no longer use their respective custom shaders.\n\nThe easiest way to fix this would probly be to always hide the grid and origin when these debug draw modes are used. Alternatively, we should figure out a way to make specific RIDs (the ones used for the origin and grid) not have their shader overridden.","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2737424104/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2742978199","html_url":"https://github.com/godotengine/godot/issues/104202#issuecomment-2742978199","issue_url":"https://api.github.com/repos/godotengine/godot/issues/104202","id":2742978199,"node_id":"IC_kwDOAO6SJc6jfoaX","user":{"login":"quinnyo","id":3379314,"node_id":"MDQ6VXNlcjMzNzkzMTQ=","avatar_url":"https://avatars.githubusercontent.com/u/3379314?v=4","gravatar_id":"","url":"https://api.github.com/users/quinnyo","html_url":"https://github.com/quinnyo","followers_url":"https://api.github.com/users/quinnyo/followers","following_url":"https://api.github.com/users/quinnyo/following{/other_user}","gists_url":"https://api.github.com/users/quinnyo/gists{/gist_id}","starred_url":"https://api.github.com/users/quinnyo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/quinnyo/subscriptions","organizations_url":"https://api.github.com/users/quinnyo/orgs","repos_url":"https://api.github.com/users/quinnyo/repos","events_url":"https://api.github.com/users/quinnyo/events{/privacy}","received_events_url":"https://api.github.com/users/quinnyo/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-03-21T10:39:16Z","updated_at":"2025-03-21T10:39:16Z","body":"As I understand it, a popular (mis)use of the Overdraw display mode is as an \"X-ray\" view for working with the CSG nodes. The grid may be missed in that case. For the use-case of analysing overdraw, I find the grid (or any editor-specific doodads) being visible at all a surprise.\n\n> `Steps to reproduce / Minimal reproduction project (MRP)` might be helpful. From what it looks like in the video, these aren't the default settings (colors, etc.).\n\nI added reproduction steps. A reproduction project would just be an empty project, so I didn't see the need for that.\nThe video is captured from my day-to-day editor but the behaviour is the same (for me) in an unconfigured editor.","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2742978199/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null}]