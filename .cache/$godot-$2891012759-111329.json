github.com/akien-mga","id":4701338,"node_id":"MDQ6VXNlcjQ3MDEzMzg=","login":"akien-mga","type":"User","owned_private_repos":0,"public_gists":0,"public_repos":0,"total_private_repos":0,"url":"https://api.github.com/users/akien-mga"},"body":"","html_url":"https://github.com/godotengine/godot/pull/111329#pullrequestreview-3352753088","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/111329","author_association":"MEMBER","submitted_at":"2025-10-18T08:02:50Z"},{"id":3353789161,"node_id":"PRR_kwDOAO6SJc7H5sLp","state":"APPROVED","commit_id":"b20466d12f7892a8dbad9e37959da0287365b69b","user":{"site_admin":false,"suspended":false,"updated_at":"0001-01-01T00:00:00Z","avatar_url":"https://avatars.githubusercontent.com/u/180032?u=68d23e7ee9cdf810da125e8510b72f845b9dccc8&v=4","created_at":"0001-01-01T00:00:00Z","followers":0,"following":0,"html_url":"https://github.com/Calinou","id":180032,"node_id":"MDQ6VXNlcjE4MDAzMg==","login":"Calinou","type":"User","owned_private_repos":0,"public_gists":0,"public_repos":0,"total_private_repos":0,"url":"https://api.github.com/users/Calinou"},"body":"Code looks good to me.","html_url":"https://github.com/godotengine/godot/pull/111329#pullrequestreview-3353789161","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/111329","author_association":"MEMBER","submitted_at":"2025-10-18T21:46:41Z"},{"id":3354529451,"node_id":"PRR_kwDOAO6SJc7H8g6r","state":"APPROVED","commit_id":"b20466d12f7892a8dbad9e37959da0287365b69b","user":{"site_admin":false,"suspended":false,"updated_at":"0001-01-01T00:00:00Z","avatar_url":"https://avatars.githubusercontent.com/u/41921395?u=74caa4e396a8e2995ac648a80f7488601d679e63&v=4","created_at":"0001-01-01T00:00:00Z","followers":0,"following":0,"html_url":"https://github.com/Alex2782","id":41921395,"node_id":"MDQ6VXNlcjQxOTIxMzk1","login":"Alex2782","type":"User","owned_private_repos":0,"public_gists":0,"public_repos":0,"total_private_repos":0,"url":"https://api.github.com/users/Alex2782"},"body":"Unfortunately, I can't restart the app on Firebase Test Lab to test the cache. Restarting the app ends the session. Let's implement these changes and see if they reduce the crash rate in the Android Godot Editor.\r\n\r\n----------------\r\n\r\n<details><summary>Tests on Firebase Test Lab</summary>\r\n\r\n[power-vr-test.zip](https://github.com/user-attachments/files/22990467/power-vr-test.zip)\r\n\r\n\r\n\r\n```gdscript\r\n\r\nextends Control\r\n\r\nfunc _ready():\r\n\t\r\n\tawait get_tree().create_timer(3.0).timeout\r\n\t%GPUParticles2D.visible = true\r\n\t\r\n\tif FileAccess.file_exists(\"user://shader_cache_tested.txt\"):\r\n\t\tprint(\"Second launch\")\r\n\telse:\r\n\t\tvar f = FileAccess.open(\"user://shader_cache_tested.txt\", FileAccess.WRITE)\r\n\t\tf.store_string(\"done\")\r\n\t\tf.close()\r\n\t\tprint(\"First launch\")\r\n\t\tawait get_tree().create_timer(5.0).timeout\r\n\t\trestart_app()\r\n\r\nfunc restart_app():\r\n\tvar exe = OS.get_executable_path()\r\n\tOS.create_process(exe, [])\r\n\tget_tree().quit()\r\n\r\n```\r\n\r\n### moto g54 5G\r\n\r\nOn this device, the video runs longer (the test session was active for a longer time); on other devices, the session ends immediately. However, restarting worked on my Samsung Tab S7, Android 13.\r\n\r\nhttps://github.com/user-attachments/assets/bb9af0bc-b3e1-42a1-8630-b263593ab395\r\n\r\n\r\n\r\n\r\n\r\n</details>\r\n\r\n\r\nDevices:  `Pixel 10, Galaxy A12, moto g54 5G, Galaxy A03s`\r\n\r\nNo crash reproduced with `GPUParticles2D` (first start, without cache)\r\nv4.5.stable.official [876b29033]\r\n","html_url":"https://github.com/godotengine/godot/pull/111329#pullrequestreview-3354529451","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/111329","author_association":"MEMBER","submitted_at":"2025-10-19T13:34:08Z"}]