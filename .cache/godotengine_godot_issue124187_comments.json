int\",\r\n-           \"meta\": \"uint32\",\r\n+           \"type\": \"bitfield::Object.ConnectFlags\",\r\n            \"default_value\": \"0\"\r\n        }\r\n    ]\r\n},\r\n```\r\n\r\nI think it's because of the [`arg.class_name`](https://github.com/godotengine/godot/blob/c9730f40aafa4686fa550518c92461258b9ee4b3/core/object/method_info.cpp#L103-L105).\r\n\r\nI have also found another case where an integer parameter was changed to an enum and added a compat method:\r\n- https://github.com/godotengine/godot/pull/114053","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/6130197371/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/6132216397","html_url":"https://github.com/godotengine/godot/pull/124187#issuecomment-6132216397","issue_url":"https://api.github.com/repos/godotengine/godot/issues/124187","id":6132216397,"node_id":"IC_kwDOAO6SJc8AAAABbYIyTQ","user":{"login":"dsnopek","id":191561,"node_id":"MDQ6VXNlcjE5MTU2MQ==","avatar_url":"https://avatars.githubusercontent.com/u/191561?v=4","gravatar_id":"","url":"https://api.github.com/users/dsnopek","html_url":"https://github.com/dsnopek","followers_url":"https://api.github.com/users/dsnopek/followers","following_url":"https://api.github.com/users/dsnopek/following{/other_user}","gists_url":"https://api.github.com/users/dsnopek/gists{/gist_id}","starred_url":"https://api.github.com/users/dsnopek/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/dsnopek/subscriptions","organizations_url":"https://api.github.com/users/dsnopek/orgs","repos_url":"https://api.github.com/users/dsnopek/repos","events_url":"https://api.github.com/users/dsnopek/events{/privacy}","received_events_url":"https://api.github.com/users/dsnopek/received_events","type":"User","user_view_type":