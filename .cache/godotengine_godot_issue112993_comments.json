i.github.com/users/Decapitated/following{/other_user}","gists_url":"https://api.github.com/users/Decapitated/gists{/gist_id}","starred_url":"https://api.github.com/users/Decapitated/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Decapitated/subscriptions","organizations_url":"https://api.github.com/users/Decapitated/orgs","repos_url":"https://api.github.com/users/Decapitated/repos","events_url":"https://api.github.com/users/Decapitated/events{/privacy}","received_events_url":"https://api.github.com/users/Decapitated/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-04-11T19:26:36Z","updated_at":"2026-04-11T19:26:36Z","body":"Loving this enhancement. But one thing we seemed to have lost in the process is the parent highlight.\r\n<img width=\"471\" height=\"126\" alt=\"parent_highlight\" src=\"https://github.com/user-attachments/assets/9893fbd5-16f0-44b9-b4c9-f4f52239524c\" />\r\n\r\nNot sure what everyone else thinks, but I think we should bring it back.","author_association":"NONE","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4230041332/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4230515076","html_url":"https://github.com/godotengine/godot/pull/112993#issuecomment-4230515076","issue_url":"https://api.github.com/repos/godotengine/godot/issues/112993","id":4230515076,"node_id":"IC_kwDOAO6SJc78KImE","user":{"login":"vaner-org","id":9658355,"node_id":"MDQ6VXNlcjk2NTgzNTU=","avatar_url":"https://avatars.githubusercontent.com/u/9658355?v=4","gravatar_id":"","url":"https://api.github.com/users/vaner-org","html_url":"https://github.com/vaner-org","followers_url":"https://api.github.com/users/vaner-org/followers","following_url":"https://api.github.com/users/vaner-org/following{/other_u