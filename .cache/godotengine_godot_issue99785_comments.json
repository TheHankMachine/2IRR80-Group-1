[{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2521117875","html_url":"https://github.com/godotengine/godot/issues/99785#issuecomment-2521117875","issue_url":"https://api.github.com/repos/godotengine/godot/issues/99785","id":2521117875,"node_id":"IC_kwDOAO6SJc6WRTSz","user":{"login":"JekSun97","id":130399274,"node_id":"U_kgDOB8W8Kg","avatar_url":"https://avatars.githubusercontent.com/u/130399274?v=4","gravatar_id":"","url":"https://api.github.com/users/JekSun97","html_url":"https://github.com/JekSun97","followers_url":"https://api.github.com/users/JekSun97/followers","following_url":"https://api.github.com/users/JekSun97/following{/other_user}","gists_url":"https://api.github.com/users/JekSun97/gists{/gist_id}","starred_url":"https://api.github.com/users/JekSun97/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/JekSun97/subscriptions","organizations_url":"https://api.github.com/users/JekSun97/orgs","repos_url":"https://api.github.com/users/JekSun97/repos","events_url":"https://api.github.com/users/JekSun97/events{/privacy}","received_events_url":"https://api.github.com/users/JekSun97/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2024-12-05T18:25:16Z","updated_at":"2024-12-05T18:25:16Z","body":"Please mark this as a bug as it does happen and is very annoying when customizing the appearance of buttons, especially if we change its size, which is confusing.\n\nhttps://github.com/user-attachments/assets/b1beb2f0-1d0e-4a4b-aee3-9213d194f251\n\n","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2521117875/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2573086646","html_url":"https://github.com/godotengine/godot/issues/99785#issuecomment-2573086646","issue_url":"https://api.github.com/repos/godotengine/godot/issues/99785","id":2573086646,"node_id":"IC_kwDOAO6SJc6ZXi-2","user":{"login":"JekSun97","id":130399274,"node_id":"U_kgDOB8W8Kg","avatar_url":"https://avatars.githubusercontent.com/u/130399274?v=4","gravatar_id":"","url":"https://api.github.com/users/JekSun97","html_url":"https://github.com/JekSun97","followers_url":"https://api.github.com/users/JekSun97/followers","following_url":"https://api.github.com/users/JekSun97/following{/other_user}","gists_url":"https://api.github.com/users/JekSun97/gists{/gist_id}","starred_url":"https://api.github.com/users/JekSun97/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/JekSun97/subscriptions","organizations_url":"https://api.github.com/users/JekSun97/orgs","repos_url":"https://api.github.com/users/JekSun97/repos","events_url":"https://api.github.com/users/JekSun97/events{/privacy}","received_events_url":"https://api.github.com/users/JekSun97/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-01-06T13:13:22Z","updated_at":"2025-01-06T13:13:22Z","body":"I tested older versions to more easily detect the culprit, and found out that this problem first appeared in **4.3 dev3**, in 4.3 dev2 it does not happen.\n\nPossible culprit #64351 @Rindbee ?","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2573086646/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2573145994","html_url":"https://github.com/godotengine/godot/issues/99785#issuecomment-2573145994","issue_url":"https://api.github.com/repos/godotengine/godot/issues/99785","id":2573145994,"node_id":"IC_kwDOAO6SJc6ZXxeK","user":{"login":"Rindbee","id":30386067,"node_id":"MDQ6VXNlcjMwMzg2MDY3","avatar_url":"https://avatars.githubusercontent.com/u/30386067?v=4","gravatar_id":"","url":"https://api.github.com/users/Rindbee","html_url":"https://github.com/Rindbee","followers_url":"https://api.github.com/users/Rindbee/followers","following_url":"https://api.github.com/users/Rindbee/following{/other_user}","gists_url":"https://api.github.com/users/Rindbee/gists{/gist_id}","starred_url":"https://api.github.com/users/Rindbee/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Rindbee/subscriptions","organizations_url":"https://api.github.com/users/Rindbee/orgs","repos_url":"https://api.github.com/users/Rindbee/repos","events_url":"https://api.github.com/users/Rindbee/events{/privacy}","received_events_url":"https://api.github.com/users/Rindbee/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-01-06T13:46:47Z","updated_at":"2025-01-06T13:49:24Z","body":"`--debug-canvas-item-redraw` is not working again.\n\nProbably not, the drawing of changes is not delayed. But it should be related to the different minimum sizes of `StyleBox` in different states.\n","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2573145994/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2573170884","html_url":"https://github.com/godotengine/godot/issues/99785#issuecomment-2573170884","issue_url":"https://api.github.com/repos/godotengine/godot/issues/99785","id":2573170884,"node_id":"IC_kwDOAO6SJc6ZX3jE","user":{"login":"Rindbee","id":30386067,"node_id":"MDQ6VXNlcjMwMzg2MDY3","avatar_url":"https://avatars.githubusercontent.com/u/30386067?v=4","gravatar_id":"","url":"https://api.github.com/users/Rindbee","html_url":"https://github.com/Rindbee","followers_url":"https://api.github.com/users/Rindbee/followers","following_url":"https://api.github.com/users/Rindbee/following{/other_user}","gists_url":"https://api.github.com/users/Rindbee/gists{/gist_id}","starred_url":"https://api.github.com/users/Rindbee/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Rindbee/subscriptions","organizations_url":"https://api.github.com/users/Rindbee/orgs","repos_url":"https://api.github.com/users/Rindbee/repos","events_url":"https://api.github.com/users/Rindbee/events{/privacy}","received_events_url":"https://api.github.com/users/Rindbee/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-01-06T14:00:10Z","updated_at":"2025-01-06T14:00:10Z","body":"Refresh is by design.\n\nhttps://github.com/godotengine/godot/blob/1aaf20b1f1f3ab59f04db74b166540327a3f1f90/editor/plugins/theme_editor_preview.cpp#L227-L232\n\nThe size jitter is that the minimum size of the `StyleBox` in different states is inconsistent. Drawing is immediate, resizing is repeated periodically.","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2573170884/reactions","total_count":2,"+1":2,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2576779322","html_url":"https://github.com/godotengine/godot/issues/99785#issuecomment-2576779322","issue_url":"https://api.github.com/repos/godotengine/godot/issues/99785","id":2576779322,"node_id":"IC_kwDOAO6SJc6Zlog6","user":{"login":"JekSun97","id":130399274,"node_id":"U_kgDOB8W8Kg","avatar_url":"https://avatars.githubusercontent.com/u/130399274?v=4","gravatar_id":"","url":"https://api.github.com/users/JekSun97","html_url":"https://github.com/JekSun97","followers_url":"https://api.github.com/users/JekSun97/followers","following_url":"https://api.github.com/users/JekSun97/following{/other_user}","gists_url":"https://api.github.com/users/JekSun97/gists{/gist_id}","starred_url":"https://api.github.com/users/JekSun97/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/JekSun97/subscriptions","organizations_url":"https://api.github.com/users/JekSun97/orgs","repos_url":"https://api.github.com/users/JekSun97/repos","events_url":"https://api.github.com/users/JekSun97/events{/privacy}","received_events_url":"https://api.github.com/users/JekSun97/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-01-08T05:23:02Z","updated_at":"2025-01-08T05:23:02Z","body":"@Rindbee Do you plan to create a PR fix for this issue? ","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2576779322/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2576809134","html_url":"https://github.com/godotengine/godot/issues/99785#issuecomment-2576809134","issue_url":"https://api.github.com/repos/godotengine/godot/issues/99785","id":2576809134,"node_id":"IC_kwDOAO6SJc6Zlvyu","user":{"login":"Rindbee","id":30386067,"node_id":"MDQ6VXNlcjMwMzg2MDY3","avatar_url":"https://avatars.githubusercontent.com/u/30386067?v=4","gravatar_id":"","url":"https://api.github.com/users/Rindbee","html_url":"https://github.com/Rindbee","followers_url":"https://api.github.com/users/Rindbee/followers","following_url":"https://api.github.com/users/Rindbee/following{/other_user}","gists_url":"https://api.github.com/users/Rindbee/gists{/gist_id}","starred_url":"https://api.github.com/users/Rindbee/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Rindbee/subscriptions","organizations_url":"https://api.github.com/users/Rindbee/orgs","repos_url":"https://api.github.com/users/Rindbee/repos","events_url":"https://api.github.com/users/Rindbee/events{/privacy}","received_events_url":"https://api.github.com/users/Rindbee/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-01-08T05:53:04Z","updated_at":"2025-01-08T06:07:09Z","body":"I don't think it's a bug.  \n\nUsers should be aware of using `StyleBox`es with the same minimum size for different states of a button.  Make sure to use appropriate margins.\n\nYou can modify other state's StyleBox based on the same StyleBox. By copying.\n\nThe default `content_margin_*` for `normal` StyleBox is `4` by default. You can change it after importing.","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2576809134/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2627707835","html_url":"https://github.com/godotengine/godot/issues/99785#issuecomment-2627707835","issue_url":"https://api.github.com/repos/godotengine/godot/issues/99785","id":2627707835,"node_id":"IC_kwDOAO6SJc6cn6O7","user":{"login":"JekSun97","id":130399274,"node_id":"U_kgDOB8W8Kg","avatar_url":"https://avatars.githubusercontent.com/u/130399274?v=4","gravatar_id":"","url":"https://api.github.com/users/JekSun97","html_url":"https://github.com/JekSun97","followers_url":"https://api.github.com/users/JekSun97/followers","following_url":"https://api.github.com/users/JekSun97/following{/other_user}","gists_url":"https://api.github.com/users/JekSun97/gists{/gist_id}","starred_url":"https://api.github.com/users/JekSun97/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/JekSun97/subscriptions","organizations_url":"https://api.github.com/users/JekSun97/orgs","repos_url":"https://api.github.com/users/JekSun97/repos","events_url":"https://api.github.com/users/JekSun97/events{/privacy}","received_events_url":"https://api.github.com/users/JekSun97/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-01-31T16:09:32Z","updated_at":"2025-02-05T21:22:33Z","body":"I think this is a mistake, because before this was not the case, and we could change one StyleBox to, for example, just change its color, now if we change one \"`normal`\" StyleBox, then we see an unnecessary resizing, which we did not plan to see, and judging by your advice I have to change all other StyleBoxes so that it corresponds to the \"erroneous resizing\", this is confusing and causes problems.\n\nWe just need to make the size of the new StyleBox match the size of the default theme in the theme preview.","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2627707835/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2628606440","html_url":"https://github.com/godotengine/godot/issues/99785#issuecomment-2628606440","issue_url":"https://api.github.com/repos/godotengine/godot/issues/99785","id":2628606440,"node_id":"IC_kwDOAO6SJc6crVno","user":{"login":"Rindbee","id":30386067,"node_id":"MDQ6VXNlcjMwMzg2MDY3","avatar_url":"https://avatars.githubusercontent.com/u/30386067?v=4","gravatar_id":"","url":"https://api.github.com/users/Rindbee","html_url":"https://github.com/Rindbee","followers_url":"https://api.github.com/users/Rindbee/followers","following_url":"https://api.github.com/users/Rindbee/following{/other_user}","gists_url":"https://api.github.com/users/Rindbee/gists{/gist_id}","starred_url":"https://api.github.com/users/Rindbee/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Rindbee/subscriptions","organizations_url":"https://api.github.com/users/Rindbee/orgs","repos_url":"https://api.github.com/users/Rindbee/repos","events_url":"https://api.github.com/users/Rindbee/events{/privacy}","received_events_url":"https://api.github.com/users/Rindbee/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-02-01T00:17:27Z","updated_at":"2025-02-01T00:33:24Z","body":"The theme preview acts as a mirror, and I think it does its job as a mirror correctly. Delaying the reflection of changes may be for performance reasons.\n\n\nCurrently, it is not very convenient to modify the StyleBox.\n\nFor custom theme editing. If you are only adjusting some but not all StyleBoxes, currently the recommended approach is to import and edit. Remember to check **With Data** when importing.\n\n\n\n\n![Image](https://github.com/user-attachments/assets/ca248431-ae12-42b8-b26b-16d0227ed444)\n\nTo edit a StyleBox property of a control, I would suggest adding a \"Merge Data\" option to use the `content_margin_*` data of the old default StyleBox.\n\n![Image](https://github.com/user-attachments/assets/eb5f2591-1e10-48a7-b9e8-b6cff4a87813)\n\nOr after checking, the editor can automatically add the previously used StyleBox (or its copy).\n\nI remember that there used to be such a similar function, but I'm not sure. Since I got influenza A, I feel that my memory has deteriorated a lot.\n\n\n![Image](https://github.com/user-attachments/assets/3f2f65da-9260-4364-bc39-1ed9a7204130)\n\n\n> and judging by your advice I have to change all other StyleBoxes so that it corresponds to the \"erroneous resizing\", this is confusing and causes problems.\n\nIf you get it by creating a new one, you can **just** change the `normal` StyleBox's `content_margin_*` properties. If you get it by copying or importing with Data, you usually don't need to modify the `content_margin_*` properties.","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2628606440/reactions","total_count":1,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":1},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2815462770","html_url":"https://github.com/godotengine/godot/issues/99785#issuecomment-2815462770","issue_url":"https://api.github.com/repos/godotengine/godot/issues/99785","id":2815462770,"node_id":"IC_kwDOAO6SJc6n0I1y","user":{"login":"Nallebeorn","id":7013489,"node_id":"MDQ6VXNlcjcwMTM0ODk=","avatar_url":"https://avatars.githubusercontent.com/u/7013489?v=4","gravatar_id":"","url":"https://api.github.com/users/Nallebeorn","html_url":"https://github.com/Nallebeorn","followers_url":"https://api.github.com/users/Nallebeorn/followers","following_url":"https://api.github.com/users/Nallebeorn/following{/other_user}","gists_url":"https://api.github.com/users/Nallebeorn/gists{/gist_id}","starred_url":"https://api.github.com/users/Nallebeorn/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Nallebeorn/subscriptions","organizations_url":"https://api.github.com/users/Nallebeorn/orgs","repos_url":"https://api.github.com/users/Nallebeorn/repos","events_url":"https://api.github.com/users/Nallebeorn/events{/privacy}","received_events_url":"https://api.github.com/users/Nallebeorn/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-04-18T13:34:21Z","updated_at":"2025-04-18T13:34:55Z","body":"I can confirm the reported behaviour (4.4.1-stable). It's not completely clear whether there's an actual bug here (I'm personally not that familiar with UI theming). From the discussion, there seems to be a few different points brought up:\n\ncc @AThousandShips\n\n- The button changes size when hovered -- this might be expected because its StyleBoxes for different states have different margins\n- However, if I select a scene for the Theme editor preview, I can observe the size changing in the preview but not in the real scene when I run it, meaning behaviour in-preview and in-game is inconsistent. I have a slightly modified MRP demonstrating this: [gui-2.zip](https://github.com/user-attachments/files/19812878/gui-2.zip) (compare control.tscn loaded in the preview new_theme.tres with running the game)\n- The UX for editing style properties for different states of buttons isn't great -- this seems highly related to this proposal: https://github.com/godotengine/godot-proposals/issues/8094.\n- There's a delay before the size changes when interacting with a control in the preview. This might be intentional for performance reason, but I agree it feels bad when it's meant to react to user input. There might be reason to change this.","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2815462770/reactions","total_count":2,"+1":2,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5802211436","html_url":"https://github.com/godotengine/godot/issues/99785#issuecomment-5802211436","issue_url":"https://api.github.com/repos/godotengine/godot/issues/99785","id":5802211436,"node_id":"IC_kwDOAO6SJc8AAAABWda4bA","user":{"login":"JekSun97","id":130399274,"node_id":"U_kgDOB8W8Kg","avatar_url":"https://avatars.githubusercontent.com/u/130399274?v=4","gravatar_id":"","url":"https://api.github.com/users/JekSun97","html_url":"https://github.com/JekSun97","followers_url":"https://api.github.com/users/JekSun97/followers","following_url":"https://api.github.com/users/JekSun97/following{/other_user}","gists_url":"https://api.github.com/users/JekSun97/gists{/gist_id}","starred_url":"https://api.github.com/users/JekSun97/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/JekSun97/subscriptions","organizations_url":"https://api.github.com/users/JekSun97/orgs","repos_url":"https://api.github.com/users/JekSun97/repos","events_url":"https://api.github.com/users/JekSun97/events{/privacy}","received_events_url":"https://api.github.com/users/JekSun97/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-09-23T20:15:10Z","updated_at":"2026-09-23T20:15:10Z","body":"I cannot reproduce this issue in Godot versions 4.7.2 and 4.8 dev6.","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5802211436/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null}]