tick/subscriptions","organizations_url":"https://api.github.com/users/unit-tick/orgs","repos_url":"https://api.github.com/users/unit-tick/repos","events_url":"https://api.github.com/users/unit-tick/events{/privacy}","received_events_url":"https://api.github.com/users/unit-tick/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"","state":"COMMENTED","html_url":"https://github.com/godotengine/godot/pull/122095#pullrequestreview-4877033946","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/122095","author_association":"CONTRIBUTOR","_links":{"html":{"href":"https://github.com/godotengine/godot/pull/122095#pullrequestreview-4877033946"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/122095"}},"submitted_at":"2026-08-06T17:24:41Z","commit_id":"2fff3c7d437e9740c4936c0666166ecbcc24f2bb"},{"id":4877853634,"node_id":"PRR_kwDOAO6SJc8AAAABIr4jwg","user":{"login":"CarrotOfPower","id":260066004,"node_id":"U_kgDOD4BK1A","avatar_url":"https://avatars.githubusercontent.com/u/260066004?u=622c31960cdfe02c889a8854726e393a5a8afa3f&v=4","gravatar_id":"","url":"https://api.github.com/users/CarrotOfPower","html_url":"https://github.com/CarrotOfPower","followers_url":"https://api.github.com/users/CarrotOfPower/followers","following_url":"https://api.github.com/users/CarrotOfPower/following{/other_user}","gists_url":"https://api.github.com/users/CarrotOfPower/gists{/gist_id}","starred_url":"https://api.github.com/users/CarrotOfPower/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/CarrotOfPower/subscriptions","organizations_url":"https://api.github.com/users/CarrotOfPower/orgs","repos_url":"https://api.github.com/users/CarrotOfPower/repos","events_url":"https://api.github.com/users/CarrotOfPower/events{/privacy}","received_events_url":"https://api.github.com/users/CarrotOfPower/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"I compared this PR and https://github.com/godotengine/godot/pull/122061, and I noticed that they only have few differences:\r\n\r\n\r\n### 1. Some lines differ in execution order, which doesn't matter\r\n\r\n### 2. Use of `const`, where sensible\r\n- https://github.com/godotengine/godot/pull/122061 uses this more often.\r\n\r\n### 3. The implementation of `title_size_cache`, which does the same, but in a different way\r\n- I believe the implementation in https://github.com/godotengine/godot/pull/122061 should be more efficient due to it only sets `title_size_cache` on ready, instead of checking once per `ProjectListItemControl`.\r\n\r\n### 4. The \"magic number\"\r\n- Here it is 800, in https://github.com/godotengine/godot/pull/122061 it's 764. I think, the most appropriate value is less than 800, probably around 764, but this should be tested more intensively.\r\n\r\n### 5. How `title_minsize` is handled\r\n- I think this is the main difference and the reason why compact mode causes a bug. See [here](https://github.com/godotengine/godot/pull/122095/changes#r3731556966). Or I just didn't understand something.\r\n\r\n\r\nYes, that's it. Everything else seems to be quite identical.\r\n\r\nIt would be great if you could test https://github.com/godotengine/godot/pull/122061 again, because I use `tag_maxsize` now and that could fix something. If it doesn't, I would be happy to get to the bottom of it together.","state":"COMMENTED","html_url":"https://github.com/godotengine/godot/pull/122095#pullrequestreview-4877853634","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/122095","author_association":"CONTRIBUTOR","_links":{"html":{"href":"https://github.com/godotengine/godot/pull/122095#pullrequestreview-4877853634"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/122095"}},"submitted_at":"2026-08-06T20:10:12Z","commit_id":"8c22bc5ba87c7161f14c02e7d5cdc0e8cd739eaf"},{"id":4877997408,"node_id":"PRR_kwDOAO6SJc8AAAABIsBVYA","user":{"login":"Ca