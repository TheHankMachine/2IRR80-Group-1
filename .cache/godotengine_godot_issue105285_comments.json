monitz87/following{/other_user}","gists_url":"https://api.github.com/users/monitz87/gists{/gist_id}","starred_url":"https://api.github.com/users/monitz87/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/monitz87/subscriptions","organizations_url":"https://api.github.com/users/monitz87/orgs","repos_url":"https://api.github.com/users/monitz87/repos","events_url":"https://api.github.com/users/monitz87/events{/privacy}","received_events_url":"https://api.github.com/users/monitz87/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-04-14T14:12:24Z","updated_at":"2025-04-14T14:12:24Z","body":"First, it would be `Dictionary[String, Variant]`, not the other way around, since `has` works with keys, not values. Secondly, that doesn't work because the passed dictionary can be any dictionary, not necessarily `Dictionary[String, Variant]`","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2801853868/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2801873220","html_url":"https://github.com/godotengine/godot/issues/105285#issuecomment-2801873220","issue_url":"https://api.github.com/repos/godotengine/godot/issues/105285","id":2801873220,"node_id":"IC_kwDOAO6SJc6nATFE","user":{"login":"jordan-castro","id":86361283,"node_id":"MDQ6VXNlcjg2MzYxMjgz","avatar_url":"https://avatars.githubusercontent.com/u/86361283?v=4","gravatar_id":"","url":"https://api.github.com/users/jordan-castro","html_url":"https://github.com/jordan-castro","followers_url":"https://api.github.com/users/jordan-castro/followers","following_url":"https://api.github.com/users/jordan-castro/following{/other_user}","gists_url":"https://api.github.com/users/jordan-castro/gists{/gist_id}","starred_url":"https://api.github.com/users/jordan-castro/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/jordan-castro/subscriptions","organizations_url":"https://api.github.com/users/jordan-castro/orgs","repos_url":"https://api.github.com/users/jordan-castro/repos","events_url":"https://api.github.com/users/jordan-castro/events{/privacy}","received_events_url":"https://api.github.com/users/jordan-castro/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-04-14T14:18:36Z","updated_at":"2025-04-14T14:18:50Z","body":"So I haven't actually tried yet but I would assume that a key can be a Variant. That way you could do has on any type string or not. But I'm surprised that the interpreter wouldn't throw an error if you passes a dictionary of a different type than the one set in the paramater.\n\nI mean isn't the point of types in function paramaters so that you can be 100% certain of what types you are working with? ","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2801873220/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2802161637","html_url":"https://github.com/godotengine/godot/issues/105285#issuecomment-2802161637","issue_url":"https://api.github.com/repos/godotengine/godot/issues/105285","id":2802161637,"node_id":"IC_kwDOAO6SJc6nBZfl","user":{"login":"jordan-castro","id":86361283,"node_id":"MDQ6VXNlcjg2MzYxMjgz","avatar_url":"https://avatars.githubusercontent.com/u/86361283?v=4","gravatar_id":"","url":"https://api.github.com/users/jordan-castro","html_url":"https://github.com/jordan-castro","followers_url":"https://api.github.com/users/jordan-castro/followers","following_url":"https://api.github.com/users/jordan-castro/following{/other_user}","gists_url":"https://api.github.com/users/jordan-castro/gists{/gist_id}","starred_url":"https://api.github.com/users/jordan-castro/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/jordan-castro/subscriptions","organizations_url":"https://api.github.com/users/jordan-castro/orgs","repos_url":"https://api.github.com/users/jordan-castro/repos","events_url":"https://api.github.com/users/jordan-castro/events{/privacy}","received_events_url":"https://api.github.com/users/jordan-castro/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-04-14T15:51:43Z","updated_at":"2025-04-14T15:51:58Z","body":"Actually I realized my error.\n\n```gdscript\nfunc deserialize(value: Dictionary[Variant, Variant]) -> Variant:\n  # here you could easily do \n  if value.has(\"__type\"):\n    return value.__type\n```\nDoes this work without issue?","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2802161637/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2802879223","html_url":"https://github.com/godotengine/godot/issues/105285#issuecomment-2802879223","issue_url":"https://api.github.com/repos/godotengine/godot/issues/105285","id":2802879223,"node_id":"IC_kwDOAO6SJc6nEIr3","user":{"login":"monitz87","id":7144213,"node_id":"MDQ6VXNlcjcxNDQyMTM=","avatar_url":"https://avatars.githubusercontent.com/u/7144213?v=4","gravatar_id":"","url":"https://api.github.com/users/monitz87","html_url":"https://github.com/monitz87","followers_url":"https://api.github.com/users/monitz87/followers","following_url":"https://api.github.com/users/monitz87/following{/other_user}","gists_url":"https://api.github.com/users/monitz87/gists{/gist_id}","starred_url":"https://api.github.com/users/monitz87/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/monitz87/subscriptions","organizations_url":"https://api.github.com/users/monitz87/orgs","repos_url":"https://api.github.com/users/monitz87/repos","events_url":"https://api.github.com/users/monitz87/events{/privacy}","received_events_url":"https://api.github.com/users/monitz87/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-04-14T20:13:52Z","updated_at":"2025-04-16T13:34:44Z","body":"No, because the actual value being passed can still be a `Dictionary[int, Variant]` (or any other typed dictionary with a non-string key type). Adding a static type to the value in the method signature doesn't cast the value being passed.\n\n> I mean isn't the point of types in function paramaters so that you can be 100% certain of what types you are working with?\n\nThe `deserialize` method only cares that it receives a `Dictionary`. It doesn't (and shouldn't) care whether it is typed or not, or what the types of the keys are.\n\nActually, your last example IMO demonstrates what is wrong with having `has` throw an error in this scenario.\n\n```python\nfunc deserialize(value: Dictionary[Variant, Variant]) -> Variant:\n  if value.has(\"__type\"):\n    return value.__type\n\n  return value\n\nfunc main() -> void:\n  var dict: Dictionary[int, Variant] = {\n    1: \"foo\"\n  }\n\n  print(deserialize(dict))\n```\n\nBoth methods are properly defined and type safe. From a contract perspective, I'm satisfying the signature of the method. From reading the code, the deserialize method is properly handling the dictionary based on the type on its signature. Why should this fail during runtime? If the type system recognizes `Dictionary[int, Variant]` as a subtype of `Dictionary[Variant, Variant]`, then it doesn't make sense for methods that work on `Dictionary[Variant, Variant]` to fail on `Dictionary[int, Variant]`.\n\nMoreover, it seems really unnecessary to require doing reflection-related checks in a method that is working directly with raw data.","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2802879223/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3099934890","html_url":"https://github.com/godotengine/godot/issues/105285#issuecomment-3099934890","issue_url":"https://api.github.com/repos/godotengine/godot/issues/105285","id":3099934890,"node_id":"IC_kwDOAO6SJc64xUCq","user":{"login":"IphStich","id":5625804,"node_id":"MDQ6VXNlcjU2MjU4MDQ=","avatar_url":"https://avatars.githubusercontent.com/u/5625804?v=4","gravatar_id":"","url":"https://api.github.com/users/IphStich","html_url":"https://github.com/IphStich","followers_url":"https://api.github.com/users/IphStich/followers","following_url":"https://api.github.com/users/IphStich/following{/other_user}","gists_url":"https://api.github.com/users/IphStich/gists{/gist_id}","starred_url":"https://api.github.com/users/IphStich/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/IphStich/subscriptions","organizations_url":"https://api.github.com/users/IphStich/orgs","repos_url":"https://api.github.com/users/IphStich/repos","events_url":"https://api.github.com/users/IphStich/events{/privacy}","received_events_url":"https://api.github.com/users/IphStich/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-07-21T23:37:48Z","updated_at":"2025-07-21T23:37:48Z","body":"3 changes that could be made to Godot that could resolve this issue while improving Godot API:\n\n- Add a new function that could be ran before-hand to quickly and easily confirm the key is a valid type, something like `is_valid_key` so that the condition becomes `if dict.is_valid_key(\"bar\") and dict.has(\"bar\"):` (therefore, `has` is never executed with an invalid key type)\n- Add a second optional param to the `has` function, being `validate_type` which defaults to `true` - if false, then `has` will return `false` if the given key fails the type check (only difference in behaviour is to return false instead of considering it an error)\n- Add a new function that is functionally the same as `has` but explicitly is defined to return false if the key fails the type validation, like maybe `var_has`\n\nOther solutions that are far less elegant:\n\n- OP changes the condition to something like `if (dict.get_typed_key_builtin() == TYPE_NIL or dict.get_typed_key_builtin() == TYPE_STRING or dict.get_typed_key_builtin() == TYPE_STRING_NAME) and dict.has(\"bar\"):`\n- The underlying behaviour of `has()` is changed so that false is returned instead of causing an error if the given key could not be valid due to the type check\n\nI think that there is good argument to be made why neither of the last 2 solutions would be appropriate, so would like to consider which of the first 3 would be best.\n\nI worry that `is_valid_key` would be a confusing name, but otherwise is a decent solution, as it would automate the checking `(dict.get_typed_key_builtin() == TYPE_NIL or dict.get_typed_key_builtin() == TYPE_STRING or dict.get_typed_key_builtin() == TYPE_STRING_NAME)` while future-proofing with DRY and generalisation principles.\n\nExtending `has` with an optional param is probably the most elegent solution, but I think the naming of the new param and the documentation would need to be very clear. (I think `validate_type` is kind of an ambiguous name for it). This would also allow us to document the erroring behaviour (currently `has` is not documented to cause an error if key would fail type validation). This should likely also be extended to other Dictionary functions that have this behaviour.\n\nAdding a new function that explicitly has this behaviour is perhaps not the best solution, as it means adding even more functions to the API and risking bloat. But it is definitely an option.","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3099934890/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3310214116","html_url":"https://github.com/godotengine/godot/issues/105285#issuecomment-3310214116","issue_url":"https://api.github.com/repos/godotengine/godot/issues/105285","id":3310214116,"node_id":"IC_kwDOAO6SJc7FTdvk","user":{"login":"monitz87","id":7144213,"node_id":"MDQ6VXNlcjcxNDQyMTM=","avatar_url":"https://avatars.githubusercontent.com/u/7144213?v=4","gravatar_id":"","url":"https://api.github.com/users/monitz87","html_url":"https://github.com/monitz87","followers_url":"https://api.github.com/users/monitz87/followers","following_url":"https://api.github.com/users/monitz87/following{/other_user}","gists_url":"https://api.github.com/users/monitz87/gists{/gist_id}","starred_url":"https://api.github.com/users/monitz87/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/monitz87/subscriptions","organizations_url":"https://api.github.com/users/monitz87/orgs","repos_url":"https://api.github.com/users/monitz87/repos","events_url":"https://api.github.com/users/monitz87/events{/privacy}","received_events_url":"https://api.github.com/users/monitz87/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-09-19T01:50:20Z","updated_at":"2025-09-19T02:00:19Z","body":"IMHO neither `has` nor `get` should do any runtime type checking. Those methods are (I would assume) meant to provide safe access to dictionaries. Their original behavior (before adding the type checks) already accomplished that.\n\nThe errors just break previously functional and reasonable code (as evidenced by the example I provided in my other comment).\n\nWith the reflection methods (such as `get_typed_key_builtin()`), developers and library maintainers who need extra safety can add their own guardrails, which to me seems better than forcing everyone else to add extra checks to hot code paths or otherwise avoid typed dictionaries altogether.\n\nTo reiterate, if `Dictionary[Foo, Bar]` is considered a subtype of `Dictionary` (which seems to be the case, since both the parser *and* the interpreter agree with assigning the former to the latter), then methods that work on `Dictionary` shouldn't fail on `Dictionary[Foo, Bar]`.","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3310214116/reactions","total_count":3,"+1":3,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null}]