40950060,"node_id":"MDU6TGFiZWwzMjQwOTUwMDYw","url":"https://api.github.com/repos/godotengine/godot/labels/performance","name":"performance","color":"447777","default":false,"description":"","archived_at":null,"archived_by":null}],"state":"closed","locked":false,"assignees":[],"milestone":{"url":"https://api.github.com/repos/godotengine/godot/milestones/23","html_url":"https://github.com/godotengine/godot/milestone/23","labels_url":"https://api.github.com/repos/godotengine/godot/milestones/23/labels","id":12939969,"node_id":"MI_kwDOAO6SJc4AxXLB","number":23,"title":"4.6","description":"","creator":{"login":"Repiteo","id":17489292,"node_id":"MDQ6VXNlcjE3NDg5Mjky","avatar_url":"https://avatars.githubusercontent.com/u/17489292?v=4","gravatar_id":"","url":"https://api.github.com/users/Repiteo","html_url":"https://github.com/Repiteo","followers_url":"https://api.github.com/users/Repiteo/followers","following_url":"https://api.github.com/users/Repiteo/following{/other_user}","gists_url":"https://api.github.com/users/Repiteo/gists{/gist_id}","starred_url":"https://api.github.com/users/Repiteo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Repiteo/subscriptions","organizations_url":"https://api.github.com/users/Repiteo/orgs","repos_url":"https://api.github.com/users/Repiteo/repos","events_url":"https://api.github.com/users/Repiteo/events{/privacy}","received_events_url":"https://api.github.com/users/Repiteo/received_events","type":"User","user_view_type":"public","site_admin":false},"open_issues":3,"closed_issues":2978,"state":"closed","created_at":"2025-05-22T16:25:52Z","updated_at":"2026-10-04T16:23:23Z","due_on":null,"closed_at":"2026-01-26T18:09:14Z"},"comments":2,"created_at":"2025-07-11T03:45:33Z","updated_at":"2025-11-14T20:29:01Z","closed_at":"2025-11-14T20:28:29Z","assignee":null,"author_association":"CONTRIBUTOR","issue_field_values":[],"type":null,"active_lock_reason":null,"draft":false,"pull_request":{"url":"https://api.github.com/repos/godotengine/godot/pulls/108507","html_url":"https://github.com/godotengine/godot/pull/108507","diff_url":"https://github.com/godotengine/godot/pull/108507.diff","patch_url":"https://github.com/godotengine/godot/pull/108507.patch","merged_at":"2025-11-14T20:28:29Z"},"body":"Follow up to https://github.com/godotengine/godot/pull/108491 that does a similar optimization replacing a List with a Vector in `SceneTree::get_nodes_in_group`. Before this was copying the node pointers from a Vector into a List but now it just returns the Vector.\r\n\r\nSince I was already making changes to groups I also checked if replacing the `group_map` HashMap with AHashMap would make any difference. I've had success speeding some things up doing that in my own code.\r\n\r\nI wrote a quick benchmark in gdscript to check if changing the HashMap type made any difference and it seemed to work pretty well:\r\n\r\n```gdscript\r\nfunc _ready() -> void:\r\n\tvar total_nodes: int = 10000\r\n\t\r\n\tvar nodes: Array[Node]\r\n\tfor i: int in range(total_nodes):\r\n\t\tvar node: Node = Node.new()\r\n\t\tnodes.append(node)\r\n\t\tadd_child(node)\r\n\t\r\n\tvar start_time: int = Time.get_ticks_usec()\r\n\tfor i: int in range(total_nodes):\r\n\t\tnodes[i].add_to_group(\"test_group\")\r\n\r\n\tvar end_time: int = Time.get_ticks_usec()\r\n\tprint(\"Add group time: \", end_time - start_time, \" microseconds\")\r\n\r\n\tstart_time = Time.get_ticks_usec()\r\n\tvar group_nodes: Array[Node] = get_tree().get_nodes_in_group(\"test_group\")\r\n\tend_time = Time.get_ticks_usec()\r\n\tprint(\"Get nodes in group time: \", end_time - start_time, \" microseconds\")\r\n\r\n\tprint(group_nodes.size(), \" nodes\")\r\n```\r\n\r\nResults:\r\n\r\n```\r\nStarting performance using HashMap:\r\n\r\nAdd group time: 933 microseconds\r\nGet nodes in group time: 298 microseconds\r\n1000 nodes\r\n\r\n\r\nAdd group time: 15751 microseconds\r\nGet nodes in group time: 2766 microseconds\r\n10000 nodes\r\n\r\nWith AHashMap:\r\n\r\nAdd group time: 369 microseconds\r\nGet nodes in group time: 113 microseconds\r\n1000 nodes\r\n\r\n\r\nAdd group time: 13414 microseconds\r\nGet nodes in group time: 1769 microseconds\r\n10000 nodes\r\n\r\n```","closed_by":{"login":"Repiteo","id":17489292,"node_id":"MDQ6VXNlcjE3NDg5Mjky","avatar_url":"https://avatars.githubusercontent.com/u/17489292?v=4","gravatar_id":"","url":"https://api.github.com/users/Repiteo","html_url":"https://github.com/Repiteo","followers_url":"https://api.github.com/users/Repiteo/followers","following_url":"https://api.github.com/users/Repiteo/following{/other_user}","gists_url":"https://api.github.com/users/Repiteo/gists{/gist_id}","starred_url":"https://api.github.com/users/Repiteo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Repiteo/subscriptions","organizations_url":"https://api.github.com/users/Repiteo/orgs","repos_url":"https://api.github.com/users/Repiteo/repos","events_url":"https://api.github.com/users/Repiteo/events{/privacy}","received_events_url":"https://api.github.com/users/Repiteo/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/108507/reactions","total_count":21,"+1":8,"-1":0,"laugh":0,"hooray":2,"confused":0,"heart":6,"rocket":5,"eyes":0},"timeline_url":"https://api.github.com/repos/godotengine/godot/issues/108507/timeline","performed_via_github_app":null,"state_reason":null}