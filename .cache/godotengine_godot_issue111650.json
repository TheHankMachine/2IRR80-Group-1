d":2666708289,"node_id":"MDU6TGFiZWwyNjY2NzA4Mjg5","url":"https://api.github.com/repos/godotengine/godot/labels/topic:3d","name":"topic:3d","color":"ffee88","default":false,"description":"","archived_at":null,"archived_by":null}],"state":"closed","locked":false,"assignees":[],"milestone":{"url":"https://api.github.com/repos/godotengine/godot/milestones/25","html_url":"https://github.com/godotengine/godot/milestone/25","labels_url":"https://api.github.com/repos/godotengine/godot/milestones/25/labels","id":15520464,"node_id":"MI_kwDOAO6SJc4A7NLQ","number":25,"title":"4.8","description":"","creator":{"login":"Repiteo","id":17489292,"node_id":"MDQ6VXNlcjE3NDg5Mjky","avatar_url":"https://avatars.githubusercontent.com/u/17489292?v=4","gravatar_id":"","url":"https://api.github.com/users/Repiteo","html_url":"https://github.com/Repiteo","followers_url":"https://api.github.com/users/Repiteo/followers","following_url":"https://api.github.com/users/Repiteo/following{/other_user}","gists_url":"https://api.github.com/users/Repiteo/gists{/gist_id}","starred_url":"https://api.github.com/users/Repiteo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Repiteo/subscriptions","organizations_url":"https://api.github.com/users/Repiteo/orgs","repos_url":"https://api.github.com/users/Repiteo/repos","events_url":"https://api.github.com/users/Repiteo/events{/privacy}","received_events_url":"https://api.github.com/users/Repiteo/received_events","type":"User","user_view_type":"public","site_admin":false},"open_issues":351,"closed_issues":2337,"state":"open","created_at":"2026-04-13T15:59:35Z","updated_at":"2026-10-22T15:17:38Z","due_on":null,"closed_at":null},"comments":2,"created_at":"2025-10-14T16:43:00Z","updated_at":"2026-07-10T19:12:30Z","closed_at":"2026-07-10T19:10:35Z","assignee":null,"author_association":"MEMBER","issue_field_values":[],"type":null,"active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"- *Related to https://github.com/godotengine/godot/issues/68096.*\n\n### Tested versions\n\n- Reproducible in: 4.5.dev4 (first version with SMAA), 4.5.stable, 4.6.dev e82516995\n\n### System information\n\nGodot v4.6.dev (e82516995) - Fedora Linux 42 (KDE Plasma Desktop Edition) on X11 - X11 display driver, Multi-window, 1 monitor - Vulkan (Forward+) - dedicated NVIDIA GeForce RTX 5090 (nvidia; 580.95.05) - AMD Ryzen 9 9950X3D 16-Core Processor (32 threads) - 62.33 GiB memory\n\n### Issue description\n\nEnabling SMAA breaks FSR2 upscaling, presumably due to running the SMAA pass at the internal resolution, but *after* upscaling. Instead, SMAA should run *before* upscaling, but still at the internal resolution (so that it can effectively catch aliasing that would be gone after upscaling).\n\nIn contrast, FXAA handles this correctly, probably because it's a single-pass filter as opposed to SMAA's multi-pass approach.\n\nScreenshots with **Scaling 3D > Scale** set to `0.25`:\n\nNo spatial AA | FXAA | SMAA (blurry)\n-|-|-\n<img width=\"634\" height=\"567\" alt=\"Image\" src=\"https://github.com/user-attachments/assets/6bbcbe90-69a4-434d-b035-328932a69772\" /> | <img width=\"634\" height=\"567\" alt=\"Image\" src=\"https://github.com/user-attachments/assets/5cc9e485-3dd0-4022-86b4-b05f97f1b301\" /> | <img width=\"634\" height=\"567\" alt=\"Image\" src=\"https://github.com/user-attachments/assets/ce60ac66-b105-4125-8ee7-a95de7260d81\" />\n\nThe SMAA screenshot should look roughly as sharp as the FXAA one (probably sharper, given SMAA doesn't blur the image as much).\n\n### Steps to reproduce\n\n- Enable SMAA and set **Scaling 3D > Mode** to FSR2 in the Project Settings.\n- Set **Scaling 3D > Scale** to a low value like `0.25`.\n- Notice how rendering becomes very blurry (even in still scenes) until you disable SMAA. Normally, FSR2 allows the scene to look reasonably sharp at low resolution scale factors, at least in still scenes.\n\n### Minimal reproduction project (MRP)\n\n[test_fsr2_smaa.zip](https://github.com/user-attachments/files/22909153/test_fsr2_smaa.zip)","closed_by":{"login":"Repiteo","id":17489292,"node_id":"MDQ6VXNlcjE3NDg5Mjky","avatar_url":"https://avatars.githubusercontent.com/u/17489292?v=4","gravatar_id":"","url":"https://api.github.com/users/Repiteo","html_url":"https://github.com/Repiteo","followers_url":"https://api.github.com/users/Repiteo/followers","following_url":"https://api.github.com/users/Repiteo/following{/other_user}","gists_url":"https://api.github.com/users/Repiteo/gists{/gist_id}","starred_url":"https://api.github.com/users/Repiteo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Repiteo/subscriptions","organizations_url":"https://api.github.com/users/Repiteo/orgs","repos_url":"https://api.github.com/users/Repiteo/repos","events_url":"https://api.github.com/users/Repiteo/events{/privacy}","received_events_url":"https://api.github.com/users/Repiteo/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/111650/reactions","total_count":1,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":1},"timeline_url":"https://api.github.com/repos/godotengine/godot/issues/111650/timeline","performed_via_github_app":null,"state_reason":"completed","pinned_comment":null}