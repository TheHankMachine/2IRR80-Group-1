[{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4278274560","html_url":"https://github.com/godotengine/godot/issues/118765#issuecomment-4278274560","issue_url":"https://api.github.com/repos/godotengine/godot/issues/118765","id":4278274560,"node_id":"IC_kwDOAO6SJc7_AUoA","user":{"login":"dujanhung","id":212205466,"node_id":"U_kgDODKX_mg","avatar_url":"https://avatars.githubusercontent.com/u/212205466?v=4","gravatar_id":"","url":"https://api.github.com/users/dujanhung","html_url":"https://github.com/dujanhung","followers_url":"https://api.github.com/users/dujanhung/followers","following_url":"https://api.github.com/users/dujanhung/following{/other_user}","gists_url":"https://api.github.com/users/dujanhung/gists{/gist_id}","starred_url":"https://api.github.com/users/dujanhung/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/dujanhung/subscriptions","organizations_url":"https://api.github.com/users/dujanhung/orgs","repos_url":"https://api.github.com/users/dujanhung/repos","events_url":"https://api.github.com/users/dujanhung/events{/privacy}","received_events_url":"https://api.github.com/users/dujanhung/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-04-20T06:10:48Z","updated_at":"2026-04-20T06:10:48Z","body":"it's expected, because pen display <i>could</i> handle multi-touch.","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4278274560/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4279632837","html_url":"https://github.com/godotengine/godot/issues/118765#issuecomment-4279632837","issue_url":"https://api.github.com/repos/godotengine/godot/issues/118765","id":4279632837,"node_id":"IC_kwDOAO6SJc7_FgPF","user":{"login":"zincles","id":171102793,"node_id":"U_kgDOCjLSSQ","avatar_url":"https://avatars.githubusercontent.com/u/171102793?v=4","gravatar_id":"","url":"https://api.github.com/users/zincles","html_url":"https://github.com/zincles","followers_url":"https://api.github.com/users/zincles/followers","following_url":"https://api.github.com/users/zincles/following{/other_user}","gists_url":"https://api.github.com/users/zincles/gists{/gist_id}","starred_url":"https://api.github.com/users/zincles/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/zincles/subscriptions","organizations_url":"https://api.github.com/users/zincles/orgs","repos_url":"https://api.github.com/users/zincles/repos","events_url":"https://api.github.com/users/zincles/events{/privacy}","received_events_url":"https://api.github.com/users/zincles/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-04-20T10:02:14Z","updated_at":"2026-04-20T10:02:14Z","body":"yep. the recently update just added support to touchscreen on wayland (#113886).\n\nbut since the touchscreen specified optimization cannot be turned off manually, it affects the useability of mouse, causing problems while trying to drag things on editor: the editor would treat the drag event as \"scroll the panel\" as expected in touchscreen rather than \"move the element\" as expected in desktop. that's really annoying.\n\nmaybe it's better to add an selection to manually turn it off? or just differentiate \"mouse input\" and \"touchscreen input\" in editor?","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4279632837/reactions","total_count":4,"+1":4,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4329137007","html_url":"https://github.com/godotengine/godot/issues/118765#issuecomment-4329137007","issue_url":"https://api.github.com/repos/godotengine/godot/issues/118765","id":4329137007,"node_id":"IC_kwDOAO6SJc8AAAABAgljbw","user":{"login":"sommerper","id":1512048,"node_id":"MDQ6VXNlcjE1MTIwNDg=","avatar_url":"https://avatars.githubusercontent.com/u/1512048?v=4","gravatar_id":"","url":"https://api.github.com/users/sommerper","html_url":"https://github.com/sommerper","followers_url":"https://api.github.com/users/sommerper/followers","following_url":"https://api.github.com/users/sommerper/following{/other_user}","gists_url":"https://api.github.com/users/sommerper/gists{/gist_id}","starred_url":"https://api.github.com/users/sommerper/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/sommerper/subscriptions","organizations_url":"https://api.github.com/users/sommerper/orgs","repos_url":"https://api.github.com/users/sommerper/repos","events_url":"https://api.github.com/users/sommerper/events{/privacy}","received_events_url":"https://api.github.com/users/sommerper/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-04-27T17:31:02Z","updated_at":"2026-04-27T17:31:02Z","body":"I have a drawing tablet as well and am facing the same problem.\nIs there any way to drag stuff with the mouse. Adding CTRL or SHIFT does not help. It's kinda rendering the editor unusable as it is.","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4329137007/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4333246300","html_url":"https://github.com/godotengine/godot/issues/118765#issuecomment-4333246300","issue_url":"https://api.github.com/repos/godotengine/godot/issues/118765","id":4333246300,"node_id":"IC_kwDOAO6SJc8AAAABAkgXXA","user":{"login":"zincles","id":171102793,"node_id":"U_kgDOCjLSSQ","avatar_url":"https://avatars.githubusercontent.com/u/171102793?v=4","gravatar_id":"","url":"https://api.github.com/users/zincles","html_url":"https://github.com/zincles","followers_url":"https://api.github.com/users/zincles/followers","following_url":"https://api.github.com/users/zincles/following{/other_user}","gists_url":"https://api.github.com/users/zincles/gists{/gist_id}","starred_url":"https://api.github.com/users/zincles/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/zincles/subscriptions","organizations_url":"https://api.github.com/users/zincles/orgs","repos_url":"https://api.github.com/users/zincles/repos","events_url":"https://api.github.com/users/zincles/events{/privacy}","received_events_url":"https://api.github.com/users/zincles/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-04-28T07:37:06Z","updated_at":"2026-04-28T07:37:06Z","body":"> I have a drawing tablet as well and am facing the same problem. Is there any way to drag stuff with the mouse. Adding CTRL or SHIFT does not help. It's kinda rendering the editor unusable as it is.\n\nI'm pretty sure it's a wayland problem. well there's some hacky, dirty ways to enable mouse dragging again by manually hijack some key input from your pen screen\n\nas a reference on my pc I uses:\n\n```bash\nsudo evtest --grab /dev/input/event23 /dev/input/event13 /dev/input/event14 /dev/input/event17 /dev/input/event18 /dev/input/event19 /dev/input/event20 /dev/input/event21 /dev/input/event22 > /dev/null 2>&1 &\n```\n\nthat would make my mouse works properly in godot again. pretty hacky. but it has not been widely tested, and probably might not fix your problem.\n\nswitched back to 4.6 stable temporarily before this got fixed. i believe it's better to add an option to manually disable touch screen optimization.","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4333246300/reactions","total_count":1,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":1},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4334365321","html_url":"https://github.com/godotengine/godot/issues/118765#issuecomment-4334365321","issue_url":"https://api.github.com/repos/godotengine/godot/issues/118765","id":4334365321,"node_id":"IC_kwDOAO6SJc8AAAABAlkqiQ","user":{"login":"sommerper","id":1512048,"node_id":"MDQ6VXNlcjE1MTIwNDg=","avatar_url":"https://avatars.githubusercontent.com/u/1512048?v=4","gravatar_id":"","url":"https://api.github.com/users/sommerper","html_url":"https://github.com/sommerper","followers_url":"https://api.github.com/users/sommerper/followers","following_url":"https://api.github.com/users/sommerper/following{/other_user}","gists_url":"https://api.github.com/users/sommerper/gists{/gist_id}","starred_url":"https://api.github.com/users/sommerper/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/sommerper/subscriptions","organizations_url":"https://api.github.com/users/sommerper/orgs","repos_url":"https://api.github.com/users/sommerper/repos","events_url":"https://api.github.com/users/sommerper/events{/privacy}","received_events_url":"https://api.github.com/users/sommerper/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-04-28T10:24:40Z","updated_at":"2026-04-28T10:24:40Z","body":"@zincles Thanks for the tip 👍, but I'd rather not mess with that. I've also reverted to the dev version just before it was implemented.","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4334365321/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4779108404","html_url":"https://github.com/godotengine/godot/issues/118765#issuecomment-4779108404","issue_url":"https://api.github.com/repos/godotengine/godot/issues/118765","id":4779108404,"node_id":"IC_kwDOAO6SJc8AAAABHNtoNA","user":{"login":"Arignir","id":4798413,"node_id":"MDQ6VXNlcjQ3OTg0MTM=","avatar_url":"https://avatars.githubusercontent.com/u/4798413?v=4","gravatar_id":"","url":"https://api.github.com/users/Arignir","html_url":"https://github.com/Arignir","followers_url":"https://api.github.com/users/Arignir/followers","following_url":"https://api.github.com/users/Arignir/following{/other_user}","gists_url":"https://api.github.com/users/Arignir/gists{/gist_id}","starred_url":"https://api.github.com/users/Arignir/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Arignir/subscriptions","organizations_url":"https://api.github.com/users/Arignir/orgs","repos_url":"https://api.github.com/users/Arignir/repos","events_url":"https://api.github.com/users/Arignir/events{/privacy}","received_events_url":"https://api.github.com/users/Arignir/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-06-23T12:19:37Z","updated_at":"2026-06-23T12:19:37Z","body":"I'm having the same issue and it's driving me crazy. On my case it's because my laptop has a touchscreen but it is disabled literally everywhere, even in the BIOS I think. I had to disable all the touchscreen options after updating to 4.7 to get a working Godot again, except the scrolling thing in the editor which is incredibly frustrating.\n\nIt would be really nice to have a \"please don't consider my screen a touch screen\" option somewhere, or, if possible, to clearly distinguish events coming from the mouse than events coming from the touchscreen.","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4779108404/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null}]