api.github.com/users/AThousandShips/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"","state":"COMMENTED","html_url":"https://github.com/godotengine/godot/pull/113635#pullrequestreview-3634203276","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/113635","author_association":"MEMBER","_links":{"html":{"href":"https://github.com/godotengine/godot/pull/113635#pullrequestreview-3634203276"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/113635"}},"submitted_at":"2026-01-07T10:20:48Z","commit_id":null},{"id":3634961692,"node_id":"PRR_kwDOAO6SJc7YqR0c","user":{"login":"Nintorch","id":92302738,"node_id":"U_kgDOBYBtkg","avatar_url":"https://avatars.githubusercontent.com/u/92302738?u=f6c14ec512c7cd33f8d109f121e89b7e60e42f38&v=4","gravatar_id":"","url":"https://api.github.com/users/Nintorch","html_url":"https://github.com/Nintorch","followers_url":"https://api.github.com/users/Nintorch/followers","following_url":"https://api.github.com/users/Nintorch/following{/other_user}","gists_url":"https://api.github.com/users/Nintorch/gists{/gist_id}","starred_url":"https://api.github.com/users/Nintorch/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Nintorch/subscriptions","organizations_url":"https://api.github.com/users/Nintorch/orgs","repos_url":"https://api.github.com/users/Nintorch/repos","events_url":"https://api.github.com/users/Nintorch/events{/privacy}","received_events_url":"https://api.github.com/users/Nintorch/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"","state":"COMMENTED","html_url":"https://github.com/godotengine/godot/pull/113635#pullrequestreview-3634961692","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/113635","author_association":"MEMBER","_links":{"html":{"href":"https://github.com/godotengine/godot/pull/113635#pullrequestreview-3634961692"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/113635"}},"submitted_at":"2026-01-07T13:42:12Z","commit_id":null},{"id":3666711596,"node_id":"PRR_kwDOAO6SJc7ajZQs","user":{"login":"Alex2782","id":41921395,"node_id":"MDQ6VXNlcjQxOTIxMzk1","avatar_url":"https://avatars.githubusercontent.com/u/41921395?u=74caa4e396a8e2995ac648a80f7488601d679e63&v=4","gravatar_id":"","url":"https://api.github.com/users/Alex2782","html_url":"https://github.com/Alex2782","followers_url":"https://api.github.com/users/Alex2782/followers","following_url":"https://api.github.com/users/Alex2782/following{/other_user}","gists_url":"https://api.github.com/users/Alex2782/gists{/gist_id}","starred_url":"https://api.github.com/users/Alex2782/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Alex2782/subscriptions","organizations_url":"https://api.github.com/users/Alex2782/orgs","repos_url":"https://api.github.com/users/Alex2782/repos","events_url":"https://api.github.com/users/Alex2782/events{/privacy}","received_events_url":"https://api.github.com/users/Alex2782/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"I'm not sure if `held in front of you` is the correct description for Android devices. Unfortunately, I can't say what the correct answer is either. More research and testing are needed.\r\n\r\n\r\n**this PR**\r\n```\r\nFor a device held in front of you, the returned axes are defined as follows:\r\n+X ... -X: left ... right;\r\n+Y ... -Y: bottom ... top;\r\n+Z ... -Z: farther ... closer.\r\n```\r\n\r\n------------\r\n\r\nThat's in the SDL header file in your first post.\r\nI think `held in front of you` applies to gamepads but not to tablets and smartphones?\r\n\r\n`held in natural orientation` means to me that tablets are in landscape mode and smartphones in portrait mode.\r\n\r\n\r\n**SDL_sensor.h**\r\n```\r\n  * For phones and tablets held in natural orientation and game controllers \r\n  * held in front of you, the axes are defined as follows: \r\n  * \r\n  * - -X ... +X : left ... right \r\n  * - -Y ... +Y : bottom ... top \r\n  * - -Z ... +Z : farther ... closer \r\n```\r\n------------\r\n\r\nCheck this demo (Note: Sensors may need to be activated in the project settings)\r\n\r\nhttps://github.com/godotengine/godot-demo-projects/tree/master/mobile/sensors\r\n\r\nand the comments in this GdScript file:\r\nhttps://github.com/godotengine/godot-demo-projects/blob/master/mobile/sensors/main.gd\r\n\r\n\r\nWhen I start the project on my tablet and smartphone (orientation landscape), I have 2 different orientations of the cubes and the arrows. _It could also be that this calculation is outdated or not entirely correct._\r\n\r\n","state":"COMMENTED","html_url":"https://github.com/godotengine/godot/pull/113635#pullrequestreview-3666711596","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/113635","author_association":"MEMBER","_links":{"html":{"href":"https://github.com/godotengine/godot/pull/113635#pullrequestreview-3666711596"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/113635"}},"submitted_at":"2026-01-15T17:14:09Z","commit_id":null},{"id":3697163737,"node_id":"PRR_kwDOAO6SJc7cXj3Z","user":{"login":"Alex2782","id":41921395,"node_id":"MDQ6VXNlcjQxOTIxMzk1","avatar_url":"https://avatars.githubusercontent.com/u/41921395?u=74caa4e396a8e2995ac648a80f7488601d679e63&v=4","gravatar_id":"","url":"https://api.github.com/users/Alex2782","html_url":"https://github.com/Alex2782","followers_url":"https://api.github.com/users/Alex2782/followers","following_url":"https://api.github.com/users/Alex2782/following{/other_user}","gists_url":"https://api.github.com/users/Alex2782/gists{/gist_id}","starred_url":"https://api.github.com/users/Alex2782/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Alex2782/subscriptions","organizations_url":"https://api.github.com/users/Alex2782/orgs","repos_url":"https://api.github.com/users/Alex2782/repos","events_url":"https://api.github.com/users/Alex2782/events{/privacy}","received_events_url":"https://api.github.com/users/Alex2782/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"I don't think a physics lecture is necessary. It simply needs to be understandable for developers; the topic is probably too complex to be described clearly in one or two sentences. @godotengine/documentation would have to rate it\n\nPerhaps a reference to the Android documentation would be helpful.\n\nhttps://developer.android.com/develop/sensors-and-location/sensors/sensors_overview#sensors-coords\n\n<img width=\"284\" height=\"338\" alt=\"Image\" src=\"https://github.com/user-attachments/assets/94556bc4-a870-4f5c-8349-44ec57086344\" />\n","state":"COMMENTED","html_url":"https://github.com/godotengine/godot/pull/113635#pullrequestreview-3697163737","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/113635","author_association":"MEMBER","_links":{"html":{"href":"https://github.com/godotengine/godot/pull/113635#pullrequestreview-3697163737"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/113635"}},"submitted_at":"2026-01-23T11:56:44Z","commit_id":null},{"id":4012011798,"node_id":"PRR_kwDOAO6SJc7vInEW","user":{"login":"Nintorch","id":92302738,"node_id":"U_kgDOBYBtkg","avatar_url":"https://avatars.githubusercontent.com/u/92302738?u=f6c14ec512c7cd33f8d109f121e89b7e60e42f38&v=4","gravatar_id":"","url":"https://api.github.com/users/Nintorch","html_url":"https://github.com/Nintorch","followers_url":"https://api.github.com/users/Nintorch/followers","following_url":"https://api.github.com/users/Nintorch/following{/other_user}","gists_url":"https://api.github.com/users/Nintorch/gists{/gist_id}","starred_url":"https://api.github.com/users/Nintorch/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Nintorch/subscriptions","organizations_url":"https://api.github.com/users/Nintorch/orgs","repos_url":