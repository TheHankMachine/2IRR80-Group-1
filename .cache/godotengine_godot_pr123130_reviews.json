godot/pull/123130#pullrequestreview-5100863282"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/123130"}},"submitted_at":"2026-09-03T10:40:55Z","commit_id":"da31fa9bb515810d4bc322d2ff8398f69c5a9598"},{"id":5106837349,"node_id":"PRR_kwDOAO6SJc8AAAABMGQnZQ","user":{"login":"kitbdev","id":10054226,"node_id":"MDQ6VXNlcjEwMDU0MjI2","avatar_url":"https://avatars.githubusercontent.com/u/10054226?u=f0c85fe8c24debe91dc14d7efa97b51a19250b47&v=4","gravatar_id":"","url":"https://api.github.com/users/kitbdev","html_url":"https://github.com/kitbdev","followers_url":"https://api.github.com/users/kitbdev/followers","following_url":"https://api.github.com/users/kitbdev/following{/other_user}","gists_url":"https://api.github.com/users/kitbdev/gists{/gist_id}","starred_url":"https://api.github.com/users/kitbdev/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/kitbdev/subscriptions","organizations_url":"https://api.github.com/users/kitbdev/orgs","repos_url":"https://api.github.com/users/kitbdev/repos","events_url":"https://api.github.com/users/kitbdev/events{/privacy}","received_events_url":"https://api.github.com/users/kitbdev/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"","state":"COMMENTED","html_url":"https://github.com/godotengine/godot/pull/123130#pullrequestreview-5106837349","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/123130","author_association":"CONTRIBUTOR","_links":{"html":{"href":"https://github.com/godotengine/godot/pull/123130#pullrequestreview-5106837349"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/123130"}},"submitted_at":"2026-09-03T21:26:28Z","commit_id":"674aac50567513bd28ef4a512ba564952f4e2bfb"},{"id":5233508173,"node_id":"PRR_kwDOAO6SJc8AAAABN_D_TQ","user":{"login":"Ivorforce","id":2308167,"node_id":"MDQ6VXNlcjIzMDgxNjc=","avatar_url":"https://avatars.githubusercontent.com/u/2308167?u=f7f8e0273f784f5ec6f6b7fe4a88d449896eb48a&v=4","gravatar_id":"","url":"https://api.github.com/users/Ivorforce","html_url":"https://github.com/Ivorforce","followers_url":"https://api.github.com/users/Ivorforce/followers","following_url":"https://api.github.com/users/Ivorforce/following{/other_user}","gists_url":"https://api.github.com/users/Ivorforce/gists{/gist_id}","starred_url":"https://api.github.com/users/Ivorforce/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Ivorforce/subscriptions","organizations_url":"https://api.github.com/users/Ivorforce/orgs","repos_url":"https://api.github.com/users/Ivorforce/repos","events_url":"https://api.github.com/users/Ivorforce/events{/privacy}","received_events_url":"https://api.github.com/users/Ivorforce/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"I think this makes sense. \r\n\r\nI would change the approach though: Instead of accepting \"scopes\", I would just accept a parameter \"pure only\". Because that's the concern: We want expressions that have no side effects. We don't specifically need \"math only\" or \"random only\" or \"general only\".\r\n\r\nThat would also allow us to switch the implementation to \"actually pure only\" [when we add that](https://github.com/godotengine/godot-proposals/issues/14204), and should be easier to maintain than the flags.\r\n\r\n@Mickeon This is a security concern. It's not something someone specifically asked for, but allowing arbitrary code to be executed from spin boxes and plural rules could plausibly be used in exploit chains as a privilege escalation.","state":"CHANGES_REQUESTED","html_url":"https://github.com/godotengine/godot/pull/123130#pullrequestreview-5233508173","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/123130","author_association":"MEMBER","_links":{"html":{"href":"https://github.com/godotengine/godot/pull/123130#pullrequestreview-5233508173"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/123130"}},"submitted_at":"2026-09-17T09:10:45Z","commit_id":"674aac50567513bd28ef4a512ba564952f4e2bfb"},{"id":5225889186,"node_id":"PRR_kwDOAO6SJc8AAAABN3y9og","user":{"login":"kitbdev","id":10054226,"node_id":"MDQ6VXNlcjEwMDU0MjI2","avatar_url":"https://avatars.githubusercontent.com/u/10054226?u=f0c85fe8c24debe91dc14d7efa97b51a19250b47&v=4","gravatar_id":"","url":"https://api.github.com/users/kitbdev","html_url":"https://github.com/kitbdev","followers_url":"https://api.github.com/users/kitbdev/followers","following_url":"https://api.github.com/users/kitbdev/following{/other_user}","gists_url":"https://api.github.com/users/kitbdev/gists{/gist_id}","starred_url":"https://api.github.com/users/kitbdev/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/kitbdev/subscriptions","organizations_url":"https://api.github.com/users/kitbdev/orgs","repos_url":"https://api.github.com/users/kitbdev/repos","events_url":"https://api.github.com/users/kitbdev/events{/privacy}","received_events_url":"https://api.github.com/users/kitbdev/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"About making it just pure functions, all random functions modify the default rng so they technically have side effects, but they are useful to keep here.\r\nIt may also be useful for users to be able to disable all built in methods for their expressions, but I guess that would need a separate proposal.\r\n\r\nI guess it could be an enum like \"pure only\", \"pure and random\", and \"all\".","state":"COMMENTED","html_url":"https://github.com/godotengine/godot/pull/123130#pullrequestreview-5225889186","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/123130","author_association":"CONTRIBUTOR","_links":{"html":{"href":"https://github.com/godotengine/godot/pull/123130#pullrequestreview-5225889186"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/123130"}},"submitted_at":"2026-09-17T15:04:11Z","commit_id":"674aac50567513bd28ef4a512ba564952f4e2bfb"}]