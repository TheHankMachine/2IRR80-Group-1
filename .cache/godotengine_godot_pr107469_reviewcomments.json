t feel comfortable simply changing the type above (without testing), due to CoW overheads during the loops, if the arrays are going to be forked each iteration anyway.","created_at":"2025-06-13T08:36:30Z","updated_at":"2025-06-13T08:46:10Z","html_url":"https://github.com/godotengine/godot/pull/107469#discussion_r2144499083","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/107469","_links":{"self":{"href":"https://api.github.com/repos/godotengine/godot/pulls/comments/2144499083"},"html":{"href":"https://github.com/godotengine/godot/pull/107469#discussion_r2144499083"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/107469"}},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/2144499083/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":1716,"start_side":"RIGHT","line":null,"original_line":1717,"side":"RIGHT","in_reply_to_id":2144483580,"author_association":"MEMBER","original_position":7,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/2145333115","pull_request_review_id":2925225728,"id":2145333115,"node_id":"PRRC_kwDOAO6SJc5_3y97","diff_hunk":"@@ -101,7 +101,7 @@ Vector<uint8_t> WaylandThread::_read_fd(int fd) {\n \t\tdata.resize(bytes_read + chunk_size);\n \t}\n \n-\treturn data;\n+\treturn Vector<uint8_t>(data);","path":"platform/linuxbsd/wayland/wayland_thread.cpp","commit_id":"abe3b481aea7ef7fa88fa7230743d7f415786635","original_commit_id":"b63645c6b1287e5166e1bed1923d8a3d22f46313","user":{"login":"deralmas","id":31065808,"node_id":"MDQ6VXNlcjMxMDY1ODA4","avatar_url":"https://avatars.githubusercontent.com/u/31065808?v=4","gravatar_id":"","url":"https://api.github.com/users/deralmas","html_url":"https://github.com/deralmas","followers_url":"https://api.github.com/users/deralmas/followers","following_url":"https://api.github.com/users