ull` constant. But we already have a separate address mode for constants.\r\n2. As a placeholder for the `NIL` address mode (note that it's a different enum `GDScriptCodeGenerator::Address::AddressMode`). For example, for `void` function calls. However, we still shouldn't use this fixed address as a destination, only as a source. Instead, we allocate a temporary or use non-return opcode versions:\r\n\r\nhttps://github.com/godotengine/godot/blob/60fff00a660a2aeb03f88c07fb7baed353bcb72f/modules/gdscript/gdscript_byte_codegen.cpp#L1072-L1084\r\n\r\nhttps://github.com/godotengine/godot/blob/60fff00a660a2aeb03f88c07fb7baed353bcb72f/modules/gdscript/gdscript_byte_codegen.cpp#L1086-L1087\r\n","labels":[{"id":73330066,"node_id":"MDU6TGFiZWw3MzMzMDA2Ng==","url":"https://api.github.com/repos/godotengine/godot/labels/enhancement","name":"enhancement","description":"","color":"aaccff","default":true,"archived_at":null,"archived_by":null},{"id":279096997,"node_id":"MDU6TGFiZWwyNzkwOTY5OTc=","url":"https://api.github.com/repos/godotengine/godot/labels/archived","name":"archived","description":"","color":"aaaaaa","default":false,"archived_at":null,"archived_by":null},{"id":279098082,"node_id":"MDU6TGFiZWwyNzkwOTgwODI=","url":"https://api.github.com/repos/godotengine/godot/labels/topic:gdscript","name":"topic:gdscript","description":"","color":"ffee88","default":false,"archived_at":null,"archived_by":null},{"id":1007033697,"node_id":"MDU6TGFiZWwxMDA3MDMzNjk3","url":"https://api.github.com/repos/godotengine/godot/labels/salvageable","name":"salvageable","description":"","color":"ff7766","default":false,"archived_at":null,"archived_by":null}],"milestone":null,"active_lock_reason":null,"created_at":"2026-03-26T13:50:53Z","updated_at":"2026-10-09T09:53:51Z","closed_at":"2026-10-09T08:12:09Z","merged_at":null,"merge_commit_sha":"14584218b9590c2e42ab8811db89af087433e39c","assignee":null,"assignees":[],"requested_reviewers":[],"requested_teams":[],"head":{"label":"dalexeev:gds-remove-fixe