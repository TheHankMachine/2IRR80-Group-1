"color":"ffee88","default":false,"description":"","archived_at":null,"archived_by":null}],"state":"open","locked":false,"assignees":[],"milestone":{"url":"https://api.github.com/repos/godotengine/godot/milestones/25","html_url":"https://github.com/godotengine/godot/milestone/25","labels_url":"https://api.github.com/repos/godotengine/godot/milestones/25/labels","id":15520464,"node_id":"MI_kwDOAO6SJc4A7NLQ","number":25,"title":"4.8","description":"","creator":{"login":"Repiteo","id":17489292,"node_id":"MDQ6VXNlcjE3NDg5Mjky","avatar_url":"https://avatars.githubusercontent.com/u/17489292?v=4","gravatar_id":"","url":"https://api.github.com/users/Repiteo","html_url":"https://github.com/Repiteo","followers_url":"https://api.github.com/users/Repiteo/followers","following_url":"https://api.github.com/users/Repiteo/following{/other_user}","gists_url":"https://api.github.com/users/Repiteo/gists{/gist_id}","starred_url":"https://api.github.com/users/Repiteo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Repiteo/subscriptions","organizations_url":"https://api.github.com/users/Repiteo/orgs","repos_url":"https://api.github.com/users/Repiteo/repos","events_url":"https://api.github.com/users/Repiteo/events{/privacy}","received_events_url":"https://api.github.com/users/Repiteo/received_events","type":"User","user_view_type":"public","site_admin":false},"open_issues":345,"closed_issues":2336,"state":"open","created_at":"2026-04-13T15:59:35Z","updated_at":"2026-10-22T08:21:32Z","due_on":null,"closed_at":null},"comments":0,"created_at":"2026-10-02T22:17:13Z","updated_at":"2026-10-02T23:23:26Z","closed_at":null,"assignee":null,"author_association":"CONTRIBUTOR","issue_field_values":[],"type":null,"active_lock_reason":null,"draft":false,"pull_request":{"url":"https://api.github.com/repos/godotengine/godot/pulls/124116","html_url":"https://github.com/godotengine/godot/pull/124116","diff_url":"https://github.com/godotengine/godot/pull/124116.diff","patch_url":"https://github.com/godotengine/godot/pull/124116.patch","merged_at":null},"body":"## What problem(s) does this PR solve?\r\n\r\n- Closes #124115\r\n\r\n## Additional information\r\n\r\nTechnical explanation already offered in issue, here a bit lower level:\r\nWhen loading the candidates, first history, then all other resources that match in type are added to the quick load dialog\r\nThe problem is that history candidates are loaded regardless if they are in the addons folder or not. \r\nThis causes an error when `add_candidate` is called, because the resource cannot be found in the `filetypes` resulting in both the error being shown and the rest of the candidates being one off in the indices.\r\n\r\nThe fix:\r\nBefore adding candidates from history it is checked if the resource should be shown based on the current state of the \"Addons\" toggle and the location of the resource in the project.","closed_by":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/124116/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/godotengine/godot/issues/124116/timeline","performed_via_github_app":null,"state_reason":null}