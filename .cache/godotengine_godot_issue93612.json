ithub.com/users/Sauermann/subscriptions","organizations_url":"https://api.github.com/users/Sauermann/orgs","repos_url":"https://api.github.com/users/Sauermann/repos","events_url":"https://api.github.com/users/Sauermann/events{/privacy}","received_events_url":"https://api.github.com/users/Sauermann/received_events","type":"User","user_view_type":"public","site_admin":false},"open_issues":3,"closed_issues":3687,"state":"closed","created_at":"2024-12-19T08:51:28Z","updated_at":"2026-09-04T21:48:38Z","due_on":"2025-09-15T00:00:00Z","closed_at":"2025-09-18T17:13:14Z"},"comments":32,"created_at":"2024-06-26T00:01:30Z","updated_at":"2025-04-11T14:58:32Z","closed_at":"2024-08-11T23:00:45Z","assignee":null,"author_association":"NONE","issue_field_values":[],"type":null,"active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"### Tested versions\r\n\r\nOccurs in v4.3.beta1.official [a4f2ea91a], v4.3.beta2.official [b75f0485b], v4.3.beta3.official [82cedc83c], v4.3.rc1.official [e343dbbcc], v4.3.rc2.official [3978628c6], v4.3.rc3.official [03afb92ef].\r\nDoes not occur in v4.3.dev6.official [64520fe67].\r\n\r\n### System information\r\n\r\nGodot v4.3.rc3 - Pop!_OS 20.04 LTS - X11 - GLES3 (Compatibility) - Mesa Intel(R) UHD Graphics 630 (CFL GT2) - Intel(R) Core(TM) i9-9900K CPU @ 3.60GHz (16 Threads)\r\n\r\nAndroid device info: Galaxy S9 (Model SM-G960U), Android 10\r\n\r\n### Issue description\r\n\r\nI observed this problem in an Android export of a complex project in Godot 4.3 (see **Tested versions** above).  It does not occur when running in the Editor.\r\n\r\nFor reference, here's the comparison of Godot 4.3-dev6 to Godot 4.3-beta1:\r\nhttps://github.com/godotengine/godot/compare/64520fe..a4f2ea9\r\n\r\nThe symptom is that when a Button or CheckBox control is touched in an Android export, sometimes the connected action does not occur. The \"button_down\" and \"button_up\" signals are always emitted. But the \"pressed\" and \"toggled\" signals are not emitted when the problem occurs.\r\n\r\n### Steps to reproduce\r\n\r\nThe problem occurs if I set the BaseButton action_mode property to ACTION_MODE_BUTTON_RELEASE, but does not occur when the property is set to ACTION_MODE_BUTTON_PRESS.\r\n\r\nI've only observed the problem when the controls are in a PackedScene that's loaded and instanced at runtime.\r\n\r\n### Minimal reproduction project (MRP)\r\n\r\nI'm attaching an MRP. However, it does not consistently exhibit the problem. If I can create another MRP that consistently exhibits the problem, I'll attach it.\r\n\r\nThe deep structure and node types in the scene tree in the MRP replicates the scene tree in the project where I observed the problem. \r\n\r\n[fg_debug1.zip](https://github.com/user-attachments/files/15980819/fg_debug1.zip)\r\n\r\n","closed_by":{"login":"daveTheOldCoder","id":55119684,"node_id":"MDQ6VXNlcjU1MTE5Njg0","avatar_url":"https://avatars.githubusercontent.com/u/55119684?v=4","gravatar_id":"","url":"https://api.github.com/users/daveTheOldCoder","html_url":"https://github.com/daveTheOldCoder","followers_url":"https://api.github.com/users/daveTheOldCoder/followers","following_url":"https://api.github.com/users/daveTheOldCoder/following{/other_user}","gists_url":"https://api.github.com/users/daveTheOldCoder/gists{/gist_id}","starred_url":"https://api.github.com/users/daveTheOldCoder/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/daveTheOldCoder/subscriptions","organizations_url":"https://api.github.com/users/daveTheOldCoder/orgs","repos_url":"https://api.github.com/users/daveTheOldCoder/repos","events_url":"https://api.github.com/users/daveTheOldCoder/events{/privacy}","received_events_url":"https://api.github.com/users/daveTheOldCoder/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.githu