[{"id":3317088043,"node_id":"PRR_kwDOAO6SJc7Ftr8r","state":"APPROVED","user":{"site_admin":false,"suspended":false,"updated_at":"0001-01-01T00:00:00Z","avatar_url":"https://avatars.githubusercontent.com/u/1646875?u=24618295fece29a0bf5c850faf2555985232f5f2&v=4","created_at":"0001-01-01T00:00:00Z","followers":0,"following":0,"html_url":"https://github.com/aaronfranke","id":1646875,"node_id":"MDQ6VXNlcjE2NDY4NzU=","login":"aaronfranke","type":"User","owned_private_repos":0,"public_gists":0,"public_repos":0,"total_private_repos":0,"url":"https://api.github.com/users/aaronfranke"},"body":"Looks good to me! Indeed, we should register types at a minimum in order of inheritance, and maybe in order of dependency too when appropriate.\r\n\r\nFun fact, with GDExtension C++, you MUST register types in order of inheritance, or else the extension breaks. But it seems doing this in engine code has been unhelpfully flexible so far, so I agree we should make it more strict to ensure things are registered in order (this PR then PR #106873).","html_url":"https://github.com/godotengine/godot/pull/111431#pullrequestreview-3317088043","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/111431","author_association":"MEMBER","submitted_at":"2025-10-09T03:13:03Z"},{"id":3318026043,"node_id":"PRR_kwDOAO6SJc7FxQ87","state":"COMMENTED","user":{"site_admin":false,"suspended":false,"updated_at":"0001-01-01T00:00:00Z","avatar_url":"https://avatars.githubusercontent.com/u/4701338?u=4a42fd867f2c449fcc23adf635dd574dae98e6c2&v=4","created_at":"0001-01-01T00:00:00Z","followers":0,"following":0,"html_url":"https://github.com/akien-mga","id":4701338,"node_id":"MDQ6VXNlcjQ3MDEzMzg=","login":"akien-mga","type":"User","owned_private_repos":0,"public_gists":0,"public_repos":0,"total_private_repos":0,"url":"https://api.github.com/users/akien-mga"},"body":"","html_url":"https://github.com/godotengine/godot/pull/111431#pullrequestreview-3318026043","pull_request_url":"https://api.github.co