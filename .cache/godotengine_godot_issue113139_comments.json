actions","total_count":1,"+1":0,"-1":0,"laugh":0,"hooray":1,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4443354052","html_url":"https://github.com/godotengine/godot/issues/113139#issuecomment-4443354052","issue_url":"https://api.github.com/repos/godotengine/godot/issues/113139","id":4443354052,"node_id":"IC_kwDOAO6SJc8AAAABCNgzxA","user":{"login":"themancalledjakob","id":1830798,"node_id":"MDQ6VXNlcjE4MzA3OTg=","avatar_url":"https://avatars.githubusercontent.com/u/1830798?v=4","gravatar_id":"","url":"https://api.github.com/users/themancalledjakob","html_url":"https://github.com/themancalledjakob","followers_url":"https://api.github.com/users/themancalledjakob/followers","following_url":"https://api.github.com/users/themancalledjakob/following{/other_user}","gists_url":"https://api.github.com/users/themancalledjakob/gists{/gist_id}","starred_url":"https://api.github.com/users/themancalledjakob/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/themancalledjakob/subscriptions","organizations_url":"https://api.github.com/users/themancalledjakob/orgs","repos_url":"https://api.github.com/users/themancalledjakob/repos","events_url":"https://api.github.com/users/themancalledjakob/events{/privacy}","received_events_url":"https://api.github.com/users/themancalledjakob/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-05-13T16:52:35Z","updated_at":"2026-05-14T10:47:35Z","body":"@AThousandShips hmm... the proposed solution does not work in all cases, and it did work in earlier versions.\n\nconsider this:\n```gdscript\nextends Node\n\n# Here we create a reference to the `_my_callback` function (below).\n# This reference will be kept until the node is freed.\nvar _callback_ref = JavaScriptBridge.create_callback(_my_callback)\n\nfunc _ready():\n\t# Get the JavaScript `window` object.\n\tvar window = JavaScriptBridge.get_interface(\"window\")\n\t# Set the `window.onbeforeunload` DOM event listener.\n\twindow.my_test = _callback_ref\n\nfunc _my_callback(_args):\n\treturn 42\n```\n\n```javascript\n// javascript code:\nwindow.my_test() // returns null\n```\n\nhowever, the trick with `args[0].returnValue` does not work, because the passed array `args` is empty.\nI just updated an old project from Godot 4.0 to 4.6 and ran into this, so this worked before.\n\nI believe something must go wrong somewhere here after all: https://github.com/godotengine/godot/blob/9a33066a27d70c6d4f74cae44c1ce023d8082a59/platform/web/js/libs/library_godot_javascript_singleton.js#L219-L246\n\nthe return value should be passed, but it is always `null` for me with `Godot Engine v4.6.1.stable.official [14d19694e]`\nI just confirmed it works with `Godot Engine v4.0.4.stable.official [fc0b241c9]`\n\nCould this have happened, when web threading was overhauled?","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4443354052/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4448641939","html_url":"https://github.com/godotengine/godot/issues/113139#issuecomment-4448641939","issue_url":"https://api.github.com/repos/godotengine/godot/issues/113139","id":4448641939,"node_id":"IC_kwDOAO6SJc8AAAABCSjjkw","user":{"login":"AThousandShips","id":96648715,"node_id":"U_kgDOBcK-Cw","avatar_url":"https://avatars.githubusercontent.com/u/96648715?v=4","gravatar_id":"","url":"https://api.github.com/users/AThousandShips","html_url":"https://github.com/AThousandShips","followers_url":"https://api.github.com/users/AThousandShips/followers","following_url":"https://api.github.com/users/AThousandShips/following{/other_user}","gists_url":"https://api.github.com/use