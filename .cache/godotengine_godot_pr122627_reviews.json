[{"id":4980074313,"node_id":"PRR_kwDOAO6SJc8AAAABKNXnSQ","user":{"login":"Ivorforce","id":2308167,"node_id":"MDQ6VXNlcjIzMDgxNjc=","avatar_url":"https://avatars.githubusercontent.com/u/2308167?u=f7f8e0273f784f5ec6f6b7fe4a88d449896eb48a&v=4","gravatar_id":"","url":"https://api.github.com/users/Ivorforce","html_url":"https://github.com/Ivorforce","followers_url":"https://api.github.com/users/Ivorforce/followers","following_url":"https://api.github.com/users/Ivorforce/following{/other_user}","gists_url":"https://api.github.com/users/Ivorforce/gists{/gist_id}","starred_url":"https://api.github.com/users/Ivorforce/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Ivorforce/subscriptions","organizations_url":"https://api.github.com/users/Ivorforce/orgs","repos_url":"https://api.github.com/users/Ivorforce/repos","events_url":"https://api.github.com/users/Ivorforce/events{/privacy}","received_events_url":"https://api.github.com/users/Ivorforce/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"The assumption from `memcpy` as used here isn't that it's trivially copyable, it's that it's trivially relocatable. The old data isn't used anymore after the `memcpy` so it isn't a copy at all.\r\n\r\nSee also https://github.com/godotengine/godot/issues/100509\r\n\r\nThe fact that there isn't a bug associated with the PR but only a theoretical issue should tip you off that this isn't a problem in practice.","state":"CHANGES_REQUESTED","html_url":"https://github.com/godotengine/godot/pull/122627#pullrequestreview-4980074313","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/122627","author_association":"MEMBER","_links":{"html":{"href":"https://github.com/godotengine/godot/pull/122627#pullrequestreview-4980074313"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/122627"}},"submitted_at":"2026-08-20T07:21:29Z","commit_id":"6aa130eb09f643ceeb03cb6232d7fac62506b79a"}]