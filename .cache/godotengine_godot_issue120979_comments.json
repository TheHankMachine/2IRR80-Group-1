nsive is fine since its supposed to be more accurate in exchange for being more expensive anyway","author_association":"NONE","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5019468656/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null}]