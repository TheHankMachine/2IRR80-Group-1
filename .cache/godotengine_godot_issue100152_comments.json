/assets/02fa6f31-d5b5-441e-abee-f9b6b211500e\" />","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4184110196/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4360709066","html_url":"https://github.com/godotengine/godot/issues/100152#issuecomment-4360709066","issue_url":"https://api.github.com/repos/godotengine/godot/issues/100152","id":4360709066,"node_id":"IC_kwDOAO6SJc8AAAABA-sjyg","user":{"login":"Copperplate","id":16230743,"node_id":"MDQ6VXNlcjE2MjMwNzQz","avatar_url":"https://avatars.githubusercontent.com/u/16230743?v=4","gravatar_id":"","url":"https://api.github.com/users/Copperplate","html_url":"https://github.com/Copperplate","followers_url":"https://api.github.com/users/Copperplate/followers","following_url":"https://api.github.com/users/Copperplate/following{/other_user}","gists_url":"https://api.github.com/users/Copperplate/gists{/gist_id}","starred_url":"https://api.github.com/users/Copperplate/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Copperplate/subscriptions","organizations_url":"https://api.github.com/users/Copperplate/orgs","repos_url":"https://api.github.com/users/Copperplate/repos","events_url":"https://api.github.com/users/Copperplate/events{/privacy}","received_events_url":"https://api.github.com/users/Copperplate/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-05-01T17:40:15Z","updated_at":"2026-05-01T17:41:12Z","body":"> Please note that focus will be stolen, even in the case where the user is inputing a search term in the inspector (for example: to find the material and close it ;))\n> It is only possible to search after closing the material resource. Otherwise focus will continue to be stolen.\n\nI just came across this too. Only the first letter of what you are searching for can be typed in the \"Filter Properties\" category of the Inspector, all subsequent letters will be hijacked and added to your script in the Shader Editor. **This is a very severe bug**. Thank you for looking into this.\n","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4360709066/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null}]