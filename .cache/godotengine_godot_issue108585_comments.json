[{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3067299332","html_url":"https://github.com/godotengine/godot/issues/108585#issuecomment-3067299332","issue_url":"https://api.github.com/repos/godotengine/godot/issues/108585","id":3067299332,"node_id":"IC_kwDOAO6SJc6200YE","user":{"login":"Lucas-Code27","id":83315414,"node_id":"MDQ6VXNlcjgzMzE1NDE0","avatar_url":"https://avatars.githubusercontent.com/u/83315414?v=4","gravatar_id":"","url":"https://api.github.com/users/Lucas-Code27","html_url":"https://github.com/Lucas-Code27","followers_url":"https://api.github.com/users/Lucas-Code27/followers","following_url":"https://api.github.com/users/Lucas-Code27/following{/other_user}","gists_url":"https://api.github.com/users/Lucas-Code27/gists{/gist_id}","starred_url":"https://api.github.com/users/Lucas-Code27/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Lucas-Code27/subscriptions","organizations_url":"https://api.github.com/users/Lucas-Code27/orgs","repos_url":"https://api.github.com/users/Lucas-Code27/repos","events_url":"https://api.github.com/users/Lucas-Code27/events{/privacy}","received_events_url":"https://api.github.com/users/Lucas-Code27/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-07-13T21:01:46Z","updated_at":"2025-07-13T21:01:46Z","body":"I'm pretty sure overlapping areas are other area nodes in the area's collision shape and overlaps are just areas and bodies inside the area's collision shape","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3067299332/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3067395693","html_url":"https://github.com/godotengine/godot/issues/108585#issuecomment-3067395693","issue_url":"http