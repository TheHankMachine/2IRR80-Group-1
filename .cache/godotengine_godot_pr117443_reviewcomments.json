=4","gravatar_id":"","url":"https://api.github.com/users/Ivorforce","html_url":"https://github.com/Ivorforce","followers_url":"https://api.github.com/users/Ivorforce/followers","following_url":"https://api.github.com/users/Ivorforce/following{/other_user}","gists_url":"https://api.github.com/users/Ivorforce/gists{/gist_id}","starred_url":"https://api.github.com/users/Ivorforce/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Ivorforce/subscriptions","organizations_url":"https://api.github.com/users/Ivorforce/orgs","repos_url":"https://api.github.com/users/Ivorforce/repos","events_url":"https://api.github.com/users/Ivorforce/events{/privacy}","received_events_url":"https://api.github.com/users/Ivorforce/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"Oh yea, this should totally be `super_type-›finalize()` 😅 Must have mistyped in my last change, good catch!\n","created_at":"2026-09-17T16:30:57Z","updated_at":"2026-09-17T16:30:57Z","html_url":"https://github.com/godotengine/godot/pull/117443#discussion_r4039235862","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/117443","_links":{"self":{"href":"https://api.github.com/repos/godotengine/godot/pulls/comments/4039235862"},"html":{"href":"https://github.com/godotengine/godot/pull/117443#discussion_r4039235862"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/117443"}},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/4039235862/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":null,"original_line":62,"side":"RIGHT","in_reply_to_id":4039142399,"author_association":"MEMBER","original_position":9,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/4040667481","pull_request_review_id":5240480229,"id":4040667481,"node_id":"PRRC_kwDOAO6SJc7w17FZ","diff_hunk":"@@ -90,6 +87,15 @@ void GDType::initialize() {\n \tinit_state = InitState::MUTABLE;\n }\n \n+void GDType::finalize() const {\n+\tif (super_type->owning_thread_id != Thread::get_caller_id()) {\n+\t\tWARN_PRINT(\"Finalizing a GDType from a subtype from another thread.\");\n+\t}","path":"core/object/gdtype.cpp","commit_id":"1c3ac33366bb148ef7059cb66e0ad4837b8a191c","original_commit_id":"1c3ac33366bb148ef7059cb66e0ad4837b8a191c","user":{"login":"StarryWorm","id":41305715,"node_id":"MDQ6VXNlcjQxMzA1NzE1","avatar_url":"https://avatars.githubusercontent.com/u/41305715?v=4","gravatar_id":"","url":"https://api.github.com/users/StarryWorm","html_url":"https://github.com/StarryWorm","followers_url":"https://api.github.com/users/StarryWorm/followers","following_url":"https://api.github.com/users/StarryWorm/following{/other_user}","gists_url":"https://api.github.com/users/StarryWorm/gists{/gist_id}","starred_url":"https://api.github.com/users/StarryWorm/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/StarryWorm/subscriptions","organizations_url":"https://api.github.com/users/StarryWorm/orgs","repos_url":"https://api.github.com/users/StarryWorm/repos","events_url":"https://api.github.com/users/StarryWorm/events{/privacy}","received_events_url":"https://api.github.com/users/StarryWorm/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"```suggestion\r\n\tif (owning_thread_id != Thread::get_caller_id()) {\r\n\t\tWARN_PRINT(\"Finalizing a GDType from another thread.\");\r\n\t}\r\n```\r\nNaively moving the check makes it wrong in two ways:\r\nA. The error message, as this may not be called from the subtype, but from the type itself (or someone else entirely calling `type->finalize()`)\r\nB. It checks the `super_type`'s owning thread, which doesn't make sense. \r\n\r\nThe check previously would check the super's thread before finalizing the super. Now it finalizes the super, which checks its own super's thread (i.e., the grandparent)","created_at":"2026-09-17T19:26:52Z","updated_at":"2026-09-17T19:34:40Z","html_url":"https://github.com/godotengine/godot/pull/117443#discussion_r4040667481","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/117443","_links":{"self":{"href":"https://api.github.com/repos/godotengine/godot/pulls/comments/4040667481"},"html":{"href":"https://github.com/godotengine/godot/pull/117443#discussion_r4040667481"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/117443"}},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/4040667481/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":91,"start_side":"RIGHT","line":null,"original_line":93,"side":"RIGHT","author_association":"CONTRIBUTOR","original_position":23,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/4041930141","pull_request_review_id":5242046705,"id":4041930141,"node_id":"PRRC_kwDOAO6SJc7w6vWd","diff_hunk":"@@ -90,6 +87,15 @@ void GDType::initialize() {\n \tinit_state = InitState::MUTABLE;\n }\n \n+void GDType::finalize() const {\n+\tif (super_type->owning_thread_id != Thread::get_caller_id()) {\n+\t\tWARN_PRINT(\"Finalizing a GDType from a subtype from another thread.\");\n+\t}","path":"core/object/gdtype.cpp","commit_id":"1c3ac33366bb148ef7059cb66e0ad4837b8a191c","original_commit_id":"1c3ac33366bb148ef7059cb66e0ad4837b8a191c","user":{"login":"Ivorforce","id":2308167,"node_id":"MDQ6VXNlcjIzMDgxNjc=","avatar_url":"https://avatars.githubusercontent.com/u/2308167?v=4","gravatar_id":"","url":"https://api.github.com/users/Ivorforce","html_url":"https://github.com/Ivorforce","followers_url":"https://api.github.com/users/Ivorforce/followers","following_url":"https://api.github.com/users/Ivorforce/following{/other_user}","gists_url":"h