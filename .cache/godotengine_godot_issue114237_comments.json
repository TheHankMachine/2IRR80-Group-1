d":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3677984470","html_url":"https://github.com/godotengine/godot/pull/114237#issuecomment-3677984470","issue_url":"https://api.github.com/repos/godotengine/godot/issues/114237","id":3677984470,"node_id":"IC_kwDOAO6SJc7bOZbW","user":{"login":"syntaxerror247","id":176927541,"node_id":"U_kgDOCouzNQ","avatar_url":"https://avatars.githubusercontent.com/u/176927541?v=4","gravatar_id":"","url":"https://api.github.com/users/syntaxerror247","html_url":"https://github.com/syntaxerror247","followers_url":"https://api.github.com/users/syntaxerror247/followers","following_url":"https://api.github.com/users/syntaxerror247/following{/other_user}","gists_url":"https://api.github.com/users/syntaxerror247/gists{/gist_id}","starred_url":"https://api.github.com/users/syntaxerror247/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/syntaxerror247/subscriptions","organizations_url":"https://api.github.com/users/syntaxerror247/orgs","repos_url":"https://api.github.com/users/syntaxerror247/repos","events_url":"https://api.github.com/users/syntaxerror247/events{/privacy}","received_events_url":"https://api.github.com/users/syntaxerror247/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-12-20T17:38:46Z","updated_at":"2025-12-20T17:38:46Z","body":"@KoBeWi The native file dialog is fully supported and can be used in projects.\r\nThe issue is that on Android it returns a file URI instead of a file path, which we wouldn't want to expose directly to the user. Additionally, the editor sometimes falls back to the Godot file dialog because the native dialog does not support `res://`, `user://`, or `options`. This becomes a problem because the editor does not currently handle this transition, as it expects a file path.\r\nSo, proper support requires a few changes to the editor's file dialog.\r\n\r\nThis could be implemented now, but we're currently in feature freeze and I also don't have time for it, so I'm planning to handle it in 4.7.","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3677984470/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3703864533","html_url":"https://github.com/godotengine/godot/pull/114237#issuecomment-3703864533","issue_url":"https://api.github.com/repos/godotengine/godot/issues/114237","id":3703864533,"node_id":"IC_kwDOAO6SJc7cxHzV","user":{"login":"akien-mga","id":4701338,"node_id":"MDQ6VXNlcjQ3MDEzMzg=","avatar_url":"https://avatars.githubusercontent.com/u/4701338?v=4","gravatar_id":"","url":"https://api.github.com/users/akien-mga","html_url":"https://github.com/akien-mga","followers_url":"https://api.github.com/users/akien-mga/followers","following_url":"https://api.github.com/users/akien-mga/following{/other_user}","gists_url":"https://api.github.com/users/akien-mga/gists{/gist_id}","starred_url":"https://api.github.com/users/akien-mga/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/akien-mga/subscriptions","organizations_url":"https://api.github.com/users/akien-mga/orgs","repos_url":"https://api.github.com/users/akien-mga/repos","events_url":"https://api.github.com/users/akien-mga/events{/privacy}","received_events_url":"https://api.github.com/users/akien-mga/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-01-01T16:16:38Z","updated_at":"2026-01-01T16:16:38Z","body":"Thanks!","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3703864533/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null}]