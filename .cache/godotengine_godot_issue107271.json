rchived_at":null,"archived_by":null},{"id":1732720779,"node_id":"MDU6TGFiZWwxNzMyNzIwNzc5","url":"https://api.github.com/repos/godotengine/godot/labels/topic:gui","name":"topic:gui","color":"ffee88","default":false,"description":"","archived_at":null,"archived_by":null}],"state":"closed","locked":false,"assignees":[],"milestone":{"url":"https://api.github.com/repos/godotengine/godot/milestones/22","html_url":"https://github.com/godotengine/godot/milestone/22","labels_url":"https://api.github.com/repos/godotengine/godot/milestones/22/labels","id":12070367,"node_id":"MI_kwDOAO6SJc4AuC3f","number":22,"title":"4.5","description":"","creator":{"login":"Sauermann","id":6299227,"node_id":"MDQ6VXNlcjYyOTkyMjc=","avatar_url":"https://avatars.githubusercontent.com/u/6299227?v=4","gravatar_id":"","url":"https://api.github.com/users/Sauermann","html_url":"https://github.com/Sauermann","followers_url":"https://api.github.com/users/Sauermann/followers","following_url":"https://api.github.com/users/Sauermann/following{/other_user}","gists_url":"https://api.github.com/users/Sauermann/gists{/gist_id}","starred_url":"https://api.github.com/users/Sauermann/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Sauermann/subscriptions","organizations_url":"https://api.github.com/users/Sauermann/orgs","repos_url":"https://api.github.com/users/Sauermann/repos","events_url":"https://api.github.com/users/Sauermann/events{/privacy}","received_events_url":"https://api.github.com/users/Sauermann/received_events","type":"User","user_view_type":"public","site_admin":false},"open_issues":3,"closed_issues":3687,"state":"closed","created_at":"2024-12-19T08:51:28Z","updated_at":"2026-09-04T21:48:38Z","due_on":"2025-09-15T00:00:00Z","closed_at":"2025-09-18T17:13:14Z"},"comments":1,"created_at":"2025-06-08T04:14:32Z","updated_at":"2025-06-18T23:38:52Z","closed_at":"2025-06-18T23:30:04Z","assignee":null,"author_association":"CONTRIBUTOR","issue_field_values":[],"type":null,"active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"### Tested versions\n\nReproducible in 4.5 and 4.4\n\nThe behavior in 4.3 is different as SpinBox doesn't round the value to custom arrow step.\n\n### System information\n\nLinux\n\n### Issue description\n\nIt seems a regression from #97573\n\nIn 4.3:\n\nhttps://github.com/user-attachments/assets/6694a6df-d97f-4ff0-8565-5a484a50801d\n\nIn 4.4 and 4.5:\n\nhttps://github.com/user-attachments/assets/c2ec06db-fe3d-4930-9a78-cdf5657b5c77 \n\nhttps://github.com/user-attachments/assets/dbb837cd-9c0e-4238-a977-904e1a4d5ca2\n\nCurrent my quick workaround, but it will result in #97561 and probably not a correct fix:\n```diff\ndiff --git a/scene/gui/spin_box.cpp b/scene/gui/spin_box.cpp\nindex 9a0c86502e..450be0ee55 100644\n--- a/scene/gui/spin_box.cpp\n+++ b/scene/gui/spin_box.cpp\n@@ -86,9 +86,6 @@ Size2 SpinBox::get_minimum_size() const {\n \n void SpinBox::_update_text(bool p_only_update_if_value_changed) {\n \tdouble step = get_step();\n-\tif (use_custom_arrow_step && custom_arrow_step != 0.0) {\n-\t\tstep = custom_arrow_step;\n-\t}\n \tString value = String::num(get_value(), Math::range_step_decimals(step));\n \tif (is_localizing_numeral_system()) {\n \t\tvalue = TS->format_number(value);\n\n```\n\nhttps://github.com/user-attachments/assets/7dc39749-8a26-4303-afcb-d67cb9e295c0\n\nThis issue is more noticeable since intensity slider is added to ColorPicker. It unexpectedly rounds the value of intensity when dragging the slider.\n\n### Steps to reproduce\n\nRun the MRP below. Or reproduce it with the intensity slider of ColorPicker in 4.5.\n\nNote to reproduce, the shared slider must has `FOCUS_NONE` to let SpinBox get focus. \n\n### Minimal reproduction project (MRP)\n\n[spin-box-text-bug.zip](https://github.com/user-attachments/files/20642758/spin-box-text-bug.zip)","closed_by":{"login":"Repiteo","id":17489292,"node_id":"MDQ6VXNlcjE3NDg5Mjky","avatar_url":"https://avatars.githubusercontent.com/u/17489292?v=4","gravatar_id":"","url":"https://api.github.com/users/Repiteo","html_url":"https://github.com/Repiteo","followers_url":"https://api.github.com/users/Repiteo/followers","following_url":"https://api.github.com/users/Repiteo/following{/other_user}","gists_url":"https://api.github.com/users/Repiteo/gists{/gist_id}","starred_url":"https://api.github.com/users/Repiteo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Repiteo/subscriptions","organizations_url":"https://api.github.com/users/Repiteo/orgs","repos_url":"https://api.github.com/users/Repiteo/repos","events_url":"https://api.github.com/users/Repiteo/events{/privacy}","received_events_url":"https://api.github.com/users/Repiteo/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/107271/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/godotengine/godot/issues/107271/timeline","performed_via_github_app":null,"state_reason":"completed","pinned_comment":null}