77198,"node_id":"IC_kwDOAO6SJc7phg_O","user":{"login":"elvisish","id":16231628,"node_id":"MDQ6VXNlcjE2MjMxNjI4","avatar_url":"https://avatars.githubusercontent.com/u/16231628?v=4","gravatar_id":"","url":"https://api.github.com/users/elvisish","html_url":"https://github.com/elvisish","followers_url":"https://api.github.com/users/elvisish/followers","following_url":"https://api.github.com/users/elvisish/following{/other_user}","gists_url":"https://api.github.com/users/elvisish/gists{/gist_id}","starred_url":"https://api.github.com/users/elvisish/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/elvisish/subscriptions","organizations_url":"https://api.github.com/users/elvisish/orgs","repos_url":"https://api.github.com/users/elvisish/repos","events_url":"https://api.github.com/users/elvisish/events{/privacy}","received_events_url":"https://api.github.com/users/elvisish/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-02-18T00:58:08Z","updated_at":"2026-02-18T00:58:44Z","body":"> This is not a bug, This is expected Behavior.\n> \n> You shouldn't be manipulating things outside of Physics Process with Physics Interpolation enabled https://docs.godotengine.org/en/stable/tutorials/physics/interpolation/using_physics_interpolation.html\n> (see first note)\n\n![image](https://github.com/user-attachments/assets/2a52ad29-f7a2-4ef3-bd34-5e676d780a54)\n\nAbsolutely incorrect, the documentation specifically suggests handling mouse look outside of physics_process and directly in input.\n\nhttps://docs.godotengine.org/en/stable/tutorials/physics/interpolation/advanced_physics_interpolation.html","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3917877198/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3919366895","html_url":"https://github.com/godotengine/godot/issues/116353#issuecomment-3919366895","issue_url":"https://api.github.com/repos/godotengine/godot/issues/116353","id":3919366895,"node_id":"IC_kwDOAO6SJc7pnMrv","user":{"login":"mrjustaguy","id":50302479,"node_id":"MDQ6VXNlcjUwMzAyNDc5","avatar_url":"https://avatars.githubusercontent.com/u/50302479?v=4","gravatar_id":"","url":"https://api.github.com/users/mrjustaguy","html_url":"https://github.com/mrjustaguy","followers_url":"https://api.github.com/users/mrjustaguy/followers","following_url":"https://api.github.com/users/mrjustaguy/following{/other_user}","gists_url":"https://api.github.com/users/mrjustaguy/gists{/gist_id}","starred_url":"https://api.github.com/users/mrjustaguy/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/mrjustaguy/subscriptions","organizations_url":"https://api.github.com/users/mrjustaguy/orgs","repos_url":"https://api.github.com/users/mrjustaguy/repos","events_url":"https://api.github.com/users/mrjustaguy/events{/privacy}","received_events_url":"https://api.github.com/users/mrjustaguy/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-02-18T08:21:36Z","updated_at":"2026-02-18T08:21:46Z","body":"and have you disabled the Physics Interpolation for the node that's rotating during input like it says to? Not the camera mind you if that's not the thing that has the posted script attached.","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3919366895/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3919480209","html_url":"https://github.com/godotengine/godot/issues/116353#issuecomment-3919480209","issue_url":"https://api.github.com/repos/godotengine/godot/issues/116353","id":3919480209,"node_id":"IC_kwDOAO6SJc7pnoWR","user":{"login":"elvisish","id":16231628,"node_id":"MDQ6VXNlcjE2MjMxNjI4","avatar_url":"https://avatars.githubusercontent.com/u/16231628?v=4","gravatar_id":"","url":"https://api.github.com/users/elvisish","html_url":"https://github.com/elvisish","followers_url":"https://api.github.com/users/elvisish/followers","following_url":"https://api.github.com/users/elvisish/following{/other_user}","gists_url":"https://api.github.com/users/elvisish/gists{/gist_id}","starred_url":"https://api.github.com/users/elvisish/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/elvisish/subscriptions","organizations_url":"https://api.github.com/users/elvisish/orgs","repos_url":"https://api.github.com/users/elvisish/repos","events_url":"https://api.github.com/users/elvisish/events{/privacy}","received_events_url":"https://api.github.com/users/elvisish/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-02-18T08:48:21Z","updated_at":"2026-02-18T08:48:21Z","body":"> and have you disabled the Physics Interpolation for the node that's rotating during input like it says to? Not the camera mind you if that's not the thing that has the posted script attached.\n\nOnce more:\n![image](https://github.com/user-attachments/assets/9b59460f-e5c6-46b0-9c91-4cfe20b5f7f9)\n\nTry out the MRP and you can see how it behaves and how I've set it up.","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3919480209/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3938760913","html_url":"https://github.com/godotengine/godot/issues/116353#issuecomment-3938760913","issue_url":"https://api.github.com/repos/godotengine/godot/issues/116353","id":3938760913,"node_id":"IC_kwDOAO6SJc7qxLjR","user":{"login":"lawnjelly","id":21999379,"node_id":"MDQ6VXNlcjIxOTk5Mzc5","avatar_url":"https://avatars.githubusercontent.com/u/21999379?v=4","gravatar_id":"","url":"https://api.github.com/users/lawnjelly","html_url":"https://github.com/lawnjelly","followers_url":"https://api.github.com/users/lawnjelly/followers","following_url":"https://api.github.com/users/lawnjelly/following{/other_user}","gists_url":"https://api.github.com/users/lawnjelly/gists{/gist_id}","starred_url":"https://api.github.com/users/lawnjelly/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/lawnjelly/subscriptions","organizations_url":"https://api.github.com/users/lawnjelly/orgs","repos_url":"https://api.github.com/users/lawnjelly/repos","events_url":"https://api.github.com/users/lawnjelly/events{/privacy}","received_events_url":"https://api.github.com/users/lawnjelly/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-02-21T13:13:23Z","updated_at":"2026-02-21T13:31:18Z","body":"Cameras (and bullets!) are one of the most difficult aspects of using physics interpolation so don't feel bad if you are having problems. I need to expand the docs section on this, and further publicise the demo below.\n\nProbably a section with 2 or 3 example camera scripts for the common camera types.\n\nAnyway moving to your MRP:\n\n```\nfunc rotate_look(amount : Vector2) -> void:\n\tbody.rotation.y -= amount.x\n\thead.rotation.x = clamp(head.rotation.x - amount.y, -PI * 0.49, PI * 0.49)\n\tstored_mouse = Vector2.ZERO\n```\nWhen you call this from `_unhandled_input()` it is rotating the body and the head, not the camera itself. The transforms of the body and the head are _propagated_ to the camera. Physics interpolation takes place at the level of each individual node in the scene tree.\n\nThe advice and example to turn off physics interpolation for the `Camera` is assuming that you are rotating the `Camera` directly.\n\nIf you want to move a node outside the physics process, you should have physics interpolation turned off for that node. Have you turned off physics interpolation for the body and the head?\n\nIf you want to use a mouse camera:\n### Best solution\nTurn off physics interpolation for the `Camera` (or parent pivot used to move the camera)\n\n### With physics interpolation\nClunky but it can work, store the mouse rotation up and apply it on the next physics tick (as suggested in your quote). I don't recommend this as it won't be as responsive as a manual camera with mouse.\n\n## Example\nThere is an example of a first person camera in the demos with physics interpolation:\nhttps://github.com/godotengine/godot-demo-projects/tree/master/3d/physics_interpolation\n","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3938760913/reactions","total_count":2,"+1":2,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3947058292","html_url":"https://github.com/godotengine/godot/issues/116353#issuecomment-3947058292","issue_url":"https://api.github.com/repos/godotengine/godot/issues/116353","id":3947058292,"node_id":"IC_kwDOAO6SJc7rQ1R0","user":{"login":"elvisish","id":16231628,"node_id":"MDQ6VXNlcjE2MjMxNjI4","avatar_url":"https://avatars.githubusercontent.com/u/16231628?v=4","gravatar_id":"","url":"https://api.github.com/users/elvisish","html_url":"https://github.com/elvisish","followers_url":"https://api.github.com/users/elvisish/followers","following_url":"https://api.github.com/users/elvisish/following{/other_user}","gists_url":"https://api.github.com/users/elvisish/gists{/gist_id}","starred_url":"https://api.github.com/users/elvisish/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/elvisish/subscriptions","organizations_url":"https://api.github.com/users/elvisish/orgs","repos_url":"https://api.github.com/users/elvisish/repos","events_url":"https://api.github.com/users/elvisish/events{/privacy}","received_events_url":"https://api.github.com/users/elvisish/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-02-23T20:12:40Z","updated_at":"2026-02-23T20:12:40Z","body":"> Have you turned off physics interpolation for the body and the head?\n\nIt looks awful without physics interpolation on body/head, just as if I turned physics interpolation off entirely, try it on the MBR.","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3947058292/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null}]