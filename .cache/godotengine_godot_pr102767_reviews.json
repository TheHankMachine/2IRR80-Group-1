s/kiroxas/repos","events_url":"https://api.github.com/users/kiroxas/events{/privacy}","received_events_url":"https://api.github.com/users/kiroxas/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"","state":"COMMENTED","html_url":"https://github.com/godotengine/godot/pull/102767#pullrequestreview-2688701186","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/102767","author_association":"CONTRIBUTOR","_links":{"html":{"href":"https://github.com/godotengine/godot/pull/102767#pullrequestreview-2688701186"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/102767"}},"submitted_at":"2025-03-16T13:40:21Z","commit_id":null},{"id":2855456860,"node_id":"PRR_kwDOAO6SJc6qMtBc","user":{"login":"MJacred","id":6639237,"node_id":"MDQ6VXNlcjY2MzkyMzc=","avatar_url":"https://avatars.githubusercontent.com/u/6639237?u=89d4350f70d480d0457417ef122a7aaa1bb633f7&v=4","gravatar_id":"","url":"https://api.github.com/users/MJacred","html_url":"https://github.com/MJacred","followers_url":"https://api.github.com/users/MJacred/followers","following_url":"https://api.github.com/users/MJacred/following{/other_user}","gists_url":"https://api.github.com/users/MJacred/gists{/gist_id}","starred_url":"https://api.github.com/users/MJacred/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/MJacred/subscriptions","organizations_url":"https://api.github.com/users/MJacred/orgs","repos_url":"https://api.github.com/users/MJacred/repos","events_url":"https://api.github.com/users/MJacred/events{/privacy}","received_events_url":"https://api.github.com/users/MJacred/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"Disclaimer: No comment on the code itself.\r\n\r\n---\r\n\r\nNote: this PR makes the difference between \"navigation finished\" and \"destination reached\" more than ever clearer\r\n\r\n---\r\n\r\nTested for 3D:\r\n\r\nIt's not a bug, but more of a limitation that would require further refinement to fix:  \r\nWhen so. uses max length or max radius, an agent can stop in the middle of a navigation link:\r\n\r\n(Agent walking from right-to-left)\r\n![jump-link_max-length](https://github.com/user-attachments/assets/e3c77cad-5f00-4ca9-825d-cfc26ffa96a7)\r\n\r\nWhich is by no means wrong.\r\n\r\nA problem will occur, though, if the path limit is smaller than your navigation link, because the system only looks at the navigation link start and end position: So it needs to go back to travel along the link.  \r\nThe required refinement would need to find the nearest point on that line and start from there instead. (I managed to get an agent stuck on a navigation link with this edge case by decreasing the navigation length a bit more than what's depicted below.)\r\n\r\nTo make this case clearer, I didn't place the start and end position of the navigation link optimally:\r\n(Agent walking from bottom-to-top)\r\n![jump-link_max-radius](https://github.com/user-attachments/assets/786c485b-2b5a-4e4d-abcb-8d4a79f92f34)\r\n\r\n","state":"APPROVED","html_url":"https://github.com/godotengine/godot/pull/102767#pullrequestreview-2855456860","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/102767","author_association":"CONTRIBUTOR","_links":{"html":{"href":"https://github.com/godotengine/godot/pull/102767#pullrequestreview-2855456860"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/102767"}},"submitted_at":"2025-05-20T22:57:40Z","commit_id":null},{"id":2924333406,"node_id":"PRR_kwDOAO6SJc6uTcle","user":{"login":"AThousandShips","id":96648715,"node_id":"U_kgDOBcK-Cw","avatar_url":"https://avatars.githubusercontent.com/u/96648715?u=af70f5d107e9c1447f296643d5a566dab53d25e8&v=4","gravatar_id":"","url":"https://api.github.com/users/AThousandShips","html_url":"https://github.com/AThousandShips","followers_url":"https://api.github.com/users/AThousandShips/followers","following_url":"https://api.githu