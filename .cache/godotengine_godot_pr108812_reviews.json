[{"id":3039882296,"node_id":"PRR_kwDOAO6SJc61MOw4","user":{"login":"Calinou","id":180032,"node_id":"MDQ6VXNlcjE4MDAzMg==","avatar_url":"https://avatars.githubusercontent.com/u/180032?u=68d23e7ee9cdf810da125e8510b72f845b9dccc8&v=4","gravatar_id":"","url":"https://api.github.com/users/Calinou","html_url":"https://github.com/Calinou","followers_url":"https://api.github.com/users/Calinou/followers","following_url":"https://api.github.com/users/Calinou/following{/other_user}","gists_url":"https://api.github.com/users/Calinou/gists{/gist_id}","starred_url":"https://api.github.com/users/Calinou/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Calinou/subscriptions","organizations_url":"https://api.github.com/users/Calinou/orgs","repos_url":"https://api.github.com/users/Calinou/repos","events_url":"https://api.github.com/users/Calinou/events{/privacy}","received_events_url":"https://api.github.com/users/Calinou/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"Tested locally, it works as expected.\r\n\r\nHowever, if you orbit while holding <kbd>Alt</kbd>, it will only focus on the point when you release the mouse button. The orbiting operation will be relative to the old position, then it'll snap to the new position after you release the mouse.\r\n\r\nI think it should set the new point of origin for orbiting immediately when you click. It would likely match user expectations better as I've understood from the proposal.","state":"COMMENTED","html_url":"https://github.com/godotengine/godot/pull/108812#pullrequestreview-3039882296","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/108812","author_association":"MEMBER","_links":{"html":{"href":"https://github.com/godotengine/godot/pull/108812#pullrequestreview-3039882296"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/108812"}},"submitted_at":"2025-07-21T21:16:47Z","commit_id":null},{"id":3043430258,"node_id":"PRR_