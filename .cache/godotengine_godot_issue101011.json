scription":"","archived_at":null,"archived_by":null}],"state":"closed","locked":false,"assignees":[],"milestone":{"url":"https://api.github.com/repos/godotengine/godot/milestones/22","html_url":"https://github.com/godotengine/godot/milestone/22","labels_url":"https://api.github.com/repos/godotengine/godot/milestones/22/labels","id":12070367,"node_id":"MI_kwDOAO6SJc4AuC3f","number":22,"title":"4.5","description":"","creator":{"login":"Sauermann","id":6299227,"node_id":"MDQ6VXNlcjYyOTkyMjc=","avatar_url":"https://avatars.githubusercontent.com/u/6299227?v=4","gravatar_id":"","url":"https://api.github.com/users/Sauermann","html_url":"https://github.com/Sauermann","followers_url":"https://api.github.com/users/Sauermann/followers","following_url":"https://api.github.com/users/Sauermann/following{/other_user}","gists_url":"https://api.github.com/users/Sauermann/gists{/gist_id}","starred_url":"https://api.github.com/users/Sauermann/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Sauermann/subscriptions","organizations_url":"https://api.github.com/users/Sauermann/orgs","repos_url":"https://api.github.com/users/Sauermann/repos","events_url":"https://api.github.com/users/Sauermann/events{/privacy}","received_events_url":"https://api.github.com/users/Sauermann/received_events","type":"User","user_view_type":"public","site_admin":false},"open_issues":3,"closed_issues":3687,"state":"closed","created_at":"2024-12-19T08:51:28Z","updated_at":"2026-09-04T21:48:38Z","due_on":"2025-09-15T00:00:00Z","closed_at":"2025-09-18T17:13:14Z"},"comments":3,"created_at":"2025-01-02T01:34:25Z","updated_at":"2025-08-26T11:55:22Z","closed_at":"2025-04-09T23:18:11Z","assignee":null,"author_association":"MEMBER","issue_field_values":[],"type":null,"active_lock_reason":null,"draft":false,"pull_request":{"url":"https://api.github.com/repos/godotengine/godot/pulls/101011","html_url":"https://github.com/godotengine/godot/pull/101011","diff_url":"https://github.com/godotengine/godot/pull/101011.diff","patch_url":"https://github.com/godotengine/godot/pull/101011.patch","merged_at":"2025-04-09T23:18:11Z"},"body":"Without this PR, attempting to set max_contacts_reported to the maximum signed 32-bit integer value would attempt to allocate over 200 GiB of RAM, causing Godot and possibly the operating system to freeze.\r\n\r\nThere is now a hard limit defined by `constexpr int MAX_CONTACTS_REPORTED_3D_MAX = 100'000'000;` which will ensure that no body can use more than about 10 GiB of RAM. There is a check before the actual array resize inside of the physics server body code, and a user-friendly check at the node level to provide helpful feedback, informing the user of what the consequences are of the number they set and why there is a limit:\r\n\r\n<img width=\"900\" alt=\"Screenshot 2025-01-01 at 5 25 32 PM\" src=\"https://github.com/user-attachments/assets/83f966f9-2fdf-448b-87e4-bad252c864a6\" />\r\n\r\nI am not sure what the best limit is, my goal here is to keep the limit high enough that no real use case will come near the limit, while also ensuring that if users try punching in very large numbers they will see the error. This PR was motivated by me watching somebody use RigidBody2D and set the max_contacts_reported to `(2**31)-1` which was accepted but would've resulted in over 160 GiB of RAM used (it seems that his Linux system refused to allocate that much though).","closed_by":{"login":"Repiteo","id":17489292,"node_id":"MDQ6VXNlcjE3NDg5Mjky","avatar_url":"https://avatars.githubusercontent.com/u/17489292?v=4","gravatar_id":"","url":"https://api.github.com/users/Repiteo","html_url":"https://github.com/Repiteo","followers_url":"https://api.github.com/users/Repiteo/followers","following_url":"https://api.github.com/users/Repiteo/following{/other_user}","gists_url":"https://api.github.com/users/Repiteo/gists{/gist_id}","starred_url":"https://api.github.com/users/Repiteo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Repiteo/subscriptions","organizations_url":"https://api.github.com/users/Repiteo/orgs","repos_url":"https://api.github.com/users/Repiteo/repos","events_url":"https://api.github.com/users/Repiteo/events{/privacy}","received_events_url":"https://api.github.com/users/Repiteo/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/101011/reactions","total_count":9,"+1":9,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/godotengine/godot/issues/101011/timeline","performed_via_github_app":null,"state_reason":null}