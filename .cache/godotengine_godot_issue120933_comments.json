AD03/repos","events_url":"https://api.github.com/users/0MAD03/events{/privacy}","received_events_url":"https://api.github.com/users/0MAD03/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-07-05T13:59:59Z","updated_at":"2026-07-05T13:59:59Z","body":"Thanks for investigating and bisecting this.\n\nI also found that this issue affects `[right]` (alignment tags) in my project, not only `[p]` nested inside `[font_size]`.\n\nThis makes the regression more severe on my side, since existing BBCode content relies heavily on paragraph/alignment tags, and working around it in code is not always feasible.\n","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4886300183/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4896120933","html_url":"https://github.com/godotengine/godot/issues/120933#issuecomment-4896120933","issue_url":"https://api.github.com/repos/godotengine/godot/issues/120933","id":4896120933,"node_id":"IC_kwDOAO6SJc8AAAABI9TgZQ","user":{"login":"bruvzg","id":7645683,"node_id":"MDQ6VXNlcjc2NDU2ODM=","avatar_url":"https://avatars.githubusercontent.com/u/7645683?v=4","gravatar_id":"","url":"https://api.github.com/users/bruvzg","html_url":"https://github.com/bruvzg","followers_url":"https://api.github.com/users/bruvzg/followers","following_url":"https://api.github.com/users/bruvzg/following{/other_user}","gists_url":"https://api.github.com/users/bruvzg/gists{/gist_id}","starred_url":"https://api.github.com/users/bruvzg/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/bruvzg/subscriptions","organizations_url":"https://api.github.com/users/bruvzg/orgs","repos_url":"https://api.github.com/users/bruvzg/repos","events_url":"https://api.github.com/users/bruvzg/events{/privacy}","received_events_url":"https://api.github.com/users/bruvzg/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-07-06T18:09:53Z","updated_at":"2026-07-06T18:09:53Z","body":"> I also found that this issue affects [right] (alignment tags) in my project, not only [p] \n\nInternally this is the same, `[right]` is just a short version of `[p align=right]`.","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4896120933/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4901828352","html_url":"https://github.com/godotengine/godot/issues/120933#issuecomment-4901828352","issue_url":"https://api.github.com/repos/godotengine/godot/issues/120933","id":4901828352,"node_id":"IC_kwDOAO6SJc8AAAABJCv3AA","user":{"login":"bruvzg","id":7645683,"node_id":"MDQ6VXNlcjc2NDU2ODM=","avatar_url":"https://avatars.githubusercontent.com/u/7645683?v=4","gravatar_id":"","url":"https://api.github.com/users/bruvzg","html_url":"https://github.com/bruvzg","followers_url":"https://api.github.com/users/bruvzg/followers","following_url":"https://api.github.com/users/bruvzg/following{/other_user}","gists_url":"https://api.github.com/users/bruvzg/gists{/gist_id}","starred_url":"https://api.github.com/users/bruvzg/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/bruvzg/subscriptions","organizations_url":"https://api.github.com/users/bruvzg/orgs","repos_url":"https://api.github.com/users/bruvzg/repos","events_url":"https://api.github.com/users/bruvzg/events{/privacy}","received_events_url":"https://api.github.com/users/bruvzg/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-07-07T08:41:59Z","updated_at":"2026-07-07T08:41:59Z","body":"Not sure it this is a bug, `[p]` is supposed to start a new paragraph, so this should be an expected behavior.","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4901828352/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4903125870","html_url":"https://github.com/godotengine/godot/issues/120933#issuecomment-4903125870","issue_url":"https://api.github.com/repos/godotengine/godot/issues/120933","id":4903125870,"node_id":"IC_kwDOAO6SJc8AAAABJD_Dbg","user":{"login":"0MAD03","id":93967519,"node_id":"U_kgDOBZnUnw","avatar_url":"https://avatars.githubusercontent.com/u/93967519?v=4","gravatar_id":"","url":"https://api.github.com/users/0MAD03","html_url":"https://github.com/0MAD03","followers_url":"https://api.github.com/users/0MAD03/followers","following_url":"https://api.github.com/users/0MAD03/following{/other_user}","gists_url":"https://api.github.com/users/0MAD03/gists{/gist_id}","starred_url":"https://api.github.com/users/0MAD03/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/0MAD03/subscriptions","organizations_url":"https://api.github.com/users/0MAD03/orgs","repos_url":"https://api.github.com/users/0MAD03/repos","events_url":"https://api.github.com/users/0MAD03/events{/privacy}","received_events_url":"https://api.github.com/users/0MAD03/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-07-07T11:11:26Z","updated_at":"2026-07-07T11:11:26Z","body":"I understand that `[p]` starts a new paragraph.\n\nHowever, the issue is that this behavior changed between 4.6 and 4.7, and the result depends on whether `[p]` is nested inside a style tag.\n\nThese two snippets seem equivalent from a BBCode authoring perspective:\n\n```bbcode\n[p][font_size=22]aaa[/font_size][/p]\n```\n\n```bbcode\n[font_size=22][p]aaa[/p][/font_size]\n```\n\nIn 4.6, the second form did not insert an empty first line. In 4.7, it does.\n\nSo the problem is not that `[p]` starts a paragraph, but that nesting it inside `[font_size]` creates an extra empty first line before the actual paragraph. This breaks existing BBCode content that worked in 4.6, which is why I believe this is a regression.\n\nIf a minimal reproduction project would help, I'm happy to provide one, although the behavior can already be reproduced with a `RichTextLabel` alone and differs consistently between 4.6 and 4.7.\n\nIf this is the intended behavior rather than a regression, could you please explain how to avoid the extra empty first line when using nested BBCode in `RichTextLabel`? As far as I can tell, there is currently no way to prevent it, so I have not found a viable workaround.\n","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4903125870/reactions","total_count":2,"+1":2,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null}]