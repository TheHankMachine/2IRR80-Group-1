[{"id":3341641510,"node_id":"PRR_kwDOAO6SJc7HLWcm","state":"APPROVED","user":{"site_admin":false,"suspended":false,"updated_at":"0001-01-01T00:00:00Z","avatar_url":"https://avatars.githubusercontent.com/u/99511741?u=b7882c94f408976a2f79e8fe6e1ce27fbd48db74&v=4","created_at":"0001-01-01T00:00:00Z","followers":0,"following":0,"html_url":"https://github.com/HolonProduction","id":99511741,"node_id":"U_kgDOBe5tvQ","login":"HolonProduction","type":"User","owned_private_repos":0,"public_gists":0,"public_repos":0,"total_private_repos":0,"url":"https://api.github.com/users/HolonProduction"},"body":"The changes make sense to me.\r\n\r\nLSP defines `TextDocumentContentChangeEvent` in a way where `range` and `rangeLength` are optional. However we don't even use them, so from my side the better solution would be to remove those members completely from the codebase. They are related to a change sync mode that we don't support currently.\r\n\r\nThe fields on `TextDocumentItem` are required by the spec, however we also use this struct to load `TextDocumentIdentifier` which only has a uri, so the changes make sense based on the current implementation. If this gets merged I will change those back in https://github.com/godotengine/godot/pull/105236, which removes the double usage.\r\n","html_url":"https://github.com/godotengine/godot/pull/111684#pullrequestreview-3341641510","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/111684","author_association":"MEMBER","submitted_at":"2025-10-15T17:54:37Z"},{"id":3342179270,"node_id":"PRR_kwDOAO6SJc7HNZvG","state":"COMMENTED","user":{"site_admin":false,"suspended":false,"updated_at":"0001-01-01T00:00:00Z","avatar_url":"https://avatars.githubusercontent.com/u/2308167?u=f7f8e0273f784f5ec6f6b7fe4a88d449896eb48a&v=4","created_at":"0001-01-01T00:00:00Z","followers":0,"following":0,"html_url":"https://github.com/Ivorforce","id":2308167,"node_id":"MDQ6VXNlcjIzMDgxNjc=","login":"Ivorforce","type":"User","owned_private_repos":0,