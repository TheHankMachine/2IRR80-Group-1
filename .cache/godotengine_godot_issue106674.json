"https://api.github.com/repos/godotengine/godot/labels/cherrypick:4.4","name":"cherrypick:4.4","color":"446699","default":false,"description":"Considered for cherry-picking into a future 4.4.x release","archived_at":null,"archived_by":null}],"state":"closed","locked":false,"assignees":[],"milestone":{"url":"https://api.github.com/repos/godotengine/godot/milestones/22","html_url":"https://github.com/godotengine/godot/milestone/22","labels_url":"https://api.github.com/repos/godotengine/godot/milestones/22/labels","id":12070367,"node_id":"MI_kwDOAO6SJc4AuC3f","number":22,"title":"4.5","description":"","creator":{"login":"Sauermann","id":6299227,"node_id":"MDQ6VXNlcjYyOTkyMjc=","avatar_url":"https://avatars.githubusercontent.com/u/6299227?v=4","gravatar_id":"","url":"https://api.github.com/users/Sauermann","html_url":"https://github.com/Sauermann","followers_url":"https://api.github.com/users/Sauermann/followers","following_url":"https://api.github.com/users/Sauermann/following{/other_user}","gists_url":"https://api.github.com/users/Sauermann/gists{/gist_id}","starred_url":"https://api.github.com/users/Sauermann/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Sauermann/subscriptions","organizations_url":"https://api.github.com/users/Sauermann/orgs","repos_url":"https://api.github.com/users/Sauermann/repos","events_url":"https://api.github.com/users/Sauermann/events{/privacy}","received_events_url":"https://api.github.com/users/Sauermann/received_events","type":"User","user_view_type":"public","site_admin":false},"open_issues":3,"closed_issues":3687,"state":"closed","created_at":"2024-12-19T08:51:28Z","updated_at":"2026-09-04T21:48:38Z","due_on":"2025-09-15T00:00:00Z","closed_at":"2025-09-18T17:13:14Z"},"comments":2,"created_at":"2025-05-21T11:23:41Z","updated_at":"2025-11-11T19:22:04Z","closed_at":"2025-05-22T17:22:10Z","assignee":null,"author_association":"CONTRIBUTOR","issue_field_values":[],"type":null,"active_lock_reason":null,"draft":false,"pull_request":{"url":"https://api.github.com/repos/godotengine/godot/pulls/106674","html_url":"https://github.com/godotengine/godot/pull/106674","diff_url":"https://github.com/godotengine/godot/pull/106674.diff","patch_url":"https://github.com/godotengine/godot/pull/106674.patch","merged_at":"2025-05-22T17:22:10Z"},"body":"Fixes #84481.\r\n\r\nThis fixes the issue of regular `print` calls and things like `ERR_PRINT` ending up out-of-order in the editor's Output panel, when done from something like a tool script, and potentially other contexts as well.\r\n\r\nThe issue seems to have been a regression from #77251, which changed `EditorNode::_print_handler` (and `EditorNode::_file_access_close_error_notify`) to be thread-safe, by deferring every such call, leading to `print` messages being deferred, when error messages are not.\r\n\r\nThe adding of error messages is thread-safe as well, but rightfully checks whether we're on the main thread first, and only defers it if we're not, as seen here:\r\n\r\nhttps://github.com/godotengine/godot/blob/25a3c27c41ac32f65d8efb8a54b08ad88211a700/editor/editor_log.cpp#L56-L60\r\n\r\nThis PR fixes this issue by doing exactly that for `EditorNode::_print_handler` as well and only deferring the call if we're not on the main thread.\r\n\r\nI've left `EditorNode::_file_access_close_error_notify` as-is, but there might be some argument for changing that as well. Let me know if I should throw that in here.","closed_by":{"login":"Repiteo","id":17489292,"node_id":"MDQ6VXNlcjE3NDg5Mjky","avatar_url":"https://avatars.githubusercontent.com/u/17489292?v=4","gravatar_id":"","url":"https://api.github.com/users/Repiteo","html_url":"https://github.com/Repiteo","followers_url":"https://api.github.com/users/Repiteo/followers","following_url":"https://api.github.com/users/Repiteo/following{/other_user}","gists_url":"https://api.github.com/users/Repiteo/gists{/gist_id}","starred_url":"https://api.github.com/users/Repiteo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Repiteo/subscriptions","organizations_url":"https://api.github.com/users/Repiteo/orgs","repos_url":"https://api.github.com/users/Repiteo/repos","events_url":"https://api.github.com/users/Repiteo/events{/privacy}","received_events_url":"https://api.github.com/users/Repiteo/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/106674/reactions","total_count":7,"+1":2,"-1":0,"laugh":0,"hooray":5,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/godotengine/godot/issues/106674/timeline","performed_via_github_app":null,"state_reason":null}