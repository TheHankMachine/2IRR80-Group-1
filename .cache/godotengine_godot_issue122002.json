ee88","default":false,"description":"","archived_at":null,"archived_by":null}],"state":"closed","locked":false,"assignees":[],"milestone":{"url":"https://api.github.com/repos/godotengine/godot/milestones/25","html_url":"https://github.com/godotengine/godot/milestone/25","labels_url":"https://api.github.com/repos/godotengine/godot/milestones/25/labels","id":15520464,"node_id":"MI_kwDOAO6SJc4A7NLQ","number":25,"title":"4.8","description":"","creator":{"login":"Repiteo","id":17489292,"node_id":"MDQ6VXNlcjE3NDg5Mjky","avatar_url":"https://avatars.githubusercontent.com/u/17489292?v=4","gravatar_id":"","url":"https://api.github.com/users/Repiteo","html_url":"https://github.com/Repiteo","followers_url":"https://api.github.com/users/Repiteo/followers","following_url":"https://api.github.com/users/Repiteo/following{/other_user}","gists_url":"https://api.github.com/users/Repiteo/gists{/gist_id}","starred_url":"https://api.github.com/users/Repiteo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Repiteo/subscriptions","organizations_url":"https://api.github.com/users/Repiteo/orgs","repos_url":"https://api.github.com/users/Repiteo/repos","events_url":"https://api.github.com/users/Repiteo/events{/privacy}","received_events_url":"https://api.github.com/users/Repiteo/received_events","type":"User","user_view_type":"public","site_admin":false},"open_issues":343,"closed_issues":2335,"state":"open","created_at":"2026-04-13T15:59:35Z","updated_at":"2026-10-22T06:28:22Z","due_on":null,"closed_at":null},"comments":8,"created_at":"2026-08-01T12:47:09Z","updated_at":"2026-09-16T16:22:30Z","closed_at":"2026-09-16T16:22:30Z","assignee":null,"author_association":"CONTRIBUTOR","issue_field_values":[],"type":null,"active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"### Tested versions\n\n4.6.3.stable, 4.8.dev2\n\n### System information\n\nGodot v4.8.dev2 - Windows 11 (build 26200) - Multi-window, 1 monitor - Direct3D 12 (Forward+) - dedicated AMD Radeon 780M Graphics (Advanced Micro Devices, Inc.; 32.0.13018.6) - AMD Ryzen 7 8700G w/ Radeon 780M Graphics (16 threads) - 31.11 GiB memory - WASAPI (48000 Hz, Stereo/mono)\n\n### Issue description\n\n`TextEdit`'s `clear()` function does preserve undo history, if `editable = true`.\nThis was changed in https://github.com/godotengine/godot/pull/56720, so users can undo an accidental \"Clear\" from the context menu.\n\nWhile this behaviour is very useful, it also affects the function in GDScript.\nThis doesn‘t match the official documentation text:\n\n> Performs a full reset of TextEdit, including undo history.\n\nWhether undo history is cleared should not rely on a flag that is not directly related to it may not be a good implementation.\nTying undo history clearing to `editable` is an arbitrary implementation detail rather than an intuitive design pattern.\nThis is likely to cause confusion when the `editable` status changes at runtime and `clear()` suddenly clears the history — or fails to do so.\n\nSo, there are two options to solve this:\n- Separate `clear()` and menu \"Clear\" behabiour, so `clear()` matches the documented behaviour, and menu \"Clear\" keeps its current behaviour. I've opened a PR that implements this option: https://github.com/godotengine/godot/pull/122003.\n- Adapt the documentation text. PR: https://github.com/godotengine/godot/pull/122318\n- Add clear_undo_history parameter to `clear()`: https://github.com/godotengine/godot/pull/122377\n\n### Steps to reproduce\n\nThis is an inconsistent behaviour and can be reproduced using `clear()` in any project.\nBut for your convenience, I‘ve created a MRP.\n\n### Minimal reproduction project (MRP)\n\n[new-game.zip](https://github.com/user-attachments/files/30617016/new-game.zip)","closed_by":{"login":"Repiteo","id":17489292,"node_id":"MDQ6VXNlcjE3NDg5Mjky","avatar_url":"https://avatars.githubusercontent.com/u/17489292?v=4","gravatar_id":"","url":"https://api.github.com/users/Repiteo","html_url":"https://github.com/Repiteo","followers_url":"https://api.github.com/users/Repiteo/followers","following_url":"https://api.github.com/users/Repiteo/following{/other_user}","gists_url":"https://api.github.com/users/Repiteo/gists{/gist_id}","starred_url":"https://api.github.com/users/Repiteo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Repiteo/subscriptions","organizations_url":"https://api.github.com/users/Repiteo/orgs","repos_url":"https://api.github.com/users/Repiteo/repos","events_url":"https://api.github.com/users/Repiteo/events{/privacy}","received_events_url":"https://api.github.com/users/Repiteo/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/122002/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/godotengine/godot/issues/122002/timeline","performed_via_github_app":null,"state_reason":"completed","pinned_comment":null}