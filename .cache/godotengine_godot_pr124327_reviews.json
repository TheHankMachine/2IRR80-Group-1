[{"id":5471256654,"node_id":"PRR_kwDOAO6SJc8AAAABRhzATg","user":{"login":"Ivorforce","id":2308167,"node_id":"MDQ6VXNlcjIzMDgxNjc=","avatar_url":"https://avatars.githubusercontent.com/u/2308167?u=f7f8e0273f784f5ec6f6b7fe4a88d449896eb48a&v=4","gravatar_id":"","url":"https://api.github.com/users/Ivorforce","html_url":"https://github.com/Ivorforce","followers_url":"https://api.github.com/users/Ivorforce/followers","following_url":"https://api.github.com/users/Ivorforce/following{/other_user}","gists_url":"https://api.github.com/users/Ivorforce/gists{/gist_id}","starred_url":"https://api.github.com/users/Ivorforce/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Ivorforce/subscriptions","organizations_url":"https://api.github.com/users/Ivorforce/orgs","repos_url":"https://api.github.com/users/Ivorforce/repos","events_url":"https://api.github.com/users/Ivorforce/events{/privacy}","received_events_url":"https://api.github.com/users/Ivorforce/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"The code cleanup is appreciated and makes sense, but this PR currently isn't a no-op.\n\nThe `args` vectors were created with `push_back` which has a 1.5x growth scheme. That means there could be a good bit of 'slack' at the end of the vectors, costing RAM long term.\n\nThe old version of the code uses `resize` which allocates exactly, so no RAM wasted.\n\nI recommend using the `Span` constructor to have the best of both worlds.","state":"CHANGES_REQUESTED","html_url":"https://github.com/godotengine/godot/pull/124327#pullrequestreview-5471256654","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/124327","author_association":"MEMBER","_links":{"html":{"href":"https://github.com/godotengine/godot/pull/124327#pullrequestreview-5471256654"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/124327"}},"submitted_at":"2026-10-09T14:17:44Z","commit_id":"bb7538fab4829453719700f5efdea28ef