[{"id":2694274459,"node_id":"PRR_kwDOAO6SJc6gl12b","user":{"login":"Ivorforce","id":2308167,"node_id":"MDQ6VXNlcjIzMDgxNjc=","avatar_url":"https://avatars.githubusercontent.com/u/2308167?u=f7f8e0273f784f5ec6f6b7fe4a88d449896eb48a&v=4","gravatar_id":"","url":"https://api.github.com/users/Ivorforce","html_url":"https://github.com/Ivorforce","followers_url":"https://api.github.com/users/Ivorforce/followers","following_url":"https://api.github.com/users/Ivorforce/following{/other_user}","gists_url":"https://api.github.com/users/Ivorforce/gists{/gist_id}","starred_url":"https://api.github.com/users/Ivorforce/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Ivorforce/subscriptions","organizations_url":"https://api.github.com/users/Ivorforce/orgs","repos_url":"https://api.github.com/users/Ivorforce/repos","events_url":"https://api.github.com/users/Ivorforce/events{/privacy}","received_events_url":"https://api.github.com/users/Ivorforce/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"I had a glance over this, and i got to admit I'm a bit overwhelmed by the amount of nontrivial changes.\r\nIf you have any idea for breaking this down, this would be welcome! Perhaps it would be possible to move all these generated strings that are checked into external files while continuing to use `pytest`, and remove `pytest` as a separate step? \r\n\r\nIf that's not possible, perhaps you could summarize the changes in each section to help the review process? Specifically, it would be interesting to know which parts need particular attention or comment and which are pretty trivial text moves.","state":"COMMENTED","html_url":"https://github.com/godotengine/godot/pull/101443#pullrequestreview-2694274459","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/101443","author_association":"MEMBER","_links":{"html":{"href":"https://github.com/godotengine/godot/pull/101443#pullrequestreview-2694274459"},"pull_request":