e_id":"MDU6TGFiZWwyNjY2NzA4Mjg5","url":"https://api.github.com/repos/godotengine/godot/labels/topic:3d","name":"topic:3d","color":"ffee88","default":false,"description":"","archived_at":null,"archived_by":null},{"id":3240950060,"node_id":"MDU6TGFiZWwzMjQwOTUwMDYw","url":"https://api.github.com/repos/godotengine/godot/labels/performance","name":"performance","color":"447777","default":false,"description":"","archived_at":null,"archived_by":null}],"state":"closed","locked":false,"assignees":[],"milestone":{"url":"https://api.github.com/repos/godotengine/godot/milestones/25","html_url":"https://github.com/godotengine/godot/milestone/25","labels_url":"https://api.github.com/repos/godotengine/godot/milestones/25/labels","id":15520464,"node_id":"MI_kwDOAO6SJc4A7NLQ","number":25,"title":"4.8","description":"","creator":{"login":"Repiteo","id":17489292,"node_id":"MDQ6VXNlcjE3NDg5Mjky","avatar_url":"https://avatars.githubusercontent.com/u/17489292?v=4","gravatar_id":"","url":"https://api.github.com/users/Repiteo","html_url":"https://github.com/Repiteo","followers_url":"https://api.github.com/users/Repiteo/followers","following_url":"https://api.github.com/users/Repiteo/following{/other_user}","gists_url":"https://api.github.com/users/Repiteo/gists{/gist_id}","starred_url":"https://api.github.com/users/Repiteo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Repiteo/subscriptions","organizations_url":"https://api.github.com/users/Repiteo/orgs","repos_url":"https://api.github.com/users/Repiteo/repos","events_url":"https://api.github.com/users/Repiteo/events{/privacy}","received_events_url":"https://api.github.com/users/Repiteo/received_events","type":"User","user_view_type":"public","site_admin":false},"open_issues":345,"closed_issues":2336,"state":"open","created_at":"2026-04-13T15:59:35Z","updated_at":"2026-10-22T08:21:32Z","due_on":null,"closed_at":null},"comments":1,"created_at":"2026-10-09T05:52:39Z","updated_at":"2026-10-12T01:46:28Z","closed_at":"2026-10-09T20:18:13Z","assignee":null,"author_association":"CONTRIBUTOR","issue_field_values":[],"type":null,"active_lock_reason":null,"draft":false,"pull_request":{"url":"https://api.github.com/repos/godotengine/godot/pulls/124315","html_url":"https://github.com/godotengine/godot/pull/124315","diff_url":"https://github.com/godotengine/godot/pull/124315.diff","patch_url":"https://github.com/godotengine/godot/pull/124315.patch","merged_at":"2026-10-09T20:18:13Z"},"body":"This is the same fix as #121446 and #124164, but implemented for 4.x 3D.\n\nCharacter bodies (PS3DE::BODY_MODE_KINEMATIC) were incorrectly expanding their AABBs to incorporate next frame motion. This should only happen if CCD is turned on. If CCD is not turned on, all the extra broad phase hits are wasted, since narrow phase will not consider motion unless CCD is on.\n\n## What problem(s) does this PR solve?\n\nThis should improve CharacterBody3D performance and performance consistency. In addition to the broad phase cost, the narrow phase is currently being fed excess candidate collisions that are costly to test and discard there.\n\nCurrent performance may be suffering in circumstances with high velocity, diagonal movement or teleporting.\n\n## Additional information\nThis fix was made originally for 4.x Godot Physics 2D to close #83835\n\nThe logical issue also appears to be present in 3D and it is important to fix this before subsequent fixes related to body waking are considered.\n\nI have tested the godot-demo-projects Platformer 3D and Truck Town demos and they work. I don't have a specific 3D MRP for this and it is not trivial to make one (since you need to provide enough collision data to demonstrate a profiling spike). \n\nOne very minor known behavioural impact of this fix is that with the way things are currently, many sleeping bodies would be waking up, even though there is no collision, so they should eventually go back to sleep again (but they will slow everything down in the meantime). After this fix, bodies that cannot possibly collide with anything will not be woken up. That may change behaviour slightly for someone who had come to rely on the excess waking, but we should still fix this because the performance costs can be significant and they were certainly a big issue for 2D.\n","closed_by":{"login":"Repiteo","id":17489292,"node_id":"MDQ6VXNlcjE3NDg5Mjky","avatar_url":"https://avatars.githubusercontent.com/u/17489292?v=4","gravatar_id":"","url":"https://api.github.com/users/Repiteo","html_url":"https://github.com/Repiteo","followers_url":"https://api.github.com/users/Repiteo/followers","following_url":"https://api.github.com/users/Repiteo/following{/other_user}","gists_url":"https://api.github.com/users/Repiteo/gists{/gist_id}","starred_url":"https://api.github.com/users/Repiteo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Repiteo/subscriptions","organizations_url":"https://api.github.com/users/Repiteo/orgs","repos_url":"https://api.github.com/users/Repiteo/repos","events_url":"https://api.github.com/users/Repiteo/events{/privacy}","received_events_url":"https://api.github.com/users/Repiteo/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/124315/reactions","total_count":2,"+1":0,"-1":0,"laugh":0,"hooray":1,"confused":0,"heart":0,"rocket":1,"eyes":0},"timeline_url":"https://api.github.com/repos/godotengine/godot/issues/124315/timeline","performed_via_github_app":null,"state_reason":null}