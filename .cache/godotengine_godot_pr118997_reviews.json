request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/118997"}},"submitted_at":"2026-05-03T14:37:08Z","commit_id":"558e5c672a1a6205e1c37113767adcbef6165557"},{"id":4216765839,"node_id":"PRR_kwDOAO6SJc77Vr2P","user":{"login":"jrouwe","id":1621693,"node_id":"MDQ6VXNlcjE2MjE2OTM=","avatar_url":"https://avatars.githubusercontent.com/u/1621693?u=14b293a7095d074e6653d7ad73269a5e785e1399&v=4","gravatar_id":"","url":"https://api.github.com/users/jrouwe","html_url":"https://github.com/jrouwe","followers_url":"https://api.github.com/users/jrouwe/followers","following_url":"https://api.github.com/users/jrouwe/following{/other_user}","gists_url":"https://api.github.com/users/jrouwe/gists{/gist_id}","starred_url":"https://api.github.com/users/jrouwe/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/jrouwe/subscriptions","organizations_url":"https://api.github.com/users/jrouwe/orgs","repos_url":"https://api.github.com/users/jrouwe/repos","events_url":"https://api.github.com/users/jrouwe/events{/privacy}","received_events_url":"https://api.github.com/users/jrouwe/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"A very useful addition. Makes it much easier to drive joints to a desired rotation for e.g. driving ragdolls to a pose. Technically speaking you can achieve this using the old 'equilibrium point' API as well, but it is super easy to get lost in the math as you have to do:\n\n* Calculate body1 to constraint space (technically doable by getting the 'global_basis` of the joint and body1 in the rest pose and calculating the relative transform)\n* Calculate body2 to constraint space (same)\n* Convert the desired target orientation to constraint space: constraint_to_body1.Inversed() * target_orientation * constraint_to_body2\n* Converting the resulting matrix/quaternion to Euler angles and setting it as 'equilibrium point'\n\nWith this change you just calculate the desired relative transform between the two bodies and pass it to `set_angular_target_rotation`.\n\nNote that I think it would be possible to implement this change as sitting on top of the 'equilibrium point' API, where a call to `set_angular_target_rotation` would do the calculations above and set the equilibrium point (so no changes to the physics server needed), but this solution is more efficient as it does not need to go back and forth between quaternions and Euler angles.","state":"APPROVED","html_url":"https://github.com/godotengine/godot/pull/118997#pullrequestreview-4216765839","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/118997","author_association":"CONTRIBUTOR","_links":{"html":{"href":"https://github.com/godotengine/godot/pull/118997#pullrequestreview-4216765839"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/118997"}},"submitted_at":"2026-05-03T20:05:23Z","commit_id":"e777acec151e1e933b7ee5509bd0db1f5fa87378"},{"id":4546522241,"node_id":"PRR_kwDOAO6SJc8AAAABDv5sgQ","user":{"login":"Repiteo","id":17489292,"node_id":"MDQ6VXNlcjE3NDg5Mjky","avatar_url":"https://avatars.githubusercontent.com/u/17489292?u=34072b401722100a7c0c0d61e37b376cf22b4545&v=4","gravatar_id":"","url":"https://api.github.com/users/Repiteo","html_url":"https://github.com/Repiteo","followers_url":"https://api.github.com/users/Repiteo/followers","following_url":"https://api.github.com/users/Repiteo/following{/other_user}","gists_url":"https://api.github.com/users/Repiteo/gists{/gist_id}","starred_url":"https://api.github.com/users/Repiteo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Repiteo/subscriptions","organizations_url":"https://api.github.com/users/Repiteo/orgs","repos_url":"https://api.github.com/users/Repiteo/repos","events_url":"https://api.github.com/users/Repiteo/events{/privacy}","received_events_url":"https://api.github.com/users/Repiteo/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"","stat