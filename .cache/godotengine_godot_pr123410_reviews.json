[{"id":5179753766,"node_id":"PRR_kwDOAO6SJc8AAAABNLzFJg","user":{"login":"KoBeWi","id":2223172,"node_id":"MDQ6VXNlcjIyMjMxNzI=","avatar_url":"https://avatars.githubusercontent.com/u/2223172?u=fc85633b469acb6e7baef4dba5171f19a2a4ff85&v=4","gravatar_id":"","url":"https://api.github.com/users/KoBeWi","html_url":"https://github.com/KoBeWi","followers_url":"https://api.github.com/users/KoBeWi/followers","following_url":"https://api.github.com/users/KoBeWi/following{/other_user}","gists_url":"https://api.github.com/users/KoBeWi/gists{/gist_id}","starred_url":"https://api.github.com/users/KoBeWi/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/KoBeWi/subscriptions","organizations_url":"https://api.github.com/users/KoBeWi/orgs","repos_url":"https://api.github.com/users/KoBeWi/repos","events_url":"https://api.github.com/users/KoBeWi/events{/privacy}","received_events_url":"https://api.github.com/users/KoBeWi/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"I think the reason it worked before is pure coincidence. The bool parameter for `_update_zoom_and_pan()` controls whether the view should zoom towards the cursor or the center. In case of `zoom_changed`, the value was getting implicitly converted to `bool`, resulting in the method being called with the expected argument. In case of `value_changed`, the is no zooming, so the zoom argument does not matter. The binds/unbinds could be removed completely and it wouldn't make difference.\n\nAnd yeah, the code is technically more correct now.","state":"APPROVED","html_url":"https://github.com/godotengine/godot/pull/123410#pullrequestreview-5179753766","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/123410","author_association":"MEMBER","_links":{"html":{"href":"https://github.com/godotengine/godot/pull/123410#pullrequestreview-5179753766"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/123410"}},"submitted_at":"2026-09-11T14:22:27Z","commit_id":"26e39bde3ab1a4e0b97f1599d9b06738994afa7d"}]