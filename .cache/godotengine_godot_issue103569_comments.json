``\n\nBut indeed there's no error for both `d[Dic as GDScript]` and `d[Dic as Script]`:\n\n```gdscript\nclass_name Dic\nextends Node\n\nfunc _ready() -> void:\t\n\tvar d: Dictionary[Script, bool]\n\t#d[Dic] = false # Invalid index type \"Dic\" for a base of type \"Dictionary[Script, bool]\".\n\td[Dic as GDScript] = false # Fine.\n\td[Dic as Script] = false # Fine.","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2698407423/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2699603863","html_url":"https://github.com/godotengine/godot/issues/103569#issuecomment-2699603863","issue_url":"https://api.github.com/repos/godotengine/godot/issues/103569","id":2699603863,"node_id":"IC_kwDOAO6SJc6g6K-X","user":{"login":"TheSquawkyRaven","id":45909406,"node_id":"MDQ6VXNlcjQ1OTA5NDA2","avatar_url":"https://avatars.githubusercontent.com/u/45909406?v=4","gravatar_id":"","url":"https://api.github.com/users/TheSquawkyRaven","html_url":"https://github.com/TheSquawkyRaven","followers_url":"https://api.github.com/users/TheSquawkyRaven/followers","following_url":"https://api.github.com/users/TheSquawkyRaven/following{/other_user}","gists_url":"https://api.github.com/users/TheSquawkyRaven/gists{/gist_id}","starred_url":"https://api.github.com/users/TheSquawkyRaven/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/TheSquawkyRaven/subscriptions","organizations_url":"https://api.github.com/users/TheSquawkyRaven/orgs","repos_url":"https://api.github.com/users/TheSquawkyRaven/repos","events_url":"https://api.github.com/users/TheSquawkyRaven/events{/privacy}","received_events_url":"https://api.github.com/users/TheSquawkyRaven/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-03-