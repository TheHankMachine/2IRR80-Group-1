_by":null},{"id":279098219,"node_id":"MDU6TGFiZWwyNzkwOTgyMTk=","url":"https://api.github.com/repos/godotengine/godot/labels/topic:editor","name":"topic:editor","color":"ffee88","default":false,"description":"","archived_at":null,"archived_by":null}],"state":"closed","locked":false,"assignees":[],"milestone":{"url":"https://api.github.com/repos/godotengine/godot/milestones/25","html_url":"https://github.com/godotengine/godot/milestone/25","labels_url":"https://api.github.com/repos/godotengine/godot/milestones/25/labels","id":15520464,"node_id":"MI_kwDOAO6SJc4A7NLQ","number":25,"title":"4.8","description":"","creator":{"login":"Repiteo","id":17489292,"node_id":"MDQ6VXNlcjE3NDg5Mjky","avatar_url":"https://avatars.githubusercontent.com/u/17489292?v=4","gravatar_id":"","url":"https://api.github.com/users/Repiteo","html_url":"https://github.com/Repiteo","followers_url":"https://api.github.com/users/Repiteo/followers","following_url":"https://api.github.com/users/Repiteo/following{/other_user}","gists_url":"https://api.github.com/users/Repiteo/gists{/gist_id}","starred_url":"https://api.github.com/users/Repiteo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Repiteo/subscriptions","organizations_url":"https://api.github.com/users/Repiteo/orgs","repos_url":"https://api.github.com/users/Repiteo/repos","events_url":"https://api.github.com/users/Repiteo/events{/privacy}","received_events_url":"https://api.github.com/users/Repiteo/received_events","type":"User","user_view_type":"public","site_admin":false},"open_issues":350,"closed_issues":2337,"state":"open","created_at":"2026-04-13T15:59:35Z","updated_at":"2026-10-22T14:39:02Z","due_on":null,"closed_at":null},"comments":14,"created_at":"2025-04-29T22:18:35Z","updated_at":"2026-06-24T15:23:01Z","closed_at":"2026-06-24T15:21:15Z","assignee":null,"author_association":"CONTRIBUTOR","issue_field_values":[],"type":null,"active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"### Tested versions\n\nTested on master branch v4.5.dev.custom_build [ce94b26de]\nTested on v4.4.1.stable.custom_build [49a5bc7b6]\n\n### System information\n\nGodot v4.5.dev (ce94b26de) - Manjaro Linux #1 SMP PREEMPT_DYNAMIC Sat, 29 Mar 2025 06:09:17 +0000 on Wayland - Wayland display driver, Multi-window, 2 monitors - Vulkan (Forward+) - dedicated AMD Radeon RX 7900 XT (RADV NAVI31) - AMD Ryzen 9 7900X 12-Core Processor (24 threads)\n\n### Issue description\n\nWhen browsing the in-editor documentation for some of my custom classes, I noticed some of them were reporting the wrong parent class (`RefCounted` instead of the actual parent class, which does inherit from `RefCounted`).\n\nIn the images below, my `InSimRSTPacket` inherits a base `InSimPacket` class, but is shown as inheriting `RefCounted`. From the base `InSimPacket` class, only 4 classes are listed as inheriting from it, but there are actually close to 70 of them.\n`InSimPacket` itself actually inherits from `LFSPacket`, which in turn inherits from `RefCounted`.\n\n![Image](https://github.com/user-attachments/assets/5da407b2-6bb7-4ba8-85d4-ca233c6d1939)\n![Image](https://github.com/user-attachments/assets/a11298c2-54f6-46bf-9aac-ebe32bad5bcd)\n\nIt may be worth noting that exporting the documentation via `godot --doctool --gdscript-docs` results in the same issue in the XML files.\n\n### Steps to reproduce\n\nUnknown to me at this point, I tried deleting the `.godot` directory, but the issue stayed exactly the same.\n\n### Minimal reproduction project (MRP)\n\nSee [this comment below](https://github.com/godotengine/godot/issues/105926#issuecomment-2869657989) for a very small MRP, and [this comment](https://github.com/godotengine/godot/issues/105926#issuecomment-4701223830) for a more complete MRP failing in both the editor and doctool.","closed_by":{"login":"Repiteo","id":17489292,"node_id"