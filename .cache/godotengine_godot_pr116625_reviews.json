[{"id":3840175145,"node_id":"PRR_kwDOAO6SJc7k5Gwp","user":{"login":"bruvzg","id":7645683,"node_id":"MDQ6VXNlcjc2NDU2ODM=","avatar_url":"https://avatars.githubusercontent.com/u/7645683?u=2867ee7fcd920bc19b7d1cbf4b10264b9bbc9326&v=4","gravatar_id":"","url":"https://api.github.com/users/bruvzg","html_url":"https://github.com/bruvzg","followers_url":"https://api.github.com/users/bruvzg/followers","following_url":"https://api.github.com/users/bruvzg/following{/other_user}","gists_url":"https://api.github.com/users/bruvzg/gists{/gist_id}","starred_url":"https://api.github.com/users/bruvzg/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/bruvzg/subscriptions","organizations_url":"https://api.github.com/users/bruvzg/orgs","repos_url":"https://api.github.com/users/bruvzg/repos","events_url":"https://api.github.com/users/bruvzg/events{/privacy}","received_events_url":"https://api.github.com/users/bruvzg/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"This makes remapping existing Esc to Enter (and vice versa) impossible.\n\nAnd this is highly unintuitive behavior, what's the purpose for adding this.","state":"COMMENTED","html_url":"https://github.com/godotengine/godot/pull/116625#pullrequestreview-3840175145","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/116625","author_association":"MEMBER","_links":{"html":{"href":"https://github.com/godotengine/godot/pull/116625#pullrequestreview-3840175145"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/116625"}},"submitted_at":"2026-02-23T10:20:15Z","commit_id":"89b72be77b0c9e717a4ab13ca860a88f682bbf7d"},{"id":3917703739,"node_id":"PRR_kwDOAO6SJc7pg2o7","user":{"login":"Calinou","id":180032,"node_id":"MDQ6VXNlcjE4MDAzMg==","avatar_url":"https://avatars.githubusercontent.com/u/180032?u=68d23e7ee9cdf810da125e8510b72f845b9dccc8&v=4","gravatar_id":"","url":"https://api.github.com/users/Calinou","html_url":"https://github.com/Calinou","followers_url":"https://api.github.com/users/Calinou/followers","following_url":"https://api.github.com/users/Calinou/following{/other_user}","gists_url":"https://api.github.com/users/Calinou/gists{/gist_id}","starred_url":"https://api.github.com/users/Calinou/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Calinou/subscriptions","organizations_url":"https://api.github.com/users/Calinou/orgs","repos_url":"https://api.github.com/users/Calinou/repos","events_url":"https://api.github.com/users/Calinou/events{/privacy}","received_events_url":"https://api.github.com/users/Calinou/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"Tested locally, it works as expected. Code looks good to me.\n\nI think this is good from an UX perspective. You can still bind <kbd>Enter</kbd>/<kbd>Escape</kbd> easily, but the workflow for binding many keys in a row is a lot more seamless now.\n\nhttps://github.com/user-attachments/assets/92209b6e-9b78-44fd-93c2-793389901e93\n\nSome further UX improvements in the future (should be discussed in a proposal):\n\n- Automatically focus the **Add New Action** field after confirming or canceling an input addition, so you can add more inputs without having to touch the mouse.\n- Automatically start adding a new event after adding a new action if you were holding <kbd>Shift</kbd> when pressing <kbd>Enter</kbd> or clicking the button. This should be indicated in the field's tooltip or even in its placeholder.\n\nTogether, these two changes will make it possible to have a 100% mouse-free workflow for a majority of use cases (adding one key per input action).","state":"APPROVED","html_url":"https://github.com/godotengine/godot/pull/116625#pullrequestreview-3917703739","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/116625","author_association":"MEMBER","_links":{"html":{"href":"https://github.com/godotengine/godot/pull/116625#pullrequestreview-3917703739"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/116625"}},"submitted_at":"2026-03-09T19:26:42Z","commit_id":"a71749c8848762adf7c04eac7edef213183fbc6c"}]