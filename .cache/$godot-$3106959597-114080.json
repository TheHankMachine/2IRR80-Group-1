s://github.com/Rookfighter","id":2543949,"node_id":"MDQ6VXNlcjI1NDM5NDk=","login":"Rookfighter","type":"User","owned_private_repos":0,"public_gists":0,"public_repos":0,"total_private_repos":0,"url":"https://api.github.com/users/Rookfighter"},"body":"","html_url":"https://github.com/godotengine/godot/pull/114080#pullrequestreview-3671319839","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/114080","author_association":"CONTRIBUTOR","submitted_at":"2026-01-16T15:06:43Z"},{"id":3672385965,"node_id":"PRR_kwDOAO6SJc7a5Cmt","state":"CHANGES_REQUESTED","user":{"site_admin":false,"suspended":false,"updated_at":"0001-01-01T00:00:00Z","avatar_url":"https://avatars.githubusercontent.com/u/11238951?u=d43175c19b67a38ab4cef171ccf891db01ddae14&v=4","created_at":"0001-01-01T00:00:00Z","followers":0,"following":0,"html_url":"https://github.com/BuzzLord","id":11238951,"node_id":"MDQ6VXNlcjExMjM4OTUx","login":"BuzzLord","type":"User","owned_private_repos":0,"public_gists":0,"public_repos":0,"total_private_repos":0,"url":"https://api.github.com/users/BuzzLord"},"body":"I noticed a copy paste bug, but once that's fixed, it looks fine to me. I tested it, and it does what it says.","html_url":"https://github.com/godotengine/godot/pull/114080#pullrequestreview-3672385965","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/114080","author_association":"NONE","submitted_at":"2026-01-18T19:11:51Z"},{"id":3675746117,"node_id":"PRR_kwDOAO6SJc7bF29F","state":"COMMENTED","user":{"site_admin":false,"suspended":false,"updated_at":"0001-01-01T00:00:00Z","avatar_url":"https://avatars.githubusercontent.com/u/2543949?u=703a8485c070a6c4ce32d97fa0f74fa00544173f&v=4","created_at":"0001-01-01T00:00:00Z","followers":0,"following":0,"html_url":"https://github.com/Rookfighter","id":2543949,"node_id":"MDQ6VXNlcjI1NDM5NDk=","login":"Rookfighter","type":"User","owned_private_repos":0,"public_gists":0,"public_repos":0,"total_private_repos":0,"url":"https://api.github.com/users/Rookfighter"},"body":"","html_url":"https://github.com/godotengine/godot/pull/114080#pullrequestreview-3675746117","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/114080","author_association":"CONTRIBUTOR","submitted_at":"2026-01-18T20:14:18Z"},{"id":3677049308,"node_id":"PRR_kwDOAO6SJc7bK1Hc","state":"COMMENTED","user":{"site_admin":false,"suspended":false,"updated_at":"0001-01-01T00:00:00Z","avatar_url":"https://avatars.githubusercontent.com/u/96648715?u=af70f5d107e9c1447f296643d5a566dab53d25e8&v=4","created_at":"0001-01-01T00:00:00Z","followers":0,"following":0,"html_url":"https://github.com/AThousandShips","id":96648715,"node_id":"U_kgDOBcK-Cw","login":"AThousandShips","type":"User","owned_private_repos":0,"public_gists":0,"public_repos":0,"total_private_repos":0,"url":"https://api.github.com/users/AThousandShips"},"body":"","html_url":"https://github.com/godotengine/godot/pull/114080#pullrequestreview-3677049308","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/114080","author_association":"MEMBER","submitted_at":"2026-01-19T09:11:24Z"},{"id":3678773672,"node_id":"PRR_kwDOAO6SJc7bRaGo","state":"COMMENTED","user":{"site_admin":false,"suspended":false,"updated_at":"0001-01-01T00:00:00Z","avatar_url":"https://avatars.githubusercontent.com/u/2543949?u=703a8485c070a6c4ce32d97fa0f74fa00544173f&v=4","created_at":"0001-01-01T00:00:00Z","followers":0,"following":0,"html_url":"https://github.com/Rookfighter","id":2543949,"node_id":"MDQ6VXNlcjI1NDM5NDk=","login":"Rookfighter","type":"User","owned_private_repos":0,"public_gists":0,"public_repos":0,"total_private_repos":0,"url":"https://api.github.com/users/Rookfighter"},"body":"","html_url":"https://github.com/godotengine/godot/pull/114080#pullrequestreview-3678773672","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/114080","author_association":"CONTRIBUTOR","submitted_at":"2026-01-19T16:06:15Z"},{"id":3679655385,"node_id":"PRR_kwDOAO6SJc7bUxXZ","state":"CHANGES_REQUESTED","user":{"site_admin":false,"suspended":false,"updated_at":"0001-01-01T00:00:00Z","avatar_url":"https://avatars.githubusercontent.com/u/11238951?u=d43175c19b67a38ab4cef171ccf891db01ddae14&v=4","created_at":"0001-01-01T00:00:00Z","followers":0,"following":0,"html_url":"https://github.com/BuzzLord","id":11238951,"node_id":"MDQ6VXNlcjExMjM4OTUx","login":"BuzzLord","type":"User","owned_private_repos":0,"public_gists":0,"public_repos":0,"total_private_repos":0,"url":"https://api.github.com/users/BuzzLord"},"body":"While testing with doppler, I noticed it tended to keep higher pitch more than lower pitch. While looking to see if there was an better way to blend pitches, I realized there's a bug: `actual_pitch_scale` can never be less than `internal->pitch_scale` because of the `MAX`. So you never get low pitches for receding sounds, even in the single camera case.\r\n\r\nI think I came up with a better way of calculating the actual pitch, using a weighted average. Since humans here pitch roughly in log2 space, the idea is to keep weighted log2 pitch scales, then normalize and change back to linear at the end.\r\n\r\n```\r\n\t// set picth to default value\r\n\t// this will only change if the Doppler effect is activated\r\n\tactual_pitch_scale = internal->pitch_scale;\r\n\tfloat log_pitch_scale = 0.0;\r\n\tfloat log_pitch_weight = 0.0;\r\n```\r\n\r\nThen in the doppler section, instead of `MAX` you do:\r\n```\r\n\tfloat doppler_pitch_scale = internal->pitch_scale * speed_of_sound / (speed_of_sound + velocity * approaching);\r\n\tdoppler_pitch_scale = CLAMP(doppler_pitch_scale, (1 / 8.0), 8.0); //avoid crazy stuff\r\n\r\n\tfloat weight = _get_max_volume(tmp_volume_vector);\r\n\tlog_pitch_scale += weight * log2(doppler_pitch_scale);\r\n\tlog_pitch_weight += weight;\r\n```\r\n\r\nWhere `_get_max_volume` just gets the largest volume response of any channel:\r\n```\r\nstatic float _get_max_volume(const Vector<AudioFrame> &p_src_volume_vector) {\r\n\tfloat max_vol = 0.0;\r\n\tfor (int64_t i = 0; i < p_src_volume_vector.size(); i++) {\r\n\t\tmax_vol = MAX(max_vol, p_src_volume_vector[i].left);\r\n\t\tmax_vol = MAX(max_vol, p_src_volume_vector[i].right);\r\n\t}\r\n\treturn max_vol;\r\n}\r\n```\r\n\r\nAfter the cameras loop:\r\n```\r\n\tif (log_pitch_weight > 0) {\r\n\t\tactual_pitch_scale = pow(2.0, log_pitch_scale / log_pitch_weight);\r\n\t}\r\n```\r\n\r\n","html_url":"https://github.com/godotengine/godot/pull/114080#pullrequestreview-3679655385","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/114080","author_association":"NONE","submitted_at":"2026-01-19T21:27:39Z"},{"id":3759598125,"node_id":"PRR_kwDOAO6SJc7gFuot","state":"COMMENTED","user":{"site_admin":false,"suspended":false,"updated_at":"0001-01-01T00:00:00Z","avatar_url":"https://avatars.githubusercontent.com/u/11238951?u=d43175c19b67a38ab4cef171ccf891db01ddae14&v=4","created_at":"0001-01-01T00:00:00Z","followers":0,"following":0,"html_url":"https://github.com/BuzzLord","id":11238951,"node_id":"MDQ6VXNlcjExMjM4OTUx","login":"BuzzLord","type":"User","owned_private_repos":0,"public_gists":0,"public_repos":0,"total_private_repos":0,"url":"https://api.github.com/users/BuzzLord"},"body":"Something that came up in the last audio meeting (that I forgot to mention before) is it's not ideal to allocate `tmp_volume_vector` and `tmp_reverb_vector` every frame. The `output_volume_vector` makes sense, since it gets returned, but these are only used in this function, and not passed anywhere. \n\nI think since they're needed every frame, you could move them to class member variables, and just have them resize to the right size at the start of `_update_panning`. Or allocating them on the stack with `AudioFrame tmp_volume_vector[4];` would probably be fine too, but would require some refactoring to make the functions that use them work. I'm not sure which is best; maybe we can discuss it at the next meeting.\n\nI'd also rename them to something like `listener_volume_vector`/`listener_reverb_vector`, or `camera_` or `view_`, or something to that effect.","html_url":"https://github.com/godotengine/godot/pull/114080#pullrequestreview-3759598125","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/114080","author_association":"NONE","submitted_at":"2026-02-05T21:39:01Z"},{"id":3853544640,"node_id":"PRR_kwDOAO6SJc7lsGzA","state":"APPROVED","user":{"site_admin":false,"suspended":false,"updated_at":"0001-01-01T00:00:00Z","avatar_url":"https://avatars.githubusercontent.com/u/11238951?u=d43175c19b67a38ab4cef171ccf891db01ddae14&v=4","created_at":"0001-01-01T00:00:00Z","followers":0,"following":0,"html_url":"https://github.com/BuzzLord","id":11238951,"node_id":"MDQ6VXNlcjExMjM4OTUx","login":"BuzzLord","type":"User","owned_private_repos":0,"public_gists":0,"public_repos":0,"total_private_repos":0,"url":"https://api.github.com/users/BuzzLord"},"body":"Looks good to me. Tested it, and it works as intended. I think the implementation is straight forward and clean, and doesn't affect anything outside of the use-case it fixes (i.e. getting better 3d panning/mixing with multiple cameras/listeners).\n\nI'm honestly not a fan of the chunky three line, triple /// comment style used in the header (just aesthetically), but there is precedence elsewhere in the engine for that type of comment, and the comment content is fine, so I guess it's fine.","html_url":"https://github.com/godotengine/godot/pull/114080#pullrequestreview-3853544640","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/114080","author_association":"NONE","submitted_at":"2026-02-25T11:10:08Z"},{"id":3853683306,"node_id":"PRR_kwDOAO6SJc7lsopq","state":"COMMENTED","user":{"site_admin":false,"suspended":false,"updated_at":"0001-01-01T00:00:00Z","avatar_url":"https://avatars.githubusercontent.com/u/2308167?u=f7f8e0273f784f5ec6f6b7fe4a88d449896eb48a&v=4","created_at":"0001-01-01T00:00:00Z","followers":0,"following":0,"html_u