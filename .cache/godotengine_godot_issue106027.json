240950060,"node_id":"MDU6TGFiZWwzMjQwOTUwMDYw","url":"https://api.github.com/repos/godotengine/godot/labels/performance","name":"performance","color":"447777","default":false,"description":"","archived_at":null,"archived_by":null}],"state":"closed","locked":false,"assignees":[],"milestone":{"url":"https://api.github.com/repos/godotengine/godot/milestones/22","html_url":"https://github.com/godotengine/godot/milestone/22","labels_url":"https://api.github.com/repos/godotengine/godot/milestones/22/labels","id":12070367,"node_id":"MI_kwDOAO6SJc4AuC3f","number":22,"title":"4.5","description":"","creator":{"login":"Sauermann","id":6299227,"node_id":"MDQ6VXNlcjYyOTkyMjc=","avatar_url":"https://avatars.githubusercontent.com/u/6299227?v=4","gravatar_id":"","url":"https://api.github.com/users/Sauermann","html_url":"https://github.com/Sauermann","followers_url":"https://api.github.com/users/Sauermann/followers","following_url":"https://api.github.com/users/Sauermann/following{/other_user}","gists_url":"https://api.github.com/users/Sauermann/gists{/gist_id}","starred_url":"https://api.github.com/users/Sauermann/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Sauermann/subscriptions","organizations_url":"https://api.github.com/users/Sauermann/orgs","repos_url":"https://api.github.com/users/Sauermann/repos","events_url":"https://api.github.com/users/Sauermann/events{/privacy}","received_events_url":"https://api.github.com/users/Sauermann/received_events","type":"User","user_view_type":"public","site_admin":false},"open_issues":3,"closed_issues":3687,"state":"closed","created_at":"2024-12-19T08:51:28Z","updated_at":"2026-09-04T21:48:38Z","due_on":"2025-09-15T00:00:00Z","closed_at":"2025-09-18T17:13:14Z"},"comments":1,"created_at":"2025-05-02T16:46:57Z","updated_at":"2025-05-06T15:32:09Z","closed_at":"2025-05-05T16:30:35Z","assignee":null,"author_association":"CONTRIBUTOR","issue_field_values":[],"type":null,"active_lock_reason":null,"draft":false,"pull_request":{"url":"https://api.github.com/repos/godotengine/godot/pulls/106027","html_url":"https://github.com/godotengine/godot/pull/106027","diff_url":"https://github.com/godotengine/godot/pull/106027.diff","patch_url":"https://github.com/godotengine/godot/pull/106027.patch","merged_at":"2025-05-05T16:30:35Z"},"body":"- Updated initial `new_string` copy to use copy constructor/increase ref count instead of copying to new allocated memory\r\n- Removed `Variant` copies from `Array` before assigning to `String`\r\n- Only convert `i` to `String` when needed\r\n\r\nMakes `String::format` around 5-30% faster depending on how arguments are passed in, compared with gdscript below:\r\n\r\n```gdscript\r\nvar pos3 := Vector3(1, 2, 3)\r\nfunc _ready() -> void:\r\n\trun_test(\"nested_arrays\")\r\n\trun_test(\"array_with_index\")\r\n\trun_test(\"array_no_index\")\r\n\trun_test(\"dictionary\")\r\n\t\r\nfunc run_test(p_name : String):\r\n\tvar start := Time.get_ticks_msec()\r\n\tcall(p_name)\r\n\tvar end := Time.get_ticks_msec()\r\n\tprint(\"%s: %dms\" % [p_name, end - start])\r\n\r\nfunc nested_arrays():\r\n\tvar args := [[\"x\", pos3.x], [\"y\", pos3.y], [\"z\", pos3.z]]\r\n\tfor i in 100000:\r\n\t\t\"(x: {x}, y: {y}, z: {z})\".format(args)\r\n\r\nfunc array_with_index():\r\n\tvar args := [pos3.x, pos3.y, pos3.z]\r\n\tfor i in 100000:\r\n\t\t\"(x: {0}, y: {1}, z: {2})\".format(args)\r\n\t\t\r\nfunc array_no_index():\r\n\tvar args := [pos3.x, pos3.y, pos3.z]\r\n\tfor i in 100000:\r\n\t\t\"(x: {}, y: {}, z: {})\".format(args, \"{}\")\r\n\r\nfunc dictionary():\r\n\tvar args := {\"x\": pos3.x, \"y\": pos3.y, \"z\": pos3.z}\r\n\tfor i in 100000:\r\n\t\t\"(x: {x}, y: {y}, z: {z})\".format(args)\r\n```\r\n\r\nold\r\n```\r\nnested_arrays: 237ms\r\narray_with_index: 220ms\r\narray_no_index: 130ms\r\ndictionary: 194ms\r\n```\r\n\r\nnew\r\n```\r\nnested_arrays: 206ms\r\narray_with_index: 212ms\r\narray_no_index: 103ms\r\ndictionary: 184ms\r\n```\r\n\r\n<!--\r\nPlease target the `master` branch in priority.\r\n\r\nRelevant fixes are cherry-picked for stable branches as needed by maintainers.\r\n\r\nTo speed up the contribution process and avoid CI errors, please set up pre-commit hooks locally:\r\nhttps://docs.godotengine.org/en/latest/contributing/development/code_style_guidelines.html\r\n-->\r\n","closed_by":{"login":"Repiteo","id":17489292,"node_id":"MDQ6VXNlcjE3NDg5Mjky","avatar_url":"https://avatars.githubusercontent.com/u/17489292?v=4","gravatar_id":"","url":"https://api.github.com/users/Repiteo","html_url":"https://github.com/Repiteo","followers_url":"https://api.github.com/users/Repiteo/followers","following_url":"https://api.github.com/users/Repiteo/following{/other_user}","gists_url":"https://api.github.com/users/Repiteo/gists{/gist_id}","starred_url":"https://api.github.com/users/Repiteo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Repiteo/subscriptions","organizations_url":"https://api.github.com/users/Repiteo/orgs","repos_url":"https://api.github.com/users/Repiteo/repos","events_url":"https://api.github.com/users/Repiteo/events{/privacy}","received_events_url":"https://api.github.com/users/Repiteo/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/106027/reactions","total_count":10,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":9,"eyes":0},"timeline_url":"https://api.github.com/repos/godotengine/godot/issues/106027/timeline","performed_via_github_app":null,"state_reason":null}