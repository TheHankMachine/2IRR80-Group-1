:android","color":"e4e4e4","default":false,"description":"","archived_at":null,"archived_by":null},{"id":279098255,"node_id":"MDU6TGFiZWwyNzkwOTgyNTU=","url":"https://api.github.com/repos/godotengine/godot/labels/topic:platforms","name":"topic:platforms","color":"ffee88","default":false,"description":"","archived_at":null,"archived_by":null},{"id":890310664,"node_id":"MDU6TGFiZWw4OTAzMTA2NjQ=","url":"https://api.github.com/repos/godotengine/godot/labels/topic:input","name":"topic:input","color":"ffee88","default":false,"description":"","archived_at":null,"archived_by":null},{"id":1327318271,"node_id":"MDU6TGFiZWwxMzI3MzE4Mjcx","url":"https://api.github.com/repos/godotengine/godot/labels/crash","name":"crash","color":"885544","default":false,"description":"","archived_at":null,"archived_by":null}],"state":"closed","locked":false,"assignees":[],"milestone":{"url":"https://api.github.com/repos/godotengine/godot/milestones/23","html_url":"https://github.com/godotengine/godot/milestone/23","labels_url":"https://api.github.com/repos/godotengine/godot/milestones/23/labels","id":12939969,"node_id":"MI_kwDOAO6SJc4AxXLB","number":23,"title":"4.6","description":"","creator":{"login":"Repiteo","id":17489292,"node_id":"MDQ6VXNlcjE3NDg5Mjky","avatar_url":"https://avatars.githubusercontent.com/u/17489292?v=4","gravatar_id":"","url":"https://api.github.com/users/Repiteo","html_url":"https://github.com/Repiteo","followers_url":"https://api.github.com/users/Repiteo/followers","following_url":"https://api.github.com/users/Repiteo/following{/other_user}","gists_url":"https://api.github.com/users/Repiteo/gists{/gist_id}","starred_url":"https://api.github.com/users/Repiteo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Repiteo/subscriptions","organizations_url":"https://api.github.com/users/Repiteo/orgs","repos_url":"https://api.github.com/users/Repiteo/repos","events_url":"https://api.github.com/users/Repiteo/events{/privacy}","received_events_url":"https://api.github.com/users/Repiteo/received_events","type":"User","user_view_type":"public","site_admin":false},"open_issues":3,"closed_issues":2978,"state":"closed","created_at":"2025-05-22T16:25:52Z","updated_at":"2026-10-04T16:23:23Z","due_on":null,"closed_at":"2026-01-26T18:09:14Z"},"comments":1,"created_at":"2025-11-14T14:53:48Z","updated_at":"2025-11-14T20:28:48Z","closed_at":"2025-11-14T20:28:28Z","assignee":null,"author_association":"CONTRIBUTOR","issue_field_values":[],"type":null,"active_lock_reason":null,"draft":false,"pull_request":{"url":"https://api.github.com/repos/godotengine/godot/pulls/112760","html_url":"https://github.com/godotengine/godot/pull/112760","diff_url":"https://github.com/godotengine/godot/pull/112760.diff","patch_url":"https://github.com/godotengine/godot/pull/112760.patch","merged_at":"2025-11-14T20:28:28Z"},"body":"There are two different paths for handling controllers on Android:\r\n\r\n1. Enumeration of connected gamepads on startup.\r\n2. When a gamepad is connected.\r\n\r\nOn Android, gamepads are handled in Java via a `InputManager.InputDeviceListener`. Upon connection `onInputDeviceAdded` is fired on the apps main thread. _However_, Godot predominantly runs on a separate renderer thread, if a gamepad is connected when the Android app is launching, but before Godot has started up, you end up with a crash accessing a `nullptr` in C++:\r\n\r\n<img width=\"5344\" height=\"3054\" alt=\"CleanShot 2025-11-09 at 18 04 22@2x\" src=\"https://github.com/user-attachments/assets/2edabb0a-02ae-44e0-b44d-fcf5ff74c9cc\" />\r\n\r\nThis PR introduces a simple check that ensures the `Input` singleton is available, before we try call methods on it. Otherwise the event is ignored. This is fine, the gamepad won't be ignored, when `Input` does startup, we'll enumerate existing connected gamepads. Granted, that's not to say I've specifically verified there's no race condition in that logic, but that's out of scope for this PR. We're just fixing a crash here.","closed_by":{"login":"Repiteo","id":17489292,"node_id":"MDQ6VXNlcjE3NDg5Mjky","avatar_url":"https://avatars.githubusercontent.com/u/17489292?v=4","gravatar_id":"","url":"https://api.github.com/users/Repiteo","html_url":"https://github.com/Repiteo","followers_url":"https://api.github.com/users/Repiteo/followers","following_url":"https://api.github.com/users/Repiteo/following{/other_user}","gists_url":"https://api.github.com/users/Repiteo/gists{/gist_id}","starred_url":"https://api.github.com/users/Repiteo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Repiteo/subscriptions","organizations_url":"https://api.github.com/users/Repiteo/orgs","repos_url":"https://api.github.com/users/Repiteo/repos","events_url":"https://api.github.com/users/Repiteo/events{/privacy}","received_events_url":"https://api.github.com/users/Repiteo/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/112760/reactions","total_count":2,"+1":2,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/godotengine/godot/issues/112760/timeline","performed_via_github_app":null,"state_reason":null}