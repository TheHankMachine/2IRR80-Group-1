github.com/users/yelloweennnn/subscriptions","organizations_url":"https://api.github.com/users/yelloweennnn/orgs","repos_url":"https://api.github.com/users/yelloweennnn/repos","events_url":"https://api.github.com/users/yelloweennnn/events{/privacy}","received_events_url":"https://api.github.com/users/yelloweennnn/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2024-12-10T19:33:21Z","updated_at":"2024-12-10T19:33:21Z","body":"I tried using `git branch -d fix-input-event-metadata`, and it gave me this error:\r\n`the branch 'fix-input-event-metadata' is not fully merged`\r\nI checked `git branch --merged` and my branch isn't listed.\r\nWould it be safe to use -D?","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2532692111/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2533069028","html_url":"https://github.com/godotengine/godot/pull/100044#issuecomment-2533069028","issue_url":"https://api.github.com/repos/godotengine/godot/issues/100044","id":2533069028,"node_id":"IC_kwDOAO6SJc6W-5Dk","user":{"login":"Sauermann","id":6299227,"node_id":"MDQ6VXNlcjYyOTkyMjc=","avatar_url":"https://avatars.githubusercontent.com/u/6299227?v=4","gravatar_id":"","url":"https://api.github.com/users/Sauermann","html_url":"https://github.com/Sauermann","followers_url":"https://api.github.com/users/Sauermann/followers","following_url":"https://api.github.com/users/Sauermann/following{/other_user}","gists_url":"https://api.github.com/users/Sauermann/gists{/gist_id}","starred_url":"https://api.github.com/users/Sauermann/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Sauermann/subscriptions","organizations_url":"https://api.github.com/users/Sauermann/orgs","repos_url":"https://api.github.com/users/Sauermann/repos","events_url":"https://api.github.com/users/Sauermann/events{/privacy}","received_events_url":"https://api.github.com/users/Sauermann/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2024-12-10T22:24:24Z","updated_at":"2024-12-10T22:24:24Z","body":"@Yelloween10 \r\nThis message indicates, that in your local copy of the git-repository, your PR is not yet included in the master branch.\r\n\r\nI get this message, when I forget to update my local master branch. You could update your local master branch and fetch the most recent master-branch from github. Afterwards deleting the branch with \"-d\" no longer gives that error.\r\n\r\nAs you mentioned, an alternative would be to use \"-D\" to force the removal of your local \"fix-input-event-metadata\" branch. Since your PR is already merged in master, I don't see any negative effects. When one of my PRs is discarded without getting merged, I use \"-D\" to delete it locally.\r\n\r\nThe local repository also contains a remote branch (for example recently I had \"my-remote/fix-mouse-over-viewport-in-texturerect\").\r\nI delete that one too with \"git branch -dr my-remote/fix-mouse-over-viewport-in-texturerect\"","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2533069028/reactions","total_count":1,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":1,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null}]