rcle when you've reached the top (same for any other edge):\r\n\r\nhttps://github.com/user-attachments/assets/f85f6c6f-f3e1-4b13-af6c-29bc2adc3b1d\r\n\r\nRight now, it stops so you need to manually move to the left then move back up again.","state":"APPROVED","html_url":"https://github.com/godotengine/godot/pull/99374#pullrequestreview-2459354223","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/99374","author_association":"MEMBER","_links":{"html":{"href":"https://github.com/godotengine/godot/pull/99374#pullrequestreview-2459354223"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/99374"}},"submitted_at":"2024-11-25T18:39:09Z","commit_id":"3abc8f88c67105d535c43a819e4c28e1eb6d10a1"},{"id":2459355169,"node_id":"PRR_kwDOAO6SJc6Slsgh","user":{"login":"Calinou","id":180032,"node_id":"MDQ6VXNlcjE4MDAzMg==","avatar_url":"https://avatars.githubusercontent.com/u/180032?u=68d23e7ee9cdf810da125e8510b72f845b9dccc8&v=4","gravatar_id":"","url":"https://api.github.com/users/Calinou","html_url":"https://github.com/Calinou","followers_url":"https://api.github.com/users/Calinou/followers","following_url":"https://api.github.com/users/Calinou/following{/other_user}","gists_url":"https://api.github.com/users/Calinou/gists{/gist_id}","starred_url":"https://api.github.com/users/Calinou/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Calinou/subscriptions","organizations_url":"https://api.github.com/users/Calinou/orgs","repos_url":"https://api.github.com/users/Calinou/repos","events_url":"https://api.github.com/users/Calinou/events{/privacy}","received_events_url":"https://api.github.com/users/Calinou/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"","state":"COMMENTED","html_url":"https://github.com/godotengine/godot/pull/99374#pullrequestreview-2459355169","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/99374","author_association":"MEMBER","_links