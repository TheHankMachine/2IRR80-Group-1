/github.com/akien-mga","id":4701338,"node_id":"MDQ6VXNlcjQ3MDEzMzg=","login":"akien-mga","type":"User","owned_private_repos":0,"public_gists":0,"public_repos":0,"total_private_repos":0,"url":"https://api.github.com/users/akien-mga"},"body":"","html_url":"https://github.com/godotengine/godot/pull/102774#pullrequestreview-2612418393","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/102774","author_association":"MEMBER","submitted_at":"2025-02-12T15:55:40Z"},{"id":2612601337,"node_id":"PRR_kwDOAO6SJc6buSH5","state":"COMMENTED","user":{"site_admin":false,"suspended":false,"updated_at":"0001-01-01T00:00:00Z","avatar_url":"https://avatars.githubusercontent.com/u/180032?u=68d23e7ee9cdf810da125e8510b72f845b9dccc8&v=4","created_at":"0001-01-01T00:00:00Z","followers":0,"following":0,"html_url":"https://github.com/Calinou","id":180032,"node_id":"MDQ6VXNlcjE4MDAzMg==","login":"Calinou","type":"User","owned_private_repos":0,"public_gists":0,"public_repos":0,"total_private_repos":0,"url":"https://api.github.com/users/Calinou"},"body":"Tested locally on Linux, it works as expected. See also https://github.com/godotengine/godot/pull/102770#pullrequestreview-2612613417.\r\n\r\nConsidering TLS 1.3 isn't a hard requirement for most services (most still support TLS 1.2 due to legacy clients) and that TLS 1.2 doesn't have known exploitable flaws yet, it's probably fine. However, I'm also concerned about the default setting changes we'd potentially have to make in a patch release.\r\n\r\nIt may be worth pointing out the project setting in the HTTPClient and HTTPRequest class documentation still, in case someone is testing against a TLS 1.3-only service.","html_url":"https://github.com/godotengine/godot/pull/102774#pullrequestreview-2612601337","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/102774","author_association":"MEMBER","submitted_at":"2025-02-12T16:51:12Z"},{"id":2618147557,"node_id":"PRR_kwDOAO6SJc6cDcLl","state":"COMMENTED","use