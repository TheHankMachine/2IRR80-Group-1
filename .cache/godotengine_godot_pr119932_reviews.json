s{/gist_id}","starred_url":"https://api.github.com/users/HolonProduction/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/HolonProduction/subscriptions","organizations_url":"https://api.github.com/users/HolonProduction/orgs","repos_url":"https://api.github.com/users/HolonProduction/repos","events_url":"https://api.github.com/users/HolonProduction/events{/privacy}","received_events_url":"https://api.github.com/users/HolonProduction/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"Makes sense to me.\n\nThe usage of `CALL_ERROR_INVALID_METHOD` for a valid method bind, might trigger some edge case. But since no-one from core did raise concerns, I guess we can just try it.","state":"APPROVED","html_url":"https://github.com/godotengine/godot/pull/119932#pullrequestreview-4491158214","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/119932","author_association":"MEMBER","_links":{"html":{"href":"https://github.com/godotengine/godot/pull/119932#pullrequestreview-4491158214"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/119932"}},"submitted_at":"2026-06-13T08:31:15Z","commit_id":"a7ef3cc3b8df0239daa095816b6aabee56431631"},{"id":4677937147,"node_id":"PRR_kwDOAO6SJc8AAAABFtOn-w","user":{"login":"Ivorforce","id":2308167,"node_id":"MDQ6VXNlcjIzMDgxNjc=","avatar_url":"https://avatars.githubusercontent.com/u/2308167?u=f7f8e0273f784f5ec6f6b7fe4a88d449896eb48a&v=4","gravatar_id":"","url":"https://api.github.com/users/Ivorforce","html_url":"https://github.com/Ivorforce","followers_url":"https://api.github.com/users/Ivorforce/followers","following_url":"https://api.github.com/users/Ivorforce/following{/other_user}","gists_url":"https://api.github.com/users/Ivorforce/gists{/gist_id}","starred_url":"https://api.github.com/users/Ivorforce/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Ivorforce/subscriptions","organizations_url":"https://api.github.com/users/Ivorforce/orgs","repos_url":"https://api.github.com/users/Ivorforce/repos","events_url":"https://api.github.com/users/Ivorforce/events{/privacy}","received_events_url":"https://api.github.com/users/Ivorforce/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"Have only reviewed the code at a glance so I can't approve.\n\nHowever, regarding `CALL_ERROR_INVALID_METHOD`: I don't think there should be a problem with using that.\nThe enum case is already used in various different ways, so this should not add significant new complexity.\nOn a theoretical level, maybe rejecting a call to an abstract constructor should throw a kind of \"protected function call\" error — clearly the method is valid if a subclass can call it. But we don't really have a use case for introducing a new case.\n\nOverall, let's merge it.","state":"COMMENTED","html_url":"https://github.com/godotengine/godot/pull/119932#pullrequestreview-4677937147","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/119932","author_association":"MEMBER","_links":{"html":{"href":"https://github.com/godotengine/godot/pull/119932#pullrequestreview-4677937147"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/119932"}},"submitted_at":"2026-07-11T13:51:01Z","commit_id":"a7ef3cc3b8df0239daa095816b6aabee56431631"}]