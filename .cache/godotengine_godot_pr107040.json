d`.\r\n\r\nUsage example:\r\n\r\n```gdscript\r\nfunc _task_func(_index):\r\n\t# do stuff\r\n\tOS.delay_msec(10)\r\n\t# call cleanup\r\n\tvar id = WorkerThreadPool.get_caller_group_id()\r\n\tcall_deferred(\"_cleanup_func\", id)\r\n\t\r\nfunc _cleanup_func(id):\r\n\t# response to single task completion (e.g, update progress bar)\r\n\tif WorkerThreadPool.is_group_task_completed(id):\r\n\t\tWorkerThreadPool.wait_for_group_task_completion(id)\r\n\t\tprint(\"task group %d is done\" % id)\r\n\r\nfunc _ready() -> void:\r\n\tWorkerThreadPool.add_group_task(_task_func, 200, -1, false, \"test group\")\r\n```","labels":[{"id":73330066,"node_id":"MDU6TGFiZWw3MzMzMDA2Ng==","url":"https://api.github.com/repos/godotengine/godot/labels/enhancement","name":"enhancement","description":"","color":"aaccff","default":true,"archived_at":null,"archived_by":null},{"id":73330068,"node_id":"MDU6TGFiZWw3MzMzMDA2OA==","url":"https://api.github.com/repos/godotengine/godot/labels/feature%20proposal","name":"feature proposal","description":"","color":"4466ff","default":false,"archived_at":null,"archived_by":null},{"id":279097966,"node_id":"MDU6TGFiZWwyNzkwOTc5NjY=","url":"https://api.github.com/repos/godotengine/godot/labels/topic:core","name":"topic:core","description":"","color":"ffee88","default":false,"archived_at":null,"archived_by":null}],"milestone":{"id":12070367,"node_id":"MI_kwDOAO6SJc4AuC3f","url":"https://api.github.com/repos/godotengine/godot/milestones/22","html_url":"https://github.com/godotengine/godot/milestone/22","labels_url":"https://api.github.com/repos/godotengine/godot/milestones/22/labels","number":22,"state":"closed","title":"4.5","description":"","creator":{"login":"Sauermann","id":6299227,"node_id":"MDQ6VXNlcjYyOTkyMjc=","avatar_url":"https://avatars.githubusercontent.com/u/6299227?v=4","gravatar_id":"","url":"https://api.github.com/users/Sauermann","html_url":"https://github.com/Sauermann","followers_url":"https://api.github.com/users/Sauermann/followers","following_url