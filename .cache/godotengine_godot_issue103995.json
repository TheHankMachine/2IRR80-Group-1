hived_by":null}],"state":"open","locked":false,"assignees":[],"milestone":{"url":"https://api.github.com/repos/godotengine/godot/milestones/16","html_url":"https://github.com/godotengine/godot/milestone/16","labels_url":"https://api.github.com/repos/godotengine/godot/milestones/16/labels","id":8237783,"node_id":"MI_kwDOAO6SJc4AfbLX","number":16,"title":"4.x","description":"Issues and pull requests slated for an undetermined Godot 4 release.","creator":{"login":"akien-mga","id":4701338,"node_id":"MDQ6VXNlcjQ3MDEzMzg=","avatar_url":"https://avatars.githubusercontent.com/u/4701338?v=4","gravatar_id":"","url":"https://api.github.com/users/akien-mga","html_url":"https://github.com/akien-mga","followers_url":"https://api.github.com/users/akien-mga/followers","following_url":"https://api.github.com/users/akien-mga/following{/other_user}","gists_url":"https://api.github.com/users/akien-mga/gists{/gist_id}","starred_url":"https://api.github.com/users/akien-mga/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/akien-mga/subscriptions","organizations_url":"https://api.github.com/users/akien-mga/orgs","repos_url":"https://api.github.com/users/akien-mga/repos","events_url":"https://api.github.com/users/akien-mga/events{/privacy}","received_events_url":"https://api.github.com/users/akien-mga/received_events","type":"User","user_view_type":"public","site_admin":false},"open_issues":5790,"closed_issues":0,"state":"open","created_at":"2022-07-26T12:42:05Z","updated_at":"2026-10-22T08:16:48Z","due_on":null,"closed_at":null},"comments":2,"created_at":"2025-03-11T22:28:26Z","updated_at":"2026-09-29T12:54:40Z","closed_at":null,"assignee":null,"author_association":"CONTRIBUTOR","issue_field_values":[],"type":null,"active_lock_reason":null,"draft":false,"pull_request":{"url":"https://api.github.com/repos/godotengine/godot/pulls/103995","html_url":"https://github.com/godotengine/godot/pull/103995","diff_url":"https://github.com/godotengine/godot/pull/103995.diff","patch_url":"https://github.com/godotengine/godot/pull/103995.patch","merged_at":null},"body":"Some of the `CHECK_SPACE` calls seem to be off by one. To read `code[ip + x]` within an opcode, `CHECK_SPACE(x + 1)` has to have been verified to ensure a read doesn't occur out of bounds.\r\n\r\n---\r\n\r\nA good already well-behaving opcode is `OPCODE_TYPE_TEST_BUILTIN`, it looks like this:\r\n```\r\n0: OPCODE_TYPE_TEST_BUILTIN\r\n1: <destination>\r\n2: <value>\r\n3: <builtin type>\r\n```\r\nIt only ever reads up to `code[ip + 3]` and does `CHECK_SPACE(4)` to make sure it is safe.\r\n\r\n---\r\n\r\nThe `LOAD_INSTRUCTION_ARGS` opcodes also have a similar off by one because they have to read `[opcode][argc][arg0][arg1]...`. Even though the IP has been advanced by that macro it still has to `+1` for stepping over `[argc]` in the same way as it would have for `[opcode]`. So I also fixed those in the same manner.","closed_by":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/103995/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/godotengine/godot/issues/103995/timeline","performed_via_github_app":null,"state_reason":null}