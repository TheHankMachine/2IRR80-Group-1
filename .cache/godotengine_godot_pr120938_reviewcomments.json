120938"}},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/3523564632/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":null,"original_line":2746,"side":"RIGHT","in_reply_to_id":3523512212,"author_association":"MEMBER","original_position":4,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/3523665386","pull_request_review_id":4630075269,"id":3523665386,"node_id":"PRRC_kwDOAO6SJc7SBt3q","diff_hunk":"@@ -2743,6 +2743,7 @@ StringName Node::get_property_store_alias(const StringName &p_property) const {\n \n bool Node::is_part_of_edited_scene() const {\n \treturn Engine::get_singleton()->is_editor_hint() && is_inside_tree() && data.tree->get_edited_scene_root() &&\n+\t\t\tdata.tree->get_edited_scene_root()->is_inside_tree() && // Defend against edge cases when creating new scenes and they are not fully added to the tree yet.","path":"scene/main/node.cpp","commit_id":"94e53a59a2e55fca41b08676934f2db8607e2ea8","original_commit_id":"94e53a59a2e55fca41b08676934f2db8607e2ea8","user":{"login":"HolonProduction","id":99511741,"node_id":"U_kgDOBe5tvQ","avatar_url":"https://avatars.githubusercontent.com/u/99511741?v=4","gravatar_id":"","url":"https://api.github.com/users/HolonProduction","html_url":"https://github.com/HolonProduction","followers_url":"https://api.github.com/users/HolonProduction/followers","following_url":"https://api.github.com/users/HolonProduction/following{/other_user}","gists_url":"https://api.github.com/users/HolonProduction/gists{/gist_id}","starred_url":"https://api.github.com/users/HolonProduction/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/HolonProduction/subscriptions","organizations_url":"https://api.github.com/users/HolonProduction/orgs","repos_url":"https://api.github.com/users/HolonProduction/repos","events_url":"https://api.github.com/users/HolonProduction/events{/privacy}","received_events_url":"https://api.github.com/users/HolonProduction/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"So the original reasoning behind the functions is: \"The root of the edited scene is in the scene tree. And the edited scene is not the root of the scene tree. From that follows that `edited_scene_root()->get_parent() != nullptr`.\"\r\n\r\nThis reasoning is correct, but the contract is violated. I check for contract violations, because the inner reasoning seems right to me.\r\n\r\n(Not saying that I care deeply, just trying to explain my thinking about this.)","created_at":"2026-07-04T18:26:26Z","updated_at":"2026-07-04T18:26:26Z","html_url":"https://github.com/godotengine/godot/pull/120938#discussion_r3523665386","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/120938","_links":{"self":{"href":"https://api.github.com/repos/godotengine/godot/pulls/comments/3523665386"},"html":{"href":"https://github.com/godotengine/godot/pull/120938#discussion_r3523665386"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/120938"}},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/3523665386/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":null,"original_line":2746,"side":"RIGHT","in_reply_to_id":3523512212,"author_association":"MEMBER","original_position":4,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/3523675835","pull_request_review_id":4630087990,"id":3523675835,"node_id":"PRRC_kwDOAO6SJc7SBwa7","diff_hunk":"@@ -2743,6 +2743,7 @@ StringName Node::get_property_store_alias(const StringName &p_property) const {\n \n bool Node::is_part_of_edited_scene() const {\n \treturn Engine::get_singleton()->is_editor_hint() && is_inside_tree() && data.tree->get_edited_scene_root() &&\n+\t\t\tdata.tree->get_edited_scene_root()->is_inside_tree() && // Defend against edge cases when creating new scenes and they are not fully added to the tree yet.","path":"scene/main/node.cpp","commit_id":"94e53a59a2e55fca41b08676934f2db8607e2ea8","original_commit_id":"94e53a59a2e55fca41b08676934f2db8607e2ea8","user":{"login":"Ivorforce","id":2308167,"node_id":"MDQ6VXNlcjIzMDgxNjc=","avatar_url":"https://avatars.githubusercontent.com/u/2308167?v=4","gravatar_id":"","url":"https://api.github.com/users/Ivorforce","html_url":"https://github.com/Ivorforce","followers_url":"https://api.github.com/users/Ivorforce/followers","following_url":"https://api.github.com/users/Ivorforce/following{/other_user}","gists_url":"https://api.github.com/users/Ivorforce/gists{/gist_id}","starred_url":"https://api.github.com/users/Ivorforce/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Ivorforce/subscriptions","organizations_url":"https://api.github.com/users/Ivorforce/orgs","repos_url":"https://api.github.com/users/Ivorforce/repos","events_url":"https://api.github.com/users/Ivorforce/events{/privacy}","received_events_url":"https://api.github.com/users/Ivorforce/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"That makes sense to me, but the scene tree is complex and not always internally consistent, especially transiently (as we can see here). In a similar way, `get_parent()` might transiently be `nullptr` because of a bug. That might be even worse than the contract violated here and lead to other issues, but I hope you can see the pattern.\r\n\r\nI would keep the code honest and simple: `get_parent()` gets a method called on it, and `get_parent()` isn't always non null, so we check that `get_parent()` is non-null. That way the function should be robust against any kind of unexpected state, and at least won't be the weak link causing Godot to crash.","created_at":"2026-07-04T18:34:11Z","updated_at":"2026-07-04T18:35:49Z","html_url":"https://github.com/godotengine/godot/pull/120938#discussion_r3523675835","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/120938","_links":{"self":{"href":"https://api.github.com/repos/godotengine/godot/pulls/comments/3523675835"},"html":{"href":"https://github.com/godotengine/godot/pull/120938#discussion_r3523675835"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/120938"}},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/3523675835/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":null,"original_line":2746,"side":"RIGHT","in_reply_to_id":3523512212,"author_association":"MEMBER","original_position":4,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/3524541944","pull_request_review_id":4630986630,"id":3524541944,"node_id":"PRRC_kwDOAO6SJc7SFD34","diff_hunk":"@@ -2743,6 +2743,7 @@ StringName Node::get_property_store_alias(const StringName &p_property) const {\n \n bool Node::is_part_of_edited_scene() const {\n \treturn Engine::get_singleton()->is_editor_hint() && is_inside_tree() && data.tree->get_edited_scene_root() &&\n+\t\t\tdata.tree->get_edited_scene_root()->is_inside_tree() && // Defend against edge cases when creating new scenes and they are not fully added to the tree yet.","path":"scene/main/node.cpp","commit_id":"94e53a59a2e55fca41b08676934f2db8607e2ea8","original_commit_id":"94e53a59a2e55fca41b08676934f2db8607e2ea8","user":{"login":"HolonProduction","id":99511741,"node_id":"U_kgDOBe5tvQ","avatar_url":"https://avatars.githubusercontent.com/u/99511741?v=4","gravatar_id":"","url":"https://api.github.com/users/HolonProduction","html_url":"https://github.com/HolonProduction","followers_url":"https://api.github.com/users/HolonProduction/followers","following_url":"https://api.github.com/users/HolonProduction/following{/other_user}","gists_url":"https://api.github.com/users/HolonProduction/gists{/gist_id}","starred_url":"https://api.github.com/users/HolonProduction/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/HolonProduction/subscriptions","organizations_url":"https://api.github.com/users/HolonProduction/orgs","repos_url":"https://api.github.com/users/HolonProduction/repos","events_url":"https://api.github.com/users/HolonProduction/events{/privacy}","received_events_url":"https://api.github.com/users/HolonProduction/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"Changed to `get_parent()`, since I think it's fine in this case.\r\n\r\nOn a more general note, I think writing all stuff very defensive is an issue for Godot specifically. We have zero docs, the only way architectural contracts are communicated to new contributors is through code. If every function would be highly defensive, this knowledge transfer would be broken entirely.","created_at":"2026-07-05T08:15:31Z","updated_at":"2026-07-05T08:15:32Z","html_url":"https://github.com/godotengine/godot/pull/120938#discussion_r3524541944","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/120938","_links":{"self":{"href":"https://api.github.com/repos/godotengine/godot/pulls/comments/3524541944"},"html":{"href":"https://github.com/godotengine/godot/pull/120938#discussion_r3524541944"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/120938"}},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/3524541944/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":null,"original_line":2746,"side":"RIGHT","in_reply_to_id":3523512212,"author_association":"MEMBER","original_position":4,"position":1,"subject_type":"line"}]