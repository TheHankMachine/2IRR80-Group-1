_R8G8B8A8_SRGB\n    var tex_rid := rd.texture_create(format, RDTextureView.new())\n\n    var tex := Texture2DRD.new()\n    tex.texture_rd_rid = tex_rid\n\n    var tex1 := RenderingServer.texture_rd_create(tex_rid)\n\n```\n\n### Minimal reproduction project (MRP)\n\n[texture-rd-srgb.zip](https://github.com/user-attachments/files/20262938/texture-rd-srgb.zip)","closed_by":{"login":"beicause","id":75941842,"node_id":"MDQ6VXNlcjc1OTQxODQy","avatar_url":"https://avatars.githubusercontent.com/u/75941842?v=4","gravatar_id":"","url":"https://api.github.com/users/beicause","html_url":"https://github.com/beicause","followers_url":"https://api.github.com/users/beicause/followers","following_url":"https://api.github.com/users/beicause/following{/other_user}","gists_url":"https://api.github.com/users/beicause/gists{/gist_id}","starred_url":"https://api.github.com/users/beicause/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/beicause/subscriptions","organizations_url":"https://api.github.com/users/beicause/orgs","repos_url":"https://api.github.com/users/beicause/repos","events_url":"https://api.github.com/users/beicause/events{/privacy}","received_events_url":"https://api.github.com/users/beicause/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/106515/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/godotengine/godot/issues/106515/timeline","performed_via_github_app":null,"state_reason":"completed","pinned_comment":null}