-0.3122, -1.0118]\r\n    ]),\r\n\r\n    numpy.array([\r\n        [ 1.8990,  0.5530, -1.1673,  0.6567],\r\n        [-0.2714,  0.4484,  0.0919, -1.2759],\r\n        [-0.4776, -0.2262, -0.9453,  0.2290],\r\n        [ 0.0787,  1.2056, -2.3572, -2.5827]\r\n    ]),\r\n\r\n    numpy.array([[-0.4147, -0.3705, -0.0413,  0.0948]])\r\n]\r\n\r\nbiases = [\r\n    numpy.array([-0.8684,  0.8291, -0.0538,  1.0117]),\r\n    numpy.array([ 0.8023, -0.4343, -0.2439,  0.4538]),\r\n    numpy.array([0.7001])\r\n]\r\n\r\ndef lookup(x, y):\r\n    v = numpy.array([x,y])\r\n    for i in range(len(mats)):\r\n        temp = biases[i] + (mats[i] @ v)\r\n        v = temp * temp * temp\r\n    return v[0]\r\n```\r\n\r\nThis can be unrolled into a handful of multiplications in GLSL.","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5643219718/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null}]