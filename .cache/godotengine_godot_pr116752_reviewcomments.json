[{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/2852575203","pull_request_review_id":3853757414,"id":2852575203,"node_id":"PRRC_kwDOAO6SJc6qBtfj","diff_hunk":"@@ -195,7 +195,7 @@ void main() {\n #else\n \tcube_normal.z = -1.0;\n \tcube_normal.x = (uv_interp.x + projection.x) / projection.y;","path":"drivers/gles3/shaders/sky.glsl","commit_id":"2c49923c3935d45c43a974aef903a466898b664a","original_commit_id":"2c49923c3935d45c43a974aef903a466898b664a","user":{"login":"BastiaanOlij","id":1945449,"node_id":"MDQ6VXNlcjE5NDU0NDk=","avatar_url":"https://avatars.githubusercontent.com/u/1945449?v=4","gravatar_id":"","url":"https://api.github.com/users/BastiaanOlij","html_url":"https://github.com/BastiaanOlij","followers_url":"https://api.github.com/users/BastiaanOlij/followers","following_url":"https://api.github.com/users/BastiaanOlij/following{/other_user}","gists_url":"https://api.github.com/users/BastiaanOlij/gists{/gist_id}","starred_url":"https://api.github.com/users/BastiaanOlij/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/BastiaanOlij/subscriptions","organizations_url":"https://api.github.com/users/BastiaanOlij/orgs","repos_url":"https://api.github.com/users/BastiaanOlij/repos","events_url":"https://api.github.com/users/BastiaanOlij/events{/privacy}","received_events_url":"https://api.github.com/users/BastiaanOlij/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"One small remark here, and also for the same calculation in the render device version of this shader. We're doing an addition here which is counter intuitive because for un-projecting you would expect to subtract.\r\n\r\nBut we have to remember that originally we project our vertex by doing ` + z * projection[2][0]` and we are looking in the z- direction. So we end up with ` + -1.0 * projection[2][0]` which means we need to do ` - -1.0 * projection[2][0]` to un-project. Hence ` + projection[2][0]`...\r\n\r\nAlso very counter intuitive is the order in which we've stored our projection matrix entries into our vector, yes `projection.x` stores `projection[2][0]` while `projection.y` stores `projection[0][0]`.\r\n\r\nJust interesting info to have for prosperity :)","created_at":"2026-02-25T11:48:51Z","updated_at":"2026-02-25T11:49:11Z","html_url":"https://github.com/godotengine/godot/pull/116752#discussion_r2852575203","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/116752","_links":{"self":{"href":"https://api.github.com/repos/godotengine/godot/pulls/comments/2852575203"},"html":{"href":"https://github.com/godotengine/godot/pull/116752#discussion_r2852575203"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/116752"}},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/2852575203/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":197,"original_line":197,"side":"RIGHT","author_association":"CONTRIBUTOR","original_position":3,"position":3,"subject_type":"line"}]