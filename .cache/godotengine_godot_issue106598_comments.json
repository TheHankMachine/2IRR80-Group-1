thub.com/users/akien-mga/following{/other_user}","gists_url":"https://api.github.com/users/akien-mga/gists{/gist_id}","starred_url":"https://api.github.com/users/akien-mga/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/akien-mga/subscriptions","organizations_url":"https://api.github.com/users/akien-mga/orgs","repos_url":"https://api.github.com/users/akien-mga/repos","events_url":"https://api.github.com/users/akien-mga/events{/privacy}","received_events_url":"https://api.github.com/users/akien-mga/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-05-19T16:47:40Z","updated_at":"2025-05-19T16:47:40Z","body":"Symptom wise yes, but technically it's not a regression, it's a bug in a new feature: multiple window support for Wayland.\nIf you enable single-window mode (which is the only option for Wayland in 4.4), it should behave again like in 4.4.\n\nCC @Riteo ","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2891668025/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2891689750","html_url":"https://github.com/godotengine/godot/issues/106598#issuecomment-2891689750","issue_url":"https://api.github.com/repos/godotengine/godot/issues/106598","id":2891689750,"node_id":"IC_kwDOAO6SJc6sW68W","user":{"login":"Damglador","id":52221087,"node_id":"MDQ6VXNlcjUyMjIxMDg3","avatar_url":"https://avatars.githubusercontent.com/u/52221087?v=4","gravatar_id":"","url":"https://api.github.com/users/Damglador","html_url":"https://github.com/Damglador","followers_url":"https://api.github.com/users/Damglador/followers","following_url":"https://api.github.com/users/Damglador/following{/other_user}","gists_url":"https://api.github.com/users/Damglador/gists{/gist_id}","starred_url":"https://api.github.com/users/Damglador/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Damglador/subscriptions","organizations_url":"https://api.github.com/users/Damglador/orgs","repos_url":"https://api.github.com/users/Damglador/repos","events_url":"https://api.github.com/users/Damglador/events{/privacy}","received_events_url":"https://api.github.com/users/Damglador/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-05-19T16:55:36Z","updated_at":"2025-05-19T17:00:13Z","body":"> If you enable single-window mode\n\nHmm, I already had single window mode enabled, but disabling it does fix the issue (popups can go outside of window, but avoid going outside of screen). Though with it disabled, it prints `ERROR: Popup flag can't changed while window is opened.` in the log every time a popup is closed.","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2891689750/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2892174260","html_url":"https://github.com/godotengine/godot/issues/106598#issuecomment-2892174260","issue_url":"https://api.github.com/repos/godotengine/godot/issues/106598","id":2892174260,"node_id":"IC_kwDOAO6SJc6sYxO0","user":{"login":"akien-mga","id":4701338,"node_id":"MDQ6VXNlcjQ3MDEzMzg=","avatar_url":"https://avatars.githubusercontent.com/u/4701338?v=4","gravatar_id":"","url":"https://api.github.com/users/akien-mga","html_url":"https://github.com/akien-mga","followers_url":"https://api.github.com/users/akien-mga/followers","following_url":"https://api.github.com/users/akien-mga/following{/other_user}","gists_url":"https://api.github.com/users/akien-mga/gists{/gist_id}","starred_url":"https://api.github.com/users/akien-mga/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/akien-mga/subscriptions","organizations_url":"https://api.github.com/users/akien-mga/orgs","repos_url":"https://api.github.com/users/akien-mga/repos","events_url":"https://api.github.com/users/akien-mga/events{/privacy}","received_events_url":"https://api.github.com/users/akien-mga/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-05-19T20:21:23Z","updated_at":"2025-05-19T20:21:23Z","body":"> > If you enable single-window mode\n> \n> Hmm, I already had single window mode enabled, but disabling it does fix the issue (popups can go outside of window, but avoid going outside of screen). Though with it disabled, it prints `ERROR: Popup flag can't changed while window is opened.` in the log every time a popup is closed.\n\nThat's pretty weird, but I can reproduce it indeed. Seems like the single/multi window logic for Wayland is inverted @Riteo.","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2892174260/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2892445767","html_url":"https://github.com/godotengine/godot/issues/106598#issuecomment-2892445767","issue_url":"https://api.github.com/repos/godotengine/godot/issues/106598","id":2892445767,"node_id":"IC_kwDOAO6SJc6sZzhH","user":{"login":"deralmas","id":31065808,"node_id":"MDQ6VXNlcjMxMDY1ODA4","avatar_url":"https://avatars.githubusercontent.com/u/31065808?v=4","gravatar_id":"","url":"https://api.github.com/users/deralmas","html_url":"https://github.com/deralmas","followers_url":"https://api.github.com/users/deralmas/followers","following_url":"https://api.github.com/users/deralmas/following{/other_user}","gists_url":"https://api.github.com/users/deralmas/gists{/gist_id}","starred_url":"https://api.github.com/users/deralmas/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/deralmas/subscriptions","organizations_url":"https://api.github.com/users/deralmas/orgs","repos_url":"https://api.github.com/users/deralmas/repos","events_url":"https://api.github.com/users/deralmas/events{/privacy}","received_events_url":"https://api.github.com/users/deralmas/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-05-19T22:42:13Z","updated_at":"2025-05-19T22:42:13Z","body":"Hi, I think I know what's going on: since the compositor expects to do the fitting itself and we don't have enough data, I disabled any form of self-fitting based on the presence of a new `SELF_FITTING_WINDOWS` feature... but I kinda forgot to re-enable it in single-window mode 😅\n\nI think the fix should be quite trivial and I'll take a look soon :D","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2892445767/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2896185221","html_url":"https://github.com/godotengine/godot/issues/106598#issuecomment-2896185221","issue_url":"https://api.github.com/repos/godotengine/godot/issues/106598","id":2896185221,"node_id":"IC_kwDOAO6SJc6soEeF","user":{"login":"deralmas","id":31065808,"node_id":"MDQ6VXNlcjMxMDY1ODA4","avatar_url":"https://avatars.githubusercontent.com/u/31065808?v=4","gravatar_id":"","url":"https://api.github.com/users/deralmas","html_url":"https://github.com/deralmas","followers_url":"https://api.github.com/users/deralmas/followers","following_url":"https://api.github.com/users/deralmas/following{/other_user}","gists_url":"https://api.github.com/users/deralmas/gists{/gist_id}","starred_url":"https://api.github.com