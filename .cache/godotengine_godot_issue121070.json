scription":"","archived_at":null,"archived_by":null},{"id":4332209698,"node_id":"LA_kwDOAO6SJc8AAAABAjhGIg","url":"https://api.github.com/repos/godotengine/godot/labels/topic:multiplayer","name":"topic:multiplayer","color":"ffee88","default":false,"description":"","archived_at":null,"archived_by":null}],"state":"open","locked":false,"assignees":[],"milestone":{"url":"https://api.github.com/repos/godotengine/godot/milestones/16","html_url":"https://github.com/godotengine/godot/milestone/16","labels_url":"https://api.github.com/repos/godotengine/godot/milestones/16/labels","id":8237783,"node_id":"MI_kwDOAO6SJc4AfbLX","number":16,"title":"4.x","description":"Issues and pull requests slated for an undetermined Godot 4 release.","creator":{"login":"akien-mga","id":4701338,"node_id":"MDQ6VXNlcjQ3MDEzMzg=","avatar_url":"https://avatars.githubusercontent.com/u/4701338?v=4","gravatar_id":"","url":"https://api.github.com/users/akien-mga","html_url":"https://github.com/akien-mga","followers_url":"https://api.github.com/users/akien-mga/followers","following_url":"https://api.github.com/users/akien-mga/following{/other_user}","gists_url":"https://api.github.com/users/akien-mga/gists{/gist_id}","starred_url":"https://api.github.com/users/akien-mga/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/akien-mga/subscriptions","organizations_url":"https://api.github.com/users/akien-mga/orgs","repos_url":"https://api.github.com/users/akien-mga/repos","events_url":"https://api.github.com/users/akien-mga/events{/privacy}","received_events_url":"https://api.github.com/users/akien-mga/received_events","type":"User","user_view_type":"public","site_admin":false},"open_issues":5791,"closed_issues":0,"state":"open","created_at":"2022-07-26T12:42:05Z","updated_at":"2026-10-21T22:40:26Z","due_on":null,"closed_at":null},"comments":0,"created_at":"2026-07-08T00:55:34Z","updated_at":"2026-07-22T20:14:01Z","closed_at":null,"assignee":null,"author_association":"CONTRIBUTOR","issue_field_values":[],"type":null,"active_lock_reason":null,"draft":false,"pull_request":{"url":"https://api.github.com/repos/godotengine/godot/pulls/121070","html_url":"https://github.com/godotengine/godot/pull/121070","diff_url":"https://github.com/godotengine/godot/pull/121070.diff","patch_url":"https://github.com/godotengine/godot/pull/121070.patch","merged_at":null},"body":"## What problem(s) does this PR solve?\r\n`MultiplayerSynchronizer` internally owns a `SceneReplicationConfig` resource that is not exposed in the Inspector and can only be edited through its custom editor plugin.\r\n\r\nAs a result, inherited `MultiplayerSynchronizer` nodes silently share the same `SceneReplicationConfig` resource as the base scene. Since the resource is hidden, this shared ownership is not obvious, making it difficult to understand the behavior or customize the configuration for inherited scenes without modifying the base scene.\r\n\r\n---\r\n\r\n## Solution\r\nThis PR refactors the `SceneReplicationConfig` editor plugin and extends its functionality to support editing `SceneReplicationConfig` resources directly.\r\n\r\nIt also exposes the `SceneReplicationConfig` resource in the `MultiplayerSynchronizer` Inspector, making resource ownership visible and consistent with other Godot resources. Inherited scenes continue to share the resource by default, but it is read-only while inherited. As with other exported resources, users can make it unique or assign a new `SceneReplicationConfig` resource to edit it independently without affecting the base scene.\r\n\r\n---\r\n\r\n## Demonstration\r\n\r\n[The video showing the usage (youtube 4min).](https://youtu.be/ZP4awdmYVcs)\r\n\r\n### Help\r\nThis PR is based on the proposal discussed here: https://github.com/godotengine/godot-proposals/issues/15236. If you like the idea, reacting to the proposal with a 👍.\r\n\r\n---\r\n\r\n## Related discussion\r\n\r\n### Issues\r\n\r\n* Closes #120015\r\n* Closes #84793\r\n* Closes #74381\r\n* Closes #80717\r\n* Closes #102459\r\n\r\n## Pull Request\r\n\r\n* #107675\r\n","closed_by":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/121070/reactions","total_count":4,"+1":1,"-1":0,"laugh":0,"hooray":3,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/godotengine/godot/issues/121070/timeline","performed_via_github_app":null,"state_reason":null}