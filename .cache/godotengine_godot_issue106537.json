":false,"description":"","archived_at":null,"archived_by":null},{"id":2666708289,"node_id":"MDU6TGFiZWwyNjY2NzA4Mjg5","url":"https://api.github.com/repos/godotengine/godot/labels/topic:3d","name":"topic:3d","color":"ffee88","default":false,"description":"","archived_at":null,"archived_by":null}],"state":"closed","locked":false,"assignees":[],"milestone":{"url":"https://api.github.com/repos/godotengine/godot/milestones/22","html_url":"https://github.com/godotengine/godot/milestone/22","labels_url":"https://api.github.com/repos/godotengine/godot/milestones/22/labels","id":12070367,"node_id":"MI_kwDOAO6SJc4AuC3f","number":22,"title":"4.5","description":"","creator":{"login":"Sauermann","id":6299227,"node_id":"MDQ6VXNlcjYyOTkyMjc=","avatar_url":"https://avatars.githubusercontent.com/u/6299227?v=4","gravatar_id":"","url":"https://api.github.com/users/Sauermann","html_url":"https://github.com/Sauermann","followers_url":"https://api.github.com/users/Sauermann/followers","following_url":"https://api.github.com/users/Sauermann/following{/other_user}","gists_url":"https://api.github.com/users/Sauermann/gists{/gist_id}","starred_url":"https://api.github.com/users/Sauermann/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Sauermann/subscriptions","organizations_url":"https://api.github.com/users/Sauermann/orgs","repos_url":"https://api.github.com/users/Sauermann/repos","events_url":"https://api.github.com/users/Sauermann/events{/privacy}","received_events_url":"https://api.github.com/users/Sauermann/received_events","type":"User","user_view_type":"public","site_admin":false},"open_issues":3,"closed_issues":3687,"state":"closed","created_at":"2024-12-19T08:51:28Z","updated_at":"2026-09-04T21:48:38Z","due_on":"2025-09-15T00:00:00Z","closed_at":"2025-09-18T17:13:14Z"},"comments":2,"created_at":"2025-05-17T20:00:44Z","updated_at":"2025-06-22T23:35:43Z","closed_at":"2025-06-10T10:35:43Z","assignee":null,"author_association":"MEMBER","issue_field_values":[],"type":null,"active_lock_reason":null,"draft":false,"pull_request":{"url":"https://api.github.com/repos/godotengine/godot/pulls/106537","html_url":"https://github.com/godotengine/godot/pull/106537","diff_url":"https://github.com/godotengine/godot/pull/106537.diff","patch_url":"https://github.com/godotengine/godot/pull/106537.patch","merged_at":"2025-06-10T10:35:43Z"},"body":"Fixes #106073, fixes #93758, fixes #96248. This restores the behavior in Godot 4.2 and earlier.\r\n\r\nThis PR makes the unique name feature no longer apply cross-skeleton. Skeleton bones now need to be unique within the same skeleton and compared to scene nodes, but not compared to all skeletons in the scene node.\r\n\r\nThis only affects glTF files with multiple skeletons in it, which is a niche use case, so this is low-risk. Users of this feature expect to be able to use the same bone map for each skeleton for animation targeting.\r\n\r\nNote: This PR makes it possible to generate multiple nodes with the same name in the case of BoneAttachment3D nodes, since they are given the same name as the bone they are attached to. I think this is fine, and the alternatives are worse.\r\n\r\nNote: This PR does not affect export. A comment introduced in PR #53114 indicates the current export behavior of having all glTF nodes including bones be unique was intentional. We could change the export behavior too, though.\r\n\r\n~~Note: This PR adds a `duplicate()` function to HashSet, because I needed to duplicate a HashSet.~~","closed_by":{"login":"akien-mga","id":4701338,"node_id":"MDQ6VXNlcjQ3MDEzMzg=","avatar_url":"https://avatars.githubusercontent.com/u/4701338?v=4","gravatar_id":"","url":"https://api.github.com/users/akien-mga","html_url":"https://github.com/akien-mga","followers_url":"https://api.github.com/users/akien-mga/followers","following_url":"https://api.github.com/users/akien-mga/following{/other_user}","gists_url":"https://api.github.com/users/akien-mga/gists{/gist_id}","starred_url":"https://ap