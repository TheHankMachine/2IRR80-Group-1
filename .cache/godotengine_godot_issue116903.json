_by":null},{"id":279098009,"node_id":"MDU6TGFiZWwyNzkwOTgwMDk=","url":"https://api.github.com/repos/godotengine/godot/labels/topic:buildsystem","name":"topic:buildsystem","color":"ffee88","default":false,"description":"","archived_at":null,"archived_by":null},{"id":2304948121,"node_id":"MDU6TGFiZWwyMzA0OTQ4MTIx","url":"https://api.github.com/repos/godotengine/godot/labels/topic:codestyle","name":"topic:codestyle","color":"ffee88","default":false,"description":"","archived_at":null,"archived_by":null}],"state":"open","locked":false,"assignees":[],"milestone":{"url":"https://api.github.com/repos/godotengine/godot/milestones/16","html_url":"https://github.com/godotengine/godot/milestone/16","labels_url":"https://api.github.com/repos/godotengine/godot/milestones/16/labels","id":8237783,"node_id":"MI_kwDOAO6SJc4AfbLX","number":16,"title":"4.x","description":"Issues and pull requests slated for an undetermined Godot 4 release.","creator":{"login":"akien-mga","id":4701338,"node_id":"MDQ6VXNlcjQ3MDEzMzg=","avatar_url":"https://avatars.githubusercontent.com/u/4701338?v=4","gravatar_id":"","url":"https://api.github.com/users/akien-mga","html_url":"https://github.com/akien-mga","followers_url":"https://api.github.com/users/akien-mga/followers","following_url":"https://api.github.com/users/akien-mga/following{/other_user}","gists_url":"https://api.github.com/users/akien-mga/gists{/gist_id}","starred_url":"https://api.github.com/users/akien-mga/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/akien-mga/subscriptions","organizations_url":"https://api.github.com/users/akien-mga/orgs","repos_url":"https://api.github.com/users/akien-mga/repos","events_url":"https://api.github.com/users/akien-mga/events{/privacy}","received_events_url":"https://api.github.com/users/akien-mga/received_events","type":"User","user_view_type":"public","site_admin":false},"open_issues":5791,"closed_issues":0,"state":"open","created_at":"2022-07-26T12:42:05Z","updated_at":"2026-10-21T22:40:26Z","due_on":null,"closed_at":null},"comments":3,"created_at":"2026-02-28T20:55:15Z","updated_at":"2026-03-02T17:10:47Z","closed_at":null,"assignee":null,"author_association":"CONTRIBUTOR","issue_field_values":[],"type":null,"active_lock_reason":null,"draft":false,"pull_request":{"url":"https://api.github.com/repos/godotengine/godot/pulls/116903","html_url":"https://github.com/godotengine/godot/pull/116903","diff_url":"https://github.com/godotengine/godot/pull/116903.diff","patch_url":"https://github.com/godotengine/godot/pull/116903.patch","merged_at":null},"body":"- Related #102242\r\n\r\nRémi's harmonization PR was fantastic for the repository as a whole, as it addressed some of the biggest pain-points when it came to maintaining third-party code. Now that we're over a year-out from that PR being merged, two minor annoyances/inconsistencies have cropped up:\r\n1. Indexes would occasionally clash across different PRs, even if the sections of third-party code changed were completely different. This clash can be indirect if a patch was removed, causing a gap in the existing index\r\n2. No uniform naming scheme meant that there were a few `CamelCase` and `snake_case` clashing with the more prominent `kebab-case`\r\n\r\nAs this has yet to be fully formalized, there's still time to make adjustments before this concept is locked-in. As such, this PR aims to address both pain areas explicitly, utilizing the following changes:\r\n- Patches will now be indexed by Pull Request id, rather than on a per-thirdparty basis.\r\n- Unified the naming convention as `GH-#####.snake_case.patch`.\r\n\r\nThis mirrors how we order separate api validator files (`GH-#####.txt`), and will guarantee that unrelated PRs will no longer clash by index number, nor will they have to re-sync their indices if other patches are removed. It also simplifies the documentation, as the `patch (GH-#####)` syntax is now unified; clicking the patch will take you directly to the GitHub PR that introduced it\r\n\r\nFinally, the documentation was adjusted to list patch files that were previously missing. The most extreme case was for rvo2, whose patch file was *removed* altogether; that's since been manually re-synced against the PR that performed the 2d/3d split","closed_by":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/116903/reactions","total_count":1,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":1,"eyes":0},"timeline_url":"https://api.github.com/repos/godotengine/godot/issues/116903/timeline","performed_via_github_app":null,"state_reason":null}