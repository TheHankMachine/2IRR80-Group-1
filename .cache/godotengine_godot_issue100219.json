ive_lock_reason":null,"draft":false,"pull_request":{"url":"https://api.github.com/repos/godotengine/godot/pulls/100219","html_url":"https://github.com/godotengine/godot/pull/100219","diff_url":"https://github.com/godotengine/godot/pull/100219.diff","patch_url":"https://github.com/godotengine/godot/pull/100219.patch","merged_at":"2026-01-28T18:33:11Z"},"body":"Currently the save_zip method in editor_export_platform.cpp will silently swallow any errors produced during the zip exporting process, and just report that everything is fine to the callers, while leaving messages on the error log.   But the higher levels can not react to this.\r\n\r\nThis makes it report the error to the callers, similar to what the the `save_pack` method does in the same class.\r\n\r\nIt does look like this is just a historical artifact left from the day it was first stubbed out.","closed_by":{"login":"Repiteo","id":17489292,"node_id":"MDQ6VXNlcjE3NDg5Mjky","avatar_url":"https://avatars.githubusercontent.com/u/17489292?v=4","gravatar_id":"","url":"https://api.github.com/users/Repiteo","html_url":"https://github.com/Repiteo","followers_url":"https://api.github.com/users/Repiteo/followers","following_url":"https://api.github.com/users/Repiteo/following{/other_user}","gists_url":"https://api.github.com/users/Repiteo/gists{/gist_id}","starred_url":"https://api.github.com/users/Repiteo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Repiteo/subscriptions","organizations_url":"https://api.github.com/users/Repiteo/orgs","repos_url":"https://api.github.com/users/Repiteo/repos","events_url":"https://api.github.com/users/Repiteo/events{/privacy}","received_events_url":"https://api.github.com/users/Repiteo/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/100219/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_u