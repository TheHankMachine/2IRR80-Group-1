[{"id":3498101833,"node_id":"PRR_kwDOAO6SJc7QgMxJ","state":"COMMENTED","user":{"site_admin":false,"suspended":false,"updated_at":"0001-01-01T00:00:00Z","avatar_url":"https://avatars.githubusercontent.com/u/2308167?u=f7f8e0273f784f5ec6f6b7fe4a88d449896eb48a&v=4","created_at":"0001-01-01T00:00:00Z","followers":0,"following":0,"html_url":"https://github.com/Ivorforce","id":2308167,"node_id":"MDQ6VXNlcjIzMDgxNjc=","login":"Ivorforce","type":"User","owned_private_repos":0,"public_gists":0,"public_repos":0,"total_private_repos":0,"url":"https://api.github.com/users/Ivorforce"},"body":"I'm a bit sceptical of the performance measurements. While I've also measured `AHashMap` to be pretty susceptible performance wise to small changes (likely because it's already pretty well optimized), I wouldn't expect these kinds of changes to have a very large impact.\r\nPlease make sure you're running fair benchmarks (e.g. by alternating running one or the other first, and making sure they produce consistent results over several runs).\r\n\r\nAnyway, I'm not a compiler, so my estimation I may well be wrong. So I'll probably test it myself when i have some time in the coming days.","html_url":"https://github.com/godotengine/godot/pull/113089#pullrequestreview-3498101833","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/113089","author_association":"MEMBER","submitted_at":"2025-11-24T00:11:26Z"},{"id":3498150185,"node_id":"PRR_kwDOAO6SJc7QgYkp","state":"COMMENTED","user":{"site_admin":false,"suspended":false,"updated_at":"0001-01-01T00:00:00Z","avatar_url":"https://avatars.githubusercontent.com/u/60024671?u=7e327c81e8a9552ea98ca69adcccac4a50657dd9&v=4","created_at":"0001-01-01T00:00:00Z","followers":0,"following":0,"html_url":"https://github.com/DeeJayLSP","id":60024671,"node_id":"MDQ6VXNlcjYwMDI0Njcx","login":"DeeJayLSP","type":"User","owned_private_repos":0,"public_gists":0,"public_repos":0,"total_private_repos":0,"url":"https://api.github.com/users/DeeJayLSP"},"bo