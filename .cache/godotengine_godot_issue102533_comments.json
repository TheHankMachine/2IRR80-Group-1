api.github.com/users/FeralBytes/followers","following_url":"https://api.github.com/users/FeralBytes/following{/other_user}","gists_url":"https://api.github.com/users/FeralBytes/gists{/gist_id}","starred_url":"https://api.github.com/users/FeralBytes/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/FeralBytes/subscriptions","organizations_url":"https://api.github.com/users/FeralBytes/orgs","repos_url":"https://api.github.com/users/FeralBytes/repos","events_url":"https://api.github.com/users/FeralBytes/events{/privacy}","received_events_url":"https://api.github.com/users/FeralBytes/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-03-01T23:58:04Z","updated_at":"2025-03-01T23:58:04Z","body":"@Calinou \n\n![Image](https://github.com/user-attachments/assets/ba5504a0-9b04-4074-a351-68766d970a75)\nThis is a screenshot using 4.4.rc3 exported to the web. Unfortunately it is not fixed.\n\nJust for comparison this is a screenshot using 4.4.beta3:\n\n![Image](https://github.com/user-attachments/assets/1131e3a9-51f4-4bcc-b1be-559a4445fcdd)\n\nBoth images are still the same, so no fixes but also no further breaks.","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2692476179/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2745890398","html_url":"https://github.com/godotengine/godot/issues/102533#issuecomment-2745890398","issue_url":"https://api.github.com/repos/godotengine/godot/issues/102533","id":2745890398,"node_id":"IC_kwDOAO6SJc6jqvZe","user":{"login":"FeralBytes","id":7874274,"node_id":"MDQ6VXNlcjc4NzQyNzQ=","avatar_url":"https://avatars.githubusercontent.com/u/7874274?v=4","gravatar_id":"","url":"https://api.github.com/users/FeralBytes","html_url":"https://github.com/FeralBytes","followers_url":"https://api.github.com/users/FeralBytes/followers","following_url":"https://api.github.com/users/FeralBytes/following{/other_user}","gists_url":"https://api.github.com/users/FeralBytes/gists{/gist_id}","starred_url":"https://api.github.com/users/FeralBytes/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/FeralBytes/subscriptions","organizations_url":"https://api.github.com/users/FeralBytes/orgs","repos_url":"https://api.github.com/users/FeralBytes/repos","events_url":"https://api.github.com/users/FeralBytes/events{/privacy}","received_events_url":"https://api.github.com/users/FeralBytes/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-03-22T22:07:38Z","updated_at":"2025-03-23T12:53:57Z","body":"Good News: 4.4.1.rc2 fixes this issue for VRAM Compressed if you delete the projects .godot folder so that 4.4.1.rc2 re-builds the .godot folder. However it does not fix VRAM High Quality. As you can see in this screen shot.\n\n![Image](https://github.com/user-attachments/assets/9e31aafe-79a6-47c1-9512-48b66d3f70a6)\n\nI believe that #104275  is what resulted in this partial fix. Thank you @bruvzg do you think the same fix can be applied to the High Quality VRAM Compression import?\n\nNote: I double checked 4.4.rc3 by removing the .godot folder and then opening in 4.4.rc3 to allow it to rebuild the files, then exported to the web. But no difference is observed as in still broken. But 4.4.1.rc2 does make a difference and fixes the VRAM Compressed files.","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2745890398/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2746247269","html_url":"https://github.com/godotengine/godot/issues/102533#issuecomment-2746247269","issue_url":"https://api.github.com/repos/godotengine/godot/issues/102533","id":2746247269,"node_id":"IC_kwDOAO6SJc6jsGhl","user":{"login":"bruvzg","id":7645683,"node_id":"MDQ6VXNlcjc2NDU2ODM=","avatar_url":"https://avatars.githubusercontent.com/u/7645683?v=4","gravatar_id":"","url":"https://api.github.com/users/bruvzg","html_url":"https://github.com/bruvzg","followers_url":"https://api.github.com/users/bruvzg/followers","following_url":"https://api.github.com/users/bruvzg/following{/other_user}","gists_url":"https://api.github.com/users/bruvzg/gists{/gist_id}","starred_url":"https://api.github.com/users/bruvzg/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/bruvzg/subscriptions","organizations_url":"https://api.github.com/users/bruvzg/orgs","repos_url":"https://api.github.com/users/bruvzg/repos","events_url":"https://api.github.com/users/bruvzg/events{/privacy}","received_events_url":"https://api.github.com/users/bruvzg/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-03-23T14:31:30Z","updated_at":"2025-03-23T14:31:30Z","body":"> do you think the same fix can be applied to the High Quality VRAM Compression import?\n\nHigh Quality VRAM is BPTC, it is not working in compatibility mode on desktop as well (at least on macOS), and not listed in the supported extension list show by https://www.geeks3d.com/webgl/, so likely simply not supported. Not sure if there's anything to fix.","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2746247269/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2746347416","html_url":"https://github.com/godotengine/godot/issues/102533#issuecomment-2746347416","issue_url":"https://api.github.com/repos/godotengine/godot/issues/102533","id":2746347416,"node_id":"IC_kwDOAO6SJc6jse-Y","user":{"login":"Calinou","id":180032,"node_id":"MDQ6VXNlcjE4MDAzMg==","avatar_url":"https://avatars.githubusercontent.com/u/180032?v=4","gravatar_id":"","url":"https://api.github.com/users/Calinou","html_url":"https://github.com/Calinou","followers_url":"https://api.github.com/users/Calinou/followers","following_url":"https://api.github.com/users/Calinou/following{/other_user}","gists_url":"https://api.github.com/users/Calinou/gists{/gist_id}","starred_url":"https://api.github.com/users/Calinou/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Calinou/subscriptions","organizations_url":"https://api.github.com/users/Calinou/orgs","repos_url":"https://api.github.com/users/Calinou/repos","events_url":"https://api.github.com/users/Calinou/events{/privacy}","received_events_url":"https://api.github.com/users/Calinou/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-03-23T18:09:48Z","updated_at":"2025-03-23T18:09:48Z","body":"> Not sure if there's anything to fix.\n\nI suppose a warning should be printed on import when using high-quality VRAM compression while using Compatibility in a project.\n\nAlso, we should fallback to decompressing the texture on the CPU so you can at least see the texture, even if it won't be optimal in terms of VRAM utilization. (I thought this was already being done though, maybe it's not working correctly for this particular use case?)","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2746347416/reactions","total_count":2,"+1":2,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2747525554","html_url":"https://github.com/godotengine/godot/issues/102533#issuecomment-2747525554","issue_url":"https://api.github.com/repos/godotengine/godot/issues/102533","id":2747525554,"node_id":"IC_kwDOAO6SJc6jw-my","user":{"login":"bruvzg","id":7645683,"node_id":"MDQ6VXNlcjc2NDU2ODM=","avatar_url":"https://avatars.githubusercontent.com/u/7645683?v=4","gravatar_id":"","url":"https://api.github.com/users/bruvzg","html_url":"https://github.com/bruvzg","followers_url":"https://api.github.com/users/bruvzg/followers","following_url":"https://api.github.com/users/bruvzg/following{/other_user}","gists_url":"https://api.github.com/users/bruvzg/gists{/gist_id}","starred_url":"https://api.github.com/users/bruvzg/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/bruvzg/subscriptions","organizations_url":"https://api.github.com/users/bruvzg/orgs","repos_url":"https://api.github.com/users/bruvzg/repos","events_url":"https://api.github.com/users/bruvzg/events{/privacy}","received_events_url":"https://api.github.com/users/bruvzg/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-03-24T09:55:24Z","updated_at":"2025-03-24T09:55:24Z","body":"Chromium seems to support the extension, but still not showing textures. So it might have both the same multiple of 4 issue in `image_compress_cvtt`, and issues with support in browsers.","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2747525554/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2749441077","html_url":"https://github.com/godotengine/godot/issues/102533#issuecomment-2749441077","issue_url":"https://api.github.com/repos/godotengine/godot/issues/102533","id":2749441077,"node_id":"IC_kwDOAO6SJc6j4SQ1","user":{"login":"bruvzg","id":7645683,"node_id":"MDQ6VXNlcjc2NDU2ODM=","avatar_url":"https://avatars.githubusercontent.com/u/7645683?v=4","gravatar_id":"","url":"https://api.github.com/users/bruvzg","html_url":"https://github.com/bruvzg","followers_url":"https://api.github.com/users/bruvzg/followers","following_url":"https://api.github.com/users/bruvzg/following{/other_user}","gists_url":"https://api.github.com/users/bruvzg/gists{/gist_id}","starred_url":"https://api.github.com/users/bruvzg/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/bruvzg/subscriptions","organizations_url":"https://api.github.com/users/bruvzg/orgs","repos_url":"https://api.github.com/users/bruvzg/repos","events_url":"https://api.github.com/users/bruvzg/events{/privacy}","received_events_url":"https://api.github.com/users/bruvzg/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-03-24T21:28:11Z","updated_at":"2025-03-24T21:28:11Z","body":"> So it might have both the same multiple of 4 issue in image_compress_cvtt, and issues with support in browsers.\n\nIt is, applying similar padding to `image_compress_cvtt` fix in Chromium.\n\nBut in Firefox (no BPTC support) it's not even loading textures:\n```\nERROR: No loader found for resource:  (expected type: CompressedTexture2D) [tmp_js_export.js:477:18](http://localhost:8060/tmp_js_export.js)\n   at: _load (core/io/resource_loader.cpp:359)\n```","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2749441077/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2750286286","html_url":"https://github.com/godotengine/godot/issues/102533#issuecomment-2750286286","issue_url":"https://api.github.com/repos/godotengine/godot/issues/102533","id":2750286286,"node_id":"IC_kwDOAO6SJc6j7gnO","user":{"login":"bruvzg","id":7645683,"node_id":"MDQ6VXNlcjc2NDU2ODM=","avatar_url":"https://avatars.githubusercontent.com/u/7645683?v=4","gravatar_id":"","url":"https://api.github.com/users/bruvzg","html_url":"https://github.com/bruvzg","followers_url":"https://api.github.com/users/bruvzg/followers","following_url":"https://api.github.com/users/bruvzg/following{/other_user}","gists_url":"https://api.github.com/users/bruvzg/gists{/gist_id}","starred_url":"https://api.github.com/users/bruvzg/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/bruvzg/subscriptions","organizations_url":"https://api.github.com/users/bruvzg/orgs","repos_url":"https://api.github.com/users/bruvzg/repos","events_url":"https://api.github.com/users/bruvzg/events{/privacy}","received_events_url":"https://api.github.com/users/bruvzg/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-03-25T07:02:56Z","updated_at":"2025-03-25T07:02:56Z","body":"> I thought this was already being done though, maybe it's not working correctly for this particular use case?\n\nThis seems to be broken by how resource loader handle feature tags, if no `bptc` tag is set, it won't try to load texture at all. If it's added manually CPU decompression is working (and textures showing fine in Firefox).","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2750286286/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2750381644","html_url":"https://github.com/godotengine/godot/issues/102533#issuecomment-2750381644","issue_url":"https://api.github.com/repos/godotengine/godot/issues/102533","id":2750381644,"node_id":"IC_kwDOAO6SJc6j735M","user":{"login":"bruvzg","id":7645683,"node_id":"MDQ6VXNlcjc2NDU2ODM=","avatar_url":"https://avatars.githubusercontent.com/u/7645683?v=4","gravatar_id":"","url":"https://api.github.com/users/bruvzg","html_url":"https://github.com/bruvzg","followers_url":"https://api.github.com/users/bruvzg/followers","following_url":"https://api.github.com/users/bruvzg/following{/other_user}","gists_url":"https://api.github.com/users/bruvzg/gists{/gist_id}","starred_url":"https://api.github.com/users/bruvzg/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/bruvzg/subscriptions","organizations_url":"https://api.github.com/users/bruvzg/orgs","repos_url":"https://api.github.com/users/bruvzg/repos","events_url":"https://api.github.com/users/bruvzg/events{/privacy}","received_events_url":"https://api.github.com/users/bruvzg/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-03-25T07:51:19Z","updated_at":"2025-03-25T07:51:19Z","body":"https://github.com/godotengine/godot/pull/104590: fixes loading when BPTC is not support (decompression and use of uncompressed texture).\nhttps://github.com/godotengine/godot/pull/104575: fixes loading when BPTC is support, but texture dimension are not multiple of 4 (same as fix for non High Quality textures, adds padding).","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2750381644/reactions","total_count":2,"+1":0,"-1":0,"laugh":0,"hooray":2,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null}]