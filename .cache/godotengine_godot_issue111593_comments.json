Ships","followers_url":"https://api.github.com/users/AThousandShips/followers","following_url":"https://api.github.com/users/AThousandShips/following{/other_user}","gists_url":"https://api.github.com/users/AThousandShips/gists{/gist_id}","starred_url":"https://api.github.com/users/AThousandShips/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/AThousandShips/subscriptions","organizations_url":"https://api.github.com/users/AThousandShips/orgs","repos_url":"https://api.github.com/users/AThousandShips/repos","events_url":"https://api.github.com/users/AThousandShips/events{/privacy}","received_events_url":"https://api.github.com/users/AThousandShips/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-10-13T14:59:27Z","updated_at":"2025-10-13T14:59:27Z","body":"Yes as I said it makes it more precise, I mentioned it as it might be relevant for fixing the issue, not suggesting a solution\n\nBut this is a pretty specific case which is probably why it hasn't been noticed with this edge case","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3397881499/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3397895701","html_url":"https://github.com/godotengine/godot/issues/111593#issuecomment-3397895701","issue_url":"https://api.github.com/repos/godotengine/godot/issues/111593","id":3397895701,"node_id":"IC_kwDOAO6SJc7Kh8YV","user":{"login":"AThousandShips","id":96648715,"node_id":"U_kgDOBcK-Cw","avatar_url":"https://avatars.githubusercontent.com/u/96648715?v=4","gravatar_id":"","url":"https://api.github.com/users/AThousandShips","html_url":"https://github.com/AThousandShips","followers_url":"https://api.github.com/users/AThousandShips/followers","following_url":"https://api.github.com/users/AThousandShips/following{/other_user}","gists_url":"https://api.github.com/users/AThousandShips/gists{/gist_id}","starred_url":"https://api.github.com/users/AThousandShips/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/AThousandShips/subscriptions","organizations_url":"https://api.github.com/users/AThousandShips/orgs","repos_url":"https://api.github.com/users/AThousandShips/repos","events_url":"https://api.github.com/users/AThousandShips/events{/privacy}","received_events_url":"https://api.github.com/users/AThousandShips/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-10-13T15:03:29Z","updated_at":"2025-10-13T15:05:28Z","body":"Looking at the code this is probably unavoidable as it's due to how the arc is drawn internally, it uses a polyline with the width, so the angle of the end segments depends on the angle of the segment itself\n\nSince it's a polyline each segment is straight, so the end element has the same direction as the tangent at the end minus some angle, imagine making this arc with a bunch of straight pieces of wood, you'd get the same effect\n\nSo the only way to really solve this IMO without breaking other things would be to not use a polyline for drawing the arc\n\nTry lowering the number of points and I think you'll see what I mean","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3397895701/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3397917577","html_url":"https://github.com/godotengine/godot/issues/111593#issuecomment-3397917577","issue_url":"https://api.github.com/repos/godotengine/godot/issues/111593","id":3397917577,"node_id":"IC_kwDOAO6SJc7KiBuJ","user":{"login":"AThousandShips","id":96648715,"node_id":"U_kgDOBcK-Cw","avatar_url":"https://avatars.githubusercontent.com/u/96648715?v=4","gravatar_id":"","url":"https://api.github.com/users/AThousandShips","html_url":"https://github.com/AThousandShips","followers_url":"https://api.github.com/users/AThousandShips/followers","following_url":"https://api.github.com/users/AThousandShips/following{/other_user}","gists_url":"https://api.github.com/users/AThousandShips/gists{/gist_id}","starred_url":"https://api.github.com/users/AThousandShips/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/AThousandShips/subscriptions","organizations_url":"https://api.github.com/users/AThousandShips/orgs","repos_url":"https://api.github.com/users/AThousandShips/repos","events_url":"https://api.github.com/users/AThousandShips/events{/privacy}","received_events_url":"https://api.github.com/users/AThousandShips/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-10-13T15:09:28Z","updated_at":"2025-10-13T15:09:28Z","body":"I think the step for now, unless some simple solution comes around, is to document this limitation as changing this might be very involved otherwise, it could be done as a polygon I think but it's complicated and performance would suffer, so having this behave well and look good *and* perform well especially for thin lines would be important","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3397917577/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3397924972","html_url":"https://github.com/godotengine/godot/issues/111593#issuecomment-3397924972","issue_url":"https://api.github.com/repos/godotengine/godot/issues/111593","id":3397924972,"node_id":"IC_kwDOAO6SJc7KiDhs","user":{"login":"gitsomebit",