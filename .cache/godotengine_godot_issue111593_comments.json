ub.com/users/gitsomebit/followers","following_url":"https://api.github.com/users/gitsomebit/following{/other_user}","gists_url":"https://api.github.com/users/gitsomebit/gists{/gist_id}","starred_url":"https://api.github.com/users/gitsomebit/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/gitsomebit/subscriptions","organizations_url":"https://api.github.com/users/gitsomebit/orgs","repos_url":"https://api.github.com/users/gitsomebit/repos","events_url":"https://api.github.com/users/gitsomebit/events{/privacy}","received_events_url":"https://api.github.com/users/gitsomebit/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-10-13T15:14:22Z","updated_at":"2025-10-13T15:14:22Z","body":"offset the previous segment in the direction of the previous as well by a small Δ?","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3397938941/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3397957055","html_url":"https://github.com/godotengine/godot/issues/111593#issuecomment-3397957055","issue_url":"https://api.github.com/repos/godotengine/godot/issues/111593","id":3397957055,"node_id":"IC_kwDOAO6SJc7KiLW_","user":{"login":"AThousandShips","id":96648715,"node_id":"U_kgDOBcK-Cw","avatar_url":"https://avatars.githubusercontent.com/u/96648715?v=4","gravatar_id":"","url":"https://api.github.com/users/AThousandShips","html_url":"https://github.com/AThousandShips","followers_url":"https://api.github.com/users/AThousandShips/followers","following_url":"https://api.github.com/users/AThousandShips/following{/other_user}","gists_url":"https://api.github.com/users/AThousandShips/gists{/gist_id}","starred_url":"https://api.github.com/users/AThousandShips/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/AThousandShips/subscriptions","organizations_url":"https://api.github.com/users/AThousandShips/orgs","repos_url":"https://api.github.com/users/AThousandShips/repos","events_url":"https://api.github.com/users/AThousandShips/events{/privacy}","received_events_url":"https://api.github.com/users/AThousandShips/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-10-13T15:18:11Z","updated_at":"2025-10-13T15:18:11Z","body":"This would work assuming the segment cuts itself off, but it would have to be far enough so that it doesn't extend to cross over the last edge, this would depend on the width of the line, but not sure how the polyline would handle that\n\nIf the last part is very short it wouldn't prevent the inner part of the previous segment from crossing over the ideal end of the arc, it would also need to not make the arc look worse in other ways ","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3397957055/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3397982678","html_url":"https://github.com/godotengine/godot/issues/111593#issuecomment-3397982678","issue_url":"https://api.github.com/repos/godotengine/godot/issues/111593","id":3397982678,"node_id":"IC_kwDOAO6SJc7KiRnW","user":{"login":"gitsomebit","id":182990993,"node_id":"U_kgDOCug4kQ","avatar_url":"https://avatars.githubusercontent.com/u/182990993?v=4","gravatar_id":"","url":"https://api.github.com/users/gitsomebit","html_url":"https://github.com/gitsomebit","followers_url":"https://api.github.com/users/gitsomebit/followers","following_url":"https://api.github.com/users/gitsomebit/following{/other_user}","gists_url":"https://api.github.com/users/gitsomebit/gists{/gist_id}","starred_url":"https://api.github.com/users/gitsomebit/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/gitsomebit/subscriptions","organizations_url":"https://api.github.com/users/gitsomebit/orgs","repos_url":"https://api.github.com/users/gitsomebit/repos","events_url":"https://api.github.com/users/gitsomebit/events{/privacy}","received_events_url":"https://api.github.com/users/gitsomebit/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-10-13T15:25:19Z","updated_at":"2025-10-13T15:25:44Z","body":"Another idea could be to subdivide the last/first segment and move the new points a little outward so the edge segments perfectly align.","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3397982678/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4545538418","html_url":"https://github.com/godotengine/godot/issues/111593#issuecomment-4545538418","issue_url":"https://api.github.com/repos/godotengine/godot/issues/111593","id":4545538418,"node_id":"IC_kwDOAO6SJc8AAAABDu9pcg","user":{"login":"aurpine","id":12262539,"node_id":"MDQ6VXNlcjEyMjYyNTM5","avatar_url":"https://avatars.githubusercontent.com/u/12262539?v=4","gravatar_id":"","url":"https://api.github.com/users/aurpine","html_url":"https://github.com/aurpine","followers_url":"https://api.github.com/users/aurpine/followers","following_url":"https://api.github.com/users/aurpine/following{/other_user}","gists_url":"https://api.github.com/users/aurpine/gists{/gist_id}","starred_url":"https://api.github.com/users/aurpine/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/aurpine/subscriptions","organizations_url":"https://api.github.com/users/aurpine/orgs","repos_url":"https://api.github.com/users/aurpine/repos","events_url":"https://api.github.com/users/aurpine/events{/privacy}","received_events_url":"https://api.github.com/users/aurpine/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-05-26T15:17:39Z","updated_at":"2026-05-26T15:17:39Z","body":"I don't think this is a bug. The assumption here is that `draw_arc` with a width should be the boolean difference of two filled arcs. This is not the case. As the width becomes larger, it becomes more apparent that we are just drawing lines. In the example, we can see that there are artifacts when a pixel is drawn over by two lines in the polyline. \n\n<img width=\"461\" height=\"297\" alt=\"Image\" src=\"https://github.com/user-attachments/assets/88c3291d-ca42-4a4f-9157-a9633f1a3a37\" />\n\nThese artifacts get worse with more points. Ex points = 5000\n\n<img width=\"515\" height=\"420\" alt=\"Image\" src=\"https://github.com/user-attachments/assets/167dea13-90e9-4d96-96ef-b18c3523cf28\" />\n\nThe gap is caused by a slight difference of angle between the last/first line of the two arcs. If the desired behaviour is to have these two arcs coincide at the same angle, then you can add an extra point. \n\n<img width=\"1152\" height=\"648\" alt=\"Image\" src=\"https://github.com/user-attachments/assets/ea28cd19-ff91-4a49-91c8-bf19c2c47752\" />\n\nThis is with points = 10. Now the arcs will overlap but the overlap area gets smaller with more points. \n\nI did this by modifying the engine but one can do the same by increasing the arc angle by `(end_angle - start_angle) / points`.\n\nFor a proper boolean difference of two filled arcs, I would suggest `draw_polygon`.","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4545538418/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null}]