chived_by":null}],"state":"open","locked":false,"assignees":[],"milestone":{"url":"https://api.github.com/repos/godotengine/godot/milestones/25","html_url":"https://github.com/godotengine/godot/milestone/25","labels_url":"https://api.github.com/repos/godotengine/godot/milestones/25/labels","id":15520464,"node_id":"MI_kwDOAO6SJc4A7NLQ","number":25,"title":"4.8","description":"","creator":{"login":"Repiteo","id":17489292,"node_id":"MDQ6VXNlcjE3NDg5Mjky","avatar_url":"https://avatars.githubusercontent.com/u/17489292?v=4","gravatar_id":"","url":"https://api.github.com/users/Repiteo","html_url":"https://github.com/Repiteo","followers_url":"https://api.github.com/users/Repiteo/followers","following_url":"https://api.github.com/users/Repiteo/following{/other_user}","gists_url":"https://api.github.com/users/Repiteo/gists{/gist_id}","starred_url":"https://api.github.com/users/Repiteo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Repiteo/subscriptions","organizations_url":"https://api.github.com/users/Repiteo/orgs","repos_url":"https://api.github.com/users/Repiteo/repos","events_url":"https://api.github.com/users/Repiteo/events{/privacy}","received_events_url":"https://api.github.com/users/Repiteo/received_events","type":"User","user_view_type":"public","site_admin":false},"open_issues":343,"closed_issues":2335,"state":"open","created_at":"2026-04-13T15:59:35Z","updated_at":"2026-10-22T06:28:22Z","due_on":null,"closed_at":null},"comments":0,"created_at":"2026-06-15T10:19:17Z","updated_at":"2026-06-18T08:19:29Z","closed_at":null,"assignee":null,"author_association":"MEMBER","issue_field_values":[],"type":null,"active_lock_reason":null,"draft":false,"pull_request":{"url":"https://api.github.com/repos/godotengine/godot/pulls/120317","html_url":"https://github.com/godotengine/godot/pull/120317","diff_url":"https://github.com/godotengine/godot/pull/120317.diff","patch_url":"https://github.com/godotengine/godot/pull/120317.patch","merged_at":null},"body":"## What problem(s) does this PR solve?\r\n\r\nCloses https://github.com/godotengine/godot/issues/120281\r\n\r\n## Additional information\r\n\r\nAdds new flags (`INLINE_ALIGNMENT_SCOPE_*`), applied to the RTL inline images as default, to align text to the adjacent spans of text instead of the full line of text. With addition of `em` units of size to the RTL it is a more useful behavior.\r\n\r\nDefault for tables is not changed, but can be specified in the tag.\r\n\r\nBefore (center-center, bottom-top, top-bottom alignments):\r\n<img width=\"1120\" height=\"303\" alt=\"Screenshot 2026-06-15 at 12 49 02\" src=\"https://github.com/user-attachments/assets/e60de141-adea-44ef-a728-6164df2842ba\" />\r\n\r\nAfter:\r\n<img width=\"1120\" height=\"303\" alt=\"Screenshot 2026-06-15 at 12 48 46\" src=\"https://github.com/user-attachments/assets/faeaa282-7807-48ea-8277-13e1dc450ec2\" />\r\n\r\nTag alignment format is:\r\n| Old | New |\r\n|--|--|\r\n| `align=from,to` | `align=from,to,scope` |\r\n\r\nWhere `from` image point, `to` is text point, and `scope` is `prev\\next\\adjacent\\line` (or `p\\n\\a\\l`).","closed_by":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/120317/reactions","total_count":2,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":2},"timeline_url":"https://api.github.com/repos/godotengine/godot/issues/120317/timeline","performed_via_github_app":null,"state_reason":null}