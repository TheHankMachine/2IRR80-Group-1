id":2666708289,"node_id":"MDU6TGFiZWwyNjY2NzA4Mjg5","url":"https://api.github.com/repos/godotengine/godot/labels/topic:3d","name":"topic:3d","color":"ffee88","default":false,"description":"","archived_at":null,"archived_by":null}],"state":"closed","locked":false,"assignees":[],"milestone":{"url":"https://api.github.com/repos/godotengine/godot/milestones/25","html_url":"https://github.com/godotengine/godot/milestone/25","labels_url":"https://api.github.com/repos/godotengine/godot/milestones/25/labels","id":15520464,"node_id":"MI_kwDOAO6SJc4A7NLQ","number":25,"title":"4.8","description":"","creator":{"login":"Repiteo","id":17489292,"node_id":"MDQ6VXNlcjE3NDg5Mjky","avatar_url":"https://avatars.githubusercontent.com/u/17489292?v=4","gravatar_id":"","url":"https://api.github.com/users/Repiteo","html_url":"https://github.com/Repiteo","followers_url":"https://api.github.com/users/Repiteo/followers","following_url":"https://api.github.com/users/Repiteo/following{/other_user}","gists_url":"https://api.github.com/users/Repiteo/gists{/gist_id}","starred_url":"https://api.github.com/users/Repiteo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Repiteo/subscriptions","organizations_url":"https://api.github.com/users/Repiteo/orgs","repos_url":"https://api.github.com/users/Repiteo/repos","events_url":"https://api.github.com/users/Repiteo/events{/privacy}","received_events_url":"https://api.github.com/users/Repiteo/received_events","type":"User","user_view_type":"public","site_admin":false},"open_issues":345,"closed_issues":2336,"state":"open","created_at":"2026-04-13T15:59:35Z","updated_at":"2026-10-22T08:21:32Z","due_on":null,"closed_at":null},"comments":1,"created_at":"2026-09-24T07:43:33Z","updated_at":"2026-09-24T17:37:40Z","closed_at":"2026-09-24T17:29:04Z","assignee":null,"author_association":"CONTRIBUTOR","issue_field_values":[],"type":null,"active_lock_reason":null,"draft":false,"pull_request":{"url":"https://api.github.com/repos/godotengine/godot/pulls/123790","html_url":"https://github.com/godotengine/godot/pull/123790","diff_url":"https://github.com/godotengine/godot/pull/123790.diff","patch_url":"https://github.com/godotengine/godot/pull/123790.patch","merged_at":"2026-09-24T17:29:04Z"},"body":"`GodotPhysicsServer3D::slider_joint_get_param()` checks for `JOINT_TYPE_CONE_TWIST` instead of `JOINT_TYPE_SLIDER`, causing valid slider joints to return `0`.\r\n\r\nChange the check to `JOINT_TYPE_SLIDER`, matching `slider_joint_set_param()`.\r\n\r\n<details>\r\n<summary>Test Script</summary>\r\n\r\n```gdscript\r\n# NOTE: Autoload\r\n#       Project Settings → Physics → 3D → Physics Engine → GodotPhysics3D\r\n\r\nextends Node\r\n\r\nfunc _ready() -> void:\r\n    var shape := PhysicsServer3D.box_shape_create()\r\n    PhysicsServer3D.shape_set_data(shape, Vector3.ONE)\r\n    \r\n    var body_a := PhysicsServer3D.body_create()\r\n    var body_b := PhysicsServer3D.body_create()\r\n    \r\n    PhysicsServer3D.body_set_mode(body_a, PhysicsServer3D.BODY_MODE_RIGID)\r\n    PhysicsServer3D.body_set_mode(body_b, PhysicsServer3D.BODY_MODE_RIGID)\r\n    \r\n    PhysicsServer3D.body_add_shape(body_a, shape)\r\n    PhysicsServer3D.body_add_shape(body_b, shape)\r\n    \r\n    PhysicsServer3D.body_set_state(\r\n        body_a,\r\n        PhysicsServer3D.BODY_STATE_TRANSFORM,\r\n        Transform3D(Basis.IDENTITY, Vector3(0, 0, 0))\r\n    )\r\n    \r\n    PhysicsServer3D.body_set_state(\r\n        body_b,\r\n        PhysicsServer3D.BODY_STATE_TRANSFORM,\r\n        Transform3D(Basis.IDENTITY, Vector3(2, 0, 0))\r\n    )\r\n    \r\n    var joint := PhysicsServer3D.joint_create()\r\n    \r\n    PhysicsServer3D.joint_make_slider(\r\n        joint,\r\n        body_a,\r\n        Transform3D.IDENTITY,\r\n        body_b,\r\n        Transform3D.IDENTITY\r\n    )\r\n    \r\n    var param := PhysicsServer3D.SLIDER_JOINT_LINEAR_LIMIT_LOWER\r\n    var expected := -2.5\r\n    \r\n    PhysicsServer3D.slider_joint_set_param(joint, param, expected)\r\n    \r\n    var actual := PhysicsServer3D.slider_joint_get_param(joint, param)\r\n    \r\n    print(\"Expected: \", expected)\r\n    print(\"Actual:   \", actual)\r\n    print(\"Passed:   \", is_equal_approx(actual, expected))\r\n```\r\n\r\n</details>\r\n","closed_by":{"login":"Repiteo","id":17489292,"node_id":"MDQ6VXNlcjE3NDg5Mjky","avatar_url":"https://avatars.githubusercontent.com/u/17489292?v=4","gravatar_id":"","url":"https://api.github.com/users/Repiteo","html_url":"https://github.com/Repiteo","followers_url":"https://api.github.com/users/Repiteo/followers","following_url":"https://api.github.com/users/Repiteo/following{/other_user}","gists_url":"https://api.github.com/users/Repiteo/gists{/gist_id}","starred_url":"https://api.github.com/users/Repiteo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Repiteo/subscriptions","organizations_url":"https://api.github.com/users/Repiteo/orgs","repos_url":"https://api.github.com/users/Repiteo/repos","events_url":"https://api.github.com/users/Repiteo/events{/privacy}","received_events_url":"https://api.github.com/users/Repiteo/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/123790/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/godotengine/godot/issues/123790/timeline","performed_via_github_app":null,"state_reason":null}