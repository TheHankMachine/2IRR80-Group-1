[{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5077801895","html_url":"https://github.com/godotengine/godot/issues/121729#issuecomment-5077801895","issue_url":"https://api.github.com/repos/godotengine/godot/issues/121729","id":5077801895,"node_id":"IC_kwDOAO6SJc8AAAABLqkbpw","user":{"login":"HolonProduction","id":99511741,"node_id":"U_kgDOBe5tvQ","avatar_url":"https://avatars.githubusercontent.com/u/99511741?v=4","gravatar_id":"","url":"https://api.github.com/users/HolonProduction","html_url":"https://github.com/HolonProduction","followers_url":"https://api.github.com/users/HolonProduction/followers","following_url":"https://api.github.com/users/HolonProduction/following{/other_user}","gists_url":"https://api.github.com/users/HolonProduction/gists{/gist_id}","starred_url":"https://api.github.com/users/HolonProduction/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/HolonProduction/subscriptions","organizations_url":"https://api.github.com/users/HolonProduction/orgs","repos_url":"https://api.github.com/users/HolonProduction/repos","events_url":"https://api.github.com/users/HolonProduction/events{/privacy}","received_events_url":"https://api.github.com/users/HolonProduction/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-07-25T08:49:31Z","updated_at":"2026-07-25T08:49:31Z","body":"Bisected to 546e46d3b6e0739c4665f93df9cbf677407bb3eb (CC @HolonProduction dang that's me)","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5077801895/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5078048804","html_url":"https://github.com/godotengine/godot/issues/121729#issuecomment-5078048804","issue_url":"https://api.github.com/repos/godotengine/godot/issues/121729","id":5078048804,"node_id":"IC_kwDOAO6SJc8AAAABLqzgJA","user":{"login":"HolonProduction","id":99511741,"node_id":"U_kgDOBe5tvQ","avatar_url":"https://avatars.githubusercontent.com/u/99511741?v=4","gravatar_id":"","url":"https://api.github.com/users/HolonProduction","html_url":"https://github.com/HolonProduction","followers_url":"https://api.github.com/users/HolonProduction/followers","following_url":"https://api.github.com/users/HolonProduction/following{/other_user}","gists_url":"https://api.github.com/users/HolonProduction/gists{/gist_id}","starred_url":"https://api.github.com/users/HolonProduction/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/HolonProduction/subscriptions","organizations_url":"https://api.github.com/users/HolonProduction/orgs","repos_url":"https://api.github.com/users/HolonProduction/repos","events_url":"https://api.github.com/users/HolonProduction/events{/privacy}","received_events_url":"https://api.github.com/users/HolonProduction/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-07-25T09:54:08Z","updated_at":"2026-07-25T09:54:34Z","body":"Fixing the crash is straight forward. You shouldn't use lambdas for `@export_tool_button` anyway (at least of `RefCounted`), a lambda that uses `self` holds a reference to the object, so you are basically voiding all `RefCounting` logic by referencing the object from itself. You will be leaking those resources till game shutdown.\n\nWe should note that in the docs.","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5078048804/reactions","total_count":2,"+1":2,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5078068109","html_url":"https://github.com/godotengine/godot/issues/121729#issuecomment-5078068109","issue_url":"https://api.github.com/repos/godotengine/godot/issues/121729","id":5078068109,"node_id":"IC_kwDOAO6SJc8AAAABLq0rjQ","user":{"login":"Radivarig","id":6281737,"node_id":"MDQ6VXNlcjYyODE3Mzc=","avatar_url":"https://avatars.githubusercontent.com/u/6281737?v=4","gravatar_id":"","url":"https://api.github.com/users/Radivarig","html_url":"https://github.com/Radivarig","followers_url":"https://api.github.com/users/Radivarig/followers","following_url":"https://api.github.com/users/Radivarig/following{/other_user}","gists_url":"https://api.github.com/users/Radivarig/gists{/gist_id}","starred_url":"https://api.github.com/users/Radivarig/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Radivarig/subscriptions","organizations_url":"https://api.github.com/users/Radivarig/orgs","repos_url":"https://api.github.com/users/Radivarig/repos","events_url":"https://api.github.com/users/Radivarig/events{/privacy}","received_events_url":"https://api.github.com/users/Radivarig/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-07-25T10:00:56Z","updated_at":"2026-07-25T10:00:56Z","body":"Could Godot show a warning about this automatically, or error if there's no practical use for such assignment?","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5078068109/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5078173518","html_url":"https://github.com/godotengine/godot/issues/121729#issuecomment-5078173518","issue_url":"https://api.github.com/repos/godotengine/godot/issues/121729","id":5078173518,"node_id":"IC_kwDOAO6SJc8AAAABLq7HTg","user":{"login":"romgerman","id":1517367,"node_id":"MDQ6VXNlcjE1MTczNjc=","avatar_url":"https://avatars.githubusercontent.com/u/1517367?v=4","gravatar_id":"","url":"https://api.github.com/users/romgerman","html_url":"https://github.com/romgerman","followers_url":"https://api.github.com/users/romgerman/followers","following_url":"https://api.github.com/users/romgerman/following{/other_user}","gists_url":"https://api.github.com/users/romgerman/gists{/gist_id}","starred_url":"https://api.github.com/users/romgerman/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/romgerman/subscriptions","organizations_url":"https://api.github.com/users/romgerman/orgs","repos_url":"https://api.github.com/users/romgerman/repos","events_url":"https://api.github.com/users/romgerman/events{/privacy}","received_events_url":"https://api.github.com/users/romgerman/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-07-25T10:36:27Z","updated_at":"2026-07-25T10:36:27Z","body":"> Could Godot show a warning about this\n\nIt is a known bug https://github.com/godotengine/godot/issues/102327. If it's not going to get fixed then I also think that this behavior should be noted in the docs.","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5078173518/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5078543897","html_url":"https://github.com/godotengine/godot/issues/121729#issuecomment-5078543897","issue_url":"https://api.github.com/repos/godotengine/godot/issues/121729","id":5078543897,"node_id":"IC_kwDOAO6SJc8AAAABLrRuGQ","user":{"login":"HolonProduction","id":99511741,"node_id":"U_kgDOBe5tvQ","avatar_url":"https://avatars.githubusercontent.com/u/99511741?v=4","gravatar_id":"","url":"https://api.github.com/users/HolonProduction","html_url":"https://github.com/HolonProduction","followers_url":"https://api.github.com/users/HolonProduction/followers","following_url":"https://api.github.com/users/HolonProduction/following{/other_user}","gists_url":"https://api.github.com/users/HolonProduction/gists{/gist_id}","starred_url":"https://api.github.com/users/HolonProduction/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/HolonProduction/subscriptions","organizations_url":"https://api.github.com/users/HolonProduction/orgs","repos_url":"https://api.github.com/users/HolonProduction/repos","events_url":"https://api.github.com/users/HolonProduction/events{/privacy}","received_events_url":"https://api.github.com/users/HolonProduction/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-07-25T12:50:48Z","updated_at":"2026-07-25T12:50:48Z","body":"It's not really a bug. The bug aspect of it, is that they leak during engine shutdown (although that might need retesting after https://github.com/godotengine/godot/pull/120976). The fact that they leak from user code until language shutdown is just the consequence of behavior that's intended.\n\nIn regard to a warning, that seems feasible from the technical side as long as you are fine with false negatives. Might need some thought on false positives though, if there are valid usecases we might need to limit it to props that have `@export_tool_button` to limit impact.","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5078543897/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5078965317","html_url":"https://github.com/godotengine/godot/issues/121729#issuecomment-5078965317","issue_url":"https://api.github.com/repos/godotengine/godot/issues/121729","id":5078965317,"node_id":"IC_kwDOAO6SJc8AAAABLrrcRQ","user":{"login":"romgerman","id":1517367,"node_id":"MDQ6VXNlcjE1MTczNjc=","avatar_url":"https://avatars.githubusercontent.com/u/1517367?v=4","gravatar_id":"","url":"https://api.github.com/users/romgerman","html_url":"https://github.com/romgerman","followers_url":"https://api.github.com/users/romgerman/followers","following_url":"https://api.github.com/users/romgerman/following{/other_user}","gists_url":"https://api.github.com/users/romgerman/gists{/gist_id}","starred_url":"https://api.github.com/users/romgerman/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/romgerman/subscriptions","organizations_url":"https://api.github.com/users/romgerman/orgs","repos_url":"https://api.github.com/users/romgerman/repos","events_url":"https://api.github.com/users/romgerman/events{/privacy}","received_events_url":"https://api.github.com/users/romgerman/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-07-25T15:02:31Z","updated_at":"2026-07-25T15:02:31Z","body":"> behavior that's intended\n\nI'm sorry, but how is leaking ref counted objects is intended behavior? And if it is then it should be totally noted as a big warning in the docs like \"do not use refcounted objects inside lambdas\". This behavior fully breaks the object lifecycle because `NOTIFICATION_PREDELETE` notification becomes pointless as it is never emitted. And that means that using refcounted objects is the easiest way to shoot yourself in the foot like it's C++ all over again with the manual memory management but this time with a surprise mechanic.","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5078965317/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5078998975","html_url":"https://github.com/godotengine/godot/issues/121729#issuecomment-5078998975","issue_url":"https://api.github.com/repos/godotengine/godot/issues/121729","id":5078998975,"node_id":"IC_kwDOAO6SJc8AAAABLrtfvw","user":{"login":"HolonProduction","id":99511741,"node_id":"U_kgDOBe5tvQ","avatar_url":"https://avatars.githubusercontent.com/u/99511741?v=4","gravatar_id":"","url":"https://api.github.com/users/HolonProduction","html_url":"https://github.com/HolonProduction","followers_url":"https://api.github.com/users/HolonProduction/followers","following_url":"https://api.github.com/users/HolonProduction/following{/other_user}","gists_url":"https://api.github.com/users/HolonProduction/gists{/gist_id}","starred_url":"https://api.github.com/users/HolonProduction/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/HolonProduction/subscriptions","organizations_url":"https://api.github.com/users/HolonProduction/orgs","repos_url":"https://api.github.com/users/HolonProduction/repos","events_url":"https://api.github.com/users/HolonProduction/events{/privacy}","received_events_url":"https://api.github.com/users/HolonProduction/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-07-25T15:11:42Z","updated_at":"2026-07-25T15:11:42Z","body":"Well the intended part is, that if you create a lambda from a ref counted object the object stays alive until you are done with the lambda. If you store that lambda in the object itself, you are creating a cyclic reference. Godot's approach to memory management requires users to take care off cyclic references.\n\nI will say, that the fact that lambdas hold a reference to the object might be worth discussing for future compat breakages. Because it is inconsistent with e.g. co-routines. But looking at this under 4.x it's intended.","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5078998975/reactions","total_count":2,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":2},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5102508471","html_url":"https://github.com/godotengine/godot/issues/121729#issuecomment-5102508471","issue_url":"https://api.github.com/repos/godotengine/godot/issues/121729","id":5102508471,"node_id":"IC_kwDOAO6SJc8AAAABMCIZtw","user":{"login":"HolonProduction","id":99511741,"node_id":"U_kgDOBe5tvQ","avatar_url":"https://avatars.githubusercontent.com/u/99511741?v=4","gravatar_id":"","url":"https://api.github.com/users/HolonProduction","html_url":"https://github.com/HolonProduction","followers_url":"https://api.github.com/users/HolonProduction/followers","following_url":"https://api.github.com/users/HolonProduction/following{/other_user}","gists_url":"https://api.github.com/users/HolonProduction/gists{/gist_id}","starred_url":"https://api.github.com/users/HolonProduction/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/HolonProduction/subscriptions","organizations_url":"https://api.github.com/users/HolonProduction/orgs","repos_url":"https://api.github.com/users/HolonProduction/repos","events_url":"https://api.github.com/users/HolonProduction/events{/privacy}","received_events_url":"https://api.github.com/users/HolonProduction/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-07-28T09:43:50Z","updated_at":"2026-07-28T09:43:50Z","body":"Ok turns out this is already documented:\n\n<img width=\"771\" height=\"86\" alt=\"Image\" src=\"https://github.com/user-attachments/assets/37bdddb4-03a0-40a4-bb6b-1b292af94786\" />","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5102508471/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null}]