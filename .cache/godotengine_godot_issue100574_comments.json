[{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2552012532","html_url":"https://github.com/godotengine/godot/pull/100574#issuecomment-2552012532","issue_url":"https://api.github.com/repos/godotengine/godot/issues/100574","id":2552012532,"node_id":"IC_kwDOAO6SJc6YHJ70","user":{"login":"smix8","id":52464204,"node_id":"MDQ6VXNlcjUyNDY0MjA0","avatar_url":"https://avatars.githubusercontent.com/u/52464204?v=4","gravatar_id":"","url":"https://api.github.com/users/smix8","html_url":"https://github.com/smix8","followers_url":"https://api.github.com/users/smix8/followers","following_url":"https://api.github.com/users/smix8/following{/other_user}","gists_url":"https://api.github.com/users/smix8/gists{/gist_id}","starred_url":"https://api.github.com/users/smix8/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/smix8/subscriptions","organizations_url":"https://api.github.com/users/smix8/orgs","repos_url":"https://api.github.com/users/smix8/repos","events_url":"https://api.github.com/users/smix8/events{/privacy}","received_events_url":"https://api.github.com/users/smix8/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2024-12-18T18:33:23Z","updated_at":"2026-05-11T19:31:56Z","body":"> If you want a triangle, use a `Polygon2D` instead.\r\n\r\nJoin the 3-Vertex-CircleShape-Club.","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2552012532/reactions","total_count":1,"+1":0,"-1":0,"laugh":1,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":{"reason":"resolved"}},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2552050059","html_url":"https://github.com/godotengine/godot/pull/100574#issuecomment-2552050059","issue_url":"https://api.github.com/repos/godotengine/godot/issues/100574","id":2552050059,"node_id":"IC_kwDOAO6SJc6YHTGL","user":{"login":"Geometror","id":50084500,"node_id":"MDQ6VXNlcjUwMDg0NTAw","avatar_url":"https://avatars.githubusercontent.com/u/50084500?v=4","gravatar_id":"","url":"https://api.github.com/users/Geometror","html_url":"https://github.com/Geometror","followers_url":"https://api.github.com/users/Geometror/followers","following_url":"https://api.github.com/users/Geometror/following{/other_user}","gists_url":"https://api.github.com/users/Geometror/gists{/gist_id}","starred_url":"https://api.github.com/users/Geometror/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Geometror/subscriptions","organizations_url":"https://api.github.com/users/Geometror/orgs","repos_url":"https://api.github.com/users/Geometror/repos","events_url":"https://api.github.com/users/Geometror/events{/privacy}","received_events_url":"https://api.github.com/users/Geometror/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2024-12-18T18:54:41Z","updated_at":"2024-12-18T18:54:57Z","body":"I like it, but to be honest, I'm not sure whether this really closes the linked proposal.\r\nIs this meant as an alternative to https://github.com/godotengine/godot/pull/99210 or complementary? Since the problem with this approach is that compared to the other PR you can't have outlines and fake anti-aliasing (which are rather important features IMO).","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2552050059/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2552105583","html_url":"https://github.com/godotengine/godot/pull/100574#issuecomment-2552105583","issue_url":"https://api.github.com/repos/godotengine/godot/issues/100574","id":2552105583,"node_id":"IC_kwDOAO6SJc6YHgpv","user":{"login":"smix8","id":52464204,"node_id":"MDQ6VXNlcjUyNDY0MjA0","avatar_url":"https://avatars.githubusercontent.com/u/52464204?v=4","gravatar_id":"","url":"https://api.github.com/users/smix8","html_url":"https://github.com/smix8","followers_url":"https://api.github.com/users/smix8/followers","following_url":"https://api.github.com/users/smix8/following{/other_user}","gists_url":"https://api.github.com/users/smix8/gists{/gist_id}","starred_url":"https://api.github.com/users/smix8/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/smix8/subscriptions","organizations_url":"https://api.github.com/users/smix8/orgs","repos_url":"https://api.github.com/users/smix8/repos","events_url":"https://api.github.com/users/smix8/events{/privacy}","received_events_url":"https://api.github.com/users/smix8/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2024-12-18T19:26:21Z","updated_at":"2024-12-18T20:05:04Z","body":"> ...and fake anti-aliasing (which are rather important features IMO).\r\n\r\nThe `antialiased` for the internal Polygon2D is pure placebo that does exactly nothing.\r\n\r\nA leftover from the Godot 3 days that used opengl canvas item triangle arrays while Godot 4 uses actual meshes.","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2552105583/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2552134431","html_url":"https://github.com/godotengine/godot/pull/100574#issuecomment-2552134431","issue_url":"https://api.github.com/repos/godotengine/godot/issues/100574","id":2552134431,"node_id":"IC_kwDOAO6SJc6YHnsf","user":{"login":"rburing","id":229837,"node_id":"MDQ6VXNlcjIyOTgzNw==","avatar_url":"https://avatars.githubusercontent.com/u/229837?v=4","gravatar_id":"","url":"https://api.github.com/users/rburing","html_url":"https://github.com/rburing","followers_url":"https://api.github.com/users/rburing/followers","following_url":"https://api.github.com/users/rburing/following{/other_user}","gists_url":"https://api.github.com/users/rburing/gists{/gist_id}","starred_url":"https://api.github.com/users/rburing/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/rburing/subscriptions","organizations_url":"https://api.github.com/users/rburing/orgs","repos_url":"https://api.github.com/users/rburing/repos","events_url":"https://api.github.com/users/rburing/events{/privacy}","received_events_url":"https://api.github.com/users/rburing/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2024-12-18T19:43:35Z","updated_at":"2024-12-18T21:06:40Z","body":"> > If you want a triangle, use a `Polygon2D` instead.\r\n> \r\n> Join the 3-Vertex-CircleShape-Club.\r\n\r\nI was going to object, pointing out the `radius` property would not be \"respected\", but instead I just made it work.\r\n\r\n> I like it, but to be honest, I'm not sure whether this really closes the linked proposal.\r\n\r\nThe proposal asks for the ability to draw simple 2D shapes. It's not clear if those who voted on it also wanted outlines and fake anti-aliasing (or different kinds of triangles).\r\n\r\n> Is this meant as an alternative to https://github.com/godotengine/godot/pull/99210 or complementary?\r\n\r\nIt is meant to fill a feature gap (primitive 2D meshes). It's partly an alternative to that PR.\r\n\r\n> Since the problem with this approach is that compared to the other PR you can't have outlines and fake anti-aliasing (which are rather important features IMO).\r\n\r\nI do agree those are nice features. Outlines should be achievable with this PR, e.g. with a material. I don't know much about how to achieve fake anti-aliasing, but I'll look into it.\r\n\r\n---\r\n\r\nEdit: One way to add an outline to a `MeshInstance2D` with a primitive 2D mesh is to make a duplicate of the node, make that duplicate a child of the original, set `show_behind_parent = true` in the inspector, and set `material` to a `ShaderMaterial` with a \"grow\" shader like this:\r\n\r\n```glsl\r\nshader_type canvas_item;\r\n\r\nuniform float outline_width = 5.0;\r\nuniform vec4 color: source_color;\r\n\r\nvoid vertex() {\r\n\tvec2 direction = normalize(VERTEX);\r\n\tif (length(direction) > 0.0) {\r\n\t\tVERTEX += direction * outline_width;\r\n\t}\r\n}\r\n\r\nvoid fragment() {\r\n\tCOLOR = color;\r\n}\r\n```","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2552134431/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2552145209","html_url":"https://github.com/godotengine/godot/pull/100574#issuecomment-2552145209","issue_url":"https://api.github.com/repos/godotengine/godot/issues/100574","id":2552145209,"node_id":"IC_kwDOAO6SJc6YHqU5","user":{"login":"tetrapod00","id":145553014,"node_id":"U_kgDOCKz2dg","avatar_url":"https://avatars.githubusercontent.com/u/145553014?v=4","gravatar_id":"","url":"https://api.github.com/users/tetrapod00","html_url":"https://github.com/tetrapod00","followers_url":"https://api.github.com/users/tetrapod00/followers","following_url":"https://api.github.com/users/tetrapod00/following{/other_user}","gists_url":"https://api.github.com/users/tetrapod00/gists{/gist_id}","starred_url":"https://api.github.com/users/tetrapod00/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/tetrapod00/subscriptions","organizations_url":"https://api.github.com/users/tetrapod00/orgs","repos_url":"https://api.github.com/users/tetrapod00/repos","events_url":"https://api.github.com/users/tetrapod00/events{/privacy}","received_events_url":"https://api.github.com/users/tetrapod00/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2024-12-18T19:50:01Z","updated_at":"2024-12-18T19:50:01Z","body":"For *meshes*, is it really expected that fake antialiasing is supported, when there is real 2D edge antialising available by using MSAA? If we go by parity with 3D meshes, there shouldn't be an expectation that meshes antialias themselves, IMO.\r\n\r\n(I'm also not sure if this closes the linked issue, but that seems like a separate concern)","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2552145209/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2552241913","html_url":"https://github.com/godotengine/godot/pull/100574#issuecomment-2552241913","issue_url":"https://api.github.com/repos/godotengine/godot/issues/100574","id":2552241913,"node_id":"IC_kwDOAO6SJc6YIB75","user":{"login":"mk56-spn","id":74463310,"node_id":"MDQ6VXNlcjc0NDYzMzEw","avatar_url":"https://avatars.githubusercontent.com/u/74463310?v=4","gravatar_id":"","url":"https://api.github.com/users/mk56-spn","html_url":"https://github.com/mk56-spn","followers_url":"https://api.github.com/users/mk56-spn/followers","following_url":"https://api.github.com/users/mk56-spn/following{/other_user}","gists_url":"https://api.github.com/users/mk56-spn/gists{/gist_id}","starred_url":"https://api.github.com/users/mk56-spn/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/mk56-spn/subscriptions","organizations_url":"https://api.github.com/users/mk56-spn/orgs","repos_url":"https://api.github.com/users/mk56-spn/repos","events_url":"https://api.github.com/users/mk56-spn/events{/privacy}","received_events_url":"https://api.github.com/users/mk56-spn/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2024-12-18T20:49:17Z","updated_at":"2024-12-18T20:49:17Z","body":"this is very useful for those of us directly using the rendering server who want easy to use pre made meshes :+1: ","author_association":"NONE","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2552241913/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2558539356","html_url":"https://github.com/godotengine/godot/pull/100574#issuecomment-2558539356","issue_url":"https://api.github.com/repos/godotengine/godot/issues/100574","id":2558539356,"node_id":"IC_kwDOAO6SJc6YgDZc","user":{"login":"rburing","id":229837,"node_id":"MDQ6VXNlcjIyOTgzNw==","avatar_url":"https://avatars.githubusercontent.com/u/229837?v=4","gravatar_id":"","url":"https://api.github.com/users/rburing","html_url":"https://github.com/rburing","followers_url":"https://api.github.com/users/rburing/followers","following_url":"https://api.github.com/users/rburing/following{/other_user}","gists_url":"https://api.github.com/users/rburing/gists{/gist_id}","starred_url":"https://api.github.com/users/rburing/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/rburing/subscriptions","organizations_url":"https://api.github.com/users/rburing/orgs","repos_url":"https://api.github.com/users/rburing/repos","events_url":"https://api.github.com/users/rburing/events{/privacy}","received_events_url":"https://api.github.com/users/rburing/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2024-12-22T18:01:05Z","updated_at":"2024-12-22T18:01:05Z","body":"From the notes of the rendering team meeting on 19/12/2024:\r\n\r\n> AA should be built into the mesh. \r\n> - Color should be set to white, then add a skirt around the mesh with color set to transparent white\r\n\r\nThe latest push adds an `antialiased` option to all primitive 2D meshes. Example project: [godot-primitive-mesh-2d.zip](https://github.com/user-attachments/files/18222777/godot-primitive-mesh-2d.zip)\r\n\r\n![primitive_mesh_2d_antialiased](https://github.com/user-attachments/assets/e1fd3265-df17-4a74-9147-108a96ef0838)\r\n\r\n(Anti-aliasing is disabled for the procedural shapes on the right.)\r\n\r\nTesting / reviews welcome!","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2558539356/reactions","total_count":2,"+1":2,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2560233501","html_url":"https://github.com/godotengine/godot/pull/100574#issuecomment-2560233501","issue_url":"https://api.github.com/repos/godotengine/godot/issues/100574","id":2560233501,"node_id":"IC_kwDOAO6SJc6YmhAd","user":{"login":"mk56-spn","id":74463310,"node_id":"MDQ6VXNlcjc0NDYzMzEw","avatar_url":"https://avatars.githubusercontent.com/u/74463310?v=4","gravatar_id":"","url":"https://api.github.com/users/mk56-spn","html_url":"https://github.com/mk56-spn","followers_url":"https://api.github.com/users/mk56-spn/followers","following_url":"https://api.github.com/users/mk56-spn/following{/other_user}","gists_url":"https://api.github.com/users/mk56-spn/gists{/gist_id}","starred_url":"https://api.github.com/users/mk56-spn/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/mk56-spn/subscriptions","organizations_url":"https://api.github.com/users/mk56-spn/orgs","repos_url":"https://api.github.com/users/mk56-spn/repos","events_url":"https://api.github.com/users/mk56-spn/events{/privacy}","received_events_url":"https://api.github.com/users/mk56-spn/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2024-12-23T20:00:50Z","updated_at":"2026-05-11T19:35:26Z","body":"![Screenshot from 2024-12-23 20-58-39](https://github.com/user-attachments/assets/56149d85-a39a-4087-84fb-08de4e409451)\r\n\r\nmostly works great, but rect mesh anti aliasing seems broken when the subdivide counts on each axis are mismatched","author_association":"NONE","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2560233501/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":{"reason":"outdated"}},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2585909184","html_url":"https://github.com/godotengine/godot/pull/100574#issuecomment-2585909184","issue_url":"https://api.github.com/repos/godotengine/godot/issues/100574","id":2585909184,"node_id":"IC_kwDOAO6SJc6aIdfA","user":{"login":"KoBeWi","id":2223172,"node_id":"MDQ6VXNlcjIyMjMxNzI=","avatar_url":"https://avatars.githubusercontent.com/u/2223172?v=4","gravatar_id":"","url":"https://api.github.com/users/KoBeWi","html_url":"https://github.com/KoBeWi","followers_url":"https://api.github.com/users/KoBeWi/followers","following_url":"https://api.github.com/users/KoBeWi/following{/other_user}","gists_url":"https://api.github.com/users/KoBeWi/gists{/gist_id}","starred_url":"https://api.github.com/users/KoBeWi/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/KoBeWi/subscriptions","organizations_url":"https://api.github.com/users/KoBeWi/orgs","repos_url":"https://api.github.com/users/KoBeWi/repos","events_url":"https://api.github.com/users/KoBeWi/events{/privacy}","received_events_url":"https://api.github.com/users/KoBeWi/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-01-12T20:40:43Z","updated_at":"2025-01-12T20:42:20Z","body":"I tested this PR and #99210 is much better UX-wise.\r\nResizing mesh in 2D editor will change scale instead of mesh size and there are no convenient options for converting to other types.\r\n\r\nAlthough the proposal pretty much only requests something to draw shapes, so this PR does the job too I guess.\r\nEDIT:\r\nAlthough it's interesting that for an arguably simpler solution, it introduces almost twice as much code.","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2585909184/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2585960901","html_url":"https://github.com/godotengine/godot/pull/100574#issuecomment-2585960901","issue_url":"https://api.github.com/repos/godotengine/godot/issues/100574","id":2585960901,"node_id":"IC_kwDOAO6SJc6aIqHF","user":{"login":"mk56-spn","id":74463310,"node_id":"MDQ6VXNlcjc0NDYzMzEw","avatar_url":"https://avatars.githubusercontent.com/u/74463310?v=4","gravatar_id":"","url":"https://api.github.com/users/mk56-spn","html_url":"https://github.com/mk56-spn","followers_url":"https://api.github.com/users/mk56-spn/followers","following_url":"https://api.github.com/users/mk56-spn/following{/other_user}","gists_url":"https://api.github.com/users/mk56-spn/gists{/gist_id}","starred_url":"https://api.github.com/users/mk56-spn/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/mk56-spn/subscriptions","organizations_url":"https://api.github.com/users/mk56-spn/orgs","repos_url":"https://api.github.com/users/mk56-spn/repos","events_url":"https://api.github.com/users/mk56-spn/events{/privacy}","received_events_url":"https://api.github.com/users/mk56-spn/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-01-12T23:22:18Z","updated_at":"2025-01-12T23:22:18Z","body":"> I tested this PR and #99210 is much better UX-wise. Resizing mesh in 2D editor will change scale instead of mesh size and there are no convenient options for converting to other types.\r\n> \r\n> Although the proposal pretty much only requests something to draw shapes, so this PR does the job too I guess. EDIT: Although it's interesting that for an arguably simpler solution, it introduces almost twice as much code.\r\n\r\nI don't have the ability to comment on UX and code quality stuff but i can say that *that* PR does not offer near the same convenience for certain work flows .\r\n\r\nFor example this PR allows making meshes you can pretty much directly throw at the rendering server. for the other pr such usage would require instantiating the node in code then generating the meshinstance2D from the nodes drop-down then getting and saving the mesh from that meshinstance and then using it on the rendering server, which is comically obtuse\r\n\r\nmaybe i'm wrong and a step or two can be spared but it stands that these do not  ( imo ) target the same use cases an should not be seen as true alternatives ( not necessarily saying you are treating them as such ) ","author_association":"NONE","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2585960901/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2588905404","html_url":"https://github.com/godotengine/godot/pull/100574#issuecomment-2588905404","issue_url":"https://api.github.com/repos/godotengine/godot/issues/100574","id":2588905404,"node_id":"IC_kwDOAO6SJc6aT4-8","user":{"login":"kitbdev","id":10054226,"node_id":"MDQ6VXNlcjEwMDU0MjI2","avatar_url":"https://avatars.githubusercontent.com/u/10054226?v=4","gravatar_id":"","url":"https://api.github.com/users/kitbdev","html_url":"https://github.com/kitbdev","followers_url":"https://api.github.com/users/kitbdev/followers","following_url":"https://api.github.com/users/kitbdev/following{/other_user}","gists_url":"https://api.github.com/users/kitbdev/gists{/gist_id}","starred_url":"https://api.github.com/users/kitbdev/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/kitbdev/subscriptions","organizations_url":"https://api.github.com/users/kitbdev/orgs","repos_url":"https://api.github.com/users/kitbdev/repos","events_url":"https://api.github.com/users/kitbdev/events{/privacy}","received_events_url":"https://api.github.com/users/kitbdev/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-01-14T04:10:21Z","updated_at":"2025-01-14T04:10:21Z","body":"\r\nNote that this also adds these options to MeshInstance3D as well. They work, so I don't think it is an issue.\r\n\r\n\r\nWhen a capsule is at its minimum height to radius ratio and anti-aliasing is on a line shows:\r\n\r\n![Screenshot 2024-12-28 140607](https://github.com/user-attachments/assets/2c6046c9-e028-4254-89a8-b1ae2c0bdd9a)\r\n\r\n\r\nUsing the circle to make polygons would be better if they pointed up instead of down.\r\n\r\nThere is no way to make a right triangle with these, but I don't know how much demand there is for it.\r\n\r\nCompared to #99210 sizes are changed from 128x128 to 20x20, I feel like that is a bit small but maybe its just me.\r\n\r\nThis could have custom handles like the CollisionShape2DEditor for better usability so resizing doesn't scale.\r\n\r\nThere is no conversion to other types, and it is trickier since it is not stored as a polygon.\r\n\r\nI was thinking that there could be an alternate way to define the 2D shapes to make the code smaller and easier to use. Since they are all 2D, they can be defined by a polygon (a list of points). It can convert the points into the required mesh vertices, indexes, and UVs. This would be on top of the regular functionality so it is optional. All the antialiasing (or outlines if added) could be added there and generically used for all of the shapes. If it is stored it would also be useful to convert into other types in the Editor. I guess its is pretty similar to what Polygon2D does, but saved in a Mesh Resource.\r\n\r\n- Resources are generally harder to use for beginners, but its a separate issue: https://github.com/godotengine/godot-proposals/issues/9603\r\n\r\nIf all of this can be done, I think the UX would be better than #99210.\r\nLots of it can be done in future PRs as well.\r\n","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2588905404/reactions","total_count":2,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":2,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4423857106","html_url":"https://github.com/godotengine/godot/pull/100574#issuecomment-4423857106","issue_url":"https://api.github.com/repos/godotengine/godot/issues/100574","id":4423857106,"node_id":"IC_kwDOAO6SJc8AAAABB66z0g","user":{"login":"rburing","id":229837,"node_id":"MDQ6VXNlcjIyOTgzNw==","avatar_url":"https://avatars.githubusercontent.com/u/229837?v=4","gravatar_id":"","url":"https://api.github.com/users/rburing","html_url":"https://github.com/rburing","followers_url":"https://api.github.com/users/rburing/followers","following_url":"https://api.github.com/users/rburing/following{/other_user}","gists_url":"https://api.github.com/users/rburing/gists{/gist_id}","starred_url":"https://api.github.com/users/rburing/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/rburing/subscriptions","organizations_url":"https://api.github.com/users/rburing/orgs","repos_url":"https://api.github.com/users/rburing/repos","events_url":"https://api.github.com/users/rburing/events{/privacy}","received_events_url":"https://api.github.com/users/rburing/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-05-11T18:55:46Z","updated_at":"2026-05-11T18:55:46Z","body":"Rebased after 1.5 years of changes to the Godot code base.\r\n\r\nThanks for all the feedback, I'll see if it's possible to salvage this approach.","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4423857106/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null}]