.github.com/users/KoBeWi/followers","following_url":"https://api.github.com/users/KoBeWi/following{/other_user}","gists_url":"https://api.github.com/users/KoBeWi/gists{/gist_id}","starred_url":"https://api.github.com/users/KoBeWi/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/KoBeWi/subscriptions","organizations_url":"https://api.github.com/users/KoBeWi/orgs","repos_url":"https://api.github.com/users/KoBeWi/repos","events_url":"https://api.github.com/users/KoBeWi/events{/privacy}","received_events_url":"https://api.github.com/users/KoBeWi/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2024-12-26T13:52:44Z","updated_at":"2024-12-26T13:52:44Z","body":"That's not how you add custom menu options. Use EditorContextMenuPlugin instead.\nYour addon hacks into editor's popup menu, which is not guaranteed to work. If you still want to do it this way, use an ID that doesn't conflict with plugin options, e.g. 500.","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2562764338/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2563525795","html_url":"https://github.com/godotengine/godot/issues/100190#issuecomment-2563525795","issue_url":"https://api.github.com/repos/godotengine/godot/issues/100190","id":2563525795,"node_id":"IC_kwDOAO6SJc6YzEyj","user":{"login":"MikeSchulze","id":347037,"node_id":"MDQ6VXNlcjM0NzAzNw==","avatar_url":"https://avatars.githubusercontent.com/u/347037?v=4","gravatar_id":"","url":"https://api.github.com/users/MikeSchulze","html_url":"https://github.com/MikeSchulze","followers_url":"https://api.github.com/users/MikeSchulze/followers","following_url":"https://api.github.com/users/MikeSchulze/following{/other_user}","gists_url":"https://api.github.com/users/MikeSchulze/gists{/gist_id}","starred_url":"https://api.github.com/users/MikeSchulze/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/MikeSchulze/subscriptions","organizations_url":"https://api.github.com/users/MikeSchulze/orgs","repos_url":"https://api.github.com/users/MikeSchulze/repos","events_url":"https://api.github.com/users/MikeSchulze/events{/privacy}","received_events_url":"https://api.github.com/users/MikeSchulze/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2024-12-27T09:55:03Z","updated_at":"2024-12-27T09:55:03Z","body":"> That's not how you add custom menu options. Use EditorContextMenuPlugin instead. Your addon hacks into editor's popup menu, which is not guaranteed to work. If you still want to do it this way, use an ID that doesn't conflict with plugin options, e.g. 500.\n\nThanks for your answer, I will take a look on `EditorContextMenuPlugin`.\nThe code was based on Godot3 and never updated to Godot4 API.\n\n","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2563525795/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2564281213","html_url":"https://github.com/godotengine/godot/issues/100190#issuecomment-2564281213","issue_url":"https://api.github.com/repos/godotengine/godot/issues/100190","id":2564281213,"node_id":"IC_kwDOAO6SJc6Y19N9","user":{"login":"MikeSchulze","id":347037,"node_id":"MDQ6VXNlcjM0NzAzNw==","avatar_url":"https://avatars.githubusercontent.com/u/347037?v=4","gravatar_id":"","url":"https://api.github.com/users/MikeSchulze","html_url":"https://github.com/MikeSchulze","followers_url":"https://api.github.com/users/MikeSchulze/followers","following_url":"https://api.github.com/users/MikeSchulze/following{/other_user}","gists_url":"https://api.github.com/users/MikeSchulze/gists{/gist_id}","starred_url":"https://api.github.com/users/MikeSchulze/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/MikeSchulze/subscriptions","organizations_url":"https://api.github.com/users/MikeSchulze/orgs","repos_url":"https://api.github.com/users/MikeSchulze/repos","events_url":"https://api.github.com/users/MikeSchulze/events{/privacy}","received_events_url":"https://api.github.com/users/MikeSchulze/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2024-12-28T09:36:00Z","updated_at":"2024-12-28T09:38:07Z","body":"@KoBeWi using the suggested `EditorContextMenuPlugin` has some limitations.\nThere is no option to control the enable/disable state of a context menu item.\nAnd this new `EditorContextMenuPlugin` is only available on Godot 4.4.x, but I need to be downwards compatible.\n\nWill result into custom implementation for 4,4.x and lower than 4.4 ;/","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2564281213/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2564282711","html_url":"https://github.com/godotengine/godot/issues/100190#issuecomment-2564282711","issue_url":"https://api.github.com/repos/godotengine/godot/issues/100190","id":2564282711,"node_id":"IC_kwDOAO6SJc6Y19lX","user":{"login":"KoBeWi","id":2223172,"node_id":"MDQ6VXNlcjIyMjMxNzI=","avatar_url":"https://avatars.githubusercontent.com/u/2223172?v=4","gravatar_id":"","url":"https://api.github.com/users/KoBeWi","html_url":"https://github.com/KoBeWi","followers_url":"https://api.github.com/users/KoBeWi/followers","following_url":"https://api.github.com/users/KoBeWi/following{/other_user}","gists_url":"https://api.github.com/users/KoBeWi/gists{/gist_id}","starred_url":"https://api.github.com/users/KoBeWi/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/KoBeWi/subscriptions","organizations_url":"https://api.github.com/users/KoBeWi/orgs","repos_url":"https://api.github.com/users/KoBeWi/repos","events_url":"https://api.github.com/users/KoBeWi/events{/privacy}","received_events_url":"https://api.github.com/users/KoBeWi/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2024-12-28T09:43:44Z","updated_at":"2024-12-28T09:45:29Z","body":"Well as I said, you can use your old method, just change the used ID to avoid errors. 200-999 is a safe range. Note however that these values are not documented and can change at any moment.\n\n> There is no option to control the enable/disable state of a context menu item.\n\nWe could add `disabled` argument to `add_context_` methods. Though, since the menu is re-created every time, you can skip adding the option.","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2564282711/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2564285735","html_url":"https://github.com/godotengine/godot/issues/100190#issuecomment-2564285735","issue_url":"https://api.github.com/repos/godotengine/godot/issues/100190","id":2564285735,"node_id":"IC_kwDOAO6SJc6Y1-Un","user":{"login":"MikeSchulze","id":347037,"node_id":"MDQ6VXNlcjM0NzAzNw==","avatar_url":"https://avatars.githubusercontent.com/u/347037?v=4","gravatar_id":"","url":"https://api.github.com/users/MikeSchulze","html_url":"https://github.com/MikeSchulze","followers_url":"https://api.github.com/users/MikeSchulze/followers","following_url":"https://api.github.com/users/MikeSchulze/following{/other_user}","gists_url":"https://api.github.com/users/MikeSchulze/gists{/gist_id}","starred_url":"https://api.github.com/users/MikeSchulze/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/MikeSchulze/subscriptions","organizations_url":"https://api.github.com/users/MikeSchulze/orgs","repos_url":"https://api.github.com/users/MikeSchulze/repos","events_url":"https://api.github.com/users/MikeSchulze/events{/privacy}","received_events_url":"https://api.github.com/users/MikeSchulze/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2024-12-28T10:01:59Z","updated_at":"2024-12-28T10:04:43Z","body":"> We could add disabled argument to add_context_ methods. Though, since the menu is re-created every time, you can skip adding the option.\n\nNo, I want to have the enabled/disabled state, I suggest being supported in the upcoming versions.\n![Image](https://github.com/user-attachments/assets/d47bff10-253c-420a-b210-06e20db3d3ed)\nThe undo/redo has also the disabled state\n\nAnd this new `EditorContextMenuPlugin` is only available on Godot 4.4.x, but I need to be downwards compatible.\n\nWill result into custom implementation for 4,4.x and lower than 4.4 ;/\nAnd use a hack to be downwards compatible, otherwise I have compiling issues in Godot 4.3\n\njust Godot 4.4.x code\n```\n   _gd_filesystem_context_menu = EditorFileSystemContextMenuHandler.new()\n   add_context_menu_plugin(EditorContextMenuPlugin.CONTEXT_SLOT_FILESYSTEM, _gd_filesystem_context_menu)\n```\n\n\nBut need to convert to be downwards compatible and prevent compile issues.\n```\n# we need to define manually the slot id, to be downwards compatible\nconst CONTEXT_SLOT_FILESYSTEM = 1 # EditorContextMenuPlugin.CONTEXT_SLOT_FILESYSTEM\n\n...\n\nif Engine.get_version_info().hex >= 0x40400:\n\t\tvar context_menue_script := GDScript.new()\n\t\tcontext_menue_script.source_code = FileAccess.get_file_as_string(\"res://addons/gdUnit4/src/ui/menu/EditorFileSystemContextMenuHandlerV44.gdx\")\n\t\tcontext_menue_script.reload()\n\t\t_gd_filesystem_context_menu = context_menue_script.new()\n\t\tcall_deferred(\"add_context_menu_plugin\", CONTEXT_SLOT_FILESYSTEM, _gd_filesystem_context_menu)\n```\nI need to store the GDScript with a different extension to be not parsed at editor startup to prevent loading errors ;(","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2564285735/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2564286853","html_url":"https://github.com/godotengine/godot/issues/100190#issuecomment-2564286853","issue_url":"https://api.github.com/repos/godotengine/godot/issues/100190","id":2564286853,"node_id":"IC_kwDOAO6SJc6Y1-mF","user":{"login":"KoBeWi","id":2223172,"node_id":"MDQ6VXNlcjIyMjMxNzI=","avatar_url":"https://avatars.githubusercontent.com/u/2223172?v=4","gravatar_id":"","url":"https://api.github.com/users/KoBeWi","html_url":"https://github.com/KoBeWi","followers_url":"https://api.github.com/users/KoBeWi/followers","following_url":"https://api.github.com/users/KoBeWi/following{/other_user}","gists_url":"https://api.github.com/users/KoBeWi/gists{/gist_id}","starred_url":"https://api.github.com/users/KoBeWi/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/KoBeWi/subscriptions","organizations_url":"https://api.github.com/users/KoBeWi/orgs","repos_url":"https://api.github.com/users/KoBeWi/repos","events_url":"https://api.github.com/users/KoBeWi/events{/privacy}","received_events_url":"https://api.github.com/users/KoBeWi/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2024-12-28T10:06:36Z","updated_at":"2024-12-28T10:06:36Z","body":"Eh, I think it deserves a proposal. Adding a disabled state means you might want tooltips and whatever else PopupMenu supports.\nAdding more arguments might become unwieldy, maybe it could be a new method, like `customize_last_item()`.","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2564286853/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2564294625","html_url":"https://github.com/godotengine/godot/issues/100190#issuecomment-2564294625","issue_url":"https://api.github.com/repos/godotengine/godot/issues/100190","id":2564294625,"node_id":"IC_kwDOAO6SJc6Y2Afh","user":{"login":"MikeSchulze","id":347037,"node_id":"MDQ6VXNlcjM0NzAzNw==","avatar_url":"https://avatars.githubusercontent.com/u/347037?v=4","gravatar_id":"","url":"https://api.github.com/users/MikeSchulze","html_url":"https://github.com/MikeSchulze","followers_url":"https://api.github.com/users/MikeSchulze/followers","following_url":"https://api.github.com/users/MikeSchulze/following{/other_user}","gists_url":"https://api.github.com/users/MikeSchulze/gists{/gist_id}","starred_url":"https://api.github.com/users/MikeSchulze/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/MikeSchulze/subscriptions","organizations_url":"https://api.github.com/users/MikeSchulze/orgs","repos_url":"https://api.github.com/users/MikeSchulze/repos","events_url":"https://api.github.com/users/MikeSchulze/events{/privacy}","received_events_url":"https://api.github.com/users/MikeSchulze/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2024-12-28T10:50:34Z","updated_at":"2024-12-28T10:50:34Z","body":"\n> Eh, I think it deserves a proposal. Adding a disabled state means you might want tooltips and whatever else PopupMenu supports. Adding more arguments might become unwieldy, maybe it could be a new method, lik