rt_get_measured_render_time_gpu(viewport_rid)\n\tprint(\"time_cpu \", time_cpu)\n\tprint(\"time_gpu \", time_gpu)\n```\n\n","closed_by":{"login":"Calinou","id":180032,"node_id":"MDQ6VXNlcjE4MDAzMg==","avatar_url":"https://avatars.githubusercontent.com/u/180032?v=4","gravatar_id":"","url":"https://api.github.com/users/Calinou","html_url":"https://github.com/Calinou","followers_url":"https://api.github.com/users/Calinou/followers","following_url":"https://api.github.com/users/Calinou/following{/other_user}","gists_url":"https://api.github.com/users/Calinou/gists{/gist_id}","starred_url":"https://api.github.com/users/Calinou/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Calinou/subscriptions","organizations_url":"https://api.github.com/users/Calinou/orgs","repos_url":"https://api.github.com/users/Calinou/repos","events_url":"https://api.github.com/users/Calinou/events{/privacy}","received_events_url":"https://api.github.com/users/Calinou/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/106273/reactions","total_count":2,"+1":2,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/godotengine/godot/issues/106273/timeline","performed_via_github_app":null,"state_reason":"completed","pinned_comment":null}