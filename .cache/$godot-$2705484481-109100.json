ce","id":2308167,"node_id":"MDQ6VXNlcjIzMDgxNjc=","login":"Ivorforce","type":"User","owned_private_repos":0,"public_gists":0,"public_repos":0,"total_private_repos":0,"url":"https://api.github.com/users/Ivorforce"},"body":"I'm happy to see that fixed points solve the issue for good! :)\n\nThe new version looks kinda slow. I suppose it's not used in any performance critical operations (just UI)?","html_url":"https://github.com/godotengine/godot/pull/109100#pullrequestreview-3110065180","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/109100","author_association":"MEMBER","submitted_at":"2025-08-12T11:47:16Z"},{"id":3110101762,"node_id":"PRR_kwDOAO6SJc65YGMC","state":"APPROVED","commit_id":"af8bdac5a9fadda049acc3f40cbcbc5f43fffe7d","user":{"site_admin":false,"suspended":false,"updated_at":"0001-01-01T00:00:00Z","avatar_url":"https://avatars.githubusercontent.com/u/2308167?u=f7f8e0273f784f5ec6f6b7fe4a88d449896eb48a&v=4","created_at":"0001-01-01T00:00:00Z","followers":0,"following":0,"html_url":"https://github.com/Ivorforce","id":2308167,"node_id":"MDQ6VXNlcjIzMDgxNjc=","login":"Ivorforce","type":"User","owned_private_repos":0,"public_gists":0,"public_repos":0,"total_private_repos":0,"url":"https://api.github.com/users/Ivorforce"},"body":"","html_url":"https://github.com/godotengine/godot/pull/109100#pullrequestreview-3110101762","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/109100","author_association":"MEMBER","submitted_at":"2025-08-12T11:53:33Z"}]