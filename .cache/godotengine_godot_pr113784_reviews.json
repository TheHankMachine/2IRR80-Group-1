users/jrouwe/events{/privacy}","received_events_url":"https://api.github.com/users/jrouwe/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"I think this is a solid solution to the problem. After fixing these minor issues I would say it's good to go.","state":"CHANGES_REQUESTED","html_url":"https://github.com/godotengine/godot/pull/113784#pullrequestreview-3835599267","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/113784","author_association":"CONTRIBUTOR","_links":{"html":{"href":"https://github.com/godotengine/godot/pull/113784#pullrequestreview-3835599267"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/113784"}},"submitted_at":"2026-02-21T14:41:44Z","commit_id":null},{"id":3837033568,"node_id":"PRR_kwDOAO6SJc7ktHxg","user":{"login":"jrouwe","id":1621693,"node_id":"MDQ6VXNlcjE2MjE2OTM=","avatar_url":"https://avatars.githubusercontent.com/u/1621693?u=14b293a7095d074e6653d7ad73269a5e785e1399&v=4","gravatar_id":"","url":"https://api.github.com/users/jrouwe","html_url":"https://github.com/jrouwe","followers_url":"https://api.github.com/users/jrouwe/followers","following_url":"https://api.github.com/users/jrouwe/following{/other_user}","gists_url":"https://api.github.com/users/jrouwe/gists{/gist_id}","starred_url":"https://api.github.com/users/jrouwe/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/jrouwe/subscriptions","organizations_url":"https://api.github.com/users/jrouwe/orgs","repos_url":"https://api.github.com/users/jrouwe/repos","events_url":"https://api.github.com/users/jrouwe/events{/privacy}","received_events_url":"https://api.github.com/users/jrouwe/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"","state":"APPROVED","html_url":"https://github.com/godotengine/godot/pull/113784#pullrequestreview-3837033568","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/113784","author_association":"CONTRIBUTOR","_links":{"html":{"href":"https://github.com/godotengine/godot/pull/113784#pullrequestreview-3837033568"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/113784"}},"submitted_at":"2026-02-22T08:40:04Z","commit_id":"5e02a2ed0c2bd67f999c30c37bdeff8a2f403435"},{"id":3836967287,"node_id":"PRR_kwDOAO6SJc7ks3l3","user":{"login":"mihe","id":4884246,"node_id":"MDQ6VXNlcjQ4ODQyNDY=","avatar_url":"https://avatars.githubusercontent.com/u/4884246?v=4","gravatar_id":"","url":"https://api.github.com/users/mihe","html_url":"https://github.com/mihe","followers_url":"https://api.github.com/users/mihe/followers","following_url":"https://api.github.com/users/mihe/following{/other_user}","gists_url":"https://api.github.com/users/mihe/gists{/gist_id}","starred_url":"https://api.github.com/users/mihe/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/mihe/subscriptions","organizations_url":"https://api.github.com/users/mihe/orgs","repos_url":"https://api.github.com/users/mihe/repos","events_url":"https://api.github.com/users/mihe/events{/privacy}","received_events_url":"https://api.github.com/users/mihe/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"As mentioned [elsewhere](https://github.com/godotengine/godot/pull/113654#issuecomment-3627032492), I do think this is the preferrable approach to this problem. However, outside of the review comments I have a few (mostly cosmetic) concerns:\n\n1. The name `flush_kinematic_transform()` bothers me a bit, since we now have three different terms to refer to this kind of thing, with this using \"flush\", `Node*D.force_update_transform()` using \"force update\" and `Node.reset_physics_interpolation()` using \"reset\". I can't help but feel like this should be called `force_update_kinematic_transform()` instead, but I'd be curious to hear more thoughts on this.\n1. I feel like the new project setting deserves to be in its own \"Compatibility\" sub-category, i.e. `physics/*d/compatibility/kinematic_body_initial_teleport`, similar to `animation/compatibility/default_parent_skeleton_in_mesh_instance_3d`.\n1. Very few will ever see the note for `BODY_MODE_KINEMATIC` in the `PhysicsServer*D` documentation, which seems like a shame. We should mention this new method and the general behavior of kinematic transform changes in the class descriptions of `CharacterBody3D` and `AnimatableBody3D`, and maybe even `RigidBody3D` as well. Although, I believe the (somewhat broken) `sync_to_physics` property in `AnimatableBody3D` might complicate this a bit.\n1. The documentation for this should be clearer about *why* we don't immediately move the transform of kinematic bodies. Just mentioning that a teleport will happen when calling this new method assumes too much of the reader, in my opinion.","state":"CHANGES_REQUESTED","html_url":"https://github.com/godotengine/godot/pull/113784#pullrequestreview-3836967287","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/113784","author_association":"CONTRIBUTOR","_links":{"html":{"href":"https://github.com/godotengine/godot/pull/113784#pullrequestreview-3836967287"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/113784"}},"submitted_at":"2026-02-22T09:37:43Z","commit_id":"5e02a2ed0c2bd67f999c30c37bdeff8a2f403435"}]