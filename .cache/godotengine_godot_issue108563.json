chived_at":null,"archived_by":null},{"id":279098219,"node_id":"MDU6TGFiZWwyNzkwOTgyMTk=","url":"https://api.github.com/repos/godotengine/godot/labels/topic:editor","name":"topic:editor","color":"ffee88","default":false,"description":"","archived_at":null,"archived_by":null}],"state":"open","locked":false,"assignees":[],"milestone":{"url":"https://api.github.com/repos/godotengine/godot/milestones/16","html_url":"https://github.com/godotengine/godot/milestone/16","labels_url":"https://api.github.com/repos/godotengine/godot/milestones/16/labels","id":8237783,"node_id":"MI_kwDOAO6SJc4AfbLX","number":16,"title":"4.x","description":"Issues and pull requests slated for an undetermined Godot 4 release.","creator":{"login":"akien-mga","id":4701338,"node_id":"MDQ6VXNlcjQ3MDEzMzg=","avatar_url":"https://avatars.githubusercontent.com/u/4701338?v=4","gravatar_id":"","url":"https://api.github.com/users/akien-mga","html_url":"https://github.com/akien-mga","followers_url":"https://api.github.com/users/akien-mga/followers","following_url":"https://api.github.com/users/akien-mga/following{/other_user}","gists_url":"https://api.github.com/users/akien-mga/gists{/gist_id}","starred_url":"https://api.github.com/users/akien-mga/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/akien-mga/subscriptions","organizations_url":"https://api.github.com/users/akien-mga/orgs","repos_url":"https://api.github.com/users/akien-mga/repos","events_url":"https://api.github.com/users/akien-mga/events{/privacy}","received_events_url":"https://api.github.com/users/akien-mga/received_events","type":"User","user_view_type":"public","site_admin":false},"open_issues":5793,"closed_issues":0,"state":"open","created_at":"2022-07-26T12:42:05Z","updated_at":"2026-10-22T14:39:14Z","due_on":null,"closed_at":null},"comments":4,"created_at":"2025-07-12T22:53:49Z","updated_at":"2026-07-14T12:37:12Z","closed_at":null,"assignee":null,"author_association":"CONTRIBUTOR","issue_field_values":[],"type":null,"active_lock_reason":null,"draft":true,"pull_request":{"url":"https://api.github.com/repos/godotengine/godot/pulls/108563","html_url":"https://github.com/godotengine/godot/pull/108563","diff_url":"https://github.com/godotengine/godot/pull/108563.diff","patch_url":"https://github.com/godotengine/godot/pull/108563.patch","merged_at":null},"body":"Fixes #104548\r\nFixes #78983\r\n\r\nWhen you add a new start bracket or quotation mark it checks whether it closed any existing brackets or strings on the current line. If it did then it avoids automatically adding an additional end bracket.\r\n\r\nBefore:\r\n\r\nhttps://github.com/user-attachments/assets/adc3a873-a062-4ce9-b16e-bb58fa830925\r\n\r\nAfter:\r\n\r\nhttps://github.com/user-attachments/assets/8eae7625-37df-4df2-aa45-9a6f6207be9c\r\n\r\nMore examples of the auto brace completion being aware of its surroundings:\r\n\r\nhttps://github.com/user-attachments/assets/0137e3d4-8324-4954-a11a-6601fe589871\r\n\r\nFor performance reasons it only checks for other brackets on the same line. It could however be extended to check multiple lines if that is desired. When creating brackets inside a string it only checks for other brackets inside that string instead of the whole line.\r\nI have tested it with a bunch of different bracket combinations to make sure auto brace completion still works when it needs to. I have also tested it with multiple cursors.\r\n\r\n_Member edit:_\r\n- _Probably fixes https://github.com/godotengine/godot/issues/85195_","closed_by":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/108563/reactions","total_count":25,"+1":17,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":5,"rocket":0,"eyes":3},"timeline_url":"https://api.github.com/repos/godotengine/godot/issues/108563/timeline","performed_via_github_app":null,"state_reason":null}