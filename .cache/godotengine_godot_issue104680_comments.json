d}","starred_url":"https://api.github.com/users/Calinou/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Calinou/subscriptions","organizations_url":"https://api.github.com/users/Calinou/orgs","repos_url":"https://api.github.com/users/Calinou/repos","events_url":"https://api.github.com/users/Calinou/events{/privacy}","received_events_url":"https://api.github.com/users/Calinou/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-03-27T23:49:03Z","updated_at":"2025-03-27T23:49:03Z","body":"Reopening, as we should address this if possible (or at least document this limitation).","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2759838307/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2759905057","html_url":"https://github.com/godotengine/godot/issues/104680#issuecomment-2759905057","issue_url":"https://api.github.com/repos/godotengine/godot/issues/104680","id":2759905057,"node_id":"IC_kwDOAO6SJc6kgM8h","user":{"login":"neomart100","id":54541062,"node_id":"MDQ6VXNlcjU0NTQxMDYy","avatar_url":"https://avatars.githubusercontent.com/u/54541062?v=4","gravatar_id":"","url":"https://api.github.com/users/neomart100","html_url":"https://github.com/neomart100","followers_url":"https://api.github.com/users/neomart100/followers","following_url":"https://api.github.com/users/neomart100/following{/other_user}","gists_url":"https://api.github.com/users/neomart100/gists{/gist_id}","starred_url":"https://api.github.com/users/neomart100/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/neomart100/subscriptions","organizations_url":"https://api.github.com/users/neomart100/orgs","repos_url":"https://api.github.com/users/neomart100/repos","events_url":"https://api.github.com/users/neomart100/events{/privacy}","received_events_url":"https://api.github.com/users/neomart100/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-03-28T00:52:17Z","updated_at":"2025-03-28T00:52:17Z","body":"After doing several tests this godot 4.4 has serious problems with transparencies, since in embedded screen mode and floating screen mode it is black if you export the game unless it is in full screen mode it will not be transparent but black.\n\n![Image](https://github.com/user-attachments/assets/3403ac1e-5333-49fb-8f44-d44258238f5f)\n\nyou can't use mouse_passthrough because it requires to be in windowed or borderless window mode, which is impossible with godot 4.4(and its version 4.4.1) in case you want to make games like Rusty's Retirement or similar games where you have a part of the screen transparent it doesn't work in godot 4.4 but in godot 4.3 it works perfectly.\n","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2759905057/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2764366974","html_url":"https://github.com/godotengine/godot/issues/104680#issuecomment-2764366974","issue_url":"https://api.github.com/repos/godotengine/godot/issues/104680","id":2764366974,"node_id":"IC_kwDOAO6SJc6kxOR-","user":{"login":"white0dew","id":49017390,"node_id":"MDQ6VXNlcjQ5MDE3Mzkw","avatar_url":"https://avatars.githubusercontent.com/u/49017390?v=4","gravatar_id":"","url":"https://api.github.com/users/white0dew","html_url":"https://github.com/white0dew","followers_url":"https://api.github.com/users/white0dew/followers","following_url":"https://api.github.com/users/white0dew/following{/other_user}","gists_url":"https://api.github.com/users/white0dew/gists