archived_at":null,"archived_by":null}],"state":"closed","locked":false,"assignees":[],"milestone":{"url":"https://api.github.com/repos/godotengine/godot/milestones/25","html_url":"https://github.com/godotengine/godot/milestone/25","labels_url":"https://api.github.com/repos/godotengine/godot/milestones/25/labels","id":15520464,"node_id":"MI_kwDOAO6SJc4A7NLQ","number":25,"title":"4.8","description":"","creator":{"login":"Repiteo","id":17489292,"node_id":"MDQ6VXNlcjE3NDg5Mjky","avatar_url":"https://avatars.githubusercontent.com/u/17489292?v=4","gravatar_id":"","url":"https://api.github.com/users/Repiteo","html_url":"https://github.com/Repiteo","followers_url":"https://api.github.com/users/Repiteo/followers","following_url":"https://api.github.com/users/Repiteo/following{/other_user}","gists_url":"https://api.github.com/users/Repiteo/gists{/gist_id}","starred_url":"https://api.github.com/users/Repiteo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Repiteo/subscriptions","organizations_url":"https://api.github.com/users/Repiteo/orgs","repos_url":"https://api.github.com/users/Repiteo/repos","events_url":"https://api.github.com/users/Repiteo/events{/privacy}","received_events_url":"https://api.github.com/users/Repiteo/received_events","type":"User","user_view_type":"public","site_admin":false},"open_issues":343,"closed_issues":2335,"state":"open","created_at":"2026-04-13T15:59:35Z","updated_at":"2026-10-22T06:28:22Z","due_on":null,"closed_at":null},"comments":4,"created_at":"2026-08-19T01:53:06Z","updated_at":"2026-08-19T17:35:36Z","closed_at":"2026-08-19T17:22:26Z","assignee":null,"author_association":"CONTRIBUTOR","issue_field_values":[],"type":null,"active_lock_reason":null,"draft":false,"pull_request":{"url":"https://api.github.com/repos/godotengine/godot/pulls/122575","html_url":"https://github.com/godotengine/godot/pull/122575","diff_url":"https://github.com/godotengine/godot/pull/122575.diff","patch_url":"https://github.com/godotengine/godot/pull/122575.patch","merged_at":"2026-08-19T17:22:26Z"},"body":"## What problem(s) does this PR solve?\r\n\r\nMakes the code easier to read. Also 1 less extra reference call.\r\nWhile I was at it, I also changed `Vector` to `LocalVector`, because it's only used here and not being copied anywhere (well I guess it can be said to be copied, but it's not copied as `Vector`).\r\n\r\n## Additional information\r\n\r\nThe `source` variant is already doing the ref init in the same place, so it also keeps it alive. Now we had 2 things that kept `this` alive, which is 1 too many.\r\n\r\nAfter reading https://github.com/godotengine/godot/pull/109770#issuecomment-3201478331 and doing some tests to understand why we can ref init `this` normally through `Variant`, I arrived at conclusion: \r\n\r\nWe can ref init in this place, because it is placed after trying to find the signal with `signal_map.getptr` and returning early if we couldn't find the signal data. Returning early is the important part. Because the signal map is lazily populated, the signal data is only created when the first connection to the signal is made. Because of that we only need to worry about the ref init potentially destroying `this` if we connect the callable and call `emit_signalp` on the same signal inside the constructor of the ref counted type.\r\n\r\nIf we need to support such situation, I think we can use `alloca` and `VariantInternal::object_assign_without_ref_unsafe` on `source` I guess? But it will need more code, and also will need a branch in case `reference()` failed (someone could emit signal in predelete in a native type for example). Do we need to support such situation?\r\n\r\nSidenote, it was really strange reading such a long comment about why we need to avoid the ref init and then just seeing ref init being used a couple of lines later.","closed_by":{"login":"Repiteo","id":17489292,"node_id":"MDQ6VXNlcjE3NDg5Mjky","avatar_url":"https://avatars.githubusercontent.com/u/17489292?v=4","grava