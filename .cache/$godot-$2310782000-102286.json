test_pr_102286.zip)\r\n\r\nNote that it won't work if the CSGBox you're moving is a child of the CSGCombiner3D with the collision on it. It will just pass through instead:\r\n\r\nhttps://github.com/user-attachments/assets/41a9cfbe-4601-414d-ac92-d7b87e30df0c\r\n\r\nThis may be difficult to resolve though, given the collision shape is regenerating itself in real-time when you're moving the object (and you don't want the object to collide with itself as you're repositioning it).\r\n\r\nPS: I noticed that we can pan, zoom and orbit while using physics-based repositioning, but not when using the translate/rotate/style Blender-style manipulation shortcuts. It would be good to look into unlocking those options if they don't conflict with anything else (in a separate PR).\r\n","html_url":"https://github.com/godotengine/godot/pull/102286#pullrequestreview-2607210457","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/102286","author_association":"MEMBER","submitted_at":"2025-02-10T21:27:21Z"},{"id":2607214437,"node_id":"PRR_kwDOAO6SJc6bZu9l","state":"COMMENTED","user":{"site_admin":false,"suspended":false,"updated_at":"0001-01-01T00:00:00Z","avatar_url":"https://avatars.githubusercontent.com/u/180032?u=68d23e7ee9cdf810da125e8510b72f845b9dccc8&v=4","created_at":"0001-01-01T00:00:00Z","followers":0,"following":0,"html_url":"https://github.com/Calinou","id":180032,"node_id":"MDQ6VXNlcjE4MDAzMg==","login":"Calinou","type":"User","owned_private_repos":0,"public_gists":0,"public_repos":0,"total_private_repos":0,"url":"https://api.github.com/users/Calinou"},"body":"","html_url":"https://github.com/godotengine/godot/pull/102286#pullrequestreview-2607214437","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/102286","author_association":"MEMBER","submitted_at":"2025-02-10T21:28:45Z"},{"id":2610259071,"node_id":"PRR_kwDOAO6SJc6blWR_","state":"COMMENTED","user":{"site_admin":false,"suspended":false,"updated_at":"0001-01-01T00:00:00Z","avatar