d":279097326,"node_id":"MDU6TGFiZWwyNzkwOTczMjY=","url":"https://api.github.com/repos/godotengine/godot/labels/platform:linuxbsd","name":"platform:linuxbsd","color":"e4e4e4","default":false,"description":"","archived_at":null,"archived_by":null}],"state":"closed","locked":false,"assignees":[],"milestone":null,"comments":1,"created_at":"2026-07-12T12:38:23Z","updated_at":"2026-07-12T23:29:05Z","closed_at":"2026-07-12T21:07:06Z","assignee":null,"author_association":"CONTRIBUTOR","issue_field_values":[],"type":null,"active_lock_reason":null,"draft":false,"pull_request":{"url":"https://api.github.com/repos/godotengine/godot/pulls/121281","html_url":"https://github.com/godotengine/godot/pull/121281","diff_url":"https://github.com/godotengine/godot/pull/121281.diff","patch_url":"https://github.com/godotengine/godot/pull/121281.patch","merged_at":null},"body":"## What problem(s) does this PR solve?\r\n\r\n- Closes #121218\r\n\r\n## Additional information\r\n\r\nOn Wayland, an outside press used to close a popup was consumed only after it had entered double-click detection. Wayland could also process a queued reopening press before the popup's deferred hide completed.\r\n\r\nThis change yields event processing after requesting the popup close, allowing the deferred hide to run before later input. It also prevents the discarded press from causing the next non-wheel press to be reported as a double-click, and avoids waiting for a frame while yielding.\r\n\r\nGodot's pre-commit checks pass, and the changed Wayland translation unit compiles on Ubuntu 22.04 ARM64 with strict developer checks and `-Werror`.\r\n\r\nNative interactive Wayland verification is still requested.","closed_by":{"login":"Ivorforce","id":2308167,"node_id":"MDQ6VXNlcjIzMDgxNjc=","avatar_url":"https://avatars.githubusercontent.com/u/2308167?v=4","gravatar_id":"","url":"https://api.github.com/users/Ivorforce","html_url":"https://github.com/Ivorforce","followers_url":"https://api.github.com/users/Ivorforce/followers","following_url":"https://api.github.com/users/Ivorforce/following{/other_user}","gists_url":"https://api.github.com/users/Ivorforce/gists{/gist_id}","starred_url":"https://api.github.com/users/Ivorforce/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Ivorforce/subscriptions","organizations_url":"https://api.github.com/users/Ivorforce/orgs","repos_url":"https://api.github.com/users/Ivorforce/repos","events_url":"https://api.github.com/users/Ivorforce/events{/privacy}","received_events_url":"https://api.github.com/users/Ivorforce/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/121281/reactions","total_count":2,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":2,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/godotengine/godot/issues/121281/timeline","performed_via_github_app":null,"state_reason":null}