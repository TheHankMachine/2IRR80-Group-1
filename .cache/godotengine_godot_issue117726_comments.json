ub.com/users/blueskythlikesclouds","html_url":"https://github.com/blueskythlikesclouds","followers_url":"https://api.github.com/users/blueskythlikesclouds/followers","following_url":"https://api.github.com/users/blueskythlikesclouds/following{/other_user}","gists_url":"https://api.github.com/users/blueskythlikesclouds/gists{/gist_id}","starred_url":"https://api.github.com/users/blueskythlikesclouds/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/blueskythlikesclouds/subscriptions","organizations_url":"https://api.github.com/users/blueskythlikesclouds/orgs","repos_url":"https://api.github.com/users/blueskythlikesclouds/repos","events_url":"https://api.github.com/users/blueskythlikesclouds/events{/privacy}","received_events_url":"https://api.github.com/users/blueskythlikesclouds/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-04-03T10:57:18Z","updated_at":"2026-04-03T10:57:18Z","body":"Ah, I didn't realize GDShader doesn't support return statements, nevermind then!","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4182999666/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4193347158","html_url":"https://github.com/godotengine/godot/pull/117726#issuecomment-4193347158","issue_url":"https://api.github.com/repos/godotengine/godot/issues/117726","id":4193347158,"node_id":"IC_kwDOAO6SJc758WZW","user":{"login":"Chaosus","id":3036176,"node_id":"MDQ6VXNlcjMwMzYxNzY=","avatar_url":"https://avatars.githubusercontent.com/u/3036176?v=4","gravatar_id":"","url":"https://api.github.com/users/Chaosus","html_url":"https://github.com/Chaosus","followers_url":"https://api.github.com/users/Chaosus/followers","following_url":"https://api.github.com/users/Chaosus/following{/othe