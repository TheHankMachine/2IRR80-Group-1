nt.com/u/18014034?v=4","gravatar_id":"","url":"https://api.github.com/users/betalars","html_url":"https://github.com/betalars","followers_url":"https://api.github.com/users/betalars/followers","following_url":"https://api.github.com/users/betalars/following{/other_user}","gists_url":"https://api.github.com/users/betalars/gists{/gist_id}","starred_url":"https://api.github.com/users/betalars/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/betalars/subscriptions","organizations_url":"https://api.github.com/users/betalars/orgs","repos_url":"https://api.github.com/users/betalars/repos","events_url":"https://api.github.com/users/betalars/events{/privacy}","received_events_url":"https://api.github.com/users/betalars/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-10-10T11:28:05Z","updated_at":"2025-10-10T11:28:05Z","body":"<img width=\"1520\" height=\"1609\" alt=\"Image\" src=\"https://github.com/user-attachments/assets/9c58101b-e1b4-4677-961a-4abf5bdd84d2\" /> so weirdly enough, blender is also somewhat struggling with this, although to a lesser degree.\n\nComparison is between an invisible emissive sphere and a point light.\n\n<img width=\"1152\" height=\"393\" alt=\"Image\" src=\"https://github.com/user-attachments/assets/39c50e4e-be68-4b97-a495-194568791831\" />","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3389516041/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3389809327","html_url":"https://github.com/godotengine/godot/issues/111457#issuecomment-3389809327","issue_url":"https://api.github.com/repos/godotengine/godot/issues/111457","id":3389809327,"node_id":"IC_kwDOAO6SJc7KDGKv","user":{"login":"betalars","id":18014034,"node_id":"MDQ6VXNlcjE4MDE0MDM0","avatar_url":"https://avatars.githubusercontent.com/u/18014034?v=4","gravatar_id":"","url":"https://api.github.com/users/betalars","html_url":"https://github.com/betalars","followers_url":"https://api.github.com/users/betalars/followers","following_url":"https://api.github.com/users/betalars/following{/other_user}","gists_url":"https://api.github.com/users/betalars/gists{/gist_id}","starred_url":"https://api.github.com/users/betalars/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/betalars/subscriptions","organizations_url":"https://api.github.com/users/betalars/orgs","repos_url":"https://api.github.com/users/betalars/repos","events_url":"https://api.github.com/users/betalars/events{/privacy}","received_events_url":"https://api.github.com/users/betalars/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-10-10T12:24:18Z","updated_at":"2025-10-10T12:24:18Z","body":"For convenience sake, i also made a test scene. It has both point lights and emissive spheres as references and works both in blender and godot on various shapes.\n\n<img width=\"1580\" height=\"992\" alt=\"Image\" src=\"https://github.com/user-attachments/assets/24ca78c1-bdc4-418e-af4b-0d6b223b9b16\" />\n\n[specular-highlight-test.zip](https://github.com/user-attachments/files/22849763/specular-highlight-test.zip)\n\nJust for the record: I do not actually think it always needs to look 100% like the mesh sphere reference. But I think it may sometimes be a good guide to figure stuff out.","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3389809327/reactions","total_count":1,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":1},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3390028480","html_url":"https://github.com/godotengine/godot/issues/111457#issuecomment-3390028480","issue_url":"https://api.github.com/repos/godotengine/godot/issues/111457","id":3390028480,"node_id":"IC_kwDOAO6SJc7KD7rA","user":{"login":"betalars","id":18014034,"node_id":"MDQ6VXNlcjE4MDE0MDM0","avatar_url":"https://avatars.githubusercontent.com/u/18014034?v=4","gravatar_id":"","url":"https://api.github.com/users/betalars","html_url":"https://github.com/betalars","followers_url":"https://api.github.com/users/betalars/followers","following_url":"https://api.github.com/users/betalars/following{/other_user}","gists_url":"https://api.github.com/users/betalars/gists{/gist_id}","starred_url":"https://api.github.com/users/betalars/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/betalars/subscriptions","organizations_url":"https://api.github.com/users/betalars/orgs","repos_url":"https://api.github.com/users/betalars/repos","events_url":"https://api.github.com/users/betalars/events{/privacy}","received_events_url":"https://api.github.com/users/betalars/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-10-10T13:13:50Z","updated_at":"2025-10-10T13:13:50Z","body":"<img width=\"1585\" height=\"989\" alt=\"Image\" src=\"https://github.com/user-attachments/assets/7eb6590a-7248-4f0a-8fe9-ae06e7303370\" />\nThis _kind of_ impacts directional lights too, but probably to a lesser extend because the light can hardly sit inside a surface.","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3390028480/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3400813744","html_url":"https://github.com/godotengine/godot/issues/111457#issuecomment-3400813744","issue_url":"https://api.github.com/repos/godotengine/godot/issues/111457","id":3400813744,"node_id":"IC_kwDOAO6SJc7KtEyw","user":{"login":"sockeye-d","id":106356149,"node_id":"U_kgDOBlbdtQ","avatar_url":"https://avatars.githubusercontent.com/u/106356149?v=4","gravatar_id":"","url":"https://api.github.com/users/sockeye-d","html_url":"https://github.com/sockeye-d","followers_url":"https://api.github.com/users/sockeye-d/followers","following_url":"https://api.github.com/users/sockeye-d/following{/other_user}","gists_url":"https://api.github.com/users/sockeye-d/gists{/gist_id}","starred_url":"https://api.github.com/users/sockeye-d/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/sockeye-d/subscriptions","organizations_url":"https://api.github.com/users/sockeye-d/orgs","repos_url":"https://api.github.com/users/sockeye-d/repos","events_url":"https://api.github.com/users/sockeye-d/events{/privacy}","received_events_url":"https://api.github.com/users/sockeye-d/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-10-14T09:00:50Z","updated_at":"2025-10-14T09:00:50Z","body":"I *believe* this is not a bug. PBR specular highlights are anisotropic with respect to reflection angle on semi-rough surfaces, seen here with the car's headlights being stretched much further than the actual headlight shape:\n\n<img width=\"474\" height=\"266\" alt=\"Image\" src=\"https://github.com/user-attachments/assets/6f6779c1-0cb5-49db-979c-5e4c244fba3d\" />\n\nAlso, this excerpt from [Real-time polygonal-light shading with linearly transformed cosines](https://dl.acm.org/doi/10.1145/2897824.2925895):\n\n<img width=\"1241\" height=\"1287\" alt=\"Image\" src=\"https://github.com/user-attachments/assets/f3eaee76-2f87-4c90-8f7a-d5143b075df5\" />\n\n> I'm not an expert by any means in light transport, so I could be totally off here. The two images might not even be caused by the same phenomenon.","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3400813744/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3405579198","html_url":"https://github.com/godotengine/godot/issues/111457#issuecomment-3405579198","issue_url":"https://api.github.com/repos/godotengine/godot/issues/111457","id":3405579198,"node_id":"IC_kwDOAO6SJc7K_QO-","user":{"login":"betalars","id":18014034,"node_id":"MDQ6VXNlcjE4MDE0MDM0","avatar_url":"https://avatars.githubusercontent.com/u/18014034?v=4","gravatar_id":"","url":"https://api.github.com/users/betalars","html_url":"https://github.com/betalars","followers_url":"https://api.github.com/users/betalars/followers","following_url":"https://api.github.com/users/betalars/following{/other_user}","gists_url":"https://api.github.com/users/betalars/gists{/gist_id}","starred_url":"https://api.github.com/users/betalars/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/betalars/subscriptions","organizations_url":"https://api.github.com/users/betalars/orgs","repos_url":"https://api.github.com/users/betalars/repos","events_url":"https://api.github.com/users/betalars/events{/privacy}","received_events_url":"https://api.github.com/users/betalars/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-10-15T09:59:14Z","updated_at":"2025-10-15T09:59:14Z","body":"> I _believe_ this is not a bug.\n\nI have trieed to replicate the Godot behavriour in real life.\n\n<img width=\"684\" height=\"756\" alt=\"Image\" src=\"https://github.com/user-attachments/assets/74b193ef-567f-48c8-839d-636aaa161f9d\" />\n\nMy observations from within godot can not be replicated in real life.\n\n<img width=\"1480\" height=\"785\" alt=\"Image\" src=\"https://github.com/user-attachments/assets/b554d3b7-ef3d-4c32-af4a-9e9b903bce36\" />\n\nI think this is a bug.\n\nIf you can make a photo of the reflection of a light source getting smaller and smaller in width the more you put your camera to the ground feel free to share it. When I look at reflections, their width stays consistent with the light source reflected.","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3405579198/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3405704594","html_url":"https://github.com/godotengine/godot/issues/111457#issuecomment-3405704594","issue_url":"https://api.github.com/repos/godotengine/godot/issues/111457","id":3405704594,"node_id":"IC_kwDOAO6SJc7K_u2S","user":{"login":"betalars","id":18014034,"node_id":"MDQ6VXNlcjE4MDE0MDM0","avatar_url":"https://avatars.githubusercontent.com/u/18014034?v=4","gravatar_id":"","url":"https://api.github.com/users/betalars","html_url":"https://github.com/betalars","followers_url":"https://api.github.com/users/betalars/followers","following_url":"https://api.github.com/users/betalars/following{/other_user}","gists_url":"https://api.github.com/users/betalars/gists{/gist_id}","starred_url":"https://api.github.com/users/betalars/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/betalars/subscriptions","organizations_url":"https://api.github.com/users/betalars/orgs","repos_url":"https://api.github.com/users/betalars/repos","events_url":"https://api.github.com/users/betalars/events{/privacy}","received_events_url":"https://api.github.com/users/betalars/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-10-15T10:26:05Z","updated_at":"2025-10-15T10:26:05Z","body":"Another comparison of godot and blender\n\n<img width=\"616\" height=\"857\" alt=\"Image\" src=\"https://github.com/user-attachments/assets/bdd89c91-e2b6-40a5-9ce0-b4ced7ea0edb\" /> <img width=\"614\" height=\"1115\" alt=\"Image\" src=\"https://github.com/user-attachments/assets/636f828c-b3e4-46c3-a6a3-d8cca15b877f\" />","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3405704594/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3408246778","html_url":"https://github.com/godotengine/godot/issues/111457#issuecomment-3408246778","issue_url":"https://api.github.com/repos/godotengine/godot/issues/111457","id":3408246778,"node_id":"IC_kwDOAO6SJc7LJbf6","user":{"login":"sockeye-d","id":106356149,"node_id":"U_kgDOBlbdtQ","avatar_url":"https://avatars.githubusercontent.com/u/106356149?v=4","gravatar_id":"","url":"https://api.github.com/users/sockeye-d","html_url":"https://github.com/sockeye-d","followers_url":"https://api.github.com/users/sockeye-d/followers","following_url":"https://api.github.com/users/sockeye-d/following{/other_user}","gists_url":"https://api.github.com/users/sockeye-d/gists{/gist_id}","starred_url":"https://api.github.com/users/sockeye-d/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/sockeye-d/subscriptions","organizations_url":"https://api.github.com/users/sockeye-d/orgs","repos_url":"https://api.github.com/users/sockeye-d/repos","events_url":"https://api.github.com/users/sockeye-d/events{/privacy}","received_events_url":"https://api.github.com/users/sockeye-d/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-10-15T20:56:19Z","updated_at":"2025-10-15T20:56:19Z","body":"That's strange and it definitely looks wrong, sorry for the red herring. Hopefully this gets fixed","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3408246778/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3409206085","html_url":"https://github.com/godotengine/godot/issues/111457#issuecomment-3409206085","issue_url":"https://api.github.com/repos/godotengine/godot/issues/111457","id":3409206085,"node_id":"IC_kwDOAO6SJc7LNFtF","user":{"login":"clayjohn","id":16521339,"node_id":"MDQ6VXNlcjE2NTIxMzM5","avatar_url":"https://avatars.githubusercontent.com/u/16521339?v=4","gravatar_id":"","url":"https://api.github.com/users/clayjohn","html_url":"https://github.com/clayjohn","followers_url":"https://api.github.com/users/clayjohn/followers","following_url":"https://api.github.com/users/clayjohn/following{/other_user}","gists_url":"https://api.github.com/users/clayjohn/gists{/gist_id}","starred_url":"https://api.github.com/users/clayjohn/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/clayjohn/subscriptions","organizations_url":"https://api.github.com/users/clayjohn/orgs","repos_url":"https://api.github.com/users/clayjohn/repos","events_url":"https://api.github.com/users/clayjohn/events{/privacy}","received_events_url":"https://api.github.com/users/clayjohn/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-10-16T05:14:10Z","updated_at":"2025-10-16T05:14:10Z","body":"As I commented on your other bug report for the same issue. You cannot compare the look of a specular lobe to the look of a full raytraced reflection. \n\nGame engines do not provide full reflections out of the box. You need to enable reflections using ReflectionProbes, SSR, VoxelGI, or SDFGI. Each comes with quality/performance tradeoffs and you will need to decide which one is most acceptable. \n\nYou are comparing no reflections in Godot to full path traced reflections in Blender, to full reflections in real life. ","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3409206085/reactions","total_count":3,"+1":2,"-1":1,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3411003916","html_url":"https://github.com/godotengine/godot/issues/111457#issuecomment-3411003916","issue_url":"https://api.github.com/repos/godotengine/godot/issues/111457","id":3411003916,"node_id":"IC_kwDOAO6SJc7LT8oM","user":{"login":"betalars","id":18014034,"node_id":"MDQ6VXNlcjE4MDE0MDM0","avatar_url":"https://avatars.githubusercontent.com/u/18014034?v=4","gravatar_id":"","url":"https://api.github.com/users/betalars","html_url":"https://github.com/betalars","followers_url":"https://api.github.com/users/betalars/followers","following_url":"https://api.github.com/users/betalars/following{/other_user}","gists_url":"https://api.github.com/users/betalars/gists{/gist_id}","starred_url":"https://api.github.com/users/betalars/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/betalars/subscriptions","organizations_url":"https://api.github.com/users/betalars/orgs","repos_url":"https://api.github.com/users/betalars/repos","events_url":"https://api.github.com/users/betalars/events{/privacy}","received_events_url":"https://api.github.com/users/betalars/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-10-16T13:52:50Z","updated_at":"2025-10-16T13:52:50Z","body":"> You cannot compare the look of a specular lobe to the look of a full raytraced reflection.\n\nYes, I can in compare things that are not the same thing. That is the meaning of a comparison.\n \nLet me demonstrate.\n\n| Blender Eevee | Blender Cycles | Godot |\n| -------- | -------- | -------- |\n| <img width=\"1920\" height=\"1080\" alt=\"Image\" src=\"https://github.com/user-attachments/assets/022037e2-e6c9-46c1-b5a3-7edb6f2aada3\" /> | <img width=\"1920\" height=\"1080\" alt=\"Image\" src=\"https://github.com/user-attachments/assets/44600bb9-4ef3-4da6-8b8e-f7927cfa9e25\" /> | <img width=\"1919\" height=\"1076\" alt=\"Image\" src=\"https://github.com/user-attachments/assets/2251ec9b-aac0-4cd4-ade9-a63166a41adc\" /> |\n\nIn this comparison you can see that is is very difficult to tell apart the rasterized eevee implementation and the ray traced cycles implementation of this optical phenomenon. They also both show the anisotropic reflections that was described above but do not look as weird as the the godot implementation.\n\n> You are comparing no reflections in Godot to full path traced reflections in Blender, to full reflections in real life.\n\nAnd I was only doing that to reply to a comment using a real image to illustrate an optical property of reflections. Because when a user says the real world looks like this so the godot implementation is correct I will double check with the real world if they may have misunderstood something.\n\n> Game engines do not provide full reflections out of the box.\n\nThis issue by the way is not about reflections. This issue is about the shape of specular highlights. And I have mentioned on several occaasions that the reflections implemented by the voxel gi do look different. However specular highlights are supposed to imitate reflections, so I am also referencing properties of reflections because they are relevant.\n\nThank you for helping me clear up this confusion.\n\nPlease just use the provided MRP that has a blender scene set to eeve instead of wasting my time in having to disprove a straw man argument.","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3411003916/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3411028074","html_url":"https://github.com/godotengine/godot/issues/111457#issuecomment-3411028074","issue_url":"https://api.github.com/repos/godotengine/godot/issues/111457","id":3411028074,"node_id":"IC_kwDOAO6SJc7LUChq","user":{"login":"betalars","id":18014034,"node_id":"MDQ6VXNlcjE4MDE0MDM0","avatar_url":"https://avatars.githubusercontent.com/u/18014034?v=4","gravatar_id":"","url":"https://api.github.com/users/betalars","html_url":"https://github.com/betalars","followers_url":"https://api.github.com/users/betalars/followers","following_url":"https://api.github.com/users/betalars/following{/other_user}","gists_url":"https://api.github.com/users/betalars/gists{/gist_id}","starred_url":"https://api.github.com/users/betalars/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/betalars/subscriptions","organizations_url":"https://api.github.com/users/betalars/orgs","repos_url":"https://api.github.com/users/betalars/repos","events_url":"https://api.github.com/users/betalars/events{/privacy}","received_events_url":"https://api.github.com/users/betalars/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-10-16T13:57:40Z","updated_at":"2025-10-16T13:57:40Z","body":"I also forgot to mention that the spheres always only serve as a visual guide and I have said that many times. Because I find it difficult to understand the shape of a light that is invisible so I am adding these spheres that are not interacting with the lighting in any other intended way other than providing a rough visual reference for the size and brightness of the point/omni light.","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3411028074/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"ur