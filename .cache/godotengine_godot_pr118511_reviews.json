.com/repos/godotengine/godot/pulls/118511","author_association":"CONTRIBUTOR","_links":{"html":{"href":"https://github.com/godotengine/godot/pull/118511#pullrequestreview-4118098659"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/118511"}},"submitted_at":"2026-04-16T02:47:41Z","commit_id":"e33c674a661fbaaeb003eadb9b80ade69b2a7f58"},{"id":4121843351,"node_id":"PRR_kwDOAO6SJc71rlaX","user":{"login":"dsnopek","id":191561,"node_id":"MDQ6VXNlcjE5MTU2MQ==","avatar_url":"https://avatars.githubusercontent.com/u/191561?v=4","gravatar_id":"","url":"https://api.github.com/users/dsnopek","html_url":"https://github.com/dsnopek","followers_url":"https://api.github.com/users/dsnopek/followers","following_url":"https://api.github.com/users/dsnopek/following{/other_user}","gists_url":"https://api.github.com/users/dsnopek/gists{/gist_id}","starred_url":"https://api.github.com/users/dsnopek/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/dsnopek/subscriptions","organizations_url":"https://api.github.com/users/dsnopek/orgs","repos_url":"https://api.github.com/users/dsnopek/repos","events_url":"https://api.github.com/users/dsnopek/events{/privacy}","received_events_url":"https://api.github.com/users/dsnopek/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"Thanks! This is working great in my testing on the Samsung Galaxy XR, using the latest from this PR and your demo project\n\n> I've changed the viewport node so it creates all that is needed, and made the extension create the node and add it to the root of the scene tree.\n\nThis looks awesome! I think the only thing that's missing is a setting to prevent it from doing this, so that folks can do it manually if they want.\n\n> The combined frustum that we use for culling is too small and can cull objects at the edge of the inset view causing very noticeable visual artifacts.\n\nAh, now that you say this, I can absolutely tell this is the cause o