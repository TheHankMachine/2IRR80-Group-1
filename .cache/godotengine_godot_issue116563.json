ved_at":null,"archived_by":null},{"id":279098219,"node_id":"MDU6TGFiZWwyNzkwOTgyMTk=","url":"https://api.github.com/repos/godotengine/godot/labels/topic:editor","name":"topic:editor","color":"ffee88","default":false,"description":"","archived_at":null,"archived_by":null},{"id":279098255,"node_id":"MDU6TGFiZWwyNzkwOTgyNTU=","url":"https://api.github.com/repos/godotengine/godot/labels/topic:platforms","name":"topic:platforms","color":"ffee88","default":false,"description":"","archived_at":null,"archived_by":null}],"state":"closed","locked":false,"assignees":[],"milestone":{"url":"https://api.github.com/repos/godotengine/godot/milestones/24","html_url":"https://github.com/godotengine/godot/milestone/24","labels_url":"https://api.github.com/repos/godotengine/godot/milestones/24/labels","id":14236899,"node_id":"MI_kwDOAO6SJc4A2Tzj","number":24,"title":"4.7","description":"","creator":{"login":"akien-mga","id":4701338,"node_id":"MDQ6VXNlcjQ3MDEzMzg=","avatar_url":"https://avatars.githubusercontent.com/u/4701338?v=4","gravatar_id":"","url":"https://api.github.com/users/akien-mga","html_url":"https://github.com/akien-mga","followers_url":"https://api.github.com/users/akien-mga/followers","following_url":"https://api.github.com/users/akien-mga/following{/other_user}","gists_url":"https://api.github.com/users/akien-mga/gists{/gist_id}","starred_url":"https://api.github.com/users/akien-mga/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/akien-mga/subscriptions","organizations_url":"https://api.github.com/users/akien-mga/orgs","repos_url":"https://api.github.com/users/akien-mga/repos","events_url":"https://api.github.com/users/akien-mga/events{/privacy}","received_events_url":"https://api.github.com/users/akien-mga/received_events","type":"User","user_view_type":"public","site_admin":false},"open_issues":3,"closed_issues":2535,"state":"closed","created_at":"2025-11-27T20:29:18Z","updated_at":"2026-10-20T18:39:31Z","due_on":null,"closed_at":"2026-06-19T16:54:35Z"},"comments":13,"created_at":"2026-02-20T23:11:05Z","updated_at":"2026-04-17T02:50:27Z","closed_at":"2026-04-17T02:50:27Z","assignee":null,"author_association":"NONE","issue_field_values":[],"type":null,"active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"### Tested versions\n\n- Reproducible in 4.6.1 stable\n- Reproducible in 4.7 dev 1\n- Likely reproducible in every version that has the embedded game window\n\n### System information\n\nGodot v4.6.1.stable - macOS Sequoia (15.7.4) - Multi-window, 3 monitors - Metal (Forward+) - integrated Apple M3 Max (Apple9) - Apple M3 Max (16 threads) - 64.00 GiB memory\n\n### Issue description\n\nWhen using the embedded Game view (either the floating window, or the docked game view tab in the Godot editor), incorrect scaling is applied to the game.\n\nI suspect this is related to this issue: https://github.com/godotengine/godot/issues/116120\n\nBut this report is specifically about the fact that the 'Allow hiDPI' setting specifically is totally ignored by the embedded game window / view. It appears to always behave as if the setting is turned on - the rendered view appears half the size it should be, and everything is scaled down accordingly.\n\n<img width=\"2255\" height=\"1140\" alt=\"Image\" src=\"https://github.com/user-attachments/assets/7567ce65-3a4b-4947-92f6-44a606f628af\" />\n\n### Steps to reproduce\n\n1. Create a default project in any affected Godot version.\n2. Enter Project Settings > Display > Window, and turn **OFF** the \"Allow hiDPI\" setting.\n3. Create a new scene with a Control node as the root.\n4. Add a GraphEdit node, Label node, or any other Control-derived node with which the scaling issue can be seen.\n5. Save the scene, and Run Project using this new scene as the startup scene (or \"Run Current Scene\").\n6. Observe the rendered game is much smaller than it appears in the editor, and any nodes with text / other graphics are drawing at half the expected size.\n7. Optionally, turn \"Allow hiDPI\" back **ON**, and try running the game embedded again - the size and render scale are unchanged.\n8. If the \"Embed Game on Next Play\" setting is disabled, and the project is run again, the 'Allow hiDPI' setting being on or off will affect the size of that un-embedded window.\n\n### Minimal reproduction project (MRP)\n\nN/A","closed_by":{"login":"Repiteo","id":17489292,"node_id":"MDQ6VXNlcjE3NDg5Mjky","avatar_url":"https://avatars.githubusercontent.com/u/17489292?v=4","gravatar_id":"","url":"https://api.github.com/users/Repiteo","html_url":"https://github.com/Repiteo","followers_url":"https://api.github.com/users/Repiteo/followers","following_url":"https://api.github.com/users/Repiteo/following{/other_user}","gists_url":"https://api.github.com/users/Repiteo/gists{/gist_id}","starred_url":"https://api.github.com/users/Repiteo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Repiteo/subscriptions","organizations_url":"https://api.github.com/users/Repiteo/orgs","repos_url":"https://api.github.com/users/Repiteo/repos","events_url":"https://api.github.com/users/Repiteo/events{/privacy}","received_events_url":"https://api.github.com/users/Repiteo/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/116563/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/godotengine/godot/issues/116563/timeline","performed_via_github_app":null,"state_reason":"completed","pinned_comment":null}