372\" height=\"57\" alt=\"Image\" src=\"https://github.com/user-attachments/assets/283fec4b-e589-4183-86ed-638fbbf46292\" />\n\n### Minimal reproduction project (MRP)\n\nN/A","closed_by":{"login":"ComplianceFailure","id":199795568,"node_id":"U_kgDOC-ijcA","avatar_url":"https://avatars.githubusercontent.com/u/199795568?v=4","gravatar_id":"","url":"https://api.github.com/users/ComplianceFailure","html_url":"https://github.com/ComplianceFailure","followers_url":"https://api.github.com/users/ComplianceFailure/followers","following_url":"https://api.github.com/users/ComplianceFailure/following{/other_user}","gists_url":"https://api.github.com/users/ComplianceFailure/gists{/gist_id}","starred_url":"https://api.github.com/users/ComplianceFailure/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/ComplianceFailure/subscriptions","organizations_url":"https://api.github.com/users/ComplianceFailure/orgs","repos_url":"https://api.github.com/users/ComplianceFailure/repos","events_url":"https://api.github.com/users/ComplianceFailure/events{/privacy}","received_events_url":"https://api.github.com/users/ComplianceFailure/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/120050/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/godotengine/godot/issues/120050/timeline","performed_via_github_app":null,"state_reason":"duplicate","pinned_comment":null}