ed_by":null},{"id":1609442062,"node_id":"MDU6TGFiZWwxNjA5NDQyMDYy","url":"https://api.github.com/repos/godotengine/godot/labels/topic:shaders","name":"topic:shaders","color":"ffee88","default":false,"description":"","archived_at":null,"archived_by":null}],"state":"closed","locked":false,"assignees":[],"milestone":{"url":"https://api.github.com/repos/godotengine/godot/milestones/25","html_url":"https://github.com/godotengine/godot/milestone/25","labels_url":"https://api.github.com/repos/godotengine/godot/milestones/25/labels","id":15520464,"node_id":"MI_kwDOAO6SJc4A7NLQ","number":25,"title":"4.8","description":"","creator":{"login":"Repiteo","id":17489292,"node_id":"MDQ6VXNlcjE3NDg5Mjky","avatar_url":"https://avatars.githubusercontent.com/u/17489292?v=4","gravatar_id":"","url":"https://api.github.com/users/Repiteo","html_url":"https://github.com/Repiteo","followers_url":"https://api.github.com/users/Repiteo/followers","following_url":"https://api.github.com/users/Repiteo/following{/other_user}","gists_url":"https://api.github.com/users/Repiteo/gists{/gist_id}","starred_url":"https://api.github.com/users/Repiteo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Repiteo/subscriptions","organizations_url":"https://api.github.com/users/Repiteo/orgs","repos_url":"https://api.github.com/users/Repiteo/repos","events_url":"https://api.github.com/users/Repiteo/events{/privacy}","received_events_url":"https://api.github.com/users/Repiteo/received_events","type":"User","user_view_type":"public","site_admin":false},"open_issues":345,"closed_issues":2335,"state":"open","created_at":"2026-04-13T15:59:35Z","updated_at":"2026-10-22T08:15:08Z","due_on":null,"closed_at":null},"comments":2,"created_at":"2026-08-28T11:47:40Z","updated_at":"2026-08-29T01:33:12Z","closed_at":"2026-08-28T22:21:08Z","assignee":null,"author_association":"CONTRIBUTOR","issue_field_values":[],"type":null,"active_lock_reason":null,"draft":false,"pull_request":{"url":"https://api.github.com/repos/godotengine/godot/pulls/122931","html_url":"https://github.com/godotengine/godot/pull/122931","diff_url":"https://github.com/godotengine/godot/pull/122931.diff","patch_url":"https://github.com/godotengine/godot/pull/122931.patch","merged_at":"2026-08-28T22:21:08Z"},"body":"## What problem(s) does this PR solve?\r\n\r\n- Closes https://github.com/godotengine/godot-proposals/issues/15338. That proposal explains the rationale for this PR.\r\n\r\n## Additional information\r\n\r\nDemo project: [shader_usage_flags_demo.zip](https://github.com/user-attachments/files/31552787/shader_usage_flags_demo.zip)\r\n\r\nGiven these uniforms:\r\n\r\n```\r\nuniform float time_default;\r\nuniform float time_no_editor: no_editor;\r\nuniform float time_no_storage: no_storage;\r\nuniform float time_no_storage_no_editor: no_storage, no_editor;\r\n```\r\n\r\nThe ones with `no_storage` are omitted from the .tres file:\r\n\r\n```\r\n$ cat BlinkMaterial.tres \r\n[gd_resource type=\"ShaderMaterial\" format=3 uid=\"uid://ck2ph3hs1ssks\"]\r\n\r\n[ext_resource type=\"Shader\" uid=\"uid://clwvqil7dntbw\" path=\"res://BlinkMaterial.gdshader\" id=\"1_c8a3m\"]\r\n\r\n[resource]\r\nshader = ExtResource(\"1_c8a3m\")\r\nshader_parameter/time_default = 60.05209100000178\r\nshader_parameter/time_no_editor = 60.05209100000178\r\n```\r\n\r\nThe ones with `no_editor` are not visible in the inspector:\r\n\r\n<img width=\"439\" height=\"372\" alt=\"2026-08-28T13:40:09_439x372\" src=\"https://github.com/user-attachments/assets/b5692c36-f792-4a37-b8d3-14fa7ede27ac\" />\r\n\r\nCompletion:\r\n\r\n<img width=\"466\" height=\"133\" alt=\"2026-08-28T13:41:14_466x133\" src=\"https://github.com/user-attachments/assets/deb3f936-b780-4cc3-a66e-571763483562\" />\r\n\r\nError reporting:\r\n\r\n<img width=\"516\" height=\"83\" alt=\"2026-08-28T13:41:36_516x83\" src=\"https://github.com/user-attachments/assets/cc8099e9-f59d-41cd-ba1f-ca5b0c2d9134\" />","closed_by":{"login":"Repiteo","id":17489292,"node_id":"MDQ6VXNlcjE3NDg5Mjky","avatar_url":"https://avatars.githubusercontent.com/u/17489292?v=4","gravatar_id":"","url":"https://api.github.com/users/Repiteo","html_url":"https://github.com/Repiteo","followers_url":"https://api.github.com/users/Repiteo/followers","following_url":"https://api.github.com/users/Repiteo/following{/other_user}","gists_url":"https://api.github.com/users/Repiteo/gists{/gist_id}","starred_url":"https://api.github.com/users/Repiteo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Repiteo/subscriptions","organizations_url":"https://api.github.com/users/Repiteo/orgs","repos_url":"https://api.github.com/users/Repiteo/repos","events_url":"https://api.github.com/users/Repiteo/events{/privacy}","received_events_url":"https://api.github.com/users/Repiteo/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/122931/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/godotengine/godot/issues/122931/timeline","performed_via_github_app":null,"state_reason":null}