DU6TGFiZWwzNzA0NzE4ODA=","url":"https://api.github.com/repos/godotengine/godot/labels/topic:physics","name":"topic:physics","color":"ffee88","default":false,"description":"","archived_at":null,"archived_by":null},{"id":1332303119,"node_id":"MDU6TGFiZWwxMzMyMzAzMTE5","url":"https://api.github.com/repos/godotengine/godot/labels/regression","name":"regression","color":"ff63ac","default":false,"description":"","archived_at":null,"archived_by":null},{"id":2666708289,"node_id":"MDU6TGFiZWwyNjY2NzA4Mjg5","url":"https://api.github.com/repos/godotengine/godot/labels/topic:3d","name":"topic:3d","color":"ffee88","default":false,"description":"","archived_at":null,"archived_by":null}],"state":"closed","locked":false,"assignees":[],"milestone":{"url":"https://api.github.com/repos/godotengine/godot/milestones/24","html_url":"https://github.com/godotengine/godot/milestone/24","labels_url":"https://api.github.com/repos/godotengine/godot/milestones/24/labels","id":14236899,"node_id":"MI_kwDOAO6SJc4A2Tzj","number":24,"title":"4.7","description":"","creator":{"login":"akien-mga","id":4701338,"node_id":"MDQ6VXNlcjQ3MDEzMzg=","avatar_url":"https://avatars.githubusercontent.com/u/4701338?v=4","gravatar_id":"","url":"https://api.github.com/users/akien-mga","html_url":"https://github.com/akien-mga","followers_url":"https://api.github.com/users/akien-mga/followers","following_url":"https://api.github.com/users/akien-mga/following{/other_user}","gists_url":"https://api.github.com/users/akien-mga/gists{/gist_id}","starred_url":"https://api.github.com/users/akien-mga/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/akien-mga/subscriptions","organizations_url":"https://api.github.com/users/akien-mga/orgs","repos_url":"https://api.github.com/users/akien-mga/repos","events_url":"https://api.github.com/users/akien-mga/events{/privacy}","received_events_url":"https://api.github.com/users/akien-mga/received_events","type":"User","user_view_type":"public","site_admin":false},"open_issues":3,"closed_issues":2535,"state":"closed","created_at":"2025-11-27T20:29:18Z","updated_at":"2026-10-20T18:39:31Z","due_on":null,"closed_at":"2026-06-19T16:54:35Z"},"comments":3,"created_at":"2026-02-08T16:44:58Z","updated_at":"2026-02-11T21:04:30Z","closed_at":"2026-02-11T21:04:30Z","assignee":null,"author_association":"CONTRIBUTOR","issue_field_values":[],"type":null,"active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"### Tested versions\n\n- Reproducible in: 4.6.stable\n- Not reproducible in: 4.5.1.stable\n\n### System information\n\nGodot v4.6.stable - Fedora Linux 43 (Forty Three) on Wayland - X11 display driver, Multi-window, 3 monitors - Vulkan (Forward+) - dedicated AMD Radeon RX 9070 XT (RADV GFX1201) - AMD Ryzen 9 9950X3D 16-Core Processor (32 threads) - 60.39 GiB memory\n\n### Issue description\n\nIn short, when using Jolt Physics, the `SoftBody3D.total_mass` property has seemingly changed from a default value of 0 kg in Godot 4.5 to instead show a default value of 0.001 kg in Godot 4.6. This \"regression\" seems to stem from #108758.\n\nNote that 0.001 kg is not the actual value being used either way. The actual value being used is still 0 kg. This is purely a misleading visual artifact.\n\nThis gets a bit messy, but basically, the `SoftBody3D` node as currently implemented with Jolt has ([for questionable reasons](https://github.com/godotengine/godot/issues/111993#issuecomment-3864596572)) been inadvertently exploiting the behavior of the `SoftBody3D.total_mass` property hint to show a value of 0.\n\nThe previous value of 0 was (as mentioned in the link above) meant to communicate that the default mass was undefined/automatic, and should rightfully have been changed long ago. This new value of 0.001 kg does however seem even more problematic, since it suggests an actual concrete mass, way off from what the actual mass will end up being.\n\nNote that this was made possible to begin with due to the fact that the `SoftBody3D` node doesn't properly store/cache its own property values, like the other physics nodes do, and instead relies on the physics server to report them, as seen here:\n\nhttps://github.com/godotengine/godot/blob/56f3e2611daadb0b1894b46737ee3000e82e33f9/scene/3d/physics/soft_body_3d.cpp#L639-L641\n\n### Steps to reproduce\n\n1. Open the MRP in Godot 4.5.1.\n2. Note how the `total_mass` property of the `SoftBody` node is `0`.\n3. Open the MRP in Godot 4.6.\n4. Note how the `total_mass` property is now `0.001` instead.\n\n### Minimal reproduction project (MRP)\n\n[soft_body_default_mass_2026-02-08_17-10-03.zip](https://github.com/user-attachments/files/25162637/soft_body_default_mass_2026-02-08_17-10-03.zip)","closed_by":{"login":"mihe","id":4884246,"node_id":"MDQ6VXNlcjQ4ODQyNDY=","avatar_url":"https://avatars.githubusercontent.com/u/4884246?v=4","gravatar_id":"","url":"https://api.github.com/users/mihe","html_url":"https://github.com/mihe","followers_url":"https://api.github.com/users/mihe/followers","following_url":"https://api.github.com/users/mihe/following{/other_user}","gists_url":"https://api.github.com/users/mihe/gists{/gist_id}","starred_url":"https://api.github.com/users/mihe/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/mihe/subscriptions","organizations_url":"https://api.github.com/users/mihe/orgs","repos_url":"https://api.github.com/users/mihe/repos","events_url":"https://api.github.com/users/mihe/events{/privacy}","received_events_url":"https://api.github.com/users/mihe/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/116050/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/godotengine/godot/issues/116050/timeline","performed_via_github_app":null,"state_reason":"completed","pinned_comment":null}