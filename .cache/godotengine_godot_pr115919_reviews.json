[{"id":3760107717,"node_id":"PRR_kwDOAO6SJc7gHrDF","user":{"login":"lyuma","id":39946030,"node_id":"MDQ6VXNlcjM5OTQ2MDMw","avatar_url":"https://avatars.githubusercontent.com/u/39946030?v=4","gravatar_id":"","url":"https://api.github.com/users/lyuma","html_url":"https://github.com/lyuma","followers_url":"https://api.github.com/users/lyuma/followers","following_url":"https://api.github.com/users/lyuma/following{/other_user}","gists_url":"https://api.github.com/users/lyuma/gists{/gist_id}","starred_url":"https://api.github.com/users/lyuma/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/lyuma/subscriptions","organizations_url":"https://api.github.com/users/lyuma/orgs","repos_url":"https://api.github.com/users/lyuma/repos","events_url":"https://api.github.com/users/lyuma/events{/privacy}","received_events_url":"https://api.github.com/users/lyuma/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"The fix is correct. It's concerning that with the design of `AHashMap`, that this sort of bug is so easy to trigger and produces a difficult to detect but dangerous use-after-free bug.\n\nThe problem is `nodes[p_new_name] = nodes[p_name]` is equivalent to\n`operator=(operator[](nodes, p_new_name), operator[](const nodes, p_name))`\n\nwhich means that both operator[] will be evaluated, in an arbitrary order before the operator= runs. One of the operator[] calls will invalidate the const reference returned by the other.\n\nSince Node is a struct, it is safe to make a copy, and then store it, so this fix is correct.","state":"APPROVED","html_url":"https://github.com/godotengine/godot/pull/115919#pullrequestreview-3760107717","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/115919","author_association":"CONTRIBUTOR","_links":{"html":{"href":"https://github.com/godotengine/godot/pull/115919#pullrequestreview-3760107717"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/115919"}},"submitted_at":"2026-02-06T00:35:12Z","commit_id":"a17ee0f9d8f444184932bf74bf46032a125679a8"}]