.com/users/Mickeon/gists{/gist_id}","starred_url":"https://api.github.com/users/Mickeon/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Mickeon/subscriptions","organizations_url":"https://api.github.com/users/Mickeon/orgs","repos_url":"https://api.github.com/users/Mickeon/repos","events_url":"https://api.github.com/users/Mickeon/events{/privacy}","received_events_url":"https://api.github.com/users/Mickeon/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-01-02T18:52:00Z","updated_at":"2025-01-02T18:52:00Z","body":"Keeping it at the top will screw up with the user's muscle memory so maybe it's worth evaluating to move it down.","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2568220905/reactions","total_count":3,"+1":3,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2568245810","html_url":"https://github.com/godotengine/godot/pull/101021#issuecomment-2568245810","issue_url":"https://api.github.com/repos/godotengine/godot/issues/101021","id":2568245810,"node_id":"IC_kwDOAO6SJc6ZFFIy","user":{"login":"DannyDevSe","id":102230735,"node_id":"U_kgDOBhfqzw","avatar_url":"https://avatars.githubusercontent.com/u/102230735?v=4","gravatar_id":"","url":"https://api.github.com/users/DannyDevSe","html_url":"https://github.com/DannyDevSe","followers_url":"https://api.github.com/users/DannyDevSe/followers","following_url":"https://api.github.com/users/DannyDevSe/following{/other_user}","gists_url":"https://api.github.com/users/DannyDevSe/gists{/gist_id}","starred_url":"https://api.github.com/users/DannyDevSe/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/DannyDevSe/subscriptions","organizations_url":"https://api.github.com/users/DannyDevSe/orgs","repos_url":"https://api.github.com/users/DannyDevSe/repos","events_url":"https://api.github.com/users/DannyDevSe/events{/privacy}","received_events_url":"https://api.github.com/users/DannyDevSe/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-01-02T19:10:51Z","updated_at":"2025-01-02T19:10:51Z","body":"> Keeping it at the top will screw up with the user's muscle memory so maybe it's worth evaluating to move it down.\r\n\r\nIt's best at the top that's what's used by browsers since it's most accessible and acts as a second keyboard.","author_association":"NONE","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2568245810/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2568252899","html_url":"https://github.com/godotengine/godot/pull/101021#issuecomment-2568252899","issue_url":"https://api.github.com/repos/godotengine/godot/issues/101021","id":2568252899,"node_id":"IC_kwDOAO6SJc6ZFG3j","user":{"login":"DannyDevSe","id":102230735,"node_id":"U_kgDOBhfqzw","avatar_url":"https://avatars.githubusercontent.com/u/102230735?v=4","gravatar_id":"","url":"https://api.github.com/users/DannyDevSe","html_url":"https://github.com/DannyDevSe","followers_url":"https://api.github.com/users/DannyDevSe/followers","following_url":"https://api.github.com/users/DannyDevSe/following{/other_user}","gists_url":"https://api.github.com/users/DannyDevSe/gists{/gist_id}","starred_url":"https://api.github.com/users/DannyDevSe/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/DannyDevSe/subscriptions","organizations_url":"https://api.github.com/users/DannyDevSe/orgs","repos_url":"https://api.github.com/users/DannyDevSe/repos","events_url":"https://api.github.com/users/DannyDevSe/events{/privacy}","received_events_url":"https://api.github.com/users/DannyDevSe/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-01-02T19:17:08Z","updated_at":"2025-01-02T19:17:08Z","body":"It’s worth considering renaming \"Emoji & Symbols\" to just \"Emoji\" because all the other options are shorter, making this one stand out negatively due to its length. Additionally, \"Emoji\" is a more commonly used term for this action in browsers.","author_association":"NONE","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2568252899/reactions","total_count":2,"+1":2,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2568255514","html_url":"https://github.com/godotengine/godot/pull/101021#issuecomment-2568255514","issue_url":"https://api.github.com/repos/godotengine/godot/issues/101021","id":2568255514,"node_id":"IC_kwDOAO6SJc6ZFHga","user":{"login":"bruvzg","id":7645683,"node_id":"MDQ6VXNlcjc2NDU2ODM=","avatar_url":"https://avatars.githubusercontent.com/u/7645683?v=4","gravatar_id":"","url":"https://api.github.com/users/bruvzg","html_url":"https://github.com/bruvzg","followers_url":"https://api.github.com/users/bruvzg/followers","following_url":"https://api.github.com/users/bruvzg/following{/other_user}","gists_url":"https://api.github.com/users/bruvzg/gists{/gist_id}","starred_url":"https://api.github.com/users/bruvzg/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/bruvzg/subscriptions","organizations_url":"https://api.github.com/users/bruvzg/orgs","repos_url":"https://api.github.com/users/bruvzg/repos","events_url":"https://api.github.com/users/bruvzg/events{/privacy}","received_events_url":"https://api.github.com/users/bruvzg/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-01-02T19:19:30Z","updated_at":"2025-01-02T19:20:05Z","body":"> It's best at the top that's what's used by browsers\r\n\r\nChromium based browsers have it on top, GTK have it on the bottom, macOS have it at the bottom of \"Edit\" menu. Not sure if there are any other examples for emoji picker in the context menu.\r\n\r\n> Additionally, \"Emoji\" is a more commonly used term for this action in browsers.\r\n\r\nOn macOS, Chromium also calls it `Emoji & Symbols` (native macOS \"Edit\" menu do the same), but it's `Emoji` on Windows (I guess Windows picker is more limited).","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2568255514/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2568658418","html_url":"https://github.com/godotengine/godot/pull/101021#issuecomment-2568658418","issue_url":"https://api.github.com/repos/godotengine/godot/issues/101021","id":2568658418,"node_id":"IC_kwDOAO6SJc6ZGp3y","user":{"login":"DannyDevSe","id":102230735,"node_id":"U_kgDOBhfqzw","avatar_url":"https://avatars.githubusercontent.com/u/102230735?v=4","gravatar_id":"","url":"https://api.github.com/users/DannyDevSe","html_url":"https://github.com/DannyDevSe","followers_url":"https://api.github.com/users/DannyDevSe/followers","following_url":"https://api.github.com/users/DannyDevSe/following{/other_user}","gists_url":"https://api.github.com/users/DannyDevSe/gists{/gist_id}","starred_url":"https://api.github.com/users/DannyDevSe/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/DannyDevSe/subscriptions","organizations_url":"https://api.github.com/users/DannyDevSe/orgs","repos_url":"https://api.github.com/users/DannyDevSe/repos","events_url":"https://api.github.com/users/DannyDevSe/events{/privacy}","received_events_url":"https://api.github.com/users/DannyDevSe/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-01-03T03:46:28Z","updated_at":"2025-01-03T03:46:28Z","body":"> Chromium based browsers have it on top, GTK have it on the bottom, macOS have it at the bottom of \"Edit\" menu. Not sure if there are any other examples for emoji picker in the context menu.\r\n\r\n> On macOS, Chromium also calls it `Emoji & Symbols` (native macOS \"Edit\" menu do the same), but it's `Emoji` on Windows (I guess Windows picker is more limited).\r\n\r\n> One issue I noticed is that the dialog appears when right-clicking text fields that only accept numeric values, such as SpinBox and EditorSpinSlider (as shown above). Perhaps these fields should have a property not to show the emoji option in the context menu?\r\n\r\nSince there isn't a standard for naming or placement, I suggest the following:\r\n- The longer name \"Emoji & Symbols\" works better at the bottom of the context menu visually, and might also reduce the need to address the numeric-only fields issue.\r\n- Adopting the shorter name \"Emoji\" fits better at the top, aligning with browser conventions and keeping it accessible, but this would require solving the numeric-only fields issue.\r\n\r\n","author_association":"NONE","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2568658418/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2568987131","html_url":"https://github.com/godotengine/godot/pull/101021#issuecomment-2568987131","issue_url":"https://api.github.com/repos/godotengine/godot/issues/101021","id":2568987131,"node_id":"IC_kwDOAO6SJc6ZH6H7","user":{"login":"DannyDevSe","id":102230735,"node_id":"U_kgDOBhfqzw","avatar_url":"https://avatars.githubusercontent.com/u/102230735?v=4","gravatar_id":"","url":"https://api.github.com/users/DannyDevSe","html_url":"https://github.com/Da