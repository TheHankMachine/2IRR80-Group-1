[{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4002628241","html_url":"https://github.com/godotengine/godot/pull/117086#issuecomment-4002628241","issue_url":"https://api.github.com/repos/godotengine/godot/issues/117086","id":4002628241,"node_id":"IC_kwDOAO6SJc7uk0KR","user":{"login":"arkology","id":43543909,"node_id":"MDQ6VXNlcjQzNTQzOTA5","avatar_url":"https://avatars.githubusercontent.com/u/43543909?v=4","gravatar_id":"","url":"https://api.github.com/users/arkology","html_url":"https://github.com/arkology","followers_url":"https://api.github.com/users/arkology/followers","following_url":"https://api.github.com/users/arkology/following{/other_user}","gists_url":"https://api.github.com/users/arkology/gists{/gist_id}","starred_url":"https://api.github.com/users/arkology/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/arkology/subscriptions","organizations_url":"https://api.github.com/users/arkology/orgs","repos_url":"https://api.github.com/users/arkology/repos","events_url":"https://api.github.com/users/arkology/events{/privacy}","received_events_url":"https://api.github.com/users/arkology/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-03-05T06:37:44Z","updated_at":"2026-03-05T06:37:44Z","body":"I think it would be good to add a cross-reference to another PR.\r\n- https://github.com/godotengine/godot/pull/96310","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4002628241/reactions","total_count":2,"+1":2,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4003115691","html_url":"https://github.com/godotengine/godot/pull/117086#issuecomment-4003115691","issue_url":"https://api.github.com/repos/godotengine/godot/issues/117086","id":4003115691,"node_id":"IC_kwDOAO6SJc7umrKr","user":{"login":"arkology","id":43543909,"node_id":"MDQ6VXNlcjQzNTQzOTA5","avatar_url":"https://avatars.githubusercontent.com/u/43543909?v=4","gravatar_id":"","url":"https://api.github.com/users/arkology","html_url":"https://github.com/arkology","followers_url":"https://api.github.com/users/arkology/followers","following_url":"https://api.github.com/users/arkology/following{/other_user}","gists_url":"https://api.github.com/users/arkology/gists{/gist_id}","starred_url":"https://api.github.com/users/arkology/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/arkology/subscriptions","organizations_url":"https://api.github.com/users/arkology/orgs","repos_url":"https://api.github.com/users/arkology/repos","events_url":"https://api.github.com/users/arkology/events{/privacy}","received_events_url":"https://api.github.com/users/arkology/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-03-05T08:03:52Z","updated_at":"2026-03-05T08:03:52Z","body":"This PR makes minimum window width bigger (i.e. the content of the editor now defines the minimum size):\r\n\r\n<img width=\"1106\" height=\"845\" alt=\"explorer_9N7oOBujBa\" src=\"https://github.com/user-attachments/assets/4167b5a3-ac6e-4c85-9524-675e596e2990\" />","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4003115691/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4005230820","html_url":"https://github.com/godotengine/godot/pull/117086#issuecomment-4005230820","issue_url":"https://api.github.com/repos/godotengine/godot/issues/117086","id":4005230820,"node_id":"IC_kwDOAO6SJc7uuvjk","user":{"login":"MarcusBuer","id":98789019,"node_id":"U_kgDOBeNmmw","avatar_url":"https://avatars.githubusercontent.com/u/98789019?v=4","gravatar_id":"","url":"https://api.github.com/users/MarcusBuer","html_url":"https://github.com/MarcusBuer","followers_url":"https://api.github.com/users/MarcusBuer/followers","following_url":"https://api.github.com/users/MarcusBuer/following{/other_user}","gists_url":"https://api.github.com/users/MarcusBuer/gists{/gist_id}","starred_url":"https://api.github.com/users/MarcusBuer/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/MarcusBuer/subscriptions","organizations_url":"https://api.github.com/users/MarcusBuer/orgs","repos_url":"https://api.github.com/users/MarcusBuer/repos","events_url":"https://api.github.com/users/MarcusBuer/events{/privacy}","received_events_url":"https://api.github.com/users/MarcusBuer/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-03-05T13:55:36Z","updated_at":"2026-03-05T14:35:08Z","body":"> This PR makes minimum window width bigger (i.e. the content of the editor now defines the minimum size):\r\n> <img alt=\"explorer_9N7oOBujBa\" width=\"1106\" height=\"845\" src=\"https://private-user-images.githubusercontent.com/43543909/558545907-4167b5a3-ac6e-4c85-9524-675e596e2990.png?jwt=eyJ0eXAiOiJKV1QiLCJhbGciOiJIUzI1NiJ9..0WwOLTIlR35Aj0koAE-nwUsBi3sivMYB-kA06VpVWAM\">\r\n\r\nGodot already has a minimum size, set on [editor_node's constructor](https://github.com/godotengine/godot/blob/b12b7bc622308c272fec74af2602229f4da0f743/editor/editor_node.cpp#L8374C1-L8380C3) and sync'd to DisplayServer.\r\n\r\n\r\nThis implementation expands the minimum size to use the contents of the title bar as minimum width, which indeed makes the minimum size bigger, since it has more content.\r\nThis was a workaround made because without it the minimum size the contents of the window start clipping with the titlebar, so the caption buttons group would overflow and with it the entire right side of the window too.\r\nWe can make this workaround less janky by moving the implementation from the titlebar itself to the editor_node:_titlebar_resized() function, where it seems to belong better.\r\n\r\n\r\nIf we want a different behavior then we must decide what happens when the window width gets smaller than it's contents. Some alternatives:\r\n\r\n1. Current Behavior - Don't scale the window and let items overflow.\r\n2. Give the window a min-width: This doesn't account that in the future more items might be added, increasing the minimum window width further.\r\n3. Collapse some items into combo boxes/selectors to save space: This can be done for the menu and editor mode (2D, 3D, Script, etc.). It is limited on how much space it saves, so it might not be a fix-all solution.\r\n4. Add a Scrollbar and a scrollable indicator (arrow on the two corners?) so the user can scroll through the titlebar with the mouse wheel, allowing for contents that are larger than the windows. This is similar to how the Tabs bar works.\r\n\r\nThere isn't a right answer. But I believe such change would be out of the scope of this PR, and is a broader architectural decision that should be deferred to the maintainers.","author_association":"NONE","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4005230820/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4005472151","html_url":"https://github.com/godotengine/godot/pull/117086#issuecomment-4005472151","issue_url":"https://api.github.com/repos/godotengine/godot/issues/117086","id":4005472151,"node_id":"IC_kwDOAO6SJc7uvqeX","user":{"login":"arkology","id":43543909,"node_id":"MDQ6VXNlcjQzNTQzOTA5","avatar_url":"https://avatars.githubusercontent.com/u/43543909?v=4","gravatar_id":"","url":"https://api.github.com/users/arkology","html_url":"https://github.com/arkology","followers_url":"https://api.github.com/users/arkology/followers","following_url":"https://api.github.com/users/arkology/following{/other_user}","gists_url":"https://api.github.com/users/arkology/gists{/gist_id}","starred_url":"https://api.github.com/users/arkology/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/arkology/subscriptions","organizations_url":"https://api.github.com/users/arkology/orgs","repos_url":"https://api.github.com/users/arkology/repos","events_url":"https://api.github.com/users/arkology/events{/privacy}","received_events_url":"https://api.github.com/users/arkology/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-03-05T14:29:20Z","updated_at":"2026-03-05T14:29:20Z","body":"> Godot already has a minimum size, set on [editor_node's constructor](https://github.com/godotengine/godot/blob/b12b7bc622308c272fec74af2602229f4da0f743/editor/editor_node.cpp#L8374C1-L8380C3) and sync'd to DisplayServer.\r\n\r\nYes, that's what I meant. \r\nAnd IMO _window_ size should be in this borders. \r\nContent clipping inside window of course is a problem, but we should not make it even more painful, right?\r\nImagine someone adds plugin that expands editor to infinity. So it will be impossible to close the window at all (or only using taskbar?)\r\nMaybe just render this buttons above title bar (I mean in terms of z-index)? So if there is not enough space for everything, clip titlebar content and render this buttons above it. So current behavior will be preserved and this will be really out of scope of current PR.","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4005472151/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4006481070","html_url":"https://github.com/godotengine/godot/pull/117086#issuecomment-4006481070","issue_url":"https://api.github.com/repos/godotengine/godot/issues/117086","id":4006481070,"node_id":"IC_kwDOAO6SJc7uzgyu","user":{"login":"MarcusBuer","id":98789019,"node_id":"U_kgDOBeNmmw","avatar_url":"https://avatars.githubusercontent.com/u/98789019?v=4","gravatar_id":"","url":"https://api.github.com/users/MarcusBuer","html_url":"https://github.com/MarcusBuer","followers_url":"https://api.github.com/users/MarcusBuer/followers","following_url":"https://api.github.com/users/MarcusBuer/following{/other_user}","gists_url":"https://api.github.com/users/MarcusBuer/gists{/gist_id}","starred_url":"https://api.github.com/users/MarcusBuer/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/MarcusBuer/subscriptions","organizations_url":"https://api.github.com/users/MarcusBuer/orgs","repos_url":"https://api.github.com/users/MarcusBuer/repos","events_url":"https://api.github.com/users/MarcusBuer/events{/privacy}","received_events_url":"https://api.github.com/users/MarcusBuer/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-03-05T17:13:40Z","updated_at":"2026-03-05T17:14:57Z","body":"> > Godot already has a minimum size, set on [editor_node's constructor](https://github.com/godotengine/godot/blob/b12b7bc622308c272fec74af2602229f4da0f743/editor/editor_node.cpp#L8374C1-L8380C3) and sync'd to DisplayServer.\r\n> \r\n> Yes, that's what I meant. And IMO _window_ size should be in this borders. Content clipping inside window of course is a problem, but we should not make it even more painful, right? Imagine someone adds plugin that expands editor to infinity. So it will be impossible to close the window at all (or only using taskbar?) Maybe just render this buttons above title bar (I mean in terms of z-index)? So if there is not enough space for everything, clip titlebar content and render this buttons above it. So current behavior will be preserved and this will be really out of scope of current PR.\r\n\r\nI tried implementing this. \r\nI can overlay the Caption Buttons on the right top corner, and it sits on top of the renderer selector (forward+ / compatibility / mobile) without issues. But the moment I add a spacer (allowed to compress to width 0) after it to push the renderer selector from under the buttons if the window has space, the spacer pushes the content outside the window when there isn't space, overflowing it. I'm failing to understand how I can keep the editor window from overflowing.\r\n\r\nIt seems to be an issue not related to this PR, as I downloaded the 4.6 binary on the website and it also has clipping issues (albeit in smaller scale, since the toolbar has less content).","author_association":"NONE","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4006481070/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4006574508","html_url":"https://github.com/godotengine/godot/pull/117086#issuecomment-4006574508","issue_url":"https://api.github.com/repos/godotengine/godot/issues/117086","id":4006574508,"node_id":"IC_kwDOAO6SJc7uz3ms","user":{"login":"arkology","id":43543909,"node_id":"MDQ6VXNlcjQzNTQzOTA5","avatar_url":"https://avatars.githubusercontent.com/u/43543909?v=4","gravatar_id":"","url":"https://api.github.com/users/arkology","html_url":"https://github.com/arkology","followers_url":"https://api.github.com/users/arkology/followers","following_url":"https://api.github.com/users/arkology/following{/other_user}","gists_url":"https://api.github.com/users/arkology/gists{/gist_id}","starred_url":"https://api.github.com/users/arkology/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/arkology/subscriptions","organizations_url":"https://api.github.com/users/arkology/orgs","repos_url":"https://api.github.com/users/arkology/repos","events_url":"https://api.github.com/users/arkology/events{/privacy}","received_events_url":"https://api.github.com/users/arkology/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-03-05T17:32:46Z","updated_at":"2026-03-05T17:32:46Z","body":"> I'm failing to understand how I can keep the editor window from overflowing.\r\n\r\nYou don't need to do it. Editor content overflow is ok (actually not ok but editor _content_ overflow inside window borders is definitely out of scope of this PR). Editor _window_ expansion is not ok IMO.\r\n\r\n> the spacer pushes the content outside the window when there isn't space, overflowing it.\r\n\r\nBased on the description, this is exactly what I was talking about, and I think this is the right way to address this issue. Could you please show a video demonstrating it in action to make sure we're talking about the same thing?\r\n\r\nP.S. To be clear, I like this PR and the feature in general, and all my comments here are aimed at improving it :)","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4006574508/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4008240044","html_url":"https://github.com/godotengine/godot/pull/117086#issuecomment-4008240044","issue_url":"https://api.github.com/repos/godotengine/godot/issues/117086","id":4008240044,"node_id":"IC_kwDOAO6SJc7u6OOs","user":{"login":"MarcusBuer","id":98789019,"node_id":"U_kgDOBeNmmw","avatar_url":"https://avatars.githubusercontent.com/u/98789019?v=4","gravatar_id":"","url":"https://api.github.com/users/MarcusBuer","html_url":"https://github.com/MarcusBuer","followers_url":"https://api.github.com/users/MarcusBuer/followers","following_url":"https://api.github.com/users/MarcusBuer/following{/other_user}","gists_url":"https://api.github.com/users/MarcusBuer/gists{/gist_id}","starred_url":"https://api.github.com/users/MarcusBuer/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/MarcusBuer/subscriptions","organizations_url":"https://api.github.com/users/MarcusBuer/orgs","repos_url":"https://api.github.com/users/MarcusBuer/repos","events_url":"https://api.github.com/users/MarcusBuer/events{/privacy}","received_events_url":"https://api.github.com/users/MarcusBuer/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-03-05T22:32:16Z","updated_at":"2026-03-05T22:32:16Z","body":"@arkology  After some time I finally understood where to add the widget so it adds to the window without any workaround, so the window gets larger, but it's the default engine behavior.\r\n\r\nI tried to add as an overlay like you recommended, but couldn't manage to make it work properly. When adding the spacer it started increasing the window size instead of overflowing like it happened before, which I couldn't replicate anymore, so it basically behaved the same as adding the widget directly, making it not worth to keep as it had the same issue but with added complexity.\r\n\r\nI'll leave improvements on the UI to people who know more about Godot's UI system, if anyone want to give it a go.\r\n\r\n> P.S. To be clear, I like this PR and the feature in general, and all my comments here are aimed at improving it :)\r\n\r\nYour comments have been very helpful. It feels weird leaving it on a state of \"it is either enlarging the window or causing a visual bug that already exists to become worse\", but trying to fix it at this PR would not be ideal, and it is something that maintainers will have to decide how to deal with eventually, as the native window is already pretty crowded.\r\nThank you for your help!","author_association":"NONE","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4008240044/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4009986274","html_url":"https://github.com/godotengine/godot/pull/117086#issuecomment-4009986274","issue_url":"https://api.github.com/repos/godotengine/godot/issues/117086","id":4009986274,"node_id":"IC_kwDOAO6SJc7vA4ji","user":{"login":"arkology","id":43543909,"node_id":"MDQ6VXNlcjQzNTQzOTA5","avatar_url":"https://avatars.githubusercontent.com/u/43543909?v=4","gravatar_id":"","url":"https://api.github.com/users/arkology","html_url":"https://github.com/arkology","followers_url":"https://api.github.com/users/arkology/followers","following_url":"https://api.github.com/users/arkology/following{/other_user}","gists_url":"https://api.github.com/users/arkology/gists{/gist_id}","starred_url":"https://api.github.com/users/arkology/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/arkology/subscriptions","organizations_url":"https://api.github.com/users/arkology/orgs","repos_url":"https://api.github.com/users/arkology/repos","events_url":"https://api.github.com/users/arkology/events{/privacy}","received_events_url":"https://api.github.com/users/arkology/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-03-06T07:04:03Z","updated_at":"2026-03-06T07:04:03Z","body":"I can see native min/max/restore/close buttons under editor window when quickly resizing the editor window. May be not critical, IDK, so just for info.\r\n\r\nhttps://github.com/user-attachments/assets/1548cb0b-b0d9-4597-adb5-49a0c3665e25\r\n\r\n","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4009986274/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{