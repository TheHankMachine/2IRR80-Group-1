com/repos/godotengine/godot/issues/comments/2754065499/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2754939722","html_url":"https://github.com/godotengine/godot/pull/104605#issuecomment-2754939722","issue_url":"https://api.github.com/repos/godotengine/godot/issues/104605","id":2754939722,"node_id":"IC_kwDOAO6SJc6kNQtK","user":{"login":"Calinou","id":180032,"node_id":"MDQ6VXNlcjE4MDAzMg==","avatar_url":"https://avatars.githubusercontent.com/u/180032?v=4","gravatar_id":"","url":"https://api.github.com/users/Calinou","html_url":"https://github.com/Calinou","followers_url":"https://api.github.com/users/Calinou/followers","following_url":"https://api.github.com/users/Calinou/following{/other_user}","gists_url":"https://api.github.com/users/Calinou/gists{/gist_id}","starred_url":"https://api.github.com/users/Calinou/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Calinou/subscriptions","organizations_url":"https://api.github.com/users/Calinou/orgs","repos_url":"https://api.github.com/users/Calinou/repos","events_url":"https://api.github.com/users/Calinou/events{/privacy}","received_events_url":"https://api.github.com/users/Calinou/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-03-26T16:00:31Z","updated_at":"2025-03-26T16:00:31Z","body":"> There is also an option to always show the ScrollBar. It removes the empty space at least:\r\n\r\nThe tall scrollbar looks odd to me (and a bit distracting), so I'd prefer not. In terms of UX, it's also not ideal to show a scrollbar when no scrolling is possible.","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2754939722/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2756988810","html_url":"https://github.com/godotengine/godot/pull/104605#issuecomment-2756988810","issue_url":"https://api.github.com/repos/godotengine/godot/issues/104605","id":2756988810,"node_id":"IC_kwDOAO6SJc6kVE-K","user":{"login":"arkology","id":43543909,"node_id":"MDQ6VXNlcjQzNTQzOTA5","avatar_url":"https://avatars.githubusercontent.com/u/43543909?v=4","gravatar_id":"","url":"https://api.github.com/users/arkology","html_url":"https://github.com/arkology","followers_url":"https://api.github.com/users/arkology/followers","following_url":"https://api.github.com/users/arkology/following{/other_user}","gists_url":"https://api.github.com/users/arkology/gists{/gist_id}","starred_url":"https://api.github.com/users/arkology/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/arkology/subscriptions","organizations_url":"https://api.github.com/users/arkology/orgs","repos_url":"https://api.github.com/users/arkology/repos","events_url":"https://api.github.com/users/arkology/events{/privacy}","received_events_url":"https://api.github.com/users/arkology/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-03-27T07:23:03Z","updated_at":"2025-03-27T07:23:03Z","body":"> In practice the scrollbar is visible most of the time anyway, so the extra space was at most temporary.\r\n\r\nSo content jumping prevented by this PR will almost never happen)\r\n\r\nI do not have strong opinion about this, so... maybe just merge it for next dev build (that's what dev builds are for, right?). I’m not sure if there are other convenient ways to gather feedback from a large number of users.","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2756988810/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2761719017","html_url":"https://github.com/godotengine/godot/pull/104605#issuecomment-2761719017","issue_url":"https://api.github.com/repos/godotengine/godot/issues/104605","id":2761719017,"node_id":"IC_kwDOAO6SJc6knHzp","user":{"login":"akien-mga","id":4701338,"node_id":"MDQ6VXNlcjQ3MDEzMzg=","avatar_url":"https://avatars.githubusercontent.com/u/4701338?v=4","gravatar_id":"","url":"https://api.github.com/users/akien-mga","html_url":"https://github.com/akien-mga","followers_url":"https://api.github.com/users/akien-mga/followers","following_url":"https://api.github.com/users/akien-mga/following{/other_user}","gists_url":"https://api.github.com/users/akien-mga/gists{/gist_id}","starred_url":"https://api.github.com/users/akien-mga/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/akien-mga/subscriptions","organizations_url":"https://api.github.com/users/akien-mga/orgs","repos_url":"https://api.github.com/users/akien-mga/repos","events_url":"https://api.github.com/users/akien-mga/events{/privacy}","received_events_url":"https://api.github.com/users/akien-mga/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-03-28T15:38:26Z","updated_at":"2025-03-28T15:38:26Z","body":"I expect there would be quite some pushback from users if we merge this, the empty space looks pretty big.\r\nWould be good to collect more feedback on this and potential other options from UX minded people (cc @passivestar @RY-Storm).\r\n\r\nOne alternative option would be to do like browsers do (at least GTK based ones on Linux) and make the scrollbar invisible by default, and show it on hover as an overlay on the content:\r\n\r\n![image](https://github.com/user-attachments/assets/8b330ce9-28b4-46f3-9990-0a3e32fbb9aa)\r\n![image](https://github.com/user-attachments/assets/81ddef95-71a2-4c4d-b520-9e88671354b8)\r\n![image](https://github.com/user-attachments/assets/0c7a1516-ba62-4c42-8a2b-6de1e49a72cf)\r\n\r\n(Though I'm not sure what's up with this three-state UX pattern, and I personally find it often frustrating that scrollbars are invisible/thin and thus hard to grab, but this issue shows why that might be a good option anyway.)\r\n","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2761719017/reactions","total_count":3,"+1":3,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2761770572","html_url":"https://github.com/godotengine/godot/pull/104605#issuecomment-2761770572","issue_url":"https://api.github.com/repos/godotengine/godot/issues/104605","id":2761770572,"node_id":"IC_kwDOAO6SJc6knUZM","user":{"login":"Zireael07","id":4525388,"node_id":"MDQ6VXNlcjQ1MjUzODg=","avatar_url":"https://avatars.githubusercontent.com/u/4525388?v=4","gravatar_id":"","url":"https://api.github.com/users/Zireael07","html_url":"https://github.com/Zireael07","followers_url":"https://api.github.com/users/Zireael07/followers","following_url":"https://api.github.com/users/Zireael07/following{/other_user}","gists_url":"https://api.github.com/users/Zireael07/gists{/gist_id}","starred_url":"https://api.github.com/users/Zireael07/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Zireael07/subscriptions","organizations_url":"https://api.github.com/users/Zireael07/orgs","repos_url":"https://api.github.com/users/Zireael07/repos","events_url":"https://api.github.com/users/Zireael07/events{/privacy}","received_events_url":"https://api.github.com/users/Zireael07/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-03-28T16:00:35Z","updated_at":"2025-03-28T16:00:35Z","body":">  and I personally find it often frustrating that scrollbars are invisible/thin and thus hard to grab\r\n\r\nThis very much. If they do that, I want them to be big!","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2761770572/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2761881865","html_url":"https://github.com/godotengine/godot/pull/104605#issuecomment-2761881865","issue_url":"https://api.github.com/repos/godotengine/godot/issues/104605","id":2761881865,"node_id":"IC_kwDOAO6SJc6knvkJ","user":{"login":"RY-Storm","id":143893793,"node_id":"U_kgDOCJOlIQ","avatar_url":"https://avatars.githubusercontent.com/u/143893793?v=4","gravatar_id":"","url":"https://api.github.com/users/RY-Storm","html_url":"https://github.com/RY-Storm","followers_url":"https://api.github.com/users/RY-Storm/followers","following_url":"https://api.github.com/users/RY-Storm/following{/other_user}","gists_url":"https://api.github.com/users/RY-Storm/gists{/gist_id}","starred_url":"https://api.github.com/users/RY-Storm/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/RY-Storm/subscriptions","organizations_url":"https://api.github.com/users/RY-Storm/orgs","repos_url":"https://api.github.com/users/RY-Storm/repos","events_url":"https://api.github.com/users/RY-Storm/events{/privacy}","received_events_url":"https://api.github.com/users/RY-Storm/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-03-28T16:37:36Z","updated_at":"2025-03-28T17:05:00Z","body":"Thanks for the tag @akien-mga!\r\n\r\n>  show it on hover as an overlay on the content\r\n\r\nI think what you say here is what would please the most folks.\r\n\r\nIn a nutshell, from a UX standpoint, what I think would work well is:\r\n- Have the scrollbar be an overlay over the content, so that content does not jump, and no deadspace exists when it is invisible\r\n- Have the initial scrollbar be thin, so it is not obtrusive\r\n- Make the scrollbar thicker when it is hovered over directly, with some leeway on either side, for accessibility of the scrollbar, both visually and as an area to grab.\r\n- Do not show a scrollbar when the window cannot be scrolled. (No full-length scrollbar)\r\n\r\nWith an option of two paths for UX:\r\n- Show the scrollbar when the window is hovered over\r\nor\r\n- Show the scrollbar when the mouse is hovering near it, at the edge of the window, and when scrolling is triggered in any way\r\n\r\n\r\n\r\n\r\n","author_association":"NONE","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2761881865/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2761937717","html_url":"https://github.com/godotengine/godot/pull/104605#issuecomment-2761937717","issue_url":"https://api.github.com/repos/godotengine/godot/issues/104605","id":2761937717,"node_id":"IC_kwDOAO6SJc6kn9M1","user":{"login":"RY-Storm","id":143893793,"node_id":"U_kgDOCJOlIQ","avatar_url":"https://avatars.githubusercontent.com/u/143893793?v=4","gravatar_id":"","url":"https://api.github.com/users/RY-Storm","html_url":"https://github.com/RY-Storm","followers_url":"https://api.github.com/users/RY-Storm/followers","following_url":"https://api.github.com/users/RY-Storm/following{/other_user}","gists_url":"https://api.github.com/users/RY-Storm/gists{/gist_id}","starred_url":"https://api.github.com/users/RY-Storm/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/RY-Storm/subscriptions","organizations_url":"https://api.github.com/users/RY-Storm/orgs","repos_url":"https://api.github.com/users/RY-Storm/repos","events_url":"https://api.github.com/users/RY-Storm/events{/privacy}","received_events_url":"https://api.github.com/users/RY-Storm/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-03-28T17:02:57Z","updated_at":"2025-03-28T17:03:51Z","body":"And I would be remiss if I didn't show myself following my own advice of: \"Always look at what is out there.\", so here are some gifs of examples:\r\n\r\nUnity:\r\n![Unity-Scrollbar-Gif](https://github.com/user-attachments/assets/e83c9367-28d9-4fbb-b071-28fc0c2e7488)\r\nThe content jumps\r\n\r\nUnreal:\r\n![Unreal-Scrollbar-Gif](https://github.com/user-attachments/assets/cd71b05b-d257-49ff-8568-38939de8eeac)\r\nThe content jumps\r\n\r\nLibreOffice Writer:\r\n![LibreOfficeWriter-Scrollbar-Gif](https://github.com/user-attachments/assets/8df464b8-5fe4-412f-a715-49c18ea19e83)\r\nThe content does not jump, but the scrollbar is always visible, so it may cover content.\r\n\r\nOBS:\r\n![OBS-Scrollbar-Gif](https://github.com/user-attachments/assets/21323bae-3ef5-4bd4-8236-4ed49982ab84)\r\nThe content does not jump, but the scrollbar is always visible, so it may cover content.\r\n\r\nI think theses examples reinforce what I mentioned in the above comment: \r\nOnly show the scrollbar when hovering near it, and only show it when it can be used.\r\n","author_association":"NONE","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2761937717/reactions","total_count":5,"+1":5,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2762155728","html_url":"https://github.com/godotengine/godot/pull/104605#issuecomment-2762155728","issue_url":"https://api.github.com/repos/godotengine/godot/issues/104605","id":2762155728,"node_id":"IC_kwDOAO6SJc6koybQ","user":{"login":"passivestar","id":60579014,"node_id":"MDQ6VXNlcjYwNTc5MDE0","avatar_url":"https://avatars.githubusercontent.com/u/60579014?v=4","gravatar_id":"","url":"https://api.github.com/users/passivestar","html_url":"https://github.com/passivestar","followers_url":"https://api.github.com/users/passivestar/followers","following_url":"https://api.github.com/users/passivestar/following{/other_user}","gists_url":"https://api.github.com/users/passivestar/gists{/gist_id}","starred_url":"https://api.github.com/users/passivestar/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/passivestar/subscriptions","organizations_url":"https://api.github.com/users/passivestar/orgs","repos_url":"https://api.github.com/users/passivestar/repos","events_url":"https://api.github.com/users/passivestar/events{/privacy}","received_events_url":"https://api.github.com/users/passivestar/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-03-28T18:42:12Z","updated_at":"2025-03-28T18:42:12Z","body":"I agree that showing scrollbar as an overlay on hover is the cleanest solution, blender is doing the same btw:\r\n\r\nhttps://github.com/user-attachments/assets/5c24a05b-d63a-40e7-90c0-38046eaf25dd\r\n\r\nThe empty space reserved for the scrollbar in this PR does look a little weird to me, especially with godot's default theme that draws a visible border around the tree, making that empty space more noticeable\r\n\r\nOverall I think draggable scrollbar is more of an accessibility feature than an essential one. It was unavoidable in the past when most mainstream mice didn't have a scrollwheel. Grabbing the scrollbar is always slower than using a scrollwheel even if the scrollbar is big, just like every interaction that needs aim. It makes sense for it to stay hidden/narrow most of the time and serve mostly as an indicator","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2762155728/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2762228625","html_url":"https://github.com/godotengine/godot/pull/104605#issuecomment-2762228625","issue_url":"https://api.github.com/repos/godotengine/godot/issues/104605","id":2762228625,"node_id":"IC_kwDOAO6SJc6kpEOR","user":{"login":"arkology","id":43543909,"node_id":"MDQ6VXNlcjQzNTQzOTA5","avatar_url":"https://avatars.githubusercontent.com/u/43543909?v=4","gravatar_id":"","url":"https://api.github.com/users/arkology","html_url":"https://github.com/arkology","followers_url":"https://api.github.com/users/arkology/followers","following_url":"https://api.github.com/users/arkology/following{/other_user}","gists_url":"https://api.github.com/users/arkology/gists{/gist_id}","starred_url":"https://api.github.com/users/arkology/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/arkology/subscriptions","organizations_url":"https://api.github.com/users/arkology/orgs","repos_url":"https://api.github.com/users/arkology/repos","events_url":"https://api.github.com/users/arkology/events{/privacy}","received_events_url":"https://api.github.com/users/arkology/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-03-28T19:18:06Z","updated_at":"2025-03-28T19:18:06Z","body":"> Overall I think draggable scrollbar is more of an accessibility feature than an essential one. It was unavoidable in the past when most mainstream mice didn't have a scrollwheel. Grabbing the scrollbar is always slower than using a scrollwheel even if the scrollbar is big, just like every interaction that needs aim.\r\n\r\nGodot also has Android version. On Android navigation using scrollbar in Godot is main option (in terms of usability, at least for me). Also it has significantly increased width.","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2762228625/reactions","