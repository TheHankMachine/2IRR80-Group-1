ntly overwrite some unrelated bytes. ","created_at":"2025-01-01T18:29:10Z","updated_at":"2025-01-01T18:29:10Z","html_url":"https://github.com/godotengine/godot/pull/100995#discussion_r1900442877","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/100995","_links":{"self":{"href":"https://api.github.com/repos/godotengine/godot/pulls/comments/1900442877"},"html":{"href":"https://github.com/godotengine/godot/pull/100995#discussion_r1900442877"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/100995"}},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/1900442877/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":162,"original_line":162,"side":"RIGHT","in_reply_to_id":1900419736,"author_association":"CONTRIBUTOR","original_position":5,"position":5,"subject_type":"line"},{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/1900444076","pull_request_review_id":2526912652,"id":1900444076,"node_id":"PRRC_kwDOAO6SJc5xRnms","diff_hunk":"@@ -159,7 +159,7 @@ class Variant {\n \t\tBasis *_basis;\n \t\tTransform *_transform;\n \t\tvoid *_ptr; //generic pointer\n-\t\tuint8_t _mem[sizeof(ObjData) > (sizeof(real_t) * 4) ? sizeof(ObjData) : (sizeof(real_t) * 4)];\n+\t\tuint8_t _mem[sizeof(ObjData) > (sizeof(real_t) * 4) ? sizeof(ObjData) : (sizeof(real_t) * 4)]{ 0 };","path":"core/variant.h","commit_id":"d549b98c5cb4b68f38aece3171cd0aac7c63a7a7","original_commit_id":"2ee55aeadcb7b3abba50d23a0e9f58d28a2fc81c","user":{"login":"lawnjelly","id":21999379,"node_id":"MDQ6VXNlcjIxOTk5Mzc5","avatar_url":"https://avatars.githubusercontent.com/u/21999379?v=4","gravatar_id":"","url":"https://api.github.com/users/lawnjelly","html_url":"https://github.com/lawnjelly","followers_url":"https://api.github.com/users/lawnjelly/followers","following_url":"https://api.github.com/users/lawnjelly/following{/other_user}","gists_url":"https://api.github.com/users/lawnjelly/gists{/gist_id}","starred_url":"https://api.github.com/users/lawnjelly/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/lawnjelly/subscriptions","organizations_url":"https://api.github.com/users/lawnjelly/orgs","repos_url":"https://api.github.com/users/lawnjelly/repos","events_url":"https://api.github.com/users/lawnjelly/events{/privacy}","received_events_url":"https://api.github.com/users/lawnjelly/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"Not sure I understand, `_mem` is part of a union, the size of the union will expand to fit the largest member.","created_at":"2025-01-01T18:37:07Z","updated_at":"2025-01-01T18:37:07Z","html_url":"https://github.com/godotengine/godot/pull/100995#discussion_r1900444076","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/100995","_links":{"self":{"href":"https://api.github.com/repos/godotengine/godot/pulls/comments/1900444076"},"html":{"href":"https://github.com/godotengine/godot/pull/100995#discussion_r1900444076"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/100995"}},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/1900444076/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":162,"original_line":162,"side":"RIGHT","in_reply_to_id":1900419736,"author_association":"MEMBER","original_position":5,"position":5,"subject_type":"line"},{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/1900446246","pull_request_review_id":2526914844,"id":1900446246,"node_id":"PRRC_kwDOAO6SJc5xRoIm","diff_hunk":"@@ -159,7 +159,7 @@ class Variant {\n \t\tBasis *_basis;\n \t\tTransform *_transform;\n \t\tvoid *_ptr; //generic pointer\n-\t\tuint8_t _mem[sizeof(ObjData) > (sizeof(real_t) * 4) ? sizeof(ObjData) : (sizeof(real_t) * 4)];\n+\t\tuint8_t _mem[sizeof(ObjData) > (sizeof(real_t) * 4) ? sizeof(ObjData) : (sizeof(real_t) * 4)]{ 0 };","path":"core/variant.h","commit_id":"d549b98c5cb4b68f38aece3171cd0aac7c63a7a7","original_commit_id":"2ee55aeadcb7b3abba50d23a0e9f58d28a2fc81c","user":{"login":"lawnjelly","id":21999379,"node_id":"MDQ6VXNlcjIxOTk5Mzc5","avatar_url":"https://avatars.githubusercontent.com/u/21999379?v=4","gravatar_id":"","url":"https://api.github.com/users/lawnjelly","html_url":"https://github.com/lawnjelly","followers_url":"https://api.github.com/users/lawnjelly/followers","following_url":"https://api.github.com/users/lawnjelly/following{/other_user}","gists_url":"https://api.github.com/users/lawnjelly/gists{/gist_id}","starred_url":"https://api.github.com/users/lawnjelly/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/lawnjelly/subscriptions","organizations_url":"https://api.github.com/users/lawnjelly/orgs","repos_url":"https://api.github.com/users/lawnjelly/repos","events_url":"https://api.github.com/users/lawnjelly/events{/privacy}","received_events_url":"https://api.github.com/users/lawnjelly/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"So I'm kind of getting it to compile without the warnings using this unholy mess:\r\n```\r\n#if defined(__clang__) && (__clang_major__ >= 13)\r\n#pragma clang diagnostic push\r\n#pragma clang diagnostic ignored \"-Wuninitialized\"\r\n#endif\r\n#if defined(__GNUC__) && !defined(__clang__)\r\n#pragma GCC diagnostic push\r\n#pragma GCC diagnostic warning \"-Wuninitialized\"\r\n#endif\r\n\t\t_data = p_variant._data;\r\n#if defined(__GNUC__) && !defined(__clang__)\r\n#pragma GCC diagnostic pop\r\n#endif\r\n#if defined(__clang__) && (__clang_major__ >= 13)\r\n#pragma clang diagnostic pop\r\n#endif\r\n```\r\nBut I think on balance, given there doesn't appear to be a performance penalty to zeroing, that we should just stay with the safer approach and initialize the data.\r\n\r\nHappy to change of course if others feel strongly we should not zero.\r\n\r\nIncidentally I tracked down where the zeroing for `_mem` was introduced in master, it was in #51017 .\r\n","created_at":"2025-01-01T18:54:28Z","updated_at":"2025-01-01T19:01:22Z","html_url":"https://github.com/godotengine/godot/pull/100995#discussion_r1900446246","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/100995","_links":{"self":{"href":"https://api.github.com/repos/godotengine/godot/pulls/comments/1900446246"},"html":{"href":"https://github.com/godotengine/godot/pull/100995#discussion_r1900446246"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/100995"}},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/1900446246/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":162,"original_line":162,"side":"RIGHT","in_reply_to_id":1900419736,"author_association":"MEMBER","original_position":5,"position":5,"subject_type":"line"},{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/1900581025","pull_request_review_id":2527085408,"id":1900581025,"node_id":"PRRC_kwDOAO6SJc5xSJCh","diff_hunk":"@@ -159,7 +159,7 @@ class Variant {\n \t\tBasis *_basis;\n \t\tTransform *_transform;\n \t\tvoid *_ptr; //generic pointer\n-\t\tuint8_t _mem[sizeof(ObjData) > (sizeof(real_t) * 4) ? sizeof(ObjData) : (sizeof(real_t) * 4)];\n+\t\tuint8_t _mem[sizeof(ObjData) > (sizeof(real_t) * 4) ? sizeof(ObjData) : (sizeof(real_t) * 4)]{ 0 };","path":"core/variant.h","commit_id":"d549b98c5cb4b68f38aece3171cd0aac7c63a7a7","original_commit_id":"2ee55aeadcb7b3abba50d23a0e9f58d28a2fc81c","user":{"login":"kiroxas","id":3176062,"node_id":"MDQ6VXNlcjMxNzYwNjI=","avatar_url":"https://avatars.githubusercontent.com/u/3176062?v=4","gravatar_id":"","url":"https://api.github.com/users/kiroxas","html_url":"https://github.com/kiroxas","followers_url":"https://api.github.com/users/kiroxas/followers","following_url":"https://api.github.com/users/kiroxas/following{/other_user}","gists_url":"https://api.github.com/users/kiroxas/gists{/gist_id}","starred_url":"https://api.github.com/users/kiroxas/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/kiroxas/subscriptions","organizations_url":"https://api.github.com/users/kiroxas/orgs","repos_url":"https://api.github.com/users/kiroxas/repos","events_url":"https://api.github.com/users/kiroxas/events{/privacy}","received_events_url":"https://api.github.com/users/kiroxas/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"> Not sure I understand, `_mem` is part of a union, the size of the union will expand to fit the largest member.\r\n\r\nYes, but we construct types that are not in the Union in the `_mem` space for example : \r\n```\r\nVariant::Variant(const Rect2i &p_rect2i) :\r\n\t\ttype(RECT2I) {\r\n\tmemnew_placement(_data._mem, Rect2i(p_rect2i));\r\n}\r\n```\r\n\r\nYou can see the copy in the assembly.\r\n![assembly](https://github.com/user-attachments/assets/2ba9d762-935c-4a7c-a992-acb82daa1279)\r\n\r\nSo here, if rect2i was bigger than data._mem, we will write on bytes that are not part of variant.\r\nWe should probably add static_asserts in those constructors (assuming _mem is the biggest member of the union, which it is right now): \r\n\r\n```\r\nVariant::Variant(const Rect2i &p_rect2i) :\r\n\t\ttype(RECT2I) {\r\n\tmemnew_placement(_data._mem, Rect2i(p_rect2i));\r\n        static_assert(sizeof(Rect2i) <= sizeof(_data._mem));\r\n}\r\n```\r\n\r\nNobody triggers the static_assert right now, but it would probably be safer to be future proof to add those static asserts.","created_at":"2025-01-02T06:47:22Z","updated_at":"2025-01-02T06:52:18Z","html_url":"https://github.com/godotengine/godot/pull/100995#discussion_r1900581025","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/100995","_links":{"self":{"href":"https://api.github.com/repos/godotengine/godot/pulls/comments/1900581025"},"html":{"href":"https://github.com/godotengine/godot/pull/100995#discussion_r1900581025"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/100995"}},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/1900581025/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":162,"original_line":162,"side":"RIGHT","in_reply_to_id":1900419736,"author_association":"CONTRIBUTOR","original_position":5,"position":5,"subject_type":"line"},{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/1900595600","pull_request_review_id":2527108965,"id":1900595600,"node_id":"PRRC_kwDOAO6SJc5xSMmQ","diff_hunk":"@@ -159,7 +159,7 @@ class Variant {\n \t\tBasis *_basis;\n \t\tTransform *_transform;\n \t\tvoid *_ptr; //generic pointer\n-\t\tuint8_t _mem[sizeof(ObjData) > (sizeof(real_t) * 4) ? sizeof(ObjData) : (sizeof(real_t) * 4)];\n+\t\tuint8_t _mem[sizeof(ObjData) > (sizeof(real_t) * 4) ? sizeof(ObjData) : (sizeof(real_t) * 4)]{ 0 };","path":"core/variant.h","commit_id":"d549b98c5cb4b68f38aece3171cd0aac7c63a7a7","original_commit_id":"2ee55aeadcb7b3abba50d23a0e9f58d28a2fc81c","user":{"login":"lawnjelly","id":21999379,"node_id":"MDQ6VXNlcjIxOTk5Mzc5","avatar_url":"https://avatars.githubusercontent.com/u/21999379?v=4","gravatar_id":"","url":"https://api.github.com/users/lawnjelly","html_url":"https://github.com/lawnjelly","followers_url":"https://api.github.com/users/lawnjelly/followers","following_url":"https://api.github.com/users/lawnjelly/following{/other_user}","gists_url":"https://api.github.com/users/lawnjelly/gists{/gist_id}","starred_url":"https://api.github.com/users/lawnjelly/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/lawnjelly/subscriptions","organizations_url":"https://api.github.com/users/lawnjelly/orgs","repos_url":"https://api.github.com/users/lawnjelly/repos","events_url":"https://api.github.com/users/lawnjelly/events{/privacy}","received_events_url":"https://api.github.com/users/lawnjelly/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"Ah I see, agreed static asserts wouldn't be a bad addition. :+1: \r\n\r\nBut better for a separate PR (it is an unrelated change, as there is no change in the size of `Variant` here).","created_at":"2025-01-02T07:17:52Z","updated_at":"2025-01-02T07:28:11Z","html_url":"https://github.com/godotengine/godot/pull/100995#discussion_r1900595600","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/100995","_links":{"self":{"href":"https://api.github.com/repos/godotengine/godot/pulls/comments/1900595600"},"html":{"href":"https://github.com/godotengine/godot/pull/100995#discussion_r1900595600"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/100995"}},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/1900595600/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":162,"original_line":162,"side":"RIGHT","in_reply_to_id":1900419736,"author_association":"MEMBER","original_position":5,"position":5,"subject_type":"line"}]