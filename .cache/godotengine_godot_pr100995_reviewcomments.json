ariant, it stores them externally.)\r\n\r\nJust noticed it is `real_t` * 4 .. however in 3.x `real_t` is always 32 bit.\r\n\r\nI'll have a look whether this warning can be disabled though, just in case. (It might trigger sanitizers too, which would be an annoying false positive :thinking: ).","created_at":"2025-01-01T16:52:27Z","updated_at":"2025-01-01T17:05:27Z","html_url":"https://github.com/godotengine/godot/pull/100995#discussion_r1900431069","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/100995","_links":{"self":{"href":"https://api.github.com/repos/godotengine/godot/pulls/comments/1900431069"},"html":{"href":"https://github.com/godotengine/godot/pull/100995#discussion_r1900431069"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/100995"}},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/1900431069/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":162,"original_line":162,"side":"RIGHT","in_reply_to_id":1900419736,"author_association":"MEMBER","original_position":5,"position":5,"subject_type":"line"},{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/1900434488","pull_request_review_id":2526902265,"id":1900434488,"node_id":"PRRC_kwDOAO6SJc5xRlQ4","diff_hunk":"@@ -159,7 +159,7 @@ class Variant {\n \t\tBasis *_basis;\n \t\tTransform *_transform;\n \t\tvoid *_ptr; //generic pointer\n-\t\tuint8_t _mem[sizeof(ObjData) > (sizeof(real_t) * 4) ? sizeof(ObjData) : (sizeof(real_t) * 4)];\n+\t\tuint8_t _mem[sizeof(ObjData) > (sizeof(real_t) * 4) ? sizeof(ObjData) : (sizeof(real_t) * 4)]{ 0 };","path":"core/variant.h","commit_id":"d549b98c5cb4b68f38aece3171cd0aac7c63a7a7","original_commit_id":"2ee55aeadcb7b3abba50d23a0e9f58d28a2fc81c","user":{"login":"kiroxas","id":3176062,"node_id":"MDQ6VXNlcjMxNzYwNjI=","avatar_url":"https://avatars.githubuser