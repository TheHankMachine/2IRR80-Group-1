the left) before it has been written to or initialized. It's not a bug per se (as being lazy about this is (at least in theory) potentially better for performance). The alternative is to hide the warning.\r\n\r\nIn my performance tests there weren't any noticeable slowdown due to this initialization (although perhaps the speedup in the move semantics is hiding this). ","created_at":"2025-01-01T15:44:49Z","updated_at":"2025-01-01T15:46:22Z","html_url":"https://github.com/godotengine/godot/pull/100995#discussion_r1900421093","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/100995","_links":{"self":{"href":"https://api.github.com/repos/godotengine/godot/pulls/comments/1900421093"},"html":{"href":"https://github.com/godotengine/godot/pull/100995#discussion_r1900421093"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/100995"}},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/1900421093/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":162,"original_line":162,"side":"RIGHT","in_reply_to_id":1900419736,"author_association":"MEMBER","original_position":5,"position":5,"subject_type":"line"},{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/1900430164","pull_request_review_id":2526897644,"id":1900430164,"node_id":"PRRC_kwDOAO6SJc5xRkNU","diff_hunk":"@@ -159,7 +159,7 @@ class Variant {\n \t\tBasis *_basis;\n \t\tTransform *_transform;\n \t\tvoid *_ptr; //generic pointer\n-\t\tuint8_t _mem[sizeof(ObjData) > (sizeof(real_t) * 4) ? sizeof(ObjData) : (sizeof(real_t) * 4)];\n+\t\tuint8_t _mem[sizeof(ObjData) > (sizeof(real_t) * 4) ? sizeof(ObjData) : (sizeof(real_t) * 4)]{ 0 };","path":"core/variant.h","commit_id":"d549b98c5cb4b68f38aece3171cd0aac7c63a7a7","original_commit_id":"2ee55aeadcb7b3abba50d23a0e9f58d28a2fc81c","user":{"login":"kiroxas","id":3176062,"node_id":"MDQ6VXNlcjMxNzYwNjI=","avatar_url":"https://avatars.githubusercontent.com/u/3176062?v=4","gravatar_id":"","url":"https://api.github.com/users/kiroxas","html_url":"https://github.com/kiroxas","followers_url":"https://api.github.com/users/kiroxas/followers","following_url":"https://api.github.com/users/kiroxas/following{/other_user}","gists_url":"https://api.github.com/users/kiroxas/gists{/gist_id}","starred_url":"https://api.github.com/users/kiroxas/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/kiroxas/subscriptions","organizations_url":"https://api.github.com/users/kiroxas/orgs","repos_url":"https://api.github.com/users/kiroxas/repos","events_url":"https://api.github.com/users/kiroxas/events{/privacy}","received_events_url":"https://api.github.com/users/kiroxas/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"Maybe inspect the assembly for this, for some type that is bigger than 128 bits ? It should be pretty free for small types, but it may generate a loop for bigger types. It will never be prohibitive, but as clearing to 0 is unecessary, and Variant is widely used, could be worth checking.","created_at":"2025-01-01T16:44:56Z","updated_at":"2025-01-01T16:44:56Z","html_url":"https://github.com/godotengine/godot/pull/100995#discussion_r1900430164","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/100995","_links":{"self":{"href":"https://api.github.com/repos/godotengine/godot/pulls/comments/1900430164"},"html":{"href":"https://github.com/godotengine/godot/pull/100995#discussion_r1900430164"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/100995"}},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/1900430164/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":162,"original_line":162,"