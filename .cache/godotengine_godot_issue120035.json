_id":"MDU6TGFiZWwyNzkxMjgwNDQ=","url":"https://api.github.com/repos/godotengine/godot/labels/confirmed","name":"confirmed","color":"aaddaa","default":false,"description":"","archived_at":null,"archived_by":null}],"state":"closed","locked":false,"assignees":[],"milestone":{"url":"https://api.github.com/repos/godotengine/godot/milestones/25","html_url":"https://github.com/godotengine/godot/milestone/25","labels_url":"https://api.github.com/repos/godotengine/godot/milestones/25/labels","id":15520464,"node_id":"MI_kwDOAO6SJc4A7NLQ","number":25,"title":"4.8","description":"","creator":{"login":"Repiteo","id":17489292,"node_id":"MDQ6VXNlcjE3NDg5Mjky","avatar_url":"https://avatars.githubusercontent.com/u/17489292?v=4","gravatar_id":"","url":"https://api.github.com/users/Repiteo","html_url":"https://github.com/Repiteo","followers_url":"https://api.github.com/users/Repiteo/followers","following_url":"https://api.github.com/users/Repiteo/following{/other_user}","gists_url":"https://api.github.com/users/Repiteo/gists{/gist_id}","starred_url":"https://api.github.com/users/Repiteo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Repiteo/subscriptions","organizations_url":"https://api.github.com/users/Repiteo/orgs","repos_url":"https://api.github.com/users/Repiteo/repos","events_url":"https://api.github.com/users/Repiteo/events{/privacy}","received_events_url":"https://api.github.com/users/Repiteo/received_events","type":"User","user_view_type":"public","site_admin":false},"open_issues":343,"closed_issues":2335,"state":"open","created_at":"2026-04-13T15:59:35Z","updated_at":"2026-10-22T06:28:22Z","due_on":null,"closed_at":null},"comments":2,"created_at":"2026-06-05T16:38:20Z","updated_at":"2026-07-10T15:27:17Z","closed_at":"2026-07-10T15:26:06Z","assignee":null,"author_association":"NONE","issue_field_values":[],"type":null,"active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"### Tested versions\n\nReproducible in: Godot v4.6.3.stable (7d41c59c4)\n\n### System information\n\nGodot v4.6.3.stable (7d41c59c4) - Windows 10 (build 19045) - Multi-window, 3 monitors - Direct3D 12 (Forward+) - dedicated NVIDIA GeForce RTX 4080 (NVIDIA; 32.0.15.9144) - 13th Gen Intel(R) Core(TM) i9-13900K (32 threads) - 31.77 GiB memory\n\n### Issue description\n\nWhen exiting the project, godot shows the following in the terminal:\n```\nWARNING: 19 RIDs of type \"CanvasItem\" were leaked.\n   at: _free_rids (servers/rendering/renderer_canvas_cull.cpp:2692)\nERROR: 2 RID allocations of type 'N10RendererRD14TextureStorage7TextureE' were leaked at exit.\nWARNING: 4 RIDs of type \"Texture\" were leaked.\n   at: finalize (servers/rendering/rendering_device.cpp:7505)\nERROR: 102 RID allocations of type 'PN18TextServerAdvanced22ShapedTextDataAdvancedE' were leaked at exit.\nERROR: 1 RID allocations of type 'PN18TextServerAdvanced12FontAdvancedE' were leaked at exit.\nWARNING: ObjectDB instances leaked at exit (run with --verbose for details).\n   at: cleanup (core/object/object.cpp:2663)\n```\nTo my understanding this happens because the UI elements godot creates to show `@export var settings: Dictionary[int, <Any Custom Resource>] = {}` (they are not being freed).\n\n### Steps to reproduce\n\n1. Create a custom resource such as:\n```\nclass_name Settings\nextends Resource\n\n@export var power_level: int = 0\n```\n2. Then create a class that export it via `Dictionary`:\n```\nclass_name Shimi\nextends Control\n\n@export var settings: Dictionary[int, Settings] = {}\n```\n3. Open a scene, and add the class with the `Dictionary`.\n4. Add an item to the `Dictionary`.\n5. Quit via `Project > Quit to Project List`.\n\n### Minimal reproduction project (MRP)\n\n[leak_example.zip](https://github.com/user-attachments/files/28647134/leak_example.zip)","closed_by":{"login":"Repiteo","id":17489292,"node_id":"MDQ6VXNlcjE3NDg5Mjky","avatar_url":"https://avatars.githubusercontent.com/u/17489292?v=4","gravatar_id":"","url":"https://api.github.com/users/Repiteo","html_url":"https://github.com/Repiteo","followers_url":"https://api.github.com/users/Repiteo/followers","following_url":"https://api.github.com/users/Repiteo/following{/other_user}","gists_url":"https://api.github.com/users/Repiteo/gists{/gist_id}","starred_url":"https://api.github.com/users/Repiteo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Repiteo/subscriptions","organizations_url":"https://api.github.com/users/Repiteo/orgs","repos_url":"https://api.github.com/users/Repiteo/repos","events_url":"https://api.github.com/users/Repiteo/events{/privacy}","received_events_url":"https://api.github.com/users/Repiteo/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/120035/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/godotengine/godot/issues/120035/timeline","performed_via_github_app":null,"state_reason":"completed","pinned_comment":null}