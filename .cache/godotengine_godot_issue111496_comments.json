ub.com/users/Repiteo","html_url":"https://github.com/Repiteo","followers_url":"https://api.github.com/users/Repiteo/followers","following_url":"https://api.github.com/users/Repiteo/following{/other_user}","gists_url":"https://api.github.com/users/Repiteo/gists{/gist_id}","starred_url":"https://api.github.com/users/Repiteo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Repiteo/subscriptions","organizations_url":"https://api.github.com/users/Repiteo/orgs","repos_url":"https://api.github.com/users/Repiteo/repos","events_url":"https://api.github.com/users/Repiteo/events{/privacy}","received_events_url":"https://api.github.com/users/Repiteo/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-10-11T02:17:50Z","updated_at":"2025-10-11T02:17:50Z","body":"I agree with the old behavior being bad; I approved the PR after all! But it being merged was under the assumption that it reached core consensus, which was a blunder on my part","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3392755084/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3392764395","html_url":"https://github.com/godotengine/godot/pull/111496#issuecomment-3392764395","issue_url":"https://api.github.com/repos/godotengine/godot/issues/111496","id":3392764395,"node_id":"IC_kwDOAO6SJc7KOXnr","user":{"login":"wareya","id":585488,"node_id":"MDQ6VXNlcjU4NTQ4OA==","avatar_url":"https://avatars.githubusercontent.com/u/585488?v=4","gravatar_id":"","url":"https://api.github.com/users/wareya","html_url":"https://github.com/wareya","followers_url":"https://api.github.com/users/wareya/followers","following_url":"https://api.github.com/users/wareya/following{/other_user}","gists_url":"https://api.github.com/users/wareya/gists{/gist_id}","starred_url":"https://api.github.com/users/wareya/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/wareya/subscriptions","organizations_url":"https://api.github.com/users/wareya/orgs","repos_url":"https://api.github.com/users/wareya/repos","events_url":"https://api.github.com/users/wareya/events{/privacy}","received_events_url":"https://api.github.com/users/wareya/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-10-11T02:22:51Z","updated_at":"2025-10-11T02:23:16Z","body":"imo there are basically only two or three sane solutions here, neither of which is the status quo:\n\n1) 1e99999 and \"NaN\"\n2) 1e99999 but throw an error for nans\n3) 1e99999 and let the user pick their own nan behavior\n\nStarting with merging behavior 1 or 2 and then working from there towards whatever the developer bikeshed consensus is, is much better than juggling whether or not standards matter. JSON is a ***standard***, and generating broken JSON is wrong.\n\nEmitting 1e99999 for infinity is entirely completely unproblematic and is a bugfix, not breakage. Not every observable behavioral change is breakage.\n\nI'll stop repeating myself now.","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3392764395/reactions","total_count":4,"+1":4,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3392954613","html_url":"https://github.com/godotengine/godot/pull/111496#issuecomment-3392954613","issue_url":"https://api.github.com/repos/godotengine/godot/issues/111496","id":3392954613,"node_id":"IC_kwDOAO6SJc7KPGD1","user":{"login":"clayjohn","id":16521339,"node_id":"MDQ6VXNlcjE2NTIxMzM5","avatar_url":"https://avatars.githubusercontent.com/u/16521339?v=4","gravatar_id":"","url":"https://api.github.com/users/clayjohn","html_url":"https://github.com/clayjohn","followers_url":"https://api.github.com/users/clayjohn/followers","following_url":"https://api.github.com/users/clayjohn/following{/other_user}","gists_url":"https://api.github.com/users/clayjohn/gists{/gist_id}","starred_url":"https://api.github.com/users/clayjohn/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/clayjohn/subscriptions","organizations_url":"https://api.github.com/users/clayjohn/orgs","repos_url":"https://api.github.com/users/clayjohn/repos","events_url":"https://api.github.com/users/clayjohn/events{/privacy}","received_events_url":"https://api.github.com/users/clayjohn/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-10-11T05:53:00Z","updated_at":"2025-10-11T05:53:00Z","body":"Please read my PR description above. No one is saying that the old behaviour is desirable. But https://github.com/godotengine/godot/pull/108837 was not the way to solve it as is not an improvement over the status quo. It would break a bunch of people's games to trade one broken state for another. \r\n\r\nWe need to implement a solution that doesn't just shuffle around which cases are broken and surprise users in a totally different non-standard way.\r\n\r\nThe absolutely worst thing we can do here is continuously change the non-standard broken behaviour to other non-standard broken behaviour as we work towards a solution. Instead we need to actually implement a solution that we are happy with, merge it and then stick with that decision for the foreseeable future. ","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3392954613/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3392955733","html_url":"https://github.com/godotengine/godot/pull/111496#issuecomment-3392955733","issue_url":"https://api.github.com/repos/godotengine/godot/issues/111496","id":3392955733,"node_id":"IC_kwDOAO6SJc7KPGVV","user":{"login":"wareya","id":585488,"node_id":"MDQ6VXNlcjU4NTQ4OA==","avatar_url":"https://avatars.githubusercontent.com/u/585488?v=4","gravatar_id":"","url":"https://api.github.com/users/wareya","html_url":"https://github.com/wareya","followers_url":"https://api.github.com/users/wareya/followers","following_url":"https://api.github.com/users/wareya/following{/other_user}","gists_url":"https://api.github.com/users/wareya/gists{/gist_id}","starred_url":"https://api.github.com/users/wareya/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/wareya/subscriptions","organizations_url":"https://api.github.com/users/wareya/orgs","repos_url":"https://api.github.com/users/wareya/repos","events_url":"https://api.github.com/users/wareya/events{/privacy}","received_events_url":"https://api.github.com/users/wareya/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-10-11T05:55:05Z","updated_at":"2025-10-11T05:55:05Z","body":"**Producing 1e99999 for infinities is not broken behavior.** It is specifically a correct behavior.","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3392955733/reactions","total_count":3,"+1":3,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3392966187","html_url":"https://github.com/godotengine/godot/pull/111496#issuecomment-3392966187","issue_url":"https://api.github.com/repos/godotengine/godot/issues/111496","id":3392966187,"node_id":"IC_kwDOAO6SJc7KPI4r","user":{"login":"clayjohn","id":16521339,"node_id":"MDQ6VXNlcjE2NTIxMzM5","avatar_url":"https://avatars.githubusercontent.com/u/16521339?v=4","grav