ekSun97/following{/other_user}","gists_url":"https://api.github.com/users/JekSun97/gists{/gist_id}","starred_url":"https://api.github.com/users/JekSun97/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/JekSun97/subscriptions","organizations_url":"https://api.github.com/users/JekSun97/orgs","repos_url":"https://api.github.com/users/JekSun97/repos","events_url":"https://api.github.com/users/JekSun97/events{/privacy}","received_events_url":"https://api.github.com/users/JekSun97/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-07-17T22:13:34Z","updated_at":"2026-07-17T22:13:34Z","body":"Great improvement! It would be cool to see this in 3D.","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5007970586/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5014105257","html_url":"https://github.com/godotengine/godot/pull/121471#issuecomment-5014105257","issue_url":"https://api.github.com/repos/godotengine/godot/issues/121471","id":5014105257,"node_id":"IC_kwDOAO6SJc8AAAABKt0sqQ","user":{"login":"Thiago-Weiss","id":137117035,"node_id":"U_kgDOCCw9aw","avatar_url":"https://avatars.githubusercontent.com/u/137117035?v=4","gravatar_id":"","url":"https://api.github.com/users/Thiago-Weiss","html_url":"https://github.com/Thiago-Weiss","followers_url":"https://api.github.com/users/Thiago-Weiss/followers","following_url":"https://api.github.com/users/Thiago-Weiss/following{/other_user}","gists_url":"https://api.github.com/users/Thiago-Weiss/gists{/gist_id}","starred_url":"https://api.github.com/users/Thiago-Weiss/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Thiago-Weiss/subscriptions","organizations_url":"https://api.github.com/users/Thiago-Weiss/orgs","repos_url":"https://api.github.com/users/Thiago-Weiss/repos","events_url":"https://api.github.com/users/Thiago-Weiss/events{/privacy}","received_events_url":"https://api.github.com/users/Thiago-Weiss/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-07-19T03:49:18Z","updated_at":"2026-07-19T03:49:18Z","body":"> reat improvement! It would be cool to see this in 3D.\r\n\r\nIn 3D, it seems there's already something like that, it draws a circle without depth (img 1). To be honest, I have over 500 hours in 2D but not even an hour in 3D so I don't even know how the sound works or how I'd draw this, BUT I gave it a try. Which of the two would look better (img 2 or 3)?\r\n\r\nimg 1\r\n<img width=\"905\" height=\"793\" alt=\"image\" src=\"https://github.com/user-attachments/assets/f70f4723-c565-4626-9bb2-e973b1a1f7a0\" />\r\n\r\nimg 2\r\n<img width=\"696\" height=\"654\" alt=\"image\" src=\"https://github.com/user-attachments/assets/f6fabc2a-459f-49ab-824f-9e8395d33028\" />\r\n\r\nimg 3\r\n<img width=\"688\" height=\"632\" alt=\"image\" src=\"https://github.com/user-attachments/assets/a15caf0b-f174-4376-b970-f4f092ca8f6e\" />\r\n\r\nIt's just a prototype using CollisionShape3D.","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5014105257/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5015057102","html_url":"https://github.com/godotengine/godot/pull/121471#issuecomment-5015057102","issue_url":"https://api.github.com/repos/godotengine/godot/issues/121471","id":5015057102,"node_id":"IC_kwDOAO6SJc8AAAABKuuyzg","user":{"login":"BrianGixxob","id":229223789,"node_id":"U_kgDODamtbQ","avatar_url":"https://avatars.githubusercontent.com/u/229223789?v=4","gravatar_id":"","url":"https://api.github.com/users/BrianGixxob","html_url":"https://github.com/BrianGixxob","followers_url":"https://api.github.com/users/BrianGixxob/followers","following_url":"https://api.github.com/users/BrianGixxob/following{/other_user}","gists_url":"https://api.github.com/users/BrianGixxob/gists{/gist_id}","starred_url":"https://api.github.com/users/BrianGixxob/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/BrianGixxob/subscriptions","organizations_url":"https://api.github.com/users/BrianGixxob/orgs","repos_url":"https://api.github.com/users/BrianGixxob/repos","events_url":"https://api.github.com/users/BrianGixxob/events{/privacy}","received_events_url":"https://api.github.com/users/BrianGixxob/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-07-19T08:37:52Z","updated_at":"2026-07-19T09:08:08Z","body":"1. Inspector name change ideas: \r\n\r\n    - Change `Debug` to `Visualization` (more specific to what it does).\r\n    - Change `Range Color` to `Color` (because it colors both range and attenuation).\r\n\r\n2. Tooltip ideas:\r\n\r\n    - Enabled: If `true`, draw a visualization to display `range` and `attenuation` using `color`. \r\n    - Color: \"Color of the `visualization`.\"; or \"The `visualization` draws with this color.\"\r\n\r\n3. I'm not sure how obvious this is: Should there be a note in \"Enabled\" that this visualization is only visible in the editor or with Debug -> Visible Collision Shapes enabled?\r\n\r\n4. To improve performance on slower devices, maybe expose the values in the Inspector for these lines so the user can reduce them:\r\n`_draw_audio_range()`:\r\n\r\n    - `int steps = CLAMP(int(max_distance / 20.0), 10, 30);`\r\n    - `int POINT_COUNT = 64;`\r\n    - or maybe have a checkbox to \"draw only range (not attenuation)\".","author_association":"NONE","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5015057102/reactions","total_count":0,"+1":0,"-1"