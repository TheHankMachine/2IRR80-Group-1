bc5c09f1e\" />\n\n### Steps to reproduce\n\n- Create a new project and create a new 3D Scene\n- create an AnimationPlayer node\n- Click on \"Animation\" and create some new animation\n- Open the animation list popover (no search visible)\n\n### Minimal reproduction project (MRP)\n\nShould be very quick to reproduce with the steps above","closed_by":{"login":"JulienKaspar","id":118280607,"node_id":"U_kgDOBwzRnw","avatar_url":"https://avatars.githubusercontent.com/u/118280607?v=4","gravatar_id":"","url":"https://api.github.com/users/JulienKaspar","html_url":"https://github.com/JulienKaspar","followers_url":"https://api.github.com/users/JulienKaspar/followers","following_url":"https://api.github.com/users/JulienKaspar/following{/other_user}","gists_url":"https://api.github.com/users/JulienKaspar/gists{/gist_id}","starred_url":"https://api.github.com/users/JulienKaspar/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/JulienKaspar/subscriptions","organizations_url":"https://api.github.com/users/JulienKaspar/orgs","repos_url":"https://api.github.com/users/JulienKaspar/repos","events_url":"https://api.github.com/users/JulienKaspar/events{/privacy}","received_events_url":"https://api.github.com/users/JulienKaspar/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/122805/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/godotengine/godot/issues/122805/timeline","performed_via_github_app":null,"state_reason":"completed","pinned_comment":null}