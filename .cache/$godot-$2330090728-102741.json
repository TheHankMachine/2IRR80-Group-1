e_repos":0,"url":"https://api.github.com/users/KerekesDavid"},"body":"","html_url":"https://github.com/godotengine/godot/pull/102741#pullrequestreview-2620572002","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/102741","author_association":"CONTRIBUTOR","submitted_at":"2025-02-17T09:59:36Z"},{"id":2621043356,"node_id":"PRR_kwDOAO6SJc6cOfKc","state":"COMMENTED","user":{"site_admin":false,"suspended":false,"updated_at":"0001-01-01T00:00:00Z","avatar_url":"https://avatars.githubusercontent.com/u/7255919?u=41b29e7196ed835e783ed111bafe20d8c89d4799&v=4","created_at":"0001-01-01T00:00:00Z","followers":0,"following":0,"html_url":"https://github.com/OhiraKyou","id":7255919,"node_id":"MDQ6VXNlcjcyNTU5MTk=","login":"OhiraKyou","type":"User","owned_private_repos":0,"public_gists":0,"public_repos":0,"total_private_repos":0,"url":"https://api.github.com/users/OhiraKyou"},"body":"","html_url":"https://github.com/godotengine/godot/pull/102741#pullrequestreview-2621043356","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/102741","author_association":"CONTRIBUTOR","submitted_at":"2025-02-17T13:14:36Z"},{"id":2623037945,"node_id":"PRR_kwDOAO6SJc6cWGH5","state":"COMMENTED","user":{"site_admin":false,"suspended":false,"updated_at":"0001-01-01T00:00:00Z","avatar_url":"https://avatars.githubusercontent.com/u/9087461?v=4","created_at":"0001-01-01T00:00:00Z","followers":0,"following":0,"html_url":"https://github.com/KerekesDavid","id":9087461,"node_id":"MDQ6VXNlcjkwODc0NjE=","login":"KerekesDavid","type":"User","owned_private_repos":0,"public_gists":0,"public_repos":0,"total_private_repos":0,"url":"https://api.github.com/users/KerekesDavid"},"body":"","html_url":"https://github.com/godotengine/godot/pull/102741#pullrequestreview-2623037945","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/102741","author_association":"CONTRIBUTOR","submitted_at":"2025-02-18T10:06:43Z"},{"id":2626701241,"node_id":"PRR_kwDOAO6SJc6ckEe5","state":"CHANGES_REQUESTED","user":{"site_admin":false,"suspended":false,"updated_at":"0001-01-01T00:00:00Z","avatar_url":"https://avatars.githubusercontent.com/u/7255919?u=41b29e7196ed835e783ed111bafe20d8c89d4799&v=4","created_at":"0001-01-01T00:00:00Z","followers":0,"following":0,"html_url":"https://github.com/OhiraKyou","id":7255919,"node_id":"MDQ6VXNlcjcyNTU5MTk=","login":"OhiraKyou","type":"User","owned_private_repos":0,"public_gists":0,"public_repos":0,"total_private_repos":0,"url":"https://api.github.com/users/OhiraKyou"},"body":"I set up a dev environment and tested the changes locally. I found that only two of the changes (plus a function signature header update) needed to be included to fix the MRP. So, my reversion suggestions are based on the assumption that this would be merged as a fix for the jitter, with any additional work being pushed to an optional future PR.\r\n\r\nMinimum necessary changes:\r\n\r\n- In `Window::_update_viewport_size`, `final_size_override` must be a `Size2`\r\n\t- This is because it is divided by the `content_scale_factor` on lines [1155](https://github.com/godotengine/godot/blob/6e4610640ec42271a87a27baeef7625cd3d3ad25/scene/main/window.cpp#L1155) and [1236](https://github.com/godotengine/godot/blob/6e4610640ec42271a87a27baeef7625cd3d3ad25/scene/main/window.cpp#L1236), resulting in float values that need to be preserved.\r\n- In `Viewport::_set_size`, `p_size_2d_override` must be a `Size2` (with the redundant `Size2` conversion removed).\r\n\t- This is because `Window` passes in `final_size_override` on [line 1257](https://github.com/godotengine/godot/blob/6e4610640ec42271a87a27baeef7625cd3d3ad25/scene/main/window.cpp#L1257).\r\n\r\nIn other words, the math on `Window`'s `final_size_override` is what results in float values. Everywhere else, 2D size overrides are only given integer values. So, changing them to floats doesn't do anything without additional work.\r\n\r\nEdit: Actually, as discussed later, because `p_size_2d_override` is saved to the `Viewport`'s `size_2d_override` in `Viewport::_set_size`, the value will be out of sync with the calculated `stretch_transform` if `size_2d_override` is not also a `Size2`.","html_url":"https://github.com/godotengine/godot/pull/102741#pullrequestreview-2626701241","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/102741","author_association":"CONTRIBUTOR","submitted_at":"2025-02-19T13:37:59Z"},{"id":2632612694,"node_id":"PRR_kwDOAO6SJc6c6ntW","state":"COMMENTED","user":{"site_admin":false,"suspended":false,"updated_at":"0001-01-01T00:00:00Z","avatar_url":"https://avatars.githubusercontent.com/u/9087461?v=4","created_at":"0001-01-01T00:00:00Z","followers":0,"following":0,"html_url":"https://github.com/KerekesDavid","id":9087461,"node_id":"MDQ6VXNlcjkwODc0NjE=","login":"KerekesDavid","type":"User","owned_private_repos":0,"public_gists":0,"public_repos":0,"total_private_repos":0,"url":"https://api.github.com/users/KerekesDavid"},"body":"","html_url":"https://github.com/godotengine/godot/pull/102741#pullrequestreview-2632612694","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/102741","author_association":"CONTRIBUTOR","submitted_at":"2025-02-21T10:18:09Z"},{"id":2632613569,"node_id":"PRR_kwDOAO6SJc6c6n7B","state":"COMMENTED","user":{"site_admin":false,"suspended":false,"updated_at":"0001-01-01T00:00:00Z","avatar_url":"https://avatars.githubusercontent.com/u/9087461?v=4","created_at":"0001-01-01T00:00:00Z","followers":0,"following":0,"html_url":"https://github.com/KerekesDavid","id":9087461,"node_id":"MDQ6VXNlcjkwODc0NjE=","login":"KerekesDavid","type":"User","owned_private_repos":0,"public_gists":0,"public_repos":0,"total_private_repos":0,"url":"https://api.github.com/users/KerekesDavid"},"body":"","html_url":"https://github.com/godotengine/godot/pull/102741#pullrequestreview-2632613569","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/102741","author_association":"CONTRIBUTOR",