[{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4289988301","html_url":"https://github.com/godotengine/godot/issues/117338#issuecomment-4289988301","issue_url":"https://api.github.com/repos/godotengine/godot/issues/117338","id":4289988301,"node_id":"IC_kwDOAO6SJc7_tAbN","user":{"login":"bruvzg","id":7645683,"node_id":"MDQ6VXNlcjc2NDU2ODM=","avatar_url":"https://avatars.githubusercontent.com/u/7645683?v=4","gravatar_id":"","url":"https://api.github.com/users/bruvzg","html_url":"https://github.com/bruvzg","followers_url":"https://api.github.com/users/bruvzg/followers","following_url":"https://api.github.com/users/bruvzg/following{/other_user}","gists_url":"https://api.github.com/users/bruvzg/gists{/gist_id}","starred_url":"https://api.github.com/users/bruvzg/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/bruvzg/subscriptions","organizations_url":"https://api.github.com/users/bruvzg/orgs","repos_url":"https://api.github.com/users/bruvzg/repos","events_url":"https://api.github.com/users/bruvzg/events{/privacy}","received_events_url":"https://api.github.com/users/bruvzg/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-04-21T15:58:35Z","updated_at":"2026-04-21T15:58:35Z","body":"> A warning explaining this appears on Labels with outlines and the 8 pixel font size: MSDF font pixel range is too small, some outlines/shadows will not render. Set MSDF pixel range to be at least 32 to render all outlines/shadows. (32 pixels is way too large for my project, so isn't an option.)\n\nThis is MSDF source size (in the import options), not the font size. You can use it with any font size.","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4289988301/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4290040987","html_url":"https://github.com/godotengine/godot/issues/117338#issuecomment-4290040987","issue_url":"https://api.github.com/repos/godotengine/godot/issues/117338","id":4290040987,"node_id":"IC_kwDOAO6SJc7_tNSb","user":{"login":"bruvzg","id":7645683,"node_id":"MDQ6VXNlcjc2NDU2ODM=","avatar_url":"https://avatars.githubusercontent.com/u/7645683?v=4","gravatar_id":"","url":"https://api.github.com/users/bruvzg","html_url":"https://github.com/bruvzg","followers_url":"https://api.github.com/users/bruvzg/followers","following_url":"https://api.github.com/users/bruvzg/following{/other_user}","gists_url":"https://api.github.com/users/bruvzg/gists{/gist_id}","starred_url":"https://api.github.com/users/bruvzg/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/bruvzg/subscriptions","organizations_url":"https://api.github.com/users/bruvzg/orgs","repos_url":"https://api.github.com/users/bruvzg/repos","events_url":"https://api.github.com/users/bruvzg/events{/privacy}","received_events_url":"https://api.github.com/users/bruvzg/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-04-21T16:07:00Z","updated_at":"2026-04-21T16:07:00Z","body":"> In v4.4.1, the way I found to remedy this was to set the GUI > Theme > Default Font Subpixel Positioning setting to Disabled. \n\nThis is exactly the opposite, you should always enable subpixel positioning for small font sizes to improve spacing. Unless it is pixel font, in this case the only solution is setting for size to the specific size this font is designed for.","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4290040987/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issu