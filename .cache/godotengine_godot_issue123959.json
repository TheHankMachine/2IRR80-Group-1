ed_by":null}],"state":"closed","locked":false,"assignees":[],"milestone":{"url":"https://api.github.com/repos/godotengine/godot/milestones/25","html_url":"https://github.com/godotengine/godot/milestone/25","labels_url":"https://api.github.com/repos/godotengine/godot/milestones/25/labels","id":15520464,"node_id":"MI_kwDOAO6SJc4A7NLQ","number":25,"title":"4.8","description":"","creator":{"login":"Repiteo","id":17489292,"node_id":"MDQ6VXNlcjE3NDg5Mjky","avatar_url":"https://avatars.githubusercontent.com/u/17489292?v=4","gravatar_id":"","url":"https://api.github.com/users/Repiteo","html_url":"https://github.com/Repiteo","followers_url":"https://api.github.com/users/Repiteo/followers","following_url":"https://api.github.com/users/Repiteo/following{/other_user}","gists_url":"https://api.github.com/users/Repiteo/gists{/gist_id}","starred_url":"https://api.github.com/users/Repiteo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Repiteo/subscriptions","organizations_url":"https://api.github.com/users/Repiteo/orgs","repos_url":"https://api.github.com/users/Repiteo/repos","events_url":"https://api.github.com/users/Repiteo/events{/privacy}","received_events_url":"https://api.github.com/users/Repiteo/received_events","type":"User","user_view_type":"public","site_admin":false},"open_issues":345,"closed_issues":2336,"state":"open","created_at":"2026-04-13T15:59:35Z","updated_at":"2026-10-22T08:21:32Z","due_on":null,"closed_at":null},"comments":3,"created_at":"2026-09-29T12:11:57Z","updated_at":"2026-10-21T17:28:27Z","closed_at":"2026-10-21T17:28:24Z","assignee":null,"author_association":"NONE","issue_field_values":[],"type":null,"active_lock_reason":null,"draft":false,"pull_request":{"url":"https://api.github.com/repos/godotengine/godot/pulls/123959","html_url":"https://github.com/godotengine/godot/pull/123959","diff_url":"https://github.com/godotengine/godot/pull/123959.diff","patch_url":"https://github.com/godotengine/godot/pull/123959.patch","merged_at":"2026-10-21T17:28:24Z"},"body":"<!--\r\nPlease target the `master` branch. We will take care of backporting relevant fixes to older versions.\r\n\r\nBefore submitting, please read our checklist for contributors:\r\nhttps://contributing.godotengine.org/en/latest/development/engine/introduction.html#checklist-for-new-contributors\r\n\r\nUse of AI must be disclosed and should include a description of how it was used.\r\n-->\r\n\r\n## What problem(s) does this PR solve?\r\n\r\n- Closes #108934\r\n- Closes #91404\r\n\r\nWhen adding a curve to the Angle setting in a `ParticleProcessMaterial`, the default range was initialized to `-360` to `360`. Since the curve acts as a multiplier, this range caused particles to spin uncontrollably. This PR changes the default curve range for `PARAM_ANGLE` to `-1.0` to `1.0` so it functions correctly as a normalized multiplier.\r\n\r\n## Additional information\r\n\r\nThis is a strictly scoped fix designed to resolve the reopened Angle curve issue without triggering previous regressions. \r\n\r\nA previous attempt to fix this (PR #91556) changed the default ranges for multiple particle multipliers at once, which inadvertently broke 3D directional velocity curves (Issue #115511) and had to be reverted (PR #116140). To prevent that from happening again, this PR *only* modifies the switch cases for `PARAM_ANGLE` in `cpu_particles_2d.cpp`, `cpu_particles_3d.cpp`, and `particle_process_material.cpp`. All other parameters remain untouched.\r\n\r\n*(AI Disclosure: I used an AI assistant as a learning tool to help navigate the Godot C++ codebase and research the Git history of the previously reverted PR. All code changes were manually applied, compiled, and tested.)*","closed_by":{"login":"Repiteo","id":17489292,"node_id":"MDQ6VXNlcjE3NDg5Mjky","avatar_url":"https://avatars.githubusercontent.com/u/17489292?v=4","gravatar_id":"","url":"https://api.github.com/users/Repiteo","html_url":"https://github.com/Repiteo","followers_url":"https://api.github.com/users/Repiteo/followers","following_url":"https://api.github.com/users/Repiteo/following{/other_user}","gists_url":"https://api.github.com/users/Repiteo/gists{/gist_id}","starred_url":"https://api.github.com/users/Repiteo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Repiteo/subscriptions","organizations_url":"https://api.github.com/users/Repiteo/orgs","repos_url":"https://api.github.com/users/Repiteo/repos","events_url":"https://api.github.com/users/Repiteo/events{/privacy}","received_events_url":"https://api.github.com/users/Repiteo/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/123959/reactions","total_count":3,"+1":2,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":1},"timeline_url":"https://api.github.com/repos/godotengine/godot/issues/123959/timeline","performed_via_github_app":null,"state_reason":null}