ub.com/users/akien-mga/following{/other_user}","gists_url":"https://api.github.com/users/akien-mga/gists{/gist_id}","starred_url":"https://api.github.com/users/akien-mga/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/akien-mga/subscriptions","organizations_url":"https://api.github.com/users/akien-mga/orgs","repos_url":"https://api.github.com/users/akien-mga/repos","events_url":"https://api.github.com/users/akien-mga/events{/privacy}","received_events_url":"https://api.github.com/users/akien-mga/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-02-17T09:19:26Z","updated_at":"2025-02-17T09:19:26Z","body":"Do you envision using the editor with the expanded bottom panel and not game window visible anywhere, or were you just surprised to see the misplaced overlay?\n\n#102921 seems to implement support for the former use case but I'm not sure in which scenario one would want to start playing the game without being able to interact with it (aside from maybe profiling the first frames in auto-play).","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2662506618/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2662772777","html_url":"https://github.com/godotengine/godot/issues/102901#issuecomment-2662772777","issue_url":"https://api.github.com/repos/godotengine/godot/issues/102901","id":2662772777,"node_id":"IC_kwDOAO6SJc6etrAp","user":{"login":"giokhmaladze","id":7861548,"node_id":"MDQ6VXNlcjc4NjE1NDg=","avatar_url":"https://avatars.githubusercontent.com/u/7861548?v=4","gravatar_id":"","url":"https://api.github.com/users/giokhmaladze","html_url":"https://github.com/giokhmaladze","followers_url":"https://api.github.com/users/giokhmaladze/followers","following_url":"https://api.github.com/users/giokhmaladze/following{/other_user}","gists_url":"https://api.github.com/users/giokhmaladze/gists{/gist_id}","starred_url":"https://api.github.com/users/giokhmaladze/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/giokhmaladze/subscriptions","organizations_url":"https://api.github.com/users/giokhmaladze/orgs","repos_url":"https://api.github.com/users/giokhmaladze/repos","events_url":"https://api.github.com/users/giokhmaladze/events{/privacy}","received_events_url":"https://api.github.com/users/giokhmaladze/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-02-17T11:04:14Z","updated_at":"2025-02-17T11:04:14Z","body":"@akien-mga misplaced overlay was also a factor but, I think I encountered this problem when I was trying to debug scene \"setup\" code (in `_ready` function)\n\nNot all scenes are visual components right? it might be some system, saving on file, fetching data from network, checking game state, playing audio... when you run/debug those kind of scenes you wouldn't need scene view at all? **but I'm pretty new to godot so I might be missing/not understanding something.**\n\nSo my answer would be: I can rarely imagine scenario where I would start playing game without wanting to interact with it, but I can imagine running individual scenes that doesn't include visual/interactive nodes, during development/debugging, with hidden scene view so I maximize debugging screen space.","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2662772777/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2663203364","html_url":"https://github.com/godotengine/godot/issues/102901#issuecomment-2663203364","issue_url":"https://api.g