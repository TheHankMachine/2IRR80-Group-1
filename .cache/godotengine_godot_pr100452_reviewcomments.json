y":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":53,"start_side":"RIGHT","line":null,"original_line":57,"side":"RIGHT","in_reply_to_id":1924726613,"author_association":"CONTRIBUTOR","original_position":17,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/1994686799","pull_request_review_id":2684073889,"id":1994686799,"node_id":"PRRC_kwDOAO6SJc525IFP","diff_hunk":"@@ -48,6 +50,11 @@ public sealed class NodePath : IDisposable, IEquatable<NodePath?>\n \n         private WeakReference<IDisposable>? _weakReferenceToSelf;\n \n+        private static readonly ICache<string, NodePath> _nodePathCache = new ConcurrentLruBuilder<string, NodePath>()\n+            .WithCapacity(1_000)\n+            .WithExpireAfterAccess(TimeSpan.FromSeconds(30))\n+            .Build();\n+","path":"modules/mono/glue/GodotSharp/GodotSharp/Core/NodePath.cs","commit_id":"7dcaac44e4f5e24fd61819965ca76138bce2f70e","original_commit_id":"635cbab51b83f919811d2585fa60811db3f07d24","user":{"login":"Joy-less","id":65855333,"node_id":"MDQ6VXNlcjY1ODU1MzMz","avatar_url":"https://avatars.githubusercontent.com/u/65855333?v=4","gravatar_id":"","url":"https://api.github.com/users/Joy-less","html_url":"https://github.com/Joy-less","followers_url":"https://api.github.com/users/Joy-less/followers","following_url":"https://api.github.com/users/Joy-less/following{/other_user}","gists_url":"https://api.github.com/users/Joy-less/gists{/gist_id}","starred_url":"https://api.github.com/users/Joy-less/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Joy-less/subscriptions","organizations_url":"https://api.github.com/users/Joy-less/orgs","repos_url":"https://api.github.com/users/Joy-less/repos","events_url":"https://api.github.com/users/Joy-less/events{/privacy}","received_events_url":"https://api.github.com/users/Joy-less/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"`WeakReference` can't work as-is because it only applies to a single reference. You would have to use a `ConditionalWeakTable` or a collection. `ConditionalWeakTable`s don't really work with `string` keys. There are some interesting approaches with collections though:\n- Create a fixed-size cache of `StringName` `WeakReference`s (e.g. `WeakReference<StringName>[1000]`) and do a linear search to find a matching `StringName`. This would be extremely slow.\n- Use a `ConcurrentDictionary<string, WeakReference<StringName>` and clear the reference in the finalizer of `StringName`. I think this could work but there might be some issues with garbage collection.","created_at":"2025-03-14T04:10:53Z","updated_at":"2025-03-14T04:10:53Z","html_url":"https://github.com/godotengine/godot/pull/100452#discussion_r1994686799","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/100452","_links":{"self":{"href":"https://api.github.com/repos/godotengine/godot/pulls/comments/1994686799"},"html":{"href":"https://github.com/godotengine/godot/pull/100452#discussion_r1994686799"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/100452"}},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/1994686799/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":53,"start_side":"RIGHT","line":null,"original_line":57,"side":"RIGHT","in_reply_to_id":1924726613,"author_association":"CONTRIBUTOR","original_position":17,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/1994693133","pull_request_review_id":2684090378,"id":1994693133,"node_id":"PRRC_kwDOAO6SJc525JoN","diff_hunk":"@@ -48,6 +50,11 @@ public sealed class NodePath : IDisposable, IEquatable<NodePath?>\n \n         private WeakReference<IDisposable>? _weakReferenceToSelf;\n \n+        private static readonly ICache<string, NodePath> _nodePathCache = new ConcurrentLruBuilder<string, NodePath>()\n+            .WithCapacity(1_000)\n+            .WithExpireAfterAccess(TimeSpan.FromSeconds(30))\n+            .Build();\n+","path":"modules/mono/glue/GodotSharp/GodotSharp/Core/NodePath.cs","commit_id":"7dcaac44e4f5e24fd61819965ca76138bce2f70e","original_commit_id":"635cbab51b83f919811d2585fa60811db3f07d24","user":{"login":"Joy-less","id":65855333,"node_id":"MDQ6VXNlcjY1ODU1MzMz","avatar_url":"https://avatars.githubusercontent.com/u/65855333?v=4","gravatar_id":"","url":"https://api.github.com/users/Joy-less","html_url":"https://github.com/Joy-less","followers_url":"https://api.github.com/users/Joy-less/followers","following_url":"https://api.github.com/users/Joy-less/following{/other_user}","gists_url":"https://api.github.com/users/Joy-less/gists{/gist_id}","starred_url":"https://api.github.com/users/Joy-less/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Joy-less/subscriptions","organizations_url":"https://api.github.com/users/Joy-less/orgs","repos_url":"https://api.github.com/users/Joy-less/repos","events_url":"https://api.github.com/users/Joy-less/events{/privacy}","received_events_url":"https://api.github.com/users/Joy-less/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"Something like this maybe:\n\n```cs\nprivate static readonly ConcurrentDictionary<string, WeakReference<StringName>> StringNames = [];\n\npublic static implicit operator StringName(string From) {\n    return StringNames.GetOrAdd(From, From => new WeakReference<StringName>(new StringName(From)));\n}\n\n~StringName() {\n    StringNames.TryRemove(ToString(), out _);\n}\n```\n\nI am sceptical that this would provide good performance though. Creating `WeakReference`s is probably expensive compared to the approach with `BitFaster.Caching`, which by the way is an extremely micro-optimised library using vectorisation and unsafe code.","created_at":"2025-03-14T04:17:15Z","updated_at":"2025-03-14T04:17:37Z","html_url":"https://github.com/godotengine/godot/pull/100452#discussion_r1994693133","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/100452","_links":{"self":{"href":"https://api.github.com/repos/godotengine/godot/pulls/comments/1994693133"},"html":{"href":"https://github.com/godotengine/godot/pull/100452#discussion_r1994693133"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/100452"}},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/1994693133/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":53,"start_side":"RIGHT","line":null,"original_line":57,"side":"RIGHT","in_reply_to_id":1924726613,"author_association":"CONTRIBUTOR","original_position":17,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/1996571227","pull_request_review_id":2687335404,"id":1996571227,"node_id":"PRRC_kwDOAO6SJc53AUJb","diff_hunk":"@@ -48,6 +50,11 @@ public sealed class NodePath : IDisposable, IEquatable<NodePath?>\n \n         private WeakReference<IDisposable>? _weakReferenceToSelf;\n \n+        private static readonly ICache<string, NodePath> _nodePathCache = new ConcurrentLruBuilder<string, NodePath>()\n+            .WithCapacity(1_000)\n+            .WithExpireAfterAccess(TimeSpan.FromSeconds(30))\n+            .Build();\n+","path":"modules/mono/glue/GodotSharp/GodotSharp/Core/NodePath.cs","commit_id":"7dcaac44e4f5e24fd61819965ca76138bce2f70e","original_commit_id":"635cbab51b83f919811d2585fa60811db3f07d24","user":{"login":"Joy-less","id":65855333,"node_id":"MDQ6VXNlcjY1ODU1MzMz","avatar_url":"https://avatars.githubusercontent.com/u/65855333?v=4","gravatar_id":"","url":"https://api.github.com/users/Joy-less","html_url":"https://github.com/Joy-less","followers_url":"https://api.github.com/users/Joy-less/followers","