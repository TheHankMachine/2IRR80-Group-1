4:49Z","html_url":"https://github.com/godotengine/godot/pull/100452#discussion_r1924726613","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/100452","_links":{"self":{"href":"https://api.github.com/repos/godotengine/godot/pulls/comments/1924726613"},"html":{"href":"https://github.com/godotengine/godot/pull/100452#discussion_r1924726613"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/100452"}},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/1924726613/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":53,"start_side":"RIGHT","line":null,"original_line":57,"side":"RIGHT","author_association":"CONTRIBUTOR","original_position":17,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/1925507543","pull_request_review_id":2567523115,"id":1925507543,"node_id":"PRRC_kwDOAO6SJc5yxOnX","diff_hunk":"@@ -48,6 +50,11 @@ public sealed class NodePath : IDisposable, IEquatable<NodePath?>\n \n         private WeakReference<IDisposable>? _weakReferenceToSelf;\n \n+        private static readonly ICache<string, NodePath> _nodePathCache = new ConcurrentLruBuilder<string, NodePath>()\n+            .WithCapacity(1_000)\n+            .WithExpireAfterAccess(TimeSpan.FromSeconds(30))\n+            .Build();\n+","path":"modules/mono/glue/GodotSharp/GodotSharp/Core/NodePath.cs","commit_id":"7dcaac44e4f5e24fd61819965ca76138bce2f70e","original_commit_id":"635cbab51b83f919811d2585fa60811db3f07d24","user":{"login":"Joy-less","id":65855333,"node_id":"MDQ6VXNlcjY1ODU1MzMz","avatar_url":"https://avatars.githubusercontent.com/u/65855333?v=4","gravatar_id":"","url":"https://api.github.com/users/Joy-less","html_url":"https://github.com/Joy-less","followers_url":"https://api.github.com/users/Joy-less/followers","following_url":"https://api.github.com/users/Joy-less/following{/other_user}","gists_url":"https://api.github.com/users/Joy-less/gists{/gist_id}","starred_url":"https://api.github.com/users/Joy-less/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Joy-less/subscriptions","organizations_url":"https://api.github.com/users/Joy-less/orgs","repos_url":"https://api.github.com/users/Joy-less/repos","events_url":"https://api.github.com/users/Joy-less/events{/privacy}","received_events_url":"https://api.github.com/users/Joy-less/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"It could definitely be public and configurable but I thought it might be overkill. StringNames don't add much in C# so the ideal choice would be to axe them altogether in the long term.\n\nAs for using ConcurrentDictionary, that doesn't have eviction so it would cause memory leaks if StringNames were created dynamically (e.g. `StringName number = (\"num\" + i);`).","created_at":"2025-01-22T15:19:40Z","updated_at":"2025-01-22T15:19:40Z","html_url":"https://github.com/godotengine/godot/pull/100452#discussion_r1925507543","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/100452","_links":{"self":{"href":"https://api.github.com/repos/godotengine/godot/pulls/comments/1925507543"},"html":{"href":"https://github.com/godotengine/godot/pull/100452#discussion_r1925507543"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/100452"}},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/1925507543/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":53,"start_side":"RIGHT","line":null,"original_line":57,"side":"RIGHT","in_reply_to_id":1924726613,"author_association":"CONTRIBUTOR","original_position":17,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/1975186808","pull_request_review_id":265