ub.com/users/Nintorch/following{/other_user}","gists_url":"https://api.github.com/users/Nintorch/gists{/gist_id}","starred_url":"https://api.github.com/users/Nintorch/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Nintorch/subscriptions","organizations_url":"https://api.github.com/users/Nintorch/orgs","repos_url":"https://api.github.com/users/Nintorch/repos","events_url":"https://api.github.com/users/Nintorch/events{/privacy}","received_events_url":"https://api.github.com/users/Nintorch/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-05-09T07:07:51Z","updated_at":"2026-05-09T07:07:51Z","body":"Sorry, we aren't accepting AI-generated PRs right now. Also please note, your failure to disclose that this was vibe-coded is against our AI contribution policy: https://contributing.godotengine.org/en/latest/pull_requests/pull_request_guidelines.html#ai-assisted-contributions","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4411816758/reactions","total_count":3,"+1":3,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4412662041","html_url":"https://github.com/godotengine/godot/pull/119353#issuecomment-4412662041","issue_url":"https://api.github.com/repos/godotengine/godot/issues/119353","id":4412662041,"node_id":"IC_kwDOAO6SJc8AAAABBwPhGQ","user":{"login":"BogdanZawr","id":37742044,"node_id":"MDQ6VXNlcjM3NzQyMDQ0","avatar_url":"https://avatars.githubusercontent.com/u/37742044?v=4","gravatar_id":"","url":"https://api.github.com/users/BogdanZawr","html_url":"https://github.com/BogdanZawr","followers_url":"https://api.github.com/users/BogdanZawr/followers","following_url":"https://api.github.com/users/BogdanZawr/following{/other_user}","gists_url":"https://api.github.com/users/BogdanZawr/gists{/gist_i