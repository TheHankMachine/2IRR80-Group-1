[{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2645740797","html_url":"https://github.com/godotengine/godot/pull/102435#issuecomment-2645740797","issue_url":"https://api.github.com/repos/godotengine/godot/issues/102435","id":2645740797,"node_id":"IC_kwDOAO6SJc6dssz9","user":{"login":"allenwp","id":17506573,"node_id":"MDQ6VXNlcjE3NTA2NTcz","avatar_url":"https://avatars.githubusercontent.com/u/17506573?v=4","gravatar_id":"","url":"https://api.github.com/users/allenwp","html_url":"https://github.com/allenwp","followers_url":"https://api.github.com/users/allenwp/followers","following_url":"https://api.github.com/users/allenwp/following{/other_user}","gists_url":"https://api.github.com/users/allenwp/gists{/gist_id}","starred_url":"https://api.github.com/users/allenwp/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/allenwp/subscriptions","organizations_url":"https://api.github.com/users/allenwp/orgs","repos_url":"https://api.github.com/users/allenwp/repos","events_url":"https://api.github.com/users/allenwp/events{/privacy}","received_events_url":"https://api.github.com/users/allenwp/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-02-08T14:32:27Z","updated_at":"2025-02-08T14:32:27Z","body":"Previously I had not updated the `tonemap_exposure` docs. I just pushed a change to improve the docs for this member.","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2645740797/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2665939967","html_url":"https://github.com/godotengine/godot/pull/102435#issuecomment-2665939967","issue_url":"https://api.github.com/repos/godotengine/godot/issues/102435","id":2665939967,"node_id":"IC_kwDOAO6SJc6e5wP_","user":{"login":"allenwp","id":17506573,"node_id":"MDQ6VXNlcjE3NTA2NTcz","avatar_url":"https://avatars.githubusercontent.com/u/17506573?v=4","gravatar_id":"","url":"https://api.github.com/users/allenwp","html_url":"https://github.com/allenwp","followers_url":"https://api.github.com/users/allenwp/followers","following_url":"https://api.github.com/users/allenwp/following{/other_user}","gists_url":"https://api.github.com/users/allenwp/gists{/gist_id}","starred_url":"https://api.github.com/users/allenwp/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/allenwp/subscriptions","organizations_url":"https://api.github.com/users/allenwp/orgs","repos_url":"https://api.github.com/users/allenwp/repos","events_url":"https://api.github.com/users/allenwp/events{/privacy}","received_events_url":"https://api.github.com/users/allenwp/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-02-18T14:50:25Z","updated_at":"2025-02-18T14:50:25Z","body":"I've updated this PR to remove the docs changes, as those were merged separately in #102820.","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2665939967/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2675486475","html_url":"https://github.com/godotengine/godot/pull/102435#issuecomment-2675486475","issue_url":"https://api.github.com/repos/godotengine/godot/issues/102435","id":2675486475,"node_id":"IC_kwDOAO6SJc6feK8L","user":{"login":"allenwp","id":17506573,"node_id":"MDQ6VXNlcjE3NTA2NTcz","avatar_url":"https://avatars.githubusercontent.com/u/17506573?v=4","gravatar_id":"","url":"https://api.github.com/users/allenwp","html_url":"https://github.com/allenwp","followers_url":"https://api.github.com/users/allenwp/followers","following_url":"https://api.github.com/users/allenwp/following{/other_user}","gists_url":"https://api.github.com/users/allenwp/gists{/gist_id}","starred_url":"https://api.github.com/users/allenwp/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/allenwp/subscriptions","organizations_url":"https://api.github.com/users/allenwp/orgs","repos_url":"https://api.github.com/users/allenwp/repos","events_url":"https://api.github.com/users/allenwp/events{/privacy}","received_events_url":"https://api.github.com/users/allenwp/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-02-21T20:32:39Z","updated_at":"2025-02-21T20:32:39Z","body":"After around 2 months of R&D, I've got AgX into a good state where it is both high performance and high quality, matching the reference curve much closer than before. This is now ready to merge with addition of white parameter in a future PR.","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2675486475/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2679391384","html_url":"https://github.com/godotengine/godot/pull/102435#issuecomment-2679391384","issue_url":"https://api.github.com/repos/godotengine/godot/issues/102435","id":2679391384,"node_id":"IC_kwDOAO6SJc6ftESY","user":{"login":"allenwp","id":17506573,"node_id":"MDQ6VXNlcjE3NTA2NTcz","avatar_url":"https://avatars.githubusercontent.com/u/17506573?v=4","gravatar_id":"","url":"https://api.github.com/users/allenwp","html_url":"https://github.com/allenwp","followers_url":"https://api.github.com/users/allenwp/followers","following_url":"https://api.github.com/users/allenwp/following{/other_user}","gists_url":"https://api.github.com/users/allenwp/gists{/gist_id}","starred_url":"https://api.github.com/users/allenwp/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/allenwp/subscriptions","organizations_url":"https://api.github.com/users/allenwp/orgs","repos_url":"https://api.github.com/users/allenwp/repos","events_url":"https://api.github.com/users/allenwp/events{/privacy}","received_events_url":"https://api.github.com/users/allenwp/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-02-24T19:01:30Z","updated_at":"2025-02-24T19:01:30Z","body":"Stephen Hill, author of the ACES tonemapping curve approximation that Godot uses, took the time to review this as well and suggested a clever optimization:\r\n\r\n```\r\ncolor = log2(color);\r\ncolor = exp2(color * a) / (exp2(color * d') * b + c);\r\n```\r\n\r\nWhere `d' = a * d`. \r\n\r\nStephen explained that `pow(x, e)` is typically implemented natively as `exp2(log2(x) * e)`, which matches what I've seen [elsewhere](https://shaderlabs.org/wiki/Shader_Optimization). This means that a `log2()` operation can be saved.\r\n\r\nThe full breakdown starts by replacing `pow(x, e)` with `exp2(log2(x) * e)`:\r\n```\r\nx = exp2(log2(x) * a) / (exp2(log2(exp2(log2(x) * a)) * d) * b + c);\r\n```\r\n\r\n...is equivalent to:\r\n```\r\nx = log2(x);\r\nx = exp2(x * a) / (exp2(log2(exp2(x * a)) * d) * b + c);\r\n```\r\n`log2(exp2(` cancel out, so this is equivalent to:\r\n```\r\nx = log2(x);\r\nx = exp2(x * a) / (exp2(x * a * d) * b + c);\r\n```\r\n\r\nIn my test, I found this improved performance of the tonemapper **from 0.26 ms to 0.23 ms**.  I've updated the PR to include this optimization.","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2679391384/reactions","total_count":7,"+1":2,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":1,"rocket":4,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2708306682","html_url":"https://github.com/godotengine/godot/pull/102435#issuecomment-2708306682","issue_url":"https://api.github.com/repos/godotengine/godot/issues/102435","id":2708306682,"node_id":"IC_kwDOAO6SJc6hbXr6","user":{"login":"allenwp","id":17506573,"node_id":"MDQ6VXNlcjE3NTA2NTcz","avatar_url":"https://avatars.githubusercontent.com/u/17506573?v=4","gravatar_id":"","url":"https://api.github.com/users/allenwp","html_url":"https://github.com/allenwp","followers_url":"https://api.github.com/users/allenwp/followers","following_url":"https://api.github.com/users/allenwp/following{/other_user}","gists_url":"https://api.github.com/users/allenwp/gists{/gist_id}","starred_url":"https://api.github.com/users/allenwp/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/allenwp/subscriptions","organizations_url":"https://api.github.com/users/allenwp/orgs","repos_url":"https://api.github.com/users/allenwp/repos","events_url":"https://api.github.com/users/allenwp/events{/privacy}","received_events_url":"https://api.github.com/users/allenwp/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-03-08T14:19:57Z","updated_at":"2025-03-08T14:19:57Z","body":"I’m temporarily putting this PR back in a draft state, as I’ve discovered a [piecewise polynomial equation](https://d3cw3dd2w32x2b.cloudfront.net/wp-content/uploads/2012/09/an-efficient-and-user-friendly-tone-mapping-operator.pdf) that may be better for approximating AgX in terms of performance, future `white` parameter, and a future HDR adaptation. It should only take me a week or two (excluding GDC) to try out it out and see if it’s a better fit.","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2708306682/reactions","total_count":4,"+1":4,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2776689771","html_url":"https://github.com/godotengine/godot/pull/102435#issuecomment-2776689771","issue_url":"https://api.github.com/repos/godotengine/godot/issues/102435","id":2776689771,"node_id":"IC_kwDOAO6SJc6lgOxr","user":{"login":"allenwp","id":17506573,"node_id":"MDQ6VXNlcjE3NTA2NTcz","avatar_url":"https://avatars.githubusercontent.com/u/17506573?v=4","gravatar_id":"","url":"https://api.github.com/users/allenwp","html_url":"https://github.com/allenwp","followers_url":"https://api.github.com/users/allenwp/followers","following_url":"https://api.github.com/users/allenwp/following{/other_user}","gists_url":"https://api.github.com/users/allenwp/gists{/gist_id}","starred_url":"https://api.github.com/users/allenwp/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/allenwp/subscriptions","organizations_url":"https://api.github.com/users/allenwp/orgs","repos_url":"https://api.github.com/users/allenwp/repos","events_url":"https://api.github.com/users/allenwp/events{/privacy}","received_events_url":"https://api.github.com/users/allenwp/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-04-03T19:06:21Z","updated_at":"2025-04-03T19:06:21Z","body":"Update on my progress:\r\n\r\nAfter playing around with it more, I've found that there are actually four goals for the new AgX tone curve:\r\n\r\n1. Match the Blender AgX curve without oscillations found in the Godot 4.4 curve\r\n2. Improve performance compared the Godot 4.4 curve\r\n3. Allow addition of a configurable `white` parameter\r\n4. Work well with highly variable dynamic range for future support with HDR output\r\n\r\nThe first two goals are well achieved by the current state of this PR.\r\n\r\nThe third goal of the `white` parameter is somewhat achieved by this PR, but the contrast changes a fair bit as the white parameter changes. If this was the only issue, I'd say it's good enough, but...\r\n\r\nThe fourth goal is simply not achieved with the current state of this PR. The contrast (toe strength) is greatly influenced by manipulation of the dynamic range. I thought it would work well enough, but the contrast (toe strength) *increases* as dynamic range increases. In practice, artists would typically want the opposite behaviour, because an increase in dynamic range is naturally an increase in contrast already.\r\n\r\nThe reason this is such an issue is that the sort of HDR that Godot is aiming to support is actually described by Apple as \"Extended Dynamic Range\". That is, [values can simply extend beyond 100% (1.0)](https://developer.apple.com/documentation/metal/performing-your-own-tone-mapping). If the user turns their brightness to maximum, it's possible that there will be no extra dynamic range left to work with, so the maximum value will be 1.0. Or, the user may have their brightness low, so the maximum value would be something like 5.0 or 10.0. This behaviour is effectively the same on Windows for Godot's purposes, but Apple does a better job of explaining it.\r\n\r\n> When users increase the brightness, they typically expect midtones to increase and highlights to be compressed to fit into the range of the display.\r\n\r\nAll that to say, there is more maths to be done to achieve all of the goals for the new AgX tone curve. All of this should be very possible, but it's not something that's well documented (most HDR tonemapping is fixed range instead of variable/extended range).\r\n\r\nThis PR could be merged, but since the curve will need to be adjusted again in the future to support variable dynamic range, it might be better to only merge the curve after all goals have been met.","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2776689771/reactions","total_count":5,"+1":3,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":2,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2922735756","html_url":"https://github.com/godotengine/godot/pull/102435#issuecomment-2922735756","issue_url":"https://api.github.com/repos/godotengine/godot/issues/102435","id":2922735756,"node_id":"IC_kwDOAO6SJc6uNWiM","user":{"login":"allenwp","id":17506573,"node_id":"MDQ6VXNlcjE3NTA2NTcz","avatar_url":"https://avatars.githubusercontent.com/u/17506573?v=4","gravatar_id":"","url":"https://api.github.com/users/allenwp","html_url":"https://github.com/allenwp","followers_url":"https://api.github.com/users/allenwp/followers","following_url":"https://api.github.com/users/allenwp/following{/other_user}","gists_url":"https://api.github.com/users/allenwp/gists{/gist_id}","starred_url":"https://api.github.com/users/allenwp/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/allenwp/subscriptions","organizations_url":"https://api.github.com/users/allenwp/orgs","repos_url":"https://api.github.com/users/allenwp/repos","events_url":"https://api.github.com/users/allenwp/events{/privacy}","received_events_url":"https://api.github.com/users/allenwp/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-05-30T15:41:34Z","updated_at":"2025-05-30T15:41:34Z","body":"I've created a new PR that doesn't have as good of performance as this PR, but is extremely stable and predicable across all variable dynamic ranges, making it suitable for SDR, HDR, and variable Extended Dynamic Range (EDR): #106940\r\n\r\nI'll leave this in draft for now, but will close it if and when the new PR is merged.","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2922735756/reactions","total_count":4,"+1":4,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null}]