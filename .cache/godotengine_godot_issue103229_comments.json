atars.githubusercontent.com/u/59895191?v=4","gravatar_id":"","url":"https://api.github.com/users/Midrule","html_url":"https://github.com/Midrule","followers_url":"https://api.github.com/users/Midrule/followers","following_url":"https://api.github.com/users/Midrule/following{/other_user}","gists_url":"https://api.github.com/users/Midrule/gists{/gist_id}","starred_url":"https://api.github.com/users/Midrule/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Midrule/subscriptions","organizations_url":"https://api.github.com/users/Midrule/orgs","repos_url":"https://api.github.com/users/Midrule/repos","events_url":"https://api.github.com/users/Midrule/events{/privacy}","received_events_url":"https://api.github.com/users/Midrule/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-09-03T01:59:26Z","updated_at":"2026-09-03T01:59:26Z","body":"Don’t really understand how it’s just lack of documentation. Can’t image fps dependent behavior is intentional","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5519165006/reactions","total_count":5,"+1":5,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5611454558","html_url":"https://github.com/godotengine/godot/issues/103229#issuecomment-5611454558","issue_url":"https://api.github.com/repos/godotengine/godot/issues/103229","id":5611454558,"node_id":"IC_kwDOAO6SJc8AAAABTngAXg","user":{"login":"Joy-less","id":65855333,"node_id":"MDQ6VXNlcjY1ODU1MzMz","avatar_url":"https://avatars.githubusercontent.com/u/65855333?v=4","gravatar_id":"","url":"https://api.github.com/users/Joy-less","html_url":"https://github.com/Joy-less","followers_url":"https://api.github.com/users/Joy-less/followers","following_url":"https://api.github.com/users/Joy-less/following{/other_user}","gists_url":"https://api.github.com/users/Joy-less/gists{/gist_id}","starred_url":"https://api.github.com/users/Joy-less/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Joy-less/subscriptions","organizations_url":"https://api.github.com/users/Joy-less/orgs","repos_url":"https://api.github.com/users/Joy-less/repos","events_url":"https://api.github.com/users/Joy-less/events{/privacy}","received_events_url":"https://api.github.com/users/Joy-less/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-09-10T01:50:10Z","updated_at":"2026-09-10T01:52:25Z","body":"> EDIT: after some more experimentation I believe this is a different issue all together having to do with the drag calculation, I'll open up my own issue for this.\n\nI can confirm that setting drag (`set_joint_drag`) to 1.0 instead of other values seems to resolve the issue. Although it means you can't have a custom drag value.\nSo there seems to be something wrong with the drag calculation which causes it to glitch out at irregular framerates if the drag value is not equal to 1.0.","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5611454558/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null}]