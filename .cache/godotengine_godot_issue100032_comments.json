ub.com/users/Rudolph-B/following{/other_user}","gists_url":"https://api.github.com/users/Rudolph-B/gists{/gist_id}","starred_url":"https://api.github.com/users/Rudolph-B/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Rudolph-B/subscriptions","organizations_url":"https://api.github.com/users/Rudolph-B/orgs","repos_url":"https://api.github.com/users/Rudolph-B/repos","events_url":"https://api.github.com/users/Rudolph-B/events{/privacy}","received_events_url":"https://api.github.com/users/Rudolph-B/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2024-12-05T12:26:10Z","updated_at":"2024-12-05T13:13:38Z","body":"I can confirm #98770 is the cause. I made a mistake in the pointer math causing `_transform_vertices_range()` to overwrite `xformed_vertices` constantly. I missed it during testing since the issue only appears if `_transform_vertices_range()` is called multiple times, which only happens with larger scenes.\n\nI'll have fix shortly","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2520181464/reactions","total_count":3,"+1":3,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2521982292","html_url":"https://github.com/godotengine/godot/issues/100032#issuecomment-2521982292","issue_url":"https://api.github.com/repos/godotengine/godot/issues/100032","id":2521982292,"node_id":"IC_kwDOAO6SJc6WUmVU","user":{"login":"jitspoe","id":7751182,"node_id":"MDQ6VXNlcjc3NTExODI=","avatar_url":"https://avatars.githubusercontent.com/u/7751182?v=4","gravatar_id":"","url":"https://api.github.com/users/jitspoe","html_url":"https://github.com/jitspoe","followers_url":"https://api.github.com/users/jitspoe/followers","following_url":"https://api.github.com/users/jitspoe/following{/other_user}","gists_url":"