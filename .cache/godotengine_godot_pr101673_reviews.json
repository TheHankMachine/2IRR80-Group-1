01673#pullrequestreview-4891805152"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/101673"}},"submitted_at":"2026-08-09T15:55:18Z","commit_id":"2e2b878d0a7e320518d42c1c03906b44f1bb19c6"},{"id":4946686648,"node_id":"PRR_kwDOAO6SJc8AAAABJthyuA","user":{"login":"allenwp","id":17506573,"node_id":"MDQ6VXNlcjE3NTA2NTcz","avatar_url":"https://avatars.githubusercontent.com/u/17506573?u=6e9313e254649f6dc55e92536596487ac10bf5a2&v=4","gravatar_id":"","url":"https://api.github.com/users/allenwp","html_url":"https://github.com/allenwp","followers_url":"https://api.github.com/users/allenwp/followers","following_url":"https://api.github.com/users/allenwp/following{/other_user}","gists_url":"https://api.github.com/users/allenwp/gists{/gist_id}","starred_url":"https://api.github.com/users/allenwp/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/allenwp/subscriptions","organizations_url":"https://api.github.com/users/allenwp/orgs","repos_url":"https://api.github.com/users/allenwp/repos","events_url":"https://api.github.com/users/allenwp/events{/privacy}","received_events_url":"https://api.github.com/users/allenwp/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"> I've tested an engine build with this pull request applied and can confirm that mic audio works great on my laptop (with 5 channels) after applying this fix.\n\nThanks for testing this for us! I don't have a setup that has a > 2 channel microphone to test with, so if anyone else is available to test with this scenario it would definitely be appreciated any time in the next month or two before 4.8 stable release. Testing after the PR is merged is appreciated just as much as testing before the PR is merged!\n\nThis code won't make any difference to the scenario of microphones with two or less channels, so this is a very simple and low risk PR to merge. Let's go ahead with this PR and see if anyone has issues with mic input using these sorts of multichannel microphones.","state":"APPROVED","html_url":"https://github.com/godotengine/godot/pull/101673#pullrequestreview-4946686648","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/101673","author_association":"CONTRIBUTOR","_links":{"html":{"href":"https://github.com/godotengine/godot/pull/101673#pullrequestreview-4946686648"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/101673"}},"submitted_at":"2026-08-16T16:53:36Z","commit_id":"282f2a849860fb5a3dfeb73c3d24e604566b7dd7"}]