ckeye-d/followers","following_url":"https://api.github.com/users/sockeye-d/following{/other_user}","gists_url":"https://api.github.com/users/sockeye-d/gists{/gist_id}","starred_url":"https://api.github.com/users/sockeye-d/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/sockeye-d/subscriptions","organizations_url":"https://api.github.com/users/sockeye-d/orgs","repos_url":"https://api.github.com/users/sockeye-d/repos","events_url":"https://api.github.com/users/sockeye-d/events{/privacy}","received_events_url":"https://api.github.com/users/sockeye-d/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-09-28T08:58:44Z","updated_at":"2025-09-28T08:58:44Z","body":"> I haven't looked at the code, but there is some corner case: we have a \"preload\" from \"uid://\" to a file, we can see the path to this resource in the inline resource picker. This file is then moved to another folder. Thus, the path in inline resource picker must be updated at the same time as the file is moved.\r\n\r\nThis has been fixed, finally","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3342615107/reactions","total_count":1,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":1,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3344687798","html_url":"https://github.com/godotengine/godot/pull/110920#issuecomment-3344687798","issue_url":"https://api.github.com/repos/godotengine/godot/issues/110920","id":3344687798,"node_id":"IC_kwDOAO6SJc7HW-K2","user":{"login":"sockeye-d","id":106356149,"node_id":"U_kgDOBlbdtQ","avatar_url":"https://avatars.githubusercontent.com/u/106356149?v=4","gravatar_id":"","url":"https://api.github.com/users/sockeye-d","html_url":"https://github.com/sockeye-d","followers_url":"https://api.github.com/users/sockeye-d/followers","following_url":"https://api.github.com/users/sockeye-d/following{/other_user}","gists_url":"https://api.github.com/users/sockeye-d/gists{/gist_id}","starred_url":"https://api.github.com/users/sockeye-d/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/sockeye-d/subscriptions","organizations_url":"https://api.github.com/users/sockeye-d/orgs","repos_url":"https://api.github.com/users/sockeye-d/repos","events_url":"https://api.github.com/users/sockeye-d/events{/privacy}","received_events_url":"https://api.github.com/users/sockeye-d/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-09-29T03:02:51Z","updated_at":"2025-09-29T03:02:51Z","body":"I've resolved all the review comments. I'm not sure what to do about relative paths — I'm not even sure they're worth handling. Especially since the main focus of this is for `uid://` paths, which can't be relative.\r\n\r\nMaybe I could have a separate RegEx just for `(pre)?load`? Like\r\n```regex\r\n\\b(?:pre)?load\\s*\\((?P<quote>\"|\"\"\"|'|''')(?P<inner>.*?)(?P=quote)\\)\r\n```\r\n\r\nThen it can display the load button in addition to the full path, maybe. I'd be replicating a lot of work already done elsewhere without a refactor though, I think. And then it'd need another setting for whether relative paths should be replaced with absolute paths, or whether they should remain relative, or whether they should be converted to UIDs, etc.","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3344687798/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3350453203","html_url":"https://github.com/godotengine/godot/pull/110920#issuecomment-3350453203","issue_url":"https://api.github.com/repos/godotengine/godot/issues/110920","id":3350453203,"node_id":"IC_kwDOAO6SJc7Hs9vT","user":{"login":"sockeye-d","id":106356149,"node_id":"U_kgDOBlbdtQ","avatar_url":"https://avatars.githubusercontent.com/u/106356149?v=4","gravatar_id":"","url":"https://api.github.com/users/sockeye-d","html_url":"https://github.com/sockeye-d","followers_url":"https://api.github.com/users/sockeye-d/followers","following_url":"https://api.github.com/users/sockeye-d/following{/other_user}","gists_url":"https://api.github.com/users/sockeye-d/gists{/gist_id}","starred_url":"https://api.github.com/users/sockeye-d/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/sockeye-d/subscriptions","organizations_url":"https://api.github.com/users/sockeye-d/orgs","repos_url":"https://api.github.com/users/sockeye-d/repos","events_url":"https://api.github.com/users/sockeye-d/events{/privacy}","received_events_url":"https://api.github.com/users/sockeye-d/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-09-30T07:46:50Z","updated_at":"2025-09-30T07:46:50Z","body":"> When the the path is long enough to go off of the screen and word wrap is off, the inlay path doesn't draw correctly, it gets clipped. It happens if you scroll to far horizontally too.\n\nI can't do much about this\n","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3350453203/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3408579740","html_url":"https://github.com/godotengine/godot/pull/110920#issuecomment-3408579740","issue_url":"https://api.github.com/repos/godotengine/godot/issues/110920","id":3408579740,"node_id":"IC_kwDOAO6SJc7LKsyc","user":{"login":"sockeye-d","id":106356149,"node_id":"U_kgDOBlbdtQ","avatar_url":"https://avatars.githubusercontent.com/u/106356149?v=4","gravatar_id":"","url":"https://api.github.com/users/sockeye-d","html_url":"https://github.com/sockeye-d","followers_url":"https://api.github.com/users/sockeye-d/followers","following_url":"https://api.github.com/users/sockeye-d/following{/other_user}","gists_url":"https://api.github.com/users/sockeye-d/gists{/gist_id}","starred_url":"https://api.github.com/users/sockeye-d/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/sockeye-d/subscriptions","organizations_url":"https://api.github.com/users/sockeye-d/orgs","repos_url":"https://api.github.com/users/sockeye-d/repos","events_url":"https://api.github.com/users/sockeye-d/events{/privacy}","received_events_url":"https://api.github.com/users/sockeye-d/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-10-15T22:59:34Z","updated_at":"2025-10-15T22:59:34Z","body":"> The inline path text looks annoying. It's big and behaves awkwardly with caret. Though I don't think it can be more friendly, and there is a setting to disable it, so I guess it's fine. We'll see if users like it.\r\n\r\nYeah I can just remove it and hold off on it until inline text (not just custom drawn objects) also get support","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3408579740/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3585014605","html_url":"https://github.com/godotengine/godot/pull/110920#issuecomment-3585014605","issue_url":"https://api.github.com/repos/godotengine/godot/issues/110920","id":3585014605,"node_id":"IC_kwDOAO6SJc7VrvtN","user":{"login":"coppolaemilio","id":2206700,"node_id":"MDQ6VXNlcjIyMDY3MDA=","avatar_url":"https://avatars.githubusercontent.com/u/2206700?v=4","gravatar_id":"","url":"https://api.github.com/users/coppolaemilio","html_url":"https://github.com/coppolaemilio","followers_url":"https://api.github.com/users/coppolaemilio/followers","following_url":"https://api.github.com/users/coppolaemilio/following{/other_user}","gists_url":"https://api.github.com/users/coppolaemilio/gists{/gist_id}","starred_url":"https://api.github.com/users/coppolaemilio/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/coppolaemilio/subscriptions","organizations_url":"https://api.github.com/users/coppolaemilio/orgs","repos_url":"https://api.github.com/users/coppolaemilio/repos","events_url":"https://api.github.com/users/coppolaemilio/events{/privacy}","received_events_url":"https://api.github.com/users/coppolaemilio/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-11-27T09:56:11Z","updated_at":"2025-11-27T09:56:11Z","body":"While the color preview also acts as a picker, I think it adds value to represent what color is set instead of just a bunch of values. For the UIDs, you can already see their path and extra options if you hover on it, so I feel like this is just adding more noise to the editor:\r\n\r\nhttps://github.com/user-attachments/assets/dc029768-a023-470e-8fb2-0d24db9c5a7e\r\n\r\nYou can see this kind of _noise_ if you use any live-preview editor for markdown, where it becomes super complicated to know if the text you are editing is actually text on your file, or a representation of it made by the editor. In this case you are adding whole paths to a string (including a white space) where it doesn't exists one. \r\n\r\nThis change would fit better in a visual scripting system, not on a plain text editor. I don't think it is necessarily a bad thing to add this, but it would open the gates to add something like this everywhere, and it would lead to editor clutter. ie: are we adding a quickload folder to each node to select the type of node? etc... \r\n\r\nSo, I would make this an addon and, if not possible as an addon, I would add the necessary changes to make addons like this possible, but I wouldn't include it in the default experience for users.","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3585014605/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3585020685","html_url":"https://github.com/godotengine/godot/pull/110920#issuecomment-3585020685","issue_url":"https://api.github.com/repos/godotengine/godot/issues/110920","id":3585020685,"node_id":"IC_kwDOAO6SJc7VrxMN","user":{"login":"sockeye-d","id":106356149,"node_id":"U_kgDOBlbdtQ","avatar_url":"https://avatars.githubusercontent.com/u/106356149?v=4","gravatar_id":"","url":"https://api.github.com/users/sockeye-d","html_url":"https://github.com/sockeye-d","followers_url":"https://api.github.com/users/sockeye-d/followers","following_url":"https://api.github.com/users/sockeye-d/following{/other_user}","gists_url":"https://api.github.com/users/sockeye-d/gists{/gist_id}","starred_url":"https://api.github.com/users/sockeye-d/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/sockeye-d/subscriptions","organizations_url":"https://api.github.com/users/sockeye-d/orgs","repos_url":"https://api.github.com/users/sockeye-d/repos","events_url":"https://api.github.com/users/sockeye-d/events{/privacy}","received_events_url":"https://api.github.com/users/sockeye-d/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-11-27T09:57:51Z","updated_at":"2025-11-27T09:57:51Z","body":"Is that referring to the path preview or the quick load button?","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3585020685/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0