s","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4083362085","html_url":"https://github.com/godotengine/godot/pull/111171#issuecomment-4083362085","issue_url":"https://api.github.com/repos/godotengine/godot/issues/111171","id":4083362085,"node_id":"IC_kwDOAO6SJc7zYykl","user":{"login":"HolonProduction","id":99511741,"node_id":"U_kgDOBe5tvQ","avatar_url":"https://avatars.githubusercontent.com/u/99511741?v=4","gravatar_id":"","url":"https://api.github.com/users/HolonProduction","html_url":"https://github.com/HolonProduction","followers_url":"https://api.github.com/users/HolonProduction/followers","following_url":"https://api.github.com/users/HolonProduction/following{/other_user}","gists_url":"https://api.github.com/users/HolonProduction/gists{/gist_id}","starred_url":"https://api.github.com/users/HolonProduction/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/HolonProduction/subscriptions","organizations_url":"https://api.github.com/users/HolonProduction/orgs","repos_url":"https://api.github.com/users/HolonProduction/repos","events_url":"https://api.github.com/users/HolonProduction/events{/privacy}","received_events_url":"https://api.github.com/users/HolonProduction/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-03-18T15:16:54Z","updated_at":"2026-03-18T15:16:54Z","body":"I'd honestly prefer deprecating the exposed method as suggested in https://github.com/godotengine/godot/issues/40122\r\n","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4083362085/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4083913228","html_url":"https://github.com/godotengine/godot/pull/111171#issuecomment-4083913228","issue_url":"https://api.github.com/repos/godotengine/godot/issues/111171","id":4083913228,"node_id":"IC_kwDOAO6SJc7za5IM","user":{"login":"Naros","id":3255568,"node_id":"MDQ6VXNlcjMyNTU1Njg=","avatar_url":"https://avatars.githubusercontent.com/u/3255568?v=4","gravatar_id":"","url":"https://api.github.com/users/Naros","html_url":"https://github.com/Naros","followers_url":"https://api.github.com/users/Naros/followers","following_url":"https://api.github.com/users/Naros/following{/other_user}","gists_url":"https://api.github.com/users/Naros/gists{/gist_id}","starred_url":"https://api.github.com/users/Naros/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Naros/subscriptions","organizations_url":"https://api.github.com/users/Naros/orgs","repos_url":"https://api.github.com/users/Naros/repos","events_url":"https://api.github.com/users/Naros/events{/privacy}","received_events_url":"https://api.github.com/users/Naros/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-03-18T16:32:42Z","updated_at":"2026-03-18T16:33:09Z","body":"`Script::get_property_default_value` is used by `PlaceHolderScriptInstance`, and would equally be used by any GDExtension that implements their own ScriptInstance impl on the godot-cpp side for languages.  Would there be any sort of replacement, because this method is critical for any existing `ScriptExtension` implementation atm.","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4083913228/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4085015124","html_url":"https://github.com/godotengine/godot/pull/111171#issuecomment-4085015124","issue_url":"https://api.github.com/repos/godotengine/godot/issues/111171","id":4085015124,"node_id":"IC_kwDOAO6SJc7zfGJU","user":{"login":"HolonProduction","id":99511741,"node_id":"U_kgDOBe5tvQ","avatar_url":"https://avatars.githubusercontent.com/u/99511741?v=4","gravatar_id":"","url":"https://api.github.com/users/HolonProduction","html_url":"https://github.com/HolonProduction","followers_url":"https://api.github.com/users/HolonProduction/followers","following_url":"https://api.github.com/users/HolonProduction/following{/other_user}","gists_url":"https://api.github.com/users/HolonProduction/gists{/gist_id}","starred_url":"https://api.github.com/users/HolonProduction/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/HolonProduction/subscriptions","organizations_url":"https://api.github.com/users/HolonProduction/orgs","repos_url":"https://api.github.com/users/HolonProduction/repos","events_url":"https://api.github.com/users/HolonProduction/events{/privacy}","received_events_url":"https://api.github.com/users/HolonProduction/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-03-18T19:15:50Z","updated_at":"2026-03-18T19:15:50Z","body":"There is a difference between deprecating a virtual method which you implement and deprecating the method you can call.\r\n\r\nBut I don't actually think we need to deprecate it. I just prefer that over changing its behaviour without good reason. The method was exposed in https://github.com/godotengine/godot/pull/31021 under the pretext of custom editor tooling. It's totally reasonable that it is only functional in editor builds (this needs documentation:TM:).\r\nThis method is doing what it was written for. It was intentionally exposed like this. Any bug about it, is just a result of poor documentation. Changes to its behaviour are stuff for a proposal with a good usecase IMHO.\r\n\r\nAnyway this discussion belongs somewhere else. I also don't think the property removed in this PR is a silver bullet to solving the issue, since it's only updated in the editor.","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4085015124/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4085176453","html_url":"https://github.com/godotengine/godot/pull/111171#issuecomment-4085176453","issue_url":"https://api.github.com/repos/godotengine/godot/issues/111171","id":4085176453,"node_id":"IC_kwDOAO6SJc7zftiF","user":{"login":"dalexeev","id":47700418,"node_id":"MDQ6VXNlcjQ3NzAwNDE4","avatar_url":"https://avatars.githubusercontent.com/u/47700418?v=4","gravatar_id":"","url":"https://api.github.com/users/dalexeev","html_url":"https://github.com/dalexeev","followers_url":"https://api.github.com/users/dalexeev/followers","following_url":"https://api.github.com/users/dalexeev/following{/other_user}","gists_url":"https://api.github.com/users/dalexeev/gists{/gist_id}","starred_url":"https://api.github.com/users/dalexeev/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/dalexeev/subscriptions","organizations_url":"https://api.github.com/users/dalexeev/orgs","repos_url":"https://api.github.com/users/dalexeev/repos","events_url":"https://api.github.com/users/dalexeev/events{/privacy}","received_events_url":"https://api.github.com/users/dalexeev/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-03-18T19:48:05Z","updated_at":"2026-03-18T19:48:05Z","body":"Please note that there is a similar method, `ClassDB.class_get_property_default_value()`. Also, in my opinion, it is not entirely correct to refer to an issue whose number is 80 thousand less than the current one. The original motivation for exposing this method may have been different, but now the only important thing is whether this functionality makes sense.","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4085176453/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4106232893","html_url":"https://github.com/godotengine/godot/pull/111171#issuecomment-4106232893","issue_url":"https://api.github.com/repos/godotengine/godot/issues/111171","id":4106232893,"node_id":"IC_kwDOAO6SJc70wCQ9","user":{"login":"HolonProduction","id":99511741,"node_id":"U_kgDOBe5tvQ","avatar_url":"https://avatars.githubusercontent.com/u/99511741?v=4","gravatar_id":"","url":"https://api.github.com/users/HolonProduction","html_url":"https://github.com/HolonProduction","followers_url":"https://api.github.com/users/HolonProduction/followers","following_url":"https://api.github.com/users/HolonProduction/following{/other_user}","gists_url":"https://api.github.com/users/HolonProduction/gists{/gist_id}","starred_url":"https://api.github.com/users/HolonProduction/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/HolonProduction/subscriptions","organizations_url":"https://api.github.com/users/HolonProduction/orgs","repos_url":"https://api.github.com/users/HolonProduction/repos","events_url":"https://api.github.com/users/HolonProduction/events{/privacy}","received_events_url":"https://api.github.com/users/HolonProduction/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-03-22T13:07:32Z","updated_at":"2026-03-22T13:07:32Z","body":"> Please note that there is a similar method, `ClassDB.class_get_property_default_value()`. Also, in my opinion, it is not entirely correct to refer to an issue whose number is 80 thousand less than the current one. The original motivation for exposing this method may have been different, but now the only important thing is whether this functionality makes sense.\r\n\r\nFair, I did somewhat misunderstand the concerns as wanting to support non-const values. But having this work in non debug builds seems reasonable.","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4106232893/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null}]