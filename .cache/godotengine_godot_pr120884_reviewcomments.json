ormal, vec3\n \thvec3 pos_local_to_light = hvec3(dot(light_to_vert, area_a_dir), dot(light_to_vert, area_b_dir), dot(light_to_vert, -area_direction));\n \n \thvec3 closest_point_local_to_light = hvec3(clamp(pos_local_to_light.x, -a_half_len, a_half_len), clamp(pos_local_to_light.y, -b_half_len, b_half_len), 0);\n-\thalf dist = length(closest_point_local_to_light - pos_local_to_light);\n+\tfloat dist = length(vec3(closest_point_local_to_light) - vec3(pos_local_to_light));\n \n-\thalf light_length = max(half(0.0), dist);\n-\thalf light_attenuation_raw = get_omni_attenuation(float(light_length), area_lights.data[idx].inv_radius, area_lights.data[idx].attenuation);\n-\thalf light_attenuation_ltc = light_attenuation_raw * half(light_length * light_length); // solid angle already decreases by inverse square, so attenuation power is 2.0 by default -> subtract 2.0\n+\tfloat light_length = max(0.0, dist);\n+\thalf light_attenuation_raw = get_omni_attenuation(light_length, area_lights.data[idx].inv_radius, area_lights.data[idx].attenuation);\n+\thalf light_attenuation_ltc = half(float(light_attenuation_raw) * light_length * light_length); // solid angle already decreases by inverse square, so attenuation power is 2.0 by default -> subtract 2.0","path":"servers/rendering/renderer_rd/shaders/scene_forward_lights_inc.glsl","commit_id":"8352cfa5b7a099367fb3ab2f0aaf195e48c3b50f","original_commit_id":"8352cfa5b7a099367fb3ab2f0aaf195e48c3b50f","user":{"login":"Mingxi-Z","id":100094557,"node_id":"U_kgDOBfdSXQ","avatar_url":"https://avatars.githubusercontent.com/u/100094557?v=4","gravatar_id":"","url":"https://api.github.com/users/Mingxi-Z","html_url":"https://github.com/Mingxi-Z","followers_url":"https://api.github.com/users/Mingxi-Z/followers","following_url":"https://api.github.com/users/Mingxi-Z/following{/other_user}","gists_url":"https://api.github.com/users/Mingxi-Z/gists{/gist_id}","starred_url":"https://api.github.com/users/Mingxi-Z/starred{/owner}{/repo}","subscriptions_url"