[{"id":4470095226,"node_id":"PRR_kwDOAO6SJc8AAAABCnA9eg","user":{"login":"dalexeev","id":47700418,"node_id":"MDQ6VXNlcjQ3NzAwNDE4","avatar_url":"https://avatars.githubusercontent.com/u/47700418?u=0565b5d99d54afd5fda6712cd8eb05893572baed&v=4","gravatar_id":"","url":"https://api.github.com/users/dalexeev","html_url":"https://github.com/dalexeev","followers_url":"https://api.github.com/users/dalexeev/followers","following_url":"https://api.github.com/users/dalexeev/following{/other_user}","gists_url":"https://api.github.com/users/dalexeev/gists{/gist_id}","starred_url":"https://api.github.com/users/dalexeev/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/dalexeev/subscriptions","organizations_url":"https://api.github.com/users/dalexeev/orgs","repos_url":"https://api.github.com/users/dalexeev/repos","events_url":"https://api.github.com/users/dalexeev/events{/privacy}","received_events_url":"https://api.github.com/users/dalexeev/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"The idea seems good to me, but I haven't delved into the details and am unsure what the implications might be in edge cases (such as multithreading). We need to ensure that during hot reloading, all script instances are updated before the `old_member_indices` in the script is cleared. We also need to ensure that this works correctly for inherited classes (the correct order parent-child classes) and cyclic dependencies.\n\nBut we should probably still do this at the beginning of the 4.8 dev cycle, despite the risk of regressions. Hot reloading is an important feature, but not the most critical one. In the worst case, we may introduce strange behavior, which could confuse users during debugging with hot reloading. But I'd still like to reduce the likelihood of silently masking errors (see my comment about the `is_reloading_members` flag).","state":"COMMENTED","html_url":"https://github.com/godotengine/godot/pull/117438#pullrequestreview-4470095226","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/117438","author_association":"CONTRIBUTOR","_links":{"html":{"href":"https://github.com/godotengine/godot/pull/117438#pullrequestreview-4470095226"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/117438"}},"submitted_at":"2026-06-10T17:27:15Z","commit_id":"35449aaf99b19f44bbeef75bd1b89a5a774f9f4b"},{"id":4470826549,"node_id":"PRR_kwDOAO6SJc8AAAABCntmNQ","user":{"login":"HolonProduction","id":99511741,"node_id":"U_kgDOBe5tvQ","avatar_url":"https://avatars.githubusercontent.com/u/99511741?u=b7882c94f408976a2f79e8fe6e1ce27fbd48db74&v=4","gravatar_id":"","url":"https://api.github.com/users/HolonProduction","html_url":"https://github.com/HolonProduction","followers_url":"https://api.github.com/users/HolonProduction/followers","following_url":"https://api.github.com/users/HolonProduction/following{/other_user}","gists_url":"https://api.github.com/users/HolonProduction/gists{/gist_id}","starred_url":"https://api.github.com/users/HolonProduction/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/HolonProduction/subscriptions","organizations_url":"https://api.github.com/users/HolonProduction/orgs","repos_url":"https://api.github.com/users/HolonProduction/repos","events_url":"https://api.github.com/users/HolonProduction/events{/privacy}","received_events_url":"https://api.github.com/users/HolonProduction/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"","state":"COMMENTED","html_url":"https://github.com/godotengine/godot/pull/117438#pullrequestreview-4470826549","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/117438","author_association":"MEMBER","_links":{"html":{"href":"https://github.com/godotengine/godot/pull/117438#pullrequestreview-4470826549"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/117438"}},"submitted_at":"2026-06-10T19:07:23Z","commit_