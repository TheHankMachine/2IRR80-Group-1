/repo}","subscriptions_url":"https://api.github.com/users/KoBeWi/subscriptions","organizations_url":"https://api.github.com/users/KoBeWi/orgs","repos_url":"https://api.github.com/users/KoBeWi/repos","events_url":"https://api.github.com/users/KoBeWi/events{/privacy}","received_events_url":"https://api.github.com/users/KoBeWi/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"","state":"COMMENTED","html_url":"https://github.com/godotengine/godot/pull/117949#pullrequestreview-4698476949","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/117949","author_association":"MEMBER","_links":{"html":{"href":"https://github.com/godotengine/godot/pull/117949#pullrequestreview-4698476949"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/117949"}},"submitted_at":"2026-07-14T20:57:20Z","commit_id":"902a142a6ee758d5b350fc5b243eed2a6fa46996"},{"id":4935419385,"node_id":"PRR_kwDOAO6SJc8AAAABJiyF-Q","user":{"login":"AdriaandeJongh","id":5611323,"node_id":"MDQ6VXNlcjU2MTEzMjM=","avatar_url":"https://avatars.githubusercontent.com/u/5611323?v=4","gravatar_id":"","url":"https://api.github.com/users/AdriaandeJongh","html_url":"https://github.com/AdriaandeJongh","followers_url":"https://api.github.com/users/AdriaandeJongh/followers","following_url":"https://api.github.com/users/AdriaandeJongh/following{/other_user}","gists_url":"https://api.github.com/users/AdriaandeJongh/gists{/gist_id}","starred_url":"https://api.github.com/users/AdriaandeJongh/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/AdriaandeJongh/subscriptions","organizations_url":"https://api.github.com/users/AdriaandeJongh/orgs","repos_url":"https://api.github.com/users/AdriaandeJongh/repos","events_url":"https://api.github.com/users/AdriaandeJongh/events{/privacy}","received_events_url":"https://api.github.com/users/AdriaandeJongh/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"Let's start putting in the work and reviewing this for real then!\n\nFirst of all: thanks for doing the work @KoBeWi! I really appreciate your methodology of just diving into the work and fixing it (with help of others) along the way. I gave this PR a spin (using the check's artifacts) and ran into the following things:\n\n- the text in the replacing field still needs to be in monotype.\n\n<img width=\"330\" height=\"180\" alt=\"Image\" src=\"https://github.com/user-attachments/assets/5b8296bd-61a5-4373-afa3-018531f3362b\" />\n\n- in the following example, the function's name in the script where I triggered the rename is not included in the search results list. was this PR not rebased on since https://github.com/godotengine/godot/pull/114300 was merged?\n\n<img width=\"709\" height=\"581\" alt=\"Image\" src=\"https://github.com/user-attachments/assets/1421dbd1-0140-40f8-be81-c011f2969865\" />\n\n- the fact that exported properties will not be renamed in the scene WILL be the number 1 follow up PR request after we merge this feature.\n- the test in the window that pops up to inform you you're renaming an export property doesn't wrap, making it very wide with no way to make it smaller:\n\n<img width=\"999\" height=\"151\" alt=\"Image\" src=\"https://github.com/user-attachments/assets/c308ab40-381e-42f2-a210-add09b04f99f\" />\n\n- the search result items don't clear after applying the rename, leaving a list of outdated variable names.\n\n- the text field in which you type the new name of the variable implies that upon hitting enter, the rename will happen, which isn't really the case. subsequently it's a bit disorienting, even after having done this a dozen times, that I now need to go into the search panel to do the actual thing. perhaps the text field could be accompanied by a button that says 'Preview Rename'?\n\n- this function currently uses the search results panel which looks and feels like a search results panel; it's kind of a preview of what'll be replaced, but also not kinda' because the only place where you can see what the new replace text is is at the botton of the panel. it could help in previewing the changes if the found text is strikethrough and with a red background, and the new text is inserted after with a green background.\n\n- this PR will gain a considerable usability improvement when https://github.com/godotengine/godot/pull/116560 is merged. Maybe some folks could review that so that we can get it merged before this?\n\n- I attempted to rename all symbols and I found it quite inconsistent when the rename symbol option appeared vs. when it also actually worked. in an ideal world, symbols that can't be renamed shouldn't have the option. in the example below, I found one case (Test1) that should have worked but didn't.\n\nhttps://github.com/user-attachments/assets/cfe0ec4a-b075-4968-9a0d-e74e2ed1ea03\n\nI'll give this another spin later.","state":"COMMENTED","html_url":"https://github.com/godotengine/godot/pull/117949#pullrequestreview-4935419385","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/117949","author_association":"CONTRIBUTOR","_links":{"html":{"href":"https://github.com/godotengine/godot/pull/117949#pullrequestreview-4935419385"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/117949"}},"submitted_at":"2026-08-14T08:33:50Z","commit_id":"584309c5ab195a1aa1dbb2e1d8a703f9efecd222"},{"id":4944143535,"node_id":"PRR_kwDOAO6SJc8AAAABJrGkrw","user":{"login":"Mickeon","id":66727710,"node_id":"MDQ6VXNlcjY2NzI3NzEw","avatar_url":"https://avatars.githubusercontent.com/u/66727710?u=8069d9b7bc6ab503ce83dfcfa53fd021672aeccf&v=4","gravatar_id":"","url":"https://api.github.com/users/Mickeon","html_url":"https://github.com/Mickeon","followers_url":"https://api.github.com/users/Mickeon/followers","following_url":"https://api.github.com/users/Mickeon/following{/other_user}","gists_url":"https://api.github.com/users/Mickeon/gists{/gist_id}","starred_url":"https://api.github.com/users/Mickeon/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Mickeon/subscriptions","organizations_url":"https://api.github.com/users/Mickeon/orgs","repos_url":"https://api.github.com/users/Mickeon/repos","events_url":"https://api.github.com/users/Mickeon/events{/privacy}","received_events_url":"https://api.github.com/users/Mickeon/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"The fact that it doesn't try to go through scene and resource files makes this PR a _very tough sell_ right now usability-wise, I have to admit. Yes, it is simple by design, but I do foresee a general air of disappointment until we figure it out...","state":"COMMENTED","html_url":"https://github.com/godotengine/godot/pull/117949#pullrequestreview-4944143535","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/117949","author_association":"MEMBER","_links":{"html":{"href":"https://github.com/godotengine/godot/pull/117949#pullrequestreview-4944143535"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/117949"}},"submitted_at":"2026-08-15T15:40:00Z","commit_id":"919cbd9f212803830ada426e0167b8b3675b5298"},{"id":4946060403,"node_id":"PRR_kwDOAO6SJc8AAAABJs7kcw","user":{"login":"AdriaandeJongh","id":5611323,"node_id":"MDQ6VXNlcjU2MTEzMjM=","avatar_url":"https://avatars.githubusercontent.com/u/5611323?v=4","gravatar_id":"","url":"https://api.github.com/users/AdriaandeJongh","html_url":"https://github.com/AdriaandeJongh","followers_url":"https://api.github.com/users/AdriaandeJongh/followers","following_url":"https://api.github.com/users/AdriaandeJongh/following{/other_user}","gists_url":"https://api.github.com/users/AdriaandeJongh/gists{/gist_id}","starred_url":"https://api.github.com/users/AdriaandeJongh/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/AdriaandeJongh/subscriptions","organizations_url":"https://api.github.com/users/AdriaandeJongh/orgs","repos_url":"https://api.github.com/users/AdriaandeJongh/repos","events_url":"https://api.github.com/users/AdriaandeJongh/events{/privacy}","received_events_url":"https://api.github.com/users/AdriaandeJongh/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"Did another round of testing.\n\n**Renaming user-defined class names**\nThe current version doesn't allow renaming of user-defined class names. I think it's safe to say users will expect this to be possible. Renaming the class name on both of these symbols doesn't work: `class_name Test1` and `@export var t1: Test1`.\n\n**Dedicated Rename panel**\nI have very strong doubts over whether reusing the Find in Files panel is the right approach here. The layout right now makes very little sense to me for many reasons (illogical layout, unnecessary tabs). This is the current panel:\n\n<img width=\"1053\" height=\"338\" alt=\"Screenshot 2026-08-16 at 12 17 25\" src=\"https://github.com/user-attachments/assets/b52c90ba-ede9-422e-9407-901ec45f3c5c\" />\n\nI made a quick and dirty mockup of what I think would be a more logical panel that's more in line with the functionality we're adding here:\n\n<img width=\"763\" height=\"349\" alt=\"Screenshot 2026-08-16 at 12 32 21\" src=\"https://github.com/user-attachments/assets/a3260f5e-2041-4156-8dce-7a8bf0e3903b\" />\n\n(note: I couldn't easily align the [r] buttons which represent the rename / replace icons, but imagine that they're all hugging the far right.)\n\n**Quicker focus on Rename panel**\nBecause the proposed rename functionality is an \"assisted rename\" that always requires another panel for the user to confirm the renames, I propose improving the user experience by shifting the focus into the rename panel quicker than what's happening currently. The input field that spawns on top of the symbol-to-be-renamed implies that, upon hitting enter, it'll be renamed immediately... but instead it opens another panel and it is disorienting.\n\nUnless / until we remove the intermediary steps and make the rename 'not assisted' through a panel, I propose to remove the input field on top of the symbol-to-be-renamed so that the order of events is as follows:\n- user selects 'rename symbol' option (context menu or shortcut)\n- rename panel opens \n- the input field to enter the text you want to rename to is focussed, so user can immediately type\n- user modifies the checkboxes where / when desired\n- user either clicks 'rename selected' or hits a shortcut (ctrl/cmd + enter?) to apply the renames\n- rename panel disappears\n- focus returns to script editor","state":"COMMENTED","html_url":"https://github.com/godotengine/godot/pull/117949#pullrequestreview-4946060403","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/117949","author_association":"CONTRIBUTOR","_links":{"html":{"href":"https://github.com/godotengine/godot/pull/117949#pullrequestreview-4946060403"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/117949"}},"submitted_at":"2026-08-16T11:12:18Z","commit_id":"501dc12f9267e68b07eecf40a29ab7a74294ec19"},{"id":5007119232,"node_id":"PRR_kwDOAO6SJc8AAAABKnKTgA","user":{"login":"AThousandShips","id":96648715,"node_id":"U_kgDOBcK-Cw","avatar_url":"https://avatars.githubusercontent.com/u/96648715?u=af70f5d107e9c1447f296643d5a566dab53d25e8&v=4","gravatar_id":"","url":"https://api.github.com/users/AThousandShips","html_url":"https://github.com/AThousandShips","followers_url":"https://api.github.com/users/AThousandShips/followers","following_url":"https://api.github.com/users/AThousandShips/following{/other_user}","gists_url":"https://api.github.com/users/AThousandShips/gists{/gist_id}","starred_url":"https://api.github.com/users/AThousandShips/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/AThousandShips/subscriptions","organizations_url":"https://api.github.com/users/AThousandShips/orgs","repos_url":"https://api.github.com/users/AThous