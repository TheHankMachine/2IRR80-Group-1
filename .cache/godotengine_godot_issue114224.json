/repo}","subscriptions_url":"https://api.github.com/users/dsnopek/subscriptions","organizations_url":"https://api.github.com/users/dsnopek/orgs","repos_url":"https://api.github.com/users/dsnopek/repos","events_url":"https://api.github.com/users/dsnopek/events{/privacy}","received_events_url":"https://api.github.com/users/dsnopek/received_events","type":"User","user_view_type":"public","site_admin":false},"author_association":"NONE","issue_field_values":[],"type":null,"active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"### Tested versions\n\n- reproducible in 28bd72a7e1146a2de409\n\nThis can be worked around in gdscript by forcing a RID change:\n\n```\n\t# Force swapchain recreation by temporarily disconnecting the viewport.\n\t# The OpenXR composition layer's set_viewport() only updates viewport_size when\n\t# the viewport RID changes. Setting layer_viewport to null then back to the\n\t# viewport forces the RID to change, which triggers the size update in\n\t# openxr_composition_layer_extension.cpp. The swapchain is then recreated in\n\t# update_and_acquire_swapchain() when it detects swapchain_size != viewport_size.\n\tcomp_layer.layer_viewport = null\n\tget_tree().create_timer(0.1).timeout.connect(func() -> void:\n\t\tcomp_layer.layer_viewport = viewport\n\t)\n```\n\n### System information\n\nQuest 3\n\n### Issue description\n\nI have quad layers that change size when buttons become visible or invisible, etc. The OpenXRCompositionLayer does not reallocate its swapchain when this happens unless I employ the above workaround.\n\n### Steps to reproduce\n\nChange the resolution of a SubViewport that an OpenXRCompositionLayerQuad is displaying dynamically, and you'll see that the quad resolution does not change along with it.\n\n### Minimal reproduction project (MRP)\n\nDon't have a minimal reproduction project, but I think you can see the problem by inspection as indicated in the commented gdscript above.","closed_by":{"login":"Repiteo","id":17489292,"node_id":"MDQ6VXNlcjE3NDg5Mjky","avatar_url":"https://avatars.githubusercontent.com/u/17489292?v=4","gravatar_id":"","url":"https://api.github.com/users/Repiteo","html_url":"https://github.com/Repiteo","followers_url":"https://api.github.com/users/Repiteo/followers","following_url":"https://api.github.com/users/Repiteo/following{/other_user}","gists_url":"https://api.github.com/users/Repiteo/gists{/gist_id}","starred_url":"https://api.github.com/users/Repiteo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Repiteo/subscriptions","organizations_url":"https://api.github.com/users/Repiteo/orgs","repos_url":"https://api.github.com/users/Repiteo/repos","events_url":"https://api.github.com/users/Repiteo/events{/privacy}","received_events_url":"https://api.github.com/users/Repiteo/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/114224/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/godotengine/godot/issues/114224/timeline","performed_via_github_app":null,"state_reason":"completed","pinned_comment":null}