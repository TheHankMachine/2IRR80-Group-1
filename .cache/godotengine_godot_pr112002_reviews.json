[{"id":4259126959,"node_id":"PRR_kwDOAO6SJc793R6v","user":{"login":"rburing","id":229837,"node_id":"MDQ6VXNlcjIyOTgzNw==","avatar_url":"https://avatars.githubusercontent.com/u/229837?u=380bea11a30c8cb9a25651d120a4a85904ced8e3&v=4","gravatar_id":"","url":"https://api.github.com/users/rburing","html_url":"https://github.com/rburing","followers_url":"https://api.github.com/users/rburing/followers","following_url":"https://api.github.com/users/rburing/following{/other_user}","gists_url":"https://api.github.com/users/rburing/gists{/gist_id}","starred_url":"https://api.github.com/users/rburing/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/rburing/subscriptions","organizations_url":"https://api.github.com/users/rburing/orgs","repos_url":"https://api.github.com/users/rburing/repos","events_url":"https://api.github.com/users/rburing/events{/privacy}","received_events_url":"https://api.github.com/users/rburing/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"This is useful and follows a pattern (see e.g. `get_rid` on `Joint2D` and `Joint3D`) in the physics API where we allow access to the physics objects on the physics server level, to give power users (e.g. users of custom physics engines with features beyond those exposed by Godot) more control.\n\nDoes not need to be applied to 2D (in the current state) since `PhysicalBone2D` works a bit differently (it already has a `get_joint` method that returns a `Joint2D` node).\n\nLastly, note also `PhysicalBoneSimulator3D` exists for ragdoll functionality.","state":"APPROVED","html_url":"https://github.com/godotengine/godot/pull/112002#pullrequestreview-4259126959","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/112002","author_association":"MEMBER","_links":{"html":{"href":"https://github.com/godotengine/godot/pull/112002#pullrequestreview-4259126959"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/112002"}},"submi