 to English and override the subtitles domain to use German.\r\n\r\nThe changes are split across multiple commits for easier review.\r\n\r\nCloses: https://github.com/godotengine/godot-proposals/issues/11610\nCloses: https://github.com/godotengine/godot-proposals/issues/6254","closed_by":{"login":"MrJustreborn","id":11594586,"node_id":"MDQ6VXNlcjExNTk0NTg2","avatar_url":"https://avatars.githubusercontent.com/u/11594586?v=4","gravatar_id":"","url":"https://api.github.com/users/MrJustreborn","html_url":"https://github.com/MrJustreborn","followers_url":"https://api.github.com/users/MrJustreborn/followers","following_url":"https://api.github.com/users/MrJustreborn/following{/other_user}","gists_url":"https://api.github.com/users/MrJustreborn/gists{/gist_id}","starred_url":"https://api.github.com/users/MrJustreborn/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/MrJustreborn/subscriptions","organizations_url":"https://api.github.com/users/MrJustreborn/orgs","repos_url":"https://api.github.com/users/MrJustreborn/repos","events_url":"https://api.github.com/users/MrJustreborn/events{/privacy}","received_events_url":"https://api.github.com/users/MrJustreborn/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/107503/reactions","total_count":5,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":5,"eyes":0},"timeline_url":"https://api.github.com/repos/godotengine/godot/issues/107503/timeline","performed_via_github_app":null,"state_reason":null}