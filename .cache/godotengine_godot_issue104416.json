ed_by":null},{"id":410064485,"node_id":"MDU6TGFiZWw0MTAwNjQ0ODU=","url":"https://api.github.com/repos/godotengine/godot/labels/needs%20testing","name":"needs testing","color":"ffcc44","default":false,"description":"","archived_at":null,"archived_by":null}],"state":"open","locked":false,"assignees":[],"milestone":null,"comments":1,"created_at":"2025-03-20T23:10:24Z","updated_at":"2025-07-11T21:20:56Z","closed_at":null,"assignee":null,"author_association":"CONTRIBUTOR","issue_field_values":[],"type":null,"active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"### Tested versions\n\n4.4 stable\n\n### System information\n\nWindows 10\n\n### Issue description\n\nDebug controls in the embedded window no longer work when a project-wide custom theme is applied that overrides button style with a script extending StyleBoxFlat.\n\n### Steps to reproduce\n\nExtend the StyleBoxFlat class\n```\n@tool\nclass_name StyleBoxBroken\nextends StyleBoxFlat\n\n@export var broken := true\n```\nIt must have at least one export variable.\n\nCreate a theme, set that theme to project default and restart.\nIn the theme editor, override the button control normal panel to StyleBoxBroken\n\nRun the game and try the embedded debug controls, they no longer work.\n\nComment out the line `@export var broken := true` in the StyleBoxBroken class.\n\nRun the game and see that the embedded controls work normally.\n\n### Minimal reproduction project (MRP)\n\n[mrp-default-theme.zip](https://github.com/user-attachments/files/19376813/mrp-default-theme.zip)\n\n![Image](https://github.com/user-attachments/assets/1c451d9e-c975-4561-8b3c-d590430afe7e)","closed_by":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/104416/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"