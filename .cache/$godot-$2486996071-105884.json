at":"0001-01-01T00:00:00Z","followers":0,"following":0,"html_url":"https://github.com/KoBeWi","id":2223172,"node_id":"MDQ6VXNlcjIyMjMxNzI=","login":"KoBeWi","type":"User","owned_private_repos":0,"public_gists":0,"public_repos":0,"total_private_repos":0,"url":"https://api.github.com/users/KoBeWi"},"body":"","html_url":"https://github.com/godotengine/godot/pull/105884#pullrequestreview-2815170381","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/105884","author_association":"MEMBER","submitted_at":"2025-05-05T15:14:09Z"},{"id":2815175460,"node_id":"PRR_kwDOAO6SJc6nzCsk","state":"COMMENTED","user":{"site_admin":false,"suspended":false,"updated_at":"0001-01-01T00:00:00Z","avatar_url":"https://avatars.githubusercontent.com/u/2223172?u=fc85633b469acb6e7baef4dba5171f19a2a4ff85&v=4","created_at":"0001-01-01T00:00:00Z","followers":0,"following":0,"html_url":"https://github.com/KoBeWi","id":2223172,"node_id":"MDQ6VXNlcjIyMjMxNzI=","login":"KoBeWi","type":"User","owned_private_repos":0,"public_gists":0,"public_repos":0,"total_private_repos":0,"url":"https://api.github.com/users/KoBeWi"},"body":"","html_url":"https://github.com/godotengine/godot/pull/105884#pullrequestreview-2815175460","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/105884","author_association":"MEMBER","submitted_at":"2025-05-05T15:16:09Z"},{"id":2815211745,"node_id":"PRR_kwDOAO6SJc6nzLjh","state":"COMMENTED","user":{"site_admin":false,"suspended":false,"updated_at":"0001-01-01T00:00:00Z","avatar_url":"https://avatars.githubusercontent.com/u/2223172?u=fc85633b469acb6e7baef4dba5171f19a2a4ff85&v=4","created_at":"0001-01-01T00:00:00Z","followers":0,"following":0,"html_url":"https://github.com/KoBeWi","id":2223172,"node_id":"MDQ6VXNlcjIyMjMxNzI=","login":"KoBeWi","type":"User","owned_private_repos":0,"public_gists":0,"public_repos":0,"total_private_repos":0,"url":"https://api.github.com/users/KoBeWi"},"body":"","html_url":"https://github.com/godotengine/godot/pull/105884#pullrequestreview-2815211745","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/105884","author_association":"MEMBER","submitted_at":"2025-05-05T15:29:47Z"},{"id":2815228811,"node_id":"PRR_kwDOAO6SJc6nzPuL","state":"COMMENTED","user":{"site_admin":false,"suspended":false,"updated_at":"0001-01-01T00:00:00Z","avatar_url":"https://avatars.githubusercontent.com/u/180032?u=68d23e7ee9cdf810da125e8510b72f845b9dccc8&v=4","created_at":"0001-01-01T00:00:00Z","followers":0,"following":0,"html_url":"https://github.com/Calinou","id":180032,"node_id":"MDQ6VXNlcjE4MDAzMg==","login":"Calinou","type":"User","owned_private_repos":0,"public_gists":0,"public_repos":0,"total_private_repos":0,"url":"https://api.github.com/users/Calinou"},"body":"Tested locally on macOS 15.4.1 (M4 Max), it mostly works as expected.\r\n\r\nI've tested all these scenarios:\r\n\r\n- Forward+, Mobile and Compatibility rendering methods.\r\n- Metal and MoltenVK drivers.\r\n- Floating and non-floating embed.\r\n- Single-window mode disabled and enabled.\r\n- Playing in multiple open editors at the same time.\r\n- Playing with the embedded window fully off-screen (input/audio still works).\r\n- Embed with fullscreen distraction-free editor and bottom panel hidden. Despite the embedded resolution being pretty high in this case (I'm using a 16\" MBP with Retina), it still manages to push out 120 FPS smoothly.\r\n- Keyboard, mouse and gamepad input (including vibration).\r\n\r\nI noticed some issues:\r\n\r\n- When single-window mode is enabled, I sometimes can't interact with the running game at all (even if I disable game window embedding). It's not frozen (it will re-render if I resize the window), but it doesn't react to mouse hover, keyboard/gamepad input and so on. I'm unsure on reproduction steps.\r\n\r\n- Closing the editor using <kbd>Ctrl + C</kbd> in the terminal won't always stop the running project (audio will keep playing). This seems especially common when in the above state where the game is no longer responsive to input.\r\n\r\n  - The game process can be killed using `htop` normally, without needing to use `SIGKILL`.\r\n\r\n- Clicking the X button to close the floating game window has no effect.\r\n\r\n- If you move the mouse cursor while the game is starting (and the mouse cursor is outside the editor window or floating window), captured mouse mode won't work. It will temporarily work again if you hold down a mouse button while moving the mouse. Keyboard input will still work though.\r\n\r\n- In Compatibility, using window embedding will break V-Sync (FPS will be uncapped).\r\n\r\n  - I noticed that with V-Sync enabled, I frequently get stuttering and don't get a stable 120 FPS on a 120 Hz display, even though the CPU/GPU is nowhere near being fully utilized (I get 700 FPS when uncapped).\r\n\r\n- When using Metal in Truck Town (Forward+/Mobile), the sky takes the background color of the game window (you can see a thin border around buildings with the actual sky color when MSAA is enabled):\r\n\r\n<img width=\"626\" alt=\"Screenshot 2025-05-05 at 17 06 34\" src=\"https://github.com/user-attachments/assets/9dc776b4-1669-4d28-87c5-2410b132ffea\" />\r\n\r\nParticles (and other transparent materials) will also reveal the sky:\r\n\r\n<img width=\"750\" alt=\"Screenshot 2025-05-05 at 17 20 13\" src=\"https://github.com/user-attachments/assets/1e175ba3-1466-4885-a146-7b9ba13fba47\" />\r\n\r\nYou can see the editor appearing behind too (and even interact with it) if you open the project settings while the project is running:\r\n\r\n<img width=\"1147\" alt=\"Screenshot 2025-05-05 at 17 20 53\" src=\"https://github.com/user-attachments/assets/9a1a8c61-602e-4316-920b-af5d8556924a\" />\r\n\r\nThis issue disappears while the window is going into fullscreen mode (or away from fullscreen mode) until the transition is done. MoltenVK is not affected; Compatibility isn't affected either. The sky renders correctly in the editor, or when game window embedding is disabled.\r\n\r\n- I noticed the CLI arguments used by the embedded process are `--display-driver embedded --embedded`. Can `--embedded` imply `--display-driver embedded` so you don't need to use both? We do this for `--headless` already, which is essentially an alias for `--display-driver headless --audio-driver Dummy`.","html_url":"https://github.com/godotengine/godot/pull/105884#pullrequestreview-2815228811","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/105884","author_association":"MEMBER","submitted_at":"2025-05-05T15:36:11Z"},{"id":2815255670,"node_id":"PRR_kwDOAO6SJc6nzWR2","state":"COMMENTED","user":{"site_admin":false,"suspended":false,"updated_at":"0001-01-01T00:00:00Z","avatar_url":"https://avatars.githubusercontent.com/u/180032?u=68d23e7ee9cdf810da125e8510b72f845b9dccc8&v=4","created_at":"0001-01-01T00:00:00Z","followers":0,"following":0,"html_url":"https://github.com/Calinou","id":180032,"node_id":"MDQ6VXNlcjE4MDAzMg==","login":"Calinou","type":"User","owned_private_repos":0,"public_gists":0,"public_repos":0,"total_private_repos":0,"url":"https://api.github.com/users/Calinou"},"body":"","html_url":"https://github.com/godotengine/godot/pull/105884#pullrequestreview-2815255670","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/105884","author_association":"MEMBER","submitted_at":"2025-05-05T15:45:36Z"},{"id":2815219941,"node_id":"PRR_kwDOAO6SJc6nzNjl","state":"COMMENTED","user":{"site_admin":false,"suspended":false,"updated_at":"0001-01-01T00:00:00Z","avatar_url":"https://avatars.githubusercontent.com/u/96648715?u=af70f5d107e9c1447f296643d5a566dab53d25e8&v=4","created_at":"0001-01-01T00:00:00Z","followers":0,"following":0,"html_url":"https://github.com/AThousandShips","id":96648715,"node_id":"U_kgDOBcK-Cw","login":"AThousandShips","type":"User","owned_private_repos":0,"public_gists":0,"public_repos":0,"total_private_repos":0,"url":"https://api.github.com/users/AThousandShips"},"body":"","html