.com/repos/godotengine/godot/issues/105667","id":2824497989,"node_id":"IC_kwDOAO6SJc6oWmtF","user":{"login":"ydeltastar","id":133662278,"node_id":"U_kgDOB_eGRg","avatar_url":"https://avatars.githubusercontent.com/u/133662278?v=4","gravatar_id":"","url":"https://api.github.com/users/ydeltastar","html_url":"https://github.com/ydeltastar","followers_url":"https://api.github.com/users/ydeltastar/followers","following_url":"https://api.github.com/users/ydeltastar/following{/other_user}","gists_url":"https://api.github.com/users/ydeltastar/gists{/gist_id}","starred_url":"https://api.github.com/users/ydeltastar/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/ydeltastar/subscriptions","organizations_url":"https://api.github.com/users/ydeltastar/orgs","repos_url":"https://api.github.com/users/ydeltastar/repos","events_url":"https://api.github.com/users/ydeltastar/events{/privacy}","received_events_url":"https://api.github.com/users/ydeltastar/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-04-23T14:24:54Z","updated_at":"2025-04-23T14:26:40Z","body":"This is because variable values are restored after calling `_static_init()`. You can use `@static_unload` in the script to workaround it.","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2824497989/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2824591143","html_url":"https://github.com/godotengine/godot/issues/105667#issuecomment-2824591143","issue_url":"https://api.github.com/repos/godotengine/godot/issues/105667","id":2824591143,"node_id":"IC_kwDOAO6SJc6oW9cn","user":{"login":"dmlary","id":857742,"node_id":"MDQ6VXNlcjg1Nzc0Mg==","avatar_url":"https://avatars.githubusercontent.com/u/857742?v=4","gra