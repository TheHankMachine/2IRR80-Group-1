s://api.github.com/repos/godotengine/godot/issues/comments/3784602459/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3784622415","html_url":"https://github.com/godotengine/godot/pull/115264#issuecomment-3784622415","issue_url":"https://api.github.com/repos/godotengine/godot/issues/115264","id":3784622415,"node_id":"IC_kwDOAO6SJc7hlMFP","user":{"login":"taedixon","id":6359597,"node_id":"MDQ6VXNlcjYzNTk1OTc=","avatar_url":"https://avatars.githubusercontent.com/u/6359597?v=4","gravatar_id":"","url":"https://api.github.com/users/taedixon","html_url":"https://github.com/taedixon","followers_url":"https://api.github.com/users/taedixon/followers","following_url":"https://api.github.com/users/taedixon/following{/other_user}","gists_url":"https://api.github.com/users/taedixon/gists{/gist_id}","starred_url":"https://api.github.com/users/taedixon/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/taedixon/subscriptions","organizations_url":"https://api.github.com/users/taedixon/orgs","repos_url":"https://api.github.com/users/taedixon/repos","events_url":"https://api.github.com/users/taedixon/events{/privacy}","received_events_url":"https://api.github.com/users/taedixon/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-01-22T14:12:46Z","updated_at":"2026-01-22T14:12:46Z","body":"> That being said, I have checked, and it seems that locking a TileMapLayer only disables its selection. You can still edit a locked TileMapLayer. So well, I am not sure why you would need to toggle locking back and forth.\r\n\r\noh wow, I've been doing that because I assumed locking something meant you couldn't edit it at all. In that case it seems like there really is no need for this then. Sorry everyone!","author_association":"NONE","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3784622415/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3784653325","html_url":"https://github.com/godotengine/godot/pull/115264#issuecomment-3784653325","issue_url":"https://api.github.com/repos/godotengine/godot/issues/115264","id":3784653325,"node_id":"IC_kwDOAO6SJc7hlToN","user":{"login":"groud","id":6093119,"node_id":"MDQ6VXNlcjYwOTMxMTk=","avatar_url":"https://avatars.githubusercontent.com/u/6093119?v=4","gravatar_id":"","url":"https://api.github.com/users/groud","html_url":"https://github.com/groud","followers_url":"https://api.github.com/users/groud/followers","following_url":"https://api.github.com/users/groud/following{/other_user}","gists_url":"https://api.github.com/users/groud/gists{/gist_id}","starred_url":"https://api.github.com/users/groud/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/groud/subscriptions","organizations_url":"https://api.github.com/users/groud/orgs","repos_url":"https://api.github.com/users/groud/repos","events_url":"https://api.github.com/users/groud/events{/privacy}","received_events_url":"https://api.github.com/users/groud/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-01-22T14:22:19Z","updated_at":"2026-01-22T14:22:19Z","body":"> oh wow, I've been doing that because I assumed locking something meant you couldn't edit it at all. In that case it seems like there really is no need for this then. Sorry everyone!\r\n\r\nYeah, the fact I had to check is not a good sign this behavior was obvious. We should probably verify this is consistent (that no editor prevent editing locked nodes), and maybe consider if would make sense to make it clearer it's only making nodes unselectable (maybe with a change to the icon or something ?) .","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3784653325/reactions","total_count":2,"+1":2,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null}]