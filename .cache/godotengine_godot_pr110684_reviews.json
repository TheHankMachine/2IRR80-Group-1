[{"id":3244843453,"node_id":"PRR_kwDOAO6SJc7BaGG9","user":{"login":"Calinou","id":180032,"node_id":"MDQ6VXNlcjE4MDAzMg==","avatar_url":"https://avatars.githubusercontent.com/u/180032?u=68d23e7ee9cdf810da125e8510b72f845b9dccc8&v=4","gravatar_id":"","url":"https://api.github.com/users/Calinou","html_url":"https://github.com/Calinou","followers_url":"https://api.github.com/users/Calinou/followers","following_url":"https://api.github.com/users/Calinou/following{/other_user}","gists_url":"https://api.github.com/users/Calinou/gists{/gist_id}","starred_url":"https://api.github.com/users/Calinou/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Calinou/subscriptions","organizations_url":"https://api.github.com/users/Calinou/orgs","repos_url":"https://api.github.com/users/Calinou/repos","events_url":"https://api.github.com/users/Calinou/events{/privacy}","received_events_url":"https://api.github.com/users/Calinou/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"Using `RS::get_singleton()->is_low_end()` will change the created code depending on the current rendering driver, which means that if you convert a BaseMaterial3D to a ShaderMaterial while using Compatibility, it will break on Forward+/Mobile and vice versa. This is an issue if you switch rendering methods during development, or even if an automatic fallback is applied on the user's device.\r\n\r\nWe should use the shader preprocessor instead, but it's currently broken when used in BaseMaterial3D (as I mentioned in https://github.com/godotengine/godot/issues/87486#issuecomment-2663688834).","state":"COMMENTED","html_url":"https://github.com/godotengine/godot/pull/110684#pullrequestreview-3244843453","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/110684","author_association":"MEMBER","_links":{"html":{"href":"https://github.com/godotengine/godot/pull/110684#pullrequestreview-3244843453"},"pull_request":{"href":"https://api.github.com/