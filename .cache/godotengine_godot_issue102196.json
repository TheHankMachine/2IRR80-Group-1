n":"","archived_at":null,"archived_by":null},{"id":283518733,"node_id":"MDU6TGFiZWwyODM1MTg3MzM=","url":"https://api.github.com/repos/godotengine/godot/labels/usability","name":"usability","color":"447744","default":false,"description":"","archived_at":null,"archived_by":null}],"state":"closed","locked":false,"assignees":[],"milestone":{"url":"https://api.github.com/repos/godotengine/godot/milestones/20","html_url":"https://github.com/godotengine/godot/milestone/20","labels_url":"https://api.github.com/repos/godotengine/godot/milestones/20/labels","id":10558797,"node_id":"MI_kwDOAO6SJc4AoR1N","number":20,"title":"4.4","description":"","creator":{"login":"akien-mga","id":4701338,"node_id":"MDQ6VXNlcjQ3MDEzMzg=","avatar_url":"https://avatars.githubusercontent.com/u/4701338?v=4","gravatar_id":"","url":"https://api.github.com/users/akien-mga","html_url":"https://github.com/akien-mga","followers_url":"https://api.github.com/users/akien-mga/followers","following_url":"https://api.github.com/users/akien-mga/following{/other_user}","gists_url":"https://api.github.com/users/akien-mga/gists{/gist_id}","starred_url":"https://api.github.com/users/akien-mga/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/akien-mga/subscriptions","organizations_url":"https://api.github.com/users/akien-mga/orgs","repos_url":"https://api.github.com/users/akien-mga/repos","events_url":"https://api.github.com/users/akien-mga/events{/privacy}","received_events_url":"https://api.github.com/users/akien-mga/received_events","type":"User","user_view_type":"public","site_admin":false},"open_issues":8,"closed_issues":4466,"state":"closed","created_at":"2024-02-14T11:52:07Z","updated_at":"2026-10-05T23:48:31Z","due_on":"2025-03-03T00:00:00Z","closed_at":"2025-03-19T09:35:35Z"},"comments":4,"created_at":"2025-01-30T17:10:21Z","updated_at":"2025-01-31T18:45:40Z","closed_at":"2025-01-31T15:19:18Z","assignee":null,"author_association":"MEMBER","issue_field_values":[],"type":null,"active_lock_reason":null,"draft":false,"pull_request":{"url":"https://api.github.com/repos/godotengine/godot/pulls/102196","html_url":"https://github.com/godotengine/godot/pull/102196","diff_url":"https://github.com/godotengine/godot/pull/102196.diff","patch_url":"https://github.com/godotengine/godot/pull/102196.patch","merged_at":"2025-01-31T15:19:18Z"},"body":"- This reverts commit df01daf3b782c2b75537557ad00d564127111ff1 - #97860.\r\n\r\nUser feedback has shown that this change isn't always a clear improvement, because:\r\n1. The icon eats up horizontal space that's already limited here, cutting the text or previews significantly.\r\n2. The \"Load\" functionality was completely removed, while it's still useful for many.\r\n3. It breaks user expectations to no longer have load options next to Clear/Save/etc.\r\n\r\nInstead of reverting, we could solve (2) easily with a PR like https://github.com/godotengine/godot/pull/101244, which is an option to consider. (3) is not too bad and users can likely be fine when they understand the new workflow. But (1) seems to be a significant issue to me as seen in https://github.com/godotengine/godot/pull/97860#issuecomment-2599105410\r\n\r\n![image](https://github.com/user-attachments/assets/c321a8d7-f556-4eba-ba69-fa9fe0435523)\r\n\r\nSo given the current timing for 4.4, I suggest we revert for now, and revisit this feature for 4.5. I've also seen positive feedback about the Quick Load button, so we might want to look for ways to bring it back in a way that doesn't clutter the Inspector as much (while keeping the Quick Load and Load PopupMenu entries still). But that requires design work and UX testing that we won't have time to do for 4.4, so it's for 4.5.\r\n\r\n- Supersedes https://github.com/godotengine/godot/pull/101244\r\n- Fixes https://github.com/godotengine/godot/pull/101183\r\n- Closes https://github.com/godotengine/godot-proposals/issues/11508\r\n- Reopens https://github.com/godotengine/godot-proposals/issues/10910","closed_by":{"login":"Repiteo","id":17489292,"node_id":"MDQ6VXNlcjE3NDg5Mjky","avatar_url":"https://avatars.githubusercontent.com/u/17489292?v=4","gravatar_id":"","url":"https://api.github.com/users/Repiteo","html_url":"https://github.com/Repiteo","followers_url":"https://api.github.com/users/Repiteo/followers","following_url":"https://api.github.com/users/Repiteo/following{/other_user}","gists_url":"https://api.github.com/users/Repiteo/gists{/gist_id}","starred_url":"https://api.github.com/users/Repiteo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Repiteo/subscriptions","organizations_url":"https://api.github.com/users/Repiteo/orgs","repos_url":"https://api.github.com/users/Repiteo/repos","events_url":"https://api.github.com/users/Repiteo/events{/privacy}","received_events_url":"https://api.github.com/users/Repiteo/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/102196/reactions","total_count":13,"+1":9,"-1":1,"laugh":0,"hooray":0,"confused":3,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/godotengine/godot/issues/102196/timeline","performed_via_github_app":null,"state_reason":null}