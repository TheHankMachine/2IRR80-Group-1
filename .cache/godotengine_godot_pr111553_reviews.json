[{"id":3328727049,"node_id":"PRR_kwDOAO6SJc7GaFgJ","user":{"login":"kisg","id":406832,"node_id":"MDQ6VXNlcjQwNjgzMg==","avatar_url":"https://avatars.githubusercontent.com/u/406832?v=4","gravatar_id":"","url":"https://api.github.com/users/kisg","html_url":"https://github.com/kisg","followers_url":"https://api.github.com/users/kisg/followers","following_url":"https://api.github.com/users/kisg/following{/other_user}","gists_url":"https://api.github.com/users/kisg/gists{/gist_id}","starred_url":"https://api.github.com/users/kisg/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/kisg/subscriptions","organizations_url":"https://api.github.com/users/kisg/orgs","repos_url":"https://api.github.com/users/kisg/repos","events_url":"https://api.github.com/users/kisg/events{/privacy}","received_events_url":"https://api.github.com/users/kisg/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"As discussed in #90510 , the GDObjectInstanceID typedef should be used instead of the raw uint64_t.\r\n\r\nOtherwise I agree with the changes.","state":"CHANGES_REQUESTED","html_url":"https://github.com/godotengine/godot/pull/111553#pullrequestreview-3328727049","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/111553","author_association":"CONTRIBUTOR","_links":{"html":{"href":"https://github.com/godotengine/godot/pull/111553#pullrequestreview-3328727049"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/111553"}},"submitted_at":"2025-10-12T14:28:32Z","commit_id":null},{"id":3332717657,"node_id":"PRR_kwDOAO6SJc7GpTxZ","user":{"login":"dsnopek","id":191561,"node_id":"MDQ6VXNlcjE5MTU2MQ==","avatar_url":"https://avatars.githubusercontent.com/u/191561?v=4","gravatar_id":"","url":"https://api.github.com/users/dsnopek","html_url":"https://github.com/dsnopek","followers_url":"https://api.github.com/users/dsnopek/followers","following_url":"https://api.github.com/users/dsnopek/following{/other_user}","gists_url":"https://api.github.com/users/dsnopek/gists{/gist_id}","starred_url":"https://api.github.com/users/dsnopek/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/dsnopek/subscriptions","organizations_url":"https://api.github.com/users/dsnopek/orgs","repos_url":"https://api.github.com/users/dsnopek/repos","events_url":"https://api.github.com/users/dsnopek/events{/privacy}","received_events_url":"https://api.github.com/users/dsnopek/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"I think using object IDs would be fine. However, I don't fully understand why this is preferable to object pointers?\r\n\r\nWouldn't most callers of this API just immediately call `object_get_instance_from_id()` to get the object pointer?\r\n\r\nAnd, by the same token, couldn't we leave these functions returning `GDExtensionObjectPtr`, and, if the caller needed an object ID instead, couldn't it immediately call `object_get_instance_id()`?\r\n\r\nUnless we think it's more common for callers to want object IDs rather than pointers? However, my instinct is that most would want the pointer, especially if we add more methods to `GodotInstance` to allow configuring Godot before fully starting.","state":"COMMENTED","html_url":"https://github.com/godotengine/godot/pull/111553#pullrequestreview-3332717657","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/111553","author_association":"CONTRIBUTOR","_links":{"html":{"href":"https://github.com/godotengine/godot/pull/111553#pullrequestreview-3332717657"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/111553"}},"submitted_at":"2025-10-13T19:03:56Z","commit_id":"c49bc79ff39c2b9f4757c1d10c6f716877c0156e"}]