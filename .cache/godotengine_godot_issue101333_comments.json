[{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2584755445","html_url":"https://github.com/godotengine/godot/issues/101333#issuecomment-2584755445","issue_url":"https://api.github.com/repos/godotengine/godot/issues/101333","id":2584755445,"node_id":"IC_kwDOAO6SJc6aEDz1","user":{"login":"permelin","id":36154,"node_id":"MDQ6VXNlcjM2MTU0","avatar_url":"https://avatars.githubusercontent.com/u/36154?v=4","gravatar_id":"","url":"https://api.github.com/users/permelin","html_url":"https://github.com/permelin","followers_url":"https://api.github.com/users/permelin/followers","following_url":"https://api.github.com/users/permelin/following{/other_user}","gists_url":"https://api.github.com/users/permelin/gists{/gist_id}","starred_url":"https://api.github.com/users/permelin/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/permelin/subscriptions","organizations_url":"https://api.github.com/users/permelin/orgs","repos_url":"https://api.github.com/users/permelin/repos","events_url":"https://api.github.com/users/permelin/events{/privacy}","received_events_url":"https://api.github.com/users/permelin/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-01-10T23:15:37Z","updated_at":"2025-01-10T23:15:37Z","body":"Particles will only be created at most once per frame. So they will clump up if they are emitted faster than the current frame rate (which they are in your MRP).\n\nIn the `GPUParticles3D` node, set `Fixed FPS` to zero to uncap it. That should make it look better. How much better depends on the frame rate of your monitor.\n","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2584755445/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2585308796","html_url":"https://github.com/godotengine/godot/issues/101333#issuecomment-2585308796","issue_url":"https://api.github.com/repos/godotengine/godot/issues/101333","id":2585308796,"node_id":"IC_kwDOAO6SJc6aGK58","user":{"login":"blackears","id":6724608,"node_id":"MDQ6VXNlcjY3MjQ2MDg=","avatar_url":"https://avatars.githubusercontent.com/u/6724608?v=4","gravatar_id":"","url":"https://api.github.com/users/blackears","html_url":"https://github.com/blackears","followers_url":"https://api.github.com/users/blackears/followers","following_url":"https://api.github.com/users/blackears/following{/other_user}","gists_url":"https://api.github.com/users/blackears/gists{/gist_id}","starred_url":"https://api.github.com/users/blackears/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/blackears/subscriptions","organizations_url":"https://api.github.com/users/blackears/orgs","repos_url":"https://api.github.com/users/blackears/repos","events_url":"https://api.github.com/users/blackears/events{/privacy}","received_events_url":"https://api.github.com/users/blackears/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-01-11T15:49:19Z","updated_at":"2025-01-11T16:38:38Z","body":"Setting Fixed FPS to 0 helps, but there is still obvious grouping up.  Would it be possible to have the particles pre calculate the first frame so that some of them start already on their way so that they are spread out more naturally, even if several are emitted in a single frame?\n\nMy game is running at about 50 fps and the trail is visibly broken.","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2585308796/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2585329336","html_url":"https://github.com/godotengine/godot/issues/101333#issuecomment-2585329336","issue_url":"https://api.github.com/repos/godotengine/godot/issues/101333","id":2585329336,"node_id":"IC_kwDOAO6SJc6aGP64","user":{"login":"Calinou","id":180032,"node_id":"MDQ6VXNlcjE4MDAzMg==","avatar_url":"https://avatars.githubusercontent.com/u/180032?v=4","gravatar_id":"","url":"https://api.github.com/users/Calinou","html_url":"https://github.com/Calinou","followers_url":"https://api.github.com/users/Calinou/followers","following_url":"https://api.github.com/users/Calinou/following{/other_user}","gists_url":"https://api.github.com/users/Calinou/gists{/gist_id}","starred_url":"https://api.github.com/users/Calinou/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Calinou/subscriptions","organizations_url":"https://api.github.com/users/Calinou/orgs","repos_url":"https://api.github.com/users/Calinou/repos","events_url":"https://api.github.com/users/Calinou/events{/privacy}","received_events_url":"https://api.github.com/users/Calinou/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-01-11T16:41:58Z","updated_at":"2025-01-11T16:45:06Z","body":"Thanks for the proposal! Consolidating in https://github.com/godotengine/godot-proposals/issues/8088.\n\nSee also the workaround I mentioned here: https://github.com/godotengine/godot/issues/47973#issuecomment-821862214\nYou can also try the example project linked in the proposal above.\n\nThat said, for the use case you're going for, I would probably go for trails. It should be much more efficient than clumping 800 particles very close to each other, causing a *lot* of overdraw to occur (which is slow).","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2585329336/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null}]