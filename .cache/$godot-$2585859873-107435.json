Q6VXNlcjMxMDY1ODA4","login":"deralmas","type":"User","owned_private_repos":0,"public_gists":0,"public_repos":0,"total_private_repos":0,"url":"https://api.github.com/users/deralmas"},"body":"","html_url":"https://github.com/godotengine/godot/pull/107435#pullrequestreview-3483787401","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/107435","author_association":"MEMBER","submitted_at":"2025-11-19T16:48:45Z"},{"id":3483794654,"node_id":"PRR_kwDOAO6SJc7Ppnze","state":"COMMENTED","user":{"site_admin":false,"suspended":false,"updated_at":"0001-01-01T00:00:00Z","avatar_url":"https://avatars.githubusercontent.com/u/31065808?v=4","created_at":"0001-01-01T00:00:00Z","followers":0,"following":0,"html_url":"https://github.com/deralmas","id":31065808,"node_id":"MDQ6VXNlcjMxMDY1ODA4","login":"deralmas","type":"User","owned_private_repos":0,"public_gists":0,"public_repos":0,"total_private_repos":0,"url":"https://api.github.com/users/deralmas"},"body":"","html_url":"https://github.com/godotengine/godot/pull/107435#pullrequestreview-3483794654","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/107435","author_association":"MEMBER","submitted_at":"2025-11-19T16:50:23Z"},{"id":3484298175,"node_id":"PRR_kwDOAO6SJc7Priu_","state":"COMMENTED","user":{"site_admin":false,"suspended":false,"updated_at":"0001-01-01T00:00:00Z","avatar_url":"https://avatars.githubusercontent.com/u/180032?u=68d23e7ee9cdf810da125e8510b72f845b9dccc8&v=4","created_at":"0001-01-01T00:00:00Z","followers":0,"following":0,"html_url":"https://github.com/Calinou","id":180032,"node_id":"MDQ6VXNlcjE4MDAzMg==","login":"Calinou","type":"User","owned_private_repos":0,"public_gists":0,"public_repos":0,"total_private_repos":0,"url":"https://api.github.com/users/Calinou"},"body":"Tested locally, it works as expected.\r\n\r\n```\r\nOperating System: Fedora Linux 43\r\nKDE Plasma Version: 6.5.2\r\nKDE Frameworks Version: 6.19.0\r\nQt Version: 6.10.0\r\nKernel Version: 6.17.7-300.fc43.x86_64 (64-bit)\r\nGraphics Platform: Wayland\r\n\r\nProcessors: 32 × AMD Ryzen 9 9950X3D 16-Core Processor\r\nMemory: 64 GiB of RAM (62.3 GiB usable)\r\nGraphics Processor: NVIDIA GeForce RTX 5090\r\nManufacturer: Micro-Star International Co., Ltd.\r\nProduct Name: MS-7E49\r\nSystem Version: 1.0\r\n```\r\n\r\n### Prefer Wayland disabled (= XWayland)\r\n\r\n*Notice the delay in resizing. Also, when alt-tabbing, the game window overlaps the newly focused application until you release the <kbd>Alt</kbd> key.*\r\n\r\n[Screencast_20251119_195058.webm](https://github.com/user-attachments/assets/0733a834-105c-42bb-9e5c-45a857855acd)\r\n\r\n### Prefer Wayland enabled (= this PR)\r\n\r\n*Neither of the issues mentioned above occur.*\r\n\r\n[Screencast_20251119_195220.webm](https://github.com/user-attachments/assets/9c00efd0-3449-4471-81e9-db1f6d94b5df)\r\n\r\nOne issue I noticed (and that didn't occur in XWayland) is that when I choose the 3D mode and override the game camera, I can't move the camera until I left-click inside the game window to ensure the game window gains focus (as indicated by the blue outline). (Right-clicking has no effect on focus, even if the blue outline is already visible, although it does allow freelook rotation to work.) This also occurs if I click/alt-tab away from the editor and back into it.\r\n\r\nIn XWayland, the window gains focus as soon as the mouse moves inside the window's bounds instead.\r\n\r\nI can't reproduce the sporadic crash when stopping the project, either by pressing <kbd>F8</kbd> or using the stop button in the editor (I've tried this around 20 times).","html_url":"https://github.com/godotengine/godot/pull/107435#pullrequestreview-3484298175","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/107435","author_association":"MEMBER","submitted_at":"2025-11-19T19:01:39Z"},{"id":3486669310,"node_id":"PRR_kwDOAO6SJc7P0ln-","state":"APPROVED","commit_id":"bbf65ae72fa2cb8158bf1a52b170e9ed6003597e","user":{"site_a