":"topic:gui","color":"ffee88","default":false,"description":"","archived_at":null,"archived_by":null}],"state":"closed","locked":false,"assignees":[],"milestone":{"url":"https://api.github.com/repos/godotengine/godot/milestones/25","html_url":"https://github.com/godotengine/godot/milestone/25","labels_url":"https://api.github.com/repos/godotengine/godot/milestones/25/labels","id":15520464,"node_id":"MI_kwDOAO6SJc4A7NLQ","number":25,"title":"4.8","description":"","creator":{"login":"Repiteo","id":17489292,"node_id":"MDQ6VXNlcjE3NDg5Mjky","avatar_url":"https://avatars.githubusercontent.com/u/17489292?v=4","gravatar_id":"","url":"https://api.github.com/users/Repiteo","html_url":"https://github.com/Repiteo","followers_url":"https://api.github.com/users/Repiteo/followers","following_url":"https://api.github.com/users/Repiteo/following{/other_user}","gists_url":"https://api.github.com/users/Repiteo/gists{/gist_id}","starred_url":"https://api.github.com/users/Repiteo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Repiteo/subscriptions","organizations_url":"https://api.github.com/users/Repiteo/orgs","repos_url":"https://api.github.com/users/Repiteo/repos","events_url":"https://api.github.com/users/Repiteo/events{/privacy}","received_events_url":"https://api.github.com/users/Repiteo/received_events","type":"User","user_view_type":"public","site_admin":false},"open_issues":345,"closed_issues":2336,"state":"open","created_at":"2026-04-13T15:59:35Z","updated_at":"2026-10-22T08:21:32Z","due_on":null,"closed_at":null},"comments":0,"created_at":"2025-02-18T13:54:48Z","updated_at":"2026-09-27T16:30:22Z","closed_at":"2026-09-27T16:30:22Z","assignee":null,"author_association":"NONE","issue_field_values":[],"type":null,"active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"### Tested versions\n\n- Reproducible in 4.0.4, 4.1.4, 4.2.2, 4.3 stable, and 4.4 beta 4\n\n### System information\n\nArch Linux\n\n### Issue description\n\nWhen a Control node is the root of a scene and has its anchor preset set to Top Left and it is instantiated in another Control node with its anchor preset overridden to Center Top or Center Right (may happen with other centers) and its X or Y position is the same as the center position, it will be fully centered on the anchors on that axis, rather than being where it was placed (having its axis meet the anchor X or Y position).\n\nThis also affects the saving of the scene, saving the scene and running it will cause the saved scene to have the Controls position centered on the axis which meets the anchor.\n\nWhen loading the MRP, you may need to manually change the child Control's position to be centered as it doesn't save properly.\n\n![Image](https://github.com/user-attachments/assets/38808777-95e0-4d4a-a634-7635dd9f4def)\n![Image](https://github.com/user-attachments/assets/bf765454-276a-4e3b-a14a-f4400b0e81c1)\n\n### Steps to reproduce\n\n- Create a Control scene with anchor preset Full Rect.\n- Instantiate or create a new Control scene with anchor preset Center Top.\n- Ensure the child scene has the anchor preset Top Left.\n- Move the instantiated child scene so that its X position is at the center of the root Control (576 with the default 1152x648).\n- Run the root control scene.\n\n### Minimal reproduction project (MRP)\n\n[control_layout.zip](https://github.com/user-attachments/files/18846118/control_layout.zip)","closed_by":{"login":"Repiteo","id":17489292,"node_id":"MDQ6VXNlcjE3NDg5Mjky","avatar_url":"https://avatars.githubusercontent.com/u/17489292?v=4","gravatar_id":"","url":"https://api.github.com/users/Repiteo","html_url":"https://github.com/Repiteo","followers_url":"https://api.github.com/users/Repiteo/followers","following_url":"https://api.github.com/users/Repiteo/following{/other_user}","gists_url":"https://api.github.com/users/Repiteo/gists{/gist_id}","starred_url":"https://api.github.com/users/Repiteo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Repiteo/subscriptions","organizations_url":"https://api.github.com/users/Repiteo/orgs","repos_url":"https://api.github.com/users/Repiteo/repos","events_url":"https://api.github.com/users/Repiteo/events{/privacy}","received_events_url":"https://api.github.com/users/Repiteo/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/102994/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/godotengine/godot/issues/102994/timeline","performed_via_github_app":null,"state_reason":"completed","pinned_comment":null}