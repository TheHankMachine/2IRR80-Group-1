avatars.githubusercontent.com/u/16503728?v=4","gravatar_id":"","url":"https://api.github.com/users/Barugon","html_url":"https://github.com/Barugon","followers_url":"https://api.github.com/users/Barugon/followers","following_url":"https://api.github.com/users/Barugon/following{/other_user}","gists_url":"https://api.github.com/users/Barugon/gists{/gist_id}","starred_url":"https://api.github.com/users/Barugon/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Barugon/subscriptions","organizations_url":"https://api.github.com/users/Barugon/orgs","repos_url":"https://api.github.com/users/Barugon/repos","events_url":"https://api.github.com/users/Barugon/events{/privacy}","received_events_url":"https://api.github.com/users/Barugon/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2024-12-05T15:35:43Z","updated_at":"2024-12-05T15:35:43Z","body":"> You need to request permission too.\n> See, https://docs.godotengine.org/en/stable/classes/class_os.html#class-os-method-request-permission\n\nWhat would I need to pass to this? I tried \"READ_EXTERNAL_STORAGE\" but that did nothing (and the return value is `false`). Also, I thought that shared storage was supposed to just be accessible without having to ask for permission now?","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2520648795/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2520676775","html_url":"https://github.com/godotengine/godot/issues/100034#issuecomment-2520676775","issue_url":"https://api.github.com/repos/godotengine/godot/issues/100034","id":2520676775,"node_id":"IC_kwDOAO6SJc6WPnmn","user":{"login":"syntaxerror247","id":176927541,"node_id":"U_kgDOCouzNQ","avatar_url":"https://avatars.githubusercontent.com/u/176927541?v=4","gravatar_id":"","url":"https://api.github.com/users/syntaxerror247","html_url":"https://github.com/syntaxerror247","followers_url":"https://api.github.com/users/syntaxerror247/followers","following_url":"https://api.github.com/users/syntaxerror247/following{/other_user}","gists_url":"https://api.github.com/users/syntaxerror247/gists{/gist_id}","starred_url":"https://api.github.com/users/syntaxerror247/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/syntaxerror247/subscriptions","organizations_url":"https://api.github.com/users/syntaxerror247/orgs","repos_url":"https://api.github.com/users/syntaxerror247/repos","events_url":"https://api.github.com/users/syntaxerror247/events{/privacy}","received_events_url":"https://api.github.com/users/syntaxerror247/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2024-12-05T15:46:14Z","updated_at":"2024-12-05T15:46:14Z","body":"> > You need to request permission too.\n> > See, https://docs.godotengine.org/en/stable/classes/class_os.html#class-os-method-request-permission\n> \n> What would I need to pass to this? I tried \"READ_EXTERNAL_STORAGE\" but that did nothing (and the return value is `false`). Also, I thought that shared storage was supposed to just be accessible without having to ask for permission now?\n\nSorry, my bad. That is only used to request RECORD_AUDIO permission.\nuse `OS.request_permissions()` to request permissions you have checked in export settings. Normal permission are automatically granted like `Internet` but for permission like storage. You will have to use `OS.request_permissions()`.","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2520676775/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2520695062","html_url":"https://github.com/godotengine/godot/issues/100034#issuecomment-2520695062","issue_url":"https://api.github.com/repos/godotengine/godot/issues/100034","id":2520695062,"node_id":"IC_kwDOAO6SJc6WPsEW","user":{"login":"syntaxerror247","id":176927541,"node_id":"U_kgDOCouzNQ","avatar_url":"https://avatars.githubusercontent.com/u/176927541?v=4","gravatar_id":"","url":"https://api.github.com/users/syntaxerror247","html_url":"https://github.com/syntaxerror247","followers_url":"https://api.github.com/users/syntaxerror247/followers","following_url":"https://api.github.com/users/syntaxerror247/following{/other_user}","gists_url":"https://api.github.com/users/syntaxerror247/gists{/gist_id}","starred_url":"https://api.github.com/users/syntaxerror247/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/syntaxerror247/subscriptions","organizations_url":"https://api.github.com/users/syntaxerror247/orgs","repos_url":"https://api.github.com/users/syntaxerror247/repos","events_url":"https://api.github.com/users/syntaxerror247/events{/privacy}","received_events_url":"https://api.github.com/users/syntaxerror247/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2024-12-05T15:53:33Z","updated_at":"2024-12-05T16:28:41Z","body":"On Android 13+ READ_EXTERNAL_STORAGE has been replaced by granular permissions: READ_MEDIA_IMAGES, READ_MEDIA_VIDEO, and READ_MEDIA_AUDIO. These new permissions are available in 4.4.\n\nTo get full access use MANAGE_EXTERNAL_STORAGE (It is available in 4.3)\n\n> Also, I thought that shared storage was supposed to just be accessible without having to ask for permission now?\n\n@Barugon, Yes but only created by your app. For.eg. You can access files under `Pictures/` without explicit permission only if your app created those files. For other files, you will have to use permission.","author_association":"MEMBER","pin":null,"reactions":{"url":"https:/