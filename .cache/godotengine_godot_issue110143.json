/api.github.com/users/Repiteo/events{/privacy}","received_events_url":"https://api.github.com/users/Repiteo/received_events","type":"User","user_view_type":"public","site_admin":false},"open_issues":3,"closed_issues":2978,"state":"closed","created_at":"2025-05-22T16:25:52Z","updated_at":"2026-10-04T16:23:23Z","due_on":null,"closed_at":"2026-01-26T18:09:14Z"},"comments":3,"created_at":"2025-08-31T16:20:14Z","updated_at":"2025-09-23T08:03:14Z","closed_at":"2025-09-23T02:01:31Z","assignee":{"login":"bruvzg","id":7645683,"node_id":"MDQ6VXNlcjc2NDU2ODM=","avatar_url":"https://avatars.githubusercontent.com/u/7645683?v=4","gravatar_id":"","url":"https://api.github.com/users/bruvzg","html_url":"https://github.com/bruvzg","followers_url":"https://api.github.com/users/bruvzg/followers","following_url":"https://api.github.com/users/bruvzg/following{/other_user}","gists_url":"https://api.github.com/users/bruvzg/gists{/gist_id}","starred_url":"https://api.github.com/users/bruvzg/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/bruvzg/subscriptions","organizations_url":"https://api.github.com/users/bruvzg/orgs","repos_url":"https://api.github.com/users/bruvzg/repos","events_url":"https://api.github.com/users/bruvzg/events{/privacy}","received_events_url":"https://api.github.com/users/bruvzg/received_events","type":"User","user_view_type":"public","site_admin":false},"author_association":"CONTRIBUTOR","issue_field_values":[],"type":null,"active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"### Tested versions\n\nReproducible in 4.5beta7 and 4.5beta5.\n\n### System information\n\nMacOS and iOS (using #77951). Not tested on Windows\n\n### Issue description\n\nCertain system fallback emoji characters don't render correctly, but only with the `Inter` font family. This issue is only important because Inter is one of the most widely used open source fonts.\n\nI can't seem to reproduce this behavior with any other font. When using the default font import settings that have `allow_system_fallback` enabled, all fonts but Inter seem to render the complete MacOS emoji set. Inter on-the-other-hand, will fallback to placeholder emoji for certain glyphs, like the red heart. If I manually set the fallbacks to Apple Color Emoji, Inter will render more glyphs, but not all of them, still failing on red heart, which sadly is one of the most needed emojis. \"Warning\" ⚠️ also fails - which is also a composite character like red heart.\n\n<img width=\"1142\" height=\"639\" alt=\"Image\" src=\"https://github.com/user-attachments/assets/d41d459b-4ad8-4e02-a473-85c7bbc80bf0\" />\n\n\n\n### Steps to reproduce\n\nSee MRP.\n\n### Minimal reproduction project (MRP)\n\n[font-issues-testing.zip](https://github.com/user-attachments/files/22067390/font-issues-testing.zip)","closed_by":{"login":"Repiteo","id":17489292,"node_id":"MDQ6VXNlcjE3NDg5Mjky","avatar_url":"https://avatars.githubusercontent.com/u/17489292?v=4","gravatar_id":"","url":"https://api.github.com/users/Repiteo","html_url":"https://github.com/Repiteo","followers_url":"https://api.github.com/users/Repiteo/followers","following_url":"https://api.github.com/users/Repiteo/following{/other_user}","gists_url":"https://api.github.com/users/Repiteo/gists{/gist_id}","starred_url":"https://api.github.com/users/Repiteo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Repiteo/subscriptions","organizations_url":"https://api.github.com/users/Repiteo/orgs","repos_url":"https://api.github.com/users/Repiteo/repos","events_url":"https://api.github.com/users/Repiteo/events{/privacy}","received_events_url":"https://api.github.com/users/Repiteo/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/110143/reactions","total_count":0,"+1":0,"