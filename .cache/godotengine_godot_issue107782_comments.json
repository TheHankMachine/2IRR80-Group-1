[{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2992687394","html_url":"https://github.com/godotengine/godot/pull/107782#issuecomment-2992687394","issue_url":"https://api.github.com/repos/godotengine/godot/issues/107782","id":2992687394,"node_id":"IC_kwDOAO6SJc6yYMki","user":{"login":"allenwp","id":17506573,"node_id":"MDQ6VXNlcjE3NTA2NTcz","avatar_url":"https://avatars.githubusercontent.com/u/17506573?v=4","gravatar_id":"","url":"https://api.github.com/users/allenwp","html_url":"https://github.com/allenwp","followers_url":"https://api.github.com/users/allenwp/followers","following_url":"https://api.github.com/users/allenwp/following{/other_user}","gists_url":"https://api.github.com/users/allenwp/gists{/gist_id}","starred_url":"https://api.github.com/users/allenwp/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/allenwp/subscriptions","organizations_url":"https://api.github.com/users/allenwp/orgs","repos_url":"https://api.github.com/users/allenwp/repos","events_url":"https://api.github.com/users/allenwp/events{/privacy}","received_events_url":"https://api.github.com/users/allenwp/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-06-20T20:17:43Z","updated_at":"2025-06-20T20:17:43Z","body":"@beicause You [mentioned an idea](https://github.com/godotengine/godot/issues/107730#issuecomment-2989737022) about how to better address the color correction bug. Thanks for sharing this! Please feel free to share more details here or open a new PR that builds off this one with me as a co-contributor if you'd like.","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2992687394/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2992854695","html_url":"https://github.com/godotengine/godot/pull/107782#issuecomment-2992854695","issue_url":"https://api.github.com/repos/godotengine/godot/issues/107782","id":2992854695,"node_id":"IC_kwDOAO6SJc6yY1an","user":{"login":"beicause","id":75941842,"node_id":"MDQ6VXNlcjc1OTQxODQy","avatar_url":"https://avatars.githubusercontent.com/u/75941842?v=4","gravatar_id":"","url":"https://api.github.com/users/beicause","html_url":"https://github.com/beicause","followers_url":"https://api.github.com/users/beicause/followers","following_url":"https://api.github.com/users/beicause/following{/other_user}","gists_url":"https://api.github.com/users/beicause/gists{/gist_id}","starred_url":"https://api.github.com/users/beicause/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/beicause/subscriptions","organizations_url":"https://api.github.com/users/beicause/orgs","repos_url":"https://api.github.com/users/beicause/repos","events_url":"https://api.github.com/users/beicause/events{/privacy}","received_events_url":"https://api.github.com/users/beicause/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-06-20T21:03:42Z","updated_at":"2025-06-20T21:03:42Z","body":"Optimizes out one srgb->linear conversion by sampling sRGB texture:\r\n```diff\r\ndiff --git a/servers/rendering/renderer_rd/renderer_scene_render_rd.cpp b/servers/rendering/renderer_rd/renderer_scene_render_rd.cpp\r\nindex 2a037d241e..4d30f625ef 100644\r\n--- a/servers/rendering/renderer_rd/renderer_scene_render_rd.cpp\r\n+++ b/servers/rendering/renderer_rd/renderer_scene_render_rd.cpp\r\n@@ -665,6 +665,7 @@ void RendererSceneRenderRD::_render_buffers_post_process_and_tonemap(const Rende\r\n \t\ttonemap.use_color_correction = false;\r\n \t\ttonemap.use_1d_color_correction = false;\r\n \t\ttonemap.color_correction_texture = texture_storage->texture_rd_get_default(RendererRD::TextureStorage::DEFAULT_RD_TEXTURE_3D_WHITE);\r\n+\t\ttonemap.convert_to_srgb = !texture_storage->render_target_is_using_hdr(render_target);\r\n \r\n \t\tif (can_use_effects && p_render_data->environment.is_valid()) {\r\n \t\t\ttonemap.use_bcs = environment_get_adjustments_enabled(p_render_data->environment);\r\n@@ -674,15 +675,13 @@ void RendererSceneRenderRD::_render_buffers_post_process_and_tonemap(const Rende\r\n \t\t\tif (environment_get_adjustments_enabled(p_render_data->environment) && environment_get_color_correction(p_render_data->environment).is_valid()) {\r\n \t\t\t\ttonemap.use_color_correction = true;\r\n \t\t\t\ttonemap.use_1d_color_correction = environment_get_use_1d_color_correction(p_render_data->environment);\r\n-\t\t\t\ttonemap.color_correction_texture = texture_storage->texture_get_rd_texture(environment_get_color_correction(p_render_data->environment));\r\n+\t\t\t\ttonemap.color_correction_texture = texture_storage->texture_get_rd_texture(environment_get_color_correction(p_render_data->environment), !tonemap.convert_to_srgb);\r\n \t\t\t}\r\n \t\t}\r\n \r\n \t\ttonemap.luminance_multiplier = _render_buffers_get_luminance_multiplier();\r\n \t\ttonemap.view_count = rb->get_view_count();\r\n \r\n-\t\ttonemap.convert_to_srgb = !texture_storage->render_target_is_using_hdr(render_target);\r\n-\r\n \t\tRID dest_fb;\r\n \t\tif (spatial_upscaler != nullptr || use_smaa) {\r\n \t\t\t// If we use a spatial upscaler to upscale or SMAA to antialias we need to write our result into an intermediate buffer.\r\ndiff --git a/servers/rendering/renderer_rd/shaders/effects/tonemap.glsl b/servers/rendering/renderer_rd/shaders/effects/tonemap.glsl\r\nindex c4ae4cb8b0..84c4a0fca8 100644\r\n--- a/servers/rendering/renderer_rd/shaders/effects/tonemap.glsl\r\n+++ b/servers/rendering/renderer_rd/shaders/effects/tonemap.glsl\r\n@@ -911,9 +911,6 @@ void main() {\r\n \t\t\tcolor.rgb = linear_to_srgb(color.rgb);\r\n \t\t}\r\n \t\tcolor.rgb = apply_color_correction(color.rgb);\r\n-\t\tif (!convert_to_srgb) {\r\n-\t\t\tcolor.rgb = srgb_to_linear(color.rgb);\r\n-\t\t}\r\n \t}\r\n \r\n \tif (bool(params.flags & FLAG_USE_DEBANDING) && convert_to_srgb) {\r\n\r\n```","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2992854695/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2993073773","html_url":"https://github.com/godotengine/godot/pull/107782#issuecomment-2993073773","issue_url":"https://api.github.com/repos/godotengine/godot/issues/107782","id":2993073773,"node_id":"IC_kwDOAO6SJc6yZq5t","user":{"login":"allenwp","id":17506573,"node_id":"MDQ6VXNlcjE3NTA2NTcz","avatar_url":"https://avatars.githubusercontent.com/u/17506573?v=4","gravatar_id":"","url":"https://api.github.com/users/allenwp","html_url":"https://github.com/allenwp","followers_url":"https://api.github.com/users/allenwp/followers","following_url":"https://api.github.com/users/allenwp/following{/other_user}","gists_url":"https://api.github.com/users/allenwp/gists{/gist_id}","starred_url":"https://api.github.com/users/allenwp/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/allenwp/subscriptions","organizations_url":"https://api.github.com/users/allenwp/orgs","repos_url":"https://api.github.com/users/allenwp/repos","events_url":"https://api.github.com/users/allenwp/events{/privacy}","received_events_url":"https://api.github.com/users/allenwp/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-06-20T22:58:59Z","updated_at":"2025-06-20T22:58:59Z","body":"> Optimizes out one srgb->linear conversion by sampling sRGB texture:\r\n> ...\r\n\r\nThis seems to work well -- very clever! Thanks @beicause!","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2993073773/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2998195938","html_url":"https://github.com/godotengine/godot/pull/107782#issuecomment-2998195938","issue_url":"https://api.github.com/repos/godotengine/godot/issues/107782","id":2998195938,"node_id":"IC_kwDOAO6SJc6ytNbi","user":{"login":"allenwp","id":17506573,"node_id":"MDQ6VXNlcjE3NTA2NTcz","avatar_url":"https://avatars.githubusercontent.com/u/17506573?v=4","gravatar_id":"","url":"https://api.github.com/users/allenwp","html_url":"https://github.com/allenwp","followers_url":"https://api.github.com/users/allenwp/followers","following_url":"https://api.github.com/users/allenwp/following{/other_user}","gists_url":"https://api.github.com/users/allenwp/gists{/gist_id}","starred_url":"https://api.github.com/users/allenwp/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/allenwp/subscriptions","organizations_url":"https://api.github.com/users/allenwp/orgs","repos_url":"https://api.github.com/users/allenwp/repos","events_url":"https://api.github.com/users/allenwp/events{/privacy}","received_events_url":"https://api.github.com/users/allenwp/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-06-23T22:52:49Z","updated_at":"2025-06-23T22:52:49Z","body":"I've finished work on this, so it's now ready for review. (Sorry about the mistaken \"ready for review\" I made earlier!)","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2998195938/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2998523966","html_url":"https://github.com/godotengine/godot/pull/107782#issuecomment-2998523966","issue_url":"https://api.github.com/repos/godotengine/godot/issues/107782","id":2998523966,"node_id":"IC_kwDOAO6SJc6yudg-","user":{"login":"beicause","id":75941842,"node_id":"MDQ6VXNlcjc1OTQxODQy","avatar_url":"https://avatars.githubusercontent.com/u/75941842?v=4","gravatar_id":"","url":"https://api.github.com/users/beicause","html_url":"https://github.com/beicause","followers_url":"https://api.github.com/users/beicause/followers","following_url":"https://api.github.com/users/beicause/following{/other_user}","gists_url":"https://api.github.com/users/beicause/gists{/gist_id}","starred_url":"https://api.github.com/users/beicause/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/beicause/subscriptions","organizations_url":"https://api.github.com/users/beicause/orgs","repos_url":"https://api.github.com/users/beicause/repos","events_url":"https://api.github.com/users/beicause/events{/privacy}","received_events_url":"https://api.github.com/users/beicause/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-06-24T02:04:06Z","updated_at":"2025-06-24T02:04:06Z","body":"Debanding is a per-viewport setting. I don't know why it should change to a RendererCompositor setting here.\r\n\r\nI think debanding has nothing to do with color space. It can be performed in linear space as long as it's done before writing the results to a lower-precision buffer. See also #87350.","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2998523966/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2998573030","html_url":"https://github.com/godotengine/godot/pull/107782#issuecomment-2998573030","issue_url":"https://api.github.com/repos/godotengine/godot/issues/107782","id":2998573030,"node_id":"IC_kwDOAO6SJc6yupfm","user":{"login":"allenwp","id":17506573,"node_id":"MDQ6VXNlcjE3NTA2NTcz","avatar_url":"https://avatars.githubusercontent.com/u/17506573?v=4","gravatar_id":"","url":"https://api.github.com/users/allenwp","html_url":"https://github.com/allenwp","followers_url":"https://api.github.com/users/allenwp/followers","following_url":"https://api.github.com/users/allenwp/following{/other_user}","gists_url":"https://api.github.com/users/allenwp/gists{/gist_id}","starred_url":"https://api.github.com/users/allenwp/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/allenwp/subscriptions","organizations_url":"https://api.github.com/users/allenwp/orgs","repos_url":"https://api.github.com/users/allenwp/repos","events_url":"https://api.github.com/users/allenwp/events{/privacy}","received_events_url":"https://api.github.com/users/allenwp/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-06-24T02:37:08Z","updated_at":"2025-06-24T03:10:19Z","body":"Hmm, I hadn’t thought about how debanding is exposed to scripting as a property of `Viewport`. The current state of this PR makes that property do nothing when HDR 2D is enabled and also provides no method for changing the setting at runtime.\r\n\r\nI’m not sure exactly what to do about this, so let me know if you have thoughts on how to handle this scenario.\r\n\r\n> Debanding is a per-viewport setting. I don't know why it should change to a RendererCompositor setting here.\r\n> \r\n> I think debanding has nothing to do with color space. It can be performed in linear space as long as it's done before writing the results to a lower-precision buffer. See also #87350.\r\n\r\nI will take a look into #87350 and post on that PR if it exhibits the same issues as seen in #107730. The specific dither function that is used for debanding is designed to be applied to nonlinear encoded float values of the final encoding directly before quantization to an 8 bit buffer. Details about this and the consequences of applying it to an encoding that is different than the one used immediately before quantization (i.e. linear encoding) is described in #107730.\r\n\r\nThe specific dithering function that Godot uses cannot be used on linear values. If you want to use a debanding technique that works on linear encoded values, you need to use a different function such as the one presented by [Timothy Lottes in his GDC talk](https://gpuopen.com/download/GdcVdrLottes.pdf) (See part 3: transfer functions and quantization).","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2998573030/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2998732158","html_url":"https://github.com/godotengine/godot/pull/107782#issuecomment-2998732158","issue_url":"https://api.github.com/repos/godotengine/godot/issues/107782","id":2998732158,"node_id":"IC_kwDOAO6SJc6yvQV-","user":{"login":"beicause","id":75941842,"node_id":"MDQ6VXNlcjc1OTQxODQy","avatar_url":"https://avatars.githubusercontent.com/u/75941842?v=4","gravatar_id":"","url":"https://api.github.com/users/beicause","html_url":"https://github.com/beicause","followers_url":"https://api.github.com/users/beicause/followers","following_url":"https://api.github.com/users/beicause/following{/other_user}","gists_url":"https://api.github.com/users/beicause/gists{/gist_id}","starred_url":"https://api.github.com/users/beicause/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/beicause/subscriptions","organizations_url":"https://api.github.com/users/beicause/orgs","repos_url":"https://api.github.com/users/beicause/repos","events_url":"https://api.github.com/users/beicause/events{/privacy}","received_events_url":"https://api.github.com/users/beicause/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-06-24T04:07:06Z","updated_at":"2025-06-24T04:07:06Z","body":"#87350 uses the same debanding algorithm with the viewport debanding. But sky shader uses a different one: \r\n\r\n>https://github.com/godotengine/godot/blob/88b9932ce14412843538b5084d3563ed89dbb308/servers/rendering/renderer_rd/shaders/environment/sky.glsl#L139-L146\r\n\r\nI'm not sure if these algorithms works in linear space (dividing by 255.0 seems a bit magical), but it's worth taking a look.","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2998732158/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3001414299","html_url":"https://github.com/godotengine/godot/pull/107782#issuecomment-3001414299","issue_url":"https://api.github.com/repos/godotengine/godot/issues/107782","id":3001414299,"node_id":"IC_kwDOAO6SJc6y5fKb","user":{"login":"allenwp","id":17506573,"node_id":"MDQ6VXNlcjE3NTA2NTcz","avatar_url":"https://avatars.githubusercontent.com/u/17506573?v=4","gravatar_id":"","url":"https://api.github.com/users/allenwp","html_url":"https://github.com/allenwp","followers_url":"https://api.github.com/users/allenwp/followers","following_url":"https://api.github.com/users/allenwp/following{/other_user}","gists_url":"https://api.github.com/users/allenwp/gists{/gist_id}","starred_url":"https://api.github.com/users/allenwp/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/allenwp/subscriptions","organizations_url":"https://api.github.com/users/allenwp/orgs","repos_url":"https://api.github.com/users/allenwp/repos","events_url":"https://api.github.com/users/allenwp/events{/privacy}","received_events_url":"https://api.github.com/users/allenwp/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-06-24T18:02:14Z","updated_at":"2025-06-24T18:02:14Z","body":"> #87350 uses the same debanding algorithm with the viewport debanding. But sky shader uses a different one:\r\n> \r\n> > https://github.com/godotengine/godot/blob/88b9932ce14412843538b5084d3563ed89dbb308/servers/rendering/renderer_rd/shaders/environment/sky.glsl#L139-L146\r\n> \r\n> I'm not sure if these algorithms works in linear space (dividing by 255.0 seems a bit magical), but it's worth taking a look.\r\n\r\nThere's actually a PDF linked from the Godot docs that talks about what floating point encoding your dithering should be applied in with these sorts of dithering effects: https://loopit.dk/banding_in_games.pdf (see page 35 onward where it states **\"convert first, dither afterwards… dither in whatever space the color will be quantized in.\"**). I think it's easier to just read the dithering code to understand that it needs to be applied to nonlinear encoded values, but if anyone wants some \"literature\" on the subject, there it is.\r\n\r\nI will eventually look into the sky shader's debanding, but I noticed that the dithering is scaled by a `luminance_multiplier`, which may help reduce the problems associated with applying the dither to a linear encoding (maybe???). So this is probably best addressed in a different issue with a different PR that explores it in more depth.\r\n\r\nI also now realize there is quite a bit in the docs that needs updating with this PR as well. I'll continue to update it to address all these cases.","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3001414299/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3049428512","html_url":"https://github.com/godotengine/godot/pull/107782#issuecomment-3049428512","issue_url":"https://api.github.com/repos/godotengine/godot/issues/107782","id":3049428512,"node_id":"IC_kwDOAO6SJc61wpYg","user":{"login":"allenwp","id":17506573,"node_id":"MDQ6VXNlcjE3NTA2NTcz","avatar_url":"https://avatars.githubusercontent.com/u/17506573?v=4","gravatar_id":"","url":"https://api.github.com/users/allenwp","html_url":"https://github.com/allenwp","followers_url":"https://api.github.com/users/allenwp/followers","following_url":"https://api.github.com/users/allenwp/following{/other_user}","gists_url":"https://api.github.com/users/allenwp/gists{/gist_id}","starred_url":"https://api.github.com/users/allenwp/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/allenwp/subscriptions","organizations_url":"https://api.github.com/users/allenwp/orgs","repos_url":"https://api.github.com/users/allenwp/repos","events_url":"https://api.github.com/users/allenwp/events{/privacy}","received_events_url":"https://api.github.com/users/allenwp/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-07-08T15:35:02Z","updated_at":"2025-07-08T16:44:27Z","body":"> Debanding is a per-viewport setting. I don't know why it should change to a RendererCompositor setting here.\r\n\r\nI've fixed this so that debanding is still a property of the viewport and also always applied as the last step before 8-bit quantization.\r\n\r\nJust need to figure out how to add this to XR now...\r\n\r\nEdit: Hmm. It seems it would be better to store `use_debanding` in the `RenderTarget` alongside of `use_hdr`...","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3049428512/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3049876089","html_url":"https://github.com/godotengine/godot/pull/107782#issuecomment-3049876089","issue_url":"https://api.github.com/repos/godotengine/godot/issues/107782","id":3049876089,"node_id":"IC_kwDOAO6SJc61yWp5","user":{"login":"allenwp","id":17506573,"node_id":"MDQ6VXNlcjE3NTA2NTcz","avatar_url":"https://avatars.githubusercontent.com/u/17506573?v=4","gravatar_id":"","url":"https://api.github.com/users/allenwp","html_url":"https://github.com/allenwp","followers_url":"https://api.github.com/users/allenwp/followers","following_url":"https://api.github.com/users/allenwp/following{/other_user}","gists_url":"https://api.github.com/users/allenwp/gists{/gist_id}","starred_url":"https://api.github.com/users/allenwp/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/allenwp/subscriptions","organizations_url":"https://api.github.com/users/allenwp/orgs","repos_url":"https://api.github.com/users/allenwp/repos","events_url":"https://api.github.com/users/allenwp/events{/privacy}","received_events_url":"https://api.github.com/users/allenwp/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-07-08T18:15:24Z","updated_at":"2025-07-08T18:15:24Z","body":"OK, I've moved `use_debanding` to be a part of `RenderTarget`, just like `use_hdr`... so... I think this means the debanding will be correctly applied in XR scenarios as well(?) Please let me know if you can find any places where debanding may not be correctly applied or where other transformations may happen between debanding and quantization.","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3049876089/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3063467548","html_url":"https://github.com/godotengine/godot/pull/107782#issuecomment-3063467548","issue_url":"https://api.github.com/repos/godotengine/godot/issues/107782","id":3063467548,"node_id":"IC_kwDOAO6SJc62mM4c","user":{"login":"allenwp","id":17506573,"node_id":"MDQ6VXNlcjE3NTA2NTcz","avatar_url":"https://avatars.githubusercontent.com/u/17506573?v=4","gravatar_id":"","url":"https://api.github.com/users/allenwp","html_url":"https://github.com/allenwp","followers_url":"https://api.github.com/users/allenwp/followers","following_url":"https://api.github.com/users/allenwp/following{/other_user}","gists_url":"https://api.github.com/users/allenwp/gists{/gist_id}","starred_url":"https://api.github.com/users/allenwp/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/allenwp/subscriptions","organizations_url":"https://api.github.com/users/allenwp/orgs","repos_url":"https://api.github.com/users/allenwp/repos","events_url":"https://api.github.com/users/allenwp/events{/privacy}","received_events_url":"https://api.github.com/users/allenwp/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-07-11T19:17:45Z","updated_at":"2025-07-11T19:24:20Z","body":"Thanks for reviewing!\r\n\r\n> Note that this PR does not make debanding more effective in the Mobile renderer (this would require higher debanding strength as I understand it).\r\n\r\nI haven’t looked into it yet, but I expect that Mobile debanding would be best solved with a [material based debanding](https://github.com/godotengine/godot/pull/87350) approach instead of a higher debanding strength in this viewport debanding.","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3063467548/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3070043141","html_url":"https://github.com/godotengine/godot/pull/107782#issuecomment-3070043141","issue_url":"https://api.github.com/repos/godotengine/godot/issues/107782","id":3070043141,"node_id":"IC_kwDOAO6SJc62_SQF","user":{"login":"Repiteo","id":17489292,"node_id":"MDQ6VXNlcjE3NDg5Mjky","avatar_url":"https://avatars.githubusercontent.com/u/17489292?v=4","gravatar_id":"","url":"https://api.github.com/users/Repiteo","html_url":"https://github.com/Repiteo","followers_url":"https://api.github.com/users/Repiteo/followers","following_url":"https://api.github.com/users/Repiteo/following{/other_user}","gists_url":"https://api.github.com/users/Repiteo/gists{/gist_id}","starred_url":"https://api.github.com/users/Repiteo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Repiteo/subscriptions","organizations_url":"https://api.github.com/users/Repiteo/orgs","repos_url":"https://api.github.com/users/Repiteo/repos","events_url":"https://api.github.com/users/Repiteo/events{/privacy}","received_events_url":"https://api.github.com/users/Repiteo/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-07-14T15:35:25Z","updated_at":"2025-07-14T15:35:25Z","body":"Thanks!","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3070043141/reactions","total_count":1,"+1":0,"-1":0,"laugh":0,"hooray":1,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null}]