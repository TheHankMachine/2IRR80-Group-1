[{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2690436868","html_url":"https://github.com/godotengine/godot/issues/103389#issuecomment-2690436868","issue_url":"https://api.github.com/repos/godotengine/godot/issues/103389","id":2690436868,"node_id":"IC_kwDOAO6SJc6gXM8E","user":{"login":"AThousandShips","id":96648715,"node_id":"U_kgDOBcK-Cw","avatar_url":"https://avatars.githubusercontent.com/u/96648715?v=4","gravatar_id":"","url":"https://api.github.com/users/AThousandShips","html_url":"https://github.com/AThousandShips","followers_url":"https://api.github.com/users/AThousandShips/followers","following_url":"https://api.github.com/users/AThousandShips/following{/other_user}","gists_url":"https://api.github.com/users/AThousandShips/gists{/gist_id}","starred_url":"https://api.github.com/users/AThousandShips/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/AThousandShips/subscriptions","organizations_url":"https://api.github.com/users/AThousandShips/orgs","repos_url":"https://api.github.com/users/AThousandShips/repos","events_url":"https://api.github.com/users/AThousandShips/events{/privacy}","received_events_url":"https://api.github.com/users/AThousandShips/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-02-28T11:44:05Z","updated_at":"2025-02-28T11:44:05Z","body":"Sounds exactly like:\n* https://github.com/godotengine/godot/issues/103325","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2690436868/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3585149394","html_url":"https://github.com/godotengine/godot/issues/103389#issuecomment-3585149394","issue_url":"https://api.github.com/repos/godotengine/godot/issues/103389","id":3585149394,"node_id":"IC_kwDOAO6SJc7VsQnS","user":{"login":"ColinSORourke","id":44822820,"node_id":"MDQ6VXNlcjQ0ODIyODIw","avatar_url":"https://avatars.githubusercontent.com/u/44822820?v=4","gravatar_id":"","url":"https://api.github.com/users/ColinSORourke","html_url":"https://github.com/ColinSORourke","followers_url":"https://api.github.com/users/ColinSORourke/followers","following_url":"https://api.github.com/users/ColinSORourke/following{/other_user}","gists_url":"https://api.github.com/users/ColinSORourke/gists{/gist_id}","starred_url":"https://api.github.com/users/ColinSORourke/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/ColinSORourke/subscriptions","organizations_url":"https://api.github.com/users/ColinSORourke/orgs","repos_url":"https://api.github.com/users/ColinSORourke/repos","events_url":"https://api.github.com/users/ColinSORourke/events{/privacy}","received_events_url":"https://api.github.com/users/ColinSORourke/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-11-27T10:32:44Z","updated_at":"2025-11-27T10:33:18Z","body":"This is a known, and intended constraint of `@tool`. See [`@tool` docs](https://docs.godotengine.org/en/stable/tutorials/plugins/running_code_in_the_editor.html#important-information).\n\n> Important information\n\n> The general rule is that any other GDScript that your tool script uses must *also* be a tool. The editor is not able to construct instances from GDScript files without @tool, which means you cannot call methods or reference member variables from them otherwise. However, since static methods, constants and enums can be used without creating an instance, it is possible to call them or reference them from a @tool script onto other non-tool scripts. One exception to this are [static variables](https://docs.godotengine.org/en/stable/tutorials/scripting/gdscript/gdscript_basics.html#doc-gdscript-basics-static-variables). If you try to read a static variable's value in a script that does not have @tool, it will always return null but won't print a warning or error when doing so. This restriction does not apply to static methods, which can be called regardless of whether the target script is in tool mode.\n\nYou can resolve this issue by adding `@tool` to your Resource R's GDScript file, I tested and confirmed that with the `@tool` annotation in both GDScript classes, your project behaves as intended","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3585149394/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null}]