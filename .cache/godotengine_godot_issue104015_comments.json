[{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2717363249","html_url":"https://github.com/godotengine/godot/pull/104015#issuecomment-2717363249","issue_url":"https://api.github.com/repos/godotengine/godot/issues/104015","id":2717363249,"node_id":"IC_kwDOAO6SJc6h96wx","user":{"login":"groud","id":6093119,"node_id":"MDQ6VXNlcjYwOTMxMTk=","avatar_url":"https://avatars.githubusercontent.com/u/6093119?v=4","gravatar_id":"","url":"https://api.github.com/users/groud","html_url":"https://github.com/groud","followers_url":"https://api.github.com/users/groud/followers","following_url":"https://api.github.com/users/groud/following{/other_user}","gists_url":"https://api.github.com/users/groud/gists{/gist_id}","starred_url":"https://api.github.com/users/groud/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/groud/subscriptions","organizations_url":"https://api.github.com/users/groud/orgs","repos_url":"https://api.github.com/users/groud/repos","events_url":"https://api.github.com/users/groud/events{/privacy}","received_events_url":"https://api.github.com/users/groud/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-03-12T10:17:35Z","updated_at":"2025-03-12T10:17:44Z","body":"I think the feature is nice, but it would be even better to have the center of mass/origin visible (and, even better, movable).","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2717363249/reactions","total_count":4,"+1":4,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2718129272","html_url":"https://github.com/godotengine/godot/pull/104015#issuecomment-2718129272","issue_url":"https://api.github.com/repos/godotengine/godot/issues/104015","id":2718129272,"node_id":"IC_kwDOAO6SJc6iA1x4","user":{"login":"bruvzg","id":7645683,"node_id":"MDQ6VXNlcjc2NDU2ODM=","avatar_url":"https://avatars.githubusercontent.com/u/7645683?v=4","gravatar_id":"","url":"https://api.github.com/users/bruvzg","html_url":"https://github.com/bruvzg","followers_url":"https://api.github.com/users/bruvzg/followers","following_url":"https://api.github.com/users/bruvzg/following{/other_user}","gists_url":"https://api.github.com/users/bruvzg/gists{/gist_id}","starred_url":"https://api.github.com/users/bruvzg/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/bruvzg/subscriptions","organizations_url":"https://api.github.com/users/bruvzg/orgs","repos_url":"https://api.github.com/users/bruvzg/repos","events_url":"https://api.github.com/users/bruvzg/events{/privacy}","received_events_url":"https://api.github.com/users/bruvzg/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-03-12T14:41:40Z","updated_at":"2025-03-12T14:41:40Z","body":"> but it would be even better to have the center of mass/origin visible (and, even better, movable).\r\n\r\nDone, both origin and center of mass are shown, and center is movable.","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2718129272/reactions","total_count":2,"+1":0,"-1":0,"laugh":0,"hooray":2,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2724792220","html_url":"https://github.com/godotengine/godot/pull/104015#issuecomment-2724792220","issue_url":"https://api.github.com/repos/godotengine/godot/issues/104015","id":2724792220,"node_id":"IC_kwDOAO6SJc6iaQec","user":{"login":"groud","id":6093119,"node_id":"MDQ6VXNlcjYwOTMxMTk=","avatar_url":"https://avatars.githubusercontent.com/u/6093119?v=4","gravatar_id":"","url":"https://api.github.com/users/groud","html_url":"https://github.com/groud","followers_url":"https://api.github.com/users/groud/followers","following_url":"https://api.github.com/users/groud/following{/other_user}","gists_url":"https://api.github.com/users/groud/gists{/gist_id}","starred_url":"https://api.github.com/users/groud/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/groud/subscriptions","organizations_url":"https://api.github.com/users/groud/orgs","repos_url":"https://api.github.com/users/groud/repos","events_url":"https://api.github.com/users/groud/events{/privacy}","received_events_url":"https://api.github.com/users/groud/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-03-14T13:59:34Z","updated_at":"2025-03-14T13:59:34Z","body":"> > but it would be even better to have the center of mass/origin visible (and, even better, movable).\r\n> \r\n> Done, both origin and center of mass are shown, and center is movable.\r\n\r\nI am not sure I follow. Wasn't the origin considered as the center of mass ? I think it's fine if they are kept as the same point, I just think it should be visible. I feel this is a lot of code added to the abstract_polygon editor for something that sounds a bit specific too, but maybe it can be useful elsewhere I guess.","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2724792220/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2724841013","html_url":"https://github.com/godotengine/godot/pull/104015#issuecomment-2724841013","issue_url":"https://api.github.com/repos/godotengine/godot/issues/104015","id":2724841013,"node_id":"IC_kwDOAO6SJc6iacY1","user":{"login":"bruvzg","id":7645683,"node_id":"MDQ6VXNlcjc2NDU2ODM=","avatar_url":"https://avatars.githubusercontent.com/u/7645683?v=4","gravatar_id":"","url":"https://api.github.com/users/bruvzg","html_url":"https://github.com/bruvzg","followers_url":"https://api.github.com/users/bruvzg/followers","following_url":"https://api.github.com/users/bruvzg/following{/other_user}","gists_url":"https://api.github.com/users/bruvzg/gists{/gist_id}","starred_url":"https://api.github.com/users/bruvzg/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/bruvzg/subscriptions","organizations_url":"https://api.github.com/users/bruvzg/orgs","repos_url":"https://api.github.com/users/bruvzg/repos","events_url":"https://api.github.com/users/bruvzg/events{/privacy}","received_events_url":"https://api.github.com/users/bruvzg/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-03-14T14:19:00Z","updated_at":"2025-03-14T14:19:00Z","body":"> Wasn't the origin considered as the center of mass\r\n\r\nFor physics, yes. By \"and center is movable\" I meant moving the polygon using its geometric center.\r\n\r\n- Tool button moves origin to the center of the polygon.\r\n\r\n<img width=\"829\" alt=\"Screenshot 2025-03-14 at 16 14 24\" src=\"https://github.com/user-attachments/assets/fb144b6c-5b6c-4513-994d-a07e018075b0\" />\r\n\r\n- Center point can be freely dragged, moving the whole polygon relative to the origin.\r\n\r\nhttps://github.com/user-attachments/assets/e7958acb-7cf0-4ea6-b96b-d97a08f720ba\r\n\r\nSince origin is also center of rotation/transform, it's not always desired to have it and center of polygon in the same place. And there was no way to move it without moving all points individually.","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2724841013/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2735806243","html_url":"https://github.com/godotengine/godot/pull/104015#issuecomment-2735806243","issue_url":"https://api.github.com/repos/godotengine/godot/issues/104015","id":2735806243,"node_id":"IC_kwDOAO6SJc6jERcj","user":{"login":"groud","id":6093119,"node_id":"MDQ6VXNlcjYwOTMxMTk=","avatar_url":"https://avatars.githubusercontent.com/u/6093119?v=4","gravatar_id":"","url":"https://api.github.com/users/groud","html_url":"https://github.com/groud","followers_url":"https://api.github.com/users/groud/followers","following_url":"https://api.github.com/users/groud/following{/other_user}","gists_url":"https://api.github.com/users/groud/gists{/gist_id}","starred_url":"https://api.github.com/users/groud/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/groud/subscriptions","organizations_url":"https://api.github.com/users/groud/orgs","repos_url":"https://api.github.com/users/groud/repos","events_url":"https://api.github.com/users/groud/events{/privacy}","received_events_url":"https://api.github.com/users/groud/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-03-19T09:03:01Z","updated_at":"2025-03-19T09:03:01Z","body":"Ah ok, I get it. The geometric center is just used as an handle then. Why not simply move the polygon when dragging in the red area then ? We could keep the current behaviors when close the the edges, but move the polygon instead if we are far from them?\r\nI find it a bit weird to use a single point to move a whole polygon tbh, though I guess it works fine.","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2735806243/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2787385673","html_url":"https://github.com/godotengine/godot/pull/104015#issuecomment-2787385673","issue_url":"https://api.github.com/repos/godotengine/godot/issues/104015","id":2787385673,"node_id":"IC_kwDOAO6SJc6mJCFJ","user":{"login":"JekSun97","id":130399274,"node_id":"U_kgDOB8W8Kg","avatar_url":"https://avatars.githubusercontent.com/u/130399274?v=4","gravatar_id":"","url":"https://api.github.com/users/JekSun97","html_url":"https://github.com/JekSun97","followers_url":"https://api.github.com/users/JekSun97/followers","following_url":"https://api.github.com/users/JekSun97/following{/other_user}","gists_url":"https://api.github.com/users/JekSun97/gists{/gist_id}","starred_url":"https://api.github.com/users/JekSun97/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/JekSun97/subscriptions","organizations_url":"https://api.github.com/users/JekSun97/orgs","repos_url":"https://api.github.com/users/JekSun97/repos","events_url":"https://api.github.com/users/JekSun97/events{/privacy}","received_events_url":"https://api.github.com/users/JekSun97/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-04-08T18:51:15Z","updated_at":"2025-04-09T23:50:09Z","body":"Let's add this!","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2787385673/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":{"reason":"off-topic"}},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2800131396","html_url":"https://github.com/godotengine/godot/pull/104015#issuecomment-2800131396","issue_url":"https://api.github.com/repos/godotengine/godot/issues/104015","id":2800131396,"node_id":"IC_kwDOAO6SJc6m5p1E","user":{"login":"KoBeWi","id":2223172,"node_id":"MDQ6VXNlcjIyMjMxNzI=","avatar_url":"https://avatars.githubusercontent.com/u/2223172?v=4","gravatar_id":"","url":"https://api.github.com/users/KoBeWi","html_url":"https://github.com/KoBeWi","followers_url":"https://api.github.com/users/KoBeWi/followers","following_url":"https://api.github.com/users/KoBeWi/following{/other_user}","gists_url":"https://api.github.com/users/KoBeWi/gists{/gist_id}","starred_url":"https://api.github.com/users/KoBeWi/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/KoBeWi/subscriptions","organizations_url":"https://api.github.com/users/KoBeWi/orgs","repos_url":"https://api.github.com/users/KoBeWi/repos","events_url":"https://api.github.com/users/KoBeWi/events{/privacy}","received_events_url":"https://api.github.com/users/KoBeWi/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-04-13T21:25:10Z","updated_at":"2025-04-13T21:41:50Z","body":"The button says \"Move center of gravity to origin.\", but it appears to be doing the opposite, i.e. it moves origin point onto the center.\r\n\r\nAlso is there a way to somehow explain the meaning of the two points? I imagine they'll look cryptic for unfamiliar users and the button's tooltip is the only clue.\r\n\r\nEDIT:\r\nWhen you right-click while dragging center, it will open 2D editor's menu and make the dragging stuck. It does not happen when dragging regular points.\r\n\r\nEDIT2:\r\nThe origin and center point also appear for Polygon2D. I think they shouldn't? Center of mass is irrelevant for Polygon2D, and there is also the Polygon bottom editor that allows moving points.\r\n\r\nThere's also this xd\r\n![image](https://github.com/user-attachments/assets/08fdac11-aa4b-499e-94fc-4e50f72dc319)\r\nAbstractPolygon2DEditor is used for many classes, so you need to be mindful when adding features.","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2800131396/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2800546199","html_url":"https://github.com/godotengine/godot/pull/104015#issuecomment-2800546199","issue_url":"https://api.github.com/repos/godotengine/godot/issues/104015","id":2800546199,"node_id":"IC_kwDOAO6SJc6m7PGX","user":{"login":"bruvzg","id":7645683,"node_id":"MDQ6VXNlcjc2NDU2ODM=","avatar_url":"https://avatars.githubusercontent.com/u/7645683?v=4","gravatar_id":"","url":"https://api.github.com/users/bruvzg","html_url":"https://github.com/bruvzg","followers_url":"https://api.github.com/users/bruvzg/followers","following_url":"https://api.github.com/users/bruvzg/following{/other_user}","gists_url":"https://api.github.com/users/bruvzg/gists{/gist_id}","starred_url":"https://api.github.com/users/bruvzg/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/bruvzg/subscriptions","organizations_url":"https://api.github.com/users/bruvzg/orgs","repos_url":"https://api.github.com/users/bruvzg/repos","events_url":"https://api.github.com/users/bruvzg/events{/privacy}","received_events_url":"https://api.github.com/users/bruvzg/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-04-14T05:53:33Z","updated_at":"2025-04-14T05:53:33Z","body":"> The origin and center point also appear for Polygon2D. I think they shouldn't? Center of mass is irrelevant for Polygon2D, and there is also the Polygon bottom editor that allows moving points.\r\n\r\nYes, It's only relevant for collisions shapes. Limited it to collision shapes.\r\n\r\n> When you right-click while dragging center, it will open 2D editor's menu and make the dragging stuck. It does not happen when dragging regular points.\r\n\r\nFixed.\r\n\r\n> One potential issue I noticed is that the default marker icon can be seen behind the O icon. This is most noticeable at high editor scales\r\n\r\nBoth are non-interactive and always at the same place, so not sure what's the issue. Default maker also under the polygon itself and in most cases not visible. But since I have limited it to collision polygons, and collision polygons does not have default marker, it's no longer relevant.\r\n\r\n> The button says \"Move center of gravity to origin.\", but it appears to be doing the opposite, i.e. it moves origin point onto the center.\r\n\r\nRenamed it to `Move center of gravity to geometric center` to avoid confusion. Physical center of gravity is origin (“O” point), and “C” point is geometric center.","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2800546199/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2959471505","html_url":"https://github.com/godotengine/godot/pull/104015#issuecomment-2959471505","issue_url":"https://api.github.com/repos/godotengine/godot/issues/104015","id":2959471505,"node_id":"IC_kwDOAO6SJc6wZfOR","user":{"login":"akien-mga","id":4701338,"node_id":"MDQ6VXNlcjQ3MDEzMzg=","avatar_url":"https://avatars.githubusercontent.com/u/4701338?v=4","gravatar_id":"","url":"https://api.github.com/users/akien-mga","html_url":"https://github.com/akien-mga","followers_url":"https://api.github.com/users/akien-mga/followers","following_url":"https://api.github.com/users/akien-mga/following{/other_user}","gists_url":"https://api.github.com/users/akien-mga/gists{/gist_id}","starred_url":"https://api.github.com/users/akien-mga/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/akien-mga/subscriptions","organizations_url":"https://api.github.com/users/akien-mga/orgs","repos_url":"https://api.github.com/users/akien-mga/repos","events_url":"https://api.github.com/users/akien-mga/events{/privacy}","received_events_url":"https://api.github.com/users/akien-mga/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-06-10T14:26:56Z","updated_at":"2025-06-10T14:26:56Z","body":"Thanks!","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2959471505/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null}]