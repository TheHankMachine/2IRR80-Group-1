rchived_at":null,"archived_by":null},{"id":2304948121,"node_id":"MDU6TGFiZWwyMzA0OTQ4MTIx","url":"https://api.github.com/repos/godotengine/godot/labels/topic:codestyle","name":"topic:codestyle","color":"ffee88","default":false,"description":"","archived_at":null,"archived_by":null}],"state":"closed","locked":false,"assignees":[],"milestone":{"url":"https://api.github.com/repos/godotengine/godot/milestones/25","html_url":"https://github.com/godotengine/godot/milestone/25","labels_url":"https://api.github.com/repos/godotengine/godot/milestones/25/labels","id":15520464,"node_id":"MI_kwDOAO6SJc4A7NLQ","number":25,"title":"4.8","description":"","creator":{"login":"Repiteo","id":17489292,"node_id":"MDQ6VXNlcjE3NDg5Mjky","avatar_url":"https://avatars.githubusercontent.com/u/17489292?v=4","gravatar_id":"","url":"https://api.github.com/users/Repiteo","html_url":"https://github.com/Repiteo","followers_url":"https://api.github.com/users/Repiteo/followers","following_url":"https://api.github.com/users/Repiteo/following{/other_user}","gists_url":"https://api.github.com/users/Repiteo/gists{/gist_id}","starred_url":"https://api.github.com/users/Repiteo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Repiteo/subscriptions","organizations_url":"https://api.github.com/users/Repiteo/orgs","repos_url":"https://api.github.com/users/Repiteo/repos","events_url":"https://api.github.com/users/Repiteo/events{/privacy}","received_events_url":"https://api.github.com/users/Repiteo/received_events","type":"User","user_view_type":"public","site_admin":false},"open_issues":346,"closed_issues":2304,"state":"open","created_at":"2026-04-13T15:59:35Z","updated_at":"2026-10-21T09:34:58Z","due_on":null,"closed_at":null},"comments":11,"created_at":"2026-08-21T20:48:34Z","updated_at":"2026-09-02T14:57:05Z","closed_at":"2026-09-02T14:42:28Z","assignee":null,"author_association":"CONTRIBUTOR","issue_field_values":[],"type":null,"active_lock_reason":null,"draft":false,"pull_request":{"url":"https://api.github.com/repos/godotengine/godot/pulls/122706","html_url":"https://github.com/godotengine/godot/pull/122706","diff_url":"https://github.com/godotengine/godot/pull/122706.diff","patch_url":"https://github.com/godotengine/godot/pull/122706.patch","merged_at":"2026-09-02T14:42:28Z"},"body":"## What problem(s) does this PR solve?\r\n\r\n`_profile_count_as_native()` currently does a total of three map look-ups:\r\n1. `ClassDB::class_exists()` checks if the class exists in the `classes` map.\r\n2. `ClassDB::has_method()` gets the class info from the `classes` map...\r\n3. ...then checks if the named method exists in the GDType's `method_map`.\r\n\r\nStep 2 already returns `false` when the class can't be found, meaning all step 1 does is to make code slower and nothing else.\r\n\r\n~~And thanks to #117599, we have direct access to the object's GDType, meaning step 2 may be skipped as well.~~\r\n\r\n**Update**: Per maintainer request, I've kept step 2 as `GDType` is too new and subject to big changes to be used outside of core. It might come back once it's more feature complete, but not on this PR.","closed_by":{"login":"Repiteo","id":17489292,"node_id":"MDQ6VXNlcjE3NDg5Mjky","avatar_url":"https://avatars.githubusercontent.com/u/17489292?v=4","gravatar_id":"","url":"https://api.github.com/users/Repiteo","html_url":"https://github.com/Repiteo","followers_url":"https://api.github.com/users/Repiteo/followers","following_url":"https://api.github.com/users/Repiteo/following{/other_user}","gists_url":"https://api.github.com/users/Repiteo/gists{/gist_id}","starred_url":"https://api.github.com/users/Repiteo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Repiteo/subscriptions","organizations_url":"https://api.github.com/users/Repiteo/orgs","repos_url":"https://api.github.com/users/Repiteo/repos","events_url":"https://api.github.com/users/Repiteo/events{/privacy}","received_events_url":"https://api.github.com/users/Repiteo/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/122706/reactions","total_count":9,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":8,"eyes":1},"timeline_url":"https://api.github.com/repos/godotengine/godot/issues/122706/timeline","performed_via_github_app":null,"state_reason":null}