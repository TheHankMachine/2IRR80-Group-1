ine/godot/issues/111212","id":3598555117,"node_id":"IC_kwDOAO6SJc7WfZft","user":{"login":"bruvzg","id":7645683,"node_id":"MDQ6VXNlcjc2NDU2ODM=","avatar_url":"https://avatars.githubusercontent.com/u/7645683?v=4","gravatar_id":"","url":"https://api.github.com/users/bruvzg","html_url":"https://github.com/bruvzg","followers_url":"https://api.github.com/users/bruvzg/followers","following_url":"https://api.github.com/users/bruvzg/following{/other_user}","gists_url":"https://api.github.com/users/bruvzg/gists{/gist_id}","starred_url":"https://api.github.com/users/bruvzg/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/bruvzg/subscriptions","organizations_url":"https://api.github.com/users/bruvzg/orgs","repos_url":"https://api.github.com/users/bruvzg/repos","events_url":"https://api.github.com/users/bruvzg/events{/privacy}","received_events_url":"https://api.github.com/users/bruvzg/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-12-01T19:45:48Z","updated_at":"2025-12-01T19:45:48Z","body":"> There was some conflict with https://github.com/godotengine/godot/pull/112604, the changes were incompatible and I had to remove them (from FileDialog). Not sure if it didn't break anything\r\n\r\nWill likely break native dialogs in some case, will check tomorrow. I not sure what's incompatible, it should only need changing `_can_use_native_popup() && (use_native_dialog || OS::get_singleton()->is_sandboxed())` to `_should_use_native_popup()`.","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3598555117/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3598586573","html_url":"https://github.com/godotengine/godot/pull/111212#issuecomment-3598586573","issue_url":"https://api.github.com/repos/godotengine/godot/issues/111212","id":3598586573,"node_id":"IC_kwDOAO6SJc7WfhLN","user":{"login":"KoBeWi","id":2223172,"node_id":"MDQ6VXNlcjIyMjMxNzI=","avatar_url":"https://avatars.githubusercontent.com/u/2223172?v=4","gravatar_id":"","url":"https://api.github.com/users/KoBeWi","html_url":"https://github.com/KoBeWi","followers_url":"https://api.github.com/users/KoBeWi/followers","following_url":"https://api.github.com/users/KoBeWi/following{/other_user}","gists_url":"https://api.github.com/users/KoBeWi/gists{/gist_id}","starred_url":"https://api.github.com/users/KoBeWi/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/KoBeWi/subscriptions","organizations_url":"https://api.github.com/users/KoBeWi/orgs","repos_url":"https://api.github.com/users/KoBeWi/repos","events_url":"https://api.github.com/users/KoBeWi/events{/privacy}","received_events_url":"https://api.github.com/users/KoBeWi/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-12-01T19:54:57Z","updated_at":"2025-12-01T19:54:57Z","body":"Yeah but I removed the `_popup_base()` method completely, because it was redundant. So I guess I should replace the `NOTIFICATION_VISIBILITY_CHANGED` with `_pre_popup()`?","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3598586573/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3598632030","html_url":"https://github.com/godotengine/godot/pull/111212#issuecomment-3598632030","issue_url":"https://api.github.com/repos/godotengine/godot/issues/111212","id":3598632030,"node_id":"IC_kwDOAO6SJc7WfsRe","user":{"login":"bruvzg","id":7645683,"node_id":"MDQ6VXNlcjc2NDU2ODM=","avatar_url":"https://avatars.githubusercontent.com/u/7645683?v=4","gravatar_id":"","url":"https://api.github.com/users/bruvzg","html_url":"https://github.com/bruvzg","followers_url":"https://api.github.com/users/bruvzg/followers","following_url":"https://api.github.com/users/bruvzg/following{/other_user}","gists_url":"https://api.github.com/users/bruvzg/gists{/gist_id}","starred_url":"https://api.github.com/users/bruvzg/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/bruvzg/subscriptions","organizations_url":"https://api.github.com/users/bruvzg/orgs","repos_url":"https://api.github.com/users/bruvzg/repos","events_url":"https://api.github.com/users/bruvzg/events{/privacy}","received_events_url":"https://api.github.com/users/bruvzg/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-12-01T20:08:12Z","updated_at":"2025-12-01T20:08:12Z","body":"`NOTIFICATION_VISIBILITY_CHANGED` is called after a popup is shown, so it won't work in this case. `_popup_base()` should intercept it before it's shown (and show native dialog instead).","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3598632030/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3598671230","html_url":"https://github.com/godotengine/godot/pull/111212#issuecomment-3598671230","issue_url":"https://api.github.com/repos/godotengine/godot/issues/111212","id":3598671230,"node_id":"IC_kwDOAO6SJc7Wf11-","user":{"login":"bruvzg","id":7645683,"node_id":"MDQ6VXNlcjc2NDU2ODM=","avatar_url":"https://avatars.githubusercontent.com/u/7645683?v=4","gravatar_id":"","url":"https://api.github.com/users/bruvzg","html_url":"https://github.com/bruvzg","followers_url":"https://api.github.com/users/bruvzg/followers","following_url":"https://api.github.com/users/bruvzg/following{/other_user}","gists_url":"https://api.github.com/users/bruvzg/gists{/gist_id}","starred_url":"https://api.github.com/users/bruvzg/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/bruvzg/subscriptions","organizations_url":"https://api.github.com/users/bruvzg/orgs","repos_url":"https://api.github.com/users/bruvzg/repos","events_url":"https://api.github.com/users/bruvzg/events{/privacy}","received_events_url":"https://api.github.com/users/bruvzg/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-12-01T20:19:31Z","updated_at":"2025-12-01T20:19:45Z","body":"Currently, `Window::popup_*` do the following:\r\n    - `about_to_popup` signal is emitted\r\n    - `_pre_popup` is called to override window size (used only by `PopupMenu`)\r\n    - `_popup_base` is called, this shows the window and emit `NOTIFICATION_VISIBILITY_CHANGED` + `visibility_changed` signal.\r\n    - `_post_popup` is called and `NOTIFICATION_POST_POPUP` is emitted.\r\n\r\nSo overriding `_popup_base` should allow it to prevent window from being shown, and show native dialog. `NOTIFICATION_VISIBILITY_CHANGED` is too late, and overriding `_pre_popup` do nothing, since the rest of the called will happen in any case.","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3598671230/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3599260746","html_url":"https://github.com/godotengine/godot/pull/111212#issuecomment-3599260746","issue_url":"https://api.github.com/repos/godotengine/godot/issues/111212","id":3599260746,"node_id":"IC_kwDOAO6SJc7WiFxK","user":{"login":"KoBeWi","id":2223172,"node_id":"MDQ6VXNlcjIyMjMxNzI=","avatar_url":"https://avatars.githubusercontent.com/u/2223172?v=4","gravatar_id":"","url":"https://api.github.com/users/KoBeWi","html_url":"https: