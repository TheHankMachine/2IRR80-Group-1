d match types you don't want to match. I've raised the boolean problem before, and there may be others like it (although I didn't immediately spot any). Before merging, please make doubly sure that each declaration is as airtight as it can be.","html_url":"https://github.com/godotengine/godot/pull/101003#pullrequestreview-2744966727","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/101003","author_association":"MEMBER","submitted_at":"2025-04-05T19:03:41Z"},{"id":2744969030,"node_id":"PRR_kwDOAO6SJc6jnOdG","state":"COMMENTED","commit_id":"8a93218aabab0ee277427b84d43ce55edfb586eb","user":{"site_admin":false,"suspended":false,"updated_at":"0001-01-01T00:00:00Z","avatar_url":"https://avatars.githubusercontent.com/u/17489292?u=34072b401722100a7c0c0d61e37b376cf22b4545&v=4","created_at":"0001-01-01T00:00:00Z","followers":0,"following":0,"html_url":"https://github.com/Repiteo","id":17489292,"node_id":"MDQ6VXNlcjE3NDg5Mjky","login":"Repiteo","type":"User","owned_private_repos":0,"public_gists":0,"public_repos":0,"total_private_repos":0,"url":"https://api.github.com/users/Repiteo"},"body":"","html_url":"https://github.com/godotengine/godot/pull/101003#pullrequestreview-2744969030","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/101003","author_association":"CONTRIBUTOR","submitted_at":"2025-04-05T19:10:44Z"},{"id":2744971221,"node_id":"PRR_kwDOAO6SJc6jnO_V","state":"COMMENTED","commit_id":"8a93218aabab0ee277427b84d43ce55edfb586eb","user":{"site_admin":false,"suspended":false,"updated_at":"0001-01-01T00:00:00Z","avatar_url":"https://avatars.githubusercontent.com/u/2308167?u=f7f8e0273f784f5ec6f6b7fe4a88d449896eb48a&v=4","created_at":"0001-01-01T00:00:00Z","followers":0,"following":0,"html_url":"https://github.com/Ivorforce","id":2308167,"node_id":"MDQ6VXNlcjIzMDgxNjc=","login":"Ivorforce","type":"User","owned_private_repos":0,"public_gists":0,"public_repos":0,"total_private_repos":0,"url":"https://api.github.com/users/Ivorforce"