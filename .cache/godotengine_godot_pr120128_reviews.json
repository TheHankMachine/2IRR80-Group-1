[{"id":4465259936,"node_id":"PRR_kwDOAO6SJc8AAAABCiZ1oA","user":{"login":"lawnjelly","id":21999379,"node_id":"MDQ6VXNlcjIxOTk5Mzc5","avatar_url":"https://avatars.githubusercontent.com/u/21999379?u=2b8b17ce969861380874563b333a546e0bbaab56&v=4","gravatar_id":"","url":"https://api.github.com/users/lawnjelly","html_url":"https://github.com/lawnjelly","followers_url":"https://api.github.com/users/lawnjelly/followers","following_url":"https://api.github.com/users/lawnjelly/following{/other_user}","gists_url":"https://api.github.com/users/lawnjelly/gists{/gist_id}","starred_url":"https://api.github.com/users/lawnjelly/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/lawnjelly/subscriptions","organizations_url":"https://api.github.com/users/lawnjelly/orgs","repos_url":"https://api.github.com/users/lawnjelly/repos","events_url":"https://api.github.com/users/lawnjelly/events{/privacy}","received_events_url":"https://api.github.com/users/lawnjelly/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"Actually, scratch that, my eyesight failing me, this needs a double check the second init is redundant.","state":"DISMISSED","html_url":"https://github.com/godotengine/godot/pull/120128#pullrequestreview-4465259936","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/120128","author_association":"MEMBER","_links":{"html":{"href":"https://github.com/godotengine/godot/pull/120128#pullrequestreview-4465259936"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/120128"}},"submitted_at":"2026-06-10T06:48:46Z","commit_id":"424249f88f96cae107e9ee1ab58af1c162bcd5cf"},{"id":4466312433,"node_id":"PRR_kwDOAO6SJc8AAAABCjaE8Q","user":{"login":"Ivorforce","id":2308167,"node_id":"MDQ6VXNlcjIzMDgxNjc=","avatar_url":"https://avatars.githubusercontent.com/u/2308167?u=f7f8e0273f784f5ec6f6b7fe4a88d449896eb48a&v=4","gravatar_id":"","url":"https://api.github.com/users/Ivorforce","html_url":"https://github.com/Ivorforce","followers_url":"https://api.github.com/users/Ivorforce/followers","following_url":"https://api.github.com/users/Ivorforce/following{/other_user}","gists_url":"https://api.github.com/users/Ivorforce/gists{/gist_id}","starred_url":"https://api.github.com/users/Ivorforce/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Ivorforce/subscriptions","organizations_url":"https://api.github.com/users/Ivorforce/orgs","repos_url":"https://api.github.com/users/Ivorforce/repos","events_url":"https://api.github.com/users/Ivorforce/events{/privacy}","received_events_url":"https://api.github.com/users/Ivorforce/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"I came across this once and while this is an obvious performance hole, I think it's one not fixed so easily.\r\n\r\nThe key insight is that `memnew_placement(&VariantInternalAccessor<T>::get(v), T);` isn't actually guaranteed to initialize the pointee. It is skipped for primitives such as `double`.\r\n\r\nHere you can see it demonstrated clearly: https://godbolt.org/z/1W3aTr7ah\r\n\r\nIn practice, it still happens to be correct most times because `clear()` happens to reset the payload to `0` for most types, and most types happen to default to `0`. However, I wouldn't put my hand in the fire for this. Even if happens to be true for all types today (I haven't checked), it would be relying on UB.\r\n\r\nI think to properly fix the double initialization, more parts of the initialization logic have to be refactored. High time, but will require a good amount of sleuthing work.","state":"CHANGES_REQUESTED","html_url":"https://github.com/godotengine/godot/pull/120128#pullrequestreview-4466312433","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/120128","author_association":"MEMBER","_links":{"html":{"href":"https://github.com/godotengine/godot/pull/120128#pullrequestreview-4466312433"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/120128"}},"submitted_at":"2026-06-10T09:20:18Z","commit_id":"424249f88f96cae107e9ee1ab58af1c162bcd5cf"},{"id":4537431816,"node_id":"PRR_kwDOAO6SJc8AAAABDnO3CA","user":{"login":"Ivorforce","id":2308167,"node_id":"MDQ6VXNlcjIzMDgxNjc=","avatar_url":"https://avatars.githubusercontent.com/u/2308167?u=f7f8e0273f784f5ec6f6b7fe4a88d449896eb48a&v=4","gravatar_id":"","url":"https://api.github.com/users/Ivorforce","html_url":"https://github.com/Ivorforce","followers_url":"https://api.github.com/users/Ivorforce/followers","following_url":"https://api.github.com/users/Ivorforce/following{/other_user}","gists_url":"https://api.github.com/users/Ivorforce/gists{/gist_id}","starred_url":"https://api.github.com/users/Ivorforce/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Ivorforce/subscriptions","organizations_url":"https://api.github.com/users/Ivorforce/orgs","repos_url":"https://api.github.com/users/Ivorforce/repos","events_url":"https://api.github.com/users/Ivorforce/events{/privacy}","received_events_url":"https://api.github.com/users/Ivorforce/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"Thinking about this again, I think the new version is the right trade-off for the moment.\r\n\r\nWhat we lose: primitive types are sometimes initialized twice (but probably 'optimized away').\r\nWhat we gain: Allocation types are not initialized twice needlessly.\r\n\r\nSo it should be overall a safe and needed performance improvement. But nuances are hard so this should be merged early in the cycle.\r\n\r\nThe unit tests are a little verbose for my taste, but they're acceptable. I wouldn't say a 'templated' version would be strictly better so we can leave them as is.\r\n\r\nAs a note to the future: This essentially increases the guarantee of `VariantInitializer` to produce the type's default value.","state":"APPROVED","html_url":"https://github.com/godotengine/godot/pull/120128#pullrequestreview-4537431816","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/120128","author_association":"MEMBER","_links":{"html":{"href":"https://github.com/godotengine/godot/pull/120128#pullrequestreview-4537431816"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/120128"}},"submitted_at":"2026-06-20T12:27:00Z","commit_id":"64a1ca6d456f4034e5881423aa0ff1968e8eca4f"}]