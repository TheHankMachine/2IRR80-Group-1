_url":"https://avatars.githubusercontent.com/u/96648715?v=4","gravatar_id":"","url":"https://api.github.com/users/AThousandShips","html_url":"https://github.com/AThousandShips","followers_url":"https://api.github.com/users/AThousandShips/followers","following_url":"https://api.github.com/users/AThousandShips/following{/other_user}","gists_url":"https://api.github.com/users/AThousandShips/gists{/gist_id}","starred_url":"https://api.github.com/users/AThousandShips/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/AThousandShips/subscriptions","organizations_url":"https://api.github.com/users/AThousandShips/orgs","repos_url":"https://api.github.com/users/AThousandShips/repos","events_url":"https://api.github.com/users/AThousandShips/events{/privacy}","received_events_url":"https://api.github.com/users/AThousandShips/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2024-12-06T15:16:08Z","updated_at":"2024-12-06T15:16:08Z","body":"I'd suggest in the future to comment that you are like I did","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2523470918/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2529132298","html_url":"https://github.com/godotengine/godot/issues/100098#issuecomment-2529132298","issue_url":"https://api.github.com/repos/godotengine/godot/issues/100098","id":2529132298,"node_id":"IC_kwDOAO6SJc6Wv38K","user":{"login":"DarioSamo","id":538504,"node_id":"MDQ6VXNlcjUzODUwNA==","avatar_url":"https://avatars.githubusercontent.com/u/538504?v=4","gravatar_id":"","url":"https://api.github.com/users/DarioSamo","html_url":"https://github.com/DarioSamo","followers_url":"https://api.github.com/users/DarioSamo/followers","following_url":"https://api.github.com/users/DarioSamo/following{/other_user}","gists_url":"https://api.github.com/users/DarioSamo/gists{/gist_id}","starred_url":"https://api.github.com/users/DarioSamo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/DarioSamo/subscriptions","organizations_url":"https://api.github.com/users/DarioSamo/orgs","repos_url":"https://api.github.com/users/DarioSamo/repos","events_url":"https://api.github.com/users/DarioSamo/events{/privacy}","received_events_url":"https://api.github.com/users/DarioSamo/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2024-12-09T19:07:45Z","updated_at":"2024-12-09T19:07:45Z","body":"The regression is mostly unrelated to the PR itself. The render graph is able to re-order operations because of the changes introduced in that PR. Sadly, that means the sorting time grew exponentially because it can now detect a lot more dependencies. It is pretty much spending its entire time just sorting the command graph.\n\nThe algorithm itself is designed to work with a much lower scope of nodes per frame, and it's basically blowing up because of the huge amount of commands generated by the preprocess. A brief look revealed there's 36k commands being sorted.\n\nBisecting into the PR won't do us much good here, it'll be best to either just avoid reordering on these scenarios or find some way to optimize the ordering process.\n\nMost of the time was spent entirely just on the ::end() step.","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2529132298/reactions","total_count":3,"+1":3,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2529138082","html_url":"https://github.com/godotengine/godot/issues/100098#issuecomment-2529138082","issue_url":"https://api.github.com/repos/godotengine/godot/issues/100098","id":2529138082,"node_id":"IC_kwDOAO6SJc6Wv5Wi","user":{"login":"DarioSamo","id":538504,"node_id":"MDQ6VXNlcjUzODUwNA==","avatar_url":"https://avatars.githubusercontent.com/u/538504?v=4","gravatar_id":"","url":"https://api.github.com/users/DarioSamo","html_url":"https://github.com/DarioSamo","followers_url":"https://api.github.com/users/DarioSamo/followers","following_url":"https://api.github.com/users/DarioSamo/following{/other_user}","gists_url":"https://api.github.com/users/DarioSamo/gists{/gist_id}","starred_url":"https://api.github.com/users/DarioSamo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/DarioSamo/subscriptions","organizations_url":"https://api.github.com/users/DarioSamo/orgs","repos_url":"https://api.github.com/users/DarioSamo/repos","events_url":"https://api.github.com/users/DarioSamo/events{/privacy}","received_events_url":"https://api.github.com/users/DarioSamo/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2024-12-09T19:10:22Z","updated_at":"2024-12-09T19:10:36Z","body":"As a fun note, here's how big the adjacency list grows during the frame that particles get preprocessed.\n\n![Image](https://github.com/user-attachments/assets/9e5dd5bf-42e5-4069-830c-abb0ea2899e4)\n\nA linked list of 324 million elements.","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2529138082/reactions","total_count":1,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":1},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2529191423","html_url":"https://github.com/godotengine/godot/issues/100098#issuecomment-2529191423","issue_url":"https://api.github.com/repos/godotengine/godot/issues/100098","id":2529191423,"node_id":"IC_kwDOAO6SJc6WwGX_","user":{"login":"DarioSamo","id":538504,"node_id":"MDQ6VXNlcjUzODUwNA==","avatar_url":"https://avatars.githubusercontent.com/u/538504?v=4","gravatar_id":"","url":"https://api.github.com/users/DarioSamo","html_url":"https://github.com/DarioSamo","followers_url":"https://api.github.com/users/DarioSamo/followers","following_url":"https://api.github.com/users/DarioSamo/following{/other_user}","gists_url":"https://api.github.com/users/DarioSamo/gists{/gist_id}","starred_url":"https://api.github.com/users/DarioSamo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/DarioSamo/subscriptions","organizations_url":"https://api.github.com/users/DarioSamo/orgs","repos_url":"https://api.github.com/users/DarioSamo/repos","events_url":"https://api.github.com/users/DarioSamo/events{/privacy}","received_events_url":"https://api.github.com/users/DarioSamo/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2024-12-09T19:27:56Z","updated_at":"2024-12-09T19:30:44Z","body":"For some extra context, while I understand Godot offers this feature, the strain on the system will be completely unsustainable for anything that isn't a high-end GPU. While I agree there's a perceived regression, the expectation around fixing this will likely require some irregular handling for preprocess in particular (e.g. the graph has to get out of the way and fall back to a linear process).\n\nPreprocess introduces a highly irregular workload and it batches a ton of work to be done on a singular frame. You're running a really high risk of encountering a TDR in a GPU that can't take this much work in a single frame.\n\nWhile the current waiting time is pretty much entirely the CPU's fault on Godot's side, you're basically playing the lottery as to whether the driver will accept a giant command list like this and you won't get a DEVICE_LOST on the GPU afterwards depending on the strength of the system.","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2529191423/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2529209446","html_url":"https://github.com/godotengine/godot/issues/100098#issuecomment-2529209446","issue_url":"https://api.github.com/repos/godotengine/godot/issues/100098","id":2529209446,"node_id":"IC_kwDOAO6SJc6WwKxm","user":{"login":"matheusmdx","id":44306054,"node_id":"MDQ6VXNlcjQ0MzA2MDU0","avatar_url":"https://avatars.githubusercontent.com/u/44306054?v=4","gravatar_id":"","url":"https://api.github.com/users/matheusmdx","html_url":"https://github.com/matheusmdx","followers_url":"https://api.github.com/users/matheusmdx/followers","following_url":"https://api.github.com/users/matheusmdx/following{/other_user}","gists_url":"https://api.github.com/users/matheusmdx/gists{/gist_id}","starred_url":"https://api.github.com/users/matheusmdx/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/matheusmdx/subscriptions","organizations_url":"https://api.github.com/users/matheusmdx/orgs","repos_url":"https://api.github.com/users/matheusmdx/repos","events_url":"https://api.github.com/users/matheusmdx/events{/privacy}","received_events_url":"https://api.github.com/users/matheusmdx/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2024-12-09T19:32:54Z","updated_at":"2024-12-09T19:32:54Z","body":"I think at least should be added a note in the `GPUParticles2D` (and i suppose the 3D will also suffer from this too) docs.","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2529209446/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2529222198","html_url":"https://github.com/godotengine/godot/issues/100098#issuecomment-2529222198","issue_url":"https://api.github.com/repos/godotengine/godot/issues/100098","id":2529222198,"node_id":"IC_kwDOAO6SJc6WwN42","user":{"login":"darksylinc","id":3395130,"node_id":"MDQ6VXNlcjMzOTUxMzA=","avatar_url":"https://avatars.githubusercontent.com/u/3395130?v=4","gravatar_id":"","url":"https://api.github.com/users/darksylinc","html_url":"https://github.com/darksylinc","followers_url":"https://api.github.com/users/darksylinc/followers","following_url":"https://api.github.com/users/darksylinc/following{/other_user}","gists_url":"https://api.github.com/users/darksylinc/gists{/gist_id}","starred_url":"https://api.github.com/users/darksylinc/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/darksylinc/subscriptions","organizations_url":"https://api.github.com/users/darksylinc/orgs","repos_url":"https://api.github.com/users/darksylinc/repos","events_url":"https://api.github.com/users/darksylinc/events{/privacy}","received_events_url":"https://api.github.com/users/darksylinc/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2024-12-09T19:36:15Z","updated_at":"2024-12-09T19:37:28Z","body":"I agree with Dario.\n\nPreprocessing 10 minutes worth of particle simulation in a single frame is too much of an extreme value, and not the general case (optimizations are about optimizing for general cases).\n\nWhile the CPU performance regression can be \"fixed\" by adding an exception so the render graph stays out of these commands; it is worth arguing if a value of 600 should be valid input at all (or at least, not allowed by default).\n\nA value of 600 will TDR slower GPUs (such as Intel iGPUs) due to the sheer amount of GPU work to process. This makes Godot look bad and unstable; whereas the problem is not within Godot.\n\n35k dispatches in a row is way too much. Applications that need to do something like that will likely need to tweak the _TdrDelay_ in the Registry Editor (which is a system-wide setting).\n\nAt most the upper limit should be around 10 seconds worth of simulation. Not 600. If the users want more, they'd have to flip a switch with a big fat \"WARNING!!! Going beyond this value can cause crashes on slow systems\".","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2529222198/reactions","total_count":2,"+1":2,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2529321831","html_url":"https://github.com/godotengine/godot/issues/100098#issuecomment-2529321831","issue_url":"https://api.github.com/repos/godotengine/godot/issues/100098","id":2529321831,"node_id":"IC_kwDOAO6SJc6WwmNn","user":{"login":"produno","id":8760003,"node_id":"MDQ6VXNlcjg3NjAwMDM=","avatar_url":"https://avatars.githubusercontent.com/u/8760003?v=4","gravatar_id":"","url":"https://api.github.com/users/produno","html_url":"https://github.com/produno","followers_url":"https://api.github.com/users/produno/followers","following_url":"https://api.github.com/users/produno/following{/other_user}","gists_url":"https://api.github.com/users/produno/gists{/gist_id}","starred_url":"https://api.github.com/users/produno/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/produno/subscriptions","organizations_url":"https://api.github.com/users/produno/orgs","repos_url":"https://api.github.com/users/produno/repos","events_url":"https://api.github.com/users/produno/events{/privacy}","received_events_url":"https://api.github.com/users/produno/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2024-12-09T20:01:05Z","updated_at":"2024-12-09T20:01:05Z","body":"No one in their right mind is going to use a large preprocess the way it is now, so it may as well be removed. But this is quite a large breaking change for those that have done so already and wishes to update, as a feature that was available in the engine, is no longer viable.","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2529321831/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2529331853","html_url":"https://github.com/godotengine/godot/issues/100098#issuecomment-2529331853","issue_url":"https://api.github.com/repos/godotengine/godot/issues/100098","id":2529331853,"node_id":"IC_kwDOAO6SJc6WwoqN","user":{"login":"clayjohn","id":16521339,"node_id":"MDQ6VXNlcjE2NTIxMzM5","avatar_url":"https://avatars.githubusercontent.com/u/16521339?v=4","gravatar_id":"","url":"https://api.github.com/users/clayjohn","html_url":"https://github.com/clayjohn","followers_url":"https://api.github.com/users/clayjohn/followers","following_url":"https://api.github.com/users/clayjohn/following{/other_user}","gists_url":"https://api.github.com/users/clayjohn/gists{/gist_id}","starred_url":"https://api.github.com/users/clayjohn/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/clayjohn/subscriptions","organizations_url":"https://api.github.com/users/clayjohn/orgs","repos_url":"https://api.github.com/users/clayjohn/repos","events_url":"https://api.github.com/users/clayjohn/events{/privacy}","received_events_url":"https://api.github.com/users/clayjohn/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2024-12-09T20:05:12Z","updated_at":"2024-12-09T20:08:37Z","body":"I think it would make sense to do the following:\n1. Add an option to disable either the graph, or the parts of the graph that are choking (likely just the dependency detection stuff from dev 6\n2. Place limits on pre-process so this doesn't bite other users (I.e reduce the editor range of the slider and/or warn when hundreds of passes will be created). We can't blame users for dragging a slider all the way to the top and breaking things. \n3. Document the cost of pre-process\n\n_edit: the default range for pre-process is 0-600 seconds:_\nhttps://github.com/godotengine/godot/blob/aa8d9b83f66488dbb2c9c918e9016ef80f821fb4/scene/3d/gpu_particles_3d.cpp#L760\n\nWe could easily reduce this and add the \"is_greater\" option so users can use such a large value at their own risk. ","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2529331853/reactions","total_count":4,"+1":4,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2529390671","html_url":"https://github.com/godotengine/godot/issues/100098#issuecomment-2529390671","issue_url":"https://api.github.com/repos/godotengine/godot/issues/100098","id":2529390671,"node_id":"IC_kwDOAO6SJc6Ww3BP","user":{"login":"darksylinc","id":3395130,"node_id":"MDQ6VXNlcjMzOTUxMzA=","avatar_url":"https://avatars.githubusercontent.com/u/3395130?v=4","gravatar_id":"","url":"https://api.github.com/users/darksylinc","html_url":"https://github.com/darksylinc","followers_url":"https://api.github.com/users/darksylinc/followers","following_url":"https://api.github.com/users/darksylinc/following{/other_user}","gists_url":"https://api.github.com/users/darksylinc/gists{/gist_id}","starred_url":"https://api.github.com/users/darksylinc/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/darksylinc/subscriptions","organizations_url":"https://api.github.com/users/darksylinc/orgs","repos_url":"https://api.github.com/users/darksylinc/repos","events_url":"https://api.github.com/users/darksylinc/events{/privacy}","received_events_url":"https://api.github.com/users/darksylinc/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2024-12-09T20:35:18Z","updated_at":"2024-12-09T20:35:18Z","body":"> No one in their right mind is going to use a large preprocess the way it is now, so it may as well be removed. But this is quite a large breaking change for those that have done so already and wishes to update, as a feature that was available in the engine, is no longer viable.\n\nVisually-wise a preprocess of 10 minutes should not be much different from a preprocess of 10 seconds. If it's very different, then you're also using other extreme values (like ridiculously long lifetime values), or there is a bug in the way the simulation is preprocessed.","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2529390671/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2529623306","html_url":"https://github.com/godotengine/godot/issues/100098#issuecomment-2529623306","issue_url":"https://api.github.com/repos/godotengine/godot/issues/100098","id":2529623306,"node_id":"IC_kwDOAO6SJc6Wxv0K","user":{"login":"DarioSamo","id":538504,"node_id":"MDQ6VXNlcjUzODUwNA==","avatar_url":"https://avatars.githubusercontent.com/u/538504?v=4","gravatar_id":"","url":"https://api.github.com/users/DarioSamo","html_url":"https://github.com/DarioSamo","followers_url":"https://api.github.com/users/DarioSamo/followers","following_url":"https://api.github.com/users/DarioSamo/following{/other_user}","gists_url":"https://api.github.com/users/DarioSamo/gists{/gist_id}","starred_url":"https://api.github.com/users/DarioSamo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/DarioSamo/subscriptions","organizations_url":"https://api.github.com/users/DarioSamo/orgs","repos_url":"https://api.github.com/users/DarioSamo/repos","events_url":"https://api.github.com/users/DarioSamo/events{/privacy}","received_events_url":"https://api.github.com/users/DarioSamo/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2024-12-09T22:04:57Z","updated_at":"2024-12-09T22:04:57Z","body":"> But this is quite a large breaking change for those that have done so already and wishes to update, as a feature that was available in the engine, is no longer viable.\n\nI can't say I agree, even if the graph was behaving exactly like in dev4 or didn't exist at all, the point remains: this use case will run at the risk of blowing up the driver and running into a TDR on a system that isn't using an RTX 4090. The engine shouldn't offer a feature in such a state, it has to employ an strategy to flush such a massive amount of work in sensible chunks.\n\nEven calling swap_buffers() in the preprocess every second of preprocessing time would solve this instantaneously. I do not find any other approach viable to actually ship a game that needs to work on weaker hardware.\n\nThe graph should obviously avoid choking at a workload like this if possible as any system should, but it's very likely to run into problems elsewhere out of the scope of the engine.","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2529623306/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2529681426","html_url":"https://github.com/godotengine/godot/issues/100098#issuecomment-2529681426","issue_url":"https://api.github.com/repos/godotengine/godot/issues/100098","id":2529681426,"node_id":"IC_kwDOAO6SJc6Wx-AS","user":{"login":"DarioSamo","id":538504,"node_id":"MDQ6VXNlcjUzODUwNA==","avatar_url":"https://avatars.githubusercontent.com/u/538504?v=4","gravatar_id":"","url":"https://api.github.com/users/DarioSamo","html_url":"https://github.com/DarioSamo","followers_url":"https://api.github.com/users/DarioSamo/followers","following_url":"https://api.github.com/users/DarioSamo/following{/other_user}","gists_url":"https://api.github.com/users/DarioSamo/gists{/gist_id}","starred_url":"https://api.github.com/users/DarioSamo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/DarioSamo/subscriptions","organizations_url":"https://api.github.com/users/DarioSamo/orgs","repos_url":"https://api.github.com/users/DarioSamo/repos","events_url":"https://api.github.com/users/DarioSamo/events{/privacy}","received_events_url":"https://api.github.com/users/DarioSamo/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2024-12-09T22:35:42Z","updated_at":"2024-12-09T22:36:21Z","body":"https://github.com/godotengine/godot/pull/100222 should hopefully address part of the issue as there was an incorrect detection that was exposed by the workload saturation caused by the particles preprocess.\n\nThe GPU-side of the issue remains unsolved as it is.","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2529681426/reactions","total_count":2,"+1":2,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2529867694","html_url":"https://github.com/godotengine/godot/issues/100098#issuecomment-2529867694","issue_url":"https://api.github.com/repos/godotengine/godot/issues/100098","id":2529867694,"node_id":"IC_kwDOAO6SJc6Wyreu","user":{"login":"produno","id":8760003,"node_id":"MDQ6VXNlcjg3NjAwMDM=","avatar_url":"https://avatars.githubusercontent.com/u/8760003?v=4","gravatar_id":"","url":"https://api.github.com/users/produno","html_url":"https://github.com/produno","followers_url":"https://api.github.com/users/produno/followers","following_url":"https://api.github.com/users/produno/following{/other_user}","gists_url":"https://api.github.com/users/produno/gists{/gist_id}","starred_url":"https://api.github.com/users/produno/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/produno/subscriptions","organizations_url":"https://api.github.com/users/produno/orgs","repos_url":"https://api.github.com/users/produno/repos","events_url":"https://api.github.com/users/produno/events{/privacy}","received_events_url":"https://api.github.com/users/produno/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2024-12-09T23:58:07Z","updated_at":"2024-12-09T23:58:07Z","body":"> I can't say I agree, even if the graph was behaving exactly like in dev4 or didn't exist at all, the point remains: this use case will run at the risk of blowing up the driver and running into a TDR on a system that isn't using an RTX 4090. The engine shouldn't offer a feature in such a state, it has to employ an strategy to flush such a massive amount of work in sensible chunks.\n\nI'm not sure what you mean? I've ran my game that used a 600 preprocess on my laptop, a pc with a 1080ti, a Steam Deck and the demo was downloaded by several hundreds of people and there have been no issues, at least not from me or any reported. The game actually runs very well on the Steam Deck.\n\nThough it sounds like you are saying there was an underlying issue with the way it was implemented previously? If that's the case then obviously it does need to be addressed and fixed but if something worked fine previously and now doesn't, that is a breaking change. If someone updates their released game to Godot 4.4 and now all of a sudden some of their levels are taking several minutes to load instead of several seconds, that could be a problem.\n\n\n> Visually-wise a preprocess of 10 minutes should not be much different from a preprocess of 10 seconds. If it's very different, then you're also using other extreme values (like ridiculously long lifetime values), or there is a bug in the way the simulation is preprocessed.\n\nI also use long lifetime values yeah. I use them for stars and nebulae that will continuously move down the screen. The long preprocess is so the screen is already covered before the game starts. There may be better ways to do this but it done the job, loaded quick, has virtually no performance cost and is easy to manipulate.\n\n","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2529867694/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2529900101","html_url":"https://github.com/godotengine/godot/issues/100098#issuecomment-2529900101","issue_url":"https://api.github.com/repos/godotengine/godot/issues/100098","id":2529900101,"node_id":"IC_kwDOAO6SJc6WyzZF","user":{"login":"DarioSamo","id":538504,"node_id":"MDQ6VXNlcjUzODUwNA==","avatar_url":"https://avatars.githubusercontent.com/u/538504?v=4","gravatar_id":"","url":"https://api.github.com/users/DarioSamo","html_url":"https://github.com/DarioSamo","followers_url":"https://api.github.com/users/DarioSamo/followers","following_url":"https://api.github.com/users/DarioSamo/following{/other_user}","gists_url":"https://api.github.com/users/DarioSamo/gists{/gist_id}","starred_url":"https://api.github.com/users/DarioSamo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/DarioSamo/subscriptions","organizations_url":"https://api.github.com/users/DarioSamo/orgs","repos_url":"https://api.github.com/users/DarioSamo/repos","events_url":"https://api.github.com/users/DarioSamo/events{/privacy}","received_events_url":"https://api.github.com/users/DarioSamo/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2024-12-10T00:19:57Z","updated_at":"2024-12-10T00:19:57Z","body":"> If someone updates their released game to Godot 4.4 and now all of a sudden some of their levels are taking several minutes to load instead of several seconds, that could be a problem.\n\nI'm not talking about the loading times from the CPU side, that much is cleared that it needs to be fixed (and should be fixed with the PR I made). I'm talking about the fact that issuing 600 * 30 (18000) compute dispatches for every single particle system is likely to cause a GPU to crash. It's also abusing the command buffer allocator a lot for one single frame to overallocate far more than it'll ever need. You may not run into it yet, but that is not scalable. TDR value defaults are extremely low and only on the realm of 1-2 seconds usually.","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2529900101/reactions","total_count":2,"+1":2,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2529916793","html_url":"https://github.com/godotengine/godot/issues/100098#issuecomment-2529916793","issue_url":"https://api.github.com/repos/godotengine/godot/issues/100098","id":2529916793,"node_id":"IC_kwDOAO6SJc6Wy3d5","user":{"login":"produno","id":8760003,"node_id":"MDQ6VXNlcjg3NjAwMDM=","avatar_url":"https://avatars.githubusercontent.com/u/8760003?v=4","gravatar_id":"","url":"https://api.github.com/users/produno","html_url":"https://github.com/produno","followers_url":"https://api.github.com/users/produno/followers","following_url":"https://api.github.com/users/produno/following{/other_user}","gists_url":"https://api.github.com/users/produno/gists{/gist_id}","starred_url":"https://api.github.com/users/produno/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/produno/subscriptions","organizations_url":"https://api.github.com/users/produno/orgs","repos_url":"https://api.github.com/users/produno/repos","events_url":"https://api.github.com/users/produno/events{/privacy}","received_events_url":"https://api.github.com/users/produno/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2024-12-10T00:34:08Z","updated_at":"2024-12-10T00:34:08Z","body":"> I'm not talking about the loading times from the CPU side, that much is cleared that it needs to be fixed (and should be fixed with the PR I made). I'm talking about the fact that issuing 600 * 30 (18000) compute dispatches for every single particle system is likely to cause a GPU to crash. It's also abusing the command buffer allocator a lot for one single frame to overallocate far more than it'll ever need. You may not run into it yet, but that is not scalable. TDR value defaults are extremely low and only on the realm of 1-2 seconds usually.\n\nOk, understood. Thanks for explaining.\n\n","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2529916793/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null}]