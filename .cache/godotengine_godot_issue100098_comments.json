[{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2523250609","html_url":"https://github.com/godotengine/godot/issues/100098#issuecomment-2523250609","issue_url":"https://api.github.com/repos/godotengine/godot/issues/100098","id":2523250609,"node_id":"IC_kwDOAO6SJc6WZb-x","user":{"login":"AThousandShips","id":96648715,"node_id":"U_kgDOBcK-Cw","avatar_url":"https://avatars.githubusercontent.com/u/96648715?v=4","gravatar_id":"","url":"https://api.github.com/users/AThousandShips","html_url":"https://github.com/AThousandShips","followers_url":"https://api.github.com/users/AThousandShips/followers","following_url":"https://api.github.com/users/AThousandShips/following{/other_user}","gists_url":"https://api.github.com/users/AThousandShips/gists{/gist_id}","starred_url":"https://api.github.com/users/AThousandShips/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/AThousandShips/subscriptions","organizations_url":"https://api.github.com/users/AThousandShips/orgs","repos_url":"https://api.github.com/users/AThousandShips/repos","events_url":"https://api.github.com/users/AThousandShips/events{/privacy}","received_events_url":"https://api.github.com/users/AThousandShips/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2024-12-06T13:23:52Z","updated_at":"2024-12-06T13:26:44Z","body":"Not sure what the time scale the preprocess is run at, i.e. how much faster than real time it runs\n\nPlease clarify what \"ages\" means, it's very vague here\n\nThis would be a preprocess of 10 minutes, so unsure how long this would be expected to take in real time and what the potential regression would be","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2523250609/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2523281117","html_url":"https://github.com/godotengine/godot/issues/100098#issuecomment-2523281117","issue_url":"https://api.github.com/repos/godotengine/godot/issues/100098","id":2523281117,"node_id":"IC_kwDOAO6SJc6WZjbd","user":{"login":"produno","id":8760003,"node_id":"MDQ6VXNlcjg3NjAwMDM=","avatar_url":"https://avatars.githubusercontent.com/u/8760003?v=4","gravatar_id":"","url":"https://api.github.com/users/produno","html_url":"https://github.com/produno","followers_url":"https://api.github.com/users/produno/followers","following_url":"https://api.github.com/users/produno/following{/other_user}","gists_url":"https://api.github.com/users/produno/gists{/gist_id}","starred_url":"https://api.github.com/users/produno/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/produno/subscriptions","organizations_url":"https://api.github.com/users/produno/orgs","repos_url":"https://api.github.com/users/produno/repos","events_url":"https://api.github.com/users/produno/events{/privacy}","received_events_url":"https://api.github.com/users/produno/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2024-12-06T13:40:58Z","updated_at":"2024-12-06T13:44:28Z","body":"> Not sure what the time scale the preprocess is run at, i.e. how much faster than real time it runs\n> \n> Please clarify what \"ages\" means, it's very vague here\n> \n> This would be a preprocess of 10 minutes, so unsure how long this would be expected to take in real time and what the potential regression would be\n\nAges means way way longer than it should lol. You can check the MRP I added in dev4 and dev 6. You will see a very noticeable difference in load times.\nDev 4 it opens almost instantaneously. Dev 6 takes several minutes.\n\nI use particles on my main menu and my game takes 3-4 mins to load that menu. If I disable particles, it takes around 10 seconds.","author_association":"NONE","pin":null,