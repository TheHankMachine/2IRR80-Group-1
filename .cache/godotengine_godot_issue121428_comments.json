[{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5103671256","html_url":"https://github.com/godotengine/godot/issues/121428#issuecomment-5103671256","issue_url":"https://api.github.com/repos/godotengine/godot/issues/121428","id":5103671256,"node_id":"IC_kwDOAO6SJc8AAAABMDPX2A","user":{"login":"tciviero","id":179772110,"node_id":"U_kgDOCrcazg","avatar_url":"https://avatars.githubusercontent.com/u/179772110?v=4","gravatar_id":"","url":"https://api.github.com/users/tciviero","html_url":"https://github.com/tciviero","followers_url":"https://api.github.com/users/tciviero/followers","following_url":"https://api.github.com/users/tciviero/following{/other_user}","gists_url":"https://api.github.com/users/tciviero/gists{/gist_id}","starred_url":"https://api.github.com/users/tciviero/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/tciviero/subscriptions","organizations_url":"https://api.github.com/users/tciviero/orgs","repos_url":"https://api.github.com/users/tciviero/repos","events_url":"https://api.github.com/users/tciviero/events{/privacy}","received_events_url":"https://api.github.com/users/tciviero/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-07-28T11:41:53Z","updated_at":"2026-07-28T11:41:53Z","body":"I will take a look at this issue and post an update when I make progress finding a fix.","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5103671256/reactions","total_count":1,"+1":0,"-1":0,"laugh":0,"hooray":1,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5113810381","html_url":"https://github.com/godotengine/godot/issues/121428#issuecomment-5113810381","issue_url":"https://api.github.com/repos/godotengine/godot/issues/121428","id":5113810381,"node_id":"IC_kwDOAO6SJc8AAAABMM6NzQ","user":{"login":"tciviero","id":179772110,"node_id":"U_kgDOCrcazg","avatar_url":"https://avatars.githubusercontent.com/u/179772110?v=4","gravatar_id":"","url":"https://api.github.com/users/tciviero","html_url":"https://github.com/tciviero","followers_url":"https://api.github.com/users/tciviero/followers","following_url":"https://api.github.com/users/tciviero/following{/other_user}","gists_url":"https://api.github.com/users/tciviero/gists{/gist_id}","starred_url":"https://api.github.com/users/tciviero/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/tciviero/subscriptions","organizations_url":"https://api.github.com/users/tciviero/orgs","repos_url":"https://api.github.com/users/tciviero/repos","events_url":"https://api.github.com/users/tciviero/events{/privacy}","received_events_url":"https://api.github.com/users/tciviero/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-07-29T05:59:44Z","updated_at":"2026-07-29T06:03:52Z","body":"The issue is NOT caused by upgrading from an older version like 4.5 to 4.6, 4.7 or 4.8, is simply that in those versions editable children is broken. I manage to replicate this issue on 4.8.dev.custom_build. 159701651ad44335691dcbd632d8074307074c7b  without needing to upgrade from 4.5.\n\n1. create a base scene with a node and a mesh instance 3D as its child and save the scene.\n2. create a simple material resource with an albedo color.\n3. create a new scene with a node and put the base scene as its child, set the base scene as Editable Children, and set the material override of the mesh instance 3D to the material created. Changing the material albedo color will also change the mesh color and vice versa.\n4. save and restart project.\n5. Changing the material albedo color will now not change the mesh color and vice versa.\n\nThe issue does not happen before restarting, so it is related to how godot loads the editable children node from disk, rather than how it is created on run-time.\n","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5113810381/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5139715103","html_url":"https://github.com/godotengine/godot/issues/121428#issuecomment-5139715103","issue_url":"https://api.github.com/repos/godotengine/godot/issues/121428","id":5139715103,"node_id":"IC_kwDOAO6SJc8AAAABMlnUHw","user":{"login":"tciviero","id":179772110,"node_id":"U_kgDOCrcazg","avatar_url":"https://avatars.githubusercontent.com/u/179772110?v=4","gravatar_id":"","url":"https://api.github.com/users/tciviero","html_url":"https://github.com/tciviero","followers_url":"https://api.github.com/users/tciviero/followers","following_url":"https://api.github.com/users/tciviero/following{/other_user}","gists_url":"https://api.github.com/users/tciviero/gists{/gist_id}","starred_url":"https://api.github.com/users/tciviero/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/tciviero/subscriptions","organizations_url":"https://api.github.com/users/tciviero/orgs","repos_url":"https://api.github.com/users/tciviero/repos","events_url":"https://api.github.com/users/tciviero/events{/privacy}","received_events_url":"https://api.github.com/users/tciviero/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-07-31T05:44:16Z","updated_at":"2026-07-31T05:56:42Z","body":"Bisected the regression to commit 1b4f116db14123b4cfab655de40d2e4f81aea517 (introduced in PR #64487).","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5139715103/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5514369081","html_url":"https://github.com/godotengine/godot/issues/121428#issuecomment-5514369081","issue_url":"https://api.github.com/repos/godotengine/godot/issues/121428","id":5514369081,"node_id":"IC_kwDOAO6SJc8AAAABSK6YOQ","user":{"login":"Leonardo-Ma","id":68714883,"node_id":"MDQ6VXNlcjY4NzE0ODgz","avatar_url":"https://avatars.githubusercontent.com/u/68714883?v=4","gravatar_id":"","url":"https://api.github.com/users/Leonardo-Ma","html_url":"https://github.com/Leonardo-Ma","followers_url":"https://api.github.com/users/Leonardo-Ma/followers","following_url":"https://api.github.com/users/Leonardo-Ma/following{/other_user}","gists_url":"https://api.github.com/users/Leonardo-Ma/gists{/gist_id}","starred_url":"https://api.github.com/users/Leonardo-Ma/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Leonardo-Ma/subscriptions","organizations_url":"https://api.github.com/users/Leonardo-Ma/orgs","repos_url":"https://api.github.com/users/Leonardo-Ma/repos","events_url":"https://api.github.com/users/Leonardo-Ma/events{/privacy}","received_events_url":"https://api.github.com/users/Leonardo-Ma/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-09-02T18:25:45Z","updated_at":"2026-09-02T18:25:45Z","body":"Happens to me just by reopening the children scene (4.7 & 4.8dev 3 & 4). Strange that it happens even using an external resource in both parent and child.\nThis is the third problem I have git complaining whenever I open a scene without changing anything, since some people don't use vcs, this is probably more common than expected/reported.\n\nThe linked PR does fix it!","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5514369081/reactions","total_count":1,"+1":0,"-1":0,"laugh":0,"hooray":1,"confused":0,"heart":0,"rocket":0,"eyes":0},"