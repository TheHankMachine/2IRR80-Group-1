ithub.com/users/AThousandShips/subscriptions","organizations_url":"https://api.github.com/users/AThousandShips/orgs","repos_url":"https://api.github.com/users/AThousandShips/repos","events_url":"https://api.github.com/users/AThousandShips/events{/privacy}","received_events_url":"https://api.github.com/users/AThousandShips/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-08-14T14:07:31Z","updated_at":"2026-08-14T14:07:31Z","body":"Did you forget to update the example/MRP?","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5294240892/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5295903976","html_url":"https://github.com/godotengine/godot/issues/122411#issuecomment-5295903976","issue_url":"https://api.github.com/repos/godotengine/godot/issues/122411","id":5295903976,"node_id":"IC_kwDOAO6SJc8AAAABO6kU6A","user":{"login":"wjt","id":86760,"node_id":"MDQ6VXNlcjg2NzYw","avatar_url":"https://avatars.githubusercontent.com/u/86760?v=4","gravatar_id":"","url":"https://api.github.com/users/wjt","html_url":"https://github.com/wjt","followers_url":"https://api.github.com/users/wjt/followers","following_url":"https://api.github.com/users/wjt/following{/other_user}","gists_url":"https://api.github.com/users/wjt/gists{/gist_id}","starred_url":"https://api.github.com/users/wjt/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/wjt/subscriptions","organizations_url":"https://api.github.com/users/wjt/orgs","repos_url":"https://api.github.com/users/wjt/repos","events_url":"https://api.github.com/users/wjt/events{/privacy}","received_events_url":"https://api.github.com/users/wjt/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-08-14T16:50:47Z","updated_at":"2026-08-14T16:50:57Z","body":"I've updated the description and the MRP to show more cases. I agree that the documentation can be read in different ways to the way I read it, but I think the current behaviour is not internally consistent even so. In particular, the path from an aunt or cousin node to a node with a unique name uses the unique name; but the path from the scene root (their common ancestor) does not.\n\n(My original goal here was that, in a save file, I want to be able to store an identifier for a node within a particular scene. Using the unique name for that node within the scene is more robust against the scene tree changing between versions of the game. I am prepared to be told that this is a bad design and I should have some other custom identifier for such nodes :) but \"unique name within scene path/UID\" is a perfectly good ID that we can arrange to keep stable.)","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5295903976/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null}]