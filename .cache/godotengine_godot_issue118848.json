54:35Z"},"comments":1,"created_at":"2026-04-22T11:40:48Z","updated_at":"2026-04-23T13:40:56Z","closed_at":"2026-04-23T13:40:50Z","assignee":null,"author_association":"CONTRIBUTOR","issue_field_values":[],"type":null,"active_lock_reason":null,"draft":false,"pull_request":{"url":"https://api.github.com/repos/godotengine/godot/pulls/118848","html_url":"https://github.com/godotengine/godot/pull/118848","diff_url":"https://github.com/godotengine/godot/pull/118848.diff","patch_url":"https://github.com/godotengine/godot/pull/118848.patch","merged_at":"2026-04-23T13:40:50Z"},"body":"Fixes #118834\r\n\r\nBefore:\r\n\r\n<img width=\"498\" height=\"278\" alt=\"Image\" src=\"https://github.com/user-attachments/assets/eacf504b-39fa-49f5-b8b3-948d10f27c3d\" />\r\n\r\nAfter:\r\n\r\n<img width=\"452\" height=\"300\" alt=\"Image\" src=\"https://github.com/user-attachments/assets/42afe9a3-ecca-47de-90f4-b5392589b0e0\" />\r\n\r\nI looked through a lot of code related to IMM, and most implementations follow the same pattern:\r\n\r\n1. Call `ImmSetCompositionWindow` with `CFS_POINT`\r\n2. Call `ImmSetCandidateWindow` with `CFS_CANDIDATEPOS` for compatibility with classic (older) IMEs\r\n3. Call `ImmSetCandidateWindow` with `CFS_EXCLUDE`\r\n\r\nThese are usually applied together to place them in the same location, rather than being used independently.\r\n\r\nSome frameworks check whether the current language is `LANG_ZH` in step 2, and if so, they skip calling `ImmSetCandidateWindow` with `CFS_EXCLUDE`. As mentioned above, this is mainly for compatibility reasons.\r\n\r\nFor step 3, when calling `ImmSetCandidateWindow` with `CFS_EXCLUDE`, the ideal input is a rectangle with some caret margin added. Right now, it is effectively just using a point. The expected usage is a rectangle, but the current behavior still appears to work correctly.\r\n","closed_by":{"login":"Repiteo","id":17489292,"node_id":"MDQ6VXNlcjE3NDg5Mjky","avatar_url":"https://avatars.githubusercontent.com/u/17489292?v=4","gravatar_id":"","url":"https://api.github.com/users/Repiteo","html_url":"https://github.com/Repiteo","followers_url":"https://api.github.com/users/Repiteo/followers","following_url":"https://api.github.com/users/Repiteo/following{/other_user}","gists_url":"https://api.github.com/users/Repiteo/gists{/gist_id}","starred_url":"https://api.github.com/users/Repiteo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Repiteo/subscriptions","organizations_url":"https://api.github.com/users/Repiteo/orgs","repos_url":"https://api.github.com/users/Repiteo/repos","events_url":"https://api.github.com/users/Repiteo/events{/privacy}","received_events_url":"https://api.github.com/users/Repiteo/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/118848/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/godotengine/godot/issues/118848/timeline","performed_via_github_app":null,"state_reason":null}