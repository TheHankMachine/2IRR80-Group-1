\t\t}\n \t\t\t}\n```","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2569952286/reactions","total_count":2,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":2,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2569975080","html_url":"https://github.com/godotengine/godot/issues/100922#issuecomment-2569975080","issue_url":"https://api.github.com/repos/godotengine/godot/issues/100922","id":2569975080,"node_id":"IC_kwDOAO6SJc6ZLrUo","user":{"login":"Macksaur","id":86566939,"node_id":"MDQ6VXNlcjg2NTY2OTM5","avatar_url":"https://avatars.githubusercontent.com/u/86566939?v=4","gravatar_id":"","url":"https://api.github.com/users/Macksaur","html_url":"https://github.com/Macksaur","followers_url":"https://api.github.com/users/Macksaur/followers","following_url":"https://api.github.com/users/Macksaur/following{/other_user}","gists_url":"https://api.github.com/users/Macksaur/gists{/gist_id}","starred_url":"https://api.github.com/users/Macksaur/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Macksaur/subscriptions","organizations_url":"https://api.github.com/users/Macksaur/orgs","repos_url":"https://api.github.com/users/Macksaur/repos","events_url":"https://api.github.com/users/Macksaur/events{/privacy}","received_events_url":"https://api.github.com/users/Macksaur/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-01-04T01:00:23Z","updated_at":"2025-01-04T01:00:23Z","body":"Thank you for these extra details! I couldn't figure it out 😅 What an easy fix, wew, I am glad!\n\nI tested the linked PR and everything seems well, thanks!","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2569975080/reactions","total_count":1,"+1":0,"-1":0,"laugh":0,"hooray":1,"confused":0