hived_by":null},{"id":283518733,"node_id":"MDU6TGFiZWwyODM1MTg3MzM=","url":"https://api.github.com/repos/godotengine/godot/labels/usability","name":"usability","color":"447744","default":false,"description":"","archived_at":null,"archived_by":null}],"state":"closed","locked":false,"assignees":[],"milestone":{"url":"https://api.github.com/repos/godotengine/godot/milestones/23","html_url":"https://github.com/godotengine/godot/milestone/23","labels_url":"https://api.github.com/repos/godotengine/godot/milestones/23/labels","id":12939969,"node_id":"MI_kwDOAO6SJc4AxXLB","number":23,"title":"4.6","description":"","creator":{"login":"Repiteo","id":17489292,"node_id":"MDQ6VXNlcjE3NDg5Mjky","avatar_url":"https://avatars.githubusercontent.com/u/17489292?v=4","gravatar_id":"","url":"https://api.github.com/users/Repiteo","html_url":"https://github.com/Repiteo","followers_url":"https://api.github.com/users/Repiteo/followers","following_url":"https://api.github.com/users/Repiteo/following{/other_user}","gists_url":"https://api.github.com/users/Repiteo/gists{/gist_id}","starred_url":"https://api.github.com/users/Repiteo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Repiteo/subscriptions","organizations_url":"https://api.github.com/users/Repiteo/orgs","repos_url":"https://api.github.com/users/Repiteo/repos","events_url":"https://api.github.com/users/Repiteo/events{/privacy}","received_events_url":"https://api.github.com/users/Repiteo/received_events","type":"User","user_view_type":"public","site_admin":false},"open_issues":3,"closed_issues":2978,"state":"closed","created_at":"2025-05-22T16:25:52Z","updated_at":"2026-10-04T16:23:23Z","due_on":null,"closed_at":"2026-01-26T18:09:14Z"},"comments":3,"created_at":"2025-11-20T20:51:50Z","updated_at":"2026-02-07T12:36:11Z","closed_at":"2025-11-24T22:18:30Z","assignee":null,"author_association":"MEMBER","issue_field_values":[],"type":null,"active_lock_reason":null,"draft":false,"pull_request":{"url":"https://api.github.com/repos/godotengine/godot/pulls/112996","html_url":"https://github.com/godotengine/godot/pull/112996","diff_url":"https://github.com/godotengine/godot/pull/112996.diff","patch_url":"https://github.com/godotengine/godot/pull/112996.patch","merged_at":"2025-11-24T22:18:30Z"},"body":"- Related to https://github.com/godotengine/godot/pull/101787\r\n\r\nThis moves the \"History\" dock to the bottom left (next to `FileSystem`) by default, instead of the top right (next to `Inspector` and `Node`).\r\nOriginally suggested by @Mickeon in chat.\r\n\r\n<img width=\"1392\" height=\"834\" alt=\"SCR-20251120-svci\" src=\"https://github.com/user-attachments/assets/1ed5b361-8572-4b7f-af6a-205062d469f8\" />\r\n\r\n**My reasoning:** \r\n- The top right slot otherwise relates to the current edited `Node`/`Object`. `History` has no particular relation to the current edited `Node`.\r\n- The top right slot is somewhat crowded, especially if https://github.com/godotengine/godot/pull/101787 is merged.\r\n- The bottom left slot is pretty empty. Especially, `FileSystem` is often used, but `History` is probably rarely used. That makes it a good candidate to pair them.\r\n- The dock fits in the bottom left thematically. While \"Scene\" does influence it (so it could arguably be in the top left slot), it is generally global, and makes the \"Scene\" relation clear with a checkbox.\r\n","closed_by":{"login":"Repiteo","id":17489292,"node_id":"MDQ6VXNlcjE3NDg5Mjky","avatar_url":"https://avatars.githubusercontent.com/u/17489292?v=4","gravatar_id":"","url":"https://api.github.com/users/Repiteo","html_url":"https://github.com/Repiteo","followers_url":"https://api.github.com/users/Repiteo/followers","following_url":"https://api.github.com/users/Repiteo/following{/other_user}","gists_url":"https://api.github.com/users/Repiteo/gists{/gist_id}","starred_url":"https://api.github.com/users/Repiteo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Repiteo/subscriptions","organizations_url":"https://api.github.com/users/Repiteo/orgs","repos_url":"https://api.github.com/users/Repiteo/repos","events_url":"https://api.github.com/users/Repiteo/events{/privacy}","received_events_url":"https://api.github.com/users/Repiteo/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/112996/reactions","total_count":25,"+1":25,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/godotengine/godot/issues/112996/timeline","performed_via_github_app":null,"state_reason":null}