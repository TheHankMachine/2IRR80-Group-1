:null,"archived_by":null},{"id":2666708289,"node_id":"MDU6TGFiZWwyNjY2NzA4Mjg5","url":"https://api.github.com/repos/godotengine/godot/labels/topic:3d","name":"topic:3d","color":"ffee88","default":false,"description":"","archived_at":null,"archived_by":null}],"state":"closed","locked":false,"assignees":[],"milestone":{"url":"https://api.github.com/repos/godotengine/godot/milestones/25","html_url":"https://github.com/godotengine/godot/milestone/25","labels_url":"https://api.github.com/repos/godotengine/godot/milestones/25/labels","id":15520464,"node_id":"MI_kwDOAO6SJc4A7NLQ","number":25,"title":"4.8","description":"","creator":{"login":"Repiteo","id":17489292,"node_id":"MDQ6VXNlcjE3NDg5Mjky","avatar_url":"https://avatars.githubusercontent.com/u/17489292?v=4","gravatar_id":"","url":"https://api.github.com/users/Repiteo","html_url":"https://github.com/Repiteo","followers_url":"https://api.github.com/users/Repiteo/followers","following_url":"https://api.github.com/users/Repiteo/following{/other_user}","gists_url":"https://api.github.com/users/Repiteo/gists{/gist_id}","starred_url":"https://api.github.com/users/Repiteo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Repiteo/subscriptions","organizations_url":"https://api.github.com/users/Repiteo/orgs","repos_url":"https://api.github.com/users/Repiteo/repos","events_url":"https://api.github.com/users/Repiteo/events{/privacy}","received_events_url":"https://api.github.com/users/Repiteo/received_events","type":"User","user_view_type":"public","site_admin":false},"open_issues":351,"closed_issues":2337,"state":"open","created_at":"2026-04-13T15:59:35Z","updated_at":"2026-10-22T15:17:38Z","due_on":null,"closed_at":null},"comments":14,"created_at":"2025-09-25T21:31:24Z","updated_at":"2026-07-09T18:48:09Z","closed_at":"2026-06-18T18:19:40Z","assignee":null,"author_association":"CONTRIBUTOR","issue_field_values":[],"type":null,"active_lock_reason":null,"draft":false,"pull_request":{"url":"https://api.github.com/repos/godotengine/godot/pulls/110911","html_url":"https://github.com/godotengine/godot/pull/110911","diff_url":"https://github.com/godotengine/godot/pull/110911.diff","patch_url":"https://github.com/godotengine/godot/pull/110911.patch","merged_at":"2026-06-18T18:19:40Z"},"body":"In the RD renderers, if we are using fog and a solid colour background, ```clear_color``` should not be in linear encoding before being passed to the shader, as this will be converted again later. If we are using a solid colour background and not using fog, the energy needs to be multiplied _after_ converting to linear encoding. In scenarios where the sky is drawn and we are not using fog or not using solid colour background, the multiplication happens in the shader.\r\n\r\nCompatibility is similar except after the energy is multiplied in, ```clear_color``` needs to be converted back to non-linear srgb encoding. This pr also moves the energy multiplication in the shader to be after converting the fragment colour to linear encoding.\r\n\r\nThis should:\r\n- Apply brightness multipliers for the sky on colours with the correct color encoding.\r\n- Fix applying the brightness multiplier twice with solid colour background and fog.\r\n- Fix incorrectly passing ```clear_color``` with linear encoding to sky material in the RD renderers, which converts it again later.\r\n\r\nFixes https://github.com/godotengine/godot/issues/108779","closed_by":{"login":"Repiteo","id":17489292,"node_id":"MDQ6VXNlcjE3NDg5Mjky","avatar_url":"https://avatars.githubusercontent.com/u/17489292?v=4","gravatar_id":"","url":"https://api.github.com/users/Repiteo","html_url":"https://github.com/Repiteo","followers_url":"https://api.github.com/users/Repiteo/followers","following_url":"https://api.github.com/users/Repiteo/following{/other_user}","gists_url":"https://api.github.com/users/Repiteo/gists{/gist_id}","starred_url":"https://api.github.com/users/Repiteo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Repiteo/subscriptions","organizations_url":"https://api.github.com/users/Repiteo/orgs","repos_url":"https://api.github.com/users/Repiteo/repos","events_url":"https://api.github.com/users/Repiteo/events{/privacy}","received_events_url":"https://api.github.com/users/Repiteo/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/110911/reactions","total_count":3,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":2},"timeline_url":"https://api.github.com/repos/godotengine/godot/issues/110911/timeline","performed_via_github_app":null,"state_reason":null}