[{"id":3250080577,"node_id":"PRR_kwDOAO6SJc7BuEtB","user":{"login":"Ivorforce","id":2308167,"node_id":"MDQ6VXNlcjIzMDgxNjc=","avatar_url":"https://avatars.githubusercontent.com/u/2308167?u=f7f8e0273f784f5ec6f6b7fe4a88d449896eb48a&v=4","gravatar_id":"","url":"https://api.github.com/users/Ivorforce","html_url":"https://github.com/Ivorforce","followers_url":"https://api.github.com/users/Ivorforce/followers","following_url":"https://api.github.com/users/Ivorforce/following{/other_user}","gists_url":"https://api.github.com/users/Ivorforce/gists{/gist_id}","starred_url":"https://api.github.com/users/Ivorforce/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Ivorforce/subscriptions","organizations_url":"https://api.github.com/users/Ivorforce/orgs","repos_url":"https://api.github.com/users/Ivorforce/repos","events_url":"https://api.github.com/users/Ivorforce/events{/privacy}","received_events_url":"https://api.github.com/users/Ivorforce/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"These functions are still needed:\r\n- `StringName(const char *)` can be faster (about 60%) than `StringName(const String &)` if no `String` exists yet, but a `StringName` entry does exist. This can be relevant depending on the application.\r\n- `p_static` is needed because only `StringName` constructed with `p_static=true` are allowed to persist at Godot exit. Otherwise, the engine will complain about orphan `StringName`. This is used quite a lot in the engine, for example for the `SNAME` macro.\r\n\r\nIf this is not clear from the gdextension interface, we should definitely update the documentation on this.","state":"CHANGES_REQUESTED","html_url":"https://github.com/godotengine/godot/pull/110744#pullrequestreview-3250080577","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/110744","author_association":"MEMBER","_links":{"html":{"href":"https://github.com/godotengine/godot/pull/110744#pullrequestreview-325008