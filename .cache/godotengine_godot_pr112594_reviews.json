[{"id":3444493509,"node_id":"PRR_kwDOAO6SJc7NTszF","user":{"login":"Repiteo","id":17489292,"node_id":"MDQ6VXNlcjE3NDg5Mjky","avatar_url":"https://avatars.githubusercontent.com/u/17489292?u=34072b401722100a7c0c0d61e37b376cf22b4545&v=4","gravatar_id":"","url":"https://api.github.com/users/Repiteo","html_url":"https://github.com/Repiteo","followers_url":"https://api.github.com/users/Repiteo/followers","following_url":"https://api.github.com/users/Repiteo/following{/other_user}","gists_url":"https://api.github.com/users/Repiteo/gists{/gist_id}","starred_url":"https://api.github.com/users/Repiteo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Repiteo/subscriptions","organizations_url":"https://api.github.com/users/Repiteo/orgs","repos_url":"https://api.github.com/users/Repiteo/repos","events_url":"https://api.github.com/users/Repiteo/events{/privacy}","received_events_url":"https://api.github.com/users/Repiteo/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"Note that adds `workflow_dispatch` to `runner.yml` and `static_checks.yml`, which aren't technically the platform CI. That's not a blocker though; on the contrary, it's a very convenient addition!\n\nOne thing to keep in mind with this setup is that the concurrency is only defined at the `runner.yml` level, so a `workflow_dispatch` will NOT cancel an existing workflow. That's probably for the best though, as this allows running multiple specific platform dispatches in tandem. Something more complex than that might need a more involved system, which I can look into after this is integrated, but this'll be good to merge as-is","state":"APPROVED","html_url":"https://github.com/godotengine/godot/pull/112594#pullrequestreview-3444493509","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/112594","author_association":"CONTRIBUTOR","_links":{"html":{"href":"https://github.com/godotengine/godot/pull/112594#pullrequestreview-3444493509"},"pul