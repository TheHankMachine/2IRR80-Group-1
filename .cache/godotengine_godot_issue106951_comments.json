pi.github.com/users/fire/followers","following_url":"https://api.github.com/users/fire/following{/other_user}","gists_url":"https://api.github.com/users/fire/gists{/gist_id}","starred_url":"https://api.github.com/users/fire/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/fire/subscriptions","organizations_url":"https://api.github.com/users/fire/orgs","repos_url":"https://api.github.com/users/fire/repos","events_url":"https://api.github.com/users/fire/events{/privacy}","received_events_url":"https://api.github.com/users/fire/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-06-02T00:36:09Z","updated_at":"2025-06-02T00:36:09Z","body":"Let me try message you. \r\n\r\nI wanted to double check that the https://github.com/godotengine/godot/files/13539578/INV_VIEW_MATRIX.bug.Game.Project.zip MRP would be fixed in the situation where the camera is far away from the origin due to concerns from @clayjohn ","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2928210213/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2928216170","html_url":"https://github.com/godotengine/godot/pull/106951#issuecomment-2928216170","issue_url":"https://api.github.com/repos/godotengine/godot/issues/106951","id":2928216170,"node_id":"IC_kwDOAO6SJc6uiQhq","user":{"login":"celyk","id":50609684,"node_id":"MDQ6VXNlcjUwNjA5Njg0","avatar_url":"https://avatars.githubusercontent.com/u/50609684?v=4","gravatar_id":"","url":"https://api.github.com/users/celyk","html_url":"https://github.com/celyk","followers_url":"https://api.github.com/users/celyk/followers","following_url":"https://api.github.com/users/celyk/following{/other_user}","gists_url":"https://api.github.com/users/celyk/gists{/gist_id}","starred_url":"https://api.github.com/users/celyk/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/celyk/subscriptions","organizations_url":"https://api.github.com/users/celyk/orgs","repos_url":"https://api.github.com/users/celyk/repos","events_url":"https://api.github.com/users/celyk/events{/privacy}","received_events_url":"https://api.github.com/users/celyk/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-06-02T00:41:21Z","updated_at":"2025-06-02T00:41:21Z","body":"No that will not be fixed, because my PR only applies to MODELVIEW_MATRIX. But I'm thinking of making a proposal for how the other transforms can be addressed","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2928216170/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2928241091","html_url":"https://github.com/godotengine/godot/pull/106951#issuecomment-2928241091","issue_url":"https://api.github.com/repos/godotengine/godot/issues/106951","id":2928241091,"node_id":"IC_kwDOAO6SJc6uiWnD","user":{"login":"celyk","id":50609684,"node_id":"MDQ6VXNlcjUwNjA5Njg0","avatar_url":"https://avatars.githubusercontent.com/u/50609684?v=4","gravatar_id":"","url":"https://api.github.com/users/celyk","html_url":"https://github.com/celyk","followers_url":"https://api.github.com/users/celyk/followers","following_url":"https://api.github.com/users/celyk/following{/other_user}","gists_url":"https://api.github.com/users/celyk/gists{/gist_id}","starred_url":"https://api.github.com/users/celyk/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/celyk/subscriptions","organizations_url":"https://api.github.com/users/celyk/orgs","repos_url":"https://api.github.com/users/celyk/repos","events_url":"https://api.github.com/users/celyk/events{/privacy}","received_events_url":"https://api.github.com/users/celyk/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-06-02T00:56:22Z","updated_at":"2025-06-02T00:56:22Z","body":"To elaborate on my idea of a helper function, here's some example code (untested)\r\n```glsl\r\n// Multiplies a double mat4 with a double vec3\r\nmat4 double_mul_mat4_vec3(mat4 base_a, vec3 prec_a, vec3 base_b, vec3 prec_b, out vec3 out_precision) {\r\n\t// Assume that M * vec4(p,1) == M[3].xyz + mat3(M) * p\r\n\tbase_b = mat3(base_a) * base_b;\r\n\tbase_b = double_add_vec3(base_a[3].xyz, prec_a, base_b, prec_b, out_precision);\r\n\treturn base_b;\r\n}\r\n\r\n// Multiplies a double mat4 with a double mat4\r\nmat4 double_mul_mat4(mat4 base_a, vec3 prec_a, mat4 base_b, vec3 prec_b, out vec3 out_precision) {\r\n\t// Only the translation part supports double precision at the moment.\r\n\r\n\t// Single precision transform just to fill the mat3 basis. Ignore the last column\r\n\tmat4 T = base_a * base_b;\r\n\r\n\t// Transform the origin of base_b, and pass out the error term\r\n\tT[3].xyz = double_mul_mat4_vec3(base_a, prec_a, base_b[3].xyz, prec_b, out_precision);\r\n\r\n\treturn T;\r\n}\r\n#endif\r\n```\r\n\r\nIf I'm correct this should allow arbitrary concatenation of transforms, and this PR would reduce to:\r\n```C\r\n#ifdef USE_DOUBLE_PRECISION\r\n\tvec3 temp_precision;\r\n\tmat4 modelview = double_mul_mat4(scene_data.view_matrix, view_precision, model_matrix, model_precision, temp_precision);\r\n#else\r\n\tmat4 modelview = scene_data.view_matrix * model_matrix;\r\n#endif\r\n```","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2928241091/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2928265654","html_url":"https://github.com/godotengine/godot/pull/106951#issuecomment-2928265654","issue_url":"https://api.github.com/repos/godotengine/godot/issues/106951","id":2928265654,"node_id":"IC_kwDOAO6SJc6uicm2","user":{"login":"celyk","id":50609684,"node_id":"MDQ6VXNlcjUwNjA5Njg0","avatar_url":"https://avatars.githubusercontent.com/u/50609684?v=4","gravatar_id":"","url":"https://api.github.com/users/celyk","html_url":"https://github.com/celyk","followers_url":"https://api.github.com/users/celyk/followers","following_url":"https://api.github.com/users/celyk/following{/other_user}","gists_url":"https://api.github.com/users/celyk/gists{/gist_id}","starred_url":"https://api.github.com/users/celyk/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/celyk/subscriptions","organizations_url":"https://api.github.com/users/celyk/orgs","repos_url":"https://api.github.com/users/celyk/repos","events_url":"https://api.github.com/users/celyk/events{/privacy}","received_events_url":"https://api.github.com/users/celyk/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-06-02T01:09:19Z","updated_at":"2025-06-02T01:09:19Z","body":"Hmmm, double_mul_mat4_vec3() looks wrong for transforming base_b with single precision. The reason this is ok in the PR is we know the vector is already small relative to the camera.","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2928265654/reactions","total_count":2,"+1":2,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2998578591","html_url":"https://github.com/godotengine/godot/pull/106951#issuecomment-2998578591","issue_url":"https://api.github.com/repos/godotengine/godot/issues/106951","id":2998578591,"node_id":"IC_kwDOAO6SJc6yuq2f","user":{"login