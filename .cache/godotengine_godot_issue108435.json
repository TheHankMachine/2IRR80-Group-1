ic:editor","color":"ffee88","default":false,"description":"","archived_at":null,"archived_by":null},{"id":1332303119,"node_id":"MDU6TGFiZWwxMzMyMzAzMTE5","url":"https://api.github.com/repos/godotengine/godot/labels/regression","name":"regression","color":"ff63ac","default":false,"description":"","archived_at":null,"archived_by":null},{"id":2666708289,"node_id":"MDU6TGFiZWwyNjY2NzA4Mjg5","url":"https://api.github.com/repos/godotengine/godot/labels/topic:3d","name":"topic:3d","color":"ffee88","default":false,"description":"","archived_at":null,"archived_by":null},{"id":3240950060,"node_id":"MDU6TGFiZWwzMjQwOTUwMDYw","url":"https://api.github.com/repos/godotengine/godot/labels/performance","name":"performance","color":"447777","default":false,"description":"","archived_at":null,"archived_by":null}],"state":"closed","locked":false,"assignees":[],"milestone":{"url":"https://api.github.com/repos/godotengine/godot/milestones/22","html_url":"https://github.com/godotengine/godot/milestone/22","labels_url":"https://api.github.com/repos/godotengine/godot/milestones/22/labels","id":12070367,"node_id":"MI_kwDOAO6SJc4AuC3f","number":22,"title":"4.5","description":"","creator":{"login":"Sauermann","id":6299227,"node_id":"MDQ6VXNlcjYyOTkyMjc=","avatar_url":"https://avatars.githubusercontent.com/u/6299227?v=4","gravatar_id":"","url":"https://api.github.com/users/Sauermann","html_url":"https://github.com/Sauermann","followers_url":"https://api.github.com/users/Sauermann/followers","following_url":"https://api.github.com/users/Sauermann/following{/other_user}","gists_url":"https://api.github.com/users/Sauermann/gists{/gist_id}","starred_url":"https://api.github.com/users/Sauermann/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Sauermann/subscriptions","organizations_url":"https://api.github.com/users/Sauermann/orgs","repos_url":"https://api.github.com/users/Sauermann/repos","events_url":"https://api.github.com/users/Sauermann/events{/privacy}","received_events_url":"https://api.github.com/users/Sauermann/received_events","type":"User","user_view_type":"public","site_admin":false},"open_issues":3,"closed_issues":3687,"state":"closed","created_at":"2024-12-19T08:51:28Z","updated_at":"2026-09-04T21:48:38Z","due_on":"2025-09-15T00:00:00Z","closed_at":"2025-09-18T17:13:14Z"},"comments":3,"created_at":"2025-07-09T13:44:51Z","updated_at":"2025-07-31T14:33:28Z","closed_at":"2025-07-10T16:49:57Z","assignee":null,"author_association":"NONE","issue_field_values":[],"type":null,"active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"### Tested versions\n\n- Reproducible in 4.5.dev5 and later (up to 4.5.beta3)\n- Non reproducible in 4.5.dev4 or previous versions, also not reproducible in 4.4.1\n\n\n### System information\n\nWindows 10 pro 22H2 - Godot 4.5.dev5 - Forward+ - dedicated AMD Radeon RX 6700 XT\n\n### Issue description\n\nThis issue is very similar to https://github.com/godotengine/godot/issues/105248 but please notice that that issue was about a performance regression from 4.3 to 4.4.1 (and that relates to the changes made in https://github.com/godotengine/godot/pull/90644) and this issue is another big performance regression on top of that other one that starts with 4.5.dev5, and it might be caused by something totally different.\n\nThe performance hit increases (sort of exponentially I think) with the number of collision shapes to show.\n\nThe performance hit affects CPU TIME, not the FPS or the GPU in any way.\n\nSo for example for 15000 collision shapes in 4.5.dev4:\n\n<img width=\"1394\" height=\"882\" alt=\"Image\" src=\"https://github.com/user-attachments/assets/cdac2fcf-983c-4b96-a72a-e6504f7275eb\" />\n\nand the same 15000 collision shapes in 4.5.dev5:\n\n<img width=\"1394\" height=\"882\" alt=\"Image\" src=\"https://github.com/user-attachments/assets/7e8613e5-cd02-47e2-a57d-896dc43dc6f7\" />\n\nbut now if we try with 49000 collision shapes, then the performance difference is much more noticeable, here is 49000 collision shapes in 4.5.dev4:\n\n<img width=\"1394\" height=\"882\" alt=\"Image\" src=\"https://github.com/user-attachments/assets/1f421bef-fc5d-4d19-84b2-235039a829a8\" />\n\nand the same 49000 in 4.5.dev5:\n\n<img width=\"1394\" height=\"882\" alt=\"Image\" src=\"https://github.com/user-attachments/assets/6155163f-23e9-4d42-a57a-3b0266df00b3\" />\n\nYou can try those same scenes in the MRP I attach.\n\nIt might also be helpful to mention that this was originally noticed in the game I am working on, which i cannot share here, but there I moved from being able to manage those scenes in editor without issues (even though 4.3 was giving a better performance than 4.4.1), like this scene with a CPU time of around 40 ms in 4.4.1 or 4.5.dev4: \n\n<img width=\"1040\" height=\"799\" alt=\"Image\" src=\"https://github.com/user-attachments/assets/ecf21802-3a0b-4b3b-89cd-9d7ce4a5f370\" />\n\nto 641 ms in 4.5.dev5 or 4.5.beta3:\n\n<img width=\"968\" height=\"796\" alt=\"Image\" src=\"https://github.com/user-attachments/assets/6b9acd07-7bd0-45de-8eb7-3f99dae82a93\" />\n\nand I should also mention that sometimes, when opening that same scene with 4.5.dev5, i was getting non stop errors, like in the image below and interestingly, when that happened the performance was actually better, but maybe just because it wasn't rendering the whole thing, no idea. But then opening again the exact same project with the same scene might not give any errors:\n\n<img width=\"1853\" height=\"1326\" alt=\"Image\" src=\"https://github.com/user-attachments/assets/db668d6c-d949-4ed4-9069-ebf687174090\" />\n\n\n@mihe I hope it is ok to mention you here, since this is related to that other issue you were working on.\n\n### Steps to reproduce\n\nOpen the MRP with both 4.5.dev4 and 4.5.dev5 and compare results. You should check the scenes \"scene3A_premade_scene_with_15000_meshes_and_collisions.tscn\" and \"scene3B_premade_scene_with_49000_meshes_and_collisions.tscn\"\n\nEnable \"View Frame Time\" in the 3D editor to see the CPU Time and compare.\n\n### Minimal reproduction project (MRP)\n\n[collisions MRP 4.5.zip](https://github.com/user-attachments/files/21144091/collisions.MRP.4.5.zip)","closed_by":{"login":"Repiteo","id":17489292,"node_id":"MDQ6VXNlcjE3NDg5Mjky","avatar_url":"https://avatars.githubusercontent.com/u/17489292?v=4","gravatar_id":"","url":"https://api.github.com/users/Repiteo","html_url":"https://github.com/Repiteo","followers_url":"https://api.github.com/users/Repiteo/followers","following_url":"https://api.github.com/users/Repiteo/following{/other_user}","gists_url":"https://api.github.com/users/Repiteo/gists{/gist_id}","starred_url":"https://api.github.com/users/Repiteo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Repiteo/subscriptions","organizations_url":"https://api.github.com/users/Repiteo/orgs","repos_url":"https://api.github.com/users/Repiteo/repos","events_url":"https://api.github.com/users/Repiteo/events{/privacy}","received_events_url":"https://api.github.com/users/Repiteo/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/108435/reactions","total_count":3,"+1":2,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":1},"timeline_url":"https://api.github.com/repos/godotengine/godot/issues/108435/timeline","performed_via_github_app":null,"state_reason":"completed","pinned_comment":null}