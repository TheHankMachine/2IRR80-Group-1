ied with a PS4 controller and everything works perfectly, even disconnecting the controller Godot continues to run as expected.","closed_by":{"login":"Imaginary-Narwhal","id":82555340,"node_id":"MDQ6VXNlcjgyNTU1MzQw","avatar_url":"https://avatars.githubusercontent.com/u/82555340?v=4","gravatar_id":"","url":"https://api.github.com/users/Imaginary-Narwhal","html_url":"https://github.com/Imaginary-Narwhal","followers_url":"https://api.github.com/users/Imaginary-Narwhal/followers","following_url":"https://api.github.com/users/Imaginary-Narwhal/following{/other_user}","gists_url":"https://api.github.com/users/Imaginary-Narwhal/gists{/gist_id}","starred_url":"https://api.github.com/users/Imaginary-Narwhal/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Imaginary-Narwhal/subscriptions","organizations_url":"https://api.github.com/users/Imaginary-Narwhal/orgs","repos_url":"https://api.github.com/users/Imaginary-Narwhal/repos","events_url":"https://api.github.com/users/Imaginary-Narwhal/events{/privacy}","received_events_url":"https://api.github.com/users/Imaginary-Narwhal/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/112658/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/godotengine/godot/issues/112658/timeline","performed_via_github_app":null,"state_reason":"completed","pinned_comment":null}