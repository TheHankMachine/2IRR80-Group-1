ll},{"id":283518733,"node_id":"MDU6TGFiZWwyODM1MTg3MzM=","url":"https://api.github.com/repos/godotengine/godot/labels/usability","name":"usability","color":"447744","default":false,"description":"","archived_at":null,"archived_by":null}],"state":"closed","locked":false,"assignees":[],"milestone":{"url":"https://api.github.com/repos/godotengine/godot/milestones/23","html_url":"https://github.com/godotengine/godot/milestone/23","labels_url":"https://api.github.com/repos/godotengine/godot/milestones/23/labels","id":12939969,"node_id":"MI_kwDOAO6SJc4AxXLB","number":23,"title":"4.6","description":"","creator":{"login":"Repiteo","id":17489292,"node_id":"MDQ6VXNlcjE3NDg5Mjky","avatar_url":"https://avatars.githubusercontent.com/u/17489292?v=4","gravatar_id":"","url":"https://api.github.com/users/Repiteo","html_url":"https://github.com/Repiteo","followers_url":"https://api.github.com/users/Repiteo/followers","following_url":"https://api.github.com/users/Repiteo/following{/other_user}","gists_url":"https://api.github.com/users/Repiteo/gists{/gist_id}","starred_url":"https://api.github.com/users/Repiteo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Repiteo/subscriptions","organizations_url":"https://api.github.com/users/Repiteo/orgs","repos_url":"https://api.github.com/users/Repiteo/repos","events_url":"https://api.github.com/users/Repiteo/events{/privacy}","received_events_url":"https://api.github.com/users/Repiteo/received_events","type":"User","user_view_type":"public","site_admin":false},"open_issues":3,"closed_issues":2978,"state":"closed","created_at":"2025-05-22T16:25:52Z","updated_at":"2026-10-04T16:23:23Z","due_on":null,"closed_at":"2026-01-26T18:09:14Z"},"comments":74,"created_at":"2025-10-01T15:04:35Z","updated_at":"2026-02-07T12:37:44Z","closed_at":"2025-10-30T18:55:21Z","assignee":null,"author_association":"MEMBER","issue_field_values":[],"type":null,"active_lock_reason":null,"draft":false,"pull_request":{"url":"https://api.github.com/repos/godotengine/godot/pulls/111118","html_url":"https://github.com/godotengine/godot/pull/111118","diff_url":"https://github.com/godotengine/godot/pull/111118.diff","patch_url":"https://github.com/godotengine/godot/pull/111118.patch","merged_at":"2025-10-30T18:55:21Z"},"body":"<img width=\"1920\" height=\"1128\" alt=\"Screenshot_20251023_132202\" src=\"https://github.com/user-attachments/assets/3f95136f-58ee-4b66-a117-415cf83719df\" />\r\n<br><br>\r\n\r\nIs with great pleasure that I present you, Godot's soon-to-be new default theme!\r\n\r\nThis is a 1:1 port of @passivestar's [Minimal Theme](https://github.com/passivestar/godot-minimal-theme?tab=readme-ov-file), with himself also helping us behind the curtains in order to facilitate the porting work. The editor font used is now [Inter](https://rsms.me/inter/), and the new theme also changes the editor's base color and accent. While the blue tint had become a staple of Godot’s look over the past years, it caused issues such as distorting the perceived white balance of the viewport. Switching to a neutral gray resolves this.\r\n\r\nBut for those who still liked the older look better, fret not, As **the old theme and color preset is still available**, for you to pick! They can be accessed by choosing \"Classic\" in the `interface/theme/style` and `interface/theme/preset` settings.\r\n\r\nWhile this PR is in a merge-able state, some small things still need to be worked on:\r\n- <s>Nested `TabContainer`s blend with each other.</s>\r\n- <s>The disabled tab style is a placeholder, while waiting for passive to implement it.</s>\r\n- `PopupMenu`s still look very squarish, as #106324 still needs to be resolved.\r\n\r\nFeedback is more than welcome, but please, keep it civil. Topics involving theming and design are very subjective, so the more objective information you can provide about your issues the easier it will be to address them in future PRs. ","closed_by":{"login":"Repiteo","id":17489292,"node_id":"MDQ6VXNlcjE3NDg5Mjky","avatar_url":"https://avatars.githubusercontent.com/u/17489292?v=4","gravatar_id":"","url":"https://api.github.com/users/Repiteo","html_url":"https://github.com/Repiteo","followers_url":"https://api.github.com/users/Repiteo/followers","following_url":"https://api.github.com/users/Repiteo/following{/other_user}","gists_url":"https://api.github.com/users/Repiteo/gists{/gist_id}","starred_url":"https://api.github.com/users/Repiteo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Repiteo/subscriptions","organizations_url":"https://api.github.com/users/Repiteo/orgs","repos_url":"https://api.github.com/users/Repiteo/repos","events_url":"https://api.github.com/users/Repiteo/events{/privacy}","received_events_url":"https://api.github.com/users/Repiteo/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/111118/reactions","total_count":381,"+1":161,"-1":31,"laugh":0,"hooray":83,"confused":0,"heart":69,"rocket":23,"eyes":14},"timeline_url":"https://api.github.com/repos/godotengine/godot/issues/111118/timeline","performed_via_github_app":null,"state_reason":null}