thub.com/users/akien-mga/received_events","type":"User","user_view_type":"public","site_admin":false},"open_issues":5790,"closed_issues":0,"state":"open","created_at":"2022-07-26T12:42:05Z","updated_at":"2026-10-22T08:16:48Z","due_on":null,"closed_at":null},"comments":8,"created_at":"2024-11-29T15:16:35Z","updated_at":"2026-02-17T20:10:44Z","closed_at":null,"assignee":null,"author_association":"MEMBER","issue_field_values":[],"type":null,"active_lock_reason":null,"draft":false,"pull_request":{"url":"https://api.github.com/repos/godotengine/godot/pulls/99838","html_url":"https://github.com/godotengine/godot/pull/99838","diff_url":"https://github.com/godotengine/godot/pull/99838.diff","patch_url":"https://github.com/godotengine/godot/pull/99838.patch","merged_at":null},"body":"This works based on a common set of texture name conventions that most texture sites out there follow. It works with both StandardMaterial3D and ORMMaterial3D. If mismatched textures are detected (compared to the current material type), a notice is displayed.\r\n\r\nSince this is implemented in EditorInspectorPluginMaterial, this only affects textures set in the inspector, similar to the existing behavior where `roughness` and `metallic` are automatically set to `1.0` when assigning a texture to them.\r\n\r\n- This closes https://github.com/godotengine/godot-proposals/issues/11261.\r\n\r\n**Testing project:** [test_pbr_autofill.zip](https://github.com/user-attachments/files/17960995/test_pbr_autofill.zip)\r\n\r\n## Preview\r\n\r\nhttps://github.com/user-attachments/assets/c5e23458-d0b4-46e6-aa96-7a13e34f8e30\r\n\r\n## TODO\r\n\r\n- [ ] Move the BaseMaterial3D code to a static method, so that we don't need to create an instance of it when assigning textures.\r\n  - This needs https://github.com/godotengine/godot/pull/99751 so the dictionary assignment can be performed statically and moved to the header (since it's read from a static method).\r\n- [ ] Implement this for the Decal node as well (could be done in a separate PR).","closed_by":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/99838/reactions","total_count":22,"+1":12,"-1":0,"laugh":0,"hooray":9,"confused":0,"heart":1,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/godotengine/godot/issues/99838/timeline","performed_via_github_app":null,"state_reason":null}