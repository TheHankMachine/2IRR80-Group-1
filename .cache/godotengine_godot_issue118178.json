ription":"","archived_at":null,"archived_by":null}],"state":"closed","locked":false,"assignees":[],"milestone":{"url":"https://api.github.com/repos/godotengine/godot/milestones/24","html_url":"https://github.com/godotengine/godot/milestone/24","labels_url":"https://api.github.com/repos/godotengine/godot/milestones/24/labels","id":14236899,"node_id":"MI_kwDOAO6SJc4A2Tzj","number":24,"title":"4.7","description":"","creator":{"login":"akien-mga","id":4701338,"node_id":"MDQ6VXNlcjQ3MDEzMzg=","avatar_url":"https://avatars.githubusercontent.com/u/4701338?v=4","gravatar_id":"","url":"https://api.github.com/users/akien-mga","html_url":"https://github.com/akien-mga","followers_url":"https://api.github.com/users/akien-mga/followers","following_url":"https://api.github.com/users/akien-mga/following{/other_user}","gists_url":"https://api.github.com/users/akien-mga/gists{/gist_id}","starred_url":"https://api.github.com/users/akien-mga/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/akien-mga/subscriptions","organizations_url":"https://api.github.com/users/akien-mga/orgs","repos_url":"https://api.github.com/users/akien-mga/repos","events_url":"https://api.github.com/users/akien-mga/events{/privacy}","received_events_url":"https://api.github.com/users/akien-mga/received_events","type":"User","user_view_type":"public","site_admin":false},"open_issues":3,"closed_issues":2535,"state":"closed","created_at":"2025-11-27T20:29:18Z","updated_at":"2026-10-20T18:39:31Z","due_on":null,"closed_at":"2026-06-19T16:54:35Z"},"comments":0,"created_at":"2026-04-04T05:05:45Z","updated_at":"2026-04-14T12:18:42Z","closed_at":"2026-04-14T12:16:36Z","assignee":null,"author_association":"NONE","issue_field_values":[],"type":null,"active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"### Tested versions\n\n4.7-dev3\n\n### System information\n\nGodot v4.7.dev3 - macOS Sequoia (15.7.3) - Multi-window, 1 monitor - Metal (Forward+) - integrated Apple M1 Pro (Apple7) - Apple M1 Pro (10 threads) - 16.00 GiB memory\n\n### Issue description\n\nTitle is mostly self-explanatory. \n\nAfter experimenting around, it seems like `blit_rect` (and hence likely also `blit_rect_multi`) does not seem to keep track of size changes done with `set_width(new_width)` and `set_height(new_height)` internally, since calling it with a `Rect2i` with the original width and height produces the expected result even when they were already changed in the `DrawableTexture2D` itself.\n\n### Steps to reproduce\n\n1. Create a `DrawableTexture2D` and call `setup(width, height, ...)`.\n2. Call `blit_rect(Rect2i(0, 0, width, height), ...)`.\n3. Resize `DrawableTexture2D using `set_width(new_width)` and `set_height(new_height)`.\n4. Call `blit_rect(Rect2i(0, 0, new_width, new_height), ...)`.\n5. Notice the difference between the two `blit_rect` results.\n\n### Minimal reproduction project (MRP)\n\n[resizing-drawabletexture2d-mrp.zip](https://github.com/user-attachments/files/26477596/resizing-drawabletexture2d-mrp.zip)\n\nSteps to reproduce using the MRP:\n\n1. Open`resizing.tres`.\n1. Change its `Size` parameter.\n2. Click `Update`.\n3. Notice weird changes in the texture preview.","closed_by":{"login":"Repiteo","id":17489292,"node_id":"MDQ6VXNlcjE3NDg5Mjky","avatar_url":"https://avatars.githubusercontent.com/u/17489292?v=4","gravatar_id":"","url":"https://api.github.com/users/Repiteo","html_url":"https://github.com/Repiteo","followers_url":"https://api.github.com/users/Repiteo/followers","following_url":"https://api.github.com/users/Repiteo/following{/other_user}","gists_url":"https://api.github.com/users/Repiteo/gists{/gist_id}","starred_url":"https://api.github.com/users/Repiteo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Repiteo/subscriptions","organizations_url":"https://api.github.com/users/Repiteo/orgs","repos_url":"https://api.github.com/users/Repiteo/repos","events_url":"https://api.github.com/users/Repiteo/events{/privacy}","received_events_url":"https://api.github.com/users/Repiteo/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/118178/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/godotengine/godot/issues/118178/timeline","performed_via_github_app":null,"state_reason":"completed","pinned_comment":null}