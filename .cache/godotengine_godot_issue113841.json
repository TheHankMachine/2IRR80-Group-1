epiteo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Repiteo/subscriptions","organizations_url":"https://api.github.com/users/Repiteo/orgs","repos_url":"https://api.github.com/users/Repiteo/repos","events_url":"https://api.github.com/users/Repiteo/events{/privacy}","received_events_url":"https://api.github.com/users/Repiteo/received_events","type":"User","user_view_type":"public","site_admin":false},"open_issues":3,"closed_issues":2978,"state":"closed","created_at":"2025-05-22T16:25:52Z","updated_at":"2026-10-04T16:23:23Z","due_on":null,"closed_at":"2026-01-26T18:09:14Z"},"comments":1,"created_at":"2025-12-10T12:28:19Z","updated_at":"2025-12-15T23:45:52Z","closed_at":"2025-12-15T23:45:51Z","assignee":{"login":"bruvzg","id":7645683,"node_id":"MDQ6VXNlcjc2NDU2ODM=","avatar_url":"https://avatars.githubusercontent.com/u/7645683?v=4","gravatar_id":"","url":"https://api.github.com/users/bruvzg","html_url":"https://github.com/bruvzg","followers_url":"https://api.github.com/users/bruvzg/followers","following_url":"https://api.github.com/users/bruvzg/following{/other_user}","gists_url":"https://api.github.com/users/bruvzg/gists{/gist_id}","starred_url":"https://api.github.com/users/bruvzg/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/bruvzg/subscriptions","organizations_url":"https://api.github.com/users/bruvzg/orgs","repos_url":"https://api.github.com/users/bruvzg/repos","events_url":"https://api.github.com/users/bruvzg/events{/privacy}","received_events_url":"https://api.github.com/users/bruvzg/received_events","type":"User","user_view_type":"public","site_admin":false},"author_association":"NONE","issue_field_values":[],"type":null,"active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"### Tested versions\n\n- Reproducible in all builds after 4.6-dev3 and current master\n- Not reproducible in 4.6-dev3\n\n### System information\n\nGodot v4.6.beta.mono (4df51a033) - Ubuntu 25.10 25.10 on Wayland - X11 display driver, Multi-window, 2 monitors - Vulkan (Forward+) - dedicated AMD Radeon RX 9070 XT (RADV GFX1201) - AMD Ryzen 7 9700X 8-Core Processor (16 threads) - 61.29 GiB memory\n\n### Issue description\n\nText within 'Text Effect' bbcodes (e.g., wave, fade, ...) in `RichTextLabel` is not shown when not all characters are visible (i.e., `visible_characters` is less than the total length)\n\nAfter some testing I found:\n\n- The text is shown when the visible character limit is within the bbcode (e.g., when half the text in the bbcode is visible). But as soon as the limit is after the bbcoded text, it is removed.\n- It does not happen when the bbcode is the first element in the text. It does only happen when there is text before and after the effect.\n- As far as I can tell it does not affect non 'Text Effect' bbcodes such as color, alignement, ...\n- It does only happen when `visible_characters_behavior` is set to `Chars Before Shaping`.\n\n### Steps to reproduce\n\nThe mrp contains three `RichTextLabel`s that contain the text `Before [wave]Wave[/wave] After`.\n\nThe first label has the character limit set to the A in `After`: Only prints `Before A`.\nThe second label has the limit set within the bbcode and prints as expected.\nThe third label has the bbcode at the beginning and prints as expected.\n\n### Minimal reproduction project (MRP)\n\n[mrp.zip](https://github.com/user-attachments/files/24077606/mrp.zip)","closed_by":{"login":"Repiteo","id":17489292,"node_id":"MDQ6VXNlcjE3NDg5Mjky","avatar_url":"https://avatars.githubusercontent.com/u/17489292?v=4","gravatar_id":"","url":"https://api.github.com/users/Repiteo","html_url":"https://github.com/Repiteo","followers_url":"https://api.github.com/users/Repiteo/followers","following_url":"https://api.github.com/users/Repiteo/following{/other_user}","gists_url":"https://api.github.com/users/R