al_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3126819294","html_url":"https://github.com/godotengine/godot/issues/108817#issuecomment-3126819294","issue_url":"https://api.github.com/repos/godotengine/godot/issues/108817","id":3126819294,"node_id":"IC_kwDOAO6SJc66X3ne","user":{"login":"Alex2782","id":41921395,"node_id":"MDQ6VXNlcjQxOTIxMzk1","avatar_url":"https://avatars.githubusercontent.com/u/41921395?v=4","gravatar_id":"","url":"https://api.github.com/users/Alex2782","html_url":"https://github.com/Alex2782","followers_url":"https://api.github.com/users/Alex2782/followers","following_url":"https://api.github.com/users/Alex2782/following{/other_user}","gists_url":"https://api.github.com/users/Alex2782/gists{/gist_id}","starred_url":"https://api.github.com/users/Alex2782/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Alex2782/subscriptions","organizations_url":"https://api.github.com/users/Alex2782/orgs","repos_url":"https://api.github.com/users/Alex2782/repos","events_url":"https://api.github.com/users/Alex2782/events{/privacy}","received_events_url":"https://api.github.com/users/Alex2782/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-07-28T11:37:07Z","updated_at":"2025-07-28T11:56:07Z","body":"@Summersay415  If you have time, please check if we can reactivate GPUParticles.\n\nhttps://github.com/godotengine/godot/pull/88816\n<details><summary>code</summary>\n\n```cpp\nvoid ParticlesStorage::particles_set_emitting(RID p_particles, bool p_emitting) {\n\tERR_FAIL_COND_MSG(GLES3::Config::get_singleton()->adreno_3xx_compatibility, \"Due to driver bugs, GPUParticles are not supported on Adreno 3XX devices. Please use CPUParticles instead.\");\n\n\tParticles *particles = particles_owner.get_or_null(p_particles);\n\tERR_FAIL_NULL(particles);\n\n\tparticles->emitting = p_emitting;\n}\n\nbool ParticlesStorage::particles_get_emitting(RID p_particles) {\n\tif (GLES3::Config::get_singleton()->adreno_3xx_compatibility) {\n\t\treturn false;\n\t}\n```\n</details>\n\n---------\n\n**EDIT**:\n\nProbably \"disable_particles_workaround\" is now checked there\n\n```cpp\nif (rendering_device_name.left(13) == \"Adreno (TM) 3\") {\n\t\tflip_xy_workaround = true;\n\t\tdisable_particles_workaround = true;\n\n```","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3126819294/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3126882912","html_url":"https://github.com/godotengine/godot/issues/108817#issuecomment-3126882912","issue_url":"https://api.github.com/repos/godotengine/godot/issues/108817","id":3126882912,"node_id":"IC_kwDOAO6SJc66YHJg","user":{"login":"clayjohn","id":16521339,"node_id":"MDQ6VXNlcjE2NTIxMzM5","avatar_url":"https://avatars.githubusercontent.com/u/16521339?v=4","gravatar_id":"","url":"https://api.github.com/users/clayjohn","html_url":"https://github.com/clayjohn","followers_url":"https://api.github.com/users/clayjohn/followers","following_url":"https://api.github.com/users/clayjohn/following{/other_user}","gists_url":"https://api.github.com/users/clayjohn/gists{/gist_id}","starred_url":"https://api.github.com/users/clayjohn/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/clayjohn/subscriptions","organizations_url":"https://api.github.com/users/clayjohn/orgs","repos_url":"https://api.github.com/users/clayjohn/repos","events_url":"https://api.github.com/users/clayjohn/events{/privacy}","received_events_url":"https://api.github.com/users/clayjohn/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-07-28T11:54:47Z","updated_at":"2025-07-28T11:54:47Z","body":"@Alex2782 I don't see why GPUParticles would be affected. The reason the flip workaround is no longer needed is because we no longer use the blit function to copy the Viewport to the screen. By avoiding the blit we worked around the bug a different way. ","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3126882912/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null}]