/github.com/aaronfranke","followers_url":"https://api.github.com/users/aaronfranke/followers","following_url":"https://api.github.com/users/aaronfranke/following{/other_user}","gists_url":"https://api.github.com/users/aaronfranke/gists{/gist_id}","starred_url":"https://api.github.com/users/aaronfranke/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/aaronfranke/subscriptions","organizations_url":"https://api.github.com/users/aaronfranke/orgs","repos_url":"https://api.github.com/users/aaronfranke/repos","events_url":"https://api.github.com/users/aaronfranke/events{/privacy}","received_events_url":"https://api.github.com/users/aaronfranke/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"Looks good to me.","state":"APPROVED","html_url":"https://github.com/godotengine/godot/pull/114872#pullrequestreview-3834475091","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/114872","author_association":"MEMBER","_links":{"html":{"href":"https://github.com/godotengine/godot/pull/114872#pullrequestreview-3834475091"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/114872"}},"submitted_at":"2026-02-20T22:27:38Z","commit_id":null},{"id":4068622824,"node_id":"PRR_kwDOAO6SJc7ygkHo","user":{"login":"dalexeev","id":47700418,"node_id":"MDQ6VXNlcjQ3NzAwNDE4","avatar_url":"https://avatars.githubusercontent.com/u/47700418?u=0565b5d99d54afd5fda6712cd8eb05893572baed&v=4","gravatar_id":"","url":"https://api.github.com/users/dalexeev","html_url":"https://github.com/dalexeev","followers_url":"https://api.github.com/users/dalexeev/followers","following_url":"https://api.github.com/users/dalexeev/following{/other_user}","gists_url":"https://api.github.com/users/dalexeev/gists{/gist_id}","starred_url":"https://api.github.com/users/dalexeev/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/dalexeev/subscriptions","organizations_url":"https://api.github.com/users/dalexeev/orgs","repos_url":"https://api.github.com/users/dalexeev/repos","events_url":"https://api.github.com/users/dalexeev/events{/privacy}","received_events_url":"https://api.github.com/users/dalexeev/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"I haven't reviewed or tested this PR in detail, just glanced at the code.\n\nIn my opinion, this approach is one of the acceptable options for solving linked issues, but probably not the most conservative one. My main concern is that it changes behavior in a way that could be considered a breaking change. So we should add the label and mention this change in the migration guide, on the release page, etc.\n\nAt the same time, this approach has the advantage of minimal simplicity. Alternative solutions would likely lead to unnecessary complexity and configurability.\n\nAlso, as far as I understand, this actually doesn't violate the JSON specification. We can represent `Number` as either `int` or `float`. And the same number can have multiple representations (like `1` and `1.0`). But we're not required to use the shortest notation when encoding, and we're not prohibited from exploiting the notation differences to choose the target type when decoding (even if it can be unreliable). For example, PHP also relies on the fractional part to choose the target type:\n\n```php\n<?php\n\nvar_dump(json_encode(1)); // string(1) \"1\"\nvar_dump(json_encode(1.0)); // string(1) \"1\"\nvar_dump(json_encode(1.0, JSON_PRESERVE_ZERO_FRACTION)); // string(3) \"1.0\"\nvar_dump(json_encode(1.1)); // string(3) \"1.1\"\n\nvar_dump(json_decode(\"1\")); // int(1)\nvar_dump(json_decode(\"1.0\")); // float(1)\nvar_dump(json_decode(\"1.1\")); // float(1.1)\n```","state":"APPROVED","html_url":"https://github.com/godotengine/godot/pull/114872#pullrequestreview-4068622824","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/114872","author_association":"CONTRIBUTOR","_links":{"html":{"href":"https://github.com/godotengine/godot/pull/114872#pullrequestreview-4068622824"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/114872"}},"submitted_at":"2026-04-07T13:56:55Z","commit_id":null},{"id":4069894808,"node_id":"PRR_kwDOAO6SJc7ylaqY","user":{"login":"kitbdev","id":10054226,"node_id":"MDQ6VXNlcjEwMDU0MjI2","avatar_url":"https://avatars.githubusercontent.com/u/10054226?u=f0c85fe8c24debe91dc14d7efa97b51a19250b47&v=4","gravatar_id":"","url":"https://api.github.com/users/kitbdev","html_url":"https://github.com/kitbdev","followers_url":"https://api.github.com/users/kitbdev/followers","following_url":"https://api.github.com/users/kitbdev/following{/other_user}","gists_url":"https://api.github.com/users/kitbdev/gists{/gist_id}","starred_url":"https://api.github.com/users/kitbdev/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/kitbdev/subscriptions","organizations_url":"https://api.github.com/users/kitbdev/orgs","repos_url":"https://api.github.com/users/kitbdev/repos","events_url":"https://api.github.com/users/kitbdev/events{/privacy}","received_events_url":"https://api.github.com/users/kitbdev/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"","state":"COMMENTED","html_url":"https://github.com/godotengine/godot/pull/114872#pullrequestreview-4069894808","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/114872","author_association":"CONTRIBUTOR","_links":{"html":{"href":"https://github.com/godotengine/godot/pull/114872#pullrequestreview-4069894808"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/114872"}},"submitted_at":"2026-04-07T16:56:44Z","commit_id":null},{"id":4069895283,"node_id":"PRR_kwDOAO6SJc7ylaxz","user":{"login":"kitbdev","id":10054226,"node_id":"MDQ6VXNlcjEwMDU0MjI2","avatar_url":"https://avatars.githubusercontent.com/u/10054226?u=f0c85fe8c24debe91dc14d7efa97b51a19250b47&v=4","gravatar_id":"","url":"https://api.github