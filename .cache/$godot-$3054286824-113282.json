":"User","owned_private_repos":0,"public_gists":0,"public_repos":0,"total_private_repos":0,"url":"https://api.github.com/users/dsnopek"},"body":"","html_url":"https://github.com/godotengine/godot/pull/113282#pullrequestreview-3519393374","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/113282","author_association":"CONTRIBUTOR","submitted_at":"2025-11-28T15:40:21Z"},{"id":3519407557,"node_id":"PRR_kwDOAO6SJc7RxeXF","state":"COMMENTED","user":{"site_admin":false,"suspended":false,"updated_at":"0001-01-01T00:00:00Z","avatar_url":"https://avatars.githubusercontent.com/u/2308167?u=f7f8e0273f784f5ec6f6b7fe4a88d449896eb48a&v=4","created_at":"0001-01-01T00:00:00Z","followers":0,"following":0,"html_url":"https://github.com/Ivorforce","id":2308167,"node_id":"MDQ6VXNlcjIzMDgxNjc=","login":"Ivorforce","type":"User","owned_private_repos":0,"public_gists":0,"public_repos":0,"total_private_repos":0,"url":"https://api.github.com/users/Ivorforce"},"body":"","html_url":"https://github.com/godotengine/godot/pull/113282#pullrequestreview-3519407557","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/113282","author_association":"MEMBER","submitted_at":"2025-11-28T15:46:33Z"},{"id":3530468791,"node_id":"PRR_kwDOAO6SJc7Sbq23","state":"COMMENTED","user":{"site_admin":false,"suspended":false,"updated_at":"0001-01-01T00:00:00Z","avatar_url":"https://avatars.githubusercontent.com/u/2308167?u=f7f8e0273f784f5ec6f6b7fe4a88d449896eb48a&v=4","created_at":"0001-01-01T00:00:00Z","followers":0,"following":0,"html_url":"https://github.com/Ivorforce","id":2308167,"node_id":"MDQ6VXNlcjIzMDgxNjc=","login":"Ivorforce","type":"User","owned_private_repos":0,"public_gists":0,"public_repos":0,"total_private_repos":0,"url":"https://api.github.com/users/Ivorforce"},"body":"Most of the changes look pretty trivial. In particular, the `RequiredParam` changes mostly verify themselves, due to the protections of the class :)\n\nI'm a bit more reserved about the `RequiredResult` changes. There is no way of making absolutely certain that a function doesn't introduce a non-erroneous `nullptr` return path in the future. Having it marked as `RequiredResult` may be incompatible with projects that assume `nullptr` is an error.\nI have no ideas to avoid this, but since `nullptr` _does_ mean some kind of error for many getter functions maybe we don't _need_ to address this either?\n\nThe only other caveat i have is that in its current state, `RequiredParam` is slightly slower than `const Ref &`, since it requires a copy of the `Ref` be made. This overhead is hopefully not relevant in any of the functions, but I can't say for sure.\n(I have a plan to optimize this in the future, so the regression should hopefully be temporary anyway)","html_url":"https://github.com/godotengine/godot/pull/113282#pullrequestreview-3530468791","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/113282","author_association":"MEMBER","submitted_at":"2025-12-02T14:55:24Z"},{"id":3530892102,"node_id":"PRR_kwDOAO6SJc7SdSNG","state":"COMMENTED","user":{"site_admin":false,"suspended":false,"updated_at":"0001-01-01T00:00:00Z","avatar_url":"https://avatars.githubusercontent.com/u/191561?v=4","created_at":"0001-01-01T00:00:00Z","followers":0,"following":0,"html_url":"https://github.com/dsnopek","id":191561,"node_id":"MDQ6VXNlcjE5MTU2MQ==","login":"dsnopek","type":"User","owned_private_repos":0,"public_gists":0,"public_repos":0,"total_private_repos":0,"url":"https://api.github.com/users/dsnopek"},"body":"","html_url":"https://github.com/godotengine/godot/pull/113282#pullrequestreview-3530892102","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/113282","author_association":"CONTRIBUTOR","submitted_at":"2025-12-02T15:54:42Z"},{"id":3530939942,"node_id":"PRR_kwDOAO6SJc7Sdd4m","state":"COMMENTED","user":{"site_admin":false,"suspended":false,"updated_at":"0001-01-01T00:00:00Z","avatar_url":"https://avatars.githubusercontent.com/u/1