e/godot/labels/enhancement","name":"enhancement","color":"aaccff","default":true,"description":"","archived_at":null,"archived_by":null},{"id":2231593685,"node_id":"MDU6TGFiZWwyMjMxNTkzNjg1","url":"https://api.github.com/repos/godotengine/godot/labels/topic:tests","name":"topic:tests","color":"ffee88","default":false,"description":"","archived_at":null,"archived_by":null}],"state":"closed","locked":false,"assignees":[],"milestone":{"url":"https://api.github.com/repos/godotengine/godot/milestones/22","html_url":"https://github.com/godotengine/godot/milestone/22","labels_url":"https://api.github.com/repos/godotengine/godot/milestones/22/labels","id":12070367,"node_id":"MI_kwDOAO6SJc4AuC3f","number":22,"title":"4.5","description":"","creator":{"login":"Sauermann","id":6299227,"node_id":"MDQ6VXNlcjYyOTkyMjc=","avatar_url":"https://avatars.githubusercontent.com/u/6299227?v=4","gravatar_id":"","url":"https://api.github.com/users/Sauermann","html_url":"https://github.com/Sauermann","followers_url":"https://api.github.com/users/Sauermann/followers","following_url":"https://api.github.com/users/Sauermann/following{/other_user}","gists_url":"https://api.github.com/users/Sauermann/gists{/gist_id}","starred_url":"https://api.github.com/users/Sauermann/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Sauermann/subscriptions","organizations_url":"https://api.github.com/users/Sauermann/orgs","repos_url":"https://api.github.com/users/Sauermann/repos","events_url":"https://api.github.com/users/Sauermann/events{/privacy}","received_events_url":"https://api.github.com/users/Sauermann/received_events","type":"User","user_view_type":"public","site_admin":false},"open_issues":3,"closed_issues":3687,"state":"closed","created_at":"2024-12-19T08:51:28Z","updated_at":"2026-09-04T21:48:38Z","due_on":"2025-09-15T00:00:00Z","closed_at":"2025-09-18T17:13:14Z"},"comments":5,"created_at":"2025-04-28T00:44:05Z","updated_at":"2026-09-05T03:24:03Z","closed_at":"2025-05-15T15:29:33Z","assignee":null,"author_association":"CONTRIBUTOR","issue_field_values":[],"type":null,"active_lock_reason":null,"draft":false,"pull_request":{"url":"https://api.github.com/repos/godotengine/godot/pulls/105848","html_url":"https://github.com/godotengine/godot/pull/105848","diff_url":"https://github.com/godotengine/godot/pull/105848.diff","patch_url":"https://github.com/godotengine/godot/pull/105848.patch","merged_at":"2025-05-15T15:29:33Z"},"body":"May help with certain aspects of #103530\r\n\r\nThis PR makes the test runner delete the test cache before running it.\r\n\r\nThe reason for that is there is a couple of combination of compilation arguments, that if used, will disable the creation of certain assets, but those assets are then used later on for unit tests, which promptly fail to load (Here's a case of it happening: https://github.com/godotengine/godot/issues/103530#issuecomment-2695878864).\r\n\r\nBut, if you run unit tests with a previous Godot version with different compilation flags, you can be lucky and have the test files already saved into the cache from a completely unrelated build of Godot, and then the tests might run just fine, when they shouldn't.\r\n\r\nSo the reason to delete caches is to help diagnose tests that should've failed, but doesn't.\r\n\r\nI also run some benchmarking, in my machine running tests with cache takes 25 seconds, without, it takes 26 seconds. Which makes me think that the cache is being saved just as a place to run stuff, and not as an actual cache.","closed_by":{"login":"Repiteo","id":17489292,"node_id":"MDQ6VXNlcjE3NDg5Mjky","avatar_url":"https://avatars.githubusercontent.com/u/17489292?v=4","gravatar_id":"","url":"https://api.github.com/users/Repiteo","html_url":"https://github.com/Repiteo","followers_url":"https://api.github.com/users/Repiteo/followers","following_url":"https://api.github.com/users/Repiteo/following{/other_user}","gists_url":"https://api.github.com/users/Repiteo/gists{/gist_id}","starred_url":"https://api.github.com/users/Repiteo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Repiteo/subscriptions","organizations_url":"https://api.github.com/users/Repiteo/orgs","repos_url":"https://api.github.com/users/Repiteo/repos","events_url":"https://api.github.com/users/Repiteo/events{/privacy}","received_events_url":"https://api.github.com/users/Repiteo/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/105848/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/godotengine/godot/issues/105848/timeline","performed_via_github_app":null,"state_reason":null}