[{"id":4689212122,"node_id":"PRR_kwDOAO6SJc8AAAABF3-y2g","user":{"login":"NoNormalDev","id":190293561,"node_id":"U_kgDOC1emOQ","avatar_url":"https://avatars.githubusercontent.com/u/190293561?u=081190c3a30acaf77c8531e0c6b9dae737767f58&v=4","gravatar_id":"","url":"https://api.github.com/users/NoNormalDev","html_url":"https://github.com/NoNormalDev","followers_url":"https://api.github.com/users/NoNormalDev/followers","following_url":"https://api.github.com/users/NoNormalDev/following{/other_user}","gists_url":"https://api.github.com/users/NoNormalDev/gists{/gist_id}","starred_url":"https://api.github.com/users/NoNormalDev/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/NoNormalDev/subscriptions","organizations_url":"https://api.github.com/users/NoNormalDev/orgs","repos_url":"https://api.github.com/users/NoNormalDev/repos","events_url":"https://api.github.com/users/NoNormalDev/events{/privacy}","received_events_url":"https://api.github.com/users/NoNormalDev/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"I don't think that this approach is fully correct, as `FeedImage::FEED_IMAGES` isn't a valid feed image, but the amount of valid images. This means the entire `is_feed_image_valid` method can be replaced by a simple check that checks if `p_which` lies in the range from `0` to `FEED_IMAGES-1`, so if it's 0 or 1.\r\n\r\n> NOTE: I'm not a maintainer. I'm not forcing you to make any changes.\r\n","state":"COMMENTED","html_url":"https://github.com/godotengine/godot/pull/121340#pullrequestreview-4689212122","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/121340","author_association":"CONTRIBUTOR","_links":{"html":{"href":"https://github.com/godotengine/godot/pull/121340#pullrequestreview-4689212122"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/121340"}},"submitted_at":"2026-07-13T22:17:42Z","commit_id":"0e40a55a0a78a5c120501bf745c8e32b64015723"}]