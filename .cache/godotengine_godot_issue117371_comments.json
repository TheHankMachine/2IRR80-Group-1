8?v=4","gravatar_id":"","url":"https://api.github.com/users/akien-mga","html_url":"https://github.com/akien-mga","followers_url":"https://api.github.com/users/akien-mga/followers","following_url":"https://api.github.com/users/akien-mga/following{/other_user}","gists_url":"https://api.github.com/users/akien-mga/gists{/gist_id}","starred_url":"https://api.github.com/users/akien-mga/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/akien-mga/subscriptions","organizations_url":"https://api.github.com/users/akien-mga/orgs","repos_url":"https://api.github.com/users/akien-mga/repos","events_url":"https://api.github.com/users/akien-mga/events{/privacy}","received_events_url":"https://api.github.com/users/akien-mga/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-03-12T13:50:50Z","updated_at":"2026-03-12T13:50:50Z","body":"You're right, I was thinking of the context of the project manager (like in https://github.com/godotengine/godot/pull/115635) but for an actual project that's configured to use OpenGL it would be unexpected to fall-forward to Metal on the VM specifically. So this is probably good enough as is.","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4046935252/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4046999369","html_url":"https://github.com/godotengine/godot/pull/117371#issuecomment-4046999369","issue_url":"https://api.github.com/repos/godotengine/godot/issues/117371","id":4046999369,"node_id":"IC_kwDOAO6SJc7xOE9J","user":{"login":"bruvzg","id":7645683,"node_id":"MDQ6VXNlcjc2NDU2ODM=","avatar_url":"https://avatars.githubusercontent.com/u/7645683?v=4","gravatar_id":"","url":"https://api.github.com/users/bruvzg","html_url":"https://github.com/bruvzg","followers_url":"https://api.github.com/users/bruvzg/followers","following_url":"https://api.github.com/users/bruvzg/following{/other_user}","gists_url":"https://api.github.com/users/bruvzg/gists{/gist_id}","starred_url":"https://api.github.com/users/bruvzg/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/bruvzg/subscriptions","organizations_url":"https://api.github.com/users/bruvzg/orgs","repos_url":"https://api.github.com/users/bruvzg/repos","events_url":"https://api.github.com/users/bruvzg/events{/privacy}","received_events_url":"https://api.github.com/users/bruvzg/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-03-12T13:59:45Z","updated_at":"2026-03-12T13:59:45Z","body":"Tested on macOS 15 VM, macOS 26 VM and native macOS 26 system, Angle seems to work fine and VM is detected correctly.","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4046999369/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4047071442","html_url":"https://github.com/godotengine/godot/pull/117371#issuecomment-4047071442","issue_url":"https://api.github.com/repos/godotengine/godot/issues/117371","id":4047071442,"node_id":"IC_kwDOAO6SJc7xOWjS","user":{"login":"mihe","id":4884246,"node_id":"MDQ6VXNlcjQ4ODQyNDY=","avatar_url":"https://avatars.githubusercontent.com/u/4884246?v=4","gravatar_id":"","url":"https://api.github.com/users/mihe","html_url":"https://github.com/mihe","followers_url":"https://api.github.com/users/mihe/followers","following_url":"https://api.github.com/users/mihe/following{/other_user}","gists_url":"https://api.github.com/users/mihe/gists{/gist_id}","starred_url":"https://api.github.com/users/mihe/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/mihe/subscriptions","organizations_url":"https://api.github.com/users/mihe/orgs","repos_url":"https://api.github.com/users/mihe/repos","events_url":"https://api.github.com/users/mihe/events{/privacy}","received_events_url":"https://api.github.com/users/mihe/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-03-12T14:09:51Z","updated_at":"2026-03-12T14:10:21Z","body":"I can confirm that when building with `angle_libs=...` the project manager starts in a macOS 26.2 VM through UTM, while reporting the fallback to ANGLE and then using the Apple Paravirtual Device and everything.\r\n\r\nWhen doing so with a build that didn't provide `angle_libs=...` you're met with the following command-line output:\r\n\r\n```\r\nGodot Engine v4.7.dev.custom_build.e295eba0e (2026-03-11 20:42:05 UTC) - https://godotengine.org\r\nWARNING: Virtual Machine detected, switching to ANGLE.\r\n     at: DisplayServerMacOS (platform/macos/display_server_macos.mm:3789)\r\nERROR: Can't load EGL dynamic library.\r\n   at: initialize (drivers/egl/egl_manager.cpp:455)\r\nERROR: Could not initialize ANGLE OpenGL.\r\n   at: DisplayServerMacOS (platform/macos/display_server_macos.mm:3799)\r\nERROR: Unable to create DisplayServer, all display drivers failed.\r\nUse \"--headless\" command line argument to run the engine in headless mode if this is desired (e.g. for continuous integration).\r\n   at: setup2 (main/main.cpp:3338)\r\n```\r\n\r\n... as well as the following window:\r\n\r\n<img width=\"618\" height=\"352\" alt=\"image\" src=\"https://github.com/user-attachments/assets/5904e300-1b85-496e-b487-8f877ace024e\" />\r\n\r\nThat window isn't terribly helpful in this case, I guess.\r\n\r\nOpening a project (the [3D platformer demo](https://github.com/godotengine/godot-demo-projects/tree/master/3d/platformer) in my case) with the compatibility renderer does seem to work as well, but it's a bit of a slideshow, despite the supposed hardware acceleration.\r\n\r\nSetting that project to actually use the compatibility renderer as well, and then running the game, results in the game still picking the Apple Software Renderer for some reason, which does not seem to crash at least but just gives you a grey screen (clear color perhaps?).\r\n\r\nUnrelated I guess, but it seems both the forward and mobile renderers crash in UTM for me, as of latest master, with or without this change:\r\n\r\n```\r\nGodot Engine v4.7.dev.custom_build.e295eba0e (2026-03-11 20:42:05 UTC) - https://godotengine.org\r\n*** Terminating app due to uncaught exception 'NSInvalidArgumentException', reason: '*** -[NSCountedSet addObject:]: attempt to insert nil'\r\n*** First throw call stack:\r\n(\r\n\t0   CoreFoundation                      0x00000001983c18ec __exceptionPreprocess + 176\r\n\t1   libobjc.A.dylib                     0x0000000197e9a418 objc_exception_throw + 88\r\n\t2   Foundation                          0x000000019a52870c -[NSCountedSet removeObject:] + 0\r\n\t3   Foundation                          0x000000019a5286b0 -[NSCountedSet addObject:] + 268\r\n\t4   IOGPU                               0x00000001bca97ed4 _addResidencySets + 160\r\n\t5   IOGPU                               0x00000001bca97e28 -[IOGPUMetalCommandQueue addResidencySet:] + 36\r\n\t6   godot.macos.editor.arm64.noanything 0x000000010385e7a4 _ZN26RenderingDeviceDriverMetal22_copy_queue_initializeEv + 472\r\n\t7   godot.macos.editor.arm64.noanything 0x000000010385f96c _ZN26RenderingDeviceDriverMetal11_initializeEjj + 660\r\n\t8   godot.macos.editor.arm64.noanything 0x00000001038642b4 _ZN4MTL326RenderingDeviceDriverMetal10initializeEjj + 28\r\n\t9   godot.macos.editor.arm64.noanything 0x0000000105a67ec8 SDL_GetPerformanceFrequency + 35378108\r\n\t10  godot.macos.editor.arm64.noanything 0x000000010261e1e0 _ZN3mvk19SPIRVToMSLConverter7convertERNS_33SPIRVToMSLConversionConfigurationERNS_26SPIRVToMSLConversionResultEbbb + 1887808\r\n\t11  godot.macos.editor.arm64.noanything 0x00