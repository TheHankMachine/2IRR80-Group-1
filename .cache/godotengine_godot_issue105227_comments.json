ner}{/repo}","subscriptions_url":"https://api.github.com/users/adamscott/subscriptions","organizations_url":"https://api.github.com/users/adamscott/orgs","repos_url":"https://api.github.com/users/adamscott/repos","events_url":"https://api.github.com/users/adamscott/events{/privacy}","received_events_url":"https://api.github.com/users/adamscott/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-04-15T13:07:39Z","updated_at":"2025-04-15T13:08:45Z","body":"Isn't usually the extension normally used by servers is `.gz`?","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2805000833/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2805003427","html_url":"https://github.com/godotengine/godot/pull/105227#issuecomment-2805003427","issue_url":"https://api.github.com/repos/godotengine/godot/issues/105227","id":2805003427,"node_id":"IC_kwDOAO6SJc6nMPSj","user":{"login":"adamscott","id":270928,"node_id":"MDQ6VXNlcjI3MDkyOA==","avatar_url":"https://avatars.githubusercontent.com/u/270928?v=4","gravatar_id":"","url":"https://api.github.com/users/adamscott","html_url":"https://github.com/adamscott","followers_url":"https://api.github.com/users/adamscott/followers","following_url":"https://api.github.com/users/adamscott/following{/other_user}","gists_url":"https://api.github.com/users/adamscott/gists{/gist_id}","starred_url":"https://api.github.com/users/adamscott/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/adamscott/subscriptions","organizations_url":"https://api.github.com/users/adamscott/orgs","repos_url":"https://api.github.com/users/adamscott/repos","events_url":"https://api.github.com/users/adamscott/events{/privacy}","received_events_url":"https://api.github.com/users/adamscott/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-04-15T13:08:36Z","updated_at":"2025-04-15T13:08:36Z","body":"> @basicer Woo woo! I strongly suspect pck sizes are the reason why Godot HTML games load so ungodly slow...\r\n\r\nIt's not really related. The problem with .pck files is that you download the entire game all at once.","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2805003427/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2805698671","html_url":"https://github.com/godotengine/godot/pull/105227#issuecomment-2805698671","issue_url":"https://api.github.com/repos/godotengine/godot/issues/105227","id":2805698671,"node_id":"IC_kwDOAO6SJc6nO5Bv","user":{"login":"adamscott","id":270928,"node_id":"MDQ6VXNlcjI3MDkyOA==","avatar_url":"https://avatars.githubusercontent.com/u/270928?v=4","gravatar_id":"","url":"https://api.github.com/users/adamscott","html_url":"https://github.com/adamscott","followers_url":"https://api.github.com/users/adamscott/followers","following_url":"https://api.github.com/users/adamscott/following{/other_user}","gists_url":"https://api.github.com/users/adamscott/gists{/gist_id}","starred_url":"https://api.github.com/users/adamscott/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/adamscott/subscriptions","organizations_url":"https://api.github.com/users/adamscott/orgs","repos_url":"https://api.github.com/users/adamscott/repos","events_url":"https://api.github.com/users/adamscott/events{/privacy}","received_events_url":"https://api.github.com/users/adamscott/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-04-15T14:50:19Z","updated_at":"2025-04-15T14:50:19Z","body":"I'm not sure about supporting manual decoding of files. Because it would essentially bypass the browser doing it when accepting bzip and gz encoding from the server and there would be no way to essentially rely on that feature once you click \"gzip\" files in export settings.\r\n\r\nI think we should entirely rely on the server serving precompressed (by Godot) .gz or .br files.","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2805698671/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2808285694","html_url":"https://github.com/godotengine/godot/pull/105227#issuecomment-2808285694","issue_url":"https://api.github.com/repos/godotengine/godot/issues/105227","id":2808285694,"node_id":"IC_kwDOAO6SJc6nYwn-","user":{"login":"basicer","id":671513,"node_id":"MDQ6VXNlcjY3MTUxMw==","avatar_url":"https://avatars.githubusercontent.com/u/671513?v=4","gravatar_id":"","url":"https://api.github.com/users/basicer","html_url":"https://github.com/basicer","followers_url":"https://api.github.com/users/basicer/followers","following_url":"https://api.github.com/users/basicer/following{/other_user}","gists_url":"https://api.github.com/users/basicer/gists{/gist_id}","starred_url":"https://api.github.com/users/basicer/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/basicer/subscriptions","organizations_url":"https://api.github.com/users/basicer/orgs","repos_url":"https://api.github.com/users/basicer/repos","events_url":"https://api.github.com/users/basicer/events{/privacy}","received_events_url":"https://api.github.com/users/basicer/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-04-16T04:46:56Z","updated_at":"2025-04-16T04:48:26Z","body":"> Isn't usually the extension normally used by servers is `.gz`?\r\n\r\nIt is, but I chose `.gzip` to work around the itch.io behavior of renaming files that end in `.gz` to remove the extension.  Unity seems to append `.unityweb` for this reason.\r\n\r\n> I'm not sure about supporting manual decoding of files. Because it would essentially bypass the browser doing it when accepting bzip and gz encoding from the server and there would be no way to essentially rely on that feature once you click \"gzip\" files in export settings.\r\n> \r\n> I think we should entirely rely on the server serving precompressed (by Godot) .gz or .br files.\r\n\r\nI agree setting a server up like this, with something like `ngx_http_gzip_static` this is the absolute best way to go.  Especially because the browser can use `Accept-Encoding` to negotiate even better encodings. However, in many cases you don't have the required level of control over the CDN. \r\n\r\nFor example, in my case, I wanted to host on cloudflare pages. It supports setting `Cross-Origin-Opener-Policy` and such, but `Content-Encoding` is off limits.  Also there the file size limit is 25mb, so without pre-compressing you can't even upload the file.\r\n\r\nRelying on the server to do the right thing unlocks the best case. But when you can't (or don't know how to) configure the server to behave properly, you get the worst case.  This is why unity has the `Decompression Fallback` option for its web builds. To get some idea on how often servers are configured correctly, the only web game in the godot showcase sends the data uncompressed.\r\n\r\nClient side decompress always just works.  You can stick the files from your output directory on any server, and because this method uses browser decompression stream API, it's pretty much as efficient. \r\n\r\n\r\n","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2808285694/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2808311570","html_url":"https://github.com/godotengine/godot/pull/105227#issuecomment-2808311570","issue_url":"https://api.github.com/repos/godotengine/godot/issues/105227","id":2808311570,"node_id":"IC_kwDOAO6SJc6nY28S","user":{"login":"basicer","id":671513,"node_id":"MDQ6VXNlcjY3MTUxMw==","avatar_url":"https://avatars.githubusercontent.com/u/671513?v=4","gravatar_id":"","url":"https://api.github.com/users/basicer","html_url":"https://github.com/basicer","followers_url":"https://api.github.com/users/basicer/followers","following_url":"https://api.github.com/users/basicer/following{/other_user}","gists_url":"https://api.github.com/users/basicer/gists{/gist_id}","starred_url":"https://api.github.com/users/basicer/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/basicer/subscriptions","organizations_url":"https://api.github.com/users/basicer/orgs","repos_url":"https://api.github.com/users/basicer/repos","events_url":"https://api.github.com/users/basicer/events{/privacy}","received_events_url":"https://api.github.com/users/basicer/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-04-16T05:07:20Z","updated_at":"2025-04-16T05:07:20Z","body":"https://github.com/markushevpro/godot-minimize-html-build/blob/master/COMPARE.md seems to indicate that client side compression is faster even when using a JS decompression library instead of the native one this approach uses.  Although I'm a bit skeptical.   ","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2808311570/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2855251904","html_url":"https://github.com/godotengine/godot/pull/105227#issuecomment-2855251904","issue_url":"https://api.github.com/repos/godotengine/godot/issues/105227","id":2855251904,"node_id":"IC_kwDOAO6SJc6qL6_A","user":{"login":"Calinou","id":180032,"node_id":"MDQ6VXNlcjE4MDAzMg==","avatar_url":"https://avatars.githubusercontent.com/u/180032?v=4","gravatar_id":"","url":"https://api.github.com/users/Calinou","html_url":"https://github.com/Calinou","followers_url":"https://api.github.com/users/Calinou/followers","following_url":"https://api.github.com/users/Calinou/following{/other_user}","gists_url":"https://api.github.com/users/Calinou/gists{/gist_id}","starred_url":"https://api.github.com/users/Calinou/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Calinou/subscriptions","organizations_url":"https://api.github.com/users/Calinou/orgs","repos_url":"https://api.github.com/users/Calinou/repos","events_url":"https://api.github.com/users/Calinou/events{/privacy}","received_events_url":"https://api.github.com/users/Calinou/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-05-06T16:39:23Z","updated_at":"2025-05-06T16:39:23Z","body":"Note that for the PCK file, combining https://github.com/godotengine/godot-proposals/issues/4979, https://github.com/godotengine/godot-proposals/issues/11847 and https://github.com/godotengine/godot-proposals/issues/11852 should make compressing the whole file redundant. In fact, it should be avoided as double compression won't make the file any smaller, yet it will have (de)compression overhead.","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2855251904/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2953561732","html_url":"https://github.com/godotengine/godot/pull/105227#issuecomment-2953561732","issue_url":"https://api.github.com/repos/godotengine/godot/issues/105227","id":2953561732,"node_id":"IC_kwDOAO6SJc6wC8aE","user":{"login":"idbrii","id":43559,"node_id":"MDQ6VXNlcjQzNTU5","avatar_url":"https://avatars.githubusercontent.com/u/43559?v=4","gravatar_id":"","url":"https://api.github.com/users/idbrii","html_url":"https://github.com/idbrii","followers_url":"https://api.github.com/users/idbrii/followers","following_url":"https://api.github.com/users/idbrii/following{/other_user}","gists_url":"https://api.github.com/users/idbrii/gists{/gist_id}","starred_url":"https://api.github.com/users/idbrii/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/idbrii/subscriptions","organizations_url":"https://api.github.com/users/idbrii/orgs","repos_url":"https://api.github.com/users/idbrii/repos","events_url":"https://api.github.com/users/idbrii/events{/privacy}","received_events_url":"https://api.github.com/users/idbrii/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-06-08T05:10:30Z","updated_at":"2025-06-08T05:10:30Z","body":"> It is, but I chose .gzip to work around the itch.io behavior of renaming files that end in .gz to remove the extension.\r\n\r\nDoesn't it remove the extension because after the browser delivers the file, it's uncompressed?\r\n\r\nOn a related issue, someone posted [this article about downloading compressed web game files](https://miltoncandelero.github.io/unity-webgl-compression) and the \"How the internet actually works\" section sounds like what we'd want is for the web template to request the uncompressed file, allow the server+browser to handle de/compression, and if that request fails then request the compressed one and decompress ourselves. That would enable the best case and support your CloudFlare case where Content-Encoding is off limits.\r\n\r\n","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2953561732/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null}]