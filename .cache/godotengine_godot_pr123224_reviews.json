.com/users/NoNormalDev/following{/other_user}","gists_url":"https://api.github.com/users/NoNormalDev/gists{/gist_id}","starred_url":"https://api.github.com/users/NoNormalDev/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/NoNormalDev/subscriptions","organizations_url":"https://api.github.com/users/NoNormalDev/orgs","repos_url":"https://api.github.com/users/NoNormalDev/repos","events_url":"https://api.github.com/users/NoNormalDev/events{/privacy}","received_events_url":"https://api.github.com/users/NoNormalDev/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"Fixes the issue. \n\nThe change makes sense, as `_update_replace_preview()` updates text in column `1` (second column) of a `TreeItem`, but if `with_replace` is `false`, it only has one column, not two, which causes the error. (also in a more general sense a function named `_update_replace_preview()` shouldn't be called if replacing is disabled)\n\nNeeds approval from a maintainer.","state":"APPROVED","html_url":"https://github.com/godotengine/godot/pull/123224#pullrequestreview-5122357565","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/123224","author_association":"CONTRIBUTOR","_links":{"html":{"href":"https://github.com/godotengine/godot/pull/123224#pullrequestreview-5122357565"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/123224"}},"submitted_at":"2026-09-05T17:59:15Z","commit_id":"1b1d4e702805ac124bdc50d581b02111b530ff0a"},{"id":5125909863,"node_id":"PRR_kwDOAO6SJc8AAAABMYctZw","user":{"login":"kitbdev","id":10054226,"node_id":"MDQ6VXNlcjEwMDU0MjI2","avatar_url":"https://avatars.githubusercontent.com/u/10054226?u=f0c85fe8c24debe91dc14d7efa97b51a19250b47&v=4","gravatar_id":"","url":"https://api.github.com/users/kitbdev","html_url":"https://github.com/kitbdev","followers_url":"https://api.github.com/users/kitbdev/followers","following_url":"https://api.github.com/users/kitbdev/following{/oth