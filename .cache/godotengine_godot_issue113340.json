":"ffee88","default":false,"description":"","archived_at":null,"archived_by":null},{"id":1327318271,"node_id":"MDU6TGFiZWwxMzI3MzE4Mjcx","url":"https://api.github.com/repos/godotengine/godot/labels/crash","name":"crash","color":"885544","default":false,"description":"","archived_at":null,"archived_by":null},{"id":1332303119,"node_id":"MDU6TGFiZWwxMzMyMzAzMTE5","url":"https://api.github.com/repos/godotengine/godot/labels/regression","name":"regression","color":"ff63ac","default":false,"description":"","archived_at":null,"archived_by":null}],"state":"closed","locked":false,"assignees":[],"milestone":{"url":"https://api.github.com/repos/godotengine/godot/milestones/23","html_url":"https://github.com/godotengine/godot/milestone/23","labels_url":"https://api.github.com/repos/godotengine/godot/milestones/23/labels","id":12939969,"node_id":"MI_kwDOAO6SJc4AxXLB","number":23,"title":"4.6","description":"","creator":{"login":"Repiteo","id":17489292,"node_id":"MDQ6VXNlcjE3NDg5Mjky","avatar_url":"https://avatars.githubusercontent.com/u/17489292?v=4","gravatar_id":"","url":"https://api.github.com/users/Repiteo","html_url":"https://github.com/Repiteo","followers_url":"https://api.github.com/users/Repiteo/followers","following_url":"https://api.github.com/users/Repiteo/following{/other_user}","gists_url":"https://api.github.com/users/Repiteo/gists{/gist_id}","starred_url":"https://api.github.com/users/Repiteo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Repiteo/subscriptions","organizations_url":"https://api.github.com/users/Repiteo/orgs","repos_url":"https://api.github.com/users/Repiteo/repos","events_url":"https://api.github.com/users/Repiteo/events{/privacy}","received_events_url":"https://api.github.com/users/Repiteo/received_events","type":"User","user_view_type":"public","site_admin":false},"open_issues":3,"closed_issues":2978,"state":"closed","created_at":"2025-05-22T16:25:52Z","updated_at":"2026-10-04T16:23:23Z","due_on":null,"closed_at":"2026-01-26T18:09:14Z"},"comments":3,"created_at":"2025-11-29T23:36:38Z","updated_at":"2025-12-01T12:45:50Z","closed_at":"2025-12-01T12:45:49Z","assignee":null,"author_association":"CONTRIBUTOR","issue_field_values":[],"type":null,"active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"### Tested versions\n\nReproducible in\n- v4.6.dev4.official [bd2ca13c6]\n\nNot reproducible in\n- v4.6.dev3.official [9d84f3d13]\n\n\n### System information\n\nGodot v4.6.dev4.mono - Windows 11 (build 26200) - Multi-window, 1 monitor - Vulkan (Forward+) - dedicated AMD Radeon RX 7800 XT (Advanced Micro Devices, Inc.; 32.0.21025.10016) - AMD Ryzen 7 3800X 8-Core Processor (16 threads) - 31.92 GiB memory\n\n### Issue description\n\nIf you have 2 instances of a script which have an array, and these instances reference each other via the array, or an instance references itself via the array, the editor immediately crashes.\n\nI found this after opening an existing project in v4.6.dev4, and upon opening the scene for my player, the editor crashed each time.\n\nThe player has several instances of a teleport beam, but can only cast one teleport beam at a time.\nEach teleport beam on the player has an array for the other teleport beams, and it checks to make sure that no beams are being cast yet. Left and right hands get their own teleport beams in VR.\n\nThis does not happen using NodePaths, it only crashes with direct references.\n\n### Steps to reproduce\n\n1. Create a new project\n2. Create a new scene\n3. Add a child node\n4. Create a script, C# or GDScript\n5. Add an export array variable with the same type or class_name as your script\n6. Recompile if using C#\n7. Select the child node\n8. Set the script on the child node to the one just created\n9. Save the scene, we are about to crash the editor.\n10. In the inspector, open the array variable and add a reference to the node itself.\n11. The editor freezes for a few seconds, and then crashes.\n\n### Minimal reproduction project (MRP)\n\nThis MRP uses GDScript.\n\n[array-crash-mrp.zip](https://github.com/user-attachments/files/23836619/array-crash-mrp.zip)\n\n1. Open the project\n2. Open repro.tscn\n3. Select the node in the scene tree\n4. In the inspector, open the array, and add a reference to itself\n5. Editor crashes","closed_by":{"login":"akien-mga","id":4701338,"node_id":"MDQ6VXNlcjQ3MDEzMzg=","avatar_url":"https://avatars.githubusercontent.com/u/4701338?v=4","gravatar_id":"","url":"https://api.github.com/users/akien-mga","html_url":"https://github.com/akien-mga","followers_url":"https://api.github.com/users/akien-mga/followers","following_url":"https://api.github.com/users/akien-mga/following{/other_user}","gists_url":"https://api.github.com/users/akien-mga/gists{/gist_id}","starred_url":"https://api.github.com/users/akien-mga/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/akien-mga/subscriptions","organizations_url":"https://api.github.com/users/akien-mga/orgs","repos_url":"https://api.github.com/users/akien-mga/repos","events_url":"https://api.github.com/users/akien-mga/events{/privacy}","received_events_url":"https://api.github.com/users/akien-mga/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/113340/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/godotengine/godot/issues/113340/timeline","performed_via_github_app":null,"state_reason":"completed","pinned_comment":null}