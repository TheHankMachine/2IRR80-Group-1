-01-01T00:00:00Z","followers":0,"following":0,"html_url":"https://github.com/stuartcarnie","id":52852,"node_id":"MDQ6VXNlcjUyODUy","login":"stuartcarnie","type":"User","owned_private_repos":0,"public_gists":0,"public_repos":0,"total_private_repos":0,"url":"https://api.github.com/users/stuartcarnie"},"body":"","html_url":"https://github.com/godotengine/godot/pull/113342#pullrequestreview-3526446225","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/113342","author_association":"CONTRIBUTOR","submitted_at":"2025-12-01T18:31:53Z"},{"id":3526448312,"node_id":"PRR_kwDOAO6SJc7SMVS4","state":"APPROVED","user":{"site_admin":false,"suspended":false,"updated_at":"0001-01-01T00:00:00Z","avatar_url":"https://avatars.githubusercontent.com/u/4701338?u=4a42fd867f2c449fcc23adf635dd574dae98e6c2&v=4","created_at":"0001-01-01T00:00:00Z","followers":0,"following":0,"html_url":"https://github.com/akien-mga","id":4701338,"node_id":"MDQ6VXNlcjQ3MDEzMzg=","login":"akien-mga","type":"User","owned_private_repos":0,"public_gists":0,"public_repos":0,"total_private_repos":0,"url":"https://api.github.com/users/akien-mga"},"body":"Build system changes look good to me.","html_url":"https://github.com/godotengine/godot/pull/113342#pullrequestreview-3526448312","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/113342","author_association":"MEMBER","submitted_at":"2025-12-01T18:32:29Z"},{"id":3526851290,"node_id":"PRR_kwDOAO6SJc7SN3ra","state":"CHANGES_REQUESTED","user":{"site_admin":false,"suspended":false,"updated_at":"0001-01-01T00:00:00Z","avatar_url":"https://avatars.githubusercontent.com/u/2308167?u=f7f8e0273f784f5ec6f6b7fe4a88d449896eb48a&v=4","created_at":"0001-01-01T00:00:00Z","followers":0,"following":0,"html_url":"https://github.com/Ivorforce","id":2308167,"node_id":"MDQ6VXNlcjIzMDgxNjc=","login":"Ivorforce","type":"User","owned_private_repos":0,"public_gists":0,"public_repos":0,"total_private_repos":0,"url":"https://api.github.com/users/Ivorforce"},"body":"Adding a `profiler` option makes sense.\r\nBut, for ease of use, I think `profiler` should be deduced if not explicitly provided, using the previous logic. I really liked that I _didn't_ have to write explicitly which profiler should be used, in addition to the path. Especially, not handling the \"`profiler_path=` set but `profiler=` not set\" case could lead to confusion.","html_url":"https://github.com/godotengine/godot/pull/113342#pullrequestreview-3526851290","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/113342","author_association":"MEMBER","submitted_at":"2025-12-01T20:27:58Z"},{"id":3530155970,"node_id":"PRR_kwDOAO6SJc7SaefC","state":"COMMENTED","user":{"site_admin":false,"suspended":false,"updated_at":"0001-01-01T00:00:00Z","avatar_url":"https://avatars.githubusercontent.com/u/2308167?u=f7f8e0273f784f5ec6f6b7fe4a88d449896eb48a&v=4","created_at":"0001-01-01T00:00:00Z","followers":0,"following":0,"html_url":"https://github.com/Ivorforce","id":2308167,"node_id":"MDQ6VXNlcjIzMDgxNjc=","login":"Ivorforce","type":"User","owned_private_repos":0,"public_gists":0,"public_repos":0,"total_private_repos":0,"url":"https://api.github.com/users/Ivorforce"},"body":"> I would prefer adding quality of life improvements in the other direction: pass profiler=tracy, and have it automatically find the Tracy SDK in bin/build_deps/tracy downloaded via misc/scripts/download_tracy_sdk.py. profiler_path would remain as an advanced option for folks who want to keep their profiler out of tree (e.g. if they use it for other projects too, or contribute to it, as opposed to just download, build and forget).\r\n\r\nThis might also be nice. In my mind, both would be possible.\r\n\r\n> I won't die on that hill, but I think what I suggest is more in line with how we handle extra build time dependencies currently (mesa-nir-static, ANGLE, Pix, etc.).\r\n\r\nMe neither. Let's go with your suggestion then (handle incorrect states with helpful error messages).\r\n\r\nEdit: Also, this PR needs a rebase now, with #113279 merged, and the instruments case needs to declare `GodotProfileZoneGroupedFirstScript` and `godot_cleanup_profiler`.","html_url":"https://github.com/godotengine/godot/pull/113342#pullrequestreview-3530155970","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/113342","author_association":"MEMBER","submitted_at":"2025-12-02T13:37:33Z"},{"id":3531818532,"node_id":"PRR_kwDOAO6SJc7Sg0Yk","state":"COMMENTED","user":{"site_admin":false,"suspended":false,"updated_at":"0001-01-01T00:00:00Z","avatar_url":"https://avatars.githubusercontent.com/u/2308167?u=f7f8e0273f784f5ec6f6b7fe4a88d449896eb48a&v=4","created_at":"0001-01-01T00:00:00Z","followers":0,"following":0,"html_url":"https://github.com/Ivorforce","id":2308167,"node_id":"MDQ6VXNlcjIzMDgxNjc=","login":"Ivorforce","type":"User","owned_private_repos":0,"public_gists":0,"public_repos":0,"total_private_repos":0,"url":"https://api.github.com/users/Ivorforce"},"body":"","html_url":"https://github.com/godotengine/godot/pull/113342#pullrequestreview-3531818532","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/113342","author_association":"MEMBER","submitted_at":"2025-12-02T19:34:13Z"},{"id":3531848841,"node_id":"PRR_kwDOAO6SJc7Sg7yJ","state":"COMMENTED","user":{"site_admin":false,"suspended":false,"updated_at":"0001-01-01T00:00:00Z","avatar_url":"https://avatars.githubusercontent.com/u/52852?v=4","created_at":"0001-01-01T00:00:00Z","followers":0,"following":0,"html_url":"https://github.com/stuartcarnie","id":52852,"node_id":"MDQ6VXNlcjUyODUy","login":"stuartcarnie","type":"User","owned_private_repos":0,"public_gists":0,"public_repos":0,"total_private_repos":0,"url":"https://api.github.com/users/stuartcarnie"},"body":"","html_url":"https://github.com/godotengine/godot/pull/113342#pullrequestreview-3531848841","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/113342","author_association":"CONTRIBUTOR