.githubusercontent.com/u/123702514?v=4","gravatar_id":"","url":"https://api.github.com/users/PhairZ","html_url":"https://github.com/PhairZ","followers_url":"https://api.github.com/users/PhairZ/followers","following_url":"https://api.github.com/users/PhairZ/following{/other_user}","gists_url":"https://api.github.com/users/PhairZ/gists{/gist_id}","starred_url":"https://api.github.com/users/PhairZ/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/PhairZ/subscriptions","organizations_url":"https://api.github.com/users/PhairZ/orgs","repos_url":"https://api.github.com/users/PhairZ/repos","events_url":"https://api.github.com/users/PhairZ/events{/privacy}","received_events_url":"https://api.github.com/users/PhairZ/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-06-12T19:49:11Z","updated_at":"2025-06-13T00:01:49Z","body":"> Is this intended?\r\n\r\nNo, this is not. ~I'll try to fix it ASAP~. Fixed.","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2967989896/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2968168668","html_url":"https://github.com/godotengine/godot/pull/105151#issuecomment-2968168668","issue_url":"https://api.github.com/repos/godotengine/godot/issues/105151","id":2968168668,"node_id":"IC_kwDOAO6SJc6w6qjc","user":{"login":"KoBeWi","id":2223172,"node_id":"MDQ6VXNlcjIyMjMxNzI=","avatar_url":"https://avatars.githubusercontent.com/u/2223172?v=4","gravatar_id":"","url":"https://api.github.com/users/KoBeWi","html_url":"https://github.com/KoBeWi","followers_url":"https://api.github.com/users/KoBeWi/followers","following_url":"https://api.github.com/users/KoBeWi/following{/other_user}","gists_url":"https://api.github.com/users/KoBeWi/gists{/gist_id}","starred_url":"https://api.github.com/users/KoBeWi/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/KoBeWi/subscriptions","organizations_url":"https://api.github.com/users/KoBeWi/orgs","repos_url":"https://api.github.com/users/KoBeWi/repos","events_url":"https://api.github.com/users/KoBeWi/events{/privacy}","received_events_url":"https://api.github.com/users/KoBeWi/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-06-12T21:12:04Z","updated_at":"2025-06-12T21:12:04Z","body":"When you try to scale 2 markers, with cursor being at the same position as one of them, the marker might move uncontrollably.\r\n\r\nhttps://github.com/user-attachments/assets/d27e793c-d5bd-4c45-b70d-793c309f2e0d\r\n\r\nNotice how it ended up outside timeline, after minimal mouse movement.","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2968168668/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2968510234","html_url":"https://github.com/godotengine/godot/pull/105151#issuecomment-2968510234","issue_url":"https://api.github.com/repos/godotengine/godot/issues/105151","id":2968510234,"node_id":"IC_kwDOAO6SJc6w798a","user":{"login":"PhairZ","id":123702514,"node_id":"U_kgDOB1-M8g","avatar_url":"https://avatars.githubusercontent.com/u/123702514?v=4","gravatar_id":"","url":"https://api.github.com/users/PhairZ","html_url":"https://github.com/PhairZ","followers_url":"https://api.github.com/users/PhairZ/followers","following_url":"https://api.github.com/users/PhairZ/following{/other_user}","gists_url":"https://api.github.com/users/PhairZ/gists{/gist_id}","starred_url":"https://api.github.com/users/PhairZ/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/PhairZ/subscriptions","organizations_url":"https://api.github.com/users/PhairZ/orgs","repos_url":"https://api.github.com/users/PhairZ/repos","events_url":"https://api.github.com/users/PhairZ/events{/privacy}","received_events_url":"https://api.github.com/users/PhairZ/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-06-13T00:07:53Z","updated_at":"2025-06-13T00:08:09Z","body":"> Notice how it ended up outside timeline, after minimal mouse movement.\r\n\r\nThis is intended. it is caused by you moving the mouse cursor really close to the timeline cursor.\r\n\r\nhttps://github.com/user-attachments/assets/4accc213-f7a0-497a-8d55-a3af4c6727f4\r\n\r\nNotice how the closer you are to the cursor. the scaling factor increases faster than when farther away.\r\n\r\n","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2968510234/reactions","total_count":1,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":1,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2969900376","html_url":"https://github.com/godotengine/godot/pull/105151#issuecomment-2969900376","issue_url":"https://api.github.com/repos/godotengine/godot/issues/105151","id":2969900376,"node_id":"IC_kwDOAO6SJc6xBRVY","user":{"login":"KoBeWi","id":2223172,"node_id":"MDQ6VXNlcjIyMjMxNzI=","avatar_url":"https://avatars.githubusercontent.com/u/2223172?v=4","gravatar_id":"","url":"https://api.github.com/users/KoBeWi","html_url":"https://github.com/KoBeWi","followers_url":"https://api.github.com/users/KoBeWi/followers","following_url":"https://api.github.com/users/KoBeWi/following{/other_user}","gists_url":"https://api.github.com/users/KoBeWi/gists{/gist_id}","starred_url":"https://api.github.com/users/KoBeWi/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/KoBeWi/subscriptions","organizations_url":"https://api.github.com/users/KoBeWi/orgs","repos_url":"https://api.github.com/users/KoBeWi/repos","events_url":"https://api.github.com/users/KoBeWi/events{/privacy}","received_events_url":"https://api.github.com/users/KoBeWi/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-06-13T10:35:22Z","updated_at":"2025-06-13T10:35:22Z","body":"Yeah but instant jumps aren't very friendly. I didn't catch it in the video, but at some point _any_ mouse movement moved the marker to infinity.","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2969900376/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2972060909","html_url":"https://github.com/godotengine/godot/pull/105151#issuecomment-2972060909","issue_url":"https://api.github.com/repos/godotengine/godot/issues/105151","id":2972060909,"node_id":"IC_kwDOAO6SJc6xJgzt","user":{"login":"PhairZ","id":123702514,"node_id":"U_kgDOB1-M8g","avatar_url":"https://avatars.githubusercontent.com/u/123702514?v=4","gravatar_id":"","url":"https://api.github.com/users/PhairZ","html_url":"https://github.com/PhairZ","followers_url":"https://api.github.com/users/PhairZ/followers","following_url":"https://api.github.com/users/PhairZ/following{/other_user}","gists_url":"https://api.github.com/users/PhairZ/gists{/gist_id}","starred_url":"https://api.github.com/users/PhairZ/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/PhairZ/subscriptions","organizations_url":"https://api.github.com/users/PhairZ/orgs","repos_url":"https://api.github.com/users/PhairZ/repos","events_url":"https://api.github.com/users/PhairZ/events{/privacy}","received_events_url":"https://api.github.com/users/PhairZ/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-06-14T00:58:31Z","updated_at":"2025-06-14T00:58:31Z","body":"I don't think limiting the scaling factor delta would be a good idea.\nNotice how keys closer to the cursor need to be scaled with larger delta pixels to still be at the mouse cursor position.\n\nPixels close to the timeline cursor would have small pixel positions, lets say 30, in order to make them follow the mouse cursor when scaling you have to set its final destination to its position + delta mouse position, which results in 4x or 5x scaling, if we assume the mouse moved only 150 pixels.\n\nFurther pixels would scale slower because they need smaller factors as their value is already large so moving from 800 to 950 would need multiplying the position only by about 1.1x.\n\nSo pixels at a position of 1 would need multiplying by crazy numbers to follow the mouse cursor.\n\nThis is all intended behavior and anything other than that would result in the timeline editor feeling irresponsive. Unless something results in an undefined behavior all of this should be fine. I hope my message came across correctly.","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2972060909/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3005261728","html_url":"https://github.com/godotengine/godot/pull/105151#issuecomment-3005261728","issue_url":"https://api.github.com/repos/godotengine/godot/issues/105151","id":3005261728,"node_id":"IC_kwDOAO6SJc6zIKeg","user":{"login":"KoBeWi","id":2223172,"node_id":"MDQ6VXNlcjIyMjMxNzI=","avatar_url":"https://avatars.githubusercontent.com/u/2223172?v=4","gravatar_id":"","url":"https://api.github.com/users/KoBeWi","html_url":"https://github.com/KoBeWi","followers_url":"https://api.github.com/users/KoBeWi/followers","following_url":"https://api.github.com/users/KoBeWi/following{/other_user}","gists_url":"https://api.github.com/users/KoBeWi/gists{/gist_id}","starred_url":"https://api.github.com/users/KoBeWi/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/KoBeWi/subscriptions","organizations_url":"https://api.github.com/users/KoBeWi/orgs","repos_url":"https://api.github.com/users/KoBeWi/repos","events_url":"https://api.github.com/users/KoBeWi/events{/privacy}","received_events_url":"https://api.github.com/users/KoBeWi/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-06-25T15:46:37Z","updated_at":"2025-07-03T18:14:01Z","body":"> I don't think limiting the scaling factor delta would be a good idea.\r\n\r\nI printed the `delta` out of curiosity and it went up to 12k. Eventually I even managed to make it shoot to infinity.\r\n![image](https://github.com/user-attachments/assets/6b41ffe4-707d-4eed-85d4-bb3f74758a35)\r\nThis makes the markers unusable.\r\n\r\nWhile it's not that easy to trigger unreasonable deltas, it can happen by accident, potentially breaking the animation.","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3005261728/reactions","total_count":1,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":1,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3014819286","html_url":"https://github.com/godotengine/godot/pull/105151#issuecomment-3014819286","issue_url":"https://api.github.com/repos/godotengine/godot/issues/105151","id":3014819286,"node_id":"IC_kwDOAO6SJc6zsn3W","user":{"login":"PhairZ","id":123702514,"node_id":"U_kgDOB1-M8g","avatar_url":"https://avatars.githubusercontent.com/u/123702514?v=4","gravatar_id":"","url":"https://api.github.com/users/PhairZ","html_url":"https://github.com/PhairZ","followers_url":"https://api.github.com/users/PhairZ/followers","following_url":"https://api.github.com/users/PhairZ/following{/other_user}","gists_url":"https://api.github.com/users/PhairZ/gists{/gist_id}","starred_url":"https://api.github.com/users/PhairZ/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/PhairZ/subscriptions","organizations_url":"https://api.github.com/users/PhairZ/orgs","repos_url":"https://api.github.com/users/PhairZ/repos","events_url":"https://api.github.com/users/PhairZ/events{/privacy}","received_events_url":"https://api.github.com/users/PhairZ/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-06-28T01:45:38Z","updated_at":"2025-06-28T01:45:38Z","body":"Maybe that can be resolved by making scalings that are from really close to the cursor use a different scaling factor?","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3014819286/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3033387061","html_url":"https://github.com/godotengine/godot/pull/105151#issuecomment-3033387061","issue_url":"https://api.github.com/repos/godotengine/godot/issues/105151","id":3033387061,"node_id":"IC_kwDOAO6SJc60zdA1","user":{"login":"PhairZ","id":123702514,"node_id":"U_kgDOB1-M8g","avatar_url":"https://avatars.githubusercontent.com/u/123702514?v=4","gravatar_id":"","url":"https://api.github.com/users/PhairZ","html_url":"https://github.com/PhairZ","followers_url":"https://api.github.com/users/PhairZ/followers","following_url":"https://api.github.com/users/PhairZ/following{/other_user}","gists_url":"https://api.github.com/users/PhairZ/gists{/gist_id}","starred_url":"https://api.github.com/users/PhairZ/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/PhairZ/subscriptions","organizations_url":"https://api.github.com/users/PhairZ/orgs","repos_url":"https://api.github.com/users/PhairZ/repos","events_url":"https://api.github.com/users/PhairZ/events{/privacy}","received_events_url":"https://api.github.com/users/PhairZ/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-07-03T19:30:33Z","updated_at":"2025-07-03T19:30:33Z","body":"@KoBeWi Addressed the issue by making it so that whenever the mouse cursor is too close to pivot, we add a small constant value to increase the difference of the cursors. This seems to work fine, I would be pleased to hear your feedback.\r\nFixed a minor issue where scaling with a negative factor had no effect and instead scaled as if the factor were absolute.\r\nThe intended behavior was that scaling with a negative factor (i.e. scaling from the left of the animation cursor to the right and vice versa) should reverse the keyframes. Keep that in mind when testing.","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3033387061/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3243467867","html_url":"https://github.com/godotengine/godot/pull/105151#issuecomment-3243467867","issue_url":"https://api.github.com/repos/godotengine/godot/issues/105151","id":3243467867,"node_id":"IC_kwDOAO6SJc7BU2Rb","user":{"login":"YeldhamDev","id":30739239,"node_id":"MDQ6VXNlcjMwNzM5MjM5","avatar_url":"https://avatars.githubusercontent.com/u/30739239?v=4","gravatar_id":"","url":"https://api.github.com/users/YeldhamDev","html_url":"https://github.com/YeldhamDev","followers_url":"https://api.github.com/users/YeldhamDev/followers","following_url":"https://api.github.com/users/YeldhamDev/following{/other_user}","gists_url":"https://api.github.com/users/YeldhamDev/gists{/gist_id}","starred_url":"https://api.github.com/users/YeldhamDev/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/YeldhamDev/subscriptions","organizations_url":"https://api.github.com/users/YeldhamDev/orgs","repos_url":"https://api.github.com/users/YeldhamDev/repos","events_url":"https://api.github.com/users/YeldhamDev/events{/privacy}","received_events_url":"https://api.github.com/users/YeldhamDev/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-09-02T00:43:16Z","updated_at":"2025-09-02T00:43:16Z","body":"This honestly feels kinda unpolished. The scaling of bezier keys follows on Unity's footsteps by showing handles for scaling, and I think scaling for basic keys should do the same.","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3243467867/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3247214740","html_url":"https://github.com/godotengine/godot/pull/105151#issuecomment-3247214740","issue_url":"https://api.github.com/repos/godotengine/godot/issues/105151","id":3247214740,"node_id":"IC_kwDOAO6SJc7BjJCU","user":{"login":"PhairZ","id":123702514,"node_id":"U_kgDOB1-M8g","avatar_url":"https://avatars.githubusercontent.com/u/123702514?v=4","gravatar_id":"","url":"https://api.github.com/users/PhairZ","html_url":"https://github.com/PhairZ","followers_url":"https://api.github.com/users/PhairZ/followers","following_url":"https://api.github.com/users/PhairZ/following{/other_user}","gists_url":"https://api.github.com/users/PhairZ/gists{/gist_id}","starred_url":"https://api.github.com/users/PhairZ/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/PhairZ/subscriptions","organizations_url":"https://api.github.com/users/PhairZ/orgs","repos_url":"https://api.github.com/users/PhairZ/repos","events_url":"https://api.github.com/users/PhairZ/events{/privacy}","received_events_url":"https://api.github.com/users/PhairZ/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-09-03T00:16:41Z","updated_at":"2025-09-03T00:16:41Z","body":"I kinda do agree, but scaling like this is usually faster and matches with blender, and works well with the already existent Keyframe/Marker move action.\r\nI don't know if having handles is necessary. For Bezier curves you're working in 2D space in which scaling shortcuts won't click intuitively with users.\r\n\r\nI'd like to hear more of your thoughts on this.","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3247214740/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3262280426","html_url":"https://github.com/godotengine/godot/pull/105151#issuecomment-3262280426","issue_url":"https://api.github.com/repos/godotengine/godot/issues/105151","id":3262280426,"node_id":"IC_kwDOAO6SJc7CcnLq","user":{"login":"YeldhamDev","id":30739239,"node_id":"MDQ6VXNlcjMwNzM5MjM5","avatar_url":"https://avatars.githubusercontent.com/u/30739239?v=4","gravatar_id":"","url":"https://api.github.com/users/YeldhamDev","html_url":"https://github.com/YeldhamDev","followers_url":"https://api.github.com/users/YeldhamDev/followers","following_url":"https://api.github.com/users/YeldhamDev/following{/other_user}","gists_url":"https://api.github.com/users/YeldhamDev/gists{/gist_id}","starred_url":"https://api.github.com/users/YeldhamDev/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/YeldhamDev/subscriptions","organizations_url":"https://api.github.com/users/YeldhamDev/orgs","repos_url":"https://api.github.com/users/YeldhamDev/repos","events_url":"https://api.github.com/users/YeldhamDev/events{/privacy}","received_events_url":"https://api.github.com/users/YeldhamDev/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-09-06T14:27:34Z","updated_at":"2025-09-06T14:27:34Z","body":"Handles work better because they are more intuitive. Instead of being in a shortcut that the user will not be aware of from the get-go unless they already have experience with it on things like Blender, handles are tangible things they can be interacted with and be can be understood immediately.\r\n\r\nBesides, handles and shortcuts aren't mutually exclusive, they can co-exist. But I think handles should be the ones implemented first.","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3262280426/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3367110514","html_url":"https://github.com/godotengine/godot/pull/105151#issuecomment-3367110514","issue_url":"https://api.github.com/repos/godotengine/godot/issues/105151","id":3367110514,"node_id":"IC_kwDOAO6SJc7Isgdy","user":{"login":"lyuma","id":39946030,"node_id":"MDQ6VXNlcjM5OTQ2MDMw","avatar_url":"https://avatars.githubusercontent.com/u/39946030?v=4","gravatar_id":"","url":"https://api.github.com/users/lyuma","html_url":"https://github.com/lyuma","followers_url":"https://api.github.com/users/lyuma/followers","following_url":"https://api.github.com/users/lyuma/following{/other_user}","gists_url":"https://api.github.com/users/lyuma/gists{/gist_id}","starred_url":"https://api.github.com/users/lyuma/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/lyuma/subscriptions","organizations_url":"https://api.github.com/users/lyuma/orgs","repos_url":"https://api.github.com/users/lyuma/repos","events_url":"https://api.github.com/users/lyuma/events{/privacy}","received_events_url":"https://api.github.com/users/lyuma/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-10-03T20:22:57Z","updated_at":"2025-10-03T20:22:57Z","body":"Feedback from animation meeting. We agree the feature of being able to scale animation keyframes is important, but we some UX fixes. Here are some of the notes of what people brought up in the meeting:\r\n\r\n* Needs visual feedback. Since there is a comparison to Blender, blender will show a dotted line to the origin of the scale operation.\r\n* By default should scale relative to the midpoint the start and end.\r\n* \"stretch operation\" for scaling from the start and end from the edge of the bounding box of what is selected (Unity does this).\r\n* Allow negative scale","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3367110514/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3367217312","html_url":"https://github.com/godotengine/godot/pull/105151#issuecomment-3367217312","issue_url":"https://api.github.com/repos/godotengine/godot/issues/105151","id":3367217312,"node_id":"IC_kwDOAO6SJc7Is6ig","user":{"login":"PhairZ","id":123702514,"node_id":"U_kgDOB1-M8g","avatar_url":"https://avatars.githubusercontent.com/u/123702514?v=4","gravatar_id":"","url":"https://api.github.com/users/PhairZ","html_url":"https://github.com/PhairZ","followers_url":"https://api.github.com/users/PhairZ/followers","following_url":"https://api.github.com/users/PhairZ/following{/other_user}","gists_url":"https://api.github.com/users/PhairZ/gists{/gist_id}","starred_url":"https://api.github.com/users/PhairZ/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/PhairZ/subscriptions","organizations_url":"https://api.github.com/users/PhairZ/orgs","repos_url":"https://api.github.com/users/PhairZ/repos","events_url":"https://api.github.com/users/PhairZ/events{/privacy}","received_events_url":"https://api.github.com/users/PhairZ/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-10-03T21:06:51Z","updated_at":"2025-10-03T21:06:51Z","body":"> Needs visual feedback. Since there is a comparison to Blender, blender will show a dotted line to the origin of the scale operation.\r\n\r\nI think this should be added too, currently there's no real feedback to transforming.\r\n\r\n> By default should scale relative to the midpoint the start and end.\r\n\r\nCan I have a reason for why is that? I think being able to scale relative to the timeline head, because it allows for more freedom. Maybe we can have those as an option in the animation settings tho.\r\n\r\n> \"stretch operation\" for scaling from the start and end from the edge of the bounding box of what is selected (Unity does this).\r\n\r\nYeldhamDev did say so and I am convinced. When I get to working on updating this PR this will definitely be the first thing to be added.\r\n\r\n> Allow negative scale\r\n\r\nThe current implementation does allow for this by crossing the origin of scaling with the mouse cursor (If starting from the right side of the anchor, negative scaling would occur when moving the mouse cursor to the left side of the anchor).\r\nThis also matches the blender implementation.","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3367217312/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3367339175","html_url":"https://github.com/godotengine/godot/pull/105151#issuecomment-3367339175","issue_url":"https://api.github.com/repos/godotengine/godot/issues/105151","id":3367339175,"node_id":"IC_kwDOAO6SJc7ItYSn","user":{"login":"YeldhamDev","id":30739239,"node_id":"MDQ6VXNlcjMwNzM5MjM5","avatar_url":"https://avatars.githubusercontent.com/u/30739239?v=4","gravatar_id":"","url":"https://api.github.com/users/YeldhamDev","html_url":"https://github.com/YeldhamDev","followers_url":"https://api.github.com/users/YeldhamDev/followers","following_url":"https://api.github.com/users/YeldhamDev/following{/other_user}","gists_url":"https://api.github.com/users/YeldhamDev/gists{/gist_id}","starred_url":"https://api.github.com/users/YeldhamDev/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/YeldhamDev/subscriptions","organizations_url":"https://api.github.com/users/YeldhamDev/orgs","repos_url":"https://api.github.com/users/YeldhamDev/repos","events_url":"https://api.github.com/users/YeldhamDev/events{/privacy}","received_events_url":"https://api.github.com/users/YeldhamDev/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-10-03T22:01:10Z","updated_at":"2025-10-03T22:01:10Z","body":"The scale draggers should look something like this, to follow the design of the bezier ones:\r\n<img width=\"465\" height=\"170\" alt=\"scaling\" src=\"https://github.com/user-attachments/assets/324981e5-9f89-468c-8a60-789e412ad387\" />","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3367339175/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3369234090","html_url":"https://github.com/godotengine/godot/pull/105151#issuecomment-3369234090","issue_url":"https://api.github.com/repos/godotengine/godot/issues/105151","id":3369234090,"node_id":"IC_kwDOAO6SJc7I0m6q","u