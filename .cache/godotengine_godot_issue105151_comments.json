zNTI2ODQ3","avatar_url":"https://avatars.githubusercontent.com/u/33526847?v=4","gravatar_id":"","url":"https://api.github.com/users/viksl","html_url":"https://github.com/viksl","followers_url":"https://api.github.com/users/viksl/followers","following_url":"https://api.github.com/users/viksl/following{/other_user}","gists_url":"https://api.github.com/users/viksl/gists{/gist_id}","starred_url":"https://api.github.com/users/viksl/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/viksl/subscriptions","organizations_url":"https://api.github.com/users/viksl/orgs","repos_url":"https://api.github.com/users/viksl/repos","events_url":"https://api.github.com/users/viksl/events{/privacy}","received_events_url":"https://api.github.com/users/viksl/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-05-07T12:20:07Z","updated_at":"2025-05-07T12:20:07Z","body":"I'll find some time to test it though I'm sick right now.\r\nIf you don't mind a question, does this take into account the curve editor for animation too for scaling of keys.\r\nIf so, does it work with scaling in both X and Y axis?\r\nIf so, is there a way to lock it to work with just one axis for precisions (let's say by pressing X or Y to specify a single axis)?","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2858373937/reactions","total_count":1,"+1":0,"-1":0,"laugh":0,"hooray":1,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2876809839","html_url":"https://github.com/godotengine/godot/pull/105151#issuecomment-2876809839","issue_url":"https://api.github.com/repos/godotengine/godot/issues/105151","id":2876809839,"node_id":"IC_kwDOAO6SJc6reKJv","user":{"login":"PhairZ","id":123702514,"node_id":"U_kgDOB1-M8g","avatar_url":"https://avatars.githubusercontent.com/u/123702514?v=4","gravatar_id":"","url":"https://api.github.com/users/PhairZ","html_url":"https://github.com/PhairZ","followers_url":"https://api.github.com/users/PhairZ/followers","following_url":"https://api.github.com/users/PhairZ/following{/other_user}","gists_url":"https://api.github.com/users/PhairZ/gists{/gist_id}","starred_url":"https://api.github.com/users/PhairZ/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/PhairZ/subscriptions","organizations_url":"https://api.github.com/users/PhairZ/orgs","repos_url":"https://api.github.com/users/PhairZ/repos","events_url":"https://api.github.com/users/PhairZ/events{/privacy}","received_events_url":"https://api.github.com/users/PhairZ/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-05-13T14:41:11Z","updated_at":"2025-05-13T14:41:11Z","body":"Scaling in the curve editor has already been handled in PR #100470","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2876809839/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2966144928","html_url":"https://github.com/godotengine/godot/pull/105151#issuecomment-2966144928","issue_url":"https://api.github.com/repos/godotengine/godot/issues/105151","id":2966144928,"node_id":"IC_kwDOAO6SJc6wy8eg","user":{"login":"KoBeWi","id":2223172,"node_id":"MDQ6VXNlcjIyMjMxNzI=","avatar_url":"https://avatars.githubusercontent.com/u/2223172?v=4","gravatar_id":"","url":"https://api.github.com/users/KoBeWi","html_url":"https://github.com/KoBeWi","followers_url":"https://api.github.com/users/KoBeWi/followers","following_url":"https://api.github.com/users/KoBeWi/following{/other_user}","gists_url":"https://api.github.com/users/KoBeWi/gists{/gist_id}","starred_url":"https://api.github.com/users/KoBeWi/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/KoBeWi/subscriptions","organizations_url":"https://api.github.com/users/KoBeWi/orgs","repos_url":"https://api.github.com/users/KoBeWi/repos","events_url":"https://api.github.com/users/KoBeWi/events{/privacy}","received_events_url":"https://api.github.com/users/KoBeWi/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-06-12T10:57:44Z","updated_at":"2025-06-12T10:57:44Z","body":"I find this somewhat difficult to use. For example I'd want to stretch 1s animation to 2s:\r\n\r\nhttps://github.com/user-attachments/assets/34001568-93de-4543-b67b-143b22154163\r\n\r\nDragging the keys to the right always shrinks them, so I have to overshoot the animation, then move them back. Also it involves guess work on how much I need to scale, there is no way to scale in fixed increments (steps).\r\n\r\nI think scaling should be opposite, i.e. dragging to the right should expand. Or at least there should be modifier to reverse the direction.\r\nNot sure about steps though. Maybe there could be another modifier to use animation snapping setting for increments (so e.g. with 0.1 snapping, the scale will increase to 1.1, 1.2, 1.3 etc., instead of linearly). Though some separate step value would be better.","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2966144928/reactions","total_count":1,"+1":0,"-1":0,"laugh":0,"hooray":1,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2967315705","html_url":"https://github.com/godotengine/godot/pull/105151#issuecomment-2967315705","issue_url":"https://api.github.com/repos/godotengine/godot/issues/105151","id":2967315705,"node_id":"IC_kwDOAO6SJc6w3aT5","user":{"login":"PhairZ","id":123702514,"node_id":"U_kgDOB1-M8g","avatar_url":"https://avatars.githubusercontent.com/u/123702514?v=4","gravatar_id":"","url":"https://api.github.com/users/PhairZ","html_url":"https://github.com/PhairZ","followers_url":"https://api.github.com/users/PhairZ/followers","following_url":"https://api.github.com/users/PhairZ/following{/other_user}","gists_url":"https://api.github.com/users/PhairZ/gists{/gist_id}","starred_url":"https://api.github.com/users/PhairZ/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/PhairZ/subscriptions","organizations_url":"https://api.github.com/users/PhairZ/orgs","repos_url":"https://api.github.com/users/PhairZ/repos","events_url":"https://api.github.com/users/PhairZ/events{/privacy}","received_events_url":"https://api.github.com/users/PhairZ/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-06-12T15:32:19Z","updated_at":"2025-06-12T15:33:54Z","body":"I tried to match how blender behaves when scaling, because its the animation software most users would be familiar with (and it was mentioned in the proposal).\r\n\r\nIt scaled the animation relative to the cursor (The timeline current time).\r\n\r\nhttps://github.com/user-attachments/assets/f06d7513-bf7c-4be4-9cc9-053819bf399a\r\n\r\nI hope you can see the similarities.\r\nThis PR also tackles a visual bug where right clicking while moving doesn't visually reset keys.\r\n\r\nEdit: Similar to blender, holding CTRL while dragging snaps too. Updated the PR description.\r\n","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2967315705/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2967807997","html_url":"https://github.com/godotengine/godot/pull/105151#issuecomment-2967807997","issue_url":"https://api.github.com/repos/godotengine/godot/issues/105151","id":2