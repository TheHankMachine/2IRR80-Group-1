.github.com/users/HolonProduction/followers","following_url":"https://api.github.com/users/HolonProduction/following{/other_user}","gists_url":"https://api.github.com/users/HolonProduction/gists{/gist_id}","starred_url":"https://api.github.com/users/HolonProduction/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/HolonProduction/subscriptions","organizations_url":"https://api.github.com/users/HolonProduction/orgs","repos_url":"https://api.github.com/users/HolonProduction/repos","events_url":"https://api.github.com/users/HolonProduction/events{/privacy}","received_events_url":"https://api.github.com/users/HolonProduction/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-07-24T14:30:52Z","updated_at":"2026-07-24T14:30:52Z","body":"\r\n[Screencast From 2026-07-24 16-29-46.webm](https://github.com/user-attachments/assets/577bd024-1d1a-44c7-b912-05093095c318)\r\n","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5070976989/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5073836523","html_url":"https://github.com/godotengine/godot/pull/118486#issuecomment-5073836523","issue_url":"https://api.github.com/repos/godotengine/godot/issues/118486","id":5073836523,"node_id":"IC_kwDOAO6SJc8AAAABLmyZ6w","user":{"login":"KoBeWi","id":2223172,"node_id":"MDQ6VXNlcjIyMjMxNzI=","avatar_url":"https://avatars.githubusercontent.com/u/2223172?v=4","gravatar_id":"","url":"https://api.github.com/users/KoBeWi","html_url":"https://github.com/KoBeWi","followers_url":"https://api.github.com/users/KoBeWi/followers","following_url":"https://api.github.com/users/KoBeWi/following{/other_user}","gists_url":"https://api.github.com/users/KoBeWi/gists{/gist_id}","starred_url":"https://api.github.com/users/KoBeWi/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/KoBeWi/subscriptions","organizations_url":"https://api.github.com/users/KoBeWi/orgs","repos_url":"https://api.github.com/users/KoBeWi/repos","events_url":"https://api.github.com/users/KoBeWi/events{/privacy}","received_events_url":"https://api.github.com/users/KoBeWi/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-07-24T20:01:39Z","updated_at":"2026-07-24T20:49:21Z","body":"I looked at the implementation of Polygon3D editor and it's... interesting. The way it works allows it to support custom nodes; you just need to implement 2 internal methods and everything else is handled automatically.\r\n\r\nThe hack used here is particularly stupid, because there is no guarantee that re-editing an object will edit the same node (the occluder may change as a result of undo action). A proper way to fix this bug is to introduce a signal to notify the polygon editor when node's status changes. I gave it a try and it's not possible without significantly reworking the editor, so it's not suitable for a bugfix. Your workaround has to suffice for now.\r\n\r\nEDIT:\r\nSee my PR below for a proper, but less safe fix.","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5073836523/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5078893633","html_url":"https://github.com/godotengine/godot/pull/118486#issuecomment-5078893633","issue_url":"https://api.github.com/repos/godotengine/godot/issues/118486","id":5078893633,"node_id":"IC_kwDOAO6SJc8AAAABLrnEQQ","user":{"login":"Repiteo","id":17489292,"node_id":"MDQ6VXNlcjE3NDg5Mjky","avatar_url":"https://avatars.githubusercontent.com/u/17489292?v=4","gravatar_id":"","url":"htt