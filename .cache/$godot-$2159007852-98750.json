r\n\r\n```diff\r\ndiff --git a/3d/platformer/coin/coin.tscn b/3d/platformer/coin/coin.tscn\r\nindex 6fdd95df..b996fdfc 100644\r\n--- a/3d/platformer/coin/coin.tscn\r\n+++ b/3d/platformer/coin/coin.tscn\r\n@@ -222,7 +222,7 @@ input_ray_pickable = false\r\n script = ExtResource(\"1\")\r\n \r\n [node name=\"Circle\" type=\"MeshInstance3D\" parent=\".\"]\r\n-transform = Transform3D(1, 0, 0, 0, -3.61999e-06, -1, 0, 1, -3.61999e-06, 0.00550658, 0.532125, 0.000651598)\r\n+transform = Transform3D(1, 0, 0, 0, -3.6199901e-06, -1, 0, 1, -3.6199901e-06, 0.00550658, 0.532125, 0.000651598)\r\n layers = 2\r\n mesh = SubResource(\"CylinderMesh_fpglg\")\r\n surface_material_override/0 = ExtResource(\"2_n0rbc\")\r\ndiff --git a/3d/platformer/enemy/enemy.tscn b/3d/platformer/enemy/enemy.tscn\r\nindex d5f344f3..303d3818 100644\r\n--- a/3d/platformer/enemy/enemy.tscn\r\n+++ b/3d/platformer/enemy/enemy.tscn\r\n@@ -445,16 +445,16 @@ script = ExtResource(\"1\")\r\n \r\n [node name=\"Skeleton3D\" parent=\"Enemy/Skeleton\" index=\"0\"]\r\n bones/1/position = Vector3(-5.04871e-28, 0.661877, 0)\r\n-bones/1/rotation = Quaternion(0.707107, -2.48537e-07, -1.95408e-07, 0.707107)\r\n+bones/1/rotation = Quaternion(0.70710677, -2.4853694e-07, -1.9540794e-07, 0.70710677)\r\n bones/2/position = Vector3(-3.87449e-08, 0.475726, -0.0617121)\r\n bones/3/position = Vector3(0.913587, 0.661877, 0.631826)\r\n-bones/3/rotation = Quaternion(1, -2.49197e-38, 7.54979e-08, -1.05879e-22)\r\n+bones/3/rotation = Quaternion(1, -2.4919705e-38, 7.54979e-08, -1.05879e-22)\r\n bones/5/position = Vector3(-0.913587, 0.661877, 0.631826)\r\n-bones/5/rotation = Quaternion(1, -2.49197e-38, 7.54979e-08, -1.05879e-22)\r\n+bones/5/rotation = Quaternion(1, -2.4919705e-38, 7.54979e-08, -1.05879e-22)\r\n bones/7/position = Vector3(1.05436, 0.661877, -0.654576)\r\n-bones/7/rotation = Quaternion(1, -2.49197e-38, 7.54979e-08, -1.05879e-22)\r\n+bones/7/rotation = Quaternion(1, -2.4919705e-38, 7.54979e-08, -1.05879e-22)\r\n bones/9/position = Vector3(-1.05436, 0.661877, -0.654576)\r\n-bones/9/rotation = Quaternion(1, -2.49197e-38, 7.54979e-08, -1.05879e-22)\r\n+bones/9/rotation = Quaternion(1, -2.4919705e-38, 7.54979e-08, -1.05879e-22)\r\n \r\n [node name=\"RayFloor\" type=\"RayCast3D\" parent=\"Enemy/Skeleton\" index=\"1\"]\r\n transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 0.643772, 0.803052)\r\ndiff --git a/3d/platformer/stage/grid_map.scn b/3d/platformer/stage/grid_map.scn\r\nindex 273b2d8d..9f568922 100644\r\nBinary files a/3d/platformer/stage/grid_map.scn and b/3d/platformer/stage/grid_map.scn differ\r\n```","html_url":"https://github.com/godotengine/godot/pull/98750#pullrequestreview-2828831546","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/98750","author_association":"MEMBER","submitted_at":"2025-05-09T15:41:46Z"},{"id":2839834037,"node_id":"PRR_kwDOAO6SJc6pRG21","state":"COMMENTED","user":{"site_admin":false,"suspended":false,"updated_at":"0001-01-01T00:00:00Z","avatar_url":"https://avatars.githubusercontent.com/u/2308167?u=f7f8e0273f784f5ec6f6b7fe4a88d449896eb48a&v=4","created_at":"0001-01-01T00:00:00Z","followers":0,"following":0,"html_url":"https://github.com/Ivorforce","id":2308167,"node_id":"MDQ6VXNlcjIzMDgxNjc=","login":"Ivorforce","type":"User","owned_private_repos":0,"public_gists":0,"public_repos":0,"total_private_repos":0,"url":"https://api.github.com/users/Ivorforce"},"body":"This is a great idea, we should have a very robust float printing system.\r\n\r\nI'd like to know, is there any particular reason you chose `simdjson` for the implementation?\r\nThe algorithm looks good at a glance, but it makes some decisions for us that we might want to make ourselves - for example, when to use `e` notation over plain floating point. (I guess we could patch it, if we wanted to make a decision?). It may also be nice to print directly into a `char32_t` buffer, although the speed difference probably won't matter all too much.\r\nMore interestingly, simdjson does not expose a way to _not_ do scientific notation (although it should be easy to patch this in). I'd argue that if we were to merge this, we should use `grisu2` for `String::num` as well.\r\n","html_url":"https://github.com/godotengine/godot/pull/98750#pullrequestreview-2839834037","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/98750","author_association":"MEMBER","submitted_at":"2025-05-14T11:49:58Z"},{"id":2840049687,"node_id":"PRR_kwDOAO6SJc6pR7gX","state":"COMMENTED","user":{"site_admin":false,"suspended":false,"updated_at":"0001-01-01T00:00:00Z","avatar_url":"https://avatars.githubusercontent.com/u/1646875?u=24618295fece29a0bf5c850faf2555985232f5f2&v=4","created_at":"0001-01-01T00:00:00Z","followers":0,"following":0,"html_url":"https://github.com/aaronfranke","id":1646875,"node_id":"MDQ6VXNlcjE2NDY4NzU=","login":"aaronfranke","type":"User","owned_private_repos":0,"public_gists":0,"public_repos":0,"total_private_repos":0,"url":"https://api.github.com/users/aaronfranke"},"body":"","html_url":"https://github.com/godotengine/godot/pull/98750#pullrequestreview-2840049687","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/98750","author_association":"MEMBER","submitted_at":"2025-05-14T12:46:34Z"},{"id":2840062370,"node_id":"PRR_kwDOAO6SJc6pR-mi","state":"COMMENTED","user":{"site_admin":false,"suspended":false,"updated_at":"0001-01-01T00:00:00Z","avatar_url":"https://avatars.githubusercontent.com/u/2308167?u=f7f8e0273f784f5ec6f6b7fe4a88d449896eb48a&v=4","created_at":"0001-01-01T00:00:00Z","followers":0,"following":0,"html_url":"https://github.com/Ivorforce","id":2308167,"node_id":"MDQ6VXNlcjIzMDgxNjc=","login":"Ivorforce","type":"User","owned_private_repos":0,"public_gists":0,"public_repos":0,"total_private_repos":0,"url":"https://api.github.com/users/Ivorforce"},"body":"","html_url":"https://github.com/godotengine/godot/pull/98750#pullrequestreview-2840062370","pull_request_url":"https://api.github.com/repos/godoteng