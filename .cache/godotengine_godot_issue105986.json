roduce\n\n1. Create a 2D scene with a Sprite2D and AnimationPlayer.\n\n2. Animate the sprite’s position (e.g. from (100, 100) to (500, 100)) over 1s, loop enabled.\n\n### Minimal reproduction project (MRP)\n\n.","closed_by":{"login":"AThousandShips","id":96648715,"node_id":"U_kgDOBcK-Cw","avatar_url":"https://avatars.githubusercontent.com/u/96648715?v=4","gravatar_id":"","url":"https://api.github.com/users/AThousandShips","html_url":"https://github.com/AThousandShips","followers_url":"https://api.github.com/users/AThousandShips/followers","following_url":"https://api.github.com/users/AThousandShips/following{/other_user}","gists_url":"https://api.github.com/users/AThousandShips/gists{/gist_id}","starred_url":"https://api.github.com/users/AThousandShips/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/AThousandShips/subscriptions","organizations_url":"https://api.github.com/users/AThousandShips/orgs","repos_url":"https://api.github.com/users/AThousandShips/repos","events_url":"https://api.github.com/users/AThousandShips/events{/privacy}","received_events_url":"https://api.github.com/users/AThousandShips/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/105986/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/godotengine/godot/issues/105986/timeline","performed_via_github_app":null,"state_reason":"not_planned","pinned_comment":null}