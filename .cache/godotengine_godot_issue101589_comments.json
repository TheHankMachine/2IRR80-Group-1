ithub.com/users/AThousandShips/subscriptions","organizations_url":"https://api.github.com/users/AThousandShips/orgs","repos_url":"https://api.github.com/users/AThousandShips/repos","events_url":"https://api.github.com/users/AThousandShips/events{/privacy}","received_events_url":"https://api.github.com/users/AThousandShips/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-01-16T14:59:20Z","updated_at":"2025-01-16T14:59:20Z","body":"Only demo and demo_2 were available until now, both were big, but after tweaking some the demo_2 was workable, but still quite slow","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2595955202/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2596277303","html_url":"https://github.com/godotengine/godot/issues/101589#issuecomment-2596277303","issue_url":"https://api.github.com/repos/godotengine/godot/issues/101589","id":2596277303,"node_id":"IC_kwDOAO6SJc6awAw3","user":{"login":"SkanerSoft","id":13809475,"node_id":"MDQ6VXNlcjEzODA5NDc1","avatar_url":"https://avatars.githubusercontent.com/u/13809475?v=4","gravatar_id":"","url":"https://api.github.com/users/SkanerSoft","html_url":"https://github.com/SkanerSoft","followers_url":"https://api.github.com/users/SkanerSoft/followers","following_url":"https://api.github.com/users/SkanerSoft/following{/other_user}","gists_url":"https://api.github.com/users/SkanerSoft/gists{/gist_id}","starred_url":"https://api.github.com/users/SkanerSoft/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/SkanerSoft/subscriptions","organizations_url":"https://api.github.com/users/SkanerSoft/orgs","repos_url":"https://api.github.com/users/SkanerSoft/repos","events_url":"https://api.github.com/users/SkanerSoft/events{/privacy}","received_events_url":"https://api.github.com/users/SkanerSoft/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-01-16T17:12:59Z","updated_at":"2025-01-16T17:12:59Z","body":"Perhaps the following information will be useful.\n\nDemo_3 works with the same baking error in Dev versions [7,6,5,4].\n\nGodot 4.4 Dev 3 did not start on my computer. I can't check there. \n\nThe problem is also reproduced in Godot 4.3 Stable. I just didn't check below.\n\nThe problem seems to have deeper roots.\n\nIf someone can check it, please check it.\n\n![Image](https://github.com/user-attachments/assets/8a6d767d-8d6d-44bd-96eb-50e940b56de6)","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2596277303/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2596403966","html_url":"https://github.com/godotengine/godot/issues/101589#issuecomment-2596403966","issue_url":"https://api.github.com/repos/godotengine/godot/issues/101589","id":2596403966,"node_id":"IC_kwDOAO6SJc6awfr-","user":{"login":"SpockBauru","id":67930504,"node_id":"MDQ6VXNlcjY3OTMwNTA0","avatar_url":"https://avatars.githubusercontent.com/u/67930504?v=4","gravatar_id":"","url":"https://api.github.com/users/SpockBauru","html_url":"https://github.com/SpockBauru","followers_url":"https://api.github.com/users/SpockBauru/followers","following_url":"https://api.github.com/users/SpockBauru/following{/other_user}","gists_url":"https://api.github.com/users/SpockBauru/gists{/gist_id}","starred_url":"https://api.github.com/users/SpockBauru/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/SpockBauru/subscriptions","organizations_url":"https://api.github.com/users/SpockBauru/orgs","repos_url":"https://api.github.com/users/SpockBauru/repos","events_url":"https://api.github.com/users/SpockBauru/events{/privacy}","received_events_url":"https://api.github.com/users/SpockBauru/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-01-16T18:19:10Z","updated_at":"2025-01-16T18:19:10Z","body":"Indeed, a smaller demo and try to find what could be the issue (emissive light) helps a lot. That's why we always need the Minimal Reproduction Project (MRP) to focus on the **Minimal** part, otherwise can lead us to focus on the wrong issue.\n\nIt looks like you've found an unreported bug related to the **Compatibility Renderer**. If I bake the [demo_3.zip](https://github.com/user-attachments/files/18430039/demolightmap.zip) on both Forward+ and Mobile renderers, everything looks right, but on Compatibility the lightmaps get corrupted.\n\nIt's weird why this issue does not happens on the original demo in the Shadowmask PR. Maybe there is more than one issue. That's why demos brought directly from our projects are bad for finding issues: They are just too complex.\n\nA better title for this issue would be something like **[LightmapGI] Baking on the Compatibility renderer with emissive materials generate corrupted lightmaps**.\n\nFor your current project, the workaround while this issue is not addressed would be to change to the Mobile renderer before baking, and go back to Compatibility when done.\n\n","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2596403966/reactions","total_count":3,"+1":2,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":1},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2596595604","html_url":"https://github.com/godotengine/godot/issues/101589#issuecomment-2596595604","issue_url":"https://api.github.com/repos/godotengine/godot/issues/101589","id":259659