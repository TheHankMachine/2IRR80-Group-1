f":"https://api.github.com/repos/godotengine/godot/pulls/comments/1854909373"},"html":{"href":"https://github.com/godotengine/godot/pull/99565#discussion_r1854909373"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/99565"}},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/1854909373/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":null,"original_line":null,"side":"RIGHT","author_association":"MEMBER","original_position":37,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/1854944147","pull_request_review_id":2456079611,"id":1854944147,"node_id":"PRRC_kwDOAO6SJc5ukDOT","diff_hunk":"@@ -1125,6 +1134,14 @@ uniform vec3 uv2_offset;\n \tcode += R\"(\n void vertex() {)\";\n \n+\tif (layers_cull_mode == LAYERS_CULL_VERTEX) {\n+\t\tcode += R\"(\n+\tif ((CAMERA_VISIBLE_LAYERS & layers) == 0u) { // Begin vertex cull mode\n+\t\tVERTEX = vec3(1.0 / 0.0);","path":"scene/resources/material.cpp","commit_id":"47ab113f219a899678df0ff7d2f743a795557bb9","original_commit_id":"884ed360a75906c2a38d86d972d1bb8d5a8a50f1","user":{"login":"ramblingstranger","id":114190975,"node_id":"U_kgDOBs5qfw","avatar_url":"https://avatars.githubusercontent.com/u/114190975?v=4","gravatar_id":"","url":"https://api.github.com/users/ramblingstranger","html_url":"https://github.com/ramblingstranger","followers_url":"https://api.github.com/users/ramblingstranger/followers","following_url":"https://api.github.com/users/ramblingstranger/following{/other_user}","gists_url":"https://api.github.com/users/ramblingstranger/gists{/gist_id}","starred_url":"https://api.github.com/users/ramblingstranger/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/ramblingstranger/subscriptions","organizations_url":"https://api.github.com/users/ramblingstranger/orgs","repos_url":"https://api.github.com/users/ramblingstranger/repos","events_url":"https://api.github.com/users/ramblingstranger/events{/privacy}","received_events_url":"https://api.github.com/users/ramblingstranger/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"Do you know if there is a best way to do this? I've seen several suggestions online, but i don't have the experience to know which might work the best:\r\n* Set all the vertices to NaN/Inf\r\n* Set all vertices outside of the view frustum\r\n* Set all the vertices to the same value so that the primitive collapses to a point\r\n\r\nI did make a note in the class documentation about the vertex method potentially not working on all systems. Don't know if that would be enough to allow this through:\r\n![image](https://github.com/user-attachments/assets/26cec324-1149-4eae-92cf-84075c8289d9)\r\n","created_at":"2024-11-23T00:40:02Z","updated_at":"2024-11-23T00:40:03Z","html_url":"https://github.com/godotengine/godot/pull/99565#discussion_r1854944147","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/99565","_links":{"self":{"href":"https://api.github.com/repos/godotengine/godot/pulls/comments/1854944147"},"html":{"href":"https://github.com/godotengine/godot/pull/99565#discussion_r1854944147"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/99565"}},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/1854944147/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":null,"original_line":null,"side":"RIGHT","in_reply_to_id":1854909373,"author_association":"NONE","original_position":37,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/1854962544","pull_request_review_id":2456106432,"id":1854962544,"node_id":"PRRC_kwDOAO6SJc5ukHtw","diff_hunk":"@@ -1125,6 +1134,14 @@ uniform vec3 uv2_offset;\n \tcode += R\"(\n void vertex() {)\";\n \n+\tif (layers_cull_mode == LAYERS_CULL_VERTEX) {\n+\t\tcode += R\"(\n+\tif ((CAMERA_VISIBLE_LAYERS & layers) == 0u) { // Begin vertex cull mode\n+\t\tVERTEX = vec3(1.0 / 0.0);","path":"scene/resources/material.cpp","commit_id":"47ab113f219a899678df0ff7d2f743a795557bb9","original_commit_id":"884ed360a75906c2a38d86d972d1bb8d5a8a50f1","user":{"login":"clayjohn","id":16521339,"node_id":"MDQ6VXNlcjE2NTIxMzM5","avatar_url":"https://avatars.githubusercontent.com/u/16521339?v=4","gravatar_id":"","url":"https://api.github.com/users/clayjohn","html_url":"https://github.com/clayjohn","followers_url":"https://api.github.com/users/clayjohn/followers","following_url":"https://api.github.com/users/clayjohn/following{/other_user}","gists_url":"https://api.github.com/users/clayjohn/gists{/gist_id}","starred_url":"https://api.github.com/users/clayjohn/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/clayjohn/subscriptions","organizations_url":"https://api.github.com/users/clayjohn/orgs","repos_url":"https://api.github.com/users/clayjohn/repos","events_url":"https://api.github.com/users/clayjohn/events{/privacy}","received_events_url":"https://api.github.com/users/clayjohn/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"I've had the best luck setting the vertex outside the view frustum. To do that here you would need to use the `POSITION` built in instead of `VERTEX` because `VERTEX` is the view space position. \r\n\r\nOverall though I'm not certain the shader is the best place for this check. With this approach the draw call still happens even if it's filtered out. \r\n\r\nYou could pass the later into the rendering server and then filter the material when the instance buffer is being set up. That way you can skip the draw call entirely (and all the associated setup cost)","created_at":"2024-11-23T01:14:00Z","updated_at":"2024-11-23T01:14:00Z","html_url":"https://github.com/godotengine/godot/pull/99565#discussion_r1854962544","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/99565","_links":{"self":{"href":"https://api.github.com/repos/godotengine/godot/pulls/comments/1854962544"},"html":{"href":"https://github.com/godotengine/godot/pull/99565#discussion_r1854962544"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/99565"}},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/1854962544/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":null,"original_line":null,"side":"RIGHT","in_reply_to_id":1854909373,"author_association":"MEMBER","original_position":37,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/1855054734","pull_request_review_id":2456240595,"id":1855054734,"node_id":"PRRC_kwDOAO6SJc5ukeOO","diff_hunk":"@@ -1125,6 +1134,14 @@ uniform vec3 uv2_offset;\n \tcode += R\"(\n void vertex() {)\";\n \n+\tif (layers_cull_mode == LAYERS_CULL_VERTEX) {\n+\t\tcode += R\"(\n+\tif ((CAMERA_VISIBLE_LAYERS & layers) == 0u) { // Begin vertex cull mode\n+\t\tVERTEX = vec3(1.0 / 0.0);","path":"scene/resources/material.cpp","commit_id":"47ab113f219a899678df0ff7d2f743a795557bb9","original_commit_id":"884ed360a75906c2a38d86d972d1bb8d5a8a50f1","user":{"login":"ramblingstranger","id":114190975,"node_id":"U_kgDOBs5qfw","avatar_url":"https://avatars.githubusercontent.com/u/114190975?v=4","gravatar_id":"","url":"https://api.github.com/users/ramblingstranger","html_url":"https://github.com/ramblingstranger","followers_url":"https://api.github.com/users/ramblingstranger/followers","following_url":"https://api.github.com/users/ramblingstranger/following{/other_user}","gists_url":"https://api.github.com/users/ramblingstranger/gists{/gist_id}","starred_url":"https://api.github.com/users/ramblingstranger/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/ramblingstranger/subscriptions","organizations_url":"https://api.github.com/users/ramblingstranger/orgs","repos_url":"https://api.github.com/users/ramblingstranger/repos","events_url":"https://api.github.com/users/ramblingstranger/events{/privacy}","received_events_url":"https://api.github.com/users/ramblingstranger/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"Okay, that makes sense about stopping it before the draw call. I think both lyuma and tetrapod (in the proposal) mentioned the same thing. The main reason i went about it this way is i wasn't sure how to do it the other way :sweat_smile: (I know C++ and Godot shader code, but not OpenGL or Vulcan.) I might look into it, though, and see if i can figure it out. Would you have any pointers on where i could start, such as where visual instances are culled?\r\n\r\nIf i'm able to figure it out, would it make more sense for this property to go on `Material` instead of `BaseMaterial3D`? I suppose there's probably a significant difference between 3D and 2D layers/rendering, which might make things more complicated if working with just `Material`. But maybe i could copy how `next_pass`/`render_priority` work and only expose the `layers` property for 3D materials.","created_at":"2024-11-23T03:27:08Z","updated_at":"2024-11-23T03:29:46Z","html_url":"https://github.com/godotengine/godot/pull/99565#discussion_r1855054734","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/99565","_links":{"self":{"href":"https://api.github.com/repos/godotengine/godot/pulls/comments/1855054734"},"html":{"href":"https://github.com/godotengine/godot/pull/99565#discussion_r1855054734"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/99565"}},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/1855054734/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":null,"original_line":null,"side":"RIGHT","in_reply_to_id":1854909373,"author_association":"NONE","original_position":37,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/1855221808","pull_request_review_id":2456431145,"id":1855221808,"node_id":"PRRC_kwDOAO6SJc5ulHAw","diff_hunk":"@@ -1125,6 +1134,14 @@ uniform vec3 uv2_offset;\n \tcode += R\"(\n void vertex() {)\";\n \n+\tif (layers_cull_mode == LAYERS_CULL_VERTEX) {\n+\t\tcode += R\"(\n+\tif ((CAMERA_VISIBLE_LAYERS & layers) == 0u) { // Begin vertex cull mode\n+\t\tVERTEX = vec3(1.0 / 0.0);","path":"scene/resources/material.cpp","commit_id":"47ab113f219a899678df0ff7d2f743a795557bb9","original_commit_id":"884ed360a75906c2a38d86d972d1bb8d5a8a50f1","user":{"login":"Calinou","id":180032,"node_id":"MDQ6VXNlcjE4MDAzMg==","avatar_url":"https://avatars.githubusercontent.com/u/180032?v=4","gravatar_id":"","url":"https://api.github.com/users/Calinou","html_url":"https://github.com/Calinou","followers_url":"https://api.github.com/users/Calinou/followers","following_url":"https://api.github.com/users/Calinou/following{/other_user}","gists_url":"https://api.github.com/users/Calinou/gists{/gist_id}","starred_url":"https://api.github.com/users/Calinou/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Calinou/subscriptions","organizations_url":"https://api.github.com/users/Calinou/orgs","repos_url":"https://api.github.com/users/Calinou/repos","events_url":"https://api.github.com/users/Calinou/events{/privacy}","received_events_url":"https://api.github.com/users/Calinou/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"I used `VERTEX = vec3(-INF);` to hide particles on contact back when I implemented particle collision (the current implementation sets `ACTIVE = false` instead, a particles-only built-in).","created_at":"2024-11-23T16:27:23Z","updated_at":"2024-11-23T16:27:23Z","html_url":"https://github.com/godotengine/godot/pull/99565#discussion_r1855221808","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/99565","_links":{"self":{"href":"https://api.github.com/repos/godotengine/godot/pulls/comments/1855221808"},"html":{"href":"https://github.com/godotengine/godot/pull/99565#discussion_r1855221808"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/99565"}},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/1855221808/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":null,"original_line":null,"side":"RIGHT","in_reply_to_id":1854909373,"author_association":"MEMBER","original_position":37,"position":1,"subject_type":"line"}]