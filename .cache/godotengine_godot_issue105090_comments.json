[{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2781515918","html_url":"https://github.com/godotengine/godot/pull/105090#issuecomment-2781515918","issue_url":"https://api.github.com/repos/godotengine/godot/issues/105090","id":2781515918,"node_id":"IC_kwDOAO6SJc6lypCO","user":{"login":"smix8","id":52464204,"node_id":"MDQ6VXNlcjUyNDY0MjA0","avatar_url":"https://avatars.githubusercontent.com/u/52464204?v=4","gravatar_id":"","url":"https://api.github.com/users/smix8","html_url":"https://github.com/smix8","followers_url":"https://api.github.com/users/smix8/followers","following_url":"https://api.github.com/users/smix8/following{/other_user}","gists_url":"https://api.github.com/users/smix8/gists{/gist_id}","starred_url":"https://api.github.com/users/smix8/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/smix8/subscriptions","organizations_url":"https://api.github.com/users/smix8/orgs","repos_url":"https://api.github.com/users/smix8/repos","events_url":"https://api.github.com/users/smix8/events{/privacy}","received_events_url":"https://api.github.com/users/smix8/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-04-06T17:09:19Z","updated_at":"2025-04-06T17:09:19Z","body":"So considering this was a loop to update all the dirty debug physics quadrants, potentially hundreds of them, I decided to switch the debug logic a little.\r\n\r\nI moved the entire arrays used in the buildup for the debug geometry to `LocalVectors` and `AHashMap` outside the loop. We can clear those at the start of each new quadrant starting fresh while keeping all the memory allocated from the previous quadrant build speeding things up. The push_back() on an already allocated LocalVector is dirty cheap compared to packed Vector.\r\n\r\nOnly at the very end we convert to the needed packed Vector arrays for the mesh surface arrays which would create a CoW copy anyway. This removes the need for some convoluted index and resize logic for some marginal performance gains with packed vector. Imo the better solution to combine both codestyle and performance.","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2781515918/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2783404771","html_url":"https://github.com/godotengine/godot/pull/105090#issuecomment-2783404771","issue_url":"https://api.github.com/repos/godotengine/godot/issues/105090","id":2783404771,"node_id":"IC_kwDOAO6SJc6l52Lj","user":{"login":"Repiteo","id":17489292,"node_id":"MDQ6VXNlcjE3NDg5Mjky","avatar_url":"https://avatars.githubusercontent.com/u/17489292?v=4","gravatar_id":"","url":"https://api.github.com/users/Repiteo","html_url":"https://github.com/Repiteo","followers_url":"https://api.github.com/users/Repiteo/followers","following_url":"https://api.github.com/users/Repiteo/following{/other_user}","gists_url":"https://api.github.com/users/Repiteo/gists{/gist_id}","starred_url":"https://api.github.com/users/Repiteo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Repiteo/subscriptions","organizations_url":"https://api.github.com/users/Repiteo/orgs","repos_url":"https://api.github.com/users/Repiteo/repos","events_url":"https://api.github.com/users/Repiteo/events{/privacy}","received_events_url":"https://api.github.com/users/Repiteo/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-04-07T13:47:09Z","updated_at":"2025-04-07T13:47:09Z","body":"Thanks!","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2783404771/reactions","total_count":1,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":1,"eyes":0},"performed_via_github_app"