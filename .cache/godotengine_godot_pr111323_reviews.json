[{"id":3317956837,"node_id":"PRR_kwDOAO6SJc7FxADl","user":{"login":"Ivorforce","id":2308167,"node_id":"MDQ6VXNlcjIzMDgxNjc=","avatar_url":"https://avatars.githubusercontent.com/u/2308167?u=f7f8e0273f784f5ec6f6b7fe4a88d449896eb48a&v=4","gravatar_id":"","url":"https://api.github.com/users/Ivorforce","html_url":"https://github.com/Ivorforce","followers_url":"https://api.github.com/users/Ivorforce/followers","following_url":"https://api.github.com/users/Ivorforce/following{/other_user}","gists_url":"https://api.github.com/users/Ivorforce/gists{/gist_id}","starred_url":"https://api.github.com/users/Ivorforce/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Ivorforce/subscriptions","organizations_url":"https://api.github.com/users/Ivorforce/orgs","repos_url":"https://api.github.com/users/Ivorforce/repos","events_url":"https://api.github.com/users/Ivorforce/events{/privacy}","received_events_url":"https://api.github.com/users/Ivorforce/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"Thanks! This makes sense to me. There's no need for script to be stored twice, especially since the `Variant` based storage can be less efficient and more error prone than the reference based one.\r\nWould be nice to get another voice from one more GDScript / C# maintainer, but I also don't see huge risks in this. The property has existed since the first commit. It's likely simply no longer needed.","state":"APPROVED","html_url":"https://github.com/godotengine/godot/pull/111323#pullrequestreview-3317956837","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/111323","author_association":"MEMBER","_links":{"html":{"href":"https://github.com/godotengine/godot/pull/111323#pullrequestreview-3317956837"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/111323"}},"submitted_at":"2025-10-09T09:10:10Z","commit_id":"2adecffbc3faadfaf0855899aee7095c23b5fb69"},{"id":3319352368,"node_id":"PRR_kwDOAO6SJc7F2Uww","user":{"login":"dsnopek","id":191561,"node_id":"MDQ6VXNlcjE5MTU2MQ==","avatar_url":"https://avatars.githubusercontent.com/u/191561?v=4","gravatar_id":"","url":"https://api.github.com/users/dsnopek","html_url":"https://github.com/dsnopek","followers_url":"https://api.github.com/users/dsnopek/followers","following_url":"https://api.github.com/users/dsnopek/following{/other_user}","gists_url":"https://api.github.com/users/dsnopek/gists{/gist_id}","starred_url":"https://api.github.com/users/dsnopek/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/dsnopek/subscriptions","organizations_url":"https://api.github.com/users/dsnopek/orgs","repos_url":"https://api.github.com/users/dsnopek/repos","events_url":"https://api.github.com/users/dsnopek/events{/privacy}","received_events_url":"https://api.github.com/users/dsnopek/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"Thanks!\r\n\r\nThis looks good to me. I'm glad this is also removing `set_script_and_instance()` - when working on PR https://github.com/godotengine/godot/pull/102373 it was also [noted](https://github.com/godotengine/godot/pull/102373#discussion_r1941864293) that this method isn't really needed.\r\n\r\nThere is one potential risk here: if there are any GDExtensions providing scripting languages that depend on the `Ref<Script>` getting cached on the Godot side, and won't expect `get_script()` to get called so often. However, I think at worst this would be a performance issue, and not one that breaks compatibility? So, I think it should be fine","state":"APPROVED","html_url":"https://github.com/godotengine/godot/pull/111323#pullrequestreview-3319352368","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/111323","author_association":"CONTRIBUTOR","_links":{"html":{"href":"https://github.com/godotengine/godot/pull/111323#pullrequestreview-3319352368"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/111323"}},"submitted_at":"2025-10-09T14:42:11Z","commit_id":"2adecffbc3faadfaf0855899aee7095c23b5fb69"},{"id":3320346943,"node_id":"PRR_kwDOAO6SJc7F6Hk_","user":{"login":"dalexeev","id":47700418,"node_id":"MDQ6VXNlcjQ3NzAwNDE4","avatar_url":"https://avatars.githubusercontent.com/u/47700418?u=0565b5d99d54afd5fda6712cd8eb05893572baed&v=4","gravatar_id":"","url":"https://api.github.com/users/dalexeev","html_url":"https://github.com/dalexeev","followers_url":"https://api.github.com/users/dalexeev/followers","following_url":"https://api.github.com/users/dalexeev/following{/other_user}","gists_url":"https://api.github.com/users/dalexeev/gists{/gist_id}","starred_url":"https://api.github.com/users/dalexeev/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/dalexeev/subscriptions","organizations_url":"https://api.github.com/users/dalexeev/orgs","repos_url":"https://api.github.com/users/dalexeev/repos","events_url":"https://api.github.com/users/dalexeev/events{/privacy}","received_events_url":"https://api.github.com/users/dalexeev/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"Looks good to me too, great catch! Even if we encounter some regression, we can always fix it or revert the change.","state":"APPROVED","html_url":"https://github.com/godotengine/godot/pull/111323#pullrequestreview-3320346943","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/111323","author_association":"CONTRIBUTOR","_links":{"html":{"href":"https://github.com/godotengine/godot/pull/111323#pullrequestreview-3320346943"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/111323"}},"submitted_at":"2025-10-09T19:23:34Z","commit_id":"2adecffbc3faadfaf0855899aee7095c23b5fb69"},{"id":3320599069,"node_id":"PRR_kwDOAO6SJc7F7FId","user":{"login":"raulsntos","id":3903059,"node_id":"MDQ6VXNlcjM5MDMwNTk=","avatar_url":"https://avatars.githubusercontent.com/u/3903059?u=1b0467024f137e562b21748eb6b