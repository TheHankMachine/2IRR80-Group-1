v=4","gravatar_id":"","url":"https://api.github.com/users/Calinou","html_url":"https://github.com/Calinou","followers_url":"https://api.github.com/users/Calinou/followers","following_url":"https://api.github.com/users/Calinou/following{/other_user}","gists_url":"https://api.github.com/users/Calinou/gists{/gist_id}","starred_url":"https://api.github.com/users/Calinou/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Calinou/subscriptions","organizations_url":"https://api.github.com/users/Calinou/orgs","repos_url":"https://api.github.com/users/Calinou/repos","events_url":"https://api.github.com/users/Calinou/events{/privacy}","received_events_url":"https://api.github.com/users/Calinou/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-01-27T15:22:24Z","updated_at":"2025-01-27T15:22:40Z","body":"With the 4.4 project from https://github.com/godotengine/godot/issues/98731#issuecomment-2614013416, I can't reproduce this on either Firefox or Chromium on Windows 11 24H2 despite leaving the demo running for 5 minutes each (not at the same time). This is likely bound to CPU speed since I'm on a fast CPU (i9-13900K).","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2616054328/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2616419421","html_url":"https://github.com/godotengine/godot/issues/98731#issuecomment-2616419421","issue_url":"https://api.github.com/repos/godotengine/godot/issues/98731","id":2616419421,"node_id":"IC_kwDOAO6SJc6b82Rd","user":{"login":"adamscott","id":270928,"node_id":"MDQ6VXNlcjI3MDkyOA==","avatar_url":"https://avatars.githubusercontent.com/u/270928?v=4","gravatar_id":"","url":"https://api.github.com/users/adamscott","html_url":"https://github.com/adamscott","followers_url":"https://api.github.com/users/adamscott/followers","following_url":"https://api.github.com/users/adamscott/following{/other_user}","gists_url":"https://api.github.com/users/adamscott/gists{/gist_id}","starred_url":"https://api.github.com/users/adamscott/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/adamscott/subscriptions","organizations_url":"https://api.github.com/users/adamscott/orgs","repos_url":"https://api.github.com/users/adamscott/repos","events_url":"https://api.github.com/users/adamscott/events{/privacy}","received_events_url":"https://api.github.com/users/adamscott/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-01-27T17:19:14Z","updated_at":"2025-01-27T17:19:14Z","body":"Can somebody try my PR on their machine? It's not perfect, but should be at least less taxing.\nhttps://github.com/adamscott/godot/tree/fix-glitched-audio-web","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2616419421/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2617138028","html_url":"https://github.com/godotengine/godot/issues/98731#issuecomment-2617138028","issue_url":"https://api.github.com/repos/godotengine/godot/issues/98731","id":2617138028,"node_id":"IC_kwDOAO6SJc6b_lts","user":{"login":"rburing","id":229837,"node_id":"MDQ6VXNlcjIyOTgzNw==","avatar_url":"https://avatars.githubusercontent.com/u/229837?v=4","gravatar_id":"","url":"https://api.github.com/users/rburing","html_url":"https://github.com/rburing","followers_url":"https://api.github.com/users/rburing/followers","following_url":"https://api.github.com/users/rburing/following{/other_user}","gists_url":"https://api.github.com/users/rburing/gists{/gist_id}","starred_url":"https://api.github.com/users/rburing/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/rburing/subscriptions","organizations_url":"https://api.github.com/users/rburing/orgs","repos_url":"https://api.github.com/users/rburing/repos","events_url":"https://api.github.com/users/rburing/events{/privacy}","received_events_url":"https://api.github.com/users/rburing/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-01-27T23:38:02Z","updated_at":"2025-01-27T23:48:26Z","body":"@adamscott It doesn't fix the issue, it breaks down around the same time.\n\nI added a `console.log` to the constructor of `GodotPositionReportingProcessor` and it seems to be created anew every time the audio loops. Can the object not be reused? In my game the car engine sound is a very short loop, and there are several cars, so many of these objects are created per second (and moreover they are doing work that I don't need, because I don't care about the playback position, as I imagine most people don't).\n\nIn my opinion if playback position reporting can't be done without fixing this issue, then it should be made optional and disabled by default (since using playback position is rather niche, e.g. it could be used for a music player).\n\n(I also reproduced the issue on a Windows Surface tablet.)","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2617138028/reactions","total_count":2,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":2},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2617219887","html_url":"https://github.com/godotengine/godot/issues/98731#issuecomment-2617219887","issue_url":"https://api.github.com/repos/godotengine/godot/issues/98731","id":2617219887,"node_id":"IC_kwDOAO6SJc6b_5sv","user":{"login":"ghost","id":10137,"node_id":"MDQ6VXNlcjEwMTM3","avatar_url":"https://avatars.githubusercontent.com/u/10137?v=4","gravatar_id":"","url":"https://api.github.com/users/ghost","html_url":"https://github.com/ghost","followers_url":"https://api.github.com/users/ghost/followers","following_url":"https://api.github.com/users/ghost/following{/other_user}","gists_url":"https://api.github.com/users/ghost/gists{/gist_id}","starred_url":"https://api.github.com/users/ghost/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/ghost/subscriptions","organizations_url":"https://api.github.com/users/ghost/orgs","repos_url":"https://api.github.com/users/ghost/repos","events_url":"https://api.github.com/users/ghost/events{/privacy}","received_events_url":"https://api.github.com/users/ghost/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-01-27T23:58:10Z","updated_at":"2025-01-28T00:01:09Z","body":"> * [Froge 4.3](https://rburing.itch.io/froge-4-3?secret=LEGEJVXHEuaHXoqmv2zlZ0u1SU) (exported from Godot 4.3-stable)\n> * [Froge 4.4](https://rburing.itch.io/froge-4-4?secret=ZnPD765il6PkacENN3CyUeStyU) (exported from Godot 4.4-beta1)\n> \n> Start the game and wait about 2 minutes (the exact time may depend on your device).\n> \n\nI can confirm the crackling/distortion for 4.4 as well. On Manjaro, running Linux kernel v6.12.4 and using Chromium for a browser.\n\n> For 4.4, CPU steadily climbs past 100% to hover around 125%, which means it's using multiple cores.\n\nAlso seen here. And... the distortion seems to happen at the more or less exact moment it crosses that 1 core boundary.\n\nOne thing I did notice while actually listening and this could just be an auditory hallucination but I felt that the car sounds, the engine hums, were starting to overlap/replicate. As in... what seems to be happening is some sort of improper/incomplete cleanup. Again, this could just be perception on my end.","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2617219887/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2619545673","html_url":"https://github.com/godotengine/godot/issues/98731#issuecomment-2619545673","issue_url":"https://api.github.com/repos/godotengine/godot/issues/98731","id":2619545673,"node_id":"IC_kwDOAO6SJc6cIxhJ","user":{"login":"adamscott","id":270928,"node_id":"MDQ6VXNlcjI3MDkyOA==","avatar_url":"https://avatars.githubusercontent.com/u/270928?v=4","gravatar_id":"","url":"https://api.github.com/users/adamscott","html_url":"https://github.com/adamscott","followers_url":"https://api.github.com/users/adamscott/followers","following_url":"https://api.github.com/users/adamscott/following{/other_user}","gists_url":"https://api.github.com/users/adamscott/gists{/gist_id}","starred_url":"https://api.github.com/users/adamscott/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/adamscott/subscriptions","organizations_url":"https://api.github.com/users/adamscott/orgs","repos_url":"https://api.github.com/users/adamscott/repos","events_url":"https://api.github.com/users/adamscott/events{/privacy}","received_events_url":"https://api.github.com/users/adamscott/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-01-28T16:49:48Z","updated_at":"2025-01-28T16:49:48Z","body":"I tried my best to reduce the number of initialization of audio position worklets, but to no avail. You can see the progress I did here: https://github.com/adamscott/godot/tree/fix-glitched-audio-web.\n\nI'll create a PR to revert https://github.com/godotengine/godot/pull/95197, as I don't see any solution for the moment. I think we should introduce an API to tell the engine to specifically listen to a sample position and not make this by default for every sample, as this seems to be very taxing.","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2619545673/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2619570771","html_url":"https://github.com/godotengine/godot/issues/98731#issuecomment-2619570771","issue_url":"https://api.github.com/repos/godotengine/godot/issues/98731","id":2619570771,"node_id":"IC_kwDOAO6SJc6cI3pT","user":{"login":"adamscott","id":270928,"node_id":"MDQ6VXNlcjI3MDkyOA==","avatar_url":"https://avatars.githubusercontent.com/u/270928?v=4","gravatar_id":"","url":"https://api.github.com/users/adamscott","html_url":"https://github.com/adamscott","followers_url":"https://api.github.com/users/adamscott/followers","following_url":"https://api.github.com/users/adamscott/following{/other_user}","gists_url":"https://api.github.com/users/adamscott/gists{/gist_id}","starred_url":"https://api.github.com/users/adamscott/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/adamscott/subscriptions","organizations_url":"https://api.github.com/users/adamscott/orgs","repos_url":"https://api.github.com/users/adamscott/repos","events_url":"https://api.github.com/users/adamscott/events{/privacy}","received_events_url":"https://api.github.com/users/adamscott/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-01-28T17:00:09Z","updated_at":"2025-01-28T17:00:09Z","body":"Well, could somebody test [my branch](https://github.com/adamscott/godot/tree/fix-glitched-audio-web) again? I reverted locally #95197 and I have still issues on my phone. So I don't know if my branch helps or not.","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2619570771/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2622622727","html_url":"https://github.com/godotengine/godot/issues/98731#issuecomment-2622622727","issue_url":"https://api.github.com/repos/godotengine/godot/issues/98731","id":2622622727,"node_id":"IC_kwDOAO6SJc6cUgwH","user":{"login":"rburing","id":229837,"node_id":"MDQ6VXNlcjIyOTgzNw==","avatar_url":"https://avatars.githubusercontent.com/u/229837?v=4","gravatar_id":"","url":"https://api.github.com/users/rburing","html_url":"https://github.com/rburing","followers_url":"https://api.github.com/users/rburing/followers","following_url":"https://api.github.com/users/rburing/following{/other_user}","gists_url":"https://api.github.com/users/rburing/gists{/gist_id}","starred_url":"https://api.github.com/users/rburing/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/rburing/subscriptions","organizations_url":"https://api.github.com/users/rburing/orgs","repos_url":"https://api.github.com/users/rburing/repos","events_url":"https://api.github.com/users/rburing/events{/privacy}","received_events_url":"https://api.github.com/users/rburing/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-01-29T19:17:40Z","updated_at":"2025-01-29T19:24:11Z","body":"@adamscott Your latest branch improves the situation! It still crackles occasionally (which was already the case in 4.3), but the distortion spiral of death (stuttering and slowing down) seems to be gone in my testing.\n\nI think the correct solution would still be to also make the position reporting opt-in (to save precious cycles on Web exports), but this could be done later.\n\n*Edit*: Here is the web export for testing: [Froge 4.4-dev](https://rburing.itch.io/froge-4-4-dev?secret=mhGwQWs12zN5EModf0qYrFYFL8).","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2622622727/reactions","total_count":2,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":2,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2622817620","html_url":"https://github.com/godotengine/godot/issues/98731#issuecomment-2622817620","issue_url":"https://api.github.com/repos/godotengine/godot/issues/98731","id":2622817620,"node_id":"IC_kwDOAO6SJc6cVQVU","user":{"login":"ghost","id":10137,"node_id":"MDQ6VXNlcjEwMTM3","avatar_url":"https://avatars.githubusercontent.com/u/10137?v=4","gravatar_id":"","url":"https://api.github.com/users/ghost","html_url":"https://github.com/ghost","followers_url":"https://api.github.com/users/ghost/followers","following_url":"https://api.github.com/users/ghost/following{/other_user}","gists_url":"https://api.github.com/users/ghost/gists{/gist_id}","starred_url":"https://api.github.com/users/ghost/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/ghost/subscriptions","organizations_url":"https://api.github.com/users/ghost/orgs","repos_url":"https://api.github.com/users/ghost/repos","events_url":"https://api.github.com/users/ghost/events{/privacy}","received_events_url":"https://api.github.com/users/ghost/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-01-29T20:49:42Z","updated_at":"2025-01-29T20:49:42Z","body":"> _Edit_: Here is the web export for testing: [Froge 4.4-dev](https://rburing.itch.io/froge-4-4-dev?secret=mhGwQWs12zN5EModf0qYrFYFL8).\n\nThanks for that. After running it on my box (Manjaro; Linux 6.12.4; Chromium), I can confirm it also seems to be gone here. And from keeping an eye on CPU use, the inflating CPU use which was observed by myself and others as well also seems to be gone. It is hovering at fairly stable CPU use now without growing indefinitely.\n\nSeveral minutes of listening to the engines humming and the music playing, I heard no crackling, no repetition, no audio ghosting, no glitching.","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2622817620/reactions","total_count":2,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":2,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2623302891","html_url":"https://github.com/godotengine/godot/issues/98731#issuecomment-2623302891","issue_url":"https://api.github.com/repos/godotengine/godot/issues/98731","id":2623302891,"node_id":"IC_kwDOAO6SJc6cXGzr","user":{"login":"belzecue","id":1931303,"node_id":"MDQ6VXNlcjE5MzEzMDM=","avatar_url":"https://avatars.githubusercontent.com/u/1931303?v=4","gravatar_id":"","url":"https://api.github.com/users/belzecue","html_url":"https://github.com/belzecue","followers_url":"https://api.github.com/users/belzecue/followers","following_url":"https://api.github.com/users/belzecue/following{/other_user}","gists_url":"https://api.github.com/users/belzecue/gists{/gist_id}","starred_url":"https://api.github.com/users/belzecue/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/belzecue/subscriptions","organizations_url":"https://api.github.com/users/belzecue/orgs","repos_url":"https://api.github.com/users/belzecue/repos","events_url":"https://api.github.com/users/belzecue/events{/privacy}","received_events_url":"https://api.github.com/users/belzecue/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-01-30T01:13:56Z","updated_at":"2025-01-30T01:13:56Z","body":"> Edit: Here is the web export for testing: [Froge 4.4-dev](https://rburing.itch.io/froge-4-4-dev?secret=mhGwQWs12zN5EModf0qYrFYFL8).\n\nConfirmed big improvement on rburing's 4.4-dev.  (On Windows box this time.  Reran all three: 4.3 ok, 4.4 bad, 4.4-dev ok.)\n\nThe significant increase in CPU use between 4.3 and 4.4 worries me.  On this Windows box it was around 45% on 4.3 but is now around 70% sustained on rburing's 4.4-dev (build not optimised?).\n\n![Image](https://github.com/user-attachments/assets/5523d5af-b758-4e1e-a728-501e43d3be40)","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2623302891/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2623345592","html_url":"https://github.com/godotengine/godot/issues/98731#issuecomment-2623345592","issue_url":"https://api.github.com/repos/godotengine/godot/issues/98731","id":2623345592,"node_id":"IC_kwDOAO6SJc6cXRO4","user":{"login":"ghost","id":10137,"node_id":"MDQ6VXNlcjEwMTM3","avatar_url":"https://avatars.githubusercontent.com/u/10137?v=4","gravatar_id":"","url":"https://api.github.com/users/ghost","html_url":"https://github.com/ghost","followers_url":"https://api.github.com/users/ghost/followers","following_url":"https://api.github.com/users/ghost/following{/other_user}","gists_url":"https://api.github.com/users/ghost/gists{/gist_id}","starred_url":"https://api.github.com/users/ghost/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/ghost/subscriptions","organizations_url":"https://api.github.com/users/ghost/orgs","repos_url":"https://api.github.com/users/ghost/repos","events_url":"https://api.github.com/users/ghost/events{/privacy}","received_events_url":"https://api.github.com/users/ghost/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-01-30T01:55:10Z","updated_at":"2025-01-30T01:55:10Z","body":"> (build not optimised?).\n\nProbably. I saw similar CPU use. But, interestingly enough, only with that tab focused. If I switched to a different tab with the game just running in the background, the CPU use dropped sharply. Although with both the tab focused and unfocused, this artifact does seem to have _stable_ CPU use at least.\n\nSo, yeah, probably just an un-optimized build.","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2623345592/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2623392724","html_url":"https://github.com/godotengine/godot/issues/98731#issuecomment-2623392724","issue_url":"https://api.github.com/repos/godotengine/godot/issues/98731","id":2623392724,"node_id":"IC_kwDOAO6SJc6cXcvU","user":{"login":"adamscott","id":270928,"node_id":"MDQ6VXNlcjI3MDkyOA==","avatar_url":"https://avatars.githubusercontent.com/u/270928?v=4","gravatar_id":"","url":"https://api.github.com/users/adamscott","html_url":"https://github.com/adamscott","followers_url":"https://api.github.com/users/adamscott/followers","following_url":"https://api.github.com/users/adamscott/following{/other_user}","gists_url":"https://api.github.com/users/adamscott/gists{/gist_id}","starred_url":"https://api.github.com/users/adamscott/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/adamscott/subscriptions","organizations_url":"https://api.github.com/users/adamscott/orgs","repos_url":"https://api.github.com/users/adamscott/repos","events_url":"https://api.github.com/users/adamscott/events{/privacy}","received_events_url":"https://api.github.com/users/adamscott/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-01-30T02:40:45Z","updated_at":"2025-01-30T02:43:46Z","body":"> So, yeah, probably just an un-optimized build.\n\nThere's no such thing as an un-optimized build.\n\nI think it's the position reporting that uses more processing power. I would love to make this optional, but I can't figure out yet how to expose this properly. I'm thinking about exposing the functionality through metadata for this release, but it seems like a gross hack.","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2623392724/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2641432500","html_url":"https://github.com/godotengine/godot/issues/98731#issuecomment-2641432500","issue_url":"https://api.github.com/repos/godotengine/godot/issues/98731","id":2641432500,"node_id":"IC_kwDOAO6SJc6dcQ-0","user":{"login":"mooflu","id":693717,"node_id":"MDQ6VXNlcjY5MzcxNw==","avatar_url":"https://avatars.githubusercontent.com/u/693717?v=4","gravatar_id":"","url":"https://api.github.com/users/mooflu","html_url":"https://github.com/mooflu","followers_url":"https://api.github.com/users/mooflu/followers","following_url":"https://api.github.com/users/mooflu/following{/other_user}","gists_url":"https://api.github.com/users/mooflu/gists{/gist_id}","starred_url":"https://api.github.com/users/mooflu/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/mooflu/subscriptions","organizations_url":"https://api.github.com/users/mooflu/orgs","repos_url":"https://api.github.com/users/mooflu/repos","events_url":"https://api.github.com/users/mooflu/events{/privacy}","received_events_url":"https://api.github.com/users/mooflu/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-02-07T00:06:58Z","updated_at":"2025-02-07T00:06:58Z","body":"I think this landed after beta2. Wondering if this would fix the issue I just logged: https://github.com/godotengine/godot/issues/102505\n","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2641432500/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null}]