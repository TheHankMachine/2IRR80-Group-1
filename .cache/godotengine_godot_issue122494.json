eo/gists{/gist_id}","starred_url":"https://api.github.com/users/Repiteo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Repiteo/subscriptions","organizations_url":"https://api.github.com/users/Repiteo/orgs","repos_url":"https://api.github.com/users/Repiteo/repos","events_url":"https://api.github.com/users/Repiteo/events{/privacy}","received_events_url":"https://api.github.com/users/Repiteo/received_events","type":"User","user_view_type":"public","site_admin":false},"open_issues":343,"closed_issues":2335,"state":"open","created_at":"2026-04-13T15:59:35Z","updated_at":"2026-10-22T06:28:22Z","due_on":null,"closed_at":null},"comments":3,"created_at":"2026-08-17T09:53:31Z","updated_at":"2026-10-16T16:38:32Z","closed_at":"2026-10-16T16:38:12Z","assignee":{"login":"Geometror","id":50084500,"node_id":"MDQ6VXNlcjUwMDg0NTAw","avatar_url":"https://avatars.githubusercontent.com/u/50084500?v=4","gravatar_id":"","url":"https://api.github.com/users/Geometror","html_url":"https://github.com/Geometror","followers_url":"https://api.github.com/users/Geometror/followers","following_url":"https://api.github.com/users/Geometror/following{/other_user}","gists_url":"https://api.github.com/users/Geometror/gists{/gist_id}","starred_url":"https://api.github.com/users/Geometror/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Geometror/subscriptions","organizations_url":"https://api.github.com/users/Geometror/orgs","repos_url":"https://api.github.com/users/Geometror/repos","events_url":"https://api.github.com/users/Geometror/events{/privacy}","received_events_url":"https://api.github.com/users/Geometror/received_events","type":"User","user_view_type":"public","site_admin":false},"author_association":"CONTRIBUTOR","issue_field_values":[],"type":null,"active_lock_reason":null,"draft":false,"pull_request":{"url":"https://api.github.com/repos/godotengine/godot/pulls/122494","html_url":"https://github.com/godotengine/godot/pull/122494","diff_url":"https://github.com/godotengine/godot/pull/122494.diff","patch_url":"https://github.com/godotengine/godot/pull/122494.patch","merged_at":"2026-10-16T16:38:11Z"},"body":"The insertion of lightmap caches into the unwrap_cache was silently dropping entries in some cases.\r\nFixes issue #117752 about uv2 differing across OSes.\r\n\r\n## What problem(s) does this PR solve?\r\n\r\n- Closes #117752\r\n\r\n## Additional information\r\n\r\nAs fas as I could understand, we are not cross-platform deterministic with generated lightmap UVs. This is why we have unwrap_cache.\r\n\r\nWhile troubleshooting the issue (#117752), I noticed the we are silently dropping entries when inserting lightmap caches for individual meshes into an unwrap_cache. I assume the code meant to do a standard insertion sort, but forgets to add entries that sort higher than all existing entries.\r\nSo we silently drop them.\r\n\r\nI've done some tests, and we do indeed drop entries from the unwrap_cache, and so I think we are forced to re-unwrap them on each machine, making it non-deterministic.\r\n\r\nThis fix is pretty basic, in that it just makes sure the entry is added if it wasn't already.","closed_by":{"login":"Repiteo","id":17489292,"node_id":"MDQ6VXNlcjE3NDg5Mjky","avatar_url":"https://avatars.githubusercontent.com/u/17489292?v=4","gravatar_id":"","url":"https://api.github.com/users/Repiteo","html_url":"https://github.com/Repiteo","followers_url":"https://api.github.com/users/Repiteo/followers","following_url":"https://api.github.com/users/Repiteo/following{/other_user}","gists_url":"https://api.github.com/users/Repiteo/gists{/gist_id}","starred_url":"https://api.github.com/users/Repiteo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Repiteo/subscriptions","organizations_url":"https://api.github.com/users/Repiteo/orgs","repos_url":"https://api.github.com/users/Repiteo/repos","events_url":"https://api.github.com/users/Repiteo/events{/privacy}","received_events_url":"https://api.github.com/users/Repiteo/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/122494/reactions","total_count":7,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":7,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/godotengine/godot/issues/122494/timeline","performed_via_github_app":null,"state_reason":null}