87975589/reactions","total_count":1,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":1},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4008157849","html_url":"https://github.com/godotengine/godot/issues/114044#issuecomment-4008157849","issue_url":"https://api.github.com/repos/godotengine/godot/issues/114044","id":4008157849,"node_id":"IC_kwDOAO6SJc7u56KZ","user":{"login":"whitelynx","id":285264,"node_id":"MDQ6VXNlcjI4NTI2NA==","avatar_url":"https://avatars.githubusercontent.com/u/285264?v=4","gravatar_id":"","url":"https://api.github.com/users/whitelynx","html_url":"https://github.com/whitelynx","followers_url":"https://api.github.com/users/whitelynx/followers","following_url":"https://api.github.com/users/whitelynx/following{/other_user}","gists_url":"https://api.github.com/users/whitelynx/gists{/gist_id}","starred_url":"https://api.github.com/users/whitelynx/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/whitelynx/subscriptions","organizations_url":"https://api.github.com/users/whitelynx/orgs","repos_url":"https://api.github.com/users/whitelynx/repos","events_url":"https://api.github.com/users/whitelynx/events{/privacy}","received_events_url":"https://api.github.com/users/whitelynx/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-03-05T22:14:44Z","updated_at":"2026-03-05T22:14:44Z","body":"I'm having this issue too.\n\n@gongpha wrote:\n> I found out you need to click the game/embedded window (to focus it)\n\nI can confirm that this fixes it. Maybe something to do with not being able to steal focus on Wayland? Is there a Wayland protocol that can help with that, since other games seem to be able to take mouse focus on launch?","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4008157849/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4008874344","html_url":"https://github.com/godotengine/godot/issues/114044#issuecomment-4008874344","issue_url":"https://api.github.com/repos/godotengine/godot/issues/114044","id":4008874344,"node_id":"IC_kwDOAO6SJc7u8pFo","user":{"login":"gongpha","id":13400398,"node_id":"MDQ6VXNlcjEzNDAwMzk4","avatar_url":"https://avatars.githubusercontent.com/u/13400398?v=4","gravatar_id":"","url":"https://api.github.com/users/gongpha","html_url":"https://github.com/gongpha","followers_url":"https://api.github.com/users/gongpha/followers","following_url":"https://api.github.com/users/gongpha/following{/other_user}","gists_url":"https://api.github.com/users/gongpha/gists{/gist_id}","starred_url":"https://api.github.com/users/gongpha/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/gongpha/subscriptions","organizations_url":"https://api.github.com/users/gongpha/orgs","repos_url":"https://api.github.com/users/gongpha/repos","events_url":"https://api.github.com/users/gongpha/events{/privacy}","received_events_url":"https://api.github.com/users/gongpha/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-03-06T01:21:08Z","updated_at":"2026-03-06T01:21:08Z","body":"All I know is that the Wayland thread in Godot might not know the current active window when calling `mouse_set_mode`. I've already made the workaround fix for this : https://github.com/gongpha/godot/commit/238483c112e03906939000150662f9ec2eaa6431, but haven't opened the PR yet","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4008874344/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4009126464","html_url":"https://github.com/godotengine/godot/issues/114044#issuecomment-4009126464","issue_url":"https://api.github.com/repos/godotengine/godot/issues/114044","id":4009126464,"node_id":"IC_kwDOAO6SJc7u9mpA","user":{"login":"deralmas","id":31065808,"node_id":"MDQ6VXNlcjMxMDY1ODA4","avatar_url":"https://avatars.githubusercontent.com/u/31065808?v=4","gravatar_id":"","url":"https://api.github.com/users/deralmas","html_url":"https://github.com/deralmas","followers_url":"https://api.github.com/users/deralmas/followers","following_url":"https://api.github.com/users/deralmas/following{/other_user}","gists_url":"https://api.github.com/users/deralmas/gists{/gist_id}","starred_url":"https://api.github.com/users/deralmas/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/deralmas/subscriptions","organizations_url":"https://api.github.com/users/deralmas/orgs","repos_url":"https://api.github.com/users/deralmas/repos","events_url":"https://api.github.com/users/deralmas/events{/privacy}","received_events_url":"https://api.github.com/users/deralmas/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-03-06T02:24:56Z","updated_at":"2026-03-06T02:24:56Z","body":"Hi, thank you all for your reports! I'm not entirely sure what's going on, and I'll need to take a deeper look. The embedder is one complicated beast.\n\nNote though that I've already got a lot on my plate, plus life getting in the way, so that might take a while. Please be patient.\n\n---\n\n@whitelynx\n\n> I can confirm that this fixes it. Maybe something to do with not being able to steal focus on Wayland? Is there a Wayland protocol that can help with that, since other games seem to be able to take mouse focus on launch?\n\nClick-to-focus is actually not a bug or some limitation, just my terrible design xD\n\nEmbedded Wayland games run through the \"embedder\": a special environment into which we can change pretty much any rule (see #107435 for lots of info). I had no idea how other platforms behaved so I chose something that felt right to me. I was made aware of the discrepancy pretty late in the development of the embedder and just rolled with it to avoid delaying it further.\n\nI'll eventually try to address it. Might be a tad tricky to do right though, given our unorthodox approach.\n\nAlso feel free to open a separate ticket if it there isn't one already.\n\n---\n\n@gongpha\n\n> All I know is that the Wayland thread in Godot might not know the current active window when calling mouse_set_mode.\n\nThis is actually the display server, which runs mostly in the main thread. Embedded game surfaces are \"unknown\" to the editor, just like CSDs from libdecor. Maybe it's that? Kinda weird though, as it's the game that requests pointer locking.\n\n> I've already made the workaround fix for this : https://github.com/gongpha/godot/commit/238483c112e03906939000150662f9ec2eaa6431, but haven't opened the PR yet\n\nNice :D\n\nI'd love to comment further on your patch but I'm currently heading to bed and very tired so I'm afraid I wouldn't be able to give a fair and complete assessment of your workaround right now.\n\nBTW, could you please move your report to a new issue ticket, if there isn't one already? This way it won't be lost whenever the this issue gets closed.\n\n---\n\nHTH! Feel free to ask if anything's unclear :D","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4009126464/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4010129960","html_url":"https://github.com/godotengine/godot/issues/114044#issuecomment-4010129960","issue_url":"https://api.github.com/repos/godotengine/godot/issues/114044","id":4010129960,"node_id":"IC_kwDOAO6SJc7vBboo","user":{"login":"gongpha","id":13400398,"node_id":"MDQ6VXNlcjEzNDAwMzk4","avatar_url":"https://avatars.githubusercontent.com/u/13400398?v=4","gravatar_id":"","url":"https://api.github.com/users/gongpha","html_url":"https://github.com/gongpha","followers_url":"https://api.github.com/users/gongpha/followers","following_url":"https://api.github.com/users/gongpha/following{/other_user}","gists_url":"https://api.github.com/users/gongpha/gists{/gist_id}","starred_url":"https://api.github.com/users/gongpha/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/gongpha/subscriptions","organizations_url":"https://api.github.com/users/gongpha/orgs","repos_url":"https://api.github.com/users/gongpha/repos","events_url":"https://api.github.com/users/gongpha/events{/privacy}","received_events_url":"https://api.github.com/users/gongpha/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-03-06T07:44:51Z","updated_at":"2026-03-06T07:44:51Z","body":"Thanks for clarifying that, I judged that from the file name U//<)\n\nI forgot to mention that it was reproducible on non-embedded too (`Embed Game on Next Play` = OFF)","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4010129960/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4017029137","html_url":"https://github.com/godotengine/godot/issues/114044#issuecomment-4017029137","issue_url":"https://api.github.com/repos/godotengine/godot/issues/114044","id":4017029137,"node_id":"IC_kwDOAO6SJc7vbwAR","user":{"login":"musjj","id":72612857,"node_id":"MDQ6VXNlcjcyNjEyODU3","avatar_url":"https://avatars.githubusercontent.com/u/72612857?v=4","gravatar_id":"","url":"https://api.github.com/users/musjj","html_url":"https://github.com/musjj","followers_url":"https://api.github.com/users/musjj/followers","following_url":"https://api.github.com/users/musjj/following{/other_user}","gists_url":"https://api.github.com/users/musjj/gists{/gist_id}","starred_url":"https://api.github.com/users/musjj/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/musjj/subscriptions","organizations_url":"https://api.github.com/users/musjj/orgs","repos_url":"https://api.github.com/users/musjj/repos","events_url":"https://api.github.com/users/musjj/events{/privacy}","received_events_url":"https://api.github.com/users/musjj/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-03-07T18:00:04Z","updated_at":"2026-03-07T18:01:49Z","body":"On Niri if I disable <kbd><samp>Embed Game on Next Play</samp></kbd>, the cursor is grabbed correctly. So it's only an issue for the embedded window.\n\n> I've already made the workaround fix for this : [gongpha@238483c](https://github.com/gongpha/godot/commit/238483c112e03906939000150662f9ec2eaa6431), but haven't opened the PR yet\n\nI've tried this patch, but it doesn't help fix the issue with the embedded game window. But I'm not 100% sure if I'm really applying it correctly, can anyone else also please confirm if this does/doesn't work on Niri?","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4017029137/reactions","total_count":1,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":1,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4017071918","html_url":"https://github.com/godotengine/godot/issues/114044#issuecomment-4017071918","issue_url":"https://api.github.com/repos/godotengine/godot/issues/114044","id":4017071918,"node_id":"IC_kwDOAO6SJc7vb6cu","user":{"login":"deralmas","id":31065808,"node_id":"MDQ6VXNlcjMxMDY1ODA4","avatar_url":"https://avatars.githubusercontent.com/u/31065808?v=4","gravatar_id":"","url":"https://api.github.com/users/deralmas","html_url":"https://github.com/deralmas","followers_url":"https://api.github.com/users/deralmas/followers","following_url":"https://api.github.com/users/deralmas/following{/other_user}","gists_url":"https://api.github.com/users/deralmas/gists{/gist_id}","starred_url":"https://api.github.com/users/deralmas/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/deralmas/subscriptions","organizations_url":"https://api.github.com/users/deralmas/orgs","repos_url":"https://api.github.com/users/deralmas/repos","events_url":"https://api.github.com/users/deralmas/events{/privacy}","received_events_url":"https://api.github.com/users/deralmas/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-03-07T18:26:25Z","updated_at":"2026-03-07T18:27:35Z","body":"Note that the whole editor runs through the embedder layer, otherwise it can't embed. `GODOT_WAYLAND_DISABLE_EMBEDDER=1` would be a good consistency check, although it would disable embedding altogether obviously.\n\nI think that the patch only works around the \"ws is null\" error spam, not fix the bug. Based from your description there's something wrong with the way we handle pointer constraints in the embedder.\n\nActually taking a quick look at the code we actually do some clever things due to some compositor limitations (I forgor 💀) so that makes more sense now:\n\nhttps://github.com/godotengine/godot/blob/220b0b2f74d8e089481b140c42a42992a76dd6fc/platform/linuxbsd/wayland/wayland_embedder.cpp#L1716-L1718\n\nAs soon as I free up I'll take a closer look. That's clearly the source of the problem.","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4017071918/reactions","total_count":5,"+1":3,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":2,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4364634089","html_url":"https://github.com/godotengine/godot/issues/114044#issuecomment-4364634089","issue_url":"https://api.github.com/repos/godotengine/godot/issues/114044","id":4364634089,"node_id":"IC_kwDOAO6SJc8AAAABBCcH6Q","user":{"login":"musjj","id":72612857,"node_id":"MDQ6VXNlcjcyNjEyODU3","avatar_url":"https://avatars.githubusercontent.com/u/72612857?v=4","gravatar_id":"","url":"https://api.github.com/users/musjj","html_url":"https://github.com/musjj","followers_url":"https://api.github.com/users/musjj/followers","following_url":"https://api.github.com/users/musjj/following{/other_user}","gists_url":"https://api.github.com/users/musjj/gists{/gist_id}","starred_url":"https://api.github.com/users/musjj/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/musjj/subscriptions","organizations_url":"https://api.github.com/users/musjj/orgs","repos_url":"https://api.github.com/users/musjj/repos","events_url":"https://api.github.com/users/musjj/events{/privacy}","received_events_url":"https://api.github.com/users/musjj/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-05-02T20:14:34Z","updated_at":"2026-05-02T20:14:34Z","body":"Any chance this could be fixed on the upcoming release? This is the last bug that is stopping me from going full Wayland!","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4364634089/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4364706779","html_url":"https://github.com/godotengine/godot/issues/114044#issuecomment-4364706779","issue_url":"https://api.github.com/repos/godotengine/godot/issues/114044","id":4364706779,"node_id":"IC_kwDOAO6SJc8AAAABBCgj2w","user":{"login":"deralmas","id":31065808,"node_id":"MDQ6VXNlcjMxMDY1ODA4","avatar_url":"https://avatars.githubusercontent.com/u/31065808?v=4","gravatar_id":"","url":"https://api.github.com/users/deralmas","html_url":"https://github.com/deralmas","followers_url":"https://api.github.com/users/deralmas/followers","following_url":"https://api.github.com/users/deralmas/following{/other_user}","gists_url":"https://api.github.com/users/deralmas/gists{/gist_id}","starred_url":"https://api.github.com/users/deralmas/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/deralmas/subscriptions","organizations_url":"https://api.github.com/users/deralmas/orgs","repos_url":"https://api.github.com/users/deralmas/repos","events_url":"https://api.github.com/users/deralmas/events{/privacy}","received_events_url":"https://api.github.com/users/deralmas/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-05-02T20:57:37Z","updated_at":"2026-05-02T20:57:37Z","body":"> Any chance this could be fixed on the upcoming release?\n\nSorry, unfortunately I can't promise that. I'm planning to work a lot on the embedder soon but first I'm trying to tie up some loose ends (touch, crashes, and so on). We'll see.","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4364706779/reactions","total_count":2,"+1":2,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4582219953","html_url":"https://github.com/godotengine/godot/issues/114044#issuecomment-4582219953","issue_url":"https://api.github.com/repos/godotengine/godot/issues/114044","id":4582219953,"node_id":"IC_kwDOAO6SJc8AAAABER8gsQ","user":{"login":"deralmas","id":31065808,"node_id":"MDQ6VXNlcjMxMDY1ODA4","avatar_url":"https://avatars.githubusercontent.com/u/31065808?v=4","gravatar_id":"","url":"https://api.github.com/users/deralmas","html_url":"https://github.com/deralmas","followers_url":"https://api.github.com/users/deralmas/followers","following_url":"https://api.github.com/users/deralmas/following{/other_user}","gists_url":"https://api.github.com/users/deralmas/gists{/gist_id}","starred_url":"https://api.github.com/users/deralmas/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/deralmas/subscriptions","organizations_url":"https://api.github.com/users/deralmas/orgs","repos_url":"https://api.github.com/users/deralmas/repos","events_url":"https://api.github.com/users/deralmas/events{/privacy}","received_events_url":"https://api.github.com/users/deralmas/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-05-30T08:10:11Z","updated_at":"2026-05-30T08:10:11Z","body":"> I forgot to mention that it was reproducible on non-embedded too (Embed Game on Next Play = OFF)\n\nOh, I just noticed this, sorry. That's a bit reassuring actually, as it's way easier to change \"client\" logic compared to the embedder. Maybe it's just some spec detail I'm missing. I'll have to spin up a bunch of different compositors and figure out what's going on.","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4582219953/reactions","total_count":3,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":2,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4583386535","html_url":"https://github.com/godotengine/godot/issues/114044#issuecomment-4583386535","issue_url":"https://api.github.com/repos/godotengine/godot/issues/114044","id":4583386535,"node_id":"IC_kwDOAO6SJc8AAAABETDtpw","user":{"login":"BalderKj","id":56432762,"node_id":"MDQ6VXNlcjU2NDMyNzYy","avatar_url":"https://avatars.githubusercontent.com/u/56432762?v=4","gravatar_id":"","url":"https://api.github.com/users/BalderKj","html_url":"https://github.com/BalderKj","followers_url":"https://api.github.com/users/BalderKj/followers","following_url":"https://api.github.com/users/BalderKj/following{/other_user}","gists_url":"https://api.github.com/users/BalderKj/gists{/gist_id}","starred_url":"https://api.github.com/users/BalderKj/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/BalderKj/subscriptions","organizations_url":"https://api.github.com/users/BalderKj/orgs","repos_url":"https://api.github.com/users/BalderKj/repos","events_url":"https://api.github.com/users/BalderKj/events{/privacy}","received_events_url":"https://api.github.com/users/BalderKj/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-05-30T16:12:35Z","updated_at":"2026-05-30T16:12:35Z","body":"> I have tested this on KDE and it seems to work properly there. Maybe a missing protocol in Niri?\n\nI am experiencing the same issue on KDE myself. \n\n```\n  Transient hostname: fedora\n     Static hostname: (unset)                                     \n           Icon name: computer-laptop\n             Chassis: laptop 💻\n   Chassis Asset Tag: NO Asset Tag\n          Machine ID: 77649d76e4e847cbb0ea316f6b0aad75\n             Boot ID: 1d7ecc4072a44daab28dea70be1bc034\n    Operating System: Fedora Linux 43 (KDE Plasma Desktop Edition)\n         CPE OS Name: cpe:/o:fedoraproject:fedora:43\n      OS Support End: Wed 2026-12-02\nOS Support Remaining: 6month 2d\n              Kernel: Linux 7.0.10-100.fc43.x86_64\n        Architecture: x86-64\n     Hardware Vendor: Lenovo\n      Hardware Model: Legion 5 15AHP10\n        Hardware SKU: LENOVO_MT_83M0_BU_idea_FM_Legion 5 15AHP10\n    Firmware Version: RGCN27WW\n       Firmware Date: Thu 2025-05-22\n        Firmware Age: 1y 1w 1d\n```","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4583386535/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4699616501","html_url":"https://github.com/godotengine/godot/issues/114044#issuecomment-4699616501","issue_url":"https://api.github.com/repos/godotengine/godot/issues/114044","id":4699616501,"node_id":"IC_kwDOAO6SJc8AAAABGB509Q","user":{"login":"deralmas","id":31065808,"node_id":"MDQ6VXNlcjMxMDY1ODA4","avatar_url":"https://avatars.githubusercontent.com/u/31065808?v=4","gravatar_id":"","url":"https://api.github.com/users/deralmas","html_url":"https://github.com/deralmas","followers_url":"https://api.github.com/users/deralmas/followers","following_url":"https://api.github.com/users/deralmas/following{/other_user}","gists_url":"https://api.github.com/users/deralmas/gists{/gist_id}","starred_url":"https://api.github.com/users/deralmas/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/deralmas/subscriptions","organizations_url":"https://api.github.com/users/deralmas/orgs","repos_url":"https://api.github.com/users/deralmas/repos","events_url":"https://api.github.com/users/deralmas/events{/privacy}","received_events_url":"https://api.github.com/users/deralmas/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-06-13T19:54:45Z","updated_at":"2026-06-13T19:54:45Z","body":"Update: turns out that the \"workaround\" we did depended on faulty implementations. Apparently both sway (my daily driver) and kwin have a faulty pointer constraints implementation that doesn't allow constraints on subsurfaces. See https://github.com/godotengine/godot/issues/116232#issuecomment-4673093452 and related comments for more info.\n\nThe workaround was redirecting (at the expense of compliant compositors) \"redirecting\" constraints to the main surface, which works for locking but apparently not with captures. I assume because the main surface is occluded by the actual subsurface we want to constrain the pointer to.\n\nFrom my understanding, the best solution is to just remove the \"workaround\" and assume a compliant implementations (which seem to be the majority) and wait for a fix to the affected ones.\n\nLooks like the bug is known on KDE but requires some major reworking fix. I'm not sure about sway/wlroots, and a quick search didn't bring out anything last time I checked. I'll report as appropriate, eventually.","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4699616501/reactions","total_count":2,"+1":2,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4699621704","html_url":"https://github.com/godotengine/godot/issues/114044#issuecomment-4699621704","issue_url":"https://api.github.com/repos/godotengine/godot/issues/114044","id":4699621704,"node_id":"IC_kwDOAO6SJc8AAAABGB6JSA","user":{"login":"deralmas","id":31065808,"node_id":"MDQ6VXNlcjMxMDY1ODA4","avatar_url":"https://avatars.githubusercontent.com/u/31065808?v=4","gravatar_id":"","url":"https://api.github.com/users/deralmas","html_url":"https://github.com/deralmas","followers_url":"https://api.github.com/users/deralmas/followers","following_url":"https://api.github.com/users/deralmas/following{/other_user}","gists_url":"https://api.github.com/users/deralmas/gists{/gist_id}","starred_url":"https://api.github.com/users/deralmas/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/deralmas/subscriptions","organizations_url":"https://api.github.com/users/deralmas/orgs","repos_url":"https://api.github.com/users/deralmas/repos","events_url":"https://api.github.com/users/deralmas/events{/privacy}","received_events_url":"https://api.github.com/users/deralmas/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-06-13T19:57:03Z","updated_at":"2026-06-13T19:57:03Z","body":"(sorry for double-post)\n\nThat said, I'm not sure why it's reproducible on non-embedded games. My theory is that it's a known unrelated bug, that is that constraints don't work until you point at least once the window. I.E, if you start a game and have the cursor outside the window while constraining, it will print an error and fail to constraint.\n\nThis issue is way more easily fixable and will be the approach I'll take for now, alongside removing the embedded game workaround.","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4699621704/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4959871556","html_url":"https://github.com/godotengine/godot/issues/114044#issuecomment-4959871556","issue_url":"https://api.github.com/repos/godotengine/godot/issues/114044","id":4959871556,"node_id":"IC_kwDOAO6SJc8AAAABJ6GiRA","user":{"login":"deralmas","id":31065808,"node_id":"MDQ6VXNlcjMxMDY1ODA4","avatar_url":"https://avatars.githubusercontent.com/u/31065808?v=4","gravatar_id":"","url":"https://api.github.com/users/deralmas","html_url":"https://github.com/deralmas","followers_url":"https://api.github.com/users/deralmas/followers","following_url":"https://api.github.com/users/deralmas/following{/other_user}","gists_url":"https://api.github.com/users/deralmas/gists{/gist_id}","starred_url":"https://api.github.com/users/deralmas/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/deralmas/subscriptions","organizations_url":"https://api.github.com/users/deralmas/orgs","repos_url":"https://api.github.com/users/deralmas/repos","events_url":"https://api.github.com/users/deralmas/events{/privacy}","received_events_url":"https://api.github.com/users/deralmas/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-07-13T15:52:57Z","updated_at":"2026-07-13T15:52:57Z","body":"All right people, I think the issue has been fixed as much as possible. The broken \"workaround\" has been removed with https://github.com/godotengine/godot/pull/120831 and now constraints wait for the pointer to enter the window thanks to https://github.com/godotengine/godot/pull/120647 .\n\nUnfortunately, as pointed out, some compositors are broken, but that's something that will have to be fixed upstream.\n\nHope this solves most of issues for you all! If you still see similar issues, despite having a working compositor (test with `weston-constraints`), please let me know!","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4959871556/reactions","total_count":6,"+1":0,"-1":0,"laugh":0,"hooray":6,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5304815066","html_url":"https://github.com/godotengine/godot/issues/114044#issuecomment-5304815066","issue_url":"https://api.github.com/repos/godotengine/godot/issues/114044","id":5304815066,"node_id":"IC_kwDOAO6SJc8AAAABPDEN2g","user":{"login":"foob2483-oss","id":263482962,"node_id":"U_kgDOD7RuUg","avatar_url":"https://avatars.githubusercontent.com/u/263482962?v=4","gravatar_id":"","url":"https://api.github.com/users/foob2483-oss","html_url":"https://github.com/foob2483-oss","followers_url":"https://api.github.com/users/foob2483-oss/followers","following_url":"https://api.github.com/users/foob2483-oss/following{/other_user}","gists_url":"https://api.github.com/users/foob2483-oss/gists{/gist_id}","starred_url":"https://api.github.com/users/foob2483-oss/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/foob2483-oss/subscriptions","organizations_url":"https://api.github.com/users/foob2483-oss/orgs","repos_url":"https://api.github.com/users/foob2483-oss/repos","events_url":"https://api.github.com/users/foob2483-oss/events{/privacy}","received_events_url":"https://api.github.com/users/foob2483-oss/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-08-15T23:54:23Z","updated_at":"2026-08-15T23:54:23Z","body":"Could this be included in a patch release? `4.8` release is still far away AFAIK.","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5304815066/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5382615605","html_url":"https://github.com/godotengine/godot/issues/114044#issuecomment-5382615605","issue_url":"https://api.github.com/repos/godotengine/godot/issues/114044","id":5382615605,"node_id":"IC_kwDOAO6SJc8AAAABQNQyNQ","user":{"login":"musjj","id":72612857,"node_id":"MDQ6VXNlcjcyNjEyODU3","avatar_url":"https://avatars.githubusercontent.com/u/72612857?v=4","gravatar_id":"","url":"https://api.github.com/users/musjj","html_url":"https://github.com/musjj","followers_url":"https://api.github.com/users/musjj/followers","following_url":"https://api.github.com/users/musjj/following{/other_user}","gists_url":"https://api.github.com/users/musjj/gists{/gist_id}","starred_url":"https://api.github.com/users/musjj/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/musjj/subscriptions","organizations_url":"https://api.github.com/users/musjj/orgs","repos_url":"https://api.github.com/users/musjj/repos","events_url":"https://api.github.com/users/musjj/events{/privacy}","received_events_url":"https://api.github.com/users/musjj/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-08-22T21:10:15Z","updated_at":"2026-08-23T00:01:14Z","body":"I'm still experiencing this bug in [`4.7.2`](https://github.com/godotengine/godot/releases/tag/4.7.2-stable).\n\nHere's a minimal reproducer: https://github.com/musjj/pointer-capture-bug. Just press play and it will try to trap your cursor inside the window. But of course, it won't work on Wayland due to this bug.\n\nSo, the following PR that should've fixed this bug was [cherry-picked](https://github.com/godotengine/godot/commit/53aaf6a0efb1f3f5fec0e04db60c964b5460ead9) for [`4.7.2`](https://github.com/godotengine/godot/releases/tag/4.7.2-stable):\n\n- https://github.com/godotengine/godot/pull/120647\n\nBut the bug described in this issue still persists anyways. After some investigation, it turns out that the other PR plays a critical role in fixing the bug:\n\n- https://github.com/godotengine/godot/pull/120831\n\nBut it was [not cherry-picked](https://github.com/godotengine/godot/commits/4.7.2-stable/platform/linuxbsd/wayland/wayland_embedder.cpp) for [`4.7.2`](https://github.com/godotengine/godot/releases/tag/4.7.2-stable). I tested and applied the above PR to [`4.7.2`](https://github.com/godotengine/godot/releases/tag/4.7.2-stable) and it fixed the bug for me. \n\nCould we have a new hotfix release for this?","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5382615605/reactions","total_count":2,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":1,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null}]