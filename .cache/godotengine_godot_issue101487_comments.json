.github.com/users/RedMser","html_url":"https://github.com/RedMser","followers_url":"https://api.github.com/users/RedMser/followers","following_url":"https://api.github.com/users/RedMser/following{/other_user}","gists_url":"https://api.github.com/users/RedMser/gists{/gist_id}","starred_url":"https://api.github.com/users/RedMser/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/RedMser/subscriptions","organizations_url":"https://api.github.com/users/RedMser/orgs","repos_url":"https://api.github.com/users/RedMser/repos","events_url":"https://api.github.com/users/RedMser/events{/privacy}","received_events_url":"https://api.github.com/users/RedMser/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-01-28T15:22:10Z","updated_at":"2025-01-28T15:22:41Z","body":"> I'm looking forward to improve the Godot's Control nodes too but most of my PRs either ignored\r\n\r\nThere's way more PRs being opened than there are reviewers and maintainers. I'm just patient and let my changes sit, while I work with the feature in a personal fork.\r\n\r\n> marked as 4.x even if they do/can fix bugs.\r\n\r\nYou can ask in chat to have it re-triaged (a PR of mine recently converted from enhancement to bug for example, which moves its milestone to the next minor version). If you can split your PR into one part bugfix another part enhancement, it's the best way to get it moving forward quicker.","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2619312851/reactions","total_count":6,"+1":6,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2619538387","html_url":"https://github.com/godotengine/godot/pull/101487#issuecomment-2619538387","issue_url":"https://api.github.com/repos/godotengine/godot/issues/101487","id":2619538387,"node_id":"IC_kwDOAO6SJc6cIvvT","user":{"login":"WhalesState","id":53877170,"node_id":"MDQ6VXNlcjUzODc3MTcw","avatar_url":"https://avatars.githubusercontent.com/u/53877170?v=4","gravatar_id":"","url":"https://api.github.com/users/WhalesState","html_url":"https://github.com/WhalesState","followers_url":"https://api.github.com/users/WhalesState/followers","following_url":"https://api.github.com/users/WhalesState/following{/other_user}","gists_url":"https://api.github.com/users/WhalesState/gists{/gist_id}","starred_url":"https://api.github.com/users/WhalesState/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/WhalesState/subscriptions","organizations_url":"https://api.github.com/users/WhalesState/orgs","repos_url":"https://api.github.com/users/WhalesState/repos","events_url":"https://api.github.com/users/WhalesState/events{/privacy}","received_events_url":"https://api.github.com/users/WhalesState/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-01-28T16:46:58Z","updated_at":"2025-01-28T16:46:58Z","body":"I'm patient, but a year is too much for a bug fix that exists since 3.x.\r\n\r\nDoes Godot really needs a reminder for a PR that fixes a bug?\r\n\r\nIs it written anywhere that I should go to a chat platform to wish for a bug that i have fixed to be merged in the next release?","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2619538387/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2619620107","html_url":"https://github.com/godotengine/godot/pull/101487#issuecomment-2619620107","issue_url":"https://api.github.com/repos/godotengine/godot/issues/101487","id":2619620107,"node_id":"IC_kwDOAO6SJc6cJDsL","user":{"login":"WhalesState","id":53877170,"node_id":"MDQ6VXNlcjUzODc3MTcw","avatar_url":"https://avatars.githubusercontent.com/u/53877170?v=4","gravatar_id":"","url":"https://api.github.com/users/WhalesState","html_url":"https://github.com/WhalesState","followers_url":"https://api.github.com/users/WhalesState/followers","following_url":"https://api.github.com/users/WhalesState/following{/other_user}","gists_url":"https://api.github.com/users/WhalesState/gists{/gist_id}","starred_url":"https://api.github.com/users/WhalesState/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/WhalesState/subscriptions","organizations_url":"https://api.github.com/users/WhalesState/orgs","repos_url":"https://api.github.com/users/WhalesState/repos","events_url":"https://api.github.com/users/WhalesState/events{/privacy}","received_events_url":"https://api.github.com/users/WhalesState/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-01-28T17:20:31Z","updated_at":"2025-01-28T17:20:31Z","body":"I did my best to work on another community driven fork and Godot at same time, fixing bugs here and adding features there because i know Godot will ignore my PRs if they add a feature and the 4.x milestone will be added by ATS.\r\n\r\nYou can See what i could have done to the Godot community. This is editing the fallback theme directly from project settings and works in real time even inside game, This could have been even better if the godot devs have helped me, great thanks to KoBeWi, Akien, kitbdev and many other devs that have helped me a lot, even AThousandShips have helped me a lot in the past and many thanks to her too. \r\n\r\nhttps://github.com/user-attachments/assets/66ae4a79-0c25-4eb7-990c-2ca4e226716e\r\n\r\nThis is a new collapse mode and is similar to VSCode split.\r\n\r\nhttps://github.com/user-attachments/assets/a7098353-2631-4e01-bd3d-5cae48171f20\r\n\r\nHope Godot survives all of this because I believe-in and respect all your hard-work, but i also have wished for some respect for my work too.","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2619620107/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2619697792","html_url":"https://github.com/godotengine/godot/pull/101487#issuecomment-2619697792","issue_url":"https://api.github.com/repos/godotengine/godot/issues/101487","id":2619697792,"node_id":"IC_kwDOAO6SJc6cJWqA","user":{"login":"Repiteo","id":17489292,"node_id":"MDQ6VXNlcjE3NDg5Mjky","avatar_url":"https://avatars.githubusercontent.com/u/17489292?v=4","gravatar_id":"","url":"https://api.github.com/users/Repiteo","html_url":"https://github.com/Repiteo","followers_url":"https://api.github.com/users/Repiteo/followers","following_url":"https://api.github.com/users/Repiteo/following{/other_user}","gists_url":"https://api.github.com/users/Repiteo/gists{/gist_id}","starred_url":"https://api.github.com/users/Repiteo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Repiteo/subscriptions","organizations_url":"https://api.github.com/users/Repiteo/orgs","repos_url":"https://api.github.com/users/Repiteo/repos","events_url":"https://api.github.com/users/Repiteo/events{/privacy}","received_events_url":"https://api.github.com/users/Repiteo/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-01-28T17:56:07Z","updated_at":"2025-01-28T17:56:07Z","body":"I can't help but feel there's been quite a few fundamental misunderstandings here.\r\n\r\n---\r\n\r\n> I did my best to work on another community driven fork and Godot at same time, fixing bugs here and adding features there because i know Godot will ignore my PRs if they add a feature and the 4.x milestone will be added by ATS.\r\n\r\nBeing put in the `4.x Milestone` only means that it's not an **immediate** priority for a given version. All non-bugfix PRs are going to be in this milestone because we're entered the beta period for 4.4; that is, we've entered a feature freeze. It is quite literally *not a priority* to review any PRs that aren't addressing bugs, it'd be a complete waste of finite resources/energy.\r\n\r\n---\r\n\r\n> This could have been even better if the godot devs have helped me, great thanks to KoBeWi, Akien, kitbdev and many other devs that have helped me a lot, even AThousandShips have helped me a lot in the past and many thanks to her too.\r\n\r\nIt certainly reads as if quite a lot of the godot devs did indeed help you. In this PR we see exactly that as well, with no real detraction to speak of. If this is annoyance at not being prioritized for a merge, then I must re-emphasize the earlier point of this type of PR not being the team's priority atm. Hell, I have [~70 open PRs](https://github.com/godotengine/godot/issues?q=is%3Aopen+is%3Apr+author%3A%40me) as we speak! But I also have over double that amount merged, because even though the due-process takes time, it *will* get done with time.\r\n\r\n---\r\n\r\n> Is it written anywhere that I should go to a chat platform to wish for a bug that i have fixed to be merged in the next release?\r\n\r\nAs a matter of fact, [yes](https://docs.godotengine.org/en/latest/contributing/how_to_contribute.html#technical-contributions)! Here's the explicit exerpt touching on this very concern:\r\n\r\n> **Contribute Engine Code (mainly C++)** The engine development is mainly coordinated on our [Contributor RocketChat](https://chat.godotengine.org/), so if you are serious about making PRs you should join us there!\r\n\r\nYou're free to believe that this isn't elevated/visible enough — if so, you can always make an [enhancement request](https://github.com/godotengine/godot-docs/issues/new?template=enhancement_request.md) in the docs repo — but it's not something we're deliberately obfuscating to make the PR process more tedious.\r\n\r\n---\r\n\r\n> Hope Godot survives all of this because I believe-in and respect all your hard-work, but i also have wished for some respect for my work too.\r\n\r\nIf you have any examples of being disrespected/harassed in this repo, do not hesitate to reach out to our [Code of Conduct team](https://godotengine.org/code-of-conduct/#:~:text=is%20not%20acceptable.-,Reporting%20a%20breach,-If%20you%20witness) with those concerns. If this is about this PR not being reviewed in what feels like a timely manner, then I'll state as unambiguously as possible: **that's not disrespect**. I get being personally attached to your work & wanting to see it reach as many people as possible, but a review of your work — or lack thereof — is not, and never has been, a personal statement on the PR itself. Reviews are most often a direct consequence of contributors putting their finite time/resources into analyzing areas they're passionate/skilled in, and those are not a guarantee — much less something owed.","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2619697792/reactions","total_count":14,"+1":10,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":4,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2620118045","html_url":"https://github.com/godotengine/godot/pull/101487#issuecomment-2620118045","issue_url":"https://api.github.com/repos/godotengine/godot/issues/101487","id":2620118045,"node_id":"IC_kwDOAO6SJc6cK9Qd","user":{"login":"KoBeWi","id":2223172,"node_id":"MDQ6VXNlcjIyMjMxNzI=","avatar_url":"https://avatars.githubusercontent.com/u/2223172?v=4","gravatar_id":"","url":"https://api.github.com/users/KoBeWi","html_url":"https://github.com/KoBeWi","followers_url":"https://api.github.com/users/KoBeWi/followers","following_url":"https://api.github.com/users/KoBeWi/following{/other_user}","gists_url":"https://api.github.com/users/KoBeWi/gists{/gist_id}","starred_url":"https://api.github.com/users/KoBeWi/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/KoBeWi/subscriptions","organizations_url":"https://api.github.com/users/KoBeWi/orgs","repos_url":"https://api.github.com/users/KoBeWi/repos","events_url":"https://api.github.com/users/KoBeWi/events{/privacy}","received_events_url":"https://api.github.com/users/KoBeWi/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-01-28T21:44:12Z","updated_at":"2025-01-28T21:44:12Z","body":"I was in the middle of checking this PR when you closed it, so nice timing. If you don't plan on working on it anymore I might take over. The implementation looks solid and the container has potential to be used in editor (inspector) and other controls (ColorPicker). Although I find the button part too complex; what I'd do instead is allow adding Button nodes to the title bar, similar to [another proposal for TabContainer](https://github.com/godotengine/godot-proposals/issues/2250).","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2620118045/reactions","total_count":4,"+1":0,"-1":0,"laugh":0,"hooray":4,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2620178910","html_url":"https://github.com/godotengine/godot/pull/101487#issuecomment-2620178910","issue_url":"https://api.github.com/repos/godotengine/godot/issues/101487","id":2620178910,"node_id":"IC_kwDOAO6SJc6cLMHe","user":{"login":"WhalesState","id":53877170,"node_id":"MDQ6VXNlcjUzODc3MTcw","avatar_url":"https://avatars.githubusercontent.com/u/53877170?v=4","gravatar_id":"","url":"https://api.github.com/users/WhalesState","html_url":"https://github.com/WhalesState","followers_url":"https://api.github.com/users/WhalesState/foll