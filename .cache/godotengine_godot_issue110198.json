://api.github.com/repos/godotengine/godot/labels/topic:buildsystem","name":"topic:buildsystem","color":"ffee88","default":false,"description":"","archived_at":null,"archived_by":null},{"id":279098255,"node_id":"MDU6TGFiZWwyNzkwOTgyNTU=","url":"https://api.github.com/repos/godotengine/godot/labels/topic:platforms","name":"topic:platforms","color":"ffee88","default":false,"description":"","archived_at":null,"archived_by":null}],"state":"closed","locked":false,"assignees":[],"milestone":{"url":"https://api.github.com/repos/godotengine/godot/milestones/23","html_url":"https://github.com/godotengine/godot/milestone/23","labels_url":"https://api.github.com/repos/godotengine/godot/milestones/23/labels","id":12939969,"node_id":"MI_kwDOAO6SJc4AxXLB","number":23,"title":"4.6","description":"","creator":{"login":"Repiteo","id":17489292,"node_id":"MDQ6VXNlcjE3NDg5Mjky","avatar_url":"https://avatars.githubusercontent.com/u/17489292?v=4","gravatar_id":"","url":"https://api.github.com/users/Repiteo","html_url":"https://github.com/Repiteo","followers_url":"https://api.github.com/users/Repiteo/followers","following_url":"https://api.github.com/users/Repiteo/following{/other_user}","gists_url":"https://api.github.com/users/Repiteo/gists{/gist_id}","starred_url":"https://api.github.com/users/Repiteo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Repiteo/subscriptions","organizations_url":"https://api.github.com/users/Repiteo/orgs","repos_url":"https://api.github.com/users/Repiteo/repos","events_url":"https://api.github.com/users/Repiteo/events{/privacy}","received_events_url":"https://api.github.com/users/Repiteo/received_events","type":"User","user_view_type":"public","site_admin":false},"open_issues":3,"closed_issues":2978,"state":"closed","created_at":"2025-05-22T16:25:52Z","updated_at":"2026-10-04T16:23:23Z","due_on":null,"closed_at":"2026-01-26T18:09:14Z"},"comments":4,"created_at":"2025-09-02T15:37:05Z","updated_at":"2026-01-08T22:17:56Z","closed_at":"2025-09-17T16:48:47Z","assignee":null,"author_association":"CONTRIBUTOR","issue_field_values":[],"type":null,"active_lock_reason":null,"draft":false,"pull_request":{"url":"https://api.github.com/repos/godotengine/godot/pulls/110198","html_url":"https://github.com/godotengine/godot/pull/110198","diff_url":"https://github.com/godotengine/godot/pull/110198.diff","patch_url":"https://github.com/godotengine/godot/pull/110198.patch","merged_at":"2025-09-17T16:48:47Z"},"body":"Without this, on Linux and Linux alone, and only if SDL is builtin, the definitions for some libc functions - notably, memset/memcpy - are taken from SDL source (which defines them in `thirdparty/sdl/stdlib/SDL_memcpy.c` et al unless HAVE_LIBC is 1).\r\n\r\nThis leaves the codegen at the mercy of the compiler and may lead to the optimal implementations of these functions not being selected (e.g. if extended instruction sets like AVX2+ are available). But the main motivation for this is that it's action at a distance that is incredibly surprising - linking in a gamepad support library should not change the implementation of memset/memcpy!\r\n\r\nBefore https://github.com/godotengine/godot/pull/106218, SDL was not being linked with, and so going back to using memset/memcpy from libc should be safe.\r\n\r\nOn Zen 4, the SDL implementation - at least when compiled with clang - is, in fact, fine (for example, clang vectorizes the copying loop), but I'm not sure if there's any consequences on other CPUs and it just felt incredibly strange to use memset/memcpy implementations from SDL because of, what I assume, is an accidental misconfiguration. HAVE_LIBC is set to 1 on Windows/macOS.","closed_by":{"login":"Repiteo","id":17489292,"node_id":"MDQ6VXNlcjE3NDg5Mjky","avatar_url":"https://avatars.githubusercontent.com/u/17489292?v=4","gravatar_id":"","url":"https://api.github.com/users/Repiteo","html_url":"https://github.com/Repiteo","followers_url":"https://api.github.com/users/Repiteo/followers","following_url":"https://api.github.com/users/Repiteo/following{/other_user}","gists_url":"https://api.github.com/users/Repiteo/gists{/gist_id}","starred_url":"https://api.github.com/users/Repiteo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Repiteo/subscriptions","organizations_url":"https://api.github.com/users/Repiteo/orgs","repos_url":"https://api.github.com/users/Repiteo/repos","events_url":"https://api.github.com/users/Repiteo/events{/privacy}","received_events_url":"https://api.github.com/users/Repiteo/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/110198/reactions","total_count":3,"+1":2,"-1":0,"laugh":1,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/godotengine/godot/issues/110198/timeline","performed_via_github_app":null,"state_reason":null}