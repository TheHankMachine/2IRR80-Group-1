[{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2555832331","html_url":"https://github.com/godotengine/godot/issues/100517#issuecomment-2555832331","issue_url":"https://api.github.com/repos/godotengine/godot/issues/100517","id":2555832331,"node_id":"IC_kwDOAO6SJc6YVugL","user":{"login":"matheusmdx","id":44306054,"node_id":"MDQ6VXNlcjQ0MzA2MDU0","avatar_url":"https://avatars.githubusercontent.com/u/44306054?v=4","gravatar_id":"","url":"https://api.github.com/users/matheusmdx","html_url":"https://github.com/matheusmdx","followers_url":"https://api.github.com/users/matheusmdx/followers","following_url":"https://api.github.com/users/matheusmdx/following{/other_user}","gists_url":"https://api.github.com/users/matheusmdx/gists{/gist_id}","starred_url":"https://api.github.com/users/matheusmdx/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/matheusmdx/subscriptions","organizations_url":"https://api.github.com/users/matheusmdx/orgs","repos_url":"https://api.github.com/users/matheusmdx/repos","events_url":"https://api.github.com/users/matheusmdx/events{/privacy}","received_events_url":"https://api.github.com/users/matheusmdx/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2024-12-19T21:49:23Z","updated_at":"2024-12-19T21:49:23Z","body":"Seems to a be a regression between 4.3 beta 3 and 4.3 rc 1, bisecting rn","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2555832331/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2555863392","html_url":"https://github.com/godotengine/godot/issues/100517#issuecomment-2555863392","issue_url":"https://api.github.com/repos/godotengine/godot/issues/100517","id":2555863392,"node_id":"IC_kwDOAO6SJc6YV2Fg","user":{"login":"matheusmdx","id":44306054,"node_id":"MDQ6VXNlcjQ0MzA2MDU0","avatar_url":"https://avatars.githubusercontent.com/u/44306054?v=4","gravatar_id":"","url":"https://api.github.com/users/matheusmdx","html_url":"https://github.com/matheusmdx","followers_url":"https://api.github.com/users/matheusmdx/followers","following_url":"https://api.github.com/users/matheusmdx/following{/other_user}","gists_url":"https://api.github.com/users/matheusmdx/gists{/gist_id}","starred_url":"https://api.github.com/users/matheusmdx/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/matheusmdx/subscriptions","organizations_url":"https://api.github.com/users/matheusmdx/orgs","repos_url":"https://api.github.com/users/matheusmdx/repos","events_url":"https://api.github.com/users/matheusmdx/events{/privacy}","received_events_url":"https://api.github.com/users/matheusmdx/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2024-12-19T22:13:08Z","updated_at":"2024-12-19T22:13:08Z","body":"Bisected to #93802, @feiyue-z \n\n![Image](https://github.com/user-attachments/assets/56cc1042-da8d-46f0-bd84-463b887c204e)\n","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2555863392/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2556079615","html_url":"https://github.com/godotengine/godot/issues/100517#issuecomment-2556079615","issue_url":"https://api.github.com/repos/godotengine/godot/issues/100517","id":2556079615,"node_id":"IC_kwDOAO6SJc6YWq3_","user":{"login":"RichMakeGame","id":97259185,"node_id":"U_kgDOBcwOsQ","avatar_url":"https://avatars.githubusercontent.com/u/97259185?v=4","gravatar_id":"","url":"https://api.github.com/users/RichMakeGame","html_url":"https://github.com/RichMakeGame","followers_url":"https://api.github.com/users/RichMakeGame/followers","following_url":"https://api.github.com/users/RichMakeGame/following{/other_user}","gists_url":"https://api.github.com/users/RichMakeGame/gists{/gist_id}","starred_url":"https://api.github.com/users/RichMakeGame/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/RichMakeGame/subscriptions","organizations_url":"https://api.github.com/users/RichMakeGame/orgs","repos_url":"https://api.github.com/users/RichMakeGame/repos","events_url":"https://api.github.com/users/RichMakeGame/events{/privacy}","received_events_url":"https://api.github.com/users/RichMakeGame/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2024-12-20T01:28:58Z","updated_at":"2024-12-20T01:28:58Z","body":"hello and thanks for taking a look! - while I think there is a separate issue of a missing linear>srgb conversion when I display the linear viewports texture in an srgb viewport (in my test case I had to add a conversion to get the green to match in frame 1) I don't think it's the same as the issue I'm describing.\n\nIn my case I'm bouncing viewport textures back and forth between two linear viewports, so no conversion should take place- and the amount it becomes darker each time seems much subtler than a missing conversion. it happens over a few hundred frames\n\nfinally, I tried an example using white; white should be identical between srgb and linear I think? so a missing conversion should make no difference\nhere's frame 1:\n![Image](https://github.com/user-attachments/assets/2700ffee-bbf3-48da-b26d-a035114c1eba)\nand frame 400:\n![Image](https://github.com/user-attachments/assets/35633384-99c8-4a4a-b049-dae6b154ed5c)\n\nwhat I was imagining was maybe even though both viewports are linear, maybe the texture was being converted to srgb then back to linear with an imprecise algorithm? complete stab in the dark, I don't have the expertise :)","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2556079615/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2556118342","html_url":"https://github.com/godotengine/godot/issues/100517#issuecomment-2556118342","issue_url":"https://api.github.com/repos/godotengine/godot/issues/100517","id":2556118342,"node_id":"IC_kwDOAO6SJc6YW0VG","user":{"login":"matheusmdx","id":44306054,"node_id":"MDQ6VXNlcjQ0MzA2MDU0","avatar_url":"https://avatars.githubusercontent.com/u/44306054?v=4","gravatar_id":"","url":"https://api.github.com/users/matheusmdx","html_url":"https://github.com/matheusmdx","followers_url":"https://api.github.com/users/matheusmdx/followers","following_url":"https://api.github.com/users/matheusmdx/following{/other_user}","gists_url":"https://api.github.com/users/matheusmdx/gists{/gist_id}","starred_url":"https://api.github.com/users/matheusmdx/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/matheusmdx/subscriptions","organizations_url":"https://api.github.com/users/matheusmdx/orgs","repos_url":"https://api.github.com/users/matheusmdx/repos","events_url":"https://api.github.com/users/matheusmdx/events{/privacy}","received_events_url":"https://api.github.com/users/matheusmdx/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2024-12-20T02:07:19Z","updated_at":"2024-12-20T02:07:56Z","body":"Unfortunately I don't have any rendering related knowledge to explain for you how and why this is happening, the only thing i can guarantee for you is reverting the cited pr solves the issue. When someone from the rendering team take a look on this probably they'll be able to give you a proper answer:\n\nhttps://github.com/user-attachments/assets/f44027a2-c73d-4843-9686-7898070e9763\n","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2556118342/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2556142811","html_url":"https://github.com/godotengine/godot/issues/100517#issuecomment-2556142811","issue_url":"https://api.github.com/repos/godotengine/godot/issues/100517","id":2556142811,"node_id":"IC_kwDOAO6SJc6YW6Tb","user":{"login":"clayjohn","id":16521339,"node_id":"MDQ6VXNlcjE2NTIxMzM5","avatar_url":"https://avatars.githubusercontent.com/u/16521339?v=4","gravatar_id":"","url":"https://api.github.com/users/clayjohn","html_url":"https://github.com/clayjohn","followers_url":"https://api.github.com/users/clayjohn/followers","following_url":"https://api.github.com/users/clayjohn/following{/other_user}","gists_url":"https://api.github.com/users/clayjohn/gists{/gist_id}","starred_url":"https://api.github.com/users/clayjohn/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/clayjohn/subscriptions","organizations_url":"https://api.github.com/users/clayjohn/orgs","repos_url":"https://api.github.com/users/clayjohn/repos","events_url":"https://api.github.com/users/clayjohn/events{/privacy}","received_events_url":"https://api.github.com/users/clayjohn/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2024-12-20T02:32:47Z","updated_at":"2024-12-20T04:10:14Z","body":"I tested this locally and was able to reproduce the issue. \n\nThe issue that the bisect points to should be totally unrelated in theory _unless_ our srgb_to_linear() function is somehow converting white to something slightly less than white. \n\nI checked in a debugger and indeed `srgb_to_linear()` is not returning pure white when pure white is input\n\n<img width=\"434\" alt=\"Image\" src=\"https://github.com/user-attachments/assets/03394b9c-4f72-410d-84d7-d560d1e64922\" />\n\nFurther testing shows this is a floating point precision issue, using doubles makes the error go away. \n\nHere is the calculation currently:\n```\ng < 0.04045f ? g * (1.0f / 12.92f) : Math::pow((g + 0.055f) * (float)(1.0 / (1.0 + 0.055)), 2.4f)\n```\nChanging it to the following is enough to fix the error:\n```\ng < 0.04045f ? g * (1.0f / 12.92f) : Math::pow(float((g + 0.055) * (1.0 / (1.0 + 0.055))), 2.4f),\n```\nAlternatively, the following also works:\n```\ng == 1.0f ? 1.0 : g < 0.04045f ? g * (1.0f / 12.92f) : Math::pow((g + 0.055f) * (float)(1.0 / (1.0 + 0.055)), 2.4f),\n\n```\n","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2556142811/reactions","total_count":3,"+1":3,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2556866690","html_url":"https://github.com/godotengine/godot/issues/100517#issuecomment-2556866690","issue_url":"https://api.github.com/repos/godotengine/godot/issues/100517","id":2556866690,"node_id":"IC_kwDOAO6SJc6YZrCC","user":{"login":"RichMakeGame","id":97259185,"node_id":"U_kgDOBcwOsQ","avatar_url":"https://avatars.githubusercontent.com/u/97259185?v=4","gravatar_id":"","url":"https://api.github.com/users/RichMakeGame","html_url":"https://github.com/RichMakeGame","followers_url":"https://api.github.com/users/RichMakeGame/followers","following_url":"https://api.github.com/users/RichMakeGame/following{/other_user}","gists_url":"https://api.github.com/users/RichMakeGame/gists{/gist_id}","starred_url":"https://api.github.com/users/RichMakeGame/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/RichMakeGame/subscriptions","organizations_url":"https://api.github.com/users/RichMakeGame/orgs","repos_url":"https://api.github.com/users/RichMakeGame/repos","events_url":"https://api.github.com/users/RichMakeGame/events{/privacy}","received_events_url":"https://api.github.com/users/RichMakeGame/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2024-12-20T12:01:38Z","updated_at":"2024-12-20T12:01:38Z","body":"thank you both for replying and taking an in-depth look! If I could just to double check- does it mean that the pr was causing a linear>srgb then srgb>linear conversion to occur, and without it the texture will stay in linear/RGBA16?\n\nI just want to check if I'll get any advantage from the bit depth, or if its lost converting to and from RGBA8 between viewports\n\nthanks again!","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2556866690/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2557264826","html_url":"https://github.com/godotengine/godot/issues/100517#issuecomment-2557264826","issue_url":"https://api.github.com/repos/godotengine/godot/issues/100517","id":2557264826,"node_id":"IC_kwDOAO6SJc6YbMO6","user":{"login":"clayjohn","id":16521339,"node_id":"MDQ6VXNlcjE2NTIxMzM5","avatar_url":"https://avatars.githubusercontent.com/u/16521339?v=4","gravatar_id":"","url":"https://api.github.com/users/clayjohn","html_url":"https://github.com/clayjohn","followers_url":"https://api.github.com/users/clayjohn/followers","following_url":"https://api.github.com/users/clayjohn/following{/other_user}","gists_url":"https://api.github.com/users/clayjohn/gists{/gist_id}","starred_url":"https://api.github.com/users/clayjohn/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/clayjohn/subscriptions","organizations_url":"https://api.github.com/users/clayjohn/orgs","repos_url":"https://api.github.com/users/clayjohn/repos","events_url":"https://api.github.com/users/clayjohn/events{/privacy}","received_events_url":"https://api.github.com/users/clayjohn/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2024-12-20T15:53:57Z","updated_at":"2024-12-20T15:53:57Z","body":"> thank you both for replying and taking an in-depth look! If I could just to double check- does it mean that the pr was causing a linear>srgb then srgb>linear conversion to occur, and without it the texture will stay in linear/RGBA16?\n> \n> I just want to check if I'll get any advantage from the bit depth, or if its lost converting to and from RGBA8 between viewports\n> \n> thanks again!\n\nThe PR doesn't change your texture at all. Canvas Modulate is a color that gets multiplied by every pixel on screen. Because it is slightly less than 1 it is slightly darkening your screen every frame. And since you have an infinite feedback loop between the two textures the resulting image gets darker each frame. ","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2557264826/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2557794790","html_url":"https://github.com/godotengine/godot/issues/100517#issuecomment-2557794790","issue_url":"https://api.github.com/repos/godotengine/godot/issues/100517","id":2557794790,"node_id":"IC_kwDOAO6SJc6YdNnm","user":{"login":"RichMakeGame","id":97259185,"node_id":"U_kgDOBcwOsQ","avatar_url":"https://avatars.githubusercontent.com/u/97259185?v=4","gravatar_id":"","url":"https://api.github.com/users/RichMakeGame","html_url":"https://github.com/RichMakeGame","followers_url":"https://api.github.com/users/RichMakeGame/followers","following_url":"https://api.github.com/users/RichMakeGame/following{/other_user}","gists_url":"https://api.github.com/users/RichMakeGame/gists{/gist_id}","starred_url":"https://api.github.com/users/RichMakeGame/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/RichMakeGame/subscriptions","organizations_url":"https://api.github.com/users/RichMakeGame/orgs","repos_url":"https://api.github.com/users/RichMakeGame/repos","events_url":"https://api.github.com/users/RichMakeGame/events{/privacy}","received_events_url":"https://api.github.com/users/RichMakeGame/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2024-12-20T22:16:52Z","updated_at":"2024-12-20T22:16:52Z","body":"Oh! I didn't understand the Canvas Modulate was causing it! that makes perfect sense, thank you so much. The viewport gets set to linear, and so the canvas modulate colour is converted too with a tiny dip in brightness, then it gets applied each time a viewport texture is generated.. I get it now\n\nthis means I can actually solve my particular issue immediately by specifying render_mode unshaded in the shaders\n\nthank you again","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2557794790/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null}]