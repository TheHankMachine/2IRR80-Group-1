ps://api.github.com/users/aXu-AP/orgs","repos_url":"https://api.github.com/users/aXu-AP/repos","events_url":"https://api.github.com/users/aXu-AP/events{/privacy}","received_events_url":"https://api.github.com/users/aXu-AP/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2024-12-12T15:49:43Z","updated_at":"2024-12-12T15:49:43Z","body":"Rebased and changed `MODE_WEIGHTS` to `MODE_BONES` to be more in line with existing terminology.","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2539338863/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2539961768","html_url":"https://github.com/godotengine/godot/pull/99439#issuecomment-2539961768","issue_url":"https://api.github.com/repos/godotengine/godot/issues/99439","id":2539961768,"node_id":"IC_kwDOAO6SJc6XZL2o","user":{"login":"KoBeWi","id":2223172,"node_id":"MDQ6VXNlcjIyMjMxNzI=","avatar_url":"https://avatars.githubusercontent.com/u/2223172?v=4","gravatar_id":"","url":"https://api.github.com/users/KoBeWi","html_url":"https://github.com/KoBeWi","followers_url":"https://api.github.com/users/KoBeWi/followers","following_url":"https://api.github.com/users/KoBeWi/following{/other_user}","gists_url":"https://api.github.com/users/KoBeWi/gists{/gist_id}","starred_url":"https://api.github.com/users/KoBeWi/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/KoBeWi/subscriptions","organizations_url":"https://api.github.com/users/KoBeWi/orgs","repos_url":"https://api.github.com/users/KoBeWi/repos","events_url":"https://api.github.com/users/KoBeWi/events{/privacy}","received_events_url":"https://api.github.com/users/KoBeWi/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2024-12-12T20:32:53Z","updated_at":"2024-12-12T20:43:05Z","body":"With this change, we have another node that pops a bottom panel every time you select it.\r\n\r\nThere is a glitch when the panel opens. It resets the view, but if it was shifted before selecting, the panel will appear if previous position and then reset after one frame. Very noticeable.\r\n\r\nhttps://github.com/user-attachments/assets/a164e8ff-daca-4316-894b-8dedddac9ca6\r\n\r\nI think it should not reset if you select the same node as before.\r\n\r\n> Reorder the modes to reflect usual workflow (move UV to third place)\r\n\r\nWith this you also changed default mode to Points. Is this the usual workflow? I only ever used UV editor to edit UV tbh.","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2539961768/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2540084410","html_url":"https://github.com/godotengine/godot/pull/99439#issuecomment-2540084410","issue_url":"https://api.github.com/repos/godotengine/godot/issues/99439","id":2540084410,"node_id":"IC_kwDOAO6SJc6XZpy6","user":{"login":"KoBeWi","id":2223172,"node_id":"MDQ6VXNlcjIyMjMxNzI=","avatar_url":"https://avatars.githubusercontent.com/u/2223172?v=4","gravatar_id":"","url":"https://api.github.com/users/KoBeWi","html_url":"https://github.com/KoBeWi","followers_url":"https://api.github.com/users/KoBeWi/followers","following_url":"https://api.github.com/users/KoBeWi/following{/other_user}","gists_url":"https://api.github.com/users/KoBeWi/gists{/gist_id}","starred_url":"https://api.github.com/users/KoBeWi/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/KoBeWi/subscriptions","organizations_url":"https://api.github.com/users/KoBeWi/orgs","repos_url":"https://api.github.com/users/KoBeWi/repos","events_url":"https://api.github.com/users/KoBeWi/events{/privacy}","received_events_url":"https://api.github.com/users/KoBeWi/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2024-12-12T21:52:01Z","updated_at":"2024-12-12T21:52:01Z","body":"The basic functionality still works and the code changes look fine overall.\r\nhttps://github.com/godotengine/godot/pull/99439#discussion_r1882871935 is the only major problem.","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2540084410/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2541086235","html_url":"https://github.com/godotengine/godot/pull/99439#issuecomment-2541086235","issue_url":"https://api.github.com/repos/godotengine/godot/issues/99439","id":2541086235,"node_id":"IC_kwDOAO6SJc6XdeYb","user":{"login":"aXu-AP","id":1621768,"node_id":"MDQ6VXNlcjE2MjE3Njg=","avatar_url":"https://avatars.githubusercontent.com/u/1621768?v=4","gravatar_id":"","url":"https://api.github.com/users/aXu-AP","html_url":"https://github.com/aXu-AP","followers_url":"https://api.github.com/users/aXu-AP/followers","following_url":"https://api.github.com/users/aXu-AP/following{/other_user}","gists_url":"https://api.github.com/users/aXu-AP/gists{/gist_id}","starred_url":"https://api.github.com/users/aXu-AP/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/aXu-AP/subscriptions","organizations_url":"https://api.github.com/users/aXu-AP/orgs","repos_url":"https://api.github.com/users/aXu-AP/repos","events_url":"https://api.github.com/users/aXu-AP/events{/privacy}","received_events_url":"https://api.github.com/users/aXu-AP/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2024-12-13T10:14:08Z","updated_at":"2024-12-13T10:14:08Z","body":"Thanks for the review, I think I can icorporate the feedback tomorrow.\r\n\r\n> With this you also changed default mode to Points. Is this the usual workflow? I only ever used UV editor to edit UV tbh.\r\n\r\nThe workflow of course depends on what we are doing. Some times UV editor is the one I need, some times other tabs, so I don't have strong preference on one over the other. I just felt that this order makes more sense and by default open the first tab.\r\nHere's 2 things I mostly use Polygon2D for:\r\n* Cutout animation\r\n    * Here the first step is to create the polygon of the part we need from a spritesheet (ie. Points tab or automatic conversion from a sprite).\r\n    * Add inner points around joints and define polygons (Points, Polygons tabs). (a side note, this is a quite painful workflow, I have something better in mind and will make a few proposals for that).\r\n    * Do weight painting (Bones tab).\r\n* Textured environments\r\n    * Here I create the polygon directly in the scene as it needs to be in relation to the level.\r\n    * Adjust uvs (UV tab)\r\n\r\nI'd be interested in hearing what others are using the node and the editor for as I want to continue improving the editor. (See https://github.com/godotengine/godot-proposals/discussions/4118)","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2541086235/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2543969063","html_url":"https://github.com/godotengine/godot/pull/99439#issuecomment-2543969063","issue_url":"https://api.github.com/repos/godotengine/godot/issues/99439","id":2543969063,"node_id":"IC_kwDOAO6SJc6XoeMn","user":{"login":"aXu-AP","id":1621768,"node_id":"MDQ6VXNlcjE2MjE3Njg=","avatar_url":"https://avatars.githubusercontent.com/u/1621768?v=4","gravatar_id":"","url":"https://api.github.com/users/aXu-AP","html_url":"https://github.com/aXu-AP","followers_url":"https://api.github.com/users/aXu-AP/followers","following_url":"https://api.github.com/users/aXu-AP/following{/other_user}","gists_url":"https://api.github.com/users/aXu-AP/gists{/gist_id}","starred_url":"https://api.github.com/users/aXu-AP/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/aXu-AP/subscriptions","organizations_url":"https://api.github.com/users/aXu-AP/orgs","repos_url":"https://api.github.com/users/aXu-AP/repos","events_url":"https://api.github.com/users/aXu-AP/events{/privacy}","received_events_url":"https://api.github.com/users/aXu-AP/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2024-12-15T17:33:23Z","updated_at":"2024-12-15T17:33:23Z","body":"I made the requested changes. I managed to solve the one frame late view adjustment by recentering the view as many times as the canvas gets drawn in that frame. I'm not proud of that, feels hacky, but it seems to work reliably.","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2543969063/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2569651009","html_url":"https://github.com/godotengine/godot/pull/99439#issuecomment-2569651009","issue_url":"https://api.github.com/repos/godotengine/godot/issues/99439","id":2569651009,"node_id":"IC_kwDOAO6SJc6ZKcNB","user":{"login":"KoBeWi","id":2223172,"node_id":"MDQ6VXNlcjIyMjMxNzI=","avatar_url":"https://avatars.githubusercontent.com/u/2223172?v=4","gravatar_id":"","url":"https://api.github.com/users/KoBeWi","html_url":"https://github.com/KoBeWi","followers_url":"https://api.github.com/users/KoBeWi/followers","following_url":"https://