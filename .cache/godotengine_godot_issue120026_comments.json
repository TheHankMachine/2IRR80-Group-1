.github.com/users/KryieNaruto/repos","events_url":"https://api.github.com/users/KryieNaruto/events{/privacy}","received_events_url":"https://api.github.com/users/KryieNaruto/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-06-05T09:44:12Z","updated_at":"2026-06-05T09:50:09Z","body":"updated","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4630180967/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":{"reason":"resolved"}},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4631490771","html_url":"https://github.com/godotengine/godot/issues/120026#issuecomment-4631490771","issue_url":"https://api.github.com/repos/godotengine/godot/issues/120026","id":4631490771,"node_id":"IC_kwDOAO6SJc8AAAABFA7w0w","user":{"login":"Cyklon3000","id":67823272,"node_id":"MDQ6VXNlcjY3ODIzMjcy","avatar_url":"https://avatars.githubusercontent.com/u/67823272?v=4","gravatar_id":"","url":"https://api.github.com/users/Cyklon3000","html_url":"https://github.com/Cyklon3000","followers_url":"https://api.github.com/users/Cyklon3000/followers","following_url":"https://api.github.com/users/Cyklon3000/following{/other_user}","gists_url":"https://api.github.com/users/Cyklon3000/gists{/gist_id}","starred_url":"https://api.github.com/users/Cyklon3000/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Cyklon3000/subscriptions","organizations_url":"https://api.github.com/users/Cyklon3000/orgs","repos_url":"https://api.github.com/users/Cyklon3000/repos","events_url":"https://api.github.com/users/Cyklon3000/events{/privacy}","received_events_url":"https://api.github.com/users/Cyklon3000/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-06-05T12:21:32Z","updated_at":"2026-06-05T12:21:32Z","body":"When setting this up to reproduce make sure to increase the suns energy, otherwise you will observe a \"dark streak\" instead.\n\nI believe this is works as intended. \nThe streak we are seeing is the procedural sky texture rendering the sun as a \"bright spot that hurts my eyes\". The reason why it renders as a streak is due to the way the orthogonal camera renders sky textures; distorting them is required.\n\n<img width=\"500\" height=\"250\" alt=\"Image\" src=\"https://github.com/user-attachments/assets/f9966863-3119-4b76-a9ca-b8846b59650d\" />\n\n<img width=\"500\" height=\"250\" alt=\"Image\" src=\"https://github.com/user-attachments/assets/e4af348c-b7f5-43e6-83a1-271151e31a6d\" />\n\nIf you are trying to prevent this \"artifact\" from showing up, try adding the WorldEnvironment Node to your scene and in the `environment` set `sky` > `sky_material` > `sun_angle_max` to `0.0` to prevent the sky from rendering in the \"bright spot that hurts my eyes\".","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4631490771/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4632897089","html_url":"https://github.com/godotengine/godot/issues/120026#issuecomment-4632897089","issue_url":"https://api.github.com/repos/godotengine/godot/issues/120026","id":4632897089,"node_id":"IC_kwDOAO6SJc8AAAABFCRmQQ","user":{"login":"Calinou","id":180032,"node_id":"MDQ6VXNlcjE4MDAzMg==","avatar_url":"https://avatars.githubusercontent.com/u/180032?v=4","gravatar_id":"","url":"https://api.github.com/users/Calinou","html_url":"https://github.com/Calinou","followers_url":"https://api.github.com/users/Calinou/followers","following_url":"https://api.github.com/users/Calinou/following{/other_user}","gists_url":"https://api.github.com/users/Calinou/gists{/gist_id}","starred_url":"https://api.github.com/users/Calinou/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Calinou/subscriptions","organizations_url":"https://api.github.com/users/Calinou/orgs","repos_url":"https://api.github.com/users/Calinou/repos","events_url":"https://api.github.com/users/Calinou/events{/privacy}","received_events_url":"https://api.github.com/users/Calinou/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-06-05T15:01:53Z","updated_at":"2026-06-05T15:12:37Z","body":"Thanks for the report! Consolidating in https://github.com/godotengine/godot/issues/23077.\n\nThe sky is rendered like this by default when using an orthographic camera. You can force a specific field of view for the background sky by changing `sky_custom_fov` in the Environment resource (after creating a WorldEnvironment node).\n\nhttps://github.com/godotengine/godot/pull/120032 addresses this issue out of the box.","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4632897089/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null}]