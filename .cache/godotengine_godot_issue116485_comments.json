Q4","avatar_url":"https://avatars.githubusercontent.com/u/82884848?v=4","gravatar_id":"","url":"https://api.github.com/users/Quatumus","html_url":"https://github.com/Quatumus","followers_url":"https://api.github.com/users/Quatumus/followers","following_url":"https://api.github.com/users/Quatumus/following{/other_user}","gists_url":"https://api.github.com/users/Quatumus/gists{/gist_id}","starred_url":"https://api.github.com/users/Quatumus/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Quatumus/subscriptions","organizations_url":"https://api.github.com/users/Quatumus/orgs","repos_url":"https://api.github.com/users/Quatumus/repos","events_url":"https://api.github.com/users/Quatumus/events{/privacy}","received_events_url":"https://api.github.com/users/Quatumus/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-09-06T22:12:20Z","updated_at":"2026-09-06T22:58:28Z","body":"Added that and also made it possible to rotate the tab style side to any side not just top or bottom","author_association":"NONE","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5562541689/reactions","total_count":7,"+1":2,"-1":0,"laugh":0,"hooray":3,"confused":0,"heart":0,"rocket":0,"eyes":2},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5650115691","html_url":"https://github.com/godotengine/godot/pull/116485#issuecomment-5650115691","issue_url":"https://api.github.com/repos/godotengine/godot/issues/116485","id":5650115691,"node_id":"IC_kwDOAO6SJc8AAAABUMXsaw","user":{"login":"Quatumus","id":82884848,"node_id":"MDQ6VXNlcjgyODg0ODQ4","avatar_url":"https://avatars.githubusercontent.com/u/82884848?v=4","gravatar_id":"","url":"https://api.github.com/users/Quatumus","html_url":"https://github.com/Quatumus","followers_url":"https://api.github.com/users/Quatumus/followers","following_url":"https://api.github.com/users/Quatumus/following{/other_user}","gists_url":"https://api.github.com/users/Quatumus/gists{/gist_id}","starred_url":"https://api.github.com/users/Quatumus/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Quatumus/subscriptions","organizations_url":"https://api.github.com/users/Quatumus/orgs","repos_url":"https://api.github.com/users/Quatumus/repos","events_url":"https://api.github.com/users/Quatumus/events{/privacy}","received_events_url":"https://api.github.com/users/Quatumus/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-09-13T02:04:45Z","updated_at":"2026-09-13T02:05:56Z","body":"I seem to be unable to reproduce the issue with horizontal minimum size. For me enabling clip tabs allows me to set the minimum size lower.\r\n\r\nDid you have a custom max size set? I'm remembering that having a custom max size should always extend the tabs as much as possible but I could be wrong on that.\r\n\r\n<img width=\"387\" height=\"197\" alt=\"kuva\" src=\"https://github.com/user-attachments/assets/e2703085-66c9-4c4e-b5f7-0f78f7edddad\" />\r\n\r\nThese `TabBars` are at their minimum sizes from top to bottom:\r\n1. clip tabs only\r\n2. clip tabs + custom max size larger than required to display all tabs\r\n3. no clip tabs","author_association":"NONE","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5650115691/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5655657007","html_url":"https://github.com/godotengine/godot/pull/116485#issuecomment-5655657007","issue_url":"https://api.github.com/repos/godotengine/godot/issues/116485","id":5655657007,"node_id":"IC_kwDOAO6SJc8AAAABURp6Lw","user":{"login":"StarryWorm","id":41305715,"node_id":"MDQ6VXNlcjQxMzA1NzE1","avatar_url":"https://avatars.githubusercontent.com/u/41305715?v=4","gravatar_id":"","url":"https://api.github.com/users/StarryWorm","html_url":"https://github.com/StarryWorm","followers_url":"https://api.github.com/users/StarryWorm/followers","following_url":"https://api.github.com/users/StarryWorm/following{/other_user}","gists_url":"https://api.github.com/users/StarryWorm/gists{/gist_id}","starred_url":"https://api.github.com/users/StarryWorm/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/StarryWorm/subscriptions","organizations_url":"https://api.github.com/users/StarryWorm/orgs","repos_url":"https://api.github.com/users/StarryWorm/repos","events_url":"https://api.github.com/users/StarryWorm/events{/privacy}","received_events_url":"https://api.github.com/users/StarryWorm/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-09-13T19:45:08Z","updated_at":"2026-09-13T19:45:08Z","body":"Well, that explains it. \r\nThe minimum size (in clip tabs) shouldn't increase based on the maximum size; only the desired size should increase. You can see the correct behavior on `master`. \r\n\r\nI understand where the confusion is coming from: the old behavior, as it was after #116640 was merged but before #118651, was based on increasing the minimum size. With the latter PR, we have since gone back to not touching the minimum size (which makes sense conceptually; after all, its smallest workable size doesn't change based on its largest allowed size), but instead increasing the desired size only. I mentioned this [when it changed](https://github.com/godotengine/godot/pull/116485#issuecomment-4401903270) [and here too](https://github.com/godotengine/godot/pull/116485#pullrequestreview-4428769159).\r\n\r\nI couldn't reproduce it in vertical mode because I didn't have a max height set; otherwise, the same issue happens in vertical mode. \r\n\r\nIf you have any more questions, please feel free to ask. This PR is shaping up to be quite a wonderful addition.","author_associa