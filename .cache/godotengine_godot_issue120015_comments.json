rs.githubusercontent.com/u/96648715?v=4","gravatar_id":"","url":"https://api.github.com/users/AThousandShips","html_url":"https://github.com/AThousandShips","followers_url":"https://api.github.com/users/AThousandShips/followers","following_url":"https://api.github.com/users/AThousandShips/following{/other_user}","gists_url":"https://api.github.com/users/AThousandShips/gists{/gist_id}","starred_url":"https://api.github.com/users/AThousandShips/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/AThousandShips/subscriptions","organizations_url":"https://api.github.com/users/AThousandShips/orgs","repos_url":"https://api.github.com/users/AThousandShips/repos","events_url":"https://api.github.com/users/AThousandShips/events{/privacy}","received_events_url":"https://api.github.com/users/AThousandShips/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-06-05T09:08:37Z","updated_at":"2026-06-05T09:08:37Z","body":"What happens if you change a `CircleShape2D` for example? Modifying nodes is different from modifying resources","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4629912503/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4630193052","html_url":"https://github.com/godotengine/godot/issues/120015#issuecomment-4630193052","issue_url":"https://api.github.com/repos/godotengine/godot/issues/120015","id":4630193052,"node_id":"IC_kwDOAO6SJc8AAAABE_sjnA","user":{"login":"EMBYRDEV","id":20043270,"node_id":"MDQ6VXNlcjIwMDQzMjcw","avatar_url":"https://avatars.githubusercontent.com/u/20043270?v=4","gravatar_id":"","url":"https://api.github.com/users/EMBYRDEV","html_url":"https://github.com/EMBYRDEV","followers_url":"https://api.github.com/users/EMBYRDEV/followers","following_url":"https://api.github.com/users/EMBYRDEV/following{/other_user}","gists_url":"https://api.github.com/users/EMBYRDEV/gists{/gist_id}","starred_url":"https://api.github.com/users/EMBYRDEV/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/EMBYRDEV/subscriptions","organizations_url":"https://api.github.com/users/EMBYRDEV/orgs","repos_url":"https://api.github.com/users/EMBYRDEV/repos","events_url":"https://api.github.com/users/EMBYRDEV/events{/privacy}","received_events_url":"https://api.github.com/users/EMBYRDEV/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-06-05T09:46:03Z","updated_at":"2026-06-05T09:46:03Z","body":"Yeah I would expect resources to be shared internally, that makes sense and is consistent.\n\n`MultiplayerSynchronizer` isn't obviously a resource (I understand it might be backed by one but this isn't evident in the editor) so this seems unintuitive.\n\nI assume the intended fix with your solution would be to add a second synchronizer in the child scene but this seems wasteful? ","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4630193052/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4630227189","html_url":"https://github.com/godotengine/godot/issues/120015#issuecomment-4630227189","issue_url":"https://api.github.com/repos/godotengine/godot/issues/120015","id":4630227189,"node_id":"IC_kwDOAO6SJc8AAAABE_uo9Q","user":{"login":"AThousandShips","id":96648715,"node_id":"U_kgDOBcK-Cw","avatar_url":"https://avatars.githubusercontent.com/u/96648715?v=4","gravatar_id":"","url":"https://api.github.com/users/AThousandShips","html_url":"https://github.com/AThousandShips","followers_url":"https://api.github.com/users/AThousandShips/followers","following_url":"https://api.github.com/users/AThousandShips/following{/other_user}","gists_url":"https://api.github.com/users/AThousandShips/gists{/gist_id}","starred_url":"https://api.github.com/users/AThousandShips/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/AThousandShips/subscriptions","organizations_url":"https://api.github.com/users/AThousandShips/orgs","repos_url":"https://api.github.com/users/AThousandShips/repos","events_url":"https://api.github.com/users/AThousandShips/events{/privacy}","received_events_url":"https://api.github.com/users/AThousandShips/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-06-05T09:49:38Z","updated_at":"2026-06-05T09:49:38Z","body":"It is a resource internally, using `SceneReplicationConfig`\n\nIt is an edge case though and has had various issues associated with it:\n* https://github.com/godotengine/godot/issues/84793\n* https://github.com/godotengine/godot/issues/74381\n* https://github.com/godotengine/godot/issues/80717","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4630227189/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4630604364","html_url":"https://github.com/godotengine/godot/issues/120015#issuecomment-4630604364","issue_url":"https://api.github.com/repos/godotengine/godot/issues/120015","id":4630604364,"node_id":"IC_kwDOAO6SJc8AAAABFAFqTA","user":{"login":"EMBYRDEV","id":20043270,"node_id":"MDQ6VXNlcjIwMDQzMjcw","avatar_url":"https://avatars.githubusercontent.com/u/20043270?v=4","gravatar_id":"","url":"https://api.github.com/users/EMBYRDEV","html_url":"https://github.com/EMBYRDEV","followers_url":"https://api.github.com/users/EMBYRDEV/followers","following_url":"https://api.github.com/users/EMBYRDEV/following{/other_user}","gists_url":"https://api.github.com/users/EMBYRDEV/gists{/gist_id}","starred_url":"https://api.github.com/users/EMBYRDEV/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/EMBYRDEV/subscriptions","organizations_url":"https://api.github.com/users/EMBYRDEV/orgs","repos_url":"https://api.github.com/users/EMBYRDEV/repos","events_url":"https://api.github.com/users/EMBYRDEV/events{/privacy}","received_events_url":"https://api.github.com/users/EMBYRDEV/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-06-05T10:35:08Z","updated_at":"2026-06-05T10:36:12Z","body":"I'm personally against this being read-only since that stops us from disabling replicated properties on the base scene, it's a rare edge case but I can see a few reasons.\n\nFor example the base scene might make use of normal position replication but the inherited class might do some sort of movement prediction. Imagine a basic character class and an extended class for players and the players use the more involved replication setup.\n\nI personally think that the decision for the config to be a resource causes more issues than it's worth and could probably be solved by storing it internally as an array of arrays but that's a fairly big refactor.","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4630604364/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4630618935","html_url":"https://github.com/godotengine/godot/issues/120015#issuecomment-4630618935","issue_url":"https://api.github.com/repos/godotengine/godot/issues/120015","id":4630618935,"node_id":"IC_kwDOAO6SJc8AAAABFAGjNw","user":{"login":"AThousandShips","id":96648715,"node_id":"U_kgDOBcK-Cw","avatar_url":"https://avatars.githubusercontent.com/u/96648715?v=4","gravatar_id":"","url":"https://api.github.com/users/AThousandShips","html_url":"https://github.com/AThousandShips","followers_url":"https://api.github.com/users/AThousandShips/followers","following_url":"https://api.github.com/users/AThousandShips/following{/other_user}","gists_url":"https://api.github.com/users/AThousandShips/gists{/gist_id}","starred_url":"https://api.github.com/users/AThousandShips/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/AThousandShips/subscriptions","organizations_url":"https://api.github.com/users/AThousandShips/orgs","repos_url":"https://api.github.com/users/AThousandShips/repos","events_url":"https://api.github.com/users/AThousandShips/events{/privacy}","received_events_url":"https://api.github.com/users/AThousandShips/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-06-05T10:37:36Z","updated_at":"2026-06-05T10:37:36Z","body":"> I personally think that the decision for the config to be a resource causes more issues than it's worth and could probably be solved by storing it internally as an array of arrays but that's a fairly big refactor.\n\nThat wouldn't be possible at all in 4.x though so not really an option here\n\nHaving it be local to the scene in a more direct way to not share with the base would probably be the most practical, would have to evaluate how it impacts compatibility and other factors though","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4630618935/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4654508751","html_url":"https://github.com/godotengine/godot/issues/120015#issuecomment-4654508751","issue_url":"https://api.github.com/repos/godotengine/godot/issues/120015","id":4654508751,"node_id":"IC_kwDOAO6SJc8AAAABFW4qzw","user":{"login":"EMBYRDEV","id":20043270,"node_id":"MDQ6VXNlcjIwMDQzMjcw","avatar_url":"https://avatars.githubusercontent.com/u/20043270?v=4","gravatar_id":"","url":"https://api.github.com/users/EMBYRDEV","html_url":"https://github.com/EMBYRDEV","followers_url":"https://api.github.com/users/EMBYRDEV/followers","following_url":"https://api.github.com/users/EMBYRDEV/following{/other_user}","gists_url":"https://api.github.com/users/EMBYRDEV/gists{/gist_id}","starred_url":"https://api.github.com/users/EMBYRDEV/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/EMBYRDEV/subscriptions","organizations_url":"https://api.github.com/users/EMBYRDEV/orgs","repos_url":"https://api.github.com/users/EMBYRDEV/repos","events_url":"https://api.github.com/users/EMBYRDEV/events{/privacy}","received_events_url":"https://api.github.com/users/EMBYRDEV/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-06-08T23:35:55Z","updated_at":"2026-06-08T23:35:55Z","body":"Whilst having the ability to make the config unique and edit it in child scenes completely disconnected from the base scene is a bit of a hack I do think that it would be more desired behavior than what currently happens. ","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4654508751/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null}]