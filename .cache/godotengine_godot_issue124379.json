ived_at":null,"archived_by":null},{"id":279098255,"node_id":"MDU6TGFiZWwyNzkwOTgyNTU=","url":"https://api.github.com/repos/godotengine/godot/labels/topic:platforms","name":"topic:platforms","color":"ffee88","default":false,"description":"","archived_at":null,"archived_by":null}],"state":"closed","locked":false,"assignees":[],"milestone":{"url":"https://api.github.com/repos/godotengine/godot/milestones/25","html_url":"https://github.com/godotengine/godot/milestone/25","labels_url":"https://api.github.com/repos/godotengine/godot/milestones/25/labels","id":15520464,"node_id":"MI_kwDOAO6SJc4A7NLQ","number":25,"title":"4.8","description":"","creator":{"login":"Repiteo","id":17489292,"node_id":"MDQ6VXNlcjE3NDg5Mjky","avatar_url":"https://avatars.githubusercontent.com/u/17489292?v=4","gravatar_id":"","url":"https://api.github.com/users/Repiteo","html_url":"https://github.com/Repiteo","followers_url":"https://api.github.com/users/Repiteo/followers","following_url":"https://api.github.com/users/Repiteo/following{/other_user}","gists_url":"https://api.github.com/users/Repiteo/gists{/gist_id}","starred_url":"https://api.github.com/users/Repiteo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Repiteo/subscriptions","organizations_url":"https://api.github.com/users/Repiteo/orgs","repos_url":"https://api.github.com/users/Repiteo/repos","events_url":"https://api.github.com/users/Repiteo/events{/privacy}","received_events_url":"https://api.github.com/users/Repiteo/received_events","type":"User","user_view_type":"public","site_admin":false},"open_issues":345,"closed_issues":2336,"state":"open","created_at":"2026-04-13T15:59:35Z","updated_at":"2026-10-22T08:21:32Z","due_on":null,"closed_at":null},"comments":0,"created_at":"2026-10-11T14:44:53Z","updated_at":"2026-10-19T16:51:04Z","closed_at":"2026-10-19T16:51:04Z","assignee":null,"author_association":"NONE","issue_field_values":[],"type":null,"active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"### Tested versions\n\n4.7.2.stable\n\n### System information\n\nExported with official 4.7.2 on macOS 15 / Xcode 26.4.1, installed through TestFlight. iPhone X, iOS 16.7.12, Compatibility renderer.\n\n### Issue description\n\nI set a custom splash image and left Project Settings > Application > Boot Splash > [Stretch Mode](https://docs.godotengine.org/en/stable/classes/class_projectsettings.html#class-projectsettings-property-application-boot-splash-stretch-mode) on the default, \"Keep\", expecting the image to scale to fit the screen.\n\nInstead it shows at its own size, small in the middle of the screen, for the whole splash.\n\nThe iOS export preset has a [Storyboard > Image Scale Mode](https://docs.godotengine.org/en/stable/classes/class_editorexportplatformios.html#class-editorexportplatformios-property-storyboard-image-scale-mode) option (\"Same as Logo\", \"Center\", \"Scale to Fit\", \"Scale to Fill\", \"Scale\"). It defaults to \"Same as Logo\", which I think should follow the Stretch Mode but doesn't anymore. If I change it to \"Scale to Fit\" the splash looks right, so that works as a workaround for now.\n\nThe export also prints `WARNING: Property not found: application/boot_splash/fullsize`, and that setting was removed in 4.6:\n\nhttps://github.com/godotengine/godot/blob/232e6b14abf6e590b41d60f11704e42de22bff72/platform/ios/export/export_plugin.cpp#L317\n\n\n<table>\n  <tr><th>\"Same as Logo\" (default)</th><th>\"Scale to Fit\"</th></tr>\n  <tr>\n <td><video src=\"https://github.com/user-attachments/assets/95cb90c9-8c1c-474e-8ea8-5ee1d2e02c7c\" controls \n  width=\"300\"></video></td>\n<td><video src=\"https://github.com/user-attachments/assets/dfeea85d-580c-4bd6-8a18-e99a8c78d2af\" controls \n  width=\"300\"></video></td>\n  </tr>\n  </table>\n\n\n\n### Steps to reproduce\n\n1. Set `application/boot_splash/image` to an image (MRP has a 600x600 one)\n2. Export to iOS and run on a device\n3. Splash image is small in the middle instead of scaled to fit\n\n\n### Minimal reproduction project (MRP)\n\n[splash-mode-mrp.zip](https://github.com/user-attachments/files/33305327/splash-mode-mrp.zip)","closed_by":{"login":"Repiteo","id":17489292,"node_id":"MDQ6VXNlcjE3NDg5Mjky","avatar_url":"https://avatars.githubusercontent.com/u/17489292?v=4","gravatar_id":"","url":"https://api.github.com/users/Repiteo","html_url":"https://github.com/Repiteo","followers_url":"https://api.github.com/users/Repiteo/followers","following_url":"https://api.github.com/users/Repiteo/following{/other_user}","gists_url":"https://api.github.com/users/Repiteo/gists{/gist_id}","starred_url":"https://api.github.com/users/Repiteo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Repiteo/subscriptions","organizations_url":"https://api.github.com/users/Repiteo/orgs","repos_url":"https://api.github.com/users/Repiteo/repos","events_url":"https://api.github.com/users/Repiteo/events{/privacy}","received_events_url":"https://api.github.com/users/Repiteo/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/124379/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/godotengine/godot/issues/124379/timeline","performed_via_github_app":null,"state_reason":"completed","pinned_comment":null}