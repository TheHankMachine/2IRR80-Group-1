[{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3711755331","html_url":"https://github.com/godotengine/godot/pull/113743#issuecomment-3711755331","issue_url":"https://api.github.com/repos/godotengine/godot/issues/113743","id":3711755331,"node_id":"IC_kwDOAO6SJc7dPORD","user":{"login":"dsnopek","id":191561,"node_id":"MDQ6VXNlcjE5MTU2MQ==","avatar_url":"https://avatars.githubusercontent.com/u/191561?v=4","gravatar_id":"","url":"https://api.github.com/users/dsnopek","html_url":"https://github.com/dsnopek","followers_url":"https://api.github.com/users/dsnopek/followers","following_url":"https://api.github.com/users/dsnopek/following{/other_user}","gists_url":"https://api.github.com/users/dsnopek/gists{/gist_id}","starred_url":"https://api.github.com/users/dsnopek/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/dsnopek/subscriptions","organizations_url":"https://api.github.com/users/dsnopek/orgs","repos_url":"https://api.github.com/users/dsnopek/repos","events_url":"https://api.github.com/users/dsnopek/events{/privacy}","received_events_url":"https://api.github.com/users/dsnopek/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-01-05T19:14:02Z","updated_at":"2026-01-05T19:14:02Z","body":"> On one hand, unless there's a **very** good reason to do so, we should be using C++ instead of C. This would allow using the godot-cpp helper methods directly, which I think should be encouraged for any GDExtension test. On the other hand, this _is_ meant to be as minimal as possible, so maybe the specialized setup is warranted here?\r\n\r\nPersonally, I think using C (or at least not using godot-cpp) here is the right choice. If this test used godot-cpp, it wouldn't really use any of its helpers (maybe just loading the interface functions?), and would still be implemented pretty much the exact same way as it is now. All we would get is slower build times and the potential for godot-cpp changes/bugs to break the test.","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3711755331/reactions","total_count":4,"+1":4,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3860755923","html_url":"https://github.com/godotengine/godot/pull/113743#issuecomment-3860755923","issue_url":"https://api.github.com/repos/godotengine/godot/issues/113743","id":3860755923,"node_id":"IC_kwDOAO6SJc7mHnXT","user":{"login":"Repiteo","id":17489292,"node_id":"MDQ6VXNlcjE3NDg5Mjky","avatar_url":"https://avatars.githubusercontent.com/u/17489292?v=4","gravatar_id":"","url":"https://api.github.com/users/Repiteo","html_url":"https://github.com/Repiteo","followers_url":"https://api.github.com/users/Repiteo/followers","following_url":"https://api.github.com/users/Repiteo/following{/other_user}","gists_url":"https://api.github.com/users/Repiteo/gists{/gist_id}","starred_url":"https://api.github.com/users/Repiteo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Repiteo/subscriptions","organizations_url":"https://api.github.com/users/Repiteo/orgs","repos_url":"https://api.github.com/users/Repiteo/repos","events_url":"https://api.github.com/users/Repiteo/events{/privacy}","received_events_url":"https://api.github.com/users/Repiteo/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-02-06T14:23:38Z","updated_at":"2026-02-06T14:23:38Z","body":"Thanks!","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3860755923/reactions","total_count":3,"+1":0,"-1":0,"laugh":0,"hooray":3,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null}]