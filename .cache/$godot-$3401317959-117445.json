[{"id":3955887246,"node_id":"PRR_kwDOAO6SJc7rygyO","state":"COMMENTED","user":{"site_admin":false,"suspended":false,"updated_at":"0001-01-01T00:00:00Z","avatar_url":"https://avatars.githubusercontent.com/u/180032?u=68d23e7ee9cdf810da125e8510b72f845b9dccc8&v=4","created_at":"0001-01-01T00:00:00Z","followers":0,"following":0,"html_url":"https://github.com/Calinou","id":180032,"node_id":"MDQ6VXNlcjE4MDAzMg==","login":"Calinou","type":"User","owned_private_repos":0,"public_gists":0,"public_repos":0,"total_private_repos":0,"url":"https://api.github.com/users/Calinou"},"body":"Tested locally on Linux + WINE, it works as expected.\n\nI've seen very little use of dynamically linked ANGLE in Godot projects in the wild, so I agree with this change.\n\nNote that this is a \"soft dependency\", and compilation will continue with ANGLE disabled if the libraries haven't been downloaded. This is similar to AccessKit, but different from Direct3D 12 which will abort compilation unless you pass `d3d12=no` explicitly. I think this makes sense considered Compatibility isn't used as often as Forward+/Mobile on desktop, but maybe there is an argument to making it a hard dependency like D3D12 (with `angle=no` needing to be explicitly passed if missing).","html_url":"https://github.com/godotengine/godot/pull/117445#pullrequestreview-3955887246","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/117445","author_association":"MEMBER","submitted_at":"2026-03-16T19:05:11Z"},{"id":3956065134,"node_id":"PRR_kwDOAO6SJc7rzMNu","state":"COMMENTED","user":{"site_admin":false,"suspended":false,"updated_at":"0001-01-01T00:00:00Z","avatar_url":"https://avatars.githubusercontent.com/u/7645683?u=2867ee7fcd920bc19b7d1cbf4b10264b9bbc9326&v=4","created_at":"0001-01-01T00:00:00Z","followers":0,"following":0,"html_url":"https://github.com/bruvzg","id":7645683,"node_id":"MDQ6VXNlcjc2NDU2ODM=","login":"bruvzg","type":"User","owned_private_repos":0,"public_gists":0,"public_repos":0,"total_pr