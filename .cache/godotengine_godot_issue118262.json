hived_by":null},{"id":1752040694,"node_id":"MDU6TGFiZWwxNzUyMDQwNjk0","url":"https://api.github.com/repos/godotengine/godot/labels/topic:navigation","name":"topic:navigation","color":"ffee88","default":false,"description":"","archived_at":null,"archived_by":null},{"id":2666708289,"node_id":"MDU6TGFiZWwyNjY2NzA4Mjg5","url":"https://api.github.com/repos/godotengine/godot/labels/topic:3d","name":"topic:3d","color":"ffee88","default":false,"description":"","archived_at":null,"archived_by":null}],"state":"closed","locked":false,"assignees":[],"milestone":null,"comments":1,"created_at":"2026-04-06T21:47:34Z","updated_at":"2026-04-16T21:12:22Z","closed_at":"2026-04-16T20:47:57Z","assignee":null,"author_association":"NONE","issue_field_values":[],"type":null,"active_lock_reason":null,"draft":false,"pull_request":{"url":"https://api.github.com/repos/godotengine/godot/pulls/118262","html_url":"https://github.com/godotengine/godot/pull/118262","diff_url":"https://github.com/godotengine/godot/pull/118262.diff","patch_url":"https://github.com/godotengine/godot/pull/118262.patch","merged_at":null},"body":"Fixes #117138\r\n\r\nThe navigation link connection function previously did not consider the navigation layers when deciding which regions to connect. Because only one connection is made per link, this could result in links not working in scenarios with multiple overlapping regions.\r\n\r\nThis commit skips regions that don't match the link's navigation layers. Because there is still only one connection made per link, it is the user's responsibility to make sure all links represent one-to-one relationships between regions. A note to that effect has been added to the navigation link class documentation.\r\n\r\nThe test cases test a scenario with 2 regions on different layers and nav links with layer 2 set. Pathfinding across floating platforms should fail on layer 1 and succeed on layer 2.\r\n\r\n<!--\r\nPlease target the `master` branch. We will take care of backporting relevant fixes to older versions.\r\n\r\nBefore submitting, please read our checklist for new contributors:\r\nhttps://contributing.godotengine.org/en/latest/engine/introduction.html#checklist-for-new-contributors\r\n-->\r\n","closed_by":{"login":"BManx2000","id":13679655,"node_id":"MDQ6VXNlcjEzNjc5NjU1","avatar_url":"https://avatars.githubusercontent.com/u/13679655?v=4","gravatar_id":"","url":"https://api.github.com/users/BManx2000","html_url":"https://github.com/BManx2000","followers_url":"https://api.github.com/users/BManx2000/followers","following_url":"https://api.github.com/users/BManx2000/following{/other_user}","gists_url":"https://api.github.com/users/BManx2000/gists{/gist_id}","starred_url":"https://api.github.com/users/BManx2000/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/BManx2000/subscriptions","organizations_url":"https://api.github.com/users/BManx2000/orgs","repos_url":"https://api.github.com/users/BManx2000/repos","events_url":"https://api.github.com/users/BManx2000/events{/privacy}","received_events_url":"https://api.github.com/users/BManx2000/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/118262/reactions","total_count":2,"+1":1,"-1":0,"laugh":0,"hooray":1,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/godotengine/godot/issues/118262/timeline","performed_via_github_app":null,"state_reason":null}