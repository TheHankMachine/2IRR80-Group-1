by":null},{"id":2666708289,"node_id":"MDU6TGFiZWwyNjY2NzA4Mjg5","url":"https://api.github.com/repos/godotengine/godot/labels/topic:3d","name":"topic:3d","color":"ffee88","default":false,"description":"","archived_at":null,"archived_by":null},{"id":3240950060,"node_id":"MDU6TGFiZWwzMjQwOTUwMDYw","url":"https://api.github.com/repos/godotengine/godot/labels/performance","name":"performance","color":"447777","default":false,"description":"","archived_at":null,"archived_by":null}],"state":"closed","locked":false,"assignees":[],"milestone":{"url":"https://api.github.com/repos/godotengine/godot/milestones/22","html_url":"https://github.com/godotengine/godot/milestone/22","labels_url":"https://api.github.com/repos/godotengine/godot/milestones/22/labels","id":12070367,"node_id":"MI_kwDOAO6SJc4AuC3f","number":22,"title":"4.5","description":"","creator":{"login":"Sauermann","id":6299227,"node_id":"MDQ6VXNlcjYyOTkyMjc=","avatar_url":"https://avatars.githubusercontent.com/u/6299227?v=4","gravatar_id":"","url":"https://api.github.com/users/Sauermann","html_url":"https://github.com/Sauermann","followers_url":"https://api.github.com/users/Sauermann/followers","following_url":"https://api.github.com/users/Sauermann/following{/other_user}","gists_url":"https://api.github.com/users/Sauermann/gists{/gist_id}","starred_url":"https://api.github.com/users/Sauermann/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Sauermann/subscriptions","organizations_url":"https://api.github.com/users/Sauermann/orgs","repos_url":"https://api.github.com/users/Sauermann/repos","events_url":"https://api.github.com/users/Sauermann/events{/privacy}","received_events_url":"https://api.github.com/users/Sauermann/received_events","type":"User","user_view_type":"public","site_admin":false},"open_issues":3,"closed_issues":3687,"state":"closed","created_at":"2024-12-19T08:51:28Z","updated_at":"2026-09-04T21:48:38Z","due_on":"2025-09-15T00:00:00Z","closed_at":"2025-09-18T17:13:14Z"},"comments":1,"created_at":"2025-03-04T02:56:38Z","updated_at":"2025-12-06T06:10:24Z","closed_at":"2025-03-09T14:11:35Z","assignee":null,"author_association":"MEMBER","issue_field_values":[],"type":null,"active_lock_reason":null,"draft":false,"pull_request":{"url":"https://api.github.com/repos/godotengine/godot/pulls/103547","html_url":"https://github.com/godotengine/godot/pull/103547","diff_url":"https://github.com/godotengine/godot/pull/103547.diff","patch_url":"https://github.com/godotengine/godot/pull/103547.patch","merged_at":"2025-03-09T14:11:35Z"},"body":"This batches together a couple of micro-optimizations that were discovered in profiling and analyzing disassembly.\r\n\r\nImportantly, this reduces the amount of instructions in a heavy loop. This has the biggest impact when there are lots of objects and lights in the scene as the function is called once per objects + once per light that touches the object\r\n\r\nSome of the changes in this PR were initially suggested by a partner of W4 Games. Those portions are donated with their permission. \r\n\r\nThis PR is humbly sponsored by [W4 Games](https://w4games.com/). 🍀\r\n\r\n### Performance\r\n\r\nI tested this extensively on Windows (with a ryzen 5 3600 CPU) using the [Legend of the Nuku Warriors demo project](https://www.youtube.com/watch?v=9kcjFJJxO6I) with shadows enabled on every light. \r\n\r\nMeasuring frame time overall we see a reduction from about 25.64 mspf to 23.25 mspf (~10%)!\r\n\r\nJust as importantly though, we can see that the compiler is able to emit far fewer instructions for the same code\r\n\r\n### Next steps\r\n\r\nI would appreciate if this could be tested on other projects and especially on other devices. The changes are very safe in terms of functionality, but they may not have the same performance benefit in other scenes. In particular, Nuku has a lot of shadows and a lot of static geometry. Scenes that have a different composition may not benefit as much. \r\n\r\n### Update\r\n\r\nImplemented the same change in the Mobile renderer and cleaned up related code. We see a similar performance benefit (~35 mspf -> 31 mspf). \r\n\r\nI would say this is ready for merging now. \r\n\r\n","closed_by":{"login":"Repiteo","id":17489292,"node_id":"MDQ6VXNlcjE3NDg5Mjky","avatar_url":"https://avatars.githubusercontent.com/u/17489292?v=4","gravatar_id":"","url":"https://api.github.com/users/Repiteo","html_url":"https://github.com/Repiteo","followers_url":"https://api.github.com/users/Repiteo/followers","following_url":"https://api.github.com/users/Repiteo/following{/other_user}","gists_url":"https://api.github.com/users/Repiteo/gists{/gist_id}","starred_url":"https://api.github.com/users/Repiteo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Repiteo/subscriptions","organizations_url":"https://api.github.com/users/Repiteo/orgs","repos_url":"https://api.github.com/users/Repiteo/repos","events_url":"https://api.github.com/users/Repiteo/events{/privacy}","received_events_url":"https://api.github.com/users/Repiteo/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/103547/reactions","total_count":13,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":13,"eyes":0},"timeline_url":"https://api.github.com/repos/godotengine/godot/issues/103547/timeline","performed_via_github_app":null,"state_reason":null}