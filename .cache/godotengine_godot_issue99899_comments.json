NzAwNDE4","avatar_url":"https://avatars.githubusercontent.com/u/47700418?v=4","gravatar_id":"","url":"https://api.github.com/users/dalexeev","html_url":"https://github.com/dalexeev","followers_url":"https://api.github.com/users/dalexeev/followers","following_url":"https://api.github.com/users/dalexeev/following{/other_user}","gists_url":"https://api.github.com/users/dalexeev/gists{/gist_id}","starred_url":"https://api.github.com/users/dalexeev/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/dalexeev/subscriptions","organizations_url":"https://api.github.com/users/dalexeev/orgs","repos_url":"https://api.github.com/users/dalexeev/repos","events_url":"https://api.github.com/users/dalexeev/events{/privacy}","received_events_url":"https://api.github.com/users/dalexeev/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-01-08T15:26:42Z","updated_at":"2025-01-08T15:26:42Z","body":"They are not deleted, they are combined into single files.","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2577953627/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2955863018","html_url":"https://github.com/godotengine/godot/pull/99899#issuecomment-2955863018","issue_url":"https://api.github.com/repos/godotengine/godot/issues/99899","id":2955863018,"node_id":"IC_kwDOAO6SJc6wLuPq","user":{"login":"vnen","id":5599796,"node_id":"MDQ6VXNlcjU1OTk3OTY=","avatar_url":"https://avatars.githubusercontent.com/u/5599796?v=4","gravatar_id":"","url":"https://api.github.com/users/vnen","html_url":"https://github.com/vnen","followers_url":"https://api.github.com/users/vnen/followers","following_url":"https://api.github.com/users/vnen/following{/other_user}","gists_url":"https://api.github.com/users/vnen/gists{/gist_id}","starred_url":"https://api.github.com/users/vnen/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/vnen/subscriptions","organizations_url":"https://api.github.com/users/vnen/orgs","repos_url":"https://api.github.com/users/vnen/repos","events_url":"https://api.github.com/users/vnen/events{/privacy}","received_events_url":"https://api.github.com/users/vnen/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-06-09T13:52:30Z","updated_at":"2025-06-09T13:52:30Z","body":"I generally prefer each file to test only one thing. Longer tests are harder to follow if they ever fail because of a change because the diff is bigger. It's also harder to see what actually is being tested.\r\n\r\nThat said, seems like merging tests creates less friction for people writing them and we definitely want more people writing tests.","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2955863018/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2956525952","html_url":"https://github.com/godotengine/godot/pull/99899#issuecomment-2956525952","issue_url":"https://api.github.com/repos/godotengine/godot/issues/99899","id":2956525952,"node_id":"IC_kwDOAO6SJc6wOQGA","user":{"login":"dalexeev","id":47700418,"node_id":"MDQ6VXNlcjQ3NzAwNDE4","avatar_url":"https://avatars.githubusercontent.com/u/47700418?v=4","gravatar_id":"","url":"https://api.github.com/users/dalexeev","html_url":"https://github.com/dalexeev","followers_url":"https://api.github.com/users/dalexeev/followers","following_url":"https://api.github.com/users/dalexeev/following{/other_user}","gists_url":"https://api.github.com/users/dalexeev/gists{/gist_id}","starred_url":"https://api.github.com/users/dalexeev/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/dalexeev/subscriptions","organizations_url":"https://api.github.com/users/dalexeev/orgs","repos_url":"https://api.github.com/users/dalexeev/repos","events_url":"https://api.github.com/users/dalexeev/events{/privacy}","received_events_url":"https://api.github.com/users/dalexeev/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-06-09T17:57:39Z","updated_at":"2025-06-09T17:57:39Z","body":"Combining tests doesn't mean you have to put everything in one file. You can still split test cases into multiple files. The only difference is that before we had to use many small files, one for each analyzer or runtime error.\r\n\r\nThis was very inconvenient, as you couldn't quickly compare similar cases. It was too tedious to create and find related tests (even if the files had the same prefixes). This PR fixes the impact caused by the old workflow. I tried to avoid combining unrelated tests, let me know if you find that I combined tests too much somewhere.","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2956525952/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4194069840","html_url":"https://github.com/godotengine/godot/pull/99899#issuecomment-4194069840","issue_url":"https://api.github.com/repos/godotengine/godot/issues/99899","id":4194069840,"node_id":"IC_kwDOAO6SJc75_G1Q","user":{"login":"Repiteo","id":17489292,"node_id":"MDQ6VXNlcjE3NDg5Mjky","avatar_url":"https://avatars.githubusercontent.com/u/17489292?v=4","gravatar_id":"","url":"https://api.github.com/users/Repiteo","html_url":"https://github.com/Repiteo","followers_url":"https://api.github.com/users/Repiteo/followers","following_url":"https://api.github.com/users/