pi.github.com/users/Kazox61/following{/other_user}","gists_url":"https://api.github.com/users/Kazox61/gists{/gist_id}","starred_url":"https://api.github.com/users/Kazox61/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Kazox61/subscriptions","organizations_url":"https://api.github.com/users/Kazox61/orgs","repos_url":"https://api.github.com/users/Kazox61/repos","events_url":"https://api.github.com/users/Kazox61/events{/privacy}","received_events_url":"https://api.github.com/users/Kazox61/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-09-20T22:56:29Z","updated_at":"2026-09-20T22:56:29Z","body":"Having the same issue for godot 4.8dev6 and Xcode 27","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5753277690/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5793977848","html_url":"https://github.com/godotengine/godot/issues/122549#issuecomment-5793977848","issue_url":"https://api.github.com/repos/godotengine/godot/issues/122549","id":5793977848,"node_id":"IC_kwDOAO6SJc8AAAABWVkV-A","user":{"login":"madebydavid","id":5401249,"node_id":"MDQ6VXNlcjU0MDEyNDk=","avatar_url":"https://avatars.githubusercontent.com/u/5401249?v=4","gravatar_id":"","url":"https://api.github.com/users/madebydavid","html_url":"https://github.com/madebydavid","followers_url":"https://api.github.com/users/madebydavid/followers","following_url":"https://api.github.com/users/madebydavid/following{/other_user}","gists_url":"https://api.github.com/users/madebydavid/gists{/gist_id}","starred_url":"https://api.github.com/users/madebydavid/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/madebydavid/subscriptions","organizations_url":"https://api.github.com/users/madebydavid/orgs","repos_url":"https://api.github.com/users/madebydavid/repos","events_url":"https://api.github.com/users/madebydavid/events{/privacy}","received_events_url":"https://api.github.com/users/madebydavid/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-09-23T11:26:36Z","updated_at":"2026-09-23T11:26:36Z","body":"I did some more testing with full builds on Xcode 26.1.1, 26.3 and 26.6, with the Godot 4.7.1 and 4.7.2 templates. With the exported project's default settings it links fine, from both `xcodebuild` and the Xcode IDE.\n\nI can recreate the issue only in the following scenarios:\n\n- `DEAD_CODE_STRIPPING=NO`\n- `LD_EXPORT_GLOBAL_SYMBOLS=YES` - adds `-rdynamic`, so it fails even with dead stripping on\n- `ENABLE_TESTABILITY=YES` - also passes `-rdynamic` to the linker ([Apple docs](https://developer.apple.com/documentation/xcode/build-settings-reference#Enable-Testability))\n\nThe exported Xcode project has all three off.\n\nNew Xcode projects have `ENABLE_TESTABILITY=YES` in Debug by default (set in Xcode's base project template `Library/Xcode/Templates/Project Templates/Base/Base_ProjectSettings.xctemplate/TemplateInfo.plist`), so it might be encountered if the export's settings have been changed or it's been added to another project.\n\nWould someone who can reproduce this be able to provide the full link command that Xcode runs? This is in the Report navigator (<kbd>⌘</kbd><kbd>9</kbd>): select the failed build, expand the \"Link output\" step and copy the command. It will show whether `-dead_strip` is missing or `-rdynamic` is present.\n","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5793977848/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5861605447","html_url":"https://github.com/godotengine/godot/issues/122549#issuecomment-5861605447","issue_url":"https://api.github.com/repos/godotengine/godot/issues/122549","id":5861605447,"node_id":"IC_kwDOAO6SJc8AAAABXWEARw","user":{"login":"stuartcarnie","id":52852,"node_id":"MDQ6VXNlcjUyODUy","avatar_url":"https://avatars.githubusercontent.com/u/52852?v=4","gravatar_id":"","url":"https://api.github.com/users/stuartcarnie","html_url":"https://github.com/stuartcarnie","followers_url":"https://api.github.com/users/stuartcarnie/followers","following_url":"https://api.github.com/users/stuartcarnie/following{/other_user}","gists_url":"https://api.github.com/users/stuartcarnie/gists{/gist_id}","starred_url":"https://api.github.com/users/stuartcarnie/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/stuartcarnie/subscriptions","organizations_url":"https://api.github.com/users/stuartcarnie/orgs","repos_url":"https://api.github.com/users/stuartcarnie/repos","events_url":"https://api.github.com/users/stuartcarnie/events{/privacy}","received_events_url":"https://api.github.com/users/stuartcarnie/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-09-28T01:14:13Z","updated_at":"2026-09-28T01:14:13Z","body":"For those having the issue, you could try this #123899 (you'll need to build the template yourself)","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5861605447/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null}]