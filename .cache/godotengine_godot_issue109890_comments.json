[{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3219312102","html_url":"https://github.com/godotengine/godot/pull/109890#issuecomment-3219312102","issue_url":"https://api.github.com/repos/godotengine/godot/issues/109890","id":3219312102,"node_id":"IC_kwDOAO6SJc6_4s3m","user":{"login":"groud","id":6093119,"node_id":"MDQ6VXNlcjYwOTMxMTk=","avatar_url":"https://avatars.githubusercontent.com/u/6093119?v=4","gravatar_id":"","url":"https://api.github.com/users/groud","html_url":"https://github.com/groud","followers_url":"https://api.github.com/users/groud/followers","following_url":"https://api.github.com/users/groud/following{/other_user}","gists_url":"https://api.github.com/users/groud/gists{/gist_id}","starred_url":"https://api.github.com/users/groud/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/groud/subscriptions","organizations_url":"https://api.github.com/users/groud/orgs","repos_url":"https://api.github.com/users/groud/repos","events_url":"https://api.github.com/users/groud/events{/privacy}","received_events_url":"https://api.github.com/users/groud/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-08-25T08:27:05Z","updated_at":"2025-08-25T08:27:05Z","body":"I don't think this it right. `use_kinematic_bodies` is supposed to replace `collision_animatable`. I just (more or less), renamed it when moving to TileMapLayer. If `use_kinematic_bodies` is not enough to make things work then this should be fixed, we should not add another bool there again.\r\n","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3219312102/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3219378803","html_url":"https://github.com/godotengine/godot/pull/109890#issuecomment-3219378803","issue_url":"https://api.github.com/repos/godotengine/godot/issues/109890","id":3219378803,"node_id":"IC_kwDOAO6SJc6_49Jz","user":{"login":"rburing","id":229837,"node_id":"MDQ6VXNlcjIyOTgzNw==","avatar_url":"https://avatars.githubusercontent.com/u/229837?v=4","gravatar_id":"","url":"https://api.github.com/users/rburing","html_url":"https://github.com/rburing","followers_url":"https://api.github.com/users/rburing/followers","following_url":"https://api.github.com/users/rburing/following{/other_user}","gists_url":"https://api.github.com/users/rburing/gists{/gist_id}","starred_url":"https://api.github.com/users/rburing/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/rburing/subscriptions","organizations_url":"https://api.github.com/users/rburing/orgs","repos_url":"https://api.github.com/users/rburing/repos","events_url":"https://api.github.com/users/rburing/events{/privacy}","received_events_url":"https://api.github.com/users/rburing/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-08-25T08:47:03Z","updated_at":"2025-08-25T08:47:03Z","body":"I agree it's awkward to have both, but (as the test project / regression / the fix in this PR shows) making bodies kinematic is not enough to make the collision properly animatable, so it would be a poor name for the property.\r\n\r\nI think it would make sense to remove `use_kinematic_bodies` in favor of `collision_animatable` (with compatibility code).\r\n\r\n(Theoretically someone could be depending on the current behavior, but it's doubtful.)","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3219378803/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3219387282","html_url":"https://github.com/godotengine/godot/pull/109890#issuecomment-3219387282","issue_url":"https://api.github.com/repos/godotengine/godot/issues/109890","id":3219387282,"node_id":"IC_kwDOAO6SJc6_4_OS","user":{"login":"groud","id":6093119,"node_id":"MDQ6VXNlcjYwOTMxMTk=","avatar_url":"https://avatars.githubusercontent.com/u/6093119?v=4","gravatar_id":"","url":"https://api.github.com/users/groud","html_url":"https://github.com/groud","followers_url":"https://api.github.com/users/groud/followers","following_url":"https://api.github.com/users/groud/following{/other_user}","gists_url":"https://api.github.com/users/groud/gists{/gist_id}","starred_url":"https://api.github.com/users/groud/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/groud/subscriptions","organizations_url":"https://api.github.com/users/groud/orgs","repos_url":"https://api.github.com/users/groud/repos","events_url":"https://api.github.com/users/groud/events{/privacy}","received_events_url":"https://api.github.com/users/groud/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-08-25T08:49:55Z","updated_at":"2025-08-25T08:49:55Z","body":"> I think it would make sense to remove use_kinematic_bodies in favor of collision_animatable (with compatibility code).\r\n\r\nI really don't want to add another bool here, `use_kinematic_bodies` is supposed to work for moving platforms. If it does not, it's a bug. ","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3219387282/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3219643745","html_url":"https://github.com/godotengine/godot/pull/109890#issuecomment-3219643745","issue_url":"https://api.github.com/repos/godotengine/godot/issues/109890","id":3219643745,"node_id":"IC_kwDOAO6SJc6_591h","user":{"login":"rburing","id":229837,"node_id":"MDQ6VXNlcjIyOTgzNw==","avatar_url":"https://avatars.githubusercontent.com/u/229837?v=4","gravatar_id":"","url":"https://api.github.com/users/rburing","html_url":"https://github.com/rburing","followers_url":"https://api.github.com/users/rburing/followers","following_url":"https://api.github.com/users/rburing/following{/other_user}","gists_url":"https://api.github.com/users/rburing/gists{/gist_id}","starred_url":"https://api.github.com/users/rburing/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/rburing/subscriptions","organizations_url":"https://api.github.com/users/rburing/orgs","repos_url":"https://api.github.com/users/rburing/repos","events_url":"https://api.github.com/users/rburing/events{/privacy}","received_events_url":"https://api.github.com/users/rburing/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-08-25T10:08:35Z","updated_at":"2025-08-25T10:20:51Z","body":"> I really don't want to add another bool here\r\n\r\nI'm fine with keeping a single `bool` on `TileMapLayer`, I'm just saying `use_kinematic_bodies` is not a very good name for it when it also needs this \"sync to physics\" code. For completeness, here's how it was working in 4.1:\r\n\r\nhttps://github.com/godotengine/godot/blob/61adafae2f9dace1f094b89ab2aceebd114e1c01/scene/2d/tile_map.cpp#L1525-L1593\r\n\r\nFor reference, it is probably based on AnimatableBody2D:\r\n\r\nhttps://github.com/godotengine/godot/blob/master/scene/2d/physics/animatable_body_2d.cpp","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3219643745/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3220169714","html_url":"https://github.com/godotengine/godot/pull/109890#issuecomment-3220169714","issue_url":"https://api.github.com/repos/godotengine/godot/issues/109890","id":3220169714,"node_id":"IC_kwDOAO6SJc6_7-Py","user":{"login":"rburing","id":229837,"node_id":"MDQ6VXNlcjIyOTgzNw==","avatar_url":"https://avatars.githubusercontent.com/u/229837?v=4","gravatar_id":"","url":"https://api.github.com/users/rburing","html_url":"https://github.com/rburing","followers_url":"https://api.github.com/users/rburing/followers","following_url":"https://api.github.com/users/rburing/following{/other_user}","gists_url":"https://api.github.com/users/rburing/gists{/gist_id}","starred_url":"https://api.github.com/users/rburing/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/rburing/subscriptions","organizations_url":"https://api.github.com/users/rburing/orgs","repos_url":"https://api.github.com/users/rburing/repos","events_url":"https://api.github.com/users/rburing/events{/privacy}","received_events_url":"https://api.github.com/users/rburing/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-08-25T12:59:22Z","updated_at":"2025-08-25T12:59:22Z","body":"I updated the PR to only fix the TileMap regression. We can discuss what to do with TileMapLayer separately.","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3220169714/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null}]