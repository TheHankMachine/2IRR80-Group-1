t":null,"archived_by":null}],"state":"closed","locked":false,"assignees":[],"milestone":{"url":"https://api.github.com/repos/godotengine/godot/milestones/25","html_url":"https://github.com/godotengine/godot/milestone/25","labels_url":"https://api.github.com/repos/godotengine/godot/milestones/25/labels","id":15520464,"node_id":"MI_kwDOAO6SJc4A7NLQ","number":25,"title":"4.8","description":"","creator":{"login":"Repiteo","id":17489292,"node_id":"MDQ6VXNlcjE3NDg5Mjky","avatar_url":"https://avatars.githubusercontent.com/u/17489292?v=4","gravatar_id":"","url":"https://api.github.com/users/Repiteo","html_url":"https://github.com/Repiteo","followers_url":"https://api.github.com/users/Repiteo/followers","following_url":"https://api.github.com/users/Repiteo/following{/other_user}","gists_url":"https://api.github.com/users/Repiteo/gists{/gist_id}","starred_url":"https://api.github.com/users/Repiteo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Repiteo/subscriptions","organizations_url":"https://api.github.com/users/Repiteo/orgs","repos_url":"https://api.github.com/users/Repiteo/repos","events_url":"https://api.github.com/users/Repiteo/events{/privacy}","received_events_url":"https://api.github.com/users/Repiteo/received_events","type":"User","user_view_type":"public","site_admin":false},"open_issues":341,"closed_issues":2335,"state":"open","created_at":"2026-04-13T15:59:35Z","updated_at":"2026-10-22T03:07:42Z","due_on":null,"closed_at":null},"comments":0,"created_at":"2026-04-13T22:54:14Z","updated_at":"2026-06-25T13:40:06Z","closed_at":"2026-06-25T13:37:20Z","assignee":null,"author_association":"CONTRIBUTOR","issue_field_values":[],"type":null,"active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"### Tested versions\n\n- Reproducible in v4.7.dev.custom_build [d1f2007d4]\n\n### System information\n\nGodot v4.7.dev (d1f2007d4) - macOS Tahoe (26.3.1) - Multi-window, 2 monitors - OpenGL 3 (Compatibility) - Apple M4 Pro - Apple M4 Pro (14 threads) - 24.00 GiB memory\n\n### Issue description\n\nThe range for the `UNTYPED_DECLARATION` warning in GDScript, when applied to a function's static return type not being specified, encompasses the entire function instead of just the function declaration line.\n\n<img width=\"667\" height=\"225\" alt=\"Image\" src=\"https://github.com/user-attachments/assets/bf4f2cfb-0bf3-41a9-b543-df23d5840da1\" />\n\n<img width=\"887\" height=\"319\" alt=\"Image\" src=\"https://github.com/user-attachments/assets/55c543a6-5eb6-405a-b72f-a85c64f887fe\" />\n\nAt a glance, this makes it more difficult to distinguish where the warning(s) actually are, and if there are other warnings in the function.\n\nAdditionally, [this causes trouble for the code actions PR I'm working on](https://github.com/godotengine/godot/pull/114168#issuecomment-4196115803). Editors will want to suggest fixes for the warning even when a line in the middle of the function is highlighted, just because they consider the warning to spread across the whole function.\n\n### Steps to reproduce\n\nUse the following GDScript code, and ensure that the \"Untyped Declaration\" warning is set to \"Warn\" in Project Settings:\n```gdscript\nfunc do_something(hello: float):\n\tvar i: int = 3\n\tvar j: int = 2 + 5\n\tprint(hello, i, j)\n```\nThis should only have one warning:\n```\nLine 3 (UNTYPED_DECLARATION):Function \"do_something()\" has no static return type.\n```\nHowever, in both the built-in script editor and external IDEs using the language server, the entire function body is highlighted.\n\n### Minimal reproduction project (MRP)\n\n[mrp-untyped-declaration-return-type_2026-04-13_15-53-27.zip](https://github.com/user-attachments/files/26691058/mrp-untyped-declaration-return-type_2026-04-13_15-53-27.zip)","closed_by":{"login":"Repiteo","id":17489292,"node_id":"MDQ6VXNlcjE3NDg5Mjky","avatar_url":"https://avatars.githubusercontent.com/u/17489292?v=4","gravatar_id":"","url":"https://api.github.com/users/Repiteo","html_url":"https://github.com/Repiteo","followers_url":"https://api.github.com/users/Repiteo/followers","following_url":"https://api.github.com/users/Repiteo/following{/other_user}","gists_url":"https://api.github.com/users/Repiteo/gists{/gist_id}","starred_url":"https://api.github.com/users/Repiteo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Repiteo/subscriptions","organizations_url":"https://api.github.com/users/Repiteo/orgs","repos_url":"https://api.github.com/users/Repiteo/repos","events_url":"https://api.github.com/users/Repiteo/events{/privacy}","received_events_url":"https://api.github.com/users/Repiteo/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/118550/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/godotengine/godot/issues/118550/timeline","performed_via_github_app":null,"state_reason":"completed","pinned_comment":null}