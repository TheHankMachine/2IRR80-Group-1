.NativeInterop.godot_string_name&, Godot.NativeInterop.NativeVariantPtrArgs, Godot.NativeInterop.godot_variant&)\n                 Node2D.cs:546 @ bool Godot.Node2D.InvokeGodotClassMethod(Godot.NativeInterop.godot_string_name&, Godot.NativeInterop.NativeVariantPtrArgs, Godot.NativeInterop.godot_variant&)\n                 CursorController_ScriptMethods.generated.cs:138 @ bool CursorController.InvokeGodotClassMethod(Godot.NativeInterop.godot_string_name&, Godot.NativeInterop.NativeVariantPtrArgs, Godot.NativeInterop.godot_variant&)\n                 CSharpInstanceBridge.cs:24 @ Godot.NativeInterop.godot_bool Godot.Bridge.CSharpInstanceBridge.Call(nint, Godot.NativeInterop.godot_string_name*, Godot.NativeInterop.godot_variant**, int, Godot.NativeInterop.godot_variant_call_error*, Godot.NativeInterop.godot_variant*)\n```\n\nNot that the meaning has changed tho. I deleted the mono folder. Nothing changed.","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3770135199/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3770455019","html_url":"https://github.com/godotengine/godot/issues/115138#issuecomment-3770455019","issue_url":"https://api.github.com/repos/godotengine/godot/issues/115138","id":3770455019,"node_id":"IC_kwDOAO6SJc7gvJPr","user":{"login":"raulsntos","id":3903059,"node_id":"MDQ6VXNlcjM5MDMwNTk=","avatar_url":"https://avatars.githubusercontent.com/u/3903059?v=4","gravatar_id":"","url":"https://api.github.com/users/raulsntos","html_url":"https://github.com/raulsntos","followers_url":"https://api.github.com/users/raulsntos/followers","following_url":"https://api.github.com/users/raulsntos/following{/other_user}","gists_url":"https://api.github.com/users/raulsntos/gists{/gist_id}","starred_url":"https://api.github.com/users/raulsntos/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/raulsntos/subscriptions","organizations_url":"https://api.github.com/users/raulsntos/orgs","repos_url":"https://api.github.com/users/raulsntos/repos","events_url":"https://api.github.com/users/raulsntos/events{/privacy}","received_events_url":"https://api.github.com/users/raulsntos/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-01-19T23:41:46Z","updated_at":"2026-01-19T23:41:46Z","body":"Can you provide an MRP? It looks a lot like you have a custom `AnimationPlayer` type somewhere in your project which takes priority over the `Godot.AnimationPlayer` type provided by external libraries.\n\nTo confirm, you can try specifying the fully-qualified type name in the `GetNode<T>` method, and see if that fixes it:\n\n```csharp\nGodot.AnimationPlayer = GetNode<Godot.AnimationPlayer>(\"PATH_TO_NODE_HERE\");\n```","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3770455019/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3775203169","html_url":"https://github.com/godotengine/godot/issues/115138#issuecomment-3775203169","issue_url":"https://api.github.com/repos/godotengine/godot/issues/115138","id":3775203169,"node_id":"IC_kwDOAO6SJc7hBQdh","user":{"login":"Catharsio","id":118612175,"node_id":"U_kgDOBxHgzw","avatar_url":"https://avatars.githubusercontent.com/u/118612175?v=4","gravatar_id":"","url":"https://api.github.com/users/Catharsio","html_url":"https://github.com/Catharsio","followers_url":"https://api.github.com/users/Catharsio/followers","following_url":"https://api.github.com/users/Catharsio/following{/other_user}","gists_url":"https://api.github.com/users/Catharsio/gists{/gist_id}","st