"rocket":0,"eyes":0},"start_line":580,"original_start_line":580,"start_side":"RIGHT","line":586,"original_line":586,"side":"RIGHT","in_reply_to_id":4168300799,"author_association":"MEMBER","original_position":10,"position":10,"subject_type":"line"},{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/4170077947","pull_request_review_id":5397140929,"id":4170077947,"node_id":"PRRC_kwDOAO6SJc74jlb7","diff_hunk":"@@ -577,6 +577,13 @@ void AnimationMixer::set_dummy(bool p_dummy) {\n bool AnimationMixer::is_dummy() const {\n \treturn dummy;\n }\n+\n+bool AnimationMixer::editor_audio_muted = false;\n+\n+void AnimationMixer::set_editor_audio_muted(bool p_muted) {\n+\tERR_FAIL_COND(!Engine::get_singleton()->is_editor_hint());\n+\teditor_audio_muted = p_muted;\n+}","path":"scene/animation/animation_mixer.cpp","commit_id":"c810e787114b4b6c8003e320e09fa0bce884ce79","original_commit_id":"75a9d0cecab3fc4809b63df022c4d02805796dca","user":{"login":"MarianoGnu","id":1776044,"node_id":"MDQ6VXNlcjE3NzYwNDQ=","avatar_url":"https://avatars.githubusercontent.com/u/1776044?v=4","gravatar_id":"","url":"https://api.github.com/users/MarianoGnu","html_url":"https://github.com/MarianoGnu","followers_url":"https://api.github.com/users/MarianoGnu/followers","following_url":"https://api.github.com/users/MarianoGnu/following{/other_user}","gists_url":"https://api.github.com/users/MarianoGnu/gists{/gist_id}","starred_url":"https://api.github.com/users/MarianoGnu/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/MarianoGnu/subscriptions","organizations_url":"https://api.github.com/users/MarianoGnu/orgs","repos_url":"https://api.github.com/users/MarianoGnu/repos","events_url":"https://api.github.com/users/MarianoGnu/events{/privacy}","received_events_url":"https://api.github.com/users/MarianoGnu/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"Method tracks do not run in editor, and the likelyness of someone playing an audio from a custom value track is neglegible.\r\nAlso the tooltip is very clear on what it does \"mute **audio tracks** in editor\", not all audio stream players","created_at":"2026-10-02T21:43:07Z","updated_at":"2026-10-02T21:47:56Z","html_url":"https://github.com/godotengine/godot/pull/124099#discussion_r4170077947","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/124099","_links":{"self":{"href":"https://api.github.com/repos/godotengine/godot/pulls/comments/4170077947"},"html":{"href":"https://github.com/godotengine/godot/pull/124099#discussion_r4170077947"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/124099"}},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/4170077947/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":580,"original_start_line":580,"start_side":"RIGHT","line":586,"original_line":586,"side":"RIGHT","in_reply_to_id":4168300799,"author_association":"CONTRIBUTOR","original_position":10,"position":10,"subject_type":"line"},{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/4170483335","pull_request_review_id":5397614602,"id":4170483335,"node_id":"PRRC_kwDOAO6SJc74lIaH","diff_hunk":"@@ -577,6 +577,13 @@ void AnimationMixer::set_dummy(bool p_dummy) {\n bool AnimationMixer::is_dummy() const {\n \treturn dummy;\n }\n+\n+bool AnimationMixer::editor_audio_muted = false;\n+\n+void AnimationMixer::set_editor_audio_muted(bool p_muted) {\n+\tERR_FAIL_COND(!Engine::get_singleton()->is_editor_hint());\n+\teditor_audio_muted = p_muted;\n+}","path":"scene/animation/animation_mixer.cpp","commit_id":"c810e787114b4b6c8003e320e09fa0bce884ce79","original_commit_id":"75a9d0cecab3fc4809b63df022c4d02805796dca","user":{"login":"TokageItLab","id":61938263,"node_id":"MDQ6VXNlcjYxOTM4MjYz","avatar_url":"https://avatars.githubusercontent.com/u/61938263?v=4","gravatar_id":"","url":"https://api.github.com/users/TokageItLab","html_url":"https://github.com/TokageItLab","followers_url":"https://api.github.com/users/TokageItLab/followers","following_url":"https://api.github.com/users/TokageItLab/following{/other_user}","gists_url":"https://api.github.com/users/TokageItLab/gists{/gist_id}","starred_url":"https://api.github.com/users/TokageItLab/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/TokageItLab/subscriptions","organizations_url":"https://api.github.com/users/TokageItLab/orgs","repos_url":"https://api.github.com/users/TokageItLab/repos","events_url":"https://api.github.com/users/TokageItLab/events{/privacy}","received_events_url":"https://api.github.com/users/TokageItLab/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"> Method tracks do not run in editor, and the likelyness of someone playing an audio from a custom value track is neglegible.\r\n\r\nI assume it is more often than you might think, because I remember multiple issues being raised by some another users and dealing with them:\r\n\r\n- https://github.com/godotengine/godot/issues/95701\r\n- https://github.com/godotengine/godot/issues/95932\r\n- https://github.com/godotengine/godot/issues/95684\r\n\r\nIn any case, checking whether to mute every frame does not seem like the right approach. If you change the method so that the audio track is not created at the caching timing, you can make a decision in just a single frame, but that is still not correct.\r\n\r\nMoreover, even though it checks every frame, I do not think this would allow you to change the muting state of a long audio midway through. In other words, if you have an animation playing background music, I do not think you would be able to mute that playback halfway through.\r\n\r\nTherefore, I can't approve this PR for now, and I believe the correct path is to make it an editor feature that controls AudioStream or AudioBus rather than handling it on the animation side.","created_at":"2026-10-02T22:53:50Z","updated_at":"2026-10-02T22:55:31Z","html_url":"https://github.com/godotengine/godot/pull/124099#discussion_r4170483335","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/124099","_links":{"self":{"href":"https://api.github.com/repos/godotengine/godot/pulls/comments/4170483335"},"html":{"href":"https://github.com/godotengine/godot/pull/124099#discussion_r4170483335"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/124099"}},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/4170483335/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":580,"original_start_line":580,"start_side":"RIGHT","line":586,"original_line":586,"side":"RIGHT","in_reply_to_id":4168300799,"author_association":"MEMBER","original_position":10,"position":10,"subject_type":"line"},{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/4170567708","pull_request_review_id":5397721794,"id":4170567708,"node_id":"PRRC_kwDOAO6SJc74ldAc","diff_hunk":"@@ -577,6 +577,13 @@ void AnimationMixer::set_dummy(bool p_dummy) {\n bool AnimationMixer::is_dummy() const {\n \treturn dummy;\n }\n+\n+bool AnimationMixer::editor_audio_muted = false;\n+\n+void AnimationMixer::set_editor_audio_muted(bool p_muted) {\n+\tERR_FAIL_COND(!Engine::get_singleton()->is_editor_hint());\n+\teditor_audio_muted = p_muted;\n+}","path":"scene/animation/animation_mixer.cpp","commit_id":"c810e787114b4b6c8003e320e09fa0bce884ce79","original_commit_id":"75a9d0cecab3fc4809b63df022c4d02805796dca","user":{"login":"MarianoGnu","id":1776044,"node_id":"MDQ6VXNlcjE3NzYwNDQ=","avatar_url":"https://avatars.githubusercontent.com/u/1776044?v=4","gravatar_id":"","url":"https://api.github.com/users/MarianoGnu","html_url":"https://github.com/MarianoGnu","followers_url":"https://api.github.com/users/MarianoGnu/followers","following_url":"https://api.github.com/users/MarianoGnu/fol