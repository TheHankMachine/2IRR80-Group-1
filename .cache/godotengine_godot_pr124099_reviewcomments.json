}","gists_url":"https://api.github.com/users/TokageItLab/gists{/gist_id}","starred_url":"https://api.github.com/users/TokageItLab/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/TokageItLab/subscriptions","organizations_url":"https://api.github.com/users/TokageItLab/orgs","repos_url":"https://api.github.com/users/TokageItLab/repos","events_url":"https://api.github.com/users/TokageItLab/events{/privacy}","received_events_url":"https://api.github.com/users/TokageItLab/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"It seems like the complexity is becoming excessive just for muting. Still, from the perspective of code maintainability, I recommend implementing scene-based muting.","created_at":"2026-10-05T20:00:37Z","updated_at":"2026-10-05T20:00:38Z","html_url":"https://github.com/godotengine/godot/pull/124099#discussion_r4188185128","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/124099","_links":{"self":{"href":"https://api.github.com/repos/godotengine/godot/pulls/comments/4188185128"},"html":{"href":"https://github.com/godotengine/godot/pull/124099#discussion_r4188185128"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/124099"}},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/4188185128/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":580,"original_start_line":580,"start_side":"RIGHT","line":586,"original_line":586,"side":"RIGHT","in_reply_to_id":4168300799,"author_association":"MEMBER","original_position":10,"position":10,"subject_type":"line"}]