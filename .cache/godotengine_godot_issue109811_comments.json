[{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3208174428","html_url":"https://github.com/godotengine/godot/pull/109811#issuecomment-3208174428","issue_url":"https://api.github.com/repos/godotengine/godot/issues/109811","id":3208174428,"node_id":"IC_kwDOAO6SJc6_ONtc","user":{"login":"mooflu","id":693717,"node_id":"MDQ6VXNlcjY5MzcxNw==","avatar_url":"https://avatars.githubusercontent.com/u/693717?v=4","gravatar_id":"","url":"https://api.github.com/users/mooflu","html_url":"https://github.com/mooflu","followers_url":"https://api.github.com/users/mooflu/followers","following_url":"https://api.github.com/users/mooflu/following{/other_user}","gists_url":"https://api.github.com/users/mooflu/gists{/gist_id}","starred_url":"https://api.github.com/users/mooflu/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/mooflu/subscriptions","organizations_url":"https://api.github.com/users/mooflu/orgs","repos_url":"https://api.github.com/users/mooflu/repos","events_url":"https://api.github.com/users/mooflu/events{/privacy}","received_events_url":"https://api.github.com/users/mooflu/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-08-20T21:44:02Z","updated_at":"2025-08-20T21:44:02Z","body":"Naming is hard, and I'm curious if there is anything about the feature that's actually dots-per-inch focused? To me the original name conveyed that the key thing was that it was a SVG tied to a texture. Either way, still looking forward to using it.","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3208174428/reactions","total_count":3,"+1":3,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3208187632","html_url":"https://github.com/godotengine/godot/pull/109811#issuecomment-3208187632","issue_url":"https://api.github.com/repos/godotengine/godot/issues/109811","id":3208187632,"node_id":"IC_kwDOAO6SJc6_OQ7w","user":{"login":"bruvzg","id":7645683,"node_id":"MDQ6VXNlcjc2NDU2ODM=","avatar_url":"https://avatars.githubusercontent.com/u/7645683?v=4","gravatar_id":"","url":"https://api.github.com/users/bruvzg","html_url":"https://github.com/bruvzg","followers_url":"https://api.github.com/users/bruvzg/followers","following_url":"https://api.github.com/users/bruvzg/following{/other_user}","gists_url":"https://api.github.com/users/bruvzg/gists{/gist_id}","starred_url":"https://api.github.com/users/bruvzg/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/bruvzg/subscriptions","organizations_url":"https://api.github.com/users/bruvzg/orgs","repos_url":"https://api.github.com/users/bruvzg/repos","events_url":"https://api.github.com/users/bruvzg/events{/privacy}","received_events_url":"https://api.github.com/users/bruvzg/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-08-20T21:50:55Z","updated_at":"2025-08-20T21:50:55Z","body":"The original purpose of it is to allow multiple UI scales in multiple windows to support automatic scaling on different DPI displays (this feature will be implemented in 4.6), so it's pretty limited. And the `SVGTexture` name might create false expectations of a fully customisable vector graphics support, so we decided to rename it for now to bring less attention to the class itself, which might change a lot in the future.","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3208187632/reactions","total_count":6,"+1":6,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3210130740","html_url":"https://github.com/godotengine/godot/pull/109811#issuecomment-3210130740","issue_url":"h