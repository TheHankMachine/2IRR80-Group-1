[{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3272566510","html_url":"https://github.com/godotengine/godot/issues/110361#issuecomment-3272566510","issue_url":"https://api.github.com/repos/godotengine/godot/issues/110361","id":3272566510,"node_id":"IC_kwDOAO6SJc7DD2bu","user":{"login":"Calinou","id":180032,"node_id":"MDQ6VXNlcjE4MDAzMg==","avatar_url":"https://avatars.githubusercontent.com/u/180032?v=4","gravatar_id":"","url":"https://api.github.com/users/Calinou","html_url":"https://github.com/Calinou","followers_url":"https://api.github.com/users/Calinou/followers","following_url":"https://api.github.com/users/Calinou/following{/other_user}","gists_url":"https://api.github.com/users/Calinou/gists{/gist_id}","starred_url":"https://api.github.com/users/Calinou/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Calinou/subscriptions","organizations_url":"https://api.github.com/users/Calinou/orgs","repos_url":"https://api.github.com/users/Calinou/repos","events_url":"https://api.github.com/users/Calinou/events{/privacy}","received_events_url":"https://api.github.com/users/Calinou/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-09-09T23:10:17Z","updated_at":"2025-09-09T23:10:17Z","body":"Changing this behavior now would break compatibility with existing projects, unfortunately.","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3272566510/reactions","total_count":3,"+1":3,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3310255548","html_url":"https://github.com/godotengine/godot/issues/110361#issuecomment-3310255548","issue_url":"https://api.github.com/repos/godotengine/godot/issues/110361","id":3310255548,"node_id":"IC_kwDOAO6SJc7FTn28","user":{"login":"Joy-less","id":65855333,"node_id":"MDQ6VXNlcjY1ODU1MzMz","avatar_url":"https://avatars.githubusercontent.com/u/65855333?v=4","gravatar_id":"","url":"https://api.github.com/users/Joy-less","html_url":"https://github.com/Joy-less","followers_url":"https://api.github.com/users/Joy-less/followers","following_url":"https://api.github.com/users/Joy-less/following{/other_user}","gists_url":"https://api.github.com/users/Joy-less/gists{/gist_id}","starred_url":"https://api.github.com/users/Joy-less/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Joy-less/subscriptions","organizations_url":"https://api.github.com/users/Joy-less/orgs","repos_url":"https://api.github.com/users/Joy-less/repos","events_url":"https://api.github.com/users/Joy-less/events{/privacy}","received_events_url":"https://api.github.com/users/Joy-less/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-09-19T02:09:12Z","updated_at":"2025-09-19T02:09:12Z","body":"`Color` in C# is implemented as a `struct` with 4 `float`s: `R`, `G`, `B`, `A`.\n\nWhen you define a field of a struct type and don't assign a default value (e.g. `public Color MyColor;`), it defaults to the `default` value of the struct and its fields, which in the case of the `float` fields is 0 (`default(float) == 0`). The technical reason for this is that, by default, the byte representation of values are zeroed-out by default in C#.\n\nAs far as I am aware, it would be impossible to have the C# behaviour match the GDScript behaviour without adding an extra field to the struct, for example an `IsUninitialized` boolean that changes how you are supposed to use the struct. Even if you set the default value of the `A` field in the `Color` struct to `1`, this would only affect the result of `new Color()`, not `default(Color)`.\n\nSo, since struct values are zeroed-out by default in C#, colors being (0, 0, 0, 0) by default is the correct behaviour for C#.","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3310255548/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null}]