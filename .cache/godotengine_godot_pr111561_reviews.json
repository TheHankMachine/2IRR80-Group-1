[{"id":3335909651,"node_id":"PRR_kwDOAO6SJc7G1fET","user":{"login":"Ivorforce","id":2308167,"node_id":"MDQ6VXNlcjIzMDgxNjc=","avatar_url":"https://avatars.githubusercontent.com/u/2308167?u=f7f8e0273f784f5ec6f6b7fe4a88d449896eb48a&v=4","gravatar_id":"","url":"https://api.github.com/users/Ivorforce","html_url":"https://github.com/Ivorforce","followers_url":"https://api.github.com/users/Ivorforce/followers","following_url":"https://api.github.com/users/Ivorforce/following{/other_user}","gists_url":"https://api.github.com/users/Ivorforce/gists{/gist_id}","starred_url":"https://api.github.com/users/Ivorforce/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Ivorforce/subscriptions","organizations_url":"https://api.github.com/users/Ivorforce/orgs","repos_url":"https://api.github.com/users/Ivorforce/repos","events_url":"https://api.github.com/users/Ivorforce/events{/privacy}","received_events_url":"https://api.github.com/users/Ivorforce/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"The `type_info.h` change makes sense to me, those includes missing is a compile problem waiting to happen.\n\nRegarding the `variant_` files, it seems that the headers are only included from the source files. So while it normally makes sense to remove includes from headers, in this case I don't think it will have an effect since the headers only affect the corresponding `.cpp` file.\n\nSo although we definitely want to address the `class_db.h` include problem somehow, I don't think these changes will bring us closer to this goal.","state":"COMMENTED","html_url":"https://github.com/godotengine/godot/pull/111561#pullrequestreview-3335909651","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/111561","author_association":"MEMBER","_links":{"html":{"href":"https://github.com/godotengine/godot/pull/111561#pullrequestreview-3335909651"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/111561"}},"submitted_at":"2025-10-14T14:09:00Z","commit_id":null},{"id":3336276341,"node_id":"PRR_kwDOAO6SJc7G24l1","user":{"login":"Ivorforce","id":2308167,"node_id":"MDQ6VXNlcjIzMDgxNjc=","avatar_url":"https://avatars.githubusercontent.com/u/2308167?u=f7f8e0273f784f5ec6f6b7fe4a88d449896eb48a&v=4","gravatar_id":"","url":"https://api.github.com/users/Ivorforce","html_url":"https://github.com/Ivorforce","followers_url":"https://api.github.com/users/Ivorforce/followers","following_url":"https://api.github.com/users/Ivorforce/following{/other_user}","gists_url":"https://api.github.com/users/Ivorforce/gists{/gist_id}","starred_url":"https://api.github.com/users/Ivorforce/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Ivorforce/subscriptions","organizations_url":"https://api.github.com/users/Ivorforce/orgs","repos_url":"https://api.github.com/users/Ivorforce/repos","events_url":"https://api.github.com/users/Ivorforce/events{/privacy}","received_events_url":"https://api.github.com/users/Ivorforce/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"I've confirmed that both includes are required in the file, and that this fixes compilation of a `.cpp` file that only includes `type_info.h`.\r\nThanks for adjusting with the feedback!\r\n\r\nPS. I still hope that in the future, we could have a CI check that catches this type of problem early.","state":"APPROVED","html_url":"https://github.com/godotengine/godot/pull/111561#pullrequestreview-3336276341","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/111561","author_association":"MEMBER","_links":{"html":{"href":"https://github.com/godotengine/godot/pull/111561#pullrequestreview-3336276341"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/111561"}},"submitted_at":"2025-10-14T15:28:51Z","commit_id":"c17e76572dc9a9317f5a147a88ec56475730396e"}]