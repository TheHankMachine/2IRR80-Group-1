hub.com/users/kitbdev/events{/privacy}","received_events_url":"https://api.github.com/users/kitbdev/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-03-02T18:00:45Z","updated_at":"2026-03-02T18:00:45Z","body":"This happens in other places as well, the floating Scene dock does not show drop hints, floating script editor does not show caret.\nBut it also does show in some places like the floating inspector shows drop highlights.","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3985991835/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/6257129728","html_url":"https://github.com/godotengine/godot/issues/116577#issuecomment-6257129728","issue_url":"https://api.github.com/repos/godotengine/godot/issues/116577","id":6257129728,"node_id":"IC_kwDOAO6SJc8AAAABdPQ5AA","user":{"login":"Prawnya","id":170275512,"node_id":"U_kgDOCiYyuA","avatar_url":"https://avatars.githubusercontent.com/u/170275512?v=4","gravatar_id":"","url":"https://api.github.com/users/Prawnya","html_url":"https://github.com/Prawnya","followers_url":"https://api.github.com/users/Prawnya/followers","following_url":"https://api.github.com/users/Prawnya/following{/other_user}","gists_url":"https://api.github.com/users/Prawnya/gists{/gist_id}","starred_url":"https://api.github.com/users/Prawnya/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Prawnya/subscriptions","organizations_url":"https://api.github.com/users/Prawnya/orgs","repos_url":"https://api.github.com/users/Prawnya/repos","events_url":"https://api.github.com/users/Prawnya/events{/privacy}","received_events_url":"https://api.github.com/users/Prawnya/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-10-19T00:32:27Z","updated_at":"2026-10-19T00:32:27Z","body":"Seems likely that this is caused by only the focused window receiving inputs.\n\nSo the second TabContainer never has gui_input called -> never updates mouse position -> doesn't display drop preview.\n\nIf you focus the other window while dragging (by alt-tabbing) then it works as it should:\n\nhttps://github.com/user-attachments/assets/a5331fa2-734e-415d-bed0-0dbcc28f786c\n\nThis is also a problem when dragging scenes/scripts from the file system dock to the scene tree dock, the highlight showing where in the tree the scene will be when dropped doesn't show if one or both of the docks are floating.\n\nIssue also occurs for me even when the windows are embedded.","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/6257129728/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null}]