:linuxbsd","color":"e4e4e4","default":false,"description":"","archived_at":null,"archived_by":null},{"id":279128044,"node_id":"MDU6TGFiZWwyNzkxMjgwNDQ=","url":"https://api.github.com/repos/godotengine/godot/labels/confirmed","name":"confirmed","color":"aaddaa","default":false,"description":"","archived_at":null,"archived_by":null},{"id":649800701,"node_id":"MDU6TGFiZWw2NDk4MDA3MDE=","url":"https://api.github.com/repos/godotengine/godot/labels/topic:network","name":"topic:network","color":"ffee88","default":false,"description":"","archived_at":null,"archived_by":null},{"id":1332303119,"node_id":"MDU6TGFiZWwxMzMyMzAzMTE5","url":"https://api.github.com/repos/godotengine/godot/labels/regression","name":"regression","color":"ff63ac","default":false,"description":"","archived_at":null,"archived_by":null}],"state":"closed","locked":false,"assignees":[],"milestone":{"url":"https://api.github.com/repos/godotengine/godot/milestones/22","html_url":"https://github.com/godotengine/godot/milestone/22","labels_url":"https://api.github.com/repos/godotengine/godot/milestones/22/labels","id":12070367,"node_id":"MI_kwDOAO6SJc4AuC3f","number":22,"title":"4.5","description":"","creator":{"login":"Sauermann","id":6299227,"node_id":"MDQ6VXNlcjYyOTkyMjc=","avatar_url":"https://avatars.githubusercontent.com/u/6299227?v=4","gravatar_id":"","url":"https://api.github.com/users/Sauermann","html_url":"https://github.com/Sauermann","followers_url":"https://api.github.com/users/Sauermann/followers","following_url":"https://api.github.com/users/Sauermann/following{/other_user}","gists_url":"https://api.github.com/users/Sauermann/gists{/gist_id}","starred_url":"https://api.github.com/users/Sauermann/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Sauermann/subscriptions","organizations_url":"https://api.github.com/users/Sauermann/orgs","repos_url":"https://api.github.com/users/Sauermann/repos","events_url":"https://api.github.com/users/Sauermann/events{/privacy}","received_events_url":"https://api.github.com/users/Sauermann/received_events","type":"User","user_view_type":"public","site_admin":false},"open_issues":3,"closed_issues":3687,"state":"closed","created_at":"2024-12-19T08:51:28Z","updated_at":"2026-09-04T21:48:38Z","due_on":"2025-09-15T00:00:00Z","closed_at":"2025-09-18T17:13:14Z"},"comments":4,"created_at":"2025-06-27T14:00:05Z","updated_at":"2025-07-07T15:14:04Z","closed_at":"2025-07-07T15:14:04Z","assignee":null,"author_association":"MEMBER","issue_field_values":[],"type":null,"active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"### Tested versions\n\n- Reproducible in 4.5.beta (d89f4ab32fa32b8f054664449b1658ccd094a120)\n- Reproducible in 4.4.2.rc (e531f3eb7b13a9adaaf5b15ac9b3aebc4c2030cd)\n- Not reproducible in 4.3.1.rc (63c61656786f18411c0a330326cc546745367833)\n\n### System information\n\nFedora Linux 42 (KDE Plasma Desktop Edition) on Wayland - X11 display driver, Multi-window, 2 monitors - OpenGL 3 (Compatibility) - AMD Radeon 780M Graphics (radeonsi, phoenix, LLVM 20.1.6, DRM 3.63, 6.15.3-200.fc42.x86_64) - AMD Ryzen 7 8845HS w/ Radeon 780M Graphics (16 threads) - 60.61 GiB memory\n\n### Issue description\n\nWhen compiling Godot from source with `dev_build=yes` on Fedora 42, I get some mbedTLS \"TLS handshake error\" messages whenever TLS is used.\n\nThis is visible e.g. in the Project Manager when it checks for Godot updates:\n```\nERROR: TLS handshake error: -27648\n   at: _do_handshake (modules/mbedtls/stream_peer_mbedtls.cpp:88)\nmbedtls error: returned -0x6c00\n```\n![Image](https://github.com/user-attachments/assets/f607a9db-2e2a-455c-a5d0-7709ebab5446)\n\nOr in the Asset Library (same error code):\n\n![Image](https://github.com/user-attachments/assets/6fef4918-164d-4df9-9949-3353afde9b1f)\n\nAccording to @pythongirl325 this is also reproducible on Arch Linux: https://github.com/godotengine/godot/issues/107754#issuecomment-3012978870\n\nI can reproduce this in 4.4 and 4.5, but not 4.3, so I suspect this is related to enabling support for TLS v1.3 in 4.4: \n- #96394\nAnd so not directly linked to the update to Mbed TLS 3.6 per se, which happened in Godot 4.3 already, but without the PSA/TLSv1.3 stuff.\n\nToggling the `network/tls/enable_tls_v1.3` editor setting doesn't seem to change the behavior, but I have a suspicion that this setting might be broken as the `.3` might be interpreted as a feature override (at least it's styled as such in the editor settings).\n\nI debugged this a bit more a few weeks ago but I can't find the chat logs about it. IIRC the problem was not `dev_build=yes` per se, but `optimize=none` which it enables. So mbedtls without optimization would end up being broken.\n\nCC @Faless \n\n### Steps to reproduce\n\n- On Fedora 42 or Arch Linux: `scons dev_build=yes`\n- Open project manager and see errors\n\n### Minimal reproduction project (MRP)\n\nn/a","closed_by":{"login":"Repiteo","id":17489292,"node_id":"MDQ6VXNlcjE3NDg5Mjky","avatar_url":"https://avatars.githubusercontent.com/u/17489292?v=4","gravatar_id":"","url":"https://api.github.com/users/Repiteo","html_url":"https://github.com/Repiteo","followers_url":"https://api.github.com/users/Repiteo/followers","following_url":"https://api.github.com/users/Repiteo/following{/other_user}","gists_url":"https://api.github.com/users/Repiteo/gists{/gist_id}","starred_url":"https://api.github.com/users/Repiteo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Repiteo/subscriptions","organizations_url":"https://api.github.com/users/Repiteo/orgs","repos_url":"https://api.github.com/users/Repiteo/repos","events_url":"https://api.github.com/users/Repiteo/events{/privacy}","received_events_url":"https://api.github.com/users/Repiteo/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.co