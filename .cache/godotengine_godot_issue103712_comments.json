eusmdx","id":44306054,"node_id":"MDQ6VXNlcjQ0MzA2MDU0","avatar_url":"https://avatars.githubusercontent.com/u/44306054?v=4","gravatar_id":"","url":"https://api.github.com/users/matheusmdx","html_url":"https://github.com/matheusmdx","followers_url":"https://api.github.com/users/matheusmdx/followers","following_url":"https://api.github.com/users/matheusmdx/following{/other_user}","gists_url":"https://api.github.com/users/matheusmdx/gists{/gist_id}","starred_url":"https://api.github.com/users/matheusmdx/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/matheusmdx/subscriptions","organizations_url":"https://api.github.com/users/matheusmdx/orgs","repos_url":"https://api.github.com/users/matheusmdx/repos","events_url":"https://api.github.com/users/matheusmdx/events{/privacy}","received_events_url":"https://api.github.com/users/matheusmdx/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-03-08T20:11:30Z","updated_at":"2025-03-08T20:11:30Z","body":"I can't reproduce this issue, i used `visible_collision_shapes = true` and added a `TextEdit` to MRP for make easier visualize the test.\n\n\nhttps://github.com/user-attachments/assets/fbfc82a4-0e92-497f-80de-83a7c2c521af\n\n\nGodot v4.4.stable - Windows 10 (build 19045) - Multi-window, 2 monitors - Vulkan (Forward+) - dedicated AMD Radeon RX 580 2048SP (Advanced Micro Devices, Inc.; 31.0.21921.1000) - AMD Ryzen 5 3600 6-Core Processor (12 threads)","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2708471920/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2708737650","html_url":"https://github.com/godotengine/godot/issues/103712#issuecomment-2708737650","issue_url":"https://api.github.com/repos/godotengine/godot/issues/103712","id":2708737650,"node_id":"IC_kwDOAO6SJc6hdA5y","user":{"login":"dlouapre","id":2952376,"node_id":"MDQ6VXNlcjI5NTIzNzY=","avatar_url":"https://avatars.githubusercontent.com/u/2952376?v=4","gravatar_id":"","url":"https://api.github.com/users/dlouapre","html_url":"https://github.com/dlouapre","followers_url":"https://api.github.com/users/dlouapre/followers","following_url":"https://api.github.com/users/dlouapre/following{/other_user}","gists_url":"https://api.github.com/users/dlouapre/gists{/gist_id}","starred_url":"https://api.github.com/users/dlouapre/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/dlouapre/subscriptions","organizations_url":"https://api.github.com/users/dlouapre/orgs","repos_url":"https://api.github.com/users/dlouapre/repos","events_url":"https://api.github.com/users/dlouapre/events{/privacy}","received_events_url":"https://api.github.com/users/dlouapre/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-03-09T08:38:33Z","updated_at":"2025-03-09T08:39:03Z","body":"Just tried on another computer and it didn't reproduce :/\nI'll try again tomorrow when I'm on the computer that showed the issue initially, and I'll log exactly the positions, to understand whether this is an issue with the mouse position, the intersect by itself, etc.\n(I'll make sure I exactly log the display options, screen and graphics card)","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2708737650/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2709691413","html_url":"https://github.com/godotengine/godot/issues/103712#issuecomment-2709691413","issue_url":"https://api.github.com/repos/godotengine/godot/issues/103712","id":2709691413,"node_id":"IC_kwDOAO6SJc6hgpwV","user":{"login":"dlouapre","id":2952376,"node_id":"MDQ6VXNlcjI5NTIzNzY=","avatar_url":"https://avatars.githubusercontent.com/u/2952376?v=4","gravatar_id":"","url":"https://api.github.com/users/dlouapre","html_url":"https://github.com/dlouapre","followers_url":"https://api.github.com/users/dlouapre/followers","following_url":"https://api.github.com/users/dlouapre/following{/other_user}","gists_url":"https://api.github.com/users/dlouapre/gists{/gist_id}","starred_url":"https://api.github.com/users/dlouapre/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/dlouapre/subscriptions","organizations_url":"https://api.github.com/users/dlouapre/orgs","repos_url":"https://api.github.com/users/dlouapre/repos","events_url":"https://api.github.com/users/dlouapre/events{/privacy}","received_events_url":"https://api.github.com/users/dlouapre/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-03-10T07:45:52Z","updated_at":"2025-03-10T07:59:01Z","body":"Ok it clearly did reproduce on my other computer, and **it seems to be related to get_global_mouse_position()**\n\nI can't manage to attach a video file but here is a screenshot : \n\n![Image](https://github.com/user-attachments/assets/5b986d21-8fd9-4bdf-a6da-cce314e9967d)\n\nThis time I carefully placed the collision box between (40,40) and (60,60) and logged the position that was clicked.\n\nAs you can see, the intersect_point() is actually correct since it detects the collision box at the appropriate position. But the position that is returned by get_global_mouse_position() is wrong, it is offset by about 7 pixels on the horizontal axis and \n30 pixels on the vertical axis.\n\nMy hypothesis is that it corresponds to the \"margin\" that you see when the window is not full screen, see my red highlights below\n\n![Image](https://github.com/user-attachments/assets/cb963e8d-2b63-492e-9271-07c119f074e3)\n\nAgain the bug does not occur when the windows size is lower than screen resolution. Somehow it looks like when it is in full screen, the get_global_mouse_position is \"counting\" those little margins while it should not;\n\nI'll investigate more to understand in which screen / size conditions it occurs.\n\n**EDIT : Ok I got it.** It seems the problem occurs only when I choose a viewport size which corresponds to the screen resolution, but staying in \"Windowed\" mode.\n\n![Image](https://github.com/user-attachments/assets/2d78a101-f4b8-49a1-8740-802c29fa01f5)\n\n**When I switch to Fullscreen mode the bug disappear !**\n\nI understand that setting a viewport size equal to screen resolution without selecting \"Fullscreen\" mode is probably bad practice. I don't know if \"the bug\" is thus the expected behavior, but at least we have a workaround.\n\nFeel free to close this if you see fit.","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2709691413/reactions","total_count":2,"+1":2,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3074111743","html_url":"https://github.com/godotengine/godot/issues/103712#issuecomment-3074111743","issue_url":"https://api.github.com/repos/godotengine/godot/issues/103712","id":3074111743,"node_id":"IC_kwDOAO6SJc63Ozj_","user":{"login":"Calinou","id":180032,"node_id":"MDQ6VXNlcjE4MDAzMg==","avatar_url":"https://avatars.githubusercontent.com/u/180032?v=4","gravatar_id":"","url":"https://api.github.com/users/Calinou","html_url":"https://github.com/Calinou","followers_url":"https://api.github.com/users/Calinou/followers","following_url":"https://api.github.com/users/Calinou/following{/other_user}","gists_url":"https://api.github.com/users/Calinou/gists{/gist_id}","starred_url":"https://api.github.com/users/Calinou/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Calinou/subscriptions","organizations_url":"https://api.github.com/users/Calinou/orgs","repos_url":"https://api.github.com/users/Calinou/repos","events_url":"https://api.github.com/users/Calinou/events{/privacy}","received_events_url":"https://api.github.com/users/Calinou/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-07-15T15:22:16Z","updated_at":"2025-07-15T15:22:16Z","body":"I can't reproduce this on 4.5.beta 1d8e73849 (Linux):\n\nhttps://github.com/user-attachments/assets/65bb0eb2-0cdd-4931-bcd4-7a59036016ca\n\nIt works the same in fullscreen on a 4K display.","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3074111743/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null}]