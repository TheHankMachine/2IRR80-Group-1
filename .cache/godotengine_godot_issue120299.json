ub.com/users/blueskythlikesclouds/orgs","repos_url":"https://api.github.com/users/blueskythlikesclouds/repos","events_url":"https://api.github.com/users/blueskythlikesclouds/events{/privacy}","received_events_url":"https://api.github.com/users/blueskythlikesclouds/received_events","type":"User","user_view_type":"public","site_admin":false},"author_association":"NONE","issue_field_values":[],"type":null,"active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"### Tested versions\n\nReproducible in 4.7.rc.2\n\nWorks normal in 4.6.3.stable\n\n### System information\n\nAndroid 16 - Snapdragon 888 Adreno 660 - Godot 4.7 RC2\n\n### Issue description\n\nWhen launching a scene that has baked lighting with Forward Mobile on a phone, you can see some vulkan errors: EDIT: Fixed by #120363\n\n```\nE 0:00:02:491   render_pipeline_create: Couldn't create Vulkan graphics pipelines (VkResult error -13).\n  <Ошибка C++>  Condition \"err\" is true. Returning: PipelineID()\n  <Исходный код C++>drivers/vulkan/rendering_device_driver_vulkan.cpp:6219 @ render_pipeline_create()\n\nE 0:00:02:491   render_pipeline_create: Condition \"!pipeline.driver_id\" is true. Returning: RID()\n  <Исходный код C++>servers/rendering/rendering_device.cpp:4954 @ render_pipeline_create()\n\nE 0:00:02:491   _create_pipeline: Condition \"pipeline.is_null()\" is true.\n  <Исходный код C++>servers/rendering/renderer_rd/forward_mobile/scene_shader_forward_mobile.cpp:451 @ _create_pipeline()\n```\n\n<img width=\"935\" height=\"173\" alt=\"Image\" src=\"https://github.com/user-attachments/assets/dd5f045a-f7a3-4fe9-bcf1-e7befbf48855\" />\n\n<img width=\"1600\" height=\"716\" alt=\"Image\" src=\"https://github.com/user-attachments/assets/17442667-39bb-49fc-8bbd-4dfe3ff04ca4\" />\n\n\nThese do not happen if the lighting isn't baked.\n\nThere is also a case when most of the geometry doesn't render when lighting is baked when i have a light spot with these parameters (the issue is probably related to one of them). EDIT: the only geometry that doesnt render is the one that has light from the light spot. EDIT: This case is fixed by #120344 \n\n<img width=\"466\" height=\"730\" alt=\"Image\" src=\"https://github.com/user-attachments/assets/8efea01c-f606-4c57-8f21-dc09f9d5ea2f\" />\n\n```\nE 0:00:02:480   render_pipeline_create: Couldn't create Vulkan graphics pipelines (VkResult error -13).\n  <Ошибка C++>  Condition \"err\" is true. Returning: PipelineID()\n  <Исходный код C++>drivers/vulkan/rendering_device_driver_vulkan.cpp:6219 @ render_pipeline_create()\n\nE 0:00:02:480   render_pipeline_create: Condition \"!pipeline.driver_id\" is true. Returning: RID()\n  <Исходный код C++>servers/rendering/rendering_device.cpp:4954 @ render_pipeline_create()\n\nE 0:00:02:480   _create_pipeline: Condition \"pipeline.is_null()\" is true.\n  <Исходный код C++>servers/rendering/renderer_rd/forward_mobile/scene_shader_forward_mobile.cpp:451 @ _create_pipeline()\n\nE 0:00:03:546   render_pipeline_create: Couldn't create Vulkan graphics pipelines (VkResult error -13).\n  <Ошибка C++>  Condition \"err\" is true. Returning: PipelineID()\n  <Исходный код C++>drivers/vulkan/rendering_device_driver_vulkan.cpp:6219 @ render_pipeline_create()\n\nE 0:00:03:546   render_pipeline_create: Condition \"!pipeline.driver_id\" is true. Returning: RID()\n  <Исходный код C++>servers/rendering/rendering_device.cpp:4954 @ render_pipeline_create()\n\nE 0:00:03:546   _create_pipeline: Condition \"pipeline.is_null()\" is true.\n  <Исходный код C++>servers/rendering/renderer_rd/forward_mobile/scene_shader_forward_mobile.cpp:451 @ _create_pipeline()\n```\n\n<img width=\"1035\" height=\"205\" alt=\"Image\" src=\"https://github.com/user-attachments/assets/d2c1b17d-f112-466e-bd5c-4a7165688201\" />\n\n<img width=\"1600\" height=\"716\" alt=\"Image\" src=\"https://github.com/user-attachments/assets/62cb7895-1efb-4869-86db-a2f2a065061b\" />\n\n\n### Steps to reproduce\n\n1. Have any scene that has static lights and baked lighting\n2. Remote debug to a phone with Forward Mobile\n3. See vulkan related errors\n\n### Minimal reproduction project (MRP)\n\n[lightmap-bug.zip](https://github.com/user-attachments/files/28933917/lightmap-bug.zip)","closed_by":{"login":"Repiteo","id":17489292,"node_id":"MDQ6VXNlcjE3NDg5Mjky","avatar_url":"https://avatars.githubusercontent.com/u/17489292?v=4","gravatar_id":"","url":"https://api.github.com/users/Repiteo","html_url":"https://github.com/Repiteo","followers_url":"https://api.github.com/users/Repiteo/followers","following_url":"https://api.github.com/users/Repiteo/following{/other_user}","gists_url":"https://api.github.com/users/Repiteo/gists{/gist_id}","starred_url":"https://api.github.com/users/Repiteo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Repiteo/subscriptions","organizations_url":"https://api.github.com/users/Repiteo/orgs","repos_url":"https://api.github.com/users/Repiteo/repos","events_url":"https://api.github.com/users/Repiteo/events{/privacy}","received_events_url":"https://api.github.com/users/Repiteo/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/120299/reactions","total_count":1,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":1},"timeline_url":"https://api.github.com/repos/godotengine/godot/issues/120299/timeline","performed_via_github_app":null,"state_reason":"completed","pinned_comment":null}