al) const {\n+\treturn local_to_map(to_local(p_collision_point) - p_collision_normal);","path":"scene/2d/tile_map_layer.cpp","commit_id":"efdb2510e1a3549941b2fb71d987ec4287fc6e59","original_commit_id":"b933aeb5581107fccf688bf0f3c19ae797e4600d","user":{"login":"groud","id":6093119,"node_id":"MDQ6VXNlcjYwOTMxMTk=","avatar_url":"https://avatars.githubusercontent.com/u/6093119?v=4","gravatar_id":"","url":"https://api.github.com/users/groud","html_url":"https://github.com/groud","followers_url":"https://api.github.com/users/groud/followers","following_url":"https://api.github.com/users/groud/following{/other_user}","gists_url":"https://api.github.com/users/groud/gists{/gist_id}","starred_url":"https://api.github.com/users/groud/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/groud/subscriptions","organizations_url":"https://api.github.com/users/groud/orgs","repos_url":"https://api.github.com/users/groud/repos","events_url":"https://api.github.com/users/groud/events{/privacy}","received_events_url":"https://api.github.com/users/groud/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"Yeah but that might not be enough if the TileMap is scaled down a lot. \r\nThe problem is that, like, you add the normal to the point in the global space (before transforming it to local space). That means the added normal vector is of length 1px in the global space, and not in the TileMap's one.\r\n\r\nTo make sure it causes no issue, I think the normal vector's length needs to be adapted to the TileMap's scale. Maybe you can multiply the length of the normal vector by something like `min(tilemap.global_xform.scale.x, tilemap.global_xform.scale.y)` ? (something like that, I didn't try it out).\r\n\r\n","created_at":"2025-02-18T10:10:51Z","updated_at":"2025-02-18T10:10:51Z","html_url":"https://github.com/godotengine/godot/pull/102976#discussion_r1959440552","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/102976","_links":{"self":{"href":"https://api.github.com/repos/godotengine/godot/pulls/comments/1959440552"},"html":{"href":"https://github.com/godotengine/godot/pull/102976#discussion_r1959440552"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/102976"}},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/1959440552/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":null,"original_line":2747,"side":"RIGHT","in_reply_to_id":1958844952,"author_association":"MEMBER","original_position":13,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/1959633553","pull_request_review_id":2623378531,"id":1959633553,"node_id":"PRRC_kwDOAO6SJc50zaKR","diff_hunk":"@@ -2742,6 +2743,10 @@ Vector2i TileMapLayer::local_to_map(const Vector2 &p_pos) const {\n \treturn tile_set->local_to_map(p_pos);\n }\n \n+Vector2i TileMapLayer::collision_to_map(const Vector2 &p_collision_point, const Vector2 &p_collision_normal) const {\n+\treturn local_to_map(to_local(p_collision_point) - p_collision_normal);","path":"scene/2d/tile_map_layer.cpp","commit_id":"efdb2510e1a3549941b2fb71d987ec4287fc6e59","original_commit_id":"b933aeb5581107fccf688bf0f3c19ae797e4600d","user":{"login":"kleonc","id":9283098,"node_id":"MDQ6VXNlcjkyODMwOTg=","avatar_url":"https://avatars.githubusercontent.com/u/9283098?v=4","gravatar_id":"","url":"https://api.github.com/users/kleonc","html_url":"https://github.com/kleonc","followers_url":"https://api.github.com/users/kleonc/followers","following_url":"https://api.github.com/users/kleonc/following{/other_user}","gists_url":"https://api.github.com/users/kleonc/gists{/gist_id}","starred_url":"https://api.github.com/users/kleonc/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/kleonc/subscriptions","organizations_url":"https://api.github.com/users/kleonc/orgs","repos_url":"https://api.github.com/users/kleonc/repos","events_url":"https://api.github.com/users/kleonc/events{/privacy}","received_events_url":"https://api.github.com/users/kleonc/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"As you mentioned TileMap can also be rotated etc., so direction might change too. This should do what you've suggested I think:\r\n```cpp\r\nTransform2D global_inv = get_global_transform().affine_inverse();\r\nreturn local_to_map(global_inv.xform(p_collision_point) - 0.5 * global_inv.basis_xform(p_collision_normal).normalized());\r\n```","created_at":"2025-02-18T12:16:08Z","updated_at":"2025-02-18T12:16:08Z","html_url":"https://github.com/godotengine/godot/pull/102976#discussion_r1959633553","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/102976","_links":{"self":{"href":"https://api.github.com/repos/godotengine/godot/pulls/comments/1959633553"},"html":{"href":"https://github.com/godotengine/godot/pull/102976#discussion_r1959633553"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/102976"}},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/1959633553/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":null,"original_line":2747,"side":"RIGHT","in_reply_to_id":1958844952,"author_association":"MEMBER","original_position":13,"position":1,"subject_type":"line"}]