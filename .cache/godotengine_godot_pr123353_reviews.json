[{"id":5163019397,"node_id":"PRR_kwDOAO6SJc8AAAABM71shQ","user":{"login":"Cykyrios","id":53737317,"node_id":"MDQ6VXNlcjUzNzM3MzE3","avatar_url":"https://avatars.githubusercontent.com/u/53737317?u=8c88d6549674d28d75ff9963bea85eec378843a7&v=4","gravatar_id":"","url":"https://api.github.com/users/Cykyrios","html_url":"https://github.com/Cykyrios","followers_url":"https://api.github.com/users/Cykyrios/followers","following_url":"https://api.github.com/users/Cykyrios/following{/other_user}","gists_url":"https://api.github.com/users/Cykyrios/gists{/gist_id}","starred_url":"https://api.github.com/users/Cykyrios/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Cykyrios/subscriptions","organizations_url":"https://api.github.com/users/Cykyrios/orgs","repos_url":"https://api.github.com/users/Cykyrios/repos","events_url":"https://api.github.com/users/Cykyrios/events{/privacy}","received_events_url":"https://api.github.com/users/Cykyrios/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"Tested locally, this works as expected both in the editor and with `doctool`. The only thing of note is that this doesn't strip the trailing space from the previous line, so any line before an admonition tag has a trailing space.\r\n\r\nEdit: I added this small test to GDScriptParser to remove the trailing spaces:\r\n```diff\r\n@@ -3937,6 +3937,20 @@ static void _process_doc_line(const String &p_line, String &r_text, const String\r\n \t\tline = line.trim_prefix(p_space_prefix);\r\n \t}\r\n \r\n+\tLocalVector<String> no_space_tags = {\r\n+\t\t\"[note]\",\r\n+\t\t\"[warning]\",\r\n+\t\t\"[important]\",\r\n+\t\t\"[tip]\",\r\n+\t};\r\n+\tbool line_begins_with_no_space_tag = false;\r\n+\tfor (String tag : no_space_tags) {\r\n+\t\tif (line.begins_with(tag)) {\r\n+\t\t\tline_begins_with_no_space_tag = true;\r\n+\t\t\tbreak;\r\n+\t\t}\r\n+\t}\r\n+\r\n \tString line_join;\r\n \tif (!r_text.is_empty()) {\r\n \t\tif (r_state == DOC_LINE_NORMAL) {\r\n@@ -3946,7 +3960,7 @@ static void _process_doc_line(const String &p_line, String &r_text, const String\r\n \t\t\t\t// We want to replace `[br][br]` with `\\n` (paragraph), so we move the trailing `[br]` here.\r\n \t\t\t\tr_text = r_text.left(-4); // `-len(\"[br]\")`.\r\n \t\t\t\tline = \"[br]\" + line;\r\n-\t\t\t} else if (!r_text.ends_with(\"\\n\")) {\r\n+\t\t\t} else if (!r_text.ends_with(\"\\n\") && !line_begins_with_no_space_tag) {\r\n \t\t\t\tline_join = \" \";\r\n \t\t\t}\r\n \t\t} else {\r\n```","state":"APPROVED","html_url":"https://github.com/godotengine/godot/pull/123353#pullrequestreview-5163019397","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/123353","author_association":"CONTRIBUTOR","_links":{"html":{"href":"https://github.com/godotengine/godot/pull/123353#pullrequestreview-5163019397"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/123353"}},"submitted_at":"2026-09-10T05:18:01Z","commit_id":"d46fd49e0ea7d02b5eff737cd994154b8be68fb4"},{"id":5405135646,"node_id":"PRR_kwDOAO6SJc8AAAABQivTHg","user":{"login":"HolonProduction","id":99511741,"node_id":"U_kgDOBe5tvQ","avatar_url":"https://avatars.githubusercontent.com/u/99511741?u=b7882c94f408976a2f79e8fe6e1ce27fbd48db74&v=4","gravatar_id":"","url":"https://api.github.com/users/HolonProduction","html_url":"https://github.com/HolonProduction","followers_url":"https://api.github.com/users/HolonProduction/followers","following_url":"https://api.github.com/users/HolonProduction/following{/other_user}","gists_url":"https://api.github.com/users/HolonProduction/gists{/gist_id}","starred_url":"https://api.github.com/users/HolonProduction/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/HolonProduction/subscriptions","organizations_url":"https://api.github.com/users/HolonProduction/orgs","repos_url":"https://api.github.com/users/HolonProduction/repos","events_url":"https://api.github.com/users/HolonProduction/events{/privacy}","recei