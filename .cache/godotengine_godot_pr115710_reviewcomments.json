ontent.com/u/31065808?v=4","gravatar_id":"","url":"https://api.github.com/users/deralmas","html_url":"https://github.com/deralmas","followers_url":"https://api.github.com/users/deralmas/followers","following_url":"https://api.github.com/users/deralmas/following{/other_user}","gists_url":"https://api.github.com/users/deralmas/gists{/gist_id}","starred_url":"https://api.github.com/users/deralmas/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/deralmas/subscriptions","organizations_url":"https://api.github.com/users/deralmas/orgs","repos_url":"https://api.github.com/users/deralmas/repos","events_url":"https://api.github.com/users/deralmas/events{/privacy}","received_events_url":"https://api.github.com/users/deralmas/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"Adding to ATS' findings, code-wise, on Linux/BSD, `FileAccessUnix::seek_end` does _no_ checks for this. It just passes the offset to `fseeko` with `SEEK_END`, which simply adds the offset to the end-of-file.\r\n\r\nPOSIX manual says:\r\n\r\n> The new position, measured in bytes from the beginning of the file, shall be obtained by adding offset to the position specified by whence. The specified point is the beginning of the file for SEEK_SET, the current value of the file-position indicator for SEEK_CUR, or end-of- file for SEEK_END.\r\n\r\n`core/io/file_access.h` says `///< seek from the end of file with negative offset` but apparently the negative offset is supposed to be provided by the user.\r\n\r\nSo this looks like intended behavior, probably as a result of mirroring system APIs.","created_at":"2026-02-02T15:00:37Z","updated_at":"2026-02-02T15:00:37Z","html_url":"https://github.com/godotengine/godot/pull/115710#discussion_r2754781844","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/115710","_links":{"self":{"href":"https://api.github.com/repos/godotengine/godot/pulls/comments/2754781844"},"html":{"href":"https://github.com/godotengine/godot/pull/115710#discussion_r2754781844"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/115710"}},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/2754781844/reactions","total_count":3,"+1":3,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":null,"original_line":206,"side":"RIGHT","in_reply_to_id":2754460313,"author_association":"MEMBER","original_position":5,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/2754795475","pull_request_review_id":3740019431,"id":2754795475,"node_id":"PRRC_kwDOAO6SJc6kMtfT","diff_hunk":"@@ -203,7 +203,7 @@ internal abstract class DataAccess {\n \tabstract fun write(buffer: ByteBuffer): Boolean\n \n \tfun seekFromEnd(positionFromEnd: Long) {\n-\t\tval positionFromBeginning = max(0, size() - positionFromEnd)\n+\t\tval positionFromBeginning = max(0, size() + positionFromEnd)","path":"platform/android/java/lib/src/main/java/org/godotengine/godot/io/file/DataAccess.kt","commit_id":"56acd63f1f54580f02cb6a789122b107af8f1101","original_commit_id":"42a6806ef018ca42efb01b316381845df841ba82","user":{"login":"AThousandShips","id":96648715,"node_id":"U_kgDOBcK-Cw","avatar_url":"https://avatars.githubusercontent.com/u/96648715?v=4","gravatar_id":"","url":"https://api.github.com/users/AThousandShips","html_url":"https://github.com/AThousandShips","followers_url":"https://api.github.com/users/AThousandShips/followers","following_url":"https://api.github.com/users/AThousandShips/following{/other_user}","gists_url":"https://api.github.com/users/AThousandShips/gists{/gist_id}","starred_url":"https://api.github.com/users/AThousandShips/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/AThousandShips/subscriptions","organizations_url":"https://api.github.com/users/AThousandShips/orgs","repos_url":"https://a