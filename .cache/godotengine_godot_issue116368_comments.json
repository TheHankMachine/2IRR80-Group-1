1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5004313610","html_url":"https://github.com/godotengine/godot/pull/116368#issuecomment-5004313610","issue_url":"https://api.github.com/repos/godotengine/godot/issues/116368","id":5004313610,"node_id":"IC_kwDOAO6SJc8AAAABKkfECg","user":{"login":"HolonProduction","id":99511741,"node_id":"U_kgDOBe5tvQ","avatar_url":"https://avatars.githubusercontent.com/u/99511741?v=4","gravatar_id":"","url":"https://api.github.com/users/HolonProduction","html_url":"https://github.com/HolonProduction","followers_url":"https://api.github.com/users/HolonProduction/followers","following_url":"https://api.github.com/users/HolonProduction/following{/other_user}","gists_url":"https://api.github.com/users/HolonProduction/gists{/gist_id}","starred_url":"https://api.github.com/users/HolonProduction/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/HolonProduction/subscriptions","organizations_url":"https://api.github.com/users/HolonProduction/orgs","repos_url":"https://api.github.com/users/HolonProduction/repos","events_url":"https://api.github.com/users/HolonProduction/events{/privacy}","received_events_url":"https://api.github.com/users/HolonProduction/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-07-17T14:30:01Z","updated_at":"2026-07-17T14:30:01Z","body":"Well I'm still seeing an outstanding comment from myself, so I haven't really tried taking a closer look.","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5004313610/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5023631349","html_url":"https://github.com/godotengine/godot/pull/116368#issuecomment-5023631349","issue_url":"https://api.github.com/repos/godotengine/godot/issues/116368","id":5023631349,"node_id":"IC_kwDOAO6SJc8AAAABK26H9Q","user":{"login":"HolonProduction","id":99511741,"node_id":"U_kgDOBe5tvQ","avatar_url":"https://avatars.githubusercontent.com/u/99511741?v=4","gravatar_id":"","url":"https://api.github.com/users/HolonProduction","html_url":"https://github.com/HolonProduction","followers_url":"https://api.github.com/users/HolonProduction/followers","following_url":"https://api.github.com/users/HolonProduction/following{/other_user}","gists_url":"https://api.github.com/users/HolonProduction/gists{/gist_id}","starred_url":"https://api.github.com/users/HolonProduction/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/HolonProduction/subscriptions","organizations_url":"https://api.github.com/users/HolonProduction/orgs","repos_url":"https://api.github.com/users/HolonProduction/repos","events_url":"https://api.github.com/users/HolonProduction/events{/privacy}","received_events_url":"https://api.github.com/users/HolonProduction/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-07-20T14:52:35Z","updated_at":"2026-07-20T14:52:35Z","body":"The description of this PR focuses on \"hard reloads\", which I personally don't know as a concept in the codebase. I suppose you are referring to the category of parameters on reload methods, that are under-documented and partially unused (see https://github.com/godotengine/godot/pull/121567). But it isn't really clear to me what the approach is trying to do, could you maybe clarify that.\r\n\r\n(The PR that you are superseding has a straight forward premise: when changing a script to be `@tool` we need to convert placeholder instances to actual instances. I can follow that and it makes sense to me. Does this PR deviate from that idea, or did you just describe it differently I don't get the new description?)\r\n\r\n","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5023631349/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5025008384","html_url":"https://github.com/godotengine/godot/pull/116368#issuecomment-5025008384","issue_url":"https://api.github.com/repos/godotengine/godot/issues/116368","id":5025008384,"node_id":"IC_kwDOAO6SJc8AAAABK4OLAA","user":{"login":"ColinSORourke","id":44822820,"node_id":"MDQ6VXNlcjQ0ODIyODIw","avatar_url":"https://avatars.githubusercontent.com/u/44822820?v=4","gravatar_id":"","url":"https://api.github.com/users/ColinSORourke","html_url":"https://github.com/ColinSORourke","followers_url":"https://api.github.com/users/ColinSORourke/followers","following_url":"https://api.github.com/users/ColinSORourke/following{/other_user}","gists_url":"https://api.github.com/users/ColinSORourke/gists{/gist_id}","starred_url":"https://api.github.com/users/ColinSORourke/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/ColinSORourke/subscriptions","organizations_url":"https://api.github.com/users/ColinSORourke/orgs","repos_url":"https://api.github.com/users/ColinSORourke/repos","events_url":"https://api.github.com/users/ColinSORourke/events{/privacy}","received_events_url":"https://api.github.com/users/ColinSORourke/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-07-20T17:12:48Z","updated_at":"2026-07-20T17:16:28Z","body":"@HolonProduction I see your point about my new description being confusing, but my PR does implement the same logic as the original, but changes the if condition to include reloading upon any modification to a `@tool` script, focused on resolving https://github.com/godotengine/godot/issues/115187 and https://github.com/godotengine/godot/issues/114485\r\n\r\nSee my original comment:\r\nhttps://github.com/godotengine/godot/pull/92099#issuecomment-3704463117\r\n\r\nHilderin's If Statement\r\n```\r\nif (p_soft_reload && was_tool != scr->is_tool()) {\r\n\t_prepare_script_for_reload(scr, to_reload[scr]);\r\n}\r\n```\r\nWill only force a hard reload if a Script has `@tool` added or removed.\r\n\r\nMy If Statement\r\n```\r\nif (scr->is_tool() || was_tool) {\r\n\t_prepare_script_for_reload(scr, to_reload[scr]);\r\n}\r\n```\r\nStill forces a hard reload when `@tool` is added or removed, and will also force a hard reload upon any other modification to a script that is a tool. This is because the live ScriptInstances representing a tool script can become stale and produce inconsistent behavior if the tool script is only soft-reloaded. ","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5025008384/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5115029650","html_url":"https://github.com/godotengine/godot/pull/116368#issuecomment-5115029650","issue_url":"https://api.github.com/repos/godotengine/godot/issues/116368","id":5115029650,"node_id":"IC_kwDOAO6SJc8AAAABMOEokg","user":{"login":"HolonProduction","id":99511741,"node_id":"U_kgDOBe5tvQ","avatar_url":"https://avatars.githubusercontent.com/u/99511741?v=4","gravatar_id":"","url":"https://api.github.com/users/HolonProduction","html_url":"https://github.com/HolonProduction","followers_url":"https://api.github.com/users/HolonProduction/followers","following_url":"https://api.github.com/users/HolonProduction/following{/other_user}","gists_url":"https://api.github.com/users/HolonProduction/gists{/gist_id}","starred_url":"https://api.github.com/users/HolonProduction/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/HolonProduction/subscriptions","organizations_url":"https://api.github.com/users/HolonProduction/orgs","repos_url":"https://api.github.com/users/HolonProduction/repos","events_url":"https://api.github.com/users/HolonProduction/events{/privacy}","received_events_url":"https://api.github.com/users/HolonProduction/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-07-29T08:24:58Z","updated_at":"2026-07-29T08:24:58Z","body":"Needs a rebase after https://github.com/godotengine/godot/pull/121567\r\n\r\nWith the \"soft\" vs \"hard\" reload difference now out of the window, the comments in this PR also need be adjusted.","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5115029650/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5197976019","html_url":"https://github.com/godotengine/godot/pull/116368#issuecomment-5197976019","issue_url":"https://api.github.com/repos/godotengine/godot/issues/116368","id":5197976019,"node_id":"IC_kwDOAO6SJc8AAAABNdLR0w","user":{"login":"ColinSORourke","id":44822820,"node_id":"MDQ6VXNlcjQ0ODIyODIw","avatar_url":"https://avatars.githubusercontent.com/u/44822820?v=4","gravatar_id":"","url":"https://api.github.com/users/ColinSORourke","html_url":"https://github.com/ColinSORourke","followers_url":"https://api.github.com/users/ColinSORourke/followers","following_url":"https://api.github.com/users/ColinSORourke/following{/other_user}","gists_url":"https://api.github.com/users/ColinSORourke/gists{/gist_id}","starred_url":"https://api.github.com/users/ColinSORourke/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/ColinSORourke/subscriptions","organizations_url":"https://api.github.com/users/ColinSORourke/orgs","repos_url":"https://api.github.com/users/ColinSORourke/repos","events_url":"https://api.github.com/users/ColinSORourke/events{/privacy}","received_events_url":"https://api.github.com/users/ColinSORourke/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-08-05T22:10:40Z","updated_at":"2026-08-05T22:12:00Z","body":"Appreciate you clearing that up! Rebuilt this branch, and tested and verified it still works - adjusted comments in the code to be more accurate:\r\n\r\n> // If @tool is added/removed, or an existing tool script is changed, we will force a reload.\r\n>  // On add/removal, changes placeholder instance to an actual instance or vice versa.\r\n>  // On Tool Script change, replaces a stale instance with an up-to-date GDscriptInstance for consistent behavior.\r\n\r\nhttps://github.com/godotengine/godot/pull/116368/changes#diff-2d47041c61b0e94d891650482b0cf9398f22729abdc811f94c2b7da902ed392fR2571\r\n\r\nAnd I also tested a few behaviors that this intends to resolve on Master, and confirmed they are still broken without this fix. \r\n\r\nThe most egregious example, and the reason I adjusted the if condition to include Tool Script edits, is a crash that can occur from a stale instance accessing bad memory.\r\n\r\n```@tool\r\nextends Control\r\n\r\nvar myPB4 : PackedByteArray = []\r\n\r\n@export_tool_button(\"Resize\")\r\nvar resize_action = resizePB\r\n\r\nfunc resizePB() -> void:\r\n\tmyPB4.resize(10)\r\n```\r\n\t\r\nThis code will cause the editor to crash if the PackedByteArray has its name changed, and then the ResizeFunction is called via tool button. Still crashes on Master, behaves appropriately on this branch.","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5197976019/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https: