[{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2642067430","html_url":"https://github.com/godotengine/godot/issues/102484#issuecomment-2642067430","issue_url":"https://api.github.com/repos/godotengine/godot/issues/102484","id":2642067430,"node_id":"IC_kwDOAO6SJc6der_m","user":{"login":"beicause","id":75941842,"node_id":"MDQ6VXNlcjc1OTQxODQy","avatar_url":"https://avatars.githubusercontent.com/u/75941842?v=4","gravatar_id":"","url":"https://api.github.com/users/beicause","html_url":"https://github.com/beicause","followers_url":"https://api.github.com/users/beicause/followers","following_url":"https://api.github.com/users/beicause/following{/other_user}","gists_url":"https://api.github.com/users/beicause/gists{/gist_id}","starred_url":"https://api.github.com/users/beicause/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/beicause/subscriptions","organizations_url":"https://api.github.com/users/beicause/orgs","repos_url":"https://api.github.com/users/beicause/repos","events_url":"https://api.github.com/users/beicause/events{/privacy}","received_events_url":"https://api.github.com/users/beicause/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-02-07T06:40:42Z","updated_at":"2025-02-07T06:54:36Z","body":"The problem may come from `Callable.From`. I found a workaround by using `new Callable(this, \"xxx\")`, but the limitation is that can't capture other variables.","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2642067430/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2642809237","html_url":"https://github.com/godotengine/godot/issues/102484#issuecomment-2642809237","issue_url":"https://api.github.com/repos/godotengine/godot/issues/102484","id":2642809237,"node_id":"IC_kwDOAO6SJc6dhhGV","user":{"login":"beicause","id":75941842,"node_id":"MDQ6VXNlcjc1OTQxODQy","avatar_url":"https://avatars.githubusercontent.com/u/75941842?v=4","gravatar_id":"","url":"https://api.github.com/users/beicause","html_url":"https://github.com/beicause","followers_url":"https://api.github.com/users/beicause/followers","following_url":"https://api.github.com/users/beicause/following{/other_user}","gists_url":"https://api.github.com/users/beicause/gists{/gist_id}","starred_url":"https://api.github.com/users/beicause/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/beicause/subscriptions","organizations_url":"https://api.github.com/users/beicause/orgs","repos_url":"https://api.github.com/users/beicause/repos","events_url":"https://api.github.com/users/beicause/events{/privacy}","received_events_url":"https://api.github.com/users/beicause/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-02-07T12:39:17Z","updated_at":"2025-02-07T14:40:11Z","body":"I think I found the reason. It is a legacy issue mentioned in #83217 that hasn't been solved yet. Callables capturing Object or variables that cannot be serialized (such as C# types that don't belong to Godot) will lead to this issue.\nWorkaround:\n```c#\n\tvar instId = GetInstanceId();\n\ttween.TweenMethod(\n\tCallable.From((Vector2 pos) =>\n\t{\n\t\tif (InstanceFromId(instId) is Node2D node)\n\t\t{\n\t\t\tnode.Position = pos;\n\t\t}\n\t}), Vector2.Zero, new Vector2(200, 200), 1);\n```","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2642809237/reactions","total_count":2,"+1":2,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2645419822","html_url":"https://github.com/godotengine/godot/issues/102484#issuecomment-2645419822","issue_url":"https://api.github.com/repos/godotengine/godot/issues/102484","id":2645419822,"node_id":"IC_kwDOAO6SJc6drecu","user":{"login":"Delsin-Yu","id":71481700,"node_id":"MDQ6VXNlcjcxNDgxNzAw","avatar_url":"https://avatars.githubusercontent.com/u/71481700?v=4","gravatar_id":"","url":"https://api.github.com/users/Delsin-Yu","html_url":"https://github.com/Delsin-Yu","followers_url":"https://api.github.com/users/Delsin-Yu/followers","following_url":"https://api.github.com/users/Delsin-Yu/following{/other_user}","gists_url":"https://api.github.com/users/Delsin-Yu/gists{/gist_id}","starred_url":"https://api.github.com/users/Delsin-Yu/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Delsin-Yu/subscriptions","organizations_url":"https://api.github.com/users/Delsin-Yu/orgs","repos_url":"https://api.github.com/users/Delsin-Yu/repos","events_url":"https://api.github.com/users/Delsin-Yu/events{/privacy}","received_events_url":"https://api.github.com/users/Delsin-Yu/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-02-08T12:46:41Z","updated_at":"2025-02-08T12:46:41Z","body":"It might be worth notifying @paulloz , the original PR author.","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2645419822/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2645948651","html_url":"https://github.com/godotengine/godot/issues/102484#issuecomment-2645948651","issue_url":"https://api.github.com/repos/godotengine/godot/issues/102484","id":2645948651,"node_id":"IC_kwDOAO6SJc6dtfjr","user":{"login":"BrahRah","id":40721994,"node_id":"MDQ6VXNlcjQwNzIxOTk0","avatar_url":"https://avatars.githubusercontent.com/u/40721994?v=4","gravatar_id":"","url":"https://api.github.com/users/BrahRah","html_url":"https://github.com/BrahRah","followers_url":"https://api.github.com/users/BrahRah/followers","following_url":"https://api.github.com/users/BrahRah/following{/other_user}","gists_url":"https://api.github.com/users/BrahRah/gists{/gist_id}","starred_url":"https://api.github.com/users/BrahRah/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/BrahRah/subscriptions","organizations_url":"https://api.github.com/users/BrahRah/orgs","repos_url":"https://api.github.com/users/BrahRah/repos","events_url":"https://api.github.com/users/BrahRah/events{/privacy}","received_events_url":"https://api.github.com/users/BrahRah/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-02-08T21:24:22Z","updated_at":"2025-02-08T21:25:07Z","body":"Here is what I've come up with to fix the assembly disconnect issue:\n\nGodot will emit a pre-build signal, allowing subscribed addons to unload .NET resources if needed. Once all have confirmed unloading, the build starts. After completion, a post-build signal is sent, prompting addons to reload their resources. This ensures only necessary addons pause the build, preventing .NET disconnection issues efficiently.\n\nSomeone with the skills please implement this! I've got 3 addons to release which I can't as long as this issue is around.","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2645948651/reactions","total_count":1,"+1":0,"-1":1,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2646087983","html_url":"https://github.com/godotengine/godot/issues/102484#issuecomment-2646087983","issue_url":"https://api.github.com/repos/godotengine/godot/issues/102484","id":2646087983,"node_id":"IC_kwDOAO6SJc6duBkv","user":{"login":"beicause","id":75941842,"node_id":"MDQ6VXNlcjc1OTQxODQy","avatar_url":"https://avatars.githubusercontent.com/u/75941842?v=4","gravatar_id":"","url":"https://api.github.com/users/beicause","html_url":"https://github.com/beicause","followers_url":"https://api.github.com/users/beicause/followers","following_url":"https://api.github.com/users/beicause/following{/other_user}","gists_url":"https://api.github.com/users/beicause/gists{/gist_id}","starred_url":"https://api.github.com/users/beicause/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/beicause/subscriptions","organizations_url":"https://api.github.com/users/beicause/orgs","repos_url":"https://api.github.com/users/beicause/repos","events_url":"https://api.github.com/users/beicause/events{/privacy}","received_events_url":"https://api.github.com/users/beicause/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-02-09T06:11:08Z","updated_at":"2025-02-09T06:11:08Z","body":"Notably, after I migrate my script to the parent node and capture and tween the **child** node instead of itself, it seems to work well. I'm not sure about the reason. \n```cs\n\tvar child = GetNode<Node2D>(\"Node2D\");\n\tvar tween = CreateTween(); ;\n\ttween.TweenMethod(\n\t\tCallable.From((Vector2 pos) =>\n\t\t{\n\t\tchild.Position = pos;\n\t\t}), Vector2.Zero, new Vector2(200, 200), 1);\n```","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2646087983/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2646342917","html_url":"https://github.com/godotengine/godot/issues/102484#issuecomment-2646342917","issue_url":"https://api.github.com/repos/godotengine/godot/issues/102484","id":2646342917,"node_id":"IC_kwDOAO6SJc6du_0F","user":{"login":"Delsin-Yu","id":71481700,"node_id":"MDQ6VXNlcjcxNDgxNzAw","avatar_url":"https://avatars.githubusercontent.com/u/71481700?v=4","gravatar_id":"","url":"https://api.github.com/users/Delsin-Yu","html_url":"https://github.com/Delsin-Yu","followers_url":"https://api.github.com/users/Delsin-Yu/followers","following_url":"https://api.github.com/users/Delsin-Yu/following{/other_user}","gists_url":"https://api.github.com/users/Delsin-Yu/gists{/gist_id}","starred_url":"https://api.github.com/users/Delsin-Yu/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Delsin-Yu/subscriptions","organizations_url":"https://api.github.com/users/Delsin-Yu/orgs","repos_url":"https://api.github.com/users/Delsin-Yu/repos","events_url":"https://api.github.com/users/Delsin-Yu/events{/privacy}","received_events_url":"https://api.github.com/users/Delsin-Yu/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-02-09T14:54:50Z","updated_at":"2025-02-09T14:54:50Z","body":"@BrahRah Please do not spam the same message all over the place; you have already posted the identical message in #78513 ","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2646342917/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null}]