ithub.com/users/solodeveloping","html_url":"https://github.com/solodeveloping","followers_url":"https://api.github.com/users/solodeveloping/followers","following_url":"https://api.github.com/users/solodeveloping/following{/other_user}","gists_url":"https://api.github.com/users/solodeveloping/gists{/gist_id}","starred_url":"https://api.github.com/users/solodeveloping/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/solodeveloping/subscriptions","organizations_url":"https://api.github.com/users/solodeveloping/orgs","repos_url":"https://api.github.com/users/solodeveloping/repos","events_url":"https://api.github.com/users/solodeveloping/events{/privacy}","received_events_url":"https://api.github.com/users/solodeveloping/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-06-24T18:31:20Z","updated_at":"2026-06-24T18:31:20Z","body":"Could be, I had not checked 2D, and I toggle the visibility, I don't disable them, but I guess it might be similar","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4792454951/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4793721865","html_url":"https://github.com/godotengine/godot/issues/120619#issuecomment-4793721865","issue_url":"https://api.github.com/repos/godotengine/godot/issues/120619","id":4793721865,"node_id":"IC_kwDOAO6SJc8AAAABHbpkCQ","user":{"login":"smix8","id":52464204,"node_id":"MDQ6VXNlcjUyNDY0MjA0","avatar_url":"https://avatars.githubusercontent.com/u/52464204?v=4","gravatar_id":"","url":"https://api.github.com/users/smix8","html_url":"https://github.com/smix8","followers_url":"https://api.github.com/users/smix8/followers","following_url":"https://api.github.com/users/smix8/following{/other_user}","gists_url":"https://api.github.com/users/smix8/gists{/gist_id}","starred_url":"https://api.github.com/users/smix8/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/smix8/subscriptions","organizations_url":"https://api.github.com/users/smix8/orgs","repos_url":"https://api.github.com/users/smix8/repos","events_url":"https://api.github.com/users/smix8/events{/privacy}","received_events_url":"https://api.github.com/users/smix8/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-06-24T21:14:58Z","updated_at":"2026-06-24T21:14:58Z","body":"That is because change in https://github.com/godotengine/godot/pull/90644 sets the custom debug color and fill option on every single collision shape when the shape resource is set. Each of those newer debug setters forces a shape update and clear of the debug mesh cache and a changed signal emit. So especially a tool script ends up updating the debug shape over and over and over and convex shapes have a costly point-to-hull calculation on top.","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4793721865/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4794497956","html_url":"https://github.com/godotengine/godot/issues/120619#issuecomment-4794497956","issue_url":"https://api.github.com/repos/godotengine/godot/issues/120619","id":4794497956,"node_id":"IC_kwDOAO6SJc8AAAABHcY7pA","user":{"login":"solodeveloping","id":155950383,"node_id":"U_kgDOCUudLw","avatar_url":"https://avatars.githubusercontent.com/u/155950383?v=4","gravatar_id":"","url":"https://api.github.com/users/solodeveloping","html_url":"https://github.com/solodeveloping","followers_url":"https://api.github.com/users/solodeveloping/followers","following_url":"https://api.github.com/users/solodeveloping/following{/other_user}","gists_url":"https://api.github.com/users/solodeveloping/gists{/gist_id}","starred_url":"https://api.github.com/users/solodeveloping/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/solodeveloping/subscriptions","organizations_url":"https://api.github.com/users/solodeveloping/orgs","repos_url":"https://api.github.com/users/solodeveloping/repos","events_url":"https://api.github.com/users/solodeveloping/events{/privacy}","received_events_url":"https://api.github.com/users/solodeveloping/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-06-24T23:31:16Z","updated_at":"2026-06-25T01:35:15Z","body":"Okay, is there something else to do other than updating the scenes/code to hide the shapes?","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4794497956/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4797388728","html_url":"https://github.com/godotengine/godot/issues/120619#issuecomment-4797388728","issue_url":"https://api.github.com/repos/godotengine/godot/issues/120619","id":4797388728,"node_id":"IC_kwDOAO6SJc8AAAABHfJXuA","user":{"login":"smix8","id":52464204,"node_id":"MDQ6VXNlcjUyNDY0MjA0","avatar_url":"https://avatars.githubusercontent.com/u/52464204?v=4","gravatar_id":"","url":"https://api.github.com/users/smix8","html_url":"https://github.com/smix8","followers_url":"https://api.github.com/users/smix8/followers","following_url":"https://api.github.com/users/smix8/following{/other_user}","gists_url":"https://api.github.com/users/smix8/gists{/gist_id}","starred_url":"https://api.github.com/users/smix8/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/smix8/subscriptions","organizations_url":"https://api.github.com/users/smix8/orgs","repos_url":"https://api.github.com/users/smix8/repos","events_url":"https://api.github.com/users/smix8/events{/privacy}","received_events_url":"https://api.github.com/users/smix8/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-06-25T08:40:34Z","updated_at":"2026-06-25T12:43:03Z","body":"There is no simple solution here because the debug mesh cache that does all the performance costly things is inside the Shape3D resource and gets triggered on setters everytime that Resource is used. It just happen to be used by anything that tries to render the debug mesh but it also happens everytime a new Node instance tries to call the resource setters like the CollisionObject3D does when entering the tree. Inside the Editor there is also the gizmo that does the actual rendering and not the node. So both the editor debug, the runtime debug, and the shape resource need to be fixed in that regard to avoid unnecessary performance problems when the debug is not visible.","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4797388728/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4801022890","html_url":"https://github.com/godotengine/godot/issues/120619#issuecomment-4801022890","issue_url":"https://api.github.com/repos/godotengine/godot/issues/120619","id":4801022890,"node_id":"IC_kwDOAO6SJc8AAAABHinLqg","user":{"login":"solodeveloping","id":155950383,"node_id":"U_kgDOCUudLw","avatar_url":"https://avatars.githubusercontent.com/u/155950383?v=4","gravatar_id":"","url":"https://api.github.com/users/solodeveloping","html_url":"https://github.com/solodeveloping","followers_url":"https://api.github.com/users/solodeveloping/followers","following_url":"https://api.github.com/users/solodeveloping/following{/other_user}","gists_url":"https://api.github.com/users/solodeveloping/gists{/gist_id}","starred_url":"https://api.github.com/users/solodeveloping/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/solodeveloping/subscriptions","organizations_url":"https://api.github.com/users/solodeveloping/orgs","repos_url":"https://api.github.com/users/solodeveloping/repos","events_url":"https://api.github.com/users/solodeveloping/events{/privacy}","received_events_url":"https://api.github.com/users/solodeveloping/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-06-25T15:23:54Z","updated_at":"2026-06-25T15:23:54Z","body":"Thank you, I'll update my scenes and scripts","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4801022890/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null}]