com/Lazy-Rabbit-2001","followers_url":"https://api.github.com/users/Lazy-Rabbit-2001/followers","following_url":"https://api.github.com/users/Lazy-Rabbit-2001/following{/other_user}","gists_url":"https://api.github.com/users/Lazy-Rabbit-2001/gists{/gist_id}","starred_url":"https://api.github.com/users/Lazy-Rabbit-2001/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Lazy-Rabbit-2001/subscriptions","organizations_url":"https://api.github.com/users/Lazy-Rabbit-2001/orgs","repos_url":"https://api.github.com/users/Lazy-Rabbit-2001/repos","events_url":"https://api.github.com/users/Lazy-Rabbit-2001/events{/privacy}","received_events_url":"https://api.github.com/users/Lazy-Rabbit-2001/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2024-11-30T12:41:28Z","updated_at":"2024-11-30T12:52:00Z","body":"> Will this break gdextension?\r\n\r\nno, as this does not support gdextension.\r\ngdextension, except `.gdextension` file, is basically not a text resource","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2508949670/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2509046503","html_url":"https://github.com/godotengine/godot/pull/99868#issuecomment-2509046503","issue_url":"https://api.github.com/repos/godotengine/godot/issues/99868","id":2509046503,"node_id":"IC_kwDOAO6SJc6VjQLn","user":{"login":"KoBeWi","id":2223172,"node_id":"MDQ6VXNlcjIyMjMxNzI=","avatar_url":"https://avatars.githubusercontent.com/u/2223172?v=4","gravatar_id":"","url":"https://api.github.com/users/KoBeWi","html_url":"https://github.com/KoBeWi","followers_url":"https://api.github.com/users/KoBeWi/followers","following_url":"https://api.github.com/users/KoBeWi/following{/other_user}","gists_url":"https://api.github.com/users/KoBeWi/gists{/gist_id}","starred_url":"https://api.github.com/users/KoBeWi/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/KoBeWi/subscriptions","organizations_url":"https://api.github.com/users/KoBeWi/orgs","repos_url":"https://api.github.com/users/KoBeWi/repos","events_url":"https://api.github.com/users/KoBeWi/events{/privacy}","received_events_url":"https://api.github.com/users/KoBeWi/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2024-11-30T16:54:26Z","updated_at":"2024-11-30T16:54:26Z","body":"> My point is to follow the format we use for import, which is TOML. I guess it's a Godot setting format under this context.\r\n\r\n.import files, while effectively use CFG format, write and parse it manually. They don't use ConfigFile class.","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2509046503/reactions","total_count":2,"+1":2,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2531612838","html_url":"https://github.com/godotengine/godot/pull/99868#issuecomment-2531612838","issue_url":"https://api.github.com/repos/godotengine/godot/issues/99868","id":2531612838,"node_id":"IC_kwDOAO6SJc6W5Vim","user":{"login":"ghost","id":10137,"node_id":"MDQ6VXNlcjEwMTM3","avatar_url":"https://avatars.githubusercontent.com/u/10137?v=4","gravatar_id":"","url":"https://api.github.com/users/ghost","html_url":"https://github.com/ghost","followers_url":"https://api.github.com/users/ghost/followers","following_url":"https://api.github.com/users/ghost/following{/other_user}","gists_url":"https://api.github.com/users/ghost/gists{/gist_id}","starred_url":"https://api.github.com/users/ghost/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/ghost/subscriptions","organizations_url":"https://api.github.com/users/ghost/orgs","repos_url":"https://api.github.com/users/ghost/repos","events_url":"https://api.github.com/users/ghost/events{/privacy}","received_events_url":"https://api.github.com/users/ghost/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2024-12-10T13:17:53Z","updated_at":"2024-12-10T13:17:53Z","body":"Merging .uid with this potential .gdmeta would probably be the most preferable. Especially if it could be done before the 4.4 release to avoid a .uid migration case. Multiple small files make things very hard to explore in file explorers and git, so consolidating them into one would help those use cases.","author_association":"NONE","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2531612838/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2532101437","html_url":"https://github.com/godotengine/godot/pull/99868#issuecomment-2532101437","issue_url":"https://api.github.com/repos/godotengine/godot/issues/99868","id":2532101437,"node_id":"IC_kwDOAO6SJc6W7M09","user":{"login":"akien-mga","id":4701338,"node_id":"MDQ6VXNlcjQ3MDEzMzg=","avatar_url":"https://avatars.githubusercontent.com/u/4701338?v=4","gravatar_id":"","url":"https://api.github.com/users/akien-mga","html_url":"https://github.com/akien-mga","followers_url":"https://api.github.com/users/akien-mga/followers","following_url":"https://api.github.com/users/akien-mga/following{/other_user}","gists_url":"https://api.github.com/users/akien-mga/gists{/gist_id}","starred_url":"https://api.github.com/users/akien-mga/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/akien-mga/subscriptions","organizations_url":"https://api.github.com/users/akien-mga/orgs","repos_url":"https://api.github.com/users/akien-mga/repos","events_url":"https://api.github.com/users/akien-mga/events{/privacy}","received_events_url":"https://api.github.com/users/akien-mga/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2024-12-10T15:42:48Z","updated_at":"2024-12-10T15:42:48Z","body":"Before spending too much time on trying to merge `.uid` and this new proposed `.gdmeta` file:\r\n\r\nWhat is the proposal here? Any feature PR needs to be backed by a proposal that shows significant support from the community.\r\n\r\nSo far we're not clear on any use case we want to support for metadata files, which is why we went with `.uid` and not `.meta` files in the first place (which has been evaluated and rejected - for now).","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2532101437/reactions","total_count":2,"+1":2,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2532170263","html_url":"https://github.com/godotengine/godot/pull/99868#issuecomment-2532170263","issue_url":"https://api.github.com/repos/godotengine/godot/issues/99868","id":2532170263,"node_id":"IC_kwDOAO6SJc6W7doX","user":{"login":"adamscott","id":270928,"node_id":"MDQ6VXNlcjI3MDkyOA==","avatar_url":"https://avatars.githubusercontent.com/u/270928?v=4","gravatar_id":"","url":"https://api.github.com/users/adamscott","html_url":"https://github.com/adamscott","followers_url":"https://api.github.com/users/adamscott/followers","following_url":"https://api.github.com/users/adamscott/following{/other_user}","gists_url":"https://api.github.com/users/adamscott/gists{/gist_id}","starred_url":"https://api.github.com/users/adamscott/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/adamscott/subscriptions","organizations_url":"https://api.github.com/users/adamscott/orgs","repos_url":"https://api.github.com/users/adamscott/repos","events_url":"https://api.github.com/users/adamscott/events{/privacy}","received_events_url":"https://api.github.com/users/adamscott/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2024-12-10T16:09:33Z","updated_at":"2024-12-10T16:09:43Z","body":"> What is the proposal here? Any feature PR needs to be backed by a proposal that shows significant support from the community.\r\n\r\nTo add to that, there's need for actual real use of the metadata. We need real use-cases from the community, not just \"it would be nice\".\r\n\r\n(I'm saying that even if I would love such metadata on script files too)","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2532170263/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2533441224","html_url":"https://github.com/godotengine/godot/pull/99868#issuecomment-2533441224","issue_url":"https://api.github.com/repos/godotengine/godot/issues/99868","id":2533441224,"node_id":"IC_kwDOAO6SJc6XAT7I","user":{"login":"Lazy-Rabbit-2001","id":22123964,"node_id":"MDQ6VXNlcjIyMTIzOTY0","avatar_url":"https://avatars.githubusercontent.com/u/22123964?v=4","gravatar_id":"","url":"https://api.github.com/users/Lazy-Rabbit-2001","html_url":"https://github.com/Lazy-Rabbit-2001","followers_url":"https://api.github.com/users/Lazy-Rabbit-2001/followers","following_url":"https://api.github.com/users/Lazy-Rabbit-2001/following{/other_user}","gists_url":"https://api.github.com/users/Lazy-Rabbit-2001/gists{/gist_id}","starred_url":"https://api.github.com/users/Lazy-Rabbit-2001/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Lazy-Rabbit-2001/subscriptions","organizations_url":"https://api.github.com/users/Lazy-Rabbit-2001/orgs","repos_url":"https://api.github.com/users/Lazy-Rabbit-2001/repos","events_url":"https://api.github.com/users/Lazy-Rabbit-2001/events{/privacy}","received_events_url":"https://api.github.com/users/Lazy-Rabbit-2001/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2024-12-11T01:52:51Z","updated_at":"2024-12-11T01:52:51Z","body":"As we've discussed in rocket chat about this and there is a better solution to the proposal linked in the top post, which have nothing to do with metadata, I don't think the pr is worth retaining here. So I closed this pr.\nSince the .meta file would be a future topic, let's get started with the discussion again when it comes necessity.","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2533441224/reactions","total_count":3,"+1":3,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null}]