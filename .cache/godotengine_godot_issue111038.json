ub.com/Repiteo","followers_url":"https://api.github.com/users/Repiteo/followers","following_url":"https://api.github.com/users/Repiteo/following{/other_user}","gists_url":"https://api.github.com/users/Repiteo/gists{/gist_id}","starred_url":"https://api.github.com/users/Repiteo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Repiteo/subscriptions","organizations_url":"https://api.github.com/users/Repiteo/orgs","repos_url":"https://api.github.com/users/Repiteo/repos","events_url":"https://api.github.com/users/Repiteo/events{/privacy}","received_events_url":"https://api.github.com/users/Repiteo/received_events","type":"User","user_view_type":"public","site_admin":false},"open_issues":3,"closed_issues":2978,"state":"closed","created_at":"2025-05-22T16:25:52Z","updated_at":"2026-10-04T16:23:23Z","due_on":null,"closed_at":"2026-01-26T18:09:14Z"},"comments":7,"created_at":"2025-09-29T15:45:44Z","updated_at":"2026-10-18T07:27:49Z","closed_at":"2026-01-06T12:26:52Z","assignee":{"login":"bruvzg","id":7645683,"node_id":"MDQ6VXNlcjc2NDU2ODM=","avatar_url":"https://avatars.githubusercontent.com/u/7645683?v=4","gravatar_id":"","url":"https://api.github.com/users/bruvzg","html_url":"https://github.com/bruvzg","followers_url":"https://api.github.com/users/bruvzg/followers","following_url":"https://api.github.com/users/bruvzg/following{/other_user}","gists_url":"https://api.github.com/users/bruvzg/gists{/gist_id}","starred_url":"https://api.github.com/users/bruvzg/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/bruvzg/subscriptions","organizations_url":"https://api.github.com/users/bruvzg/orgs","repos_url":"https://api.github.com/users/bruvzg/repos","events_url":"https://api.github.com/users/bruvzg/events{/privacy}","received_events_url":"https://api.github.com/users/bruvzg/received_events","type":"User","user_view_type":"public","site_admin":false},"author_association":"NONE","issue_field_values":[],"type":null,"active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"### Tested versions\n\n- Reproducable in v4.5.stable.steam [876b29033]\n- Not reproducable in v4.4.stable.official [4c311cbee]\n\n### System information\n\nGodot v4.5.stable (876b29033) - Windows 10 (build 19045) - Multi-window, 3 monitors - Vulkan (Forward+) - dedicated AMD Radeon RX 7600 (Advanced Micro Devices, Inc.; 32.0.21025.10016) - Intel(R) Core(TM) i7-5930K CPU @ 3.50GHz (12 threads) - 31.89 GiB memory\n\n### Issue description\n\nAfter updating to 4.5, changing the window mode seems to revert the border to be “retro”.\n\nIn other words, the game launches normally. If fullscreen is enabled, the game look normal. Then if the game is toggled back to a windowed mode, the game has an ugly \"retro border\".\n\nI have found two workarounds:\n- If I set the window mode to Window.MODE_EXCLUSIVE_FULLSCREEN just before going to Window.MODE_WINDOWED, the bug does not happen.\n- If I do not explicitly set the BORDERLESS property, the bug does not happen.\n\n<img width=\"1173\" height=\"697\" alt=\"Image\" src=\"https://github.com/user-attachments/assets/5a2f885a-9253-43fc-ac45-a21df3216e0a\" />\n\n<img width=\"1186\" height=\"706\" alt=\"Image\" src=\"https://github.com/user-attachments/assets/0b5c7ad1-3725-4f76-b698-d3d5cdd2bd5f\" />\n\n### Steps to reproduce\n\nToggle borderless fullscreen mode:\n- flag: BORDERLESS=true\n- mode=FULLSCREEN\n\nDisable borderless windowed mode:\n- flag: BORDERLESS=false\n- mode=WINDOWED\n\n### Minimal reproduction project (MRP)\n\n[fullscreen-bug.zip](https://github.com/user-attachments/files/22601300/fullscreen-bug.zip)","closed_by":{"login":"akien-mga","id":4701338,"node_id":"MDQ6VXNlcjQ3MDEzMzg=","avatar_url":"https://avatars.githubusercontent.com/u/4701338?v=4","gravatar_id":"","url":"https://api.github.com/users/akien-mga","html_url":"https://github.com