pos/godotengine/godot/pulls/98554","_links":{"self":{"href":"https://api.github.com/repos/godotengine/godot/pulls/comments/1820883924"},"html":{"href":"https://github.com/godotengine/godot/pull/98554#discussion_r1820883924"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/98554"}},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/1820883924/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":null,"original_line":102,"side":"RIGHT","in_reply_to_id":1817894597,"author_association":"MEMBER","original_position":5,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/1827700386","pull_request_review_id":2413013003,"id":1827700386,"node_id":"PRRC_kwDOAO6SJc5s8H6i","diff_hunk":"@@ -99,7 +99,7 @@ RenderingContextDriverD3D12::~RenderingContextDriverD3D12() {\n }\n \n Error RenderingContextDriverD3D12::_init_device_factory() {\n-\tuint32_t agility_sdk_version = GLOBAL_GET(\"rendering/rendering_device/d3d12/agility_sdk_version\");\n+\tuint32_t agility_sdk_version = GLOBAL_GET(PropertyInfo(Variant::INT, \"rendering/rendering_device/d3d12/agility_sdk_version\", \"1,10000,1,or_greater\");","path":"drivers/d3d12/rendering_context_driver_d3d12.cpp","commit_id":"62c17911eae12fbc7a1da29e3300ea5b74183d1f","original_commit_id":"c9f89fdce748f7ea403d7888575b7021dc328251","user":{"login":"RandomShaper","id":11797174,"node_id":"MDQ6VXNlcjExNzk3MTc0","avatar_url":"https://avatars.githubusercontent.com/u/11797174?v=4","gravatar_id":"","url":"https://api.github.com/users/RandomShaper","html_url":"https://github.com/RandomShaper","followers_url":"https://api.github.com/users/RandomShaper/followers","following_url":"https://api.github.com/users/RandomShaper/following{/other_user}","gists_url":"https://api.github.com/users/RandomShaper/gists{/gist_id}","starred_u