/Calinou","html_url":"https://github.com/Calinou","followers_url":"https://api.github.com/users/Calinou/followers","following_url":"https://api.github.com/users/Calinou/following{/other_user}","gists_url":"https://api.github.com/users/Calinou/gists{/gist_id}","starred_url":"https://api.github.com/users/Calinou/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Calinou/subscriptions","organizations_url":"https://api.github.com/users/Calinou/orgs","repos_url":"https://api.github.com/users/Calinou/repos","events_url":"https://api.github.com/users/Calinou/events{/privacy}","received_events_url":"https://api.github.com/users/Calinou/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"The default value is already set to 613, but you can use a newer version if you wish. This is supposed to work without having to update Godot itself.\r\n\r\nWe could probably tweak the hint to disallow using versions older than the version Godot originally downloaded in its script, still. Either way, the property hint should remain so that you can't enter zero or negative values.","created_at":"2024-10-28T17:00:12Z","updated_at":"2024-10-28T17:00:23Z","html_url":"https://github.com/godotengine/godot/pull/98554#discussion_r1819426996","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/98554","_links":{"self":{"href":"https://api.github.com/repos/godotengine/godot/pulls/comments/1819426996"},"html":{"href":"https://github.com/godotengine/godot/pull/98554#discussion_r1819426996"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/98554"}},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/1819426996/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":null,"original_line":102,"side":"RIGHT","in_reply_to_id":1817894597,"author_association":"M