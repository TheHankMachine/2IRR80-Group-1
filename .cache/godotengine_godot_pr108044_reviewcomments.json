?v=4","gravatar_id":"","url":"https://api.github.com/users/apples","html_url":"https://github.com/apples","followers_url":"https://api.github.com/users/apples/followers","following_url":"https://api.github.com/users/apples/following{/other_user}","gists_url":"https://api.github.com/users/apples/gists{/gist_id}","starred_url":"https://api.github.com/users/apples/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/apples/subscriptions","organizations_url":"https://api.github.com/users/apples/orgs","repos_url":"https://api.github.com/users/apples/repos","events_url":"https://api.github.com/users/apples/events{/privacy}","received_events_url":"https://api.github.com/users/apples/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"I've updated it to use a `depth_only` field on the `PipelineKey`.","created_at":"2025-06-29T22:01:49Z","updated_at":"2025-06-29T22:01:50Z","html_url":"https://github.com/godotengine/godot/pull/108044#discussion_r2173941326","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/108044","_links":{"self":{"href":"https://api.github.com/repos/godotengine/godot/pulls/comments/2173941326"},"html":{"href":"https://github.com/godotengine/godot/pull/108044#discussion_r2173941326"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/108044"}},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/2173941326/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":null,"original_line":601,"side":"RIGHT","in_reply_to_id":2173831465,"author_association":"CONTRIBUTOR","original_position":50,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/2178779105","pull_request_review_id":2977301709,"id":2178779105,"node_id":"PRRC_kwDOAO6SJc6B3Yfh","diff_hunk":"@@ -1209,6 +12