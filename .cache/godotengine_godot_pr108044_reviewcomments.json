.github.com/users/clayjohn/orgs","repos_url":"https://api.github.com/users/clayjohn/repos","events_url":"https://api.github.com/users/clayjohn/events{/privacy}","received_events_url":"https://api.github.com/users/clayjohn/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"But why draw the object twice? Shouldn't you just draw it a single time in the stencil pass in that case? Or better yet, use the sort key so stencil objects always draw last in the normal opaque pass?","created_at":"2025-07-02T02:51:59Z","updated_at":"2025-07-02T02:51:59Z","html_url":"https://github.com/godotengine/godot/pull/108044#discussion_r2178883937","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/108044","_links":{"self":{"href":"https://api.github.com/repos/godotengine/godot/pulls/comments/2178883937"},"html":{"href":"https://github.com/godotengine/godot/pull/108044#discussion_r2178883937"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/108044"}},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/2178883937/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":null,"original_line":1212,"side":"RIGHT","in_reply_to_id":2173830979,"author_association":"MEMBER","original_position":4,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/2178898793","pull_request_review_id":2977468135,"id":2178898793,"node_id":"PRRC_kwDOAO6SJc6B31tp","diff_hunk":"@@ -1209,6 +1209,18 @@ void RenderForwardMobile::_render_scene(RenderDataRD *p_render_data, const Color\n \n \t\tRD::get_singleton()->draw_command_end_label(); //Render Opaque\n \n+\t\tif (scene_state.used_opaque_stencil) {","path":"servers/rendering/renderer_rd/forward_mobile/render_forward_mobile.cpp","commit_id":"62a5cd90a7804ce063d30514c3753b7934f1ffec","origina