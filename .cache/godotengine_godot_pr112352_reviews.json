[{"id":3413473083,"node_id":"PRR_kwDOAO6SJc7LdXc7","user":{"login":"Calinou","id":180032,"node_id":"MDQ6VXNlcjE4MDAzMg==","avatar_url":"https://avatars.githubusercontent.com/u/180032?u=68d23e7ee9cdf810da125e8510b72f845b9dccc8&v=4","gravatar_id":"","url":"https://api.github.com/users/Calinou","html_url":"https://github.com/Calinou","followers_url":"https://api.github.com/users/Calinou/followers","following_url":"https://api.github.com/users/Calinou/following{/other_user}","gists_url":"https://api.github.com/users/Calinou/gists{/gist_id}","starred_url":"https://api.github.com/users/Calinou/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Calinou/subscriptions","organizations_url":"https://api.github.com/users/Calinou/orgs","repos_url":"https://api.github.com/users/Calinou/repos","events_url":"https://api.github.com/users/Calinou/events{/privacy}","received_events_url":"https://api.github.com/users/Calinou/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"Tested locally, it works as expected. Code looks good to me.\r\n\r\n**Testing project:** [test_pr_112352.zip](https://github.com/user-attachments/files/23320260/test_pr_112352.zip)\r\n\r\nNote that if a texture is used in a Polygon2D whose texture is downscaled, it will look grainy unless you enable mipmaps:\r\n\r\n### Base resolution\r\n\r\n*Left: PNG, Right: DPITexture*\r\n\r\n<img width=\"918\" height=\"623\" alt=\"Image\" src=\"https://github.com/user-attachments/assets/69b75142-d4dc-49f7-a780-0ab1b63ea216\" />\r\n\r\n### Fullscreen 4K\r\n\r\n*Left: PNG, Right: DPITexture*\r\n\r\n<img width=\"3042\" height=\"2015\" alt=\"Image\" src=\"https://github.com/user-attachments/assets/b4d15494-4bd0-4f4e-ac2a-9f16ea44bcb0\" />\r\n\r\nThat said, the issue also happens at the base resolution, not just in fullscreen. There's no 1:1 mapping between textures and Polygon2Ds, so it may not be possible to automatically perform this adjustment at the DPITexture level. Also, the Polygon2D texture scale may be changed at runtime, which could cause stuttering if the texture has to be re-rasterized at runtime because of a scale change.\r\n\r\nThis issue also applies to Sprite2D when using region parameters or even the `scale` property, so it's not specific to Polygon2D. I figure I'd mention it here for future reference.","state":"APPROVED","html_url":"https://github.com/godotengine/godot/pull/112352#pullrequestreview-3413473083","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/112352","author_association":"MEMBER","_links":{"html":{"href":"https://github.com/godotengine/godot/pull/112352#pullrequestreview-3413473083"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/112352"}},"submitted_at":"2025-11-04T00:30:23Z","commit_id":"4f4d4ca26c436406344f16fd49c9b4cd63383598"},{"id":3415441955,"node_id":"PRR_kwDOAO6SJc7Lk4Ij","user":{"login":"akien-mga","id":4701338,"node_id":"MDQ6VXNlcjQ3MDEzMzg=","avatar_url":"https://avatars.githubusercontent.com/u/4701338?u=4a42fd867f2c449fcc23adf635dd574dae98e6c2&v=4","gravatar_id":"","url":"https://api.github.com/users/akien-mga","html_url":"https://github.com/akien-mga","followers_url":"https://api.github.com/users/akien-mga/followers","following_url":"https://api.github.com/users/akien-mga/following{/other_user}","gists_url":"https://api.github.com/users/akien-mga/gists{/gist_id}","starred_url":"https://api.github.com/users/akien-mga/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/akien-mga/subscriptions","organizations_url":"https://api.github.com/users/akien-mga/orgs","repos_url":"https://api.github.com/users/akien-mga/repos","events_url":"https://api.github.com/users/akien-mga/events{/privacy}","received_events_url":"https://api.github.com/users/akien-mga/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"","state":"APPROVED","html_url":"https://github.com/godotengine/godot/pull/112352#pullrequestreview-3415441955","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/112352","author_association":"MEMBER","_links":{"html":{"href":"https://github.com/godotengine/godot/pull/112352#pullrequestreview-3415441955"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/112352"}},"submitted_at":"2025-11-04T10:20:10Z","commit_id":"4f4d4ca26c436406344f16fd49c9b4cd63383598"}]