e_id":"PRR_kwDOAO6SJc71PK98","state":"APPROVED","commit_id":"b56ca02731140eff46749f68cb24d6430c8bcc16","user":{"site_admin":false,"suspended":false,"updated_at":"0001-01-01T00:00:00Z","avatar_url":"https://avatars.githubusercontent.com/u/21999379?u=2b8b17ce969861380874563b333a546e0bbaab56&v=4","created_at":"0001-01-01T00:00:00Z","followers":0,"following":0,"html_url":"https://github.com/lawnjelly","id":21999379,"node_id":"MDQ6VXNlcjIxOTk5Mzc5","login":"lawnjelly","type":"User","owned_private_repos":0,"public_gists":0,"public_repos":0,"total_private_repos":0,"url":"https://api.github.com/users/lawnjelly"},"body":"","html_url":"https://github.com/godotengine/godot/pull/116424#pullrequestreview-4114395004","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/116424","author_association":"MEMBER","submitted_at":"2026-04-15T14:27:13Z"},{"id":4450805988,"node_id":"PRR_kwDOAO6SJc8AAAABCUno5A","state":"CHANGES_REQUESTED","commit_id":"b56ca02731140eff46749f68cb24d6430c8bcc16","user":{"site_admin":false,"suspended":false,"updated_at":"0001-01-01T00:00:00Z","avatar_url":"https://avatars.githubusercontent.com/u/16521339?u=e44a465cbebabb9ea2be80b59e6dc07966bef5b7&v=4","created_at":"0001-01-01T00:00:00Z","followers":0,"following":0,"html_url":"https://github.com/clayjohn","id":16521339,"node_id":"MDQ6VXNlcjE2NTIxMzM5","login":"clayjohn","type":"User","owned_private_repos":0,"public_gists":0,"public_repos":0,"total_private_repos":0,"url":"https://api.github.com/users/clayjohn"},"body":"This needs to be scoped better to be an XR-specific feature. Right now it is an XR refactor pretending to be a general-purpose rendering feature. In reality, this is a code cleanup that makes the XR codepath a bit more flexible\n\nIt looks like a helpful drop-in for building the XR projection matrices and allows you to slightly simplify the XR codepath in the renderer, but the API looks almost the same as the custom matrix proposal that people are very excited about, but it doesn't implement custom matrices at all. \n\nTo be mergable, this needs to be scoped better. At minimum, the API needs to change from `camera_set_projections()` to `camera_set_xr_projections()`. The associated naming (enums, properties, etc.) should be updated as well. ","html_url":"https://github.com/godotengine/godot/pull/116424#pullrequestreview-4450805988","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/116424","author_association":"MEMBER","submitted_at":"2026-06-08T15:11:14Z"},{"id":4454815788,"node_id":"PRR_kwDOAO6SJc8AAAABCYcYLA","state":"COMMENTED","commit_id":"b56ca02731140eff46749f68cb24d6430c8bcc16","user":{"site_admin":false,"suspended":false,"updated_at":"0001-01-01T00:00:00Z","avatar_url":"https://avatars.githubusercontent.com/u/1945449?u=96b5dc9be2859dca5f31314c87d99a68a21e1576&v=4","created_at":"0001-01-01T00:00:00Z","followers":0,"following":0,"html_url":"https://github.com/BastiaanOlij","id":1945449,"node_id":"MDQ6VXNlcjE5NDU0NDk=","login":"BastiaanOlij","type":"User","owned_private_repos":0,"public_gists":0,"public_repos":0,"total_private_repos":0,"url":"https://api.github.com/users/BastiaanOlij"},"body":"","html_url":"https://github.com/godotengine/godot/pull/116424#pullrequestreview-4454815788","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/116424","author_association":"CONTRIBUTOR","submitted_at":"2026-06-09T02:43:52Z"},{"id":5161114572,"node_id":"PRR_kwDOAO6SJc8AAAABM6BbzA","state":"APPROVED","commit_id":"9d0b0a6738b9adfddc4d50544ed5cbf2aa91fb87","user":{"site_admin":false,"suspended":false,"updated_at":"0001-01-01T00:00:00Z","avatar_url":"https://avatars.githubusercontent.com/u/16521339?u=e44a465cbebabb9ea2be80b59e6dc07966bef5b7&v=4","created_at":"0001-01-01T00:00:00Z","followers":0,"following":0,"html_url":"https://github.com/clayjohn","id":16521339,"node_id":"MDQ6VXNlcjE2NTIxMzM5","login":"clayjohn","type":"User","owned_private_repos":0,"public_gists":0,"public_repos":0,"total_private_repos":0