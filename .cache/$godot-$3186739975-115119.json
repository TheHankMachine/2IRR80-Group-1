ic_repos":0,"total_private_repos":0,"url":"https://api.github.com/users/Calinou"},"body":"Works great now :slightly_smiling_face: \r\n\r\nhttps://github.com/user-attachments/assets/1c6decd6-9bd9-4713-b201-11b6ad54ccbb\r\n\r\nThe only remaining issue is that buttons pressed beforehand will not be seen as pressed by Godot once the window gains focus. For axes, this will sometimes happen (due to the value changing very often), but it's less likely to happen if you are fully holding a trigger (common with digital triggers) or a stick in a cardinal direction. That said, this issue is commonly found in other programs that disallow background input, so it's not critical and can be resolved in a future PR.","html_url":"https://github.com/godotengine/godot/pull/115119#pullrequestreview-3695399690","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/115119","author_association":"MEMBER","submitted_at":"2026-01-23T02:22:25Z"},{"id":3697140686,"node_id":"PRR_kwDOAO6SJc7cXePO","state":"COMMENTED","user":{"site_admin":false,"suspended":false,"updated_at":"0001-01-01T00:00:00Z","avatar_url":"https://avatars.githubusercontent.com/u/92302738?u=f6c14ec512c7cd33f8d109f121e89b7e60e42f38&v=4","created_at":"0001-01-01T00:00:00Z","followers":0,"following":0,"html_url":"https://github.com/Nintorch","id":92302738,"node_id":"U_kgDOBYBtkg","login":"Nintorch","type":"User","owned_private_repos":0,"public_gists":0,"public_repos":0,"total_private_repos":0,"url":"https://api.github.com/users/Nintorch"},"body":"","html_url":"https://github.com/godotengine/godot/pull/115119#pullrequestreview-3697140686","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/115119","author_association":"MEMBER","submitted_at":"2026-01-23T11:49:21Z"},{"id":3701481827,"node_id":"PRR_kwDOAO6SJc7coCFj","state":"COMMENTED","user":{"site_admin":false,"suspended":false,"updated_at":"0001-01-01T00:00:00Z","avatar_url":"https://avatars.githubusercontent.com/u/92302738?u=f6c14ec512c7cd3