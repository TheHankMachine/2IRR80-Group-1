://github.com/Nintorch","id":92302738,"node_id":"U_kgDOBYBtkg","login":"Nintorch","type":"User","owned_private_repos":0,"public_gists":0,"public_repos":0,"total_private_repos":0,"url":"https://api.github.com/users/Nintorch"},"body":"","html_url":"https://github.com/godotengine/godot/pull/115119#pullrequestreview-3677452670","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/115119","author_association":"MEMBER","submitted_at":"2026-01-19T10:47:56Z"},{"id":3679832176,"node_id":"PRR_kwDOAO6SJc7bVchw","state":"COMMENTED","user":{"site_admin":false,"suspended":false,"updated_at":"0001-01-01T00:00:00Z","avatar_url":"https://avatars.githubusercontent.com/u/180032?u=68d23e7ee9cdf810da125e8510b72f845b9dccc8&v=4","created_at":"0001-01-01T00:00:00Z","followers":0,"following":0,"html_url":"https://github.com/Calinou","id":180032,"node_id":"MDQ6VXNlcjE4MDAzMg==","login":"Calinou","type":"User","owned_private_repos":0,"public_gists":0,"public_repos":0,"total_private_repos":0,"url":"https://api.github.com/users/Calinou"},"body":"Tested locally on Linux/X11, it mostly works as expected.\r\n\r\nSome feedback:\r\n\r\n- Clicking the window border in game embedding doesn't count as focusing the application, while it should. You need to click on the viewport instead.\r\n- When the window loses focus, stick movement will sometimes still be registered, leading to a \"ghost input\". This is more common if you are actively moving the stick at the time the window loses focus.\r\n\r\nhttps://github.com/user-attachments/assets/63793992-05fc-46a0-bec3-e41249ea8437\r\n\r\n\r\n","html_url":"https://github.com/godotengine/godot/pull/115119#pullrequestreview-3679832176","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/115119","author_association":"MEMBER","submitted_at":"2026-01-19T23:10:07Z"},{"id":3681351774,"node_id":"PRR_kwDOAO6SJc7bbPhe","state":"COMMENTED","user":{"site_admin":false,"suspended":false,"updated_at":"0001-01-01T00:00:00Z","avatar_ur