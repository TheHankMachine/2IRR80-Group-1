ived_events_url":"https://api.github.com/users/akien-mga/received_events","type":"User","user_view_type":"public","site_admin":false},"open_issues":5793,"closed_issues":0,"state":"open","created_at":"2022-07-26T12:42:05Z","updated_at":"2026-10-22T14:39:14Z","due_on":null,"closed_at":null},"comments":4,"created_at":"2025-10-15T01:24:54Z","updated_at":"2026-06-19T15:24:51Z","closed_at":null,"assignee":null,"author_association":"MEMBER","issue_field_values":[],"type":null,"active_lock_reason":null,"draft":false,"pull_request":{"url":"https://api.github.com/repos/godotengine/godot/pulls/111665","html_url":"https://github.com/godotengine/godot/pull/111665","diff_url":"https://github.com/godotengine/godot/pull/111665.diff","patch_url":"https://github.com/godotengine/godot/pull/111665.patch","merged_at":null},"body":"The current (and newly added #107973) `appleembedded.permission.AUDIO_RECORD` don't follow the current permission name framework of \"\\<ACTION\\>_\\<SUBJECT\\>\".\r\n\r\nThis PR rectifies this issue. It warns the user when `AUDIO_RECORD` is used, but grants the request nonetheless. Though, to keep compatibility with 4.5 users, when requesting granted permissions, both `AUDIO_RECORD` and `RECORD_AUDIO` are given for the same permission. In a future version, we could remove the `AUDIO_RECORD` one.\r\n\r\n<figure>\r\n\r\n<img width=\"849\" height=\"381\" alt=\"Capture d’écran, le 2025-10-14 à 21 17 59\" src=\"https://github.com/user-attachments/assets/0959dd6f-c98e-4957-9cd3-150e77b8e3b8\" />\r\n\r\n<figcaption markdown=1>\r\n\r\nThe `AUDIO_RECORD` mention in [the docs](https://docs.godotengine.org/en/stable/classes/class_os.html#class-os-method-request-permission) stick out from the rest.\r\n\r\n</figcaption>\r\n</figure>","closed_by":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/111665/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/godotengine/godot/issues/111665/timeline","performed_via_github_app":null,"state_reason":null}