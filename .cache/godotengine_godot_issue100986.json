},{"id":10951989861,"node_id":"LA_kwDOAO6SJc8AAAACjMoaZQ","url":"https://api.github.com/repos/godotengine/godot/labels/cherrypick:4.7","name":"cherrypick:4.7","color":"446699","default":false,"description":"Considered for cherry-picking into a future 4.7.x release","archived_at":null,"archived_by":null}],"state":"closed","locked":false,"assignees":[],"milestone":{"url":"https://api.github.com/repos/godotengine/godot/milestones/25","html_url":"https://github.com/godotengine/godot/milestone/25","labels_url":"https://api.github.com/repos/godotengine/godot/milestones/25/labels","id":15520464,"node_id":"MI_kwDOAO6SJc4A7NLQ","number":25,"title":"4.8","description":"","creator":{"login":"Repiteo","id":17489292,"node_id":"MDQ6VXNlcjE3NDg5Mjky","avatar_url":"https://avatars.githubusercontent.com/u/17489292?v=4","gravatar_id":"","url":"https://api.github.com/users/Repiteo","html_url":"https://github.com/Repiteo","followers_url":"https://api.github.com/users/Repiteo/followers","following_url":"https://api.github.com/users/Repiteo/following{/other_user}","gists_url":"https://api.github.com/users/Repiteo/gists{/gist_id}","starred_url":"https://api.github.com/users/Repiteo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Repiteo/subscriptions","organizations_url":"https://api.github.com/users/Repiteo/orgs","repos_url":"https://api.github.com/users/Repiteo/repos","events_url":"https://api.github.com/users/Repiteo/events{/privacy}","received_events_url":"https://api.github.com/users/Repiteo/received_events","type":"User","user_view_type":"public","site_admin":false},"open_issues":345,"closed_issues":2336,"state":"open","created_at":"2026-04-13T15:59:35Z","updated_at":"2026-10-22T08:21:32Z","due_on":null,"closed_at":null},"comments":2,"created_at":"2024-12-31T21:24:31Z","updated_at":"2026-10-02T15:52:35Z","closed_at":"2026-08-04T16:52:33Z","assignee":null,"author_association":"CONTRIBUTOR","issue_field_values":[],"type":null,"active_lock_reason":null,"draft":false,"pull_request":{"url":"https://api.github.com/repos/godotengine/godot/pulls/100986","html_url":"https://github.com/godotengine/godot/pull/100986","diff_url":"https://github.com/godotengine/godot/pull/100986.diff","patch_url":"https://github.com/godotengine/godot/pull/100986.patch","merged_at":"2026-08-04T16:52:33Z"},"body":"When moving the old stream's mixed data into the fade buffer, it erroneously included the current frame, which had already been added to the p_buffer. As the fade buffer is also added to the p_buffer later, this resulted in a double-counting of the sample, which could cause a click in some cases.\r\n\r\nThe current frame is now zeroed rather than copied in the fade buffer, preventing this double-counting.\r\n\r\nHere is an MRP that demonstrates an example where this issue was causing a click—\r\nRun the default scene, which will start autoplay, and observe the transition at ~20sec:\r\n[Playlist Testing.zip](https://github.com/user-attachments/files/18283693/Playlist.Testing.zip)","closed_by":{"login":"Repiteo","id":17489292,"node_id":"MDQ6VXNlcjE3NDg5Mjky","avatar_url":"https://avatars.githubusercontent.com/u/17489292?v=4","gravatar_id":"","url":"https://api.github.com/users/Repiteo","html_url":"https://github.com/Repiteo","followers_url":"https://api.github.com/users/Repiteo/followers","following_url":"https://api.github.com/users/Repiteo/following{/other_user}","gists_url":"https://api.github.com/users/Repiteo/gists{/gist_id}","starred_url":"https://api.github.com/users/Repiteo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Repiteo/subscriptions","organizations_url":"https://api.github.com/users/Repiteo/orgs","repos_url":"https://api.github.com/users/Repiteo/repos","events_url":"https://api.github.com/users/Repiteo/events{/privacy}","received_events_url":"https://api.github.com/users/Repiteo/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/r