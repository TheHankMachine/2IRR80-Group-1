.com/users/ndbn/followers","following_url":"https://api.github.com/users/ndbn/following{/other_user}","gists_url":"https://api.github.com/users/ndbn/gists{/gist_id}","starred_url":"https://api.github.com/users/ndbn/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/ndbn/subscriptions","organizations_url":"https://api.github.com/users/ndbn/orgs","repos_url":"https://api.github.com/users/ndbn/repos","events_url":"https://api.github.com/users/ndbn/events{/privacy}","received_events_url":"https://api.github.com/users/ndbn/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-03-09T01:06:56Z","updated_at":"2026-03-09T01:06:56Z","body":"Can confirm #117232 fix issue.\n\nBut honestly it is kind of side effect, root of issue is `AnimationPlayerEditorPlugin` handles `AnimationTree` and `AnimationMixer` (ancestors checked inside `is_class`)\nhttps://github.com/godotengine/godot/blob/220b0b2f74d8e089481b140c42a42992a76dd6fc/editor/animation/animation_player_editor_plugin.cpp#L2484-L2486\nIf no really reason to handle `AnimationTree` and `AnimationMixer` in `AnimationPlayerEditorPlugin` it is also fix issue (also #106334 can be reverted)","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4020477793/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4048333788","html_url":"https://github.com/godotengine/godot/issues/115947#issuecomment-4048333788","issue_url":"https://api.github.com/repos/godotengine/godot/issues/115947","id":4048333788,"node_id":"IC_kwDOAO6SJc7xTKvc","user":{"login":"kitbdev","id":10054226,"node_id":"MDQ6VXNlcjEwMDU0MjI2","avatar_url":"https://avatars.githubusercontent.com/u/10054226?v=4","gravatar_id":"","url":"https://api.github.com/users/kitbdev","htm