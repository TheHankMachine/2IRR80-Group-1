eWi/gists{/gist_id}","starred_url":"https://api.github.com/users/KoBeWi/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/KoBeWi/subscriptions","organizations_url":"https://api.github.com/users/KoBeWi/orgs","repos_url":"https://api.github.com/users/KoBeWi/repos","events_url":"https://api.github.com/users/KoBeWi/events{/privacy}","received_events_url":"https://api.github.com/users/KoBeWi/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-01-17T13:19:00Z","updated_at":"2025-01-17T13:29:24Z","body":"I'll have to check, but this might emit the `settings_changed` signal. In that case the change would make sense.\r\n\r\nEDIT:\r\nYes, that seems to be the case.","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2598353308/reactions","total_count":2,"+1":2,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2618746700","html_url":"https://github.com/godotengine/godot/pull/100244#issuecomment-2618746700","issue_url":"https://api.github.com/repos/godotengine/godot/issues/100244","id":2618746700,"node_id":"IC_kwDOAO6SJc6cFudM","user":{"login":"akien-mga","id":4701338,"node_id":"MDQ6VXNlcjQ3MDEzMzg=","avatar_url":"https://avatars.githubusercontent.com/u/4701338?v=4","gravatar_id":"","url":"https://api.github.com/users/akien-mga","html_url":"https://github.com/akien-mga","followers_url":"https://api.github.com/users/akien-mga/followers","following_url":"https://api.github.com/users/akien-mga/following{/other_user}","gists_url":"https://api.github.com/users/akien-mga/gists{/gist_id}","starred_url":"https://api.github.com/users/akien-mga/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/akien-mga/subscriptions","organizations_url":"https://api.github.com/users/akien-mga/orgs","repos_url":"https://api.github.com/users/akien-mga/repos","events_url":"https://api.github.com/users/akien-mga/events{/privacy}","received_events_url":"https://api.github.com/users/akien-mga/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-01-28T11:34:38Z","updated_at":"2025-01-28T11:34:38Z","body":"I'm still really not clear on what this is solving. Why is it a problem that `settings_changed` is emitted when you change project features? Changing project features impacts which settings are active so it doesn't seem unreasonable (a priori) that this would be propagated to the user.\r\n\r\nCould we have a MRP that actually shows that there's a problem?","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2618746700/reactions","total_count":2,"+1":2,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2618849639","html_url":"https://github.com/godotengine/godot/pull/100244#issuecomment-2618849639","issue_url":"https://api.github.com/repos/godotengine/godot/issues/100244","id":2618849639,"node_id":"IC_kwDOAO6SJc6cGHln","user":{"login":"WhalesState","id":53877170,"node_id":"MDQ6VXNlcjUzODc3MTcw","avatar_url":"https://avatars.githubusercontent.com/u/53877170?v=4","gravatar_id":"","url":"https://api.github.com/users/WhalesState","html_url":"https://github.com/WhalesState","followers_url":"https://api.github.com/users/WhalesState/followers","following_url":"https://api.github.com/users/WhalesState/following{/other_user}","gists_url":"https://api.github.com/users/WhalesState/gists{/gist_id}","starred_url":"https://api.github.com/users/WhalesState/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/WhalesState/subscriptions","organizations_url":"https://api.github.com/users/WhalesState/orgs","repos_url":"https://api.github.com/users/WhalesState/repos","events_url":"https://api.github.com/users/WhalesState/events{/privacy}","received_events_url":"https://api.github.com/users/WhalesState/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-01-28T12:20:01Z","updated_at":"2025-01-28T12:25:02Z","body":"> I'm still really not clear on what this is solving. Why is it a problem that `settings_changed` is emitted when you change project features? Changing project features impacts which settings are active so it doesn't seem unreasonable (a priori) that this would be propagated to the user.\r\n> \r\n> Could we have a MRP that actually shows that there's a problem?\r\n\r\nWhenever you change any project setting, it should emit settings changed, right ? just once ? because i have changed a single setting, but with this project features also changing project settings every time we change a setting then it will emit twice in a raw, even when the project features are the same, it will keep setting it again and again with the same array.\r\n\r\nThat's the issue, if you have some heavy code that runs when `ProjectSettings.settings_changed` signal emits, it will run more than once because of the project features are being set again and again with the same value.\r\n\r\nNote: This is just for editor. if it's still not clear then i can make and editor plugin that shows the issue.","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2618849639/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2618876942","html_url":"https://github.com/godotengine/godot/pull/100244#issuecomment-2618876942","issue_url":"https://api.github.com/repos/godotengine/godot/issues/100244","id":2618876942,"node_id":"IC_kwDOAO6SJc6cGOQO","user":{"login":"KoBeWi","id":2223172,"node_id":"MDQ6VXNlcjIyMjMxNzI=","avatar_url":"https://avatars.githubusercontent.com/u/2223172?v=4","gravatar_id":"","url":"https://api.github.com/users/KoBeWi","html_url":"https://github.com/KoBeWi","followers_url":"https://api.github.com/users/KoBeWi/followers","following_url":"https://api.github.com/users/KoBeWi/following{/other_user}","gists_url":"https://api.github.com/users/KoBeWi/gists{/gist_id}","starred_url":"https://api.github.com/users/KoBeWi/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/KoBeWi/subscriptions","organizations_url":"https://api.github.com/users/KoBeWi/orgs","repos_url":"https://api.github.com/users/KoBeWi/repos","events_url":"https://api.github.com/users/KoBeWi/events{/privacy}","received_events_url":"https://api.github.com/users/KoBeWi/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-01-28T12:32:44Z","updated_at":"2025-01-28T12:32:44Z","body":"[changed_not_changed.zip](https://github.com/user-attachments/files/18573371/changed_not_changed.zip)\r\n\r\nOpen the project, change a project setting and then close the dialog. The `settings_changed` signal will be emitted twice, because closing the dialog will save the settings, and without the fix the signal is emitted every time settings are saved.\r\n\r\n[The original fix](https://github.com/godotengine/godot/pull/100244#discussion_r1920196962) was comparing the new value with the previous one, but that means it had to fetch the setting and then perform a comparison of string array. It's not prohibitively expensive, so we could do that instead; I just though it's not worth it.","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2618876942/reactions","total_count":2,"+1":2,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengi