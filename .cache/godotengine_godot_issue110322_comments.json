[{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3267114911","html_url":"https://github.com/godotengine/godot/issues/110322#issuecomment-3267114911","issue_url":"https://api.github.com/repos/godotengine/godot/issues/110322","id":3267114911,"node_id":"IC_kwDOAO6SJc7CvDef","user":{"login":"OlegVegan","id":9021673,"node_id":"MDQ6VXNlcjkwMjE2NzM=","avatar_url":"https://avatars.githubusercontent.com/u/9021673?v=4","gravatar_id":"","url":"https://api.github.com/users/OlegVegan","html_url":"https://github.com/OlegVegan","followers_url":"https://api.github.com/users/OlegVegan/followers","following_url":"https://api.github.com/users/OlegVegan/following{/other_user}","gists_url":"https://api.github.com/users/OlegVegan/gists{/gist_id}","starred_url":"https://api.github.com/users/OlegVegan/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/OlegVegan/subscriptions","organizations_url":"https://api.github.com/users/OlegVegan/orgs","repos_url":"https://api.github.com/users/OlegVegan/repos","events_url":"https://api.github.com/users/OlegVegan/events{/privacy}","received_events_url":"https://api.github.com/users/OlegVegan/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-09-08T16:40:43Z","updated_at":"2025-09-08T16:40:43Z","body":"https://github.com/user-attachments/assets/fccf63c5-00a8-45ee-83a4-07cfb21b99cd\n\nHere's another demonstration that caught me off guard in my game (with a more extreme Z range)","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3267114911/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3267129030","html_url":"https://github.com/godotengine/godot/issues/110322#issuecomment-3267129030","issue_url":"https://api.github.com/repos/godotengine/godot/issues/110322","id":3267129030,"node_id":"IC_kwDOAO6SJc7CvG7G","user":{"login":"Lielay9","id":40064911,"node_id":"MDQ6VXNlcjQwMDY0OTEx","avatar_url":"https://avatars.githubusercontent.com/u/40064911?v=4","gravatar_id":"","url":"https://api.github.com/users/Lielay9","html_url":"https://github.com/Lielay9","followers_url":"https://api.github.com/users/Lielay9/followers","following_url":"https://api.github.com/users/Lielay9/following{/other_user}","gists_url":"https://api.github.com/users/Lielay9/gists{/gist_id}","starred_url":"https://api.github.com/users/Lielay9/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Lielay9/subscriptions","organizations_url":"https://api.github.com/users/Lielay9/orgs","repos_url":"https://api.github.com/users/Lielay9/repos","events_url":"https://api.github.com/users/Lielay9/events{/privacy}","received_events_url":"https://api.github.com/users/Lielay9/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-09-08T16:45:18Z","updated_at":"2025-09-08T17:30:26Z","body":"When camera uses perspective projection and `sorting_use_aabb_center` is enabled, transparent meshes are sorted based on the center of their AABB:s (or `custom_aabb` if in use). The mesh center of the text aabb is closer on the z-axis but when tilted enough it is further away as the text is below the center line. Unfortunately, there is no way to guarantee that flat transparency sorted meshes appear in the correct order with the current distance heuristic. To resolve this correctly either https://github.com/godotengine/godot/pull/109617 or https://github.com/godotengine/godot/pull/59404 is needed (or OIT https://github.com/godotengine/godot-proposals/issues/11251).\n\nThat said, the label AABB was likely intended to be used for the meshes as the current tight mesh AABB does not expand to account for billboarding... although the label AABB should probably instead use and modify the tighter AABB from surface data.","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3267129030/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3267762399","html_url":"https://github.com/godotengine/godot/issues/110322#issuecomment-3267762399","issue_url":"https://api.github.com/repos/godotengine/godot/issues/110322","id":3267762399,"node_id":"IC_kwDOAO6SJc7Cxhjf","user":{"login":"clayjohn","id":16521339,"node_id":"MDQ6VXNlcjE2NTIxMzM5","avatar_url":"https://avatars.githubusercontent.com/u/16521339?v=4","gravatar_id":"","url":"https://api.github.com/users/clayjohn","html_url":"https://github.com/clayjohn","followers_url":"https://api.github.com/users/clayjohn/followers","following_url":"https://api.github.com/users/clayjohn/following{/other_user}","gists_url":"https://api.github.com/users/clayjohn/gists{/gist_id}","starred_url":"https://api.github.com/users/clayjohn/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/clayjohn/subscriptions","organizations_url":"https://api.github.com/users/clayjohn/orgs","repos_url":"https://api.github.com/users/clayjohn/repos","events_url":"https://api.github.com/users/clayjohn/events{/privacy}","received_events_url":"https://api.github.com/users/clayjohn/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-09-08T20:03:24Z","updated_at":"2025-09-08T20:03:24Z","body":"There is a nice section in the docs that talks about this problem https://docs.godotengine.org/en/latest/tutorials/3d/3d_rendering_limitations.html#transparency-sorting","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3267762399/reactions","total_count":2,"+1":2,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3267955648","html_url":"https://github.com/godotengine/godot/issues/110322#issuecomment-3267955648","issue_url":"https://api.github.com/repos/godotengine/godot/issues/110322","id":3267955648,"node_id":"IC_kwDOAO6SJc7CyQvA","user":{"login":"OlegVegan","id":9021673,"node_id":"MDQ6VXNlcjkwMjE2NzM=","avatar_url":"https://avatars.githubusercontent.com/u/9021673?v=4","gravatar_id":"","url":"https://api.github.com/users/OlegVegan","html_url":"https://github.com/OlegVegan","followers_url":"https://api.github.com/users/OlegVegan/followers","following_url":"https://api.github.com/users/OlegVegan/following{/other_user}","gists_url":"https://api.github.com/users/OlegVegan/gists{/gist_id}","starred_url":"https://api.github.com/users/OlegVegan/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/OlegVegan/subscriptions","organizations_url":"https://api.github.com/users/OlegVegan/orgs","repos_url":"https://api.github.com/users/OlegVegan/repos","events_url":"https://api.github.com/users/OlegVegan/events{/privacy}","received_events_url":"https://api.github.com/users/OlegVegan/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-09-08T20:44:23Z","updated_at":"2025-09-08T20:44:23Z","body":"> There is a nice section in the docs that talks about this problem \n\nChanging sorting_offset in label's properties solved the issue. I'm sorry, I didn't know about that. I'm closing this\n","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3267955648/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null}]