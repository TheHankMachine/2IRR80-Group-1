[{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/1921914615","pull_request_review_id":2561537433,"id":1921914615,"node_id":"PRRC_kwDOAO6SJc5yjhb3","diff_hunk":"@@ -6,6 +6,7 @@\n \t<description>\n \t\t[SubViewport] Isolates a rectangular region of a scene to be displayed independently. This can be used, for example, to display UI in 3D space.\n \t\t[b]Note:[/b] [SubViewport] is a [Viewport] that isn't a [Window], i.e. it doesn't draw anything by itself. To display anything, [SubViewport] must have a non-zero size and be either put inside a [SubViewportContainer] or assigned to a [ViewportTexture].\n+\t\t[b]Note:[/b] [InputEvent]s are not passed to a standalone [SubViewport] by default. To ensure [InputEvent] propagation, the [SubViewport] must be inside of a [SubViewportContainer].","path":"doc/classes/SubViewport.xml","commit_id":"409c9ad2354cbade4017b1f2a03b9832a52bf45c","original_commit_id":"81a4fe92c4844741719e6c02d34b1e0e127ecdd1","user":{"login":"Sauermann","id":6299227,"node_id":"MDQ6VXNlcjYyOTkyMjc=","avatar_url":"https://avatars.githubusercontent.com/u/6299227?v=4","gravatar_id":"","url":"https://api.github.com/users/Sauermann","html_url":"https://github.com/Sauermann","followers_url":"https://api.github.com/users/Sauermann/followers","following_url":"https://api.github.com/users/Sauermann/following{/other_user}","gists_url":"https://api.github.com/users/Sauermann/gists{/gist_id}","starred_url":"https://api.github.com/users/Sauermann/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Sauermann/subscriptions","organizations_url":"https://api.github.com/users/Sauermann/orgs","repos_url":"https://api.github.com/users/Sauermann/repos","events_url":"https://api.github.com/users/Sauermann/events{/privacy}","received_events_url":"https://api.github.com/users/Sauermann/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"The word \"must\" is too strong. There are alternatives, as for example shown in the [GUI in 3D Demo](https://github.com/godotengine/godot-demo-projects/tree/master/viewport/gui_in_3d).","created_at":"2025-01-20T07:31:33Z","updated_at":"2025-01-20T07:31:33Z","html_url":"https://github.com/godotengine/godot/pull/101818#discussion_r1921914615","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/101818","_links":{"self":{"href":"https://api.github.com/repos/godotengine/godot/pulls/comments/1921914615"},"html":{"href":"https://github.com/godotengine/godot/pull/101818#discussion_r1921914615"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/101818"}},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/1921914615/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":null,"original_line":9,"side":"RIGHT","author_association":"CONTRIBUTOR","original_position":4,"position":1,"subject_type":"line"}]