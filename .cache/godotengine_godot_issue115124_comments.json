.com/users/Kiyuja/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Kiyuja/subscriptions","organizations_url":"https://api.github.com/users/Kiyuja/orgs","repos_url":"https://api.github.com/users/Kiyuja/repos","events_url":"https://api.github.com/users/Kiyuja/events{/privacy}","received_events_url":"https://api.github.com/users/Kiyuja/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-02-20T11:42:22Z","updated_at":"2026-02-20T11:42:22Z","body":"alright, thanks for your input. I might open a feature request for it.","author_association":"NONE","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3933468562/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null}]