ived_by":null},{"id":3240950060,"node_id":"MDU6TGFiZWwzMjQwOTUwMDYw","url":"https://api.github.com/repos/godotengine/godot/labels/performance","name":"performance","color":"447777","default":false,"description":"","archived_at":null,"archived_by":null}],"state":"open","locked":false,"assignees":[],"milestone":{"url":"https://api.github.com/repos/godotengine/godot/milestones/16","html_url":"https://github.com/godotengine/godot/milestone/16","labels_url":"https://api.github.com/repos/godotengine/godot/milestones/16/labels","id":8237783,"node_id":"MI_kwDOAO6SJc4AfbLX","number":16,"title":"4.x","description":"Issues and pull requests slated for an undetermined Godot 4 release.","creator":{"login":"akien-mga","id":4701338,"node_id":"MDQ6VXNlcjQ3MDEzMzg=","avatar_url":"https://avatars.githubusercontent.com/u/4701338?v=4","gravatar_id":"","url":"https://api.github.com/users/akien-mga","html_url":"https://github.com/akien-mga","followers_url":"https://api.github.com/users/akien-mga/followers","following_url":"https://api.github.com/users/akien-mga/following{/other_user}","gists_url":"https://api.github.com/users/akien-mga/gists{/gist_id}","starred_url":"https://api.github.com/users/akien-mga/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/akien-mga/subscriptions","organizations_url":"https://api.github.com/users/akien-mga/orgs","repos_url":"https://api.github.com/users/akien-mga/repos","events_url":"https://api.github.com/users/akien-mga/events{/privacy}","received_events_url":"https://api.github.com/users/akien-mga/received_events","type":"User","user_view_type":"public","site_admin":false},"open_issues":5791,"closed_issues":0,"state":"open","created_at":"2022-07-26T12:42:05Z","updated_at":"2026-10-21T22:40:26Z","due_on":null,"closed_at":null},"comments":2,"created_at":"2026-03-02T01:21:58Z","updated_at":"2026-07-27T12:32:41Z","closed_at":null,"assignee":null,"author_association":"CONTRIBUTOR","issue_field_values":[],"type":null,"active_lock_reason":null,"draft":false,"pull_request":{"url":"https://api.github.com/repos/godotengine/godot/pulls/116941","html_url":"https://github.com/godotengine/godot/pull/116941","diff_url":"https://github.com/godotengine/godot/pull/116941.diff","patch_url":"https://github.com/godotengine/godot/pull/116941.patch","merged_at":null},"body":"If `pos` is unsigned, the compiler will perform *slightly* more aggressive optimizations in case of a QOA stream (which uses constant divisions and modulo to map to the decoded buffer). Other compression formats have a negligible difference.\r\n\r\nProfiled using a test project that plays 768 at nearly the same time using `AudioStreamPolyphonic` for 10 seconds, essentially a stress test.\r\n\r\nOn `dev_build=yes optimize=debug` builds (which already optimizes significantly), `decode_samples` took around 9% less CPU cycles after the change.\r\n\r\nOn `production=yes target=template_release` builds I only measured CPU usage through system monitor:\r\n| Build | CPU usage |\r\n|-|-|\r\n| `master` | 3.0-3.2% |\r\n| PR | 2.9-3.1% |\r\n\r\nThe improvement isn't that significant, but I believe lower-end CPUs could probably feel a difference.\r\n\r\n`decode_samples`'s `p_offset` virtually can't receive a negative value, so doing this should be safe.","closed_by":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/116941/reactions","total_count":4,"+1":4,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/godotengine/godot/issues/116941/timeline","performed_via_github_app":null,"state_reason":null}