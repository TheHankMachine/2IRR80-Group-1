l,"archived_by":null},{"id":9959029909,"node_id":"LA_kwDOAO6SJc8AAAACUZq8lQ","url":"https://api.github.com/repos/godotengine/godot/labels/cherrypick:4.6","name":"cherrypick:4.6","color":"446699","default":false,"description":"Considered for cherry-picking into a future 4.6.x release","archived_at":null,"archived_by":null},{"id":10951989861,"node_id":"LA_kwDOAO6SJc8AAAACjMoaZQ","url":"https://api.github.com/repos/godotengine/godot/labels/cherrypick:4.7","name":"cherrypick:4.7","color":"446699","default":false,"description":"Considered for cherry-picking into a future 4.7.x release","archived_at":null,"archived_by":null}],"state":"closed","locked":false,"assignees":[],"milestone":{"url":"https://api.github.com/repos/godotengine/godot/milestones/25","html_url":"https://github.com/godotengine/godot/milestone/25","labels_url":"https://api.github.com/repos/godotengine/godot/milestones/25/labels","id":15520464,"node_id":"MI_kwDOAO6SJc4A7NLQ","number":25,"title":"4.8","description":"","creator":{"login":"Repiteo","id":17489292,"node_id":"MDQ6VXNlcjE3NDg5Mjky","avatar_url":"https://avatars.githubusercontent.com/u/17489292?v=4","gravatar_id":"","url":"https://api.github.com/users/Repiteo","html_url":"https://github.com/Repiteo","followers_url":"https://api.github.com/users/Repiteo/followers","following_url":"https://api.github.com/users/Repiteo/following{/other_user}","gists_url":"https://api.github.com/users/Repiteo/gists{/gist_id}","starred_url":"https://api.github.com/users/Repiteo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Repiteo/subscriptions","organizations_url":"https://api.github.com/users/Repiteo/orgs","repos_url":"https://api.github.com/users/Repiteo/repos","events_url":"https://api.github.com/users/Repiteo/events{/privacy}","received_events_url":"https://api.github.com/users/Repiteo/received_events","type":"User","user_view_type":"public","site_admin":false},"open_issues":345,"closed_issues":2336,"state":"open","created_at":"2026-04-13T15:59:35Z","updated_at":"2026-10-22T08:21:32Z","due_on":null,"closed_at":null},"comments":1,"created_at":"2026-10-12T17:59:36Z","updated_at":"2026-10-12T22:40:41Z","closed_at":"2026-10-12T22:40:14Z","assignee":null,"author_association":"CONTRIBUTOR","issue_field_values":[],"type":null,"active_lock_reason":null,"draft":false,"pull_request":{"url":"https://api.github.com/repos/godotengine/godot/pulls/124412","html_url":"https://github.com/godotengine/godot/pull/124412","diff_url":"https://github.com/godotengine/godot/pull/124412.diff","patch_url":"https://github.com/godotengine/godot/pull/124412.patch","merged_at":"2026-10-12T22:40:14Z"},"body":"This fixes a corner case in the old mesh conversion code.\n\nWe currently use 16-bit vertices for meshes with <= 65536 vertices, and 32-bit otherwise:\nhttps://github.com/godotengine/godot/blob/9dc0ca79544a5a227f97619fd4ab13fa4346ba91/servers/rendering/renderer_rd/storage_rd/mesh_storage.cpp#L418\n\nHowever, 3.x used 16-bit vertices for meshes with < 65536 vertices, and 32-bit otherwise:\nhttps://github.com/nikitalita/godot/blob/ed879eb87b1d4cd8c100815f7061bf93511b6611/drivers/gles3/rasterizer_storage_gles3.cpp#L3567\n\nIf we have a 3.x mesh that has vertex count of exactly 65536, then the index data will be 32-bit, but the rendering server will attempt to parse the index data will as 16-bit and then fail because it will not be of the expected size.\n\nThe solution in this case is to just convert the 32-bit indices to 16-bit indices.","closed_by":{"login":"Repiteo","id":17489292,"node_id":"MDQ6VXNlcjE3NDg5Mjky","avatar_url":"https://avatars.githubusercontent.com/u/17489292?v=4","gravatar_id":"","url":"https://api.github.com/users/Repiteo","html_url":"https://github.com/Repiteo","followers_url":"https://api.github.com/users/Repiteo/followers","following_url":"https://api.github.com/users/Repiteo/following{/other_user}","gists_url":"https://api.github.com/users/Repiteo/gists{/gist_id}","starred_url":"https://api.github.com/users/Repiteo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Repiteo/subscriptions","organizations_url":"https://api.github.com/users/Repiteo/orgs","repos_url":"https://api.github.com/users/Repiteo/repos","events_url":"https://api.github.com/users/Repiteo/events{/privacy}","received_events_url":"https://api.github.com/users/Repiteo/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/124412/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/godotengine/godot/issues/124412/timeline","performed_via_github_app":null,"state_reason":null}