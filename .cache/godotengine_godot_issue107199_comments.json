body":"I've attempted to work around this in nixpkgs by removing `-fmodules`.  It does compile (with warnings), but I imagine bad stuff is going to happen.","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3819761322/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null}]