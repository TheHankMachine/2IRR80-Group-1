_FILL`:\n\n<img width=\"863\" height=\"513\" alt=\"Image\" src=\"https://github.com/user-attachments/assets/9afdfc91-f6c0-44ff-bf30-b08164800a50\" />\n\n`SIZE_EXPAND` + `SIZE_SHRINK_BEGIN`:\n\n<img width=\"849\" height=\"518\" alt=\"Image\" src=\"https://github.com/user-attachments/assets/d164d55c-c078-47fb-b657-638efe14e42e\" />\n\n`SIZE_EXPAND` + `SIZE_SHRINK_CENTER`:\n\n<img width=\"845\" height=\"496\" alt=\"Image\" src=\"https://github.com/user-attachments/assets/43da8e6e-3c33-4dbd-a1af-1c8f1abf11c2\" />\n\n`SIZE_EXPAND` + `SIZE_SHRINK_END`:\n\n<img width=\"870\" height=\"492\" alt=\"Image\" src=\"https://github.com/user-attachments/assets/4359b8eb-21c6-4309-b5f8-2bd5efc00ea9\" />","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4580370118/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null}]