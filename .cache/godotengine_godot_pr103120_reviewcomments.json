50:45Z","html_url":"https://github.com/godotengine/godot/pull/103120#discussion_r1966153672","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/103120","_links":{"self":{"href":"https://api.github.com/repos/godotengine/godot/pulls/comments/1966153672"},"html":{"href":"https://github.com/godotengine/godot/pull/103120#discussion_r1966153672"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/103120"}},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/1966153672/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":145,"original_line":145,"side":"RIGHT","in_reply_to_id":1965399455,"author_association":"MEMBER","original_position":4,"position":4,"subject_type":"line"},{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/1966723059","pull_request_review_id":2635488885,"id":1966723059,"node_id":"PRRC_kwDOAO6SJc51Oc_z","diff_hunk":"@@ -142,13 +142,16 @@ Error ResourceImporterCSVTranslation::import(ResourceUID::ID p_source_id, const\n \t\t}\n \n \t\tString save_path = p_source_file.get_basename() + \".\" + translations[i]->get_locale() + \".translation\";\n+\t\tResourceUID::ID save_id = hash64_murmur3_64(translations[i]->get_locale().hash64(), p_source_id) & 0x7FFFFFFFFFFFFFFF;","path":"editor/import/resource_importer_csv_translation.cpp","commit_id":"f2ad4303aab42e70b2caefa59a33321b8d51cf5c","original_commit_id":"7131b5248586d54fd7d2af4be7e96612d9dfe70e","user":{"login":"kiroxas","id":3176062,"node_id":"MDQ6VXNlcjMxNzYwNjI=","avatar_url":"https://avatars.githubusercontent.com/u/3176062?v=4","gravatar_id":"","url":"https://api.github.com/users/kiroxas","html_url":"https://github.com/kiroxas","followers_url":"https://api.github.com/users/kiroxas/followers","following_url":"https://api.github.com/users/kiroxas/following{/other_user}","gists_url":"https://api.github.com/users/kiroxas/gists{/gist_id}","starred_url":"https://api.github.com/users/kiroxas/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/kiroxas/subscriptions","organizations_url":"https://api.github.com/users/kiroxas/orgs","repos_url":"https://api.github.com/users/kiroxas/repos","events_url":"https://api.github.com/users/kiroxas/events{/privacy}","received_events_url":"https://api.github.com/users/kiroxas/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"The motivation for this change is to know that its the same value that the one in resource_uid, and a basic search of the term shows us where it is used. Changing to INT_64_MAX is worse in this regard. `0x7FFFFFFFFFFFFFFF` is not very good because it's a mask value that can be used in a lot of different places for different purposes. Calling it `ResourceUID::MASK_VALUE` make it very clear what this is, and that it is suppose to be the same everywhere, not a happy accident that they match, and searching fot the term across the codebase only show you the use that are relevant. \r\n\r\n>  I'm trying to keep this change minimal\r\n\r\nI understand that, but it is just a rename operation, there is no risk to it. But, _as I just said_, it is only a rename operation, so I guess it can wait for 4.4 to be out, as it will not affect anything but readability. ","created_at":"2025-02-23T09:33:34Z","updated_at":"2025-02-23T09:33:34Z","html_url":"https://github.com/godotengine/godot/pull/103120#discussion_r1966723059","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/103120","_links":{"self":{"href":"https://api.github.com/repos/godotengine/godot/pulls/comments/1966723059"},"html":{"href":"https://github.com/godotengine/godot/pull/103120#discussion_r1966723059"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/103120"}},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/1966723059/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":145,"original_line":145,"side":"RIGHT","in_reply_to_id":1965399455,"author_association":"CONTRIBUTOR","original_position":4,"position":4,"subject_type":"line"}]