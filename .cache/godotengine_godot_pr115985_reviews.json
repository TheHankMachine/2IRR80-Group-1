[{"id":3796931421,"node_id":"PRR_kwDOAO6SJc7iUJNd","user":{"login":"groud","id":6093119,"node_id":"MDQ6VXNlcjYwOTMxMTk=","avatar_url":"https://avatars.githubusercontent.com/u/6093119?u=789cd3344bf445b635897d21c6ae655be56a1a8f&v=4","gravatar_id":"","url":"https://api.github.com/users/groud","html_url":"https://github.com/groud","followers_url":"https://api.github.com/users/groud/followers","following_url":"https://api.github.com/users/groud/following{/other_user}","gists_url":"https://api.github.com/users/groud/gists{/gist_id}","starred_url":"https://api.github.com/users/groud/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/groud/subscriptions","organizations_url":"https://api.github.com/users/groud/orgs","repos_url":"https://api.github.com/users/groud/repos","events_url":"https://api.github.com/users/groud/events{/privacy}","received_events_url":"https://api.github.com/users/groud/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"Hmm, I think the approach might be fine but I have a small issue with it. The problem is that if you do something like that:\n```\ntile_set.add_source(source, id)\nsource.set_something(foo)\nsource.set_something_else(bar)\n```\nThen it means that the modified `source` is not the one you've just added to the given TileSet.\n\nI think a better solution would be to duplicate the source in the previous TileSet instead, so that the source is sure to still be the one you are passing as argument.","state":"CHANGES_REQUESTED","html_url":"https://github.com/godotengine/godot/pull/115985#pullrequestreview-3796931421","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/115985","author_association":"MEMBER","_links":{"html":{"href":"https://github.com/godotengine/godot/pull/115985#pullrequestreview-3796931421"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/115985"}},"submitted_at":"2026-02-13T12:13:46Z","commit_id":"515968118732d75f0b7b64e51