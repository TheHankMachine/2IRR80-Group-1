github.com/users/RickVegasGames/events{/privacy}","received_events_url":"https://api.github.com/users/RickVegasGames/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-01-23T07:53:10Z","updated_at":"2025-01-23T07:53:43Z","body":"Yeah I'm convinced now it's a GPU issue. I tried playing Uplink and I can generate the same exact issue on that game. Godot and [Uplink](https://store.steampowered.com/app/1510/Uplink/) don't have any thing related so it has to be something on the hardware side instead, just not sure what. ","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2609085361/reactions","total_count":3,"+1":3,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2612590000","html_url":"https://github.com/godotengine/godot/issues/99956#issuecomment-2612590000","issue_url":"https://api.github.com/repos/godotengine/godot/issues/99956","id":2612590000,"node_id":"IC_kwDOAO6SJc6buPWw","user":{"login":"BrunoMakesThings","id":51202692,"node_id":"MDQ6VXNlcjUxMjAyNjky","avatar_url":"https://avatars.githubusercontent.com/u/51202692?v=4","gravatar_id":"","url":"https://api.github.com/users/BrunoMakesThings","html_url":"https://github.com/BrunoMakesThings","followers_url":"https://api.github.com/users/BrunoMakesThings/followers","following_url":"https://api.github.com/users/BrunoMakesThings/following{/other_user}","gists_url":"https://api.github.com/users/BrunoMakesThings/gists{/gist_id}","starred_url":"https://api.github.com/users/BrunoMakesThings/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/BrunoMakesThings/subscriptions","organizations_url":"https://api.github.com/users/BrunoMakesThings/orgs","repos_url":"https://api.github.com/users/BrunoMakesThings/repos","events_url":"https://api.github.com/users/BrunoMakesThings/events{/privacy}","received_events_url":"https://api.github.com/users/BrunoMakesThings/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-01-24T13:56:14Z","updated_at":"2025-01-24T13:56:14Z","body":"As a workaroud for people with snapdragon and this problem, try to force it to run in d3d12 rendering mode (command line). \nIn my laptop seems to have stoped the problem (it was running, by default in opengl compatibility mode with d3d12).\n\nHave in mind i've tried it on v4.4-beta, i believe it coul work on 4.3-sable as well.\n\nAs an extra info, i got that microsoft compatibility layer for arm from windows store installed, it was already installed but i don't know if it makes any difference.\n\nStill haven't used much in this rendering mode as i've found it late last night, but the IDE side seems to be faster than running in opengl, and it enables me to use forward+ and mobile modes on projects.","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2612590000/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2622309764","html_url":"https://github.com/godotengine/godot/issues/99956#issuecomment-2622309764","issue_url":"https://api.github.com/repos/godotengine/godot/issues/99956","id":2622309764,"node_id":"IC_kwDOAO6SJc6cTUWE","user":{"login":"AFasterSlowpoke","id":132897534,"node_id":"U_kgDOB-va_g","avatar_url":"https://avatars.githubusercontent.com/u/132897534?v=4","gravatar_id":"","url":"https://api.github.com/users/AFasterSlowpoke","html_url":"https://github.com/AFasterSlowpoke","followers_url":"https://api.github.com/users/AFasterSlowpoke/followers","following_url":"https://api.github.com/users/AFasterSlowpoke/following{/other_user}","gists_url":"https://api.github.com/users/AFasterSlowpoke/gists{/gist_id}","starred_url":"https://api.github.com/users/AFasterSlowpoke/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/AFasterSlowpoke/subscriptions","organizations_url":"https://api.github.com/users/AFasterSlowpoke/orgs","repos_url":"https://api.github.com/users/AFasterSlowpoke/repos","events_url":"https://api.github.com/users/AFasterSlowpoke/events{/privacy}","received_events_url":"https://api.github.com/users/AFasterSlowpoke/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-01-29T17:20:34Z","updated_at":"2025-01-29T17:20:43Z","body":"> As a workaroud for people with snapdragon and this problem, try to force it to run in d3d12 rendering mode (command line). In my laptop seems to have stoped the problem (it was running, by default in opengl compatibility mode with d3d12).\n\nHow do you force Godot to run in d3d12 rendering mode, and where is the link to install the microsoft compatibility layer for arm?","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2622309764/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2622567738","html_url":"https://github.com/godotengine/godot/issues/99956#issuecomment-2622567738","issue_url":"https://api.github.com/repos/godotengine/godot/issues/99956","id":2622567738,"node_id":"IC_kwDOAO6SJc6cUTU6","user":{"login":"BrunoMakesThings","id":51202692,"node_id":"MDQ6VXNlcjUxMjAyNjky","avatar_url":"https://avatars.githubusercontent.com/u/51202692?v=4","gravatar_id":"","url":"https://api.github.com/users/BrunoMakesThings","html_url":"https://github.com/BrunoMakesThings","followers_url":"https://api.github.com/users/BrunoMakesThings/followers","following_url":"https://api.github.com/users/BrunoMakesThings/following{/other_user}","gists_url":"https://api.github.com/users/BrunoMakesThings/gists{/gist_id}","starred_url":"https://api.github.com/users/BrunoMakesThings/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/BrunoMakesThings/subscriptions","organizations_url":"https://api.github.com/users/BrunoMakesThings/orgs","repos_url":"https://api.github.com/users/BrunoMakesThings/repos","events_url":"https://api.github.com/users/BrunoMakesThings/events{/privacy}","received_events_url":"https://api.github.com/users/BrunoMakesThings/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-01-29T18:52:37Z","updated_at":"2025-01-29T18:52:37Z","body":"> > As a workaroud for people with snapdragon and this problem, try to force it to run in d3d12 rendering mode (command line). In my laptop seems to have stoped the problem (it was running, by default in opengl compatibility mode with d3d12).\n> \n> How do you force Godot to run in d3d12 rendering mode, and where is the link to install the microsoft compatibility layer for arm?\n\nThe compatibility layer i got in microsoft store application, i don't know the application name in English, in portuguese is \"Aprimoramentos de Compatibilidade de Aplicativos do Windows\". Don't know if it is really needed, i already had it installed.\n\nTo run in D3D12 mode you can pass this when calling the executable in command line or create a shortcut and add the command to it. The command is:\n`--rendering-driver d3d12`\n\nI've been using it without problems, but only in basic study projects, however if your project is Forward+ or Mobile (or you start a new project in one of those), the game will automatically be set up to use Vulkan Rendering, that will crash when you try to run the game, so i would recommend to open the project settings and change the render to d3d12 as well (the open gl tab i also set manually to use angle, but i don't know if it was needed).\n\nHope it helps, and sorry if my messages are confusing, english is not my first language.","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2622567738/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2622621480","html_url":"https://github.com/godotengine/godot/issues/99956#issuecomment-2622621480","issue_url":"https://api.github.com/repos/godotengine/godot/issues/99956","id":2622621480,"node_id":"IC_kwDOAO6SJc6cUgco","user":{"login":"AFasterSlowpoke","id":132897534,"node_id":"U_kgDOB-va_g","avatar_url":"https://avatars.githubusercontent.com/u/132897534?v=4","gravatar_id":"","url":"https://api.github.com/users/AFasterSlowpoke","html_url":"https://github.com/AFasterSlowpoke","followers_url":"https://api.github.com/users/AFasterSlowpoke/followers","following_url":"https://api.github.com/users/AFasterSlowpoke/following{/other_user}","gists_url":"https://api.github.com/users/AFasterSlowpoke/gists{/gist_id}","starred_url":"https://api.github.com/users/AFasterSlowpoke/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/AFasterSlowpoke/subscriptions","organizations_url":"https://api.github.com/users/AFasterSlowpoke/orgs","repos_url":"https://api.github.com/users/AFasterSlowpoke/repos","events_url":"https://api.github.com/users/AFasterSlowpoke/events{/privacy}","received_events_url":"https://api.github.com/users/AFasterSlowpoke/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-01-29T19:17:08Z","updated_at":"2025-01-29T19:17:08Z","body":"> > > As a workaroud for people with snapdragon and this problem, try to force it to run in d3d12 rendering mode (command line). In my laptop seems to have stoped the problem (it was running, by default in opengl compatibility mode with d3d12).\n> > \n> > \n> > How do you force Godot to run in d3d12 rendering mode, and where is the link to install the microsoft compatibility layer for arm?\n> \n> The compatibility layer i got in microsoft store application, i don't know the application name in English, in portuguese is \"Aprimoramentos de Compatibilidade de Aplicativos do Windows\". Don't know if it is really needed, i already had it installed.\n> \n> To run in D3D12 mode you can pass this when calling the executable in command line or create a shortcut and add the command to it. The command is: `--rendering-driver d3d12`\n> \n> I've been using it without problems, but only in basic study projects, however if your project is Forward+ or Mobile (or you start a new project in one of those), the game will automatically be set up to use Vulkan Rendering, that will crash when you try to run the game, so i would recommend to open the project settings and change the render to d3d12 as well (the open gl tab i also set manually to use angle, but i don't know if it was needed).\n> \n> Hope it helps, and sorry if my messages are confusing, english is not my first language.\n\nThank you, the double GUI issue is gone, and I did not need to install the Compatibility app! My project (which was in Compatibility mode) goes into Forward+ mode during d3d12 rendering, but I don't find that to be a problem for now.\n\nI've listed the commands I've used to fix the double GUI issue:\n```\nC:\\Users\\[my name]>cd Downloads\\Godot_v4.3-stable_win64.exe. (that is the path of my godot installation)\nC:\\Users\\[my name]\\Downloads\\Godot_v4.3-stable_win64.exe>start Godot_v4.3-stable_win64.exe  --rendering-driver d3d12\n```\n","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2622621480/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2622662499","html_url":"https://github.com/godotengine/godot/issues/99956#issuecomment-2622662499","issue_url":"https://api.github.com/repos/godotengine/godot/issues/99956","id":2622662499,"node_id":"IC_kwDOAO6SJc6cUqdj","user":{"login":"BrunoMakesThings","id":51202692,"node_id":"MDQ6VXNlcjUxMjAyNjky","avatar_url":"https://avatars.githubusercontent.com/u/51202692?v=4","gravatar_id":"","url":"https://api.github.com/users/BrunoMakesThings","html_url":"https://github.com/BrunoMakesThings","followers_url":"https://api.github.com/users/BrunoMakesThings/followers","following_url":"https://api.github.com/users/BrunoMakesThings/following{/other_user}","gists_url":"https://api.github.com/users/BrunoMakesThings/gists{/gist_id}","starred_url":"https://api.github.com/users/BrunoMakesThings/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/BrunoMakesThings/subscriptions","organizations_url":"https://api.github.com/users/BrunoMakesThings/orgs","repos_url":"https://api.github.com/users/BrunoMakesThings/repos","events_url":"https://api.github.com/users/BrunoMakesThings/events{/privacy}","received_events_url":"https://api.github.com/users/BrunoMakesThings/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-01-29T19:34:06Z","updated_at":"2025-01-29T19:34:06Z","body":"> > > > As a workaroud for people with snapdragon and this problem, try to force it to run in d3d12 rendering mode (command line). In my laptop seems to have stoped the problem (it was running, by default in opengl compatibility mode with d3d12).\n> > > \n> > > \n> > > How do you force Godot to run in d3d12 rendering mode, and where is the link to install the microsoft compatibility layer for arm?\n> > \n> > \n> > The compatibility layer i got in microsoft store application, i don't know the application name in English, in portuguese is \"Aprimoramentos de Compatibilidade de Aplicativos do Windows\". Don't know if it is really needed, i already had it installed.\n> > To run in D3D12 mode you can pass this when calling the executable in command line or create a shortcut and add the command to it. The command is: `--rendering-driver d3d12`\n> > I've been using it without problems, but only in basic study projects, however if your project is Forward+ or Mobile (or you start a new project in one of those), the game will automatically be set up to use Vulkan Rendering, that will crash when you try to run the game, so i would recommend to open the project settings and change the render to d3d12 as well (the open gl tab i also set manually to use angle, but i don't know if it was needed).\n> > Hope it helps, and sorry if my messages are confusing, english is not my first language.\n> \n> Thank you, the double GUI issue is gone, and I did not need to install the Compatibility app! My project (which was in Compatibility mode) goes into Forward+ mode during d3d12 rendering, but I don't find that to be a problem for now.\n> \n> I've listed the commands I've used to fix the double GUI issue:\n> \n> ```\n> C:\\Users\\[my name]>cd Downloads\\Godot_v4.3-stable_win64.exe. (that is the path of my godot installation)\n> C:\\Users\\[my name]\\Downloads\\Godot_v4.3-stable_win64.exe>start Godot_v4.3-stable_win64.exe  --rendering-driver d3d12\n> ```\n\nBy the file name i've noticed you're using the win64 version, if you get the arm version you may get better performance. Your laptop is newer than mine, maybe you don't even need it. I'm using this setup with a Snapdragon 7c gen 2, Adreno 618 and 4gb ram... So for me every little performance improovement i can get (and escaping emulation layers on windows) the better.","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2622662499/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2656848582","html_url":"https://github.com/godotengine/godot/issues/99956#issuecomment-2656848582","issue_url":"https://api.github.com/repos/godotengine/godot/issues/99956","id":2656848582,"node_id":"IC_kwDOAO6SJc6eXErG","user":{"login":"AFasterSlowpoke","id":132897534,"node_id":"U_kgDOB-va_g","avatar_url":"https://avatars.githubusercontent.com/u/132897534?v=4","gravatar_id":"","url":"https://api.github.com/users/AFasterSlowpoke","html_url":"https://github.com/AFasterSlowpoke","followers_url":"https://api.github.com/users/AFasterSlowpoke/followers","following_url":"https://api.github.com/users/AFasterSlowpoke/following{/other_user}","gists_url":"https://api.github.com/users/AFasterSlowpoke/gists{/gist_id}","starred_url":"https://api.github.com/users/AFasterSlowpoke/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/AFasterSlowpoke/subscriptions","organizations_url":"https://api.github.com/users/AFasterSlowpoke/orgs","repos_url":"https://api.github.com/users/AFasterSlowpoke/repos","events_url":"https://api.github.com/users/AFasterSlowpoke/events{/privacy}","received_events_url":"https://api.github.com/users/AFasterSlowpoke/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-02-13T14:52:44Z","updated_at":"2025-02-13T14:52:44Z","body":"i think that a good \"fix\" for this would be when godot is first starting up, it detects the type of CPU and other specs you're using.\nIf you're using a Snapdragon CPU (or another CPU or specs that may cause the double GUI bug), it will prompt you if you want to start up Godot in d3d12 rendering mode, and explain why (but in a simple way as to not confuse newcomers and recommend people to start in d3d12 mode).","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2656848582/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null}]