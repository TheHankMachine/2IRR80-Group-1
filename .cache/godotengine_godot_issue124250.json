ved_at":null,"archived_by":null},{"id":279098082,"node_id":"MDU6TGFiZWwyNzkwOTgwODI=","url":"https://api.github.com/repos/godotengine/godot/labels/topic:gdscript","name":"topic:gdscript","color":"ffee88","default":false,"description":"","archived_at":null,"archived_by":null}],"state":"closed","locked":false,"assignees":[],"milestone":null,"comments":2,"created_at":"2026-10-07T00:59:49Z","updated_at":"2026-10-07T15:55:05Z","closed_at":"2026-10-07T08:50:19Z","assignee":null,"author_association":"NONE","issue_field_values":[],"type":null,"active_lock_reason":null,"draft":false,"pull_request":{"url":"https://api.github.com/repos/godotengine/godot/pulls/124250","html_url":"https://github.com/godotengine/godot/pull/124250","diff_url":"https://github.com/godotengine/godot/pull/124250.diff","patch_url":"https://github.com/godotengine/godot/pull/124250.patch","merged_at":null},"body":"## What problem(s) does this PR solve?\r\n\r\nFixes #103049 \r\n\r\nUsing Array[Object] would not be flagged as a static error and would only be caught as an issue at runtime. This was caused by the \"can_be_builtin\" being passed as true and never checking if it is a meta type. Added an additional check in the analyzer to prevent this. This does not affect other attribute accesses like Vector.ZERO which require the flag to be true. Type annotations are parsed as nodes and are unaffected by the change.\r\n\r\nTest cases created for original problem with for loop, along with general variable assignment which was not reported in the original issue.\r\n\r\nAI was used to find and create a fix for the issue, along with creating the tests. The fix is 3 lines of code adding the new check and was reviewed personally. The check matches the formatting of surrounding code.","closed_by":{"login":"akien-mga","id":4701338,"node_id":"MDQ6VXNlcjQ3MDEzMzg=","avatar_url":"https://avatars.githubusercontent.com/u/4701338?v=4","gravatar_id":"","url":"https://api.github.com/users/akien-mga","html_url":"https://github.com/akien-mga","followers_url":"https://api.github.com/users/akien-mga/followers","following_url":"https://api.github.com/users/akien-mga/following{/other_user}","gists_url":"https://api.github.com/users/akien-mga/gists{/gist_id}","starred_url":"https://api.github.com/users/akien-mga/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/akien-mga/subscriptions","organizations_url":"https://api.github.com/users/akien-mga/orgs","repos_url":"https://api.github.com/users/akien-mga/repos","events_url":"https://api.github.com/users/akien-mga/events{/privacy}","received_events_url":"https://api.github.com/users/akien-mga/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/124250/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/godotengine/godot/issues/124250/timeline","performed_via_github_app":null,"state_reason":null}