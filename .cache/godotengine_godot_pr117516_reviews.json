[{"id":3963386573,"node_id":"PRR_kwDOAO6SJc7sPHrN","user":{"login":"StarryWorm","id":41305715,"node_id":"MDQ6VXNlcjQxMzA1NzE1","avatar_url":"https://avatars.githubusercontent.com/u/41305715?u=a27600b43b5278ada0f7abc144fcb1b615bdef8e&v=4","gravatar_id":"","url":"https://api.github.com/users/StarryWorm","html_url":"https://github.com/StarryWorm","followers_url":"https://api.github.com/users/StarryWorm/followers","following_url":"https://api.github.com/users/StarryWorm/following{/other_user}","gists_url":"https://api.github.com/users/StarryWorm/gists{/gist_id}","starred_url":"https://api.github.com/users/StarryWorm/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/StarryWorm/subscriptions","organizations_url":"https://api.github.com/users/StarryWorm/orgs","repos_url":"https://api.github.com/users/StarryWorm/repos","events_url":"https://api.github.com/users/StarryWorm/events{/privacy}","received_events_url":"https://api.github.com/users/StarryWorm/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"Whilst this change feels a bit out there, I believe it is worth it.\nLooks good to me on all fronts!\n\nMaybe some trick using the `using` keyword could be used to make the change less noisy for files that include `resource_uid.h`. Something like this:\n```\nusing ID = ResourceUIDTypes::ID;\nusing INVALID_ID = ResourceUIDTypes::INVALID_ID;\n```\nadded to `resource_uid.h` would do the trick. Not necessary though. ","state":"APPROVED","html_url":"https://github.com/godotengine/godot/pull/117516#pullrequestreview-3963386573","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/117516","author_association":"CONTRIBUTOR","_links":{"html":{"href":"https://github.com/godotengine/godot/pull/117516#pullrequestreview-3963386573"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/117516"}},"submitted_at":"2026-03-17T19:52:29Z","commit_id":"5ecec89f7c8b523d5ecb91836c793372f8428eae"}]