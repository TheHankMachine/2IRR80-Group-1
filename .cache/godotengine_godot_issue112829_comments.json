[{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3536884471","html_url":"https://github.com/godotengine/godot/issues/112829#issuecomment-3536884471","issue_url":"https://api.github.com/repos/godotengine/godot/issues/112829","id":3536884471,"node_id":"IC_kwDOAO6SJc7S0JL3","user":{"login":"BrotherShort","id":129957860,"node_id":"U_kgDOB77_5A","avatar_url":"https://avatars.githubusercontent.com/u/129957860?v=4","gravatar_id":"","url":"https://api.github.com/users/BrotherShort","html_url":"https://github.com/BrotherShort","followers_url":"https://api.github.com/users/BrotherShort/followers","following_url":"https://api.github.com/users/BrotherShort/following{/other_user}","gists_url":"https://api.github.com/users/BrotherShort/gists{/gist_id}","starred_url":"https://api.github.com/users/BrotherShort/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/BrotherShort/subscriptions","organizations_url":"https://api.github.com/users/BrotherShort/orgs","repos_url":"https://api.github.com/users/BrotherShort/repos","events_url":"https://api.github.com/users/BrotherShort/events{/privacy}","received_events_url":"https://api.github.com/users/BrotherShort/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-11-15T20:59:11Z","updated_at":"2025-12-09T21:21:21Z","body":"We have 2 ways to solve the issue.\n1: TreeItems in edge are both displayed and clickable.\n2: TreeItems in edge are neither displayed nor clickable.\nI finished the 1st at #112830.\nAfter:\n\n![Image](https://github.com/user-attachments/assets/a737f191-e90d-44bf-8d11-3322134d199d)\n----\nWhy do I choose the 1st way?\nIn common GUI frameworks, Items would not be displayed or clicked in edges. But in godot GUI, it's hard to implement the feature. We have to create new functions which compute how to display a partial icon.\nSo I support TreeItems in edge could be displayed and clicked. It is self-consistent, simple and requires fewer changes.","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3536884471/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null}]