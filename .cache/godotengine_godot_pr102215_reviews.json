[{"id":2708058913,"node_id":"PRR_kwDOAO6SJc6habMh","user":{"login":"smix8","id":52464204,"node_id":"MDQ6VXNlcjUyNDY0MjA0","avatar_url":"https://avatars.githubusercontent.com/u/52464204?u=4854f17c9d330a8a9d274f0cb7b943fc2bb6dd44&v=4","gravatar_id":"","url":"https://api.github.com/users/smix8","html_url":"https://github.com/smix8","followers_url":"https://api.github.com/users/smix8/followers","following_url":"https://api.github.com/users/smix8/following{/other_user}","gists_url":"https://api.github.com/users/smix8/gists{/gist_id}","starred_url":"https://api.github.com/users/smix8/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/smix8/subscriptions","organizations_url":"https://api.github.com/users/smix8/orgs","repos_url":"https://api.github.com/users/smix8/repos","events_url":"https://api.github.com/users/smix8/events{/privacy}","received_events_url":"https://api.github.com/users/smix8/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"For the navigation part.","state":"DISMISSED","html_url":"https://github.com/godotengine/godot/pull/102215#pullrequestreview-2708058913","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/102215","author_association":"CONTRIBUTOR","_links":{"html":{"href":"https://github.com/godotengine/godot/pull/102215#pullrequestreview-2708058913"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/102215"}},"submitted_at":"2025-03-22T14:43:01Z","commit_id":"6adff30f918298657ce4b7991199a81b3bf57a4d"},{"id":2710054089,"node_id":"PRR_kwDOAO6SJc6hiCTJ","user":{"login":"mihe","id":4884246,"node_id":"MDQ6VXNlcjQ4ODQyNDY=","avatar_url":"https://avatars.githubusercontent.com/u/4884246?v=4","gravatar_id":"","url":"https://api.github.com/users/mihe","html_url":"https://github.com/mihe","followers_url":"https://api.github.com/users/mihe/followers","following_url":"https://api.github.com/users/mihe/following{/other_user}","gists_url":"https://api.github.com/users/mihe/gists{/gist_id}","starred_url":"https://api.github.com/users/mihe/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/mihe/subscriptions","organizations_url":"https://api.github.com/users/mihe/orgs","repos_url":"https://api.github.com/users/mihe/repos","events_url":"https://api.github.com/users/mihe/events{/privacy}","received_events_url":"https://api.github.com/users/mihe/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"Oh, sorry, this ended up falling through the cracks, my bad.\r\n\r\nAs discussed already, the current exposed/virtual `is_heightmap_hole` method doesn't make much sense in its current form if we're committing to only NaN as the hole constant. It's also in a bit of an inbetween state right now, due to exposing the method to extensions but not scripts.\r\n\r\nSo this needs to be changed to either:\r\n\r\n1. Have `is_heightmap_hole` be a non-virtual inlined method in `PhysicsServer3D` that just calls `Math::is_nan`.\r\n2. Omit `is_heightmap_hole` entirely and rely on `Math::is_nan` in `navmesh_parse_source_geometry`.\r\n\r\nI'm in favor of _only_ documenting NaN and leaving it that, meaning omitting `PhysicsServer3D::is_heightmap_hole` entirely and relying on `Math::is_nan` in `navmesh_parse_source_geometry` instead.\r\n\r\nIf we have `PhysicsServer3D::is_heightmap_hole` as purely an internal helper method, it seems like it'd just be a matter of time before someone asks to expose it to scripts/extensions, and arguing against that when we're using it internally would seem a bit odd, so I feel like we might as well not go down that route.","state":"DISMISSED","html_url":"https://github.com/godotengine/godot/pull/102215#pullrequestreview-2710054089","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/102215","author_association":"CONTRIBUTOR","_links":{"html":{"href":"https://github.com/godotengine/godot/pull/102215#pullrequestreview-2710054089"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/102215"}},"submitted_at":"2025-03-24T11:31:23Z","commit_id":"6adff30f918298657ce4b7991199a81b3bf57a4d"},{"id":2910018941,"node_id":"PRR_kwDOAO6SJc6tc119","user":{"login":"mihe","id":4884246,"node_id":"MDQ6VXNlcjQ4ODQyNDY=","avatar_url":"https://avatars.githubusercontent.com/u/4884246?v=4","gravatar_id":"","url":"https://api.github.com/users/mihe","html_url":"https://github.com/mihe","followers_url":"https://api.github.com/users/mihe/followers","following_url":"https://api.github.com/users/mihe/following{/other_user}","gists_url":"https://api.github.com/users/mihe/gists{/gist_id}","starred_url":"https://api.github.com/users/mihe/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/mihe/subscriptions","organizations_url":"https://api.github.com/users/mihe/orgs","repos_url":"https://api.github.com/users/mihe/repos","events_url":"https://api.github.com/users/mihe/events{/privacy}","received_events_url":"https://api.github.com/users/mihe/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"Since this PR seems to have gotten stuck in a bit of a limbo, and in the interest of getting this merged, I'll go ahead and make the path forward less ambiguous.\r\n\r\n@bluejay-sh Please revert all the physics server changes and have `StaticBody3D::navmesh_parse_source_geometry` use `Math::is_nan` in place of the current `physics_server->is_heightmap_hole` calls.\r\n\r\nAny documentation changes or helper methods can be done in a separate/future PR.\r\n\r\nNaN is already more or less the official (albeit undocumented) hole constant for Godot, and relied upon by popular extensions like Terrain3D, so the reliance upon this in `navmesh_parse_source_geometry` wouldn't really change much in this regard.","state":"CHANGES_REQUESTED","html_url":"https://github.com/godotengine/godot/pull/102215#pullrequestreview-2910018941","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/102215","author_association":"CONTRIBUTOR","_links":{"html":{"href":"https://github.com/godotengine/godot/pull/102215#pullrequestreview-2910018941"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/102215"}},"submitted_at":"2025-06-09T13:07:15Z","commit_id":"6adff30f918298657ce4b7991199a81b3bf57a4d"},{"id":2910294213,"node_id":"PRR_kwDOAO6SJc6td5DF","user":{"login":"smix8","id":52464204,"node_id":"MDQ6VXNlcjUyNDY0MjA0","avatar_url":"https://avatars.githubusercontent.com/u/52464204?u=4854f17c9d330a8a9d274f0cb7b943fc2bb6dd44&v=4","gravatar_id":"","url":"https://api.github.com/users/smix8","html_url":"https://github.com/smix8","followers_url":"https://api.github.com/users/smix8/followers","following_url":"https://api.github.com/users/smix8/following{/other_user}","gists_url":"https://api.github.com/users/smix8/gists{/gist_id}","starred_url":"https://api.github.com/users/smix8/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/smix8/subscriptions","organizations_url":"https://api.github.com/users/smix8/orgs","repos_url":"https://api.github.com/users/smix8/repos","events_url":"https://api.github.com/users/smix8/events{/privacy}","received_events_url":"https://api.github.com/users/smix8/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"","state":"APPROVED","html_url":"https://github.com/godotengine/godot/pull/102215#pullrequestreview-2910294213","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/102215","author_association":"CONTRIBUTOR","_links":{"html":{"href":"https://github.com/godotengine/godot/pull/102215#pullrequestreview-2910294213"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/102215"}},"submitted_at":"2025-06-09T14:41:14Z","commit_id":"6adff30f918298657ce4b7991199a81b3bf57a4d"}]