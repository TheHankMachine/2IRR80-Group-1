mga/received_events","type":"User","user_view_type":"public","site_admin":false},"open_issues":8,"closed_issues":4466,"state":"closed","created_at":"2024-02-14T11:52:07Z","updated_at":"2026-10-05T23:48:31Z","due_on":"2025-03-03T00:00:00Z","closed_at":"2025-03-19T09:35:35Z"},"comments":1,"created_at":"2024-11-10T05:32:01Z","updated_at":"2026-06-26T16:49:47Z","closed_at":"2024-11-11T20:19:10Z","assignee":null,"author_association":"MEMBER","issue_field_values":[],"type":null,"active_lock_reason":null,"draft":false,"pull_request":{"url":"https://api.github.com/repos/godotengine/godot/pulls/99013","html_url":"https://github.com/godotengine/godot/pull/99013","diff_url":"https://github.com/godotengine/godot/pull/99013.diff","patch_url":"https://github.com/godotengine/godot/pull/99013.patch","merged_at":"2024-11-11T20:19:09Z"},"body":"- Fixes https://github.com/godotengine/godot/issues/98609\r\n- ~Supersedes https://github.com/godotengine/godot/pull/98826~ Now conflict is solved\r\n\r\nMakes it optional to snap the FPS to a close integer FPS when in SecondMode.\r\n\r\n![image](https://github.com/user-attachments/assets/4ecc61e0-08ca-4b95-b826-1b6592614449)\r\n\r\nPartially revert https://github.com/godotengine/godot/pull/97569 to disallow fractional FPS because KeyEditor's spin slider syncs with the FPS of the Snap setting, but KeyEditor's spin slider only allows integers, so if fractional FPS is used for snapping, KeyEditor's spin slider will break. Moreover, it is not consistent with this FPS compatible option.\r\n\r\nEven if the KeyEditor spin slider allows fractional values, this will still cause problems due to lack of precision[^1], so the fundamental solution is to separate the FPS values for KeyEditor/Timeline from the step(snapping) values. In other words, it means that we need to add a FPS value as well as a step value to the Animation property, but I feel that it should be an editor-only property because it is too specific to the niche case of fractional FPS.\r\n\r\n[^1]: Since the value of time in KeyEditor exceeds 10.0 usually, there is a lack of precision if we want to use a step of 0.0625 since it will be like 10.0625 or 100.0625","closed_by":{"login":"Repiteo","id":17489292,"node_id":"MDQ6VXNlcjE3NDg5Mjky","avatar_url":"https://avatars.githubusercontent.com/u/17489292?v=4","gravatar_id":"","url":"https://api.github.com/users/Repiteo","html_url":"https://github.com/Repiteo","followers_url":"https://api.github.com/users/Repiteo/followers","following_url":"https://api.github.com/users/Repiteo/following{/other_user}","gists_url":"https://api.github.com/users/Repiteo/gists{/gist_id}","starred_url":"https://api.github.com/users/Repiteo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Repiteo/subscriptions","organizations_url":"https://api.github.com/users/Repiteo/orgs","repos_url":"https://api.github.com/users/Repiteo/repos","events_url":"https://api.github.com/users/Repiteo/events{/privacy}","received_events_url":"https://api.github.com/users/Repiteo/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/99013/reactions","total_count":2,"+1":0,"-1":0,"laugh":0,"hooray":2,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/godotengine/godot/issues/99013/timeline","performed_via_github_app":null,"state_reason":null}