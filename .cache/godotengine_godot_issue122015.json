0-21T22:40:26Z","due_on":null,"closed_at":null},"comments":0,"created_at":"2026-08-01T20:01:44Z","updated_at":"2026-08-03T11:30:19Z","closed_at":null,"assignee":null,"author_association":"NONE","issue_field_values":[],"type":null,"active_lock_reason":null,"draft":false,"pull_request":{"url":"https://api.github.com/repos/godotengine/godot/pulls/122015","html_url":"https://github.com/godotengine/godot/pull/122015","diff_url":"https://github.com/godotengine/godot/pull/122015.diff","patch_url":"https://github.com/godotengine/godot/pull/122015.patch","merged_at":null},"body":"Fixes #122014\r\n\r\nThe shader baker generated baked shader sources with the `RENDER_DRIVER_*` define of the\r\ndriver the editor is running on, instead of the driver the shaders are baked for\r\n(e.g. `RENDER_DRIVER_METAL` when exporting for Windows from a macOS editor). The shader\r\ncache SHA1 doesn't cover this define, so a wrong bake is indistinguishable from a\r\ncorrect one.\r\n\r\nThis PR threads an optional driver name through `version_build_variant_stage_sources()`\r\n→ `_build_variant_stage_sources()` → `_build_variant_code()` so the baker can pass the\r\ntarget container driver. The parameter defaults to the current behavior (host driver),\r\nso runtime compilation and the native source-code inspector are unchanged.\r\n\r\nTested: full editor build on macOS (arm64).","closed_by":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/122015/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/godotengine/godot/issues/122015/timeline","performed_via_github_app":null,"state_reason":null}