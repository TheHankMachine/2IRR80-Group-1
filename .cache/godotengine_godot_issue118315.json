23:12:46Z","closed_at":"2026-04-09T22:48:09Z","assignee":null,"author_association":"MEMBER","issue_field_values":[],"type":null,"active_lock_reason":null,"draft":false,"pull_request":{"url":"https://api.github.com/repos/godotengine/godot/pulls/118315","html_url":"https://github.com/godotengine/godot/pull/118315","diff_url":"https://github.com/godotengine/godot/pull/118315.diff","patch_url":"https://github.com/godotengine/godot/pull/118315.patch","merged_at":"2026-04-09T22:48:09Z"},"body":"Closes https://github.com/godotengine/godot-proposals/issues/14292\r\n\r\nhttps://github.com/user-attachments/assets/13635b4b-67b8-410a-a3e1-12e6cb91ae2e\r\n\r\nTurns out the TileMapLayer editor was already randomizing the tiles with every mouse move. The tiles were random underneath, but only drawn as white, because the actual pattern was useless.\r\n\r\nThe easiest \"fix\" I could come up with was making that deterministic. The tiles are randomized using a fixed RNG object, which changes its seed and state when the cursor moves to a different cell. Thus what you see before clicking is what is going to be painted.\r\n\r\nThe only problem is that for some reason the first tile you click is not random.","closed_by":{"login":"Repiteo","id":17489292,"node_id":"MDQ6VXNlcjE3NDg5Mjky","avatar_url":"https://avatars.githubusercontent.com/u/17489292?v=4","gravatar_id":"","url":"https://api.github.com/users/Repiteo","html_url":"https://github.com/Repiteo","followers_url":"https://api.github.com/users/Repiteo/followers","following_url":"https://api.github.com/users/Repiteo/following{/other_user}","gists_url":"https://api.github.com/users/Repiteo/gists{/gist_id}","starred_url":"https://api.github.com/users/Repiteo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Repiteo/subscriptions","organizations_url":"https://api.github.com/users/Repiteo/orgs","repos_url":"https://api.github.com/users/Repiteo/repos","events_url":"https://api.github.com/users/Repiteo/events{/privacy}","received_events_url":"https://api.github.com/users/Repiteo/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/118315/reactions","total_count":10,"+1":0,"-1":0,"laugh":4,"hooray":6,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/godotengine/godot/issues/118315/timeline","performed_via_github_app":null,"state_reason":null}