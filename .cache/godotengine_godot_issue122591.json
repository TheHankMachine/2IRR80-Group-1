ional information and explanation of your PR, including areas that you are uncertain of or require special attention from reviewers. For examples, please read our pull request guidelines: https://contributing.godotengine.org/en/latest/pull_requests/pull_request_guidelines.html#explain-your-contributions\r\n-->\r\n","closed_by":{"login":"Prawnya","id":170275512,"node_id":"U_kgDOCiYyuA","avatar_url":"https://avatars.githubusercontent.com/u/170275512?v=4","gravatar_id":"","url":"https://api.github.com/users/Prawnya","html_url":"https://github.com/Prawnya","followers_url":"https://api.github.com/users/Prawnya/followers","following_url":"https://api.github.com/users/Prawnya/following{/other_user}","gists_url":"https://api.github.com/users/Prawnya/gists{/gist_id}","starred_url":"https://api.github.com/users/Prawnya/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Prawnya/subscriptions","organizations_url":"https://api.github.com/users/Prawnya/orgs","repos_url":"https://api.github.com/users/Prawnya/repos","events_url":"https://api.github.com/users/Prawnya/events{/privacy}","received_events_url":"https://api.github.com/users/Prawnya/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/122591/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/godotengine/godot/issues/122591/timeline","performed_via_github_app":null,"state_reason":null}