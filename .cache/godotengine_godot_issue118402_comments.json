[{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4710078342","html_url":"https://github.com/godotengine/godot/issues/118402#issuecomment-4710078342","issue_url":"https://api.github.com/repos/godotengine/godot/issues/118402","id":4710078342,"node_id":"IC_kwDOAO6SJc8AAAABGL4Xhg","user":{"login":"hypotensor","id":184009339,"node_id":"U_kgDOCvfCew","avatar_url":"https://avatars.githubusercontent.com/u/184009339?v=4","gravatar_id":"","url":"https://api.github.com/users/hypotensor","html_url":"https://github.com/hypotensor","followers_url":"https://api.github.com/users/hypotensor/followers","following_url":"https://api.github.com/users/hypotensor/following{/other_user}","gists_url":"https://api.github.com/users/hypotensor/gists{/gist_id}","starred_url":"https://api.github.com/users/hypotensor/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/hypotensor/subscriptions","organizations_url":"https://api.github.com/users/hypotensor/orgs","repos_url":"https://api.github.com/users/hypotensor/repos","events_url":"https://api.github.com/users/hypotensor/events{/privacy}","received_events_url":"https://api.github.com/users/hypotensor/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-06-15T16:31:03Z","updated_at":"2026-06-15T16:31:03Z","body":"The project you uploaded appears to be your actual game project folder, not a minimum reproduction project. Even still, I suspect the issue here is a combination of not enabling physics interpolation in the project settings and ghosting issues with your monitor.","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4710078342/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4712659061","html_url":"https://github.com/godotengine/godot/issues/118402#issuecomment-4712659061","issue_url":"https://api.github.com/repos/godotengine/godot/issues/118402","id":4712659061,"node_id":"IC_kwDOAO6SJc8AAAABGOV4dQ","user":{"login":"Calinou","id":180032,"node_id":"MDQ6VXNlcjE4MDAzMg==","avatar_url":"https://avatars.githubusercontent.com/u/180032?v=4","gravatar_id":"","url":"https://api.github.com/users/Calinou","html_url":"https://github.com/Calinou","followers_url":"https://api.github.com/users/Calinou/followers","following_url":"https://api.github.com/users/Calinou/following{/other_user}","gists_url":"https://api.github.com/users/Calinou/gists{/gist_id}","starred_url":"https://api.github.com/users/Calinou/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Calinou/subscriptions","organizations_url":"https://api.github.com/users/Calinou/orgs","repos_url":"https://api.github.com/users/Calinou/repos","events_url":"https://api.github.com/users/Calinou/events{/privacy}","received_events_url":"https://api.github.com/users/Calinou/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-06-15T21:37:28Z","updated_at":"2026-06-15T21:37:47Z","body":"Closing, as this is not an issue with the engine. Try these steps in order:\n\n1. Ensure the monitor runs at its highest possible refresh rate in the OS display settings, and that there is no FPS cap imposed on the game (in the Project Settings or externally).\n2. Check motion clarity on the [TestUFO](https://testufo.com/) website. Follow the moving UFO on the top row with the eyes, and look at how clear it is compared to its paused state. If the test motion appears blurry even at low speeds like 480 pixels/second, then there isn't much you can do on your particular monitor. That said, enabling physics interpolation will improve the experience for players on monitors with a higher refresh rate.\n3. Follow the [physics interpolation quick start guide](https://docs.godotengine.org/en/stable/tutorials/physics/interpolation/physics_interpolation_quick_start_guide.html) to enable physics interpolation in the project.","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4712659061/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null}]