so for every language that doesn't match a translation it will add the lang_hint. In my case with English and Japanese as languages it duplicated the choice list twice, but it would duplicate it more times if I had more langues it couldn't find.\r\n","closed_by":{"login":"sarcengm","id":4984388,"node_id":"MDQ6VXNlcjQ5ODQzODg=","avatar_url":"https://avatars.githubusercontent.com/u/4984388?v=4","gravatar_id":"","url":"https://api.github.com/users/sarcengm","html_url":"https://github.com/sarcengm","followers_url":"https://api.github.com/users/sarcengm/followers","following_url":"https://api.github.com/users/sarcengm/following{/other_user}","gists_url":"https://api.github.com/users/sarcengm/gists{/gist_id}","starred_url":"https://api.github.com/users/sarcengm/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/sarcengm/subscriptions","organizations_url":"https://api.github.com/users/sarcengm/orgs","repos_url":"https://api.github.com/users/sarcengm/repos","events_url":"https://api.github.com/users/sarcengm/events{/privacy}","received_events_url":"https://api.github.com/users/sarcengm/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/120575/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/godotengine/godot/issues/120575/timeline","performed_via_github_app":null,"state_reason":null}