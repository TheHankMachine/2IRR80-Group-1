introduces a partial fix for #98358 by adding cleanup logic in `ENetPacketPeer::_on_disconnect()` to manually destroy any unprocessed ENetPacket objects stored in `packet_queue` and `last_packet`.\r\n\r\nA new `free_packet()` helper is added, which:\r\n\r\n- destroys all packets in `packet_queue`,\r\n- destroys `last_packet` if present,\r\n- resets internal state.\r\n\r\nThis does not fully resolve all aspects of #98358, but it provides a clear and explicit manual memory release path for `ENetPacketPeer` and addresses one known source of memory retention when peers disconnect (especially abruptly).\r\n","labels":[{"id":73330064,"node_id":"MDU6TGFiZWw3MzMzMDA2NA==","url":"https://api.github.com/repos/godotengine/godot/labels/bug","name":"bug","description":"","color":"ff6055","default":true,"archived_at":null,"archived_by":null},{"id":279096997,"node_id":"MDU6TGFiZWwyNzkwOTY5OTc=","url":"https://api.github.com/repos/godotengine/godot/labels/archived","name":"archived","description":"","color":"aaaaaa","default":false,"archived_at":null,"archived_by":null},{"id":649800701,"node_id":"MDU6TGFiZWw2NDk4MDA3MDE=","url":"https://api.github.com/repos/godotengine/godot/labels/topic:network","name":"topic:network","description":"","color":"ffee88","default":false,"archived_at":null,"archived_by":null}],"milestone":null,"active_lock_reason":null,"created_at":"2025-12-09T11:59:11Z","updated_at":"2026-01-10T18:11:43Z","closed_at":"2026-01-10T17:40:38Z","merged_at":null,"merge_commit_sha":"cd0a53fb5ee8c6e7481e7530cbf929ceb3f75893","assignee":null,"assignees":[],"requested_reviewers":[],"requested_teams":[],"head":{"label":"SonicSegFault:fix-enetpacketpeer-disconnect-leak","ref":"fix-enetpacketpeer-disconnect-leak","repo":{"id":1100287460,"node_id":"R_kgDOQZUN5A","name":"godot","full_name":"SonicSegFault/godot","owner":{"login":"SonicSegFault","id":81888555,"node_id":"MDQ6VXNlcjgxODg4NTU1","avatar_url":"https://avatars.githubusercontent.com/u/81888555?v=4","gravatar_id":"","url":"h