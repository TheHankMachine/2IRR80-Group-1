[{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2726892267","html_url":"https://github.com/godotengine/godot/issues/104185#issuecomment-2726892267","issue_url":"https://api.github.com/repos/godotengine/godot/issues/104185","id":2726892267,"node_id":"IC_kwDOAO6SJc6iiRLr","user":{"login":"Calinou","id":180032,"node_id":"MDQ6VXNlcjE4MDAzMg==","avatar_url":"https://avatars.githubusercontent.com/u/180032?v=4","gravatar_id":"","url":"https://api.github.com/users/Calinou","html_url":"https://github.com/Calinou","followers_url":"https://api.github.com/users/Calinou/followers","following_url":"https://api.github.com/users/Calinou/following{/other_user}","gists_url":"https://api.github.com/users/Calinou/gists{/gist_id}","starred_url":"https://api.github.com/users/Calinou/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Calinou/subscriptions","organizations_url":"https://api.github.com/users/Calinou/orgs","repos_url":"https://api.github.com/users/Calinou/repos","events_url":"https://api.github.com/users/Calinou/events{/privacy}","received_events_url":"https://api.github.com/users/Calinou/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-03-15T18:00:40Z","updated_at":"2025-03-15T18:00:40Z","body":"This is not a bug. When you resize the grid texture on screen to be smaller, it has to be resampled somehow. If you use linear filtering, it will look blurry. If you use nearest-neighbor filtering, it will be missing some pixels. Here, the missing pixels are the grid pixels, which makes it look like the grid is missing some lines.\n\nYou can avoid this by enforcing [integer scaling](https://docs.godotengine.org/en/stable/tutorials/rendering/multiple_resolutions.html#stretch-scale-mode) in the project settings, or using a grid texture with thicker lines as a workaround.","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2726892267/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null}]