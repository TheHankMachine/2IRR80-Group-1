":"https://api.github.com/users/YeldhamDev/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/YeldhamDev/subscriptions","organizations_url":"https://api.github.com/users/YeldhamDev/orgs","repos_url":"https://api.github.com/users/YeldhamDev/repos","events_url":"https://api.github.com/users/YeldhamDev/events{/privacy}","received_events_url":"https://api.github.com/users/YeldhamDev/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-03-16T00:45:07Z","updated_at":"2026-03-16T00:45:07Z","body":"The `Geometry3D` thing appears to be the same issue that I pointed out in https://github.com/godotengine/godot/issues/115232#issuecomment-3801561272: the system to disable classes disables stuff in unrelated files. I will open a PR to add this class as an exception tomorrow.","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4064351884/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4070191817","html_url":"https://github.com/godotengine/godot/issues/117414#issuecomment-4070191817","issue_url":"https://api.github.com/repos/godotengine/godot/issues/117414","id":4070191817,"node_id":"IC_kwDOAO6SJc7ymjLJ","user":{"login":"anderlli0053","id":22171451,"node_id":"MDQ6VXNlcjIyMTcxNDUx","avatar_url":"https://avatars.githubusercontent.com/u/22171451?v=4","gravatar_id":"","url":"https://api.github.com/users/anderlli0053","html_url":"https://github.com/anderlli0053","followers_url":"https://api.github.com/users/anderlli0053/followers","following_url":"https://api.github.com/users/anderlli0053/following{/other_user}","gists_url":"https://api.github.com/users/anderlli0053/gists{/gist_id}","starred_url":"https://api.github.com/users/anderlli0053/starred{/owner}{/repo}","subscriptio