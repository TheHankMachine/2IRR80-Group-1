com/u/7645683?v=4","gravatar_id":"","url":"https://api.github.com/users/bruvzg","html_url":"https://github.com/bruvzg","followers_url":"https://api.github.com/users/bruvzg/followers","following_url":"https://api.github.com/users/bruvzg/following{/other_user}","gists_url":"https://api.github.com/users/bruvzg/gists{/gist_id}","starred_url":"https://api.github.com/users/bruvzg/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/bruvzg/subscriptions","organizations_url":"https://api.github.com/users/bruvzg/orgs","repos_url":"https://api.github.com/users/bruvzg/repos","events_url":"https://api.github.com/users/bruvzg/events{/privacy}","received_events_url":"https://api.github.com/users/bruvzg/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-01-21T10:09:05Z","updated_at":"2025-01-21T10:09:05Z","body":"4.4 is in a feature freeze after beta1, so only bug fixes are merged until 4.4 stable is released.","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2604249705/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2604639552","html_url":"https://github.com/godotengine/godot/pull/101704#issuecomment-2604639552","issue_url":"https://api.github.com/repos/godotengine/godot/issues/101704","id":2604639552,"node_id":"IC_kwDOAO6SJc6bP6VA","user":{"login":"Neutrino-Sunset","id":18445931,"node_id":"MDQ6VXNlcjE4NDQ1OTMx","avatar_url":"https://avatars.githubusercontent.com/u/18445931?v=4","gravatar_id":"","url":"https://api.github.com/users/Neutrino-Sunset","html_url":"https://github.com/Neutrino-Sunset","followers_url":"https://api.github.com/users/Neutrino-Sunset/followers","following_url":"https://api.github.com/users/Neutrino-Sunset/following{/other_user}","gists_url":"https://api.github.com/users/Neutrino-Sunset/gists{/gist_id}","starred_url":"https://api.github.com/users/Neutrino-Sunset/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Neutrino-Sunset/subscriptions","organizations_url":"https://api.github.com/users/Neutrino-Sunset/orgs","repos_url":"https://api.github.com/users/Neutrino-Sunset/repos","events_url":"https://api.github.com/users/Neutrino-Sunset/events{/privacy}","received_events_url":"https://api.github.com/users/Neutrino-Sunset/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-01-21T12:45:55Z","updated_at":"2025-01-21T12:45:55Z","body":"Ok. But if 4.4 is frozen then surely that's already in its own release branch isn't it? Can't PRs be merged into main (or whatever your dev branch is called)?\r\n\r\nKeeping all incoming changes in open unmerged PRs for months is just going to create conflicts and integration hell when you finally start integrating them.","author_association":"NONE","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2604639552/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2615988327","html_url":"https://github.com/godotengine/godot/pull/101704#issuecomment-2615988327","issue_url":"https://api.github.com/repos/godotengine/godot/issues/101704","id":2615988327,"node_id":"IC_kwDOAO6SJc6b7NBn","user":{"login":"Calinou","id":180032,"node_id":"MDQ6VXNlcjE4MDAzMg==","avatar_url":"https://avatars.githubusercontent.com/u/180032?v=4","gravatar_id":"","url":"https://api.github.com/users/Calinou","html_url":"https://github.com/Calinou","followers_url":"https://api.github.com/users/Calinou/followers","following_url":"https://api.github.com/users/Calinou/following{/other_user}","gists_url":"https://api.github.com/users/Calinou/gists{/gist_id}","starred_url":"https://api.github.com/users/Calinou/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Calinou/subscriptions","organizations_url":"https://api.github.com/users/Calinou/orgs","repos_url":"https://api.github.com/users/Calinou/repos","events_url":"https://api.github.com/users/Calinou/events{/privacy}","received_events_url":"https://api.github.com/users/Calinou/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-01-27T14:57:45Z","updated_at":"2025-01-27T14:58:10Z","body":"> Ok. But if 4.4 is frozen then surely that's already in its own release branch isn't it? Can't PRs be merged into main (or whatever your dev branch is called)?\r\n\r\n4.4 does not have its Git branch yet, since we only branch out *after* a stable version is released. This is done to ensure all development efforts are focused on `master` when it matters most. `master` represents the latest developments (there is no `develop` branch).","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2615988327/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2616037152","html_url":"https://github.com/godotengine/godot/pull/101704#issuecomment-2616037152","issue_url":"https://api.github.com/repos/godotengine/godot/issues/101704","id":2616037152,"node_id":"IC_kwDOAO6SJc6b7Y8g","user":{"login":"Neutrino-Sunset","id":18445931,"node_id":"MDQ6VXNlcjE4NDQ1OTMx","avatar_url":"https://avatars.githubusercontent.com/u/18445931?v=4","gravatar_id":"","url":"https://api.github.com/users/Neutrino-Sunset","html_url":"https://github.com/Neutrino-Sunset","followers_url":"https://api.github.com/users/Neutrino-Sunset/followers","following_url":"https://api.github.com/users/Neutrino-Sunset/following{/other_user}","gists_url":"https://api.github.com/users/Neutrino-Sunset/gists{/gist_id}","starred_url":"https://api.github.com/users/Neutrino-Sunset/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Neutrino-Sunset/subscriptions","organizations_url":"https://api.github.com/users/Neutrino-Sunset/orgs","repos_url":"https://api.github.com/users/Neutrino-Sunset/repos","events_url":"https://api.github.com/users/Neutrino-Sunset/events{/privacy}","received_events_url":"https://api.github.com/users/Neutrino-Sunset/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-01-27T15:16:02Z","updated_at":"2025-01-27T15:16:02Z","body":"That's a pretty unconventional branching strategy. I don't think many people use that strategy because there are some obvious downsides. If development on non 4.4 features can't be integrated while 4.4 is being prepped, then the whole time 4.4 is being prepped more non 4.4 stuff is getting piled up in PRs with increasing potential for merge conflicts.\r\n\r\nHow long do you expect it to be until 4.4 is released?\r\n\r\nTwo alternative branching strategies.\r\n\r\n1. Create a 4.4 Release Candidate branch. Then either create 4.4 fixes in `4.4RC` and merge to `master`, or develop 4.4 fixes in `master` and cherry pick to `4.4RC`.\r\n\r\n2. Create a temporary dev branch. Continue 4.4 development on `master`, non-4.4 fixes go into `dev-temp`. Once 4.4 goes live merge `dev-temp` into `master`.\r\n\r\nThere's really no need to have a backlog of code piling up in unmerged PRs. That's completely unnecessary.\r\n\r\nhttps://www.endoflineblog.com/oneflow-a-git-branching-model-and-workflow\r\n\r\n\r\n","author_association":"NONE","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2616037152/reactions","total_count":1,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":1,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2616050751","html_url":"https://github.com/godotengine/godot/pull/101704#issuecomment-2616050751","issue_url":"https://api.github.com/repos/godotengine/godot/issues/101704","id":2616050751,"node_id":"IC_kwDOAO6SJc6b7cQ_","user":{"login":"Calinou","id":180032,"node_id":"MDQ6VXNlcjE4MDAzMg==","avatar_url":"https://avatars.githubusercontent.com/u/180032?v=4","gravatar_id":"","url":"https://api.github.com/users/Calinou","html_url":"https://github.com/Calinou","followers_url":"https://api.github.com/users/Calinou/followers","following_url":"https://api.github.com/users/Calinou/following{/other_user}","gists_url":"https://api.github.com/users/Calinou/gists{/gist_id}","starred_url":"https://api.github.com/users/Calinou/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Calinou/subscriptions","organizations_url":"https://api.github.com/users/Calinou/orgs","repos_url":"https://api.github.com/users/Calinou/repos","events_url":"https://api.github.com/users/Calinou/events{/privacy}","received_events_url":"https://api.github.com/users/Calinou/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-01-27T15:21:02Z","updated_at":"2025-01-27T15:21:02Z","body":"This isn't a big PR (only 16 line changes), so rebasing it in the future shouldn't be too difficult either way.\r\n\r\n> How long do you expect it to be until 4.4 is released?\r\n\r\nLikely in 2 months from now.","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2616050751/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2616051419","html_url":"https://github.com/godotengine/godot/pull/101704#issuecomment-2616051419","issue_url":"https://api.github.com/repos/godotengine/godot/issues/101704","id":2616051419,"node_id":"IC_kwDOAO6SJc6b7cbb","user":{"login":"AThousandShips","id":96648715,"node_id":"U_kgDOBcK-Cw","avatar_url":"https://avatars.githubusercontent.com/u/96648715?v=4","gravatar_id":"","url":"https://api.github.com/users/AThousandShips","html_url":"https://github.com/AThousandShips","followers_url":"https://api.github.com/users/AThousandShips/followers","following_url":"https://api.github.com/users/AThousandShips/following{/other_user}","gists_url":"https://api.github.com/users/AThousandShips/gists{/gist_id}","starred_url":"https://api.github.com/users/AThousandShips/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/AThousandShips/subscriptions","organizations_url":"https://api.github.com/users/AThousandShips/orgs","repos_url":"https://api.github.com/users/AThousandShips/repos","events_url":"https://api.github.com/users/AThousandShips/events{/privacy}","received_events_url":"https://api.github.com/users/AThousandShips/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-01-27T15:21:18Z","updated_at":"2025-01-27T15:21:18Z","body":"There's one very obvious downside: having to cherry pick all bug fixes to the other branch\r\n\r\nThat would *increase* the work and need to revise and deal with merge conflicts etc.","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2616051419/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2616120738","html_url":"https://github.com/godotengine/godot/pull/101704#issuecomment-2616120738","issue_url":"https://api.github.com/repos/godotengine/godot/issues/101704","id":2616120738,"node_id":"IC_kwDOAO6SJc6b7tWi","user":{"login":"Neutrino-Sunset","id":18445931,"node_id":"MDQ6VXNlcjE4NDQ1OTMx","avatar_url":"https://avatars.githubusercontent.com/u/18445931?v=4","gravatar_id":"","url":"https://api.github.com/users/Neutrino-Sunset","html_url":"https://github.com/Neutrino-Sunset","followers_url":"https://api.github.com/users/Neutrino-Sunset/followers","following_url":"https://api.github.com/users/Neutrino-Sunset/following{/other_user}","gists_url":"https://api.github.com/users/Neutrino-Sunset/gists{/gist_id}","starred_url":"https://api.github.com/users/Neutrino-Sunset/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Neutrino-Sunset/subscriptions","organizations_url":"https://api.github.com/users/Neutrino-Sunset/orgs","repos_url":"https://api.github.com/users/Neutrino-Sunset/repos","events_url":"https://api.github.com/users/Neutrino-Sunset/events{/privacy}","received_events_url":"https://api.github.com/users/Neutrino-Sunset/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-01-27T15:47:34Z","updated_at":"2025-01-27T15:47:34Z","body":"> There's one very obvious downside: having to cherry pick all bug fixes to the other branch\r\n> \r\n> That would _increase_ the work and need to revise and deal with merge conflicts etc.\r\n\r\nI don't understand your point. Surely cherry picking one bug fix at a time, at a point where there is minimum divergance between branches, will be a lot less work than integrating a load of extremely out of date PRs?","author_association":"NONE","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2616120738/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2616143599","html_url":"https://github.com/godotengine/godot/pull/101704#issuecomment-2616143599","issue_url":"https://api.github.com/repos/godotengine/godot/issues/101704","id":2616143599,"node_id":"IC_kwDOAO6SJc6b7y7v","user":{"login":"AThousandShips","id":96648715,"node_id":"U_kgDOBcK-Cw","avatar_url":"https://avatars.githubusercontent.com/u/96648715?v=4","gravatar_id":"","url":"https://api.github.com/users/AThousandShips","html_url":"https://github.com/AThousandShips","followers_url":"https://api.github.com/users/AThousandShips/followers","following_url":"https://api.github.com/users/AThousandShips/following{/other_user}","gists_url":"https://api.github.com/users/AThousandShips/gists{/gist_id}","starred_url":"https://api.github.com/users/AThousandShips/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/AThousandShips/subscriptions","organizations_url":"https://api.github.com/users/AThousandShips/orgs","repos_url":"https://api.github.com/users/AThousandShips/repos","events_url":"https://api.github.com/users/AThousandShips/events{/privacy}","received_events_url":"https://api.github.com/users/AThousandShips/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-01-27T15:56:04Z","updated_at":"2025-01-27T15:56:04Z","body":"Doing cherry picking is more work than not doing it, no? And it's done by largely a single maintainer, which makes it a lot of work comparatively, the divergence also means there are various potential new issues arising that could interfere with other bugs meaning that cherry picking bugfixes for the 4.4 branch would be harder. It also makes it more critical to cherry-pick bugfixes to the 4.4 branch very critical, so they are cherry-picked in time. Further we'd get fewer people testing the main branch bugfixes during the development phase which makes it harder to test and confirm bugfixes\r\n\r\nThis has been discussed in the past and it just hasn't been compatible with our workflows for a lot of reasons","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2616143599/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2693645560","html_url":"https://github.com/godotengine/godot/pull/101704#issuecomment-2693645560","issue_url":"https://api.github.com/repos/godotengine/godot/issues/101704","id":2693645560,"node_id":"IC_kwDOAO6SJc6gjcT4","user":{"login":"Neutrino-Sunset","id":18445931,"node_id":"MDQ6VXNlcjE4NDQ1OTMx","avatar_url":"https://avatars.githubusercontent.com/u/18445931?v=4","gravatar_id":"","url":"https://api.github.com/users/Neutrino-Sunset","html_url":"https://github.com/Neutrino-Sunset","followers_url":"https://api.github.com/users/Neutrino-Sunset/followers","following_url":"https://api.github.com/users/Neutrino-Sunset/following{/other_user}","gists_url":"https://api.github.com/users/Neutrino-Sunset/gists{/gist_id}","starred_url":"https://api.github.com/users/Neutrino-Sunset/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Neutrino-Sunset/subscriptions","organizations_url":"https://api.github.com/users/Neutrino-Sunset/orgs","repos_url":"https://api.github.com/users/Neutrino-Sunset/repos","events_url":"https://api.github.com/users/Neutrino-Sunset/events{/privacy}","received_events_url":"https://api.github.com/users/Neutrino-Sunset/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-03-03T08:44:43Z","updated_at":"2025-03-03T08:44:43Z","body":"So because this has been sat in an unmerged PR for months this is now conflicted for the second time, so if I want to get this fix applied I now have to deal with this for the third time.\r\n\r\nThe `Resolve conflicts` button takes me to a view where the source is presented using a completely different indentation to what it actually has. Doing anything with that looks like a recipe for disaster.\r\n\r\nThe last time this PR sat here for months I tried resolving the conflicts by pushing a new commit from my fork, but that didn't work because it closed the original PR. The built in Github `Resolve conflicts` tool looks unable to handle the indentation correctly.\r\n\r\nSo what's the recommended way to resolve conflicts in a PR pushed form a fork?","author_association":"NONE","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2693645560/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2694219134","html_url":"https://github.com/godotengine/godot/pull/101704#issuecomment-2694219134","issue_url":"https://api.github.com/repos/godotengine/godot/issues/101704","id":2694219134,"node_id":"IC_kwDOAO6SJc6gloV-","user":{"login":"akien-mga","id":4701338,"node_id":"MDQ6VXNlcjQ3MDEzMzg=","avatar_url":"https://avatars.githubusercontent.com/u/4701338?v=4","gravatar_id":"","url":"https://api.github.com/users/akien-mga","html_url":"https://github.com/akien-mga","followers_url":"https://api.github.com/users/akien-mga/followers","following_url":"https://api.github.com/users/akien-mga/following{/other_user}","gists_url":"https://api.github.com/users/akien-mga/gists{/gist_id}","starred_url":"https://api.github.com/users/akien-mga/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/akien-mga/subscriptions","organizations_url":"https://api.github.com/users/akien-mga/orgs","repos_url":"https://api.github.com/users/akien-mga/repos","events_url":"https://api.github.com/users/akien-mga/events{/privacy}","received_events_url":"https://api.github.com/users/akien-mga/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-03-03T12:32:40Z","updated_at":"2025-03-03T12:32:40Z","body":"Conflicts are best resolved locally by rebasing your PR's branch on the upstream `master` branch.\r\nAssuming your git checkout has `origin` pointing at your fork:\r\n\r\n```\r\ngit checkout master\r\ngit remote add upstream https://github.com/godotengine/godot\r\ngit pull --rebase upstream master\r\n# Edit the conflicted files to resolve the conflicts\r\ngit add --all\r\ngit rebase --continue\r\ngit push --force origin master\r\n```\r\n\r\nSimilar steps can be done via graphical Git clients, including merge/rebase conflict resolution with a graphical diff tool.","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2694219134/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null}]