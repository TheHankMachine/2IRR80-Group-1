w","url":"https://api.github.com/repos/godotengine/godot/labels/performance","name":"performance","color":"447777","default":false,"description":"","archived_at":null,"archived_by":null}],"state":"closed","locked":false,"assignees":[],"milestone":{"url":"https://api.github.com/repos/godotengine/godot/milestones/25","html_url":"https://github.com/godotengine/godot/milestone/25","labels_url":"https://api.github.com/repos/godotengine/godot/milestones/25/labels","id":15520464,"node_id":"MI_kwDOAO6SJc4A7NLQ","number":25,"title":"4.8","description":"","creator":{"login":"Repiteo","id":17489292,"node_id":"MDQ6VXNlcjE3NDg5Mjky","avatar_url":"https://avatars.githubusercontent.com/u/17489292?v=4","gravatar_id":"","url":"https://api.github.com/users/Repiteo","html_url":"https://github.com/Repiteo","followers_url":"https://api.github.com/users/Repiteo/followers","following_url":"https://api.github.com/users/Repiteo/following{/other_user}","gists_url":"https://api.github.com/users/Repiteo/gists{/gist_id}","starred_url":"https://api.github.com/users/Repiteo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Repiteo/subscriptions","organizations_url":"https://api.github.com/users/Repiteo/orgs","repos_url":"https://api.github.com/users/Repiteo/repos","events_url":"https://api.github.com/users/Repiteo/events{/privacy}","received_events_url":"https://api.github.com/users/Repiteo/received_events","type":"User","user_view_type":"public","site_admin":false},"open_issues":343,"closed_issues":2335,"state":"open","created_at":"2026-04-13T15:59:35Z","updated_at":"2026-10-22T06:28:22Z","due_on":null,"closed_at":null},"comments":2,"created_at":"2026-07-16T15:31:34Z","updated_at":"2026-07-28T23:53:56Z","closed_at":"2026-07-28T20:05:18Z","assignee":null,"author_association":"CONTRIBUTOR","issue_field_values":[],"type":null,"active_lock_reason":null,"draft":false,"pull_request":{"url":"https://api.github.com/repos/godotengine/godot/pulls/121459","html_url":"https://github.com/godotengine/godot/pull/121459","diff_url":"https://github.com/godotengine/godot/pull/121459.diff","patch_url":"https://github.com/godotengine/godot/pull/121459.patch","merged_at":"2026-07-28T20:05:18Z"},"body":"## What problem(s) does this PR solve?\r\n\r\n- Closes #121458.\r\n\r\n## Additional information\r\n\r\nThis changes `EditorResourcePreview::_idle_callback` to not use a function-local 100 ms timer to limit its `_iterate` calls, but instead have that timer persist for the entirety of that process frame, meaning it resets when it finds itself at a new process frame.\r\n\r\nThis seems to take care of the problem of it potentially spending this 100 ms time across multiple idle callback invocations in a single engine iteration, which otherwise sort of defeated the purpose of having this explicit time limit to begin with.\r\n\r\nHere's what profiling the web editor on a low-spec Chromebook looks like with this change. The frames are now on the order of 100-ish ms each rather than a second-ish long, with the editor feeling more responsive than before as well:\r\n\r\n<img width=\"1920\" height=\"693\" alt=\"Screenshot 2026-07-16 16 18 30\" src=\"https://github.com/user-attachments/assets/193f8676-be38-4a44-bab8-a8bbf37bef82\" />\r\n<img width=\"1920\" height=\"693\" alt=\"Screenshot 2026-07-16 16 18 47\" src=\"https://github.com/user-attachments/assets/a7508add-554d-4664-95bc-a21bbc4047f6\" />\r\n\r\nI'd say 100 ms per frame still doesn't feel great in terms of responsiveness when the work gets spread over this amount of time, and should maybe be lowered even more, but that's for a separate PR.","closed_by":{"login":"Repiteo","id":17489292,"node_id":"MDQ6VXNlcjE3NDg5Mjky","avatar_url":"https://avatars.githubusercontent.com/u/17489292?v=4","gravatar_id":"","url":"https://api.github.com/users/Repiteo","html_url":"https://github.com/Repiteo","followers_url":"https://api.github.com/users/Repiteo/followers","following_url":"https://api.github.com/users/Repiteo/following{/other_user}","gists_url":"https://api.github.com/users/Repiteo/gists{/gist_id}","starred_url":"https://api.github.com/users/Repiteo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Repiteo/subscriptions","organizations_url":"https://api.github.com/users/Repiteo/orgs","repos_url":"https://api.github.com/users/Repiteo/repos","events_url":"https://api.github.com/users/Repiteo/events{/privacy}","received_events_url":"https://api.github.com/users/Repiteo/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/121459/reactions","total_count":3,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":2,"eyes":0},"timeline_url":"https://api.github.com/repos/godotengine/godot/issues/121459/timeline","performed_via_github_app":null,"state_reason":null}