jcx","url":"https://api.github.com/repos/godotengine/godot/labels/crash","name":"crash","color":"885544","default":false,"description":"","archived_at":null,"archived_by":null}],"state":"closed","locked":false,"assignees":[],"milestone":{"url":"https://api.github.com/repos/godotengine/godot/milestones/22","html_url":"https://github.com/godotengine/godot/milestone/22","labels_url":"https://api.github.com/repos/godotengine/godot/milestones/22/labels","id":12070367,"node_id":"MI_kwDOAO6SJc4AuC3f","number":22,"title":"4.5","description":"","creator":{"login":"Sauermann","id":6299227,"node_id":"MDQ6VXNlcjYyOTkyMjc=","avatar_url":"https://avatars.githubusercontent.com/u/6299227?v=4","gravatar_id":"","url":"https://api.github.com/users/Sauermann","html_url":"https://github.com/Sauermann","followers_url":"https://api.github.com/users/Sauermann/followers","following_url":"https://api.github.com/users/Sauermann/following{/other_user}","gists_url":"https://api.github.com/users/Sauermann/gists{/gist_id}","starred_url":"https://api.github.com/users/Sauermann/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Sauermann/subscriptions","organizations_url":"https://api.github.com/users/Sauermann/orgs","repos_url":"https://api.github.com/users/Sauermann/repos","events_url":"https://api.github.com/users/Sauermann/events{/privacy}","received_events_url":"https://api.github.com/users/Sauermann/received_events","type":"User","user_view_type":"public","site_admin":false},"open_issues":3,"closed_issues":3687,"state":"closed","created_at":"2024-12-19T08:51:28Z","updated_at":"2026-09-04T21:48:38Z","due_on":"2025-09-15T00:00:00Z","closed_at":"2025-09-18T17:13:14Z"},"comments":1,"created_at":"2025-06-02T18:19:58Z","updated_at":"2025-06-04T07:38:43Z","closed_at":"2025-06-03T20:47:02Z","assignee":null,"author_association":"CONTRIBUTOR","issue_field_values":[],"type":null,"active_lock_reason":null,"draft":false,"pull_request":{"url":"https://api.github.com/repos/godotengine/godot/pulls/107058","html_url":"https://github.com/godotengine/godot/pull/107058","diff_url":"https://github.com/godotengine/godot/pull/107058.diff","patch_url":"https://github.com/godotengine/godot/pull/107058.patch","merged_at":"2025-06-03T20:47:02Z"},"body":"Fixes #107056.\r\n\r\nThis PR addresses a couple of things:\r\n\r\n1. `ScriptServer::capture_script_backtraces` was not locking `languages_mutex` as it probably should have, and in general was calling `ScriptServer` methods through its static interface when it could just have accessed the state directly instead.\r\n2. `ScriptServer::capture_script_backtraces` should rightfully have been checking `ScriptServer::languages_ready` as part of its implementation rather than relying on the caller to call `ScriptServer::are_languages_initialized`, since it doesn't really make much sense to do anything without them being ready anyway, and having the caller do it technically opens you up to a potential race condition.\r\n3. Adds the quick hack for the likely static destruction problem mentioned in [#107056](https://github.com/godotengine/godot/issues/107056).\r\n\r\nThat last one is very much a hack, and should ideally be fixed properly in short order. However, as mentioned in #107056, it would seem to me that the best way to do so is to convert `ScriptServer` into a proper singleton with a well-defined lifetime instead, which strikes me as a somewhat pervasive/scary change to rush in at the last minute like this.","closed_by":{"login":"Repiteo","id":17489292,"node_id":"MDQ6VXNlcjE3NDg5Mjky","avatar_url":"https://avatars.githubusercontent.com/u/17489292?v=4","gravatar_id":"","url":"https://api.github.com/users/Repiteo","html_url":"https://github.com/Repiteo","followers_url":"https://api.github.com/users/Repiteo/followers","following_url":"https://api.github.com/users/Repiteo/following{/other_user}","gists_url":"https://api.github.com/users/Repiteo/gists{/gist_id}","starred_url":"https://api.github.com/users/Repiteo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Repiteo/subscriptions","organizations_url":"https://api.github.com/users/Repiteo/orgs","repos_url":"https://api.github.com/users/Repiteo/repos","events_url":"https://api.github.com/users/Repiteo/events{/privacy}","received_events_url":"https://api.github.com/users/Repiteo/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/107058/reactions","total_count":1,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":1,"eyes":0},"timeline_url":"https://api.github.com/repos/godotengine/godot/issues/107058/timeline","performed_via_github_app":null,"state_reason":null}