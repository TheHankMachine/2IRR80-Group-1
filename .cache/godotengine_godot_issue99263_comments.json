kgDOBuEz0A","avatar_url":"https://avatars.githubusercontent.com/u/115422160?v=4","gravatar_id":"","url":"https://api.github.com/users/Lippanon","html_url":"https://github.com/Lippanon","followers_url":"https://api.github.com/users/Lippanon/followers","following_url":"https://api.github.com/users/Lippanon/following{/other_user}","gists_url":"https://api.github.com/users/Lippanon/gists{/gist_id}","starred_url":"https://api.github.com/users/Lippanon/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Lippanon/subscriptions","organizations_url":"https://api.github.com/users/Lippanon/orgs","repos_url":"https://api.github.com/users/Lippanon/repos","events_url":"https://api.github.com/users/Lippanon/events{/privacy}","received_events_url":"https://api.github.com/users/Lippanon/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2024-11-26T21:40:16Z","updated_at":"2024-11-26T21:40:16Z","body":"> Is this issue new in dev5?\n\nNo. I'm seeing it too in v4.4.dev.custom_build [c6c464cf9].","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2501985522/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2524601034","html_url":"https://github.com/godotengine/godot/issues/99263#issuecomment-2524601034","issue_url":"https://api.github.com/repos/godotengine/godot/issues/99263","id":2524601034,"node_id":"IC_kwDOAO6SJc6WelrK","user":{"login":"clayjohn","id":16521339,"node_id":"MDQ6VXNlcjE2NTIxMzM5","avatar_url":"https://avatars.githubusercontent.com/u/16521339?v=4","gravatar_id":"","url":"https://api.github.com/users/clayjohn","html_url":"https://github.com/clayjohn","followers_url":"https://api.github.com/users/clayjohn/followers","following_url":"https://api.github.com/users/clayjohn/following{/other_user}","gists_url":"https://api.github.com/users/clayjohn/gists{/gist_id}","starred_url":"https://api.github.com/users/clayjohn/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/clayjohn/subscriptions","organizations_url":"https://api.github.com/users/clayjohn/orgs","repos_url":"https://api.github.com/users/clayjohn/repos","events_url":"https://api.github.com/users/clayjohn/events{/privacy}","received_events_url":"https://api.github.com/users/clayjohn/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2024-12-06T23:19:12Z","updated_at":"2024-12-06T23:19:12Z","body":"This is a regression from https://github.com/godotengine/godot/pull/90400\n\nPreviously the `ShaderData` class would set its member `valid` to false when about to compile and then set it to `true` if compilation was successful (both shader compilation and setting up pipelines).\n\nThen, when setting up geometry for drawing we checked if the `shader_data` of a material was valid, if not, we could fall back to the default material. \n\nNow instead of checking if `!shader_data->valid`, we do this: \n\nhttps://github.com/godotengine/godot/blob/aa8d9b83f66488dbb2c9c918e9016ef80f821fb4/servers/rendering/renderer_rd/forward_clustered/render_forward_clustered.cpp#L3984-L3986\n\nhttps://github.com/godotengine/godot/blob/aa8d9b83f66488dbb2c9c918e9016ef80f821fb4/servers/rendering/renderer_rd/forward_clustered/scene_shader_forward_clustered.cpp#L435-L443\n\nWhich returns true after the first time a shader compilers successfully. I have a fix incoming","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2524601034/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null}]