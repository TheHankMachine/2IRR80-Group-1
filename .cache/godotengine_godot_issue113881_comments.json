:17:56Z","updated_at":"2025-12-12T12:17:56Z","body":"There:\n* https://github.com/godotengine/godot/pull/113928","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3646257309/reactions","total_count":2,"+1":1,"-1":0,"laugh":0,"hooray":1,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null}]