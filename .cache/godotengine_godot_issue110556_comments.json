api.github.com/users/hhyyrylainen/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/hhyyrylainen/subscriptions","organizations_url":"https://api.github.com/users/hhyyrylainen/orgs","repos_url":"https://api.github.com/users/hhyyrylainen/repos","events_url":"https://api.github.com/users/hhyyrylainen/events{/privacy}","received_events_url":"https://api.github.com/users/hhyyrylainen/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-11-10T17:58:49Z","updated_at":"2025-11-10T17:58:49Z","body":"After updating  from 4.5 to 4.5.1 I started seeing a bunch of errors like this:\r\n\r\n```\r\n  ERROR: Unicode parsing error, some characters were replaced with � (U+FFFD): Unexpected NUL character\r\n  ERROR: Unicode parsing error, some characters were replaced with � (U+FFFD): Unexpected NUL character\r\n  ERROR: Unicode parsing error, some characters were replaced with � (U+FFFD): Unexpected NUL character\r\n  ERROR: Unicode parsing error, some characters were replaced with � (U+FFFD): Unexpected NUL character\r\n  ERROR: Unicode parsing error, some characters were replaced with � (U+FFFD): Unexpected NUL character\r\n```\r\n\r\nIs this change related? I ask because I can't see anything else in the release notes that might be relevant.","author_association":"NONE","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3513201983/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3513228838","html_url":"https://github.com/godotengine/godot/pull/110556#issuecomment-3513228838","issue_url":"https://api.github.com/repos/godotengine/godot/issues/110556","id":3513228838,"node_id":"IC_kwDOAO6SJc7RZ54m","user":{"login":"Ivorforce","id":2308167,"node_id":"MDQ6VXNlcjIzMDgxNjc=","avatar_url":"https://avatars.githubusercontent.com/u/2308167?v=4","gravatar_id":"","url":"https://api.github.com/users/Ivorforce","html_url":"https://github.com/Ivorforce","followers_url":"https://api.github.com/users/Ivorforce/followers","following_url":"https://api.github.com/users/Ivorforce/following{/other_user}","gists_url":"https://api.github.com/users/Ivorforce/gists{/gist_id}","starred_url":"https://api.github.com/users/Ivorforce/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Ivorforce/subscriptions","organizations_url":"https://api.github.com/users/Ivorforce/orgs","repos_url":"https://api.github.com/users/Ivorforce/repos","events_url":"https://api.github.com/users/Ivorforce/events{/privacy}","received_events_url":"https://api.github.com/users/Ivorforce/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-11-10T18:06:19Z","updated_at":"2025-11-10T18:06:49Z","body":"Yes, that's this check triggering. Can you pinpoint when the error messages are printed? What's causing it?","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3513228838/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3513241940","html_url":"https://github.com/godotengine/godot/pull/110556#issuecomment-3513241940","issue_url":"https://api.github.com/repos/godotengine/godot/issues/110556","id":3513241940,"node_id":"IC_kwDOAO6SJc7RZ9FU","user":{"login":"hhyyrylainen","id":3796411,"node_id":"MDQ6VXNlcjM3OTY0MTE=","avatar_url":"https://avatars.githubusercontent.com/u/3796411?v=4","gravatar_id":"","url":"https://api.github.com/users/hhyyrylainen","html_url":"https://github.com/hhyyrylainen","followers_url":"https://api.github.com/users/hhyyrylainen/followers","following_url":"https://api.github.com/users/hhyyrylainen/following{/other_user}","gists_url":"https://api.github.com/users/hhyyrylainen/gists{/gist_id}","starred_url":"https://api.github.com/users/hhyyrylainen/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/hhyyrylainen/subscriptions","organizations_url":"https://api.github.com/users/hhyyrylainen/orgs","repos_url":"https://api.github.com/users/hhyyrylainen/repos","events_url":"https://api.github.com/users/hhyyrylainen/events{/privacy}","received_events_url":"https://api.github.com/users/hhyyrylainen/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-11-10T18:10:08Z","updated_at":"2025-11-10T18:12:56Z","body":"As far as I can tell, there's no error callstack associated with the print, so I cannot easily tell where it is coming from. However, after a bit more searching I discovered this: https://github.com/godotengine/godot/issues/111792\r\n\r\nAnd in our game we do have quite extensive key handling and those error prints begin after another print related to our custom key rebinding system doing its thing. So it may be triggered by trying to convert keycodes and apply input settings. Though we don't have an absolute ton of startup logging, so it could also be triggered later.\r\n\r\nEdit: I should have looked a tiny bit further, as going to our keybinding menu sure enough I see where the character replacements happened:\r\n\r\n<img width=\"488\" height=\"415\" alt=\"kuva\" src=\"https://github.com/user-attachments/assets/bed3f052-124a-4e50-bb8c-e71831233515\" />\r\n\r\n\r\nEdit 2: for reference here is how it looks with Godot 4.5:\r\n\r\n<img width=\"319\" height=\"413\" alt=\"kuva\" src=\"https://github.com/user-attachments/assets/873d58dc-eb1e-40a0-9d73-b9b66a92858c\" />\r\n\r\n(those ö, and å letters do show up in 4.5.1 but I cropped the screenshot differently as I was doing it quickly)","author_association":"NONE","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3513241940/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3516954700","html_url":"https://github.com/godotengine/godot/pull/110556#issuecomment-3516954700","issue_url":"https://api.github.com/repos/godotengine/godot/issues/110556","id":3516954700,"node_id":"IC_kwDOAO6SJc7RoHhM","user":{"login":"Ivorforce","id":2308167,"node_id":"MDQ6VXNlcjIzMDgxNjc=","avatar_url":"https://avatars.githubusercontent.com/u/2308167?v=4","gravatar_id":"","url":"https://api.github.com/users/Ivorforce","html_url":"https://github.com/Ivorforce","followers_url":"https://api.github.com/users/Ivorforce/followers","following_url":"https://api.github.com/users/Ivorforce/following{/other_user}","gists_url":"https://api.github.com/users/Ivorforce/gists{/gist_id}","starred_url":"https://api.github.com/users/Ivorforce/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Ivorforce/subscriptions","organizations_url":"https://api.github.com/users/Ivorforce/orgs","repos_url":"https://api.github.com/users/Ivorforce/repos","events_url":"https://api.github.com/users/Ivorforce/events{/privacy}","received_events_url":"https://api.github.com/users/Ivorforce/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-11-11T13:32:56Z","updated_at":"2025-11-11T13:33:29Z","body":"> As far as I can tell, there's no error callstack associated with the print, so I cannot easily tell where it is coming from. However, after a bit more searching I discovered this: #111792\r\n> \r\n> And in our game we do have quite extensive key handling and those error prints begin after another print related to our custom key rebinding system doing its thing. So it may be triggered by trying to convert keycodes and apply input settings. Though we don't have an absolute ton of startup logging, so it could also be triggered later.\r\n> \r\n> Edit: I should have looked a tiny bit further, as going to our keybinding menu sure enough I see where the character replacements happened:\r\n> \r\n> <img alt=\"kuva\" width=\"488\" height=\"415\" src=\"https://private-user-images.githubusercontent.com/3796411/512317424-bed3f052-124a-4e50-bb8c-e71831233515.png?jwt=eyJ0eXAiOiJKV1QiLCJhbGciOiJIUzI1NiJ9..3Pn7tJBk92agpbJHdCmjBVmNN1nVxIEYegDW-vqykhY\">\r\n> Edit 2: for reference here is how it looks with Godot 4.5:\r\n> \r\n> <img alt=\"kuva\" width=\"319\" height=\"413\" src=\"https://private-user-images.githubusercontent.com/3796411/512317809-873d58dc-eb1e-40a0-9d73-b9b66a92858c.png?jwt=eyJ0eXAiOiJKV1QiLCJhbGciOiJIUzI1NiJ9..s0u4I0PW0fhDn67PeOeGvx_Y1au-gadrD2ufx0gECEo\">\r\n> (those ö, and å letters do show up in 4.5.1 but I cropped the screenshot differently as I was doing it quickly)\r\n\r\nYea, that would be the kind of bug introduced by these changes I made to string parsing. I'm very sorry about that!\r\n\r\nIn your custom key handling code, do you happen to call `String::chr` with keycodes? Keycodes being converted through `String::chr` has been the primary cause of this error message being printed in Godot's own codebase (hopefully, all fixed in 4.5.1?).\r\n`String::chr` used to (in 4.4) silently return an empty string. In 4.5, it returned a string with the `\\0` character in it, which was unintended, because it can cause all kinds of string handling bugs. In 4.5.1, it errors and returns a string with the replacement character instead. ","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3516954700/reactions","total_count":1,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":1,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3517163521","html_url":"https://github.com/godotengine/godot/pull/110556#issuecomment-3517163521","issue_url":"https://api.github.com/repos/godotengine/godot/issues/110556","id":3517163521,"node_id":"IC_kwDOAO6SJc7Ro6gB","user":{"login":"hhyyrylainen","id":3796411,"node_id":"MDQ6VXNlcjM3OTY0MTE=","avatar_url":"https://avatars.githubusercontent.com/u/3796411?v=4","gravatar_id":"","url":"https://api.github.com/users/hhyyrylainen","html_url":"https://github.com/hhyyrylainen","followers_url":"https://api.github.com/users/hhyyrylainen/followers","following_url":"https://api.github.com/users/hhyyrylainen/following{/other_user}","gists_url":"https://api.github.com/users/hhyyrylainen/gists{/gist_id}","starred_url":"https://api.github.com/users/hhyyrylainen/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/hhyyrylainen/subscriptions","organizations_url":"https://api.github.com/users/hhyyrylainen/orgs","repos_url":"https://api.github.com/users/hhyyrylainen/repos","events_url":"https://api.github.com/users/hhyyrylainen/events{/privacy}","received_events_url":"https://api.github.com/users/hhyyrylainen/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-11-11T14:24:42Z","updated_at":"2025-11-11T14:26:39Z","body":"I did a bit of debugging and I do not think our code calls keycode to character conversion (like I initially thought). However, I found out from where the incorrect text was coming from.\r\n\r\nIt looks like `DisplayServer.KeyboardGetLabelFromPhysical` does not work correctly in 4.5.1\r\n\r\nIn 4.5 if I run the following code:\r\n\r\n```c#\r\nDisplayServer.KeyboardGetLabelFromPhysical(Key.Left)\r\n```\r\n\r\nThe result is `Key.Left` as expected.\r\n\r\nBut in 4.5.1 I get the result from the same line of code that it is: `65533` which is not a valid value in the Key enum. So somehow that call to the engine is scrambling up the key codes.\r\n\r\nI put this code in my game's startup and it makes it quit in 4.5.1 whereas 4.5 works normally:\r\n\r\n```c#\r\n        if (DisplayServer.KeyboardGetLabelFromPhysical(Key.Left) != Key.Left)\r\n        {\r\n            GD.PrintErr(\"Key code changed!\");\r\n            GetTree().Quit();\r\n            return;\r\n        }\r\n```\r\n\r\nThat code in 4.5.1 also triggers the print I saw:\r\n```\r\nUnicode parsing error, some characters were replaced with � (U+FFFD): Unexpected NUL character\r\n```\r\n\r\nSo I think that is the thing our game does that triggers the error print from the engine as well.\r\n\r\nShould I open a new issue for this?\r\n\r\nEdit: I checked the documentation just in case but it doesn't seem like the return value of the function should have changed: https://docs.godotengine.org/en/stable/classes/class_displayserver.html#class-displayserver-method-keyboard-get-label-from-physical","author_association":"NONE","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3517163521/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3517203685","html_url":"https://github.com/godotengine/godot/pull/110556#issuecomment-3517203685","issue_url":"https://api.github.com/repos/godotengine/godot/issues/110556","id":3517203685,"node_id":"IC_kwDOAO6SJc7RpETl","user":{"login":"Ivorforce","id":2308167,"node_id":"MDQ6VXNlcjIzMDgxNjc=","avatar_url":"https://avatars.githubusercontent.com/u/2308167?v=4","gravatar_id":"","url":"https://api.github.com/users/Ivorforce","html_url":"https://github.com/Ivorforce","followers_url":"https://api.github.com/users/Ivorforce/followers","following_url":"https://api.github.com/users/Ivorforce/following{/other_user}","gists_url":"https://api.github.com/users/Ivorforce/gists{/gist_id}","starred_url":"https://api.github.com/users/Ivorforce/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Ivorforce/subscriptions","organizations_url":"https://api.github.com/users/Ivorforce/orgs","repos_url":"https://api.github.com/users/Ivorforce/repos","events_url":"https://api.github.com/users/Ivorforce/events{/privacy}","received_events_url":"https://api.github.com/users/Ivorforce/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-11-11T14:33:53Z","updated_at":"2025-11-11T14:34:26Z","body":"Thank you for digging.\r\nI checked the code of the `keyboard_get_label_from_physical` function implementations.\r\n\r\nLooks like I was mistaken, the x11 fix for the keyboard issue hasn't been released yet in 4.5.1, it will only be part of 4.5.2 (if there will be a 4.5.2 release), or 4.6: https://github.com/godotengine/godot/pull/111795\r\n\r\nLooking at macOS and Windows, I don't think they have the same issue.","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3517203685/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3517227854","html_url":"https://github.com/godotengine/godot/pull/110556#issuecomment-3517227854","issue_url":"https://api.github.com/repos/godotengine/godot/issues/110556","id":3517227854,"node_id":"IC_kwDOAO6SJc7RpKNO","user":{"login":"hhyyrylainen","id":3796411,"node_id":"MDQ6VXNlcjM3OTY0MTE=","avatar_url":"https://avatars.githubusercontent.com/u/3796411?v=4","gravatar_id":"","url":"https://api.github.com/users/hhyyrylainen","html_url":"https://github.com/hhyyrylainen","followers_url":"https://api.github.com/users/hhyyrylainen/followers","following_url":"https://api.github.com/users/hhyyrylainen/following{/other_user}","gists_url":"https://api.github.com/users/hhyyrylainen/gists{/gist_id}","starred_url":"https://api.github.com/users/hhyyrylainen/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/hhyyrylainen/subscriptions","organizations_url":"https://api.github.com/users/hhyyrylainen/orgs","repos_url":"https://api.github.com/users/hhyyrylainen/repos","events_url":"https://api.github.com/users/hhyyrylainen/events{/privacy}","received_events_url":"https://api.github.com/users/hhyyrylainen/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-11-11T14:39:13Z","updated_at":"2025-11-11T14:39:13Z","body":"Thanks. I'll keep an eye out for the next Godot release then and not try further with 4.5.1.","author_association":"NONE","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3517227854/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null}]