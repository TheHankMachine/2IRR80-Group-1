[{"id":2526696780,"node_id":"PRR_kwDOAO6SJc6WmlVM","state":"APPROVED","user":{"site_admin":false,"suspended":false,"updated_at":"0001-01-01T00:00:00Z","avatar_url":"https://avatars.githubusercontent.com/u/52464204?u=4854f17c9d330a8a9d274f0cb7b943fc2bb6dd44&v=4","created_at":"0001-01-01T00:00:00Z","followers":0,"following":0,"html_url":"https://github.com/smix8","id":52464204,"node_id":"MDQ6VXNlcjUyNDY0MjA0","login":"smix8","type":"User","owned_private_repos":0,"public_gists":0,"public_repos":0,"total_private_repos":0,"url":"https://api.github.com/users/smix8"},"body":"Using self-listing to avoid looping over everything makes sense. It works better than LocalVector lists when there are only a few bodies and areas on the move all the time while having thousands of objects idle in the background. I did a similar change recently for navigation that also did brute force loops over everything before for the same reason. As long as people are not changing all their space / map objects all the time, which should be the majority of projects, it will be a net performance win.\r\n\r\nCant say that much for the API. My only concern is if this entire API change is still thread safe? Because Self-Lists are very error prone when not used with locks should users push changes from threads while the list is processed. I think the physics uses a MT wrapper in this case to avoid these problems, right?","html_url":"https://github.com/godotengine/godot/pull/100983#pullrequestreview-2526696780","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/100983","author_association":"CONTRIBUTOR","submitted_at":"2024-12-31T20:44:46Z"},{"id":2526867652,"node_id":"PRR_kwDOAO6SJc6WnPDE","state":"COMMENTED","user":{"site_admin":false,"suspended":false,"updated_at":"0001-01-01T00:00:00Z","avatar_url":"https://avatars.githubusercontent.com/u/1621693?u=14b293a7095d074e6653d7ad73269a5e785e1399&v=4","created_at":"0001-01-01T00:00:00Z","followers":0,"following":0,"html_url":"https://github.com/jrouwe","id":1621693,"node_id":"MDQ6VXNlcjE2MjE2OTM=","login":"jrouwe","type":"User","owned_private_repos":0,"public_gists":0,"public_repos":0,"total_private_repos":0,"url":"https://api.github.com/users/jrouwe"},"body":"Other than these 2 remarks below, the code looks good to me.","html_url":"https://github.com/godotengine/godot/pull/100983#pullrequestreview-2526867652","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/100983","author_association":"CONTRIBUTOR","submitted_at":"2025-01-01T14:31:54Z"},{"id":2526925926,"node_id":"PRR_kwDOAO6SJc6WndRm","state":"COMMENTED","user":{"site_admin":false,"suspended":false,"updated_at":"0001-01-01T00:00:00Z","avatar_url":"https://avatars.githubusercontent.com/u/4884246?v=4","created_at":"0001-01-01T00:00:00Z","followers":0,"following":0,"html_url":"https://github.com/mihe","id":4884246,"node_id":"MDQ6VXNlcjQ4ODQyNDY=","login":"mihe","type":"User","owned_private_repos":0,"public_gists":0,"public_repos":0,"total_private_repos":0,"url":"https://api.github.com/users/mihe"},"body":"","html_url":"https://github.com/godotengine/godot/pull/100983#pullrequestreview-2526925926","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/100983","author_association":"CONTRIBUTOR","submitted_at":"2025-01-01T20:38:26Z"},{"id":2526931175,"node_id":"PRR_kwDOAO6SJc6Wnejn","state":"APPROVED","commit_id":"7beaddc9c03c723a1c374fe69c591b95d5aff501","user":{"site_admin":false,"suspended":false,"updated_at":"0001-01-01T00:00:00Z","avatar_url":"https://avatars.githubusercontent.com/u/1621693?u=14b293a7095d074e6653d7ad73269a5e785e1399&v=4","created_at":"0001-01-01T00:00:00Z","followers":0,"following":0,"html_url":"https://github.com/jrouwe","id":1621693,"node_id":"MDQ6VXNlcjE2MjE2OTM=","login":"jrouwe","type":"User","owned_private_repos":0,"public_gists":0,"public_repos":0,"total_private_repos":0,"url":"https://api.github.com/users/jrouwe"},"body":"","html_url":"https://github.com/godotengine/godot/pull/100