[{"id":2671274303,"node_id":"PRR_kwDOAO6SJc6fOGk_","state":"CHANGES_REQUESTED","user":{"site_admin":false,"suspended":false,"updated_at":"0001-01-01T00:00:00Z","avatar_url":"https://avatars.githubusercontent.com/u/17506573?u=6e9313e254649f6dc55e92536596487ac10bf5a2&v=4","created_at":"0001-01-01T00:00:00Z","followers":0,"following":0,"html_url":"https://github.com/allenwp","id":17506573,"node_id":"MDQ6VXNlcjE3NTA2NTcz","login":"allenwp","type":"User","owned_private_repos":0,"public_gists":0,"public_repos":0,"total_private_repos":0,"url":"https://api.github.com/users/allenwp"},"body":"The term \"colour space\" is often ambiguous in practice. Specifying \"nonlinear sRGB\" gives the most clear communication of the colour encoding. Simply describing the transformation characteristic as \"nonlinear\" is the approached used throughout Edward J. Giorgianni and Thomas E. Madden's Digital Color Management textbook.\r\n\r\nI have left \"linear\" as-is instead of describing it as \"linear sRGB\" because no mapping of colour primaries happens in the nonlinear sRGB -> linear, so it's possible that other colour primaries could be used here (though it wouldn't make any sense). All that to say, I would also be happy with \"linear sRGB\" being used instead of simply \"linear\" in addition to my suggested changes.","html_url":"https://github.com/godotengine/godot/pull/103853#pullrequestreview-2671274303","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/103853","author_association":"CONTRIBUTOR","submitted_at":"2025-03-10T15:10:11Z"},{"id":2672350447,"node_id":"PRR_kwDOAO6SJc6fSNTv","state":"APPROVED","commit_id":"6249306c154cda0ce36c525387ad21506e583c37","user":{"site_admin":false,"suspended":false,"updated_at":"0001-01-01T00:00:00Z","avatar_url":"https://avatars.githubusercontent.com/u/32321?u=c2e06a3d2b49a467aa907e54aa259516440267cc&v=4","created_at":"0001-01-01T00:00:00Z","followers":0,"following":0,"html_url":"https://github.com/fire","id":32321,"node_id":"