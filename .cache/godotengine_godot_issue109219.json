reason":null,"draft":false,"pull_request":{"url":"https://api.github.com/repos/godotengine/godot/pulls/109219","html_url":"https://github.com/godotengine/godot/pull/109219","diff_url":"https://github.com/godotengine/godot/pull/109219.diff","patch_url":"https://github.com/godotengine/godot/pull/109219.patch","merged_at":null},"body":"Previously, only the target node’s visibility was checked, so if a parent (e.g., a character) was not visible, RPCs on its descendant nodes  (e.g., a weapon) would still be sent, causing errors on the receiving peer because those nodes didn’t exist locally.\r\n\r\nNow is_rpc_visible walks the tracked-node hierarchy and rejects the RPC if any ancestor is not visible, so RPCs on descendant nodes are properly culled.","closed_by":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/109219/reactions","total_count":4,"+1":4,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/godotengine/godot/issues/109219/timeline","performed_via_github_app":null,"state_reason":null}