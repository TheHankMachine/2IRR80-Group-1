ontent.com/u/1646875?v=4","gravatar_id":"","url":"https://api.github.com/users/aaronfranke","html_url":"https://github.com/aaronfranke","followers_url":"https://api.github.com/users/aaronfranke/followers","following_url":"https://api.github.com/users/aaronfranke/following{/other_user}","gists_url":"https://api.github.com/users/aaronfranke/gists{/gist_id}","starred_url":"https://api.github.com/users/aaronfranke/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/aaronfranke/subscriptions","organizations_url":"https://api.github.com/users/aaronfranke/orgs","repos_url":"https://api.github.com/users/aaronfranke/repos","events_url":"https://api.github.com/users/aaronfranke/events{/privacy}","received_events_url":"https://api.github.com/users/aaronfranke/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-02-26T22:21:00Z","updated_at":"2025-02-26T22:21:00Z","body":"@fire The PR contains an example file already. Did you want me to also include a file that is unaffected by this PR?","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2686338386/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2767595449","html_url":"https://github.com/godotengine/godot/pull/103332#issuecomment-2767595449","issue_url":"https://api.github.com/repos/godotengine/godot/issues/103332","id":2767595449,"node_id":"IC_kwDOAO6SJc6k9ie5","user":{"login":"yankscally","id":27631913,"node_id":"MDQ6VXNlcjI3NjMxOTEz","avatar_url":"https://avatars.githubusercontent.com/u/27631913?v=4","gravatar_id":"","url":"https://api.github.com/users/yankscally","html_url":"https://github.com/yankscally","followers_url":"https://api.github.com/users/yankscally/followers","following_url":"https://api.github.com/users/yankscally/following{/other_user}","gists_url":"https://api.github.com/users/yankscally/gists{/gist_id}","starred_url":"https://api.github.com/users/yankscally/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/yankscally/subscriptions","organizations_url":"https://api.github.com/users/yankscally/orgs","repos_url":"https://api.github.com/users/yankscally/repos","events_url":"https://api.github.com/users/yankscally/events{/privacy}","received_events_url":"https://api.github.com/users/yankscally/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-03-31T22:49:33Z","updated_at":"2025-03-31T23:18:50Z","body":"in blender, you can have multiple scenes, and it is respected in the gltf file:\r\n\r\n![image](https://github.com/user-attachments/assets/15c32bed-3dc1-46f1-a378-44727869fad5)\r\n\r\n\r\nhere is the export:\r\n\r\n```json\r\n{\r\n\t\"asset\":{\r\n\t\t\"generator\":\"Khronos glTF Blender I/O v4.3.47\",\r\n\t\t\"version\":\"2.0\"\r\n\t},\r\n\t\"scene\":0,\r\n\t\"scenes\":[\r\n\t\t{\r\n\t\t\t\"name\":\"Scene\",\r\n\t\t\t\"nodes\":[\r\n\t\t\t\t0\r\n\t\t\t]\r\n\t\t},\r\n\t\t{\r\n\t\t\t\"name\":\"Scene.2\",\r\n\t\t\t\"nodes\":[\r\n\t\t\t\t1\r\n\t\t\t]\r\n\t\t}\r\n\t],\r\n\t\"nodes\":[\r\n\t\t{\r\n\t\t\t\"mesh\":0,\r\n\t\t\t\"name\":\"Cube\"\r\n\t\t},\r\n\t\t{\r\n\t\t\t\"mesh\":1,\r\n\t\t\t\"name\":\"Sphere\"\r\n\t\t}\r\n\t],\r\n\t\"meshes\":[\r\n\t\t{\r\n\t\t\t\"name\":\"Cube\",\r\n\r\n\t\t},\r\n\t\t{\r\n\t\t\t\"name\":\"Sphere\",\r\n\r\n                }\r\n```\r\n\r\nwith blender being able to export to multiple scenes, it seems like a shame to not be using this in godot, and discarding extra scenes for the \"selected\" one. The selected scene from blender is the one you are currently looking at in that drop down, and still exports the other scenes data. Discarding it in godot feels like a waste of a possibly useful feature.\r\n\r\nI experimented with using scenes in a blender project to section reusable mesh objects into a space I don't have to look at. \r\n\r\nI thought about this:\r\n![image](https://github.com/user-attachments/assets/4e91d8c0-b74c-4396-a2d7-069b6c91f9c6)\r\n\r\nBut that doesn't feel like a particularly great solution when we are adding `KHR_node_visibility` soon, but in some ways thats what blender is doing under the hood. wish I had a better idea for importing multiple scenes.\r\n\r\nHere is blender \"hiding\" objects that are not in the scene:\r\n![image](https://github.com/user-attachments/assets/ec235aa7-dc38-44a7-a4e5-82bb2ab5a22b)\r\n![image](https://github.com/user-attachments/assets/dbe563d4-4404-4200-9548-77cfeb641ce7)\r\n\n\nEdit* \nI read over this again and actually think hiding the not selected \"scene root\" nodes under the godot root if there are multiple scenes might work well and is not a terrible idea, a godot scene does not equate to a glTF scene, we can easily use a node in godot for this purpose and hide it.\n\nIt's just a lot of work exposing all of this to godot users for no anticipated benefits. ","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2767595449/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2828280046","html_url":"https://github.com/godotengine/godot/pull/103332#issuecomment-2828280046","issue_url":"https://api.github.com/repos/godotengine/godot/issues/103332","id":2828280046,"node_id":"IC_kwDOAO6SJc6olCDu","user":{"login":"fire","id":32321,"node_id":"MDQ6VXNlcjMyMzIx","avatar_url":"https://avatars.githubusercontent.com/u/32321?v=4","gravatar_id":"","url":"https://api.github.com/users/fire","html_url":"https://github.com/fire","followers_url":"https://api.github.com/users/fire/followers","following_url":"https://api.github.com/users/fire/following{/other_user}","gists_url":"