w1NzI3ODE5OTc=","url":"https://api.github.com/repos/godotengine/godot/labels/topic:audio","name":"topic:audio","color":"ffee88","default":false,"description":"","archived_at":null,"archived_by":null}],"state":"closed","locked":false,"assignees":[],"milestone":{"url":"https://api.github.com/repos/godotengine/godot/milestones/22","html_url":"https://github.com/godotengine/godot/milestone/22","labels_url":"https://api.github.com/repos/godotengine/godot/milestones/22/labels","id":12070367,"node_id":"MI_kwDOAO6SJc4AuC3f","number":22,"title":"4.5","description":"","creator":{"login":"Sauermann","id":6299227,"node_id":"MDQ6VXNlcjYyOTkyMjc=","avatar_url":"https://avatars.githubusercontent.com/u/6299227?v=4","gravatar_id":"","url":"https://api.github.com/users/Sauermann","html_url":"https://github.com/Sauermann","followers_url":"https://api.github.com/users/Sauermann/followers","following_url":"https://api.github.com/users/Sauermann/following{/other_user}","gists_url":"https://api.github.com/users/Sauermann/gists{/gist_id}","starred_url":"https://api.github.com/users/Sauermann/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Sauermann/subscriptions","organizations_url":"https://api.github.com/users/Sauermann/orgs","repos_url":"https://api.github.com/users/Sauermann/repos","events_url":"https://api.github.com/users/Sauermann/events{/privacy}","received_events_url":"https://api.github.com/users/Sauermann/received_events","type":"User","user_view_type":"public","site_admin":false},"open_issues":3,"closed_issues":3687,"state":"closed","created_at":"2024-12-19T08:51:28Z","updated_at":"2026-09-04T21:48:38Z","due_on":"2025-09-15T00:00:00Z","closed_at":"2025-09-18T17:13:14Z"},"comments":16,"created_at":"2024-11-22T19:02:43Z","updated_at":"2025-04-01T04:13:32Z","closed_at":"2025-03-19T22:46:33Z","assignee":null,"author_association":"CONTRIBUTOR","issue_field_values":[],"type":null,"active_lock_reason":null,"draft":false,"pull_request":{"url":"https://api.github.com/repos/godotengine/godot/pulls/99555","html_url":"https://github.com/godotengine/godot/pull/99555","diff_url":"https://github.com/godotengine/godot/pull/99555.diff","patch_url":"https://github.com/godotengine/godot/pull/99555.patch","merged_at":"2025-03-19T22:46:33Z"},"body":"This should close https://github.com/godotengine/godot-proposals/issues/1066.\r\n\r\nIt adds a button to the Game view's toolbar that disables all audio output from the game when toggled off.\r\n\r\nhttps://github.com/user-attachments/assets/b8581b64-fd6c-495d-a8a6-2feba6dd57dc\r\n\r\nThings to consider:\r\n- The code was structured to mimic the camera override implementation. It seems to be working well, but I'm feeling a little iffy about having separate `audio_enabled` members for `EditorDebuggerNode` and `ScriptEditorDebugger`, rather than a single source of truth for whether or not audio is enabled.\r\n- Currently, it defaults to being enabled, and stays in sync with the AudioServer simply by being the only object to modify it. We may want to add a signal or something to the AudioServer that emits whenever the `mute` variable is changed, so that the button's toggled state can update appropriately if `mute` is changed from elsewhere.\r\n- ~~The current icon may be a bit confusing. It could be good to create a crossed-out version of the AudioStreamPlayer icon to indicate that sound is muted.~~\r\n- ~~Similarly, the meaning of the button is a bit mixed. It's technically an \"*enable* audio\" button (as in, when toggled on, audio plays). The addition to AudioServer, on the other hand, is a `mute` variable (when true, audio *doesn't play*.) I did this to keep it consistent with `set_bus_mute`, but I'm wondering if one direction (true = mute, or true = audible) should be chosen for this whole flow instead.~~","closed_by":{"login":"Repiteo","id":17489292,"node_id":"MDQ6VXNlcjE3NDg5Mjky","avatar_url":"https://avatars.githubusercontent.com/u/17489292?v=4","gravatar_id":"","url":"https://api.github.com/users/Repiteo","html_url":"https://github.com/Repiteo","followers_url":"https://api.github.com/users/Repiteo/followers","following_url":"https://api.github.com/users/Repiteo/following{/other_user}","gists_url":"https://api.github.com/users/Repiteo/gists{/gist_id}","starred_url":"https://api.github.com/users/Repiteo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Repiteo/subscriptions","organizations_url":"https://api.github.com/users/Repiteo/orgs","repos_url":"https://api.github.com/users/Repiteo/repos","events_url":"https://api.github.com/users/Repiteo/events{/privacy}","received_events_url":"https://api.github.com/users/Repiteo/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/99555/reactions","total_count":40,"+1":40,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/godotengine/godot/issues/99555/timeline","performed_via_github_app":null,"state_reason":null}