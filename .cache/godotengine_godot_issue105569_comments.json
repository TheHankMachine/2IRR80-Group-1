/akien-mga/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-04-23T12:54:36Z","updated_at":"2025-04-23T12:54:36Z","body":"@scgm0 Can you clarify what's your configuration for rcedit? i.e. the `export/windows/rcedit` and `export/windows/wine` editor settings.\n\nI tried with an empty path for `export/windows/wine` and a path to an invalid file for `export/windows/rcedit` (`/home/akien/main.gd`, tried with it being both executable and non-executable) and it doesn't freeze for me, and instead prints this error:\n\n```\nWARNING: ./editor/export/editor_export_platform.h:240 - Resources Modification: Could not start rcedit executable. Configure rcedit path in the Editor Settings (Export > Windows > rcedit), or disable \"Application > Modify Resources\" in the export preset.\n```","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2824207022/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2824236516","html_url":"https://github.com/godotengine/godot/issues/105569#issuecomment-2824236516","issue_url":"https://api.github.com/repos/godotengine/godot/issues/105569","id":2824236516,"node_id":"IC_kwDOAO6SJc6oVm3k","user":{"login":"scgm0","id":52148221,"node_id":"MDQ6VXNlcjUyMTQ4MjIx","avatar_url":"https://avatars.githubusercontent.com/u/52148221?v=4","gravatar_id":"","url":"https://api.github.com/users/scgm0","html_url":"https://github.com/scgm0","followers_url":"https://api.github.com/users/scgm0/followers","following_url":"https://api.github.com/users/scgm0/following{/other_user}","gists_url":"https://api.github.com/users/scgm0/gists{/gist_id}","starred_url":"https://api.github.com/users/scgm0/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/scgm0/subscriptions","organizations_url":"https://api.github.com/users/scgm0/orgs","repos_url":"https://api.github.com/users/scgm0/repos","events_url":"https://api.github.com/users/scgm0/events{/privacy}","received_events_url":"https://api.github.com/users/scgm0/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-04-23T13:05:08Z","updated_at":"2025-04-23T13:05:08Z","body":"> [@scgm0](https://github.com/scgm0) Can you clarify what's your configuration for rcedit? i.e. the `export/windows/rcedit` and `export/windows/wine` editor settings.\n> \n> I tried with an empty path for `export/windows/wine` and a path to an invalid file for `export/windows/rcedit` (`/home/akien/main.gd`, tried with it being both executable and non-executable) and it doesn't freeze for me, and instead prints this error:\n> \n> ```\n> WARNING: ./editor/export/editor_export_platform.h:240 - Resources Modification: Could not start rcedit executable. Configure rcedit path in the Editor Settings (Export > Windows > rcedit), or disable \"Application > Modify Resources\" in the export preset.\n> ```\n\nThis is my current rcedit configuration:\n\n![Image](https://github.com/user-attachments/assets/e9c2a7f6-044b-48bf-aa2e-94df9721654f)\nIt still cannot reproduce the issue 100% of the time. I'm not sure if there's some condition I've overlooked, but as long as I don't enable application modifications or use rcedit, the problem never occurs:\n\n![Image](https://github.com/user-attachments/assets/cfddcf42-7b11-4e47-b83f-78c0fc350ded)","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2824236516/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2824241135","html_url":"https://github.com/godotengine/godot/issues/105569#issuecomment-2