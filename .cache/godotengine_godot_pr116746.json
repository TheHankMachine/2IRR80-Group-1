\r\nFixes #116577 \r\n\r\nWhen dragging a TabContainer/TabBar tab between non-embedded windows, the\r\ntarget TabBar could fail to show the drop marker because preview activation\r\ndepended on local mouse motion input only.\r\n\r\nBy updating TabBar drag preview state on drag and hover lifecycle\r\nnotifications (NOTIFICATION_DRAG_BEGIN, NOTIFICATION_MOUSE_ENTER,\r\nNOTIFICATION_MOUSE_EXIT), this change ensures the drop indicator appears\r\nreliably for cross-window tab drags.","labels":[{"id":73330064,"node_id":"MDU6TGFiZWw3MzMzMDA2NA==","url":"https://api.github.com/repos/godotengine/godot/labels/bug","name":"bug","description":"","color":"ff6055","default":true,"archived_at":null,"archived_by":null},{"id":890310664,"node_id":"MDU6TGFiZWw4OTAzMTA2NjQ=","url":"https://api.github.com/repos/godotengine/godot/labels/topic:input","name":"topic:input","description":"","color":"ffee88","default":false,"archived_at":null,"archived_by":null},{"id":1732720779,"node_id":"MDU6TGFiZWwxNzMyNzIwNzc5","url":"https://api.github.com/repos/godotengine/godot/labels/topic:gui","name":"topic:gui","description":"","color":"ffee88","default":false,"archived_at":null,"archived_by":null}],"milestone":{"id":8237783,"node_id":"MI_kwDOAO6SJc4AfbLX","url":"https://api.github.com/repos/godotengine/godot/milestones/16","html_url":"https://github.com/godotengine/godot/milestone/16","labels_url":"https://api.github.com/repos/godotengine/godot/milestones/16/labels","number":16,"state":"open","title":"4.x","description":"Issues and pull requests slated for an undetermined Godot 4 release.","creator":{"login":"akien-mga","id":4701338,"node_id":"MDQ6VXNlcjQ3MDEzMzg=","avatar_url":"https://avatars.githubusercontent.com/u/4701338?v=4","gravatar_id":"","url":"https://api.github.com/users/akien-mga","html_url":"https://github.com/akien-mga","followers_url":"https://api.github.com/users/akien-mga/followers","following_url":"https://api.github.com/users/akien-mga/following{/other_user}","gists_url":"https: