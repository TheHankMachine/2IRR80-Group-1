y":null},{"id":2666708289,"node_id":"MDU6TGFiZWwyNjY2NzA4Mjg5","url":"https://api.github.com/repos/godotengine/godot/labels/topic:3d","name":"topic:3d","color":"ffee88","default":false,"description":"","archived_at":null,"archived_by":null}],"state":"open","locked":false,"assignees":[],"milestone":{"url":"https://api.github.com/repos/godotengine/godot/milestones/16","html_url":"https://github.com/godotengine/godot/milestone/16","labels_url":"https://api.github.com/repos/godotengine/godot/milestones/16/labels","id":8237783,"node_id":"MI_kwDOAO6SJc4AfbLX","number":16,"title":"4.x","description":"Issues and pull requests slated for an undetermined Godot 4 release.","creator":{"login":"akien-mga","id":4701338,"node_id":"MDQ6VXNlcjQ3MDEzMzg=","avatar_url":"https://avatars.githubusercontent.com/u/4701338?v=4","gravatar_id":"","url":"https://api.github.com/users/akien-mga","html_url":"https://github.com/akien-mga","followers_url":"https://api.github.com/users/akien-mga/followers","following_url":"https://api.github.com/users/akien-mga/following{/other_user}","gists_url":"https://api.github.com/users/akien-mga/gists{/gist_id}","starred_url":"https://api.github.com/users/akien-mga/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/akien-mga/subscriptions","organizations_url":"https://api.github.com/users/akien-mga/orgs","repos_url":"https://api.github.com/users/akien-mga/repos","events_url":"https://api.github.com/users/akien-mga/events{/privacy}","received_events_url":"https://api.github.com/users/akien-mga/received_events","type":"User","user_view_type":"public","site_admin":false},"open_issues":5791,"closed_issues":0,"state":"open","created_at":"2022-07-26T12:42:05Z","updated_at":"2026-10-21T22:40:26Z","due_on":null,"closed_at":null},"comments":0,"created_at":"2026-03-23T06:27:06Z","updated_at":"2026-04-20T10:02:28Z","closed_at":null,"assignee":null,"author_association":"CONTRIBUTOR","issue_field_values":[],"type":null,"active_lock_reason":null,"draft":true,"pull_request":{"url":"https://api.github.com/repos/godotengine/godot/pulls/117747","html_url":"https://github.com/godotengine/godot/pull/117747","diff_url":"https://github.com/godotengine/godot/pull/117747.diff","patch_url":"https://github.com/godotengine/godot/pull/117747.patch","merged_at":null},"body":"Closes https://github.com/godotengine/godot-proposals/issues/7164\r\n\r\nDraft because it requires #109746 to be practically usable and testable.\r\n\r\nThe proposal discusses two options:\r\n- Adding a virtual method to `GridMap` for changed cells, as has been done for tilemaps in #96188\r\n- Adding a signal to the editor plugin for cells modified by it.\r\n\r\nThis implements the latter because IMO it is a better idea. The main reason is that a common use case would be to implement some procedural generation logic that sets more items after something is set. But if the callback is in `GridMap`, it would be executed every time irrespectively of whether items are set by the editor, or by the user's custom generation code, which would get in the way of said generation code.\r\n\r\nThis is more practical, because:\r\n- If the user needs a signal that runs after a set they did in code, they can emit their own.\r\n- There is still a way to set items without triggering any kind of additional logic.","closed_by":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/117747/reactions","total_count":4,"+1":4,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/godotengine/godot/issues/117747/timeline","performed_via_github_app":null,"state_reason":null}