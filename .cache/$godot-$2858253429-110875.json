[{"id":3264809638,"node_id":"PRR_kwDOAO6SJc7CmQqm","state":"APPROVED","commit_id":"c64ff4b069478021a11dc043c4a5f9c457c48ec7","user":{"site_admin":false,"suspended":false,"updated_at":"0001-01-01T00:00:00Z","avatar_url":"https://avatars.githubusercontent.com/u/31065808?v=4","created_at":"0001-01-01T00:00:00Z","followers":0,"following":0,"html_url":"https://github.com/deralmas","id":31065808,"node_id":"MDQ6VXNlcjMxMDY1ODA4","login":"deralmas","type":"User","owned_private_repos":0,"public_gists":0,"public_repos":0,"total_private_repos":0,"url":"https://api.github.com/users/deralmas"},"body":"Great catch! We absolutely need to also call the inhibit method for situations where there is not a suitable portal to ensure compatibility with as many compositors as possible.\n\nI swear, there once was an inhibit call but for some mysterious reason it... Disappeared? :sweat_smile:\n\nHaven't tested but the fix is trivial.\n\nAlso, FTR, the idle inhibit protocol says that if the inhibited window is occluded the compositor will ignore it. I wonder if we should eventually apply it to every window (even new ones?) to avoid that. Eh, this will definitely do for now :D ","html_url":"https://github.com/godotengine/godot/pull/110875#pullrequestreview-3264809638","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/110875","author_association":"MEMBER","submitted_at":"2025-09-24T21:32:13Z"},{"id":3264817687,"node_id":"PRR_kwDOAO6SJc7CmSoX","state":"APPROVED","commit_id":"c64ff4b069478021a11dc043c4a5f9c457c48ec7","user":{"site_admin":false,"suspended":false,"updated_at":"0001-01-01T00:00:00Z","avatar_url":"https://avatars.githubusercontent.com/u/180032?u=68d23e7ee9cdf810da125e8510b72f845b9dccc8&v=4","created_at":"0001-01-01T00:00:00Z","followers":0,"following":0,"html_url":"https://github.com/Calinou","id":180032,"node_id":"MDQ6VXNlcjE4MDAzMg==","login":"Calinou","type":"User","owned_private_repos":0,"public_gists":0,"public_repos":0,"total_private_repos":0,"url":"http