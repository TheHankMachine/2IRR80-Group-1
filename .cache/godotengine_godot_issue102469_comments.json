[{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2638835246","html_url":"https://github.com/godotengine/godot/pull/102469#issuecomment-2638835246","issue_url":"https://api.github.com/repos/godotengine/godot/issues/102469","id":2638835246,"node_id":"IC_kwDOAO6SJc6dSW4u","user":{"login":"arkology","id":43543909,"node_id":"MDQ6VXNlcjQzNTQzOTA5","avatar_url":"https://avatars.githubusercontent.com/u/43543909?v=4","gravatar_id":"","url":"https://api.github.com/users/arkology","html_url":"https://github.com/arkology","followers_url":"https://api.github.com/users/arkology/followers","following_url":"https://api.github.com/users/arkology/following{/other_user}","gists_url":"https://api.github.com/users/arkology/gists{/gist_id}","starred_url":"https://api.github.com/users/arkology/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/arkology/subscriptions","organizations_url":"https://api.github.com/users/arkology/orgs","repos_url":"https://api.github.com/users/arkology/repos","events_url":"https://api.github.com/users/arkology/events{/privacy}","received_events_url":"https://api.github.com/users/arkology/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-02-06T05:05:46Z","updated_at":"2025-02-06T06:58:11Z","body":"I think it may be good (but not necessary) to have transparency check to skip code if alpha is zero.","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2638835246/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2638949844","html_url":"https://github.com/godotengine/godot/pull/102469#issuecomment-2638949844","issue_url":"https://api.github.com/repos/godotengine/godot/issues/102469","id":2638949844,"node_id":"IC_kwDOAO6SJc6dSy3U","user":{"login":"sockeye-d","id":106356149,"node_id":"U_kgDOBlbdtQ","avatar_url":"https://avatars.githubusercontent.com/u/106356149?v=4","gravatar_id":"","url":"https://api.github.com/users/sockeye-d","html_url":"https://github.com/sockeye-d","followers_url":"https://api.github.com/users/sockeye-d/followers","following_url":"https://api.github.com/users/sockeye-d/following{/other_user}","gists_url":"https://api.github.com/users/sockeye-d/gists{/gist_id}","starred_url":"https://api.github.com/users/sockeye-d/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/sockeye-d/subscriptions","organizations_url":"https://api.github.com/users/sockeye-d/orgs","repos_url":"https://api.github.com/users/sockeye-d/repos","events_url":"https://api.github.com/users/sockeye-d/events{/privacy}","received_events_url":"https://api.github.com/users/sockeye-d/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-02-06T06:28:41Z","updated_at":"2025-02-06T06:28:41Z","body":"> I think it should have transparency check to skip code if alpha is zero.\r\n\r\nIf the alpha is set to zero, warnings are added, then changed in the editor settings to something visible, it won't change until the next time warnings are updated. This is because it won't make the lines a color other than `Color(0.0, 0.0, 0.0, 0.0)` and so when it updates the line colors it won't find any that match. Also since errors don't do it and it's probably a negligible performance hit I don't think it's worth it","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2638949844/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2638970778","html_url":"https://github.com/godotengine/godot/pull/102469#issuecomment-2638970778","issue_url":"http