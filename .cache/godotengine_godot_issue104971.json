_by":null},{"id":1332303119,"node_id":"MDU6TGFiZWwxMzMyMzAzMTE5","url":"https://api.github.com/repos/godotengine/godot/labels/regression","name":"regression","color":"ff63ac","default":false,"description":"","archived_at":null,"archived_by":null}],"state":"closed","locked":false,"assignees":[],"milestone":{"url":"https://api.github.com/repos/godotengine/godot/milestones/22","html_url":"https://github.com/godotengine/godot/milestone/22","labels_url":"https://api.github.com/repos/godotengine/godot/milestones/22/labels","id":12070367,"node_id":"MI_kwDOAO6SJc4AuC3f","number":22,"title":"4.5","description":"","creator":{"login":"Sauermann","id":6299227,"node_id":"MDQ6VXNlcjYyOTkyMjc=","avatar_url":"https://avatars.githubusercontent.com/u/6299227?v=4","gravatar_id":"","url":"https://api.github.com/users/Sauermann","html_url":"https://github.com/Sauermann","followers_url":"https://api.github.com/users/Sauermann/followers","following_url":"https://api.github.com/users/Sauermann/following{/other_user}","gists_url":"https://api.github.com/users/Sauermann/gists{/gist_id}","starred_url":"https://api.github.com/users/Sauermann/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Sauermann/subscriptions","organizations_url":"https://api.github.com/users/Sauermann/orgs","repos_url":"https://api.github.com/users/Sauermann/repos","events_url":"https://api.github.com/users/Sauermann/events{/privacy}","received_events_url":"https://api.github.com/users/Sauermann/received_events","type":"User","user_view_type":"public","site_admin":false},"open_issues":3,"closed_issues":3687,"state":"closed","created_at":"2024-12-19T08:51:28Z","updated_at":"2026-09-04T21:48:38Z","due_on":"2025-09-15T00:00:00Z","closed_at":"2025-09-18T17:13:14Z"},"comments":9,"created_at":"2025-04-03T13:27:03Z","updated_at":"2025-04-25T17:03:45Z","closed_at":"2025-04-25T16:42:00Z","assignee":null,"author_association":"MEMBER","issue_field_values":[],"type":null,"active_lock_reason":null,"draft":false,"pull_request":{"url":"https://api.github.com/repos/godotengine/godot/pulls/104971","html_url":"https://github.com/godotengine/godot/pull/104971","diff_url":"https://github.com/godotengine/godot/pull/104971.diff","patch_url":"https://github.com/godotengine/godot/pull/104971.patch","merged_at":"2025-04-25T16:42:00Z"},"body":"Follow-up to https://github.com/godotengine/godot/pull/104232\r\nFixes https://github.com/godotengine/godot/pull/104232#issuecomment-2768484533\r\n\r\nMy recent PR https://github.com/godotengine/godot/pull/104232 deactivated the `CameraServer` by default, to speed up editor launch times, since most projects do not need to monitor the cameras.\r\n\r\nUnfortunately, since the editor itself needs to monitor cameras when using `CameraTexture`, `CameraTexture` has been broken since then.\r\nWe expect of applications to start monitoring the camera consciously, so no resources are wasted. But I'm not sure if there is any boilerplate in place in Godot to make this easy for things like `CameraTexture`, which is used in a completely modular way, and may silently be created through serialization, GUI and from code.\r\n\r\nSo for the editor, I'm proposing to start `CameraServer` monitoring automatically when using the first `CameraTexture`. This will incur a small hiccup, although it's not super noticeable.\r\nThe hack is employed only in editor builds, so the need to run `CameraServer.get_singleton().is_monitoring = true` will be inconsistent between editor and release binaries of games. This is not great, but I cannot think of a better alternative to fix the problem at the moment.","closed_by":{"login":"Repiteo","id":17489292,"node_id":"MDQ6VXNlcjE3NDg5Mjky","avatar_url":"https://avatars.githubusercontent.com/u/17489292?v=4","gravatar_id":"","url":"https://api.github.com/users/Repiteo","html_url":"https://github.com/Repiteo","followers_url":"https://api.github.com/users/Repiteo/followers","following_url":"https://api.github.com/users/Repiteo/following{/other_user}","gists_url":"https://api.github.com/users/Repiteo/gists{/gist_id}","starred_url":"https://api.github.com/users/Repiteo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Repiteo/subscriptions","organizations_url":"https://api.github.com/users/Repiteo/orgs","repos_url":"https://api.github.com/users/Repiteo/repos","events_url":"https://api.github.com/users/Repiteo/events{/privacy}","received_events_url":"https://api.github.com/users/Repiteo/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/104971/reactions","total_count":2,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":2},"timeline_url":"https://api.github.com/repos/godotengine/godot/issues/104971/timeline","performed_via_github_app":null,"state_reason":null}