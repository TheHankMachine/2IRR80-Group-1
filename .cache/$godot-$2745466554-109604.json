[{"id":3120542580,"node_id":"PRR_kwDOAO6SJc65_7N0","state":"APPROVED","commit_id":"dd14cadd623647383934804dfa655113c20678c8","user":{"site_admin":false,"suspended":false,"updated_at":"0001-01-01T00:00:00Z","avatar_url":"https://avatars.githubusercontent.com/u/191561?v=4","created_at":"0001-01-01T00:00:00Z","followers":0,"following":0,"html_url":"https://github.com/dsnopek","id":191561,"node_id":"MDQ6VXNlcjE5MTU2MQ==","login":"dsnopek","type":"User","owned_private_repos":0,"public_gists":0,"public_repos":0,"total_private_repos":0,"url":"https://api.github.com/users/dsnopek"},"body":"Thanks!\r\n\r\nThe code seems fine. Like you say, compilers may already be working this out on their own, but it doesn't hurt to be explicit","html_url":"https://github.com/godotengine/godot/pull/109604#pullrequestreview-3120542580","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/109604","author_association":"CONTRIBUTOR","submitted_at":"2025-08-14T13:11:52Z"},{"id":3124481607,"node_id":"PRR_kwDOAO6SJc66O85H","state":"APPROVED","commit_id":"dd14cadd623647383934804dfa655113c20678c8","user":{"site_admin":false,"suspended":false,"updated_at":"0001-01-01T00:00:00Z","avatar_url":"https://avatars.githubusercontent.com/u/17489292?u=34072b401722100a7c0c0d61e37b376cf22b4545&v=4","created_at":"0001-01-01T00:00:00Z","followers":0,"following":0,"html_url":"https://github.com/Repiteo","id":17489292,"node_id":"MDQ6VXNlcjE3NDg5Mjky","login":"Repiteo","type":"User","owned_private_repos":0,"public_gists":0,"public_repos":0,"total_private_repos":0,"url":"https://api.github.com/users/Repiteo"},"body":"I was doing something similar in #108121, but this probably warrants a separate PR like this","html_url":"https://github.com/godotengine/godot/pull/109604#pullrequestreview-3124481607","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/109604","author_association":"CONTRIBUTOR","submitted_at":"2025-08-15T16:30:00Z"},{"id":3132118314,"node_id":"PRR_kwDOAO6SJc66sFUq","state":"COMMENTED","commit_id":"dd14cadd623647383934804dfa655113c20678c8","user":{"site_admin":false,"suspended":false,"updated_at":"0001-01-01T00:00:00Z","avatar_url":"https://avatars.githubusercontent.com/u/2308167?u=f7f8e0273f784f5ec6f6b7fe4a88d449896eb48a&v=4","created_at":"0001-01-01T00:00:00Z","followers":0,"following":0,"html_url":"https://github.com/Ivorforce","id":2308167,"node_id":"MDQ6VXNlcjIzMDgxNjc=","login":"Ivorforce","type":"User","owned_private_repos":0,"public_gists":0,"public_repos":0,"total_private_repos":0,"url":"https://api.github.com/users/Ivorforce"},"body":"> Adding this constexpr makes windows editor production build 3KB smaller.\r\n\r\nIt's worth noting that compilers can be pretty opaque, and the reduction may come as a result of context rather than it not inlining these specific if clauses. 3kb is certainly small enough of a difference that I wouldn't be confident it's a reliable save.\r\n\r\nTo the change, I'm somewhat indifferent. I'm not sure we should go around and churn functions that work fine, when we know the change isn't expected to have an impact (gcc and clang should already factor out the `if`). That said, I won't oppose merging it on this basis.","html_url":"https://github.com/godotengine/godot/pull/109604#pullrequestreview-3132118314","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/109604","author_association":"MEMBER","submitted_at":"2025-08-19T12:32:34Z"}]