[{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2547535191","html_url":"https://github.com/godotengine/godot/issues/100493#issuecomment-2547535191","issue_url":"https://api.github.com/repos/godotengine/godot/issues/100493","id":2547535191,"node_id":"IC_kwDOAO6SJc6X2E1X","user":{"login":"syntaxerror247","id":176927541,"node_id":"U_kgDOCouzNQ","avatar_url":"https://avatars.githubusercontent.com/u/176927541?v=4","gravatar_id":"","url":"https://api.github.com/users/syntaxerror247","html_url":"https://github.com/syntaxerror247","followers_url":"https://api.github.com/users/syntaxerror247/followers","following_url":"https://api.github.com/users/syntaxerror247/following{/other_user}","gists_url":"https://api.github.com/users/syntaxerror247/gists{/gist_id}","starred_url":"https://api.github.com/users/syntaxerror247/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/syntaxerror247/subscriptions","organizations_url":"https://api.github.com/users/syntaxerror247/orgs","repos_url":"https://api.github.com/users/syntaxerror247/repos","events_url":"https://api.github.com/users/syntaxerror247/events{/privacy}","received_events_url":"https://api.github.com/users/syntaxerror247/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2024-12-17T05:24:45Z","updated_at":"2024-12-17T05:24:45Z","body":"Make sure you have enabled Storage permissions in export settings and requested it in your app using `OS.request_permissions()`.\nFrom your screenshot, it looks like you are trying to open images, you should enable `READ_MEDIA_IMAGES`.","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2547535191/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2549638357","html_u