ollowing_url":"https://api.github.com/users/Calinou/following{/other_user}","gists_url":"https://api.github.com/users/Calinou/gists{/gist_id}","starred_url":"https://api.github.com/users/Calinou/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Calinou/subscriptions","organizations_url":"https://api.github.com/users/Calinou/orgs","repos_url":"https://api.github.com/users/Calinou/repos","events_url":"https://api.github.com/users/Calinou/events{/privacy}","received_events_url":"https://api.github.com/users/Calinou/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-09-29T17:44:47Z","updated_at":"2025-09-29T17:45:59Z","body":"- Related to https://github.com/godotengine/godot/pull/73003.\r\n\r\nWe should ensure we're settling on standard naming for SCons options that enable features normally disabled in export template builds.\r\n\r\nIdeally, we'd just allow `module_cvtt_enabled=yes` to work on export template builds but I'm not sure if this is feasible.\r\n\r\nAlso, wouldn't you want to enable the Betsy module as well for GPU-based compression? While it requires a GPU with RenderingDevice support (mandated for Forward+/Mobile), it has the potential to be much faster than CPU-based compression.","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3348236339/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3348577686","html_url":"https://github.com/godotengine/godot/pull/111015#issuecomment-3348577686","issue_url":"https://api.github.com/repos/godotengine/godot/issues/111015","id":3348577686,"node_id":"IC_kwDOAO6SJc7Hlz2W","user":{"login":"Alexofp","id":14040378,"node_id":"MDQ6VXNlcjE0MDQwMzc4","avatar_url":"https://avatars.githubusercontent.com/u/14040378?v=4","gravata