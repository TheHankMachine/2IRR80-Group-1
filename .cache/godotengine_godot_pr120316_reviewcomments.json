ndShips","html_url":"https://github.com/AThousandShips","followers_url":"https://api.github.com/users/AThousandShips/followers","following_url":"https://api.github.com/users/AThousandShips/following{/other_user}","gists_url":"https://api.github.com/users/AThousandShips/gists{/gist_id}","starred_url":"https://api.github.com/users/AThousandShips/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/AThousandShips/subscriptions","organizations_url":"https://api.github.com/users/AThousandShips/orgs","repos_url":"https://api.github.com/users/AThousandShips/repos","events_url":"https://api.github.com/users/AThousandShips/events{/privacy}","received_events_url":"https://api.github.com/users/AThousandShips/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"Not sure this is the correct way, it seems a bit hacky ","created_at":"2026-06-15T09:16:06Z","updated_at":"2026-06-15T09:16:37Z","html_url":"https://github.com/godotengine/godot/pull/120316#discussion_r3412333121","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/120316","_links":{"self":{"href":"https://api.github.com/repos/godotengine/godot/pulls/comments/3412333121"},"html":{"href":"https://github.com/godotengine/godot/pull/120316#discussion_r3412333121"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/120316"}},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/3412333121/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":null,"original_line":940,"side":"RIGHT","author_association":"MEMBER","original_position":22,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/3413583581","pull_request_review_id":4497519091,"id":3413583581,"node_id":"PRRC_kwDOAO6SJc7Ldybd","diff_hunk":"@@ -934,7 +937,7 @@ void ItemList::gui_input(const Ref<InputEvent> &p_event) {\n \t\t\taccept_event();\n \t\t}\n \n-\t\telse if (p_event->is_action(\"ui_up\", true)) {\n+\t\telse if (p_event->is_action(\"ui_up\", true) && (p_event->is_echo() || input->is_action_just_pressed_by_event(\"ui_up\", p_event))) {","path":"scene/gui/item_list.cpp","commit_id":"0b46c38a690bb530f8d62e89172d955dd2865ab9","original_commit_id":"0b46c38a690bb530f8d62e89172d955dd2865ab9","user":{"login":"mgiuca","id":228433,"node_id":"MDQ6VXNlcjIyODQzMw==","avatar_url":"https://avatars.githubusercontent.com/u/228433?v=4","gravatar_id":"","url":"https://api.github.com/users/mgiuca","html_url":"https://github.com/mgiuca","followers_url":"https://api.github.com/users/mgiuca/followers","following_url":"https://api.github.com/users/mgiuca/following{/other_user}","gists_url":"https://api.github.com/users/mgiuca/gists{/gist_id}","starred_url":"https://api.github.com/users/mgiuca/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/mgiuca/subscriptions","organizations_url":"https://api.github.com/users/mgiuca/orgs","repos_url":"https://api.github.com/users/mgiuca/repos","events_url":"https://api.github.com/users/mgiuca/events{/privacy}","received_events_url":"https://api.github.com/users/mgiuca/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"So there are various other elements that handle this case and they do so similarly (though like I said, they special-case joystick which I find less clean than the above, but you may disagree and I'm happy to rewrite it).\r\n\r\n**Example 1: Focus switching**: [viewport.cpp](https://github.com/godotengine/godot/blob/df6235838b63dd49f448547406e339848455c140/scene/main/viewport.cpp#L2362):\r\n\r\n```cpp\r\nif (p_event->is_action_pressed(SNAME(\"ui_down\")) && input->is_action_just_pressed_by_event(SNAME(\"ui_down\"), p_event)) {\r\n\tnext = from->_get_focus_neighbor(SIDE_BOTTOM);\r\n\tshow_focus = true;\r\n}\r\n```\r\n\r\nNote that this code has an entire block dedicated to joypad motion events, and then a separate block for other events, which handles echo and does not handle \"just_pressed\". I don't really see the point of having the same algorithm written out twice when you can just say \"just pressed or echo\" like I did here.\r\n\r\n**Example 2: OptionButton / PopupMenu**: [popup_menu.cpp](https://github.com/godotengine/godot/blob/df6235838b63dd49f448547406e339848455c140/scene/gui/popup_menu.cpp#L570):\r\n\r\n```cpp\r\nif (p_event->is_action(\"ui_down\", true) && p_event->is_pressed()) {\r\n\tif (is_joypad_event) {\r\n\t\tif (!input->is_action_just_pressed_by_event(\"ui_down\", p_event, true)) {\r\n\t\t\treturn;\r\n\t\t}\r\n\t\tjoypad_event_process = true;\r\n\t\tset_process_internal(true);\r\n\t}\r\n\t...\r\n```\r\n\r\nThis one handles both joy and key events in the same block of code, but it special-cases joypad events before checking `is_action_just_pressed_by_event`, which means it doesn't need to say \"or is_echo\". Maybe that's what you want? It feels more hacky to explicitly special-case joypad.\r\n\r\nLike I said in the initial PR, I feel like having every individual UI element (not to mention all user code - if you want to avoid this problem in your own event handlers) do some variation on the above is not a robust approach. I've got thoughts about how to solve this in a bigger picture sense, but that's more of a godot-proposals thing so I'm trying to address this immediately obvious issue first.","created_at":"2026-06-15T12:52:54Z","updated_at":"2026-06-15T12:52:54Z","html_url":"https://github.com/godotengine/godot/pull/120316#discussion_r3413583581","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/120316","_links":{"self":{"href":"https://api.github.com/repos/godotengine/godot/pulls/comments/3413583581"},"html":{"href":"https://github.com/godotengine/godot/pull/120316#discussion_r3413583581"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/120316"}},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/3413583581/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":null,"original_line":940,"side":"RIGHT","in_reply_to_id":3412333121,"author_association":"CONTRIBUTOR","original_position":22,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/3413594361","pull_request_review_id":4497531185,"id":3413594361,"node_id":"PRRC_kwDOAO6SJc7Ld1D5","diff_hunk":"@@ -53,6 +53,16 @@\n \n #include <climits>\n \n+namespace {\n+\n+bool event_is_just_pressed_or_echo(const StringName &p_action, RequiredParam<InputEvent> rp_event) {","path":"scene/gui/tree.cpp","commit_id":"0b46c38a690bb530f8d62e89172d955dd2865ab9","original_commit_id":"0b46c38a690bb530f8d62e89172d955dd2865ab9","user":{"login":"mgiuca","id":228433,"node_id":"MDQ6VXNlcjIyODQzMw==","avatar_url":"https://avatars.githubusercontent.com/u/228433?v=4","gravatar_id":"","url":"https://api.github.com/users/mgiuca","html_url":"https://github.com/mgiuca","followers_url":"https://api.github.com/users/mgiuca/followers","following_url":"https://api.github.com/users/mgiuca/following{/other_user}","gists_url":"https://api.github.com/users/mgiuca/gists{/gist_id}","starred_url":"https://api.github.com/users/mgiuca/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/mgiuca/subscriptions","organizations_url":"https://api.github.com/users/mgiuca/orgs","repos_url":"https://api.github.com/users/mgiuca/repos","events_url":"https://api.github.com/users/mgiuca/events{/privacy}","received_events_url":"https://api.github.com/users/mgiuca/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"Thanks for the tip.\r\n\r\nI feel like this could be a method on `InputEvent` rather than a private function in `Tree`. The logic is fairly difficult to reason about but applicable essentially everywhere. Would you be open to me adding it there as a method? (For now only exposed to C++, not to client code.)","created_at":"2026-06-15T12:54:43Z","updated_at":"2026-06-15T12:54:43Z","html_url":"https://github.com/godotengine/godot/pull/120316#discussion_r3413594361","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/120316","_links":{"self":{"href":"https://api.github.com/repos/godotengine/godot/pulls/comments/3413594361"},"html":{"href":"https://github.com/godotengine/godot/pull/120316#discussion_r3413594361"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/120316"}},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/3413594361/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":null,"original_line":58,"side":"RIGHT","in_reply_to_id":3412320042,"author_association":"CONTRIBUTOR","original_position":6,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/3542191389","pull_request_review_id":4652029554,"id":3542191389,"node_id":"PRRC_kwDOAO6SJc7TIY0d","diff_hunk":"@@ -53,6 +53,16 @@\n \n #include <climits>\n \n+namespace {\n+\n+bool event_is_just_pressed_or_echo(const StringName &p_action, RequiredParam<InputEvent> rp_event) {","path":"scene/gui/tree.cpp","commit_id":"0b46c38a690bb530f8d62e89172d955dd2865ab9","original_commit_id":"0b46c38a690bb530f8d62e89172d955dd2865ab9","user":{"login":"mgiuca","id":228433,"node_id":"MDQ6VXNlcjIyODQzMw==","avatar_url":"https://avatars.githubusercontent.com/u/228433?v=4","gravatar_id":"","url":"https://api.github.com/users/mgiuca","html_url":"https://github.com/mgiuca","followers_url":"https://api.github.com/users/mgiuca/followers","following_url":"https://api.github.com/users/mgiuca/following{/other_user}","gists_url":"ht