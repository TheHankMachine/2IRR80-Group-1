ult":false,"description":"","archived_at":null,"archived_by":null}],"state":"closed","locked":false,"assignees":[],"milestone":{"url":"https://api.github.com/repos/godotengine/godot/milestones/20","html_url":"https://github.com/godotengine/godot/milestone/20","labels_url":"https://api.github.com/repos/godotengine/godot/milestones/20/labels","id":10558797,"node_id":"MI_kwDOAO6SJc4AoR1N","number":20,"title":"4.4","description":"","creator":{"login":"akien-mga","id":4701338,"node_id":"MDQ6VXNlcjQ3MDEzMzg=","avatar_url":"https://avatars.githubusercontent.com/u/4701338?v=4","gravatar_id":"","url":"https://api.github.com/users/akien-mga","html_url":"https://github.com/akien-mga","followers_url":"https://api.github.com/users/akien-mga/followers","following_url":"https://api.github.com/users/akien-mga/following{/other_user}","gists_url":"https://api.github.com/users/akien-mga/gists{/gist_id}","starred_url":"https://api.github.com/users/akien-mga/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/akien-mga/subscriptions","organizations_url":"https://api.github.com/users/akien-mga/orgs","repos_url":"https://api.github.com/users/akien-mga/repos","events_url":"https://api.github.com/users/akien-mga/events{/privacy}","received_events_url":"https://api.github.com/users/akien-mga/received_events","type":"User","user_view_type":"public","site_admin":false},"open_issues":8,"closed_issues":4466,"state":"closed","created_at":"2024-02-14T11:52:07Z","updated_at":"2026-10-05T23:48:31Z","due_on":"2025-03-03T00:00:00Z","closed_at":"2025-03-19T09:35:35Z"},"comments":0,"created_at":"2025-01-17T09:18:52Z","updated_at":"2025-01-27T15:52:46Z","closed_at":"2025-01-27T15:51:15Z","assignee":null,"author_association":"NONE","issue_field_values":[],"type":null,"active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"### Tested versions\n\nReproducible in: v4.4.beta1.mono.official [d33da79d3], v4.3.rc3.mono.official [03afb92ef]\n\n### System information\n\nWindows 10 (build 19045) - Single-window, 2 monitors - Vulkan (Mobile) - dedicated NVIDIA GeForce GTX 1080 (NVIDIA; 32.0.15.6636) - Intel(R) Core(TM) i5-6600K CPU @ 3.50GHz (4 threads)\n\n### Issue description\n\nIf you write a single unicode \"[Miscellaneous Symbol](https://en.wikipedia.org/wiki/Miscellaneous_Symbols)\" in a label, the character will get an odd vertical offset in the negative Y direction.\n\n![Image](https://github.com/user-attachments/assets/0ea6bc20-5748-4036-b5fa-6e6908bd05bb)\n\nAdding a single space solves this.\n\n![Image](https://github.com/user-attachments/assets/f24d98eb-6220-42d8-8aac-cd39f5e6c362)\n\nBut this does not happen to certain other characters, for example ⛿\n\n![Image](https://github.com/user-attachments/assets/9286f180-1db2-4ba2-bc73-586a040c70f1)\n\nAt first I thought it was just unicode characters that had an emoji equivalent, but it happens to those without it as well, for example ♼ (recycling symbol)\n\n![Image](https://github.com/user-attachments/assets/c5611584-489c-46aa-a854-08662425ded1)\n\n### Steps to reproduce\n\n1. Create new project\n2. Create CanvasLayer scene, add PanelContainer as a child, add a Label as a child to the PanelContainer\n3. Write a unicode Miscellaneous Symbol as text for the Label (for example ⛺)\n\n### Minimal reproduction project (MRP)\n\n[unicode_chars_mrp.zip](https://github.com/user-attachments/files/18451807/unicode_chars_mrp.zip)","closed_by":{"login":"Repiteo","id":17489292,"node_id":"MDQ6VXNlcjE3NDg5Mjky","avatar_url":"https://avatars.githubusercontent.com/u/17489292?v=4","gravatar_id":"","url":"https://api.github.com/users/Repiteo","html_url":"https://github.com/Repiteo","followers_url":"https://api.github.com/users/Repiteo/followers","following_url":"https://api.github.com/users/Repiteo/following{/other_user}","gists_url":"https://api.github.com/users/Repiteo/gists{/gist_id}","starred_url":"https://api.github.com/users/Repiteo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Repiteo/subscriptions","organizations_url":"https://api.github.com/users/Repiteo/orgs","repos_url":"https://api.github.com/users/Repiteo/repos","events_url":"https://api.github.com/users/Repiteo/events{/privacy}","received_events_url":"https://api.github.com/users/Repiteo/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/101670/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/godotengine/godot/issues/101670/timeline","performed_via_github_app":null,"state_reason":"completed","pinned_comment":null}