[{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3565686094","html_url":"https://github.com/godotengine/godot/issues/113037#issuecomment-3565686094","issue_url":"https://api.github.com/repos/godotengine/godot/issues/113037","id":3565686094,"node_id":"IC_kwDOAO6SJc7UiA1O","user":{"login":"jitspoe","id":7751182,"node_id":"MDQ6VXNlcjc3NTExODI=","avatar_url":"https://avatars.githubusercontent.com/u/7751182?v=4","gravatar_id":"","url":"https://api.github.com/users/jitspoe","html_url":"https://github.com/jitspoe","followers_url":"https://api.github.com/users/jitspoe/followers","following_url":"https://api.github.com/users/jitspoe/following{/other_user}","gists_url":"https://api.github.com/users/jitspoe/gists{/gist_id}","starred_url":"https://api.github.com/users/jitspoe/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/jitspoe/subscriptions","organizations_url":"https://api.github.com/users/jitspoe/orgs","repos_url":"https://api.github.com/users/jitspoe/repos","events_url":"https://api.github.com/users/jitspoe/events{/privacy}","received_events_url":"https://api.github.com/users/jitspoe/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-11-22T05:21:02Z","updated_at":"2025-11-22T05:21:20Z","body":"Note: I've discovered that reimporting the .blend file in the latest Godot before saving the scene file avoids the issue.","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3565686094/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3566688021","html_url":"https://github.com/godotengine/godot/issues/113037#issuecomment-3566688021","issue_url":"https://api.github.com/repos/godotengine/godot/issues/113037","id":3566688021,"node_id":"IC_kwDOAO6SJc7Ul1cV","user":{"login":"KoBeWi","id":2223172,"node_id":"MDQ6VXNlcjIyMjMxNzI=","avatar_url":"https://avatars.githubusercontent.com/u/2223172?v=4","gravatar_id":"","url":"https://api.github.com/users/KoBeWi","html_url":"https://github.com/KoBeWi","followers_url":"https://api.github.com/users/KoBeWi/followers","following_url":"https://api.github.com/users/KoBeWi/following{/other_user}","gists_url":"https://api.github.com/users/KoBeWi/gists{/gist_id}","starred_url":"https://api.github.com/users/KoBeWi/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/KoBeWi/subscriptions","organizations_url":"https://api.github.com/users/KoBeWi/orgs","repos_url":"https://api.github.com/users/KoBeWi/repos","events_url":"https://api.github.com/users/KoBeWi/events{/privacy}","received_events_url":"https://api.github.com/users/KoBeWi/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-11-22T12:54:07Z","updated_at":"2025-11-22T12:54:07Z","body":"Try running the project upgrade tool (Project -> Tools -> Upgrade Project Files).","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3566688021/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3589392498","html_url":"https://github.com/godotengine/godot/issues/113037#issuecomment-3589392498","issue_url":"https://api.github.com/repos/godotengine/godot/issues/113037","id":3589392498,"node_id":"IC_kwDOAO6SJc7V8chy","user":{"login":"akien-mga","id":4701338,"node_id":"MDQ6VXNlcjQ3MDEzMzg=","avatar_url":"https://avatars.githubusercontent.com/u/4701338?v=4","gravatar_id":"","url":"https://api.github.com/users/akien-mga","html_url":"https://github.com/akien-mga","followers_url":"https://api.github.com/users/akien-mga/followers","following_url":"https://api.github.com/users/akien-mga/following{/other_user}","gists_url":"https://api.github.com/users/akien-mga/gists{/gist_id}","starred_url":"https://api.github.com/users/akien-mga/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/akien-mga/subscriptions","organizations_url":"https://api.github.com/users/akien-mga/orgs","repos_url":"https://api.github.com/users/akien-mga/repos","events_url":"https://api.github.com/users/akien-mga/events{/privacy}","received_events_url":"https://api.github.com/users/akien-mga/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-11-28T13:42:17Z","updated_at":"2025-11-28T13:44:37Z","body":"I ran into the same issue with the `player.tscn` scene in the TPS demo.\n\nThis can be worked around by forcing a reimport before opening in 4.6, e.g. by deleting `.godot`, which is a good idea in general when upgrading a project.\n\nBut we should see if we can mitigate this somehow as it will be hard to enforce that users do reimport all their scenes when upgrading (unless we make it automatic, but since users might jump back and forth between 4.5 and 4.6 for some time, this doesn't sound great).\n\nTagging this as a regression for now because in terms of workflow, this seems to be one. In practice this may be an intentional change and we need to figure out some better compatibility handling.","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3589392498/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3589620714","html_url":"https://github.com/godotengine/godot/issues/113037#issuecomment-3589620714","issue_url":"https://api.github.com/repos/godotengine/godot/issues/113037","id":3589620714,"node_id":"IC_kwDOAO6SJc7V9UPq","user":{"login":"KoBeWi","id":2223172,"node_id":"MDQ6VXNlcjIyMjMxNzI=","avatar_url":"https://avatars.githubusercontent.com/u/2223172?v=4","gravatar_id":"","url":"https://api.github.com/users/KoBeWi","html_url":"https://github.com/KoBeWi","followers_url":"https://api.github.com/users/KoBeWi/followers","following_url":"https://api.github.com/users/KoBeWi/following{/other_user}","gists_url":"https://api.github.com/users/KoBeWi/gists{/gist_id}","starred_url":"https://api.github.com/users/KoBeWi/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/KoBeWi/subscriptions","organizations_url":"https://api.github.com/users/KoBeWi/orgs","repos_url":"https://api.github.com/users/KoBeWi/repos","events_url":"https://api.github.com/users/KoBeWi/events{/privacy}","received_events_url":"https://api.github.com/users/KoBeWi/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-11-28T14:54:34Z","updated_at":"2025-11-28T14:55:20Z","body":"So does running the upgrade tool fix it or not? Deleting `.godot` folder shouldn't be required. And even if you need to delete something, removing only `.godot/imported` should suffice (this way your editor data won't get reset).","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3589620714/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3590653223","html_url":"https://github.com/godotengine/godot/issues/113037#issuecomment-3590653223","issue_url":"https://api.github.com/repos/godotengine/godot/issues/113037","id":3590653223,"node_id":"IC_kwDOAO6SJc7WBQUn","user":{"login":"TokageItLab","id":61938263,"node_id":"MDQ6VXNlcjYxOTM4MjYz","avatar_url":"https://avatars.githubusercontent.com/u/61938263?v=4","gravatar_id":"","url":"https://api.github.com/users/TokageItLab","html_url":"https://github.com/TokageItLab","followers_url":"https://api.github.com/users/TokageItLab/followers","following_url":"https://api.github.com/users/TokageItLab/following{/other_user}","gists_url":"https://api.github.com/users/TokageItLab/gists{/gist_id}","starred_url":"https://api.github.com/users/TokageItLab/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/TokageItLab/subscriptions","organizations_url":"https://api.github.com/users/TokageItLab/orgs","repos_url":"https://api.github.com/users/TokageItLab/repos","events_url":"https://api.github.com/users/TokageItLab/events{/privacy}","received_events_url":"https://api.github.com/users/TokageItLab/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-11-28T22:45:21Z","updated_at":"2025-11-30T18:52:12Z","body":"The issue is that the `.scn` files under `.godot/imported` use an older serialization format, so the property paths for the newly serialized new `.tscn/.scn` files cannot be found within the old `.scn` files.\n\nTherefore, updating only the old  `.scn` files by using such upgrade tool is the straightforward approach.\n\nAlternatively, one could consider adding spacial case handling as compatibility code in the locations where new `.tscn/.scn` and old `.scn` property paths are compared, but it's unclear where this would be appropriate...maybe any finding function in `editor_node.cpp` ?","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3590653223/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3632461816","html_url":"https://github.com/godotengine/godot/issues/113037#issuecomment-3632461816","issue_url":"https://api.github.com/repos/godotengine/godot/issues/113037","id":3632461816,"node_id":"IC_kwDOAO6SJc7Ygvf4","user":{"login":"KoBeWi","id":2223172,"node_id":"MDQ6VXNlcjIyMjMxNzI=","avatar_url":"https://avatars.githubusercontent.com/u/2223172?v=4","gravatar_id":"","url":"https://api.github.com/users/KoBeWi","html_url":"https://github.com/KoBeWi","followers_url":"https://api.github.com/users/KoBeWi/followers","following_url":"https://api.github.com/users/KoBeWi/following{/other_user}","gists_url":"https://api.github.com/users/KoBeWi/gists{/gist_id}","starred_url":"https://api.github.com/users/KoBeWi/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/KoBeWi/subscriptions","organizations_url":"https://api.github.com/users/KoBeWi/orgs","repos_url":"https://api.github.com/users/KoBeWi/repos","events_url":"https://api.github.com/users/KoBeWi/events{/privacy}","received_events_url":"https://api.github.com/users/KoBeWi/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-12-09T14:10:04Z","updated_at":"2025-12-09T14:10:04Z","body":"> So does running the upgrade tool fix it or not?\n\nI tried verifying it myself, but I can't open the MRP in 4.5 xd The editor just freezes on import.","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3632461816/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3639411867","html_url":"https://github.com/godotengine/godot/issues/113037#issuecomment-3639411867","issue_url":"https://api.github.com/repos/godotengine/godot/issues/113037","id":3639411867,"node_id":"IC_kwDOAO6SJc7Y7QSb","user":{"login":"TokageItLab","id":61938263,"node_id":"MDQ6VXNlcjYxOTM4MjYz","avatar_url":"https://avatars.githubusercontent.com/u/61938263?v=4","gravatar_id":"","url":"https://api.github.com/users/TokageItLab","html_url":"https://github.com/TokageItLab","followers_url":"https://api.github.com/users/TokageItLab/followers","following_url":"https://api.github.com/users/TokageItLab/following{/other_user}","gists_url":"https://api.github.com/users/TokageItLab/gists{/gist_id}","starred_url":"https://api.github.com/users/TokageItLab/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/TokageItLab/subscriptions","organizations_url":"https://api.github.com/users/TokageItLab/orgs","repos_url":"https://api.github.com/users/TokageItLab/repos","events_url":"https://api.github.com/users/TokageItLab/events{/privacy}","received_events_url":"https://api.github.com/users/TokageItLab/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-12-10T23:52:15Z","updated_at":"2025-12-10T23:53:58Z","body":"Here is saved by 4.5.stable with .godot. And I confirmed upgrade tool fix it.\n[test-editable-children-animation.zip](https://github.com/user-attachments/files/24090122/test-editable-children-animation.zip)","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3639411867/reactions","total_count":2,"+1":2,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3733777463","html_url":"https://github.com/godotengine/godot/issues/113037#issuecomment-3733777463","issue_url":"https://api.github.com/repos/godotengine/godot/issues/113037","id":3733777463,"node_id":"IC_kwDOAO6SJc7ejOw3","user":{"login":"Clubhouse1661","id":177586398,"node_id":"U_kgDOCpXA3g","avatar_url":"https://avatars.githubusercontent.com/u/177586398?v=4","gravatar_id":"","url":"https://api.github.com/users/Clubhouse1661","html_url":"https://github.com/Clubhouse1661","followers_url":"https://api.github.com/users/Clubhouse1661/followers","following_url":"https://api.github.com/users/Clubhouse1661/following{/other_user}","gists_url":"https://api.github.com/users/Clubhouse1661/gists{/gist_id}","starred_url":"https://api.github.com/users/Clubhouse1661/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Clubhouse1661/subscriptions","organizations_url":"https://api.github.com/users/Clubhouse1661/orgs","repos_url":"https://api.github.com/users/Clubhouse1661/repos","events_url":"https://api.github.com/users/Clubhouse1661/events{/privacy}","received_events_url":"https://api.github.com/users/Clubhouse1661/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-01-11T01:04:17Z","updated_at":"2026-01-11T01:19:22Z","body":"I've implemented a fix following @TokageItLab's suggested approach of adding compatibility code for the property path comparison.\n\n**Fix:**\nAdded backwards compatibility handling in `SceneState::get_property_value()` (scene/resources/packed_scene.cpp). When looking for `libraries/<name>` and not finding it, the code now checks for the old `libraries` Dictionary property and extracts the value from there.\n\nPR: https://github.com/godotengine/godot/pull/114844\n\nTested with the MRP. After the fix, saving the scene no longer duplicates animation data into the `.tscn` file.\n\nhttps://github.com/user-attachments/assets/19ad1c35-512f-47a8-a272-6da37e04115c\n\nhttps://github.com/user-attachments/assets/91e60c40-1a20-494c-b4c0-9ba25f5775df","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3733777463/reactions","total_count":3,"+1":3,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3734418126","html_url":"https://github.com/godotengine/godot/issues/113037#issuecomment-3734418126","issue_url":"https://api.github.com/repos/godotengine/godot/issues/113037","id":3734418126,"node_id":"IC_kwDOAO6SJc7elrLO","user":{"login":"jitspoe","id":7751182,"node_id":"MDQ6VXNlcjc3NTExODI=","avatar_url":"https://avatars.githubusercontent.com/u/7751182?v=4","gravatar_id":"","url":"https://api.github.com/users/jitspoe","html_url":"https://github.com/jitspoe","followers_url":"https://api.github.com/users/jitspoe/followers","following_url":"https://api.github.com/users/jitspoe/following{/other_user}","gists_url":"https://api.github.com/users/jitspoe/gists{/gist_id}","starred_url":"https://api.github.com/users/jitspoe/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/jitspoe/subscriptions","organizations_url":"https://api.github.com/users/jitspoe/orgs","repos_url":"https://api.github.com/users/jitspoe/repos","events_url":"https://api.github.com/users/jitspoe/events{/privacy}","received_events_url":"https://api.github.com/users/jitspoe/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-01-11T11:22:19Z","updated_at":"2026-01-11T11:22:19Z","body":"Awesome!  Thanks for doing this!  Hopefully this gets in for 4.6 final so people updating don't get bitten by this.","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3734418126/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null}]