ved_by":null},{"id":279098255,"node_id":"MDU6TGFiZWwyNzkwOTgyNTU=","url":"https://api.github.com/repos/godotengine/godot/labels/topic:platforms","name":"topic:platforms","color":"ffee88","default":false,"description":"","archived_at":null,"archived_by":null},{"id":572781997,"node_id":"MDU6TGFiZWw1NzI3ODE5OTc=","url":"https://api.github.com/repos/godotengine/godot/labels/topic:audio","name":"topic:audio","color":"ffee88","default":false,"description":"","archived_at":null,"archived_by":null}],"state":"open","locked":false,"assignees":[],"milestone":{"url":"https://api.github.com/repos/godotengine/godot/milestones/16","html_url":"https://github.com/godotengine/godot/milestone/16","labels_url":"https://api.github.com/repos/godotengine/godot/milestones/16/labels","id":8237783,"node_id":"MI_kwDOAO6SJc4AfbLX","number":16,"title":"4.x","description":"Issues and pull requests slated for an undetermined Godot 4 release.","creator":{"login":"akien-mga","id":4701338,"node_id":"MDQ6VXNlcjQ3MDEzMzg=","avatar_url":"https://avatars.githubusercontent.com/u/4701338?v=4","gravatar_id":"","url":"https://api.github.com/users/akien-mga","html_url":"https://github.com/akien-mga","followers_url":"https://api.github.com/users/akien-mga/followers","following_url":"https://api.github.com/users/akien-mga/following{/other_user}","gists_url":"https://api.github.com/users/akien-mga/gists{/gist_id}","starred_url":"https://api.github.com/users/akien-mga/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/akien-mga/subscriptions","organizations_url":"https://api.github.com/users/akien-mga/orgs","repos_url":"https://api.github.com/users/akien-mga/repos","events_url":"https://api.github.com/users/akien-mga/events{/privacy}","received_events_url":"https://api.github.com/users/akien-mga/received_events","type":"User","user_view_type":"public","site_admin":false},"open_issues":5791,"closed_issues":0,"state":"open","created_at":"2022-07-26T12:42:05Z","updated_at":"2026-10-21T22:40:26Z","due_on":null,"closed_at":null},"comments":2,"created_at":"2026-03-22T23:09:31Z","updated_at":"2026-04-16T22:27:40Z","closed_at":null,"assignee":null,"author_association":"CONTRIBUTOR","issue_field_values":[],"type":null,"active_lock_reason":null,"draft":false,"pull_request":{"url":"https://api.github.com/repos/godotengine/godot/pulls/117741","html_url":"https://github.com/godotengine/godot/pull/117741","diff_url":"https://github.com/godotengine/godot/pull/117741.diff","patch_url":"https://github.com/godotengine/godot/pull/117741.patch","merged_at":null},"body":"Should support all AudioDriver features, aside from setting input / output devices. This dynamically loads the library for sndio using a wrapper if `so_wrap` is enabled at build time, which I believe was the blocker for #51426 .\r\n\r\nI used https://github.com/Kaleb-Reid/dynload-wrapper (https://github.com/hpvb/dynload-wrapper/pull/9) to generate the wrapper so that the library can be found on OpenBSD.\r\n\r\nCurrently two threads run, one for output and one for input. The input thread only runs when input is enabled. The threads block until output buffer space / input frames are available, but I noticed that this is not how the other drivers work and so if it is preferred that only one thread is created which polls for both output buffer space and input frames I can probably change it.\r\n\r\nI haven't figured out how to get a list of available devices provided by sndio, so currently the only available device is `Default`. This is not as big of an issue as it may seem given that `Default` sets the devices based on the environment variables `AUDIORECDEVICE`, `AUDIOPLAYDEVICE`, and `AUDIODEVICE`.\r\n\r\nCloses https://github.com/godotengine/godot-proposals/issues/3097\r\n\r\nSupersedes #51426","closed_by":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/117741/reactions","total_count":1,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":1},"timeline_url":"https://api.github.com/repos/godotengine/godot/issues/117741/timeline","performed_via_github_app":null,"state_reason":null}