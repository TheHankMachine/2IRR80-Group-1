teo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Repiteo/subscriptions","organizations_url":"https://api.github.com/users/Repiteo/orgs","repos_url":"https://api.github.com/users/Repiteo/repos","events_url":"https://api.github.com/users/Repiteo/events{/privacy}","received_events_url":"https://api.github.com/users/Repiteo/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"","state":"CHANGES_REQUESTED","html_url":"https://github.com/godotengine/godot/pull/113224#pullrequestreview-5009729378","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/113224","author_association":"CONTRIBUTOR","_links":{"html":{"href":"https://github.com/godotengine/godot/pull/113224#pullrequestreview-5009729378"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/113224"}},"submitted_at":"2026-08-24T15:40:52Z","commit_id":"93331b1fb692922e69031eec86f00dbb06553374"},{"id":5174475157,"node_id":"PRR_kwDOAO6SJc8AAAABNGw5lQ","user":{"login":"ColinSORourke","id":44822820,"node_id":"MDQ6VXNlcjQ0ODIyODIw","avatar_url":"https://avatars.githubusercontent.com/u/44822820?u=a3ed7540f46720cbf73f01b590fd1ef225d39344&v=4","gravatar_id":"","url":"https://api.github.com/users/ColinSORourke","html_url":"https://github.com/ColinSORourke","followers_url":"https://api.github.com/users/ColinSORourke/followers","following_url":"https://api.github.com/users/ColinSORourke/following{/other_user}","gists_url":"https://api.github.com/users/ColinSORourke/gists{/gist_id}","starred_url":"https://api.github.com/users/ColinSORourke/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/ColinSORourke/subscriptions","organizations_url":"https://api.github.com/users/ColinSORourke/orgs","repos_url":"https://api.github.com/users/ColinSORourke/repos","events_url":"https://api.github.com/users/ColinSORourke/events{/privacy}","received_events_url":"https://api.github.com/users/ColinSORourke/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"","state":"COMMENTED","html_url":"https://github.com/godotengine/godot/pull/113224#pullrequestreview-5174475157","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/113224","author_association":"CONTRIBUTOR","_links":{"html":{"href":"https://github.com/godotengine/godot/pull/113224#pullrequestreview-5174475157"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/113224"}},"submitted_at":"2026-09-11T02:37:56Z","commit_id":"93331b1fb692922e69031eec86f00dbb06553374"},{"id":5181743635,"node_id":"PRR_kwDOAO6SJc8AAAABNNsiEw","user":{"login":"Calinou","id":180032,"node_id":"MDQ6VXNlcjE4MDAzMg==","avatar_url":"https://avatars.githubusercontent.com/u/180032?u=68d23e7ee9cdf810da125e8510b72f845b9dccc8&v=4","gravatar_id":"","url":"https://api.github.com/users/Calinou","html_url":"https://github.com/Calinou","followers_url":"https://api.github.com/users/Calinou/followers","following_url":"https://api.github.com/users/Calinou/following{/other_user}","gists_url":"https://api.github.com/users/Calinou/gists{/gist_id}","starred_url":"https://api.github.com/users/Calinou/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Calinou/subscriptions","organizations_url":"https://api.github.com/users/Calinou/orgs","repos_url":"https://api.github.com/users/Calinou/repos","events_url":"https://api.github.com/users/Calinou/events{/privacy}","received_events_url":"https://api.github.com/users/Calinou/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"Tested locally (rebased on top of `master`), it works as expected. Code looks good to me.\n\nThat said, I echo @KoBeWi's sentiment that there should be an editor setting to disable the automatic \"vital updates only\" switch when running the project. It can be disruptive not only for live editing, but also if you want to play animations in the editor while the project is running (pressing Play will appear to do nothing otherwise).\n\n@QbieShay I'm curious about your thoughts on this, since you work a lot on VFX.\n\n## Benchmark\n\n<details open>\n\n<summary>PC specifications</summary>\n\n- **CPU:** AMD Ryzen 9 9950X3D\n- **GPU:** NVIDIA GeForce RTX 5090\n- **RAM:** 64 GB (2×32 GB DDR5-6000 CL30)\n- **SSD:** Solidigm P44 Pro 2 TB\n- **OS:** Linux (Fedora 44)\n</details>\n\nOn the TPS demo, running the project in non-exclusive fullscreen with `level.tscn` open in the editor (same camera perspective in both). The scene is GPU-bound:\n\nBefore | After\n-|-\n245 FPS (4.08 mspf) | 253 FPS (3.95 mspf)\n\nThe editor is normally capped at 10 FPS when it's unfocused, so this only provides a slight boost to in-game performance, but still it's non-negligible and should help with battery life on mobile devices. The performance boost will be much more significant if you changed **Unfocused Low Processor Mode Sleep Usec** from its default.","state":"COMMENTED","html_url":"https://github.com/godotengine/godot/pull/113224#pullrequestreview-5181743635","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/113224","author_association":"MEMBER","_links":{"html":{"href":"https://github.com/godotengine/godot/pull/113224#pullrequestreview-5181743635"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/113224"}},"submitted_at":"2026-09-11T17:41:08Z","commit_id":"68b861e4e2056840c6ef2e9bdcb981d60c61611d"},{"id":5226880232,"node_id":"PRR_kwDOAO6SJc8AAAABN4vc6A","user":{"login":"Calinou","id":180032,"node_id":"MDQ6VXNlcjE4MDAzMg==","avatar_url":"https://avatars.githubusercontent.com/u/180032?u=68d23e7ee9cdf810da125e8510b72f845b9dccc8&v=4","gravatar_id":"","url":"https://api.github.com/users/Calinou","html_url":"https://github.com/Calinou","followers_url":"https://api.github.com/users/Calinou/followers","following_url":"https://api.github.com/users/Calinou/following{/other_user}","gists_url":"https://api.github.com/users/Calinou/gists{/gist_id}","starred_url":"https://api.github.com/users/Calinou/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Calinou/subscriptions","organizations_url":"https://api.github.com/users/Calinou/orgs","repos_url":"https://api.github.com/users/Calinou/repos","events_url":"https://api.github.com/users/Calinou/events{/privacy}","received_events_url":"https://api.github.com/users/Calinou/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"Works great now 🙂 \r\n\r\nThe editor setting to use vital updates only when the project is running is disabled by default, which I think better matches user expectations and avoids surprises on upgrading.","state":"APPROVED","html_url":"https://github.com/godotengine/godot/pull/113224#pullrequestreview-5226880232","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/113224","author_association":"MEMBER","_links":{"html":{"href":"https://github.com/godotengine/godot/pull/113224#pullrequestreview-5226880232"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/113224"}},"submitted_at":"2026-09-16T18:41:54Z","commit_id":"f3322085cca148b4bb7f74c04cb458757ab01802"}]