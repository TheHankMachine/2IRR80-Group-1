orce/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Ivorforce/subscriptions","organizations_url":"https://api.github.com/users/Ivorforce/orgs","repos_url":"https://api.github.com/users/Ivorforce/repos","events_url":"https://api.github.com/users/Ivorforce/events{/privacy}","received_events_url":"https://api.github.com/users/Ivorforce/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2024-11-28T23:57:51Z","updated_at":"2024-11-28T23:57:51Z","body":"I'm putting implementation of this PR on ice.\r\n\r\nIt was looking very promising, but at the very end implicit conversions to `String` and `StringName` prevented the completion of the feature. I've opened https://github.com/godotengine/godot-proposals/issues/11257 and https://github.com/godotengine/godot-proposals/issues/11258 to address the specific issues I was running into.\r\n\r\nWhen some preliminary work has been done, i hope to be able to continue work on this PR.","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2506863719/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2508253583","html_url":"https://github.com/godotengine/godot/pull/99806#issuecomment-2508253583","issue_url":"https://api.github.com/repos/godotengine/godot/issues/99806","id":2508253583,"node_id":"IC_kwDOAO6SJc6VgOmP","user":{"login":"adamscott","id":270928,"node_id":"MDQ6VXNlcjI3MDkyOA==","avatar_url":"https://avatars.githubusercontent.com/u/270928?v=4","gravatar_id":"","url":"https://api.github.com/users/adamscott","html_url":"https://github.com/adamscott","followers_url":"https://api.github.com/users/adamscott/followers","following_url":"https://api.github.com/users/adamscott/following{/other_user}","gists_url":"https://api.github.com/users/adamscott/gists{/gist_id}","starred_url":"https://api.github.com/users/adamscott/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/adamscott/subscriptions","organizations_url":"https://api.github.com/users/adamscott/orgs","repos_url":"https://api.github.com/users/adamscott/repos","events_url":"https://api.github.com/users/adamscott/events{/privacy}","received_events_url":"https://api.github.com/users/adamscott/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2024-11-29T18:19:47Z","updated_at":"2024-11-29T18:19:47Z","body":"Hello @Ivorforce ! I hope you're doing well.\r\n\r\nThe release team found out that you were updating your PR a lot lately. Could you add a tag in your commit message when CI checks are not needed? (see https://docs.github.com/en/actions/managing-workflow-runs-and-deployments/managing-workflow-runs/skipping-workflow-runs)\r\n\r\nIt's because each time you push an update, even a tiny one, it triggers full CI checks. 😅 ","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2508253583/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2508373462","html_url":"https://github.com/godotengine/godot/pull/99806#issuecomment-2508373462","issue_url":"https://api.github.com/repos/godotengine/godot/issues/99806","id":2508373462,"node_id":"IC_kwDOAO6SJc6Vgr3W","user":{"login":"Ivorforce","id":2308167,"node_id":"MDQ6VXNlcjIzMDgxNjc=","avatar_url":"https://avatars.githubusercontent.com/u/2308167?v=4","gravatar_id":"","url":"https://api.github.com/users/Ivorforce","html_url":"https://github.com/Ivorforce","followers_url":"https://api.github.com/users/Ivorforce/followers","following_url":"https://api.github.com/users/Ivorforce/following{/other_user}","gists_url":"https://api.github.com/users/Ivorforce/gists{/gist_id}","starred_url":"https://api.github.com/users/Ivorforce/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Ivorforce/subscriptions","organizations_url":"https://api.github.com/users/Ivorforce/orgs","repos_url":"https://api.github.com/users/Ivorforce/repos","events_url":"https://api.github.com/users/Ivorforce/events{/privacy}","received_events_url":"https://api.github.com/users/Ivorforce/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2024-11-29T19:01:42Z","updated_at":"2024-11-29T19:01:42Z","body":"Yep, sorry, will do!","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2508373462/reactions","total_count":1,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":1,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2509895072","html_url":"https://github.com/godotengine/godot/pull/99806#issuecomment-2509895072","issue_url":"https://api.github.com/repos/godotengine/godot/issues/99806","id":2509895072,"node_id":"IC_kwDOAO6SJc6VmfWg","user":{"login":"Ivorforce","id":2308167,"node_id":"MDQ6VXNlcjIzMDgxNjc=","avatar_url":"https://avatars.githubusercontent.com/u/2308167?v=4","gravatar_id":"","url":"https://api.github.com/users/Ivorforce","html_url":"https://github.com/Ivorforce","followers_url":"https://api.github.com/users/Ivorforce/followers","following_url":"https://api.github.com/users/Ivorforce/following{/other_user}","gists_url":"https://api.github.com/users/Ivorforce/gists{/gist_id}","starred_url":"https://api.github.com/users/Ivorforce/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Ivorforce/subscriptions","organizations_url":"https://api.github.com/users/Ivorforce/orgs","repos_url":"https://api.github.com/users/Ivorforce/repos","events_url":"https://api.github.com/users/Ivorforce/events{/privacy}","received_events_url":"https://api.github.com/users/Ivorforce/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2024-12-01T16:08:35Z","updated_at":"2024-12-01T17:12:47Z","body":"Tests are finally passing (locally anyway)! \r\n\r\nI managed to salvage this PR by doing less at once. The core is still the same - implicit conversions from `char *` to `String` are soft-deprecated (and implicit conversions from `CharString and Char16String to ptr), while implicit construction from string literal to String remains legal.\r\n\r\nThe `strlen` calls in the 'String from String Literal' constructors are resolved at compile time, as can be seen here: [https://godbolt.org/z/aTv61TT1K](https://godbolt.org/z/aTv61TT1K). I first tried to use the `len` template parameter, but realized that some string literals are implicitly ended with `NULL` while others aren't. Calling `strlen` at compile time should be the safest route to go, and it shows because without it the tests weren't passing 😅\r\n\r\nAll in all, this PR should slightly speed up conversion from string literal to `String`, and allow us to move more toward explicitness and no NULL termination reliance in Strings. When / If it gets merged, I will likely add follow-up PRs to explicitize implicit conversions throughout the codebase.\r\n\r\nI recommend merging https://github.com/godotengine/godot/pull/99816 and https://github.com/godotengine/godot/pull/99817 before this one because this change includes the former ones, making the changelog more granular.\r\n\r\nEdit: One test is failing, I think that's just caches though?","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2509895072/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2510221854","html_url":"https://github.com/godotengine/godot/pull/99806#issuecomment-2510221854","issue_url":"https://api.github.com/repos/godotengine/godot/issues/99806","id":2510221854,"node_id":"IC_kwDOAO6SJc6VnvIe","user":{"login":"Repiteo","id":17489292,"node_id":"MDQ6VXNlcjE3NDg5Mjky","avatar_url":"https://avatars.githubusercontent.com/u/17489292?v=4","gravatar_id":"","url":"https://api.github.com/users/Repiteo","html_url":"https://github.com/Repiteo","followers_url":"https://api.github.com/users/Repiteo/followers","following_url":"https://api.github.com/users/Repiteo/following{/other_user}","gists_url":"https://api.github.com/users/Repiteo/gists{/gist_id}","starred_url":"https://api.github.com/users/Repiteo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Repiteo/subscriptions","organizations_url":"https://api.github.com/users/Repiteo/orgs","repos_url":"https://api.github.com/users/Repiteo/repos","events_url":"https://api.github.com/users/Repiteo/events{/privacy}","received_events_url":"https://api.github.com/users/Repiteo/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2024-12-01T19:38:39Z","updated_at":"2024-12-01T19:38:39Z","body":"Holy shit, you have no idea how cathartic it is to see someone else take an interest in this topic. I'm 100% onboard with modernizing our strings to not rely on null-termination, especially considering `\\0` is a perfectly valid Unicode codepoint (for better or for worse)","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2510221854/reactions","total_count":4,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":4,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2510332862","html_url":"https://github.com/godotengine/godot/pull/99806#issuecomment-2510332862","issue_url":"https://api.github.com/repos/godotengine/godot/issues/99806","id":2510332862,"node_id":"IC_kwDOAO6SJc6VoKO-","user":{"login":"Ivorforce","id":2308167,"node_id":"MDQ6VXNlcjIzMDgxNjc=","avatar_url":"https://avatars.githubusercontent.com/u/2308167?v=4","gravatar_id":"","url":"https://api.github.com/users/Ivorforce","html_url":"https://github.com/Ivorforce","followers_url":"https://api.github.com/users/Ivorforce/followers","following_url":"https://api.github.com/users/Ivorforce/following{/other_user}","gists_url":"https://api.github.com/users/Ivorforce/gists{/gist_id}","starred_url":"https://api.github.com/users/Ivorforce/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Ivorforce/subscriptions","organizations_url":"https://api.github.com/users/Ivorforce/orgs","repos_url":"https://api.github.com/users/Ivorforce/repos","events_url":"https://api.github.com/users/Ivorforce/events{/privacy}","received_events_url":"https://api.github.com/users/Ivorforce/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2024-12-02T00:27:11Z","updated_at":"2024-12-02T00:57:41Z","body":"I made a synthetic performance benchmark: https://onlinegdb.com/rzGUA045Ry\r\n\r\nThis PR is not about performance, but I wanted to check anyway, since some string creators already automatically select the static length constructor with this PR. The speed gain is not very consistent (it's more consistent offline); unscientifically i would estimate it's about 9% for short length strings, 5% for medium length strings, and 4% for long length strings such as from [canvas.glsl.gen.h](https://gist.github.com/Ivorforce/7b0402a394c76224d70bb71ddce2933d#file-canvas-glsl-gen-h-L1380).\r\n","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2510332862/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2510386206","html_url":"https://github.com/godotengine/godot/pull/99806#issuecomment-2510386206","issue_url":"https://api.github.com/repos/godotengine/godot/issues/99806","id":2510386206,"node_id":"IC_kwDOAO6SJc6VoXQe","user":{"login":"fire","id":32321,"node_id":"MDQ6VXNlcjMyMzIx","avatar_url":"https://avatars.githubusercontent.com/u/32321?v=4","gravatar_id":"","url":"https://api.github.com/users/fire","html_url":"https://github.com/fire","followers_url":"https://api.github.com/users/fire/followers","following_url":"https://api.github.com/users/fire/following{/other_user}","gists_url":"https://api.github.com/users/fire/gists{/gist_id}","starred_url":"https://api.github.com/users/fire/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/fire/subscriptions","organizations_url":"https://api.github.com/users/fire/orgs","repos_url":"https://api.github.com/users/fire/repos","events_url":"https://api.github.com/users/fire/events{/privacy}","received_events_url":"https://api.github.com/users/fire/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2024-12-02T01:36:16Z","updated_at":"2024-12-02T01:36:16Z","body":"I'll bump the build, but I don't think it's a cache thing.\r\n\r\n```\r\ndrivers.windows.editor.x86_64.lib(feed_effects.windows.editor.x86_64.obj) : error LNK2019: unresolved external symbol \"public: __cdecl String::String(char const *)\" (??0String@@QEAA@PEBD@Z) referenced in function \"public: __cdecl GLES3::FeedEffects::FeedEffects(void)\" (??0FeedEffects@GLES3@@QEAA@XZ)\r\nbin\\godot.windows.editor.x86_64.exe : fatal error LNK1120: 1 unresolved externals\r\n```","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2510386206/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2511427810","html_url":"https://github.com/godotengine/godot/pull/99806#issuecomment-2511427810","issue_url":"https://api.github.com/repos/godotengine/godot/issues/99806","id":2511427810,"node_id":"IC_kwDOAO6SJc6VsVji","user":{"login":"Ivorforce","id":2308167,"node_id":"MDQ6VXNlcjIzMDgxNjc=","avatar_url":"https://avatars.githubusercontent.com/u/2308167?v=4","gravatar_id":"","url":"https://api.github.com/users/Ivorforce","html_url":"https://github.com/Ivorforce","followers_url":"https://api.github.com/users/Ivorforce/followers","following_url":"https://api.github.com/users/Ivorforce/following{/other_user}","gists_url":"https://api.github.com/users/Ivorforce/gists{/gist_id}","starred_url":"https://api.github.com/users/Ivorforce/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Ivorforce/subscriptions","organizations_url":"https://api.github.com/users/Ivorforce/orgs","repos_url":"https://api.github.com/users/Ivorforce/repos","events_url":"https://api.github.com/users/Ivorforce/events{/privacy}","received_events_url":"https://api.github.com/users/Ivorforce/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2024-12-02T12:36:40Z","updated_at":"2024-12-02T14:53:58Z","body":"> I'll bump the build, but I don't think it's a cache thing.\r\n\r\nThanks! But I don't think that helped. `feed_effects.cpp` wasn't recompiled in these builds, and since it's referencing a function I removed, I suspect it's failing because MSVC / scons fails to detect it needs to recompile the file in question.\r\nIn lack of a better alternative, I'll touch the module to force it to rebuild, and if it succeeds, I'll remove the unneeded change again.\r\n\r\nEdit: Looks like i was right, the [builds are passing](https://github.com/Ivorforce/godot/actions/runs/12119491050) with the cache for `feed_effects` wiped. Unfortunately, the cache resets and the file fails to build again if I remove the change. I'll keep the file touched for the build to pass. I don't think there's a way around keeping the comment in-place with a merge; otherwise we'll just get the same issue again with branches that do not have the changes from this PR yet and thus experience incompatibility across this cache. I'm in talks with SCons maintainers to look into this issue.","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2511427810/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2512769070","html_url":"https://github.com/godotengine/godot/pull/99806#issuecomment-2512769070","issue_url":"https://api.github.com/repos/godotengine/godot/issues/99806","id":2512769070,"node_id":"IC_kwDOAO6SJc6VxdAu","user":{"login":"adamscott","id":270928,"node_id":"MDQ6VXNlcjI3MDkyOA==","avatar_url":"https://avatars.githubusercontent.com/u/270928?v=4","gravatar_id":"","url":"https://api.github.com/users/adamscott","html_url":"https://github.com/adamscott","followers_url":"https://api.github.com/users/adamscott/followers","following_url":"https://api.github.com/users/adamscott/following{/other_user}","gists_url":"https://api.github.com/users/adamscott/gists{/gist_id}","starred_url":"https://api.github.com/users/adamscott/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/adamscott/subscriptions","organizations_url":"https://api.github.com/users/adamscott/orgs","repos_url":"https://api.github.com/users/adamscott/repos","events_url":"https://api.github.com/users/adamscott/events{/privacy}","received_events_url":"https://api.github.com/users/adamscott/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2024-12-02T20:38:20Z","updated_at":"2024-12-02T20:38:20Z","body":"@Calinou We don't have a pure `String` benchmark test, haven't we?","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2512769070/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2514662276","html_url":"https://github.com/godotengine/godot/pull/99806#issuecomment-2514662276","issue_url":"https://api.github.com/repos/godotengine/godot/issues/99806","id":2514662276,"node_id":"IC_kwDOAO6SJc6V4rOE","user":{"login":"Ivorforce","id":2308167,"node_id":"MDQ6VXNlcjIzMDgxNjc=","avatar_url":"https://avatars.githubusercontent.com/u/2308167?v=4","gravatar_id":"","url":"https://api.github.com/users/Ivorforce","html_url":"https://github.com/Ivorforce","followers_url":"https://api.github.com/users/Ivorforce/followers","following_url":"https://api.github.com/users/Ivorforce/following{/other_user}","gists_url":"https://api.github.com/users/Ivorforce/gists{/gist_id}","starred_url":"https://api.github.com/users/Ivorforce/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Ivorforce/subscriptions","organizations_url":"https://api.github.com/users/Ivorforce/orgs","repos_url":"https://api.github.com/users/Ivorforce/repos","events_url":"https://api.github.com/users/Ivorforce/events{/privacy}","received_events_url":"https://api.github.com/users/Ivorforce/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2024-12-03T14:09:18Z","updated_at":"2024-12-03T14:35:02Z","body":"Existing benchmarks are a good idea actually! I tested this branch against `Godot 4.3` (`old`) and https://github.com/godotengine/godot/pull/99816 and got these results:\r\n\r\n![results-plot](https://github.com/user-attachments/assets/ad228c8f-81e7-4c93-9a0f-2a3101d21787)\r\n\r\nResults are mostly beneffitting from https://github.com/godotengine/godot/pull/99816, since this PR is based on that one (and a few others that were merged since 4.3, like #92548). Compile-time string allocation is not accelerated from GDExtension (yet) since no interface for it is available. Still, there is some gain from those static strings too.\r\n\r\nBut yeah, again, this is not primarily a speed PR. Some static strings are likely to benefit, but mostly it's about being explicit with `NULL` termination, which should help us _avoid_ performance issues and potential bugs.\r\n","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2514662276/reactions","total_count":3,"+1":2,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":1,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2524747123","html_url":"https://github.com/godotengine/godot/pull/99806#issuecomment-2524747123","issue_url":"https://api.github.com/repos/godotengine/godot/issues/99806","id":2524747123,"node_id":"IC_kwDOAO6SJc6WfJVz","user":{"login":"Ivorforce","id":2308167,"node_id":"MDQ6VXNlcjIzMDgxNjc=","avatar_url":"https://avatars.githubusercontent.com/u/2308167?v=4","gravatar_id":"","url":"https://api.github.com/users/Ivorforce","html_url":"https://github.com/Ivorforce","followers_url":"https://api.github.com/users/Ivorforce/followers","following_url":"https://api.github.com/users/Ivorforce/following{/other_user}","gists_url":"https://api.github.com/users/Ivorforce/gists{/gist_id}","starred_url":"https://api.github.com/users/Ivorforce/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Ivorforce/subscriptions","organizations_url":"https://api.github.com/users/Ivorforce/orgs","repos_url":"https://api.github.com/users/Ivorforce/repos","events_url":"https://api.github.com/users/Ivorforce/events{/privacy}","received_events_url":"https://api.github.com/users/Ivorforce/received_events","type":"User","user_view_type":"public"