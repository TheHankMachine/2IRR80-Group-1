[{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2573562216","html_url":"https://github.com/godotengine/godot/issues/100732#issuecomment-2573562216","issue_url":"https://api.github.com/repos/godotengine/godot/issues/100732","id":2573562216,"node_id":"IC_kwDOAO6SJc6ZZXFo","user":{"login":"dsnopek","id":191561,"node_id":"MDQ6VXNlcjE5MTU2MQ==","avatar_url":"https://avatars.githubusercontent.com/u/191561?v=4","gravatar_id":"","url":"https://api.github.com/users/dsnopek","html_url":"https://github.com/dsnopek","followers_url":"https://api.github.com/users/dsnopek/followers","following_url":"https://api.github.com/users/dsnopek/following{/other_user}","gists_url":"https://api.github.com/users/dsnopek/gists{/gist_id}","starred_url":"https://api.github.com/users/dsnopek/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/dsnopek/subscriptions","organizations_url":"https://api.github.com/users/dsnopek/orgs","repos_url":"https://api.github.com/users/dsnopek/repos","events_url":"https://api.github.com/users/dsnopek/events{/privacy}","received_events_url":"https://api.github.com/users/dsnopek/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-01-06T17:20:54Z","updated_at":"2025-01-06T17:20:54Z","body":"Thanks! This is probably a case where we could use better documentation.\n\nHole punching doesn't really \"break\" transparency - transparency should still be working - there's just nothing behind your composition layer to be transparent over.\n\nThe projection layer that Godot renders the scene to is at a \"Sort Order\" of `0`. So, when your composition layer has a \"Sort Order\" of `1`, that means the OpenXR compositor is drawing your composition layer on top of the projection layer with the 3D scene. However, when you set \"Sort Order\" to `-1`, your composition layer is _behind_ the projection layer - the only reason we see it at all, is because enabling hole punching will cut a hole in what Godot has rendered to the projection layer. If you made another composition layer at \"Sort Order\" of `-2`, it would appear behind your original composition layer, and then you'd see that transparency is still working.\n\nSo, what you're experiencing is the expected behavior, but we could probably explain this better in the docs.","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2573562216/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2573845713","html_url":"https://github.com/godotengine/godot/issues/100732#issuecomment-2573845713","issue_url":"https://api.github.com/repos/godotengine/godot/issues/100732","id":2573845713,"node_id":"IC_kwDOAO6SJc6ZacTR","user":{"login":"arassec","id":14818006,"node_id":"MDQ6VXNlcjE0ODE4MDA2","avatar_url":"https://avatars.githubusercontent.com/u/14818006?v=4","gravatar_id":"","url":"https://api.github.com/users/arassec","html_url":"https://github.com/arassec","followers_url":"https://api.github.com/users/arassec/followers","following_url":"https://api.github.com/users/arassec/following{/other_user}","gists_url":"https://api.github.com/users/arassec/gists{/gist_id}","starred_url":"https://api.github.com/users/arassec/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/arassec/subscriptions","organizations_url":"https://api.github.com/users/arassec/orgs","repos_url":"https://api.github.com/users/arassec/repos","events_url":"https://api.github.com/users/arassec/events{/privacy}","received_events_url":"https://api.github.com/users/arassec/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-01-06T20:14:15Z","updated_at":"2025-01-06T20:14:15Z","body":"Thanks a lot for the explanation. I think i now understand what's happening when enabling \"hole punch\"!\n\nBest regards, and thanks for your work!","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2573845713/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null}]