DEzMzg=","avatar_url":"https://avatars.githubusercontent.com/u/4701338?v=4","gravatar_id":"","url":"https://api.github.com/users/akien-mga","html_url":"https://github.com/akien-mga","followers_url":"https://api.github.com/users/akien-mga/followers","following_url":"https://api.github.com/users/akien-mga/following{/other_user}","gists_url":"https://api.github.com/users/akien-mga/gists{/gist_id}","starred_url":"https://api.github.com/users/akien-mga/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/akien-mga/subscriptions","organizations_url":"https://api.github.com/users/akien-mga/orgs","repos_url":"https://api.github.com/users/akien-mga/repos","events_url":"https://api.github.com/users/akien-mga/events{/privacy}","received_events_url":"https://api.github.com/users/akien-mga/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-02-10T11:21:33Z","updated_at":"2025-02-10T11:22:11Z","body":"Tested on a Pixel 7a (Mali-G710) and I can't reproduce the issue. I tested both the official 4.4.beta3 build (`RENDER_GRAPH_REORDER = 1`) and a custom compile of latest `master` (261e7d32d37445de3ef3a9804346552fdac6096e) with `RENDER_GRAPH_REORDER = 0`.\n\nSo it's possibly another Adreno 50x specific driver bug we'd need to work around.\n\n> Could you please share your Android device details.\n> \n> Could you also bisect to identify which commit introduced this issue?\n\nSee the OP, they have Adreno 506, and attempted to bisect but ran into some issues.","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2647694339/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2647741768","html_url":"https://github.com/godotengine/godot/issues/102635#issuecomment-2647741768","issue_url":"https://api.github.com/repos/godotengine/godot/issues/102635","id":2647741768,"node_id":"IC_kwDOAO6SJc6d0VVI","user":{"login":"syntaxerror247","id":176927541,"node_id":"U_kgDOCouzNQ","avatar_url":"https://avatars.githubusercontent.com/u/176927541?v=4","gravatar_id":"","url":"https://api.github.com/users/syntaxerror247","html_url":"https://github.com/syntaxerror247","followers_url":"https://api.github.com/users/syntaxerror247/followers","following_url":"https://api.github.com/users/syntaxerror247/following{/other_user}","gists_url":"https://api.github.com/users/syntaxerror247/gists{/gist_id}","starred_url":"https://api.github.com/users/syntaxerror247/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/syntaxerror247/subscriptions","organizations_url":"https://api.github.com/users/syntaxerror247/orgs","repos_url":"https://api.github.com/users/syntaxerror247/repos","events_url":"https://api.github.com/users/syntaxerror247/events{/privacy}","received_events_url":"https://api.github.com/users/syntaxerror247/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-02-10T11:42:02Z","updated_at":"2025-02-10T11:42:02Z","body":"I also cannot reproduce this issue. I tested this on Moto G9 Play (Adreno 610) with master build.\n\n> See the OP, they have Adreno 506, and attempted to bisect but ran into some issues.\n\nSorry, I somehow didn’t notice that.\n\nI also can’t help with bisecting this issue because my system takes an hour to do a clean build.","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2647741768/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2647750043","html_url":"https://github.com/godotengine/godot/issues/102635#issuecomment-2647750043","issue_url":"https://api.github.com/repos/godotengine/godot/issues/102635","id":2647750043,"node_id":"IC_kwDOAO6SJc6d0XWb","user":{"login":"akien-mga","id":4701338,"node_id":"MDQ6VXNlcjQ3MDEzMzg=","avatar_url":"https://avatars.githubusercontent.com/u/4701338?v=4","gravatar_id":"","url":"https://api.github.com/users/akien-mga","html_url":"https://github.com/akien-mga","followers_url":"https://api.github.com/users/akien-mga/followers","following_url":"https://api.github.com/users/akien-mga/following{/other_user}","gists_url":"https://api.github.com/users/akien-mga/gists{/gist_id}","starred_url":"https://api.github.com/users/akien-mga/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/akien-mga/subscriptions","organizations_url":"https://api.github.com/users/akien-mga/orgs","repos_url":"https://api.github.com/users/akien-mga/repos","events_url":"https://api.github.com/users/akien-mga/events{/privacy}","received_events_url":"https://api.github.com/users/akien-mga/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-02-10T11:45:42Z","updated_at":"2025-02-10T11:45:42Z","body":"> I also cannot reproduce this issue. I tested this on Moto G9 Play (Adreno 610) with master build.\n\nDid you set `RENDER_GRAPH_REORDER` to 0?\n\n```diff\ndiff --git a/servers/rendering/rendering_device.cpp b/servers/rendering/rendering_device.cpp\nindex 055fcbeda6..7fe8e615e6 100644\n--- a/servers/rendering/rendering_device.cpp\n+++ b/servers/rendering/rendering_device.cpp\n@@ -114,7 +114,7 @@ static uint32_t _get_device_type_score(const RenderingContextDriver::Device &p_d\n // This behavior can be disabled if it's suspected that the graph is not detecting dependencies correctly and more control over the order of\n // the commands is desired (e.g. debugging).\n \n-#define RENDER_GRAPH_REORDER 1\n+#define RENDER_GRAPH_REORDER 0\n \n // Synchronization barriers are issued between the graph's levels only with the necessary amount of detail to achieve the correct result. If\n // it's suspected that the graph is not doing this correctly, full barriers can be issued instead that will block all types of operations\n```\n\nAnyway as this seems only reproducible on a specific device with a specific engine change to workaround another breaking bug on that device, I don't think it's a release blocker. It's a nasty bug and hopefully we find a fix, but it won't block the 4.4 release.","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2647750043/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2647765419","html_url":"https://github.com/godotengine/godot/issues/102635#issuecomment-2647765419","issue_url":"https://api.github.com/repos/godotengine/godot/issues/102635","id":2647765419,"node_id":"IC_kwDOAO6SJc6d0bGr","user":{"login":"syntaxerror247","id":176927541,"node_id":"U_kgDOCouzNQ","avatar_url":"https://avatars.githubusercontent.com/u/176927541?v=4","gravatar_id":"","url":"https://api.github.com/users/syntaxerror247","html_url":"https://github.com/syntaxerror247","followers_url":"https://api.github.com/users/syntaxerror247/followers","following_url":"https://api.github.com/users/syntaxerror247/following{/other_user}","gists_url":"https://api.github.com/users/syntaxerror247/gists{/gist_id}","starred_url":"https://api.github.com/users/syntaxerror247/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/syntaxerror247/subscriptions","organizations_url":"https://api.github.com/users/syntaxerror247/orgs","repos_url":"https://api.github.com/users/syntaxerror247/repos","events_url":"https://api.github.com/users/syntaxerror247/events{/privacy}","received_events_url":"https://api.github.com/users/syntaxerror247/received_events","type":"User","user_view_type"