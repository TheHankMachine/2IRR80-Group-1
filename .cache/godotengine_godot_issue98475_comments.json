[{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2652173001","html_url":"https://github.com/godotengine/godot/issues/98475#issuecomment-2652173001","issue_url":"https://api.github.com/repos/godotengine/godot/issues/98475","id":2652173001,"node_id":"IC_kwDOAO6SJc6eFPLJ","user":{"login":"JohanAR","id":4918549,"node_id":"MDQ6VXNlcjQ5MTg1NDk=","avatar_url":"https://avatars.githubusercontent.com/u/4918549?v=4","gravatar_id":"","url":"https://api.github.com/users/JohanAR","html_url":"https://github.com/JohanAR","followers_url":"https://api.github.com/users/JohanAR/followers","following_url":"https://api.github.com/users/JohanAR/following{/other_user}","gists_url":"https://api.github.com/users/JohanAR/gists{/gist_id}","starred_url":"https://api.github.com/users/JohanAR/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/JohanAR/subscriptions","organizations_url":"https://api.github.com/users/JohanAR/orgs","repos_url":"https://api.github.com/users/JohanAR/repos","events_url":"https://api.github.com/users/JohanAR/events{/privacy}","received_events_url":"https://api.github.com/users/JohanAR/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-02-11T22:07:01Z","updated_at":"2025-02-11T22:07:01Z","body":"I tried this in my platformer project. My CharacterBody2D is pushed 1-2 pixels into the TileMapLayer based platform whenever it moves up, and it also moves 1 pixel horizontally when the platform changes direction diagonally. When the platform moves downward the character is attached correctly to the platform, without overlap, but still moves 1px horizontally on direction change.","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2652173001/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3554879360","html_url":"https://github.com/godotengine/godot/issues/98475#issuecomment-3554879360","issue_url":"https://api.github.com/repos/godotengine/godot/issues/98475","id":3554879360,"node_id":"IC_kwDOAO6SJc7T4yeA","user":{"login":"billystein25","id":59233918,"node_id":"MDQ6VXNlcjU5MjMzOTE4","avatar_url":"https://avatars.githubusercontent.com/u/59233918?v=4","gravatar_id":"","url":"https://api.github.com/users/billystein25","html_url":"https://github.com/billystein25","followers_url":"https://api.github.com/users/billystein25/followers","following_url":"https://api.github.com/users/billystein25/following{/other_user}","gists_url":"https://api.github.com/users/billystein25/gists{/gist_id}","starred_url":"https://api.github.com/users/billystein25/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/billystein25/subscriptions","organizations_url":"https://api.github.com/users/billystein25/orgs","repos_url":"https://api.github.com/users/billystein25/repos","events_url":"https://api.github.com/users/billystein25/events{/privacy}","received_events_url":"https://api.github.com/users/billystein25/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-11-19T22:27:14Z","updated_at":"2025-11-19T22:27:14Z","body":"Same here. You can lessen the issue by enabling Physics Interpolation in Project Settings (/physics/common/physics_interpolation) and/or by increasing the physics tick rate (physics/common/physics_ticks_per_second) to something greater than the default of 60 (for example 120 or higher) but I wasn't able to fix it completely. Additionally if you're moving the TilemapLayer with a tween it helps a lot if you set the process mode to physics with `tween.set_process_mode(Tween.TWEEN_PROCESS_PHYSICS)` but again, you will always have a few pixels of jitter.","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3554879360/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null}]