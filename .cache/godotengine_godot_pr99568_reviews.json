[{"id":2470395098,"node_id":"PRR_kwDOAO6SJc6TPzza","user":{"login":"Calinou","id":180032,"node_id":"MDQ6VXNlcjE4MDAzMg==","avatar_url":"https://avatars.githubusercontent.com/u/180032?u=68d23e7ee9cdf810da125e8510b72f845b9dccc8&v=4","gravatar_id":"","url":"https://api.github.com/users/Calinou","html_url":"https://github.com/Calinou","followers_url":"https://api.github.com/users/Calinou/followers","following_url":"https://api.github.com/users/Calinou/following{/other_user}","gists_url":"https://api.github.com/users/Calinou/gists{/gist_id}","starred_url":"https://api.github.com/users/Calinou/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Calinou/subscriptions","organizations_url":"https://api.github.com/users/Calinou/orgs","repos_url":"https://api.github.com/users/Calinou/repos","events_url":"https://api.github.com/users/Calinou/events{/privacy}","received_events_url":"https://api.github.com/users/Calinou/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"Tested locally, it works as expected.\r\n\r\nRegarding the lack of resizability, we can find a middleground where the dialog's height is automatically set according to the GraphEdit's height. This means that if you increased your bottom panel's height, you'll get a taller dialog automatically so you can view more options at once.\r\n\r\nThe minimum height would remain `360 * EDSCALE` pixels, but it would be able to increase if the GraphEdit is tall enough. This would probably be something like 80% of the GraphEdit's height at most, so the dialog's height would start increasing when it's more than `450 * EDSCALE` pixels tall.","state":"COMMENTED","html_url":"https://github.com/godotengine/godot/pull/99568#pullrequestreview-2470395098","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/99568","author_association":"MEMBER","_links":{"html":{"href":"https://github.com/godotengine/godot/pull/99568#pullrequestreview-2470395098"},"pull_request"