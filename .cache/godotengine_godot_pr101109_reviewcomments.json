ohn/repos","events_url":"https://api.github.com/users/clayjohn/events{/privacy}","received_events_url":"https://api.github.com/users/clayjohn/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"Double negatives are never good for user facing information. Saying \"non negative\" makes the sentence needlessly complex and confusing. \r\n\r\nBoth ways of reading the current version are correct. So I don't see what the problem is. I much prefer to be very clear and explicit then to try to save words and make things more confusing. ","created_at":"2025-02-01T17:28:14Z","updated_at":"2025-02-01T17:28:14Z","html_url":"https://github.com/godotengine/godot/pull/101109#discussion_r1938311754","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/101109","_links":{"self":{"href":"https://api.github.com/repos/godotengine/godot/pulls/comments/1938311754"},"html":{"href":"https://github.com/godotengine/godot/pull/101109#discussion_r1938311754"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/101109"}},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/1938311754/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":null,"original_line":258,"side":"RIGHT","in_reply_to_id":1938241283,"author_association":"MEMBER","original_position":17,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/1938314750","pull_request_review_id":2588376081,"id":1938314750,"node_id":"PRRC_kwDOAO6SJc5ziFX-","diff_hunk":"@@ -249,39 +255,56 @@ void MultiMesh::set_physics_interpolation_quality(PhysicsInterpolationQuality p_\n }\n \n void MultiMesh::set_instance_transform(int p_instance, const Transform3D &p_transform) {\n+\tERR_FAIL_INDEX_MSG(p_instance, instance_count, \"Instance index out of bounds. Instance index must be 0 or a positive number that is less than `instance_count`.\");","path":"scene/resources/multimesh.cpp","commit_id":"e1af7b65b28087f9251eda03a3327e1313c9b51d","original_commit_id":"e615b404aa4be3563d2a095a818a709404195287","user":{"login":"rburing","id":229837,"node_id":"MDQ6VXNlcjIyOTgzNw==","avatar_url":"https://avatars.githubusercontent.com/u/229837?v=4","gravatar_id":"","url":"https://api.github.com/users/rburing","html_url":"https://github.com/rburing","followers_url":"https://api.github.com/users/rburing/followers","following_url":"https://api.github.com/users/rburing/following{/other_user}","gists_url":"https://api.github.com/users/rburing/gists{/gist_id}","starred_url":"https://api.github.com/users/rburing/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/rburing/subscriptions","organizations_url":"https://api.github.com/users/rburing/orgs","repos_url":"https://api.github.com/users/rburing/repos","events_url":"https://api.github.com/users/rburing/events{/privacy}","received_events_url":"https://api.github.com/users/rburing/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"No, the second way of reading the current version is incorrect when `instance_count == 1`.\r\n\r\nIt should be expressed in a way that doesn't require needless exceptions,  and expressing `>= 0` as \"non-negative\" is quite standard.","created_at":"2025-02-01T17:47:45Z","updated_at":"2025-02-01T17:47:46Z","html_url":"https://github.com/godotengine/godot/pull/101109#discussion_r1938314750","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/101109","_links":{"self":{"href":"https://api.github.com/repos/godotengine/godot/pulls/comments/1938314750"},"html":{"href":"https://github.com/godotengine/godot/pull/101109#discussion_r1938314750"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/101109"}},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/1938314750/reac