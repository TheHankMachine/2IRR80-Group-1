42:05Z","updated_at":"2026-10-21T22:40:26Z","due_on":null,"closed_at":null},"comments":5,"created_at":"2026-06-28T10:39:56Z","updated_at":"2026-09-23T15:13:08Z","closed_at":null,"assignee":null,"author_association":"NONE","issue_field_values":[],"type":null,"active_lock_reason":null,"draft":false,"pull_request":{"url":"https://api.github.com/repos/godotengine/godot/pulls/120709","html_url":"https://github.com/godotengine/godot/pull/120709","diff_url":"https://github.com/godotengine/godot/pull/120709.diff","patch_url":"https://github.com/godotengine/godot/pull/120709.patch","merged_at":null},"body":"## What problem(s) does this PR solve?\r\n- Closes: https://github.com/godotengine/godot-proposals/issues/6388\r\n\r\nEven when no changes have been made to the codebase, pressing \"Play\" triggers a brief but redundant short build popup every single time.\r\n\r\nThis creates unnecessary friction and slows down the iteration loop during rapid testing. This PR adds an editor setting to skip that automatic step, allowing the game to launch instantly. Developers can still manually build whenever a re-compile is actually needed.\r\n\r\n## Additional information\r\n- Adds the dotnet/build/disable_auto_build_on_play setting under Editor Settings.\r\n- Disabled by default (false) to ensure the standard workflow remains untouched for most users.\r\n","closed_by":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/120709/reactions","total_count":5,"+1":3,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":2,"eyes":0},"timeline_url":"https://api.github.com/repos/godotengine/godot/issues/120709/timeline","performed_via_github_app":null,"state_reason":null}