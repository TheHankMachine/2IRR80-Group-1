","color":"ffee88","default":false,"description":"","archived_at":null,"archived_by":null},{"id":1332303119,"node_id":"MDU6TGFiZWwxMzMyMzAzMTE5","url":"https://api.github.com/repos/godotengine/godot/labels/regression","name":"regression","color":"ff63ac","default":false,"description":"","archived_at":null,"archived_by":null},{"id":1732720779,"node_id":"MDU6TGFiZWwxNzMyNzIwNzc5","url":"https://api.github.com/repos/godotengine/godot/labels/topic:gui","name":"topic:gui","color":"ffee88","default":false,"description":"","archived_at":null,"archived_by":null}],"state":"closed","locked":false,"assignees":[],"milestone":{"url":"https://api.github.com/repos/godotengine/godot/milestones/22","html_url":"https://github.com/godotengine/godot/milestone/22","labels_url":"https://api.github.com/repos/godotengine/godot/milestones/22/labels","id":12070367,"node_id":"MI_kwDOAO6SJc4AuC3f","number":22,"title":"4.5","description":"","creator":{"login":"Sauermann","id":6299227,"node_id":"MDQ6VXNlcjYyOTkyMjc=","avatar_url":"https://avatars.githubusercontent.com/u/6299227?v=4","gravatar_id":"","url":"https://api.github.com/users/Sauermann","html_url":"https://github.com/Sauermann","followers_url":"https://api.github.com/users/Sauermann/followers","following_url":"https://api.github.com/users/Sauermann/following{/other_user}","gists_url":"https://api.github.com/users/Sauermann/gists{/gist_id}","starred_url":"https://api.github.com/users/Sauermann/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Sauermann/subscriptions","organizations_url":"https://api.github.com/users/Sauermann/orgs","repos_url":"https://api.github.com/users/Sauermann/repos","events_url":"https://api.github.com/users/Sauermann/events{/privacy}","received_events_url":"https://api.github.com/users/Sauermann/received_events","type":"User","user_view_type":"public","site_admin":false},"open_issues":3,"closed_issues":3687,"state":"closed","created_at":"2024-12-19T08:51:28Z","updated_at":"2026-09-04T21:48:38Z","due_on":"2025-09-15T00:00:00Z","closed_at":"2025-09-18T17:13:14Z"},"comments":9,"created_at":"2025-08-05T11:02:32Z","updated_at":"2026-01-06T13:53:48Z","closed_at":"2026-01-06T13:53:41Z","assignee":null,"author_association":"NONE","issue_field_values":[],"type":null,"active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"### Tested versions\n\n- Reproducible in: 4.5.beta3, 4.5.beta4\n- Not reproducible in: any godot 4.4.x versions or older releases\n\n### System information\n\nGodot v4.5.beta4 - Windows 10 (build 19045) - Multi-window, 2 monitors - Vulkan (Forward+) - dedicated NVIDIA GeForce RTX 3060 (NVIDIA; 32.0.15.7688) - AMD Ryzen 9 5900X 12-Core Processor (24 threads) - 31.92 GiB memory\n\n### Issue description\n\nWhen right clicking in the editor, a popup menu should appear, it works for the first right click, but when doing a second right click, it is now blank.\nTo fix this, you have to unfocus the godot editor by clicking somewhere else on your computer, then there will be a quick blank menu appear and Windows will put godot in orange as if godot sent a notification or something to Windows.\nOnly after that you can focus again godot and do another right click.\nYou have to do that after each time you open a right click popup menu.\n\nCheck the video to see what is happening, and here is what happens step by step :\n1. I do a right click, it works\n2. I click somewhere to close the popup menu\n3. I do another right click, blank\n4. I click outside of godot's window to unfocus\n5. You can see a blank popup menu appear really quickly where the last menu was\n6. I open the task bar to show that godot turned orange to notify me (the task bar was behind the window so it wasn't visible at first, but on my other screen it was)\n7. I click on godot again, it works like normal\n\nhttps://github.com/user-attachments/assets/e0ee916f-cf21-4e43-857c-06ac1b7fe07e\n\nThis happens in any project I tried, either imported from older versions, or totally new projects.\nAnd it happened in both Godot 4.5.beta3 and 4.5.beta4, I didn't try in other beta versions though\n\nIt's really annoying as it requires a lot of unfocus - focus when you're working on a project\n\n### Steps to reproduce\n\nJust open / create a project, as it happened in any projects of mine, either empty or full of content.\n\n### Minimal reproduction project (MRP)\n\nEmpty project, the issue is in the editor directly, not in the project.","closed_by":{"login":"akien-mga","id":4701338,"node_id":"MDQ6VXNlcjQ3MDEzMzg=","avatar_url":"https://avatars.githubusercontent.com/u/4701338?v=4","gravatar_id":"","url":"https://api.github.com/users/akien-mga","html_url":"https://github.com/akien-mga","followers_url":"https://api.github.com/users/akien-mga/followers","following_url":"https://api.github.com/users/akien-mga/following{/other_user}","gists_url":"https://api.github.com/users/akien-mga/gists{/gist_id}","starred_url":"https://api.github.com/users/akien-mga/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/akien-mga/subscriptions","organizations_url":"https://api.github.com/users/akien-mga/orgs","repos_url":"https://api.github.com/users/akien-mga/repos","events_url":"https://api.github.com/users/akien-mga/events{/privacy}","received_events_url":"https://api.github.com/users/akien-mga/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/109325/reactions","total_count":2,"+1":2,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/godotengine/godot/issues/109325/timeline","performed_via_github_app":null,"state_reason":"completed","pinned_comment":null}