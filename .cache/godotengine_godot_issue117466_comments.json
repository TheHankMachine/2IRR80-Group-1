[{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4148747006","html_url":"https://github.com/godotengine/godot/pull/117466#issuecomment-4148747006","issue_url":"https://api.github.com/repos/godotengine/godot/issues/117466","id":4148747006,"node_id":"IC_kwDOAO6SJc73SNr-","user":{"login":"TokageItLab","id":61938263,"node_id":"MDQ6VXNlcjYxOTM4MjYz","avatar_url":"https://avatars.githubusercontent.com/u/61938263?v=4","gravatar_id":"","url":"https://api.github.com/users/TokageItLab","html_url":"https://github.com/TokageItLab","followers_url":"https://api.github.com/users/TokageItLab/followers","following_url":"https://api.github.com/users/TokageItLab/following{/other_user}","gists_url":"https://api.github.com/users/TokageItLab/gists{/gist_id}","starred_url":"https://api.github.com/users/TokageItLab/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/TokageItLab/subscriptions","organizations_url":"https://api.github.com/users/TokageItLab/orgs","repos_url":"https://api.github.com/users/TokageItLab/repos","events_url":"https://api.github.com/users/TokageItLab/events{/privacy}","received_events_url":"https://api.github.com/users/TokageItLab/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-03-28T20:20:17Z","updated_at":"2026-03-28T20:20:17Z","body":"Considering cases where multi-selection movement is performed in animations with a large number of keys and tracks due to imports or baking, I believe this is somewhat dangerous. At the very least, when multiple selections are made, I think there should be a restriction that only displays the time for the two keys at the beginning and end of the track being clicked.","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4148747006/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4177544225","html_url":"https://github.com/godotengine/godot/pull/117466#issuecomment-4177544225","issue_url":"https://api.github.com/repos/godotengine/godot/issues/117466","id":4177544225,"node_id":"IC_kwDOAO6SJc75AEQh","user":{"login":"rinevard","id":136295900,"node_id":"U_kgDOCB-13A","avatar_url":"https://avatars.githubusercontent.com/u/136295900?v=4","gravatar_id":"","url":"https://api.github.com/users/rinevard","html_url":"https://github.com/rinevard","followers_url":"https://api.github.com/users/rinevard/followers","following_url":"https://api.github.com/users/rinevard/following{/other_user}","gists_url":"https://api.github.com/users/rinevard/gists{/gist_id}","starred_url":"https://api.github.com/users/rinevard/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/rinevard/subscriptions","organizations_url":"https://api.github.com/users/rinevard/orgs","repos_url":"https://api.github.com/users/rinevard/repos","events_url":"https://api.github.com/users/rinevard/events{/privacy}","received_events_url":"https://api.github.com/users/rinevard/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-04-02T12:32:52Z","updated_at":"2026-04-02T12:32:52Z","body":"Thanks for your suggestion! I've updated the PR and the video. It now only shows the time labels for the leftmost and rightmost keys of the clicked track.","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4177544225/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4181503229","html_url":"https://github.com/godotengine/godot/pull/117466#issuecomment-4181503229","issue_url":"https://api.github.com/repos/godotengine/godot/issues/117466","id":4181503229,"node_id":"IC_kwDOAO6SJc75PKz9","user":{"login":"rinevard","id":136295900,"node_id":"U_kgDOCB-13A","avatar_url":"https://avatars.githubusercontent.com/u/136295900?v=4","gravatar_id":"","url":"https://api.github.com/users/rinevard","html_url":"https://github.com/rinevard","followers_url":"https://api.github.com/users/rinevard/followers","following_url":"https://api.github.com/users/rinevard/following{/other_user}","gists_url":"https://api.github.com/users/rinevard/gists{/gist_id}","starred_url":"https://api.github.com/users/rinevard/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/rinevard/subscriptions","organizations_url":"https://api.github.com/users/rinevard/orgs","repos_url":"https://api.github.com/users/rinevard/repos","events_url":"https://api.github.com/users/rinevard/events{/privacy}","received_events_url":"https://api.github.com/users/rinevard/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-04-03T02:45:33Z","updated_at":"2026-04-03T02:45:33Z","body":"Thanks for the suggestions! The jittering can be fixed by using `pad_decimals`, and the centering issue is due to the left margin set in AnimationTrackMargins in the modern theme (which aren't set in the classic theme). I've fixed both of these issues. For the snapping, I cannot reproduce it on my machine.","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4181503229/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4183012977","html_url":"https://github.com/godotengine/godot/pull/117466#issuecomment-4183012977","issue_url":"https://api.github.com/repos/godotengine/godot/issues/117466","id":4183012977,"node_id":"IC_kwDOAO6SJc75U7Zx","user":{"login":"rinevard","id":136295900,"node_id":"U_kgDOCB-13A","avatar_url":"https://avatars.githubusercontent.com/u/136295900?v=4","gravatar_id":"","url":"https://api.github.com/users/rinevard","html_url":"https://github.com/rinevard","followers_url":"https://api.github.com/users/rinevard/followers","following_url":"https://api.github.com/users/rinevard/following{/other_user}","gists_url":"https://api.github.com/users/rinevard/gists{/gist_id}","starred_url":"https://api.github.com/users/rinevard/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/rinevard/subscriptions","organizations_url":"https://api.github.com/users/rinevard/orgs","repos_url":"https://api.github.com/users/rinevard/repos","events_url":"https://api.github.com/users/rinevard/events{/privacy}","received_events_url":"https://api.github.com/users/rinevard/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-04-03T11:02:11Z","updated_at":"2026-04-03T11:02:11Z","body":"Thanks! The issue is that when dragging multiple keys, only the dragged key is snapped and the rest are moved by offset, but the original code uses the snap value's precision for all times. I've fixed it by calculating decimal places needed for each time text.","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4183012977/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4183197475","html_url":"https://github.com/godotengine/godot/pull/117466#issuecomment-4183197475","issue_url":"https://api.github.com/repos/godotengine/godot/issues/117466","id":4183197475,"node_id":"IC_kwDOAO6SJc75Vocj","user":{"login":"AdriaandeJongh","id":5611323,"node_id":"MDQ6VXNlcjU2MTEzMjM=","avatar_url":"https://avatars.githubusercontent.com/u/5611323?v=4","gravatar_id":"","url":"https://api.github.com/users/AdriaandeJongh","html_url":"https://github.com/AdriaandeJongh","followers_url":"https://api.github.com/users/AdriaandeJongh/followers","following_url":"https://api.github.com/users/AdriaandeJongh/following{/other_user}","gists_url":"https://api.github.com/users/AdriaandeJongh/gists{/gist_id}","starred_url":"https://api.github.com/users/AdriaandeJongh/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/AdriaandeJongh/subscriptions","organizations_url":"https://api.github.com/users/AdriaandeJongh/orgs","repos_url":"https://api.github.com/users/AdriaandeJongh/repos","events_url":"https://api.github.com/users/AdriaandeJongh/events{/privacy}","received_events_url":"https://api.github.com/users/AdriaandeJongh/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-04-03T12:05:35Z","updated_at":"2026-04-03T12:05:35Z","body":"Sorry for the numerous smaller reports in stead of one big one! I keep finding little unexpected things even though I intent to approve this PR :P \r\n\r\n- In Frame mode and with snapping disabled, shouldn't the index be floored to the frame number to the left? After all, in frame mode, having a key in between frames puts it in the left frame. Being closer to the next frame doesn't mean it is in the next frame. Hence, the rounding currently happening should be floored instead of rounded:\r\n\r\nhttps://github.com/user-attachments/assets/f2723e5c-890b-45da-b0fc-7cab27bc91b2\r\n\r\nFixing that should also fix the `-0` value when moving a key left of `0` – as it should be -1.\r\n\r\n<img width=\"201\" height=\"126\" alt=\"Screenshot 2026-04-03 at 14 03 25\" src=\"https://github.com/user-attachments/assets/cdfe4274-2aa0-4c9f-83d6-f89645b79832\" />","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4183197475/reactions","total_count":1,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":1,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4183285774","html_url":"https://github.com/godotengine/godot/pull/117466#issuecomment-4183285774","issue_url":"https://api.github.com/repos/godotengine/godot/issues/117466","id":4183285774,"node_id":"IC_kwDOAO6SJc75V-AO","user":{"login":"TokageItLab","id":61938263,"node_id":"MDQ6VXNlcjYxOTM4MjYz","avatar_url":"https://avatars.githubusercontent.com/u/61938263?v=4","gravatar_id":"","url":"https://api.github.com/users/TokageItLab","html_url":"https://github.com/TokageItLab","followers_url":"https://api.github.com/users/TokageItLab/followers","following_url":"https://api.github.com/users/TokageItLab/following{/other_user}","gists_url":"https://api.github.com/users/TokageItLab/gists{/gist_id}","starred_url":"https://api.github.com/users/TokageItLab/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/TokageItLab/subscriptions","organizations_url":"https://api.github.com/users/TokageItLab/orgs","repos_url":"https://api.github.com/users/TokageItLab/repos","events_url":"https://api.github.com/users/TokageItLab/events{/privacy}","received_events_url":"https://api.github.com/users/TokageItLab/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-04-03T12:30:11Z","updated_at":"2026-04-03T12:47:15Z","body":"> In Frame mode and with snapping disabled, shouldn't the index be floored to the frame number to the left?\r\n\r\nIn this case as well, I think it’s better to display the time. Displaying the frames that were truncated isn’t helpful. Since it is inaccurate, and keys are always placed by time in the serialized scene data. To say consistency as justification, the unit for the current time in the upper-left container is always second.\r\n\r\nIf you want to be able to see the frames at a glance, I think it should become the other solution like to make improvements such as adding a striped pattern to the background for each frame. Like:\r\n<img width=\"441\" height=\"230\" alt=\"image\" src=\"https://github.com/user-attachments/assets/6c005794-21c5-4e9d-8ec4-1db4ca074dae\" />\r\n\r\n","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4183285774/reactions","total_count":1,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":1,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4185976112","html_url":"https://github.com/godotengine/godot/pull/117466#issuecomment-4185976112","issue_url":"https://api.github.com/repos/godotengine/godot/issues/117466","id":4185976112,"node_id":"IC_kwDOAO6SJc75gO0w","user":{"login":"rinevard","id":136295900,"node_id":"U_kgDOCB-13A","avatar_url":"https://avatars.githubusercontent.com/u/136295900?v=4","gravatar_id":"","url":"https://api.github.com/users/rinevard","html_url":"https://github.com/rinevard","followers_url":"https://api.github.com/users/rinevard/followers","following_url":"https://api.github.com/users/rinevard/following{/other_user}","gists_url":"https://api.github.com/users/rinevard/gists{/gist_id}","starred_url":"https://api.github.com/users/rinevard/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/rinevard/subscriptions","organizations_url":"https://api.github.com/users/rinevard/orgs","repos_url":"https://api.github.com/users/rinevard/repos","events_url":"https://api.github.com/users/rinevard/events{/privacy}","received_events_url":"https://api.github.com/users/rinevard/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-04-04T01:49:02Z","updated_at":"2026-04-07T04:55:46Z","body":"Currently the time text displayed in Frame mode matches the value shown in the inspector, except that it shows \"-0\" sometimes when the inspector shows \"0\". To keep consistency with the inspector, how about keeping the current display logic but fixing the \"-0\" issue?","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4185976112/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null}]