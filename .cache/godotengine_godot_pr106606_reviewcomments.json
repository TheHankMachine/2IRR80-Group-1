_hunk":"@@ -204,7 +246,7 @@ static _FORCE_INLINE_ T nearest_power_of_2_templated(T x) {\n \t// The number of operations on x is the base two logarithm\n \t// of the number of bits in the type. Add three to account\n \t// for sizeof(T) being in bytes.\n-\tsize_t num = get_shift_from_power_of_2(sizeof(T)) + 3;\n+\tsize_t num = get_shift_from_power_of_2((uint64_t)sizeof(T)) + 3;","path":"core/typedefs.h","commit_id":"f6f1df7d7322592323a7510881f1facfa7f8f33c","original_commit_id":"caff5a2afce611d9298a3b368a3acc41e6ec9ece","user":{"login":"Ivorforce","id":2308167,"node_id":"MDQ6VXNlcjIzMDgxNjc=","avatar_url":"https://avatars.githubusercontent.com/u/2308167?v=4","gravatar_id":"","url":"https://api.github.com/users/Ivorforce","html_url":"https://github.com/Ivorforce","followers_url":"https://api.github.com/users/Ivorforce/followers","following_url":"https://api.github.com/users/Ivorforce/following{/other_user}","gists_url":"https://api.github.com/users/Ivorforce/gists{/gist_id}","starred_url":"https://api.github.com/users/Ivorforce/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Ivorforce/subscriptions","organizations_url":"https://api.github.com/users/Ivorforce/orgs","repos_url":"https://api.github.com/users/Ivorforce/repos","events_url":"https://api.github.com/users/Ivorforce/events{/privacy}","received_events_url":"https://api.github.com/users/Ivorforce/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"It's meant to figure out how many of these lines you need:\r\n```\r\n\tx |= x >> 1;\r\n \tx |= x >> 2;\r\n \tx |= x >> 4;\r\n        // more?\r\n```\r\n\r\nThe function is defined w.r.t. bit count, i.e. `8 * byte count`.\r\nWe can simplify: \r\n```\r\n  log2(bit_count)\r\n= log2(byte_count * 8)\r\n= log2(byte_count) + log2(8)\r\n= log2(byte_count) + 3\r\n```\r\n\r\nSo that's where they got that from. It's still wrong though, since we need the `log2(log2(bit_count)) + 1` instead of the assumed `log2(bit_count)`.\r\nAnd yea, that's why sometimes good old hardcoded functions are just a better idea than making something templated to \"save on LOC\" 😅","created_at":"2025-05-19T21:25:17Z","updated_at":"2025-05-19T21:26:42Z","html_url":"https://github.com/godotengine/godot/pull/106606#discussion_r2096508871","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/106606","_links":{"self":{"href":"https://api.github.com/repos/godotengine/godot/pulls/comments/2096508871"},"html":{"href":"https://github.com/godotengine/godot/pull/106606#discussion_r2096508871"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/106606"}},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/2096508871/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":null,"original_line":249,"side":"RIGHT","in_reply_to_id":2096351283,"author_association":"MEMBER","original_position":88,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/2096513320","pull_request_review_id":2852037159,"id":2096513320,"node_id":"PRRC_kwDOAO6SJc589kEo","diff_hunk":"@@ -39,7 +39,7 @@ class FileAccessCompressed : public FileAccess {\n \tbool writing = false;\n \tuint64_t write_pos = 0;\n \tuint8_t *write_ptr = nullptr;\n-\tuint32_t write_buffer_size = 0;\n+\tuint64_t write_buffer_size = 0;","path":"core/io/file_access_compressed.h","commit_id":"f6f1df7d7322592323a7510881f1facfa7f8f33c","original_commit_id":"09d73dd9e903d9d6eaaa1d8ee9badea1e41c331f","user":{"login":"Ivorforce","id":2308167,"node_id":"MDQ6VXNlcjIzMDgxNjc=","avatar_url":"https://avatars.githubusercontent.com/u/2308167?v=4","gravatar_id":"","url":"https://api.github.com/users/Ivorforce","html_url":"https://github.com/Ivorforce","followers_url":"https://api.github.com/users/Ivorforce/followers","following_url":"https://api.github