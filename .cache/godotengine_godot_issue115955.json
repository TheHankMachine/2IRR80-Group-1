assets/fd68e1d7-46d2-4bee-b155-4e2d37d5d070\" />\n\n### Steps to reproduce\n\nOpen and run the attached project.\n\n### Minimal reproduction project (MRP)\n\n[ssr_repro.zip](https://github.com/user-attachments/files/25128225/ssr_repro.zip)","closed_by":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/115955/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/godotengine/godot/issues/115955/timeline","performed_via_github_app":null,"state_reason":null,"pinned_comment":null}