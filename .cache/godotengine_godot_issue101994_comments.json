025-03-14T19:38:37Z","updated_at":"2025-03-14T19:38:37Z","body":"There seems to be a problem with the tests, it might be taking over or invalidating some base paths for loading data.","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2725594510/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2725630137","html_url":"https://github.com/godotengine/godot/pull/101994#issuecomment-2725630137","issue_url":"https://api.github.com/repos/godotengine/godot/issues/101994","id":2725630137,"node_id":"IC_kwDOAO6SJc6iddC5","user":{"login":"bruvzg","id":7645683,"node_id":"MDQ6VXNlcjc2NDU2ODM=","avatar_url":"https://avatars.githubusercontent.com/u/7645683?v=4","gravatar_id":"","url":"https://api.github.com/users/bruvzg","html_url":"https://github.com/bruvzg","followers_url":"https://api.github.com/users/bruvzg/followers","following_url":"https://api.github.com/users/bruvzg/following{/other_user}","gists_url":"https://api.github.com/users/bruvzg/gists{/gist_id}","starred_url":"https://api.github.com/users/bruvzg/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/bruvzg/subscriptions","organizations_url":"https://api.github.com/users/bruvzg/orgs","repos_url":"https://api.github.com/users/bruvzg/repos","events_url":"https://api.github.com/users/bruvzg/events{/privacy}","received_events_url":"https://api.github.com/users/bruvzg/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-03-14T19:58:31Z","updated_at":"2025-03-14T19:58:31Z","body":"Restoring resource path after each test seems to fix the failed test:\r\n\r\n```diff\r\ndiff --git a/modules/dds/tests/test_dds.h b/modules/dds/tests/test_dds.h\r\nindex 895de1fe2a..9a170fcffa 100644\r\n--- a/modules/dds/tests/test_dds.h\r\n+++ b/modules/dds/tests/test_dds.h\r\n@@ -40,7 +40,10 @@\r\n #include \"tests/test_utils.h\"\r\n\r\n namespace TestDDS {\r\n-void init(const String &p_test, const String &p_copy_target = String()) {\r\n+\r\n+String init(const String &p_test, const String &p_copy_target = String()) {\r\n+       String old_resource_path = TestProjectSettingsInternalsAccessor::resource_path();\r\n+\r\n        Error err;\r\n        // Setup project settings since it's needed for the import process.\r\n        String project_folder = TestUtils::get_temp_path(p_test.get_file().get_basename());\r\n@@ -51,7 +54,7 @@ void init(const String &p_test, const String &p_copy_target = String()) {\r\n        err = ProjectSettings::get_singleton()->setup(project_folder, String(), true);\r\n\r\n        if (p_copy_target.is_empty()) {\r\n-               return;\r\n+               return old_resource_path;\r\n        }\r\n\r\n        // Copy all the necessary test data files to the res:// directory.\r\n@@ -70,10 +73,12 @@ void init(const String &p_test, const String &p_copy_target = String()) {\r\n                output->close();\r\n        }\r\n        da->list_dir_end();\r\n+       return old_resource_path;\r\n }\r\n\r\n TEST_CASE(\"[SceneTree][DDSSaver] Save DDS - Save valid image with mipmap\" * doctest::skip(true)) {\r\n-       init(\"save_dds_valid_image_with_mipmap\");\r\n+       String old_resource_path = init(\"save_dds_valid_image_with_mipmap\");\r\n+\r\n        Ref<Image> image = Image::create_empty(4, 4, false, Image::FORMAT_RGBA8);\r\n        image->fill(Color(1, 0, 0)); // Fill with red color\r\n        image->generate_mipmaps();\r\n@@ -92,10 +97,13 @@ TEST_CASE(\"[SceneTree][DDSSaver] Save DDS - Save valid image with mipmap\" * doct\r\n        CHECK_MESSAGE(metrics.has(\"root_mean_squared\"), \"Metrics dictionary contains 'root_mean_squared'.\");\r\n        float rms = metrics[\"root_mean_squared\"];\r\n        CHECK(rms == 0.0f);\r\n+\r\n+       TestProjectSettingsInternalsAccessor::resource_path() = old_resource_path;\r\n }\r\n\r\n TEST_CASE(\"[SceneTree][DDSSaver] Save DDS - Save valid image with BPTC and S3TC compression\" * doctest::skip(true)) {\r\n-       init(\"save_dds_valid_image_bptc_s3tc\");\r\n+       String old_resource_path = init(\"save_dds_valid_image_bptc_s3tc\");\r\n+\r\n        Ref<Image> image_bptc = Image::create_empty(4, 4, false, Image::FORMAT_RGBA8);\r\n        image_bptc->fill(Color(0, 0, 1)); // Fill with blue color\r\n        image_bptc->compress_from_channels(Image::COMPRESS_BPTC, Image::USED_CHANNELS_RGBA);\r\n@@ -133,10 +141,13 @@ TEST_CASE(\"[SceneTree][DDSSaver] Save DDS - Save valid image with BPTC and S3TC\r\n        CHECK_MESSAGE(metrics_s3tc.has(\"root_mean_squared\"), \"Metrics dictionary contains 'root_mean_squared' for S3TC.\");\r\n        float rms_s3tc = metrics_s3tc[\"root_mean_squared\"];\r\n        CHECK(rms_s3tc == 0.0f);\r\n+\r\n+       TestProjectSettingsInternalsAccessor::resource_path() = old_resource_path;\r\n }\r\n\r\n TEST_CASE(\"[SceneTree][DDSSaver] Save DDS - Save valid uncompressed image\") {\r\n-       init(\"save_dds_valid_uncompressed\");\r\n+       String old_resource_path = init(\"save_dds_valid_uncompressed\");\r\n+\r\n        Ref<Image> image = Image::create_empty(4, 4, false, Image::FORMAT_RGBA8);\r\n        image->fill(Color(0, 0, 1)); // Fill with blue color\r\n        Error err = image->save_dds(\"res://valid_image_uncompressed.dds\");\r\n@@ -152,5 +163,8 @@ TEST_CASE(\"[SceneTree][DDSSaver] Save DDS - Save valid uncompressed image\") {\r\n        CHECK_MESSAGE(metrics.has(\"root_mean_squared\"), \"Metrics dictionary contains 'root_mean_squared' for uncompressed.\");\r\n        float rms = metrics[\"root_mean_squared\"];\r\n        CHECK(rms == 0.0f);\r\n+\r\n+       TestProjectSettingsInternalsAccessor::resource_path() = old_resource_path;\r\n }\r\n+\r\n } //namespace TestDDS\r\n```","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2725630137/reactions","total_count":1,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":1,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2730937785","html_url":"https://github.com/godotengine/godot/pull/101994#issuecomment-2730937785","issue_url":"https://api.github.com/repos/godotengine/godot/issues/101994","id":2730937785,"node_id":"IC_kwDOAO6SJc6ixs25","user":{"login":"Repiteo","id":17489292,"node_id":"MDQ6VXNlcjE3NDg5Mjky","avatar_url":"https://avatars.githubusercontent.com/u/17489292?v=4","gravatar_id":"","url":"https://api.github.com/users/Repiteo","html_url":"https://github.com/Repiteo","followers_url":"https://api.github.com/users/Repiteo/followers","following_url":"https://api.github.com/users/Repiteo/following{/other_user}","gists_url":"https://api.github.com/users/Repiteo/gists{/gist_id}","starred_url":"https://api.github.com/users/Repiteo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Repiteo/subscriptions","organizations_url":"https://api.github.com/users/Repiteo/orgs","repos_url":"https://api.github.com/users/Repiteo/repos","events_url":"https://api.github.com/users/Repiteo/events{/privacy}","received_events_url":"https://api.github.com/users/Repiteo/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-03-17T21:10:54Z","updated_at":"2025-03-17T21:10:54Z","body":"Thanks!","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2730937785/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null}]