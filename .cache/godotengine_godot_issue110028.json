es":[],"milestone":{"url":"https://api.github.com/repos/godotengine/godot/milestones/23","html_url":"https://github.com/godotengine/godot/milestone/23","labels_url":"https://api.github.com/repos/godotengine/godot/milestones/23/labels","id":12939969,"node_id":"MI_kwDOAO6SJc4AxXLB","number":23,"title":"4.6","description":"","creator":{"login":"Repiteo","id":17489292,"node_id":"MDQ6VXNlcjE3NDg5Mjky","avatar_url":"https://avatars.githubusercontent.com/u/17489292?v=4","gravatar_id":"","url":"https://api.github.com/users/Repiteo","html_url":"https://github.com/Repiteo","followers_url":"https://api.github.com/users/Repiteo/followers","following_url":"https://api.github.com/users/Repiteo/following{/other_user}","gists_url":"https://api.github.com/users/Repiteo/gists{/gist_id}","starred_url":"https://api.github.com/users/Repiteo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Repiteo/subscriptions","organizations_url":"https://api.github.com/users/Repiteo/orgs","repos_url":"https://api.github.com/users/Repiteo/repos","events_url":"https://api.github.com/users/Repiteo/events{/privacy}","received_events_url":"https://api.github.com/users/Repiteo/received_events","type":"User","user_view_type":"public","site_admin":false},"open_issues":3,"closed_issues":2978,"state":"closed","created_at":"2025-05-22T16:25:52Z","updated_at":"2026-10-04T16:23:23Z","due_on":null,"closed_at":"2026-01-26T18:09:14Z"},"comments":6,"created_at":"2025-08-27T15:56:21Z","updated_at":"2025-10-06T15:47:44Z","closed_at":"2025-10-01T18:20:12Z","assignee":null,"author_association":"CONTRIBUTOR","issue_field_values":[],"type":null,"active_lock_reason":null,"draft":false,"pull_request":{"url":"https://api.github.com/repos/godotengine/godot/pulls/110028","html_url":"https://github.com/godotengine/godot/pull/110028","diff_url":"https://github.com/godotengine/godot/pull/110028.diff","patch_url":"https://github.com/godotengine/godot/pull/110028.patch","merged_at":"2025-10-01T18:20:12Z"},"body":"In addition to the regular edge collapse, we now allow the simplifier to\r\nremove small isolated components. Components that are removed are below\r\nthe error threshold in size and as such should not noticeably contribute\r\nto the overall rendering of the object.\r\n\r\nThis helps simplify topologically complex but small parts of larger\r\nmeshes and more comfortably reach the LOD targets.\r\n\r\nFor example, on this mesh https://sketchfab.com/3d-models/antique-iron-safe-196cf0d3d5094b50874dbf51064a7d3e this allows us to generate one more LOD; more importantly, the second-to-last LOD (~600-700 triangle one) previously had a very high error because it was forced to take high-attribute-error collapses, and now it can instead remove a few mesh features that aren't visible from a distance, and retain the rest of the appearance better. (top row = before, bottom = after)\r\n\r\n<img width=\"1912\" height=\"1257\" alt=\"image\" src=\"https://github.com/user-attachments/assets/92463de9-37da-456d-b121-85eabe57a1cb\" />\r\n\r\nNote: this PR could technically be submitted separately from the dependent one, but it requires a couple tweaks in the generation loop and it works best when LOD appearance is monotonic, to avoid cases where a small feature is removed in one LOD but is somehow present in a subsequent LOD because the collapse sequence taken was different.\r\n\r\nBug squad edit: Fixes: https://github.com/godotengine/godot-proposals/issues/3861","closed_by":{"login":"Repiteo","id":17489292,"node_id":"MDQ6VXNlcjE3NDg5Mjky","avatar_url":"https://avatars.githubusercontent.com/u/17489292?v=4","gravatar_id":"","url":"https://api.github.com/users/Repiteo","html_url":"https://github.com/Repiteo","followers_url":"https://api.github.com/users/Repiteo/followers","following_url":"https://api.github.com/users/Repiteo/following{/other_user}","gists_url":"https://api.github.com/users/Repiteo/gists{/gist_id}","starred_url":"https://api.github.com/users/Repiteo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Repiteo/subscriptions","organizations_url":"https://api.github.com/users/Repiteo/orgs","repos_url":"https://api.github.com/users/Repiteo/repos","events_url":"https://api.github.com/users/Repiteo/events{/privacy}","received_events_url":"https://api.github.com/users/Repiteo/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/110028/reactions","total_count":38,"+1":26,"-1":0,"laugh":0,"hooray":4,"confused":0,"heart":0,"rocket":8,"eyes":0},"timeline_url":"https://api.github.com/repos/godotengine/godot/issues/110028/timeline","performed_via_github_app":null,"state_reason":null}