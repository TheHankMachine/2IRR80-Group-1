-17T13:42:10Z"},{"id":3001218390,"node_id":"PRR_kwDOAO6SJc6y4vVW","state":"COMMENTED","user":{"site_admin":false,"suspended":false,"updated_at":"0001-01-01T00:00:00Z","avatar_url":"https://avatars.githubusercontent.com/u/2308167?u=f7f8e0273f784f5ec6f6b7fe4a88d449896eb48a&v=4","created_at":"0001-01-01T00:00:00Z","followers":0,"following":0,"html_url":"https://github.com/Ivorforce","id":2308167,"node_id":"MDQ6VXNlcjIzMDgxNjc=","login":"Ivorforce","type":"User","owned_private_repos":0,"public_gists":0,"public_repos":0,"total_private_repos":0,"url":"https://api.github.com/users/Ivorforce"},"body":"Most changes look good to me.","html_url":"https://github.com/godotengine/godot/pull/107596#pullrequestreview-3001218390","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/107596","author_association":"MEMBER","submitted_at":"2025-07-09T11:55:22Z"},{"id":3001384447,"node_id":"PRR_kwDOAO6SJc6y5X3_","state":"COMMENTED","user":{"site_admin":false,"suspended":false,"updated_at":"0001-01-01T00:00:00Z","avatar_url":"https://avatars.githubusercontent.com/u/60024671?u=7e327c81e8a9552ea98ca69adcccac4a50657dd9&v=4","created_at":"0001-01-01T00:00:00Z","followers":0,"following":0,"html_url":"https://github.com/DeeJayLSP","id":60024671,"node_id":"MDQ6VXNlcjYwMDI0Njcx","login":"DeeJayLSP","type":"User","owned_private_repos":0,"public_gists":0,"public_repos":0,"total_private_repos":0,"url":"https://api.github.com/users/DeeJayLSP"},"body":"","html_url":"https://github.com/godotengine/godot/pull/107596#pullrequestreview-3001384447","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/107596","author_association":"CONTRIBUTOR","submitted_at":"2025-07-09T12:36:52Z"},{"id":3001399490,"node_id":"PRR_kwDOAO6SJc6y5bjC","state":"COMMENTED","user":{"site_admin":false,"suspended":false,"updated_at":"0001-01-01T00:00:00Z","avatar_url":"https://avatars.githubusercontent.com/u/60024671?u=7e327c81e8a9552ea98ca69adcccac4a50657dd9&v=4","created_at":"0001-01-01T00:00:00Z","followers":0,"following":0,"html_url":"https://github.com/DeeJayLSP","id":60024671,"node_id":"MDQ6VXNlcjYwMDI0Njcx","login":"DeeJayLSP","type":"User","owned_private_repos":0,"public_gists":0,"public_repos":0,"total_private_repos":0,"url":"https://api.github.com/users/DeeJayLSP"},"body":"","html_url":"https://github.com/godotengine/godot/pull/107596#pullrequestreview-3001399490","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/107596","author_association":"CONTRIBUTOR","submitted_at":"2025-07-09T12:41:48Z"},{"id":3001626357,"node_id":"PRR_kwDOAO6SJc6y6S71","state":"APPROVED","user":{"site_admin":false,"suspended":false,"updated_at":"0001-01-01T00:00:00Z","avatar_url":"https://avatars.githubusercontent.com/u/2308167?u=f7f8e0273f784f5ec6f6b7fe4a88d449896eb48a&v=4","created_at":"0001-01-01T00:00:00Z","followers":0,"following":0,"html_url":"https://github.com/Ivorforce","id":2308167,"node_id":"MDQ6VXNlcjIzMDgxNjc=","login":"Ivorforce","type":"User","owned_private_repos":0,"public_gists":0,"public_repos":0,"total_private_repos":0,"url":"https://api.github.com/users/Ivorforce"},"body":"Looks good to me.\nI think this has _some_ potential to cause odd regressions, especially with intermediate values of math that was changed from signed to unsigned. I'm with you on the decision; some of these types should have been unsigned from the start, but it _is_ somewhat of a risk.\nI'd hesitate to recommend merging this for 4.5 for this reason, i'd feel more comfortable merging it in early 4.6 and perhaps cherry-picking it after a month or so of tests. But I guess there's still some weeks to go until 4.5 release, so it could be fine.","html_url":"https://github.com/godotengine/godot/pull/107596#pullrequestreview-3001626357","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/107596","author_association":"MEMBER","submitted_at":"2025-07-09T13:41:07Z"},{"id":3057403921,"node_id":"PRR_kwDOAO6SJc62PEgR","state":"APPROVED","user":{"site_a