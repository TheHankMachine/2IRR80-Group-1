[{"id":3630223535,"node_id":"PRR_kwDOAO6SJc7YYNCv","user":{"login":"lyuma","id":39946030,"node_id":"MDQ6VXNlcjM5OTQ2MDMw","avatar_url":"https://avatars.githubusercontent.com/u/39946030?v=4","gravatar_id":"","url":"https://api.github.com/users/lyuma","html_url":"https://github.com/lyuma","followers_url":"https://api.github.com/users/lyuma/followers","following_url":"https://api.github.com/users/lyuma/following{/other_user}","gists_url":"https://api.github.com/users/lyuma/gists{/gist_id}","starred_url":"https://api.github.com/users/lyuma/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/lyuma/subscriptions","organizations_url":"https://api.github.com/users/lyuma/orgs","repos_url":"https://api.github.com/users/lyuma/repos","events_url":"https://api.github.com/users/lyuma/events{/privacy}","received_events_url":"https://api.github.com/users/lyuma/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"I see the `animation_finished` signal is emitted from `AnimationPlayer::_blend_post_process()`, so this fixes cases where the AnimationPlayer is affected by signal callbacks from animations. I think this fix looks good for the `animation_finished` signal -> `advance()` case.\r\n\r\nNote: TYPE_METHOD tracks are called in `AnimationMixer::_blend_process` (unless deferred mode is being used), and `_blend_process` happens before the moved line, so this PR will not solve cases where the user advances the animation player from inside a call method track (unless they enable deferred mode)","state":"APPROVED","html_url":"https://github.com/godotengine/godot/pull/114458#pullrequestreview-3630223535","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/114458","author_association":"CONTRIBUTOR","_links":{"html":{"href":"https://github.com/godotengine/godot/pull/114458#pullrequestreview-3630223535"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/114458"}},"submitted_at":"2026-01-06T