gnees":[],"milestone":{"url":"https://api.github.com/repos/godotengine/godot/milestones/25","html_url":"https://github.com/godotengine/godot/milestone/25","labels_url":"https://api.github.com/repos/godotengine/godot/milestones/25/labels","id":15520464,"node_id":"MI_kwDOAO6SJc4A7NLQ","number":25,"title":"4.8","description":"","creator":{"login":"Repiteo","id":17489292,"node_id":"MDQ6VXNlcjE3NDg5Mjky","avatar_url":"https://avatars.githubusercontent.com/u/17489292?v=4","gravatar_id":"","url":"https://api.github.com/users/Repiteo","html_url":"https://github.com/Repiteo","followers_url":"https://api.github.com/users/Repiteo/followers","following_url":"https://api.github.com/users/Repiteo/following{/other_user}","gists_url":"https://api.github.com/users/Repiteo/gists{/gist_id}","starred_url":"https://api.github.com/users/Repiteo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Repiteo/subscriptions","organizations_url":"https://api.github.com/users/Repiteo/orgs","repos_url":"https://api.github.com/users/Repiteo/repos","events_url":"https://api.github.com/users/Repiteo/events{/privacy}","received_events_url":"https://api.github.com/users/Repiteo/received_events","type":"User","user_view_type":"public","site_admin":false},"open_issues":343,"closed_issues":2335,"state":"open","created_at":"2026-04-13T15:59:35Z","updated_at":"2026-10-22T06:28:22Z","due_on":null,"closed_at":null},"comments":0,"created_at":"2026-08-10T16:06:38Z","updated_at":"2026-08-18T15:11:56Z","closed_at":"2026-08-18T15:11:56Z","assignee":null,"author_association":"CONTRIBUTOR","issue_field_values":[],"type":null,"active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"### Tested versions\n\n- Reproducible in: 4.8.dev [4173760fdf6c2c722e82e08cb58e55f34c9efd80]\n- Reproducible in: 4.7.1-stable\n\n### System information\n\nGodot v4.8.dev (4173760fd) - Fedora Linux 44 (Forty Four) on Wayland - X11 display driver, Single-window, 2 monitors - Vulkan (Forward+) - dedicated AMD Radeon RX 9070 XT (RADV GFX1201) - AMD Ryzen 9 9950X3D 16-Core Processor (32 threads) - 60.39 GiB memory - PulseAudio (44100 Hz, Stereo/mono)\n\n### Issue description\n\n`String.format` currently allows you to pass an `Object` to serve as the lookup for the placeholders found in the string, as seen [here](https://docs.godotengine.org/en/latest/classes/class_string.html#class-string-method-format).\n\nThe way that this is currently implemented not only means that every single property on the `Object` will have `replace` called for it, but it will also invoke that property's getter for every single property:\n\nhttps://github.com/godotengine/godot/blob/4173760fdf6c2c722e82e08cb58e55f34c9efd80/core/string/ustring.cpp#L3591-L3601\n\nSo this code:\n\n```gdscript\nextends Node2D\n\nvar some_physics_specific_state: String:\n    get:\n        if not Engine.is_in_physics_frame():\n            push_error(\"This should never happen\")\n\n        return some_physics_specific_state\n\nfunc _ready() -> void:\n    print(\"My position is: {position}\".format(self))\n```\n\n... will emit the \"This should never happen\" error.\n\nEven disregarding the potential performance impact of needlessly invoking getters that might be doing something very costly, it seems like a correctness issue to be invoking them at all, since they could very well be gated on some condition, or even stateful.\n\n### Steps to reproduce\n\n1. Open the MRP\n2. Run the main scene\n3. Note the error in the Debugger tab\n\n### Minimal reproduction project (MRP)\n\n[string-format-object-getters.zip](https://github.com/user-attachments/files/30905482/string-format-object-getters.zip)","closed_by":{"login":"Repiteo","id":17489292,"node_id":"MDQ6VXNlcjE3NDg5Mjky","avatar_url":"https://avatars.githubusercontent.com/u/17489292?v=4","gravatar_id":"","url":"https://api.github.com/users/Repiteo","html_url":"https://github.com/Repiteo","followers_url":"https://api.github.com/users/Repiteo/followers","following_url":"https://api.github.com/users/Repiteo/following{/other_user}","gists_url":"https://api.github.com/users/Repiteo/gists{/gist_id}","starred_url":"https://api.github.com/users/Repiteo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Repiteo/subscriptions","organizations_url":"https://api.github.com/users/Repiteo/orgs","repos_url":"https://api.github.com/users/Repiteo/repos","events_url":"https://api.github.com/users/Repiteo/events{/privacy}","received_events_url":"https://api.github.com/users/Repiteo/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/122273/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/godotengine/godot/issues/122273/timeline","performed_via_github_app":null,"state_reason":"completed","pinned_comment":null}