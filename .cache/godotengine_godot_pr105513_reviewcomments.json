], and [method Input.is_action_pressed].\n+\t\t\tTo control this at runtime, use [member Input.joypad_enabled].","path":"doc/classes/ProjectSettings.xml","commit_id":"b132dfb28db6e938538ff78870bf01a07c58897d","original_commit_id":"70a12c57264b04f3ed5839991c828417e78323b4","user":{"login":"Mickeon","id":66727710,"node_id":"MDQ6VXNlcjY2NzI3NzEw","avatar_url":"https://avatars.githubusercontent.com/u/66727710?v=4","gravatar_id":"","url":"https://api.github.com/users/Mickeon","html_url":"https://github.com/Mickeon","followers_url":"https://api.github.com/users/Mickeon/followers","following_url":"https://api.github.com/users/Mickeon/following{/other_user}","gists_url":"https://api.github.com/users/Mickeon/gists{/gist_id}","starred_url":"https://api.github.com/users/Mickeon/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Mickeon/subscriptions","organizations_url":"https://api.github.com/users/Mickeon/orgs","repos_url":"https://api.github.com/users/Mickeon/repos","events_url":"https://api.github.com/users/Mickeon/events{/privacy}","received_events_url":"https://api.github.com/users/Mickeon/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"It sounds appropriate to mention the corresponding command line argument... somewhere in here. See how other ProjectSettings descriptions do it.","created_at":"2026-05-25T08:49:20Z","updated_at":"2026-05-25T09:02:35Z","html_url":"https://github.com/godotengine/godot/pull/105513#discussion_r3297084645","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/105513","_links":{"self":{"href":"https://api.github.com/repos/godotengine/godot/pulls/comments/3297084645"},"html":{"href":"https://github.com/godotengine/godot/pull/105513#discussion_r3297084645"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/105513"}},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/3297084645/reactions","total_count":0,"+1":0,"