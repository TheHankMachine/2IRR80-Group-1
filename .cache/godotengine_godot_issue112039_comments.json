DeeJayLSP/gists{/gist_id}","starred_url":"https://api.github.com/users/DeeJayLSP/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/DeeJayLSP/subscriptions","organizations_url":"https://api.github.com/users/DeeJayLSP/orgs","repos_url":"https://api.github.com/users/DeeJayLSP/repos","events_url":"https://api.github.com/users/DeeJayLSP/events{/privacy}","received_events_url":"https://api.github.com/users/DeeJayLSP/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-11-20T19:25:32Z","updated_at":"2025-11-20T20:06:34Z","body":"Interesting, in Gaijin's Bunnymark case, `RBMap` seems to be even faster than `AHashMap` with around 4x less CPU cycles being consumed.","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3559686536/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3560079868","html_url":"https://github.com/godotengine/godot/pull/112039#issuecomment-3560079868","issue_url":"https://api.github.com/repos/godotengine/godot/issues/112039","id":3560079868,"node_id":"IC_kwDOAO6SJc7UMoH8","user":{"login":"HolonProduction","id":99511741,"node_id":"U_kgDOBe5tvQ","avatar_url":"https://avatars.githubusercontent.com/u/99511741?v=4","gravatar_id":"","url":"https://api.github.com/users/HolonProduction","html_url":"https://github.com/HolonProduction","followers_url":"https://api.github.com/users/HolonProduction/followers","following_url":"https://api.github.com/users/HolonProduction/following{/other_user}","gists_url":"https://api.github.com/users/HolonProduction/gists{/gist_id}","starred_url":"https://api.github.com/users/HolonProduction/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/HolonProduction/subscriptions","organizations_url":"https://api.