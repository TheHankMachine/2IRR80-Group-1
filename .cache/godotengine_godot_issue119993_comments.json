[{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4616372114","html_url":"https://github.com/godotengine/godot/issues/119993#issuecomment-4616372114","issue_url":"https://api.github.com/repos/godotengine/godot/issues/119993","id":4616372114,"node_id":"IC_kwDOAO6SJc8AAAABEyg_kg","user":{"login":"clayjohn","id":16521339,"node_id":"MDQ6VXNlcjE2NTIxMzM5","avatar_url":"https://avatars.githubusercontent.com/u/16521339?v=4","gravatar_id":"","url":"https://api.github.com/users/clayjohn","html_url":"https://github.com/clayjohn","followers_url":"https://api.github.com/users/clayjohn/followers","following_url":"https://api.github.com/users/clayjohn/following{/other_user}","gists_url":"https://api.github.com/users/clayjohn/gists{/gist_id}","starred_url":"https://api.github.com/users/clayjohn/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/clayjohn/subscriptions","organizations_url":"https://api.github.com/users/clayjohn/orgs","repos_url":"https://api.github.com/users/clayjohn/repos","events_url":"https://api.github.com/users/clayjohn/events{/privacy}","received_events_url":"https://api.github.com/users/clayjohn/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-06-03T20:19:09Z","updated_at":"2026-06-03T20:19:09Z","body":"Confirmed locally. It seems our CPU-based DXT1 compression is really low quality for solid color blocks like in this texture. We are using etcpak for DXT1. We should see if there are tweakable quality settings that we can increase, otherwise, we need to investigate using a different texture compressor","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4616372114/reactions","total_count":2,"+1":2,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4616420475",