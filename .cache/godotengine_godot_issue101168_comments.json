following{/other_user}","gists_url":"https://api.github.com/users/fire/gists{/gist_id}","starred_url":"https://api.github.com/users/fire/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/fire/subscriptions","organizations_url":"https://api.github.com/users/fire/orgs","repos_url":"https://api.github.com/users/fire/repos","events_url":"https://api.github.com/users/fire/events{/privacy}","received_events_url":"https://api.github.com/users/fire/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-04-10T05:35:22Z","updated_at":"2025-04-10T05:35:22Z","body":"I wanted to note that we need to check for keyboard key conflicts with both maya and blender style.","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2791608872/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2791817279","html_url":"https://github.com/godotengine/godot/pull/101168#issuecomment-2791817279","issue_url":"https://api.github.com/repos/godotengine/godot/issues/101168","id":2791817279,"node_id":"IC_kwDOAO6SJc6mZ8A_","user":{"login":"ryevdokimov","id":105675984,"node_id":"U_kgDOBkx80A","avatar_url":"https://avatars.githubusercontent.com/u/105675984?v=4","gravatar_id":"","url":"https://api.github.com/users/ryevdokimov","html_url":"https://github.com/ryevdokimov","followers_url":"https://api.github.com/users/ryevdokimov/followers","following_url":"https://api.github.com/users/ryevdokimov/following{/other_user}","gists_url":"https://api.github.com/users/ryevdokimov/gists{/gist_id}","starred_url":"https://api.github.com/users/ryevdokimov/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/ryevdokimov/subscriptions","organizations_url":"https://api.github.com/users/ryevdokimov/orgs","repo