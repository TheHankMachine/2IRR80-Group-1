/graphific/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/graphific/subscriptions","organizations_url":"https://api.github.com/users/graphific/orgs","repos_url":"https://api.github.com/users/graphific/repos","events_url":"https://api.github.com/users/graphific/events{/privacy}","received_events_url":"https://api.github.com/users/graphific/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-01-07T23:42:58Z","updated_at":"2026-01-07T23:42:58Z","body":"Thanks for the review, added them in and also rebased the PR.","author_association":"NONE","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3721291164/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3723445700","html_url":"https://github.com/godotengine/godot/pull/113004#issuecomment-3723445700","issue_url":"https://api.github.com/repos/godotengine/godot/issues/113004","id":3723445700,"node_id":"IC_kwDOAO6SJc7d70XE","user":{"login":"graphific","id":10637696,"node_id":"MDQ6VXNlcjEwNjM3Njk2","avatar_url":"https://avatars.githubusercontent.com/u/10637696?v=4","gravatar_id":"","url":"https://api.github.com/users/graphific","html_url":"https://github.com/graphific","followers_url":"https://api.github.com/users/graphific/followers","following_url":"https://api.github.com/users/graphific/following{/other_user}","gists_url":"https://api.github.com/users/graphific/gists{/gist_id}","starred_url":"https://api.github.com/users/graphific/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/graphific/subscriptions","organizations_url":"https://api.github.com/users/graphific/orgs","repos_url":"https://api.github.com/users/graphific/repos","events_url":"https://api.github.com/users/graphific/events{/privacy}","received_events_url":"https://api.github.com/users/graphific/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-01-08T11:28:15Z","updated_at":"2026-01-08T11:28:15Z","body":"Forgot to run clang-format, should be fixed now. Bare with me :)","author_association":"NONE","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3723445700/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3923485949","html_url":"https://github.com/godotengine/godot/pull/113004#issuecomment-3923485949","issue_url":"https://api.github.com/repos/godotengine/godot/issues/113004","id":3923485949,"node_id":"IC_kwDOAO6SJc7p26T9","user":{"login":"KoBeWi","id":2223172,"node_id":"MDQ6VXNlcjIyMjMxNzI=","avatar_url":"https://avatars.githubusercontent.com/u/2223172?v=4","gravatar_id":"","url":"https://api.github.com/users/KoBeWi","html_url":"https://github.com/KoBeWi","followers_url":"https://api.github.com/users/KoBeWi/followers","following_url":"https://api.github.com/users/KoBeWi/following{/other_user}","gists_url":"https://api.github.com/users/KoBeWi/gists{/gist_id}","starred_url":"https://api.github.com/users/KoBeWi/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/KoBeWi/subscriptions","organizations_url":"https://api.github.com/users/KoBeWi/orgs","repos_url":"https://api.github.com/users/KoBeWi/repos","events_url":"https://api.github.com/users/KoBeWi/events{/privacy}","received_events_url":"https://api.github.com/users/KoBeWi/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-02-18T22:13:05Z","updated_at":"2026-02-18T22:13:05Z","body":"The way live editing works for most objects is that the editor forwards the EditorUndoRedoManager actions to the running game. E.g. when you change a property, the object, property and value can be easily identified from the undo action, so they can be replicated from debugger messages.\r\n\r\nAudio buses are special, because the Audio dock does not work on any real resource and instead it directly changes AudioServer. I wonder if the undo actions performed in AudioServer can be forwarded the same way it is done for other properties. It would make the code much simpler.\r\n\r\nNot saying the approach used in this PR is wrong. It's fine, if the alternative is not possible/feasible.","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3923485949/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4004668687","html_url":"https://github.com/godotengine/godot/pull/113004#issuecomment-4004668687","issue_url":"https://api.github.com/repos/godotengine/godot/issues/113004","id":4004668687,"node_id":"IC_kwDOAO6SJc7usmUP","user":{"login":"graphific","id":10637696,"node_id":"MDQ6VXNlcjEwNjM3Njk2","avatar_url":"https://avatars.githubusercontent.com/u/10637696?v=4","gravatar_id":"","url":"https://api.github.com/users/graphific","html_url":"https://github.com/graphific","followers_url":"https://api.github.com/users/graphific/followers","following_url":"https://api.github.com/users/graphific/following{/other_user}","gists_url":"https://api.github.com/users/graphific/gists{/gist_id}","starred_url":"https://api.github.com/users/graphific/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/graphific/subscriptions","organizations_url":"https://api.github.com/users/graphific/orgs","repos_url":"https://api.github.com/users/graphific/repos","events_url":"https://api.github.com/users/graphific/events{/privacy}","received_events_url":"https://api.github.com/users/graphific/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-03-05T12:19:18Z","updated_at":"2026-03-05T12:19:18Z","body":"Thanks @Calinou and @KoBeWi for the feedback! Per KoBeWi's suggestion I looked a bit more into the internals and indeed that would mean just one code path for most bus changes but with the current approach we send the full bus layout whenever something changes and apply it on the game side. That means one clear contract and one handler, and we can do the LCS thing for effects so we only touch what actually changed and avoid glitches. The downside is we have to call sync from a bunch of places in the Audio dock, and we send the whole layout each time (we do cache so we skip no-ops).\r\n\r\nThe alternative would be to forward the undo actions to the game like we (apparently already) do for other live editing. That would clean up the editor side and we wouldn’t need those sync calls everywhere. On the game side we’d have to handle lots of different method shapes, and `add_bus_effect` is awkward because we can’t send the effect object over the wire so we’d need some special protocol. Doing a minimal diff for effects (like LCS) also gets trickier when we’re replaying one action at a time.\r\n\r\nOn my own I think I'd be more confident in keeping the full-layout approach: simpler on the game side and we get the LCS behavior we want. The “forward undo for AudioServer” idea is a good one maybe for a follow-up if someone wants to refactor the editor side later?\r\n\r\nLet me know and I'll see if I can get this PR to a fully working state: Last weeks have been a bi hectic but  next week onwards i should have some time for this.","author_association":"NONE","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4004668687/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4006101454","html_url":"https://github.com/godotengine/godot/pull/113004#issuecomment-4006101454","issue_url":"https://api.github.com/repos/godotengine/godot/issues/113004","id":4006101454,"node_id":"IC_kwDOAO6SJc7uyEHO","user":{"login":"graphific","id":10637696,"node_id":"MDQ6VXNlcjEwNjM3Njk2","avatar_url":"https://avatars.githubusercontent.com/u/10637696?v=4","gravatar_id":"","url":"https://api.github.com/users/graphific","html_url":"https://github.com/graphific","followers_url":"https://api.github.com/users/graphific/followers","following_url":"https://api.github.com/users/graphific/following{/other_user}","gists_url":"https://api.github.com/users/graphific/gists{/gist_id}","starred_url":"https://api.github.com/users/graphific/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/graphific/subscriptions","organizations_url":"https://api.github.com/users/graphific/orgs","repos_url":"https://api.github.com/users/graphific/repos","events_url":"https://api.github.com/users/graphific/events{/privacy}","received_events_url":"https://api.github.com/users/graphific/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-03-05T16:00:09Z","updated_at":"2026-03-05T19:41:00Z","body":"Catching the dummy player and returning early + created `AudioServer::refresh_bus_effects` now called by `SceneDebugger::_msg_sync_audio_buses` after changing parameters so updated parameters (e.g. distortion drive) are used right away.\r\n\r\nedit: documentation for `refresh_bus_effects` added to the class reference (linux build check failed for that reason)","author_association":"NONE","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4006101454/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4011661346","html_url":"https://github.com/godotengine/godot/pull/113004#issuecomment-4011661346","issue_url":"https://api.github.com/repos/godotengine/godot/issues/113004","id":4011661346,"node_id":"IC_kwDOAO6SJc7vHRgi","user":{"login":"graphific","id":10637696,"node_id":"MDQ6VXNlcjEwNjM3Njk2","avatar_url":"https://avatars.githubusercontent.com/u/10637696?v=4","gravatar_id":"","url":"https://api.github.com/users/graphific","html_url":"https://github.com/graphific","followers_url":"https://api.github.com/users/graphific/followers","following_url":"https://api.github.com/users/graphific/following{/other_user}","gists_url":"https://api.github.com/users/graphific/gists{/gist_id}","starred_url":"https://api.github.com/users/graphific/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/graphific/subscriptions","organizations_url":"https://api.github.com/users/graphific/orgs","repos_url":"https://api.github.com/users/graphific/repos","events_url":"https://api.github.com/users/graphific/events{/privacy}","received_events_url":"https://api.github.com/users/graphific/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-03-06T13:09:53Z","updated_at":"2026-03-06T13:09:53Z","body":"Looks like failed test is just a intermittent outage for gradle so rerunning just that test should work\r\n`Exception in thread \"main\" java.io.IOException: Server returned HTTP response code: 503 for URL: https://github.com/gradle/gradle-distributions/releases/download/v8.11.1/gradle-8.11.1-bin.zip`","author_association":"NONE","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4011661346/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4030715857","html_url":"https://github.com/godotengine/godot/pull/113004#issuecomment-4030715857","issue_url":"https://api.github.com/repos/godotengine/godot/issues/113004","id":4030715857,"node_id":"IC_kwDOAO6SJc7wP9fR","user":{"login":"goatchurchprime","id":677254,"node_id":"MDQ6VXNlcjY3NzI1NA==","avatar_url":"https://avatars.githubusercontent.com/u/677254?v=4","gravatar_id":"","url":"https://api.github.com/users/goatchurchprime","html_url":"https://github.com/goatchurchprime","followers_url":"https://api.github.com/users/goatchurchprime/followers","following_url":"https://api.github.com/users/goatchurchprime/following{/other_user}","gists_url":"https://api.github.com/users/goatchurchprime/gists{/gist_id}","starred_url":"https://api.github.com/users/goatchurchprime/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/goatchurchprime/subscriptions","organizations_url":"https://api.github.com/users/goatchurchprime/orgs","repos_url":"https://api.github.com/users/goatchurchprime/repos","events_url":"https://api.github.com/users/goatchurchprime/events{/privacy}","received_events_url":"https://api.github.com/users/goatchurchprime/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-03-10T11:32:24Z","updated_at":"2026-03-10T11:32:24Z","body":"As I understand it this feature forwards the audio bus state changes from the editor to the game, but not the other way around (as is done with the scene tree under the Remote tab). \r\n\r\nThere's a problem with this idea since if the game has made any programmatic changes to its audio bus state (not uncommon) it will be unexpectedly over-written.  So to make this usable you'd have to have a Remote tab on the bus layout that reflected the game's state back to the editor, which would then be two-way synchronized.\r\n\r\nHere is the code I used in the debug project to check my assertion.\r\n```GDScript\r\nfunc _input(event):\r\n\tif event is InputEventKey and event.pressed and event.keycode == KEY_G:\r\n\t\tAudioServer.add_bus_effect(0, AudioEffectSpectrumAnalyzer.new())\r\n\t\tprint(\"effect added to bus0\")\r\n\tif event is InputEventKey and event.pressed and event.keycode == KEY_K:\r\n\t\tprint(\"effects on bus0 \", AudioServer.get_bus_effect_count(0))\r\n```\r\n\r\nIn my view, the audio bus system api is very primitive in comparison to the rest of godot.  The layout could instead be fully implemented in the scene tree with a system of nodes of type `AudioBus` containing lists of `AudioBusEffect` nodes that were read and encoded into the AudioServer when they changed.  Then the `default_bus_layout.tres` would simply be a `tscn` file you instantiated into your project.  If done this way, the layouts would be synchronized automatically as part of the scene tree with no further code.\r\n\r\nThere's another more sophisticated idea based on https://github.com/BuzzLord/godot-audio-spatializer where each `AudioStreamPlayer` contains its own audio bus to make accessible its internal spatializing effects (stereo panning, attenuation filter, doppler effect).  If these `AudioStreamPlayers` had the capability to feed streams one into another then the whole bus system becomes redundant. \r\n\r\nPlease feel free to find the audio channel in https://chat.godotengine.org/home and come to the audio group meetings where these issues are discussed.\r\n","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4030715857/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4046605003","html_url":"https://github.com/godotengine/godot/pull/113004#issuecomment-4046605003","issue_url":"https://api.github.com/repos/godotengine/godot/issues/113004","id":4046605003,"node_id":"IC_kwDOAO6SJc7xMkrL","user":{"login":"graphific","id":10637696,"node_id":"MDQ6VXNlcjEwNjM3Njk2","avatar_url":"https://avatars.githubusercontent.com/u/10637696?v=4","gravatar_id":"","url":"https://api.github.com/users/graphific","html_url":"https://github.com/graphific","followers_url":"https://api.github.com/users/graphific/followers","following_url":"https://api.github.com/users/graphific/following{/other_user}","gists_url":"https://api.github.com/users/graphific/gists{/gist_id}","starred_url":"https://api.github.com/users/graphific/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/graphific/subscriptions","organizations_url":"https://api.github.com/users/graphific/orgs","repos_url":"https://api.github.com/users/graphific/repos","events_url":"https://api.github.com/users/graphific/events{/privacy}","received_events_url":"https://api.github.com/users/graphific/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-03-12T13:04:44Z","updated_at":"2026-03-12T13:04:44Z","body":"> if the game has made any programmatic changes to its audio bus state (not uncommon) it will be unexpectedly over-written.\r\n\r\nYou're right that if the game has made any programmatic changes to its audio bus state it would be overwritten as its right now.\r\n\r\nI could change the sync so the editor only merges the project layout into the game: we add buses/effects and update properties when the editor has them, but we never remove buses or effects that the game added. So programmatic changes are preserved (merge/reconcile instead of overwrite).\r\n\r\nThat still doesn't fix the other half: the editor never sees what the game actually has. A full two-way remote does feel like a pretty big change, so might pop into an audio meeting to discuss more first as another PR as I'm sure there are a lot of ideas on this and already being discussed?\r\nIn that case the godot-audio-spatializer also look like a more worthwhile approach (but again a pretty big change)\r\n\r\nCould still be some useful things to reuse form here then like the syncing protocol + payload format, merge behavior, and the VU peaks/Dummy-driver handling.\r\n","author_association":"NONE","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4046605003/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4046648891","html_url":"https://github.com/godotengine/godot/pull/113004#issuecomment-4046648891","issue_url":"https://api.github.com/repos/godotengine/godot/issues/113004","id":4046648891,"node_id":"IC_kwDOAO6SJc7xMvY7","user":{"login":"KoBeWi","id":2223172,"node_id":"MDQ6VXNlcjIyMjMxNzI=","avatar_url":"https://avatars.githubusercontent.com/u/2223172?v=4","gravatar_id":"","url":"https://api.github.com/users/KoBeWi","html_url":"https://github.com/KoBeWi","followers_url":"https://api.github.com/users/KoBeWi/followers","following_url":"https://api.github.com/users/KoBeWi/following{/other_user}","gists_url":"https://api.github.com/users/KoBeWi/gists{/gist_id}","starred_url":"https://api.github.com/users/KoBeWi/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/KoBeWi/subscriptions","organizations_url":"https://api.github.com/users/KoBeWi/orgs","repos_url":"https://api.github.com/users/KoBeWi/repos","events_url":"https://api.github.com/users/KoBeWi/events{/privacy}","received_events_url":"https://api.github.com/users/KoBeWi/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-03-12T13:11:52Z","updated_at":"2026-03-12T13:11:52Z","body":"> if the game has made any programmatic changes to its audio bus state (not uncommon) it will be unexpectedly over-written.\r\n\r\nThat's the case with any live edit changes. E.g. you can move your player node in the editor and it will move in game, disregarding where the player has moved. The only difference is that with nodes you have access to remote scene tree. The audio bus is not available remotely, but that's a missing feature and can be implemented separately.","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4046648891/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4046893789","html_url":"https://github.com/godotengine/godot/pull/113004#issuecomment-4046893789","issue_url":"https://api.github.com/repos/godotengine/godot/issues/113004","id":4046893789,"node_id":"IC_kwDOAO6SJc7xNrLd","user":{"login":"graphific","id":10637696,"node_id":"MDQ6VXNlcjEwNjM3Njk2","avatar_url":"https://avatars.githubusercontent.com/u/10637696?v=4","gravatar_id":"","url":"https://api.github.com/users/graphific","html_url":"https://github.com/graphific","followers_url":"https://api.github.com/users/graphific/followers","following_url":"https://api.github.com/users/graphific/following{/other_user}","gists_url":"https://api.github.com/users/graphific/gists{/gist_id}","starred_url":"https://api.github.com/users/graphific/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/graphific/subscriptions","organizations_url":"https://api.github.com/users/graphific/orgs","repos_url":"https://api.github.com/users/graphific/repos","events_url":"https://api.github.com/users/graphific/events{/privacy}","received_events_url":"https://api.github.com/users/graphific/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-03-12T13:44:59Z","updated_at":"2026-03-12T13:44:59Z","body":"So what's your suggestion here @KoBeWi? to still patch this PR with the last proposed fix and get it into the engine OR wait for an overhaul of the audio system?","author_association":"NONE","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4046893789/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4049406051","html_url":"https://github.com/godotengine/godot/pull/113004#issuecomment-4049406051","issue_url":"https://api.github.com/repos/godotengine/godot/issues/113004","id":4049406051,"node_id":"IC_kwDOAO6SJc7xXQhj","user":{"login":"KoBeWi","id":2223172,"node_id":"MDQ6VXNlcjIyMjMxNzI=","avatar_url":"https://avatars.githubusercontent.com/u/2223172?v=4","gravatar_id":"","url":"https://api.github.com/users/KoBeWi","html_url":"https://github.com/KoBeWi","followers_url":"https://api.github.com/users/KoBeWi/followers","following_url":"https://api.github.com/users/KoBeWi/following{/other_user}","gists_url":"https://api.github.com/users/KoBeWi/gists{/gist_id}","starred_url":"https://api.github.com/users/KoBeWi/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/KoBeWi/subscriptions","organizations_url":"https://api.github.com/users/KoBeWi/orgs","repos_url":"https://api.github.com/users/KoBeWi/repos","events_url":"https://api.github.com/users/KoBeWi/events{/privacy}","received_events_url":"https://api.github.com/users/KoBeWi/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-03-12T19:21:45Z","updated_at":"2026-03-12T19:21:45Z","body":"I don't think overhaul is happening anytime soon, but I'm also not up to with audio team plans.\r\n\r\n> patch this PR with the last proposed fix \r\n\r\nYou mean my comment about undo/redo? Well, merging this and changing later would mean that all additions from this PR would have to be removed, as they are not really compatible with the other approach. The code would be probably simpler, but well, since it's already written, switching the solution does not matter that much. It makes many changes in the debugger, so needs to be reviewed with someone more familiar with that part of the editor.\r\n\r\nbtw I gave this a test and seems like changes in audio effect properties are not being synchronized. The PR needs some work either way.","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4049406051/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4106789198","html_url":"https://github.com/godotengine/godot/pull/113004#issuecomment-4106789198","issue_url":"https://api.github.com/repos/godotengine/godot/issues/113004","id":4106789198,"node_id":"IC_kwDOAO6SJc70yKFO","user":{"login":"KoBeWi","id":2223172,"node_id":"MDQ6VXNlcjIyMjMxNzI=","avatar_url":"https://avatars.githubusercontent.com/u/2223172?v=4","gravatar_id":"","url":"https://api.github.com/users/KoBeWi","html_url":"https://github.com/KoBeWi","followers_url":"https://api.github.com/users/KoBeWi/followers","following_url":"https://api.github.com/users/KoBeWi/following{/other_user}","gists_url":"https://api.github.com/users/KoBeWi/gists{/gist_id}","starred_url":"https://api.github.com/users/KoBeWi/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/KoBeWi/subscriptions","organizations_url":"https://api.github.com/users/KoBeWi/orgs","repos_url":"https://api.github.com/users/KoBeWi/repos","events_url":"https://api.github.com/users/KoBeWi/events{/privacy}","received_events_url":"https://api.github.com/users/KoBeWi/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-03-22T18:59:09Z","updated_at":"2026-03-22T18:59:09Z","body":"So I looked at the implementation of EditorAudioBuses and I see no reason why it has to be implemented as an editor directly over AudioServer. The edited AudioBusLayout could be set internally as \"current\" and automatically sync set properties with AudioServer. I'll try to make my own PR (not 100% it will work yet).","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4106789198/reactions","total_count":1,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":1},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5755180854","html_url":"https://github.com/godotengine/godot/pull/113004#issuecomment-5755180854","issue_url":"https://api.github.com/repos/godotengine/godot/issues/113004","id":5755180854,"node_id":"IC_kwDOAO6SJc8AAAABVwkXNg","user":{"login":"romgerman","id":1517367,"node_id":"MDQ6VXNlcjE1MTczNjc=","avatar_url":"https://avatars.githubusercontent.com/u/1517367?v=4","gravatar_id":"","url":"https://api.github.com/users/romgerman","html_url":"https://github.com/romgerman","followers_url":"https://api.github.com/users/romgerman/followers","following_url":"https://api.github.com/users/romgerman/following{/other_user}","gists_url":"https://api.github.com/users/romgerman/gists{/gist_id}","starred_url":"https://api.github.com/users/romgerman/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/romgerman/subscriptions","organizations_url":"https://api.github.com/users/romgerman/orgs","repos_url":"https://api.github.com/users/romgerman/repos","events_url":"https://api.github.com/users/romgerman/events{/privacy}","received_events_url":"https://api.github.com/users/romgerman/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-09-21T03:57:27Z","updated_at":"2026-09-21T03:57:27Z","body":"> I'll try to make my own PR (not 100% it will work yet).\r\n\r\nHey @KoBeWi any updates on this?","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5755180854/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5840196350","html_url":"https://github.com/godotengine/godot/pull/113004#issuecomment-5840196350","issue_url":"https://api.github.com/repos/godotengine/godot/issues/113004","id":5840196350,"node_id":"IC_kwDOAO6SJc8AAAABXBpS_g","user":{"login":"KoBeWi","id":2223172,"node_id":"MDQ6VXNlcjIyMjMxNzI=","avatar_url":"https://avatars.githubusercontent.com/u/2223172?v=4","gravatar_id":"","url":"https://api.github.com/users/KoBeWi","html_url":"https://github.com/KoBeWi","followers_url":"https://api.github.com/users/KoBeWi/followers","following_url":"https://api.github.com/users/KoBeWi/following{/other_user}","gists_url":"https://api.github.com/users/KoBeWi/gists{/gist_id}","starred_url":"https://api.github.com/users/KoBeWi/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/KoBeWi/subscriptions","organizations_url":"https://api.github.com/users/KoBeWi/orgs","repos_url":"https://api.github.com/users/KoBeWi/repos","events_url":"https://api.github.com/users/KoBeWi/events{/privacy}","received_events_url":"https://api.github.com/users/KoBeWi/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-09-25T21:54:27Z","updated_at":"2026-09-25T21:54:27Z","body":"I ran into #117753 while working on this. It causes newly created effects not getting sent to the running project, making bus syncing much less useful.","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5840196350/reactions","total_count":1,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":1},"performed_via_github_app":null,"minimized":null}]