[{"id":2834328955,"node_id":"PRR_kwDOAO6SJc6o8G17","state":"COMMENTED","commit_id":"5031343e53fd0f7f90c3cf3cc2f7c7d2fe7f2628","user":{"site_admin":false,"suspended":false,"updated_at":"0001-01-01T00:00:00Z","avatar_url":"https://avatars.githubusercontent.com/u/3903059?u=1b0467024f137e562b21748eb6bf12f97dfa5bf6&v=4","created_at":"0001-01-01T00:00:00Z","followers":0,"following":0,"html_url":"https://github.com/raulsntos","id":3903059,"node_id":"MDQ6VXNlcjM5MDMwNTk=","login":"raulsntos","type":"User","owned_private_repos":0,"public_gists":0,"public_repos":0,"total_private_repos":0,"url":"https://api.github.com/users/raulsntos"},"body":"Thanks for the contribution. I think it's a great idea to try and batch these updates if we can.\r\n\r\nI'm a bit concerned with moving the `EditorFileSystem::update_file` call from `CSharpScript::reload`, since there are many other places where this method is called besides `CSharpLanguage::reload_assemblies`, and we may want to make sure the `EditorFileSystem` is still updated in those cases.\r\n\r\nMaybe there's a way to queue these updates so they don't happen immediately, and instead the update happens once in the next frame (not sure if that may be too late).","html_url":"https://github.com/godotengine/godot/pull/106299#pullrequestreview-2834328955","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/106299","author_association":"MEMBER","submitted_at":"2025-05-12T19:58:33Z"},{"id":2951250054,"node_id":"PRR_kwDOAO6SJc6v6ICG","state":"COMMENTED","user":{"site_admin":false,"suspended":false,"updated_at":"0001-01-01T00:00:00Z","avatar_url":"https://avatars.githubusercontent.com/u/3903059?u=1b0467024f137e562b21748eb6bf12f97dfa5bf6&v=4","created_at":"0001-01-01T00:00:00Z","followers":0,"following":0,"html_url":"https://github.com/raulsntos","id":3903059,"node_id":"MDQ6VXNlcjM5MDMwNTk=","login":"raulsntos","type":"User","owned_private_repos":0,"public_gists":0,"public_repos":0,"total_private_repos":0,"url":"https://a