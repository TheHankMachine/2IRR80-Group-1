[{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2566058286","html_url":"https://github.com/godotengine/godot/pull/100965#issuecomment-2566058286","issue_url":"https://api.github.com/repos/godotengine/godot/issues/100965","id":2566058286,"node_id":"IC_kwDOAO6SJc6Y8vEu","user":{"login":"cixil","id":22418985,"node_id":"MDQ6VXNlcjIyNDE4OTg1","avatar_url":"https://avatars.githubusercontent.com/u/22418985?v=4","gravatar_id":"","url":"https://api.github.com/users/cixil","html_url":"https://github.com/cixil","followers_url":"https://api.github.com/users/cixil/followers","following_url":"https://api.github.com/users/cixil/following{/other_user}","gists_url":"https://api.github.com/users/cixil/gists{/gist_id}","starred_url":"https://api.github.com/users/cixil/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/cixil/subscriptions","organizations_url":"https://api.github.com/users/cixil/orgs","repos_url":"https://api.github.com/users/cixil/repos","events_url":"https://api.github.com/users/cixil/events{/privacy}","received_events_url":"https://api.github.com/users/cixil/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2024-12-31T01:30:24Z","updated_at":"2024-12-31T01:30:24Z","body":"@akien-mga ","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2566058286/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2577446818","html_url":"https://github.com/godotengine/godot/pull/100965#issuecomment-2577446818","issue_url":"https://api.github.com/repos/godotengine/godot/issues/100965","id":2577446818,"node_id":"IC_kwDOAO6SJc6ZoLei","user":{"login":"akien-mga","id":4701338,"node_id":"MDQ6VXNlcjQ3MDEzMzg=","avatar_url":"https://avatars.githubusercontent.com/u/4701338?v=4","gravatar_id":"","url":"https://api.github.com/users/akien-mga","html_url":"https://github.com/akien-mga","followers_url":"https://api.github.com/users/akien-mga/followers","following_url":"https://api.github.com/users/akien-mga/following{/other_user}","gists_url":"https://api.github.com/users/akien-mga/gists{/gist_id}","starred_url":"https://api.github.com/users/akien-mga/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/akien-mga/subscriptions","organizations_url":"https://api.github.com/users/akien-mga/orgs","repos_url":"https://api.github.com/users/akien-mga/repos","events_url":"https://api.github.com/users/akien-mga/events{/privacy}","received_events_url":"https://api.github.com/users/akien-mga/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-01-08T11:30:43Z","updated_at":"2025-01-08T11:30:43Z","body":"Could you amend the commit message to formatted like a normal sentence/commit title? E.g. like this PR's title.","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2577446818/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2578022384","html_url":"https://github.com/godotengine/godot/pull/100965#issuecomment-2578022384","issue_url":"https://api.github.com/repos/godotengine/godot/issues/100965","id":2578022384,"node_id":"IC_kwDOAO6SJc6ZqX_w","user":{"login":"cixil","id":22418985,"node_id":"MDQ6VXNlcjIyNDE4OTg1","avatar_url":"https://avatars.githubusercontent.com/u/22418985?v=4","gravatar_id":"","url":"https://api.github.com/users/cixil","html_url":"https://github.com/cixil","followers_url":"https://api.github.com/users/cixil/followers","following_url":"https://api.github.com/users/cixil/following{/other_user}","gists_url":"https://api.github.com/users/cixil/gists{/gist_id}","starred_url":"https://api.github.com/users/cixil/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/cixil/subscriptions","organizations_url":"https://api.github.com/users/cixil/orgs","repos_url":"https://api.github.com/users/cixil/repos","events_url":"https://api.github.com/users/cixil/events{/privacy}","received_events_url":"https://api.github.com/users/cixil/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-01-08T15:54:17Z","updated_at":"2025-02-06T19:27:51Z","body":"This and #97303 added tests to make sure signals are saved properly by `PackedScene`'s `pack` function.\r\n\r\nI wanted to add a test for the `GEN_EDIT_STATE_MAIN` thing, but I had no idea how to approach that, as I couldn't find how exports are tested.\r\nThe test would need to verify that signal connections are present in exported projects in addition to the issue in #66154","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2578022384/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":{"reason":"outdated"}},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2578845534","html_url":"https://github.com/godotengine/godot/pull/100965#issuecomment-2578845534","issue_url":"https://api.github.com/repos/godotengine/godot/issues/100965","id":2578845534,"node_id":"IC_kwDOAO6SJc6Ztg9e","user":{"login":"KoBeWi","id":2223172,"node_id":"MDQ6VXNlcjIyMjMxNzI=","avatar_url":"https://avatars.githubusercontent.com/u/2223172?v=4","gravatar_id":"","url":"https://api.github.com/users/KoBeWi","html_url":"https://github.com/KoBeWi","followers_url":"https://api.github.com/users/KoBeWi/followers","following_url":"https://api.github.com/users/KoBeWi/following{/other_user}","gists_url":"https://api.github.com/users/KoBeWi/gists{/gist_id}","starred_url":"https://api.github.com/users/KoBeWi/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/KoBeWi/subscriptions","organizations_url":"https://api.github.com/users/KoBeWi/orgs","repos_url":"https://api.github.com/users/KoBeWi/repos","events_url":"https://api.github.com/users/KoBeWi/events{/privacy}","received_events_url":"https://api.github.com/users/KoBeWi/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-01-08T23:03:43Z","updated_at":"2025-01-08T23:04:17Z","body":"This causes the issue I mentioned in https://github.com/godotengine/godot/issues/100097#issuecomment-2525332649\r\nIn my plugin I remove part of the scene, pack it and then re-instantiate (sort of built-in PackedScene). This PR makes the signals stripped with this operation.\r\nMRP:\r\n[Brokensignals.zip](https://github.com/user-attachments/files/18353961/Brokensignals.zip)\r\nOpen the Bug bottom panel and click the buttons.\r\n\r\nI'm not sure how this could be resolved though. Maybe don't apply `CONNECT_INHERITED` when edit state is 0? Though it's such a corner-case that it's probably not blocking this PR.\r\nMy workaround is manually stripping the flag from signals. It's unexposed though, which makes it even more hacky.","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2578845534/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2580863439","html_url":"https://github.com/godotengine/godot/pull/100965#issuecomment-2580863439","issue_url":"https://api.github.com/repos/godotengine/godot/issues/100965","id":2580863439,"node_id":"IC_kwDOAO6SJc6Z1NnP","user":{"login":"cixil","id":22418985,"node_id":"MDQ6VXNlcjIyNDE4OTg1","avatar_url":"https://avatars.githubusercontent.com/u/22418985?v=4","gravatar_id":"","url":"https://api.github.com/users/cixil","html_url":"https://github.com/cixil","followers_url":"https://api.github.com/users/cixil/followers","following_url":"https://api.github.com/users/cixil/following{/other_user}","gists_url":"https://api.github.com/users/cixil/gists{/gist_id}","starred_url":"https://api.github.com/users/cixil/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/cixil/subscriptions","organizations_url":"https://api.github.com/users/cixil/orgs","repos_url":"https://api.github.com/users/cixil/repos","events_url":"https://api.github.com/users/cixil/events{/privacy}","received_events_url":"https://api.github.com/users/cixil/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-01-09T17:21:32Z","updated_at":"2025-01-09T17:21:32Z","body":"> This causes the issue I mentioned in https://github.com/godotengine/godot/issues/100097#issuecomment-2525332649\r\n\r\nI feel like its better practice to save the button as a separate scene and just instantiate that, which solves the issue. Unless that somehow doesn't work for your original use case\r\n\r\n```\r\n@export var button_scene:PackedScene\r\n...\r\n\tfor i in 10:\r\n\t\tadd_child(button_scene.instantiate())\r\n```\r\n\r\n---\r\nBut I'd hate to break something else by fixing something. This probably deserves a little bit more testing to see if this case affects any other scenarios before its merged.","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2580863439/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2580866785","html_url":"https://github.com/godotengine/godot/pull/100965#issuecomment-2580866785","issue_url":"https://api.github.com/repos/godotengine/godot/issues/100965","id":2580866785,"node_id":"IC_kwDOAO6SJc6Z1Obh","user":{"login":"cixil","id":22418985,"node_id":"MDQ6VXNlcjIyNDE4OTg1","avatar_url":"https://avatars.githubusercontent.com/u/22418985?v=4","gravatar_id":"","url":"https://api.github.com/users/cixil","html_url":"https://github.com/cixil","followers_url":"https://api.github.com/users/cixil/followers","following_url":"https://api.github.com/users/cixil/following{/other_user}","gists_url":"https://api.github.com/users/cixil/gists{/gist_id}","starred_url":"https://api.github.com/users/cixil/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/cixil/subscriptions","organizations_url":"https://api.github.com/users/cixil/orgs","repos_url":"https://api.github.com/users/cixil/repos","events_url":"https://api.github.com/users/cixil/events{/privacy}","received_events_url":"https://api.github.com/users/cixil/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-01-09T17:23:23Z","updated_at":"2025-01-09T17:23:23Z","body":"Did #100160 solve this case?","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2580866785/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2581200244","html_url":"https://github.com/godotengine/godot/pull/100965#issuecomment-2581200244","issue_url":"https://api.github.com/repos/godotengine/godot/issues/100965","id":2581200244,"node_id":"IC_kwDOAO6SJc6Z2f10","user":{"login":"KoBeWi","id":2223172,"node_id":"MDQ6VXNlcjIyMjMxNzI=","avatar_url":"https://avatars.githubusercontent.com/u/2223172?v=4","gravatar_id":"","url":"https://api.github.com/users/KoBeWi","html_url":"https://github.com/KoBeWi","followers_url":"https://api.github.com/users/KoBeWi/followers","following_url":"https://api.github.com/users/KoBeWi/following{/other_user}","gists_url":"https://api.github.com/users/KoBeWi/gists{/gist_id}","starred_url":"https://api.github.com/users/KoBeWi/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/KoBeWi/subscriptions","organizations_url":"https://api.github.com/users/KoBeWi/orgs","repos_url":"https://api.github.com/users/KoBeWi/repos","events_url":"https://api.github.com/users/KoBeWi/events{/privacy}","received_events_url":"https://api.github.com/users/KoBeWi/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-01-09T20:36:20Z","updated_at":"2025-01-09T20:36:20Z","body":"Yes.\r\n\r\n> I feel like its better practice to save the button as a separate scene and just instantiate that\r\n\r\nThe point is to avoid excessive scenes, like with built-in scripts. It's a niche use-case though, so it's something that can be fixed later (or not, as there is workaround).","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2581200244/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2623416025","html_url":"https://github.com/godotengine/godot/pull/100965#issuecomment-2623416025","issue_url":"https://api.github.com/repos/godotengine/godot/issues/100965","id":2623416025,"node_id":"IC_kwDOAO6SJc6cXibZ","user":{"login":"cixil","id":22418985,"node_id":"MDQ6VXNlcjIyNDE4OTg1","avatar_url":"https://avatars.githubusercontent.com/u/22418985?v=4","gravatar_id":"","url":"https://api.github.com/users/cixil","html_url":"https://github.com/cixil","followers_url":"https://api.github.com/users/cixil/followers","following_url":"https://api.github.com/users/cixil/following{/other_user}","gists_url":"https://api.github.com/users/cixil/gists{/gist_id}","starred_url":"https://api.github.com/users/cixil/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/cixil/subscriptions","organizations_url":"https://api.github.com/users/cixil/orgs","repos_url":"https://api.github.com/users/cixil/repos","events_url":"https://api.github.com/users/cixil/events{/privacy}","received_events_url":"https://api.github.com/users/cixil/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-01-30T03:04:30Z","updated_at":"2025-02-06T19:29:05Z","body":"Was just revisiting and wanted to clarify the issue in case anyone else reviews this PR\r\n\r\nThe idea of this PR is, when packing a scene, to totally ignore connections that are in child scene instances (because those are saved within the scene instance). Hence we ignore connections when they have the CONNECT_INHERITED flag\r\n\r\nI believe @kobewi's bug is the case where an *instance* of a scene is packing its own local child node into a scene, and of course any signal connections of that child node will have the flag and thus be falsely ignored.\r\n\r\nIf the PR were merged there would be a workaround for this edge case, as @kobewi mentioned: stripping the `CONNECT_INHERITED` flags from connections of child nodes before packing them. Whereas for the bug this PR fixes, there is no workaround. \r\n\r\n\r\nEDIT: Nevermind, I think I found a better way to do this that resolves the edge case, will try to push this week","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2623416025/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":{"reason":"outdated"}},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2631290368","html_url":"https://github.com/godotengine/godot/pull/100965#issuecomment-2631290368","issue_url":"https://api.github.com/repos/godotengine/godot/issues/100965","id":2631290368,"node_id":"IC_kwDOAO6SJc6c1k4A","user":{"login":"cixil","id":22418985,"node_id":"MDQ6VXNlcjIyNDE4OTg1","avatar_url":"https://avatars.githubusercontent.com/u/22418985?v=4","gravatar_id":"","url":"https://api.github.com/users/cixil","html_url":"https://github.com/cixil","followers_url":"https://api.github.com/users/cixil/followers","following_url":"https://api.github.com/users/cixil/following{/other_user}","gists_url":"https://api.github.com/users/cixil/gists{/gist_id}","starred_url":"https://api.github.com/users/cixil/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/cixil/subscriptions","organizations_url":"https://api.github.com/users/cixil/orgs","repos_url":"https://api.github.com/users/cixil/repos","events_url":"https://api.github.com/users/cixil/events{/privacy}","received_events_url":"https://api.github.com/users/cixil/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-02-03T15:13:55Z","updated_at":"2025-02-03T15:13:55Z","body":"I have not found a resolution to that bug but I think I have found other places where connections are falsely ignored. This PR should NOT be merged until it is updated .","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2631290368/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2640084435","html_url":"https://github.com/godotengine/godot/pull/100965#issuecomment-2640084435","issue_url":"https://api.github.com/repos/godotengine/godot/issues/100965","id":2640084435,"node_id":"IC_kwDOAO6SJc6dXH3T","user":{"login":"cixil","id":22418985,"node_id":"MDQ6VXNlcjIyNDE4OTg1","avatar_url":"https://avatars.githubusercontent.com/u/22418985?v=4","gravatar_id":"","url":"https://api.github.com/users/cixil","html_url":"https://github.com/cixil","followers_url":"https://api.github.com/users/cixil/followers","following_url":"https://api.github.com/users/cixil/following{/other_user}","gists_url":"https://api.github.com/users/cixil/gists{/gist_id}","starred_url":"https://api.github.com/users/cixil/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/cixil/subscriptions","organizations_url":"https://api.github.com/users/cixil/orgs","repos_url":"https://api.github.com/users/cixil/repos","events_url":"https://api.github.com/users/cixil/events{/privacy}","received_events_url":"https://api.github.com/users/cixil/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-02-06T15:06:09Z","updated_at":"2025-03-20T23:50:46Z","body":"## PR Update\r\nI redid the whole PR. The current solution fixes the issues and does not cause the bug mentioned by Kobewi above.\r\n\r\n#### Problem\r\nSignals are being saved to packed scene when they should be ignored in these cases:\r\n- connection from editable instance child to other editable instance child/root (made within the instance, not the scene they are editable to)\r\n- connection from root of instanced scene to itself or its children (within the instance)\r\n\r\n#### Reasoning\r\nConsider the case where the root node of an instanced scene has a signal connected to itself. There can be such a connection within the scene itself, and also such a connection made by the scene containing it. Therefor when packing the scene, there must be a way to distinguish which scene a connection belongs to based on the connection itself, not just the node it comes from and goes to. \r\n\r\n#### Solution\r\nWhen instantiate is called, a unique id for the scene is assigned to and shared by every node and signal connection in that scene. There is one unique id per scene instance. This id is different from `owner` as it is also applied to connections, it doesn't require nodes to be in the SceneTree, and a scene owner node will have the same id as the nodes it \"owns\". If a node is packed as a scene,  only connections with the same id as that node are packed, thus ignoring any connections that belong to other scenes.\r\n","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2640084435/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2640544559","html_url":"https://github.com/godotengine/godot/pull/100965#issuecomment-2640544559","issue_url":"https://api.github.com/repos/godotengine/godot/issues/100965","id":2640544559,"node_id":"IC_kwDOAO6SJc6dY4Mv","user":{"login":"cixil","id":22418985,"node_id":"MDQ6VXNlcjIyNDE4OTg1","avatar_url":"https://avatars.githubusercontent.com/u/22418985?v=4","gravatar_id":"","url":"https://api.github.com/users/cixil","html_url":"https://github.com/cixil","followers_url":"https://api.github.com/users/cixil/followers","following_url":"https://api.github.com/users/cixil/following{/other_user}","gists_url":"https://api.github.com/users/cixil/gists{/gist_id}","starred_url":"https://api.github.com/users/cixil/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/cixil/subscriptions","organizations_url":"https://api.github.com/users/cixil/orgs","repos_url":"https://api.github.com/users/cixil/repos","events_url":"https://api.github.com/users/cixil/events{/privacy}","received_events_url":"https://api.github.com/users/cixil/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-02-06T17:30:48Z","updated_at":"2025-02-09T23:54:14Z","body":"This is ready for feedback.\r\n\r\nThe code is finished but the tests for signal packing from my old PR need rewritten. I wanted to get feedback that this is a viable solution before writing tests.","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godoteng