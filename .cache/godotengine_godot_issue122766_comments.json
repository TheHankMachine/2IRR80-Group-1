[{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5588464956","html_url":"https://github.com/godotengine/godot/pull/122766#issuecomment-5588464956","issue_url":"https://api.github.com/repos/godotengine/godot/issues/122766","id":5588464956,"node_id":"IC_kwDOAO6SJc8AAAABTRk1PA","user":{"login":"CoolBeansStudioOfficial","id":134745254,"node_id":"U_kgDOCAgMpg","avatar_url":"https://avatars.githubusercontent.com/u/134745254?v=4","gravatar_id":"","url":"https://api.github.com/users/CoolBeansStudioOfficial","html_url":"https://github.com/CoolBeansStudioOfficial","followers_url":"https://api.github.com/users/CoolBeansStudioOfficial/followers","following_url":"https://api.github.com/users/CoolBeansStudioOfficial/following{/other_user}","gists_url":"https://api.github.com/users/CoolBeansStudioOfficial/gists{/gist_id}","starred_url":"https://api.github.com/users/CoolBeansStudioOfficial/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/CoolBeansStudioOfficial/subscriptions","organizations_url":"https://api.github.com/users/CoolBeansStudioOfficial/orgs","repos_url":"https://api.github.com/users/CoolBeansStudioOfficial/repos","events_url":"https://api.github.com/users/CoolBeansStudioOfficial/events{/privacy}","received_events_url":"https://api.github.com/users/CoolBeansStudioOfficial/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-09-08T16:28:57Z","updated_at":"2026-09-08T16:28:57Z","body":"Heck yeah there is interest for this! Hope to see this merged in some capacity soon","author_association":"NONE","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5588464956/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5588663086","html_url":"https://github.com/godotengine/godot/pull/122766#issuecomment-5588663086","issue_url":"https://api.github.com/repos/godotengine/godot/issues/122766","id":5588663086,"node_id":"IC_kwDOAO6SJc8AAAABTRw7Lg","user":{"login":"NoctemCat","id":22471296,"node_id":"MDQ6VXNlcjIyNDcxMjk2","avatar_url":"https://avatars.githubusercontent.com/u/22471296?v=4","gravatar_id":"","url":"https://api.github.com/users/NoctemCat","html_url":"https://github.com/NoctemCat","followers_url":"https://api.github.com/users/NoctemCat/followers","following_url":"https://api.github.com/users/NoctemCat/following{/other_user}","gists_url":"https://api.github.com/users/NoctemCat/gists{/gist_id}","starred_url":"https://api.github.com/users/NoctemCat/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/NoctemCat/subscriptions","organizations_url":"https://api.github.com/users/NoctemCat/orgs","repos_url":"https://api.github.com/users/NoctemCat/repos","events_url":"https://api.github.com/users/NoctemCat/events{/privacy}","received_events_url":"https://api.github.com/users/NoctemCat/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-09-08T16:44:58Z","updated_at":"2026-09-08T16:44:58Z","body":"Sorry I'm kind of torn on this being in the Godot itself (this is just a proof this is possible), but this really looks like it could be implemented as a third-party nuget package if this gets fixed https://github.com/godotengine/godot/issues/91999. It's currently not possible to disable several generators at once and using `DisableImplicitGodotGeneratorReferences` is just too much work.","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5588663086/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5592490822","html_url":"https://github.com/godotengine/godot/pull/122766#issuecomment-5592490822","issue_url":"https://api.github.com/repos/godotengine/godot/issues/122766","id":5592490822,"node_id":"IC_kwDOAO6SJc8AAAABTVajRg","user":{"login":"Algost","id":48058319,"node_id":"MDQ6VXNlcjQ4MDU4MzE5","avatar_url":"https://avatars.githubusercontent.com/u/48058319?v=4","gravatar_id":"","url":"https://api.github.com/users/Algost","html_url":"https://github.com/Algost","followers_url":"https://api.github.com/users/Algost/followers","following_url":"https://api.github.com/users/Algost/following{/other_user}","gists_url":"https://api.github.com/users/Algost/gists{/gist_id}","starred_url":"https://api.github.com/users/Algost/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Algost/subscriptions","organizations_url":"https://api.github.com/users/Algost/orgs","repos_url":"https://api.github.com/users/Algost/repos","events_url":"https://api.github.com/users/Algost/events{/privacy}","received_events_url":"https://api.github.com/users/Algost/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-09-08T22:04:42Z","updated_at":"2026-09-08T22:04:42Z","body":"Hi, beginner here, but does this PR could resolve the following problem that i can't serialize my class into ressources like i did in Unity. I would love to be able to do `[Serializable] class HappinessStats { ... }` instead of creating a resourceType and a script for each field.\r\n\r\nI'm a beginner programmer, but what i hate the most about Godot atm is this issue, for our current project we need to do a lot of manual field copying and create more resources than expected in the first place...very boring :( \r\n\r\nCheers guys","author_association":"NONE","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5592490822/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5592764131","html_url":"https://github.com/godotengine/godot/pull/122766#issuecomment-5592764131","issue_url":"https://api.github.com/repos/godotengine/godot/issues/122766","id":5592764131,"node_id":"IC_kwDOAO6SJc8AAAABTVrO4w","user":{"login":"NoctemCat","id":22471296,"node_id":"MDQ6VXNlcjIyNDcxMjk2","avatar_url":"https://avatars.githubusercontent.com/u/22471296?v=4","gravatar_id":"","url":"https://api.github.com/users/NoctemCat","html_url":"https://github.com/NoctemCat","followers_url":"https://api.github.com/users/NoctemCat/followers","following_url":"https://api.github.com/users/NoctemCat/following{/other_user}","gists_url":"https://api.github.com/users/NoctemCat/gists{/gist_id}","starred_url":"https://api.github.com/users/NoctemCat/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/NoctemCat/subscriptions","organizations_url":"https://api.github.com/users/NoctemCat/orgs","repos_url":"https://api.github.com/users/NoctemCat/repos","events_url":"https://api.github.com/users/NoctemCat/events{/privacy}","received_events_url":"https://api.github.com/users/NoctemCat/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-09-08T22:31:10Z","updated_at":"2026-09-08T22:31:10Z","body":"It does and it doesn't, the data is embedded in the outer Godot type so Godot thinks that these properties are properties of the outer type.\r\n\r\nAnd it relies on the usage of `[Export]` inside the custom type to detect what properties to add and how to set and get them in a way Godot understands, so I don't think the amount of work will change. Maybe it will lead to having less files around as you can embed the type from anywhere, but that should be all. I guess this could be modified to support all public compatible properties, but it was too different from existing system for my tastes.\r\n\r\nI guess I could try creating such nuget package after https://github.com/godotengine/godot/issues/91999 is fixed as I'm more lenient for things that wouldn't be a part of Godot.\r\n\r\nAlso if you are creating a separate type for each field just to group them I would recommend using [`[ExportGroup]`](https://docs.godotengine.org/en/stable/tutorials/scripting/c_sharp/c_sharp_exports.html#grouping-exports) to group the related data instead.","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5592764131/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5593475564","html_url":"https://github.com/godotengine/godot/pull/122766#issuecomment-5593475564","issue_url":"https://api.github.com/repos/godotengine/godot/issues/122766","id":5593475564,"node_id":"IC_kwDOAO6SJc8AAAABTWWp7A","user":{"login":"CoolBeansStudioOfficial","id":134745254,"node_id":"U_kgDOCAgMpg","avatar_url":"https://avatars.githubusercontent.com/u/134745254?v=4","gravatar_id":"","url":"https://api.github.com/users/CoolBeansStudioOfficial","html_url":"https://github.com/CoolBeansStudioOfficial","followers_url":"https://api.github.com/users/CoolBeansStudioOfficial/followers","following_url":"https://api.github.com/users/CoolBeansStudioOfficial/following{/other_user}","gists_url":"https://api.github.com/users/CoolBeansStudioOfficial/gists{/gist_id}","starred_url":"https://api.github.com/users/CoolBeansStudioOfficial/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/CoolBeansStudioOfficial/subscriptions","organizations_url":"https://api.github.com/users/CoolBeansStudioOfficial/orgs","repos_url":"https://api.github.com/users/CoolBeansStudioOfficial/repos","events_url":"https://api.github.com/users/CoolBeansStudioOfficial/events{/privacy}","received_events_url":"https://api.github.com/users/CoolBeansStudioOfficial/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-09-08T23:43:35Z","updated_at":"2026-09-08T23:43:35Z","body":"It would be extremely helpful for me and a lot of other users to have this functionality directly in the editor instead of as a separate NuGet package. It would be a massive user experience improvement if you could just serialize your structs instead of having to either create a whole new node type for it or serializing each value individually","author_association":"NONE","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5593475564/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5593513795","html_url":"https://github.com/godotengine/godot/pull/122766#issuecomment-5593513795","issue_url":"https://api.github.com/repos/godotengine/godot/issues/122766","id":5593513795,"node_id":"IC_kwDOAO6SJc8AAAABTWY_Qw","user":{"login":"NoctemCat","id":22471296,"node_id":"MDQ6VXNlcjIyNDcxMjk2","avatar_url":"https://avatars.githubusercontent.com/u/22471296?v=4","gravatar_id":"","url":"https://api.github.com/users/NoctemCat","html_url":"https://github.com/NoctemCat","followers_url":"https://api.github.com/users/NoctemCat/followers","following_url":"https://api.github.com/users/NoctemCat/following{/other_user}","gists_url":"https://api.github.com/users/NoctemCat/gists{/gist_id}","starred_url":"https://api.github.com/users/NoctemCat/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/NoctemCat/subscriptions","organizations_url":"https://api.github.com/users/NoctemCat/orgs","repos_url":"https://api.github.com/users/NoctemCat/repos","events_url":"https://api.github.com/users/NoctemCat/events{/privacy}","received_events_url":"https://api.github.com/users/NoctemCat/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-09-08T23:46:54Z","updated_at":"2026-09-08T23:53:50Z","body":"The possible nuget package will disable a couple of native Source Generators related to properties and take over them, so it still will work with the normal C# editor.\r\n\r\nAlso this has nothing to do with serialization, C# has a much better serialization libraries that can be used with custom types, this is mainly for editor integration of custom types so you could easily edit them.","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5593513795/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5593724006","html_url":"https://github.com/godotengine/godot/pull/122766#issuecomment-5593724006","issue_url":"https://api.github.com/repos/godotengine/godot/issues/122766","id":5593724006,"node_id":"IC_kwDOAO6SJc8AAAABTWl0Zg","user":{"login":"CoolBeansStudioOfficial","id":134745254,"node_id":"U_kgDOCAgMpg","avatar_url":"https://avatars.githubusercontent.com/u/134745254?v=4","gravatar_id":"","url":"https://api.github.com/users/CoolBeansStudioOfficial","html_url":"https://github.com/CoolBeansStudioOfficial","followers_url":"https://api.github.com/users/CoolBeansStudioOfficial/followers","following_url":"https://api.github.com/users/CoolBeansStudioOfficial/following{/other_user}","gists_url":"https://api.github.com/users/CoolBeansStudioOfficial/gists{/gist_id}","starred_url":"https://api.github.com/users/CoolBeansStudioOfficial/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/CoolBeansStudioOfficial/subscriptions","organizations_url":"https://api.github.com/users/CoolBeansStudioOfficial/orgs","repos_url":"https://api.github.com/users/CoolBeansStudioOfficial/repos","events_url":"https://api.github.com/users/CoolBeansStudioOfficial/events{/privacy}","received_events_url":"https://api.github.com/users/CoolBeansStudioOfficial/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-09-09T00:12:08Z","updated_at":"2026-09-09T00:12:08Z","body":"Sorry. I am used to calling it serialization from Unity. I meant [Export]","author_association":"NONE","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5593724006/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5594226508","html_url":"https://github.com/godotengine/godot/pull/122766#issuecomment-5594226508","issue_url":"https://api.github.com/repos/godotengine/godot/issues/122766","id":5594226508,"node_id":"IC_kwDOAO6SJc8AAAABTXEfTA","user":{"login":"CoolBeansStudioOfficial","id":134745254,"node_id":"U_kgDOCAgMpg","avatar_url":"https://avatars.githubusercontent.com/u/134745254?v=4","gravatar_id":"","url":"https://api.github.com/users/CoolBeansStudioOfficial","html_url":"https://github.com/CoolBeansStudioOfficial","followers_url":"https://api.github.com/users/CoolBeansStudioOfficial/followers","following_url":"https://api.github.com/users/CoolBeansStudioOfficial/following{/other_user}","gists_url":"https://api.github.com/users/CoolBeansStudioOfficial/gists{/gist_id}","starred_url":"https://api.github.com/users/CoolBeansStudioOfficial/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/CoolBeansStudioOfficial/subscriptions","organizations_url":"https://api.github.com/users/CoolBeansStudioOfficial/orgs","repos_url":"https://api.github.com/users/CoolBeansStudioOfficial/repos","events_url":"https://api.github.com/users/CoolBeansStudioOfficial/events{/privacy}","received_events_url":"https://api.github.com/users/CoolBeansStudioOfficial/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-09-09T01:11:06Z","updated_at":"2026-09-09T01:11:06Z","body":"The exact scenario this change would fix actually happened to me today.\r\n\r\nI had created a struct for configuring the drawing of a custom node I made\r\n\r\n```\r\nstruct MarksOptions\r\n{\r\n    // how many marks to draw\r\n    public int MarkCount = 1;\r\n    // how much of the divided up space for a mark should the mark actually draw to\r\n    // 0f = no width, leaving a blank image, 1f = full width, leaving no gaps between marks\r\n    // (marks align left)\r\n    public float MarkWidth = 0.25f;\r\n    // the maximum width of a mark in pixels\r\n    public int MarkMaxWidth = 10;\r\n    // how submarks should align themselves\r\n    public VerticalAlignment MarkAlignment = VerticalAlignment.Bottom;\r\n    // the color to use for the first mark\r\n    public Color MarkColor = Colors.White;\r\n    // the color to use for all subsequent marks\r\n    public Color SubmarkColor = Colors.LightSlateGray;\r\n    // how tall submarks should be in comparison to the first mark \r\n    // 0f = no height, 1f = as tall as the first mark\r\n    public float Ratio = 0.5f;\r\n    // how rounded the corners of the marks should be\r\n    // 0f = no rounding, 1f = fully rounded\r\n    public float CornerRounding = 0.5f;\r\n\r\n    public MarksOptions()\r\n    {\r\n    }\r\n}\r\n```\r\nAnd I tried to [Export] it like this\r\n```\r\n[Export] MarksOptions options;\r\n```\r\nBut alas, Godot said no. I ended up having to do this instead\r\n```\r\n[ExportGroup(\"Mark Options\")]\r\n\r\n[Export] float markWidth = 0.25f;\r\n[Export] int markMaxWidth = 10;\r\n[Export] VerticalAlignment markAlignment = VerticalAlignment.Bottom;\r\n[Export] Color markColor;\r\n[Export] Color submarkColor;\r\n[Export] float ratio = 0.5f;\r\n[Export] float cornerRounding = 0.5f;\r\n\r\nMarksOptions GetOptions()\r\n{\r\n    return new()\r\n\t{\r\n\t\tMarkWidth = markWidth,\r\n\t\tMarkMaxWidth = markMaxWidth,\r\n\t\tMarkAlignment = markAlignment,\r\n\t\tMarkColor = markColor,\r\n\t\tSubmarkColor = submarkColor,\r\n\t\tRatio = ratio,\r\n\t\tCornerRounding = cornerRounding\r\n\t};\r\n}\r\n```\r\nWhy??? Why must we suffer so?","author_association":"NONE","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5594226508/reactions","total_count":2,"+1":2,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/6042638706","html_url":"https://github.com/godotengine/godot/pull/122766#issuecomment-6042638706","issue_url":"https://api.github.com/repos/godotengine/godot/issues/122766","id":6042638706,"node_id":"IC_kwDOAO6SJc8AAAABaCtZcg","user":{"login":"Algost","id":48058319,"node_id":"MDQ6VXNlcjQ4MDU4MzE5","avatar_url":"https://avatars.githubusercontent.com/u/48058319?v=4","gravatar_id":"","url":"https://api.github.com/users/Algost","html_url":"https://github.com/Algost","followers_url":"https://api.github.com/users/Algost/followers","following_url":"https://api.github.com/users/Algost/following{/other_user}","gists_url":"https://api.github.com/users/Algost/gists{/gist_id}","starred_url":"https://api.github.com/users/Algost/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Algost/subscriptions","organizations_url":"https://api.github.com/users/Algost/orgs","repos_url":"https://api.github.com/users/Algost/repos","events_url":"https://api.github.com/users/Algost/events{/privacy}","received_events_url":"https://api.github.com/users/Algost/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-10-07T16:51:18Z","updated_at":"2026-10-07T16:51:18Z","body":"Hi, maybe i'm off topic, but does this plugin resolve a bit of the issues ? : https://store.godotengine.org/asset/xesa/expose-them-properties/\r\nVideo : https://www.youtube.com/watch?v=ypFo2bMfSHQ\r\n","author_association":"NONE","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/6042638706/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null}]