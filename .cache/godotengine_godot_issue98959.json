\n00\r\n09\r\na00\r\nff00\r\n```\r\n\r\nThe expected output is:\r\n```\r\n00\r\n09\r\n0a\r\nff\r\n```\n\n### Minimal reproduction project (MRP)\n\nN/A","closed_by":{"login":"sanlor","id":10454310,"node_id":"MDQ6VXNlcjEwNDU0MzEw","avatar_url":"https://avatars.githubusercontent.com/u/10454310?v=4","gravatar_id":"","url":"https://api.github.com/users/sanlor","html_url":"https://github.com/sanlor","followers_url":"https://api.github.com/users/sanlor/followers","following_url":"https://api.github.com/users/sanlor/following{/other_user}","gists_url":"https://api.github.com/users/sanlor/gists{/gist_id}","starred_url":"https://api.github.com/users/sanlor/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/sanlor/subscriptions","organizations_url":"https://api.github.com/users/sanlor/orgs","repos_url":"https://api.github.com/users/sanlor/repos","events_url":"https://api.github.com/users/sanlor/events{/privacy}","received_events_url":"https://api.github.com/users/sanlor/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/98959/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/godotengine/godot/issues/98959/timeline","performed_via_github_app":null,"state_reason":"completed","pinned_comment":null}