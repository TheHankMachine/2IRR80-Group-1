author_association":"NONE","issue_field_values":[],"type":null,"active_lock_reason":null,"draft":false,"pull_request":{"url":"https://api.github.com/repos/godotengine/godot/pulls/118288","html_url":"https://github.com/godotengine/godot/pull/118288","diff_url":"https://github.com/godotengine/godot/pull/118288.diff","patch_url":"https://github.com/godotengine/godot/pull/118288.patch","merged_at":null},"body":"This PR adds a new editor setting: text_editor/appearance/lines/collapse_regions_on_start (default: false).\r\nWhen enabled, it automatically collapses all code regions the first time a script is opened in the current editor session.\r\n\r\nAI Use:\r\nI used AI for the code in editor/script/script_editor_plugin.cpp. Everything else was written by me.\r\n\r\nReasoning:\r\nThis setting improves workspace organization for projects using large scripts with multiple #region blocks. While regions help group code, they can lead to visual clutter when a script is reopened after some time. Auto-collapsing them ensures a clean, \"top-down\" view of the script's structure every time a developer returns to it, allowing them to expand only what is currently relevant.","closed_by":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/118288/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/godotengine/godot/issues/118288/timeline","performed_via_github_app":null,"state_reason":null}