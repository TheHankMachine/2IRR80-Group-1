_id":"MDU6TGFiZWwyNzkwOTcxNjI=","url":"https://api.github.com/repos/godotengine/godot/labels/discussion","name":"discussion","color":"ccaaff","default":false,"description":"","archived_at":null,"archived_by":null},{"id":279098009,"node_id":"MDU6TGFiZWwyNzkwOTgwMDk=","url":"https://api.github.com/repos/godotengine/godot/labels/topic:buildsystem","name":"topic:buildsystem","color":"ffee88","default":false,"description":"","archived_at":null,"archived_by":null}],"state":"closed","locked":false,"assignees":[],"milestone":null,"comments":1,"created_at":"2026-04-03T15:58:23Z","updated_at":"2026-07-12T18:32:13Z","closed_at":"2026-07-12T18:14:30Z","assignee":null,"author_association":"CONTRIBUTOR","issue_field_values":[],"type":null,"active_lock_reason":null,"draft":true,"pull_request":{"url":"https://api.github.com/repos/godotengine/godot/pulls/118162","html_url":"https://github.com/godotengine/godot/pull/118162","diff_url":"https://github.com/godotengine/godot/pull/118162.diff","patch_url":"https://github.com/godotengine/godot/pull/118162.patch","merged_at":null},"body":"- Related #117654\r\n\r\nImplements `clangd-tidy` as a proper pre-commit hook, making the tool more readily accessible for all users. This required reworking the pre-commit action into our own implementation, which is arguably for the best as that action has been unsupported for years now & is the main source of false-positive warnings in CI output\r\n\r\nHowever: despite being fully-functional, I'm hesitant to implement this as-is. As there's no way to enforce `compile_commands.json`, nor is there a reliable way to exclude platform-specific files, the hook stage is still \"manual\". To make this into a readily-accessible hook, I believe that we'd have to either make upstream changes to `clangd-tidy` or produce our own wrapper script to achieve our desired results. Having said that, I'm setting this up as-is in order to verify that the pre-commit action functions as expected, which will get a dedicated PR if so","closed_by":{"login":"Repiteo","id":17489292,"node_id":"MDQ6VXNlcjE3NDg5Mjky","avatar_url":"https://avatars.githubusercontent.com/u/17489292?v=4","gravatar_id":"","url":"https://api.github.com/users/Repiteo","html_url":"https://github.com/Repiteo","followers_url":"https://api.github.com/users/Repiteo/followers","following_url":"https://api.github.com/users/Repiteo/following{/other_user}","gists_url":"https://api.github.com/users/Repiteo/gists{/gist_id}","starred_url":"https://api.github.com/users/Repiteo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Repiteo/subscriptions","organizations_url":"https://api.github.com/users/Repiteo/orgs","repos_url":"https://api.github.com/users/Repiteo/repos","events_url":"https://api.github.com/users/Repiteo/events{/privacy}","received_events_url":"https://api.github.com/users/Repiteo/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/118162/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/godotengine/godot/issues/118162/timeline","performed_via_github_app":null,"state_reason":null}