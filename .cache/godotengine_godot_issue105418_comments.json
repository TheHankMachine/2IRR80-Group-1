busercontent.com/u/20855?v=4","gravatar_id":"","url":"https://api.github.com/users/maran","html_url":"https://github.com/maran","followers_url":"https://api.github.com/users/maran/followers","following_url":"https://api.github.com/users/maran/following{/other_user}","gists_url":"https://api.github.com/users/maran/gists{/gist_id}","starred_url":"https://api.github.com/users/maran/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/maran/subscriptions","organizations_url":"https://api.github.com/users/maran/orgs","repos_url":"https://api.github.com/users/maran/repos","events_url":"https://api.github.com/users/maran/events{/privacy}","received_events_url":"https://api.github.com/users/maran/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-05-12T09:56:36Z","updated_at":"2025-05-12T09:56:36Z","body":"Thanks, will give that a whirl","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2871858718/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3334216454","html_url":"https://github.com/godotengine/godot/issues/105418#issuecomment-3334216454","issue_url":"https://api.github.com/repos/godotengine/godot/issues/105418","id":3334216454,"node_id":"IC_kwDOAO6SJc7GvBsG","user":{"login":"gkwaerp","id":35116814,"node_id":"MDQ6VXNlcjM1MTE2ODE0","avatar_url":"https://avatars.githubusercontent.com/u/35116814?v=4","gravatar_id":"","url":"https://api.github.com/users/gkwaerp","html_url":"https://github.com/gkwaerp","followers_url":"https://api.github.com/users/gkwaerp/followers","following_url":"https://api.github.com/users/gkwaerp/following{/other_user}","gists_url":"https://api.github.com/users/gkwaerp/gists{/gist_id}","starred_url":"https://api.github.com/users/gkwaerp/star