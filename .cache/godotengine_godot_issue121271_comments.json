bug mode on DirectX:\n\nhttps://github.com/user-attachments/assets/b23ce4ed-5dca-442b-ba76-e2c41f3b061d","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4957460419/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null}]