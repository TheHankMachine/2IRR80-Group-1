[{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2700437594","html_url":"https://github.com/godotengine/godot/issues/103572#issuecomment-2700437594","issue_url":"https://api.github.com/repos/godotengine/godot/issues/103572","id":2700437594,"node_id":"IC_kwDOAO6SJc6g9Wha","user":{"login":"syntaxerror247","id":176927541,"node_id":"U_kgDOCouzNQ","avatar_url":"https://avatars.githubusercontent.com/u/176927541?v=4","gravatar_id":"","url":"https://api.github.com/users/syntaxerror247","html_url":"https://github.com/syntaxerror247","followers_url":"https://api.github.com/users/syntaxerror247/followers","following_url":"https://api.github.com/users/syntaxerror247/following{/other_user}","gists_url":"https://api.github.com/users/syntaxerror247/gists{/gist_id}","starred_url":"https://api.github.com/users/syntaxerror247/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/syntaxerror247/subscriptions","organizations_url":"https://api.github.com/users/syntaxerror247/orgs","repos_url":"https://api.github.com/users/syntaxerror247/repos","events_url":"https://api.github.com/users/syntaxerror247/events{/privacy}","received_events_url":"https://api.github.com/users/syntaxerror247/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-03-05T10:03:12Z","updated_at":"2025-03-05T10:04:17Z","body":"@BraveEvidence Your code has an error: `var VibrationEffect = android_runtime.loadClass(\"android.os.VibrationEffect\")`\nThere is no `loadClass` method in android_runtime. JavaClassWrapper is used to wrap classes. See: https://docs.godotengine.org/en/stable/classes/class_javaclasswrapper.html\n\nCorrect code:\n```\nvar VibrationEffect = JavaClassWrapper.wrap(\"android.os.VibrationEffect\")\n```\n","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2700437594/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart