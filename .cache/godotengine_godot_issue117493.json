21:06Z","updated_at":"2026-03-17T18:53:24Z","closed_at":"2026-03-17T18:52:51Z","assignee":null,"author_association":"CONTRIBUTOR","issue_field_values":[],"type":null,"active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"### Tested versions\n\nReproducible in: v4.7.dev.custom_build [a9afde840]\n\n### System information\n\nGodot v4.7.dev (a9afde840) - macOS Tahoe (26.3.1) - Multi-window, 2 monitors - Metal (Forward+) - integrated Apple M1 Max (Apple7) - Apple M1 Max (10 threads) - 32.00 GiB memory\n\n### Issue description\n\nWhen an AnimationTree's AnimationPlayer's library (whew) contains multiple libraries, non-`GLOBAL` animations selected from it will generate blend point names containing `/`.\n\n<img width=\"479\" height=\"348\" alt=\"Image\" src=\"https://github.com/user-attachments/assets/e79d361e-7db1-4d16-8a22-4303fdf31b07\" />\n\nAnimationBlendSpace1D then tells us these are invalid names at runtime.\n\n```\nE 0:00:00:581   set_blend_point_name: Condition \"new_name.is_empty() || new_name.contains_char('.') || new_name.contains_char('/')\" is true.\n  <C++ Source>  scene/animation/animation_blend_space_1d.cpp:202 @ set_blend_point_name()\n```\n\nThese animation names haven't been named with a `/` explicitly: they're the result of a setup like the following when adding multiple animation libraries to an AnimationPlayer:\n\n<img width=\"554\" height=\"390\" alt=\"Image\" src=\"https://github.com/user-attachments/assets/100ff185-61b2-43e0-bedc-daa5820a03a3\" />\n\n\nThese can be renamed to avoid the error, but maybe the editor should generate compliant names for such animations.\n\n### Steps to reproduce\n\n- Associate an AnimationPlayer with multiple loaded libraries to an AnimationTree\n- Create a BlendSpace1D\n- Add an animation outside of the `[GLOBAL]` library as a blend point\n\n### Minimal reproduction project (MRP)\n\nN/A","closed_by":{"login":"Repiteo","id":17489292,"node_id":"MDQ6VXNlcjE3NDg5Mjky","avatar_url":"https://avatars.githubusercontent.com/u/17489292?v=4","gravatar_id":"","url":"https://api.github.com/users/Repiteo","html_url":"https://github.com/Repiteo","followers_url":"https://api.github.com/users/Repiteo/followers","following_url":"https://api.github.com/users/Repiteo/following{/other_user}","gists_url":"https://api.github.com/users/Repiteo/gists{/gist_id}","starred_url":"https://api.github.com/users/Repiteo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Repiteo/subscriptions","organizations_url":"https://api.github.com/users/Repiteo/orgs","repos_url":"https://api.github.com/users/Repiteo/repos","events_url":"https://api.github.com/users/Repiteo/events{/privacy}","received_events_url":"https://api.github.com/users/Repiteo/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/117493/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/godotengine/godot/issues/117493/timeline","performed_via_github_app":null,"state_reason":"completed","pinned_comment":null}