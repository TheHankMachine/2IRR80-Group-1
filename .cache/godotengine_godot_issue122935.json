"ffee88","default":false,"description":"","archived_at":null,"archived_by":null},{"id":580537003,"node_id":"MDU6TGFiZWw1ODA1MzcwMDM=","url":"https://api.github.com/repos/godotengine/godot/labels/topic:gdextension","name":"topic:gdextension","color":"ffee88","default":false,"description":"","archived_at":null,"archived_by":null}],"state":"closed","locked":false,"assignees":[],"milestone":{"url":"https://api.github.com/repos/godotengine/godot/milestones/25","html_url":"https://github.com/godotengine/godot/milestone/25","labels_url":"https://api.github.com/repos/godotengine/godot/milestones/25/labels","id":15520464,"node_id":"MI_kwDOAO6SJc4A7NLQ","number":25,"title":"4.8","description":"","creator":{"login":"Repiteo","id":17489292,"node_id":"MDQ6VXNlcjE3NDg5Mjky","avatar_url":"https://avatars.githubusercontent.com/u/17489292?v=4","gravatar_id":"","url":"https://api.github.com/users/Repiteo","html_url":"https://github.com/Repiteo","followers_url":"https://api.github.com/users/Repiteo/followers","following_url":"https://api.github.com/users/Repiteo/following{/other_user}","gists_url":"https://api.github.com/users/Repiteo/gists{/gist_id}","starred_url":"https://api.github.com/users/Repiteo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Repiteo/subscriptions","organizations_url":"https://api.github.com/users/Repiteo/orgs","repos_url":"https://api.github.com/users/Repiteo/repos","events_url":"https://api.github.com/users/Repiteo/events{/privacy}","received_events_url":"https://api.github.com/users/Repiteo/received_events","type":"User","user_view_type":"public","site_admin":false},"open_issues":345,"closed_issues":2335,"state":"open","created_at":"2026-04-13T15:59:35Z","updated_at":"2026-10-22T08:15:08Z","due_on":null,"closed_at":null},"comments":2,"created_at":"2026-08-28T13:37:48Z","updated_at":"2026-08-28T17:02:26Z","closed_at":"2026-08-28T17:02:17Z","assignee":null,"author_association":"CONTRIBUTOR","issue_field_values":[],"type":null,"active_lock_reason":null,"draft":false,"pull_request":{"url":"https://api.github.com/repos/godotengine/godot/pulls/122935","html_url":"https://github.com/godotengine/godot/pull/122935","diff_url":"https://github.com/godotengine/godot/pull/122935.diff","patch_url":"https://github.com/godotengine/godot/pull/122935.patch","merged_at":"2026-08-28T17:02:17Z"},"body":"## What problem(s) does this PR solve?\r\n\r\n- Closes #122934\r\n\r\n## Additional information\r\n\r\nIf a GDExtension does not provide a shared library for the editors operating system, an error appears and the GDExtension fails to load. However, even if the GDExtension fails to load it triggers these two lines in gdextension_manger.cpp:\r\n```\r\nemit_signal(\"extensions_reloaded\");\r\ncallable_mp_static(&GDExtensionManager::_reload_all_scripts).call_deferred();\r\n```\r\nThese can be quite expensive depending on the size of the project and lead to the editor freezing until it's done (3-4 seconds in my project). Since on any new file system scan it tries to load the extension again, it makes the editor unusable.\r\n\r\nThe change makes it so that only a successful GDExtension loading/unloading triggers these lines.\r\nThis is a fix to at least make the editor behave nicely, however some way of declaring supported OS's for a GDExtension would be nice to have to avoid this all together.","closed_by":{"login":"Repiteo","id":17489292,"node_id":"MDQ6VXNlcjE3NDg5Mjky","avatar_url":"https://avatars.githubusercontent.com/u/17489292?v=4","gravatar_id":"","url":"https://api.github.com/users/Repiteo","html_url":"https://github.com/Repiteo","followers_url":"https://api.github.com/users/Repiteo/followers","following_url":"https://api.github.com/users/Repiteo/following{/other_user}","gists_url":"https://api.github.com/users/Repiteo/gists{/gist_id}","starred_url":"https://api.github.com/users/Repiteo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Repiteo/subscriptions","organizations_url":"https://api.github.com/users/Repiteo/orgs","repos_url":"https://api.github.com/users/Repiteo/repos","events_url":"https://api.github.com/users/Repiteo/events{/privacy}","received_events_url":"https://api.github.com/users/Repiteo/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/122935/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/godotengine/godot/issues/122935/timeline","performed_via_github_app":null,"state_reason":null}