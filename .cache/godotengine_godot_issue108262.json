://api.github.com/users/Sauermann/events{/privacy}","received_events_url":"https://api.github.com/users/Sauermann/received_events","type":"User","user_view_type":"public","site_admin":false},"open_issues":3,"closed_issues":3687,"state":"closed","created_at":"2024-12-19T08:51:28Z","updated_at":"2026-09-04T21:48:38Z","due_on":"2025-09-15T00:00:00Z","closed_at":"2025-09-18T17:13:14Z"},"comments":1,"created_at":"2025-07-04T03:56:00Z","updated_at":"2025-07-07T18:26:15Z","closed_at":"2025-07-07T15:14:05Z","assignee":null,"author_association":"MEMBER","issue_field_values":[],"type":null,"active_lock_reason":null,"draft":false,"pull_request":{"url":"https://api.github.com/repos/godotengine/godot/pulls/108262","html_url":"https://github.com/godotengine/godot/pull/108262","diff_url":"https://github.com/godotengine/godot/pull/108262.diff","patch_url":"https://github.com/godotengine/godot/pull/108262.patch","merged_at":"2025-07-07T15:14:05Z"},"body":"I had a bad `[enum ...]` in my documentation XML. This was crashing the C# bindings generator, because the code was running `p_target_itype->is_intentionally_ignored` without checking if `p_target_itype` is null or not.\r\n\r\nNote that these functions have code paths for dealing with a null `p_target_itype`, so it seems to not be a case where we can simply have guard clauses. In most of the functions calling `is_intentionally_ignored` the code already checked for a null `p_target_itype` and used a different code path, but this was missing only for the error case of enums.\r\n\r\nI've marked this as cherrypick for 4.3 and 4.4. The bug seems to also exist in 4.2 and earlier but the code is a bit different so the cherrypick can't be done automatically, and I don't know if it's worth the effort for such an old branch.","closed_by":{"login":"Repiteo","id":17489292,"node_id":"MDQ6VXNlcjE3NDg5Mjky","avatar_url":"https://avatars.githubusercontent.com/u/17489292?v=4","gravatar_id":"","url":"https://api.github.com/users/Repiteo","html_url":"https://github.com/Repiteo","followers_url":"https://api.github.com/users/Repiteo/followers","following_url":"https://api.github.com/users/Repiteo/following{/other_user}","gists_url":"https://api.github.com/users/Repiteo/gists{/gist_id}","starred_url":"https://api.github.com/users/Repiteo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Repiteo/subscriptions","organizations_url":"https://api.github.com/users/Repiteo/orgs","repos_url":"https://api.github.com/users/Repiteo/repos","events_url":"https://api.github.com/users/Repiteo/events{/privacy}","received_events_url":"https://api.github.com/users/Repiteo/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/108262/reactions","total_count":3,"+1":3,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/godotengine/godot/issues/108262/timeline","performed_via_github_app":null,"state_reason":null}