ithub.com/repos/godotengine/godot/issues/100240","id":2533348577,"node_id":"IC_kwDOAO6SJc6W_9Th","user":{"login":"KoBeWi","id":2223172,"node_id":"MDQ6VXNlcjIyMjMxNzI=","avatar_url":"https://avatars.githubusercontent.com/u/2223172?v=4","gravatar_id":"","url":"https://api.github.com/users/KoBeWi","html_url":"https://github.com/KoBeWi","followers_url":"https://api.github.com/users/KoBeWi/followers","following_url":"https://api.github.com/users/KoBeWi/following{/other_user}","gists_url":"https://api.github.com/users/KoBeWi/gists{/gist_id}","starred_url":"https://api.github.com/users/KoBeWi/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/KoBeWi/subscriptions","organizations_url":"https://api.github.com/users/KoBeWi/orgs","repos_url":"https://api.github.com/users/KoBeWi/repos","events_url":"https://api.github.com/users/KoBeWi/events{/privacy}","received_events_url":"https://api.github.com/users/KoBeWi/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2024-12-11T00:32:16Z","updated_at":"2024-12-11T00:32:16Z","body":"Maybe you could add a static variable, e.g. `in_editor` which is set to true in EditorNode, and LineEdit would enable the new property if the variable is true and is not part of edited scene.\r\nSomewhat related to #89448 (similar problem)","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2533348577/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2536656569","html_url":"https://github.com/godotengine/godot/pull/100240#issuecomment-2536656569","issue_url":"https://api.github.com/repos/godotengine/godot/issues/100240","id":2536656569,"node_id":"IC_kwDOAO6SJc6XMk65","user":{"login":"WhalesState","id":53877170,"node_id":"MDQ6VXNlcjUzODc3MTcw","avatar_url":"https://avatars.githubusercontent.com/u/53877170?v=4","gravatar_id":"","url":"https://api.github.com/users/WhalesState","html_url":"https://github.com/WhalesState","followers_url":"https://api.github.com/users/WhalesState/followers","following_url":"https://api.github.com/users/WhalesState/following{/other_user}","gists_url":"https://api.github.com/users/WhalesState/gists{/gist_id}","starred_url":"https://api.github.com/users/WhalesState/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/WhalesState/subscriptions","organizations_url":"https://api.github.com/users/WhalesState/orgs","repos_url":"https://api.github.com/users/WhalesState/repos","events_url":"https://api.github.com/users/WhalesState/events{/privacy}","received_events_url":"https://api.github.com/users/WhalesState/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2024-12-11T17:36:26Z","updated_at":"2024-12-11T17:45:15Z","body":"> Maybe you could add a static variable, e.g. `in_editor` which is set to true in EditorNode, and LineEdit would enable the new property if the variable is true and is not part of edited scene. Somewhat related to #89448 (similar problem)\r\n\r\nAdded `Engine::is_cmdline_tool()` to know if it's a cmdline tool like --doctool without including `main/main.cpp`.","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2536656569/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2567128627","html_url":"https://github.com/godotengine/godot/pull/100240#issuecomment-2567128627","issue_url":"https://api.github.com/repos/godotengine/godot/issues/100240","id":2567128627,"node_id":"IC_kwDOAO6SJc6ZA0Yz","user":{"login":"KoBeWi","id":2223172,"node_id":"MDQ6VXNlcjIyMjMxNzI=","avatar_url":"https://avatars.githubusercontent.com/u/2223172?v=4","gravatar_id":"","url":"https://api.github.com/users/KoBeWi","html_url":"https://github.com/KoBeWi","followers_url":"https://api.github.com/users/KoBeWi/followers","following_url":"https://api.github.com/users/KoBeWi/following{/other_user}","gists_url":"https://api.github.com/users/KoBeWi/gists{/gist_id}","starred_url":"https://api.github.com/users/KoBeWi/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/KoBeWi/subscriptions","organizations_url":"https://api.github.com/users/KoBeWi/orgs","repos_url":"https://api.github.com/users/KoBeWi/repos","events_url":"https://api.github.com/users/KoBeWi/events{/privacy}","received_events_url":"https://api.github.com/users/KoBeWi/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-01-01T19:59:56Z","updated_at":"2025-01-01T20:00:33Z","body":"Half of the changes here is for changing default between editor and game and... they don't seem to even work. I think the property can be disabled by default like now, without the additional hacks. It's actually undesired in the editor, e.g. in the inspector.\r\n\r\nWhat was the reason for the current implementation? (i.e. having separate defaults)","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2567128627/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2567210346","html_url":"https://github.com/godotengine/godot/pull/100240#issuecomment-2567210346","issue_url":"https://api.github.com/repos/godotengine/godot/issues/100240","id":2567210346,"node_id":"IC_kwDOAO6SJc6ZBIVq","user":{"login":"WhalesState","id":53877170,"node_id":"MDQ6VXNlcjUzODc3MTcw","avatar_url":"https://avatars.githubusercontent.com/u/53877170?v=4","gravatar_id":"","url":"https://api.github.com/users/WhalesState","html_url":"https://github.com/WhalesState","followers_url":"https://api.github.com/users/WhalesState/followers","following_url":"https://api.github.com/users/WhalesState/following{/other_user}","gists_url":"https://api.github.com/users/WhalesState/gists{/gist_id}","starred_url":"https://api.github.com/users/WhalesState/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/WhalesState/subscriptions","organizations_url":"https://api.github.com/users/WhalesState/orgs","repos_url":"https://api.github.com/users/WhalesState/repos","events_url":"https://api.github.com/users/WhalesState/events{/privacy}","received_events_url":"https://api.github.com/users/WhalesState/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-01-02T01:16:51Z","updated_at":"2025-01-02T01:19:11Z","body":"> What was the reason for the current implementation? (i.e. having separate defaults)\r\n\r\nYes, for Editor, we are using the new behavior for all `LineEdit` nodes except for the `Script Editor` search, and for games, we should revert it back for compatibility, if we set the default to false, we will need to add an extra line for every editor LineEdit node, and if we set the default to true, we are breaking compatibility with 4.3, but it can be reverted easily from the node properties.","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2567210346/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2567210930","html_url":"https://github.com/godotengine/godot/pull/100240#issuecomment-2567210930","issue_url":"https://api.github.com/repos/godotengine/godot/issues/100240","id":2567210930,"node_id":"IC_kwDOAO6SJc6ZBIey","user":{"login":"KoBeWi","id":2223172,"node_id":"MDQ6VXNlcjIyMjMxNzI=","avatar_url":"https://avatars.githubusercontent.com/u/2223172?v=4","gravatar_id":"","url":"https://api.github.com/users/KoBeWi","html_url":"https://github.com/KoBeWi","followers_url":"https://api.github.com/users/KoBeWi/followers","following_url":"https://api.github.com/users/KoBeWi/following{/other_user}","gists_url":"https://api.github.com/users/KoBeWi/gists{/gist_id}","starred_url":"https://api.github.com/users/KoBeWi/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/KoBeWi/subscriptions","organizations_url":"https://api.github.com/users/KoBeWi/orgs","repos_url":"https://api.github.com/users/KoBeWi/repos","events_url":"https://api.github.com/users/KoBeWi/events{/privacy}","received_events_url":"https://api.github.com/users/KoBeWi/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-01-02T01:19:08Z","updated_at":"2025-01-02T01:19:08Z","body":"Eh, but with the new property, isn't `true` the old default behavior?","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2567210930/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2567212302","html_url":"https://github.com/godotengine/godot/pull/100240#issuecomment-2567212302","issue_url":"https://api.github.com/repos/godotengine/godot/issues/100240","id":2567212302,"node_id":"IC_kwDOAO6SJc6ZBI0O","user":{"login":"WhalesState","id":53877170,"node_id":"MDQ6VXNlcjUzODc3MTcw","avatar_url":"https://avatars.githubusercontent.com/u/53877170?v=4","gravatar_id":"","url":"https://api.github.com/users/WhalesState","html_url":"https://github.com/WhalesState","followers_url":"https://api.github.com/users/WhalesState/followers","following_url":"https://api.github.com/users/WhalesState/following{/other_user}","gists_url":"https://api.github.com/users/WhalesState/gists{/gist_id}","starred_url":"https://api.github.com/users/WhalesState/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/WhalesState/subscriptions","organizations_url":"https://api.github.com/users/WhalesState/orgs","repos_url":"https://api.github.com/users/WhalesState/repos","events_url":"https://api.github.com/users/WhalesState/events{/privacy}","received_events_url":"https://api.github.com/users/WhalesState/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-01-02T01:24:57Z","updated_at":"2025-01-02T01:30:06Z","body":"> Eh, but with the new property, isn't `true` the old default behavior?\r\n\r\nCan we keep the default value `false`? because it's `false` since we have merged the `LineEdit` focus mode PR, and we are breaking compatibility already for months in 4.4, i just wanted a solution since every new issue related to the old behavior will be marked as a compatibility break.\r\n\r\nThe new behavior that was added, meant to switch back to focus mode and exit editing after the text submitting, to make it easier to set a value and be able to focus another `Control` node with arrow keys.","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2567212302/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2567563030","html_url":"https://github.com/godotengine/godot/pull/100240#issuecomment-2567563030","issue_url":"https://api.github.com/repos/godotengine/godot/issues/100240","id":2567563030,"node_id":"IC_kwDOAO6SJc6ZCecW","user":{"login":"KoBeWi","id":2223172,"node_id":"MDQ6VXNlcjIyMjMxNzI=","avatar_url":"https://avatars.githubusercontent.com/u/2223172?v=4","gravatar_id":"","url":"https://api.github.com/users/KoBeWi","html_url":"https://github.com/KoBeWi","followers_url":"https://api.github.com/users/KoBeWi/followers","following_url":"https://api.github.com/users/KoBeWi/following{/other_user}","gists_url":"https://api.github.com/users/KoBeWi/gists{/gist_id}","starred_url":"https://api.github.com/users/KoBeWi/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/KoBeWi/subscriptions","organizations_url":"https://api.github.com/users/KoBeWi/orgs","repos_url":"https://api.github.com/users/KoBeWi/repos","events_url":"https://api.github.com/users/KoBeWi/events{/privacy}","received_events_url":"https://api.github.com/users/KoBeWi/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-01-02T10:33:27Z","updated_at":"2025-01-02T10:33:27Z","body":"> we are breaking compatibility already for months in 4.4\r\n\r\nCompatibility with stable release is more important.\r\n\r\nThat said, I do think the new behavior makes more sense, so you can keep it `false`. But then the extra changes for editor default are unnecessary as I said, because the desired editor default is also `false`.\r\n\r\nSo to sum up.\r\nThe old behavior is that when you press Enter, the LineEdit keeps editing.\r\nThe new behavior is that when you press Enter, the LineEdit stops \"editing\", but keeps focus. To input value again, you need to press Enter again.\r\n\r\nThe issue is about the change in behavior; the user prefers the old one for some dev console addon, which makes sense. However it's the only report we got, so it's safe to assume that the new behavior is better in general.\r\n\r\nYour new property `editing_on_text_submit` allows switching between old and new behavior, with `false` being new behavior and `true` being old. So to keep the new behavior by default, the default value of this property should be `false`. \r\n\r\n> default value is false for game and true for editor and editor plugins.\r\n\r\nI'm not sure what this part was for. I think the default should be consistent. Also with the current implementation, `editing_on_text_submit` might have unexpected behavior in editor plugins.\r\n\r\nbtw I'd rename the property to `keep_editing_on_text_submit`.","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2567563030/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2568423924","html_url":"https://github.com/godotengine/godot/pull/100240#issuecomment-2568423924","issue_url":"https://api.github.com/repos/godotengine/godot/issues/100240","id":2568423924,"node_id":"IC_kwDOAO6SJc6ZFwn0","user":{"login":"WhalesState","id":53877170,"node_id":"MDQ6VXNlcjUzODc3MTcw","avatar_url":"https://avatars.githubusercontent.com/u/53877170?v=4","gravatar_id":"","url":"https://api.github.com/users/WhalesState","html_url":"https://github.com/WhalesState","followers_url":"https://api.github.com/users/WhalesState/followers","following_url":"https://api.github.com/users/WhalesState/following{/other_user}","gists_url":"https://api.github.com/users/WhalesState/gists{/gist_id}","starred_url":"https://api.github.com/users/WhalesState/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/WhalesState/subscriptions","organizations_url":"https://api.github.com/users/WhalesState/orgs","repos_url":"https://api.github.com/users/WhalesState/repos","events_url":"https://api.github.com/users/WhalesState/events{/privacy}","received_events_url":"https://api.github.com/users/WhalesState/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-01-02T21:49:58Z","updated_at":"2025-01-02T21:49:58Z","body":"OK, the default is now false, and we should note this as a breaking change in 4.4.","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2568423924/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2568544615","html_url":"https://github.com/godotengine/godot/pull/100240#issuecomment-2568544615","issue_url":"https://api.github.com/repos/godotengine/godot/issues/100240","id":2568544615,"node_id":"IC_kwDOAO6SJc6ZGOFn","user":{"login":"akien-mga","id":4701338,"node_id":"MDQ6VXNlcjQ3MDEzMzg=","avatar_url":"https://avatars.githubusercontent.com/u/4701338?v=4","gravatar_id":"","url":"https://api.github.com/users/akien-mga","html_url":"https://github.com/akien-mga","followers_url":"https://api.github.com/users/akien-mga/followers","following_url":"https://api.github.com/users/akien-mga/following{/other_user}","gists_url":"https://api.github.com/users/akien-mga/gists{/gist_id}","starred_url":"https://api.github.com/users/akien-mga/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/akien-mga/subscriptions","organizations_url":"https://api.github.com/users/akien-mga/orgs","repos_url":"https://api.github.com/users/akien-mga/repos","events_url":"https://api.github.com/users/akien-mga/events{/privacy}","received_events_url":"https://api.github.com/users/akien-mga/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-01-03T00:12:14Z","updated_at":"2025-01-03T00:12:14Z","body":"Thanks!","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2568544615/reactions","total_count":1,"+1":0,"-1":0,"laugh":0,"hooray":1,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null}]