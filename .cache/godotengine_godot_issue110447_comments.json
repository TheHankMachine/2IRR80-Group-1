engine/godot/issues/comments/3298258177/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3315101987","html_url":"https://github.com/godotengine/godot/issues/110447#issuecomment-3315101987","issue_url":"https://api.github.com/repos/godotengine/godot/issues/110447","id":3315101987,"node_id":"IC_kwDOAO6SJc7FmHEj","user":{"login":"ASamBlur","id":199510196,"node_id":"U_kgDOC-RItA","avatar_url":"https://avatars.githubusercontent.com/u/199510196?v=4","gravatar_id":"","url":"https://api.github.com/users/ASamBlur","html_url":"https://github.com/ASamBlur","followers_url":"https://api.github.com/users/ASamBlur/followers","following_url":"https://api.github.com/users/ASamBlur/following{/other_user}","gists_url":"https://api.github.com/users/ASamBlur/gists{/gist_id}","starred_url":"https://api.github.com/users/ASamBlur/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/ASamBlur/subscriptions","organizations_url":"https://api.github.com/users/ASamBlur/orgs","repos_url":"https://api.github.com/users/ASamBlur/repos","events_url":"https://api.github.com/users/ASamBlur/events{/privacy}","received_events_url":"https://api.github.com/users/ASamBlur/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-09-20T16:52:15Z","updated_at":"2025-09-20T16:52:15Z","body":"@notroid5 This might be what you are looking for:\n```gdscript\nClassDB.class_get_enum_constants(\"DisplayServer\", \"VSyncMode\")\n```","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3315101987/reactions","total_count":2,"+1":2,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/