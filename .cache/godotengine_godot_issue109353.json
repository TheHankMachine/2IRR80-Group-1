lse,"assignees":[],"milestone":{"url":"https://api.github.com/repos/godotengine/godot/milestones/16","html_url":"https://github.com/godotengine/godot/milestone/16","labels_url":"https://api.github.com/repos/godotengine/godot/milestones/16/labels","id":8237783,"node_id":"MI_kwDOAO6SJc4AfbLX","number":16,"title":"4.x","description":"Issues and pull requests slated for an undetermined Godot 4 release.","creator":{"login":"akien-mga","id":4701338,"node_id":"MDQ6VXNlcjQ3MDEzMzg=","avatar_url":"https://avatars.githubusercontent.com/u/4701338?v=4","gravatar_id":"","url":"https://api.github.com/users/akien-mga","html_url":"https://github.com/akien-mga","followers_url":"https://api.github.com/users/akien-mga/followers","following_url":"https://api.github.com/users/akien-mga/following{/other_user}","gists_url":"https://api.github.com/users/akien-mga/gists{/gist_id}","starred_url":"https://api.github.com/users/akien-mga/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/akien-mga/subscriptions","organizations_url":"https://api.github.com/users/akien-mga/orgs","repos_url":"https://api.github.com/users/akien-mga/repos","events_url":"https://api.github.com/users/akien-mga/events{/privacy}","received_events_url":"https://api.github.com/users/akien-mga/received_events","type":"User","user_view_type":"public","site_admin":false},"open_issues":5793,"closed_issues":0,"state":"open","created_at":"2022-07-26T12:42:05Z","updated_at":"2026-10-22T14:39:14Z","due_on":null,"closed_at":null},"comments":5,"created_at":"2025-08-06T11:55:57Z","updated_at":"2026-06-19T18:53:53Z","closed_at":null,"assignee":null,"author_association":"CONTRIBUTOR","issue_field_values":[],"type":null,"active_lock_reason":null,"draft":false,"pull_request":{"url":"https://api.github.com/repos/godotengine/godot/pulls/109353","html_url":"https://github.com/godotengine/godot/pull/109353","diff_url":"https://github.com/godotengine/godot/pull/109353.diff","patch_url":"https://github.com/godotengine/godot/pull/109353.patch","merged_at":null},"body":"Disabled items in ItemList can now be focused and selected (if their `selectable` property is enabled), but cannot be activated.\r\n\r\n**Why:**\r\nPreviously, disabling an item completely blocked it from being selected, clicked, or navigated to. This made the `selectable` and `disabled` properties redundant in practice.\r\n\r\nThis behavior was also inconsistent with other standard GUI controls (like `Button`), which can still receive focus outline so they can be read, but cannot be activated (pressed). This change makes `ItemList` navigation more intuitive and consistent, allowing keyboard and screen-reader users to navigate to and read disabled options, while ensuring they cannot trigger actual item activation.\r\n\r\n**Behavior changes to consider:**\r\n    - Keyboard navigation (arrow keys/page keys) will no longer skip disabled items.\r\n    - In Single-Selection mode, selecting a disabled item (via click or arrow keys) will now emit `item_selected` and `item_clicked` signals.\r\n    - In Single-Selection mode, calling `is_selected(index)` on a disabled item can now return true if the user has navigated to it.\r\n","closed_by":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/109353/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/godotengine/godot/issues/109353/timeline","performed_via_github_app":null,"state_reason":null}