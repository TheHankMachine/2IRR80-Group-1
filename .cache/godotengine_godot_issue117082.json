mga/gists{/gist_id}","starred_url":"https://api.github.com/users/akien-mga/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/akien-mga/subscriptions","organizations_url":"https://api.github.com/users/akien-mga/orgs","repos_url":"https://api.github.com/users/akien-mga/repos","events_url":"https://api.github.com/users/akien-mga/events{/privacy}","received_events_url":"https://api.github.com/users/akien-mga/received_events","type":"User","user_view_type":"public","site_admin":false},"open_issues":3,"closed_issues":2535,"state":"closed","created_at":"2025-11-27T20:29:18Z","updated_at":"2026-10-20T18:39:31Z","due_on":null,"closed_at":"2026-06-19T16:54:35Z"},"comments":0,"created_at":"2026-03-05T02:22:48Z","updated_at":"2026-03-11T20:49:54Z","closed_at":"2026-03-11T20:49:17Z","assignee":{"login":"bruvzg","id":7645683,"node_id":"MDQ6VXNlcjc2NDU2ODM=","avatar_url":"https://avatars.githubusercontent.com/u/7645683?v=4","gravatar_id":"","url":"https://api.github.com/users/bruvzg","html_url":"https://github.com/bruvzg","followers_url":"https://api.github.com/users/bruvzg/followers","following_url":"https://api.github.com/users/bruvzg/following{/other_user}","gists_url":"https://api.github.com/users/bruvzg/gists{/gist_id}","starred_url":"https://api.github.com/users/bruvzg/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/bruvzg/subscriptions","organizations_url":"https://api.github.com/users/bruvzg/orgs","repos_url":"https://api.github.com/users/bruvzg/repos","events_url":"https://api.github.com/users/bruvzg/events{/privacy}","received_events_url":"https://api.github.com/users/bruvzg/received_events","type":"User","user_view_type":"public","site_admin":false},"author_association":"NONE","issue_field_values":[],"type":null,"active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"### Tested versions\n\n- Reproducible in v4.7.dev2.official [778cf54da]\n\n### System information\n\nGodot v4.7.dev2 - Windows 10 (build 19045) - Multi-window, 3 monitors - Vulkan (Forward+) - dedicated NVIDIA GeForce GTX 1070 Ti (NVIDIA; 32.0.15.8228) - AMD Ryzen 5 1500X Quad-Core Processor (8 threads) - 15.92 GiB memory\n\n### Issue description\n\n\"DPITexture\" import does not have the \"Fix Alpha Border\" option, which means that in many circumstances it'll make these outlines (left).\n\n<img width=\"1358\" height=\"664\" alt=\"Image\" src=\"https://github.com/user-attachments/assets/bf7dcc04-c420-418a-a742-ae957a5313e1\" />\n\nThe \"Texture2D\" import (right) doesn't have this problem as it has \"Fix Alpha Border\" enabled by default. By manually disabling it you can get results that are practically identical in some circumstances.\n\nI deliberated for a while over whether this was technically a proposal but I eventually decided that it felt unintended, since \"Fix Alpha Border\" usually defaults to being enabled.\n\n### Steps to reproduce\n\n1. Import a `DPITexture` (with non-black borders), and place it onto a `Sprite2D`.\n   - To better see the issue, place it on a background of a similar color (e.g. a `ColorRect` or even a copy of the same `Sprite2D`).\n2. Adjust the `Sprite2D` in a way that it doesn't perfectly snap to the viewport. It's easiest to either:\n   a. Zoom the editor viewport such that it is not a perfect multiple of the default\n   b. Adjust the position, offset, rotation, or scale with non-integer values\n3. There should be a fairly clearly visible black border.\n\n### Minimal reproduction project (MRP)\n\n[issue.zip](https://github.com/user-attachments/files/25755360/issue.zip)","closed_by":{"login":"Repiteo","id":17489292,"node_id":"MDQ6VXNlcjE3NDg5Mjky","avatar_url":"https://avatars.githubusercontent.com/u/17489292?v=4","gravatar_id":"","url":"https://api.github.com/users/Repiteo","html_url":"https://github.com/Repiteo","followers_url":"https://api.