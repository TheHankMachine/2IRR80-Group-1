SJc697twE","user":{"login":"launcher-coder","id":224372475,"node_id":"U_kgDODV-m-w","avatar_url":"https://avatars.githubusercontent.com/u/224372475?v=4","gravatar_id":"","url":"https://api.github.com/users/launcher-coder","html_url":"https://github.com/launcher-coder","followers_url":"https://api.github.com/users/launcher-coder/followers","following_url":"https://api.github.com/users/launcher-coder/following{/other_user}","gists_url":"https://api.github.com/users/launcher-coder/gists{/gist_id}","starred_url":"https://api.github.com/users/launcher-coder/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/launcher-coder/subscriptions","organizations_url":"https://api.github.com/users/launcher-coder/orgs","repos_url":"https://api.github.com/users/launcher-coder/repos","events_url":"https://api.github.com/users/launcher-coder/events{/privacy}","received_events_url":"https://api.github.com/users/launcher-coder/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-08-14T02:34:12Z","updated_at":"2025-08-14T03:06:39Z","body":"I think it’s better to align them, since most context menus I’ve seen at least in Windows (Latest fluent design) and some big open source like Blender use that approach. A aligned design also looks more polished and consistent with the rest of the context menus within the editor.","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3186547716/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3186626804","html_url":"https://github.com/godotengine/godot/issues/109578#issuecomment-3186626804","issue_url":"https://api.github.com/repos/godotengine/godot/issues/109578","id":3186626804,"node_id":"IC_kwDOAO6SJc698BD0","user":{"login":"timothyqiu","id":372476,"node_id":"MDQ6VXNlcjM3MjQ3Ng==","avatar_url":"https://avatars.githubusercontent.com/u/372476?v=4","gravatar_id":"","url":"https://api.github.com/users/timothyqiu","html_url":"https://github.com/timothyqiu","followers_url":"https://api.github.com/users/timothyqiu/followers","following_url":"https://api.github.com/users/timothyqiu/following{/other_user}","gists_url":"https://api.github.com/users/timothyqiu/gists{/gist_id}","starred_url":"https://api.github.com/users/timothyqiu/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/timothyqiu/subscriptions","organizations_url":"https://api.github.com/users/timothyqiu/orgs","repos_url":"https://api.github.com/users/timothyqiu/repos","events_url":"https://api.github.com/users/timothyqiu/events{/privacy}","received_events_url":"https://api.github.com/users/timothyqiu/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-08-14T03:14:46Z","updated_at":"2025-08-14T03:14:46Z","body":"A menu item can show _both_ a check mark and an icon.\n\nYou can think of the menu as a three-column table, with the first column displaying check marks, the second column displaying icons, and the third column displaying text. A column will be hidden if all cells in that column are empty.\n\nIt's reasonable to suggestion merging the first two columns when there are no check marks and icons appearing at the same time. But the current behavior is intended, it's not a bug.","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3186626804/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3186751587","html_url":"https://github.com/godotengine/godot/issues/109578#issuecomment-3186751587","issue_url":"https://api.github.com/repos/godotengine/godot/issues/109578","id":3186751587,"node_id":"IC_kwDOAO6SJc698fhj","user":{"login":"launcher-coder","id":224372475,"node_id":"U_kgDODV-m-w","avatar_url":"https://avatars.githubusercontent.com/u/224372475?v=4","gravatar_id":"","url":"https://api.github.com/users/launcher-coder","html_url":"https://github.com/launcher-coder","followers_url":"https://api.github.com/users/launcher-coder/followers","following_url":"https://api.github.com/users/launcher-coder/following{/other_user}","gists_url":"https://api.github.com/users/launcher-coder/gists{/gist_id}","starred_url":"https://api.github.com/users/launcher-coder/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/launcher-coder/subscriptions","organizations_url":"https://api.github.com/users/launcher-coder/orgs","repos_url":"https://api.github.com/users/launcher-coder/repos","events_url":"https://api.github.com/users/launcher-coder/events{/privacy}","received_events_url":"https://api.github.com/users/launcher-coder/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-08-14T04:04:20Z","updated_at":"2025-08-14T04:04:20Z","body":"I see, thanks for clarifying.\nI just feel merging them when only one is present could also improve usability and reduce unused space, aside from the visual consistency.","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3186751587/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null}]