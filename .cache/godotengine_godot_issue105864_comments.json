github.com/users/jordo/gists{/gist_id}","starred_url":"https://api.github.com/users/jordo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/jordo/subscriptions","organizations_url":"https://api.github.com/users/jordo/orgs","repos_url":"https://api.github.com/users/jordo/repos","events_url":"https://api.github.com/users/jordo/events{/privacy}","received_events_url":"https://api.github.com/users/jordo/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-04-28T16:43:09Z","updated_at":"2025-04-28T16:44:55Z","body":"Another big potential improvement (at least for the web / GL backend) is to check for async/parallel compile support, and use KHR_parallel_shader_compile if available.   \r\n\r\nIt was implemented in three.js here:\r\n\r\nhttps://github.com/mrdoob/three.js/pull/19752\r\n\r\nI did spend some time looking into this, at least attempting to defer the check compile/link status in the initial group of shaders until the next frame, but didn't get to a point where it worked...  But this also seemed like a really good candidate to look into wrt engine startup duration on web.\r\n","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2835857027/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2835858626","html_url":"https://github.com/godotengine/godot/pull/105864#issuecomment-2835858626","issue_url":"https://api.github.com/repos/godotengine/godot/issues/105864","id":2835858626,"node_id":"IC_kwDOAO6SJc6pB8TC","user":{"login":"clayjohn","id":16521339,"node_id":"MDQ6VXNlcjE2NTIxMzM5","avatar_url":"https://avatars.githubusercontent.com/u/16521339?v=4","gravatar_id":"","url":"https://api.github.com/users/clayjohn","html_url":"https://github.com/clayjohn","followers_url":"https://api.github.com/users/clayjohn/followers","following_url":"https://api.github.com/users/clayjohn/following{/other_user}","gists_url":"https://api.github.com/users/clayjohn/gists{/gist_id}","starred_url":"https://api.github.com/users/clayjohn/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/clayjohn/subscriptions","organizations_url":"https://api.github.com/users/clayjohn/orgs","repos_url":"https://api.github.com/users/clayjohn/repos","events_url":"https://api.github.com/users/clayjohn/events{/privacy}","received_events_url":"https://api.github.com/users/clayjohn/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-04-28T16:43:52Z","updated_at":"2025-04-28T16:43:52Z","body":"> @clayjohn I believe that was myself when I was looking at startup time on the web... Most of the init time was due to compiling internal shaders and related variants. And yes, almost all of them were unsed by our (2D) game.\r\n\r\nOops! Sorry for the mixup","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2835858626/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2835860061","html_url":"https://github.com/godotengine/godot/pull/105864#issuecomment-2835860061","issue_url":"https://api.github.com/repos/godotengine/godot/issues/105864","id":2835860061,"node_id":"IC_kwDOAO6SJc6pB8pd","user":{"login":"jordo","id":323868,"node_id":"MDQ6VXNlcjMyMzg2OA==","avatar_url":"https://avatars.githubusercontent.com/u/323868?v=4","gravatar_id":"","url":"https://api.github.com/users/jordo","html_url":"https://github.com/jordo","followers_url":"https://api.github.com/users/jordo/followers","following_url":"https://api.github.com/users/jordo/following{/other_user}","gists_url":"https://api.github.com/users/jordo/gists{/gist_id}","starred_url":"https://api.github.com/users/jordo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/jordo/subscriptions","organizations_url":"https://api.github.com/users/jordo/orgs","repos_url":"https://api.github.com/users/jordo/repos","events_url":"https://api.github.com/users/jordo/events{/privacy}","received_events_url":"https://api.github.com/users/jordo/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-04-28T16:44:30Z","updated_at":"2025-04-28T16:44:30Z","body":"sorry, correct link:  https://github.com/mrdoob/three.js/pull/19752","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2835860061/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2835910951","html_url":"https://github.com/godotengine/godot/pull/105864#issuecomment-2835910951","issue_url":"https://api.github.com/repos/godotengine/godot/issues/105864","id":2835910951,"node_id":"IC_kwDOAO6SJc6pCJEn","user":{"login":"marcosc90","id":8364242,"node_id":"MDQ6VXNlcjgzNjQyNDI=","avatar_url":"https://avatars.githubusercontent.com/u/8364242?v=4","gravatar_id":"","url":"https://api.github.com/users/marcosc90","html_url":"https://github.com/marcosc90","followers_url":"https://api.github.com/users/marcosc90/followers","following_url":"https://api.github.com/users/marcosc90/following{/other_user}","gists_url":"https://api.github.com/users/marcosc90/gists{/gist_id}","starred_url":"https://api.github.com/users/marcosc90/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/marcosc90/subscriptions","organizations_url":"https://api.github.com/users/marcosc90/orgs","repos_url":"https://api.github.com/users/marcosc90/repos","events_url":"https://api.github.com/users/marcosc90/events{/privacy}","received_events_url":"https://api.github.com/users/marcosc90/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-04-28T17:03:35Z","updated_at":"2025-04-28T17:03:35Z","body":"> Another big potential improvement (at least for the web / GL backend) is to check for async/parallel compile support, and use KHR_parallel_shader_compile if available.\r\n> \r\n> It was implemented in three.js here:\r\n> \r\n> [mrdoob/three.js#19752](https://github.com/mrdoob/three.js/pull/19752)\r\n> \r\n> I did spend some time looking into this, at least attempting to defer the check compile/link status in the initial group of shaders until the next frame, but didn't get to a point where it worked... But this also seemed like a really good candidate to look into wrt engine startup duration on web.\r\n\r\n\r\nI already have `KHR_parallel_shader_compile` implemented, and it works great for preloading. I was able to get rid of `[Violation] 'requestAnimationFrame' handler took XXms` bringing it down from ~700ms to zero. But for proper async compilation, I'd need a bigger refactor. Right now, on-demand compilation through https://github.com/godotengine/godot/blob/67c96c89cc1abdee4065db5ac9e07072893b5916/drivers/gles3/shader_gles3.h#L185 doesn't work correctly, since callers of `_version_bind_shader` either crash or don't work correctly when it returns `false`, So, changes would likely be needed in some render methods, but I’m still figuring out exactly what.\r\n\r\nFor example, in this part:\r\n\r\nhttps://github.com/godotengine/godot/blob/67c96c89cc1abdee4065db5ac9e07072893b5916/drivers/gles3/rasterizer_scene_gles3.cpp#L3335-L3339\r\n\r\nWhat would happen if we just skip rendering that shader for the current frame (since it’ll probably be ready by the next one), but continue with the rest of the render? (Still need to understand more of the codebase before I can make that change, only been working with Godot for about a month)\r\n\r\n","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2835910951/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2835919754","html_url":"https://github.com/godotengine/godot/pull/105864#issuecomment-2835919754","issue_url":"https://api.github.com/repos/godotengine/godot/issues/105864","id":2835919754,"node_id":"IC_kwDOAO6SJc6pCLOK","user":{"login":"jordo","id":323868,"node_id":"MDQ6VXNlcjMyMzg2OA==","avatar_url":"https://avatars.githubusercontent.com/u/323868?v=4","gravatar_id":"","url":"https://api.github.com/users/jordo","html_url":"https://github.com/jordo","followers_url":"https://api.github.com/users/jordo/followers","following_url":"https://api.github.com/users/jordo/following{/other_user}","gists_url":"https://api.github.com/users/jordo/gists{/gist_id}","starred_url":"https://api.github.com/users/jordo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/jordo/subscriptions","organizations_url":"https://api.github.com/users/jordo/orgs","repos_url":"https://api.github.com/users/jordo/repos","events_url":"https://api.github.com/users/jordo/events{/privacy}","received_events_url":"https://api.github.com/users/jordo/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-04-28T17:07:29Z","updated_at":"2025-04-28T17:07:29Z","body":"`doesn't work correctly, since callers of _version_bind_shader either crash or don't work correctly when it returns false, So, changes would likely be needed in some render methods`\r\n\r\nYa, exactly where I kinda got to.  Larger refactor seemed necessary.","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2835919754/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2836257873","html_url":"https://github.com/godotengine/godot/pull/105864#issuecomment-2836257873","issue_url":"https://api.github.com/repos/godotengine/godot/issues/105864","id":2836257873,"node_id":"IC_kwDOAO6SJc6pDdxR","user":{"login":"Repiteo","id":17489292,"node_id":"MDQ6VXNlcjE3NDg5Mjky","avatar_url":"https://avatars.githubusercontent.com/u/17489292?v=4","gravatar_id":"","url":"https://api.github.com/users/Repiteo","html_url":"https://github.com/Repiteo","followers_url":"https://api.github.com/users/Repiteo/followers","following_url":"https://api.github.com/users/Repiteo/following{/other_user}","gists_url":"https://api.github.com/users/Repiteo/gists{/gist_id}","starred_url":"https://api.github.com/users/Repiteo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Repiteo/subscriptions","organizations_url":"https://api.github.com/users/Repiteo/orgs","repos_url":"https://api.github.com/users/Repiteo/repos","events_url":"https://api.github.com/users/Repiteo/events{/privacy}","received_events_url":"https://api.github.com/users/Repiteo/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-04-28T19:15:48Z","updated_at":"2025-04-28T19:15:48Z","body":"Thanks! Congratulations on your first merged contribution! 🎉 ","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2836257873/reactions","total_count":3,"+1":0,"-1":0,"laugh":0,"hooray":3,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null}]