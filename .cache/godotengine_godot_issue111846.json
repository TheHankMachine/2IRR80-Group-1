ved_at":null,"archived_by":null}],"state":"closed","locked":false,"assignees":[],"milestone":{"url":"https://api.github.com/repos/godotengine/godot/milestones/23","html_url":"https://github.com/godotengine/godot/milestone/23","labels_url":"https://api.github.com/repos/godotengine/godot/milestones/23/labels","id":12939969,"node_id":"MI_kwDOAO6SJc4AxXLB","number":23,"title":"4.6","description":"","creator":{"login":"Repiteo","id":17489292,"node_id":"MDQ6VXNlcjE3NDg5Mjky","avatar_url":"https://avatars.githubusercontent.com/u/17489292?v=4","gravatar_id":"","url":"https://api.github.com/users/Repiteo","html_url":"https://github.com/Repiteo","followers_url":"https://api.github.com/users/Repiteo/followers","following_url":"https://api.github.com/users/Repiteo/following{/other_user}","gists_url":"https://api.github.com/users/Repiteo/gists{/gist_id}","starred_url":"https://api.github.com/users/Repiteo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Repiteo/subscriptions","organizations_url":"https://api.github.com/users/Repiteo/orgs","repos_url":"https://api.github.com/users/Repiteo/repos","events_url":"https://api.github.com/users/Repiteo/events{/privacy}","received_events_url":"https://api.github.com/users/Repiteo/received_events","type":"User","user_view_type":"public","site_admin":false},"open_issues":3,"closed_issues":2978,"state":"closed","created_at":"2025-05-22T16:25:52Z","updated_at":"2026-10-04T16:23:23Z","due_on":null,"closed_at":"2026-01-26T18:09:14Z"},"comments":0,"created_at":"2025-10-20T14:32:46Z","updated_at":"2025-10-22T18:49:54Z","closed_at":"2025-10-22T18:49:50Z","assignee":null,"author_association":"MEMBER","issue_field_values":[],"type":null,"active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"### Tested versions\n\n- Reproducible in 4.6.dev2 (7864ac80192e9e91bf56176af9f04cc013b580aa)\n- Reproducible in 4.5.1.stable\n\n### System information\n\nFedora Linux 42 (KDE Plasma Desktop Edition) on Wayland - X11 display driver, Multi-window, 1 monitor - Vulkan (Forward+) - integrated AMD Radeon 780M Graphics (RADV PHOENIX) - AMD Ryzen 7 8845HS w/ Radeon 780M Graphics (16 threads) - 60.60 GiB memory\n\n### Issue description\n\nGodot supports placing an `override.cfg` file in `res://` (or next to the project executable once exported) to override some of the project settings at runtime.\n\nThis is properly loaded when running the game from the editor, but there's one case which doesn't work: the embedded window mode in `EditorRun` checks some project settings _before_ running the project to determine the window placement and whether to enable HiDPI. This doesn't respect `res://override.cfg` because of #55230.\n\nThis is the affected code and settings:\n\nhttps://github.com/godotengine/godot/blob/7864ac80192e9e91bf56176af9f04cc013b580aa/editor/run/editor_run.cpp#L258-L273\n\nMy use case is to modify the window size with `override.cfg` to have several presets for testing mobile/tablet aspect ratios (by swapping the `override.cfg` file with different presets, and letting that file `.gitignore`'d so it doesn't impact teammates).\n\n### Steps to reproduce\n\nCreate an `override.cfg` file like:\n```\n[display]\n\nwindow/size/window_width_override=400\nwindow/size/window_height_override=240\n```\n\nRun the project without embedding: the window size is correct.\nRun it with embedding: the window size is not applied.\n\n### Minimal reproduction project (MRP)\n\nThis is 2D platformer demo with an `override.cfg` meant to get a smaller window.\n[platformer.zip](https://github.com/user-attachments/files/23003088/platformer.zip)","closed_by":{"login":"Repiteo","id":17489292,"node_id":"MDQ6VXNlcjE3NDg5Mjky","avatar_url":"https://avatars.githubusercontent.com/u/17489292?v=4","gravatar_id":"","url":"https://api.github.com/users/Repiteo","html_url":"https://github.com/Repiteo","followers_url":"https://api.github.com/users/Repiteo/followers","following_url":"https://api.github.com/users/Repiteo/following{/other_user}","gists_url":"https://api.github.com/users/Repiteo/gists{/gist_id}","starred_url":"https://api.github.com/users/Repiteo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Repiteo/subscriptions","organizations_url":"https://api.github.com/users/Repiteo/orgs","repos_url":"https://api.github.com/users/Repiteo/repos","events_url":"https://api.github.com/users/Repiteo/events{/privacy}","received_events_url":"https://api.github.com/users/Repiteo/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/111846/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/godotengine/godot/issues/111846/timeline","performed_via_github_app":null,"state_reason":"completed","pinned_comment":null}