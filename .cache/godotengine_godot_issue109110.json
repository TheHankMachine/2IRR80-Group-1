nn/followers","following_url":"https://api.github.com/users/Sauermann/following{/other_user}","gists_url":"https://api.github.com/users/Sauermann/gists{/gist_id}","starred_url":"https://api.github.com/users/Sauermann/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Sauermann/subscriptions","organizations_url":"https://api.github.com/users/Sauermann/orgs","repos_url":"https://api.github.com/users/Sauermann/repos","events_url":"https://api.github.com/users/Sauermann/events{/privacy}","received_events_url":"https://api.github.com/users/Sauermann/received_events","type":"User","user_view_type":"public","site_admin":false},"open_issues":3,"closed_issues":3687,"state":"closed","created_at":"2024-12-19T08:51:28Z","updated_at":"2026-09-04T21:48:38Z","due_on":"2025-09-15T00:00:00Z","closed_at":"2025-09-18T17:13:14Z"},"comments":2,"created_at":"2025-07-30T05:30:01Z","updated_at":"2025-08-22T21:14:11Z","closed_at":"2025-08-22T21:14:11Z","assignee":{"login":"TokageItLab","id":61938263,"node_id":"MDQ6VXNlcjYxOTM4MjYz","avatar_url":"https://avatars.githubusercontent.com/u/61938263?v=4","gravatar_id":"","url":"https://api.github.com/users/TokageItLab","html_url":"https://github.com/TokageItLab","followers_url":"https://api.github.com/users/TokageItLab/followers","following_url":"https://api.github.com/users/TokageItLab/following{/other_user}","gists_url":"https://api.github.com/users/TokageItLab/gists{/gist_id}","starred_url":"https://api.github.com/users/TokageItLab/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/TokageItLab/subscriptions","organizations_url":"https://api.github.com/users/TokageItLab/orgs","repos_url":"https://api.github.com/users/TokageItLab/repos","events_url":"https://api.github.com/users/TokageItLab/events{/privacy}","received_events_url":"https://api.github.com/users/TokageItLab/received_events","type":"User","user_view_type":"public","site_admin":false},"author_association":"NONE","issue_field_values":[],"type":null,"active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"### Tested versions\n\nTested versions\nGodot v4.5 beta 4\n\n\n### System information\n\nWindows 10 (build 19045) - Multi-window, 2 monitors - Vulkan (Forward+) - dedicated NVIDIA GeForce RTX 3090 (NVIDIA; 32.0.15.6614) - AMD Ryzen 9 5900XT 16-Core Processor (32 threads)\n\n### Issue description\n\nUsing a LookAtModifier3D Node in conjunction with a BoneAttachment3D Node (with override pose enabled and external skeleton) inside another BoneAttachment3D , disables LookAtModifier3D when pausing, even if the BoneAttachment3D is affecting a completly different bone to the LookAtModifier3D.\n\nI tested in 4.4.1 and you can use this set up just fine without any issues.\n\nI also don't think its just \"disabling it on pause\", Its making any collider attached to the lookat bone behave in a strange way, as if it was in 2 positions at once. the neutral position and the position after the lookat is applied, but this the best way I can decribe whats happening\n\nthis is what it looks like now in 4.5 beta 4\n\nhttps://github.com/user-attachments/assets/83100d6e-3fcc-4e90-a4fa-efbf225318f6\n\nhttps://github.com/user-attachments/assets/0f45ec28-e306-4d1d-8908-ab19664d0bd6\n\n### Steps to reproduce\n\nimport a rigged character and use LookAtModifier3D on one bone and BoneAttachment3D on another, then insert another BoneAttachment3D in the first BoneAttachment3D, enable \"Override Pose\" and Use \"External Skeleton\" on this second one, and set up a target for the LookAtModifier3D, run the game and pause, the LookAtModifier3D bone should get disabled on pause and re-enabled when resuming.\n\n### Minimal reproduction project (MRP)\n\n[Bug.zip](https://github.com/user-attachments/files/21501808/Bug.zip)","closed_by":{"login":"Repiteo","id":17489292,"node_id":"MDQ6VXNlcjE3NDg5Mjky","avatar_url":"https://avatars.githubusercontent.com/u/17489292?v=4","gravatar_id":"","url":"https://api.github.com/users/Repiteo","html_url":"https://github.com/Repiteo","followers_url":"https://api.github.com/users/Repiteo/followers","following_url":"https://api.github.com/users/Repiteo/following{/other_user}","gists_url":"https://api.github.com/users/Repiteo/gists{/gist_id}","starred_url":"https://api.github.com/users/Repiteo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Repiteo/subscriptions","organizations_url":"https://api.github.com/users/Repiteo/orgs","repos_url":"https://api.github.com/users/Repiteo/repos","events_url":"https://api.github.com/users/Repiteo/events{/privacy}","received_events_url":"https://api.github.com/users/Repiteo/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/109110/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/godotengine/godot/issues/109110/timeline","performed_via_github_app":null,"state_reason":"completed","pinned_comment":null}