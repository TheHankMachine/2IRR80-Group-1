ed_at":null,"archived_by":null},{"id":283518733,"node_id":"MDU6TGFiZWwyODM1MTg3MzM=","url":"https://api.github.com/repos/godotengine/godot/labels/usability","name":"usability","color":"447744","default":false,"description":"","archived_at":null,"archived_by":null},{"id":2666705648,"node_id":"MDU6TGFiZWwyNjY2NzA1NjQ4","url":"https://api.github.com/repos/godotengine/godot/labels/topic:animation","name":"topic:animation","color":"ffee88","default":false,"description":"","archived_at":null,"archived_by":null}],"state":"closed","locked":false,"assignees":[],"milestone":{"url":"https://api.github.com/repos/godotengine/godot/milestones/24","html_url":"https://github.com/godotengine/godot/milestone/24","labels_url":"https://api.github.com/repos/godotengine/godot/milestones/24/labels","id":14236899,"node_id":"MI_kwDOAO6SJc4A2Tzj","number":24,"title":"4.7","description":"","creator":{"login":"akien-mga","id":4701338,"node_id":"MDQ6VXNlcjQ3MDEzMzg=","avatar_url":"https://avatars.githubusercontent.com/u/4701338?v=4","gravatar_id":"","url":"https://api.github.com/users/akien-mga","html_url":"https://github.com/akien-mga","followers_url":"https://api.github.com/users/akien-mga/followers","following_url":"https://api.github.com/users/akien-mga/following{/other_user}","gists_url":"https://api.github.com/users/akien-mga/gists{/gist_id}","starred_url":"https://api.github.com/users/akien-mga/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/akien-mga/subscriptions","organizations_url":"https://api.github.com/users/akien-mga/orgs","repos_url":"https://api.github.com/users/akien-mga/repos","events_url":"https://api.github.com/users/akien-mga/events{/privacy}","received_events_url":"https://api.github.com/users/akien-mga/received_events","type":"User","user_view_type":"public","site_admin":false},"open_issues":3,"closed_issues":2535,"state":"closed","created_at":"2025-11-27T20:29:18Z","updated_at":"2026-10-20T18:39:31Z","due_on":null,"closed_at":"2026-06-19T16:54:35Z"},"comments":4,"created_at":"2026-03-05T10:54:00Z","updated_at":"2026-03-15T14:15:35Z","closed_at":"2026-03-15T14:15:35Z","assignee":null,"author_association":"CONTRIBUTOR","issue_field_values":[],"type":null,"active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"### Tested versions\n\n- Reproducible in: v4.6.stable.official [89cea1439]\n\n### System information\n\nGodot v4.6.stable - Windows 11 (build 26200) - Multi-window, 1 monitor - OpenGL 3 (Compatibility) - NVIDIA GeForce RTX 3070 (NVIDIA; 32.0.15.6636) - 12th Gen Intel(R) Core(TM) i9-12900K (24 threads) - 63.75 GiB memory\n\n### Issue description\n\nWe found this bug in https://github.com/godotengine/godot-proposals/issues/7548\n\nIn the Animation editor, when user has **no previous key selected** and **immediately right-clicks on a key**, the \"Send Key(s) to RESET\" menu item will not appear, although a key is selected at that time. Looks like the logical check only checks the *previous key selection* instead of the new one we just did.\n\nSo user must first select either the same or some unrelated key to trigger the menu item, and then right-click on the actual key they want to send to RESET, which is unintuitive.\n\n---\n\nSide note: in the repro steps below, I sometimes had troubles taking a stable screenshot of me selecting a sprite keyframe because the frame \"jumps\" to the right when I click on it:\n\n<img width=\"467\" height=\"207\" alt=\"Image\" src=\"https://github.com/user-attachments/assets/b309581e-f2af-4ae2-b0fa-51a8ccb378ad\" />\n\nIt looks like another, unrelated bug, please tell me if you know a ticket for this or if it needs a ticket - it's hard to find the right keywords to search it!\n\n### Steps to reproduce\n\n\n**Repro steps: instant-right click with no previous selection**\n\nInitial state: nothing is selected\n\n<img width=\"553\" height=\"223\" alt=\"Image\" src=\"https://github.com/user-attachments/assets/1344ed94-5733-45c2-973c-3b56d8215f35\" />\n\n1. User right-clicks immediately on a key:\n\n<img width=\"532\" height=\"290\" alt=\"Image\" src=\"https://github.com/user-attachments/assets/2a799674-343e-4eee-ad12-9a53cd85daf3\" />\n\nActual result: \"Send Key(s) to RESET\" is not shown, although a key was selected indeed\nExpected: Show \"Send Key(s) to RESET\" menu item (as if user had selected a key before)\n\n<img width=\"589\" height=\"297\" alt=\"Image\" src=\"https://github.com/user-attachments/assets/942c4486-a7fd-4589-b342-b106127da2ee\" />\n\n### Minimal reproduction project (MRP)\n\n\n[mrp---send-key-to-reset-doesnt-appear-if-no-previous-key-selected.zip](https://github.com/user-attachments/files/25765142/mrp---send-key-to-reset-doesnt-appear-if-no-previous-key-selected.zip)\n\nRemark: for the MRP I removed my game-specific sprite and stripped things to a single scene, so it won't look exactly like the repro steps above but same principle with the Godot icon and 4 frames\n\n<img width=\"615\" height=\"295\" alt=\"Image\" src=\"https://github.com/user-attachments/assets/4d3ed34c-c239-492f-9775-0e24b5469fb1\" />","closed_by":{"login":"akien-mga","id":4701338,"node_id":"MDQ6VXNlcjQ3MDEzMzg=","avatar_url":"https://avatars.githubusercontent.com/u/4701338?v=4","gravatar_id":"","url":"https://api.github.com/users/akien-mga","html_url":"https://github.com/akien-mga","followers_url":"https://api.github.com/users/akien-mga/followers","following_url":"https://api.github.com/users/akien-mga/following{/other_user}","gists_url":"https://api.github.com/users/akien-mga/gists{/gist_id}","starred_url":"https://api.github.com/users/akien-mga/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/akien-mga/subscriptions","organizations_url":"https://api.github.com/users/akien-mga/orgs","repos_url":"https://api.github.com/users/akien-mga/repos","events_url":"https://api.github.com/users/akien-mga/events{/privacy}","received_events_url":"https://api.github.com/users/akien-mga/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/117100/reactions","total_count":3,"+1":3,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/godotengine/godot/issues/117100/timeline","performed_via_github_app":null,"state_reason":"completed","pinned_comment":null}