tars.githubusercontent.com/u/116390362?v=4","gravatar_id":"","url":"https://api.github.com/users/MaoFanMaker","html_url":"https://github.com/MaoFanMaker","followers_url":"https://api.github.com/users/MaoFanMaker/followers","following_url":"https://api.github.com/users/MaoFanMaker/following{/other_user}","gists_url":"https://api.github.com/users/MaoFanMaker/gists{/gist_id}","starred_url":"https://api.github.com/users/MaoFanMaker/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/MaoFanMaker/subscriptions","organizations_url":"https://api.github.com/users/MaoFanMaker/orgs","repos_url":"https://api.github.com/users/MaoFanMaker/repos","events_url":"https://api.github.com/users/MaoFanMaker/events{/privacy}","received_events_url":"https://api.github.com/users/MaoFanMaker/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-03-17T17:45:21Z","updated_at":"2025-03-17T17:45:21Z","body":"Is there any update on this jitter?","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2730377435/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2810228259","html_url":"https://github.com/godotengine/godot/issues/101833#issuecomment-2810228259","issue_url":"https://api.github.com/repos/godotengine/godot/issues/101833","id":2810228259,"node_id":"IC_kwDOAO6SJc6ngK4j","user":{"login":"rbaker87","id":1047829,"node_id":"MDQ6VXNlcjEwNDc4Mjk=","avatar_url":"https://avatars.githubusercontent.com/u/1047829?v=4","gravatar_id":"","url":"https://api.github.com/users/rbaker87","html_url":"https://github.com/rbaker87","followers_url":"https://api.github.com/users/rbaker87/followers","following_url":"https://api.github.com/users/rbaker87/following{/other_user}","gists_url":"https://api.github.com/users/rbaker87/gists{/gist_id}","starred_url":"https://api.github.com/users/rbaker87/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/rbaker87/subscriptions","organizations_url":"https://api.github.com/users/rbaker87/orgs","repos_url":"https://api.github.com/users/rbaker87/repos","events_url":"https://api.github.com/users/rbaker87/events{/privacy}","received_events_url":"https://api.github.com/users/rbaker87/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-04-16T17:21:30Z","updated_at":"2025-04-17T22:08:13Z","body":"This is easily reproducible with the 2D platformer demo in the Godot repo. Enabling position smoothing and setting the smoothing speed via code seems to reset the process_callback state of the camera to 1 (Idle). This does not visually reflect in the runtime debug editor, but if you toggle the process_callback mode of the camera back to idle and then to Physics again, the issue is resolved.\n\nThis can be done via code as well. Set process_callback to 1 and then back to 0 immediately after your position smoothing change.\n\nEdit: I should note that I personally experienced this in 4.4.1\nAlso noticed after writing that pr that this would probably work just toggling once directly to whatever callback state you need. It's only update_process_internal_for_smoothing that has the single state change. The others will toggle both without having to change states back and forth ","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2810228259/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2811322033","html_url":"https://github.com/godotengine/godot/issues/101833#issuecomment-2811322033","issue_url":"https://api.github.com/repos/godotengine/godot/issues/101833","id":2811322033,"node_id":"IC_kwDOAO6SJc6nkV6x","user":{"login":"MaoFanMaker","id":116390362,"node_id":"U_kgDOBu_52g","avatar_url":"https://avatars.githubusercontent.com/u/116390362?v=4","gravatar_id":"","url":"https://api.github.com/users/MaoFanMaker","html_url":"https://github.com/MaoFanMaker","followers_url":"https://api.github.com/users/MaoFanMaker/followers","following_url":"https://api.github.com/users/MaoFanMaker/following{/other_user}","gists_url":"https://api.github.com/users/MaoFanMaker/gists{/gist_id}","starred_url":"https://api.github.com/users/MaoFanMaker/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/MaoFanMaker/subscriptions","organizations_url":"https://api.github.com/users/MaoFanMaker/orgs","repos_url":"https://api.github.com/users/MaoFanMaker/repos","events_url":"https://api.github.com/users/MaoFanMaker/events{/privacy}","received_events_url":"https://api.github.com/users/MaoFanMaker/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-04-17T00:28:21Z","updated_at":"2025-04-17T00:29:04Z","body":"@rbaker87 Thank you so much. It works so good. \n\nTo whoever has this kind of problem, simple do the following\n```\nset_position_smoothing_speed(speed)\nset_process_callback(1)\nset_process_callback(0)\n```","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2811322033/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2811545784","html_url":"https://github.com/godotengine/godot/issues/101833#issuecomment-2811545784","issue_url":"https://api.github.com/repos/godotengine/godot/issues/101833","id":2811545784,"node_id":"IC_kwDOAO6SJc6nlMi4","user":{"login":"rbaker87","id":1047829,"node_id":"MDQ6VXNlcjEwNDc4Mjk=","avatar_url":"https://avatars.githubusercontent.com/u/1047829?v=4","gravatar_id":"","url":"https://api.github.com/users/rbaker87","html_url":"https://github.com/rbaker87","followers_url":"https://api.github.com/users/rbaker87/followers","following_url":"https://api.github.com/users/rbaker87/following{/other_user}","gists_url":"https://api.github.com/users/rbaker87/gists{/gist_id}","starred_url":"https://api.github.com/users/rbaker87/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/rbaker87/subscriptions","organizations_url":"https://api.github.com/users/rbaker87/orgs","repos_url":"https://api.github.com/users/rbaker87/repos","events_url":"https://api.github.com/users/rbaker87/events{/privacy}","received_events_url":"https://api.github.com/users/rbaker87/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-04-17T02:10:01Z","updated_at":"2025-04-17T02:10:01Z","body":"I don't know if this is the correct solution for a PR, but adding another function call to -\n\n`_update_process_callback();`\n\nAt the end of `Camera2D::set_position_smoothing_speed` in https://github.com/godotengine/godot/blob/c5c1cd4440a124f9a19898364b78ff7172755567/scene/2d/camera_2d.cpp#L759 resolves this issue. It's a relatively cheap fix, even if it isn't the right way to solve this.\n\nEither way, maybe this can point someone who knows more about the design of the engine itself in the right direction. In the meantime, it's easier to just toggle the process_callback state than to keep making custom builds.","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2811545784/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2811594729","html_url":"https://github.com/godotengine/godot/issues/101833#issuecomment-2811594729","issue_url":"https://api.github.com/repos/godotengine/godot/issues/101833","id":2811594729,"node_id":"IC_kwDOAO6SJc6nlYfp","user":{"login":"rbaker87","id":1047829,"node_id":"MDQ6VXNlcjEwNDc4Mjk=","avatar_url":"https://avatars.githubusercontent.com/u/1047829?v=4","gravatar_id":"","url":"https://api.github.com/users/rbaker87","html_url":"https://github.com/rbaker87","followers_url":"https://api.github.com/users/rbaker87/followers","following_url":"https://api.github.com/users/rbaker87/following{/other_user}","gists_url":"https://api.github.com/users/rbaker87/gists{/gist_id}","starred_url":"https://api.github.com/users/rbaker87/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/rbaker87/subscriptions","organizations_url":"https://api.github.com/users/rbaker87/orgs","repos_url":"https://api.github.com/users/rbaker87/repos","events_url":"https://api.github.com/users/rbaker87/events{/privacy}","received_events_url":"https://api.github.com/users/rbaker87/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-04-17T02:51:27Z","updated_at":"2025-04-17T03:31:36Z","body":"Alright, the actual issue seems be that \nhttps://github.com/godotengine/godot/blob/c5c1cd4440a124f9a19898364b78ff7172755567/scene/2d/camera_2d.cpp#L619\noccurs after calling set_position_smoothing_speed. This function sets the process callback mode to Idle regardless of the actual state of the process callback camera setting.\n\n```\ndiff --git a/scene/2d/camera_2d.cpp b/scene/2d/camera_2d.cpp\nindex c61086d5a4..b8cdb73f73 100644\n--- a/scene/2d/camera_2d.cpp\n+++ b/scene/2d/camera_2d.cpp\n@@ -621,7 +621,16 @@ void Camera2D::_update_process_internal_for_smoothing() {\n        bool is_any_smoothing_valid = position_smoothing_speed > 0 || rotation_smoothing_speed > 0;\n \n        bool enable = is_any_smoothing_valid && is_not_in_scene_or_editor;\n-       set_process_internal(enable);\n+\n+       if (enable) {\n+               if (process_callback == CAMERA2D_PROCESS_IDLE) {\n+                       set_process_internal(true);\n+                       set_physics_process_internal(false);\n+               } else {\n+                       set_process_internal(false);\n+                       set_physics_process_internal(true);\n+               }\n+       }\n }\n````\n\nresolves the issue more cleanly\n\nEdit: Technically it doesn't override the callback state... it just sets both states to true. This is the only case that I can see where this was possible. Every other situation would attempt to check the process_callback state and swap between the two. I've put in a PR, but I am not entirely sure if this is the correct solution still. It does work to resolve this issue though.","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2811594729/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null}]