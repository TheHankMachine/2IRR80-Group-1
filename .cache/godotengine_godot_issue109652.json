auermann/orgs","repos_url":"https://api.github.com/users/Sauermann/repos","events_url":"https://api.github.com/users/Sauermann/events{/privacy}","received_events_url":"https://api.github.com/users/Sauermann/received_events","type":"User","user_view_type":"public","site_admin":false},"open_issues":3,"closed_issues":3687,"state":"closed","created_at":"2024-12-19T08:51:28Z","updated_at":"2026-09-04T21:48:38Z","due_on":"2025-09-15T00:00:00Z","closed_at":"2025-09-18T17:13:14Z"},"comments":2,"created_at":"2025-08-15T21:34:50Z","updated_at":"2025-08-19T15:32:07Z","closed_at":"2025-08-19T15:32:06Z","assignee":null,"author_association":"NONE","issue_field_values":[],"type":null,"active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"### Tested versions\n\n- Reproducible in 4.5.beta.custom_build.45509c284\n\n### System information\n\nUbuntu - 4.5.beta.custom_build.45509c284 - x86_64\n\n### Issue description\n\nhttps://github.com/user-attachments/assets/2feb6d76-0739-45e2-8fc8-e35deb89b65f\n\nUpon restarting a process, a call to pipe() in the OS_Unix driver provides `0` as the read file descriptor to `pipe_in`:\n ```cpp\n// OS_Unix::execute_with_pipe, lines 737-741\nint pipe_in[2] = { -1, -1 };\nint pipe_out[2] = { -1, -1 };\nint pipe_err[2] = { -1, -1 };\n\nERR_FAIL_COND_V(pipe(pipe_in) != 0, ret); // upon restart pipe_in[0] = 0\n\n// ...\n// lines 772-773,  inside forked process\n::close(STDIN_FILENO);\n::dup2(pipe_in[0], STDIN_FILENO); //  bad file descriptor error.\n\n```\n\nThe editor crashes on any write operation with the bad pipe, in reference to the MRP's main.gd\n```gdscript\nfunc _on_write_pressed() -> void:\n\tpipe_process.stdio.store_line(%TextEdit.text) # <--- SIGPIPE happens here, applies to any write method\n```\n\n### Steps to reproduce\n\n1. Run project\n2. Enter text in text edit and press the button to write to stdin\n3. Restart the process with either the regular restart button or restart with time button\n4. Try to write to stdin again, the game will crash\n\n### Minimal reproduction project (MRP)\n\n[sigpipe_crash_project.zip](https://github.com/user-attachments/files/21803380/sigpipe_crash_project.zip)","closed_by":{"login":"Repiteo","id":17489292,"node_id":"MDQ6VXNlcjE3NDg5Mjky","avatar_url":"https://avatars.githubusercontent.com/u/17489292?v=4","gravatar_id":"","url":"https://api.github.com/users/Repiteo","html_url":"https://github.com/Repiteo","followers_url":"https://api.github.com/users/Repiteo/followers","following_url":"https://api.github.com/users/Repiteo/following{/other_user}","gists_url":"https://api.github.com/users/Repiteo/gists{/gist_id}","starred_url":"https://api.github.com/users/Repiteo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Repiteo/subscriptions","organizations_url":"https://api.github.com/users/Repiteo/orgs","repos_url":"https://api.github.com/users/Repiteo/repos","events_url":"https://api.github.com/users/Repiteo/events{/privacy}","received_events_url":"https://api.github.com/users/Repiteo/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/109652/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/godotengine/godot/issues/109652/timeline","performed_via_github_app":null,"state_reason":"completed","pinned_comment":null}