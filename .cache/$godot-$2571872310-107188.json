hub.com/repos/godotengine/godot/pulls/107188","author_association":"CONTRIBUTOR","submitted_at":"2025-06-09T09:43:30Z"},{"id":2909563945,"node_id":"PRR_kwDOAO6SJc6tbGwp","state":"COMMENTED","user":{"site_admin":false,"suspended":false,"updated_at":"0001-01-01T00:00:00Z","avatar_url":"https://avatars.githubusercontent.com/u/96648715?u=af70f5d107e9c1447f296643d5a566dab53d25e8&v=4","created_at":"0001-01-01T00:00:00Z","followers":0,"following":0,"html_url":"https://github.com/AThousandShips","id":96648715,"node_id":"U_kgDOBcK-Cw","login":"AThousandShips","type":"User","owned_private_repos":0,"public_gists":0,"public_repos":0,"total_private_repos":0,"url":"https://api.github.com/users/AThousandShips"},"body":"","html_url":"https://github.com/godotengine/godot/pull/107188#pullrequestreview-2909563945","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/107188","author_association":"MEMBER","submitted_at":"2025-06-09T09:52:48Z"},{"id":2912950092,"node_id":"PRR_kwDOAO6SJc6toBdM","state":"COMMENTED","user":{"site_admin":false,"suspended":false,"updated_at":"0001-01-01T00:00:00Z","avatar_url":"https://avatars.githubusercontent.com/u/4701338?u=4a42fd867f2c449fcc23adf635dd574dae98e6c2&v=4","created_at":"0001-01-01T00:00:00Z","followers":0,"following":0,"html_url":"https://github.com/akien-mga","id":4701338,"node_id":"MDQ6VXNlcjQ3MDEzMzg=","login":"akien-mga","type":"User","owned_private_repos":0,"public_gists":0,"public_repos":0,"total_private_repos":0,"url":"https://api.github.com/users/akien-mga"},"body":"Looks pretty good to me!\r\n\r\nI notice that, unlike what I might have suggested before, `--movie-writer` seems to be exposed in non-editor builds (export templates). I don't know if it actually works that way, but that means that with the changes done to only include the theora encoder in editor builds, OGV won't be available as a format for runtime movie encoding.\r\n\r\nI think it's an appropriate tradeoff for now, and we can reconsider it if there's significant demand and the binary size impact is not too big.","html_url":"https://github.com/godotengine/godot/pull/107188#pullrequestreview-2912950092","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/107188","author_association":"MEMBER","submitted_at":"2025-06-10T11:10:47Z"},{"id":2913130864,"node_id":"PRR_kwDOAO6SJc6totlw","state":"COMMENTED","user":{"site_admin":false,"suspended":false,"updated_at":"0001-01-01T00:00:00Z","avatar_url":"https://avatars.githubusercontent.com/u/162766?v=4","created_at":"0001-01-01T00:00:00Z","followers":0,"following":0,"html_url":"https://github.com/berarma","id":162766,"node_id":"MDQ6VXNlcjE2Mjc2Ng==","login":"berarma","type":"User","owned_private_repos":0,"public_gists":0,"public_repos":0,"total_private_repos":0,"url":"https://api.github.com/users/berarma"},"body":"","html_url":"https://github.com/godotengine/godot/pull/107188#pullrequestreview-2913130864","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/107188","author_association":"CONTRIBUTOR","submitted_at":"2025-06-10T11:25:58Z"},{"id":2913309645,"node_id":"PRR_kwDOAO6SJc6tpZPN","state":"COMMENTED","user":{"site_admin":false,"suspended":false,"updated_at":"0001-01-01T00:00:00Z","avatar_url":"https://avatars.githubusercontent.com/u/162766?v=4","created_at":"0001-01-01T00:00:00Z","followers":0,"following":0,"html_url":"https://github.com/berarma","id":162766,"node_id":"MDQ6VXNlcjE2Mjc2Ng==","login":"berarma","type":"User","owned_private_repos":0,"public_gists":0,"public_repos":0,"total_private_repos":0,"url":"https://api.github.com/users/berarma"},"body":"","html_url":"https://github.com/godotengine/godot/pull/107188#pullrequestreview-2913309645","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/107188","author_association":"CONTRIBUTOR","submitted_at":"2025-06-10T12:16:45Z"},{"id":2913319162,"node_id":"PRR_kwDOAO6SJc6tpbj6","state":"COMMENTED","user":{"site_admin":false,"suspended":false,"updated_at":"00