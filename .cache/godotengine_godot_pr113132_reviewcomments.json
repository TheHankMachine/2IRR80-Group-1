[{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/2568642422","pull_request_review_id":3515319242,"id":2568642422,"node_id":"PRRC_kwDOAO6SJc6ZGl92","diff_hunk":"@@ -35,15 +35,19 @@\n #include \"core/debugger/engine_debugger.h\"\n #include \"core/object/class_db.h\"\n \n-template <typename R, typename A, typename B>\n-class OperatorEvaluatorAdd {\n+template <typename Evaluator>\n+class CommonEvaluate {\n public:\n \tstatic void evaluate(const Variant &p_left, const Variant &p_right, Variant *r_ret, bool &r_valid) {\n-\t\tconst A &a = VariantInternalAccessor<A>::get(&p_left);\n-\t\tconst B &b = VariantInternalAccessor<B>::get(&p_right);\n-\t\t*r_ret = a + b;\n+\t\tVariantInternal::initialize(r_ret, Evaluator::get_return_type());","path":"core/variant/variant_op.h","commit_id":"d4a55a2206a2c8721d49794f2d1124f419d3286f","original_commit_id":"d4a55a2206a2c8721d49794f2d1124f419d3286f","user":{"login":"Ivorforce","id":2308167,"node_id":"MDQ6VXNlcjIzMDgxNjc=","avatar_url":"https://avatars.githubusercontent.com/u/2308167?v=4","gravatar_id":"","url":"https://api.github.com/users/Ivorforce","html_url":"https://github.com/Ivorforce","followers_url":"https://api.github.com/users/Ivorforce/followers","following_url":"https://api.github.com/users/Ivorforce/following{/other_user}","gists_url":"https://api.github.com/users/Ivorforce/gists{/gist_id}","starred_url":"https://api.github.com/users/Ivorforce/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Ivorforce/subscriptions","organizations_url":"https://api.github.com/users/Ivorforce/orgs","repos_url":"https://api.github.com/users/Ivorforce/repos","events_url":"https://api.github.com/users/Ivorforce/events{/privacy}","received_events_url":"https://api.github.com/users/Ivorforce/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"Using `VariantInternal::initialize` here guarantees that the value is cleared, even if it is already the correct type. This is somewhat wasteful when using an allocated type (in the case when it's already the same type).\r\n\r\nThe following code will avoid this, instead re-using existing memory if it's there, through an `if` condition. I think it should turn out faster.\r\n\r\n```suggestion\r\n\t\tVariantTypeChanger<Evaluator::ResultType>::change(r_ret);\r\n```\r\n\r\n(of course, this requires a `using ResultType = R` in all the evaluators)","created_at":"2025-11-27T13:17:35Z","updated_at":"2025-11-27T13:23:38Z","html_url":"https://github.com/godotengine/godot/pull/113132#discussion_r2568642422","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/113132","_links":{"self":{"href":"https://api.github.com/repos/godotengine/godot/pulls/comments/2568642422"},"html":{"href":"https://github.com/godotengine/godot/pull/113132#discussion_r2568642422"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/113132"}},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/2568642422/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":null,"original_line":42,"side":"RIGHT","author_association":"MEMBER","original_position":13,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/2572076978","pull_request_review_id":3519460994,"id":2572076978,"node_id":"PRRC_kwDOAO6SJc6ZTsey","diff_hunk":"@@ -35,15 +35,19 @@\n #include \"core/debugger/engine_debugger.h\"\n #include \"core/object/class_db.h\"\n \n-template <typename R, typename A, typename B>\n-class OperatorEvaluatorAdd {\n+template <typename Evaluator>\n+class CommonEvaluate {\n public:\n \tstatic void evaluate(const Variant &p_left, const Variant &p_right, Variant *r_ret, bool &r_valid) {\n-\t\tconst A &a = VariantInternalAccessor<A>::get(&p_left);\n-\t\tconst B &b = VariantInternalAccessor<B>::get(&p_right);\n-\t\t*r_ret = a + b;\n+\t\tVariantInternal::initialize(r_ret, Evaluator::get_return_type());","path":"core/variant/variant_op.h","commit_id":"d4a55a2206a2c8721d49794f2d1124f419d3286f","original_commit_id":"d4a55a2206a2c8721d49794f2d1124f419d3286f","user":{"login":"aaronp64","id":136198872,"node_id":"U_kgDOCB462A","avatar_url":"https://avatars.githubusercontent.com/u/136198872?v=4","gravatar_id":"","url":"https://api.github.com/users/aaronp64","html_url":"https://github.com/aaronp64","followers_url":"https://api.github.com/users/aaronp64/followers","following_url":"https://api.github.com/users/aaronp64/following{/other_user}","gists_url":"https://api.github.com/users/aaronp64/gists{/gist_id}","starred_url":"https://api.github.com/users/aaronp64/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/aaronp64/subscriptions","organizations_url":"https://api.github.com/users/aaronp64/orgs","repos_url":"https://api.github.com/users/aaronp64/repos","events_url":"https://api.github.com/users/aaronp64/events{/privacy}","received_events_url":"https://api.github.com/users/aaronp64/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"Updated to use `change`, and moved `get_return_type` to the base class now that it has the type info available","created_at":"2025-11-28T16:10:55Z","updated_at":"2025-11-28T16:10:56Z","html_url":"https://github.com/godotengine/godot/pull/113132#discussion_r2572076978","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/113132","_links":{"self":{"href":"https://api.github.com/repos/godotengine/godot/pulls/comments/2572076978"},"html":{"href":"https://github.com/godotengine/godot/pull/113132#discussion_r2572076978"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/113132"}},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/2572076978/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":null,"original_line":42,"side":"RIGHT","in_reply_to_id":2568642422,"author_association":"CONTRIBUTOR","original_position":13,"position":1,"subject_type":"line"}]