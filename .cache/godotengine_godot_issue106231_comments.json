[{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2869044506","html_url":"https://github.com/godotengine/godot/pull/106231#issuecomment-2869044506","issue_url":"https://api.github.com/repos/godotengine/godot/issues/106231","id":2869044506,"node_id":"IC_kwDOAO6SJc6rAiUa","user":{"login":"RedMser","id":5117197,"node_id":"MDQ6VXNlcjUxMTcxOTc=","avatar_url":"https://avatars.githubusercontent.com/u/5117197?v=4","gravatar_id":"","url":"https://api.github.com/users/RedMser","html_url":"https://github.com/RedMser","followers_url":"https://api.github.com/users/RedMser/followers","following_url":"https://api.github.com/users/RedMser/following{/other_user}","gists_url":"https://api.github.com/users/RedMser/gists{/gist_id}","starred_url":"https://api.github.com/users/RedMser/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/RedMser/subscriptions","organizations_url":"https://api.github.com/users/RedMser/orgs","repos_url":"https://api.github.com/users/RedMser/repos","events_url":"https://api.github.com/users/RedMser/events{/privacy}","received_events_url":"https://api.github.com/users/RedMser/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-05-10T17:33:58Z","updated_at":"2025-05-11T10:52:32Z","body":"Looking at your video, it seems like the `MovieWriterButtonNormal` theme style isn't applying anymore.\r\n\r\nOr rather, you'll need to change how the custom \"highlight\" style of the movie writer button works now, since the button itself is no longer a toggle button.","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2869044506/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":{"reason":"resolved"}},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2869045248","html_url":"https://github.com/godotengine/godot/pull/106231#issuecomment-2869045248","issue_url":"https://api.github.com/repos/godotengine/godot/issues/106231","id":2869045248,"node_id":"IC_kwDOAO6SJc6rAigA","user":{"login":"Meorge","id":9957987,"node_id":"MDQ6VXNlcjk5NTc5ODc=","avatar_url":"https://avatars.githubusercontent.com/u/9957987?v=4","gravatar_id":"","url":"https://api.github.com/users/Meorge","html_url":"https://github.com/Meorge","followers_url":"https://api.github.com/users/Meorge/followers","following_url":"https://api.github.com/users/Meorge/following{/other_user}","gists_url":"https://api.github.com/users/Meorge/gists{/gist_id}","starred_url":"https://api.github.com/users/Meorge/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Meorge/subscriptions","organizations_url":"https://api.github.com/users/Meorge/orgs","repos_url":"https://api.github.com/users/Meorge/repos","events_url":"https://api.github.com/users/Meorge/events{/privacy}","received_events_url":"https://api.github.com/users/Meorge/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-05-10T17:36:16Z","updated_at":"2025-05-10T17:36:16Z","body":"I can double check it later, but I'm pretty sure it is working. I think it's just the custom style I have installed that's much lower contrast than the default - IIRC without the PR code, the appearance is the same when the button's been toggled. Again though I'll have to double check","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2869045248/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2869065988","html_url":"https://github.com/godotengine/godot/pull/106231#issuecomment-2869065988","issue_url":"https://api.github.com/repos/godotengine/godot/issues/106231","id":2869065988,"node_id