 you take this from another method? I don't think this is needed it'll just be noisy and return the same value ","created_at":"2025-08-07T08:03:14Z","updated_at":"2025-08-07T08:04:58Z","html_url":"https://github.com/godotengine/godot/pull/109381#discussion_r2259476636","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/109381","_links":{"self":{"href":"https://api.github.com/repos/godotengine/godot/pulls/comments/2259476636"},"html":{"href":"https://github.com/godotengine/godot/pull/109381#discussion_r2259476636"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/109381"}},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/2259476636/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":null,"original_line":267,"side":"RIGHT","author_association":"MEMBER","original_position":6,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/2259477221","pull_request_review_id":3095912751,"id":2259477221,"node_id":"PRRC_kwDOAO6SJc6GrOLl","diff_hunk":"@@ -262,6 +262,13 @@ int AudioStreamPlaybackSynchronized::mix(AudioFrame *p_buffer, float p_rate_scal\n \treturn p_frames;\n }\n \n+Ref<AudioStreamPlayback> AudioStreamPlaybackSynchronized::get_playback(int p_index) {\n+\tERR_FAIL_INDEX_V_MSG(p_index, stream->stream_count, 0, \"Stream index out of bounds\");","path":"modules/interactive_music/audio_stream_synchronized.cpp","commit_id":"1868ec223513b2113e3157c1bc214ea89c45d6c5","original_commit_id":"96269c4a724b457506719d3c669acdf73f363dbd","user":{"login":"AThousandShips","id":96648715,"node_id":"U_kgDOBcK-Cw","avatar_url":"https://avatars.githubusercontent.com/u/96648715?v=4","gravatar_id":"","url":"https://api.github.com/users/AThousandShips","html_url":"https://github.com/AThousandShips","followers_url":"https://api.github.com/users/AThousandShips/followers","following_url":"https://api.github.com/users/AThousandShips/following{/other_user}","gists_url":"https://api.github.com/users/AThousandShips/gists{/gist_id}","starred_url":"https://api.github.com/users/AThousandShips/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/AThousandShips/subscriptions","organizations_url":"https://api.github.com/users/AThousandShips/orgs","repos_url":"https://api.github.com/users/AThousandShips/repos","events_url":"https://api.github.com/users/AThousandShips/events{/privacy}","received_events_url":"https://api.github.com/users/AThousandShips/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"```suggestion\r\n\tERR_FAIL_INDEX_V_MSG(p_index, stream->stream_count, Ref<AudioStreamPlayback>(), \"Stream index out of bounds.\");\r\n```","created_at":"2025-08-07T08:03:29Z","updated_at":"2025-08-07T08:04:58Z","html_url":"https://github.com/godotengine/godot/pull/109381#discussion_r2259477221","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/109381","_links":{"self":{"href":"https://api.github.com/repos/godotengine/godot/pulls/comments/2259477221"},"html":{"href":"https://github.com/godotengine/godot/pull/109381#discussion_r2259477221"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/109381"}},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/2259477221/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":null,"original_line":266,"side":"RIGHT","author_association":"MEMBER","original_position":5,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/2261609653","pull_request_review_id":3099011878,"id":2261609653,"node_id":"PRRC_kwDOAO6SJc6GzWy1","diff_hunk":"@@ -262,6 +262,13 @@ int AudioStreamPlaybackSynchronized::mix(AudioFrame *p_buffer, float p_rate_scal\n \treturn p_frames;\n }\n \n+Ref<AudioStreamPlayback> AudioStreamPlaybackSynchronized::get_playback(int p_index) {\n+\tERR_FAIL_INDEX_V_MSG(p_index, stream->stream_count, 0, \"Stream index out of bounds\");\n+\tERR_FAIL_COND_V_MSG(!playback[p_index].is_valid(), 0, \"Stream at index is not valid\");","path":"modules/interactive_music/audio_stream_synchronized.cpp","commit_id":"1868ec223513b2113e3157c1bc214ea89c45d6c5","original_commit_id":"96269c4a724b457506719d3c669acdf73f363dbd","user":{"login":"sebageek","id":2045907,"node_id":"MDQ6VXNlcjIwNDU5MDc=","avatar_url":"https://avatars.githubusercontent.com/u/2045907?v=4","gravatar_id":"","url":"https://api.github.com/users/sebageek","html_url":"https://github.com/sebageek","followers_url":"https://api.github.com/users/sebageek/followers","following_url":"https://api.github.com/users/sebageek/following{/other_user}","gists_url":"https://api.github.com/users/sebageek/gists{/gist_id}","starred_url":"https://api.github.com/users/sebageek/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/sebageek/subscriptions","organizations_url":"https://api.github.com/users/sebageek/orgs","repos_url":"https://api.github.com/users/sebageek/repos","events_url":"https://api.github.com/users/sebageek/events{/privacy}","received_events_url":"https://api.github.com/users/sebageek/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"Thanks for the review.\r\nRegarding return types: Specifying `Ref<AudioStreamPlayback>()` makes more sense. I was trying to get a \"null object\". Providing `0` actually resulted in the same object being constructed, probably due to implicit conversion? Anyway, your version is definitely the cleaner one.\r\n\r\nRegarding `is_valid()` / `is_null()`: I looked around in `AudioStreamPlaybackSynchronized` how `playback` was being used in code and it seems like every time it's being accessed `is_valid()` is used to check if the reference is valid, that is why I adopted it as an extra check here as well. My guess is that the playback of a sub-stream can fail/break/stop and then might get freed while others work, resulting in gaps, but... that's only a guess. So if you tell me the check actually is redundant I can take it out of the code. What do you think?","created_at":"2025-08-07T23:00:59Z","updated_at":"2025-08-07T23:00:59Z","html_url":"https://github.com/godotengine/godot/pull/109381#discussion_r2261609653","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/109381","_links":{"self":{"href":"https://api.github.com/repos/godotengine/godot/pulls/comments/2261609653"},"html":{"href":"https://github.com/godotengine/godot/pull/109381#discussion_r2261609653"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/109381"}},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/2261609653/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":null,"original_line":267,"side":"RIGHT","in_reply_to_id":2259476636,"author_association":"NONE","original_position":6,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/2261620484","pull_request_review_id":3099025443,"id":2261620484,"node_id":"PRRC_kwDOAO6SJc6GzZcE","diff_hunk":"@@ -262,6 +262,13 @@ int AudioStreamPlaybackSynchronized::mix(AudioFrame *p_buffer, float p_rate_scal\n \treturn p_frames;\n }\n \n+Ref<AudioStreamPlayback> AudioStreamPlaybackSynchronized::get_playback(int p_index) {\n+\tERR_FAIL_INDEX_V_MSG(p_index, stream->stream_count, 0, \"Stream index out of bounds\");\n+\tERR_FAIL_COND_V_MSG(!playback[p_index].is_valid(), 0, \"Stream at index is not valid\");","path":"modules/interactive_music/audio_stream_synchronized.cpp","commit_id":"1868ec223513b2113e3157c1bc214ea89c45d6c5","origina