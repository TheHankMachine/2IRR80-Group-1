:0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3078231185","html_url":"https://github.com/godotengine/godot/issues/106964#issuecomment-3078231185","issue_url":"https://api.github.com/repos/godotengine/godot/issues/106964","id":3078231185,"node_id":"IC_kwDOAO6SJc63ehSR","user":{"login":"Draknek","id":184057,"node_id":"MDQ6VXNlcjE4NDA1Nw==","avatar_url":"https://avatars.githubusercontent.com/u/184057?v=4","gravatar_id":"","url":"https://api.github.com/users/Draknek","html_url":"https://github.com/Draknek","followers_url":"https://api.github.com/users/Draknek/followers","following_url":"https://api.github.com/users/Draknek/following{/other_user}","gists_url":"https://api.github.com/users/Draknek/gists{/gist_id}","starred_url":"https://api.github.com/users/Draknek/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Draknek/subscriptions","organizations_url":"https://api.github.com/users/Draknek/orgs","repos_url":"https://api.github.com/users/Draknek/repos","events_url":"https://api.github.com/users/Draknek/events{/privacy}","received_events_url":"https://api.github.com/users/Draknek/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-07-16T11:52:07Z","updated_at":"2025-07-16T11:52:07Z","body":"I narrowed my issue down: it happens if using Gradle. By default, Gradle uses a daemon process, to speed up subsequent builds. This daemon keeps running in the background after the export is completed.\n\nTo stop this behaviour from happening, you can add the line `org.gradle.daemon=false` in your `gradle.properties` file.","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3078231185/reactions","total_count":2,"+1":2,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null}]