0\" height=\"925\" alt=\"clamp-directional-4-blend\" src=\"https://github.com/user-attachments/assets/2b3348dc-ef4c-4bfd-872e-da3909f818a4\" /> | <img width=\"1510\" height=\"925\" alt=\"fix-directional-4-blend\" src=\"https://github.com/user-attachments/assets/a102d2d0-7690-4632-8d37-9e2ac19ea275\" /> | \r\n\r\nThere's probably a bug somewhere else but I think the penumbra result should be at least clamped to some value.\r\n","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5087660732/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5128669551","html_url":"https://github.com/godotengine/godot/pull/121723#issuecomment-5128669551","issue_url":"https://api.github.com/repos/godotengine/godot/issues/121723","id":5128669551,"node_id":"IC_kwDOAO6SJc8AAAABMbFJbw","user":{"login":"mrcdk","id":483531,"node_id":"MDQ6VXNlcjQ4MzUzMQ==","avatar_url":"https://avatars.githubusercontent.com/u/483531?v=4","gravatar_id":"","url":"https://api.github.com/users/mrcdk","html_url":"https://github.com/mrcdk","followers_url":"https://api.github.com/users/mrcdk/followers","following_url":"https://api.github.com/users/mrcdk/following{/other_user}","gists_url":"https://api.github.com/users/mrcdk/gists{/gist_id}","starred_url":"https://api.github.com/users/mrcdk/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/mrcdk/subscriptions","organizations_url":"https://api.github.com/users/mrcdk/orgs","repos_url":"https://api.github.com/users/mrcdk/repos","events_url":"https://api.github.com/users/mrcdk/events{/privacy}","received_events_url":"https://api.github.com/users/mrcdk/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-07-30T08:53:48Z","updated_at":"2026-07-30T08:56:29Z","body":"I decided to swap the subtraction so penumbra is positive. There are small changes:\r\n\r\n| light | before | after |\r\n|--------|--------|--------|\r\n| directional | <img width=\"1834\" height=\"1039\" alt=\"directional-fix-1\" src=\"https://github.com/user-attachments/assets/b3bd7df0-6235-4ca4-9cea-59d42e153b7a\" /> | <img width=\"1834\" height=\"1039\" alt=\"directional-fix-2\" src=\"https://github.com/user-attachments/assets/66487039-dd59-4230-85b0-617850ef7fc4\" /> |\r\n| omni | <img width=\"1577\" height=\"784\" alt=\"omni-fix-1\" src=\"https://github.com/user-attachments/assets/ca5f3931-b5f3-451d-b1dc-8eca0eb07f0d\" /> | <img width=\"1577\" height=\"784\" alt=\"omni-fix-2\" src=\"https://github.com/user-attachments/assets/4a0f36f8-c552-43b8-b703-ac769a75da41\" /> |\r\n| area | <img width=\"1577\" height=\"784\" alt=\"area-fix-1\" src=\"https://github.com/user-attachments/assets/ad6dddb2-cbc4-4805-b333-3c7af169c005\" /> | <img width=\"1577\" height=\"784\" alt=\"area-fix-2\" src=\"https://github.com/user-attachments/assets/7ad8e60e-afaa-4f04-8fb4-d5cd47f41554\" /> |\r\n\r\n\r\n\r\n\r\n\r\n\r\n","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5128669551/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5475387132","html_url":"https://github.com/godotengine/godot/pull/121723#issuecomment-5475387132","issue_url":"https://api.github.com/repos/godotengine/godot/issues/121723","id":5475387132,"node_id":"IC_kwDOAO6SJc8AAAABRlvG_A","user":{"login":"mrcdk","id":483531,"node_id":"MDQ6VXNlcjQ4MzUzMQ==","avatar_url":"https://avatars.githubusercontent.com/u/483531?v=4","gravatar_id":"","url":"https://api.github.com/users/mrcdk","html_url":"https://github.com/mrcdk","followers_url":"https://api.github.com/users/mrcdk/followers","following_url":"https://api.github.com/users/mrcdk/following{/other_user}","gists_url":"https://api.github.com/users/mrcdk/gists{/gist_id}","starred_url":"https://api.github.com/users/mrcdk/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/mrcdk/subscriptions","organizations_url":"https://api.github.com/users/mrcdk/orgs","repos_url":"https://api.github.com/users/mrcdk/repos","events_url":"https://api.github.com/users/mrcdk/events{/privacy}","received_events_url":"https://api.github.com/users/mrcdk/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-08-31T07:50:39Z","updated_at":"2026-08-31T07:50:39Z","body":"Okay, after going back to this issue and comparing it with the `LightmapGI` shadowmask results I think my changes are wrong and the original formula is right so I'll be closing this PR.\r\n\r\nThe problem with shadows bugging out and disappearing with directional lights at low angles for distant objects behind the camera is the pancake size because it flattens the depth information for distant objects so the result of searching the blockers is wrong. Disabling pancake (setting `DirectionalLight3D.pancake_size` to `0.0`) still does not solve the issue because then distant objects behind the camera will get culled. Disabling the flattening of the depth in the shader but keeping the same behavior of `DirectionalLight3D.pancake_size` when calculating the shadow camera projection and all that does solve the issue when cranking up the value.","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5475387132/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5477450996","html_url":"https://github.com/godotengine/godot/pull/121723#issuecomment-5477450996","issue_url":"https