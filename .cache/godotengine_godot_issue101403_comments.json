_url":"https://api.github.com/users/twrightsman/subscriptions","organizations_url":"https://api.github.com/users/twrightsman/orgs","repos_url":"https://api.github.com/users/twrightsman/repos","events_url":"https://api.github.com/users/twrightsman/events{/privacy}","received_events_url":"https://api.github.com/users/twrightsman/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-07-15T13:58:25Z","updated_at":"2026-07-15T13:58:25Z","body":"Hey, just a friendly ping on this. Is this something you all want to merge in eventually or should I refactor it in a different direction?","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4981420044/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null}]