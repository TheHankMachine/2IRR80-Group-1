bd4-31a6bf65a2e8\" />\n\n### Minimal reproduction project (MRP)\n\n[mrp-bezier-handle-mode-init.zip](https://github.com/user-attachments/files/31251020/mrp-bezier-handle-mode-init.zip)","closed_by":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/122625/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/godotengine/godot/issues/122625/timeline","performed_via_github_app":null,"state_reason":null,"pinned_comment":null}