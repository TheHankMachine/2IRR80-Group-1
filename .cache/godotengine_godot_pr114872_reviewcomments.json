estion\r\n\t\t\t\t\tconst int len = rptr - &p_str[index];\r\n\t\t\t\t\tconst int64_t number_int = String::to_int(&p_str[index], len, true);\r\n```","created_at":"2026-01-12T18:21:03Z","updated_at":"2026-01-12T18:22:40Z","html_url":"https://github.com/godotengine/godot/pull/114872#discussion_r2683387603","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/114872","_links":{"self":{"href":"https://api.github.com/repos/godotengine/godot/pulls/comments/2683387603"},"html":{"href":"https://github.com/godotengine/godot/pull/114872#discussion_r2683387603"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/114872"}},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/2683387603/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":389,"start_side":"RIGHT","line":null,"original_line":391,"side":"RIGHT","author_association":"MEMBER","original_position":7,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/2747102483","pull_request_review_id":3729342766,"id":2747102483,"node_id":"PRRC_kwDOAO6SJc6jvXUT","diff_hunk":"@@ -31,7 +31,6 @@\n \t\t[b]Note:[/b] Both parse methods do not fully comply with the JSON specification:\n \t\t- Trailing commas in arrays or objects are ignored, instead of causing a parser error.\n \t\t- New line and tab characters are accepted in string literals, and are treated like their corresponding escape sequences [code]\\n[/code] and [code]\\t[/code].\n-\t\t- Numbers are parsed using [method String.to_float] which is generally more lax than the JSON specification.","path":"doc/classes/JSON.xml","commit_id":"507df6996a7dcd0c0c9135d70762c47b3fe33339","original_commit_id":"a9b67c6e8d088bcde7d9dce336fb0995b8d3d4f8","user":{"login":"aaronfranke","id":1646875,"node_id":"MDQ6VXNlcjE2NDY4NzU=","avatar_url":"https://avatars.githubusercontent.com/u/1646875?v=4","gravatar_id":"","url":"https://api.github.com/users/aaronfranke","html_url":"https://github.com/aaronfranke","followers_url":"https://api.github.com/users/aaronfranke/followers","following_url":"https://api.github.com/users/aaronfranke/following{/other_user}","gists_url":"https://api.github.com/users/aaronfranke/gists{/gist_id}","starred_url":"https://api.github.com/users/aaronfranke/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/aaronfranke/subscriptions","organizations_url":"https://api.github.com/users/aaronfranke/orgs","repos_url":"https://api.github.com/users/aaronfranke/repos","events_url":"https://api.github.com/users/aaronfranke/events{/privacy}","received_events_url":"https://api.github.com/users/aaronfranke/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"This note should be modified, not removed.\n\n```\n- Numbers are parsed as integers when possible ([method String.to_int]) and floats otherwise ([method String.to_float]), which is different from the JSON specification which only defines a single number type.\n```","created_at":"2026-01-30T16:41:15Z","updated_at":"2026-01-30T16:41:19Z","html_url":"https://github.com/godotengine/godot/pull/114872#discussion_r2747102483","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/114872","_links":{"self":{"href":"https://api.github.com/repos/godotengine/godot/pulls/comments/2747102483"},"html":{"href":"https://github.com/godotengine/godot/pull/114872#discussion_r2747102483"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/114872"}},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/2747102483/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":34,"original_line":34,"side":"LEFT","author_association":"MEMBER","original_position":4,"posi