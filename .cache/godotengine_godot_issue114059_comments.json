i++) {\n\t\tint root_bone = chain_settings[i]->root_bone.bone;\n\t\tif (root_bone < 0) {\n\t\t\tcontinue;\n\t\t}\n\t\tTransform3D new_tr = get_bone_global_rest_mutable(skeleton, root_bone);\n\t\tchanged = changed || !chain_settings[i]->root_global_rest.is_equal_approx(new_tr);\n\t\tchain_settings[i]->root_global_rest = new_tr;\n\t}\n\tif (changed) {\n\t\t_make_gizmo_dirty();\n\t}\n}","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3658111187/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3658144519","html_url":"https://github.com/godotengine/godot/issues/114059#issuecomment-3658144519","issue_url":"https://api.github.com/repos/godotengine/godot/issues/114059","id":3658144519,"node_id":"IC_kwDOAO6SJc7aCtsH","user":{"login":"CSLRDoesntGameDev","id":126827743,"node_id":"U_kgDOB4883w","avatar_url":"https://avatars.githubusercontent.com/u/126827743?v=4","gravatar_id":"","url":"https://api.github.com/users/CSLRDoesntGameDev","html_url":"https://github.com/CSLRDoesntGameDev","followers_url":"https://api.github.com/users/CSLRDoesntGameDev/followers","following_url":"https://api.github.com/users/CSLRDoesntGameDev/following{/other_user}","gists_url":"https://api.github.com/users/CSLRDoesntGameDev/gists{/gist_id}","starred_url":"https://api.github.com/users/CSLRDoesntGameDev/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/CSLRDoesntGameDev/subscriptions","organizations_url":"https://api.github.com/users/CSLRDoesntGameDev/orgs","repos_url":"https://api.github.com/users/CSLRDoesntGameDev/repos","events_url":"https://api.github.com/users/CSLRDoesntGameDev/events{/privacy}","received_events_url":"https://api.github.com/users/CSLRDoesntGameDev/received_events","type":"User","user_view_type":"public",