repos/godotengine/godot/issues/101306","id":2774344459,"node_id":"IC_kwDOAO6SJc6lXSML","user":{"login":"kitbdev","id":10054226,"node_id":"MDQ6VXNlcjEwMDU0MjI2","avatar_url":"https://avatars.githubusercontent.com/u/10054226?v=4","gravatar_id":"","url":"https://api.github.com/users/kitbdev","html_url":"https://github.com/kitbdev","followers_url":"https://api.github.com/users/kitbdev/followers","following_url":"https://api.github.com/users/kitbdev/following{/other_user}","gists_url":"https://api.github.com/users/kitbdev/gists{/gist_id}","starred_url":"https://api.github.com/users/kitbdev/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/kitbdev/subscriptions","organizations_url":"https://api.github.com/users/kitbdev/orgs","repos_url":"https://api.github.com/users/kitbdev/repos","events_url":"https://api.github.com/users/kitbdev/events{/privacy}","received_events_url":"https://api.github.com/users/kitbdev/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-04-03T03:16:24Z","updated_at":"2025-04-03T03:19:56Z","body":"You can open the Editor Settings menu, then switch to the Shortcuts tab. Then search for the shortcut, and you can edit it. If you want `ui_text_completion_accept` to use `Enter`, make sure to remove it from the `ui_text_completion_replace` shortcut too.\n\n![Image](https://github.com/user-attachments/assets/5510ced3-1153-46af-95fb-2c6a4359ea6e)","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2774344459/reactions","total_count":15,"+1":10,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":5,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2796699357","html_url":"https://github.com/godotengine/godot/issues/101306#issuecomment-2796699357","issue_url":"https://api.github.com/repos/godotengine/godot/issues/101306","id":2796699357,"node_id":"IC_kwDOAO6SJc6msj7d","user":{"login":"betalars","id":18014034,"node_id":"MDQ6VXNlcjE4MDE0MDM0","avatar_url":"https://avatars.githubusercontent.com/u/18014034?v=4","gravatar_id":"","url":"https://api.github.com/users/betalars","html_url":"https://github.com/betalars","followers_url":"https://api.github.com/users/betalars/followers","following_url":"https://api.github.com/users/betalars/following{/other_user}","gists_url":"https://api.github.com/users/betalars/gists{/gist_id}","starred_url":"https://api.github.com/users/betalars/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/betalars/subscriptions","organizations_url":"https://api.github.com/users/betalars/orgs","repos_url":"https://api.github.com/users/betalars/repos","events_url":"https://api.github.com/users/betalars/events{/privacy}","received_events_url":"https://api.github.com/users/betalars/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-04-11T11:54:30Z","updated_at":"2025-04-11T11:54:30Z","body":"I was about to also create a bug report about this. I strongly dislike that change. I actually thought it had something to do with autocomplete getting wrong if you are in insert mode on your keyboard for some reason.\n\nWhen I want to replace a word, I just double-click on it to replace it.\n\nWhen I want to add in front of it, I just put my cursor there.\n\nAlso: i strongly disagree you should mess with the muscle memory of everyone like that.","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2796699357/reactions","total_count":13,"+1":13,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2797420403","html_url":"https://github.com/godotengine/godot/issues/101306#issuecomment-2797420403","issue_url":"https://api.github.com/repos/godotengine/godot/issues/101306","id":2797420403,"node_id":"IC_kwDOAO6SJc6mvT9z","user":{"login":"kitbdev","id":10054226,"node_id":"MDQ6VXNlcjEwMDU0MjI2","avatar_url":"https://avatars.githubusercontent.com/u/10054226?v=4","gravatar_id":"","url":"https://api.github.com/users/kitbdev","html_url":"https://github.com/kitbdev","followers_url":"https://api.github.com/users/kitbdev/followers","following_url":"https://api.github.com/users/kitbdev/following{/other_user}","gists_url":"https://api.github.com/users/kitbdev/gists{/gist_id}","starred_url":"https://api.github.com/users/kitbdev/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/kitbdev/subscriptions","organizations_url":"https://api.github.com/users/kitbdev/orgs","repos_url":"https://api.github.com/users/kitbdev/repos","events_url":"https://api.github.com/users/kitbdev/events{/privacy}","received_events_url":"https://api.github.com/users/kitbdev/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-04-11T16:34:38Z","updated_at":"2025-04-11T16:34:38Z","body":"Maybe we can swap the defaults, so `Enter/Tab` is insert and `Shift+Enter/Shift+Tab` is replace.\nIt seems like the behavior was changed to match VSCode (https://github.com/godotengine/godot/pull/90723), however VSCode actually has different behavior for different languages with its `editor.suggest.insertMode` setting. It seem like insert as default is used for python and it is more common (not that all languages follow the setting).\n\n![Image](https://github.com/user-attachments/assets/a5f8df14-4141-44d7-a066-6e18ca647b84)","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2797420403/reactions","total_count":6,"+1":6,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/