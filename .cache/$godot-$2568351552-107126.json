sts":0,"public_repos":0,"total_private_repos":0,"url":"https://api.github.com/users/a-johnston"},"body":"","html_url":"https://github.com/godotengine/godot/pull/107126#pullrequestreview-4230789041","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/107126","author_association":"CONTRIBUTOR","submitted_at":"2026-05-05T18:51:19Z"},{"id":2899227005,"node_id":"PRR_kwDOAO6SJc6szrF9","state":"COMMENTED","commit_id":"d01f0041fef4a759e49928dca66da080b982499d","user":{"site_admin":false,"suspended":false,"updated_at":"0001-01-01T00:00:00Z","avatar_url":"https://avatars.githubusercontent.com/u/96648715?u=af70f5d107e9c1447f296643d5a566dab53d25e8&v=4","created_at":"0001-01-01T00:00:00Z","followers":0,"following":0,"html_url":"https://github.com/AThousandShips","id":96648715,"node_id":"U_kgDOBcK-Cw","login":"AThousandShips","type":"User","owned_private_repos":0,"public_gists":0,"public_repos":0,"total_private_repos":0,"url":"https://api.github.com/users/AThousandShips"},"body":"","html_url":"https://github.com/godotengine/godot/pull/107126#pullrequestreview-2899227005","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/107126","author_association":"MEMBER","submitted_at":"2026-05-06T08:03:59Z"},{"id":4236780339,"node_id":"PRR_kwDOAO6SJc78iCMz","state":"APPROVED","commit_id":"d01f0041fef4a759e49928dca66da080b982499d","user":{"site_admin":false,"suspended":false,"updated_at":"0001-01-01T00:00:00Z","avatar_url":"https://avatars.githubusercontent.com/u/4884246?v=4","created_at":"0001-01-01T00:00:00Z","followers":0,"following":0,"html_url":"https://github.com/mihe","id":4884246,"node_id":"MDQ6VXNlcjQ4ODQyNDY=","login":"mihe","type":"User","owned_private_repos":0,"public_gists":0,"public_repos":0,"total_private_repos":0,"url":"https://api.github.com/users/mihe"},"body":"I've added a couple of additional minor comments, but overall I'd say this looks good to me.\r\n\r\nI haven't looked too closely at the internal implementation itself, since I assume that's largely settled at this point, but the script API looks straight-forward to me and would seem to line up well with other parts of the engine.\r\n\r\nI guess the unresolved questions for whoever makes the final call would be:\r\n\r\n1. How many \"knobs\" do we actually want to expose here? Is there a risk in exposing too much, if we want to change the algorithm at any point? If not, should we go \"all out\" and expose things like `boundary_chars` as well then? See prior discussion [here](https://github.com/godotengine/godot/pull/107126#discussion_r3183294423).\r\n2. Whether or not we want `FuzzySearchMatch` to be `RefCounted` or just a plain object that then has a special script-only `RefCounted` wrapper.","html_url":"https://github.com/godotengine/godot/pull/107126#pullrequestreview-4236780339","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/107126","author_association":"CONTRIBUTOR","submitted_at":"2026-05-06T14:34:06Z"},{"id":4238636558,"node_id":"PRR_kwDOAO6SJc78pHYO","state":"COMMENTED","commit_id":"d01f0041fef4a759e49928dca66da080b982499d","user":{"site_admin":false,"suspended":false,"updated_at":"0001-01-01T00:00:00Z","avatar_url":"https://avatars.githubusercontent.com/u/9058941?u=611ffa1daf8b8ca59218d29f2bd7ac8b5fdd59e3&v=4","created_at":"0001-01-01T00:00:00Z","followers":0,"following":0,"html_url":"https://github.com/a-johnston","id":9058941,"node_id":"MDQ6VXNlcjkwNTg5NDE=","login":"a-johnston","type":"User","owned_private_repos":0,"public_gists":0,"public_repos":0,"total_private_repos":0,"url":"https://api.github.com/users/a-johnston"},"body":"","html_url":"https://github.com/godotengine/godot/pull/107126#pullrequestreview-4238636558","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/107126","author_association":"CONTRIBUTOR","submitted_at":"2026-05-06T18:47:05Z"},{"id":4243810786,"node_id":"PRR_kwDOAO6SJc7882ni","state":"APPROVED","commit_id":"2eeff1e5aba06cdfba8d2adf55c1e7623575aaea","user":{