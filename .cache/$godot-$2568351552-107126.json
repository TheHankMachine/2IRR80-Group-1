:4311925274,"node_id":"PRR_kwDOAO6SJc8AAAABAQLCGg","state":"COMMENTED","commit_id":"8a8e2fdb4518deb00100cebbeccddfe1ac568197","user":{"site_admin":false,"suspended":false,"updated_at":"0001-01-01T00:00:00Z","avatar_url":"https://avatars.githubusercontent.com/u/66727710?u=8069d9b7bc6ab503ce83dfcfa53fd021672aeccf&v=4","created_at":"0001-01-01T00:00:00Z","followers":0,"following":0,"html_url":"https://github.com/Mickeon","id":66727710,"node_id":"MDQ6VXNlcjY2NzI3NzEw","login":"Mickeon","type":"User","owned_private_repos":0,"public_gists":0,"public_repos":0,"total_private_repos":0,"url":"https://api.github.com/users/Mickeon"},"body":"As of writing I don't have time to go through the docs' content but one thing stood out to me","html_url":"https://github.com/godotengine/godot/pull/107126#pullrequestreview-4311925274","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/107126","author_association":"MEMBER","submitted_at":"2026-05-18T16:25:36Z"}]