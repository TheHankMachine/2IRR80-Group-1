or":"ffee88","default":false,"description":"","archived_at":null,"archived_by":null}],"state":"closed","locked":false,"assignees":[],"milestone":{"url":"https://api.github.com/repos/godotengine/godot/milestones/25","html_url":"https://github.com/godotengine/godot/milestone/25","labels_url":"https://api.github.com/repos/godotengine/godot/milestones/25/labels","id":15520464,"node_id":"MI_kwDOAO6SJc4A7NLQ","number":25,"title":"4.8","description":"","creator":{"login":"Repiteo","id":17489292,"node_id":"MDQ6VXNlcjE3NDg5Mjky","avatar_url":"https://avatars.githubusercontent.com/u/17489292?v=4","gravatar_id":"","url":"https://api.github.com/users/Repiteo","html_url":"https://github.com/Repiteo","followers_url":"https://api.github.com/users/Repiteo/followers","following_url":"https://api.github.com/users/Repiteo/following{/other_user}","gists_url":"https://api.github.com/users/Repiteo/gists{/gist_id}","starred_url":"https://api.github.com/users/Repiteo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Repiteo/subscriptions","organizations_url":"https://api.github.com/users/Repiteo/orgs","repos_url":"https://api.github.com/users/Repiteo/repos","events_url":"https://api.github.com/users/Repiteo/events{/privacy}","received_events_url":"https://api.github.com/users/Repiteo/received_events","type":"User","user_view_type":"public","site_admin":false},"open_issues":341,"closed_issues":2335,"state":"open","created_at":"2026-04-13T15:59:35Z","updated_at":"2026-10-22T03:07:42Z","due_on":null,"closed_at":null},"comments":3,"created_at":"2026-02-07T08:37:05Z","updated_at":"2026-07-24T16:48:05Z","closed_at":"2026-07-21T17:30:12Z","assignee":null,"author_association":"CONTRIBUTOR","issue_field_values":[],"type":null,"active_lock_reason":null,"draft":false,"pull_request":{"url":"https://api.github.com/repos/godotengine/godot/pulls/115998","html_url":"https://github.com/godotengine/godot/pull/115998","diff_url":"https://github.com/godotengine/godot/pull/115998.diff","patch_url":"https://github.com/godotengine/godot/pull/115998.patch","merged_at":"2026-07-21T17:30:12Z"},"body":"- Resolves https://github.com/godotengine/godot/issues/28607\r\n- Resolves https://github.com/godotengine/godot/issues/29094 (tested breakpoints and bookmarks)\r\n- Resolves https://github.com/godotengine/godot-proposals/issues/6999\r\n- Resolves https://github.com/godotengine/godot-proposals/issues/7702\r\n- Resolves https://github.com/godotengine/godot-proposals/issues/10726 (duplicate of 7702?)\r\n- Resolves https://github.com/godotengine/godot-proposals/issues/12688\r\n- Related https://github.com/godotengine/godot/pull/114917\r\n\r\n## Changes\r\n- re-implements `ShaderEditorPlugin` using the `ScriptEditor` class used for the `ScriptEditorPlugin`\r\n- `ShaderEditor` classes inherit from `ScriptEditorBase` classes\r\n- indirectly adds many script editor features to the shader editor (for example: tab history, function folding, drag and drop to open files, menu options, filter scripts, make floating button, popup on closing unsaved changes, ...)\r\n- some shortcuts are changed to only work when a `ScriptEditor` is focused, because of https://github.com/godotengine/godot/issues/117209 these sometimes stop working until an editor is focused again by clicking on it\r\n\r\n### Changes that could be controversial\r\n- `VisualShaderEditor` now has a menu bar at the top reducing space. I did not find a nice way around this. If it stays this way the menu bar could be used for the `toggle_files_panel_button` so it is at the same location for each editor type.\r\n- I created a shared build function for the context and file menus as they have several options in common. This makes sure the order for the same options are the same in the two menus and therefore rearranges some of them.\r\n- I tried to make the `Shader Editor` (file and context) menus more similar to the `Script Editor` menus for more consistency between the editors and the `Shader Editor` menus have a lot more options now.","closed_by":{"login":"Repiteo","id":17489292,"node_id":"MDQ6VXNlcjE3NDg5Mjky","avatar_url":"https://avatars.githubusercontent.com/u/17489292?v=4","gravatar_id":"","url":"https://api.github.com/users/Repiteo","html_url":"https://github.com/Repiteo","followers_url":"https://api.github.com/users/Repiteo/followers","following_url":"https://api.github.com/users/Repiteo/following{/other_user}","gists_url":"https://api.github.com/users/Repiteo/gists{/gist_id}","starred_url":"https://api.github.com/users/Repiteo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Repiteo/subscriptions","organizations_url":"https://api.github.com/users/Repiteo/orgs","repos_url":"https://api.github.com/users/Repiteo/repos","events_url":"https://api.github.com/users/Repiteo/events{/privacy}","received_events_url":"https://api.github.com/users/Repiteo/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/115998/reactions","total_count":29,"+1":20,"-1":0,"laugh":0,"hooray":5,"confused":0,"heart":0,"rocket":0,"eyes":4},"timeline_url":"https://api.github.com/repos/godotengine/godot/issues/115998/timeline","performed_via_github_app":null,"state_reason":null}