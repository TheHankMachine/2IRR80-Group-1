dbee/gists{/gist_id}","starred_url":"https://api.github.com/users/Rindbee/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Rindbee/subscriptions","organizations_url":"https://api.github.com/users/Rindbee/orgs","repos_url":"https://api.github.com/users/Rindbee/repos","events_url":"https://api.github.com/users/Rindbee/events{/privacy}","received_events_url":"https://api.github.com/users/Rindbee/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-02-11T23:59:31Z","updated_at":"2026-02-12T00:05:10Z","body":">     * OS: macOS\n> \n>     * Godot: v4.6.1-rc1\n\nYou can use [Artifacts in Actions](https://github.com/godotengine/godot/actions/runs/21913937006) to test. \n\nYou can consider the Artifacts in the [master](https://github.com/godotengine/godot/actions?query=branch%3Amaster) branch of Actions as Nightly.","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3887882846/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3888222058","html_url":"https://github.com/godotengine/godot/issues/116162#issuecomment-3888222058","issue_url":"https://api.github.com/repos/godotengine/godot/issues/116162","id":3888222058,"node_id":"IC_kwDOAO6SJc7nwY9q","user":{"login":"santiagogustavo","id":7660584,"node_id":"MDQ6VXNlcjc2NjA1ODQ=","avatar_url":"https://avatars.githubusercontent.com/u/7660584?v=4","gravatar_id":"","url":"https://api.github.com/users/santiagogustavo","html_url":"https://github.com/santiagogustavo","followers_url":"https://api.github.com/users/santiagogustavo/followers","following_url":"https://api.github.com/users/santiagogustavo/following{/other_user}","gists_url":"https://api.github.com/users/santiagogustavo/gists{/gist_id}","starred_url":"https://api.github.com/users/santiagogustavo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/santiagogustavo/subscriptions","organizations_url":"https://api.github.com/users/santiagogustavo/orgs","repos_url":"https://api.github.com/users/santiagogustavo/repos","events_url":"https://api.github.com/users/santiagogustavo/events{/privacy}","received_events_url":"https://api.github.com/users/santiagogustavo/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-02-12T01:52:20Z","updated_at":"2026-02-12T01:52:20Z","body":"I came across this issue as well and it was blocking me from updating from 4.5 to 4.6.\nFor what was said in this thread and https://github.com/godotengine/godot/issues/115402, it seems that ViewportTextures are not working well with **instanced scenes**.\n\nJust in case anyone needs, in my use case I had two workarounds (not ideal, but manageable):\n1. If possible, make local everything that references the Viewport (such as meshes, nodes, materials)\n2. In case you need to use an inherited scene, set the texture programatically using: `(material or rect).texture = viewport.get_texture()` ","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3888222058/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3888798266","html_url":"https://github.com/godotengine/godot/issues/116162#issuecomment-3888798266","issue_url":"https://api.github.com/repos/godotengine/godot/issues/116162","id":3888798266,"node_id":"IC_kwDOAO6SJc7nylo6","user":{"login":"aaaryanpatel","id":156986367,"node_id":"U_kgDOCVtr_w","avatar_url":"https://avatars.githubusercontent.com/u/156986367?v=4","gravatar_id":"","url":"https://api.github.com/users/aaaryanpatel","html_url":"https://github.com/aaaryanpatel","followers_url":"https://api.github.com/users/aaaryanpatel/followers","following_url":"https://api.github.com/users/aaaryanpatel/following{/other_user}","gists_url":"https://api.github.com/users/aaaryanpatel/gists{/gist_id}","starred_url":"https://api.github.com/users/aaaryanpatel/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/aaaryanpatel/subscriptions","organizations_url":"https://api.github.com/users/aaaryanpatel/orgs","repos_url":"https://api.github.com/users/aaaryanpatel/repos","events_url":"https://api.github.com/users/aaaryanpatel/events{/privacy}","received_events_url":"https://api.github.com/users/aaaryanpatel/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-02-12T05:43:13Z","updated_at":"2026-02-12T05:43:13Z","body":"Hi, I tested the MRP and can reproduce this on macOS.\n\nStill there is error ERROR: Path to node is invalid: 'Outer'\n\n**Tested versions**\n- macOS (Apple Silicon)\n- Godot **v4.4.1-stable**\n- Godot **v4.6.1-rc1**\n\n**What I tried (workaround #2)**\nI attached a script to `Sprite2D` and set the texture via code:\n\n```gdscript\nextends Sprite2D\n\n@onready var viewport = $\"../SubViewport\"\n\nfunc _ready() -> void:\n\tif viewport:\n\t\ttexture = viewport.get_texture()\n\n","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3888798266/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3906766228","html_url":"https://github.com/godotengine/godot/issues/116162#issuecomment-3906766228","issue_url":"https://api.github.com/repos/godotengine/godot/issues/116162","id":3906766228,"node_id":"IC_kwDOAO6SJc7o3IWU","user":{"login":"gg-yb","id":76439353,"node_id":"MDQ6VXNlcjc2NDM5MzUz","avatar_url":"https://avatars.githubuse