hubusercontent.com/u/11409821?v=4","gravatar_id":"","url":"https://api.github.com/users/soloparatolos","html_url":"https://github.com/soloparatolos","followers_url":"https://api.github.com/users/soloparatolos/followers","following_url":"https://api.github.com/users/soloparatolos/following{/other_user}","gists_url":"https://api.github.com/users/soloparatolos/gists{/gist_id}","starred_url":"https://api.github.com/users/soloparatolos/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/soloparatolos/subscriptions","organizations_url":"https://api.github.com/users/soloparatolos/orgs","repos_url":"https://api.github.com/users/soloparatolos/repos","events_url":"https://api.github.com/users/soloparatolos/events{/privacy}","received_events_url":"https://api.github.com/users/soloparatolos/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-05-29T08:23:32Z","updated_at":"2025-05-29T08:23:32Z","body":"I'm working on a game with a \"relatively\" fast moving CharacterBody3d and was not getting the areas to detect the body entering consistently (with jolt). I'll take a look with this PR and open an issue if the problem persist. Thanks for your work @mihe ","author_association":"NONE","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2918684801/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2918814358","html_url":"https://github.com/godotengine/godot/pull/106693#issuecomment-2918814358","issue_url":"https://api.github.com/repos/godotengine/godot/issues/106693","id":2918814358,"node_id":"IC_kwDOAO6SJc6t-ZKW","user":{"login":"mihe","id":4884246,"node_id":"MDQ6VXNlcjQ4ODQyNDY=","avatar_url":"https://avatars.githubusercontent.com/u/4884246?v=4","gravatar_id":"","url":"https://api.github.com/users/mihe","html_url":"https://github.com/mihe","followers_url":"https://api.github.com/users/mihe/followers","following_url":"https://api.github.com/users/mihe/following{/other_user}","gists_url":"https://api.github.com/users/mihe/gists{/gist_id}","starred_url":"https://api.github.com/users/mihe/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/mihe/subscriptions","organizations_url":"https://api.github.com/users/mihe/orgs","repos_url":"https://api.github.com/users/mihe/repos","events_url":"https://api.github.com/users/mihe/events{/privacy}","received_events_url":"https://api.github.com/users/mihe/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-05-29T09:19:10Z","updated_at":"2025-05-29T12:40:57Z","body":"> I'm working on a game with a \"relatively\" fast moving CharacterBody3d and was not getting the areas to detect the body entering consistently (with jolt).\r\n\r\n@soloparatolos It shouldn't have anything to do with this PR.\r\n\r\nNeither areas nor CharacterBody3D, in both Jolt and Godot Physics, have support for any sort of continuous collision detection, so if the steps of your CharacterBody3D are greater than the size of the area then you may very well step past it without it detecting any overlaps.\r\n\r\nI believe the only real way to fix that is to increase `physics/common/physics_ticks_per_second` so that you take smaller steps and check for area overlaps more often.\r\n\r\nBut if there's some discrepancy between Jolt and Godot Physics then please do make an issue for it.","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2918814358/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2919594136","html_url":"https://github.com/godotengine/godot/pull/106693#issuecomment-2919594136","issue_url":"https://api.github.com/repos/godotengine/godot/issues/106693","id":2919594136,"node_id":"IC_kwDOAO6SJc6uBXiY","user":{"login":"soloparatolos","id":11409821,"node_id":"MDQ6VXNlcjExNDA5ODIx","avatar_url":"https://avatars.githubusercontent.com/u/11409821?v=4","gravatar_id":"","url":"https://api.github.com/users/soloparatolos","html_url":"https://github.com/soloparatolos","followers_url":"https://api.github.com/users/soloparatolos/followers","following_url":"https://api.github.com/users/soloparatolos/following{/other_user}","gists_url":"https://api.github.com/users/soloparatolos/gists{/gist_id}","starred_url":"https://api.github.com/users/soloparatolos/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/soloparatolos/subscriptions","organizations_url":"https://api.github.com/users/soloparatolos/orgs","repos_url":"https://api.github.com/users/soloparatolos/repos","events_url":"https://api.github.com/users/soloparatolos/events{/privacy}","received_events_url":"https://api.github.com/users/soloparatolos/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-05-29T14:32:21Z","updated_at":"2025-05-29T14:32:21Z","body":"My attempt was brief; just changed to jolt and tested the project. I'll test it properly and open an issue if needed, this is probably just a matter of default values. Thanks for the clarifications!","author_association":"NONE","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2919594136/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2956790804","html_url":"https://github.com/godotengine/godot/pull/106693#issuecomment-2956790804","issue_url":"https://api.github.com/repos/godotengine/godot/issues/106693","id":2956790804,"node_id":"IC_kwDOAO6SJc6wPQwU","user":{"lo