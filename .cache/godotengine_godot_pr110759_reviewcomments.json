ion->is_selected(n)) {\n-\t\t\t\t// Needs to be deferred to account for possible root visibility change.\n-\t\t\t\tcallable_mp(tree, &Tree::scroll_to_item).call_deferred(p_parent, false);\n+\t\t\tif (n && editor_selection->is_selected(n)) {\n+\t\t\t\tif (p_scroll_to_selected) {\n+\t\t\t\t\t// Needs to be deferred to account for possible root visibility change.\n+\t\t\t\t\tcallable_mp(tree, &Tree::scroll_to_item).call_deferred(p_parent, false);\n+\t\t\t\t} else {\n+\t\t\t\t\tr_last_selected = p_parent;","path":"editor/scene/scene_tree_editor.cpp","commit_id":"357caceca6a8e4dbdb54606f0630a25632003969","original_commit_id":"a64397d566f92c0fa10a551ddae25736bd0f8d21","user":{"login":"precup","id":709680,"node_id":"MDQ6VXNlcjcwOTY4MA==","avatar_url":"https://avatars.githubusercontent.com/u/709680?v=4","gravatar_id":"","url":"https://api.github.com/users/precup","html_url":"https://github.com/precup","followers_url":"https://api.github.com/users/precup/followers","following_url":"https://api.github.com/users/precup/following{/other_user}","gists_url":"https://api.github.com/users/precup/gists{/gist_id}","starred_url":"https://api.github.com/users/precup/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/precup/subscriptions","organizations_url":"https://api.github.com/users/precup/orgs","repos_url":"https://api.github.com/users/precup/repos","events_url":"https://api.github.com/users/precup/events{/privacy}","received_events_url":"https://api.github.com/users/precup/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"The change on line 1041 (`p_scroll_to_selected` -> `p_scroll_to_selected && !keep_for_children`) means that it's possible for a deeply nested call to have `p_scroll_to_selected` be `false` even if it's `true` at the top level.","created_at":"2025-10-02T20:25:20Z","updated_at":"2025-10-02T20:25:20Z","html_url":"https://github.com/godotengine/godot/pull/110759#discussion_r2399981140","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/110759","_links":{"self":{"href":"https://api.github.com/repos/godotengine/godot/pulls/comments/2399981140"},"html":{"href":"https://github.com/godotengine/godot/pull/110759#discussion_r2399981140"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/110759"}},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/2399981140/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":1119,"original_line":1119,"side":"RIGHT","in_reply_to_id":2399909713,"author_association":"CONTRIBUTOR","original_position":40,"position":40,"subject_type":"line"},{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/2625983871","pull_request_review_id":3586457296,"id":2625983871,"node_id":"PRRC_kwDOAO6SJc6chVV_","diff_hunk":"@@ -1099,9 +1111,13 @@ bool SceneTreeEditor::_update_filter(TreeItem *p_parent, bool p_scroll_to_select\n \tif (editor_selection) {\n \t\tNode *n = get_node(p_parent->get_metadata(0));\n \t\tif (selectable) {\n-\t\t\tif (p_scroll_to_selected && n && editor_selection->is_selected(n)) {\n-\t\t\t\t// Needs to be deferred to account for possible root visibility change.\n-\t\t\t\tcallable_mp(tree, &Tree::scroll_to_item).call_deferred(p_parent, false);\n+\t\t\tif (n && editor_selection->is_selected(n)) {\n+\t\t\t\tif (p_scroll_to_selected) {\n+\t\t\t\t\t// Needs to be deferred to account for possible root visibility change.\n+\t\t\t\t\tcallable_mp(tree, &Tree::scroll_to_item).call_deferred(p_parent, false);","path":"editor/scene/scene_tree_editor.cpp","commit_id":"357caceca6a8e4dbdb54606f0630a25632003969","original_commit_id":"357caceca6a8e4dbdb54606f0630a25632003969","user":{"login":"KoBeWi","id":2223172,"node_id":"MDQ6VXNlcjIyMjMxNzI=","avatar_url":"https://avatars.githubusercontent.com/u/2223172?v=4","gravatar_id":"","url":"https://api.github.com/users/KoBeWi","html_url":"https://github.com/KoBeWi","followers_url":"https://api.github.com/users/KoBeWi/followers","following_url":"https://api.github.com/users/KoBeWi/following{/other_user}","gists_url":"https://api.github.com/users/KoBeWi/gists{/gist_id}","starred_url":"https://api.github.com/users/KoBeWi/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/KoBeWi/subscriptions","organizations_url":"https://api.github.com/users/KoBeWi/orgs","repos_url":"https://api.github.com/users/KoBeWi/repos","events_url":"https://api.github.com/users/KoBeWi/events{/privacy}","received_events_url":"https://api.github.com/users/KoBeWi/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"Looks like this (or the one above) is called for every selected item, so the Tree will needlessly scroll to each item, eventually settling on the last one. This can be queued with something like\n```C++\nvoid _queue_scroll_to_item(TreeItem *p_item) {\n\tif (!queued_item) {\n\t\tcallable_mp(this, &SceneTreeEditor::_scroll_to_item).call_deferred();\n\t}\n\tqueued_item = p_item;\n}\n\nvoid _scroll_to_item() {\n\ttree->scroll_to_item(queued_item );\n\tqueued_item  = nullptr;\n}\n```","created_at":"2025-12-17T07:57:37Z","updated_at":"2025-12-17T07:57:37Z","html_url":"https://github.com/godotengine/godot/pull/110759#discussion_r2625983871","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/110759","_links":{"self":{"href":"https://api.github.com/repos/godotengine/godot/pulls/comments/2625983871"},"html":{"href":"https://github.com/godotengine/godot/pull/110759#discussion_r2625983871"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/110759"}},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/2625983871/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":1117,"original_line":1117,"side":"RIGHT","author_association":"MEMBER","original_position":38,"position":38,"subject_type":"line"},{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/2629444173","pull_request_review_id":3590635689,"id":2629444173,"node_id":"PRRC_kwDOAO6SJc6cuiJN","diff_hunk":"@@ -1099,9 +1111,13 @@ bool SceneTreeEditor::_update_filter(TreeItem *p_parent, bool p_scroll_to_select\n \tif (editor_selection) {\n \t\tNode *n = get_node(p_parent->get_metadata(0));\n \t\tif (selectable) {\n-\t\t\tif (p_scroll_to_selected && n && editor_selection->is_selected(n)) {\n-\t\t\t\t// Needs to be deferred to account for possible root visibility change.\n-\t\t\t\tcallable_mp(tree, &Tree::scroll_to_item).call_deferred(p_parent, false);\n+\t\t\tif (n && editor_selection->is_selected(n)) {\n+\t\t\t\tif (p_scroll_to_selected) {\n+\t\t\t\t\t// Needs to be deferred to account for possible root visibility change.\n+\t\t\t\t\tcallable_mp(tree, &Tree::scroll_to_item).call_deferred(p_parent, false);","path":"editor/scene/scene_tree_editor.cpp","commit_id":"357caceca6a8e4dbdb54606f0630a25632003969","original_commit_id":"357caceca6a8e4dbdb54606f0630a25632003969","user":{"login":"precup","id":709680,"node_id":"MDQ6VXNlcjcwOTY4MA==","avatar_url":"https://avatars.githubusercontent.com/u/709680?v=4","gravatar_id":"","url":"https://api.github.com/users/precup","html_url":"https://github.com/precup","followers_url":"https://api.github.com/users/precup/followers","following_url":"https://api.github.com/users/precup/following{/other_user}","gists_url":"https://api.github.com/users/precup/gists{/gist_id}","starred_url":"https://api.github.com/users/precup/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/precup/subscriptions","organizations_url":"https://api.github.com/users/precup/orgs","repos_url":"https://api.github.com/users/precup/repos","events_url":"https://api.github.com/users/precup/events{/privacy}","received_events_url":"https://api.github.com/users/precup/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"It used to be called every time, but this PR actually prevents that via the condition update on line 1041. `p_scroll_to_selected` will only be true the first time a child is found, and will be false subsequently, so it actually only scrolls to the first element it finds. That's the main performance boost this PR provides, actually.\r\n\r\nCalling it a single time on the last item only isn't ideal. Really, you want to call it on the first element once, and then the last element once, because doing so will frame as many of the elements as possible. If you do it only to the first or last element, it might not scroll to show as many of the selected elements. In order to preserve that behavior, I used this somewhat complicated boolean passing instead of a solution like the one you proposed.\r\n\r\nI could accomplish the same result as what I'm doing now via a similar method, though, if you'd prefer.","created_at":"2025-12-18T03:53:21Z","updated_at":"2025-12-18T03:53:21Z","html_url":"https://github.com/godotengine/godot/pull/110759#discussion_r2629444173","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/110759","_links":{"self":{"href":"https://api.github.com/repos/godotengine/godot/pulls/comments/2629444173"},"html":{"href":"https://github.com/godotengine/godot/pull/110759#discussion_r2629444173"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/110759"}},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/2629444173/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":1117,"original_line":1117,"side":"RIGHT","in_reply_to_id":2625983871,"author_association":"CONTRIBUTOR","original_position":38,"position":38,"subject_type":"line"}]