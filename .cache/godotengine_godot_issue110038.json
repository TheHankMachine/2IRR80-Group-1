archived_by":null},{"id":283518733,"node_id":"MDU6TGFiZWwyODM1MTg3MzM=","url":"https://api.github.com/repos/godotengine/godot/labels/usability","name":"usability","color":"447744","default":false,"description":"","archived_at":null,"archived_by":null},{"id":1332303119,"node_id":"MDU6TGFiZWwxMzMyMzAzMTE5","url":"https://api.github.com/repos/godotengine/godot/labels/regression","name":"regression","color":"ff63ac","default":false,"description":"","archived_at":null,"archived_by":null},{"id":1609442062,"node_id":"MDU6TGFiZWwxNjA5NDQyMDYy","url":"https://api.github.com/repos/godotengine/godot/labels/topic:shaders","name":"topic:shaders","color":"ffee88","default":false,"description":"","archived_at":null,"archived_by":null}],"state":"closed","locked":false,"assignees":[],"milestone":{"url":"https://api.github.com/repos/godotengine/godot/milestones/23","html_url":"https://github.com/godotengine/godot/milestone/23","labels_url":"https://api.github.com/repos/godotengine/godot/milestones/23/labels","id":12939969,"node_id":"MI_kwDOAO6SJc4AxXLB","number":23,"title":"4.6","description":"","creator":{"login":"Repiteo","id":17489292,"node_id":"MDQ6VXNlcjE3NDg5Mjky","avatar_url":"https://avatars.githubusercontent.com/u/17489292?v=4","gravatar_id":"","url":"https://api.github.com/users/Repiteo","html_url":"https://github.com/Repiteo","followers_url":"https://api.github.com/users/Repiteo/followers","following_url":"https://api.github.com/users/Repiteo/following{/other_user}","gists_url":"https://api.github.com/users/Repiteo/gists{/gist_id}","starred_url":"https://api.github.com/users/Repiteo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Repiteo/subscriptions","organizations_url":"https://api.github.com/users/Repiteo/orgs","repos_url":"https://api.github.com/users/Repiteo/repos","events_url":"https://api.github.com/users/Repiteo/events{/privacy}","received_events_url":"https://api.github.com/users/Repiteo/received_events","type":"User","user_view_type":"public","site_admin":false},"open_issues":3,"closed_issues":2978,"state":"closed","created_at":"2025-05-22T16:25:52Z","updated_at":"2026-10-04T16:23:23Z","due_on":null,"closed_at":"2026-01-26T18:09:14Z"},"comments":1,"created_at":"2025-08-27T22:28:53Z","updated_at":"2025-09-24T15:04:38Z","closed_at":"2025-09-24T15:04:36Z","assignee":null,"author_association":"MEMBER","issue_field_values":[],"type":null,"active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"### Tested versions\n\n- Reproducible in: 4.5.beta6, 4.5.beta 4ebf67c12\n- Not reproducible in: 4.4.1.stable\n\n### System information\n\nGodot v4.5.beta (4ebf67c12) - Windows 11 (build 26100) - Multi-window, 1 monitor - Vulkan (Forward+) - dedicated NVIDIA GeForce RTX 5090 (NVIDIA; 32.0.15.7688) - AMD Ryzen 9 9950X3D 16-Core Processor (32 threads) - 63.55 GiB memory\n\n### Issue description\n\nWhen you create a new shader using the shader creation dialog in the **New Shader** resource dropdown, the file name will be set to an invalid UID-based filename:\n\n<img width=\"392\" height=\"437\" alt=\"image\" src=\"https://github.com/user-attachments/assets/57b60b37-904e-4e0f-817c-aacb38411420\" />\n\nThis file name is illegal on Windows due to `:`, so the shader can't be created:\n\n<img width=\"358\" height=\"161\" alt=\"image\" src=\"https://github.com/user-attachments/assets/016c5486-361c-4de4-9f82-284e3fb778d6\" />\n\nThis only occurs if you're creating the shader in a scene that hasn't been saved yet. If the scene has been saved, then the shader will be given a valid `res://` path by default.\n\nIn 4.4.1.stable, an empty `res://` path was provided instead, which is still invalid, but at least it was consistently invalid on all platforms (and not looking random):\n\n<img width=\"382\" height=\"367\" alt=\"Image\" src=\"https://github.com/user-attachments/assets/05b60e1b-3b1e-48b9-b00a-420320a3d571\" />\n\n### Steps to reproduce\n\n- Create a Node3D and a MeshInstance3D child. Add a new BoxMesh to the MeshInstance3D child. *Do not save the scene at this point.*\n- Add a new ShaderMaterial to the BoxMesh resource, then a new Shader in the ShaderMaterial resource.\n- In the dialog that appears, notice how the file name starts with `::` and looks like an UID.\n\n### Minimal reproduction project (MRP)\n\nN/A","closed_by":{"login":"Repiteo","id":17489292,"node_id":"MDQ6VXNlcjE3NDg5Mjky","avatar_url":"https://avatars.githubusercontent.com/u/17489292?v=4","gravatar_id":"","url":"https://api.github.com/users/Repiteo","html_url":"https://github.com/Repiteo","followers_url":"https://api.github.com/users/Repiteo/followers","following_url":"https://api.github.com/users/Repiteo/following{/other_user}","gists_url":"https://api.github.com/users/Repiteo/gists{/gist_id}","starred_url":"https://api.github.com/users/Repiteo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Repiteo/subscriptions","organizations_url":"https://api.github.com/users/Repiteo/orgs","repos_url":"https://api.github.com/users/Repiteo/repos","events_url":"https://api.github.com/users/Repiteo/events{/privacy}","received_events_url":"https://api.github.com/users/Repiteo/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/110038/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/godotengine/godot/issues/110038/timeline","performed_via_github_app":null,"state_reason":"completed","pinned_comment":null}