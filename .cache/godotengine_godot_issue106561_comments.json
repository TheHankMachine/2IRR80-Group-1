1.0), O: (0.0, 0.0)]\n```\n\n![Image](https://github.com/user-attachments/assets/2af08c1e-42fb-4a30-9660-9deaea662bc9)\n\n[shader-mat-default-value (2).zip](https://github.com/user-attachments/files/20282077/shader-mat-default-value.2.zip)\n","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2890463091/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2890792580","html_url":"https://github.com/godotengine/godot/issues/106561#issuecomment-2890792580","issue_url":"https://api.github.com/repos/godotengine/godot/issues/106561","id":2890792580,"node_id":"IC_kwDOAO6SJc6sTf6E","user":{"login":"beicause","id":75941842,"node_id":"MDQ6VXNlcjc1OTQxODQy","avatar_url":"https://avatars.githubusercontent.com/u/75941842?v=4","gravatar_id":"","url":"https://api.github.com/users/beicause","html_url":"https://github.com/beicause","followers_url":"https://api.github.com/users/beicause/followers","following_url":"https://api.github.com/users/beicause/following{/other_user}","gists_url":"https://api.github.com/users/beicause/gists{/gist_id}","starred_url":"https://api.github.com/users/beicause/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/beicause/subscriptions","organizations_url":"https://api.github.com/users/beicause/orgs","repos_url":"https://api.github.com/users/beicause/repos","events_url":"https://api.github.com/users/beicause/events{/privacy}","received_events_url":"https://api.github.com/users/beicause/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-05-19T12:15:37Z","updated_at":"2025-05-20T01:00:49Z","body":"I've thought several solutions:\n1. Set shader parameters to their default values (identity matrix) in `Material::set_shader` only in the editor.\n2. Change `_fill_std140_ubo_empty` to fill the matrix with an identity matrix instead of zero.\n3. Change `MaterialStorage::shader_get_parameter_default` to return a zero matrix instead of identity.\n\nI think the first solution is better. The other two would change the existing behavior in games and it's not worthwhile.","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2890792580/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null}]