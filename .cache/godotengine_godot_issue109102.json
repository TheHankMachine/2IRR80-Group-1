at":null,"archived_by":null},{"id":2666708289,"node_id":"MDU6TGFiZWwyNjY2NzA4Mjg5","url":"https://api.github.com/repos/godotengine/godot/labels/topic:3d","name":"topic:3d","color":"ffee88","default":false,"description":"","archived_at":null,"archived_by":null}],"state":"closed","locked":false,"assignees":[],"milestone":{"url":"https://api.github.com/repos/godotengine/godot/milestones/22","html_url":"https://github.com/godotengine/godot/milestone/22","labels_url":"https://api.github.com/repos/godotengine/godot/milestones/22/labels","id":12070367,"node_id":"MI_kwDOAO6SJc4AuC3f","number":22,"title":"4.5","description":"","creator":{"login":"Sauermann","id":6299227,"node_id":"MDQ6VXNlcjYyOTkyMjc=","avatar_url":"https://avatars.githubusercontent.com/u/6299227?v=4","gravatar_id":"","url":"https://api.github.com/users/Sauermann","html_url":"https://github.com/Sauermann","followers_url":"https://api.github.com/users/Sauermann/followers","following_url":"https://api.github.com/users/Sauermann/following{/other_user}","gists_url":"https://api.github.com/users/Sauermann/gists{/gist_id}","starred_url":"https://api.github.com/users/Sauermann/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Sauermann/subscriptions","organizations_url":"https://api.github.com/users/Sauermann/orgs","repos_url":"https://api.github.com/users/Sauermann/repos","events_url":"https://api.github.com/users/Sauermann/events{/privacy}","received_events_url":"https://api.github.com/users/Sauermann/received_events","type":"User","user_view_type":"public","site_admin":false},"open_issues":3,"closed_issues":3687,"state":"closed","created_at":"2024-12-19T08:51:28Z","updated_at":"2026-09-04T21:48:38Z","due_on":"2025-09-15T00:00:00Z","closed_at":"2025-09-18T17:13:14Z"},"comments":1,"created_at":"2025-07-29T23:54:35Z","updated_at":"2025-12-29T02:18:18Z","closed_at":"2025-08-24T16:08:28Z","assignee":null,"author_association":"MEMBER","issue_field_values":[],"type":null,"active_lock_reason":null,"draft":false,"pull_request":{"url":"https://api.github.com/repos/godotengine/godot/pulls/109102","html_url":"https://github.com/godotengine/godot/pull/109102","diff_url":"https://github.com/godotengine/godot/pull/109102.diff","patch_url":"https://github.com/godotengine/godot/pull/109102.patch","merged_at":"2025-08-24T16:08:28Z"},"body":"While working on refactoring this code, I figured I should make a separate PR for some immediate fixes. These should be cherry-picked to past branches.\r\n\r\n* Import: Change the normalized signed byte and signed short formulas to match the glTF specification which explicitly provides formulas that implementations must use.\r\n  * Impact: Almost none, files using normalized signed values are extremely rare as far as I know. But in any case, the old behavior would import with incorrect values.\r\n* Import: Fix incorrect pad skip bytes for 16-bit MAT3s while decoding. I fixed the encoding part in PR #108302 but for some reason I forgot to fix the decoding part at the same time.\r\n  * Impact: Practically none, the core glTF specification doesn't even use MAT3. But in any case, the old behavior would fail to import files if an extension contained such data.\r\n* Import: Add a comment about unpacking weights as floats being intentional even though glTF specifies VEC4.\r\n  * Impact: None, it's a comment.\r\n* Export: Fix indices incorrectly using 16-bit unsigned short when 65535, which is explicitly reserved by the glTF specification as a primitive restart value, so we must use 32-bit unsigned int instead in these cases.\r\n  * Impact: Rare, it's highly unlikely that an array of indices goes up to exactly 65535... but it's possible.\r\n* Export: Fix [`Mesh::ARRAY_WEIGHTS`](https://docs.godotengine.org/en/stable/classes/class_mesh.html#enum-mesh-arraytype) being implicitly casted to `Array` when Godot's Mesh uses a PackedFloat32Array or PackedFloat64Array internally and we're reading floats from it, now it uses `PackedRealArray` (aka `Vector<real_t>`).\r\n  * Impact: No behavior difference, it's just faster performance. Variant can convert between PackedFloat32Array and PackedFloat64Array automatically just like it can convert between those two and Array, so now it performs either 0 or 1 conversions instead of always performing 1 conversion.","closed_by":{"login":"Repiteo","id":17489292,"node_id":"MDQ6VXNlcjE3NDg5Mjky","avatar_url":"https://avatars.githubusercontent.com/u/17489292?v=4","gravatar_id":"","url":"https://api.github.com/users/Repiteo","html_url":"https://github.com/Repiteo","followers_url":"https://api.github.com/users/Repiteo/followers","following_url":"https://api.github.com/users/Repiteo/following{/other_user}","gists_url":"https://api.github.com/users/Repiteo/gists{/gist_id}","starred_url":"https://api.github.com/users/Repiteo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Repiteo/subscriptions","organizations_url":"https://api.github.com/users/Repiteo/orgs","repos_url":"https://api.github.com/users/Repiteo/repos","events_url":"https://api.github.com/users/Repiteo/events{/privacy}","received_events_url":"https://api.github.com/users/Repiteo/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/109102/reactions","total_count":3,"+1":3,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/godotengine/godot/issues/109102/timeline","performed_via_github_app":null,"state_reason":null}