0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4446707638","html_url":"https://github.com/godotengine/godot/issues/110579#issuecomment-4446707638","issue_url":"https://api.github.com/repos/godotengine/godot/issues/110579","id":4446707638,"node_id":"IC_kwDOAO6SJc8AAAABCQtftg","user":{"login":"jordwest","id":416133,"node_id":"MDQ6VXNlcjQxNjEzMw==","avatar_url":"https://avatars.githubusercontent.com/u/416133?v=4","gravatar_id":"","url":"https://api.github.com/users/jordwest","html_url":"https://github.com/jordwest","followers_url":"https://api.github.com/users/jordwest/followers","following_url":"https://api.github.com/users/jordwest/following{/other_user}","gists_url":"https://api.github.com/users/jordwest/gists{/gist_id}","starred_url":"https://api.github.com/users/jordwest/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/jordwest/subscriptions","organizations_url":"https://api.github.com/users/jordwest/orgs","repos_url":"https://api.github.com/users/jordwest/repos","events_url":"https://api.github.com/users/jordwest/events{/privacy}","received_events_url":"https://api.github.com/users/jordwest/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-05-14T01:53:00Z","updated_at":"2026-05-14T02:08:47Z","body":"Seeing the same here (Godot 4.6.2 on a hi-dpi Mac) when using the low-dpi external monitor.\n\nIt seems like in both editor and in game, Godot renders at double resolution when there's at least one hi-dpi screen (even if the window is being displayed on the low-dpi screen), then the pixels get quantized on the low-dpi screen.\n\n**Workaround: Close the laptop screen and restart Godot. Once Godot is running, you can reopen the laptop screen.**\n\nWhen the builtin monitor is closed, Godot seems to detect no hidpi screens and renders at normal resolution, the problem goes away. ","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4446707638/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/6153697007","html_url":"https://github.com/godotengine/godot/issues/110579#issuecomment-6153697007","issue_url":"https://api.github.com/repos/godotengine/godot/issues/110579","id":6153697007,"node_id":"IC_kwDOAO6SJc8AAAABbsn27w","user":{"login":"stuartcarnie","id":52852,"node_id":"MDQ6VXNlcjUyODUy","avatar_url":"https://avatars.githubusercontent.com/u/52852?v=4","gravatar_id":"","url":"https://api.github.com/users/stuartcarnie","html_url":"https://github.com/stuartcarnie","followers_url":"https://api.github.com/users/stuartcarnie/followers","following_url":"https://api.github.com/users/stuartcarnie/following{/other_user}","gists_url":"https://api.github.com/users/stuartcarnie/gists{/gist_id}","starred_url":"https://api.github.com/users/stuartcarnie/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/stuartcarnie/subscriptions","organizations_url":"https://api.github.com/users/stuartcarnie/orgs","repos_url":"https://api.github.com/users/stuartcarnie/repos","events_url":"https://api.github.com/users/stuartcarnie/events{/privacy}","received_events_url":"https://api.github.com/users/stuartcarnie/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-10-13T19:40:35Z","updated_at":"2026-10-13T19:40:35Z","body":"> It seems like in both editor and in game, Godot renders at double resolution when there's at least one hi-dpi screen (even if the window is being displayed on the low-dpi screen), then the pixels get quantized on the low-dpi screen.\n>     **Workaround: Close the laptop screen and restart Godot. Once Godot is running, you can reopen the laptop screen.**\n\nYes, this tracks; Godot's screen detection logic looks for the maximum DPI and uses that everywhere. Will require some investigation to see how we can handle this properly with the existing APIs.","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/6153697007/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/6157215850","html_url":"https://github.com/godotengine/godot/issues/110579#issuecomment-6157215850","issue_url":"https://api.github.com/repos/godotengine/godot/issues/110579","id":6157215850,"node_id":"IC_kwDOAO6SJc8AAAABbv-oag","user":{"login":"Calinou","id":180032,"node_id":"MDQ6VXNlcjE4MDAzMg==","avatar_url":"https://avatars.githubusercontent.com/u/180032?v=4","gravatar_id":"","url":"https://api.github.com/users/Calinou","html_url":"https://github.com/Calinou","followers_url":"https://api.github.com/users/Calinou/followers","following_url":"https://api.github.com/users/Calinou/following{/other_user}","gists_url":"https://api.github.com/users/Calinou/gists{/gist_id}","starred_url":"https://api.github.com/users/Calinou/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Calinou/subscriptions","organizations_url":"https://api.github.com/users/Calinou/orgs","repos_url":"https://api.github.com/users/Calinou/repos","events_url":"https://api.github.com/users/Calinou/events{/privacy}","received_events_url":"https://api.github.com/users/Calinou/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-10-13T23:16:05Z","updated_at":"2026-10-13T23:16:05Z","body":"We could work around this issue by using bilinear filtering when the viewport resolution is greater than the window size, but it would still render at a higher resolution than needed (which is much slower).\n\nFully resolving this might require https://github.com/godotengine/godot/pull/86022.","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/6157215850/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/6157460046","html_url":"https://github.com/godotengine/godot/issues/110579#issuecomment-6157460046","issue_url":"https://api.github.com/repos/godotengine/godot/issues/110579","id":6157460046,"node_id":"IC_kwDOAO6SJc8AAAABbwNiTg","user":{"login":"stuartcarnie","id":52852,"node_id":"MDQ6VXNlcjUyODUy","avatar_url":"https://avatars.githubusercontent.com/u/52852?v=4","gravatar_id":"","url":"https://api.github.com/users/stuartcarnie","html_url":"https://github.com/stuartcarnie","followers_url":"https://api.github.com/users/stuartcarnie/followers","following_url":"https://api.github.com/users/stuartcarnie/following{/other_user}","gists_url":"https://api.github.com/users/stuartcarnie/gists{/gist_id}","starred_url":"https://api.github.com/users/stuartcarnie/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/stuartcarnie/subscriptions","organizations_url":"https://api.github.com/users/stuartcarnie/orgs","repos_url":"https://api.github.com/users/stuartcarnie/repos","events_url":"https://api.github.com/users/stuartcarnie/events{/privacy}","received_events_url":"https://api.github.com/users/stuartcarnie/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-10-13T23:35:19Z","updated_at":"2026-10-13T23:35:19Z","body":"@Calinou I think you're right. Each Viewport needs to be DPI aware, which is based on the window and screen.","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/