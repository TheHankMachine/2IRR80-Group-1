[{"id":3390344810,"node_id":"PRR_kwDOAO6SJc7KFI5q","user":{"login":"Calinou","id":180032,"node_id":"MDQ6VXNlcjE4MDAzMg==","avatar_url":"https://avatars.githubusercontent.com/u/180032?u=68d23e7ee9cdf810da125e8510b72f845b9dccc8&v=4","gravatar_id":"","url":"https://api.github.com/users/Calinou","html_url":"https://github.com/Calinou","followers_url":"https://api.github.com/users/Calinou/followers","following_url":"https://api.github.com/users/Calinou/following{/other_user}","gists_url":"https://api.github.com/users/Calinou/gists{/gist_id}","starred_url":"https://api.github.com/users/Calinou/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Calinou/subscriptions","organizations_url":"https://api.github.com/users/Calinou/orgs","repos_url":"https://api.github.com/users/Calinou/repos","events_url":"https://api.github.com/users/Calinou/events{/privacy}","received_events_url":"https://api.github.com/users/Calinou/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"Tested locally, it works as expected. I think this is a good usability improvement, not only when editing code, but also when switching between scripts.\r\n\r\nThat said, in complex projects, the majority of GDScript files are expected to be in the 100-999 line range. Therefore, I don't think we need to expose an editor setting for this. A lower value would save a tiny bit of horizontal space in projects that use lots of small scripts, but you'd reintroduce the issue with layout shifts on script change as soon as you even have one script with 100+ lines of code.","state":"COMMENTED","html_url":"https://github.com/godotengine/godot/pull/112115#pullrequestreview-3390344810","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/112115","author_association":"MEMBER","_links":{"html":{"href":"https://github.com/godotengine/godot/pull/112115#pullrequestreview-3390344810"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/112115"}},"submitted_at":"2025-10-28T18:50:18Z","commit_id":null},{"id":3392279935,"node_id":"PRR_kwDOAO6SJc7KMhV_","user":{"login":"Mickeon","id":66727710,"node_id":"MDQ6VXNlcjY2NzI3NzEw","avatar_url":"https://avatars.githubusercontent.com/u/66727710?u=8069d9b7bc6ab503ce83dfcfa53fd021672aeccf&v=4","gravatar_id":"","url":"https://api.github.com/users/Mickeon","html_url":"https://github.com/Mickeon","followers_url":"https://api.github.com/users/Mickeon/followers","following_url":"https://api.github.com/users/Mickeon/following{/other_user}","gists_url":"https://api.github.com/users/Mickeon/gists{/gist_id}","starred_url":"https://api.github.com/users/Mickeon/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Mickeon/subscriptions","organizations_url":"https://api.github.com/users/Mickeon/orgs","repos_url":"https://api.github.com/users/Mickeon/repos","events_url":"https://api.github.com/users/Mickeon/events{/privacy}","received_events_url":"https://api.github.com/users/Mickeon/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"I am neutral on the actual property itself. I think it makes sense, but I've never seen it being suggested until now. I approve for the editor's usability.","state":"APPROVED","html_url":"https://github.com/godotengine/godot/pull/112115#pullrequestreview-3392279935","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/112115","author_association":"MEMBER","_links":{"html":{"href":"https://github.com/godotengine/godot/pull/112115#pullrequestreview-3392279935"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/112115"}},"submitted_at":"2025-10-29T09:01:03Z","commit_id":null}]