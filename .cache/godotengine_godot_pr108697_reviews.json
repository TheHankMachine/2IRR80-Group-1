thub.com/repos/godotengine/godot/pulls/108697"}},"submitted_at":"2025-07-22T14:03:49Z","commit_id":null},{"id":3048836560,"node_id":"PRR_kwDOAO6SJc61uY3Q","user":{"login":"Ivorforce","id":2308167,"node_id":"MDQ6VXNlcjIzMDgxNjc=","avatar_url":"https://avatars.githubusercontent.com/u/2308167?u=f7f8e0273f784f5ec6f6b7fe4a88d449896eb48a&v=4","gravatar_id":"","url":"https://api.github.com/users/Ivorforce","html_url":"https://github.com/Ivorforce","followers_url":"https://api.github.com/users/Ivorforce/followers","following_url":"https://api.github.com/users/Ivorforce/following{/other_user}","gists_url":"https://api.github.com/users/Ivorforce/gists{/gist_id}","starred_url":"https://api.github.com/users/Ivorforce/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Ivorforce/subscriptions","organizations_url":"https://api.github.com/users/Ivorforce/orgs","repos_url":"https://api.github.com/users/Ivorforce/repos","events_url":"https://api.github.com/users/Ivorforce/events{/privacy}","received_events_url":"https://api.github.com/users/Ivorforce/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"Isn't this whole situation something that can be foreseen from a specific combination of settings? Perhaps we can just predict when too many pump tasks will be needed for too little threads, and compensate by printing an error like \"Too many dedicated threads were set up in the project settings for the amount of available dedicated threads. Please adjust the settings accordingly. Compensating by spawning as many threads as necessary for the given dedicated thread settings.\"\nIf properly predicted, we also wouldn't have to reserve / resize `threads` at all.","state":"COMMENTED","html_url":"https://github.com/godotengine/godot/pull/108697#pullrequestreview-3048836560","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/108697","author_association":"MEMBER","_links":{"html":{"href":"https://github.com/godotengine/godot/pull/108697#pullrequestreview-3048836560"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/108697"}},"submitted_at":"2025-07-23T20:06:01Z","commit_id":null},{"id":3057988633,"node_id":"PRR_kwDOAO6SJc62RTQZ","user":{"login":"Ivorforce","id":2308167,"node_id":"MDQ6VXNlcjIzMDgxNjc=","avatar_url":"https://avatars.githubusercontent.com/u/2308167?u=f7f8e0273f784f5ec6f6b7fe4a88d449896eb48a&v=4","gravatar_id":"","url":"https://api.github.com/users/Ivorforce","html_url":"https://github.com/Ivorforce","followers_url":"https://api.github.com/users/Ivorforce/followers","following_url":"https://api.github.com/users/Ivorforce/following{/other_user}","gists_url":"https://api.github.com/users/Ivorforce/gists{/gist_id}","starred_url":"https://api.github.com/users/Ivorforce/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Ivorforce/subscriptions","organizations_url":"https://api.github.com/users/Ivorforce/orgs","repos_url":"https://api.github.com/users/Ivorforce/repos","events_url":"https://api.github.com/users/Ivorforce/events{/privacy}","received_events_url":"https://api.github.com/users/Ivorforce/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"Thanks for explaining!\n\nHow does this whole 'pump task' thing work out in non-threaded builds? If it just runs the leftover command queues on the main thread, could we imitate that for 'leftover' command queues that didn't get a dedicated thread in the WTP?\n\nOtherwise, while I'm still a bit sceptical about pump tasks in general, I see no reason not to merge this if it solves a release blocker. It seems like a fitting solution for the problem at hand.","state":"COMMENTED","html_url":"https://github.com/godotengine/godot/pull/108697#pullrequestreview-3057988633","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/108697","author_association":"MEMBER","_links":{"html":{"href":"https://github.com/godotengine/godot/pull/108697#pullrequestreview-3057988633"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/108697"}},"submitted_at":"2025-07-26T09:32:30Z","commit_id":null},{"id":3067891236,"node_id":"PRR_kwDOAO6SJc623E4k","user":{"login":"Ivorforce","id":2308167,"node_id":"MDQ6VXNlcjIzMDgxNjc=","avatar_url":"https://avatars.githubusercontent.com/u/2308167?u=f7f8e0273f784f5ec6f6b7fe4a88d449896eb48a&v=4","gravatar_id":"","url":"https://api.github.com/users/Ivorforce","html_url":"https://github.com/Ivorforce","followers_url":"https://api.github.com/users/Ivorforce/followers","following_url":"https://api.github.com/users/Ivorforce/following{/other_user}","gists_url":"https://api.github.com/users/Ivorforce/gists{/gist_id}","starred_url":"https://api.github.com/users/Ivorforce/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Ivorforce/subscriptions","organizations_url":"https://api.github.com/users/Ivorforce/orgs","repos_url":"https://api.github.com/users/Ivorforce/repos","events_url":"https://api.github.com/users/Ivorforce/events{/privacy}","received_events_url":"https://api.github.com/users/Ivorforce/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"Let's go ahead with this. The PR solves the problem, and is relatively simple at that.\nWe can continue discussing WTP and pump tasks in 4.6 forwards, but for 4.5 this seems like an appropriate fix.","state":"APPROVED","html_url":"https://github.com/godotengine/godot/pull/108697#pullrequestreview-3067891236","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/108697","author_association":"MEMBER","_links":{"html":{"href":"https://github.com/godotengine/godot/pull/108697#pullrequestreview-3067891236"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/108697"}},"submitted_at":"2025-07-29T14:34:05Z","commit_id":"782b9e328cd8593c8af74ab40df4f73c43f5221b"}]