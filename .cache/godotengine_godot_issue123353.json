_at":null,"archived_by":null},{"id":279098219,"node_id":"MDU6TGFiZWwyNzkwOTgyMTk=","url":"https://api.github.com/repos/godotengine/godot/labels/topic:editor","name":"topic:editor","color":"ffee88","default":false,"description":"","archived_at":null,"archived_by":null}],"state":"open","locked":false,"assignees":[],"milestone":{"url":"https://api.github.com/repos/godotengine/godot/milestones/25","html_url":"https://github.com/godotengine/godot/milestone/25","labels_url":"https://api.github.com/repos/godotengine/godot/milestones/25/labels","id":15520464,"node_id":"MI_kwDOAO6SJc4A7NLQ","number":25,"title":"4.8","description":"","creator":{"login":"Repiteo","id":17489292,"node_id":"MDQ6VXNlcjE3NDg5Mjky","avatar_url":"https://avatars.githubusercontent.com/u/17489292?v=4","gravatar_id":"","url":"https://api.github.com/users/Repiteo","html_url":"https://github.com/Repiteo","followers_url":"https://api.github.com/users/Repiteo/followers","following_url":"https://api.github.com/users/Repiteo/following{/other_user}","gists_url":"https://api.github.com/users/Repiteo/gists{/gist_id}","starred_url":"https://api.github.com/users/Repiteo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Repiteo/subscriptions","organizations_url":"https://api.github.com/users/Repiteo/orgs","repos_url":"https://api.github.com/users/Repiteo/repos","events_url":"https://api.github.com/users/Repiteo/events{/privacy}","received_events_url":"https://api.github.com/users/Repiteo/received_events","type":"User","user_view_type":"public","site_admin":false},"open_issues":345,"closed_issues":2336,"state":"open","created_at":"2026-04-13T15:59:35Z","updated_at":"2026-10-22T08:21:32Z","due_on":null,"closed_at":null},"comments":6,"created_at":"2026-09-09T22:36:42Z","updated_at":"2026-10-04T08:54:26Z","closed_at":null,"assignee":null,"author_association":"MEMBER","issue_field_values":[],"type":null,"active_lock_reason":null,"draft":false,"pull_request":{"url":"https://api.github.com/repos/godotengine/godot/pulls/123353","html_url":"https://github.com/godotengine/godot/pull/123353","diff_url":"https://github.com/godotengine/godot/pull/123353.diff","patch_url":"https://github.com/godotengine/godot/pull/123353.patch","merged_at":null},"body":"- Follow-up to https://github.com/godotengine/godot/pull/111375.\r\n\r\nThis resolves a usability issue with admonition comments in GDScript, where they had to be preceded by two `[br]` tags to look like the tags used in the built-in class reference.\r\n\r\nThis currently doesn't account for situations where you have non-admonition text after an admonition, but the class reference best practices recommend always putting admonitions at the end of a description anyway. If there's a need for this, we can read the description and put a line break after the last admonition (if it's not at the end of the description already).\r\n\r\nWe should try to get this merged in 4.8, so that user-provided comments don't need to be changed after 4.8 is released (since admonitions are a new feature in 4.8).\r\n\r\n> [!NOTE]\r\n> \r\n> If making changes to the code locally, remember to edit the property/method comment and save the script every time, as there's a disk cache system in place.\r\n\r\n- This closes https://github.com/godotengine/godot-proposals/issues/15493.\r\n\r\n## Preview\r\n\r\n```gdscript\r\n## Example description.\r\n## [note]This is a note.[/note]\r\n## [warning]This is a warning.[/warning]\r\n## [important]This is important.[/important]\r\n## [tip]This is a tip.[/tip]\r\n@export var example_no_br = \"\"\r\n```\r\n\r\nBefore | After\r\n-|-\r\n<img width=\"1017\" height=\"81\" alt=\"image\" src=\"https://github.com/user-attachments/assets/b6fbea40-f073-4095-b99c-033edd1e3afd\" /> | <img width=\"368\" height=\"217\" alt=\"image\" src=\"https://github.com/user-attachments/assets/dc5168c2-d505-4267-9f3b-7b095dab378b\" />\r\n\r\nPreviously, you would have needed to do this to get the \"after\" result:\r\n\r\n```gdscript\r\n## Example description.\r\n## [br][br][note]This is a note.[/note]\r\n## [br][br][warning]This is a warning.[/warning]\r\n## [br][br][important]This is important.[/important]\r\n## [br][br][tip]This is a tip.[/tip]\r\n@export var example_with_br = \"\"\r\n```","closed_by":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/123353/reactions","total_count":3,"+1":3,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/godotengine/godot/issues/123353/timeline","performed_via_github_app":null,"state_reason":null}