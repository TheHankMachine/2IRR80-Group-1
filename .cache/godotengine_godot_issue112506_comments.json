:3,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":2,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3521697963","html_url":"https://github.com/godotengine/godot/pull/112506#issuecomment-3521697963","issue_url":"https://api.github.com/repos/godotengine/godot/issues/112506","id":3521697963,"node_id":"IC_kwDOAO6SJc7R6Nir","user":{"login":"RandomShaper","id":11797174,"node_id":"MDQ6VXNlcjExNzk3MTc0","avatar_url":"https://avatars.githubusercontent.com/u/11797174?v=4","gravatar_id":"","url":"https://api.github.com/users/RandomShaper","html_url":"https://github.com/RandomShaper","followers_url":"https://api.github.com/users/RandomShaper/followers","following_url":"https://api.github.com/users/RandomShaper/following{/other_user}","gists_url":"https://api.github.com/users/RandomShaper/gists{/gist_id}","starred_url":"https://api.github.com/users/RandomShaper/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/RandomShaper/subscriptions","organizations_url":"https://api.github.com/users/RandomShaper/orgs","repos_url":"https://api.github.com/users/RandomShaper/repos","events_url":"https://api.github.com/users/RandomShaper/events{/privacy}","received_events_url":"https://api.github.com/users/RandomShaper/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-11-12T12:30:02Z","updated_at":"2025-11-12T12:30:02Z","body":"@brycehutchings Thanks a lot for testing and reviewing this.","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3521697963/reactions","total_count":2,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":2,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3562324246","html_url":"https://github.com/godotengine/godot/pull/112506#issuecomment-3562324246","issue_url":"https://api.github.com/repos/godotengine/godot/issues/112506","id":3562324246,"node_id":"IC_kwDOAO6SJc7UVMEW","user":{"login":"RandomShaper","id":11797174,"node_id":"MDQ6VXNlcjExNzk3MTc0","avatar_url":"https://avatars.githubusercontent.com/u/11797174?v=4","gravatar_id":"","url":"https://api.github.com/users/RandomShaper","html_url":"https://github.com/RandomShaper","followers_url":"https://api.github.com/users/RandomShaper/followers","following_url":"https://api.github.com/users/RandomShaper/following{/other_user}","gists_url":"https://api.github.com/users/RandomShaper/gists{/gist_id}","starred_url":"https://api.github.com/users/RandomShaper/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/RandomShaper/subscriptions","organizations_url":"https://api.github.com/users/RandomShaper/orgs","repos_url":"https://api.github.com/users/RandomShaper/repos","events_url":"https://api.github.com/users/RandomShaper/events{/privacy}","received_events_url":"https://api.github.com/users/RandomShaper/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-11-21T10:11:44Z","updated_at":"2025-11-21T10:11:44Z","body":"Rebased.","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3562324246/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3563754348","html_url":"https://github.com/godotengine/godot/pull/112506#issuecomment-3563754348","issue_url":"https://api.github.com/repos/godotengine/godot/issues/112506","id":3563754348,"node_id":"IC_kwDOAO6SJc7UapNs","user":{"login":"dsnopek","id":191561,"node_id":"MDQ6VXNlcjE5MTU2MQ==","avatar_url":"https://avatars.githubusercontent.com/u/191561?v=4","gravatar_id":"","url":"https://api.github.com/users/dsnopek","html_url":"https://github.com/dsnopek","followers_url":"https://api.github.com/users/dsnopek/followers","following_url":"https://api.github.com/users/dsnopek/following{/other_user}","gists_url":"https://api.github.com/users/dsnopek/gists{/gist_id}","starred_url":"https://api.github.com/users/dsnopek/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/dsnopek/subscriptions","organizations_url":"https://api.github.com/users/dsnopek/orgs","repos_url":"https://api.github.com/users/dsnopek/repos","events_url":"https://api.github.com/users/dsnopek/events{/privacy}","received_events_url":"https://api.github.com/users/dsnopek/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-11-21T16:21:26Z","updated_at":"2025-11-21T21:32:07Z","body":"I noticed the issue with the lock being held while the RenderingServer is flushing the queue (and stalling everything that's queuing stuff for the next frame) while looking at Perfetto traces on Samsung Galaxy XR.\r\n\r\nThis PR seems to solve that problem entirely!\r\n\r\n**Here's a trace from `master` running [my fork of the GDQuest TPS demo](https://github.com/dsnopek/gdquest-tps-demo/tree/standalone-vr-slush-drs-benchmarking):**\r\n\r\n<img width=\"1277\" height=\"351\" alt=\"Selection_396\" src=\"https://github.com/user-attachments/assets/e2039367-5f32-45e5-bc96-c5df37e79b04\" />\r\n\r\nThe `set_render_display_info` is the first thing on this frame that is attempting to queue a `Callable` for the rendering server, and it ends up stalled there until the render thread finishes rendering the previous frame. You can see all the process stuff waiting until the end.\r\n\r\n_(NOTE: this won't show up in traces of this project on Meta Quest 3, because Meta's runtime uses `xrWaitFrame()` to delay running process until close to the end of the frame anyway to improve input latency. However, it's still possible to trigger the issue there too, just not in this project and not as drastically.)_\r\n\r\n**And here is a trace from this PR:**\r\n\r\n<img width=\"1223\" height=\"325\" alt=\"Selection_397\" src=\"https://github.com/user-attachments/assets/3b9dc900-e659-46ae-aa8d-e282c1ef98b5\" />\r\n\r\nNotice that the process stuff happens super early now and overlaps the rendering, and it's only the `RenderingServer::sync()` that stalls until the rendering server is done, which is exactly what we would expect.\r\n\r\n_(NOTE: this trace is actually worse for input latency, but I think that's really a problem with `xrWaitFrame()` on Samsung Galaxy XR. Inadvertent lock contention on Godot's `RenderingServer` shouldn't be used as the solution for that :-))_","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3563754348/reactions","total_count":2,"+1":2,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3564558838","html_url":"https://github.com/godotengine/godot/pull/112506#issuecomment-3564558838","issue_url":"https://api.github.com/repos/godotengine/godot/issues/112506","id":3564558838,"node_id":"IC_kwDOAO6SJc7Udtn2","user":{"login":"Repiteo","id":17489292,"node_id":"MDQ6VXNlcjE3NDg5Mjky","avatar_url":"https://avatars.githubusercontent.com/u/17489292?v=4","gravatar_id":"","url":"https://api.github.com/users/Repiteo","html_url":"https://github.com/Repiteo","followers_url":"https://api.github.com/users/Repiteo/followers","following_url":"https://api.github.com/users/Repiteo/following{/other_user}","gists_url":"https://api.github.com/users/Repiteo/gists{/gist_id}","starred_url":"https://api.github.com/users/Repiteo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Repiteo/subscriptions","organizations_url":"https://api.github.com/users/Repiteo/orgs","repos_url":"https://api.github.com/users/Repiteo/repos","events_url":"https://api.github.com/users/Repiteo/events{/privacy}","received_events_url":"https://api.github.com/users/Repiteo/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-11-21T20:52:50Z","updated_at":"2025-11-21T20:52:50Z","body":"Thanks!","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3564558838/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3600854410","html_url":"https://github.com/godotengine/godot/pull/112506#issuecomment-3600854410","issue_url":"https://api.github.com/repos/godotengine/godot/issues/112506","id":3600854410,"node_id":"IC_kwDOAO6SJc7WoK2K","user":{"login":"blueskythlikesclouds","id":19259897,"node_id":"MDQ6VXNlcjE5MjU5ODk3","avatar_url":"https://avatars.githubusercontent.com/u/19259897?v=4","gravatar_id":"","url":"https://api.github.com/users/blueskythlikesclouds","html_url":"https://github.com/blueskythlikesclouds","followers_url":"https://api.github.com/users/blueskythlikesclouds/followers","following_url":"https://api.github.com/users/blueskythlikesclouds/following{/other_user}","gists_url":"https://api.github.com/users/blueskythlikesclouds/gists{/gist_id}","starred_url":"https://api.github.com/users/blueskythlikesclouds/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/blueskythlikesclouds/subscriptions","organizations_url":"https://api.github.com/users/blueskythlikesclouds/orgs","repos_url":"https://api.github.com/users/blueskythlikesclouds/repos","events_url":"https://api.github.com/users/blueskythlikesclouds/events{/privacy}","received_events_url":"https://api.github.com/users/blueskythlikesclouds/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-12-02T08:37:42Z","updated_at":"2025-12-02T08:37:42Z","body":"I've been having random crashes during resource loading and I managed to pinpoint it to this PR. TPS Demo can randomly crash during the loading screen due to heap corruptions.","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3600854410/reactions","total_count":1,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":1},"performed_via_github_app":null,"minimized":null}]