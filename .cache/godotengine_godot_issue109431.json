_by":null},{"id":865585000,"node_id":"MDU6TGFiZWw4NjU1ODUwMDA=","url":"https://api.github.com/repos/godotengine/godot/labels/topic:xr","name":"topic:xr","color":"ffee88","default":false,"description":"","archived_at":null,"archived_by":null},{"id":1327318271,"node_id":"MDU6TGFiZWwxMzI3MzE4Mjcx","url":"https://api.github.com/repos/godotengine/godot/labels/crash","name":"crash","color":"885544","default":false,"description":"","archived_at":null,"archived_by":null}],"state":"closed","locked":false,"assignees":[],"milestone":{"url":"https://api.github.com/repos/godotengine/godot/milestones/23","html_url":"https://github.com/godotengine/godot/milestone/23","labels_url":"https://api.github.com/repos/godotengine/godot/milestones/23/labels","id":12939969,"node_id":"MI_kwDOAO6SJc4AxXLB","number":23,"title":"4.6","description":"","creator":{"login":"Repiteo","id":17489292,"node_id":"MDQ6VXNlcjE3NDg5Mjky","avatar_url":"https://avatars.githubusercontent.com/u/17489292?v=4","gravatar_id":"","url":"https://api.github.com/users/Repiteo","html_url":"https://github.com/Repiteo","followers_url":"https://api.github.com/users/Repiteo/followers","following_url":"https://api.github.com/users/Repiteo/following{/other_user}","gists_url":"https://api.github.com/users/Repiteo/gists{/gist_id}","starred_url":"https://api.github.com/users/Repiteo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Repiteo/subscriptions","organizations_url":"https://api.github.com/users/Repiteo/orgs","repos_url":"https://api.github.com/users/Repiteo/repos","events_url":"https://api.github.com/users/Repiteo/events{/privacy}","received_events_url":"https://api.github.com/users/Repiteo/received_events","type":"User","user_view_type":"public","site_admin":false},"open_issues":3,"closed_issues":2978,"state":"closed","created_at":"2025-05-22T16:25:52Z","updated_at":"2026-10-04T16:23:23Z","due_on":null,"closed_at":"2026-01-26T18:09:14Z"},"comments":3,"created_at":"2025-08-08T14:47:58Z","updated_at":"2025-10-17T14:11:46Z","closed_at":"2025-10-17T14:11:25Z","assignee":null,"author_association":"CONTRIBUTOR","issue_field_values":[],"type":null,"active_lock_reason":null,"draft":false,"pull_request":{"url":"https://api.github.com/repos/godotengine/godot/pulls/109431","html_url":"https://github.com/godotengine/godot/pull/109431","diff_url":"https://github.com/godotengine/godot/pull/109431.diff","patch_url":"https://github.com/godotengine/godot/pull/109431.patch","merged_at":"2025-10-17T14:11:25Z"},"body":"Presently, our implementation of OpenXR composition layers is not thread-safe when used with `rendering/driver/threads/thread_model` set to \"Separate\".\r\n\r\nThis can lead to crashes. For example, if you run [this fork of the GDQuest TPS demo](https://github.com/dsnopek/gdquest-tps-demo/tree/standalone-vr-slush-multithreaded) and rapidly press the \"Y\" button (which will toggle visibility of a composition layer with performance info) it will eventually crash. (NOTE: this is easier to reproduce with the OpenGL renderer, but in order to use that on Quest or other Android-based headsets, you'll need to use PR #109080)\r\n\r\n**This PR fixes that crash and makes OpenXR composition layers thread-safe in general!**\r\n\r\nI've tested this with a litany of demo projects, covering all types of composition layers including using Android surfaces, on both Vulkan and OpenGL, as well as with both single and multi-threaded rendering. Everything seems to be working fine for me!\r\n\r\nI tried really hard to not totally rewrite how we handle OpenXR composition layers, and did a couple of earlier iterations that made smaller changes, but I wasn't able to make it fully thread-safe without going all the way to Godot's \"server pattern\" and using `OpenXRCompositionLayerExtension` as a proxy to the underlying resources using `RID`s. So, unfortunately, the diff is pretty big and not the easiest to review. However, long-term, I think this is a much cleaner and easier-to-maintain design.\r\n\r\n~~**NOTE:** This is currently marked as DRAFT because it builds upon PR https://github.com/godotengine/godot/pull/108644. I did this, because that PR was already ready to go, and I don't want to cause merge conflicts for the first-time contributor who made it. :-) I'll take this out of DRAFT after that PR is merged~~","closed_by":{"login":"Repiteo","id":17489292,"node_id":"MDQ6VXNlcjE3NDg5Mjky","avatar_url":"https://avatars.githubusercontent.com/u/17489292?v=4","gravatar_id":"","url":"https://api.github.com/users/Repiteo","html_url":"https://github.com/Repiteo","followers_url":"https://api.github.com/users/Repiteo/followers","following_url":"https://api.github.com/users/Repiteo/following{/other_user}","gists_url":"https://api.github.com/users/Repiteo/gists{/gist_id}","starred_url":"https://api.github.com/users/Repiteo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Repiteo/subscriptions","organizations_url":"https://api.github.com/users/Repiteo/orgs","repos_url":"https://api.github.com/users/Repiteo/repos","events_url":"https://api.github.com/users/Repiteo/events{/privacy}","received_events_url":"https://api.github.com/users/Repiteo/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/109431/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/godotengine/godot/issues/109431/timeline","performed_via_github_app":null,"state_reason":null}