hived_at":null,"archived_by":null},{"id":3240950060,"node_id":"MDU6TGFiZWwzMjQwOTUwMDYw","url":"https://api.github.com/repos/godotengine/godot/labels/performance","name":"performance","color":"447777","default":false,"description":"","archived_at":null,"archived_by":null}],"state":"closed","locked":false,"assignees":[],"milestone":{"url":"https://api.github.com/repos/godotengine/godot/milestones/22","html_url":"https://github.com/godotengine/godot/milestone/22","labels_url":"https://api.github.com/repos/godotengine/godot/milestones/22/labels","id":12070367,"node_id":"MI_kwDOAO6SJc4AuC3f","number":22,"title":"4.5","description":"","creator":{"login":"Sauermann","id":6299227,"node_id":"MDQ6VXNlcjYyOTkyMjc=","avatar_url":"https://avatars.githubusercontent.com/u/6299227?v=4","gravatar_id":"","url":"https://api.github.com/users/Sauermann","html_url":"https://github.com/Sauermann","followers_url":"https://api.github.com/users/Sauermann/followers","following_url":"https://api.github.com/users/Sauermann/following{/other_user}","gists_url":"https://api.github.com/users/Sauermann/gists{/gist_id}","starred_url":"https://api.github.com/users/Sauermann/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Sauermann/subscriptions","organizations_url":"https://api.github.com/users/Sauermann/orgs","repos_url":"https://api.github.com/users/Sauermann/repos","events_url":"https://api.github.com/users/Sauermann/events{/privacy}","received_events_url":"https://api.github.com/users/Sauermann/received_events","type":"User","user_view_type":"public","site_admin":false},"open_issues":3,"closed_issues":3687,"state":"closed","created_at":"2024-12-19T08:51:28Z","updated_at":"2026-09-04T21:48:38Z","due_on":"2025-09-15T00:00:00Z","closed_at":"2025-09-18T17:13:14Z"},"comments":2,"created_at":"2024-12-10T09:44:14Z","updated_at":"2025-03-12T15:39:54Z","closed_at":"2025-03-12T15:38:10Z","assignee":null,"author_association":"MEMBER","issue_field_values":[],"type":null,"active_lock_reason":null,"draft":false,"pull_request":{"url":"https://api.github.com/repos/godotengine/godot/pulls/100238","html_url":"https://github.com/godotengine/godot/pull/100238","diff_url":"https://github.com/godotengine/godot/pull/100238.diff","patch_url":"https://github.com/godotengine/godot/pull/100238.patch","merged_at":"2025-03-12T15:38:10Z"},"body":"This leads to performance optimizations across `substr`, `count`, `left` and `right` (and their hundreds of callers).\r\n\r\n## Explanation\r\n\r\n`copy_from_unchecked` currently does explicit UTF-32 integrity checks.\r\nIt is used in only a few places:\r\n\r\n- `substr`, `left` and `right`, where the source is already a `String` (and thus can be expected to be correct).\r\n- ~`count` (for dubious reasons copying from a String) and thus it is also expected to be correct.~\r\n    - Resolved in https://github.com/godotengine/godot/pull/101033\r\n- `parse_utf32` where the source of the String is unknown, and should actually be checked (which we do in this pr!)\r\n\r\nI have moved the checks to `parse_utf32` and removed them from `copy_from_unchecked` to speed up callers.\r\n\r\n## Benchmark\r\n\r\n`substr` can be 6x faster:\r\n\r\n```c++\r\n\tString s = \"Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt ut labore et dolore magna aliqua. Ut enim ad minim veniam, quis nostrud exercitation ullamco laboris nisi ut aliquip ex ea commodo consequat. Duis aute irure dolor in reprehenderit in voluptate velit esse cillum dolore eu fugiat nulla pariatur. Excepteur sint occaecat cupidatat non proident, sunt in culpa qui officia deserunt mollit anim id est laborum.\";\r\n\r\n\tauto t0 = std::chrono::high_resolution_clock::now();\r\n\tfor (int i = 0; i < 1000000; i ++) {\r\n\t\t// Test\r\n\t\tString s1 = s.substr(1);\r\n\t}\r\n\tauto t1 = std::chrono::high_resolution_clock::now();\r\n\tstd::cout << std::chrono::duration_cast<std::chrono::milliseconds>(t1 - t0).count() << \"ms\\n\";\r\n[...]\r\n```\r\n\r\nprints\r\n\r\n```\r\n315ms (old)\r\n55ms (new)\r\n```","closed_by":{"login":"Repiteo","id":17489292,"node_id":"MDQ6VXNlcjE3NDg5Mjky","avatar_url":"https://avatars.githubusercontent.com/u/17489292?v=4","gravatar_id":"","url":"https://api.github.com/users/Repiteo","html_url":"https://github.com/Repiteo","followers_url":"https://api.github.com/users/Repiteo/followers","following_url":"https://api.github.com/users/Repiteo/following{/other_user}","gists_url":"https://api.github.com/users/Repiteo/gists{/gist_id}","starred_url":"https://api.github.com/users/Repiteo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Repiteo/subscriptions","organizations_url":"https://api.github.com/users/Repiteo/orgs","repos_url":"https://api.github.com/users/Repiteo/repos","events_url":"https://api.github.com/users/Repiteo/events{/privacy}","received_events_url":"https://api.github.com/users/Repiteo/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/100238/reactions","total_count":12,"+1":3,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":8,"eyes":1},"timeline_url":"https://api.github.com/repos/godotengine/godot/issues/100238/timeline","performed_via_github_app":null,"state_reason":null}