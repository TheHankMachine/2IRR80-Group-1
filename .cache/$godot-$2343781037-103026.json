tars.githubusercontent.com/u/16521339?u=e44a465cbebabb9ea2be80b59e6dc07966bef5b7&v=4","created_at":"0001-01-01T00:00:00Z","followers":0,"following":0,"html_url":"https://github.com/clayjohn","id":16521339,"node_id":"MDQ6VXNlcjE2NTIxMzM5","login":"clayjohn","type":"User","owned_private_repos":0,"public_gists":0,"public_repos":0,"total_private_repos":0,"url":"https://api.github.com/users/clayjohn"},"body":"","html_url":"https://github.com/godotengine/godot/pull/103026#pullrequestreview-2630300048","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/103026","author_association":"MEMBER","submitted_at":"2025-02-20T15:38:36Z"},{"id":2630311529,"node_id":"PRR_kwDOAO6SJc6cx15p","state":"APPROVED","commit_id":"dea20c4a9b76136dc93e3d3036a6095c198c0ffa","user":{"site_admin":false,"suspended":false,"updated_at":"0001-01-01T00:00:00Z","avatar_url":"https://avatars.githubusercontent.com/u/4701338?u=4a42fd867f2c449fcc23adf635dd574dae98e6c2&v=4","created_at":"0001-01-01T00:00:00Z","followers":0,"following":0,"html_url":"https://github.com/akien-mga","id":4701338,"node_id":"MDQ6VXNlcjQ3MDEzMzg=","login":"akien-mga","type":"User","owned_private_repos":0,"public_gists":0,"public_repos":0,"total_private_repos":0,"url":"https://api.github.com/users/akien-mga"},"body":"I think it's a good idea and solves the issue of not being able to select a supported driver for the **target** platform based on what the **host** editor platform supports.\r\n\r\nSee e.g. in the current `master` branch, from Linux I can't select `d3d12` for Windows, and it wrongly shows that macOS and iOS default to `vulkan` (and `metal` can't be selected).\r\n\r\n![image](https://github.com/user-attachments/assets/34a5d928-051c-4484-b59e-a4f4b44a37b6)\r\n\r\n@clayjohn pointed out a caveat which is that if users self-compile Godot without support for some drivers (e.g. Windows editor build without `d3d12`), those users who be able to still select `d3d12` and not being able to run the project in their editor build. We do have fallbacks enabled by default so it should fallback to `vulkan`, and worse case to OpenGL, so it's unlikely to be a widespread issue (they'd need to also disable fallbacks to really brick things - in which case they can just fix the `project.godot` manually).","html_url":"https://github.com/godotengine/godot/pull/103026#pullrequestreview-2630311529","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/103026","author_association":"MEMBER","submitted_at":"2025-02-20T15:42:32Z"}]