api.github.com/users/Akosmo/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-07-10T12:40:41Z","updated_at":"2026-07-10T12:40:41Z","body":"Alternatively, since there's only one flag, it could probably be a single project setting instead of a new parameter. Would that be better?","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4935346636/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4936187891","html_url":"https://github.com/godotengine/godot/pull/117943#issuecomment-4936187891","issue_url":"https://api.github.com/repos/godotengine/godot/issues/117943","id":4936187891,"node_id":"IC_kwDOAO6SJc8AAAABJjg_8w","user":{"login":"Calinou","id":180032,"node_id":"MDQ6VXNlcjE4MDAzMg==","avatar_url":"https://avatars.githubusercontent.com/u/180032?v=4","gravatar_id":"","url":"https://api.github.com/users/Calinou","html_url":"https://github.com/Calinou","followers_url":"https://api.github.com/users/Calinou/followers","following_url":"https://api.github.com/users/Calinou/following{/other_user}","gists_url":"https://api.github.com/users/Calinou/gists{/gist_id}","starred_url":"https://api.github.com/users/Calinou/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Calinou/subscriptions","organizations_url":"https://api.github.com/users/Calinou/orgs","repos_url":"https://api.github.com/users/Calinou/repos","events_url":"https://api.github.com/users/Calinou/events{/privacy}","received_events_url":"https://api.github.com/users/Calinou/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-07-10T14:09:29Z","updated_at":"2026-07-10T14:09:29Z","body":"> Do we expect more saving options in the future? If yes, a `SAVE_FAST` flag would allow forward-compatibility while `bool` does not.\r\n> \r\n> If we don't plan that (API hasn't been changed in years, after all), it's fine!\r\n\r\nFor readability reasons, I'd also prefer an enum over a boolean parameter.\r\n\r\n> Alternatively, since there's only one flag, it could probably be a single project setting instead of a new parameter. Would that be better?\r\n\r\nOn paper, I don't really like having a project setting for this, as it makes it less granular to control. However, we do something similar for Compression levels already, so perhaps it's fine.","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4936187891/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4983258253","html_url":"https://github.com/godotengine/godot/pull/117943#issuecomment-4983258253","issue_url":"https://api.github.com/repos/godotengine/godot/issues/117943","id":4983258253,"node_id":"IC_kwDOAO6SJc8AAAABKQZ8jQ","user":{"login":"clayjohn","id":16521339,"node_id":"MDQ6VXNlcjE2NTIxMzM5","avatar_url":"https://avatars.githubusercontent.com/u/16521339?v=4","gravatar_id":"","url":"https://api.github.com/users/clayjohn","html_url":"https://github.com/clayjohn","followers_url":"https://api.github.com/users/clayjohn/followers","following_url":"https://api.github.com/users/clayjohn/following{/other_user}","gists_url":"https://api.github.com/users/clayjohn/gists{/gist_id}","starred_url":"https://api.github.com/users/clayjohn/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/clayjohn/subscriptions","organizations_url":"https://api.github.com/users/clayjohn/orgs","repos_url":"https://api.github.com/users/clayjohn/repos","events_url":"https://api.github.com/users/clayjohn/events{/privacy}","received_events_url":"https://api.github.com/users/clayjohn/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-07-15T17:02:40Z","updated_at":"2026-07-15T17:02:40Z","body":"Discussed in the core meeting today. Overall people are happy with the goal of this PR and would like to see it merged. \r\n\r\nThe one change we request is that we want the fast png path to be always enabled for moviewriter and not exposed to users through the Image API. That way there is no additional complexity in the API and nothing changes from a user decision-making perspective. \r\n\r\nIf some user reports a significant increase in memory (beyond the 30% measured) and that it harms their workflow sufficiently, then we can add an option in project settings to disable \"fast save\" for the movie writer. \r\n\r\nBut overall, let's keep things as simple as possible","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4983258253/reactions","total_count":2,"+1":2,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4996788266","html_url":"https://github.com/godotengine/godot/pull/117943#issuecomment-4996788266","issue_url":"https://api.github.com/repos/godotengine/godot/issues/117943","id":4996788266,"node_id":"IC_kwDOAO6SJc8AAAABKdTwKg","user":{"login":"clayjohn","id":16521339,"node_id":"MDQ6VXNlcjE2NTIxMzM5","avatar_url":"https://avatars.githubusercontent.com/u/16521339?v=4","gravatar_id":"","url":"https://api.github.com/users/clayjohn","html_url":"https://github.com/clayjohn","followers_url":"https://api.github.com/users/clayjohn/followers","following_url":"https://api.github.com/users/clayjohn/following{/other_user}","gists_url":"https://api.github.com/users/clayjohn/gists{/gist_id}","starred_url":"https://api.github.com/users/clayjohn/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com