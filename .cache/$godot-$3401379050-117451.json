[{"id":3950424938,"node_id":"PRR_kwDOAO6SJc7rdrNq","state":"COMMENTED","user":{"site_admin":false,"suspended":false,"updated_at":"0001-01-01T00:00:00Z","avatar_url":"https://avatars.githubusercontent.com/u/2308167?u=f7f8e0273f784f5ec6f6b7fe4a88d449896eb48a&v=4","created_at":"0001-01-01T00:00:00Z","followers":0,"following":0,"html_url":"https://github.com/Ivorforce","id":2308167,"node_id":"MDQ6VXNlcjIzMDgxNjc=","login":"Ivorforce","type":"User","owned_private_repos":0,"public_gists":0,"public_repos":0,"total_private_repos":0,"url":"https://api.github.com/users/Ivorforce"},"body":"After a quick look, to confirm my earlier impression:\r\n\r\n1. `value_ordered` can be removed. Should be safe. I actually did the same for #117451 — it used to handle ordered values in DEBUG as well. We actually don't want debug builds to differ from release builds, so it is more correct to remove it.\r\n2. The helper functions you added to `GDType` should be removed. It is the responsibility of `variant_call.cpp` to deal with the awkwardness of their interfaces. Static functions may help, but since all seem to have only one or two callers, inline might be good enough.\r\n","html_url":"https://github.com/godotengine/godot/pull/117451#pullrequestreview-3950424938","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/117451","author_association":"MEMBER","submitted_at":"2026-03-15T17:31:33Z"},{"id":3950550541,"node_id":"PRR_kwDOAO6SJc7reJ4N","state":"COMMENTED","user":{"site_admin":false,"suspended":false,"updated_at":"0001-01-01T00:00:00Z","avatar_url":"https://avatars.githubusercontent.com/u/2308167?u=f7f8e0273f784f5ec6f6b7fe4a88d449896eb48a&v=4","created_at":"0001-01-01T00:00:00Z","followers":0,"following":0,"html_url":"https://github.com/Ivorforce","id":2308167,"node_id":"MDQ6VXNlcjIzMDgxNjc=","login":"Ivorforce","type":"User","owned_private_repos":0,"public_gists":0,"public_repos":0,"total_private_repos":0,"url":"https://api.github.com/users/Ivorforce"},"body":"I didn