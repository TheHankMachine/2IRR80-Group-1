[{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2667214569","html_url":"https://github.com/godotengine/godot/issues/103015#issuecomment-2667214569","issue_url":"https://api.github.com/repos/godotengine/godot/issues/103015","id":2667214569,"node_id":"IC_kwDOAO6SJc6e-nbp","user":{"login":"matheusmdx","id":44306054,"node_id":"MDQ6VXNlcjQ0MzA2MDU0","avatar_url":"https://avatars.githubusercontent.com/u/44306054?v=4","gravatar_id":"","url":"https://api.github.com/users/matheusmdx","html_url":"https://github.com/matheusmdx","followers_url":"https://api.github.com/users/matheusmdx/followers","following_url":"https://api.github.com/users/matheusmdx/following{/other_user}","gists_url":"https://api.github.com/users/matheusmdx/gists{/gist_id}","starred_url":"https://api.github.com/users/matheusmdx/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/matheusmdx/subscriptions","organizations_url":"https://api.github.com/users/matheusmdx/orgs","repos_url":"https://api.github.com/users/matheusmdx/repos","events_url":"https://api.github.com/users/matheusmdx/events{/privacy}","received_events_url":"https://api.github.com/users/matheusmdx/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-02-19T00:19:50Z","updated_at":"2025-02-19T00:19:50Z","body":"Tested on 4.3 stable and 4.2.2 stable, both can reproduce the issue","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2667214569/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2668273800","html_url":"https://github.com/godotengine/godot/issues/103015#issuecomment-2668273800","issue_url":"https://api.github.com/repos/godotengine/godot/issues/103015","id":2668273800,"node_id":"IC_kwDOAO6SJc6fCqCI","user":{"login":"kleonc","id":9283098,"node_id":"MDQ6VXNlcjkyODMwOTg=","avatar_url":"https://avatars.githubusercontent.com/u/9283098?v=4","gravatar_id":"","url":"https://api.github.com/users/kleonc","html_url":"https://github.com/kleonc","followers_url":"https://api.github.com/users/kleonc/followers","following_url":"https://api.github.com/users/kleonc/following{/other_user}","gists_url":"https://api.github.com/users/kleonc/gists{/gist_id}","starred_url":"https://api.github.com/users/kleonc/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/kleonc/subscriptions","organizations_url":"https://api.github.com/users/kleonc/orgs","repos_url":"https://api.github.com/users/kleonc/repos","events_url":"https://api.github.com/users/kleonc/events{/privacy}","received_events_url":"https://api.github.com/users/kleonc/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-02-19T10:50:42Z","updated_at":"2025-02-19T10:50:42Z","body":"AFAICT that's not a bug. The original 128x128 texture is rendered into a 64x64 viewport (loosing details), then such downsized/downscaled ViewportTexture is being upscaled, hence the blurriness. OTOH the TextureRect on the right is sampling the original 128x128 texture all the time.\n\nYou'd need to render to a 128x128 SubViewport, and then shrink/downscale whatever renders such ViewportTexture.\n\nRelated:\n- https://github.com/godotengine/godot-proposals/issues/6221#issuecomment-2651908725\n","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2668273800/reactions","total_count":3,"+1":3,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2676987826","html_url":"https://github.com/godotengine/godot/issues/103015#issuecomment-2676987826","issue_url":"https://api.github.com/repos/godotengine/godot/issues/103015","id":2676987826,"node_id":"IC_kwDOAO6SJc6fj5ey","user":{"login":"Calinou","id":180032,"node_id":"MDQ6VXNlcjE4MDAzMg==","avatar_url":"https://avatars.githubusercontent.com/u/180032?v=4","gravatar_id":"","url":"https://api.github.com/users/Calinou","html_url":"https://github.com/Calinou","followers_url":"https://api.github.com/users/Calinou/followers","following_url":"https://api.github.com/users/Calinou/following{/other_user}","gists_url":"https://api.github.com/users/Calinou/gists{/gist_id}","starred_url":"https://api.github.com/users/Calinou/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Calinou/subscriptions","organizations_url":"https://api.github.com/users/Calinou/orgs","repos_url":"https://api.github.com/users/Calinou/repos","events_url":"https://api.github.com/users/Calinou/events{/privacy}","received_events_url":"https://api.github.com/users/Calinou/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-02-23T16:59:30Z","updated_at":"2025-02-23T16:59:30Z","body":"Closing per @kleonc's comment. The 2D editor zoom does not automatically oversample SubViewports according to the zoom level.","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2676987826/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2726000707","html_url":"https://github.com/godotengine/godot/issues/103015#issuecomment-2726000707","issue_url":"https://api.github.com/repos/godotengine/godot/issues/103015","id":2726000707,"node_id":"IC_kwDOAO6SJc6ie3hD","user":{"login":"AdamLearns","id":60950402,"node_id":"MDQ6VXNlcjYwOTUwNDAy","avatar_url":"https://avatars.githubusercontent.com/u/60950402?v=4","gravatar_id":"","url":"https://api.github.com/users/AdamLearns","html_url":"https://github.com/AdamLearns","followers_url":"https://api.github.com/users/AdamLearns/followers","following_url":"https://api.github.com/users/AdamLearns/following{/other_user}","gists_url":"https://api.github.com/users/AdamLearns/gists{/gist_id}","starred_url":"https://api.github.com/users/AdamLearns/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/AdamLearns/subscriptions","organizations_url":"https://api.github.com/users/AdamLearns/orgs","repos_url":"https://api.github.com/users/AdamLearns/repos","events_url":"https://api.github.com/users/AdamLearns/events{/privacy}","received_events_url":"https://api.github.com/users/AdamLearns/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-03-14T23:29:04Z","updated_at":"2025-03-14T23:29:04Z","body":"Apologies for the late response here, but I wanted to thank everyone for chiming in! I was pretty sure I had to be doing something wrong, so it's helpful to know how I can start to address this in our game. 🙏 ","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2726000707/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2777195584","html_url":"https://github.com/godotengine/godot/issues/103015#issuecomment-2777195584","issue_url":"https://api.github.com/repos/godotengine/godot/issues/103015","id":2777195584,"node_id":"IC_kwDOAO6SJc6liKRA","user":{"login":"AdamLearns","id":60950402,"node_id":"MDQ6VXNlcjYwOTUwNDAy","avatar_url":"https://avatars.githubusercontent.com/u/60950402?v=4","gravatar_id":"","url":"https://api.github.com/users/AdamLearns","html_url":"https://github.com/AdamLearns","followers_url":"https://api.github.com/users/AdamLearns/followers","following_url":"https://api.github.com/users/AdamLearns/following{/other_user}","gists_url":"https://api.github.com/users/AdamLearns/gists{/gist_id}","starred_url":"https://api.github.com/users/AdamLearns/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/AdamLearns/subscriptions","organizations_url":"https://api.github.com/users/AdamLearns/orgs","repos_url":"https://api.github.com/users/AdamLearns/repos","events_url":"https://api.github.com/users/AdamLearns/events{/privacy}","received_events_url":"https://api.github.com/users/AdamLearns/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-04-03T23:21:16Z","updated_at":"2025-04-03T23:21:16Z","body":"FYI to anyone who finds this issue in the future: I spent a long time looking into this in search of a fix. I documented the investigation [in my notes](https://notes.adamlearns.com/notes/godot-game-engine/godot/godot-ui/#subviewport-and-subviewportcontainer) (warning: I may be wrong about some of what I've written 👀). The highlights are:\n\n- I was wondering why @kleonc had mentioned upscaling in [their comment](https://github.com/godotengine/godot/issues/103015#issuecomment-2668273800). That's when I realized that on high-DPI displays on macOS, Godot automatically applies scaling at the editor level. This is controlled in the Editor Settings via `interface/editor/display_scale` and `interface/editor/custom_display_scale`:\n\n![Image](https://github.com/user-attachments/assets/02794239-d3db-4eb1-9587-8a4db51db838)\n\n...when I changed that to 100% and reset the zoom to 100% as well, the blurriness disappeared. This wasn't a solution to my problem since I expose `ContentScaleFactor` to users in my game, but it clarified my confusion about where the upscaling was occurring!\n\n- Resizing and rescaling a `ViewportTexture` wasn't hard in isolation. It was slightly harder in my game since there's a more complex scene hierarchy in addition to dynamically instantiated nodes. As such, I suggest adding a `Control` parent above a `SubViewportContainer` so that you can directly change the scale of the `SubViewportContainer` (as opposed to relying on a `Container` parent). In general, you'll want to take your upscaling amount, `X`, and multiply your `SubViewportContainer`'s size by that, then multiply the `SubViewportContainer`'s scale by `1/X`. I don't want to deal with handling a dynamic `X` just yet, so I'm just always assuming `X == 2`, meaning if users set `ContentScaleFactor = 3` via the in-game settings, things will look a _little_ blurry.\n\nThere's much more detail in my notes (I'd write it all here, but it's easier to maintain my notes rather than a random GitHub comment 😅).","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2777195584/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3183089868","html_url":"https://github.com/godotengine/godot/issues/103015#issuecomment-3183089868","issue_url":"https://api.github.com/repos/godotengine/godot/issues/103015","id":3183089868,"node_id":"IC_kwDOAO6SJc69uhjM","user":{"login":"feiyuhuahuo","id":32631344,"node_id":"MDQ6VXNlcjMyNjMxMzQ0","avatar_url":"https://avatars.githubusercontent.com/u/32631344?v=4","gravatar_id":"","url":"https://api.github.com/users/feiyuhuahuo","html_url":"https://github.com/feiyuhuahuo","followers_url":"https://api.github.com/users/feiyuhuahuo/followers","following_url":"https://api.github.com/users/feiyuhuahuo/following{/other_user}","gists_url":"https://api.github.com/users/feiyuhuahuo/gists{/gist_id}","starred_url":"https://api.github.com/users/feiyuhuahuo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/feiyuhuahuo/subscriptions","organizations_url":"https://api.github.com/users/feiyuhuahuo/orgs","repos_url":"https://api.github.com/users/feiyuhuahuo/repos","events_url":"https://api.github.com/users/feiyuhuahuo/events{/privacy}","received_events_url":"https://api.github.com/users/feiyuhuahuo/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-08-13T09:58:22Z","updated_at":"2025-08-13T09:58:22Z","body":"@kleonc   Why such design? Change the window size is a common option for different players, but the content in a subviewport becomes blur once it changed. As far as I am tested, let's say here are two cases, case1: scene (instantiated), case2: subviewportcontainer-> subviewport -> scene, after changing the window size, case1 is much crisp (clear) than case2.","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3183089868/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3184289082","html_url":"https://github.com/godotengine/godot/issues/103015#issuecomment-3184289082","issue_url":"https://api.github.com/repos/godotengine/godot/issues/103015","id":3184289082,"node_id":"IC_kwDOAO6SJc69zGU6","user":{"login":"feiyuhuahuo","id":32631344,"node_id":"MDQ6VXNlcjMyNjMxMzQ0","avatar_url":"https://avatars.githubusercontent.com/u/32631344?v=4","gravatar_id":"","url":"https://api.github.com/users/feiyuhuahuo","html_url":"https://github.com/feiyuhuahuo","followers_url":"https://api.github.com/users/feiyuhuahuo/followers","following_url":"https://api.github.com/users/feiyuhuahuo/following{/other_user}","gists_url":"https://api.github.com/users/feiyuhuahuo/gists{/gist_id}","starred_url":"https://api.github.com/users/feiyuhuahuo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/feiyuhuahuo/subscriptions","organizations_url":"https://api.github.com/users/feiyuhuahuo/orgs","repos_url":"https://api.github.com/users/feiyuhuahuo/repos","events_url":"https://api.github.com/users/feiyuhuahuo/events{/privacy}","received_events_url":"https://api.github.com/users/feiyuhuahuo/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-08-13T15:00:29Z","updated_at":"2025-08-13T15:00:29Z","body":"@AdamLearns Thanks for the workaround, it works. But anyway, after downscaling the SubViewportContainer's scale, the content looks a little, just a little blurry. This is even much better than the blurry of the original setting.","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3184289082/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null}]