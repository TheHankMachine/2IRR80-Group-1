ge](https://github.com/user-attachments/assets/3332c519-433d-4264-b249-1b249c9eba74)\n\n### Steps to reproduce\n\nUse Free() with a large scene\n\n### Minimal reproduction project (MRP)\n\nUnfortunately I am not able to reproduce this in an MRP. ","closed_by":{"login":"MatthiasBae","id":52577744,"node_id":"MDQ6VXNlcjUyNTc3NzQ0","avatar_url":"https://avatars.githubusercontent.com/u/52577744?v=4","gravatar_id":"","url":"https://api.github.com/users/MatthiasBae","html_url":"https://github.com/MatthiasBae","followers_url":"https://api.github.com/users/MatthiasBae/followers","following_url":"https://api.github.com/users/MatthiasBae/following{/other_user}","gists_url":"https://api.github.com/users/MatthiasBae/gists{/gist_id}","starred_url":"https://api.github.com/users/MatthiasBae/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/MatthiasBae/subscriptions","organizations_url":"https://api.github.com/users/MatthiasBae/orgs","repos_url":"https://api.github.com/users/MatthiasBae/repos","events_url":"https://api.github.com/users/MatthiasBae/events{/privacy}","received_events_url":"https://api.github.com/users/MatthiasBae/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/107669/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/godotengine/godot/issues/107669/timeline","performed_via_github_app":null,"state_reason":"completed","pinned_comment":null}