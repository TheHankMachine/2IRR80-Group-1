307053/reactions","total_count":1,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":1,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2637311533","html_url":"https://github.com/godotengine/godot/pull/102456#issuecomment-2637311533","issue_url":"https://api.github.com/repos/godotengine/godot/issues/102456","id":2637311533,"node_id":"IC_kwDOAO6SJc6dMi4t","user":{"login":"AThousandShips","id":96648715,"node_id":"U_kgDOBcK-Cw","avatar_url":"https://avatars.githubusercontent.com/u/96648715?v=4","gravatar_id":"","url":"https://api.github.com/users/AThousandShips","html_url":"https://github.com/AThousandShips","followers_url":"https://api.github.com/users/AThousandShips/followers","following_url":"https://api.github.com/users/AThousandShips/following{/other_user}","gists_url":"https://api.github.com/users/AThousandShips/gists{/gist_id}","starred_url":"https://api.github.com/users/AThousandShips/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/AThousandShips/subscriptions","organizations_url":"https://api.github.com/users/AThousandShips/orgs","repos_url":"https://api.github.com/users/AThousandShips/repos","events_url":"https://api.github.com/users/AThousandShips/events{/privacy}","received_events_url":"https://api.github.com/users/AThousandShips/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-02-05T15:51:51Z","updated_at":"2025-02-05T16:03:44Z","body":"This will very likely not be reviewed in its current state, I for one won't feel confident approving this, as I can't guarantee that it will be complete enough\r\n\r\nAnd I'm sorry but if it's a lot of work for you to split it up then imagine how much more it is to review it\r\n\r\nSplitting it would be relatively straight forward with `git add --interactive`\r\n\r\nThe changes aren't necessarily simple in principle, as mentioned above passing by pointer is valid and is depending on case, but even if the idea was valid in principle that doesn't mean the review is not important","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2637311533/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2637394922","html_url":"https://github.com/godotengine/godot/pull/102456#issuecomment-2637394922","issue_url":"https://api.github.com/repos/godotengine/godot/issues/102456","id":2637394922,"node_id":"IC_kwDOAO6SJc6dM3Pq","user":{"login":"YYF233333","id":67693830,"node_id":"MDQ6VXNlcjY3NjkzODMw","avatar_url":"https://avatars.githubusercontent.com/u/67693830?v=4","gravatar_id":"","url":"https://api.github.com/users/YYF233333","html_url":"https://github.com/YYF233333","followers_url":"https://api.github.com/users/YYF233333/followers","following_url":"https://api.github.com/users/YYF233333/following{/other_user}","gists_url":"https://api.github.com/users/YYF233333/gists{/gist_id}","starred_url":"https://api.github.com/users/YYF233333/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/YYF233333/subscriptions","organizations_url":"https://api.github.com/users/YYF233333/orgs","repos_url":"https://api.github.com/users/YYF233333/repos","events_url":"https://api.github.com/users/YYF233333/events{/privacy}","received_events_url":"https://api.github.com/users/YYF233333/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-02-05T16:18:08Z","updated_at":"2025-02-05T16:18:08Z","body":"Well, I don’t see why this is riskier than #99321 (in fact, it was what inspired me to make this PR). My intention was to group these no brainers together so that follow up PRs with actual works would be clearer. If you don’t think these changes are straightforward enough, I’ll just move them back.\r\n\r\n> Splitting it would be relatively straight forward with `git add --interactive`\r\n\r\nThis looks very useful. Thanks!\r\n\r\n","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2637394922/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2637402168","html_url":"https://github.com/godotengine/godot/pull/102456#issuecomment-2637402168","issue_url":"https://api.github.com/repos/godotengine/godot/issues/102456","id":2637402168,"node_id":"IC_kwDOAO6SJc6dM5A4","user":{"login":"AThousandShips","id":96648715,"node_id":"U_kgDOBcK-Cw","avatar_url":"https://avatars.githubusercontent.com/u/96648715?v=4","gravatar_id":"","url":"https://api.github.com/users/AThousandShips","html_url":"https://github.com/AThousandShips","followers_url":"https://api.github.com/users/AThousandShips/followers","following_url":"https://api.github.com/users/AThousandShips/following{/other_user}","gists_url":"https://api.github.com/users/AThousandShips/gists{/gist_id}","starred_url":"https://api.github.com/users/AThousandShips/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/AThousandShips/subscriptions","organizations_url":"https://api.github.com/users/AThousandShips/orgs","repos_url":"https://api.github.com/users/AThousandShips/repos","events_url":"https://api.github.com/users/AThousandShips/events{/privacy}","received_events_url":"https://api.github.com/users/AThousandShips/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-02-05T16:21:00Z","updated_at":"2025-02-05T16:21:00Z","body":"#99321 doesn't change any behavior, this changes behavior, this is absolutely something to evaluate depending on the individual cases, but again the passing by pointer is for optional cases and at least one case involved a null check that meant it was used in that way\r\n\r\nHaving it passed by pointer means allowing us to not populate the return if it's unused, which can save a lot of performance depending on the case","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2637402168/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null}]