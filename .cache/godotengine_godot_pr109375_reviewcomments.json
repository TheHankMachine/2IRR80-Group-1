ithub.com/godotengine/godot/pull/109375#discussion_r2284921877"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/109375"}},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/2284921877/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":null,"original_line":8440,"side":"RIGHT","in_reply_to_id":2284859039,"author_association":"MEMBER","original_position":4,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/2284967323","pull_request_review_id":3131915307,"id":2284967323,"node_id":"PRRC_kwDOAO6SJc6IMdWb","diff_hunk":"@@ -1082,7 +1092,17 @@ String VisualShaderNodeCurveTexture::get_output_port_name(int p_port) const {\n }\n \n void VisualShaderNodeCurveTexture::set_texture(Ref<CurveTexture> p_texture) {\n+\tif (!texture.is_null()) {\n+\t\tif (texture->is_built_in()) {","path":"scene/resources/visual_shader_nodes.cpp","commit_id":"c4559c02dee1b7575c766bef3b99e39181c1c8c2","original_commit_id":"61b7700e41a50007b4502b6d4210cc5478109944","user":{"login":"ColinSORourke","id":44822820,"node_id":"MDQ6VXNlcjQ0ODIyODIw","avatar_url":"https://avatars.githubusercontent.com/u/44822820?v=4","gravatar_id":"","url":"https://api.github.com/users/ColinSORourke","html_url":"https://github.com/ColinSORourke","followers_url":"https://api.github.com/users/ColinSORourke/followers","following_url":"https://api.github.com/users/ColinSORourke/following{/other_user}","gists_url":"https://api.github.com/users/ColinSORourke/gists{/gist_id}","starred_url":"https://api.github.com/users/ColinSORourke/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/ColinSORourke/subscriptions","organizations_url":"https://api.github.com/users/ColinSORourke/orgs","repos_url":"https://api.github.com/users/ColinSORourke/repos","events_url":"https://api.github.com/users/ColinSORourke/events{/privacy}","received_events_url":"https://api.github.com/users/ColinSORourke/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"The focus of this fix is preventing a 'destructive' conversion. \r\n\r\nThe problems are twofold:\r\nA. VisualShader -> GDShader conversion doesn't work with any embeds because a GDShader is a text file without embeds. Any embed would need to be rebound as ShaderParameters on a ShaderMaterial. This is a fundamental consequence of providing this specific conversion. \r\nB. VisualShader -> GDShader conversion destroys sub resources embedded in the VisualShader because they have no where to go, a user could lose important data.\r\n\r\nFixing A requires a more drastic change, such as removing the VisualShader -> GDShader Conversion, and possibly replacing it with a VisualShader -> ShaderMaterial with embedded GDShader conversion.\r\n\r\nIn the meantime, fixing B just requires catching embedded sub-resources, and throwing error so the resources can't be deleted. I think 'Embed_count' was an imprecise name, I mean to keep SubResource count. This check in particular catches the case where an embedded sub resource is replaced with an embedded external resource.\r\n\r\nI don't think a true embed count is useful - that value is simpler to keep track of, just whether or not each Ref is null. Tracking builtin resources is necessary currently to prevent the destructive conversion, and I think will be useful in future code working with this topic, as it would also need to differentiate BuiltIn resources from Externals.","created_at":"2025-08-19T11:34:55Z","updated_at":"2025-08-19T11:34:55Z","html_url":"https://github.com/godotengine/godot/pull/109375#discussion_r2284967323","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/109375","_links":{"self":{"href":"https://api.github.com/repos/godotengine/godot/pulls/comments/2284967323"},"html":{"href":"https://github.com/godotengine/godot/pull/109375#discussion_r2284967323"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/109375"}},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/2284967323/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":null,"original_line":1096,"side":"RIGHT","in_reply_to_id":2284858277,"author_association":"CONTRIBUTOR","original_position":23,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/2285050130","pull_request_review_id":3132034849,"id":2285050130,"node_id":"PRRC_kwDOAO6SJc6IMxkS","diff_hunk":"@@ -8437,6 +8437,7 @@ bool VisualShaderConversionPlugin::handles(const Ref<Resource> &p_resource) cons\n Ref<Resource> VisualShaderConversionPlugin::convert(const Ref<Resource> &p_resource) const {\n \tRef<VisualShader> vshader = p_resource;\n \tERR_FAIL_COND_V(vshader.is_null(), Ref<Resource>());\n+\tERR_FAIL_COND_V(vshader->has_node_embeds(), Ref<Resource>());","path":"editor/shader/visual_shader_editor_plugin.cpp","commit_id":"c4559c02dee1b7575c766bef3b99e39181c1c8c2","original_commit_id":"61b7700e41a50007b4502b6d4210cc5478109944","user":{"login":"ColinSORourke","id":44822820,"node_id":"MDQ6VXNlcjQ0ODIyODIw","avatar_url":"https://avatars.githubusercontent.com/u/44822820?v=4","gravatar_id":"","url":"https://api.github.com/users/ColinSORourke","html_url":"https://github.com/ColinSORourke","followers_url":"https://api.github.com/users/ColinSORourke/followers","following_url":"https://api.github.com/users/ColinSORourke/following{/other_user}","gists_url":"https://api.github.com/users/ColinSORourke/gists{/gist_id}","starred_url":"https://api.github.com/users/ColinSORourke/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/ColinSORourke/subscriptions","organizations_url":"https://api.github.com/users/ColinSORou