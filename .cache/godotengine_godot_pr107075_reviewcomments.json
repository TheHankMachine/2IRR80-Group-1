.github.com/users/m4gr3d/followers","following_url":"https://api.github.com/users/m4gr3d/following{/other_user}","gists_url":"https://api.github.com/users/m4gr3d/gists{/gist_id}","starred_url":"https://api.github.com/users/m4gr3d/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/m4gr3d/subscriptions","organizations_url":"https://api.github.com/users/m4gr3d/orgs","repos_url":"https://api.github.com/users/m4gr3d/repos","events_url":"https://api.github.com/users/m4gr3d/events{/privacy}","received_events_url":"https://api.github.com/users/m4gr3d/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"Since a `JavaObject` extends from `RefCounted`, it has also access to methods from `RefCounted` and `Object`.\r\n\r\nSuppose a wrapped Java class defines a `reference()` method in its API; without the added logic, the Java version of `reference()` would shadow the `RefCounted` version of `reference()`. \r\n\r\nSo the added logic ensures that whenever there's overlap, the Godot methods take precedence.","created_at":"2025-08-17T07:16:31Z","updated_at":"2025-08-17T07:16:31Z","html_url":"https://github.com/godotengine/godot/pull/107075#discussion_r2280760377","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/107075","_links":{"self":{"href":"https://api.github.com/repos/godotengine/godot/pulls/comments/2280760377"},"html":{"href":"https://github.com/godotengine/godot/pull/107075#discussion_r2280760377"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/107075"}},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/2280760377/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":852,"original_start_line":852,"start_side":"RIGHT","line":858,"original_line":858,"side":"RIGHT","in_reply_to_id":2280747663,"author_association":"CONTRIBUTOR","original_position":286,"position":291,"subject_t