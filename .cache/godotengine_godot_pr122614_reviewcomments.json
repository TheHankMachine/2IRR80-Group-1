tengine/godot/pulls/comments/3818727356","pull_request_review_id":4979183181,"id":3818727356,"node_id":"PRRC_kwDOAO6SJc7jnSe8","diff_hunk":"@@ -89,8 +90,18 @@ class GodotArea2D : public GodotCollisionObject2D {\n \t\t_FORCE_INLINE_ void dec() { state--; }\n \t};\n \n-\tHashMap<BodyKey, BodyState, BodyKey> monitored_bodies;\n-\tHashMap<BodyKey, BodyState, BodyKey> monitored_areas;\n+\t// This wraps a global allocator for use by all GodotArea2D objects\n+\tstruct SharedAllocator {\n+\t\tstatic PagedAllocator<HashMapElement<BodyKey, BodyState>, false, 2048> allocator;","path":"modules/godot_physics_2d/godot_area_2d.h","commit_id":"1a0ea1df0dffcdb44927e6e0e9c60cc9057923f3","original_commit_id":"1bc71273d8c614a203b2f919f100fbc9705a04e8","user":{"login":"Schnorg","id":44937651,"node_id":"MDQ6VXNlcjQ0OTM3NjUx","avatar_url":"https://avatars.githubusercontent.com/u/44937651?v=4","gravatar_id":"","url":"https://api.github.com/users/Schnorg","html_url":"https://github.com/Schnorg","followers_url":"https://api.github.com/users/Schnorg/followers","following_url":"https://api.github.com/users/Schnorg/following{/other_user}","gists_url":"https://api.github.com/users/Schnorg/gists{/gist_id}","starred_url":"https://api.github.com/users/Schnorg/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Schnorg/subscriptions","organizations_url":"https://api.github.com/users/Schnorg/orgs","repos_url":"https://api.github.com/users/Schnorg/repos","events_url":"https://api.github.com/users/Schnorg/events{/privacy}","received_events_url":"https://api.github.com/users/Schnorg/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"Yes I looked into that before removing the thread safe setup (because speed is important here). \r\n\r\nIf you look at physics_step() you will see that it specifically excludes the pre_solve() step from using worker threads. That is the step in `godot_area_pair_2d.cpp` that adds and removes from the GodotArea2D HashMaps.\r\n\r\nflush_queries() call drives the Area2D callback's _area_inout() and _body_inout(). This physics server call is run directly from the main loop (not put onto the command queue for the physics thread).\r\n\r\nThe other Area2D functions that reference its HashMaps, like _area_exit_tree(), must be on the same SceneTree thread right? and SceneTree doesn't allow multithreaded access.","created_at":"2026-08-20T04:53:30Z","updated_at":"2026-08-20T04:53:31Z","html_url":"https://github.com/godotengine/godot/pull/122614#discussion_r3818727356","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/122614","_links":{"self":{"href":"https://api.github.com/repos/godotengine/godot/pulls/comments/3818727356"},"html":{"href":"https://github.com/godotengine/godot/pull/122614#discussion_r3818727356"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/122614"}},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/3818727356/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":95,"original_line":95,"side":"RIGHT","in_reply_to_id":3817174029,"author_association":"CONTRIBUTOR","original_position":16,"position":16,"subject_type":"line"},{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/3818768188","pull_request_review_id":4979233366,"id":3818768188,"node_id":"PRRC_kwDOAO6SJc7jncc8","diff_hunk":"@@ -89,8 +90,18 @@ class GodotArea2D : public GodotCollisionObject2D {\n \t\t_FORCE_INLINE_ void dec() { state--; }\n \t};\n \n-\tHashMap<BodyKey, BodyState, BodyKey> monitored_bodies;\n-\tHashMap<BodyKey, BodyState, BodyKey> monitored_areas;\n+\t// This wraps a global allocator for use by all GodotArea2D objects\n+\tstruct SharedAllocator {\n+\t\tstatic PagedAllocator<HashMapElement<BodyKey, BodyState>, false, 2048> allocator;\n+\n+\t\ttemplate <typename... Args>\n+\t\tHashMapE