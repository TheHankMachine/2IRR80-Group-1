[{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2566827911","html_url":"https://github.com/godotengine/godot/pull/100991#issuecomment-2566827911","issue_url":"https://api.github.com/repos/godotengine/godot/issues/100991","id":2566827911,"node_id":"IC_kwDOAO6SJc6Y_q-H","user":{"login":"fire","id":32321,"node_id":"MDQ6VXNlcjMyMzIx","avatar_url":"https://avatars.githubusercontent.com/u/32321?v=4","gravatar_id":"","url":"https://api.github.com/users/fire","html_url":"https://github.com/fire","followers_url":"https://api.github.com/users/fire/followers","following_url":"https://api.github.com/users/fire/following{/other_user}","gists_url":"https://api.github.com/users/fire/gists{/gist_id}","starred_url":"https://api.github.com/users/fire/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/fire/subscriptions","organizations_url":"https://api.github.com/users/fire/orgs","repos_url":"https://api.github.com/users/fire/repos","events_url":"https://api.github.com/users/fire/events{/privacy}","received_events_url":"https://api.github.com/users/fire/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-01-01T03:31:21Z","updated_at":"2025-01-01T03:31:21Z","body":"We tend to require more help with documentation!","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2566827911/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2568972148","html_url":"https://github.com/godotengine/godot/pull/100991#issuecomment-2568972148","issue_url":"https://api.github.com/repos/godotengine/godot/issues/100991","id":2568972148,"node_id":"IC_kwDOAO6SJc6ZH2d0","user":{"login":"lawnjelly","id":21999379,"node_id":"MDQ6VXNlcjIxOTk5Mzc5","avatar_url":"https://avatars.githubusercontent.com/u/21999379?v=4","gravatar_id":"","url":"https://api.github.com/users/lawnjelly","html_url":"https://github.com/lawnjelly","followers_url":"https://api.github.com/users/lawnjelly/followers","following_url":"https://api.github.com/users/lawnjelly/following{/other_user}","gists_url":"https://api.github.com/users/lawnjelly/gists{/gist_id}","starred_url":"https://api.github.com/users/lawnjelly/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/lawnjelly/subscriptions","organizations_url":"https://api.github.com/users/lawnjelly/orgs","repos_url":"https://api.github.com/users/lawnjelly/repos","events_url":"https://api.github.com/users/lawnjelly/events{/privacy}","received_events_url":"https://api.github.com/users/lawnjelly/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-01-03T10:00:43Z","updated_at":"2025-01-03T13:49:17Z","body":"Realised I have confused this function with another (probably relative rotation), sorry for wall of text and confusion.","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2568972148/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2568981904","html_url":"https://github.com/godotengine/godot/pull/100991#issuecomment-2568981904","issue_url":"https://api.github.com/repos/godotengine/godot/issues/100991","id":2568981904,"node_id":"IC_kwDOAO6SJc6ZH42Q","user":{"login":"Flarkk","id":49606622,"node_id":"MDQ6VXNlcjQ5NjA2NjIy","avatar_url":"https://avatars.githubusercontent.com/u/49606622?v=4","gravatar_id":"","url":"https://api.github.com/users/Flarkk","html_url":"https://github.com/Flarkk","followers_url":"https://api.github.com/users/Flarkk/followers","following_url":"https://api.github.com/users/Flarkk/following{/other_user}","gists_url":"https://api.github.com/users/Flarkk/gists{/gist_id}","starred_url":"https://api.github.com/users/Flarkk/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Flarkk/subscriptions","organizations_url":"https://api.github.com/users/Flarkk/orgs","repos_url":"https://api.github.com/users/Flarkk/repos","events_url":"https://api.github.com/users/Flarkk/events{/privacy}","received_events_url":"https://api.github.com/users/Flarkk/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-01-03T10:08:13Z","updated_at":"2025-01-03T10:08:25Z","body":"Could using the current `Basis` as the \"previous value\" you refer to be an acceptable middle ground ?\n\nWouldn't solve all 3 cases you mention but at least provide consistent results in the FPS case where the `Basis` is updated incrementally.","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2568981904/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2568987582","html_url":"https://github.com/godotengine/godot/pull/100991#issuecomment-2568987582","issue_url":"https://api.github.com/repos/godotengine/godot/issues/100991","id":2568987582,"node_id":"IC_kwDOAO6SJc6ZH6O-","user":{"login":"lawnjelly","id":21999379,"node_id":"MDQ6VXNlcjIxOTk5Mzc5","avatar_url":"https://avatars.githubusercontent.com/u/21999379?v=4","gravatar_id":"","url":"https://api.github.com/users/lawnjelly","html_url":"https://github.com/lawnjelly","followers_url":"https://api.github.com/users/lawnjelly/followers","following_url":"https://api.github.com/users/lawnjelly/following{/other_user}","gists_url":"https://api.github.com/users/lawnjelly/gists{/gist_id}","starred_url":"https://api.github.com/users/lawnjelly/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/lawnjelly/subscriptions","organizations_url":"https://api.github.com/users/lawnjelly/orgs","repos_url":"https://api.github.com/users/lawnjelly/repos","events_url":"https://api.github.com/users/lawnjelly/events{/privacy}","received_events_url":"https://api.github.com/users/lawnjelly/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-01-03T10:12:36Z","updated_at":"2025-01-03T13:50:45Z","body":"> Could using the current Basis as the \"previous value\" you refer to be an acceptable middle ground ?\r\n\r\nFor the `Node` at least, deriving `previous_yaw` from the existing basis would be a first step, but it is still susceptible to problems with (2), although as I say in the case close to `p_up` (or 180) it could simply not alter the basis at all (in which case the yaw would be preserved).\r\n\r\nFor `Basis` itself, it would be strictly speaking breaking compatibility as it would be relying on the current contents (although maybe this doesn't matter too much as previous behaviour is so broken). Also the case for (2) would have to be handled.\r\n\r\n(Incidentally, I've not done or planning any PRs on this, am happy to review any more in depth fixes based on the above.)\r\n\r\n_BTW there's an extra situation to deal with which is the flipping (or not) of yaw when you cross the up vector. But that's an implementation detail._","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2568987582/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":{"reason":"outdated"}},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2569126514","html_url":"https://github.com/godotengine/godot/pull/100991#issuecomment-2569126514","issue_url":"https://api.github.com/repos/godotengine/godot/issues/100991","id":2569126514,"node_id":"IC_kwDOAO6SJc6ZIcJy","user":{"login":"TokageItLab","id":61938263,"node_id":"MDQ6VXNlcjYxOTM4MjYz","avatar_url":"https://avatars.githubusercontent.com/u/61938263?v=4","gravatar_id":"","url":"https://api.github.com/users/TokageItLab","html_url":"https://github.com/TokageItLab","followers_url":"https://api.github.com/users/TokageItLab/followers","following_url":"https://api.github.com/users/TokageItLab/following{/other_user}","gists_url":"https://api.github.com/users/TokageItLab/gists{/gist_id}","starred_url":"https://api.github.com/users/TokageItLab/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/TokageItLab/subscriptions","organizations_url":"https://api.github.com/users/TokageItLab/orgs","repos_url":"https://api.github.com/users/TokageItLab/repos","events_url":"https://api.github.com/users/TokageItLab/events{/privacy}","received_events_url":"https://api.github.com/users/TokageItLab/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-01-03T12:07:56Z","updated_at":"2025-01-04T19:48:44Z","body":"In my thinking, the definition of the current yaw is ambiguous for Basis and Quaternion, so there is not much point in worrying about it. Although I feel that it is not correct in the first place that z-axis has a special meaning on the looking_at in Basis; If we want to solve that problem at Basis, I think not only previous_yaw but also forward_axis needs to be explicit, discontinuing the use_model_front parameter as well.\r\n\r\nFor Node3D, however, the current direction is explicit, so in cases 1 and 2, a preliminary check before calling Basis.looking_at() could improve things before the warning in Basis is reached; For case 2, we can do not to rotate. Since the user has no control over the very small vectors that would introduce errors, it is better to do nothing than to make a rotation that depends on it. However, there should be nothing that can be done about case 3, i.e., the 180-degree rotation case.","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2569126514/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":{"reason":"resolved"}},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2569178136","html_url":"https://github.com/godotengine/godot/pull/100991#issuecomment-2569178136","issue_url":"https://api.github.com/repos/godotengine/godot/issues/100991","id":2569178136,"node_id":"IC_kwDOAO6SJc6ZIowY","user":{"login":"TokageItLab","id":61938263,"node_id":"MDQ6VXNlcjYxOTM4MjYz","avatar_url":"https://avatars.githubusercontent.com/u/61938263?v=4","gravatar_id":"","url":"https://api.github.com/users/TokageItLab","html_url":"https://github.com/TokageItLab","followers_url":"https://api.github.com/users/TokageItLab/followers","following_url":"https://api.github.com/users/TokageItLab/following{/other_user}","gists_url":"https://api.github.com/users/TokageItLab/gists{/gist_id}","starred_url":"https://api.github.com/users/TokageItLab/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/TokageItLab/subscriptions","organizations_url":"https://api.github.com/users/TokageItLab/orgs","repos_url":"https://api.github.com/users/TokageItLab/repos","events_url":"https://api.github.com/users/TokageItLab/events{/privacy}","received_events_url":"https://api.github.com/users/TokageItLab/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-01-03T12:52:48Z","updated_at":"2025-01-04T19:48:50Z","body":"Also, this may be a niche case, but in cases where `looking_at()` is used to align yaw, it is necessary to be aware of the possibility that `looking_at()` may cause problems if the rotation is implicitly dependent on the previous yaw.\r\n\r\nFor example, if the bone orientation of a model loaded from an external source is used as it is, or if the orientation is different for each saved scene, there will be cases where the X and Y-axis will not match when `looking_at()` is used to match the rotation. Conversely, current this PR should result in the same X and Y-axis, although cause unintended rotation in Z-axis.\r\n\r\nGiven this, it appears that a warning is still required. In other words, since this needs to be handled by the user, I think a currently possible compromise is to provide a method for checking colinear case such as `Vector3.is_cololinear()` method and to write in the documentation how to prevent rotation with `looking_at()` on the user side; As similer idea with @lawnjelly said above:\r\n\r\n> Another option to solve (2) is to not change the basis (as it is very close to up vector anyway), not report an error, but maybe return a false for success (in case the user wanted to act upon this).","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2569178136/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":{"reason":"resolved"}},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2569205488","html_url":"https://github.com/godotengine/godot/pull/100991#issuecomment-2569205488","issue_url":"https://api.github.com/repos/godotengine/godot/issues/100991","id":2569205488,"node_id":"IC_kwDOAO6SJc6ZIvbw","user":{"login":"lawnjelly","id":21999379,"node_id":"MDQ6VXNlcjIxOTk5Mzc5","avatar_url":"https://avatars.githubusercontent.com/u/21999379?v=4","gravatar_id":"","url":"https://api.github.com/users/lawnjelly","html_url":"https://github.com/lawnjelly","followers_url":"https://api.github.com/users/lawnjelly/followers","following_url":"https://api.github.com/users/lawnjelly/following{/other_user}","gists_url":"https://api.github.com/users/lawnjelly/gists{/gist_id}","starred_url":"https://api.github.com/users/lawnjelly/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/lawnjelly/subscriptions","organizations_url":"https://api.github.com/users/lawnjelly/orgs","repos_url":"https://api.github.com/users/lawnjelly/repos","events_url":"https://api.github.com/users/lawnjelly/events{/privacy}","received_events_url":"https://api.github.com/users/lawnjelly/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-01-03T13:14:09Z","updated_at":"2025-01-03T13:44:11Z","body":"Actually I wrote all that, but I think I was getting my wires crossed on a previous similar issue (it was from 3 years ago :grin: ), and I'm not super familiar with this function in Godot sorry for any confusion. :blush: ","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2569205488/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2726533175","html_url":"https://github.com/godotengine/godot/pull/100991#issuecomment-2726533175","issue_url":"https://api.github.com/repos/godotengine/godot/issues/100991","id":2726533175,"node_id":"IC_kwDOAO6SJc6ig5g3","user":{"login":"Mickeon","id":66727710,"node_id":"MDQ6VXNlcjY2NzI3NzEw","avatar_url":"https://avatars.githubusercontent.com/u/66727710?v=4","gravatar_id":"","url":"https://api.github.com/users/Mickeon","html_url":"https://github.com/Mickeon","followers_url":"https://api.github.com/users/Mickeon/followers","following_url":"https://api.github.com/users/Mickeon/following{/other_user}","gists_url":"https://api.github.com/users/Mickeon/gists{/gist_id}","starred_url":"https://api.github.com/users/Mickeon/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Mickeon/subscriptions","organizations_url":"https://api.github.com/users/Mickeon/orgs","repos_url":"https://api.github.com/users/Mickeon/repos","events_url":"https://api.github.com/users/Mickeon/events{/privacy}","received_events_url":"https://api.github.com/users/Mickeon/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-03-15T12:54:05Z","updated_at":"2025-03-15T12:54:05Z","body":"In the process of rebasing https://github.com/godotengine/godot/pull/87440, it is my understanding that the following is particularly misleading?\r\n\r\n> The [param target] and the [param up] cannot be [constant Vector3.ZERO], and shouldn't be colinear to avoid unintended rotation around local Z axis.\r\n\r\nFirst of all, it's \"_collinear_\".\r\nSecond, from what I can see, the original sentence was fine, as this is just a more mathematical way of saying \"parallel to one other (regardless of direction)\". There's little mentions of collinearity across all of Godot and doing it here makes it look more complicated than it is in practice.\r\nThird, it's wrong, I think? `target` is a position vector and `up` is a direction vector. The **Node3D** version of the same method got this right:\r\n> \"and the direction from the node's position to the [param target] vector cannot be parallel to the [param up] vector.\"\r\n\r\nProbably someone fixed this in the past, but it was not fixed in the other descriptions. This PR homogenised the inaccurate description.","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2726533175/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2726540526","html_url":"https://github.com/godotengine/godot/pull/100991#issuecomment-2726540526","issue_url":"https://api.github.com/repos/godotengine/godot/issues/100991","id":2726540526,"node_id":"IC_kwDOAO6SJc6ig7Tu","user":{"login":"aaronfranke","id":1646875,"node_id":"MDQ6VXNlcjE2NDY4NzU=","avatar_url":"https://avatars.githubusercontent.com/u/1646875?v=4","gravatar_id":"","url":"https://api.github.com/users/aaronfranke","html_url":"https://github.com/aaronfranke","followers_url":"https://api.github.com/users/aaronfranke/followers","following_url":"https://api.github.com/users/aaronfranke/following{/other_user}","gists_url":"https://api.github.com/users/aaronfranke/gists{/gist_id}","starred_url":"https://api.github.com/users/aaronfranke/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/aaronfranke/subscriptions","organizations_url":"https://api.github.com/users/aaronfranke/orgs","repos_url":"https://api.github.com/users/aaronfranke/repos","events_url":"https://api.github.com/users/aaronfranke/events{/privacy}","received_events_url":"https://api.github.com/users/aaronfranke/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-03-15T13:10:04Z","updated_at":"2025-03-15T13:10:04Z","body":"@Mickeon Correct, so for the Basis method, it makes more sense say the direction from the origin to the target should not be parallel to the up vector. That way we are talking about these vectors as both being lines, and we talk about them being parallel. The word collinear implies working with points, but 2 points always form a line.","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2726540526/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null}]