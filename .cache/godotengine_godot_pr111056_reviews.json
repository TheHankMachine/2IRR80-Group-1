0/following{/other_user}","gists_url":"https://api.github.com/users/j20001970/gists{/gist_id}","starred_url":"https://api.github.com/users/j20001970/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/j20001970/subscriptions","organizations_url":"https://api.github.com/users/j20001970/orgs","repos_url":"https://api.github.com/users/j20001970/repos","events_url":"https://api.github.com/users/j20001970/events{/privacy}","received_events_url":"https://api.github.com/users/j20001970/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"","state":"COMMENTED","html_url":"https://github.com/godotengine/godot/pull/111056#pullrequestreview-3477646700","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/111056","author_association":"CONTRIBUTOR","_links":{"html":{"href":"https://github.com/godotengine/godot/pull/111056#pullrequestreview-3477646700"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/111056"}},"submitted_at":"2025-11-18T12:44:25Z","commit_id":null},{"id":4109665282,"node_id":"PRR_kwDOAO6SJc709IQC","user":{"login":"Calinou","id":180032,"node_id":"MDQ6VXNlcjE4MDAzMg==","avatar_url":"https://avatars.githubusercontent.com/u/180032?u=68d23e7ee9cdf810da125e8510b72f845b9dccc8&v=4","gravatar_id":"","url":"https://api.github.com/users/Calinou","html_url":"https://github.com/Calinou","followers_url":"https://api.github.com/users/Calinou/followers","following_url":"https://api.github.com/users/Calinou/following{/other_user}","gists_url":"https://api.github.com/users/Calinou/gists{/gist_id}","starred_url":"https://api.github.com/users/Calinou/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Calinou/subscriptions","organizations_url":"https://api.github.com/users/Calinou/orgs","repos_url":"https://api.github.com/users/Calinou/repos","events_url":"https://api.github.com/users/Calinou/events{/privacy}","received_events_url":"https://api.github.com/users/Calinou/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"Tested locally on Fedora 43, it mostly works as expected.\r\n\r\nSome feedback:\r\n\r\n- PipeWire appears to be used natively, according to the [above instructions](https://github.com/godotengine/godot/pull/111056#issuecomment-4074777513):\r\n\r\n```bash\r\n$ pw-dump > ~/pw-dump\r\n$ rg -i \"platformer\" pw-dump\r\n10101:        \"application.name\": \"Platformer 2D\",\r\n10168:        \"node.name\": \"Platformer 2D\",\r\n10563:        \"object.path\": \"Platformer 2D:output_0\",\r\n10565:        \"port.alias\": \"Platformer 2D:output_FL\",\r\n10648:        \"object.path\": \"Platformer 2D:output_1\",\r\n10650:        \"port.alias\": \"Platformer 2D:output_FR\",\r\n```\r\n\r\n- Audio input doesn't seem to work in the [Mic Record](https://github.com/godotengine/godot-demo-projects/tree/master/audio/mic_record) demo (nothing is recorded, and the app doesn't appear in the list of recording applications). In comparison, it works in PulseAudio (but not in ALSA).\r\n\r\n- PipeWire sounds noticeably quieter than PulseAudio/ALSA. I double-checked all audio drivers are at 100% for the per-app volume in the system settings.\r\n\r\nMusic from the Platformer 2D demo run through PulseAudio, ALSA, then PipeWire:\r\n\r\n[pulseaudio_alsa_pipewire.mp3](https://github.com/user-attachments/files/26729828/pulseaudio_alsa_pipewire.mp3)\r\n\r\nWaveform of the above audio normalized in Audacity for easier comparison (from left to right: PulseAudio, ALSA, PipeWire):\r\n\r\n<img width=\"916\" height=\"306\" alt=\"Image\" src=\"https://github.com/user-attachments/assets/6b586cfe-db38-4101-a0b9-af16f79aa8c5\" />\r\n\r\n- I haven't done latency testing since I don't have the hardware for it currently, but it would be good to investigate this in the future.","state":"COMMENTED","html_url":"https://github.com/godotengine/godot/pull/111056#pullrequestreview-4109665282","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/111056","author_association":"MEMBER","_links":{"html":{"href":"https://github.com/godotengine/godot/pull/111056#pullrequestreview-4109665282"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/111056"}},"submitted_at":"2026-04-14T22:45:12Z","commit_id":"719f2325fa155029961dd89b2c280f9876441184"},{"id":4114470065,"node_id":"PRR_kwDOAO6SJc71PdSx","user":{"login":"Calinou","id":180032,"node_id":"MDQ6VXNlcjE4MDAzMg==","avatar_url":"https://avatars.githubusercontent.com/u/180032?u=68d23e7ee9cdf810da125e8510b72f845b9dccc8&v=4","gravatar_id":"","url":"https://api.github.com/users/Calinou","html_url":"https://github.com/Calinou","followers_url":"https://api.github.com/users/Calinou/followers","following_url":"https://api.github.com/users/Calinou/following{/other_user}","gists_url":"https://api.github.com/users/Calinou/gists{/gist_id}","starred_url":"https://api.github.com/users/Calinou/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Calinou/subscriptions","organizations_url":"https://api.github.com/users/Calinou/orgs","repos_url":"https://api.github.com/users/Calinou/repos","events_url":"https://api.github.com/users/Calinou/events{/privacy}","received_events_url":"https://api.github.com/users/Calinou/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"Audio input works on my end now. Code looks good to me.\n\nI can still reproduce the different volume on PipeWire, but as per the above comment, it's likely system-specific. I consider this PR good on my end, but I still would like it to get testing on more configurations (especially 3.1/5.1/7.1 for people who have access to such a setup).\n\nNote that this PR uses C++20 features (designated initializers), but we considered this to be acceptable in Wayland code as it's only compiled on Linux/*BSD. Similarly, the PipeWire audio driver is Linux/*BSD-only code.","state":"APPROVED","html_url":"https://githu