jMxNzI=","avatar_url":"https://avatars.githubusercontent.com/u/2223172?v=4","gravatar_id":"","url":"https://api.github.com/users/KoBeWi","html_url":"https://github.com/KoBeWi","followers_url":"https://api.github.com/users/KoBeWi/followers","following_url":"https://api.github.com/users/KoBeWi/following{/other_user}","gists_url":"https://api.github.com/users/KoBeWi/gists{/gist_id}","starred_url":"https://api.github.com/users/KoBeWi/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/KoBeWi/subscriptions","organizations_url":"https://api.github.com/users/KoBeWi/orgs","repos_url":"https://api.github.com/users/KoBeWi/repos","events_url":"https://api.github.com/users/KoBeWi/events{/privacy}","received_events_url":"https://api.github.com/users/KoBeWi/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-12-17T19:40:23Z","updated_at":"2025-12-17T19:49:12Z","body":"Sooo aside from the main fix, #112830 included some drawing changes that have caused the regression.\nHOWEVER reverting these changes causes another issue: there is some margin at the top of the Tree that may appear depending on scroll value.\n\nhttps://github.com/user-attachments/assets/58c386d0-eb28-4b43-9442-a4cef32e775f\n\nNote that there is the same margin problem at the bottom and that PR did not fix it.\n\nI think we can revert the visual changes, the margin is not that bad compared to the current issue. Though ideally we should fix both issues, but good luck with that.\n\nEDIT:\nI opened a separate issue: #114123","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3666872439/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3667068640","html_url":"https://github.com/godotengine/godot/issues/114117#issuecomment-3667068640","issue_url":"https://api.github.com/repos/godotengine/godot/issues/114117","id":3667068640,"node_id":"IC_kwDOAO6SJc7akwbg","user":{"login":"BrotherShort","id":129957860,"node_id":"U_kgDOB77_5A","avatar_url":"https://avatars.githubusercontent.com/u/129957860?v=4","gravatar_id":"","url":"https://api.github.com/users/BrotherShort","html_url":"https://github.com/BrotherShort","followers_url":"https://api.github.com/users/BrotherShort/followers","following_url":"https://api.github.com/users/BrotherShort/following{/other_user}","gists_url":"https://api.github.com/users/BrotherShort/gists{/gist_id}","starred_url":"https://api.github.com/users/BrotherShort/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/BrotherShort/subscriptions","organizations_url":"https://api.github.com/users/BrotherShort/orgs","repos_url":"https://api.github.com/users/BrotherShort/repos","events_url":"https://api.github.com/users/BrotherShort/events{/privacy}","received_events_url":"https://api.github.com/users/BrotherShort/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-12-17T20:38:54Z","updated_at":"2025-12-17T20:38:54Z","body":"This is not a new issue.\n\nThis is v4.6beta game:\n\n![Image](https://github.com/user-attachments/assets/21956f9c-483b-47a4-846c-a2f80646443a)\n\nThe text and the arrow disappears in the middle of the title, but the line not.\n\nThis is v4.6beta editor ***classic*** theme \"Input Map\":\n\n![Image](https://github.com/user-attachments/assets/de3711f4-0cb6-444e-8001-05cc02d44351)\n\nThe text, the icon and the arrow disappears in the middle of the title, but the line not. The line is displayed in the margin:\n\n<img width=\"1273\" height=\"743\" alt=\"Image\" src=\"https://github.com/user-attachments/assets/edbca603-8af9-4260-8be0-be5cd82f26eb\" />\n\nv4.6beta editor ***modern*** theme \"Input Map\" do not display tree lines, so no one is displayed in the margin:\n\n<img width=\"1193\" height=\"693\" alt=\"Image\" src=\"https://github.com/user-attachments/assets/9dac5a9e-7b5b-4fc3-add3-0931d023d5b9\" />\n\nAfter my PR, the text, the icon, the arrow and the line are displayed at all positions.\nThis is current version game:\n\n![Image](https://github.com/user-attachments/assets/7d4415b6-3064-4840-b3a1-302fde26196f)\n\nI think the interaction logic is consistent.\n\nMaybe you want the treeitem disappear behind the title.\n\nI said in https://github.com/godotengine/godot/issues/112829#issuecomment-3536884471 :\n\n>  We have 2 ways to solve the issue.\n> 1: TreeItems in edge are both displayed and clickable.\n> 2: TreeItems in edge are neither displayed nor clickable.\n> I finished the 1st at https://github.com/godotengine/godot/pull/112830.\n> Why do I choose the 1st way?\n> In common GUI frameworks, Items would not be displayed or clicked in edges. But in godot GUI, it's hard to implement the feature. We have to create new functions which compute how to display a partial icon.\n> So I support TreeItems in edge could be displayed and clicked. It is self-consistent, simple and requires fewer changes.\n> \n\nThe feature you want is more difficult to implement.","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3667068640/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3667075434","html_url":"https://github.com/godotengine/godot/issues/114117#issuecomment-3667075434","issue_url":"https://api.github.com/repos/godotengine/godot/issues/114117","id":3667075434,"node_id":"IC_kwDOAO6SJc7akyFq","user":{"login":"KoBeWi","id":2223172,"node_id":"MDQ6VXNlcjIyMjMxNzI=","avatar_url":"https://avatars.githubusercontent.com/u/2223172?v=4","gravatar_id":"","url":"https://api.github.com/users/KoBeWi","html_url":