ousandShips/orgs","repos_url":"https://api.github.com/users/AThousandShips/repos","events_url":"https://api.github.com/users/AThousandShips/events{/privacy}","received_events_url":"https://api.github.com/users/AThousandShips/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-06-19T11:22:51Z","updated_at":"2026-06-19T11:31:00Z","body":"To make it conditional would be the most obvious choice, add a default argument instead","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4751062096/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4751194901","html_url":"https://github.com/godotengine/godot/pull/116271#issuecomment-4751194901","issue_url":"https://api.github.com/repos/godotengine/godot/issues/116271","id":4751194901,"node_id":"IC_kwDOAO6SJc8AAAABGzF7FQ","user":{"login":"Mickeon","id":66727710,"node_id":"MDQ6VXNlcjY2NzI3NzEw","avatar_url":"https://avatars.githubusercontent.com/u/66727710?v=4","gravatar_id":"","url":"https://api.github.com/users/Mickeon","html_url":"https://github.com/Mickeon","followers_url":"https://api.github.com/users/Mickeon/followers","following_url":"https://api.github.com/users/Mickeon/following{/other_user}","gists_url":"https://api.github.com/users/Mickeon/gists{/gist_id}","starred_url":"https://api.github.com/users/Mickeon/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Mickeon/subscriptions","organizations_url":"https://api.github.com/users/Mickeon/orgs","repos_url":"https://api.github.com/users/Mickeon/repos","events_url":"https://api.github.com/users/Mickeon/events{/privacy}","received_events_url":"https://api.github.com/users/Mickeon/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-06-19T11:38:44Z","updated_at":"2026-06-19T11:38:44Z","body":"I don't know if OP is still active but this PR is doing two things, and I'm not sure it's ideal because they both demand different discussions. \r\nThat's to say, a new `Array.pop_random` is one thing, and passing a custom RNG to `Array.pick_random` is another thing.\r\nYes, I am aware the original proposal asks for both at once, but one thing is _asking_ and the other is getting to the nitty gritty implementation details.\r\n- For example, it could be argued that a \"custom\" `pick_random` could also reside in **RandomNumberGenerator**, for reasons similar to https://github.com/godotengine/godot-proposals/issues/11853\r\n\r\n","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4751194901/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4751202840","html_url":"https://github.com/godotengine/godot/pull/116271#issuecomment-4751202840","issue_url":"https://api.github.com/repos/godotengine/godot/issues/116271","id":4751202840,"node_id":"IC_kwDOAO6SJc8AAAABGzGaGA","user":{"login":"AThousandShips","id":96648715,"node_id":"U_kgDOBcK-Cw","avatar_url":"https://avatars.githubusercontent.com/u/96648715?v=4","gravatar_id":"","url":"https://api.github.com/users/AThousandShips","html_url":"https://github.com/AThousandShips","followers_url":"https://api.github.com/users/AThousandShips/followers","following_url":"https://api.github.com/users/AThousandShips/following{/other_user}","gists_url":"https://api.github.com/users/AThousandShips/gists{/gist_id}","starred_url":"https://api.github.com/users/AThousandShips/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/AThousandShips/subscriptions","organizations_url":"https://api.github.com/users/AThousandShips/orgs","repos_