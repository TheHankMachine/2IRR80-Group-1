[{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2580754523","html_url":"https://github.com/godotengine/godot/pull/101356#issuecomment-2580754523","issue_url":"https://api.github.com/repos/godotengine/godot/issues/101356","id":2580754523,"node_id":"IC_kwDOAO6SJc6Z0zBb","user":{"login":"Nazarwadim","id":116561933,"node_id":"U_kgDOBvKYDQ","avatar_url":"https://avatars.githubusercontent.com/u/116561933?v=4","gravatar_id":"","url":"https://api.github.com/users/Nazarwadim","html_url":"https://github.com/Nazarwadim","followers_url":"https://api.github.com/users/Nazarwadim/followers","following_url":"https://api.github.com/users/Nazarwadim/following{/other_user}","gists_url":"https://api.github.com/users/Nazarwadim/gists{/gist_id}","starred_url":"https://api.github.com/users/Nazarwadim/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Nazarwadim/subscriptions","organizations_url":"https://api.github.com/users/Nazarwadim/orgs","repos_url":"https://api.github.com/users/Nazarwadim/repos","events_url":"https://api.github.com/users/Nazarwadim/events{/privacy}","received_events_url":"https://api.github.com/users/Nazarwadim/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-01-09T16:33:25Z","updated_at":"2025-01-09T16:33:25Z","body":"LTO does inlining, so I don't think it's necessary.","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2580754523/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2580766041","html_url":"https://github.com/godotengine/godot/pull/101356#issuecomment-2580766041","issue_url":"https://api.github.com/repos/godotengine/godot/issues/101356","id":2580766041,"node_id":"IC_kwDOAO6SJc6Z011Z","user":{"login":"Ivorforce","id":2308167,"node_id":"MDQ6VXNlcjIzMDgxNjc=","avatar_url":"https://avatars.githubusercontent.com/u/2308167?v=4","gravatar_id":"","url":"https://api.github.com/users/Ivorforce","html_url":"https://github.com/Ivorforce","followers_url":"https://api.github.com/users/Ivorforce/followers","following_url":"https://api.github.com/users/Ivorforce/following{/other_user}","gists_url":"https://api.github.com/users/Ivorforce/gists{/gist_id}","starred_url":"https://api.github.com/users/Ivorforce/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Ivorforce/subscriptions","organizations_url":"https://api.github.com/users/Ivorforce/orgs","repos_url":"https://api.github.com/users/Ivorforce/repos","events_url":"https://api.github.com/users/Ivorforce/events{/privacy}","received_events_url":"https://api.github.com/users/Ivorforce/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-01-09T16:37:07Z","updated_at":"2025-01-09T16:40:17Z","body":"> LTO does inlining, so I don't think it's necessary.\r\n\r\nmacOS, iOS, Android and MSVC builds do not have LTO enabled. Plus, by the time LTO comes around, many opportunities for optimization have already passed, so at that stage it's much less guaranteed to actually help.","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2580766041/reactions","total_count":1,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":1},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2580864746","html_url":"https://github.com/godotengine/godot/pull/101356#issuecomment-2580864746","issue_url":"https://api.github.com/repos/godotengine/godot/issues/101356","id":2580864746,"node_id":"IC_kwDOAO6SJc6Z1N7q","user":{"login":"Nazarwadim","id":116561933,"node_id":"U_kgDOBvKYDQ","avatar_url":"https://avatars.githubusercontent.com/u/116561933?v=4","gravatar_id":"","url":"https://api.github.com/users/Nazarwadim","html_url":"https://github.com/Nazarwadim","followers_url":"https://api.github.com/users/Nazarwadim/followers","following_url":"https://api.github.com/users/Nazarwadim/following{/other_user}","gists_url":"https://api.github.com/users/Nazarwadim/gists{/gist_id}","starred_url":"https://api.github.com/users/Nazarwadim/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Nazarwadim/subscriptions","organizations_url":"https://api.github.com/users/Nazarwadim/orgs","repos_url":"https://api.github.com/users/Nazarwadim/repos","events_url":"https://api.github.com/users/Nazarwadim/events{/privacy}","received_events_url":"https://api.github.com/users/Nazarwadim/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-01-09T17:22:14Z","updated_at":"2025-01-09T17:22:14Z","body":"> macOS, iOS, Android and MSVC builds do not have LTO enabled. Plus, by the time LTO comes around, many opportunities for optimization have already passed, so at that stage it's much less guaranteed to actually help.\r\n\r\nLTO can be used on these platforms.\r\nmacOS, iOS, Android LTO is available through Clang.\r\nMSVC has Link Time Code Generation. I don't know if Godot uses it, but it definitely exists.\r\n\r\n> Plus, by the time LTO comes around, many opportunities for optimization have already passed\r\n\r\nI previously used `_FORCE_INLINE_` for Vector2 #88935 and godot benchmarks on LTO builds only showed performance degradation due to increased binary size -> more cache misses.\r\n\r\nI also ran micro benchmarks with LTO and the linker optimized it at the same level.","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2580864746/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2580887453","html_url":"https://github.com/godotengine/godot/pull/101356#issuecomment-2580887453","issue_url":"https://api.github.com/repos/godotengine/godot/issues/101356","id":2580887453,"node_id":"IC_kwDOAO6SJc6Z1Ted","user":{"login":"Ivorforce","id":2308167,"node_id":"MDQ6VXNlcjIzMDgxNjc=","avatar_url":"https://avatars.githubusercontent.com/u/2308167?v=4","gravatar_id":"","url":"https://api.github.com/users/Ivorforce","html_url":"https://github.com/Ivorforce","followers_url":"https://api.github.com/users/Ivorforce/followers","following_url":"https://api.github.com/users/Ivorforce/following{/other_user}","gists_url":"https://api.github.com/users/Ivorforce/gists{/gist_id}","starred_url":"https://api.github.com/users/Ivorforce/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Ivorforce/subscriptions","organizations_url":"https://api.github.com/users/Ivorforce/orgs","repos_url":"https://api.github.com/users/Ivorforce/repos","events_url":"https://api.github.com/users/Ivorforce/events{/privacy}","received_events_url":"https://api.github.com/users/Ivorforce/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-01-09T17:32:17Z","updated_at":"2025-01-09T17:41:23Z","body":"> LTO can be used on these platforms. macOS, iOS, Android LTO is available through Clang. MSVC has Link Time Code Generation. I don't know if Godot uses it, but it definitely exists.\r\n\r\nThis discussion is outside the scope of this PR. I do agree that checking whether LTO should be enabled on other platforms might be warranted. Feel free to make a godot-proposal for this. I can point you in the right direction - searching for `env[\"lto\"] = \"none\"` should get you to all 4 spots it's been explicitly disabled.\r\n\r\n> I previously used `_FORCE_INLINE_` for Vector2 #88935 and godot benchmarks on LTO builds only showed performance degradation due to increased binary size -> more cache misses.\r\n\r\nFor most situations, adding or removing `_FORCE_INLINE_` should not result in observable changes in performance. It's a micro optimization that should only be considered for the most extreme of cases. How cache misses in unrelated spots due to overwrites will affect the final performance of a binary is extremely hard to measure. More likely, you'll make mistakes in your setup than measure something meaningful.\r\n\r\n> I also ran micro benchmarks with LTO and the linker optimized it at the same level.\r\n\r\nI suppose this is expected in most situations, but again - by LTO time, a lot of opportunities for optimizations have passed. Even if the functions were compiled to the same binary in some situations, it may unexpectedly affect others. LTO is not a 'it behaves as though both are the same module' drop-in thing.","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2580887453/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2581075832","html_url":"https://github.com/godotengine/godot/pull/101356#issuecomment-2581075832","issue_url":"https://api.github.com/repos/godotengine/godot/issues/101356","id":2581075832,"node_id":"IC_kwDOAO6SJc6Z2Bd4","user":{"login":"Nazarwadim","id":116561933,"node_id":"U_kgDOBvKYDQ","avatar_url":"https://avatars.githubusercontent.com/u/116561933?v=4","gravatar_id":"","url":"https://api.github.com/users/Nazarwadim","html_url":"https://github.com/Nazarwadim","followers_url":"https://api.github.com/users/Nazarwadim/followers","following_url":"https://api.github.com/users/Nazarwadim/following{/other_user}","gists_url":"https://api.github.com/users/Nazarwadim/gists{/gist_id}","starred_url":"https://api.github.com/users/Nazarwadim/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Nazarwadim/subscriptions","organizations_url":"https://api.github.com/users/Nazarwadim/orgs","repos_url":"https://api.github.com/users/Nazarwadim/repos","events_url":"https://api.github.com/users/Nazarwadim/events{/privacy}","received_events_url":"https://api.github.com/users/Nazarwadim/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-01-09T19:18:39Z","updated_at":"2025-01-09T19:18:39Z","body":"Hah, I don't want to get into all this micro-optimization.\r\n\r\nBut maybe you didn't look well. \r\nLTO is disabled by default and enabled when we gave lto=full/thin.\r\nhttps://github.com/godotengine/godot/blob/0257995616a0afa9686ddca40f2e858c341b8256/platform/ios/detect.py#L68-L77\r\n\r\nIn general, I'm against these inlines because they increase compile time and are almost useless since LTO already does it.","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2581075832/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2581086987","html_url":"https://github.com/godotengine/godot/pull/101356#issuecomment-2581086987","issue_url":"https://api.github.com/repos/godotengine/godot/issues/101356","id":2581086987,"node_id":"IC_kwDOAO6SJc6Z2EML","user":{"login":"Ivorforce","id":2308167,"node_id":"MDQ6VXNlcjIzMDgxNjc=","avatar_url":"https://avatars.githubusercontent.com/u/2308167?v=4","gravatar_id":"","url":"https://api.github.com/users/Ivorforce","html_url":"https://github.com/Ivorforce","followers_url":"https://api.github.com/users/Ivorforce/followers","following_url":"https://api.github.com/users/Ivorforce/following{/other_user}","gists_url":"https://api.github.com/users/Ivorforce/gists{/gist_id}","starred_url":"https://api.github.com/users/Ivorforce/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Ivorforce/subscriptions","organizations_url":"https://api.github.com/users/Ivorforce/orgs","repos_url":"https://api.github.com/users/Ivorforce/repos","events_url":"https://api.github.com/users/Ivorforce/events{/privacy}","received_events_url":"https://api.github.com/users/Ivorforce/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-01-09T19:25:07Z","updated_at":"2025-01-09T19:25:07Z","body":"> LTO is disabled by default and enabled when we gave lto=full/thin.\n\nSure, but afaik this is not performed in official builds :)\n\n> In general, I'm against these inlines because they increase compile time and are almost useless since LTO already does it.\n\nIf LTO inlines anyway then forcing or encouraging an inline won't affect compile time.","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2581086987/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2581101205","html_url":"https://github.com/godotengine/godot/pull/101356#issuecomment-2581101205","issue_url":"https://api.github.com/repos/godotengine/godot/issues/101356","id":2581101205,"node_id":"IC_kwDOAO6SJc6Z2HqV","user":{"login":"Nazarwadim","id":116561933,"node_id":"U_kgDOBvKYDQ","avatar_url":"https://avatars.githubusercontent.com/u/116561933?v=4","gravatar_id":"","url":"https://api.github.com/users/Nazarwadim","html_url":"https://github.com/Nazarwadim","followers_url":"https://api.github.com/users/Nazarwadim/followers","following_url":"https://api.github.com/users/Nazarwadim/following{/other_user}","gists_url":"https://api.github.com/users/Nazarwadim/gists{/gist_id}","starred_url":"https://api.github.com/users/Nazarwadim/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Nazarwadim/subscriptions","organizations_url":"https://api.github.com/users/Nazarwadim/orgs","repos_url":"https://api.github.com/users/Nazarwadim/repos","events_url":"https://api.github.com/users/Nazarwadim/events{/privacy}","received_events_url":"https://api.github.com/users/Nazarwadim/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-01-09T19:33:49Z","updated_at":"2025-01-09T19:33:49Z","body":"> Sure, but afaik this is not performed in official builds :)\r\n\r\nAh. Now I see it here.\r\nhttps://github.com/godotengine/godot-build-scripts/blob/e7210ecc92b17f38b4a607b755cb01576bd95f79/build-ios/build.sh#L8","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2581101205/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2581116117","html_url":"https://github.com/godotengine/godot/pull/101356#issuecomment-2581116117","issue_url":"https://api.github.com/repos/godotengine/godot/issues/101356","id":2581116117,"node_id":"IC_kwDOAO6SJc6Z2LTV","user":{"login":"Nazarwadim","id":116561933,"node_id":"U_kgDOBvKYDQ","avatar_url":"https://avatars.githubusercontent.com/u/116561933?v=4","gravatar_id":"","url":"https://api.github.com/users/Nazarwadim","html_url":"https://github.com/Nazarwadim","followers_url":"https://api.github.com/users/Nazarwadim/followers","following_url":"https://api.github.com/users/Nazarwadim/following{/other_user}","gists_url":"https://api.github.com/users/Nazarwadim/gists{/gist_id}","starred_url":"https://api.github.com/users/Nazarwadim/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Nazarwadim/subscriptions","organizations_url":"https://api.github.com/users/Nazarwadim/orgs","repos_url":"https://api.github.com/users/Nazarwadim/repos","events_url":"https://api.github.com/users/Nazarwadim/events{/privacy}","received_events_url":"https://api.github.com/users/Nazarwadim/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-01-09T19:43:09Z","updated_at":"2025-01-09T19:43:09Z","body":"> If LTO inlines anyway then forcing or encouraging an inline won't affect compile time.\r\n\r\nI mean most builds are done without LTO to see if everything works, run unit tests and check for regressions.","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2581116117/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2581126097","html_url":"https://github.com/godotengine/godot/pull/101356#issuecomment-2581126097","issue_url":"https://api.github.com/repos/godotengine/godot/issues/101356","id":2581126097,"node_id":"IC_kwDOAO6SJc6Z2NvR","user":{"login":"akien-mga","id":4701338,"node_id":"MDQ6VXNlcjQ3MDEzMzg=","avatar_url":"https://avatars.githubusercontent.com/u/4701338?v=4","gravatar_id":"","url":"https://api.github.com/users/akien-mga","html_url":"https://github.com/akien-mga","followers_url":"https://api.github.com/users/akien-mga/followers","following_url":"https://api.github.com/users/akien-mga/following{/other_user}","gists_url":"https://api.github.com/users/akien-mga/gists{/gist_id}","starred_url":"https://api.github.com/users/akien-mga/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/akien-mga/subscriptions","organizations_url":"https://api.github.com/users/akien-mga/orgs","repos_url":"https://api.github.com/users/akien-mga/repos","events_url":"https://api.github.com/users/akien-mga/events{/privacy}","received_events_url":"https://api.github.com/users/akien-mga/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-01-09T19:48:40Z","updated_at":"2025-01-09T19:48:40Z","body":"Just to be clear, official builds are made with `production=yes`, so whether or not LTO is used depends on how `lto=auto` is treated in each platform.\r\n\r\nDepending on the platform and compiler we have mixed results with LTO, where it seems to be quite beneficial with GCC (increases performance *and* reduces binary size) while it's less clear cut with Clang (increases performance but also increases size significantly with heavy inlining, and Clang full LTO is egregiously slow - no parallel linking - while its ThinLTO makes binaries even bigger), and it's seamingly unusable with MSVC LTCG.\r\n\r\nSee #96785 and #96851.","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2581126097/reactions","total_count":2,"+1":2,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2715795754","html_url":"https://github.com/godotengine/godot/pull/101356#issuecomment-2715795754","issue_url":"https://api.github.com/repos/godotengine/godot/issues/101356","id":2715795754,"node_id":"IC_kwDOAO6SJc6h38Eq","user":{"login":"Ivorforce","id":2308167,"node_id":"MDQ6VXNlcjIzMDgxNjc=","avatar_url":"https://avatars.githubusercontent.com/u/2308167?v=4","gravatar_id":"","url":"https://api.github.com/users/Ivorforce","html_url":"https://github.com/Ivorforce","followers_url":"https://api.github.com/users/Ivorforce/followers","following_url":"https://api.github.com/users/Ivorforce/following{/other_user}","gists_url":"https://api.github.com/users/Ivorforce/gists{/gist_id}","starred_url":"https://api.github.com/users/Ivorforce/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Ivorforce/subscriptions","organizations_url":"https://api.github.com/users/Ivorforce/orgs","repos_url":"https://api.github.com/users/Ivorforce/repos","events_url":"https://api.github.com/users/Ivorforce/events{/privacy}","received_events_url":"https://api.github.com/users/Ivorforce/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-03-11T21:58:31Z","updated_at":"2025-05-06T15:18:04Z","body":"> Binary size for a Linux x86_64 stripped optimized build (`production=yes lto=full`) goes up by 8 KB for the editor, 4 KB for a release export template.\r\n\r\nThat's odd, I wonder where that's coming from.\r\nTo be honest, I'd expect neither an observable speed up nor a binary size increase.\r\n\r\nI would expect the functions to get inlined, `String` being initialized to 00 (`nullptr`), and a function call to be made. Since the previous version was basically the same (allocate String, call function), it shouldn't bring any size increases (and I'd expect the speed up to be negligible). \r\n\r\nPerhaps it's a bunch of domino effects adding up to the difference? 🤔\r\nI may investigate this as a follow up. Thanks for testing!\r\n\r\nEdit: I recreated this locally. Seems like this PR is 13kb larger than master for me (macos, with debug symbols enabled in `-O2`). They measure at about the same speed for me (with `master` possibly being faster by 0.5%).\r\nFor me, it still makes sense to merge, because compilers can be finnicky with small numbers, and possibly there's stuff going on behind the scenes that affect the outcome unexpectedly. I'd love to know what it is, but i don't know the proper tools to dissect it.\r\n\r\nEdit 2: I've gotten wiser since saying this; compilers fluctuate with stuff like this all the time due to inlining. Probably negligible change.","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2715795754/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2859647515","html_url":"https://github.com/godotengine/godot/pull/101356#issuecomment-2859647515","issue_url":"https://api.github.com/repos/godotengine/godot/issues/101356","id":2859647515,"node_id":"IC_kwDOAO6SJc6qcsIb","user":{"login":"Repiteo","id":17489292,"node_id":"MDQ6VXNlcjE3NDg5Mjky","avatar_url":"https://avatars.githubusercontent.com/u/17489292?v=4","gravatar_id":"","url":"https://api.github.com/users/Repiteo","html_url":"https://github.com/Repiteo","followers_url":"https://api.github.com/users/Repiteo/followers","following_url":"https://api.github.com/users/Repiteo/following{/other_user}","gists_url":"https://api.github.com/users/Repiteo/gists{/gist_id}","starred_url":"https://api.github.com/users/Repiteo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Repiteo/subscriptions","organizations_url":"https://api.github.com/users/Repiteo/orgs","repos_url":"https://api.github.com/users/Repiteo/repos","events_url":"https://api.github.com/users/Repiteo/events{/privacy}","received_events_url":"https://api.github.com/users/Repiteo/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-05-07T17:57:09Z","updated_at":"2025-05-07T17:57:09Z","body":"Oop, another rebase snipe. The vulkan changes are literally the only difference though, so this is functionally merged; I'll close this and we'll just pretend really hard that it was merged instead","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2859647515/reactions","total_count":2,"+1":0,"-1":0,"laugh":2,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null}]