ived_at":null,"archived_by":null},{"id":1332303119,"node_id":"MDU6TGFiZWwxMzMyMzAzMTE5","url":"https://api.github.com/repos/godotengine/godot/labels/regression","name":"regression","color":"ff63ac","default":false,"description":"","archived_at":null,"archived_by":null},{"id":2666708289,"node_id":"MDU6TGFiZWwyNjY2NzA4Mjg5","url":"https://api.github.com/repos/godotengine/godot/labels/topic:3d","name":"topic:3d","color":"ffee88","default":false,"description":"","archived_at":null,"archived_by":null}],"state":"closed","locked":false,"assignees":[],"milestone":{"url":"https://api.github.com/repos/godotengine/godot/milestones/25","html_url":"https://github.com/godotengine/godot/milestone/25","labels_url":"https://api.github.com/repos/godotengine/godot/milestones/25/labels","id":15520464,"node_id":"MI_kwDOAO6SJc4A7NLQ","number":25,"title":"4.8","description":"","creator":{"login":"Repiteo","id":17489292,"node_id":"MDQ6VXNlcjE3NDg5Mjky","avatar_url":"https://avatars.githubusercontent.com/u/17489292?v=4","gravatar_id":"","url":"https://api.github.com/users/Repiteo","html_url":"https://github.com/Repiteo","followers_url":"https://api.github.com/users/Repiteo/followers","following_url":"https://api.github.com/users/Repiteo/following{/other_user}","gists_url":"https://api.github.com/users/Repiteo/gists{/gist_id}","starred_url":"https://api.github.com/users/Repiteo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Repiteo/subscriptions","organizations_url":"https://api.github.com/users/Repiteo/orgs","repos_url":"https://api.github.com/users/Repiteo/repos","events_url":"https://api.github.com/users/Repiteo/events{/privacy}","received_events_url":"https://api.github.com/users/Repiteo/received_events","type":"User","user_view_type":"public","site_admin":false},"open_issues":343,"closed_issues":2335,"state":"open","created_at":"2026-04-13T15:59:35Z","updated_at":"2026-10-22T06:28:22Z","due_on":null,"closed_at":null},"comments":3,"created_at":"2026-06-25T23:27:58Z","updated_at":"2026-07-25T18:38:18Z","closed_at":"2026-06-26T13:55:22Z","assignee":null,"author_association":"MEMBER","issue_field_values":[],"type":null,"active_lock_reason":null,"draft":false,"pull_request":{"url":"https://api.github.com/repos/godotengine/godot/pulls/120651","html_url":"https://github.com/godotengine/godot/pull/120651","diff_url":"https://github.com/godotengine/godot/pull/120651.diff","patch_url":"https://github.com/godotengine/godot/pull/120651.patch","merged_at":"2026-06-26T13:55:22Z"},"body":"## What problem(s) does this PR solve?\r\n\r\nFixes a regression caused by PR #114354\r\n\r\n## Additional information\r\n\r\nThe `duplicate()` function does not copy over the name, so the names of compressed images were being set to an empty string. In a test glTF file I was exporting, I had 5 compressed images, and all of them were being saved to `\"textures/.png\"`, overwriting each other, meaning that the model was broken.\r\n\r\nThis regression only produces visually incorrect results if both of these are the case:\r\n- You have multiple compressed images in your scene.\r\n- You are exporting a text-based `.gltf`so that the image files get saved to disk separately (if they get encoded into buffer views then the image data is preserved).\r\n\r\nBut the regression affects all exports, because the names of compressed images will be wrong.\r\n\r\nThe fix is simple: Read the name before duplicating.\r\n\r\nAlso, this PR adds a comment and a check to ensure that a name is set.\r\n","closed_by":{"login":"Repiteo","id":17489292,"node_id":"MDQ6VXNlcjE3NDg5Mjky","avatar_url":"https://avatars.githubusercontent.com/u/17489292?v=4","gravatar_id":"","url":"https://api.github.com/users/Repiteo","html_url":"https://github.com/Repiteo","followers_url":"https://api.github.com/users/Repiteo/followers","following_url":"https://api.github.com/users/Repiteo/following{/other_user}","gists_url":"https://api.github.com/users/Repiteo/gists{/gist_id}","starred_url":"https://api.github.com/users/Repiteo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Repiteo/subscriptions","organizations_url":"https://api.github.com/users/Repiteo/orgs","repos_url":"https://api.github.com/users/Repiteo/repos","events_url":"https://api.github.com/users/Repiteo/events{/privacy}","received_events_url":"https://api.github.com/users/Repiteo/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/120651/reactions","total_count":2,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":1},"timeline_url":"https://api.github.com/repos/godotengine/godot/issues/120651/timeline","performed_via_github_app":null,"state_reason":null}