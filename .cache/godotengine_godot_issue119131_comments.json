thub.com/users/KoBeWi/following{/other_user}","gists_url":"https://api.github.com/users/KoBeWi/gists{/gist_id}","starred_url":"https://api.github.com/users/KoBeWi/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/KoBeWi/subscriptions","organizations_url":"https://api.github.com/users/KoBeWi/orgs","repos_url":"https://api.github.com/users/KoBeWi/repos","events_url":"https://api.github.com/users/KoBeWi/events{/privacy}","received_events_url":"https://api.github.com/users/KoBeWi/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-05-03T15:38:36Z","updated_at":"2026-05-03T15:38:36Z","body":"I can still reproduce the bug with that PR reverted. I don't see how is it related.","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4366534067/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4371475087","html_url":"https://github.com/godotengine/godot/issues/119131#issuecomment-4371475087","issue_url":"https://api.github.com/repos/godotengine/godot/issues/119131","id":4371475087,"node_id":"IC_kwDOAO6SJc8AAAABBI9qjw","user":{"login":"rsubtil","id":6501975,"node_id":"MDQ6VXNlcjY1MDE5NzU=","avatar_url":"https://avatars.githubusercontent.com/u/6501975?v=4","gravatar_id":"","url":"https://api.github.com/users/rsubtil","html_url":"https://github.com/rsubtil","followers_url":"https://api.github.com/users/rsubtil/followers","following_url":"https://api.github.com/users/rsubtil/following{/other_user}","gists_url":"https://api.github.com/users/rsubtil/gists{/gist_id}","starred_url":"https://api.github.com/users/rsubtil/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/rsubtil/subscriptions","organizations_url":"https://api.github.com/users/rsubtil/orgs","repos_url":"https://api.github.com/users/rsubtil/repos","events_url":"https://api.github.com/users/rsubtil/events{/privacy}","received_events_url":"https://api.github.com/users/rsubtil/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-05-04T13:34:09Z","updated_at":"2026-05-04T13:34:55Z","body":"That's strange indeed. I can also still reproduce the issue on `master` if I try to revert your commit. And your MR indeed does not look related to this at all\n\nYesterday I tested the commit immediately before the merge (aka fe31ede42d3fc63bc61aa6cf6ea9ce6185bda70a), and the issue was not occurring. I tried to replicate it today, but now the issue also happens on the previous commit. And replicating the MRP from scratch on every new experiment doesn't help either.\n\nThis feels like some weird undefined behavior; whenever I re-add the `\"doubleSided\":true` property back to the GLTF file, Godot reloads the model correctly, as if the lack of this property meant it was using some unitialized values. I'll try running it under ASAN to see if I can find anything else.","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4371475087/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4386684978","html_url":"https://github.com/godotengine/godot/issues/119131#issuecomment-4386684978","issue_url":"https://api.github.com/repos/godotengine/godot/issues/119131","id":4386684978,"node_id":"IC_kwDOAO6SJc8AAAABBXeAMg","user":{"login":"rsubtil","id":6501975,"node_id":"MDQ6VXNlcjY1MDE5NzU=","avatar_url":"https://avatars.githubusercontent.com/u/6501975?v=4","gravatar_id":"","url":"https://api.github.com/users/rsubtil","html_url":"https://github.com/rsubtil","followers_url":"https://api.github.com/users/rsubtil/followers","following_url":"https://api.github.com/users/rsubtil/following{/other_user}","gists_url":"https://api.github.com/users/rsubtil/gists{/gist_id}","starred_url":"https://api.github.com/users/rsubtil/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/rsubtil/subscriptions","organizations_url":"https://api.github.com/users/rsubtil/orgs","repos_url":"https://api.github.com/users/rsubtil/repos","events_url":"https://api.github.com/users/rsubtil/events{/privacy}","received_events_url":"https://api.github.com/users/rsubtil/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-05-06T09:22:15Z","updated_at":"2026-05-06T09:22:15Z","body":"Got some more details, although this is the first time I see `git bisect` giving me very confusing results.\n\nI can reproduce this bug reliably with commit b08a3d89787c142fb6449b934e90b925ab36a6de, aka the merge commit. But, I **cannot** reproduce it with 5cf9afb0c0409c1115c5b090371c6c81379315d9, aka the commit itself. b08a3d89787c142fb6449b934e90b925ab36a6de is what the bisection process reported two times, and there seems to be a time difference of ~1 month between 5cf9afb0c0409c1115c5b090371c6c81379315d9 & b08a3d89787c142fb6449b934e90b925ab36a6de, so it seems some other commit is introducing the bug, something that `git bisect` cannot catch, which is a first for me. I've also checked both commits under ASAN and could not catch any undefined behavior like I suspected initially.\n\nI'll have a closer look when I get some time again to investigate the actual cause of this bug.","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4386684978/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4412443447","html_url":"ht