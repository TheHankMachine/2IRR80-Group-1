olor":"ffee88","default":false,"description":"","archived_at":null,"archived_by":null},{"id":2666708289,"node_id":"MDU6TGFiZWwyNjY2NzA4Mjg5","url":"https://api.github.com/repos/godotengine/godot/labels/topic:3d","name":"topic:3d","color":"ffee88","default":false,"description":"","archived_at":null,"archived_by":null}],"state":"closed","locked":false,"assignees":[],"milestone":{"url":"https://api.github.com/repos/godotengine/godot/milestones/23","html_url":"https://github.com/godotengine/godot/milestone/23","labels_url":"https://api.github.com/repos/godotengine/godot/milestones/23/labels","id":12939969,"node_id":"MI_kwDOAO6SJc4AxXLB","number":23,"title":"4.6","description":"","creator":{"login":"Repiteo","id":17489292,"node_id":"MDQ6VXNlcjE3NDg5Mjky","avatar_url":"https://avatars.githubusercontent.com/u/17489292?v=4","gravatar_id":"","url":"https://api.github.com/users/Repiteo","html_url":"https://github.com/Repiteo","followers_url":"https://api.github.com/users/Repiteo/followers","following_url":"https://api.github.com/users/Repiteo/following{/other_user}","gists_url":"https://api.github.com/users/Repiteo/gists{/gist_id}","starred_url":"https://api.github.com/users/Repiteo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Repiteo/subscriptions","organizations_url":"https://api.github.com/users/Repiteo/orgs","repos_url":"https://api.github.com/users/Repiteo/repos","events_url":"https://api.github.com/users/Repiteo/events{/privacy}","received_events_url":"https://api.github.com/users/Repiteo/received_events","type":"User","user_view_type":"public","site_admin":false},"open_issues":3,"closed_issues":2978,"state":"closed","created_at":"2025-05-22T16:25:52Z","updated_at":"2026-10-04T16:23:23Z","due_on":null,"closed_at":"2026-01-26T18:09:14Z"},"comments":1,"created_at":"2025-11-03T18:50:02Z","updated_at":"2025-11-11T16:41:39Z","closed_at":"2025-11-11T16:41:02Z","assignee":null,"author_association":"NONE","issue_field_values":[],"type":null,"active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"### Tested versions\n\nReproducible in: 4.5.1.stable and 4.4.1.stable\n\n### System information\n\nGodot v4.5.1.stable - Windows 11 (build 26100) - Multi-window, 1 monitor - Vulkan (Forward+) - dedicated NVIDIA GeForce RTX 3080 (NVIDIA; 32.0.15.8157) - 12th Gen Intel(R) Core(TM) i5-12600K (16 threads) - 31.79 GiB memory\n\n### Issue description\n\nWhen moved away from the origin, a SoftBody3D's physics behaviors can change in Jolt Physics. Specifically, this behavior is either exclusive to or most easily visualized with pressurized soft bodies that have been moved a certain distance on all three axes.\n\nFor example, the soft body in this video is pressurized (20.0) and has been moved away from the origin (100, 26, -100).\n\nhttps://github.com/user-attachments/assets/15a905b2-7034-4f28-a4a3-90d799a4ced2\n\nThe sphere seemingly cannot decide if it should compress or expand, resulting in strange physics.\n\nNote that there are many different knobs to turn when it comes to SoftBody3D nodes, ranging from its own properties to the project's physics tics per second, to the mesh used. I've simply set some properties for the soft body that I felt showcased the issue well. The main thing to keep in mind is that, of all the things that can influence a soft body, position does not seem like it should be one of them at such relatively small distances. Also, while I have not tested exhaustively with double precision, it does not seem to fix the issue.\n\n### Steps to reproduce\n\nRun the attached project to see the weird physics.\n\nOptionally, you can move the objects in the scene to see that the behavior is different when nothing is changed except the position. The physics are much calmer at the origin. In fact, even if only the y axis is changed to zero, there is a very noticeable difference despite the distance to the origin not changing by very much.\n\n### Minimal reproduction project (MRP)\n\n[softbodypositionrepro.zip](https://github.com/user-attachments/files/23308868/softbodypositionrepro.zip)","closed_by":{"login":"Repiteo","id":17489292,"node_id":"MDQ6VXNlcjE3NDg5Mjky","avatar_url":"https://avatars.githubusercontent.com/u/17489292?v=4","gravatar_id":"","url":"https://api.github.com/users/Repiteo","html_url":"https://github.com/Repiteo","followers_url":"https://api.github.com/users/Repiteo/followers","following_url":"https://api.github.com/users/Repiteo/following{/other_user}","gists_url":"https://api.github.com/users/Repiteo/gists{/gist_id}","starred_url":"https://api.github.com/users/Repiteo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Repiteo/subscriptions","organizations_url":"https://api.github.com/users/Repiteo/orgs","repos_url":"https://api.github.com/users/Repiteo/repos","events_url":"https://api.github.com/users/Repiteo/events{/privacy}","received_events_url":"https://api.github.com/users/Repiteo/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/112348/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/godotengine/godot/issues/112348/timeline","performed_via_github_app":null,"state_reason":"completed","pinned_comment":null}