://github.com/user-attachments/assets/fa2ac831-3e8a-4f22-9f33-ec7bd93c76f4)\r\n\r\nThe message shouldn't be displayed in builds that have no export templates to download, as you end up with another error message afterwards (which you can't resolve by design).","html_url":"https://github.com/godotengine/godot/pull/103235#pullrequestreview-2638178674","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/103235","author_association":"MEMBER","submitted_at":"2025-02-24T19:08:14Z"},{"id":2637103623,"node_id":"PRR_kwDOAO6SJc6dLwIH","state":"COMMENTED","user":{"site_admin":false,"suspended":false,"updated_at":"0001-01-01T00:00:00Z","avatar_url":"https://avatars.githubusercontent.com/u/96648715?u=af70f5d107e9c1447f296643d5a566dab53d25e8&v=4","created_at":"0001-01-01T00:00:00Z","followers":0,"following":0,"html_url":"https://github.com/AThousandShips","id":96648715,"node_id":"U_kgDOBcK-Cw","login":"AThousandShips","type":"User","owned_private_repos":0,"public_gists":0,"public_repos":0,"total_private_repos":0,"url":"https://api.github.com/users/AThousandShips"},"body":"","html_url":"https://github.com/godotengine/godot/pull/103235#pullrequestreview-2637103623","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/103235","author_association":"MEMBER","submitted_at":"2025-02-25T12:04:34Z"},{"id":2646256903,"node_id":"PRR_kwDOAO6SJc6duq0H","state":"APPROVED","commit_id":"9cbfeff940cf131376d2c5c6f2916caf8865b23a","user":{"site_admin":false,"suspended":false,"updated_at":"0001-01-01T00:00:00Z","avatar_url":"https://avatars.githubusercontent.com/u/180032?u=68d23e7ee9cdf810da125e8510b72f845b9dccc8&v=4","created_at":"0001-01-01T00:00:00Z","followers":0,"following":0,"html_url":"https://github.com/Calinou","id":180032,"node_id":"MDQ6VXNlcjE4MDAzMg==","login":"Calinou","type":"User","owned_private_repos":0,"public_gists":0,"public_repos":0,"total_private_repos":0,"url":"https://api.github.com/users/Calinou"},"body":"Works great now :slightly_smil