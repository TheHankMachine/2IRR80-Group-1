[{"id":2811911271,"node_id":"PRR_kwDOAO6SJc6nmlxn","user":{"login":"Ivorforce","id":2308167,"node_id":"MDQ6VXNlcjIzMDgxNjc=","avatar_url":"https://avatars.githubusercontent.com/u/2308167?u=f7f8e0273f784f5ec6f6b7fe4a88d449896eb48a&v=4","gravatar_id":"","url":"https://api.github.com/users/Ivorforce","html_url":"https://github.com/Ivorforce","followers_url":"https://api.github.com/users/Ivorforce/followers","following_url":"https://api.github.com/users/Ivorforce/following{/other_user}","gists_url":"https://api.github.com/users/Ivorforce/gists{/gist_id}","starred_url":"https://api.github.com/users/Ivorforce/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Ivorforce/subscriptions","organizations_url":"https://api.github.com/users/Ivorforce/orgs","repos_url":"https://api.github.com/users/Ivorforce/repos","events_url":"https://api.github.com/users/Ivorforce/events{/privacy}","received_events_url":"https://api.github.com/users/Ivorforce/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"> In contrast to the math header, it seems that our compilation units actually handle C++ headers as drop-in replacements for their C counterparts.\r\n\r\nI guess this means the functions are also declared in global scope, not just in `std::`?\r\nThis is curious, but if it works, it works!\r\n\r\nThe warning on deprecated APIs sounds very useful to me, I was hoping for a good solution to avoid people accidentally including old C headers :)\r\n","state":"APPROVED","html_url":"https://github.com/godotengine/godot/pull/105887#pullrequestreview-2811911271","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/105887","author_association":"MEMBER","_links":{"html":{"href":"https://github.com/godotengine/godot/pull/105887#pullrequestreview-2811911271"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/105887"}},"submitted_at":"2025-05-02T12:37:11Z","commit_id":null}]