54:35Z"},"comments":24,"created_at":"2025-10-24T13:47:34Z","updated_at":"2026-02-16T16:48:44Z","closed_at":"2026-02-16T16:24:58Z","assignee":null,"author_association":"CONTRIBUTOR","issue_field_values":[],"type":null,"active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"### Tested versions\n\nGodot 4.4+\n\n### System information\n\nAny system\n\n### Issue description\n\nUnlike Godot Physics, the Jolt module does not currently support wind or gravity overrides to a [SoftBody3D](https://docs.godotengine.org/en/latest/classes/class_softbody3d.html#class-softbody3d) from an [Area3D](https://docs.godotengine.org/en/latest/classes/class_area3d.html#class-area3d).\n\nJolt internally does support detecting interactions through the `SoftBodyContactListener::OnSoftBodyContactAdded` callback. Overlapping areas can be queried through the `SoftBodyManifold::GetNumSensorContacts / GetSensorContactBodyID` interfaces.\n\nSee the example: https://github.com/jrouwe/JoltPhysics/blob/2bce8a6bdcafdf6b1140a080ebedcfbcdba74313/Samples/Tests/SoftBody/SoftBodySensorTest.cpp#L58-L68\n\nThere is already an entry point (DEBUG only) for this in the Jolt module that can be extended to keep track of which areas a soft body overlaps with:\n\nhttps://github.com/godotengine/godot/blob/084d5d407e62efcd5be9de44148c5dedce3b9386/modules/jolt_physics/spaces/jolt_contact_listener_3d.cpp#L81-L87\n\nNote: When this is fixed, also update the documentation and remove [this section](https://docs.godotengine.org/en/latest/tutorials/physics/using_jolt_physics.html#area3d-and-softbody3d).\n\n### Steps to reproduce\n\nCreate an Area3D with a SoftBody3D inside, override gravity and wind on the Area3D and observe the SoftBody3D not reacting when Jolt Physics is enabled.\n\n### Minimal reproduction project (MRP)\n\n[soft-body-vs-area.zip](https://github.com/user-attachments/files/23124751/soft-body-vs-area.zip)\n\nNote: Switch to GodotPhysics3D to see wind + gravity interaction.","closed_by":{"login":"Repiteo","id":17489292,"node_id":"MDQ6VXNlcjE3NDg5Mjky","avatar_url":"https://avatars.githubusercontent.com/u/17489292?v=4","gravatar_id":"","url":"https://api.github.com/users/Repiteo","html_url":"https://github.com/Repiteo","followers_url":"https://api.github.com/users/Repiteo/followers","following_url":"https://api.github.com/users/Repiteo/following{/other_user}","gists_url":"https://api.github.com/users/Repiteo/gists{/gist_id}","starred_url":"https://api.github.com/users/Repiteo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Repiteo/subscriptions","organizations_url":"https://api.github.com/users/Repiteo/orgs","repos_url":"https://api.github.com/users/Repiteo/repos","events_url":"https://api.github.com/users/Repiteo/events{/privacy}","received_events_url":"https://api.github.com/users/Repiteo/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/111993/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/godotengine/godot/issues/111993/timeline","performed_via_github_app":null,"state_reason":"completed","pinned_comment":null}