":[],"milestone":{"url":"https://api.github.com/repos/godotengine/godot/milestones/16","html_url":"https://github.com/godotengine/godot/milestone/16","labels_url":"https://api.github.com/repos/godotengine/godot/milestones/16/labels","id":8237783,"node_id":"MI_kwDOAO6SJc4AfbLX","number":16,"title":"4.x","description":"Issues and pull requests slated for an undetermined Godot 4 release.","creator":{"login":"akien-mga","id":4701338,"node_id":"MDQ6VXNlcjQ3MDEzMzg=","avatar_url":"https://avatars.githubusercontent.com/u/4701338?v=4","gravatar_id":"","url":"https://api.github.com/users/akien-mga","html_url":"https://github.com/akien-mga","followers_url":"https://api.github.com/users/akien-mga/followers","following_url":"https://api.github.com/users/akien-mga/following{/other_user}","gists_url":"https://api.github.com/users/akien-mga/gists{/gist_id}","starred_url":"https://api.github.com/users/akien-mga/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/akien-mga/subscriptions","organizations_url":"https://api.github.com/users/akien-mga/orgs","repos_url":"https://api.github.com/users/akien-mga/repos","events_url":"https://api.github.com/users/akien-mga/events{/privacy}","received_events_url":"https://api.github.com/users/akien-mga/received_events","type":"User","user_view_type":"public","site_admin":false},"open_issues":5793,"closed_issues":0,"state":"open","created_at":"2022-07-26T12:42:05Z","updated_at":"2026-10-22T14:39:14Z","due_on":null,"closed_at":null},"comments":4,"created_at":"2025-06-06T11:28:27Z","updated_at":"2026-07-16T19:53:29Z","closed_at":null,"assignee":null,"author_association":"MEMBER","issue_field_values":[],"type":null,"active_lock_reason":null,"draft":false,"pull_request":{"url":"https://api.github.com/repos/godotengine/godot/pulls/107209","html_url":"https://github.com/godotengine/godot/pull/107209","diff_url":"https://github.com/godotengine/godot/pull/107209.diff","patch_url":"https://github.com/godotengine/godot/pull/107209.patch","merged_at":null},"body":"This PR improves how launch options are registered and handled.\r\n- Added LaunchOptions struct\r\n  - Contains Option struct, which is an info about a single recognized launch option\r\n  - Contains enum for all default launch options\r\n- Each launch Option is properly registered with name, alises, description etc.\r\n- Help is no longer hard-coded, it's printed based on the registered options\r\n- Argument matching is performed based on registered options\r\n- Config variables were moved from top level to dedicated structs\r\n\r\nThe main improvement is that all launch options are now registered in one place and handled in one place, instead of being spread all over the file. Makes them very easy to find and manage.\r\n\r\nIn a future PRs I plan to move some options out of main and register them in the modules. It could work similar to context menu plugins, i.e. you register an option, it gets an ID and associated callback that gets called.\r\nAlso more config options can be moved to structs (I didn't move all of them).\r\n\r\nNote that registering options is a big cumbersome right now. There are many parameters and many default arguments get repeated. It could be improved with the new struct initialization in C++20, which basically works like named arguments. I added a sample line and constructor how it would look (unused for now).","closed_by":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/107209/reactions","total_count":2,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":2},"timeline_url":"https://api.github.com/repos/godotengine/godot/issues/107209/timeline","performed_via_github_app":null,"state_reason":null}