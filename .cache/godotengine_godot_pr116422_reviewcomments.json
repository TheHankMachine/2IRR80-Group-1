_id":"PRRC_kwDOAO6SJc6oIGd2","diff_hunk":"@@ -713,6 +713,7 @@ Basis::operator String() const {\n \n Quaternion Basis::get_quaternion() const {\n #ifdef MATH_CHECKS\n+\tERR_FAIL_COND_V_MSG(!is_finite(), Quaternion(), \"Basis \" + operator String() + \" is not finite, contains NaN or INF.\");","path":"core/math/basis.cpp","commit_id":"b8f7bdf358b9428cbb66692e1ead0e1205c3a6dd","original_commit_id":"b8f7bdf358b9428cbb66692e1ead0e1205c3a6dd","user":{"login":"TokageItLab","id":61938263,"node_id":"MDQ6VXNlcjYxOTM4MjYz","avatar_url":"https://avatars.githubusercontent.com/u/61938263?v=4","gravatar_id":"","url":"https://api.github.com/users/TokageItLab","html_url":"https://github.com/TokageItLab","followers_url":"https://api.github.com/users/TokageItLab/followers","following_url":"https://api.github.com/users/TokageItLab/following{/other_user}","gists_url":"https://api.github.com/users/TokageItLab/gists{/gist_id}","starred_url":"https://api.github.com/users/TokageItLab/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/TokageItLab/subscriptions","organizations_url":"https://api.github.com/users/TokageItLab/orgs","repos_url":"https://api.github.com/users/TokageItLab/repos","events_url":"https://api.github.com/users/TokageItLab/events{/privacy}","received_events_url":"https://api.github.com/users/TokageItLab/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"It is true that quaternions can contain INF or NaN. While this does not represent a rotation, it is a mathematically valid state, so this check is incorrect anyway.\r\n\r\nAdding that check to `get_rotation_quaternion()` makes sense, but it implies that the check should be performed during normalization, as mentioned below.","created_at":"2026-02-18T07:03:45Z","updated_at":"2026-02-18T07:04:58Z","html_url":"https://github.com/godotengine/godot/pull/116422#discussion_r2820695926","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/116422","_links":{"self":{"href":"https://api.github.com/repos/godotengine/godot/pulls/comments/2820695926"},"html":{"href":"https://github.com/godotengine/godot/pull/116422#discussion_r2820695926"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/116422"}},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/2820695926/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":716,"original_line":716,"side":"RIGHT","in_reply_to_id":2820032698,"author_association":"MEMBER","original_position":4,"position":4,"subject_type":"line"},{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/2820703924","pull_request_review_id":3818128654,"id":2820703924,"node_id":"PRRC_kwDOAO6SJc6oIIa0","diff_hunk":"@@ -713,6 +713,7 @@ Basis::operator String() const {\n \n Quaternion Basis::get_quaternion() const {\n #ifdef MATH_CHECKS\n+\tERR_FAIL_COND_V_MSG(!is_finite(), Quaternion(), \"Basis \" + operator String() + \" is not finite, contains NaN or INF.\");","path":"core/math/basis.cpp","commit_id":"b8f7bdf358b9428cbb66692e1ead0e1205c3a6dd","original_commit_id":"b8f7bdf358b9428cbb66692e1ead0e1205c3a6dd","user":{"login":"Ivorforce","id":2308167,"node_id":"MDQ6VXNlcjIzMDgxNjc=","avatar_url":"https://avatars.githubusercontent.com/u/2308167?v=4","gravatar_id":"","url":"https://api.github.com/users/Ivorforce","html_url":"https://github.com/Ivorforce","followers_url":"https://api.github.com/users/Ivorforce/followers","following_url":"https://api.github.com/users/Ivorforce/following{/other_user}","gists_url":"https://api.github.com/users/Ivorforce/gists{/gist_id}","starred_url":"https://api.github.com/users/Ivorforce/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Ivorforce/subscriptions","organizations_url":"https://api.github.com/users/Ivorforce/orgs","repos_url":"https://api.github.com/users/Ivorforce/repos","events_url":"https://api.github.com/users/Ivorforce/events{/privacy}","received_events_url":"https://api.github.com/users/Ivorforce/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"Did you look at the line below this suggested change? It will error out if `!is_rotation()`. So it will error anyway, just with a worse fitting error message.","created_at":"2026-02-18T07:06:36Z","updated_at":"2026-02-18T07:06:44Z","html_url":"https://github.com/godotengine/godot/pull/116422#discussion_r2820703924","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/116422","_links":{"self":{"href":"https://api.github.com/repos/godotengine/godot/pulls/comments/2820703924"},"html":{"href":"https://github.com/godotengine/godot/pull/116422#discussion_r2820703924"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/116422"}},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/2820703924/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":716,"original_line":716,"side":"RIGHT","in_reply_to_id":2820032698,"author_association":"MEMBER","original_position":4,"position":4,"subject_type":"line"},{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/2820721022","pull_request_review_id":3818147642,"id":2820721022,"node_id":"PRRC_kwDOAO6SJc6oIMl-","diff_hunk":"@@ -713,6 +713,7 @@ Basis::operator String() const {\n \n Quaternion Basis::get_quaternion() const {\n #ifdef MATH_CHECKS\n+\tERR_FAIL_COND_V_MSG(!is_finite(), Quaternion(), \"Basis \" + operator String() + \" is not finite, contains NaN or INF.\");","path":"core/math/basis.cpp","commit_id":"b8f7bdf358b9428cbb66692e1ead0e1205c3a6dd","original_commit_id":"b8f7bdf358b9428cbb66692e1ead0e1205c3a6dd","user":{"login":"TokageItLab","id":61938263,"node_id":"MDQ6VXNlcjYxOTM4MjYz","avatar_url":"https://avatars.githubusercontent.com/u/61938263?v=4","gravatar_id":"","url":"https://api.github.com/users/TokageItLab","html_url":"https://github.com/TokageItLab","followers_url":"https://api.github.com/users/TokageItLab/followers","following_url":"https://api.github.com/users/TokageItLab/following{/other_user}","gists_url":"https://api.github.com/users/TokageItLab/gists{/gist_id}","starred_url":"https://api.github.com/users/TokageItLab/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/TokageItLab/subscriptions","organizations_url":"https://api.github.com/users/TokageItLab/orgs","repos_url":"https://api.github.com/users/TokageItLab/repos","events_url":"https://api.github.com/users/TokageItLab/events{/privacy}","received_events_url":"https://api.github.com/users/TokageItLab/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"In that case, just add a check to the is_rotation() method to determine if it is normalizable and improve the wording of the is_rotation() check. But the presence of NaN or INF is synonymous with being unnormalized, and I don't see much point in distinguishing them here.\r\n\r\nAgain, the main issue with https://github.com/godotengine/godot/issues/73299 's problem is that it fails to detect when the normalized matrix is not properly normalized due to containing NaN or INF values. In other words, the warning tells you to normalize, but even if you do so, it doesn't resolve the issue, which is the problem. Therefore, checks should be implemented within the normalization function.","created_at":"2026-02-18T07:12:33Z","updated_at":"2026-02-18T07:19:25Z","html_url":"https://github.com/godotengine/godot/pull/116422#discussion_r2820721022","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/116422","_links":{"self":{"href":"https://api.github.com/repos/godotengine/godot/pulls/comments/2820721022"},"html":{"href":"https://github.com/godotengine/godot/pull/116422#discussion_r2820721022"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/116422"}},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/2820721022/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":716,"original_line":716,"side":"RIGHT","in_reply_to_id":2820032698,"author_association":"MEMBER","original_position":4,"position":4,"subject_type":"line"},{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/2820722209","pull_request_review_id":3818148980,"id":2820722209,"node_id":"PRRC_kwDOAO6SJc6oIM4h","diff_hunk":"@@ -94,6 +94,10 @@ void Transform3D::set_look_at(const Vector3 &p_eye, const Vector3 &p_target, con\n }\n \n Transform3D Transform3D::interpolate_with(const Transform3D &p_transform, real_t p_c) const {\n+#ifdef MATH_CHECKS\n+\tERR_FAIL_COND_V_MSG(!is_finite(), Transform3D(), \"The starting transform is not finite, contains NaN or INF.\");\n+\tERR_FAIL_COND_V_MSG(!p_transform.is_finite(), Transform3D(), \"The destination transform is not finite, contains NaN or INF.\");\n+#endif","path":"core/math/transform_3d.cpp","commit_id":"b8f7bdf358b9428cbb66692e1ead0e1205c3a6dd","original_commit_id":"b8f7bdf358b9428cbb66692e1ead0e1205c3a6dd","user":{"login":"Ivorforce","id":2308167,"node_id":"MDQ6VXNlcjIzMDgxNjc=","avatar_url":"https://avatars.githubusercontent.com/u/2308167?v=4","gravatar_id":"","url":"https://api.github.com/users/Ivorforce","html_url":"https://github.com/Ivorforce","followers_url":"https://api.github.com/users/Ivorforce/followers","following_url":"https://api.github.com/users/Ivorforce/following{/other_user}","gists_url":"https://api.github.com/users/Ivorforce/gists{/gist_id}","starred_url":"https://api.github.com/users/Ivorforce/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Ivorforce/subscriptions","organizations_url":"https://api.github.com/users/Ivorforce/orgs","repos_url":"https://api.github.com/users/Ivorforce/repos","events_url":"https://api.github.com/users/Ivorforce/events{/privacy}","received_events_url":"https://api.github.com/users/Ivorforce/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"I guess you mean `orthonormalized()`? Agreed, this would improve the situation expectedly (although it would still also print the error messages from https://github.com/godotengine/godot/issues/73299).","created_at":"2026-02-18T07:12:57Z","updated_at":"2026-02-18T07:12:57Z","html_url":"https://github.com/godotengine/godot/pull/116422#discussion_r2820722209","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/116422","_links":{"self":{"href":"https://api.github.com/repos/godotengine/godot/pulls/comments/2820722209"},"html":{"href":"https://github.com/godotengine/godot/pull/116422#discussion_r2820722209"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/116422"}},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/2820722209/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":97,"original_start_line":97,"start_side":"RIGHT","line":100,"original_line":100,"side":"RIGHT","in_reply_to_id":2820042552,"author_association":"MEMBER","original_position":7,"position":7,"subject_type":"line"},{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/2820730726","pull_request_review_id":3818159911,"id":2820730726,"node_id":"PRRC_kwDOAO6SJc6oIO9m","diff_hunk":"@@ -713,6 +713,7 @@ Basis::operator String() const {\n \n Quaternion Basis::get_quaternion() const {\n #ifdef MATH_CHECKS\n+\tERR_FAIL_COND_V_MSG(!is_finite(), Quaternion(), \"Basis \" + operator String() + \" is not finite, contains NaN or INF.\");","path":"core/math/basis.cpp","commit_id":"b8f7bdf358b9428cbb66692e1ead0e1205c3a6dd","original_commit_id":"b8f7bdf358b9428cbb66692e1ead0e1205c3a6dd","user":{"login":"Ivorforce","id":2308167,"node_id":"MDQ6VXNlcjIzMDgxNjc=","avatar_url":"https://avatars.githubusercontent.com/u/2308167?v=4","gravatar_id":"","url":"https://api.github.com/users/Ivorforce","html_url":"https://github.com/Ivorforce","followers_url":"https://api.github.com/users/Ivorforce/followers","following_url":"https://api.github.com/users/Ivorforce/following{/other_user}","gists_url":"https://api.github.com/users/Ivorforce/gists{/gist_id}","starred_url":"https://api.github.com/users/Ivorforce/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Ivorforce/subscriptions","organizations_url":"https://api.github.com/users/Ivorforce/orgs","repos_url":"https://api.github.com/users/Ivorforce/repos","events_url":"https://api.github.com/users/Ivorforce/events{/privacy}","received_events_url":"https://api.github.com/users/Ivorforce/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"Should `is_rotation` really error on NaN / INF? I feel like _checking if_ a Quat with NaN / INF is a rotation should just silently return `false`. I think the check for it is more appropriate here, to improve on error reporting in the case of `is_rotation()` due to NaN/INF.\n\nChecking in the normalization function sounds like a good idea though.","created_at":"2026-02-18T07:15:44Z","updated_at":"2026-02-18T07:33:51Z","html_url":"https://github.com/godotengine/godot/pull/116422#discussion_r2820730726","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/116422","_links":{"self":{"href":"https://api.github.com/repos/godotengine/godot/pulls/comments/2820730726"},"html":{"href":"https://github.com/godotengine/godot/pull/116422#discussion_r2820730726"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/116422"}},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/2820730726/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hoo