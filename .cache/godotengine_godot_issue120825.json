ed_at":null,"archived_by":null}],"state":"closed","locked":false,"assignees":[],"milestone":{"url":"https://api.github.com/repos/godotengine/godot/milestones/25","html_url":"https://github.com/godotengine/godot/milestone/25","labels_url":"https://api.github.com/repos/godotengine/godot/milestones/25/labels","id":15520464,"node_id":"MI_kwDOAO6SJc4A7NLQ","number":25,"title":"4.8","description":"","creator":{"login":"Repiteo","id":17489292,"node_id":"MDQ6VXNlcjE3NDg5Mjky","avatar_url":"https://avatars.githubusercontent.com/u/17489292?v=4","gravatar_id":"","url":"https://api.github.com/users/Repiteo","html_url":"https://github.com/Repiteo","followers_url":"https://api.github.com/users/Repiteo/followers","following_url":"https://api.github.com/users/Repiteo/following{/other_user}","gists_url":"https://api.github.com/users/Repiteo/gists{/gist_id}","starred_url":"https://api.github.com/users/Repiteo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Repiteo/subscriptions","organizations_url":"https://api.github.com/users/Repiteo/orgs","repos_url":"https://api.github.com/users/Repiteo/repos","events_url":"https://api.github.com/users/Repiteo/events{/privacy}","received_events_url":"https://api.github.com/users/Repiteo/received_events","type":"User","user_view_type":"public","site_admin":false},"open_issues":343,"closed_issues":2335,"state":"open","created_at":"2026-04-13T15:59:35Z","updated_at":"2026-10-22T06:28:22Z","due_on":null,"closed_at":null},"comments":5,"created_at":"2026-07-01T15:44:51Z","updated_at":"2026-07-21T08:59:57Z","closed_at":"2026-07-20T23:37:52Z","assignee":null,"author_association":"MEMBER","issue_field_values":[],"type":null,"active_lock_reason":null,"draft":false,"pull_request":{"url":"https://api.github.com/repos/godotengine/godot/pulls/120825","html_url":"https://github.com/godotengine/godot/pull/120825","diff_url":"https://github.com/godotengine/godot/pull/120825.diff","patch_url":"https://github.com/godotengine/godot/pull/120825.patch","merged_at":"2026-07-20T23:37:51Z"},"body":"## What problem(s) does this PR solve?\r\n\r\n- Supersedes (mostly) https://github.com/godotengine/godot/pull/112586\r\n\r\n`CowData` assignment (e.g. string = string1) currently temporarily resets to `nullptr` as it clears first and assigns afterwards. It is observably correct within the same thread. However, other threads might temporarily observe a `nullptr`.\r\n\r\nWhile cross-thread use is not guaranteed by the class, there is no harm in making it a bit more resilient: through this change, other threads will _never_ observe a temporary `nullptr` during assignments.\r\n\r\n## Additional information\r\n\r\nThis is achieved by essentially this code, just reimagined in C++:\r\n\r\n```\r\nT *old_ptr = ptr;\r\nptr = new_ptr;\r\ndealloc(old_ptr);\r\n\r\n// instead of\r\nptr = nullptr;\r\ndealloc(ptr);\r\nptr = new_ptr;\r\n```\r\n\r\nPerformance should be the same as before\r\n","closed_by":{"login":"Repiteo","id":17489292,"node_id":"MDQ6VXNlcjE3NDg5Mjky","avatar_url":"https://avatars.githubusercontent.com/u/17489292?v=4","gravatar_id":"","url":"https://api.github.com/users/Repiteo","html_url":"https://github.com/Repiteo","followers_url":"https://api.github.com/users/Repiteo/followers","following_url":"https://api.github.com/users/Repiteo/following{/other_user}","gists_url":"https://api.github.com/users/Repiteo/gists{/gist_id}","starred_url":"https://api.github.com/users/Repiteo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Repiteo/subscriptions","organizations_url":"https://api.github.com/users/Repiteo/orgs","repos_url":"https://api.github.com/users/Repiteo/repos","events_url":"https://api.github.com/users/Repiteo/events{/privacy}","received_events_url":"https://api.github.com/users/Repiteo/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/120825/reactions","total_count":1,"+1":1,"-1":0,