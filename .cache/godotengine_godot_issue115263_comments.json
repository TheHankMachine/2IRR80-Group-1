ues/comments/3784484864/reactions","total_count":2,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":1,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3784509619","html_url":"https://github.com/godotengine/godot/pull/115263#issuecomment-3784509619","issue_url":"https://api.github.com/repos/godotengine/godot/issues/115263","id":3784509619,"node_id":"IC_kwDOAO6SJc7hkwiz","user":{"login":"AThousandShips","id":96648715,"node_id":"U_kgDOBcK-Cw","avatar_url":"https://avatars.githubusercontent.com/u/96648715?v=4","gravatar_id":"","url":"https://api.github.com/users/AThousandShips","html_url":"https://github.com/AThousandShips","followers_url":"https://api.github.com/users/AThousandShips/followers","following_url":"https://api.github.com/users/AThousandShips/following{/other_user}","gists_url":"https://api.github.com/users/AThousandShips/gists{/gist_id}","starred_url":"https://api.github.com/users/AThousandShips/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/AThousandShips/subscriptions","organizations_url":"https://api.github.com/users/AThousandShips/orgs","repos_url":"https://api.github.com/users/AThousandShips/repos","events_url":"https://api.github.com/users/AThousandShips/events{/privacy}","received_events_url":"https://api.github.com/users/AThousandShips/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-01-22T13:47:25Z","updated_at":"2026-01-22T13:47:25Z","body":"> Sorry , but I am not going to invest more time in this .\r\n\r\nAre you also not going to make any changes if requested by maintainers? Making a PR isn't a process that just ends by opening a PR","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3784509619/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3784587419","html_url":"https://github.com/godotengine/godot/pull/115263#issuecomment-3784587419","issue_url":"https://api.github.com/repos/godotengine/godot/issues/115263","id":3784587419,"node_id":"IC_kwDOAO6SJc7hlDib","user":{"login":"elix22","id":7060531,"node_id":"MDQ6VXNlcjcwNjA1MzE=","avatar_url":"https://avatars.githubusercontent.com/u/7060531?v=4","gravatar_id":"","url":"https://api.github.com/users/elix22","html_url":"https://github.com/elix22","followers_url":"https://api.github.com/users/elix22/followers","following_url":"https://api.github.com/users/elix22/following{/other_user}","gists_url":"https://api.github.com/users/elix22/gists{/gist_id}","starred_url":"https://api.github.com/users/elix22/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/elix22/subscriptions","organizations_url":"https://api.github.com/users/elix22/orgs","repos_url":"https://api.github.com/users/elix22/repos","events_url":"https://api.github.com/users/elix22/events{/privacy}","received_events_url":"https://api.github.com/users/elix22/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-01-22T14:02:42Z","updated_at":"2026-01-22T14:02:42Z","body":"@AThousandShips \r\nif the requests are related to some issues that were found in the code then yes I am going make the changes\r\nIf my code broke some functionality then yes I am going make the changes\r\nBut I am not going to invest my time in writing proposals.\r\n\r\n","author_association":"NONE","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3784587419/reactions","total_count":2,"+1":2,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3785925844","html_url":"https://github.com/godotengine/godot/pull/115263#issuecomment-3785925844","issue_url":"https://api.github.com/repos/godotengine/godot/issues/115263","id":3785925844,"node_id":"IC_kwDOAO6SJc7hqKTU","user":{"login":"aaronfranke","id":1646875,"node_id":"MDQ6VXNlcjE2NDY4NzU=","avatar_url":"https://avatars.githubusercontent.com/u/1646875?v=4","gravatar_id":"","url":"https://api.github.com/users/aaronfranke","html_url":"https://github.com/aaronfranke","followers_url":"https://api.github.com/users/aaronfranke/followers","following_url":"https://api.github.com/users/aaronfranke/following{/other_user}","gists_url":"https://api.github.com/users/aaronfranke/gists{/gist_id}","starred_url":"https://api.github.com/users/aaronfranke/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/aaronfranke/subscriptions","organizations_url":"https://api.github.com/users/aaronfranke/orgs","repos_url":"https://api.github.com/users/aaronfranke/repos","events_url":"https://api.github.com/users/aaronfranke/events{/privacy}","received_events_url":"https://api.github.com/users/aaronfranke/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-01-22T18:08:02Z","updated_at":"2026-01-22T18:12:08Z","body":"@AThousandShips This PR is bringing an existing feature to a more complete state, so I'd say it doesn't need a proposal.\r\n\r\n@elix22 Thank you for working on this! As the original implementer of the Godot glTF physics code, the reason I have held off on implementing more is because the specifications are in flux. When I proposed the initial version of the code to be added to the engine, I was mistaken with how close the specification was to its final state.\r\n\r\nThere are still some things about the physics specification that are subject to change. We want to align Godot and the OMI extensions with the work Khronos is doing, and vice versa, push Khronos to align with OMI and the needs of Godot.\r\n\r\nNamely, these things come to mind as things that would be good to have as prerequisites before glTF physics materials:\r\n\r\n- The default values are still not very well defined https://github.com/eoineoineoin/glTF_Physics/issues/33\r\n- Add per-shape physics materials to the 3D physics system https://github.com/godotengine/godot-proposals/issues/7401\r\n- Change physics material friction/bounce combine modes to match other engines https://github.com/godotengine/godot-proposals/issues/11715\r\n- Everything else in this tracker https://github.com/godotengine/godot-proposals/issues/13419\r\n\r\nIn the meantime, I should mention that it is possible to implement glTF extensions in GDScript if you need something in your project immediately, or you are welcome to run this PR in your own fork of the engine.\r\n\r\nTL;DR: This PR is welcome, and thank you for working, but the reality is I'd hold off on this for the near future.","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3785925844/reactions","total_count":2,"+1":2,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3787268558","html_url":"https://github.com/godotengine/godot/pull/115263#issuecomment-3787268558","issue_url":"https://api.github.com/repos/godotengine/godot/issues/115263","id":3787268558,"node_id":"IC_kwDOAO6SJc7hvSHO","user":{"login":"elix22","id":7060531,"node_id":"MDQ6VXNlcjcwNjA1MzE=","avatar_url":"https://avatars.githubusercontent.com/u/7060531?v=4","gravatar_id":"","url":"https://api.github.com/users/elix22","html_url":"https://github.com/elix22","followers_url":"https://api.github.com/users/elix22/followers","following_url":"https://api.github.com/users/elix22/following{/other_user}","gists_url":"https://api.github.com/users/elix22/gists{/gist_id}","starred_url":"https://api.github.com/users/elix22/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/elix22/subscriptions","organizations_url":"https://api.github.com/users/elix22/orgs","repos_url":"https://api.github.com/users/elix22/repos","events_url":"https://api.github.com/users/elix22/events{/privacy}","received_events_url":"https://api.github.com/users/elix22/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-01-22T23:26:12Z","updated_at":"2026-01-22T23:26:12Z","body":"@aaronfranke \r\nSure , I get you .\r\nNo rush , feel free to use it in future implementations .\r\nIn any case I am using it on my Godot fork .\r\nI am using Godot to create scenes and export GLTF scenes to be used on my own proprietary game engine , so I am not so strict on specifications.\r\nCheers","author_association":"NONE","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3787268558/reactions","total_count":1,"+1":0,"-1":0,"laugh":0,"hooray":1,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null}]