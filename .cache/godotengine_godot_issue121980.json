r":"ffee88","default":false,"description":"","archived_at":null,"archived_by":null},{"id":2666708289,"node_id":"MDU6TGFiZWwyNjY2NzA4Mjg5","url":"https://api.github.com/repos/godotengine/godot/labels/topic:3d","name":"topic:3d","color":"ffee88","default":false,"description":"","archived_at":null,"archived_by":null}],"state":"closed","locked":false,"assignees":[],"milestone":{"url":"https://api.github.com/repos/godotengine/godot/milestones/25","html_url":"https://github.com/godotengine/godot/milestone/25","labels_url":"https://api.github.com/repos/godotengine/godot/milestones/25/labels","id":15520464,"node_id":"MI_kwDOAO6SJc4A7NLQ","number":25,"title":"4.8","description":"","creator":{"login":"Repiteo","id":17489292,"node_id":"MDQ6VXNlcjE3NDg5Mjky","avatar_url":"https://avatars.githubusercontent.com/u/17489292?v=4","gravatar_id":"","url":"https://api.github.com/users/Repiteo","html_url":"https://github.com/Repiteo","followers_url":"https://api.github.com/users/Repiteo/followers","following_url":"https://api.github.com/users/Repiteo/following{/other_user}","gists_url":"https://api.github.com/users/Repiteo/gists{/gist_id}","starred_url":"https://api.github.com/users/Repiteo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Repiteo/subscriptions","organizations_url":"https://api.github.com/users/Repiteo/orgs","repos_url":"https://api.github.com/users/Repiteo/repos","events_url":"https://api.github.com/users/Repiteo/events{/privacy}","received_events_url":"https://api.github.com/users/Repiteo/received_events","type":"User","user_view_type":"public","site_admin":false},"open_issues":343,"closed_issues":2335,"state":"open","created_at":"2026-04-13T15:59:35Z","updated_at":"2026-10-22T06:28:22Z","due_on":null,"closed_at":null},"comments":1,"created_at":"2026-07-31T16:16:47Z","updated_at":"2026-09-26T15:13:22Z","closed_at":"2026-09-26T15:13:22Z","assignee":null,"author_association":"MEMBER","issue_field_values":[],"type":null,"active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"- *Related to https://github.com/godotengine/godot/issues/118698.*\n\n### Tested versions\n\n- Reproducible in: 4.0.stable, 4.7.1.stable, 4.8.dev 4e8c061c9\n\n### System information\n\nGodot v4.8.dev (4e8c061c9) - Fedora Linux 44 (KDE Plasma Desktop Edition) on X11 - X11 display driver, Multi-window, 1 monitor - Vulkan (Forward+) - dedicated NVIDIA GeForce RTX 5090 (nvidia; 610.43.03) - AMD Ryzen 9 9950X3D 16-Core Processor (32 threads) - 62.33 GiB memory - PulseAudio (44100 Hz, Stereo/mono)\n\n### Issue description\n\nDecreasing ReflectionProbe's **Intensity** property below `1.0` does not reduce the strength of its ambient light condition, only the reflected light.\n\nAdditionally, the reflected light (seen on the spheres in the screenshots below) doesn't blend between the background sky and the reflection probe when Intensity is set below `1.0`. One would logically expect this to occur, so that fading a ReflectionProbe using its Intensity property is a fully smooth transition.\n\nWith constant ambient color:\n\nForward+ | Mobile | Compatibility\n-|-|-\n<img width=\"1152\" height=\"648\" alt=\"Image\" src=\"https://github.com/user-attachments/assets/70471a0d-2835-4b9b-a3a3-35c6ab7b050e\" /> | <img width=\"1152\" height=\"648\" alt=\"Image\" src=\"https://github.com/user-attachments/assets/be3c48e5-bfdb-4334-a67b-d811258d7fc8\" /> | <img width=\"1152\" height=\"648\" alt=\"Image\" src=\"https://github.com/user-attachments/assets/1d941f3f-3efc-4d8a-9218-d4c87556dc56\" />\n\nWith automatic ambient color (it's less visible on Mobile due to the more limited dynamic range, and doesn't seem visible at all on Compatibility):\n\nForward+ | Mobile | Compatibility\n-|-|-\n<img width=\"1152\" height=\"648\" alt=\"Image\" src=\"https://github.com/user-attachments/assets/a4352d0f-f45d-4c69-b8d4-d377c4d0fd30\" /> | <img width=\"1152\" height=\"648\" alt=\"Image\" src=\"https://github.com/user-attachments/assets/6d95136b-11cb-4582-b2ed-3718d18c7034\" /> | <img width=\"1152\" height=\"648\" alt=\"Image\" src=\"https://github.com/user-attachments/assets/53fcfa25-fed8-4108-9736-4d668f500ac5\" />\n\nThis is a blocker for finalizing https://github.com/godotengine/godot/pull/67465, as well as implementing custom distance fade scripts for large scenes with hundreds of reflection probes (to improve performance or sidestep rendering limits).\n\n### Steps to reproduce\n\n- Add a ReflectionProbe node around some geometry.\n- Change its ambient mode to **Constant Color** and set a color.\n- Decrease the ReflectionProbe's **Intensity** property. Notice how the ambient color doesn't fade.\n\n### Minimal reproduction project (MRP)\n\n[test_reflection_probe_intensity.zip](https://github.com/user-attachments/files/30595926/test_reflection_probe_intensity.zip)","closed_by":{"login":"Repiteo","id":17489292,"node_id":"MDQ6VXNlcjE3NDg5Mjky","avatar_url":"https://avatars.githubusercontent.com/u/17489292?v=4","gravatar_id":"","url":"https://api.github.com/users/Repiteo","html_url":"https://github.com/Repiteo","followers_url":"https://api.github.com/users/Repiteo/followers","following_url":"https://api.github.com/users/Repiteo/following{/other_user}","gists_url":"https://api.github.com/users/Repiteo/gists{/gist_id}","starred_url":"https://api.github.com/users/Repiteo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Repiteo/subscriptions","organizations_url":"https://api.github.com/users/Repiteo/orgs","repos_url":"https://api.github.com/users/Repiteo/repos","events_url":"https://api.github.com/users/Repiteo/events{/privacy}","received_events_url":"https://api.github.com/users/Repiteo/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/121980/reactions","total_count":2,"+1