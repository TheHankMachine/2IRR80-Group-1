s ~7% and stays constant even without interaction. Deleting some SVG files reduces usage proportionally; deleting all of them brings it back to normal.\n\n### Minimal reproduction project (MRP)\n\n[test_svg.zip](https://github.com/user-attachments/files/32419359/test_svg.zip)","closed_by":{"login":"Devenor","id":11620504,"node_id":"MDQ6VXNlcjExNjIwNTA0","avatar_url":"https://avatars.githubusercontent.com/u/11620504?v=4","gravatar_id":"","url":"https://api.github.com/users/Devenor","html_url":"https://github.com/Devenor","followers_url":"https://api.github.com/users/Devenor/followers","following_url":"https://api.github.com/users/Devenor/following{/other_user}","gists_url":"https://api.github.com/users/Devenor/gists{/gist_id}","starred_url":"https://api.github.com/users/Devenor/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Devenor/subscriptions","organizations_url":"https://api.github.com/users/Devenor/orgs","repos_url":"https://api.github.com/users/Devenor/repos","events_url":"https://api.github.com/users/Devenor/events{/privacy}","received_events_url":"https://api.github.com/users/Devenor/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/123643/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/godotengine/godot/issues/123643/timeline","performed_via_github_app":null,"state_reason":"not_planned","pinned_comment":null}