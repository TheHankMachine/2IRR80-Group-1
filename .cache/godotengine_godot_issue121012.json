Y2NzA4Mjg5","url":"https://api.github.com/repos/godotengine/godot/labels/topic:3d","name":"topic:3d","color":"ffee88","default":false,"description":"","archived_at":null,"archived_by":null}],"state":"closed","locked":false,"assignees":[],"milestone":{"url":"https://api.github.com/repos/godotengine/godot/milestones/25","html_url":"https://github.com/godotengine/godot/milestone/25","labels_url":"https://api.github.com/repos/godotengine/godot/milestones/25/labels","id":15520464,"node_id":"MI_kwDOAO6SJc4A7NLQ","number":25,"title":"4.8","description":"","creator":{"login":"Repiteo","id":17489292,"node_id":"MDQ6VXNlcjE3NDg5Mjky","avatar_url":"https://avatars.githubusercontent.com/u/17489292?v=4","gravatar_id":"","url":"https://api.github.com/users/Repiteo","html_url":"https://github.com/Repiteo","followers_url":"https://api.github.com/users/Repiteo/followers","following_url":"https://api.github.com/users/Repiteo/following{/other_user}","gists_url":"https://api.github.com/users/Repiteo/gists{/gist_id}","starred_url":"https://api.github.com/users/Repiteo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Repiteo/subscriptions","organizations_url":"https://api.github.com/users/Repiteo/orgs","repos_url":"https://api.github.com/users/Repiteo/repos","events_url":"https://api.github.com/users/Repiteo/events{/privacy}","received_events_url":"https://api.github.com/users/Repiteo/received_events","type":"User","user_view_type":"public","site_admin":false},"open_issues":343,"closed_issues":2335,"state":"open","created_at":"2026-04-13T15:59:35Z","updated_at":"2026-10-22T06:28:22Z","due_on":null,"closed_at":null},"comments":5,"created_at":"2026-07-06T16:03:40Z","updated_at":"2026-08-05T14:52:49Z","closed_at":"2026-08-05T14:52:34Z","assignee":null,"author_association":"CONTRIBUTOR","issue_field_values":[],"type":null,"active_lock_reason":null,"draft":false,"pull_request":{"url":"https://api.github.com/repos/godotengine/godot/pulls/121012","html_url":"https://github.com/godotengine/godot/pull/121012","diff_url":"https://github.com/godotengine/godot/pull/121012.diff","patch_url":"https://github.com/godotengine/godot/pull/121012.patch","merged_at":"2026-08-05T14:52:34Z"},"body":"We were previously using normal matrix to transform normal, tangent and bitangent (binormal) vectors. This was correct for normal, as it's a covector, but incorrect for tangent & bitangent: these are derivatives of position with respect to texture coordinates and need to be transformed with the model matrix just like position.\r\n\r\nNote that ideally, we would also keep TBN orthogonal *after* the transformation to maintain parity with behavior for pre-scaled meshes; this requires reconstructing binormal *after* its world transform which alters the flow. MikkTSpace recommends doing this in the *fragment* shader, which is challenging because BINORMAL can be read/written to from a user-specified vertex shader fragment. This all would need to be done separately.\r\n\r\nbefore | after\r\n---------|---------\r\n<img width=\"1003\" height=\"1133\" alt=\"image\" src=\"https://github.com/user-attachments/assets/f765f4e7-7ba5-464e-9bd9-ebf650df3806\" /> | <img width=\"1003\" height=\"1133\" alt=\"tangent_scale_mrp_fixed\" src=\"https://github.com/user-attachments/assets/28ae6c6e-c1e4-43ba-a152-bbd4863a76ae\" />\r\n\r\nThe slight warping in the bottom of the image after the fix is the TBN skew. This was present before too, just was obscured by the incorrect direction.\r\n\r\nFixes #120980.","closed_by":{"login":"Repiteo","id":17489292,"node_id":"MDQ6VXNlcjE3NDg5Mjky","avatar_url":"https://avatars.githubusercontent.com/u/17489292?v=4","gravatar_id":"","url":"https://api.github.com/users/Repiteo","html_url":"https://github.com/Repiteo","followers_url":"https://api.github.com/users/Repiteo/followers","following_url":"https://api.github.com/users/Repiteo/following{/other_user}","gists_url":"https://api.github.com/users/Repiteo/gists{/gist_id}","starred_url":"https://api.github.com/users/Repiteo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Repiteo/subscriptions","organizations_url":"https://api.github.com/users/Repiteo/orgs","repos_url":"https://api.github.com/users/Repiteo/repos","events_url":"https://api.github.com/users/Repiteo/events{/privacy}","received_events_url":"https://api.github.com/users/Repiteo/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/121012/reactions","total_count":5,"+1":0,"-1":0,"laugh":0,"hooray":4,"confused":0,"heart":0,"rocket":0,"eyes":1},"timeline_url":"https://api.github.com/repos/godotengine/godot/issues/121012/timeline","performed_via_github_app":null,"state_reason":null}