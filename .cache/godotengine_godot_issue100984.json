s/Sauermann/following{/other_user}","gists_url":"https://api.github.com/users/Sauermann/gists{/gist_id}","starred_url":"https://api.github.com/users/Sauermann/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Sauermann/subscriptions","organizations_url":"https://api.github.com/users/Sauermann/orgs","repos_url":"https://api.github.com/users/Sauermann/repos","events_url":"https://api.github.com/users/Sauermann/events{/privacy}","received_events_url":"https://api.github.com/users/Sauermann/received_events","type":"User","user_view_type":"public","site_admin":false},"open_issues":3,"closed_issues":3687,"state":"closed","created_at":"2024-12-19T08:51:28Z","updated_at":"2026-09-04T21:48:38Z","due_on":"2025-09-15T00:00:00Z","closed_at":"2025-09-18T17:13:14Z"},"comments":22,"created_at":"2024-12-31T18:27:47Z","updated_at":"2026-06-26T16:39:25Z","closed_at":"2025-06-02T23:59:29Z","assignee":{"login":"SaracenOne","id":12756047,"node_id":"MDQ6VXNlcjEyNzU2MDQ3","avatar_url":"https://avatars.githubusercontent.com/u/12756047?v=4","gravatar_id":"","url":"https://api.github.com/users/SaracenOne","html_url":"https://github.com/SaracenOne","followers_url":"https://api.github.com/users/SaracenOne/followers","following_url":"https://api.github.com/users/SaracenOne/following{/other_user}","gists_url":"https://api.github.com/users/SaracenOne/gists{/gist_id}","starred_url":"https://api.github.com/users/SaracenOne/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/SaracenOne/subscriptions","organizations_url":"https://api.github.com/users/SaracenOne/orgs","repos_url":"https://api.github.com/users/SaracenOne/repos","events_url":"https://api.github.com/users/SaracenOne/events{/privacy}","received_events_url":"https://api.github.com/users/SaracenOne/received_events","type":"User","user_view_type":"public","site_admin":false},"author_association":"MEMBER","issue_field_values":[],"type":null,"active_lock_reason":null,"draft":false,"pull_request":{"url":"https://api.github.com/repos/godotengine/godot/pulls/100984","html_url":"https://github.com/godotengine/godot/pull/100984","diff_url":"https://github.com/godotengine/godot/pull/100984.diff","patch_url":"https://github.com/godotengine/godot/pull/100984.patch","merged_at":"2025-06-02T23:59:29Z"},"body":"Contain https://github.com/godotengine/godot/pull/104560\r\n\r\n## BoneConstraint3D\r\n\r\nA base class that allows two bones to be specified.\r\n\r\n![image](https://github.com/user-attachments/assets/0f321690-16b7-4314-a174-7ed43556ea1d)\r\n\r\nNote that interpolation by `SkeletonModifier3D.influence` for the entire skeleton is done for each SkeletonModifier3D.\r\n\r\nHowever, constraint settings are often applied to multiple bones at the same time. Therefore, it prevents unnecessary interpolation by having the settings in an array so that the number of SkeletonModifier3Ds in the scene does not grow unnecessarily. For this reason, the BoneConstraint3D settings have the apply amount of modification to the bone for each element in the settings array.\r\n\r\n## AimModifier3D\r\n\r\nThis is a simple version of LookAtModifier3D that only allows bone to the target without advanced options such as angle limitation or time-based interpolation. The feature is simplified, but instead it is implemented with smooth tracking without euler,\r\n\r\n![image](https://github.com/user-attachments/assets/b4463067-d71b-4b5c-a1d1-c234602961d9)\r\n\r\n- It depends on the quaternion constructor with arcs from the two Vector3s, so it is recommended that merge  https://github.com/godotengine/godot/pull/100991 first.\r\n\r\n## CopyTransfromModifier3D\r\n\r\nApply the copied transform of the target bone to the apply bone with processing it with some masks and options.\r\n\r\n![image](https://github.com/user-attachments/assets/cf88de7d-daad-480f-8c8b-0c2b98629580)\r\n\r\nThere are 4 ways to apply the transform, depending on the combination of `Relative` and `Additive` options.\r\n\r\n- Relative + Additive\r\n  - Extract target pose relative to the rest and add it to the apply bone's pose.\r\n- Relative + Not Additive\r\n  - Extract target pose relative to the rest and add it to the apply bone's rest.\r\n- Not Relative + Additive\r\n  - Extract target pose absolutely and add it to the apply bone's pose.\r\n- Not Relative + Not Additive\r\n  - Extract target pose absolutely and the apply bone's pose is replaced with it.\r\n\r\n## ConvertTransfromModifier3D\r\n\r\nApply the copied transform of the target bone to the apply bone about the specific axis with remapping it with some options.\r\n\r\n![image](https://github.com/user-attachments/assets/62d0d831-cdf1-4e99-b7c3-af6bade062f7)\r\n\r\n---\r\n\r\n### Compatibility with third-parties\r\n\r\nI assume there is some compatibility, but cannot guarantee that the behavior is exactly the same in a particular situation (since Since it has not yet been tested/verified).\r\n\r\n#### Blender\r\n\r\nCopyXXX (for rotation with axis mask, rotation mode is roll only) -> CopyTransfromModifier3D\r\nTransformation (for rotation, rotation mode is roll only) -> ConvertTransfromModifier3D\r\nTrack/LockedTrack -> AimModifier3D\r\nDampedTrack ->AimModifier3D\r\n\r\n#### VRMConstraint\r\n\r\nhttps://github.com/vrm-c/vrm-specification/blob/master/specification/VRMC_node_constraint-1.0\r\n\r\nRotationConstraint -> CopyTransfromModifier3D with only rotation with all axes without invert flags\r\nRollConstraint -> ConvertTransfromModifier3D with rotation mode\r\nAimConstraint -> AimModifier3D\r\n","closed_by":{"login":"Repiteo","id":17489292,"node_id":"MDQ6VXNlcjE3NDg5Mjky","avatar_url":"https://avatars.githubusercontent.com/u/17489292?v=4","gravatar_id":"","url":"https://api.github.com/users/Repiteo","html_url":"https://github.com/Repiteo","followers_url":"https://api.github.com/users/Repiteo/followers","following_url":"https://api.github.com/users/Repiteo/following{/other_user}","gists_url":"https://api.github.com/users/Repiteo/gists{/gist_id}","starred_url":"https://api.github.com/users/Repiteo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Repiteo/subscriptions","organizations_url":"https://api.github.com/users/Repiteo/orgs","repos_url":"https://api.github.com/users/Repiteo/repos","events_url":"https://api.github.com/users/Repiteo/events{/privacy}","received_events_url":"https://api.github.com/users/Repiteo/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/100984/reactions","total_count":26,"+1":11,"-1":0,"laugh":0,"hooray":15,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/godotengine/godot/issues/100984/timeline","performed_via_github_app":null,"state_reason":null}