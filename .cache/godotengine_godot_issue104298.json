 approach?","closed_by":{"login":"DanielKinsman","id":15639,"node_id":"MDQ6VXNlcjE1NjM5","avatar_url":"https://avatars.githubusercontent.com/u/15639?v=4","gravatar_id":"","url":"https://api.github.com/users/DanielKinsman","html_url":"https://github.com/DanielKinsman","followers_url":"https://api.github.com/users/DanielKinsman/followers","following_url":"https://api.github.com/users/DanielKinsman/following{/other_user}","gists_url":"https://api.github.com/users/DanielKinsman/gists{/gist_id}","starred_url":"https://api.github.com/users/DanielKinsman/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/DanielKinsman/subscriptions","organizations_url":"https://api.github.com/users/DanielKinsman/orgs","repos_url":"https://api.github.com/users/DanielKinsman/repos","events_url":"https://api.github.com/users/DanielKinsman/events{/privacy}","received_events_url":"https://api.github.com/users/DanielKinsman/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/104298/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/godotengine/godot/issues/104298/timeline","performed_via_github_app":null,"state_reason":null}