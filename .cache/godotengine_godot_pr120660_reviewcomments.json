Z","html_url":"https://github.com/godotengine/godot/pull/120660#discussion_r3515976891","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/120660","_links":{"self":{"href":"https://api.github.com/repos/godotengine/godot/pulls/comments/3515976891"},"html":{"href":"https://github.com/godotengine/godot/pull/120660#discussion_r3515976891"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/120660"}},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/3515976891/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":null,"original_line":485,"side":"RIGHT","author_association":"CONTRIBUTOR","original_position":17,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/3515997766","pull_request_review_id":4621035781,"id":3515997766,"node_id":"PRRC_kwDOAO6SJc7Rkd5G","diff_hunk":"@@ -2008,32 +2100,48 @@ Error GDScriptCompiler::_parse_block(CodeGen &codegen, const GDScriptParser::Sui\n \t\t\t} break;\n \t\t\tcase GDScriptParser::Node::IF: {\n \t\t\t\tconst GDScriptParser::IfNode *if_n = static_cast<const GDScriptParser::IfNode *>(s);\n-\t\t\t\tGDScriptCodeGenerator::Address condition = _parse_expression(codegen, err, if_n->condition);\n+\n+\t\t\t\tgen->start_expr_cond_buffer(false);\n+\t\t\t\tgen->start_expr_cond_buffer(true);","path":"modules/gdscript/gdscript_compiler.cpp","commit_id":"48aa721f5818c9a2fbc532171d9c01741e564e33","original_commit_id":"48aa721f5818c9a2fbc532171d9c01741e564e33","user":{"login":"aurpine","id":12262539,"node_id":"MDQ6VXNlcjEyMjYyNTM5","avatar_url":"https://avatars.githubusercontent.com/u/12262539?v=4","gravatar_id":"","url":"https://api.github.com/users/aurpine","html_url":"https://github.com/aurpine","followers_url":"https://api.github.com/users/aurpine/followers","following_url":"https://api.github.co