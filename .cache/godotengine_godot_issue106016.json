ved_by":null},{"id":580537003,"node_id":"MDU6TGFiZWw1ODA1MzcwMDM=","url":"https://api.github.com/repos/godotengine/godot/labels/topic:gdextension","name":"topic:gdextension","color":"ffee88","default":false,"description":"","archived_at":null,"archived_by":null},{"id":3240950060,"node_id":"MDU6TGFiZWwzMjQwOTUwMDYw","url":"https://api.github.com/repos/godotengine/godot/labels/performance","name":"performance","color":"447777","default":false,"description":"","archived_at":null,"archived_by":null}],"state":"closed","locked":false,"assignees":[],"milestone":{"url":"https://api.github.com/repos/godotengine/godot/milestones/23","html_url":"https://github.com/godotengine/godot/milestone/23","labels_url":"https://api.github.com/repos/godotengine/godot/milestones/23/labels","id":12939969,"node_id":"MI_kwDOAO6SJc4AxXLB","number":23,"title":"4.6","description":"","creator":{"login":"Repiteo","id":17489292,"node_id":"MDQ6VXNlcjE3NDg5Mjky","avatar_url":"https://avatars.githubusercontent.com/u/17489292?v=4","gravatar_id":"","url":"https://api.github.com/users/Repiteo","html_url":"https://github.com/Repiteo","followers_url":"https://api.github.com/users/Repiteo/followers","following_url":"https://api.github.com/users/Repiteo/following{/other_user}","gists_url":"https://api.github.com/users/Repiteo/gists{/gist_id}","starred_url":"https://api.github.com/users/Repiteo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Repiteo/subscriptions","organizations_url":"https://api.github.com/users/Repiteo/orgs","repos_url":"https://api.github.com/users/Repiteo/repos","events_url":"https://api.github.com/users/Repiteo/events{/privacy}","received_events_url":"https://api.github.com/users/Repiteo/received_events","type":"User","user_view_type":"public","site_admin":false},"open_issues":3,"closed_issues":2978,"state":"closed","created_at":"2025-05-22T16:25:52Z","updated_at":"2026-10-04T16:23:23Z","due_on":null,"closed_at":"2026-01-26T18:09:14Z"},"comments":11,"created_at":"2025-05-02T11:56:38Z","updated_at":"2025-12-08T13:23:00Z","closed_at":"2025-12-03T22:55:55Z","assignee":null,"author_association":"MEMBER","issue_field_values":[],"type":null,"active_lock_reason":null,"draft":false,"pull_request":{"url":"https://api.github.com/repos/godotengine/godot/pulls/106016","html_url":"https://github.com/godotengine/godot/pull/106016","diff_url":"https://github.com/godotengine/godot/pull/106016.diff","patch_url":"https://github.com/godotengine/godot/pull/106016.patch","merged_at":"2025-12-03T22:55:55Z"},"body":"- Requires / Includes #105793.\r\n\r\n`GDType` is explained in the corresponding proposal: https://github.com/godotengine/godot-proposals/issues/12323.\r\n\r\nThis PR expands `GDType` to cover GDExtension added classes as well, by swapping the pointer when a GDExtension subtype is assigned to the `Object`. This eliminates branching and separate computation in typing functions such as `is_class`.\r\n\r\nThis should be merged relatively soon after, or even together with #105793, to eliminate the possibility of `GDType` being used in contexts assuming internal types only.\r\n\r\n### Explanation\r\n\r\n`Object` instances can get assigned a GDExtension 'subtype'. According to Godot's typing logic, this makes the `Object`'s new type the GDExtension's supplied type, i.e. a subtype of the builtin type. You can read more about this general idea here: https://github.com/godotengine/godot-proposals/issues/12155\r\n\r\nNote: Instances are usually assigned a GDExtension instance exactly once, right after the `Object` is created. When this happens, all we have to do is use the GDExtension's `GDType` instead of the builtin one.\r\n","closed_by":{"login":"Repiteo","id":17489292,"node_id":"MDQ6VXNlcjE3NDg5Mjky","avatar_url":"https://avatars.githubusercontent.com/u/17489292?v=4","gravatar_id":"","url":"https://api.github.com/users/Repiteo","html_url":"https://github.com/Repiteo","followers_url":"https://api.github.com/users/Repiteo/followers","following_url":"https://api.github.com/users/Repiteo/following{/other_user}","gists_url":"https://api.github.com/users/Repiteo/gists{/gist_id}","starred_url":"https://api.github.com/users/Repiteo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Repiteo/subscriptions","organizations_url":"https://api.github.com/users/Repiteo/orgs","repos_url":"https://api.github.com/users/Repiteo/repos","events_url":"https://api.github.com/users/Repiteo/events{/privacy}","received_events_url":"https://api.github.com/users/Repiteo/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/106016/reactions","total_count":9,"+1":9,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/godotengine/godot/issues/106016/timeline","performed_via_github_app":null,"state_reason":null}