iption":"","archived_at":null,"archived_by":null}],"state":"open","locked":false,"assignees":[],"milestone":{"url":"https://api.github.com/repos/godotengine/godot/milestones/16","html_url":"https://github.com/godotengine/godot/milestone/16","labels_url":"https://api.github.com/repos/godotengine/godot/milestones/16/labels","id":8237783,"node_id":"MI_kwDOAO6SJc4AfbLX","number":16,"title":"4.x","description":"Issues and pull requests slated for an undetermined Godot 4 release.","creator":{"login":"akien-mga","id":4701338,"node_id":"MDQ6VXNlcjQ3MDEzMzg=","avatar_url":"https://avatars.githubusercontent.com/u/4701338?v=4","gravatar_id":"","url":"https://api.github.com/users/akien-mga","html_url":"https://github.com/akien-mga","followers_url":"https://api.github.com/users/akien-mga/followers","following_url":"https://api.github.com/users/akien-mga/following{/other_user}","gists_url":"https://api.github.com/users/akien-mga/gists{/gist_id}","starred_url":"https://api.github.com/users/akien-mga/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/akien-mga/subscriptions","organizations_url":"https://api.github.com/users/akien-mga/orgs","repos_url":"https://api.github.com/users/akien-mga/repos","events_url":"https://api.github.com/users/akien-mga/events{/privacy}","received_events_url":"https://api.github.com/users/akien-mga/received_events","type":"User","user_view_type":"public","site_admin":false},"open_issues":5791,"closed_issues":0,"state":"open","created_at":"2022-07-26T12:42:05Z","updated_at":"2026-10-21T22:40:26Z","due_on":null,"closed_at":null},"comments":1,"created_at":"2026-07-07T01:31:37Z","updated_at":"2026-09-18T01:30:30Z","closed_at":null,"assignee":null,"author_association":"CONTRIBUTOR","issue_field_values":[],"type":null,"active_lock_reason":null,"draft":false,"pull_request":{"url":"https://api.github.com/repos/godotengine/godot/pulls/121025","html_url":"https://github.com/godotengine/godot/pull/121025","diff_url":"https://github.com/godotengine/godot/pull/121025.diff","patch_url":"https://github.com/godotengine/godot/pull/121025.patch","merged_at":null},"body":"Threaded resource loading could leak LoadToken / RefCounted items when using sub-threaded loading.\r\n\r\nCause: _run_load_task ignoring unreference() return values meaning some LoadToken could have no references but never reach cleanup.\r\n\r\n- Closes #120661 \r\n\r\nFix: Make all unreference() calls in _run_load_task final aware, and call memdelete at a safe point if the unreference() returns true. Also add a guard reference in _load_complete_inner that allows it to call _run_load_task and maintain ownership across the function once _run_load_task returns.\r\n\r\nTesting included logging at unreference sites prior to fix and tracking leaked objects hit one of the paths in load_complete_inner that ignored unreference returns. After the fix same logging showed no leaked objects and no errors or issues with resource loading.","closed_by":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/121025/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/godotengine/godot/issues/121025/timeline","performed_via_github_app":null,"state_reason":null}