t/labels/archived","name":"archived","color":"aaaaaa","default":false,"description":"","archived_at":null,"archived_by":null},{"id":279098219,"node_id":"MDU6TGFiZWwyNzkwOTgyMTk=","url":"https://api.github.com/repos/godotengine/godot/labels/topic:editor","name":"topic:editor","color":"ffee88","default":false,"description":"","archived_at":null,"archived_by":null},{"id":1332303119,"node_id":"MDU6TGFiZWwxMzMyMzAzMTE5","url":"https://api.github.com/repos/godotengine/godot/labels/regression","name":"regression","color":"ff63ac","default":false,"description":"","archived_at":null,"archived_by":null},{"id":2666708289,"node_id":"MDU6TGFiZWwyNjY2NzA4Mjg5","url":"https://api.github.com/repos/godotengine/godot/labels/topic:3d","name":"topic:3d","color":"ffee88","default":false,"description":"","archived_at":null,"archived_by":null}],"state":"closed","locked":false,"assignees":[],"milestone":null,"comments":1,"created_at":"2026-02-20T02:59:57Z","updated_at":"2026-02-26T14:46:51Z","closed_at":"2026-02-26T14:33:30Z","assignee":null,"author_association":"CONTRIBUTOR","issue_field_values":[],"type":null,"active_lock_reason":null,"draft":true,"pull_request":{"url":"https://api.github.com/repos/godotengine/godot/pulls/116518","html_url":"https://github.com/godotengine/godot/pull/116518","diff_url":"https://github.com/godotengine/godot/pull/116518.diff","patch_url":"https://github.com/godotengine/godot/pull/116518.patch","merged_at":null},"body":"<!--\r\nPlease target the `master` branch in priority.\r\n\r\nRelevant fixes are cherry-picked for stable branches as needed by maintainers.\r\n\r\nTo speed up the contribution process and avoid CI errors, please set up pre-commit hooks locally:\r\nhttps://contributing.godotengine.org/en/latest/engine/guidelines/code_style.html\r\n-->\r\n\r\nhttps://github.com/godotengine/godot/issues/116469\r\n\r\nCurrently a draft PR, until the origin of the problem is correctly identified and corrected.\r\nWell aware that I will have to do the following as I already messed up from the workflow:\r\nhttps://contributing.godotengine.org/en/latest/pull_requests/creating_pull_requests.html#issuing-a-pull-request:~:text=rebase%20your%20branch%20to%20squash%20some%20or%20all%20of%20the%20commits%20into%20one.\r\n\r\n<!--\r\n[2026-02-19, 21:58 UTC-5]\r\nCalling _draw_grid() and update_grid() earlier fixes the problem, so another process is most likely called earlier than previously was in v4.5.1-stable. Still investigating the issue.\r\n\r\n[2026-02-21, 00:03 UTC-5]\r\nIn ```void EditorNode::edit_item(Object *p_object, Object *p_editing_owner)```, the ```GridMapEditorPlugin``` enters ```to_over_edit.push_back(plugin);```. As a result, gets sent to ```_plugin_over_edit```, where:\r\n```\r\np_plugin->edit(p_object);\r\np_plugin->make_visible(true);\r\n```\r\nWhen switching between GridMaps, the plugin is already activated, and enters another if clause, where:\r\n```\r\np_plugin->make_visible(true);\r\np_plugin->edit(p_object);\r\n```\r\nThe second option works.\r\n\r\n[2026-02-24, 17:28 UTC-5]\r\nExpected process in EditorNode, undraft\r\n-->\r\n","closed_by":{"login":"zacharyhevey-cloud","id":244531157,"node_id":"U_kgDODpM_1Q","avatar_url":"https://avatars.githubusercontent.com/u/244531157?v=4","gravatar_id":"","url":"https://api.github.com/users/zacharyhevey-cloud","html_url":"https://github.com/zacharyhevey-cloud","followers_url":"https://api.github.com/users/zacharyhevey-cloud/followers","following_url":"https://api.github.com/users/zacharyhevey-cloud/following{/other_user}","gists_url":"https://api.github.com/users/zacharyhevey-cloud/gists{/gist_id}","starred_url":"https://api.github.com/users/zacharyhevey-cloud/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/zacharyhevey-cloud/subscriptions","organizations_url":"https://api.github.com/users/zacharyhevey-cloud/orgs","repos_url":"https://api.github.com/users/zacharyhevey-cloud/repos","events_url":"https://api.github.com/users/zacharyhevey-cloud/events{/privacy}","received_events_url":"https://api.github.com/users/zacharyhevey-cloud/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/116518/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/godotengine/godot/issues/116518/timeline","performed_via_github_app":null,"state_reason":null}