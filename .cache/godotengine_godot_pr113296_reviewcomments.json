[{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/2572649724","pull_request_review_id":3520212105,"id":2572649724,"node_id":"PRRC_kwDOAO6SJc6ZV4T8","diff_hunk":"@@ -242,7 +242,7 @@ void EditorBottomPanel::remove_item(Control *p_item) {\n \n void EditorBottomPanel::_on_button_visibility_changed(Button *p_button, EditorDock *p_dock) {\n \tif (p_button->is_visible()) {\n-\t\tp_dock->open();\n+\t\tp_dock->make_visible();","path":"editor/gui/editor_bottom_panel.cpp","commit_id":"270b14d862d7b22fe4bc729ff3f1215f43725017","original_commit_id":"270b14d862d7b22fe4bc729ff3f1215f43725017","user":{"login":"lodetrick","id":146759331,"node_id":"U_kgDOCL9eow","avatar_url":"https://avatars.githubusercontent.com/u/146759331?v=4","gravatar_id":"","url":"https://api.github.com/users/lodetrick","html_url":"https://github.com/lodetrick","followers_url":"https://api.github.com/users/lodetrick/followers","following_url":"https://api.github.com/users/lodetrick/following{/other_user}","gists_url":"https://api.github.com/users/lodetrick/gists{/gist_id}","starred_url":"https://api.github.com/users/lodetrick/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/lodetrick/subscriptions","organizations_url":"https://api.github.com/users/lodetrick/orgs","repos_url":"https://api.github.com/users/lodetrick/repos","events_url":"https://api.github.com/users/lodetrick/events{/privacy}","received_events_url":"https://api.github.com/users/lodetrick/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"I think this is one of the cases that `open()` is preferred. This code is meant to replicate how the bottom panel used to work, which tied the button's visibility to whether the dock is available, and `EditorBottomPanel::make_visible()` to whether it is visible. Typically `button->show()` would be paired with `make_visible(dock)`. In the cases where this is not true (ie only the button was shown), this shows an intention to not grab focus, and I think this should respect that.","created_at":"2025-11-28T23:24:48Z","updated_at":"2025-11-28T23:24:48Z","html_url":"https://github.com/godotengine/godot/pull/113296#discussion_r2572649724","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/113296","_links":{"self":{"href":"https://api.github.com/repos/godotengine/godot/pulls/comments/2572649724"},"html":{"href":"https://github.com/godotengine/godot/pull/113296#discussion_r2572649724"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/113296"}},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/2572649724/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":null,"original_line":245,"side":"RIGHT","author_association":"CONTRIBUTOR","original_position":5,"position":1,"subject_type":"line"}]