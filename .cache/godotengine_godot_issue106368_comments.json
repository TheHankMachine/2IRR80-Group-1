:"MDQ6VXNlcjgzMDk0ODc3","avatar_url":"https://avatars.githubusercontent.com/u/83094877?v=4","gravatar_id":"","url":"https://api.github.com/users/ReloKai","html_url":"https://github.com/ReloKai","followers_url":"https://api.github.com/users/ReloKai/followers","following_url":"https://api.github.com/users/ReloKai/following{/other_user}","gists_url":"https://api.github.com/users/ReloKai/gists{/gist_id}","starred_url":"https://api.github.com/users/ReloKai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/ReloKai/subscriptions","organizations_url":"https://api.github.com/users/ReloKai/orgs","repos_url":"https://api.github.com/users/ReloKai/repos","events_url":"https://api.github.com/users/ReloKai/events{/privacy}","received_events_url":"https://api.github.com/users/ReloKai/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-05-17T15:10:16Z","updated_at":"2025-05-17T15:10:16Z","body":"> Please supply a minimal reproduction project\n\nOK. Updated with MRP.","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2888447523/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2892021487","html_url":"https://github.com/godotengine/godot/issues/106368#issuecomment-2892021487","issue_url":"https://api.github.com/repos/godotengine/godot/issues/106368","id":2892021487,"node_id":"IC_kwDOAO6SJc6sYL7v","user":{"login":"Calinou","id":180032,"node_id":"MDQ6VXNlcjE4MDAzMg==","avatar_url":"https://avatars.githubusercontent.com/u/180032?v=4","gravatar_id":"","url":"https://api.github.com/users/Calinou","html_url":"https://github.com/Calinou","followers_url":"https://api.github.com/users/Calinou/followers","following_url":"https://api.github.com/users/Calinou/following{/other_user}","gists_url":"https://api.github.com/users/Calinou/gists{/gist_id}","starred_url":"https://api.github.com/users/Calinou/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Calinou/subscriptions","organizations_url":"https://api.github.com/users/Calinou/orgs","repos_url":"https://api.github.com/users/Calinou/repos","events_url":"https://api.github.com/users/Calinou/events{/privacy}","received_events_url":"https://api.github.com/users/Calinou/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-05-19T19:10:30Z","updated_at":"2025-05-19T19:12:02Z","body":"This is expected, as you're hitting the limit of physics ticks that can run every second at very high time scale factors. If you have RigidBodies active in the scene, you will notice they also move slower than they should given the time scale you specified.\n\nBy default, only 8 physics ticks can be simulated for every rendered frame to avoid \"physics spiral of death\" performance issues. You can adjust this limit in the Project Settings, but be careful when doing so. One way to work around this issue without increasing the number of physics steps per frame is to reduce the physics tick rate at runtime according to time scale. You can do so by calling `Engine.physics_ticks_per_second = roundi(60 / Engine.time_scale)` *after* setting `Engine.time_scale`.","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2892021487/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2892044778","html_url":"https://github.com/godotengine/godot/issues/106368#issuecomment-2892044778","issue_url":"https://api.github.com/repos/godotengine/godot/issues/106368","id":2892044778,"node_id":"IC_kwDOAO6SJc6sYRnq","user":{"login":"ReloKai","i