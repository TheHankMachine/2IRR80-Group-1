[{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3734203540","html_url":"https://github.com/godotengine/godot/issues/114848#issuecomment-3734203540","issue_url":"https://api.github.com/repos/godotengine/godot/issues/114848","id":3734203540,"node_id":"IC_kwDOAO6SJc7ek2yU","user":{"login":"TokageItLab","id":61938263,"node_id":"MDQ6VXNlcjYxOTM4MjYz","avatar_url":"https://avatars.githubusercontent.com/u/61938263?v=4","gravatar_id":"","url":"https://api.github.com/users/TokageItLab","html_url":"https://github.com/TokageItLab","followers_url":"https://api.github.com/users/TokageItLab/followers","following_url":"https://api.github.com/users/TokageItLab/following{/other_user}","gists_url":"https://api.github.com/users/TokageItLab/gists{/gist_id}","starred_url":"https://api.github.com/users/TokageItLab/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/TokageItLab/subscriptions","organizations_url":"https://api.github.com/users/TokageItLab/orgs","repos_url":"https://api.github.com/users/TokageItLab/repos","events_url":"https://api.github.com/users/TokageItLab/events{/privacy}","received_events_url":"https://api.github.com/users/TokageItLab/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-01-11T07:54:16Z","updated_at":"2026-01-11T07:54:16Z","body":"As mentioned in the updated title, this occurs because the child AnimationPlayer's process is interrupted when the parent AnimationPlayer stops.\n\nCurrently, available workarounds include extending the parent animation's duration by about 0.001 beyond the AnimationPlaybackTrack's end point, or moving the child Animation's MethodTrack keyframe back by 0.001.\n\nIn any case, I believe the AnimationPlaybackTrack will eventually need a rework similar to the AudioTrack at some point as I wrote in https://github.com/godotengine/godot-proposals/issues/8783.","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3734203540/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null}]