Ships/followers","following_url":"https://api.github.com/users/AThousandShips/following{/other_user}","gists_url":"https://api.github.com/users/AThousandShips/gists{/gist_id}","starred_url":"https://api.github.com/users/AThousandShips/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/AThousandShips/subscriptions","organizations_url":"https://api.github.com/users/AThousandShips/orgs","repos_url":"https://api.github.com/users/AThousandShips/repos","events_url":"https://api.github.com/users/AThousandShips/events{/privacy}","received_events_url":"https://api.github.com/users/AThousandShips/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"```suggestion\r\n\t\t\tThis information is used by [RenderingDevice] to figure out if a texture's contents can be discarded, eliminating unnecessary writes to memory and boosting performance.\r\n```\r\nSlightly less cumbersome sentence ","created_at":"2024-11-20T09:42:52Z","updated_at":"2024-11-20T09:50:50Z","html_url":"https://github.com/godotengine/godot/pull/98670#discussion_r1849968727","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/98670","_links":{"self":{"href":"https://api.github.com/repos/godotengine/godot/pulls/comments/1849968727"},"html":{"href":"https://github.com/godotengine/godot/pull/98670#discussion_r1849968727"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/98670"}},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/1849968727/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":null,"original_line":42,"side":"RIGHT","author_association":"MEMBER","original_position":6,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/1849971349","pull_request_review_id":2425273198,"id":1849971349,"node_id":"PRRC_kwDOAO6SJc5uRFKV","diff_hunk":"@@ -241,10 +238,11 @@\n \n \t\t\t\trd.draw_list_end()\n \t\t\t\t[/codeblock]\n+\t\t\t\tThe [param draw_flags] indicates if the texture attachments of the framebuffer should get cleared or ignored. Only one of both flags can be used for each individual attachment. Ignoring an attachment means that any contents that existed before the draw list will be completely discarded, reducing the memory bandwidth used by the render pass but producing garbage results if the pixels aren't replaced. The default behavior allows the engine to figure out the right operation to use if the texture is discardable, which can result in increased performance. See [RDTextureFormat] or [method texture_set_discardable].","path":"doc/classes/RenderingDevice.xml","commit_id":"6d5ac8f7ef4a3ddaf50720ab473b9dffece21674","original_commit_id":"6098df2b7ecc2edb9c8eab6ef69b9540b96fe11b","user":{"login":"AThousandShips","id":96648715,"node_id":"U_kgDOBcK-Cw","avatar_url":"https://avatars.githubusercontent.com/u/96648715?v=4","gravatar_id":"","url":"https://api.github.com/users/AThousandShips","html_url":"https://github.com/AThousandShips","followers_url":"https://api.github.com/users/AThousandShips/followers","following_url":"https://api.github.com/users/AThousandShips/following{/other_user}","gists_url":"https://api.github.com/users/AThousandShips/gists{/gist_id}","starred_url":"https://api.github.com/users/AThousandShips/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/AThousandShips/subscriptions","organizations_url":"https://api.github.com/users/AThousandShips/orgs","repos_url":"https://api.github.com/users/AThousandShips/repos","events_url":"https://api.github.com/users/AThousandShips/events{/privacy}","received_events_url":"https://api.github.com/users/AThousandShips/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"```suggestion\r\n\t\t\t\tThe [param draw_flags] indicates if the texture attachments of the framebuffer should be cleared or ignored. Only one of the two flags can be used for each individual attachment. Ignoring an attachment means that any contents that existed before the draw list will be completely discarded, reducing the memory bandwidth used by the render pass but producing garbage results if the pixels aren't replaced. The default behavior allows the engine to figure out the right operation to use if the texture is discardable, which can result in increased performance. See [RDTextureFormat] or [method texture_set_discardable].\r\n```","created_at":"2024-11-20T09:44:13Z","updated_at":"2024-11-20T09:50:50Z","html_url":"https://github.com/godotengine/godot/pull/98670#discussion_r1849971349","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/98670","_links":{"self":{"href":"https://api.github.com/repos/godotengine/godot/pulls/comments/1849971349"},"html":{"href":"https://github.com/godotengine/godot/pull/98670#discussion_r1849971349"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/98670"}},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/1849971349/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":null,"original_line":241,"side":"RIGHT","author_association":"MEMBER","original_position":35,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/1849972073","pull_request_review_id":2425273198,"id":1849972073,"node_id":"PRRC_kwDOAO6SJc5uRFVp","diff_hunk":"@@ -984,6 +989,16 @@\n \t\t\t\t[b]Note:[/b] [param to_texture] texture must [b]not[/b] be multisampled and must also be 2D (or a slice of a 3D/cubemap texture).\n \t\t\t</description>\n \t\t</method>\n+\t\t<method name=\"texture_set_discardable\">\n+\t\t\t<return type=\"void\" />\n+\t\t\t<param index=\"0\" name=\"texture\" type=\"RID\" />\n+\t\t\t<pa