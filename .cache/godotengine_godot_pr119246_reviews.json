[{"id":4290259916,"node_id":"PRR_kwDOAO6SJc7_uCvM","user":{"login":"TokageItLab","id":61938263,"node_id":"MDQ6VXNlcjYxOTM4MjYz","avatar_url":"https://avatars.githubusercontent.com/u/61938263?u=9b90963f1b4f17720e50bbbe495fbe8c84c8bc8e&v=4","gravatar_id":"","url":"https://api.github.com/users/TokageItLab","html_url":"https://github.com/TokageItLab","followers_url":"https://api.github.com/users/TokageItLab/followers","following_url":"https://api.github.com/users/TokageItLab/following{/other_user}","gists_url":"https://api.github.com/users/TokageItLab/gists{/gist_id}","starred_url":"https://api.github.com/users/TokageItLab/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/TokageItLab/subscriptions","organizations_url":"https://api.github.com/users/TokageItLab/orgs","repos_url":"https://api.github.com/users/TokageItLab/repos","events_url":"https://api.github.com/users/TokageItLab/events{/privacy}","received_events_url":"https://api.github.com/users/TokageItLab/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"To begin with, this isn’t a bug, and I believe this PR should never be merged. The blend point names in AnimationBlendSpace are managed separately from the assigned Animation.\n\nTo give a similar example, changing the animation assigned to an AnimationNodeAnimation placed within an AnimationNodeBlendTree does not change the name of the AnimationNode.\n\nAlso, you can place multiple instances of the same Animation within a BlendSpace, and they must have different names.\nChanging the point name when the assigned Animation resource is changed is clearly the wrong approach.","state":"CHANGES_REQUESTED","html_url":"https://github.com/godotengine/godot/pull/119246#pullrequestreview-4290259916","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/119246","author_association":"MEMBER","_links":{"html":{"href":"https://github.com/godotengine/godot/pull/119246#pullrequestreview-4290259916"},"pull