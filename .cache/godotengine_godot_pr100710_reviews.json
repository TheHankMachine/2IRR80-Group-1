ersions. \n\nI think this is the right way to expose these, but by nature these move implementation details into user-space. Since those implementation details will change as we optimize the renderer further and add new features we need to properly warn users. \n\nAt this point I am not willing to lock the layouts of these textures/buffers in stone so we need to make sure the warnings are especially strong. ","state":"CHANGES_REQUESTED","html_url":"https://github.com/godotengine/godot/pull/100710#pullrequestreview-3265279674","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/100710","author_association":"MEMBER","_links":{"html":{"href":"https://github.com/godotengine/godot/pull/100710#pullrequestreview-3265279674"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/100710"}},"submitted_at":"2025-09-25T02:08:38Z","commit_id":null},{"id":3266445704,"node_id":"PRR_kwDOAO6SJc7CsgGI","user":{"login":"AThousandShips","id":96648715,"node_id":"U_kgDOBcK-Cw","avatar_url":"https://avatars.githubusercontent.com/u/96648715?u=af70f5d107e9c1447f296643d5a566dab53d25e8&v=4","gravatar_id":"","url":"https://api.github.com/users/AThousandShips","html_url":"https://github.com/AThousandShips","followers_url":"https://api.github.com/users/AThousandShips/followers","following_url":"https://api.github.com/users/AThousandShips/following{/other_user}","gists_url":"https://api.github.com/users/AThousandShips/gists{/gist_id}","starred_url":"https://api.github.com/users/AThousandShips/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/AThousandShips/subscriptions","organizations_url":"https://api.github.com/users/AThousandShips/orgs","repos_url":"https://api.github.com/users/AThousandShips/repos","events_url":"https://api.github.com/users/AThousandShips/events{/privacy}","received_events_url":"https://api.github.com/users/AThousandShips/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"",