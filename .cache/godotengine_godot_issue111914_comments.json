[{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3432016729","html_url":"https://github.com/godotengine/godot/issues/111914#issuecomment-3432016729","issue_url":"https://api.github.com/repos/godotengine/godot/issues/111914","id":3432016729,"node_id":"IC_kwDOAO6SJc7MkGtZ","user":{"login":"AThousandShips","id":96648715,"node_id":"U_kgDOBcK-Cw","avatar_url":"https://avatars.githubusercontent.com/u/96648715?v=4","gravatar_id":"","url":"https://api.github.com/users/AThousandShips","html_url":"https://github.com/AThousandShips","followers_url":"https://api.github.com/users/AThousandShips/followers","following_url":"https://api.github.com/users/AThousandShips/following{/other_user}","gists_url":"https://api.github.com/users/AThousandShips/gists{/gist_id}","starred_url":"https://api.github.com/users/AThousandShips/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/AThousandShips/subscriptions","organizations_url":"https://api.github.com/users/AThousandShips/orgs","repos_url":"https://api.github.com/users/AThousandShips/repos","events_url":"https://api.github.com/users/AThousandShips/events{/privacy}","received_events_url":"https://api.github.com/users/AThousandShips/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-10-22T12:00:43Z","updated_at":"2025-10-22T12:00:43Z","body":"Please provide an MRP to make this easier to test and fix:\n- A small Godot project which reproduces the issue, with no unnecessary files included. Be sure to not include the `.godot` folder in the archive (but keep `project.godot`).\n- Having an MRP is very important for contributors to be able to reproduce the bug in the same way that you are experiencing it. When testing a potential fix for the issue, contributors will use the MRP to validate that the fix is working as intended.\n- Drag and drop a ZIP archive to upload it (max 10 MB). **Do not select another field until the project is done uploading.**\n- **Note for C# users:** If your issue is *not* C#-specific, please upload a minimal reproduction project written in GDScript. This will make it easier for contributors to reproduce the issue locally as not everyone has a .NET setup available. \n\nThis involves multiple moving parts so needs a minimal project to help ensure the steps are tested correctly and that the issue is understood fully","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3432016729/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3432123877","html_url":"https://github.com/godotengine/godot/issues/111914#issuecomment-3432123877","issue_url":"https://api.github.com/repos/godotengine/godot/issues/111914","id":3432123877,"node_id":"IC_kwDOAO6SJc7Mkg3l","user":{"login":"DonutWrecker","id":67188697,"node_id":"MDQ6VXNlcjY3MTg4Njk3","avatar_url":"https://avatars.githubusercontent.com/u/67188697?v=4","gravatar_id":"","url":"https://api.github.com/users/DonutWrecker","html_url":"https://github.com/DonutWrecker","followers_url":"https://api.github.com/users/DonutWrecker/followers","following_url":"https://api.github.com/users/DonutWrecker/following{/other_user}","gists_url":"https://api.github.com/users/DonutWrecker/gists{/gist_id}","starred_url":"https://api.github.com/users/DonutWrecker/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/DonutWrecker/subscriptions","organizations_url":"https://api.github.com/users/DonutWrecker/orgs","repos_url":"https://api.github.com/users/DonutWrecker/repos","events_url":"https://api.github.com/users/DonutWrecker/events{/privacy}","received_events_url":"https://api.github.com/users/DonutWrecker/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-10-22T12:30:06Z","updated_at":"2025-10-22T12:30:06Z","body":"> Please provide an MRP to make this easier to test and fix:\n> \n>     * A small Godot project which reproduces the issue, with no unnecessary files included. Be sure to not include the `.godot` folder in the archive (but keep `project.godot`).\n> \n>     * Having an MRP is very important for contributors to be able to reproduce the bug in the same way that you are experiencing it. When testing a potential fix for the issue, contributors will use the MRP to validate that the fix is working as intended.\n> \n>     * Drag and drop a ZIP archive to upload it (max 10 MB). **Do not select another field until the project is done uploading.**\n> \n>     * **Note for C# users:** If your issue is _not_ C#-specific, please upload a minimal reproduction project written in GDScript. This will make it easier for contributors to reproduce the issue locally as not everyone has a .NET setup available.\n> \n> \n> This involves multiple moving parts so needs a minimal project to help ensure the steps are tested correctly and that the issue is understood fully\n\nAdded a test project and written the script in gdscript.","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3432123877/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3432225476","html_url":"https://github.com/godotengine/godot/issues/111914#issuecomment-3432225476","issue_url":"https://api.github.com/repos/godotengine/godot/issues/111914","id":3432225476,"node_id":"IC_kwDOAO6SJc7Mk5rE","user":{"login":"arkology","id":43543909,"node_id":"MDQ6VXNlcjQzNTQzOTA5","avatar_url":"https://avatars.githubusercontent.com/u/43543909?v=4","gravatar_id":"","url":"https://api.github.com/users/arkology","html_url":"https://github.com/arkology","followers_url":"https://api.github.com/users/arkology/followers","following_url":"https://api.github.com/users/arkology/following{/other_user}","gists_url":"https://api.github.com/users/arkology/gists{/gist_id}","starred_url":"https://api.github.com/users/arkology/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/arkology/subscriptions","organizations_url":"https://api.github.com/users/arkology/orgs","repos_url":"https://api.github.com/users/arkology/repos","events_url":"https://api.github.com/users/arkology/events{/privacy}","received_events_url":"https://api.github.com/users/arkology/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-10-22T12:53:28Z","updated_at":"2025-10-22T13:53:46Z","body":"> pivot_offset is set to 50, 50\n\nI opened MRP and ... pivot offset is (0, 0), not (50, 50)\nI set is to (50, 50) by myself and now it scales from center, as expected.\nGodot version: v4.6.dev2.official [7864ac801]","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3432225476/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3432245574","html_url":"https://github.com/godotengine/godot/issues/111914#issuecomment-3432245574","issue_url":"https://api.github.com/repos/godotengine/godot/issues/111914","id":3432245574,"node_id":"IC_kwDOAO6SJc7Mk-lG","user":{"login":"arkology","id":43543909,"node_id":"MDQ6VXNlcjQzNTQzOTA5","avatar_url":"https://avatars.githubusercontent.com/u/43543909?v=4","gravatar_id":"","url":"https://api.github.com/users/arkology","html_url":"https://github.com/arkology","followers_url":"https://api.github.com/users/arkology/followers","following_url":"https://api.github.com/users/arkology/following{/other_user}","gists_url":"https://api.github.c