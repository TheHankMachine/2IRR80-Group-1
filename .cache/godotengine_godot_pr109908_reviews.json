[{"id":3149186187,"node_id":"PRR_kwDOAO6SJc67tMSL","user":{"login":"YYF233333","id":67693830,"node_id":"MDQ6VXNlcjY3NjkzODMw","avatar_url":"https://avatars.githubusercontent.com/u/67693830?u=5127cb92ac85d3db01550c026a62da13254bd17e&v=4","gravatar_id":"","url":"https://api.github.com/users/YYF233333","html_url":"https://github.com/YYF233333","followers_url":"https://api.github.com/users/YYF233333/followers","following_url":"https://api.github.com/users/YYF233333/following{/other_user}","gists_url":"https://api.github.com/users/YYF233333/gists{/gist_id}","starred_url":"https://api.github.com/users/YYF233333/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/YYF233333/subscriptions","organizations_url":"https://api.github.com/users/YYF233333/orgs","repos_url":"https://api.github.com/users/YYF233333/repos","events_url":"https://api.github.com/users/YYF233333/events{/privacy}","received_events_url":"https://api.github.com/users/YYF233333/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"","state":"COMMENTED","html_url":"https://github.com/godotengine/godot/pull/109908#pullrequestreview-3149186187","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/109908","author_association":"CONTRIBUTOR","_links":{"html":{"href":"https://github.com/godotengine/godot/pull/109908#pullrequestreview-3149186187"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/109908"}},"submitted_at":"2025-08-24T06:04:08Z","commit_id":"b356bc1a36b321dc4e604bcbd55a2357ba411fdd"},{"id":3150657566,"node_id":"PRR_kwDOAO6SJc67yzge","user":{"login":"Ivorforce","id":2308167,"node_id":"MDQ6VXNlcjIzMDgxNjc=","avatar_url":"https://avatars.githubusercontent.com/u/2308167?u=f7f8e0273f784f5ec6f6b7fe4a88d449896eb48a&v=4","gravatar_id":"","url":"https://api.github.com/users/Ivorforce","html_url":"https://github.com/Ivorforce","followers_url":"https://api.github.com/users/Ivorforce/followers","following_url":"https://api.github.com/users/Ivorforce/following{/other_user}","gists_url":"https://api.github.com/users/Ivorforce/gists{/gist_id}","starred_url":"https://api.github.com/users/Ivorforce/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Ivorforce/subscriptions","organizations_url":"https://api.github.com/users/Ivorforce/orgs","repos_url":"https://api.github.com/users/Ivorforce/repos","events_url":"https://api.github.com/users/Ivorforce/events{/privacy}","received_events_url":"https://api.github.com/users/Ivorforce/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"I don't think we should change code in this way.\r\n\r\nWhile resizing and exchanging can be faster than pushing back repeatedly, it's not guaranteed to be faster. This is because `resize` on `Array` needs to initialize every `Variant` element to `NIL`, and then unnecessarily check the type when replacing elements. This means needing to iterate the array twice. Add this to Clay's point of avoiding to optimize code that may not need optimization, and it's a risk I personally wouldn't take over the potential benefit.\r\n\r\nA lot of the code you're trying to optimize is a simple conversion operation. Instead of naively optimizing conversions in-place, we should adopt high performance conversion functions. They can be written in a way not to exhibit the same dual iteration problem, and additionally will make the code easier to read.\r\nWe have two open pull requests under discussion to add conversion functions (https://github.com/godotengine/godot/pull/96622 and https://github.com/godotengine/godot/pull/100496). I'm confident we'll finalize them in the 4.6 dev cycle. When we do, they can be used in the spots you found here.","state":"CHANGES_REQUESTED","html_url":"https://github.com/godotengine/godot/pull/109908#pullrequestreview-3150657566","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/109908","author_association":"MEMBER","_links":{"html":{"href":"https://github.com/godotengine/godot/pull/109908#pullrequestreview-3150657566"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/109908"}},"submitted_at":"2025-08-25T09:38:55Z","commit_id":"b356bc1a36b321dc4e604bcbd55a2357ba411fdd"}]