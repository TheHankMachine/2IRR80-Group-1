[{"id":3730705525,"node_id":"PRR_kwDOAO6SJc7eXgx1","user":{"login":"raulsntos","id":3903059,"node_id":"MDQ6VXNlcjM5MDMwNTk=","avatar_url":"https://avatars.githubusercontent.com/u/3903059?u=1b0467024f137e562b21748eb6bf12f97dfa5bf6&v=4","gravatar_id":"","url":"https://api.github.com/users/raulsntos","html_url":"https://github.com/raulsntos","followers_url":"https://api.github.com/users/raulsntos/followers","following_url":"https://api.github.com/users/raulsntos/following{/other_user}","gists_url":"https://api.github.com/users/raulsntos/gists{/gist_id}","starred_url":"https://api.github.com/users/raulsntos/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/raulsntos/subscriptions","organizations_url":"https://api.github.com/users/raulsntos/orgs","repos_url":"https://api.github.com/users/raulsntos/repos","events_url":"https://api.github.com/users/raulsntos/events{/privacy}","received_events_url":"https://api.github.com/users/raulsntos/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"Success status codes other than 0 aren't really expected. We expect Godot to be the only one initializing the .NET host and that should only happen once. It feels weird to change the initialization to accept a scenario we don't support.\r\n\r\nHowever, I think it's fine to make this change since they're not exactly failure status codes, so we may as well be more forgiving. The only thing I would want is to at least log it somewhere (at least when verbose logging is enabled).","state":"COMMENTED","html_url":"https://github.com/godotengine/godot/pull/115654#pullrequestreview-3730705525","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/115654","author_association":"MEMBER","_links":{"html":{"href":"https://github.com/godotengine/godot/pull/115654#pullrequestreview-3730705525"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/115654"}},"submitted_at":"2026-01-30T22:28:50Z","commit_id":"