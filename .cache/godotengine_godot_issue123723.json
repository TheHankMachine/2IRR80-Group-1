ed_by":null},{"id":279098255,"node_id":"MDU6TGFiZWwyNzkwOTgyNTU=","url":"https://api.github.com/repos/godotengine/godot/labels/topic:platforms","name":"topic:platforms","color":"ffee88","default":false,"description":"","archived_at":null,"archived_by":null},{"id":1327318271,"node_id":"MDU6TGFiZWwxMzI3MzE4Mjcx","url":"https://api.github.com/repos/godotengine/godot/labels/crash","name":"crash","color":"885544","default":false,"description":"","archived_at":null,"archived_by":null}],"state":"closed","locked":false,"assignees":[],"milestone":{"url":"https://api.github.com/repos/godotengine/godot/milestones/25","html_url":"https://github.com/godotengine/godot/milestone/25","labels_url":"https://api.github.com/repos/godotengine/godot/milestones/25/labels","id":15520464,"node_id":"MI_kwDOAO6SJc4A7NLQ","number":25,"title":"4.8","description":"","creator":{"login":"Repiteo","id":17489292,"node_id":"MDQ6VXNlcjE3NDg5Mjky","avatar_url":"https://avatars.githubusercontent.com/u/17489292?v=4","gravatar_id":"","url":"https://api.github.com/users/Repiteo","html_url":"https://github.com/Repiteo","followers_url":"https://api.github.com/users/Repiteo/followers","following_url":"https://api.github.com/users/Repiteo/following{/other_user}","gists_url":"https://api.github.com/users/Repiteo/gists{/gist_id}","starred_url":"https://api.github.com/users/Repiteo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Repiteo/subscriptions","organizations_url":"https://api.github.com/users/Repiteo/orgs","repos_url":"https://api.github.com/users/Repiteo/repos","events_url":"https://api.github.com/users/Repiteo/events{/privacy}","received_events_url":"https://api.github.com/users/Repiteo/received_events","type":"User","user_view_type":"public","site_admin":false},"open_issues":345,"closed_issues":2336,"state":"open","created_at":"2026-04-13T15:59:35Z","updated_at":"2026-10-22T08:21:32Z","due_on":null,"closed_at":null},"comments":4,"created_at":"2026-09-22T18:45:02Z","updated_at":"2026-10-19T21:52:53Z","closed_at":"2026-10-19T20:57:33Z","assignee":null,"author_association":"NONE","issue_field_values":[],"type":null,"active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"### Tested versions\n\nGodot 4.7.2.stable.official (ed1daf0bf), official macOS build\nAlso present on current master (0f1b62b7) — same code\n\n### System information\n\nmacOS 26.6.2, Apple M4 Pro \n\n### Issue description\n\nOn macOS, launching the engine with --embedded outside the editor crashes immediately with signal 11, before anything is rendered. It happens with the default Metal driver and with --rendering-driver opengl3, in a brand new empty project.\n\nThe backtrace points repeatedly at mvk::SPIRVToMSLConverter::convert (MoltenVK), which is misleading — the crash happens before any shader work; the symbolizer appears to be resolving to the nearest exported symbol.\n\nThe cause looks like a null dereference: the DisplayServerMacOSEmbedded constructor in platform/macos/display_server_macos_embedded.mm calls EngineDebugger::get_singleton()->send_message(\"game_view:set_context_id\", ...), and that singleton only exists when the editor launched the process. There are six more unguarded send_message calls in the same file (mouse mode, warp mouse, IME, cursor). OS_MacOS_Embedded::alert() in platform/macos/os_macos.mm already null-checks before the same kind of call.\n\nCrash:\n```\nhandle_crash: Program crashed with signal 11\nEngine version: Godot Engine v4.7.2.stable.official (ed1daf0bf001b61586d9930840f2f1394092c079)\n[1] libsystem_platform.dylib - _sigtramp + 56\n[2] mvk::SPIRVToMSLConverter::convert(...)\n[3] mvk::SPIRVToMSLConverter::convert(...)\n````\n\n### Steps to reproduce\n\n- On macOS, create a new empty project (one empty scene set as the main scene is enough). Nothing else in it.\n- Quit the editor. The project must not be running from it - the crash is about running without the editor attached.\n- From a terminal, run the official Godot binary directly on that project with the --embedded flag:\n/Applications/Godot.app/Contents/MacOS/Godot --embedded --path /path/to/project --quit-after 120\n\nExpected: the project runs with no window of its own, as it does when the editor embeds it.\nActual: it crashes immediately with Program crashed with signal 11, before anything renders. Exit code 134.\n\n### Minimal reproduction project (MRP)\n\nN/A","closed_by":{"login":"Repiteo","id":17489292,"node_id":"MDQ6VXNlcjE3NDg5Mjky","avatar_url":"https://avatars.githubusercontent.com/u/17489292?v=4","gravatar_id":"","url":"https://api.github.com/users/Repiteo","html_url":"https://github.com/Repiteo","followers_url":"https://api.github.com/users/Repiteo/followers","following_url":"https://api.github.com/users/Repiteo/following{/other_user}","gists_url":"https://api.github.com/users/Repiteo/gists{/gist_id}","starred_url":"https://api.github.com/users/Repiteo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Repiteo/subscriptions","organizations_url":"https://api.github.com/users/Repiteo/orgs","repos_url":"https://api.github.com/users/Repiteo/repos","events_url":"https://api.github.com/users/Repiteo/events{/privacy}","received_events_url":"https://api.github.com/users/Repiteo/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/123723/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/godotengine/godot/issues/123723/timeline","performed_via_github_app":null,"state_reason":"completed","pinned_comment":null}