[{"id":2726922780,"node_id":"PRR_kwDOAO6SJc6iiYoc","state":"COMMENTED","user":{"site_admin":false,"suspended":false,"updated_at":"0001-01-01T00:00:00Z","avatar_url":"https://avatars.githubusercontent.com/u/180032?u=68d23e7ee9cdf810da125e8510b72f845b9dccc8&v=4","created_at":"0001-01-01T00:00:00Z","followers":0,"following":0,"html_url":"https://github.com/Calinou","id":180032,"node_id":"MDQ6VXNlcjE4MDAzMg==","login":"Calinou","type":"User","owned_private_repos":0,"public_gists":0,"public_repos":0,"total_private_repos":0,"url":"https://api.github.com/users/Calinou"},"body":"","html_url":"https://github.com/godotengine/godot/pull/104213#pullrequestreview-2726922780","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/104213","author_association":"MEMBER","submitted_at":"2025-03-28T22:01:36Z"},{"id":2726993095,"node_id":"PRR_kwDOAO6SJc6iipzH","state":"APPROVED","user":{"site_admin":false,"suspended":false,"updated_at":"0001-01-01T00:00:00Z","avatar_url":"https://avatars.githubusercontent.com/u/180032?u=68d23e7ee9cdf810da125e8510b72f845b9dccc8&v=4","created_at":"0001-01-01T00:00:00Z","followers":0,"following":0,"html_url":"https://github.com/Calinou","id":180032,"node_id":"MDQ6VXNlcjE4MDAzMg==","login":"Calinou","type":"User","owned_private_repos":0,"public_gists":0,"public_repos":0,"total_private_repos":0,"url":"https://api.github.com/users/Calinou"},"body":"Tested locally, it works as expected.\r\n\r\nShortcuts still tend to be prone to misinputs as they'll be effective if you press a navigation key *then* enter freelook without releasing the key. Ideally, we should make all shortcuts that can potentially conflict with freelook effective on key release, rather than on key press (or, perhaps better, cancel the shortcut's action if freelook was entered before the key was released). This issue is not specific to GridMap shortcuts; it also happens with the <kbd>QWER</kbd> shortcuts to switch between selection modes.\r\n\r\nEither way, this is still an usability improvement over what we have now.","html_url":"https://github.com/godotengine/godot/pull/104213#pullrequestreview-2726993095","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/104213","author_association":"MEMBER","submitted_at":"2025-03-28T22:53:26Z"}]