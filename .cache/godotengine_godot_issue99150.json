pull/99150.patch","merged_at":"2025-06-09T17:54:33Z"},"body":"```gdscript\r\nextends Node\r\n\r\nfunc _ready() -> void:\r\n    print(load.bind([]).call())\r\n```\r\n\r\nBefore:\r\n\r\n```\r\nInvalid type in function '@GDScript::load (Callable) (Callable)'. Cannot convert argument 1 from Callable to String.\r\n```\r\n\r\nAfter:\r\n\r\n```\r\nInvalid type in function '@GDScript::load (Callable)'. Cannot convert argument 1 from Array to String.\r\n```\r\n\r\n`GDScriptFunction::_get_call_error()` is an extension of `Variant::get_call_error_text()`, so a `Callable` version is needed for GDScript, just like `Variant::get_callable_error_text()`. Perhaps in the future we should refactor this.\r\n\r\nhttps://github.com/godotengine/godot/blob/cb411fa960f0b7fdbd97dcdb4c90f9346360ee0e/core/variant/variant.cpp#L3629-L3684","closed_by":{"login":"Repiteo","id":17489292,"node_id":"MDQ6VXNlcjE3NDg5Mjky","avatar_url":"https://avatars.githubusercontent.com/u/17489292?v=4","gravatar_id":"","url":"https://api.github.com/users/Repiteo","html_url":"https://github.com/Repiteo","followers_url":"https://api.github.com/users/Repiteo/followers","following_url":"https://api.github.com/users/Repiteo/following{/other_user}","gists_url":"https://api.github.com/users/Repiteo/gists{/gist_id}","starred_url":"https://api.github.com/users/Repiteo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Repiteo/subscriptions","organizations_url":"https://api.github.com/users/Repiteo/orgs","repos_url":"https://api.github.com/users/Repiteo/repos","events_url":"https://api.github.com/users/Repiteo/events{/privacy}","received_events_url":"https://api.github.com/users/Repiteo/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/99150/reactions","total_count":5,"+1":5,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/godotengine/g