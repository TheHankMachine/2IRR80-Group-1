mments/3633215812/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3636784976","html_url":"https://github.com/godotengine/godot/pull/113713#issuecomment-3636784976","issue_url":"https://api.github.com/repos/godotengine/godot/issues/113713","id":3636784976,"node_id":"IC_kwDOAO6SJc7YxO9Q","user":{"login":"Mrfanta-stick","id":105064999,"node_id":"U_kgDOBkMqJw","avatar_url":"https://avatars.githubusercontent.com/u/105064999?v=4","gravatar_id":"","url":"https://api.github.com/users/Mrfanta-stick","html_url":"https://github.com/Mrfanta-stick","followers_url":"https://api.github.com/users/Mrfanta-stick/followers","following_url":"https://api.github.com/users/Mrfanta-stick/following{/other_user}","gists_url":"https://api.github.com/users/Mrfanta-stick/gists{/gist_id}","starred_url":"https://api.github.com/users/Mrfanta-stick/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Mrfanta-stick/subscriptions","organizations_url":"https://api.github.com/users/Mrfanta-stick/orgs","repos_url":"https://api.github.com/users/Mrfanta-stick/repos","events_url":"https://api.github.com/users/Mrfanta-stick/events{/privacy}","received_events_url":"https://api.github.com/users/Mrfanta-stick/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-12-10T12:10:27Z","updated_at":"2025-12-10T12:10:27Z","body":"@AThousandShips Thanks so much for the real-time review! I've tried and pushed fixes for the whitespace/comment style issues and corrected the include placement.\r\n\r\nRegarding the includes: I was being overly aggressive with the #ifdef wrapping because I wanted to ensure strict isolation of the module dependencies. I didn't realize the main header needed to remain exposed to satisfy the self-contained header rule.\r\n\r\nAppreciate your patience—I'm st