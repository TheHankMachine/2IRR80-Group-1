thub.com/users/dsnopek/gists{/gist_id}","starred_url":"https://api.github.com/users/dsnopek/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/dsnopek/subscriptions","organizations_url":"https://api.github.com/users/dsnopek/orgs","repos_url":"https://api.github.com/users/dsnopek/repos","events_url":"https://api.github.com/users/dsnopek/events{/privacy}","received_events_url":"https://api.github.com/users/dsnopek/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-01-13T13:54:05Z","updated_at":"2026-01-13T14:02:41Z","body":"> I still think it's important to know whether extension unloading is supported.\r\n\r\nLoading and unloading extensions at runtime should work. And, in fact, is a requirement for implementing https://github.com/godotengine/godot/pull/97991, however, that doesn't need to work in release builds. I would expect that needing to unload a GDExtension in a release build to be very uncommon.","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3744461420/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3746362815","html_url":"https://github.com/godotengine/godot/pull/105319#issuecomment-3746362815","issue_url":"https://api.github.com/repos/godotengine/godot/issues/105319","id":3746362815,"node_id":"IC_kwDOAO6SJc7fTPW_","user":{"login":"HolonProduction","id":99511741,"node_id":"U_kgDOBe5tvQ","avatar_url":"https://avatars.githubusercontent.com/u/99511741?v=4","gravatar_id":"","url":"https://api.github.com/users/HolonProduction","html_url":"https://github.com/HolonProduction","followers_url":"https://api.github.com/users/HolonProduction/followers","following_url":"https://api.github.com/users/HolonProduction/following{/other_user}","gists_url":"https:/