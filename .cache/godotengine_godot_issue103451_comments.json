api.github.com/users/Calinou/followers","following_url":"https://api.github.com/users/Calinou/following{/other_user}","gists_url":"https://api.github.com/users/Calinou/gists{/gist_id}","starred_url":"https://api.github.com/users/Calinou/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Calinou/subscriptions","organizations_url":"https://api.github.com/users/Calinou/orgs","repos_url":"https://api.github.com/users/Calinou/repos","events_url":"https://api.github.com/users/Calinou/events{/privacy}","received_events_url":"https://api.github.com/users/Calinou/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-07-03T23:36:54Z","updated_at":"2025-07-03T23:38:48Z","body":"I can't reproduce this on 4.5.beta 9b22b4153 (Linux + NVIDIA):\n\n![Image](https://github.com/user-attachments/assets/54743954-3474-4966-96e9-171122032b11)\n\nNote that this is all I can see in the project, since I don't have the means to compile Godot with C# support enabled right now (since the MRP uses C#).\n\nOne guess as to why you're encountering an issue would be LOD generation, which has been tweaked in 4.4. It's possible that it formerly didn't affect your (low-poly) meshes, but it does now. Consider disabling **Meshes > Generate LODs** in the Import dock to prevent this.","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3033946028/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3075921529","html_url":"https://github.com/godotengine/godot/issues/103451#issuecomment-3075921529","issue_url":"https://api.github.com/repos/godotengine/godot/issues/103451","id":3075921529,"node_id":"IC_kwDOAO6SJc63VtZ5","user":{"login":"Calinou","id":180032,"node_id":"MDQ6VXNlcjE4MDAzMg==","avatar_url":"https://avatars.githubusercontent.com/u/180032?v=4","gravatar_id":"","url":"https://api.github.com/users/Calinou","html_url":"https://github.com/Calinou","followers_url":"https://api.github.com/users/Calinou/followers","following_url":"https://api.github.com/users/Calinou/following{/other_user}","gists_url":"https://api.github.com/users/Calinou/gists{/gist_id}","starred_url":"https://api.github.com/users/Calinou/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Calinou/subscriptions","organizations_url":"https://api.github.com/users/Calinou/orgs","repos_url":"https://api.github.com/users/Calinou/repos","events_url":"https://api.github.com/users/Calinou/events{/privacy}","received_events_url":"https://api.github.com/users/Calinou/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-07-15T22:19:06Z","updated_at":"2025-07-15T22:19:06Z","body":"I've tested 4.5.beta3.mono on the MRP and it still looks correct.\n\nIf you increase Mesh LOD Threshold in the Project Settings, it will eventually lead to a broken mesh but at the default setting, the mesh won't visibly look broken even when far away.\n\nThis was likely fixed by #106446, similar to https://github.com/godotengine/godot/issues/57608.\n\nhttps://github.com/user-attachments/assets/55554cc7-9e4c-4dc1-beab-5a105c8a3db7","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3075921529/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null}]