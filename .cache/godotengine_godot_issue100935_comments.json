mimi/orgs","repos_url":"https://api.github.com/users/Nomimi/repos","events_url":"https://api.github.com/users/Nomimi/events{/privacy}","received_events_url":"https://api.github.com/users/Nomimi/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-01-01T18:42:39Z","updated_at":"2025-01-01T18:52:09Z","body":"> What if you launch it with a different rendering driver?\n> \n> ```\n> godot executable --rendering-driver <driver>\n> ```\n> \n> For available options, see\n> \n> ```\n> godot executable --rendering-driver ?\n> ```\n> \n> Also, what display and rendering driver does it use by default for your configuration?\n\nWhere and how would I use that? The command console gives me an Error with both a direct quote and with my Godot file name. Also wanted to use a shortcut with start parameters, but with the question mark that made no sense to me....\n\n![Image](https://github.com/user-attachments/assets/d4c7114a-b304-47cb-b4e0-f7b5bf4aa5ac)\n","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2567108162/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2567114804","html_url":"https://github.com/godotengine/godot/issues/100935#issuecomment-2567114804","issue_url":"https://api.github.com/repos/godotengine/godot/issues/100935","id":2567114804,"node_id":"IC_kwDOAO6SJc6ZAxA0","user":{"login":"ghost","id":10137,"node_id":"MDQ6VXNlcjEwMTM3","avatar_url":"https://avatars.githubusercontent.com/u/10137?v=4","gravatar_id":"","url":"https://api.github.com/users/ghost","html_url":"https://github.com/ghost","followers_url":"https://api.github.com/users/ghost/followers","following_url":"https://api.github.com/users/ghost/following{/other_user}","gists_url":"https://api.github.com/users/ghost/gists{/gist_id}","starred_url":"https://api.github.com/users/ghost/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/ghost/subscriptions","organizations_url":"https://api.github.com/users/ghost/orgs","repos_url":"https://api.github.com/users/ghost/repos","events_url":"https://api.github.com/users/ghost/events{/privacy}","received_events_url":"https://api.github.com/users/ghost/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-01-01T19:07:07Z","updated_at":"2025-01-01T19:11:26Z","body":"'godot executable' was not meant to be taken literally.\n\nIt was just a reference to the path to the executable.\n\nAs an example...\n\n```\n/home/ment/Godot_v4.4-dev7_mono_linux.x86_64 --rendering-driver ?\n```\n\nI do not know your file system's layout, nor where you placed the Godot executable. Hence writing it as 'godot executable'. Sorry for any confusion.\n\nThe question mark is just there to give --rendering-driver an invalid input. So it will tell you the available options.","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2567114804/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2571402273","html_url":"https://github.com/godotengine/godot/issues/100935#issuecomment-2571402273","issue_url":"https://api.github.com/repos/godotengine/godot/issues/100935","id":2571402273,"node_id":"IC_kwDOAO6SJc6ZRHwh","user":{"login":"Nomimi","id":10810410,"node_id":"MDQ6VXNlcjEwODEwNDEw","avatar_url":"https://avatars.githubusercontent.com/u/10810410?v=4","gravatar_id":"","url":"https://api.github.com/users/Nomimi","html_url":"https://github.com/Nomimi","followers_url":"https://api.github.com/users/Nomimi/followers","following_url":"https://api.github.com/users/Nomimi/following{/other_user}","gists_url":"https://api.github.com/users/Nomimi/gists{/gist_id}","starred_url":"https://api.github.com/users/Nomimi/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Nomimi/subscriptions","organizations_url":"https://api.github.com/users/Nomimi/orgs","repos_url":"https://api.github.com/users/Nomimi/repos","events_url":"https://api.github.com/users/Nomimi/events{/privacy}","received_events_url":"https://api.github.com/users/Nomimi/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-01-04T20:20:57Z","updated_at":"2025-01-05T17:10:33Z","body":"\n\n\n> 'godot executable' was not meant to be taken literally.\n> \n> It was just a reference to the path to the executable.\n> \n> As an example...\n> \n> ```\n> /home/ment/Godot_v4.4-dev7_mono_linux.x86_64 --rendering-driver ?\n> ```\n> \n> I do not know your file system's layout, nor where you placed the Godot executable. Hence writing it as 'godot executable'. Sorry for any confusion.\n> \n> The question mark is just there to give --rendering-driver an invalid input. So it will tell you the available options.\n\nHehe, yeah I guessed that but seems like I somehow failed to execute the cmd from inside the folder. Whatever! It worked now. \n\n![Image](https://github.com/user-attachments/assets/cfcb6906-a52e-49ee-857d-d17734dce751)\n\nI tried opengl and it seems to be a workaround... Not sure About Default, but ig vulkan","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2571402273/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2584259128","html_url":"https://github.com/godotengine/godot/issues/100935#issuecomment-2584259128","issue_url":"https://api.github.com/repos/godotengine/godot/issues/100935","id":258