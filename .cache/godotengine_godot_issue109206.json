received_events","type":"User","user_view_type":"public","site_admin":false},"open_issues":3,"closed_issues":3687,"state":"closed","created_at":"2024-12-19T08:51:28Z","updated_at":"2026-09-04T21:48:38Z","due_on":"2025-09-15T00:00:00Z","closed_at":"2025-09-18T17:13:14Z"},"comments":0,"created_at":"2025-08-01T18:34:35Z","updated_at":"2025-08-29T17:07:54Z","closed_at":"2025-08-29T17:06:41Z","assignee":null,"author_association":"NONE","issue_field_values":[],"type":null,"active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"### Tested versions\n\n- Reproducible in: 4.4.1.stable\n\n### System information\n\nGodot v4.4.1.stable - macOS Sequoia (15.5.0) - Single-window, 2 monitors - Metal (Forward+) - integrated Apple M2 Max (Apple8) - Apple M2 Max (12 threads)\n\n### Issue description\n\nIn 3D editor toolbar, there the first 4 tools are <img width=\"137\" height=\"41\" alt=\"Image\" src=\"https://github.com/user-attachments/assets/98e79f6f-a83e-4324-937b-b35628905b52\" /> Select, Move, Rotate, and Scale. They all have an LMB dragging event modified by cmd (ctrl on Windows or Linux?), where if you hold cmd and drag in Select mode, you will be rotating the object selected, and the expected behavior for the rest of the 3 tools should be enabling snapping.\n\n<img width=\"475\" height=\"120\" alt=\"Image\" src=\"https://github.com/user-attachments/assets/e28d4e81-77d1-4e29-937f-2171b4fa7fbe\" />\n\n<img width=\"452\" height=\"78\" alt=\"Image\" src=\"https://github.com/user-attachments/assets/af1d0a29-f1a9-4c63-bb23-1468cd1bf0b1\" />\n\nHowever, cmd + drag only works in Select Mode (rotating), but none of the other 3 modes (snapping) on macOS. When you hold cmd, the dragging behavior seems exactly the same as plain dragging without any modifier key. However, the Use Snap tool (<img width=\"112\" height=\"57\" alt=\"Image\" src=\"https://github.com/user-attachments/assets/e02a8328-b172-483b-bdd7-4503e1c9b2fa\" />) works properly, so this issue only affects the cmd + dragging shortcut.\n\n### Steps to reproduce\n\nSelect a random MeshInstance3D in a 3D editor and try cmd+dragging in different modes.\n\n### Minimal reproduction project (MRP)\n\nN/A","closed_by":{"login":"Repiteo","id":17489292,"node_id":"MDQ6VXNlcjE3NDg5Mjky","avatar_url":"https://avatars.githubusercontent.com/u/17489292?v=4","gravatar_id":"","url":"https://api.github.com/users/Repiteo","html_url":"https://github.com/Repiteo","followers_url":"https://api.github.com/users/Repiteo/followers","following_url":"https://api.github.com/users/Repiteo/following{/other_user}","gists_url":"https://api.github.com/users/Repiteo/gists{/gist_id}","starred_url":"https://api.github.com/users/Repiteo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Repiteo/subscriptions","organizations_url":"https://api.github.com/users/Repiteo/orgs","repos_url":"https://api.github.com/users/Repiteo/repos","events_url":"https://api.github.com/users/Repiteo/events{/privacy}","received_events_url":"https://api.github.com/users/Repiteo/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/109206/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/godotengine/godot/issues/109206/timeline","performed_via_github_app":null,"state_reason":"completed","pinned_comment":null}