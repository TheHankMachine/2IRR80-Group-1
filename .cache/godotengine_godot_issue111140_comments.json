[{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3358597439","html_url":"https://github.com/godotengine/godot/pull/111140#issuecomment-3358597439","issue_url":"https://api.github.com/repos/godotengine/godot/issues/111140","id":3358597439,"node_id":"IC_kwDOAO6SJc7IMCE_","user":{"login":"YeldhamDev","id":30739239,"node_id":"MDQ6VXNlcjMwNzM5MjM5","avatar_url":"https://avatars.githubusercontent.com/u/30739239?v=4","gravatar_id":"","url":"https://api.github.com/users/YeldhamDev","html_url":"https://github.com/YeldhamDev","followers_url":"https://api.github.com/users/YeldhamDev/followers","following_url":"https://api.github.com/users/YeldhamDev/following{/other_user}","gists_url":"https://api.github.com/users/YeldhamDev/gists{/gist_id}","starred_url":"https://api.github.com/users/YeldhamDev/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/YeldhamDev/subscriptions","organizations_url":"https://api.github.com/users/YeldhamDev/orgs","repos_url":"https://api.github.com/users/YeldhamDev/repos","events_url":"https://api.github.com/users/YeldhamDev/events{/privacy}","received_events_url":"https://api.github.com/users/YeldhamDev/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-10-02T00:22:51Z","updated_at":"2025-10-02T00:22:51Z","body":"I was the middle of adding the disambiguation on my PR as well. :stuck_out_tongue: Surprised you also didn't use the Variable font here as you suggested there.\r\n\r\nAlso, wouldn't be better to enable even if a custom font is picked? It's probably desirable in that case too, and the Inter font would still keep it when it appears as a fallback.","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3358597439/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/rep