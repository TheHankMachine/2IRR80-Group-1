s://api.github.com/repos/godotengine/godot/labels/needs%20testing","name":"needs testing","color":"ffcc44","default":false,"description":"","archived_at":null,"archived_by":null}],"state":"open","locked":false,"assignees":[],"milestone":{"url":"https://api.github.com/repos/godotengine/godot/milestones/16","html_url":"https://github.com/godotengine/godot/milestone/16","labels_url":"https://api.github.com/repos/godotengine/godot/milestones/16/labels","id":8237783,"node_id":"MI_kwDOAO6SJc4AfbLX","number":16,"title":"4.x","description":"Issues and pull requests slated for an undetermined Godot 4 release.","creator":{"login":"akien-mga","id":4701338,"node_id":"MDQ6VXNlcjQ3MDEzMzg=","avatar_url":"https://avatars.githubusercontent.com/u/4701338?v=4","gravatar_id":"","url":"https://api.github.com/users/akien-mga","html_url":"https://github.com/akien-mga","followers_url":"https://api.github.com/users/akien-mga/followers","following_url":"https://api.github.com/users/akien-mga/following{/other_user}","gists_url":"https://api.github.com/users/akien-mga/gists{/gist_id}","starred_url":"https://api.github.com/users/akien-mga/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/akien-mga/subscriptions","organizations_url":"https://api.github.com/users/akien-mga/orgs","repos_url":"https://api.github.com/users/akien-mga/repos","events_url":"https://api.github.com/users/akien-mga/events{/privacy}","received_events_url":"https://api.github.com/users/akien-mga/received_events","type":"User","user_view_type":"public","site_admin":false},"open_issues":5790,"closed_issues":0,"state":"open","created_at":"2022-07-26T12:42:05Z","updated_at":"2026-10-22T08:16:48Z","due_on":null,"closed_at":null},"comments":1,"created_at":"2026-10-08T16:36:01Z","updated_at":"2026-10-10T08:26:20Z","closed_at":null,"assignee":null,"author_association":"NONE","issue_field_values":[],"type":null,"active_lock_reason":null,"draft":false,"pull_request":{"url":"https://api.github.com/repos/godotengine/godot/pulls/124291","html_url":"https://github.com/godotengine/godot/pull/124291","diff_url":"https://github.com/godotengine/godot/pull/124291.diff","patch_url":"https://github.com/godotengine/godot/pull/124291.patch","merged_at":null},"body":"## What problem(s) does this PR solve?\r\n\r\n`ResourceSaver` skips uids for `[ext_resource]` references. This is inconsistent with how a `.tscn` stores it:\r\n```ini\r\n[ext_resource type=\"Resource\" uid=\"uid://co1jtfqqh4rq0\" path=\"res://child.tres\" id=\"2_0xm2m\"]\r\n```\r\nInstead we get:\r\n```ini\r\n[ext_resource type=\"Resource\" path=\"res://child.tres\" id=\"2_0xm2m\"]\r\n```\r\n\r\n## Additional information\r\n\r\n- Closes: godotengine/godot/issues/124319\r\n\r\n### Underlying cause\r\n\r\n`ResourceSaver` accepts a uid finder *callback* via [`set_get_resource_id_for_path`](https://github.com/godotengine/godot/blob/e7b12e749220a75ef87e800e080bd2732ad46854/core/io/resource_saver.cpp#L292) which is happily utilized by the [`EditorFileSystem`](https://github.com/godotengine/godot/blob/e7b12e749220a75ef87e800e080bd2732ad46854/editor/file_system/editor_file_system.cpp#L3801).\r\n\r\nThe problem arises when it's not the editor writing a `.tscn`, but a runtime writing a `.tres`, hence no uid finder callback.","closed_by":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/124291/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/godotengine/godot/issues/124291/timeline","performed_via_github_app":null,"state_reason":null}