2/repos","events_url":"https://api.github.com/users/uno1982/events{/privacy}","received_events_url":"https://api.github.com/users/uno1982/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-05-01T06:17:10Z","updated_at":"2025-05-01T06:17:10Z","body":"@MJacred @AThousandShips \nhttps://github.com/godotengine/godot/pull/105972\nhttps://github.com/uno1982/AndroidContReproduction/tree/testing-fix-custom-4.4?tab=readme-ov-file","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2844180949/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2844657752","html_url":"https://github.com/godotengine/godot/issues/105956#issuecomment-2844657752","issue_url":"https://api.github.com/repos/godotengine/godot/issues/105956","id":2844657752,"node_id":"IC_kwDOAO6SJc6pjghY","user":{"login":"MJacred","id":6639237,"node_id":"MDQ6VXNlcjY2MzkyMzc=","avatar_url":"https://avatars.githubusercontent.com/u/6639237?v=4","gravatar_id":"","url":"https://api.github.com/users/MJacred","html_url":"https://github.com/MJacred","followers_url":"https://api.github.com/users/MJacred/followers","following_url":"https://api.github.com/users/MJacred/following{/other_user}","gists_url":"https://api.github.com/users/MJacred/gists{/gist_id}","starred_url":"https://api.github.com/users/MJacred/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/MJacred/subscriptions","organizations_url":"https://api.github.com/users/MJacred/orgs","repos_url":"https://api.github.com/users/MJacred/repos","events_url":"https://api.github.com/users/MJacred/events{/privacy}","received_events_url":"https://api.github.com/users/MJacred/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-05-01T11:10:36Z","updated_at":"2025-05-01T11:10:36Z","body":"I'm not familiar with how Android specifically handles joypads, but in general there is never special engine code for a specific joypad.  \nEven if it would fix the issue for your specific device, another PS4/PS5 could fail: The button numbers can change depending on the firmware of the joypad. So if anyone has a different version, it would break again.  \nIn Godot, we use these two files to make joypad buttons work as intended:\n* https://github.com/godotengine/godot/blob/master/core/input/gamecontrollerdb.txt\n* https://github.com/godotengine/godot/blob/master/core/input/godotcontrollerdb.txt\n\n\nSee related issues\n* https://github.com/godotengine/godot/issues/38048\n* https://github.com/godotengine/godot/issues/67920\n* https://github.com/godotengine/godot/issues/67127\n\nYou can test your joypad with e.g. this app on Android https://play.google.com/store/apps/details?id=uk.co.powgames.gamecondiag (please note: this is just a random example app, which has not been tested or verified in any way. you can use any you like)","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2844657752/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2844881502","html_url":"https://github.com/godotengine/godot/issues/105956#issuecomment-2844881502","issue_url":"https://api.github.com/repos/godotengine/godot/issues/105956","id":2844881502,"node_id":"IC_kwDOAO6SJc6pkXJe","user":{"login":"uno1982","id":45907836,"node_id":"MDQ6VXNlcjQ1OTA3ODM2","avatar_url":"https://avatars.githubusercontent.com/u/45907836?v=4","gravatar_id":"","url":"https://api.github.com/users/uno1982","html_url":"https://github.com/uno1982","followers_url":"https://api.github.com/users/uno1982/followers","following_url":"https://api.github.com/users/uno1982/following{/other_user}","gists_url":"https://api.github.com/users/uno1982/gists{/gist_id}","starred_url":"https://api.github.com/users/uno1982/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/uno1982/subscriptions","organizations_url":"https://api.github.com/users/uno1982/orgs","repos_url":"https://api.github.com/users/uno1982/repos","events_url":"https://api.github.com/users/uno1982/events{/privacy}","received_events_url":"https://api.github.com/users/uno1982/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-05-01T13:49:39Z","updated_at":"2025-05-01T13:49:39Z","body":"Thanks for the update on this. I’ll look into it further and see if there is a similar path to follow for the resolution…. Thanks again ","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2844881502/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2844908703","html_url":"https://github.com/godotengine/godot/issues/105956#issuecomment-2844908703","issue_url":"https://api.github.com/repos/godotengine/godot/issues/105956","id":2844908703,"node_id":"IC_kwDOAO6SJc6pkdyf","user":{"login":"Alex2782","id":41921395,"node_id":"MDQ6VXNlcjQxOTIxMzk1","avatar_url":"https://avatars.githubusercontent.com/u/41921395?v=4","gravatar_id":"","url":"https://api.github.com/users/Alex2782","html_url":"https://github.com/Alex2782","followers_url":"https://api.github.com/users/Alex2782/followers","following_url":"https://api.github.com/users/Alex2782/following{/other_user}","gists_url":"https://api.github.com/users/Alex2782/gists{/gist_id}","starred_url":"https://api.github.com/users/Alex2782/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Alex2782/subscriptions","organizations_url":"https://api.github.com/users/Alex2782/orgs","repos_url":"https://api.github.com/users/Alex2782/repos","events_url":"https://api.github.com/users/Alex2782/events{/privacy}","received_events_url":"https://api.github.com/users/Alex2782/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-05-01T14:05:38Z","updated_at":"2025-05-01T14:18:41Z","body":"We need to check this part more closely, probably mapping (bug fix) would have to be done there (https://github.com/godotengine/godot/pull/105972#issuecomment-2844900630)\n\nhttps://github.com/godotengine/godot/blob/80a3d205f1ad22e779a64921fb56d62b893881ae/platform/android/java/lib/src/org/godotengine/godot/input/GodotInputHandler.java#L481-L483\n\n\n> p_button = -86\n\nhttps://developer.android.com/reference/android/view/KeyEvent#KEYCODE_BUTTON_1\n\n```\nKey code constant: Generic Game Pad Button #1.\nConstant Value: 188 (0x000000bc)\n```\n\n---------------------\n\n`-86+188-20 = 82`\nhttps://developer.android.com/reference/android/view/KeyEvent#KEYCODE_MENU\n> Key code constant: Menu key.\n> Constant Value: 82 (0x00000052)\n\n(i think)","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2844908703/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2844941877","html_url":"https://github.com/godotengine/godot/issues/105956#issuecomment-2844941877","issue_url":"https://api.github.com/repos/godotengine/godot/issues/105956","id":2844941877,"node_id":"IC_kwDOAO6SJc6pkl41","user":{"login":"uno1982","id":45907836,"node_id":"MDQ6VXNlcjQ1OTA3ODM2","avatar_url":"https://avatars.githubusercontent.com/u/45907836?v=4","gravatar_id":"","url":"https://api.github.com/users/uno1982","html_url":"https://github.com/uno1982","followers_url":"https://api.github.com/users/uno1982/followers","following_url":"https://api.github.com/users/uno1982/following{/other_user}","gists_url":"https://api.github.com/users/uno1982/gists{/gist_id}","starred_url":"https://api.github.com/users/uno1982/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/uno1982/subscriptions","organizations_url":"https://api.github.com/users/uno1982/orgs","repos_url":"https://api.github.com/users/uno1982/repos","events_url":"https://api.github.com/users/uno1982/events{/privacy}","received_events_url":"https://api.github.com/users/uno1982/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-05-01T14:24:24Z","updated_at":"2025-05-01T14:26:29Z","body":"> We need to check this part more closely, probably mapping (bug fix) would have to be done there ([#105972 (comment)](https://github.com/godotengine/godot/pull/105972#issuecomment-2844900630))\n> \n> [godot/platform/android/java/lib/src/org/godotengine/godot/input/GodotInputHandler.java](https://github.com/godotengine/godot/blob/80a3d205f1ad22e779a64921fb56d62b893881ae/platform/android/java/lib/src/org/godotengine/godot/input/GodotInputHandler.java#L481-L483)\n> \n> Lines 481 to 483 in [80a3d20](/godotengine/godot/commit/80a3d205f1ad22e779a64921fb56d62b893881ae)\n> \n>  default: \n>  \tbutton = keyCode - KeyEvent.KEYCODE_BUTTON_1 + 20; \n>  \tbreak; \n> > p_button = -86\n> \n> https://developer.android.com/reference/android/view/KeyEvent#KEYCODE_BUTTON_1\n> \n> ```\n> Key code constant: Generic Game Pad Button #1.\n> Constant Value: 188 (0x000000bc)\n> ```\n> \n> `-86+188-20 = 82` https://developer.android.com/reference/android/view/KeyEvent#KEYCODE_MENU\n> \n> > Key code constant: Menu key.\n> > Constant Value: 82 (0x00000052)\n> \n> (i think)\n\nWell that was why I approched it in this way because the index was completely out of range but as @MJacred pointed out there is a GUID db file that godot uses and when testing on Android vs Windows I see the following.\nOn windows when testing\nName: PS5 Controller\nGUID: 030000004c050000e60c000000000000\n\nOn Android when testing\nJoypad ID: 0\nName: DualSense Wireless Controller\nGUID: 4475616c53656e736520576972656c65\n\nI'm digging further into fixing this via updating the db mappings vs making code changes to the input handler if possible. ","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2844941877/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2844984976","html_url":"https://github.com/godotengine/godot/issues/105956#issuecomment-2844984976","issue_url":"https://api.github.com/repos/godotengine/godot/issues/105956","id":2844984976,"node_id":"IC_kwDOAO6SJc6pkwaQ","user":{"login":"Alex2782","id":41921395,"node_id":"MDQ6VXNlcjQxOTIxMzk1","avatar_url":"https://avatars.githubusercontent.com/u/41921395?v=4","gravatar_id":"","url":"https://api.github.com/users/Alex2782","html_url":"https://github.com/Alex2782","followers_url":"https://api.github.com/users/Alex2782/followers","following_url":"https://api.github.com/users/Alex2782/following{/other_user}","gists_url":"https://api.github.com/users/Alex2782/gists{/gist_id}","starred_url":"https://api.github.com/users/Alex2782/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Alex2782/subscriptions","organizations_url":"https://api.github.com/users/Alex2782/orgs","repos_url":"https://api.github.com/users/Alex2782/repos","events_url":"https://api.github.com/users/Alex2782/events{/privacy}","received_events_url":"https://api.github.com/users/Alex2782/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-05-01T14:47:17Z","updated_at":"2025-05-01T14:47:17Z","body":"> I'm digging further into fixing this via updating the db mappings\n\nNote, the data is passed to core->input and negative values ​​are not allowed.\n\n```cpp\n\t\tif ((int)p_button == -86) {\n\t\t\t// Map to correct joypad button 6\n\t\t\tp_button = (JoyButton)6;\n\t\t} else if ((int)p_button == -164) {\n\t\t\t// Map to correct joypad button 4\n\t\t\tp_button = (JoyButton)4;\n```\n\nmapping in a Java file (Android), simply expand here, pass more keycode constants (if there are any)\n\n\n```java\n\t\t\tcase KeyEvent.KEYCODE_BUTTON_SELECT:\n\t\t\t\tbutton = 4;\n\t\t\t\tbreak;\n\t\t\tcase KeyEvent.KEYCODE_BUTTON_START:\n\t\t\t\tbutton = 6;\n\t\t\t\tbreak;\n```\n\n","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2844984976/reactions","total_count":3,"+1":2,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":1,"eyes":0},"performed_via_github_app":null,"minimized":null}]