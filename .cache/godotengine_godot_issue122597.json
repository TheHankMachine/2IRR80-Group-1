9098009,"node_id":"MDU6TGFiZWwyNzkwOTgwMDk=","url":"https://api.github.com/repos/godotengine/godot/labels/topic:buildsystem","name":"topic:buildsystem","color":"ffee88","default":false,"description":"","archived_at":null,"archived_by":null},{"id":2304948121,"node_id":"MDU6TGFiZWwyMzA0OTQ4MTIx","url":"https://api.github.com/repos/godotengine/godot/labels/topic:codestyle","name":"topic:codestyle","color":"ffee88","default":false,"description":"","archived_at":null,"archived_by":null}],"state":"closed","locked":false,"assignees":[],"milestone":{"url":"https://api.github.com/repos/godotengine/godot/milestones/25","html_url":"https://github.com/godotengine/godot/milestone/25","labels_url":"https://api.github.com/repos/godotengine/godot/milestones/25/labels","id":15520464,"node_id":"MI_kwDOAO6SJc4A7NLQ","number":25,"title":"4.8","description":"","creator":{"login":"Repiteo","id":17489292,"node_id":"MDQ6VXNlcjE3NDg5Mjky","avatar_url":"https://avatars.githubusercontent.com/u/17489292?v=4","gravatar_id":"","url":"https://api.github.com/users/Repiteo","html_url":"https://github.com/Repiteo","followers_url":"https://api.github.com/users/Repiteo/followers","following_url":"https://api.github.com/users/Repiteo/following{/other_user}","gists_url":"https://api.github.com/users/Repiteo/gists{/gist_id}","starred_url":"https://api.github.com/users/Repiteo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Repiteo/subscriptions","organizations_url":"https://api.github.com/users/Repiteo/orgs","repos_url":"https://api.github.com/users/Repiteo/repos","events_url":"https://api.github.com/users/Repiteo/events{/privacy}","received_events_url":"https://api.github.com/users/Repiteo/received_events","type":"User","user_view_type":"public","site_admin":false},"open_issues":343,"closed_issues":2335,"state":"open","created_at":"2026-04-13T15:59:35Z","updated_at":"2026-10-22T06:28:22Z","due_on":null,"closed_at":null},"comments":0,"created_at":"2026-08-19T14:46:39Z","updated_at":"2026-10-20T21:23:03Z","closed_at":"2026-10-20T21:22:57Z","assignee":null,"author_association":"CONTRIBUTOR","issue_field_values":[],"type":null,"active_lock_reason":null,"draft":false,"pull_request":{"url":"https://api.github.com/repos/godotengine/godot/pulls/122597","html_url":"https://github.com/godotengine/godot/pull/122597","diff_url":"https://github.com/godotengine/godot/pull/122597.diff","patch_url":"https://github.com/godotengine/godot/pull/122597.patch","merged_at":"2026-10-20T21:22:57Z"},"body":"- Related: #122412\r\n\r\n## What problem(s) does this PR solve?\r\n\r\nAs the above PR notes in point 7, Emscripten now requires a minimum of Python 3.10, up from our current default of 3.9. While this only applies to web builds, I believe there's a discussion to be had on making this our overall minimum version as well. Most pertinently: 3.10 will be reaching EOL later this year[^1], with 3.9 being EOL for a year by that point.\r\n\r\nAs noted in #116550, Locking our minimum to 3.9 would be closer to what SCons will eventually be doing. However, SCons has been taking longer than expected to bump versions, so this ruleset we originally intended to adopt hasn't been put in practice, so I wouldn't say we're beholden to it. We'd still be fairly behind the curve overall by making an EOL a minimum, but it'd keep us *somewhat* synced with other Python tooling, such as mypy which can finally use its latest version once more.\r\n\r\nA 3.10 minimum means we can safely retire the `from __future__ import annotations` imports, as all the typing syntax goodies that came with it are now natively available. The other changes brought by this import are no longer the direction the python team is pursuing, instead opting for deferred resolution of imports[^2]. While we're a long ways off from that import being deprecated, there's no harm in making the that transition as smooth as possible by nipping it in the bud thanks to a 3.10 minimum.\r\n\r\n## Additional information\r\n\r\nPrek hook version bumps:\r\n- mypy (1.19.1 → 2.3.1)\r\n- ruff (0.15.20 → 0.16.3)\r\n\r\n[^1]: https://devguide.python.org/versions/\r\n[^2]: https://peps.python.org/pep-0749/","closed_by":{"login":"Repiteo","id":17489292,"node_id":"MDQ6VXNlcjE3NDg5Mjky","avatar_url":"https://avatars.githubusercontent.com/u/17489292?v=4","gravatar_id":"","url":"https://api.github.com/users/Repiteo","html_url":"https://github.com/Repiteo","followers_url":"https://api.github.com/users/Repiteo/followers","following_url":"https://api.github.com/users/Repiteo/following{/other_user}","gists_url":"https://api.github.com/users/Repiteo/gists{/gist_id}","starred_url":"https://api.github.com/users/Repiteo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Repiteo/subscriptions","organizations_url":"https://api.github.com/users/Repiteo/orgs","repos_url":"https://api.github.com/users/Repiteo/repos","events_url":"https://api.github.com/users/Repiteo/events{/privacy}","received_events_url":"https://api.github.com/users/Repiteo/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/122597/reactions","total_count":2,"+1":2,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/godotengine/godot/issues/122597/timeline","performed_via_github_app":null,"state_reason":null}