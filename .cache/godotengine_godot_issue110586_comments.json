s crash too. \n\nMac OS X 10.15.7\n\nHere is the stack trace, but as @AlexandraMercier says, the likely culprit seems to be #105507 \n\ncc @bruvzg \n\n```\nThread 0 Crashed:: Dispatch queue: com.apple.main-thread\n0   dyld                          \t0x000000011aaa605e __abort_with_payload + 10\n1   dyld                          \t0x000000011aacf6ed abort_with_payload_wrapper_internal + 80\n2   dyld                          \t0x000000011aacf71f abort_with_payload + 9\n3   dyld                          \t0x000000011aaccd74 dyld::halt(char const*) + 463\n4   dyld                          \t0x000000011aa54bc3 dyld::fastBindLazySymbol(ImageLoader**, unsigned long) + 140\n5   libdyld.dylib                 \t0x00007fff70adf692 dyld_stub_binder + 282\n6   ???                           \t0x000000011514d000 0 + 4648652800\n7   org.godotengine.godot         \t0x000000011024b65c ColorPicker::_notification(int) + 1180\n8   org.godotengine.godot         \t0x0000000112750d92 Object::_notification_forward(int) + 18\n9   org.godotengine.godot         \t0x0000000110023d6c CanvasItem::_handle_visibility_change(bool) + 60\n10  org.godotengine.godot         \t0x0000000112754594 Object::emit_signalp(StringName const&, Variant const**, int) + 1316\n11  org.godotengine.godot         \t0x00000001101993a2 Window::set_visible(bool) + 770\n12  org.godotengine.godot         \t0x000000011019ecab Window::popup(Rect2i const&) + 683\n13  org.godotengine.godot         \t0x0000000110269c3c ColorPickerButton::pressed() + 364\n```","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3313307839/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3313345263","html_url":"https://github.com/godotengine/godot/issues/110586#issuecomment-3313345263","issue_url":"https://api.github.com/repos/godotengine/godot/issues/110586","id":3313345263,"node_id":"IC_kwDOAO6SJc7FfaLv","user":{"login":"bruvzg","id":7645683,"node_id":"MDQ6VXNlcjc2NDU2ODM=","avatar_url":"https://avatars.githubusercontent.com/u/7645683?v=4","gravatar_id":"","url":"https://api.github.com/users/bruvzg","html_url":"https://github.com/bruvzg","followers_url":"https://api.github.com/users/bruvzg/followers","following_url":"https://api.github.com/users/bruvzg/following{/other_user}","gists_url":"https://api.github.com/users/bruvzg/gists{/gist_id}","starred_url":"https://api.github.com/users/bruvzg/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/bruvzg/subscriptions","organizations_url":"https://api.github.com/users/bruvzg/orgs","repos_url":"https://api.github.com/users/bruvzg/repos","events_url":"https://api.github.com/users/bruvzg/events{/privacy}","received_events_url":"https://api.github.com/users/bruvzg/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-09-19T18:33:07Z","updated_at":"2025-09-19T18:33:07Z","body":"API is documented as 10.15+ (https://developer.apple.com/documentation/coregraphics/cgpreflightscreencaptureaccess()?language=objc), but I have found few mentions that it's only available on 11+, so `@available` checks probably should be adjusted accordingly.","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3313345263/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3333403599","html_url":"https://github.com/godotengine/godot/issues/110586#issuecomment-3333403599","issue_url":"https://api.github.com/repos/godotengine/godot/issues/110586","id":3333403599,"node_id":"IC_kwDOAO6SJc7Gr7PP","user":{"login":"alanw","id":85800,"node_id":"MDQ6VXNlcjg1ODAw","avatar_url":"https://avatars.githubusercontent.com/u/85800?v=4","gravatar_id":"","url":"https://api.github.com/users/alanw","html_url":"https://github.com/alanw","followers_url":"https://api.github.com/users/alanw/followers","following_url":"https://api.github.com/users/alanw/following{/other_user}","gists_url":"https://api.github.com/users/alanw/gists{/gist_id}","starred_url":"https://api.github.com/users/alanw/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/alanw/subscriptions","organizations_url":"https://api.github.com/users/alanw/orgs","repos_url":"https://api.github.com/users/alanw/repos","events_url":"https://api.github.com/users/alanw/events{/privacy}","received_events_url":"https://api.github.com/users/alanw/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-09-25T10:58:22Z","updated_at":"2025-09-25T10:58:22Z","body":"Thanks for assigning this to yourself @bruvzg. I'm hoping this can be fixed for 4.5.1 maintenance release?\n\nHaving done some more digging, I found this: https://stackoverflow.com/questions/56597221/detecting-screen-recording-settings-on-macos-catalina#comment122639193_58985069\n\nWhich pointed to a confirmed bug in OS X 10.15: https://developer.apple.com/forums/thread/683860?answerId=684400022#684400022\n\nIt looks like bumping `@available` to 11+ as you suggested will fix this.\n\n","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3333403599/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null}]