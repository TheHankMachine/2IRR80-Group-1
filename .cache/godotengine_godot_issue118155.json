2NzA4Mjg5","url":"https://api.github.com/repos/godotengine/godot/labels/topic:3d","name":"topic:3d","color":"ffee88","default":false,"description":"","archived_at":null,"archived_by":null}],"state":"closed","locked":false,"assignees":[],"milestone":{"url":"https://api.github.com/repos/godotengine/godot/milestones/24","html_url":"https://github.com/godotengine/godot/milestone/24","labels_url":"https://api.github.com/repos/godotengine/godot/milestones/24/labels","id":14236899,"node_id":"MI_kwDOAO6SJc4A2Tzj","number":24,"title":"4.7","description":"","creator":{"login":"akien-mga","id":4701338,"node_id":"MDQ6VXNlcjQ3MDEzMzg=","avatar_url":"https://avatars.githubusercontent.com/u/4701338?v=4","gravatar_id":"","url":"https://api.github.com/users/akien-mga","html_url":"https://github.com/akien-mga","followers_url":"https://api.github.com/users/akien-mga/followers","following_url":"https://api.github.com/users/akien-mga/following{/other_user}","gists_url":"https://api.github.com/users/akien-mga/gists{/gist_id}","starred_url":"https://api.github.com/users/akien-mga/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/akien-mga/subscriptions","organizations_url":"https://api.github.com/users/akien-mga/orgs","repos_url":"https://api.github.com/users/akien-mga/repos","events_url":"https://api.github.com/users/akien-mga/events{/privacy}","received_events_url":"https://api.github.com/users/akien-mga/received_events","type":"User","user_view_type":"public","site_admin":false},"open_issues":3,"closed_issues":2535,"state":"closed","created_at":"2025-11-27T20:29:18Z","updated_at":"2026-10-20T18:39:31Z","due_on":null,"closed_at":"2026-06-19T16:54:35Z"},"comments":6,"created_at":"2026-04-03T12:38:17Z","updated_at":"2026-05-12T07:59:12Z","closed_at":"2026-05-11T22:14:59Z","assignee":null,"author_association":"CONTRIBUTOR","issue_field_values":[],"type":null,"active_lock_reason":null,"draft":false,"pull_request":{"url":"https://api.github.com/repos/godotengine/godot/pulls/118155","html_url":"https://github.com/godotengine/godot/pull/118155","diff_url":"https://github.com/godotengine/godot/pull/118155.diff","patch_url":"https://github.com/godotengine/godot/pull/118155.patch","merged_at":"2026-05-11T22:14:59Z"},"body":"Fixes #117857.\r\nBased on the branch linked [here](https://github.com/godotengine/godot/issues/114605#issuecomment-3764040803).\r\n\r\n> [!WARNING]\r\n> I have barely tested this at all outside of the #117857 MRPs. There's a significant risk of breaking people's character controllers when changing anything related to `PhysicsServer3D::body_test_motion`.\r\n\r\nThis moves the contact filtering that's currently done in `JoltPhysicsDirectSpaceState3D::_body_motion_collide`:\r\n\r\nhttps://github.com/godotengine/godot/blob/3911e0963d39b79a85cb329340c6918397d2d05e/modules/jolt_physics/spaces/jolt_physics_direct_space_state_3d.cpp#L331-L345\r\n\r\n... to instead be done in a new collector called `JoltQueryCollectorMotion`.\r\n\r\nBy doing the filtering in the collector we no longer run the risk of missing valid contacts that just happened to be discarded because they weren't necessarily the closest one.\r\n\r\nI've thrown in some other minor unrelated changes as well, like renaming `_collide_shape_kinematics` and removing `final` on all the existing collectors (since there's presumably no opportunity for devirtualization anyway).","closed_by":{"login":"Repiteo","id":17489292,"node_id":"MDQ6VXNlcjE3NDg5Mjky","avatar_url":"https://avatars.githubusercontent.com/u/17489292?v=4","gravatar_id":"","url":"https://api.github.com/users/Repiteo","html_url":"https://github.com/Repiteo","followers_url":"https://api.github.com/users/Repiteo/followers","following_url":"https://api.github.com/users/Repiteo/following{/other_user}","gists_url":"https://api.github.com/users/Repiteo/gists{/gist_id}","starred_url":"https://api.github.com/users/Repiteo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Repiteo/subscriptions","organizations_url":"https://api.github.com/users/Repiteo/orgs","repos_url":"https://api.github.com/users/Repiteo/repos","events_url":"https://api.github.com/users/Repiteo/events{/privacy}","received_events_url":"https://api.github.com/users/Repiteo/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/118155/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/godotengine/godot/issues/118155/timeline","performed_via_github_app":null,"state_reason":null}