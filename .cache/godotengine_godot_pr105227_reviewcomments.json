iginal_commit_id":"fb4fd07a9bc1f4551c48b00632e0e74d32320a8b","user":{"login":"basicer","id":671513,"node_id":"MDQ6VXNlcjY3MTUxMw==","avatar_url":"https://avatars.githubusercontent.com/u/671513?v=4","gravatar_id":"","url":"https://api.github.com/users/basicer","html_url":"https://github.com/basicer","followers_url":"https://api.github.com/users/basicer/followers","following_url":"https://api.github.com/users/basicer/following{/other_user}","gists_url":"https://api.github.com/users/basicer/gists{/gist_id}","starred_url":"https://api.github.com/users/basicer/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/basicer/subscriptions","organizations_url":"https://api.github.com/users/basicer/orgs","repos_url":"https://api.github.com/users/basicer/repos","events_url":"https://api.github.com/users/basicer/events{/privacy}","received_events_url":"https://api.github.com/users/basicer/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"I thought about that, however theres a few edges cases to consider.  One is where you upload a gziped file to the server, and the server never the less gzips the file again when it sends it to you.  In this case you'd see the Content-Encoding header, but it would still be correct to decompress it.\r\n\r\nOne thing that could work is to peek at the first data block to see if it has the gzip header, and if it does add the decompressor, and if not pass it through unchanged. That would be a bit more flexible, but is quite a bit more javascript code, so I wasnt sure it was worth it.","created_at":"2025-04-16T17:13:03Z","updated_at":"2025-04-16T17:13:03Z","html_url":"https://github.com/godotengine/godot/pull/105227#discussion_r2047381867","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/105227","_links":{"self":{"href":"https://api.github.com/repos/godotengine/godot/pulls/comments/2047381867"},"html":{"href":"https://github.com/godotengine/godot/pull/105227#discussion_r2047381867"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/105227"}},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/2047381867/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":20,"original_line":20,"side":"RIGHT","in_reply_to_id":2046410605,"author_association":"CONTRIBUTOR","original_position":6,"position":6,"subject_type":"line"}]