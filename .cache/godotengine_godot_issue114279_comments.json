s://api.github.com/repos/godotengine/godot/issues/comments/3711618374/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3712256504","html_url":"https://github.com/godotengine/godot/pull/114279#issuecomment-3712256504","issue_url":"https://api.github.com/repos/godotengine/godot/issues/114279","id":3712256504,"node_id":"IC_kwDOAO6SJc7dRIn4","user":{"login":"clayjohn","id":16521339,"node_id":"MDQ6VXNlcjE2NTIxMzM5","avatar_url":"https://avatars.githubusercontent.com/u/16521339?v=4","gravatar_id":"","url":"https://api.github.com/users/clayjohn","html_url":"https://github.com/clayjohn","followers_url":"https://api.github.com/users/clayjohn/followers","following_url":"https://api.github.com/users/clayjohn/following{/other_user}","gists_url":"https://api.github.com/users/clayjohn/gists{/gist_id}","starred_url":"https://api.github.com/users/clayjohn/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/clayjohn/subscriptions","organizations_url":"https://api.github.com/users/clayjohn/orgs","repos_url":"https://api.github.com/users/clayjohn/repos","events_url":"https://api.github.com/users/clayjohn/events{/privacy}","received_events_url":"https://api.github.com/users/clayjohn/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-01-05T22:09:04Z","updated_at":"2026-01-05T22:09:04Z","body":"@BlueCube3310 I'll push a fix momentarily that gets rid of the discontinuity and removes the stretching at the poles. The correct solution turned out to be very simple. But this won't be enough to close https://github.com/godotengine/godot/issues/113676 since the appearance is still different","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3712256504/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3715272853","html_url":"https://github.com/godotengine/godot/pull/114279#issuecomment-3715272853","issue_url":"https://api.github.com/repos/godotengine/godot/issues/114279","id":3715272853,"node_id":"IC_kwDOAO6SJc7dcpCV","user":{"login":"Repiteo","id":17489292,"node_id":"MDQ6VXNlcjE3NDg5Mjky","avatar_url":"https://avatars.githubusercontent.com/u/17489292?v=4","gravatar_id":"","url":"https://api.github.com/users/Repiteo","html_url":"https://github.com/Repiteo","followers_url":"https://api.github.com/users/Repiteo/followers","following_url":"https://api.github.com/users/Repiteo/following{/other_user}","gists_url":"https://api.github.com/users/Repiteo/gists{/gist_id}","starred_url":"https://api.github.com/users/Repiteo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Repiteo/subscriptions","organizations_url":"https://api.github.com/users/Repiteo/orgs","repos_url":"https://api.github.com/users/Repiteo/repos","events_url":"https://api.github.com/users/Repiteo/events{/privacy}","received_events_url":"https://api.github.com/users/Repiteo/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-01-06T16:02:24Z","updated_at":"2026-01-06T16:02:24Z","body":"Thanks!","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3715272853/reactions","total_count":1,"+1":0,"-1":0,"laugh":0,"hooray":1,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3715391417","html_url":"https://github.com/godotengine/godot/pull/114279#issuecomment-3715391417","issue_url":"https://api.github.com/repos/godotengine/godot/issues/114279","id":3715391417,"node_id":"IC_kwDOAO6SJc7ddF-5","user":{"login":"clayjohn","id":16521339,"node_id":"MDQ6VXNlcjE2NTIxMzM5","avatar_url":"https://avatars.githubusercontent.com/u/16521339?v=4","gravatar_id":"","url":"https://api.github.com/users/clayjohn","html_url":"https://github.com/clayjohn","followers_url":"https://api.github.com/users/clayjohn/followers","following_url":"https://api.github.com/users/clayjohn/following{/other_user}","gists_url":"https://api.github.com/users/clayjohn/gists{/gist_id}","starred_url":"https://api.github.com/users/clayjohn/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/clayjohn/subscriptions","organizations_url":"https://api.github.com/users/clayjohn/orgs","repos_url":"https://api.github.com/users/clayjohn/repos","events_url":"https://api.github.com/users/clayjohn/events{/privacy}","received_events_url":"https://api.github.com/users/clayjohn/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-01-06T16:33:13Z","updated_at":"2026-01-06T16:33:13Z","body":"@BlueCube3310 Thank you for checking!\r\n\r\n> Some 'splotching' is still visible on the rough materials, though it can be improved later on as it's not really noticeable.\r\n\r\nI think the way to fix this is to use an approach more similar to what we do in the compatibility renderer which is to precompute samples ahead of time and vary the sample count based on roughness level (as described here: https://placeholderart.wordpress.com/2015/07/28/implementation-notes-runtime-environment-map-filtering-for-image-based-lighting/). \r\n\r\nThe trick is that the first few levels only need a few samples while the rough levels need a lot more. Right now we use a fixed amount that is overkill for the first couple of levels and not enough for the last couple. If we distribute the samples more towards the rougher levels, we will get improved quality at basically no cost. \r\n\r\nIn the compatibility renderer, we do that on the CPU and pass in the samples through a uniform. But Seb Lagarde (from Frostbite) left an interesting comment on the post I linked above saying that they precompute the samples in the compute shader using group shared memory. Which is probably what we would want to do too. \r\n\r\nIs this something you would like to experiment with yourself?","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3715391417/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3730571214","html_url":"https://github.com/godotengine/godot/pull/114279#issuecomment-3730571214","issue_url":"https://api.github.com/repos/godotengine/godot/issues/114279","id":3730571214,"node_id":"IC_kwDOAO6SJc7eW__O","user":{"login":"BlueCube3310","id":53150244,"node_id":"MDQ6VXNlcjUzMTUwMjQ0","avatar_url":"https://avatars.githubusercontent.com/u/53150244?v=4","gravatar_id":"","url":"https://api.github.com/users/BlueCube3310","html_url":"https://github.com/BlueCube3310","followers_url":"https://api.github.com/users/BlueCube3310/followers","following_url":"https://api.github.com/users/BlueCube3310/following{/other_user}","gists_url":"https://api.github.com/users/BlueCube3310/gists{/gist_id}","starred_url":"https://api.github.com/users/BlueCube3310/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/BlueCube3310/subscriptions","organizations_url":"https://api.github.com/users/BlueCube3310/orgs","repos_url":"https://api.github.com/users/BlueCube3310/repos","events_url":"https://api.github.com/users/BlueCube3310/events{/privacy}","received_events_url":"https://api.github.com/users/BlueCube3310/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-01-09T21:07:27Z","updated_at":"2026-01-09T21:07:27Z","body":"> Is this something you would like to experiment with yourself?\r\n\r\nI would like to, but I will most likely not have the time for it during the next month or so.","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3730571214/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3731017183","html_url":"https://github.com/godotengine/godot/pull/114279#issuecomment-3731017183","issue_url":"https://api.github.com/repos/godotengine/godot/issues/114279","id":3731017183,"node_id":"IC_kwDOAO6SJc7eYs3f","user":{"login":"clayjohn","id":16521339,"node_id":"MDQ6VXNlcjE2NTIxMzM5","avatar_url":"https://avatars.githubusercontent.com/u/16521339?v=4","gravatar_id":"","url":"https://api.github.com/users/clayjohn","html_url":"https://github.com/clayjohn","followers_url":"https://api.github.com/users/clayjohn/followers","following_url":"https://api.github.com/users/clayjohn/following{/other_user}","gists_url":"https://api.github.com/users/clayjohn/gists{/gist_id}","starred_url":"https://api.github.com/users/clayjohn/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/clayjohn/subscriptions","organizations_url":"https://api.github.com/users/clayjohn/orgs","repos_url":"https://api.github.com/users/clayjohn/repos","events_url":"https://api.github.com/users/clayjohn/events{/privacy}","received_events_url":"https://api.github.com/users/clayjohn/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-01-09T23:46:42Z","updated_at":"2026-01-09T23:46:42Z","body":"> > Is this something you would like to experiment with yourself?\r\n> \r\n> I would like to, but I will most likely not have the time for it during the next month or so.\r\n\r\nFair enough!","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comm