4,"node_id":"MDQ6VXNlcjQ0MzA2MDU0","avatar_url":"https://avatars.githubusercontent.com/u/44306054?v=4","gravatar_id":"","url":"https://api.github.com/users/matheusmdx","html_url":"https://github.com/matheusmdx","followers_url":"https://api.github.com/users/matheusmdx/followers","following_url":"https://api.github.com/users/matheusmdx/following{/other_user}","gists_url":"https://api.github.com/users/matheusmdx/gists{/gist_id}","starred_url":"https://api.github.com/users/matheusmdx/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/matheusmdx/subscriptions","organizations_url":"https://api.github.com/users/matheusmdx/orgs","repos_url":"https://api.github.com/users/matheusmdx/repos","events_url":"https://api.github.com/users/matheusmdx/events{/privacy}","received_events_url":"https://api.github.com/users/matheusmdx/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-02-17T19:41:02Z","updated_at":"2026-02-17T19:41:02Z","body":"Bisected to PR #113228. CC @dalexeev\n\n","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3916730534/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3919522260","html_url":"https://github.com/godotengine/godot/issues/116375#issuecomment-3919522260","issue_url":"https://api.github.com/repos/godotengine/godot/issues/116375","id":3919522260,"node_id":"IC_kwDOAO6SJc7pnynU","user":{"login":"dalexeev","id":47700418,"node_id":"MDQ6VXNlcjQ3NzAwNDE4","avatar_url":"https://avatars.githubusercontent.com/u/47700418?v=4","gravatar_id":"","url":"https://api.github.com/users/dalexeev","html_url":"https://github.com/dalexeev","followers_url":"https://api.github.com/users/dalexeev/followers","following_url":"https://api.github.com/users/dalexeev/following{/other_user}","gists_url":"https://api.github.com/users/dalexeev/gists{/gist_id}","starred_url":"https://api.github.com/users/dalexeev/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/dalexeev/subscriptions","organizations_url":"https://api.github.com/users/dalexeev/orgs","repos_url":"https://api.github.com/users/dalexeev/repos","events_url":"https://api.github.com/users/dalexeev/events{/privacy}","received_events_url":"https://api.github.com/users/dalexeev/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-02-18T08:57:30Z","updated_at":"2026-02-18T09:07:26Z","body":"This is not a bug. The previous behavior was a bug:\n\n<img width=\"992\" height=\"282\" alt=\"\" src=\"https://github.com/user-attachments/assets/92ea00bd-c6b9-4966-b5d3-2e2278857ef9\" />\n\nYes, it's less obvious, but it makes the language's behavior more consistent with the behavior in other cases.\n\nThanks for the contribution nonetheless!\n\n---\n\nInstead of the verbose:\n\n```gdscript\nvar new_polygon := PackedVector2Array(\n    [\n        Vector2(self.polygon[0].x, self.polygon[0].y + 1 * delta),\n        self.polygon[1],\n        self.polygon[2],\n        Vector2(self.polygon[3].x, self.polygon[3].y + 1 * delta)\n    ]\n)\nself.polygon = new_polygon\n```\n\nYou can use:\n\n```gdscript\nvar new_polygon := self.polygon\nnew_polygon[0].y += 1 * delta\nnew_polygon[3].y += 1 * delta\npolygon = new_polygon\n```","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3919522260/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3919864898","html_url":"https://github.com/godotengine/godot/issues/116375#issuecomment-3919864898","issue_url":"https://api.github.com/repos/godotengine/godot/issues/116375","id":3919864898,"node_id":"IC_kwDOAO6SJc7ppGRC","user":{"login":"YahelBaram","id":57954159,"node_id":"MDQ6VXNlcjU3OTU0MTU5","avatar_url":"https://avatars.githubusercontent.com/u/57954159?v=4","gravatar_id":"","url":"https://api.github.com/users/YahelBaram","html_url":"https://github.com/YahelBaram","followers_url":"https://api.github.com/users/YahelBaram/followers","following_url":"https://api.github.com/users/YahelBaram/following{/other_user}","gists_url":"https://api.github.com/users/YahelBaram/gists{/gist_id}","starred_url":"https://api.github.com/users/YahelBaram/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/YahelBaram/subscriptions","organizations_url":"https://api.github.com/users/YahelBaram/orgs","repos_url":"https://api.github.com/users/YahelBaram/repos","events_url":"https://api.github.com/users/YahelBaram/events{/privacy}","received_events_url":"https://api.github.com/users/YahelBaram/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-02-18T10:04:43Z","updated_at":"2026-02-18T10:04:43Z","body":"1. Thanks for the answer. It makes sense to make this behavior more consistent \n2. Is the new way less efficient in performance than the incorrect version I used before?","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3919864898/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3919917868","html_url":"https://github.com/godotengine/godot/issues/116375#issuecomment-3919917868","issue_url":"https://api.github.com/repos/godotengine/godot/issues/116375","id":3919917868,"node_id":"IC_kwDOAO6SJc7ppTMs","user":{"login":"dalexeev","id":47700418,"node_id":"MDQ6VXNlcjQ3NzAwNDE4","avatar_url":"https://avatars.githubusercontent.com/u/47700418?v=4","gravatar_id":"","url":"https://api.github.com/users/dalexeev","html_url":"https://github.com/dalexeev","followers_url":"https://api.github.com/users/dalexeev/followers","following_url":"https://api.github.com/users/dalexeev/following{/other_user}","gists_url":"https://api.github.com/users/dalexeev/gists{/gist_id}","starred_url":"https://api.github.com/users/dalexeev/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/dalexeev/subscriptions","organizations_url":"https://api.github.com/users/dalexeev/orgs","repos_url":"https://api.github.com/users/dalexeev/repos","events_url":"https://api.github.com/users/dalexeev/events{/privacy}","received_events_url":"https://api.github.com/users/dalexeev/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-02-18T10:15:02Z","updated_at":"2026-02-18T10:15:02Z","body":"> 2\\. Is the new way less efficient in performance than the incorrect version I used before?\n\nI don't think there's much of a difference that would matter in practice, you can do a benchmark if you're interested.\n\nOff the top of my head, your version first allocates an `Array` (`[]`) and then converts it to a `PackedVector2Array`. Also, in your version, the `polygon` built-in property getter is called 6 times. While my version calls the getter only 1 time, modifies the `PackedVector2Array` in place and calls the `polygon` setter.","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3919917868/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null}]