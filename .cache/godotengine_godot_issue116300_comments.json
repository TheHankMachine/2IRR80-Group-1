.github.com/users/neikeq/orgs","repos_url":"https://api.github.com/users/neikeq/repos","events_url":"https://api.github.com/users/neikeq/events{/privacy}","received_events_url":"https://api.github.com/users/neikeq/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-04-04T18:07:06Z","updated_at":"2026-04-04T18:07:06Z","body":"Market as draft for now to not merge accidentally. I'm currently working on making the GodotSharp assemblies and game project trimmer-friendly, and that probably means `GetGodotClassTrampolines` would be better placed in the internal `GodotInternal` class.","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4187511425/reactions","total_count":1,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":1},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4246559283","html_url":"https://github.com/godotengine/godot/pull/116300#issuecomment-4246559283","issue_url":"https://api.github.com/repos/godotengine/godot/issues/116300","id":4246559283,"node_id":"IC_kwDOAO6SJc79HVoz","user":{"login":"neikeq","id":7718100,"node_id":"MDQ6VXNlcjc3MTgxMDA=","avatar_url":"https://avatars.githubusercontent.com/u/7718100?v=4","gravatar_id":"","url":"https://api.github.com/users/neikeq","html_url":"https://github.com/neikeq","followers_url":"https://api.github.com/users/neikeq/followers","following_url":"https://api.github.com/users/neikeq/following{/other_user}","gists_url":"https://api.github.com/users/neikeq/gists{/gist_id}","starred_url":"https://api.github.com/users/neikeq/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/neikeq/subscriptions","organizations_url":"https://api.github.com/users/neikeq/orgs","repos_url":"https://api.github.com/users/neikeq/repos","events_url":"https://api.github.com/users/neikeq/events{/privacy}","received_events_url":"https://api.github.com/users/neikeq/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-04-14T19:24:23Z","updated_at":"2026-04-14T19:24:23Z","body":"This is ready again. I updated it to not require any backwards compatibility checks in a future PR I'm preparing. I also fixed a serious regression that I hadn't spotted before.","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4246559283/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4853524582","html_url":"https://github.com/godotengine/godot/pull/116300#issuecomment-4853524582","issue_url":"https://api.github.com/repos/godotengine/godot/issues/116300","id":4853524582,"node_id":"IC_kwDOAO6SJc8AAAABIUroZg","user":{"login":"JoNax97","id":10124534,"node_id":"MDQ6VXNlcjEwMTI0NTM0","avatar_url":"https://avatars.githubusercontent.com/u/10124534?v=4","gravatar_id":"","url":"https://api.github.com/users/JoNax97","html_url":"https://github.com/JoNax97","followers_url":"https://api.github.com/users/JoNax97/followers","following_url":"https://api.github.com/users/JoNax97/following{/other_user}","gists_url":"https://api.github.com/users/JoNax97/gists{/gist_id}","starred_url":"https://api.github.com/users/JoNax97/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/JoNax97/subscriptions","organizations_url":"https://api.github.com/users/JoNax97/orgs","repos_url":"https://api.github.com/users/JoNax97/repos","events_url":"https://api.github.com/users/JoNax97/events{/privacy}","received_events_url":"https://api.github.com/users/JoNax97/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-07-01T10:50:14Z","updated_at":"2026-07-01T10:50:14Z","body":"Hi! Is thia something that can be considered for merging for 4.8?\r\n\r\nNot sure how this improvement would interact with the new godot-dotnet @raulsntos ","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4853524582/reactions","total_count":3,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":3},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5458405577","html_url":"https://github.com/godotengine/godot/pull/116300#issuecomment-5458405577","issue_url":"https://api.github.com/repos/godotengine/godot/issues/116300","id":5458405577,"node_id":"IC_kwDOAO6SJc8AAAABRVioyQ","user":{"login":"neikeq","id":7718100,"node_id":"MDQ6VXNlcjc3MTgxMDA=","avatar_url":"https://avatars.githubusercontent.com/u/7718100?v=4","gravatar_id":"","url":"https://api.github.com/users/neikeq","html_url":"https://github.com/neikeq","followers_url":"https://api.github.com/users/neikeq/followers","following_url":"https://api.github.com/users/neikeq/following{/other_user}","gists_url":"https://api.github.com/users/neikeq/gists{/gist_id}","starred_url":"https://api.github.com/users/neikeq/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/neikeq/subscriptions","organizations_url":"https://api.github.com/users/neikeq/orgs","repos_url":"https://api.github.com/users/neikeq/repos","events_url":"https://api.github.com/users/neikeq/events{/privacy}","received_events_url":"https://api.github.com/users/neikeq/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-08-28T22:26:18Z","updated_at":"2026-08-28T22:26:18Z","body":"I just notice the MRP from #89217 (test_mono_method_cache) had a mistake in the C# version. The line `GD.RandRange(1, 5)` was calling the `int` overload. Changing it to `GD.RandRange(1d, 5d)` fixes it, but completely invalidates the previous performance results. I'll update them once I have some time.\r\n\r\nAlso, it seems that this was also the reason for the difference in `Process` time displayed by the Monitor between GDScript and C#. I don't know what this is supposed to measure but it's completely different from the `Process Time` displayed by the profiler, and I don't know how the fps can be around 600 with a process time of ~33ms as displayed by the Monitor (profiler display ~1.3 ms).","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5458405577/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5674921005","html_url":"https://github.com/godotengine/godot/pull/116300#issuecomment-5674921005","issue_url":"https://api.github.com/repos/godotengine/godot/issues/116300","id":5674921005,"node_id":"IC_kwDOAO6SJc8AAAABUkBsLQ","user":{"login":"neikeq","id":7718100,"node_id":"MDQ6VXNlcjc3MTgxMDA=","avatar_url":"https://avatars.githubusercontent.com/u/7718100?v=4","gravatar_id":"","url":"https://api.github.com/users/neikeq","html_url":"https://github.com/neikeq","followers_url":"https://api.github.com/users/neikeq/followers","following_url":"https://api.github.com/users/neikeq/following{/other_user}","gists_url":"https://api.github.com/users/neikeq/gists{/gist_id}","starred_url":"https://api.github.com/users/neikeq/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/neikeq/subscriptions","organizations_url":"https://api.github.com/users/neikeq/orgs","repos_url":"https://api.github.com/users/neikeq/repos","events_url":"https://api.github.com/users/neikeq/events{/privacy}","received_events_url":"https://api.github.com/users/neikeq/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-09-15T04:52:48Z","updated_at":"2026-09-15T04:52:48Z","body":"I'll have a look at the review comments soon.\r\nI tried to update the performance results today. The C# results are not as good as the initial ones, after fixing the [mistake in the MRP](https://github.com/godotengine/godot/pull/116300#issuecomment-5458405577). While a decrease was anticipated, the actual drop is much higher than I  had expected (GDScript 2000fps, C# 1650fps). I ran the profiler and it turns out `VariantUtils.ConvertTo<T>` is not being specialized for some reason (at least not in the editor build). Changing the generators to use `VariantUtils.ConvertToFloat64` for `double` puts C# at 2500fps. I have to look at why `ConvertTo<T>` is not being specialized, but that's probably outside the scope of this PR","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5674921005/reactions","total_count":2,"+1":2,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5690451443","html_url":"https://github.com/godotengine/godot/pull/116300#issuecomment-5690451443","issue_url":"https://api.github.com/repos/godotengine/godot/issues/116300","id":5690451443,"node_id":"IC_kwDOAO6SJc8AAAABUy1l8w","user":{"login":"neikeq","id":7718100,"node_id":"MDQ6VXNlcjc3MTgxMDA=","avatar_url":"https://avatars.githubusercontent.com/u/7718100?v=4","gravatar_id":"","url":"https://api.github.com/users/neikeq","html_url":"https://github.com/neikeq","followers_url":"https://api.github.com/users/neikeq/followers","following_url":"https://api.github.com/users/neikeq/following{/other_user}","gists_url":"https://api.github.com/users/neikeq/gists{/gist_id}","starred_url":"https://api.github.com/users/neikeq/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/neikeq/subscriptions","organizations_url":"https://api.github.com/users/neikeq/orgs","repos_url":"https://api.github.com/users/neikeq/repos","events_url":"https://api.github.com/users/neikeq/events{/privacy}","received_events_url":"https://api.github.com/users/neikeq/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-09-16T01:03:54Z","updated_at":"2026-09-16T01:03:54Z","body":"Never mind, I'm dumb. Forgot that even release builds of the editor always use the debug version of the GodotSharp assembly. Forced it to use the release one and now `ConvertTo<T>` got specialized.\r\n\r\n### Updated results\r\n\r\nGDScript:\r\n<img width=\"2018\" height=\"489\" alt=\"gdscript\" src=\"https://github.com/user-attachments/assets/b8318a9c-3ed4-42fb-8f70-676adbfbf73d\" />\r\n\r\nC#:\r\n<img width=\"2018\" height=\"489\" alt=\"csharp_slow_str\" src=\"https://github.com/user-attachments/assets/d1c59c2b-4e1a-4fa0-b009-004edf49a098\" />\r\n\r\nThe C# one is very unstable. This is the result of string marshalling. Applying the following change gives better results:\r\n```diff\r\n+\tstatic Variant _strVariantA = \"a\";\r\n+\tstatic Variant _strVariantB = \"b\";\r\n```\r\n```diff\r\n-\t\tText = f ? \"a\" : \"b\";\r\n+\t\tSet(Label.PropertyName.Text, f ? _strVariantA : _strVariantB);\r\n```\r\n<img width=\"2018\" height=\"489\" alt=\"csharp_fast_str\" src=\"https://github.com/user-attachments/assets/11ca9f7d-c7b1-4a5f-ad8a-e71f1f635676\" />\r\n","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5690451443/reactions","total_count":6,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":6,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5819062079","html_url":"https://github.com/godotengine/godot/pull/116300#issuecomment-5819062079","issue_url":"https://api.github.com/repos/godotengine/godot/issues/116300","id":5819062079,"node_id":"IC_kwDOAO6SJc8AAAABWtfXPw","user":{"login":"neikeq","id":7718100,"node_id":"MDQ6VXNlcjc3MTgxMDA=","avatar_url":"https://avatars.githubusercontent.com/u/7718100?v=4","gravatar_id":"","url":"https://api.github.com/users/neikeq","html_url":"https://github.com/neikeq","followers_url":"https://api.github.com/users/neikeq/followers","following_url":"https://api.github.com/users/neikeq/following{/other_user}","gists_url":"https://api.github.com/users/neikeq/gists{/gist_id}","starred_url":"https://api.github.com/users/neikeq/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/neikeq/subscriptions","organizations_url":"https://api.github.com/users/neikeq/orgs","repos_url":"https://api.github.com/users/neikeq/repos","events_url":"https://api.github.com/users/neikeq/events{/privacy}","received_events_url":"https://api.github.com/users/neikeq/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-09-24T17:37:29Z","updated_at":"2026-09-24T17:37:29Z","body":"There's still two pending reviews, but we're close to being done. Should I proceed to squash the commits into one in preparation?","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5819062079/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5834606389","html_url":"https://github.com/godotengine/godot/pull/116300#issuecomment-5834606389","issue_url":"https://api.github.com/repos/godotengine/godot/issues/116300","id":5834606389,"node_id":"IC_kwDOAO6SJc8AAAABW8UHNQ","user":{"login":"roookeee","id":1199562,"node_id":"MDQ6VXNlcjExOTk1NjI=","avatar_url":"https://avatars.githubusercontent.com/u/1199562?v=4","gravatar_id":"","url":"https://api.github.com/users/roookeee","html_url":"https://github.com/roookeee","followers_url":"https://api.github.com/users/roookeee/followers","following_url":"https://api.github.com/users/roookeee/following{/other_user}","gists_url":"https://api.github.com/users/roookeee/gists{/gist_id}","starred_url":"https://api.github.com/users/roookeee/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/roookeee/subscriptions","organizations_url":"https://api.github.com/users/roookeee/orgs","repos_url":"https://api.github.com/users/roookeee/repos","events_url":"https://api.github.com/users/roookeee/events{/privacy}","received_events_url":"https://api.github.com/users/roookeee/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-09-25T15:03:08Z","updated_at":"2026-09-25T15:04:12Z","body":"> I'll have a look at the review comments soon. I tried to update the performance results today. The C# results are not as good as the initial ones, after fixing the [mistake in the MRP](https://github.com/godotengine/godot/pull/116300#issuecomment-5458405577). While a decrease was anticipated, the actual drop is much higher than I had expected (GDScript 2000fps, C# 1650fps). I ran the profiler and it turns out `VariantUtils.ConvertTo<T>` is not being specialized for some reason (at least not in the editor build). Changing the generators to use `VariantUtils.ConvertToFloat64` for `double` puts C# at 2500fps. I have to look at why `ConvertTo<T>` is not being specialized, but that's probably outside the scope of this PR\r\n\r\nFeel free to necro my [closed PR](https://github.com/godotengine/godot/pull/89807), I noticed the perf problems some time ago but people never got around to reviewing the change (this is not meant as criticism).","author_association":"NONE","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5834606389/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5836845701","html_url":"https://github.com/godotengine/godot/pull/116300#issuecomment-5836845701","issue_url":"https://api.github.com/repos/godotengine/godot/issues/116300","id":5836845701,"node_id":"IC_kwDOAO6SJc8AAAABW-cyhQ","user":{"login":"neikeq","id":7718100,"node_id":"MDQ6VXNlcjc3MTgxMDA=","avatar_url":"https://avatars.githubusercontent.com/u/7718100?v=4","gravatar_id":"","url":"https://api.github.com/users/neikeq","html_url":"https://github.com/neikeq","followers_url":"https://api.github.com/users/neikeq/followers","following_url":"https://api.github.com/users/neikeq/following{/other_user}","gists_url":"https://api.github.com/users/neikeq/gists{/gist_id}","starred_url":"https://api.github.com/users/neikeq/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/neikeq/subscriptions","organizations_url":"https://api.github.com/users/neikeq/orgs","repos_url":"https://api.github.com/users/neikeq/repos","events_url":"https://api.github.com/users/neikeq/events{/privacy}","received_events_url":"https://api.github.com/users/neikeq/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-09-25T17:44:16Z","updated_at":"2026-09-25T17:44:16Z","body":"> Feel free to necro my [closed PR](https://github.com/godotengine/godot/pull/89807), I noticed the perf problems some time ago but people never got around to reviewing the change (this is not meant as criticism).\r\n\r\nThe problem I described was only on `Debug` configurations though. And I was planning to later make the source generators use the non-generic conversion methods instead. The problems with the generic version still concern me though, because generic collections rely on them.","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5836845701/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.githu