[{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3923709584","html_url":"https://github.com/godotengine/godot/pull/116300#issuecomment-3923709584","issue_url":"https://api.github.com/repos/godotengine/godot/issues/116300","id":3923709584,"node_id":"IC_kwDOAO6SJc7p3w6Q","user":{"login":"neikeq","id":7718100,"node_id":"MDQ6VXNlcjc3MTgxMDA=","avatar_url":"https://avatars.githubusercontent.com/u/7718100?v=4","gravatar_id":"","url":"https://api.github.com/users/neikeq","html_url":"https://github.com/neikeq","followers_url":"https://api.github.com/users/neikeq/followers","following_url":"https://api.github.com/users/neikeq/following{/other_user}","gists_url":"https://api.github.com/users/neikeq/gists{/gist_id}","starred_url":"https://api.github.com/users/neikeq/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/neikeq/subscriptions","organizations_url":"https://api.github.com/users/neikeq/orgs","repos_url":"https://api.github.com/users/neikeq/repos","events_url":"https://api.github.com/users/neikeq/events{/privacy}","received_events_url":"https://api.github.com/users/neikeq/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-02-18T23:17:42Z","updated_at":"2026-02-18T23:17:42Z","body":"This is ready now (only pending squashing the commits). I made some final changes, and I'm happy with the way this turned out.","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3923709584/reactions","total_count":5,"+1":0,"-1":0,"laugh":0,"hooray":5,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3939125794","html_url":"https://github.com/godotengine/godot/pull/116300#issuecomment-3939125794","issue_url":"https://api.github.com/repos/godotengine/godot/issues/116300","id":3939125794,"node_id":"IC_kwDOAO6SJc7qykoi","user":