atars.githubusercontent.com/u/1199562?v=4","gravatar_id":"","url":"https://api.github.com/users/roookeee","html_url":"https://github.com/roookeee","followers_url":"https://api.github.com/users/roookeee/followers","following_url":"https://api.github.com/users/roookeee/following{/other_user}","gists_url":"https://api.github.com/users/roookeee/gists{/gist_id}","starred_url":"https://api.github.com/users/roookeee/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/roookeee/subscriptions","organizations_url":"https://api.github.com/users/roookeee/orgs","repos_url":"https://api.github.com/users/roookeee/repos","events_url":"https://api.github.com/users/roookeee/events{/privacy}","received_events_url":"https://api.github.com/users/roookeee/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-09-25T20:47:56Z","updated_at":"2026-09-25T20:48:37Z","body":"Quick question: this implementation quietly doubles down on not supporting method overloading in C# (it doesn't work in GDScript anyway). [As I pointed out in the past](https://github.com/godotengine/godot/pull/89826), C# (search for \"overload\") method overloading does not work and \"picks\" the first declared function.\r\n\r\nMaybe this should be documented? Cause the Hashmap key is `method_name`  + ` argc`. Currently, method overloading support is undefined (or did I miss the documentation on this?)","author_association":"NONE","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5839379757/reactions","total_count":1,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":1},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5840827257","html_url":"https://github.com/godotengine/godot/pull/116300#issuecomment-5840827257","issue_url":"https://api.github.com/repos/godotengine/godot/issues/116300","id":5840827257,"node_id":"IC_kwDOAO6SJc8AAAABXCPzeQ","user":{"login":"MattParkerDev","id":61717342,"node_id":"MDQ6VXNlcjYxNzE3MzQy","avatar_url":"https://avatars.githubusercontent.com/u/61717342?v=4","gravatar_id":"","url":"https://api.github.com/users/MattParkerDev","html_url":"https://github.com/MattParkerDev","followers_url":"https://api.github.com/users/MattParkerDev/followers","following_url":"https://api.github.com/users/MattParkerDev/following{/other_user}","gists_url":"https://api.github.com/users/MattParkerDev/gists{/gist_id}","starred_url":"https://api.github.com/users/MattParkerDev/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/MattParkerDev/subscriptions","organizations_url":"https://api.github.com/users/MattParkerDev/orgs","repos_url":"https://api.github.com/users/MattParkerDev/repos","events_url":"https://api.github.com/users/MattParkerDev/events{/privacy}","received_events_url":"https://api.github.com/users/MattParkerDev/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-09-25T23:02:04Z","updated_at":"2026-09-25T23:02:04Z","body":"> The problem I described was only on Debug configurations though. \n\nSomewhat adjacent to this PR, so feel free to minimize, but I was surprised to learn that the Debug build of GodotSharp is used by the editor? Why? I don't see any disadvantages of using the Release build. ","author_association":"NONE","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5840827257/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5841939288","html_url":"https://github.com/godotengine/godot/pull/116300#issuecomment-5841939288","issue_url":"https://api.github.com/repos/godotengine/godot/issues/116300","id":5841939288,"node_id":"IC_kwDOAO6SJc8AAAABXDTrWA","user":{"login":"neikeq","id":7718100,"node_id":"MDQ6VXNlcjc3MTgxMDA=","avatar_url":"https://avatars.githubusercontent.com/u/7718100?v=4","gravatar_id":"","url":"https://api.github.com/users/neikeq","html_url":"https://github.com/neikeq","followers_url":"https://api.github.com/users/neikeq/followers","following_url":"https://api.github.com/users/neikeq/following{/other_user}","gists_url":"https://api.github.com/users/neikeq/gists{/gist_id}","starred_url":"https://api.github.com/users/neikeq/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/neikeq/subscriptions","organizations_url":"https://api.github.com/users/neikeq/orgs","repos_url":"https://api.github.com/users/neikeq/repos","events_url":"https://api.github.com/users/neikeq/events{/privacy}","received_events_url":"https://api.github.com/users/neikeq/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-09-26T01:26:50Z","updated_at":"2026-09-26T01:26:50Z","body":"> Quick question: this implementation quietly doubles down on not supporting method overloading in C# (it doesn't work in GDScript anyway). [As I pointed out in the past](https://github.com/godotengine/godot/pull/89826), C# (search for \"overload\") method overloading does not work and \"picks\" the first declared function.\r\n> \r\n> Maybe this should be documented? Cause the Hashmap key is `method_name` + ` argc`. Currently, method overloading support is undefined (or did I miss the documentation on this?)\r\n\r\nThe scripting system has never supported overloaded function calls. There's nothing we can do about it from the C# side.\r\n\r\n> Somewhat adjacent to this PR, so feel free to minimize, but I was surprised to learn that the Debug build of GodotSharp is used by the editor? Why? I don't see any disadvantages of using the Release build.\r\n\r\nFor a better debugging experience when stepping into the API assembly (not sure how useful), and to include `#if DEBUG` conditional compilation such as: https://github.com/godotengine/godot/blob/46173009dc4ab6e582cf978e2d68b0ddfeb1e934/modules/mono/glue/GodotSharp/GodotSharp/Core/Quaternion.cs#L300-L305","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5841939288/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5847371507","html_url":"https://github.com/godotengine/godot/pull/116300#issuecomment-5847371507","issue_url":"https://api.github.com/repos/godotengine/godot/issues/116300","id":5847371507,"node_id":"IC_kwDOAO6SJc8AAAABXIfO8w","user":{"login":"Repiteo","id":17489292,"node_id":"MDQ6VXNlcjE3NDg5Mjky","avatar_url":"https://avatars.githubusercontent.com/u/17489292?v=4","gravatar_id":"","url":"https://api.github.com/users/Repiteo","html_url":"https://github.com/Repiteo","followers_url":"https://api.github.com/users/Repiteo/followers","following_url":"https://api.github.com/users/Repiteo/following{/other_user}","gists_url":"https://api.github.com/users/Repiteo/gists{/gist_id}","starred_url":"https://api.github.com/users/Repiteo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Repiteo/subscriptions","organizations_url":"https://api.github.com/users/Repiteo/orgs","repos_url":"https://api.github.com/users/Repiteo/repos","events_url":"https://api.github.com/users/Repiteo/events{/privacy}","received_events_url":"https://api.github.com/users/Repiteo/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-09-26T15:13:26Z","updated_at":"2026-09-26T15:13:26Z","body":"Thanks!","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5847371507/reactions","total_count":6,"+1":0,"-1":0,"laugh":0,"hooray":6,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url