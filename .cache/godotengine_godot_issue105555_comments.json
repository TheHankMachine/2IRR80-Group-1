[{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2819028488","html_url":"https://github.com/godotengine/godot/pull/105555#issuecomment-2819028488","issue_url":"https://api.github.com/repos/godotengine/godot/issues/105555","id":2819028488,"node_id":"IC_kwDOAO6SJc6oBvYI","user":{"login":"DeeJayLSP","id":60024671,"node_id":"MDQ6VXNlcjYwMDI0Njcx","avatar_url":"https://avatars.githubusercontent.com/u/60024671?v=4","gravatar_id":"","url":"https://api.github.com/users/DeeJayLSP","html_url":"https://github.com/DeeJayLSP","followers_url":"https://api.github.com/users/DeeJayLSP/followers","following_url":"https://api.github.com/users/DeeJayLSP/following{/other_user}","gists_url":"https://api.github.com/users/DeeJayLSP/gists{/gist_id}","starred_url":"https://api.github.com/users/DeeJayLSP/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/DeeJayLSP/subscriptions","organizations_url":"https://api.github.com/users/DeeJayLSP/orgs","repos_url":"https://api.github.com/users/DeeJayLSP/repos","events_url":"https://api.github.com/users/DeeJayLSP/events{/privacy}","received_events_url":"https://api.github.com/users/DeeJayLSP/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-04-21T17:03:39Z","updated_at":"2025-04-21T17:27:37Z","body":"It seems upstream made this slower (probably #100944).\r\n\r\nHowever, changing the members to a `TightLocalVector` instead made the performance improvement come back. `GDScriptInstance::members` is resized only once when an instance is created, so maybe nothing is lost by doing this. Force-pushed.","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2819028488/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2819041922","html_url":"https://github.com/godotengine/godot/pull/105555#issuecomment-2819041922","issue_url":"https://api.github.com/repos/godotengine/godot/issues/105555","id":2819041922,"node_id":"IC_kwDOAO6SJc6oByqC","user":{"login":"clayjohn","id":16521339,"node_id":"MDQ6VXNlcjE2NTIxMzM5","avatar_url":"https://avatars.githubusercontent.com/u/16521339?v=4","gravatar_id":"","url":"https://api.github.com/users/clayjohn","html_url":"https://github.com/clayjohn","followers_url":"https://api.github.com/users/clayjohn/followers","following_url":"https://api.github.com/users/clayjohn/following{/other_user}","gists_url":"https://api.github.com/users/clayjohn/gists{/gist_id}","starred_url":"https://api.github.com/users/clayjohn/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/clayjohn/subscriptions","organizations_url":"https://api.github.com/users/clayjohn/orgs","repos_url":"https://api.github.com/users/clayjohn/repos","events_url":"https://api.github.com/users/clayjohn/events{/privacy}","received_events_url":"https://api.github.com/users/clayjohn/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-04-21T17:10:12Z","updated_at":"2025-04-21T17:10:12Z","body":"CC @Ivorforce @Nazarwadim ","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2819041922/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2819149766","html_url":"https://github.com/godotengine/godot/pull/105555#issuecomment-2819149766","issue_url":"https://api.github.com/repos/godotengine/godot/issues/105555","id":2819149766,"node_id":"IC_kwDOAO6SJc6oCM_G","user":{"login":"Ivorforce","id":2308167,"node_id":"MDQ6VXNlcjIzMDgxNjc=","avatar_url":"https://avatars.githubusercontent.com/u/2308167?v=4","gravatar_id":"","url":"https://api.github.com/users/Ivorforce","html_url":"https://github.com/Ivorforce","followers_url":"https://api.github.com/users/Ivorforce/followers","following_url":"https://api.github.com/users/Ivorforce/following{/other_user}","gists_url":"https://api.github.com/users/Ivorforce/gists{/gist_id}","starred_url":"https://api.github.com/users/Ivorforce/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Ivorforce/subscriptions","organizations_url":"https://api.github.com/users/Ivorforce/orgs","repos_url":"https://api.github.com/users/Ivorforce/repos","events_url":"https://api.github.com/users/Ivorforce/events{/privacy}","received_events_url":"https://api.github.com/users/Ivorforce/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-04-21T18:04:54Z","updated_at":"2025-04-21T18:04:54Z","body":"Some regressions are to be expected from resize changes by pure chance. If this is significantly impacted by it it definitely needs a better solution in general.\n\nNot sure how TighLocalVector could even help unless it's being resized every single frame. It has no effect if there's no resize. Do you have a repro for us to toy with?","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2819149766/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2819199776","html_url":"https://github.com/godotengine/godot/pull/105555#issuecomment-2819199776","issue_url":"https://api.github.com/repos/godotengine/godot/issues/105555","id":2819199776,"node_id":"IC_kwDOAO6SJc6oCZMg","user":{"login":"DeeJayLSP","id":60024671,"node_id":"MDQ6VXNlcjYwMDI0Njcx","avatar_url":"https://avatars.githubusercontent.com/u/60024671?v=4","gravatar_id":"","url":"https://api.github.com/users/DeeJayLSP","html_url":"https://github.com/DeeJayLSP","followers_url":"https://api.github.com/users/DeeJayLSP/followers","following_url":"https://api.github.com/users/DeeJayLSP/following{/other_user}","gists_url":"https://api.github.com/users/DeeJayLSP/gists{/gist_id}","starred_url":"https://api.github.com/users/DeeJayLSP/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/DeeJayLSP/subscriptions","organizations_url":"https://api.github.com/users/DeeJayLSP/orgs","repos_url":"https://api.github.com/users/DeeJayLSP/repos","events_url":"https://api.github.com/users/DeeJayLSP/events{/privacy}","received_events_url":"https://api.github.com/users/DeeJayLSP/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-04-21T18:23:17Z","updated_at":"2025-04-21T18:43:11Z","body":"> Do you have a repro for us to toy with?\r\n\r\nI use this stress test for every PR that affects GDScript performance: https://github.com/GaijinEntertainment/godot-das/tree/master/examples/bunnymark\r\n\r\nAfter further testing, I noticed there is a performance improvement only when there are **too much instances**:\r\n\r\n6000 bunnies:\r\n\r\n| branch | FPS     |\r\n|--------|---------|\r\n| master | 122-125 |\r\n| PR     | 114-116 |\r\n\r\n20000 bunnies:\r\n\r\n| branch | FPS   |\r\n|--------|-------|\r\n| master | 34-36 |\r\n| PR     | 36-37 |\r\n\r\nDidn't bother measuring with regular LocalVector as all results were lower performance.\r\n\r\nIt seems a bit situational. I'll report after testing on production builds which matter the most.","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2819199776/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2819396651","html_url":"https://github.com/godotengine/godot/pull/105555#issuecomment-2819396651","issue_url":"https://api.github.com/repos/godotengine/godot/issues/105555","id":2819396651,"node_id":"IC_kwDOAO6SJc6oDJQr","user":{"login":"DeeJayLSP","id":60024671,"node_id":"MDQ6VXNlcjYwMDI0Njcx","avatar_url":"https://avatars.githubusercontent.com/u/60024671?v=4","gravatar_id":"","url":"https://api.github.com/users/DeeJayLSP","html_url":"https://github.com/DeeJayLSP","followers_url":"https://api.github.com/users/DeeJayLSP/followers","following_url":"https://api.github.com/users/DeeJayLSP/following{/other_user}","gists_url":"https://api.github.com/users/DeeJayLSP/gists{/gist_id}","starred_url":"https://api.github.com/users/DeeJayLSP/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/DeeJayLSP/subscriptions","organizations_url":"https://api.github.com/users/DeeJayLSP/orgs","repos_url":"https://api.github.com/users/DeeJayLSP/repos","events_url":"https://api.github.com/users/DeeJayLSP/events{/privacy}","received_events_url":"https://api.github.com/users/DeeJayLSP/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-04-21T20:06:27Z","updated_at":"2025-04-22T00:00:03Z","body":"> I'll report after testing on production builds which matter the most.\r\n\r\nThe proportions are the same, with or without `production=yes`\r\n\r\nI admit that back then I was pairing the changes of this PR with #90082, which already caused a massive boost to GDScript.\r\n\r\nI decided to test everything again with both changes from #90082 and this PR over the current master.\r\n\r\nAt 5000 bunnies:\r\n\r\n| branch                            | avg. FPS |\r\n|-----------------------------------|----------|\r\n| #90082                            | 163-166  |\r\n| #90082 + LocalVector members      | 163-171  |\r\n| #90082 + TightLocalVector members | 161-171  |\r\n\r\nAt 10000 bunnies:\r\n\r\n| branch                            | avg. FPS |\r\n|-----------------------------------|----------|\r\n| #90082                            | 79-81    |\r\n| #90082 + LocalVector members      | 79-82    |\r\n| #90082 + TightLocalVector members | 78-81    |\r\n\r\nAt 20000 bunnies:\r\n\r\n| branch                            | FPS      |\r\n|-----------------------------------|----------|\r\n| #90082                            | 37-40    |\r\n| #90082 + LocalVector members      | 39-41    |\r\n| #90082 + TightLocalVector members | 38-39    |\r\n\r\nAt 50000 bunnies:\r\n\r\n| branch                            | FPS      |\r\n|-----------------------------------|----------|\r\n| #90082                            | 15-16    |\r\n| #90082 + LocalVector members      | 16-17    |\r\n| #90082 + TightLocalVector members | 15-17    |\r\n\r\nThe results are too unstable, but I think maybe we should wait for #90082. A regular LocalVector seems more stable than a Tight one.","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2819396651/reactions","total_count":3,"+1":3,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2825148035","html_url":"https://github.com/godotengine/godot/pull/105555#issuecomment-2825148035","issue_url":"https://api.github.com/repos/godotengine/godot/issues/105555","id":2825148035,"node_id":"IC_kwDOAO6SJc6oZFaD","user":{"login":"DeeJayLSP","id":60024671,"node_id":"MDQ6VXNlcjYwMDI0Njcx","avatar_url":"https://avatars.githubusercontent.com/u/60024671?v=4","gravatar_id":"","url":"https://api.github.com/users/DeeJayLSP","html_url":"https://github.com/DeeJayLSP","followers_url":"https://api.github.com/users/DeeJayLSP/followers","following_url":"https://api.github.com/users/DeeJayLSP/following{/other_user}","gists_url":"https://api.github.com/users/DeeJayLSP/gists{/gist_id}","starred_url":"https://api.github.com/users/DeeJayLSP/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/DeeJayLSP/subscriptions","organizations_url":"https://api.github.com/users/DeeJayLSP/orgs","repos_url":"https://api.github.com/users/DeeJayLSP/repos","events_url":"https://api.github.com/users/DeeJayLSP/events{/privacy}","received_events_url":"https://api.github.com/users/DeeJayLSP/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-04-23T18:22:40Z","updated_at":"2025-04-24T20:10:20Z","body":"While experimenting how fast it would be with a `std::vector`, I realized `GDScriptInstance::reload_members()` would overwrite `GDScriptInstance::members` by giving it a regular `Vector`, and casting that to `LocalVector` has a bit of overhead.\r\n\r\nI have modified so it makes and assigns a `LocalVector` instead.\r\n\r\nIt seems whatever made the FPS drop is now gone (not sure if it was this missing change as it was fine with `TightLocalVector`, probably because both it and `CowData` are tight, or probably because of #104985 being merged), but the FPS gain is minimal (around 1.5%).","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2825148035/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2831225107","html_url":"https://github.com/godotengine/godot/pull/105555#issuecomment-2831225107","issue_url":"https://api.github.com/repos/godotengine/godot/issues/105555","id":2831225107,"node_id":"IC_kwDOAO6SJc6owRET","user":{"login":"DeeJayLSP","id":60024671,"node_id":"MDQ6VXNlcjYwMDI0Njcx","avatar_url":"https://avatars.githubusercontent.com/u/60024671?v=4","gravatar_id":"","url":"https://api.github.com/users/DeeJayLSP","html_url":"https://github.com/DeeJayLSP","followers_url":"https://api.github.com/users/DeeJayLSP/followers","following_url":"https://api.github.com/users/DeeJayLSP/following{/other_user}","gists_url":"https://api.github.com/users/DeeJayLSP/gists{/gist_id}","starred_url":"https://api.github.com/users/DeeJayLSP/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/DeeJayLSP/subscriptions","organizations_url":"https://api.github.com/users/DeeJayLSP/orgs","repos_url":"https://api.github.com/users/DeeJayLSP/repos","events_url":"https://api.github.com/users/DeeJayLSP/events{/privacy}","received_events_url":"https://api.github.com/users/DeeJayLSP/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-04-25T19:10:35Z","updated_at":"2025-04-25T20:58:17Z","body":"> I'm getting mixed performance results though.\r\n\r\nThat's why I say we should wait for #90082 or something similar.\r\n\r\nEvery time some PR touches GDScript or LocalVector it changes the outcome of this one. But in all cases combined with #90082 the performance was better.\r\n\r\nOut of curiosity I overlapped this PR over some changes of #90082 in a production build (6000 bunnies as that was the one affected negatively):\r\n\r\n| #90082  | #90082 + PR |\r\n|---------|-------------|\r\n| 216 FPS | 224 FPS     |\r\n\r\nThe same improvement ratio from above can be seen with 10000 or 50000 bunnies","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2831225107/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2874963566","html_url":"https://github.com/godotengine/godot/pull/105555#issuecomment-2874963566","issue_url":"https://api.github.com/repos/godotengine/godot/issues/105555","id":2874963566,"node_id":"IC_kwDOAO6SJc6rXHZu","user":{"login":"DeeJayLSP","id":60024671,"node_id":"MDQ6VXNlcjYwMDI0Njcx","avatar_url":"https://avatars.githubusercontent.com/u/60024671?v=4","gravatar_id":"","url":"https://api.github.com/users/DeeJayLSP","html_url":"https://github.com/DeeJayLSP","followers_url":"https://api.github.com/users/DeeJayLSP/followers","following_url":"https://api.github.com/users/DeeJayLSP/following{/other_user}","gists_url":"https://api.github.com/users/DeeJayLSP/gists{/gist_id}","starred_url":"https://api.github.com/users/DeeJayLSP/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/DeeJayLSP/subscriptions","organizations_url":"https://api.github.com/users/DeeJayLSP/orgs","repos_url":"https://api.github.com/users/DeeJayLSP/repos","events_url":"https://api.github.com/users/DeeJayLSP/events{/privacy}","received_events_url":"https://api.github.com/users/DeeJayLSP/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-05-13T03:37:21Z","updated_at":"2025-05-14T01:22:04Z","body":"Rebased so I could check the benefits from #106020 \r\n\r\nWhile the profiler shows that the overhead of a `LocalVector` is significantly lower than that of `CowData`, there is a `Variant::operator==` that skyrockets. This also happens in the screenshots at the top of this PR page.\r\n\r\nBefore:\r\n![image](https://github.com/user-attachments/assets/17a71de2-8fe3-42f1-96c9-84f954d2ea86)\r\n\r\nAfter:\r\n![image](https://github.com/user-attachments/assets/3db08148-157d-4f43-b60e-7dde36b2f083)\r\n\r\nAt 10000 bunnies, I can measure a 9% performance improvement with a production template build, but at 1000 bunnies it varies between a 0.3% improvement and a 2.3% decrease. Performance decrease disaappears after 2000 bunnies.\r\n\r\nI hope the issue with Variant isn't some `LocalVector` to `Vector` conversion.\r\n\r\n**EDIT**: turns out most of `CowData::get()` overhead is simply being inherited by `Variant::operator[]`.\r\n\r\nI have tried to keep a regular `Vector`, but make `GDScriptInstance` store `members`'s `ptrw()` solely on instantiation (`GDScriptFunction::call()` calls `ptrw()` on every iteration), but iterating over it revealed where the overhead came from. And was still slower.\r\n\r\nUsing `LocalVector` still results in both vector get and `Variant::operator==` being in their least overhead forms.","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2874963566/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2880139113","html_url":"https://github.com/godotengine/godot/pull/105555#issuecomment-2880139113","issue_url":"https://api.github.com/repos/godotengine/godot/issues/105555","id":2880139113,"node_id":"IC_kwDOAO6SJc6rq29p","user":{"login":"DeeJayLSP","id":60024671,"node_id":"MDQ6VXNlcjYwMDI0Njcx","avatar_url":"https://avatars.githubusercontent.com/u/60024671?v=4","gravatar_id":"","url":"https://api.github.com/users/DeeJayLSP","html_url":"https://github.com/DeeJayLSP","followers_url":"https://api.github.com/users/DeeJayLSP/followers","following_url":"https://api.github.com/users/DeeJayLSP/following{/other_user}","gists_url":"https://api.github.com/users/DeeJayLSP/gists{/gist_id}","starred_url":"https://api.github.com/users/DeeJayLSP/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/DeeJayLSP/subscriptions","organizations_url":"https://api.github.com/users/DeeJayLSP/orgs","repos_url":"https://api.github.com/users/DeeJayLSP/repos","events_url":"https://api.github.com/users/DeeJayLSP/events{/privacy}","received_events_url":"https://api.github.com/users/DeeJayLSP/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-05-14T12:52:30Z","updated_at":"2025-05-14T13:35:54Z","body":"At 1000 bunnies, `master` vs PR\r\n![master-vs-PR](https://github.com/user-attachments/assets/b2d21264-0736-4f78-85c4-29c889b91d3e)\r\n\r\nLooks like the problem was never inside `Variant::get_named` or `Variant::set_named`, which are actually benefited by this PR. `VariantSetGet_Vector2_x/y::validated_get` seems to get a massive increase in cycles.\r\n\r\nDoes anyone know a possible solution for this? Or is it too reliant on CoW?","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2880139113/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2881402194","html_url":"https://github.com/godotengine/godot/pull/105555#issuecomment-2881402194","issue_url":"https://api.github.com/repos/godotengine/godot/issues/105555","id":2881402194,"node_id":"IC_kwDOAO6SJc6rvrVS","user":{"login":"DeeJayLSP","id":60024671,"node_id":"MDQ6VXNlcjYwMDI0Njcx","avatar_url":"https://avatars.githubusercontent.com/u/60024671?v=4","gravatar_id":"","url":"https://api.github.com/users/DeeJayLSP","html_url":"https://github.com/DeeJayLSP","followers_url":"https://api.github.com/users/DeeJayLSP/followers","following_url":"https://api.github.com/users/DeeJayLSP/following{/other_user}","gists_url":"https://api.github.com/users/DeeJayLSP/gists{/gist_id}","starred_url":"https://api.github.com/users/DeeJayLSP/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/DeeJayLSP/subscriptions","organizations_url":"https://api.github.com/users/DeeJayLSP/orgs","repos_url":"https://api.github.com/users/DeeJayLSP/repos","events_url":"https://api.github.com/users/DeeJayLSP/events{/privacy}","received_events_url":"https://api.github.com/users/DeeJayLSP/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-05-14T19:58:57Z","updated_at":"2025-05-17T04:29:08Z","body":"It seems like whatever overhead in `GDScriptInstance::set/get()` created by this change can be mitigated by using `std::move()` when setting/getting the variant.\r\n\r\nI don't know if doing this would create unwanted behavior or possibly cause crashes, but so far it recovers some of the performance loss (the increase in `Variant::operator=` mentioned [here](https://github.com/godotengine/godot/pull/105555#issuecomment-2874963566) goes away and the FPS with 1000 bunnies is higher), tests pass and TPS Demo runs just fine.\r\n\r\nI ***think*** the lack of CoW is causing `Variant` constructors to be called in the VM, resulting in overhead. It was fixed on `set`/`get`'s side by using `std::move()`, and I don't know how to do it on the VM's side, or if this is even possible or viable at this point.","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2881402194/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3604719833","html_url":"https://github.com/godotengine/godot/pull/105555#issuecomment-3604719833","issue_url":"https://api.github.com/repos/godotengine/godot/issues/105555","id":3604719833,"node_id":"IC_kwDOAO6SJc7W26jZ","user":{"login":"DeeJayLSP","id":60024671,"node_id":"MDQ6VXNlcjYwMDI0Njcx","avatar_url":"https://avatars.githubusercontent.com/u/60024671?v=4","gravatar_id":"","url":"https://api.github.com/users/DeeJayLSP","html_url":"https://github.com/DeeJayLSP","followers_url":"https://api.github.com/users/DeeJayLSP/followers","following_url":"https://api.github.com/users/DeeJayLSP/following{/other_user}","gists_url":"https://api.github.com/users/DeeJayLSP/gists{/gist_id}","starred_url":"https://api.github.com/users/DeeJayLSP/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/DeeJayLSP/subscriptions","organizations_url":"https://api.github.com/users/DeeJayLSP/orgs","repos_url":"https://api.github.com/users/DeeJayLSP/repos","events_url":"https://api.github.com/users/DeeJayLSP/events{/privacy}","received_events_url":"https://api.github.com/users/DeeJayLSP/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-12-03T02:07:25Z","updated_at":"2025-12-03T03:26:08Z","body":"Rebased after a very long time.\r\n\r\nBy the time I opened this PR I *thought* I knew how to read `perf` outputs, but #112129 taught me a lesson (didn't know callback cycles around the change increasing could potentially indicate a perfomance gain)\r\n\r\nHere are a few changes I did:\r\n- Keeping it as `Tight`, as the vector never gets resized except when the GDScript instance is made or when reloading the script.\r\n- All `std::move()` workarounds removed (except the script reload one) as they turned out to be doing more harm than good.\r\n\r\nOn very recent tests, when it comes to Bunnymark, there should be no performance difference at 500 bunnies, maybe a 0.06% gain (from many runs with the least amount programs running on background + Feral GameMode, as GDScript is ***extremely*** sensible to fluctuations when not performing too heavy tasks).\r\n\r\nLastly, when running before and after at the same time, it's possible to see sometimes that memory usage isn't stable. Sometimes before consumes many more MBs, sometimes after does. But when they match, after is always one MB lower than before. Also the build is 4KiB smaller.\r\n\r\nFrom a recent discussion in the Contributors Chat, the conclusion is that `members` here shouldn't need CoW at all (`members` uses a CoW vector since before the engine was open-sourced). Maybe #107002 could be dismissed.\r\n\r\nWill update the PR description later.","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3604719833/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3607397492","html_url":"https://github.com/godotengine/godot/pull/105555#issuecomment-3607397492","issue_url":"https://api.github.com/repos/godotengine/godot/issues/105555","id":3607397492,"node_id":"IC_kwDOAO6SJc7XBIR0","user":{"login":"DeeJayLSP","id":60024671,"node_id":"MDQ6VXNlcjYwMDI0Njcx","avatar_url":"https://avatars.githubusercontent.com/u/60024671?v=4","gravatar_id":"","url":"https://api.github.com/users/DeeJayLSP","html_url":"https://github.com/DeeJayLSP","followers_url":"https://api.github.com/users/DeeJayLSP/followers","following_url":"https://api.github.com/users/DeeJayLSP/following{/other_user}","gists_url":"https://api.github.com/users/DeeJayLSP/gists{/gist_id}","starred_url":"https://api.github.com/users/DeeJayLSP/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/DeeJayLSP/subscriptions","organizations_url":"https://api.github.com/users/DeeJayLSP/orgs","repos_url":"https://api.github.com/users/DeeJayLSP/repos","events_url":"https://api.github.com/users/DeeJayLSP/events{/privacy}","received_events_url":"https://api.github.com/users/DeeJayLSP/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-12-03T15:25:33Z","updated_at":"2025-12-03T15:25:33Z","body":"PR description updated with newer benchmarks and more considerations that are not the wrong profiler reading.","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3607397492/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4026858010","html_url":"https://github.com/godotengine/godot/pull/105555#issuecomment-4026858010","issue_url":"https://api.github.com/repos/godotengine/godot/issues/105555","id":4026858010,"node_id":"IC_kwDOAO6SJc7wBPoa","user":{"login":"DeeJayLSP","id":60024671,"node_id":"MDQ6VXNlcjYwMDI0Njcx","avatar_url":"https://avatars.githubusercontent.com/u/60024671?v=4","gravatar_id":"","url":"https://api.github.com/users/DeeJayLSP","html_url":"https://github.com/DeeJayLSP","followers_url":"https://api.github.com/users/DeeJayLSP/followers","following_url":"https://api.github.com/users/DeeJayLSP/following{/other_user}","gists_url":"https://api.github.com/users/DeeJayLSP/gists{/gist_id}","starred_url":"https://api.github.com/users/DeeJayLSP/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/DeeJayLSP/subscriptions","organizations_url":"https://api.github.com/users/DeeJayLSP/orgs","repos_url":"https://api.github.com/users/DeeJayLSP/repos","events_url":"https://api.github.com/users/DeeJayLSP/events{/privacy}","received_events_url":"https://api.github.com/users/DeeJayLSP/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-03-09T20:55:07Z","updated_at":"2026-03-09T20:55:25Z","body":"Switched back to regular `LocalVector`. While the performance change is around the same and the vector is never resized, `members` being a `LocalVector` decreased build sizes by a total of 8KiB.","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4026858010/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null}]