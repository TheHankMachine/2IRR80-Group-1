t/followers","following_url":"https://api.github.com/users/wjt/following{/other_user}","gists_url":"https://api.github.com/users/wjt/gists{/gist_id}","starred_url":"https://api.github.com/users/wjt/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/wjt/subscriptions","organizations_url":"https://api.github.com/users/wjt/orgs","repos_url":"https://api.github.com/users/wjt/repos","events_url":"https://api.github.com/users/wjt/events{/privacy}","received_events_url":"https://api.github.com/users/wjt/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"","state":"COMMENTED","html_url":"https://github.com/godotengine/godot/pull/114129#pullrequestreview-3592419887","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/114129","author_association":"CONTRIBUTOR","_links":{"html":{"href":"https://github.com/godotengine/godot/pull/114129#pullrequestreview-3592419887"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/114129"}},"submitted_at":"2025-12-18T11:39:51Z","commit_id":null},{"id":3592426993,"node_id":"PRR_kwDOAO6SJc7WIBXx","user":{"login":"AThousandShips","id":96648715,"node_id":"U_kgDOBcK-Cw","avatar_url":"https://avatars.githubusercontent.com/u/96648715?u=af70f5d107e9c1447f296643d5a566dab53d25e8&v=4","gravatar_id":"","url":"https://api.github.com/users/AThousandShips","html_url":"https://github.com/AThousandShips","followers_url":"https://api.github.com/users/AThousandShips/followers","following_url":"https://api.github.com/users/AThousandShips/following{/other_user}","gists_url":"https://api.github.com/users/AThousandShips/gists{/gist_id}","starred_url":"https://api.github.com/users/AThousandShips/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/AThousandShips/subscriptions","organizations_url":"https://api.github.com/users/AThousandShips/orgs","repos_url":"https://api.github.com/users/AThousandShips/repos","events_url":"https://api.github.com/users/AThousandShips/events{/privacy}","received_events_url":"https://api.github.com/users/AThousandShips/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"Approving on the documentation side, but exposing this makes sense but let's get the thoughts of the audio team as well to make sure we haven't missed some reason this wasn't exposed","state":"APPROVED","html_url":"https://github.com/godotengine/godot/pull/114129#pullrequestreview-3592426993","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/114129","author_association":"MEMBER","_links":{"html":{"href":"https://github.com/godotengine/godot/pull/114129#pullrequestreview-3592426993"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/114129"}},"submitted_at":"2025-12-18T11:40:54Z","commit_id":"96eaa49fbbf967613ceca0315288aa5979548573"},{"id":3812395158,"node_id":"PRR_kwDOAO6SJc7jPIiW","user":{"login":"Ivorforce","id":2308167,"node_id":"MDQ6VXNlcjIzMDgxNjc=","avatar_url":"https://avatars.githubusercontent.com/u/2308167?u=f7f8e0273f784f5ec6f6b7fe4a88d449896eb48a&v=4","gravatar_id":"","url":"https://api.github.com/users/Ivorforce","html_url":"https://github.com/Ivorforce","followers_url":"https://api.github.com/users/Ivorforce/followers","following_url":"https://api.github.com/users/Ivorforce/following{/other_user}","gists_url":"https://api.github.com/users/Ivorforce/gists{/gist_id}","starred_url":"https://api.github.com/users/Ivorforce/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Ivorforce/subscriptions","organizations_url":"https://api.github.com/users/Ivorforce/orgs","repos_url":"https://api.github.com/users/Ivorforce/repos","events_url":"https://api.github.com/users/Ivorforce/events{/privacy}","received_events_url":"https://api.github.com/users/Ivorforce/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"This was added in https://github.com/godotengine/godot/pull/64488, which is a huge PR. \n`TRANSITION_TO_TIME_PREVIOUS_POSITION` was not discussed, so I think it's probable that there is no reason this is not exposed.\n\nI'm not familiar with `AudioStreamInteractive` though so I'll bring it to the next audio meeting and we'll decide there.","state":"COMMENTED","html_url":"https://github.com/godotengine/godot/pull/114129#pullrequestreview-3812395158","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/114129","author_association":"MEMBER","_links":{"html":{"href":"https://github.com/godotengine/godot/pull/114129#pullrequestreview-3812395158"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/114129"}},"submitted_at":"2026-02-17T08:27:36Z","commit_id":"1521d1c1fdd1e5122b2d3cdd105fa639e9a4d57f"},{"id":4191201191,"node_id":"PRR_kwDOAO6SJc750Ken","user":{"login":"Akosmo","id":95504962,"node_id":"U_kgDOBbFKQg","avatar_url":"https://avatars.githubusercontent.com/u/95504962?u=80438adc5ffbc7bbf00b64757b445f273cf333b2&v=4","gravatar_id":"","url":"https://api.github.com/users/Akosmo","html_url":"https://github.com/Akosmo","followers_url":"https://api.github.com/users/Akosmo/followers","following_url":"https://api.github.com/users/Akosmo/following{/other_user}","gists_url":"https://api.github.com/users/Akosmo/gists{/gist_id}","starred_url":"https://api.github.com/users/Akosmo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Akosmo/subscriptions","organizations_url":"https://api.github.com/users/Akosmo/orgs","repos_url":"https://api.github.com/users/Akosmo/repos","events_url":"https://api.github.com/users/Akosmo/events{/privacy}","received_events_url":"https://api.github.com/users/Akosmo/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"This looks good to me.\n\nMy review summary:\nWhen a clip is being mixed, its playback position is always recorded ([code](https://github.com/godotengine/godot/blob/a8643700ce8affae9fed0d2688b9f7867f5b7d4e/modules/interactive_music/audio_stream_interactive.cpp#L926)). If `TransitionToTime` is set to the `PREVIOUS_POSITION` constant, it uses that recorded position as an argument for a `start()` call before transition happens ([code 1](https://github.com/godotengine/godot/blob/a8643700ce8affae9fed0d2688b9f7867f5b7d4e/modules/interactive_music/audio_stream_interactive.cpp#L737), [code 2](https://github.com/godotengine/godot/blob/a8643700ce8affae9fed0d2688b9f7867f5b7d4e/modules/interactive_music/audio_stream_interactive.cpp#L777)).\nThe constant already works properly if set in the Transition Editor. And when a transition is set in it, it just calls the exposed `add_transition()` function ([code](https://github.com/godotengine/godot/blob/320e81846979bd716341e0669231954543c4afbd/modules/interactive_music/editor/audio_stream_interactive_editor_plugin.cpp#L85)).\nBasically, the constant already works, and there's no difference I've noticed from setting a transition via code vs via the editor.\nI also fetched this PR and tested it. Works on my end.","state":"APPROVED","html_url":"https://github.com/godotengine/godot/pull/114129#pullrequestreview-4191201191","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/114129","author_association":"MEMBER","_links":{"html":{"href":"https://github.com/godotengine/godot/pull/114129#pullrequestreview-4191201191"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/114129"}},"submitted_at":"2026-04-28T17:48:38Z","commit_id":"96eaa49fbbf967613ceca0315288aa5979548573"},{"id":4191697826,"node_id":"PRR_kwDOAO6SJc752Dui","user":{"login":"Ivorforce","id":2308167,"node_id":"MDQ6VXNlcjIzMDgxNjc=","avatar_url":"https://avatars.githubusercontent.com/u/2308167?u=f7f8e0273f784f5ec6f6b7fe4a88d449896eb48a&v=4","gravatar_id":"","url":"https://api.github.com/users/Ivorforce","html_url":"https://github.com/Ivorforce","followers_url":"https://api.github.com/users/Ivorforce/followers","following_url":"https://api.github.com/users/Ivorforce/following{/other_user}","gists_url":"https://api.github.com/users/Ivorforce/gists{/gist_id}","starred_url":"https://api.github.com/users/Ivorforce/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Ivorforce/subscriptions","organizations_url":"https://api.github.com/users/Ivorforce/orgs","repos_url":"https://api.github.com/users/Ivorforce/repos","events_url":"https://api.github.com/users/Ivorforce/events{/privacy}","received_events_url":"https://api.github.com/users/Ivorforce/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"Given the circumstances and the fact that it works and has a use, I think it's safe to assume it was merely forgotten when exposing the rest.\r\n\r\nThank you @Akosmo for testing!\r\n\r\n@wjt The PR needs a rebase to be mergable. Not sure if it will make it into 4.7 - we're past feature freeze, though this PR isn't doing anything new, so perhaps it could be seen as a bugfix.","state":"APPROVED","html_url":"https://github.com/godotengine/godot/pull/114129#pullrequestreview-4191697826","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/114129","author_association":"MEMBER","_links":{"html":{"href":"https://github.com/godotengine/godot/pull/114129#pullrequestreview-4191697826"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/114129"}},"submitted_at":"2026-04-28T19:12:58Z","commit_id":"96eaa49fbbf967613ceca0315288aa5979548573"}]