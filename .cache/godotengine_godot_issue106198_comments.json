ercontent.com/u/124409014?v=4","gravatar_id":"","url":"https://api.github.com/users/SanNull","html_url":"https://github.com/SanNull","followers_url":"https://api.github.com/users/SanNull/followers","following_url":"https://api.github.com/users/SanNull/following{/other_user}","gists_url":"https://api.github.com/users/SanNull/gists{/gist_id}","starred_url":"https://api.github.com/users/SanNull/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/SanNull/subscriptions","organizations_url":"https://api.github.com/users/SanNull/orgs","repos_url":"https://api.github.com/users/SanNull/repos","events_url":"https://api.github.com/users/SanNull/events{/privacy}","received_events_url":"https://api.github.com/users/SanNull/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-05-10T11:11:58Z","updated_at":"2025-05-10T18:48:14Z","body":"I opted to remove the check in `GdScriptEditor` so although it works again for these two cases, it will attempt to complete the `func`  keyword with one of the user's custom functions (if they have a sequence of characters in the same order as func's).\r\n\r\nFrom what I have seen `GdScriptEditor::complete_code` currently runs our block of code only when you type the keyword, regardless if you add `spaces `or ` _` later. This makes it really difficult to prevent early autocompletion, at least within the scope of `GdScriptEditor::complete_code` that is. ","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2868748938/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2868843667","html_url":"https://github.com/godotengine/godot/pull/106198#issuecomment-2868843667","issue_url":"https://api.github.com/repos/godotengine/godot/issues/106198","id":2868843667,"node_id":"IC_kwDOAO6SJc6q_xST","user":{"login":"SanNull","id":124409014,"node_id":"U_kgDOB2pUtg","avatar_url":"https://avatars.githubusercontent.com/u/124409014?v=4","gravatar_id":"","url":"https://api.github.com/users/SanNull","html_url":"https://github.com/SanNull","followers_url":"https://api.github.com/users/SanNull/followers","following_url":"https://api.github.com/users/SanNull/following{/other_user}","gists_url":"https://api.github.com/users/SanNull/gists{/gist_id}","starred_url":"https://api.github.com/users/SanNull/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/SanNull/subscriptions","organizations_url":"https://api.github.com/users/SanNull/orgs","repos_url":"https://api.github.com/users/SanNull/repos","events_url":"https://api.github.com/users/SanNull/events{/privacy}","received_events_url":"https://api.github.com/users/SanNull/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-05-10T13:16:14Z","updated_at":"2025-05-20T01:30:41Z","body":"~~@HolonProduction I  think I am able to bring only the  `_`  without causing early code completion, would that be a good compromise? In my tests with Godot 4.1.1, when you add a space after `func`, it either doesn't do anything or it shows many  unrelated items:~~\r\n\r\n![request_2](https://github.com/user-attachments/assets/28fd780a-d41f-4243-9be0-dd47dc15ff6e)\r\n\r\n![request](https://github.com/user-attachments/assets/e7224ce0-d8f6-4932-970e-6f7b65edcc3f)\r\n\r\n\r\n~~It may be a bug introduced before this PR, but I had never noticed it before.~~\r\n\r\n**Edit:** Problem got resolved, see bellow.","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2868843667/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":{"reason":"outdated"}},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2881058952","html_url":"https://github.com/godotengine/godot/pull/106198#issuecomment-2881058952","issue_url":"https://api.github.com/repos/godotengine/godot/issues/106198","id":2881058952,"node_id":"IC_kwDOAO6SJc6ruXiI","user":{"login":"SanNull","id":124409014,"node_id":"U_kgDOB2pUtg","avatar_url":"https://avatars.githubusercontent.com/u/124409014?v=4","gravatar_id":"","url":"https://api.github.com/users/SanNull","html_url":"https://github.com/SanNull","followers_url":"https://api.github.com/users/SanNull/followers","following_url":"https://api.github.com/users/SanNull/following{/other_user}","gists_url":"https://api.github.com/users/SanNull/gists{/gist_id}","starred_url":"https://api.github.com/users/SanNull/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/SanNull/subscriptions","organizations_url":"https://api.github.com/users/SanNull/orgs","repos_url":"https://api.github.com/users/SanNull/repos","events_url":"https://api.github.com/users/SanNull/events{/privacy}","received_events_url":"https://api.github.com/users/SanNull/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-05-14T17:49:06Z","updated_at":"2025-05-20T01:30:28Z","body":"I was able to add auto completion both for `space` and `undescore` back, and also prevent ealy code completion! Though, for the former it's inconsistent to get the autocompletion (this also happens in previous versions of Godot, so it's out of the scope for this PR). Either way, here's the showcase:\r\n\r\n![finally_done](https://github.com/user-attachments/assets/38ccbbff-f3c0-49be-83c4-b173a4567d1e)\r\n\r\nI believe this PR is fully ready for review on the GDScript side! Would be glad if this got merged before 4.5 feature-freeze.","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2881058952/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":{"reason":"outdated"}},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2888649233","html_url":"https://github.com/godotengine/godot/pull/106198#issuecomment-2888649233","issue_url":"https://api.github.com/repos/godotengine/godot/issues/106198","id":2888649233,"node_id":"IC_kwDOAO6SJc6sLUoR","user":{"login":"SanNull","id":124409014,"node_id":"U_kgDOB2pUtg","avatar_url":"https://avatars.githubusercontent.com/u/124409014?v=4","gravatar_id":"","url":"https://api.github.com/users/SanNull","html_url":"https://github.com/SanNull","followers_url":"https://api.github.com/users/SanNull/followers","following_url":"https://api.github.com/users/SanNull/following{/other_user}","gists_url":"https://api.github.com/users/SanNull/gists{/gist_id}","starred_url":"https://api.github.com/users/SanNull/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/SanNull/subscriptions","organizations_url":"https://api.github.com/users/SanNull/orgs","repos_url":"https://api.github.com/users/SanNull/repos","events_url":"https://api.github.com/users/SanNull/events{/privacy}","received_events_url":"https://api.github.com/users/SanNull/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-05-18T00:07:51Z","updated_at":"2025-05-20T01:45:48Z","body":"- `Static` and `Non-Static` methods now don't appear interchangeably:\r\n\r\n![Diff between static and normal functions](https://github.com/user-attachments/assets/93b05bac-5c04-46c3-8ea1-d68074ff023d)\r\n\r\n- Added tests for cases when overriding methods with an `underscore`, a `static` keyword, or a simple `non-static` method _(as of 05/19, signatures with `callables` and `arguments` are tested as well)_\r\n\r\nEDIT: At the time I made this comment I had encountered problems while writing tests, due to the signature adding unnecessary characters after `:`. _Most of the time they were invisible so you can say I had a lot of fun debugging this_ 😅. Nevertheless, I was able to fix this and better write the aforementioned test cases","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2888649233/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2892097551","html_url":"https://github.com/godotengine/godot/pull/106198#issuecomment-2892097551","issue_url":"https://api.github.com/repos/godotengine/godot/issues/106198","id":2892097551,"node_id":"IC_kwDOAO6SJc6sYegP","user":{"login":"SanNull","id":124409014,"node_id":"U_kgDOB2pUtg","avatar_url":"https://avatars.githubusercontent.com/u/124409014?v=4","gravatar_id":"","url":"https://api.github.com/users/SanNull","html_url":"https://github.com/SanNull","followers_url":"https://api.github.com/users/SanNull/followers","following_url":"https://api.github.com/users/SanNull/following{/other_user}","gists_url":"https://api.github.com/users/SanNull/gists{/gist_id}","starred_url":"https://api.github.com/users/SanNull/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/SanNull/subscriptions","organizations_url":"https://api.github.com/users/SanNull/orgs","repos_url":"https://api.github.com/users/SanNull/repos","events_url":"https://api.github.com/users/SanNull/events{/privacy}","received_events_url":"https://api.github.com/users/SanNull/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-05-19T19:42:28Z","updated_at":"2025-05-21T23:43:37Z","body":"- Cleaned up the function signature so its last character will always be  `:` (previous implementation was adding unnecessary characters after Colon and messing up with the Tests, see [this for more info](https://github.com/godotengine/godot/pull/106198#discussion_r2100690034))\r\n\r\n- Removed check in `GdScriptEditor` that would avoid early autocompletion, as it was working inconsistently and is part of a broader issue. So, GDScript will prematurely autocomplete functions if one or more functions have characters  in common with `func` and the characters appear in the same order.","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2892097551/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2921310329","html_url":"https://github.com/godotengine/godot/pull/106198#issuecomment-2921310329","issue_url":"https://api.github.com/repos/godotengine/godot/issues/106198","id":2921310329,"node_id":"IC_kwDOAO6SJc6uH6h5","user":{"login":"SanNull","id":124409014,"node_id":"U_kgDOB2pUtg","avatar_url":"https://avatars.githubusercontent.com/u/124409014?v=4","gravatar_id":"","url":"https://api.github.com/users/SanNull","html_url":"https://github.com/SanNull","followers_url":"https://api.github.com/users/SanNull/followers","following_url":"https://api.github.com/users/SanNull/following{/other_user}","gists_url":"https://api.github.com/users/SanNull/gists{/gist_id}","starred_url":"https://api.github.com/users/SanNull/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/SanNull/subscriptions","organizations_url":"https://api.github.com/users/SanNull/orgs","repos_url":"https://api.github.com/users/SanNull/repos","events_url":"https://api.github.com/users/SanNull/events{/privacy}","received_events_url":"https://api.github.com/users/SanNull/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-05-30T05:56:00Z","updated_at":"2025-05-30T05:56:00Z","body":"@HolonProduction Should we add more tests for the feature? Wonder if there's any pitfalls not considered in the latest commit.","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2921310329/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2952441836","html_url":"https://github.com/godotengine/godot/pull/106198#issuecomment-2952441836","issue_url":"https://api.github.com/repos/godotengine/godot/issues/106198","id":2952441836,"node_id":"IC_kwDOAO6SJc6v-q_s","user":{"login":"SanNull","id":124409014,"node_id":"U_kgDOB2pUtg","avatar_url":"https://avatars.githubusercontent.com/u/124409014?v=4","gravatar_id":"","url":"https://api.github.com/users/SanNull","html_url":"https://github.com/SanNull","followers_url":"https://api.github.com/users/SanNull/followers","following_url":"https://api.github.com/users/SanNull/following{/other_user}","gists_url":"https://api.github.com/users/SanNull/gists{/gist_id}","starred_url":"https://api.github.com/users/SanNull/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/SanNull/subscriptions","organizations_url":"https://api.github.com/users/SanNull/orgs","repos_url":"https://api.github.com/users/SanNull/repos","events_url":"https://api.github.com/users/SanNull/events{/privacy}","received_events_url":"https://api.github.com/users/SanNull/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-06-07T12:42:38Z","updated_at":"2025-06-08T08:02:17Z","body":"- Added `_static_init ` to the tests, and made sure it only gets added to the completion box when the user is overriding a static function. \n\nThis also fixes non-static functions showing up when overriding a static function as well.","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2952441836/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"