:\r\n```cpp\r\n\t\t\tint key = anim->track_find_key(track, current_time, Animation::FIND_MODE_NEAREST, false, !p_backward);\r\n\t\t\tint next_key = key++;\r\n\t\t\tif (key == -1 || next_key > anim->track_get_key_count(track)) {\r\n\t\t\t\tcontinue;\r\n\t\t\t}\r\n\t\t\tdouble key_time = anim->track_get_key_time(track, next_key);\r\n```","created_at":"2026-03-19T23:21:25Z","updated_at":"2026-03-19T23:31:21Z","html_url":"https://github.com/godotengine/godot/pull/117656#discussion_r2963235396","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/117656","_links":{"self":{"href":"https://api.github.com/repos/godotengine/godot/pulls/comments/2963235396"},"html":{"href":"https://github.com/godotengine/godot/pull/117656#discussion_r2963235396"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/117656"}},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/2963235396/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":268,"original_line":268,"side":"RIGHT","in_reply_to_id":2963182425,"author_association":"MEMBER","original_position":5,"position":5,"subject_type":"line"},{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/2963290681","pull_request_review_id":3978614984,"id":2963290681,"node_id":"PRRC_kwDOAO6SJc6woDo5","diff_hunk":"@@ -265,7 +265,7 @@ void AnimationPlayerEditor::go_to_nearest_keyframe(bool p_backward) {\n \n \tdouble current_time = player->get_current_animation_position();\n \t// Offset the time to avoid finding the same keyframe with Animation::track_find_key().\n-\tdouble time_offset = MAX(CMP_EPSILON * 2, current_time * CMP_EPSILON * 2);\n+\tdouble time_offset = MAX(frame->get_step(), current_time * frame->get_step());","path":"editor/animation/animation_player_editor_plugin.cpp","commit_id":"21ed5e3fe2f710c033ef43ca4fc66dfa14f5d2a8","original