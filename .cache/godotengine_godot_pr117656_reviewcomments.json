/users/jack-klein-5/followers","following_url":"https://api.github.com/users/jack-klein-5/following{/other_user}","gists_url":"https://api.github.com/users/jack-klein-5/gists{/gist_id}","starred_url":"https://api.github.com/users/jack-klein-5/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/jack-klein-5/subscriptions","organizations_url":"https://api.github.com/users/jack-klein-5/orgs","repos_url":"https://api.github.com/users/jack-klein-5/repos","events_url":"https://api.github.com/users/jack-klein-5/events{/privacy}","received_events_url":"https://api.github.com/users/jack-klein-5/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"That's a good question. Step size is .0001 seconds, so I don't think the edge case is common enough to be an issue. In engine use I'm only able to add a keyframe every .03 seconds or so anyway, so I'm not sure you could break it if you wanted to.","created_at":"2026-03-19T23:15:24Z","updated_at":"2026-03-19T23:15:25Z","html_url":"https://github.com/godotengine/godot/pull/117656#discussion_r2963215495","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/117656","_links":{"self":{"href":"https://api.github.com/repos/godotengine/godot/pulls/comments/2963215495"},"html":{"href":"https://github.com/godotengine/godot/pull/117656#discussion_r2963215495"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/117656"}},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/2963215495/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":268,"original_line":268,"side":"RIGHT","in_reply_to_id":2963182425,"author_association":"CONTRIBUTOR","original_position":5,"position":5,"subject_type":"line"},{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/2963235396","pull_request_review_id":