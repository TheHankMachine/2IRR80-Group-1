[{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2993614821","html_url":"https://github.com/godotengine/godot/issues/107731#issuecomment-2993614821","issue_url":"https://api.github.com/repos/godotengine/godot/issues/107731","id":2993614821,"node_id":"IC_kwDOAO6SJc6ybu_l","user":{"login":"apples","id":2352020,"node_id":"MDQ6VXNlcjIzNTIwMjA=","avatar_url":"https://avatars.githubusercontent.com/u/2352020?v=4","gravatar_id":"","url":"https://api.github.com/users/apples","html_url":"https://github.com/apples","followers_url":"https://api.github.com/users/apples/followers","following_url":"https://api.github.com/users/apples/following{/other_user}","gists_url":"https://api.github.com/users/apples/gists{/gist_id}","starred_url":"https://api.github.com/users/apples/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/apples/subscriptions","organizations_url":"https://api.github.com/users/apples/orgs","repos_url":"https://api.github.com/users/apples/repos","events_url":"https://api.github.com/users/apples/events{/privacy}","received_events_url":"https://api.github.com/users/apples/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-06-21T14:40:13Z","updated_at":"2025-06-21T14:40:13Z","body":"Confirmed, this issue was already known. I'm not sure if there's a trivial fix for this, because the material is actually processed that many times in-editor. We could make it a warning, but it'd still be duplicated.","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2993614821/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3013958925","html_url":"https://github.com/godotengine/godot/issues/107731#issuecomment-3013958925","issue_url":"https://api.github.com/repos/godotengine/godot/issues/107731","id":3013958925,"node_id":"IC_kwDOAO6SJc6zpV0N","user":{"login":"Calinou","id":180032,"node_id":"MDQ6VXNlcjE4MDAzMg==","avatar_url":"https://avatars.githubusercontent.com/u/180032?v=4","gravatar_id":"","url":"https://api.github.com/users/Calinou","html_url":"https://github.com/Calinou","followers_url":"https://api.github.com/users/Calinou/followers","following_url":"https://api.github.com/users/Calinou/following{/other_user}","gists_url":"https://api.github.com/users/Calinou/gists{/gist_id}","starred_url":"https://api.github.com/users/Calinou/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Calinou/subscriptions","organizations_url":"https://api.github.com/users/Calinou/orgs","repos_url":"https://api.github.com/users/Calinou/repos","events_url":"https://api.github.com/users/Calinou/events{/privacy}","received_events_url":"https://api.github.com/users/Calinou/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-06-27T18:03:52Z","updated_at":"2025-06-27T18:03:52Z","body":"> We could make it a warning, but it'd still be duplicated.\n\nYou can use `WARN_PRINT_ONCE()` to make the warning printed once per editor/runtime session.","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3013958925/reactions","total_count":2,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":1,"heart":1,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3014684426","html_url":"https://github.com/godotengine/godot/issues/107731#issuecomment-3014684426","issue_url":"https://api.github.com/repos/godotengine/godot/issues/107731","id":3014684426,"node_id":"IC_kwDOAO6SJc6zsG8K","user":{"login":"apples","id":2352020,"node_id":"MDQ6VXNlcjIzNTIwMjA=","avatar_url":"https://avatars.githubusercontent.com/u/2352020?v=4","gravatar_id":"","url":"https://api.github.com/users/apples","html_url":"https://github.com/apples","followers_url":"https://api.github.com/users/apples/followers","following_url":"https://api.github.com/users/apples/following{/other_user}","gists_url":"https://api.github.com/users/apples/gists{/gist_id}","starred_url":"https://api.github.com/users/apples/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/apples/subscriptions","organizations_url":"https://api.github.com/users/apples/orgs","repos_url":"https://api.github.com/users/apples/repos","events_url":"https://api.github.com/users/apples/events{/privacy}","received_events_url":"https://api.github.com/users/apples/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-06-28T00:04:35Z","updated_at":"2025-06-28T00:04:35Z","body":"> You can use `WARN_PRINT_ONCE()` to make the warning printed once per editor/runtime session.\n\nYeah but then it won't be printed for other materials which have the same issue.\n\nFor what it's worth, there is another error with this same issue:\nhttps://github.com/godotengine/godot/blob/ebc36a722593a131f0b1d88aa85f9e24d82b0766/servers/rendering/renderer_rd/forward_clustered/render_forward_clustered.cpp#L4081-L4086\n\n(Also found in the other renderers.)\n\nIf this error is triggered (e.g. trying to use normal map on a point mesh), it will also be printed many times.\n\nIf we solve this issue for one, we should apply the solution to both messages.","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3014684426/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null}]