r-attachments/assets/de0a4c23-105e-418e-8231-4b019112207a)\nThere are the logs that getting the downloaded bytes from HTTPRequest in every frame\n\n### Minimal reproduction project (MRP)\n\nN/A","closed_by":{"login":"walterlcy713","id":35700140,"node_id":"MDQ6VXNlcjM1NzAwMTQw","avatar_url":"https://avatars.githubusercontent.com/u/35700140?v=4","gravatar_id":"","url":"https://api.github.com/users/walterlcy713","html_url":"https://github.com/walterlcy713","followers_url":"https://api.github.com/users/walterlcy713/followers","following_url":"https://api.github.com/users/walterlcy713/following{/other_user}","gists_url":"https://api.github.com/users/walterlcy713/gists{/gist_id}","starred_url":"https://api.github.com/users/walterlcy713/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/walterlcy713/subscriptions","organizations_url":"https://api.github.com/users/walterlcy713/orgs","repos_url":"https://api.github.com/users/walterlcy713/repos","events_url":"https://api.github.com/users/walterlcy713/events{/privacy}","received_events_url":"https://api.github.com/users/walterlcy713/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/106632/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/godotengine/godot/issues/106632/timeline","performed_via_github_app":null,"state_reason":"completed","pinned_comment":null}