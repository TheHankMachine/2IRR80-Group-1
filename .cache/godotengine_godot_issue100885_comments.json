com/users/RedMser","html_url":"https://github.com/RedMser","followers_url":"https://api.github.com/users/RedMser/followers","following_url":"https://api.github.com/users/RedMser/following{/other_user}","gists_url":"https://api.github.com/users/RedMser/gists{/gist_id}","starred_url":"https://api.github.com/users/RedMser/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/RedMser/subscriptions","organizations_url":"https://api.github.com/users/RedMser/orgs","repos_url":"https://api.github.com/users/RedMser/repos","events_url":"https://api.github.com/users/RedMser/events{/privacy}","received_events_url":"https://api.github.com/users/RedMser/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2024-12-29T03:06:49Z","updated_at":"2024-12-29T03:06:49Z","body":"IIRC it was already renamed. It also has some search keywords defined to help with discoverability (they are used when you press F1 to search for methods in Godot):\r\n\r\n> `<method name=\"remap\" keywords=\"range, lerp, interpolate\">`\r\n\r\nMaybe `normalize` could be added as well (ideally as part of a larger PR that adds more of these keywords all over the engine)? But not sure if that's a common name for this operation, since normalize usually has `[0..1]` range implied.","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2564596282/reactions","total_count":4,"+1":4,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2564597505","html_url":"https://github.com/godotengine/godot/pull/100885#issuecomment-2564597505","issue_url":"https://api.github.com/repos/godotengine/godot/issues/100885","id":2564597505,"node_id":"IC_kwDOAO6SJc6Y3KcB","user":{"login":"Lazy-Rabbit-2001","id":22123964,"node_id":"MDQ6VXNlcjIyMTIzOTY0","avatar_url":"https://avatars.githubusercontent.com/u/22123964?v=4","gravatar_id":"","url":"https://api.github.com/users/Lazy-Rabbit-2001","html_url":"https://github.com/Lazy-Rabbit-2001","followers_url":"https://api.github.com/users/Lazy-Rabbit-2001/followers","following_url":"https://api.github.com/users/Lazy-Rabbit-2001/following{/other_user}","gists_url":"https://api.github.com/users/Lazy-Rabbit-2001/gists{/gist_id}","starred_url":"https://api.github.com/users/Lazy-Rabbit-2001/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Lazy-Rabbit-2001/subscriptions","organizations_url":"https://api.github.com/users/Lazy-Rabbit-2001/orgs","repos_url":"https://api.github.com/users/Lazy-Rabbit-2001/repos","events_url":"https://api.github.com/users/Lazy-Rabbit-2001/events{/privacy}","received_events_url":"https://api.github.com/users/Lazy-Rabbit-2001/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2024-12-29T03:14:30Z","updated_at":"2024-12-29T03:14:30Z","body":"What's the difference between `normalize()` and `remap()`?","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2564597505/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2564697258","html_url":"https://github.com/godotengine/godot/pull/100885#issuecomment-2564697258","issue_url":"https://api.github.com/repos/godotengine/godot/issues/100885","id":2564697258,"node_id":"IC_kwDOAO6SJc6Y3iyq","user":{"login":"Mickeon","id":66727710,"node_id":"MDQ6VXNlcjY2NzI3NzEw","avatar_url":"https://avatars.githubusercontent.com/u/66727710?v=4","gravatar_id":"","url":"https://api.github.com/users/Mickeon","html_url":"https://github.com/Mickeon","followers_url":"https://api.github.com/users/Mickeon/followers","following_url":"https://api.github.com/users/Mickeon/following{/other_user}","gists_url":"https://api.github.com/users/Mickeon/gists{/gist_id}","starred_url":"https://api.github.com/users/Mickeon/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Mickeon/subscriptions","organizations_url":"https://api.github.com/users/Mickeon/orgs","repos_url":"https://api.github.com/users/Mickeon/repos","events_url":"https://api.github.com/users/Mickeon/events{/privacy}","received_events_url":"https://api.github.com/users/Mickeon/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2024-12-29T11:42:20Z","updated_at":"2024-12-29T11:50:30Z","body":"> IIRC it was already renamed.\r\n\r\nIt's called `range_lerp` in 3.x, but we renamed it because most people are familiar with this kind of function as [\"remapping\" one value from one range to another](https://docs.unity3d.com/Packages/com.unity.mathematics@1.2/api/Unity.Mathematics.math.remap.html).\r\n\r\n> What's the difference between `normalize()` and `remap()`?\r\n\r\nThey are identical. There's no point.\r\n\r\nAlso \"normalizing\" in Godot generally refers to converting to a value between `0.0` and `1.0`, which this function doesn't do. For that, there's [`inverse_lerp`](https://docs.godotengine.org/en/stable/classes/class_@globalscope.html#class-globalscope-method-inverse-lerp).","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2564697258/reactions","total_count":3,"+1":3,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2564721502","html_url":"https://github.com/godotengine/godot/pull/100885#issuecomment-2564721502","issue_url":"https://api.github.com/repos/godotengine/godot/issues/100885","id":2564721502,"node_id":"IC_kwDOAO6SJc6Y3ote","user":{"login":"Lazy-Rabbit-2001","id":22123964,"node_id":"MDQ6VXNlcjIyMTIzOTY0","avatar_url":"https://avatars.githubusercontent.com/u/22123964?v=4","gravatar_id":"","url":"https://api.github.com/users/Lazy-Rabbit-2001","html_url":"https://github.com/Lazy-Rabbit-2001","followers_url":"https://api.github.com/users/Lazy-Rabbit-2001/followers","following_url":"https://api.github.com/users/Lazy-Rabbit-2001/following{/other_user}","gists_url":"https://api.github.com/users/Lazy-Rabbit-2001/gists{/gist_id}","starred_url":"https://api.github.com/users/Lazy-Rabbit-2001/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Lazy-Rabbit-2001/subscriptions","organizations_url":"https://api.github.com/users/Lazy-Rabbit-2001/orgs","repos_url":"https://api.github.com/users/Lazy-Rabbit-2001/repos","events_url":"https://api.github.com/users/Lazy-Rabbit-2001/events{/privacy}","received_events_url":"https://api.github.com/users/Lazy-Rabbit-2001/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2024-12-29T13:12:34Z","updated_at":"2024-12-29T13:12:57Z","body":"> > What's the difference between `normalize()` and `remap()`?\r\n> \r\n> They are identical. There's no point.\r\n\r\nMe too, as we've already had this method. This pr doesn't make any distinguishable sense from `remap()`, and looks like a duplicate of it. :'(","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2564721502/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null}]