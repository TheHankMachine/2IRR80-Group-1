DU6TGFiZWwxMzMyMzAzMTE5","url":"https://api.github.com/repos/godotengine/godot/labels/regression","name":"regression","color":"ff63ac","default":false,"description":"","archived_at":null,"archived_by":null}],"state":"closed","locked":false,"assignees":[],"milestone":{"url":"https://api.github.com/repos/godotengine/godot/milestones/25","html_url":"https://github.com/godotengine/godot/milestone/25","labels_url":"https://api.github.com/repos/godotengine/godot/milestones/25/labels","id":15520464,"node_id":"MI_kwDOAO6SJc4A7NLQ","number":25,"title":"4.8","description":"","creator":{"login":"Repiteo","id":17489292,"node_id":"MDQ6VXNlcjE3NDg5Mjky","avatar_url":"https://avatars.githubusercontent.com/u/17489292?v=4","gravatar_id":"","url":"https://api.github.com/users/Repiteo","html_url":"https://github.com/Repiteo","followers_url":"https://api.github.com/users/Repiteo/followers","following_url":"https://api.github.com/users/Repiteo/following{/other_user}","gists_url":"https://api.github.com/users/Repiteo/gists{/gist_id}","starred_url":"https://api.github.com/users/Repiteo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Repiteo/subscriptions","organizations_url":"https://api.github.com/users/Repiteo/orgs","repos_url":"https://api.github.com/users/Repiteo/repos","events_url":"https://api.github.com/users/Repiteo/events{/privacy}","received_events_url":"https://api.github.com/users/Repiteo/received_events","type":"User","user_view_type":"public","site_admin":false},"open_issues":343,"closed_issues":2335,"state":"open","created_at":"2026-04-13T15:59:35Z","updated_at":"2026-10-22T06:28:22Z","due_on":null,"closed_at":null},"comments":2,"created_at":"2026-07-03T09:19:12Z","updated_at":"2026-07-04T01:29:17Z","closed_at":"2026-07-03T21:50:57Z","assignee":null,"author_association":"CONTRIBUTOR","issue_field_values":[],"type":null,"active_lock_reason":null,"draft":false,"pull_request":{"url":"https://api.github.com/repos/godotengine/godot/pulls/120886","html_url":"https://github.com/godotengine/godot/pull/120886","diff_url":"https://github.com/godotengine/godot/pull/120886.diff","patch_url":"https://github.com/godotengine/godot/pull/120886.patch","merged_at":"2026-07-03T21:50:57Z"},"body":"## What problem(s) does this PR solve?\r\n\r\n- Closes #120581\r\n\r\n## Additional information\r\n\r\nThe scene reconstruction in `_set_current_scene_nocheck` will trigger `update_resource_count` which will end up counting both references from the old and the new scene. There are many execution paths that can run `update_resource_count`, the most common being `_update_if_clean` issuing a deferred call to `_update_tree` which then calls `_update_node_subtree` which will `update_resource_count` on every node.\r\n\r\nSince the count will be corrupted anyway, I believe there is no point in clearing the count (`resource_count.clear();`) before the reconstruction.\r\n\r\nDuring local reproduction `update_resource_count` will end with the incorrect count before `_set_current_scene_nocheck` finishes, so it makes sense to me intervene near the end of `_set_current_scene_nocheck`. This intervention would consist of clearing the count (`resource_count.clear();`) and triggering a recount (`SceneTreeDock::get_singleton()->clear_previous_node_selection();`). The code already had the recount call, so I inserted the clear right before it.\r\n\r\nI have tested that after this change the issue is no longer reproduced, and the indicator still appears for any embedded resource used multiple times, and for external resources.\r\n\r\n*This particular issue is a common annoyance for our indie studio Psyches Media, so I'm glad to be able put time to fix it.*","closed_by":{"login":"Repiteo","id":17489292,"node_id":"MDQ6VXNlcjE3NDg5Mjky","avatar_url":"https://avatars.githubusercontent.com/u/17489292?v=4","gravatar_id":"","url":"https://api.github.com/users/Repiteo","html_url":"https://github.com/Repiteo","followers_url":"https://api.github.com/users/Repiteo/followers","following_url":"https://api.github.com/users/Repiteo/following{/other_user}","gists_url":"https://api.github.com/users/Repiteo/gists{/gist_id}","starred_url":"https://api.github.com/users/Repiteo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Repiteo/subscriptions","organizations_url":"https://api.github.com/users/Repiteo/orgs","repos_url":"https://api.github.com/users/Repiteo/repos","events_url":"https://api.github.com/users/Repiteo/events{/privacy}","received_events_url":"https://api.github.com/users/Repiteo/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/120886/reactions","total_count":2,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":1,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/godotengine/godot/issues/120886/timeline","performed_via_github_app":null,"state_reason":null}