[{"id":3009899328,"node_id":"PRR_kwDOAO6SJc6zZ2tA","user":{"login":"Ivorforce","id":2308167,"node_id":"MDQ6VXNlcjIzMDgxNjc=","avatar_url":"https://avatars.githubusercontent.com/u/2308167?u=f7f8e0273f784f5ec6f6b7fe4a88d449896eb48a&v=4","gravatar_id":"","url":"https://api.github.com/users/Ivorforce","html_url":"https://github.com/Ivorforce","followers_url":"https://api.github.com/users/Ivorforce/followers","following_url":"https://api.github.com/users/Ivorforce/following{/other_user}","gists_url":"https://api.github.com/users/Ivorforce/gists{/gist_id}","starred_url":"https://api.github.com/users/Ivorforce/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Ivorforce/subscriptions","organizations_url":"https://api.github.com/users/Ivorforce/orgs","repos_url":"https://api.github.com/users/Ivorforce/repos","events_url":"https://api.github.com/users/Ivorforce/events{/privacy}","received_events_url":"https://api.github.com/users/Ivorforce/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"Thanks! The change to return `Vector` instead of `List` makes sense to me. I think that should be an easy win.\r\n\r\nThe change to `AHashMap` would be nice indeed, but unfortunately, this is not possible, at least with the current implementation.\r\nThe reason is that `AHashMap` moves elements around in its data on change. Therefore, it is impossible to store pointers to mutable `AHashMap` elements. `Node` stores a pointer to `SceneTree::Group` within the hash map, which is the reason the address sanitizer fails in the unit tests.\r\n\r\nI recommend reverting the `AHashMap` change. It might be possible to pursue this change using pointers and explicit allocations, but I think that's out of scope and should be done in a follow-up PR.\r\n","state":"COMMENTED","html_url":"https://github.com/godotengine/godot/pull/108507#pullrequestreview-3009899328","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/108507","author_association":"MEMBER","_links":{"html":{"href":"https://github.com/godotengine/godot/pull/108507#pullrequestreview-3009899328"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/108507"}},"submitted_at":"2025-07-11T11:32:11Z","commit_id":null},{"id":3014156908,"node_id":"PRR_kwDOAO6SJc6zqGJs","user":{"login":"Ivorforce","id":2308167,"node_id":"MDQ6VXNlcjIzMDgxNjc=","avatar_url":"https://avatars.githubusercontent.com/u/2308167?u=f7f8e0273f784f5ec6f6b7fe4a88d449896eb48a&v=4","gravatar_id":"","url":"https://api.github.com/users/Ivorforce","html_url":"https://github.com/Ivorforce","followers_url":"https://api.github.com/users/Ivorforce/followers","following_url":"https://api.github.com/users/Ivorforce/following{/other_user}","gists_url":"https://api.github.com/users/Ivorforce/gists{/gist_id}","starred_url":"https://api.github.com/users/Ivorforce/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Ivorforce/subscriptions","organizations_url":"https://api.github.com/users/Ivorforce/orgs","repos_url":"https://api.github.com/users/Ivorforce/repos","events_url":"https://api.github.com/users/Ivorforce/events{/privacy}","received_events_url":"https://api.github.com/users/Ivorforce/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"I think this is worth doing.","state":"APPROVED","html_url":"https://github.com/godotengine/godot/pull/108507#pullrequestreview-3014156908","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/108507","author_association":"MEMBER","_links":{"html":{"href":"https://github.com/godotengine/godot/pull/108507#pullrequestreview-3014156908"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/108507"}},"submitted_at":"2025-07-13T13:07:49Z","commit_id":"56fa8caef4c1e95b3f577bc42c52cd686783dca2"}]