de_id":"MDU6TGFiZWwzMjQwOTUwMDYw","url":"https://api.github.com/repos/godotengine/godot/labels/performance","name":"performance","color":"447777","default":false,"description":"","archived_at":null,"archived_by":null}],"state":"closed","locked":false,"assignees":[],"milestone":{"url":"https://api.github.com/repos/godotengine/godot/milestones/23","html_url":"https://github.com/godotengine/godot/milestone/23","labels_url":"https://api.github.com/repos/godotengine/godot/milestones/23/labels","id":12939969,"node_id":"MI_kwDOAO6SJc4AxXLB","number":23,"title":"4.6","description":"","creator":{"login":"Repiteo","id":17489292,"node_id":"MDQ6VXNlcjE3NDg5Mjky","avatar_url":"https://avatars.githubusercontent.com/u/17489292?v=4","gravatar_id":"","url":"https://api.github.com/users/Repiteo","html_url":"https://github.com/Repiteo","followers_url":"https://api.github.com/users/Repiteo/followers","following_url":"https://api.github.com/users/Repiteo/following{/other_user}","gists_url":"https://api.github.com/users/Repiteo/gists{/gist_id}","starred_url":"https://api.github.com/users/Repiteo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Repiteo/subscriptions","organizations_url":"https://api.github.com/users/Repiteo/orgs","repos_url":"https://api.github.com/users/Repiteo/repos","events_url":"https://api.github.com/users/Repiteo/events{/privacy}","received_events_url":"https://api.github.com/users/Repiteo/received_events","type":"User","user_view_type":"public","site_admin":false},"open_issues":3,"closed_issues":2978,"state":"closed","created_at":"2025-05-22T16:25:52Z","updated_at":"2026-10-04T16:23:23Z","due_on":null,"closed_at":"2026-01-26T18:09:14Z"},"comments":1,"created_at":"2025-10-17T17:18:51Z","updated_at":"2025-10-27T19:43:55Z","closed_at":"2025-10-27T15:06:22Z","assignee":null,"author_association":"CONTRIBUTOR","issue_field_values":[],"type":null,"active_lock_reason":null,"draft":false,"pull_request":{"url":"https://api.github.com/repos/godotengine/godot/pulls/111766","html_url":"https://github.com/godotengine/godot/pull/111766","diff_url":"https://github.com/godotengine/godot/pull/111766.diff","patch_url":"https://github.com/godotengine/godot/pull/111766.patch","merged_at":"2025-10-27T15:06:21Z"},"body":"This affects all LineEdits (and TextEdits) where `set_emoji_menu_enabled()` is called, notably SpinBoxes and things that use SpinBoxes like ColorPicker and across the Editor.\r\nThe `set_emoji_menu_enabled()` method generated the context menu when it doesn't need to. `_update_context_menu()` is already called before the menu is opened.\r\n\r\nThe menu is still generated when the menu is opened. I have not noticed any performance issues when opening the menu. (It is the same case as when `set_emoji_menu_enabled()` is not called).\r\n\r\nI could have checked if the menu exists instead of removing the update, but I doubt this setting ever needs to be called while the menu is already visible, and other settings that affect the menu like `editable` don't update it immediately either.\r\n\r\nAlso disabled the emoji menu from the ScriptEditor's GotoLinePopup LineEdit (it's for numbers and `:` only).\r\n\r\nTested by making 5000 Spinboxes (in a debug build):\r\n```gdscript\r\nfunc _test():\r\n\tprint(\"starting test...\")\r\n\tvar startms := Time.get_ticks_msec()\r\n\tfor i in 5000:\r\n\t\tvar sb := SpinBox.new()\r\n\t\tadd_child(sb)\r\n\tvar endms := Time.get_ticks_msec()\r\n\tprint(\"finished in %sms\" % (endms - startms))\r\n```\r\n\r\nbefore - finished in 32787ms / 29885ms / 29500ms\r\nafter - finished in 3962ms / 4035ms / 4085ms\r\nWhich is ~7.6x faster.","closed_by":{"login":"Repiteo","id":17489292,"node_id":"MDQ6VXNlcjE3NDg5Mjky","avatar_url":"https://avatars.githubusercontent.com/u/17489292?v=4","gravatar_id":"","url":"https://api.github.com/users/Repiteo","html_url":"https://github.com/Repiteo","followers_url":"https://api.github.com/users/Repiteo/followers","following_url":"https://api.github.com/users/Repiteo/following{/other_user}","gists_url":"https://api.github.com/users/Repiteo/gists{/gist_id}","starred_url":"https://api.github.com/users/Repiteo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Repiteo/subscriptions","organizations_url":"https://api.github.com/users/Repiteo/orgs","repos_url":"https://api.github.com/users/Repiteo/repos","events_url":"https://api.github.com/users/Repiteo/events{/privacy}","received_events_url":"https://api.github.com/users/Repiteo/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/111766/reactions","total_count":14,"+1":3,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":11,"eyes":0},"timeline_url":"https://api.github.com/repos/godotengine/godot/issues/111766/timeline","performed_via_github_app":null,"state_reason":null}