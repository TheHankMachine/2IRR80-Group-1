e_id":"MDU6TGFiZWwyNzkwOTgyMTk=","url":"https://api.github.com/repos/godotengine/godot/labels/topic:editor","name":"topic:editor","color":"ffee88","default":false,"description":"","archived_at":null,"archived_by":null},{"id":370471795,"node_id":"MDU6TGFiZWwzNzA0NzE3OTU=","url":"https://api.github.com/repos/godotengine/godot/labels/topic:thirdparty","name":"topic:thirdparty","color":"ffee88","default":false,"description":"","archived_at":null,"archived_by":null},{"id":1327318271,"node_id":"MDU6TGFiZWwxMzI3MzE4Mjcx","url":"https://api.github.com/repos/godotengine/godot/labels/crash","name":"crash","color":"885544","default":false,"description":"","archived_at":null,"archived_by":null}],"state":"closed","locked":false,"assignees":[],"milestone":{"url":"https://api.github.com/repos/godotengine/godot/milestones/25","html_url":"https://github.com/godotengine/godot/milestone/25","labels_url":"https://api.github.com/repos/godotengine/godot/milestones/25/labels","id":15520464,"node_id":"MI_kwDOAO6SJc4A7NLQ","number":25,"title":"4.8","description":"","creator":{"login":"Repiteo","id":17489292,"node_id":"MDQ6VXNlcjE3NDg5Mjky","avatar_url":"https://avatars.githubusercontent.com/u/17489292?v=4","gravatar_id":"","url":"https://api.github.com/users/Repiteo","html_url":"https://github.com/Repiteo","followers_url":"https://api.github.com/users/Repiteo/followers","following_url":"https://api.github.com/users/Repiteo/following{/other_user}","gists_url":"https://api.github.com/users/Repiteo/gists{/gist_id}","starred_url":"https://api.github.com/users/Repiteo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Repiteo/subscriptions","organizations_url":"https://api.github.com/users/Repiteo/orgs","repos_url":"https://api.github.com/users/Repiteo/repos","events_url":"https://api.github.com/users/Repiteo/events{/privacy}","received_events_url":"https://api.github.com/users/Repiteo/received_events","type":"User","user_view_type":"public","site_admin":false},"open_issues":343,"closed_issues":2335,"state":"open","created_at":"2026-04-13T15:59:35Z","updated_at":"2026-10-22T06:28:22Z","due_on":null,"closed_at":null},"comments":2,"created_at":"2026-07-29T17:52:17Z","updated_at":"2026-08-18T15:11:57Z","closed_at":"2026-08-18T15:11:57Z","assignee":null,"author_association":"CONTRIBUTOR","issue_field_values":[],"type":null,"active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"### Tested versions\n\n- Reproducible in: 4.7.1.stable\n\n### System information\n\nGodot v4.7.1.stable - Web - Single-window, 1 monitor - OpenGL ES 3 (Compatibility) - Radeon R9 200 Series, or similar -  (2 threads) - AudioWorklet (96000 Hz, Stereo/mono)\n\n### Issue description\n\nThe web editor that's served on https://editor.godotengine.org/releases/4.7.1.stable/ is suffering from what seems to be an Emscripten bug, due to being compiled against an older version of Emscripten (4.0.20): emscripten-core/emscripten#20920\n\nMore specifically, whenever you run a game in the web editor, and then close it, you'll end up leaking a sizeable amount of memory (100+ MB) for even the most trivial project. If you do this repeatedly you'll eventually end up running out of memory, typically in the form of the browser cutting you off and killing the tab.\n\nThis is not reproducible if you compile against Emscripten 6.0.0. However, if you \"revert\" the fix for the above mentioned bug, by manually replacing the newly added `PThread.terminateRuntime()` with `PThread.terminateAllThreads()` in a compiled `godot.editor.js`, you'll find that the issue is reproducible again, which would seem to confirm that specific issue to be the culprit.\n\nHere's a comparison between two heap snapshots in Chrome's devtools, after running 5 game sessions, pointing towards some kind of WebAssembly memory leakage:\n\n<img width=\"1010\" height=\"716\" alt=\"Image\" src=\"https://github.com/user-attachments/assets/ab00b9aa-b99d-4b68-b428-d32af01e1749\" />\n\n### Steps to reproduce\n\n1. Open https://editor.godotengine.org/releases/4.7.1.stable/\n2. Preload the MRP project\n3. Open the browser devtools and take a heap snapshot\n4. Launch and close the game a few times\n5. Take another heap snapshot\n6. Note the leaks\n\n### Minimal reproduction project (MRP)\n\n[mrp-web-leak.zip](https://github.com/user-attachments/files/30515463/mrp-web-leak.zip)","closed_by":{"login":"Repiteo","id":17489292,"node_id":"MDQ6VXNlcjE3NDg5Mjky","avatar_url":"https://avatars.githubusercontent.com/u/17489292?v=4","gravatar_id":"","url":"https://api.github.com/users/Repiteo","html_url":"https://github.com/Repiteo","followers_url":"https://api.github.com/users/Repiteo/followers","following_url":"https://api.github.com/users/Repiteo/following{/other_user}","gists_url":"https://api.github.com/users/Repiteo/gists{/gist_id}","starred_url":"https://api.github.com/users/Repiteo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Repiteo/subscriptions","organizations_url":"https://api.github.com/users/Repiteo/orgs","repos_url":"https://api.github.com/users/Repiteo/repos","events_url":"https://api.github.com/users/Repiteo/events{/privacy}","received_events_url":"https://api.github.com/users/Repiteo/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/121902/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/godotengine/godot/issues/121902/timeline","performed_via_github_app":null,"state_reason":"completed","pinned_comment":null}