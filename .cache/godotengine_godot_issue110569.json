wOTgwMDk=","url":"https://api.github.com/repos/godotengine/godot/labels/topic:buildsystem","name":"topic:buildsystem","color":"ffee88","default":false,"description":"","archived_at":null,"archived_by":null}],"state":"closed","locked":false,"assignees":[],"milestone":{"url":"https://api.github.com/repos/godotengine/godot/milestones/23","html_url":"https://github.com/godotengine/godot/milestone/23","labels_url":"https://api.github.com/repos/godotengine/godot/milestones/23/labels","id":12939969,"node_id":"MI_kwDOAO6SJc4AxXLB","number":23,"title":"4.6","description":"","creator":{"login":"Repiteo","id":17489292,"node_id":"MDQ6VXNlcjE3NDg5Mjky","avatar_url":"https://avatars.githubusercontent.com/u/17489292?v=4","gravatar_id":"","url":"https://api.github.com/users/Repiteo","html_url":"https://github.com/Repiteo","followers_url":"https://api.github.com/users/Repiteo/followers","following_url":"https://api.github.com/users/Repiteo/following{/other_user}","gists_url":"https://api.github.com/users/Repiteo/gists{/gist_id}","starred_url":"https://api.github.com/users/Repiteo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Repiteo/subscriptions","organizations_url":"https://api.github.com/users/Repiteo/orgs","repos_url":"https://api.github.com/users/Repiteo/repos","events_url":"https://api.github.com/users/Repiteo/events{/privacy}","received_events_url":"https://api.github.com/users/Repiteo/received_events","type":"User","user_view_type":"public","site_admin":false},"open_issues":3,"closed_issues":2978,"state":"closed","created_at":"2025-05-22T16:25:52Z","updated_at":"2026-10-04T16:23:23Z","due_on":null,"closed_at":"2026-01-26T18:09:14Z"},"comments":2,"created_at":"2025-09-16T12:48:24Z","updated_at":"2025-09-19T02:07:43Z","closed_at":"2025-09-19T02:07:43Z","assignee":null,"author_association":"NONE","issue_field_values":[],"type":null,"active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"### Tested versions\n\nGodot Engine v4.5.stable.exherbo.876b29033\n\n### System information\n\n`Godot v4.5.stable (876b29033) - Exherbo #1 SMP PREEMPT_DYNAMIC Mon Sep 15 14:43:55 CEST 2025 on X11 - X11 display driver, Multi-window, 2 monitors - Vulkan (Forward+) - integrated Intel(R) UHD Graphics 770 (ADL-S GT1) - 12th Gen Intel(R) Core(TM) i5-12500 (12 threads) - 15.27 GiB memory`\n\n### Issue description\n\n`builtin_libjpeg_turbo=False` produces a binary not linked against system libjpeg-turbo:\n\n`ldd /usr/x86_64-pc-linux-gnu/bin/godot | grep jpeg` returns nothing, while it works for other libraries like e.g. libpng:\n\n```\nldd /usr/x86_64-pc-linux-gnu/bin/godot | grep png\n        libpng16.so.16 => /usr/x86_64-pc-linux-gnu/lib/libpng16.so.16 (0x00007fbfc31aa000)\n```\nTo be sure the bundled libraries are not used during build we also remove them, e.g. for libpng:\n\n`rm -rf thirdparty/libpng`\n\nSo when adding libjpeg-turbo to that list `rm -rf thirdparty/libjpeg-turbo` the build fails with:\n\n```\n[...]\nscons: *** [bin/obj/thirdparty/libjpeg-turbo/src/jcapistd_8.linuxbsd.editor.x86_64.o] Source `thirdparty/libjpeg-turbo/src/jcapistd.c' not found, needed by target `bin/obj/thirdparty/libjpeg-turbo/src/jcapistd_8.linuxbsd.editor.x86_64.o'.\n```\nalso indicating that the bundled copy is still used.\n\nComplete build log: [godot-4.5_build.log](https://github.com/user-attachments/files/22362844/godot-4.5_build.log)\n\n### Steps to reproduce\n\n1. have libjpeg-turbo installed system-wide\n2. remove from godot 4.5 sources `rm -rf thirdparty/libjpeg-turbo`\n3. try to build with `builtin_libjpeg_turbo=False`\n\n### Minimal reproduction project (MRP)\n\n-","closed_by":{"login":"Repiteo","id":17489292,"node_id":"MDQ6VXNlcjE3NDg5Mjky","avatar_url":"https://avatars.githubusercontent.com/u/17489292?v=4","gravatar_id":"","url":"https://api.github.com/users/Repiteo","html_url":"https://github.com/Repiteo","followers_url":"https://api.github.com/users/Repiteo/followers","following_url":"https://api.github.com/users/Repiteo/following{/other_user}","gists_url":"https://api.github.com/users/Repiteo/gists{/gist_id}","starred_url":"https://api.github.com/users/Repiteo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Repiteo/subscriptions","organizations_url":"https://api.github.com/users/Repiteo/orgs","repos_url":"https://api.github.com/users/Repiteo/repos","events_url":"https://api.github.com/users/Repiteo/events{/privacy}","received_events_url":"https://api.github.com/users/Repiteo/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/110569/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/godotengine/godot/issues/110569/timeline","performed_via_github_app":null,"state_reason":"completed","pinned_comment":null}