s://api.github.com/users/Sauermann/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-04-02T07:39:58Z","updated_at":"2025-04-02T07:39:58Z","body":"I don't think, that https://github.com/godotengine/godot-proposals/issues/6221 will help with this issue.","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2771604330/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2772218746","html_url":"https://github.com/godotengine/godot/issues/104601#issuecomment-2772218746","issue_url":"https://api.github.com/repos/godotengine/godot/issues/104601","id":2772218746,"node_id":"IC_kwDOAO6SJc6lPLN6","user":{"login":"timoschwarzer","id":8849554,"node_id":"MDQ6VXNlcjg4NDk1NTQ=","avatar_url":"https://avatars.githubusercontent.com/u/8849554?v=4","gravatar_id":"","url":"https://api.github.com/users/timoschwarzer","html_url":"https://github.com/timoschwarzer","followers_url":"https://api.github.com/users/timoschwarzer/followers","following_url":"https://api.github.com/users/timoschwarzer/following{/other_user}","gists_url":"https://api.github.com/users/timoschwarzer/gists{/gist_id}","starred_url":"https://api.github.com/users/timoschwarzer/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/timoschwarzer/subscriptions","organizations_url":"https://api.github.com/users/timoschwarzer/orgs","repos_url":"https://api.github.com/users/timoschwarzer/repos","events_url":"https://api.github.com/users/timoschwarzer/events{/privacy}","received_events_url":"https://api.github.com/users/timoschwarzer/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-04-02T11:07:35Z","updated_at":"2025-04-02T11:07:54Z","body":"I don't think it'll help here. It even seems like it \"removes\" some functionality that is currently present.\n\nTo sum up, what we are trying to do is to make a SubViewport render an arbitrarily sized (Vector2) portion of the world into an arbitratily integer sized (Vector2i) texture.\n\nWith https://github.com/godotengine/godot-proposals/issues/6221, that does not seem to be possible anymore without violating the usage terms of the new property `size_of_display_area`.\nIn our case for rendering high-resolution UI over a low-resolution game, the UI viewport would have a `size_of_texture` of e.g. 2560x1080 and a `size_of_display_area` of `426.6666x180.0`. According to the proposal, it should be the \"size of the area, that the viewport texture is displayed in\", which would be 2560x1080 because I display the texture full screen (?), so there's still a lot of ambiguity.","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2772218746/reactions","total_count":1,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":1,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2772259768","html_url":"https://github.com/godotengine/godot/issues/104601#issuecomment-2772259768","issue_url":"https://api.github.com/repos/godotengine/godot/issues/104601","id":2772259768,"node_id":"IC_kwDOAO6SJc6lPVO4","user":{"login":"Sauermann","id":6299227,"node_id":"MDQ6VXNlcjYyOTkyMjc=","avatar_url":"https://avatars.githubusercontent.com/u/6299227?v=4","gravatar_id":"","url":"https://api.github.com/users/Sauermann","html_url":"https://github.com/Sauermann","followers_url":"https://api.github.com/users/Sauermann/followers","following_url":"https://api.github.com/users/Sauermann/following{/other_user}","gists_url":"https://api.github.com/users/Sauermann/gists{/gist_id}","starred_url":"https://api.github.com/users/Sauermann/starred{/owner}{/repo}","subscriptions_ur