de_id":"MDU6TGFiZWwyNjY2NzA1NjQ4","url":"https://api.github.com/repos/godotengine/godot/labels/topic:animation","name":"topic:animation","color":"ffee88","default":false,"description":"","archived_at":null,"archived_by":null},{"id":3240950060,"node_id":"MDU6TGFiZWwzMjQwOTUwMDYw","url":"https://api.github.com/repos/godotengine/godot/labels/performance","name":"performance","color":"447777","default":false,"description":"","archived_at":null,"archived_by":null}],"state":"closed","locked":false,"assignees":[],"milestone":null,"comments":7,"created_at":"2025-09-12T23:10:32Z","updated_at":"2026-02-07T12:37:42Z","closed_at":"2025-11-01T21:16:02Z","assignee":null,"author_association":"CONTRIBUTOR","issue_field_values":[],"type":null,"active_lock_reason":null,"draft":false,"pull_request":{"url":"https://api.github.com/repos/godotengine/godot/pulls/110474","html_url":"https://github.com/godotengine/godot/pull/110474","diff_url":"https://github.com/godotengine/godot/pull/110474.diff","patch_url":"https://github.com/godotengine/godot/pull/110474.patch","merged_at":null},"body":"<!--\r\nPlease target the `master` branch in priority.\r\n\r\nRelevant fixes are cherry-picked for stable branches as needed by maintainers.\r\n\r\nTo speed up the contribution process and avoid CI errors, please set up pre-commit hooks locally:\r\nhttps://contributing.godotengine.org/en/latest/engine/guidelines/code_style.html\r\n-->\r\n\r\n---\r\nBefore this patch (2dd26a027a99633231184616d4dd287bbdd1c0a3).\r\n\r\nFPS: high 192, low 185, median 188.5\r\nMSPF: high 5.40, low 5.20, median 5.30\r\n\r\n~After this patch.~ (Benchmarks no longer accurate)\r\n\r\n~FPS: high 234, low 229, median 231~\r\n~MSPF:  high 4.36, low 4.27, median 4.32~\r\n\r\n---\r\nHere is the test project I used, I ran it from the command line with `--headless --print-fps`, and the engine was compiled with `scons compiledb=yes debug_symbols=yes production=yes`\r\n[Mrp.zip](https://github.com/user-attachments/files/22307048/Mrp.zip)\r\n\r\n\r\nChanges:\r\n- Replaced `List<>` usages with `LocalVector<>`.\r\n- Updated many variables to use `&`, to avoid copies.\r\n- Changed many function parameters/returns from by-value to `const &` (to avoid copies and ref counting overhead)\r\n- Use single-lookup (e.g. `has_node()+get_node()` changed to  `get_node_or_null()`), same for HashMaps.\r\n- Added `SNAME` when needed.\r\n- `AnimationNodeBlendTreeEditor` now queues (and merges) `update_graph` calls at the end of the frame.\r\n- Large structs like `AnimationMixer::PlaybackInfo` are now passed by `const &` instead of copied.\r\n- `AnimationNode::_blend_node` now uses preallocated `StringName`s.\r\n- `AnimationTree` is now safe to use with `Node::process_thread_group` \r\n- Misc optimizations and improvements\r\n","closed_by":{"login":"Ryan-000","id":73148864,"node_id":"MDQ6VXNlcjczMTQ4ODY0","avatar_url":"https://avatars.githubusercontent.com/u/73148864?v=4","gravatar_id":"","url":"https://api.github.com/users/Ryan-000","html_url":"https://github.com/Ryan-000","followers_url":"https://api.github.com/users/Ryan-000/followers","following_url":"https://api.github.com/users/Ryan-000/following{/other_user}","gists_url":"https://api.github.com/users/Ryan-000/gists{/gist_id}","starred_url":"https://api.github.com/users/Ryan-000/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Ryan-000/subscriptions","organizations_url":"https://api.github.com/users/Ryan-000/orgs","repos_url":"https://api.github.com/users/Ryan-000/repos","events_url":"https://api.github.com/users/Ryan-000/events{/privacy}","received_events_url":"https://api.github.com/users/Ryan-000/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/110474/reactions","total_count":34,"+1":9,"-1":0,"laugh":0,"hooray":2,"confused":0,"heart":3,"rocket":17,"eyes":3},"timeline_url":"https://api.github.com/repos/godotengine/godot/issues/110474/ti