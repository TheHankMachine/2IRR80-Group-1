null}],"state":"closed","locked":false,"assignees":[],"milestone":{"url":"https://api.github.com/repos/godotengine/godot/milestones/22","html_url":"https://github.com/godotengine/godot/milestone/22","labels_url":"https://api.github.com/repos/godotengine/godot/milestones/22/labels","id":12070367,"node_id":"MI_kwDOAO6SJc4AuC3f","number":22,"title":"4.5","description":"","creator":{"login":"Sauermann","id":6299227,"node_id":"MDQ6VXNlcjYyOTkyMjc=","avatar_url":"https://avatars.githubusercontent.com/u/6299227?v=4","gravatar_id":"","url":"https://api.github.com/users/Sauermann","html_url":"https://github.com/Sauermann","followers_url":"https://api.github.com/users/Sauermann/followers","following_url":"https://api.github.com/users/Sauermann/following{/other_user}","gists_url":"https://api.github.com/users/Sauermann/gists{/gist_id}","starred_url":"https://api.github.com/users/Sauermann/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Sauermann/subscriptions","organizations_url":"https://api.github.com/users/Sauermann/orgs","repos_url":"https://api.github.com/users/Sauermann/repos","events_url":"https://api.github.com/users/Sauermann/events{/privacy}","received_events_url":"https://api.github.com/users/Sauermann/received_events","type":"User","user_view_type":"public","site_admin":false},"open_issues":3,"closed_issues":3687,"state":"closed","created_at":"2024-12-19T08:51:28Z","updated_at":"2026-09-04T21:48:38Z","due_on":"2025-09-15T00:00:00Z","closed_at":"2025-09-18T17:13:14Z"},"comments":10,"created_at":"2025-01-11T18:48:11Z","updated_at":"2025-04-15T18:42:13Z","closed_at":"2025-03-11T22:02:48Z","assignee":null,"author_association":"CONTRIBUTOR","issue_field_values":[],"type":null,"active_lock_reason":null,"draft":false,"pull_request":{"url":"https://api.github.com/repos/godotengine/godot/pulls/101439","html_url":"https://github.com/godotengine/godot/pull/101439","diff_url":"https://github.com/godotengine/godot/pull/101439.diff","patch_url":"https://github.com/godotengine/godot/pull/101439.patch","merged_at":"2025-03-11T22:02:48Z"},"body":"Replaces [Add `get_connection_list_from_port` function to `GraphEdit`](https://github.com/godotengine/godot/pull/100048).\r\n\r\nAdds a way to get all connections for a specific node (Analogous to `connection_map`) as recommended by @Geometror https://github.com/godotengine/godot/pull/100048#issuecomment-2545061960\r\n\r\nThis should speed up the process of finding the right connections among `GraphEdit` nodes .\r\n\r\nExample function to get all connections on a specific port using the new function:\r\n```\r\nfunc get_connection_list_from_port(node: StringName, port: int)->Array:\r\n\tvar connection: Array = get_connection_list_from_node(node)\r\n\tvar arr: Array\r\n\tfor conn in connection:\r\n\t\tif conn[\"from_node\"] == node and conn[\"from_port\"] == port:\r\n\t\t\tvar dict: Dictionary\r\n\t\t\tdict[\"node\"] = conn[\"to_node\"]\r\n\t\t\tdict[\"port\"] = conn[\"to_port\"]\r\n\t\t\tdict[\"type\"] = \"left\"\r\n\t\t\tarr.push_back(dict)\r\n\t\telif conn[\"to_node\"] == node and conn[\"to_port\"] == port:\r\n\t\t\tvar dict: Dictionary\r\n\t\t\tdict[\"node\"] = conn[\"from_node\"]\r\n\t\t\tdict[\"port\"] = conn[\"from_port\"]\r\n\t\t\tdict[\"type\"] = \"right\"\r\n\t\t\tarr.push_back(dict)\r\n\treturn arr\r\n```\r\n\r\n* *Bugsquad edit, closes: https://github.com/godotengine/godot-proposals/issues/11287*","closed_by":{"login":"Repiteo","id":17489292,"node_id":"MDQ6VXNlcjE3NDg5Mjky","avatar_url":"https://avatars.githubusercontent.com/u/17489292?v=4","gravatar_id":"","url":"https://api.github.com/users/Repiteo","html_url":"https://github.com/Repiteo","followers_url":"https://api.github.com/users/Repiteo/followers","following_url":"https://api.github.com/users/Repiteo/following{/other_user}","gists_url":"https://api.github.com/users/Repiteo/gists{/gist_id}","starred_url":"https://api.github.com/users/Repiteo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Repiteo/subscriptions","organizations_url":"https://api.github.com/users/Repiteo/orgs","repos_url":"https://api.github.com/users/Repiteo/repos","events_url":"https://api.github.com/users/Repiteo/events{/privacy}","received_events_url":"https://api.github.com/users/Repiteo/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/101439/reactions","total_count":1,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":1,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/godotengine/godot/issues/101439/timeline","performed_via_github_app":null,"state_reason":null}