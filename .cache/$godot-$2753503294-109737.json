s":0,"total_private_repos":0,"url":"https://api.github.com/users/clayjohn"},"body":"Looks great! The final step before merging is to squash all the commits together so that the whole PR only contains 1 big commit with all your changes. We like to merge one commit at a time to keep the git history clean and navigable. \n\nIf you don't know how to do that, we have a helpful tutorial in the official documentation https://docs.godotengine.org/en/latest/community/contributing/pr_workflow.html#the-interactive-rebase\n\nAs a follow up I have asked Skyth to compress the lightmap data struct after we merge this","html_url":"https://github.com/godotengine/godot/pull/109737#pullrequestreview-4975071445","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/109737","author_association":"MEMBER","submitted_at":"2026-08-19T17:42:21Z"},{"id":4984672593,"node_id":"PRR_kwDOAO6SJc8AAAABKRwRUQ","state":"APPROVED","commit_id":"77b89bf08b73ad5b4a17e5268d4565a39bb205ac","user":{"site_admin":false,"suspended":false,"updated_at":"0001-01-01T00:00:00Z","avatar_url":"https://avatars.githubusercontent.com/u/17489292?u=34072b401722100a7c0c0d61e37b376cf22b4545&v=4","created_at":"0001-01-01T00:00:00Z","followers":0,"following":0,"html_url":"https://github.com/Repiteo","id":17489292,"node_id":"MDQ6VXNlcjE3NDg5Mjky","login":"Repiteo","type":"User","owned_private_repos":0,"public_gists":0,"public_repos":0,"total_private_repos":0,"url":"https://api.github.com/users/Repiteo"},"body":"Despite being a fraction of this PR: approving the buildsystem/tests sections for good measure","html_url":"https://github.com/godotengine/godot/pull/109737#pullrequestreview-4984672593","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/109737","author_association":"CONTRIBUTOR","submitted_at":"2026-08-20T15:43:26Z"}]