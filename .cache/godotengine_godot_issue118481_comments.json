com/YeldhamDev","followers_url":"https://api.github.com/users/YeldhamDev/followers","following_url":"https://api.github.com/users/YeldhamDev/following{/other_user}","gists_url":"https://api.github.com/users/YeldhamDev/gists{/gist_id}","starred_url":"https://api.github.com/users/YeldhamDev/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/YeldhamDev/subscriptions","organizations_url":"https://api.github.com/users/YeldhamDev/orgs","repos_url":"https://api.github.com/users/YeldhamDev/repos","events_url":"https://api.github.com/users/YeldhamDev/events{/privacy}","received_events_url":"https://api.github.com/users/YeldhamDev/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-04-22T21:54:06Z","updated_at":"2026-05-08T23:54:00Z","body":"So after digging into this further, the reason why it shows it like that it's because the project theme follows its own scale (the one from `gui/theme/default_theme_scale`), not the editor one. Technically, the preview is more accurate due to this.\n\nI think the only way to _fix_ this is for the theme editor to generate its own version of the default theme, but using the editor scale. But I'm not quite sure if this is desirable, and the process which that theme is created will need to change a bit.\n\nBy the way, the current behavior is also how it work in 4.5:\n\n<img width=\"1059\" height=\"530\" alt=\"Image\" src=\"https://github.com/user-attachments/assets/4df0fbc6-9412-4ed0-bc6e-c4225ebddcb3\" />","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4300202598/reactions","total_count":2,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":1},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4479082090","html_url":"https://github.com/godotengine/godot/issues/118481#issuecomment-4479082090","issue_url":"https://api.github.com/repos/godotengine/godot/issues/118481","id":4479082090,"node_id":"IC_kwDOAO6SJc8AAAABCvleag","user":{"login":"KoBeWi","id":2223172,"node_id":"MDQ6VXNlcjIyMjMxNzI=","avatar_url":"https://avatars.githubusercontent.com/u/2223172?v=4","gravatar_id":"","url":"https://api.github.com/users/KoBeWi","html_url":"https://github.com/KoBeWi","followers_url":"https://api.github.com/users/KoBeWi/followers","following_url":"https://api.github.com/users/KoBeWi/following{/other_user}","gists_url":"https://api.github.com/users/KoBeWi/gists{/gist_id}","starred_url":"https://api.github.com/users/KoBeWi/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/KoBeWi/subscriptions","organizations_url":"https://api.github.com/users/KoBeWi/orgs","repos_url":"https://api.github.com/users/KoBeWi/repos","events_url":"https://api.github.com/users/KoBeWi/events{/privacy}","received_events_url":"https://api.github.com/users/KoBeWi/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-05-18T15:17:52Z","updated_at":"2026-05-18T15:17:52Z","body":"> I think the only way to fix this is for the theme editor to generate its own version of the default theme, but using the editor scale. But I'm not quite sure if this is desirable, and the process which that theme is created will need to change a bit.\n\nHow much changes does it involve? Can it be optional (with an editor setting)?","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4479082090/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4481080234","html_url":"https://github.com/godotengine/godot/issues/118481#issuecomment-4481080234","issue_url":"https://api.github.com/repos/godotengine/godot/issues/118481","id":4481080234,"node_id":"IC_kwDOAO6SJc8AAAABCxfbqg","user":{"login":"YeldhamDev","id":30739239,"node_id":"MDQ6VXNlcjMwNzM5MjM5","avatar_url":"https://avatars.githubusercontent.com/u/30739239?v=4","gravatar_id":"","url":"https://api.github.com/users/YeldhamDev","html_url":"https://github.com/YeldhamDev","followers_url":"https://api.github.com/users/YeldhamDev/followers","following_url":"https://api.github.com/users/YeldhamDev/following{/other_user}","gists_url":"https://api.github.com/users/YeldhamDev/gists{/gist_id}","starred_url":"https://api.github.com/users/YeldhamDev/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/YeldhamDev/subscriptions","organizations_url":"https://api.github.com/users/YeldhamDev/orgs","repos_url":"https://api.github.com/users/YeldhamDev/repos","events_url":"https://api.github.com/users/YeldhamDev/events{/privacy}","received_events_url":"https://api.github.com/users/YeldhamDev/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-05-18T19:13:37Z","updated_at":"2026-05-18T19:13:37Z","body":"Not sure, but another problem is that this would make the theme size inaccurate again, since when the default theme is created, the scaling is done by manually increasing margins. Which means that, for example: a margin for a certain style may look smaller than it actually is, since the margin sizes of the other elements have been increased by the scale.\n\nAnother solution would be scaling the `Control` container which the theme resides. I already thought a way to do that in my mind, but it's a bit hacky.","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4481080234/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4481858074","html_url":"https://github.com/godotengine/godot/issues/118481#issuecomment-4481858074","issue_url":"https://api.github.com/repos/godotengine/godot/issues/118481","id":4481858074,"node_id":"IC_kwDOAO6SJc8AAAABCyO6Gg","user":{"login":"KoBeWi","id":2223172,"node_id":"MDQ6VXNlcjIyMjMxNzI=","avatar_url":"https://avatars.githubusercontent.com/u/2223172?v=4","gravatar_id":"","url":"https://api.github.com/users/KoBeWi","html_url":"https://github.com/KoBeWi","followers_url":"https://api.github.com/users/KoBeWi/followers","following_url":"https://api.github.com/users/KoBeWi/following{/other_user}","gists_url":"https://api.github.com/users/KoBeWi/gists{/gist_id}","starred_url":"https://api.github.com/users/KoBeWi/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/KoBeWi/subscriptions","organizations_url":"https://api.github.com/users/KoBeWi/orgs","repos_url":"https://api.github.com/users/KoBeWi/repos","events_url":"https://api.github.com/users/KoBeWi/events{/privacy}","received_events_url":"https://api.github.com/users/KoBeWi/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-05-18T20:31:20Z","updated_at":"2026-05-18T20:31:20Z","body":"> Another solution would be scaling the Control container which the theme resides. I already thought a way to do that in my mind, but it's a bit hacky.\n\nWell, you could make some ScaledContainer internal class that ensures correct scale, if it's possible to solve it this way.","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4481858074/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null}]