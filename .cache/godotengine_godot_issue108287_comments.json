://api.github.com/users/Alex2782/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Alex2782/subscriptions","organizations_url":"https://api.github.com/users/Alex2782/orgs","repos_url":"https://api.github.com/users/Alex2782/repos","events_url":"https://api.github.com/users/Alex2782/events{/privacy}","received_events_url":"https://api.github.com/users/Alex2782/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-07-09T21:32:50Z","updated_at":"2025-07-09T21:47:02Z","body":"Test project: [NavigationBarProblem.zip](https://github.com/user-attachments/files/21105933/NavigationBarProblem.zip)\r\n\r\n\r\n`DisplayServer.virtual_keyboard_get_height()` \r\n\r\nNow the function returns 0 (Android 8) if `Immersive Mode` is disabled.\r\nOnly the first time the keyboard is displayed `height` = 0, the second time it works.\r\n\r\n![image](https://github.com/user-attachments/assets/bf5688d1-c18b-4198-9972-6f585a0f4328)\r\n","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3054127637/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3055792065","html_url":"https://github.com/godotengine/godot/pull/108287#issuecomment-3055792065","issue_url":"https://api.github.com/repos/godotengine/godot/issues/108287","id":3055792065,"node_id":"IC_kwDOAO6SJc62I6_B","user":{"login":"syntaxerror247","id":176927541,"node_id":"U_kgDOCouzNQ","avatar_url":"https://avatars.githubusercontent.com/u/176927541?v=4","gravatar_id":"","url":"https://api.github.com/users/syntaxerror247","html_url":"https://github.com/syntaxerror247","followers_url":"https://api.github.com/users/syntaxerror247/followers","following_url":"https://api.github.com/users/syntaxerror247/following{/other_user}","gists_url":"https://api.github.com/users/syntaxerror247/gists{/gist_id}","starred_url":"https://api.github.com/users/syntaxerror247/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/syntaxerror247/subscriptions","organizations_url":"https://api.github.com/users/syntaxerror247/orgs","repos_url":"https://api.github.com/users/syntaxerror247/repos","events_url":"https://api.github.com/users/syntaxerror247/events{/privacy}","received_events_url":"https://api.github.com/users/syntaxerror247/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-07-10T06:25:51Z","updated_at":"2025-07-10T06:55:09Z","body":"> However, if Immersive Mode is disabled and Edge to Edge is enabled, the input field behind the navigation bar disappears. Partially on the Samsung Tab S7, and completely on the Nexus 5X.\r\n\r\nThat's an exected behaviour. App shouldn't place any interactable node at bottom, if using edge-to-edge mode.","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3055792065/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3055831580","html_url":"https://github.com/godotengine/godot/pull/108287#issuecomment-3055831580","issue_url":"https://api.github.com/repos/godotengine/godot/issues/108287","id":3055831580,"node_id":"IC_kwDOAO6SJc62JEoc","user":{"login":"syntaxerror247","id":176927541,"node_id":"U_kgDOCouzNQ","avatar_url":"https://avatars.githubusercontent.com/u/176927541?v=4","gravatar_id":"","url":"https://api.github.com/users/syntaxerror247","html_url":"https://github.com/syntaxerror247","followers_url":"https://api.github.com/users/syntaxerror247/followers","following_url":"https://api.github.com/users/syntaxerror247/following{/other_user}","gists_url":"https://api.github.com/users/syntaxerror247/gists{/gist_id}","starred_url":"https://api.github.com/users/syntaxerror247/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/syntaxerror247/subscriptions","organizations_url":"https://api.github.com/users/syntaxerror247/orgs","repos_url":"https://api.github.com/users/syntaxerror247/repos","events_url":"https://api.github.com/users/syntaxerror247/events{/privacy}","received_events_url":"https://api.github.com/users/syntaxerror247/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-07-10T06:37:56Z","updated_at":"2025-07-10T06:37:56Z","body":"> DisplayServer.virtual_keyboard_get_height()\r\n>\r\n> Now the function returns 0 (Android 8) if Immersive Mode is disabled.\r\n> Only the first time the keyboard is displayed height = 0, the second time it works.\r\n\r\nYes, I can reproduce this on an Android 7 emulator (not reproducible on Android 9; I haven't tested on 8).\r\nThe `WindowInsetsAnimationCallback` doesn’t get triggered the first time the keyboard opens. I looked into it but couldn’t find anything. Initially, I suspected it might be an emulator bug, but since it can be reproduced on a physical device as well, it's likely a bug in the API itself.\r\n\r\nWe have two possible solutions:\r\n1. Revert to my previous approach using `OnGlobalLayoutListener` for Android 7 and 8.\r\n\r\n2. Document this behavior: the keyboard height is not returned the first time the keyboard opens for non-immersive mode on Android 7 and 8.\r\n\r\n","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3055831580/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3058950779","html_url":"https://github.com/godotengine/godot/pull/108287#issuecomment-3058950779","issue_url":"https://api.github.com/repos/godotengine/godot/issues/108287","id":3058950779,"node_id":"IC_kwDOAO6SJc62U-J7","user":{"login":"Alex2782","id":41921395,"node_id":"MDQ6VXNlcjQxOTIxMzk1","avatar_url":"https://avatars.githubusercontent.com/u/41921395?v=4","gravatar_id":"","url":"https://api.github.com/users/Alex2782","html_url":"https://github.com/Alex2782","followers_url":"https://api.github.com/users/Alex2782/followers","following_url":"https://api.github.com/users/Alex2782/following{/other_user}","gists_url":"https://api.github.com/users/Alex2782/gists{/gist_id}","starred_url":"https://api.github.com/users/Alex2782/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Alex2782/subscriptions","organizations_url":"https://api.github.com/users/Alex2782/orgs","repos_url":"https://api.github.com/users/Alex2782/repos","events_url":"https://api.github.com/users/Alex2782/events{/privacy}","received_events_url":"https://api.github.com/users/Alex2782/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-07-10T20:25:19Z","updated_at":"2025-07-10T20:25:19Z","body":"> We have two possible solutions:\r\n> \r\n> 1. Revert to my previous approach using `OnGlobalLayoutListener` for Android 7 and 8.\r\n> 2. Document this behavior: the keyboard height is not returned the first time the keyboard opens for non-immersive mode on Android 7 and 8.\r\n\r\n@m4gr3d What do you think? \r\n\r\n[previous approach](https://github.com/godotengine/godot/compare/63aacd5e1e1fe657b7602c51e272381c5e372881..80cce84f50d4ba0e6882649c4f5d9b3517b7231d) _( `OnGlobalLayoutListener` for Android 7 + 8)_\r\n\r\nOnly about **0.01%** of users _(PlayStore Stats for Godot Android Editor)_\r\nIn my opinion, this workaround code isn't worth it _(for non-immersive mode apps)._\r\n\r\n<img width=\"290\" height=\"144\" alt=\"image\" src=\"https://github.com/user-attachments/assets/2babc8ca-1362-424c-8f48-75b419270119\" />\r\n\r\n\r\n\r\n","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3058950779/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3073226124","html_url":"https://github.com/godotengine/godot/pull/108287#issuecomment-3073226124","issue_url":"https://api.github.com/repos/godotengine/godot/issues/108287","id":3073226124,"node_id":"IC_kwDOAO6SJc63LbWM","user":{"login":"Alex2782","id":41921395,"node_id":"MDQ6VXNlcjQxOTIxMzk1","avatar_url":"https://avatars.githubusercontent.com/u/41921395?v=4","gravatar_id":"","url":"https://api.github.com/users/Alex2782","html_url":"https://github.com/Alex2782","followers_url":"https://api.github.com/users/Alex2782/followers","following_url":"https://api.github.com/users/Alex2782/following{/other_user}","gists_url":"https://api.github.com/users/Alex2782/gists{/gist_id}","starred_url":"https://api.github.com/users/Alex2782/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Alex2782/subscriptions","organizations_url":"https://api.github.com/users/Alex2782/orgs","repos_url":"https://api.github.com/users/Alex2782/repos","events_url":"https://api.github.com/users/Alex2782/events{/privacy}","received_events_url":"https://api.github.com/users/Alex2782/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-07-15T11:23:36Z","updated_at":"2025-07-15T11:23:36Z","body":"> Document this behavior: the keyboard height is not returned the first time the keyboard opens for non-immersive mode on Android 7 and 8.\r\n\r\nShould we document this first? Then see how many people will request support for versions 7 and 8.\r\n","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3073226124/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3079439729","html_url":"https://github.com/godotengine/godot/pull/108287#issuecomment-3079439729","issue_url":"https://api.github.com/repos/godotengine/godot/issues/108287","id":3079439729,"node_id":"IC_kwDOAO6SJc63jIVx","user":{"login":"syntaxerror247","id":176927541,"node_id":"U_kgDOCouzNQ","avatar_url":"https://avatars.githubusercontent.com/u/176927541?v=4","gravatar_id":"","url":"https://api.github.com/users/syntaxerror247","html_url":"https://github.com/syntaxerror247","followers_url":"https://api.github.com/users/syntaxerror247/followers","following_url":"https://api.github.com/users/syntaxerror247/following{/other_user}","gists_url":"https://api.github.com/users/syntaxerror247/gists{/gist_id}","starred_url":"https://api.github.com/users/syntaxerror247/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/syntaxerror247/subscriptions","organizations_url":"https://api.github.com/users/syntaxerror247/orgs","repos_url":"https://api.github.com/users/syntaxerror247/repos","events_url":"https://api.github.com/users/syntaxerror247/events{/privacy}","received_events_url":"https://api.github.com/users/syntaxerror247/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-07-16T16:50:52Z","updated_at":"2025-07-17T15:03:22Z","body":"I tried a few more workarounds, but none of them worked. The only way to make it work the first time (on Android 7 and 8) is to briefly toggle immersive mode on and off.\r\nI’ve documented this behavior.\r\n\r\nEdit: Just to be clear, using `OnGlobalLayoutListener` works but I'm avoiding it as it causes mis-calculation in immersive mode and then we'd have to do workaround for that :)","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3079439729/reactions","total_count":1,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":1},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3083285951","html_url":"https://github.com/godotengine/godot/pull/108287#issuecomment-3083285951","issue_url":"https://api.github.com/repos/godotengine/godot/issues/108287","id":3083285951,"node_id":"IC_kwDOAO6SJc63xzW_","user":{"login":"syntaxerror247","id":176927541,"node_id":"U_kgDOCouzNQ","avatar_url":"https://avatars.githubusercontent.com/u/176927541?v=4","gravatar_id":"","url":"https://api.github.com/users/syntaxerror247","html_url":"https://github.com/syntaxerror247","followers_url":"https://api.github.com/users/syntaxerror247/followers","following_url":"https://api.github.com/users/syntaxerror247/following{/other_user}","gists_url":"https://api.github.com/users/syntaxerror247/gists{/gist_id}","starred_url":"https://api.github.com/users/syntaxerror247/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/syntaxerror247/subscriptions","organizations_url":"https://api.github.com/users/syntaxerror247/orgs","repos_url":"https://api.github.com/users/syntaxerror247/repos","events_url":"https://api.github.com/users/syntaxerror247/events{/privacy}","received_events_url":"https://api.github.com/users/syntaxerror247/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-07-17T09:13:24Z","updated_at":"2025-07-17T09:13:54Z","body":"> I think this hack wasn't necessary in the first version a week ago.\r\nBut we can get feedback first and see later if we can optimize it further.\r\nThe most important thing is that the input field is not hidden behind the navigation bar.\r\n\r\nThat's actually the expected behavior when using edge-to-edge (https://developer.android.com/design/ui/mobile/guides/layout-and-content/edge-to-edge). Interactive elements shouldn’t be placed at the very edge of the screen, as they can end up under system bars. There's nothing we can do about that, it’s just how it's designed to work. The correct approach is to use the safe area `DisplayServer.get_display_safe_area()`.","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3083285951/reactions","total_count":2,"+1":2,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3089966070","html_url":"https://github.com/godotengine/godot/pull/108287#issuecomment-3089966070","issue_url":"https://api.github.com/repos/godotengine/godot/issues/108287","id":3089966070,"node_id":"IC_kwDOAO6SJc64LSP2","user":{"login":"Repiteo","id":17489292,"node_id":"MDQ6VXNlcjE3NDg5Mjky","avatar_url":"https://avatars.githubusercontent.com/u/17489292?v=4","gravatar_id":"","url":"https://api.github.com/users/Repiteo","html_url":"https://github.com/Repiteo","followers_url":"https://api.github.com/users/Repiteo/followers","following_url":"https://api.github.com/users/Repiteo/following{/other_user}","gists_url":"https://api.github.com/users/Repiteo/gists{/gist_id}","starred_url":"https://api.github.com/users/Repiteo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Repiteo/subscriptions","organizations_url":"https://api.github.com/users/Repiteo/orgs","repos_url":"https://api.github.com/users/Repiteo/repos","events_url":"https://api.github.com/users/Repiteo/events{/privacy}","received_events_url":"https://api.github.com/users/Repiteo/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-07-18T16:09:57Z","updated_at":"2025-07-18T16:09:57Z","body":"Thanks!","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3089966070/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":