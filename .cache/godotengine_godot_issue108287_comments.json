thub.com/users/llama-nl/followers","following_url":"https://api.github.com/users/llama-nl/following{/other_user}","gists_url":"https://api.github.com/users/llama-nl/gists{/gist_id}","starred_url":"https://api.github.com/users/llama-nl/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/llama-nl/subscriptions","organizations_url":"https://api.github.com/users/llama-nl/orgs","repos_url":"https://api.github.com/users/llama-nl/repos","events_url":"https://api.github.com/users/llama-nl/events{/privacy}","received_events_url":"https://api.github.com/users/llama-nl/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-07-05T04:40:58Z","updated_at":"2025-07-05T04:41:23Z","body":"@syntaxerror247 ok, it works in protrait mode. I think it doesn't working in landscape mode? \r\n![Screenshot_20250705_103759](https://github.com/user-attachments/assets/9e3bce32-041a-4cfe-9366-ba467d40afd5)\r\n","author_association":"NONE","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3038019844/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3038169444","html_url":"https://github.com/godotengine/godot/pull/108287#issuecomment-3038169444","issue_url":"https://api.github.com/repos/godotengine/godot/issues/108287","id":3038169444,"node_id":"IC_kwDOAO6SJc61Fslk","user":{"login":"syntaxerror247","id":176927541,"node_id":"U_kgDOCouzNQ","avatar_url":"https://avatars.githubusercontent.com/u/176927541?v=4","gravatar_id":"","url":"https://api.github.com/users/syntaxerror247","html_url":"https://github.com/syntaxerror247","followers_url":"https://api.github.com/users/syntaxerror247/followers","following_url":"https://api.github.com/users/syntaxerror247/following{/other_user}","gists_url":"https://api.github.com/users/syntaxerror247/gists{/gist_id}","starred_url":"https://api.github.com/users/syntaxerror247/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/syntaxerror247/subscriptions","organizations_url":"https://api.github.com/users/syntaxerror247/orgs","repos_url":"https://api.github.com/users/syntaxerror247/repos","events_url":"https://api.github.com/users/syntaxerror247/events{/privacy}","received_events_url":"https://api.github.com/users/syntaxerror247/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-07-05T05:35:30Z","updated_at":"2025-07-05T05:35:30Z","body":"> @syntaxerror247 ok, it works in protrait mode. I think it doesn't working in landscape mode? ![Screenshot_20250705_103759](https://private-user-images.githubusercontent.com/94882246/462721727-9e3bce32-041a-4cfe-9366-ba467d40afd5.jpg?jwt=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..of2jopXlybLf2MqMO7eVWY6Lb-uMoz48xXoHOYXOz-k)\r\n\r\nThat's an issue with the MRP project. Stretch mode is set to `canvas_item`, which scales the viewport (as seen in landscape). But the keyboard height is not scaled, it's in physical pixels.\r\n\r\nTo fix this, either set stretch mode to `disabled`, or divide the keyboard height by the scale \r\n```\r\nsize.y = get_viewport_rect().size.y - (DisplayServer.virtual_keyboard_get_height() / get_viewport_transform().get_scale().y)\r\n```","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3038169444/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3038408727","html_url":"https://github.com/godotengine/godot/pull/108287#issuecomment-3038408727","issue_url":"https://api.github.com/repos/godotengine/godot/issues/108287","id":3038408727,"node_id":"IC_kwDOAO6SJc61GnAX","user":{"login":"kilojool","id":2656574,"node_id"