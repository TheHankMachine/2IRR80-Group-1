0), Z: (0.0, 0.0, -1.000025, -1.0), W: (0.0, 0.0, -0.100001, 0.0)]\nCompositor: [X: (0.733064, 0.0, 0.0, 0.0), Y: (0.0, -1.303225, 0.0, 0.0), Z: (0.0, 0.0, 0.000013, -1.0), W: (0.0, 0.0, 0.050001, 0.0)]\n```","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2884318569/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2884334126","html_url":"https://github.com/godotengine/godot/issues/106312#issuecomment-2884334126","issue_url":"https://api.github.com/repos/godotengine/godot/issues/106312","id":2884334126,"node_id":"IC_kwDOAO6SJc6r63Iu","user":{"login":"DevPoodle","id":102482062,"node_id":"U_kgDOBhvAjg","avatar_url":"https://avatars.githubusercontent.com/u/102482062?v=4","gravatar_id":"","url":"https://api.github.com/users/DevPoodle","html_url":"https://github.com/DevPoodle","followers_url":"https://api.github.com/users/DevPoodle/followers","following_url":"https://api.github.com/users/DevPoodle/following{/other_user}","gists_url":"https://api.github.com/users/DevPoodle/gists{/gist_id}","starred_url":"https://api.github.com/users/DevPoodle/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/DevPoodle/subscriptions","organizations_url":"https://api.github.com/users/DevPoodle/orgs","repos_url":"https://api.github.com/users/DevPoodle/repos","events_url":"https://api.github.com/users/DevPoodle/events{/privacy}","received_events_url":"https://api.github.com/users/DevPoodle/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-05-15T15:56:57Z","updated_at":"2025-05-15T15:56:57Z","body":"I also had that happen. I assume it's related to some other issue, rather than a problem with Projection itself.","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2884334126/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2884353527","html_url":"https://github.com/godotengine/godot/issues/106312#issuecomment-2884353527","issue_url":"https://api.github.com/repos/godotengine/godot/issues/106312","id":2884353527,"node_id":"IC_kwDOAO6SJc6r6733","user":{"login":"Calinou","id":180032,"node_id":"MDQ6VXNlcjE4MDAzMg==","avatar_url":"https://avatars.githubusercontent.com/u/180032?v=4","gravatar_id":"","url":"https://api.github.com/users/Calinou","html_url":"https://github.com/Calinou","followers_url":"https://api.github.com/users/Calinou/followers","following_url":"https://api.github.com/users/Calinou/following{/other_user}","gists_url":"https://api.github.com/users/Calinou/gists{/gist_id}","starred_url":"https://api.github.com/users/Calinou/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Calinou/subscriptions","organizations_url":"https://api.github.com/users/Calinou/orgs","repos_url":"https://api.github.com/users/Calinou/repos","events_url":"https://api.github.com/users/Calinou/events{/privacy}","received_events_url":"https://api.github.com/users/Calinou/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-05-15T16:04:00Z","updated_at":"2025-05-15T16:04:12Z","body":"> Using the above code as an example, their output are:\n\nThis may be related to [reverse Z](https://godotengine.org/article/introducing-reverse-z/), although I don't know for sure.","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2884353527/reactions","total_count":1,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":1,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2884359926","html_url":"https://github.com/godotengine/godot/issues/106312#issuecomment-2884359926","issue_url":"https://api.github.com/repos/godotengine/godot/issues/106312","id":2884359926,"node_id":"IC_kwDOAO6SJc6r69b2","user":{"login":"clayjohn","id":16521339,"node_id":"MDQ6VXNlcjE2NTIxMzM5","avatar_url":"https://avatars.githubusercontent.com/u/16521339?v=4","gravatar_id":"","url":"https://api.github.com/users/clayjohn","html_url":"https://github.com/clayjohn","followers_url":"https://api.github.com/users/clayjohn/followers","following_url":"https://api.github.com/users/clayjohn/following{/other_user}","gists_url":"https://api.github.com/users/clayjohn/gists{/gist_id}","starred_url":"https://api.github.com/users/clayjohn/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/clayjohn/subscriptions","organizations_url":"https://api.github.com/users/clayjohn/orgs","repos_url":"https://api.github.com/users/clayjohn/repos","events_url":"https://api.github.com/users/clayjohn/events{/privacy}","received_events_url":"https://api.github.com/users/clayjohn/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-05-15T16:06:18Z","updated_at":"2025-05-15T16:06:18Z","body":"> I had a similar question. The projection matrix from camera does not match the one in compositor. Is this expected behavior?\n\nYes it is expected, they are two different projections. That is why we expose [`get_cam_projection`](https://docs.godotengine.org/en/latest/classes/class_renderscenedata.html#class-renderscenedata-method-get-cam-projection) through the RenderSceneData object","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2884359926/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2884502394","html_url":"https://github.com/godotengine/godot/issues/106312#issuecomment-2884502394","issue_url":"https://api.github.com/repos/godotengine/godot/issues/106312","id":2884502394,"node_id":"IC_kwDOAO6SJc6r7gN6","user":{"login":"Flarkk","id":49606622,"node_id":"MDQ6VXNlcjQ5NjA2NjIy","avatar_url":"https://avatars.githubusercontent.com/u/49606622?v=4","gravatar_id":"","url":"https://api.github.com/users/Flarkk","html_url":"https://github.com/Flarkk","followers_url":"https://api.github.com/users/Flarkk/followers","following_url":"https://api.github.com/users/Flarkk/following{/other_user}","gists_url":"https://api.github.com/users/Flarkk/gists{/gist_id}","starred_url":"https://api.github.com/users/Flarkk/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Flarkk/subscriptions","organizations_url":"https://api.github.com/users/Flarkk/orgs","repos_url":"https://api.github.com/users/Flarkk/repos","events_url":"https://api.github.com/users/Flarkk/events{/privacy}","received_events_url":"https://api.github.com/users/Flarkk/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-05-15T17:01:42Z","updated_at":"2025-05-15T17:01:42Z","body":"> The projection matrix from camera does not match the one in compositor. Is this expected behavior?\n\nI think this explains the issue. In `render_callback()` the projection has `Projection::set_depth_correction()` applied when the renderer has reverse-z (Forward+ and Mobile, but not Compatibility) which likely messes up `get_z_far()` and such.\n\nI have to wrap my mind around it to figure out which from the current or the 4.4 behavior is the right one mathematically speaking.\n\nThis also questions whether `render_callback()` should expose a corrected matrix (which is different across renderers and might impede portability) or the original one.\n\n> It seems like between 4.4 and 4.5, [...] get_pixels_per_meter have changed\n\nI'm interested in understanding what usage you're making of this function. I couldn't find any consistency between its implementation and the documentation in 4.4, so when I rewrote it in #100209, I picked the most sensical way to me. But I might have taken a wrong way.","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2884502394/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2884518251","html_url":"https://github.com/godotengine/godot/issues/106312#issuecomment-2884518251","issue_url":"https://api.github.com/repos/godotengine/godot/issues/106312","id":2884518251,"node_id":"IC_kwDOAO6SJc6r7kFr","user":{"login":"clayjohn","id":16521339,"node_id":"MDQ6VXNlcjE2NTIxMzM5","avatar_url":"https://avatars.githubusercontent.com/u/16521339?v=4","gravatar_id":"","url":"https://api.github.com/users/clayjohn","html_url":"https://github.com/clayjohn","followers_url":"https://api.github.com/users/clayjohn/followers","following_url":"https://api.github.com/users/clayjohn/following{/other_user}","gists_url":"https://api.github.com/users/clayjohn/gists{/gist_id}","starred_url":"https://api.github.com/users/clayjohn/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/clayjohn/subscriptions","organizations_url":"https://api.github.com/users/clayjohn/orgs","repos_url":"https://api.github.com/users/clayjohn/repos","events_url":"https://api.github.com/users/clayjohn/events{/privacy}","received_events_url":"https://api.github.com/users/clayjohn/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-05-15T17:08:10Z","updated_at":"2025-05-15T17:08:10Z","body":"> This also questions whether render_callback() should expose a corrected matrix (which is different across renderers and might impede portability) or the original one.\n\n`render_callback()` needs to expose the corrected matrix so that users can match the rendered output in their custom shaders. For example, if they want to linearize the depth buffer, they need the projection matrix that was used to render the depth prepass, not the projection matrix exposed by the camera. \n\nIf users want the non-corrected projection, they need to grab the projection from the Camera. \n\nThat leaves us with a few things:\n1. The fact that [get_cam_projection](https://docs.godotengine.org/en/latest/classes/class_renderscenedata.html#class-renderscenedata-method-get-cam-projection) exposes a different projection from the Camera3D should be documented better.\n2. We need to figure out if the change to `get_z_far()` and `get_pixels_per_meter()` was correct or if it is a regression. ","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2884518251/reactions","total_count":2,"+1":2,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2884705361","html_url":"https://github.com/godotengine/godot/issues/106312#issuecomment-2884705361","issue_url":"https://api.github.com/repos/godotengine/godot/issues/106312","id":2884705361,"node_id":"IC_kwDOAO6SJc6r8RxR","user":{"login":"Flarkk","id":49606622,"node_id":"MDQ6VXNlcjQ5NjA2NjIy","avatar_url":"https://avatars.githubusercontent.com/u/49606622?v=4","gravatar_id":"","url":"https://api.github.com/users/Flarkk","html_url":"https://github.com/Flarkk","followers_url":"https://api.github.com/users/Flarkk/followers","following_url":"https://api.github.com/users/Flarkk/following{/other_user}","gists_url":"https://api.github.com/users/Flarkk/gists{/gist_id}","starred_url":"https://api.github.com/users/Flarkk/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Flarkk/subscriptions","organizations_url":"https://api.github.com/users/Flarkk/orgs","repos_url":"https://api.github.com/users/Flarkk/repos","events_url":"https://api.github.com/users/Flarkk/events{/privacy}","received_events_url":"https://api.github.com/users/Flarkk/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-05-15T18:22:06Z","updated_at":"2026-08-13T07:05:10Z","body":"> We need to figure out if the change to get_z_far() and get_pixels_per_meter() was correct or if it is a regression.\n\nI can confirm that #100209 is mathematically correct, but it's based on an implicit assumption that the projection matrix has the standard OpenGL form (Y-up, looking towards -Z). This issue challenges this assumption.\n\nConsidering what `set_depth_correction()` can perform (flip_y and/or reverse_z and/or remap_z) : \n- factoring in flip_y and reverse_z should be as simple as introducing a few `abs()` here and there. This should easily make `get_z_far()`, `get_pixels_per_meter()`, `get_aspect()` return positive values \n- remap_z might be a little bit more complex, although feasible. Now I believe it doesn't come in play directly in this specific issue, so I'm not clear on whether it has the same level of importance. Is there any case users may want to get z far or near on a remapped matrix ?\n\nNote : all these specific cases should be added to unit tests anyway.","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2884705361/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2884718354","html_url":"https://github.com/godotengine/godot/issues/106312#issuecomment-2884718354","issue_url":"https://api.github.com/repos/godotengine/godot/issues/106312","id":2884718354,"node_id":"IC_kwDOAO6SJc6r8U8S","user":{"login":"wiryls","id":7984500,"node_id":"MDQ6VXNlcjc5ODQ1MDA=","avatar_url":"https://avatars.githubusercontent.com/u/7984500?v=4","gravatar_id":"","url":"https://api.github.com/users/wiryls","html_url":"https://github.com/wiryls","followers_url":"https://api.github.com/users/wiryls/followers","following_url":"https://api.github.com/users/wiryls/following{/other_user}","gists_url":"https://api.github.com/users/wiryls/gists{/gist_id}","starred_url":"https://api.github.com/users/wiryls/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/wiryls/subscriptions","organizations_url":"https://api.github.com/users/wiryls/orgs","repos_url":"https://api.github.com/users/wiryls/repos","events_url":"https://api.github.com/users/wiryls/events{/privacy}","received_events_url":"https://api.github.com/users/wiryls/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-05-15T18:27:25Z","updated_at":"2025-05-15T18:27:25Z","body":"Thanks for explanations, it's quite helpful!\n\nAnd one last question about the method name of [RenderSceneData.get_view_projection](https://docs.godotengine.org/en/stable/classes/class_renderscenedata.html#class-renderscenedata-method-get-view-projection). Is that really an appropriate name? As it's actually another camera projection with eye offset, the name is too easily confused with view matrix.","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2884718354/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5277267920","html_url":"https://github.com/godotengine/godot/issues/106312#issuecomment-5277267920","issue_url":"https://api.github.com/repos/godotengine/godot/issues/106312","id":5277267920,"node_id":"IC_kwDOAO6SJc8AAAABOoy30A","user":{"login":"Flarkk","id":49606622,"node_id":"MDQ6VXNlcjQ5NjA2NjIy","avatar_url":"https://avatars.githubusercontent.com/u/49606622?v=4","gravatar_id":"","url":"https://api.github.com/users/Flarkk","html_url":"https://github.com/Flarkk","followers_url":"https://api.github.com/users/Flarkk/followers","following_url":"https://api.github.com/users/Flarkk/following{/other_user}","gists_url":"https://api.github.com/users/Flarkk/gists{/gist_id}","starred_url":"https://api.github.com/users/Flarkk/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Flarkk/subscriptions","organizations_url":"https://api.github.com/users/Flarkk/orgs","repos_url":"https://api.github.com/users/Flarkk/repos","events_url":"https://api.github.com/users/Flarkk/events{/privacy}","received_events_url":"https://api.github.com/users/Flarkk/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-08-13T07:18:19Z","updated_at":"2026-08-13T07:18:19Z","body":"As per https://github.com/godotengine/godot/issues/107383#issuecomment-2972232741 :\n\n> The RenderSceneData class returns a copy of the projection that has reverse z applied and has the depth correction applied. So the get_z_far() and other getters no longer work correctly.\n\nAs the projection returned by `RenderSceneData` is primarily designed for passing back to the GPU, @clayjohn 's idea is to return this projection data as a `PackedFloatArray` to discourage any usage as a `Projection`.\n`RenderSceneData` can then expose planes / aspect getters directly so users can still access these values without deriving them from the projection.\n\nThis is what #116316 implements. Any reviews welcome so we can move on and close this issue.","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5277267920/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null}]