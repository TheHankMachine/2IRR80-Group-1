:"aaaaaa","default":false,"description":"","archived_at":null,"archived_by":null},{"id":709269775,"node_id":"MDU6TGFiZWw3MDkyNjk3NzU=","url":"https://api.github.com/repos/godotengine/godot/labels/topic:dotnet","name":"topic:dotnet","color":"ffee88","default":false,"description":"","archived_at":null,"archived_by":null}],"state":"closed","locked":false,"assignees":[],"milestone":null,"comments":1,"created_at":"2026-03-02T17:05:29Z","updated_at":"2026-09-22T17:37:23Z","closed_at":"2026-09-22T17:37:18Z","assignee":null,"author_association":"NONE","issue_field_values":[],"type":null,"active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"### Tested versions\n\n- Reproducable in 4.6.1.stable.mono.official [14d19694e]\n\n### System information\n\nWindows 10 - Godot 4.6.1 stable.mono.official\n\n### Issue description\n\nFor a project setup with a separate client and server code base I wanted to export different assemblies based on a preprocessor constant, which is apparently done through features in the export menu. So I created an export configuration containing a DEDICATED_SERVER feature, and overrode the config/name and project/assembly_name project settings to another name for the server (I also overrode the run/main_scene setting, but I don't feel that's particularly relevant to the problem). I then created a separate ProjectServer.sln and ProjectServer.csproj files.\n\nAfter that, when I try to run the exported application, it throws the following errors:\n<img width=\"409\" height=\"166\" alt=\"Image\" src=\"https://github.com/user-attachments/assets/e9accdd1-1c2b-4182-ba03-400dcce45c6d\" />\n<img width=\"994\" height=\"275\" alt=\"Image\" src=\"https://github.com/user-attachments/assets/d150e120-de36-44ee-817a-5aae9c630ed6\" />\n\nI tried manually renaming the data folder containing the dlls, but that removed the error popup and changed the console output to this:\n<img width=\"1000\" height=\"341\" alt=\"Image\" src=\"https://github.com/user-attachments/assets/55480fbb-d51d-4da7-8427-95666346f385\" />\n\n### Steps to reproduce\n\n- Create export profile with a custom feature.\n- Override config/name and project/assembly_name project settings using said feature.\n- Create .sln and .csproj files matching the assembly name.\n- Export project using export profile.\n- Run exported project.\n\n### Minimal reproduction project (MRP)\n\nI believe any bare bones project setup will reproduce this issue.","closed_by":{"login":"raulsntos","id":3903059,"node_id":"MDQ6VXNlcjM5MDMwNTk=","avatar_url":"https://avatars.githubusercontent.com/u/3903059?v=4","gravatar_id":"","url":"https://api.github.com/users/raulsntos","html_url":"https://github.com/raulsntos","followers_url":"https://api.github.com/users/raulsntos/followers","following_url":"https://api.github.com/users/raulsntos/following{/other_user}","gists_url":"https://api.github.com/users/raulsntos/gists{/gist_id}","starred_url":"https://api.github.com/users/raulsntos/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/raulsntos/subscriptions","organizations_url":"https://api.github.com/users/raulsntos/orgs","repos_url":"https://api.github.com/users/raulsntos/repos","events_url":"https://api.github.com/users/raulsntos/events{/privacy}","received_events_url":"https://api.github.com/users/raulsntos/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/116968/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/godotengine/godot/issues/116968/timeline","performed_via_github_app":null,"state_reason":"not_planned","pinned_comment":null}