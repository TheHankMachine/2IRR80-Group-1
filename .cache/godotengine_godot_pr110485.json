with destructor call order (vtable for the child class disposed before base class destructor is called), since it's crashing with `pure virtual` call error.\r\n\r\n```\r\nThread 0::  Dispatch queue: com.apple.main-thread\r\n0   libsystem_kernel.dylib        \t       0x1920f79b8 __ulock_wait + 8\r\n1   libsystem_pthread.dylib       \t       0x19213a0b0 _pthread_join + 608\r\n2   Godot                         \t       0x107d7474c Thread::wait_to_finish() + 196 (thread_apple.cpp:112)\r\n3   Godot                         \t       0x1088b1c9c EditorExportPlatformAppleEmbedded::~EditorExportPlatformAppleEmbedded() + 108 (editor_export_platform_apple_embedded.cpp:2899)\r\n4   Godot                         \t       0x108339588 EditorExportPlatformVisionOS::~EditorExportPlatformVisionOS() + 28\r\n5   Godot                         \t       0x1083395b4 EditorExportPlatformVisionOS::~EditorExportPlatformVisionOS() + 28\r\n6   Godot                         \t       0x10557d62c void memdelete<RefCounted>(RefCounted*) + 52 (memory.h:139)\r\n7   Godot                         \t       0x1082ce844 Ref<EditorExportPlatform>::unref() + 68 (ref_counted.h:206)\r\n...\r\n\r\nThread 24 Crashed:\r\n0   libsystem_kernel.dylib        \t       0x1920fe388 __pthread_kill + 8\r\n1   libsystem_pthread.dylib       \t       0x19213788c pthread_kill + 296\r\n2   libsystem_c.dylib             \t       0x192040a3c abort + 124\r\n3   libc++abi.dylib               \t       0x1920ed384 abort_message + 132\r\n4   libc++abi.dylib               \t       0x1920eccb0 __cxa_pure_virtual + 24\r\n5   Godot                         \t       0x1088aded4 EditorExportPlatformAppleEmbedded::_check_for_changes_poll_thread(void*) + 720 (editor_export_platform_apple_embedded.cpp:2440)\r\n6   Godot                         \t       0x107d74398 Thread::thread_callback(void*) + 64 (thread_apple.cpp:55)\r\n7   libsystem_pthread.dylib       \t       0x192137c0c _pthread_start + 136\r\n8   libsystem_pthread.dylib       \t       0x192132b80 thread_start + 8\r\n```\r\n\r\nFixes https://github.com/godotengine/godot/issues/110634\r\nFixes https://github.com/godotengine/godot/issues/111416","labels":[{"id":73330064,"node_id":"MDU6TGFiZWw3MzMzMDA2NA==","url":"https://api.github.com/repos/godotengine/godot/labels/bug","name":"bug","description":"","color":"ff6055","default":true,"archived_at":null,"archived_by":null},{"id":279097780,"node_id":"MDU6TGFiZWwyNzkwOTc3ODA=","url":"https://api.github.com/repos/godotengine/godot/labels/platform:macos","name":"platform:macos","description":"","color":"e4e4e4","default":false,"archived_at":null,"archived_by":null},{"id":279098219,"node_id":"MDU6TGFiZWwyNzkwOTgyMTk=","url":"https://api.github.com/repos/godotengine/godot/labels/topic:editor","name":"topic:editor","description":"","color":"ffee88","default":false,"archived_at":null,"archived_by":null},{"id":1327318271,"node_id":"MDU6TGFiZWwxMzI3MzE4Mjcx","url":"https://api.github.com/repos/godotengine/godot/labels/crash","name":"crash","description":"","color":"885544","default":false,"archived_at":null,"archived_by":null},{"id":2909900850,"node_id":"MDU6TGFiZWwyOTA5OTAwODUw","url":"https://api.github.com/repos/godotengine/godot/labels/topic:export","name":"topic:export","description":"","color":"ffee88","default":false,"archived_at":null,"archived_by":null}],"milestone":{"id":12939969,"node_id":"MI_kwDOAO6SJc4AxXLB","url":"https://api.github.com/repos/godotengine/godot/milestones/23","html_url":"https://github.com/godotengine/godot/milestone/23","labels_url":"https://api.github.com/repos/godotengine/godot/milestones/23/labels","number":23,"state":"closed","title":"4.6","description":"","creator":{"login":"Repiteo","id":17489292,"node_id":"MDQ6VXNlcjE3NDg5Mjky","avatar_url":"https://avatars.githubusercontent.com/u/17489292?v=4","gravatar_id":"","url":"https://api.github.com/users/Repiteo","html_url":"https://github.com/Repiteo","followers_url":"https://api.github.com/users/Repiteo/followers","following_url"