[{"id":3771829546,"node_id":"PRR_kwDOAO6SJc7g0Y0q","state":"APPROVED","user":{"site_admin":false,"suspended":false,"updated_at":"0001-01-01T00:00:00Z","avatar_url":"https://avatars.githubusercontent.com/u/5611323?v=4","created_at":"0001-01-01T00:00:00Z","followers":0,"following":0,"html_url":"https://github.com/AdriaandeJongh","id":5611323,"node_id":"MDQ6VXNlcjU2MTEzMjM=","login":"AdriaandeJongh","type":"User","owned_private_repos":0,"public_gists":0,"public_repos":0,"total_private_repos":0,"url":"https://api.github.com/users/AdriaandeJongh"},"body":"Functionality is fine (didn't look at code). If I were to be picky, I'd want to spawn the go to line popup just above the button – especially on a larger screen, it's a bit uncomfortable to click on a button in the right bottom and have a tiny window at the very top of the screen. Could also be a follow-up PR.","html_url":"https://github.com/godotengine/godot/pull/116081#pullrequestreview-3771829546","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/116081","author_association":"CONTRIBUTOR","submitted_at":"2026-02-09T08:20:58Z"},{"id":3772153423,"node_id":"PRR_kwDOAO6SJc7g1n5P","state":"COMMENTED","user":{"site_admin":false,"suspended":false,"updated_at":"0001-01-01T00:00:00Z","avatar_url":"https://avatars.githubusercontent.com/u/7645683?u=2867ee7fcd920bc19b7d1cbf4b10264b9bbc9326&v=4","created_at":"0001-01-01T00:00:00Z","followers":0,"following":0,"html_url":"https://github.com/bruvzg","id":7645683,"node_id":"MDQ6VXNlcjc2NDU2ODM=","login":"bruvzg","type":"User","owned_private_repos":0,"public_gists":0,"public_repos":0,"total_private_repos":0,"url":"https://api.github.com/users/bruvzg"},"body":"","html_url":"https://github.com/godotengine/godot/pull/116081#pullrequestreview-3772153423","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/116081","author_association":"MEMBER","submitted_at":"2026-02-09T09:24:41Z"},{"id":3772322544,"node_id":"PRR_kwDOAO6SJc7g2RLw","state":"COMMENTED","user":{"site_admin":false,"suspended":false,"updated_at":"0001-01-01T00:00:00Z","avatar_url":"https://avatars.githubusercontent.com/u/43543909?u=a1f7933340521a5903fe3cc2f8216a8c0a9565ec&v=4","created_at":"0001-01-01T00:00:00Z","followers":0,"following":0,"html_url":"https://github.com/arkology","id":43543909,"node_id":"MDQ6VXNlcjQzNTQzOTA5","login":"arkology","type":"User","owned_private_repos":0,"public_gists":0,"public_repos":0,"total_private_repos":0,"url":"https://api.github.com/users/arkology"},"body":"","html_url":"https://github.com/godotengine/godot/pull/116081#pullrequestreview-3772322544","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/116081","author_association":"CONTRIBUTOR","submitted_at":"2026-02-09T09:56:37Z"},{"id":3774298285,"node_id":"PRR_kwDOAO6SJc7g9zit","state":"COMMENTED","user":{"site_admin":false,"suspended":false,"updated_at":"0001-01-01T00:00:00Z","avatar_url":"https://avatars.githubusercontent.com/u/10054226?u=f0c85fe8c24debe91dc14d7efa97b51a19250b47&v=4","created_at":"0001-01-01T00:00:00Z","followers":0,"following":0,"html_url":"https://github.com/kitbdev","id":10054226,"node_id":"MDQ6VXNlcjEwMDU0MjI2","login":"kitbdev","type":"User","owned_private_repos":0,"public_gists":0,"public_repos":0,"total_private_repos":0,"url":"https://api.github.com/users/kitbdev"},"body":"When this button is used and the Go To Line popup finishes, the focus returns to this button but it should go to the text edit.\r\n\r\nLinking these directly could cause confusion since Go To Line popup uses Line and Character, while the button uses Line and Column (tabs are 1 char but 4 cols). But it already can be confusing and I'm not sure how to fix it without larger changes like unifying them, which could be done later.\r\n\r\n> I'd want to spawn the go to line popup just above the button – especially on a larger screen, it's a bit uncomfortable to click on a button in the right bottom and have a tiny window at the very top of the screen. Could also be a follow-up PR.\r\n\r\nThe Go To Line popup can't be interacted with the mouse (and can't be a SpinBox since it accepts columns too), so it doesn't really need to be next to the button IMO. It seems like having it close would encourage users to try using the mouse on it.\r\nAlso when opening by shortcut/menu I'd rather have it popup in a more prominent place like the top center than the bottom right, and for consistency the button should open it in the same place.\r\nIf we do add some mouse interaction to it (like custom up / down buttons), then it probably would be better to have it show next to the button, when it is opened by the button.","html_url":"https://github.com/godotengine/godot/pull/116081#pullrequestreview-3774298285","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/116081","author_association":"CONTRIBUTOR","submitted_at":"2026-02-09T17:01:09Z"},{"id":3780670429,"node_id":"PRR_kwDOAO6SJc7hWHPd","state":"APPROVED","user":{"site_admin":false,"suspended":false,"updated_at":"0001-01-01T00:00:00Z","avatar_url":"https://avatars.githubusercontent.com/u/180032?u=68d23e7ee9cdf810da125e8510b72f845b9dccc8&v=4","created_at":"0001-01-01T00:00:00Z","followers":0,"following":0,"html_url":"https://github.com/Calinou","id":180032,"node_id":"MDQ6VXNlcjE4MDAzMg==","login":"Calinou","type":"User","owned_private_repos":0,"public_gists":0,"public_repos":0,"total_private_repos":0,"url":"https://api.github.com/users/Calinou"},"body":"Tested locally, it works as expected. Code looks good to me.","html_url":"https://github.com/godotengine/godot/pull/116081#pullrequestreview-3780670429","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/116081","author_association":"MEMBER","submitted_at":"2026-02-10T18:04:40Z"},{"id":3781719162,"node_id":"PRR_kwDOAO6SJc7haHR6","state":"COMMENTED","user":{"site_admin":false,"suspended":false,"updated_at":"0001-01-01T00:00:00Z","avatar_url":"https://avatars.githubusercontent.com/u/100542