ght load more gdscript. ","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4859301983/reactions","total_count":2,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":2,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5471741867","html_url":"https://github.com/godotengine/godot/issues/120827#issuecomment-5471741867","issue_url":"https://api.github.com/repos/godotengine/godot/issues/120827","id":5471741867,"node_id":"IC_kwDOAO6SJc8AAAABRiQnqw","user":{"login":"zsoltfulop86","id":47794160,"node_id":"MDQ6VXNlcjQ3Nzk0MTYw","avatar_url":"https://avatars.githubusercontent.com/u/47794160?v=4","gravatar_id":"","url":"https://api.github.com/users/zsoltfulop86","html_url":"https://github.com/zsoltfulop86","followers_url":"https://api.github.com/users/zsoltfulop86/followers","following_url":"https://api.github.com/users/zsoltfulop86/following{/other_user}","gists_url":"https://api.github.com/users/zsoltfulop86/gists{/gist_id}","starred_url":"https://api.github.com/users/zsoltfulop86/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/zsoltfulop86/subscriptions","organizations_url":"https://api.github.com/users/zsoltfulop86/orgs","repos_url":"https://api.github.com/users/zsoltfulop86/repos","events_url":"https://api.github.com/users/zsoltfulop86/events{/privacy}","received_events_url":"https://api.github.com/users/zsoltfulop86/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-08-30T22:48:32Z","updated_at":"2026-08-30T22:48:32Z","body":"I also faced this issue with async preloading levels behind a loading screen.","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5471741867/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes"