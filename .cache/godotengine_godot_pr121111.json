What problem(s) does this PR solve?\r\n\r\nCurrently, if we delete an internal vertex from a Polygon2D's Polygon editor, all polygons made in the 'Polygons' mode aren't adjusted alongside the vertex array. This means polygons using the vertex remain and polygons using an ID above the deleted ID will not decrement, breaking them.\r\n\r\nBefore:\r\n<img width=\"678\" height=\"608\" alt=\"before\" src=\"https://github.com/user-attachments/assets/4ef72518-28ce-494a-8189-4168c9e27464\" />\r\n\r\nAfter:\r\n<img width=\"678\" height=\"608\" alt=\"after\" src=\"https://github.com/user-attachments/assets/06068e4c-7bee-462b-8fdb-391221d3bcd4\" />\r\n","labels":[{"id":73330064,"node_id":"MDU6TGFiZWw3MzMzMDA2NA==","url":"https://api.github.com/repos/godotengine/godot/labels/bug","name":"bug","description":"","color":"ff6055","default":true,"archived_at":null,"archived_by":null},{"id":279098219,"node_id":"MDU6TGFiZWwyNzkwOTgyMTk=","url":"https://api.github.com/repos/godotengine/godot/labels/topic:editor","name":"topic:editor","description":"","color":"ffee88","default":false,"archived_at":null,"archived_by":null},{"id":2666708059,"node_id":"MDU6TGFiZWwyNjY2NzA4MDU5","url":"https://api.github.com/repos/godotengine/godot/labels/topic:2d","name":"topic:2d","description":"","color":"ffee88","default":false,"archived_at":null,"archived_by":null}],"milestone":{"id":15520464,"node_id":"MI_kwDOAO6SJc4A7NLQ","url":"https://api.github.com/repos/godotengine/godot/milestones/25","html_url":"https://github.com/godotengine/godot/milestone/25","labels_url":"https://api.github.com/repos/godotengine/godot/milestones/25/labels","number":25,"state":"open","title":"4.8","description":"","creator":{"login":"Repiteo","id":17489292,"node_id":"MDQ6VXNlcjE3NDg5Mjky","avatar_url":"https://avatars.githubusercontent.com/u/17489292?v=4","gravatar_id":"","url":"https://api.github.com/users/Repiteo","html_url":"https://github.com/Repiteo","followers_url":"https://api.github.com/users/Repiteo/followers","follo