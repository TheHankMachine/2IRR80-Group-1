d_values":[],"type":null,"active_lock_reason":null,"draft":false,"pull_request":{"url":"https://api.github.com/repos/godotengine/godot/pulls/104117","html_url":"https://github.com/godotengine/godot/pull/104117","diff_url":"https://github.com/godotengine/godot/pull/104117.diff","patch_url":"https://github.com/godotengine/godot/pull/104117.patch","merged_at":null},"body":"I don't think the explicit `Iterator` structs are needed, so I'm proposing to remove them.\r\nThis removes code, and may even be easier for compilers to understand and optimize.\r\n\r\nThe one caveat is that if we want to ever add functionality to these iterators in the future, we might have to go back and fix some code that may have been written by then that's assuming the iterators are pointers.\r\nThis may be interesting for `Vector` because for CoW purposes, but here we're currently relying on `.write` instead of write proxies, so I don't think we need to be 'preparing' for that to happen.","closed_by":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/104117/reactions","total_count":3,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":3},"timeline_url":"https://api.github.com/repos/godotengine/godot/issues/104117/timeline","performed_via_github_app":null,"state_reason":null}