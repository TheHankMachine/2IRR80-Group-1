odot-proposals/issues/3357) and [14916](https://github.com/godotengine/godot-proposals/issues/14916) (sort of).\r\n\r\nCurrently I am just adding them as command line arguments as @Calinou suggested in my proposal, but might be better to add them as actual functions. If you have other suggestions and where to put them lmk.\r\n\r\nThis is nice to have by default so users don't have to hardcode the session number and count into args themselves, especially if you want to switch between 2-3-4 instances. We will also need this per-requisite if we end up doing automatic window resizing and positioning based on instance numbers/count, as suggested in [14916](https://github.com/godotengine/godot-proposals/issues/14916).","labels":[{"id":73330066,"node_id":"MDU6TGFiZWw3MzMzMDA2Ng==","url":"https://api.github.com/repos/godotengine/godot/labels/enhancement","name":"enhancement","description":"","color":"aaccff","default":true,"archived_at":null,"archived_by":null},{"id":279098219,"node_id":"MDU6TGFiZWwyNzkwOTgyMTk=","url":"https://api.github.com/repos/godotengine/godot/labels/topic:editor","name":"topic:editor","description":"","color":"ffee88","default":false,"archived_at":null,"archived_by":null}],"milestone":{"id":8237783,"node_id":"MI_kwDOAO6SJc4AfbLX","url":"https://api.github.com/repos/godotengine/godot/milestones/16","html_url":"https://github.com/godotengine/godot/milestone/16","labels_url":"https://api.github.com/repos/godotengine/godot/milestones/16/labels","number":16,"state":"open","title":"4.x","description":"Issues and pull requests slated for an undetermined Godot 4 release.","creator":{"login":"akien-mga","id":4701338,"node_id":"MDQ6VXNlcjQ3MDEzMzg=","avatar_url":"https://avatars.githubusercontent.com/u/4701338?v=4","gravatar_id":"","url":"https://api.github.com/users/akien-mga","html_url":"https://github.com/akien-mga","followers_url":"https://api.github.com/users/akien-mga/followers","following_url":"https://api.github.com/users/akien-mga/following{/other_use