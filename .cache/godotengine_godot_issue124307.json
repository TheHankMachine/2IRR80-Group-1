archived_at":null,"archived_by":null},{"id":279098219,"node_id":"MDU6TGFiZWwyNzkwOTgyMTk=","url":"https://api.github.com/repos/godotengine/godot/labels/topic:editor","name":"topic:editor","color":"ffee88","default":false,"description":"","archived_at":null,"archived_by":null},{"id":890310502,"node_id":"MDU6TGFiZWw4OTAzMTA1MDI=","url":"https://api.github.com/repos/godotengine/godot/labels/topic:import","name":"topic:import","color":"ffee88","default":false,"description":"","archived_at":null,"archived_by":null}],"state":"closed","locked":false,"assignees":[],"milestone":null,"comments":4,"created_at":"2026-10-08T21:23:47Z","updated_at":"2026-10-09T16:40:58Z","closed_at":"2026-10-09T15:04:14Z","assignee":null,"author_association":"CONTRIBUTOR","issue_field_values":[],"type":null,"active_lock_reason":null,"draft":false,"pull_request":{"url":"https://api.github.com/repos/godotengine/godot/pulls/124307","html_url":"https://github.com/godotengine/godot/pull/124307","diff_url":"https://github.com/godotengine/godot/pull/124307.diff","patch_url":"https://github.com/godotengine/godot/pull/124307.patch","merged_at":null},"body":"When a scene re-import re-creates its nodes, the editor re-applies staged node modifications from a table that stores node references as NodePaths. This protection only covered single node references (`@export var x: Node3D`); arrays of nodes (`Array[Node3D]`) stored raw object pointers that became stale after re-creation, leaving the property null or corrupted.\r\n\r\nAdd convert_node_refs_to_paths() and is_node_array_property() and use them in the record (revert + reimport) and restore paths so single refs and arrays of Nodes are all stored as paths and re-resolved. is_node_array_property() decodes the hint_string element encoding so only true node arrays are handled (not e.g. Array[NodePath]).\r\n\r\nFixes #124294\r\n\r\n<!--\r\nPlease target the `master` branch. We will take care of backporting relevant fixes to older versions.\r\n\r\nBefore submitting, please read our checklist for contributors:\r\nhttps://contributing.godotengine.org/en/latest/development/engine/introduction.html#checklist-for-new-contributors\r\n\r\nUse of AI must be disclosed and should include a description of how it was used.\r\n-->\r\n\r\n## What problem(s) does this PR solve?\r\n\r\n- Closes #\r\n\r\n## Additional information\r\n\r\n<!--\r\nProvide additional information and explanation of your PR, including areas that you are uncertain of or require special attention from reviewers. For examples, please read our pull request guidelines: https://contributing.godotengine.org/en/latest/development/contribution_rules.html#explain-your-contributions\r\n-->\r\n","closed_by":{"login":"AThousandShips","id":96648715,"node_id":"U_kgDOBcK-Cw","avatar_url":"https://avatars.githubusercontent.com/u/96648715?v=4","gravatar_id":"","url":"https://api.github.com/users/AThousandShips","html_url":"https://github.com/AThousandShips","followers_url":"https://api.github.com/users/AThousandShips/followers","following_url":"https://api.github.com/users/AThousandShips/following{/other_user}","gists_url":"https://api.github.com/users/AThousandShips/gists{/gist_id}","starred_url":"https://api.github.com/users/AThousandShips/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/AThousandShips/subscriptions","organizations_url":"https://api.github.com/users/AThousandShips/orgs","repos_url":"https://api.github.com/users/AThousandShips/repos","events_url":"https://api.github.com/users/AThousandShips/events{/privacy}","received_events_url":"https://api.github.com/users/AThousandShips/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/124307/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/godotengine/godot/issues/124307/timeline","performed_via_git