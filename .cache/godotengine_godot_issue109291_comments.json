/gists{/gist_id}","starred_url":"https://api.github.com/users/akien-mga/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/akien-mga/subscriptions","organizations_url":"https://api.github.com/users/akien-mga/orgs","repos_url":"https://api.github.com/users/akien-mga/repos","events_url":"https://api.github.com/users/akien-mga/events{/privacy}","received_events_url":"https://api.github.com/users/akien-mga/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-11-25T10:28:58Z","updated_at":"2025-11-25T10:28:58Z","body":"This doesn't seem to be platform-specific at all, the same is reproducible with a Linux export.\n\nCC @kitbdev @YeldhamDev @KoBeWi who worked on this class.","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3574925988/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3578329639","html_url":"https://github.com/godotengine/godot/issues/109291#issuecomment-3578329639","issue_url":"https://api.github.com/repos/godotengine/godot/issues/109291","id":3578329639,"node_id":"IC_kwDOAO6SJc7VSPon","user":{"login":"kitbdev","id":10054226,"node_id":"MDQ6VXNlcjEwMDU0MjI2","avatar_url":"https://avatars.githubusercontent.com/u/10054226?v=4","gravatar_id":"","url":"https://api.github.com/users/kitbdev","html_url":"https://github.com/kitbdev","followers_url":"https://api.github.com/users/kitbdev/followers","following_url":"https://api.github.com/users/kitbdev/following{/other_user}","gists_url":"https://api.github.com/users/kitbdev/gists{/gist_id}","starred_url":"https://api.github.com/users/kitbdev/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/kitbdev/subscriptions","organizations_url":"https://api.github.com/users/kitbdev/orgs","repos_url":"https://api.github.com/users/kitbdev/repos","events_url":"https://api.github.com/users/kitbdev/events{/privacy}","received_events_url":"https://api.github.com/users/kitbdev/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-11-26T01:17:25Z","updated_at":"2025-11-26T03:03:42Z","body":"I can reproduce on Windows export as well in 4.5.1.\nIt only happens with TabContainer and not TabBar.\nThere is nothing really in TabContainer that is tools only.\n\nWhen it loads, it looks like the value for current tab is just 0 from the file/resource loader.\n\n- I found https://github.com/godotengine/godot/issues/112179 which is probably the same.\n\nIt mentions `convert_text_resources_to_binary` as the cause. I wasn't able to test an export with `convert_text_resources_to_binary` off, since it crashed.\nIn the exported pck, it does look correct with `current_tab = 2` though.","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3578329639/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null}]