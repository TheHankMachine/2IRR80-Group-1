ub.com/users/lazarosY/following{/other_user}","gists_url":"https://api.github.com/users/lazarosY/gists{/gist_id}","starred_url":"https://api.github.com/users/lazarosY/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/lazarosY/subscriptions","organizations_url":"https://api.github.com/users/lazarosY/orgs","repos_url":"https://api.github.com/users/lazarosY/repos","events_url":"https://api.github.com/users/lazarosY/events{/privacy}","received_events_url":"https://api.github.com/users/lazarosY/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-04-23T06:38:16Z","updated_at":"2025-04-23T06:38:16Z","body":"Should be fine now.","author_association":"NONE","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2823220145/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2824275935","html_url":"https://github.com/godotengine/godot/pull/105644#issuecomment-2824275935","issue_url":"https://api.github.com/repos/godotengine/godot/issues/105644","id":2824275935,"node_id":"IC_kwDOAO6SJc6oVwff","user":{"login":"lazarosY","id":148948579,"node_id":"U_kgDOCODGYw","avatar_url":"https://avatars.githubusercontent.com/u/148948579?v=4","gravatar_id":"","url":"https://api.github.com/users/lazarosY","html_url":"https://github.com/lazarosY","followers_url":"https://api.github.com/users/lazarosY/followers","following_url":"https://api.github.com/users/lazarosY/following{/other_user}","gists_url":"https://api.github.com/users/lazarosY/gists{/gist_id}","starred_url":"https://api.github.com/users/lazarosY/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/lazarosY/subscriptions","organizations_url":"https://api.github.com/users/lazarosY/orgs","repos_url":"https://api.github.com/users/lazarosY/repos","events_url":"https://api.github.com/users/lazarosY/events{/privacy}","received_events_url":"https://api.github.com/users/lazarosY/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-04-23T13:17:58Z","updated_at":"2025-04-23T13:17:58Z","body":"> As I said in the comment [#105385 (comment)](https://github.com/godotengine/godot/issues/105385#issuecomment-2811502639), Nearest can be optimized to some extent, so skipping everything here is not the right approach.\r\n> \r\n> For example, look at the following:\r\n> \r\n> ```c++\r\n> bool Animation::_float_track_optimize_key(const TKey<float> t0, const TKey<float> t1, const TKey<float> t2, real_t p_allowed_velocity_err, real_t p_allowed_precision_error) {\r\n> \t// Remove overlapping keys.\r\n> \tif (Math::is_equal_approx(t0.time, t1.time) || Math::is_equal_approx(t1.time, t2.time)) {\r\n> \t\treturn true;\r\n> \t}\r\n> \tif (abs(t0.value - t1.value) < p_allowed_precision_error && abs(t1.value - t2.value) < p_allowed_precision_error) {\r\n> \t\treturn true;\r\n> \t}\r\n> \t// Calc velocities.\r\n> \tdouble v0 = (t1.value - t0.value) / (t1.time - t0.time);\r\n> \tdouble v1 = (t2.value - t1.value) / (t2.time - t1\r\n> ```\r\n> \r\n> There is a check for the exact equality of the keys in the first. And it should also be valid for Nearest. So if we were to skip some checks for the Nearest, you could add a line under the equality check that would return `false` to skip velocity check if it is Nearest like:\r\n> \r\n> ```c++\r\n> bool Animation::_float_track_optimize_key(const TKey<float> t0, const TKey<float> t1, const TKey<float> t2, real_t p_allowed_velocity_err, real_t p_allowed_precision_error, bool p_is_nearest) {\r\n> \t// Remove overlapping keys.\r\n> \tif (Math::is_equal_approx(t0.time, t1.time) || Math::is_equal_approx(t1.time, t2.time)) {\r\n> \t\treturn true;\r\n> \t}\r\n> \tif (abs(t0.value - t1.value) < p_allowed_precision_error && abs(t1.value - t2.value) < p_allowed_precision_error) {\r\n> \t\treturn true;\r\n> \t}\r\n> \tif (p_is_nearest) {\r\n> \t\treturn false;\r\n> \t}\r\n> \t// Calc velocities.\r\n> \tdouble v0 = (t1.value - t0.value) / (t1.time - t0.time);\r\n> \tdouble v1 = (t2.value - t1.value) / (t2.time - t1\r\n> ```\r\n\r\nThank you very much for taking the time to look into it and guiding me as much as you did. I will implement the fix as you've requested and get back to you.","author_association":"NONE","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2824275935/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2825027466","html_url":"https://github.com/godotengine/godot/pull/105644#issuecomment-2825027466","issue_url":"https://api.github.com/repos/godotengine/godot/issues/105644","id":2825027466,"node_id":"IC_kwDOAO6SJc6oYn-K","user":{"login":"lazarosY","id":148948579,"node_id":"U_kgDOCODGYw","avatar_url":"https://avatars.githubusercontent.com/u/148948579?v=4","gravatar_id":"","url":"https://api.github.com/users/lazarosY","html_url":"https://github.com/lazarosY","followers_url":"https://api.github.com/users/lazarosY/followers","following_url":"https://api.github.com/users/lazarosY/following{/other_user}","gists_url":"https://api.github.com/users/lazarosY/gists{/gist_id}","starred_url":"https://api.github.com/users/lazarosY/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/lazarosY/subscriptions","organizations_url":"https://api.github.com/users/lazarosY/orgs","repos_url":"https://api.github.com/users/lazarosY/repos","events_url":"https://api.github.com/users/lazarosY/events{/privacy}","received_events_url":"https://api.github.com/users/lazarosY/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-04-23T17:30:05Z","updated_at":"2025-04-23T17:30:05Z","body":"> I believe the implementation way is fine, so I would suggest just formatting the coding style. We will test it later to see if it fixes the issue.\r\n\r\nI implemented your suggestions, hoping for a favorable result! Thank you so much for all the time you spent reviewing and helping me out.","author_association":"NONE","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2825027466/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2826763015","html_url":"https://github.com/godotengine/godot/pull/105644#issuecomment-2826763015","issue_url":"https://api.github.com/repos/godotengine/godot/issues/105644","id":2826763015,"node_id":"IC_kwDOAO6SJc6ofPsH","user":{"login":"lazarosY","id":148948579,"node_id":"U_kgDOCODGYw","avatar_url":"https://avatars.githubusercontent.com/u/148948579?v=4","gravatar_id":"","url":"https://api.github.com/users/lazarosY","html_url":"https://github.com/lazarosY","followers_url":"https://api.github.com/users/lazarosY/followers","following_url":"https://api.github.com/users/lazarosY/following{/other_user}","gists_url":"https://api.github.com/users/lazarosY/gists{/gist_id}","starred_url":"https://api.github.com/users/lazarosY/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/lazarosY/subscriptions","organizations_url":"https://api.github.com/users/lazarosY/orgs","repos_url":"https://api.github.com/users/lazarosY/repos","events_url":"https://api.github.com/users/lazarosY/events{/privacy}","received_events_url":"https://api.github.com/users/lazarosY/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-04-24T08:19:03Z","updated_at":"2025-04-24T08:19:03Z","body":"> Alright now this is worked correctly, thanks. Please squash the commits into one to follow [PR workflow](https://docs.godotengine.org/en/stable/contributing/workflow/pr_workflow.html#the-interactive-rebase).\r\n\r\nOnce again thank you very much for your valuable help. I do have a question though since I am new to this and have never used rebase before . Will using \"git rebase -i upstream/master\" on my branch be enough, or should I go about this by git \"rebase -i HEAD~10\" and picking only my first commit ?","author_association":"NONE","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2826763015/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2826866644","html_url":"https://github.com/godotengine/godot/pull/105644#issuecomment-2826866644","issue_url":"https://api.github.com/repos/godotengine/godot/issues/105644","id":2826866644,"node_id":"IC_kwDOAO6SJc6ofo_U","user":{"login":"TokageItLab","id":61938263,"node_id":"MDQ6VXNlcjYxOTM4MjYz","avatar_url":"https://avatars.githubusercontent.com/u/61938263?v=4","gravatar_id":"","url":"https://api.github.com/users/TokageItLab","html_url":"https://github.com/TokageItLab","followers_url":"https://api.github.com/users/TokageItLab/followers","following_url":"https://api.github.com/users/TokageItLab/following{/other_user}","gists_url":"https://api.github.com/users/TokageItLab/gists{/gist_id}","starred_url":"https://api.github.com/users/TokageItLab/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/TokageItLab/subscriptions","organizations_url":"https://api.github.com/users/TokageItLab/orgs","repos_url":"https://api.github.com/users/TokageItLab/repos","events_url":"https://api.github.com/users/TokageItLab/events{/privacy}","received_events_url":"https://api.github.com/users/TokageItLab/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-04-24T08:54:35Z","updated_at":"2025-04-24T08:59:12Z","body":"There are several ways to do that. FYI I mainly use one of the followings:\r\n\r\n- Do `git commit --fixup` several times to reach the first commit and finally force push to overwrite the first commit\r\n- Do `git reset --mixed` with root of the branch and force push the commit (be careful to don't use `git reset -hard` to prevent discarding your changes)","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2826866644/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2826886057","html_url":"https://github.com/godotengine/godot/pull/105644#issuecomment-2826886057","issue_url":"https://api.github.com/repos/godotengine/godot/issues/105644","id":2826886057,"node_id":"IC_kwDOAO6SJc6oftup","user":{"login":"lazarosY","id":148948579,"node_id":"U_kgDOCODGYw","avatar_url":"https://avatars.githubusercontent.com/u/148948579?v=4","gravatar_id":"","url":"https://api.github.com/users/lazarosY","html_url":"https://github.com/lazarosY","followers_url":"https://api.github.com/users/lazarosY/followers","following_url":"https://api.github.com/users/lazarosY/following{/other_user}","gists_url":"https://api.github.com/users/lazarosY/gists{/gist_id}","starred_url":"https://api.github.com/users/lazarosY/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/lazarosY/subscriptions","organizations_url":"https://api.github.com/users/lazarosY/orgs","repos_url":"https://api.github.com/users/lazarosY/repos","events_url":"https://api.github.com/users/lazarosY/events{/privacy}","received_events_url":"https://api.github.com/users/lazarosY/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-04-24T08:59:54Z","updated_at":"2025-04-24T08:59:54Z","body":"> There are several ways to do that. FYI I mainly use one of the followings:\r\n> \r\n> * Do `git commit --fixup` several times to reach the first commit and finally force push to overwrite the first commit\r\n> * Do `git reset --mixed` with root of the branch and force push the commit (be careful to don't use `git reset -hard` to prevent discarding your changes)\r\n\r\nwould you advice against doing it as so : git \r\nrebase -i HEAD~10 and picking only my first commit ?","author_association":"NONE","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2826886057/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2826900050","html_url":"https://github.com/godotengine/godot/pull/105644#issuecomment-2826900050","issue_url":"https://api.github.com/repos/godotengine/godot/issues/105644","id":2826900050,"node_id":"IC_kwDOAO6SJc6ofxJS","user":{"login":"TokageItLab","id":61938263,"node_id":"MDQ6VXNlcjYxOTM4MjYz","avatar_url":"https://avatars.githubusercontent.com/u/61938263?v=4","gravatar_id":"","url":"https://api.github.com/users/TokageItLab","html_url":"https://github.com/TokageItLab","followers_url":"https://api.github.com/users/TokageItLab/followers","following_url":"https://api.github.com/users/TokageItLab/following{/other_user}","gists_url":"https://api.github.com/users/TokageItLab/gists{/gist_id}","starred_url":"https://api.github.com/users/TokageItLab/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/TokageItLab/subscriptions","organizations_url":"https://api.github.com/users/TokageItLab/orgs","repos_url":"https://api.github.com/users/TokageItLab/repos","events_url":"https://api.github.com/users/TokageItLab/events{/privacy}","received_events_url":"https://api.github.com/users/TokageItLab/received_events","type":"User","user_view_type":"public","site_admin":fal