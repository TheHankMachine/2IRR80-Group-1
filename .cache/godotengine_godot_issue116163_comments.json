s_url":"https://api.github.com/users/RoyalXXX/followers","following_url":"https://api.github.com/users/RoyalXXX/following{/other_user}","gists_url":"https://api.github.com/users/RoyalXXX/gists{/gist_id}","starred_url":"https://api.github.com/users/RoyalXXX/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/RoyalXXX/subscriptions","organizations_url":"https://api.github.com/users/RoyalXXX/orgs","repos_url":"https://api.github.com/users/RoyalXXX/repos","events_url":"https://api.github.com/users/RoyalXXX/events{/privacy}","received_events_url":"https://api.github.com/users/RoyalXXX/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-02-11T13:18:13Z","updated_at":"2026-02-11T13:18:13Z","body":"If this issue cannot be resolved, it might be worth documenting that, when building with MSVC, the source files should preferably be located in the drive root. Since absolute file paths end up embedded in the binary, this would help avoid unintentionally exposing personal directory information.","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3884395562/reactions","total_count":2,"+1":2,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null}]