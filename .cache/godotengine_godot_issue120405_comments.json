 manually.","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4883766169/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4957184928","html_url":"https://github.com/godotengine/godot/issues/120405#issuecomment-4957184928","issue_url":"https://api.github.com/repos/godotengine/godot/issues/120405","id":4957184928,"node_id":"IC_kwDOAO6SJc8AAAABJ3ijoA","user":{"login":"VewDev","id":115565209,"node_id":"U_kgDOBuNimQ","avatar_url":"https://avatars.githubusercontent.com/u/115565209?v=4","gravatar_id":"","url":"https://api.github.com/users/VewDev","html_url":"https://github.com/VewDev","followers_url":"https://api.github.com/users/VewDev/followers","following_url":"https://api.github.com/users/VewDev/following{/other_user}","gists_url":"https://api.github.com/users/VewDev/gists{/gist_id}","starred_url":"https://api.github.com/users/VewDev/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/VewDev/subscriptions","organizations_url":"https://api.github.com/users/VewDev/orgs","repos_url":"https://api.github.com/users/VewDev/repos","events_url":"https://api.github.com/users/VewDev/events{/privacy}","received_events_url":"https://api.github.com/users/VewDev/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-07-13T10:54:19Z","updated_at":"2026-07-13T10:54:19Z","body":"@BrianGixxob \n> 2 of 3 existing projects had no issue.\n\nIs it consistent in the same project? Or is it random? Do the 2 working projects always fail at the same points, and the failing project always fail? No matter how many times you run it?","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4957184928/reactions","to