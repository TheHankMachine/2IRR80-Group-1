":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":{"reason":"outdated"}},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3606223282","html_url":"https://github.com/godotengine/godot/issues/113491#issuecomment-3606223282","issue_url":"https://api.github.com/repos/godotengine/godot/issues/113491","id":3606223282,"node_id":"IC_kwDOAO6SJc7W8pmy","user":{"login":"AThousandShips","id":96648715,"node_id":"U_kgDOBcK-Cw","avatar_url":"https://avatars.githubusercontent.com/u/96648715?v=4","gravatar_id":"","url":"https://api.github.com/users/AThousandShips","html_url":"https://github.com/AThousandShips","followers_url":"https://api.github.com/users/AThousandShips/followers","following_url":"https://api.github.com/users/AThousandShips/following{/other_user}","gists_url":"https://api.github.com/users/AThousandShips/gists{/gist_id}","starred_url":"https://api.github.com/users/AThousandShips/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/AThousandShips/subscriptions","organizations_url":"https://api.github.com/users/AThousandShips/orgs","repos_url":"https://api.github.com/users/AThousandShips/repos","events_url":"https://api.github.com/users/AThousandShips/events{/privacy}","received_events_url":"https://api.github.com/users/AThousandShips/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-12-03T10:45:55Z","updated_at":"2025-12-03T11:11:46Z","body":"~I'd say it makes sense to make the context the grouping for messages~\n\n~Using the line of the source file as the context is unorthodox I'd say, normally contexts aren't unique like this but are grouped, like \"settings menu\" or similar~\n\n~Overriding this would mean adding a whole separate way to organize the entries, and would require figuring out the merger based on that~\n\n~Can you give examples of how other programs work with this? That don't group by the context?~","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3606223282/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":{"reason":"outdated"}},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3606280790","html_url":"https://github.com/godotengine/godot/issues/113491#issuecomment-3606280790","issue_url":"https://api.github.com/repos/godotengine/godot/issues/113491","id":3606280790,"node_id":"IC_kwDOAO6SJc7W83pW","user":{"login":"vaartis","id":14316128,"node_id":"MDQ6VXNlcjE0MzE2MTI4","avatar_url":"https://avatars.githubusercontent.com/u/14316128?v=4","gravatar_id":"","url":"https://api.github.com/users/vaartis","html_url":"https://github.com/vaartis","followers_url":"https://api.github.com/users/vaartis/followers","following_url":"https://api.github.com/users/vaartis/following{/other_user}","gists_url":"https://api.github.com/users/vaartis/gists{/gist_id}","starred_url":"https://api.github.com/users/vaartis/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/vaartis/subscriptions","organizations_url":"https://api.github.com/users/vaartis/orgs","repos_url":"https://api.github.com/users/vaartis/repos","events_url":"https://api.github.com/users/vaartis/events{/privacy}","received_events_url":"https://api.github.com/users/vaartis/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-12-03T10:57:28Z","updated_at":"2025-12-03T10:57:28Z","body":"This is for translation of dialogue in a game, the numbers are the order of the dialogue in a big resource file. I would like to enforce some order, so the translator can translate the dialogue in order of its appearance in the game. There are a few lines that are exactly the same in that dialogue, and those are the lines that get grouped out of order in the POT file. Somehow not grouping them together in the file would solve the issue for me, since other lines are ordered correctly.","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3606280790/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3606325829","html_url":"https://github.com/godotengine/godot/issues/113491#issuecomment-3606325829","issue_url":"https://api.github.com/repos/godotengine/godot/issues/113491","id":3606325829,"node_id":"IC_kwDOAO6SJc7W9CpF","user":{"login":"AThousandShips","id":96648715,"node_id":"U_kgDOBcK-Cw","avatar_url":"https://avatars.githubusercontent.com/u/96648715?v=4","gravatar_id":"","url":"https://api.github.com/users/AThousandShips","html_url":"https://github.com/AThousandShips","followers_url":"https://api.github.com/users/AThousandShips/followers","following_url":"https://api.github.com/users/AThousandShips/following{/other_user}","gists_url":"https://api.github.com/users/AThousandShips/gists{/gist_id}","starred_url":"https://api.github.com/users/AThousandShips/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/AThousandShips/subscriptions","organizations_url":"https://api.github.com/users/AThousandShips/orgs","repos_url":"https://api.github.com/users/AThousandShips/repos","events_url":"https://api.github.com/users/AThousandShips/events{/privacy}","received_events_url":"https://api.github.com/users/AThousandShips/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-12-03T11:08:12Z","updated_at":"2025-12-03T11:13:33Z","body":"The lines should be translated uniquely? Not the same way?\n\nThis is not really what `msgctxt` is for I'd say\n\nChecking closer I realize I was wrong, they are actually exported the same order as you add them, the ordering is based on how you sort them as far as I can tell, you sort just based on the key, ignoring the line number\n\nSo my initial analysis of it grouping by keys was wrong, it does do exactly what you are wanting it to do, it follows the order you provided, you need to sort by line and id some way","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3606325829/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3606362492","html_url":"https://github.com/godotengine/godot/issues/113491#issuecomment-3606362492","issue_url":"https://api.github.com/repos/godotengine/godot/issues/113491","id":3606362492,"node_id":"IC_kwDOAO6SJc7W9Ll8","user":{"login":"vaartis","id":14316128,"node_id":"MDQ6VXNlcjE0MzE2MTI4","avatar_url":"https://avatars.githubusercontent.com/u/14316128?v=4","gravatar_id":"","url":"https://api.github.com/users/vaartis","html_url":"https://github.com/vaartis","followers_url":"https://api.github.com/users/vaartis/followers","following_url":"https://api.github.com/users/vaartis/following{/other_user}","gists_url":"https://api.github.com/users/vaartis/gists{/gist_id}","starred_url":"https://api.github.com/users/vaartis/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/vaartis/subscriptions","organizations_url":"https://api.github.com/users/vaartis/orgs","repos_url":"https://api.github.com/users/vaartis/repos","events_url":"https://api.github.com/users/vaartis/events{/privacy}","received_events_url":"https://api.github.com/users/vaartis/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-12-03T11:16:08Z","updated_at":"2025-12-03T11:16:08Z","body":"I think what confused me was it grouping every occurance of the same msgid together, looks like the rest is ordered fine. Sorry for the trouble.","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3606362492/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null}]