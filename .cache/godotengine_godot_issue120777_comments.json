godot/issues/120777","id":4845784272,"node_id":"IC_kwDOAO6SJc8AAAABINTM0A","user":{"login":"LiveTrower","id":48926464,"node_id":"MDQ6VXNlcjQ4OTI2NDY0","avatar_url":"https://avatars.githubusercontent.com/u/48926464?v=4","gravatar_id":"","url":"https://api.github.com/users/LiveTrower","html_url":"https://github.com/LiveTrower","followers_url":"https://api.github.com/users/LiveTrower/followers","following_url":"https://api.github.com/users/LiveTrower/following{/other_user}","gists_url":"https://api.github.com/users/LiveTrower/gists{/gist_id}","starred_url":"https://api.github.com/users/LiveTrower/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/LiveTrower/subscriptions","organizations_url":"https://api.github.com/users/LiveTrower/orgs","repos_url":"https://api.github.com/users/LiveTrower/repos","events_url":"https://api.github.com/users/LiveTrower/events{/privacy}","received_events_url":"https://api.github.com/users/LiveTrower/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-06-30T16:33:46Z","updated_at":"2026-06-30T16:34:22Z","body":"> > This will eventually improve performance\r\n> \r\n> Eventually how? What does this do right now?\r\n\r\nI removed the sheen instructions from the compute shader that generates the DFG LUT and changed the format from RGBAHalf to RGHalf, since the blue channel was not being used.","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4845784272/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4845853598","html_url":"https://github.com/godotengine/godot/pull/120777#issuecomment-4845853598","issue_url":"https://api.github.com/repos/godotengine/godot/issues/120777","id":4845853598,"node_id":"IC_kwDOAO6SJc8AAAABINXbng","user":{"login":"clayjohn","id":16521339,"node_id":"MDQ6VXNlcjE2NTIxMzM5","avatar_url":"https://avatars.githubusercontent.com/u/16521339?v=4","gravatar_id":"","url":"https://api.github.com/users/clayjohn","html_url":"https://github.com/clayjohn","followers_url":"https://api.github.com/users/clayjohn/followers","following_url":"https://api.github.com/users/clayjohn/following{/other_user}","gists_url":"https://api.github.com/users/clayjohn/gists{/gist_id}","starred_url":"https://api.github.com/users/clayjohn/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/clayjohn/subscriptions","organizations_url":"https://api.github.com/users/clayjohn/orgs","repos_url":"https://api.github.com/users/clayjohn/repos","events_url":"https://api.github.com/users/clayjohn/events{/privacy}","received_events_url":"https://api.github.com/users/clayjohn/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-06-30T16:42:56Z","updated_at":"2026-06-30T16:42:56Z","body":"> > This will eventually improve performance\r\n> \r\n> Eventually how? What does this do right now?\r\n\r\nIt reduces bandwidth usage of the shader. So games that are bandwidth bound will have a slight improvement in performance. Most games won't have any difference one way or the other (but battery usage will be marginally improved). \r\n\r\nI think the \"eventually\" is a translation error. Its more like it will theoretically improve performance in some cases. Normally we don't merge theoretical performance improvements, but this one is a case where it is trivial and obvious. Plus the code cleanup is good anyway. Its valuable to remove dead code","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4845853598/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4847397774","html_url":"https://github.com/godotengine/godot/pull/120777#issuecomment-4847397774","issue_url":"https://api.github.com/repos/godotengine/godot/issues/120777","id":4847397774,"node_id":"IC_kwDOAO6SJc8AAAABIO1rjg","user":{"login":"Repiteo","id":17489292,"node_id":"MDQ6VXNlcjE3NDg5Mjky","avatar_url":"https://avatars.githubusercontent.com/u/17489292?v=4","gravatar_id":"","url":"https://api.github.com/users/Repiteo","html_url":"https://github.com/Repiteo","followers_url":"https://api.github.com/users/Repiteo/followers","following_url":"https://api.github.com/users/Repiteo/following{/other_user}","gists_url":"https://api.github.com/users/Repiteo/gists{/gist_id}","starred_url":"https://api.github.com/users/Repiteo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Repiteo/subscriptions","organizations_url":"https://api.github.com/users/Repiteo/orgs","repos_url":"https://api.github.com/users/Repiteo/repos","events_url":"https://api.github.com/users/Repiteo/events{/privacy}","received_events_url":"https://api.github.com/users/Repiteo/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-06-30T19:53:02Z","updated_at":"2026-06-30T19:53:02Z","body":"Thanks!","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4847397774/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null}]