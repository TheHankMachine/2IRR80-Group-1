929","id":2515902712,"node_id":"IC_kwDOAO6SJc6V9aD4","user":{"login":"Ivorforce","id":2308167,"node_id":"MDQ6VXNlcjIzMDgxNjc=","avatar_url":"https://avatars.githubusercontent.com/u/2308167?v=4","gravatar_id":"","url":"https://api.github.com/users/Ivorforce","html_url":"https://github.com/Ivorforce","followers_url":"https://api.github.com/users/Ivorforce/followers","following_url":"https://api.github.com/users/Ivorforce/following{/other_user}","gists_url":"https://api.github.com/users/Ivorforce/gists{/gist_id}","starred_url":"https://api.github.com/users/Ivorforce/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Ivorforce/subscriptions","organizations_url":"https://api.github.com/users/Ivorforce/orgs","repos_url":"https://api.github.com/users/Ivorforce/repos","events_url":"https://api.github.com/users/Ivorforce/events{/privacy}","received_events_url":"https://api.github.com/users/Ivorforce/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2024-12-04T00:57:05Z","updated_at":"2024-12-11T16:13:07Z","body":"Hrm, well the function itself isn't compatible with GDScript since it's a template function; quite optimal for C++ but parameters must be known at compile time. I think such a function would be better suited for a separate PR.","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2515902712/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2536590978","html_url":"https://github.com/godotengine/godot/pull/99929#issuecomment-2536590978","issue_url":"https://api.github.com/repos/godotengine/godot/issues/99929","id":2536590978,"node_id":"IC_kwDOAO6SJc6XMU6C","user":{"login":"Ivorforce","id":2308167,"node_id":"MDQ6VXNlcjIzMDgxNjc=","avatar_url":"https://avatars.githubusercont