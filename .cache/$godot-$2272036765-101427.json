[{"id":2545129659,"node_id":"PRR_kwDOAO6SJc6Xs5i7","state":"DISMISSED","user":{"site_admin":false,"suspended":false,"updated_at":"0001-01-01T00:00:00Z","avatar_url":"https://avatars.githubusercontent.com/u/9283098?u=a04daf8c4d579b733ac46d2e4d17324cca7870c0&v=4","created_at":"0001-01-01T00:00:00Z","followers":0,"following":0,"html_url":"https://github.com/kleonc","id":9283098,"node_id":"MDQ6VXNlcjkyODMwOTg=","login":"kleonc","type":"User","owned_private_repos":0,"public_gists":0,"public_repos":0,"total_private_repos":0,"url":"https://api.github.com/users/kleonc"},"body":"> * Now the default limit will not be +/-1000000, instead, the top-left will be (0, 0) while the bottom-right will become (viewport_w, viewport_h)\r\n\r\nThis is compatibility breaking change. Properties set to their default values are not being saved to the resource (scene) file, meaning if someone was using Camera2D with its default limits unchanged, then such limits are not saved within the scene file containing the Camera2D. After this change loading such scene would create the Camera2D with the new defaults, resulting in changed behavior (likely breaking user's project).","html_url":"https://github.com/godotengine/godot/pull/101427#pullrequestreview-2545129659","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/101427","author_association":"MEMBER","submitted_at":"2025-01-11T18:39:08Z"},{"id":2547965348,"node_id":"PRR_kwDOAO6SJc6X3t2k","state":"COMMENTED","user":{"site_admin":false,"suspended":false,"updated_at":"0001-01-01T00:00:00Z","avatar_url":"https://avatars.githubusercontent.com/u/9283098?u=a04daf8c4d579b733ac46d2e4d17324cca7870c0&v=4","created_at":"0001-01-01T00:00:00Z","followers":0,"following":0,"html_url":"https://github.com/kleonc","id":9283098,"node_id":"MDQ6VXNlcjkyODMwOTg=","login":"kleonc","type":"User","owned_private_repos":0,"public_gists":0,"public_repos":0,"total_private_repos":0,"url":"https://api.github.com/users/kleonc"},"body":"AFAICT no longer breaks compat. :+1:\r\n\r\n> * Added `limit_disabled`, which allows the camera focus to move anywhere. Set to `false` by default.\r\n\r\nAs already mentioned in https://github.com/godotengine/godot/pull/101427#issuecomment-2585764781, please rename it to `limit_enabled` and swap its default value/checks (even for the Camera2D itself there are already properties like `enabled`, `drag_{horizontal|vertical}_enabled`, `{position|rotation}_smoothing_enabled`).","html_url":"https://github.com/godotengine/godot/pull/101427#pullrequestreview-2547965348","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/101427","author_association":"MEMBER","submitted_at":"2025-01-13T21:36:47Z"},{"id":2547992951,"node_id":"PRR_kwDOAO6SJc6X30l3","state":"COMMENTED","user":{"site_admin":false,"suspended":false,"updated_at":"0001-01-01T00:00:00Z","avatar_url":"https://avatars.githubusercontent.com/u/2223172?u=fc85633b469acb6e7baef4dba5171f19a2a4ff85&v=4","created_at":"0001-01-01T00:00:00Z","followers":0,"following":0,"html_url":"https://github.com/KoBeWi","id":2223172,"node_id":"MDQ6VXNlcjIyMjMxNzI=","login":"KoBeWi","type":"User","owned_private_repos":0,"public_gists":0,"public_repos":0,"total_private_repos":0,"url":"https://api.github.com/users/KoBeWi"},"body":"","html_url":"https://github.com/godotengine/godot/pull/101427#pullrequestreview-2547992951","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/101427","author_association":"MEMBER","submitted_at":"2025-01-13T21:45:13Z"},{"id":2551291736,"node_id":"PRR_kwDOAO6SJc6YEZ9Y","state":"COMMENTED","user":{"site_admin":false,"suspended":false,"updated_at":"0001-01-01T00:00:00Z","avatar_url":"https://avatars.githubusercontent.com/u/9283098?u=a04daf8c4d579b733ac46d2e4d17324cca7870c0&v=4","created_at":"0001-01-01T00:00:00Z","followers":0,"following":0,"html_url":"https://github.com/kleonc","id":9283098,"node_id":"MDQ6VXNlcjkyODMwOTg=","login":"kleonc","type":"User","owned_private_repos":0,"public_gists":0,"p