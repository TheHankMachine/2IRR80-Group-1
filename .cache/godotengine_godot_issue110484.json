r","color":"ffee88","default":false,"description":"","archived_at":null,"archived_by":null},{"id":890310502,"node_id":"MDU6TGFiZWw4OTAzMTA1MDI=","url":"https://api.github.com/repos/godotengine/godot/labels/topic:import","name":"topic:import","color":"ffee88","default":false,"description":"","archived_at":null,"archived_by":null},{"id":2666705648,"node_id":"MDU6TGFiZWwyNjY2NzA1NjQ4","url":"https://api.github.com/repos/godotengine/godot/labels/topic:animation","name":"topic:animation","color":"ffee88","default":false,"description":"","archived_at":null,"archived_by":null}],"state":"closed","locked":false,"assignees":[],"milestone":{"url":"https://api.github.com/repos/godotengine/godot/milestones/23","html_url":"https://github.com/godotengine/godot/milestone/23","labels_url":"https://api.github.com/repos/godotengine/godot/milestones/23/labels","id":12939969,"node_id":"MI_kwDOAO6SJc4AxXLB","number":23,"title":"4.6","description":"","creator":{"login":"Repiteo","id":17489292,"node_id":"MDQ6VXNlcjE3NDg5Mjky","avatar_url":"https://avatars.githubusercontent.com/u/17489292?v=4","gravatar_id":"","url":"https://api.github.com/users/Repiteo","html_url":"https://github.com/Repiteo","followers_url":"https://api.github.com/users/Repiteo/followers","following_url":"https://api.github.com/users/Repiteo/following{/other_user}","gists_url":"https://api.github.com/users/Repiteo/gists{/gist_id}","starred_url":"https://api.github.com/users/Repiteo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Repiteo/subscriptions","organizations_url":"https://api.github.com/users/Repiteo/orgs","repos_url":"https://api.github.com/users/Repiteo/repos","events_url":"https://api.github.com/users/Repiteo/events{/privacy}","received_events_url":"https://api.github.com/users/Repiteo/received_events","type":"User","user_view_type":"public","site_admin":false},"open_issues":3,"closed_issues":2978,"state":"closed","created_at":"2025-05-22T16:25:52Z","updated_at":"2026-10-04T16:23:23Z","due_on":null,"closed_at":"2026-01-26T18:09:14Z"},"comments":1,"created_at":"2025-09-13T07:30:32Z","updated_at":"2025-11-14T23:21:07Z","closed_at":"2025-11-14T23:20:35Z","assignee":null,"author_association":"MEMBER","issue_field_values":[],"type":null,"active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"### Tested versions\n\n- Reproducible 4.1, 4.2, 4.3, 4.4, 4.5\n\n### System information\n\nAny\n\n### Issue description\n\nImported Animations should not be edited, as their state reverts each time they are re-imported.\n\nThe default Global (empty string) AnimationLibrary immediately after import correctly handles read-only.\n\n<img width=\"1456\" height=\"204\" alt=\"Image\" src=\"https://github.com/user-attachments/assets/6d8757ac-7dcd-40f0-ad92-fa4f65ac5ea1\" />\n\nHowever, adding an AnimationLibrary to the AnimationMixer containing it breaks the read-only handling. This changes its state from \"foreign\" to \"built-in\", making it editable.\n\n<img width=\"1497\" height=\"204\" alt=\"Image\" src=\"https://github.com/user-attachments/assets/ce164197-6a60-4fe1-9b56-a5e7f92f810b\" />\n\nAlthough the track has a separate imported flag that triggers the warning below, all operations are permitted in the GUI.\n\n<img width=\"891\" height=\"309\" alt=\"Image\" src=\"https://github.com/user-attachments/assets/dc26ebf2-cd2c-4cf4-b1a3-0f3cb1593242\" />\n\nLooking at the source code, it appears to determine this by checking whether `.import` exists in the resource path's filesystem. However, since the path changed after adding the AnimationLibrary, the determination seems to be failing.\n\nThis issue has existed since version 4.1, prior to the AnimationMixer implementation, so it likely occured with the initial implementation of the AnimationLibrary.\n\nDisabling the ManageAnimationLibrary option for imported AnimationPlayers is the simplest solution, but I'm concerned about breaking compatibility.\n\nAnother potential fix involves preserving the entity paths of Animations within the modified AnimationLibraryList, though I'm unsure if this is feasible.\n\n### Steps to reproduce\n\nAdd the AnimationLibrary to the imported AnimationMixer, save the .tscn file, and reopen it.\n\n### Minimal reproduction project (MRP)\n\n[import_animlib.zip](https://github.com/user-attachments/files/22309417/import_animlib.zip)","closed_by":{"login":"Repiteo","id":17489292,"node_id":"MDQ6VXNlcjE3NDg5Mjky","avatar_url":"https://avatars.githubusercontent.com/u/17489292?v=4","gravatar_id":"","url":"https://api.github.com/users/Repiteo","html_url":"https://github.com/Repiteo","followers_url":"https://api.github.com/users/Repiteo/followers","following_url":"https://api.github.com/users/Repiteo/following{/other_user}","gists_url":"https://api.github.com/users/Repiteo/gists{/gist_id}","starred_url":"https://api.github.com/users/Repiteo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Repiteo/subscriptions","organizations_url":"https://api.github.com/users/Repiteo/orgs","repos_url":"https://api.github.com/users/Repiteo/repos","events_url":"https://api.github.com/users/Repiteo/events{/privacy}","received_events_url":"https://api.github.com/users/Repiteo/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/110484/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/godotengine/godot/issues/110484/timeline","performed_via_github_app":null,"state_reason":"completed","pinned_comment":null}