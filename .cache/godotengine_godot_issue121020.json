tml_url":"https://github.com/godotengine/godot/pull/121020","diff_url":"https://github.com/godotengine/godot/pull/121020.diff","patch_url":"https://github.com/godotengine/godot/pull/121020.patch","merged_at":"2026-10-08T18:43:21Z"},"body":"This commit removes the image duplication that was present when validating a texture format.  In most cases, the texture format is already compatible and supported so the duplication is unnecessary.\r\n\r\nNow the duplication is only performed when the texture format is not supported and needs to be converted to a supported format.\r\n\r\nThis technically changes behavior a bit.  If any of the callers depended on always getting a duplicate they would no longer get one.  It didn't look like that was the case to me but I could have missed it.\r\n\r\nThis was a case I noticed while profiling my texture streaming pr (#113429).","closed_by":{"login":"Repiteo","id":17489292,"node_id":"MDQ6VXNlcjE3NDg5Mjky","avatar_url":"https://avatars.githubusercontent.com/u/17489292?v=4","gravatar_id":"","url":"https://api.github.com/users/Repiteo","html_url":"https://github.com/Repiteo","followers_url":"https://api.github.com/users/Repiteo/followers","following_url":"https://api.github.com/users/Repiteo/following{/other_user}","gists_url":"https://api.github.com/users/Repiteo/gists{/gist_id}","starred_url":"https://api.github.com/users/Repiteo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Repiteo/subscriptions","organizations_url":"https://api.github.com/users/Repiteo/orgs","repos_url":"https://api.github.com/users/Repiteo/repos","events_url":"https://api.github.com/users/Repiteo/events{/privacy}","received_events_url":"https://api.github.com/users/Repiteo/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/121020/reactions","total_count":6,"+1":2,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":4,"eyes":0},"timeli