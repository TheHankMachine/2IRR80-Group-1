[{"id":3102140676,"node_id":"PRR_kwDOAO6SJc645ukE","user":{"login":"clayjohn","id":16521339,"node_id":"MDQ6VXNlcjE2NTIxMzM5","avatar_url":"https://avatars.githubusercontent.com/u/16521339?u=e44a465cbebabb9ea2be80b59e6dc07966bef5b7&v=4","gravatar_id":"","url":"https://api.github.com/users/clayjohn","html_url":"https://github.com/clayjohn","followers_url":"https://api.github.com/users/clayjohn/followers","following_url":"https://api.github.com/users/clayjohn/following{/other_user}","gists_url":"https://api.github.com/users/clayjohn/gists{/gist_id}","starred_url":"https://api.github.com/users/clayjohn/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/clayjohn/subscriptions","organizations_url":"https://api.github.com/users/clayjohn/orgs","repos_url":"https://api.github.com/users/clayjohn/repos","events_url":"https://api.github.com/users/clayjohn/events{/privacy}","received_events_url":"https://api.github.com/users/clayjohn/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"Looks great! \n\nFor future reference, the old code was wrongly blendering the edge threshold with the \"true SDF\" provided in the MTSDF texture. The SDF is basically what you get with regular SDF fonts. So by blending with it we were losing the sharp edges that MSDF provides. \n\nIn a later PR we could consider reducing the size of the MSDF textures now since we should get better quality. ","state":"APPROVED","html_url":"https://github.com/godotengine/godot/pull/109437#pullrequestreview-3102140676","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/109437","author_association":"MEMBER","_links":{"html":{"href":"https://github.com/godotengine/godot/pull/109437#pullrequestreview-3102140676"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/109437"}},"submitted_at":"2025-08-08T21:02:10Z","commit_id":null},{"id":3102202159,"node_id":"PRR_kwDOAO6SJc6459kv","user":{"login":"fire","id":32321,"node_i