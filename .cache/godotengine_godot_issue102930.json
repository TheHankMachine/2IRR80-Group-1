19T08:51:28Z","updated_at":"2026-09-04T21:48:38Z","due_on":"2025-09-15T00:00:00Z","closed_at":"2025-09-18T17:13:14Z"},"comments":1,"created_at":"2025-02-16T19:55:49Z","updated_at":"2025-04-08T18:54:07Z","closed_at":"2025-04-08T17:46:52Z","assignee":null,"author_association":"MEMBER","issue_field_values":[],"type":null,"active_lock_reason":null,"draft":false,"pull_request":{"url":"https://api.github.com/repos/godotengine/godot/pulls/102930","html_url":"https://github.com/godotengine/godot/pull/102930","diff_url":"https://github.com/godotengine/godot/pull/102930.diff","patch_url":"https://github.com/godotengine/godot/pull/102930.patch","merged_at":"2025-04-08T17:46:52Z"},"body":"For a [proposal](https://github.com/godotengine/godot-proposals/issues/11787), I profiled `Array.filter` calls.\r\n\r\n11% of the time was spent on `GDScriptLambdaCallable::is_valid()`. I was able to optimize the function by skipping an unnecessary validation, speeding up the throughput of `Array.filter` by 10% (almost the full contribution of `is_valid`). This optimization affects all lambda calls, and thus functions operating on them.\r\n\r\nThe change should be safe for 4.4, but I'll let maintainers decide if they agree.\r\n\r\n## Explanation\r\n\r\n`GDScriptLambdaCallable::is_valid` holds its `script` as `Ref<GDScript>`. GDScript is `RefCounted`, so `GDScriptLambdaCallable` owns a reference to it. This guarantees that `script` is valid, and does not need to be further validated.","closed_by":{"login":"Repiteo","id":17489292,"node_id":"MDQ6VXNlcjE3NDg5Mjky","avatar_url":"https://avatars.githubusercontent.com/u/17489292?v=4","gravatar_id":"","url":"https://api.github.com/users/Repiteo","html_url":"https://github.com/Repiteo","followers_url":"https://api.github.com/users/Repiteo/followers","following_url":"https://api.github.com/users/Repiteo/following{/other_user}","gists_url":"https://api.github.com/users/Repiteo/gists{/gist_id}","starred_url":"https://api.github.com/users/Repiteo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Repiteo/subscriptions","organizations_url":"https://api.github.com/users/Repiteo/orgs","repos_url":"https://api.github.com/users/Repiteo/repos","events_url":"https://api.github.com/users/Repiteo/events{/privacy}","received_events_url":"https://api.github.com/users/Repiteo/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/102930/reactions","total_count":15,"+1":9,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":6,"eyes":0},"timeline_url":"https://api.github.com/repos/godotengine/godot/issues/102930/timeline","performed_via_github_app":null,"state_reason":null}