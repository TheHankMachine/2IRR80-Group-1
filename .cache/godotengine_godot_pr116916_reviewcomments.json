30:28Z","updated_at":"2026-03-10T18:30:28Z","html_url":"https://github.com/godotengine/godot/pull/116916#discussion_r2913675975","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/116916","_links":{"self":{"href":"https://api.github.com/repos/godotengine/godot/pulls/comments/2913675975"},"html":{"href":"https://github.com/godotengine/godot/pull/116916#discussion_r2913675975"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/116916"}},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/2913675975/reactions","total_count":2,"+1":2,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":38,"start_side":"RIGHT","line":null,"original_line":39,"side":"RIGHT","author_association":"CONTRIBUTOR","original_position":8,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/2913712227","pull_request_review_id":3924591480,"id":2913712227,"node_id":"PRRC_kwDOAO6SJc6tq7hj","diff_hunk":"@@ -51,11 +51,17 @@ bool are_spans_equal(const LHS *p_lhs, const RHS *p_rhs, size_t p_size) {\n \t}\n }\n \n-// Equivalent of std::span.\n-// Represents a view into a contiguous memory space.\n-// DISCLAIMER: This data type does not own the underlying buffer. DO NOT STORE IT.\n-//  Additionally, for the lifetime of the Span, do not resize the buffer, and do not insert or remove elements from it.\n-//  Failure to respect this may lead to crashes or undefined behavior.\n+/**\n+ * @brief Represents a view into a contiguous memory space, roughly equivalent\n+ * to `std::span`.\n+ *\n+ * DISCLAIMER: This data type does not own the underlying buffer. DO NOT STORE IT.","path":"core/templates/span.h","commit_id":"5dca872e9a6b1180c25907b2f1e16cbbd1f3ba2c","original_commit_id":"5dca872e9a6b1180c25907b2f1e16cbbd1f3ba2c","user":{"login":"Shadows-of-Fire","id":3682588,"node_id":"MDQ6VXNlcjM2ODI1ODg=","avatar_url":"https://avatar