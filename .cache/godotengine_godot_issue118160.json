un will once again be incorrect.\n\nExpected: The window to load at your specified window size every time.\n\n### Steps to reproduce\n\n-Create a project\n-Create a scene\n-Run the project\n-Note the window size not matching what is set in Project Settings\n\n### Minimal reproduction project (MRP)\n\nN/A","closed_by":{"login":"matheusmdx","id":44306054,"node_id":"MDQ6VXNlcjQ0MzA2MDU0","avatar_url":"https://avatars.githubusercontent.com/u/44306054?v=4","gravatar_id":"","url":"https://api.github.com/users/matheusmdx","html_url":"https://github.com/matheusmdx","followers_url":"https://api.github.com/users/matheusmdx/followers","following_url":"https://api.github.com/users/matheusmdx/following{/other_user}","gists_url":"https://api.github.com/users/matheusmdx/gists{/gist_id}","starred_url":"https://api.github.com/users/matheusmdx/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/matheusmdx/subscriptions","organizations_url":"https://api.github.com/users/matheusmdx/orgs","repos_url":"https://api.github.com/users/matheusmdx/repos","events_url":"https://api.github.com/users/matheusmdx/events{/privacy}","received_events_url":"https://api.github.com/users/matheusmdx/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/118160/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/godotengine/godot/issues/118160/timeline","performed_via_github_app":null,"state_reason":"duplicate","pinned_comment":null}