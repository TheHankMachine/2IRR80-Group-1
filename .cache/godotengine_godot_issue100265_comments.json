engine/godot/issues/comments/2790475201/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2939786246","html_url":"https://github.com/godotengine/godot/issues/100265#issuecomment-2939786246","issue_url":"https://api.github.com/repos/godotengine/godot/issues/100265","id":2939786246,"node_id":"IC_kwDOAO6SJc6vOZQG","user":{"login":"Infini-Creation","id":136735040,"node_id":"U_kgDOCCZpQA","avatar_url":"https://avatars.githubusercontent.com/u/136735040?v=4","gravatar_id":"","url":"https://api.github.com/users/Infini-Creation","html_url":"https://github.com/Infini-Creation","followers_url":"https://api.github.com/users/Infini-Creation/followers","following_url":"https://api.github.com/users/Infini-Creation/following{/other_user}","gists_url":"https://api.github.com/users/Infini-Creation/gists{/gist_id}","starred_url":"https://api.github.com/users/Infini-Creation/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Infini-Creation/subscriptions","organizations_url":"https://api.github.com/users/Infini-Creation/orgs","repos_url":"https://api.github.com/users/Infini-Creation/repos","events_url":"https://api.github.com/users/Infini-Creation/events{/privacy}","received_events_url":"https://api.github.com/users/Infini-Creation/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-06-04T12:07:29Z","updated_at":"2025-06-28T18:35:49Z","body":"For what it worth, I encounter pretty often random crash with _4.5-dev4_ release.\n\nAdding a new node to a scene, editing tile's collision shape of a tileset, just trying to paint tilemap with a tile.\n\nNever have these before with all _4.5-devX_ releases (could the issue be memory management linked ? Too much various causes of crashes IMHO), nothing dump on logs.\nUsing projects with compatibility mode.\n\nUpdate 06/28/2025: got another random crash with v4.5.beta1.official [46c495ca2] by, here again, just adding a Camera2D node to a root Node2D of a new scene.","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2939786246/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2954763689","html_url":"https://github.com/godotengine/godot/issues/100265#issuecomment-2954763689","issue_url":"https://api.github.com/repos/godotengine/godot/issues/100265","id":2954763689,"node_id":"IC_kwDOAO6SJc6wHh2p","user":{"login":"DarrylBD99","id":34701723,"node_id":"MDQ6VXNlcjM0NzAxNzIz","avatar_url":"https://avatars.githubusercontent.com/u/34701723?v=4","gravatar_id":"","url":"https://api.github.com/users/DarrylBD99","html_url":"https://github.com/DarrylBD99","followers_url":"https://api.github.com/users/DarrylBD99/followers","following_url":"https://api.github.com/users/DarrylBD99/following{/other_user}","gists_url":"https://api.github.com/users/DarrylBD99/gists{/gist_id}","starred_url":"https://api.github.com/users/DarrylBD99/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/DarrylBD99/subscriptions","organizations_url":"https://api.github.com/users/DarrylBD99/orgs","repos_url":"https://api.github.com/users/DarrylBD99/repos","events_url":"https://api.github.com/users/DarrylBD99/events{/privacy}","received_events_url":"https://api.github.com/users/DarrylBD99/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-06-09T06:16:55Z","updated_at":"2025-06-09T06:27:59Z","body":"After a little more messing around with Godot, I think I have narrowed it down (yes, it is still persistent in v4.4.1 release). Firstly, this kind of issue is only persistent whenever an editor pop-up appears. Furthermore, when I change the rendering method to compatibility mode, everything suddenly works fine, and I have had no editor crashes. In other words, it's likely a weird Vulkan issue with the Editor UI. \n\nI'm pretty sure my laptop supports Vulkan. Otherwise, I probably wouldn't be able to run it in the first place. The only thing I can think of is some weird driver issue or a flaw within Vulkan itself. I'll try updating my GPU driver and see first.\n\nEdit: Nope, just changed to the latest Gamer Ready Driver, issue is still there. (GPU: RTX 3060 Laptop)","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2954763689/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3708269082","html_url":"https://github.com/godotengine/godot/issues/100265#issuecomment-3708269082","issue_url":"https://api.github.com/repos/godotengine/godot/issues/100265","id":3708269082,"node_id":"IC_kwDOAO6SJc7dB7Ia","user":{"login":"Teltt","id":129358512,"node_id":"U_kgDOB7XasA","avatar_url":"https://avatars.githubusercontent.com/u/129358512?v=4","gravatar_id":"","url":"https://api.github.com/users/Teltt","html_url":"https://github.com/Teltt","followers_url":"https://api.github.com/users/Teltt/followers","following_url":"https://api.github.com/users/Teltt/following{/other_user}","gists_url":"https://api.github.com/users/Teltt/gists{/gist_id}","starred_url":"https://api.github.com/users/Teltt/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Teltt/subscriptions","organizations_url":"https://api.github.com/users/Teltt/orgs","repos_url":"https://api.github.com/users/Teltt/repos","events_url":"https://api.github.com/users/Teltt/events{/privacy}","received_events_url":"https://api.github.com/users/Teltt/received_events","type":"User"