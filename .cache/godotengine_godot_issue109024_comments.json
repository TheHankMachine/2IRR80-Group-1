[{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3124404750","html_url":"https://github.com/godotengine/godot/issues/109024#issuecomment-3124404750","issue_url":"https://api.github.com/repos/godotengine/godot/issues/109024","id":3124404750,"node_id":"IC_kwDOAO6SJc66OqIO","user":{"login":"scgm0","id":52148221,"node_id":"MDQ6VXNlcjUyMTQ4MjIx","avatar_url":"https://avatars.githubusercontent.com/u/52148221?v=4","gravatar_id":"","url":"https://api.github.com/users/scgm0","html_url":"https://github.com/scgm0","followers_url":"https://api.github.com/users/scgm0/followers","following_url":"https://api.github.com/users/scgm0/following{/other_user}","gists_url":"https://api.github.com/users/scgm0/gists{/gist_id}","starred_url":"https://api.github.com/users/scgm0/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/scgm0/subscriptions","organizations_url":"https://api.github.com/users/scgm0/orgs","repos_url":"https://api.github.com/users/scgm0/repos","events_url":"https://api.github.com/users/scgm0/events{/privacy}","received_events_url":"https://api.github.com/users/scgm0/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-07-27T13:13:00Z","updated_at":"2025-07-27T13:13:00Z","body":"Not only will users experience failures when using `System.Environment.GetEnvironmentVariables()`, but internal .NET APIs that rely on it, such as `System.Diagnostics.Process`, will also be affected due to the inability to retrieve environment variables.","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3124404750/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3124444749","html_url":"https://github.com/godotengine/godot/issues/109024#issuecomment-312444474