n- If the bug is reproduced, it will start automatically upgrading the whole branch without you asking it to\n\n### Minimal reproduction project (MRP)\n\n[4-4 to 4-5 upgrade.zip](https://github.com/user-attachments/files/23011440/4-4.to.4-5.upgrade.zip)","closed_by":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/111866/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/godotengine/godot/issues/111866/timeline","performed_via_github_app":null,"state_reason":null,"pinned_comment":null}