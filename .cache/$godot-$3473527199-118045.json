":false,"suspended":false,"updated_at":"0001-01-01T00:00:00Z","avatar_url":"https://avatars.githubusercontent.com/u/52322745?u=379f47422d5025b37eb87bdcaa6e1cc3927edfed&v=4","created_at":"0001-01-01T00:00:00Z","followers":0,"following":0,"html_url":"https://github.com/Rudolph-B","id":52322745,"node_id":"MDQ6VXNlcjUyMzIyNzQ1","login":"Rudolph-B","type":"User","owned_private_repos":0,"public_gists":0,"public_repos":0,"total_private_repos":0,"url":"https://api.github.com/users/Rudolph-B"},"body":"","html_url":"https://github.com/godotengine/godot/pull/118045#pullrequestreview-4939969067","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/118045","author_association":"MEMBER","submitted_at":"2026-08-14T18:02:56Z"},{"id":4941305403,"node_id":"PRR_kwDOAO6SJc8AAAABJoZWOw","state":"CHANGES_REQUESTED","commit_id":"105d671b4481d07a666c2a070574746fd36bf00d","user":{"site_admin":false,"suspended":false,"updated_at":"0001-01-01T00:00:00Z","avatar_url":"https://avatars.githubusercontent.com/u/16521339?u=e44a465cbebabb9ea2be80b59e6dc07966bef5b7&v=4","created_at":"0001-01-01T00:00:00Z","followers":0,"following":0,"html_url":"https://github.com/clayjohn","id":16521339,"node_id":"MDQ6VXNlcjE2NTIxMzM5","login":"clayjohn","type":"User","owned_private_repos":0,"public_gists":0,"public_repos":0,"total_private_repos":0,"url":"https://api.github.com/users/clayjohn"},"body":"Amazing work! This is looking really close to being ready. I think the actual implementation looks great, the only needed changes are to the API surface. \n\nI think everything should be a property on the lights or a project setting. I don't think Environment should be touched at all. Also, we need to cut down on the number of settings. I assume a lot of this is just stuff that was exposed by the original technique, but we need to be more careful about what is exposed and what is not in order to keep the feature intuitive and easy to use. \n\nIn general we should cut out every lever and knob that we aren't 100% sure is needed by the majority of users of this feature. We can always add in a setting in a follow up PR, but we can't take away settings. So its best to start simple and then add complexity as needed instead of starting with full complexity. ","html_url":"https://github.com/godotengine/godot/pull/118045#pullrequestreview-4941305403","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/118045","author_association":"MEMBER","submitted_at":"2026-08-14T21:40:44Z"},{"id":4943522709,"node_id":"PRR_kwDOAO6SJc8AAAABJqgrlQ","state":"COMMENTED","commit_id":"105d671b4481d07a666c2a070574746fd36bf00d","user":{"site_admin":false,"suspended":false,"updated_at":"0001-01-01T00:00:00Z","avatar_url":"https://avatars.githubusercontent.com/u/56268917?v=4","created_at":"0001-01-01T00:00:00Z","followers":0,"following":0,"html_url":"https://github.com/Image-unavailable","id":56268917,"node_id":"MDQ6VXNlcjU2MjY4OTE3","login":"Image-unavailable","type":"User","owned_private_repos":0,"public_gists":0,"public_repos":0,"total_private_repos":0,"url":"https://api.github.com/users/Image-unavailable"},"body":"","html_url":"https://github.com/godotengine/godot/pull/118045#pullrequestreview-4943522709","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/118045","author_association":"CONTRIBUTOR","submitted_at":"2026-08-15T09:43:12Z"},{"id":4946305436,"node_id":"PRR_kwDOAO6SJc8AAAABJtKhnA","state":"COMMENTED","commit_id":"105d671b4481d07a666c2a070574746fd36bf00d","user":{"site_admin":false,"suspended":false,"updated_at":"0001-01-01T00:00:00Z","avatar_url":"https://avatars.githubusercontent.com/u/52322745?u=379f47422d5025b37eb87bdcaa6e1cc3927edfed&v=4","created_at":"0001-01-01T00:00:00Z","followers":0,"following":0,"html_url":"https://github.com/Rudolph-B","id":52322745,"node_id":"MDQ6VXNlcjUyMzIyNzQ1","login":"Rudolph-B","type":"User","owned_private_repos":0,"public_gists":0,"public_repos":0,"total_private_repos":0,"url":"https://api.github.com/u