68582,"node_id":"MDQ6VXNlcjExNjg1ODI=","login":"jcostello","type":"User","owned_private_repos":0,"public_gists":0,"public_repos":0,"total_private_repos":0,"url":"https://api.github.com/users/jcostello"},"body":"","html_url":"https://github.com/godotengine/godot/pull/118045#pullrequestreview-4053665035","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/118045","author_association":"CONTRIBUTOR","submitted_at":"2026-04-02T23:42:39Z"},{"id":4086244924,"node_id":"PRR_kwDOAO6SJc7zjyY8","state":"COMMENTED","commit_id":"7aedf2d1affe29492da4ce6a427d011d98785551","user":{"site_admin":false,"suspended":false,"updated_at":"0001-01-01T00:00:00Z","avatar_url":"https://avatars.githubusercontent.com/u/180032?u=68d23e7ee9cdf810da125e8510b72f845b9dccc8&v=4","created_at":"0001-01-01T00:00:00Z","followers":0,"following":0,"html_url":"https://github.com/Calinou","id":180032,"node_id":"MDQ6VXNlcjE4MDAzMg==","login":"Calinou","type":"User","owned_private_repos":0,"public_gists":0,"public_repos":0,"total_private_repos":0,"url":"https://api.github.com/users/Calinou"},"body":"Tested locally, it works as expected.\r\n\r\nWhen paired with https://github.com/godotengine/godot/pull/97646, that PR's **Write Depth** property will make heightmaps cast contact shadows:\r\n\r\nhttps://github.com/user-attachments/assets/fa139753-3bd9-460d-aef0-45d4764ac336\r\n\r\nSome feedback:\r\n\r\n- The maximum length a contact shadow can cover depends on viewport resolution (e.g. changing **Scaling 3D > Scale** will affect this length). Higher resolutions reduce the contact shadow's maximum length. This isn't ideal for reasons similar to [#54518](https://github.com/godotengine/godot/issues/54518), but it ensures performance figures don't vary too much across resolutions.\r\n\r\n- In terms of API design, I think the property in DirectionalLight3D should be called **Allow Contact Shadows**, as it does not enable contact shadows by itself. Instead, you need to enable contact shadows in the Environment resource.\r\n\r\n- Changing **Max Steps** appears to have no effect (visual or performance).","html_url":"https://github.com/godotengine/godot/pull/118045#pullrequestreview-4086244924","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/118045","author_association":"MEMBER","submitted_at":"2026-04-10T00:22:04Z"},{"id":4042676375,"node_id":"PRR_kwDOAO6SJc7w9liX","state":"COMMENTED","commit_id":"7aedf2d1affe29492da4ce6a427d011d98785551","user":{"site_admin":false,"suspended":false,"updated_at":"0001-01-01T00:00:00Z","avatar_url":"https://avatars.githubusercontent.com/u/96648715?u=af70f5d107e9c1447f296643d5a566dab53d25e8&v=4","created_at":"0001-01-01T00:00:00Z","followers":0,"following":0,"html_url":"https://github.com/AThousandShips","id":96648715,"node_id":"U_kgDOBcK-Cw","login":"AThousandShips","type":"User","owned_private_repos":0,"public_gists":0,"public_repos":0,"total_private_repos":0,"url":"https://api.github.com/users/AThousandShips"},"body":"","html_url":"https://github.com/godotengine/godot/pull/118045#pullrequestreview-4042676375","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/118045","author_association":"MEMBER","submitted_at":"2026-04-14T08:33:33Z"},{"id":4350609133,"node_id":"PRR_kwDOAO6SJc8AAAABA1EG7Q","state":"COMMENTED","commit_id":"7aedf2d1affe29492da4ce6a427d011d98785551","user":{"site_admin":false,"suspended":false,"updated_at":"0001-01-01T00:00:00Z","avatar_url":"https://avatars.githubusercontent.com/u/52322745?u=379f47422d5025b37eb87bdcaa6e1cc3927edfed&v=4","created_at":"0001-01-01T00:00:00Z","followers":0,"following":0,"html_url":"https://github.com/Rudolph-B","id":52322745,"node_id":"MDQ6VXNlcjUyMzIyNzQ1","login":"Rudolph-B","type":"User","owned_private_repos":0,"public_gists":0,"public_repos":0,"total_private_repos":0,"url":"https://api.github.com/users/Rudolph-B"},"body":"","html_url":"https://github.com/godotengine/godot/pull/118045#pullrequestreview-4350609133","pull_request_url":"ht