"ffee88","default":false,"description":"","archived_at":null,"archived_by":null}],"state":"open","locked":false,"assignees":[],"milestone":null,"comments":2,"created_at":"2026-04-22T17:38:52Z","updated_at":"2026-04-24T22:07:09Z","closed_at":null,"assignee":null,"author_association":"NONE","issue_field_values":[],"type":null,"active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"### Tested versions\n\n- reproducible in v4.6.stable.official [89cea1439]\n\n### System information\n\nWindows 10\n\n### Issue description\n\n`DirAccess.rename()` & `DirAccess.rename_absolute()` deletes the target \"to\" file, even if it returns a \"FAILED\" error\n\n### Steps to reproduce\n\nSee code and minimal project included below\n\n### Minimal reproduction project (MRP)\n\n```\n@tool\nclass_name Main\nextends Node2D\n\n@export_tool_button(\"Rename\") var rename = _rename\n@export_tool_button(\"Rename Static\") var rename_static = _rename_static\n\n\nfunc _rename() -> void:\n\tvar dir = DirAccess.open(\"res://\")\n\tvar error = dir.rename(\"any incorect name\", \"res://icon.svg\")\n\tprint(error)\n\n\tEditorInterface.get_resource_filesystem().scan()\t\t\t\t\t\t\t# refresh file system\n\n\nfunc _rename_static() -> void:\n\tprint(DirAccess.rename_absolute(\"any incorect name\", \"res://icon.svg\"))\n\n\tEditorInterface.get_resource_filesystem().scan()\t\t\t\t\t\t\t# refresh file system\n```\n\n[DirAccess.rename.zip](https://github.com/user-attachments/files/26979909/DirAccess.rename.zip)","closed_by":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/118858/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/godotengine/godot/issues/118858/timeline","performed_via_github_app":null,"state_reason":null,"pinned_comment":null}