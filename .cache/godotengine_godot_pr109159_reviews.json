api.github.com/repos/godotengine/godot/pulls/109159"}},"submitted_at":"2025-09-30T23:16:01Z","commit_id":"273ea9cfdcb52167ede3fea08637e9284d7d1a03"},{"id":3286995145,"node_id":"PRR_kwDOAO6SJc7D65DJ","user":{"login":"Calinou","id":180032,"node_id":"MDQ6VXNlcjE4MDAzMg==","avatar_url":"https://avatars.githubusercontent.com/u/180032?u=68d23e7ee9cdf810da125e8510b72f845b9dccc8&v=4","gravatar_id":"","url":"https://api.github.com/users/Calinou","html_url":"https://github.com/Calinou","followers_url":"https://api.github.com/users/Calinou/followers","following_url":"https://api.github.com/users/Calinou/following{/other_user}","gists_url":"https://api.github.com/users/Calinou/gists{/gist_id}","starred_url":"https://api.github.com/users/Calinou/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Calinou/subscriptions","organizations_url":"https://api.github.com/users/Calinou/orgs","repos_url":"https://api.github.com/users/Calinou/repos","events_url":"https://api.github.com/users/Calinou/events{/privacy}","received_events_url":"https://api.github.com/users/Calinou/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"","state":"COMMENTED","html_url":"https://github.com/godotengine/godot/pull/109159#pullrequestreview-3286995145","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/109159","author_association":"MEMBER","_links":{"html":{"href":"https://github.com/godotengine/godot/pull/109159#pullrequestreview-3286995145"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/109159"}},"submitted_at":"2025-09-30T23:18:16Z","commit_id":"273ea9cfdcb52167ede3fea08637e9284d7d1a03"},{"id":3286999125,"node_id":"PRR_kwDOAO6SJc7D66BV","user":{"login":"Calinou","id":180032,"node_id":"MDQ6VXNlcjE4MDAzMg==","avatar_url":"https://avatars.githubusercontent.com/u/180032?u=68d23e7ee9cdf810da125e8510b72f845b9dccc8&v=4","gravatar_id":"","url":"https://api.github.com/users/Calinou","html_url":"https://github.com/Calinou","followers_url":"https://api.github.com/users/Calinou/followers","following_url":"https://api.github.com/users/Calinou/following{/other_user}","gists_url":"https://api.github.com/users/Calinou/gists{/gist_id}","starred_url":"https://api.github.com/users/Calinou/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Calinou/subscriptions","organizations_url":"https://api.github.com/users/Calinou/orgs","repos_url":"https://api.github.com/users/Calinou/repos","events_url":"https://api.github.com/users/Calinou/events{/privacy}","received_events_url":"https://api.github.com/users/Calinou/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"Tested locally, it works as expected. Code looks good to me.\r\n\r\n**Testing project:** [test_gdscript_optimizer_3.x.zip](https://github.com/user-attachments/files/22628135/test_gdscript_optimizer_3.x.zip)\r\n\r\nSome feedback:\r\n\r\n- The optimization options on GDScript resources are lost when the scene is reloaded, since a GDScript file can't store metadata. This means they don't affect the runtime at all, since running the project implies reloading the scene somehow.\r\n  - More generally, do we really need properties to toggle each optimization on a per-script basis? I thought project settings would suffice here, or at least a single boolean to toggle all optimizations on the script. Not that I expect many users to turn off optimizations, except to troubleshoot issues while the feature may still have bugs. In this case, a project setting would be enough.\r\n  - If we still decide to go with per-file optimization settings, it should be implemented as a top-level annotation instead (keyword in 3.x). For instance, `@skip_optimizer` (`skip_optimizer` in 3.x) to disable all optimizations.\r\n\r\n- I wonder if optimization should be enabled by default, at least during the 3.7.dev/beta cycle. We can revert the default change before 3.7.stable if it proves to cause too many regressions. Otherwise, I worry the feature won't get much testing. History has shown opt-in features are traditionally difficult to discover for users, especially in 3.x.\r\n\r\n- There are some issues with the current implementation of rich color printing:\r\n\r\n  - The color is not being reset correctly in this example from the testing project:\r\n\r\nTerminal | Editor Output log\r\n-|-\r\n<img width=\"943\" height=\"161\" alt=\"Image\" src=\"https://github.com/user-attachments/assets/4f4db989-787b-4a57-8a3c-615ec8f6c49e\" /> | <img width=\"831\" height=\"123\" alt=\"Image\" src=\"https://github.com/user-attachments/assets/3ee64771-6d5f-4175-b9e7-9f88e988a6af\" />\r\n\r\n  - **Debugger > Errors** also doesn't strip the ANSI codes, which results in escape codes showing up in warnings:\r\n\r\n<img width=\"1485\" height=\"106\" alt=\"Image\" src=\"https://github.com/user-attachments/assets/f938a941-7eb1-43c0-82d3-7c4b0464f47d\" />\r\n\r\n  - File logging also doesn't strip ANSI escape codes (see https://github.com/godotengine/godot/pull/90900 which fixed this in 4.x):\r\n\r\n<img width=\"903\" height=\"40\" alt=\"Image\" src=\"https://github.com/user-attachments/assets/13ddc166-9395-41ac-951d-4517bd1114de\" />\r\n\r\n- This function is considered not inlinable by the optimizer:\r\n\r\n```gdscript\r\ninline func is_prime(number: int, divisor: int = 2) -> bool:\r\n\tif number <= 2:\r\n\t\treturn (number == 2)\r\n\telif number % divisor == 0:\r\n\t\treturn false\r\n\telif divisor * divisor > number:\r\n\t\treturn true\r\n\r\n\treturn is_prime(number, divisor + 1)\r\n```\r\n\r\n```\r\nWARNING: inlining unsupported ( \"res://Node2D.gd\" line 6, col 53 ) function \"is_prime\" bool : if_else containing mixed returns.\r\n     at: warning_inline_unsupported (./modules/gdscript/gdscript_optimizer.cpp:3909)\r\n```\r\n\r\nHowever, it's fully typed and all its paths return the same `bool` type. I'm not sure what's preventing inlining here.\r\n\r\n- Performance-wise, note that the testing project doesn't benefit from the optimizer, presumably because it uses recursion.\r\n\r\nHowever, I benchmarked the code snippet included in the Performance section in OP and got a pretty substantial boost on an optimized editor build with LTO:\r\n\r\nBefore | After\r\n-|-\r\n4790 ms | 211 ms\r\n\r\n<details open>\r\n\r\n<summary>PC specifications</summary>\r\n\r\n- **CPU:** AMD Ryzen 9 9950X3D\r\n- **GPU:** NVIDIA GeForce RTX 5090\r\n- **RAM:** 64 GB (2×32 GB DDR5-6000 CL30)\r\n- **SSD:** Solidigm P44 Pro 2 TB\r\n- **OS:** Linux (Fedora 42)\r\n</details>","state":"COMMENTED","html_url":"https://github.com/godotengine/godot/pull/109159#pullrequestreview-3286999125","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/109159","author_association":"MEMBER","_links":{"html":{"href":"https://github.com/godotengine/godot/pull/109159#pullrequestreview-3286999125"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/109159"}},"submitted_at":"2025-09-30T23:19:21Z","commit_id":"273ea9cfdcb52167ede3fea08637e9284d7d1a03"},{"id":3287537387,"node_id":"PRR_kwDOAO6SJc7D89br","user":{"login":"lawnjelly","id":21999379,"node_id":"MDQ6VXNlcjIxOTk5Mzc5","avatar_url":"https://avatars.githubusercontent.com/u/21999379?u=2b8b17ce969861380874563b333a546e0bbaab56&v=4","gravatar_id":"","url":"https://api.github.com/users/lawnjelly","html_url":"https://github.com/lawnjelly","followers_url":"https://api.github.com/users/lawnjelly/followers","following_url":"https://api.github.com/users/lawnjelly/following{/other_user}","gists_url":"https://api.github.com/users/lawnjelly/gists{/gist_id}","starred_url":"https://api.github.com/users/lawnjelly/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/lawnjelly/subscriptions","organizations_url":"https://api.github.com/users/lawnjelly/orgs","repos_url":"https://api.github.com/users/lawnjelly/repos","events_url":"https://api.github.com/users/lawnjelly/events{/privacy}","received_events_url":"https://api.github.com/users/lawnjelly/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"","state":"COMMENTED","html_url":"https://github.com/godotengine/godot/pull/109159#pullrequestreview-3287537387","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/109159","author_association":"MEMBER","_links":{"html":{"href":"https://github.com/godotengine/godot/pull/109159#pullrequestreview-3287537387"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/109159"}},"submitted_at":"2025-10-01T04:38:19Z","commit_id":"273ea9cfdcb52167ede3fea08637e9284d7d1a03"}]