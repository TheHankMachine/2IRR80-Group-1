[{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3397013998","html_url":"https://github.com/godotengine/godot/pull/111074#issuecomment-3397013998","issue_url":"https://api.github.com/repos/godotengine/godot/issues/111074","id":3397013998,"node_id":"IC_kwDOAO6SJc7KelHu","user":{"login":"KoBeWi","id":2223172,"node_id":"MDQ6VXNlcjIyMjMxNzI=","avatar_url":"https://avatars.githubusercontent.com/u/2223172?v=4","gravatar_id":"","url":"https://api.github.com/users/KoBeWi","html_url":"https://github.com/KoBeWi","followers_url":"https://api.github.com/users/KoBeWi/followers","following_url":"https://api.github.com/users/KoBeWi/following{/other_user}","gists_url":"https://api.github.com/users/KoBeWi/gists{/gist_id}","starred_url":"https://api.github.com/users/KoBeWi/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/KoBeWi/subscriptions","organizations_url":"https://api.github.com/users/KoBeWi/orgs","repos_url":"https://api.github.com/users/KoBeWi/repos","events_url":"https://api.github.com/users/KoBeWi/events{/privacy}","received_events_url":"https://api.github.com/users/KoBeWi/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-10-13T11:02:29Z","updated_at":"2025-10-13T11:02:29Z","body":"Somewhat related to #108909\r\nYou can use `_customize_strings()` to get all strings that were gathered.","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3397013998/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3397067148","html_url":"https://github.com/godotengine/godot/pull/111074#issuecomment-3397067148","issue_url":"https://api.github.com/repos/godotengine/godot/issues/111074","id":3397067148,"node_id":"IC_kwDOAO6SJc7KeyGM","user":{"login":"dalexeev","id":47700418,"node_id":"MDQ6VXNlcjQ3NzAwNDE4","avatar_url":"https://avatars.githubusercontent.com/u/47700418?v=4","gravatar_id":"","url":"https://api.github.com/users/dalexeev","html_url":"https://github.com/dalexeev","followers_url":"https://api.github.com/users/dalexeev/followers","following_url":"https://api.github.com/users/dalexeev/following{/other_user}","gists_url":"https://api.github.com/users/dalexeev/gists{/gist_id}","starred_url":"https://api.github.com/users/dalexeev/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/dalexeev/subscriptions","organizations_url":"https://api.github.com/users/dalexeev/orgs","repos_url":"https://api.github.com/users/dalexeev/repos","events_url":"https://api.github.com/users/dalexeev/events{/privacy}","received_events_url":"https://api.github.com/users/dalexeev/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-10-13T11:14:54Z","updated_at":"2025-10-13T11:14:54Z","body":"> Somewhat related to #108909\r\n\r\nYes, it's similar functionality, but my PR differs in the following ways:\r\n\r\n1. This PR takes into account the possibility of multiple parsers and allows intercepting the results of previous parsers.\r\n2. This PR allows calling a parser from code (including standard parsers, which were previously unavailable) without having to click the \"Generate POT\" button in Project Settings.","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3397067148/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3405673250","html_url":"https://github.com/godotengine/godot/pull/111074#issuecomment-3405673250","issue_url":"https://api.github.com/repos/godotengine/godot/issues/111074","id":3405673250,"node_id":"IC_kwDOAO6SJc7K_nMi","user":{"login":"KoBeWi","id":2223172,"node_id":"MDQ6VXNlcjIyMjMxNzI=","avatar_url":"https://avatars.githubusercontent.com/u/2223172?v=4","gravatar_id":"","url":"https://api.github.com/users/KoBeWi","html_url":"https://github.com/KoBeWi","followers_url":"https://api.github.com/users/KoBeWi/followers","following_url":"https://api.github.com/users/KoBeWi/following{/other_user}","gists_url":"https://api.github.com/users/KoBeWi/gists{/gist_id}","starred_url":"https://api.github.com/users/KoBeWi/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/KoBeWi/subscriptions","organizations_url":"https://api.github.com/users/KoBeWi/orgs","repos_url":"https://api.github.com/users/KoBeWi/repos","events_url":"https://api.github.com/users/KoBeWi/events{/privacy}","received_events_url":"https://api.github.com/users/KoBeWi/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-10-15T10:19:56Z","updated_at":"2025-10-15T10:19:56Z","body":"I gave it a test. I figured I can use `get_previous_parser(path.get_extension())` to get strings from a file, but the parser seems to also receive built-in scripts and they can't be forwarded this way. What to do with them?","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3405673250/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3405718883","html_url":"https://github.com/godotengine/godot/pull/111074#issuecomment-3405718883","issue_url":"https://api.github.com/repos/godotengine/godot/issues/111074","id":3405718883,"node_id":"IC_kwDOAO6SJc7K_yVj","user":{"login":"dalexeev","id":47700418,"node_id":"MDQ6VXNlcjQ3NzAwNDE4","avatar_url":"https://avatars.githubusercontent.com/u/47700418?v=4","gravatar_id":"","url":"https://api.github.com/users/dalexeev","html_url":"https://github.com/dalexeev","followers_url":"https://api.github.com/users/dalexeev/followers","following_url":"https://api.github.com/users/dalexeev/following{/other_user}","gists_url":"https://api.github.com/users/dalexeev/gists{/gist_id}","starred_url":"https://api.github.com/users/dalexeev/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/dalexeev/subscriptions","organizations_url":"https://api.github.com/users/dalexeev/orgs","repos_url":"https://api.github.com/users/dalexeev/repos","events_url":"https://api.github.com/users/dalexeev/events{/privacy}","received_events_url":"https://api.github.com/users/dalexeev/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-10-15T10:28:51Z","updated_at":"2025-10-15T10:28:51Z","body":"> but the parser seems to also receive built-in scripts and they can't be forwarded this way\r\n\r\nInteresting, I didn't know the POT generator supported built-in scripts (the scene parser not only extracts node properties, but also redirects to the GDScript parser?!). You could try specifying the `\"gd\"` extension instead of `path.get_extension()` to redirect to the correct parser. But if this is the case as you described, it would be more correct to use resource types (`PackedScene` and `GDScript`) instead of file extensions.","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3405718883/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3405793741","html_url":"https://github.com/godotengine/godot/pull/111074#issuecomment-3405793741","issue_url":"https://api.github.com/repos/godotengine/godot/issues/111074","id":3405793741,"node_id":"IC_kwDOAO6SJc7LAEnN","user":{"login":"KoBeWi","id":2223172,"node_id":"MDQ6VXNlcjIyMjMxNzI=","avatar_url":"https://avatars.githubusercontent.com/u/2223172?v=4","gravatar_id":"","url":"https://api.github.com/users/KoBeWi","html_url":"https://github.com/KoBeWi","followers_url":"https://api.github.com/users/KoBeWi/followers","following_url":"https://api.github.com/users/KoBeWi/following{/other_user}","gists_url":"https://api.github.com/users/KoBeWi/gists{/gist_id}","starred_url":"https://api.github.com/users/KoBeWi/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/KoBeWi/subscriptions","organizations_url":"https://api.github.com/users/KoBeWi/orgs","repos_url":"https://api.github.com/users/KoBeWi/repos","events_url":"https://api.github.com/users/KoBeWi/events{/privacy}","received_events_url":"https://api.github.com/users/KoBeWi/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-10-15T10:40:54Z","updated_at":"2025-10-15T10:40:54Z","body":"This works, but it's a bit awkward:\r\n```GDScript\r\nvar parser\r\nif path.contains(\"::\"):\r\n\tparser = get_previous_parser(\"gd\")\r\nelse:\r\n\tparser = get_previous_parser(path.get_extension())\r\n```\r\nPackedScene parser gets the other parser using language extension (from Script resource in the scene), but then only forwards path, so I have to find that parser again. It would be much easier if the parsers were able to pass Resource instances, but eh :/\r\n\r\nIf it works...","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3405793741/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3405936805","html_url":"https://github.com/godotengine/godot/pull/111074#issuecomment-3405936805","issue_url":"https://api.github.com/repos/godotengine/godot/issues/111074","id":3405936805,"node_id":"IC_kwDOAO6SJc7LAnil","user":{"login":"dalexeev","id":47700418,"node_id":"MDQ6VXNlcjQ3NzAwNDE4","avatar_url":"https://avatars.githubusercontent.com/u/47700418?v=4","gravatar_id":"","url":"https://api.github.com/users/dalexeev","html_url":"https://github.com/dalexeev","followers_url":"https://api.github.com/users/dalexeev/followers","following_url":"https://api.github.com/users/dalexeev/following{/other_user}","gists_url":"https://api.github.com/users/dalexeev/gists{/gist_id}","starred_url":"https://api.github.com/users/dalexeev/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/dalexeev/subscriptions","organizations_url":"https://api.github.com/users/dalexeev/orgs","repos_url":"https://api.github.com/users/dalexeev/repos","events_url":"https://api.github.com/users/dalexeev/events{/privacy}","received_events_url":"https://api.github.com/users/dalexeev/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-10-15T11:24:23Z","updated_at":"2025-10-15T11:24:23Z","body":"> This works, but it's a bit awkward:\r\n\r\nYou could try using something like:\r\n\r\n```gdscript\r\nconst PATH = \"res://test_built_in_script.tscn::GDScript_tpawx\"\r\nvar resource := load(PATH)\r\nprint(ResourceLoader.get_recognized_extensions_for_type(resource.get_class()))\r\n# Prints: [\"tres\", \"res\", \"gd\", \"gdc\"]\r\n```\r\n\r\nBut as I mentioned above, unfortunately, this is a design flaw in the `EditorTranslationParserPlugin` API. We probably should have relied on the resource type instead of the file extension.","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3405936805/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3405951571","html_url":"https://github.com/godotengine/godot/pull/111074#issuecomment-3405951571","issue_url":"https://api.github.com/repos/godotengine/godot/issues/111074","id":3405951571,"node_id":"IC_kwDOAO6SJc7LArJT","user":{"login":"KoBeWi","id":2223172,"node_id":"MDQ6VXNlcjIyMjMxNzI=","avatar_url":"https://avatars.githubusercontent.com/u/2223172?v=4","gravatar_id":"","url":"https://api.github.com/users/KoBeWi","html_url":"https://github.com/KoBeWi","followers_url":"https://api.github.com/users/KoBeWi/followers","following_url":"https://api.github.com/users/KoBeWi/following{/other_user}","gists_url":"https://api.github.com/users/KoBeWi/gists{/gist_id}","starred_url":"https://api.github.com/users/KoBeWi/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/KoBeWi/subscriptions","organizations_url":"https://api.github.com/users/KoBeWi/orgs","repos_url":"https://api.github.com/users/KoBeWi/repos","events_url":"https://api.github.com/users/KoBeWi/events{/privacy}","received_events_url":"https://api.github.com/users/KoBeWi/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-10-15T11:28:51Z","updated_at":"2025-10-15T11:28:51Z","body":"Yeah I'd rather avoid involving ResourceLoader, as it might make parsing considerably slower. I have hundreds of files to process 🙃\r\nBesides, an array of extensions does not help much, I'd have to try all of them...","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3405951571/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3406032025","html_url":"https://github.com/godotengine/godot/pull/111074#issuecomment-3406032025","issue_url":"https://api.github.com/repos/godotengine/godot/issues/111074","id":3406032025,"node_id":"IC_kwDOAO6SJc7LA-yZ","user":{"login":"dalexeev","id":47700418,"node_id":"MDQ6VXNlcjQ3NzAwNDE4","avatar_url":"https://avatars.githubusercontent.com/u/47700418?v=4","gravatar_id":"","url":"https://api.github.com/users/dalexeev","html_url":"https://github.com/dalexeev","followers_url":"https://api.github.com/users/dalexeev/followers","following_url":"https://api.github.com/users/dalexeev/following{/other_user}","gists_url":"https://api.github.com/users/dalexeev/gists{/gist_id}","starred_url":"https://api.github.com/users/dalexeev/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/dalexeev/subscriptions","organizations_url":"https://api.github.com/users/dalexeev/orgs","repos_url":"https://api.github.com/users/dalexeev/repos","events_url":"https://api.github.com/users/dalexeev/events{/privacy}","received_events_url":"https://api.github.com/users/dalexeev/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-10-15T11:53:46Z","updated_at":"2025-10-15T11:53:46Z","body":"> Besides, an array of extensions does not help much, I'd have to try all of them...\r\n\r\nI agree that this isn't good. But it depends on your goals.\r\n\r\n* If you're creating a utility specifically for your project, you know exactly its structure and the plugins you use.\r\n* If you're creating a project-agnostic addon, things are more complicated, but you can use roughly the following logic:\r\n  * The `tres` and `res` extensions are universal and should be considered last, if a parser is registered for them.\r\n  * `res` is a binary resource that is not typically used in projects for VCS-friendliness reasons, so `res` should probably be considered later than `tres`.\r\n  * For the remaining extensions, you can find overlap with the set of supported extensions:\r\n\r\n```gdscript\r\nprint(EditorTranslationParserPlugin.get_all_recognized_extensions())\r\n# [\"gd\", \"tscn\", \"res\", \"scn\", \"dae\", \"obj\", \"escn\", \"fbx\", \"gltf\", \"glb\", \"blend\"]\r\n```\r\n\r\nYou'll likely only get one extension. If not, then yes, you will have to choose one of the extensions and which parser to pass its processing to (although it may turn out that all of these extensions are processed by the same parser). However, this primarily only applies to unknown resource types and extensions. For the `GDScript` resource type, you can essentially hardcode the extension to always be `\"gd\"`.\r\n\r\n> Yeah I'd rather avoid involving ResourceLoader, as it might make parsing considerably slower. I have hundreds of files to process\r\n\r\nI haven't worked with very large projects, but I think you're overstating the importance of performance in this case. Translation plugins are executed quite infrequently, it's not a real-time task, so a few seconds or even a few tens of seconds isn't that long.\r\n\r\nAn alternative is to break compatibility further and introduce a new required virtual method `_get_recognized_types()` instead of `_get_recognized_extensions()`.","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3406032025/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3406049209","html_url":"https://github.com/godotengine/godot/pull/111074#issuecomment-3406049209","issue_url":"https://api.github.com/repos/godotengine/godot/issues/111074","id":3406049209,"node_id":"IC_kwDOAO6SJc7LBC-5","user":{"login":"KoBeWi","id":2223172,"node_id":"MDQ6VXNlcjIyMjMxNzI=","avatar_url":"https://avatars.githubusercontent.com/u/2223172?v=4","gravatar_id":"","url":"https://api.github.com/users/KoBeWi","html_url":"https://github.com/KoBeWi","followers_url":"https://api.github.com/users/KoBeWi/followers","following_url":"https://api.github.com/users/KoBeWi/following{/other_user}","gists_url":"https://api.github.com/users/KoBeWi/gists{/gist_id}","starred_url":"https://api.github.com/users/KoBeWi/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/KoBeWi/subscriptions","organizations_url":"https://api.github.com/users/KoBeWi/orgs","repos_url":"https://api.github.com/users/KoBeWi/repos","events_url":"https://api.github.com/users/KoBeWi/events{/privacy}","received_events_url":"https://api.github.com/users/KoBeWi/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-10-15T11:59:12Z","updated_at":"2025-10-15T11:59:12Z","body":"> An alternative is to break compatibility further and introduce a new required virtual method _get_recognized_types() instead of _get_recognized_extensions().\r\n\r\nWe could have both methods and require either of them (so e.g. you could return only extensions and empty array for types and they'd be unused). Although that's something for a separate proposal and not that important, if it can be worked around.","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3406049209/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3409099227","html_url":"https://github.com/godotengine/godot/pull/111074#issuecomment-3409099227","issue_url":"https://api.github.com/repos/godotengine/godot/issues/111074","id":3409099227,"node_id":"IC_kwDOAO6SJc7LMrnb","user":{"login":"dalexeev","id":47700418,"node_id":"MDQ6VXNlcjQ3NzAwNDE4","avatar_url":"https://avatars.githubusercontent.com/u/47700418?v=4","gravatar_id":"","url":"https://api.github.com/users/dalexeev","html_url":"https://github.com/dalexeev","followers_url":"https://api.github.com/users/dalexeev/followers","following_url":"https://api.github.com/users/dalexeev/following{/other_user}","gists_url":"https://api.github.com/users/dalexeev/gists{/gist_id}","starred_url":"https://api.github.com/users/dalexeev/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/dalexeev/subscriptions","organizations_url":"https://api.github.com/users/dalexeev/orgs","repos_url":"https://api.github.com/users/dalexeev/repos","events_url":"https://api.github.com/users/dalexeev/events{/privacy}","received_events_url":"https://api.github.com/users/dalexeev/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-10-16T04:06:30Z","updated_at":"2025-10-16T04:06:30Z","body":"> I think this seems to be overly complicated.\r\n\r\nI don't quite agree. This PR relies on the fact that the `_parse_file()` callback _already_ exists, and you can add multiple parser plugins simultaneously. While this PR does break compatibility in a minor way (it changes the order in which parsers are processed), it's otherwise quite compatible with the existing approach.\r\n\r\nI can't imagine an alternative that would fix the shortcoming of the existing approach (the inability of multiple custom parsers to process the same files in a chain), solve my problem (eliminate the inconvenient workflow with POT and manual interaction with the UI in the Project Settings, and instead use a tool script that would extract all translatable strings by calling standard parsers), and would not break compatibility in a major way.\r\n\r\n> We could extract the parsing logic away from POT generator and expose that instead.\r\n\r\nCould you briefly describe the API you propose so I can compare it with my approach and KoBeWi's?","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3409099227/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3409243250","html_url":"https://github.com/godotengine/godot/pull/111074#issuecomment-3409243250","issue_url":"https://api.github.com/repos/godotengine/godot/issues/111074","id":3409243250,"node_id":"IC_kwDOAO6SJc7LNOxy","user":{"login":"timothyqiu","id":372476,"node_id":"MDQ6VXNlcjM3MjQ3Ng==","avatar_url":"https://avatars.githubusercontent.com/u/372476?v=4","gravatar_id":"","url":"https://api.github.com/users/timothyqiu","html_url":"https://github.com/timothyqiu","followers_url":"https://api.github.com/users/timothyqiu/followers","following_url":"https://api.github.com/users/timothyqiu/following{/other_user}","gists_url":"https://api.github.com/users/timothyqiu/gists{/gist_id}","starred_url":"https://api.github.com/users/timothyqiu/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/timothyqiu/subscriptions","organizations_url":"https://api.github.com/users/timothyqiu/orgs","repos_url":"https://api.github.com/users/timothyqiu/repos","events_url":"https://api.github.com/users/timothyqiu/events{/privacy}","received_events_url":"https://api.github.com/users/timothyqiu/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-10-16T05:34:36Z","updated_at":"2025-10-16T05:34:36Z","body":"> Could you briefly describe the API you propose so I can compare it with my approach and KoBeWi's?\r\n\r\nMade a proof of concept: #111706","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3409243250/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3409281704","html_url":"https://github.com/godotengine/godot/pull/111074#issuecomment-3409281704","issue_url":"https://api.github.com/repos/godotengine/godot/issues/111074","id":3409281704,"node_id":"IC_kwDOAO6SJc7LNYKo","user":{"login":"dalexeev","id":47700418,"node_id":"MDQ6VXNlcjQ3NzAwNDE4","avatar_url":"https://avatars.githubusercontent.com/u/47700418?v=4","gravatar_id":"","url":"https://api.github.com/users/dalexeev","html_url":"https://github.com/dalexeev","followers_url":"https://api.github.com/users/dalexeev/followers","following_url":"https://api.github.com/users/dalexeev/following{/other_user}","gists_url":"https://api.github.com/users/dalexeev/gists{/gist_id}","starred_url":"https://api.github.com/users/dalexeev/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/dalexeev/subscriptions","organizations_url":"https://api.github.com/users/dalexeev/orgs","repos_url":"https://api.github.com/users/dalexeev/repos","events_url":"https://api.github.com/users/dalexeev/events{/privacy}","received_events_url":"https://api.github.com/users/dalexeev/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-10-16T05:53:52Z","updated_at":"2025-10-16T05:53:52Z","body":"> Made a proof of concept: #111706\r\n\r\nSo, you prefer to do nothing about the fact that multiple custom parsers can be added for the same file extension (and currently the first matching one is taken into account, not the last one)? I thought it was important to fix this shortcoming and add support for parser chaining.","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3409281704/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3409358053","html_url":"https://github.com/godotengine/godot/pull/111074#issuecomment-3409358053","issue_url":"https://api.github.com/repos/godotengine/godot/issues/111074","id":3409358053,"node_id":"IC_kwDOAO6SJc7LNqzl","user":{"login":"timothyqiu","id":372476,"node_id":"MDQ6VXNlcjM3MjQ3Ng==","avatar_url":"https://avatars.githubusercontent.com/u/372476?v=4","gravatar_id":"","url":"https://api.github.com/users/timothyqiu","html_url":"https://github.com/timothyqiu","followers_url":"https://api.github.com/users/timothyqiu/followers","following_url":"https://api.github.com/users/timothyqiu/following{/other_user}","gists_url":"https://api.github.com/users/timothyqiu/gists{/gist_id}","starred_url":"https://api.github.com/users/timothyqiu/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/timothyqiu/subscriptions","organizations_url":"https://api.github.com/users/timothyqiu/orgs","repos_url":"https://api.github.com/users/timothyqiu/repos","events_url":"https://api.github.com/users/timothyqiu/events{/privacy}","received_events_url":"https://api.github.com/users/timothyqiu/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-10-16T06:24:56Z","updated_at":"2025-10-16T06:24:56Z","body":"> So, you prefer to do nothing about the fact that multiple custom parsers can be added for the same file extension?\r\n\r\nYes.\r\n\r\nIf I understand correctly, the main issue addressed by this PR is the difficulty in generating formats other than POT. Parser chaining is one suggested approach to solve the problem, but not the problem itself.\r\n\r\nIf the CSV generator is implemented as a chained parser, it only works when being the last parser in the chain. Otherwise some strings will be missing. So I don't think it's a proper solution.","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3409358053/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3409438636","html_url":"https://github.com/godotengine/godot/pull/111074#issuecomment-3409438636","issue_url":"https://api.github.com/repos/godotengine/godot/issues/111074","id":3409438636,"node_id":"IC_kwDOAO6SJc7LN-es","user":{"login":"dalexeev","id":47700418,"node_id":"MDQ6VXNlcjQ3NzAwNDE4","avatar_url":"https://avatars.githubusercontent.com/u/47700418?v=4","gravatar_id":"","url":"https://api.github.com/users/dalexeev","html_url":"https://github.com/dalexeev","followers_url":"https://api.github.com/users/dalexeev/followers","following_url":"https://api.github.com/users/dalexeev/following{/other_user}","gists_url":"https://api.github.com/users/dalexeev/gists{/gist_id}","starred_url":"https://api.github.com/users/dalexeev/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/dalexeev/subscriptions","organizations_url":"https://api.github.com/users/dalexeev/orgs","repos_url":"https://api.github.com/users/dalexeev/repos","events_url":"https://api.github.com/users/dalexeev/events{/privacy}","received_events_url":"https://api.github.com/users/dalexeev/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-10-16T06:53:48Z","updated_at":"2025-10-16T06:53:48Z","body":"Well, your approach solves my problem, although it's less flexible than the one I proposed. We could simply document that multiple custom parsers for the same extension are not supported and/or add a warning when registering the parser.\r\n\r\nThe only minor issue with the current implementation of your PR is that it requires a full list of files to parse, but doesn't allow retrieving a list of supported extensions (`get_all_recognized_extensions()` in my PR), and passing files with unsupported extensions will result in warning spam. This isn't a problem for a specific project (I know that only `*.tscn` and `*.gd` can contain translatable strings), but it is a problem for a project-agnostic plugin or tool script.","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3409438636/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3514761066","html_url":"https://github.com/godotengine/godot/pull/111074#issuecomment-3514761066","issue_url":"https://api.github.com/repos/godotengine/godot/issues/111074","id":3514761066,"node_id":"IC_kwDOAO6SJc7Rfv9q","user":{"login":"timothyqiu","id":372476,"node_id":"MDQ6VXNlcjM3MjQ3Ng==","avatar_url":"https://avatars.githubusercontent.com/u/372476?v=4","gravatar_id":"","url":"https://api.github.com/users/timothyqiu","html_url":"https://github.com/timothyqiu","followers_url":"https://api.github.com/users/timothyqiu/followers","following_url":"https://api.github.com/users/timothyqiu/following{/other_user}","gists_url":"https://api.github.com/users/timothyqiu/gists{/gist_id}","starred_url":"https://api.github.com/users/timothyqiu/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/timothyqiu/subscriptions","organizations_url":"https://api.github.com/users/timothyqiu/orgs","repos_url":"https://api.github.com/users/timothyqiu/repos","events_url":"https://api.github.com/users/timothyqiu/events{/privacy}","received_events_url":"https://api.github.com/users/timothyqiu/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-11-11T02:50:45Z","updated_at":"2025-11-11T02:50:45Z","body":"I am currently working on improving translation-related APIs for 4.6, integrating POT, CSV, and regular `Translation` objects. This involves some API adjustments, so please wait before resolving conflicts.","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3514761066/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/6077032932","html_url":"https://github.com/godotengine/godot/pull/111074#issuecomment-6077032932","issue_url":"https://api.github.com/repos/godotengine/godot/issues/111074","id":6077032932,"node_id":"IC_kwDOAO6SJc8AAAABajgp5A","user":{"login":"dalexeev","id":47700418,"node_id":"MDQ6VXNlcjQ3NzAwNDE4","avatar_url":"https://avatars.githubusercontent.com/u/47700418?v=4","gravatar_id":"","url":"https://api.github.com/users/dalexeev","html_url":"https://github.com/dalexeev","followers_url":"https://api.github.com/users/dalexeev/followers","following_url":"https://api.github.com/users/dalexeev/following{/other_user}","gists_url":"https://api.github.com/users/dalexeev/gists{/gist_id}","starred_url":"https://api.github.com/users/dalexeev/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/dalexeev/subscriptions","organizations_url":"https://api.github.com/users/dalexeev/orgs","repos_url":"https://api.github.com/users/dalexeev/repos","events_url":"https://api.github.com/users/dalexeev/events{/privacy}","received_events_url":"https://api.github.com/users/dalexeev/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-10-09T08:07:59Z","updated_at":"2026-10-09T08:07:59Z","body":"I have no desire to continue working on this PR. Feel free to use it as a basis (crediting me as a co-author) if you wish.","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/6077032932/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null}]