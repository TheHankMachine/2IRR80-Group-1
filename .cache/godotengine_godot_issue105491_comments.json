[{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2813129369","html_url":"https://github.com/godotengine/godot/issues/105491#issuecomment-2813129369","issue_url":"https://api.github.com/repos/godotengine/godot/issues/105491","id":2813129369,"node_id":"IC_kwDOAO6SJc6nrPKZ","user":{"login":"bruvzg","id":7645683,"node_id":"MDQ6VXNlcjc2NDU2ODM=","avatar_url":"https://avatars.githubusercontent.com/u/7645683?v=4","gravatar_id":"","url":"https://api.github.com/users/bruvzg","html_url":"https://github.com/bruvzg","followers_url":"https://api.github.com/users/bruvzg/followers","following_url":"https://api.github.com/users/bruvzg/following{/other_user}","gists_url":"https://api.github.com/users/bruvzg/gists{/gist_id}","starred_url":"https://api.github.com/users/bruvzg/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/bruvzg/subscriptions","organizations_url":"https://api.github.com/users/bruvzg/orgs","repos_url":"https://api.github.com/users/bruvzg/repos","events_url":"https://api.github.com/users/bruvzg/events{/privacy}","received_events_url":"https://api.github.com/users/bruvzg/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-04-17T14:28:48Z","updated_at":"2025-04-17T14:35:14Z","body":"This is macOS security feature. You need to allow screen recording in the system settings.\n\n<img width=\"730\" alt=\"Image\" src=\"https://github.com/user-attachments/assets/851489a8-239f-4f45-967f-f7ea2bb978e4\" />\n\nOpen “System Setting”, select “Privacy & Security” → “Screen & System Audio Recording”. If Godot is already in the list, and you have recently updated it, remove it first with “-” button (usually only needed it you have multiple versions at the same time), then add it with “+”. Restart Godot if it is running. Next time you use color picker a pop-up will show asking you to allow it (it will pop up again every few months), once it is allowed color picker will work.","author_association"