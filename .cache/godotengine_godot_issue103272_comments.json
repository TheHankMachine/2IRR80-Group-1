.com/users/DannyDevSe/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/DannyDevSe/subscriptions","organizations_url":"https://api.github.com/users/DannyDevSe/orgs","repos_url":"https://api.github.com/users/DannyDevSe/repos","events_url":"https://api.github.com/users/DannyDevSe/events{/privacy}","received_events_url":"https://api.github.com/users/DannyDevSe/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-02-28T11:08:15Z","updated_at":"2025-02-28T11:08:44Z","body":"> This needs to be added to the documentation to avoid confusion.\n\nIt should really place on the selected frame and not where you right click with the mouse. It's likely this will get reported again by others who think its a bug.","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2690368769/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2692167434","html_url":"https://github.com/godotengine/godot/issues/103272#issuecomment-2692167434","issue_url":"https://api.github.com/repos/godotengine/godot/issues/103272","id":2692167434,"node_id":"IC_kwDOAO6SJc6gdzcK","user":{"login":"TokageItLab","id":61938263,"node_id":"MDQ6VXNlcjYxOTM4MjYz","avatar_url":"https://avatars.githubusercontent.com/u/61938263?v=4","gravatar_id":"","url":"https://api.github.com/users/TokageItLab","html_url":"https://github.com/TokageItLab","followers_url":"https://api.github.com/users/TokageItLab/followers","following_url":"https://api.github.com/users/TokageItLab/following{/other_user}","gists_url":"https://api.github.com/users/TokageItLab/gists{/gist_id}","starred_url":"https://api.github.com/users/TokageItLab/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/TokageItLab/subscriptions","organizations_url":"https://api.github.com/users/TokageItLab/orgs","repos_url":"https://api.github.com/users/TokageItLab/repos","events_url":"https://api.github.com/users/TokageItLab/events{/privacy}","received_events_url":"https://api.github.com/users/TokageItLab/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-03-01T11:54:01Z","updated_at":"2025-03-01T12:01:15Z","body":"No, this behavior applies to keys as well, so the marker implementation is consistent and not a bug. If you want to insert key/marker to the timeline cursor position, then you should make a proposal like \"add an option to add a key/marker to the current time\".\n\nBTW I don't have any particular reason to object to the addition of that option, so if anyone wants to implement it, please work on it and we should be able to review it IMO.","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2692167434/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2696086009","html_url":"https://github.com/godotengine/godot/issues/103272#issuecomment-2696086009","issue_url":"https://api.github.com/repos/godotengine/godot/issues/103272","id":2696086009,"node_id":"IC_kwDOAO6SJc6gswH5","user":{"login":"Carbonyte","id":18756667,"node_id":"MDQ6VXNlcjE4NzU2NjY3","avatar_url":"https://avatars.githubusercontent.com/u/18756667?v=4","gravatar_id":"","url":"https://api.github.com/users/Carbonyte","html_url":"https://github.com/Carbonyte","followers_url":"https://api.github.com/users/Carbonyte/followers","following_url":"https://api.github.com/users/Carbonyte/following{/other_user}","gists_url":"https://api.github.com/users/Carbonyte/gists{/gist_id}","starred_url":"https://api.github.com/users/Carbonyte/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Carbonyte/subscriptions","organizations_url":"https://api.github.com/users/Carbonyte/orgs","repos_url":"https://api.github.com/users/Carbonyte/repos","events_url":"https://api.github.com/users/Carbonyte/events{/privacy}","received_events_url":"https://api.github.com/users/Carbonyte/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-03-04T03:24:35Z","updated_at":"2025-03-04T04:23:00Z","body":"I started work on this and made a basic proof of concept.\n\nhttps://github.com/user-attachments/assets/1f66cc15-5e0a-4774-bd04-c5ed2c48dd11\n\nBefore going any further though I wanted to ask for feedback about the interface design. I came up with a few options:\n- A toggle in the context menu, as shown in the video.\n- A separate option in the context menu.\n- Snap to the play position if you right-click near it, otherwise use cursor position.\n- A global option in editor settings.\n- A toggle button located somewhere else on the editor interface.\n\nThese options aren't all mutually exclusive. The current state of the toggle could be stored in an editor setting with a button for convenience, for example. The snapping idea could also be implemented alongside other options.\n\nRegarding the keybinding, the \"M\" key is already used to toggle the \"Show All Marker Names\" option. Not sure what other key would be best here -- maybe I for insert marker and K for insert key? The shift modifier could also be used to toggle whether to insert on cursor or on play position.\n\nIf anyone could chime in with thoughts about which options would be best that would be appreciated.","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2696086009/reactions","total_count":3,"+1":3,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2696198840","html_url":"https://github.com/godotengine/godot/issues/103272#issuecomment-2696198840","issue_url":"https://api.github.com/repos/godotengine/godot/issues/103272","id":2696198840,"node_id":"IC_kwDOAO6SJc6gtLq4","user":{"login":"DannyDevSe","id":102230735,"node_id":"U_kgDOBhfqzw","avatar_url":"https://avatars.githubusercontent.com/u/102230735?v=4","gravatar_id":"","url":"https://api.github.com/users/DannyDevSe","html_url":"https://github.com/DannyDevSe","followers_url":"https://api.github.com/users/DannyDevSe/followers","following_url":"https://api.github.com/users/DannyDevSe/following{/other_user}","gists_url":"https://api.github.com/users/DannyDevSe/gists{/gist_id}","starred_url":"https://api.github.com/users/DannyDevSe/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/DannyDevSe/subscriptions","organizations_url":"https://api.github.com/users/DannyDevSe/orgs","repos_url":"https://api.github.com/users/DannyDevSe/repos","events_url":"https://api.github.com/users/DannyDevSe/events{/privacy}","received_events_url":"https://api.github.com/users/DannyDevSe/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-03-04T04:55:20Z","updated_at":"2025-03-04T04:55:20Z","body":"> I started work on this and made a basic proof of concept.\n\n- I think it should always place at the play position to avoid confusion. Maybe a right click toggle to disable it.\n- The key binding (\"M\") should be for placing a maker and not for showing their names. \n- Show all names should be a toggle when right-clicking instead.","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2696198840/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2698452637","html_url":"https://github.com/godotengine/godot/issues/103272#issuecomment-2698452637","issue_url":"https://api.github.com/repos/godotengine/godot/issues/103272","id":2698452637,"node_id":"IC_kwDOAO6SJc6g1x6d","user":{"login":"TokageItLab","id":61938263,"node_id":"MDQ6VXNlcjYxOTM4MjYz","avatar_url":"https://avatars.githubusercontent.com/u/61938263?v=4","gravatar_id":"","url":"https://api.github.com/users/TokageItLab","html_url":"https://github.com/TokageItLab","followers_url":"https://api.github.com/users/TokageItLab/followers","following_url":"https://api.github.com/users/TokageItLab/following{/other_user}","gists_url":"https://api.github.com/users/TokageItLab/gists{/gist_id}","starred_url":"https://api.github.com/users/TokageItLab/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/TokageItLab/subscriptions","organizations_url":"https://api.github.com/users/TokageItLab/orgs","repos_url":"https://api.github.com/users/TokageItLab/repos","events_url":"https://api.github.com/users/TokageItLab/events{/privacy}","received_events_url":"https://api.github.com/users/TokageItLab/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-03-04T17:47:18Z","updated_at":"2025-03-04T17:50:03Z","body":"I think the way is one of the following two:\n\n1. Two key buttons lined up on top of each other without toggling. In that case, in addition to the shortcut for the Insert Animation Key `K` key, we would add a shortcut `Shift + K` for Insert Animation Key on Current Time.\n\n![Image](https://github.com/user-attachments/assets/f05d1197-7ea7-4bf7-9d85-17bf8b6404fd)\n\n2. Place the icon as toggle button at the bottom of the AnimationPlayerEditor. It should probably be around to the left of the snap key. For example, the following toggle key would be prepared and inserted into the cursor position when true. Default is `true` for compatibility, but should probably store the previous state somewhere for those who want to keep it off all the time.\n\n![Image](https://github.com/user-attachments/assets/cd0eae45-3e35-4051-a598-11e5f3029b75)\n\n[CursorKey.zip](https://github.com/user-attachments/files/19075304/CursorKey.zip)\n\n![Image](https://github.com/user-attachments/assets/0667a415-8117-41df-96cd-c7b7f30d66fb)\n\n","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2698452637/reactions","total_count":3,"+1":3,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2781110364","html_url":"https://github.com/godotengine/godot/issues/103272#issuecomment-2781110364","issue_url":"https://api.github.com/repos/godotengine/godot/issues/103272","id":2781110364,"node_id":"IC_kwDOAO6SJc6lxGBc","user":{"login":"fredguevs","id":97917125,"node_id":"U_kgDOBdYYxQ","avatar_url":"https://avatars.githubusercontent.com/u/97917125?v=4","gravatar_id":"","url":"https://api.github.com/users/fredguevs","html_url":"https://github.com/fredguevs","followers_url":"https://api.github.com/users/fredguevs/followers","following_url":"https://api.github.com/users/fredguevs/following{/other_user}","gists_url":"https://api.github.com/users/fredguevs/gists{/gist_id}","starred_url":"https://api.github.com/users/fredguevs/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/fredguevs/subscriptions","organizations_url":"https://api.github.com/users/fredguevs/orgs","repos_url":"https://api.github.com/users/fredguevs/repos","events_url":"https://api.github.com/users/fredguevs/events{/privacy}","received_events_url":"https://api.github.com/users/fredguevs/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-04-05T22:04:01Z","updated_at":"2025-04-05T22:04:01Z","body":"Hi! I’m a student contributor working on an open source software engineering assignment and I’d 