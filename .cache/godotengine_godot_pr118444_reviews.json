[{"id":4094805351,"node_id":"PRR_kwDOAO6SJc70EcVn","user":{"login":"Ivorforce","id":2308167,"node_id":"MDQ6VXNlcjIzMDgxNjc=","avatar_url":"https://avatars.githubusercontent.com/u/2308167?u=f7f8e0273f784f5ec6f6b7fe4a88d449896eb48a&v=4","gravatar_id":"","url":"https://api.github.com/users/Ivorforce","html_url":"https://github.com/Ivorforce","followers_url":"https://api.github.com/users/Ivorforce/followers","following_url":"https://api.github.com/users/Ivorforce/following{/other_user}","gists_url":"https://api.github.com/users/Ivorforce/gists{/gist_id}","starred_url":"https://api.github.com/users/Ivorforce/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Ivorforce/subscriptions","organizations_url":"https://api.github.com/users/Ivorforce/orgs","repos_url":"https://api.github.com/users/Ivorforce/repos","events_url":"https://api.github.com/users/Ivorforce/events{/privacy}","received_events_url":"https://api.github.com/users/Ivorforce/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"While i understand the notion, I'm not sure we can merge this change.\r\n\r\nCurrently we just treat freed objects as `nil` (at least for `==`). With this change, we would treat freed objects as \"tombstones with an ID\". This is a major semantic change that might lead to problems all over people's projects.\r\n\r\nI think we'll have to solve https://github.com/godotengine/godot/issues/118422 differently to avoid regressions.","state":"DISMISSED","html_url":"https://github.com/godotengine/godot/pull/118444#pullrequestreview-4094805351","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/118444","author_association":"MEMBER","_links":{"html":{"href":"https://github.com/godotengine/godot/pull/118444#pullrequestreview-4094805351"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/118444"}},"submitted_at":"2026-04-12T08:17:23Z","commit_id":"3e483ec58059bbe3682bfe097b51a7ad8ea98bad"}]