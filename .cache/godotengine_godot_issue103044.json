godot/pull/103044.patch","merged_at":"2025-03-11T02:06:22Z"},"body":"Replaces SurfaceUpgradeTool and UIDUpgradeTool with a universal ProjectUpgradeTool.\r\n\r\n![image](https://github.com/user-attachments/assets/27e73a8f-c377-420e-9663-49bbb6fc27b5)\r\n\r\nIt reimports everything (to update .import files), re-saves scenes (by opening them in the editor, because apparently it makes difference) and re-saves resources. Also deletes UID cache for good measure.\r\n\r\nThe implementation is a bit simpler from previous tools; there is no singleton and no custom dialog type.","closed_by":{"login":"Repiteo","id":17489292,"node_id":"MDQ6VXNlcjE3NDg5Mjky","avatar_url":"https://avatars.githubusercontent.com/u/17489292?v=4","gravatar_id":"","url":"https://api.github.com/users/Repiteo","html_url":"https://github.com/Repiteo","followers_url":"https://api.github.com/users/Repiteo/followers","following_url":"https://api.github.com/users/Repiteo/following{/other_user}","gists_url":"https://api.github.com/users/Repiteo/gists{/gist_id}","starred_url":"https://api.github.com/users/Repiteo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Repiteo/subscriptions","organizations_url":"https://api.github.com/users/Repiteo/orgs","repos_url":"https://api.github.com/users/Repiteo/repos","events_url":"https://api.github.com/users/Repiteo/events{/privacy}","received_events_url":"https://api.github.com/users/Repiteo/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/103044/reactions","total_count":19,"+1":13,"-1":0,"laugh":0,"hooray":3,"confused":0,"heart":3,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/godotengine/godot/issues/103044/timeline","performed_via_github_app":null,"state_reason":null}