archived_by":null},{"id":2666708059,"node_id":"MDU6TGFiZWwyNjY2NzA4MDU5","url":"https://api.github.com/repos/godotengine/godot/labels/topic:2d","name":"topic:2d","color":"ffee88","default":false,"description":"","archived_at":null,"archived_by":null}],"state":"open","locked":false,"assignees":[],"milestone":null,"comments":2,"created_at":"2025-03-24T16:00:10Z","updated_at":"2025-03-24T18:38:36Z","closed_at":null,"assignee":null,"author_association":"NONE","issue_field_values":[],"type":null,"active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"### Tested versions\n\n4.4\n\n### System information\n\nwindows 10, godot 4.4, gtx 3070 ti\n\n### Issue description\n\nWhen adding a tile to a tileset, and then a shader material to that tile, it'll cause the shader to be slightly sized up compared to what it should be.\n\n### Steps to reproduce\n\n- Create a tile set\n- add a material\n- add a shader\n- create a uniform sampler2D for a texture\n- set COLOR = texture \n\n### Minimal reproduction project (MRP)\n\n[MRP.zip](https://github.com/user-attachments/files/19433268/MRP.zip)\nIt's difficult to see, toggle the COLOR = texture line in the shader to see more clearily the difference in scale. ","closed_by":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/104557/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/godotengine/godot/issues/104557/timeline","performed_via_github_app":null,"state_reason":null,"pinned_comment":null}