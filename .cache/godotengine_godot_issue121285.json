ault":false,"description":"","archived_at":null,"archived_by":null},{"id":279128044,"node_id":"MDU6TGFiZWwyNzkxMjgwNDQ=","url":"https://api.github.com/repos/godotengine/godot/labels/confirmed","name":"confirmed","color":"aaddaa","default":false,"description":"","archived_at":null,"archived_by":null},{"id":2666708289,"node_id":"MDU6TGFiZWwyNjY2NzA4Mjg5","url":"https://api.github.com/repos/godotengine/godot/labels/topic:3d","name":"topic:3d","color":"ffee88","default":false,"description":"","archived_at":null,"archived_by":null}],"state":"closed","locked":false,"assignees":[],"milestone":{"url":"https://api.github.com/repos/godotengine/godot/milestones/25","html_url":"https://github.com/godotengine/godot/milestone/25","labels_url":"https://api.github.com/repos/godotengine/godot/milestones/25/labels","id":15520464,"node_id":"MI_kwDOAO6SJc4A7NLQ","number":25,"title":"4.8","description":"","creator":{"login":"Repiteo","id":17489292,"node_id":"MDQ6VXNlcjE3NDg5Mjky","avatar_url":"https://avatars.githubusercontent.com/u/17489292?v=4","gravatar_id":"","url":"https://api.github.com/users/Repiteo","html_url":"https://github.com/Repiteo","followers_url":"https://api.github.com/users/Repiteo/followers","following_url":"https://api.github.com/users/Repiteo/following{/other_user}","gists_url":"https://api.github.com/users/Repiteo/gists{/gist_id}","starred_url":"https://api.github.com/users/Repiteo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Repiteo/subscriptions","organizations_url":"https://api.github.com/users/Repiteo/orgs","repos_url":"https://api.github.com/users/Repiteo/repos","events_url":"https://api.github.com/users/Repiteo/events{/privacy}","received_events_url":"https://api.github.com/users/Repiteo/received_events","type":"User","user_view_type":"public","site_admin":false},"open_issues":343,"closed_issues":2335,"state":"open","created_at":"2026-04-13T15:59:35Z","updated_at":"2026-10-22T06:28:22Z","due_on":null,"closed_at":null},"comments":7,"created_at":"2026-07-12T15:30:48Z","updated_at":"2026-08-04T16:52:32Z","closed_at":"2026-08-04T16:52:32Z","assignee":null,"author_association":"NONE","issue_field_values":[],"type":null,"active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"### Tested Versions\n\nThe bug is reproducible in the official 4.7.stable release\n\n### System Information\n\nGodot v4.7.stable - Windows 11 Pro (build 26200) - Vulkan (Forward+) - dedicated NVIDIA GeForce RTX 4070 Ti (NVIDIA; 32.0.15.9621) - 11th Gen Intel(R) Core(TM) i9-11900K @ 3.50GHz (16 threads) - 31.87 GiB memory\n\n### Issue description\n\nWhen sending a ray tracing pipeline via RenderingDevice (API version 4.7 from #99119), the push constant set for the ray tracing list is validated and accepted on the CPU side, but the raygen shader reads only zeros from the `push_constant` block.\n\nThe same data, loaded as a UBO via a uniform set, works correctly, so the shader/pipeline itself is working properly—only the push constant path is not working. There is issue #113583 (checking 128-bit push constant filling in the compute module), but my case is different: my block is correctly filled and accepted without errors, but its contents are zero during shader execution.\n\nThe GDScript ray tracing demo does not use push constants in `raygen`.\n\n### Steps to Reproduce\n\n1. Open MRP (a shortened version of Fahien’s GDScript ray tracing demo).\n2. The raygen shader declares `layout(push_constant, std430) uniform Pc { vec4 tint; } pc;` and multiplies the output color by `pc.tint`.\n3. The script sets the push constant to `(1.0, 1.0, 1.0, 1.0)` before dispatching.\n4. Expected result: a green triangle. Actual result: black—the block reads zeros.\n5. Change the value of the `USE_UBO` constant in the script (same data via UBO): a green triangle appears.\n\n### Minimal reproduction project (MRP)\n\n[push_constants_mrp.zip](https://github.com/user-attachments/files/29941694/push_constants_mrp.zip)","closed_by":{"login":"Repiteo","id":17489292,"node_id":"MDQ6VXNlcjE3NDg5Mjky","avatar_url":"https://avatars.githubusercontent.com/u/17489292?v=4","gravatar_id":"","url":"https://api.github.com/users/Repiteo","html_url":"https://github.com/Repiteo","followers_url":"https://api.github.com/users/Repiteo/followers","following_url":"https://api.github.com/users/Repiteo/following{/other_user}","gists_url":"https://api.github.com/users/Repiteo/gists{/gist_id}","starred_url":"https://api.github.com/users/Repiteo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Repiteo/subscriptions","organizations_url":"https://api.github.com/users/Repiteo/orgs","repos_url":"https://api.github.com/users/Repiteo/repos","events_url":"https://api.github.com/users/Repiteo/events{/privacy}","received_events_url":"https://api.github.com/users/Repiteo/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/121285/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/godotengine/godot/issues/121285/timeline","performed_via_github_app":null,"state_reason":"completed","pinned_comment":null}