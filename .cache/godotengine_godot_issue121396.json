ached project.  Make sure the my_plugin addon is enabled.  Check the top of the screen where the different editor windows are listed and notice that the added `Main Screen Plugin` window is not there.  Also notice that the message `Subplugin enabled` from `my_main_screen_plugin.gd, line 10`  is not printed to console.\n\n### Minimal reproduction project (MRP)\n\n[sub-plugin-debugging.zip](https://github.com/user-attachments/files/30036240/sub-plugin-debugging.zip)","closed_by":{"login":"blackears","id":6724608,"node_id":"MDQ6VXNlcjY3MjQ2MDg=","avatar_url":"https://avatars.githubusercontent.com/u/6724608?v=4","gravatar_id":"","url":"https://api.github.com/users/blackears","html_url":"https://github.com/blackears","followers_url":"https://api.github.com/users/blackears/followers","following_url":"https://api.github.com/users/blackears/following{/other_user}","gists_url":"https://api.github.com/users/blackears/gists{/gist_id}","starred_url":"https://api.github.com/users/blackears/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/blackears/subscriptions","organizations_url":"https://api.github.com/users/blackears/orgs","repos_url":"https://api.github.com/users/blackears/repos","events_url":"https://api.github.com/users/blackears/events{/privacy}","received_events_url":"https://api.github.com/users/blackears/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/121396/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/godotengine/godot/issues/121396/timeline","performed_via_github_app":null,"state_reason":"completed","pinned_comment":null}