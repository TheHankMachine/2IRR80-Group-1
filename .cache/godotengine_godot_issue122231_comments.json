[{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5240645853","html_url":"https://github.com/godotengine/godot/issues/122231#issuecomment-5240645853","issue_url":"https://api.github.com/repos/godotengine/godot/issues/122231","id":5240645853,"node_id":"IC_kwDOAO6SJc8AAAABOF3o3Q","user":{"login":"AThousandShips","id":96648715,"node_id":"U_kgDOBcK-Cw","avatar_url":"https://avatars.githubusercontent.com/u/96648715?v=4","gravatar_id":"","url":"https://api.github.com/users/AThousandShips","html_url":"https://github.com/AThousandShips","followers_url":"https://api.github.com/users/AThousandShips/followers","following_url":"https://api.github.com/users/AThousandShips/following{/other_user}","gists_url":"https://api.github.com/users/AThousandShips/gists{/gist_id}","starred_url":"https://api.github.com/users/AThousandShips/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/AThousandShips/subscriptions","organizations_url":"https://api.github.com/users/AThousandShips/orgs","repos_url":"https://api.github.com/users/AThousandShips/repos","events_url":"https://api.github.com/users/AThousandShips/events{/privacy}","received_events_url":"https://api.github.com/users/AThousandShips/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-08-10T13:02:26Z","updated_at":"2026-08-10T13:02:26Z","body":"In what way is this a bug with existing functionality? AFAIK there is no support for metadata for scenes so naturally the editor is not going to handle them or recognize them","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5240645853/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5241057437","html_url":"https://github.com/godotengine/godot/issues/122231#issuecomment-5241057437","issue_url":"https://api.github.com/repos/godotengine/godot/issues/122231","id":5241057437,"node_id":"IC_kwDOAO6SJc8AAAABOGQwnQ","user":{"login":"leandro-benedet-garcia","id":291051,"node_id":"MDQ6VXNlcjI5MTA1MQ==","avatar_url":"https://avatars.githubusercontent.com/u/291051?v=4","gravatar_id":"","url":"https://api.github.com/users/leandro-benedet-garcia","html_url":"https://github.com/leandro-benedet-garcia","followers_url":"https://api.github.com/users/leandro-benedet-garcia/followers","following_url":"https://api.github.com/users/leandro-benedet-garcia/following{/other_user}","gists_url":"https://api.github.com/users/leandro-benedet-garcia/gists{/gist_id}","starred_url":"https://api.github.com/users/leandro-benedet-garcia/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/leandro-benedet-garcia/subscriptions","organizations_url":"https://api.github.com/users/leandro-benedet-garcia/orgs","repos_url":"https://api.github.com/users/leandro-benedet-garcia/repos","events_url":"https://api.github.com/users/leandro-benedet-garcia/events{/privacy}","received_events_url":"https://api.github.com/users/leandro-benedet-garcia/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-08-10T13:38:28Z","updated_at":"2026-08-10T13:38:28Z","body":"> In what way is this a bug with existing functionality? AFAIK there is no support for metadata for scenes so naturally the editor is not going to handle them or recognize them\n\nYou can save metadata and custom scenes in binary format in stable/main branch trough scripting, you can also load them perfectly fine. So there is support for metadata, just in the binary format, not text. (yeah, it's confusing)\nHowever, if you open them in the editor and then save the scene, trough the editor by pressing ctrl+s or trough the UI, that metadata and any type information related to custom scenes will be lost.\n\nMy PR add the functionality of metadata in text formats, to give feature parity with binary format. This same bug, described in this issue happens in my PR (of the editor removing metadata and custom scene type information), so it's a separate issue from our issue of binary formats being able to do more than text format.\n\nSorry for not being clear. It's hard to explain, it was a rabbit hole trying to figure out what worked exactly an what not.","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5241057437/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5241084039","html_url":"https://github.com/godotengine/godot/issues/122231#issuecomment-5241084039","issue_url":"https://api.github.com/repos/godotengine/godot/issues/122231","id":5241084039,"node_id":"IC_kwDOAO6SJc8AAAABOGSYhw","user":{"login":"AThousandShips","id":96648715,"node_id":"U_kgDOBcK-Cw","avatar_url":"https://avatars.githubusercontent.com/u/96648715?v=4","gravatar_id":"","url":"https://api.github.com/users/AThousandShips","html_url":"https://github.com/AThousandShips","followers_url":"https://api.github.com/users/AThousandShips/followers","following_url":"https://api.github.com/users/AThousandShips/following{/other_user}","gists_url":"https://api.github.com/users/AThousandShips/gists{/gist_id}","starred_url":"https://api.github.com/users/AThousandShips/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/AThousandShips/subscriptions","organizations_url":"https://api.github.com/users/AThousandShips/orgs","repos_url":"https://api.github.com/users/AThousandShips/repos","events_url":"https://api.github.com/users/AThousandShips/events{/privacy}","received_events_url":"https://api.github.com/users/AThousandShips/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-08-10T13:40:54Z","updated_at":"2026-08-10T13:40:54Z","body":"What I'm saying is that the editor doesn't support metadata on scenes, you can do various other changes to files through scripting that the editor doesn't cover or handle correctly because they're not supported\n\nAnd as long as metadata isn't supported on text scenes this isn't supported so I'd say it isn't expected to work until then (it'd be far more confusing if it worked in some cases but not others)","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5241084039/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5241293522","html_url":"https://github.com/godotengine/godot/issues/122231#issuecomment-5241293522","issue_url":"https://api.github.com/repos/godotengine/godot/issues/122231","id":5241293522,"node_id":"IC_kwDOAO6SJc8AAAABOGfK0g","user":{"login":"leandro-benedet-garcia","id":291051,"node_id":"MDQ6VXNlcjI5MTA1MQ==","avatar_url":"https://avatars.githubusercontent.com/u/291051?v=4","gravatar_id":"","url":"https://api.github.com/users/leandro-benedet-garcia","html_url":"https://github.com/leandro-benedet-garcia","followers_url":"https://api.github.com/users/leandro-benedet-garcia/followers","following_url":"https://api.github.com/users/leandro-benedet-garcia/following{/other_user}","gists_url":"https://api.github.com/users/leandro-benedet-garcia/gists{/gist_id}","starred_url":"https://api.github.com/users/leandro-benedet-garcia/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/leandro-benedet-garcia/subscriptions","organizations_url":"https://api.github.com/users/leandro-benedet-garcia/orgs","repos_url":"https://api.github.com/users/leandro-benedet-garcia/repos","events_url":"https://api.github.com/users/leandro-benedet-garcia/events{/privacy}","received_events_url":"https://api.github.com/users/leandro-benedet-garcia/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-08-10T13:59:39Z","updated_at":"2026-08-10T13:59:39Z","body":"> What I'm saying is that the editor doesn't support metadata on scenes, you can do various other changes to files through scripting that the editor doesn't cover or handle correctly because they're not supported\n\nI don't mean editing the file directly or anything of the sort, I mean that our parsers are able to handle metadata perfectly fine (granted, just for binary format). But something in the editor is just outright not keeping data in it contained, when it should just leave it be, it doesn't error nor anything. It just removes the data outright. And anything that doesn't keep data in software, in at least my opinion, is a bug.\n\n> And as long as metadata isn't supported on text scenes this isn't supported so I'd say it isn't expected to work until then (it'd be far more confusing if it worked in some cases but not others)\n\nIf you have metadata, in stable, in tscn files (if you did by hand for example, by editing the file directly), it does error, the scene file doesn't even open. (it errors even if using scripting, but alas)\n\nLike a mentioned before, it's a rabbit hole.","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5241293522/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5241407209","html_url":"https://github.com/godotengine/godot/issues/122231#issuecomment-5241407209","issue_url":"https://api.github.com/repos/godotengine/godot/issues/122231","id":5241407209,"node_id":"IC_kwDOAO6SJc8AAAABOGmG6Q","user":{"login":"AThousandShips","id":96648715,"node_id":"U_kgDOBcK-Cw","avatar_url":"https://avatars.githubusercontent.com/u/96648715?v=4","gravatar_id":"","url":"https://api.github.com/users/AThousandShips","html_url":"https://github.com/AThousandShips","followers_url":"https://api.github.com/users/AThousandShips/followers","following_url":"https://api.github.com/users/AThousandShips/following{/other_user}","gists_url":"https://api.github.com/users/AThousandShips/gists{/gist_id}","starred_url":"https://api.github.com/users/AThousandShips/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/AThousandShips/subscriptions","organizations_url":"https://api.github.com/users/AThousandShips/orgs","repos_url":"https://api.github.com/users/AThousandShips/repos","events_url":"https://api.github.com/users/AThousandShips/events{/privacy}","received_events_url":"https://api.github.com/users/AThousandShips/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-08-10T14:09:19Z","updated_at":"2026-08-10T14:09:19Z","body":"I think you're missing what I'm saying, so I'll try once more:\n\nThe engine does not fully support metadata in scene files, I'm not sure the support for it in binary files is even intentional or if it is an oversight, but I would say the reason the editor does not handle metadata for scenes is that it doesn't expect it nor should it as it isn't supported (partial support notwithstanding)\n\nThe editor discards it as it is not supported, because it isn't expected to, and it would require hacky code to ensure it doesn't accidentally write it incorrectly (or retain broken data, if converting from one format to another)\n\nIt also doesn't have any way to edit that data so it would be confusing an unhelpful\n\nTl;dr; I don't see that the editor not handling unsupported data that it doesn't display anyway is a bug, no different from other data contexts that the editor itself doesn't support\n\nSo until support for metadata in all scene files is added I don't see a reason to change anything, it would just be temporary patching","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5241407209/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5242084040","html_url":"https://github.com/godotengine/godot/issues/122231#issuecomment-5242084040","issue_url":"https://api.github.com/repos/godotengine/godot/issues/122231","id":5242084040,"node_id":"IC_kwDOAO6SJc8AAAABOHPayA","user":{"login":"leandro-benedet-garcia","id":291051,"node_id":"MDQ6VXNlcjI5MTA1MQ==","avatar_url":"https://avatars.githubusercontent.com/u/291051?v=4","gravatar_id":"","url":"https://api.github.com/users/leandro-benedet-garcia","html_url":"https://github.com/leandro-benedet-garcia","followers_url":"https://api.github.com/users/leandro-benedet-garcia/followers","following_url":"https://api.github.com/users/leandro-benedet-garcia/following{/other_user}","gists_url":"https://api.github.com/users/leandro-benedet-garcia/gists{/gist_id}","starred_url":"https://api.github.com/users/leandro-benedet-garcia/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/leandro-benedet-garcia/subscriptions","organizations_url":"https://api.github.com/users/leandro-benedet-garcia/orgs","repos_url":"https://api.github.com/users/leandro-benedet-garcia/repos","events_url":"https://api.github.com/users/leandro-benedet-garcia/events{/privacy}","received_events_url":"https://api.github.com/users/leandro-benedet-garcia/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-08-10T15:04:18Z","updated_at":"2026-08-10T15:04:18Z","body":"> So until support for metadata in all scene files is added I don't see a reason to change anything, it would just be temporary patching\n\nThat's what I actually want to discuss, because I mostly wanted to document that the editor does not keep the data at all. And ask how to move forward.\n\nWith https://github.com/godotengine/godot/pull/121920 approved. Would this issue then be considered a bug in master if/when merged? \nIf yes, should we fix it by outright adding support for editing metadata in the editor? As in, consider https://github.com/godotengine/godot-proposals/issues/15262 a way to bug fix instead of a feature proposal?\n\n> The editor discards it as it is not supported, because it isn't expected to, and it would require hacky code to ensure it doesn't accidentally write it incorrectly (or retain broken data, if converting from one format to another)\n\nI could take a look and make a draft PR to check how to keep the data, without adding the functionality of being able to edit metadata in the editor if/when my PR gets merged. Or you think it would be unnecessary and would be best to just outright add the functionality of making the editor able to edit metadata then.","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5242084040/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5535698130","html_url":"https://github.com/godotengine/godot/issues/122231#issuecomment-5535698130","issue_url":"https://api.github.com/repos/godotengine/godot/issues/122231","id":5535698130,"node_id":"IC_kwDOAO6SJc8AAAABSfQM0g","user":{"login":"leandro-benedet-garcia","id":291051,"node_id":"MDQ6VXNlcjI5MTA1MQ==","avatar_url":"https://avatars.githubusercontent.com/u/291051?v=4","gravatar_id":"","url":"https://api.github.com/users/leandro-benedet-garcia","html_url":"https://github.com/leandro-benedet-garcia","followers_url":"https://api.github.com/users/leandro-benedet-garcia/followers","following_url":"https://api.github.com/users/leandro-benedet-garcia/following{/other_user}","gists_url":"https://api.github.com/users/leandro-benedet-garcia/gists{/gist_id}","starred_url":"https://api.github.com/users/leandro-benedet-garcia/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/leandro-benedet-garcia/subscriptions","organizations_url":"https://api.github.com/users/leandro-benedet-garcia/orgs","repos_url":"https://api.github.com/users/leandro-benedet-garcia/repos","events_url":"https://api.github.com/users/leandro-benedet-garcia/events{/privacy}","received_events_url":"https://api.github.com/users/leandro-benedet-garcia/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-09-04T04:34:08Z","updated_at":"2026-09-04T04:34:08Z","body":"I found out that the editor can in fact edit metadata, this is Godot 4.7.1:\n\nhttps://github.com/user-attachments/assets/f2754664-311e-4992-a6d1-564b72c886ae","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5535698130/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null}]