at":null,"archived_by":null},{"id":2666708289,"node_id":"MDU6TGFiZWwyNjY2NzA4Mjg5","url":"https://api.github.com/repos/godotengine/godot/labels/topic:3d","name":"topic:3d","color":"ffee88","default":false,"description":"","archived_at":null,"archived_by":null}],"state":"closed","locked":false,"assignees":[],"milestone":{"url":"https://api.github.com/repos/godotengine/godot/milestones/22","html_url":"https://github.com/godotengine/godot/milestone/22","labels_url":"https://api.github.com/repos/godotengine/godot/milestones/22/labels","id":12070367,"node_id":"MI_kwDOAO6SJc4AuC3f","number":22,"title":"4.5","description":"","creator":{"login":"Sauermann","id":6299227,"node_id":"MDQ6VXNlcjYyOTkyMjc=","avatar_url":"https://avatars.githubusercontent.com/u/6299227?v=4","gravatar_id":"","url":"https://api.github.com/users/Sauermann","html_url":"https://github.com/Sauermann","followers_url":"https://api.github.com/users/Sauermann/followers","following_url":"https://api.github.com/users/Sauermann/following{/other_user}","gists_url":"https://api.github.com/users/Sauermann/gists{/gist_id}","starred_url":"https://api.github.com/users/Sauermann/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Sauermann/subscriptions","organizations_url":"https://api.github.com/users/Sauermann/orgs","repos_url":"https://api.github.com/users/Sauermann/repos","events_url":"https://api.github.com/users/Sauermann/events{/privacy}","received_events_url":"https://api.github.com/users/Sauermann/received_events","type":"User","user_view_type":"public","site_admin":false},"open_issues":3,"closed_issues":3687,"state":"closed","created_at":"2024-12-19T08:51:28Z","updated_at":"2026-09-04T21:48:38Z","due_on":"2025-09-15T00:00:00Z","closed_at":"2025-09-18T17:13:14Z"},"comments":0,"created_at":"2025-06-03T20:30:10Z","updated_at":"2025-06-05T11:19:31Z","closed_at":"2025-06-05T11:19:22Z","assignee":null,"author_association":"CONTRIBUTOR","issue_field_values":[],"type":null,"active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"### Tested versions\n\nReproducible in 4.4.1-stable.\n\n### System information\n\nSteam Runtime 2 (soldier) 2 on X11 - X11 display driver, Multi-window, 1 monitor - Vulkan (Forward+) - dedicated NVIDIA GeForce GTX 970 (nvidia) - Intel(R) Core(TM) i5-7600K CPU @ 3.80GHz (4 threads)\n\n### Issue description\n\nI'm not sure if this is the same issue as https://github.com/godotengine/godot/issues/44466 but I really do not think that this is desirable behaviour. Somehow it seems that the light energy in the sky is off from the energy in the foreground by a factor of PI?\n\n```DirectionalLight3D``` in light and sky mode with 1.0 energy:\n![Image](https://github.com/user-attachments/assets/543037f6-9c4b-445f-b7e8-251618dfc684)\n\nYou can remove these ugly silhouettes by using two ```DirectionalLight3D```s, one in sky only mode and one in light only mode, and then setting the sky only light's energy to the energy of the light only lights's multiplied by PI.\n\n```DirectionalLight3D``` in light only mode with 1.0 energy + ```DirectionalLight3D``` in sky only mode with PI energy:\n![Image](https://github.com/user-attachments/assets/0051c949-ca08-4e62-ba4c-1bd27d865422)\n\n### Steps to reproduce\n\n- Add ```WorldEnvironment``` with a sky and non-volumetric fog which uses sun scatter.\n- Add ```DirectionalLight3D``` in light and sky mode.\n- Add mesh.\n- Position camera so that mesh is partially / fully covered by fog and in front of sun scatter in sky.\n\n### Minimal reproduction project (MRP)\n\nN/A","closed_by":{"login":"akien-mga","id":4701338,"node_id":"MDQ6VXNlcjQ3MDEzMzg=","avatar_url":"https://avatars.githubusercontent.com/u/4701338?v=4","gravatar_id":"","url":"https://api.github.com/users/akien-mga","html_url":"https://github.com/akien-mga","followers_url":"https://api.github.com/users/aki