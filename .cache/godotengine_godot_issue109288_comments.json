/repo}","subscriptions_url":"https://api.github.com/users/AThousandShips/subscriptions","organizations_url":"https://api.github.com/users/AThousandShips/orgs","repos_url":"https://api.github.com/users/AThousandShips/repos","events_url":"https://api.github.com/users/AThousandShips/events{/privacy}","received_events_url":"https://api.github.com/users/AThousandShips/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-08-04T17:56:30Z","updated_at":"2025-08-04T17:56:30Z","body":"Again this is 4.5 specific, the requirement was added in 4.5, 4.4.1 works without SSE 4.2 (as does x86_32)","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3151825695/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3153742860","html_url":"https://github.com/godotengine/godot/issues/109288#issuecomment-3153742860","issue_url":"https://api.github.com/repos/godotengine/godot/issues/109288","id":3153742860,"node_id":"IC_kwDOAO6SJc67-kwM","user":{"login":"bruvzg","id":7645683,"node_id":"MDQ6VXNlcjc2NDU2ODM=","avatar_url":"https://avatars.githubusercontent.com/u/7645683?v=4","gravatar_id":"","url":"https://api.github.com/users/bruvzg","html_url":"https://github.com/bruvzg","followers_url":"https://api.github.com/users/bruvzg/followers","following_url":"https://api.github.com/users/bruvzg/following{/other_user}","gists_url":"https://api.github.com/users/bruvzg/gists{/gist_id}","starred_url":"https://api.github.com/users/bruvzg/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/bruvzg/subscriptions","organizations_url":"https://api.github.com/users/bruvzg/orgs","repos_url":"https://api.github.com/users/bruvzg/repos","events_url":"https://api.github.com/users/bruvzg/events{/privacy}","received_events_url":"https://api.github.com/users/bruvzg/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-08-05T06:56:21Z","updated_at":"2025-08-05T06:56:21Z","body":"> We could add a check like the one on Windows to Linux but that should be tracked separately\n\nNot sure if we can reliably do this on Linux. It's possible to run code before C-runtime init, but unlike Windows, there is no convenient system API to show the message. And running an external app like other error messages do is not feasible without C-runtime.","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3153742860/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3155896680","html_url":"https://github.com/godotengine/godot/issues/109288#issuecomment-3155896680","issue_url":"https://api.github.com/repos/godotengine/godot/issues/109288","id":3155896680,"node_id":"IC_kwDOAO6SJc68Gylo","user":{"login":"knightmb","id":3860711,"node_id":"MDQ6VXNlcjM4NjA3MTE=","avatar_url":"https://avatars.githubusercontent.com/u/3860711?v=4","gravatar_id":"","url":"https://api.github.com/users/knightmb","html_url":"https://github.com/knightmb","followers_url":"https://api.github.com/users/knightmb/followers","following_url":"https://api.github.com/users/knightmb/following{/other_user}","gists_url":"https://api.github.com/users/knightmb/gists{/gist_id}","starred_url":"https://api.github.com/users/knightmb/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/knightmb/subscriptions","organizations_url":"https://api.github.com/users/knightmb/orgs","repos_url":"https://api.github.com/users/knightmb/repos","events_url":"https://api.github.com/users/knightmb/events{/privacy}","received_events_url":"https://api.github.com/users/knightmb/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-08-05T16:53:46Z","updated_at":"2025-08-05T16:53:46Z","body":"If it just output something to the console like \"SSE4.2 required\", that would be sufficient I think. Not as pretty as a pop up error message, but at least if someone in the future checks the console error output, it won't be a mystery why it didn't work.","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3155896680/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3155916055","html_url":"https://github.com/godotengine/godot/issues/109288#issuecomment-3155916055","issue_url":"https://api.github.com/repos/godotengine/godot/issues/109288","id":3155916055,"node_id":"IC_kwDOAO6SJc68G3UX","user":{"login":"bruvzg","id":7645683,"node_id":"MDQ6VXNlcjc2NDU2ODM=","avatar_url":"https://avatars.githubusercontent.com/u/7645683?v=4","gravatar_id":"","url":"https://api.github.com/users/bruvzg","html_url":"https://github.com/bruvzg","followers_url":"https://api.github.com/users/bruvzg/followers","following_url":"https://api.github.com/users/bruvzg/following{/other_user}","gists_url":"https://api.github.com/users/bruvzg/gists{/gist_id}","starred_url":"https://api.github.com/users/bruvzg/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/bruvzg/subscriptions","organizations_url":"https://api.github.com/users/bruvzg/orgs","repos_url":"https://api.github.com/users/bruvzg/repos","events_url":"https://api.github.com/users/bruvzg/events{/privacy}","received_events_url":"https://api.github.com/users/bruvzg/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-08-05T16:59:40Z","updated_at":"2025-08-05T16:59:40Z","body":"Normal output to console (like `printf`) won't work before C-runtime init, and we can't guarantee C-runtime init won't use SSE4.2 and crash (it's unlikely, but possible), so check should be before it. We do it on Windows and call `MessageBox`, but in case of Linux it will likely require using syscalls directly to either print or start `xmessage`.","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3155916055/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3155957067","html_url":"https://github.com/godotengine/godot/issues/109288#issuecomment-3155957067","issue_url":"https://api.github.com/repos/godotengine/godot/issues/109288","id":3155957067,"node_id":"IC_kwDOAO6SJc68HBVL","user":{"login":"bruvzg","id":7645683,"node_id":"MDQ6VXNlcjc2NDU2ODM=","avatar_url":"https://avatars.githubusercontent.com/u/7645683?v=4","gravatar_id":"","url":"https://api.github.com/users/bruvzg","html_url":"https://github.com/bruvzg","followers_url":"https://api.github.com/users/bruvzg/followers","following_url":"https://api.github.com/users/bruvzg/following{/other_user}","gists_url":"https://api.github.com/users/bruvzg/gists{/gist_id}","starred_url":"https://api.github.com/users/bruvzg/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/bruvzg/subscriptions","organizations_url":"https://api.github.com/users/bruvzg/orgs","repos_url":"https://api.github.com/users/bruvzg/repos","events_url":"https://api.github.com/users/bruvzg/events{/privacy}","received_events_url":"https://api.github.com/users/bruvzg/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-08-05T17:12:57Z","updated_at":"2025-08-05T17:12:57Z","body":"Normal Linux executable launch looks something like this:\n\n```\n          _start()\n             ↓\n     __libc_init_main()\n             ↓\n        constructors\n             ↓\n           main()\n```\n\nWe can plug in either before `_start` (by overriding entry point), do a check and call original `_start`, but pretty much nothing will work at this point.\n\nOr we can plug into `constructors`, but there are no defined order of constructor calls, so there are no guarantees it won't try to run SSE4.2 code before it.","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3155957067/reactions","total_count":2,"+1":2,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3156001920","html_url":"https://github.com/godotengine/godot/issues/109288#issuecomment-3156001920","issue_url":"https://api.github.com/repos/godotengine/godot/issues/109288","id":3156001920,"node_id":"IC_kwDOAO6SJc68HMSA","user":{"login":"knightmb","id":3860711,"node_id":"MDQ6VXNlcjM4NjA3MTE=","avatar_url":"https://avatars.githubusercontent.com/u/3860711?v=4","gravatar_id":"","url":"https://api.github.com/users/knightmb","html_url":"https://github.com/knightmb","followers_url":"https://api.github.com/users/knightmb/followers","following_url":"https://api.github.com/users/knightmb/following{/other_user}","gists_url":"https://api.github.com/users/knightmb/gists{/gist_id}","starred_url":"https://api.github.com/users/knightmb/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/knightmb/subscriptions","organizations_url":"https://api.github.com/users/knightmb/orgs","repos_url":"https://api.github.com/users/knightmb/repos","events_url":"https://api.github.com/users/knightmb/events{/privacy}","received_events_url":"https://api.github.com/users/knightmb/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-08-05T17:28:29Z","updated_at":"2025-08-05T17:28:29Z","body":"Is there no way to pull console output from /proc/cpuinfo to search for the sse4_2 string before all of that takes place? Or maybe a better question, does lack of SSE4.2 just tank everything before there is even a chance to detect or make error returns?","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3156001920/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null}]