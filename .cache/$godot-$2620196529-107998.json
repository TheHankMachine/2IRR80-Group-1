[{"id":2962580415,"node_id":"PRR_kwDOAO6SJc6wlWO_","state":"COMMENTED","user":{"site_admin":false,"suspended":false,"updated_at":"0001-01-01T00:00:00Z","avatar_url":"https://avatars.githubusercontent.com/u/191561?v=4","created_at":"0001-01-01T00:00:00Z","followers":0,"following":0,"html_url":"https://github.com/dsnopek","id":191561,"node_id":"MDQ6VXNlcjE5MTU2MQ==","login":"dsnopek","type":"User","owned_private_repos":0,"public_gists":0,"public_repos":0,"total_private_repos":0,"url":"https://api.github.com/users/dsnopek"},"body":"When doing development, I like to build with `scons debug_symbols=yes separate_debug_symbols=no`, so that debug symbols are included in the `libgodot_android.so` file.\r\n\r\nBefore this PR, that work fine!\r\n\r\nHowever, with this PR, if I unzip the `android_sources.zip` and the `godot-lib.template.debug.aar`, then the contained `libgodot_android.so` appears to be stripped of debug symbols.\r\n\r\nOddly, unzipping the `android_debug.apk`, the `libgodot_android.so` in there _does_ appear to have debug symbols.\r\n\r\nI haven't really tested the separate debug symbols, beyond that the zip file gets generated, because that's not a feature that I personally use.","html_url":"https://github.com/godotengine/godot/pull/107998#pullrequestreview-2962580415","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/107998","author_association":"CONTRIBUTOR","submitted_at":"2025-06-26T16:03:25Z"},{"id":2990406449,"node_id":"PRR_kwDOAO6SJc6yPfsx","state":"APPROVED","commit_id":"c376348b16d53f9072d7490030c9c645d9c3caaa","user":{"site_admin":false,"suspended":false,"updated_at":"0001-01-01T00:00:00Z","avatar_url":"https://avatars.githubusercontent.com/u/176927541?u=25817fe797fcc7a812ba9d7f58f593f5a003abbb&v=4","created_at":"0001-01-01T00:00:00Z","followers":0,"following":0,"html_url":"https://github.com/syntaxerror247","id":176927541,"node_id":"U_kgDOCouzNQ","login":"syntaxerror247","type":"User","owned_private_repos":0,"public_gists":0,"