[],"type":null,"active_lock_reason":null,"draft":false,"pull_request":{"url":"https://api.github.com/repos/godotengine/godot/pulls/114590","html_url":"https://github.com/godotengine/godot/pull/114590","diff_url":"https://github.com/godotengine/godot/pull/114590.diff","patch_url":"https://github.com/godotengine/godot/pull/114590.patch","merged_at":null},"body":"Fixes #114573\r\n\r\nThis fix addresses the issue where shader documentation comments were not being extracted for array uniforms. The regex pattern used to find uniform declarations with documentation was only looking for whitespace, colons, semicolons, or equals signs after the uniform name, but array uniforms have square brackets '[' after the name. By adding '\\[' to the character class in the lookahead assertion, the pattern now correctly matches both regular uniforms and array uniforms.","closed_by":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/114590/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/godotengine/godot/issues/114590/timeline","performed_via_github_app":null,"state_reason":null}