scription":"","archived_at":null,"archived_by":null}],"state":"open","locked":false,"assignees":[],"milestone":{"url":"https://api.github.com/repos/godotengine/godot/milestones/16","html_url":"https://github.com/godotengine/godot/milestone/16","labels_url":"https://api.github.com/repos/godotengine/godot/milestones/16/labels","id":8237783,"node_id":"MI_kwDOAO6SJc4AfbLX","number":16,"title":"4.x","description":"Issues and pull requests slated for an undetermined Godot 4 release.","creator":{"login":"akien-mga","id":4701338,"node_id":"MDQ6VXNlcjQ3MDEzMzg=","avatar_url":"https://avatars.githubusercontent.com/u/4701338?v=4","gravatar_id":"","url":"https://api.github.com/users/akien-mga","html_url":"https://github.com/akien-mga","followers_url":"https://api.github.com/users/akien-mga/followers","following_url":"https://api.github.com/users/akien-mga/following{/other_user}","gists_url":"https://api.github.com/users/akien-mga/gists{/gist_id}","starred_url":"https://api.github.com/users/akien-mga/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/akien-mga/subscriptions","organizations_url":"https://api.github.com/users/akien-mga/orgs","repos_url":"https://api.github.com/users/akien-mga/repos","events_url":"https://api.github.com/users/akien-mga/events{/privacy}","received_events_url":"https://api.github.com/users/akien-mga/received_events","type":"User","user_view_type":"public","site_admin":false},"open_issues":5791,"closed_issues":0,"state":"open","created_at":"2022-07-26T12:42:05Z","updated_at":"2026-10-21T22:40:26Z","due_on":null,"closed_at":null},"comments":0,"created_at":"2026-07-03T09:40:10Z","updated_at":"2026-07-05T16:20:59Z","closed_at":null,"assignee":null,"author_association":"CONTRIBUTOR","issue_field_values":[],"type":null,"active_lock_reason":null,"draft":false,"pull_request":{"url":"https://api.github.com/repos/godotengine/godot/pulls/120889","html_url":"https://github.com/godotengine/godot/pull/120889","diff_url":"https://github.com/godotengine/godot/pull/120889.diff","patch_url":"https://github.com/godotengine/godot/pull/120889.patch","merged_at":null},"body":"Changed caching behavior in Help Search to use a second metadata column for cache key generation to minimize collisions and changed cache hashmap to vector of TreeItem *.\r\n\r\nfixes #120278 \r\n\r\nMemory leak occurred when TreeItems with identical keys were cached as new pointers would overwrite old pointers without maintaining ownership. This left them unattached during cleanup. Using 2nd metadata column to make a more unique key resolved most of the leaks but in cases where identical TreeItems were created, key collision still occurred. By changing single value to vector, allowed caching of TreeItems with identical cache keys.\r\n\r\nMemory leak was reproduced with test print statements on collision in the issue. PR testing followed identical methodology with no leaked objects.\r\n\r\nI maintained caching of all generated objects. However with the decrease of collisions with the new key gen, instead of caching multiple TreeItems with identical cache keys, they could just be discarded if one is already cached.","closed_by":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/120889/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/godotengine/godot/issues/120889/timeline","performed_via_github_app":null,"state_reason":null}