ange_bones_in_skeleton3d_2026-04-10_13-21-48.zip)\n\nThe glb model in the project is exported from Blender (I've imported the original FBX and exported it as GLB).","closed_by":{"login":"TokageItLab","id":61938263,"node_id":"MDQ6VXNlcjYxOTM4MjYz","avatar_url":"https://avatars.githubusercontent.com/u/61938263?v=4","gravatar_id":"","url":"https://api.github.com/users/TokageItLab","html_url":"https://github.com/TokageItLab","followers_url":"https://api.github.com/users/TokageItLab/followers","following_url":"https://api.github.com/users/TokageItLab/following{/other_user}","gists_url":"https://api.github.com/users/TokageItLab/gists{/gist_id}","starred_url":"https://api.github.com/users/TokageItLab/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/TokageItLab/subscriptions","organizations_url":"https://api.github.com/users/TokageItLab/orgs","repos_url":"https://api.github.com/users/TokageItLab/repos","events_url":"https://api.github.com/users/TokageItLab/events{/privacy}","received_events_url":"https://api.github.com/users/TokageItLab/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/118376/reactions","total_count":1,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":1},"timeline_url":"https://api.github.com/repos/godotengine/godot/issues/118376/timeline","performed_via_github_app":null,"state_reason":"not_planned","pinned_comment":null}