/22123964?v=4","gravatar_id":"","url":"https://api.github.com/users/Lazy-Rabbit-2001","html_url":"https://github.com/Lazy-Rabbit-2001","followers_url":"https://api.github.com/users/Lazy-Rabbit-2001/followers","following_url":"https://api.github.com/users/Lazy-Rabbit-2001/following{/other_user}","gists_url":"https://api.github.com/users/Lazy-Rabbit-2001/gists{/gist_id}","starred_url":"https://api.github.com/users/Lazy-Rabbit-2001/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Lazy-Rabbit-2001/subscriptions","organizations_url":"https://api.github.com/users/Lazy-Rabbit-2001/orgs","repos_url":"https://api.github.com/users/Lazy-Rabbit-2001/repos","events_url":"https://api.github.com/users/Lazy-Rabbit-2001/events{/privacy}","received_events_url":"https://api.github.com/users/Lazy-Rabbit-2001/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-04-27T13:34:17Z","updated_at":"2025-04-27T13:34:35Z","body":"> If I'm not mistaken, does this PR change the default behavior of the resize handle for sprite2d with region enabled?\r\n\r\nNo, as you have to hold ctrl to drag to change its rect. If you don't then it's still changing the scale","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2833462878/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2833501013","html_url":"https://github.com/godotengine/godot/pull/105147#issuecomment-2833501013","issue_url":"https://api.github.com/repos/godotengine/godot/issues/105147","id":2833501013,"node_id":"IC_kwDOAO6SJc6o48tV","user":{"login":"kitbdev","id":10054226,"node_id":"MDQ6VXNlcjEwMDU0MjI2","avatar_url":"https://avatars.githubusercontent.com/u/10054226?v=4","gravatar_id":"","url":"https://api.github.com/users/kitbdev","html_url":"https://github.com/kitbdev","followers_url":"https://api.github.com/users/kitbdev/followers","following_url":"https://api.github.com/users/kitbdev/following{/other_user}","gists_url":"https://api.github.com/users/kitbdev/gists{/gist_id}","starred_url":"https://api.github.com/users/kitbdev/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/kitbdev/subscriptions","organizations_url":"https://api.github.com/users/kitbdev/orgs","repos_url":"https://api.github.com/users/kitbdev/repos","events_url":"https://api.github.com/users/kitbdev/events{/privacy}","received_events_url":"https://api.github.com/users/kitbdev/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-04-27T15:02:46Z","updated_at":"2025-04-27T21:51:12Z","body":"When the Sprite is rotated or scaled and changing the region rect, it moves incorrectly.\r\n\r\nMoving the top-left side should move the region rect position instead of the regular position.\r\n\r\nThe dragging mode hint should only show in the select tool mode.\r\n\r\nI think it would be better if this was a separate tool mode, for better ease of use, but I'm not sure how possible that is. It would also allow the code to not need to be in sprite.cpp. The hint text also wouldn't be needed, and the visuals can change slightly to make it clear it is different.","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2833501013/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2835498426","html_url":"https://github.com/godotengine/godot/pull/105147#issuecomment-2835498426","issue_url":"https://api.github.com/repos/godotengine/godot/issues/105147","id":2835498426,"node_id":"IC_kwDOAO6SJc6pAkW6","user":{"login":"Lazy-Rabbit-2001","id":22123964,"node_id":"MDQ6VXNlcjIyMTIzOTY0","avatar_url":"https://avatars.githubusercontent.com/u/22123964?v=4","gravatar_id":"","url":"https://api.github.com/users/Lazy-Rabbit-2001","html_url":"https://github.com/Lazy-Rabbit-2001","followers_url":"https://api.github.com/users/Lazy-Rabbit-2001/followers","following_url":"https://api.github.com/users/Lazy-Rabbit-2001/following{/other_user}","gists_url":"https://api.github.com/users/Lazy-Rabbit-2001/gists{/gist_id}","starred_url":"https://api.github.com/users/Lazy-Rabbit-2001/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Lazy-Rabbit-2001/subscriptions","organizations_url":"https://api.github.com/users/Lazy-Rabbit-2001/orgs","repos_url":"https://api.github.com/users/Lazy-Rabbit-2001/repos","events_url":"https://api.github.com/users/Lazy-Rabbit-2001/events{/privacy}","received_events_url":"https://api.github.com/users/Lazy-Rabbit-2001/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-04-28T14:45:29Z","updated_at":"2025-04-28T14:45:29Z","body":"> When the Sprite is rotated or scaled and changing the region rect, it moves incorrectly.\r\n> \r\n> Moving the top-left side should move the region rect position instead of the regular position.\r\n\r\nfixed","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2835498426/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2847354987","html_url":"https://github.com/godotengine/godot/pull/105147#issuecomment-2847354987","issue_url":"https://api.github.com/repos/godotengine/godot/issues/105147","id":2847354987,"node_id":"IC_kwDOAO6SJc6ptzBr","user":{"login":"Repiteo","id":17489292,"node_id":"MDQ6VXNlcjE3NDg5Mjky","avatar_url":"https://avatars.githubusercontent.com/u/17489292?v=4","gravatar_id":"","url":"https://api.github.com/users/Repiteo","html_url":"https://github.com/Repiteo","followers_url":"https://api.github.com/users/Repiteo/followers","following_url":"https://api.github.com/users/Repiteo/following{/other_user}","gists_url":"https://api.github.com/users/Repiteo/gists{/gist_id}","starred_url":"https://api.github.com/users/Repiteo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Repiteo/subscriptions","organizations_url":"https://api.github.com/users/Repiteo/orgs","repos_url":"https://api.github.com/users/Repiteo/repos","events_url":"https://api.github.com/users/Repiteo/events{/privacy}","received_events_url":"https://api.github.com/users/Repiteo/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-05-02T14:31:28Z","updated_at":"2025-05-02T14:31:28Z","body":"Thanks!","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2847354987/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2847798318","html_url":"https://github.com/godotengine/godot/pull/105147#issuecomment-2847798318","issue_url":"https://api.github.com/repos/godotengine/godot/issues/105147","id":2847798318,"node_id":"IC_kwDOAO6SJc6pvfQu","user":{"login":"kitbdev","id":10054226,"node_id":"MDQ6VXNlcjEwMDU0MjI2","avatar_url":"https://avatars.githubusercontent.com/u/10054226?v=4","gravatar_id":"","url":"https://api.github.com/users/kitbdev","html_url":"https://github.com/kitbdev","followers_url":"https://api.github.com/users/kitbdev/followers","following_url":"https://api.github.com/users/kitbdev/following{/other_user}","gists_url":"https://api.github.com/users/kitbdev/gists{/gist_id}","starred_url":"https://api.github.com/users/kitbdev/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/kitbdev/subscriptions","organizations_url":"https://api.github.com/users/kitbdev/orgs","repos_url":"https://api.github.com/users/kitbdev/repos","events_url":"https://api.github.com/users/kitbdev/events{/privacy}","received_events_url":"https://api.github.com/users/kitbdev/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-05-02T18:03:03Z","updated_at":"2025-05-02T18:03:03Z","body":"I just realized that this uses the control key, but control is already used for smart snapping. So now the region cannot be edited without the snapping, and smart snapping always changes the region rect.\r\nThe top left of the region still moves the transform position, not the region rect position.\r\nAnd the dragging hint is still displayed for all modes, but only relevant for one.","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2847798318/reactions","total_count":2,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":2},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2848449648","html_url":"https://github.com/godotengine/godot/pull/105147#issuecomment-2848449648","issue_url":"https://api.github.com/repos/godotengine/godot/issues/105147","id":2848449648,"node_id":"IC_kwDOAO6SJc6px-Rw","user":{"login":"Lazy-Rabbit-2001","id":22123964,"node_id":"MDQ6VXNlcjIyMTIzOTY0","avatar_url":"https://avatars.githubusercontent.com/u/22123964?v=4","gravatar_id":"","url":"https://api.github.com/users/Lazy-Rabbit-2001","html_url":"https://github.com/Lazy-Rabbit-2001","followers_url":"https://api.github.com/users/Lazy-Rabbit-2001/followers","following_url":"https://api.github.com/users/Lazy-Rabbit-2001/following{/other_user}","gists_url":"https://api.github.com/users/Lazy-Rabbit-2001/gists{/gist_id}","starred_url":"https://api.github.com/users/Lazy-Rabbit-2001/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Lazy-Rabbit-2001/subscriptions","organizations_url":"https://api.github.com/users/Lazy-Rabbit-2001/orgs","repos_url":"https://api.github.com/users/Lazy-Rabbit-2001/repos","events_url":"https://api.github.com/users/Lazy-Rabbit-2001/events{/privacy}","received_events_url":"https://api.github.com/users/Lazy-Rabbit-2001/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-05-03T05:47:48Z","updated_at":"2025-05-03T05:47:48Z","body":"> The top left of the region still moves the transform position, not the region rect position. \r\n\r\nThis is expected, because we often use this feature together with `repeated` turned on, in which mode we prefer to hold the top-left part in our \"hands\" (i.e. where the cursor is) while extend the sprite towards right or bottom edge of the screen. This is how our brain will react to us.\r\n\r\nAs for how about moving `rect_position` when `centered` is on, maybe that would be great, and perhaps I will open a continuation to improve this.\r\n\r\n> And the dragging hint is still displayed for all modes, but only relevant for one.\r\n\r\nI did a tiny test and found no problem with this issue. Dunno how you reproduced it.\r\nIf next time you can reproduce it, please make an issue and link this pr in it. :)","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2848449648/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2849477787","html_url":"https://github.com/godotengine/godot/pull/105147#issuecomment-2849477787","issue_url":"https://api.github.com/repos/godotengine/godot/issues/105147","id":2849477787,"node_id":"IC_kwDOAO6SJc6p15Sb","user":{"login":"kitbdev","id":10054226,"node_id":"MDQ6VXNlcjEwMDU0MjI2","avatar_url":"https://avatars.githubusercontent.com/u/10054226?v=4","gravatar_id":"","url":"https://api.github.com/users/kitbdev","html_url":"https://github.com/kitbdev","followers_url":"https://api.github.com/users/kitbdev/followers","following_url":"https://api.github.com/users/kitbdev/following{/other_user}","gists_url":"https://api.github.com/users/kitbdev/gists{/gist_id}","starred_url":"https://api.github.com/users/kitbdev/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/kitbdev/subscriptions","organizations_url":"https://api.github.com/users/kitbdev/orgs","repos_url":"https://api.github.com/users/kitbdev/repos","events_url":"https://api.github.com/users/kitbdev/events{/privacy}","received_events_url":"https://api.github.com/users/kitbdev/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-05-04T22:41:46Z","updated_at":"2025-05-04T22:41:46Z","body":"I opened an issue for the bigger issue of the control key being reused https://github.com/godotengine/godot/issues/106081.\r\n\r\n> This is expected, because we often use this feature together with repeated turned on, in which mode we prefer to hold the top-left part in our \"hands\" (i.e. where the cursor is) while extend the sprite towards right or bottom edge of the screen. This is how our brain will react to us.\r\n\r\nI was imagining the texture being fixed while the region rect is adjusted around it. The sprite position can be changed in other ways, but the only way to change the region rect position is with the Edit Region button or with the values.\r\nBut if others agree that the current way is better then it's fine.\r\n\r\n> I did a tiny test and found no problem with this issue. Dunno how you reproduced it.\r\n\r\nFor the dragging hint issue, you just need to switch to move mode or any mode other than select while a sprite with region rect enabled is selected: \r\n![Screenshot 2025-05-03 212811](https://github.com/user-attachments/assets/b4037dd1-ad57-424a-be84-be0fa9f47c47)\r\n","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2849477787/reactions","total_count":2,"+1":2,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null}]