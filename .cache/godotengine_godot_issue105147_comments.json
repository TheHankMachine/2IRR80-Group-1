[{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2799879628","html_url":"https://github.com/godotengine/godot/pull/105147#issuecomment-2799879628","issue_url":"https://api.github.com/repos/godotengine/godot/issues/105147","id":2799879628,"node_id":"IC_kwDOAO6SJc6m4sXM","user":{"login":"Lazy-Rabbit-2001","id":22123964,"node_id":"MDQ6VXNlcjIyMTIzOTY0","avatar_url":"https://avatars.githubusercontent.com/u/22123964?v=4","gravatar_id":"","url":"https://api.github.com/users/Lazy-Rabbit-2001","html_url":"https://github.com/Lazy-Rabbit-2001","followers_url":"https://api.github.com/users/Lazy-Rabbit-2001/followers","following_url":"https://api.github.com/users/Lazy-Rabbit-2001/following{/other_user}","gists_url":"https://api.github.com/users/Lazy-Rabbit-2001/gists{/gist_id}","starred_url":"https://api.github.com/users/Lazy-Rabbit-2001/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Lazy-Rabbit-2001/subscriptions","organizations_url":"https://api.github.com/users/Lazy-Rabbit-2001/orgs","repos_url":"https://api.github.com/users/Lazy-Rabbit-2001/repos","events_url":"https://api.github.com/users/Lazy-Rabbit-2001/events{/privacy}","received_events_url":"https://api.github.com/users/Lazy-Rabbit-2001/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-04-13T09:33:55Z","updated_at":"2025-04-13T09:35:36Z","body":"I renamed the title as `Sprite2D` because either in theory or in practice `AnimatedSprite2D` are often used more as an \"animation for some object\" rather than \"being something that would benefit more from being draggable\" (like background)","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2799879628/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2802485969","html_url":"https://github.com/godotengine/godot/pull/105147#issuecomment-2802485969","issue_url":"https://api.github.com/repos/godotengine/godot/issues/105147","id":2802485969,"node_id":"IC_kwDOAO6SJc6nCorR","user":{"login":"KoBeWi","id":2223172,"node_id":"MDQ6VXNlcjIyMjMxNzI=","avatar_url":"https://avatars.githubusercontent.com/u/2223172?v=4","gravatar_id":"","url":"https://api.github.com/users/KoBeWi","html_url":"https://github.com/KoBeWi","followers_url":"https://api.github.com/users/KoBeWi/followers","following_url":"https://api.github.com/users/KoBeWi/following{/other_user}","gists_url":"https://api.github.com/users/KoBeWi/gists{/gist_id}","starred_url":"https://api.github.com/users/KoBeWi/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/KoBeWi/subscriptions","organizations_url":"https://api.github.com/users/KoBeWi/orgs","repos_url":"https://api.github.com/users/KoBeWi/repos","events_url":"https://api.github.com/users/KoBeWi/events{/privacy}","received_events_url":"https://api.github.com/users/KoBeWi/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-04-14T18:06:47Z","updated_at":"2025-04-14T18:06:47Z","body":"The hint looks a bit invasive. It's displayed permanently and takes a noticeable portion of the viewport.\r\nYou should at least display it only when Select mode is active and when region is enabled.\r\nIdeally it should only show when dragging, which would also allow to reduce it to single line. That's not currently possible I think.","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2802485969/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2833458799","html_url":"https://github.com/godotengine/godot/pull/105147#issuecommen