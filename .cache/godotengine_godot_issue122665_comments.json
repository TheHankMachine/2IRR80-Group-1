.com/u/2337476?v=4","gravatar_id":"","url":"https://api.github.com/users/DallasNChains","html_url":"https://github.com/DallasNChains","followers_url":"https://api.github.com/users/DallasNChains/followers","following_url":"https://api.github.com/users/DallasNChains/following{/other_user}","gists_url":"https://api.github.com/users/DallasNChains/gists{/gist_id}","starred_url":"https://api.github.com/users/DallasNChains/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/DallasNChains/subscriptions","organizations_url":"https://api.github.com/users/DallasNChains/orgs","repos_url":"https://api.github.com/users/DallasNChains/repos","events_url":"https://api.github.com/users/DallasNChains/events{/privacy}","received_events_url":"https://api.github.com/users/DallasNChains/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-09-04T16:32:43Z","updated_at":"2026-09-04T16:34:17Z","body":"Good catch, @Maran23! That's exactly what causes it. I turned off single window mode, and the error doesn't happen. I updated the reproduction steps and title to reflect this.","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5543547271/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5558971941","html_url":"https://github.com/godotengine/godot/issues/122665#issuecomment-5558971941","issue_url":"https://api.github.com/repos/godotengine/godot/issues/122665","id":5558971941,"node_id":"IC_kwDOAO6SJc8AAAABS1cuJQ","user":{"login":"rhynocerus","id":5511505,"node_id":"MDQ6VXNlcjU1MTE1MDU=","avatar_url":"https://avatars.githubusercontent.com/u/5511505?v=4","gravatar_id":"","url":"https://api.github.com/users/rhynocerus","html_url":"https://github.com/rhynocerus","followers_url":"https://api.github.com/users/rhynocerus/followers","following_url":"https://api.github.com/users/rhynocerus/following{/other_user}","gists_url":"https://api.github.com/users/rhynocerus/gists{/gist_id}","starred_url":"https://api.github.com/users/rhynocerus/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/rhynocerus/subscriptions","organizations_url":"https://api.github.com/users/rhynocerus/orgs","repos_url":"https://api.github.com/users/rhynocerus/repos","events_url":"https://api.github.com/users/rhynocerus/events{/privacy}","received_events_url":"https://api.github.com/users/rhynocerus/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-09-06T11:41:04Z","updated_at":"2026-09-06T11:41:04Z","body":"I tested this on Linux and could not reproduce the issue with the steps currently described.\n\nSystem:\n- Godot 4.7.2.stable.official.ed1daf0bf\n- Linux Mint 22.1\n- Kernel 6.8.0-138-generic\n- X11 / Cinnamon\n- NVIDIA GeForce GT 730 (GK208B)\n- OpenGL 3 Compatibility renderer\n\nSteps tested:\n1. Created a new minimal project.\n2. Enabled Single Window Mode.\n3. Created a new scene with a plain Node root.\n4. Saved it as `main.tscn`.\n5. Deleted `main.tscn` from the FileSystem dock while the scene was still open.\n\nResult:\n- The file was deleted normally.\n- No `scene/main/viewport.cpp:440 - Condition \"index == -1\" is true` error appeared.\n- The Output panel showed 0 errors.\n\nSo at least in this Linux/X11/OpenGL Compatibility setup, I could not reproduce the regression.\n","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5558971941/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5589388566","html_url":"https://github.com/godotengine/godot/issues/122665#issuecomment-5589388566","issue_url":"https://api.github.com/repos/godotengine/godot/issues/122665","id":5589388566,"node_id":"IC_kwDOAO6SJc8AAAABTSdNFg","user":{"login":"DallasNChains","id":2337476,"node_id":"MDQ6VXNlcjIzMzc0NzY=","avatar_url":"https://avatars.githubusercontent.com/u/2337476?v=4","gravatar_id":"","url":"https://api.github.com/users/DallasNChains","html_url":"https://github.com/DallasNChains","followers_url":"https://api.github.com/users/DallasNChains/followers","following_url":"https://api.github.com/users/DallasNChains/following{/other_user}","gists_url":"https://api.github.com/users/DallasNChains/gists{/gist_id}","starred_url":"https://api.github.com/users/DallasNChains/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/DallasNChains/subscriptions","organizations_url":"https://api.github.com/users/DallasNChains/orgs","repos_url":"https://api.github.com/users/DallasNChains/repos","events_url":"https://api.github.com/users/DallasNChains/events{/privacy}","received_events_url":"https://api.github.com/users/DallasNChains/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-09-08T17:44:33Z","updated_at":"2026-09-08T17:44:33Z","body":"After reading @rhynocerus's comment, I started poking at this again on both Windows and macOS. I thought I'd summarize what I've learned so far across both platforms. I'll give Linux a go later today or tomorrow. Everything I learned was using the MRP I attached to the original issue (`index-error.zip`). \n\n### Windows\n- The `index == -1` error only occurs with Single Window Mode turned on.\n- The `index == -1` error depends on how the scene is created. If you click the _2D Scene_ button in the Scene Dock, there is no error. If you right click `res://` > Create New > Scene..., the error shows up. You don't even have to create the scene. You can click Cancel and see the same error.\n\n### macOS\n- The index == -1 error and scene deletion bugs are **not** reproducible on macOS. I tried it with both Single Window Mode on and off.\n\n### New error on both macOS and Windows\n\nWhile attempting to reproduce the original issue on macOS, I found another bug and thought I'd mention it here in case it helps as a trailhead. Creating a scene from the the Scene Dock followed by creating a scene from the FileSystem Dock results in the error \"Cannot get path of node as it is not in a scene tree\" in the output. It **only** happens the first time you create a scene in the FileSystem Dock immediately after creating a scene from the Scene Dock. That is, if you create  scenes in a row from the FileSystem Dock, you'll get the `index == -1` and \"Cannot get path\" errors the first time and then only get the `index == -1` error both times.\n\n#### Reproduction Steps\n\nThis bug is reproducible with Single Window Mode on **and** off and on both macOS and Windows. Similar to the original issue, there seem to be no ill effects of the bug. Just error output.\n\n1. Open a Godot project.\n2. Create a new scene from the Scene Dock.\n3. Save the scene.\n4. Create a new scene in the FileSystem Dock.\n5. Observe the two errors output in the Output tab.\n\n##### macOS repro video\n\nhttps://github.com/user-attachments/assets/54f16538-15a2-4d96-83c9-1231f05802bd\n\n##### Windows repro video\n\nhttps://github.com/user-attachments/assets/04fa54e6-f6c7-4413-b3d4-bd50fb162bcc\n\nI'm happy to jump on Discord/Zoom/Meet/whatever to show these reproductions if that's helpful at all. Since they're not really causing big issues, they're pretty low pri though.","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5589388566/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5639798932","html_url":"https://github.com/godotengine/godot/issues/122665#issuecomment-5639798932","issue_url":"https://api.github.com/repos/godotengine/godot/issues/122665","id":5639798932,"node_id":"IC_kwDOAO6SJc8AAAABUCiAlA","user":{"login":"DallasNChains","id":2337476,"node_id":"MDQ6VXNlcjIzMzc0NzY=","avatar_url":"https://avatars.githubusercontent.com/u/2337476?v=4","gravatar_id":"","url":"https://api.github.com/users/DallasNChains","html_url":"https://github.com/DallasNChains","followers_url":"https://api.github.com/users/DallasNChains/followers","following_url":"https://api.github.com/users/DallasNChains/following{/other_user}","gists_url":"https://api.github.com/users/DallasNChains/gists{/gist_id}","starred_url":"https://api.github.com/users/DallasNChains/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/DallasNChains/subscriptions","organizations_url":"https://api.github.com/users/DallasNChains/orgs","repos_url":"https://api.github.com/users/DallasNChains/repos","events_url":"https://api.github.com/users/DallasNChains/events{/privacy}","received_events_url":"https://api.github.com/users/DallasNChains/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-09-11T19:46:16Z","updated_at":"2026-09-11T19:46:16Z","body":"Just to follow up, the `index == -1` error does **not** reproduce on CachyOS. The \"Cannot get path of node as it is not in a scene tree\" error **does** reproduce on CachyOS.","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5639798932/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null}]