s://github.com/Ivorforce","id":2308167,"node_id":"MDQ6VXNlcjIzMDgxNjc=","login":"Ivorforce","type":"User","owned_private_repos":0,"public_gists":0,"public_repos":0,"total_private_repos":0,"url":"https://api.github.com/users/Ivorforce"},"body":"","html_url":"https://github.com/godotengine/godot/pull/117850#pullrequestreview-4015040498","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/117850","author_association":"MEMBER","submitted_at":"2026-03-26T15:01:58Z"},{"id":4015160638,"node_id":"PRR_kwDOAO6SJc7vUn0-","state":"APPROVED","commit_id":"f04e57b2d3c21bc8b344f9c5caa39895f8da5249","user":{"site_admin":false,"suspended":false,"updated_at":"0001-01-01T00:00:00Z","avatar_url":"https://avatars.githubusercontent.com/u/2308167?u=f7f8e0273f784f5ec6f6b7fe4a88d449896eb48a&v=4","created_at":"0001-01-01T00:00:00Z","followers":0,"following":0,"html_url":"https://github.com/Ivorforce","id":2308167,"node_id":"MDQ6VXNlcjIzMDgxNjc=","login":"Ivorforce","type":"User","owned_private_repos":0,"public_gists":0,"public_repos":0,"total_private_repos":0,"url":"https://api.github.com/users/Ivorforce"},"body":"Not super well versed with the stuff in the vm, but generally this looks good to me.\n\nI can confirm that I would expect the referencing to be an unnecessary bottleneck, and this is an appropriate fix for it.","html_url":"https://github.com/godotengine/godot/pull/117850#pullrequestreview-4015160638","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/117850","author_association":"MEMBER","submitted_at":"2026-03-26T15:18:21Z"},{"id":4015344730,"node_id":"PRR_kwDOAO6SJc7vVUxa","state":"COMMENTED","commit_id":"f04e57b2d3c21bc8b344f9c5caa39895f8da5249","user":{"site_admin":false,"suspended":false,"updated_at":"0001-01-01T00:00:00Z","avatar_url":"https://avatars.githubusercontent.com/u/47700418?u=0565b5d99d54afd5fda6712cd8eb05893572baed&v=4","created_at":"0001-01-01T00:00:00Z","followers":0,"following":0,"html_url":"https://github.com/dalexeev","id":47700418,"node_id":"MDQ6VXNlcjQ3NzAwNDE4","login":"dalexeev","type":"User","owned_private_repos":0,"public_gists":0,"public_repos":0,"total_private_repos":0,"url":"https://api.github.com/users/dalexeev"},"body":"Looks good to me, but we should probably add some comments:\n\n1. (`VariantInternal`) That `object_assign_without_ref_unsafe()` should be used with extreme caution.\n2. (VM) That destructors for fixed addresses aren't called because `Variant`s are initialized with `object_assign_without_ref_unsafe()`.\n\nSafety rests on several assumptions. One of them is that fixed addresses are never written to, only read. My biggest concern was `NIL`, but after examining the code, I think this assumption is correct (see also #117863). For coroutines everything should be fine too, as far as I understand.","html_url":"https://github.com/godotengine/godot/pull/117850#pullrequestreview-4015344730","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/117850","author_association":"CONTRIBUTOR","submitted_at":"2026-03-26T15:43:54Z"},{"id":4015512275,"node_id":"PRR_kwDOAO6SJc7vV9rT","state":"COMMENTED","user":{"site_admin":false,"suspended":false,"updated_at":"0001-01-01T00:00:00Z","avatar_url":"https://avatars.githubusercontent.com/u/99511741?u=b7882c94f408976a2f79e8fe6e1ce27fbd48db74&v=4","created_at":"0001-01-01T00:00:00Z","followers":0,"following":0,"html_url":"https://github.com/HolonProduction","id":99511741,"node_id":"U_kgDOBe5tvQ","login":"HolonProduction","type":"User","owned_private_repos":0,"public_gists":0,"public_repos":0,"total_private_repos":0,"url":"https://api.github.com/users/HolonProduction"},"body":"","html_url":"https://github.com/godotengine/godot/pull/117850#pullrequestreview-4015512275","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/117850","author_association":"MEMBER","submitted_at":"2026-03-26T16:07:22Z"},{"id":4015525894,"node_id":"PRR_kwDOAO6SJc7vWBAG","state":"COMMENTED","user":{"site_admin":false,"s