//avatars.githubusercontent.com/u/26508550?v=4","gravatar_id":"","url":"https://api.github.com/users/estroBiologist","html_url":"https://github.com/estroBiologist","followers_url":"https://api.github.com/users/estroBiologist/followers","following_url":"https://api.github.com/users/estroBiologist/following{/other_user}","gists_url":"https://api.github.com/users/estroBiologist/gists{/gist_id}","starred_url":"https://api.github.com/users/estroBiologist/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/estroBiologist/subscriptions","organizations_url":"https://api.github.com/users/estroBiologist/orgs","repos_url":"https://api.github.com/users/estroBiologist/repos","events_url":"https://api.github.com/users/estroBiologist/events{/privacy}","received_events_url":"https://api.github.com/users/estroBiologist/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-11-20T12:08:14Z","updated_at":"2025-11-20T12:08:14Z","body":"FWIW, I did also notice another bug(?) with `VERTICAL_ALIGNMENT_BOTTOM` where `paragraph_separation` is applied after the last paragraph if and only if `line_separation < 0`, but I figured that was best left for another PR. Thought I'd point it out though, since it kinda feels like `paragraph_separation` shouldn't be applied here regardless.\r\n\r\n(This is on 4.5.1, but the bug persists in `master` and this PR)\r\n![line sep bottom align](https://github.com/user-attachments/assets/061bf050-85ee-4e40-9f1a-dd75f428c23f)\r\n","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3557679538/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3557709255","html_url":"https://github.com/godotengine/godot/pull/112882#issuecomment-3557709255","issue_url":"https://api.github.com/repos/godotengine/godot/issues/112882","id":3557709255,"node_id":"IC_kwDOAO6SJc7UDlXH","user":{"login":"bruvzg","id":7645683,"node_id":"MDQ6VXNlcjc2NDU2ODM=","avatar_url":"https://avatars.githubusercontent.com/u/7645683?v=4","gravatar_id":"","url":"https://api.github.com/users/bruvzg","html_url":"https://github.com/bruvzg","followers_url":"https://api.github.com/users/bruvzg/followers","following_url":"https://api.github.com/users/bruvzg/following{/other_user}","gists_url":"https://api.github.com/users/bruvzg/gists{/gist_id}","starred_url":"https://api.github.com/users/bruvzg/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/bruvzg/subscriptions","organizations_url":"https://api.github.com/users/bruvzg/orgs","repos_url":"https://api.github.com/users/bruvzg/repos","events_url":"https://api.github.com/users/bruvzg/events{/privacy}","received_events_url":"https://api.github.com/users/bruvzg/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-11-20T12:14:14Z","updated_at":"2025-11-20T12:14:14Z","body":"> FWIW, I did also notice another bug(?)\r\n\r\nIndeed, this feels like a bug. There are multiple `total_height` calculations using `theme_cache.line_separation < 0` check to avoid cutting text, which are reason for it. Not sure what's the best fix for this, probably changing it to `line_sep + para_sep < 0`:\r\n\r\n```c++\r\nif (theme_cache.line_separation + theme_cache.paragraph_separation < 0) {\r\n\t// Do not apply to the last line to avoid cutting text.\r\n\ttotal_height = main->lines[to_line - 1].offset.y + main->lines[to_line - 1].text_buf->get_size().y + (main->lines[to_line - 1].text_buf->get_line_count() - 1) * theme_cache.line_separation;\r\n} else {\r\n\ttotal_height = main->lines[to_line - 1].offset.y + main->lines[to_line - 1].text_buf->get_size().y + (main->lines[to_line - 1].text_buf->get_line_count()) * theme_cache.line_separation + theme_cache.paragraph_separation;\r\n}\r\n```","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3557709255/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3564157563","html_url":"https://github.com/godotengine/godot/pull/112882#issuecomment-3564157563","issue_url":"https://api.github.com/repos/godotengine/godot/issues/112882","id":3564157563,"node_id":"IC_kwDOAO6SJc7UcLp7","user":{"login":"estroBiologist","id":26508550,"node_id":"MDQ6VXNlcjI2NTA4NTUw","avatar_url":"https://avatars.githubusercontent.com/u/26508550?v=4","gravatar_id":"","url":"https://api.github.com/users/estroBiologist","html_url":"https://github.com/estroBiologist","followers_url":"https://api.github.com/users/estroBiologist/followers","following_url":"https://api.github.com/users/estroBiologist/following{/other_user}","gists_url":"https://api.github.com/users/estroBiologist/gists{/gist_id}","starred_url":"https://api.github.com/users/estroBiologist/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/estroBiologist/subscriptions","organizations_url":"https://api.github.com/users/estroBiologist/orgs","repos_url":"https://api.github.com/users/estroBiologist/repos","events_url":"https://api.github.com/users/estroBiologist/events{/privacy}","received_events_url":"https://api.github.com/users/estroBiologist/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-11-21T18:22:48Z","updated_at":"2025-11-21T18:22:48Z","body":"Yeah, not sure either. Honestly it feels weird to me to apply `line_sep`/`para_sep` after the last line in general, but that's the established behavior so w/e. Would you like me to incorporate the `line_sep + para_sep < 0` fix into this PR, or leave it for a future one?","author_association":"CONTRIBUTOR","reactions":{"url":"https