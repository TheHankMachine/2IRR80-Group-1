nds Node\nclass_name Cowabunga\n\n@export var my_property: bool:\n\tset(value):\n\t\tEditorInterface.edit_node(self)\n\t\tEditorInterface.edit_node(EditorInterface.get_edited_scene_root())\n\t\tqueue_free()\n\n```\n\n[edit-node-crash-mrp.zip](https://github.com/user-attachments/files/21860148/edit-node-crash-mrp.zip)","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3201475907/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3204116264","html_url":"https://github.com/godotengine/godot/issues/109745#issuecomment-3204116264","issue_url":"https://api.github.com/repos/godotengine/godot/issues/109745","id":3204116264,"node_id":"IC_kwDOAO6SJc6--u8o","user":{"login":"precup","id":709680,"node_id":"MDQ6VXNlcjcwOTY4MA==","avatar_url":"https://avatars.githubusercontent.com/u/709680?v=4","gravatar_id":"","url":"https://api.github.com/users/precup","html_url":"https://github.com/precup","followers_url":"https://api.github.com/users/precup/followers","following_url":"https://api.github.com/users/precup/following{/other_user}","gists_url":"https://api.github.com/users/precup/gists{/gist_id}","starred_url":"https://api.github.com/users/precup/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/precup/subscriptions","organizations_url":"https://api.github.com/users/precup/orgs","repos_url":"https://api.github.com/users/precup/repos","events_url":"https://api.github.com/users/precup/events{/privacy}","received_events_url":"https://api.github.com/users/precup/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-08-20T04:08:04Z","updated_at":"2025-08-20T04:08:04Z","body":"The crash bisects to #106903, CC @KoBeWi","author_association":"CONTRIBUTOR","pin":null,"reaction