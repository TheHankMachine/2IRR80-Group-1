ub.com/users/Koyper/gists{/gist_id}","starred_url":"https://api.github.com/users/Koyper/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Koyper/subscriptions","organizations_url":"https://api.github.com/users/Koyper/orgs","repos_url":"https://api.github.com/users/Koyper/repos","events_url":"https://api.github.com/users/Koyper/events{/privacy}","received_events_url":"https://api.github.com/users/Koyper/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-06-25T19:52:39Z","updated_at":"2025-06-25T19:52:39Z","body":"The changes implemented in the apple embedded PR #105628 for 4.5beta1 laid waste to a number of paths and class names for iOS plugins.\n\nTake a look at this PR [godot-ios-plugins#82](https://github.com/godot-sdk-integrations/godot-ios-plugins/pull/82) for ideas on how to fix them. I got the Apple Notifications and Photo Picker to build, and the others should be easy to fix.","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3005960156/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3005991751","html_url":"https://github.com/godotengine/godot/issues/107896#issuecomment-3005991751","issue_url":"https://api.github.com/repos/godotengine/godot/issues/107896","id":3005991751,"node_id":"IC_kwDOAO6SJc6zK8tH","user":{"login":"owlnewworlds","id":156072785,"node_id":"U_kgDOCU17UQ","avatar_url":"https://avatars.githubusercontent.com/u/156072785?v=4","gravatar_id":"","url":"https://api.github.com/users/owlnewworlds","html_url":"https://github.com/owlnewworlds","followers_url":"https://api.github.com/users/owlnewworlds/followers","following_url":"https://api.github.com/users/owlnewworlds/following{/other_user}","gists_url":"https://api.github.com/use