id":1732720779,"node_id":"MDU6TGFiZWwxNzMyNzIwNzc5","url":"https://api.github.com/repos/godotengine/godot/labels/topic:gui","name":"topic:gui","color":"ffee88","default":false,"description":"","archived_at":null,"archived_by":null}],"state":"closed","locked":false,"assignees":[],"milestone":{"url":"https://api.github.com/repos/godotengine/godot/milestones/24","html_url":"https://github.com/godotengine/godot/milestone/24","labels_url":"https://api.github.com/repos/godotengine/godot/milestones/24/labels","id":14236899,"node_id":"MI_kwDOAO6SJc4A2Tzj","number":24,"title":"4.7","description":"","creator":{"login":"akien-mga","id":4701338,"node_id":"MDQ6VXNlcjQ3MDEzMzg=","avatar_url":"https://avatars.githubusercontent.com/u/4701338?v=4","gravatar_id":"","url":"https://api.github.com/users/akien-mga","html_url":"https://github.com/akien-mga","followers_url":"https://api.github.com/users/akien-mga/followers","following_url":"https://api.github.com/users/akien-mga/following{/other_user}","gists_url":"https://api.github.com/users/akien-mga/gists{/gist_id}","starred_url":"https://api.github.com/users/akien-mga/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/akien-mga/subscriptions","organizations_url":"https://api.github.com/users/akien-mga/orgs","repos_url":"https://api.github.com/users/akien-mga/repos","events_url":"https://api.github.com/users/akien-mga/events{/privacy}","received_events_url":"https://api.github.com/users/akien-mga/received_events","type":"User","user_view_type":"public","site_admin":false},"open_issues":3,"closed_issues":2535,"state":"closed","created_at":"2025-11-27T20:29:18Z","updated_at":"2026-10-20T18:39:31Z","due_on":null,"closed_at":"2026-06-19T16:54:35Z"},"comments":4,"created_at":"2025-12-30T15:43:48Z","updated_at":"2026-06-18T16:19:18Z","closed_at":"2026-01-27T21:28:25Z","assignee":null,"author_association":"CONTRIBUTOR","issue_field_values":[],"type":null,"active_lock_reason":null,"draft":false,"pull_request":{"url":"https://api.github.com/repos/godotengine/godot/pulls/114449","html_url":"https://github.com/godotengine/godot/pull/114449","diff_url":"https://github.com/godotengine/godot/pull/114449.diff","patch_url":"https://github.com/godotengine/godot/pull/114449.patch","merged_at":"2026-01-27T21:28:25Z"},"body":"This PR does a couple things:\r\n\r\n* Adds an `accessibility_region` flag to `Control`. If set, this overrides the role on containers from \"container\" to \"region.\" When set, the container/control becomes a region described by its accessible name.\r\n* Sets `accessible_region = true` on a variety of editor controls.\r\n\r\nAs an Orca user, when focus moves through the editor in arbitrary ways, I now get notified when entering regions of the editor larger than a single control. So now when someone says \"Do X in the inspector,\" I now know which group of controls corresponds to the inspector because tabbing/arrowing into the group speaks \"Inspector\" before the control name/description/content. Orca only does this on entry, so it's non-spammy and very helpful.\r\n\r\n### Open questions\r\n\r\n* I added an `accessible_region` flag because it felt least invasive. Another solution might be directly exposing roles so controls can explicitly set a role. This should probably exist in general--maybe someone wants a custom control and needs to explicitly define its accessibility behavior--but for now I just wanted to make sure the concept works. Happy to refactor to a separate role property in another PR if needed.\r\n* I'm open to adding/removing regions if they make sense. I'm going for semantic--\"Audio editor\" vs. \"Bottom panel\", along with tab titles for their panels so it's clear what you're navigating into regardless of which direction you take to get there. I'm simultaneously learning the editor while improving its accessibility so there are certainly regions I've missed.","closed_by":{"login":"Repiteo","id":17489292,"node_id":"MDQ6VXNlcjE3NDg5Mjky","avatar_url":"https://avatars.githubusercontent.com/u/17489292?v=4","gravatar_id":"","url":"https://api.github.com/users/Repiteo","html_url":"https://github.com/Repiteo","followers_url":"https://api.github.com/users/Repiteo/followers","following_url":"https://api.github.com/users/Repiteo/following{/other_user}","gists_url":"https://api.github.com/users/Repiteo/gists{/gist_id}","starred_url":"https://api.github.com/users/Repiteo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Repiteo/subscriptions","organizations_url":"https://api.github.com/users/Repiteo/orgs","repos_url":"https://api.github.com/users/Repiteo/repos","events_url":"https://api.github.com/users/Repiteo/events{/privacy}","received_events_url":"https://api.github.com/users/Repiteo/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/114449/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/godotengine/godot/issues/114449/timeline","performed_via_github_app":null,"state_reason":null}