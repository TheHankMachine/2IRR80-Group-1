[{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5193244665","html_url":"https://github.com/godotengine/godot/issues/122114#issuecomment-5193244665","issue_url":"https://api.github.com/repos/godotengine/godot/issues/122114","id":5193244665,"node_id":"IC_kwDOAO6SJc8AAAABNYqf-Q","user":{"login":"clayjohn","id":16521339,"node_id":"MDQ6VXNlcjE2NTIxMzM5","avatar_url":"https://avatars.githubusercontent.com/u/16521339?v=4","gravatar_id":"","url":"https://api.github.com/users/clayjohn","html_url":"https://github.com/clayjohn","followers_url":"https://api.github.com/users/clayjohn/followers","following_url":"https://api.github.com/users/clayjohn/following{/other_user}","gists_url":"https://api.github.com/users/clayjohn/gists{/gist_id}","starred_url":"https://api.github.com/users/clayjohn/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/clayjohn/subscriptions","organizations_url":"https://api.github.com/users/clayjohn/orgs","repos_url":"https://api.github.com/users/clayjohn/repos","events_url":"https://api.github.com/users/clayjohn/events{/privacy}","received_events_url":"https://api.github.com/users/clayjohn/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-08-05T14:43:28Z","updated_at":"2026-08-05T14:43:28Z","body":"Godot doesn't support running a second OpenGL context on its main thread. You need to create your context on a background thread. You can't have two contexts active at the same time on the same thread. \n\nYou might be able to get away with enabling multithreaded rendering since Godot will render on a background thread in that case. But you would need to be very careful. \n\nOverall, Godot is a game engine, which means it is designed to own the main thread and main loop. So when developing addons you need to respect that and do your work on a separate thread to avoid crashing into Godot","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5193244665/reactions","total_count":3,"+1":2,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":1,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5223997267","html_url":"https://github.com/godotengine/godot/issues/122114#issuecomment-5223997267","issue_url":"https://api.github.com/repos/godotengine/godot/issues/122114","id":5223997267,"node_id":"IC_kwDOAO6SJc8AAAABN1_fUw","user":{"login":"Vercidium","id":12014138,"node_id":"MDQ6VXNlcjEyMDE0MTM4","avatar_url":"https://avatars.githubusercontent.com/u/12014138?v=4","gravatar_id":"","url":"https://api.github.com/users/Vercidium","html_url":"https://github.com/Vercidium","followers_url":"https://api.github.com/users/Vercidium/followers","following_url":"https://api.github.com/users/Vercidium/following{/other_user}","gists_url":"https://api.github.com/users/Vercidium/gists{/gist_id}","starred_url":"https://api.github.com/users/Vercidium/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Vercidium/subscriptions","organizations_url":"https://api.github.com/users/Vercidium/orgs","repos_url":"https://api.github.com/users/Vercidium/repos","events_url":"https://api.github.com/users/Vercidium/events{/privacy}","received_events_url":"https://api.github.com/users/Vercidium/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-08-08T02:06:30Z","updated_at":"2026-08-08T02:06:30Z","body":"Thanks for the quick response - this makes sense. Is it safe to have a 2nd context on the main thread with the `forward_plus` renderer?","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5223997267/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5224343616","html_url":"https://github.com/godotengine/godot/issues/122114#issuecomment-5224343616","issue_url":"https://api.github.com/repos/godotengine/godot/issues/122114","id":5224343616,"node_id":"IC_kwDOAO6SJc8AAAABN2UoQA","user":{"login":"clayjohn","id":16521339,"node_id":"MDQ6VXNlcjE2NTIxMzM5","avatar_url":"https://avatars.githubusercontent.com/u/16521339?v=4","gravatar_id":"","url":"https://api.github.com/users/clayjohn","html_url":"https://github.com/clayjohn","followers_url":"https://api.github.com/users/clayjohn/followers","following_url":"https://api.github.com/users/clayjohn/following{/other_user}","gists_url":"https://api.github.com/users/clayjohn/gists{/gist_id}","starred_url":"https://api.github.com/users/clayjohn/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/clayjohn/subscriptions","organizations_url":"https://api.github.com/users/clayjohn/orgs","repos_url":"https://api.github.com/users/clayjohn/repos","events_url":"https://api.github.com/users/clayjohn/events{/privacy}","received_events_url":"https://api.github.com/users/clayjohn/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-08-08T03:43:47Z","updated_at":"2026-08-08T03:43:47Z","body":"> Thanks for the quick response - this makes sense. Is it safe to have a 2nd context on the main thread with the `forward_plus` renderer?\n\nIt depends on what GPU/OS you are using. In theory it should be safe, but we have found a number of GPU/OS combinations where having an active Vulkan context and an active OpenGL context causes the graphics drivers to crash ","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5224343616/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null}]