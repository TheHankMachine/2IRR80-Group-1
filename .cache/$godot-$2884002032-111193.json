DQ6VXNlcjIyMjMxNzI=","login":"KoBeWi","type":"User","owned_private_repos":0,"public_gists":0,"public_repos":0,"total_private_repos":0,"url":"https://api.github.com/users/KoBeWi"},"body":"","html_url":"https://github.com/godotengine/godot/pull/111193#pullrequestreview-3646745311","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/111193","author_association":"MEMBER","submitted_at":"2026-01-10T11:39:22Z"},{"id":3648290048,"node_id":"PRR_kwDOAO6SJc7ZdH0A","state":"COMMENTED","user":{"site_admin":false,"suspended":false,"updated_at":"0001-01-01T00:00:00Z","avatar_url":"https://avatars.githubusercontent.com/u/2223172?u=fc85633b469acb6e7baef4dba5171f19a2a4ff85&v=4","created_at":"0001-01-01T00:00:00Z","followers":0,"following":0,"html_url":"https://github.com/KoBeWi","id":2223172,"node_id":"MDQ6VXNlcjIyMjMxNzI=","login":"KoBeWi","type":"User","owned_private_repos":0,"public_gists":0,"public_repos":0,"total_private_repos":0,"url":"https://api.github.com/users/KoBeWi"},"body":"Looks good overall. I did some testing and it's working. This is a nice first step towards having global addons. What will still need to be improved (in later PRs):\n- The list of enabled global addons needs to be moved to editor settings.\n- The user should be able to install global addons somehow (when downloaded from AssetLib).\n- There needs to be some convenient way to create/edit the global addons.\n- There needs to be some way to migrate addons between engine versions (e.g. if you open the editor in 4.7, you'll want your 4.6 addons).\n\nThe implementation will need review from core team. Also not sure what's the status of #87586, as this PR potentially conflicts with that. Your solution introduces some code duplication that could be better generalized.","html_url":"https://github.com/godotengine/godot/pull/111193#pullrequestreview-3648290048","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/111193","author_association":"MEMBER","submitted_at":"2026-