[{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3871937426","html_url":"https://github.com/godotengine/godot/issues/116095#issuecomment-3871937426","issue_url":"https://api.github.com/repos/godotengine/godot/issues/116095","id":3871937426,"node_id":"IC_kwDOAO6SJc7myROS","user":{"login":"shadow-foss","id":144371189,"node_id":"U_kgDOCJrt9Q","avatar_url":"https://avatars.githubusercontent.com/u/144371189?v=4","gravatar_id":"","url":"https://api.github.com/users/shadow-foss","html_url":"https://github.com/shadow-foss","followers_url":"https://api.github.com/users/shadow-foss/followers","following_url":"https://api.github.com/users/shadow-foss/following{/other_user}","gists_url":"https://api.github.com/users/shadow-foss/gists{/gist_id}","starred_url":"https://api.github.com/users/shadow-foss/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/shadow-foss/subscriptions","organizations_url":"https://api.github.com/users/shadow-foss/orgs","repos_url":"https://api.github.com/users/shadow-foss/repos","events_url":"https://api.github.com/users/shadow-foss/events{/privacy}","received_events_url":"https://api.github.com/users/shadow-foss/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-02-09T14:08:05Z","updated_at":"2026-02-09T14:08:05Z","body":"I bisected this issue and found that the regression starts from PR #111580, commit: ```7680190768af903ae43ab57a076560dc6db2f7f8```\n\nEarlier commits do not show this behavior.\n\n","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3871937426/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3871976115","html_url":"https://github.com/godotengine/godot/issues/116095#issuecomment-3871976115","issue_url":"https://api.github.com/repos/godotengine/godot/issues/116095","id":3871976115,"node_id":"IC_kwDOAO6SJc7myaqz","user":{"login":"AThousandShips","id":96648715,"node_id":"U_kgDOBcK-Cw","avatar_url":"https://avatars.githubusercontent.com/u/96648715?v=4","gravatar_id":"","url":"https://api.github.com/users/AThousandShips","html_url":"https://github.com/AThousandShips","followers_url":"https://api.github.com/users/AThousandShips/followers","following_url":"https://api.github.com/users/AThousandShips/following{/other_user}","gists_url":"https://api.github.com/users/AThousandShips/gists{/gist_id}","starred_url":"https://api.github.com/users/AThousandShips/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/AThousandShips/subscriptions","organizations_url":"https://api.github.com/users/AThousandShips/orgs","repos_url":"https://api.github.com/users/AThousandShips/repos","events_url":"https://api.github.com/users/AThousandShips/events{/privacy}","received_events_url":"https://api.github.com/users/AThousandShips/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-02-09T14:14:44Z","updated_at":"2026-02-09T14:14:44Z","body":"CC @timothyqiu ","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3871976115/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3872626852","html_url":"https://github.com/godotengine/godot/issues/116095#issuecomment-3872626852","issue_url":"https://api.github.com/repos/godotengine/godot/issues/116095","id":3872626852,"node_id":"IC_kwDOAO6SJc7m05ik","user":{"login":"timothyqiu","id":372476,"node_id":"MDQ6VXNlcjM3MjQ3Ng==","avatar_url":"https://avatars.githubusercontent.com/u/372476?v=4","gravatar_id":"","url":"https://api.github.com/users/timothyqiu","html_url":"https://github.com/timothyqiu","followers_url":"https://api.github.com/users/timothyqiu/followers","following_url":"https://api.github.com/users/timothyqiu/following{/other_user}","gists_url":"https://api.github.com/users/timothyqiu/gists{/gist_id}","starred_url":"https://api.github.com/users/timothyqiu/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/timothyqiu/subscriptions","organizations_url":"https://api.github.com/users/timothyqiu/orgs","repos_url":"https://api.github.com/users/timothyqiu/repos","events_url":"https://api.github.com/users/timothyqiu/events{/privacy}","received_events_url":"https://api.github.com/users/timothyqiu/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-02-09T16:03:37Z","updated_at":"2026-02-09T16:03:37Z","body":"@shadow-foss It looks like you're using the i3 window manager, and the popup size is also somewhat unusual even in 4.5.1. Just to be sure, are there any special floating rules for the relevant windows in your i3 config?\n\n#113301 might also be related, as I found that this rename popup seems to consistently behave differently from other popups.","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3872626852/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3872995126","html_url":"https://github.com/godotengine/godot/issues/116095#issuecomment-3872995126","issue_url":"https://api.github.com/repos/godotengine/godot/issues/116095","id":3872995126,"node_id":"IC_kwDOAO6SJc7m2Tc2","user":{"login":"shadow-foss","id":144371189,"node_id":"U_kgDOCJrt9Q","avatar_url":"https://avatars.githubusercontent.com/u/144371189?v=4","gravatar_id":"","url":"https://api.github.com/users/shadow-foss","html_url":"https://github.com/shadow-foss","followers_url":"https://api.github.com/users/shadow-foss/followers","following_url":"https://api.github.com/users/shadow-foss/following{/other_user}","gists_url":"https://api.github.com/users/shadow-foss/gists{/gist_id}","starred_url":"https://api.github.com/users/shadow-foss/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/shadow-foss/subscriptions","organizations_url":"https://api.github.com/users/shadow-foss/orgs","repos_url":"https://api.github.com/users/shadow-foss/repos","events_url":"https://api.github.com/users/shadow-foss/events{/privacy}","received_events_url":"https://api.github.com/users/shadow-foss/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-02-09T17:33:55Z","updated_at":"2026-02-09T17:33:55Z","body":"Found the cause on my side. I had an i3 rule that centers all windows with a window_role:\n\n```for_window [window_role=\".*\"] move position center```\nRemoving this rule fixes the issue.\n\nThis rule was present in 4.5.1 as well, but older versions of Godot appeared to reposition the rename popup afterward, which masked the effect.\n\nThe rename popup also behaves differently from other popups. It does not look like a typical window and does not show window borders or decorations like confirmation dialogs, so I initially assumed it was a purely internal editor UI element rather than a separate window affected by window manager rules.\n\nThanks for pointing this out.\n","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3872995126/reactions","total_count":3,"+1":2,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":1,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3888612798","html_url":"https://github.com/godotengine/godot/issues/116095#issuecomment-3888612798","issue_url":"https://api.github.com/repos/godotengine/godot/issues/116095","id":3888612798,"node_id":"IC_kwDOAO6SJc7nx4W-","user":{"login":"shadow-foss","id":144371189,"node_id":"U_kgDOCJrt9Q","avatar_url":"https://avatars.githubusercontent.com/u/144371189?v=4","gravatar_id":"","url":"https://api.github.com/users/shadow-foss","html_url":"https://github.com/shadow-foss","followers_url":"https://api.github.com/users/shadow-foss/followers","following_url":"https://api.github.com/users/shadow-foss/following{/other_user}","gists_url":"https://api.github.com/users/shadow-foss/gists{/gist_id}","starred_url":"https://api.github.com/users/shadow-foss/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/shadow-foss/subscriptions","organizations_url":"https://api.github.com/users/shadow-foss/orgs","repos_url":"https://api.github.com/users/shadow-foss/repos","events_url":"https://api.github.com/users/shadow-foss/events{/privacy}","received_events_url":"https://api.github.com/users/shadow-foss/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-02-12T04:24:07Z","updated_at":"2026-02-12T04:24:07Z","body":"Since this turned out to be caused by the i3 window rule and removing it resolves the behavior, I will close this issue.","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3888612798/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null}]