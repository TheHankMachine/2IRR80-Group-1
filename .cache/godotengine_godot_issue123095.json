at":null,"archived_by":null},{"id":279097780,"node_id":"MDU6TGFiZWwyNzkwOTc3ODA=","url":"https://api.github.com/repos/godotengine/godot/labels/platform:macos","name":"platform:macos","color":"e4e4e4","default":false,"description":"","archived_at":null,"archived_by":null},{"id":279098111,"node_id":"MDU6TGFiZWwyNzkwOTgxMTE=","url":"https://api.github.com/repos/godotengine/godot/labels/topic:rendering","name":"topic:rendering","color":"ffee88","default":false,"description":"","archived_at":null,"archived_by":null},{"id":279098255,"node_id":"MDU6TGFiZWwyNzkwOTgyNTU=","url":"https://api.github.com/repos/godotengine/godot/labels/topic:platforms","name":"topic:platforms","color":"ffee88","default":false,"description":"","archived_at":null,"archived_by":null}],"state":"closed","locked":false,"assignees":[],"milestone":null,"comments":9,"created_at":"2026-09-02T06:02:09Z","updated_at":"2026-09-02T19:12:32Z","closed_at":"2026-09-02T18:34:09Z","assignee":null,"author_association":"NONE","issue_field_values":[],"type":null,"active_lock_reason":null,"draft":false,"pull_request":{"url":"https://api.github.com/repos/godotengine/godot/pulls/123095","html_url":"https://github.com/godotengine/godot/pull/123095","diff_url":"https://github.com/godotengine/godot/pull/123095.diff","patch_url":"https://github.com/godotengine/godot/pull/123095.patch","merged_at":null},"body":"I am developing my game on M5 Pro Macbook Pro. A hit shader binding table only exists where raytracing PIPELINES do: on a device (like mine) that supports ray queries but not pipelines, `rayQueryEXT `never dispatches a hit shader and there is no SBT to index. The check therefore makes TLAS builds impossible on such a device, which no backend has hit before because none has reported `SUPPORTS_RAY_QUERY` without also reporting `SUPPORTS_RAYTRACING_PIPELINE`.\r\n\r\nGate the requirement on `has_feature(SUPPORTS_RAYTRACING_PIPELINE)`. Pipeline-capable devices are validated exactly as before.\r\n\r\nFound while bringing up ray query on the Metal driver, where a TLAS with a valid BLAS and no SBT is the normal case rather than an error.","closed_by":{"login":"AThousandShips","id":96648715,"node_id":"U_kgDOBcK-Cw","avatar_url":"https://avatars.githubusercontent.com/u/96648715?v=4","gravatar_id":"","url":"https://api.github.com/users/AThousandShips","html_url":"https://github.com/AThousandShips","followers_url":"https://api.github.com/users/AThousandShips/followers","following_url":"https://api.github.com/users/AThousandShips/following{/other_user}","gists_url":"https://api.github.com/users/AThousandShips/gists{/gist_id}","starred_url":"https://api.github.com/users/AThousandShips/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/AThousandShips/subscriptions","organizations_url":"https://api.github.com/users/AThousandShips/orgs","repos_url":"https://api.github.com/users/AThousandShips/repos","events_url":"https://api.github.com/users/AThousandShips/events{/privacy}","received_events_url":"https://api.github.com/users/AThousandShips/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/123095/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/godotengine/godot/issues/123095/timeline","performed_via_github_app":null,"state_reason":null}