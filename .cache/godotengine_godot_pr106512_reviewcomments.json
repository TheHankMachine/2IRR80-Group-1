8e92660c72829f","user":{"login":"squk","id":3443591,"node_id":"MDQ6VXNlcjM0NDM1OTE=","avatar_url":"https://avatars.githubusercontent.com/u/3443591?v=4","gravatar_id":"","url":"https://api.github.com/users/squk","html_url":"https://github.com/squk","followers_url":"https://api.github.com/users/squk/followers","following_url":"https://api.github.com/users/squk/following{/other_user}","gists_url":"https://api.github.com/users/squk/gists{/gist_id}","starred_url":"https://api.github.com/users/squk/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/squk/subscriptions","organizations_url":"https://api.github.com/users/squk/orgs","repos_url":"https://api.github.com/users/squk/repos","events_url":"https://api.github.com/users/squk/events{/privacy}","received_events_url":"https://api.github.com/users/squk/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"Specify base 16 here(`xor_mask = int(xor_mask, 16)`)? You must specify 0 as the base in order to invoke this prefix-guessing behavior; if you omit the second parameter, [int()](https://docs.python.org/library/functions.html#int) will assume base-10. And since there's a length check before this, this will never work in its current state. ","created_at":"2025-07-09T20:38:43Z","updated_at":"2025-07-09T20:38:43Z","html_url":"https://github.com/godotengine/godot/pull/106512#discussion_r2195930489","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/106512","_links":{"self":{"href":"https://api.github.com/repos/godotengine/godot/pulls/comments/2195930489"},"html":{"href":"https://github.com/godotengine/godot/pull/106512#discussion_r2195930489"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/106512"}},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/2195930489/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_s