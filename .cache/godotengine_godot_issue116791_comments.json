l_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3980482871","html_url":"https://github.com/godotengine/godot/pull/116791#issuecomment-3980482871","issue_url":"https://api.github.com/repos/godotengine/godot/issues/116791","id":3980482871,"node_id":"IC_kwDOAO6SJc7tQVk3","user":{"login":"ismailivanov","id":64804972,"node_id":"MDQ6VXNlcjY0ODA0OTcy","avatar_url":"https://avatars.githubusercontent.com/u/64804972?v=4","gravatar_id":"","url":"https://api.github.com/users/ismailivanov","html_url":"https://github.com/ismailivanov","followers_url":"https://api.github.com/users/ismailivanov/followers","following_url":"https://api.github.com/users/ismailivanov/following{/other_user}","gists_url":"https://api.github.com/users/ismailivanov/gists{/gist_id}","starred_url":"https://api.github.com/users/ismailivanov/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/ismailivanov/subscriptions","organizations_url":"https://api.github.com/users/ismailivanov/orgs","repos_url":"https://api.github.com/users/ismailivanov/repos","events_url":"https://api.github.com/users/ismailivanov/events{/privacy}","received_events_url":"https://api.github.com/users/ismailivanov/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-03-01T16:45:16Z","updated_at":"2026-03-01T16:45:16Z","body":"> Tested this PR. It works as expected and looks good to me overall. Two nitpicky suggestions:\r\n> \r\n>     * Integrate the enable checkbox as described above.\r\n> \r\n>     * I'm a _bit_ bothered by the name 'Auto Font Size' and would rather name this to include the word 'fit', I think? How about… `Resize Font to Fit`?\r\n\r\n<img width=\"1338\" height=\"103\" alt=\"image\" src=\"https://github.com/user-attachments/assets/9006fcbe-e8e8-4784-8a8d-0597042ff08a\" />\r\n\r\nDo I need to change the variables names too, or should I just change the name in the editor?","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3980482871/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3980624385","html_url":"https://github.com/godotengine/godot/pull/116791#issuecomment-3980624385","issue_url":"https://api.github.com/repos/godotengine/godot/issues/116791","id":3980624385,"node_id":"IC_kwDOAO6SJc7tQ4IB","user":{"login":"AdriaandeJongh","id":5611323,"node_id":"MDQ6VXNlcjU2MTEzMjM=","avatar_url":"https://avatars.githubusercontent.com/u/5611323?v=4","gravatar_id":"","url":"https://api.github.com/users/AdriaandeJongh","html_url":"https://github.com/AdriaandeJongh","followers_url":"https://api.github.com/users/AdriaandeJongh/followers","following_url":"https://api.github.com/users/AdriaandeJongh/following{/other_user}","gists_url":"https://api.github.com/users/AdriaandeJongh/gists{/gist_id}","starred_url":"https://api.github.com/users/AdriaandeJongh/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/AdriaandeJongh/subscriptions","organizations_url":"https://api.github.com/users/AdriaandeJongh/orgs","repos_url":"https://api.github.com/users/AdriaandeJongh/repos","events_url":"https://api.github.com/users/AdriaandeJongh/events{/privacy}","received_events_url":"https://api.github.com/users/AdriaandeJongh/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-03-01T17:55:43Z","updated_at":"2026-03-01T17:55:43Z","body":"I’d change the variable name so that it’s consistent between the code and the inspector, but it’s ultimately not my call as I am not a code maintainer!","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3980624385/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4012141149","html_url":"https://github.com/godotengine/godot/pull/116791#issuecomment-4012141149","issue_url":"https://api.github.com/repos/godotengine/godot/issues/116791","id":4012141149,"node_id":"IC_kwDOAO6SJc7vJGpd","user":{"login":"ismailivanov","id":64804972,"node_id":"MDQ6VXNlcjY0ODA0OTcy","avatar_url":"https://avatars.githubusercontent.com/u/64804972?v=4","gravatar_id":"","url":"https://api.github.com/users/ismailivanov","html_url":"https://github.com/ismailivanov","followers_url":"https://api.github.com/users/ismailivanov/followers","following_url":"https://api.github.com/users/ismailivanov/following{/other_user}","gists_url":"https://api.github.com/users/ismailivanov/gists{/gist_id}","starred_url":"https://api.github.com/users/ismailivanov/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/ismailivanov/subscriptions","organizations_url":"https://api.github.com/users/ismailivanov/orgs","repos_url":"https://api.github.com/users/ismailivanov/repos","events_url":"https://api.github.com/users/ismailivanov/events{/privacy}","received_events_url":"https://api.github.com/users/ismailivanov/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-03-06T14:40:44Z","updated_at":"2026-03-06T14:40:44Z","body":"> Tested this a lot more and found two bugs:\r\n> \r\n>     * On a Label, when `Resize Font to Fit` is enabled and `Autowrap Mode` is set to `Word (Smart)`, the Control can be resized to smaller than the minimum height of the Label making the text disappear entirely – whereas, if `Resize Font to Fit` is disabled, the height can never be smaller than the font height.\r\n> \r\n> \r\n> Screen.Recording.2026-03-05.at.10.05.33.mp4\r\n> \r\n> We should retain the original behavior; text should always be visible, so minimum height should always be enforced.\r\n> \r\n>     * On a RichTextLabel, if you have both `Fit Content` and `Resize Font to Fit` enabled, you can only grow the Control but never shrink it.\r\n> \r\n> \r\n> Screen.Recording.2026-03-05.at.10.12.21.mp4\r\n> \r\n> The expected behavior is that you are able to shrink it to the point where the minimum size is achieved.\r\n> \r\n>     * Other than that, works great.\r\n\r\nYes, I fixed it now, it works without any issues.","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4012141149/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4163502554","html_url":"https://github.com/godotengine/godot/pull/116791#issuecomment-4163502554","issue_url":"https://api.github.com/repos/godotengine/godot/issues/116791","id":4163502554,"node_id":"IC_kwDOAO6SJc74KgHa","user":{"login":"ismailivanov","id":64804972,"node_id":"MDQ6VXNlcjY0ODA0OTcy","avatar_url":"https://avatars.githubusercontent.com/u/64804972?v=4","gravatar_id":"","url":"https://api.github.com/users/ismailivanov","html_url":"https://github.com/ismailivanov","followers_url":"https://api.github.com/users/ismailivanov/followers","following_url":"https://api.github.com/users/ismailivanov/following{/other_user}","gists_url":"https://api.github.com/users/ismailivanov/gists{/gist_id}","starred_url":"https://api.github.com/users/ismailivanov/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/ismailivanov/subscriptions","organizations_url":"https://api.github.com/users/ismailivanov/orgs","repos_url":"https://api.github.com/users/ismailivanov/repos","events_url":"https://api.github.com/users/ismailivanov/events{/privacy}","received_events_url":"https://api.github.com/users/ismailivanov/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-03-31T15:28:26Z","updated_at":"2026-03-31T15:28:26Z","body":"> Tested locally (rebased on top of `master` [06c3946](https://github.com/godotengine/godot/commit/06c3946e3501a7f52a10eed96d200b93df17d373)), it mostly works as expected. Code looks good to me.\r\n> \r\n> Example on the [RichTextLabel demo](https://github.com/godotengine/godot-demo-projects/tree/master/gui/rich_text_bbcode):\r\n> richtextlabel_auto_font_size.mp4\r\n> \r\n> Some feedback:\r\n> \r\n>     * Dropcap (the yellow `F`) and list bullets do not automatically resize, unlike font sizes overridden with `font_size` (which are scaled relative to the theme font size, e.g. `24` is 150% of the default `16`). I consider this a bug, so it'd be good to fix if possible.\r\n> \r\n> \r\n> List bullets in the table as seen below with a small automatic font size:\r\n> <img alt=\"Image\" width=\"451\" height=\"96\" src=\"https://private-user-images.githubusercontent.com/180032/571600813-1bfaf260-3196-4c2a-8ae8-cef7045f0390.png?jwt=eyJ0eXAiOiJKV1QiLCJhbGciOiJIUzI1NiJ9.eyJpc3MiOiJnaXRodWIuY29tIiwiYXVkIjoicmF3LmdpdGh1YnVzZXJjb250ZW50LmNvbSIsImtleSI6ImtleTUiLCJleHAiOjE3NzQ5NzA2NTgsIm5iZiI6MTc3NDk3MDM1OCwicGF0aCI6Ii8xODAwMzIvNTcxNjAwODEzLTFiZmFmMjYwLTMxOTYtNGMyYS04YWU4LWNlZjcwNDVmMDM5MC5wbmc_.Ivh78NdLZQuEgqjKfijUFrdoXVs_SW-i8t5NM_hGBsI\">\r\n> \r\n>     * If floating-point font sizes were supported, fonts could rescale more smoothly and take the full horizontal space of the label more optimally, especially at low font sizes. See #87243.\r\n\r\n<img width=\"2034\" height=\"1081\" alt=\"image\" src=\"https://github.com/user-attachments/assets/1e4b3408-de49-40ee-960e-0eb8b60efb4d\" />\r\n","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4163502554/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4232994570","html_url":"https://github.com/godotengine/godot/pull/116791#issuecomment-4232994570","issue_url":"https://api.github.com/repos/godotengine/godot/issues/116791","id":4232994570,"node_id":"IC_kwDOAO6SJc78Tl8K","user":{"login":"ismailivanov","id":64804972,"node_id":"MDQ6VXNlcjY0ODA0OTcy","avatar_url":"https://avatars.githubusercontent.com/u/64804972?v=4","gravatar_id":"","url":"https://api.github.com/users/ismailivanov","html_url":"https://github.com/ismailivanov","followers_url":"https://api.github.com/users/ismailivanov/followers","following_url":"https://api.github.com/users/ismailivanov/following{/other_user}","gists_url":"https://api.github.com/users/ismailivanov/gists{/gist_id}","starred_url":"https://api.github.com/users/ismailivanov/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/ismailivanov/subscriptions","organizations_url":"https://api.github.com/users/ismailivanov/orgs","repos_url":"https://api.github.com/users/ismailivanov/repos","events_url":"https://api.github.com/users/ismailivanov/events{/privacy}","received_events_url":"https://api.github.com/users/ismailivanov/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-04-12T23:40:44Z","updated_at":"2026-04-12T23:40:44Z","body":"> This works fine with simple embedded images using the new `em` tag\r\n> Recording.2026-04-10.143914.mp4\r\n> \r\n> But fails once you combine the new `em` and existing `font_size` tag, as you can see in the video below, the 2D icon in the large text only scales up to the `maximum_font_size` instead of scaling up to `maximum_font_size * p_base_font_size / theme_cache.normal_font_size`\r\n> Recording.2026-04-10.144732.mp4\r\n> \r\n> You probably need to touch these two lines that were added by #112617:\r\n> \r\n> https://github.com/godotengine/godot/blob/1aabcb9e9bc7a222a972731523831ec86b77ee20/scene/gui/rich_text_label.cpp#L563\r\n> \r\n> https://github.com/godotengine/godot/blob/1aabcb9e9bc7a222a972731523831ec86b77ee20/scene/gui/rich_text_label.cpp#L788\r\n\r\nfixed\r\n\r\nhttps://github.com/user-attachments/assets/e32108c5-d17f-4a9a-a587-c25b154dde07\r\n\r\n","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4232994570/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5290913792","html_url":"https://github.com/godotengine/godot/pull/116791#issuecomment-5290913792","issue_url":"https://api.github.com/repos/godotengine/godot/issues/116791","id":5290913792,"node_id":"IC_kwDOAO6SJc8AAAABO1zwAA","user":{"login":"Jeidoz","id":23425714,"node_id":"MDQ6VXNlcjIzNDI1NzE0","avatar_url":"https://avatars.githubusercontent.com/u/23425714?v=4","gravatar_id":"","url":"https://api.github.com/users/Jeidoz","html_url":"https://github.com/Jeidoz","followers_url":"https://api.github.com/users/Jeidoz/followers","following_url":"https://api.github.com/users/Jeidoz/following{/other_user}","gists_url":"https://api.github.com/users/Jeidoz/gists{/gist_id}","starred_url":"https://api.github.com/users/Jeidoz/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Jeidoz/subscriptions","organizations_url":"https://api.github.com/users/Jeidoz/orgs","repos_url":"https://api.github.com/users/Jeidoz/repos","events_url":"https://api.github.com/users/Jeidoz/events{/privacy}","received_events_url":"https://api.github.com/users/Jeidoz/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-08-14T07:53:10Z","updated_at":"2026-08-14T07:53:10Z","body":"@ismailivanov\r\n\r\nI'm following this PR and noticed it's been marked as \"Merge Ready\" for a while now, with positi