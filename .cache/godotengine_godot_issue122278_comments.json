s/Synzorasize/subscriptions","organizations_url":"https://api.github.com/users/Synzorasize/orgs","repos_url":"https://api.github.com/users/Synzorasize/repos","events_url":"https://api.github.com/users/Synzorasize/events{/privacy}","received_events_url":"https://api.github.com/users/Synzorasize/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-08-11T20:32:57Z","updated_at":"2026-08-11T20:32:57Z","body":"> I plan to go over all the icons again soon enough, if no one has done so yet. Not to stop the PR, just saying what my plans are.\r\n\r\nOh, while making #122195, I also decided to optimize the rest of the icons with `SVGO` in a separate branch to see what would happen. 520 icons were optimized. Should I make the PR? Of course, you can also look over them to see if any other changes can be made. I tested them out, though, and they seem to work.","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5258528986/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5258663205","html_url":"https://github.com/godotengine/godot/pull/122278#issuecomment-5258663205","issue_url":"https://api.github.com/repos/godotengine/godot/issues/122278","id":5258663205,"node_id":"IC_kwDOAO6SJc8AAAABOXDVJQ","user":{"login":"aaronfranke","id":1646875,"node_id":"MDQ6VXNlcjE2NDY4NzU=","avatar_url":"https://avatars.githubusercontent.com/u/1646875?v=4","gravatar_id":"","url":"https://api.github.com/users/aaronfranke","html_url":"https://github.com/aaronfranke","followers_url":"https://api.github.com/users/aaronfranke/followers","following_url":"https://api.github.com/users/aaronfranke/following{/other_user}","gists_url":"https://api.github.com/users/aaronfranke/gists{/gist_id}","starred_url":"https://api.github.com/u