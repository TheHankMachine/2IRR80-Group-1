d_at":null,"archived_by":null},{"id":3240950060,"node_id":"MDU6TGFiZWwzMjQwOTUwMDYw","url":"https://api.github.com/repos/godotengine/godot/labels/performance","name":"performance","color":"447777","default":false,"description":"","archived_at":null,"archived_by":null},{"id":8089024095,"node_id":"LA_kwDOAO6SJc8AAAAB4iS2Xw","url":"https://api.github.com/repos/godotengine/godot/labels/cherrypick:4.4","name":"cherrypick:4.4","color":"446699","default":false,"description":"Considered for cherry-picking into a future 4.4.x release","archived_at":null,"archived_by":null}],"state":"closed","locked":false,"assignees":[],"milestone":{"url":"https://api.github.com/repos/godotengine/godot/milestones/22","html_url":"https://github.com/godotengine/godot/milestone/22","labels_url":"https://api.github.com/repos/godotengine/godot/milestones/22/labels","id":12070367,"node_id":"MI_kwDOAO6SJc4AuC3f","number":22,"title":"4.5","description":"","creator":{"login":"Sauermann","id":6299227,"node_id":"MDQ6VXNlcjYyOTkyMjc=","avatar_url":"https://avatars.githubusercontent.com/u/6299227?v=4","gravatar_id":"","url":"https://api.github.com/users/Sauermann","html_url":"https://github.com/Sauermann","followers_url":"https://api.github.com/users/Sauermann/followers","following_url":"https://api.github.com/users/Sauermann/following{/other_user}","gists_url":"https://api.github.com/users/Sauermann/gists{/gist_id}","starred_url":"https://api.github.com/users/Sauermann/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Sauermann/subscriptions","organizations_url":"https://api.github.com/users/Sauermann/orgs","repos_url":"https://api.github.com/users/Sauermann/repos","events_url":"https://api.github.com/users/Sauermann/events{/privacy}","received_events_url":"https://api.github.com/users/Sauermann/received_events","type":"User","user_view_type":"public","site_admin":false},"open_issues":3,"closed_issues":3687,"state":"closed","created_at":"2024-12-19T08:51:28Z","updated_at":"2026-09-04T21:48:38Z","due_on":"2025-09-15T00:00:00Z","closed_at":"2025-09-18T17:13:14Z"},"comments":6,"created_at":"2025-03-21T17:53:16Z","updated_at":"2025-03-28T14:07:34Z","closed_at":"2025-03-28T13:39:44Z","assignee":null,"author_association":"MEMBER","issue_field_values":[],"type":null,"active_lock_reason":null,"draft":false,"pull_request":{"url":"https://api.github.com/repos/godotengine/godot/pulls/104455","html_url":"https://github.com/godotengine/godot/pull/104455","diff_url":"https://github.com/godotengine/godot/pull/104455.diff","patch_url":"https://github.com/godotengine/godot/pull/104455.patch","merged_at":"2025-03-28T13:39:43Z"},"body":"This decreases editor startup time by ~0.35s (8%).\r\n\r\nIt should be possible to safely cherry-pick this back to 4.4.\r\n\r\n## Explanation \r\n\r\nI have previously profiled that `ubrk_open` was causing substantial delays in editor startup times (#102129).\r\nI've dug a bit deeper into the code, and found that cloning `UBreakIterator` instances instead of creating them from scratch doesn't parse the locale (rules?) again (which was the slow part). So, in the interest of speed, I've implemented a method to cache a blueprint `UBreakIterator` for each locale, and only clone it when we need a new one. \r\n\r\nThis is not only faster than #102129, but also better in terms of RAM use — because not every `FontAdvanced` instance needs their own `UBreakIterator` caches. Instead, we only have one for each locale globally.\r\n\r\n## Benchmarks\r\nI benchmarked a ~0.35s (8%) decrease in editor startup time:\r\n\r\n```\r\n ❯ hyperfine -m25 -iw1 \"bin/godot.macos.editor.arm64.master --path /Users/lukas/dev/godot/empty-game --editor --quit\" \"bin/godot.macos.editor.arm64 --path /Users/lukas/dev/godot/empty-game --editor --quit\"\r\nBenchmark 1: bin/godot.macos.editor.arm64.master --path /Users/lukas/dev/godot/empty-game --editor --quit\r\n  Time (mean ± σ):      4.781 s ±  0.120 s    [User: 3.266 s, System: 0.406 s]\r\n  Range (min … max):    4.469 s …  4.974 s    25 runs\r\n\r\nBenchmark 2: bin/godot.macos.editor.arm64 --path /Users/lukas/dev/godot/empty-game --editor --quit\r\n  Time (mean ± σ):      4.435 s ±  0.095 s    [User: 3.011 s, System: 0.387 s]\r\n  Range (min … max):    4.250 s …  4.557 s    25 runs\r\n\r\nSummary\r\n  bin/godot.macos.editor.arm64 --path /Users/lukas/dev/godot/empty-game --editor --quit ran\r\n    1.08 ± 0.04 times faster than bin/godot.macos.editor.arm64.master --path /Users/lukas/dev/godot/empty-game --editor --quit\r\n```\r\n","closed_by":{"login":"akien-mga","id":4701338,"node_id":"MDQ6VXNlcjQ3MDEzMzg=","avatar_url":"https://avatars.githubusercontent.com/u/4701338?v=4","gravatar_id":"","url":"https://api.github.com/users/akien-mga","html_url":"https://github.com/akien-mga","followers_url":"https://api.github.com/users/akien-mga/followers","following_url":"https://api.github.com/users/akien-mga/following{/other_user}","gists_url":"https://api.github.com/users/akien-mga/gists{/gist_id}","starred_url":"https://api.github.com/users/akien-mga/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/akien-mga/subscriptions","organizations_url":"https://api.github.com/users/akien-mga/orgs","repos_url":"https://api.github.com/users/akien-mga/repos","events_url":"https://api.github.com/users/akien-mga/events{/privacy}","received_events_url":"https://api.github.com/users/akien-mga/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/104455/reactions","total_count":23,"+1":6,"-1":0,"laugh":0,"hooray":9,"confused":0,"heart":0,"rocket":8,"eyes":0},"timeline_url":"https://api.github.com/repos/godotengine/godot/issues/104455/timeline","performed_via_github_app":null,"state_reason":null}