_by":null},{"id":279098219,"node_id":"MDU6TGFiZWwyNzkwOTgyMTk=","url":"https://api.github.com/repos/godotengine/godot/labels/topic:editor","name":"topic:editor","color":"ffee88","default":false,"description":"","archived_at":null,"archived_by":null}],"state":"closed","locked":false,"assignees":[],"milestone":null,"comments":3,"created_at":"2025-02-08T10:21:04Z","updated_at":"2026-02-07T12:36:21Z","closed_at":"2025-02-09T03:34:14Z","assignee":null,"author_association":"CONTRIBUTOR","issue_field_values":[],"type":null,"active_lock_reason":null,"draft":false,"pull_request":{"url":"https://api.github.com/repos/godotengine/godot/pulls/102577","html_url":"https://github.com/godotengine/godot/pull/102577","diff_url":"https://github.com/godotengine/godot/pull/102577.diff","patch_url":"https://github.com/godotengine/godot/pull/102577.patch","merged_at":null},"body":"This pull request resolves a common issue when working with the tile atlas view in the editor: if you have light-colored tiles with transparent backgrounds, the checkerboard pattern makes it very difficult to view them.\r\n\r\nAdding a simple toggle button to the view is the simplest and most convenient solution.\r\n\r\nhttps://github.com/user-attachments/assets/5930416c-4cec-4bcc-9a05-8084b1da0e57\r\n\r\nThe checkerboard pattern introduces a lot of visual \"noise\" when viewing tiles with transparency and light color, making it difficult to parse details:\r\n<img width=\"1055\" alt=\"Screenshot 2025-02-08 044709\" src=\"https://github.com/user-attachments/assets/85465c71-8604-490f-a014-d8eef965a832\" />\r\n\r\nThis issue is exacerbated even more if the user happens to also be using a light theme:\r\n<img width=\"1046\" alt=\"light theme\" src=\"https://github.com/user-attachments/assets/2effa280-c180-49ec-b77c-c59a7ae7902e\" />\r\n\r\nSimply disabling the checkerboard pattern fixes this entirely. Now everything is very clear:\r\n<img width=\"1051\" alt=\"Screenshot 2025-02-08 044733\" src=\"https://github.com/user-attachments/assets/682e576c-4326-4643-9a93-f71c539dbbda\" />\r\n\r\n<img width=\"1046\" alt=\"light theme 2\" src=\"https://github.com/user-attachments/assets/7371fee0-9b05-42bb-a3ad-bc101ff44c83\" />\r\n","closed_by":{"login":"SirQuartz","id":62965063,"node_id":"MDQ6VXNlcjYyOTY1MDYz","avatar_url":"https://avatars.githubusercontent.com/u/62965063?v=4","gravatar_id":"","url":"https://api.github.com/users/SirQuartz","html_url":"https://github.com/SirQuartz","followers_url":"https://api.github.com/users/SirQuartz/followers","following_url":"https://api.github.com/users/SirQuartz/following{/other_user}","gists_url":"https://api.github.com/users/SirQuartz/gists{/gist_id}","starred_url":"https://api.github.com/users/SirQuartz/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/SirQuartz/subscriptions","organizations_url":"https://api.github.com/users/SirQuartz/orgs","repos_url":"https://api.github.com/users/SirQuartz/repos","events_url":"https://api.github.com/users/SirQuartz/events{/privacy}","received_events_url":"https://api.github.com/users/SirQuartz/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/102577/reactions","total_count":6,"+1":4,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":2},"timeline_url":"https://api.github.com/repos/godotengine/godot/issues/102577/timeline","performed_via_github_app":null,"state_reason":null}