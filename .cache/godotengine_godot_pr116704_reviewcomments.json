thub.com/users/miguelrsgoncalves/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"Does that mean that I cannot call Editor functions in scenes at all?\n\nIf so, I will see if I can use the process_name() later during UI setup, because the capitalization in the material.cpp was messing up that process.","created_at":"2026-02-24T10:11:30Z","updated_at":"2026-02-24T10:11:30Z","html_url":"https://github.com/godotengine/godot/pull/116704#discussion_r2845829378","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/116704","_links":{"self":{"href":"https://api.github.com/repos/godotengine/godot/pulls/comments/2845829378"},"html":{"href":"https://github.com/godotengine/godot/pull/116704#discussion_r2845829378"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/116704"}},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/2845829378/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":null,"original_line":37,"side":"RIGHT","in_reply_to_id":2845630277,"author_association":"CONTRIBUTOR","original_position":4,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/2845854975","pull_request_review_id":3846563010,"id":2845854975,"node_id":"PRRC_kwDOAO6SJc6poEz_","diff_hunk":"@@ -34,6 +34,7 @@\n #include \"core/config/project_settings.h\"\n #include \"core/error/error_macros.h\"\n #include \"core/version.h\"\n+#include \"editor/inspector/editor_property_name_processor.h\"","path":"scene/resources/material.cpp","commit_id":"6ccc760f8afc9d54dceda13b0e9d55f69fa03126","original_commit_id":"6ccc760f8afc9d54dceda13b0e9d55f69fa03126","user":{"login":"AThousandShips","id":96648715,"node_id":"U_kgDOBcK-Cw","avatar_url":"https://avatars.githubusercontent.com/u/96648715?v=4","gravatar_id":"","url":"https://api.github.com/users/AThousandShips","html_url":"https://github.com/AThousandShips","followers_url":"https://api.github.com/users/AThousandShips/followers","following_url":"https://api.github.com/users/AThousandShips/following{/other_user}","gists_url":"https://api.github.com/users/AThousandShips/gists{/gist_id}","starred_url":"https://api.github.com/users/AThousandShips/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/AThousandShips/subscriptions","organizations_url":"https://api.github.com/users/AThousandShips/orgs","repos_url":"https://api.github.com/users/AThousandShips/repos","events_url":"https://api.github.com/users/AThousandShips/events{/privacy}","received_events_url":"https://api.github.com/users/AThousandShips/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"Generally yes, I'd say this should be done in another way\r\n\r\nBut if this approach is approved it needs `#ifdef TOOLS_ENABLED`","created_at":"2026-02-24T10:15:21Z","updated_at":"2026-02-24T10:15:43Z","html_url":"https://github.com/godotengine/godot/pull/116704#discussion_r2845854975","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/116704","_links":{"self":{"href":"https://api.github.com/repos/godotengine/godot/pulls/comments/2845854975"},"html":{"href":"https://github.com/godotengine/godot/pull/116704#discussion_r2845854975"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/116704"}},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/2845854975/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":null,"original_line":37,"side":"RIGHT","in_reply_to_id":2845630277,"author_association":"MEMBER","original_position":4,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/2846799136","pull_request_review_id":3847548500,"id":2846799136,"node_id":"PRRC_kwDOAO6SJc6prrUg","diff_hunk":"@@ -34,6 +34,7 @@\n #include \"core/config/project_settings.h\"\n #include \"core/error/error_macros.h\"\n #include \"core/version.h\"\n+#include \"editor/inspector/editor_property_name_processor.h\"","path":"scene/resources/material.cpp","commit_id":"6ccc760f8afc9d54dceda13b0e9d55f69fa03126","original_commit_id":"6ccc760f8afc9d54dceda13b0e9d55f69fa03126","user":{"login":"miguelrsgoncalves","id":199957095,"node_id":"U_kgDOC-saZw","avatar_url":"https://avatars.githubusercontent.com/u/199957095?v=4","gravatar_id":"","url":"https://api.github.com/users/miguelrsgoncalves","html_url":"https://github.com/miguelrsgoncalves","followers_url":"https://api.github.com/users/miguelrsgoncalves/followers","following_url":"https://api.github.com/users/miguelrsgoncalves/following{/other_user}","gists_url":"https://api.github.com/users/miguelrsgoncalves/gists{/gist_id}","starred_url":"https://api.github.com/users/miguelrsgoncalves/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/miguelrsgoncalves/subscriptions","organizations_url":"https://api.github.com/users/miguelrsgoncalves/orgs","repos_url":"https://api.github.com/users/miguelrsgoncalves/repos","events_url":"https://api.github.com/users/miguelrsgoncalves/events{/privacy}","received_events_url":"https://api.github.com/users/miguelrsgoncalves/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"This is the section where the group and sub-group labels get processed to be shown on the editor.\r\n\r\n`editor_inspector.cpp`: line 4282-4300\r\n```\r\n// Don't localize groups for script variables.\r\nEditorPropertyNameProcessor::Style section_name_style = property_name_style;\r\nif ((p.usage & PROPERTY_USAGE_SCRIPT_VARIABLE) && section_name_style == EditorPropertyNameProcessor::STYLE_LOCALIZED) {\r\n  section_name_style = EditorPropertyNameProcessor::STYLE_CAPITALIZED;\r\n}\r\n\r\n// Only process group label if this is not the group or subgroup.\r\nif ((i == 0 && component == group) || (i == 1 && component == subgroup)) {\r\n  if (section_name_style == EditorPropertyNameProcessor::STYLE_LOCALIZED) {\r\n    label = EditorPropertyNameProcessor::get_singleton()->translate_group_name(component);\r\n    tooltip = component;\r\n  } else {\r\n    label = component;\r\n    tooltip = EditorPropertyNameProcessor::get_singleton()->translate_group_name(component);\r\n  }\r\n  } else {\r\n    label = EditorPropertyNameProcessor::get_singleton()->process_name(component, section_name_style, p.name, doc_name);\r\n    tooltip = EditorPropertyNameProcessor::get_singleton()->process_name(component, EditorPropertyNameProcessor::get_tooltip_style(section_name_style), p.name, doc_name);\r\n}\r\n```\r\n\r\nIt processes all groups and subgroup labels, with exception if they are written by the developer, for example in GDScript on export_group() and export_subgroup().\r\n\r\nGDScript:\r\n<img width=\"278\" height=\"215\" alt=\"image\" src=\"https://github.com/user-attachments/assets/7bbb3c6b-a6c9-4f6c-b73e-53eea90caef2\" />\r\n\r\nBefore, the capitalize() on the `material.cpp` made the shader groups and subgroups get capitalized without following the `EditorPropertyNameProcessor::get_singleton()->process_name()`, but now if I take the capitalization out, the groups and sub-groups actually follow the GSCript convention of the labels staying the exact same as the developer wrote them:\r\n<img width=\"273\" height=\"242\" alt=\"image\" src=\"https://github.com/user-attachments/assets/83e65160-ea39-4a5a-87cb-ea17b4998b36\" />\r\n\r\n\r\nI actually think this is better than doing the process_name for shader groups and subgroups, as it is more consistent on the UI and it will not be necessary to have the Editor reference on `material.cpp`. What do you think?","created_at":"2026-02-24T12:32:39Z","updated_at":"2026-02-24T12:33:58Z","html_url":"https://github.com/godotengine/godot/pull/116704#discussion_r2846799136","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/116704","_links":{"self":{"href":"https://api.github.com/repos/godotengine/godot/pulls/comments/2846799136"},"html":{"href":"https://github.com/godotengine/godot/pull/116704#discussion_r2846799136"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/116704"}},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/2846799136/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":null,"original_line":37,"side":"RIGHT","in_reply_to_id":2845630277,"author_association":"CONTRIBUTOR","original_position":4,"position":1,"subject_type":"line"}]