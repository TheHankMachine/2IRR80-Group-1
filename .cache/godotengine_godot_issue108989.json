g Global.types.\n\n### Minimal reproduction project (MRP)\n\n[MinimalProject.zip](https://github.com/user-attachments/files/21442236/MinimalProject.zip)","closed_by":{"login":"angelator312","id":112373005,"node_id":"U_kgDOBrKtDQ","avatar_url":"https://avatars.githubusercontent.com/u/112373005?v=4","gravatar_id":"","url":"https://api.github.com/users/angelator312","html_url":"https://github.com/angelator312","followers_url":"https://api.github.com/users/angelator312/followers","following_url":"https://api.github.com/users/angelator312/following{/other_user}","gists_url":"https://api.github.com/users/angelator312/gists{/gist_id}","starred_url":"https://api.github.com/users/angelator312/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/angelator312/subscriptions","organizations_url":"https://api.github.com/users/angelator312/orgs","repos_url":"https://api.github.com/users/angelator312/repos","events_url":"https://api.github.com/users/angelator312/events{/privacy}","received_events_url":"https://api.github.com/users/angelator312/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/108989/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/godotengine/godot/issues/108989/timeline","performed_via_github_app":null,"state_reason":"completed","pinned_comment":null}