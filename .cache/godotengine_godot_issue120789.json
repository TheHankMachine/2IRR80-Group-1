ull}],"state":"closed","locked":false,"assignees":[],"milestone":{"url":"https://api.github.com/repos/godotengine/godot/milestones/25","html_url":"https://github.com/godotengine/godot/milestone/25","labels_url":"https://api.github.com/repos/godotengine/godot/milestones/25/labels","id":15520464,"node_id":"MI_kwDOAO6SJc4A7NLQ","number":25,"title":"4.8","description":"","creator":{"login":"Repiteo","id":17489292,"node_id":"MDQ6VXNlcjE3NDg5Mjky","avatar_url":"https://avatars.githubusercontent.com/u/17489292?v=4","gravatar_id":"","url":"https://api.github.com/users/Repiteo","html_url":"https://github.com/Repiteo","followers_url":"https://api.github.com/users/Repiteo/followers","following_url":"https://api.github.com/users/Repiteo/following{/other_user}","gists_url":"https://api.github.com/users/Repiteo/gists{/gist_id}","starred_url":"https://api.github.com/users/Repiteo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Repiteo/subscriptions","organizations_url":"https://api.github.com/users/Repiteo/orgs","repos_url":"https://api.github.com/users/Repiteo/repos","events_url":"https://api.github.com/users/Repiteo/events{/privacy}","received_events_url":"https://api.github.com/users/Repiteo/received_events","type":"User","user_view_type":"public","site_admin":false},"open_issues":343,"closed_issues":2335,"state":"open","created_at":"2026-04-13T15:59:35Z","updated_at":"2026-10-22T06:28:22Z","due_on":null,"closed_at":null},"comments":2,"created_at":"2026-06-30T20:56:27Z","updated_at":"2026-08-24T18:50:17Z","closed_at":"2026-08-24T17:10:38Z","assignee":null,"author_association":"CONTRIBUTOR","issue_field_values":[],"type":null,"active_lock_reason":null,"draft":false,"pull_request":{"url":"https://api.github.com/repos/godotengine/godot/pulls/120789","html_url":"https://github.com/godotengine/godot/pull/120789","diff_url":"https://github.com/godotengine/godot/pull/120789.diff","patch_url":"https://github.com/godotengine/godot/pull/120789.patch","merged_at":"2026-08-24T17:10:38Z"},"body":"<!--\r\nPlease target the `master` branch. We will take care of backporting relevant fixes to older versions.\r\n\r\nBefore submitting, please read our checklist for contributors:\r\nhttps://contributing.godotengine.org/en/latest/engine/introduction.html#checklist-for-new-contributors\r\n\r\nUse of AI must be disclosed and should include a description of how it was used.\r\n-->\r\n\r\n## What problem(s) does this PR solve?\r\n\r\nI did not open an issue for this problem, but while working on some other PRs, I found myself unsure of whether the TextEdit APIs used zero- or one-based line and column numbers. \r\n\r\n## Additional information\r\n\r\nBy looking through the methods' source code, I determined they were all zero-based (e.g., line 0 refers to the first line, line 1 refers to the second line).\r\n\r\nThis PR specifies this fact in a note on TextEdit's description.\r\n\r\n> [!note]\r\n> A part of me would also like to add this note to specific methods' descriptions, as I know I can tend to jump straight to a specific method on the page without reading the \"general\" description first. But if that were to be done, it might be difficult to determine which descriptions should receive the additional information, and either way it would result in a lot of duplicate information.\r\n> \r\n> Maybe just referring to `line` as \"zero-indexed\" would keep it from growing the size of the page too much, while also giving the information to the user where they're looking for it? Something like changing\r\n> > Returns the text of a specific line.\r\n> \r\n> to\r\n> \r\n> > Returns the text of a specific zero-indexed line.\r\n> \r\n> ?\r\n> If you think this would be better than the PR's current approach, I can go through and add \"zero-indexed\" (or similar) where it seems appropriate for this PR.\r\n","closed_by":{"login":"Repiteo","id":17489292,"node_id":"MDQ6VXNlcjE3NDg5Mjky","avatar_url":"https://avatars.githubusercontent.com/u/17489292?v=4","gravatar_id":"","url":"https://api.github.com/users/Repiteo","html_url":"https://github.com/Repiteo","followers_url":"https://api.github.com/users/Repiteo/followers","following_url":"https://api.github.com/users/Repiteo/following{/other_user}","gists_url":"https://api.github.com/users/Repiteo/gists{/gist_id}","starred_url":"https://api.github.com/users/Repiteo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Repiteo/subscriptions","organizations_url":"https://api.github.com/users/Repiteo/orgs","repos_url":"https://api.github.com/users/Repiteo/repos","events_url":"https://api.github.com/users/Repiteo/events{/privacy}","received_events_url":"https://api.github.com/users/Repiteo/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/120789/reactions","total_count":2,"+1":2,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/godotengine/godot/issues/120789/timeline","performed_via_github_app":null,"state_reason":null}