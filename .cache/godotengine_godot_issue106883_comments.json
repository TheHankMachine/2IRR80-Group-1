[{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2915200231","html_url":"https://github.com/godotengine/godot/pull/106883#issuecomment-2915200231","issue_url":"https://api.github.com/repos/godotengine/godot/issues/106883","id":2915200231,"node_id":"IC_kwDOAO6SJc6twmzn","user":{"login":"lawnjelly","id":21999379,"node_id":"MDQ6VXNlcjIxOTk5Mzc5","avatar_url":"https://avatars.githubusercontent.com/u/21999379?v=4","gravatar_id":"","url":"https://api.github.com/users/lawnjelly","html_url":"https://github.com/lawnjelly","followers_url":"https://api.github.com/users/lawnjelly/followers","following_url":"https://api.github.com/users/lawnjelly/following{/other_user}","gists_url":"https://api.github.com/users/lawnjelly/gists{/gist_id}","starred_url":"https://api.github.com/users/lawnjelly/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/lawnjelly/subscriptions","organizations_url":"https://api.github.com/users/lawnjelly/orgs","repos_url":"https://api.github.com/users/lawnjelly/repos","events_url":"https://api.github.com/users/lawnjelly/events{/privacy}","received_events_url":"https://api.github.com/users/lawnjelly/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-05-28T07:02:30Z","updated_at":"2025-05-28T07:02:30Z","body":"Great that you are working on this, I wasn't aware that #100244 didn't lead to a fix.\r\n\r\nI'll try and review and test soon, and check there isn't a similar problem in 3.x. :+1: ","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2915200231/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2915271578","html_url":"https://github.com/godotengine/godot/pull/106883#issuecomment-2915271578","issue_url":"https://api.github.com/repos/godotengine/godot/issues/106883","id":2915271578,"node_id":"IC_kwDOAO6SJc6tw4Oa","user":{"login":"lawnjelly","id":21999379,"node_id":"MDQ6VXNlcjIxOTk5Mzc5","avatar_url":"https://avatars.githubusercontent.com/u/21999379?v=4","gravatar_id":"","url":"https://api.github.com/users/lawnjelly","html_url":"https://github.com/lawnjelly","followers_url":"https://api.github.com/users/lawnjelly/followers","following_url":"https://api.github.com/users/lawnjelly/following{/other_user}","gists_url":"https://api.github.com/users/lawnjelly/gists{/gist_id}","starred_url":"https://api.github.com/users/lawnjelly/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/lawnjelly/subscriptions","organizations_url":"https://api.github.com/users/lawnjelly/orgs","repos_url":"https://api.github.com/users/lawnjelly/repos","events_url":"https://api.github.com/users/lawnjelly/events{/privacy}","received_events_url":"https://api.github.com/users/lawnjelly/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-05-28T07:29:11Z","updated_at":"2025-05-28T07:29:11Z","body":"When I add a `print_line()` just before emitting the signal, I only see one signal when loading both a game, and the editor (for trucktown), suggesting it is working correctly already at startup for these.\r\n\r\nIs there a particular scenario where this problem occurs at startup / loading?","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2915271578/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2917666808","html_url":"https://github.com/godotengine/godot/pull/106883#issuecomment-2917666808","issue_url":"https://api.github.com/repos/godotengine/godot/issues/106883","id":2917666808,"node_id":"IC_kwDOAO6SJc6t6A_4","user":{"login":"KoBeWi","id":2223172,"node_id":"MDQ6VXNlcjIyMjMxNzI=","avatar_url":"https://avatars.githubusercontent.com/u/2223172?v=4","gravatar_id":"","url":"https://api.github.com/users/KoBeWi","html_url":"https://github.com/KoBeWi","followers_url":"https://api.github.com/users/KoBeWi/followers","following_url":"https://api.github.com/users/KoBeWi/following{/other_user}","gists_url":"https://api.github.com/users/KoBeWi/gists{/gist_id}","starred_url":"https://api.github.com/users/KoBeWi/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/KoBeWi/subscriptions","organizations_url":"https://api.github.com/users/KoBeWi/orgs","repos_url":"https://api.github.com/users/KoBeWi/repos","events_url":"https://api.github.com/users/KoBeWi/events{/privacy}","received_events_url":"https://api.github.com/users/KoBeWi/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-05-28T21:32:27Z","updated_at":"2025-05-28T21:32:44Z","body":"> Is there a particular scenario where this problem occurs at startup / loading?\r\n\r\nThe signal should not emit at startup at all, because the settings are being initialized, not changed. Unless something relies on this behavior, but I don't know anything like that.","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2917666808/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2918320753","html_url":"https://github.com/godotengine/godot/pull/106883#issuecomment-2918320753","issue_url":"https://api.github.com/repos/godotengine/godot/issues/106883","id":2918320753,"node_id":"IC_kwDOAO6SJc6t8gpx","user":{"login":"lawnjelly","id":21999379,"node_id":"MDQ6VXNlcjIxOTk5Mzc5","avatar_url":"https://avatars.githubusercontent.com/u/21999379?v=4","gravatar_id":"","url":"https://api.github.com/users/lawnjelly","html_url":"https://github.com/lawnjelly","followers_url":"https://api.github.com/users/lawnjelly/followers","following_url":"https://api.github.com/users/lawnjelly/following{/other_user}","gists_url":"https://api.github.com/users/lawnjelly/gists{/gist_id}","starred_url":"https://api.github.com/users/lawnjelly/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/lawnjelly/subscriptions","organizations_url":"https://api.github.com/users/lawnjelly/orgs","repos_url":"https://api.github.com/users/lawnjelly/repos","events_url":"https://api.github.com/users/lawnjelly/events{/privacy}","received_events_url":"https://api.github.com/users/lawnjelly/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-05-29T05:17:21Z","updated_at":"2025-05-29T05:24:26Z","body":"> The signal should not emit at startup at all, because the settings are being initialized, not changed. Unless something relies on this behavior, but I don't know anything like that.\r\n\r\nDisagree here, I think:\r\n* When initializing, the settings _have_ changed. Initialization is a _type_ of change. Put another way, if there was no change, we would never need to initialize. :stuck_out_tongue: \r\n* The signal is a convenient place to update local stuff _after_ all initialization is complete, and avoiding any order of construction issues\r\n\r\nIt is likely useful for third party code to just put their settings update code in one place and have it done like this, and without it, users are likely to end up scratching their heads thinking \"why isn't it called? is this a bug?\".\r\n\r\nFor the main engine, it should imo be tolerant to at least _a single_ `settings_changed` signal at startup. Anything _heavy_ should already have a noop check for cases where the setting has not changed (e.g. changing shadow atlas sizes etc). If this operation is not slick, then we have bigger problems to worry about.\r\n\r\nAlso, removing this signal at initialization is compat breaking I think.","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2918320753/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2918806817","html_url":"https://github.com/godotengine/godot/pull/106883#issuecomment-2918806817","issue_url":"https://api.github.com/repos/godotengine/godot/issues/106883","id":2918806817,"node_id":"IC_kwDOAO6SJc6t-XUh","user":{"login":"KoBeWi","id":2223172,"node_id":"MDQ6VXNlcjIyMjMxNzI=","avatar_url":"https://avatars.githubusercontent.com/u/2223172?v=4","gravatar_id":"","url":"https://api.github.com/users/KoBeWi","html_url":"https://github.com/KoBeWi","followers_url":"https://api.github.com/users/KoBeWi/followers","following_url":"https://api.github.com/users/KoBeWi/following{/other_user}","gists_url":"https://api.github.com/users/KoBeWi/gists{/gist_id}","starred_url":"https://api.github.com/users/KoBeWi/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/KoBeWi/subscriptions","organizations_url":"https://api.github.com/users/KoBeWi/orgs","repos_url":"https://api.github.com/users/KoBeWi/repos","events_url":"https://api.github.com/users/KoBeWi/events{/privacy}","received_events_url":"https://api.github.com/users/KoBeWi/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-05-29T09:15:52Z","updated_at":"2025-05-29T09:17:13Z","body":"The launch signal would be useful if it was guaranteed to be emitted for every node. If you enable a plugin after the editor has loaded, you won't receive it. So realistically user plugins can't rely on it, and core plugins risk having bugs if they happen to load too late (or too early).","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2918806817/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null}]