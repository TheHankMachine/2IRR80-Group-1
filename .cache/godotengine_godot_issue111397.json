odotengine/godot/issues/111107\r\n* https://github.com/godotengine/godot-proposals/issues/10804\r\n\r\nNote: this PR previously tried to fix element returning methods returning Variant as well, which wasn't correct as dalexeev explained below. This PR is now only focused on returning correctly typed arrays for the aforementioned dictionary methods. ","closed_by":{"login":"ultsi","id":6347200,"node_id":"MDQ6VXNlcjYzNDcyMDA=","avatar_url":"https://avatars.githubusercontent.com/u/6347200?v=4","gravatar_id":"","url":"https://api.github.com/users/ultsi","html_url":"https://github.com/ultsi","followers_url":"https://api.github.com/users/ultsi/followers","following_url":"https://api.github.com/users/ultsi/following{/other_user}","gists_url":"https://api.github.com/users/ultsi/gists{/gist_id}","starred_url":"https://api.github.com/users/ultsi/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/ultsi/subscriptions","organizations_url":"https://api.github.com/users/ultsi/orgs","repos_url":"https://api.github.com/users/ultsi/repos","events_url":"https://api.github.com/users/ultsi/events{/privacy}","received_events_url":"https://api.github.com/users/ultsi/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/111397/reactions","total_count":14,"+1":10,"-1":0,"laugh":0,"hooray":1,"confused":0,"heart":1,"rocket":0,"eyes":2},"timeline_url":"https://api.github.com/repos/godotengine/godot/issues/111397/timeline","performed_via_github_app":null,"state_reason":null}