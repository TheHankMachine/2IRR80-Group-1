9952/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5419501823","html_url":"https://github.com/godotengine/godot/pull/122711#issuecomment-5419501823","issue_url":"https://api.github.com/repos/godotengine/godot/issues/122711","id":5419501823,"node_id":"IC_kwDOAO6SJc8AAAABQwcI_w","user":{"login":"Synzorasize","id":60207816,"node_id":"MDQ6VXNlcjYwMjA3ODE2","avatar_url":"https://avatars.githubusercontent.com/u/60207816?v=4","gravatar_id":"","url":"https://api.github.com/users/Synzorasize","html_url":"https://github.com/Synzorasize","followers_url":"https://api.github.com/users/Synzorasize/followers","following_url":"https://api.github.com/users/Synzorasize/following{/other_user}","gists_url":"https://api.github.com/users/Synzorasize/gists{/gist_id}","starred_url":"https://api.github.com/users/Synzorasize/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Synzorasize/subscriptions","organizations_url":"https://api.github.com/users/Synzorasize/orgs","repos_url":"https://api.github.com/users/Synzorasize/repos","events_url":"https://api.github.com/users/Synzorasize/events{/privacy}","received_events_url":"https://api.github.com/users/Synzorasize/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-08-26T01:53:01Z","updated_at":"2026-08-26T01:53:01Z","body":"Okay, the error `INTERNAL ERROR: GDScript bug (please report): Unexpected datatype kind.` appears when an enum is used with `.` like `var prop = Key.` This means that the check against enums should be added back, I guess. But since @dalexeev said the function's only meant for objects, I'm a bit confused about what to do. I found this while reviewing #122772, coincidentally.","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5419501823/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5420777337","html_url":"https://github.com/godotengine/godot/pull/122711#issuecomment-5420777337","issue_url":"https://api.github.com/repos/godotengine/godot/issues/122711","id":5420777337,"node_id":"IC_kwDOAO6SJc8AAAABQxp_eQ","user":{"login":"dalexeev","id":47700418,"node_id":"MDQ6VXNlcjQ3NzAwNDE4","avatar_url":"https://avatars.githubusercontent.com/u/47700418?v=4","gravatar_id":"","url":"https://api.github.com/users/dalexeev","html_url":"https://github.com/dalexeev","followers_url":"https://api.github.com/users/dalexeev/followers","following_url":"https://api.github.com/users/dalexeev/following{/other_user}","gists_url":"https://api.github.com/users/dalexeev/gists{/gist_id}","starred_url":"https://api.github.com/users/dalexeev/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/dalexeev/subscriptions","organizations_url":"https://api.github.com/users/dalexeev/orgs","repos_url":"https://api.github.com/users/dalexeev/repos","events_url":"https://api.github.com/users/dalexeev/events{/privacy}","received_events_url":"https://api.github.com/users/dalexeev/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-08-26T04:53:54Z","updated_at":"2026-08-26T04:53:54Z","body":"> But since @dalexeev said the function's only meant for objects, I'm a bit confused about what to do.\r\n\r\nYou should check the call stack and handle the non-object types above. In other words, this function shouldn't be called for non-object types.","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5420777337/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5452891865","html_url":"https://github.com/godotengine/godot/pull/122711#issuecomment-5452891865","issue_url":"https://api.github.com/repos/godotengine/godot/issues/122711","id":5452891865,"node_id":"IC_kwDOAO6SJc8AAAABRQSG2Q","user":{"login":"Synzorasize","id":60207816,"node_id":"MDQ6VXNlcjYwMjA3ODE2","avatar_url":"https://avatars.githubusercontent.com/u/60207816?v=4","gravatar_id":"","url":"https://api.github.com/users/Synzorasize","html_url":"https://github.com/Synzorasize","followers_url":"https://api.github.com/users/Synzorasize/followers","following_url":"https://api.github.com/users/Synzorasize/following{/other_user}","gists_url":"https://api.github.com/users/Synzorasize/gists{/gist_id}","starred_url":"https://api.github.com/users/Synzorasize/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Synzorasize/subscriptions","organizations_url":"https://api.github.com/users/Synzorasize/orgs","repos_url":"https://api.github.com/users/Synzorasize/repos","events_url":"https://api.github.com/users/Synzorasize/events{/privacy}","received_events_url":"https://api.github.com/users/Synzorasize/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-08-28T13:07:37Z","updated_at":"2026-08-28T13:07:37Z","body":"Alright, I was busy so couldn't take a look before but now I can!\r\n\r\n`_is_constructible_object` isn't called for builtin types because of `base_type.is_meta_type` before it, I'm guessing. That's why it never errors, since they aren't meta types. For enums, though, `Key` is, so that's why it errors.\r\n\r\nAs for `_find_identifiers_in_base` itself, it has specific cases relating to builtins and enums so I can't block it out for them. So I'm not sure if I should use something enum-specific in the if-condition to filter it out. Therefore I think I'll just add the enum check back for now. If something else is better, please tell me so I'll use that instead.","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5452891865/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5532089583","html_url":"https://github.com/godotengine/godot/pull/122711#issuecomment-5532089583","issue_url":"https://api.github.com/repos/godotengine/godot/issues/122711","id":5532089583,"node_id":"IC_kwDOAO6SJc8AAAABSbz87w","user":{"login":"Synzorasize","id":60207816,"node_id":"MDQ6VXNlcjYwMjA3ODE2","avatar_url":"https://avatars.githubusercontent.com/u/60207816?v=4","gravatar_id":"","url":"https://api.github.com/users/Synzorasize","html_url":"https://github.com/Synzorasize","followers_url":"https://api.github.com/users/Synzorasize/followers","following_url":"https://api.github.com/users/Synzorasize/following{/other_user}","gists_url":"https://api.github.com/users/Synzorasize/gists{/gist_id}","starred_url":"https://api.github.com/users/Synzorasize/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Synzorasize/subscriptions","organizations_url":"https://api.github.com/users/Synzorasize/orgs","repos_url":"https://api.github.com/users/Synzorasize/repos","events_url":"https://api.github.com/users/Synzorasize/events{/privacy}","received_events_url":"https://api.github.com/users/Synzorasize/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-09-03T21:02:08Z","updated_at":"2026-09-03T21:02:08Z","body":"Rebased after #122308. Even though that PR didn't change any lines that this one does, it still counted it as being conflicted just because the two lines are right next to each other -_-","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comm