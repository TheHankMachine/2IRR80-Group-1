oll_on_drag_hover && is_visible_in_tree()) {\r\n-                               set_process_internal(true);\r\n+                               const Dictionary drag_data = get_viewport()->gui_get_drag_data();\r\n+                               if (drag_data.get(\"type\", \"\").operator String() != \"tab\") { // Enable scrolling, unless dragging a tab.\r\n+                                       set_process_internal(true);\r\n+                               }\r\n                        }\r\n                } break;\r\n\r\ndiff --git a/scene/gui/tree.cpp b/scene/gui/tree.cpp\r\nindex a8db87aeb1..ccfa518d05 100644\r\n--- a/scene/gui/tree.cpp\r\n+++ b/scene/gui/tree.cpp\r\n@@ -4997,8 +4997,11 @@ void Tree::_notification(int p_what) {\r\n                case NOTIFICATION_DRAG_BEGIN: {\r\n                        single_select_defer = nullptr;\r\n                        if (theme_cache.scroll_speed > 0) {\r\n-                               scrolling = true;\r\n-                               set_process_internal(true);\r\n+                               const Dictionary drag_data = get_viewport()->gui_get_drag_data();\r\n+                               if (drag_data.get(\"type\", \"\").operator String() != \"tab\") { // Enable scrolling, unless dragging a tab.\r\n+                                       scrolling = true;\r\n+                                       set_process_internal(true);\r\n+                               }\r\n                        }\r\n                } break;\r\n```","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3694249305/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3694405612","html_url":"https://github.com/godotengine/godot/pull/111113#issuecomment-3694405612","issue_url":"https://api.github.com/repos/go