m/user-attachments/assets/46196024-ef8a-444b-89d3-0b998ce49967\" />\r\n\r\n@dsnopek ","closed_by":{"login":"LanzaSchneider","id":24624901,"node_id":"MDQ6VXNlcjI0NjI0OTAx","avatar_url":"https://avatars.githubusercontent.com/u/24624901?v=4","gravatar_id":"","url":"https://api.github.com/users/LanzaSchneider","html_url":"https://github.com/LanzaSchneider","followers_url":"https://api.github.com/users/LanzaSchneider/followers","following_url":"https://api.github.com/users/LanzaSchneider/following{/other_user}","gists_url":"https://api.github.com/users/LanzaSchneider/gists{/gist_id}","starred_url":"https://api.github.com/users/LanzaSchneider/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/LanzaSchneider/subscriptions","organizations_url":"https://api.github.com/users/LanzaSchneider/orgs","repos_url":"https://api.github.com/users/LanzaSchneider/repos","events_url":"https://api.github.com/users/LanzaSchneider/events{/privacy}","received_events_url":"https://api.github.com/users/LanzaSchneider/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/113137/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/godotengine/godot/issues/113137/timeline","performed_via_github_app":null,"state_reason":null}