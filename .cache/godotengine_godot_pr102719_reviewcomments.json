2719#discussion_r1951251613","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/102719","_links":{"self":{"href":"https://api.github.com/repos/godotengine/godot/pulls/comments/1951251613"},"html":{"href":"https://github.com/godotengine/godot/pull/102719#discussion_r1951251613"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/102719"}},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/1951251613/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":585,"original_line":585,"side":"RIGHT","author_association":"MEMBER","original_position":11,"position":11,"subject_type":"line"},{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/1952234168","pull_request_review_id":2611228336,"id":1952234168,"node_id":"PRRC_kwDOAO6SJc50XLq4","diff_hunk":"@@ -576,9 +576,17 @@ void DisplayServerWeb::_mouse_update_mode() {\n \n void DisplayServerWeb::mouse_set_mode(MouseMode p_mode) {\n \tERR_FAIL_INDEX(p_mode, MouseMode::MOUSE_MODE_MAX);\n-\tif (p_mode == mouse_mode_base) {\n+\n+\tif (mouse_mode_override_enabled) {\n+\t\tmouse_mode_base = p_mode;\n+\t\t// No need to update, as override is enabled.\n+\t\treturn;\n+\t}\n+\tif (p_mode == mouse_mode_base && p_mode == mouse_get_mode()) {","path":"platform/web/display_server_web.cpp","commit_id":"61344dc5ac6c2ce2a2cbab35280ee3cc247a0056","original_commit_id":"1c4098c6e98c458c4ff5bc082f0d9c1f4a8a7b52","user":{"login":"bruvzg","id":7645683,"node_id":"MDQ6VXNlcjc2NDU2ODM=","avatar_url":"https://avatars.githubusercontent.com/u/7645683?v=4","gravatar_id":"","url":"https://api.github.com/users/bruvzg","html_url":"https://github.com/bruvzg","followers_url":"https://api.github.com/users/bruvzg/followers","following_url":"https://api.github.com/users/bruvzg/following{/other_user}","gists_url":"https://api.github.com/users/bruvzg/gists{/gist_id}","starred_url":"https://api.github.com/users/bruvzg/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/bruvzg/subscriptions","organizations_url":"https://api.github.com/users/bruvzg/orgs","repos_url":"https://api.github.com/users/bruvzg/repos","events_url":"https://api.github.com/users/bruvzg/events{/privacy}","received_events_url":"https://api.github.com/users/bruvzg/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"> It also fixes an issue on the Web platform where the mouse mode would refuse to capture the mouse twice.\r\n\r\nOther platforms seems to automatically recapture mouse if you refocus the app. For example, Windows call mode update from window activation handlers to restore it, maybe Web should store it and auto-recapture mouse instead of requiring to set in the second time?","created_at":"2025-02-12T08:57:55Z","updated_at":"2025-02-12T08:58:13Z","html_url":"https://github.com/godotengine/godot/pull/102719#discussion_r1952234168","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/102719","_links":{"self":{"href":"https://api.github.com/repos/godotengine/godot/pulls/comments/1952234168"},"html":{"href":"https://github.com/godotengine/godot/pull/102719#discussion_r1952234168"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/102719"}},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/1952234168/reactions","total_count":1,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":1},"start_line":null,"original_start_line":null,"start_side":null,"line":585,"original_line":585,"side":"RIGHT","in_reply_to_id":1951251613,"author_association":"MEMBER","original_position":11,"position":11,"subject_type":"line"},{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/1953049470","pull_request_review_id":2612600020,"id":1953049470,"node_id":"PRRC_kwDOAO6SJc50aSt-","diff_hunk":"@@ -576,9 +576,17 @@ void DisplayServerWeb::_mouse_update_mode() {\n \n void DisplayServerWeb::mouse_set_mode(MouseMode p_mode) {\n \tERR_FAIL_INDEX(p_mode, MouseMode::MOUSE_MODE_MAX);\n-\tif (p_mode == mouse_mode_base) {\n+\n+\tif (mouse_mode_override_enabled) {\n+\t\tmouse_mode_base = p_mode;\n+\t\t// No need to update, as override is enabled.\n+\t\treturn;\n+\t}\n+\tif (p_mode == mouse_mode_base && p_mode == mouse_get_mode()) {","path":"platform/web/display_server_web.cpp","commit_id":"61344dc5ac6c2ce2a2cbab35280ee3cc247a0056","original_commit_id":"1c4098c6e98c458c4ff5bc082f0d9c1f4a8a7b52","user":{"login":"adamscott","id":270928,"node_id":"MDQ6VXNlcjI3MDkyOA==","avatar_url":"https://avatars.githubusercontent.com/u/270928?v=4","gravatar_id":"","url":"https://api.github.com/users/adamscott","html_url":"https://github.com/adamscott","followers_url":"https://api.github.com/users/adamscott/followers","following_url":"https://api.github.com/users/adamscott/following{/other_user}","gists_url":"https://api.github.com/users/adamscott/gists{/gist_id}","starred_url":"https://api.github.com/users/adamscott/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/adamscott/subscriptions","organizations_url":"https://api.github.com/users/adamscott/orgs","repos_url":"https://api.github.com/users/adamscott/repos","events_url":"https://api.github.com/users/adamscott/events{/privacy}","received_events_url":"https://api.github.com/users/adamscott/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"@bruvzg Not possible. Because the browser is letting you a way to escape from websites, by pressing escape. And capturing the mouse is only possible from a direct action from the user: i.e. a click. So it's not possible to capture the mouse without intent from the user. If the user escaped, we cannot capture until a new click.\r\n\r\nSee https://developer.mozilla.org/en-US/docs/Web/API/Element/requestPointerLock#security for more info.\r\n\r\n> [Transient activation](https://developer.mozilla.org/en-US/docs/Glossary/Transient_activation) is required when calling requestPointerLock(). The user has to interact with the page or a UI element in order for this feature to work. Also, the target element's associated document must be in the active state.","created_at":"2025-02-12T16:50:43Z","updated_at":"2025-02-12T16:52:07Z","html_url":"https://github.com/godotengine/godot/pull/102719#discussion_r1953049470","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/102719","_links":{"self":{"href":"https://api.github.com/repos/godotengine/godot/pulls/comments/1953049470"},"html":{"href":"https://github.com/godotengine/godot/pull/102719#discussion_r1953049470"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/102719"}},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/1953049470/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":585,"original_line":585,"side":"RIGHT","in_reply_to_id":1951251613,"author_association":"MEMBER","original_position":11,"position":11,"subject_type":"line"},{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/1954846444","pull_request_review_id":2615618318,"id":1954846444,"node_id":"PRRC_kwDOAO6SJc50hJbs","diff_hunk":"@@ -815,9 +815,17 @@ void DisplayServerWindows::_mouse_update_mode() {\n \n void DisplayServerWindows::mouse_set_mode(MouseMode p_mode) {\n \tERR_FAIL_INDEX(p_mode, MouseMode::MOUSE_MODE_MAX);\n-\tif (p_mode == mouse_mode_base) {\n+\n+\tif (mouse_mode_override_enabled) {\n+\t\tmouse_mode_base = p_mode;\n+\t\t// No need to update, as override is enabled.\n+\t\treturn;\n+\t}\n+\tif (p_mode == mouse_mode_base && p_mode == mouse_mode) {\n+\t\t// No need to update, as it is currently set as the correct mode.\n \t\treturn;\n \t}\n+\n \tmouse_mode_base = p_mode;\n \t_mouse_update_mode();","path":"platform/windows/display_server_windows.cpp","commit_id":"61344dc5ac6c2ce2a2cbab35280ee3cc247a0056","original_commit_id":"1c4098c6e98c458c4ff5bc082f0d9c1f4a8a7b52","user":{"login":"bruvzg","id":7645683,"node_id":"MDQ6VXNlcjc2NDU2ODM=","avatar_url":"https://avatars.githubusercontent.com/u/7645683?v=4","gravatar_id":"","url":"https://api.github.com/users/bruvzg","html_url":"https://github.com/bruvzg","followers_url":"https://api.github.com/users/bruvzg/followers","following_url":"https://api.github.com/users/bruvzg/following{/other_user}","gists_url":"https://api.github.com/users/bruvzg/gists{/gist_id}","starred_url":"https://api.github.com/users/bruvzg/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/bruvzg/subscriptions","organizations_url":"https://api.github.com/users/bruvzg/orgs","repos_url":"https://api.github.com/users/bruvzg/repos","events_url":"https://api.github.com/users/bruvzg/events{/privacy}","received_events_url":"https://api.github.com/users/bruvzg/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"`_mouse_update_mode` already have the following check:\r\n\r\n```c++\r\n\tMouseMode wanted_mouse_mode = mouse_mode_override_enabled\r\n\t\t\t? mouse_mode_override\r\n\t\t\t: mouse_mode_base;\r\n\r\n\tif (mouse_mode == wanted_mouse_mode) {\r\n\t\treturn;\r\n\t}\r\n```\r\n\r\nAnd `mouse_mode` is only and always updated in `_mouse_update_mode`, so these checks seems redundant (on desktop platforms).","created_at":"2025-02-13T16:34:50Z","updated_at":"2025-02-13T16:37:09Z","html_url":"https://github.com/godotengine/godot/pull/102719#discussion_r1954846444","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/102719","_links":{"self":{"href":"https://api.github.com/repos/godotengine/godot/pulls/comments/1954846444"},"html":{"href":"https://github.com/godotengine/godot/pull/102719#discussion_r1954846444"},"pull_request":{"href":"https://api.github.com/repos/godo