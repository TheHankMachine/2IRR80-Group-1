[{"id":3595781373,"node_id":"PRR_kwDOAO6SJc7WU0T9","user":{"login":"BastiaanOlij","id":1945449,"node_id":"MDQ6VXNlcjE5NDU0NDk=","avatar_url":"https://avatars.githubusercontent.com/u/1945449?u=96b5dc9be2859dca5f31314c87d99a68a21e1576&v=4","gravatar_id":"","url":"https://api.github.com/users/BastiaanOlij","html_url":"https://github.com/BastiaanOlij","followers_url":"https://api.github.com/users/BastiaanOlij/followers","following_url":"https://api.github.com/users/BastiaanOlij/following{/other_user}","gists_url":"https://api.github.com/users/BastiaanOlij/gists{/gist_id}","starred_url":"https://api.github.com/users/BastiaanOlij/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/BastiaanOlij/subscriptions","organizations_url":"https://api.github.com/users/BastiaanOlij/orgs","repos_url":"https://api.github.com/users/BastiaanOlij/repos","events_url":"https://api.github.com/users/BastiaanOlij/events{/privacy}","received_events_url":"https://api.github.com/users/BastiaanOlij/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"","state":"COMMENTED","html_url":"https://github.com/godotengine/godot/pull/114175#pullrequestreview-3595781373","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/114175","author_association":"CONTRIBUTOR","_links":{"html":{"href":"https://github.com/godotengine/godot/pull/114175#pullrequestreview-3595781373"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/114175"}},"submitted_at":"2025-12-19T00:05:22Z","commit_id":null},{"id":3595953860,"node_id":"PRR_kwDOAO6SJc7WVebE","user":{"login":"clayjohn","id":16521339,"node_id":"MDQ6VXNlcjE2NTIxMzM5","avatar_url":"https://avatars.githubusercontent.com/u/16521339?u=e44a465cbebabb9ea2be80b59e6dc07966bef5b7&v=4","gravatar_id":"","url":"https://api.github.com/users/clayjohn","html_url":"https://github.com/clayjohn","followers_url":"https://api.github.com/users/clayjohn/followers","following_url":"https://api.github.com/users/clayjohn/following{/other_user}","gists_url":"https://api.github.com/users/clayjohn/gists{/gist_id}","starred_url":"https://api.github.com/users/clayjohn/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/clayjohn/subscriptions","organizations_url":"https://api.github.com/users/clayjohn/orgs","repos_url":"https://api.github.com/users/clayjohn/repos","events_url":"https://api.github.com/users/clayjohn/events{/privacy}","received_events_url":"https://api.github.com/users/clayjohn/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"I tested this locally and confirmed that it fixes the crash on my Adreno 640. \n\nMy initial investigation led me to believe that the issue was memory alignment related and somehow the driver was getting into a state it could not recover where it could not properly function, but did not crash. In particular, I suspected that memory alignment issues were resulting in the radiance value property impacting the `directional_light_count` property in the Scenedata struct resulting in `directional_light_count` getting a huge value and crashing the driver. \n\nBastiaan's initial refactor did not fix the issue, but it did split out the prev frame data from the current frame data (which removed a source of UB). \n\nI tested out forcing alignment manually in the shader by using a mat3x4 and that worked. Therefore, I think we can conclude that the problem was a shader code generation issue. The driver must assume tighter packing than what the spec actually specifies when using a mat3 inside a struct in a shader. https://github.com/godotengine/godot/pull/97151 triggered this issue because it moved the scene data from a uniform block directly to a struct. Many old drivers prefer using a uniform block instead of a struct.","state":"APPROVED","html_url":"https://github.com/godotengine/godot/pull/114175#pullrequestreview-3595953860","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/114175","author_association":"MEMBER","_links":{"html":{"href":"https://github.com/godotengine/godot/pull/114175#pullrequestreview-3595953860"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/114175"}},"submitted_at":"2025-12-19T00:56:28Z","commit_id":null},{"id":3597692799,"node_id":"PRR_kwDOAO6SJc7WcG9_","user":{"login":"akien-mga","id":4701338,"node_id":"MDQ6VXNlcjQ3MDEzMzg=","avatar_url":"https://avatars.githubusercontent.com/u/4701338?u=4a42fd867f2c449fcc23adf635dd574dae98e6c2&v=4","gravatar_id":"","url":"https://api.github.com/users/akien-mga","html_url":"https://github.com/akien-mga","followers_url":"https://api.github.com/users/akien-mga/followers","following_url":"https://api.github.com/users/akien-mga/following{/other_user}","gists_url":"https://api.github.com/users/akien-mga/gists{/gist_id}","starred_url":"https://api.github.com/users/akien-mga/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/akien-mga/subscriptions","organizations_url":"https://api.github.com/users/akien-mga/orgs","repos_url":"https://api.github.com/users/akien-mga/repos","events_url":"https://api.github.com/users/akien-mga/events{/privacy}","received_events_url":"https://api.github.com/users/akien-mga/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"Tested and I confirm this fixes the bug on my Xiaomi Pocophone F1 (Adreno 630).","state":"APPROVED","html_url":"https://github.com/godotengine/godot/pull/114175#pullrequestreview-3597692799","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/114175","author_association":"MEMBER","_links":{"html":{"href":"https://github.com/godotengine/godot/pull/114175#pullrequestreview-3597692799"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/114175"}},"submitted_at":"2025-12-19T09:13:37Z","commit_id":"6c52ba9625edda92570c8c46b0e14d0a432aed03"}]