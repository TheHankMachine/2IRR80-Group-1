n\tprint(get_children())\n\tpass\n```","closed_by":{"login":"thiscris","id":31136319,"node_id":"MDQ6VXNlcjMxMTM2MzE5","avatar_url":"https://avatars.githubusercontent.com/u/31136319?v=4","gravatar_id":"","url":"https://api.github.com/users/thiscris","html_url":"https://github.com/thiscris","followers_url":"https://api.github.com/users/thiscris/followers","following_url":"https://api.github.com/users/thiscris/following{/other_user}","gists_url":"https://api.github.com/users/thiscris/gists{/gist_id}","starred_url":"https://api.github.com/users/thiscris/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/thiscris/subscriptions","organizations_url":"https://api.github.com/users/thiscris/orgs","repos_url":"https://api.github.com/users/thiscris/repos","events_url":"https://api.github.com/users/thiscris/events{/privacy}","received_events_url":"https://api.github.com/users/thiscris/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/110220/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/godotengine/godot/issues/110220/timeline","performed_via_github_app":null,"state_reason":"completed","pinned_comment":null}