[{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3163533944","html_url":"https://github.com/godotengine/godot/issues/109389#issuecomment-3163533944","issue_url":"https://api.github.com/repos/godotengine/godot/issues/109389","id":3163533944,"node_id":"IC_kwDOAO6SJc68j7J4","user":{"login":"mihe","id":4884246,"node_id":"MDQ6VXNlcjQ4ODQyNDY=","avatar_url":"https://avatars.githubusercontent.com/u/4884246?v=4","gravatar_id":"","url":"https://api.github.com/users/mihe","html_url":"https://github.com/mihe","followers_url":"https://api.github.com/users/mihe/followers","following_url":"https://api.github.com/users/mihe/following{/other_user}","gists_url":"https://api.github.com/users/mihe/gists{/gist_id}","starred_url":"https://api.github.com/users/mihe/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/mihe/subscriptions","organizations_url":"https://api.github.com/users/mihe/orgs","repos_url":"https://api.github.com/users/mihe/repos","events_url":"https://api.github.com/users/mihe/events{/privacy}","received_events_url":"https://api.github.com/users/mihe/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-08-07T10:39:50Z","updated_at":"2025-08-07T10:39:50Z","body":"CC @Rindbee ","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3163533944/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3163628748","html_url":"https://github.com/godotengine/godot/issues/109389#issuecomment-3163628748","issue_url":"https://api.github.com/repos/godotengine/godot/issues/109389","id":3163628748,"node_id":"IC_kwDOAO6SJc68kSTM","user":{"login":"Rindbee","id":30386067,"node_id":"MDQ6VXNlcjMwMzg2MDY3","avatar_url":"https://avatars.githubusercontent.com/u/30386067?v=4","gravatar_id":"","url":"https://api.github.com/users/Rindbee","html_url":"https://github.com/Rindbee","followers_url":"https://api.github.com/users/Rindbee/followers","following_url":"https://api.github.com/users/Rindbee/following{/other_user}","gists_url":"https://api.github.com/users/Rindbee/gists{/gist_id}","starred_url":"https://api.github.com/users/Rindbee/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Rindbee/subscriptions","organizations_url":"https://api.github.com/users/Rindbee/orgs","repos_url":"https://api.github.com/users/Rindbee/repos","events_url":"https://api.github.com/users/Rindbee/events{/privacy}","received_events_url":"https://api.github.com/users/Rindbee/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-08-07T11:12:32Z","updated_at":"2025-08-07T11:18:27Z","body":"https://github.com/godotengine/godot/pull/102372#issuecomment-2635780594 explains why this is done.\n\nThis displays the actual theme item being used. When checked, it displays the theme item override (the theme item of resource type can be edited) being used; when unchecked, it displays the fallback (the theme item of resource type can not be edited). This may need to be stated in the documentation.\n\nJust recording the differences might not be appropriate either, since the fallback theme items might be modified elsewhere.","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3163628748/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3163796718","html_url":"https://github.com/godotengine/godot/issues/109389#issuecomment-3163796718","issue_url":"https://api.github.com/repos/godotengine/godot/issues/109389","id":3163796718,"node_id":"IC_kwDOAO6SJc68k7Tu","user":{"login":"mihe","id":4884246,"node_id":"MDQ6VXNlcjQ4ODQyNDY=","avatar_url":"https://avatars.githubusercontent.com/u/4884246?v=4","gravatar_id":"","url":"https://api.github.com/users/mihe","html_url":"https://github.com/mihe","followers_url":"https://api.github.com/users/mihe/followers","following_url":"https://api.github.com/users/mihe/following{/other_user}","gists_url":"https://api.github.com/users/mihe/gists{/gist_id}","starred_url":"https://api.github.com/users/mihe/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/mihe/subscriptions","organizations_url":"https://api.github.com/users/mihe/orgs","repos_url":"https://api.github.com/users/mihe/repos","events_url":"https://api.github.com/users/mihe/events{/privacy}","received_events_url":"https://api.github.com/users/mihe/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-08-07T11:45:13Z","updated_at":"2025-08-07T11:45:13Z","body":"I think I understand the predicament, but the fact that it embeds the font as a sub-resource doesn't seem like a particularly good default (when checked) either way.\n\nI know very little about the font side of things, but perhaps the default font could be referenced in some other way, such that duplicating the resource isn't as problematic? Maybe there's some justification for the fallback font being of some new `DefaultFont` type or something, similar to `SystemFont`, instead of being a regular `FontFile`?","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3163796718/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3163888994","html_url":"https://github.com/godotengine/godot/issues/109389#issuecomment-3163888994","issue_url":"https://api.github.com/repos/godotengine/godot/issues/109389","id":3163888994,"node_id":"IC_kwDOAO6SJc68lR1i","user":{"login":"Rindbee","id":30386067,"node_id":"MDQ6VXNlcjMwMzg2MDY3","avatar_url":"https://avatars.githubusercontent.com/u/30386067?v=4","gravatar_id":"","url":"https://api.github.com/users/Rindbee","html_url":"https://github.com/Rindbee","followers_url":"https://api.github.com/users/Rindbee/followers","following_url":"https://api.github.com/users/Rindbee/following{/other_user}","gists_url":"https://api.github.com/users/Rindbee/gists{/gist_id}","starred_url":"https://api.github.com/users/Rindbee/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Rindbee/subscriptions","organizations_url":"https://api.github.com/users/Rindbee/orgs","repos_url":"https://api.github.com/users/Rindbee/repos","events_url":"https://api.github.com/users/Rindbee/events{/privacy}","received_events_url":"https://api.github.com/users/Rindbee/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-08-07T12:01:00Z","updated_at":"2025-08-07T12:13:18Z","body":"When checked, the revert icon will be displayed.\n\n<img width=\"735\" height=\"165\" alt=\"Image\" src=\"https://github.com/user-attachments/assets/2c9bfa1b-1b8b-40a6-9db6-42148b681daf\" />\n\nIf you don't need to edit or override, it's not recommended to check this box. For large resources like fonts, you can save them using the Save/Save As options after editing.\n\n<img width=\"201\" height=\"390\" alt=\"Image\" src=\"https://github.com/user-attachments/assets/8ff14707-99a4-45c3-93a8-d32df181fed9\" />\n\n> I know very little about the font side of things, but perhaps the default font could be referenced in some other way, such that duplicating the resource isn't as problematic? Maybe there's some justification for the fallback font being of some new `DefaultFont` type or something, similar to `SystemFont`, instead of being a regular `FontFile`?\n\nResources with large data are generally not edited in Godot. Perhaps we only need to record the file path when recording the resource. Resources embedded in the Godot engine may need to allow some way to be referenced by users.","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3163888994/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3165204631","html_url":"https://github.com/godotengine/godot/issues/109389#issuecomment-3165204631","issue_url":"https://api.github.com/repos/godotengine/godot/issues/109389","id":3165204631,"node_id":"IC_kwDOAO6SJc68qTCX","user":{"login":"mihe","id":4884246,"node_id":"MDQ6VXNlcjQ4ODQyNDY=","avatar_url":"https://avatars.githubusercontent.com/u/4884246?v=4","gravatar_id":"","url":"https://api.github.com/users/mihe","html_url":"https://github.com/mihe","followers_url":"https://api.github.com/users/mihe/followers","following_url":"https://api.github.com/users/mihe/following{/other_user}","gists_url":"https://api.github.com/users/mihe/gists{/gist_id}","starred_url":"https://api.github.com/users/mihe/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/mihe/subscriptions","organizations_url":"https://api.github.com/users/mihe/orgs","repos_url":"https://api.github.com/users/mihe/repos","events_url":"https://api.github.com/users/mihe/events{/privacy}","received_events_url":"https://api.github.com/users/mihe/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-08-07T17:58:36Z","updated_at":"2025-08-07T17:58:49Z","body":"> If you don't need to edit or override, it's not recommended to check this box.\n\nI can't really argue with that, of course. In this case it's likely that the overrides were checked and the content creators intended to change font but never did. So I will concede that it's a questionable use-case to cater to in the first place.\n\n> For large resources like fonts, you can save them using the Save/Save As options after editing.\n\nAs you can see in your own screenshot of the `FontFile` resource, there are no properties to edit in the first place, so I'm not sure why you would want to save the font. You wouldn't really want to save the default font to a file, nor an already externally referenced font.\n\n---\n\nThinking about this some more, what if the behavior was changed so that you still see the default/fallback value of the override, like #102372 intended, but as long as the value is the same as the default/fallback then the checkbox remains unchecked? So basically you would only be able to check the checkbox if the value was changed.","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3165204631/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3166164526","html_url":"https://github.com/godotengine/godot/issues/109389#issuecomment-3166164526","issue_url":"https://api.github.com/repos/godotengine/godot/issues/109389","id":3166164526,"node_id":"IC_kwDOAO6SJc68t9Yu","user":{"login":"Rindbee","id":30386067,"node_id":"MDQ6VXNlcjMwMzg2MDY3","avatar_url":"https://avatars.githubusercontent.com/u/30386067?v=4","gravatar_id":"","url":"https://api.github.com/users/Rindbee","html_url":"https://github.com/Rindbee","followers_url":"https://api.github.com/users/Rindbee/followers","following_url":"https://api.github.com/users/Rindbee/following{/other_user}","gists_url":"https://api.github.com/users/Rindbee/gists{/gist_id}","starred_url":"https://api.github.com/users/Rindbee/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Rindbee/subscriptions","organizations_url":"https://api.github.com/users/Rindbee/orgs","repos_url":"https://api.github.com/users/Rindbee/repos","events_url":"https://api.github.com/users/Rindbee/events{/privacy}","received_events_url":"https://api.github.com/users/Rindbee/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-08-07T23:53:21Z","updated_at":"2025-08-07T23:59:32Z","body":"> but as long as the value is the same as the default/fallback then the checkbox remains unchecked?\n\nUnset values are **inherited** (the default value), which is actually **mutable**. Inherited values can be modified by modifying the corresponding control-type theme item in the theme resource assigned to the ancestor control.\n\nFor Resource-type theme items (primarily for `StyleBox`), the expected workflow is as follows:\n- You can preview the resource in use and view its property configurations.\n- If you want to **fix** it as a theme item override for a specific node to prevent it from changing with theme changes, or if you want to **modify** the resource base on the current value, you can check the box to create a copy.\n- Consider where to store your resources.\n\nThis means that if you check this box, you are expected to modify this override.\n\n\nResources embedded in the engine cannot currently be modified, so you can only modify copies.\n\n<img width=\"540\" height=\"135\" alt=\"Image\" src=\"https://github.com/user-attachments/assets/3bc75dbf-4607-402c-8f10-7e2f13539886\" />\n\n\nFor external resources, you can first select the **Show in FileSystem** option, then double-click the file in the FileSystem to open it for editing; or use copy/paste to edit. It should be noted that external resources are shared, and modifying them will affect all objects that use them.\n\n<img width=\"534\" height=\"545\" alt=\"Image\" src=\"https://github.com/user-attachments/assets/fbf82d62-2a8e-40e6-8f89-786d28951229\" />\n\n\nIt should be noted that these resources are **cached** in EditorProperty, but the context menu opened by right-clicking the property label operates the property, that is, the actual value, not the cached value. When it is unchecked, the actual property value is empty.\n\n\n<img width=\"535\" height=\"240\" alt=\"Image\" src=\"https://github.com/user-attachments/assets/4c86042b-42f9-48c5-8640-cf1c572e1082\" />\n\n","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3166164526/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3167212023","html_url":"https://github.com/godotengine/godot/issues/109389#issuecomment-3167212023","issue_url":"https://api.github.com/repos/godotengine/godot/issues/109389","id":3167212023,"node_id":"IC_kwDOAO6SJc68x9H3","user":{"login":"mihe","id":4884246,"node_id":"MDQ6VXNlcjQ4ODQyNDY=","avatar_url":"https://avatars.githubusercontent.com/u/4884246?v=4","gravatar_id":"","url":"https://api.github.com/users/mihe","html_url":"https://github.com/mihe","followers_url":"https://api.github.com/users/mihe/followers","following_url":"https://api.github.com/users/mihe/following{/other_user}","gists_url":"https://api.github.com/users/mihe/gists{/gist_id}","starred_url":"https://api.github.com/users/mihe/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/mihe/subscriptions","organizations_url":"https://api.github.com/users/mihe/orgs","repos_url":"https://api.github.com/users/mihe/repos","events_url":"https://api.github.com/users/mihe/events{/privacy}","received_events_url":"https://api.github.com/users/mihe/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-08-08T09:35:01Z","updated_at":"2025-08-08T09:35:01Z","body":"> If you want to **fix** it as a theme item override for a specific node to prevent it from changing with theme changes\n\nRight, yeah, that use-case breaks my suggestion above I guess.\n\nHowever...\n\n> If you want to **fix** it as a theme item override for a specific node to prevent it from changing with theme changes, or [...]\n>\n> This means that if you check this box, you are expected to modify this override.\n\nThese two sentences would seem to contradict eachother. This would mean that fixing the font (i.e. checking the \"Font\" override but not modifying it) is in fact an expected use-case, for when you want to prevent the font from changing when changing the theme. But that means you're duplicating/embedding/sub-resourcing the font (with every `Control` that does this) which seems highly undesirable, at least with `Font` resources specifically.","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3167212023/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3169635430","html_url":"https://github.com/godotengine/godot/issues/109389#issuecomment-3169635430","issue_url":"https://api.github.com/repos/godotengine/godot/issues/109389","id":3169635430,"node_id":"IC_kwDOAO6SJc687Mxm","user":{"login":"Rindbee","id":30386067,"node_id":"MDQ6VXNlcjMwMzg2MDY3","avatar_url":"https://avatars.githubusercontent.com/u/30386067?v=4","gravatar_id":"","url":"https://api.github.com/users/Rindbee","html_url":"https://github.com/Rindbee","followers_url":"https://api.github.com/users/Rindbee/followers","following_url":"https://api.github.com/users/Rindbee/following{/other_user}","gists_url":"https://api.github.com/users/Rindbee/gists{/gist_id}","starred_url":"https://api.github.com/users/Rindbee/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Rindbee/subscriptions","organizations_url":"https://api.github.com/users/Rindbee/orgs","repos_url":"https://api.github.com/users/Rindbee/repos","events_url":"https://api.github.com/users/Rindbee/events{/privacy}","received_events_url":"https://api.github.com/users/Rindbee/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-08-09T01:50:03Z","updated_at":"2025-08-09T01:50:03Z","body":"The problematic resources are probably of the following two categories:\n \n1. Imported Resources (they can be determined using the `.import` file in the editor),\n2. The above type buts embedded in the engine (not sure if there is a way to mark them). \n\nFor 1, when copying and saving, the original resource should be used as much as possible.\nFor 2, it should prompt when user duplicates.\n","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3169635430/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3172305612","html_url":"https://github.com/godotengine/godot/issues/109389#issuecomment-3172305612","issue_url":"https://api.github.com/repos/godotengine/godot/issues/109389","id":3172305612,"node_id":"IC_kwDOAO6SJc69FYrM","user":{"login":"Rindbee","id":30386067,"node_id":"MDQ6VXNlcjMwMzg2MDY3","avatar_url":"https://avatars.githubusercontent.com/u/30386067?v=4","gravatar_id":"","url":"https://api.github.com/users/Rindbee","html_url":"https://github.com/Rindbee","followers_url":"https://api.github.com/users/Rindbee/followers","following_url":"https://api.github.com/users/Rindbee/following{/other_user}","gists_url":"https://api.github.com/users/Rindbee/gists{/gist_id}","starred_url":"https://api.github.com/users/Rindbee/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Rindbee/subscriptions","organizations_url":"https://api.github.com/users/Rindbee/orgs","repos_url":"https://api.github.com/users/Rindbee/repos","events_url":"https://api.github.com/users/Rindbee/events{/privacy}","received_events_url":"https://api.github.com/users/Rindbee/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-08-10T02:15:54Z","updated_at":"2025-08-10T02:18:04Z","body":"I have created a PR #109480.\n\n<img width=\"875\" height=\"132\" alt=\"Image\" src=\"https://github.com/user-attachments/assets/bd567978-ac34-42a9-951b-86a4613dd7aa\" />\n\nWhen checking this box, you may receive the above prompts for imported and embedded resources respectively. \n\nIn other cases, the resource will be copied by default without prompting. \n\nThere may be another issue to note: pictures imported as `Image` type are embedded when saved, see #109479.\n\n","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3172305612/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null}]