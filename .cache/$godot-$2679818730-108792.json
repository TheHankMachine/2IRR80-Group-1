[{"id":3089374481,"node_id":"PRR_kwDOAO6SJc64JB0R","state":"COMMENTED","user":{"site_admin":false,"suspended":false,"updated_at":"0001-01-01T00:00:00Z","avatar_url":"https://avatars.githubusercontent.com/u/10054226?u=f0c85fe8c24debe91dc14d7efa97b51a19250b47&v=4","created_at":"0001-01-01T00:00:00Z","followers":0,"following":0,"html_url":"https://github.com/kitbdev","id":10054226,"node_id":"MDQ6VXNlcjEwMDU0MjI2","login":"kitbdev","type":"User","owned_private_repos":0,"public_gists":0,"public_repos":0,"total_private_repos":0,"url":"https://api.github.com/users/kitbdev"},"body":"Looks good.\r\n> Text trimming with ellipses is enabled for _search_text_label. Unfortunately this leads to hiding all searched text when width is minimum - feel free to suggest how it could be improved.\r\n\r\nThere could be a small minimum size on this to prevent it from hiding entirely. Maybe `50 * EDSCALE` or something?\r\n\r\nI don't really like the space that shows between the label and the progress bar, but there is no preferred size setting, so I'm not sure it is possible to fix while keeping ellipses. It can be addressed in the future though.\r\n","html_url":"https://github.com/godotengine/godot/pull/108792#pullrequestreview-3089374481","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/108792","author_association":"CONTRIBUTOR","submitted_at":"2025-08-05T19:02:00Z"},{"id":3107095646,"node_id":"PRR_kwDOAO6SJc65MoRe","state":"APPROVED","commit_id":"f3267c0ca78263915cb6e923c83743bc18ecd67a","user":{"site_admin":false,"suspended":false,"updated_at":"0001-01-01T00:00:00Z","avatar_url":"https://avatars.githubusercontent.com/u/10054226?u=f0c85fe8c24debe91dc14d7efa97b51a19250b47&v=4","created_at":"0001-01-01T00:00:00Z","followers":0,"following":0,"html_url":"https://github.com/kitbdev","id":10054226,"node_id":"MDQ6VXNlcjEwMDU0MjI2","login":"kitbdev","type":"User","owned_private_repos":0,"public_gists":0,"public_repos":0,"total_private_repos":0,"url":"https://api.github.com/users/kitbdev"},"body":"It doesn't need to be exactly one character, but its fine.\r\nI have some ideas for how the gap next to the progress bar can be removed in the future, so this is good for now.","html_url":"https://github.com/godotengine/godot/pull/108792#pullrequestreview-3107095646","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/108792","author_association":"CONTRIBUTOR","submitted_at":"2025-08-11T18:08:59Z"}]