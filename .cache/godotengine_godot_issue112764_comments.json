b.com/users/mihe","html_url":"https://github.com/mihe","followers_url":"https://api.github.com/users/mihe/followers","following_url":"https://api.github.com/users/mihe/following{/other_user}","gists_url":"https://api.github.com/users/mihe/gists{/gist_id}","starred_url":"https://api.github.com/users/mihe/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/mihe/subscriptions","organizations_url":"https://api.github.com/users/mihe/orgs","repos_url":"https://api.github.com/users/mihe/repos","events_url":"https://api.github.com/users/mihe/events{/privacy}","received_events_url":"https://api.github.com/users/mihe/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-11-27T15:24:02Z","updated_at":"2025-11-27T15:30:41Z","body":"> I guess it's worth pointing out that I didn't actually change the encryption filtering to make use of the new `source_path` property/argument, like what I'm planning to do for #112011. I assume that's something we will want to do though. Let me know if I should include that change here.\r\n\r\n@bruvzg I went ahead and made another PR (#113240) that adds this source path filtering to both the encryption and delta encoding filters, using this PR as a base.","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3586435949/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5217506552","html_url":"https://github.com/godotengine/godot/pull/112764#issuecomment-5217506552","issue_url":"https://api.github.com/repos/godotengine/godot/issues/112764","id":5217506552,"node_id":"IC_kwDOAO6SJc8AAAABNvzU-A","user":{"login":"mihe","id":4884246,"node_id":"MDQ6VXNlcjQ4ODQyNDY=","avatar_url":"https://avatars.githubusercontent.com/u/4884246?v=4","gravatar_id":"","url":"https://api.github.com/users/mihe","html_url":"https://github.com/mihe","followers_url":"https://api.github.com/users/mihe/followers","following_url":"https://api.github.com/users/mihe/following{/other_user}","gists_url":"https://api.github.com/users/mihe/gists{/gist_id}","starred_url":"https://api.github.com/users/mihe/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/mihe/subscriptions","organizations_url":"https://api.github.com/users/mihe/orgs","repos_url":"https://api.github.com/users/mihe/repos","events_url":"https://api.github.com/users/mihe/events{/privacy}","received_events_url":"https://api.github.com/users/mihe/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-08-07T13:12:20Z","updated_at":"2026-08-07T13:33:40Z","body":"This is long overdue, but I found myself in need of `source_path` again, and I would also like to see #113240 get merged at some point, which depends on this, so I've now rebased this, fixed a couple of issues with the previous version, and tested it a bit.\r\n\r\nThe more prominent change compared to what was here before is that I've now moved some of the encryption stuff, like splitting the filters and converting the key to binary, to live in `EditorExportPreset` instead, which I figured was better than having it live in the already very big `export_project_files`, or doing that work for every file.\r\n\r\nI've also added and bound a new `resolve_encryption_key` method to allow scripts to do that encryption key binary conversion (which also potentially uses `GODOT_SCRIPT_ENCRYPTION_KEY`) at any point, saving us from having to pass it through `save_cb` (and for users to figure out this conversion on their own).","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5217506552/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":n