[{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3755927347","html_url":"https://github.com/godotengine/godot/issues/114989#issuecomment-3755927347","issue_url":"https://api.github.com/repos/godotengine/godot/issues/114989","id":3755927347,"node_id":"IC_kwDOAO6SJc7f3ucz","user":{"login":"struc2ture","id":213835974,"node_id":"U_kgDODL7gxg","avatar_url":"https://avatars.githubusercontent.com/u/213835974?v=4","gravatar_id":"","url":"https://api.github.com/users/struc2ture","html_url":"https://github.com/struc2ture","followers_url":"https://api.github.com/users/struc2ture/followers","following_url":"https://api.github.com/users/struc2ture/following{/other_user}","gists_url":"https://api.github.com/users/struc2ture/gists{/gist_id}","starred_url":"https://api.github.com/users/struc2ture/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/struc2ture/subscriptions","organizations_url":"https://api.github.com/users/struc2ture/orgs","repos_url":"https://api.github.com/users/struc2ture/repos","events_url":"https://api.github.com/users/struc2ture/events{/privacy}","received_events_url":"https://api.github.com/users/struc2ture/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-01-15T17:00:16Z","updated_at":"2026-01-15T17:00:16Z","body":"I've done some basic investigation on the latest commit on master and it seems it has to do with Volumetric Fog.\n\nThe intense light is reproducible with just the Spot Light (10). The light has Volumetric Fog setting set to 20000. On the other hand in the WorldEnvironment, Volumetric Fog is set to 0.001.\n\nIt seems in 4.5.1 Volumetric Fog density is scaled differently than in 4.6. Especially with such an extreme value range between the spot light and the environment. Setting Volumetric Fog in the Environment to 0.01 in 4.5.1 makes it look similar to 4.6.\n\nI think the reason it gets more intense with mouse movement in the editor is that the fog is built up over multiple frames, and editor only updates the frame when there's mouse movement.","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3755927347/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3755949793","html_url":"https://github.com/godotengine/godot/issues/114989#issuecomment-3755949793","issue_url":"https://api.github.com/repos/godotengine/godot/issues/114989","id":3755949793,"node_id":"IC_kwDOAO6SJc7f3z7h","user":{"login":"Nodragem","id":10520249,"node_id":"MDQ6VXNlcjEwNTIwMjQ5","avatar_url":"https://avatars.githubusercontent.com/u/10520249?v=4","gravatar_id":"","url":"https://api.github.com/users/Nodragem","html_url":"https://github.com/Nodragem","followers_url":"https://api.github.com/users/Nodragem/followers","following_url":"https://api.github.com/users/Nodragem/following{/other_user}","gists_url":"https://api.github.com/users/Nodragem/gists{/gist_id}","starred_url":"https://api.github.com/users/Nodragem/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Nodragem/subscriptions","organizations_url":"https://api.github.com/users/Nodragem/orgs","repos_url":"https://api.github.com/users/Nodragem/repos","events_url":"https://api.github.com/users/Nodragem/events{/privacy}","received_events_url":"https://api.github.com/users/Nodragem/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-01-15T17:05:43Z","updated_at":"2026-01-15T17:09:19Z","body":"I am not sure if this is the same issue, but on my side, the glow intensity has drastically increased between 4.5.1 and 4.6.rc1:\n\n4.6.rc1 (too strong)\n<img width=\"605\" height=\"511\" alt=\"Image\" src=\"https://github.com/user-attachments/assets/5dfb3038-6b68-4c41-b47d-e278ba0306ab\" />\n\n4.5.1 (intended)\n<img width=\"602\" height=\"524\" alt=\"Image\" src=\"https://github.com/user-attachments/assets/ffb2f980-4904-4124-afd3-5fb9b5d3a6ef\" />\n\nAre you using the Glow effect in your World Environement @codrinursachi by any chance? what happens if you deactivate it?","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3755949793/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3756010360","html_url":"https://github.com/godotengine/godot/issues/114989#issuecomment-3756010360","issue_url":"https://api.github.com/repos/godotengine/godot/issues/114989","id":3756010360,"node_id":"IC_kwDOAO6SJc7f4Ct4","user":{"login":"struc2ture","id":213835974,"node_id":"U_kgDODL7gxg","avatar_url":"https://avatars.githubusercontent.com/u/213835974?v=4","gravatar_id":"","url":"https://api.github.com/users/struc2ture","html_url":"https://github.com/struc2ture","followers_url":"https://api.github.com/users/struc2ture/followers","following_url":"https://api.github.com/users/struc2ture/following{/other_user}","gists_url":"https://api.github.com/users/struc2ture/gists{/gist_id}","starred_url":"https://api.github.com/users/struc2ture/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/struc2ture/subscriptions","organizations_url":"https://api.github.com/users/struc2ture/orgs","repos_url":"https://api.github.com/users/struc2ture/repos","events_url":"https://api.github.com/users/struc2ture/events{/privacy}","received_events_url":"https://api.github.com/users/struc2ture/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-01-15T17:21:11Z","updated_at":"2026-01-15T17:21:11Z","body":"https://github.com/godotengine/godot/pull/109567\n\nMight be related","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3756010360/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3756566297","html_url":"https://github.com/godotengine/godot/issues/114989#issuecomment-3756566297","issue_url":"https://api.github.com/repos/godotengine/godot/issues/114989","id":3756566297,"node_id":"IC_kwDOAO6SJc7f6KcZ","user":{"login":"clayjohn","id":16521339,"node_id":"MDQ6VXNlcjE2NTIxMzM5","avatar_url":"https://avatars.githubusercontent.com/u/16521339?v=4","gravatar_id":"","url":"https://api.github.com/users/clayjohn","html_url":"https://github.com/clayjohn","followers_url":"https://api.github.com/users/clayjohn/followers","following_url":"https://api.github.com/users/clayjohn/following{/other_user}","gists_url":"https://api.github.com/users/clayjohn/gists{/gist_id}","starred_url":"https://api.github.com/users/clayjohn/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/clayjohn/subscriptions","organizations_url":"https://api.github.com/users/clayjohn/orgs","repos_url":"https://api.github.com/users/clayjohn/repos","events_url":"https://api.github.com/users/clayjohn/events{/privacy}","received_events_url":"https://api.github.com/users/clayjohn/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-01-15T19:43:04Z","updated_at":"2026-01-15T19:43:04Z","body":"This is a duplicate of https://github.com/godotengine/godot/issues/112468\n\nIn prior versions of Godot, there was a bug where the fog density would be multiplied by volumetric fog intensity twice. Therefore if you wanted dim lights to have a big impact on Volumetric fog, you needed to increase the Volumetric Fog multiplier to basically be larger than `1.0/fog_density`. For example, with a fog density of 0.001 (like in the MRP) you needed to use a multiplier that was significantly larger than 1000 to have a visible effect as a workaround. This behaviour was never intended and resulted in some nasty fog issues. \n\nI can see in the MRP, you have a multiplier of about 20,000 for one light. You will need to turn that multiplier down to get results that are the same as in 4.5.1.\n\nWe updated the docs (https://github.com/godotengine/godot-docs/pull/11457) and the TPS demo (https://github.com/godotengine/tps-demo/pull/212) to reflect that this workaround is no longer needed as well. \n\n@Nodragem I think you have a totally different issue. I think you are seeing the impact of https://github.com/godotengine/godot/pull/110671 which is an intentional breaking change (See https://godotengine.org/article/dev-snapshot-godot-4-6-beta-1/#breaking-changes)","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3756566297/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3756817331","html_url":"https://github.com/godotengine/godot/issues/114989#issuecomment-3756817331","issue_url":"https://api.github.com/repos/godotengine/godot/issues/114989","id":3756817331,"node_id":"IC_kwDOAO6SJc7f7Huz","user":{"login":"codrinursachi","id":88087646,"node_id":"MDQ6VXNlcjg4MDg3NjQ2","avatar_url":"https://avatars.githubusercontent.com/u/88087646?v=4","gravatar_id":"","url":"https://api.github.com/users/codrinursachi","html_url":"https://github.com/codrinursachi","followers_url":"https://api.github.com/users/codrinursachi/followers","following_url":"https://api.github.com/users/codrinursachi/following{/other_user}","gists_url":"https://api.github.com/users/codrinursachi/gists{/gist_id}","starred_url":"https://api.github.com/users/codrinursachi/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/codrinursachi/subscriptions","organizations_url":"https://api.github.com/users/codrinursachi/orgs","repos_url":"https://api.github.com/users/codrinursachi/repos","events_url":"https://api.github.com/users/codrinursachi/events{/privacy}","received_events_url":"https://api.github.com/users/codrinursachi/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-01-15T20:52:05Z","updated_at":"2026-01-15T20:52:05Z","body":"@Nodragem My issue was related to volumetric fog, not glow. \n@clayjohn Indeed after lowering the multiplier I obtained the desired result. Issue can be closed","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3756817331/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null}]