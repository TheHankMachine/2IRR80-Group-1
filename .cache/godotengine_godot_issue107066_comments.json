b.com/users/stuartcarnie/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/stuartcarnie/subscriptions","organizations_url":"https://api.github.com/users/stuartcarnie/orgs","repos_url":"https://api.github.com/users/stuartcarnie/repos","events_url":"https://api.github.com/users/stuartcarnie/events{/privacy}","received_events_url":"https://api.github.com/users/stuartcarnie/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-06-05T21:36:02Z","updated_at":"2025-06-05T21:36:02Z","body":"> I'd also like to know why the invalid access via the script debugger occurs, as the value shouldn't be valid, as it is correctly shutdown and cleaned up.\n\nIt was a null-pointer access 🙄 ","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2946380598/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2946639531","html_url":"https://github.com/godotengine/godot/issues/107066#issuecomment-2946639531","issue_url":"https://api.github.com/repos/godotengine/godot/issues/107066","id":2946639531,"node_id":"IC_kwDOAO6SJc6voiar","user":{"login":"a-johnston","id":9058941,"node_id":"MDQ6VXNlcjkwNTg5NDE=","avatar_url":"https://avatars.githubusercontent.com/u/9058941?v=4","gravatar_id":"","url":"https://api.github.com/users/a-johnston","html_url":"https://github.com/a-johnston","followers_url":"https://api.github.com/users/a-johnston/followers","following_url":"https://api.github.com/users/a-johnston/following{/other_user}","gists_url":"https://api.github.com/users/a-johnston/gists{/gist_id}","starred_url":"https://api.github.com/users/a-johnston/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/a-johnston/subscriptions","organizations_url":"https://api.github.com/users/a-johnston/orgs","repos_url":"https://api.github.com/users/a-johnston/repos","events_url":"https://api.github.com/users/a-johnston/events{/privacy}","received_events_url":"https://api.github.com/users/a-johnston/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-06-05T22:36:44Z","updated_at":"2025-06-05T22:36:56Z","body":"I added some info testing on other platforms with and without the fix here https://github.com/godotengine/godot/pull/107182#issuecomment-2946625482\n\nThe crash is macos specific but other platforms still have issues on main which are resolved with the linked pr","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2946639531/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2993966270","html_url":"https://github.com/godotengine/godot/issues/107066#issuecomment-2993966270","issue_url":"https://api.github.com/repos/godotengine/godot/issues/107066","id":2993966270,"node_id":"IC_kwDOAO6SJc6ydEy-","user":{"login":"a-johnston","id":9058941,"node_id":"MDQ6VXNlcjkwNTg5NDE=","avatar_url":"https://avatars.githubusercontent.com/u/9058941?v=4","gravatar_id":"","url":"https://api.github.com/users/a-johnston","html_url":"https://github.com/a-johnston","followers_url":"https://api.github.com/users/a-johnston/followers","following_url":"https://api.github.com/users/a-johnston/following{/other_user}","gists_url":"https://api.github.com/users/a-johnston/gists{/gist_id}","starred_url":"https://api.github.com/users/a-johnston/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/a-johnston/subscriptions","organizations_url":"https://api.github.com/users/a-johnston/orgs","repos_url":"https://api.github.com/users/a-johnston/repos","events_url":"https://api.github.com/users/a-johnston/events{/privacy}","received_events_url":"https://api.github.com/users/a-johnston/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-06-22T06:19:25Z","updated_at":"2025-06-22T21:08:36Z","body":"I've been seeing rare crashes from send_message being called with a bad ScriptEditorDebugger but I haven't been able to replicate it in a debugger to verify if it's null or non-null but invalid:\n```\n================================================================\nhandle_crash: Program crashed with signal 11\nEngine version: Godot Engine v4.5.beta.mono.custom_build (4e6ac9bccc7868432b9d8a009d34860a2e6f3393)\nDumping the backtrace. Please include this when reporting the bug on: https://github.com/godotengine/godot/issues\n[1] invoke_previous_action(sigaction*, int, __siginfo*, void*, bool)\n[2] 2   libsystem_platform.dylib            0x000000019e7d4624 _sigtramp + 56\n[3] ScriptEditorDebugger::is_session_active() (in godot.macos.editor.dev.arm64.mono) (/Users/adam/code/godot/./editor/debugger/script_editor_debugger.h:324)\n[4] ScriptEditorDebugger::_put_msg(String const&, Array const&, unsigned long long) (in godot.macos.editor.dev.arm64.mono) (/Users/adam/code/godot/editor/debugger/script_editor_debug\nger.cpp:75)\n[5] ScriptEditorDebugger::send_message(String const&, Array const&) (in godot.macos.editor.dev.arm64.mono) (/Users/adam/code/godot/editor/debugger/script_editor_debugger.cpp:1969)\n[6] EmbeddedProcessMacOS::display_state_changed() (in godot.macos.editor.dev.arm64.mono) (/Users/adam/code/godot/platform/macos/editor/embedded_process_macos.mm:141)\n[7] DisplayServerMacOS::_window_update_display_id(DisplayServerMacOS::WindowData*) (in godot.macos.editor.dev.arm64.mono) (/Users/adam/code/godot/platform/macos/display_server_macos.\nmm:3224)\n[8] DisplayServerMacOS::reparent_check(int) (in godot.macos.editor.dev.arm64.mono) (/Users/adam/code/godot/platform/macos/display_server_macos.mm:2100)\n[9] DisplayServerMacOS::window_set_transient(int, int) (in godot.macos.editor.dev.arm64.mono) (/Users/adam/code/godot/platform/macos/display_server_macos.mm:2257)\n[10] DisplayServerMacOS::create_sub_window(DisplayServer::WindowMode, DisplayServer::VSyncMode, unsigned int, Rect2i const&, bool, int) (in godot.macos.editor.dev.arm64.mono) (/Users\n/adam/code/godot/platform/macos/display_server_macos.mm:1905)\n[11] Window::_make_window() (in godot.macos.editor.dev.arm64.mono) (/Users/adam/code/godot/scene/main/window.cpp:665)\n[12] Window::set_visible(bool) (in godot.macos.editor.dev.arm64.mono) (/Users/adam/code/godot/scene/main/window.cpp:940)\n[13] Window::popup(Rect2i const&) (in godot.macos.editor.dev.arm64.mono) (/Users/adam/code/godot/scene/main/window.cpp:1993)\n```\nI'm not sure if it's a race or what but maybe it's worth adding a valid/null check to send message or changing how ScriptEditorDebugger is referenced\n\nedit: got the crash with lldb attached; it's definitely a distinct crash with null ScriptEditorDebugger and not a generic weird race but still investigating. I'll make a new issue if I figure it out","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2993966270/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2994596239","html_url":"https://github.com/godotengine/godot/issues/107066#issuecomment-2994596239","issue_url":"https://api.github.com/repos/godotengine/godot/issues/107066","id":2994596239,"node_id":"IC_kwDOAO6SJc6yfemP","user":{"login":"a-johnston","id":9058941,"node_id":"MDQ6VXNlcjkwNTg5NDE=","avatar_url":"https://avatars.githubusercontent.com/u/9058941?v=4","gravatar_id":"","url":"https://api.github.com/users/a-johnston","html_url":"https://github.com/a-johnston","followers_url":"https://api.github.com/users/a-johnston/followers","following_url":"https://api.github.com/users/a-johnston/following{/other_user}","gists_url":"https://api.github.com/users/a-johnston/gists{/gist_id}","starred_url":"https://api.github.com/users/a-johnston/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/a-johnston/subscriptions","organizations_url":"https://api.github.com/users/a-johnston/orgs","repos_url":"https://api.github.com/users/a-johnston/repos","events_url":"https://api.github.com/users/a-johnston/events{/privacy}","received_events_url":"https://api.github.com/users/a-johnston/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-06-23T00:51:22Z","updated_at":"2025-06-23T09:11:04Z","body":"Ah yeah, @stuartcarnie the new `EmbeddingState` enum is causing this to break due to closed not being completed https://github.com/godotengine/godot/blob/master/platform/macos/editor/embedded_process_macos.mm#L117-L118 so the processes aren't cleaned up and then https://github.com/godotengine/godot/blob/master/platform/macos/display_server_macos.mm#L3222-L3224 causes the stacktrace I posted above\n\nedit: this fixes it but it feels out of line with the other implementations so idk if it's correct https://github.com/a-johnston/godot/commit/a3f8a067a9356cd70a95b70f4ddcace001518357\n\nthe other approach that comes to mind would be checking for the closed status in `reset` but eagerly cleaning it up doesn't seem to be an issue","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2994596239/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null}]