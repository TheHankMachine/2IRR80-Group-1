/AdriaandeJongh/gists{/gist_id}","starred_url":"https://api.github.com/users/AdriaandeJongh/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/AdriaandeJongh/subscriptions","organizations_url":"https://api.github.com/users/AdriaandeJongh/orgs","repos_url":"https://api.github.com/users/AdriaandeJongh/repos","events_url":"https://api.github.com/users/AdriaandeJongh/events{/privacy}","received_events_url":"https://api.github.com/users/AdriaandeJongh/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-07-16T13:47:56Z","updated_at":"2026-07-16T13:47:56Z","body":"I think this faded property suggests that it is essentially disabled, which is the case with deprecated properties, right? So, I think this looks pretty good. I'd expect the tooltip to then state explicitly that the property was deprecated.","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4992656855/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5005229384","html_url":"https://github.com/godotengine/godot/pull/121364#issuecomment-5005229384","issue_url":"https://api.github.com/repos/godotengine/godot/issues/121364","id":5005229384,"node_id":"IC_kwDOAO6SJc8AAAABKlW9SA","user":{"login":"KoBeWi","id":2223172,"node_id":"MDQ6VXNlcjIyMjMxNzI=","avatar_url":"https://avatars.githubusercontent.com/u/2223172?v=4","gravatar_id":"","url":"https://api.github.com/users/KoBeWi","html_url":"https://github.com/KoBeWi","followers_url":"https://api.github.com/users/KoBeWi/followers","following_url":"https://api.github.com/users/KoBeWi/following{/other_user}","gists_url":"https://api.github.com/users/KoBeWi/gists{/gist_id}","starred_url":"https://api.github.com/users/KoBeWi/starred{/owner}{/repo}","subscriptions_url":"htt