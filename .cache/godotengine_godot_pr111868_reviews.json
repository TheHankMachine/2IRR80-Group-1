[{"id":3358552168,"node_id":"PRR_kwDOAO6SJc7IL3Bo","user":{"login":"clayjohn","id":16521339,"node_id":"MDQ6VXNlcjE2NTIxMzM5","avatar_url":"https://avatars.githubusercontent.com/u/16521339?u=e44a465cbebabb9ea2be80b59e6dc07966bef5b7&v=4","gravatar_id":"","url":"https://api.github.com/users/clayjohn","html_url":"https://github.com/clayjohn","followers_url":"https://api.github.com/users/clayjohn/followers","following_url":"https://api.github.com/users/clayjohn/following{/other_user}","gists_url":"https://api.github.com/users/clayjohn/gists{/gist_id}","starred_url":"https://api.github.com/users/clayjohn/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/clayjohn/subscriptions","organizations_url":"https://api.github.com/users/clayjohn/orgs","repos_url":"https://api.github.com/users/clayjohn/repos","events_url":"https://api.github.com/users/clayjohn/events{/privacy}","received_events_url":"https://api.github.com/users/clayjohn/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"You can basically remove any call to resize that is guaranteed to be less than 13 since those cases will be the same performance or slightly slower with the added call to resize. \r\n\r\nThis highlights why it is important to profile. If you checked these \"optimizations\" with a profiler you would have seen that the added code doesn't make a difference. \r\n\r\nPlease read our optimization guidelines https://contributing.godotengine.org/en/latest/engine/guidelines/optimization.html which explain a bit more the thought process you should engage in when deciding to optimize code. Importantly, you should only spend time optimizing code that actually impacts the run time performance of games. Its not really a good use of time to add code that saves a few microseconds in a method that is only called once during some debug method. In fact, its a net negative since it just makes the code more complex for no tangible benefit","state":"CHANGES_REQUESTED","html_url":"https://github.com/godotengine/godot/pull/111868#pullrequestreview-3358552168","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/111868","author_association":"MEMBER","_links":{"html":{"href":"https://github.com/godotengine/godot/pull/111868#pullrequestreview-3358552168"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/111868"}},"submitted_at":"2025-10-21T02:37:45Z","commit_id":null},{"id":3358599516,"node_id":"PRR_kwDOAO6SJc7IMClc","user":{"login":"DeeJayLSP","id":60024671,"node_id":"MDQ6VXNlcjYwMDI0Njcx","avatar_url":"https://avatars.githubusercontent.com/u/60024671?u=7e327c81e8a9552ea98ca69adcccac4a50657dd9&v=4","gravatar_id":"","url":"https://api.github.com/users/DeeJayLSP","html_url":"https://github.com/DeeJayLSP","followers_url":"https://api.github.com/users/DeeJayLSP/followers","following_url":"https://api.github.com/users/DeeJayLSP/following{/other_user}","gists_url":"https://api.github.com/users/DeeJayLSP/gists{/gist_id}","starred_url":"https://api.github.com/users/DeeJayLSP/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/DeeJayLSP/subscriptions","organizations_url":"https://api.github.com/users/DeeJayLSP/orgs","repos_url":"https://api.github.com/users/DeeJayLSP/repos","events_url":"https://api.github.com/users/DeeJayLSP/events{/privacy}","received_events_url":"https://api.github.com/users/DeeJayLSP/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"","state":"COMMENTED","html_url":"https://github.com/godotengine/godot/pull/111868#pullrequestreview-3358599516","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/111868","author_association":"CONTRIBUTOR","_links":{"html":{"href":"https://github.com/godotengine/godot/pull/111868#pullrequestreview-3358599516"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/111868"}},"submitted_at":"2025-10-21T02:58:28Z","commit_id":null},{"id":3359631