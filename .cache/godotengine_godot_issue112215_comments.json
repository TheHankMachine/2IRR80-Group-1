[{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3566958853","html_url":"https://github.com/godotengine/godot/pull/112215#issuecomment-3566958853","issue_url":"https://api.github.com/repos/godotengine/godot/issues/112215","id":3566958853,"node_id":"IC_kwDOAO6SJc7Um3kF","user":{"login":"syntaxerror247","id":176927541,"node_id":"U_kgDOCouzNQ","avatar_url":"https://avatars.githubusercontent.com/u/176927541?v=4","gravatar_id":"","url":"https://api.github.com/users/syntaxerror247","html_url":"https://github.com/syntaxerror247","followers_url":"https://api.github.com/users/syntaxerror247/followers","following_url":"https://api.github.com/users/syntaxerror247/following{/other_user}","gists_url":"https://api.github.com/users/syntaxerror247/gists{/gist_id}","starred_url":"https://api.github.com/users/syntaxerror247/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/syntaxerror247/subscriptions","organizations_url":"https://api.github.com/users/syntaxerror247/orgs","repos_url":"https://api.github.com/users/syntaxerror247/repos","events_url":"https://api.github.com/users/syntaxerror247/events{/privacy}","received_events_url":"https://api.github.com/users/syntaxerror247/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-11-22T18:42:09Z","updated_at":"2025-11-22T19:01:33Z","body":"Added support for DocumentTree to allow full access to a directory and do file operations using file paths in this selected directory. For example, when a directory is selected using FILE_DIALOG_MODE_OPEN_DIR, you receive a `treeUri` for eg `content://com.android.externalstorage.documents/tree/primary%3Atestdir`. To perform i/o in this directory, you can use FileAccess as usual, but the path must be relative to the selected directory in the format `treeUri#relative/path/to/file`.\r\n\r\nThis is now almost ready, only the documentation is left. So, please start reviewing it in the meantime. The sample code is incl