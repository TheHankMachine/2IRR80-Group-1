0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3702534096","html_url":"https://github.com/godotengine/godot/issues/109189#issuecomment-3702534096","issue_url":"https://api.github.com/repos/godotengine/godot/issues/109189","id":3702534096,"node_id":"IC_kwDOAO6SJc7csC_Q","user":{"login":"bdogabriel","id":57878742,"node_id":"MDQ6VXNlcjU3ODc4NzQy","avatar_url":"https://avatars.githubusercontent.com/u/57878742?v=4","gravatar_id":"","url":"https://api.github.com/users/bdogabriel","html_url":"https://github.com/bdogabriel","followers_url":"https://api.github.com/users/bdogabriel/followers","following_url":"https://api.github.com/users/bdogabriel/following{/other_user}","gists_url":"https://api.github.com/users/bdogabriel/gists{/gist_id}","starred_url":"https://api.github.com/users/bdogabriel/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/bdogabriel/subscriptions","organizations_url":"https://api.github.com/users/bdogabriel/orgs","repos_url":"https://api.github.com/users/bdogabriel/repos","events_url":"https://api.github.com/users/bdogabriel/events{/privacy}","received_events_url":"https://api.github.com/users/bdogabriel/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-12-31T17:10:17Z","updated_at":"2025-12-31T17:10:17Z","body":"I had the same issue and the way I worked around was this:\n\n```gdscript\nconst CSharpClass: Variant = preload(\n    \"res://scripts/csharp/CSharpClass.cs\"\n)\n\nvar cs_class_instance: CSharpClass = CSharpClass.new(...)\n```","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3702534096/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5804323966","html_url":"https://github.com/godotengine/godot/issues/109189#issuecomment-5804323966","issue_url":"https://api.github.com/repos/godotengine/godot/issues/109189","id":5804323966,"node_id":"IC_kwDOAO6SJc8AAAABWfb0fg","user":{"login":"raulsntos","id":3903059,"node_id":"MDQ6VXNlcjM5MDMwNTk=","avatar_url":"https://avatars.githubusercontent.com/u/3903059?v=4","gravatar_id":"","url":"https://api.github.com/users/raulsntos","html_url":"https://github.com/raulsntos","followers_url":"https://api.github.com/users/raulsntos/followers","following_url":"https://api.github.com/users/raulsntos/following{/other_user}","gists_url":"https://api.github.com/users/raulsntos/gists{/gist_id}","starred_url":"https://api.github.com/users/raulsntos/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/raulsntos/subscriptions","organizations_url":"https://api.github.com/users/raulsntos/orgs","repos_url":"https://api.github.com/users/raulsntos/repos","events_url":"https://api.github.com/users/raulsntos/events{/privacy}","received_events_url":"https://api.github.com/users/raulsntos/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-09-23T22:56:35Z","updated_at":"2026-09-23T22:56:35Z","body":"Looks like GDScript is specifically looking for a method called `_init`, since that's what they call the constructor method in GDScript. Naturally, they won't find such a method in C#. However, it looks like if you define an `_init` method in your C# script, it's enough for GDScript to call the constructor. For example:\n\n```csharp\nusing Godot;\nusing System;\n\npublic partial class CSScript : Node\n{\n\tpublic CSScript(int req_param)\n\t{\n\t\tGD.Print(req_param);\n\t}\n\n\t// The method implementation doesn't matter,\n\t// `.new()` will call the class constructor and ignore this method.\n\tprivate static CSScript _init(int req_param) => throw new NotImplementedException();\n}\n```","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5804323966/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null}]