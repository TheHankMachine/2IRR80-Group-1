d_events","type":"User","user_view_type":"public","site_admin":false},"open_issues":343,"closed_issues":2335,"state":"open","created_at":"2026-04-13T15:59:35Z","updated_at":"2026-10-22T06:28:22Z","due_on":null,"closed_at":null},"comments":9,"created_at":"2026-05-24T11:34:58Z","updated_at":"2026-07-16T05:40:28Z","closed_at":"2026-06-30T13:50:26Z","assignee":null,"author_association":"MEMBER","issue_field_values":[],"type":null,"active_lock_reason":null,"draft":false,"pull_request":{"url":"https://api.github.com/repos/godotengine/godot/pulls/119706","html_url":"https://github.com/godotengine/godot/pull/119706","diff_url":"https://github.com/godotengine/godot/pull/119706.diff","patch_url":"https://github.com/godotengine/godot/pull/119706.patch","merged_at":"2026-06-30T13:50:26Z"},"body":"This PR adds native touch support to `TextEdit` and `CodeEdit`.\r\n\r\n- Tap (press -> release): positions the cursor and opens the virtual keyboard.\r\n- Drag (press -> drag -> release): scrolls the text content, including inertial scrolling support.\r\n- Text selection:\r\n    - Double-tap selects a word.\r\n    - Double-tap, hold, and drag selects the portion you're hovering over.\r\n    - Basic selection handle support has also been added and additional improvements like a context panel would be done in a follow-up.\r\n- Added drag-scrolling support to the code completion popup. Previously, it could not be scrolled using touch input. See https://github.com/godotengine/godot/pull/119706#issuecomment-4691322370\r\n\r\nhttps://github.com/user-attachments/assets/66779249-6759-432f-8ed2-860c380b795c\r\n\r\n","closed_by":{"login":"Repiteo","id":17489292,"node_id":"MDQ6VXNlcjE3NDg5Mjky","avatar_url":"https://avatars.githubusercontent.com/u/17489292?v=4","gravatar_id":"","url":"https://api.github.com/users/Repiteo","html_url":"https://github.com/Repiteo","followers_url":"https://api.github.com/users/Repiteo/followers","following_url":"https://api.github.com/users/Repiteo/following{/other_u