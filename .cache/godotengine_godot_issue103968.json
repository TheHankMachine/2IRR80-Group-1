y":null},{"id":890310502,"node_id":"MDU6TGFiZWw4OTAzMTA1MDI=","url":"https://api.github.com/repos/godotengine/godot/labels/topic:import","name":"topic:import","color":"ffee88","default":false,"description":"","archived_at":null,"archived_by":null}],"state":"closed","locked":false,"assignees":[],"milestone":{"url":"https://api.github.com/repos/godotengine/godot/milestones/22","html_url":"https://github.com/godotengine/godot/milestone/22","labels_url":"https://api.github.com/repos/godotengine/godot/milestones/22/labels","id":12070367,"node_id":"MI_kwDOAO6SJc4AuC3f","number":22,"title":"4.5","description":"","creator":{"login":"Sauermann","id":6299227,"node_id":"MDQ6VXNlcjYyOTkyMjc=","avatar_url":"https://avatars.githubusercontent.com/u/6299227?v=4","gravatar_id":"","url":"https://api.github.com/users/Sauermann","html_url":"https://github.com/Sauermann","followers_url":"https://api.github.com/users/Sauermann/followers","following_url":"https://api.github.com/users/Sauermann/following{/other_user}","gists_url":"https://api.github.com/users/Sauermann/gists{/gist_id}","starred_url":"https://api.github.com/users/Sauermann/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Sauermann/subscriptions","organizations_url":"https://api.github.com/users/Sauermann/orgs","repos_url":"https://api.github.com/users/Sauermann/repos","events_url":"https://api.github.com/users/Sauermann/events{/privacy}","received_events_url":"https://api.github.com/users/Sauermann/received_events","type":"User","user_view_type":"public","site_admin":false},"open_issues":3,"closed_issues":3687,"state":"closed","created_at":"2024-12-19T08:51:28Z","updated_at":"2026-09-04T21:48:38Z","due_on":"2025-09-15T00:00:00Z","closed_at":"2025-09-18T17:13:14Z"},"comments":7,"created_at":"2025-03-11T12:39:55Z","updated_at":"2025-04-29T20:58:38Z","closed_at":"2025-04-28T00:27:06Z","assignee":null,"author_association":"CONTRIBUTOR","issue_field_values":[],"type":null,"active_lock_reason":null,"draft":false,"pull_request":{"url":"https://api.github.com/repos/godotengine/godot/pulls/103968","html_url":"https://github.com/godotengine/godot/pull/103968","diff_url":"https://github.com/godotengine/godot/pull/103968.diff","patch_url":"https://github.com/godotengine/godot/pull/103968.patch","merged_at":"2025-04-28T00:27:06Z"},"body":"- Source: https://github.com/BinomialLLC/basis_universal/releases/tag/v1_60\r\n- Changes: https://github.com/BinomialLLC/basis_universal/compare/v1_50_0...v1_60\r\n- Release notes: https://github.com/BinomialLLC/basis_universal/wiki/Release-Notes\r\n\r\n---\r\n\r\nDue to the update changing a plethora of things, here's a recap:\r\n\r\n- Compression parameters were renamed, as seen in `modules/basis_universal/image_compress_basisu.cpp`\r\n- Because `libktx` makes use of the bundled `basis_universal` library, I had to change the type of one variable, as seen in `thirdparty/libktx/patches/0003-basisu-1.60.patch` (new patch for `libktx`)\r\n- `thirdparty/basis_universal/encoder/basisu_astc_hdr_6x6_enc.h`, which is a new file, had a superscript two symbol in a comment - this is all good and nice, but due to, I guess, UTF-8 non-complience, it generated a warning that was treated as an error by one Windows CI job; I changed the symbol to `^2`, as seen in `thirdparty/basis_universal/patches/0005-windows-illegal-character.patch` (also see: https://github.com/BinomialLLC/basis_universal/pull/394)\r\n- `clang` sanitizers didn't like the ambiguity of `1ULL`, as it could be treated as a 32-bit or a 64-bit integer, due to an implicit conversion; patched in `thirdparty/basis_universal/patches/0006-ambiguous-calls.patch` (also see: https://github.com/BinomialLLC/basis_universal/pull/387)\r\n- Other patches have been regenerated, notably another change to `jpeg_decoder` flags had to be added in `thirdparty/basis_universal/patches/0002-external-jpgd.patch`\r\n\r\n---\r\n\r\nSpeaking of patches, wouldn't simply prepending function bodies in `thirdparty/basis_universal/patches/0004-remove-tinydds-qoi.patch` with `return false;` be an easier change that achieves the same result? Or would something in the build system throw a tantrum over unreachable code?\r\n","closed_by":{"login":"Repiteo","id":17489292,"node_id":"MDQ6VXNlcjE3NDg5Mjky","avatar_url":"https://avatars.githubusercontent.com/u/17489292?v=4","gravatar_id":"","url":"https://api.github.com/users/Repiteo","html_url":"https://github.com/Repiteo","followers_url":"https://api.github.com/users/Repiteo/followers","following_url":"https://api.github.com/users/Repiteo/following{/other_user}","gists_url":"https://api.github.com/users/Repiteo/gists{/gist_id}","starred_url":"https://api.github.com/users/Repiteo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Repiteo/subscriptions","organizations_url":"https://api.github.com/users/Repiteo/orgs","repos_url":"https://api.github.com/users/Repiteo/repos","events_url":"https://api.github.com/users/Repiteo/events{/privacy}","received_events_url":"https://api.github.com/users/Repiteo/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/103968/reactions","total_count":2,"+1":2,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/godotengine/godot/issues/103968/timeline","performed_via_github_app":null,"state_reason":null}