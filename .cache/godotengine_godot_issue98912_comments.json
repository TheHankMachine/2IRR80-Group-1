s://api.github.com/users/KoBeWi/following{/other_user}","gists_url":"https://api.github.com/users/KoBeWi/gists{/gist_id}","starred_url":"https://api.github.com/users/KoBeWi/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/KoBeWi/subscriptions","organizations_url":"https://api.github.com/users/KoBeWi/orgs","repos_url":"https://api.github.com/users/KoBeWi/repos","events_url":"https://api.github.com/users/KoBeWi/events{/privacy}","received_events_url":"https://api.github.com/users/KoBeWi/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2024-11-07T13:34:42Z","updated_at":"2024-11-07T13:34:42Z","body":"Removing owner helps. Your problem is that you are adding a new child and set owner to the scene, so it gets saved. Then when you reload, the `_ready()` code runs again, adding a new child, next to the previous one that was saved in the scene.\r\n\r\nThough there is a bug here that when you add a new child with owner, it does not appear in scene tree until you reload the scene. Not sure why.","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2462257098/reactions","total_count":3,"+1":3,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2462825259","html_url":"https://github.com/godotengine/godot/issues/98912#issuecomment-2462825259","issue_url":"https://api.github.com/repos/godotengine/godot/issues/98912","id":2462825259,"node_id":"IC_kwDOAO6SJc6Sy7sr","user":{"login":"fire","id":32321,"node_id":"MDQ6VXNlcjMyMzIx","avatar_url":"https://avatars.githubusercontent.com/u/32321?v=4","gravatar_id":"","url":"https://api.github.com/users/fire","html_url":"https://github.com/fire","followers_url":"https://api.github.com/users/fire/followers","following_url":"https://api.github.com/users/fire/following{/other_user}","gists_url":"https://api.github.com/users/fire/gists{/gist_id}","starred_url":"https://api.github.com/users/fire/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/fire/subscriptions","organizations_url":"https://api.github.com/users/fire/orgs","repos_url":"https://api.github.com/users/fire/repos","events_url":"https://api.github.com/users/fire/events{/privacy}","received_events_url":"https://api.github.com/users/fire/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2024-11-07T17:25:23Z","updated_at":"2024-11-07T17:25:23Z","body":"> Though there is a bug here that when you add a new child with owner, it does not appear in scene tree until you reload the scene. Not sure why.\r\n\r\n@KoBeWi can you report the issue on the tracker here?","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2462825259/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2463182809","html_url":"https://github.com/godotengine/godot/issues/98912#issuecomment-2463182809","issue_url":"https://api.github.com/repos/godotengine/godot/issues/98912","id":2463182809,"node_id":"IC_kwDOAO6SJc6S0S_Z","user":{"login":"KoBeWi","id":2223172,"node_id":"MDQ6VXNlcjIyMjMxNzI=","avatar_url":"https://avatars.githubusercontent.com/u/2223172?v=4","gravatar_id":"","url":"https://api.github.com/users/KoBeWi","html_url":"https://github.com/KoBeWi","followers_url":"https://api.github.com/users/KoBeWi/followers","following_url":"https://api.github.com/users/KoBeWi/following{/other_user}","gists_url":"https://api.github.com/users/KoBeWi/gists{/gist_id}","starred_url":"https://api.github.com/users/KoBeWi/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/KoBeWi/subscriptions","organizations_url":"https://api.github.com/users/KoBeWi/orgs","repos_url":"https://api.github.com/users/KoBeWi/repos","events_url":"https://api.github.com/users/KoBeWi/events{/privacy}","received_events_url":"https://api.github.com/users/KoBeWi/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2024-11-07T20:48:32Z","updated_at":"2024-11-07T20:48:32Z","body":"The `owner` is null inside `_ready()`, so your `spr.set_owner(get_owner())` does nothing.\r\nApparently there is a difference between adding a node to scene and instantiating a node with scene. In the latter case the owner does exist in `_ready()`.\r\nNot sure if it's even a bug.","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2463182809/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2463767015","html_url":"https://github.com/godotengine/godot/issues/98912#issuecomment-2463767015","issue_url":"https://api.github.com/repos/godotengine/godot/issues/98912","id":2463767015,"node_id":"IC_kwDOAO6SJc6S2hnn","user":{"login":"JekSun97","id":130399274,"node_id":"U_kgDOB8W8Kg","avatar_url":"https://avatars.githubusercontent.com/u/130399274?v=4","gravatar_id":"","url":"https://api.github.com/users/JekSun97","html_url":"https://github.com/JekSun97","followers_url":"https://api.github.com/users/JekSun97/followers","following_url":"https://api.github.com/users/JekSun97/following{/other_user}","gists_url":"https://api.github.com/users/JekSun97/gists{/gist_id}","starred_url":"https://api.github.com/users/JekSun97/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/JekSun97/subscriptions","organizations_url":"https://api.github.com/users/JekSun97/orgs","repos_url":"https://api.github.com/users/JekSun97/repos","events_url":"https://api.github.com/users/JekSun97/events{/privacy}","received_events_url":"https://api.github.com/users/JekSun97/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2024-11-08T04:57:25Z","updated_at":"2024-11-08T05:11:10Z","body":"@KoBeWi In the GDExtension plugin I deleted the descendants, but it did not solve the problem :(\r\nCould you please describe what exactly I need to change to fix the duplication of nodes, if I fixed [this error](https://github.com/JekSun97/gdTree3D/issues/1), I could continue to develop my plugin.\r\nThe C++ code looks like this:\r\n```\r\nTree3D::Tree3D() {\r\n\ttrunk_inst = memnew(MeshInstance3D);\r\n\ttwig_inst = memnew(MeshInstance3D);\t\r\n\tthis->add_child(trunk_inst);\r\n\tthis->add_child(twig_inst);\r\n}\r\n\r\nvoid Tree3D::_exit_tree() {\r\n\tremove_child(trunk_inst);\r\n\ttrunk_inst=nullptr;\r\n\tif(twig_inst)\r\n\t{\r\n\tremove_child(twig_inst);\r\n\ttwig_inst=nullptr;\r\n\t}\r\n}\r\n```\r\n\r\nWhen I opened MRP today I also noticed another strange behavior, when selecting descendants in the node tree, all descendants are selected, and after renaming the editor closes\r\n\r\nhttps://github.com/user-attachments/assets/d672c1fb-4163-4e4d-bb67-cc0f1cceb77e\r\n\r\n","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2463767015/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2464328762","html_url":"https://github.com/godotengine/godot/issues/98912#issuecomment-2464328762","issue_url":"https://api.github.com/repos/godotengine/godot/issues/98912","id":2464328762,"node_id":"IC_kwDOAO6SJc6S4qw6","user":{"login":"KoBeWi","id":2223172,"node_id":"MDQ6VXNlcjIyMjMxNzI=","avatar_url":"https://avatars.githubusercontent.com/u/2223172?v=4","gravatar_id":"","url":"https://api.github.com/users/KoBeWi","html_url":"https://github.com/KoBeWi","followers_url":"https://api.github.com/users/KoBeWi/followers","following_url":"https://api.github.com/users/KoBeWi/following{/other_user}","gists_url":"https://api.github.com/users/KoBeWi/gists{/gist_id}","starred_url":"https://api.github.com/users/KoBeWi/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/KoBeWi/subscriptions","organizations_url":"https://api.github.com/users/KoBeWi/orgs","repos_url":"https://api.github.com/users/KoBeWi/repos","events_url":"https://api.github.com/users/KoBeWi/events{/privacy}","received_events_url":"https://api.github.com/users/KoBeWi/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2024-11-08T10:21:12Z","updated_at":"2024-11-08T10:21:12Z","body":"I think #89442 will solve your issue.\r\nUntil then you can probably use `force_parent_owned()`, if it's C++.\r\n\r\n> When I opened MRP today I also noticed another strange behavior, when selecting descendants in the node tree, all descendants are selected, and after renaming the editor closes\r\n\r\nYour nodes have the same name, hence the selection bug.","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2464328762/reactions","total_count":2,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":2,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2466715365","html_url":"https://github.com/godotengine/godot/issues/98912#issuecomment-2466715365","issue_url":"https://api.github.com/repos/godotengine/godot/issues/98912","id":2466715365,"node_id":"IC_kwDOAO6SJc6TBxbl","user":{"login":"JekSun97","id":130399274,"node_id":"U_kgDOB8W8Kg","avatar_url":"https://avatars.githubusercontent.com/u/130399274?v=4","gravatar_id":"","url":"https://api.github.com/users/JekSun97","html_