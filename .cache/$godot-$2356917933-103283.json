godotengine/godot/pulls/103283","author_association":"MEMBER","submitted_at":"2025-02-28T19:15:36Z"},{"id":2651598336,"node_id":"PRR_kwDOAO6SJc6eDC4A","state":"COMMENTED","user":{"site_admin":false,"suspended":false,"updated_at":"0001-01-01T00:00:00Z","avatar_url":"https://avatars.githubusercontent.com/u/180032?u=68d23e7ee9cdf810da125e8510b72f845b9dccc8&v=4","created_at":"0001-01-01T00:00:00Z","followers":0,"following":0,"html_url":"https://github.com/Calinou","id":180032,"node_id":"MDQ6VXNlcjE4MDAzMg==","login":"Calinou","type":"User","owned_private_repos":0,"public_gists":0,"public_repos":0,"total_private_repos":0,"url":"https://api.github.com/users/Calinou"},"body":"","html_url":"https://github.com/godotengine/godot/pull/103283#pullrequestreview-2651598336","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/103283","author_association":"MEMBER","submitted_at":"2025-02-28T19:16:37Z"},{"id":2655511218,"node_id":"PRR_kwDOAO6SJc6eR-Ky","state":"COMMENTED","user":{"site_admin":false,"suspended":false,"updated_at":"0001-01-01T00:00:00Z","avatar_url":"https://avatars.githubusercontent.com/u/180032?u=68d23e7ee9cdf810da125e8510b72f845b9dccc8&v=4","created_at":"0001-01-01T00:00:00Z","followers":0,"following":0,"html_url":"https://github.com/Calinou","id":180032,"node_id":"MDQ6VXNlcjE4MDAzMg==","login":"Calinou","type":"User","owned_private_repos":0,"public_gists":0,"public_repos":0,"total_private_repos":0,"url":"https://api.github.com/users/Calinou"},"body":"Tested locally, it works as expected.\r\n\r\n**Testing project:** [test_zip_compression_level.zip](https://github.com/user-attachments/files/19061386/test_zip_compression_level.zip)\r\n\r\nCompressing a single 10.5 MB text file (1 million times the string \"Hello world!\") with each compression mode. From top to bottom: Default, None, Best Speed (Fast), Best:\r\n\r\n![image](https://github.com/user-attachments/assets/bbe51ca0-d2d2-4f87-9a89-7a67ca8f387c)\r\n\r\nMost of the time, Best will not be any better than Default, but it's significantly slower to compress, so it should be used with care.\r\n\r\nSome feedback:\r\n\r\n- I suggest adding a getter for `compression_level` and exposing it as a property, so you can write `ZIPPacker.compression_level = ...`.\r\n- I suggest renaming `COMPRESSION_BEST_SPEED` to `COMPRESSION_FAST`, as \"fast\" is generally understood to be the counterpart of \"best\" when it comes to compression algorithms. It also avoids confusion with the existing `COMPRESSION_BEST`.","html_url":"https://github.com/godotengine/godot/pull/103283#pullrequestreview-2655511218","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/103283","author_association":"MEMBER","submitted_at":"2025-03-03T22:38:56Z"},{"id":2675567239,"node_id":"PRR_kwDOAO6SJc6feeqH","state":"COMMENTED","user":{"site_admin":false,"suspended":false,"updated_at":"0001-01-01T00:00:00Z","avatar_url":"https://avatars.githubusercontent.com/u/180032?u=68d23e7ee9cdf810da125e8510b72f845b9dccc8&v=4","created_at":"0001-01-01T00:00:00Z","followers":0,"following":0,"html_url":"https://github.com/Calinou","id":180032,"node_id":"MDQ6VXNlcjE4MDAzMg==","login":"Calinou","type":"User","owned_private_repos":0,"public_gists":0,"public_repos":0,"total_private_repos":0,"url":"https://api.github.com/users/Calinou"},"body":"","html_url":"https://github.com/godotengine/godot/pull/103283#pullrequestreview-2675567239","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/103283","author_association":"MEMBER","submitted_at":"2025-03-11T17:45:26Z"},{"id":2699359173,"node_id":"PRR_kwDOAO6SJc6g5PPF","state":"APPROVED","user":{"site_admin":false,"suspended":false,"updated_at":"0001-01-01T00:00:00Z","avatar_url":"https://avatars.githubusercontent.com/u/180032?u=68d23e7ee9cdf810da125e8510b72f845b9dccc8&v=4","created_at":"0001-01-01T00:00:00Z","followers":0,"following":0,"html_url":"https://github.com/Calinou","id":180032,"node_id":"MDQ6VXNlcjE4MDAzMg==","login":"Calinou","