[{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2660018345","html_url":"https://github.com/godotengine/godot/issues/102799#issuecomment-2660018345","issue_url":"https://api.github.com/repos/godotengine/godot/issues/102799","id":2660018345,"node_id":"IC_kwDOAO6SJc6ejKip","user":{"login":"clayjohn","id":16521339,"node_id":"MDQ6VXNlcjE2NTIxMzM5","avatar_url":"https://avatars.githubusercontent.com/u/16521339?v=4","gravatar_id":"","url":"https://api.github.com/users/clayjohn","html_url":"https://github.com/clayjohn","followers_url":"https://api.github.com/users/clayjohn/followers","following_url":"https://api.github.com/users/clayjohn/following{/other_user}","gists_url":"https://api.github.com/users/clayjohn/gists{/gist_id}","starred_url":"https://api.github.com/users/clayjohn/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/clayjohn/subscriptions","organizations_url":"https://api.github.com/users/clayjohn/orgs","repos_url":"https://api.github.com/users/clayjohn/repos","events_url":"https://api.github.com/users/clayjohn/events{/privacy}","received_events_url":"https://api.github.com/users/clayjohn/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-02-14T18:35:51Z","updated_at":"2025-02-14T18:35:51Z","body":"We probably need to copy the same logic used for LODs into the code for fading. See here for reference: https://github.com/godotengine/godot/pull/92290","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2660018345/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3602734650","html_url":"https://github.com/godotengine/godot/issues/102799#issuecomment-3602734650","issue_url":"https://api.github.com/repos/godotengine/godot/issues/102799","id":3602734650,"node_id":"IC_kwDOAO6SJc7WvV46","user":{"login":"ttencate","id":90930,"node_id":"MDQ6VXNlcjkwOTMw","avatar_url":"https://avatars.githubusercontent.com/u/90930?v=4","gravatar_id":"","url":"https://api.github.com/users/ttencate","html_url":"https://github.com/ttencate","followers_url":"https://api.github.com/users/ttencate/followers","following_url":"https://api.github.com/users/ttencate/following{/other_user}","gists_url":"https://api.github.com/users/ttencate/gists{/gist_id}","starred_url":"https://api.github.com/users/ttencate/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/ttencate/subscriptions","organizations_url":"https://api.github.com/users/ttencate/orgs","repos_url":"https://api.github.com/users/ttencate/repos","events_url":"https://api.github.com/users/ttencate/events{/privacy}","received_events_url":"https://api.github.com/users/ttencate/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-12-02T15:52:37Z","updated_at":"2025-12-02T15:52:37Z","body":"The [documentation](https://docs.godotengine.org/en/stable/tutorials/3d/visibility_ranges.html#visibility-range-properties) explicitly says _origin_, so to preserve backwards compatibility, an option should be added to use the AABB instead.\n\nShould this compute the distance to the center of the AABB, as mentioned by @TokisanGames above, or to the closest point on the AABB? I think closest point would make more sense: if the camera is close to a very large AABB, we'd still want the highest detail level, just like with automatic LODs. (If there's going to be an option, it would be straightforward to support both, but there's no need to write/maintain code if nobody will use it.)","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3602734650/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3602757930","html_url":"https://github.com/godotengine/godot/issues/102799#issuecomment-3602757930","issue_url":"https://api.github.com/repos/godotengine/godot/issues/102799","id":3602757930,"node_id":"IC_kwDOAO6SJc7Wvbkq","user":{"login":"ttencate","id":90930,"node_id":"MDQ6VXNlcjkwOTMw","avatar_url":"https://avatars.githubusercontent.com/u/90930?v=4","gravatar_id":"","url":"https://api.github.com/users/ttencate","html_url":"https://github.com/ttencate","followers_url":"https://api.github.com/users/ttencate/followers","following_url":"https://api.github.com/users/ttencate/following{/other_user}","gists_url":"https://api.github.com/users/ttencate/gists{/gist_id}","starred_url":"https://api.github.com/users/ttencate/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/ttencate/subscriptions","organizations_url":"https://api.github.com/users/ttencate/orgs","repos_url":"https://api.github.com/users/ttencate/repos","events_url":"https://api.github.com/users/ttencate/events{/privacy}","received_events_url":"https://api.github.com/users/ttencate/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-12-02T15:57:37Z","updated_at":"2025-12-03T08:38:23Z","body":"Related, and possibly duplicates: ~~#68243 (though this is not for multimeshes)~~, #79471","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3602757930/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3602885313","html_url":"https://github.com/godotengine/godot/issues/102799#issuecomment-3602885313","issue_url":"https://api.github.com/repos/godotengine/godot/issues/102799","id":3602885313,"node_id":"IC_kwDOAO6SJc7Wv6rB","user":{"login":"ttencate","id":90930,"node_id":"MDQ6VXNlcjkwOTMw","avatar_url":"https://avatars.githubusercontent.com/u/90930?v=4","gravatar_id":"","url":"https://api.github.com/users/ttencate","html_url":"https://github.com/ttencate","followers_url":"https://api.github.com/users/ttencate/followers","following_url":"https://api.github.com/users/ttencate/following{/other_user}","gists_url":"https://api.github.com/users/ttencate/gists{/gist_id}","starred_url":"https://api.github.com/users/ttencate/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/ttencate/subscriptions","organizations_url":"https://api.github.com/users/ttencate/orgs","repos_url":"https://api.github.com/users/ttencate/repos","events_url":"https://api.github.com/users/ttencate/events{/privacy}","received_events_url":"https://api.github.com/users/ttencate/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-12-02T16:19:44Z","updated_at":"2025-12-02T16:19:44Z","body":"I can't find anything specific to multimeshes in the code; it's all just `VisualInstance`s at this level.\n\nThis looks like a discrepancy to me; am I barking up the right tree?\n\nhttps://github.com/godotengine/godot/blob/5f12ada7a4ae9c440e2b22be168c78dba0244075/servers/rendering/renderer_scene_cull.cpp#L1471\n\nvs.\n\nhttps://github.com/godotengine/godot/blob/5f12ada7a4ae9c440e2b22be168c78dba0244075/servers/rendering/renderer_rd/forward_clustered/render_forward_clustered.cpp#L957","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3602885313/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3603374466","html_url":"https://github.com/godotengine/godot/issues/102799#issuecomment-3603374466","issue_url":"https://api.github.com/repos/godotengine/godot/issues/102799","id":3603374466,"node_id":"IC_kwDOAO6SJc7WxyGC","user":{"login":"TokisanGames","id":632766,"node_id":"MDQ6VXNlcjYzMjc2Ng==","avatar_url":"https://avatars.githubusercontent.com/u/632766?v=4","gravatar_id":"","url":"https://api.github.com/users/TokisanGames","html_url":"https://github.com/TokisanGames","followers_url":"https://api.github.com/users/TokisanGames/followers","following_url":"https://api.github.com/users/TokisanGames/following{/other_user}","gists_url":"https://api.github.com/users/TokisanGames/gists{/gist_id}","starred_url":"https://api.github.com/users/TokisanGames/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/TokisanGames/subscriptions","organizations_url":"https://api.github.com/users/TokisanGames/orgs","repos_url":"https://api.github.com/users/TokisanGames/repos","events_url":"https://api.github.com/users/TokisanGames/events{/privacy}","received_events_url":"https://api.github.com/users/TokisanGames/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-12-02T18:18:47Z","updated_at":"2025-12-02T18:18:47Z","body":"What happens in the MRP if you change the latter to compare fade distance against the AABB center with the camera origin?\n\n> The [documentation](https://docs.godotengine.org/en/stable/tutorials/3d/visibility_ranges.html#visibility-range-properties) explicitly says origin, so to preserve backwards compatibility, an option should be added to use the AABB instead.\n\nBackwards compatibility means to maintain how it works, not change how it works to account for incorrect documentation. The doc says origin, but the code says AABB center. The docs are wrong.\n\nThough it's unlikely a MeshInstance3D will have a custom AABB removed from their origin, it has the option to do so, and MMIs are highly likely to have separated AABBs. Culling based on MMI origin would be disastrous.\n\n> Should this compute the distance to the center of the AABB, as mentioned by @TokisanGames above, or to the closest point on the AABB? I think closest point would make more sense: if the camera is close to a very large AABB, we'd still want the highest detail level, just like with automatic LODs. \n\nThe closest point would be a redesign choice, not a fix, and not backwards compatible. You could discuss that at the rendering meetings. My thought on the matter is the AABB center is simplest. Why compare 8 distances every frame for thousands of objects when one will suffice?\n\nHow it works right now is fine. The issue is only the fade mode, which as you noted the code doesn't match non-fade mode. All we need is to fix fade mode and this ticket can be closed, and possibly some of the others found.\n\n","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3603374466/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3605657152","html_url":"https://github.com/godotengine/godot/issues/102799#issuecomment-3605657152","issue_url":"https://api.github.com/repos/godotengine/godot/issues/102799","id":3605657152,"node_id":"IC_kwDOAO6SJc7W6fZA","user":{"login":"ttencate","id":90930,"node_id":"MDQ6VXNlcjkwOTMw","avatar_url":"https://avatars.githubusercontent.com/u/90930?v=4","gravatar_id":"","url":"https://api.github.com/users/ttencate","html_url":"https://github.com/ttencate","followers_url":"https://api.github.com/users/ttencate/followers","following_url":"https://api.github.com/users/ttencate/following{/other_user}","gists_url":"https://api.github.com/users/ttencate/gists{/gist_id}","starred_url":"https://api.github.com/users/ttencate/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/ttencate/subscriptions","organizations_url":"https://api.github.com/users/ttencate/orgs","repos_url":"https://api.github.com/users/ttencate/repos","events_url":"https://api.github.com/users/ttencate/events{/privacy}","received_events_url":"https://api.github.com/users/ttencate/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-12-03T08:32:37Z","updated_at":"2025-12-03T08:32:37Z","body":"You are absolutely right.\n\nIt was indeed a simple one-line fix, and #79471 is also fixed by that. Sent [a PR](https://github.com/godotengine/godot/pull/113486) for the code and [another](https://github.com/godotengine/godot-docs/pull/11511) for the docs.","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3605657152/reactions","total_count":1,"+1":0,"-1":0,"laugh":0,"hooray":1,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3606065883","html_url":"https://github.com/godotengine/godot/issues/102799#issuecomment-3606065883","issue_url":"https://api.github.com/repos/godotengine/godot/issues/102799","id":3606065883,"node_id":"IC_kwDOAO6SJc7W8DLb","user":{"login":"TokisanGames","id":632766,"node_id":"MDQ6VXNlcjYzMjc2Ng==","avatar_url":"https://avatars.githubusercontent.com/u/632766?v=4","gravatar_id":"","url":"https://api.github.com/users/TokisanGames","html_url":"https://github.com/TokisanGames","followers_url":"https://api.github.com/users/TokisanGames/followers","following_url":"https://api.github.com/users/TokisanGames/following{/other_user}","gists_url":"https://api.github.com/users/TokisanGames/gists{/gist_id}","starred_url":"https://api.github.com/users/TokisanGames/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/TokisanGames/subscriptions","organizations_url":"https://api.github.com/users/TokisanGames/orgs","repos_url":"https://api.github.com/users/TokisanGames/repos","events_url":"https://api.github.com/users/TokisanGames/events{/privacy}","received_events_url":"https://api.github.com/users/TokisanGames/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-12-03T10:11:37Z","updated_at":"2025-12-03T10:11:37Z","body":"Wonderful, thank you. ","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3606065883/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null}]