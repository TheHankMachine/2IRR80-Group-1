_MODE_OPEN_FILE\nvar freeme = func(): dialog.queue_free()\ndialog.exclusive = true\ndialog.canceled.connect(freeme)\ndialog.confirmed.connect(freeme)\ndialog.close_requested.connect(freeme)\n\ndialog.filters = [\"*.json; JSON text file;text/json\",\n\t\"*.tres; Godot resource file;text/tres\"]\n\t\ndialog.file_selected.connect(func(path):\n\tpass # irrelevant stuff\n)\n\nadd_child(dialog)\ndialog.show()\n```\n\n### Minimal reproduction project (MRP)\n\nPlease see code above","closed_by":{"login":"powertomato","id":1530983,"node_id":"MDQ6VXNlcjE1MzA5ODM=","avatar_url":"https://avatars.githubusercontent.com/u/1530983?v=4","gravatar_id":"","url":"https://api.github.com/users/powertomato","html_url":"https://github.com/powertomato","followers_url":"https://api.github.com/users/powertomato/followers","following_url":"https://api.github.com/users/powertomato/following{/other_user}","gists_url":"https://api.github.com/users/powertomato/gists{/gist_id}","starred_url":"https://api.github.com/users/powertomato/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/powertomato/subscriptions","organizations_url":"https://api.github.com/users/powertomato/orgs","repos_url":"https://api.github.com/users/powertomato/repos","events_url":"https://api.github.com/users/powertomato/events{/privacy}","received_events_url":"https://api.github.com/users/powertomato/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/107354/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/godotengine/godot/issues/107354/timeline","performed_via_github_app":null,"state_reason":"completed","pinned_comment":null}