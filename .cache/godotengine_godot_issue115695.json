rchived_by":null}],"state":"open","locked":false,"assignees":[],"milestone":{"url":"https://api.github.com/repos/godotengine/godot/milestones/16","html_url":"https://github.com/godotengine/godot/milestone/16","labels_url":"https://api.github.com/repos/godotengine/godot/milestones/16/labels","id":8237783,"node_id":"MI_kwDOAO6SJc4AfbLX","number":16,"title":"4.x","description":"Issues and pull requests slated for an undetermined Godot 4 release.","creator":{"login":"akien-mga","id":4701338,"node_id":"MDQ6VXNlcjQ3MDEzMzg=","avatar_url":"https://avatars.githubusercontent.com/u/4701338?v=4","gravatar_id":"","url":"https://api.github.com/users/akien-mga","html_url":"https://github.com/akien-mga","followers_url":"https://api.github.com/users/akien-mga/followers","following_url":"https://api.github.com/users/akien-mga/following{/other_user}","gists_url":"https://api.github.com/users/akien-mga/gists{/gist_id}","starred_url":"https://api.github.com/users/akien-mga/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/akien-mga/subscriptions","organizations_url":"https://api.github.com/users/akien-mga/orgs","repos_url":"https://api.github.com/users/akien-mga/repos","events_url":"https://api.github.com/users/akien-mga/events{/privacy}","received_events_url":"https://api.github.com/users/akien-mga/received_events","type":"User","user_view_type":"public","site_admin":false},"open_issues":5791,"closed_issues":0,"state":"open","created_at":"2022-07-26T12:42:05Z","updated_at":"2026-10-21T22:40:26Z","due_on":null,"closed_at":null},"comments":0,"created_at":"2026-02-01T01:19:56Z","updated_at":"2026-02-17T20:09:47Z","closed_at":null,"assignee":null,"author_association":"NONE","issue_field_values":[],"type":null,"active_lock_reason":null,"draft":false,"pull_request":{"url":"https://api.github.com/repos/godotengine/godot/pulls/115695","html_url":"https://github.com/godotengine/godot/pull/115695","diff_url":"https://github.com/godotengine/godot/pull/115695.diff","patch_url":"https://github.com/godotengine/godot/pull/115695.patch","merged_at":null},"body":"fixes #115661.\r\n\r\n## Issue\r\nThe `CheckButton` node was ignoring its specific `disabled` stylebox defined in a Theme. It was instead falling back to the default `Button` style because the drawing logic for the background was missing in its notification override.\r\n\r\n## Cause\r\n`CheckButton` overrides `_notification(NOTIFICATION_DRAW)` to handle its own icon and toggle logic, but it did not include logic to draw the background StyleBox. Furthermore, the `disabled` theme item was not bound to the class's theme cache.\r\n\r\n## Solution\r\n- Added `disabled_style` to `CheckButton::ThemeCache`.\r\n- Bound the `disabled` stylebox in `_bind_methods`.\r\n- Updated `_notification(NOTIFICATION_DRAW)` to manually render the background stylebox before drawing icons.\r\n- Adjusted margin calculations to correctly use the active state's (normal or disabled) stylebox.\r\n\r\n## Testing\r\n1. Created a Theme with distinct styles for `Button` (disabled) and `CheckButton` (disabled).\r\n2. Assigned the theme to a scene containing both nodes.\r\n3. Observed that the `CheckButton` now correctly uses its own green/custom disabled style instead of the generic button style.","closed_by":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/115695/reactions","total_count":2,"+1":2,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/godotengine/godot/issues/115695/timeline","performed_via_github_app":null,"state_reason":null}