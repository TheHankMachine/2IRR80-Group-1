s/priahoud/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/priahoud/subscriptions","organizations_url":"https://api.github.com/users/priahoud/orgs","repos_url":"https://api.github.com/users/priahoud/repos","events_url":"https://api.github.com/users/priahoud/events{/privacy}","received_events_url":"https://api.github.com/users/priahoud/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"Hey, thanks for the review!\r\n\r\n> This option does not make much sense.\r\n\r\nExcept for discoverability, but I see your point.\r\n\r\n> You can't select it and point at an object at the same time.\r\n\r\nThat is true.\r\n\r\n> `_sinput()` already handles the shortcut.\r\n\r\nAfter commenting that line out, the keyboard shortcut for focus pointer only works once until the ui gets \"ticked\" again in any way (the little wheel on the top right of the editor moves a bit) . Left or right clicking  in an empty area of the scene or some other widget in the editor, hovering the mouse over another area than the active one, or by just switching to another open application and back to Godot.\r\n\r\nBecause of the similarity to #108983, I did a quick cherry pick onto the commit before 6253814 to see if it is related, but that doesn't seem to be the case.\r\n\r\nAny ideas?","created_at":"2025-07-30T22:39:53Z","updated_at":"2025-07-30T22:39:53Z","html_url":"https://github.com/godotengine/godot/pull/108812#discussion_r2243993430","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/108812","_links":{"self":{"href":"https://api.github.com/repos/godotengine/godot/pulls/comments/2243993430"},"html":{"href":"https://github.com/godotengine/godot/pull/108812#discussion_r2243993430"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/108812"}},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/2243993430/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":5801,"original_line":5801,"side":"RIGHT","in_reply_to_id":2243829914,"author_association":"CONTRIBUTOR","original_position":45,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/2277615675","pull_request_review_id":3121977475,"id":2277615675,"node_id":"PRRC_kwDOAO6SJc6Hwag7","diff_hunk":"@@ -5778,6 +5798,7 @@ Node3DEditorViewport::Node3DEditorViewport(Node3DEditor *p_spatial_editor, int p\n \n \tview_display_menu->get_popup()->add_separator();\n \tview_display_menu->get_popup()->add_shortcut(ED_GET_SHORTCUT(\"spatial_editor/focus_origin\"), VIEW_CENTER_TO_ORIGIN);\n+\tview_display_menu->get_popup()->add_shortcut(ED_GET_SHORTCUT(\"spatial_editor/focus_pointer\"), VIEW_CENTER_TO_POINTER);","path":"editor/scene/3d/node_3d_editor_plugin.cpp","commit_id":"a64d133182bc2dce9e62ab89011f2c9327e9bbff","original_commit_id":"a64d133182bc2dce9e62ab89011f2c9327e9bbff","user":{"login":"KoBeWi","id":2223172,"node_id":"MDQ6VXNlcjIyMjMxNzI=","avatar_url":"https://avatars.githubusercontent.com/u/2223172?v=4","gravatar_id":"","url":"https://api.github.com/users/KoBeWi","html_url":"https://github.com/KoBeWi","followers_url":"https://api.github.com/users/KoBeWi/followers","following_url":"https://api.github.com/users/KoBeWi/following{/other_user}","gists_url":"https://api.github.com/users/KoBeWi/gists{/gist_id}","starred_url":"https://api.github.com/users/KoBeWi/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/KoBeWi/subscriptions","organizations_url":"https://api.github.com/users/KoBeWi/orgs","repos_url":"https://api.github.com/users/KoBeWi/repos","events_url":"https://api.github.com/users/KoBeWi/events{/privacy}","received_events_url":"https://api.github.com/users/KoBeWi/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"> Except for discoverability, but I see your point.\r\n\r\nDiscoverability is important, but it should not be added as non-functional option. We could e.g. add a toggleable help panel that lists navigation shortcuts. It can be done in a separate PR.\r\n\r\n> After commenting that line out, the keyboard shortcut for focus pointer only works once until the ui gets \"ticked\" again in any way\r\n\r\n??\r\nWhat I meant is that you can replace `_menu_option(VIEW_CENTER_TO_POINTER);` with `focus_pointer();`. The menu option is not needed for the shortcut to function, though it seems like you only added it for discovearibility?\r\n\r\nNot sure about the bug you mentioned, I can't reproduce it.","created_at":"2025-08-14T20:07:16Z","updated_at":"2025-08-14T20:07:17Z","html_url":"https://github.com/godotengine/godot/pull/108812#discussion_r2277615675","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/108812","_links":{"self":{"href":"https://api.github.com/repos/godotengine/godot/pulls/comments/2277615675"},"html":{"href":"https://github.com/godotengine/godot/pull/108812#discussion_r2277615675"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/108812"}},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/2277615675/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":5801,"original_line":5801,"side":"RIGHT","in_reply_to_id":2243829914,"author_association":"MEMBER","original_position":45,"position":1,"subject_type":"line"}]