thub.com/users/KoBeWi","html_url":"https://github.com/KoBeWi","followers_url":"https://api.github.com/users/KoBeWi/followers","following_url":"https://api.github.com/users/KoBeWi/following{/other_user}","gists_url":"https://api.github.com/users/KoBeWi/gists{/gist_id}","starred_url":"https://api.github.com/users/KoBeWi/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/KoBeWi/subscriptions","organizations_url":"https://api.github.com/users/KoBeWi/orgs","repos_url":"https://api.github.com/users/KoBeWi/repos","events_url":"https://api.github.com/users/KoBeWi/events{/privacy}","received_events_url":"https://api.github.com/users/KoBeWi/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-04-16T20:50:24Z","updated_at":"2026-04-16T20:50:24Z","body":"The horizontal size in autowrapped labels no longer grows properly:\r\n\r\nhttps://github.com/user-attachments/assets/7a632a6a-b8a9-40cb-9814-fb20b80358cb\r\n\r\nBefore:\r\n\r\nhttps://github.com/user-attachments/assets/c7e624f3-2128-47f7-bae2-7cbb7497a7ad\r\n\r\nUnless this behavior can be achieved in another way?","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4263324993/reactions","total_count":2,"+1":2,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4263344674","html_url":"https://github.com/godotengine/godot/pull/118651#issuecomment-4263344674","issue_url":"https://api.github.com/repos/godotengine/godot/issues/118651","id":4263344674,"node_id":"IC_kwDOAO6SJc7-HXoi","user":{"login":"StarryWorm","id":41305715,"node_id":"MDQ6VXNlcjQxMzA1NzE1","avatar_url":"https://avatars.githubusercontent.com/u/41305715?v=4","gravatar_id":"","url":"https://api.github.com/users/StarryWorm","html_url":"https://github.com/StarryWorm","followers_url":"https://api.github.com/users/StarryWorm/followers","following_url":"https://api.github.com/users/StarryWorm/following{/other_user}","gists_url":"https://api.github.com/users/StarryWorm/gists{/gist_id}","starred_url":"https://api.github.com/users/StarryWorm/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/StarryWorm/subscriptions","organizations_url":"https://api.github.com/users/StarryWorm/orgs","repos_url":"https://api.github.com/users/StarryWorm/repos","events_url":"https://api.github.com/users/StarryWorm/events{/privacy}","received_events_url":"https://api.github.com/users/StarryWorm/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-04-16T20:53:44Z","updated_at":"2026-04-16T20:53:44Z","body":"Ok, that's a problem with the container implementation. Works fine outside of a Container. Will fix. ","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4263344674/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4263416563","html_url":"https://github.com/godotengine/godot/pull/118651#issuecomment-4263416563","issue_url":"https://api.github.com/repos/godotengine/godot/issues/118651","id":4263416563,"node_id":"IC_kwDOAO6SJc7-HpLz","user":{"login":"StarryWorm","id":41305715,"node_id":"MDQ6VXNlcjQxMzA1NzE1","avatar_url":"https://avatars.githubusercontent.com/u/41305715?v=4","gravatar_id":"","url":"https://api.github.com/users/StarryWorm","html_url":"https://github.com/StarryWorm","followers_url":"https://api.github.com/users/StarryWorm/followers","following_url":"https://api.github.com/users/StarryWorm/following{/other_user}","gists_url":"https://api.github.com/users/StarryWorm/gists{/gist_id}","starred_url":"https://api.github.com/users/StarryWorm/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/StarryWorm/subscriptions","organizations_url":"https://api.github.com/users/StarryWorm/orgs","repos_url":"https://api.github.com/users/StarryWorm/repos","events_url":"https://api.github.com/users/StarryWorm/events{/privacy}","received_events_url":"https://api.github.com/users/StarryWorm/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-04-16T21:06:23Z","updated_at":"2026-04-16T21:06:32Z","body":"Actually, there is a design decision to be had before I \"fix\" anything. \r\nShould the auto-expanding behavior be restrained to the `SIZE_EXPAND` flag for `Label` whilst in a `Container`? This question can also be expanded to `TabBar`. \r\n\r\nThe PR's current stance is yes. \r\n\r\nHowever, in your (KoBeWi's) reported case, for example, the `Label` would never be able to expand, because the `PanelContainer` doesn't support the `SIZE_EXPAND` flag.\r\n> Note: This is not the current behavior, which is just bugged\r\n\r\nIf the final decision is yes, we will either:\r\nA. Get this never-expand behavior, which I would call unexpected.\r\nB. Add the flag to all containers.\r\n\r\nI think going with yes and B is the best choice. Thoughts?","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4263416563/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4267390747","html_url":"https://github.com/godotengine/godot/pull/118651#issuecomment-4267390747","issue_url":"https://api.github.com/repos/godotengine/godot/issues/118651","id":4267390747,"node_id":"IC_kwDOAO6SJc7-Wzcb","user":{"login":"KoBeWi","id":2223172,"node_id":"MDQ6VXNlcjIyMjMxNzI=","avatar_url":"https://avatars.githubusercontent.com/u/2223172?v=4","gravatar_id":"","url":"https://api.github.com/users/KoBeWi","html_url":"https://github.com/KoBeWi","followers_url":"https://api.github.com/users/KoBeWi/followers","following_url":"https://api.github.com/users/KoBeWi/following{/other_user}","gists_url":"https://api.github.com/users/KoBeWi/gists{/gist_id}","starred_url":"https://api.github.com/users/KoBeWi/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/KoBeWi/subscriptions","organizations_url":"https://api.github.com/users/KoBeWi/orgs","repos_url":"https://api.github.com/users/KoBeWi/repos","events_url":"https://api.github.com/users/KoBeWi/events{/privacy}","received_events_url":"https://api.github.com/users/KoBeWi/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-04-17T10:51:56Z","updated_at":"2026-04-17T10:51:56Z","body":"EXPAND flag is supposed to make something take all available space. Growing the container increases the available space, so it changes the behavior, no?","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4267390747/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4267608814","html_url":"https://github.com/godotengine/godot/pull/118651#issuecomment-4267608814","issue_url":"https://api.github.com/repos/godotengine/godot/issues/118651","id":4267608814,"node_id":"IC_kwDOAO6SJc7-Xoru","user":{"login":"StarryWorm","id":41305715,"node_id":"MDQ6VXNlcjQxMzA1NzE1","avatar_url":"https://avatars.githubusercontent.com/u/41305715?v=4","gravatar_id":"","url":"https://api.github.com/users/StarryWorm","html_url":"https://github.com/StarryWorm","followers_url":"https://api.github.com/users/StarryWorm/followers","following_url":"https://api.github.com/users/StarryWorm/following{/other_user}","gists_url":"https://api.github.com/users/StarryWorm/gists{/gist_id}","starred_url":"https://api.github.com/users/StarryWorm/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/StarryWorm/subscriptions","organizations_url":"https://api.github.com/users/StarryWorm/orgs","repos_url":"https://api.github.com/users/StarryWorm/repos","events_url":"https://api.github.com/users/StarryWorm/events{/privacy}","received_events_url":"https://api.github.com/users/StarryWorm/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-04-17T11:28:24Z","updated_at":"2026-04-17T11:28:24Z","body":"The reason I landed on the expand flag is that I discovered this issue whilst working on the editor title bar, where it was a `TabBar` within a box container, where it had the space to expand into. But yeah in those simpler cases it would be increasing the size of the container.\n\nI'm not sure what a good alternative would be, any ideas?","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4267608814/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4319795628","html_url":"https://github.com/godotengine/godot/pull/118651#issuecomment-4319795628","issue_url":"https://api.github.com/repos/godotengine/godot/issues/118651","id":4319795628,"node_id":"IC_kwDOAO6SJc8AAAABAXrZrA","user":{"login":"StarryWorm","id":41305715,"node_id":"MDQ6VXNlcjQxMzA1NzE1","avatar_url":"https://avatars.githubusercontent.com/u/41305715?v=4","gravatar_id":"","url":"https://api.github.com/users/StarryWorm","html_url":"https://github.com/StarryWorm","followers_url":"https://api.github.com/users/StarryWorm/followers","following_url":"https://api.github.com/users/StarryWorm/following{/other_user}","gists_url":"https://api.github.com/users/StarryWorm/gists{/gist_id}","starred_url":"https://api.github.com/users/StarryWorm/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/StarryWorm/subscriptions","organizations_url":"https://api.github.com/users/StarryWorm/orgs","repos_url":"https://api.github.com/users/StarryWorm/repos","events_url":"https://api.github.com/users/StarryWorm/events{/privacy}","received_events_url":"https://api.github.com/users/StarryWorm/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-04-25T14:11:58Z","updated_at":"2026-04-25T23:22:06Z","body":"Changelog:\r\n* Rebased\r\n* Does not use `SIZE_EXPAND` flag anymore; it is instead enabled by default.\r\n  * This was previously not possible whilst preserving shrinking for `Container`s, hence why I was looking at options. Now it is possible to do this, so I did.\r\n* Added a new \"desired size\" path to `Control` and implemented it for all `Container` types. This allows a node to grow without modifying its minimum size. \r\n  * This is a frankly big change, but it is the only way to make `Container` nodes work with this behavior. Otherwise, we have to force the minimum size of the parent `Container` to reflect the child `Control`'s expanded size (`Label` or `TabBar` for now). Which means we wouldn't be able to shrink the `Container`... Which is exactly what we are trying to fix.\r\n  * Note: This means commits 1 and 2 should no longer be separate commits from commit 3. I have kept them separate for now, will squash once approved.","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4319795628/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4320809142","html_url":"https://github.com/godotengine/godot/pull/118651#issuecomment-4320809142","issue_url":"https://api.github.com/repos/godotengine/godot/issues/118651","id":4320809142,"node_id":"IC_kwDOAO6SJc8AAAABAYpQtg","user":{"login":"StarryWorm","id":41305715,"node_id":"MDQ6VXNlcjQxMzA1NzE1","avatar_url":"https://avatars.githubusercontent.com/u/41305715?v=4","gravatar_id":"","url":"https://api.github.com/users/StarryWorm","html_url":"https://github.com/StarryWorm","followers_url":"https://api.github.com/users/StarryWorm/followers","following_url":"https://api.github.com/users/StarryWorm/following{/other_user}","gists_url":"https://api.github.com/users/StarryWorm/gists{/gist_id}","starred_url":"https://api.github.com/users/StarryWorm/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/StarryWorm/subscriptions","organizations_url":"https://api.github.com/users/StarryWorm/orgs","repos_url":"https://api.github.com/users/StarryWorm/repos","events_url":"https://api.github.com/users/StarryWorm/events{/privacy}","received_events_url":"https://api.github.com/users/StarryWorm/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-04-25T23:33:46Z","updated_at":"2026-04-25T23:33:46Z","body":"Changelog:\r\n* Fixed issues introduced by the previous push.","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4320809142/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4338890285","html_url":"https://github.com/godotengine/godot/pull/118651#issuecomment-4338890285","issue_url":"https://api.github.com/repos/godotengine/godot/issues/118651","id":4338890285,"node_id":"IC_kwDOAO6SJc8AAAABAp42LQ","user":{"login":"unit-tick","id":267148939,"node_id":"U_kgDOD-xeiw","avatar_url":"https://avatars.githubusercontent.com/u/267148939?v=4","gravatar_id":"","url":"https://api.github.com/users/unit-tick","html_url":"https://github.com/unit-tick","followers_url":"https://api.github.com/users/unit-tick/followers","following_url":"https://api.github.com/users/unit-tick/following{/other_user}","gists_url":"https://api.github.com/users/unit-tick/gists{/gist_id}","starred_url":"https://api.github.com/users/unit-tick/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/unit-tick/subscriptions","organizations_url":"https://api.github.com/users/unit-tick/orgs","repos_url":"https://api.github.com/users/unit-tick/repos","events_url":"https://api.github.com/users/unit-tick/events{/privacy}","received_events_url":"https://api.github.com/users/unit-tick/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-04-28T20:40:11Z","updated_at":"2026-04-28T20:40:11Z","body":"Could this \"desired size\" be implemented in button as well, so it responds properly to its `text_overrun_behavior` when a maximum size is set and there is no minimum?","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4338890285/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4339832602","html_url":"https://github.com/godotengine/godot/pull/118651#issuecomment-4339832602","issue_url":"https://api.github.com/repos/godotengine/godot/issues/118651","id":4339832602,"node_id":"IC_kwDOAO6SJc8AAAABAqyXGg","user":{"login":"StarryWorm","id":41305715,"node_id":"MDQ6VXNlcjQxMzA1NzE1","avatar_url":"https://avatars.githubusercontent.com/u/41305715?v=4","gravatar_id":"","url":"https://api.github.com/users/StarryWorm","html_url":"https://github.com/StarryWorm","followers_url":"https://api.github.com/users/StarryWorm/followers","following_url":"https://api.github.com/users/StarryWorm/following{/other_user}","gists_url":"https://api.github.com/users/StarryWorm/gists{/gist_id}","starred_url":"https://api.github.com/users/StarryWorm/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/StarryWorm/subscriptions","organizations_url":"https://api.github.com/users/StarryWorm/orgs","repos_url":"https://api.github.com/users/StarryWorm/repos","events_url":"https://api.github.com/users/StarryWorm/events{/privacy}","received_events_url":"https://api.github.com/users/StarryWorm/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-04-28T23:31:54Z","updated_at":"2026-04-28T23:33:24Z","body":"Ah, yes, I remember your comment that @KoBeWi tagged me on in one of your Editor Tags feature PRs. I should have replied there to let you know of my plan, but I might as well do it here and now.\r\n\r\nMy plan is to make `Button` use an internal `Label` in the future. The current setup requires us to duplicate all the code in both places, so bug fixes and features added to one or the other aren't shared. \r\nOne of the feature requests, for example, was from @AdriaandeJongh to make `Button` able to use font scaling (as will be added by #116791) for usability purposes. That internal swapping will enable that, and any other future features we want to port over from the base `Label` class into `Button`'s (to-be) internal `Label`.\r\nThe desired size would then also be \"automatically\" available. \r\n\r\nEdit: I am also considering a `RichTextLabel`, but that would require some additional features in image layouts in that class.\r\n\r\nThis would be a 4.8 (or later) change.","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4339832602/reactions","total_count":2,"+1":2,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4344332323","html_url":"https://github.com/godotengine/godot/pull/118651#issuecomment-4344332323","issue_url":"https://api.github.com/repos/godotengine/godot/issues/118651","id":4344332323,"node_id":"IC_kwDOAO6SJc8AAAABAvFAIw","user":{"login":"KoBeWi","id":2223172,"node_id":"MDQ6VXNlcjIyMjMxNzI=","avatar_url":"https://avatars.githubusercontent.com/u/2223172?v=4","gravatar_id":"","url":"https://api.github.com/users/KoBeWi","html_url":"https://github.com/KoBeWi","followers_url":"https://api.github.com/users/KoBeWi/followers","following_url":"https://api.github.com/users/KoBeWi/following{/other_user}","gists_url":"https://api.github.com/users/KoBeWi/gists{/gist_id}","starred_url":"https://api.github.com/users/KoBeWi/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/KoBeWi/subscriptions","organizations_url":"https://api.github.com/users/KoBeWi/orgs","repos_url":"https://api.github.com/users/KoBeWi/repos","events_url":"https://api.github.com/users/KoBeWi/events{/privacy}","received_events_url":"https://api.github.com/users/KoBeWi/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-04-29T13:47:55Z","updated_at":"2026-04-29T13:47:55Z","body":"So instead of forcing minimum size, the text now just sticks out if the label is too small 🤔 (autowrap enabled)\r\n<img width=\"850\" height=\"94\" alt=\"image\" src=\"https://github.com/user-attachments/assets/6e98e273-6cad-490f-9a05-2a15e2b99a6c\" />\r\nI'm not sure which behavior is better.","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4344332323/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4344392904","html_url":"https://github.com/godotengine/godot/pull/118651#issuecomment-4344392904","issue_url":"https://api.github.com/repos/godotengine/godot/issues/118651","id":4344392904,"node_id":"I