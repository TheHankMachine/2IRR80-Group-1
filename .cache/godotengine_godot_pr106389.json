e/godot/statuses/45680f92302e9e8823f924504dc369666795f317"},"html":{"href":"https://github.com/godotengine/godot/pull/106389"},"issue":{"href":"https://api.github.com/repos/godotengine/godot/issues/106389"},"review_comments":{"href":"https://api.github.com/repos/godotengine/godot/pulls/106389/comments"},"review_comment":{"href":"https://api.github.com/repos/godotengine/godot/pulls/comments{/number}"},"self":{"href":"https://api.github.com/repos/godotengine/godot/pulls/106389"}},"author_association":"MEMBER","auto_merge":null,"draft":false,"merged":false,"mergeable":false,"rebaseable":false,"mergeable_state":"dirty","merged_by":null,"comments":0,"review_comments":0,"maintainer_can_modify":true,"commits":1,"additions":286,"deletions":305,"changed_files":18}