:"ffee88","default":false,"description":"","archived_at":null,"archived_by":null},{"id":307135532,"node_id":"MDU6TGFiZWwzMDcxMzU1MzI=","url":"https://api.github.com/repos/godotengine/godot/labels/topic:plugin","name":"topic:plugin","color":"ffee88","default":false,"description":"","archived_at":null,"archived_by":null},{"id":1332303119,"node_id":"MDU6TGFiZWwxMzMyMzAzMTE5","url":"https://api.github.com/repos/godotengine/godot/labels/regression","name":"regression","color":"ff63ac","default":false,"description":"","archived_at":null,"archived_by":null}],"state":"closed","locked":false,"assignees":[],"milestone":{"url":"https://api.github.com/repos/godotengine/godot/milestones/22","html_url":"https://github.com/godotengine/godot/milestone/22","labels_url":"https://api.github.com/repos/godotengine/godot/milestones/22/labels","id":12070367,"node_id":"MI_kwDOAO6SJc4AuC3f","number":22,"title":"4.5","description":"","creator":{"login":"Sauermann","id":6299227,"node_id":"MDQ6VXNlcjYyOTkyMjc=","avatar_url":"https://avatars.githubusercontent.com/u/6299227?v=4","gravatar_id":"","url":"https://api.github.com/users/Sauermann","html_url":"https://github.com/Sauermann","followers_url":"https://api.github.com/users/Sauermann/followers","following_url":"https://api.github.com/users/Sauermann/following{/other_user}","gists_url":"https://api.github.com/users/Sauermann/gists{/gist_id}","starred_url":"https://api.github.com/users/Sauermann/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Sauermann/subscriptions","organizations_url":"https://api.github.com/users/Sauermann/orgs","repos_url":"https://api.github.com/users/Sauermann/repos","events_url":"https://api.github.com/users/Sauermann/events{/privacy}","received_events_url":"https://api.github.com/users/Sauermann/received_events","type":"User","user_view_type":"public","site_admin":false},"open_issues":3,"closed_issues":3687,"state":"closed","created_at":"2024-12-19T08:51:28Z","updated_at":"2026-09-04T21:48:38Z","due_on":"2025-09-15T00:00:00Z","closed_at":"2025-09-18T17:13:14Z"},"comments":7,"created_at":"2025-02-07T09:45:38Z","updated_at":"2025-05-23T16:58:28Z","closed_at":"2025-04-08T17:46:52Z","assignee":null,"author_association":"MEMBER","issue_field_values":[],"type":null,"active_lock_reason":null,"draft":false,"pull_request":{"url":"https://api.github.com/repos/godotengine/godot/pulls/102521","html_url":"https://github.com/godotengine/godot/pull/102521","diff_url":"https://github.com/godotengine/godot/pull/102521.diff","patch_url":"https://github.com/godotengine/godot/pull/102521.patch","merged_at":"2025-04-08T17:46:51Z"},"body":"> [!NOTE]\r\n> Just because I'm in the GDScript team doesn't give credibility to this PR. It's my first time touching anything runtime related.\r\n\r\nRelated issues (not sure whether I should mark as closed, since the optimal solution would probably be to only cancel changed functions and replace the function pointer for others, _(in the case of a hot reload that is triggered from saving in editor. Not from calling reload manually without any parameters)_):\r\n#86362\r\n#92034\r\n#100750\r\n\r\n\r\nBefore this, when reloading a script functions that were suspended using `await` would continue running after the reload. After the reload the memory location of GDScript functions might have changed, in those cases the VM would start executing the memory were the function was located before the reload, which would lead to a lot of invalid op code errors and sometimes crashes.\r\n\r\nNow when reloading we cancel all pending functions. This makes the behavior in those cases consistent.\r\n","closed_by":{"login":"Repiteo","id":17489292,"node_id":"MDQ6VXNlcjE3NDg5Mjky","avatar_url":"https://avatars.githubusercontent.com/u/17489292?v=4","gravatar_id":"","url":"https://api.github.com/users/Repiteo","html_url":"https://github.com/Repiteo","followers_url":"https://api.github.com/users/Repiteo/followers","following_url":"https://api.github.com/users/Repiteo/following{/other_user}","gists_url":"https://api.github.com/users/Repiteo/gists{/gist_id}","starred_url":"https://api.github.com/users/Repiteo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Repiteo/subscriptions","organizations_url":"https://api.github.com/users/Repiteo/orgs","repos_url":"https://api.github.com/users/Repiteo/repos","events_url":"https://api.github.com/users/Repiteo/events{/privacy}","received_events_url":"https://api.github.com/users/Repiteo/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/102521/reactions","total_count":6,"+1":0,"-1":0,"laugh":0,"hooray":6,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/godotengine/godot/issues/102521/timeline","performed_via_github_app":null,"state_reason":null}