[{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2603927885","html_url":"https://github.com/godotengine/godot/pull/101598#issuecomment-2603927885","issue_url":"https://api.github.com/repos/godotengine/godot/issues/101598","id":2603927885,"node_id":"IC_kwDOAO6SJc6bNMlN","user":{"login":"MewPurPur","id":85438892,"node_id":"MDQ6VXNlcjg1NDM4ODky","avatar_url":"https://avatars.githubusercontent.com/u/85438892?v=4","gravatar_id":"","url":"https://api.github.com/users/MewPurPur","html_url":"https://github.com/MewPurPur","followers_url":"https://api.github.com/users/MewPurPur/followers","following_url":"https://api.github.com/users/MewPurPur/following{/other_user}","gists_url":"https://api.github.com/users/MewPurPur/gists{/gist_id}","starred_url":"https://api.github.com/users/MewPurPur/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/MewPurPur/subscriptions","organizations_url":"https://api.github.com/users/MewPurPur/orgs","repos_url":"https://api.github.com/users/MewPurPur/repos","events_url":"https://api.github.com/users/MewPurPur/events{/privacy}","received_events_url":"https://api.github.com/users/MewPurPur/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-01-21T08:15:12Z","updated_at":"2025-01-21T08:15:12Z","body":"Sure. This is because the vboxcontainer with the text is 37px tall, because text has this tendence of taking more space than what it seems like it should.\r\n\r\nI'll fix it.","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2603927885/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2611232480","html_url":"https://github.com/godotengine/godot/pull/101598#issuecomment-2611232480","issue_url":"https://api.github.com/repos/godotengine/godot/issues/101598","id":2611232480,"node_id":"IC_kwDOAO6SJc6bpD7g","user":{"login":"MewPurPur","id":85438892,"node_id":"MDQ6VXNlcjg1NDM4ODky","avatar_url":"https://avatars.githubusercontent.com/u/85438892?v=4","gravatar_id":"","url":"https://api.github.com/users/MewPurPur","html_url":"https://github.com/MewPurPur","followers_url":"https://api.github.com/users/MewPurPur/followers","following_url":"https://api.github.com/users/MewPurPur/following{/other_user}","gists_url":"https://api.github.com/users/MewPurPur/gists{/gist_id}","starred_url":"https://api.github.com/users/MewPurPur/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/MewPurPur/subscriptions","organizations_url":"https://api.github.com/users/MewPurPur/orgs","repos_url":"https://api.github.com/users/MewPurPur/repos","events_url":"https://api.github.com/users/MewPurPur/events{/privacy}","received_events_url":"https://api.github.com/users/MewPurPur/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-01-23T23:39:13Z","updated_at":"2025-01-23T23:39:13Z","body":"Doned, bumping up the \"anti-separation\" of the two labels by 1 more pixel looks good to me even with the maximum ascents/descents in the default font.","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2611232480/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2641964710","html_url":"https://github.com/godotengine/godot/pull/101598#issuecomment-2641964710","issue_url":"https://api.github.com/repos/godotengine/godot/issues/101598","id":2641964710,"node_id":"IC_kwDOAO6SJc6deS6m","user":{"login":"MewPurPur","id":85438892,"node_id":"MDQ6VXNlcjg1NDM4ODky","avatar_url":"https://avatars.githubusercontent.com/u/85438892?v=4","gravatar_id":"","url":"https://api.github.com/users/MewPurPur","html_url":"https://github.com/MewPurPur","followers_url":"https://api.github.com/users/MewPurPur/followers","following_url":"https://api.github.com/users/MewPurPur/following{/other_user}","gists_url":"https://api.github.com/users/MewPurPur/gists{/gist_id}","starred_url":"https://api.github.com/users/MewPurPur/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/MewPurPur/subscriptions","organizations_url":"https://api.github.com/users/MewPurPur/orgs","repos_url":"https://api.github.com/users/MewPurPur/repos","events_url":"https://api.github.com/users/MewPurPur/events{/privacy}","received_events_url":"https://api.github.com/users/MewPurPur/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-02-07T05:13:50Z","updated_at":"2025-02-07T05:13:50Z","body":"Since the dialog redesign is new to 4.4, I think it'd be great to merge the theming fixes timely.","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2641964710/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2642434985","html_url":"https://github.com/godotengine/godot/pull/101598#issuecomment-2642434985","issue_url":"https://api.github.com/repos/godotengine/godot/issues/101598","id":2642434985,"node_id":"IC_kwDOAO6SJc6dgFup","user":{"login":"MewPurPur","id":85438892,"node_id":"MDQ6VXNlcjg1NDM4ODky","avatar_url":"https://avatars.githubusercontent.com/u/85438892?v=4","gravatar_id":"","url":"https://api.github.com/users/MewPurPur","html_url":"https://github.com/MewPurPur","followers_url":"https://api.github.com/users/MewPurPur/followers","following_url":"https://api.github.com/users/MewPurPur/following{/other_user}","gists_url":"https://api.github.com/users/MewPurPur/gists{/gist_id}","starred_url":"https://api.github.com/users/MewPurPur/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/MewPurPur/subscriptions","organizations_url":"https://api.github.com/users/MewPurPur/orgs","repos_url":"https://api.github.com/users/MewPurPur/repos","events_url":"https://api.github.com/users/MewPurPur/events{/privacy}","received_events_url":"https://api.github.com/users/MewPurPur/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-02-07T09:42:38Z","updated_at":"2025-02-07T09:43:38Z","body":"Okay, I added SNAME where you suggested, but I honestly still don't get when it should be used and why it was suggested only for some strings. \"separation\" outside of the lines I changed also don't have it, \"selected\" next to my lines doesn't, and even \"margin_*\" constants in the lines I did change.","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2642434985/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2642546912","html_url":"https://github.com/godotengine/godot/pull/101598#issuecomment-2642546912","issue_url":"https://api.github.com/repos/godotengine/godot/issues/101598","id":2642546912,"node_id":"IC_kwDOAO6SJc6dghDg","user":{"login":"arkology","id":43543909,"node_id":"MDQ6VXNlcjQzNTQzOTA5","avatar_url":"https://avatars.githubusercontent.com/u/43543909?v=4","gravatar_id":"","url":"https://api.github.com/users/arkology","html_url":"https://github.com/arkology","followers_url":"https://api.github.com/users/arkology/followers","following_url":"https://api.github.com/users/arkology/following{/other_user}","gists_url":"https://api.github.com/users/arkology/gists{/gist_id}","starred_url":"https://api.github.com/users/arkology/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/arkology/subscriptions","organizations_url":"https://api.github.com/users/arkology/orgs","repos_url":"https://api.github.com/users/arkology/repos","events_url":"https://api.github.com/users/arkology/events{/privacy}","received_events_url":"https://api.github.com/users/arkology/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-02-07T10:35:56Z","updated_at":"2025-02-07T10:48:57Z","body":"@MewPurPur I searched where else in codebase SNAME is used for specific strings (where specific strings are cached already and where is is used multiple times). Unfortunately, there is no consistency in it right now to make it clear where it should or should not be used, but as I see, if it was used multiple times in other places, it's ok to use it in new code.","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2642546912/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2644857148","html_url":"https://github.com/godotengine/godot/pull/101598#issuecomment-2644857148","issue_url":"https://api.github.com/repos/godotengine/godot/issues/101598","id":2644857148,"node_id":"IC_kwDOAO6SJc6dpVE8","user":{"login":"Ivorforce","id":2308167,"node_id":"MDQ6VXNlcjIzMDgxNjc=","avatar_url":"https://avatars.githubusercontent.com/u/2308167?v=4","gravatar_id":"","url":"https://api.github.com/users/Ivorforce","html_url":"https://github.com/Ivorforce","followers_url":"https://api.github.com/users/Ivorforce/followers","following_url":"https://api.github.com/users/Ivorforce/following{/other_user}","gists_url":"https://api.github.com/users/Ivorforce/gists{/gist_id}","starred_url":"https://api.github.com/users/Ivorforce/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Ivorforce/subscriptions","organizations_url":"https://api.github.com/users/Ivorforce/orgs","repos_url":"https://api.github.com/users/Ivorforce/repos","events_url":"https://api.github.com/users/Ivorforce/events{/privacy}","received_events_url":"https://api.github.com/users/Ivorforce/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-02-08T10:35:34Z","updated_at":"2025-02-08T10:35:34Z","body":"Here's what `SNAME` does: It statically assigns a `StringName` that will be referenced at this place for future use.\nThis is much faster than using String literals, but also forces the `StringName` data to be kept in memory. It is appropriate in places where the `StringName` data is expected to be kept in memory anyway, and especially when it is used in performance critical functions, like those called every tick.\n\nI don't think there is an \"official\" recommendation for when to use it, but if i were to make one, I'd probably suggest using it for most static strings since most are expected to be kept in memory for one reason or another anyway. The cost of a reference to it is rather small.","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2644857148/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2644861232","html_url":"https://github.com/godotengine/godot/pull/101598#issuecomment-2644861232","issue_url":"https://api.github.com/repos/godotengine/godot/issues/101598","id":2644861232,"node_id":"IC_kwDOAO6SJc6dpWEw","user":{"login":"AThousandShips","id":96648715,"node_id":"U_kgDOBcK-Cw","avatar_url":"https://avatars.githubusercontent.com/u/96648715?v=4","gravatar_id":"","url":"https://api.github.com/users/AThousandShips","html_url":"https://github.com/AThousandShips","followers_url":"https://api.github.com/users/AThousandShips/followers","following_url":"https://api.github.com/users/AThousandShips/following{/other_user}","gists_url":"https://api.github.com/users/AThousandShips/gists{/gist_id}","starred_url":"https://api.github.com/users/AThousandShips/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/AThousandShips/subscriptions","organizations_url":"https://api.github.com/users/AThousandShips/orgs","repos_url":"https://api.github.com/users/AThousandShips/repos","events_url":"https://api.github.com/users/AThousandShips/events{/privacy}","received_events_url":"https://api.github.com/users/AThousandShips/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-02-08T10:38:10Z","updated_at":"2025-02-08T10:47:35Z","body":"The general recommendation is to use it in hot paths, and not to use it everywhere. In modern cases speed usually wins over memory when prioritising but there's no use in doing it in paths that are called exactly once in a run \r\n\r\nNote further that `SNAME` does *not* speed up the lookup itself, it just saves it for future use, so if you use it in a code path that's run exactly once it is no faster than just passing a string literal","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2644861232/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2644973575","html_url":"https://github.com/godotengine/godot/pull/101598#issuecomment-2644973575","issue_url":"https://api.github.com/repos/godotengine/godot/issues/101598","id":2644973575,"node_id":"IC_kwDOAO6SJc6dpxgH","user":{"login":"arkology","id":43543909,"node_id":"MDQ6VXNlcjQzNTQzOTA5","avatar_url":"https://avatars.githubusercontent.com/u/43543909?v=4","gravatar_id":"","url":"https://api.github.com/users/arkology","html_url":"https://github.com/arkology","followers_url":"https://api.github.com/users/arkology/followers","following_url":"https://api.github.com/users/arkology/following{/other_user}","gists_url":"https://api.github.com/users/arkology/gists{/gist_id}","starred_url":"https://api.github.com/users/arkology/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/arkology/subscriptions","organizations_url":"https://api.github.com/users/arkology/orgs","repos_url":"https://api.github.com/users/arkology/repos","events_url":"https://api.github.com/users/arkology/events{/privacy}","received_events_url":"https://api.github.com/users/arkology/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-02-08T11:08:18Z","updated_at":"2025-02-08T11:08:18Z","body":"@Ivorforce thanks for explanation. So actually \"if it was used multiple times in other places\" is not necessary, it is enough if it is already used in any \"common\" path (i.e. already cached).","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2644973575/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2645385134","html_url":"https://github.com/godotengine/godot/pull/101598#issuecomment-2645385134","issue_url":"https://api.github.com/repos/godotengine/godot/issues/101598","id":2645385134,"node_id":"IC_kwDOAO6SJc6drV-u","user":{"login":"KoBeWi","id":2223172,"node_id":"MDQ6VXNlcjIyMjMxNzI=","avatar_url":"https://avatars.githubusercontent.com/u/2223172?v=4","gravatar_id":"","url":"https://api.github.com/users/KoBeWi","html_url":"https://github.com/KoBeWi","followers_url":"https://api.github.com/users/KoBeWi/followers","following_url":"https://api.github.com/users/KoBeWi/following{/other_user}","gists_url":"https://api.github.com/users/KoBeWi/gists{/gist_id}","starred_url":"https://api.github.com/users/KoBeWi/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/KoBeWi/subscriptions","organizations_url":"https://api.github.com/users/KoBeWi/orgs","repos_url":"https://api.github.com/users/KoBeWi/repos","events_url":"https://api.github.com/users/KoBeWi/events{/privacy}","received_events_url":"https://api.github.com/users/KoBeWi/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-02-08T12:39:00Z","updated_at":"2025-02-08T12:39:00Z","body":"\"Exactly once\" is not that obvious.\r\nFor example\r\nThere is single EditorNode, so anything in it's constructor will run once.\r\nHowever things in NOTIFICATION_THEME_CHANGED will run every time theme is modified. For one control it does not make difference, but for many of them it can affect how responsive is the editor when you change e.g. accent color.\r\nThere are multiple instances of QuickOpenDialog, but there is so few of them that SNAME is probably not worth it.\r\nIt's different for QuickOpenResultGridItem - there is *lots* of them per each dialog and SNAME in first item will cache the StringName for subsequent items, so it will make the dialog load faster.","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2645385134/reactions","total_count":3,"+1":3,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2645600194","html_url":"https://github.com/godotengine/godot/pull/101598#issuecomment-2645600194","issue_url":"https://api.github.com/repos/godotengine/godot/issues/101598","id":2645600194,"node_id":"IC_kwDOAO6SJc6dsKfC","user":{"login":"AThousandShips","id":96648715,"node_id":"U_kgDOBcK-Cw","avatar_url":"https://avatars.githubusercontent.com/u/96648715?v=4","gravatar_id":"","url":"https://api.github.com/users/AThousandShips","html_url":"https://github.com/AThousandShips","followers_url":"https://api.github.com/users/AThousandShips/followers","following_url":"https://api.github.com/users/AThousandShips/following{/other_user}","gists_url":"https://api.github.com/users/AThousandShips/gists{/gist_id}","starred_url":"https://api.github.com/users/AThousandShips/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/AThousandShips/subscriptions","organizations_url":"https://api.github.com/users/AThousandShips/orgs","repos_url":"https://api.github.com/users/AThousandShips/repos","events_url":"https://api.github.com/users/AThousandShips/events{/privacy}","received_events_url":"https://api.github.com/users/AThousandShips/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-02-08T13:29:29Z","updated_at":"2025-02-08T13:35:33Z","body":"I think the important takeaway is that optimization (or any code pattern) should be applied with intentionality, with an understanding of why it's used, and that any pattern used \"just because\" is a code smell.\r\n\r\n`SNAME` is a pretty harmless one but it's always good to get used to different patterns and why we use them and when\r\n\r\nEdit: note to self to write some contributor documentation on some of this","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2645600194/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2647473002","html_url":"https://github.com/godotengine/godot/pull/101598#issuecomment-2647473002","issue_url":"https://api.github.com/repos/godotengine/godot/issues/101598","id":2647473002,"node_id":"IC_kwDOAO6SJc6dzTtq","user":{"login":"akien-mga","id":4701338,"node_id":"MDQ6VXNlcjQ3MDEzMzg=","avatar_url":"https://avatars.githubusercontent.com/u/4701338?v=4","gravatar_id":"","url":"https://api.github.com/users/akien-mga","html_url":"https://github.com/akien-mga","followers_url":"https://api.github.com/users/akien-mga/followers","following_url":"https://api.github.com/users/akien-mga/following{/other_user}","gists_url":"https://api.github.com/users/akien-mga/gists{/gist_id}","starred_url":"https://api.github.com/users/akien-mga/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/akien-mga/subscriptions","organizations_url":"https://api.github.com/users/akien-mga/orgs","repos_url":"https://api.github.com/users/akien-mga/repos","events_url":"https://api.github.com/users/akien-mga/events{/privacy}","received_events_url":"https://api.github.com/users/akien-mga/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-02-10T09:51:47Z","updated_at":"2025-02-10T09:51:47Z","body":"Thanks!","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2647473002/reactions","total_count":4,"+1":0,"-1":0,"laugh":0,"hooray":4,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null}]