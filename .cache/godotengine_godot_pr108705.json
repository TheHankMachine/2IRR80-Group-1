isplayServer::set_system_theme_change_callback(const Callable &p_callable) method. So there should be no need to poll every second for the system theme.\r\n\r\n---\r\n\r\nThis change is only lightly tested on a single platform (GNOME 43). I spotted the polling while working on #108704. The cost of polling is not huge, but in the XDG implementation (and possibly others) it's a blocking IPC call – probably better avoided.","labels":[{"id":73330066,"node_id":"MDU6TGFiZWw3MzMzMDA2Ng==","url":"https://api.github.com/repos/godotengine/godot/labels/enhancement","name":"enhancement","description":"","color":"aaccff","default":true,"archived_at":null,"archived_by":null},{"id":279098219,"node_id":"MDU6TGFiZWwyNzkwOTgyMTk=","url":"https://api.github.com/repos/godotengine/godot/labels/topic:editor","name":"topic:editor","description":"","color":"ffee88","default":false,"archived_at":null,"archived_by":null},{"id":3240950060,"node_id":"MDU6TGFiZWwzMjQwOTUwMDYw","url":"https://api.github.com/repos/godotengine/godot/labels/performance","name":"performance","description":"","color":"447777","default":false,"archived_at":null,"archived_by":null}],"milestone":{"id":12939969,"node_id":"MI_kwDOAO6SJc4AxXLB","url":"https://api.github.com/repos/godotengine/godot/milestones/23","html_url":"https://github.com/godotengine/godot/milestone/23","labels_url":"https://api.github.com/repos/godotengine/godot/milestones/23/labels","number":23,"state":"closed","title":"4.6","description":"","creator":{"login":"Repiteo","id":17489292,"node_id":"MDQ6VXNlcjE3NDg5Mjky","avatar_url":"https://avatars.githubusercontent.com/u/17489292?v=4","gravatar_id":"","url":"https://api.github.com/users/Repiteo","html_url":"https://github.com/Repiteo","followers_url":"https://api.github.com/users/Repiteo/followers","following_url":"https://api.github.com/users/Repiteo/following{/other_user}","gists_url":"https://api.github.com/users/Repiteo/gists{/gist_id}","starred_url":"https://api.github.com/users/Repiteo/starred{/o