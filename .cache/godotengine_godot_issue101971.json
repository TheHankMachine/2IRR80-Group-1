d_by":null},{"id":1609442062,"node_id":"MDU6TGFiZWwxNjA5NDQyMDYy","url":"https://api.github.com/repos/godotengine/godot/labels/topic:shaders","name":"topic:shaders","color":"ffee88","default":false,"description":"","archived_at":null,"archived_by":null},{"id":2666708289,"node_id":"MDU6TGFiZWwyNjY2NzA4Mjg5","url":"https://api.github.com/repos/godotengine/godot/labels/topic:3d","name":"topic:3d","color":"ffee88","default":false,"description":"","archived_at":null,"archived_by":null}],"state":"closed","locked":false,"assignees":[],"milestone":{"url":"https://api.github.com/repos/godotengine/godot/milestones/22","html_url":"https://github.com/godotengine/godot/milestone/22","labels_url":"https://api.github.com/repos/godotengine/godot/milestones/22/labels","id":12070367,"node_id":"MI_kwDOAO6SJc4AuC3f","number":22,"title":"4.5","description":"","creator":{"login":"Sauermann","id":6299227,"node_id":"MDQ6VXNlcjYyOTkyMjc=","avatar_url":"https://avatars.githubusercontent.com/u/6299227?v=4","gravatar_id":"","url":"https://api.github.com/users/Sauermann","html_url":"https://github.com/Sauermann","followers_url":"https://api.github.com/users/Sauermann/followers","following_url":"https://api.github.com/users/Sauermann/following{/other_user}","gists_url":"https://api.github.com/users/Sauermann/gists{/gist_id}","starred_url":"https://api.github.com/users/Sauermann/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Sauermann/subscriptions","organizations_url":"https://api.github.com/users/Sauermann/orgs","repos_url":"https://api.github.com/users/Sauermann/repos","events_url":"https://api.github.com/users/Sauermann/events{/privacy}","received_events_url":"https://api.github.com/users/Sauermann/received_events","type":"User","user_view_type":"public","site_admin":false},"open_issues":3,"closed_issues":3687,"state":"closed","created_at":"2024-12-19T08:51:28Z","updated_at":"2026-09-04T21:48:38Z","due_on":"2025-09-15T00:00:00Z","closed_at":"2025-09-18T17:13:14Z"},"comments":1,"created_at":"2025-01-24T01:41:19Z","updated_at":"2025-03-11T14:42:59Z","closed_at":"2025-03-11T14:42:27Z","assignee":null,"author_association":"MEMBER","issue_field_values":[],"type":null,"active_lock_reason":null,"draft":false,"pull_request":{"url":"https://api.github.com/repos/godotengine/godot/pulls/101971","html_url":"https://github.com/godotengine/godot/pull/101971","diff_url":"https://github.com/godotengine/godot/pull/101971.diff","patch_url":"https://github.com/godotengine/godot/pull/101971.patch","merged_at":"2025-03-11T14:42:27Z"},"body":"This fixes an unreported bug in sky shaders that I noticed while doing some optimization work. \r\n\r\nWe are using the tangent of the angular diameter instead of the angular diameter in sky shaders. This code was copied and pasted from the scene shader which uses it for calculating size for shadows:\r\n\r\nhttps://github.com/godotengine/godot/blob/b0655dc86f096b3496a9ab5b18965676d4fb35ba/servers/rendering/renderer_rd/storage_rd/light_storage.cpp#L675\r\n\r\nIt's worth noting that for the actual light size we use the cosine offset:\r\n\r\nhttps://github.com/godotengine/godot/blob/b0655dc86f096b3496a9ab5b18965676d4fb35ba/servers/rendering/renderer_rd/storage_rd/light_storage.cpp#L664\r\n\r\nThis flew under the radar for so long since tan is nearly linear at small values. See the below clip from Desmos (tangent is green, linear x is blue):\r\n\r\n<img width=\"485\" alt=\"Screenshot 2025-01-23 at 5 35 21 PM\" src=\"https://github.com/user-attachments/assets/53325bfa-8e61-431a-8ad0-125717a6c403\" />\r\n\r\nThe values don't really diverge much until you reach around 0.3 (about 17 degrees), and don't become problematic under you reach around 30 degrees which is a very extreme size for the sun, so it makes sense that no one has noticed this issue.\r\n","closed_by":{"login":"Repiteo","id":17489292,"node_id":"MDQ6VXNlcjE3NDg5Mjky","avatar_url":"https://avatars.githubusercontent.com/u/17489292?v=4","gravatar_id":"","url":"https://api.github.com/users/Repiteo","html_url":"https://github.com/Repiteo","followers_url":"https://api.github.com/users/Repiteo/followers","following_url":"https://api.github.com/users/Repiteo/following{/other_user}","gists_url":"https://api.github.com/users/Repiteo/gists{/gist_id}","starred_url":"https://api.github.com/users/Repiteo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Repiteo/subscriptions","organizations_url":"https://api.github.com/users/Repiteo/orgs","repos_url":"https://api.github.com/users/Repiteo/repos","events_url":"https://api.github.com/users/Repiteo/events{/privacy}","received_events_url":"https://api.github.com/users/Repiteo/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/101971/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/godotengine/godot/issues/101971/timeline","performed_via_github_app":null,"state_reason":null}