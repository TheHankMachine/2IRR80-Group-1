s_url":"https://api.github.com/users/Sauermann/events{/privacy}","received_events_url":"https://api.github.com/users/Sauermann/received_events","type":"User","user_view_type":"public","site_admin":false},"open_issues":3,"closed_issues":3687,"state":"closed","created_at":"2024-12-19T08:51:28Z","updated_at":"2026-09-04T21:48:38Z","due_on":"2025-09-15T00:00:00Z","closed_at":"2025-09-18T17:13:14Z"},"comments":3,"created_at":"2025-07-07T20:08:34Z","updated_at":"2025-07-15T13:11:34Z","closed_at":"2025-07-15T13:10:22Z","assignee":null,"author_association":"CONTRIBUTOR","issue_field_values":[],"type":null,"active_lock_reason":null,"draft":false,"pull_request":{"url":"https://api.github.com/repos/godotengine/godot/pulls/108387","html_url":"https://github.com/godotengine/godot/pull/108387","diff_url":"https://github.com/godotengine/godot/pull/108387.diff","patch_url":"https://github.com/godotengine/godot/pull/108387.patch","merged_at":"2025-07-15T13:10:22Z"},"body":"## Description:\r\n\r\nThis PR addresses an issue with the parsing of the Location header when handling HTTP status codes 301 or 302.\r\n\r\n### Problem:\r\nPreviously, headers with a name matching the pattern *-location (e.g., X-location, My-location) were incorrectly interpreted as redirect targets. This caused unintended behavior when following redirects.\r\n\r\n### Fix:\r\nUpdated the logic to only recognize the standard Location header (case-insensitive) for determining redirect URLs in 301/302 responses.\r\n\r\nReference:\r\nhttps://http.dev/redirects\r\n\r\n* *Bugsquad edit, fixes: https://github.com/godotengine/godot/issues/102960*","closed_by":{"login":"Repiteo","id":17489292,"node_id":"MDQ6VXNlcjE3NDg5Mjky","avatar_url":"https://avatars.githubusercontent.com/u/17489292?v=4","gravatar_id":"","url":"https://api.github.com/users/Repiteo","html_url":"https://github.com/Repiteo","followers_url":"https://api.github.com/users/Repiteo/followers","following_url":"https://api.github.com/users/Repiteo/following{/ot