[{"id":2502379497,"node_id":"PRR_kwDOAO6SJc6VJ0fp","state":"COMMENTED","user":{"site_admin":false,"suspended":false,"updated_at":"0001-01-01T00:00:00Z","avatar_url":"https://avatars.githubusercontent.com/u/4701338?u=4a42fd867f2c449fcc23adf635dd574dae98e6c2&v=4","created_at":"0001-01-01T00:00:00Z","followers":0,"following":0,"html_url":"https://github.com/akien-mga","id":4701338,"node_id":"MDQ6VXNlcjQ3MDEzMzg=","login":"akien-mga","type":"User","owned_private_repos":0,"public_gists":0,"public_repos":0,"total_private_repos":0,"url":"https://api.github.com/users/akien-mga"},"body":"","html_url":"https://github.com/godotengine/godot/pull/100365#pullrequestreview-2502379497","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/100365","author_association":"MEMBER","submitted_at":"2024-12-13T14:06:40Z"},{"id":2532834806,"node_id":"PRR_kwDOAO6SJc6W9_32","state":"COMMENTED","user":{"site_admin":false,"suspended":false,"updated_at":"0001-01-01T00:00:00Z","avatar_url":"https://avatars.githubusercontent.com/u/180032?u=68d23e7ee9cdf810da125e8510b72f845b9dccc8&v=4","created_at":"0001-01-01T00:00:00Z","followers":0,"following":0,"html_url":"https://github.com/Calinou","id":180032,"node_id":"MDQ6VXNlcjE4MDAzMg==","login":"Calinou","type":"User","owned_private_repos":0,"public_gists":0,"public_repos":0,"total_private_repos":0,"url":"https://api.github.com/users/Calinou"},"body":"Tested locally using the textures from `tex.zip`, it works as expected.\r\n\r\n**Testing project:** [test_etc2_load.zip](https://github.com/user-attachments/files/18323748/test_etc2_load.zip)\r\n\r\nWhat's interesting is that the texture type appears to be ETC2, with the memory usage displayed as if the texture was uncompressed RGB**A**8 (even if the source ETC2 texture is RGB8 without alpha). This is on a NVIDIA GPU where [ETC2 textures aren't natively supported](https://vulkan.gpuinfo.org/listdevicescoverage.php?lineartilingformat=ETC2_R8G8B8_SRGB_BLOCK&featureflagbit=SAMPLED_IMAGE):\r\n\r\n![image](https://github.com/user-attachments/assets/4c1f77f1-eb0e-4a21-84cc-065e39ff8734)\r\n\r\nDoes this mean the texture is uncompressed to RGBA8 instead of RGB8 even if it has no alpha channel?\r\n\r\nUncompressed RGB8 | Uncompressed RGBA8\r\n-|-\r\n![image](https://github.com/user-attachments/assets/7c636ec1-ba85-4467-80f4-781920eea088) | ![image](https://github.com/user-attachments/assets/82342773-8b9f-42b2-8345-c1953f6efede)\r\n","html_url":"https://github.com/godotengine/godot/pull/100365#pullrequestreview-2532834806","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/100365","author_association":"MEMBER","submitted_at":"2025-01-06T19:35:50Z"},{"id":2533022398,"node_id":"PRR_kwDOAO6SJc6W-tq-","state":"COMMENTED","user":{"site_admin":false,"suspended":false,"updated_at":"0001-01-01T00:00:00Z","avatar_url":"https://avatars.githubusercontent.com/u/180032?u=68d23e7ee9cdf810da125e8510b72f845b9dccc8&v=4","created_at":"0001-01-01T00:00:00Z","followers":0,"following":0,"html_url":"https://github.com/Calinou","id":180032,"node_id":"MDQ6VXNlcjE4MDAzMg==","login":"Calinou","type":"User","owned_private_repos":0,"public_gists":0,"public_repos":0,"total_private_repos":0,"url":"https://api.github.com/users/Calinou"},"body":"","html_url":"https://github.com/godotengine/godot/pull/100365#pullrequestreview-2533022398","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/100365","author_association":"MEMBER","submitted_at":"2025-01-06T21:42:03Z"},{"id":2533022609,"node_id":"PRR_kwDOAO6SJc6W-tuR","state":"COMMENTED","user":{"site_admin":false,"suspended":false,"updated_at":"0001-01-01T00:00:00Z","avatar_url":"https://avatars.githubusercontent.com/u/180032?u=68d23e7ee9cdf810da125e8510b72f845b9dccc8&v=4","created_at":"0001-01-01T00:00:00Z","followers":0,"following":0,"html_url":"https://github.com/Calinou","id":180032,"node_id":"MDQ6VXNlcjE4MDAzMg==","login":"Calinou","type":"User","owned_private_repos":0,"public_gists":0,"public_re