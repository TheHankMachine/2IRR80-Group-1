01T00:00:00Z","followers":0,"following":0,"html_url":"https://github.com/clayjohn","id":16521339,"node_id":"MDQ6VXNlcjE2NTIxMzM5","login":"clayjohn","type":"User","owned_private_repos":0,"public_gists":0,"public_repos":0,"total_private_repos":0,"url":"https://api.github.com/users/clayjohn"},"body":"","html_url":"https://github.com/godotengine/godot/pull/119401#pullrequestreview-4351736970","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/119401","author_association":"MEMBER","submitted_at":"2026-05-24T03:11:55Z"},{"id":4351739102,"node_id":"PRR_kwDOAO6SJc8AAAABA2JE3g","state":"COMMENTED","commit_id":"61c16d62c61a036db417b3f00b5e1664a7376657","user":{"site_admin":false,"suspended":false,"updated_at":"0001-01-01T00:00:00Z","avatar_url":"https://avatars.githubusercontent.com/u/16521339?u=e44a465cbebabb9ea2be80b59e6dc07966bef5b7&v=4","created_at":"0001-01-01T00:00:00Z","followers":0,"following":0,"html_url":"https://github.com/clayjohn","id":16521339,"node_id":"MDQ6VXNlcjE2NTIxMzM5","login":"clayjohn","type":"User","owned_private_repos":0,"public_gists":0,"public_repos":0,"total_private_repos":0,"url":"https://api.github.com/users/clayjohn"},"body":"","html_url":"https://github.com/godotengine/godot/pull/119401#pullrequestreview-4351739102","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/119401","author_association":"MEMBER","submitted_at":"2026-05-24T03:15:18Z"},{"id":4351747144,"node_id":"PRR_kwDOAO6SJc8AAAABA2JkSA","state":"APPROVED","commit_id":"61c16d62c61a036db417b3f00b5e1664a7376657","user":{"site_admin":false,"suspended":false,"updated_at":"0001-01-01T00:00:00Z","avatar_url":"https://avatars.githubusercontent.com/u/16521339?u=e44a465cbebabb9ea2be80b59e6dc07966bef5b7&v=4","created_at":"0001-01-01T00:00:00Z","followers":0,"following":0,"html_url":"https://github.com/clayjohn","id":16521339,"node_id":"MDQ6VXNlcjE2NTIxMzM5","login":"clayjohn","type":"User","owned_private_repos":0,"public_gists":0,"public_repos":0,"total_private_repos":0,"url":"https://api.github.com/users/clayjohn"},"body":"Okay, I went through the code and checked the other uses of `vertex_formats` and `framebuffer_formats` and I can confirm that this code is safe. \n\nThe case we are guarding against is inserting a new element into the HashMap while we read from the Hashmap on another thread. While it is totally safe for us to use the pointer we get from the lookup from any thread, we need to avoid indexing into the HashMap while we are doing an insertion. \n\nAs you pointed out in the other thread, a more granular lock would be better since this will lock on a bunch of other unrelated methods. But this code is the safest, least intrusive fix for now","html_url":"https://github.com/godotengine/godot/pull/119401#pullrequestreview-4351747144","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/119401","author_association":"MEMBER","submitted_at":"2026-05-24T03:27:51Z"}]