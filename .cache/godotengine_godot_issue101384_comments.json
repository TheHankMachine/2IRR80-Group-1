yMTU2","avatar_url":"https://avatars.githubusercontent.com/u/63552156?v=4","gravatar_id":"","url":"https://api.github.com/users/ghostsoft","html_url":"https://github.com/ghostsoft","followers_url":"https://api.github.com/users/ghostsoft/followers","following_url":"https://api.github.com/users/ghostsoft/following{/other_user}","gists_url":"https://api.github.com/users/ghostsoft/gists{/gist_id}","starred_url":"https://api.github.com/users/ghostsoft/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/ghostsoft/subscriptions","organizations_url":"https://api.github.com/users/ghostsoft/orgs","repos_url":"https://api.github.com/users/ghostsoft/repos","events_url":"https://api.github.com/users/ghostsoft/events{/privacy}","received_events_url":"https://api.github.com/users/ghostsoft/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-01-10T12:49:47Z","updated_at":"2025-01-10T12:49:47Z","body":"> Can you please check, if the same bug also applies to left-Ctrl and right-Ctrl?\n\nI hope you'll excuse me for not posting another MRP but this was interesting - **This does work properly with Ctrl**\n\nSo the bug, whatever it may be seems to be with the shift keys _specifically_.","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2582639138/reactions","total_count":3,"+1":3,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2582688373","html_url":"https://github.com/godotengine/godot/issues/101384#issuecomment-2582688373","issue_url":"https://api.github.com/repos/godotengine/godot/issues/101384","id":2582688373,"node_id":"IC_kwDOAO6SJc6Z8LJ1","user":{"login":"Sauermann","id":6299227,"node_id":"MDQ6VXNlcjYyOTkyMjc=","avatar_url":"https://avatars.githubusercontent.com/u/6299227?v=4","gravatar_id":"","url":"https://api.github.com/users/Sauermann","html_url":"https://github.com/Sauermann","followers_url":"https://api.github.com/users/Sauermann/followers","following_url":"https://api.github.com/users/Sauermann/following{/other_user}","gists_url":"https://api.github.com/users/Sauermann/gists{/gist_id}","starred_url":"https://api.github.com/users/Sauermann/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Sauermann/subscriptions","organizations_url":"https://api.github.com/users/Sauermann/orgs","repos_url":"https://api.github.com/users/Sauermann/repos","events_url":"https://api.github.com/users/Sauermann/events{/privacy}","received_events_url":"https://api.github.com/users/Sauermann/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-01-10T13:13:39Z","updated_at":"2025-01-10T13:13:39Z","body":"Thank you, that helps to narrow down the problem.","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2582688373/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2598723646","html_url":"https://github.com/godotengine/godot/issues/101384#issuecomment-2598723646","issue_url":"https://api.github.com/repos/godotengine/godot/issues/101384","id":2598723646,"node_id":"IC_kwDOAO6SJc6a5WA-","user":{"login":"tmilker","id":98860,"node_id":"MDQ6VXNlcjk4ODYw","avatar_url":"https://avatars.githubusercontent.com/u/98860?v=4","gravatar_id":"","url":"https://api.github.com/users/tmilker","html_url":"https://github.com/tmilker","followers_url":"https://api.github.com/users/tmilker/followers","following_url":"https://api.github.com/users/tmilker/following{/other_user}","gists_url":"https://api.github.com/users/tmilker/gists{/gist_id}","starred_url":"https://api.github.com/users/tmilker/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/tmilker/subscriptions","organizations_url":"https://api.github.com/users/tmilker/orgs","repos_url":"https://api.github.com/users/tmilker/repos","events_url":"https://api.github.com/users/tmilker/events{/privacy}","received_events_url":"https://api.github.com/users/tmilker/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-01-17T16:24:25Z","updated_at":"2025-01-17T16:34:17Z","body":"@romlok I've reviewed the original PR for your commit that added this support and see that it was left at partial support.  Is the rest of the support going to be added so this can be fixed for Windows? 4.4 is coming quick and like you said about 4.3, it would be nice to have this at 100% without waiting for another major version.","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2598723646/reactions","total_count":2,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":1},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2599359232","html_url":"https://github.com/godotengine/godot/issues/101384#issuecomment-2599359232","issue_url":"https://api.github.com/repos/godotengine/godot/issues/101384","id":2599359232,"node_id":"IC_kwDOAO6SJc6a7xMA","user":{"login":"romlok","id":441188,"node_id":"MDQ6VXNlcjQ0MTE4OA==","avatar_url":"https://avatars.githubusercontent.com/u/441188?v=4","gravatar_id":"","url":"https://api.github.com/users/romlok","html_url":"https://github.com/romlok","followers_url":"https://api.github.com/users/romlok/followers","following_url":"https://api.github.com/users/romlok/following{/other_user}","gists_url":"https://api.github.com/users/romlok/gists{/gist_id}","starred_url":"https://api.github.com/users/romlok/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/romlok/subscriptions","organizations_url":"https://api.github.com/users/romlok/orgs","repos_url":"https://api.github.com/users/romlok/repos","events_url":"https://api.github.com/users/romlok/events{/privacy}","received_events_url":"https://api.github.com/users/romlok/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-01-17T23:16:02Z","updated_at":"2025-01-17T23:16:02Z","body":"Thanks for the ping! If this is what I found while doing that PR, then this should be Windows-specific and, as discovered here, shift-specific. Windows does a thing where it doesn't send a key-up event until all shifts are released 🙃 \n\nThat said, I thought I addressed that in the PR. So it could be that I missed something, or that this is triggered somewhere else.  Either way, I don't actually have a Windows box to test/verify on, so it would be difficult to investigate further myself 😕 \n\n_That_ said, I just tested the MRP on my Linux box, and I obviously don't see your issue, but I do see that `event.is_action_pressed` returns `false` if another key of the same type is already pressed (and there hasn't been a release of it since).  Maybe related, maybe not. 😕 \n\n@ghostsoft Can you check if eg. `Input.is_action_pressed(\"right_shift\")` works as expected for you? I was experimenting with your MRP, and that function seemed to consistently return the expected value, at least on my machine.","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2599359232/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2599674948","html_url":"https://github.com/godotengine/godot/issues/101384#issuecomment-2599674948","issue_url":"https://api.github.com/repos/godotengine/godot/issues/101384","id":2599674948,"node_id":"IC_kwDOAO6SJc6a8-RE","user":{"login":"ghostsoft","id":63552156,"node_id":"MDQ6VXNlcjYzNTUyMTU2","avatar_url":"https://avatars.githubusercontent.com/u/63552156?v=4","gravatar_id":"","url":"https://api.github.com/users/ghostsoft","html_url":"https://github.com/ghostsoft","followers_url":"https://api.github.com/users/ghostsoft/followers","following_url":"https://api.github.com/users/ghostsoft/following{/other_user}","gists_url":"https://api.github.com/users/ghostsoft/gists{/gist_id}","starred_url":"https://api.github.com/users/ghostsoft/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/ghostsoft/subscriptions","organizations_url":"https://api.github.com/users/ghostsoft/orgs","repos_url":"https://api.github.com/users/ghostsoft/repos","events_url":"https://api.github.com/users/ghostsoft/events{/privacy}","received_events_url":"https://api.github.com/users/ghostsoft/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-01-18T11:12:33Z","updated_at":"2025-01-18T11:13:13Z","body":"> [@ghostsoft](https://github.com/ghostsoft) Can you check if eg. `Input.is_action_pressed(\"right_shift\")` works as expected for you? I was experimenting with your MRP, and that function seemed to consistently return the expected value, at least on my machine.\n\nI alluded to this in the initial post but I should've probably included it in the MRP too - when the key is stuck (but not physically pressed) the `Input.is_action_pressed()` function still returns true.\n\nAs an example, if both left and right shift are pressed, then right shift is released and then left shift is released, `Input.is_action_pressed(\"left_shift\")` now returns false but `Input.is_action_pressed(\"right_shift\")` still returns true despite no keys being down. I've spoken with some friends who are better than me about understanding the source code and they agree that it's a Windows-specific bug and that it's \"in the detection code and not the action matching code\" but I barely understood what they were talking about.","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2599674948/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2599693537","html_url":"https://github.com/godotengine/godot/issues/101384#issuecomment-2599693537","issue_url":"https://api.github.com/repos/godotengine/godot/issues/101384","id":2599693537,"node_id":"IC_kwDOAO6SJc6a9Czh","user":{"login":"andyprice","id":133737,"node_id":"MDQ6VXNlcjEzMzczNw==","avatar_url":"https://avatars.githubusercontent.com/u/133737?v=4","gravatar_id":"","url":"https://api.github.com/users/andyprice","html_url":"https://github.com/andyprice","followers_url":"https://api.github.com/users/andyprice/followers","following_url":"https://api.github.com/users/andyprice/following{/other_user}","gists_url":"https://api.github.com/users/andyprice/gists{/gist_id}","starred_url":"https://api.github.com/users/andyprice/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/andyprice/subscriptions","organizations_url":"https://api.github.com/users/andyprice/orgs","repos_url":"https://api.github.com/users/andyprice/repos","events_url":"https://api.github.com/users/andyprice/events{/privacy}","received_events_url":"https://api.github.com/users/andyprice/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-01-18T12:15:30Z","updated_at":"2025-01-18T12:15:30Z","body":"> they agree that it's a Windows-specific bug and that it's \"in the detection code and not the action matching code\"\n\nTo add a little detail, it seems there's a separate action matching issue that also occurs on Linux so I asked @ghostsoft to test this modification to the MRP to make sure their problem is not related to action matching:\n\n```gdscript\nfunc _input(event: InputEvent) -> void:\n    if event is not InputEventKey || event.keycode != KEY_SHIFT:\n        return\n    if event.is_pressed():\n        if event.location == KEY_LOCATION_LEFT:\n            left.modulate = Color.RED\n        if event.location == KEY_LOCATION_RIGHT:\n            right.modulate = Color.RED\n    else:\n        if event.location == KEY_LOCATION_LEFT:\n            left.modulate = Color.WHITE\n        if event.location == KEY_LOCATION_RIGHT:\n            right.modulate = Color.WHITE\n```\n\nResult: this works fine on Linux but apparently reproduces @ghostsoft's issue on Windows.","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2599693537/reactions","total_count":5,"+1":4,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":1,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2599764554","html_url":"https://github.com/godotengine/godot/issues/101384#issuecomment-2599764554","issue_url":"https://api.github.com/repos/godotengine/godot/issues/101384","id":2599764554,"node_id":"IC_kwDOAO6SJc6a9UJK","user":{"login":"SupSuper","id":603444,"node_id":"MDQ6VXNlcjYwMzQ0NA==","avatar_url":"https://avatars.githubusercontent.com/u/603444?v=4","gravatar_id":"","url":"https://api.github.com/users/SupSuper","html_url":"https://github.com/SupSuper","followers_url":"https://api.github.com/users/SupSuper/followers","following_url":"https://api.github.com/users/SupSuper/following{/other_user}","gists_url":"https://api.github.com/users/SupSuper/gists{/gist_id}","starred_url":"https://api.github.com/users/SupSuper/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/SupSuper/subscriptions","organizations_url":"https://api.github.com/users/SupSuper/orgs","repos_url":"https://api.github.com/users/SupSuper/repos","events_url":"https://api.github.com/users/SupSuper/events{/privacy}","received_events_url":"https://api.github.com/users/SupSuper/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-01-18T15:45:45Z","updated_at":"2025-01-18T15:45:45Z","body":"I've submitted a fix for this issue on Windows: #101763","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2599764554/reactions","total_count":2,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":2,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null}]