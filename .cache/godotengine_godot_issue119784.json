rchived_by":null},{"id":2666708289,"node_id":"MDU6TGFiZWwyNjY2NzA4Mjg5","url":"https://api.github.com/repos/godotengine/godot/labels/topic:3d","name":"topic:3d","color":"ffee88","default":false,"description":"","archived_at":null,"archived_by":null}],"state":"closed","locked":false,"assignees":[],"milestone":{"url":"https://api.github.com/repos/godotengine/godot/milestones/25","html_url":"https://github.com/godotengine/godot/milestone/25","labels_url":"https://api.github.com/repos/godotengine/godot/milestones/25/labels","id":15520464,"node_id":"MI_kwDOAO6SJc4A7NLQ","number":25,"title":"4.8","description":"","creator":{"login":"Repiteo","id":17489292,"node_id":"MDQ6VXNlcjE3NDg5Mjky","avatar_url":"https://avatars.githubusercontent.com/u/17489292?v=4","gravatar_id":"","url":"https://api.github.com/users/Repiteo","html_url":"https://github.com/Repiteo","followers_url":"https://api.github.com/users/Repiteo/followers","following_url":"https://api.github.com/users/Repiteo/following{/other_user}","gists_url":"https://api.github.com/users/Repiteo/gists{/gist_id}","starred_url":"https://api.github.com/users/Repiteo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Repiteo/subscriptions","organizations_url":"https://api.github.com/users/Repiteo/orgs","repos_url":"https://api.github.com/users/Repiteo/repos","events_url":"https://api.github.com/users/Repiteo/events{/privacy}","received_events_url":"https://api.github.com/users/Repiteo/received_events","type":"User","user_view_type":"public","site_admin":false},"open_issues":343,"closed_issues":2335,"state":"open","created_at":"2026-04-13T15:59:35Z","updated_at":"2026-10-22T06:28:22Z","due_on":null,"closed_at":null},"comments":3,"created_at":"2026-05-26T13:58:01Z","updated_at":"2026-07-25T18:39:20Z","closed_at":"2026-06-18T15:25:18Z","assignee":null,"author_association":"NONE","issue_field_values":[],"type":null,"active_lock_reason":null,"draft":false,"pull_request":{"url":"https://api.github.com/repos/godotengine/godot/pulls/119784","html_url":"https://github.com/godotengine/godot/pull/119784","diff_url":"https://github.com/godotengine/godot/pull/119784.diff","patch_url":"https://github.com/godotengine/godot/pull/119784.patch","merged_at":"2026-06-18T15:25:18Z"},"body":"\r\n## What problem(s) does this PR solve?\r\n\r\n- Closes #106150\r\n\r\n## Additional information\r\n\r\n- The flickering happens because sometimes the matrix for non-uniform scale is applied to the normals while othertimes it's the matrix for uniform scale. This is caused by a flickering `non_uniform_scale` flag which in turn is caused by floating point imprecisions.\r\n- The flickering occures when `min_scale / max_scale` is around the epsilon, which was 0.9 before the fix.\r\n- I tightend the epsilon to 0.999 which should still leave room for floating point inaccuracies. The flag will now alternate when `min_scale / max_scale` is around 0.999. However, at this point the matrices for uniform and non-uniform scale are similiar enough that no visual flicker should be apparent.\r\n- Note: This change will cause more geometry instances to be considered as non-uniformly scaled. This could have a minor impact on performance in scenes with many slightly non-uniformly scaled instances.\r\n\r\n\r\n_Bugsquad edit: Fixes https://github.com/godotengine/godot/issues/101377_","closed_by":{"login":"Repiteo","id":17489292,"node_id":"MDQ6VXNlcjE3NDg5Mjky","avatar_url":"https://avatars.githubusercontent.com/u/17489292?v=4","gravatar_id":"","url":"https://api.github.com/users/Repiteo","html_url":"https://github.com/Repiteo","followers_url":"https://api.github.com/users/Repiteo/followers","following_url":"https://api.github.com/users/Repiteo/following{/other_user}","gists_url":"https://api.github.com/users/Repiteo/gists{/gist_id}","starred_url":"https://api.github.com/users/Repiteo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Repiteo/subscriptions","organizations_url":"https://api.github.com/users/Repiteo/orgs","repos_url":"https://api.github.com/users/Repiteo/repos","events_url":"https://api.github.com/users/Repiteo/events{/privacy}","received_events_url":"https://api.github.com/users/Repiteo/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/119784/reactions","total_count":3,"+1":2,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":1},"timeline_url":"https://api.github.com/repos/godotengine/godot/issues/119784/timeline","performed_via_github_app":null,"state_reason":null}