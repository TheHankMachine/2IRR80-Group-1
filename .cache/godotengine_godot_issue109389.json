IwNzc5","url":"https://api.github.com/repos/godotengine/godot/labels/topic:gui","name":"topic:gui","color":"ffee88","default":false,"description":"","archived_at":null,"archived_by":null}],"state":"closed","locked":false,"assignees":[],"milestone":{"url":"https://api.github.com/repos/godotengine/godot/milestones/22","html_url":"https://github.com/godotengine/godot/milestone/22","labels_url":"https://api.github.com/repos/godotengine/godot/milestones/22/labels","id":12070367,"node_id":"MI_kwDOAO6SJc4AuC3f","number":22,"title":"4.5","description":"","creator":{"login":"Sauermann","id":6299227,"node_id":"MDQ6VXNlcjYyOTkyMjc=","avatar_url":"https://avatars.githubusercontent.com/u/6299227?v=4","gravatar_id":"","url":"https://api.github.com/users/Sauermann","html_url":"https://github.com/Sauermann","followers_url":"https://api.github.com/users/Sauermann/followers","following_url":"https://api.github.com/users/Sauermann/following{/other_user}","gists_url":"https://api.github.com/users/Sauermann/gists{/gist_id}","starred_url":"https://api.github.com/users/Sauermann/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Sauermann/subscriptions","organizations_url":"https://api.github.com/users/Sauermann/orgs","repos_url":"https://api.github.com/users/Sauermann/repos","events_url":"https://api.github.com/users/Sauermann/events{/privacy}","received_events_url":"https://api.github.com/users/Sauermann/received_events","type":"User","user_view_type":"public","site_admin":false},"open_issues":3,"closed_issues":3687,"state":"closed","created_at":"2024-12-19T08:51:28Z","updated_at":"2026-09-04T21:48:38Z","due_on":"2025-09-15T00:00:00Z","closed_at":"2025-09-18T17:13:14Z"},"comments":9,"created_at":"2025-08-07T10:38:15Z","updated_at":"2025-08-13T23:44:36Z","closed_at":"2025-08-13T23:44:35Z","assignee":null,"author_association":"CONTRIBUTOR","issue_field_values":[],"type":null,"active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"### Tested versions\n\n- Reproducible in: 4.5.beta [65eb6643522abbe8ebce6428fe082167a7df14f9], 4.5.dev [3bc2821e261cc1e53ac2fcfd3ad930ae35b59b17]\n- Not reproducible in: 4.4.1.stable, 4.5.dev [1d8fa8b58a081b677dea42d16eb8d1361171ed71]\n\n### System information\n\nGodot v4.5.beta (65eb66435) - Fedora Linux 42 (Adams) on Wayland - X11 display driver, Multi-window, 2 monitors - Vulkan (Forward+) - dedicated AMD Radeon RX 9070 XT (RADV GFX1201) - AMD Ryzen 9 9950X3D 16-Core Processor (32 threads) - 60.39 GiB memory\n\n### Issue description\n\nWe've run into a couple of cases now where content creators will end up pushing hundreds of kilobytes (and sometimes megabytes) of font data as part of their scene files without realizing it. Upon further investigation it would seem that the thing they have in common is they all embed/sub-resource the Open Sans SemiBold font (i.e. `thirdparty/fonts/OpenSans_SemiBold.woff2`) that Godot uses as its default font, and that it's always attached to the `theme_override_fonts/font` property of something like a `Label`.\n\nWe're not totally clear on how these font properties were left at their default values, but there's a fairly straight-forward repro for this, which is to simply check the \"Font\" checkbox under \"Theme Overrides\" for any `Control` and then save the scene without actually picking a different font. This leads to the default font being embedded as a sub-resource in the scene.\n\nThis would seem to be a regression caused by #102372, which made it so that you could actually see the effective defaults for the theme overrides, and also made it so you could just check the override checkboxes without actually setting a value first. This is unlike Godot 4.4 where you had to pick a font in order to enable the font override.\n\n### Steps to reproduce\n\n1. Open any scene in any project.\n2. Create one or more `Label`.\n3. Check their \"Font\" checkbox under the \"Theme Overrides\" properties.\n4. Save the scene.\n5. Open the scene in a text editor.\n6. Note how you have one `sub_resource type=\"FontFile\"` for every `Label`.\n\n### Minimal reproduction project (MRP)\n\nN/A","closed_by":{"login":"Repiteo","id":17489292,"node_id":"MDQ6VXNlcjE3NDg5Mjky","avatar_url":"https://avatars.githubusercontent.com/u/17489292?v=4","gravatar_id":"","url":"https://api.github.com/users/Repiteo","html_url":"https://github.com/Repiteo","followers_url":"https://api.github.com/users/Repiteo/followers","following_url":"https://api.github.com/users/Repiteo/following{/other_user}","gists_url":"https://api.github.com/users/Repiteo/gists{/gist_id}","starred_url":"https://api.github.com/users/Repiteo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Repiteo/subscriptions","organizations_url":"https://api.github.com/users/Repiteo/orgs","repos_url":"https://api.github.com/users/Repiteo/repos","events_url":"https://api.github.com/users/Repiteo/events{/privacy}","received_events_url":"https://api.github.com/users/Repiteo/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/109389/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/godotengine/godot/issues/109389/timeline","performed_via_github_app":null,"state_reason":"completed","pinned_comment":null}