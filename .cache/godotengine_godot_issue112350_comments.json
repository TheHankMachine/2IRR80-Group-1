e9-ef222aff1f37\" /> | <img width=\"591\" height=\"698\" alt=\"image\" src=\"https://github.com/user-attachments/assets/6ed5a111-e7ce-4a01-bbe1-b531717efbfb\" />\r\n\r\nPR feels good regardless.","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3482708857/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3482872437","html_url":"https://github.com/godotengine/godot/pull/112350#issuecomment-3482872437","issue_url":"https://api.github.com/repos/godotengine/godot/issues/112350","id":3482872437,"node_id":"IC_kwDOAO6SJc7PmGp1","user":{"login":"passivestar","id":60579014,"node_id":"MDQ6VXNlcjYwNTc5MDE0","avatar_url":"https://avatars.githubusercontent.com/u/60579014?v=4","gravatar_id":"","url":"https://api.github.com/users/passivestar","html_url":"https://github.com/passivestar","followers_url":"https://api.github.com/users/passivestar/followers","following_url":"https://api.github.com/users/passivestar/following{/other_user}","gists_url":"https://api.github.com/users/passivestar/gists{/gist_id}","starred_url":"https://api.github.com/users/passivestar/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/passivestar/subscriptions","organizations_url":"https://api.github.com/users/passivestar/orgs","repos_url":"https://api.github.com/users/passivestar/repos","events_url":"https://api.github.com/users/passivestar/events{/privacy}","received_events_url":"https://api.github.com/users/passivestar/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-11-03T22:31:49Z","updated_at":"2025-11-03T22:31:49Z","body":"@DeeJayLSP it's hard to say without using it for some time. Staring at this theme for 2 years gave me a lot of time to do a bunch of micro-adjustments to different controls, and stretching all values further into grays without looking at it for more than a couple of times is a bit risky because if some elements aren't getting multiplied by contrast properly it'll take time to notice.\r\n\r\nIt's also been tested and approved by people as a mostly dark theme, given that godot has both flexible customization controls for base color and contrast, as well as \"light\" and \"gray\" color presets (defaults for which could also be tweaked), I think it makes more sense to keep this theme more on the \"dark\" side.\r\n\r\nSo I'm not saying that your opinion is wrong, but rather that I just have more confidence in these values.","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3482872437/reactions","total_count":2,"+1":2,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3483058093","html_url":"https://github.com/godotengine/godot/pull/112350#issuecomment-3483058093","issue_url":"https://api.github.com/repos/godotengine/godot/issues/112350","id":3483058093,"node_id":"IC_kwDOAO6SJc7Pmz-t","user":{"login":"Repiteo","id":17489292,"node_id":"MDQ6VXNlcjE3NDg5Mjky","avatar_url":"https://avatars.githubusercontent.com/u/17489292?v=4","gravatar_id":"","url":"https://api.github.com/users/Repiteo","html_url":"https://github.com/Repiteo","followers_url":"https://api.github.com/users/Repiteo/followers","following_url":"https://api.github.com/users/Repiteo/following{/other_user}","gists_url":"https://api.github.com/users/Repiteo/gists{/gist_id}","starred_url":"https://api.github.com/users/Repiteo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Repiteo/subscriptions","organizations_url":"https://api.github.com/users/Repiteo/orgs","repos_url":"https://api.github.com/users/Repiteo/repos","events_url":"https://api.github.com/us