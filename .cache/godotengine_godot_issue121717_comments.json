[{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5069493210","html_url":"https://github.com/godotengine/godot/issues/121717#issuecomment-5069493210","issue_url":"https://api.github.com/repos/godotengine/godot/issues/121717","id":5069493210,"node_id":"IC_kwDOAO6SJc8AAAABLipT2g","user":{"login":"syntaxerror247","id":176927541,"node_id":"U_kgDOCouzNQ","avatar_url":"https://avatars.githubusercontent.com/u/176927541?v=4","gravatar_id":"","url":"https://api.github.com/users/syntaxerror247","html_url":"https://github.com/syntaxerror247","followers_url":"https://api.github.com/users/syntaxerror247/followers","following_url":"https://api.github.com/users/syntaxerror247/following{/other_user}","gists_url":"https://api.github.com/users/syntaxerror247/gists{/gist_id}","starred_url":"https://api.github.com/users/syntaxerror247/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/syntaxerror247/subscriptions","organizations_url":"https://api.github.com/users/syntaxerror247/orgs","repos_url":"https://api.github.com/users/syntaxerror247/repos","events_url":"https://api.github.com/users/syntaxerror247/events{/privacy}","received_events_url":"https://api.github.com/users/syntaxerror247/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-07-24T11:45:26Z","updated_at":"2026-07-24T11:46:47Z","body":"Since this ANR report started in Godot 4.7.1, I suspect https://github.com/godotengine/godot/pull/121055\n\ncc @Faless @akien-mga ","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5069493210/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5077224824","html_url":"https://github.com/godotengine/godot/issues/121717#issuecomment-5077224824","issue_url":"https://api.github.com/repos/godotengine/godot/issues/121717","id":5077224824,"node_id":"IC_kwDOAO6SJc8AAAABLqBNeA","user":{"login":"Faless","id":1687918,"node_id":"MDQ6VXNlcjE2ODc5MTg=","avatar_url":"https://avatars.githubusercontent.com/u/1687918?v=4","gravatar_id":"","url":"https://api.github.com/users/Faless","html_url":"https://github.com/Faless","followers_url":"https://api.github.com/users/Faless/followers","following_url":"https://api.github.com/users/Faless/following{/other_user}","gists_url":"https://api.github.com/users/Faless/gists{/gist_id}","starred_url":"https://api.github.com/users/Faless/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Faless/subscriptions","organizations_url":"https://api.github.com/users/Faless/orgs","repos_url":"https://api.github.com/users/Faless/repos","events_url":"https://api.github.com/users/Faless/events{/privacy}","received_events_url":"https://api.github.com/users/Faless/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-07-25T06:00:09Z","updated_at":"2026-07-25T07:02:09Z","body":"~`thirdparty/mbedtls/library/entropy_poll.c:193` is just an `fclose` on `/dev/urandom`.~\n\n~It's unclear why it would ANR when doing that.~\n\nAh, nevermind, I had the outdated file, it's an `fread` on the file, which is still weird, but makes a bit more sense.\n\nNotably, reading on `/dev/urandom` will block until the OS has generated enough entropy to return cryptographic-safe random bytes.\n\nSo it almost seems like we've run out entropy and the call blocks forever. Which does not make much sense, as the phone has ton of entropy sources, so it should at most stall a few us.\n\nEDIT: `/dev/urandom` should in fact never block. Seems like mbedTLS switched to `/dev/random` which might block","author_association":"COLLABORATOR","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5077224824/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5077348725","html_url":"https://github.com/godotengine/godot/issues/121717#issuecomment-5077348725","issue_url":"https://api.github.com/repos/godotengine/godot/issues/121717","id":5077348725,"node_id":"IC_kwDOAO6SJc8AAAABLqIxdQ","user":{"login":"Faless","id":1687918,"node_id":"MDQ6VXNlcjE2ODc5MTg=","avatar_url":"https://avatars.githubusercontent.com/u/1687918?v=4","gravatar_id":"","url":"https://api.github.com/users/Faless","html_url":"https://github.com/Faless","followers_url":"https://api.github.com/users/Faless/followers","following_url":"https://api.github.com/users/Faless/following{/other_user}","gists_url":"https://api.github.com/users/Faless/gists{/gist_id}","starred_url":"https://api.github.com/users/Faless/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Faless/subscriptions","organizations_url":"https://api.github.com/users/Faless/orgs","repos_url":"https://api.github.com/users/Faless/repos","events_url":"https://api.github.com/users/Faless/events{/privacy}","received_events_url":"https://api.github.com/users/Faless/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-07-25T06:40:03Z","updated_at":"2026-07-25T06:40:24Z","body":"Do we have any info on which android version the devices are running?","author_association":"COLLABORATOR","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5077348725/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5077428402","html_url":"https://github.com/godotengine/godot/issues/121717#issuecomment-5077428402","issue_url":"https://api.github.com/repos/godotengine/godot/issues/121717","id":5077428402,"node_id":"IC_kwDOAO6SJc8AAAABLqNosg","user":{"login":"Faless","id":1687918,"node_id":"MDQ6VXNlcjE2ODc5MTg=","avatar_url":"https://avatars.githubusercontent.com/u/1687918?v=4","gravatar_id":"","url":"https://api.github.com/users/Faless","html_url":"https://github.com/Faless","followers_url":"https://api.github.com/users/Faless/followers","following_url":"https://api.github.com/users/Faless/following{/other_user}","gists_url":"https://api.github.com/users/Faless/gists{/gist_id}","starred_url":"https://api.github.com/users/Faless/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Faless/subscriptions","organizations_url":"https://api.github.com/users/Faless/orgs","repos_url":"https://api.github.com/users/Faless/repos","events_url":"https://api.github.com/users/Faless/events{/privacy}","received_events_url":"https://api.github.com/users/Faless/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-07-25T07:06:36Z","updated_at":"2026-07-25T07:08:06Z","body":"Sooo... it seems that mbedTLS switched from `/dev/urandom` to `/dev/random` by default ( https://github.com/Mbed-TLS/mbedtls/commit/6f63121a00dbf16a55668249b6f986b2db113226 ).\n\nSo I suspect the devices are running Linux <= 5.6, which can cause `/dev/random` to stall.\n\nThis is a bit of a pickle, we can force using `/dev/urandom` via a define, though it's a bit scary to revert what is, in practice, a security fix.\n\nAndroid 9 (API 28) introduced `get_entropy` (which is the sane way to get random values on Linux), and in those platforms `/dev/random` is probably a device that just calls that function. So I expect the devices in question runs Android 7 or 8 (which are the minimum required versions for Godot).\n\nI'll need to investigate this a bit more, but we can probably force using `/dev/urandom` when detecting Android 7/8 at runtime.","author_association":"COLLABORATOR","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5077428402/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5077736091","html_url":"https://github.com/godotengine/godot/issues/121717#issuecomment-5077736091","issue_url":"https://api.github.com/repos/godotengine/godot/issues/121717","id":5077736091,"node_id":"IC_kwDOAO6SJc8AAAABLqgamw","user":{"login":"syntaxerror247","id":176927541,"node_id":"U_kgDOCouzNQ","avatar_url":"https://avatars.githubusercontent.com/u/176927541?v=4","gravatar_id":"","url":"https://api.github.com/users/syntaxerror247","html_url":"https://github.com/syntaxerror247","followers_url":"https://api.github.com/users/syntaxerror247/followers","following_url":"https://api.github.com/users/syntaxerror247/following{/other_user}","gists_url":"https://api.github.com/users/syntaxerror247/gists{/gist_id}","starred_url":"https://api.github.com/users/syntaxerror247/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/syntaxerror247/subscriptions","organizations_url":"https://api.github.com/users/syntaxerror247/orgs","repos_url":"https://api.github.com/users/syntaxerror247/repos","events_url":"https://api.github.com/users/syntaxerror247/events{/privacy}","received_events_url":"https://api.github.com/users/syntaxerror247/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-07-25T08:33:27Z","updated_at":"2026-07-25T08:33:27Z","body":"> Do we have any info on which android version the devices are running?\n\nYes and it's happening on multiple versions. We have reports for Android 8.0, 8.1, 9, 10, 11, 12, 13, 14.","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5077736091/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null}]