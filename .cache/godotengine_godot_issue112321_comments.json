[{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3478203916","html_url":"https://github.com/godotengine/godot/issues/112321#issuecomment-3478203916","issue_url":"https://api.github.com/repos/godotengine/godot/issues/112321","id":3478203916,"node_id":"IC_kwDOAO6SJc7PUS4M","user":{"login":"Mickeon","id":66727710,"node_id":"MDQ6VXNlcjY2NzI3NzEw","avatar_url":"https://avatars.githubusercontent.com/u/66727710?v=4","gravatar_id":"","url":"https://api.github.com/users/Mickeon","html_url":"https://github.com/Mickeon","followers_url":"https://api.github.com/users/Mickeon/followers","following_url":"https://api.github.com/users/Mickeon/following{/other_user}","gists_url":"https://api.github.com/users/Mickeon/gists{/gist_id}","starred_url":"https://api.github.com/users/Mickeon/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Mickeon/subscriptions","organizations_url":"https://api.github.com/users/Mickeon/orgs","repos_url":"https://api.github.com/users/Mickeon/repos","events_url":"https://api.github.com/users/Mickeon/events{/privacy}","received_events_url":"https://api.github.com/users/Mickeon/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-11-02T19:17:48Z","updated_at":"2025-11-02T19:17:48Z","body":"Note for reference:\n- In Notepad++, only the starting bracket is removed. The leading text and close bracket remain intact.\n- In Visual Studio Code, at least for C++, both brackets are removed, but the leading text remains intact.\n\t- This is only if the brackets were \"recently\" written, so there's a special case for this. Otherwise, it acts like in Notepad++.\n\nIf anything GDScript is perhaps too generous with `Ctrl + Backspace`. A special case _could_ be made like Visual Studio Code, but I wouldn't call the existing behaviour outright wrong. ","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3478203916/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null}]