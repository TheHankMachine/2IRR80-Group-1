fset - https://registry.khronos.org/OpenGL-Refpages/gl4/html/textureLodOffset.xhtml\r\n- [x] textureProjOffset - https://registry.khronos.org/OpenGL-Refpages/gl4/html/textureProjOffset.xhtml\r\n- [x] textureProjGradOffset - https://registry.khronos.org/OpenGL-Refpages/gl4/html/textureProjGradOffset.xhtml\r\n- [x] textureProjLodOffset - https://registry.khronos.org/OpenGL-Refpages/gl4/html/textureProjLodOffset.xhtml\r\n- [x] textureGradOffset - https://registry.khronos.org/OpenGL-Refpages/gl4/html/textureGradOffset.xhtml\r\n- [x] textureGatherOffset - https://registry.khronos.org/OpenGL-Refpages/gl4/html/textureGatherOffset.xhtml\r\n- [x] texelFetchOffset - https://registry.khronos.org/OpenGL-Refpages/gl4/html/texelFetchOffset.xhtml","closed_by":{"login":"Chaosus","id":3036176,"node_id":"MDQ6VXNlcjMwMzYxNzY=","avatar_url":"https://avatars.githubusercontent.com/u/3036176?v=4","gravatar_id":"","url":"https://api.github.com/users/Chaosus","html_url":"https://github.com/Chaosus","followers_url":"https://api.github.com/users/Chaosus/followers","following_url":"https://api.github.com/users/Chaosus/following{/other_user}","gists_url":"https://api.github.com/users/Chaosus/gists{/gist_id}","starred_url":"https://api.github.com/users/Chaosus/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Chaosus/subscriptions","organizations_url":"https://api.github.com/users/Chaosus/orgs","repos_url":"https://api.github.com/users/Chaosus/repos","events_url":"https://api.github.com/users/Chaosus/events{/privacy}","received_events_url":"https://api.github.com/users/Chaosus/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/117417/reactions","total_count":6,"+1":0,"-1":0,"laugh":0,"hooray":3,"confused":0,"heart":0,"rocket":0,"eyes":3},"timeline_url":"https://api.github.com/repos/godotengine/godot/issues/117417/timeline","performed_via_github_app":null,"state_reason":null