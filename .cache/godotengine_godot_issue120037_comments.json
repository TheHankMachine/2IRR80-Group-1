[{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4634295183","html_url":"https://github.com/godotengine/godot/issues/120037#issuecomment-4634295183","issue_url":"https://api.github.com/repos/godotengine/godot/issues/120037","id":4634295183,"node_id":"IC_kwDOAO6SJc8AAAABFDm7jw","user":{"login":"clayjohn","id":16521339,"node_id":"MDQ6VXNlcjE2NTIxMzM5","avatar_url":"https://avatars.githubusercontent.com/u/16521339?v=4","gravatar_id":"","url":"https://api.github.com/users/clayjohn","html_url":"https://github.com/clayjohn","followers_url":"https://api.github.com/users/clayjohn/followers","following_url":"https://api.github.com/users/clayjohn/following{/other_user}","gists_url":"https://api.github.com/users/clayjohn/gists{/gist_id}","starred_url":"https://api.github.com/users/clayjohn/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/clayjohn/subscriptions","organizations_url":"https://api.github.com/users/clayjohn/orgs","repos_url":"https://api.github.com/users/clayjohn/repos","events_url":"https://api.github.com/users/clayjohn/events{/privacy}","received_events_url":"https://api.github.com/users/clayjohn/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-06-05T18:18:49Z","updated_at":"2026-06-05T18:18:49Z","body":"You forgot to set the camera_attributes property on the VoxelGI node. If you add one, it works correctly\n\n<img width=\"2252\" height=\"1194\" alt=\"Image\" src=\"https://github.com/user-attachments/assets/e6cc6655-d6e0-4bb4-84d0-452db1ccc58f\" />\n\nThis should be documented better here: https://docs.godotengine.org/en/stable/tutorials/3d/physical_light_and_camera_units.html\n\nBoth VoxelGI and LightmapGI need a reference to your Camera/World CameraAttributes resource to adjust the exposure correctly when using Physical Light Units. \n\nIt is explained a bit in https://docs.godotengine.org/en/stable/classes/class_cameraattributesphysical.html#class-cameraattributesphysical, but a reference in the physical light doc page would be better","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4634295183/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4634561659","html_url":"https://github.com/godotengine/godot/issues/120037#issuecomment-4634561659","issue_url":"https://api.github.com/repos/godotengine/godot/issues/120037","id":4634561659,"node_id":"IC_kwDOAO6SJc8AAAABFD3Mew","user":{"login":"KenzieMac130","id":7585719,"node_id":"MDQ6VXNlcjc1ODU3MTk=","avatar_url":"https://avatars.githubusercontent.com/u/7585719?v=4","gravatar_id":"","url":"https://api.github.com/users/KenzieMac130","html_url":"https://github.com/KenzieMac130","followers_url":"https://api.github.com/users/KenzieMac130/followers","following_url":"https://api.github.com/users/KenzieMac130/following{/other_user}","gists_url":"https://api.github.com/users/KenzieMac130/gists{/gist_id}","starred_url":"https://api.github.com/users/KenzieMac130/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/KenzieMac130/subscriptions","organizations_url":"https://api.github.com/users/KenzieMac130/orgs","repos_url":"https://api.github.com/users/KenzieMac130/repos","events_url":"https://api.github.com/users/KenzieMac130/events{/privacy}","received_events_url":"https://api.github.com/users/KenzieMac130/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-06-05T18:56:26Z","updated_at":"2026-06-05T18:58:51Z","body":"> You forgot to set the camera_attributes property on the VoxelGI node. If you add one, it works correctly\n> <img alt=\"Image\" width=\"2000\" height=\"1060\" src=\"https://private-user-images.githubusercontent.com/16521339/603629628-e6cc6655-d6e0-4bb4-84d0-452db1ccc58f.png?jwt=eyJ0eXAiOiJKV1QiLCJhbGciOiJIUzI1NiJ9..EmdFFW9bKweMrm3oz_eFJ6xZ22pkVXFv4KxD8DthdmY\">\n> \n> This should be documented better here: https://docs.godotengine.org/en/stable/tutorials/3d/physical_light_and_camera_units.html\n> \n> Both VoxelGI and LightmapGI need a reference to your Camera/World CameraAttributes resource to adjust the exposure correctly when using Physical Light Units.\n> \n> It is explained a bit in https://docs.godotengine.org/en/stable/classes/class_cameraattributesphysical.html#class-cameraattributesphysical, but a reference in the physical light doc page would be better\n\nConfirmed that worked. Was unaware of the relationship between camera attributes and GI baking. Since physical light units is bit obscure to most users I assumed that was an oversight. Didn't check the tooltip for camera data and didn't occur to me to specify it. That one is on me. 🙇‍♀️ \n\nFeel free to close if needed.","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4634561659/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null}]