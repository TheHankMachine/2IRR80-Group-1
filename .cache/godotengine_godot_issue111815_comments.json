[{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3419911732","html_url":"https://github.com/godotengine/godot/pull/111815#issuecomment-3419911732","issue_url":"https://api.github.com/repos/godotengine/godot/issues/111815","id":3419911732,"node_id":"IC_kwDOAO6SJc7L17Y0","user":{"login":"fire","id":32321,"node_id":"MDQ6VXNlcjMyMzIx","avatar_url":"https://avatars.githubusercontent.com/u/32321?v=4","gravatar_id":"","url":"https://api.github.com/users/fire","html_url":"https://github.com/fire","followers_url":"https://api.github.com/users/fire/followers","following_url":"https://api.github.com/users/fire/following{/other_user}","gists_url":"https://api.github.com/users/fire/gists{/gist_id}","starred_url":"https://api.github.com/users/fire/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/fire/subscriptions","organizations_url":"https://api.github.com/users/fire/orgs","repos_url":"https://api.github.com/users/fire/repos","events_url":"https://api.github.com/users/fire/events{/privacy}","received_events_url":"https://api.github.com/users/fire/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-10-19T19:51:54Z","updated_at":"2025-10-19T19:51:54Z","body":"> However, be aware that performance issues may arise due to the extensive use of arrays for skin changes. \r\n\r\nAre you aware of the set optimization done in skeleton? https://github.com/godotengine/godot/pull/97538\r\n\r\n","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3419911732/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3419939211","html_url":"https://github.com/godotengine/godot/pull/111815#issuecomment-3419939211","issue_url":"https://api.github.com/repos/godotengine/godot/issues/