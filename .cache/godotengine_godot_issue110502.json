16:25:52Z","updated_at":"2026-10-04T16:23:23Z","due_on":null,"closed_at":"2026-01-26T18:09:14Z"},"comments":1,"created_at":"2025-09-13T20:39:54Z","updated_at":"2026-06-26T16:39:24Z","closed_at":"2025-11-14T23:20:33Z","assignee":{"login":"SaracenOne","id":12756047,"node_id":"MDQ6VXNlcjEyNzU2MDQ3","avatar_url":"https://avatars.githubusercontent.com/u/12756047?v=4","gravatar_id":"","url":"https://api.github.com/users/SaracenOne","html_url":"https://github.com/SaracenOne","followers_url":"https://api.github.com/users/SaracenOne/followers","following_url":"https://api.github.com/users/SaracenOne/following{/other_user}","gists_url":"https://api.github.com/users/SaracenOne/gists{/gist_id}","starred_url":"https://api.github.com/users/SaracenOne/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/SaracenOne/subscriptions","organizations_url":"https://api.github.com/users/SaracenOne/orgs","repos_url":"https://api.github.com/users/SaracenOne/repos","events_url":"https://api.github.com/users/SaracenOne/events{/privacy}","received_events_url":"https://api.github.com/users/SaracenOne/received_events","type":"User","user_view_type":"public","site_admin":false},"author_association":"MEMBER","issue_field_values":[],"type":null,"active_lock_reason":null,"draft":false,"pull_request":{"url":"https://api.github.com/repos/godotengine/godot/pulls/110502","html_url":"https://github.com/godotengine/godot/pull/110502","diff_url":"https://github.com/godotengine/godot/pull/110502.diff","patch_url":"https://github.com/godotengine/godot/pull/110502.patch","merged_at":"2025-11-14T23:20:32Z"},"body":"- Fixes https://github.com/godotengine/godot/issues/110484\r\n\r\nRegardless of whether AnimationLibrary was imported, Dictionary was treating it as a sub_resource. This PR parses and serializes AnimationLibrary into a single path.\r\n\r\nPrev:\r\n<img width=\"690\" height=\"233\" alt=\"image\" src=\"https://github.com/user-attachments/assets/68c5719d-03b3-492c-93e8-8053eb32bc2d\" />\r\n\r\n<img width=\"544\" height=\"121\" alt=\"image\" src=\"https://github.com/user-attachments/assets/e19b10fe-8996-4e3e-bdf6-12a33d593cd5\" />\r\n\r\nAfter fix:\r\n<img width=\"720\" height=\"144\" alt=\"image\" src=\"https://github.com/user-attachments/assets/1ab80730-a859-4663-b3ab-593154cb76e4\" />\r\n\r\n<img width=\"536\" height=\"60\" alt=\"image\" src=\"https://github.com/user-attachments/assets/a0931645-66d3-4980-b332-68952536c349\" />\r\n\r\nHowever, it does not affect AnimationLibraries from old projects that have already been built-in unless you re-import the gltf and rearrange it in the tscn. In other words, this change only affects newly imported gltf files and maybe does not affect past projects.　However, since this still constitutes a change in behavior, I marked it as breaking compatibility.\r\n\r\nCombined with https://github.com/godotengine/godot/pull/110487, this should significantly improve the safety of imported GlobalAnimationLibraries.","closed_by":{"login":"Repiteo","id":17489292,"node_id":"MDQ6VXNlcjE3NDg5Mjky","avatar_url":"https://avatars.githubusercontent.com/u/17489292?v=4","gravatar_id":"","url":"https://api.github.com/users/Repiteo","html_url":"https://github.com/Repiteo","followers_url":"https://api.github.com/users/Repiteo/followers","following_url":"https://api.github.com/users/Repiteo/following{/other_user}","gists_url":"https://api.github.com/users/Repiteo/gists{/gist_id}","starred_url":"https://api.github.com/users/Repiteo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Repiteo/subscriptions","organizations_url":"https://api.github.com/users/Repiteo/orgs","repos_url":"https://api.github.com/users/Repiteo/repos","events_url":"https://api.github.com/users/Repiteo/events{/privacy}","received_events_url":"https://api.github.com/users/Repiteo/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/110502/reactions","total_count":10,"+1":10,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/godotengine/godot/issues/110502/timeline","performed_via_github_app":null,"state_reason":null}