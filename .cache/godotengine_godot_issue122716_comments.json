com/users/BananaFlambe/followers","following_url":"https://api.github.com/users/BananaFlambe/following{/other_user}","gists_url":"https://api.github.com/users/BananaFlambe/gists{/gist_id}","starred_url":"https://api.github.com/users/BananaFlambe/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/BananaFlambe/subscriptions","organizations_url":"https://api.github.com/users/BananaFlambe/orgs","repos_url":"https://api.github.com/users/BananaFlambe/repos","events_url":"https://api.github.com/users/BananaFlambe/events{/privacy}","received_events_url":"https://api.github.com/users/BananaFlambe/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-08-25T09:46:56Z","updated_at":"2026-08-25T09:46:56Z","body":"> Does this happen in [4.8.dev3](https://godotengine.org/article/dev-snapshot-godot-4-8-dev-3/)?\n\nYes I've tried the MRP on that version and I can reproduce the problem.","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5408581051/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5411071831","html_url":"https://github.com/godotengine/godot/issues/122716#issuecomment-5411071831","issue_url":"https://api.github.com/repos/godotengine/godot/issues/122716","id":5411071831,"node_id":"IC_kwDOAO6SJc8AAAABQoZnVw","user":{"login":"AThousandShips","id":96648715,"node_id":"U_kgDOBcK-Cw","avatar_url":"https://avatars.githubusercontent.com/u/96648715?v=4","gravatar_id":"","url":"https://api.github.com/users/AThousandShips","html_url":"https://github.com/AThousandShips","followers_url":"https://api.github.com/users/AThousandShips/followers","following_url":"https://api.github.com/users/AThousandShips/following{/other_user}","gists_url":"https://api.github.com/users/AThousandShips/gists{/gist_id}","starred_url":"https://api.github.com/users/AThousandShips/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/AThousandShips/subscriptions","organizations_url":"https://api.github.com/users/AThousandShips/orgs","repos_url":"https://api.github.com/users/AThousandShips/repos","events_url":"https://api.github.com/users/AThousandShips/events{/privacy}","received_events_url":"https://api.github.com/users/AThousandShips/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-08-25T13:26:56Z","updated_at":"2026-08-25T13:26:56Z","body":"CC @Calinou ","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5411071831/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5417783012","html_url":"https://github.com/godotengine/godot/issues/122716#issuecomment-5417783012","issue_url":"https://api.github.com/repos/godotengine/godot/issues/122716","id":5417783012,"node_id":"IC_kwDOAO6SJc8AAAABQuzO5A","user":{"login":"Calinou","id":180032,"node_id":"MDQ6VXNlcjE4MDAzMg==","avatar_url":"https://avatars.githubusercontent.com/u/180032?v=4","gravatar_id":"","url":"https://api.github.com/users/Calinou","html_url":"https://github.com/Calinou","followers_url":"https://api.github.com/users/Calinou/followers","following_url":"https://api.github.com/users/Calinou/following{/other_user}","gists_url":"https://api.github.com/users/Calinou/gists{/gist_id}","starred_url":"https://api.github.com/users/Calinou/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Calinou/subscriptions","organizations_url":"https://api.github.com/users/Calinou/orgs","repos_url":"https://api.github.com/users/Calinou/repos","events_url":"https://api.github.com/users/Calinou/events{/privacy}","received_events_url":"https://api.github.com/users/Calinou/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-08-25T22:35:48Z","updated_at":"2026-08-25T22:36:00Z","body":"I can confirm this on 4.8.dev b56a91878e7c94977e4af978968e41d0670c0a8b (Windows 11 24H2). I bisected the regression to https://github.com/godotengine/godot/pull/109639.\n\ncc @vorvek \n\nNote that you need C# to run the MRP, as this kind of low-level Windows API access can't be done in GDScript alone.\n\n### 4.8.dev2\n\n```\n[RawInputProbe] HWND = 593452\n[RawInputProbe] WH_GETMESSAGE hook installed\n[RawInputProbe] RegisterRawInputDevices OK (flags=0x100, hwndTarget=593452)\n[RawInputProbe] [immediately after registration] device[0] usage=mouse page=0x1 flags=0x0 hwndTarget=0\n[RawInputProbe] [immediately after registration] device[1] usage=keyboard page=0x1 flags=0x100 hwndTarget=593452\n[RawInputProbe] [WH_GETMESSAGE hook] WM_INPUT seen in thread queue (count=1), target hwnd=593452\n[RawInputProbe] WM_INPUT received (count=1)\n[RawInputProbe] [WH_GETMESSAGE hook] WM_INPUT seen in thread queue (count=2), target hwnd=593452\n[RawInputProbe] WM_INPUT received (count=2)\n[...]\n```\n\n### 4.8.dev3\n\n```\n[RawInputProbe] HWND = 1509528\n[RawInputProbe] WH_GETMESSAGE hook installed\n[RawInputProbe] RegisterRawInputDevices OK (flags=0x100, hwndTarget=1509528)\n[RawInputProbe] [immediately after registration] device[0] usage=mouse page=0x1 flags=0x0 hwndTarget=0\n[RawInputProbe] [immediately after registration] device[1] usage=keyboard page=0x1 flags=0x100 hwndTarget=1509528\n[RawInputProbe] [periodic check] device[0] usage=mouse page=0x1 flags=0x0 hwndTarget=0\n[RawInputProbe] [periodic check] device[1] usage=keyboard page=0x1 flags=0x100 hwndTarget=1509528\n[...]\n```","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5417783012/reactions","total_count":2,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":2},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5418072266","html_url":"https://github.com/godotengine/godot/issues/122716#issuecomment-5418072266","issue_url":"https://api.github.com/repos/godotengine/godot/issues/122716","id":5418072266,"node_id":"IC_kwDOAO6SJc8AAAABQvE4yg","user":{"login":"vorvek","id":9655848,"node_id":"MDQ6VXNlcjk2NTU4NDg=","avatar_url":"https://avatars.githubusercontent.com/u/9655848?v=4","gravatar_id":"","url":"https://api.github.com/users/vorvek","html_url":"https://github.com/vorvek","followers_url":"https://api.github.com/users/vorvek/followers","following_url":"https://api.github.com/users/vorvek/following{/other_user}","gists_url":"https://api.github.com/users/vorvek/gists{/gist_id}","starred_url":"https://api.github.com/users/vorvek/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/vorvek/subscriptions","organizations_url":"https://api.github.com/users/vorvek/orgs","repos_url":"https://api.github.com/users/vorvek/repos","events_url":"https://api.github.com/users/vorvek/events{/privacy}","received_events_url":"https://api.github.com/users/vorvek/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-08-25T23:02:56Z","updated_at":"2026-08-25T23:02:56Z","body":"I think I see the issue. \n\nGodot now registers raw mouse input at startup, then calls `GetRawInputBuffer()` before the normal message pump. Windows specifies that this API removes the corresponding `WM_INPUT` messages from the calling thread's queue. Godot then processes the mouse records but discards (silently) any keyboard records it drained, so the MRP's registered keyboard `WM_INPUT` never reaches its `WH_GETMESSAGE` hook or the window procedure.\n\nSource: [https://learn.microsoft.com/en-us/windows/win32/api/winuser/nf-winuser-getrawinputbuffer](https://learn.microsoft.com/en-us/windows/win32/api/winuser/nf-winuser-getrawinputbuffer\n)\n\nIf we want to preserve the high polling mouse fix, we may need to have the buffered mouse reader in a separate receiver/thread, because we can't `SendInput` a hardware raw HID packet. Or maybe there's another way of preserving the native per-message delivery when external raw input is in use. Quite the palaver!","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5418072266/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5421432261","html_url":"https://github.com/godotengine/godot/issues/122716#issuecomment-5421432261","issue_url":"https://api.github.com/repos/godotengine/godot/issues/122716","id":5421432261,"node_id":"IC_kwDOAO6SJc8AAAABQyR9xQ","user":{"login":"bruvzg","id":7645683,"node_id":"MDQ6VXNlcjc2NDU2ODM=","avatar_url":"https://avatars.githubusercontent.com/u/7645683?v=4","gravatar_id":"","url":"https://api.github.com/users/bruvzg","html_url":"https://github.com/bruvzg","followers_url":"https://api.github.com/users/bruvzg/followers","following_url":"https://api.github.com/users/bruvzg/following{/other_user}","gists_url":"https://api.github.com/users/bruvzg/gists{/gist_id}","starred_url":"https://api.github.com/users/bruvzg/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/bruvzg/subscriptions","organizations_url":"https://api.github.com/users/bruvzg/orgs","repos_url":"https://api.github.com/users/bruvzg/repos","events_url":"https://api.github.com/users/bruvzg/events{/privacy}","received_events_url":"https://api.github.com/users/bruvzg/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-08-26T06:22:38Z","updated_at":"2026-08-26T06:22:38Z","body":"> we may need to have the buffered mouse reader in a separate receiver/thread, because we can't SendInput a hardware raw HID packet. Or maybe there's another way of preserving the native per-message delivery when external raw input is in use. Quite the palaver!\n\nTechnically directly handling window messages was never a supported use case, if it was working, it is a pure coincidence, so I would not consider it a regression.\nAdding a project setting to disable built-in raw input handling is probably sufficient to fix it (and might be useful for the other edge cases as well).","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5421432261/reactions","total_count":2,"+1":2,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5426922412","html_url":"https://github.com/godotengine/godot/issues/122716#issuecomment-5426922412","issue_url":"https://api.github.com/repos/godotengine/godot/issues/122716","id":5426922412,"node_id":"IC_kwDOAO6SJc8AAAABQ3hDrA","user":{"login":"Calinou","id":180032,"node_id":"MDQ6VXNlcjE4MDAzMg==","avatar_url":"https://avatars.githubusercontent.com/u/180032?v=4","gravatar_id":"","url":"https://api.github.com/users/Calinou","html_url":"https://github.com/Calinou","followers_url":"https://api.github.com/users/Calinou/followers","following_url":"https://api.github.com/users/Calinou/following{/other_user}","gists_url":"https://api.github.com/users/Calinou/gists{/gist_id}","starred_url":"https://api.github.com/users/Calinou/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Calinou/subscriptions","organizations_url":"https://api.github.com/users/Calinou/orgs","repos_url":"https://api.github.com/users/Calinou/repos","events_url":"https://api.github.com/users/Calinou/events{/privacy}","received_events_url":"https://api.github.com/users/Calinou/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-08-26T14:36:34Z","updated_at":"2026-08-26T14:36:34Z","body":"Also, if you're using this to create global shortcuts, implementing this proposal would remove the need to create a separate input device:\n\n- https://github.com/godotengine/godot-proposals/issues/1919","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5426922412/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5427824381","html_url":"https://github.com/godotengine/godot/issues/122716#issuecomment-5427824381","issue_url":"https://api.github.com/repos/godotengine/godot/issues/122716","id":5427824381,"node_id":"IC_kwDOAO6SJc8AAAABQ4YG_Q","user":{"login":"BananaFlambe","id":1457461,"node_id":"MDQ6VXNlcjE0NTc0NjE=","avatar_url":"https://avatars.githubusercontent.com/u/1457461?v=4","gravatar_id":"","url":"https://api.github.com/users/BananaFlambe","html_url":"https://github.com/BananaFlambe","followers_url":"https://api.github.com/users/BananaFlambe/followers","following_url":"https://api.github.com/users/BananaFlambe/following{/other_user}","gists_url":"https://api.github.com/users/BananaFlambe/gists{/gist_id}","starred_url":"https://api.github.com/users/BananaFlambe/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/BananaFlambe/subscriptions","organizations_url":"https://api.github.com/users/BananaFlambe/orgs","repos_url":"https://api.github.com/users/BananaFlambe/repos","events_url":"https://api.github.com/users/BananaFlambe/events{/privacy}","received_events_url":"https://api.github.com/users/BananaFlambe/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-08-26T16:07:42Z","updated_at":"2026-08-26T21:18:06Z","body":"> Also, if you're using this to create global shortcuts, implementing this proposal would remove the need to create a separate input device:\n> \n>     * [Add support for registering global keyboard shortcut bindings godot-proposals#1919](https://github.com/godotengine/godot-proposals/issues/1919)\n\nI'm using WH_KEYBOARD_LL to get the keyboard input while the app is unfocused and I need something that returns the same key codes as WH_KEYBOARD_LL while focused (since the WH_KEYBOARD_LL hook doesn't work while the app is focused for some reason I don't understand).\n\nSo I got to this hybrid solution using RIDEV_INPUTSINK while focused and WH_KEYBOARD_LL while unfocused.","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5427824381/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null}]