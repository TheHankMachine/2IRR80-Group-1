":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":{"reason":"outdated"}},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2460324184","html_url":"https://github.com/godotengine/godot/pull/98890#issuecomment-2460324184","issue_url":"https://api.github.com/repos/godotengine/godot/issues/98890","id":2460324184,"node_id":"IC_kwDOAO6SJc6SpZFY","user":{"login":"syntaxerror247","id":176927541,"node_id":"U_kgDOCouzNQ","avatar_url":"https://avatars.githubusercontent.com/u/176927541?v=4","gravatar_id":"","url":"https://api.github.com/users/syntaxerror247","html_url":"https://github.com/syntaxerror247","followers_url":"https://api.github.com/users/syntaxerror247/followers","following_url":"https://api.github.com/users/syntaxerror247/following{/other_user}","gists_url":"https://api.github.com/users/syntaxerror247/gists{/gist_id}","starred_url":"https://api.github.com/users/syntaxerror247/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/syntaxerror247/subscriptions","organizations_url":"https://api.github.com/users/syntaxerror247/orgs","repos_url":"https://api.github.com/users/syntaxerror247/repos","events_url":"https://api.github.com/users/syntaxerror247/events{/privacy}","received_events_url":"https://api.github.com/users/syntaxerror247/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2024-11-06T17:03:59Z","updated_at":"2024-11-06T17:03:59Z","body":"@m4gr3d I have updated the app theme in `Themes.xml` to now use `Theme.DeviceDefault.NoActionBar`.\r\n\r\n```xml\r\n<item name =\"android:windowDrawsSystemBarBackgrounds\">false</item>\r\n```\r\nThis line removes the background of the navigation and status bars, addressing the white navigation bar issue that arose after the theme change.","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2460324184/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2460804759","html_url":"https://github.com/godotengine/godot/pull/98890#issuecomment-2460804759","issue_url":"https://api.github.com/repos/godotengine/godot/issues/98890","id":2460804759,"node_id":"IC_kwDOAO6SJc6SrOaX","user":{"login":"ghost","id":10137,"node_id":"MDQ6VXNlcjEwMTM3","avatar_url":"https://avatars.githubusercontent.com/u/10137?v=4","gravatar_id":"","url":"https://api.github.com/users/ghost","html_url":"https://github.com/ghost","followers_url":"https://api.github.com/users/ghost/followers","following_url":"https://api.github.com/users/ghost/following{/other_user}","gists_url":"https://api.github.com/users/ghost/gists{/gist_id}","starred_url":"https://api.github.com/users/ghost/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/ghost/subscriptions","organizations_url":"https://api.github.com/users/ghost/orgs","repos_url":"https://api.github.com/users/ghost/repos","events_url":"https://api.github.com/users/ghost/events{/privacy}","received_events_url":"https://api.github.com/users/ghost/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2024-11-06T21:19:08Z","updated_at":"2024-11-06T21:19:08Z","body":"A bit off-topic question but android specific. Can user force some specific version? I mean that you showed that motorola and xiaomi uses different default theme. Is it ever possible to force xiaomi use the same theme as motorola?","author_association":"NONE","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2460804759/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2460868022","html_url":"https://github.co