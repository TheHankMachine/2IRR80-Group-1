dotengine/godot/issues/comments/3825862329/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3826296522","html_url":"https://github.com/godotengine/godot/issues/115650#issuecomment-3826296522","issue_url":"https://api.github.com/repos/godotengine/godot/issues/115650","id":3826296522,"node_id":"IC_kwDOAO6SJc7kEKbK","user":{"login":"Calinou","id":180032,"node_id":"MDQ6VXNlcjE4MDAzMg==","avatar_url":"https://avatars.githubusercontent.com/u/180032?v=4","gravatar_id":"","url":"https://api.github.com/users/Calinou","html_url":"https://github.com/Calinou","followers_url":"https://api.github.com/users/Calinou/followers","following_url":"https://api.github.com/users/Calinou/following{/other_user}","gists_url":"https://api.github.com/users/Calinou/gists{/gist_id}","starred_url":"https://api.github.com/users/Calinou/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Calinou/subscriptions","organizations_url":"https://api.github.com/users/Calinou/orgs","repos_url":"https://api.github.com/users/Calinou/repos","events_url":"https://api.github.com/users/Calinou/events{/privacy}","received_events_url":"https://api.github.com/users/Calinou/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-01-30T23:06:14Z","updated_at":"2026-01-30T23:09:47Z","body":"I can't reproduce this on 4.7.dev.custom_build 780b6891e (Linux/X11, Fedora 43 KDE).\n\nDo you have **Update Continuously** enabled in the Editor Settings? You should leave it unchecked unless you're running into a bug that requires you to have it enabled.\n\n```\n+-----------------------------------------------------------------------------------------+\n| NVIDIA-SMI 580.119.02             Driver Version: 580.119.02     CUDA Version: 13.0     |\n+-----------------------------------------+------------------------+----------------------+\n| GPU  Name                 Persistence-M | Bus-Id          Disp.A | Volatile Uncorr. ECC |\n| Fan  Temp   Perf          Pwr:Usage/Cap |           Memory-Usage | GPU-Util  Compute M. |\n|                                         |                        |               MIG M. |\n|=========================================+========================+======================|\n|   0  NVIDIA GeForce RTX 5090        Off |   00000000:01:00.0  On |                  N/A |\n|  0%   48C    P5             44W /  600W |    2661MiB /  32607MiB |\t 0%\t Default |\n|                                         |                        |                  N/A |\n+-----------------------------------------+------------------------+----------------------+\n```\n\n@leandro-benedet-garcia Can you reproduce this on a X11 session?\n\nAlso on Wayland, try disabling **Prefer Wayland** in the Editor Settings to run the editor over XWayland instead.","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3826296522/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3826426357","html_url":"https://github.com/godotengine/godot/issues/115650#issuecomment-3826426357","issue_url":"https://api.github.com/repos/godotengine/godot/issues/115650","id":3826426357,"node_id":"IC_kwDOAO6SJc7kEqH1","user":{"login":"leandro-benedet-garcia","id":291051,"node_id":"MDQ6VXNlcjI5MTA1MQ==","avatar_url":"https://avatars.githubusercontent.com/u/291051?v=4","gravatar_id":"","url":"https://api.github.com/users/leandro-benedet-garcia","html_url":"https://github.com/leandro-benedet-garcia","followers_url":"https://api.github.com/users/leandro-benedet-garcia/followers","following_url":"https://api.github.com/users/leandro-benedet-garcia/following{/other_user}","gists_url":"https://api.github.com/users/leandro-benedet-garcia/gists{/gist_id}","starred_url":"https://api.github.com/users/leandro-benedet-garcia/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/leandro-benedet-garcia/subscriptions","organizations_url":"https://api.github.com/users/leandro-benedet-garcia/orgs","repos_url":"https://api.github.com/users/leandro-benedet-garcia/repos","events_url":"https://api.github.com/users/leandro-benedet-garcia/events{/privacy}","received_events_url":"https://api.github.com/users/leandro-benedet-garcia/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-01-30T23:31:44Z","updated_at":"2026-01-30T23:35:19Z","body":"[reproduceable.zip](https://github.com/user-attachments/files/24975563/reproduceable.zip)\n\nWith this project I can reproduce the issue a 100% of the time if I select the node `Raymarcher/Eyes/LeftEye(0)` and keep moving with the gizmo the Node up and down continuously until Godot Freezes. I don't see the GPU going up to 100% with this one but Godot does freeze tho.\n\nThe thing happens with wayland on or off. And running continuously off. it also happens with version 4.5 and 4.6.\n\nSomething tells me it's related to \n`set_shader_parameter`, that is located in `res://scripts/raymarching.gd` and triggered when the node moves.","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3826426357/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null}]