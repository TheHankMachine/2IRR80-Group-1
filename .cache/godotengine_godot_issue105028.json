dot/pull/105028.patch","merged_at":"2025-04-04T22:46:01Z"},"body":"After bringing up my interest in decoupling `GDCLASS` from `ClassDB` in [this proposal](https://github.com/godotengine/godot-proposals/issues/12155#issuecomment-2779512035), I got curious and checked just how easily that could be integrated as-is. Turns out… Surprisingly easy! It's not a full decoupling of `ClassDB` from `Object`, which is the real endgoal, but decoupling just `GDCLASS` is enough to make `core/object/class_db.h` no longer a 100% required include for all `Object` subclass headers.","closed_by":{"login":"Repiteo","id":17489292,"node_id":"MDQ6VXNlcjE3NDg5Mjky","avatar_url":"https://avatars.githubusercontent.com/u/17489292?v=4","gravatar_id":"","url":"https://api.github.com/users/Repiteo","html_url":"https://github.com/Repiteo","followers_url":"https://api.github.com/users/Repiteo/followers","following_url":"https://api.github.com/users/Repiteo/following{/other_user}","gists_url":"https://api.github.com/users/Repiteo/gists{/gist_id}","starred_url":"https://api.github.com/users/Repiteo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Repiteo/subscriptions","organizations_url":"https://api.github.com/users/Repiteo/orgs","repos_url":"https://api.github.com/users/Repiteo/repos","events_url":"https://api.github.com/users/Repiteo/events{/privacy}","received_events_url":"https://api.github.com/users/Repiteo/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/105028/reactions","total_count":2,"+1":2,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/godotengine/godot/issues/105028/timeline","performed_via_github_app":null,"state_reason":null}