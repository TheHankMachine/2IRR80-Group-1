roid5/following{/other_user}","gists_url":"https://api.github.com/users/notroid5/gists{/gist_id}","starred_url":"https://api.github.com/users/notroid5/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/notroid5/subscriptions","organizations_url":"https://api.github.com/users/notroid5/orgs","repos_url":"https://api.github.com/users/notroid5/repos","events_url":"https://api.github.com/users/notroid5/events{/privacy}","received_events_url":"https://api.github.com/users/notroid5/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-05-28T13:12:42Z","updated_at":"2026-05-28T13:12:42Z","body":">  Hello! May I ask if you could run print(Input.get_joy_info(0)) and copy the output here?\n\nAlready added in the report above ;)\n\n> Edit²: As requested in https://github.com/godotengine/godot/issues/119814, here is the GUID:\n0300a49825090000e803000001010000\n(There are two controllers but both are identical and share the same GUID.)","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4564291835/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4564326872","html_url":"https://github.com/godotengine/godot/issues/119786#issuecomment-4564326872","issue_url":"https://api.github.com/repos/godotengine/godot/issues/119786","id":4564326872,"node_id":"IC_kwDOAO6SJc8AAAABEA4Z2A","user":{"login":"Nintorch","id":92302738,"node_id":"U_kgDOBYBtkg","avatar_url":"https://avatars.githubusercontent.com/u/92302738?v=4","gravatar_id":"","url":"https://api.github.com/users/Nintorch","html_url":"https://github.com/Nintorch","followers_url":"https://api.github.com/users/Nintorch/followers","following_url":"https://api.github.com/users/Nintorch/following{/other_user}","gists_url":"https: