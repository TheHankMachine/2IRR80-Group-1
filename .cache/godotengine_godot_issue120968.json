_at":null,"archived_by":null},{"id":1609442062,"node_id":"MDU6TGFiZWwxNjA5NDQyMDYy","url":"https://api.github.com/repos/godotengine/godot/labels/topic:shaders","name":"topic:shaders","color":"ffee88","default":false,"description":"","archived_at":null,"archived_by":null},{"id":2909900850,"node_id":"MDU6TGFiZWwyOTA5OTAwODUw","url":"https://api.github.com/repos/godotengine/godot/labels/topic:export","name":"topic:export","color":"ffee88","default":false,"description":"","archived_at":null,"archived_by":null}],"state":"closed","locked":false,"assignees":[],"milestone":{"url":"https://api.github.com/repos/godotengine/godot/milestones/25","html_url":"https://github.com/godotengine/godot/milestone/25","labels_url":"https://api.github.com/repos/godotengine/godot/milestones/25/labels","id":15520464,"node_id":"MI_kwDOAO6SJc4A7NLQ","number":25,"title":"4.8","description":"","creator":{"login":"Repiteo","id":17489292,"node_id":"MDQ6VXNlcjE3NDg5Mjky","avatar_url":"https://avatars.githubusercontent.com/u/17489292?v=4","gravatar_id":"","url":"https://api.github.com/users/Repiteo","html_url":"https://github.com/Repiteo","followers_url":"https://api.github.com/users/Repiteo/followers","following_url":"https://api.github.com/users/Repiteo/following{/other_user}","gists_url":"https://api.github.com/users/Repiteo/gists{/gist_id}","starred_url":"https://api.github.com/users/Repiteo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Repiteo/subscriptions","organizations_url":"https://api.github.com/users/Repiteo/orgs","repos_url":"https://api.github.com/users/Repiteo/repos","events_url":"https://api.github.com/users/Repiteo/events{/privacy}","received_events_url":"https://api.github.com/users/Repiteo/received_events","type":"User","user_view_type":"public","site_admin":false},"open_issues":343,"closed_issues":2335,"state":"open","created_at":"2026-04-13T15:59:35Z","updated_at":"2026-10-22T06:28:22Z","due_on":null,"closed_at":null},"comments":8,"created_at":"2026-07-05T14:38:23Z","updated_at":"2026-07-17T17:33:16Z","closed_at":"2026-07-17T17:33:08Z","assignee":null,"author_association":"CONTRIBUTOR","issue_field_values":[],"type":null,"active_lock_reason":null,"draft":false,"pull_request":{"url":"https://api.github.com/repos/godotengine/godot/pulls/120968","html_url":"https://github.com/godotengine/godot/pull/120968","diff_url":"https://github.com/godotengine/godot/pull/120968.diff","patch_url":"https://github.com/godotengine/godot/pull/120968.patch","merged_at":"2026-07-17T17:33:08Z"},"body":"While working on the PS5 platform port, we came across a determinism bug in the shader compiler.\r\nFor PS5, we prebake Shaders on a Windows machine to target PS5. \r\n\r\nrtos() which uses String::num() and that uses snprintf(), outputs a different result across platforms, for Windows during baking and on PS5 during runtime. This issue might also be true for other platforms or across windows machines.\r\n\r\nWith this, the baker and runtime compute different hashes for the same shader. When the runtime, without a runtime compiler, then looks up a cache entry, there is a miss and it reports that it cannot find the shader.\r\n\r\nWe replace this with String::num_scientific(), which uses Grisu2, a pure-integer algorithm that is fully deterministic across platforms, compilers and locales.\r\n\r\nNote this will change all shader cache hashes once.\r\n\r\nTested on Windows and on PS5 across multiple projects.","closed_by":{"login":"Repiteo","id":17489292,"node_id":"MDQ6VXNlcjE3NDg5Mjky","avatar_url":"https://avatars.githubusercontent.com/u/17489292?v=4","gravatar_id":"","url":"https://api.github.com/users/Repiteo","html_url":"https://github.com/Repiteo","followers_url":"https://api.github.com/users/Repiteo/followers","following_url":"https://api.github.com/users/Repiteo/following{/other_user}","gists_url":"https://api.github.com/users/Repiteo/gists{/gist_id}","starred_url":"https://api.github.com/users/Repiteo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Repiteo/subscriptions","organizations_url":"https://api.github.com/users/Repiteo/orgs","repos_url":"https://api.github.com/users/Repiteo/repos","events_url":"https://api.github.com/users/Repiteo/events{/privacy}","received_events_url":"https://api.github.com/users/Repiteo/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/120968/reactions","total_count":6,"+1":6,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/godotengine/godot/issues/120968/timeline","performed_via_github_app":null,"state_reason":null}