5Mzc5","login":"lawnjelly","type":"User","owned_private_repos":0,"public_gists":0,"public_repos":0,"total_private_repos":0,"url":"https://api.github.com/users/lawnjelly"},"body":"","html_url":"https://github.com/godotengine/godot/pull/106863#pullrequestreview-2877033696","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/106863","author_association":"MEMBER","submitted_at":"2025-05-29T04:36:03Z"},{"id":2882688257,"node_id":"PRR_kwDOAO6SJc6r0lUB","state":"COMMENTED","user":{"site_admin":false,"suspended":false,"updated_at":"0001-01-01T00:00:00Z","avatar_url":"https://avatars.githubusercontent.com/u/180032?u=68d23e7ee9cdf810da125e8510b72f845b9dccc8&v=4","created_at":"0001-01-01T00:00:00Z","followers":0,"following":0,"html_url":"https://github.com/Calinou","id":180032,"node_id":"MDQ6VXNlcjE4MDAzMg==","login":"Calinou","type":"User","owned_private_repos":0,"public_gists":0,"public_repos":0,"total_private_repos":0,"url":"https://api.github.com/users/Calinou"},"body":"Tested locally, it works as expected. Code looks good to me.\r\n\r\n**Testing project:** [test_softbody_point_radius.zip](https://github.com/user-attachments/files/20377214/test_softbody_point_radius.zip)\r\n\r\nExample at 20 ticks per second:\r\n\r\n### Physics interpolation disabled\r\n\r\nhttps://github.com/user-attachments/assets/bcbf9c99-ce18-42eb-a6ae-652ef5a9d3e6\r\n\r\n### Physics interpolation enabled\r\n\r\nhttps://github.com/user-attachments/assets/f58c4b3e-572d-453d-a873-2e8477cbb6e4\r\n\r\n\r\nOf course, SoftBody simulation quality greatly varies depending on the physics tick rate. In practice, you'll want to use 30 tps or more for cloth whenever possible.\r\n\r\nExample at 1 tick per second so you can see it in more detail :slightly_smiling_face: \r\n\r\nhttps://github.com/user-attachments/assets/b4464086-9bb5-485b-9a61-b3c0f86b7c11\r\n\r\nDuring the first tick, all SoftBodies are positioned at the global world origin. They move to the correct position on the second physics tick. Is there a way we could avoid this?","html_url":"https://github.com/godotengine/godot/pull/106863#pullrequestreview-2882688257","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/106863","author_association":"MEMBER","submitted_at":"2025-05-30T22:12:54Z"},{"id":2890191516,"node_id":"PRR_kwDOAO6SJc6sRNKc","state":"APPROVED","commit_id":"cc52fd777ea9fcbb6e121154860b4ee14af3724f","user":{"site_admin":false,"suspended":false,"updated_at":"0001-01-01T00:00:00Z","avatar_url":"https://avatars.githubusercontent.com/u/180032?u=68d23e7ee9cdf810da125e8510b72f845b9dccc8&v=4","created_at":"0001-01-01T00:00:00Z","followers":0,"following":0,"html_url":"https://github.com/Calinou","id":180032,"node_id":"MDQ6VXNlcjE4MDAzMg==","login":"Calinou","type":"User","owned_private_repos":0,"public_gists":0,"public_repos":0,"total_private_repos":0,"url":"https://api.github.com/users/Calinou"},"body":"Works great now :slightly_smiling_face: I can confirm the initial interpolation issue is fixed (tested on both physics engines, just in case).","html_url":"https://github.com/godotengine/godot/pull/106863#pullrequestreview-2890191516","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/106863","author_association":"MEMBER","submitted_at":"2025-06-02T23:30:26Z"},{"id":2895813655,"node_id":"PRR_kwDOAO6SJc6smpwX","state":"APPROVED","commit_id":"cc52fd777ea9fcbb6e121154860b4ee14af3724f","user":{"site_admin":false,"suspended":false,"updated_at":"0001-01-01T00:00:00Z","avatar_url":"https://avatars.githubusercontent.com/u/21999379?u=2b8b17ce969861380874563b333a546e0bbaab56&v=4","created_at":"0001-01-01T00:00:00Z","followers":0,"following":0,"html_url":"https://github.com/lawnjelly","id":21999379,"node_id":"MDQ6VXNlcjIxOTk5Mzc5","login":"lawnjelly","type":"User","owned_private_repos":0,"public_gists":0,"public_repos":0,"total_private_repos":0,"url":"https://api.github.com/users/lawnjelly"},"body":"Actually on reflection, although there are a few issues to be solved with this PR, in logistical terms it may be easier to merge then I can do a followup.\r\n\r\nIt will be too difficult to explain these problems here, and easier to just make followup PR where they can be discussed.","html_url":"https://github.com/godotengine/godot/pull/106863#pullrequestreview-2895813655","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/106863","author_association":"MEMBER","submitted_at":"2025-06-04T08:35:52Z"}]