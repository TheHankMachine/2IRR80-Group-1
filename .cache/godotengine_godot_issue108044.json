g5","url":"https://api.github.com/repos/godotengine/godot/labels/topic:3d","name":"topic:3d","color":"ffee88","default":false,"description":"","archived_at":null,"archived_by":null}],"state":"closed","locked":false,"assignees":[],"milestone":{"url":"https://api.github.com/repos/godotengine/godot/milestones/22","html_url":"https://github.com/godotengine/godot/milestone/22","labels_url":"https://api.github.com/repos/godotengine/godot/milestones/22/labels","id":12070367,"node_id":"MI_kwDOAO6SJc4AuC3f","number":22,"title":"4.5","description":"","creator":{"login":"Sauermann","id":6299227,"node_id":"MDQ6VXNlcjYyOTkyMjc=","avatar_url":"https://avatars.githubusercontent.com/u/6299227?v=4","gravatar_id":"","url":"https://api.github.com/users/Sauermann","html_url":"https://github.com/Sauermann","followers_url":"https://api.github.com/users/Sauermann/followers","following_url":"https://api.github.com/users/Sauermann/following{/other_user}","gists_url":"https://api.github.com/users/Sauermann/gists{/gist_id}","starred_url":"https://api.github.com/users/Sauermann/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Sauermann/subscriptions","organizations_url":"https://api.github.com/users/Sauermann/orgs","repos_url":"https://api.github.com/users/Sauermann/repos","events_url":"https://api.github.com/users/Sauermann/events{/privacy}","received_events_url":"https://api.github.com/users/Sauermann/received_events","type":"User","user_view_type":"public","site_admin":false},"open_issues":3,"closed_issues":3687,"state":"closed","created_at":"2024-12-19T08:51:28Z","updated_at":"2026-09-04T21:48:38Z","due_on":"2025-09-15T00:00:00Z","closed_at":"2025-09-18T17:13:14Z"},"comments":3,"created_at":"2025-06-27T12:03:48Z","updated_at":"2025-08-01T08:07:08Z","closed_at":"2025-07-31T15:44:32Z","assignee":null,"author_association":"CONTRIBUTOR","issue_field_values":[],"type":null,"active_lock_reason":null,"draft":false,"pull_request":{"url":"https://api.github.com/repos/godotengine/godot/pulls/108044","html_url":"https://github.com/godotengine/godot/pull/108044","diff_url":"https://github.com/godotengine/godot/pull/108044.diff","patch_url":"https://github.com/godotengine/godot/pull/108044.patch","merged_at":"2025-07-31T15:44:32Z"},"body":"Resolves #107935.\r\n\r\nThe problem was that stencil writes were occurring during depth pre-pass in Compatibility and Forward+, which resulted in improper sorting. For Mobile, a very similar problem was caused due to the lack of depth pre-pass.\r\n\r\nThe reason this issue wasn't caught earlier is because it mainly applies to objects which cannot use the shared shadow material, which was resulting in accidentally correct stencil values in the depth pre-pass.\r\n\r\nOverview of code changes:\r\n- GLES3\r\n  - Disable stencil writes during depth pre-pass. Easy.\r\n- Forward+\r\n  - Disable stencil writes in depth pre-pass.\r\n  - Disable shared shadow material for shaders using stencil.\r\n- Mobile\r\n  - (Updated) Simply sort opaque stencil objects to the end of the render list. This doesn't *fully* fix the issue, but it's a good compromise that will fix the vast majority of use cases.\r\n  - Disable shared shadow material for shaders using stencil.\r\n","closed_by":{"login":"Repiteo","id":17489292,"node_id":"MDQ6VXNlcjE3NDg5Mjky","avatar_url":"https://avatars.githubusercontent.com/u/17489292?v=4","gravatar_id":"","url":"https://api.github.com/users/Repiteo","html_url":"https://github.com/Repiteo","followers_url":"https://api.github.com/users/Repiteo/followers","following_url":"https://api.github.com/users/Repiteo/following{/other_user}","gists_url":"https://api.github.com/users/Repiteo/gists{/gist_id}","starred_url":"https://api.github.com/users/Repiteo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Repiteo/subscriptions","organizations_url":"https://api.github.com/users/Repiteo/orgs","repos_url":"https://api.github.com/users/Repiteo/repos","events_url":"https://api.github.com/users/Repiteo/events{/privacy}","received_events_url":"https://api.github.com/users/Repiteo/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/108044/reactions","total_count":6,"+1":2,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":1,"eyes":3},"timeline_url":"https://api.github.com/repos/godotengine/godot/issues/108044/timeline","performed_via_github_app":null,"state_reason":null}