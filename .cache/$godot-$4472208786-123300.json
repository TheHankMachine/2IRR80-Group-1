[{"id":5155097714,"node_id":"PRR_kwDOAO6SJc8AAAABM0SMcg","state":"COMMENTED","commit_id":"be430ea73ad4c01ca0b90beb4ca4418c739408e8","user":{"site_admin":false,"suspended":false,"updated_at":"0001-01-01T00:00:00Z","avatar_url":"https://avatars.githubusercontent.com/u/19259897?u=6ecace2ddb6505607f21e3c41da42157298bd406&v=4","created_at":"0001-01-01T00:00:00Z","followers":0,"following":0,"html_url":"https://github.com/blueskythlikesclouds","id":19259897,"node_id":"MDQ6VXNlcjE5MjU5ODk3","login":"blueskythlikesclouds","type":"User","owned_private_repos":0,"public_gists":0,"public_repos":0,"total_private_repos":0,"url":"https://api.github.com/users/blueskythlikesclouds"},"body":"The fix makes sense to me, but this implies the default project setting technically has been `PIPELINE_FORCED_ON` all along. Is the new \"fixed\" behavior what we want by default for all projects?","html_url":"https://github.com/godotengine/godot/pull/123300#pullrequestreview-5155097714","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/123300","author_association":"MEMBER","submitted_at":"2026-09-09T13:38:29Z"},{"id":5156803710,"node_id":"PRR_kwDOAO6SJc8AAAABM16Ufg","state":"DISMISSED","commit_id":"be430ea73ad4c01ca0b90beb4ca4418c739408e8","user":{"site_admin":false,"suspended":false,"updated_at":"0001-01-01T00:00:00Z","avatar_url":"https://avatars.githubusercontent.com/u/96648715?u=af70f5d107e9c1447f296643d5a566dab53d25e8&v=4","created_at":"0001-01-01T00:00:00Z","followers":0,"following":0,"html_url":"https://github.com/AThousandShips","id":96648715,"node_id":"U_kgDOBcK-Cw","login":"AThousandShips","type":"User","owned_private_repos":0,"public_gists":0,"public_repos":0,"total_private_repos":0,"url":"https://api.github.com/users/AThousandShips"},"body":"See comment above, needs clarity ","html_url":"https://github.com/godotengine/godot/pull/123300#pullrequestreview-5156803710","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/123300","author_association":"MEMBER","submitted_at":"2026-09-09T16:00:28Z"},{"id":5157599373,"node_id":"PRR_kwDOAO6SJc8AAAABM2q4jQ","state":"APPROVED","commit_id":"be430ea73ad4c01ca0b90beb4ca4418c739408e8","user":{"site_admin":false,"suspended":false,"updated_at":"0001-01-01T00:00:00Z","avatar_url":"https://avatars.githubusercontent.com/u/16521339?u=e44a465cbebabb9ea2be80b59e6dc07966bef5b7&v=4","created_at":"0001-01-01T00:00:00Z","followers":0,"following":0,"html_url":"https://github.com/clayjohn","id":16521339,"node_id":"MDQ6VXNlcjE2NTIxMzM5","login":"clayjohn","type":"User","owned_private_repos":0,"public_gists":0,"public_repos":0,"total_private_repos":0,"url":"https://api.github.com/users/clayjohn"},"body":"Approving based on @darksylinc's comment. \n\nThe current behaviour is a bug and was a mistake in the original implementation. At that time we discussed and agreed on what would be the ideal default considering performance and battery consumption. So it makes sense to switch to the default behaviour that we intended to have. \n\nThis will come with a change in behaviour for users, but now they are empowered to actually select their desired behaviour in the project settings. So while it is technically a change in behaviour, it is not a big deal IMO and comes with fewer negative consequences than having to change the default value to match the current (buggy) behaviour)","html_url":"https://github.com/godotengine/godot/pull/123300#pullrequestreview-5157599373","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/123300","author_association":"MEMBER","submitted_at":"2026-09-09T17:15:01Z"}]