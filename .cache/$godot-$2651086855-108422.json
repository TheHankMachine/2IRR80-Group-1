tengine/godot/pulls/108422","author_association":"CONTRIBUTOR","submitted_at":"2025-07-09T20:49:15Z"},{"id":3338327748,"node_id":"PRR_kwDOAO6SJc7G-tbE","state":"APPROVED","user":{"site_admin":false,"suspended":false,"updated_at":"0001-01-01T00:00:00Z","avatar_url":"https://avatars.githubusercontent.com/u/16521339?u=e44a465cbebabb9ea2be80b59e6dc07966bef5b7&v=4","created_at":"0001-01-01T00:00:00Z","followers":0,"following":0,"html_url":"https://github.com/clayjohn","id":16521339,"node_id":"MDQ6VXNlcjE2NTIxMzM5","login":"clayjohn","type":"User","owned_private_repos":0,"public_gists":0,"public_repos":0,"total_private_repos":0,"url":"https://api.github.com/users/clayjohn"},"body":"We have some more work to do on Vulkan and D3D12. But that will have to be done in a follow up PR. This PR is a strict improvement, so can go ahead. \r\n\r\nStuart and I discussed at length and concluded that we aren't going to be able to unify the implementations for Vulkan, D3D12 and Metal. The main reason being that Metal provides access to the raw CPU buffer without mapping memory when the texture is CPU-readable. With D3D12 and Vulkan you always have to map the memory. Treating Metal like D3D12 and Vulkan (and always mapping when available) is not a good option","html_url":"https://github.com/godotengine/godot/pull/108422#pullrequestreview-3338327748","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/108422","author_association":"MEMBER","submitted_at":"2025-10-15T04:33:43Z"},{"id":3309824875,"node_id":"PRR_kwDOAO6SJc7FR-tr","state":"COMMENTED","user":{"site_admin":false,"suspended":false,"updated_at":"0001-01-01T00:00:00Z","avatar_url":"https://avatars.githubusercontent.com/u/96648715?u=af70f5d107e9c1447f296643d5a566dab53d25e8&v=4","created_at":"0001-01-01T00:00:00Z","followers":0,"following":0,"html_url":"https://github.com/AThousandShips","id":96648715,"node_id":"U_kgDOBcK-Cw","login":"AThousandShips","type":"User","owned_private_repos":0,"public_gists":0,"public_repos":0,"total_private_repos":0,"url":"https://api.github.com/users/AThousandShips"},"body":"","html_url":"https://github.com/godotengine/godot/pull/108422#pullrequestreview-3309824875","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/108422","author_association":"MEMBER","submitted_at":"2025-10-15T07:22:21Z"}]