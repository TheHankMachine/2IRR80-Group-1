scription":"","archived_at":null,"archived_by":null}],"state":"closed","locked":false,"assignees":[],"milestone":{"url":"https://api.github.com/repos/godotengine/godot/milestones/22","html_url":"https://github.com/godotengine/godot/milestone/22","labels_url":"https://api.github.com/repos/godotengine/godot/milestones/22/labels","id":12070367,"node_id":"MI_kwDOAO6SJc4AuC3f","number":22,"title":"4.5","description":"","creator":{"login":"Sauermann","id":6299227,"node_id":"MDQ6VXNlcjYyOTkyMjc=","avatar_url":"https://avatars.githubusercontent.com/u/6299227?v=4","gravatar_id":"","url":"https://api.github.com/users/Sauermann","html_url":"https://github.com/Sauermann","followers_url":"https://api.github.com/users/Sauermann/followers","following_url":"https://api.github.com/users/Sauermann/following{/other_user}","gists_url":"https://api.github.com/users/Sauermann/gists{/gist_id}","starred_url":"https://api.github.com/users/Sauermann/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Sauermann/subscriptions","organizations_url":"https://api.github.com/users/Sauermann/orgs","repos_url":"https://api.github.com/users/Sauermann/repos","events_url":"https://api.github.com/users/Sauermann/events{/privacy}","received_events_url":"https://api.github.com/users/Sauermann/received_events","type":"User","user_view_type":"public","site_admin":false},"open_issues":3,"closed_issues":3687,"state":"closed","created_at":"2024-12-19T08:51:28Z","updated_at":"2026-09-04T21:48:38Z","due_on":"2025-09-15T00:00:00Z","closed_at":"2025-09-18T17:13:14Z"},"comments":18,"created_at":"2025-03-12T22:05:07Z","updated_at":"2025-11-02T22:58:25Z","closed_at":"2025-04-30T21:54:57Z","assignee":null,"author_association":"MEMBER","issue_field_values":[],"type":null,"active_lock_reason":null,"draft":false,"pull_request":{"url":"https://api.github.com/repos/godotengine/godot/pulls/104055","html_url":"https://github.com/godotengine/godot/pull/104055","diff_url":"https://github.com/godotengine/godot/pull/104055.diff","patch_url":"https://github.com/godotengine/godot/pull/104055.patch","merged_at":"2025-04-30T21:54:57Z"},"body":"This is a high performance `Vector`-like object. In practice, we can use it to reduce the number of per-frame allocations throughout Godot.\r\n\r\nIn particular, `FixedVector` is useful if the maximum number of objects is small and known, and the objects are needed only temporarily. It could also be used to return a small, uncertain number of objects from a function in a performant fashion if the maximum is known.\r\n\r\nThe class can be expanded with more useful functions in the future as needed.\r\n\r\n## Comparisons\r\n`FixedVector` is designed to be as easily exchangeable for [`Vector`](https://github.com/godotengine/godot/blob/master/core/templates/vector.h) and [`LocalVector`](https://github.com/godotengine/godot/blob/master/core/templates/local_vector.h) as possible. This can be most easily achieved through [`Span`](https://github.com/godotengine/godot/blob/master/core/templates/span.h) interfaces.\r\n\r\n`FixedVector` is similar to 3.x' [`FixedArray`](https://github.com/godotengine/godot/blob/3.x/core/fixed_array.h), but some decisions about its design are different.\r\n`FixedVector` is similar to [`std::array`](https://en.cppreference.com/w/cpp/container/array), but it supports adding and removing objects, and a number of other goodies (like conversion to `Span`).\r\n`FixedVector` is somewhat similar to [`StringBuffer`](https://github.com/godotengine/godot/blob/master/core/string/string_buffer.h), but focuses on being a general purpose collection and does not support arbitrary expansion into the heap.","closed_by":{"login":"Repiteo","id":17489292,"node_id":"MDQ6VXNlcjE3NDg5Mjky","avatar_url":"https://avatars.githubusercontent.com/u/17489292?v=4","gravatar_id":"","url":"https://api.github.com/users/Repiteo","html_url":"https://github.com/Repiteo","followers_url":"https://api.github.com/users/Repiteo/followers","following_url":"https://api.github.com/users/Repiteo/following{/other_user}","gists_url":"https://api.github.com/users/Repiteo/gists{/gist_id}","starred_url":"https://api.github.com/users/Repiteo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Repiteo/subscriptions","organizations_url":"https://api.github.com/users/Repiteo/orgs","repos_url":"https://api.github.com/users/Repiteo/repos","events_url":"https://api.github.com/users/Repiteo/events{/privacy}","received_events_url":"https://api.github.com/users/Repiteo/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/104055/reactions","total_count":15,"+1":7,"-1":0,"laugh":0,"hooray":4,"confused":0,"heart":0,"rocket":0,"eyes":4},"timeline_url":"https://api.github.com/repos/godotengine/godot/issues/104055/timeline","performed_via_github_app":null,"state_reason":null}