[{"id":3366508826,"node_id":"PRR_kwDOAO6SJc7IqNka","user":{"login":"Calinou","id":180032,"node_id":"MDQ6VXNlcjE4MDAzMg==","avatar_url":"https://avatars.githubusercontent.com/u/180032?u=68d23e7ee9cdf810da125e8510b72f845b9dccc8&v=4","gravatar_id":"","url":"https://api.github.com/users/Calinou","html_url":"https://github.com/Calinou","followers_url":"https://api.github.com/users/Calinou/followers","following_url":"https://api.github.com/users/Calinou/following{/other_user}","gists_url":"https://api.github.com/users/Calinou/gists{/gist_id}","starred_url":"https://api.github.com/users/Calinou/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Calinou/subscriptions","organizations_url":"https://api.github.com/users/Calinou/orgs","repos_url":"https://api.github.com/users/Calinou/repos","events_url":"https://api.github.com/users/Calinou/events{/privacy}","received_events_url":"https://api.github.com/users/Calinou/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"Tested locally, it works as expected.\r\n\r\n<img width=\"248\" height=\"48\" alt=\"image\" src=\"https://github.com/user-attachments/assets/92b4a440-a7a5-457b-9c82-9d8afba8cddb\" />\r\n\r\nHowever, the icon does not use the \"pointer\" mouse cursor like the link does. This should be fixed using `set_custom_cursor_shape()` on the TextureButton node. Also, the TextureButton should have its focus mode set to None so it can't be focused with the keyboard.\r\n\r\nPS: I'm curious as to why a Button with no text couldn't be used, as this would provide hover/pressed feedback. To me, it seems like a better choice than TextureButton here (which we don't have a lot of uses for in the editor).","state":"CHANGES_REQUESTED","html_url":"https://github.com/godotengine/godot/pull/111281#pullrequestreview-3366508826","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/111281","author_association":"MEMBER","_links":{"html":{"href":"https://github.com/godotengine/godot/pull/111281#pullrequestreview-3366508826"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/111281"}},"submitted_at":"2025-10-22T16:04:52Z","commit_id":"e9b2d001d14c49cbe8678ff4bd3941818c539403"}]