[{"id":2708018495,"node_id":"PRR_kwDOAO6SJc6haRU_","user":{"login":"kleonc","id":9283098,"node_id":"MDQ6VXNlcjkyODMwOTg=","avatar_url":"https://avatars.githubusercontent.com/u/9283098?u=a04daf8c4d579b733ac46d2e4d17324cca7870c0&v=4","gravatar_id":"","url":"https://api.github.com/users/kleonc","html_url":"https://github.com/kleonc","followers_url":"https://api.github.com/users/kleonc/followers","following_url":"https://api.github.com/users/kleonc/following{/other_user}","gists_url":"https://api.github.com/users/kleonc/gists{/gist_id}","starred_url":"https://api.github.com/users/kleonc/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/kleonc/subscriptions","organizations_url":"https://api.github.com/users/kleonc/orgs","repos_url":"https://api.github.com/users/kleonc/repos","events_url":"https://api.github.com/users/kleonc/events{/privacy}","received_events_url":"https://api.github.com/users/kleonc/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"Current docs are indeed misleading, the code ensures `current_scene` is a direct child of `root`. The docs were changed like that in #68649 (cc @Mickeon).\r\n\r\nSo the docs needs to be fixed, not the behavior. Note that changing the behavior could break some assumptions of other existing code (including user code). Besides, AFAIK, no one reported that setting `current_scene` to a non-`root`-child doesn't work, which would mean no one really needs such behavior in the first place. But if being able to do so is desired then it should be requested in a [proposal](https://github.com/godotengine/godot-proposals).","state":"CHANGES_REQUESTED","html_url":"https://github.com/godotengine/godot/pull/104459#pullrequestreview-2708018495","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/104459","author_association":"MEMBER","_links":{"html":{"href":"https://github.com/godotengine/godot/pull/104459#pullrequestreview-2708018495"},"pull_request":{"href":"https