 to `TextEdit` and `CodeEdit`.\r\n\r\n- Tap (press -> release): positions the cursor and opens the virtual keyboard.\r\n- Drag (press -> drag -> release): scrolls the text content, including inertial scrolling support.\r\n- Text selection:\r\n    - Double-tap selects a word.\r\n    - Double-tap, hold, and drag selects the portion you're hovering over.\r\n    - Basic selection handle support has also been added and additional improvements like a context panel would be done in a follow-up.\r\n- Added drag-scrolling support to the code completion popup. Previously, it could not be scrolled using touch input. See https://github.com/godotengine/godot/pull/119706#issuecomment-4691322370\r\n\r\nhttps://github.com/user-attachments/assets/66779249-6759-432f-8ed2-860c380b795c\r\n\r\n","labels":[{"id":73330066,"node_id":"MDU6TGFiZWw3MzMzMDA2Ng==","url":"https://api.github.com/repos/godotengine/godot/labels/enhancement","name":"enhancement","description":"","color":"aaccff","default":true,"archived_at":null,"archived_by":null},{"id":279097519,"node_id":"MDU6TGFiZWwyNzkwOTc1MTk=","url":"https://api.github.com/repos/godotengine/godot/labels/platform:ios","name":"platform:ios","description":"","color":"e4e4e4","default":false,"archived_at":null,"archived_by":null},{"id":279097562,"node_id":"MDU6TGFiZWwyNzkwOTc1NjI=","url":"https://api.github.com/repos/godotengine/godot/labels/platform:android","name":"platform:android","description":"","color":"e4e4e4","default":false,"archived_at":null,"archived_by":null},{"id":890310664,"node_id":"MDU6TGFiZWw4OTAzMTA2NjQ=","url":"https://api.github.com/repos/godotengine/godot/labels/topic:input","name":"topic:input","description":"","color":"ffee88","default":false,"archived_at":null,"archived_by":null},{"id":1732720779,"node_id":"MDU6TGFiZWwxNzMyNzIwNzc5","url":"https://api.github.com/repos/godotengine/godot/labels/topic:gui","name":"topic:gui","description":"","color":"ffee88","default":false,"archived_at":null,"archived_by":null}],"milestone"