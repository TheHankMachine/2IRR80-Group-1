ub.com/users/akien-mga/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-06-13T22:03:50Z","updated_at":"2025-06-13T22:04:00Z","body":"Thanks! Awesome improvement!","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2971826986/reactions","total_count":11,"+1":0,"-1":0,"laugh":0,"hooray":3,"confused":0,"heart":1,"rocket":7,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2991603014","html_url":"https://github.com/godotengine/godot/pull/107254#issuecomment-2991603014","issue_url":"https://api.github.com/repos/godotengine/godot/issues/107254","id":2991603014,"node_id":"IC_kwDOAO6SJc6yUD1G","user":{"login":"vinpix","id":76024897,"node_id":"MDQ6VXNlcjc2MDI0ODk3","avatar_url":"https://avatars.githubusercontent.com/u/76024897?v=4","gravatar_id":"","url":"https://api.github.com/users/vinpix","html_url":"https://github.com/vinpix","followers_url":"https://api.github.com/users/vinpix/followers","following_url":"https://api.github.com/users/vinpix/following{/other_user}","gists_url":"https://api.github.com/users/vinpix/gists{/gist_id}","starred_url":"https://api.github.com/users/vinpix/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/vinpix/subscriptions","organizations_url":"https://api.github.com/users/vinpix/orgs","repos_url":"https://api.github.com/users/vinpix/repos","events_url":"https://api.github.com/users/vinpix/events{/privacy}","received_events_url":"https://api.github.com/users/vinpix/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-06-20T13:16:25Z","updated_at":"2025-06-20T13:16:25Z","body":"Am I the only one who thinks these 'light leaks' actually make the scene look better? 😅 The soft shadows at geometry intersections could work as a nice alternative to SSAO, especially on mobile where SSAO is quite expens