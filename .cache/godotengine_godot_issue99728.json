l},{"id":279098255,"node_id":"MDU6TGFiZWwyNzkwOTgyNTU=","url":"https://api.github.com/repos/godotengine/godot/labels/topic:platforms","name":"topic:platforms","color":"ffee88","default":false,"description":"","archived_at":null,"archived_by":null},{"id":3240950060,"node_id":"MDU6TGFiZWwzMjQwOTUwMDYw","url":"https://api.github.com/repos/godotengine/godot/labels/performance","name":"performance","color":"447777","default":false,"description":"","archived_at":null,"archived_by":null}],"state":"closed","locked":false,"assignees":[],"milestone":{"url":"https://api.github.com/repos/godotengine/godot/milestones/20","html_url":"https://github.com/godotengine/godot/milestone/20","labels_url":"https://api.github.com/repos/godotengine/godot/milestones/20/labels","id":10558797,"node_id":"MI_kwDOAO6SJc4AoR1N","number":20,"title":"4.4","description":"","creator":{"login":"akien-mga","id":4701338,"node_id":"MDQ6VXNlcjQ3MDEzMzg=","avatar_url":"https://avatars.githubusercontent.com/u/4701338?v=4","gravatar_id":"","url":"https://api.github.com/users/akien-mga","html_url":"https://github.com/akien-mga","followers_url":"https://api.github.com/users/akien-mga/followers","following_url":"https://api.github.com/users/akien-mga/following{/other_user}","gists_url":"https://api.github.com/users/akien-mga/gists{/gist_id}","starred_url":"https://api.github.com/users/akien-mga/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/akien-mga/subscriptions","organizations_url":"https://api.github.com/users/akien-mga/orgs","repos_url":"https://api.github.com/users/akien-mga/repos","events_url":"https://api.github.com/users/akien-mga/events{/privacy}","received_events_url":"https://api.github.com/users/akien-mga/received_events","type":"User","user_view_type":"public","site_admin":false},"open_issues":8,"closed_issues":4466,"state":"closed","created_at":"2024-02-14T11:52:07Z","updated_at":"2026-10-05T23:48:31Z","due_on":"2025-03-03T00:00:00Z","closed_at":"2025-03-19T09:35:35Z"},"comments":8,"created_at":"2024-11-26T23:31:04Z","updated_at":"2024-12-02T20:44:04Z","closed_at":"2024-11-29T21:56:08Z","assignee":null,"author_association":"MEMBER","issue_field_values":[],"type":null,"active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"### Tested versions\n\n- Reproducible in: 4.3.stable, 4.4.dev5\n\n### System information\n\nGodot v4.3.stable - Windows 10.0.22631 - Vulkan (Forward+) - dedicated NVIDIA GeForce RTX 4090 (NVIDIA; 32.0.15.6603) - 13th Gen Intel(R) Core(TM) i9-13900K (32 Threads)\n\n### Issue description\n\n`Engine.max_fps` has bad frame pacing due to inaccurate OS sleep functions. This means the built-in FPS limiter isn't as stable as external solutions such as RTSS or Special K can be. This in turn leads to a bad player experience.\n\nThis is most noticeable on Windows where its sleep functions are known to be inaccurate compared to other operating systems. Nonetheless, even on other OSes, frametime graphs aren't quite a flat line even when the CPU and GPU are far from being fully utilized.\n\nPossible avenues for improving this include:\n\n- Perform hybrid busywaiting and sleeping, so we get more precise sleep durations but without increasing CPU utilization too much.\n- On Windows 10 1803 and later, use `CREATE_WAITABLE_TIMER_HIGH_RESOLUTION ` as mentioned in https://blog.bearcats.nl/perfect-sleep-function/.\n\nWith good frame pacing, the graph should look like this:\n\n![Screenshot 2024-11-16 154908](https://github.com/user-attachments/assets/b19753cf-f70e-49f0-b399-57f6a94e1fb5)\n\nBut in `master`, it looks like this instead:\n\n![Screenshot 2024-11-16 154705](https://github.com/user-attachments/assets/bb5001f6-8df0-48d9-a4ec-939284322d42)\n\nSee https://github.com/godotengine/godot/pull/99178 and https://github.com/godotengine/godot/pull/99656.\n\n### Steps to reproduce\n\nRun the MRP and look at the frametime graph with various `Engine.max_fps` values.\n\n### Minimal reproduction project (MRP)\n\n[test-frame-pacing.zip](https://github.com/user-attachments/files/17786922/test-frame-pacing.zip)","closed_by":{"login":"akien-mga","id":4701338,"node_id":"MDQ6VXNlcjQ3MDEzMzg=","avatar_url":"https://avatars.githubusercontent.com/u/4701338?v=4","gravatar_id":"","url":"https://api.github.com/users/akien-mga","html_url":"https://github.com/akien-mga","followers_url":"https://api.github.com/users/akien-mga/followers","following_url":"https://api.github.com/users/akien-mga/following{/other_user}","gists_url":"https://api.github.com/users/akien-mga/gists{/gist_id}","starred_url":"https://api.github.com/users/akien-mga/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/akien-mga/subscriptions","organizations_url":"https://api.github.com/users/akien-mga/orgs","repos_url":"https://api.github.com/users/akien-mga/repos","events_url":"https://api.github.com/users/akien-mga/events{/privacy}","received_events_url":"https://api.github.com/users/akien-mga/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/99728/reactions","total_count":7,"+1":7,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/godotengine/godot/issues/99728/timeline","performed_via_github_app":null,"state_reason":"completed","pinned_comment":null}