[{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2810898321","html_url":"https://github.com/godotengine/godot/issues/105466#issuecomment-2810898321","issue_url":"https://api.github.com/repos/godotengine/godot/issues/105466","id":2810898321,"node_id":"IC_kwDOAO6SJc6niueR","user":{"login":"Calinou","id":180032,"node_id":"MDQ6VXNlcjE4MDAzMg==","avatar_url":"https://avatars.githubusercontent.com/u/180032?v=4","gravatar_id":"","url":"https://api.github.com/users/Calinou","html_url":"https://github.com/Calinou","followers_url":"https://api.github.com/users/Calinou/followers","following_url":"https://api.github.com/users/Calinou/following{/other_user}","gists_url":"https://api.github.com/users/Calinou/gists{/gist_id}","starred_url":"https://api.github.com/users/Calinou/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Calinou/subscriptions","organizations_url":"https://api.github.com/users/Calinou/orgs","repos_url":"https://api.github.com/users/Calinou/repos","events_url":"https://api.github.com/users/Calinou/events{/privacy}","received_events_url":"https://api.github.com/users/Calinou/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-04-16T21:53:25Z","updated_at":"2025-04-16T23:46:49Z","body":"Don't use VRR on the Godot editor to avoid this issue. NVIDIA G-Sync is only enabled by default on fullscreen games by default for this reason, and we use a NVIDIA profile to disable it in windowed mode. Unfortunately, AMD has no equivalent API for us to use.","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2810898321/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":{"reason":"outdated"}},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2810913315","html_url":"https://github.com/godotengine/godot/issues/105466#issuecomment-2810913315","issue_url":"https://api.github.com/repos/godotengine/godot/issues/105466","id":2810913315,"node_id":"IC_kwDOAO6SJc6niyIj","user":{"login":"WrobotGames","id":66079814,"node_id":"MDQ6VXNlcjY2MDc5ODE0","avatar_url":"https://avatars.githubusercontent.com/u/66079814?v=4","gravatar_id":"","url":"https://api.github.com/users/WrobotGames","html_url":"https://github.com/WrobotGames","followers_url":"https://api.github.com/users/WrobotGames/followers","following_url":"https://api.github.com/users/WrobotGames/following{/other_user}","gists_url":"https://api.github.com/users/WrobotGames/gists{/gist_id}","starred_url":"https://api.github.com/users/WrobotGames/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/WrobotGames/subscriptions","organizations_url":"https://api.github.com/users/WrobotGames/orgs","repos_url":"https://api.github.com/users/WrobotGames/repos","events_url":"https://api.github.com/users/WrobotGames/events{/privacy}","received_events_url":"https://api.github.com/users/WrobotGames/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-04-16T22:01:55Z","updated_at":"2025-04-16T22:01:55Z","body":"This happens in an exported game as well, though, even in exclusive full-screen. VRR isn't really the issue either, it is just when I enable the DRR in the windows settings the editor, and exported games start stuttering. Using VRR without DRR is no problem.\n\nI'll check how this works on nvidia when I get back to my pc in a few days. ","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2810913315/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2811156802","html_url":"https://github.com/godotengine/godot/issues/105466#issuecomment-2811156802","issue_url":"https://api.github.com/repos/godotengine/godot/issues/105466","id":2811156802,"node_id":"IC_kwDOAO6SJc6njtlC","user":{"login":"Calinou","id":180032,"node_id":"MDQ6VXNlcjE4MDAzMg==","avatar_url":"https://avatars.githubusercontent.com/u/180032?v=4","gravatar_id":"","url":"https://api.github.com/users/Calinou","html_url":"https://github.com/Calinou","followers_url":"https://api.github.com/users/Calinou/followers","following_url":"https://api.github.com/users/Calinou/following{/other_user}","gists_url":"https://api.github.com/users/Calinou/gists{/gist_id}","starred_url":"https://api.github.com/users/Calinou/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Calinou/subscriptions","organizations_url":"https://api.github.com/users/Calinou/orgs","repos_url":"https://api.github.com/users/Calinou/repos","events_url":"https://api.github.com/users/Calinou/events{/privacy}","received_events_url":"https://api.github.com/users/Calinou/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-04-16T23:46:03Z","updated_at":"2025-04-16T23:47:20Z","body":"Can you reproduce this after switching `rendering_driver/name.windows` to `d3d12` in the Project Settings, then restarting the editor? Also check if you can reproduce this after switching to the Compatibility rendering method.\n\nLastly, try setting **Vsync Mode** to Disabled in the Editor Settings.","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2811156802/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2813865399","html_url":"https://github.com/godotengine/godot/issues/105466#issuecomment-2813865399","issue_url":"https://api.github.com/repos/godotengine/godot/issues/105466","id":2813865399,"node_id":"IC_kwDOAO6SJc6nuC23","user":{"login":"WrobotGames","id":66079814,"node_id":"MDQ6VXNlcjY2MDc5ODE0","avatar_url":"https://avatars.githubusercontent.com/u/66079814?v=4","gravatar_id":"","url":"https://api.github.com/users/WrobotGames","html_url":"https://github.com/WrobotGames","followers_url":"https://api.github.com/users/WrobotGames/followers","following_url":"https://api.github.com/users/WrobotGames/following{/other_user}","gists_url":"https://api.github.com/users/WrobotGames/gists{/gist_id}","starred_url":"https://api.github.com/users/WrobotGames/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/WrobotGames/subscriptions","organizations_url":"https://api.github.com/users/WrobotGames/orgs","repos_url":"https://api.github.com/users/WrobotGames/repos","events_url":"https://api.github.com/users/WrobotGames/events{/privacy}","received_events_url":"https://api.github.com/users/WrobotGames/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-04-17T19:43:20Z","updated_at":"2025-04-17T19:43:20Z","body":"I can confirm that this issue also exists on nvidia gpu's, in DirectX 12 and without vsync. It feels less buggy though without vsync, as Godot doesn't try to cap the frame-rate anymore, but the stutters are still there. (On a side note, DRR feels really bad in the entirety of windows on desktop, almost everything lags.)\n\nIt also stutters in compatibility mode, but this does not show up in the profiler when not using vsync. When using vsync the profiler looks like this: \n![Image](https://github.com/user-attachments/assets/4f49764a-87a0-48e9-839d-7cc7835c82f3)\n\nI have checked other game engines and unreal also does not perform well either, it basically locks the game to the lower refresh rate, meanwhile unity does not seem to have any issues, even though the game I tried hasn't been updated in years. \n\nIf there is no easy way to solve this, like some windows api forcing the highest refresh-rate, I don't think a lot of time should be spend on solving this, as this is a fairly obscure issue and other games suffer as well.\n\n","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2813865399/reactions","total_count":2,"+1":2,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2854497670","html_url":"https://github.com/godotengine/godot/issues/105466#issuecomment-2854497670","issue_url":"https://api.github.com/repos/godotengine/godot/issues/105466","id":2854497670,"node_id":"IC_kwDOAO6SJc6qJC2G","user":{"login":"andrebrait","id":5734074,"node_id":"MDQ6VXNlcjU3MzQwNzQ=","avatar_url":"https://avatars.githubusercontent.com/u/5734074?v=4","gravatar_id":"","url":"https://api.github.com/users/andrebrait","html_url":"https://github.com/andrebrait","followers_url":"https://api.github.com/users/andrebrait/followers","following_url":"https://api.github.com/users/andrebrait/following{/other_user}","gists_url":"https://api.github.com/users/andrebrait/gists{/gist_id}","starred_url":"https://api.github.com/users/andrebrait/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/andrebrait/subscriptions","organizations_url":"https://api.github.com/users/andrebrait/orgs","repos_url":"https://api.github.com/users/andrebrait/repos","events_url":"https://api.github.com/users/andrebrait/events{/privacy}","received_events_url":"https://api.github.com/users/andrebrait/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-05-06T13:02:54Z","updated_at":"2025-05-06T13:02:54Z","body":"Well, I also experience stuttering on the desktop with DRR enabled (NVIDIA RTX 5070 Ti on an Ryzen 9 5800X3D here), so I'm pretty sure it's not engine-specific.","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2854497670/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null}]