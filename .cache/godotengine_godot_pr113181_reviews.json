pulls/113181"}},"submitted_at":"2025-11-28T03:55:59Z","commit_id":null},{"id":3532372538,"node_id":"PRR_kwDOAO6SJc7Si7o6","user":{"login":"Calinou","id":180032,"node_id":"MDQ6VXNlcjE4MDAzMg==","avatar_url":"https://avatars.githubusercontent.com/u/180032?u=68d23e7ee9cdf810da125e8510b72f845b9dccc8&v=4","gravatar_id":"","url":"https://api.github.com/users/Calinou","html_url":"https://github.com/Calinou","followers_url":"https://api.github.com/users/Calinou/followers","following_url":"https://api.github.com/users/Calinou/following{/other_user}","gists_url":"https://api.github.com/users/Calinou/gists{/gist_id}","starred_url":"https://api.github.com/users/Calinou/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Calinou/subscriptions","organizations_url":"https://api.github.com/users/Calinou/orgs","repos_url":"https://api.github.com/users/Calinou/repos","events_url":"https://api.github.com/users/Calinou/events{/privacy}","received_events_url":"https://api.github.com/users/Calinou/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"Tested locally, it works as expected. Code looks good to me.\r\n\r\n<img width=\"2214\" height=\"1039\" alt=\"image\" src=\"https://github.com/user-attachments/assets/6c2df1ad-20c0-4af8-abfb-21d9a4ef03fc\" />\r\n\r\nI think we could allow moving it to a side dock if we automatically disable the minimap and file list while it's in a side dock. https://github.com/godotengine/godot/pull/113230 would also need to be merged to reduce the gutter's width.\r\n\r\nAlso, the **Make Floating** button in the general dock editor no longer has a screen selector like the old one had. For multi-monitor setups, this means you now need to move the shader editor window manually after making it floating. In the future, we should reintroduce a screen selector in the general dock editor to avoid regressing usability on this front.\r\n\r\nPS: I wonder if people will be looking for the old **Make Floating** button now that it's been removed. The new way to do it is arguably harder to discover (3 vertical dots at the right of the bottom panel). Should we keep the existing button available during 1 minor version as a transition period, with a toast explaining the new way to make the shader editor floating?","state":"COMMENTED","html_url":"https://github.com/godotengine/godot/pull/113181#pullrequestreview-3532372538","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/113181","author_association":"MEMBER","_links":{"html":{"href":"https://github.com/godotengine/godot/pull/113181#pullrequestreview-3532372538"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/113181"}},"submitted_at":"2025-12-02T22:42:56Z","commit_id":"0d83637853218127a5ec81a2bad7825dfc0c3885"}]