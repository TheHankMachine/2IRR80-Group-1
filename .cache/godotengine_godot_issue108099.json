_at":null,"archived_by":null},{"id":1732720779,"node_id":"MDU6TGFiZWwxNzMyNzIwNzc5","url":"https://api.github.com/repos/godotengine/godot/labels/topic:gui","name":"topic:gui","color":"ffee88","default":false,"description":"","archived_at":null,"archived_by":null}],"state":"open","locked":false,"assignees":[],"milestone":{"url":"https://api.github.com/repos/godotengine/godot/milestones/16","html_url":"https://github.com/godotengine/godot/milestone/16","labels_url":"https://api.github.com/repos/godotengine/godot/milestones/16/labels","id":8237783,"node_id":"MI_kwDOAO6SJc4AfbLX","number":16,"title":"4.x","description":"Issues and pull requests slated for an undetermined Godot 4 release.","creator":{"login":"akien-mga","id":4701338,"node_id":"MDQ6VXNlcjQ3MDEzMzg=","avatar_url":"https://avatars.githubusercontent.com/u/4701338?v=4","gravatar_id":"","url":"https://api.github.com/users/akien-mga","html_url":"https://github.com/akien-mga","followers_url":"https://api.github.com/users/akien-mga/followers","following_url":"https://api.github.com/users/akien-mga/following{/other_user}","gists_url":"https://api.github.com/users/akien-mga/gists{/gist_id}","starred_url":"https://api.github.com/users/akien-mga/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/akien-mga/subscriptions","organizations_url":"https://api.github.com/users/akien-mga/orgs","repos_url":"https://api.github.com/users/akien-mga/repos","events_url":"https://api.github.com/users/akien-mga/events{/privacy}","received_events_url":"https://api.github.com/users/akien-mga/received_events","type":"User","user_view_type":"public","site_admin":false},"open_issues":5793,"closed_issues":0,"state":"open","created_at":"2022-07-26T12:42:05Z","updated_at":"2026-10-22T14:39:14Z","due_on":null,"closed_at":null},"comments":16,"created_at":"2025-06-29T04:09:53Z","updated_at":"2026-02-17T20:10:24Z","closed_at":null,"assignee":null,"author_association":"CONTRIBUTOR","issue_field_values":[],"type":null,"active_lock_reason":null,"draft":false,"pull_request":{"url":"https://api.github.com/repos/godotengine/godot/pulls/108099","html_url":"https://github.com/godotengine/godot/pull/108099","diff_url":"https://github.com/godotengine/godot/pull/108099.diff","patch_url":"https://github.com/godotengine/godot/pull/108099.patch","merged_at":null},"body":"This PR restructures the graph system for friendlier usage and greater flexibility.\r\n- Introduce `GraphPort`, a generic `GraphElement` to which connections can be made.\r\n- Split `GraphNode` into two nodes: `GraphNodeIndexed`, which inherits the current `GraphNode` behaviour of associating children with slots and generating+placing `GraphPort`s automatically, and `GraphNode`, a base class designed for the flexible creation of nodes that contain ports.\r\n- Introduce `GraphConnection`, a resource representing connections between `GraphPort`s in a `GraphEdit`.\r\n\r\nResolves https://github.com/godotengine/godot-proposals/issues/12207 - read the description there for more details.\r\n\r\nhttps://github.com/user-attachments/assets/e5105b7c-5745-4c90-81f0-74f33d58678f\r\n\r\n\r\nNotably, this implementation does not overhaul `VisualShader` or `VisualShaderNode`. I believe a future PR that overhauls the visual shader system in parallel would be a good idea, but for this PR, changes will be relegated to `VisualShaderNodePlugin` and seek to maintain compatibility as much as possible.\r\n\r\nTODO:\r\n- [x] Fix ~~so many~~ regressions and bugs\r\n- [x] Ensure back-compatibility with visual shaders\r\n- [x] Documentation\r\n- [x] Improve keyboard navigation and accessibility features\r\n- [ ] ~~Compatibility~~\r\n- [ ] ~~Associate slots with nested children of `GraphNodeIndexed`~~\r\n\r\nEdit 7/20/25: With GraphPort being an independent node, tracking nested children with `GraphNodeIndexed` slots has proven somewhat unnecessary. This could be reintroduced in a separate PR, if someone has need of it.\r\nEdit 8/5/25: Certain aspects of this PR break compatibility beyond what I can handle. I'm going forward with the assumption that this will fully break compat. GraphShaders will still work as expected.","closed_by":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/108099/reactions","total_count":30,"+1":0,"-1":0,"laugh":0,"hooray":16,"confused":0,"heart":0,"rocket":0,"eyes":14},"timeline_url":"https://api.github.com/repos/godotengine/godot/issues/108099/timeline","performed_via_github_app":null,"state_reason":null}