hived_by":null}],"state":"closed","locked":false,"assignees":[],"milestone":{"url":"https://api.github.com/repos/godotengine/godot/milestones/22","html_url":"https://github.com/godotengine/godot/milestone/22","labels_url":"https://api.github.com/repos/godotengine/godot/milestones/22/labels","id":12070367,"node_id":"MI_kwDOAO6SJc4AuC3f","number":22,"title":"4.5","description":"","creator":{"login":"Sauermann","id":6299227,"node_id":"MDQ6VXNlcjYyOTkyMjc=","avatar_url":"https://avatars.githubusercontent.com/u/6299227?v=4","gravatar_id":"","url":"https://api.github.com/users/Sauermann","html_url":"https://github.com/Sauermann","followers_url":"https://api.github.com/users/Sauermann/followers","following_url":"https://api.github.com/users/Sauermann/following{/other_user}","gists_url":"https://api.github.com/users/Sauermann/gists{/gist_id}","starred_url":"https://api.github.com/users/Sauermann/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Sauermann/subscriptions","organizations_url":"https://api.github.com/users/Sauermann/orgs","repos_url":"https://api.github.com/users/Sauermann/repos","events_url":"https://api.github.com/users/Sauermann/events{/privacy}","received_events_url":"https://api.github.com/users/Sauermann/received_events","type":"User","user_view_type":"public","site_admin":false},"open_issues":3,"closed_issues":3687,"state":"closed","created_at":"2024-12-19T08:51:28Z","updated_at":"2026-09-04T21:48:38Z","due_on":"2025-09-15T00:00:00Z","closed_at":"2025-09-18T17:13:14Z"},"comments":6,"created_at":"2025-04-07T18:01:02Z","updated_at":"2025-04-09T23:19:20Z","closed_at":"2025-04-09T23:18:13Z","assignee":null,"author_association":"NONE","issue_field_values":[],"type":null,"active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"### Tested versions\n\nIn\nv4.4.1.stable.official [49a5bc7b6]\nv4.4.stable.official [4c311cbee]\n\n### System information\n\nGodot v4.4.1.stable - SparkyLinux 8 (Seven-Sisters) 8 on X11 - X11 display driver, Multi-window, 1 monitor - OpenGL 3 (Compatibility) - NVIDIA GeForce RTX 3080 (nvidia) - AMD Ryzen 5 5600X 6-Core Processor (12 threads)\n\n### Issue description\n\n`Window` class `files_dropped` signal return PackedStringArray of the dropped file path, BUT replaces the plus `+` character with a space, making the path invalid.\n\nI assume it might because of URL-like parsing but in some case having a plus symbol in files and dirrectories is common (e.g. `lost+found` linux directory, a file named for its extended thing, the notepad++ app, etc) so replacing it with space is not the expected behavior.\n\nI expect it doesnt do that, for now i have to rename all the to-be-dropped files to remove the plus character.\n\n### Steps to reproduce\n\n+ Make a directory named\n```\ndir_!@#$%^&*()_+{}[].,;?'|`~\n```\n+ Make a file inside it named\n```\nfile_!@#$%^&*()_+{}[].,;?'|`~\n```\n+ Have a code that do something like:\n```gdscript\nextends Node\n\nfunc _ready():\n\tget_window().files_dropped.connect(on_files_dropped)\n\nfunc on_files_dropped(files):\n\tprint(files)\n```\n+ Drop the said file\n+ It will output:\n```\n[\"/media/game/dir_!@#$%^&*()_ {}[].,;?\\'|`~/file_!@#$%^&*()_ {}[].,;?\\'|`~\"]\n```\n+ Whereas it should be more like:\n```\n[\"/media/game/dir_!@#$%^&*()_+{}[].,;?\\'|`~/file_!@#$%^&*()_+{}[].,;?\\'|`~\"]\n```\n\n_(Oh, i just noticed it escapes the single tick `'` but maybe thats for another issue)_\n\n### Minimal reproduction project (MRP)\n\nMRP for 4.4.1\n[issue_drop_path.zip](https://github.com/user-attachments/files/19636971/issue_drop_path.zip)","closed_by":{"login":"Repiteo","id":17489292,"node_id":"MDQ6VXNlcjE3NDg5Mjky","avatar_url":"https://avatars.githubusercontent.com/u/17489292?v=4","gravatar_id":"","url":"https://api.github.com/users/Repiteo","html_url":"https://github.com/Repiteo","followers_url":"https://api.github.com/users/Repiteo/followers","following_url":"https://api.github.com/users/Repiteo/following{/other_user}","gists_url":"https://api.github.com/users/Repiteo/gists{/gist_id}","starred_url":"https://api.github.com/users/Repiteo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Repiteo/subscriptions","organizations_url":"https://api.github.com/users/Repiteo/orgs","repos_url":"https://api.github.com/users/Repiteo/repos","events_url":"https://api.github.com/users/Repiteo/events{/privacy}","received_events_url":"https://api.github.com/users/Repiteo/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/105128/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/godotengine/godot/issues/105128/timeline","performed_via_github_app":null,"state_reason":"completed","pinned_comment":null}