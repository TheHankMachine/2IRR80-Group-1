vatars.githubusercontent.com/u/6501975?v=4","gravatar_id":"","url":"https://api.github.com/users/rsubtil","html_url":"https://github.com/rsubtil","followers_url":"https://api.github.com/users/rsubtil/followers","following_url":"https://api.github.com/users/rsubtil/following{/other_user}","gists_url":"https://api.github.com/users/rsubtil/gists{/gist_id}","starred_url":"https://api.github.com/users/rsubtil/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/rsubtil/subscriptions","organizations_url":"https://api.github.com/users/rsubtil/orgs","repos_url":"https://api.github.com/users/rsubtil/repos","events_url":"https://api.github.com/users/rsubtil/events{/privacy}","received_events_url":"https://api.github.com/users/rsubtil/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-09-29T16:41:17Z","updated_at":"2025-09-29T16:41:17Z","body":"Bisected to 8a9409257b69d16902a902b6e6f99a3d867bf054 https://github.com/godotengine/godot/pull/103583 (cc @beicause)\n\nI'm not sure if this is a regression, because there is some logic tied to the new Intensity slider that could be causing confusion on what you're expecting. I'm also not knowledgeable enough on this topic, @beicause could you please chime in to confirm it this is indeed a bug?","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3348003231/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3348192123","html_url":"https://github.com/godotengine/godot/issues/111035#issuecomment-3348192123","issue_url":"https://api.github.com/repos/godotengine/godot/issues/111035","id":3348192123,"node_id":"IC_kwDOAO6SJc7HkVt7","user":{"login":"Pixelmusement","id":78319361,"node_id":"MDQ6VXNlcjc4MzE5MzYx","avatar_url":"https://avatars.githubusercontent.com/u/78319361?v=4","gravatar_id":"","url":"https://api.github.com/users/Pixelmusement","html_url":"https://github.com/Pixelmusement","followers_url":"https://api.github.com/users/Pixelmusement/followers","following_url":"https://api.github.com/users/Pixelmusement/following{/other_user}","gists_url":"https://api.github.com/users/Pixelmusement/gists{/gist_id}","starred_url":"https://api.github.com/users/Pixelmusement/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Pixelmusement/subscriptions","organizations_url":"https://api.github.com/users/Pixelmusement/orgs","repos_url":"https://api.github.com/users/Pixelmusement/repos","events_url":"https://api.github.com/users/Pixelmusement/events{/privacy}","received_events_url":"https://api.github.com/users/Pixelmusement/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-09-29T17:35:25Z","updated_at":"2025-09-29T17:35:25Z","body":"I should add: The tooltip when you hover the mouse over a colour value still shows the actual linear values, not the sRGB conversion, thus even if this wasn't a bug it's inconsistent behaviour since the tooltip and \"Linear\" values in the Color Picker no longer match.","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3348192123/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3348236125","html_url":"https://github.com/godotengine/godot/issues/111035#issuecomment-3348236125","issue_url":"https://api.github.com/repos/godotengine/godot/issues/111035","id":3348236125,"node_id":"IC_kwDOAO6SJc7Hkgdd","user":{"login":"beicause","id":75941842,"node_id":"MDQ6VXNlcjc1OTQxODQy","avatar_url":"https://avatars.githubusercontent.com/u/75941842?v=4","gravatar_id":"","url":"https://api.github.com/users/beicause","html_url":"https://github.com/beicause","followers_url":"https://api.github.com/users/beicause/followers","following_url":"https://api.github.com/users/beicause/following{/other_user}","gists_url":"https://api.github.com/users/beicause/gists{/gist_id}","starred_url":"https://api.github.com/users/beicause/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/beicause/subscriptions","organizations_url":"https://api.github.com/users/beicause/orgs","repos_url":"https://api.github.com/users/beicause/repos","events_url":"https://api.github.com/users/beicause/events{/privacy}","received_events_url":"https://api.github.com/users/beicause/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-09-29T17:44:44Z","updated_at":"2025-09-29T17:44:44Z","body":"This is intended, the original RAW mode has been replaced with Linear and the sliders now represents linear values (output colors are always sRGB). If you want to set sRGB values, there is RGB mode, or using the text input.","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3348236125/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3348352161","html_url":"https://github.com/godotengine/godot/issues/111035#issuecomment-3348352161","issue_url":"https://api.github.com/repos/godotengine/godot/issues/111035","id":3348352161,"node_id":"IC_kwDOAO6SJc7Hk8yh","user":{"login":"Pixelmusement","id":78319361,"node_id":"MDQ6VXNlcjc4MzE5MzYx","avatar_url":"https://avatars.githubusercontent.com/u/78319361?v=4","gravatar_id":"","url":"https://api.github.com/users/Pixelmusement","html_url":"https://github.com/Pixelmusement","followers_url":"https://api.github.com/users/Pixelmusement/followers","following_url":"https://api.github.com/users/Pixelmusement/following{/other_user}","gists_url":"https://api.github.com/users/Pixelmusement/gists{/gist_id}","starred_url":"https://api.github.com/users/Pixelmusement/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Pixelmusement/subscriptions","organizations_url":"https://api.github.com/users/Pixelmusement/orgs","repos_url":"https://api.github.com/users/Pixelmusement/repos","events_url":"https://api.github.com/users/Pixelmusement/events{/privacy}","received_events_url":"https://api.github.com/users/Pixelmusement/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-09-29T18:12:31Z","updated_at":"2025-09-29T18:12:31Z","body":"...OK, I see what's going on here. I was confusing RAW and Linear as the same thing. So yeah, THAT is not a bug...\n\n...but again, the tooltip is showing the RAW values which can no longer be adjusted directly, plus the Color(r,g,b) and Color(r,g,b,a) functions in GDScript still require RAW data, not Linear, which means you can't grab that data easily from the Color Picker itself anymore and need to rely on the tooltip which is only accurate to two decimal places.\n\nInstead, I'm going to go propose that the RAW mode be added back into the Color Picker as an additional option since it's been there for so long and it's difficult for me to work without it now.","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3348352161/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3352811755","html_url":"https://github.com/godotengine/godot/issues/111035#issuecomment-3352811755","issue_url":"https://api.github.com/repos/godotengine/godot/issues/111035","id":3352811755,"node_id":"IC_kwDOAO6SJc7H19jr","user":{"login":"allenwp","id":17506573,"node_id":"MDQ6VXNlcjE3NTA2NTcz","avatar_url":"https://avatars.githubusercontent.com/u/17506573?v=4","gravatar_id":"","url":"https://api.github.com/users/allenwp","html_url":"https://github.com/allenwp","followers_url":"https://api.github.com/users/allenwp/followers","following_url":"https://api.github.com/users/allenwp/following{/other_user}","gists_url":"https://api.github.com/users/allenwp/gists{/gist_id}","starred_url":"https://api.github.com/users/allenwp/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/allenwp/subscriptions","organizations_url":"https://api.github.com/users/allenwp/orgs","repos_url":"https://api.github.com/users/allenwp/repos","events_url":"https://api.github.com/users/allenwp/events{/privacy}","received_events_url":"https://api.github.com/users/allenwp/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-09-30T15:45:04Z","updated_at":"2025-09-30T15:47:49Z","body":"I'm double-posting my [comment from the proposal](https://github.com/godotengine/godot-proposals/issues/13302#issuecomment-3352803812) to help others who might be looking at this bug:\n\nI'm not sure if this has been mentioned yet, but the old RAW mode has been removed and replaced with the \"Expr\" text edit field. Here is a video demonstrating how to use it:\n\nhttps://github.com/user-attachments/assets/2b8783f6-3b9e-4625-bc35-2cadc49af3b8\n\nSimply press `Tab` on your keyboard to see the new colour after editing it. You can copy and paste colour values from scripts into this field for easy matching between scripts and the colour picker. I believe this covers a vast majority of the existing RAW behaviour.","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3352811755/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null}]