[{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2831751356","html_url":"https://github.com/godotengine/godot/issues/105778#issuecomment-2831751356","issue_url":"https://api.github.com/repos/godotengine/godot/issues/105778","id":2831751356,"node_id":"IC_kwDOAO6SJc6oyRi8","user":{"login":"Calinou","id":180032,"node_id":"MDQ6VXNlcjE4MDAzMg==","avatar_url":"https://avatars.githubusercontent.com/u/180032?v=4","gravatar_id":"","url":"https://api.github.com/users/Calinou","html_url":"https://github.com/Calinou","followers_url":"https://api.github.com/users/Calinou/followers","following_url":"https://api.github.com/users/Calinou/following{/other_user}","gists_url":"https://api.github.com/users/Calinou/gists{/gist_id}","starred_url":"https://api.github.com/users/Calinou/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Calinou/subscriptions","organizations_url":"https://api.github.com/users/Calinou/orgs","repos_url":"https://api.github.com/users/Calinou/repos","events_url":"https://api.github.com/users/Calinou/events{/privacy}","received_events_url":"https://api.github.com/users/Calinou/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-04-26T02:25:30Z","updated_at":"2025-04-26T02:25:58Z","body":"How did you close the project while the movie was recording? You need to close it via `get_tree().quit()` or AnimationPlayer's **Movie Quit on Finish** property. Exiting in any other way means the AVI file footer won't be written, so the file will be incomplete and some video players will reject it.\n\nThis could be fixed by writing the AVI footer in a SIGTERM signal handler, but Godot doesn't expose a way for MovieWriter to do this.","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2831751356/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_githu