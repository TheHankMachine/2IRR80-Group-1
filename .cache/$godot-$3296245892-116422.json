[{"id":3816692179,"node_id":"PRR_kwDOAO6SJc7jfhnT","state":"APPROVED","commit_id":"6e7b00e51ddd0daca002bc1266369f13b95d427e","user":{"site_admin":false,"suspended":false,"updated_at":"0001-01-01T00:00:00Z","avatar_url":"https://avatars.githubusercontent.com/u/2308167?u=f7f8e0273f784f5ec6f6b7fe4a88d449896eb48a&v=4","created_at":"0001-01-01T00:00:00Z","followers":0,"following":0,"html_url":"https://github.com/Ivorforce","id":2308167,"node_id":"MDQ6VXNlcjIzMDgxNjc=","login":"Ivorforce","type":"User","owned_private_repos":0,"public_gists":0,"public_repos":0,"total_private_repos":0,"url":"https://api.github.com/users/Ivorforce"},"body":"LGTM\r\n\r\nMay benefit from a review by someone more opinionated on the messages themselves","html_url":"https://github.com/godotengine/godot/pull/116422#pullrequestreview-3816692179","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/116422","author_association":"MEMBER","submitted_at":"2026-02-17T22:48:20Z"},{"id":3817312185,"node_id":"PRR_kwDOAO6SJc7jh4-5","state":"CHANGES_REQUESTED","commit_id":"b8f7bdf358b9428cbb66692e1ead0e1205c3a6dd","user":{"site_admin":false,"suspended":false,"updated_at":"0001-01-01T00:00:00Z","avatar_url":"https://avatars.githubusercontent.com/u/61938263?u=9b90963f1b4f17720e50bbbe495fbe8c84c8bc8e&v=4","created_at":"0001-01-01T00:00:00Z","followers":0,"following":0,"html_url":"https://github.com/TokageItLab","id":61938263,"node_id":"MDQ6VXNlcjYxOTM4MjYz","login":"TokageItLab","type":"User","owned_private_repos":0,"public_gists":0,"public_repos":0,"total_private_repos":0,"url":"https://api.github.com/users/TokageItLab"},"body":"Mathematically, INF can be included by a quaternion (Quaternion(INF, 0, 0, 1) is valid), so at least get_quaternion() should only check for NaN. However, since the current state of when normalized() with INF, results being returned with containing INF due to division by INF, and the error is detected at other function, so I assume that both INF and NaN checks are unnecessary in get_quaternion().\r\n\r\nChecking for both NaN and INF in interpolate_with() makes sense, but for consistency, other interpolation functions also need this check. However, excessive checks can lead to performance degradation with math_check. As the warning said, if https://github.com/godotengine/godot/issues/73299 is pre-orthonormalized using `orthonormalize()`, it is known that the result will contain `nan`. Therefore, it is fundamentally questionable to be an issue that needs to be resolved.","html_url":"https://github.com/godotengine/godot/pull/116422#pullrequestreview-3817312185","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/116422","author_association":"MEMBER","submitted_at":"2026-02-18T02:18:11Z"},{"id":3817360537,"node_id":"PRR_kwDOAO6SJc7jiEyZ","state":"CHANGES_REQUESTED","commit_id":"b8f7bdf358b9428cbb66692e1ead0e1205c3a6dd","user":{"site_admin":false,"suspended":false,"updated_at":"0001-01-01T00:00:00Z","avatar_url":"https://avatars.githubusercontent.com/u/61938263?u=9b90963f1b4f17720e50bbbe495fbe8c84c8bc8e&v=4","created_at":"0001-01-01T00:00:00Z","followers":0,"following":0,"html_url":"https://github.com/TokageItLab","id":61938263,"node_id":"MDQ6VXNlcjYxOTM4MjYz","login":"TokageItLab","type":"User","owned_private_repos":0,"public_gists":0,"public_repos":0,"total_private_repos":0,"url":"https://api.github.com/users/TokageItLab"},"body":"","html_url":"https://github.com/godotengine/godot/pull/116422#pullrequestreview-3817360537","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/116422","author_association":"MEMBER","submitted_at":"2026-02-18T02:39:21Z"},{"id":3817367968,"node_id":"PRR_kwDOAO6SJc7jiGmg","state":"COMMENTED","commit_id":"b8f7bdf358b9428cbb66692e1ead0e1205c3a6dd","user":{"site_admin":false,"suspended":false,"updated_at":"0001-01-01T00:00:00Z","avatar_url":"https://avatars.githubusercontent.com/u/61938263?u=9b90963f1b4f17720e50bbbe495fbe8c84c8bc8e&v=4","created_at":"0001-01-01T00:00: