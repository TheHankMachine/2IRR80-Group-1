":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/6170732126","html_url":"https://github.com/godotengine/godot/pull/123150#issuecomment-6170732126","issue_url":"https://api.github.com/repos/godotengine/godot/issues/123150","id":6170732126,"node_id":"IC_kwDOAO6SJc8AAAABb83mXg","user":{"login":"HolonProduction","id":99511741,"node_id":"U_kgDOBe5tvQ","avatar_url":"https://avatars.githubusercontent.com/u/99511741?v=4","gravatar_id":"","url":"https://api.github.com/users/HolonProduction","html_url":"https://github.com/HolonProduction","followers_url":"https://api.github.com/users/HolonProduction/followers","following_url":"https://api.github.com/users/HolonProduction/following{/other_user}","gists_url":"https://api.github.com/users/HolonProduction/gists{/gist_id}","starred_url":"https://api.github.com/users/HolonProduction/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/HolonProduction/subscriptions","organizations_url":"https://api.github.com/users/HolonProduction/orgs","repos_url":"https://api.github.com/users/HolonProduction/repos","events_url":"https://api.github.com/users/HolonProduction/events{/privacy}","received_events_url":"https://api.github.com/users/HolonProduction/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-10-14T14:29:12Z","updated_at":"2026-10-14T14:29:12Z","body":"Yeah I would prefer to handle the compiler separately. Going through a central registry ensures that there are no issues with duplicate class names. There are also a lot of unsupported cases like dynamic scripts and duplicating script resources that all might be effected by this. For completion its absolutely fine though.","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/6170732126/reactions","total_count":0,"+1":0,"-1":0,"laugh