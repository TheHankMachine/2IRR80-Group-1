vacy}","received_events_url":"https://api.github.com/users/Ivorforce/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"Actually, on second look, this is inside a for loop which assigns mipmaps separately. Reading directly from the source buffer would only be possible if the data is already in the exact correct format. Trying to figure this out is out of scope for this PR.","created_at":"2025-09-26T11:17:34Z","updated_at":"2025-09-26T11:17:34Z","html_url":"https://github.com/godotengine/godot/pull/110901#discussion_r2382048873","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/110901","_links":{"self":{"href":"https://api.github.com/repos/godotengine/godot/pulls/comments/2382048873"},"html":{"href":"https://github.com/godotengine/godot/pull/110901#discussion_r2382048873"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/110901"}},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/2382048873/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":533,"original_line":533,"side":"RIGHT","in_reply_to_id":2381307006,"author_association":"MEMBER","original_position":29,"position":203,"subject_type":"line"},{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/2383975142","pull_request_review_id":3274704868,"id":2383975142,"node_id":"PRRC_kwDOAO6SJc6OGJLm","diff_hunk":"@@ -219,12 +221,12 @@ static FfxErrorCode create_resource_rd(FfxFsr2Interface *p_backend_interface, co\n \t\tres_desc.mipCount = uint32_t(1 + std::floor(std::log2(MAX(MAX(res_desc.width, res_desc.height), res_desc.depth))));\n \t}\n \n-\tVector<PackedByteArray> initial_data;\n+\tVector<uint8_t> initial_data_vector;\n+\tFixedVector<Span<uint8_t>, 1> initial_data;","path":"servers/rendering/renderer_rd/effects/fsr2.cpp","commit_id":"6bd3fb29a458b4bc914ad221303afa8dce21a46f","original_commit_id":"6bd3fb29a458b4bc914ad221303afa8dce21a46f","user":{"login":"kiroxas","id":3176062,"node_id":"MDQ6VXNlcjMxNzYwNjI=","avatar_url":"https://avatars.githubusercontent.com/u/3176062?v=4","gravatar_id":"","url":"https://api.github.com/users/kiroxas","html_url":"https://github.com/kiroxas","followers_url":"https://api.github.com/users/kiroxas/followers","following_url":"https://api.github.com/users/kiroxas/following{/other_user}","gists_url":"https://api.github.com/users/kiroxas/gists{/gist_id}","starred_url":"https://api.github.com/users/kiroxas/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/kiroxas/subscriptions","organizations_url":"https://api.github.com/users/kiroxas/orgs","repos_url":"https://api.github.com/users/kiroxas/repos","events_url":"https://api.github.com/users/kiroxas/events{/privacy}","received_events_url":"https://api.github.com/users/kiroxas/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"Why not use a span array  directly here ? `Span<<Span<uint8_t>> initialData[1] = {}; `","created_at":"2025-09-27T07:45:56Z","updated_at":"2025-09-27T07:50:52Z","html_url":"https://github.com/godotengine/godot/pull/110901#discussion_r2383975142","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/110901","_links":{"self":{"href":"https://api.github.com/repos/godotengine/godot/pulls/comments/2383975142"},"html":{"href":"https://github.com/godotengine/godot/pull/110901#discussion_r2383975142"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/110901"}},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/2383975142/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":225,"original_line":225,"side":"RIGHT","author_association":"CONTRIBUTOR","original_position":15,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/2384246567","pull_request_review_id":3275025022,"id":2384246567,"node_id":"PRRC_kwDOAO6SJc6OHLcn","diff_hunk":"@@ -219,12 +221,12 @@ static FfxErrorCode create_resource_rd(FfxFsr2Interface *p_backend_interface, co\n \t\tres_desc.mipCount = uint32_t(1 + std::floor(std::log2(MAX(MAX(res_desc.width, res_desc.height), res_desc.depth))));\n \t}\n \n-\tVector<PackedByteArray> initial_data;\n+\tVector<uint8_t> initial_data_vector;\n+\tFixedVector<Span<uint8_t>, 1> initial_data;","path":"servers/rendering/renderer_rd/effects/fsr2.cpp","commit_id":"6bd3fb29a458b4bc914ad221303afa8dce21a46f","original_commit_id":"6bd3fb29a458b4bc914ad221303afa8dce21a46f","user":{"login":"Ivorforce","id":2308167,"node_id":"MDQ6VXNlcjIzMDgxNjc=","avatar_url":"https://avatars.githubusercontent.com/u/2308167?v=4","gravatar_id":"","url":"https://api.github.com/users/Ivorforce","html_url":"https://github.com/Ivorforce","followers_url":"https://api.github.com/users/Ivorforce/followers","following_url":"https://api.github.com/users/Ivorforce/following{/other_user}","gists_url":"https://api.github.com/users/Ivorforce/gists{/gist_id}","starred_url":"https://api.github.com/users/Ivorforce/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Ivorforce/subscriptions","organizations_url":"https://api.github.com/users/Ivorforce/orgs","repos_url":"https://api.github.com/users/Ivorforce/repos","events_url":"https://api.github.com/users/Ivorforce/events{/privacy}","received_events_url":"https://api.github.com/users/Ivorforce/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"That's a tricky one to answer.\r\nFirst of all, `Span<Span<uint8_t>> initialData[1]` is not meaningful in this context. The meaningful types are either `Span<Span<uint8_t>> initial_data` (i.e. the type of the data passed to `texture_create` directly) or `Span<uint8_t> initial_data[1]` (i.e. an actual container that can store the type of data passed to `texture_create`. Your given type has one too many dimensions.\r\n\r\nThe second example (`Span<uint8_t> initial_data[1]`) doesn't work because we need to pass an empty `Span` sometimes, and a `Span` with a single `Span` at other times. Hardcoding to `[1]` isn't an option.\r\nThe first example (`Span<Span<uint8_t>>`) _could_ work, because we can set the value to both an empty `Span`, or to a single element `Span`. But remember that `Span` cannot actually hold data. So if it is assigned to a single-element `Span`, the actual element must be stored elsewhere. It could look like this:\r\n\r\n```c++\r\nSpan<uint8_t> initial_data;\r\nSpan<Span<uint8_t>> initial_data_container{};\r\nif (...) {\r\n    initial_data = image.span();\r\n    initial_data_container = Span(&initial_data, 1);\r\n}\r\n```\r\n\r\nWhile this works, it's also a bit contrived for my taste. I have no doubt this will be obtuse black magic to inexperienced developers, and it's highly prone to errors on reformats.\r\nThe `FixedVector` version, in contrast, works like a simple `Vector` type, and can be understood by anyone who understands simple containers. Therefore, that's the version I prefer.","created_at":"2025-09-27T16:57:39Z","updated_at":"2025-09-27T16:57:39Z","html_url":"https://github.com/godotengine/godot/pull/110901#discussion_r2384246567","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/110901","_links":{"self":{"href":"https://api.github.com/repos/godotengine/godot/pulls/comments/2384246567"},"html":{"href":"https://github.com/godotengine/godot/pull/110901#discussion_r2384246567"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/110901"}},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/2384246567/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":225,"original_line":225,"side":"RIGHT","in_reply_to_id":2383975142,"author_association":"MEMBER","original_position":15,"position":1,"subject_type":"line"}]