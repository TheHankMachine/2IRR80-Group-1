chived_by":null}],"state":"closed","locked":false,"assignees":[],"milestone":{"url":"https://api.github.com/repos/godotengine/godot/milestones/22","html_url":"https://github.com/godotengine/godot/milestone/22","labels_url":"https://api.github.com/repos/godotengine/godot/milestones/22/labels","id":12070367,"node_id":"MI_kwDOAO6SJc4AuC3f","number":22,"title":"4.5","description":"","creator":{"login":"Sauermann","id":6299227,"node_id":"MDQ6VXNlcjYyOTkyMjc=","avatar_url":"https://avatars.githubusercontent.com/u/6299227?v=4","gravatar_id":"","url":"https://api.github.com/users/Sauermann","html_url":"https://github.com/Sauermann","followers_url":"https://api.github.com/users/Sauermann/followers","following_url":"https://api.github.com/users/Sauermann/following{/other_user}","gists_url":"https://api.github.com/users/Sauermann/gists{/gist_id}","starred_url":"https://api.github.com/users/Sauermann/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Sauermann/subscriptions","organizations_url":"https://api.github.com/users/Sauermann/orgs","repos_url":"https://api.github.com/users/Sauermann/repos","events_url":"https://api.github.com/users/Sauermann/events{/privacy}","received_events_url":"https://api.github.com/users/Sauermann/received_events","type":"User","user_view_type":"public","site_admin":false},"open_issues":3,"closed_issues":3687,"state":"closed","created_at":"2024-12-19T08:51:28Z","updated_at":"2026-09-04T21:48:38Z","due_on":"2025-09-15T00:00:00Z","closed_at":"2025-09-18T17:13:14Z"},"comments":6,"created_at":"2025-04-14T00:02:05Z","updated_at":"2026-02-07T12:35:00Z","closed_at":"2025-04-29T16:28:28Z","assignee":null,"author_association":"CONTRIBUTOR","issue_field_values":[],"type":null,"active_lock_reason":null,"draft":false,"pull_request":{"url":"https://api.github.com/repos/godotengine/godot/pulls/105368","html_url":"https://github.com/godotengine/godot/pull/105368","diff_url":"https://github.com/godotengine/godot/pull/105368.diff","patch_url":"https://github.com/godotengine/godot/pull/105368.patch","merged_at":"2025-04-29T16:28:28Z"},"body":"Currently, the editor supports two methods of typing dictionaries and arrays, with the `PROPERTY_HINT_ARRAY_TYPE` hint (and the dictionary alternative), and the `PROPERTY_HINT_TYPE_STRING`. These type hints have different formats, and so need to be handled separately. That being said, the inspector currently does not accept the `PROPERTY_HINT_ARRAY_TYPE` and `PROPERTY_HINT_DICTIONARY_TYPE` formats, and so does not understand the associated type hints. This leads to nodes such as the GraphEdit's type_names property not having the proper inspector editor when creating a key/value pair (instead being the general object one).\r\n\r\nFor reference; `PROPERTY_HINT_TYPE_STRING` is of the format `\"%s:%s/%s\" % [Variant::Type type, PropertyHint hint, String hint_string]`, while `PROPERTY_HINT_ARRAY_TYPE` is the human-readable class name like `\"Texture2D\"`.\r\n\r\n| Before; the add key and value are not typed: | After |\r\n| - | - |\r\n| <img width=\"335\" alt=\"Before\" src=\"https://github.com/user-attachments/assets/ad1b1a7c-71cf-4650-a3cf-217bd0bc1c32\" /> | <img width=\"334\" alt=\"Screenshot 2025-04-14 at 10 21 24 AM\" src=\"https://github.com/user-attachments/assets/462dd742-092f-4a32-9d09-804dbf658134\" /> |\r\n\r\n\r\nThis PR allows the inspector to receive this format, as well as adding the relevant documentation to the PROPERTY_HINT_TYPE_STRING and PROPERTY_HINT_ARRAY_TYPE constants.\r\n\r\nSee also: #100926 \r\nA bit outdated but also: https://github.com/godotengine/godot/pull/78656/files#r1736538595\r\n","closed_by":{"login":"Repiteo","id":17489292,"node_id":"MDQ6VXNlcjE3NDg5Mjky","avatar_url":"https://avatars.githubusercontent.com/u/17489292?v=4","gravatar_id":"","url":"https://api.github.com/users/Repiteo","html_url":"https://github.com/Repiteo","followers_url":"https://api.github.com/users/Repiteo/followers","following_url":"https://api.github.com/users/Repiteo/following{/other_user}","gists_url":"https://api.github.com/users/Repiteo/gists{/gist_id}","starred_url":"https://api.github.com/users/Repiteo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Repiteo/subscriptions","organizations_url":"https://api.github.com/users/Repiteo/orgs","repos_url":"https://api.github.com/users/Repiteo/repos","events_url":"https://api.github.com/users/Repiteo/events{/privacy}","received_events_url":"https://api.github.com/users/Repiteo/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/105368/reactions","total_count":4,"+1":4,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/godotengine/godot/issues/105368/timeline","performed_via_github_app":null,"state_reason":null}