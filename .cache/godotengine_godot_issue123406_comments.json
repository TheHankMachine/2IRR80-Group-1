[{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5722994949","html_url":"https://github.com/godotengine/godot/issues/123406#issuecomment-5722994949","issue_url":"https://api.github.com/repos/godotengine/godot/issues/123406","id":5722994949,"node_id":"IC_kwDOAO6SJc8AAAABVR35BQ","user":{"login":"BastiaanOlij","id":1945449,"node_id":"MDQ6VXNlcjE5NDU0NDk=","avatar_url":"https://avatars.githubusercontent.com/u/1945449?v=4","gravatar_id":"","url":"https://api.github.com/users/BastiaanOlij","html_url":"https://github.com/BastiaanOlij","followers_url":"https://api.github.com/users/BastiaanOlij/followers","following_url":"https://api.github.com/users/BastiaanOlij/following{/other_user}","gists_url":"https://api.github.com/users/BastiaanOlij/gists{/gist_id}","starred_url":"https://api.github.com/users/BastiaanOlij/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/BastiaanOlij/subscriptions","organizations_url":"https://api.github.com/users/BastiaanOlij/orgs","repos_url":"https://api.github.com/users/BastiaanOlij/repos","events_url":"https://api.github.com/users/BastiaanOlij/events{/privacy}","received_events_url":"https://api.github.com/users/BastiaanOlij/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-09-18T00:11:50Z","updated_at":"2026-09-18T00:11:50Z","body":"@dsnopek do you mind having a look at this?","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5722994949/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/6090105375","html_url":"https://github.com/godotengine/godot/issues/123406#issuecomment-6090105375","issue_url":"https://api.github.com/repos/godotengine/godot/issues/123406","id":6090105375,"node_id":"IC_kwDOAO6SJc8AAAABav-iHw","user":{"login":"dsnopek","id":191561,"node_id":"MDQ6VXNlcjE5MTU2MQ==","avatar_url":"https://avatars.githubusercontent.com/u/191561?v=4","gravatar_id":"","url":"https://api.github.com/users/dsnopek","html_url":"https://github.com/dsnopek","followers_url":"https://api.github.com/users/dsnopek/followers","following_url":"https://api.github.com/users/dsnopek/following{/other_user}","gists_url":"https://api.github.com/users/dsnopek/gists{/gist_id}","starred_url":"https://api.github.com/users/dsnopek/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/dsnopek/subscriptions","organizations_url":"https://api.github.com/users/dsnopek/orgs","repos_url":"https://api.github.com/users/dsnopek/repos","events_url":"https://api.github.com/users/dsnopek/events{/privacy}","received_events_url":"https://api.github.com/users/dsnopek/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-10-09T22:11:29Z","updated_at":"2026-10-09T22:11:29Z","body":"Thanks! I am able to reproduce the issue with your MRP\n\nThe problem is that you have the VRS mode set to \"Disabled\". In order to use foveation with Vulkan, this needs to be set to \"XR\":\n\n<img width=\"813\" height=\"353\" alt=\"Image\" src=\"https://github.com/user-attachments/assets/18e2ca0e-f0c6-4122-85bd-ed42a71497f6\" />\n\nI think what's happening is that we're assuming that \"XR\" is enabled, so Godot is telling Vulkan that it's going to render with an FDM, but then... it doesn't :-)\n\nI think the fix on the Godot side is to not attempt to use subsampled images unless we have a valid FDM, and give some sort of warning if we don't\n\n","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/6090105375/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/6090708091","html_url":"https://github.com/godotengine/godot/issues/123406#issuecomment-6090708091","issue_url":"https://api.github.com/repos/godotengine/godot/issues/123406","id":6090708091,"node_id":"IC_kwDOAO6SJc8AAAABawjUew","user":{"login":"dsnopek","id":191561,"node_id":"MDQ6VXNlcjE5MTU2MQ==","avatar_url":"https://avatars.githubusercontent.com/u/191561?v=4","gravatar_id":"","url":"https://api.github.com/users/dsnopek","html_url":"https://github.com/dsnopek","followers_url":"https://api.github.com/users/dsnopek/followers","following_url":"https://api.github.com/users/dsnopek/following{/other_user}","gists_url":"https://api.github.com/users/dsnopek/gists{/gist_id}","starred_url":"https://api.github.com/users/dsnopek/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/dsnopek/subscriptions","organizations_url":"https://api.github.com/users/dsnopek/orgs","repos_url":"https://api.github.com/users/dsnopek/repos","events_url":"https://api.github.com/users/dsnopek/events{/privacy}","received_events_url":"https://api.github.com/users/dsnopek/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-10-09T23:00:02Z","updated_at":"2026-10-09T23:00:16Z","body":"I've just posted PR https://github.com/godotengine/godot/pull/124344 which fixes the broken rendering with the MRP, and gives a warning explaining that the VRS mode needs to be set to \"XR\"","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/6090708091/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/6120867175","html_url":"https://github.com/godotengine/godot/issues/123406#issuecomment-6120867175","issue_url":"https://api.github.com/repos/godotengine/godot/issues/123406","id":6120867175,"node_id":"IC_kwDOAO6SJc8AAAABbNUFZw","user":{"login":"tp-up","id":43542156,"node_id":"MDQ6VXNlcjQzNTQyMTU2","avatar_url":"https://avatars.githubusercontent.com/u/43542156?v=4","gravatar_id":"","url":"https://api.github.com/users/tp-up","html_url":"https://github.com/tp-up","followers_url":"https://api.github.com/users/tp-up/followers","following_url":"https://api.github.com/users/tp-up/following{/other_user}","gists_url":"https://api.github.com/users/tp-up/gists{/gist_id}","starred_url":"https://api.github.com/users/tp-up/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/tp-up/subscriptions","organizations_url":"https://api.github.com/users/tp-up/orgs","repos_url":"https://api.github.com/users/tp-up/repos","events_url":"https://api.github.com/users/tp-up/events{/privacy}","received_events_url":"https://api.github.com/users/tp-up/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-10-12T08:47:34Z","updated_at":"2026-10-12T08:47:34Z","body":"i see, i did not know VRS is required. as it is disabled by default, how would a user know this is required?\n\nthe new console log is valid, but maybe this should also be part of the description / documentation?","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/6120867175/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/6133582255","html_url":"https://github.com/godotengine/godot/issues/123406#issuecomment-6133582255","issue_url":"https://api.github.com/repos/godotengine/godot/issues/123406","id":6133582255,"node_id":"IC_kwDOAO6SJc8AAAABbZcJrw","user":{"login":"dsnopek","id":191561,"node_id":"MDQ6VXNlcjE5MTU2MQ==","avatar_url":"https://avatars.githubusercontent.com/u/191561?v=4","gravatar_id":"