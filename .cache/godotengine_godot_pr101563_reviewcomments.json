{/repo}","subscriptions_url":"https://api.github.com/users/AThousandShips/subscriptions","organizations_url":"https://api.github.com/users/AThousandShips/orgs","repos_url":"https://api.github.com/users/AThousandShips/repos","events_url":"https://api.github.com/users/AThousandShips/events{/privacy}","received_events_url":"https://api.github.com/users/AThousandShips/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"```suggestion\n\t\t\t\tReturns this basis with each axis scaled by the given [param scale]'s components.\n\t\t\t\tThe basis matrix's columns are multiplied by [param scale]'s components. This operation is a local scale (relative to self).\n```\nI'd match this to the other description","created_at":"2025-01-15T08:47:53Z","updated_at":"2025-01-15T08:50:42Z","html_url":"https://github.com/godotengine/godot/pull/101563#discussion_r1916157539","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/101563","_links":{"self":{"href":"https://api.github.com/repos/godotengine/godot/pulls/comments/1916157539"},"html":{"href":"https://github.com/godotengine/godot/pull/101563#discussion_r1916157539"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/101563"}},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/1916157539/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":312,"start_side":"RIGHT","line":null,"original_line":315,"side":"RIGHT","author_association":"MEMBER","original_position":9,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/1916188977","pull_request_review_id":2551955293,"id":1916188977,"node_id":"PRRC_kwDOAO6SJc5yNrkx","diff_hunk":"@@ -305,6 +305,40 @@\n \t\t\t\t[/codeblocks]\n \t\t\t</description>\n \t\t</method>\n+\t\t<method name=\"scaled_local\" qualifiers=\"const\">\n+\t\t\t<return type=\"Basis\" />\n+\t\t\t<param index=\"0\" name=\"scale\" type=\"Vector3\" />\n+\t\t\t<description>\n+\t\t\t\tReturns this basis with each axis (column) scaled by the corresponding component in the given [param scale].\n+\t\t\t\tThis operation is a local scale (relative to self).","path":"doc/classes/Basis.xml","commit_id":"b957cf73efd0fc16a391d8e9e4690556acc0b422","original_commit_id":"669ec83c15f49539cb1779d43a0b85e530518725","user":{"login":"MajorMcDoom","id":13228932,"node_id":"MDQ6VXNlcjEzMjI4OTMy","avatar_url":"https://avatars.githubusercontent.com/u/13228932?v=4","gravatar_id":"","url":"https://api.github.com/users/MajorMcDoom","html_url":"https://github.com/MajorMcDoom","followers_url":"https://api.github.com/users/MajorMcDoom/followers","following_url":"https://api.github.com/users/MajorMcDoom/following{/other_user}","gists_url":"https://api.github.com/users/MajorMcDoom/gists{/gist_id}","starred_url":"https://api.github.com/users/MajorMcDoom/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/MajorMcDoom/subscriptions","organizations_url":"https://api.github.com/users/MajorMcDoom/orgs","repos_url":"https://api.github.com/users/MajorMcDoom/repos","events_url":"https://api.github.com/users/MajorMcDoom/events{/privacy}","received_events_url":"https://api.github.com/users/MajorMcDoom/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"I actually made them different on purpose. They don't match because they are different operations. The old wording works for the other method but if applied to scaled_local, it sounds as though each axis is multiplied by *all* the scale vector's components. That would be equivalent to the behaviour of the other method, which is not what is happening in scaled_local. The wording I chose means that each axis is only multiplied by *one* component.","created_at":"2025-01-15T09:04:45Z","updated_at":"2025-01-15T09:05:15Z","html_url":"https://github.com/godotengine/godot/pull/101563#discussion_r1916188977","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/101563","_links":{"self":{"href":"https://api.github.com/repos/godotengine/godot/pulls/comments/1916188977"},"html":{"href":"https://github.com/godotengine/godot/pull/101563#discussion_r1916188977"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/101563"}},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/1916188977/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":312,"start_side":"RIGHT","line":null,"original_line":315,"side":"RIGHT","in_reply_to_id":1916157539,"author_association":"CONTRIBUTOR","original_position":9,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/1916193836","pull_request_review_id":2551963614,"id":1916193836,"node_id":"PRRC_kwDOAO6SJc5yNsws","diff_hunk":"@@ -305,6 +305,40 @@\n \t\t\t\t[/codeblocks]\n \t\t\t</description>\n \t\t</method>\n+\t\t<method name=\"scaled_local\" qualifiers=\"const\">\n+\t\t\t<return type=\"Basis\" />\n+\t\t\t<param index=\"0\" name=\"scale\" type=\"Vector3\" />\n+\t\t\t<description>\n+\t\t\t\tReturns this basis with each axis (column) scaled by the corresponding component in the given [param scale].\n+\t\t\t\tThis operation is a local scale (relative to self).","path":"doc/classes/Basis.xml","commit_id":"b957cf73efd0fc16a391d8e9e4690556acc0b422","original_commit_id":"669ec83c15f49539cb1779d43a0b85e530518725","user":{"login":"AThousandShips","id":96648715,"node_id":"U_kgDOBcK-Cw","avatar_url":"https://avatars.githubusercontent.com/u/96648715?v=4","gravatar_id":"","url":"https://api.github.com/users/AThousandShips","html_url":"https://github.com/AThousandShips","followers_url":"https://api.github.com/users/AThousandShips/followers","following_url":"https://api.github.com/users/AThousandShips/following{/other_user}","gists_url":"https://api.github.com/users/AThousandShips/gists{/gist_id}","starred_url":"https://api.github.com/users/AThousandShips/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/AThousandShips/subscriptions","organizations_url":"https://api.github.com/users/AThousandShips/orgs","repos_url":"https://api.github.com/users/AThousandShips/repos","events_url":"https://api.github.com/users/AThousandShips/events{/privacy}","received_events_url":"https://api.github.com/users/AThousandShips/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"That's why I changed the wording, it's component wise, but can do:\r\n```suggestion\r\n\t\t\t\tReturns this basis with each axis scaled by the corresponding component in the given [param scale].\r\n\t\t\t\tThe basis matrix's columns are multiplied by [param scale]'s components. This operation is a local scale (relative to self).\r\n```","created_at":"2025-01-15T09:06:45Z","updated_at":"2025-01-15T09:06:45Z","html_url":"https://github.com/godotengine/godot/pull/101563#discussion_r1916193836","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/101563","_links":{"self":{"href":"https://api.github.com/repos/godotengine/godot/pulls/comments/1916193836"},"html":{"href":"https://github.com/godotengine/godot/pull/101563#discussion_r1916193836"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/101563"}},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/1916193836/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":312,"start_side":"RIGHT","line":null,"original_line":315,"side":"RIGHT","in_reply_to_id":1916157539,"author_association":"MEMBER","original_position":9,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/1916825716","pull_request_review_id":2553046019,"id":1916825716,"node_id":"PRRC_kwDOAO6SJc5yQHB0","diff_hunk":"@@ -252,7 +246,9 @@ Basis Basis::scaled(const Vector3 &p_scale) const {\n void Basis::scale_local(const Vector3 &p_scale) {\n \t// performs a scaling in object-local coordinate system:\n \t// M -> (M.S.Minv).M = M.S.\n-\t*this = scaled_local(p_scale);\n+\trows[0] *= p_scale;","path":"core/math/basis.cpp","commit_id":"b957cf73efd0fc16a391d8e9e4690556acc0b422","original_commit_id":"669ec83c15f49539cb1779d43a0b85e530518725","user":{"login":"Ivorforce","id":2308167,"node_id":"MDQ6VXNlcjIzMDgxNjc=","avatar_url":"https://avatars.githubusercontent.com/u/2308167?v=4","gravatar_id":"","url":"https://api.github.com/users/Ivorforce","html_url":"https://github.com/Ivorforce","followers_url":"https://api.github.com/users/Ivorforce/followers","following_url":"https://api.github.com/users/Ivorforce/following{/other_user}","gists_url":"https://api.github.com/users/Ivorforce/gists{/gist_id}","starred_url":"https://api.github.com/users/Ivorforce/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Ivorforce/subscriptions","organizations_url":"https://api.github.com/users/Ivorforce/orgs","repos_url":"https://api.github.com/users/Ivorforce/repos","events_url":"https://api.github.com/users/Ivorforce/events{/privacy}","received_events_url":"https://api.github.com/users/Ivorforce/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"This change is kinda difficult to understand, so let's walk through it:\r\n\r\n```c++\r\n*this = scaled_local(p_scale);\r\n// Translates to\r\n(*this) * Basis::from_scale(p_scale);\r\n// Translates to\r\n// i.e. only [0][0], [1][1], [2][2] are filled\r\n(*this) * Basis(p_scale.x, 0, 0, 0, p_scale.y, 0, 0, 0, p_scale.z)\r\n// Translates to\r\n// i.e. only [0][0], [1][1], [2][2] are filled\r\np_matrix = Basis(p_scale.x, 0, 0, 0, p_scale.y, 0, 0, 0, p_scale.z)\r\nBasis(\r\n\t\t\tp_matrix.tdotx(rows[0]), p_matrix.tdoty(rows[0]), p_matrix.tdotz(rows[0]),\r\n\t\t\tp_matrix.tdotx(rows[1]), p_matrix.tdoty(rows[1]), p_matrix.tdotz(rows[1]),\r\n\t\t\tp_matrix.tdotx(rows[2]), p_matrix.tdoty(rows[2]), p_matrix.tdotz(rows[2])\r\n)\r\n// Translates to\r\n// i.e. only [0][0], [1][1], [2][2] are filled\r\np_matrix = Basis(p_scale.x, 0, 0, 0, p_scale.y, 0, 0, 0, p_scale.z)\r\nBasis(\r\n\t\t\tp_matrix.rows[0][0] * rows[0][0], p_matrix.rows[1][1] * rows[0][1], p_matrix.rows[2][2] * rows[0][2],\r\n\t\t\tp_matrix.rows[0][0] * rows[1][0], p_matrix.rows[1][1] * rows[1][1], p_matrix.rows[2][2] * rows[1][2],\r\n\t\t\tp_matrix.rows[0][0] * rows[2][0], p_matrix.rows[1][1] * rows[2][1], p_matrix.rows[2][2] * rows[2][2]\r\n)\r\n// Translates to\r\nBasis(\r\n\t\t\tp_scale.x * rows[0][0], p_scale.y * rows[0][1], p_scale.z * rows[0][2],\r\n\t\t\tp_scale.x * rows[1][0], p_scale.y * rows[1][1], p_scale.z * rows[1][2],\r\n\t\t\tp_scale.x * rows[2][0], p_scale.y * rows[2][1], p_scale.z * rows[2][2]\r\n)\r\n// Equal to\r\nBasis(rows[0] * p_scale, rows[1] * p_scale, rows[2] * p_scale)\r\n```\r\n\r\nSo yes, I think you have it right! 🙌\r\nSince this involves `real_t` (i.e. no compiler simplification will be performed), a lot of computation can be saved with your change. \r\n\r\n> there might be a good reason this very obvious improvement wasn't made\r\n\r\nI was able to track the change back to @tagcup (e9896b17a9804ba6392dab0bd6c484f4d2e294c1), who I think based the code on @reduz' `rotated_local` (c1153f5041f896536957b851329b5adaa1de6dc4). This was _long_ ago (2017) so it's quite possible it was just never examined for simplification.\r\n\r\nThe simplification _will_ notably change behavior if either scale or `Basis` have `NaN` (/ `inf`) in them, in that more elements will be preserved from turning into `NaN` themselves in the new implementation (previously, I think _all_ of them would have turned into `NaN`). This is the same reason that a compiler wouldn't perform simplification. I don't think the previouis behavior is desirable though.","created_at":"2025-01-15T15:09:05Z","updated_at":"2025-01-15T15:17:45Z","html_url":"https://github.com/godotengine/godot/pull/101563#discussion_r1916825716","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/101563","_links":{"self":{"href":"https://api.github.com/repos/godotengine/godot/pulls/comments/1916825716"},"html":{"href":"https://github.com/godotengine/godot/pull/101563#discussion_r1916825716"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/101563"}},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/1916825716/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":249,"original_line":249,"side":"RIGHT","author_association":"MEMBER","original_position":24,"position":24,"subject_type":"line"},{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/1916836699","pull_request_review_id":2553065692,"id":1916836699,"node_id":"PRRC_kwDOAO6SJc5yQJtb","diff_hunk":"@@ -252,7 +246,9 @@ Basis Basis::scaled(const Vector3 &p_scale) const {\n void Basis::scale_local(const Vector3 &p_scale) {\n \t// performs a scaling in object-local coordinate system:\n \t// M -> (M.S.Minv).M = M.S.\n-\t*this = scaled_local(p_scale);\n+\trows[0] *= p_scale;","path":"core/math/basis.cpp","commit_id":"b957cf73efd0fc16a391d8e9e4690556acc0b422","original_commit_id":"669ec83c15f49539cb1779d43a0b85e530518725","user":{"login":"AThousandShips","id":96648715,"node_id":"U_kgDOBcK-Cw","avatar_url":"https://avatars.githubusercontent.com/u/96648715?v=4","gravatar_id":"","url":"https://api.github.com/users/AThousandShips","html_url":"https://github.com/AThousandShips","followers_url":"https://api.github.com/users/AThousandShips/followers","following_url":"https://api.github.com/users/AThousandShips/following{/other_user}","gists_url":"https://api.github.com/users/AThousandShips/gists{/gist_id}","s