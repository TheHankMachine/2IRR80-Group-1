","followers_url":"https://api.github.com/users/RealIceCone/followers","following_url":"https://api.github.com/users/RealIceCone/following{/other_user}","gists_url":"https://api.github.com/users/RealIceCone/gists{/gist_id}","starred_url":"https://api.github.com/users/RealIceCone/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/RealIceCone/subscriptions","organizations_url":"https://api.github.com/users/RealIceCone/orgs","repos_url":"https://api.github.com/users/RealIceCone/repos","events_url":"https://api.github.com/users/RealIceCone/events{/privacy}","received_events_url":"https://api.github.com/users/RealIceCone/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-08-06T14:25:41Z","updated_at":"2026-08-06T14:25:41Z","body":"I am using mesa version 26.1.5 so that was not the issue. turning on Single Window Mode fixed the issue!","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5206003991/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null}]