rchived_at":null,"archived_by":null}],"state":"closed","locked":false,"assignees":[],"milestone":{"url":"https://api.github.com/repos/godotengine/godot/milestones/25","html_url":"https://github.com/godotengine/godot/milestone/25","labels_url":"https://api.github.com/repos/godotengine/godot/milestones/25/labels","id":15520464,"node_id":"MI_kwDOAO6SJc4A7NLQ","number":25,"title":"4.8","description":"","creator":{"login":"Repiteo","id":17489292,"node_id":"MDQ6VXNlcjE3NDg5Mjky","avatar_url":"https://avatars.githubusercontent.com/u/17489292?v=4","gravatar_id":"","url":"https://api.github.com/users/Repiteo","html_url":"https://github.com/Repiteo","followers_url":"https://api.github.com/users/Repiteo/followers","following_url":"https://api.github.com/users/Repiteo/following{/other_user}","gists_url":"https://api.github.com/users/Repiteo/gists{/gist_id}","starred_url":"https://api.github.com/users/Repiteo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Repiteo/subscriptions","organizations_url":"https://api.github.com/users/Repiteo/orgs","repos_url":"https://api.github.com/users/Repiteo/repos","events_url":"https://api.github.com/users/Repiteo/events{/privacy}","received_events_url":"https://api.github.com/users/Repiteo/received_events","type":"User","user_view_type":"public","site_admin":false},"open_issues":343,"closed_issues":2335,"state":"open","created_at":"2026-04-13T15:59:35Z","updated_at":"2026-10-22T06:28:22Z","due_on":null,"closed_at":null},"comments":2,"created_at":"2026-07-05T21:09:56Z","updated_at":"2026-07-30T16:37:16Z","closed_at":"2026-07-10T15:26:04Z","assignee":null,"author_association":"CONTRIBUTOR","issue_field_values":[],"type":null,"active_lock_reason":null,"draft":false,"pull_request":{"url":"https://api.github.com/repos/godotengine/godot/pulls/120984","html_url":"https://github.com/godotengine/godot/pull/120984","diff_url":"https://github.com/godotengine/godot/pull/120984.diff","patch_url":"https://github.com/godotengine/godot/pull/120984.patch","merged_at":"2026-07-10T15:26:04Z"},"body":"## What problem(s) does this PR solve?\r\n\r\nFixes an issue whereby parent `Control` could not update their children's `parent_maximum_size_cache` more than once per frame.\r\n\r\n## Additional information\r\n\r\nWhilst working on tests for containers for all the desired size behavior, I discovered that the `parent_maximum_size_cache` wouldn't update as intended when the following code was executed:\r\n```cpp\r\nparent->set_custom_maximum_size(Size2(100, 100));\r\nparent->set_propagate_maximum_size(false);\r\nSceneTree::get_singleton()->process(0);\r\nchild->get_combined_maximum_size() //  would return Size2(100, 100) instead of Size2(-1, -1)\r\n```\r\nBut it would work if the first two setters were flipped:\r\n```cpp\r\nparent->set_propagate_maximum_size(false);\r\nparent->set_custom_maximum_size(Size2(100, 100));\r\nSceneTree::get_singleton()->process(0);\r\nchild->get_combined_maximum_size() //  would return Size2(-1, -1)\r\n```\r\n\r\nTurns out the `&& child_control->data.maximum_size_valid` condition that I had copied from `update_minimum_size` when creating `update_maximum_size` was preventing the children's `parent_maximum_size_cache` from being updated more than once per frame.\r\n\r\n\r\nEdit: \r\nMRP [mrp-parent-cache.zip](https://github.com/user-attachments/files/29858997/mrp-parent-cache.zip)\r\nRun the scene and press the big button, check the console output.","closed_by":{"login":"Repiteo","id":17489292,"node_id":"MDQ6VXNlcjE3NDg5Mjky","avatar_url":"https://avatars.githubusercontent.com/u/17489292?v=4","gravatar_id":"","url":"https://api.github.com/users/Repiteo","html_url":"https://github.com/Repiteo","followers_url":"https://api.github.com/users/Repiteo/followers","following_url":"https://api.github.com/users/Repiteo/following{/other_user}","gists_url":"https://api.github.com/users/Repiteo/gists{/gist_id}","starred_url":"https://api.github.com/users/Repiteo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Repiteo/subscriptions","organizations_url":"https://api.github.com/users/Repiteo/orgs","repos_url":"https://api.github.com/users/Repiteo/repos","events_url":"https://api.github.com/users/Repiteo/events{/privacy}","received_events_url":"https://api.github.com/users/Repiteo/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/120984/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/godotengine/godot/issues/120984/timeline","performed_via_github_app":null,"state_reason":null}