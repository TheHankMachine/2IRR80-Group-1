s/godotengine/godot/pulls/117491"}},"submitted_at":"2026-03-17T14:07:50Z","commit_id":null},{"id":3961377323,"node_id":"PRR_kwDOAO6SJc7sHdIr","user":{"login":"AThousandShips","id":96648715,"node_id":"U_kgDOBcK-Cw","avatar_url":"https://avatars.githubusercontent.com/u/96648715?u=af70f5d107e9c1447f296643d5a566dab53d25e8&v=4","gravatar_id":"","url":"https://api.github.com/users/AThousandShips","html_url":"https://github.com/AThousandShips","followers_url":"https://api.github.com/users/AThousandShips/followers","following_url":"https://api.github.com/users/AThousandShips/following{/other_user}","gists_url":"https://api.github.com/users/AThousandShips/gists{/gist_id}","starred_url":"https://api.github.com/users/AThousandShips/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/AThousandShips/subscriptions","organizations_url":"https://api.github.com/users/AThousandShips/orgs","repos_url":"https://api.github.com/users/AThousandShips/repos","events_url":"https://api.github.com/users/AThousandShips/events{/privacy}","received_events_url":"https://api.github.com/users/AThousandShips/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"I think these changes make sense, the grouping is much clearer this way\r\n\r\nAutomating some of this would help a lot and ensure we maintain quality, and I don't see any issues in these files indicating that we're likely to run into any odd issues in PRs from this (and those would arguably just be surface level and not critically blocking a PR or causing issues, as far as I would guess)\r\n\r\nThe one thing I wish we could avoid is the space before the compat incs, might be possible some way but I don't think it's a blocker, and compared with the rest of the benefits from this I think it's absolutely a price worth paying for it\r\n\r\nTIWAGOS though as I've not evaluated any specific area concerns with include order, but that should probably be caught and we can get some feedback for specific cases\r\n\r\n---\r\n\r\nTL;DR; I agree with the changes in grouping and I think it helps improve readability and enforcement of this with minimal effort, but can't speak to the practical impact on the code itself","state":"APPROVED","html_url":"https://github.com/godotengine/godot/pull/117491#pullrequestreview-3961377323","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/117491","author_association":"MEMBER","_links":{"html":{"href":"https://github.com/godotengine/godot/pull/117491#pullrequestreview-3961377323"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/117491"}},"submitted_at":"2026-03-17T14:48:34Z","commit_id":null},{"id":3961467033,"node_id":"PRR_kwDOAO6SJc7sHzCZ","user":{"login":"Repiteo","id":17489292,"node_id":"MDQ6VXNlcjE3NDg5Mjky","avatar_url":"https://avatars.githubusercontent.com/u/17489292?u=34072b401722100a7c0c0d61e37b376cf22b4545&v=4","gravatar_id":"","url":"https://api.github.com/users/Repiteo","html_url":"https://github.com/Repiteo","followers_url":"https://api.github.com/users/Repiteo/followers","following_url":"https://api.github.com/users/Repiteo/following{/other_user}","gists_url":"https://api.github.com/users/Repiteo/gists{/gist_id}","starred_url":"https://api.github.com/users/Repiteo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Repiteo/subscriptions","organizations_url":"https://api.github.com/users/Repiteo/orgs","repos_url":"https://api.github.com/users/Repiteo/repos","events_url":"https://api.github.com/users/Repiteo/events{/privacy}","received_events_url":"https://api.github.com/users/Repiteo/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"I like the idea of this a LOT, but from past experience with these options I'd say there's room to formalize matters even further. In particular: we should take advantage of `SortPriority`, to allow for ordering within a group without causing spaces. For example, the following would solve the gap issue for `*.compat.inc`:\n```diff\n   - Regex: ^\".*\\.compat\\.inc\"$\n-    Priority: 1\n+    Priority: 0\n+    SortPriority: 1\n```\nTrying to adjust this even further gets a bit messy, especially if we try to capture with a wildcard after the fact, but I would like to cover our bases as much as possible before fully formalizing anything","state":"COMMENTED","html_url":"https://github.com/godotengine/godot/pull/117491#pullrequestreview-3961467033","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/117491","author_association":"CONTRIBUTOR","_links":{"html":{"href":"https://github.com/godotengine/godot/pull/117491#pullrequestreview-3961467033"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/117491"}},"submitted_at":"2026-03-17T14:57:22Z","commit_id":null},{"id":3961902461,"node_id":"PRR_kwDOAO6SJc7sJdV9","user":{"login":"AThousandShips","id":96648715,"node_id":"U_kgDOBcK-Cw","avatar_url":"https://avatars.githubusercontent.com/u/96648715?u=af70f5d107e9c1447f296643d5a566dab53d25e8&v=4","gravatar_id":"","url":"https://api.github.com/users/AThousandShips","html_url":"https://github.com/AThousandShips","followers_url":"https://api.github.com/users/AThousandShips/followers","following_url":"https://api.github.com/users/AThousandShips/following{/other_user}","gists_url":"https://api.github.com/users/AThousandShips/gists{/gist_id}","starred_url":"https://api.github.com/users/AThousandShips/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/AThousandShips/subscriptions","organizations_url":"https://api.github.com/users/AThousandShips/orgs","repos_url":"https://api.github.com/users/AThousandShips/repos","events_url":"https://api.github.com/users/AThousandShips/events{/privacy}","received_events_url":"https://api.github.com/users/AThousandShips/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"Looks great now!","state":"APPROVED","html_url":"https://g