s","repos_url":"https://api.github.com/users/YeldhamDev/repos","events_url":"https://api.github.com/users/YeldhamDev/events{/privacy}","received_events_url":"https://api.github.com/users/YeldhamDev/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-05-13T22:20:29Z","updated_at":"2026-05-13T22:20:29Z","body":"@TrueJole The PR has been modified, could you please try again? Remember to clear the cache.","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4445645561/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4462031660","html_url":"https://github.com/godotengine/godot/pull/119413#issuecomment-4462031660","issue_url":"https://api.github.com/repos/godotengine/godot/issues/119413","id":4462031660,"node_id":"IC_kwDOAO6SJc8AAAABCfUzLA","user":{"login":"YeldhamDev","id":30739239,"node_id":"MDQ6VXNlcjMwNzM5MjM5","avatar_url":"https://avatars.githubusercontent.com/u/30739239?v=4","gravatar_id":"","url":"https://api.github.com/users/YeldhamDev","html_url":"https://github.com/YeldhamDev","followers_url":"https://api.github.com/users/YeldhamDev/followers","following_url":"https://api.github.com/users/YeldhamDev/following{/other_user}","gists_url":"https://api.github.com/users/YeldhamDev/gists{/gist_id}","starred_url":"https://api.github.com/users/YeldhamDev/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/YeldhamDev/subscriptions","organizations_url":"https://api.github.com/users/YeldhamDev/orgs","repos_url":"https://api.github.com/users/YeldhamDev/repos","events_url":"https://api.github.com/users/YeldhamDev/events{/privacy}","received_events_url":"https://api.github.com/users/YeldhamDev/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-05-15T17:55:27Z","updated_at":"2026-05-15T17:55:27Z","body":"@HolonProduction\r\n> There is another more concrete issue I take with this PR: The GDScript implementation of `get_classes_used` relies on `ResourceLoader::load` to process the received path. As such passing a builtin path to it is subject to the cold loading issues described in https://github.com/godotengine/godot/issues/116593\r\n\r\nFrom what I understood of the code, both `ResourceFormatLoaderText::load()` and `ResourceFormatLoaderText::get_classes_used()` make use of `ResourceLoaderText::open()`. So I think it does load the scene in order to extract the classes.","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4462031660/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4487919955","html_url":"https://github.com/godotengine/godot/pull/119413#issuecomment-4487919955","issue_url":"https://api.github.com/repos/godotengine/godot/issues/119413","id":4487919955,"node_id":"IC_kwDOAO6SJc8AAAABC4A5Uw","user":{"login":"HolonProduction","id":99511741,"node_id":"U_kgDOBe5tvQ","avatar_url":"https://avatars.githubusercontent.com/u/99511741?v=4","gravatar_id":"","url":"https://api.github.com/users/HolonProduction","html_url":"https://github.com/HolonProduction","followers_url":"https://api.github.com/users/HolonProduction/followers","following_url":"https://api.github.com/users/HolonProduction/following{/other_user}","gists_url":"https://api.github.com/users/HolonProduction/gists{/gist_id}","starred_url":"https://api.github.com/users/HolonProduction/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/HolonProduction/subscriptions","organizations_url":"https://api.github.com/users/HolonProduction/orgs","repos_url":"https://api.github.com/users/HolonProduction/repos","events_url":"https://api.github.com/users/HolonProduction/events{/privacy}","received_events_url":"https://api.github.com/users/HolonProduction/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-05-19T12:52:59Z","updated_at":"2026-05-19T12:52:59Z","body":"> From what I understood of the code, both `ResourceFormatLoaderText::load()` and `ResourceFormatLoaderText::get_classes_used()` make use of `ResourceLoaderText::open()`. So I think it does load the scene in order to extract the classes.\r\n\r\nThat's not the case. I just tested my assumption and in a very minimal setup the results of autodetection do absolutely depend on whether the scene containing the script is open in editor, and thus in the resource cache. (Make sure to close the scene and restart the editor when testing, to make sure the scene is not in cache).\r\n\r\nWorth noting that due to your little hack in `GDScriptResourceFormatLoader::recongnize_path` there is no error, since the GDScript loader claims the resource. It is not able to load the source code though. So if the scene is not in cache you will just end up with an invalid empty script. -> yet another reason why we can't just claim builtin scripts in the GDScript loader.","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4487919955/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4488054090","html_url":"https://github.com/godotengine/godot/pull/119413#issuecomment-4488054090","issue_url":"https://api.github.com/repos/godotengine/godot/issues/119413","id":4488054090,"node_id":"IC_kwDOAO6SJc8AAAABC4JFSg","user":{"login":"KoBeWi","id":2223172,"node_id":"MDQ6VXNlcjIyMjMxNzI=","avatar_url":"https://avatars.githubusercontent.com/u/2223172?v=4","gra