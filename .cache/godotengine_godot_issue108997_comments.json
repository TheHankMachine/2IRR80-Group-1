[{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3123663950","html_url":"https://github.com/godotengine/godot/issues/108997#issuecomment-3123663950","issue_url":"https://api.github.com/repos/godotengine/godot/issues/108997","id":3123663950,"node_id":"IC_kwDOAO6SJc66L1RO","user":{"login":"smix8","id":52464204,"node_id":"MDQ6VXNlcjUyNDY0MjA0","avatar_url":"https://avatars.githubusercontent.com/u/52464204?v=4","gravatar_id":"","url":"https://api.github.com/users/smix8","html_url":"https://github.com/smix8","followers_url":"https://api.github.com/users/smix8/followers","following_url":"https://api.github.com/users/smix8/following{/other_user}","gists_url":"https://api.github.com/users/smix8/gists{/gist_id}","starred_url":"https://api.github.com/users/smix8/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/smix8/subscriptions","organizations_url":"https://api.github.com/users/smix8/orgs","repos_url":"https://api.github.com/users/smix8/repos","events_url":"https://api.github.com/users/smix8/events{/privacy}","received_events_url":"https://api.github.com/users/smix8/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-07-27T00:40:54Z","updated_at":"2025-07-27T00:40:54Z","body":"HLOD is for rendering only and inside the RenderingServer only.\n\nA Skeleton3D node is not just about rendering so if you dont want it to update its bone tree you need to stop changing its transform unnecessarily.","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3123663950/reactions","total_count":2,"+1":2,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3133656298","html_url":"https://github.com/godotengine/godot/issues/108997#issuecomment-3133656298","issue_url":"https://api.github.com/repos/godotengine/godot/issues/108997","id":3133656298,"node_id":"IC_kwDOAO6SJc66x8zq","user":{"login":"TestSubject06","id":597840,"node_id":"MDQ6VXNlcjU5Nzg0MA==","avatar_url":"https://avatars.githubusercontent.com/u/597840?v=4","gravatar_id":"","url":"https://api.github.com/users/TestSubject06","html_url":"https://github.com/TestSubject06","followers_url":"https://api.github.com/users/TestSubject06/followers","following_url":"https://api.github.com/users/TestSubject06/following{/other_user}","gists_url":"https://api.github.com/users/TestSubject06/gists{/gist_id}","starred_url":"https://api.github.com/users/TestSubject06/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/TestSubject06/subscriptions","organizations_url":"https://api.github.com/users/TestSubject06/orgs","repos_url":"https://api.github.com/users/TestSubject06/repos","events_url":"https://api.github.com/users/TestSubject06/events{/privacy}","received_events_url":"https://api.github.com/users/TestSubject06/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-07-29T18:47:18Z","updated_at":"2025-07-29T18:47:18Z","body":"The documentation never makes any mention that the HLOD will operate any differently than the visibility toggle in the editor.\n\nNode.visible operating differently than visibility_parent or visibility_range should either be called out in the documentation, or should be amended so that it works as described.","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3133656298/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3145765651","html_url":"https://github.com/godotengine/godot/issues/108997#issuecomment-3145765651","issue_url":"https://api.github.com/repos/godotengine/godot/issues/108997","id":3145765651,"node_id":"IC_kwDOAO6SJc67gJMT","user":{"login":"Calinou","id":180032,"node_id":"MDQ6VXNlcjE4MDAzMg==","avatar_url":"https://avatars.githubusercontent.com/u/180032?v=4","gravatar_id":"","url":"https://api.github.com/users/Calinou","html_url":"https://github.com/Calinou","followers_url":"https://api.github.com/users/Calinou/followers","following_url":"https://api.github.com/users/Calinou/following{/other_user}","gists_url":"https://api.github.com/users/Calinou/gists{/gist_id}","starred_url":"https://api.github.com/users/Calinou/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Calinou/subscriptions","organizations_url":"https://api.github.com/users/Calinou/orgs","repos_url":"https://api.github.com/users/Calinou/repos","events_url":"https://api.github.com/users/Calinou/events{/privacy}","received_events_url":"https://api.github.com/users/Calinou/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-08-01T21:03:47Z","updated_at":"2025-08-01T21:04:06Z","body":"- Related to https://github.com/godotengine/godot-proposals/issues/12142.\n\nYou need to use the VisibleOnScreenEnabler3D node to stop animation on offscreen objects. There is no distance limit property in VisibleOnScreenNotifier3D in 4.x though ([unlike in 3.x](https://github.com/godotengine/godot/pull/61544)), so you can't easily stop animations at a distance with it.","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3145765651/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null}]