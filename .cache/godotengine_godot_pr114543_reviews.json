[{"id":3630487661,"node_id":"PRR_kwDOAO6SJc7YZNht","user":{"login":"lyuma","id":39946030,"node_id":"MDQ6VXNlcjM5OTQ2MDMw","avatar_url":"https://avatars.githubusercontent.com/u/39946030?v=4","gravatar_id":"","url":"https://api.github.com/users/lyuma","html_url":"https://github.com/lyuma","followers_url":"https://api.github.com/users/lyuma/followers","following_url":"https://api.github.com/users/lyuma/following{/other_user}","gists_url":"https://api.github.com/users/lyuma/gists{/gist_id}","starred_url":"https://api.github.com/users/lyuma/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/lyuma/subscriptions","organizations_url":"https://api.github.com/users/lyuma/orgs","repos_url":"https://api.github.com/users/lyuma/repos","events_url":"https://api.github.com/users/lyuma/events{/privacy}","received_events_url":"https://api.github.com/users/lyuma/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"Review is easy to read with split view + hide whitespace.\r\n\r\nInstead of adding y, it's transforming a vector (0, base_adjustment, 0) by the global rest of the parent bone and the skeleton node itself. That way the adjustment works even on a rotated hip bone.\r\n\r\nI'm pretty sure this looks good. If there are still bugs, this also makes the code easier to debug by using actual vector operations instead of hardcoding math on the y component.","state":"APPROVED","html_url":"https://github.com/godotengine/godot/pull/114543#pullrequestreview-3630487661","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/114543","author_association":"CONTRIBUTOR","_links":{"html":{"href":"https://github.com/godotengine/godot/pull/114543#pullrequestreview-3630487661"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/114543"}},"submitted_at":"2026-01-06T11:02:47Z","commit_id":"deeb528c83eaabd4c4a09b1dd6ae60c372689adf"}]