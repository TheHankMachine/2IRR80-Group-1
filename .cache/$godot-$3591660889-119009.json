[{"id":4183427768,"node_id":"PRR_kwDOAO6SJc75Wgq4","state":"APPROVED","commit_id":"6e2b9cbab40430051e840b18edf7f03154e52df5","user":{"site_admin":false,"suspended":false,"updated_at":"0001-01-01T00:00:00Z","avatar_url":"https://avatars.githubusercontent.com/u/7645683?u=2867ee7fcd920bc19b7d1cbf4b10264b9bbc9326&v=4","created_at":"0001-01-01T00:00:00Z","followers":0,"following":0,"html_url":"https://github.com/bruvzg","id":7645683,"node_id":"MDQ6VXNlcjc2NDU2ODM=","login":"bruvzg","type":"User","owned_private_repos":0,"public_gists":0,"public_repos":0,"total_private_repos":0,"url":"https://api.github.com/users/bruvzg"},"body":"","html_url":"https://github.com/godotengine/godot/pull/119009#pullrequestreview-4183427768","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/119009","author_association":"MEMBER","submitted_at":"2026-04-27T18:51:54Z"},{"id":4183481926,"node_id":"PRR_kwDOAO6SJc75Wt5G","state":"COMMENTED","commit_id":"6e2b9cbab40430051e840b18edf7f03154e52df5","user":{"site_admin":false,"suspended":false,"updated_at":"0001-01-01T00:00:00Z","avatar_url":"https://avatars.githubusercontent.com/u/180032?u=68d23e7ee9cdf810da125e8510b72f845b9dccc8&v=4","created_at":"0001-01-01T00:00:00Z","followers":0,"following":0,"html_url":"https://github.com/Calinou","id":180032,"node_id":"MDQ6VXNlcjE4MDAzMg==","login":"Calinou","type":"User","owned_private_repos":0,"public_gists":0,"public_repos":0,"total_private_repos":0,"url":"https://api.github.com/users/Calinou"},"body":"I agree it's better to revert this for now.\r\n\r\nI'd say the desired behavior would be to save properly tonemapped PNGs (i.e. SDR, not overly dark). This allows the file to still be easily previewed in apps and websites (e.g. Discord). I would consider this bugfix territory and therefore acceptable for 4.7, although it's not a blocker since taking screenshots from the editor is rarely used.\r\n\r\nIf we want to support shareable HDR screenshots, we'd need to implement [AVIF](https://github.com/godotengine/godot-proposals/issues/10700) or HDR PNG support (which creates larger files, but only HDR PNG is currently supported in Discord embeds).","html_url":"https://github.com/godotengine/godot/pull/119009#pullrequestreview-4183481926","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/119009","author_association":"MEMBER","submitted_at":"2026-04-27T19:02:19Z"}]