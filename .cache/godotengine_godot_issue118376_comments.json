.github.com/users/romgerman/followers","following_url":"https://api.github.com/users/romgerman/following{/other_user}","gists_url":"https://api.github.com/users/romgerman/gists{/gist_id}","starred_url":"https://api.github.com/users/romgerman/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/romgerman/subscriptions","organizations_url":"https://api.github.com/users/romgerman/orgs","repos_url":"https://api.github.com/users/romgerman/repos","events_url":"https://api.github.com/users/romgerman/events{/privacy}","received_events_url":"https://api.github.com/users/romgerman/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-04-15T06:48:01Z","updated_at":"2026-04-15T06:50:38Z","body":"> This is definitely not a bug. MRP is a skeleton with three roots, and they are not actually connected.\n\nI don't see why it shouldn't display the bones correctly, when it does display the hands which are disconnected.\n\nOr is it the same bug as https://github.com/godotengine/godot/issues/32393 which was never resolved and just closed?","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4249885160/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4249896637","html_url":"https://github.com/godotengine/godot/issues/118376#issuecomment-4249896637","issue_url":"https://api.github.com/repos/godotengine/godot/issues/118376","id":4249896637,"node_id":"IC_kwDOAO6SJc79UEa9","user":{"login":"TokageItLab","id":61938263,"node_id":"MDQ6VXNlcjYxOTM4MjYz","avatar_url":"https://avatars.githubusercontent.com/u/61938263?v=4","gravatar_id":"","url":"https://api.github.com/users/TokageItLab","html_url":"https://github.com/TokageItLab","followers_url":"https://api.github.com/users/TokageItLab/followers","following_url":"https://api.github.com/users/TokageItLab/following{/other_user}","gists_url":"https://api.github.com/users/TokageItLab/gists{/gist_id}","starred_url":"https://api.github.com/users/TokageItLab/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/TokageItLab/subscriptions","organizations_url":"https://api.github.com/users/TokageItLab/orgs","repos_url":"https://api.github.com/users/TokageItLab/repos","events_url":"https://api.github.com/users/TokageItLab/events{/privacy}","received_events_url":"https://api.github.com/users/TokageItLab/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-04-15T06:50:38Z","updated_at":"2026-04-15T06:53:47Z","body":"The fingers is a child of the `ik_hand` bone. `ik_hand` is a bone with no parent and is not connected to any other bones that have `spine.002` as their root.\nAlso, the length of the bone ends is discarded during glTF export and therefore tip bone is not displayed, see also https://github.com/godotengine/godot/issues/32393.","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4249896637/reactions","total_count":1,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":1},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4249912330","html_url":"https://github.com/godotengine/godot/issues/118376#issuecomment-4249912330","issue_url":"https://api.github.com/repos/godotengine/godot/issues/118376","id":4249912330,"node_id":"IC_kwDOAO6SJc79UIQK","user":{"login":"romgerman","id":1517367,"node_id":"MDQ6VXNlcjE1MTczNjc=","avatar_url":"https://avatars.githubusercontent.com/u/1517367?v=4","gravatar_id":"","url":"https://api.github.com/users/romgerman","html_url":"https://github.com/romgerman","followers_url":"https://api.github.com/users/romgerman/followers","following_url":"https://api.github.com/users/romgerman/following{/other_user}","gists_url":"https://api.github.com/users/romgerman/gists{/gist_id}","starred_url":"https://api.github.com/users/romgerman/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/romgerman/subscriptions","organizations_url":"https://api.github.com/users/romgerman/orgs","repos_url":"https://api.github.com/users/romgerman/repos","events_url":"https://api.github.com/users/romgerman/events{/privacy}","received_events_url":"https://api.github.com/users/romgerman/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-04-15T06:54:01Z","updated_at":"2026-04-15T06:54:01Z","body":"> discarded during glTF export\n\nI see. So it's the same bug as the https://github.com/godotengine/godot/issues/32393. I didn't even notice that the finger end bones are absent. But it's not only the problem with gltf, there is the original FBX model in the MRP and it has the same issue.","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4249912330/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4249918443","html_url":"https://github.com/godotengine/godot/issues/118376#issuecomment-4249918443","issue_url":"https://api.github.com/repos/godotengine/godot/issues/118376","id":4249918443,"node_id":"IC_kwDOAO6SJc79UJvr","user":{"login":"TokageItLab","id":61938263,"node_id":"MDQ6VXNlcjYxOTM4MjYz","avatar_url":"https://avatars.githubusercontent.com/u/61938263?v=4","gravatar_id":"","url":"https://api.github.com/users/TokageItLab","html_url":"https://github.com/TokageItLab","followers_url":"https://api.github.com/users/TokageItLab/followers","following_url":"https://api.github.com/users/TokageItLab/following{/other_user}","gists_url":"https://api.github.com/users/TokageItLab/gists{/gist_id}","starred_url":"https://api.github.com/users/TokageItLab/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/TokageItLab/subscriptions","organizations_url":"https://api.github.com/users/TokageItLab/orgs","repos_url":"https://api.github.com/users/TokageItLab/repos","events_url":"https://api.github.com/users/TokageItLab/events{/privacy}","received_events_url":"https://api.github.com/users/TokageItLab/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-04-15T06:55:20Z","updated_at":"2026-04-15T07:07:31Z","body":"If you're using FBX, there should be an option in Blender's exporter to export leaf bones, so you just need to enable it as long as you was set up the `forearm` **tail** to match the `ik_hand`. As I mentioned in https://github.com/godotengine/godot/issues/32393.\n\n<img width=\"234\" height=\"223\" alt=\"Image\" src=\"https://github.com/user-attachments/assets/1b6e822d-0668-4827-923e-aa69ddbe7a9f\" />\n\nIf you're using a recent version blender, there is an option for glTF, but it appears to be disabled by default.\n\n<img width=\"310\" height=\"307\" alt=\"Image\" src=\"https://github.com/user-attachments/assets/e8265a54-d615-4c33-8826-217fdb7fa787\" />","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4249918443/reactions","total_count":2,"+1":2,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null}]