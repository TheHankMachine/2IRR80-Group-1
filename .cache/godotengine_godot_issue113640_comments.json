ndShips","id":96648715,"node_id":"U_kgDOBcK-Cw","avatar_url":"https://avatars.githubusercontent.com/u/96648715?v=4","gravatar_id":"","url":"https://api.github.com/users/AThousandShips","html_url":"https://github.com/AThousandShips","followers_url":"https://api.github.com/users/AThousandShips/followers","following_url":"https://api.github.com/users/AThousandShips/following{/other_user}","gists_url":"https://api.github.com/users/AThousandShips/gists{/gist_id}","starred_url":"https://api.github.com/users/AThousandShips/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/AThousandShips/subscriptions","organizations_url":"https://api.github.com/users/AThousandShips/orgs","repos_url":"https://api.github.com/users/AThousandShips/repos","events_url":"https://api.github.com/users/AThousandShips/events{/privacy}","received_events_url":"https://api.github.com/users/AThousandShips/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-12-17T09:51:37Z","updated_at":"2025-12-17T10:21:42Z","body":"I'd say this is far too big a feature to add this late it needs time to be tested\r\n\r\nWe're aiming to release 4.6 in about a month, and it's almost the holidays, a lot of maintainers will be on leave next week and through the new year so this wouldn't likely be merged before early January even if it was approved and ready right now","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3664559741/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3666733961","html_url":"https://github.com/godotengine/godot/pull/113640#issuecomment-3666733961","issue_url":"https://api.github.com/repos/godotengine/godot/issues/113640","id":3666733961,"node_id":"IC_kwDOAO6SJc7ajeuJ","user":{"login":"fire","id":32321,"node_id":"MDQ6VXNlcjMyMzIx","avatar_url":"https://avatars.githubusercontent.com/u/32321?v=4","gravatar_id":"","url":"https://api.github.com/users/fire","html_url":"https://github.com/fire","followers_url":"https://api.github.com/users/fire/followers","following_url":"https://api.github.com/users/fire/following{/other_user}","gists_url":"https://api.github.com/users/fire/gists{/gist_id}","starred_url":"https://api.github.com/users/fire/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/fire/subscriptions","organizations_url":"https://api.github.com/users/fire/orgs","repos_url":"https://api.github.com/users/fire/repos","events_url":"https://api.github.com/users/fire/events{/privacy}","received_events_url":"https://api.github.com/users/fire/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-12-17T18:57:42Z","updated_at":"2025-12-17T18:57:50Z","body":"@TokageItLab mentioned preference that we swap from a shader based visualizer to a wireframe visualizer.\r\n\r\nSo we are waiting for 4.7+ for a wireframe visualizer for kusudama swing twist.","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3666733961/reactions","total_count":2,"+1":2,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3695293113","html_url":"https://github.com/godotengine/godot/pull/113640#issuecomment-3695293113","issue_url":"https://api.github.com/repos/godotengine/godot/issues/113640","id":3695293113,"node_id":"IC_kwDOAO6SJc7cQbK5","user":{"login":"TokageItLab","id":61938263,"node_id":"MDQ6VXNlcjYxOTM4MjYz","avatar_url":"https://avatars.githubusercontent.com/u/61938263?v=4","gravatar_id":"","url":"https://api.github.com/users/TokageItLab","html_url":"https://github.com/TokageItLab","followers_url":"https://api.github.com/users/TokageItLab/followers","following_url":"https://api.github.com/users/TokageItLab/following{/other_user}","gists_url":"https://api.github.com/users/TokageItLab/gists{/gist_id}","starred_url":"https://api.github.com/users/TokageItLab/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/TokageItLab/subscriptions","organizations_url":"https://api.github.com/users/TokageItLab/orgs","repos_url":"https://api.github.com/users/TokageItLab/repos","events_url":"https://api.github.com/users/TokageItLab/events{/privacy}","received_events_url":"https://api.github.com/users/TokageItLab/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-12-29T02:36:23Z","updated_at":"2025-12-29T02:40:44Z","body":"I tried to draw a wireframe by culling the mesh as segments, similar to Boolean modeling.\r\n\r\nIt should be fine in theory, but it appears broken. I obtained the boundaries from the `_solve()` result, but the `_solve()` result seems to lack continuity. In other words, it means that even though it is within the boundary, the direction may be changed by `_solve()`. Is this a bug? Or is it intended behavior?\r\n\r\n<img width=\"1194\" height=\"573\" alt=\"image\" src=\"https://github.com/user-attachments/assets/9d83f669-c2d3-4000-b533-932b65142dd6\" />\r\n\r\nhttps://github.com/user-attachments/assets/5f6cde1a-4775-45ec-991b-6d4a13a6399e\r\n\r\nFor example, as shown in the video, the bouncing motion looks like a glitch.\r\n\r\n[ksdemo.zip](https://github.com/user-attachments/files/24363225/ksdemo.zip)","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3695293113/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3770968692","html_url":"https://github.com/godotengine/godot/pull/113640#issuecomment-3770968692","issue_url":"https://api.github.com/repos/godotengine/godot/issues/113640","id":3770968692,"node_id":"IC_kwDOAO6SJc7gxGp0","user":{"login":"TokageItLab","id":61938263,"node_id":"MDQ6VXNlcjYxOTM4MjYz","avatar_url":"https://avatars.githubusercontent.com/u/61938263?v=4","gravatar_id":"","url":"https://api.github.com/users/TokageItLab","html_url":"https://github.com/TokageItLab","followers_url":"https://api.github.com/users/TokageItLab/followers","following_url":"https://api.github.com/users/TokageItLab/following{/other_user}","gists_url":"https://api.github.com/users/TokageItLab/gists{/gist_id}","starred_url":"https://api.github.com/users/TokageItLab/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/TokageItLab/subscriptions","organizations_url":"https://api.github.com/users/TokageItLab/orgs","repos_url":"https://api.github.com/users/TokageItLab/repos","events_url":"https://api.github.com/users/TokageItLab/events{/privacy}","received_events_url":"https://api.github.com/users/TokageItLab/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-01-20T04:18:07Z","updated_at":"2026-01-20T04:18:07Z","body":"I found two points that need improvement, so I'll see if I can fix them later.\r\n\r\n1. Quaternion property is not intuitive, so we probably need to specify a Vector3 equivalent to the axis in axis-angle and normalize it internally (since several SkeletonModifiers, like SpringBone's Gravity, already use this approach)\r\n2. The Gizmo collapses in cases where the hole is too small or too large:\r\n\r\nNormal case:\r\n<img width=\"1065\" height=\"551\" alt=\"image\" src=\"https://github.com/user-attachments/assets/48a7cdc3-0792-4f74-978f-b37164d5e6b8\" />\r\n\r\nToo small:\r\n<img width=\"1039\" height=\"532\" alt=\"image\" src=\"https://github.com/user-attachments/assets/a7e49b51-3117-4bcb-bc7b-2f2d570fa0fa\" />\r\n\r\nToo large:\r\n<img width=\"1037\" height=\"539\" alt=\"image\" src=\"https://github.com/user-attachments/assets/e1ac6d24-8368-4eef-a5ba-50bff26bceca\" />\r\n","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3770968692/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3771223418","html_url":"https://github.com/godotengine/godot/pull/113640#issuecomment-3771223418","issue_url":"https://api.github.com/repos/godotengine/godot/issues/113640","id":3771223418,"node_id":"IC_kwDOAO6SJc7gyE16","user":{"login":"fire","id":32321,"node_id":"MDQ6VXNlcjMyMzIx","avatar_url":"https://avatars.githubusercontent.com/u/32321?v=4","gravatar_id":"","url":"https://api.github.com/users/fire","html_url":"https://github.com/fire","followers_url":"https://api.github.com/users/fire/followers","following_url":"https://api.github.com/users/fire/following{/other_user}","gists_url":"https://api.github.com/users/fire/gists{/gist_id}","starred_url":"https://api.github.com/users/fire/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/fire/subscriptions","organizations_url":"https://api.github.com/users/fire/orgs","repos_url":"https://api.github.com/users/fire/repos","events_url":"https://api.github.com/users/fire/events{/privacy}","received_events_url":"https://api.github.com/users/fire/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-01-20T06:19:52Z","updated_at":"2026-01-30T20:14:13Z","body":"I can revert it back to vector3.\r\n\r\nThe other requires some help.","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3771223418/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":{"reason":"outdated"}},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3771395289","html_url":"https://github.com/godotengine/godot/pull/113640#issuecomment-3771395289","issue_url":"https://api.github.com/repos/godotengine/godot/issues/113640","id":3771395289,"node_id":"IC_kwDOAO6SJc7gyuzZ","user":{"login":"fire","id":32321,"node_id":"MDQ6VXNlcjMyMzIx","avatar_url":"https://avatars.githubusercontent.com/u/32321?v=4","gravatar_id":"","url":"https://api.github.com/users/fire","html_url":"https://github.com/fire","followers_url":"https://api.github.com/users/fire/followers","following_url":"https://api.github.com/users/fire/following{/other_user}","gists_url":"https://api.github.com/users/fire/gists{/gist_id}","starred_url":"https://api.github.com/users/fire/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/fire/subscriptions","organizations_url":"https://api.github.com/users/fire/orgs","repos_url":"https://api.github.com/users/fire/repos","events_url":"https://api.github.com/users/fire/events{/privacy}","received_events_url":"https://api.github.com/users/fire/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-01-20T07:20:13Z","updated_at":"2026-01-30T20:14:21Z","body":"Do you think we should allow radius 0 or clamp radius to epsilon? Like allow open or clamp to a point. These have different behaviors.\r\n\r\nEdited:\r\n\r\nFor default behaviour.","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3771395289/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":{"reason":"outdated"}},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3787572320","html_url":"https://github.com/godotengine/godot/pull/113640#issuecomment-3787572320","issue_url":"https://api.github.com/repos/godotengine/godot/issues/113640","id":3787572320,"node_id":"IC_kwDOAO6SJc7hwcRg","user":{"login":"celyk","id":50609684,"node_id":"MDQ6VXNlcjUwNjA5Njg0","avatar_url":"https://avatars.githubusercontent.com/u/50609684?v=4","gravatar_id":"","url":"https://api.github.com/users/celyk","html_url":"https://github.com/celyk","followers_url":"https://api.github.com/users/celyk/followers","following_url":"https://api.github.com/users/celyk/following{/other_user}","gists_url":"https://api.github.com/users/celyk/gists{/gist_id}","starred_url":"https://api.github.com/users/celyk/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/celyk/subscriptions","organizations_url":"https://api.github.com/users/celyk/orgs","repos_url":"https://api.github.com/users/celyk/repos","events_url":"https://api.github.com/users/celyk/events{/privacy}","received_events_url":"https://api.github.com/users/celyk/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-01-23T00:36:25Z","updated_at":"2026-01-23T01:16:30Z","body":"I recommend changing the way the sphere is rendered. With wireframe it looks very busy and takes away from the constraint. Either render it solid with transparency or use points instead of lines.\r\n\r\nSee attached project for an example using a shader to render a transparent sphere. But you don't need a shader to do that.\r\n\r\nThe boundary isoline should be rendered with lines like you have already, but to render the sphere with transparency you need to do it in 2 steps: back faces then front faces.\r\n\r\n<img width=\"402\" height=\"238\" alt=\"image\" src=\"https://github.com/user-attachments/assets/b0da728a-8f0d-4f65-92e2-c747470d1d96\" />\r\n\r\n[transparent-sphere-example.zip](https://github.com/user-attachments/files/24811044/transparent-sphere-example.zip)\r\n","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3787572320/reactions","total_count":1,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":1},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3790958557","html_url":"https://github.com/godotengine/godot/pull/113640#issuecomment-3790958557","issue_url":"https://api.github.com/repos/godotengine/godot/issues/113640","id":3790958557,"node_id":"IC_kwDOAO6SJc7h9W_d","user":{"login":"TokageItLab","id":61938263,"node_id":"MDQ6VXNlcjYxOTM4MjYz","avatar_url":"https://avatars.githubusercontent.com/u/61938263?v=4","gravatar_id":"","url":"https://api.github.com/users/TokageItLab","html_url":"https://github.com/TokageItLab","followers_url":"https://api.github.com/users/TokageItLab/followers","following_url":"https://api.github.com/users/TokageItLab/following{/other_user}","gists_url":"https://api.github.com/users/TokageItLab/gists{/gist_id}","starred_url":"https://api.github.com/users/TokageItLab/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/TokageItLab/subscriptions","organizations_url":"https://api.github.com/users/TokageItLab/orgs","repos_url":"https://api.github.com/users/TokageItLab/repos","events_url":"https://api.github.com/users/TokageItLab/events{/privacy}","received_events_url":"https://api.github.com/users/TokageItLab/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-01-23T16:00:52Z","updated_at":"2026-01-23T16:09:43Z","body":"Indeed, since the visibility of the frontface and backface isn't great with wireframe, then using surfaces might be preferable. (Though it was fortunate that a continuity bug in the solver was discovered and fixed as a byproduct of the icosahedron)\r\n\r\nUsing lines the same color as other LimitationGizmos (ConeShape) on the edges is good for consistency. If surfaces use a same color with reduced transparency, that consistency would be maintained there.","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3790958557/