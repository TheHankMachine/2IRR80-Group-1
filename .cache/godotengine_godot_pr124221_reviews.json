[{"id":5481371123,"node_id":"PRR_kwDOAO6SJc8AAAABRrcV8w","user":{"login":"m4sternoob","id":75505520,"node_id":"MDQ6VXNlcjc1NTA1NTIw","avatar_url":"https://avatars.githubusercontent.com/u/75505520?u=c4e7c7a7a83b554c2f6f8ef8237fad5f589005d7&v=4","gravatar_id":"","url":"https://api.github.com/users/m4sternoob","html_url":"https://github.com/m4sternoob","followers_url":"https://api.github.com/users/m4sternoob/followers","following_url":"https://api.github.com/users/m4sternoob/following{/other_user}","gists_url":"https://api.github.com/users/m4sternoob/gists{/gist_id}","starred_url":"https://api.github.com/users/m4sternoob/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/m4sternoob/subscriptions","organizations_url":"https://api.github.com/users/m4sternoob/orgs","repos_url":"https://api.github.com/users/m4sternoob/repos","events_url":"https://api.github.com/users/m4sternoob/events{/privacy}","received_events_url":"https://api.github.com/users/m4sternoob/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"Verified against the implementation: in `scene/3d/skeleton_3d.cpp`, `_update_bone_global_pose()` builds each bone's global pose by multiplying the bone's local pose onto its parent's global pose (`global_pose *= bone_pose`), so the pose position is expressed in the parent bone's space — or the Skeleton3D's own space for root bones. The old wording claiming Skeleton3D-local space was incorrect for any bone with a parent.\n\nThis also brings the position docs in line with `get_bone_pose_rotation`, which already describes its value as parent-relative. The correction looks right to me.","state":"COMMENTED","html_url":"https://github.com/godotengine/godot/pull/124221#pullrequestreview-5481371123","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/124221","author_association":"NONE","_links":{"html":{"href":"https://github.com/godotengine/godot/pull/124221#pullrequestreview-5481371123"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/124221"}},"submitted_at":"2026-10-11T00:43:36Z","commit_id":"00e90a203fc5de4ded4bd4916c34af64be6c0664"}]