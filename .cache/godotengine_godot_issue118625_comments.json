ithub.com/users/romlok/following{/other_user}","gists_url":"https://api.github.com/users/romlok/gists{/gist_id}","starred_url":"https://api.github.com/users/romlok/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/romlok/subscriptions","organizations_url":"https://api.github.com/users/romlok/orgs","repos_url":"https://api.github.com/users/romlok/repos","events_url":"https://api.github.com/users/romlok/events{/privacy}","received_events_url":"https://api.github.com/users/romlok/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-04-16T11:25:32Z","updated_at":"2026-04-16T11:25:32Z","body":"This also affects me on KDE+Wayland, so isn't GNOME specific.\n\nLooks like it's because the engine currently is limited to setting the scale once on start-up, and doesn't react in real-time? Possibly related issues: https://github.com/godotengine/godot/issues/110496, https://github.com/godotengine/godot/issues/56341\n","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4259656814/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4536026394","html_url":"https://github.com/godotengine/godot/issues/118625#issuecomment-4536026394","issue_url":"https://api.github.com/repos/godotengine/godot/issues/118625","id":4536026394,"node_id":"IC_kwDOAO6SJc8AAAABDl5FGg","user":{"login":"deralmas","id":31065808,"node_id":"MDQ6VXNlcjMxMDY1ODA4","avatar_url":"https://avatars.githubusercontent.com/u/31065808?v=4","gravatar_id":"","url":"https://api.github.com/users/deralmas","html_url":"https://github.com/deralmas","followers_url":"https://api.github.com/users/deralmas/followers","following_url":"https://api.github.com/users/deralmas/following{/other_user}","gists_url":"https://api.github.com/users/deralmas/gists{/gist_id}","starred_url":"https://api.github.com/users/deralmas/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/deralmas/subscriptions","organizations_url":"https://api.github.com/users/deralmas/orgs","repos_url":"https://api.github.com/users/deralmas/repos","events_url":"https://api.github.com/users/deralmas/events{/privacy}","received_events_url":"https://api.github.com/users/deralmas/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-05-25T17:28:44Z","updated_at":"2026-05-25T17:28:53Z","body":"> Looks like it's because the engine currently is limited to setting the scale once on start-up, and doesn't react in real-time?\n\nIndeed.\n\nActually, I think that this is further highlighted by fractional scaling. With integer (buffer) scaling we just pick the max known scale (like with the MacOS backend), rendering a huge buffer with proportional UI. This isn't possible with fractional scaling, especially if we want to achieve a pixel-perfect look.","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4536026394/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null}]