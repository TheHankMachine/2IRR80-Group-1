[{"id":2759268049,"node_id":"PRR_kwDOAO6SJc6kdxbR","state":"COMMENTED","user":{"site_admin":false,"suspended":false,"updated_at":"0001-01-01T00:00:00Z","avatar_url":"https://avatars.githubusercontent.com/u/3176062?v=4","created_at":"0001-01-01T00:00:00Z","followers":0,"following":0,"html_url":"https://github.com/kiroxas","id":3176062,"node_id":"MDQ6VXNlcjMxNzYwNjI=","login":"kiroxas","type":"User","owned_private_repos":0,"public_gists":0,"public_repos":0,"total_private_repos":0,"url":"https://api.github.com/users/kiroxas"},"body":"We could still use Vector with resize, and then get the ptr, and fill it _manually_, which involve keeping indexes for each one, but it avoids the last copies. This is definitely harder to write and more error prone, so this version is a good trade off. \r\nOn another note, I see a lot of those LocalVector + resize lately, which may tell us it would be good a to add a LocalVector constructor which takes a size to reserve to make it even easier to write. ","html_url":"https://github.com/godotengine/godot/pull/105264#pullrequestreview-2759268049","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/105264","author_association":"CONTRIBUTOR","submitted_at":"2025-04-11T06:28:55Z"},{"id":2759460807,"node_id":"PRR_kwDOAO6SJc6kegfH","state":"APPROVED","user":{"site_admin":false,"suspended":false,"updated_at":"0001-01-01T00:00:00Z","avatar_url":"https://avatars.githubusercontent.com/u/52464204?u=4854f17c9d330a8a9d274f0cb7b943fc2bb6dd44&v=4","created_at":"0001-01-01T00:00:00Z","followers":0,"following":0,"html_url":"https://github.com/smix8","id":52464204,"node_id":"MDQ6VXNlcjUyNDY0MjA0","login":"smix8","type":"User","owned_private_repos":0,"public_gists":0,"public_repos":0,"total_private_repos":0,"url":"https://api.github.com/users/smix8"},"body":"","html_url":"https://github.com/godotengine/godot/pull/105264#pullrequestreview-2759460807","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/105264","author_a