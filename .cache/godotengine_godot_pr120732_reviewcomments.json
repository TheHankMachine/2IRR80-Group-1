ifetimebound]]\r\n#  elif __has_cpp_attribute (gnu::lifetimebound)\r\n#    define _LIFETIME_BOUND_ [[gnu::lifetimebound]]\r\n#  elif __has_cpp_attribute (lifetimebound)\r\n#    define _LIFETIME_BOUND_ [[lifetimebound]]\r\n#  endif\r\n#endif\r\n\r\n#ifndef _LIFETIME_BOUND_\r\n#define _LIFETIME_BOUND_ NOT_FOUND_SORRY\r\n#endif\r\n\r\n\r\n_LIFETIME_BOUND_\r\n```\r\n\r\n```\r\n$ clang++ -std=c++11 -E attr.cpp \r\n# 1 \"attr.cpp\"\r\n# 1 \"<built-in>\" 1\r\n# 1 \"<built-in>\" 3\r\n# 448 \"<built-in>\" 3\r\n# 1 \"<command line>\" 1\r\n# 1 \"<built-in>\" 2\r\n# 1 \"attr.cpp\" 2\r\n# 16 \"attr.cpp\"\r\n[[clang::lifetimebound]]\r\n\r\n$ g++ -std=c++11 -E attr.cpp \r\n# 0 \"attr.cpp\"\r\n# 0 \"<built-in>\"\r\n# 0 \"<command-line>\"\r\n# 1 \"/usr/include/stdc-predef.h\" 1 3\r\n# 0 \"<command-line>\" 2\r\n# 1 \"attr.cpp\"\r\n# 16 \"attr.cpp\"\r\nNOT_FOUND_SORRY\r\n\r\n$ clang++ --version\r\nclang version 22.1.8 (Fedora 22.1.8-1.fc44)\r\n$ gcc --version\r\ngcc (GCC) 16.1.1 20260515 (Red Hat 16.1.1-2)\r\n```\r\n\r\n","created_at":"2026-06-29T14:13:38Z","updated_at":"2026-06-29T14:13:38Z","html_url":"https://github.com/godotengine/godot/pull/120732#discussion_r3492338961","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/120732","_links":{"self":{"href":"https://api.github.com/repos/godotengine/godot/pulls/comments/3492338961"},"html":{"href":"https://github.com/godotengine/godot/pull/120732#discussion_r3492338961"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/120732"}},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/3492338961/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":null,"original_line":130,"side":"RIGHT","in_reply_to_id":3492299874,"author_association":"MEMBER","original_position":4,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/god