[{"id":3100304924,"node_id":"PRR_kwDOAO6SJc64yuYc","user":{"login":"mihe","id":4884246,"node_id":"MDQ6VXNlcjQ4ODQyNDY=","avatar_url":"https://avatars.githubusercontent.com/u/4884246?v=4","gravatar_id":"","url":"https://api.github.com/users/mihe","html_url":"https://github.com/mihe","followers_url":"https://api.github.com/users/mihe/followers","following_url":"https://api.github.com/users/mihe/following{/other_user}","gists_url":"https://api.github.com/users/mihe/gists{/gist_id}","starred_url":"https://api.github.com/users/mihe/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/mihe/subscriptions","organizations_url":"https://api.github.com/users/mihe/orgs","repos_url":"https://api.github.com/users/mihe/repos","events_url":"https://api.github.com/users/mihe/events{/privacy}","received_events_url":"https://api.github.com/users/mihe/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"I would probably not consider this to fix #105987, since it doesn't actually resolve the discrepancy between the two engines. #106018 is likely the only real fix, since the way Godot Physics calculates damping seems somewhat questionable. However, with that being a breaking change I'm not sure it'll ever be merged at this point, especially considering Godot Physics 3D will likely be phased out in a not too distant future.\n\nAnyway, that doesn't mean we can't merge this change. However, I would probably say we should use an `or_greater` property hint instead, rather than just setting the maximum value to some arbitrary number. With that the slider will still be between 0 and 1 (for now) but you should still be able to manually type in values higher than 1.\n\nYou can see an example of `or_greater` being used with the `shrinking_factor` property just a few lines above.\n\nYou'll want to also revert your change to `godot_soft_body_3d.h` in that case.","state":"CHANGES_REQUESTED","html_url":"https://github.com/godotengine/godot/pull/109419#pullrequestreview-3100304924","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/109419","author_association":"CONTRIBUTOR","_links":{"html":{"href":"https://github.com/godotengine/godot/pull/109419#pullrequestreview-3100304924"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/109419"}},"submitted_at":"2025-08-08T10:35:39Z","commit_id":null},{"id":3100537874,"node_id":"PRR_kwDOAO6SJc64znQS","user":{"login":"mihe","id":4884246,"node_id":"MDQ6VXNlcjQ4ODQyNDY=","avatar_url":"https://avatars.githubusercontent.com/u/4884246?v=4","gravatar_id":"","url":"https://api.github.com/users/mihe","html_url":"https://github.com/mihe","followers_url":"https://api.github.com/users/mihe/followers","following_url":"https://api.github.com/users/mihe/following{/other_user}","gists_url":"https://api.github.com/users/mihe/gists{/gist_id}","starred_url":"https://api.github.com/users/mihe/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/mihe/subscriptions","organizations_url":"https://api.github.com/users/mihe/orgs","repos_url":"https://api.github.com/users/mihe/repos","events_url":"https://api.github.com/users/mihe/events{/privacy}","received_events_url":"https://api.github.com/users/mihe/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"","state":"APPROVED","html_url":"https://github.com/godotengine/godot/pull/109419#pullrequestreview-3100537874","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/109419","author_association":"CONTRIBUTOR","_links":{"html":{"href":"https://github.com/godotengine/godot/pull/109419#pullrequestreview-3100537874"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/109419"}},"submitted_at":"2025-08-08T12:01:46Z","commit_id":"1ff94e782ca8f52d6f62348f38a4782aea0e6a42"}]