3310/following{/other_user}","gists_url":"https://api.github.com/users/BlueCube3310/gists{/gist_id}","starred_url":"https://api.github.com/users/BlueCube3310/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/BlueCube3310/subscriptions","organizations_url":"https://api.github.com/users/BlueCube3310/orgs","repos_url":"https://api.github.com/users/BlueCube3310/repos","events_url":"https://api.github.com/users/BlueCube3310/events{/privacy}","received_events_url":"https://api.github.com/users/BlueCube3310/received_events","type":"User","user_view_type":"public","site_admin":false},"author_association":"NONE","issue_field_values":[],"type":null,"active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"### Tested versions\n\nReproducible in 4.4 stable\n\nNon reproducible in 4.3 stable\n\n### System information\n\nGodot v4.4.stable - Windows 11 (build 26100) - Multi-window, 2 monitors - OpenGL 3 (Compatibility) - AMD Radeon RX 7900 GRE (Advanced Micro Devices, Inc.; 32.0.12033.1030) - AMD Ryzen 7 7700X 8-Core Processor (16 threads)\n\n### Issue description\n\n![Image](https://github.com/user-attachments/assets/68556133-58af-43f8-8c4c-dc4e9cbe0fb1)\n\nTextures are black when Godot project is exported to web. I have tried all rendering methods, and have had a friend recreate the issue on his own system. I uploaded to Itch and Newgrounds and it was the same on both platforms. The included Godot robot .svg seems to remain visible though. The issue does not seem to exist on previous Godot version. I have recreated the exact same project on different versions, and only in 4.4 does this issue occur. Exporting to .exe works with no issues.\n\n### Steps to reproduce\n\nCreate a scene with an object that you can apply a texture to (mesh, sprite3D). Have a camera view the object. Export and upload to web.\n\n\n### Minimal reproduction project (MRP)\n\n[Godot bug MRP.zip](https://github.com/user-attachments/files/19278294/Godot.bug.MRP.zip)\n\n![Image](https://github.com/user-attachments/assets/4a01e008-79d1-4f9c-a019-3c5f278be4f0)\nexample of what the MRP looks like when exported to web","closed_by":{"login":"Repiteo","id":17489292,"node_id":"MDQ6VXNlcjE3NDg5Mjky","avatar_url":"https://avatars.githubusercontent.com/u/17489292?v=4","gravatar_id":"","url":"https://api.github.com/users/Repiteo","html_url":"https://github.com/Repiteo","followers_url":"https://api.github.com/users/Repiteo/followers","following_url":"https://api.github.com/users/Repiteo/following{/other_user}","gists_url":"https://api.github.com/users/Repiteo/gists{/gist_id}","starred_url":"https://api.github.com/users/Repiteo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Repiteo/subscriptions","organizations_url":"https://api.github.com/users/Repiteo/orgs","repos_url":"https://api.github.com/users/Repiteo/repos","events_url":"https://api.github.com/users/Repiteo/events{/privacy}","received_events_url":"https://api.github.com/users/Repiteo/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/104260/reactions","total_count":5,"+1":2,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":3},"timeline_url":"https://api.github.com/repos/godotengine/godot/issues/104260/timeline","performed_via_github_app":null,"state_reason":"completed","pinned_comment":null}