s{/gist_id}","starred_url":"https://api.github.com/users/Repiteo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Repiteo/subscriptions","organizations_url":"https://api.github.com/users/Repiteo/orgs","repos_url":"https://api.github.com/users/Repiteo/repos","events_url":"https://api.github.com/users/Repiteo/events{/privacy}","received_events_url":"https://api.github.com/users/Repiteo/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2024-11-18T15:30:51Z","updated_at":"2024-11-18T15:30:51Z","body":"Thanks!","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2483384870/reactions","total_count":2,"+1":0,"-1":0,"laugh":0,"hooray":2,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3888163067","html_url":"https://github.com/godotengine/godot/pull/98683#issuecomment-3888163067","issue_url":"https://api.github.com/repos/godotengine/godot/issues/98683","id":3888163067,"node_id":"IC_kwDOAO6SJc7nwKj7","user":{"login":"PureAsbestos","id":16106576,"node_id":"MDQ6VXNlcjE2MTA2NTc2","avatar_url":"https://avatars.githubusercontent.com/u/16106576?v=4","gravatar_id":"","url":"https://api.github.com/users/PureAsbestos","html_url":"https://github.com/PureAsbestos","followers_url":"https://api.github.com/users/PureAsbestos/followers","following_url":"https://api.github.com/users/PureAsbestos/following{/other_user}","gists_url":"https://api.github.com/users/PureAsbestos/gists{/gist_id}","starred_url":"https://api.github.com/users/PureAsbestos/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/PureAsbestos/subscriptions","organizations_url":"https://api.github.com/users/PureAsbestos/orgs","repos_url":"https://api.github.com/users/PureAsbestos/repos","events_url":"https://api.github.com/users/PureAsbestos/events{/privacy}","received_events_url":"https://api.github.com/users/PureAsbestos/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-02-12T01:29:38Z","updated_at":"2026-02-12T01:29:38Z","body":"Note that `RenderingServer.set_debug_generate_wireframes(true)` needs to be called before the mesh has *ever* been loaded (due to caching I assume), and if the mesh is included in a scene, when that scene is loaded the mesh will be loaded before any user code within that scene can make the call. Similarly, using `preload()` to load the mesh will always fail. This only works for meshes/scenes that are added dynamically at runtime with `load()`, that have not been previously loaded. It might be worth adding a project setting for the default value. That would allow meshes in the startup scene to use wireframes, allow preloading wireframe meshes, etc.","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3888163067/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3909685107","html_url":"https://github.com/godotengine/godot/pull/98683#issuecomment-3909685107","issue_url":"https://api.github.com/repos/godotengine/godot/issues/98683","id":3909685107,"node_id":"IC_kwDOAO6SJc7pCQ9z","user":{"login":"Calinou","id":180032,"node_id":"MDQ6VXNlcjE4MDAzMg==","avatar_url":"https://avatars.githubusercontent.com/u/180032?v=4","gravatar_id":"","url":"https://api.github.com/users/Calinou","html_url":"https://github.com/Calinou","followers_url":"https://api.github.com/users/Calinou/followers","following_url":"https://api.github.com/users/Calinou/following{/other_user}","gists_url":"https://api.github.com/users/Calinou/gists{/gist_id}","starred_url":"https://api.github.com/users/Calinou/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Calinou/subscriptions","organizations_url":"https://api.github.com/users/Calinou/orgs","repos_url":"https://api.github.com/users/Calinou/repos","events_url":"https://api.github.com/users/Calinou/events{/privacy}","received_events_url":"https://api.github.com/users/Calinou/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-02-16T17:24:13Z","updated_at":"2026-02-16T17:42:20Z","body":"> Similarly, using `preload()` to load the mesh will always fail.\r\n\r\nThis seems to work using an autoload script to call `RenderingServer.set_debug_generate_wireframes(true)` on my end:\r\n\r\n[test_wireframe_compatibility.zip](https://github.com/user-attachments/files/25346786/test_wireframe_compatibility.zip)\r\n\r\nNonetheless, I've opened a proposal to track this as it would be more convenient:\r\n\r\n- https://github.com/godotengine/godot-proposals/issues/14249","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3909685107/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null}]