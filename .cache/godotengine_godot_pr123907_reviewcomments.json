region) {\n+\t\twl_region_destroy(ws.region);\n+\t}\n+\tws.region = nullptr;\n+\n+\tif (ws.mpass) {\n+\t\tws.region = wl_compositor_create_region(registry.wl_compositor);\n+\t} else if (!p_region.is_empty()) {\n+\t\tws.region = wl_compositor_create_region(registry.wl_compositor);\n+\n+\t\tdouble win_scale = window_state_get_scale_factor(&ws);\n+\t\tSize2i scaled_size = scale_vector2i(ws.rect.size, win_scale);\n+\t\tfor (int x = 0; x < scaled_size.x; x++) {\n+\t\t\tfor (int y = 0; y < scaled_size.y; y++) {\n+\t\t\t\tVector2 point = Vector2(x, y);\n+\t\t\t\tif (Geometry2D::is_point_in_polygon(point, ws.region_path)) {\n+\t\t\t\t\tpoint = scale_vector2i(point, 1.0 / win_scale);","path":"platform/linuxbsd/wayland/wayland_thread.cpp","commit_id":"ce6d760b317d56ed850eeaf45ea2dade4431d967","original_commit_id":"898de66ae83716e8f72782f87af216ebdce5b24e","user":{"login":"deralmas","id":31065808,"node_id":"MDQ6VXNlcjMxMDY1ODA4","avatar_url":"https://avatars.githubusercontent.com/u/31065808?v=4","gravatar_id":"","url":"https://api.github.com/users/deralmas","html_url":"https://github.com/deralmas","followers_url":"https://api.github.com/users/deralmas/followers","following_url":"https://api.github.com/users/deralmas/following{/other_user}","gists_url":"https://api.github.com/users/deralmas/gists{/gist_id}","starred_url":"https://api.github.com/users/deralmas/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/deralmas/subscriptions","organizations_url":"https://api.github.com/users/deralmas/orgs","repos_url":"https://api.github.com/users/deralmas/repos","events_url":"https://api.github.com/users/deralmas/events{/privacy}","received_events_url":"https://api.github.com/users/deralmas/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"Just for reference: took me a sec to figure out that this was being (correctly) rescaled back into \"logical\" size (surface-local coordinates as per spec) xD\r\n\r\nI'd propose a comment but a