[{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4927764931","html_url":"https://github.com/godotengine/godot/pull/120891#issuecomment-4927764931","issue_url":"https://api.github.com/repos/godotengine/godot/issues/120891","id":4927764931,"node_id":"IC_kwDOAO6SJc8AAAABJbe5ww","user":{"login":"HolonProduction","id":99511741,"node_id":"U_kgDOBe5tvQ","avatar_url":"https://avatars.githubusercontent.com/u/99511741?v=4","gravatar_id":"","url":"https://api.github.com/users/HolonProduction","html_url":"https://github.com/HolonProduction","followers_url":"https://api.github.com/users/HolonProduction/followers","following_url":"https://api.github.com/users/HolonProduction/following{/other_user}","gists_url":"https://api.github.com/users/HolonProduction/gists{/gist_id}","starred_url":"https://api.github.com/users/HolonProduction/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/HolonProduction/subscriptions","organizations_url":"https://api.github.com/users/HolonProduction/orgs","repos_url":"https://api.github.com/users/HolonProduction/repos","events_url":"https://api.github.com/users/HolonProduction/events{/privacy}","received_events_url":"https://api.github.com/users/HolonProduction/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-07-09T17:19:49Z","updated_at":"2026-07-09T17:19:49Z","body":"Thanks for your interest in fixing this issue! Regarding the approach, I think instead of trying to solve this in the parser we should actually move the increasing of `usages` to `reduce_identifier` in the analyzer.\r\n\r\nIn contrast to `parse_identifier`, `reduce_identifier` already only operates on identifiers that are actual expressions and not part of an attribute access. Also for class members we already handle `usages` in the analyzer so this would be consistent.\r\n\r\nSince `reduce_identifier` is called much later than the parser this would also require moving the emission of those warnings.\r\n\r\nFor local variables/constants/binds that would probably be at the very end of `resolve_suite`. For function parameters at the very end of `resolve_function_body`.\r\n\r\nAre you interested in working on this?","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4927764931/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4928246822","html_url":"https://github.com/godotengine/godot/pull/120891#issuecomment-4928246822","issue_url":"https://api.github.com/repos/godotengine/godot/issues/120891","id":4928246822,"node_id":"IC_kwDOAO6SJc8AAAABJb8UJg","user":{"login":"mattigu","id":47303532,"node_id":"MDQ6VXNlcjQ3MzAzNTMy","avatar_url":"https://avatars.githubusercontent.com/u/47303532?v=4","gravatar_id":"","url":"https://api.github.com/users/mattigu","html_url":"https://github.com/mattigu","followers_url":"https://api.github.com/users/mattigu/followers","following_url":"https://api.github.com/users/mattigu/following{/other_user}","gists_url":"https://api.github.com/users/mattigu/gists{/gist_id}","starred_url":"https://api.github.com/users/mattigu/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/mattigu/subscriptions","organizations_url":"https://api.github.com/users/mattigu/orgs","repos_url":"https://api.github.com/users/mattigu/repos","events_url":"https://api.github.com/users/mattigu/events{/privacy}","received_events_url":"https://api.github.com/users/mattigu/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-07-09T18:22:01Z","updated_at":"2026-07-09T18:22:01Z","body":"Yes, I'll give it a try.","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4928246822/reactions","total_count":1,"+1":0,"-1":0,"laugh":0,"hooray":1,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4938837026","html_url":"https://github.com/godotengine/godot/pull/120891#issuecomment-4938837026","issue_url":"https://api.github.com/repos/godotengine/godot/issues/120891","id":4938837026,"node_id":"IC_kwDOAO6SJc8AAAABJmCsIg","user":{"login":"mattigu","id":47303532,"node_id":"MDQ6VXNlcjQ3MzAzNTMy","avatar_url":"https://avatars.githubusercontent.com/u/47303532?v=4","gravatar_id":"","url":"https://api.github.com/users/mattigu","html_url":"https://github.com/mattigu","followers_url":"https://api.github.com/users/mattigu/followers","following_url":"https://api.github.com/users/mattigu/following{/other_user}","gists_url":"https://api.github.com/users/mattigu/gists{/gist_id}","starred_url":"https://api.github.com/users/mattigu/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/mattigu/subscriptions","organizations_url":"https://api.github.com/users/mattigu/orgs","repos_url":"https://api.github.com/users/mattigu/repos","events_url":"https://api.github.com/users/mattigu/events{/privacy}","received_events_url":"https://api.github.com/users/mattigu/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-07-10T19:33:49Z","updated_at":"2026-07-10T19:33:49Z","body":"Uhhh sorry I'm having some issues with git","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4938837026/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4939875565","html_url":"https://github.com/godotengine/godot/pull/120891#issuecomment-4939875565","issue_url":"https://api.github.com/repos/godotengine/godot/issues/120891","id":4939875565,"node_id":"IC_kwDOAO6SJc8AAAABJnCE7Q","user":{"login":"mattigu","id":47303532,"node_id":"MDQ6VXNlcjQ3MzAzNTMy","avatar_url":"https://avatars.githubusercontent.com/u/47303532?v=4","gravatar_id":"","url":"https://api.github.com/users/mattigu","html_url":"https://github.com/mattigu","followers_url":"https://api.github.com/users/mattigu/followers","following_url":"https://api.github.com/users/mattigu/following{/other_user}","gists_url":"https://api.github.com/users/mattigu/gists{/gist_id}","starred_url":"https://api.github.com/users/mattigu/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/mattigu/subscriptions","organizations_url":"https://api.github.com/users/mattigu/orgs","repos_url":"https://api.github.com/users/mattigu/repos","events_url":"https://api.github.com/users/mattigu/events{/privacy}","received_events_url":"https://api.github.com/users/mattigu/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-07-10T22:01:14Z","updated_at":"2026-07-10T22:01:14Z","body":"I managed to save this branch, sorry for the issues. I implemented this just like you suggested, thank you for the detailed tips.\r\n\r\nThere are a lot of file changes, since I moved the `unused_x` warnings tests to the analyzer directory, and had to change the order of warnings in some tests, since now they are emitted later.\r\n\r\nThere was an unexpected edge case with binding `match` when using `when`. The part after `when` is actually a `SuiteNode` which gets injected with the bind pattern on the left. I will explain based on the test which caught this.\r\n\r\n```gdscript\r\nvar a = 0\r\nvar b = 1\r\nmatch a:\r\n\tvar a_bind when b == 0:\r\n\t\tprints(\"a is\", a_bind, \"and b is 0\")\r\n\tvar a_bind when b == 1:\r\n\t\tprints(\"a is\", a_bind, \"and b is 1\")\r\n\t_:\r\n\t\tprint(\"does not run\")\r\n```\r\nHere `a_bind` is injected into the suite `b == 0` as a local. After my change, `resolve_suite`  will iterate locals and report `a_bind` as unused, even though it may be used in the branch suite. \r\n\r\nI solved this for now by adding a `bool` parameter to `resolve_suite` since it's the simplest way to show and confirm the problem and I wasn't sure what would be the best fix. \r\n\r\nMaybe I could handle the `unused` errors as a special case in `resolve_match_branch` right after resolving both suites.\r\nhttps://github.com/godotengine/godot/blob/2c089e9bf0b8712d0bc444c2ceaf9c543ed9c777/modules/gdscript/gdscript_analyzer.cpp#L2469-L2473","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4939875565/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4957502053","html_url":"https://github.com/godotengine/godot/pull/120891#issuecomment-4957502053","issue_url":"https://api.github.com/repos/godotengine/godot/issues/120891","id":4957502053,"node_id":"IC_kwDOAO6SJc8AAAABJ316ZQ","user":{"login":"mattigu","id":47303532,"node_id":"MDQ6VXNlcjQ3MzAzNTMy","avatar_url":"https://avatars.githubusercontent.com/u/47303532?v=4","gravatar_id":"","url":"https://api.github.com/users/mattigu","html_url":"https://github.com/mattigu","followers_url":"https://api.github.com/users/mattigu/followers","following_url":"https://api.github.com/users/mattigu/following{/other_user}","gists_url":"https://api.github.com/users/mattigu/gists{/gist_id}","starred_url":"https://api.github.com/users/mattigu/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/mattigu/subscriptions","organizations_url":"https://api.github.com/users/mattigu/orgs","repos_url":"https://api.github.com/users/mattigu/repos","events_url":"https://api.github.com/users/mattigu/events{/privacy}","received_events_url":"https://api.github.com/users/mattigu/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-07-13T11:34:42Z","updated_at":"2026-07-13T11:34:42Z","body":"I applied the feedback from the review, and moved where the match guard edge case is handled","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4957502053/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4958932749","html_url":"https://github.com/godotengine/godot/pull/120891#issuecomment-4958932749","issue_url":"https://api.github.com/repos/godotengine/godot/issues/120891","id":4958932749,"node_id":"IC_kwDOAO6SJc8AAAABJ5NPDQ","user":{"login":"mattigu","id":47303532,"node_id":"MDQ6VXNlcjQ3MzAzNTMy","avatar_url":"https://avatars.githubusercontent.com/u/47303532?v=4","gravatar_id":"","url":"https://api.github.com/users/mattigu","html_url":"https://github.com/mattigu","followers_url":"https://api.github.com/users/mattigu/followers","following_url":"https://api.github.com/users/mattigu/following{/other_user}","gists_url":"https://api.github.com/users/mattigu/gists{/gist_id}","starred_url":"https://api.github.com/users/mattigu/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/mattigu/subscriptions","organizations_url":"https://api.github.com/users/mattigu/orgs","repos_url":"https://api.github.com/users/mattigu/repos","events_url":"https://api.github.com/users/mattigu/events{/privacy}","received_events_url":"https://api.github.com/users/mattigu/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-07-13T14:17:42Z","updated_at":"2026-07-13T14:17:42Z","body":"I squashed the changes. Should I update the PR description?","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4958932749