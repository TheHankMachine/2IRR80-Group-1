rchived_at":null,"archived_by":null}],"state":"closed","locked":false,"assignees":[],"milestone":{"url":"https://api.github.com/repos/godotengine/godot/milestones/25","html_url":"https://github.com/godotengine/godot/milestone/25","labels_url":"https://api.github.com/repos/godotengine/godot/milestones/25/labels","id":15520464,"node_id":"MI_kwDOAO6SJc4A7NLQ","number":25,"title":"4.8","description":"","creator":{"login":"Repiteo","id":17489292,"node_id":"MDQ6VXNlcjE3NDg5Mjky","avatar_url":"https://avatars.githubusercontent.com/u/17489292?v=4","gravatar_id":"","url":"https://api.github.com/users/Repiteo","html_url":"https://github.com/Repiteo","followers_url":"https://api.github.com/users/Repiteo/followers","following_url":"https://api.github.com/users/Repiteo/following{/other_user}","gists_url":"https://api.github.com/users/Repiteo/gists{/gist_id}","starred_url":"https://api.github.com/users/Repiteo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Repiteo/subscriptions","organizations_url":"https://api.github.com/users/Repiteo/orgs","repos_url":"https://api.github.com/users/Repiteo/repos","events_url":"https://api.github.com/users/Repiteo/events{/privacy}","received_events_url":"https://api.github.com/users/Repiteo/received_events","type":"User","user_view_type":"public","site_admin":false},"open_issues":345,"closed_issues":2336,"state":"open","created_at":"2026-04-13T15:59:35Z","updated_at":"2026-10-22T08:21:32Z","due_on":null,"closed_at":null},"comments":3,"created_at":"2026-09-08T05:06:44Z","updated_at":"2026-09-10T14:21:39Z","closed_at":"2026-09-09T19:59:17Z","assignee":null,"author_association":"CONTRIBUTOR","issue_field_values":[],"type":null,"active_lock_reason":null,"draft":false,"pull_request":{"url":"https://api.github.com/repos/godotengine/godot/pulls/123297","html_url":"https://github.com/godotengine/godot/pull/123297","diff_url":"https://github.com/godotengine/godot/pull/123297.diff","patch_url":"https://github.com/godotengine/godot/pull/123297.patch","merged_at":"2026-09-09T19:59:17Z"},"body":"<!--\r\nPlease target the `master` branch. We will take care of backporting relevant fixes to older versions.\r\n\r\nBefore submitting, please read our checklist for contributors:\r\nhttps://contributing.godotengine.org/en/latest/engine/introduction.html#checklist-for-new-contributors\r\n\r\nUse of AI must be disclosed and should include a description of how it was used.\r\n-->\r\n\r\n## What problem(s) does this PR solve?\r\n\r\nThis PR fixes a few tiny grammar/wording issues in the Project Manager dialog box that appears when attempting to open a project last opened on a different version of Godot:\r\n\r\n- \"Backup project first\" → \"Back Up Project First\"\r\n  - \"Back up\" (with a space) is a verb meaning to save a copy of content at a specific point in time; \"backup\" (with no space) is a noun meaning the content which has been saved. Since the checkbox is asking if the user wants to perform a specific action, the verb form makes more sense.\r\n  - The text was changed to title case to be consistent with \"Upgrade All Project Files\" below as well as other places in the Project Manager and editor.\r\n- \"The project will be restarted once in the process\" → \"The editor may restart during the process\"\r\n  - I found the old wording to be very confusing as a native English speaker. It's ambiguous whether the \"once\" means \"at one point in time, during the process\" or \"as soon as the process starts\", in a way that feels like it's important it means one or the other. The revised wording is still vague, I suppose, but does not arguably make any strong promises about how many times or when during the process it may restart.\r\n\r\n## Additional information\r\n\r\n<!--\r\nProvide additional information and explanation of your PR, including areas that you are uncertain of or require special attention from reviewers. For examples, please read our pull request guidelines: https://contributing.godotengine.org/en/latest/pull_requests/pull_request_guidelines.html#explain-your-contributions\r\n-->\r\n\r\nN/A\r\n","closed_by":{"login":"Repiteo","id":17489292,"node_id":"MDQ6VXNlcjE3NDg5Mjky","avatar_url":"https://avatars.githubusercontent.com/u/17489292?v=4","gravatar_id":"","url":"https://api.github.com/users/Repiteo","html_url":"https://github.com/Repiteo","followers_url":"https://api.github.com/users/Repiteo/followers","following_url":"https://api.github.com/users/Repiteo/following{/other_user}","gists_url":"https://api.github.com/users/Repiteo/gists{/gist_id}","starred_url":"https://api.github.com/users/Repiteo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Repiteo/subscriptions","organizations_url":"https://api.github.com/users/Repiteo/orgs","repos_url":"https://api.github.com/users/Repiteo/repos","events_url":"https://api.github.com/users/Repiteo/events{/privacy}","received_events_url":"https://api.github.com/users/Repiteo/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/123297/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/godotengine/godot/issues/123297/timeline","performed_via_github_app":null,"state_reason":null}