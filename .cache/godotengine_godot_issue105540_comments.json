ers/Arazalera/orgs","repos_url":"https://api.github.com/users/Arazalera/repos","events_url":"https://api.github.com/users/Arazalera/events{/privacy}","received_events_url":"https://api.github.com/users/Arazalera/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-04-26T23:04:19Z","updated_at":"2025-04-26T23:04:19Z","body":"Actually it doesn't really seem to make sense, using how reflection color is compiled, the problem seems to be related to alpha premultiply in how reflection probes are blended, It should be reopened","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2832712007/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2832989959","html_url":"https://github.com/godotengine/godot/issues/105540#issuecomment-2832989959","issue_url":"https://api.github.com/repos/godotengine/godot/issues/105540","id":2832989959,"node_id":"IC_kwDOAO6SJc6o2_8H","user":{"login":"DylanM5","id":69550936,"node_id":"MDQ6VXNlcjY5NTUwOTM2","avatar_url":"https://avatars.githubusercontent.com/u/69550936?v=4","gravatar_id":"","url":"https://api.github.com/users/DylanM5","html_url":"https://github.com/DylanM5","followers_url":"https://api.github.com/users/DylanM5/followers","following_url":"https://api.github.com/users/DylanM5/following{/other_user}","gists_url":"https://api.github.com/users/DylanM5/gists{/gist_id}","starred_url":"https://api.github.com/users/DylanM5/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/DylanM5/subscriptions","organizations_url":"https://api.github.com/users/DylanM5/orgs","repos_url":"https://api.github.com/users/DylanM5/repos","events_url":"https://api.github.com/users/DylanM5/events{/privacy}","received_events_url":"https://api.github.com/users/DylanM5/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-04-27T04:00:50Z","updated_at":"2025-04-27T04:00:50Z","body":"It's not letting me attach the project. It's just a light, a floor CSGMesh, a reflection probe, and a camera.","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2832989959/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2833249105","html_url":"https://github.com/godotengine/godot/issues/105540#issuecomment-2833249105","issue_url":"https://api.github.com/repos/godotengine/godot/issues/105540","id":2833249105,"node_id":"IC_kwDOAO6SJc6o3_NR","user":{"login":"Arazalera","id":149334681,"node_id":"U_kgDOCOaqmQ","avatar_url":"https://avatars.githubusercontent.com/u/149334681?v=4","gravatar_id":"","url":"https://api.github.com/users/Arazalera","html_url":"https://github.com/Arazalera","followers_url":"https://api.github.com/users/Arazalera/followers","following_url":"https://api.github.com/users/Arazalera/following{/other_user}","gists_url":"https://api.github.com/users/Arazalera/gists{/gist_id}","starred_url":"https://api.github.com/users/Arazalera/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Arazalera/subscriptions","organizations_url":"https://api.github.com/users/Arazalera/orgs","repos_url":"https://api.github.com/users/Arazalera/repos","events_url":"https://api.github.com/users/Arazalera/events{/privacy}","received_events_url":"https://api.github.com/users/Arazalera/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-04-27T07:10:12Z","updated_at":"2025-04-27T07:10:12Z","body":"I have seen this before, and can reproduce it in 4.4.1\n\nMy minimal reproduction project: \n\n[Reflectionprobe Blend.zip](https://github.com/user-attachments/files/19928296/Reflectionprobe.Blend.zip)\n\n![Image](https://github.com/user-attachments/assets/a1e84989-a418-4a52-9431-cbe5fa0e5d22)","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2833249105/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2833428097","html_url":"https://github.com/godotengine/godot/issues/105540#issuecomment-2833428097","issue_url":"https://api.github.com/repos/godotengine/godot/issues/105540","id":2833428097,"node_id":"IC_kwDOAO6SJc6o4q6B","user":{"login":"Arazalera","id":149334681,"node_id":"U_kgDOCOaqmQ","avatar_url":"https://avatars.githubusercontent.com/u/149334681?v=4","gravatar_id":"","url":"https://api.github.com/users/Arazalera","html_url":"https://github.com/Arazalera","followers_url":"https://api.github.com/users/Arazalera/followers","following_url":"https://api.github.com/users/Arazalera/following{/other_user}","gists_url":"https://api.github.com/users/Arazalera/gists{/gist_id}","starred_url":"https://api.github.com/users/Arazalera/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Arazalera/subscriptions","organizations_url":"https://api.github.com/users/Arazalera/orgs","repos_url":"https://api.github.com/users/Arazalera/repos","events_url":"https://api.github.com/users/Arazalera/events{/privacy}","received_events_url":"https://api.github.com/users/Arazalera/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-04-27T12:13:10Z","updated_at":"2025-04-28T15:27:57Z","body":"How exactly it happens, simplified:\n\nscene_forward_clustered.glsl:\n```glsl\nreflection_accum = vec4(0.0, 0.0, 0.0, 0.0);\nreflection_process(reflection_index, vertex, ref_vec, normal, roughness, ambient_light, specular_light, ambient_accum, reflection_accum);\n```\n\nthen in scene_forward_lights_inc.glsl:\n\n```glsl\nvoid reflection_process()\n\nvec4 reflection;\nfloat reflection_blend = max(0.0, blend - reflection_accum.a);\n\nreflection.rgb = (calculate reflection)\nreflection.rgb *= reflections.data[ref_index].exposure_normalization;\nreflection.a = reflection_blend;\n\nreflection.rgb *= reflections.data[ref_index].intensity;\nreflection.rgb *= reflection.a;\n\nreflection_accum += reflection;\n```\nthen in scene_forward_clustered.glsl:\n```glsl\nif (reflection_accum.a < 1.0) {\n\treflection_accum.rgb = mix(specular_light, reflection_accum.rgb, reflection_accum.a);\n}\n\nif (reflection_accum.a > 0.0) {\n\tspecular_light = reflection_accum.rgb;\n}\n```\n\nin our scenario:\n\nreflection_blend = 0.2\n(calculate reflection) = vec3(1, 1, 1)\n\nreflection.a = 0.2\n\nreflection.rgb *= 0.2 = vec3(0.2, 0.2, 0.2)\n\nambient_light from sky = vec3(1, 1, 1)\n\nreflection_accum.rgb = mix(vec3(1, 1, 1), vec3(0.2, 0.2, 0.2), 0.2)\n\nspecular_light = reflection_accum . rgb\n\nspecular light = vec3(0.84, 0.84, 0.84)\n\nSo the reflection is unusually dark, although:\n\n**reflection_blend = 0:**\n\n reflection_accum.rgb = mix(vec3(1, 1, 1), vec3(0.0, 0.0, 0.0), 0.0) = vec3(1, 1, 1)\n\n**reflection_blend = 1:**\n\n reflection_accum.rgb = mix(vec3(1, 1, 1), vec3(1.0, 1.0, 1.0), 1.0) = vec3(1, 1, 1)\n\n\n","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2833428097/reactions","total_count":5,"+1":5,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2838359119","html_url":"https://github.com/godotengine/godot/issues/105540#issuecomment-2838359119","issue_url":"https://api.github.com/repos/godotengine/godot/issues/105540","id":2838359119,"node_id":"IC_kwDOAO6SJc6pLexP","user":{"logi