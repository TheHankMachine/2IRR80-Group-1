[{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2912406859","html_url":"https://github.com/godotengine/godot/issues/106858#issuecomment-2912406859","issue_url":"https://api.github.com/repos/godotengine/godot/issues/106858","id":2912406859,"node_id":"IC_kwDOAO6SJc6tl81L","user":{"login":"AThousandShips","id":96648715,"node_id":"U_kgDOBcK-Cw","avatar_url":"https://avatars.githubusercontent.com/u/96648715?v=4","gravatar_id":"","url":"https://api.github.com/users/AThousandShips","html_url":"https://github.com/AThousandShips","followers_url":"https://api.github.com/users/AThousandShips/followers","following_url":"https://api.github.com/users/AThousandShips/following{/other_user}","gists_url":"https://api.github.com/users/AThousandShips/gists{/gist_id}","starred_url":"https://api.github.com/users/AThousandShips/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/AThousandShips/subscriptions","organizations_url":"https://api.github.com/users/AThousandShips/orgs","repos_url":"https://api.github.com/users/AThousandShips/repos","events_url":"https://api.github.com/users/AThousandShips/events{/privacy}","received_events_url":"https://api.github.com/users/AThousandShips/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-05-27T12:52:46Z","updated_at":"2025-05-27T12:52:46Z","body":"Please provide an MRP to make this easier to test and fix:\n- A small Godot project which reproduces the issue, with no unnecessary files included. Be sure to not include the `.godot` folder in the archive (but keep `project.godot`).\n- Having an MRP is very important for contributors to be able to reproduce the bug in the same way that you are experiencing it. When testing a potential fix for the issue, contributors will use the MRP to validate that the fix is working as intended.\n- Drag and drop a ZIP archive to upload it (max 10 MB). **Do not select another field until the project is done uploading.**\n- **Note for C# users:** If your issue is *not* C#-specific, please upload a minimal reproduction project written in GDScript. This will make it easier for contributors to reproduce the issue locally as not everyone has a .NET setup available. ","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2912406859/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2913969119","html_url":"https://github.com/godotengine/godot/issues/106858#issuecomment-2913969119","issue_url":"https://api.github.com/repos/godotengine/godot/issues/106858","id":2913969119,"node_id":"IC_kwDOAO6SJc6tr6Pf","user":{"login":"zisop16","id":65141543,"node_id":"MDQ6VXNlcjY1MTQxNTQz","avatar_url":"https://avatars.githubusercontent.com/u/65141543?v=4","gravatar_id":"","url":"https://api.github.com/users/zisop16","html_url":"https://github.com/zisop16","followers_url":"https://api.github.com/users/zisop16/followers","following_url":"https://api.github.com/users/zisop16/following{/other_user}","gists_url":"https://api.github.com/users/zisop16/gists{/gist_id}","starred_url":"https://api.github.com/users/zisop16/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/zisop16/subscriptions","organizations_url":"https://api.github.com/users/zisop16/orgs","repos_url":"https://api.github.com/users/zisop16/repos","events_url":"https://api.github.com/users/zisop16/events{/privacy}","received_events_url":"https://api.github.com/users/zisop16/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-05-27T20:34:46Z","updated_at":"2025-05-27T20:34:46Z","body":"[shader-bug.zip](https://github.com/user-attachments/files/20466116/shader-bug.zip)","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com