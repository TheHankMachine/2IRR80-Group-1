godot/issues/comments/2731672297/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2741595752","html_url":"https://github.com/godotengine/godot/issues/104179#issuecomment-2741595752","issue_url":"https://api.github.com/repos/godotengine/godot/issues/104179","id":2741595752,"node_id":"IC_kwDOAO6SJc6jaW5o","user":{"login":"dsyze","id":59926550,"node_id":"MDQ6VXNlcjU5OTI2NTUw","avatar_url":"https://avatars.githubusercontent.com/u/59926550?v=4","gravatar_id":"","url":"https://api.github.com/users/dsyze","html_url":"https://github.com/dsyze","followers_url":"https://api.github.com/users/dsyze/followers","following_url":"https://api.github.com/users/dsyze/following{/other_user}","gists_url":"https://api.github.com/users/dsyze/gists{/gist_id}","starred_url":"https://api.github.com/users/dsyze/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/dsyze/subscriptions","organizations_url":"https://api.github.com/users/dsyze/orgs","repos_url":"https://api.github.com/users/dsyze/repos","events_url":"https://api.github.com/users/dsyze/events{/privacy}","received_events_url":"https://api.github.com/users/dsyze/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-03-20T20:31:50Z","updated_at":"2025-03-20T20:31:50Z","body":"> Can you reproduce this after switching to the **Mobile** rendering method in the top-right corner, then exporting the project again?\n> \n> Also, can you reproduce this in 4.4 which has [Swappy integration](https://github.com/godotengine/godot/pull/96439)? (If you're building export templates yourself, remember to set up the Swappy dependency before building.)\n>  \n> > 2. I think that Android 15 specifically doesn't allow games to run at more than 60 FPS. That observation is based on my experience after updating my test devices.\n> \n> My Samsung Galaxy S25 Ultra is on Android 15 and can run any game at 120 FPS (unless it implements its own cap). This includes older GLES games that target Android versions like 9 (if not older).\n\nSir，I learned from the Q&A with deepseek ai. Android 13 is the fixed refresh rate of the system, such as 60, 90, 120. Android 15 is a dynamic refresh rate, and the application can adjust the refresh rate at any time according to API. So I think it may be necessary to study the api of Android 15 about the refresh rate, and maybe this problem can be solved with the Android plug-in.Tomorrow I will try.","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2741595752/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2741763170","html_url":"https://github.com/godotengine/godot/issues/104179#issuecomment-2741763170","issue_url":"https://api.github.com/repos/godotengine/godot/issues/104179","id":2741763170,"node_id":"IC_kwDOAO6SJc6ja_xi","user":{"login":"dsyze","id":59926550,"node_id":"MDQ6VXNlcjU5OTI2NTUw","avatar_url":"https://avatars.githubusercontent.com/u/59926550?v=4","gravatar_id":"","url":"https://api.github.com/users/dsyze","html_url":"https://github.com/dsyze","followers_url":"https://api.github.com/users/dsyze/followers","following_url":"https://api.github.com/users/dsyze/following{/other_user}","gists_url":"https://api.github.com/users/dsyze/gists{/gist_id}","starred_url":"https://api.github.com/users/dsyze/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/dsyze/subscriptions","organizations_url":"https://api.github.com/users/dsyze/orgs","repos_url":"https://api.github.com/users/dsyze/repos","events_url":"https://api.github.com/users/dsyze/events{/privacy}","received_events_url":"https://api.github.com/users/dsyze/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-03-20T22:00:22Z","updated_at":"2025-03-20T22:00:22Z","body":"> I've noticed the same with Android 15, I think there is 2 thing happening:\n> \n> 1. Android devices for not allow disabling VSync. If you check your debug messages, you will see that when you run the game on the Android device you get a warning saying that VSync cannot be disabled\n> 2. I think that Android 15 specifically doesn't allow games to run at more than 60 FPS. That observation is based on my experience after updating my test devices.\n\nI noticed that with Android 15, the Xiaomi 15 Ultra can directly run godot at 120 frames per second. This is quite fascinating and might be related to the manufacturer's custom settings. However, I wish all devices could operate at 120 frames per second by default, as it significantly enhances the user experience.","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2741763170/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2786168708","html_url":"https://github.com/godotengine/godot/issues/104179#issuecomment-2786168708","issue_url":"https://api.github.com/repos/godotengine/godot/issues/104179","id":2786168708,"node_id":"IC_kwDOAO6SJc6mEY-E","user":{"login":"dsyze","id":59926550,"node_id":"MDQ6VXNlcjU5OTI2NTUw","avatar_url":"https://avatars.githubusercontent.com/u/59926550?v=4","gravatar_id":"","url":"https://api.github.com/users/dsyze","html_url":"https://github.com/dsyze","followers_url":"https://api.github.com/users/dsyze/followers","following_url":"https://api.github.com/users/dsyze/following{/other_user}","gists_url":"https://api.github.com/users/dsyze/gists{/gist_id}","starred_url":"https://api.github.com/users/dsyze/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/dsyze/subscriptions","organizations_url":"https://api.github.com/users/dsyze/orgs","repos_url":"https://api.github.com/users/dsyze/repos","events_url":"https://api.github.com/users/dsyze/events{/privacy}","received_events_url":"https://api.github.com/users/dsyze/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-04-08T11:46:04Z","updated_at":"2025-04-08T11:46:04Z","body":"> Can you reproduce this after switching to the **Mobile** rendering method in the top-right corner, then exporting the project again?\n> \n> Also, can you reproduce this in 4.4 which has [Swappy integration](https://github.com/godotengine/godot/pull/96439)? (If you're building export templates yourself, remember to set up the Swappy dependency before building.)\n>  \n> > 2. I think that Android 15 specifically doesn't allow games to run at more than 60 FPS. That observation is based on my experience after updating my test devices.\n> \n> My Samsung Galaxy S25 Ultra is on Android 15 and can run any game at 120 FPS (unless it implements its own cap). This includes older GLES games that target Android versions like 9 (if not older).\n\nSir, now I have found a non-direct solution. Use the Android plug-in to make a very small Android native dialog and keep refreshing where the user can't see it, so that the refresh rate can reach 120. It's amazing. It's not solved directly, but I'm sure the effect is very good.","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2786168708/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2905690177","html_url":"https://github.com/godotengine/godot/issues/104179#issuecomment-29056