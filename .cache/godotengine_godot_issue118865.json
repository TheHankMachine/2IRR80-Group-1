ll},{"id":283518733,"node_id":"MDU6TGFiZWwyODM1MTg3MzM=","url":"https://api.github.com/repos/godotengine/godot/labels/usability","name":"usability","color":"447744","default":false,"description":"","archived_at":null,"archived_by":null},{"id":1609442062,"node_id":"MDU6TGFiZWwxNjA5NDQyMDYy","url":"https://api.github.com/repos/godotengine/godot/labels/topic:shaders","name":"topic:shaders","color":"ffee88","default":false,"description":"","archived_at":null,"archived_by":null}],"state":"closed","locked":false,"assignees":[],"milestone":{"url":"https://api.github.com/repos/godotengine/godot/milestones/24","html_url":"https://github.com/godotengine/godot/milestone/24","labels_url":"https://api.github.com/repos/godotengine/godot/milestones/24/labels","id":14236899,"node_id":"MI_kwDOAO6SJc4A2Tzj","number":24,"title":"4.7","description":"","creator":{"login":"akien-mga","id":4701338,"node_id":"MDQ6VXNlcjQ3MDEzMzg=","avatar_url":"https://avatars.githubusercontent.com/u/4701338?v=4","gravatar_id":"","url":"https://api.github.com/users/akien-mga","html_url":"https://github.com/akien-mga","followers_url":"https://api.github.com/users/akien-mga/followers","following_url":"https://api.github.com/users/akien-mga/following{/other_user}","gists_url":"https://api.github.com/users/akien-mga/gists{/gist_id}","starred_url":"https://api.github.com/users/akien-mga/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/akien-mga/subscriptions","organizations_url":"https://api.github.com/users/akien-mga/orgs","repos_url":"https://api.github.com/users/akien-mga/repos","events_url":"https://api.github.com/users/akien-mga/events{/privacy}","received_events_url":"https://api.github.com/users/akien-mga/received_events","type":"User","user_view_type":"public","site_admin":false},"open_issues":3,"closed_issues":2535,"state":"closed","created_at":"2025-11-27T20:29:18Z","updated_at":"2026-10-20T18:39:31Z","due_on":null,"closed_at":"2026-06-19T16:54:35Z"},"comments":2,"created_at":"2026-04-22T20:18:22Z","updated_at":"2026-05-16T08:55:38Z","closed_at":"2026-05-15T20:49:46Z","assignee":null,"author_association":"CONTRIBUTOR","issue_field_values":[],"type":null,"active_lock_reason":null,"draft":false,"pull_request":{"url":"https://api.github.com/repos/godotengine/godot/pulls/118865","html_url":"https://github.com/godotengine/godot/pull/118865","diff_url":"https://github.com/godotengine/godot/pull/118865.diff","patch_url":"https://github.com/godotengine/godot/pull/118865.patch","merged_at":"2026-05-15T20:49:46Z"},"body":"This PR is a follow up to #117726, aiming to improve the information density and flexibility of the new `TextShaderPreview` panel.\r\n\r\nhttps://github.com/user-attachments/assets/d24ea73d-09ba-4c7f-b236-f81d48c82517\r\n\r\nIt does so in the following ways:\r\n\r\n1. Change the line-preview connection to be wider, using alternating-opacity `draw_polygon` calls instead of `draw_line` in order to give the illusion of perspective, and guide the eyes more naturally.\r\n2. Let these lanes flow through a resizable gutter, which the user may adjust to their needs.\r\n2. Make both the goto line and remove buttons contextual, letting them sit in the minimum width of the gutter. Show the line number as the button's text. Make the 3D material editor's buttons also hide on unhover.\r\n3. Allow resizing preview boxes, which are now enforced square and live edge-to-edge for maximum content density.\r\n4. Move the \"Update Parameters\" button to the bottom, letting it occupy the same vertical space as the code editor toolbar, making room for further global tools if need be, like the new \"Remove All\" button.\r\n5. Highlight the connection lane for the currently selected line, and highlight the line for the currently hovered preview.\r\n6. Shorten error messages to be appropriately scoped - if outside `fragment()`, say line not in `fragment()`, if inside fragment, say line not assignment. The error boxes' height is now decided by message length.\r\n\r\nIt also fixes broken radio button behaviour in the Spatial MaterialEditor.","closed_by":{"login":"Repiteo","id":17489292,"node_id":"MDQ6VXNlcjE3NDg5Mjky","avatar_url":"https://avatars.githubusercontent.com/u/17489292?v=4","gravatar_id":"","url":"https://api.github.com/users/Repiteo","html_url":"https://github.com/Repiteo","followers_url":"https://api.github.com/users/Repiteo/followers","following_url":"https://api.github.com/users/Repiteo/following{/other_user}","gists_url":"https://api.github.com/users/Repiteo/gists{/gist_id}","starred_url":"https://api.github.com/users/Repiteo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Repiteo/subscriptions","organizations_url":"https://api.github.com/users/Repiteo/orgs","repos_url":"https://api.github.com/users/Repiteo/repos","events_url":"https://api.github.com/users/Repiteo/events{/privacy}","received_events_url":"https://api.github.com/users/Repiteo/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/118865/reactions","total_count":59,"+1":33,"-1":0,"laugh":0,"hooray":5,"confused":0,"heart":15,"rocket":0,"eyes":6},"timeline_url":"https://api.github.com/repos/godotengine/godot/issues/118865/timeline","performed_via_github_app":null,"state_reason":null}