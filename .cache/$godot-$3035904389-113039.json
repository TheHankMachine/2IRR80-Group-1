[{"id":3497939662,"node_id":"PRR_kwDOAO6SJc7QflLO","state":"COMMENTED","user":{"site_admin":false,"suspended":false,"updated_at":"0001-01-01T00:00:00Z","avatar_url":"https://avatars.githubusercontent.com/u/2308167?u=f7f8e0273f784f5ec6f6b7fe4a88d449896eb48a&v=4","created_at":"0001-01-01T00:00:00Z","followers":0,"following":0,"html_url":"https://github.com/Ivorforce","id":2308167,"node_id":"MDQ6VXNlcjIzMDgxNjc=","login":"Ivorforce","type":"User","owned_private_repos":0,"public_gists":0,"public_repos":0,"total_private_repos":0,"url":"https://api.github.com/users/Ivorforce"},"body":"I can confirm it is illegal to store a reference into a mutating `AHashMap`, for the reasons given in the OP. For more information, see [Core types](https://docs.godotengine.org/en/latest/engine_details/architecture/core_types.html#containers). \n\nThis is notably not the case for `HashMap`, which was previously used, which I think makes this a regression from #92554 (4.4). Interesting how it didn't come up yet!\n\nConsidering this, an alternative solution to what's proposed here would be exchanging `AHashMap` for `HashMap` again, although this would regress the performance benefits measured in #92554.\nOverall, I'd probably go with the solution proposed here. But I'll leave this decision for the animation team to make.","html_url":"https://github.com/godotengine/godot/pull/113039#pullrequestreview-3497939662","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/113039","author_association":"MEMBER","submitted_at":"2025-11-23T18:57:57Z"},{"id":3503262891,"node_id":"PRR_kwDOAO6SJc7Qz4yr","state":"APPROVED","user":{"site_admin":false,"suspended":false,"updated_at":"0001-01-01T00:00:00Z","avatar_url":"https://avatars.githubusercontent.com/u/61938263?u=9b90963f1b4f17720e50bbbe495fbe8c84c8bc8e&v=4","created_at":"0001-01-01T00:00:00Z","followers":0,"following":0,"html_url":"https://github.com/TokageItLab","id":61938263,"node_id":"MDQ6VXNlcjYxOTM4MjYz","login":"TokageItLab","type":"User","owned_private_repos":0,"public_gists":0,"public_repos":0,"total_private_repos":0,"url":"https://api.github.com/users/TokageItLab"},"body":"As mentioned above by @Ivorforce, it would be preferable to avoid using an AHasmap and thus compromising performance if the issue can be resolved by not holding references.","html_url":"https://github.com/godotengine/godot/pull/113039#pullrequestreview-3503262891","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/113039","author_association":"MEMBER","submitted_at":"2025-11-25T04:53:22Z"},{"id":3496452190,"node_id":"PRR_kwDOAO6SJc7QZ6Be","state":"COMMENTED","user":{"site_admin":false,"suspended":false,"updated_at":"0001-01-01T00:00:00Z","avatar_url":"https://avatars.githubusercontent.com/u/96648715?u=af70f5d107e9c1447f296643d5a566dab53d25e8&v=4","created_at":"0001-01-01T00:00:00Z","followers":0,"following":0,"html_url":"https://github.com/AThousandShips","id":96648715,"node_id":"U_kgDOBcK-Cw","login":"AThousandShips","type":"User","owned_private_repos":0,"public_gists":0,"public_repos":0,"total_private_repos":0,"url":"https://api.github.com/users/AThousandShips"},"body":"","html_url":"https://github.com/godotengine/godot/pull/113039#pullrequestreview-3496452190","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/113039","author_association":"MEMBER","submitted_at":"2025-11-25T08:49:52Z"},{"id":3510626107,"node_id":"PRR_kwDOAO6SJc7RP-c7","state":"COMMENTED","commit_id":"6efe6aa60ca647eff99362d1696f50c4813a5815","user":{"site_admin":false,"suspended":false,"updated_at":"0001-01-01T00:00:00Z","avatar_url":"https://avatars.githubusercontent.com/u/61938263?u=9b90963f1b4f17720e50bbbe495fbe8c84c8bc8e&v=4","created_at":"0001-01-01T00:00:00Z","followers":0,"following":0,"html_url":"https://github.com/TokageItLab","id":61938263,"node_id":"MDQ6VXNlcjYxOTM4MjYz","login":"TokageItLab","type":"User","owned_private_repos":0,"public_gists":0,"public_repos":0,"total_private_repos":0,"url":"h