":"https://avatars.githubusercontent.com/u/24670553?v=4","gravatar_id":"","url":"https://api.github.com/users/zachnicoll","html_url":"https://github.com/zachnicoll","followers_url":"https://api.github.com/users/zachnicoll/followers","following_url":"https://api.github.com/users/zachnicoll/following{/other_user}","gists_url":"https://api.github.com/users/zachnicoll/gists{/gist_id}","starred_url":"https://api.github.com/users/zachnicoll/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/zachnicoll/subscriptions","organizations_url":"https://api.github.com/users/zachnicoll/orgs","repos_url":"https://api.github.com/users/zachnicoll/repos","events_url":"https://api.github.com/users/zachnicoll/events{/privacy}","received_events_url":"https://api.github.com/users/zachnicoll/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-08-13T04:41:38Z","updated_at":"2026-08-13T04:41:38Z","body":"Odds on getting this merged? Super frustrating having to manually click around to duplicate node structures.","author_association":"NONE","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5276049799/reactions","total_count":3,"+1":3,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5278565292","html_url":"https://github.com/godotengine/godot/pull/121410#issuecomment-5278565292","issue_url":"https://api.github.com/repos/godotengine/godot/issues/121410","id":5278565292,"node_id":"IC_kwDOAO6SJc8AAAABOqCDrA","user":{"login":"vaner-org","id":9658355,"node_id":"MDQ6VXNlcjk2NTgzNTU=","avatar_url":"https://avatars.githubusercontent.com/u/9658355?v=4","gravatar_id":"","url":"https://api.github.com/users/vaner-org","html_url":"https://github.com/vaner-org","followers_url":"https://api.github.com/users/vaner-org/followers","following_url":"https://api.github.com/users/vaner-org/following{/other_user}","gists_url":"https://api.github.com/users/vaner-org/gists{/gist_id}","starred_url":"https://api.github.com/users/vaner-org/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/vaner-org/subscriptions","organizations_url":"https://api.github.com/users/vaner-org/orgs","repos_url":"https://api.github.com/users/vaner-org/repos","events_url":"https://api.github.com/users/vaner-org/events{/privacy}","received_events_url":"https://api.github.com/users/vaner-org/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-08-13T09:33:22Z","updated_at":"2026-08-13T09:33:22Z","body":"@zachnicoll while we wait, I recommend keeping a local fork of the stable branch of the engine for yourself, with commits from PRs essential to you applied on top. GitHub Desktop in particular makes this very easy to do, and ever since I started doing so I'm almost never frustrated.","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5278565292/reactions","total_count":2,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":2,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5388400099","html_url":"https://github.com/godotengine/godot/pull/121410#issuecomment-5388400099","issue_url":"https://api.github.com/repos/godotengine/godot/issues/121410","id":5388400099,"node_id":"IC_kwDOAO6SJc8AAAABQSx14w","user":{"login":"vaner-org","id":9658355,"node_id":"MDQ6VXNlcjk2NTgzNTU=","avatar_url":"https://avatars.githubusercontent.com/u/9658355?v=4","gravatar_id":"","url":"https://api.github.com/users/vaner-org","html_url":"https://github.com/vaner-org","followers_url":"https://api.github.com/users/vaner-org/followers","following_url":"https://api.github.com/users/vaner-org/following{/other_user}","gists_url":"https://api.github.com/users/vaner-org/gists{/gist_id}","starred_url":"https://api.github.com/users/vaner-org/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/vaner-org/subscriptions","organizations_url":"https://api.github.com/users/vaner-org/orgs","repos_url":"https://api.github.com/users/vaner-org/repos","events_url":"https://api.github.com/users/vaner-org/events{/privacy}","received_events_url":"https://api.github.com/users/vaner-org/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-08-23T20:52:29Z","updated_at":"2026-09-10T17:24:16Z","body":"Thank you for the review.\r\n- `read_only` checks were added wherever applicable (cut does copy when so).\r\n- `KEY_DELETE` is now ingested as by `shortcut_input` and not by `..._gui_input` methods in BlendSpaces and StateMachine. I've kept the checks they used to have before calling `_erase_selected`, but they always `accept_event`.\r\n- There was one more small bug with BlendSpaces not setting `selected_point` to `-1` on enter, which has been fixed.\r\n> We should make sure the animation tree editor is still focused after opening a sub-tree. \r\n- Each editor's draw spaces now grab focus on entry with `edit()`, I think this has been needed since https://github.com/godotengine/godot/pull/109881.\r\n> Otherwise, it would be important to better visualize focus.\r\n- BlendSpaces' focus rectangles were removed in https://github.com/godotengine/godot/pull/117498, but StateMachine's and the BlendTree graph's weren't. They now only really appear when we make them grab focus during entry with `edit()` above, but they disappear soon as anything is clicked, even empty space. It gets very distracting, they have been removed too.\r\n> Optional: In the state machine, copying/pasting or duplicating Start -> Node should paste the transition and the node from the existing Start node, since you can't paste a Start node. Same thing for the output node in a BlendTree. If the output node is disconnected and I paste nodes which are connected to output, it should connect the output. That makes it easier to copy everything in one BlendTree to another.\r\n- Done, as described.\r\n- Reordered the right-click menu's items to be alphabetical and consistent between BlendTree and the rest, with a separator between the five root node types and those unique to BlendTree. Removed \"Add\" prefix from StateMachine and BlendSpaces to match BlendTree.\r\n- Now that \"Add Node...\" on the top left of BlendTree no longer just adds nodes, it has been changed to the `ListSelect` icon with the tooltip `Manage blend tree nodes.`\r\n\r\n<img width=\"223\" height=\"546\" alt=\"image\" src=\"https://github.com/user-attachments/assets/9327e8f8-a0e1-4aef-84c5-b90fa9f12274\" />\r\n","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5388400099/reactions","total_count":2,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":2,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null}]