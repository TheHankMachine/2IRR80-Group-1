[{"id":2676178015,"node_id":"PRR_kwDOAO6SJc6fgzxf","state":"APPROVED","user":{"site_admin":false,"suspended":false,"updated_at":"0001-01-01T00:00:00Z","avatar_url":"https://avatars.githubusercontent.com/u/2308167?u=f7f8e0273f784f5ec6f6b7fe4a88d449896eb48a&v=4","created_at":"0001-01-01T00:00:00Z","followers":0,"following":0,"html_url":"https://github.com/Ivorforce","id":2308167,"node_id":"MDQ6VXNlcjIzMDgxNjc=","login":"Ivorforce","type":"User","owned_private_repos":0,"public_gists":0,"public_repos":0,"total_private_repos":0,"url":"https://api.github.com/users/Ivorforce"},"body":"That's good enough for me!\r\n\r\nI only skimmed the changes, but with this kind of change I concur that any mistakes are likely caught by the compiler.\r\n\r\nThe only caveat I could think of was that, by removing the constructors from the cpp files, callers would be forced to create the objects in-place, instead of being able to hand this off to the module. This would save a call, but create more inline code (at least in non LTO builds).\r\n\r\nI made a quick sanity check of file sizes of the action in this build, and there doesn't seem to be any real observable difference (40 bytes in the iOS build).\r\n\r\nSo yea, lgtm!","html_url":"https://github.com/godotengine/godot/pull/103988#pullrequestreview-2676178015","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/103988","author_association":"MEMBER","submitted_at":"2025-03-11T21:39:55Z"},{"id":2676179793,"node_id":"PRR_kwDOAO6SJc6fg0NR","state":"APPROVED","user":{"site_admin":false,"suspended":false,"updated_at":"0001-01-01T00:00:00Z","avatar_url":"https://avatars.githubusercontent.com/u/12756047?u=b898b9a13751c0734a1cfe31fa1fef8b74a50fdb&v=4","created_at":"0001-01-01T00:00:00Z","followers":0,"following":0,"html_url":"https://github.com/SaracenOne","id":12756047,"node_id":"MDQ6VXNlcjEyNzU2MDQ3","login":"SaracenOne","type":"User","owned_private_repos":0,"public_gists":0,"public_repos":0,"total_private_repos":0,"url":"ht