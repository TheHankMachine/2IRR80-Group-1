m:ios","color":"e4e4e4","default":false,"description":"","archived_at":null,"archived_by":null},{"id":580537003,"node_id":"MDU6TGFiZWw1ODA1MzcwMDM=","url":"https://api.github.com/repos/godotengine/godot/labels/topic:gdextension","name":"topic:gdextension","color":"ffee88","default":false,"description":"","archived_at":null,"archived_by":null}],"state":"closed","locked":false,"assignees":[],"milestone":{"url":"https://api.github.com/repos/godotengine/godot/milestones/23","html_url":"https://github.com/godotengine/godot/milestone/23","labels_url":"https://api.github.com/repos/godotengine/godot/milestones/23/labels","id":12939969,"node_id":"MI_kwDOAO6SJc4AxXLB","number":23,"title":"4.6","description":"","creator":{"login":"Repiteo","id":17489292,"node_id":"MDQ6VXNlcjE3NDg5Mjky","avatar_url":"https://avatars.githubusercontent.com/u/17489292?v=4","gravatar_id":"","url":"https://api.github.com/users/Repiteo","html_url":"https://github.com/Repiteo","followers_url":"https://api.github.com/users/Repiteo/followers","following_url":"https://api.github.com/users/Repiteo/following{/other_user}","gists_url":"https://api.github.com/users/Repiteo/gists{/gist_id}","starred_url":"https://api.github.com/users/Repiteo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Repiteo/subscriptions","organizations_url":"https://api.github.com/users/Repiteo/orgs","repos_url":"https://api.github.com/users/Repiteo/repos","events_url":"https://api.github.com/users/Repiteo/events{/privacy}","received_events_url":"https://api.github.com/users/Repiteo/received_events","type":"User","user_view_type":"public","site_admin":false},"open_issues":3,"closed_issues":2978,"state":"closed","created_at":"2025-05-22T16:25:52Z","updated_at":"2026-10-04T16:23:23Z","due_on":null,"closed_at":"2026-01-26T18:09:14Z"},"comments":1,"created_at":"2025-11-14T20:48:04Z","updated_at":"2025-11-18T14:29:50Z","closed_at":"2025-11-18T14:29:08Z","assignee":null,"author_association":"CONTRIBUTOR","issue_field_values":[],"type":null,"active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"### Tested versions\n\n4.5.stable and master as of bd2ca13c6f3a5198eac035c855dcd1759e077313\n\n### System information\n\nMacOS 26.0\n\n### Issue description\n\nThe `GDExtensionLibraryLoader` has a special codepath for iOS that is used to determine whether a GDExtension is a static library, and thus should be resolved from the internal map of registered addresses of symbols or if it should attempt to call the platform dynamic loading capability.\n\nThis comes in the form of determining if this is a static library (`is_static_library`) based on the filename, and currently the test depends on whether the filename ends in \".a\" or in \".xcframework\" -  which is incorrect as .xcframework files can contain dynamic libraries - which the platform loader knows how to locate properly (Xcode upon deployment moves the libraries to a different location).\n\nThis information is later used to determine whether to perform an in-memory symbol lookup or to delegate to the system loader, but since the determination was incorrect at the start, the code that loads a dynamic library is never invoked, as we end up with a failure.\n\nThis prevents a project that references an add-on binary like this from working:\n\n```\n[libraries]\nios.debug = res://addons/MyAddon/MyAddon.xcframework\n```\n\nIf such xcframework contains a dynamic library instead of a static library.\n\n### Steps to reproduce\n\nYou can use my test case here, and export the game to iOS. \n\nTo workaround, you need to follow the additional steps in the README:\n\nhttps://github.com/migueldeicaza/SwiftGodotAppleTemplate\n\nUse commit 51fb1424912ecba7af913e5caf13531e0522b971 in case I update that sample with additional workarounds.\n\n\n\n### Minimal reproduction project (MRP)\n\nhttps://github.com/migueldeicaza/SwiftGodotAppleTemplate\n","closed_by":{"login":"Repiteo","id":17489292,"node_id":"MDQ6VXNlcjE3NDg5Mjky","avatar_url":"https://avatars.githubusercontent.com/u/17489292?v=4","gravatar_id":"","url":"https://api.github.com/users/Repiteo","html_url":"https://github.com/Repiteo","followers_url":"https://api.github.com/users/Repiteo/followers","following_url":"https://api.github.com/users/Repiteo/following{/other_user}","gists_url":"https://api.github.com/users/Repiteo/gists{/gist_id}","starred_url":"https://api.github.com/users/Repiteo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Repiteo/subscriptions","organizations_url":"https://api.github.com/users/Repiteo/orgs","repos_url":"https://api.github.com/users/Repiteo/repos","events_url":"https://api.github.com/users/Repiteo/events{/privacy}","received_events_url":"https://api.github.com/users/Repiteo/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/112783/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/godotengine/godot/issues/112783/timeline","performed_via_github_app":null,"state_reason":"completed","pinned_comment":null}