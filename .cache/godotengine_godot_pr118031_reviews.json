[{"id":4036794749,"node_id":"PRR_kwDOAO6SJc7wnJl9","user":{"login":"TokageItLab","id":61938263,"node_id":"MDQ6VXNlcjYxOTM4MjYz","avatar_url":"https://avatars.githubusercontent.com/u/61938263?u=9b90963f1b4f17720e50bbbe495fbe8c84c8bc8e&v=4","gravatar_id":"","url":"https://api.github.com/users/TokageItLab","html_url":"https://github.com/TokageItLab","followers_url":"https://api.github.com/users/TokageItLab/followers","following_url":"https://api.github.com/users/TokageItLab/following{/other_user}","gists_url":"https://api.github.com/users/TokageItLab/gists{/gist_id}","starred_url":"https://api.github.com/users/TokageItLab/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/TokageItLab/subscriptions","organizations_url":"https://api.github.com/users/TokageItLab/orgs","repos_url":"https://api.github.com/users/TokageItLab/repos","events_url":"https://api.github.com/users/TokageItLab/events{/privacy}","received_events_url":"https://api.github.com/users/TokageItLab/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"This should never be merged. If you apply the `step` directly there, a discrepancy will occur between the actual animation’s current time and the displayed time. To give a simple example, if you set the snap to 1.0s, the current time will always show 0s from 0 to 0.4999 seconds.\r\n\r\n<img width=\"719\" height=\"325\" alt=\"Image\" src=\"https://github.com/user-attachments/assets/e4e0c2e5-9145-4a9c-9a30-28c62dce97ba\" />\r\n\r\nIn other words, you cannot use the direct `step` setting here. A possible solution would be to provide a separate button for the spinner, distinct from the spinner itself. Alternatively, a fundamental modification to the SpinBox is required to allow the `step` value and the displayed value to diverge, see also discussion in https://github.com/godotengine/godot/pull/106352.","state":"CHANGES_REQUESTED","html_url":"https://github.com/godotengine/godot/pull/118031#pullrequestreview-4036794749","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/118031","author_association":"MEMBER","_links":{"html":{"href":"https://github.com/godotengine/godot/pull/118031#pullrequestreview-4036794749"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/118031"}},"submitted_at":"2026-03-31T11:50:32Z","commit_id":null}]