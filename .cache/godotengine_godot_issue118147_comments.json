[{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4182964130","html_url":"https://github.com/godotengine/godot/pull/118147#issuecomment-4182964130","issue_url":"https://api.github.com/repos/godotengine/godot/issues/118147","id":4182964130,"node_id":"IC_kwDOAO6SJc75Uvei","user":{"login":"Nintorch","id":92302738,"node_id":"U_kgDOBYBtkg","avatar_url":"https://avatars.githubusercontent.com/u/92302738?v=4","gravatar_id":"","url":"https://api.github.com/users/Nintorch","html_url":"https://github.com/Nintorch","followers_url":"https://api.github.com/users/Nintorch/followers","following_url":"https://api.github.com/users/Nintorch/following{/other_user}","gists_url":"https://api.github.com/users/Nintorch/gists{/gist_id}","starred_url":"https://api.github.com/users/Nintorch/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Nintorch/subscriptions","organizations_url":"https://api.github.com/users/Nintorch/orgs","repos_url":"https://api.github.com/users/Nintorch/repos","events_url":"https://api.github.com/users/Nintorch/events{/privacy}","received_events_url":"https://api.github.com/users/Nintorch/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-04-03T10:45:47Z","updated_at":"2026-04-03T10:45:47Z","body":"@bakana808 Hello, may I ask if you can test this PR, please? See https://contributing.godotengine.org/en/latest/pull_requests/testing.html on how to download a build of this PR, you'll want to download the `linux-editor-mono` one, but note that due to how Godot's CI is done, the Linux editor build requires .NET (C#) to be installed on the system. 😅 ","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4182964130/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4185152972","html_url":"https://github.com/godotengine/godot/pull/118147#issuecomment-4185152972","issue_url":"https://api.github.com/repos/godotengine/godot/issues/118147","id":4185152972,"node_id":"IC_kwDOAO6SJc75dF3M","user":{"login":"bakana808","id":4042962,"node_id":"MDQ6VXNlcjQwNDI5NjI=","avatar_url":"https://avatars.githubusercontent.com/u/4042962?v=4","gravatar_id":"","url":"https://api.github.com/users/bakana808","html_url":"https://github.com/bakana808","followers_url":"https://api.github.com/users/bakana808/followers","following_url":"https://api.github.com/users/bakana808/following{/other_user}","gists_url":"https://api.github.com/users/bakana808/gists{/gist_id}","starred_url":"https://api.github.com/users/bakana808/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/bakana808/subscriptions","organizations_url":"https://api.github.com/users/bakana808/orgs","repos_url":"https://api.github.com/users/bakana808/repos","events_url":"https://api.github.com/users/bakana808/events{/privacy}","received_events_url":"https://api.github.com/users/bakana808/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-04-03T20:51:52Z","updated_at":"2026-04-03T20:54:11Z","body":"> @bakana808 Hello, may I ask if you can test this PR, please? See https://contributing.godotengine.org/en/latest/pull_requests/testing.html on how to download a build of this PR, you'll want to download the `linux-editor-mono` one, but note that due to how Godot's CI is done, the Linux editor build requires .NET (C#) to be installed on the system. 😅\r\n\r\nThanks for your work on this! I did try it out briefly, and my Gamecube controller seems to be detected in the editor now (I can add input maps and such now), however when testing the game it doesn't seem to be working in the game, at least for me.\r\n\r\nFrom my experience using this GCC adapter, when one app is already \"using\" the adapter, other apps cannot see or use it at the same time. I'm guessing that's what's happening here (the editor is already using the adapter so the game can't see it) but I'll play around with it more when I have more time. I suspect it probably works if I export the game first and run it on its own without the editor.","author_association":"NONE","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4185152972/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4186312216","html_url":"https://github.com/godotengine/godot/pull/118147#issuecomment-4186312216","issue_url":"https://api.github.com/repos/godotengine/godot/issues/118147","id":4186312216,"node_id":"IC_kwDOAO6SJc75hg4Y","user":{"login":"Nintorch","id":92302738,"node_id":"U_kgDOBYBtkg","avatar_url":"https://avatars.githubusercontent.com/u/92302738?v=4","gravatar_id":"","url":"https://api.github.com/users/Nintorch","html_url":"https://github.com/Nintorch","followers_url":"https://api.github.com/users/Nintorch/followers","following_url":"https://api.github.com/users/Nintorch/following{/other_user}","gists_url":"https://api.github.com/users/Nintorch/gists{/gist_id}","starred_url":"https://api.github.com/users/Nintorch/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Nintorch/subscriptions","organizations_url":"https://api.github.com/users/Nintorch/orgs","repos_url":"https://api.github.com/users/Nintorch/repos","events_url":"https://api.github.com/users/Nintorch/events{/privacy}","received_events_url":"https://api.github.com/users/Nintorch/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-04-04T04:23:59Z","updated_at":"2026-04-04T04:48:42Z","body":"Thank you for testing! SDL described that the official adapter can be used exclusively by libusb, which detaches drivers and makes it unusable by the rest of the OS at the moment:\nhttps://github.com/godotengine/godot/blob/3911e0963d39b79a85cb329340c6918397d2d05e/thirdparty/sdl/hidapi/SDL_hidapi.c#L880-L893\n\nThat's what might be happening here, one process (the editor) has acquired the device, so other processes (the debugger with the game) can't see it, but I think running the exported game alone should work!\n\nEDIT: Now that I think about it, maybe we can make the Godot editor disconnect the controller so the game can then detect it, I will need to try it.","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4186312216/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4325066108","html_url":"https://github.com/godotengine/godot/pull/118147#issuecomment-4325066108","issue_url":"https://api.github.com/repos/godotengine/godot/issues/118147","id":4325066108,"node_id":"IC_kwDOAO6SJc8AAAABActFfA","user":{"login":"Nintorch","id":92302738,"node_id":"U_kgDOBYBtkg","avatar_url":"https://avatars.githubusercontent.com/u/92302738?v=4","gravatar_id":"","url":"https://api.github.com/users/Nintorch","html_url":"https://github.com/Nintorch","followers_url":"https://api.github.com/users/Nintorch/followers","following_url":"https://api.github.com/users/Nintorch/following{/other_user}","gists_url":"https://api.github.com/users/Nintorch/gists{/gist_id}","starred_url":"https://api.github.com/users/Nintorch/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Nintorch/subscriptions","organizations_url":"https://api.github.com/users/Nintorch/orgs","repos_url":"https://api.github.com/users/Nintorch/repos","events_url":"https://api.github.com/users/Nintorch/events{/privacy}","received_events_url":"https://api.github.com/users/Nintorch/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-04-27T07:33:11Z","updated_at":"2026-04-27T07:33:11Z","body":"I checked the SDL GameCube HIDAPI driver source code and realized that it calls `SDL_EnableGameCubeAdaptors()` on device initialization and doesn't do anything on joystick open and close, so to fix the problem of the gamepad not working in game debug the code that deals with the gamepads via libusb will have to be changed, which I can't personally do since I don't have the controller (which will require quite a bit of testing) and I don't have any experience working with libusb, so that problem is now outside of the scope of this PR I'm afraid, unless someone can help me fix it :(","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4325066108/reactions","total_count":1,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":1},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4555707938","html_url":"https://github.com/godotengine/godot/pull/118147#issuecomment-4555707938","issue_url":"https://api.github.com/repos/godotengine/godot/issues/118147","id":4555707938,"node_id":"IC_kwDOAO6SJc8AAAABD4qWIg","user":{"login":"ahpakar","id":18503603,"node_id":"MDQ6VXNlcjE4NTAzNjAz","avatar_url":"https://avatars.githubusercontent.com/u/18503603?v=4","gravatar_id":"","url":"https://api.github.com/users/ahpakar","html_url":"https://github.com/ahpakar","followers_url":"https://api.github.com/users/ahpakar/followers","following_url":"https://api.github.com/users/ahpakar/following{/other_user}","gists_url":"https://api.github.com/users/ahpakar/gists{/gist_id}","starred_url":"https://api.github.com/users/ahpakar/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/ahpakar/subscriptions","organizations_url":"https://api.github.com/users/ahpakar/orgs","repos_url":"https://api.github.com/users/ahpakar/repos","events_url":"https://api.github.com/users/ahpakar/events{/privacy}","received_events_url":"https://api.github.com/users/ahpakar/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-05-27T14:54:57Z","updated_at":"2026-05-27T14:54:57Z","body":"Just commenting to confirm that I had the same experience with the mono build on Arch Linux; one can add input maps in the editor but no input is read (at all) when the scene is run. I can help you or others test this with my controller and adapter since I'm pretty desperate for this feature, but I'm not a libusb expert either.","author_association":"NONE","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4555707938/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4631986431","html_url":"https://github.com/godotengine/godot/pull/118147#issuecomment-4631986431","issue_url":"https://api.github.com/repos/godotengine/godot/issues/118147","id":4631986431,"node_id":"IC_kwDOAO6SJc8AAAABFBaA_w","user":{"login":"notroid5","id":87585310,"node_id":"MDQ6VXNlcjg3NTg1MzEw","avatar_url":"https://avatars.githubusercontent.com/u/87585310?v=4","gravatar_id":"","url":"https://api.github.com/users/notroid5","html_url":"https://github.com/notroid5","followers_url":"https://api.github.com/users/notroid5/followers","following_url":"https://api.github.com/users/notroid5/following{/other_user}","gists_url":"https://api.github.com/users/notroid5/gists{/gist_id}","starred_url":"https://api.github.com/users/notroid5/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/notroid5/subscriptions","organizations_url":"https://api.github.com/users/notroid5/orgs","repos_url":"https://api.github.com/users/notroid5/repos","events_url":"https://api.github.com/users/notroid5/event