inks":{"html":{"href":"https://github.com/godotengine/godot/pull/117550#pullrequestreview-3969530544"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/117550"}},"submitted_at":"2026-03-18T17:15:31Z","commit_id":"9140281f527c317de6a558b899f34f38307e388f"}]