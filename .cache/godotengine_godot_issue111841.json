engine/godot/labels/topic:core","name":"topic:core","color":"ffee88","default":false,"description":"","archived_at":null,"archived_by":null},{"id":279098111,"node_id":"MDU6TGFiZWwyNzkwOTgxMTE=","url":"https://api.github.com/repos/godotengine/godot/labels/topic:rendering","name":"topic:rendering","color":"ffee88","default":false,"description":"","archived_at":null,"archived_by":null}],"state":"closed","locked":false,"assignees":[],"milestone":{"url":"https://api.github.com/repos/godotengine/godot/milestones/23","html_url":"https://github.com/godotengine/godot/milestone/23","labels_url":"https://api.github.com/repos/godotengine/godot/milestones/23/labels","id":12939969,"node_id":"MI_kwDOAO6SJc4AxXLB","number":23,"title":"4.6","description":"","creator":{"login":"Repiteo","id":17489292,"node_id":"MDQ6VXNlcjE3NDg5Mjky","avatar_url":"https://avatars.githubusercontent.com/u/17489292?v=4","gravatar_id":"","url":"https://api.github.com/users/Repiteo","html_url":"https://github.com/Repiteo","followers_url":"https://api.github.com/users/Repiteo/followers","following_url":"https://api.github.com/users/Repiteo/following{/other_user}","gists_url":"https://api.github.com/users/Repiteo/gists{/gist_id}","starred_url":"https://api.github.com/users/Repiteo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Repiteo/subscriptions","organizations_url":"https://api.github.com/users/Repiteo/orgs","repos_url":"https://api.github.com/users/Repiteo/repos","events_url":"https://api.github.com/users/Repiteo/events{/privacy}","received_events_url":"https://api.github.com/users/Repiteo/received_events","type":"User","user_view_type":"public","site_admin":false},"open_issues":3,"closed_issues":2978,"state":"closed","created_at":"2025-05-22T16:25:52Z","updated_at":"2026-10-04T16:23:23Z","due_on":null,"closed_at":"2026-01-26T18:09:14Z"},"comments":2,"created_at":"2025-10-20T10:35:24Z","updated_at":"2026-01-23T22:13:02Z","closed_at":"2025-10-20T23:15:21Z","assignee":null,"author_association":"MEMBER","issue_field_values":[],"type":null,"active_lock_reason":null,"draft":false,"pull_request":{"url":"https://api.github.com/repos/godotengine/godot/pulls/111841","html_url":"https://github.com/godotengine/godot/pull/111841","diff_url":"https://github.com/godotengine/godot/pull/111841.diff","patch_url":"https://github.com/godotengine/godot/pull/111841.patch","merged_at":"2025-10-20T23:15:20Z"},"body":"This prevents flat regions of normal maps from progressively getting darker, and causing the normal to distort by distance as a result.\r\n\r\nFor example, when the pixel value is [128, 128, 255], the renormalization makes it [127.999~, 127.999~, 254.999~], which gets floored to [127, 127, 254]. When that also gets normalized, the X and Y become 126.996~, and it progressively gets smaller with each mip level, which causes distortion. Rounding fixes this.\r\n\r\n|Upstream|This PR|\r\n|-|-|\r\n|<img width=\"1146\" height=\"844\" alt=\"master\" src=\"https://github.com/user-attachments/assets/a5fa22da-7d95-4417-bdc3-82e391c465ed\" />|<img width=\"1150\" height=\"848\" alt=\"pr\" src=\"https://github.com/user-attachments/assets/e0dd3269-c429-4128-91fe-71e443e4efc4\" />|\r\n\r\nTest scene is from [here](https://github.com/godotengine/godot/pull/111210#issuecomment-3418374108).\r\n","closed_by":{"login":"Repiteo","id":17489292,"node_id":"MDQ6VXNlcjE3NDg5Mjky","avatar_url":"https://avatars.githubusercontent.com/u/17489292?v=4","gravatar_id":"","url":"https://api.github.com/users/Repiteo","html_url":"https://github.com/Repiteo","followers_url":"https://api.github.com/users/Repiteo/followers","following_url":"https://api.github.com/users/Repiteo/following{/other_user}","gists_url":"https://api.github.com/users/Repiteo/gists{/gist_id}","starred_url":"https://api.github.com/users/Repiteo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Repiteo/subscriptions","organizations_url":"https://api.github.com/users/Repiteo/orgs","repos_url":