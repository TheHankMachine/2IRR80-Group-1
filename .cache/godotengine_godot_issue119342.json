godotengine/godot/labels/topic:rendering","name":"topic:rendering","color":"ffee88","default":false,"description":"","archived_at":null,"archived_by":null}],"state":"closed","locked":false,"assignees":[],"milestone":{"url":"https://api.github.com/repos/godotengine/godot/milestones/25","html_url":"https://github.com/godotengine/godot/milestone/25","labels_url":"https://api.github.com/repos/godotengine/godot/milestones/25/labels","id":15520464,"node_id":"MI_kwDOAO6SJc4A7NLQ","number":25,"title":"4.8","description":"","creator":{"login":"Repiteo","id":17489292,"node_id":"MDQ6VXNlcjE3NDg5Mjky","avatar_url":"https://avatars.githubusercontent.com/u/17489292?v=4","gravatar_id":"","url":"https://api.github.com/users/Repiteo","html_url":"https://github.com/Repiteo","followers_url":"https://api.github.com/users/Repiteo/followers","following_url":"https://api.github.com/users/Repiteo/following{/other_user}","gists_url":"https://api.github.com/users/Repiteo/gists{/gist_id}","starred_url":"https://api.github.com/users/Repiteo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Repiteo/subscriptions","organizations_url":"https://api.github.com/users/Repiteo/orgs","repos_url":"https://api.github.com/users/Repiteo/repos","events_url":"https://api.github.com/users/Repiteo/events{/privacy}","received_events_url":"https://api.github.com/users/Repiteo/received_events","type":"User","user_view_type":"public","site_admin":false},"open_issues":342,"closed_issues":2335,"state":"open","created_at":"2026-04-13T15:59:35Z","updated_at":"2026-10-22T05:57:34Z","due_on":null,"closed_at":null},"comments":3,"created_at":"2026-05-08T17:23:15Z","updated_at":"2026-06-19T09:22:17Z","closed_at":"2026-06-18T18:19:40Z","assignee":null,"author_association":"MEMBER","issue_field_values":[],"type":null,"active_lock_reason":null,"draft":false,"pull_request":{"url":"https://api.github.com/repos/godotengine/godot/pulls/119342","html_url":"https://github.com/godotengine/godot/pull/119342","diff_url":"https://github.com/godotengine/godot/pull/119342.diff","patch_url":"https://github.com/godotengine/godot/pull/119342.patch","merged_at":"2026-06-18T18:19:40Z"},"body":"Stores the texture type and format in the shader container so they can be validated when creating uniform sets.\r\n\r\n---\r\n\r\nTexture type mismatches can be very fatal and may crash the GPU driver entirely. Using this check, I caught two error cases:\r\n- SDFGI specified `USE_OCTMAP_ARRAY` for radiance arrays, but the actual shader definition was different. So, it was accessing a `texture2DArray` as a `texture2D`.\r\n- Sky shaders were similarly passing a `texture2DArray` instead of a `texture2D` as the `RADIANCE` texture in user shaders.\r\n\r\nThe latter has an odd catch. Without radiance arrays, the mipmaps act as roughness levels in the user shader. What is the intended behavior here?\r\n\r\n---\r\n\r\nThe texture format validation mainly exists to shut up the Vulkan validation layers. I fixed the easy cases, but some more complicated ones may require multiple shader variants, so the check is disabled by default for now.\r\n\r\nI'm not sure if these are urgent, since desktop GPUs appear to ignore the format. It _is_ required on some mobile vendors, but AFAIK the mobile renderer only utilizes the octmap compute shaders, whose mismatches I already fixed in #114419.\r\n\r\n---\r\n\r\nFixes #119012.","closed_by":{"login":"Repiteo","id":17489292,"node_id":"MDQ6VXNlcjE3NDg5Mjky","avatar_url":"https://avatars.githubusercontent.com/u/17489292?v=4","gravatar_id":"","url":"https://api.github.com/users/Repiteo","html_url":"https://github.com/Repiteo","followers_url":"https://api.github.com/users/Repiteo/followers","following_url":"https://api.github.com/users/Repiteo/following{/other_user}","gists_url":"https://api.github.com/users/Repiteo/gists{/gist_id}","starred_url":"https://api.github.com/users/Repiteo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Repiteo/subscriptions","organizations_url":"https://api.github.com/users/Repiteo/orgs","repos_url":"https://api.github.com/users/Repiteo/repos","events_url":"https://api.github.com/users/Repiteo/events{/privacy}","received_events_url":"https://api.github.com/users/Repiteo/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/119342/reactions","total_count":2,"+1":2,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/godotengine/godot/issues/119342/timeline","performed_via_github_app":null,"state_reason":null}