[{"id":3455850749,"node_id":"PRR_kwDOAO6SJc7N_Bj9","user":{"login":"Ivorforce","id":2308167,"node_id":"MDQ6VXNlcjIzMDgxNjc=","avatar_url":"https://avatars.githubusercontent.com/u/2308167?u=f7f8e0273f784f5ec6f6b7fe4a88d449896eb48a&v=4","gravatar_id":"","url":"https://api.github.com/users/Ivorforce","html_url":"https://github.com/Ivorforce","followers_url":"https://api.github.com/users/Ivorforce/followers","following_url":"https://api.github.com/users/Ivorforce/following{/other_user}","gists_url":"https://api.github.com/users/Ivorforce/gists{/gist_id}","starred_url":"https://api.github.com/users/Ivorforce/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Ivorforce/subscriptions","organizations_url":"https://api.github.com/users/Ivorforce/orgs","repos_url":"https://api.github.com/users/Ivorforce/repos","events_url":"https://api.github.com/users/Ivorforce/events{/privacy}","received_events_url":"https://api.github.com/users/Ivorforce/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"We discussed this fix in the core meeting.\r\nWe agree that the approach you take (rejecting the object deletion in the editor only) is appropriate.\r\n\r\nHowever, there are two changes I think are needed:\r\n\r\n- Check for whether it's actually the editor via `Engine::get_singleton()->is_editor_hint()`. Otherwise, the runtime using the editor binary will also reject the deletion, causing a discrepancy in `DEBUG` vs `RELEASE`.\r\n- Move this check to `node.cpp` in the `NOTIFICATION_PREDELETE` handler, right after the `is_main_thread` check. This will prevent the same kind of bug when using `.free()` and `memdelete`. You can reject deletion here using `cancel_free()` (and `return`).\r\n","state":"COMMENTED","html_url":"https://github.com/godotengine/godot/pull/112401#pullrequestreview-3455850749","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/112401","author_association":"MEMBER","_links":{"html":{"href":"https://github.com/godotengine/godot/pull/112401#pullrequestreview-3455850749"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/112401"}},"submitted_at":"2025-11-12T22:54:55Z","commit_id":null},{"id":3459629929,"node_id":"PRR_kwDOAO6SJc7ONcNp","user":{"login":"Ivorforce","id":2308167,"node_id":"MDQ6VXNlcjIzMDgxNjc=","avatar_url":"https://avatars.githubusercontent.com/u/2308167?u=f7f8e0273f784f5ec6f6b7fe4a88d449896eb48a&v=4","gravatar_id":"","url":"https://api.github.com/users/Ivorforce","html_url":"https://github.com/Ivorforce","followers_url":"https://api.github.com/users/Ivorforce/followers","following_url":"https://api.github.com/users/Ivorforce/following{/other_user}","gists_url":"https://api.github.com/users/Ivorforce/gists{/gist_id}","starred_url":"https://api.github.com/users/Ivorforce/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Ivorforce/subscriptions","organizations_url":"https://api.github.com/users/Ivorforce/orgs","repos_url":"https://api.github.com/users/Ivorforce/repos","events_url":"https://api.github.com/users/Ivorforce/events{/privacy}","received_events_url":"https://api.github.com/users/Ivorforce/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"Looks good to me, thanks for adjusting.\n\nI tested that this new version still fixes the issue.","state":"APPROVED","html_url":"https://github.com/godotengine/godot/pull/112401#pullrequestreview-3459629929","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/112401","author_association":"MEMBER","_links":{"html":{"href":"https://github.com/godotengine/godot/pull/112401#pullrequestreview-3459629929"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/112401"}},"submitted_at":"2025-11-13T12:46:54Z","commit_id":null},{"id":3459712466,"node_id":"PRR_kwDOAO6SJc7ONwXS","user":{"login":"AThousandShips","id":96648715,"node_id":"U_kgDOBcK-Cw","avatar_url":"https://avatars.github