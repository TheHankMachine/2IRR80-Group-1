at":null,"archived_by":null},{"id":2304948121,"node_id":"MDU6TGFiZWwyMzA0OTQ4MTIx","url":"https://api.github.com/repos/godotengine/godot/labels/topic:codestyle","name":"topic:codestyle","color":"ffee88","default":false,"description":"","archived_at":null,"archived_by":null}],"state":"closed","locked":false,"assignees":[],"milestone":{"url":"https://api.github.com/repos/godotengine/godot/milestones/22","html_url":"https://github.com/godotengine/godot/milestone/22","labels_url":"https://api.github.com/repos/godotengine/godot/milestones/22/labels","id":12070367,"node_id":"MI_kwDOAO6SJc4AuC3f","number":22,"title":"4.5","description":"","creator":{"login":"Sauermann","id":6299227,"node_id":"MDQ6VXNlcjYyOTkyMjc=","avatar_url":"https://avatars.githubusercontent.com/u/6299227?v=4","gravatar_id":"","url":"https://api.github.com/users/Sauermann","html_url":"https://github.com/Sauermann","followers_url":"https://api.github.com/users/Sauermann/followers","following_url":"https://api.github.com/users/Sauermann/following{/other_user}","gists_url":"https://api.github.com/users/Sauermann/gists{/gist_id}","starred_url":"https://api.github.com/users/Sauermann/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Sauermann/subscriptions","organizations_url":"https://api.github.com/users/Sauermann/orgs","repos_url":"https://api.github.com/users/Sauermann/repos","events_url":"https://api.github.com/users/Sauermann/events{/privacy}","received_events_url":"https://api.github.com/users/Sauermann/received_events","type":"User","user_view_type":"public","site_admin":false},"open_issues":3,"closed_issues":3687,"state":"closed","created_at":"2024-12-19T08:51:28Z","updated_at":"2026-09-04T21:48:38Z","due_on":"2025-09-15T00:00:00Z","closed_at":"2025-09-18T17:13:14Z"},"comments":4,"created_at":"2025-04-17T18:30:45Z","updated_at":"2025-05-22T17:25:19Z","closed_at":"2025-05-22T17:22:11Z","assignee":null,"author_association":"MEMBER","issue_field_values":[],"type":null,"active_lock_reason":null,"draft":false,"pull_request":{"url":"https://api.github.com/repos/godotengine/godot/pulls/105505","html_url":"https://github.com/godotengine/godot/pull/105505","diff_url":"https://github.com/godotengine/godot/pull/105505.diff","patch_url":"https://github.com/godotengine/godot/pull/105505.patch","merged_at":"2025-05-22T17:22:10Z"},"body":"Originally part of https://github.com/godotengine/godot/pull/104522.\r\n\r\nThe changes are mostly explained there, but in short, this PR is a no-op that simply cleans up use of `force_trivial` to where it's actually impactful, to make it clearer what it does. The other places where it was used before were unnecessary and had no effect.\r\n\r\nThis _does_ change use of `LocalVector` if trivial is set to true on non trivially destructible objects. We currently don't do this, and neither should we, because it would be an unsafe use of the collection. If something is adding and removing objects but constructing and destructing by hand, they should probably wrap their own collection instead. The reason being that almost all functions _require_ objects to be initialized correctly on access, insert, remove, etc.\r\nInstead, `force_trivial` is only used in our codebase to skip the default initializer on `resize`.","closed_by":{"login":"Repiteo","id":17489292,"node_id":"MDQ6VXNlcjE3NDg5Mjky","avatar_url":"https://avatars.githubusercontent.com/u/17489292?v=4","gravatar_id":"","url":"https://api.github.com/users/Repiteo","html_url":"https://github.com/Repiteo","followers_url":"https://api.github.com/users/Repiteo/followers","following_url":"https://api.github.com/users/Repiteo/following{/other_user}","gists_url":"https://api.github.com/users/Repiteo/gists{/gist_id}","starred_url":"https://api.github.com/users/Repiteo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Repiteo/subscriptions","organizations_url":"https://api.github.com/users/Repiteo/orgs","repos_url":"https://api.github.com/users/Repiteo/repos","events_url":"https://api.github.com/users/Repiteo/events{/privacy}","received_events_url":"https://api.github.com/users/Repiteo/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/105505/reactions","total_count":2,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":2,"eyes":0},"timeline_url":"https://api.github.com/repos/godotengine/godot/issues/105505/timeline","performed_via_github_app":null,"state_reason":null}