uld not be responsive anymore.\n\n### Minimal reproduction project (MRP)\n\nN/A","closed_by":{"login":"abrossimow","id":116030901,"node_id":"U_kgDOBup9tQ","avatar_url":"https://avatars.githubusercontent.com/u/116030901?v=4","gravatar_id":"","url":"https://api.github.com/users/abrossimow","html_url":"https://github.com/abrossimow","followers_url":"https://api.github.com/users/abrossimow/followers","following_url":"https://api.github.com/users/abrossimow/following{/other_user}","gists_url":"https://api.github.com/users/abrossimow/gists{/gist_id}","starred_url":"https://api.github.com/users/abrossimow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/abrossimow/subscriptions","organizations_url":"https://api.github.com/users/abrossimow/orgs","repos_url":"https://api.github.com/users/abrossimow/repos","events_url":"https://api.github.com/users/abrossimow/events{/privacy}","received_events_url":"https://api.github.com/users/abrossimow/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/108138/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/godotengine/godot/issues/108138/timeline","performed_via_github_app":null,"state_reason":"completed","pinned_comment":null}