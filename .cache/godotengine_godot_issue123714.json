com/users/Repiteo/orgs","repos_url":"https://api.github.com/users/Repiteo/repos","events_url":"https://api.github.com/users/Repiteo/events{/privacy}","received_events_url":"https://api.github.com/users/Repiteo/received_events","type":"User","user_view_type":"public","site_admin":false},"open_issues":345,"closed_issues":2336,"state":"open","created_at":"2026-04-13T15:59:35Z","updated_at":"2026-10-22T08:21:32Z","due_on":null,"closed_at":null},"comments":5,"created_at":"2026-09-22T15:57:49Z","updated_at":"2026-09-28T23:26:14Z","closed_at":"2026-09-28T23:26:14Z","assignee":null,"author_association":"CONTRIBUTOR","issue_field_values":[],"type":null,"active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"### Tested versions\n\n- Reproducible in: `v4.8.dev6.mono.official [8898c2b3d]`\n- Not reproducible in: `v4.8.dev5.mono.official [9552dfb68]`\n\nI am using Godot .NET, but I don't think that's relevant here.\n\n### System information\n\nGodot v4.8.dev6.mono - macOS Unknown (27.0.0) - Multi-window, 3 monitors (5120x2880 @ 60.00 Hz, 3024x1964 @ 120.00 Hz, 5120x2880 @ 60.00 Hz) - Metal (Mobile) - integrated Apple M5 Pro (Apple9) - Apple M5 Pro (18 threads) - 64.00 GiB memory - CoreAudio (48000 Hz, Stereo/mono)\n\n### Issue description\n\nAn Xcode project exported for iOS fails to build/link with the following error.\n```\nUndefined symbols for architecture arm64:\n  \"_SDL_GetPrefPath\", referenced from:\n      _SDL_IOFromFile in libgodot.a[1144](SDL_iostream.ios.template_debug.arm64.o)\nld: symbol(s) not found for architecture arm64\n***.xcodeproj: sdl-test-2: clang++: error: linker command failed with exit code 1 (use -v to see invocation)\n```\n\nI suspect that https://github.com/godotengine/godot/issues/120373 introduced the regression.\n\nSeems related to https://github.com/godotengine/godot/issues/122549\n\nI think the problematic section is this:\nhttps://github.com/godotengine/godot/blob/0f1b62b707d681eef2fbd8d731642a3e196c4484/thirdparty/sdl/io/SDL_iostream.c#L961-L985\n\nCompiling out that entire else block with the GetPrefPath seems to fix it, similar to:\nhttps://github.com/godotengine/godot/blob/0f1b62b707d681eef2fbd8d731642a3e196c4484/thirdparty/sdl/SDL.c#L306-L308\n\nBut I am not familiar enough with the codebase to judge what this might break, or how to introduce patches to SDL. Would appreciate some comments or feedback.\n\n\n### Steps to reproduce\n\n1. Create a new empty Godot project with a main scene.\n2. Add an iOS export preset, fix the usual project settings errors.\n3. Enable Export Project Only.\n4. Export the Xcode project.\n5. Build the project:\n    ```sh\n    xcodebuild -project <path-to>.xcodeproj -sdk iphoneos CODE_SIGNING_ALLOWED=NO\n    ````\n\n### Minimal reproduction project (MRP)\n\nN/A","closed_by":{"login":"Repiteo","id":17489292,"node_id":"MDQ6VXNlcjE3NDg5Mjky","avatar_url":"https://avatars.githubusercontent.com/u/17489292?v=4","gravatar_id":"","url":"https://api.github.com/users/Repiteo","html_url":"https://github.com/Repiteo","followers_url":"https://api.github.com/users/Repiteo/followers","following_url":"https://api.github.com/users/Repiteo/following{/other_user}","gists_url":"https://api.github.com/users/Repiteo/gists{/gist_id}","starred_url":"https://api.github.com/users/Repiteo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Repiteo/subscriptions","organizations_url":"https://api.github.com/users/Repiteo/orgs","repos_url":"https://api.github.com/users/Repiteo/repos","events_url":"https://api.github.com/users/Repiteo/events{/privacy}","received_events_url":"https://api.github.com/users/Repiteo/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/123714/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0