7840","issue_url":"https://api.github.com/repos/godotengine/godot/issues/110921","id":3616227840,"node_id":"IC_kwDOAO6SJc7Xi0IA","user":{"login":"bruvzg","id":7645683,"node_id":"MDQ6VXNlcjc2NDU2ODM=","avatar_url":"https://avatars.githubusercontent.com/u/7645683?v=4","gravatar_id":"","url":"https://api.github.com/users/bruvzg","html_url":"https://github.com/bruvzg","followers_url":"https://api.github.com/users/bruvzg/followers","following_url":"https://api.github.com/users/bruvzg/following{/other_user}","gists_url":"https://api.github.com/users/bruvzg/gists{/gist_id}","starred_url":"https://api.github.com/users/bruvzg/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/bruvzg/subscriptions","organizations_url":"https://api.github.com/users/bruvzg/orgs","repos_url":"https://api.github.com/users/bruvzg/repos","events_url":"https://api.github.com/users/bruvzg/events{/privacy}","received_events_url":"https://api.github.com/users/bruvzg/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-12-05T10:23:00Z","updated_at":"2025-12-05T10:23:00Z","body":"Note: there are 3 places where it should be removed:\r\n\r\n```diff\r\ndiff --git a/modules/freetype/SCsub b/modules/freetype/SCsub\r\nindex 1346d818ef..99507adbb6 100644\r\n--- a/modules/freetype/SCsub\r\n+++ b/modules/freetype/SCsub\r\n@@ -35,7 +35,6 @@ if env[\"builtin_freetype\"]:\r\n         \"src/base/fttype1.c\",\r\n         \"src/base/ftwinfnt.c\",\r\n         \"src/bdf/bdf.c\",\r\n-        \"src/bzip2/ftbzip2.c\",\r\n         \"src/cache/ftcache.c\",\r\n         \"src/cff/cff.c\",\r\n         \"src/cid/type1cid.c\",\r\ndiff --git a/modules/text_server_adv/gdextension_build/SConstruct b/modules/text_server_adv/gdextension_build/SConstruct\r\nindex c85d349e71..8cad2a51d5 100644\r\n--- a/modules/text_server_adv/gdextension_build/SConstruct\r\n+++ b/modules/text_server_adv/gdextension_build/SConstruct\r\n@@ -189,7 +189,6 @@ if env[\"freetype_enabled\"]:\r\n         \"src/base/fttype1.c\",\r\n         \"src/base/ftwinfnt.c\",\r\n         \"src/bdf/bdf.c\",\r\n-        \"src/bzip2/ftbzip2.c\",\r\n         \"src/cache/ftcache.c\",\r\n         \"src/cff/cff.c\",\r\n         \"src/cid/type1cid.c\",\r\ndiff --git a/modules/text_server_fb/gdextension_build/SConstruct b/modules/text_server_fb/gdextension_build/SConstruct\r\nindex 5a0adef7c5..a6aecae356 100644\r\n--- a/modules/text_server_fb/gdextension_build/SConstruct\r\n+++ b/modules/text_server_fb/gdextension_build/SConstruct\r\n@@ -184,7 +184,6 @@ if env[\"freetype_enabled\"]:\r\n         \"src/base/fttype1.c\",\r\n         \"src/base/ftwinfnt.c\",\r\n         \"src/bdf/bdf.c\",\r\n-        \"src/bzip2/ftbzip2.c\",\r\n         \"src/cache/ftcache.c\",\r\n         \"src/cff/cff.c\",\r\n         \"src/cid/type1cid.c\",\r\n```","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3616227840/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3616294088","html_url":"https://github.com/godotengine/godot/pull/110921#issuecomment-3616294088","issue_url":"https://api.github.com/repos/godotengine/godot/issues/110921","id":3616294088,"node_id":"IC_kwDOAO6SJc7XjETI","user":{"login":"akien-mga","id":4701338,"node_id":"MDQ6VXNlcjQ3MDEzMzg=","avatar_url":"https://avatars.githubusercontent.com/u/4701338?v=4","gravatar_id":"","url":"https://api.github.com/users/akien-mga","html_url":"https://github.com/akien-mga","followers_url":"https://api.github.com/users/akien-mga/followers","following_url":"https://api.github.com/users/akien-mga/following{/other_user}","gists_url":"https://api.github.com/users/akien-mga/gists{/gist_id}","starred_url":"https://api.github.com/users/akien-mga/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/akien-mga/subscriptions","organizations_url":"https://api.github.com/users/akien-mga/orgs","repos_url":"https://api.github.com/users/akien-mga/repos","events_url":"https://api.github.com/users/akien-mga/events{/privacy}","received_events_url":"https://api.github.com/users/akien-mga/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-12-05T10:38:56Z","updated_at":"2025-12-05T11:14:56Z","body":"> We do not use it, so removing should be fine, it seems to be only used for BDF/PCF files which aren't supported by the engine.\r\n\r\nI wonder if it would be worth the extra config and removal of files to drop BDF/PCF support in FreeType if we don't need it.\r\nFrom a quick look, it seems like not just bzip2 but also lzw and zlib are \"mostly used to parse many of the PCF files that come with XFree86.\"\r\n\r\n*Edit:* The docs are outdated, gzip/zlib is also used for WOFF support, so we need it.\r\n\r\nProbably not if it's hard to maintain downstream, and I assume LTO might already remove what we don't need?","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3616294088/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3616298304","html_url":"https://github.com/godotengine/godot/pull/110921#issuecomment-3616298304","issue_url":"https://api.github.com/repos/godotengine/godot/issues/110921","id":3616298304,"node_id":"IC_kwDOAO6SJc7XjFVA","user":{"login":"RubisetCie","id":8605259,"node_id":"MDQ6VXNlcjg2MDUyNTk=","avatar_url":"https://avatars.githubusercontent.com/u/8605259?v=4","gravatar_id":"","url":"https://api.github.com/users/RubisetCie","html_url":"https://github.com/RubisetCie","followers_url":"https://api.github.com/users/RubisetCie/followers","following_url":"https://api.github.com/users/RubisetCie/following{/other_user}","gists_url":"https://api.github.com/users/RubisetCie/gists{/gist_id}","starred_url":"https://api.github.com/users/RubisetCie/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/RubisetCie/subscriptions","organizations_url":"https://api.github.com/users/RubisetCie/orgs","repos_url":"https://api.github.com/users/RubisetCie/repos","events_url":"https://api.github.com/users/RubisetCie/events{/privacy}","received_events_url":"https://api.github.com/users/RubisetCie/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-12-05T10:40:10Z","updated_at":"2025-12-05T10:40:10Z","body":"> This is a bit worrying though. Can you still reproduce this issue, and if so what's your build environment and build command?\r\n\r\nIt happened on my machine when trying to build Godot 4.5 three month ago, I will see if I can reproduce the issue now, and I will send you my `custom.py` file as well when I get back from work.\r\n\r\nThe command I used is the following (usual one, but I had a custom.py):\r\n```\r\nscons platform=linuxbsd target=editor debug_symbols=no use_static_cpp=no arch=x86_64\r\n```","author_association":"NONE","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3616298304/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3616322982","html_url":"https://github.com/godotengine/godot/pull/110921#issuecomment-3616322982","issue_url":"https://api.github.com/repos/godotengine/godot/issues/110921","id":3616322982,"node_id":"IC_kwDOAO6SJc7XjLWm","user":{"login":"ghost","id":10137,"node_id":"MDQ6VXNlcjEwMTM3","avatar_url":"https://avatars.githubusercontent.com/u/10137?v=4","gravatar_id":"","url":"https://api.github.com/users/ghost","html_url":"https://github.com/ghost","followers_url":"https://a