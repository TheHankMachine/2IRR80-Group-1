pi.github.com/users/akien-mga/orgs","repos_url":"https://api.github.com/users/akien-mga/repos","events_url":"https://api.github.com/users/akien-mga/events{/privacy}","received_events_url":"https://api.github.com/users/akien-mga/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-12-05T11:37:22Z","updated_at":"2025-12-05T11:37:22Z","body":"I already made a proof of concept for removing BDF/PCF and Bzip2/LZW: https://github.com/akien-mga/godot/tree/freetype-no-bdf-pcf\r\n\r\nLinux release templates with LTO:\r\n```\r\n-rwxr-xr-x.  1 akien akien 71857744 Dec  5 12:13 godot.linuxbsd.template_release.x86_64.master\r\n-rwxr-xr-x.  1 akien akien 71808592 Dec  5 12:19 godot.linuxbsd.template_release.x86_64.no-bdf-pcf\r\n```\r\n\r\nSo this saves 48 KiB. Might not be worth the trouble?","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3616534155/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3616584449","html_url":"https://github.com/godotengine/godot/pull/110921#issuecomment-3616584449","issue_url":"https://api.github.com/repos/godotengine/godot/issues/110921","id":3616584449,"node_id":"IC_kwDOAO6SJc7XkLMB","user":{"login":"RubisetCie","id":8605259,"node_id":"MDQ6VXNlcjg2MDUyNTk=","avatar_url":"https://avatars.githubusercontent.com/u/8605259?v=4","gravatar_id":"","url":"https://api.github.com/users/RubisetCie","html_url":"https://github.com/RubisetCie","followers_url":"https://api.github.com/users/RubisetCie/followers","following_url":"https://api.github.com/users/RubisetCie/following{/other_user}","gists_url":"https://api.github.com/users/RubisetCie/gists{/gist_id}","starred_url":"https://api.github.com/users/RubisetCie/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/RubisetCie/subscriptions","organizations_url":"https://api.github.com/users/RubisetCie/orgs","repos_url":"https://api.github.com/users/RubisetCie/repos","events_url":"https://api.github.com/users/RubisetCie/events{/privacy}","received_events_url":"https://api.github.com/users/RubisetCie/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-12-05T11:54:32Z","updated_at":"2025-12-05T11:56:08Z","body":"I think yes, 48 KiB is worth it, given the fact that it's unused regardless and is a very straightforward commit.\r\n\r\n... and it will resolve my compilation problem. :)","author_association":"NONE","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3616584449/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3618656764","html_url":"https://github.com/godotengine/godot/pull/110921#issuecomment-3618656764","issue_url":"https://api.github.com/repos/godotengine/godot/issues/110921","id":3618656764,"node_id":"IC_kwDOAO6SJc7XsFH8","user":{"login":"RubisetCie","id":8605259,"node_id":"MDQ6VXNlcjg2MDUyNTk=","avatar_url":"https://avatars.githubusercontent.com/u/8605259?v=4","gravatar_id":"","url":"https://api.github.com/users/RubisetCie","html_url":"https://github.com/RubisetCie","followers_url":"https://api.github.com/users/RubisetCie/followers","following_url":"https://api.github.com/users/RubisetCie/following{/other_user}","gists_url":"https://api.github.com/users/RubisetCie/gists{/gist_id}","starred_url":"https://api.github.com/users/RubisetCie/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/RubisetCie/subscriptions","organizations_url":"https://api.github.com/users/RubisetCie/orgs","repos_url":"https://api.github.com/users/RubisetCie/repos","events_url":"https://api.github.com/users/RubisetCie/event