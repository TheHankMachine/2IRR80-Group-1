d_by":null},{"id":2666708289,"node_id":"MDU6TGFiZWwyNjY2NzA4Mjg5","url":"https://api.github.com/repos/godotengine/godot/labels/topic:3d","name":"topic:3d","color":"ffee88","default":false,"description":"","archived_at":null,"archived_by":null}],"state":"open","locked":false,"assignees":[],"milestone":null,"comments":0,"created_at":"2026-08-15T12:38:49Z","updated_at":"2026-08-17T05:46:41Z","closed_at":null,"assignee":null,"author_association":"NONE","issue_field_values":[],"type":null,"active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"### Tested versions\n\n7.7.1.stable\n\n### System information\n\nMacOS 26.6.1 (25G76)\n\n### Issue description\n\nLabel3D does not allow multiple line breaks, meaning \"Line one. \\n\\n Another line.\" becomes \"Line one. \\n Another line.\"\n\nSome further observations:\n- It doesn't matter which font I load, even the default font does it.\n- Setting the text in the inspector versus through script does not matter either.\n- A \"regular\" Label does NOT produce the same behavior, multiple line breaks are supported fine.\n\nScreenshot to demonstrate:\n\n<img width=\"5108\" height=\"2410\" alt=\"Image\" src=\"https://github.com/user-attachments/assets/f2ba0757-666a-4028-8915-c1440b935c99\" />\n\n### Steps to reproduce\n\nCreate a Label3D and enter a text with multiple line breaks.\n\n### Minimal reproduction project (MRP)\n\n[label-3d-bug-mrp.zip](https://github.com/user-attachments/files/31101242/label-3d-bug-mrp.zip)","closed_by":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/122439/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/godotengine/godot/issues/122439/timeline","performed_via_github_app":null,"state_reason":null,"pinned_comment":null}