d52e925dc9f","user":{"login":"m4gr3d","id":914968,"node_id":"MDQ6VXNlcjkxNDk2OA==","avatar_url":"https://avatars.githubusercontent.com/u/914968?v=4","gravatar_id":"","url":"https://api.github.com/users/m4gr3d","html_url":"https://github.com/m4gr3d","followers_url":"https://api.github.com/users/m4gr3d/followers","following_url":"https://api.github.com/users/m4gr3d/following{/other_user}","gists_url":"https://api.github.com/users/m4gr3d/gists{/gist_id}","starred_url":"https://api.github.com/users/m4gr3d/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/m4gr3d/subscriptions","organizations_url":"https://api.github.com/users/m4gr3d/orgs","repos_url":"https://api.github.com/users/m4gr3d/repos","events_url":"https://api.github.com/users/m4gr3d/events{/privacy}","received_events_url":"https://api.github.com/users/m4gr3d/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"Do we get a similar error when a call is made on an actual `null` instance?","created_at":"2025-02-07T08:47:57Z","updated_at":"2025-02-07T08:47:57Z","html_url":"https://github.com/godotengine/godot/pull/102494#discussion_r1946167620","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/102494","_links":{"self":{"href":"https://api.github.com/repos/godotengine/godot/pulls/comments/1946167620"},"html":{"href":"https://github.com/godotengine/godot/pull/102494#discussion_r1946167620"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/102494"}},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/1946167620/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":159,"original_line":159,"side":"RIGHT","author_association":"CONTRIBUTOR","original_position":4,"position":4,"subject_type":"line"},{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/1946760538","pull_request_review_id":2602129509,"id":1946760538,"node_id":"PRRC_kwDOAO6SJc50CTVa","diff_hunk":"@@ -156,6 +156,9 @@ bool JavaClass::_call_method(JavaObject *p_instance, const StringName &p_method,\n \t}\n \n \tif (!method) {\n+\t\tif (r_error.error == Callable::CallError::CALL_ERROR_INSTANCE_IS_NULL) {","path":"platform/android/java_class_wrapper.cpp","commit_id":"96bde8f221ff88d12d0c49a8ed40ed52e925dc9f","original_commit_id":"96bde8f221ff88d12d0c49a8ed40ed52e925dc9f","user":{"login":"dsnopek","id":191561,"node_id":"MDQ6VXNlcjE5MTU2MQ==","avatar_url":"https://avatars.githubusercontent.com/u/191561?v=4","gravatar_id":"","url":"https://api.github.com/users/dsnopek","html_url":"https://github.com/dsnopek","followers_url":"https://api.github.com/users/dsnopek/followers","following_url":"https://api.github.com/users/dsnopek/following{/other_user}","gists_url":"https://api.github.com/users/dsnopek/gists{/gist_id}","starred_url":"https://api.github.com/users/dsnopek/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/dsnopek/subscriptions","organizations_url":"https://api.github.com/users/dsnopek/orgs","repos_url":"https://api.github.com/users/dsnopek/repos","events_url":"https://api.github.com/users/dsnopek/events{/privacy}","received_events_url":"https://api.github.com/users/dsnopek/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"Do you mean with a `null` value in GDScript?\r\n\r\nIf so, no, `null` in GDScript is `Variant::NIL` and doesn't have an object type. So, for example:\r\n\r\n```gdscript\r\nclass B:\r\n\tfunc some_method():\r\n\t\tprint(\"hi\")\r\n\r\nfunc _ready() -> void:\r\n\tvar b: B\r\n\tb.some_method()\r\n```\r\n\r\n... will lead to this error:\r\n\r\n```\r\nInvalid call. Nonexistent function 'some_method' in base 'Nil'.\r\n```\r\n\r\nBut this GDScript snippet isn't the best equivalent to this situation.\r\n\r\nA closer equivalent would be:\r\n\r\n```gdscript\r\nfunc _ready() -> void:\r\n\tB.some_method()\r\n```\r\n\r\nHowever, that won't even get to runtime, because it gets caught by the GDScript parser, with the very nice error of:\r\n\r\n```\r\nParser Error: Cannot call non-static function \"some_method\" on the class \"B\" directly. Make an instance instead.\r\n```\r\n\r\nThis error is what I modeled the error in this PR on. But, like I said, we can't make GDScript give that error itself in our case, because that's a parser error, and `JavaClass` only knows what methods each class has at runtime.\r\n\r\nThe closest equivalent to this in GDScript at runtime would be:\r\n\r\n```gdscript\r\nfunc _ready() -> void:\r\n\tvar c = Callable(B, \"some_method\")\r\n\tc.call()\r\n```\r\n\r\n... which leads to the slightly less nice, but still nice message of:\r\n\r\n```\r\nCan't call non-static function 'some_method' in script.\r\n```\r\n\r\nStrangely, in this last case, GDScript considers this `CALL_OK` even though it's not actually calling anything.\r\n\r\nAnyway, I guess that's all to say, it's a pretty mixed bag, and Godot does a wide variety of different things in similar situations, but I tried to match the one that seemed the nicest :-)","created_at":"2025-02-07T15:56:01Z","updated_at":"2025-02-07T15:56:59Z","html_url":"https://github.com/godotengine/godot/pull/102494#discussion_r1946760538","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/102494","_links":{"self":{"href":"https://api.github.com/repos/godotengine/godot/pulls/comments/1946760538"},"html":{"href":"https://github.com/godotengine/godot/pull/102494#discussion_r1946760538"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/102494"}},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/1946760538/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":159,"original_line":159,"side":"RIGHT","in_reply_to_id":1946167620,"author_association":"CONTRIBUTOR","original_position":4,"position":4,"subject_type":"line"},{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/1946797663","pull_request_review_id":2602187602,"id":1946797663,"node_id":"PRRC_kwDOAO6SJc50CcZf","diff_hunk":"@@ -156,6 +156,9 @@ bool JavaClass::_call_method(JavaObject *p_instance, const StringName &p_method,\n \t}\n \n \tif (!method) {\n+\t\tif (r_error.error == Callable::CallError::CALL_ERROR_INSTANCE_IS_NULL) {","path":"platform/android/java_class_wrapper.cpp","commit_id":"96bde8f221ff88d12d0c49a8ed40ed52e925dc9f","original_commit_id":"96bde8f221ff88d12d0c49a8ed40ed52e925dc9f","user":{"login":"syntaxerror247","id":176927541,"node_id":"U_kgDOCouzNQ","avatar_url":"https://avatars.githubusercontent.com/u/176927541?v=4","gravatar_id":"","url":"https://api.github.com/users/syntaxerror247","html_url":"https://github.com/syntaxerror247","followers_url":"https://api.github.com/users/syntaxerror247/followers","following_url":"https://api.github.com/users/syntaxerror247/following{/other_user}","gists_url":"https://api.github.com/users/syntaxerror247/gists{/gist_id}","starred_url":"https://api.github.com/users/syntaxerror247/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/syntaxerror247/subscriptions","organizations_url":"https://api.github.com/users/syntaxerror247/orgs","repos_url":"https://api.github.com/users/syntaxerror247/repos","events_url":"https://api.github.com/users/syntaxerror247/events{/privacy}","received_events_url":"https://api.github.com/users/syntaxerror247/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"@dsnopek, I believe @m4gr3d is asking whether calling a method on a null instance results in a similar error. For example, would calling `location_manager.hasProvider(\"gps\")` trigger the same error if `location_manager` is actually null?","created_at":"2025-02-07T16:17:19Z","updated_at":"2025-02-07T16:17:19Z","html_url":"https://github.com/godotengine/godot/pull/102494#discussion_r1946797663","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/102494","_links":{"self":{"href":"https://api.github.com/repos/godotengine/godot/pulls/comments/1946797663"},"html":{"href":"https://github.com/godotengine/godot/pull/102494#discussion_r1946797663"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/102494"}},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/1946797663/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":159,"original_line":159,"side":"RIGHT","in_reply_to_id":1946167620,"author_association":"MEMBER","original_position":4,"position":4,"subject_type":"line"},{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/1946885085","pull_request_review_id":2602339127,"id":1946885085,"node_id":"PRRC_kwDOAO6SJc50Cxvd","diff_hunk":"@@ -156,6 +156,9 @@ bool JavaClass::_call_method(JavaObject *p_instance, const StringName &p_method,\n \t}\n \n \tif (!method) {\n+\t\tif (r_error.error == Callable::CallError::CALL_ERROR_INSTANCE_IS_NULL) {","path":"platform/android/java_class_wrapper.cpp","commit_id":"96bde8f221ff88d12d0c49a8ed40ed52e925dc9f","original_commit_id":"96bde8f221ff88d12d0c49a8ed40ed52e925dc9f","user":{"login":"dsnopek","id":191561,"node_id":"MDQ6VXNlcjE5MTU2MQ==","avatar_url":"https://avatars.githubusercontent.com/u/191561?v=4","gravatar_id":"","url":"https://api.github.com/users/dsnopek","html_url":"https://github.com/dsnopek","followers_url":"https://api.github.com/users/dsnopek/followers","following_url":"https://api.github.com/users/dsnopek/following{/other_user}","gists_url":"https://api.github.com/users/dsnopek/gists{/gist_id}","starred_url":"https://api.github.com/users/dsnopek/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/dsnopek/subscriptions","organizations_url":"https://api.github.com/users/dsnopek/orgs","repos_url":"https://api.github.com/users/dsnopek/repos","events_url":"https://api.github.com/users/dsnopek/events{/privacy}","received_events_url":"https://api.github.com/users/dsnopek/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"> For example, would calling `location_manager.hasProvider(\"gps\")` trigger the same error if `location_manager` is actually null?\r\n\r\nOh! No, it won't. In that case `location_manager` would be `Variant::NIL` and you'd get the error:\r\n\r\n```\r\nInvalid call. Nonexistant function 'hasProvider' in base 'Nil'.\r\n```\r\n\r\nThe error added by this PR wouldn't trigger.\r\n\r\nI'm like 99% sure that the error added in this PR can only happen if you're trying to call a non-static method on a class. You _can_ end up with a `JavaObject` that holds a null instance, but it would also have a null class, and so you'd never end up in `JavaClass::_call_method()`.","created_at":"2025-02-07T17:13:42Z","updated_at":"2025-02-07T17:13:42Z","html_url":"https://github.com/godotengine/godot/pull/102494#discussion_r1946885085","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/102494","_links":{"self":{"href":"https://api.github.com/repos/godotengine/godot/pulls/comments/1946885085"},"html":{"href":"https://github.com/godotengine/godot/pull/102494#discussion_r1946885085"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/102494"}},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/1946885085/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":159,"original_line":159,"side":"RIGHT","in_reply_to_id":1946167620,"author_association":"CONTRIBUTOR","original_position":4,"position":4,"subject_type":"line"}]