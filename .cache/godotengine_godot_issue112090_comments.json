s://api.github.com/users/Veradictus/following{/other_user}","gists_url":"https://api.github.com/users/Veradictus/gists{/gist_id}","starred_url":"https://api.github.com/users/Veradictus/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Veradictus/subscriptions","organizations_url":"https://api.github.com/users/Veradictus/orgs","repos_url":"https://api.github.com/users/Veradictus/repos","events_url":"https://api.github.com/users/Veradictus/events{/privacy}","received_events_url":"https://api.github.com/users/Veradictus/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-10-29T18:44:30Z","updated_at":"2025-10-29T18:44:30Z","body":"Version 16.4 has the same behaviour.","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3463218688/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3463270202","html_url":"https://github.com/godotengine/godot/issues/112090#issuecomment-3463270202","issue_url":"https://api.github.com/repos/godotengine/godot/issues/112090","id":3463270202,"node_id":"IC_kwDOAO6SJc7ObU86","user":{"login":"bruvzg","id":7645683,"node_id":"MDQ6VXNlcjc2NDU2ODM=","avatar_url":"https://avatars.githubusercontent.com/u/7645683?v=4","gravatar_id":"","url":"https://api.github.com/users/bruvzg","html_url":"https://github.com/bruvzg","followers_url":"https://api.github.com/users/bruvzg/followers","following_url":"https://api.github.com/users/bruvzg/following{/other_user}","gists_url":"https://api.github.com/users/bruvzg/gists{/gist_id}","starred_url":"https://api.github.com/users/bruvzg/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/bruvzg/subscriptions","organizations_url":"https://api.github.com/users/bruvzg/orgs","repos_url":"https://api.github.com/users/bruvzg/repos","events_url":"https://api.github.com/users/bruvzg/events{/privacy}","received_events_url":"https://api.github.com/users/bruvzg/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-10-29T18:51:55Z","updated_at":"2025-10-29T18:51:55Z","body":"Xcode 16.x should work fine (was working with current master few days ago), make sure you are actually using Xcode and not outdated command line tools, this is a common issue:\n\n- Run `xcode-select -p` in terminal, if it's outputting anything other than `/Applications/Xcode.app/Contents/Developer` you are not using current Xcode, even if it's installed.\n- If it is the case, run `sudo xcode-select -s /Applications/Xcode.app/Contents/Developer` to switch to current Xcode.","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3463270202/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3466077817","html_url":"https://github.com/godotengine/godot/issues/112090#issuecomment-3466077817","issue_url":"https://api.github.com/repos/godotengine/godot/issues/112090","id":3466077817,"node_id":"IC_kwDOAO6SJc7OmCZ5","user":{"login":"high726","id":18411413,"node_id":"MDQ6VXNlcjE4NDExNDEz","avatar_url":"https://avatars.githubusercontent.com/u/18411413?v=4","gravatar_id":"","url":"https://api.github.com/users/high726","html_url":"https://github.com/high726","followers_url":"https://api.github.com/users/high726/followers","following_url":"https://api.github.com/users/high726/following{/other_user}","gists_url":"https://api.github.com/users/high726/gists{/gist_id}","starred_url":"https://api.github.com/users/high726/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/high726/subscriptions","organizations_