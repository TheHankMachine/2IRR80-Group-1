engine/godot/issues/comments/4170001176/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4189954067","html_url":"https://github.com/godotengine/godot/pull/117966#issuecomment-4189954067","issue_url":"https://api.github.com/repos/godotengine/godot/issues/117966","id":4189954067,"node_id":"IC_kwDOAO6SJc75vaAT","user":{"login":"Lidang-Jiang","id":119769478,"node_id":"U_kgDOByOJhg","avatar_url":"https://avatars.githubusercontent.com/u/119769478?v=4","gravatar_id":"","url":"https://api.github.com/users/Lidang-Jiang","html_url":"https://github.com/Lidang-Jiang","followers_url":"https://api.github.com/users/Lidang-Jiang/followers","following_url":"https://api.github.com/users/Lidang-Jiang/following{/other_user}","gists_url":"https://api.github.com/users/Lidang-Jiang/gists{/gist_id}","starred_url":"https://api.github.com/users/Lidang-Jiang/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Lidang-Jiang/subscriptions","organizations_url":"https://api.github.com/users/Lidang-Jiang/orgs","repos_url":"https://api.github.com/users/Lidang-Jiang/repos","events_url":"https://api.github.com/users/Lidang-Jiang/events{/privacy}","received_events_url":"https://api.github.com/users/Lidang-Jiang/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-04-06T01:46:57Z","updated_at":"2026-04-06T01:46:57Z","body":"Thanks for the detailed review, @dalexeev. You're right — changing the signature display format is the wrong approach. The correct fix should address the annotation bindings (the `names` parameter name is incorrect) and potentially add rest parameter support via `MethodInfo`/`DocData`.\n\nI also missed the `EditorHelp` and `makerst.py` cases you pointed out. Since this needs a fundamentally different approach and touches areas you have much more