[{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2762077586","html_url":"https://github.com/godotengine/godot/pull/102101#issuecomment-2762077586","issue_url":"https://api.github.com/repos/godotengine/godot/issues/102101","id":2762077586,"node_id":"IC_kwDOAO6SJc6kofWS","user":{"login":"kitbdev","id":10054226,"node_id":"MDQ6VXNlcjEwMDU0MjI2","avatar_url":"https://avatars.githubusercontent.com/u/10054226?v=4","gravatar_id":"","url":"https://api.github.com/users/kitbdev","html_url":"https://github.com/kitbdev","followers_url":"https://api.github.com/users/kitbdev/followers","following_url":"https://api.github.com/users/kitbdev/following{/other_user}","gists_url":"https://api.github.com/users/kitbdev/gists{/gist_id}","starred_url":"https://api.github.com/users/kitbdev/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/kitbdev/subscriptions","organizations_url":"https://api.github.com/users/kitbdev/orgs","repos_url":"https://api.github.com/users/kitbdev/repos","events_url":"https://api.github.com/users/kitbdev/events{/privacy}","received_events_url":"https://api.github.com/users/kitbdev/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-03-28T18:03:37Z","updated_at":"2025-03-28T18:05:02Z","body":"Wouldn't this break code that relies on these strings?\r\n`EditorData::get_editor_by_name` and `EditorMainScreen::select_by_name` rely on the plugin name being the same and untranslated.\r\nMaybe these plugins can have a separate \"title\" that is translated and keep the name untranslated, something similar is done for docks.","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2762077586/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2762169544","