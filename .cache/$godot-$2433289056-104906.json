[{"id":2736584457,"node_id":"PRR_kwDOAO6SJc6jHPcJ","state":"APPROVED","user":{"site_admin":false,"suspended":false,"updated_at":"0001-01-01T00:00:00Z","avatar_url":"https://avatars.githubusercontent.com/u/191561?v=4","created_at":"0001-01-01T00:00:00Z","followers":0,"following":0,"html_url":"https://github.com/dsnopek","id":191561,"node_id":"MDQ6VXNlcjE5MTU2MQ==","login":"dsnopek","type":"User","owned_private_repos":0,"public_gists":0,"public_repos":0,"total_private_repos":0,"url":"https://api.github.com/users/dsnopek"},"body":"Ack, I forgot that we used `ClassDB::instantiate()` for creating editor plugins from GDExtension\r\n\r\nThis change makes sense! Hopefully, we don't have too many of these situations, but this allows us to account for situations were we want to allow Godot to create internal classes from GDExtension (for which we _have to_ use `ClassDB`), but not allow anything external (like GDScript or other GDExtensions) to do the same\r\n\r\nI haven't tested, but the code looks correct to me!","html_url":"https://github.com/godotengine/godot/pull/104906#pullrequestreview-2736584457","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/104906","author_association":"CONTRIBUTOR","submitted_at":"2025-04-02T14:54:44Z"},{"id":2735486743,"node_id":"PRR_kwDOAO6SJc6jDDcX","state":"COMMENTED","user":{"site_admin":false,"suspended":false,"updated_at":"0001-01-01T00:00:00Z","avatar_url":"https://avatars.githubusercontent.com/u/96648715?u=af70f5d107e9c1447f296643d5a566dab53d25e8&v=4","created_at":"0001-01-01T00:00:00Z","followers":0,"following":0,"html_url":"https://github.com/AThousandShips","id":96648715,"node_id":"U_kgDOBcK-Cw","login":"AThousandShips","type":"User","owned_private_repos":0,"public_gists":0,"public_repos":0,"total_private_repos":0,"url":"https://api.github.com/users/AThousandShips"},"body":"","html_url":"https://github.com/godotengine/godot/pull/104906#pullrequestreview-2735486743","pull_request_url":"https://api.github.com/repo