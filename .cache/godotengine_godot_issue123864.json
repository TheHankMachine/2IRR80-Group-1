16:48Z","due_on":null,"closed_at":null},"comments":0,"created_at":"2026-09-26T16:23:48Z","updated_at":"2026-09-26T16:25:02Z","closed_at":null,"assignee":null,"author_association":"MEMBER","issue_field_values":[],"type":null,"active_lock_reason":null,"draft":false,"pull_request":{"url":"https://api.github.com/repos/godotengine/godot/pulls/123864","html_url":"https://github.com/godotengine/godot/pull/123864","diff_url":"https://github.com/godotengine/godot/pull/123864.diff","patch_url":"https://github.com/godotengine/godot/pull/123864.patch","merged_at":null},"body":"The new default of `0.0` only affects the editor preview environment, so that existing Environment resources are not affected. Only Environment resources newly created from the editor preview will receive this default setting change.\r\n\r\nNote that there is no built-in toggle to enable SSR in the preview Environment (without adding it to the scene), but this could be added in a separate PR similar to https://github.com/godotengine/godot/pull/84849.\r\n\r\nIf we want to change the default value in Environment instead, I have a separate branch for this: https://github.com/Calinou/godot/tree/ssr-tweak-fade-in-default\r\n\r\n**Testing project:** [test_ssr_fade_in.zip](https://github.com/user-attachments/files/32685941/test_ssr_fade_in.zip)\r\n\r\n## Preview\r\n\r\n*The floor is a perfectly reflective surface with Roughness = 0.0 and Metallic = 1.0. Focus on the area between the reflected objects and the reflective floor.*\r\n\r\n### `master`\r\n\r\n[ssr_fade_in_master.webm](https://github.com/user-attachments/assets/98dc0b28-7e4b-4023-9f20-bb877837f703)\r\n\r\n### This PR\r\n\r\n[ssr_fade_in_pr.webm](https://github.com/user-attachments/assets/38d588f2-8c12-4ad7-8aad-8ad3bcdf7ff9)","closed_by":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/123864/reactions","total_count":5,"+1":5,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://ap