[{"id":4492741606,"node_id":"PRR_kwDOAO6SJc8AAAABC8nL5g","user":{"login":"KolYev","id":115659614,"node_id":"U_kgDOBuTTXg","avatar_url":"https://avatars.githubusercontent.com/u/115659614?u=814b2fac17e92630bd13d160a49008c7e4cc43fa&v=4","gravatar_id":"","url":"https://api.github.com/users/KolYev","html_url":"https://github.com/KolYev","followers_url":"https://api.github.com/users/KolYev/followers","following_url":"https://api.github.com/users/KolYev/following{/other_user}","gists_url":"https://api.github.com/users/KolYev/gists{/gist_id}","starred_url":"https://api.github.com/users/KolYev/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/KolYev/subscriptions","organizations_url":"https://api.github.com/users/KolYev/orgs","repos_url":"https://api.github.com/users/KolYev/repos","events_url":"https://api.github.com/users/KolYev/events{/privacy}","received_events_url":"https://api.github.com/users/KolYev/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"I found the real root cause. The issue was in `_update_slots_size()` — \n`theme_cache.font_offset` was missing from the `name_size` calculation. \nThis value is subtracted from `text_limit` during label rendering in \n`NOTIFICATION_SORT_CHILDREN`, so without it the available width for \ntwo-digit labels was too narrow.","state":"COMMENTED","html_url":"https://github.com/godotengine/godot/pull/120264#pullrequestreview-4492741606","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/120264","author_association":"NONE","_links":{"html":{"href":"https://github.com/godotengine/godot/pull/120264#pullrequestreview-4492741606"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/120264"}},"submitted_at":"2026-06-14T09:51:35Z","commit_id":"3ab39d33e96ffb655813d1634972d615a456c90e"}]