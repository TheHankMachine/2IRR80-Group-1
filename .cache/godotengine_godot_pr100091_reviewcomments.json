,"created_at":"2025-01-07T21:32:02Z","updated_at":"2025-01-07T21:32:02Z","html_url":"https://github.com/godotengine/godot/pull/100091#discussion_r1906065472","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/100091","_links":{"self":{"href":"https://api.github.com/repos/godotengine/godot/pulls/comments/1906065472"},"html":{"href":"https://github.com/godotengine/godot/pull/100091#discussion_r1906065472"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/100091"}},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/1906065472/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":null,"original_line":4328,"side":"RIGHT","in_reply_to_id":1906040834,"author_association":"MEMBER","original_position":5,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/1906070008","pull_request_review_id":2535418291,"id":1906070008,"node_id":"PRRC_kwDOAO6SJc5xnFH4","diff_hunk":"@@ -4325,7 +4325,7 @@ bool EditorNode::is_additional_node_in_scene(Node *p_edited_scene, Node *p_reimp\n }\n \n void EditorNode::get_scene_editor_data_for_node(Node *p_root, Node *p_node, HashMap<NodePath, SceneEditorDataEntry> &p_table) {\n-\tSceneEditorDataEntry new_entry;\n+\tSceneEditorDataEntry new_entry{};","path":"editor/editor_node.cpp","commit_id":"96e59b99baa53021058663e3c764ba98f2bb8965","original_commit_id":"a8c3efc9bfbc81e8ee3088ac849c8e4cedce1e10","user":{"login":"KoBeWi","id":2223172,"node_id":"MDQ6VXNlcjIyMjMxNzI=","avatar_url":"https://avatars.githubusercontent.com/u/2223172?v=4","gravatar_id":"","url":"https://api.github.com/users/KoBeWi","html_url":"https://github.com/KoBeWi","followers_url":"https://api.github.com/users/KoBeWi/followers","following_url":"https://api.github.com/users/KoBeWi/following{/other_user}","gists_url":"https://api.github