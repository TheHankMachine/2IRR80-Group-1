t.com/u/61938263?v=4","gravatar_id":"","url":"https://api.github.com/users/TokageItLab","html_url":"https://github.com/TokageItLab","followers_url":"https://api.github.com/users/TokageItLab/followers","following_url":"https://api.github.com/users/TokageItLab/following{/other_user}","gists_url":"https://api.github.com/users/TokageItLab/gists{/gist_id}","starred_url":"https://api.github.com/users/TokageItLab/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/TokageItLab/subscriptions","organizations_url":"https://api.github.com/users/TokageItLab/orgs","repos_url":"https://api.github.com/users/TokageItLab/repos","events_url":"https://api.github.com/users/TokageItLab/events{/privacy}","received_events_url":"https://api.github.com/users/TokageItLab/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-01-19T23:02:01Z","updated_at":"2025-01-19T23:02:01Z","body":"Adopted abs with comments on the second comparison.","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2601057161/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2601760846","html_url":"https://github.com/godotengine/godot/pull/101797#issuecomment-2601760846","issue_url":"https://api.github.com/repos/godotengine/godot/issues/101797","id":2601760846,"node_id":"IC_kwDOAO6SJc6bE7hO","user":{"login":"lawnjelly","id":21999379,"node_id":"MDQ6VXNlcjIxOTk5Mzc5","avatar_url":"https://avatars.githubusercontent.com/u/21999379?v=4","gravatar_id":"","url":"https://api.github.com/users/lawnjelly","html_url":"https://github.com/lawnjelly","followers_url":"https://api.github.com/users/lawnjelly/followers","following_url":"https://api.github.com/users/lawnjelly/following{/other_user}","gists_url":"https://api.github.com/users/lawnjelly/gists{/gist_id}","starred_url":"https://api.github.com/users/lawnjelly/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/lawnjelly/subscriptions","organizations_url":"https://api.github.com/users/lawnjelly/orgs","repos_url":"https://api.github.com/users/lawnjelly/repos","events_url":"https://api.github.com/users/lawnjelly/events{/privacy}","received_events_url":"https://api.github.com/users/lawnjelly/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-01-20T08:40:26Z","updated_at":"2025-01-20T08:52:37Z","body":"It was fine before, but the pattern I was suggesting is more:\r\n```\r\nreal_t d = n0.dot(n1);\r\n\r\nif (Math::abs(d) > ALMOST_ONE) {\r\n\tif (d >= 0) {\r\n\t\treturn;\r\n\t}\r\n\t\r\n\tVector3 axis = n0.get_any_perpendicular();\r\n\tx = axis.x;\r\n\ty = axis.y;\r\n\tz = axis.z;\r\n\tw = 0;\r\n}\r\nelse\r\n{\r\n\tVector3 c = n0.cross(n1);\r\n\treal_t s = Math::sqrt((1.0f + d) * 2.0f);\r\n\treal_t rs = 1.0f / s;\r\n\r\n\tx = c.x * rs;\r\n\ty = c.y * rs;\r\n\tz = c.z * rs;\r\n\tw = s * 0.5f;\r\n}\r\n```\r\nThis is thus using ABS and a single branch for most cases, instead of two branches.\r\n\r\nBut this isn't really hugely important unless you've profiled the two in bottlenecks (the original could be faster for instance), and the math checks will likely dwarf this. Going to this level to make sensible decisions you would need to be looking at assembly and benchmarks, and I don't think this is warranted at this stage, so either the previous implementation you did (where we approved) or the above would be fine, there will likely be a hair's breadth between them.\r\n\r\n_The optimizer may well do this from your current PR anyway, but in the current commit it is less clear what you are asking the compiler to do._","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2601760846/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2602819160","html_url":"https://github.com/godotengine/godot/pull/101797#issuecomment-2602819160","issue_url":"https://api.github.com/repos/godotengine/godot/issues/101797","id":2602819160,"node_id":"IC_kwDOAO6SJc6bI95Y","user":{"login":"Repiteo","id":17489292,"node_id":"MDQ6VXNlcjE3NDg5Mjky","avatar_url":"https://avatars.githubusercontent.com/u/17489292?v=4","gravatar_id":"","url":"https://api.github.com/users/Repiteo","html_url":"https://github.com/Repiteo","followers_url":"https://api.github.com/users/Repiteo/followers","following_url":"https://api.github.com/users/Repiteo/following{/other_user}","gists_url":"https://api.github.com/users/Repiteo/gists{/gist_id}","starred_url":"https://api.github.com/users/Repiteo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Repiteo/subscriptions","organizations_url":"https://api.github.com/users/Repiteo/orgs","repos_url":"https://api.github.com/users/Repiteo/repos","events_url":"https://api.github.com/users/Repiteo/events{/privacy}","received_events_url":"https://api.github.com/users/Repiteo/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-01-20T16:17:08Z","updated_at":"2025-01-20T16:17:08Z","body":"Thanks!","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2602819160/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null}]