[{"id":4060999412,"node_id":"PRR_kwDOAO6SJc7yDe70","user":{"login":"AThousandShips","id":96648715,"node_id":"U_kgDOBcK-Cw","avatar_url":"https://avatars.githubusercontent.com/u/96648715?u=af70f5d107e9c1447f296643d5a566dab53d25e8&v=4","gravatar_id":"","url":"https://api.github.com/users/AThousandShips","html_url":"https://github.com/AThousandShips","followers_url":"https://api.github.com/users/AThousandShips/followers","following_url":"https://api.github.com/users/AThousandShips/following{/other_user}","gists_url":"https://api.github.com/users/AThousandShips/gists{/gist_id}","starred_url":"https://api.github.com/users/AThousandShips/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/AThousandShips/subscriptions","organizations_url":"https://api.github.com/users/AThousandShips/orgs","repos_url":"https://api.github.com/users/AThousandShips/repos","events_url":"https://api.github.com/users/AThousandShips/events{/privacy}","received_events_url":"https://api.github.com/users/AThousandShips/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"","state":"COMMENTED","html_url":"https://github.com/godotengine/godot/pull/118226#pullrequestreview-4060999412","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/118226","author_association":"MEMBER","_links":{"html":{"href":"https://github.com/godotengine/godot/pull/118226#pullrequestreview-4060999412"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/118226"}},"submitted_at":"2026-04-13T09:10:09Z","commit_id":"1a225e4c016682db70f4a04e40ba2222a6f9aacc"},{"id":4556530192,"node_id":"PRR_kwDOAO6SJc8AAAABD5ciEA","user":{"login":"Calinou","id":180032,"node_id":"MDQ6VXNlcjE4MDAzMg==","avatar_url":"https://avatars.githubusercontent.com/u/180032?u=68d23e7ee9cdf810da125e8510b72f845b9dccc8&v=4","gravatar_id":"","url":"https://api.github.com/users/Calinou","html_url":"https://github.com/Calinou","followers_url":"https://api.github.com/users/Calinou/followers","following_url":"https://api.github.com/users/Calinou/following{/other_user}","gists_url":"https://api.github.com/users/Calinou/gists{/gist_id}","starred_url":"https://api.github.com/users/Calinou/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Calinou/subscriptions","organizations_url":"https://api.github.com/users/Calinou/orgs","repos_url":"https://api.github.com/users/Calinou/repos","events_url":"https://api.github.com/users/Calinou/events{/privacy}","received_events_url":"https://api.github.com/users/Calinou/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"Tested locally, it works as expected. Code looks good to me.\r\n\r\n**Testing project:** [test_pr_118226.zip](https://github.com/user-attachments/files/29264030/test_pr_118226.zip)\r\nThis is a project that downloads Godot export templates in a resumable fashion. Quit and reopen the project to resume.\r\n\r\n(If testing with other files, make sure the host supports range requests.)\r\n\r\nSome feedback:\r\n\r\n- If you get HTTP response code 416 ([Range Not Satisfiable](https://developer.mozilla.org/en-US/docs/Web/HTTP/Reference/Status/416)), the full file is downloaded again and the original is removed. This means that if you've completed a download and try to start it, the original file is gone. Not sure if we can resolve this without side-effects.\r\n  - This can be addressed at the project level by renaming in-download files (similar to `.part` files in Firefox or `.crdownload` in Chromium), so that fully downloaded files can be distinguished from files that are still being downloaded. This way, you know you don't need to perform another request when the file is done downloading.\r\n\r\nFor future PRs:\r\n\r\n- There should be a code sample in `HTTPRequest.append_to_download_file`'s description that shows how to make use of range requests to resume a file download. The testing project I linked is a good start, but it should be modified to use [`If-Range`](https://developer.mozilla.org/en-US/docs/Web/HTTP/Guides/Range_requests#conditional_range_requests) to ensure we don't append to an outdated file.\r\n- Thinking about it, we could perhaps have a full-blown demo project showcasing HTTPRequest usage. There are several features that can be demonstrated:\r\n  - Resuming file downloads.\r\n  - Parallel downloads (multiple range requests on different parts of the file; faster than using a single HTTP connection, makes better use of fiber/5G connections).\r\n  - Server-sent events.","state":"APPROVED","html_url":"https://github.com/godotengine/godot/pull/118226#pullrequestreview-4556530192","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/118226","author_association":"MEMBER","_links":{"html":{"href":"https://github.com/godotengine/godot/pull/118226#pullrequestreview-4556530192"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/118226"}},"submitted_at":"2026-06-23T19:37:05Z","commit_id":"c62ee64f451341b9649686adefb352c20c2180a0"},{"id":4556667785,"node_id":"PRR_kwDOAO6SJc8AAAABD5k7iQ","user":{"login":"KoBeWi","id":2223172,"node_id":"MDQ6VXNlcjIyMjMxNzI=","avatar_url":"https://avatars.githubusercontent.com/u/2223172?u=fc85633b469acb6e7baef4dba5171f19a2a4ff85&v=4","gravatar_id":"","url":"https://api.github.com/users/KoBeWi","html_url":"https://github.com/KoBeWi","followers_url":"https://api.github.com/users/KoBeWi/followers","following_url":"https://api.github.com/users/KoBeWi/following{/other_user}","gists_url":"https://api.github.com/users/KoBeWi/gists{/gist_id}","starred_url":"https://api.github.com/users/KoBeWi/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/KoBeWi/subscriptions","organizations_url":"https://api.github.com/users/KoBeWi/orgs","repos_url":"https://api.github.com/users/KoBeWi/repos","events_url":"https://api.github.com/users/KoBeWi/events{/privacy}","received_events_url":"https://api.github.com/user