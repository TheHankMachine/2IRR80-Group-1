nsive types it won't be!","html_url":"https://github.com/godotengine/godot/pull/100477#pullrequestreview-2508896144","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/100477","author_association":"MEMBER","submitted_at":"2024-12-17T13:32:55Z"},{"id":2509436594,"node_id":"PRR_kwDOAO6SJc6Vkvay","state":"APPROVED","commit_id":"a636c04244669b62abce3e9094b3420ba6c3cdb3","user":{"site_admin":false,"suspended":false,"updated_at":"0001-01-01T00:00:00Z","avatar_url":"https://avatars.githubusercontent.com/u/96648715?u=af70f5d107e9c1447f296643d5a566dab53d25e8&v=4","created_at":"0001-01-01T00:00:00Z","followers":0,"following":0,"html_url":"https://github.com/AThousandShips","id":96648715,"node_id":"U_kgDOBcK-Cw","login":"AThousandShips","type":"User","owned_private_repos":0,"public_gists":0,"public_repos":0,"total_private_repos":0,"url":"https://api.github.com/users/AThousandShips"},"body":"LGTM","html_url":"https://github.com/godotengine/godot/pull/100477#pullrequestreview-2509436594","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/100477","author_association":"MEMBER","submitted_at":"2024-12-17T16:32:32Z"}]