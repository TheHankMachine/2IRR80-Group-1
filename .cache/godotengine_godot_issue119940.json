ived_by":null},{"id":2304948121,"node_id":"MDU6TGFiZWwyMzA0OTQ4MTIx","url":"https://api.github.com/repos/godotengine/godot/labels/topic:codestyle","name":"topic:codestyle","color":"ffee88","default":false,"description":"","archived_at":null,"archived_by":null}],"state":"closed","locked":false,"assignees":[],"milestone":{"url":"https://api.github.com/repos/godotengine/godot/milestones/25","html_url":"https://github.com/godotengine/godot/milestone/25","labels_url":"https://api.github.com/repos/godotengine/godot/milestones/25/labels","id":15520464,"node_id":"MI_kwDOAO6SJc4A7NLQ","number":25,"title":"4.8","description":"","creator":{"login":"Repiteo","id":17489292,"node_id":"MDQ6VXNlcjE3NDg5Mjky","avatar_url":"https://avatars.githubusercontent.com/u/17489292?v=4","gravatar_id":"","url":"https://api.github.com/users/Repiteo","html_url":"https://github.com/Repiteo","followers_url":"https://api.github.com/users/Repiteo/followers","following_url":"https://api.github.com/users/Repiteo/following{/other_user}","gists_url":"https://api.github.com/users/Repiteo/gists{/gist_id}","starred_url":"https://api.github.com/users/Repiteo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Repiteo/subscriptions","organizations_url":"https://api.github.com/users/Repiteo/orgs","repos_url":"https://api.github.com/users/Repiteo/repos","events_url":"https://api.github.com/users/Repiteo/events{/privacy}","received_events_url":"https://api.github.com/users/Repiteo/received_events","type":"User","user_view_type":"public","site_admin":false},"open_issues":343,"closed_issues":2335,"state":"open","created_at":"2026-04-13T15:59:35Z","updated_at":"2026-10-22T06:28:22Z","due_on":null,"closed_at":null},"comments":1,"created_at":"2026-06-01T12:10:00Z","updated_at":"2026-06-24T20:18:47Z","closed_at":"2026-06-24T19:56:48Z","assignee":null,"author_association":"CONTRIBUTOR","issue_field_values":[],"type":null,"active_lock_reason":null,"draft":false,"pull_request":{"url":"https://api.github.com/repos/godotengine/godot/pulls/119940","html_url":"https://github.com/godotengine/godot/pull/119940","diff_url":"https://github.com/godotengine/godot/pull/119940.diff","patch_url":"https://github.com/godotengine/godot/pull/119940.patch","merged_at":"2026-06-24T19:56:48Z"},"body":"## What problem(s) does this PR solve?\r\n\r\nThe `GDCLASS` macro adds a class to `ClassDB` (even without using `GDREGISTER_CLASS`, this behavior likely arose with the introduction of `GDType`). The following classes are internal, well-isolated, and do not interact with `ClassDB` in any way (they do not define `_bind_methods()`):\r\n\r\n* `GDScriptEditorTranslationParserPlugin`;\r\n* `GDScriptLanguageServer`;\r\n* `GDScriptExportPlugin` (former `EditorExportGDScript`).\r\n\r\nSo, it is safe to use `GDSOFTCLASS` instead of `GDCLASS` for them. The risk is minimal, the only side effect I know of is that these classes will disappear from `ClassDB.get_class_list()`.\r\n\r\nThis PR also renames the `EditorExportGDScript` class to `GDScriptExportPlugin` for consistency with other classes in the module (most use the `GDScript` prefix rather than the suffix) and other `EditorExportPlugin` descendants:\r\n\r\n```c++\r\nclass DedicatedServerExportPlugin : public EditorExportPlugin\r\nclass GDExtensionExportPlugin : public EditorExportPlugin\r\nclass ShaderBakerExportPlugin : public EditorExportPlugin\r\nclass OpenXRExportPlugin : public EditorExportPlugin\r\n```\r\n\r\n## Additional information\r\n\r\n_None._\r\n","closed_by":{"login":"Repiteo","id":17489292,"node_id":"MDQ6VXNlcjE3NDg5Mjky","avatar_url":"https://avatars.githubusercontent.com/u/17489292?v=4","gravatar_id":"","url":"https://api.github.com/users/Repiteo","html_url":"https://github.com/Repiteo","followers_url":"https://api.github.com/users/Repiteo/followers","following_url":"https://api.github.com/users/Repiteo/following{/other_user}","gists_url":"https://api.github.com/users/Repiteo/gists{/gist_id}","starred_url":"https://api.github.com/users/Repiteo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Repiteo/subscriptions","organizations_url":"https://api.github.com/users/Repiteo/orgs","repos_url":"https://api.github.com/users/Repiteo/repos","events_url":"https://api.github.com/users/Repiteo/events{/privacy}","received_events_url":"https://api.github.com/users/Repiteo/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/119940/reactions","total_count":7,"+1":7,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/godotengine/godot/issues/119940/timeline","performed_via_github_app":null,"state_reason":null}