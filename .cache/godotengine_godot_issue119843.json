d_by":null},{"id":1332303119,"node_id":"MDU6TGFiZWwxMzMyMzAzMTE5","url":"https://api.github.com/repos/godotengine/godot/labels/regression","name":"regression","color":"ff63ac","default":false,"description":"","archived_at":null,"archived_by":null},{"id":2666708059,"node_id":"MDU6TGFiZWwyNjY2NzA4MDU5","url":"https://api.github.com/repos/godotengine/godot/labels/topic:2d","name":"topic:2d","color":"ffee88","default":false,"description":"","archived_at":null,"archived_by":null}],"state":"closed","locked":false,"assignees":[],"milestone":{"url":"https://api.github.com/repos/godotengine/godot/milestones/24","html_url":"https://github.com/godotengine/godot/milestone/24","labels_url":"https://api.github.com/repos/godotengine/godot/milestones/24/labels","id":14236899,"node_id":"MI_kwDOAO6SJc4A2Tzj","number":24,"title":"4.7","description":"","creator":{"login":"akien-mga","id":4701338,"node_id":"MDQ6VXNlcjQ3MDEzMzg=","avatar_url":"https://avatars.githubusercontent.com/u/4701338?v=4","gravatar_id":"","url":"https://api.github.com/users/akien-mga","html_url":"https://github.com/akien-mga","followers_url":"https://api.github.com/users/akien-mga/followers","following_url":"https://api.github.com/users/akien-mga/following{/other_user}","gists_url":"https://api.github.com/users/akien-mga/gists{/gist_id}","starred_url":"https://api.github.com/users/akien-mga/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/akien-mga/subscriptions","organizations_url":"https://api.github.com/users/akien-mga/orgs","repos_url":"https://api.github.com/users/akien-mga/repos","events_url":"https://api.github.com/users/akien-mga/events{/privacy}","received_events_url":"https://api.github.com/users/akien-mga/received_events","type":"User","user_view_type":"public","site_admin":false},"open_issues":3,"closed_issues":2535,"state":"closed","created_at":"2025-11-27T20:29:18Z","updated_at":"2026-10-20T18:39:31Z","due_on":null,"closed_at":"2026-06-19T16:54:35Z"},"comments":2,"created_at":"2026-05-28T09:47:14Z","updated_at":"2026-06-01T16:17:40Z","closed_at":"2026-06-01T16:17:40Z","assignee":null,"author_association":"NONE","issue_field_values":[],"type":null,"active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"### Tested versions\n\nReproducible in: v4.7.beta3.official [860821708]\nNot reproducible in: v4.6.3.stable.official [7d41c59c4]\n\n### System information\n\nGodot v4.7.beta3 - Windows 11 (build 26100) - Multi-window, 1 monitor - OpenGL 3 (Compatibility) - GeForce GTX 550 Ti - Intel(R) Core(TM) i3-2100 CPU @ 3.10GHz (4 threads) - 11.95 GiB memory - WASAPI (48000 Hz, Stereo/mono)\n\n### Issue description\n\nA polygon2d hides unexpectedly, when its initial shape is panned or zoomed outside Godot's main viewport. After the polygon has been moved in the polygon editor.\n\nhttps://github.com/user-attachments/assets/9a8150b1-7ab1-44cb-82be-8287295f03a4\n\nWorkaround:\nClosing and reopening the scene fixes it, until the polygon is moved again in the polygon editor.\n\n### Steps to reproduce\n\nReproduction steps:\n- open project: [polygon-2d-hides-when-original-shape-is-outside-main-viewport.zip](https://github.com/user-attachments/files/28342025/polygon-2d-hides-when-original-shape-is-outside-main-viewport.zip)\n- the scene panel contains:\n```\nNode2D\n  Polygon2D\n  Polygon2D2\n```\nNote: The issue occurs with only one polygon. The second polygon just makes it easy to see the polygon's original position.\n- select the second child node: Polygon2D2\n- in the bottom polygon editor's top bar, select the move polygon tool\n- in the polygon editor, drag the polygon to the right \n- in Godot's main viewport, pan the viewport, by middle mouse button dragging to the left until the left polygon is outside the viewport\n\nIssue:\nThe right polygon disappears when the left polygon (right polygon's original position) is outside the main viewport.\nThe right polygon appears when the viewport is panned to the right and the left polygon appears again.\n\nhttps://github.com/user-attachments/assets/9a8150b1-7ab1-44cb-82be-8287295f03a4\n\nExpected:\nThe right polygon should use its new position to check if it's outside the main viewport. Like it does in: v4.6.3.stable.official [7d41c59c4]\n\nhttps://github.com/user-attachments/assets/a45c9d00-9eda-495d-8711-c9f7cf4ffb19\n\n### Minimal reproduction project (MRP)\n\n[polygon-2d-hides-when-original-shape-is-outside-main-viewport.zip](https://github.com/user-attachments/files/28342025/polygon-2d-hides-when-original-shape-is-outside-main-viewport.zip)","closed_by":{"login":"Repiteo","id":17489292,"node_id":"MDQ6VXNlcjE3NDg5Mjky","avatar_url":"https://avatars.githubusercontent.com/u/17489292?v=4","gravatar_id":"","url":"https://api.github.com/users/Repiteo","html_url":"https://github.com/Repiteo","followers_url":"https://api.github.com/users/Repiteo/followers","following_url":"https://api.github.com/users/Repiteo/following{/other_user}","gists_url":"https://api.github.com/users/Repiteo/gists{/gist_id}","starred_url":"https://api.github.com/users/Repiteo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Repiteo/subscriptions","organizations_url":"https://api.github.com/users/Repiteo/orgs","repos_url":"https://api.github.com/users/Repiteo/repos","events_url":"https://api.github.com/users/Repiteo/events{/privacy}","received_events_url":"https://api.github.com/users/Repiteo/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/119843/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/godotengine/godot/issues/119843/timeline","performed_via_github_app":null,"state_reason":"completed","pinned_comment":null}