[{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3053209715","html_url":"https://github.com/godotengine/godot/issues/108444#issuecomment-3053209715","issue_url":"https://api.github.com/repos/godotengine/godot/issues/108444","id":3053209715,"node_id":"IC_kwDOAO6SJc61_Ehz","user":{"login":"Calinou","id":180032,"node_id":"MDQ6VXNlcjE4MDAzMg==","avatar_url":"https://avatars.githubusercontent.com/u/180032?v=4","gravatar_id":"","url":"https://api.github.com/users/Calinou","html_url":"https://github.com/Calinou","followers_url":"https://api.github.com/users/Calinou/followers","following_url":"https://api.github.com/users/Calinou/following{/other_user}","gists_url":"https://api.github.com/users/Calinou/gists{/gist_id}","starred_url":"https://api.github.com/users/Calinou/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Calinou/subscriptions","organizations_url":"https://api.github.com/users/Calinou/orgs","repos_url":"https://api.github.com/users/Calinou/repos","events_url":"https://api.github.com/users/Calinou/events{/privacy}","received_events_url":"https://api.github.com/users/Calinou/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-07-09T16:04:50Z","updated_at":"2025-07-09T16:05:50Z","body":"I don't think this is a bug. Only diffuse baking is baked in lightmaps, but `roughness = 0, metallic = 1` materials *only* receive specular light. You need to provide some kind of specular light source such as a ReflectionProbe, VoxelGI or SDFGI for reflections to look correct. These can all be used in tandem with LightmapGI (lightmaps take priority for static object diffuse GI).","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3053209715/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.githu