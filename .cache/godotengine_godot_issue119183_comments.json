yjohn/followers","following_url":"https://api.github.com/users/clayjohn/following{/other_user}","gists_url":"https://api.github.com/users/clayjohn/gists{/gist_id}","starred_url":"https://api.github.com/users/clayjohn/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/clayjohn/subscriptions","organizations_url":"https://api.github.com/users/clayjohn/orgs","repos_url":"https://api.github.com/users/clayjohn/repos","events_url":"https://api.github.com/users/clayjohn/events{/privacy}","received_events_url":"https://api.github.com/users/clayjohn/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-05-13T14:48:34Z","updated_at":"2026-05-13T14:48:34Z","body":"> [@clayjohn](https://github.com/clayjohn) area lights use dual paraboloid for shadows. switching the omnilight to dual paraboloid shows the same behaviour. this is a documentation problem.\n\nMaybe we should just use cube shadows for area lights in that case? They are intended to be a premium feature after all","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4442232704/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4442521940","html_url":"https://github.com/godotengine/godot/issues/119183#issuecomment-4442521940","issue_url":"https://api.github.com/repos/godotengine/godot/issues/119183","id":4442521940,"node_id":"IC_kwDOAO6SJc8AAAABCMuBVA","user":{"login":"QbieShay","id":7917475,"node_id":"MDQ6VXNlcjc5MTc0NzU=","avatar_url":"https://avatars.githubusercontent.com/u/7917475?v=4","gravatar_id":"","url":"https://api.github.com/users/QbieShay","html_url":"https://github.com/QbieShay","followers_url":"https://api.github.com/users/QbieShay/followers","following_url":"https://api.github.com/users/QbieShay/following{/other_user}","gists_url":"https://api.github.com/users/QbieShay/gists{/gist_id}","starred_url":"https://api.github.com/users/QbieShay/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/QbieShay/subscriptions","organizations_url":"https://api.github.com/users/QbieShay/orgs","repos_url":"https://api.github.com/users/QbieShay/repos","events_url":"https://api.github.com/users/QbieShay/events{/privacy}","received_events_url":"https://api.github.com/users/QbieShay/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-05-13T15:17:51Z","updated_at":"2026-05-13T15:17:51Z","body":"Yeah i feel the same. I had reported the same bug during my testing, i feel like we should take the high quality approach","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4442521940/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4443863963","html_url":"https://github.com/godotengine/godot/issues/119183#issuecomment-4443863963","issue_url":"https://api.github.com/repos/godotengine/godot/issues/119183","id":4443863963,"node_id":"IC_kwDOAO6SJc8AAAABCN_7mw","user":{"login":"clayjohn","id":16521339,"node_id":"MDQ6VXNlcjE2NTIxMzM5","avatar_url":"https://avatars.githubusercontent.com/u/16521339?v=4","gravatar_id":"","url":"https://api.github.com/users/clayjohn","html_url":"https://github.com/clayjohn","followers_url":"https://api.github.com/users/clayjohn/followers","following_url":"https://api.github.com/users/clayjohn/following{/other_user}","gists_url":"https://api.github.com/users/clayjohn/gists{/gist_id}","starred_url":"https://api.github.com/users/clayjohn/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/clayjohn/subscriptions","organizations_url":"https://api.github.com/users/clayjohn/orgs","repos_url":"https://api.github.com/users/clayjohn/repos","events_url":"https://api.github.com/users/clayjohn/events{/privacy}","received_events_url":"https://api.github.com/users/clayjohn/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-05-13T17:57:31Z","updated_at":"2026-05-13T17:57:31Z","body":"We ran through this together in the rendering meeting. The fundamental problem here is that the boxes used are built from 2-triangle quads. This causes problems when rendering paraboloid shadows which distorts triangles along the screen edge. The solution is to tesselate the mesh a little bit (for CubeMeshes, this can be done with the subdivide property).\n\nFor 4.7 we should document this for both AreaLights and OmniLights (with dual paraboloid shadows enabled)","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4443863963/reactions","total_count":3,"+1":3,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4444387528","html_url":"https://github.com/godotengine/godot/issues/119183#issuecomment-4444387528","issue_url":"https://api.github.com/repos/godotengine/godot/issues/119183","id":4444387528,"node_id":"IC_kwDOAO6SJc8AAAABCOf4yA","user":{"login":"Image-unavailable","id":56268917,"node_id":"MDQ6VXNlcjU2MjY4OTE3","avatar_url":"https://avatars.githubusercontent.com/u/56268917?v=4","gravatar_id":"","url":"https://api.github.com/users/Image-unavailable","html_url":"https://github.com/Image-unavailable","followers_url":"https://api.github.com/users/Image-unavailable/followers","following_url":"https://api.github.com/users/Image-unavailable/following{/other_user}","gists_url":"https://api.github.com/users/Image-unavailable/gists{/gist_id}","starred_url":"https://api.github.com/users/Image-unavailable/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Image-unavailable/subscriptions","organizations_url":"https://api.github.com/users/Image-unavailable/orgs","repos_url":"https://api.github.com/users/Image-unavailable/repos","events_url":"https://api.github.com/users/Image-unavailable/events{/privacy}","received_events_url":"https://api.github.com/users/Image-unavailable/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-05-13T19:06:30Z","updated_at":"2026-05-13T19:06:30Z","body":"> The solution is to tesselate the mesh a little bit\n\nI've ran into this issue with dual-paraboloid omnilights, which is indeed fixed by adding more tessellation.\n\nHowever, it's also worth noting that the LOD system doesn't take this kind of intentional tessellation into account, so when I had some large flat surfaces (like walls) which I subdivided, I had to disable LODs on them for it to actually work as expected (that is, with no light leaks). \n\nIf I kept LOD on, the meshes and the shadows would just get rendered as the lower-vertex version and nullify the higher density of the base mesh, leaking light through anyway.\n\nThis on Godot 4.5, idk if the behaviour has been changed in later versions.","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4444387528/reactions","total_count":2,"+1":2,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null}]