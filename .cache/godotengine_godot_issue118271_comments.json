VXNlcjIyMTQ0NTk0","avatar_url":"https://avatars.githubusercontent.com/u/22144594?v=4","gravatar_id":"","url":"https://api.github.com/users/joeykchen","html_url":"https://github.com/joeykchen","followers_url":"https://api.github.com/users/joeykchen/followers","following_url":"https://api.github.com/users/joeykchen/following{/other_user}","gists_url":"https://api.github.com/users/joeykchen/gists{/gist_id}","starred_url":"https://api.github.com/users/joeykchen/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/joeykchen/subscriptions","organizations_url":"https://api.github.com/users/joeykchen/orgs","repos_url":"https://api.github.com/users/joeykchen/repos","events_url":"https://api.github.com/users/joeykchen/events{/privacy}","received_events_url":"https://api.github.com/users/joeykchen/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-04-08T09:02:00Z","updated_at":"2026-04-08T09:02:00Z","body":"> Does it solve any reported performance issue?\r\n\r\nThis PR fixes a real issue we reproduced downstream in Go+ SPX, which uses Godot underneath for its web runtime:\r\nhttps://github.com/goplus/spx/issues/1460\r\n\r\nIn our Safari/WebKit repro, repeatedly triggering the enemy `die -> explode` sound causes browser memory to grow continuously until the page eventually reloads. Our investigation showed that this is not a sustained `logicWasm` or `engineWasm` heap leak. The growth is in the browser-side audio path.\r\n\r\nThis change directly addresses that path by removing the per-playback `AudioBuffer` duplication. In our case, that duplication is a confirmed memory-pressure amplifier, so this PR is not just a cleanup or micro-optimization; it fixes a real browser-side allocation problem that surfaces in an actual downstream project built on top of Godot.\r\n","author_association":"NONE","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4205074378/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4205168875","html_url":"https://github.com/godotengine/godot/pull/118271#issuecomment-4205168875","issue_url":"https://api.github.com/repos/godotengine/godot/issues/118271","id":4205168875,"node_id":"IC_kwDOAO6SJc76pcjr","user":{"login":"joeykchen","id":22144594,"node_id":"MDQ6VXNlcjIyMTQ0NTk0","avatar_url":"https://avatars.githubusercontent.com/u/22144594?v=4","gravatar_id":"","url":"https://api.github.com/users/joeykchen","html_url":"https://github.com/joeykchen","followers_url":"https://api.github.com/users/joeykchen/followers","following_url":"https://api.github.com/users/joeykchen/following{/other_user}","gists_url":"https://api.github.com/users/joeykchen/gists{/gist_id}","starred_url":"https://api.github.com/users/joeykchen/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/joeykchen/subscriptions","organizations_url":"https://api.github.com/users/joeykchen/orgs","repos_url":"https://api.github.com/users/joeykchen/repos","events_url":"https://api.github.com/users/joeykchen/events{/privacy}","received_events_url":"https://api.github.com/users/joeykchen/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-04-08T09:17:28Z","updated_at":"2026-04-08T09:17:28Z","body":"> Does it solve any reported performance issue?\r\n\r\nThis PR is directly relevant to #116750.\r\n\r\n#116750 shows the same failure pattern on Safari/iOS: repeated Web sample playback eventually crashes the page, while switching from Sample to Stream avoids it. That is exactly the kind of browser-side audio allocation pressure reduced by this change.\r\n\r\nSo this is not just an optimization; it addresses a real issue already reported in #116750.\r\n","author_association":"NONE","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4205168875/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null}]