"default":false,"description":"","archived_at":null,"archived_by":null},{"id":3240950060,"node_id":"MDU6TGFiZWwzMjQwOTUwMDYw","url":"https://api.github.com/repos/godotengine/godot/labels/performance","name":"performance","color":"447777","default":false,"description":"","archived_at":null,"archived_by":null}],"state":"open","locked":false,"assignees":[],"milestone":{"url":"https://api.github.com/repos/godotengine/godot/milestones/25","html_url":"https://github.com/godotengine/godot/milestone/25","labels_url":"https://api.github.com/repos/godotengine/godot/milestones/25/labels","id":15520464,"node_id":"MI_kwDOAO6SJc4A7NLQ","number":25,"title":"4.8","description":"","creator":{"login":"Repiteo","id":17489292,"node_id":"MDQ6VXNlcjE3NDg5Mjky","avatar_url":"https://avatars.githubusercontent.com/u/17489292?v=4","gravatar_id":"","url":"https://api.github.com/users/Repiteo","html_url":"https://github.com/Repiteo","followers_url":"https://api.github.com/users/Repiteo/followers","following_url":"https://api.github.com/users/Repiteo/following{/other_user}","gists_url":"https://api.github.com/users/Repiteo/gists{/gist_id}","starred_url":"https://api.github.com/users/Repiteo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Repiteo/subscriptions","organizations_url":"https://api.github.com/users/Repiteo/orgs","repos_url":"https://api.github.com/users/Repiteo/repos","events_url":"https://api.github.com/users/Repiteo/events{/privacy}","received_events_url":"https://api.github.com/users/Repiteo/received_events","type":"User","user_view_type":"public","site_admin":false},"open_issues":345,"closed_issues":2336,"state":"open","created_at":"2026-04-13T15:59:35Z","updated_at":"2026-10-22T08:21:32Z","due_on":null,"closed_at":null},"comments":8,"created_at":"2026-10-12T02:27:39Z","updated_at":"2026-10-16T04:00:56Z","closed_at":null,"assignee":null,"author_association":"NONE","issue_field_values":[],"type":null,"active_lock_reason":null,"draft":false,"pull_request":{"url":"https://api.github.com/repos/godotengine/godot/pulls/124391","html_url":"https://github.com/godotengine/godot/pull/124391","diff_url":"https://github.com/godotengine/godot/pull/124391.diff","patch_url":"https://github.com/godotengine/godot/pull/124391.patch","merged_at":null},"body":"<!--\r\nPlease target the `master` branch. We will take care of backporting relevant fixes to older versions.\r\n\r\nBefore submitting, please read our checklist for contributors:\r\nhttps://contributing.godotengine.org/en/latest/development/engine/introduction.html#checklist-for-new-contributors\r\n\r\nUse of AI must be disclosed and should include a description of how it was used.\r\n-->\r\n\r\n## What problem(s) does this PR solve?\r\n\r\n~~- Closes #~~\r\n\r\nOptimises Debug builds of GodotSharp, GodotSharpEditor and GodotPlugins. The reason for this being, the godot editor loads the Debug builds of these assemblies.\r\n\r\nBy enabling this, the user gets a much more accurate representation of the performance they should expect when one of their users/players plays the game from an exported release.\r\n\r\n## Additional information\r\n\r\nThe reason to use `<Optimize>true</Optimize>` instead of just making the godot editor use a Release build (which would implicitly enable Optimize) is, `#if DEBUG` is used in places for additional logic, assertions (also via Debug.Assert) or more verbose error logging, that should remain when running a game from the editor.\r\n\r\nThere are no concerns regarding degraded debugging/stepping into GodotSharp dlls, as debuggers use ICorDebugFunction5.DisableOptimizations when stepping into a method in an optimised assembly, which reJITs the method with optimisations disabled. This is the best of both worlds, as all other methods in the assembly remain optimised and run much faster.\r\n\r\n<!--\r\nProvide additional information and explanation of your PR, including areas that you are uncertain of or require special attention from reviewers. For examples, please read our pull request guidelines: https://contributing.godotengine.org/en/latest/development/contribution_rules.html#explain-your-contributions\r\n-->\r\n\r\nNo AI used.","closed_by":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/124391/reactions","total_count":5,"+1":5,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/godotengine/godot/issues/124391/timeline","performed_via_github_app":null,"state_reason":null}