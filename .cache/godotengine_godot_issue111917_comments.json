s/3476726854","html_url":"https://github.com/godotengine/godot/issues/111917#issuecomment-3476726854","issue_url":"https://api.github.com/repos/godotengine/godot/issues/111917","id":3476726854,"node_id":"IC_kwDOAO6SJc7POqRG","user":{"login":"Gr0minet","id":36596087,"node_id":"MDQ6VXNlcjM2NTk2MDg3","avatar_url":"https://avatars.githubusercontent.com/u/36596087?v=4","gravatar_id":"","url":"https://api.github.com/users/Gr0minet","html_url":"https://github.com/Gr0minet","followers_url":"https://api.github.com/users/Gr0minet/followers","following_url":"https://api.github.com/users/Gr0minet/following{/other_user}","gists_url":"https://api.github.com/users/Gr0minet/gists{/gist_id}","starred_url":"https://api.github.com/users/Gr0minet/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Gr0minet/subscriptions","organizations_url":"https://api.github.com/users/Gr0minet/orgs","repos_url":"https://api.github.com/users/Gr0minet/repos","events_url":"https://api.github.com/users/Gr0minet/events{/privacy}","received_events_url":"https://api.github.com/users/Gr0minet/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-11-01T19:30:15Z","updated_at":"2025-11-01T21:43:56Z","body":"I can confirm I have the same issue on Linux with Godot 4.5.1.\nEither the `Project / Import Defaults / Import Script` property does not run the import script automatically on import, and this is probably a naming / documentation issue, or this is an actual bug.\n\nEDIT: I don't think this is a bug, because I found a way to use `Import Default` settings. You have to go to the `Import` tab, then click on `Preset`. If you press `Load Default` it will load the settings set in the Project `Import Default`. Then click on `Set as Default for 'Scene'` to make this the default settings for future import:\n\n<img width=\"405\" height=\"516\" alt=\"Image\" src=\"https://github.com/user-attachments/assets/16b2502b-99c6-4407-a1ad-965c92982882\" />\n\nThis is actually mentioned in the documentation [here](https://docs.godotengine.org/en/latest/tutorials/assets_pipeline/import_process.html#changing-default-import-parameters).\nStill, I think it would make more sense to use the `Import Default` settings as default settings, without having to press the `Set as Default for 'Scene'` in the `Preset` menu.","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3476726854/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3476935681","html_url":"https://github.com/godotengine/godot/issues/111917#issuecomment-3476935681","issue_url":"https://api.github.com/repos/godotengine/godot/issues/111917","id":3476935681,"node_id":"IC_kwDOAO6SJc7PPdQB","user":{"login":"azuresu","id":35944559,"node_id":"MDQ6VXNlcjM1OTQ0NTU5","avatar_url":"https://avatars.githubusercontent.com/u/35944559?v=4","gravatar_id":"","url":"https://api.github.com/users/azuresu","html_url":"https://github.com/azuresu","followers_url":"https://api.github.com/users/azuresu/followers","following_url":"https://api.github.com/users/azuresu/following{/other_user}","gists_url":"https://api.github.com/users/azuresu/gists{/gist_id}","starred_url":"https://api.github.com/users/azuresu/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/azuresu/subscriptions","organizations_url":"https://api.github.com/users/azuresu/orgs","repos_url":"https://api.github.com/users/azuresu/repos","events_url":"https://api.github.com/users/azuresu/events{/privacy}","received_events_url":"https://api.github.com/users/azuresu/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-11-01T22:48:52Z","updated_at":"2025-11-01T22:48:52Z","body":"Thanks for the info. My opinion is that's a workaround to the BUG, bying using Set as Default for 'Scene' to do the default settings.","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3476935681/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3490059535","html_url":"https://github.com/godotengine/godot/issues/111917#issuecomment-3490059535","issue_url":"https://api.github.com/repos/godotengine/godot/issues/111917","id":3490059535,"node_id":"IC_kwDOAO6SJc7QBhUP","user":{"login":"azuresu","id":35944559,"node_id":"MDQ6VXNlcjM1OTQ0NTU5","avatar_url":"https://avatars.githubusercontent.com/u/35944559?v=4","gravatar_id":"","url":"https://api.github.com/users/azuresu","html_url":"https://github.com/azuresu","followers_url":"https://api.github.com/users/azuresu/followers","following_url":"https://api.github.com/users/azuresu/following{/other_user}","gists_url":"https://api.github.com/users/azuresu/gists{/gist_id}","starred_url":"https://api.github.com/users/azuresu/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/azuresu/subscriptions","organizations_url":"https://api.github.com/users/azuresu/orgs","repos_url":"https://api.github.com/users/azuresu/repos","events_url":"https://api.github.com/users/azuresu/events{/privacy}","received_events_url":"https://api.github.com/users/azuresu/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-11-05T09:09:48Z","updated_at":"2025-11-05T09:10:56Z","body":"More info. I found the Import Default DOES WORK for new added blend files. So when new file is added into project folders, the Import Default will be applied to them. I still think it is a bug (minor?) as changing the Import Default won't affect existing files which can be annoying to manually fix them one by one.","author_assoc