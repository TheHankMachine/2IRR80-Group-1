tive_lock_reason":null,"draft":false,"pull_request":{"url":"https://api.github.com/repos/godotengine/godot/pulls/119091","html_url":"https://github.com/godotengine/godot/pull/119091","diff_url":"https://github.com/godotengine/godot/pull/119091.diff","patch_url":"https://github.com/godotengine/godot/pull/119091.patch","merged_at":"2026-05-06T20:00:02Z"},"body":"Fixes #118903 \r\nFixes #119094\r\nPreviously the Wayland display server would attempt to enable HDR output and try to detect if it failed afterwards which had some issues. Now we can query the rendering driver for support and avoid ever enabling HDR output when this would fail.\r\n\r\nThe Windows and Mac display servers have not been modified because D3D12/Metal are guaranteed to support the formats we need and the only vulkan driver for Mac we support is MoltenVk which *happens* to support the colorspaces because it depends on Metal.\r\n\r\nIf we ever wish to enable HDR outwith with Vulkan on Windows or in the Android implementation of HDR it would be useful to query this before enabling HDR then.\r\n\r\nCC @allenwp ","closed_by":{"login":"Repiteo","id":17489292,"node_id":"MDQ6VXNlcjE3NDg5Mjky","avatar_url":"https://avatars.githubusercontent.com/u/17489292?v=4","gravatar_id":"","url":"https://api.github.com/users/Repiteo","html_url":"https://github.com/Repiteo","followers_url":"https://api.github.com/users/Repiteo/followers","following_url":"https://api.github.com/users/Repiteo/following{/other_user}","gists_url":"https://api.github.com/users/Repiteo/gists{/gist_id}","starred_url":"https://api.github.com/users/Repiteo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Repiteo/subscriptions","organizations_url":"https://api.github.com/users/Repiteo/orgs","repos_url":"https://api.github.com/users/Repiteo/repos","events_url":"https://api.github.com/users/Repiteo/events{/privacy}","received_events_url":"https://api.github.com/users/Repiteo/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/119091/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/godotengine/godot/issues/119091/timeline","performed_via_github_app":null,"state_reason":null}