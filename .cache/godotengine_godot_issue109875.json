rm:linuxbsd","color":"e4e4e4","default":false,"description":"","archived_at":null,"archived_by":null},{"id":279098255,"node_id":"MDU6TGFiZWwyNzkwOTgyNTU=","url":"https://api.github.com/repos/godotengine/godot/labels/topic:platforms","name":"topic:platforms","color":"ffee88","default":false,"description":"","archived_at":null,"archived_by":null}],"state":"open","locked":false,"assignees":[],"milestone":{"url":"https://api.github.com/repos/godotengine/godot/milestones/16","html_url":"https://github.com/godotengine/godot/milestone/16","labels_url":"https://api.github.com/repos/godotengine/godot/milestones/16/labels","id":8237783,"node_id":"MI_kwDOAO6SJc4AfbLX","number":16,"title":"4.x","description":"Issues and pull requests slated for an undetermined Godot 4 release.","creator":{"login":"akien-mga","id":4701338,"node_id":"MDQ6VXNlcjQ3MDEzMzg=","avatar_url":"https://avatars.githubusercontent.com/u/4701338?v=4","gravatar_id":"","url":"https://api.github.com/users/akien-mga","html_url":"https://github.com/akien-mga","followers_url":"https://api.github.com/users/akien-mga/followers","following_url":"https://api.github.com/users/akien-mga/following{/other_user}","gists_url":"https://api.github.com/users/akien-mga/gists{/gist_id}","starred_url":"https://api.github.com/users/akien-mga/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/akien-mga/subscriptions","organizations_url":"https://api.github.com/users/akien-mga/orgs","repos_url":"https://api.github.com/users/akien-mga/repos","events_url":"https://api.github.com/users/akien-mga/events{/privacy}","received_events_url":"https://api.github.com/users/akien-mga/received_events","type":"User","user_view_type":"public","site_admin":false},"open_issues":5793,"closed_issues":0,"state":"open","created_at":"2022-07-26T12:42:05Z","updated_at":"2026-10-22T14:39:14Z","due_on":null,"closed_at":null},"comments":6,"created_at":"2025-08-22T16:22:26Z","updated_at":"2026-09-30T05:28:06Z","closed_at":null,"assignee":null,"author_association":"NONE","issue_field_values":[],"type":null,"active_lock_reason":null,"draft":false,"pull_request":{"url":"https://api.github.com/repos/godotengine/godot/pulls/109875","html_url":"https://github.com/godotengine/godot/pull/109875","diff_url":"https://github.com/godotengine/godot/pull/109875.diff","patch_url":"https://github.com/godotengine/godot/pull/109875.patch","merged_at":null},"body":"⚠️ I've implemented this over the weekend and this is my first time contributing to the Godot Project. I might have messed up a few things, and it's okay to tell me ! ⚠️\r\n⚠️ It's also my first time implementing the layer shell protocol, and modifying the Godot engine, so my code may not be up to standards ! ⚠️\r\n\r\nThis implements what was proposed in godot proposals, [issue 11351 : Implementation/Workaround for Wayland Layer Shell Protocol Overlay](https://github.com/godotengine/godot-proposals/issues/11351)\r\n\r\nThis code allows Wayland windows to be...\r\n- Background windows, displayed on the same level as the wallpaper.\r\n- Bottom windows, displayed behind all others.\r\n- Top windows, displayed above other windows and reserving space (like a bar, for example)\r\n- Overlay windows, displayed on top of everything else, and regardless of the workspace (like a notification window)\r\n\r\n- Added a property for the `Window` class to control the layer of the window on Wayland.\r\n- Added a project setting for the layer of the main window.\r\n\r\nHere's a test project I made with an overlay window to display the lyrics of my currently played song using `sptlrx`\r\n\r\nhttps://github.com/user-attachments/assets/b969d921-84ba-4f2e-b92e-43be5734f657","closed_by":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/109875/reactions","total_count":37,"+1":16,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":12,"rocket":0,"eyes":9},"timeline_url":"https://api.github.com/repos/godotengine/godot/issues/109875/timeline","performed_via_github_app":null,"state_reason":null}