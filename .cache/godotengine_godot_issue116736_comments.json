dhamDev/gists{/gist_id}","starred_url":"https://api.github.com/users/YeldhamDev/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/YeldhamDev/subscriptions","organizations_url":"https://api.github.com/users/YeldhamDev/orgs","repos_url":"https://api.github.com/users/YeldhamDev/repos","events_url":"https://api.github.com/users/YeldhamDev/events{/privacy}","received_events_url":"https://api.github.com/users/YeldhamDev/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-02-25T00:37:55Z","updated_at":"2026-02-25T00:37:55Z","body":"Alright, good news: it can now handle the gaps between indexes.\r\nBad news: It does by filling the gaps with empty items. Not ideal.\r\n\r\nIt's in a state where it could be merged, but the ideal solution would be that when a library with gaps is detected, it would be shrunk, and any `GridMap` that uses it would be updated with the new indexes.","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3955620592/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3961499451","html_url":"https://github.com/godotengine/godot/pull/116736#issuecomment-3961499451","issue_url":"https://api.github.com/repos/godotengine/godot/issues/116736","id":3961499451,"node_id":"IC_kwDOAO6SJc7sH687","user":{"login":"YeldhamDev","id":30739239,"node_id":"MDQ6VXNlcjMwNzM5MjM5","avatar_url":"https://avatars.githubusercontent.com/u/30739239?v=4","gravatar_id":"","url":"https://api.github.com/users/YeldhamDev","html_url":"https://github.com/YeldhamDev","followers_url":"https://api.github.com/users/YeldhamDev/followers","following_url":"https://api.github.com/users/YeldhamDev/following{/other_user}","gists_url":"https://api.github.com/users/YeldhamDev/gists{/gist_id}","starred_url":"https://api.github.com/users/YeldhamDev/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/YeldhamDev/subscriptions","organizations_url":"https://api.github.com/users/YeldhamDev/orgs","repos_url":"https://api.github.com/users/YeldhamDev/repos","events_url":"https://api.github.com/users/YeldhamDev/events{/privacy}","received_events_url":"https://api.github.com/users/YeldhamDev/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-02-25T19:26:18Z","updated_at":"2026-02-25T19:26:18Z","body":"I introduced a little hack to avoid polluting the `GridMap` editor: items that are created to fill gaps have a new property called `hide_from_list` set to `true`. As the name implies, it hides those items from `get_item_list()`, which is what `GridMap` editor uses.\r\n\r\n---\r\n\r\n> The main problem is that there is no proper editor for MeshLibrary at all and editing the properties in the inspector is a workaround, and not a very friendly one. The MeshLibrary properties should not be in the inspector at all, but right now there is no better way to edit them.\r\n\r\nYou bring a good point. Maybe the way to go would simply be creating a proper editor for `MeshLibrary`. It wouldn't need to be too complex, just a grid of items to the left, and an inspector for them to the right, with a toolbar at the top for item creation/deletion.","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3961499451/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4111675472","html_url":"https://github.com/godotengine/godot/pull/116736#issuecomment-4111675472","issue_url":"https://api.github.com/repos/godotengine/godot/issues/116736","id":4111675472,"node_id":"IC_kwDOAO6SJc71EzBQ","user":{"login":"aki