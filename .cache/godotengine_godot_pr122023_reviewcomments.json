[{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/3699078338","pull_request_review_id":4838507480,"id":3699078338,"node_id":"PRRC_kwDOAO6SJc7ce3TC","diff_hunk":"@@ -458,16 +458,11 @@ bool XMLParser::is_empty() const {\n Error XMLParser::open_buffer(const Vector<uint8_t> &p_buffer) {\n \tERR_FAIL_COND_V(p_buffer.is_empty(), ERR_INVALID_DATA);\n \n-\tif (data_copy) {\n-\t\tmemdelete_arr(data_copy);\n-\t\tdata_copy = nullptr;\n-\t}\n+\tdata_copy = p_buffer;\n+\tdata_copy.push_back(0);","path":"core/io/xml_parser.cpp","commit_id":"ad6ccd74ddce59588b861cca48016256909d0520","original_commit_id":"730845c4a99e7c509feb15f1748b1bdaa6308b91","user":{"login":"lawnjelly","id":21999379,"node_id":"MDQ6VXNlcjIxOTk5Mzc5","avatar_url":"https://avatars.githubusercontent.com/u/21999379?v=4","gravatar_id":"","url":"https://api.github.com/users/lawnjelly","html_url":"https://github.com/lawnjelly","followers_url":"https://api.github.com/users/lawnjelly/followers","following_url":"https://api.github.com/users/lawnjelly/following{/other_user}","gists_url":"https://api.github.com/users/lawnjelly/gists{/gist_id}","starred_url":"https://api.github.com/users/lawnjelly/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/lawnjelly/subscriptions","organizations_url":"https://api.github.com/users/lawnjelly/orgs","repos_url":"https://api.github.com/users/lawnjelly/repos","events_url":"https://api.github.com/users/lawnjelly/events{/privacy}","received_events_url":"https://api.github.com/users/lawnjelly/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"I haven't looked at the rest of the class, but if you are making a copy here and there's not a specific need for COW, a `LocalVector` is likely better. Especially here because this change will force the `Vector` to always perform COW.\n\n`Vector` is handy when you need COW, but if you don't and it is single threaded, `LocalVector` should usually be first choice. ","created_at":"2026-08-02T12:55:00Z","updated_at":"2026-08-02T12:55:00Z","html_url":"https://github.com/godotengine/godot/pull/122023#discussion_r3699078338","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/122023","_links":{"self":{"href":"https://api.github.com/repos/godotengine/godot/pulls/comments/3699078338"},"html":{"href":"https://github.com/godotengine/godot/pull/122023#discussion_r3699078338"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/122023"}},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/3699078338/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":462,"original_line":462,"side":"RIGHT","author_association":"MEMBER","original_position":9,"position":9,"subject_type":"line"},{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/3704834975","pull_request_review_id":4845184046,"id":3704834975,"node_id":"PRRC_kwDOAO6SJc7c00uf","diff_hunk":"@@ -458,16 +458,11 @@ bool XMLParser::is_empty() const {\n Error XMLParser::open_buffer(const Vector<uint8_t> &p_buffer) {\n \tERR_FAIL_COND_V(p_buffer.is_empty(), ERR_INVALID_DATA);\n \n-\tif (data_copy) {\n-\t\tmemdelete_arr(data_copy);\n-\t\tdata_copy = nullptr;\n-\t}\n+\tdata_copy = p_buffer;\n+\tdata_copy.push_back(0);","path":"core/io/xml_parser.cpp","commit_id":"ad6ccd74ddce59588b861cca48016256909d0520","original_commit_id":"730845c4a99e7c509feb15f1748b1bdaa6308b91","user":{"login":"Karticoder","id":168813500,"node_id":"U_kgDOCg_jvA","avatar_url":"https://avatars.githubusercontent.com/u/168813500?v=4","gravatar_id":"","url":"https://api.github.com/users/Karticoder","html_url":"https://github.com/Karticoder","followers_url":"https://api.github.com/users/Karticoder/followers","following_url":"https://api.github.com/users/Karticoder/following{/other_user}","gists_url":"https://api.github.com/users/Karticoder/gists{/gist_id}","starred_url":"https://api.github.com/users/Karticoder/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Karticoder/subscriptions","organizations_url":"https://api.github.com/users/Karticoder/orgs","repos_url":"https://api.github.com/users/Karticoder/repos","events_url":"https://api.github.com/users/Karticoder/events{/privacy}","received_events_url":"https://api.github.com/users/Karticoder/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"Thanks for the feedback.\r\n\r\nTo avoid any copying/allocating overhead entirely and keep the parser zero-copy,  I've pivoted the PR.\r\n\r\nInstead of modifying the buffer, I added a bounds-checked peek(int p_offset) helper to the parser core and replaced raw *P dereferences with it. \r\n\r\nThis fixes the out-of-bounds read directly in the parser loops and handles non-null-terminated/truncated buffers safely without any memory overhead. I also added unit tests to verify the fix\r\n\r\n","created_at":"2026-08-03T14:30:28Z","updated_at":"2026-08-03T14:37:20Z","html_url":"https://github.com/godotengine/godot/pull/122023#discussion_r3704834975","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/122023","_links":{"self":{"href":"https://api.github.com/repos/godotengine/godot/pulls/comments/3704834975"},"html":{"href":"https://github.com/godotengine/godot/pull/122023#discussion_r3704834975"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/122023"}},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/3704834975/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":462,"original_line":462,"side":"RIGHT","in_reply_to_id":3699078338,"author_association":"NONE","original_position":9,"position":9,"subject_type":"line"}]