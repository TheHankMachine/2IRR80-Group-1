/pull/113267#discussion_r2571497008"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/113267"}},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/2571497008/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":82,"original_start_line":82,"start_side":"RIGHT","line":97,"original_line":95,"side":"RIGHT","in_reply_to_id":2571413253,"author_association":"MEMBER","original_position":17,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/2571518607","pull_request_review_id":3518805136,"id":2571518607,"node_id":"PRRC_kwDOAO6SJc6ZRkKP","diff_hunk":"@@ -79,6 +79,21 @@ class OS_MacOS : public OS_Unix {\n \tvirtual void delete_main_loop() override;\n \n public:\n+\tstatic inline const char *headless_args[] = {\n+\t\t\"--headless\",\n+\t\t\"-h\",\n+\t\t\"--help\",\n+\t\t\"/?\",\n+\t\t\"--version\",\n+\t\t\"--dump-gdextension-interface\",\n+\t\t\"--dump-extension-api\",\n+\t\t\"--dump-extension-api-with-docs\",\n+\t\t\"--validate-extension-api\",\n+\t\t\"--convert-3to4\",\n+\t\t\"--validate-conversion-3to4\",\n+\t\t\"--doctool\",\n+\t};","path":"platform/macos/os_macos.h","commit_id":"d26c5775243393f0423dd91482d57882d5bd8252","original_commit_id":"d26c5775243393f0423dd91482d57882d5bd8252","user":{"login":"bruvzg","id":7645683,"node_id":"MDQ6VXNlcjc2NDU2ODM=","avatar_url":"https://avatars.githubusercontent.com/u/7645683?v=4","gravatar_id":"","url":"https://api.github.com/users/bruvzg","html_url":"https://github.com/bruvzg","followers_url":"https://api.github.com/users/bruvzg/followers","following_url":"https://api.github.com/users/bruvzg/following{/other_user}","gists_url":"https://api.github.com/users/bruvzg/gists{/gist_id}","starred_url":"https://api.github.com/users/bruvzg/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/bruvzg/subscriptions","organizations_url":"https://api.github.com/users/bruvzg/orgs","repos_url":"https://api.github.com/users/bruvzg/repos","events_url":"https://api.github.com/users/bruvzg/events{/privacy}","received_events_url":"https://api.github.com/users/bruvzg/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"Not sure what's the best way to handle this, it probably should be in `Main`, but there's an issue with the way command line arguments caused by macOS specific quirks:\r\n\r\n- `OS_MacOS` need to know if it's headless on init to pick correct main loop for the app.\r\n- File associations for GUI apps are handled by event, not command line arguments, so `Main::start` argument parsing logic can run before GUI app is finished starting, or it will miss the opened files.\r\n\r\nI guess making a separate setup function in the `Main` (which will only set headless flag) might be better.","created_at":"2025-11-28T12:30:55Z","updated_at":"2025-11-28T12:30:55Z","html_url":"https://github.com/godotengine/godot/pull/113267#discussion_r2571518607","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/113267","_links":{"self":{"href":"https://api.github.com/repos/godotengine/godot/pulls/comments/2571518607"},"html":{"href":"https://github.com/godotengine/godot/pull/113267#discussion_r2571518607"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/113267"}},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/2571518607/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":82,"original_start_line":82,"start_side":"RIGHT","line":97,"original_line":95,"side":"RIGHT","in_reply_to_id":2571413253,"author_association":"MEMBER","original_position":17,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/2572272352","pull_request_review_id":3519671614,"id":2572272352,"node_id":"PRRC_kwDOAO6SJc6ZUcLg","diff_hun