raft":true,"pull_request":{"url":"https://api.github.com/repos/godotengine/godot/pulls/116746","html_url":"https://github.com/godotengine/godot/pull/116746","diff_url":"https://github.com/godotengine/godot/pull/116746.diff","patch_url":"https://github.com/godotengine/godot/pull/116746.patch","merged_at":null},"body":"Show tab drop preview across native windows during tab drag\r\n\r\nFixes #116577 \r\n\r\nWhen dragging a TabContainer/TabBar tab between non-embedded windows, the\r\ntarget TabBar could fail to show the drop marker because preview activation\r\ndepended on local mouse motion input only.\r\n\r\nBy updating TabBar drag preview state on drag and hover lifecycle\r\nnotifications (NOTIFICATION_DRAG_BEGIN, NOTIFICATION_MOUSE_ENTER,\r\nNOTIFICATION_MOUSE_EXIT), this change ensures the drop indicator appears\r\nreliably for cross-window tab drags.","closed_by":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/116746/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/godotengine/godot/issues/116746/timeline","performed_via_github_app":null,"state_reason":null}