[{"id":3146503339,"node_id":"PRR_kwDOAO6SJc67i9Sr","state":"COMMENTED","user":{"site_admin":false,"suspended":false,"updated_at":"0001-01-01T00:00:00Z","avatar_url":"https://avatars.githubusercontent.com/u/180032?u=68d23e7ee9cdf810da125e8510b72f845b9dccc8&v=4","created_at":"0001-01-01T00:00:00Z","followers":0,"following":0,"html_url":"https://github.com/Calinou","id":180032,"node_id":"MDQ6VXNlcjE4MDAzMg==","login":"Calinou","type":"User","owned_private_repos":0,"public_gists":0,"public_repos":0,"total_private_repos":0,"url":"https://api.github.com/users/Calinou"},"body":"Tested locally on Linux, this fixes the issue with entering `0.1` in the inspector, but it introduces another issue.\r\n\r\nClicking the reset button in the MRP from https://github.com/godotengine/godot/issues/109852 will set the value to a very high number (`9223372036854775808.0`), where it would previously be `0.0`:\r\n\r\n<img width=\"277\" height=\"176\" alt=\"image\" src=\"https://github.com/user-attachments/assets/25fe507b-2ba7-40f2-bd28-1ad1d9f08edb\" />\r\n\r\nThis number is not serialized as it's considered the default. You will also see this number appear if you try to enter `0.0` in the inspector (but not any other number).","html_url":"https://github.com/godotengine/godot/pull/109887#pullrequestreview-3146503339","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/109887","author_association":"MEMBER","submitted_at":"2025-08-22T23:22:35Z"},{"id":3156980981,"node_id":"PRR_kwDOAO6SJc68K7T1","state":"APPROVED","commit_id":"0ad409bcd61de12523925686abfd853d435f1792","user":{"site_admin":false,"suspended":false,"updated_at":"0001-01-01T00:00:00Z","avatar_url":"https://avatars.githubusercontent.com/u/2223172?u=fc85633b469acb6e7baef4dba5171f19a2a4ff85&v=4","created_at":"0001-01-01T00:00:00Z","followers":0,"following":0,"html_url":"https://github.com/KoBeWi","id":2223172,"node_id":"MDQ6VXNlcjIyMjMxNzI=","login":"KoBeWi","type":"User","owned_private_repos":0,"public_gists":0,