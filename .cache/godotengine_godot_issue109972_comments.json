com/BlueCube3310","followers_url":"https://api.github.com/users/BlueCube3310/followers","following_url":"https://api.github.com/users/BlueCube3310/following{/other_user}","gists_url":"https://api.github.com/users/BlueCube3310/gists{/gist_id}","starred_url":"https://api.github.com/users/BlueCube3310/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/BlueCube3310/subscriptions","organizations_url":"https://api.github.com/users/BlueCube3310/orgs","repos_url":"https://api.github.com/users/BlueCube3310/repos","events_url":"https://api.github.com/users/BlueCube3310/events{/privacy}","received_events_url":"https://api.github.com/users/BlueCube3310/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-10-25T08:52:48Z","updated_at":"2025-10-25T08:52:48Z","body":"> @BlueCube3310 Should we go ahead and merge this, or did you want to poke at the JNLM issue first?\r\n\r\nI'll attempt to fix the issue first","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3446290459/reactions","total_count":2,"+1":2,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3472764516","html_url":"https://github.com/godotengine/godot/pull/109972#issuecomment-3472764516","issue_url":"https://api.github.com/repos/godotengine/godot/issues/109972","id":3472764516,"node_id":"IC_kwDOAO6SJc7O_i5k","user":{"login":"BlueCube3310","id":53150244,"node_id":"MDQ6VXNlcjUzMTUwMjQ0","avatar_url":"https://avatars.githubusercontent.com/u/53150244?v=4","gravatar_id":"","url":"https://api.github.com/users/BlueCube3310","html_url":"https://github.com/BlueCube3310","followers_url":"https://api.github.com/users/BlueCube3310/followers","following_url":"https://api.github.com/users/BlueCube3310/following{/other_user}","gists_url":"https://api.github.com/users/BlueCube3310/gists{/gist_id}","starred_url":"https://api.github.com/users/BlueCube3310/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/BlueCube3310/subscriptions","organizations_url":"https://api.github.com/users/BlueCube3310/orgs","repos_url":"https://api.github.com/users/BlueCube3310/repos","events_url":"https://api.github.com/users/BlueCube3310/events{/privacy}","received_events_url":"https://api.github.com/users/BlueCube3310/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-10-31T11:58:10Z","updated_at":"2025-10-31T11:59:44Z","body":"The L0 light weights are now multiplied by 4 to ensure the directional lightmap has the same influence as a regular one. Additionally, the L1 coefficients now use the weights from the L0 layer.\r\n\r\nI've also fixed a bug that caused shadowmasks to be unnecessarily denoised 4 times when baking with both them and directional enabled.\r\n\r\nCC @Calinou could you confirm whether this fixes the JNLM denoising? (I'm no longer able to download the linked MRP)","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3472764516/reactions","total_count":2,"+1":2,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3488463413","html_url":"https://github.com/godotengine/godot/pull/109972#issuecomment-3488463413","issue_url":"https://api.github.com/repos/godotengine/godot/issues/109972","id":3488463413,"node_id":"IC_kwDOAO6SJc7P7bo1","user":{"login":"Calinou","id":180032,"node_id":"MDQ6VXNlcjE4MDAzMg==","avatar_url":"https://avatars.githubusercontent.com/u/180032?v=4","gravatar_id":"","url":"https://api.github.com/users/Calinou","html_url":"https://github.com/Calinou","followers_url":"https://api.github.com/users/Calinou/followers","following_url":"https://api.github.com/users/Calinou/following{/other_user}","gists_url":"https://api.github.com/users/Calinou/gists{/gist_id}","starred_url":"https://api.github.com/users/Calinou/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Calinou/subscriptions","organizations_url":"https://api.github.com/users/Calinou/orgs","repos_url":"https://api.github.com/users/Calinou/repos","events_url":"https://api.github.com/users/Calinou/events{/privacy}","received_events_url":"https://api.github.com/users/Calinou/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-11-04T23:52:55Z","updated_at":"2025-11-04T23:56:25Z","body":"> I've also fixed a bug that caused shadowmasks to be unnecessarily denoised 4 times when baking with both them and directional enabled.\r\n\r\nOut of curiosity, why do shadowmasks need to be denoised? They only contain shadow information for a primary ray (the directional light). This should be 100% noise-free as far as I can tell.\r\n\r\nThe shadowmask might have some aliasing to it, but this could be better handled using some antialiasing algorithm instead (even FXAA could work).\r\n\r\n> CC @Calinou could you confirm whether this fixes the JNLM denoising?\r\n\r\nWorks great now :slightly_smiling_face: \r\n\r\n### Directional disabled\r\n\r\nNo denoiser | JNLM | OIDN\r\n-|-|-\r\n![Image](https://github.com/user-attachments/assets/0f06251f-8189-41db-8782-3021dc9397c1) | ![Image](https://github.com/user-attachments/assets/62eb96a2-eef6-4555-bd5f-602e918d68ed) | ![Image](https://github.com/user-attachments/assets/03d61cc6-a412-4aa5-be45-9fabf90eb924)\r\n\r\n### Directional enabled\r\n\r\nNo denoiser | JNLM | OIDN\r\n-|-|-\r\n![Image](https://github.com/user-attachments/assets/5b730a50-500a-4be2-b843-187b91a30e64) | ![Image](https://github.com/user-attachments/assets/637aa45b-6946-44c7-8921-4a6e2ae46fec) | ![Image](https://github.com/user-attachments/assets/4cc0052b-9956-48a9-b9cf-f42d8faf21b9)\r\n\r\n\r\n> (I'm no longer able to download the linked MRP)\r\n\r\nThe download still works on my end, but only when I'm logged in. Maybe my file uploads (other than images) have been shadowbanned for some reason… I've had this issue for a few months now.","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3488463413/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3490969499","html_url":"https://github.com/godotengine/godot/pull/109972#issuecomment-3490969499","issue_url":"https://api.github.com/repos/godotengine/godot/issues/109972","id":3490969499,"node_id":"IC_kwDOAO6SJc7QE_eb","user":{"login":"BlueCube3310","id":53150244,"node_id":"MDQ6VXNlcjUzMTUwMjQ0","avatar_url":"https://avatars.githubusercontent.com/u/53150244?v=4","gravatar_id":"","url":"https://api.github.com/users/BlueCube3310","html_url":"https://github.com/BlueCube3310","followers_url":"https://api.github.com/users/BlueCube3310/followers","following_url":"https://api.github.com/users/BlueCube3310/following{/other_user}","gists_url":"https://api.github.com/users/BlueCube3310/gists{/gist_id}","starred_url":"https://api.github.com/users/BlueCube3310/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/BlueCube3310/subscriptions","organizations_url":"https://api.github.com/users/BlueCube3310/orgs","repos_url":"https://api.github.com/users/BlueCube3310/repos","events_url":"https://api.github.com/users/BlueCube3310/events{/privacy}","received_events_url":"https://api.github.com/users/BlueCube3310/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-11-05T12:32:47Z","updated_at":"2025-11-05T12:32:47Z","body":"> Out of curiosity, why do shadowmasks need to be denoised? They only contain shadow information for a primary ray (the directional light). This should be 100% noise-free as far as I can tell.\r\n> \r\n> The shadowmask might have some aliasing to it, but this could be better handled using some antialiasing algorithm instead (even FXAA could work).\r\n\r\nNoise is applied to shadowmasks when the angular distance property is used","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3490969499/reactions","total_count":3,"+1":3,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3565140748","html_url":"https://github.com/godotengine/godot/pull/109972#issuecomment-3565140748","issue_url":"https://api.github.com/repos/godotengine/godot/issues/109972","id":3565140748,"node_id":"IC_kwDOAO6SJc7Uf7sM","user":{"login":"Repiteo","id":17489292,"node_id":"MDQ6VXNlcjE3NDg5Mjky","avatar_url":"https://avatars.githubusercontent.com/u/17489292?v=4","gravatar_id":"","url":"https://api.github.com/users/Repiteo","html_url":"https://github.com/Repiteo","followers_url":"https://api.github.com/users/Repiteo/followers","following_url":"https://api.github.com/users/Repiteo/following{/other_user}","gists_url":"https://api.github.com/users/Repiteo/gists{/gist_id}","starred_url":"https://api.github.com/users/Repiteo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Repiteo/subscriptions","organizations_url":"https://api.github.com/users/Repiteo/orgs","repos_url":"https://api.github.com/users/Repiteo/repos","events_url":"https://api.github.com/users/Repiteo/events{/privacy}","received_events_url":"https://api.github.com/users/Repiteo/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-11-22T00:42:54Z","updated_at":"2025-11-22T00:42:54Z","body":"Thanks!","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/