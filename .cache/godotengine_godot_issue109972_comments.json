[{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3224205174","html_url":"https://github.com/godotengine/godot/pull/109972#issuecomment-3224205174","issue_url":"https://api.github.com/repos/godotengine/godot/issues/109972","id":3224205174,"node_id":"IC_kwDOAO6SJc7ALXd2","user":{"login":"jcostello","id":1168582,"node_id":"MDQ6VXNlcjExNjg1ODI=","avatar_url":"https://avatars.githubusercontent.com/u/1168582?v=4","gravatar_id":"","url":"https://api.github.com/users/jcostello","html_url":"https://github.com/jcostello","followers_url":"https://api.github.com/users/jcostello/followers","following_url":"https://api.github.com/users/jcostello/following{/other_user}","gists_url":"https://api.github.com/users/jcostello/gists{/gist_id}","starred_url":"https://api.github.com/users/jcostello/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/jcostello/subscriptions","organizations_url":"https://api.github.com/users/jcostello/orgs","repos_url":"https://api.github.com/users/jcostello/repos","events_url":"https://api.github.com/users/jcostello/events{/privacy}","received_events_url":"https://api.github.com/users/jcostello/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-08-26T13:33:49Z","updated_at":"2025-08-26T13:33:49Z","body":"Seems that directional data is preserved and works just fine with OIDN. It fixed the issue of losing directional data when denoising with OIDN","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3224205174/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3224924546","html_url":"https://github.com/godotengine/godot/pull/109972#issuecomment-3224924546","issue_url":"https://api.github.com/repos/godotengine/godot/issues/109972","id":3224924546,"node_id":"IC_kwDOAO6SJc7AOHGC","user":{"login":"BlueCube3310","id":53150244,"node_id":"MDQ6VXNlcjUzMTUwMjQ0","avatar_url":"https://avatars.githubusercontent.com/u/53150244?v=4","gravatar_id":"","url":"https://api.github.com/users/BlueCube3310","html_url":"https://github.com/BlueCube3310","followers_url":"https://api.github.com/users/BlueCube3310/followers","following_url":"https://api.github.com/users/BlueCube3310/following{/other_user}","gists_url":"https://api.github.com/users/BlueCube3310/gists{/gist_id}","starred_url":"https://api.github.com/users/BlueCube3310/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/BlueCube3310/subscriptions","organizations_url":"https://api.github.com/users/BlueCube3310/orgs","repos_url":"https://api.github.com/users/BlueCube3310/repos","events_url":"https://api.github.com/users/BlueCube3310/events{/privacy}","received_events_url":"https://api.github.com/users/BlueCube3310/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-08-26T16:34:17Z","updated_at":"2025-08-26T16:34:17Z","body":"> However, JNLM now has a tendency to darken bright static lights, as seen below. This doesn't happen with OIDN.\r\n\r\nThis can probably be fixed by adjusting the denoiser strength, since the directional data is now packed that value can be a constant. The L0 coefficient has 1/4 the brightness of a non-directional lightmap, so an adjustment may be necessary there as well.","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3224924546/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3445509946","html_url":"https://github.com/godotengine/godot/pull/109972#issuecomment-3445509946","issue_url":"https://api.github.com/repos/godotengine/g