kageItLab/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/TokageItLab/subscriptions","organizations_url":"https://api.github.com/users/TokageItLab/orgs","repos_url":"https://api.github.com/users/TokageItLab/repos","events_url":"https://api.github.com/users/TokageItLab/events{/privacy}","received_events_url":"https://api.github.com/users/TokageItLab/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-10-10T19:48:17Z","updated_at":"2025-10-10T19:48:17Z","body":"When multiple selections are made, it should be correct behavior for each selection to be sheared individually.","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3392110769/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3393004124","html_url":"https://github.com/godotengine/godot/pull/108608#issuecomment-3393004124","issue_url":"https://api.github.com/repos/godotengine/godot/issues/108608","id":3393004124,"node_id":"IC_kwDOAO6SJc7KPSJc","user":{"login":"ryevdokimov","id":105675984,"node_id":"U_kgDOBkx80A","avatar_url":"https://avatars.githubusercontent.com/u/105675984?v=4","gravatar_id":"","url":"https://api.github.com/users/ryevdokimov","html_url":"https://github.com/ryevdokimov","followers_url":"https://api.github.com/users/ryevdokimov/followers","following_url":"https://api.github.com/users/ryevdokimov/following{/other_user}","gists_url":"https://api.github.com/users/ryevdokimov/gists{/gist_id}","starred_url":"https://api.github.com/users/ryevdokimov/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/ryevdokimov/subscriptions","organizations_url":"https://api.github.com/users/ryevdokimov/orgs","repos_url":"https://api.github.com/users/ryevdokimov/repos","events_url":"https://api.github.com/users/ryevdokimov/events{/privacy}","received_events_url":"https://api.github.com/users/ryevdokimov/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-10-11T07:04:06Z","updated_at":"2025-10-12T00:10:10Z","body":"Oops I didn't pay attention to the scales across parents close enough in my testing.\r\n\r\nI think things are fine, let me know if I missed anything. ","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3393004124/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3507707229","html_url":"https://github.com/godotengine/godot/pull/108608#issuecomment-3507707229","issue_url":"https://api.github.com/repos/godotengine/godot/issues/108608","id":3507707229,"node_id":"IC_kwDOAO6SJc7RE11d","user":{"login":"TokageItLab","id":61938263,"node_id":"MDQ6VXNlcjYxOTM4MjYz","avatar_url":"https://avatars.githubusercontent.com/u/61938263?v=4","gravatar_id":"","url":"https://api.github.com/users/TokageItLab","html_url":"https://github.com/TokageItLab","followers_url":"https://api.github.com/users/TokageItLab/followers","following_url":"https://api.github.com/users/TokageItLab/following{/other_user}","gists_url":"https://api.github.com/users/TokageItLab/gists{/gist_id}","starred_url":"https://api.github.com/users/TokageItLab/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/TokageItLab/subscriptions","organizations_url":"https://api.github.com/users/TokageItLab/orgs","repos_url":"https://api.github.com/users/TokageItLab/repos","events_url":"https://api.github.com/users/TokageItLab/events{/privacy}","received_events_url":"https://api.github.com/users/TokageItLab/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-11-09T08:38:52Z","updated_at":"2025-11-09T08:42:07Z","body":"As I mentioned above, in local mode, the XYZ rotation gizmo references each node's local axes.\r\n\r\nWhen multiple nodes are selected, the gizmo displayed is based on the last selected node.\r\n\r\n<img width=\"652\" height=\"473\" alt=\"image\" src=\"https://github.com/user-attachments/assets/6a088fc2-80fd-4bd8-b918-ffaf9487625a\" />\r\n\r\n<img width=\"642\" height=\"447\" alt=\"image\" src=\"https://github.com/user-attachments/assets/2a8196cd-f57e-4b12-a54e-27e37e3a4e82\" />\r\n\r\nConsidering this, the 4th gizmo should extract the local axes relative to the last selected node from that plane and apply them to the other nodes during multiple selection. In other words, in the case shown in the following video, the Y rotation and the rotation applied by the 4th gizmo should be equal.\r\n\r\nhttps://github.com/user-attachments/assets/9fcd3eb1-9eb9-448a-9f16-806084728424\r\n\r\n[sh_3d.zip](https://github.com/user-attachments/files/23436798/sh_3d.zip)\r\n\r\nIn other words, the current local mode with 4th gizmo is inconsistent as the origin is local while rotation is global.\r\n","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3507707229/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3508915210","html_url":"https://github.com/godotengine/godot/pull/108608#issuecomment-3508915210","issue_url":"https://api.github.com/repos/godotengine/godot/issues/108608","id":3508915210,"node_id":"IC_kwDOAO6SJc7RJcwK","user":{"login":"ryevdokimov","id":105675984,"node_id":"U_kgDOBkx80A","avatar_url":"https://avatars.githubusercontent.com/u/105675984?v=4","gravatar_id":"","url":"https://api.github.com/users/ryevdokimov","html_url":"https://github.com/ryevdokimov","followers_url":"https://api.github.com/users/ryevdokimov/followers","following_url":"https://api.github.com/users/ryevdokimov/following{/other_user}","gists_url":"https://api.github.com/users/ryevdokimov/gists{/gist_id}","starred_url":"https://api.github.com/users/ryevdokimov/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/ryevdokimov/subscriptions","organizations_url":"https://api.github.com/users/ryevdokimov/orgs","repos_url":"https://api.github.com/users/ryevdokimov/repos","events_url":"https://api.github.com/users/ryevdokimov/events{/privacy}","received_events_url":"https://api.github.com/users/ryevdokimov/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-11-09T22:57:22Z","updated_at":"2025-11-09T22:59:41Z","body":"Wouldn't that require https://github.com/godotengine/godot/pull/104233 as a prerequisite and its function enabled to make sense? Right now, local mode just means transform each node relative to its own local coordinates, and the 4th gizmo is always facing the camera, so it effectively behaves as a global transform. ","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3508915210/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3508923512","html_url":"https://github.com/godotengine/godot/pull/108608#issuecomment-3508923512","issue_url":"https://api.github.com/repos/godotengine/godot/issues/108608","id":3508923512,"node_id":"IC_kwDOAO6SJc7RJex4","user":{"login":"TokageItLab","id":61938263,"node_id":"MDQ6VXNlcjYxOTM4MjYz","avatar_url":"https://avatars.githubusercontent.com/u/61938263?v=4","gravatar_id":"","url":"https://api.github.com/users/TokageItLab","html_url":"https://github.com/TokageItLab","followers_url":"https://api.github.com/users/TokageItLab/followers","following_url":"https://api.github.com/users/TokageItLab/following{/other_user}","gists_url":"https://api.github.com/users/TokageItLab/gists{/gist_id}","starred_url":"https://api.github.com/users/TokageItLab/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/TokageItLab/subscriptions","organizations_url":"https://api.github.com/users/TokageItLab/orgs","repos_url":"https://api.github.com/users/TokageItLab/repos","events_url":"https://api.github.com/users/TokageItLab/events{/privacy}","received_events_url":"https://api.github.com/users/TokageItLab/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-11-09T23:07:29Z","updated_at":"2025-11-09T23:23:45Z","body":"@ryevdokimov If https://github.com/godotengine/godot/pull/104233 is implemented and **that option is enabled**, the current 4th gizmo behavior is correct. Conversely, after implementing https://github.com/godotengine/godot/pull/104233 and that option is enabled, the y rotation in the above video should follow the current 4th gizmo's behavior.\r\n\r\nHowever, since https://github.com/godotengine/godot/pull/104233 is currently disabled in this PR, so the y rotation is correct and the 4th gizmo's movement is incorrect now. This PR must be fixed assuming that option https://github.com/godotengine/godot/pull/104233 is disabled.\r\n\r\nSo if we implement https://github.com/godotengine/godot/pull/104233, you should reintroduce the current 4th gizmo behavior as the optional behavior when that option is enabled.\r\n\r\n> Right now, local mode just means transform each node relative to its own local coordinates, and the 4th gizmo is always facing the camera, so it effectively behaves as a global transform.\r\n\r\nIn other words, we must select the ring's normal as the rotation axis in the Local coordinate. \r\n\r\n<img width=\"291\" height=\"250\" alt=\"image\" src=\"https://github.com/user-attachments/assets/4cd6eb1e-372e-4d08-a9ef-7218b127b4ff\" />\r\n\r\nIn the above case, the rotation axis for the 4th gizmo and the y rotation gizmo are differed.\r\n\r\n<img width=\"247\" height=\"264\" alt=\"image\" src=\"https://github.com/user-attachments/assets/338c58c1-31f4-44ee-a084-3c6133860660\" />\r\n\r\nHowever, in the above case, the rotation axis for the 4th gizmo and the y rotation gizmo must be the same.\r\n\r\nAs long as option #104233 is disabled, that axis must be treated as a local rotation axis for each node. The current behavior always treats the 4th gizmo as the global rotation axis, so it is wrong for the behavior when #104233 is disabled.\r\n","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3508923512/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3508951263","html_url":"https://github.com/godotengine/godot/pull/108608#issuecomment-3508951263","issue_url":"https://api.github.com/repos/godotengine/godot/issues/108608","id":3508951263,"node_id":"IC_kwDOAO6SJc7RJljf","user":{"login":"ryevdokimov","id":105675984,"node_id":"U_kgDOBkx80A","avatar_url":"https://avatars.githubusercontent.com/u/105675984?v=4","gravatar_id":"","url":"https://api.github.com/users/ryevdokimov","html_url":"https://github.com/ryevdokimov","followers_url":"https://api.github.com/users/ryevdokimov/followers","following_url":"https://api.github.com/users/ryevdokimov/following{/other_user}","gists_url":"https://api.github.com/users/ryevdokimov/gists{/gist_id}","starred_url":"https://api.github.com/users/ryevdokimov/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/ryevdokimov/subscriptions","organizations_url":"https://api.github.com/users/ryevdokimov/orgs","repos_url":"https://api.github.com/users/ryevdokimov/repos","events_url":"https://api.github.com/users/ryevdokimov/events{/privacy}","received_events_url":"https://api.github.com/users/ryevdokimov/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-11-09T23:39:07Z","updated_at":"2025-11-09T23:39:07Z","body":">If https://github.com/godotengine/godot/pull/104233 is implemented and that option is enabled, the current 4th gizmo behavior is correct.\r\n\r\nAh yes, that makes sense actually, so the converse of that is what clarifies it.\r\n\r\nIt's just a little confusing because I interpreted the correct behavior as how each node should behave as if it were selected individually in local mode, but when put in that context and if the other PR gets merged what you're saying is the correct way to differentiate the behavior between the two modes, and without that PR the default should be as if it were off. \r\n\r\nThanks for the explanation. \r\n\r\n","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3508951263/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3509107582","html_url":"https://github.com/godotengine/godot/pull/108608#issuecomment-3509107582","issue_url":"https://api.github.com/repos/godotengine/godot/issues/108608","id":3509107582,"node_id":"IC_kwDOAO6SJc7RKLt-","user":{"login":"ryevdokimov","id":105675984,"node_id":"U_kgDOBkx80A","avatar_url":"https://avatars.githubusercontent.com/u/105675984?v=4","gravatar_id":"","url":"https://api.github.com/users/ryevdokimov","html_url":"https://github.com/ryevdokimov","followers_url":"https://api.github.com/users/ryevdokimov/followers","following_url":"https://api.github.com/users/ryevdokimov/following{/other_user}","gists_url":"https://api.github.com/users/ryevdokimov/gists{/gist_id}","starred_url":"https://api.github.com/users/ryevdokimov/starred{/owner}{/repo}