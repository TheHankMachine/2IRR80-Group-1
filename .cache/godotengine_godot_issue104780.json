st_id}","starred_url":"https://api.github.com/users/Sauermann/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Sauermann/subscriptions","organizations_url":"https://api.github.com/users/Sauermann/orgs","repos_url":"https://api.github.com/users/Sauermann/repos","events_url":"https://api.github.com/users/Sauermann/events{/privacy}","received_events_url":"https://api.github.com/users/Sauermann/received_events","type":"User","user_view_type":"public","site_admin":false},"open_issues":3,"closed_issues":3687,"state":"closed","created_at":"2024-12-19T08:51:28Z","updated_at":"2026-09-04T21:48:38Z","due_on":"2025-09-15T00:00:00Z","closed_at":"2025-09-18T17:13:14Z"},"comments":1,"created_at":"2025-03-29T22:14:52Z","updated_at":"2025-04-10T08:36:07Z","closed_at":"2025-04-09T23:18:11Z","assignee":null,"author_association":"MEMBER","issue_field_values":[],"type":null,"active_lock_reason":null,"draft":false,"pull_request":{"url":"https://api.github.com/repos/godotengine/godot/pulls/104780","html_url":"https://github.com/godotengine/godot/pull/104780","diff_url":"https://github.com/godotengine/godot/pull/104780.diff","patch_url":"https://github.com/godotengine/godot/pull/104780.patch","merged_at":"2025-04-09T23:18:10Z"},"body":"The Icosa Gallery team is working on building a Godot plugin for downloading 3D models. A large amount of their collection is composed of old glTF 2.0 files converted from OBJ or from glTF 1.0, and some of these files are just straight up invalid. Godot should show an error when this is the case, and ideally try to import the file anyway.\r\n\r\nReproduction 3D model: [fox.zip](https://github.com/user-attachments/files/19523164/fox.zip)\r\n\r\nIn master: The file fails to import its mesh, and only exists as a set of nodes without any visuals. No errors or warnings are printed informing the user of why it failed to import.\r\n\r\nWith this PR: The file imports \"correctly\", and prints error messages explaining that the file is invalid:\r\n\r\n<img width=\"1300\" alt=\"Screenshot 2025-03-29 at 3 09 24 PM\" src=\"https://github.com/user-attachments/assets/0f6180a0-e6cb-4c97-be2a-b0897e8adafc\" />\r\n\r\n(the reason \"correctly\" is in quotes is because the file is invalid, so really, who's to say what is correct? but I think everyone will agree that this is a better result)","closed_by":{"login":"Repiteo","id":17489292,"node_id":"MDQ6VXNlcjE3NDg5Mjky","avatar_url":"https://avatars.githubusercontent.com/u/17489292?v=4","gravatar_id":"","url":"https://api.github.com/users/Repiteo","html_url":"https://github.com/Repiteo","followers_url":"https://api.github.com/users/Repiteo/followers","following_url":"https://api.github.com/users/Repiteo/following{/other_user}","gists_url":"https://api.github.com/users/Repiteo/gists{/gist_id}","starred_url":"https://api.github.com/users/Repiteo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Repiteo/subscriptions","organizations_url":"https://api.github.com/users/Repiteo/orgs","repos_url":"https://api.github.com/users/Repiteo/repos","events_url":"https://api.github.com/users/Repiteo/events{/privacy}","received_events_url":"https://api.github.com/users/Repiteo/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/104780/reactions","total_count":6,"+1":6,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/godotengine/godot/issues/104780/timeline","performed_via_github_app":null,"state_reason":null}