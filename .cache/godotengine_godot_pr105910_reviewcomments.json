pull/105910#discussion_r2067444053"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/105910"}},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/2067444053/reactions","total_count":1,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":1,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":226,"original_line":226,"side":"RIGHT","in_reply_to_id":2067414194,"author_association":"MEMBER","original_position":16,"position":16,"subject_type":"line"},{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/2068528107","pull_request_review_id":2806827565,"id":2068528107,"node_id":"PRRC_kwDOAO6SJc57Szvr","diff_hunk":"@@ -243,3 +250,27 @@ Variant _GLOBAL_DEF(const PropertyInfo &p_info, const Variant &p_default, bool p\n #define GLOBAL_DEF_RST_NOVAL_BASIC(m_var, m_value) _GLOBAL_DEF(m_var, m_value, true, true, true)\n \n #define GLOBAL_DEF_INTERNAL(m_var, m_value) _GLOBAL_DEF(m_var, m_value, false, false, false, true)\n+\n+/////////////////////////////////////////////////////////////////////////////////////////\n+// Cached versions of GLOBAL_GET.\n+// Cached but uses a typed variable for storage, this can be more efficient.\n+// N.B. Variables are prefixed with _ggc_ because compiler is set to report\n+// shadowed variable names outside the lambda.","path":"core/config/project_settings.h","commit_id":"f8f350a32a1ebf4114cef6b4b6224089e0abaf74","original_commit_id":"e5ca2c1154835f90d74c062ef36cd71a8ff35410","user":{"login":"Ivorforce","id":2308167,"node_id":"MDQ6VXNlcjIzMDgxNjc=","avatar_url":"https://avatars.githubusercontent.com/u/2308167?v=4","gravatar_id":"","url":"https://api.github.com/users/Ivorforce","html_url":"https://github.com/Ivorforce","followers_url":"https://api.github.com/users/Ivorforce/followers","following_url":"https://api.github.com/users/Ivorforce/following{/other_user}","gists_url":"https://api.github.com/users/Ivorforce/gists{/gist_id}","sta