r\n\r\n3. Press the \"Play\" button to run the project.\r\n\r\n4. Observe the screen behavior: a black screen appears momentarily, and then the editor reloads without running the project.\n\n### Minimal reproduction project (MRP)\n\n[testnew.zip](https://github.com/user-attachments/files/17812874/testnew.zip)\r\n","closed_by":{"login":"syntaxerror247","id":176927541,"node_id":"U_kgDOCouzNQ","avatar_url":"https://avatars.githubusercontent.com/u/176927541?v=4","gravatar_id":"","url":"https://api.github.com/users/syntaxerror247","html_url":"https://github.com/syntaxerror247","followers_url":"https://api.github.com/users/syntaxerror247/followers","following_url":"https://api.github.com/users/syntaxerror247/following{/other_user}","gists_url":"https://api.github.com/users/syntaxerror247/gists{/gist_id}","starred_url":"https://api.github.com/users/syntaxerror247/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/syntaxerror247/subscriptions","organizations_url":"https://api.github.com/users/syntaxerror247/orgs","repos_url":"https://api.github.com/users/syntaxerror247/repos","events_url":"https://api.github.com/users/syntaxerror247/events{/privacy}","received_events_url":"https://api.github.com/users/syntaxerror247/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/99421/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/godotengine/godot/issues/99421/timeline","performed_via_github_app":null,"state_reason":"duplicate","pinned_comment":null}