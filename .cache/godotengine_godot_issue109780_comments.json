[{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3201348819","html_url":"https://github.com/godotengine/godot/issues/109780#issuecomment-3201348819","issue_url":"https://api.github.com/repos/godotengine/godot/issues/109780","id":3201348819,"node_id":"IC_kwDOAO6SJc6-0LTT","user":{"login":"AThousandShips","id":96648715,"node_id":"U_kgDOBcK-Cw","avatar_url":"https://avatars.githubusercontent.com/u/96648715?v=4","gravatar_id":"","url":"https://api.github.com/users/AThousandShips","html_url":"https://github.com/AThousandShips","followers_url":"https://api.github.com/users/AThousandShips/followers","following_url":"https://api.github.com/users/AThousandShips/following{/other_user}","gists_url":"https://api.github.com/users/AThousandShips/gists{/gist_id}","starred_url":"https://api.github.com/users/AThousandShips/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/AThousandShips/subscriptions","organizations_url":"https://api.github.com/users/AThousandShips/orgs","repos_url":"https://api.github.com/users/AThousandShips/repos","events_url":"https://api.github.com/users/AThousandShips/events{/privacy}","received_events_url":"https://api.github.com/users/AThousandShips/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-08-19T16:05:20Z","updated_at":"2025-08-19T16:05:20Z","body":"Generally the the saving process will display the error in the log, that information isn't trivial to get out of the error log and into the message though, so that's going to have to be achieved by some other means\n\nIf the error isn't available in the log that's more critical I'd say","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3201348819/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godo