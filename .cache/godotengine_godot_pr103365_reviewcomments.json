nvasItemEditor::_gui_input_hover` and `CanvasItemEditor::_gui_input_select`)\r\n\r\nBasically, this function only ever gets called by `CanvasItemEditor` which I believe the user does not have access to.","created_at":"2025-04-15T12:43:15Z","updated_at":"2025-04-15T12:43:15Z","html_url":"https://github.com/godotengine/godot/pull/103365#discussion_r2044440673","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/103365","_links":{"self":{"href":"https://api.github.com/repos/godotengine/godot/pulls/comments/2044440673"},"html":{"href":"https://github.com/godotengine/godot/pull/103365#discussion_r2044440673"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/103365"}},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/2044440673/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":969,"original_line":955,"side":"RIGHT","in_reply_to_id":2042988779,"author_association":"CONTRIBUTOR","original_position":4,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/2044677455","pull_request_review_id":2768493942,"id":2044677455,"node_id":"PRRC_kwDOAO6SJc55301P","diff_hunk":"@@ -952,6 +952,8 @@ class RenderingServerDefault : public RenderingServer {\n \n \tFUNC2(canvas_item_set_visibility_layer, RID, uint32_t)\n \n+\tFUNC1R(uint32_t, canvas_item_get_z_render, RID)","path":"servers/rendering/rendering_server_default.h","commit_id":"953563e4804b1720fad8dd0587c95bd18f48ccba","original_commit_id":"8f50404ac6903662bcb7d23252c23bef801d49e2","user":{"login":"TheSofox","id":3089525,"node_id":"MDQ6VXNlcjMwODk1MjU=","avatar_url":"https://avatars.githubusercontent.com/u/3089525?v=4","gravatar_id":"","url":"https://api.github.com/users/TheSofox","html_url":"https://github.com/TheSofox","followers_url":"https://api.github.com/users/TheSofox/foll