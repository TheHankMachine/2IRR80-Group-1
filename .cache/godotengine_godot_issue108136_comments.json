ub.com/repos/godotengine/godot/issues/108136","id":3018698867,"node_id":"IC_kwDOAO6SJc6z7bBz","user":{"login":"AThousandShips","id":96648715,"node_id":"U_kgDOBcK-Cw","avatar_url":"https://avatars.githubusercontent.com/u/96648715?v=4","gravatar_id":"","url":"https://api.github.com/users/AThousandShips","html_url":"https://github.com/AThousandShips","followers_url":"https://api.github.com/users/AThousandShips/followers","following_url":"https://api.github.com/users/AThousandShips/following{/other_user}","gists_url":"https://api.github.com/users/AThousandShips/gists{/gist_id}","starred_url":"https://api.github.com/users/AThousandShips/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/AThousandShips/subscriptions","organizations_url":"https://api.github.com/users/AThousandShips/orgs","repos_url":"https://api.github.com/users/AThousandShips/repos","events_url":"https://api.github.com/users/AThousandShips/events{/privacy}","received_events_url":"https://api.github.com/users/AThousandShips/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-06-30T10:54:31Z","updated_at":"2025-06-30T10:54:31Z","body":"Make sure to update your example with the correct procedure to test this","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3018698867/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3019084298","html_url":"https://github.com/godotengine/godot/issues/108136#issuecomment-3019084298","issue_url":"https://api.github.com/repos/godotengine/godot/issues/108136","id":3019084298,"node_id":"IC_kwDOAO6SJc6z85IK","user":{"login":"shiena","id":1295639,"node_id":"MDQ6VXNlcjEyOTU2Mzk=","avatar_url":"https://avatars.githubusercontent.com/u/1295639?v=4","gravatar_id":"","url":"