.com/madebydavid","followers_url":"https://api.github.com/users/madebydavid/followers","following_url":"https://api.github.com/users/madebydavid/following{/other_user}","gists_url":"https://api.github.com/users/madebydavid/gists{/gist_id}","starred_url":"https://api.github.com/users/madebydavid/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/madebydavid/subscriptions","organizations_url":"https://api.github.com/users/madebydavid/orgs","repos_url":"https://api.github.com/users/madebydavid/repos","events_url":"https://api.github.com/users/madebydavid/events{/privacy}","received_events_url":"https://api.github.com/users/madebydavid/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-07-01T08:32:11Z","updated_at":"2025-07-01T08:32:11Z","body":"@shiena - your demo project works well for me on v4.5.beta1.official.46c495ca2 even without root priviledges, but my minimal demo does not work in the same conditions. I will try to find a difference.","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3022634690/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3022725666","html_url":"https://github.com/godotengine/godot/issues/108136#issuecomment-3022725666","issue_url":"https://api.github.com/repos/godotengine/godot/issues/108136","id":3022725666,"node_id":"IC_kwDOAO6SJc60KyIi","user":{"login":"shiena","id":1295639,"node_id":"MDQ6VXNlcjEyOTU2Mzk=","avatar_url":"https://avatars.githubusercontent.com/u/1295639?v=4","gravatar_id":"","url":"https://api.github.com/users/shiena","html_url":"https://github.com/shiena","followers_url":"https://api.github.com/users/shiena/followers","following_url":"https://api.github.com/users/shiena/following{/other_user}","gists_url":"https://api.github.com/users/shiena/gists{/gist_id}","starred_url":"https://api.github.com/users/shiena/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/shiena/subscriptions","organizations_url":"https://api.github.com/users/shiena/orgs","repos_url":"https://api.github.com/users/shiena/repos","events_url":"https://api.github.com/users/shiena/events{/privacy}","received_events_url":"https://api.github.com/users/shiena/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-07-01T08:45:05Z","updated_at":"2025-07-01T08:45:05Z","body":"@madebydavid \nThere was a simpler method than `CameraTexture`. After `CameraServer.monitoring_feeds = true`, wait for 1 frame with `await get_tree().process_frame`. This should allow you to acquire the camera device.","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3022725666/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3022756018","html_url":"https://github.com/godotengine/godot/issues/108136#issuecomment-3022756018","issue_url":"https://api.github.com/repos/godotengine/godot/issues/108136","id":3022756018,"node_id":"IC_kwDOAO6SJc60K5iy","user":{"login":"shiena","id":1295639,"node_id":"MDQ6VXNlcjEyOTU2Mzk=","avatar_url":"https://avatars.githubusercontent.com/u/1295639?v=4","gravatar_id":"","url":"https://api.github.com/users/shiena","html_url":"https://github.com/shiena","followers_url":"https://api.github.com/users/shiena/followers","following_url":"https://api.github.com/users/shiena/following{/other_user}","gists_url":"https://api.github.com/users/shiena/gists{/gist_id}","starred_url":"https://api.github.com/users/shiena/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/shiena/subscriptions","organizations_url":"https://api.github.com/users/shiena/orgs","repos_url":"https://api.github.com/users/shiena/repos","events_url":"https://api.github.com/users/shiena/events{/privacy}","received_events_url":"https://api.github.com/users/shiena/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-07-01T08:50:24Z","updated_at":"2025-07-01T08:50:24Z","body":"Alternatively, it also works by delaying with `call_deferred()`.\n\n```gdscript\nfunc _ready():\n\tCameraServer.monitoring_feeds = true\n\t_camera_list.call_deferred()\n\nfunc _camera_list():\n\tfor feed in CameraServer.feeds():\n\t\tname = feed.get_name()\n\t\tprint(name)\n\t\tfeed.feed_is_active = true\n\t\tif camera == null and name == camera_name:\n\t\t\tcamera = feed\n\n\tif camera == null:\n\t\tprint(\"no camera found\")\n\t\treturn\n```","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3022756018/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3022817731","html_url":"https://github.com/godotengine/godot/issues/108136#issuecomment-3022817731","issue_url":"https://api.github.com/repos/godotengine/godot/issues/108136","id":3022817731,"node_id":"IC_kwDOAO6SJc60LInD","user":{"login":"madebydavid","id":5401249,"node_id":"MDQ6VXNlcjU0MDEyNDk=","avatar_url":"https://avatars.githubusercontent.com/u/5401249?v=4","gravatar_id":"","url":"https://api.github.com/users/madebydavid","html_url":"https://github.com/madebydavid","followers_url":"https://api.github.com/users/madebydavid/followers","following_url":"https://api.github.com/users/madebydavid/following{/other_user}","gists_url":"https://api.github.com/users/madebydavid/gists{/gist_id}","starred_url":"https://api.github.com/users/madebydavid/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/madebydavid/subscriptions","organizations_url":"https://api.github.com/users/madebydavid/orgs","repos_url":"https://api.github.com/users/madebydavid/repos","events_url":"https://api.github.com/users/madebydavid/events{/privacy}","received_events_url":"https://api.github.com/users/madebydavid/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-07-01T09:02:21Z","updated_at":"2025-07-01T09:02:21Z","body":"@shiena - that's neat and works perfectly. Thank you very much for your assistance.\n\nFor anyone who finds this in the future (and possibly me, when I forget) - you need to wait at least 1 frame after setting `CameraServer.monitoring_feeds = true` before calling `CameraServer.feeds()`.\n","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3022817731/reactions","total_count":2,"+1":0,"-1":0,"laugh":0,"hooray":2,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3022917513","html_url":"https://github.com/godotengine/godot/issues/108136#issuecomment-3022917513","issue_url":"https://api.github.com/repos/godotengine/godot/issues/108136","id":3022917513,"node_id":"IC_kwDOAO6SJc60Lg-J","user":{"login":"AThousandShips","id":96648715,"node_id":"U_kgDOBcK-Cw","avatar_url":"https://avatars.githubusercontent.com/u/96648715?v=4","gravatar_id":"","url":"https://api.github.com/users/AThousandShips","html_url":"https://github.com/AThousandShips","followers_url":"https://api.github.com/users/AThousandShips/followers","following_url":"https://api.github.com/users/AThousandShips/following{/other_user}","gists_url":"https://api.github.com/users/AThousandShips/gists{/gist_id}","starred_url":"https://api.github.com/users/AThousandShips/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/AThousandShips/subscriptions","organizations_url":"https://api.github.com/users/AThousandShips/orgs","repos_url":"https://api.github.com/users/AThousandShips/repos","events_url":"https://api.github.com/users/AThousandShips/events{/privacy}","received_events_url":"https://api.github.com/users/AThousandShips/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-07-01T09:20:51Z","updated_at":"2025-07-01T09:21:17Z","body":"Let's reopen this to look into documenting the needed delay, as it's not obvious ","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3022917513/reactions","total_count":2,"+1":2,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null}]