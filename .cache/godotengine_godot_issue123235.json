_at":null,"archived_by":null}],"state":"open","locked":false,"assignees":[],"milestone":{"url":"https://api.github.com/repos/godotengine/godot/milestones/25","html_url":"https://github.com/godotengine/godot/milestone/25","labels_url":"https://api.github.com/repos/godotengine/godot/milestones/25/labels","id":15520464,"node_id":"MI_kwDOAO6SJc4A7NLQ","number":25,"title":"4.8","description":"","creator":{"login":"Repiteo","id":17489292,"node_id":"MDQ6VXNlcjE3NDg5Mjky","avatar_url":"https://avatars.githubusercontent.com/u/17489292?v=4","gravatar_id":"","url":"https://api.github.com/users/Repiteo","html_url":"https://github.com/Repiteo","followers_url":"https://api.github.com/users/Repiteo/followers","following_url":"https://api.github.com/users/Repiteo/following{/other_user}","gists_url":"https://api.github.com/users/Repiteo/gists{/gist_id}","starred_url":"https://api.github.com/users/Repiteo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Repiteo/subscriptions","organizations_url":"https://api.github.com/users/Repiteo/orgs","repos_url":"https://api.github.com/users/Repiteo/repos","events_url":"https://api.github.com/users/Repiteo/events{/privacy}","received_events_url":"https://api.github.com/users/Repiteo/received_events","type":"User","user_view_type":"public","site_admin":false},"open_issues":345,"closed_issues":2335,"state":"open","created_at":"2026-04-13T15:59:35Z","updated_at":"2026-10-22T08:15:08Z","due_on":null,"closed_at":null},"comments":0,"created_at":"2026-09-05T23:04:56Z","updated_at":"2026-09-12T17:40:08Z","closed_at":null,"assignee":null,"author_association":"MEMBER","issue_field_values":[],"type":null,"active_lock_reason":null,"draft":false,"pull_request":{"url":"https://api.github.com/repos/godotengine/godot/pulls/123235","html_url":"https://github.com/godotengine/godot/pull/123235","diff_url":"https://github.com/godotengine/godot/pull/123235.diff","patch_url":"https://github.com/godotengine/godot/pull/123235.patch","merged_at":null},"body":"## What problem(s) does this PR solve?\r\n\r\nLocalVector uses `uint32_t` for size. When subtracting 1, this can lead to undefined behavior if the size is 0:\r\n\r\n> scene/main/viewport.cpp:2701:15: runtime error: implicit conversion from type 'unsigned int' of value 4294967295 (32-bit, unsigned) to type 'int' changed the value to -1 (32-bit, signed)\r\nSUMMARY: UndefinedBehaviorSanitizer: undefined-behavior scene/main/viewport.cpp:2701:15 in \r\n> scene/main/viewport.cpp:3391:17: runtime error: implicit conversion from type 'unsigned int' of value 4294967295 (32-bit, unsigned) to type 'int' changed the value to -1 (32-bit, signed)\r\nSUMMARY: UndefinedBehaviorSanitizer: undefined-behavior scene/main/viewport.cpp:3391:17 in \r\n\r\n## Additional information\r\n\r\nI used AI by copy-pasting Godot sanitizer errors to it and telling it to fix them. Then, I am investigating each manually, and submitting PRs when I am confident of the fix. For this one, it's a pretty straightforward a fix.\r\n\r\nThe sanitizer caught the cases in Viewport, but I also had an AI investigate every usage of LocalVector's size function throughout the codebase - it found only 3 additional sites where bugs can occur out of hundreds of candidates. It could be argued that every case of `size` that leads to being assigned into a signed variable should have an explicit cast, but for this PR I am just including the ones that will cause undefined behavior when the cast is missing.","closed_by":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/123235/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/godotengine/godot/issues/123235/timeline","performed_via_github_app":null,"state_reason":null}