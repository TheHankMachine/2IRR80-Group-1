ived_at":null,"archived_by":null},{"id":1609442062,"node_id":"MDU6TGFiZWwxNjA5NDQyMDYy","url":"https://api.github.com/repos/godotengine/godot/labels/topic:shaders","name":"topic:shaders","color":"ffee88","default":false,"description":"","archived_at":null,"archived_by":null}],"state":"closed","locked":false,"assignees":[],"milestone":{"url":"https://api.github.com/repos/godotengine/godot/milestones/23","html_url":"https://github.com/godotengine/godot/milestone/23","labels_url":"https://api.github.com/repos/godotengine/godot/milestones/23/labels","id":12939969,"node_id":"MI_kwDOAO6SJc4AxXLB","number":23,"title":"4.6","description":"","creator":{"login":"Repiteo","id":17489292,"node_id":"MDQ6VXNlcjE3NDg5Mjky","avatar_url":"https://avatars.githubusercontent.com/u/17489292?v=4","gravatar_id":"","url":"https://api.github.com/users/Repiteo","html_url":"https://github.com/Repiteo","followers_url":"https://api.github.com/users/Repiteo/followers","following_url":"https://api.github.com/users/Repiteo/following{/other_user}","gists_url":"https://api.github.com/users/Repiteo/gists{/gist_id}","starred_url":"https://api.github.com/users/Repiteo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Repiteo/subscriptions","organizations_url":"https://api.github.com/users/Repiteo/orgs","repos_url":"https://api.github.com/users/Repiteo/repos","events_url":"https://api.github.com/users/Repiteo/events{/privacy}","received_events_url":"https://api.github.com/users/Repiteo/received_events","type":"User","user_view_type":"public","site_admin":false},"open_issues":3,"closed_issues":2978,"state":"closed","created_at":"2025-05-22T16:25:52Z","updated_at":"2026-10-04T16:23:23Z","due_on":null,"closed_at":"2026-01-26T18:09:14Z"},"comments":2,"created_at":"2025-08-27T01:41:31Z","updated_at":"2025-10-27T17:13:06Z","closed_at":"2025-10-27T15:06:22Z","assignee":null,"author_association":"MEMBER","issue_field_values":[],"type":null,"active_lock_reason":null,"draft":false,"pull_request":{"url":"https://api.github.com/repos/godotengine/godot/pulls/109999","html_url":"https://github.com/godotengine/godot/pull/109999","diff_url":"https://github.com/godotengine/godot/pull/109999.diff","patch_url":"https://github.com/godotengine/godot/pull/109999.patch","merged_at":"2025-10-27T15:06:21Z"},"body":"This PR has some misc cleanups, such as renaming and organizing things. This is a prerequisite cleanup to PR #64596, I'm opening a separate PR for this change so it can be reviewed and merged in advance of the rest, making the changes in PR #64596 smaller and easier to read later.\r\n\r\n* In `shader.h` and `shader_types.cpp`, add comments noting that those need to be kept in sync. EDIT: And also add a DEV_ASSERT to ensure that they are kept in sync as @Calinou suggested.\r\n* In `ShaderEditorPlugin::edit`, rename `si` to `shader_include`, rename `s` to `shader`, add some comments, and check that the object trying to be edited is actually a shader.\r\n* In `ShaderEditorPlugin::_switch_to_editor`, check for null being passed. This will matter once it's possible for shader languages to arbitrarily plug into here, to avoid crashing if those languages have an error.\r\n* In `ShaderEditorPlugin::_make_script_list_context_menu`, make the validation language-agnostic.\r\n* In `ShaderCreateDialog::_validate_path`, rename `p` to `stripped_file_path`, rename `extension` to `file_extension`, and cache the shader type data in a `current_type_data` variable instead of re-getting it every time.\r\n* In `ShaderCreateDialog::_update_language_info`, give `.tres` a higher priority than `.res`, and avoid repeating the non-default-extension parts.\r\n* Move `ShaderCreateDialog` code to get the type icons into a new `_refresh_type_icons` function, and make it language-agnostic. The motivation behind this change is to avoid hard dependencies on specific types, and also to allow re-running this logic later, such as if shader languages are registered later on.\r\n\r\nThe new `_refresh_type_icons` also fixes a bug where the ShaderInclude icon already present in the engine just wasn't being used by the dialog for some reason. Before, in master:\r\n\r\n<img width=\"400\" height=\"221\" alt=\"Screenshot 2025-08-26 at 6 21 58 PM\" src=\"https://github.com/user-attachments/assets/1f46199a-86c6-408b-8fcc-028b0ddc3b5a\" />\r\n\r\nAfter, with this PR:\r\n\r\n<img width=\"400\" height=\"221\" alt=\"Screenshot 2025-08-26 at 6 26 17 PM\" src=\"https://github.com/user-attachments/assets/212655dc-fe1f-4efb-b207-999ddd816eb7\" />\r\n","closed_by":{"login":"Repiteo","id":17489292,"node_id":"MDQ6VXNlcjE3NDg5Mjky","avatar_url":"https://avatars.githubusercontent.com/u/17489292?v=4","gravatar_id":"","url":"https://api.github.com/users/Repiteo","html_url":"https://github.com/Repiteo","followers_url":"https://api.github.com/users/Repiteo/followers","following_url":"https://api.github.com/users/Repiteo/following{/other_user}","gists_url":"https://api.github.com/users/Repiteo/gists{/gist_id}","starred_url":"https://api.github.com/users/Repiteo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Repiteo/subscriptions","organizations_url":"https://api.github.com/users/Repiteo/orgs","repos_url":"https://api.github.com/users/Repiteo/repos","events_url":"https://api.github.com/users/Repiteo/events{/privacy}","received_events_url":"https://api.github.com/users/Repiteo/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/109999/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/godotengine/godot/issues/109999/timeline","performed_via_github_app":null,"state_reason":null}