odotengine/godot/issues/100570*","closed_by":{"login":"adriano-sudario","id":13634034,"node_id":"MDQ6VXNlcjEzNjM0MDM0","avatar_url":"https://avatars.githubusercontent.com/u/13634034?v=4","gravatar_id":"","url":"https://api.github.com/users/adriano-sudario","html_url":"https://github.com/adriano-sudario","followers_url":"https://api.github.com/users/adriano-sudario/followers","following_url":"https://api.github.com/users/adriano-sudario/following{/other_user}","gists_url":"https://api.github.com/users/adriano-sudario/gists{/gist_id}","starred_url":"https://api.github.com/users/adriano-sudario/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/adriano-sudario/subscriptions","organizations_url":"https://api.github.com/users/adriano-sudario/orgs","repos_url":"https://api.github.com/users/adriano-sudario/repos","events_url":"https://api.github.com/users/adriano-sudario/events{/privacy}","received_events_url":"https://api.github.com/users/adriano-sudario/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/100292/reactions","total_count":2,"+1":2,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/godotengine/godot/issues/100292/timeline","performed_via_github_app":null,"state_reason":null}