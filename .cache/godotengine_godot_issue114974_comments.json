[{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3753037477","html_url":"https://github.com/godotengine/godot/issues/114974#issuecomment-3753037477","issue_url":"https://api.github.com/repos/godotengine/godot/issues/114974","id":3753037477,"node_id":"IC_kwDOAO6SJc7fss6l","user":{"login":"kaluluosi","id":1620585,"node_id":"MDQ6VXNlcjE2MjA1ODU=","avatar_url":"https://avatars.githubusercontent.com/u/1620585?v=4","gravatar_id":"","url":"https://api.github.com/users/kaluluosi","html_url":"https://github.com/kaluluosi","followers_url":"https://api.github.com/users/kaluluosi/followers","following_url":"https://api.github.com/users/kaluluosi/following{/other_user}","gists_url":"https://api.github.com/users/kaluluosi/gists{/gist_id}","starred_url":"https://api.github.com/users/kaluluosi/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/kaluluosi/subscriptions","organizations_url":"https://api.github.com/users/kaluluosi/orgs","repos_url":"https://api.github.com/users/kaluluosi/repos","events_url":"https://api.github.com/users/kaluluosi/events{/privacy}","received_events_url":"https://api.github.com/users/kaluluosi/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-01-15T06:05:53Z","updated_at":"2026-01-15T06:05:53Z","body":"Or perhaps I shouldn't directly tween the direct child nodes in the container; instead, I should wrap these Items with a Control node and tween the Items under the Control?","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3753037477/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3756730249","html_url":"https://github.com/godotengine/godot/issues/114974#issuecomment-3756730249","issue_url":"https://api.github.com/repos/godotengine/godot/issues/114974","id":3756730249,"node_id":"IC_kwDOAO6SJc7f6yeJ","user":{"login":"DevMimas","id":44207756,"node_id":"MDQ6VXNlcjQ0MjA3NzU2","avatar_url":"https://avatars.githubusercontent.com/u/44207756?v=4","gravatar_id":"","url":"https://api.github.com/users/DevMimas","html_url":"https://github.com/DevMimas","followers_url":"https://api.github.com/users/DevMimas/followers","following_url":"https://api.github.com/users/DevMimas/following{/other_user}","gists_url":"https://api.github.com/users/DevMimas/gists{/gist_id}","starred_url":"https://api.github.com/users/DevMimas/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/DevMimas/subscriptions","organizations_url":"https://api.github.com/users/DevMimas/orgs","repos_url":"https://api.github.com/users/DevMimas/repos","events_url":"https://api.github.com/users/DevMimas/events{/privacy}","received_events_url":"https://api.github.com/users/DevMimas/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-01-15T20:28:47Z","updated_at":"2026-01-15T20:28:47Z","body":"This is probably not a bug in the container. Containers have the property of aligning all child objects according to the container rules. Whether centred, vertical, horizontal, etc. ... With each child object added, the position setting is triggered again. This could then lead to strange behaviour... But I'm not sure.\n\nYou could put the elements in a control node (not a container) and animate the elements with Tween (from left to right). That's definitely easier. Or you could build a custom container for the child objects according to your preferences and animate the alignment.","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3756730249/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null}]