default":false,"description":"","archived_at":null,"archived_by":null},{"id":3240950060,"node_id":"MDU6TGFiZWwzMjQwOTUwMDYw","url":"https://api.github.com/repos/godotengine/godot/labels/performance","name":"performance","color":"447777","default":false,"description":"","archived_at":null,"archived_by":null}],"state":"closed","locked":false,"assignees":[],"milestone":{"url":"https://api.github.com/repos/godotengine/godot/milestones/25","html_url":"https://github.com/godotengine/godot/milestone/25","labels_url":"https://api.github.com/repos/godotengine/godot/milestones/25/labels","id":15520464,"node_id":"MI_kwDOAO6SJc4A7NLQ","number":25,"title":"4.8","description":"","creator":{"login":"Repiteo","id":17489292,"node_id":"MDQ6VXNlcjE3NDg5Mjky","avatar_url":"https://avatars.githubusercontent.com/u/17489292?v=4","gravatar_id":"","url":"https://api.github.com/users/Repiteo","html_url":"https://github.com/Repiteo","followers_url":"https://api.github.com/users/Repiteo/followers","following_url":"https://api.github.com/users/Repiteo/following{/other_user}","gists_url":"https://api.github.com/users/Repiteo/gists{/gist_id}","starred_url":"https://api.github.com/users/Repiteo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Repiteo/subscriptions","organizations_url":"https://api.github.com/users/Repiteo/orgs","repos_url":"https://api.github.com/users/Repiteo/repos","events_url":"https://api.github.com/users/Repiteo/events{/privacy}","received_events_url":"https://api.github.com/users/Repiteo/received_events","type":"User","user_view_type":"public","site_admin":false},"open_issues":343,"closed_issues":2335,"state":"open","created_at":"2026-04-13T15:59:35Z","updated_at":"2026-10-22T06:28:22Z","due_on":null,"closed_at":null},"comments":5,"created_at":"2026-07-05T09:57:10Z","updated_at":"2026-07-14T17:41:56Z","closed_at":"2026-07-14T17:02:13Z","assignee":null,"author_association":"CONTRIBUTOR","issue_field_values":[],"type":null,"active_lock_reason":null,"draft":false,"pull_request":{"url":"https://api.github.com/repos/godotengine/godot/pulls/120958","html_url":"https://github.com/godotengine/godot/pull/120958","diff_url":"https://github.com/godotengine/godot/pull/120958.diff","patch_url":"https://github.com/godotengine/godot/pull/120958.patch","merged_at":"2026-07-14T17:02:13Z"},"body":"## Requires https://github.com/godotengine/godot/pull/121367 to be merged first.\r\n\r\n## What problem(s) does this PR solve?\r\n\r\n- FIXME in `editor/project_manager/project_list.cpp` (added in https://github.com/godotengine/godot/pull/104845)\r\nhttps://github.com/godotengine/godot/blob/a3fc1cbcfb88e59935194b2a873f32789656125f/editor/project_manager/project_list.cpp#L664-L667\r\n\r\n- Not optimal performance, as mentioned in the called function:\r\nhttps://github.com/godotengine/godot/blob/a3fc1cbcfb88e59935194b2a873f32789656125f/editor/project_manager/project_list.cpp#L932-L934\r\n\r\n## Overview\r\n\r\nCreated a new function `ProjectList::_update_project_control_translation(const Item &item)`, which updates the translations of a specific project list item. When the notification `NOTIFICATION_TRANSLATION_CHANGED` is recieved, it loops over every item and calls it.\r\n\r\n## Profiling data\r\n\r\nI was testing on my setup (50 projects).\r\n\r\n`ProjectList::_notification(NOTIFICATION_TRANSLATION_CHANGED)` went from `73 ms` to `0.5 ms`\r\n`EditorSettings::get_singleton()->set(LANGUAGE)` (propagates the notification) went from `172 ms` to `87 ms`\r\n\r\nNote that results may vary, especially in the second one, as I only did a few runs.\r\n\r\n## Additional information\r\n\r\nThis adds some code duplication, but I think that the benefit is worth it.\r\n\r\nAI was NOT used.\r\n\r\nRelated: https://github.com/godotengine/godot/pull/120646","closed_by":{"login":"Repiteo","id":17489292,"node_id":"MDQ6VXNlcjE3NDg5Mjky","avatar_url":"https://avatars.githubusercontent.com/u/17489292?v=4","gravatar_id":"","url":"https://api.github.com/users/Repiteo","html_url":"https://github.com/Repiteo","followers_url":"https://api.github.com/users/Repiteo/followers","following_url":"https://api.github.com/users/Repiteo/following{/other_user}","gists_url":"https://api.github.com/users/Repiteo/gists{/gist_id}","starred_url":"https://api.github.com/users/Repiteo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Repiteo/subscriptions","organizations_url":"https://api.github.com/users/Repiteo/orgs","repos_url":"https://api.github.com/users/Repiteo/repos","events_url":"https://api.github.com/users/Repiteo/events{/privacy}","received_events_url":"https://api.github.com/users/Repiteo/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/120958/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/godotengine/godot/issues/120958/timeline","performed_via_github_app":null,"state_reason":null}