he git commands and in finding the right file locations.\r\n\r\n<!--\r\nProvide additional information and explanation of your PR, including areas that you are uncertain of or require special attention from reviewers. For examples, please read our pull request guidelines: https://contributing.godotengine.org/en/latest/pull_requests/pull_request_guidelines.html#explain-your-contributions\r\n-->\r\n","closed_by":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/122401/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/godotengine/godot/issues/122401/timeline","performed_via_github_app":null,"state_reason":null}