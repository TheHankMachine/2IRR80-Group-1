:0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3159995709","html_url":"https://github.com/godotengine/godot/pull/109340#issuecomment-3159995709","issue_url":"https://api.github.com/repos/godotengine/godot/issues/109340","id":3159995709,"node_id":"IC_kwDOAO6SJc68WbU9","user":{"login":"m4gr3d","id":914968,"node_id":"MDQ6VXNlcjkxNDk2OA==","avatar_url":"https://avatars.githubusercontent.com/u/914968?v=4","gravatar_id":"","url":"https://api.github.com/users/m4gr3d","html_url":"https://github.com/m4gr3d","followers_url":"https://api.github.com/users/m4gr3d/followers","following_url":"https://api.github.com/users/m4gr3d/following{/other_user}","gists_url":"https://api.github.com/users/m4gr3d/gists{/gist_id}","starred_url":"https://api.github.com/users/m4gr3d/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/m4gr3d/subscriptions","organizations_url":"https://api.github.com/users/m4gr3d/orgs","repos_url":"https://api.github.com/users/m4gr3d/repos","events_url":"https://api.github.com/users/m4gr3d/events{/privacy}","received_events_url":"https://api.github.com/users/m4gr3d/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-08-06T12:37:51Z","updated_at":"2025-08-06T12:37:51Z","body":"Similar set of changes may also be needed for `DirectoryAccessHandler` since it's the directory counterpart of `FileAccessHandler`","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3159995709/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3160863828","html_url":"https://github.com/godotengine/godot/pull/109340#issuecomment-3160863828","issue_url":"https://api.github.com/repos/godotengine/godot/issues/109340","id":3160863828,"node_id":"IC_kwDOAO6SJc68ZvRU","user":{"login":"h1v9","id":17818610,"node_id":"MDQ6VXNlcjE3ODE4NjEw","avatar_url":"https://avatars.githubusercontent.com/u/17818610?v=4","gravatar_id":"","url":"https://api.github.com/users/h1v9","html_url":"https://github.com/h1v9","followers_url":"https://api.github.com/users/h1v9/followers","following_url":"https://api.github.com/users/h1v9/following{/other_user}","gists_url":"https://api.github.com/users/h1v9/gists{/gist_id}","starred_url":"https://api.github.com/users/h1v9/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/h1v9/subscriptions","organizations_url":"https://api.github.com/users/h1v9/orgs","repos_url":"https://api.github.com/users/h1v9/repos","events_url":"https://api.github.com/users/h1v9/events{/privacy}","received_events_url":"https://api.github.com/users/h1v9/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-08-06T16:43:33Z","updated_at":"2025-08-06T16:44:48Z","body":"Done and squashed.\r\nI tested it on my project and still works with no problems.\r\n\r\nInstead of adding locks on `DirectoryAccessHandler` I added them on its \"dependencies\"","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3160863828/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3162535600","html_url":"https://github.com/godotengine/godot/pull/109340#issuecomment-3162535600","issue_url":"https://api.github.com/repos/godotengine/godot/issues/109340","id":3162535600,"node_id":"IC_kwDOAO6SJc68gHaw","user":{"login":"m4gr3d","id":914968,"node_id":"MDQ6VXNlcjkxNDk2OA==","avatar_url":"https://avatars.githubusercontent.com/u/914968?v=4","gravatar_id":"","url":"https://api.github.com/users/m4gr3d","html_url":"https://github.com/m4gr3d","followers_url":"https://api.github.com/users/m4gr3d/followers","following_url":"https://api.github.com/users/m4gr3d/following{/other_user}","gists_url":"https://api.github.com/users/m4gr3d/gists{/gist_id}","starred_url":"https://api.github.com/users/m4gr3d/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/m4gr3d/subscriptions","organizations_url":"https://api.github.com/users/m4gr3d/orgs","repos_url":"https://api.github.com/users/m4gr3d/repos","events_url":"https://api.github.com/users/m4gr3d/events{/privacy}","received_events_url":"https://api.github.com/users/m4gr3d/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-08-07T05:25:04Z","updated_at":"2025-08-07T05:25:04Z","body":"> Done and squashed. I tested it on my project and still works with no problems.\r\n\r\nThanks for the update! \r\n\r\n\r\n> Instead of adding locks on `DirectoryAccessHandler` I added them on its \"dependencies\"\r\n\r\nWhy take that approach? The 'dependencies' have `internal` scope so they're not publicly exposed, and this approach would also require any new 'dependency' to also be sprinkled with locks.\r\nInstead the locks should be applied to `DirectoryAccessHandler` since it mediates access to the dependencies.\r\n\r\nFor both `DirectoryAccessHandler` and `FileAccessHandler`, the locks should be restricted to the public methods, and just wrap the entire method. `private` and `internal` methods will be under the locking scope of the public methods making use of them and thus don't need their own lock.\r\n\r\n","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3162535600/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3163504567","html_url":"https://github.com/godotengine/godot/pull/109340#issuecomment-3163504567","issue_url":"https://api.github.com/repos/godotengine/godot/issues/109340","id":3163504567,"node_id":"IC_kwDOAO6SJc68jz-3","user":{"login":"h1v9","id":17818610,"node_id":"MDQ6VXNlcjE3ODE4NjEw","avatar_url":"https://avatars.githubusercontent.com/u/17818610?v=4","gravatar_id":"","url":"https://api.github.com/users/h1v9","html_url":"https://github.com/h1v9","followers_url":"https://api.github.com/users/h1v9/followers","following_url":"https://api.github.com/users/h1v9/following{/other_user}","gists_url":"https://api.github.com/users/h1v9/gists{/gist_id}","starred_url":"https://api.github.com/users/h1v9/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/h1v9/subscriptions","organizations_url":"https://api.github.com/users/h1v9/orgs","repos_url":"https://api.github.com/users/h1v9/repos","events_url":"https://api.github.com/users/h1v9/events{/privacy}","received_events_url":"https://api.github.com/users/h1v9/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-08-07T10:29:46Z","updated_at":"2025-08-07T10:29:56Z","body":"> Why take that approach? \r\n\r\nI asummed those classes had other users.\r\nAnyway I changed it in the way you requested. Tested and still working fine\r\n","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3163504567/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3164568272","html_url":"https://github.com/godotengine/godot/pull/109340#issuecomment-3164568272","issue_url":"https://api.github.com/repos/godotengine/godot/issues/109340","id":3164568272,"node_id":"IC_kwDOAO6SJc68n3rQ","user":{"login":"m4gr3d","id":914968,"node_id":"MDQ6VXNlcjkxNDk2OA==","avatar_url":"https://avatars.githubusercontent.com/u/914968?v=4","gravatar_id":"","url":"https://api.github.com/users/m4gr3d","html_url":"https://github.com/m4gr3d","followers_url":"https://api.github.com/users/m4gr3d/followers","following_url":"https://api.github.com/users/m4gr3d/following{/other_user}","gists_url":"https://api.github.com/users/m4gr3d/gists{/gist_id}","starred_url":"https://api.github.com/users/m4gr3d/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/m4gr3d/subscriptions","organizations_url":"https://api.github.com/users/m4gr3d/orgs","repos_url":"https://api.github.com/users/m4gr3d/repos","events_url":"https://api.github.com/users/m4gr3d/events{/privacy}","received_events_url":"https://api.github.com/users/m4gr3d/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-08-07T15:02:06Z","updated_at":"2025-08-07T15:02:06Z","body":"> I asummed those classes had other users. Anyway I changed it in the way you requested. Tested and still working fine\r\n\r\nThe classes are meant to be implementation details for the various type of files / directories that Android provides. So in general, all access should be mediated via the handlers, which then redirect to the right implementation.\r\n\r\n`FileAccessHandler` does something similar with the `DataAccess` abstract class and its various subtypes.","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3164568272/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3164754350","html_url":"https://github.com/godotengine/godot/pull/109340#issuecomment-3164754350","issue_url":"https://api.github.com/repos/godotengine/godot/issues/109340","id":3164754350,"node_id":"IC_kwDOAO6SJc68olGu","user"