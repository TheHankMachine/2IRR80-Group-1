/akien-mga/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/akien-mga/subscriptions","organizations_url":"https://api.github.com/users/akien-mga/orgs","repos_url":"https://api.github.com/users/akien-mga/repos","events_url":"https://api.github.com/users/akien-mga/events{/privacy}","received_events_url":"https://api.github.com/users/akien-mga/received_events","type":"User","user_view_type":"public","site_admin":false},"open_issues":3,"closed_issues":2535,"state":"closed","created_at":"2025-11-27T20:29:18Z","updated_at":"2026-10-20T18:39:31Z","due_on":null,"closed_at":"2026-06-19T16:54:35Z"},"comments":2,"created_at":"2026-05-10T06:43:03Z","updated_at":"2026-05-11T16:12:56Z","closed_at":"2026-05-11T16:12:56Z","assignee":{"login":"hpvb","id":2591099,"node_id":"MDQ6VXNlcjI1OTEwOTk=","avatar_url":"https://avatars.githubusercontent.com/u/2591099?v=4","gravatar_id":"","url":"https://api.github.com/users/hpvb","html_url":"https://github.com/hpvb","followers_url":"https://api.github.com/users/hpvb/followers","following_url":"https://api.github.com/users/hpvb/following{/other_user}","gists_url":"https://api.github.com/users/hpvb/gists{/gist_id}","starred_url":"https://api.github.com/users/hpvb/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/hpvb/subscriptions","organizations_url":"https://api.github.com/users/hpvb/orgs","repos_url":"https://api.github.com/users/hpvb/repos","events_url":"https://api.github.com/users/hpvb/events{/privacy}","received_events_url":"https://api.github.com/users/hpvb/received_events","type":"User","user_view_type":"public","site_admin":false},"author_association":"CONTRIBUTOR","issue_field_values":[],"type":null,"active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"### Tested versions\n\nReproducible in:\nCurrent main branch\nv4.7.custom [bc192293b13a8891cb8739a36d8c0736a5c4c4b8]\n\nNot reproducible in:\nv4.7.beta1.official [1c8cc9e7e]\nv4.7.dev3.official [60fff00a6]\nv4.6.stable.official [89cea1439]\n\n### System information\n\nGodot v4.7.beta1 - Windows 10 (build 19045) - Multi-window, 1 monitor - OpenGL 3 (Compatibility) - NVIDIA GeForce GTX 1060 3GB (NVIDIA; 32.0.15.8180) - Intel(R) Core(TM) i5-6400 CPU @ 2.70GHz (4 threads) - 15.95 GiB memory - WASAPI (48000 Hz, Stereo/mono)\n\n### Issue description\n\nI've noticed that my game loads levels instantly if I load the same level. I've tested it a bit and yeah, the engine seems to never unload resources once they have been loaded using the threaded loading functions. Very recent regression\n\n```gdscript\nextends Control\n\nfunc loadThreaded(_path:String) -> Resource:\n\tif(ResourceLoader.has_cached(_path)):\n\t\treturn ResourceLoader.load(_path)\n\t\n\tvar err:= ResourceLoader.load_threaded_request(_path)\n\tif(err != OK):\n\t\tprinterr(\"ERROR! \"+error_string(err))\n\t\treturn null\n\t\n\tvar loadStatus := ResourceLoader.load_threaded_get_status(_path)\n\twhile(loadStatus == ResourceLoader.THREAD_LOAD_IN_PROGRESS):\n\t\tawait get_tree().process_frame\n\t\tloadStatus = ResourceLoader.load_threaded_get_status(_path)\n\t\n\tif(loadStatus != ResourceLoader.THREAD_LOAD_LOADED):\n\t\tprinterr(\"FAILED TO LOAD! loadStatus=\"+str(loadStatus))\n\t\treturn null\n\t\n\treturn ResourceLoader.load_threaded_get(_path)\n\nfunc _on_load_threaded_button_pressed() -> void:\n\t$TextureRect.texture = await loadThreaded(\"res://icon.svg\")\n\nfunc _on_load_normal_button_pressed() -> void:\n\t$TextureRect.texture = load(\"res://icon.svg\") # Works fine\n\nfunc _on_unload_button_pressed() -> void:\n\t$TextureRect.texture = null\n\nfunc _process(_delta: float) -> void:\n\t$Label.text = \"Has cached: \"+str(ResourceLoader.has_cached(\"res://icon.svg\"))\n\n```\n\n### Steps to reproduce\n\nhttps://github.com/user-attachments/assets/3cacdda5-51b7-48a4-9f07-062f32a3e677\n\n1. Load anything using the threaded resource loader functions\n2. Try to unload it (set the variable that holds the resource to null)\n3. The resource is still 'cached'\n\nor just use the MRP\n\n### Minimal reproduction project (MRP)\n\n[threadedunloadbug_2026-05-10_09-32-12.zip](https://github.com/user-attachments/files/27563597/threadedunloadbug_2026-05-10_09-32-12.zip)","closed_by":{"login":"Repiteo","id":17489292,"node_id":"MDQ6VXNlcjE3NDg5Mjky","avatar_url":"https://avatars.githubusercontent.com/u/17489292?v=4","gravatar_id":"","url":"https://api.github.com/users/Repiteo","html_url":"https://github.com/Repiteo","followers_url":"https://api.github.com/users/Repiteo/followers","following_url":"https://api.github.com/users/Repiteo/following{/other_user}","gists_url":"https://api.github.com/users/Repiteo/gists{/gist_id}","starred_url":"https://api.github.com/users/Repiteo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Repiteo/subscriptions","organizations_url":"https://api.github.com/users/Repiteo/orgs","repos_url":"https://api.github.com/users/Repiteo/repos","events_url":"https://api.github.com/users/Repiteo/events{/privacy}","received_events_url":"https://api.github.com/users/Repiteo/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/119374/reactions","total_count":1,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":1},"timeline_url":"https://api.github.com/repos/godotengine/godot/issues/119374/timeline","performed_via_github_app":null,"state_reason":"completed","pinned_comment":null}