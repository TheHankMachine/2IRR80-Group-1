n and alt-tab icon.\n\n### Minimal reproduction project (MRP)\n\nAny project will do; I've used https://github.com/godotengine/godot-demo-projects/tree/master/3d/tonemap_color_correction for testing.","closed_by":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/106967/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/godotengine/godot/issues/106967/timeline","performed_via_github_app":null,"state_reason":null,"pinned_comment":null}