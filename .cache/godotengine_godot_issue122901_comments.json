nERROR: This render pipeline requires (0) bytes of push constant data, supplied: (96)\nERROR: No render pipeline was set before attempting to draw.\n```\n\nSame workaround applies on-device: `renderer/rendering_method.mobile=\"gl_compatibility\"` renders correctly over OpenXR GLES on the same headset with zero errors (session FOCUSED, both controllers tracked, 90 Hz).","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5446223758/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5449917397","html_url":"https://github.com/godotengine/godot/issues/122901#issuecomment-5449917397","issue_url":"https://api.github.com/repos/godotengine/godot/issues/122901","id":5449917397,"node_id":"IC_kwDOAO6SJc8AAAABRNcj1Q","user":{"login":"AThousandShips","id":96648715,"node_id":"U_kgDOBcK-Cw","avatar_url":"https://avatars.githubusercontent.com/u/96648715?v=4","gravatar_id":"","url":"https://api.github.com/users/AThousandShips","html_url":"https://github.com/AThousandShips","followers_url":"https://api.github.com/users/AThousandShips/followers","following_url":"https://api.github.com/users/AThousandShips/following{/other_user}","gists_url":"https://api.github.com/users/AThousandShips/gists{/gist_id}","starred_url":"https://api.github.com/users/AThousandShips/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/AThousandShips/subscriptions","organizations_url":"https://api.github.com/users/AThousandShips/orgs","repos_url":"https://api.github.com/users/AThousandShips/repos","events_url":"https://api.github.com/users/AThousandShips/events{/privacy}","received_events_url":"https://api.github.com/users/AThousandShips/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-08-28T07:51:48Z