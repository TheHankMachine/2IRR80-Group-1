scription":"","archived_at":null,"archived_by":null},{"id":279098255,"node_id":"MDU6TGFiZWwyNzkwOTgyNTU=","url":"https://api.github.com/repos/godotengine/godot/labels/topic:platforms","name":"topic:platforms","color":"ffee88","default":false,"description":"","archived_at":null,"archived_by":null},{"id":1332303119,"node_id":"MDU6TGFiZWwxMzMyMzAzMTE5","url":"https://api.github.com/repos/godotengine/godot/labels/regression","name":"regression","color":"ff63ac","default":false,"description":"","archived_at":null,"archived_by":null}],"state":"closed","locked":false,"assignees":[],"milestone":{"url":"https://api.github.com/repos/godotengine/godot/milestones/25","html_url":"https://github.com/godotengine/godot/milestone/25","labels_url":"https://api.github.com/repos/godotengine/godot/milestones/25/labels","id":15520464,"node_id":"MI_kwDOAO6SJc4A7NLQ","number":25,"title":"4.8","description":"","creator":{"login":"Repiteo","id":17489292,"node_id":"MDQ6VXNlcjE3NDg5Mjky","avatar_url":"https://avatars.githubusercontent.com/u/17489292?v=4","gravatar_id":"","url":"https://api.github.com/users/Repiteo","html_url":"https://github.com/Repiteo","followers_url":"https://api.github.com/users/Repiteo/followers","following_url":"https://api.github.com/users/Repiteo/following{/other_user}","gists_url":"https://api.github.com/users/Repiteo/gists{/gist_id}","starred_url":"https://api.github.com/users/Repiteo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Repiteo/subscriptions","organizations_url":"https://api.github.com/users/Repiteo/orgs","repos_url":"https://api.github.com/users/Repiteo/repos","events_url":"https://api.github.com/users/Repiteo/events{/privacy}","received_events_url":"https://api.github.com/users/Repiteo/received_events","type":"User","user_view_type":"public","site_admin":false},"open_issues":343,"closed_issues":2335,"state":"open","created_at":"2026-04-13T15:59:35Z","updated_at":"2026-10-22T06:28:22Z","due_on":null,"closed_at":null},"comments":7,"created_at":"2026-07-03T14:57:38Z","updated_at":"2026-10-09T10:04:25Z","closed_at":"2026-10-09T10:04:08Z","assignee":null,"author_association":"NONE","issue_field_values":[],"type":null,"active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"### Tested versions\n\n- Reproducible from: v4.7.dev1.official [bf95b6258], v4.7.stable.official [5b4e0cb0f] to v4.7.1.rc1.official [17e2686e0].\n- Not reproducible in: v4.6.3.stable.official [7d41c59c4].\n\n\n### System information\n\nmacOS Ventura (13.7.8) - Multi-window, 1 monitor - integrated Intel(R) Iris(TM) Plus Graphics 640 - Intel(R) Core(TM) i5-7360U CPU @ 2.30GHz (4 threads) - 8.00 GiB memory\n\n### Issue description\n\n# Godot editor opens to a black screen in 4.7x on macOS on intel when rendering from Mobile & Forward+\n\nOn macOS on intel, the Godot editor (never the project manager) and any windows subsequently created from it open to a black screen when creating a new project with the Mobile and Forwad+ renderers in 4.7x; when creating a new project with the Compatibility renderer, the editor functions fully as and intended.\n\nIn Godot 4.6.3 editor, the Compatibility, Mobile and Forward+ renderers all work—creating and opening projects with any one of them functions fully and as intended.\n\nI've tested this on the following releases of Godot, using a 13-inch, 2017 MacBook Pro with a 2,3 GHz Dual-Core Intel Core i5 processor, Intel Iris Plus Graphics 640 1536 MB integrated graphics, 8 GB of 2133 MHz LPDDR3 memory, running macOS Ventura 13.7.8 (22H730):\n\n- Reproducible from: v4.7.dev1.official [bf95b6258], v4.7.stable.official [5b4e0cb0f] to v4.7.1.rc1.official [17e2686e0].\n- Not reproducible in: v4.6.3.stable.official [7d41c59c4].\n\n<img width=\"1792\" height=\"1162\" alt=\"Image\" src=\"https://github.com/user-attachments/assets/1de29f60-2fa6-47f1-be29-89cd7b277332\" />\n<img width=\"1751\" height=\"1118\" alt=\"Image\" src=\"https://github.com/user-attachments/assets/d1bdb505-50f7-413b-a279-24a653a436cd\" />\n\n### Steps to reproduce\n\nTry creating a new project in any one release of Godot 4.7, either with the Mobile or Compatibility renderers, on an Mac with an intel CPU and integrated graphics.\n\n### Minimal reproduction project (MRP)\n\nThis issue is prevalent on all releases of Godot 4.7 starting from v4.7.dev1.official [bf95b6258]. ","closed_by":{"login":"AThousandShips","id":96648715,"node_id":"U_kgDOBcK-Cw","avatar_url":"https://avatars.githubusercontent.com/u/96648715?v=4","gravatar_id":"","url":"https://api.github.com/users/AThousandShips","html_url":"https://github.com/AThousandShips","followers_url":"https://api.github.com/users/AThousandShips/followers","following_url":"https://api.github.com/users/AThousandShips/following{/other_user}","gists_url":"https://api.github.com/users/AThousandShips/gists{/gist_id}","starred_url":"https://api.github.com/users/AThousandShips/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/AThousandShips/subscriptions","organizations_url":"https://api.github.com/users/AThousandShips/orgs","repos_url":"https://api.github.com/users/AThousandShips/repos","events_url":"https://api.github.com/users/AThousandShips/events{/privacy}","received_events_url":"https://api.github.com/users/AThousandShips/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/120897/reactions","total_count":3,"+1":3,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/godotengine/godot/issues/120897/timeline","performed_via_github_app":null,"state_reason":"completed","pinned_comment":null}