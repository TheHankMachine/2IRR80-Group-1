l":"https://api.github.com/users/TCROC/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-02-14T23:31:52Z","updated_at":"2025-02-14T23:31:52Z","body":"But then you would have to crawl the project for everything that references the visual shader... maybe not the best approach after all... unless of course Godot has a handy project database that makes these kind of lookups efficient?","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2660476689/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2660833485","html_url":"https://github.com/godotengine/godot/issues/101375#issuecomment-2660833485","issue_url":"https://api.github.com/repos/godotengine/godot/issues/101375","id":2660833485,"node_id":"IC_kwDOAO6SJc6emRjN","user":{"login":"QbieShay","id":7917475,"node_id":"MDQ6VXNlcjc5MTc0NzU=","avatar_url":"https://avatars.githubusercontent.com/u/7917475?v=4","gravatar_id":"","url":"https://api.github.com/users/QbieShay","html_url":"https://github.com/QbieShay","followers_url":"https://api.github.com/users/QbieShay/followers","following_url":"https://api.github.com/users/QbieShay/following{/other_user}","gists_url":"https://api.github.com/users/QbieShay/gists{/gist_id}","starred_url":"https://api.github.com/users/QbieShay/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/QbieShay/subscriptions","organizations_url":"https://api.github.com/users/QbieShay/orgs","repos_url":"https://api.github.com/users/QbieShay/repos","events_url":"https://api.github.com/users/QbieShay/events{/privacy}","received_events_url":"https://api.github.com/users/QbieShay/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-02-15T09:14:58Z","updated_at":"2025-02-15T09:14:58Z","body":"I think trying to convert a Visual shader with an embedded texture should fail and throw an error. Later, we should remove the option entirely to have embedded textures in shaders. Shaders aren't materials, and I think Unity's and Unreals' paradigm of mering the two isn't a good one","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2660833485/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2660847464","html_url":"https://github.com/godotengine/godot/issues/101375#issuecomment-2660847464","issue_url":"https://api.github.com/repos/godotengine/godot/issues/101375","id":2660847464,"node_id":"IC_kwDOAO6SJc6emU9o","user":{"login":"beicause","id":75941842,"node_id":"MDQ6VXNlcjc1OTQxODQy","avatar_url":"https://avatars.githubusercontent.com/u/75941842?v=4","gravatar_id":"","url":"https://api.github.com/users/beicause","html_url":"https://github.com/beicause","followers_url":"https://api.github.com/users/beicause/followers","following_url":"https://api.github.com/users/beicause/following{/other_user}","gists_url":"https://api.github.com/users/beicause/gists{/gist_id}","starred_url":"https://api.github.com/users/beicause/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/beicause/subscriptions","organizations_url":"https://api.github.com/users/beicause/orgs","repos_url":"https://api.github.com/users/beicause/repos","events_url":"https://api.github.com/users/beicause/events{/privacy}","received_events_url":"https://api.github.com/users/beicause/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-02-15T09:52:21Z","updated_at":"2025-02-15T09:52:21Z","body":"> I think trying to convert a Visual shader with an embedded texture should fail and throw an error. Later, we should remove the option entirely to have embedded textures in shaders. Shaders aren't materials, and I think Unity's and Unreals' paradigm of mering the two isn't a good one\n\nEmbeding resources in VisualShader can be useful for previewing, and it can also process resources that can't directly used in shader parameter, for example VisualShaderNodeParticleMeshEmitter contains Mesh.","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2660847464/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2660888173","html_url":"https://github.com/godotengine/godot/issues/101375#issuecomment-2660888173","issue_url":"https://api.github.com/repos/godotengine/godot/issues/101375","id":2660888173,"node_id":"IC_kwDOAO6SJc6eme5t","user":{"login":"QbieShay","id":7917475,"node_id":"MDQ6VXNlcjc5MTc0NzU=","avatar_url":"https://avatars.githubusercontent.com/u/7917475?v=4","gravatar_id":"","url":"https://api.github.com/users/QbieShay","html_url":"https://github.com/QbieShay","followers_url":"https://api.github.com/users/QbieShay/followers","following_url":"https://api.github.com/users/QbieShay/following{/other_user}","gists_url":"https://api.github.com/users/QbieShay/gists{/gist_id}","starred_url":"https://api.github.com/users/QbieShay/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/QbieShay/subscriptions","organizations_url":"https://api.github.com/users/QbieShay/orgs","repos_url":"https://api.github.com/users/QbieShay/repos","events_url":"https://api.github.com/users/QbieShay/events{/privacy}","received_events_url":"https://api.github.com/users/QbieShay/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-02-15T11:55:38Z","updated_at":"2025-02-15T11:55:38Z","body":"That's separate issues though. They are useful _now_ because of how things are implemented, but those things can be improved to not be dependent on embedded resources in visual shaders.","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2660888173/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2660947468","html_url":"https://github.com/godotengine/godot/issues/101375#issuecomment-2660947468","issue_url":"https://api.github.com/repos/godotengine/godot/issues/101375","id":2660947468,"node_id":"IC_kwDOAO6SJc6emtYM","user":{"login":"TCROC","id":24307049,"node_id":"MDQ6VXNlcjI0MzA3MDQ5","avatar_url":"https://avatars.githubusercontent.com/u/24307049?v=4","gravatar_id":"","url":"https://api.github.com/users/TCROC","html_url":"https://github.com/TCROC","followers_url":"https://api.github.com/users/TCROC/followers","following_url":"https://api.github.com/users/TCROC/following{/other_user}","gists_url":"https://api.github.com/users/TCROC/gists{/gist_id}","starred_url":"https://api.github.com/users/TCROC/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/TCROC/subscriptions","organizations_url":"https://api.github.com/users/TCROC/orgs","repos_url":"https://api.github.com/users/TCROC/repos","events_url":"https://api.github.com/users/TCROC/events{/privacy}","received_events_url":"https://api.github.com/users/TCROC/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-02-15T14:28:02Z","updated_at":"2025-02-15T14:28:02Z","body":"@QbieShay \n\n> That's separate issues though. They are useful now because of how things are implemented, but those things can be improved to not be dependent on embedded resources in visual shaders.\n\nAh I see what you are saying.  Make VisualShader follow the same rules as Shader in regards to allowing / disallowing subresources.  This then fixes the conversion problem by removing the problem altogether.\n\n@beicause \n> Embeding resources in VisualShader can be useful for previewing\n\nI can see an exceptionally useful feature proposal coming from this idea.  A feature to \"preview\" the value of **ANY** parameter in the VisualShader would be exceptionally useful.  But  yes I agree, this is a separate issue.  If you open a separate issue / feature proposal for this, feel free to @ me :)","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2660947468/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2661239869","html_url":"https://github.com/godotengine/godot/issues/101375#issuecomment-2661239869","issue_url":"https://api.github.com/repos/godotengine/godot/issues/101375","id":2661239869,"node_id":"IC_kwDOAO6SJc6en0w9","user":{"login":"beicause","id":75941842,"node_id":"MDQ6VXNlcjc1OTQxODQy","avatar_url":"https://avatars.githubusercontent.com/u/75941842?v=4","gravatar_id":"","url":"https://api.github.com/users/beicause","html_url":"https://github.com/beicause","followers_url":"https://api.github.com/users/beicause/followers","following_url":"https://api.github.com/users/beicause/following{/other_user}","gists_url":"https://api.github.com/users/beicause/gists{/gist_id}","starred_url":"https://api.github.com/users/beicause/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/beicause/subscriptions","organizations_url":"https://api.github.com/users/beicause/orgs","repos_url":"https://api.github.com/users/beicause/repos","events_url":"https://api.github.com/users/beicause/events{/privacy}","received_events_url":"https://api.github.com/users/beicause/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-02-16T04:31:17Z","updated_at":"2025-02-16T04:31:17Z","body":"I have no idea how to improve it. Welcome others with ideas to open proposals :)","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2661239869/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null}]