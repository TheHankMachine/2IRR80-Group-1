[{"id":2754886719,"node_id":"PRR_kwDOAO6SJc6kNDw_","user":{"login":"Calinou","id":180032,"node_id":"MDQ6VXNlcjE4MDAzMg==","avatar_url":"https://avatars.githubusercontent.com/u/180032?u=68d23e7ee9cdf810da125e8510b72f845b9dccc8&v=4","gravatar_id":"","url":"https://api.github.com/users/Calinou","html_url":"https://github.com/Calinou","followers_url":"https://api.github.com/users/Calinou/followers","following_url":"https://api.github.com/users/Calinou/following{/other_user}","gists_url":"https://api.github.com/users/Calinou/gists{/gist_id}","starred_url":"https://api.github.com/users/Calinou/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Calinou/subscriptions","organizations_url":"https://api.github.com/users/Calinou/orgs","repos_url":"https://api.github.com/users/Calinou/repos","events_url":"https://api.github.com/users/Calinou/events{/privacy}","received_events_url":"https://api.github.com/users/Calinou/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"Tested locally on Linux, it works as expected.\r\n\r\nOne consequence of this change is that using `timeout` to run the editor will no longer result in a recovery dialog the next time you open the project, as it sends `SIGTERM` by default. This will still happen if you use `timeout --signal KILL` though, as `SIGKILL` prevents running Godot's normal shutdown code (and therefore the lines added by this PR). I think this makes sense.","state":"APPROVED","html_url":"https://github.com/godotengine/godot/pull/103805#pullrequestreview-2754886719","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/103805","author_association":"MEMBER","_links":{"html":{"href":"https://github.com/godotengine/godot/pull/103805#pullrequestreview-2754886719"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/103805"}},"submitted_at":"2025-04-09T21:52:31Z","commit_id":"d7766827418c668368a99f5b34d1cd39de132494"}]