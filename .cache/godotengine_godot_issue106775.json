:null,"archived_by":null}],"state":"closed","locked":false,"assignees":[],"milestone":{"url":"https://api.github.com/repos/godotengine/godot/milestones/22","html_url":"https://github.com/godotengine/godot/milestone/22","labels_url":"https://api.github.com/repos/godotengine/godot/milestones/22/labels","id":12070367,"node_id":"MI_kwDOAO6SJc4AuC3f","number":22,"title":"4.5","description":"","creator":{"login":"Sauermann","id":6299227,"node_id":"MDQ6VXNlcjYyOTkyMjc=","avatar_url":"https://avatars.githubusercontent.com/u/6299227?v=4","gravatar_id":"","url":"https://api.github.com/users/Sauermann","html_url":"https://github.com/Sauermann","followers_url":"https://api.github.com/users/Sauermann/followers","following_url":"https://api.github.com/users/Sauermann/following{/other_user}","gists_url":"https://api.github.com/users/Sauermann/gists{/gist_id}","starred_url":"https://api.github.com/users/Sauermann/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Sauermann/subscriptions","organizations_url":"https://api.github.com/users/Sauermann/orgs","repos_url":"https://api.github.com/users/Sauermann/repos","events_url":"https://api.github.com/users/Sauermann/events{/privacy}","received_events_url":"https://api.github.com/users/Sauermann/received_events","type":"User","user_view_type":"public","site_admin":false},"open_issues":3,"closed_issues":3687,"state":"closed","created_at":"2024-12-19T08:51:28Z","updated_at":"2026-09-04T21:48:38Z","due_on":"2025-09-15T00:00:00Z","closed_at":"2025-09-18T17:13:14Z"},"comments":4,"created_at":"2025-05-24T15:17:38Z","updated_at":"2025-05-26T16:34:12Z","closed_at":"2025-05-26T16:30:23Z","assignee":null,"author_association":"MEMBER","issue_field_values":[],"type":null,"active_lock_reason":null,"draft":false,"pull_request":{"url":"https://api.github.com/repos/godotengine/godot/pulls/106775","html_url":"https://github.com/godotengine/godot/pull/106775","diff_url":"https://github.com/godotengine/godot/pull/106775.diff","patch_url":"https://github.com/godotengine/godot/pull/106775.patch","merged_at":"2025-05-26T16:30:23Z"},"body":"Expands the recently introduced `GDSOFTCLASS` to cover more functionality.\r\nIn particular, it covers everything that was previously in `GDCLASS` that does not use the `ClassDB`:\r\n\r\n- `_set` and `_get` implementations\r\n- `_validate_property`, `_property_can_revert`, `_property_get_revert` implementations\r\n- `_notification` implementations\r\n\r\nThe following properties stay in `GDCLASS` (i.e. anything that pertains to 'exposed' classes):\r\n\r\n- `get_class_static` and `is_class`, because `GDSOFTCLASS` types are not exposed\r\n- `_get_bind_methods`, `_get_bind_compatibility_methods`, `_get_property_list`, which expose functions and properties\r\n- `initialize_class` and `_class_is_enabled`, which are used to register in `ClassDB`\r\n\r\nThis change is needed to be able to switch more types to use `GDSOFTCLASS` instead of `GDCLASS`. We currently have a lot of classes that use `GDCLASS` even though the type is not intended to be registered in `ClassDB`, possibly leading to incorrect behavior in edge cases (see https://github.com/godotengine/godot/pull/105793#issuecomment-2906876215). \r\n\r\nThe change is purely a cut-and-paste (outside of the added comments).","closed_by":{"login":"Repiteo","id":17489292,"node_id":"MDQ6VXNlcjE3NDg5Mjky","avatar_url":"https://avatars.githubusercontent.com/u/17489292?v=4","gravatar_id":"","url":"https://api.github.com/users/Repiteo","html_url":"https://github.com/Repiteo","followers_url":"https://api.github.com/users/Repiteo/followers","following_url":"https://api.github.com/users/Repiteo/following{/other_user}","gists_url":"https://api.github.com/users/Repiteo/gists{/gist_id}","starred_url":"https://api.github.com/users/Repiteo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Repiteo/subscriptions","organizations_url":"https://api.github.com/users/Repiteo/orgs","repos_url":"https://api.github.com/users/Repiteo/repos","events_url":"https://api.github.com/users/Repiteo/events{/privacy}","received_events_url":"https://api.github.com/users/Repiteo/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/106775/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/godotengine/godot/issues/106775/timeline","performed_via_github_app":null,"state_reason":null}