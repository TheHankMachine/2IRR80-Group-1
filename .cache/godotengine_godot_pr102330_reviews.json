[{"id":2599275683,"node_id":"PRR_kwDOAO6SJc6a7cyj","user":{"login":"Calinou","id":180032,"node_id":"MDQ6VXNlcjE4MDAzMg==","avatar_url":"https://avatars.githubusercontent.com/u/180032?u=68d23e7ee9cdf810da125e8510b72f845b9dccc8&v=4","gravatar_id":"","url":"https://api.github.com/users/Calinou","html_url":"https://github.com/Calinou","followers_url":"https://api.github.com/users/Calinou/followers","following_url":"https://api.github.com/users/Calinou/following{/other_user}","gists_url":"https://api.github.com/users/Calinou/gists{/gist_id}","starred_url":"https://api.github.com/users/Calinou/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Calinou/subscriptions","organizations_url":"https://api.github.com/users/Calinou/orgs","repos_url":"https://api.github.com/users/Calinou/repos","events_url":"https://api.github.com/users/Calinou/events{/privacy}","received_events_url":"https://api.github.com/users/Calinou/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"Tested locally on macOS with Metal, it works as expected.\r\n\r\n**Testing project:** [test_pr_89582.zip](https://github.com/godotengine/godot/files/14856438/test_pr_89582.zip)\r\n*This uses the approach described in https://github.com/godotengine/godot/pull/89582#issuecomment-2004391226 for testing.*\r\n\r\n*Click to view at full size.*\r\n\r\nNo AA | FXAA `master` | FXAA https://github.com/godotengine/godot/pull/89582 | SMAA\r\n-|-|-|-\r\n![No AA](https://github.com/godotengine/godot/assets/180032/bd965666-c6fe-4139-abd9-0b7714fba985) | ![FXAA master](https://github.com/godotengine/godot/assets/180032/a7c8bdbb-54f1-4012-8f4b-6f41a40fc6c9) | ![FXAA PR](https://github.com/godotengine/godot/assets/180032/1c49107e-d3b8-449b-8760-e74f292d316d) | ![SMAA](https://github.com/user-attachments/assets/e01d74ff-ecce-4627-b804-627e34f64f70)\r\n\r\nSMAA does a better job at preserving detail compared to FXAA, while having slightly better edge coverage.\r\n\r\nSMAA is not affected by https://github.com/godotengine/godot/issues/83089 either:\r\n\r\nNo AA | FXAA `master` | SMAA\r\n-|-|-\r\n![image](https://github.com/user-attachments/assets/536eb6d5-c356-4ad2-acd3-0b75a8dc63ce) | ![image](https://github.com/user-attachments/assets/5479ca7b-2d1d-4703-94ab-2346bf429d45) | ![image](https://github.com/user-attachments/assets/3c9b49c4-6a52-4614-ace7-fc009f7c9111)","state":"APPROVED","html_url":"https://github.com/godotengine/godot/pull/102330#pullrequestreview-2599275683","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/102330","author_association":"MEMBER","_links":{"html":{"href":"https://github.com/godotengine/godot/pull/102330#pullrequestreview-2599275683"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/102330"}},"submitted_at":"2025-02-06T16:42:02Z","commit_id":null},{"id":2588605428,"node_id":"PRR_kwDOAO6SJc6aSvv0","user":{"login":"AThousandShips","id":96648715,"node_id":"U_kgDOBcK-Cw","avatar_url":"https://avatars.githubusercontent.com/u/96648715?u=af70f5d107e9c1447f296643d5a566dab53d25e8&v=4","gravatar_id":"","url":"https://api.github.com/users/AThousandShips","html_url":"https://github.com/AThousandShips","followers_url":"https://api.github.com/users/AThousandShips/followers","following_url":"https://api.github.com/users/AThousandShips/following{/other_user}","gists_url":"https://api.github.com/users/AThousandShips/gists{/gist_id}","starred_url":"https://api.github.com/users/AThousandShips/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/AThousandShips/subscriptions","organizations_url":"https://api.github.com/users/AThousandShips/orgs","repos_url":"https://api.github.com/users/AThousandShips/repos","events_url":"https://api.github.com/users/AThousandShips/events{/privacy}","received_events_url":"https://api.github.com/users/AThousandShips/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"","state":"COMMENTED","html_ur