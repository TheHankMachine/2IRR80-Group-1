i.github.com/users/RGDTAB/following{/other_user}","gists_url":"https://api.github.com/users/RGDTAB/gists{/gist_id}","starred_url":"https://api.github.com/users/RGDTAB/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/RGDTAB/subscriptions","organizations_url":"https://api.github.com/users/RGDTAB/orgs","repos_url":"https://api.github.com/users/RGDTAB/repos","events_url":"https://api.github.com/users/RGDTAB/events{/privacy}","received_events_url":"https://api.github.com/users/RGDTAB/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"","state":"COMMENTED","html_url":"https://github.com/godotengine/godot/pull/102330#pullrequestreview-2714654987","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/102330","author_association":"CONTRIBUTOR","_links":{"html":{"href":"https://github.com/godotengine/godot/pull/102330#pullrequestreview-2714654987"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/102330"}},"submitted_at":"2025-03-25T17:46:46Z","commit_id":null},{"id":2714677110,"node_id":"PRR_kwDOAO6SJc6hzq92","user":{"login":"Calinou","id":180032,"node_id":"MDQ6VXNlcjE4MDAzMg==","avatar_url":"https://avatars.githubusercontent.com/u/180032?u=68d23e7ee9cdf810da125e8510b72f845b9dccc8&v=4","gravatar_id":"","url":"https://api.github.com/users/Calinou","html_url":"https://github.com/Calinou","followers_url":"https://api.github.com/users/Calinou/followers","following_url":"https://api.github.com/users/Calinou/following{/other_user}","gists_url":"https://api.github.com/users/Calinou/gists{/gist_id}","starred_url":"https://api.github.com/users/Calinou/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Calinou/subscriptions","organizations_url":"https://api.github.com/users/Calinou/orgs","repos_url":"https://api.github.com/users/Calinou/repos","events_url":"https://api.github.com/users/Calinou/events{/privacy}","received_events_url":"https://api.github.com/users/Calinou/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"Tested locally, it fails to compile:\r\n\r\n```\r\nCompiling core/os/scu/scu_core_os.gen.cpp ...\r\nIn file included from servers/rendering/renderer_rd/effects/scu/scu_servers_rendering_renderer_rd_effects_1.gen.cpp:2:\r\n./servers/rendering/renderer_rd/effects/smaa.cpp: In constructor 'RendererRD::SMAA::SMAA()':\r\n./servers/rendering/renderer_rd/effects/smaa.cpp:126:45: error: 'core_bind' has not been declared\r\n  126 |                 Vector<uint8_t> png_bytes = core_bind::Marshalls::get_singleton()->base64_to_raw(areaTexPNG);\r\n      |                                             ^~~~~~~~~\r\nscons: *** [bin/obj/servers/rendering/renderer_rd/effects/scu/scu_servers_rendering_renderer_rd_effects_1.gen.linuxbsd.editor.x86_64.o] Error 1\r\nscons: building terminated because of errors.\r\nINFO: Time elapsed: 00:01:02.26 \r\n```\r\n\r\nReplacing `core_bind` with `CoreBind` fixes compilation.\r\n\r\nComparison between the [previous state](https://github.com/godotengine/godot/pull/102330#pullrequestreview-2599275683) and the current state of SMAA:\r\n\r\nOld SMAA | Current SMAA\r\n-|-\r\n![Old SMAA](https://github.com/user-attachments/assets/e01d74ff-ecce-4627-b804-627e34f64f70) | ![Current SMAA](https://github.com/user-attachments/assets/4a719f61-280b-459b-84fe-25a75a0165f5)\r\n\r\nIt looks much better now, likely thanks to the edge detection threshold tweak. It's much closer to Tesseract's SMAA implementation:\r\n\r\nCurrent SMAA | Tesseract SMAA\r\n-|-\r\n![Current SMAA](https://github.com/user-attachments/assets/4a719f61-280b-459b-84fe-25a75a0165f5) | ![Tesseract SMAA](https://github.com/user-attachments/assets/57eaeeef-6978-419b-a3ad-29b044d28a9c)","state":"COMMENTED","html_url":"https://github.com/godotengine/godot/pull/102330#pullrequestreview-2714677110","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/102330","author_association":"MEMBER","_links":{"html":{"href":"https://github.com/godotengine/godot/pull/102330#pullrequestreview-2714677110"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/102330"}},"submitted_at":"2025-03-25T17:53:33Z","commit_id":null},{"id":2808806877,"node_id":"PRR_kwDOAO6SJc6nav3d","user":{"login":"Calinou","id":180032,"node_id":"MDQ6VXNlcjE4MDAzMg==","avatar_url":"https://avatars.githubusercontent.com/u/180032?u=68d23e7ee9cdf810da125e8510b72f845b9dccc8&v=4","gravatar_id":"","url":"https://api.github.com/users/Calinou","html_url":"https://github.com/Calinou","followers_url":"https://api.github.com/users/Calinou/followers","following_url":"https://api.github.com/users/Calinou/following{/other_user}","gists_url":"https://api.github.com/users/Calinou/gists{/gist_id}","starred_url":"https://api.github.com/users/Calinou/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Calinou/subscriptions","organizations_url":"https://api.github.com/users/Calinou/orgs","repos_url":"https://api.github.com/users/Calinou/repos","events_url":"https://api.github.com/users/Calinou/events{/privacy}","received_events_url":"https://api.github.com/users/Calinou/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"Tested again, it works as expected on Forward+ only.\r\n\r\nIn Mobile, there's an issue where having SMAA enabled in the project settings has no effect in the running project (you need to change it at runtime for it to work). It will also be visible in the editor. In Forward+, it works on startup correctly. FXAA is also affected by this issue.\r\n\r\nIn Compatibility, there's now an error message printed when you try to enable either SMAA or FXAA (which is expected as neither is implemented there yet). We should probably harmonize these messages to turn them into warnings, but this can be done in a separate PR as there's many of them right now.\r\n\r\nIn the editor, a capitalization for `smaa` to `SMAA` should be added to this list in alphabetical order (as the **SMAA Edge Detection Threshold** project setting would then make use of it):\r\n\r\nhttps://github.com/godotengine/godot/blob/80a3d205f1ad22e779a64921fb56d62b893881ae/editor/editor_property_name_processor.cpp#L138\r\n\r\nAlso, I found a slight binary size optimization using oxipng:\r\n\r\n```\r\n❯ oxipng -Zso6 AreaTex.png SearchTex.png \r\nProcessing: AreaTex.png\r\nProcessing: SearchTex.png\r\n120 bytes (11.76% smaller): SearchTex.png\r\n27091 bytes (7.48% smaller): AreaTex.png\r\n```\r\n\r\nYou can integrate the textures from this ZIP to the PR: [smaa_textures.zip](https://github.com/user-attachments/files/19985156/smaa_textures.zip)\r\n\r\nI made sure fully transparent pixels are not affected this time (oxipng doesn't touch them by default).\r\n\r\n> [!NOTE]\r\n>\r\n> These figures take the above optimization I made into account.\r\n\r\nBinary size comparison for a Linux release export template:\r\n\r\n- `master`: 70,647,752 bytes\r\n- This PR: 70,713,320 bytes\r\n\r\nBinary size comparison for a web release export template:\r\n\r\n- `master`: 37,222,703 bytes\r\n- This PR: 37,225,000 bytes\r\n\r\nIt's only a 3 KB difference, but the web platform only includes the Compatibility rendering method, so this is expected.","state":"COMMENTED","html_url":"https://github.com/godotengine/godot/pull/102330#pullrequestreview-2808806877","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/102330","author_association":"MEMBER","_links":{"html":{"href":"https://github.com/godotengine/godot/pull/102330#pullrequestreview-2808806877"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/102330"}},"submitted_at":"2025-04-30T23:22:22Z","commit_id":null},{"id":2808820484,"node_id":"PRR_kwDOAO6SJc6nazME","user":{"login":"Calinou","id":180032,"node_id":"MDQ6VXNlcjE4MDAzMg==","avatar_url":"https://avatars.githubusercontent.com/u/180032?u=68d23e7ee9cdf810da125e8510b72f845b9dccc8&v=4","gravatar_i