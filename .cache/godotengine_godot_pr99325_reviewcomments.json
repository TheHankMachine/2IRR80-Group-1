Reader.xml\r\n10:                 var reader := ZIPReader.new()\r\n11:                 var err := reader.open(\"user://archive.zip\")\r\n14:                 var res := reader.read_file(\"hello.txt\")\r\n\r\nmodules/zip/doc_classes/ZIPPacker.xml\r\n10:                 var writer := ZIPPacker.new()\r\n11:                 var err := writer.open(\"user://archive.zip\")\r\n\r\ndoc/classes/DTLSServer.xml\r\n14:             var dtls := DTLSServer.new()\r\n15:             var server := UDPServer.new()\r\n93:             var dtls := PacketPeerDTLS.new()\r\n94:             var udp := PacketPeerUDP.new()\r\n\r\ndoc/classes/UDPServer.xml\r\n16:             var server := UDPServer.new()\r\n80:             var udp := PacketPeerUDP.new()\r\n```\r\n\r\nIMO we should stick to the consensus for now and not use typing in the docs.\r\n\r\nIf we want to start using typing, we need to have a proper plan for what should be typed, how to update existing content over time, and write all this in guidelines. So for now, I'd go as far as changing those 4 classes to follow the current convention.","created_at":"2024-12-02T13:09:54Z","updated_at":"2024-12-02T13:09:54Z","html_url":"https://github.com/godotengine/godot/pull/99325#discussion_r1865820604","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/99325","_links":{"self":{"href":"https://api.github.com/repos/godotengine/godot/pulls/comments/1865820604"},"html":{"href":"https://github.com/godotengine/godot/pull/99325#discussion_r1865820604"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/99325"}},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/1865820604/reactions","total_count":2,"+1":2,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":null,"original_line":22,"side":"RIGHT","in_reply_to_id":1845191117,"author_association":"MEMBER","original_position":23,"position":1,