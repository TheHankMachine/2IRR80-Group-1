/taa_resolve.glsl","commit_id":"ad9c62385d00e0634b34c14d65aecfca014b1d74","original_commit_id":"ad9c62385d00e0634b34c14d65aecfca014b1d74","user":{"login":"clayjohn","id":16521339,"node_id":"MDQ6VXNlcjE2NTIxMzM5","avatar_url":"https://avatars.githubusercontent.com/u/16521339?v=4","gravatar_id":"","url":"https://api.github.com/users/clayjohn","html_url":"https://github.com/clayjohn","followers_url":"https://api.github.com/users/clayjohn/followers","following_url":"https://api.github.com/users/clayjohn/following{/other_user}","gists_url":"https://api.github.com/users/clayjohn/gists{/gist_id}","starred_url":"https://api.github.com/users/clayjohn/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/clayjohn/subscriptions","organizations_url":"https://api.github.com/users/clayjohn/orgs","repos_url":"https://api.github.com/users/clayjohn/repos","events_url":"https://api.github.com/users/clayjohn/events{/privacy}","received_events_url":"https://api.github.com/users/clayjohn/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"I'm not sure about this. I suspect the issue posted by LiveTrower has more to do with having a huge dynamic range than it does with having a lower res screen. Have you tested and confirmed that this makes a difference?\n\nIf this indeed makes a difference, then all these calculations should be moved outside the shader since this value will be the same for all pixels.","created_at":"2025-11-02T05:28:14Z","updated_at":"2025-11-02T05:28:17Z","html_url":"https://github.com/godotengine/godot/pull/112196#discussion_r2484228384","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/112196","_links":{"self":{"href":"https://api.github.com/repos/godotengine/godot/pulls/comments/2484228384"},"html":{"href":"https://github.com/godotengine/godot/pull/112196#discussion_r2484228384"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/112196"}},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/2484228384/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":281,"start_side":"RIGHT","line":null,"original_line":282,"side":"RIGHT","author_association":"MEMBER","original_position":27,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/2493619339","pull_request_review_id":3420726998,"id":2493619339,"node_id":"PRRC_kwDOAO6SJc6UoZyL","diff_hunk":"@@ -273,7 +278,9 @@ vec3 clip_history_3x3(uvec2 group_pos, vec3 color_history, vec2 velocity_closest\n \t// Compute min and max (with an adaptive box size, which greatly reduces ghosting)\n \tvec3 color_avg = (s1 + s2 + s3 + s4 + s5 + s6 + s7 + s8 + s9) * RPC_9;\n \tvec3 color_avg2 = ((s1 * s1) + (s2 * s2) + (s3 * s3) + (s4 * s4) + (s5 * s5) + (s6 * s6) + (s7 * s7) + (s8 * s8) + (s9 * s9)) * RPC_9;\n-\tfloat box_size = mix(0.0f, 2.5f, smoothstep(0.02f, 0.0f, length(velocity_closest)));\n+\tfloat variance_scale = 1080.0f / params.resolution.y;\n+\tfloat variance = clamp(BASE_VARIANCE * variance_scale, BASE_VARIANCE_MIN, BASE_VARIANCE_MAX); // Variance dynamically scales based on resolution","path":"servers/rendering/renderer_rd/shaders/effects/taa_resolve.glsl","commit_id":"ad9c62385d00e0634b34c14d65aecfca014b1d74","original_commit_id":"ad9c62385d00e0634b34c14d65aecfca014b1d74","user":{"login":"kubaofc123","id":17231482,"node_id":"MDQ6VXNlcjE3MjMxNDgy","avatar_url":"https://avatars.githubusercontent.com/u/17231482?v=4","gravatar_id":"","url":"https://api.github.com/users/kubaofc123","html_url":"https://github.com/kubaofc123","followers_url":"https://api.github.com/users/kubaofc123/followers","following_url":"https://api.github.com/users/kubaofc123/following{/other_user}","gists_url":"https://api.github.com/users/kubaofc123/gists{/gist_id}","starred_url":"https://api.github.com/users/kubaofc123/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/kubaofc123/subscriptions","organizations_url":"https://api.github.com/users/kubaofc123/orgs","repos_url":"https://api.github.com/users/kubaofc123/repos","events_url":"https://api.github.com/users/kubaofc123/events{/privacy}","received_events_url":"https://api.github.com/users/kubaofc123/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"Flickering has to do with thin geometry face and low pixel count. Nvidia suggests using MSAA with TAA to help with this issue and indeed does work. I will post video in next comment to help visualize the problem and how the result changes. \r\n\r\nWith latest push the calculations have been moved to outside the shader. I removed one hardcoded parameter in the passed 16 bit buffer, since I think it's not good idea to make the buffer larger. The hardcoded \"disocclusion_scale\" value in passed parameter was moved directly into the shader as a \"#define\" and in it's place is the dynamic variance value, based on screen resolution.\r\n\r\nI took vertical resolution as baseline value, since I think it's the best indicator for pixel density versus screen size (ultra widescreens taken into account).","created_at":"2025-11-05T09:14:16Z","updated_at":"2025-11-05T09:14:16Z","html_url":"https://github.com/godotengine/godot/pull/112196#discussion_r2493619339","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/112196","_links":{"self":{"href":"https://api.github.com/repos/godotengine/godot/pulls/comments/2493619339"},"html":{"href":"https://github.com/godotengine/godot/pull/112196#discussion_r2493619339"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/112196"}},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/2493619339/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":281,"start_side":"RIGHT","line":null,"original_line":282,"side":"RIGHT","in_reply_to_id":2484228384,"author_association":"CONTRIBUTOR","original_position":27,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/2495503476","pull_request_review_id":3423489252,"id":2495503476,"node_id":"PRRC_kwDOAO6SJc6Uvlx0","diff_hunk":"@@ -273,7 +278,9 @@ vec3 clip_history_3x3(uvec2 group_pos, vec3 color_history, vec2 velocity_closest\n \t// Compute min and max (with an adaptive box size, which greatly reduces ghosting)\n \tvec3 color_avg = (s1 + s2 + s3 + s4 + s5 + s6 + s7 + s8 + s9) * RPC_9;\n \tvec3 color_avg2 = ((s1 * s1) + (s2 * s2) + (s3 * s3) + (s4 * s4) + (s5 * s5) + (s6 * s6) + (s7 * s7) + (s8 * s8) + (s9 * s9)) * RPC_9;\n-\tfloat box_size = mix(0.0f, 2.5f, smoothstep(0.02f, 0.0f, length(velocity_closest)));\n+\tfloat variance_scale = 1080.0f / params.resolution.y;\n+\tfloat variance = clamp(BASE_VARIANCE * variance_scale, BASE_VARIANCE_MIN, BASE_VARIANCE_MAX); // Variance dynamically scales based on resolution","path":"servers/rendering/renderer_rd/shaders/effects/taa_resolve.glsl","commit_id":"ad9c62385d00e0634b34c14d65aecfca014b1d74","original_commit_id":"ad9c62385d00e0634b34c14d65aecfca014b1d74","user":{"login":"Calinou","id":180032,"node_id":"MDQ6VXNlcjE4MDAzMg==","avatar_url":"https://avatars.githubusercontent.com/u/180032?v=4","gravatar_id":"","url":"https://api.github.com/users/Calinou","html_url":"https://github.com/Calinou","followers_url":"https://api.github.com/users/Calinou/followers","following_url":"https://api.github.com/users/Calinou/following{/other_user}","gists_url":"https://api.github.com/users/Calinou/gists{/gist_id}","starred_url":"https://api.github.com/users/Calinou/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Calinou/subscriptions","organizations_url":"https://api.github.com/users/Calinou/orgs","repos_url":"https://api.github.com/users/Calinou/repos","events_url":"https://api.github.com/users/Calinou/events{/privacy}","received_events_url":"https://api.github.com/users/Calinou/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"> Nvidia suggests using MSAA with TAA to help with this issue and indeed does work.\r\n\r\nWhile this works, it's a very uncommon approach in modern games due to the GPU cost, so we can't exactly rely on it as a baseline. It's also generally impossible when using deferred rendering (or even slower, in the few engines that support deferred + MSAA).","created_at":"2025-11-05T17:31:26Z","updated_at":"2025-11-05T17:31:26Z","html_url":"https://github.com/godotengine/godot/pull/112196#discussion_r2495503476","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/112196","_links":{"self":{"href":"https://api.github.com/repos/godotengine/godot/pulls/comments/2495503476"},"html":{"href":"https://github.com/godotengine/godot/pull/112196#discussion_r2495503476"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/112196"}},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/2495503476/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":281,"start_side":"RIGHT","line":null,"original_line":282,"side":"RIGHT","in_reply_to_id":2484228384,"author_association":"MEMBER","original_position":27,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/2536423132","pull_request_review_id":3475622355,"id":2536423132,"node_id":"PRRC_kwDOAO6SJc6XLr7c","diff_hunk":"@@ -58,12 +58,18 @@ void TAA::resolve(RID p_frame, RID p_temp, RID p_depth, RID p_velocity, RID p_pr\n \n \tRID default_sampler = material_storage->sampler_rd_get_default(RS::CANVAS_ITEM_TEXTURE_FILTER_LINEAR, RS::CANVAS_ITEM_TEXTURE_REPEAT_DISABLED);\n \n+\t// Dynamic variance, use variance clipping as described in https://developer.download.nvi