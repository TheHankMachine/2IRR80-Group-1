[{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2625104948","html_url":"https://github.com/godotengine/godot/issues/102197#issuecomment-2625104948","issue_url":"https://api.github.com/repos/godotengine/godot/issues/102197","id":2625104948,"node_id":"IC_kwDOAO6SJc6cd-w0","user":{"login":"Chaosus","id":3036176,"node_id":"MDQ6VXNlcjMwMzYxNzY=","avatar_url":"https://avatars.githubusercontent.com/u/3036176?v=4","gravatar_id":"","url":"https://api.github.com/users/Chaosus","html_url":"https://github.com/Chaosus","followers_url":"https://api.github.com/users/Chaosus/followers","following_url":"https://api.github.com/users/Chaosus/following{/other_user}","gists_url":"https://api.github.com/users/Chaosus/gists{/gist_id}","starred_url":"https://api.github.com/users/Chaosus/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Chaosus/subscriptions","organizations_url":"https://api.github.com/users/Chaosus/orgs","repos_url":"https://api.github.com/users/Chaosus/repos","events_url":"https://api.github.com/users/Chaosus/events{/privacy}","received_events_url":"https://api.github.com/users/Chaosus/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-01-30T17:18:47Z","updated_at":"2025-01-30T17:18:47Z","body":"cc @Hilderin ","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2625104948/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2625206036","html_url":"https://github.com/godotengine/godot/issues/102197#issuecomment-2625206036","issue_url":"https://api.github.com/repos/godotengine/godot/issues/102197","id":2625206036,"node_id":"IC_kwDOAO6SJc6ceXcU","user":{"login":"Calinou","id":180032,"node_id":"MDQ6VXNlcjE4MDAzMg==","avatar_url":"https://avatars.githubusercontent.com/u/180032?v=4","gravatar_id":"","url":"https://api.github.com/users/Calinou","html_url":"https://github.com/Calinou","followers_url":"https://api.github.com/users/Calinou/followers","following_url":"https://api.github.com/users/Calinou/following{/other_user}","gists_url":"https://api.github.com/users/Calinou/gists{/gist_id}","starred_url":"https://api.github.com/users/Calinou/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Calinou/subscriptions","organizations_url":"https://api.github.com/users/Calinou/orgs","repos_url":"https://api.github.com/users/Calinou/repos","events_url":"https://api.github.com/users/Calinou/events{/privacy}","received_events_url":"https://api.github.com/users/Calinou/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-01-30T18:01:08Z","updated_at":"2025-01-30T18:02:35Z","body":"- Related to https://github.com/godotengine/godot/issues/39222.\n\nResizing a window will always be a slow operation with Vulkan as recreating the swapchain takes a while (definitely longer than OpenGL). Since game window embedding is used, Godot has to resize *two* swapchains every time the window is resized: one for the floating window, and one for the game being embedded (which is a second floating window).\n\nUnfortunately, I don't see a way to optimize this, as a lot of the slowness is down to the OS and graphics driver here. If you switch to the Compatibility rendering method, it should appear to be noticeably faster.\n\nWe can however make the slowness less appearant by not requiring the game window to have its resize operation completed before you can see changes to the floating window. This means they will visibly go out of sync during resize operations, but it may be preferable to do this if it means it's smoother to resize the window.","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2625206036/reactions","total_count":4,"+1":4,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2625357462","html_url":"https://github.com/godotengine/godot/issues/102197#issuecomment-2625357462","issue_url":"https://api.github.com/repos/godotengine/godot/issues/102197","id":2625357462,"node_id":"IC_kwDOAO6SJc6ce8aW","user":{"login":"Ivorforce","id":2308167,"node_id":"MDQ6VXNlcjIzMDgxNjc=","avatar_url":"https://avatars.githubusercontent.com/u/2308167?v=4","gravatar_id":"","url":"https://api.github.com/users/Ivorforce","html_url":"https://github.com/Ivorforce","followers_url":"https://api.github.com/users/Ivorforce/followers","following_url":"https://api.github.com/users/Ivorforce/following{/other_user}","gists_url":"https://api.github.com/users/Ivorforce/gists{/gist_id}","starred_url":"https://api.github.com/users/Ivorforce/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Ivorforce/subscriptions","organizations_url":"https://api.github.com/users/Ivorforce/orgs","repos_url":"https://api.github.com/users/Ivorforce/repos","events_url":"https://api.github.com/users/Ivorforce/events{/privacy}","received_events_url":"https://api.github.com/users/Ivorforce/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-01-30T19:12:28Z","updated_at":"2025-01-30T19:12:28Z","body":"> Resizing a window will always be a slow operation with Vulkan\n\nThat may as well be true, but I'd profile the resize before making a final judgement! It's always possible there's something else unexpected going on that's eating resources.\nI'd do this myself but unfortunately there's no embedding available for my system yet!","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2625357462/reactions","total_count":3,"+1":3,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2627790656","html_url":"https://github.com/godotengine/godot/issues/102197#issuecomment-2627790656","issue_url":"https://api.github.com/repos/godotengine/godot/issues/102197","id":2627790656,"node_id":"IC_kwDOAO6SJc6coOdA","user":{"login":"Hilderin","id":81109165,"node_id":"MDQ6VXNlcjgxMTA5MTY1","avatar_url":"https://avatars.githubusercontent.com/u/81109165?v=4","gravatar_id":"","url":"https://api.github.com/users/Hilderin","html_url":"https://github.com/Hilderin","followers_url":"https://api.github.com/users/Hilderin/followers","following_url":"https://api.github.com/users/Hilderin/following{/other_user}","gists_url":"https://api.github.com/users/Hilderin/gists{/gist_id}","starred_url":"https://api.github.com/users/Hilderin/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Hilderin/subscriptions","organizations_url":"https://api.github.com/users/Hilderin/orgs","repos_url":"https://api.github.com/users/Hilderin/repos","events_url":"https://api.github.com/users/Hilderin/events{/privacy}","received_events_url":"https://api.github.com/users/Hilderin/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-01-31T16:48:02Z","updated_at":"2025-01-31T16:49:52Z","body":"After some testing the performance issue was caused by the `NOTIFICATION_PROCESS` and `NOTIFICATION_RESIZED` which triggered a deferred call to `EmbeddedProcess::_update_embedded_process` each frame which was really unnecessarily. I'll create a PR with a fix. It will not affect the re-rendering but rather the unresponsiveness of the window.","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2627790656/reactions","total_count":3,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":3,"eyes":0},"performed_via_github_app":null,"minimized":null}]