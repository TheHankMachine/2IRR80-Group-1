tengine/godot/pull/98689#discussion_r1835765271"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/98689"}},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/1835765271/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":null,"original_line":281,"side":"RIGHT","author_association":"MEMBER","original_position":24,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/1835820108","pull_request_review_id":2425896510,"id":1835820108,"node_id":"PRRC_kwDOAO6SJc5tbGRM","diff_hunk":"@@ -219,8 +219,14 @@\n \t\t\t<return type=\"Tween\" />\n \t\t\t<param index=\"0\" name=\"ease\" type=\"int\" enum=\"Tween.EaseType\" />\n \t\t\t<description>\n-\t\t\t\tSets the default ease type for [PropertyTweener]s and [MethodTweener]s animated by this [Tween].\n-\t\t\t\tIf not specified, the default value is [constant EASE_IN_OUT].\n+\t\t\t\tSets the default ease type for [PropertyTweener]s and [MethodTweener]s appended after this method.\n+\t\t\t\tBefore this is set, the default ease type is [constant EASE_IN_OUT].","path":"doc/classes/Tween.xml","commit_id":"47be06b6ea432c3c1c31d0c4c623a8a544c8afef","original_commit_id":"af489f85612be0618ebc96bced6df9947d99ef98","user":{"login":"Meorge","id":9957987,"node_id":"MDQ6VXNlcjk5NTc5ODc=","avatar_url":"https://avatars.githubusercontent.com/u/9957987?v=4","gravatar_id":"","url":"https://api.github.com/users/Meorge","html_url":"https://github.com/Meorge","followers_url":"https://api.github.com/users/Meorge/followers","following_url":"https://api.github.com/users/Meorge/following{/other_user}","gists_url":"https://api.github.com/users/Meorge/gists{/gist_id}","starred_url":"https://api.github.com/users/Meorge/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Meorge/subscriptions","organizations_url":"https://api.github.com/users/Meorge/orgs","repos_url":"https://api.github.com/users/Meorge/repos","events_url":"https://api.github.com/users/Meorge/events{/privacy}","received_events_url":"https://api.github.com/users/Meorge/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"My main concern with the phrasing of \"If not specified\" or \"If this method is not called\" is that, at least to me, it implies that the order of calling it doesn't matter for setting the default ease type (and transition type).\r\n\r\nFor example, in this snippet of code:\r\n```gdscript\r\nvar tw := create_tween()\r\ntw.tween_property(self, \"position:x\", 50, 1.0)\r\ntw.set_ease(Tween.EASE_IN)\r\n```\r\nWith the phrasing of\r\n> If this method is not called, the default ease type is `EASE_IN_OUT`.\r\n\r\nI would expect that the single property Tweener there would adopt the newly-set default of `EASE_IN` once it is run, not that it would still have `EASE_IN_OUT` because the method wasn't called after the Tweener was created. Granted, the sentence prior ends with \"appended after this method\", which explains the order-dependent nature, but this following sentence seems like it would suggest the order isn't dependent (that it can be called at *any* time to change the default ease type, which isn't exactly the case).","created_at":"2024-11-11T00:00:25Z","updated_at":"2024-11-11T00:00:25Z","html_url":"https://github.com/godotengine/godot/pull/98689#discussion_r1835820108","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/98689","_links":{"self":{"href":"https://api.github.com/repos/godotengine/godot/pulls/comments/1835820108"},"html":{"href":"https://github.com/godotengine/godot/pull/98689#discussion_r1835820108"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/98689"}},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/1835820108/reactions","total_count":0,"+1":0,"-1":0,"lau