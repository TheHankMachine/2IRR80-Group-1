ite_admin":false},"body":"> How often are the atlases updated at run time?\r\n\r\nEvery time new glyph is used, so big atlas can cause significant stutter first time new text is shown. This can be really bad for languages with a lot of different glyphs, like Chinese, and is the reason atlases are small.\r\n\r\n> If the only problem is not supporting partial texture updates, then let's just add support for partial texture updates\r\n\r\nBased on my assumption that it will be significantly faster than full texture updates, which I have not tested.","created_at":"2025-04-10T18:11:37Z","updated_at":"2025-04-10T18:11:37Z","html_url":"https://github.com/godotengine/godot/pull/105008#discussion_r2037992734","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/105008","_links":{"self":{"href":"https://api.github.com/repos/godotengine/godot/pulls/comments/2037992734"},"html":{"href":"https://github.com/godotengine/godot/pull/105008#discussion_r2037992734"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/105008"}},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/2037992734/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":848,"original_line":848,"side":"RIGHT","in_reply_to_id":2037806064,"author_association":"MEMBER","original_position":6,"position":1,"subject_type":"line"}]