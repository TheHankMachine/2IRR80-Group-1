e` is no longer fully maximized.\r\nOr rather, I think the bar should not be transparent so that the editor behind the window is not visible.\r\n\r\n<img width=\"809\" height=\"62\" alt=\"Bildschirmfoto 2025-10-28 um 13 31 51\" src=\"https://github.com/user-attachments/assets/1ad4220e-d015-492a-9d94-15fc72513a51\" />","html_url":"https://github.com/godotengine/godot/pull/104278#pullrequestreview-3388552215","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/104278","author_association":"MEMBER","submitted_at":"2025-10-28T12:34:09Z"},{"id":3388759132,"node_id":"PRR_kwDOAO6SJc7J_Fxc","state":"COMMENTED","commit_id":"cd638cec5367d70a5f537e80a9495dbc2e862372","user":{"site_admin":false,"suspended":false,"updated_at":"0001-01-01T00:00:00Z","avatar_url":"https://avatars.githubusercontent.com/u/41921395?u=74caa4e396a8e2995ac648a80f7488601d679e63&v=4","created_at":"0001-01-01T00:00:00Z","followers":0,"following":0,"html_url":"https://github.com/Alex2782","id":41921395,"node_id":"MDQ6VXNlcjQxOTIxMzk1","login":"Alex2782","type":"User","owned_private_repos":0,"public_gists":0,"public_repos":0,"total_private_repos":0,"url":"https://api.github.com/users/Alex2782"},"body":"","html_url":"https://github.com/godotengine/godot/pull/104278#pullrequestreview-3388759132","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/104278","author_association":"MEMBER","submitted_at":"2025-10-28T13:24:46Z"},{"id":3390365631,"node_id":"PRR_kwDOAO6SJc7KFN-_","state":"COMMENTED","commit_id":"cd638cec5367d70a5f537e80a9495dbc2e862372","user":{"site_admin":false,"suspended":false,"updated_at":"0001-01-01T00:00:00Z","avatar_url":"https://avatars.githubusercontent.com/u/176927541?u=25817fe797fcc7a812ba9d7f58f593f5a003abbb&v=4","created_at":"0001-01-01T00:00:00Z","followers":0,"following":0,"html_url":"https://github.com/syntaxerror247","id":176927541,"node_id":"U_kgDOCouzNQ","login":"syntaxerror247","type":"User","owned_private_repos":0,"public_gists":0,"public_