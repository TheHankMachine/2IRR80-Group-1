61,"node_id":"MDQ6VXNlcjE5MTU2MQ==","login":"dsnopek","type":"User","owned_private_repos":0,"public_gists":0,"public_repos":0,"total_private_repos":0,"url":"https://api.github.com/users/dsnopek"},"body":"Thanks! I haven't tested, but the code looks good to me :-)","html_url":"https://github.com/godotengine/godot/pull/116622#pullrequestreview-3841749362","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/116622","author_association":"CONTRIBUTOR","submitted_at":"2026-02-23T15:25:31Z"},{"id":3843904958,"node_id":"PRR_kwDOAO6SJc7lHVW-","state":"CHANGES_REQUESTED","user":{"site_admin":false,"suspended":false,"updated_at":"0001-01-01T00:00:00Z","avatar_url":"https://avatars.githubusercontent.com/u/191561?v=4","created_at":"0001-01-01T00:00:00Z","followers":0,"following":0,"html_url":"https://github.com/dsnopek","id":191561,"node_id":"MDQ6VXNlcjE5MTU2MQ==","login":"dsnopek","type":"User","owned_private_repos":0,"public_gists":0,"public_repos":0,"total_private_repos":0,"url":"https://api.github.com/users/dsnopek"},"body":"I just tested this, and, unfortunately, I think it needs some changes\n\nIf you're using the default action map (which is huge), once you start typing in the field to (re)name an action, the entire editor grinds to a halt, because it's resaving the entire action map on every key press\n\nThis should try to be a bit smarter about emiting the signal that an action has been renamed. Perhaps it could (a) debounce the keypress (ie only emit the signal after the user has stopped typing for a certain amount of time), or (b) only emit the signal after the `LineEdit` becomes unfocused (so when the user clicks into some other control)","html_url":"https://github.com/godotengine/godot/pull/116622#pullrequestreview-3843904958","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/116622","author_association":"CONTRIBUTOR","submitted_at":"2026-02-23T22:41:57Z"},{"id":3890593465,"node_id":"PRR_kwDOAO6SJc7n5b65","state":"COMMENTED","user":{"site_admin":false,"suspended":false,"updated_at":"0001-01-01T00:00:00Z","avatar_url":"https://avatars.githubusercontent.com/u/5838871?u=435a826b39cf038f44b5ec51a26d531ed0751099&v=4","created_at":"0001-01-01T00:00:00Z","followers":0,"following":0,"html_url":"https://github.com/MattiaZir","id":5838871,"node_id":"MDQ6VXNlcjU4Mzg4NzE=","login":"MattiaZir","type":"User","owned_private_repos":0,"public_gists":0,"public_repos":0,"total_private_repos":0,"url":"https://api.github.com/users/MattiaZir"},"body":"Edit: Sorry, some confusion with the GitHub naming of stuff.","html_url":"https://github.com/godotengine/godot/pull/116622#pullrequestreview-3890593465","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/116622","author_association":"CONTRIBUTOR","submitted_at":"2026-03-04T16:36:13Z"},{"id":4192353311,"node_id":"PRR_kwDOAO6SJc754jwf","state":"APPROVED","commit_id":"05b065d93ee07e36cc12c670ba9a68038dbd8c1b","user":{"site_admin":false,"suspended":false,"updated_at":"0001-01-01T00:00:00Z","avatar_url":"https://avatars.githubusercontent.com/u/191561?v=4","created_at":"0001-01-01T00:00:00Z","followers":0,"following":0,"html_url":"https://github.com/dsnopek","id":191561,"node_id":"MDQ6VXNlcjE5MTU2MQ==","login":"dsnopek","type":"User","owned_private_repos":0,"public_gists":0,"public_repos":0,"total_private_repos":0,"url":"https://api.github.com/users/dsnopek"},"body":"Sorry for taking so long to get back to this!\n\nI retested the latest version using the default action map (which has way too much stuff on it), and it handled the rename correctly, and did it with decent performance :-)\n\nWhile it would be great to make this operation not quite so slow, I think this is an acceptable workaround for now","html_url":"https://github.com/godotengine/godot/pull/116622#pullrequestreview-4192353311","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/116622","author_association":"CONTRIBUTOR","submitted_at":"2026-04-28T21:04:32Z"}