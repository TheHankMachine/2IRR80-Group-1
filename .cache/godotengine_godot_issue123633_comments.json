[{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5743169039","html_url":"https://github.com/godotengine/godot/issues/123633#issuecomment-5743169039","issue_url":"https://api.github.com/repos/godotengine/godot/issues/123633","id":5743169039,"node_id":"IC_kwDOAO6SJc8AAAABVlHODw","user":{"login":"clayjohn","id":16521339,"node_id":"MDQ6VXNlcjE2NTIxMzM5","avatar_url":"https://avatars.githubusercontent.com/u/16521339?v=4","gravatar_id":"","url":"https://api.github.com/users/clayjohn","html_url":"https://github.com/clayjohn","followers_url":"https://api.github.com/users/clayjohn/followers","following_url":"https://api.github.com/users/clayjohn/following{/other_user}","gists_url":"https://api.github.com/users/clayjohn/gists{/gist_id}","starred_url":"https://api.github.com/users/clayjohn/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/clayjohn/subscriptions","organizations_url":"https://api.github.com/users/clayjohn/orgs","repos_url":"https://api.github.com/users/clayjohn/repos","events_url":"https://api.github.com/users/clayjohn/events{/privacy}","received_events_url":"https://api.github.com/users/clayjohn/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-09-19T15:41:33Z","updated_at":"2026-09-19T15:41:33Z","body":"We are going to need an MRP. I have optimized several 3D mobile games by reducing 3D render scale. The fact that you aren't seeing a performance boost points to there being something in your project uniquely affecting the benefits of 3D scaling. ","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5743169039/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5743476023","html_url":"https://github.com/godotengine/godot/issues/123633#issuecomment-5743476023","issue_url":"https://api.github.com/repos/godotengine/godot/issues/123633","id":5743476023,"node_id":"IC_kwDOAO6SJc8AAAABVlZ9Nw","user":{"login":"Kajinor","id":7585932,"node_id":"MDQ6VXNlcjc1ODU5MzI=","avatar_url":"https://avatars.githubusercontent.com/u/7585932?v=4","gravatar_id":"","url":"https://api.github.com/users/Kajinor","html_url":"https://github.com/Kajinor","followers_url":"https://api.github.com/users/Kajinor/followers","following_url":"https://api.github.com/users/Kajinor/following{/other_user}","gists_url":"https://api.github.com/users/Kajinor/gists{/gist_id}","starred_url":"https://api.github.com/users/Kajinor/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Kajinor/subscriptions","organizations_url":"https://api.github.com/users/Kajinor/orgs","repos_url":"https://api.github.com/users/Kajinor/repos","events_url":"https://api.github.com/users/Kajinor/events{/privacy}","received_events_url":"https://api.github.com/users/Kajinor/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-09-19T16:27:02Z","updated_at":"2026-09-19T16:27:02Z","body":"Thanks for your fast reply, I added an MRP. Newly created with 4.7.2. \n\nWhat you say sounds promising but I played with the settings for years as I was hoping there is maybe something I missed but it appears not. The settings are more or less default ones. But of course you probably know more about it than me. ","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5743476023/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5744924316","html_url":"https://github.com/godotengine/godot/issues/123633#issuecomment-5744924316","issue_url":"https://api.github.com/repos/godotengine/godot/issues/123633","id":5744924316,"node_id":"IC_kwDOAO6SJc8AAAABVmyWnA","user":{"login":"shahriarlabib000","id":100587814,"node_id":"U_kgDOBf7ZJg","avatar_url":"https://avatars.githubusercontent.com/u/100587814?v=4","gravatar_id":"","url":"https://api.github.com/users/shahriarlabib000","html_url":"https://github.com/shahriarlabib000","followers_url":"https://api.github.com/users/shahriarlabib000/followers","following_url":"https://api.github.com/users/shahriarlabib000/following{/other_user}","gists_url":"https://api.github.com/users/shahriarlabib000/gists{/gist_id}","starred_url":"https://api.github.com/users/shahriarlabib000/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/shahriarlabib000/subscriptions","organizations_url":"https://api.github.com/users/shahriarlabib000/orgs","repos_url":"https://api.github.com/users/shahriarlabib000/repos","events_url":"https://api.github.com/users/shahriarlabib000/events{/privacy}","received_events_url":"https://api.github.com/users/shahriarlabib000/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-09-19T20:05:29Z","updated_at":"2026-09-20T02:37:36Z","body":"Reproducible on:\nGodot v4.8.dev6 - Android 13 (SDK 33 build V14.0.7.0.TKUMIXM) - Single-window, 1 monitor (2167x1080 @ 60.00 Hz) - Vulkan (Mobile) - integrated Mali-G52 - MT6769H (8 threads) - Android (44100 Hz, Stereo/mono)\n\nWith the mrp","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5744924316/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5774024297","html_url":"https://github.com/godotengine/godot/issues/123633#issuecomment-5774024297","issue_url":"https://api.github.com/repos/godotengine/godot/issues/123633","id":5774024297,"node_id":"IC_kwDOAO6SJc8AAAABWCieaQ","user":{"login":"Kajinor","id":7585932,"node_id":"MDQ6VXNlcjc1ODU5MzI=","avatar_url":"https://avatars.githubusercontent.com/u/7585932?v=4","gravatar_id":"","url":"https://api.github.com/users/Kajinor","html_url":"https://github.com/Kajinor","followers_url":"https://api.github.com/users/Kajinor/followers","following_url":"https://api.github.com/users/Kajinor/following{/other_user}","gists_url":"https://api.github.com/users/Kajinor/gists{/gist_id}","starred_url":"https://api.github.com/users/Kajinor/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Kajinor/subscriptions","organizations_url":"https://api.github.com/users/Kajinor/orgs","repos_url":"https://api.github.com/users/Kajinor/repos","events_url":"https://api.github.com/users/Kajinor/events{/privacy}","received_events_url":"https://api.github.com/users/Kajinor/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-09-22T09:16:33Z","updated_at":"2026-09-22T09:18:37Z","body":"Thanks, glad it got confirmed.\n\n@clayjohn Somehow I received a reply from you according to my github e-mail but its not or no longer visible here? Perhaps an update issue with Github(?), you wrote:\n\n> How do you have Depth of Field configured in Unity? I'm reading online that in some cases it can be configured to run before upscaling.\n> \n> In Godot Depth of Field is always calculated after upscaling. So that might be the difference. Depth of Field is very expensive on mobile devices.\n\nThe issue also happens without DOF/Postprocessing. I only enabled it to make the effect more significant. But you now confirmed what I always kinda suspected about some postprocessing like DOF or Glow that is always executed on a native sized upscaled target? If that really is the case, shall I open a separate bug report for that? \n\nIt is important to distinguish from this one, as the 3D scaling issue also happens without any post processing effects. One more example:\n\nRender Scale 1.0, Vulkan-Renderers, just rendering a Cube (No Sky, etc.):\nUnity: 80-90 FPS\nGodot: 80-90 FPS\n(With OpenGL in both engines, it will be 120 FPS at Scale 1.0 but thats a different story, just sad somehow)\n\nRender Scale 0.8\nUnity: 120 FPS\nGodot: 70-80 FPS **<== Bug**\n\nI hope that helps.\n","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5774024297/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5837579729","html_url":"https://github.com/godotengine/godot/issues/123633#issuecomment-5837579729","issue_url":"https://api.github.com/repos/godotengine/godot/issues/123633","id":5837579729,"node_id":"IC_kwDOAO6SJc8AAAABW_Jl0Q","user":{"login":"Calinou","id":180032,"node_id":"MDQ6VXNlcjE4MDAzMg==","avatar_url":"https://avatars.githubusercontent.com/u/180032?v=4","gravatar_id":"","url":"https://api.github.com/users/Calinou","html_url":"https://github.com/Calinou","followers_url":"https://api.github.com/users/Calinou/followers","following_url":"https://api.github.com/users/Calinou/following{/other_user}","gists_url":"https://api.github.com/users/Calinou/gists{/gist_id}","starred_url":"https://api.github.com/users/Calinou/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Calinou/subscriptions","organizations_url":"https://api.github.com/users/Calinou/orgs","repos_url":"https://api.github.com/users/Calinou/repos","events_url":"https://api.github.com/users/Calinou/events{/privacy}","received_events_url":"https://api.github.com/users/Calinou/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-09-25T18:35:11Z","updated_at":"2026-09-25T18:36:10Z","body":"> But you now confirmed what I always kinda suspected about some postprocessing like DOF or Glow that is always executed on a native sized upscaled target? If that really is the case, shall I open a separate bug report for that?\n\nLike for depth of field, this is likely done on purpose to improve the stability of glow in motion.\n\nDoes performance improve if you set these two project settings?\n\n- **Rendering > Camera > Depth of Field > Depth of Field Bokeh Shape** to **Square**\n- **Rendering > Camera > Depth of Field > Depth of Field Bokeh Quality** to **Very Low**\n\nGlow already uses the fastest possible configuration on mobile by default (bilinear upscaling instead of bicubic), but DoF doesn't.","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5837579729/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5838009739","html_url":"https://github.com/godotengine/godot/issues/123633#issuecomment-5838009739","issue_url":"https://api.github.com/repos/godotengine/godot/issues/123633","id":5838009739,"node_id":"IC_kwDOAO6SJc8AAAABW_j1iw","user":{"login":"shahriarlabib000","id":100587814,"node_id":"U_kgDOBf7ZJg","avatar_url":"https://avatars.githubusercontent.com/u/100587814?v=4","gravatar_id":"","url":"https://api.github.com/users/shahriarlabib000","html_url":"https://github.com/shahriarlabib000","followers_url":"https://api.github.com/users/shahriarlabib000/followers","following_url":"https://api.github.com/users/shahriarlabib000/following{/other_user}","gists_url":"https://api.github.com/users/shahriarlabib000/gists{/gist_id}","starred_url":"https://api.github.com/users/shahriarlabib000/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/shahriarlabib000/subscriptions","organizations_url":"https://api.github.com/users/shahriarlabib000/orgs","repos_url":"https://api.github.com/users/shahriarlabib000/repos","events_url":"https://api.github.com/users/shahriarlabib000/events{/privacy}","received_events_url":"https://api.github.com/users/shahriarlabib000/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-09-25T19:02:18Z","updated_at":"2026-09-26T14:54:32Z","body":"Noticed something strange. If I lower the scale and then increase it again, performance seems to increase.\nSetting scale to 0.1 , doesn't seem to fix the performance issue sometimes in my case.\nhttps://youtu.be/zAWeB_hngHQ?si=W7pYQy0y9HjAVzdX\n\n>Rendering > Camera > Depth of Field > Depth of Field Bokeh Shape to Square\nRendering > Camera > Depth of Field > Depth of Field Bokeh Quality to Very Low\n\nTested with this on the mrp , doesn't seem to change anything.\n\n[3d-scale-bug-edited.zip](https://github.com/user-attachments/files/32667579/3d-scale-bug-edited.zip)\n","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5838009739/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5847218479","html_url":"https://github.com/godotengine/godot/issues/123633#issuecomment-5847218479","issue_url":"https://api.github.com/repos/godotengine/godot/issues/123633","id":5847218479,"node_id":"IC_kwDOAO6SJc8AAAABXIV5Lw","user":{"login":"Kajinor","id":7585932,"node_id":"MDQ6VXNlcjc1ODU5MzI=","avatar_url":"https://avatars.githubusercontent.com/u/7585932?v=4","gravatar_id":"","url":"https://api.github.com/users/Kajinor","html_url":"https://github.com/Kajinor","followers_url":"https://api.github.com/users/Kajinor/followers","following_url":"https://api.github.com/users/Kajinor/following{/other_user}","gists_url":"https://api.github.com/users/Kajinor/gists{/gist_id}","starred_url":"https://api.github.com/users/Kajinor/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Kajinor/subscriptions","organizations_url":"https://api.github.com/users/Kajinor/orgs","repos_url":"https://api.github.com/users/Kajinor/repos","events_url":"https://api.github.com/users/Kajinor/events{/privacy}","received_events_url":"https://api.github.com/users/Kajinor/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-09-26T14:51:31Z","updated_at":"2026-09-26T14:51:31Z","body":"> Like for depth of field, this is likely done on purpose to improve the stability of glow in motion.\n\nAh ok, I think that should be configurable. At first look I don't see any true gain for mobile here.  Even for Desktop, imagine someone has an 8K Screen and Godot does PostProcessing on 8K all the time with no configuration. However, the 3D Scaling Performance Issues are not directly related to this, they also happen without any post processing effects.\n\n> Noticed something strange. If I lower the scale and then increase it again, performance seems to increase.\n> Settings scale to 0.1 , doesn't seem to fix the performance issue sometimes in my case.\n\nYeah I think this is exactly what I described, that is the issue. Except that with 0.1 it boost up to 80-85 FPS for me which is still not as it should be. Its weird, I hope this can be fixed because a lot of mobile games which use the Vulkan renderer would strongly benefit from that I think.\n","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5847218479/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5847309762","html_url":"https://github.com/godotengine/godot/issues/123633#issuecomment-5847309762","issue_url":"https://api.github.com/repos/godotengine/godot/issues/123633","id":5847309762,"node_id":"IC_kwDOAO6SJc8AAAABXIbdwg","user":{"login":"shahriarlabib000","id":100587814,"node_id":"U_kgDOBf7ZJg","avatar_url":"https://avatars.githubusercontent.com/u/100587814?v=4","gravatar_id":"","url":"https://api.github.com/users/shahriarlabib000","html_url":"https://github.com/shahriarlabib000","followers_url":"https://api.github.com/users/shahriarlabib000/followers","following_url":"https://api.github.com/users/shahriarlabib000/following{/other_user}","gists_url":"https://api.github.com/users/shahriarlabib000/gists{/gist_id}","starred_url":"https://api.github.com/users/shahriarlabib000/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/shahriarlabib000/subscriptions","organizations_url":"https://api.github.com/users/shahriarlabib000/orgs","repos_url":"https://api.github.com/users/shahriarlabib000/repos","events_url":"https://api.github.com/users/shahriarlabib000/events{/privacy}","received_events_url":"https://api.github.com/users/shahriarlabib000/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-09-26T15:04:30Z","updated_at":"2026-09-26T15:10:27Z","body":"What i meant was\n- Set scale to 0.1\n- Set scale again to something higher while the game is still running.\n\nThe frame rate seems to increase.\n\nAlso if I turn off `display/window/frame_pacing/android/enable_frame_pacing` this entire issue is fixed for me.","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5847309762/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5848220318","html_url":"https://github.com/godotengine/godot/issues/123633#issuecomment-5848220318","issue_url":"https://api.github.com/repos/godotengine/godot/issues/123633","id":5848220318,"node_id":"IC_kwDOAO6SJc8AAAABXJTCng","user":{"login":"Kajinor","id":7585932,"node_id":"MDQ6VXNlcjc1ODU5MzI=","avatar_url":"https://avatars.githubusercontent.com/u/7585932?v=4","gravatar_id":"","url":"https://api.github.com/users/Kajinor","html_url":"https://github.com/Kajinor","followers_url":"https://api.github.com/users/Kajinor/followers","following_url":"https://api.github.com/users/Kajinor/following{/other_user}","gists_url":"https://api.github.com/users/Kajinor/gists{/gist_id}","starred_url":"https://api.github.com/users/Kajinor/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Kajinor/subscriptions","organizations_url":"https://api.github.com/users/Kajinor/orgs","repos_url":"https://api.github.com/users/Kajinor/repos","events_url":"https://api.github.com/users/Kajinor/events{/privacy}","received_events_url":"https://api.github.com/users/Kajinor/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-09-26T17:14:18Z","updated_at":"2026-09-26T17:16:48Z","body":"> What i meant was\n> \n>     Set scale to 0.1\n>     Set scale again to something higher while the game is still running.\n> \n> The frame rate seems to increase.\n\nYeah that was my observation too. I didn't changed it at runtime but it was the same result that Scale 1.0 is faster than any lower scale except 0.1.\n\n> Also if I turn off display/window/frame_pacing/android/enable_frame_pacing this entire issue is fixed for me.\n\nTurning it off increases performance now with reduced scale. So it probably could be considered\"fixed\", still not on par with Unity but I can live with that. I am still not getting 120 FPS but around 100-110, thats at least something. However, not sure what side effects turning it off might have and if its worth investigating it further.\n\nWith that setting turned off and now knowing that PostProcessing in Godot happens always at native resolution, it all becomes more clear now. \n\nFor the Frame Pacing, its enabled by default and \"highly recommended\" according to documentation. So perhaps put a warning here, that on low/mid-range devices this causes issues? Or turn off automatically on certain vendors like Mali-GPUs? Just a suggestion. I always had the feeling the frame rate is more stable by disabling it.\n\nFor the post processing scaling I will open a separate issue/proposal then. ","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5848220318/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5848302566","html_url":"https://github.com/godotengine/godot/issues/123633#issuecomment-5848302566","issue_url":"https://api.github.com/repos/godotengine/godot/issues/123633","id":5848302566,"node_id":"IC_kwDOAO6SJc8AAAABXJYD5g","user":{"login":"shahriarlabib000","id":100587814,"node_id":"U_kgDOBf7ZJg","avatar_url":"https://avatars.githubusercontent.com/u/100587814?v=4","gravatar_id":"","url":"https://api.github.com/users/shahriarlabib000","html_url":"https://github.com/shahriarlabib000","followers_url":"https://api.github.com/users/shahriarlabib000/followers","following_url":"https://api.github.com/users/shahriarlabib000/following{/other_user}","gists_url":"https://api.github.com/users/shahriarlabib000/gists{/gist_id}","starred_url":"https://api.github.com/users/shahriarlabib000/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/shahriarlabib000/subscriptions","organizations_url":"https://api.github.com/users/shahriarlabib000/orgs","repos_url":"https://api.github.com/users/shahriarlabib000/repos","events_url":"https://api.github.com/users/shahriarlabib000/events{/privacy}","received_events_url":"https://api.github.com/users/shahriarlabib000/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-09-26T17:25:57Z","updated_at":"2026-09-26T17:27:54Z","body":">I didn't changed it at runtime but it was the same result that Scale 1.0 is faster than any lower scale except 0.1.\n\nAnd my observation was it works for the other lower scales as well once i set it to 0.1 and then increase it again to something else like 0.4 at runtime for example.","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5848302566/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5848426891","html_url":"https://github.com/godotengine/godot/issues/123633#issuecomment-5848426891","issue_url":"https://api.github.com/repos/godotengine/godot/issues/123633","id":5848426891,"node_id":"IC_kwDOAO6SJc8AAAABXJfpiw","user":{"login":"Kajinor","id":7585932,"node_id":"MDQ6VXNlcjc1ODU5MzI=","avatar_url":"https://avatars.githubusercontent.com/u/7585932?v=4","gravatar_id":"","url":"https://api.github.com/users/Kajinor","html_url":"https://github.com/Kajinor","followers_url":"https://api.github.com/users/Kajinor/followers","following_url":"https://api.github.com/users/Kajinor/following{/other_user}","gists_url":"https://api.github.com/users/Kajinor/gists{/gist_id}","starred_url":"https://api.github.com/users/Kajinor/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Kajinor/subscriptions","organizations_url":"https://api.github.com/users/Kajinor/orgs","repos_url":"https://api.github.com/users/Kajinor/repos","events_url":"https://api.github.com/users/Kajinor/events{/privacy}","received_events_url":"https://api.github.com/users/Kajinor/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-09-26T17:43:38Z","updated_at":"2026-09-26T17:46:02Z","body":"> And my observation was it works for the other lower scales as well once i set it to 0.1 and then increase it again to something else like 0.4 for example.\n\nAh now I get it, thats not how it was for me then.  But I noticed just now, if Frame Pacing is enabled again and I put 6 omni lights into the scene in the MRP (disabling DOF) it works as expected. Moving the slider to 0.5 I get 120 FPS stable, not even the slightest frame jump, perfect. At 1.0 I only get 55 FPS. Disabling the Omni Lights (not at runtime) and starting the MRP produces the issue that even at 0.5 performance decreases to 75-80 FPS. It should be the other way around.\n\nI left the MRP open running while typing this reply, now after a few minutes still 120 FPS stable with Frame Pacing enabled and scale 0.5 with 6 Omni Lights. I don't unterstand this anymore, perhaps there is an optimization mechanism which triggers only after a certain threshold? (e.g. number of lights) Maybe one of the Godot 3D Engineers could explain this. \n\nKinda not so happy to see that if my scene is too simple I get low FPS. (Or maybe an issue on the driver level?)","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5848426891/reactions","total_count":1,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":1},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5850358504","html_url":"https://github.com/godotengine/godot/issues/123633#issuecomment-5850358504","issue_url":"https://api.github.com/repos/godotengine/godot/issues/123633","id":5850358504,"node_id":"IC_kwDOAO6SJc8AAAABXLVi6A","user":{"login":"Kajinor","id":7585932,"node_id":"MDQ6VXNlcjc1ODU5MzI=","avatar_url":"https://avatars.githubusercontent.com/u/7585932?v=4","gravatar_id":"","url":"https://api.github.com/users/Kajinor","html_url":"https://github.com/Kajinor","followers_url":"https://api.github.com/users/Kajinor/followers","following_url":"https://api.github.com/users/Kajinor/following{/other_user}","gists_url":"https://api.github.com/users/Kajinor/gists{/gist_id}","starred_url":"https://api.github.com/users/Kajinor/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Kajinor/subscriptions","organizations_url":"https://api.github.com/users/Kajinor/orgs","repos_url":"https://api.github.com/users/Kajinor/repos","events_url":"https://api.github.com/users/Kajinor/events{/privacy}","received_events_url":"https://api.github.com/users/Kajinor/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-09-26T22:13:08Z","updated_at":"2026-09-26T22:13:08Z","body":"Ok I gave one last test and my conclusion is now:\n\n- **Frame Pacing ON at 0.5 Scale:** Its arbitrary, sometimes 115-120 FPS and stays there until restart the game, next test its 80-85 FPS until restart, another one is only 60-63 FPS.\n\n- **Frame Pacing OFF at 0.5 Scale:** Always 115-120 FPS, always reproducible results for every scale. Lowering scale increases performance always.\n\nSo no idea whats with that frame pacing option but perhaps put a warning there for now. At least that would be my suggestion.","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5850358504/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null}]