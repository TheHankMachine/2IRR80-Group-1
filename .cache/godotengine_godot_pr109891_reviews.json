[{"id":3146578770,"node_id":"PRR_kwDOAO6SJc67jPtS","user":{"login":"BastiaanOlij","id":1945449,"node_id":"MDQ6VXNlcjE5NDU0NDk=","avatar_url":"https://avatars.githubusercontent.com/u/1945449?u=96b5dc9be2859dca5f31314c87d99a68a21e1576&v=4","gravatar_id":"","url":"https://api.github.com/users/BastiaanOlij","html_url":"https://github.com/BastiaanOlij","followers_url":"https://api.github.com/users/BastiaanOlij/followers","following_url":"https://api.github.com/users/BastiaanOlij/following{/other_user}","gists_url":"https://api.github.com/users/BastiaanOlij/gists{/gist_id}","starred_url":"https://api.github.com/users/BastiaanOlij/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/BastiaanOlij/subscriptions","organizations_url":"https://api.github.com/users/BastiaanOlij/orgs","repos_url":"https://api.github.com/users/BastiaanOlij/repos","events_url":"https://api.github.com/users/BastiaanOlij/events{/privacy}","received_events_url":"https://api.github.com/users/BastiaanOlij/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"Seeing we're clearly marking why we're doing this seemingly innocuous thing, and that it should be optimised out on the GPU side, I think it's a valid workaround for this issue.\r\n\r\nAs discussed on rocket chat, ideally we'd address this upstream, there are plenty of use cases where a subpass is used in a multiview scenario, where the processing done in that subpass does not care for which eye we're processing. We're simply optimising for speed here preventing unnecessary writes and reads between tile memory and slow texture memory inbetween passes.\r\n\r\nBut waiting for any action to be taken upstream doesn't make sense.\r\n","state":"APPROVED","html_url":"https://github.com/godotengine/godot/pull/109891#pullrequestreview-3146578770","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/109891","author_association":"CONTRIBUTOR","_links":{"html":{"href":"https://github.com/godotengine/godot/pull/109891#pullrequestreview-3146578770"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/109891"}},"submitted_at":"2025-08-23T00:21:44Z","commit_id":"90c913487595b7f688c0c642e931d9f82b6e85a9"}]