ine/godot/issues/comments/2617702146/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2617764732","html_url":"https://github.com/godotengine/godot/issues/101850#issuecomment-2617764732","issue_url":"https://api.github.com/repos/godotengine/godot/issues/101850","id":2617764732,"node_id":"IC_kwDOAO6SJc6cB-t8","user":{"login":"clayjohn","id":16521339,"node_id":"MDQ6VXNlcjE2NTIxMzM5","avatar_url":"https://avatars.githubusercontent.com/u/16521339?v=4","gravatar_id":"","url":"https://api.github.com/users/clayjohn","html_url":"https://github.com/clayjohn","followers_url":"https://api.github.com/users/clayjohn/followers","following_url":"https://api.github.com/users/clayjohn/following{/other_user}","gists_url":"https://api.github.com/users/clayjohn/gists{/gist_id}","starred_url":"https://api.github.com/users/clayjohn/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/clayjohn/subscriptions","organizations_url":"https://api.github.com/users/clayjohn/orgs","repos_url":"https://api.github.com/users/clayjohn/repos","events_url":"https://api.github.com/users/clayjohn/events{/privacy}","received_events_url":"https://api.github.com/users/clayjohn/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-01-28T03:23:23Z","updated_at":"2025-01-28T03:23:23Z","body":"> I downloaded the Windows Editor artifact from that pull request on the 650 Ti and M265X computers from my previous test and the results were the same as with 4.4 Beta 1. I'm admittedly a bit new to using GitHub, so if that wasn't the right way to get it then let me know and I'll try again.\n\nThat should be correct. I would expect with that PR for the shared GPU usage to be essentially the same as with 4.3, if it's not, then we probably still have an incorrect allocation somewhere @darksylinc ","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2617764732/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2620277372","html_url":"https://github.com/godotengine/godot/issues/101850#issuecomment-2620277372","issue_url":"https://api.github.com/repos/godotengine/godot/issues/101850","id":2620277372,"node_id":"IC_kwDOAO6SJc6cLkJ8","user":{"login":"darksylinc","id":3395130,"node_id":"MDQ6VXNlcjMzOTUxMzA=","avatar_url":"https://avatars.githubusercontent.com/u/3395130?v=4","gravatar_id":"","url":"https://api.github.com/users/darksylinc","html_url":"https://github.com/darksylinc","followers_url":"https://api.github.com/users/darksylinc/followers","following_url":"https://api.github.com/users/darksylinc/following{/other_user}","gists_url":"https://api.github.com/users/darksylinc/gists{/gist_id}","starred_url":"https://api.github.com/users/darksylinc/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/darksylinc/subscriptions","organizations_url":"https://api.github.com/users/darksylinc/orgs","repos_url":"https://api.github.com/users/darksylinc/repos","events_url":"https://api.github.com/users/darksylinc/events{/privacy}","received_events_url":"https://api.github.com/users/darksylinc/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-01-28T23:40:40Z","updated_at":"2025-01-28T23:40:40Z","body":"OK I took a shot at this: But unfortunately I cannot reproduce.\n\nHere's multiple runs of 4.3 and 4.4 beta 1 interleaved:\n![Image](https://github.com/user-attachments/assets/1c59e7be-96b1-47fe-8998-02c36fe0df6e)\n\nThey're practically identical. In order to make the benchmark last longer, I modified it with:\n\n```gdscript\nfunc activate_viewports(count: int):\n\tvar node = TestScene.new(count)\n\tManager.get_tree().root.add_child(node)\n\tOS.delay_msec(2000) # --> this line is new\n\tnode.free()\n```\n\nSo that the benchmark would stay alive at least 2 seconds.\n\nI tried the benchmark on Linux (on a monstrous Radeon 6800 XT 16GB) and it peaks at around 1.8GB VRAM (including 550MB used by the OS and other programs) according to radeontop.\n\nThis is compatible with the measurements in the picture on Windows I am posting, where the consumption peaks at 1.6GB with a base 0.3GB consumed by the OS and other programs.\n\nI tried changing it from 1024 viewports to larger values (like 4096 or even 8000). This causes Radeon 560 2GB and GeForce 1060 3GB to run out of VRAM, but they start using shared RAM instead, thus they don't crash (it's probably slower though). I got the same results on Linux. This actually makes sense, because the GeForce 650 is extremely picky on where the textures are stored, whereas Radeon 560 & GeForce 1060 are much more flexible and can source textures from virtually anywhere.\n\nMy early conclusion is that it doesn't look like 4.4-beta1 is using more memory than 4.3, but it does have small differences that can wreak havoc on GPUs like the GeForce 650 on situations that are tight on VRAM (specially if memory becomes fragmented) and have tight requirements on where textures must be stored.\n\nNonetheless, this behavior still troubles me because according to OP the D3D12 backend is able to complete on GeForce 650 and 4.3 Vulkan is also able to complete.","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2620277372/reactions","total_count":1,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":1,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2620285404","html_url":"https://github.com/godotengine/godot/issues/101850#issuecomment-2620285404","issue_url":"https://api.github.com/repos/godotengine/godot/issues/101850","id":2620285404,"node_id":"IC_kwDOAO6SJc6cLmHc","user":{"login":"darksylinc","id":3395130,"node_id":"MDQ6VXNlcjMzOTUxMzA=","avatar_url":"https://avatars.githubusercontent.com/u/3395130?v=4","gravatar_id":"","url":"https://api.github.com/users/darksylinc","html_url":"https://github.com/darksylinc","followers_url":"https://api.github.com/users/darksylinc/followers","following_url":"https://api.github.com/users/darksylinc/following{/other_user}","gists_url":"https://api.github.com/users/darksylinc/gists{/gist_id}","starred_url":"https://api.github.com/users/darksylinc/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/darksylinc/subscriptions","organizations_url":"https://api.github.com/users/darksylinc/orgs","repos_url":"https://api.github.com/users/darksylinc/repos","events_url":"https://api.github.com/users/darksylinc/events{/privacy}","received_events_url":"https://api.github.com/users/darksylinc/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-01-28T23:48:44Z","updated_at":"2025-01-29T00:11:17Z","body":" @NovaXP could you test https://github.com/godotengine/godot/pull/102141 on your GTX 650 once it finishes building? Perhaps that solves the problem. I'm going blind here, so I focus on the most likely reason.\n\n**Update:** The [artifact is here](https://github.com/godotengine/godot/actions/runs/13021669037/artifacts/2501058183).","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2620285404/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2620496134","html_url":"https://github.com/godotengine/godot/issues/101850#issuecomment-2620496134","issue_url":"https://ap