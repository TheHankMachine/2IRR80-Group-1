:false,"assignees":[],"milestone":{"url":"https://api.github.com/repos/godotengine/godot/milestones/25","html_url":"https://github.com/godotengine/godot/milestone/25","labels_url":"https://api.github.com/repos/godotengine/godot/milestones/25/labels","id":15520464,"node_id":"MI_kwDOAO6SJc4A7NLQ","number":25,"title":"4.8","description":"","creator":{"login":"Repiteo","id":17489292,"node_id":"MDQ6VXNlcjE3NDg5Mjky","avatar_url":"https://avatars.githubusercontent.com/u/17489292?v=4","gravatar_id":"","url":"https://api.github.com/users/Repiteo","html_url":"https://github.com/Repiteo","followers_url":"https://api.github.com/users/Repiteo/followers","following_url":"https://api.github.com/users/Repiteo/following{/other_user}","gists_url":"https://api.github.com/users/Repiteo/gists{/gist_id}","starred_url":"https://api.github.com/users/Repiteo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Repiteo/subscriptions","organizations_url":"https://api.github.com/users/Repiteo/orgs","repos_url":"https://api.github.com/users/Repiteo/repos","events_url":"https://api.github.com/users/Repiteo/events{/privacy}","received_events_url":"https://api.github.com/users/Repiteo/received_events","type":"User","user_view_type":"public","site_admin":false},"open_issues":346,"closed_issues":2304,"state":"open","created_at":"2026-04-13T15:59:35Z","updated_at":"2026-10-21T09:34:58Z","due_on":null,"closed_at":null},"comments":4,"created_at":"2026-09-30T00:52:32Z","updated_at":"2026-10-07T18:34:40Z","closed_at":"2026-10-07T18:34:32Z","assignee":null,"author_association":"CONTRIBUTOR","issue_field_values":[],"type":null,"active_lock_reason":null,"draft":false,"pull_request":{"url":"https://api.github.com/repos/godotengine/godot/pulls/124007","html_url":"https://github.com/godotengine/godot/pull/124007","diff_url":"https://github.com/godotengine/godot/pull/124007.diff","patch_url":"https://github.com/godotengine/godot/pull/124007.patch","merged_at":"2026-10-07T18:34:32Z"},"body":"This PR exposes method metadata in ClassDB method information.\r\n\r\nThis information can be used by bindings for dynamic languages, like JavaScript or Python, which can bind methods without generating binding code at build time. In these languages it is completely feasible to bind methods lazily when a type is first used from the specific language.\r\n\r\nWe have been using this information in bindings for JavaScript e.g. in the [react-native-godot](https://github.com/migeran/react-native-godot) project.\r\n\r\nWe measured about 20% performance improvement on a test case exercising Image.get_pixel() just from using get_method_bind() instead of Variant::call().\r\n\r\nWe are using this in multiple projects (both stock Godot and LibGodot), and would be very helpful, if we could use unpatched Godot 4.8 for this performance gain.\r\n\r\nDeveloped by [Migeran](https://migeran.com)\r\n\r\n<!--\r\nPlease target the `master` branch. We will take care of backporting relevant fixes to older versions.\r\n\r\nBefore submitting, please read our checklist for contributors:\r\nhttps://contributing.godotengine.org/en/latest/development/engine/introduction.html#checklist-for-new-contributors\r\n\r\nUse of AI must be disclosed and should include a description of how it was used.\r\n-->\r\n\r\nNote: Removed the LibGodot marking based on discussion with the core team, because it is usable for normal GDExtensions as well.\r\n","closed_by":{"login":"Repiteo","id":17489292,"node_id":"MDQ6VXNlcjE3NDg5Mjky","avatar_url":"https://avatars.githubusercontent.com/u/17489292?v=4","gravatar_id":"","url":"https://api.github.com/users/Repiteo","html_url":"https://github.com/Repiteo","followers_url":"https://api.github.com/users/Repiteo/followers","following_url":"https://api.github.com/users/Repiteo/following{/other_user}","gists_url":"https://api.github.com/users/Repiteo/gists{/gist_id}","starred_url":"https://api.github.com/users/Repiteo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Repiteo/subscriptions","organizations_url":"https://api.github.com/users/Repiteo/orgs","repos_url":"https://api.github.com/users/Repiteo/repos","events_url":"https://api.github.com/users/Repiteo/events{/privacy}","received_events_url":"https://api.github.com/users/Repiteo/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/124007/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/godotengine/godot/issues/124007/timeline","performed_via_github_app":null,"state_reason":null}