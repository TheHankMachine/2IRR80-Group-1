b.com/users/isaaccp/followers","following_url":"https://api.github.com/users/isaaccp/following{/other_user}","gists_url":"https://api.github.com/users/isaaccp/gists{/gist_id}","starred_url":"https://api.github.com/users/isaaccp/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/isaaccp/subscriptions","organizations_url":"https://api.github.com/users/isaaccp/orgs","repos_url":"https://api.github.com/users/isaaccp/repos","events_url":"https://api.github.com/users/isaaccp/events{/privacy}","received_events_url":"https://api.github.com/users/isaaccp/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-05-13T02:03:27Z","updated_at":"2025-05-13T02:28:50Z","body":"I run this under a new debug build from head and it looks like those threads are stuck here:\n\n![Image](https://github.com/user-attachments/assets/cc343bbb-2690-4677-ad27-f3101f098f2c)","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2874808631/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2874811684","html_url":"https://github.com/godotengine/godot/issues/104796#issuecomment-2874811684","issue_url":"https://api.github.com/repos/godotengine/godot/issues/104796","id":2874811684,"node_id":"IC_kwDOAO6SJc6rWiUk","user":{"login":"isaaccp","id":8712,"node_id":"MDQ6VXNlcjg3MTI=","avatar_url":"https://avatars.githubusercontent.com/u/8712?v=4","gravatar_id":"","url":"https://api.github.com/users/isaaccp","html_url":"https://github.com/isaaccp","followers_url":"https://api.github.com/users/isaaccp/followers","following_url":"https://api.github.com/users/isaaccp/following{/other_user}","gists_url":"https://api.github.com/users/isaaccp/gists{/gist_id}","starred_url":"https://api.github.com/users/isaaccp/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/isaaccp/subscriptions","organizations_url":"https://api.github.com/users/isaaccp/orgs","repos_url":"https://api.github.com/users/isaaccp/repos","events_url":"https://api.github.com/users/isaaccp/events{/privacy}","received_events_url":"https://api.github.com/users/isaaccp/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-05-13T02:06:22Z","updated_at":"2025-05-13T02:06:22Z","body":"Hm, more worker threads with slightly different stacks:\n\n![Image](https://github.com/user-attachments/assets/b69602d6-38a5-4266-bcd4-c7796912cba4)\n\n![Image](https://github.com/user-attachments/assets/cfd74123-8f11-46bc-9d3e-73875bb21bc4)\n\nThe rest of the worker threads seem to all have this stack or some stacks similar to the ones above:\n\n![Image](https://github.com/user-attachments/assets/761f6ea7-2e5d-4c5b-b329-e98dc70ee44e)","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2874811684/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2874846549","html_url":"https://github.com/godotengine/godot/issues/104796#issuecomment-2874846549","issue_url":"https://api.github.com/repos/godotengine/godot/issues/104796","id":2874846549,"node_id":"IC_kwDOAO6SJc6rWq1V","user":{"login":"isaaccp","id":8712,"node_id":"MDQ6VXNlcjg3MTI=","avatar_url":"https://avatars.githubusercontent.com/u/8712?v=4","gravatar_id":"","url":"https://api.github.com/users/isaaccp","html_url":"https://github.com/isaaccp","followers_url":"https://api.github.com/users/isaaccp/followers","following_url":"https://api.github.com/users/isaaccp/following{/other_user}","gists_url":"https://api.github.com/users/isaaccp/gists{/gist_id}","starred_url":"https://api.github.com/users/isaaccp/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/isaaccp/subscriptions","organizations_url":"https://api.github.com/users/isaaccp/orgs","repos_url":"https://api.github.com/users/isaaccp/repos","events_url":"https://api.github.com/users/isaaccp/events{/privacy}","received_events_url":"https://api.github.com/users/isaaccp/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-05-13T02:24:38Z","updated_at":"2025-05-13T02:24:38Z","body":"Those are all the different traces in text format: https://pastebin.com/raw/fZ77cbgS","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2874846549/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2874913577","html_url":"https://github.com/godotengine/godot/issues/104796#issuecomment-2874913577","issue_url":"https://api.github.com/repos/godotengine/godot/issues/104796","id":2874913577,"node_id":"IC_kwDOAO6SJc6rW7Mp","user":{"login":"isaaccp","id":8712,"node_id":"MDQ6VXNlcjg3MTI=","avatar_url":"https://avatars.githubusercontent.com/u/8712?v=4","gravatar_id":"","url":"https://api.github.com/users/isaaccp","html_url":"https://github.com/isaaccp","followers_url":"https://api.github.com/users/isaaccp/followers","following_url":"https://api.github.com/users/isaaccp/following{/other_user}","gists_url":"https://api.github.com/users/isaaccp/gists{/gist_id}","starred_url":"https://api.github.com/users/isaaccp/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/isaaccp/subscriptions","organizations_url":"https://api.github.com/users/isaaccp/orgs","repos_url":"https://api.github.com/users/isaaccp/repos","events_url":"https://api.github.com/users/isaaccp/events{/privacy}","received_events_url":"https://api.github.com/users/isaaccp/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-05-13T02:51:56Z","updated_at":"2025-05-13T02:51:56Z","body":"Something is off with the multi-threaded reimport.\n\nOne thread was stuck waiting for the semaphore. Many others were stuck trying to run _reimport_thread.\n\nDisabling multiple threads when reimporting in editor_file_system.cpp fixes the issue:\n\n![Image](https://github.com/user-attachments/assets/5b5c0636-0289-4a98-b973-e8ea78ecd253)\n\nI guess something is wrong with the thread logic around https://github.com/godotengine/godot/blob/db6634352870de6a7e2f43dbac8cd74288b24743/editor/editor_file_system.cpp#L3247 ","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2874913577/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2874920434","html_url":"https://github.com/godotengine/godot/issues/104796#issuecomment-2874920434","issue_url":"https://api.github.com/repos/godotengine/godot/issues/104796","id":2874920434,"node_id":"IC_kwDOAO6SJc6rW83y","user":{"login":"isaaccp","id":8712,"node_id":"MDQ6VXNlcjg3MTI=","avatar_url":"https://avatars.githubusercontent.com/u/8712?v=4","gravatar_id":"","url":"https://api.github.com/users/isaaccp","html_url":"https://github.com/isaaccp","followers_url":"https://api.github.com/users/isaaccp/followers","following_url":"https://api.github.com/users/isaaccp/following{/other_user}","gists_url":"https://api.github.com/users/isaaccp/gists{/gist_id}","starred_url":"https://api.github.com/users/isaaccp/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/isaaccp/subscriptions","organizations_url":"https://api.github.com/users/isaaccp/orgs","repos_url":"https://api.github.com/users/isaaccp/repos","events_url":"https://api.github.com/users/isaaccp/events{/privacy}","received_events_url":"https://api.github.com/users/isaaccp/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-05-13T02:58:01Z","updated_at":"2025-05-13T02:58:01Z","body":"For the OP, you can try if setting:\n\n```\n[editor]\n\nimport/use_multiple_threads=false\n```\n\nin your project.godot file fixes the problem.\n\nIt fixes the issue for me.\n\n","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2874920434/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2876357194","html_url":"https://github.com/godotengine/godot/issues/104796#issuecomment-2876357194","issue_url":"https://api.github.com/repos/godotengine/godot/issues/104796","id":2876357194,"node_id":"IC_kwDOAO6SJc6rcbpK","user":{"login":"isaaccp","id":8712,"node_id":"MDQ6VXNlcjg3MTI=","avatar_url":"https://avatars.githubusercontent.com/u/8712?v=4","gravatar_id":"","url":"https://api.github.com/users/isaaccp","html_url":"https://github.com/isaaccp","followers_url":"https://api.github.com/users/isaaccp/followers","following_url":"https://api.github.com/users/isaaccp/following{/other_user}","gists_url":"https://api.github.com/users/isaaccp/gists{/gist_id}","starred_url":"https://api.github.com/users/isaaccp/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/isaaccp/subscriptions","organizations_url":"https://api.github.com/users/isaaccp/orgs","repos_url":"https://api.github.com/users/isaaccp/repos","events_url":"https://api.github.com/users/isaaccp/events{/privacy}","received_events_url":"https://api.github.com/users/isaaccp/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-05-13T12:42:48Z","updated_at":"2025-05-16T14:33:43Z","body":"Some extra details.\n\nWhen hanging in editor_file_system.cpp, both of the groups_to_reimport are spritesheets:\n![Image](https://github.com/user-attachments/assets/6988b7fe-3bb7-45fb-964a-18eb2a95e232)\n\nAll the _reimport_threads I have seen are stuck trying to load a texture that has an atlas, and all of them are hitting this method (ResourceImporterTextureAtlas::import) that indicates something is wrong:\n\n![Image](https://github.com/user-attachments/assets/99d5b36f-3d03-45ae-a328-12ed77a4a8ae)\n\nThis only happens with some of the textures using the same spritesheet, not all of them:\n* All textures in https://github.com/isaaccp/defense/tree/main/assets/white_slash_wide\n* swiftness.png and attack_boost.png in https://github.com/isaaccp/defense/tree/main/assets/status/buffs\n* paralyzed.png in https://github.com/isaaccp/defense/tree/main/assets/status/debuffs\n\nWhen I load the project using single threaded (which causes it to not hang), those files still show up as broken in the editor, but Reimporting them one-by-one works fine.\n\nIf I delete assets/white_slash_wide, assets/status/buffs and assets/status/debuffs, the project loads correctly using the multi-threaded import, so the issue seems to be related to spritesheets/those files.\n\nMy current best guess is that the reimport_files method, which runs on the main thread, doesn't expect anything in the import thread to require the main thread, but the \"broken\" texture atlas causes the method to call Image::get_texture which calls texture_2d_get from rendering server and that seems to require using the main thread? (I see that _flush is the only method increasing sync and that's only called from main thread as far as I can see)\n\nPS: Note that my project at HEAD has [editor] import/use_multiple_threads=false set, so if you try to use it to reproduce/debug, make sure to remove that.\n\n\n","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2876357194/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2886918216","html_url":"https://github.com/godotengine/godot/issues/104796#issuecomment-2886918216","issue_url":"https://api.github.com/repos/godotengine/godot/issues/104796","id":2886918216,"node_id":"IC_kwDOAO6SJc6sEuBI","user":{"login":"isaaccp","id":8712,"node_id":"MDQ6VXNlcjg3MTI=","avatar_url":"https://avatars.githubusercontent.com/u/8712?v=4","gravatar_id":"","url":"https://api.github.com/users/isaaccp","html_url":"https://github.com/isaaccp","followers_url":"https://api.github.com/users/isaaccp/followers","following_url":"https://api.github.com/users/isaaccp/following{/other_user}","gists_url":"https://api.github.com/users/isaaccp/gists{/gist_id}","starred_url":"https://api.github.com/users/isaaccp/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/isaaccp/subscriptions","organizations_url":"https://api.github.com/users/isaaccp/orgs","repos_url":"https://api.github.com/users/isaaccp/repos","events_url":"https://api.github.com/users/isaaccp/events{/privacy}","received_events_url":"https://api.github.com/users/isaaccp/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-05-16T14:40:17Z","updated_at":"2025-05-17T01:19:18Z","body":"Okay, I looked a bit closer and:\n\nBefore attempting to import, I have a bunch of texture_atlas belonging to 3 spritesheets, all with\n\n```\nvalid = true\ngroup_file = ...\n```\nin the .import file.\n\nSomehow during the initial import, the texture_atlas assets that are referenced by gdscript/nodes fail to import (not sure why and the .import file is updated to remove:\n\n```\nvalid = true\ngroup_file=...\n```\n\nYou can see the diff at this point between two assets:\n![Image](https://github.com/user-attachments/assets/bc867ce5-e79a-4d45-85de-5c6180be5de0)\n\nThen something invokes reimport_files. At that point, the assets that still have group_file= ... and valid=true get added to groups_to_reimport, but the ones that don't, get added to reimport_files with importer=texture_atlas:\n\n![Image](https://github.com/user-attachments/assets/6ebcabfa-027c-4475-96da-284af0310581)\n\nThis causes ResourceImporterTextureAtlas::import to be called which ends up deadlocking in multi-thread as explained in the previous comment.\n\nSo it seems like there are two issues:\n* assets that use texture_atlas fail to import and end up as \"broken\" assets\n* reimport_files deadlocks when trying to load those assets","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2886918216/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2888465132","html_url":"https://github.com/godotengine/godot/issues/104796#issuecomment-2888465132","issue_url":"https://api.github.com/repos/godotengine/godot/issues/104796","id":2888465132,"node_id":"IC_kwDOAO6SJc6sKnrs","user":{"login":"isaaccp","id":8712,"node_id":"MDQ6VXNlcjg3MTI=","avatar_url":"https://avatars.githubusercontent.com/u/8712?v=4","gravatar_id":"","url":"https://api.github.com/users/isaaccp","html_url":"https://github.com/isaaccp","followers_url":"https://api.github.com/users/isaaccp/followers","following_url":"https://api.github.com/users/isaaccp/following{/other_user}","gists_url":"https://api.github.com/users/isaaccp/gists{/gist_id}","starred_url":"https://api.github.com/users/isaaccp/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/isaaccp/subscriptions","organizations_url":"https://api.github.com/users/isaaccp/orgs","repos_url":"https://api.github.com/users/isaaccp/repos","events_url":"https://api.github.com/users/isaaccp/events{/privacy}","received_events_url":"https://api.github.com/users/isaaccp/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-05-17T15:44:42Z","updated_at":"2025-05-17T15:44:42Z","body":"I tried to see where things go wrong for e.g. swiftness.png import.\n\nI set a breakpoint on _reimport_file() and the first invocation of that method is precisely for assets/status/buffs/swiftness.png.\n\nAt that point the .import file still hasn't been changed on the filesystem.\n\nThis is the call stack:\nhttps://pastebin.com/P0CR6Jj2\n\nIt's loading autoloads:\n\n![Image](https://github.com/user-attachments/assets/1b56dab3-0fba-417f-9647-74985a41a343)\n\nAnd there is a dependency chain of multiple imports:\n\nautoload/skill_manager.gd -> res://skill_tree/skill_type_collections/action_collection.tres -> res://behavior/actions/charge_action.gd -> res://effects/statuses/swiftness.tres -> res://assets/status/buffs/swiftness.png\n\nWhen _reimport_file() is called it sees that importer=texture_atlas, obtains the ResourceImporterTextureAtlas() and then calls \"import\" on it, which, as mentioned above it's not expected and results in a broken image:\nhttps://github.com/godotengine/godot/blob/0d8f33a74a1071c93083c07e91882f7e67880675/editor/import/resource_importer_textu\nre_atlas.cpp#L94\n\nIt seems like the expectation is that for texture_atlas resources we always call ResourceImporterTextureAtlas::import_group_file() instead:\nhttps://github.com/godotengine/godot/blob/0d8f33a74a1071c93083c07e91882f7e67880675/editor/import/resource_importer_texture_atlas.cpp#L195\n\nThis is handled appropriately in EditorFileSystem::reimport_files: https://github.com/godotengine/godot/blob/0d8f33a74a1071c93083c07e91882f7e67880675/editor/editor_file_system.cpp#L3155\nbut when not when loading during the initial launch.\n\nIn addition, and critically, when writing re-writing the .import file in reimport_file, it drops the group_file=... and valid=true values that were present in the original .import file:\nhttps://github.com/godotengine/godot/blob/0d8f33a74a1071c93083c07e91882f7e67880675/editor/editor_file_system.cpp#L2872\n\nThis is why during the later reimport_files() invocation this is again attempted to be loaded without the group_file=..., which triggers again the broken ResourceImporterTextureAtlas::import() path, which in that context deadlocks due to the call to rendering server.\n\nI think fixing _reimport_file() to keep group_file if present should fix the issue with the assets.\n\nI think it would still be good to do something to fix the deadlock in case someone ends in a similar situation.\n","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2888465132/reactions","total_count":1,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":1,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2888480870","html_url":"https://github.com/godotengine/godot/issues/104796#issuecomment-2888480870","issue_url":"https://api.github.com/repos/godotengine/godot/issues/104796","id":2888480870,"node_id":"IC_kwDOAO6SJc6sKrhm","user":{"login":"isaaccp","id":8712,"node_id":"MDQ6VXNlcjg3MTI=","avatar_url":"https://avatars.githubusercontent.com/u/8712?v=4","gravatar_id":"","url":"https://api.github.com/users/isaaccp","html_url":"https://github.com/isaaccp","followers_url":"https://api.github.com/users/isaaccp/followers","following_url":"https://api.github.com/users/isaaccp/following{/other_user}","gists_url":"https://api.github.com/users/isaaccp/gists{/gist_id}","starred_url":"https://api.github.com/users/isaaccp/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/isaaccp/subscriptions","organizations_url":"https://api.github.com/users/isaaccp/orgs","repos_url":"https://api.github.com/users/isaaccp/repos","events_url":"https://api.github.com/users/isaaccp/events{/privacy}","received_events_url":"https://api.github.com/users/isaaccp/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-05-17T16:25:45Z","updated_at":"2025-05-17T22:55:46Z","body":"I am wondering which is the best option to address this:\n* update _reimport_file so it keeps the group_file= attribute and let this be handled in _reimport_files()\n* update _load_resource_on_startup so if a resource has a group_file attribute we call _reimport_group() instead\n\nUpdate: the latter doesn't seem feasible because during _load_resource_on_startup  we haven't scanned the filesystem yet, so we can't easily find the other files belonging to the group yet.\n\nSent a PR doing the first one, which fixes the issue.","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2888480870/reactions","total_count":1,"+1":0,"-1":0,"laugh":0,"hooray":1,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null}]