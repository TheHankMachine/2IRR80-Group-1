:null,"archived_by":null}],"state":"closed","locked":false,"assignees":[],"milestone":{"url":"https://api.github.com/repos/godotengine/godot/milestones/25","html_url":"https://github.com/godotengine/godot/milestone/25","labels_url":"https://api.github.com/repos/godotengine/godot/milestones/25/labels","id":15520464,"node_id":"MI_kwDOAO6SJc4A7NLQ","number":25,"title":"4.8","description":"","creator":{"login":"Repiteo","id":17489292,"node_id":"MDQ6VXNlcjE3NDg5Mjky","avatar_url":"https://avatars.githubusercontent.com/u/17489292?v=4","gravatar_id":"","url":"https://api.github.com/users/Repiteo","html_url":"https://github.com/Repiteo","followers_url":"https://api.github.com/users/Repiteo/followers","following_url":"https://api.github.com/users/Repiteo/following{/other_user}","gists_url":"https://api.github.com/users/Repiteo/gists{/gist_id}","starred_url":"https://api.github.com/users/Repiteo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Repiteo/subscriptions","organizations_url":"https://api.github.com/users/Repiteo/orgs","repos_url":"https://api.github.com/users/Repiteo/repos","events_url":"https://api.github.com/users/Repiteo/events{/privacy}","received_events_url":"https://api.github.com/users/Repiteo/received_events","type":"User","user_view_type":"public","site_admin":false},"open_issues":346,"closed_issues":2304,"state":"open","created_at":"2026-04-13T15:59:35Z","updated_at":"2026-10-21T09:34:58Z","due_on":null,"closed_at":null},"comments":11,"created_at":"2025-11-07T01:28:11Z","updated_at":"2026-10-20T12:01:50Z","closed_at":"2026-10-19T20:57:32Z","assignee":null,"author_association":"CONTRIBUTOR","issue_field_values":[],"type":null,"active_lock_reason":null,"draft":false,"pull_request":{"url":"https://api.github.com/repos/godotengine/godot/pulls/112490","html_url":"https://github.com/godotengine/godot/pull/112490","diff_url":"https://github.com/godotengine/godot/pull/112490.diff","patch_url":"https://github.com/godotengine/godot/pull/112490.patch","merged_at":"2026-10-19T20:57:32Z"},"body":"This function increments the code index by 2 when a line continuation is found, additional to the loop increment, so it skips over the next character following a line continuation.\r\n\r\nIn shader code like\r\n\r\n```glsl\r\n#define FUN_FUN(n)\\\r\nvoid fun1() { return;\\\r\n}\\\r\nvoid fun2() { return; }\r\nFUN_FUN(1.0)\r\n```\r\n\r\nthe first `}` will visibly get skipped, causing this error:\r\n\r\n```\r\n   10 | \r\nE  11->  void fun1() { return;void fun2() { return; } \r\n   12 |\r\n```\r\n\r\nThe `v` in `void` will also get skipped over, but as the next `o` is enough to decide to end the loop, that is less obvious.\r\n\r\nSimplify consume_line_continuations() to remove the unnecessary offset parameter and the extra loop index variable, and increment index the right amount.\r\n\r\n<!--\r\nPlease target the `master` branch in priority.\r\n\r\nRelevant fixes are cherry-picked for stable branches as needed by maintainers.\r\n\r\nTo speed up the contribution process and avoid CI errors, please set up pre-commit hooks locally:\r\nhttps://contributing.godotengine.org/en/latest/engine/guidelines/code_style.html\r\n-->\r\n","closed_by":{"login":"Repiteo","id":17489292,"node_id":"MDQ6VXNlcjE3NDg5Mjky","avatar_url":"https://avatars.githubusercontent.com/u/17489292?v=4","gravatar_id":"","url":"https://api.github.com/users/Repiteo","html_url":"https://github.com/Repiteo","followers_url":"https://api.github.com/users/Repiteo/followers","following_url":"https://api.github.com/users/Repiteo/following{/other_user}","gists_url":"https://api.github.com/users/Repiteo/gists{/gist_id}","starred_url":"https://api.github.com/users/Repiteo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Repiteo/subscriptions","organizations_url":"https://api.github.com/users/Repiteo/orgs","repos_url":"https://api.github.com/users/Repiteo/repos","events_url":"https://api.github.com/users/Repiteo/events{/privacy}","received_events_url":"https://api.github.com/users/Repiteo/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/112490/reactions","total_count":2,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":1,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/godotengine/godot/issues/112490/timeline","performed_via_github_app":null,"state_reason":null}