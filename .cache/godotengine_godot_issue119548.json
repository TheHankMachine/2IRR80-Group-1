b.com/users/akien-mga/repos","events_url":"https://api.github.com/users/akien-mga/events{/privacy}","received_events_url":"https://api.github.com/users/akien-mga/received_events","type":"User","user_view_type":"public","site_admin":false},"open_issues":3,"closed_issues":2535,"state":"closed","created_at":"2025-11-27T20:29:18Z","updated_at":"2026-10-20T18:39:31Z","due_on":null,"closed_at":"2026-06-19T16:54:35Z"},"comments":10,"created_at":"2026-05-18T16:00:07Z","updated_at":"2026-05-20T12:44:04Z","closed_at":"2026-05-19T16:22:56Z","assignee":{"login":"bruvzg","id":7645683,"node_id":"MDQ6VXNlcjc2NDU2ODM=","avatar_url":"https://avatars.githubusercontent.com/u/7645683?v=4","gravatar_id":"","url":"https://api.github.com/users/bruvzg","html_url":"https://github.com/bruvzg","followers_url":"https://api.github.com/users/bruvzg/followers","following_url":"https://api.github.com/users/bruvzg/following{/other_user}","gists_url":"https://api.github.com/users/bruvzg/gists{/gist_id}","starred_url":"https://api.github.com/users/bruvzg/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/bruvzg/subscriptions","organizations_url":"https://api.github.com/users/bruvzg/orgs","repos_url":"https://api.github.com/users/bruvzg/repos","events_url":"https://api.github.com/users/bruvzg/events{/privacy}","received_events_url":"https://api.github.com/users/bruvzg/received_events","type":"User","user_view_type":"public","site_admin":false},"author_association":"CONTRIBUTOR","issue_field_values":[],"type":null,"active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"### Tested versions\n\n4.6 stable\n(I don't remember this occurring before)\n\n### System information\n\nnixos-unstable\n\n### Issue description\n\nMy translation table has a column at the end where \"notes\" for my translators go. These are basically just annotations to help them understand the meaning of some of my words.\n\nThis makes the \"en\" translation specifically fail.\nIt does not fail when I renamed \"en\" to \"fu\" in frustration.\nIt does not fail when all the fields in \"notes\" have a value.\nIt also does not fail when \"notes\" is renamed to \"nt\"\n\n## Workaround\nIf you're experiencing this in the wild: make sure all your table heads have two letters only. If that does not help: try renaming \"en\" to something else and then load that translation explicitly if the OS demands English as a last resort.\n\n### Steps to reproduce\n\n1. open project and \"translate_me\"-scene\n2. enable the English live preview\n3. translate_me is not translated\n4. switch to German\n5. \"Übersetz mich\" is translated!\n6. optional: use the included internationalization file to reproduce some of my own things.\n\n#### Errors\nRe-importing the translation file causes `ERROR: core/string/optimized_translation.cpp:152 - Condition \"bucket_table_size == 0\" is true.` to be raised.\n\n### Minimal reproduction project (MRP)\n\n[i18n-testing.zip](https://github.com/user-attachments/files/27966825/i18n-testing.zip)\n\n## Notes\n> *hehehe, see what I did there?*\n\nSo this is clearly a very silly and not the most critical bug.\n\nI would still advise this to be assigned a relative high priority, because it is kind of likely to occur in the world, as having a column dedicated for notes in your i18n table is not that uncommon. And it also is the kind of bug that really drives you up the walls when it occurs right before I don't know ... a critical deadline when you have to record a trailer and all the labels are broken and  ... you cannot believe the headache this has given me.\n\nI filed a seperate bug about it not working even when that invalid table has an underscore, as recommended in the docs.","closed_by":{"login":"Repiteo","id":17489292,"node_id":"MDQ6VXNlcjE3NDg5Mjky","avatar_url":"https://avatars.githubusercontent.com/u/17489292?v=4","g