+/Mobile)</th>\r\n  </tr>\r\n  <tr>\r\n    <td>\r\n      <img src=\"https://github.com/user-attachments/assets/f1e32e14-32fc-440c-a1fc-1db092672d51\" width=\"100%\" alt=\"Before View\" />\r\n    </td>\r\n    <td>\r\n      <img src=\"https://github.com/user-attachments/assets/07b92dc3-aa55-47c1-91ab-eb1c28cd9503\" width=\"100%\" alt=\"After View\" />\r\n    </td>\r\n  </tr>\r\n</table>\r\n\r\n### AI Disclosure:\r\nThis PR doesn't use AI, it's all human written code & same goes for the desc 🙃\r\n\r\n","closed_by":{"login":"Repiteo","id":17489292,"node_id":"MDQ6VXNlcjE3NDg5Mjky","avatar_url":"https://avatars.githubusercontent.com/u/17489292?v=4","gravatar_id":"","url":"https://api.github.com/users/Repiteo","html_url":"https://github.com/Repiteo","followers_url":"https://api.github.com/users/Repiteo/followers","following_url":"https://api.github.com/users/Repiteo/following{/other_user}","gists_url":"https://api.github.com/users/Repiteo/gists{/gist_id}","starred_url":"https://api.github.com/users/Repiteo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Repiteo/subscriptions","organizations_url":"https://api.github.com/users/Repiteo/orgs","repos_url":"https://api.github.com/users/Repiteo/repos","events_url":"https://api.github.com/users/Repiteo/events{/privacy}","received_events_url":"https://api.github.com/users/Repiteo/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/122474/reactions","total_count":1,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":1},"timeline_url":"https://api.github.com/repos/godotengine/godot/issues/122474/timeline","performed_via_github_app":null,"state_reason":null}