i.github.com/users/KoBeWi/gists{/gist_id}","starred_url":"https://api.github.com/users/KoBeWi/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/KoBeWi/subscriptions","organizations_url":"https://api.github.com/users/KoBeWi/orgs","repos_url":"https://api.github.com/users/KoBeWi/repos","events_url":"https://api.github.com/users/KoBeWi/events{/privacy}","received_events_url":"https://api.github.com/users/KoBeWi/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-07-06T14:53:46Z","updated_at":"2025-07-06T14:53:46Z","body":"Sorry, I realized I forgot to check cpp files too. I added more changes.","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3041892562/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3062363840","html_url":"https://github.com/godotengine/godot/pull/108340#issuecomment-3062363840","issue_url":"https://api.github.com/repos/godotengine/godot/issues/108340","id":3062363840,"node_id":"IC_kwDOAO6SJc62h_bA","user":{"login":"mihe","id":4884246,"node_id":"MDQ6VXNlcjQ4ODQyNDY=","avatar_url":"https://avatars.githubusercontent.com/u/4884246?v=4","gravatar_id":"","url":"https://api.github.com/users/mihe","html_url":"https://github.com/mihe","followers_url":"https://api.github.com/users/mihe/followers","following_url":"https://api.github.com/users/mihe/following{/other_user}","gists_url":"https://api.github.com/users/mihe/gists{/gist_id}","starred_url":"https://api.github.com/users/mihe/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/mihe/subscriptions","organizations_url":"https://api.github.com/users/mihe/orgs","repos_url":"https://api.github.com/users/mihe/repos","events_url":"https://api.github.com/users/mihe/events{/privacy}","received_events_url":"https://api.github.com/users/mihe/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-07-11T13:33:14Z","updated_at":"2025-07-11T13:33:14Z","body":"I'm not sure if there's any real functional difference, but note that all the empty `virtual` destructors (e.g. `virtual ~SomeClass() {}`) can be expressed as `virtual ~SomeClass() = default` as well.\r\n\r\nIf for some reason the definition needs to be in a `*.cpp` file, you can even define it using `SomeClass::~SomeClass() = default`.\r\n\r\nAs far as I can tell, even just declaring `~SomeClass() = default` (without the `virtual`) will still cause the type's move constructor/assignment to be omitted (per the rule-of-five) so I don't think there's any real benefit to using `= default`, but I would maybe argue it looks a bit more proper.\r\n\r\nJust figured I'd mention it.","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3062363840/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3062515440","html_url":"https://github.com/godotengine/godot/pull/108340#issuecomment-3062515440","issue_url":"https://api.github.com/repos/godotengine/godot/issues/108340","id":3062515440,"node_id":"IC_kwDOAO6SJc62ikbw","user":{"login":"KoBeWi","id":2223172,"node_id":"MDQ6VXNlcjIyMjMxNzI=","avatar_url":"https://avatars.githubusercontent.com/u/2223172?v=4","gravatar_id":"","url":"https://api.github.com/users/KoBeWi","html_url":"https://github.com/KoBeWi","followers_url":"https://api.github.com/users/KoBeWi/followers","following_url":"https://api.github.com/users/KoBeWi/following{/other_user}","gists_url":"https://api.github.com/users/KoBeWi/gists{/gist_id}","starred_url":"https://api.github.com/users/KoBeWi/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/KoBeWi/subscriptions","organizations_url":"https://api.github.com/users/KoBeWi/orgs","repos_url":"https://api.github.com/users/KoBeWi/repos","events_url":"https://api.github.com/users/KoBeWi/events{/privacy}","received_events_url":"https://api.github.com/users/KoBeWi/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-07-11T14:17:17Z","updated_at":"2025-07-11T14:17:17Z","body":"AFAIK there is no difference between `{}` and `= default`.","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3062515440/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3062584456","html_url":"https://github.com/godotengine/godot/pull/108340#issuecomment-3062584456","issue_url":"https://api.github.com/repos/godotengine/godot/issues/108340","id":3062584456,"node_id":"IC_kwDOAO6SJc62i1SI","user":{"login":"mihe","id":4884246,"node_id":"MDQ6VXNlcjQ4ODQyNDY=","avatar_url":"https://avatars.githubusercontent.com/u/4884246?v=4","gravatar_id":"","url":"https://api.github.com/users/mihe","html_url":"https://github.com/mihe","followers_url":"https://api.github.com/users/mihe/followers","following_url":"https://api.github.com/users/mihe/following{/other_user}","gists_url":"https://api.github.com/users/mihe/gists{/gist_id}","starred_url":"https://api.github.com/users/mihe/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/mihe/subscriptions","organizations_url":"https://api.github.com/users/mihe/orgs","repos_url":"https://api.github.com/users/mihe/repos","events_url":"https://api.github.com/users/mihe/events{/privacy}","received_events_url":"https://api.github.com/users/mihe/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-07-11T14:38:25Z","updated_at":"2025-07-11T14:38:25Z","body":"> AFAIK there is no difference between `{}` and `= default`.\r\n\r\nIf you mean generally speaking, then yes, there is. Even an empty constructor will make a type not be trivially constructible, as opposed to using `default`:\r\n\r\n```cpp\r\nclass MyFirstClass {\r\n    MyFirstClass() = default;\r\n};\r\n\r\nclass MySecondClass {\r\n    MySecondClass() {}\r\n};\r\n\r\nstatic_assert(std::is_trivially_constructible_v<MyFirstClass>); // Pass\r\nstatic_assert(std::is_trivially_constructible_v<MySecondClass>); // Fail\r\n```\r\n\r\nIn the context of destructors (without the `virtual` modifier) it impacts whether the type is trivially copyable:\r\n\r\n```cpp\r\nclass MyFirstClass {\r\n    ~MyFirstClass() = default;\r\n};\r\n\r\nclass MySecondClass {\r\n    ~MySecondClass() {}\r\n};\r\n\r\nstatic_assert(std::is_trivially_copyable_v<MyFirstClass>); // Pass\r\nstatic_assert(std::is_trivially_copyable_v<MySecondClass>); // Fail\r\n```\r\n\r\nBut yes, in the context of `virtual` destructors specifically, I'm not sure there is any real functional difference.","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3062584456/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3534463053","html_url":"https://github.com/godotengine/godot/pull/108340#issuecomment-3534463053","issue_url":"https://api.github.com/repos/godotengine/godot/issues/108340","id":3534463053,"node_id":"IC_kwDOAO6SJc7Sq6BN","user":{"login":"Repiteo","id":17489292,"node_id":"MDQ6VXNlcjE3NDg5Mjky","avatar_url":"https://avatars.githubusercontent.com/u/17489292?v=4","gravatar_id":"","url":"https://api.github.com/users/Repiteo","html_url":"https://github.com/Repiteo","followers_url":"https://api.github.com/users/Re