github.com/users/Repiteo/repos","events_url":"https://api.github.com/users/Repiteo/events{/privacy}","received_events_url":"https://api.github.com/users/Repiteo/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-11-17T17:15:35Z","updated_at":"2025-11-17T17:15:35Z","body":"```\r\nError: scene/gui/text_edit.cpp:775:8: error: unused variable 'selection_start' [-Werror,-Wunused-variable]\r\n  775 |                         RID selection_start;\r\n      |                             ^~~~~~~~~~~~~~~\r\nError: scene/gui/text_edit.cpp:776:8: error: unused variable 'selection_end' [-Werror,-Wunused-variable]\r\n  776 |                         RID selection_end;\r\n      |                             ^~~~~~~~~~~~~\r\n```\r\nLooks like turning `RID` to a trivial constructor made it so unused variables are found during compilation","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3543016538/reactions","total_count":1,"+1":0,"-1":0,"laugh":1,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3544656060","html_url":"https://github.com/godotengine/godot/pull/108340#issuecomment-3544656060","issue_url":"https://api.github.com/repos/godotengine/godot/issues/108340","id":3544656060,"node_id":"IC_kwDOAO6SJc7TRyi8","user":{"login":"Repiteo","id":17489292,"node_id":"MDQ6VXNlcjE3NDg5Mjky","avatar_url":"https://avatars.githubusercontent.com/u/17489292?v=4","gravatar_id":"","url":"https://api.github.com/users/Repiteo","html_url":"https://github.com/Repiteo","followers_url":"https://api.github.com/users/Repiteo/followers","following_url":"https://api.github.com/users/Repiteo/following{/other_user}","gists_url":"https://api.github.com/users/Repiteo/gists{/gist_id}","starred_url":"https://api.github.com/users/Repiteo/starred{/owner}{/repo}","subscriptions_url