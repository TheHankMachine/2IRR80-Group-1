[{"id":3874407125,"node_id":"PRR_kwDOAO6SJc7m7sLV","state":"COMMENTED","user":{"site_admin":false,"suspended":false,"updated_at":"0001-01-01T00:00:00Z","avatar_url":"https://avatars.githubusercontent.com/u/7645683?u=2867ee7fcd920bc19b7d1cbf4b10264b9bbc9326&v=4","created_at":"0001-01-01T00:00:00Z","followers":0,"following":0,"html_url":"https://github.com/bruvzg","id":7645683,"node_id":"MDQ6VXNlcjc2NDU2ODM=","login":"bruvzg","type":"User","owned_private_repos":0,"public_gists":0,"public_repos":0,"total_private_repos":0,"url":"https://api.github.com/users/bruvzg"},"body":"Code looks good. No idea if there's a necessity for having the signal/notification.","html_url":"https://github.com/godotengine/godot/pull/115666#pullrequestreview-3874407125","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/115666","author_association":"MEMBER","submitted_at":"2026-03-02T06:57:29Z"},{"id":3946504468,"node_id":"PRR_kwDOAO6SJc7rOuEU","state":"COMMENTED","user":{"site_admin":false,"suspended":false,"updated_at":"0001-01-01T00:00:00Z","avatar_url":"https://avatars.githubusercontent.com/u/17506573?u=6e9313e254649f6dc55e92536596487ac10bf5a2&v=4","created_at":"0001-01-01T00:00:00Z","followers":0,"following":0,"html_url":"https://github.com/allenwp","id":17506573,"node_id":"MDQ6VXNlcjE3NTA2NTcz","login":"allenwp","type":"User","owned_private_repos":0,"public_gists":0,"public_repos":0,"total_private_repos":0,"url":"https://api.github.com/users/allenwp"},"body":"This is really great!! Thanks! I believe this would be extremely valuable to developers and it would be great to have this for 4.7.\n\nI haven't tested this as thoroughly as I normally would, but this seems like something that's pretty simple and will be easy to bug fix if there are any edge cases that are discovered after merging.\n\nI've left a couple of comments about the documentation and signal/constant naming.\n\n> No idea if there's a necessity for having the signal/notification.\n\n@bruvzg Currently the developer must poll this value every frame, even though it may never change (if the player is using an SDR screen or an HDR screen that has a stable brightness setting). An example of the current approach is shown in the documentation here: https://docs.godotengine.org/en/latest/tutorials/rendering/hdr_output.html#using-output-max-linear-value\n\nSo I think the signal is valuable in addition to the other events?? You might want to hook a shader uniform up to this value... does a signal help with this? I really am not the one to make the call on this, so if someone else wants to jump in who is more well versed in what justifies a signal and what doesn't, please do so.","html_url":"https://github.com/godotengine/godot/pull/115666#pullrequestreview-3946504468","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/115666","author_association":"CONTRIBUTOR","submitted_at":"2026-03-13T20:10:38Z"},{"id":3986854991,"node_id":"PRR_kwDOAO6SJc7topRP","state":"COMMENTED","user":{"site_admin":false,"suspended":false,"updated_at":"0001-01-01T00:00:00Z","avatar_url":"https://avatars.githubusercontent.com/u/1929107?v=4","created_at":"0001-01-01T00:00:00Z","followers":0,"following":0,"html_url":"https://github.com/DarkKilauea","id":1929107,"node_id":"MDQ6VXNlcjE5MjkxMDc=","login":"DarkKilauea","type":"User","owned_private_repos":0,"public_gists":0,"public_repos":0,"total_private_repos":0,"url":"https://api.github.com/users/DarkKilauea"},"body":"","html_url":"https://github.com/godotengine/godot/pull/115666#pullrequestreview-3986854991","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/115666","author_association":"CONTRIBUTOR","submitted_at":"2026-03-21T21:19:39Z"},{"id":3986855191,"node_id":"PRR_kwDOAO6SJc7topUX","state":"COMMENTED","user":{"site_admin":false,"suspended":false,"updated_at":"0001-01-01T00:00:00Z","avatar_url":"https://avatars.githubusercontent.com/u/1929107?v=4","created_at":"0001-01-01T00:00:00Z","followers":0,"following":