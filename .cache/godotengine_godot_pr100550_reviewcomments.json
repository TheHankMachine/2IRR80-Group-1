` which can only be generated manually, I think it makes no sense, users don't create them manually.","created_at":"2025-01-03T19:33:09Z","updated_at":"2025-01-03T19:33:09Z","html_url":"https://github.com/godotengine/godot/pull/100550#discussion_r1902102285","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/100550","_links":{"self":{"href":"https://api.github.com/repos/godotengine/godot/pulls/comments/1902102285"},"html":{"href":"https://github.com/godotengine/godot/pull/100550#discussion_r1902102285"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/100550"}},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/1902102285/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":1,"original_line":1,"side":"RIGHT","author_association":"CONTRIBUTOR","original_position":1,"position":1,"subject_type":"file"},{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/1902144915","pull_request_review_id":2529683472,"id":1902144915,"node_id":"PRRC_kwDOAO6SJc5xYG2T","diff_hunk":"","path":"modules/gdscript/tests/scripts/parser/features/lambda_at_eof_without_newline.bin.gdc","commit_id":"f34887988649ec980d07476c5704ad7e166f20e9","original_commit_id":"f34887988649ec980d07476c5704ad7e166f20e9","user":{"login":"Scrawach","id":40476180,"node_id":"MDQ6VXNlcjQwNDc2MTgw","avatar_url":"https://avatars.githubusercontent.com/u/40476180?v=4","gravatar_id":"","url":"https://api.github.com/users/Scrawach","html_url":"https://github.com/Scrawach","followers_url":"https://api.github.com/users/Scrawach/followers","following_url":"https://api.github.com/users/Scrawach/following{/other_user}","gists_url":"https://api.github.com/users/Scrawach/gists{/gist_id}","starred_url":"https://api.github.com/users/Scrawach/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Scr