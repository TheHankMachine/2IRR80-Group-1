nts/2684492961"},"html":{"href":"https://github.com/godotengine/godot/pull/114895#discussion_r2684492961"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/114895"}},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/2684492961/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":null,"original_line":303,"side":"RIGHT","author_association":"NONE","original_position":37,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/2687672461","pull_request_review_id":3657336697,"id":2687672461,"node_id":"PRRC_kwDOAO6SJc6gMqCN","diff_hunk":"@@ -208,6 +212,14 @@\n \t\t\t\t[b]Note:[/b] This feature is only supported on Windows, Linux, and macOS.\n \t\t\t</description>\n \t\t</method>\n+\t\t<method name=\"has_joy_vibration\" qualifiers=\"const\">\n+\t\t\t<return type=\"bool\" />\n+\t\t\t<param index=\"0\" name=\"device\" type=\"int\" />\n+\t\t\t<description>\n+\t\t\t\tReturns [code]true[/code] if the joypad supports vibration. See also [method start_joy_vibration].\n+\t\t\t\t[b]Note:[/b] For Android, joypad vibration is not supported due to OS restrictions. For macOS, vibration is only supported in macOS 11 and later.","path":"doc/classes/Input.xml","commit_id":"00a824aa57f863a067b27f9e724634166b5da012","original_commit_id":"00a824aa57f863a067b27f9e724634166b5da012","user":{"login":"Alex2782","id":41921395,"node_id":"MDQ6VXNlcjQxOTIxMzk1","avatar_url":"https://avatars.githubusercontent.com/u/41921395?v=4","gravatar_id":"","url":"https://api.github.com/users/Alex2782","html_url":"https://github.com/Alex2782","followers_url":"https://api.github.com/users/Alex2782/followers","following_url":"https://api.github.com/users/Alex2782/following{/other_user}","gists_url":"https://api.github.com/users/Alex2782/gists{/gist_id}","starred_url":"https://api.github.com/users/Alex2782/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Alex2782/subscriptions","organizations_url":"https://api.github.com/users/Alex2782/orgs","repos_url":"https://api.github.com/users/Alex2782/repos","events_url":"https://api.github.com/users/Alex2782/events{/privacy}","received_events_url":"https://api.github.com/users/Alex2782/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"On Android, we might be able to use `getVibratorIds` for this.\nhttps://developer.android.com/reference/android/os/VibratorManager#getVibratorIds()\n\nI last experimented with it about 2 years ago on Android, MacOS and Web.\nThe Xbox controller vibrator via Bluetooth was not properly recognized on any system (at the time MacOS 13), I heard it's due to Microsoft, the BT protocol is not open.\n\nThe Android API `getVibratorIds` returned an empty list. However, this function is only available from Android 12 onwards; I don't yet know if there are other options.\n\n---------------\n\n> is not supported due to OS restrictions\n\nI can confirm that vibrators can work on Android systems. I have an `NVIDIA SHIELD Android TV Pro Multimedia Player` (Android 9) with an `NVIDIA Shield Controller`, and it worked via Bluetooth. However, I haven't tried Godot apps on it yet.\n\n\n","created_at":"2026-01-13T18:54:07Z","updated_at":"2026-01-13T18:54:24Z","html_url":"https://github.com/godotengine/godot/pull/114895#discussion_r2687672461","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/114895","_links":{"self":{"href":"https://api.github.com/repos/godotengine/godot/pulls/comments/2687672461"},"html":{"href":"https://github.com/godotengine/godot/pull/114895#discussion_r2687672461"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/114895"}},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/2687672461/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":null,"original_line":220,"side":"RIGHT","author_association":"MEMBER","original_position":27,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/2687717451","pull_request_review_id":3657397220,"id":2687717451,"node_id":"PRRC_kwDOAO6SJc6gM1BL","diff_hunk":"@@ -208,6 +212,14 @@\n \t\t\t\t[b]Note:[/b] This feature is only supported on Windows, Linux, and macOS.\n \t\t\t</description>\n \t\t</method>\n+\t\t<method name=\"has_joy_vibration\" qualifiers=\"const\">\n+\t\t\t<return type=\"bool\" />\n+\t\t\t<param index=\"0\" name=\"device\" type=\"int\" />\n+\t\t\t<description>\n+\t\t\t\tReturns [code]true[/code] if the joypad supports vibration. See also [method start_joy_vibration].\n+\t\t\t\t[b]Note:[/b] For Android, joypad vibration is not supported due to OS restrictions. For macOS, vibration is only supported in macOS 11 and later.","path":"doc/classes/Input.xml","commit_id":"00a824aa57f863a067b27f9e724634166b5da012","original_commit_id":"00a824aa57f863a067b27f9e724634166b5da012","user":{"login":"Nintorch","id":92302738,"node_id":"U_kgDOBYBtkg","avatar_url":"https://avatars.githubusercontent.com/u/92302738?v=4","gravatar_id":"","url":"https://api.github.com/users/Nintorch","html_url":"https://github.com/Nintorch","followers_url":"https://api.github.com/users/Nintorch/followers","following_url":"https://api.github.com/users/Nintorch/following{/other_user}","gists_url":"https://api.github.com/users/Nintorch/gists{/gist_id}","starred_url":"https://api.github.com/users/Nintorch/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Nintorch/subscriptions","organizations_url":"https://api.github.com/users/Nintorch/orgs","repos_url":"https://api.github.com/users/Nintorch/repos","events_url":"https://api.github.com/users/Nintorch/events{/privacy}","received_events_url":"https://api.github.com/users/Nintorch/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"Oh, that's interesting. Although I can't make my DualShock 4 vibrate on Android, I tried controller vibration apps on Google Play (not sure how much I should trust them though, but I think they're supposed to actually call the Android vibration API) and Google Chrome. And currently Android joypad vibration is not implemented in Godot.\nSee also https://github.com/godotengine/godot/pull/114347. Should we support Android joypad vibration, even though it's finicky?","created_at":"2026-01-13T19:06:04Z","updated_at":"2026-01-13T19:06:34Z","html_url":"https://github.com/godotengine/godot/pull/114895#discussion_r2687717451","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/114895","_links":{"self":{"href":"https://api.github.com/repos/godotengine/godot/pulls/comments/2687717451"},"html":{"href":"https://github.com/godotengine/godot/pull/114895#discussion_r2687717451"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/114895"}},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/2687717451/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":null,"original_line":220,"side":"RIGHT","in_reply_to_id":2687672461,"author_association":"MEMBER","original_position":27,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/2687858191","pull_request_review_id":3657602813,"id":2687858191,"node_id":"PRRC_kwDOAO6SJc6gNXYP","diff_hunk":"@@ -208,6 +212,14 @@\n \t\t\t\t[b]Note:[/b] This feature is only supported on Windows, Linux, and macOS.\n \t\t\t</description>\n \t\t</method>\n+\t\t<method name=\"has_joy_vibration\" qualifiers=\"const\">\n+\t\t\t<return type=\"bool\" />\n+\t\t\t<param index=\"0\" name=\"device\" type=\"int\" />\n+\t\t\t<description>\n+\t\t\t\tReturns [code]true[/code] if the joypad supports vibration. See also [method start_joy_vibration].\n+\t\t\t\t[b]Note:[/b] For Android, joypad vibration is not supported due to OS restrictions. For macOS, vibration is only supported in macOS 11 and later.","path":"doc/classes/Input.xml","commit_id":"00a824aa57f863a067b27f9e724634166b5da012","original_commit_id":"00a824aa57f863a067b27f9e724634166b5da012","user":{"login":"Alex2782","id":41921395,"node_id":"MDQ6VXNlcjQxOTIxMzk1","avatar_url":"https://avatars.githubusercontent.com/u/41921395?v=4","gravatar_id":"","url":"https://api.github.com/users/Alex2782","html_url":"https://github.com/Alex2782","followers_url":"https://api.github.com/users/Alex2782/followers","following_url":"https://api.github.com/users/Alex2782/following{/other_user}","gists_url":"https://api.github.com/users/Alex2782/gists{/gist_id}","starred_url":"https://api.github.com/users/Alex2782/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Alex2782/subscriptions","organizations_url":"https://api.github.com/users/Alex2782/orgs","repos_url":"https://api.github.com/users/Alex2782/repos","events_url":"https://api.github.com/users/Alex2782/events{/privacy}","received_events_url":"https://api.github.com/users/Alex2782/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"> And currently Android joypad vibration is not implemented in Godot.\r\n\r\nYes, that's right, I thought that was already included, but it's linked to `OS_Android::vibrate_handheld`. Here's the official documentation for game controllers `Haptics` and `Lights`.\r\n_(I also saw something about light in your other PR.)_\r\n\r\nhttps://developer.android.com/develop/ui/views/touch-and-input/game-controllers/controller-features\r\n\r\n-----------\r\n\r\n> Should we support Android joypad vibration, even though it's finicky?\r\n\r\nNot sure, it's probably not worth the effort if there aren't any users who connect a gamepad to a smartphone via Bluetooth. But for devices like the `NVIDIA Shield Android TV` or `Chromebooks`, it would be worthwhile. As soon as I have time, I'll try to test the `NVIDIA Shield Controller` on different devices for comparison.\r\n","created_at":"2026-01-13T19:40:18Z","updated_at":"2026-01-13T19:40:18Z","html_url":"https://github.com/godotengine/godot/pull/114895#discussion_r2687858191","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/114895","_links":{"self":{"href":"https://api.github.com/repos/godotengine/godot/pulls/comments/2687858191"},"html":{"href":"https://github.com/godotengine/godot/pull/114895#discussion_r2687858191"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/114895"}},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/2687858191/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":null,"original_line":220,"side":"RIGHT","in_reply_to_id":2687672461,"author_association":"MEMBER","original_position":27,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/2691324508","pull_request_review_id":3661824197,"id":2691324508,"node_id":"PRRC_kwDOAO6SJc6galpc","diff_hunk":"@@ -615,6 +617,32 @@ float Input::get_joy_vibration_duration(int p_device) {\n \t}\n }\n \n+float Input::get_joy_vibration_remaining_duration(int p_device) {","path":"core/input/input.cpp","commit_id":"c83c672d615e04fda40e5c02835a10deba924813","original_commit_id":"9212852fe7fc0268d9882b61e6f7573a8a7ff10e","user":{"login":"Alex2782","id":41921395,"node_id":"MDQ6VXNlcjQxOTIxMzk1","avatar_url":"https://avatars.githubusercontent.com/u/41921395?v=4","gravatar_id":"","url":"https://api.github.com/users/Alex2782","html_url":"https://github.com/Alex2782","followers_url":"https://api.github.com/users/Alex2782/followers","foll