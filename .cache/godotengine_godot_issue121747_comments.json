.github.com/users/MadeScientist/followers","following_url":"https://api.github.com/users/MadeScientist/following{/other_user}","gists_url":"https://api.github.com/users/MadeScientist/gists{/gist_id}","starred_url":"https://api.github.com/users/MadeScientist/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/MadeScientist/subscriptions","organizations_url":"https://api.github.com/users/MadeScientist/orgs","repos_url":"https://api.github.com/users/MadeScientist/repos","events_url":"https://api.github.com/users/MadeScientist/events{/privacy}","received_events_url":"https://api.github.com/users/MadeScientist/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-07-27T13:50:30Z","updated_at":"2026-07-27T13:50:30Z","body":"I sincerely appreciate your fix and your attention to this issue. I hope this PR will receive some attention from the official team as well.","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5092186744/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5125097161","html_url":"https://github.com/godotengine/godot/pull/121747#issuecomment-5125097161","issue_url":"https://api.github.com/repos/godotengine/godot/issues/121747","id":5125097161,"node_id":"IC_kwDOAO6SJc8AAAABMXrGyQ","user":{"login":"Schnorg","id":44937651,"node_id":"MDQ6VXNlcjQ0OTM3NjUx","avatar_url":"https://avatars.githubusercontent.com/u/44937651?v=4","gravatar_id":"","url":"https://api.github.com/users/Schnorg","html_url":"https://github.com/Schnorg","followers_url":"https://api.github.com/users/Schnorg/followers","following_url":"https://api.github.com/users/Schnorg/following{/other_user}","gists_url":"https://api.github.com/users/Schnorg/gists{/gist_id}","starred_url":"https://api.github.com/users/Schnorg/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Schnorg/subscriptions","organizations_url":"https://api.github.com/users/Schnorg/orgs","repos_url":"https://api.github.com/users/Schnorg/repos","events_url":"https://api.github.com/users/Schnorg/events{/privacy}","received_events_url":"https://api.github.com/users/Schnorg/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-07-30T01:02:36Z","updated_at":"2026-07-30T01:02:36Z","body":"## Further testing and notes on static detection performance\r\n\r\nWhen I amplify the horde in my game (1000 on screen enemies) and I turn off `monitorable` on these enemies, I can notice a difference in broad phase performance of about 10-20%.\r\n\r\nIn this scenario, static detection may be causing about 0.5ms extra in a 17ms frame, with 4.5ms of total broadphase test time. *(The bigger broadphase performance issue with my game is needing both a RigidBody shape and an Area2D shape per entity, but that is for another issue or proposal)*\r\n\r\n### **So if some performance loss is considered worse than the 'static detection' issue, then I am happy to remove static detection from this PR at the direction of a maintainer.** \r\n\r\nI think the monitoring logic fixes should be merged as soon as possible and not be held up if static detection is considered too risky.\r\n\r\nThe reason I have the static detection fix here is: \r\n- It is dependent and integrated with the monitoring logic fix (these monitoring issues are clouding over other bugs)\r\n- Testing time is the dominant problem, so fixing and testing multiple logic issues together reduces test time and minimises regression risk (within reason).\r\n","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5125097161/reactions","total_count":2,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":1,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null}]