ult":false,"description":"","archived_at":null,"archived_by":null}],"state":"closed","locked":false,"assignees":[],"milestone":{"url":"https://api.github.com/repos/godotengine/godot/milestones/25","html_url":"https://github.com/godotengine/godot/milestone/25","labels_url":"https://api.github.com/repos/godotengine/godot/milestones/25/labels","id":15520464,"node_id":"MI_kwDOAO6SJc4A7NLQ","number":25,"title":"4.8","description":"","creator":{"login":"Repiteo","id":17489292,"node_id":"MDQ6VXNlcjE3NDg5Mjky","avatar_url":"https://avatars.githubusercontent.com/u/17489292?v=4","gravatar_id":"","url":"https://api.github.com/users/Repiteo","html_url":"https://github.com/Repiteo","followers_url":"https://api.github.com/users/Repiteo/followers","following_url":"https://api.github.com/users/Repiteo/following{/other_user}","gists_url":"https://api.github.com/users/Repiteo/gists{/gist_id}","starred_url":"https://api.github.com/users/Repiteo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Repiteo/subscriptions","organizations_url":"https://api.github.com/users/Repiteo/orgs","repos_url":"https://api.github.com/users/Repiteo/repos","events_url":"https://api.github.com/users/Repiteo/events{/privacy}","received_events_url":"https://api.github.com/users/Repiteo/received_events","type":"User","user_view_type":"public","site_admin":false},"open_issues":351,"closed_issues":2337,"state":"open","created_at":"2026-04-13T15:59:35Z","updated_at":"2026-10-22T15:17:38Z","due_on":null,"closed_at":null},"comments":0,"created_at":"2025-08-08T15:32:56Z","updated_at":"2026-06-18T15:30:30Z","closed_at":"2026-06-18T15:25:24Z","assignee":null,"author_association":"CONTRIBUTOR","issue_field_values":[],"type":null,"active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"### Tested versions\n\n- Reproducable: 4.4.1-stable\n\n### System information\n\nWindows 11 - Godot 4.4.1-stable - Forward+ - Nvidia 4070 TI\n\n### Issue description\n\nNetwork synchronisation IDs get reused over peers.\n\n**What I try to do**\nHave each client spawn nodes using a MultiplayerSpawner where they are the multiplayer authority of. The clients spawn nodes where they also have the multiplayer authority of. These nodes have their own MultiplayerSynchronizer  to sync properties to the rest. Now when one of these clients removes their spawned node, all clients will remove that node's net_id and stop synchronizing this one. But it turns out all clients have been reusing net_ids so that synchronisation breaks in general\n\nhttps://github.com/user-attachments/assets/a1cf9e87-5520-4eee-bbe2-f340e4d9621f\n\n**Suspicions**\nIn the function `on_replication_stop` we go over all the connected peers and remove the network id of the node that is removed, but because these network ids are not unique over all the peers this stops other random nodes from syncing.\n\nhttps://github.com/godotengine/godot/blob/80a219a58ad050519a8a51b76f7f43e15accc577/modules/multiplayer/scene_replication_interface.cpp#L280-L286\n\n### Steps to reproduce\n\n1. Set up a multiplayer game\n2. Give every client their own multiplayer spawner to spawn a node\n3. Let every client spawn a node that:\n  1. Has a MultiplayerSynchronizer node\n  2. Is under the multiplayer authority of that client\n4. After some time, delete the node of the last added client.\n5. The values that were synchronized through the MultiplayerSynchronizer of the spawned node will break for the wrong net_id.\n\n### Minimal reproduction project (MRP)\n\nMake sure to run 2 clients, one with the \"server\" feature tag.\n[min-repro-sync-bug.zip](https://github.com/user-attachments/files/21687510/min-repro-sync-bug.zip)","closed_by":{"login":"Repiteo","id":17489292,"node_id":"MDQ6VXNlcjE3NDg5Mjky","avatar_url":"https://avatars.githubusercontent.com/u/17489292?v=4","gravatar_id":"","url":"https://api.github.com/users/Repiteo","html_url":"https://github.com/Repiteo","followers_url":"https://api.github.com/users/Repiteo/followers","following_url":"https://api.github.com/users/Repiteo/following{/other_user}","gists_url":"https://api.github.com/users/Repiteo/gists{/gist_id}","starred_url":"https://api.github.com/users/Repiteo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Repiteo/subscriptions","organizations_url":"https://api.github.com/users/Repiteo/orgs","repos_url":"https://api.github.com/users/Repiteo/repos","events_url":"https://api.github.com/users/Repiteo/events{/privacy}","received_events_url":"https://api.github.com/users/Repiteo/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/109432/reactions","total_count":2,"+1":2,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/godotengine/godot/issues/109432/timeline","performed_via_github_app":null,"state_reason":"completed","pinned_comment":null}