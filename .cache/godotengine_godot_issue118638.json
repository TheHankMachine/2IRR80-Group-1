FOCUS_IN/OUT notifications\n4. Compare switching applications with the mouse on the taskbar and Alt + Tab\n\n### Minimal reproduction project (MRP)\n\n[focus-out-test.zip](https://github.com/user-attachments/files/26780133/focus-out-test.zip)","closed_by":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/118638/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/godotengine/godot/issues/118638/timeline","performed_via_github_app":null,"state_reason":null,"pinned_comment":null}