_id":"MDQ6VXNlcjI2Mjk3MjM5","avatar_url":"https://avatars.githubusercontent.com/u/26297239?v=4","gravatar_id":"","url":"https://api.github.com/users/cpl-s-matsuyama","html_url":"https://github.com/cpl-s-matsuyama","followers_url":"https://api.github.com/users/cpl-s-matsuyama/followers","following_url":"https://api.github.com/users/cpl-s-matsuyama/following{/other_user}","gists_url":"https://api.github.com/users/cpl-s-matsuyama/gists{/gist_id}","starred_url":"https://api.github.com/users/cpl-s-matsuyama/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/cpl-s-matsuyama/subscriptions","organizations_url":"https://api.github.com/users/cpl-s-matsuyama/orgs","repos_url":"https://api.github.com/users/cpl-s-matsuyama/repos","events_url":"https://api.github.com/users/cpl-s-matsuyama/events{/privacy}","received_events_url":"https://api.github.com/users/cpl-s-matsuyama/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-03-09T02:57:22Z","updated_at":"2026-03-09T02:57:22Z","body":"Bisecting on a Galaxy S20 5G revealed that the issue was introduced by this PR:\n#109084","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4020763881/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4020952813","html_url":"https://github.com/godotengine/godot/issues/116990#issuecomment-4020952813","issue_url":"https://api.github.com/repos/godotengine/godot/issues/116990","id":4020952813,"node_id":"IC_kwDOAO6SJc7vqt7t","user":{"login":"cpl-s-matsuyama","id":26297239,"node_id":"MDQ6VXNlcjI2Mjk3MjM5","avatar_url":"https://avatars.githubusercontent.com/u/26297239?v=4","gravatar_id":"","url":"https://api.github.com/users/cpl-s-matsuyama","html_url":"https://github.com/cpl-s-matsuyama","followers_url":"https://api.github.com/users/cpl-s-matsuyama/followers","following_url":"https://api.github.com/users/cpl-s-matsuyama/following{/other_user}","gists_url":"https://api.github.com/users/cpl-s-matsuyama/gists{/gist_id}","starred_url":"https://api.github.com/users/cpl-s-matsuyama/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/cpl-s-matsuyama/subscriptions","organizations_url":"https://api.github.com/users/cpl-s-matsuyama/orgs","repos_url":"https://api.github.com/users/cpl-s-matsuyama/repos","events_url":"https://api.github.com/users/cpl-s-matsuyama/events{/privacy}","received_events_url":"https://api.github.com/users/cpl-s-matsuyama/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-03-09T04:03:01Z","updated_at":"2026-03-09T04:03:01Z","body":"I investigated the behavior by modifying the code around [scene_forward_mobile.glsl](https://github.com/allenwp/godot/blob/bd9d1bf070fc054c81477cc03a74e600cf4cf641/servers/rendering/renderer_rd/shaders/forward_mobile/scene_forward_mobile.glsl#L2241).\n\nOriginal code -> Crashes\n`dither.rgb = fract(dither.rgb / vec3(103.0, 71.0, 97.0));`\n\nCommenting out -> Does not crash\n`//dither.rgb = fract(dither.rgb / vec3(103.0, 71.0, 97.0));`\n\nReducing the variation of constant literals -> Does not crash\n`dither.rgb = fract(dither.rgb / vec3(103.0, 103.0, 97.0));`\n\nReducing literal variations and duplicating the line -> Does not crash\n```\ndither.rgb = fract(dither.rgb / vec3(103.0, 103.0, 97.0));\ndither.rgb = fract(dither.rgb / vec3(103.0, 103.0, 97.0));\ndither.rgb = fract(dither.rgb / vec3(103.0, 103.0, 97.0));\ndither.rgb = fract(dither.rgb / vec3(103.0, 103.0, 97.0));\n```","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4020952813/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4021429656","html_url":"https://github.com/godotengine/godot/issues/116990#issuecomment-4021429656","issue_url":"https://api.github.com/repos/godotengine/godot/issues/116990","id":4021429656,"node_id":"IC_kwDOAO6SJc7vsiWY","user":{"login":"syntaxerror247","id":176927541,"node_id":"U_kgDOCouzNQ","avatar_url":"https://avatars.githubusercontent.com/u/176927541?v=4","gravatar_id":"","url":"https://api.github.com/users/syntaxerror247","html_url":"https://github.com/syntaxerror247","followers_url":"https://api.github.com/users/syntaxerror247/followers","following_url":"https://api.github.com/users/syntaxerror247/following{/other_user}","gists_url":"https://api.github.com/users/syntaxerror247/gists{/gist_id}","starred_url":"https://api.github.com/users/syntaxerror247/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/syntaxerror247/subscriptions","organizations_url":"https://api.github.com/users/syntaxerror247/orgs","repos_url":"https://api.github.com/users/syntaxerror247/repos","events_url":"https://api.github.com/users/syntaxerror247/events{/privacy}","received_events_url":"https://api.github.com/users/syntaxerror247/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-03-09T06:20:58Z","updated_at":"2026-03-09T06:21:22Z","body":"> Bisecting on a Galaxy S20 5G revealed that the issue was introduced by this PR: [#109084](https://github.com/godotengine/godot/pull/109084)\n\ncc @allenwp ","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4021429656/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4024467648","html_url":"https://github.com/godotengine/godot/issues/116990#issuecomment-4024467648","issue_url":"https://api.github.com/repos/godotengine/godot/issues/116990","id":4024467648,"node_id":"IC_kwDOAO6SJc7v4IDA","user":{"login":"allenwp","id":17506573,"node_id":"MDQ6VXNlcjE3NTA2NTcz","avatar_url":"https://avatars.githubusercontent.com/u/17506573?v=4","gravatar_id":"","url":"https://api.github.com/users/allenwp","html_url":"https://github.com/allenwp","followers_url":"https://api.github.com/users/allenwp/followers","following_url":"https://api.github.com/users/allenwp/following{/other_user}","gists_url":"https://api.github.com/users/allenwp/gists{/gist_id}","starred_url":"https://api.github.com/users/allenwp/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/allenwp/subscriptions","organizations_url":"https://api.github.com/users/allenwp/orgs","repos_url":"https://api.github.com/users/allenwp/repos","events_url":"https://api.github.com/users/allenwp/events{/privacy}","received_events_url":"https://api.github.com/users/allenwp/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-03-09T15:11:03Z","updated_at":"2026-03-09T15:11:03Z","body":"Thanks for the ping! This is indeed entirely outside of my wheelhouse and in need of a hero like blueskythlikesclouds, so I think this is a good assignment. These specific magic numbers were [chosen by Valve](https://alex.vlachos.com/graphics/Alex_Vlachos_Advanced_VR_Rendering_GDC2015.pdf) to give a good dithering pattern, so although it may be possible to find a different set of numbers that behave similarly well, it would definitely better to address the root issue that is preventing us from having the `vec3(103.0, 71.0, 97.0)` literal.","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4024467648/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4287888684","html_url":"https://github.com/godotengine/godot/issues/116990#issuecomment-4287888684","issue_url":"https://api.github.com/repos/godotengine/godot/issues/116990","id":4287888684,"node_id":"IC_kwDOAO6SJc7_k_0s","user":{"login":"blueskythlikesclouds","id":19259897,"node_id":"MDQ6VXNlcjE5MjU5ODk3","avatar_url":"https://avatars.githubusercontent.com/u/19259897?v=4","gravatar_id":"","url":"https://api.github.com/users/blueskythlikesclouds","html_url":"https://github.com/blueskythlikesclouds","followers_url":"https://api.github.com/users/blueskythlikesclouds/followers","following_url":"https://api.github.com/users/blueskythlikesclouds/following{/other_user}","gists_url":"https://api.github.com/users/blueskythlikesclouds/gists{/gist_id}","starred_url":"https://api.github.com/users/blueskythlikesclouds/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/blueskythlikesclouds/subscriptions","organizations_url":"https://api.github.com/users/blueskythlikesclouds/orgs","repos_url":"https://api.github.com/users/blueskythlikesclouds/repos","events_url":"https://api.github.com/users/blueskythlikesclouds/events{/privacy}","received_events_url":"https://api.github.com/users/blueskythlikesclouds/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-04-21T10:40:48Z","updated_at":"2026-04-21T10:40:54Z","body":"Was hoping I'd be able to reproduce this on an Adreno 630 but no dice.\n\nIf this is an issue with how the SPIR-V gets compiled into host machine code, maybe we can work around it by doing the same operation in a different way?\n\nFor example, does replacing:\n\n```glsl\ndither.rgb = fract(dither.rgb / vec3(103.0, 71.0, 97.0));\n```\n\nwith\n\n```glsl\ndither.rgb = fract(dither.rgb * vec3(0.009708737864077669, 0.014084507042253521, 0.010309278350515464));\n```\n\nmake a difference?","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4287888684/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4292630466","html_url":"https://github.com/godotengine/godot/issues/116990#issuecomment-4292630466","issue_url":"https://api.github.com/repos/godotengine/godot/issues/116990","id":4292630466,"node_id":"IC_kwDOAO6SJc7_3FfC","user":{"login":"cpl-s-matsuyama","id":26297239,"node_id":"MDQ6VXNlcjI2Mjk3MjM5","avatar_url":"https://avatars.githubusercontent.com/u/26297239?v=4","gravatar_id":"","url":"https://api.github.com/users/cpl-s-matsuyama","html_url":"https://github.com/cpl-s-matsuyama","followers_url":"https://api.github.com/users/cpl-s-matsuyama/followers","following_url":"https://api.github.com/users/cpl-s-matsuyama/following{/other_user}","gists_url":"https://api.github.com/users/cpl-s-matsuyama/gists{/gist_id}","starred_url":"https://api.github.com/users/cpl-s-matsuyama/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/cpl-s-matsuyama/subscriptions","organizations_url":"https://api.github.com/users/cpl-s-matsuyama/orgs","repos_url":"https://api.github.com/users/cpl-s-matsuyama/repos","events_url":"https://api.github.com/users/cpl-s-matsuyama/events{/privacy}","received_events_url":"https://api.github.com/users/cpl-s-matsuyama/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-04-22T00:02:07Z","updated_at":"2026-04-22T00:02:07Z","body":"```\ndither.rgb = fract(dither.rgb * vec3(0.009708737864077669, 0.014084507042253521, 0.010309278350515464));\n```\nI tried this case, but it still crashes just like the original code.\n\n(To verify, I alternated testing this case and the non-crashing commented-out case twice, and I can confirm the crash still occurs.)","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4292630466/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4292933252","html_url":"https://github.com/godotengine/godot/issues/116990#issuecomment-4292933252","issue_url":"https://api.github.com/repos/godotengine/godot/issues/116990","id":4292933252,"node_id":"IC_kwDOAO6SJc7_4PaE","user":{"login":"cpl-s-matsuyama","id":26297239,"node_id":"MDQ6VXNlcjI2Mjk3MjM5","avatar_url":"https://avatars.githubusercontent.com/u/26297239?v=4","gravatar_id":"","url":"https://api.github.com/users/cpl-s-matsuyama","html_url":"https://github.com/cpl-s-matsuyama","followers_url":"https://api.github.com/users/cpl-s-matsuyama/followers","following_url":"https://api.github.com/users/cpl-s-matsuyama/following{/other_user}","gists_url":"https://api.github.com/users/cpl-s-matsuyama/gists{/gist_id}","starred_url":"https://api.github.com/users/cpl-s-matsuyama/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/cpl-s-matsuyama/subscriptions","organizations_url":"https://api.github.com/users/cpl-s-matsuyama/orgs","repos_url":"https://api.github.com/users/cpl-s-matsuyama/repos","events_url":"https://api.github.com/users/cpl-s-matsuyama/events{/privacy}","received_events_url":"https://api.github.com/users/cpl-s-matsuyama/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-04-22T01:30:03Z","updated_at":"2026-04-22T01:30:03Z","body":"Interestingly, the crash goes away if I just reduce the variation of constant literals by one elsewhere in the same file.\n\nChanging [this line](https://github.com/allenwp/godot/blob/14d19694e0c88a3f9e82d899a0400f27a24c176e/servers/rendering/renderer_rd/shaders/forward_mobile/scene_forward_mobile.glsl#L1823) to the following fixes the crash:\n```\nhalf specular_occlusion = (ambient_light.r * half(0.3) + ambient_light.g * half(0.59) + ambient_light.b * half(2.0)) * half(2.0); // Luminance of ambient light.\n```","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4292933252/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4295418937","html_url":"https://github.com/godotengine/godot/issues/116990#issuecomment-4295418937","issue_url":"https://api.github.com/repos/godotengine/godot/issues/116990","id":4295418937,"node_id":"IC_kwDOAO6SJc8AAAABAAbkOQ","user":{"login":"blueskythlikesclouds","id":19259897,"node_id":"MDQ6VXNlcjE5MjU5ODk3","avatar_url":"https://avatars.githubusercontent.com/u/19259897?v=4","gravatar_id":"","url":"https://api.github.com/users/blueskythlikesclouds","html_url":"https://github.com/blueskythlikesclouds","followers_url":"https://api.github.com/users/blueskythlikesclouds/followers","following_url":"https://api.github.com/users/blueskythlikesclouds/following{/other_user}","gists_url":"https://api.github.com/users/blueskythlikesclouds/gists{/gist_id}","starred_url":"https://api.github.com/users/blueskythlikesclouds/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/blueskythlikesclouds/subscriptions","organizations_url":"https://api.github.com/users/blueskythlikesclouds/orgs","repos_url":"https://api.github.com/users/blueskythlikesclouds/repos","events_url":"https://api.github.com/users/blueskythlikesclouds/events{/privacy}","received_events_url":"https://api.github.com/users/blueskythlikesclouds/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-04-22T10:23:42Z","updated_at":"2026-04-22T10:27:59Z","body":"The crash definitely happens with the ubershader, otherwise these modified lines you mentioned would not make a difference in the MRP.\n\nIn 4.6.1, the ubershader SPIR-V has 100 constants. In 4.5.1, it has 88.\n\nIs it possible the driver's shader compiler has some sort of constant limit? If removing just one of them works, that'd imply the limit is 99 or something...\n\nEdit: Actually hmm, in the debanding PR's commit, the amount goes up to 96, so that wouldn't explain removing a singular constant fixing the problem.","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4295418937/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4303254306","html_url":"https://github.com/godotengine/godot/issues/116990#issuecomment-4303254306","issue_url":"https://api.github.com/repos/godotengine/godot/issues/116990","id":4303254306,"node_id":"IC_kwDOAO6SJc8AAAABAH5zIg","user":{"login":"cpl-s-matsuyama","id":26297239,"node_id":"MDQ6VXNlcjI2Mjk3MjM5","avatar_url":"https://avatars.githubusercontent.com/u/26297239?v=4","gravatar_id":"","url":"https://api.github.com/users/cpl-s-matsuyama","html_url":"https://github.com/cpl-s-matsuyama","followers_url":"https://api.github.com/users/cpl-s-matsuyama/followers","following_url":"https://api.github.com/users/cpl-s-matsuyama/following{/other_user}","gists_url":"https://api.github.com/users/cpl-s-matsuyama/gists{/gist_id}","starred_url":"https://api.github.com/users/cpl-s-matsuyama/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/cpl-s-matsuyama/subscriptions","organizations_url":"https://api.github.com/users/cpl-s-matsuyama/orgs","repos_url":"https://api.github.com/users/cpl-s-matsuyama/repos","events_url":"https://api.github.com/users/cpl-s-matsuyama/events{/privacy}","received_events_url":"https://api.github.com/users/cpl-s-matsuyama/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-04-23T09:25:25Z","updated_at":"2026-04-23T09:25:25Z","body":"There seems to be a limit of some sort, but apparently it's not just the total count of constants.\n\nFirst, I applied the following modification to reduce the number of constants by one. This prevents the crash from occurring:\n\n```\ndither.rgb = fract(dither.rgb / vec3(103.0, 97.0, 97.0));\n```\n\nIn this state, I added a constant near [#CODE : FRAGMENT:](https://github.com/allenwp/godot/blob/14d19694e0c88a3f9e82d899a0400f27a24c176e/servers/rendering/renderer_rd/shaders/forward_mobile/scene_forward_mobile.glsl#L1259)\n\n```\n#CODE : FRAGMENT\n\t\talbedo_highp.r *= 1.0937483;\n\n```\n\nWhen checking the compiled SPIR-V, the number of OpConstants increases, but it does not crash.\n\nOn the other hand, adding a single constant near [fog_process](https://github.com/allenwp/godot/blob/14d19694e0c88a3f9e82d899a0400f27a24c176e/servers/rendering/renderer_rd/shaders/forward_mobile/scene_forward_mobile.glsl#L1456) causes it to crash again:\n\n\n```\n\t\tfog = fog_process(vertex);\n\t\tfog.r *= half(1.3939387);\n```","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4303254306/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4311169416","html_url":"https://github.com/godotengine/godot/issues/116990#issuecomment-4311169416","issue_url":"https://api.github.com/repos/godotengine/godot/issues/116990","id":4311169416,"node_id":"IC_kwDOAO6SJc8AAAABAPc5iA","user":{"login":"cpl-s-matsuyama","id":26297239,"node_id":"MDQ6VXNlcjI2Mjk3MjM5","avatar_url":"https://avatars.githubusercontent.com/u/26297239?v=4","gravatar_id":"","url":"https://api.github.com/users/cpl-s-matsuyama","html_url":"https://github.com/cpl-s-matsuyama","followers_url":"https://api.github.com/users/cpl-s-matsuyama/followers","following_url":"https://api.github.com/users/cpl-s-matsuyama/following{/other_user}","gists_url":"https://api.github.com/users/cpl-s-matsuyama/gists{/gist_id}","starred_url":"https://api.github.com/users/cpl-s-matsuyama/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/cpl-s-matsuyama/subscriptions","organizations_url":"https://api.github.com/users/cpl-s-matsuyama/orgs","repos_url":"https://api.github.com/users/cpl-s-matsuyama/repos","events_url":"https://api.github.com/users/cpl-s-matsuyama/events{/privacy}","received_events_url":"https://api.github.com/users/cpl-s-matsuyama/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-04-24T06:33:51Z","updated_at":"2026-04-24T06:33:51Z","body":"```\n#CODE : FRAGMENT\n\t\talbedo_highp.r *= 1.0937483;\n```\nThinking about it further, because albedo_highp is just initialized with a constant, the driver-side optimization might be removing the constants despite the increase in OpConstants, thus avoiding the crash.\nIt crashed when I made the following modification:\n```\n#CODE : FRAGMENT\n\t\tvertex.x *= 1.0937483;\n```","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4311169416/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4358314590","html_url":"https://github.com/godotengine/godot/issues/116990#issuecomment-4358314590","issue_url":"https://api.github.com/repos/godotengine/godot/issues/116990","id":4358314590,"node_id":"IC_kwDOAO6SJc8AAAABA8aaXg","user":{"login":"cpl-s-matsuyama","id":26297239,"node_id":"MDQ6VXNlcjI2Mjk3MjM5","avatar_url":"https://avatars.githubusercontent.com/u/26297239?v=4","gravatar_id":"","url":"https://api.github.com/users/cpl-s-matsuyama","html_url":"https://github.com/cpl-s-matsuyama","followers_url":"https://api.github.com/users/cpl-s-matsuyama/followers","following_url":"https://api.github.com/users/cpl-s-matsuyama/following{/other_user}","gists_url":"https://api.github.com/users/cpl-s-matsuyama/gists{/gist_id}","starred_url":"https://api.github.com/users/cpl-s-matsuyama/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/cpl-s-matsuyama/subscriptions","organizations_url":"https://api.github.com/users/cpl-s-matsuyama/orgs","repos_url":"https://api.github.com/users/cpl-s-matsuyama/repos","events_url":"https://api.github.com/users/cpl-s-matsuyama/events{/privacy}","received_events_url":"https://api.github.com/users/cpl-s-matsuyama/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-05-01T07:23:10Z","updated_at":"2026-05-01T07:23:10Z","body":"> The crash definitely happens with the ubershader, otherwise these modified lines you mentioned would not make a difference in the MRP.\n\n[Forcibly disabling the Ubershader and always using specialized shaders](https://github.com/cpl-s-matsuyama/godot/commit/00e1bf1816293ca4bd8e1377e91487fa7910daa1) resolved the crash.\nI was also able to confirm that in this state, adding around 3,000 dummy operations using unique constants does not cause a crash.\n(It's possible that the constant limit is drastically reduced when dynamic branching is involved.)\n\nWe might need an option to disable the Ubershader for devices like the Adreno 650.","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4358314590/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4500844884","html_url":"https://github.com/godotengine/godot/issues/116990#issuecomment-4500844884","issue_url":"https://api.github.com/repos/godotengine/godot/issues/116990","id":4500844884,"node_id":"IC_kwDOAO6SJc8AAAABDEVxVA","user":{"login":"clayjohn","id":16521339,"node_id":"MDQ6VXNlcjE2NTIxMzM5","avatar_url":"https://avatars.githubusercontent.com/u/16521339?v=4","gravatar_id":"","url":"https://api.github.com/users/clayjohn","html_url":"https://github.com/clayjohn","followers_url":"https://api.github.com/users/clayjohn/followers","following_url":"https://api.github.com/users/clayjohn/following{/other_user}","gists_url":"https://api.github.com/users/clayjohn/gists{/gist_id}","starred_url":"https://api.github.com/users/clayjohn/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/clayjohn/subscriptions","organizations_url":"https://api.github.com/users/clayjohn/orgs","repos_url":"https://api.github.com/users/clayjohn/repos","events_url":"https://api.github.com/users/clayjohn/events{/privacy}","received_events_url":"https://api.github.com/users/clayjohn/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-05-20T17:20:59Z","updated_at":"2026-05-20T17:20:59Z","body":"Skyth has been investigating this for a few weeks now and has narrowed the issue down to a memory corruption in the shader compiler in the Adreno 650 driver. Unfortunately, that means our options for a workaround are limited. \n\nOptions we have considered are:\n\n### 1. On the affected driver version create a dummy UBO filled with the literal constants to avoid the limit\n\nPros: this should work in theory\n\nCons: worse performance and the workaround would be very complicated and intrusive in the codebase, which means it will be difficult to maintain and prone to breaking\n\n### 2. Disable the ubershader on the affected devices\n\nPros: easy code to add, easy to maintain\n\nCons: will introduce shader compilation stutters on affected devices. There is a chance the issue will come back if a particular specialized shader version uses a lot of constant literals\n\n### 3. Disable Vulkan support on affected devices\n\nPros: easy code to add, easy to maintain, futureproof\n\nCons: Using the compatibility renderer will introduce shader stutter and major visual changes. Might be overkill for 2D games\n\n\nRight now we are waiting to hear back from Qualcomm to see if they can help us figure out exactly what drivers are affected so we can limit the workaround to the smallest range of devices possible. ","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4500844884/reactions","total_count":2,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":2},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4512097018","html_url":"https://github.com/godotengine/godot/issues/116990#issuecomment-4512097018","issue_url":"https://api.github.com/repos/godotengine/godot/issues/116990","id":4512097018,"node_id":"IC_kwDOAO6SJc8AAAABDPEi-g","user":{"login":"blueskythlikesclouds","id":19259897,"node_id":"MDQ6VXNlcjE5MjU5ODk3","avatar_url":"https://avatars.githubusercontent.com/u/19259897?v=4","gravatar_id":"","url":"https://api.github.com/users/blueskythlikesclouds","html_url":"https://github.com/blueskythlikesclouds","followers_url":"https://api.github.com/users/blueskythlikesclouds/followers","following_url":"https://api.github.com/users/blueskythlikesclouds/following{/other_user}","gists_url":"https://api.github.com/users/blueskythlikesclouds/gists{/gist_id}","starred_url":"https://api.github.com/users/blueskythlikesclouds/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/blueskythlikesclouds/subscriptions","organizations_url":"https://api.github.com/users/blueskythlikesclouds/orgs","repos_url":"https://api.github.com/users/blueskythlikesclouds/repos","events_url":"https://api.github.com/users/blueskythlikesclouds/events{/privacy}","received_events_url":"https://api.github.com/users/blueskythlikesclouds/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-05-21T19:31:33Z","updated_at":"2026-05-21T19:31:33Z","body":"@cpl-s-matsuyama Does #119639 resolve the crash on your device?","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4512097018/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4513904387","html_url":"https://github.com/godotengine/godot/issues/116990#issuecomment-4513904387","issue_url":"https://api.github.com/repos/godotengine/godot/issues/116990","id":4513904387,"node_id":"IC_kwDOAO6SJc8AAAABDQy3Aw","user":{"login":"cpl-s-matsuyama","id":26297239,"node_id":"MDQ6VXNlcjI2Mjk3MjM5","avatar_url":"https://avatars.githubusercontent.com/u/26297239?v=4","gravatar_id":"","url":"https://api.github.com/users/cpl-s-matsuyama","html_url":"https://github.com/cpl-s-matsuyama","followers_url":"https://api.github.com/users/cpl-s-matsuyama/followers","following_url":"https://api.github.com/users/cpl-s-matsuyama/following{/other_user}","gists_url":"https://api.github.com/users/cpl-s-matsuyama/gists{/gist_id}","starred_url":"https://api.github.com/users/cpl-s-matsuyama/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/cpl-s-matsuyama/subscriptions","organizations_url":"https://api.github.com/users/cpl-s-matsuyama/orgs","repos_url":"https://api.github.com/users/cpl-s-matsuyama/repos","events_url":"https://api.github.com/users/cpl-s-matsuyama/events{/privacy}","received_events_url":"https://api.github.com/users/cpl-s-matsuyama/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-05-22T00:33:03Z","updated_at":"2026-05-22T00:33:03Z","body":"@blueskythlikesclouds Yes, #119639 successfully resolves the crash on my device. (I also tested the previous commit 3bfa50fd329cb9a7b01b0ab1cd7ac8f27f7391ac, and the crash still occurred.) Thanks for the fix!","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4513904387/reactions","total_count":4,"+1":0,"-1":0,"laugh":0,"hooray":4,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null}]