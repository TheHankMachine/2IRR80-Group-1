[{"id":3102140676,"node_id":"PRR_kwDOAO6SJc645ukE","state":"APPROVED","user":{"site_admin":false,"suspended":false,"updated_at":"0001-01-01T00:00:00Z","avatar_url":"https://avatars.githubusercontent.com/u/16521339?u=e44a465cbebabb9ea2be80b59e6dc07966bef5b7&v=4","created_at":"0001-01-01T00:00:00Z","followers":0,"following":0,"html_url":"https://github.com/clayjohn","id":16521339,"node_id":"MDQ6VXNlcjE2NTIxMzM5","login":"clayjohn","type":"User","owned_private_repos":0,"public_gists":0,"public_repos":0,"total_private_repos":0,"url":"https://api.github.com/users/clayjohn"},"body":"Looks great! \n\nFor future reference, the old code was wrongly blendering the edge threshold with the \"true SDF\" provided in the MTSDF texture. The SDF is basically what you get with regular SDF fonts. So by blending with it we were losing the sharp edges that MSDF provides. \n\nIn a later PR we could consider reducing the size of the MSDF textures now since we should get better quality. ","html_url":"https://github.com/godotengine/godot/pull/109437#pullrequestreview-3102140676","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/109437","author_association":"MEMBER","submitted_at":"2025-08-08T21:02:10Z"},{"id":3102202159,"node_id":"PRR_kwDOAO6SJc6459kv","state":"APPROVED","user":{"site_admin":false,"suspended":false,"updated_at":"0001-01-01T00:00:00Z","avatar_url":"https://avatars.githubusercontent.com/u/32321?u=c2e06a3d2b49a467aa907e54aa259516440267cc&v=4","created_at":"0001-01-01T00:00:00Z","followers":0,"following":0,"html_url":"https://github.com/fire","id":32321,"node_id":"MDQ6VXNlcjMyMzIx","login":"fire","type":"User","owned_private_repos":0,"public_gists":0,"public_repos":0,"total_private_repos":0,"url":"https://api.github.com/users/fire"},"body":"","html_url":"https://github.com/godotengine/godot/pull/109437#pullrequestreview-3102202159","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/109437","author_association":"MEMBER","submitted_at"