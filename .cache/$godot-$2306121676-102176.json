[{"id":2583498599,"node_id":"PRR_kwDOAO6SJc6Z_Q9n","state":"CHANGES_REQUESTED","user":{"site_admin":false,"suspended":false,"updated_at":"0001-01-01T00:00:00Z","avatar_url":"https://avatars.githubusercontent.com/u/61938263?u=9b90963f1b4f17720e50bbbe495fbe8c84c8bc8e&v=4","created_at":"0001-01-01T00:00:00Z","followers":0,"following":0,"html_url":"https://github.com/TokageItLab","id":61938263,"node_id":"MDQ6VXNlcjYxOTM4MjYz","login":"TokageItLab","type":"User","owned_private_repos":0,"public_gists":0,"public_repos":0,"total_private_repos":0,"url":"https://api.github.com/users/TokageItLab"},"body":"It might okay to handle this in cases where all selected objects are in the same direction, but it makes no sense in other cases.\r\n\r\nFor example, if object A's local +Z axis points to +Z in the world and object B's local +Z axis points to -Z in the world, a move to +Z with multiple selection in local mode will move each in the opposite direction.\r\n\r\nSo from a GUI perspective, it may be appropriate not to move Gizmo out of place when moving. At this time, I assume that the movement of translation can be calculated using averaging, but basis cannot be averaged. Therefor the only way at this stage for consistent behavior is to use the world visually.\r\n\r\nThe best way would be to visually duplicate TransformGizmo for the number of selected objects IMO, but this would require a fair amount of overhaul work.\r\n\r\nAnother way I can think of is to decide/select (in a way that the user can explicitly handle it) on one leader for multiple selections and use that basis, as in Blender, but this case does not solve the visual problem when each has a different local basis. This will also make it tempting to implement a new mode that ignores each local axis.","html_url":"https://github.com/godotengine/godot/pull/102176#pullrequestreview-2583498599","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/102176","author_association":"MEMBER","submitted_at":"2025-01-30T10:25:48Z"},{"id":2586243598,"node_id":"PRR_kwDOAO6SJc6aJvIO","state":"CHANGES_REQUESTED","user":{"site_admin":false,"suspended":false,"updated_at":"0001-01-01T00:00:00Z","avatar_url":"https://avatars.githubusercontent.com/u/61938263?u=9b90963f1b4f17720e50bbbe495fbe8c84c8bc8e&v=4","created_at":"0001-01-01T00:00:00Z","followers":0,"following":0,"html_url":"https://github.com/TokageItLab","id":61938263,"node_id":"MDQ6VXNlcjYxOTM4MjYz","login":"TokageItLab","type":"User","owned_private_repos":0,"public_gists":0,"public_repos":0,"total_private_repos":0,"url":"https://api.github.com/users/TokageItLab"},"body":"","html_url":"https://github.com/godotengine/godot/pull/102176#pullrequestreview-2586243598","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/102176","author_association":"MEMBER","submitted_at":"2025-01-31T10:36:15Z"},{"id":2586253395,"node_id":"PRR_kwDOAO6SJc6aJxhT","state":"COMMENTED","user":{"site_admin":false,"suspended":false,"updated_at":"0001-01-01T00:00:00Z","avatar_url":"https://avatars.githubusercontent.com/u/105675984?v=4","created_at":"0001-01-01T00:00:00Z","followers":0,"following":0,"html_url":"https://github.com/ryevdokimov","id":105675984,"node_id":"U_kgDOBkx80A","login":"ryevdokimov","type":"User","owned_private_repos":0,"public_gists":0,"public_repos":0,"total_private_repos":0,"url":"https://api.github.com/users/ryevdokimov"},"body":"","html_url":"https://github.com/godotengine/godot/pull/102176#pullrequestreview-2586253395","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/102176","author_association":"CONTRIBUTOR","submitted_at":"2025-01-31T10:40:49Z"},{"id":2586265117,"node_id":"PRR_kwDOAO6SJc6aJ0Yd","state":"COMMENTED","user":{"site_admin":false,"suspended":false,"updated_at":"0001-01-01T00:00:00Z","avatar_url":"https://avatars.githubusercontent.com/u/61938263?u=9b90963f1b4f17720e50bbbe495fbe8c84c8bc8e&v=4","created_at":"0001-01-01T00:00:00Z","followers":0,"following":0,"html_url":"https:/