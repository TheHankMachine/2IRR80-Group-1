ditor and project;\n- Enable embedding and floating and run the project;\n- Close the game with the WM's close button\n\n### Minimal reproduction project (MRP)\n\nn/a","closed_by":{"login":"deralmas","id":31065808,"node_id":"MDQ6VXNlcjMxMDY1ODA4","avatar_url":"https://avatars.githubusercontent.com/u/31065808?v=4","gravatar_id":"","url":"https://api.github.com/users/deralmas","html_url":"https://github.com/deralmas","followers_url":"https://api.github.com/users/deralmas/followers","following_url":"https://api.github.com/users/deralmas/following{/other_user}","gists_url":"https://api.github.com/users/deralmas/gists{/gist_id}","starred_url":"https://api.github.com/users/deralmas/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/deralmas/subscriptions","organizations_url":"https://api.github.com/users/deralmas/orgs","repos_url":"https://api.github.com/users/deralmas/repos","events_url":"https://api.github.com/users/deralmas/events{/privacy}","received_events_url":"https://api.github.com/users/deralmas/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/118183/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/godotengine/godot/issues/118183/timeline","performed_via_github_app":null,"state_reason":"duplicate","pinned_comment":null}