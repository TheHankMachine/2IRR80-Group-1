_at":null,"archived_by":null},{"id":9548448620,"node_id":"LA_kwDOAO6SJc8AAAACOSHDbA","url":"https://api.github.com/repos/godotengine/godot/labels/platform:visionos","name":"platform:visionos","color":"e4e4e4","default":false,"description":"","archived_at":null,"archived_by":null}],"state":"closed","locked":false,"assignees":[],"milestone":{"url":"https://api.github.com/repos/godotengine/godot/milestones/25","html_url":"https://github.com/godotengine/godot/milestone/25","labels_url":"https://api.github.com/repos/godotengine/godot/milestones/25/labels","id":15520464,"node_id":"MI_kwDOAO6SJc4A7NLQ","number":25,"title":"4.8","description":"","creator":{"login":"Repiteo","id":17489292,"node_id":"MDQ6VXNlcjE3NDg5Mjky","avatar_url":"https://avatars.githubusercontent.com/u/17489292?v=4","gravatar_id":"","url":"https://api.github.com/users/Repiteo","html_url":"https://github.com/Repiteo","followers_url":"https://api.github.com/users/Repiteo/followers","following_url":"https://api.github.com/users/Repiteo/following{/other_user}","gists_url":"https://api.github.com/users/Repiteo/gists{/gist_id}","starred_url":"https://api.github.com/users/Repiteo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Repiteo/subscriptions","organizations_url":"https://api.github.com/users/Repiteo/orgs","repos_url":"https://api.github.com/users/Repiteo/repos","events_url":"https://api.github.com/users/Repiteo/events{/privacy}","received_events_url":"https://api.github.com/users/Repiteo/received_events","type":"User","user_view_type":"public","site_admin":false},"open_issues":345,"closed_issues":2336,"state":"open","created_at":"2026-04-13T15:59:35Z","updated_at":"2026-10-22T08:21:32Z","due_on":null,"closed_at":null},"comments":4,"created_at":"2026-09-24T16:29:49Z","updated_at":"2026-10-08T18:43:34Z","closed_at":"2026-10-08T18:43:21Z","assignee":null,"author_association":"CONTRIBUTOR","issue_field_values":[],"type":null,"active_lock_reason":null,"draft":false,"pull_request":{"url":"https://api.github.com/repos/godotengine/godot/pulls/123801","html_url":"https://github.com/godotengine/godot/pull/123801","diff_url":"https://github.com/godotengine/godot/pull/123801.diff","patch_url":"https://github.com/godotengine/godot/pull/123801.patch","merged_at":"2026-10-08T18:43:21Z"},"body":"<!--\r\nPlease target the `master` branch. We will take care of backporting relevant fixes to older versions.\r\n\r\nBefore submitting, please read our checklist for contributors:\r\nhttps://contributing.godotengine.org/en/latest/development/engine/introduction.html#checklist-for-new-contributors\r\n\r\nUse of AI must be disclosed and should include a description of how it was used.\r\n-->\r\n\r\n## What problem(s) does this PR solve?\r\n\r\n- Closes #123800\r\n\r\nThe shared part of the Apple Embedded exporter enforces `iphone-ipad-minimum-performance-a12` and allows `iphone-performance-gaming-tier` for visionOS, both of which are [unsupported](https://developer.apple.com/documentation/bundleresources/information-property-list/uirequireddevicecapabilities#possibleValues) on that platform.\r\n\r\nHaving these capabilities in the Info.plist does not cause any issues and the project can be deployed to a device, but when uploading the TestFlight (and presumably the App Store), the build is rejected.\r\n\r\nThis PR removes the above two capabilities from the visionOS export path by pushing down the handling of both iOS-specific capabilities to the iOS export plugin.\r\n\r\n## Additional information\r\n\r\n<!--\r\nProvide additional information and explanation of your PR, including areas that you are uncertain of or require special attention from reviewers. For examples, please read our pull request guidelines: https://contributing.godotengine.org/en/latest/development/contribution_rules.html#explain-your-contributions\r\n-->\r\n\r\nI built and tested this locally and was able to successfully upload a visionOS build to TestFlight with it.\r\n\r\n~~If I am not mistaken, `\"ios\"` should cover both iOS and iPadOS here?\r\nI was also considering `!= \"visionos\"` but this may then have to be changed if more Apple embedded platforms are supported, e.g. [tvOS](https://github.com/godotengine/godot/pull/118332). Although it's not as clearly documented, I would assume these fields also make no sense on that platform.~~\r\n\r\nAI was used to identify the relevant code paths and to implement a first fix, which I then reduced to what I believe is the minimal fix. No AI was used to implement the revised version.","closed_by":{"login":"Repiteo","id":17489292,"node_id":"MDQ6VXNlcjE3NDg5Mjky","avatar_url":"https://avatars.githubusercontent.com/u/17489292?v=4","gravatar_id":"","url":"https://api.github.com/users/Repiteo","html_url":"https://github.com/Repiteo","followers_url":"https://api.github.com/users/Repiteo/followers","following_url":"https://api.github.com/users/Repiteo/following{/other_user}","gists_url":"https://api.github.com/users/Repiteo/gists{/gist_id}","starred_url":"https://api.github.com/users/Repiteo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Repiteo/subscriptions","organizations_url":"https://api.github.com/users/Repiteo/orgs","repos_url":"https://api.github.com/users/Repiteo/repos","events_url":"https://api.github.com/users/Repiteo/events{/privacy}","received_events_url":"https://api.github.com/users/Repiteo/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/123801/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/godotengine/godot/issues/123801/timeline","performed_via_github_app":null,"state_reason":null}