sues/comments/4678445174","html_url":"https://github.com/godotengine/godot/pull/107164#issuecomment-4678445174","issue_url":"https://api.github.com/repos/godotengine/godot/issues/107164","id":4678445174,"node_id":"IC_kwDOAO6SJc8AAAABFttodg","user":{"login":"Naros","id":3255568,"node_id":"MDQ6VXNlcjMyNTU1Njg=","avatar_url":"https://avatars.githubusercontent.com/u/3255568?v=4","gravatar_id":"","url":"https://api.github.com/users/Naros","html_url":"https://github.com/Naros","followers_url":"https://api.github.com/users/Naros/followers","following_url":"https://api.github.com/users/Naros/following{/other_user}","gists_url":"https://api.github.com/users/Naros/gists{/gist_id}","starred_url":"https://api.github.com/users/Naros/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Naros/subscriptions","organizations_url":"https://api.github.com/users/Naros/orgs","repos_url":"https://api.github.com/users/Naros/repos","events_url":"https://api.github.com/users/Naros/events{/privacy}","received_events_url":"https://api.github.com/users/Naros/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-06-11T08:01:21Z","updated_at":"2026-06-11T08:01:21Z","body":"I recently came across this issue after users reported issues with editor themes.\r\n\r\nWe ship a number of custom editor-specific icons, and whenever a user changes their theme from light to dark or vice versa based on their system or preferences, plugin assets must be reimported for them to tint appropriately. This is not user-friendly at all, and I believe anything that restores the older auto-reimport behavior would be a nice usability improvement.\r\n","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4678445174/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null}]