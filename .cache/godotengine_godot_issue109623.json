inux\", true)`\n\n\t\nbut no luck. i think godot is not using that config","closed_by":{"login":"Enlumis","id":12009814,"node_id":"MDQ6VXNlcjEyMDA5ODE0","avatar_url":"https://avatars.githubusercontent.com/u/12009814?v=4","gravatar_id":"","url":"https://api.github.com/users/Enlumis","html_url":"https://github.com/Enlumis","followers_url":"https://api.github.com/users/Enlumis/followers","following_url":"https://api.github.com/users/Enlumis/following{/other_user}","gists_url":"https://api.github.com/users/Enlumis/gists{/gist_id}","starred_url":"https://api.github.com/users/Enlumis/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Enlumis/subscriptions","organizations_url":"https://api.github.com/users/Enlumis/orgs","repos_url":"https://api.github.com/users/Enlumis/repos","events_url":"https://api.github.com/users/Enlumis/events{/privacy}","received_events_url":"https://api.github.com/users/Enlumis/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/109623/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/godotengine/godot/issues/109623/timeline","performed_via_github_app":null,"state_reason":"completed","pinned_comment":null}