ind it, and that other engines have implemented this as well, it all makes sense to me that we adopt this.","html_url":"https://github.com/godotengine/godot/pull/115426#pullrequestreview-4011208927","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/115426","author_association":"CONTRIBUTOR","submitted_at":"2026-03-26T03:39:21Z"},{"id":4022421075,"node_id":"PRR_kwDOAO6SJc7vwUZT","state":"COMMENTED","commit_id":"87c03fc97f8754b02e8ee7a2f605fab791283123","user":{"site_admin":false,"suspended":false,"updated_at":"0001-01-01T00:00:00Z","avatar_url":"https://avatars.githubusercontent.com/u/7585719?u=4a3628ad6d02b550753f186137601d56a8ef66e6&v=4","created_at":"0001-01-01T00:00:00Z","followers":0,"following":0,"html_url":"https://github.com/KenzieMac130","id":7585719,"node_id":"MDQ6VXNlcjc1ODU3MTk=","login":"KenzieMac130","type":"User","owned_private_repos":0,"public_gists":0,"public_repos":0,"total_private_repos":0,"url":"https://api.github.com/users/KenzieMac130"},"body":"","html_url":"https://github.com/godotengine/godot/pull/115426#pullrequestreview-4022421075","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/115426","author_association":"CONTRIBUTOR","submitted_at":"2026-03-27T16:50:50Z"},{"id":4022431823,"node_id":"PRR_kwDOAO6SJc7vwXBP","state":"COMMENTED","commit_id":"87c03fc97f8754b02e8ee7a2f605fab791283123","user":{"site_admin":false,"suspended":false,"updated_at":"0001-01-01T00:00:00Z","avatar_url":"https://avatars.githubusercontent.com/u/7585719?u=4a3628ad6d02b550753f186137601d56a8ef66e6&v=4","created_at":"0001-01-01T00:00:00Z","followers":0,"following":0,"html_url":"https://github.com/KenzieMac130","id":7585719,"node_id":"MDQ6VXNlcjc1ODU3MTk=","login":"KenzieMac130","type":"User","owned_private_repos":0,"public_gists":0,"public_repos":0,"total_private_repos":0,"url":"https://api.github.com/users/KenzieMac130"},"body":"","html_url":"https://github.com/godotengine/godot/pull/115426#pullrequestreview-4022431823","pull_r