al_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":423,"original_line":423,"side":"RIGHT","in_reply_to_id":2072385048,"author_association":"MEMBER","original_position":13,"position":55,"subject_type":"line"},{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/2085836260","pull_request_review_id":2835149023,"id":2085836260,"node_id":"PRRC_kwDOAO6SJc58U1Xk","diff_hunk":"@@ -387,6 +387,33 @@ bool GDExtensionManager::ensure_extensions_loaded(const HashSet<String> &p_exten\n \treturn needs_restart;\n }\n \n+void GDExtensionManager::startup() {\n+\tfor (const KeyValue<String, Ref<GDExtension>> &E : gdextension_map) {\n+\t\tconst Ref<GDExtension> &extension = E.value;\n+\t\tif (extension->startup_callback) {\n+\t\t\textension->startup_callback();\n+\t\t}\n+\t}\n+}\n+\n+void GDExtensionManager::shutdown() {","path":"core/extension/gdextension_manager.cpp","commit_id":"73488f5afdd119adfba34674c8cebc541ec42a5b","original_commit_id":"dbe35d48fffe7e59c058d66bcb75b3a78590aeb1","user":{"login":"dsnopek","id":191561,"node_id":"MDQ6VXNlcjE5MTU2MQ==","avatar_url":"https://avatars.githubusercontent.com/u/191561?v=4","gravatar_id":"","url":"https://api.github.com/users/dsnopek","html_url":"https://github.com/dsnopek","followers_url":"https://api.github.com/users/dsnopek/followers","following_url":"https://api.github.com/users/dsnopek/following{/other_user}","gists_url":"https://api.github.com/users/dsnopek/gists{/gist_id}","starred_url":"https://api.github.com/users/dsnopek/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/dsnopek/subscriptions","organizations_url":"https://api.github.com/users/dsnopek/orgs","repos_url":"https://api.github.com/users/dsnopek/repos","events_url":"https://api.github.com/users/dsnopek/events{/privacy}","received_events_url":"https://api.github.com/users/dsnopek/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"> I don't have a use case for `startup` or `shutdown`\r\n\r\nSorry, if this is taking you too off course, you could remove those from this PR, and I could make another PR just focused on those? :-)\r\n\r\n> I feel like this behavior overlaps with the `initialize` and `deinitialize` callbacks from the `GDExtensionInitialization` struct and I'm not sure what benefit they provide over using the existing ones.\r\n\r\nThe benefit is that Godot is guaranteed to be fully initialized when they run, which isn't the case for the `initialize` and `deinitialize` callbacks: during Godot's startup and shutdown process, those will get called when Godot is in various in-between states","created_at":"2025-05-13T02:57:13Z","updated_at":"2025-05-13T02:57:13Z","html_url":"https://github.com/godotengine/godot/pull/106030#discussion_r2085836260","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/106030","_links":{"self":{"href":"https://api.github.com/repos/godotengine/godot/pulls/comments/2085836260"},"html":{"href":"https://github.com/godotengine/godot/pull/106030#discussion_r2085836260"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/106030"}},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/2085836260/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":423,"original_line":423,"side":"RIGHT","in_reply_to_id":2072385048,"author_association":"CONTRIBUTOR","original_position":13,"position":55,"subject_type":"line"},{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/2085867629","pull_request_review_id":2835194500,"id":2085867629,"node_id":"PRRC_kwDOAO6SJc58U9Bt","diff_hunk":"@@ -387,6 +387,33 @@ bool GDExtensionManager::ensure_extensions_loaded(const HashSet<String> &p_exten\n \treturn needs_restart;\n }\n \n+void GDExtension