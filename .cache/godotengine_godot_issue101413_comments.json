/followers","following_url":"https://api.github.com/users/BattyBovine/following{/other_user}","gists_url":"https://api.github.com/users/BattyBovine/gists{/gist_id}","starred_url":"https://api.github.com/users/BattyBovine/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/BattyBovine/subscriptions","organizations_url":"https://api.github.com/users/BattyBovine/orgs","repos_url":"https://api.github.com/users/BattyBovine/repos","events_url":"https://api.github.com/users/BattyBovine/events{/privacy}","received_events_url":"https://api.github.com/users/BattyBovine/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-01-18T18:34:28Z","updated_at":"2025-01-18T18:34:28Z","body":"This is strange, because I never touched anything specific to `CollisionPolygon3D`. I'm still going to look into it because I do have to also add the filled shapes to `CollisionPolygon3D`, and clearly something happened here that I should fix.","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2599823216/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2600728541","html_url":"https://github.com/godotengine/godot/issues/101413#issuecomment-2600728541","issue_url":"https://api.github.com/repos/godotengine/godot/issues/101413","id":2600728541,"node_id":"IC_kwDOAO6SJc6bA_fd","user":{"login":"BattyBovine","id":428511,"node_id":"MDQ6VXNlcjQyODUxMQ==","avatar_url":"https://avatars.githubusercontent.com/u/428511?v=4","gravatar_id":"","url":"https://api.github.com/users/BattyBovine","html_url":"https://github.com/BattyBovine","followers_url":"https://api.github.com/users/BattyBovine/followers","following_url":"https://api.github.com/users/BattyBovine/following{/other_user}","gists_url":"https://api.github.com/users/BattyBovine/gists{/gist_id}","starred_url":"https://api.github.com/users/BattyBovine/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/BattyBovine/subscriptions","organizations_url":"https://api.github.com/users/BattyBovine/orgs","repos_url":"https://api.github.com/users/BattyBovine/repos","events_url":"https://api.github.com/users/BattyBovine/events{/privacy}","received_events_url":"https://api.github.com/users/BattyBovine/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-01-19T06:42:14Z","updated_at":"2025-01-19T06:42:14Z","body":"The solution here turned out to be pretty simple. `CollisionPolygon3D` did not support custom debug colours (#101414), and therefore was rendering its debug lines as `Color(0.0, 0.0, 0.0, 0.0)`, making them invisible. By fixing #101414, we also fix this. I'll get the fix finalised soon.","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2600728541/reactions","total_count":3,"+1":2,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":1,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null}]