     ::ClassDB::register_internal_class<m_class>(); \\\n      |                            ^\nmodules\\gdscript\\gdscript.h(54,2): note: candidate constructor not viable: requires single argument 'p_name', but no arguments were provided\n   54 |         GDScriptNativeClass(const StringName &p_name);\n      |         ^                   ~~~~~~~~~~~~~~~~~~~~~~~~\nmodules\\gdscript\\gdscript.h(40,7): note: candidate constructor (the implicit copy constructor) not viable: requires 1 argument, but 0 were provided\n   40 | class GDScriptNativeClass : public RefCounted {\n      |       ^~~~~~~~~~~~~~~~~~~\n```\nAdded a default constructor modeled after `Shape3D`'s (which has the same no-ClassDB-construction requirement). ","created_at":"2026-08-24T17:53:42Z","updated_at":"2026-08-24T17:53:42Z","html_url":"https://github.com/godotengine/godot/pull/111947#discussion_r3846069014","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/111947","_links":{"self":{"href":"https://api.github.com/repos/godotengine/godot/pulls/comments/3846069014"},"html":{"href":"https://github.com/godotengine/godot/pull/111947#discussion_r3846069014"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/111947"}},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/3846069014/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":null,"original_line":57,"side":"RIGHT","in_reply_to_id":3845807713,"author_association":"CONTRIBUTOR","original_position":5,"position":1,"subject_type":"line"}]