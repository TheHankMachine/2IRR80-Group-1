scription":"","archived_at":null,"archived_by":null}],"state":"closed","locked":false,"assignees":[],"milestone":{"url":"https://api.github.com/repos/godotengine/godot/milestones/23","html_url":"https://github.com/godotengine/godot/milestone/23","labels_url":"https://api.github.com/repos/godotengine/godot/milestones/23/labels","id":12939969,"node_id":"MI_kwDOAO6SJc4AxXLB","number":23,"title":"4.6","description":"","creator":{"login":"Repiteo","id":17489292,"node_id":"MDQ6VXNlcjE3NDg5Mjky","avatar_url":"https://avatars.githubusercontent.com/u/17489292?v=4","gravatar_id":"","url":"https://api.github.com/users/Repiteo","html_url":"https://github.com/Repiteo","followers_url":"https://api.github.com/users/Repiteo/followers","following_url":"https://api.github.com/users/Repiteo/following{/other_user}","gists_url":"https://api.github.com/users/Repiteo/gists{/gist_id}","starred_url":"https://api.github.com/users/Repiteo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Repiteo/subscriptions","organizations_url":"https://api.github.com/users/Repiteo/orgs","repos_url":"https://api.github.com/users/Repiteo/repos","events_url":"https://api.github.com/users/Repiteo/events{/privacy}","received_events_url":"https://api.github.com/users/Repiteo/received_events","type":"User","user_view_type":"public","site_admin":false},"open_issues":3,"closed_issues":2978,"state":"closed","created_at":"2025-05-22T16:25:52Z","updated_at":"2026-10-04T16:23:23Z","due_on":null,"closed_at":"2026-01-26T18:09:14Z"},"comments":0,"created_at":"2025-11-13T01:09:51Z","updated_at":"2025-12-15T19:06:19Z","closed_at":"2025-12-15T19:06:18Z","assignee":null,"author_association":"CONTRIBUTOR","issue_field_values":[],"type":null,"active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"### Tested versions\n\n- Reproducible in 4.6-dev\n\n### System information\n\nUbuntu 24.04.2 LTS\n\n### Issue description\n\nWhen using the modern theme, with the compact setting, on a 1080p display, the icons that are present on EditorProperty entries can be either blurry or crisp depending on the nesting level.\n\n<img width=\"418\" height=\"244\" alt=\"Image\" src=\"https://github.com/user-attachments/assets/5953350d-838a-4a13-abf2-ab3c5a7eb9c1\" />\n\nThe icons in green are shown correctly (nesting level X)\nThe icons in orange are shown blurry (nesting level X + 1, with a section in-between).\n\nBecause of this variable result, this may not be fixed on the control itself. I think there is an issue with some of the margins or paddings that can be uneven between the nesting levels.\n\nThis does not happen on the classic theme.\n\nIn the `theme_modern.cpp` file, I noticed that non-integer multiplications of the scale factor are used in many places (example: `1.5 * EDSCALE`), whereas the classic theme only uses integers. A rounding of the resulting value using `Math::floor`, `Math::round`, or `Math::ceil` is rarely done.\n\nWith the trend of having more high-DPI screens on laptops, I can imagine that testing on standard 1080p resolution can be unpractical. But this still should be cared about in some way, as not all machines comfortably handle external monitors with high resolutions, especially modest ones.\n\n### Steps to reproduce\n\nUse a 1920x1080 monitor or any similar where the OS scaling is 100%. No Hidpi or Retina.\n\nCreate a new project.\n\nCreate a 2D scene. Add a Sprite2D and an AnimationPlayer (so that the key buttons appear).\n\nSet the editor theme to modern, with the compact preset.\n\nInspect the Sprite2D.\n\nYou can observe the result like the screenshot above.\n\n\n\n### Minimal reproduction project (MRP)\n\nN/A","closed_by":{"login":"Repiteo","id":17489292,"node_id":"MDQ6VXNlcjE3NDg5Mjky","avatar_url":"https://avatars.githubusercontent.com/u/17489292?v=4","gravatar_id":"","url":"https://api.github.com/users/Repiteo","html_url":"https://github.com/Repiteo","followers_url":"https://api.github.com/users/Repiteo/followers","following_url":"https://api.github.com/users/Repiteo/following{/other_user}","gists_url":"https://api.github.com/users/Repiteo/gists{/gist_id}","starred_url":"https://api.github.com/users/Repiteo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Repiteo/subscriptions","organizations_url":"https://api.github.com/users/Repiteo/orgs","repos_url":"https://api.github.com/users/Repiteo/repos","events_url":"https://api.github.com/users/Repiteo/events{/privacy}","received_events_url":"https://api.github.com/users/Repiteo/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/112700/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/godotengine/godot/issues/112700/timeline","performed_via_github_app":null,"state_reason":"completed","pinned_comment":null}