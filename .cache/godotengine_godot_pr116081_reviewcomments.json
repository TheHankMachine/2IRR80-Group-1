ithub.com/users/arkology/followers","following_url":"https://api.github.com/users/arkology/following{/other_user}","gists_url":"https://api.github.com/users/arkology/gists{/gist_id}","starred_url":"https://api.github.com/users/arkology/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/arkology/subscriptions","organizations_url":"https://api.github.com/users/arkology/orgs","repos_url":"https://api.github.com/users/arkology/repos","events_url":"https://api.github.com/users/arkology/events{/privacy}","received_events_url":"https://api.github.com/users/arkology/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"Maybe here?\r\n```cpp\r\nvoid GotoLinePopup::_submit() {\r\n\t_goto_line();\r\n\thide();\r\n\ttext_editor->get_text_editor()->grab_focus();\r\n}\r\n```\r\nSo text editor will get focus only if line number is submitted. If `GotoLinePopup` is closed using ESC, focus will be still where it was before.\r\nAt least if I understand correctly.","created_at":"2026-02-11T06:06:20Z","updated_at":"2026-02-11T06:27:03Z","html_url":"https://github.com/godotengine/godot/pull/116081#discussion_r2791560723","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/116081","_links":{"self":{"href":"https://api.github.com/repos/godotengine/godot/pulls/comments/2791560723"},"html":{"href":"https://github.com/godotengine/godot/pull/116081#discussion_r2791560723"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/116081"}},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/2791560723/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":null,"original_line":1859,"side":"RIGHT","in_reply_to_id":2790383276,"author_association":"CONTRIBUTOR","original_position":14,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/go