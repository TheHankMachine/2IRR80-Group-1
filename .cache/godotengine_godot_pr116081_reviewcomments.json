48Z","html_url":"https://github.com/godotengine/godot/pull/116081#discussion_r2791720147","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/116081","_links":{"self":{"href":"https://api.github.com/repos/godotengine/godot/pulls/comments/2791720147"},"html":{"href":"https://github.com/godotengine/godot/pull/116081#discussion_r2791720147"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/116081"}},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/2791720147/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":null,"original_line":1859,"side":"RIGHT","in_reply_to_id":2790383276,"author_association":"CONTRIBUTOR","original_position":14,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/2793380542","pull_request_review_id":3784913795,"id":2793380542,"node_id":"PRRC_kwDOAO6SJc6mf5q-","diff_hunk":"@@ -1855,11 +1855,17 @@ float CodeTextEditor::get_zoom_factor() {\n \treturn zoom_factor;\n }\n \n+void CodeTextEditor::_show_goto_popup_request() {\n+\tline_and_col_button->release_focus();","path":"editor/gui/code_editor.cpp","commit_id":"8976ad2848ad94978b2586d3a290df5cbece6a43","original_commit_id":"8976ad2848ad94978b2586d3a290df5cbece6a43","user":{"login":"kitbdev","id":10054226,"node_id":"MDQ6VXNlcjEwMDU0MjI2","avatar_url":"https://avatars.githubusercontent.com/u/10054226?v=4","gravatar_id":"","url":"https://api.github.com/users/kitbdev","html_url":"https://github.com/kitbdev","followers_url":"https://api.github.com/users/kitbdev/followers","following_url":"https://api.github.com/users/kitbdev/following{/other_user}","gists_url":"https://api.github.com/users/kitbdev/gists{/gist_id}","starred_url":"https://api.github.com/users/kitbdev/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/kitbdev/subscriptions","organizations_url":"https://api.github.com/users/kitbdev/orgs","repos_url":"https://api.github.com/users/kitbdev/repos","events_url":"https://api.github.com/users/kitbdev/events{/privacy}","received_events_url":"https://api.github.com/users/kitbdev/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"If you use the go to line popup at all, then you are using the text editor, they are very linked. Even if the popup is triggered from the menu and not the button it should still give focus to the TextEdit when it is closed. If you were focused somewhere else then opening the popup is enough to lose focus there, as if the text editor itself was clicked.\r\nAnd I think it should be on hide not just submit, since the caret can still move in that case (back to its original position) and the scroll can move too.","created_at":"2026-02-11T13:45:26Z","updated_at":"2026-02-11T13:45:26Z","html_url":"https://github.com/godotengine/godot/pull/116081#discussion_r2793380542","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/116081","_links":{"self":{"href":"https://api.github.com/repos/godotengine/godot/pulls/comments/2793380542"},"html":{"href":"https://github.com/godotengine/godot/pull/116081#discussion_r2793380542"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/116081"}},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/2793380542/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":null,"original_line":1859,"side":"RIGHT","in_reply_to_id":2790383276,"author_association":"CONTRIBUTOR","original_position":14,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/2793439314","pull_request_review_id":3784982074,"id":2793439314,"node_id":"PRRC_kwDOAO6SJc6mgIBS","diff_hunk":"@@ -1855,11