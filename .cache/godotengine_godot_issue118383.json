ved_by":null},{"id":2666705648,"node_id":"MDU6TGFiZWwyNjY2NzA1NjQ4","url":"https://api.github.com/repos/godotengine/godot/labels/topic:animation","name":"topic:animation","color":"ffee88","default":false,"description":"","archived_at":null,"archived_by":null},{"id":3240950060,"node_id":"MDU6TGFiZWwzMjQwOTUwMDYw","url":"https://api.github.com/repos/godotengine/godot/labels/performance","name":"performance","color":"447777","default":false,"description":"","archived_at":null,"archived_by":null}],"state":"closed","locked":false,"assignees":[],"milestone":{"url":"https://api.github.com/repos/godotengine/godot/milestones/25","html_url":"https://github.com/godotengine/godot/milestone/25","labels_url":"https://api.github.com/repos/godotengine/godot/milestones/25/labels","id":15520464,"node_id":"MI_kwDOAO6SJc4A7NLQ","number":25,"title":"4.8","description":"","creator":{"login":"Repiteo","id":17489292,"node_id":"MDQ6VXNlcjE3NDg5Mjky","avatar_url":"https://avatars.githubusercontent.com/u/17489292?v=4","gravatar_id":"","url":"https://api.github.com/users/Repiteo","html_url":"https://github.com/Repiteo","followers_url":"https://api.github.com/users/Repiteo/followers","following_url":"https://api.github.com/users/Repiteo/following{/other_user}","gists_url":"https://api.github.com/users/Repiteo/gists{/gist_id}","starred_url":"https://api.github.com/users/Repiteo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Repiteo/subscriptions","organizations_url":"https://api.github.com/users/Repiteo/orgs","repos_url":"https://api.github.com/users/Repiteo/repos","events_url":"https://api.github.com/users/Repiteo/events{/privacy}","received_events_url":"https://api.github.com/users/Repiteo/received_events","type":"User","user_view_type":"public","site_admin":false},"open_issues":346,"closed_issues":2304,"state":"open","created_at":"2026-04-13T15:59:35Z","updated_at":"2026-10-21T09:34:58Z","due_on":null,"closed_at":null},"comments":2,"created_at":"2026-04-10T14:51:01Z","updated_at":"2026-08-24T19:51:36Z","closed_at":"2026-08-24T19:51:14Z","assignee":null,"author_association":"CONTRIBUTOR","issue_field_values":[],"type":null,"active_lock_reason":null,"draft":false,"pull_request":{"url":"https://api.github.com/repos/godotengine/godot/pulls/118383","html_url":"https://github.com/godotengine/godot/pull/118383","diff_url":"https://github.com/godotengine/godot/pull/118383.diff","patch_url":"https://github.com/godotengine/godot/pull/118383.patch","merged_at":"2026-08-24T19:51:14Z"},"body":"I select and drag 895 keys in the videos below.\r\n\r\n|Before|After|\r\n|-|-|\r\n|<video src=\"https://github.com/user-attachments/assets/2876bebf-b8a3-478e-b8fa-ef77bc498394\">|<video src=\"https://github.com/user-attachments/assets/1f9c63d3-0601-4071-b916-fe38bb68dcc1\">|\r\n\r\n**Laggy reason**\r\n\r\nAs shown in the profiler screenshot below, the performance bottleneck when selecting and moving multiple keys is `AnimationTrackEditor::_update_key_edit`. During the `// 7 - Reselect.` step in `AnimationTrackEditor::_move_selection_commit`, the UndoRedo system calls `_select_at_anim` for every selected key. Consequently, `_update_key_edit` is executed $O(N)$ times. \r\n\r\n<img width=\"1280\" height=\"752\" alt=\"analysiss\" src=\"https://github.com/user-attachments/assets/fae2ec90-2c39-4ae4-bb26-431f6a8d916a\" />\r\n\r\n**Solution**\r\n\r\nWhat `_update_key_edit` does is notifying EditorNode about the current editing target. So it is sufficient to only call it once after `selection` is completely updated. To fix the lag, I deffered the actual update logic using call_deferred and track a pending flag to ensure the update logic is only executed once.","closed_by":{"login":"Repiteo","id":17489292,"node_id":"MDQ6VXNlcjE3NDg5Mjky","avatar_url":"https://avatars.githubusercontent.com/u/17489292?v=4","gravatar_id":"","url":"https://api.github.com/users/Repiteo","html_url":"https://github.com/Repiteo","followers_url":"https://api.github.com/users/Repiteo/followers","following_url":"https://api.github.com/users/Repiteo/following{/other_user}","gists_url":"https://api.github.com/users/Repiteo/gists{/gist_id}","starred_url":"https://api.github.com/users/Repiteo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Repiteo/subscriptions","organizations_url":"https://api.github.com/users/Repiteo/orgs","repos_url":"https://api.github.com/users/Repiteo/repos","events_url":"https://api.github.com/users/Repiteo/events{/privacy}","received_events_url":"https://api.github.com/users/Repiteo/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/118383/reactions","total_count":10,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":7,"eyes":2},"timeline_url":"https://api.github.com/repos/godotengine/godot/issues/118383/timeline","performed_via_github_app":null,"state_reason":null}