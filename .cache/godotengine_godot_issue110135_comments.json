[{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3263957106","html_url":"https://github.com/godotengine/godot/pull/110135#issuecomment-3263957106","issue_url":"https://api.github.com/repos/godotengine/godot/issues/110135","id":3263957106,"node_id":"IC_kwDOAO6SJc7CjAhy","user":{"login":"KoBeWi","id":2223172,"node_id":"MDQ6VXNlcjIyMjMxNzI=","avatar_url":"https://avatars.githubusercontent.com/u/2223172?v=4","gravatar_id":"","url":"https://api.github.com/users/KoBeWi","html_url":"https://github.com/KoBeWi","followers_url":"https://api.github.com/users/KoBeWi/followers","following_url":"https://api.github.com/users/KoBeWi/following{/other_user}","gists_url":"https://api.github.com/users/KoBeWi/gists{/gist_id}","starred_url":"https://api.github.com/users/KoBeWi/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/KoBeWi/subscriptions","organizations_url":"https://api.github.com/users/KoBeWi/orgs","repos_url":"https://api.github.com/users/KoBeWi/repos","events_url":"https://api.github.com/users/KoBeWi/events{/privacy}","received_events_url":"https://api.github.com/users/KoBeWi/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-09-07T18:27:17Z","updated_at":"2025-09-07T18:27:17Z","body":"If you have multiple scenes open, the signal will be emitted multiple times for one scene when the editor is started.","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3263957106/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3264544922","html_url":"https://github.com/godotengine/godot/pull/110135#issuecomment-3264544922","issue_url":"https://api.github.com/repos/godotengine/godot/issues/110135","id":3264544922,"node_id":"IC_kwDOAO6SJc7ClQCa","user":{"login":"Flynsarmy","id":334808,"node_id":"MDQ6VXNlcjMzNDgwOA==","avatar_url":"https://avatars.githubusercontent.com/u/334808?v=4","gravatar_id":"","url":"https://api.github.com/users/Flynsarmy","html_url":"https://github.com/Flynsarmy","followers_url":"https://api.github.com/users/Flynsarmy/followers","following_url":"https://api.github.com/users/Flynsarmy/following{/other_user}","gists_url":"https://api.github.com/users/Flynsarmy/gists{/gist_id}","starred_url":"https://api.github.com/users/Flynsarmy/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Flynsarmy/subscriptions","organizations_url":"https://api.github.com/users/Flynsarmy/orgs","repos_url":"https://api.github.com/users/Flynsarmy/repos","events_url":"https://api.github.com/users/Flynsarmy/events{/privacy}","received_events_url":"https://api.github.com/users/Flynsarmy/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-09-08T04:24:19Z","updated_at":"2025-09-08T04:24:19Z","body":"> If you have multiple scenes open, the signal will be emitted multiple times for one scene when the editor is started.\r\n\r\nI've done some testing and here are the results.\r\n\r\n## Before this PR\r\n| Scenes open on start | Scene focused on start | `scene_change` emits |\r\n| :------- | :------: | -------: |\r\n| A | A | No signal |\r\n| A, B | A | A, A |\r\n| A, B | B | B |\r\n| A, B, C | A | A, A, A |\r\n| A, B, C | B | B, B, B |\r\n| A, B, C | C | C, C |\r\n\r\n## After this PR\r\n| Scenes open on start | Scene focused on start | `scene_change` emits |\r\n| :------- | :------: | -------: |\r\n| A | A | A |\r\n| A, B | A | A, A, A |\r\n| A, B | B | B, B |\r\n| A, B, C | A | A, A, A, A |\r\n| A, B, C | B | B, B, B, B |\r\n| A, B, C | C | C, C, C |\r\n\r\nThis PR only adds 1 signal emit which fires predictably and correctly no matter how many scenes are open or which is focused when the editor boots. The bug you're seeing with N emits is coming from the existing functionality and is separate from this PR.\r\n\r\nIt's your call but I'd say having the signal emit an extra time when the editor opens with multiple tabs (until that bug gets fixed) is less bad than not having it fire when we need it to in the case of the editor opening with just one tab.","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3264544922/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3319207822","html_url":"https://github.com/godotengine/godot/pull/110135#issuecomment-3319207822","issue_url":"https://api.github.com/repos/godotengine/godot/issues/110135","id":3319207822,"node_id":"IC_kwDOAO6SJc7F1xeO","user":{"login":"Repiteo","id":17489292,"node_id":"MDQ6VXNlcjE3NDg5Mjky","avatar_url":"https://avatars.githubusercontent.com/u/17489292?v=4","gravatar_id":"","url":"https://api.github.com/users/Repiteo","html_url":"https://github.com/Repiteo","followers_url":"https://api.github.com/users/Repiteo/followers","following_url":"https://api.github.com/users/Repiteo/following{/other_user}","gists_url":"https://api.github.com/users/Repiteo/gists{/gist_id}","starred_url":"https://api.github.com/users/Repiteo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Repiteo/subscriptions","organizations_url":"https://api.github.com/users/Repiteo/orgs","repos_url":"https://api.github.com/users/Repiteo/repos","events_url":"https://api.github.com/users/Repiteo/events{/privacy}","received_events_url":"https://api.github.com/users/Repiteo/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-09-22T13:57:56Z","updated_at":"2025-09-22T13:57:56Z","body":"Thanks!","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3319207822/reactions","total_count":1,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":1,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null}]