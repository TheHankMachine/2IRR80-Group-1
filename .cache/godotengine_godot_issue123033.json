iption":"","archived_at":null,"archived_by":null},{"id":572781997,"node_id":"MDU6TGFiZWw1NzI3ODE5OTc=","url":"https://api.github.com/repos/godotengine/godot/labels/topic:audio","name":"topic:audio","color":"ffee88","default":false,"description":"","archived_at":null,"archived_by":null},{"id":3240950060,"node_id":"MDU6TGFiZWwzMjQwOTUwMDYw","url":"https://api.github.com/repos/godotengine/godot/labels/performance","name":"performance","color":"447777","default":false,"description":"","archived_at":null,"archived_by":null}],"state":"open","locked":false,"assignees":[],"milestone":{"url":"https://api.github.com/repos/godotengine/godot/milestones/16","html_url":"https://github.com/godotengine/godot/milestone/16","labels_url":"https://api.github.com/repos/godotengine/godot/milestones/16/labels","id":8237783,"node_id":"MI_kwDOAO6SJc4AfbLX","number":16,"title":"4.x","description":"Issues and pull requests slated for an undetermined Godot 4 release.","creator":{"login":"akien-mga","id":4701338,"node_id":"MDQ6VXNlcjQ3MDEzMzg=","avatar_url":"https://avatars.githubusercontent.com/u/4701338?v=4","gravatar_id":"","url":"https://api.github.com/users/akien-mga","html_url":"https://github.com/akien-mga","followers_url":"https://api.github.com/users/akien-mga/followers","following_url":"https://api.github.com/users/akien-mga/following{/other_user}","gists_url":"https://api.github.com/users/akien-mga/gists{/gist_id}","starred_url":"https://api.github.com/users/akien-mga/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/akien-mga/subscriptions","organizations_url":"https://api.github.com/users/akien-mga/orgs","repos_url":"https://api.github.com/users/akien-mga/repos","events_url":"https://api.github.com/users/akien-mga/events{/privacy}","received_events_url":"https://api.github.com/users/akien-mga/received_events","type":"User","user_view_type":"public","site_admin":false},"open_issues":5790,"closed_issues":0,"state":"open","created_at":"2022-07-26T12:42:05Z","updated_at":"2026-10-22T08:16:48Z","due_on":null,"closed_at":null},"comments":0,"created_at":"2026-08-31T13:46:46Z","updated_at":"2026-09-01T08:39:48Z","closed_at":null,"assignee":null,"author_association":"CONTRIBUTOR","issue_field_values":[],"type":null,"active_lock_reason":null,"draft":false,"pull_request":{"url":"https://api.github.com/repos/godotengine/godot/pulls/123033","html_url":"https://github.com/godotengine/godot/pull/123033","diff_url":"https://github.com/godotengine/godot/pull/123033.diff","patch_url":"https://github.com/godotengine/godot/pull/123033.patch","merged_at":null},"body":"## What problem(s) does this PR solve?\r\n\r\nIn this part of code:\r\n\r\nhttps://github.com/godotengine/godot/blob/5ec4857b340b6284a18b49b2eda462bd250f219a/editor/audio/audio_stream_preview.cpp#L56-L67\r\n\r\nthe loop is guaranteed to run at least one iteration, thanks to the condition above. In the loop, we check if it's the first iteration, and if it is, we set the max value to the current value.\r\n\r\nBy simply setting the variable to the first value outside of that loop, we get a `19%` speed increase. (the compiler probably can optimize it better now)\r\n\r\nNote that the draw call of the preview in `AudioStreamImportSettingsDialog` spends like 99% of it's time in these functions. Using the example audio from https://github.com/godotengine/godot/pull/123012, the `_draw_preview` time drops from `8.6 ms` to `7.0 ms`. \r\n\r\n<img width=\"690\" height=\"503\" alt=\"image\" src=\"https://github.com/user-attachments/assets/bdf97bdc-67ea-4676-b49f-694892db4207\" />\r\n\r\n## Additional information\r\n\r\nCompiler arguments: `scons platform=windows target=editor arch=x86_64` with MSVC. Different compilers or flags may reduce these benefits. Ran about 50 iterations for each tested version.\r\n\r\nNo AI was used.\r\n","closed_by":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/123033/reactions","total_count":5,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":4,"eyes":1},"timeline_url":"https://api.github.com/repos/godotengine/godot/issues/123033/timeline","performed_via_github_app":null,"state_reason":null}