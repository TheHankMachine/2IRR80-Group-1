5971670"},"html":{"href":"https://github.com/godotengine/godot/pull/122957#discussion_r3885971670"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/122957"}},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/3885971670/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":null,"original_line":395,"side":"RIGHT","author_association":"MEMBER","original_position":5,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/3886574346","pull_request_review_id":5058060358,"id":3886574346,"node_id":"PRRC_kwDOAO6SJc7nqGsK","diff_hunk":"@@ -392,7 +392,7 @@ void GodotPhysicsServer2D::area_clear_shapes(RID p_area) {\n \tERR_FAIL_NULL(area);\n \n \twhile (area->get_shape_count()) {\n-\t\tarea->remove_shape(0);\n+\t\tarea->remove_shape(0u);","path":"modules/godot_physics_2d/godot_physics_server_2d.cpp","commit_id":"42fe8a2d2f0f0d2f91bfca06436f2bcae038836a","original_commit_id":"42fe8a2d2f0f0d2f91bfca06436f2bcae038836a","user":{"login":"DeeJayLSP","id":60024671,"node_id":"MDQ6VXNlcjYwMDI0Njcx","avatar_url":"https://avatars.githubusercontent.com/u/60024671?v=4","gravatar_id":"","url":"https://api.github.com/users/DeeJayLSP","html_url":"https://github.com/DeeJayLSP","followers_url":"https://api.github.com/users/DeeJayLSP/followers","following_url":"https://api.github.com/users/DeeJayLSP/following{/other_user}","gists_url":"https://api.github.com/users/DeeJayLSP/gists{/gist_id}","starred_url":"https://api.github.com/users/DeeJayLSP/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/DeeJayLSP/subscriptions","organizations_url":"https://api.github.com/users/DeeJayLSP/orgs","repos_url":"https://api.github.com/users/DeeJayLSP/repos","events_url":"https://api.github.com/users/DeeJayLSP/events{/privacy}","received_events_url":"https://api.github.com/users/DeeJayLSP/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"Because I've changed the input value of `remove_shape` from signed to unsigned (it gets compared to `shapes.size()`, so they need to be in the same signedness).\n\nSince a second version that takes a `GodotShape2D *` exists, the compiler didn't know which one to use and was throwing an error until I added the suffix.","created_at":"2026-08-29T12:21:29Z","updated_at":"2026-08-29T12:30:19Z","html_url":"https://github.com/godotengine/godot/pull/122957#discussion_r3886574346","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/122957","_links":{"self":{"href":"https://api.github.com/repos/godotengine/godot/pulls/comments/3886574346"},"html":{"href":"https://github.com/godotengine/godot/pull/122957#discussion_r3886574346"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/122957"}},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/3886574346/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":null,"original_line":395,"side":"RIGHT","in_reply_to_id":3885971670,"author_association":"CONTRIBUTOR","original_position":5,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/3886600882","pull_request_review_id":5058084003,"id":3886600882,"node_id":"PRRC_kwDOAO6SJc7nqNKy","diff_hunk":"@@ -392,7 +392,7 @@ void GodotPhysicsServer2D::area_clear_shapes(RID p_area) {\n \tERR_FAIL_NULL(area);\n \n \twhile (area->get_shape_count()) {\n-\t\tarea->remove_shape(0);\n+\t\tarea->remove_shape(0u);","path":"modules/godot_physics_2d/godot_physics_server_2d.cpp","commit_id":"42fe8a2d2f0f0d2f91bfca06436f2bcae038836a","original_commit_id":"42fe8a2d2f0f0d2f91bfca06436f2bcae038836a","user":{"login":"lawnjelly","id":21999379,"node_id":"MDQ6VXNlcjIxOTk5Mzc5","avatar_url":"https://avatars.githubusercontent.com/u/21999379?v=4","gravatar_id":"","url":"https://api.github.com/users/lawnjelly","html_url":"https://github.com/lawnjelly","followers_url":"https://api.github.com/users/lawnjelly/followers","following_url":"https://api.github.com/users/lawnjelly/following{/other_user}","gists_url":"https://api.github.com/users/lawnjelly/gists{/gist_id}","starred_url":"https://api.github.com/users/lawnjelly/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/lawnjelly/subscriptions","organizations_url":"https://api.github.com/users/lawnjelly/orgs","repos_url":"https://api.github.com/users/lawnjelly/repos","events_url":"https://api.github.com/users/lawnjelly/events{/privacy}","received_events_url":"https://api.github.com/users/lawnjelly/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"Oo that sounds like a footgun worth closing properly, having two identical function names taking a pointer and integer is a code smell.\r\n\r\nI think if we are changing the function signature, we should be aiming to close this at the same time, if at all possible. (and also consider whether changing the signature is compat breaking in any third party code. maybe it's all internal, but worth checking)\r\n\r\nChanging the func names is safest but may not be possible for backward compat (although is this exposed to external code?).\r\n\r\nCan we do something like this:\r\n```\r\n#include <type_traits>\r\n\r\nvoid func(int x) {\r\n    // Handles func(0)\r\n}\r\n\r\n// restricted to true pointers\r\ntemplate <typename T>\r\ntypename std::enable_if<std::is_pointer<T>::value>::type\r\nfunc(T ptr) {\r\n    // Handles func(&my_int)\r\n}\r\n```\r\n\r\nWe can also do this afaik:\r\n```\r\nvoid func(int x) {\r\n}\r\n\r\nvoid func(int* ptr) {\r\n}\r\n\r\n// Bridge for nullptr to pass to the pointer version.\r\nvoid func(std::nullptr_t) {\r\n    func(static_cast<int*>(nullptr)); \r\n}\r\n```\r\nHowever there is still an ambiguity if any users call `func(NULL)` rather than `func(nullptr)`. Worth bearing in mind.\r\n","created_at":"2026-08-29T12:37:15Z","updated_at":"2026-08-29T13:08:27Z","html_url":"https://github.com/godotengine/godot/pull/122957#discussion_r3886600882","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/122957","_links":{"self":{"href":"https://api.github.com/repos/godotengine/godot/pulls/comments/3886600882"},"html":{"href":"https://github.com/godotengine/godot/pull/122957#discussion_r3886600882"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/122957"}},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/3886600882/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":null,"original_line":395,"side":"RIGHT","in_reply_to_id":3885971670,"author_association":"MEMBER","original_position":5,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/3886703359","pull_request_review_id":5058186270,"id":3886703359,"node_id":"PRRC_kwDOAO6SJc7nqmL_","diff_hunk":"@@ -392,7 +392,7 @@ void GodotPhysicsServer2D::area_clear_shapes(RID p_area) {\n \tERR_FAIL_NULL(area);\n \n \twhile (area->get_shape_count()) {\n-\t\tarea->remove_shape(0);\n+\t\tarea->remove_shape(0u);","path":"modules/godot_physics_2d/godot_physics_server_2d.cpp","commit_id":"42fe8a2d2f0f0d2f91bfca06436f2bcae038836a","original_commit_id":"42fe8a2d2f0f0d2f91bfca06436f2bcae038836a","user":{"login":"DeeJayLSP","id":60024671,"node_id":"MDQ6VXNlcjYwMDI0Njcx","avatar_url":"https://avatars.githubusercontent.com/u/60024671?v=4","gravatar_id":"","url":"https://api.github.com/users/DeeJayLSP","html_url":"https://github.com/DeeJayLSP","followers_url":"https://api.github.com/users/DeeJayLSP/followers","following_url":"https://api.github.com/users/DeeJayLSP/following{/other_user}","gists_url":"https://api.github.com/users/DeeJayLSP/gists{/gist_id}","starred_url":"https://api.github.com/users/DeeJayLSP/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/DeeJayLSP/subscriptions","organizations_url":"https://api.github.com/users/DeeJayLSP/orgs","repos_url":"https://api.github.com/users/DeeJayLSP/repos","events_url":"https://api.github.com/users/DeeJayLSP/events{/privacy}","received_events_url":"https://api.github.com/users/DeeJayLSP/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"I've opted to rename the integer one to `remove_shape_by_index`. There were very few references anyway. And that won't demand explicit usage of unsigned suffixes. It would have possibly been breaking if the change was done in the pointer one.\r\n\r\nShould be noted the same pattern exists in `GodotPhysics3D`, but I'd like to limit the scope of this PR to 2D.","created_at":"2026-08-29T13:32:01Z","updated_at":"2026-08-29T13:48:49Z","html_url":"https://github.com/godotengine/godot/pull/122957#discussion_r3886703359","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/122957","_links":{"self":{"href":"https://api.github.com/repos/godotengine/godot/pulls/comments/3886703359"},"html":{"href":"https://github.com/godotengine/godot/pull/122957#discussion_r3886703359"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/122957"}},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/3886703359/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":null,"original_line":395,"side":"RIGHT","in_reply_to_id":3885971670,"author_association":"CONTRIBUTOR","original_position":5,"position":1,"subject_type":"line"}]