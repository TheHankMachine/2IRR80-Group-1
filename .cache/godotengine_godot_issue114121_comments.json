[{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3667356097","html_url":"https://github.com/godotengine/godot/issues/114121#issuecomment-3667356097","issue_url":"https://api.github.com/repos/godotengine/godot/issues/114121","id":3667356097,"node_id":"IC_kwDOAO6SJc7al2nB","user":{"login":"rsubtil","id":6501975,"node_id":"MDQ6VXNlcjY1MDE5NzU=","avatar_url":"https://avatars.githubusercontent.com/u/6501975?v=4","gravatar_id":"","url":"https://api.github.com/users/rsubtil","html_url":"https://github.com/rsubtil","followers_url":"https://api.github.com/users/rsubtil/followers","following_url":"https://api.github.com/users/rsubtil/following{/other_user}","gists_url":"https://api.github.com/users/rsubtil/gists{/gist_id}","starred_url":"https://api.github.com/users/rsubtil/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/rsubtil/subscriptions","organizations_url":"https://api.github.com/users/rsubtil/orgs","repos_url":"https://api.github.com/users/rsubtil/repos","events_url":"https://api.github.com/users/rsubtil/events{/privacy}","received_events_url":"https://api.github.com/users/rsubtil/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-12-17T21:53:42Z","updated_at":"2025-12-18T10:40:41Z","body":"You mention in the title that disabling Windows Defender/Firewall solves the issue, but then in the description you stated otherwise. Please confirm which of these scenarios is happening, as further analysis may depend on this detail.","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3667356097/reactions","total_count":2,"+1":2,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":{"reason":"outdated"}},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3669470390","html_url":"https://github.com/godotengine/godot/issues/114121#issuecom