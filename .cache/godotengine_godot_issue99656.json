ng right.\n\nThis PR aims to fix the unintended CPU time increase, while adding the improved frame limiting logic. Since sleep is based on hardware/OS, the method needs to be adaptive to both. On Windows, the sleep granularity is guaranteed, but on Unix we need to dynamically compute the upper bound to sleep.","closed_by":{"login":"mrsaturnsan","id":32889818,"node_id":"MDQ6VXNlcjMyODg5ODE4","avatar_url":"https://avatars.githubusercontent.com/u/32889818?v=4","gravatar_id":"","url":"https://api.github.com/users/mrsaturnsan","html_url":"https://github.com/mrsaturnsan","followers_url":"https://api.github.com/users/mrsaturnsan/followers","following_url":"https://api.github.com/users/mrsaturnsan/following{/other_user}","gists_url":"https://api.github.com/users/mrsaturnsan/gists{/gist_id}","starred_url":"https://api.github.com/users/mrsaturnsan/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/mrsaturnsan/subscriptions","organizations_url":"https://api.github.com/users/mrsaturnsan/orgs","repos_url":"https://api.github.com/users/mrsaturnsan/repos","events_url":"https://api.github.com/users/mrsaturnsan/events{/privacy}","received_events_url":"https://api.github.com/users/mrsaturnsan/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/99656/reactions","total_count":5,"+1":2,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":3,"eyes":0},"timeline_url":"https://api.github.com/repos/godotengine/godot/issues/99656/timeline","performed_via_github_app":null,"state_reason":null}