{"url":"https://api.github.com/repos/godotengine/godot/pulls/111772","id":2925649121,"node_id":"PR_kwDOAO6SJc6uYdzh","html_url":"https://github.com/godotengine/godot/pull/111772","diff_url":"https://github.com/godotengine/godot/pull/111772.diff","patch_url":"https://github.com/godotengine/godot/pull/111772.patch","issue_url":"https://api.github.com/repos/godotengine/godot/issues/111772","commits_url":"https://api.github.com/repos/godotengine/godot/pulls/111772/commits","review_comments_url":"https://api.github.com/repos/godotengine/godot/pulls/111772/comments","review_comment_url":"https://api.github.com/repos/godotengine/godot/pulls/comments{/number}","comments_url":"https://api.github.com/repos/godotengine/godot/issues/111772/comments","statuses_url":"https://api.github.com/repos/godotengine/godot/statuses/3fa73d4f5fc284e72a2fc4af3f2b1d9f8c502d23","number":111772,"state":"closed","locked":false,"title":"Fix buffer over-read in `FileAccessMemory::get_buffer`","user":{"login":"nikitalita","id":69168929,"node_id":"MDQ6VXNlcjY5MTY4OTI5","avatar_url":"https://avatars.githubusercontent.com/u/69168929?v=4","gravatar_id":"","url":"https://api.github.com/users/nikitalita","html_url":"https://github.com/nikitalita","followers_url":"https://api.github.com/users/nikitalita/followers","following_url":"https://api.github.com/users/nikitalita/following{/other_user}","gists_url":"https://api.github.com/users/nikitalita/gists{/gist_id}","starred_url":"https://api.github.com/users/nikitalita/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/nikitalita/subscriptions","organizations_url":"https://api.github.com/users/nikitalita/orgs","repos_url":"https://api.github.com/users/nikitalita/repos","events_url":"https://api.github.com/users/nikitalita/events{/privacy}","received_events_url":"https://api.github.com/users/nikitalita/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"The bounds check for FileAccessMemory::get_buffer is