github.com/users/zedzee37/gists{/gist_id}","starred_url":"https://api.github.com/users/zedzee37/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/zedzee37/subscriptions","organizations_url":"https://api.github.com/users/zedzee37/orgs","repos_url":"https://api.github.com/users/zedzee37/repos","events_url":"https://api.github.com/users/zedzee37/events{/privacy}","received_events_url":"https://api.github.com/users/zedzee37/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-12-21T00:15:25Z","updated_at":"2025-12-21T00:15:25Z","body":"I believe all issues are resolved now, sorry for all the issues lol","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3678232389/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4077822591","html_url":"https://github.com/godotengine/godot/pull/113156#issuecomment-4077822591","issue_url":"https://api.github.com/repos/godotengine/godot/issues/113156","id":4077822591,"node_id":"IC_kwDOAO6SJc7zDqJ_","user":{"login":"kevinlam508","id":14243263,"node_id":"MDQ6VXNlcjE0MjQzMjYz","avatar_url":"https://avatars.githubusercontent.com/u/14243263?v=4","gravatar_id":"","url":"https://api.github.com/users/kevinlam508","html_url":"https://github.com/kevinlam508","followers_url":"https://api.github.com/users/kevinlam508/followers","following_url":"https://api.github.com/users/kevinlam508/following{/other_user}","gists_url":"https://api.github.com/users/kevinlam508/gists{/gist_id}","starred_url":"https://api.github.com/users/kevinlam508/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/kevinlam508/subscriptions","organizations_url":"https://api.github.com/users/kevinlam508/orgs","repos_url":"https://api.github.com/users/kevinlam508/repos","events_url":"https://api.github.com/users/kevinlam508/events{/privacy}","received_events_url":"https://api.github.com/users/kevinlam508/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-03-17T20:30:50Z","updated_at":"2026-03-17T20:30:50Z","body":"It looks like the changes don't restore the node reference when the packed scene is instantiated. So before save, the array will have `Node`s, but after load the array will be of `NodePath`s. So while the inspector will no longer show `<empty>` entries, the collection does not maintain types in script.\r\n\r\nI think the type recovery on load is why using direct node references is only allowed with property hints that create typed collections. An untyped collection could have a mix of Node and NodePath values. So converting Node -> NodePath for saving means there's not enough information to know which values to convert NodePath -> Node on load.\r\n\r\nSo to properly export nested collections of Nodes, there does need to be recursive traversal like the core idea of the changes, but using the type restricted collection code blocks just above the additions in `_parse_node`. It would also be nice if there was an error message when trying to export Node collections without a type restricted property hint to say it only works with the correct property hint, but that's a different problem.","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4077822591/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4080018003","html_url":"https://github.com/godotengine/godot/pull/113156#issuecomment-4080018003","issue_url":"https://api.github.com/repos/godotengine/godot/issues/113156","id":4080018003,"node_id":"IC_kwDOAO6SJc7zMCJT","user":{"login":"zedzee37","id":65473813,"node_id":"MDQ6VXNlcjY1NDczODEz","avatar_url":"https://avatars.githubusercontent.com/u/65473813?v=4","gravatar_id":"","url":"https://api.github.com/users/zedzee37","html_url":"https://github.com/zedzee37","followers_url":"https://api.github.com/users/zedzee37/followers","following_url":"https://api.github.com/users/zedzee37/following{/other_user}","gists_url":"https://api.github.com/users/zedzee37/gists{/gist_id}","starred_url":"https://api.github.com/users/zedzee37/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/zedzee37/subscriptions","organizations_url":"https://api.github.com/users/zedzee37/orgs","repos_url":"https://api.github.com/users/zedzee37/repos","events_url":"https://api.github.com/users/zedzee37/events{/privacy}","received_events_url":"https://api.github.com/users/zedzee37/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-03-18T06:12:49Z","updated_at":"2026-03-18T06:12:49Z","body":"Hi, thanks for pointing out my oversight, though would it not be possible to attach some flag to the exported `NodePath`s that would signify that it should be converted back to a `Node`?","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4080018003/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4084647845","html_url":"https://github.com/godotengine/godot/pull/113156#issuecomment-4084647845","issue_url":"https://api.github.com/repos/godotengine/godot/issues/113156","id":4084647845,"node_id":"IC_kwDOAO6SJc7zdsel","user":{"login":"kevinlam508","id":14243263,"node_id":"MDQ6VXNlcjE0MjQzMjYz","avatar_url":"https://avatars.githubusercontent.com/u/14243263?v=4","gravatar_id":"","url":"https://api.github.com/users/kevinlam508","html_url":"https://github.com/kevinlam508","followers_url":"https://api.github.com/users/kevinlam508/followers","following_url":"https://api.github.com/users/kevinlam508/following{/other_user}","gists_url":"https://api.github.com/users/kevinlam508/gists{/gist_id}","starred_url":"https://api.github.com/users/kevinlam508/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/kevinlam508/subscriptions","organizations_url":"https://api.github.com/users/kevinlam508/orgs","repos_url":"https://api.github.com/users/kevinlam508/repos","events_url":"https://api.github.com/users/kevinlam508/events{/privacy}","received_events_url":"https://api.github.com/users/kevinlam508/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-03-18T18:15:53Z","updated_at":"2026-03-18T18:15:53Z","body":"I think it'd be great if that were possible because it would remove the requirement of only working with typed collections. I don't know enough on how feasible that is. \r\nI've only worked within `PackedScene` so I know that the existing flagging is per property, not variant value (see usages of `FLAG_PATH_PROPERTY_IS_NODE`). So I think actual conversion of the `NodePath` into the file is using the general variant to string conversions. Which means that per variant flagging can't be isolated to be within `PackedScene`. It'd have to be data in `NodePath` that's useless outside `PackedScene`.\r\n\r\nI may be wrong. This is a rough guess since I'm pretty new with the architecture of the engine.","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4084647845/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4084771587","html_url":"https://github.com/godotengine/godot/pull/113156#issuecomment-4084771587","issue_url":"h