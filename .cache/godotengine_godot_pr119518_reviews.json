s_url":"https://api.github.com/users/NoNormalDev/orgs","repos_url":"https://api.github.com/users/NoNormalDev/repos","events_url":"https://api.github.com/users/NoNormalDev/events{/privacy}","received_events_url":"https://api.github.com/users/NoNormalDev/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"","state":"COMMENTED","html_url":"https://github.com/godotengine/godot/pull/119518#pullrequestreview-4310345010","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/119518","author_association":"CONTRIBUTOR","_links":{"html":{"href":"https://github.com/godotengine/godot/pull/119518#pullrequestreview-4310345010"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/119518"}},"submitted_at":"2026-05-18T12:59:45Z","commit_id":"5b8616d32a19f4bdf2edf435dc95283fecba4868"},{"id":4353235342,"node_id":"PRR_kwDOAO6SJc8AAAABA3kZjg","user":{"login":"Mickeon","id":66727710,"node_id":"MDQ6VXNlcjY2NzI3NzEw","avatar_url":"https://avatars.githubusercontent.com/u/66727710?u=8069d9b7bc6ab503ce83dfcfa53fd021672aeccf&v=4","gravatar_id":"","url":"https://api.github.com/users/Mickeon","html_url":"https://github.com/Mickeon","followers_url":"https://api.github.com/users/Mickeon/followers","following_url":"https://api.github.com/users/Mickeon/following{/other_user}","gists_url":"https://api.github.com/users/Mickeon/gists{/gist_id}","starred_url":"https://api.github.com/users/Mickeon/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Mickeon/subscriptions","organizations_url":"https://api.github.com/users/Mickeon/orgs","repos_url":"https://api.github.com/users/Mickeon/repos","events_url":"https://api.github.com/users/Mickeon/events{/privacy}","received_events_url":"https://api.github.com/users/Mickeon/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"I'm not confident about this note. As I highlighted in https://github.com/godotengine/godot/issues/119322#issuecomment-4529538389 , the issue this aims to mitigate is so niche, and yet the note is longer than the rest of the method's description.\r\n\r\nI am afraid the note may be more confusing to read than it's worth, too. There's no way anyone would be able to guess that they're being affected by this quirk (\"within the same microsecond\", keep in mind), nor an explanation as to why the conflict may be undesirable, which is probably the more important part.\r\nNot that it can happen, rather why the user should be concerned by it.\r\n\r\nAlso, to be quite pedantic, the original issue also occurs when RandomNumberGenerator is instantiated. Adding the note in `randomize()` doesn't tell the whole story. It probably should be added below the class's description, if anything.","state":"COMMENTED","html_url":"https://github.com/godotengine/godot/pull/119518#pullrequestreview-4353235342","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/119518","author_association":"MEMBER","_links":{"html":{"href":"https://github.com/godotengine/godot/pull/119518#pullrequestreview-4353235342"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/119518"}},"submitted_at":"2026-05-24T18:21:26Z","commit_id":"5c4834f580cf2b401352b6ba5d888fa07eb72137"}]