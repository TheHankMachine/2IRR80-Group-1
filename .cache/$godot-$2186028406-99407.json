[{"id":2443842287,"node_id":"PRR_kwDOAO6SJc6RqhLv","state":"APPROVED","user":{"site_admin":false,"suspended":false,"updated_at":"0001-01-01T00:00:00Z","avatar_url":"https://avatars.githubusercontent.com/u/191561?v=4","created_at":"0001-01-01T00:00:00Z","followers":0,"following":0,"html_url":"https://github.com/dsnopek","id":191561,"node_id":"MDQ6VXNlcjE5MTU2MQ==","login":"dsnopek","type":"User","owned_private_repos":0,"public_gists":0,"public_repos":0,"total_private_repos":0,"url":"https://api.github.com/users/dsnopek"},"body":"Thanks!\r\n\r\nI tested this together with PR https://github.com/GodotVR/godot_openxr_vendors/pull/226, and it appears to be working great! (I have notes about the performance gains I'm seeing, but that's more related to the `META_recommended_layer_resolution` extension, so I'll write about it on the other PR.)\r\n\r\nThe code looks good to me as well.","html_url":"https://github.com/godotengine/godot/pull/99407#pullrequestreview-2443842287","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/99407","author_association":"CONTRIBUTOR","submitted_at":"2024-11-18T22:14:23Z"},{"id":2443913500,"node_id":"PRR_kwDOAO6SJc6Rqykc","state":"COMMENTED","user":{"site_admin":false,"suspended":false,"updated_at":"0001-01-01T00:00:00Z","avatar_url":"https://avatars.githubusercontent.com/u/66727710?u=8069d9b7bc6ab503ce83dfcfa53fd021672aeccf&v=4","created_at":"0001-01-01T00:00:00Z","followers":0,"following":0,"html_url":"https://github.com/Mickeon","id":66727710,"node_id":"MDQ6VXNlcjY2NzI3NzEw","login":"Mickeon","type":"User","owned_private_repos":0,"public_gists":0,"public_repos":0,"total_private_repos":0,"url":"https://api.github.com/users/Mickeon"},"body":"","html_url":"https://github.com/godotengine/godot/pull/99407#pullrequestreview-2443913500","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/99407","author_association":"MEMBER","submitted_at":"2024-11-18T22:52:43Z"},{"id":2443877163,"node_id":"PRR_kwDOAO6SJc6Rqpsr","state":"COMMENTED","user":{"site_admin":false,"suspended":false,"updated_at":"0001-01-01T00:00:00Z","avatar_url":"https://avatars.githubusercontent.com/u/96648715?u=af70f5d107e9c1447f296643d5a566dab53d25e8&v=4","created_at":"0001-01-01T00:00:00Z","followers":0,"following":0,"html_url":"https://github.com/AThousandShips","id":96648715,"node_id":"U_kgDOBcK-Cw","login":"AThousandShips","type":"User","owned_private_repos":0,"public_gists":0,"public_repos":0,"total_private_repos":0,"url":"https://api.github.com/users/AThousandShips"},"body":"","html_url":"https://github.com/godotengine/godot/pull/99407#pullrequestreview-2443877163","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/99407","author_association":"MEMBER","submitted_at":"2024-11-19T10:15:23Z"},{"id":2445686370,"node_id":"PRR_kwDOAO6SJc6RxjZi","state":"APPROVED","user":{"site_admin":false,"suspended":false,"updated_at":"0001-01-01T00:00:00Z","avatar_url":"https://avatars.githubusercontent.com/u/914968?u=5f2b0cb28e37393252e96695f2eaa33494930285&v=4","created_at":"0001-01-01T00:00:00Z","followers":0,"following":0,"html_url":"https://github.com/m4gr3d","id":914968,"node_id":"MDQ6VXNlcjkxNDk2OA==","login":"m4gr3d","type":"User","owned_private_repos":0,"public_gists":0,"public_repos":0,"total_private_repos":0,"url":"https://api.github.com/users/m4gr3d"},"body":"Looks good!\r\n\r\nAdded some minor comments to address.","html_url":"https://github.com/godotengine/godot/pull/99407#pullrequestreview-2445686370","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/99407","author_association":"CONTRIBUTOR","submitted_at":"2024-11-19T14:48:20Z"},{"id":2446477653,"node_id":"PRR_kwDOAO6SJc6R0klV","state":"COMMENTED","user":{"site_admin":false,"suspended":false,"updated_at":"0001-01-01T00:00:00Z","avatar_url":"https://avatars.githubusercontent.com/u/95497005?u=adfee76e7d1bd361d1802deb354ae2aab3007582&v=4","created_at":"0001-01-01T00:00:00Z","followers":0,"following":0,"html_url":"https://github.com/devloglogan","id":95497005,"node_id":"U_kgDOBbErLQ","login":"devloglogan","type":"User","owned_private_repos":0,"public_gists":0,"public_repos":0,"total_private_repos":0,"url":"https://api.github.com/users/devloglogan"},"body":"","html_url":"https://github.com/godotengine/godot/pull/99407#pullrequestreview-2446477653","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/99407","author_association":"CONTRIBUTOR","submitted_at":"2024-11-19T19:28:20Z"},{"id":2446601122,"node_id":"PRR_kwDOAO6SJc6R1Cui","state":"COMMENTED","user":{"site_admin":false,"suspended":false,"updated_at":"0001-01-01T00:00:00Z","avatar_url":"https://avatars.githubusercontent.com/u/66727710?u=8069d9b7bc6ab503ce83dfcfa53fd021672aeccf&v=4","created_at":"0001-01-01T00:00:00Z","followers":0,"following":0,"html_url":"https://github.com/Mickeon","id":66727710,"node_id":"MDQ6VXNlcjY2NzI3NzEw","login":"Mickeon","type":"User","owned_private_repos":0,"public_gists":0,"public_repos":0,"total_private_repos":0,"url":"https://api.github.com/users/Mickeon"},"body":"Docs a-okay now, assuming accuracy.","html_url":"https://github.com/godotengine/godot/pull/99407#pullrequestreview-2446601122","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/99407","author_association":"MEMBER","submitted_at":"2024-11-19T20:35:28Z"},{"id":2466108025,"node_id":"PRR_kwDOAO6SJc6S_dJ5","state":"COMMENTED","user":{"site_admin":false,"suspended":false,"updated_at":"0001-01-01T00:00:00Z","avatar_url":"https://avatars.githubusercontent.com/u/1945449?u=96b5dc9be2859dca5f31314c87d99a68a21e1576&v=4","created_at":"0001-01-01T00:00:00Z","followers":0,"following":0,"html_url":"https://github.com/BastiaanOlij","id":1945449,"node_id":"MDQ6VXNlcjE5NDU0NDk=","login":"BastiaanOlij","type":"User","owned_private_repos":0,"public_gists":0,"public_repos":0,"total_private_repos":0,"url":"https://api.github.com/users/BastiaanOlij"},"body":"Looks really cool as far as functionality goes, it'll be interesting to see if we can create our own logic for altering the render region even outside of this extension. `XrSwapchainSubImage.imageRect` is available in the core.\r\nSimilarly I wonder if making the render region core viewport functionality instead of an override makes sense. The use cases here extend beyond XR, being able to dynamically effect the render resolution without recreating all buffers could be useful.\r\n\r\nCouple of things that stand out that need to be discussed further:\r\n1. Dealing with the pesky `render_target_size_multiplier` feature we added to OpenXR, we talked about this I think in the XR meeting already, but if this is set to anything other than its default 1.0, especially if its set smaller, it could cause havoc when combined with this. \r\n2. The implementation of `render_region` on the OpenXR side, is not thread safe. When rendering happens on a separate thread you've created a possibility for the render region to be set for a new frame, while a frame is being rendered, with the possibility that render result and render region don't match. You have to take the same approach as a number of other properties have, where you have a copy in `render_state` that is set through calling `call_on_render_thread`. See `set_render_target_size_multiplier` and `set_render_state_multiplier` as an example.\r\n3. I'm not sure I like us exposing the projection layer. Here too there is a high risk of thread issues and it will be easy to break things. Especially when future work will require modifications that will clash with what is done in an extension. We spoke about this before and that we probably don't have any other choice, but I'd like to know more of the reasoning behind this and it would be good to have this properly documented. If we can find a cleaner way to expose the required functionality that would have my preference, but without knowing more I can't think of good suggestions.\r\n4. What is the impact on other features? Does the VRS map need to be calculated based on the render_region, how are build in effects effected especially when this functionality is adopted on PCVR with the Forward+ renderer. Etc.","html_url":"https://github.com/godotengine/godot/pull/99407#pullrequestreview-2466108025","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/99407","author_association":"CONTRIBUTOR","submitted_at":"2024-11-28T00:06:52Z"},{"id":2467302266,"node_id":"PRR_kwDOAO6SJc6TEAt6","state":"APPROVED","user":{"site_admin":false,"suspended":false,"updated_at":"0001-01-01T00:00:00Z","avatar_url":"https://avatars.githubusercontent.com/u/96648715?u=af70f5d107e9c1447f296643d5a566dab53d25e8&v=4","created_at":"0001-01-01T00:00:00Z","followers":0,"following":0,"html_url":"https://github.com/AThousandShips","id":96648715,"node_id":"U_kgDOBcK-Cw","login":"AThousandShips","type":"User","owned_private_repos":0,"public_gists":0,"public_repos":0,"total_private_repos":0,"url":"https://api.github.com/users/AThousandShips"},"body":"","html_url":"https://github.com/godotengine/godot/pull/99407#pullrequestreview-2467302266","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/99407","author_association":"MEMBER","submitted_at":"2024-11-28T09:19:32Z"},{"id":2502931930,"node_id":"PRR_kwDOAO6SJc6VL7Xa","state":"COMMENTED","user":{"site_admin":false,"suspended":false,"updated_at":"0001-01-01T00:00:00Z","avatar_url":"https://avatars.githubusercontent.com/u/16521339?u=e44a465cbebabb9ea2be80b59e6dc07966bef5b7&v=4","created_at":"0001-01-01T00:00:00Z","followers":0,"following":0,"html_url":"https://github.com/clayjohn","id":16521339,"node_id":"MDQ6VXNlcjE2NTIxMzM5","login":"clayjohn","type":"User","owned_private_repos":0,"public_gists":0,"public_repos":0,"total_private_repos":0,"url":"https://api.github.com/users/clayjohn"},"body":"I think we need to clean up the API here a bit. This feature is implemented with 3 assumptions that I think are all incorrect:\r\n1. We are always using an overridden render target (alternatively stated \"we are always using XR\")\r\n2. The render target is always the same size as the render buffers\r\n3. We are always using dynamic scaling\r\n\r\nBuilding on Bastiaan's comments above. This API needs to consider dynamic scaling on non-XR devices and expose an API that can be accessed from rather than building in an API that can _only_ be used from XR","html_url":"https://github.com/godotengine/godot/pull/99407#pullrequestreview-2502931930","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/99407","author_association":"MEMBER","submitted_at":"2024-12-13T18:57:59Z"},{"id":2509705231,"node_id":"PRR_kwDOAO6SJc6VlxAP","state":"COMMENTED","user":{"site_admin":false,"suspended":false,"updated_at":"0001-01-01T00:00:00Z","avatar_url":"https://avatars.githubusercontent.com/u/95497005?u=adfee76e7d1bd361d1802deb354ae2aab3007582&v=4","created_at":"0001-01-01T00:00:00Z","followers":0,"following":0,"html_url":"https://github.com/devloglogan","id":95497005,"node_id":"U_kgDOBbErLQ","login":"devloglogan","type":"User","owned_private_repos":0,"public_gists":0,"public_repos":0,"total_private_repos":0,"url":"https://api.github.com/users/devloglogan"},"body":"","html_url":"https://github.com/godotengine/godot/pull/99407#pullrequestreview-2509705231","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/99407","author_association":"CONTRIBUTOR","submitted_at":"2024-12-17T18:14:03Z"},{"id":2513258223,"node_id":"PRR_kwDOAO6SJc6VzUbv","state":"COMMENTED","user":{"site_admin":false,"suspended":false,"updated_at":"0001-01-01T00:00:00Z","avatar_url":"https://avatars.githubusercontent.com/u/16521339?u=e44a465cbebabb9ea2be80b59e6dc07966bef5b7&v=4","created_at":"0001-01-01T00:00:00Z","followers":0,"following":0,"html_url":"https://github.com/clayjohn","id":16521339,"node_id":"MDQ6VXNlcjE2NTIxMzM5","login":"clayjohn","type":"User","owned_private_repos":0,"public_gists":0,"public_repos":0,"total_private_repos":0,"url":"https://api.github.com/users/clayjohn"},"body":"Discussed in the rendering meeting. We discussed that the render region should be stored in the RenderData struct. \r\n\r\nYou can store it here: https://github.com/godotengine/godot/blob/fafc07335bdecacd96b548c4119fbe1f47ee5866/servers/rendering/renderer_rd/renderer_scene_render_rd.cpp#L1221C31-L1221C105\r\n\r\nThen, throughout rendering we can apply the region consistently by accessing render data\r\n\r\nAlso noticed that the transparent pass is missing the render region in the mobile renderer, so it needs to be used there. \r\n","html_url":"https://github.com/godotengine/godot/pull/99407#pullrequestreview-2513258223","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/99407","author_association":"MEMBER","submitted_at":"2024-12-19T03:52:46Z"},{"id":2541112488,"node_id":"PRR_kwDOAO6SJc6Xdkyo","state":"APPROVED","commit_id":"e7f6b7ea0b9ff83e1b152f127d68fd905f503b4b","user":{"site_admin":false,"suspended":false,"updated_at":"0001-01-01T00:00:00Z","avatar_url":"https://avatars.githubusercontent.com/u/1945449?u=96b5dc9be2859dca5f31314c87d99a68a21e1576&v=4","created_at":"0001-01-01T00:00:00Z","followers":0,"following":0,"html_url":"https://github.com/BastiaanOlij","id":1945449,"node_id":"MDQ6VXNlcjE5NDU0NDk=","login":"BastiaanOlij","type":"User","owned_private_repos":0,"public_gists":0,"public_repos":0,"total_private_repos":0,"url":"https://api.github.com/users/BastiaanOlij"},"body":"Great work!","html_url":"https://github.com/godotengine/godot/pull/99407#pullrequestreview-2541112488","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/99407","author_association":"CONTRIBUTOR","submitted_at":"2025-01-09T22:59:54Z"}]