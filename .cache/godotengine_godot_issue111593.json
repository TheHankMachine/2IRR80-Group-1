 float = 100 :\n\tset(v):\n\t\tradius = v\n\t\tqueue_redraw()\n@export var center: Vector2 = Vector2.ZERO :\n\tset(v):\n\t\tcenter = v\n\t\tqueue_redraw()\n@export_range(0, 1, 0.01) var thickness: float = 1 :\n\tset(v):\n\t\tthickness = v\n\t\tqueue_redraw()\n\n\nfunc _ready() -> void:\n\tqueue_redraw()\n\nfunc _draw() -> void:\n\tdraw_arc(center, radius * 0.5, 1, 2, 24, Color(Color.RED, 0.3), radius * thickness, false)\n\tdraw_arc(center, radius * 0.5, 2, 3, 24, Color(Color.BLUE, 0.3), radius * thickness, false)\n```\n\n</details>\n\n### Minimal reproduction project (MRP)\n\nMRP: [bug_draw_arc.zip](https://github.com/user-attachments/files/22886813/bug_draw_arc.zip)","closed_by":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/111593/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/godotengine/godot/issues/111593/timeline","performed_via_github_app":null,"state_reason":null,"pinned_comment":null}