b.com/users/GlitchedCode922/following{/other_user}","gists_url":"https://api.github.com/users/GlitchedCode922/gists{/gist_id}","starred_url":"https://api.github.com/users/GlitchedCode922/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/GlitchedCode922/subscriptions","organizations_url":"https://api.github.com/users/GlitchedCode922/orgs","repos_url":"https://api.github.com/users/GlitchedCode922/repos","events_url":"https://api.github.com/users/GlitchedCode922/events{/privacy}","received_events_url":"https://api.github.com/users/GlitchedCode922/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-02-13T15:02:28Z","updated_at":"2025-02-13T15:02:28Z","body":"No, it isn't reproducible in 4.3 stable.","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2656877889/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2656882192","html_url":"https://github.com/godotengine/godot/issues/102809#issuecomment-2656882192","issue_url":"https://api.github.com/repos/godotengine/godot/issues/102809","id":2656882192,"node_id":"IC_kwDOAO6SJc6eXM4Q","user":{"login":"GlitchedCode922","id":126592994,"node_id":"U_kgDOB4un4g","avatar_url":"https://avatars.githubusercontent.com/u/126592994?v=4","gravatar_id":"","url":"https://api.github.com/users/GlitchedCode922","html_url":"https://github.com/GlitchedCode922","followers_url":"https://api.github.com/users/GlitchedCode922/followers","following_url":"https://api.github.com/users/GlitchedCode922/following{/other_user}","gists_url":"https://api.github.com/users/GlitchedCode922/gists{/gist_id}","starred_url":"https://api.github.com/users/GlitchedCode922/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/GlitchedCode922/subscriptions","organizations_url":"https://api.github.com/users/GlitchedCode922/orgs","repos_url":"https://api.github.com/users/GlitchedCode922/repos","events_url":"https://api.github.com/users/GlitchedCode922/events{/privacy}","received_events_url":"https://api.github.com/users/GlitchedCode922/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-02-13T15:03:46Z","updated_at":"2025-02-13T15:04:56Z","body":"Also, the bug isn't device specific (I tested it on an Android 9 VM, using 4.3 and 4.4.beta3. It reproduced on 4.4.beta3 in the VM **and** my real device).","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2656882192/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2657037156","html_url":"https://github.com/godotengine/godot/issues/102809#issuecomment-2657037156","issue_url":"https://api.github.com/repos/godotengine/godot/issues/102809","id":2657037156,"node_id":"IC_kwDOAO6SJc6eXytk","user":{"login":"Maran23","id":66004280,"node_id":"MDQ6VXNlcjY2MDA0Mjgw","avatar_url":"https://avatars.githubusercontent.com/u/66004280?v=4","gravatar_id":"","url":"https://api.github.com/users/Maran23","html_url":"https://github.com/Maran23","followers_url":"https://api.github.com/users/Maran23/followers","following_url":"https://api.github.com/users/Maran23/following{/other_user}","gists_url":"https://api.github.com/users/Maran23/gists{/gist_id}","starred_url":"https://api.github.com/users/Maran23/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Maran23/subscriptions","organizations_url":"https://api.github.com/users/Maran23/orgs","repos_url":"https://api.github.com/users/Maran23/repos","events_url":"https://api.github.com/users/Maran23/events{/privacy}","received_events_url":"https://api.github.com/users/Maran23/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-02-13T15:54:30Z","updated_at":"2025-02-13T15:58:35Z","body":"Can reproduce on Windows 11, looks like this regressed somewhere between Godot 4.3 and Godot 4.4.dev2. \n\nBefore, we never got any other suggestions in `preload(..)`, other than all the possible path. \nNow, if there is no match, we get all possible Godot suggestions, e.g. like `Regex` and other classes.\n\nEDIT: Or if you close auto completion and just start typing `Re` and then trigger the auto completion, you get again Godot classes.\n\nhttps://github.com/user-attachments/assets/7522472e-642e-4c96-a8fe-a35e04bfe6c2","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2657037156/reactions","total_count":2,"+1":2,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2657249403","html_url":"https://github.com/godotengine/godot/issues/102809#issuecomment-2657249403","issue_url":"https://api.github.com/repos/godotengine/godot/issues/102809","id":2657249403,"node_id":"IC_kwDOAO6SJc6eYmh7","user":{"login":"akien-mga","id":4701338,"node_id":"MDQ6VXNlcjQ3MDEzMzg=","avatar_url":"https://avatars.githubusercontent.com/u/4701338?v=4","gravatar_id":"","url":"https://api.github.com/users/akien-mga","html_url":"https://github.com/akien-mga","followers_url":"https://api.github.com/users/akien-mga/followers","following_url":"https://api.github.com/users/akien-mga/following{/other_user}","gists_url":"https://api.github.com/users/akien-mga/gists{/gist_id}","starred_url":"https://api.github.com/users/akien-mga/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/akien-mga/subscriptions","organizations_url":"https://api.github.com/users/akien-mga/orgs","repos_url":"https://api.github.com/users/akien-mga/repos","events_url":"https://api.github.com/users/akien-mga/events{/privacy}","received_events_url":"https://api.github.com/users/akien-mga/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-02-13T17:12:07Z","updated_at":"2025-02-13T17:12:07Z","body":"I can confirm the findings from @Maran23, the bug is first reproducible in 4.4.dev2.\n4.4.dev1 has a different bug: `preload` has no completion at all.\nIn 4.3.stable it only offers resource paths for completion.\n\nCC @HolonProduction - I assume it might be from one of your PRs in 4.4.dev1 or dev2.","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2657249403/reactions","total_count":2,"+1":2,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2657731891","html_url":"https://github.com/godotengine/godot/issues/102809#issuecomment-2657731891","issue_url":"https://api.github.com/repos/godotengine/godot/issues/102809","id":2657731891,"node_id":"IC_kwDOAO6SJc6eacUz","user":{"login":"HolonProduction","id":99511741,"node_id":"U_kgDOBe5tvQ","avatar_url":"https://avatars.githubusercontent.com/u/99511741?v=4","gravatar_id":"","url":"https://api.github.com/users/HolonProduction","html_url":"https://github.com/HolonProduction","followers_url":"https://api.github.com/users/HolonProduction/followers","following_url":"https://api.github.com/users/HolonProduction/following{/other_user}","gists_url":"https://api.github.com/users/HolonProduction/gists{/gist_id}","starred_url":"https://api.github.com/users/HolonProduction/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/HolonProduction/subscriptions","organizations_url":"https://api.github.com/users/HolonProduction/orgs","repos_url":"https://api.github.com/users/HolonProduction/repos","events_url":"https://api.github.com/users/HolonProduction/events{/privacy}","received_events_url":"https://api.github.com/users/HolonProduction/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-02-13T21:18:59Z","updated_at":"2025-02-13T21:18:59Z","body":"Seems that preloads are a separate path in the parser, that I didn't update for the argument option change in #94082.\n\nThat being said there is so much stuff in here so let's split this up:\n- for something to fall into GDScript tooling territory, the issue must be reproducible by triggering autocompletion on finished code at some position using the shortcut (ctrl + space by default). Otherwise it is an GDScript independent issue with `CodeEdit`/`ScriptEdtior` updating logic (and yes there are some issues with that, they mostly stem from tight coupling between `CodeEdit` and GDScript logic. This tends to not play nice with changes on the GDScript side. I have no real clue how to fix this part of the issue it's gui territory. I feel like completion should just be updated with every keystroke, like literally every other editor does, but that's an unqualified opinion.)\n\nKnowing this let's look at what happens when using the shortcut:\n- preload(\"res\") doesn't give autocompletion -> this is a regression from #94082\n- preload(res) gives identifier autocompletion -> this is a nonissue for me:\n   - I intentionally removed the support for doing argument option completion without quotes in #94082, since it is not possible to support in an unintrusive way (e.g. no autocompletion when trying to pass variables to `load`). It was very convenient for api's like `connect` in 3.x, but since those are not used anymore, I don't think it brings enough convenience to outweigh the inconvenience when trying to pass dynamic parameters to argument option functions.\n\n> Also, for both `preload()` and `load()`, if it is not in a variable, autocomplete doesn't show at all.\n\nCan't reproduce\n\n![Image](https://github.com/user-attachments/assets/52ba8992-f8d3-48eb-a8f0-49a338d4e01d)\n\n> Before, we never got any other suggestions in `preload(..)`, other than all the possible path.\n> Now, if there is no match, we get all possible Godot suggestions, e.g. like `Regex` and other classes.\n\nThe intended method to use argument options is with quotes. The old behavior makes autocompletion useless with complex use cases like:\n\n![Image](https://github.com/user-attachments/assets/2197f6bb-1569-4cda-a57b-c40add0d85e7)\n","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2657731891/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null}]