[{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2504899216","html_url":"https://github.com/godotengine/godot/issues/99772#issuecomment-2504899216","issue_url":"https://api.github.com/repos/godotengine/godot/issues/99772","id":2504899216,"node_id":"IC_kwDOAO6SJc6VTbqQ","user":{"login":"tetrapod00","id":145553014,"node_id":"U_kgDOCKz2dg","avatar_url":"https://avatars.githubusercontent.com/u/145553014?v=4","gravatar_id":"","url":"https://api.github.com/users/tetrapod00","html_url":"https://github.com/tetrapod00","followers_url":"https://api.github.com/users/tetrapod00/followers","following_url":"https://api.github.com/users/tetrapod00/following{/other_user}","gists_url":"https://api.github.com/users/tetrapod00/gists{/gist_id}","starred_url":"https://api.github.com/users/tetrapod00/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/tetrapod00/subscriptions","organizations_url":"https://api.github.com/users/tetrapod00/orgs","repos_url":"https://api.github.com/users/tetrapod00/repos","events_url":"https://api.github.com/users/tetrapod00/events{/privacy}","received_events_url":"https://api.github.com/users/tetrapod00/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2024-11-27T22:25:34Z","updated_at":"2024-11-27T22:25:34Z","body":"This very well might be a bug, but in the meantime you can use the pin (📌) icon to keep one of the bottom panel tabs open. It was recently added in https://github.com/godotengine/godot/pull/98074.\nIf the bottom panel tabs are switching even when pinned open, this is *definitely* a bug.","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2504899216/reactions","total_count":1,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":1},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2505242659","html_url":"https://github.com/godotengine/godot/issues/99772#issuecomment-2505242659","issue_url":"https://api.github.com/repos/godotengine/godot/issues/99772","id":2505242659,"node_id":"IC_kwDOAO6SJc6VUvgj","user":{"login":"tetrapod00","id":145553014,"node_id":"U_kgDOCKz2dg","avatar_url":"https://avatars.githubusercontent.com/u/145553014?v=4","gravatar_id":"","url":"https://api.github.com/users/tetrapod00","html_url":"https://github.com/tetrapod00","followers_url":"https://api.github.com/users/tetrapod00/followers","following_url":"https://api.github.com/users/tetrapod00/following{/other_user}","gists_url":"https://api.github.com/users/tetrapod00/gists{/gist_id}","starred_url":"https://api.github.com/users/tetrapod00/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/tetrapod00/subscriptions","organizations_url":"https://api.github.com/users/tetrapod00/orgs","repos_url":"https://api.github.com/users/tetrapod00/repos","events_url":"https://api.github.com/users/tetrapod00/events{/privacy}","received_events_url":"https://api.github.com/users/tetrapod00/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2024-11-28T04:31:35Z","updated_at":"2024-11-28T04:34:01Z","body":"I can't reproduce the behavior shown in your video, with the uploaded MRP, in Godot 4.4.dev5, on Windows 10. I tried restarting the project before attempting to replicate the steps in your video:\n- Open shader.\n- Select AnimationPlayer node.\n- In AnimationPlayer, select a frame.\n- Click on Sprite2D (in the Animation bottom panel).\n\nThen I tried restarting again, repeating the steps, and still can't replicate.\n\nThere might be other editor or project settings involved in the behavior you saw. Or perhaps the editor bug is only triggered by a specific state that was only reached in your project, but not the MRP. Can you check again to see if you can replicate the behavior with only the MRP you uploaded, and if so, record a video of the steps?\n\nAlso, if you can reproduce the bug in 4.4dev5, can you also check the MRP in 4.3 and see if the bug is still there?\n\nThanks for reporting and thanks in advance for testing further.","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2505242659/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2506023097","html_url":"https://github.com/godotengine/godot/issues/99772#issuecomment-2506023097","issue_url":"https://api.github.com/repos/godotengine/godot/issues/99772","id":2506023097,"node_id":"IC_kwDOAO6SJc6VXuC5","user":{"login":"matheusmdx","id":44306054,"node_id":"MDQ6VXNlcjQ0MzA2MDU0","avatar_url":"https://avatars.githubusercontent.com/u/44306054?v=4","gravatar_id":"","url":"https://api.github.com/users/matheusmdx","html_url":"https://github.com/matheusmdx","followers_url":"https://api.github.com/users/matheusmdx/followers","following_url":"https://api.github.com/users/matheusmdx/following{/other_user}","gists_url":"https://api.github.com/users/matheusmdx/gists{/gist_id}","starred_url":"https://api.github.com/users/matheusmdx/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/matheusmdx/subscriptions","organizations_url":"https://api.github.com/users/matheusmdx/orgs","repos_url":"https://api.github.com/users/matheusmdx/repos","events_url":"https://api.github.com/users/matheusmdx/events{/privacy}","received_events_url":"https://api.github.com/users/matheusmdx/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2024-11-28T12:37:10Z","updated_at":"2024-11-28T12:37:10Z","body":"I tested this issue and actually there's an extra step that needs to be done for reproduce this bug:\n\n- Make a scene with both a `Sprite2D` and an `AnimationPlayer` operating on that `Sprite2D`.\n- Add a shader to the `Sprite2D`.\n- Create an animation in the `AnimationPlayer`.\n- Unfold the `Sprite2D` `material` property and unfold the `shader` property too (the missing step)\n- With the animation panel open, select the `Sprite2D`.\n- Contrary to what you'd expect, when you select the `Sprite2D`, the shader editor panel pops up, requiring you to switch to the animation panel again before you can actually edit the keyframes.\n\nhttps://github.com/user-attachments/assets/db320b93-9b77-44cf-ae36-301d0d28ef40\n\n\n<br>\n\nAlso, this is a regression from #95149, @KoBeWi \n\n![Image](https://github.com/user-attachments/assets/9de1dcaa-6ed2-4fa4-a879-46e5f99aebee)\n","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2506023097/reactions","total_count":2,"+1":2,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2506634332","html_url":"https://github.com/godotengine/godot/issues/99772#issuecomment-2506634332","issue_url":"https://api.github.com/repos/godotengine/godot/issues/99772","id":2506634332,"node_id":"IC_kwDOAO6SJc6VaDRc","user":{"login":"vvye","id":13839342,"node_id":"MDQ6VXNlcjEzODM5MzQy","avatar_url":"https://avatars.githubusercontent.com/u/13839342?v=4","gravatar_id":"","url":"https://api.github.com/users/vvye","html_url":"https://github.com/vvye","followers_url":"https://api.github.com/users/vvye/followers","following_url":"https://api.github.com/users/vvye/following{/other_user}","gists_url":"https://api.github.com/users/vvye/gists{/gist_id}","starred_url":"https://api.github.com/users/vvye/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/vvye/subscriptions","organizations_url":"https://api.github.com/users/vvye/orgs","repos_url":"https://api.github.com/users/vvye/repos","events_url":"https://api.github.com/users/vvye/events{/privacy}","received_events_url":"https://api.github.com/users/vvye/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2024-11-28T18:36:21Z","updated_at":"2024-11-28T18:36:21Z","body":"Thanks @matheusmdx for narrowing it down and @tetrapod00 for reminding me of the pin feature! Good to know it's an actual issue, and that I can work around it for the time being.","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2506634332/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3286775755","html_url":"https://github.com/godotengine/godot/issues/99772#issuecomment-3286775755","issue_url":"https://api.github.com/repos/godotengine/godot/issues/99772","id":3286775755,"node_id":"IC_kwDOAO6SJc7D6DfL","user":{"login":"YeldhamDev","id":30739239,"node_id":"MDQ6VXNlcjMwNzM5MjM5","avatar_url":"https://avatars.githubusercontent.com/u/30739239?v=4","gravatar_id":"","url":"https://api.github.com/users/YeldhamDev","html_url":"https://github.com/YeldhamDev","followers_url":"https://api.github.com/users/YeldhamDev/followers","following_url":"https://api.github.com/users/YeldhamDev/following{/other_user}","gists_url":"https://api.github.com/users/YeldhamDev/gists{/gist_id}","starred_url":"https://api.github.com/users/YeldhamDev/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/YeldhamDev/subscriptions","organizations_url":"https://api.github.com/users/YeldhamDev/orgs","repos_url":"https://api.github.com/users/YeldhamDev/repos","events_url":"https://api.github.com/users/YeldhamDev/events{/privacy}","received_events_url":"https://api.github.com/users/YeldhamDev/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-09-12T20:46:12Z","updated_at":"2025-09-12T20:46:12Z","body":"The simple way of fixing this would be to make resources fold again in the inspector, which is basically what #102248 does. That however can break the workflow of those that rely in the current behavior.\n\nMaybe a a better solution would be a customizable priority system of sorts? With editors like the animation panel in such list as the default. If an editor with lower priority or that isn't on the list attempts to appear on its own, it gets denied.","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3286775755/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3387819072","html_url":"https://github.com/godotengine/godot/issues/99772#issuecomment-3387819072","issue_url":"https://api.github.com/repos/godotengine/godot/issues/99772","id":3387819072,"node_id":"IC_kwDOAO6SJc7J7gRA","user":{"login":"louiidev","id":12892064,"node_id":"MDQ6VXNlcjEyODkyMDY0","avatar_url":"https://avatars.githubusercontent.com/u/12892064?v=4","gravatar_id":"","url":"https://api.github.com/users/louiidev","html_url":"https://github.com/louiidev","followers_url":"https://api.github.com/users/louiidev/followers","following_url":"https://api.github.com/users/louiidev/following{/other_user}","gists_url":"https://api.github.com/users/louiidev/gists{/gist_id}","starred_url":"https://api.github.com/users/louiidev/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/louiidev/subscriptions","organizations_url":"https://api.github.com/users/louiidev/orgs","repos_url":"https://api.github.com/users/louiidev/repos","events_url":"https://api.github.com/users/louiidev/events{/privacy}","received_events_url":"https://api.github.com/users/louiidev/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-10-09T23:59:33Z","updated_at":"2025-10-09T23:59:33Z","body":"Is there a workaround for this? its a very frustrating bug, I basically can't edit any animation on my entity","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3387819072/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3387856342","html_url":"https://github.com/godotengine/godot/issues/99772#issuecomment-3387856342","issue_url":"https://api.github.com/repos/godotengine/godot/issues/99772","id":3387856342,"node_id":"IC_kwDOAO6SJc7J7pXW","user":{"login":"matheusmdx","id":44306054,"node_id":"MDQ6VXNlcjQ0MzA2MDU0","avatar_url":"https://avatars.githubusercontent.com/u/44306054?v=4","gravatar_id":"","url":"https://api.github.com/users/matheusmdx","html_url":"https://github.com/matheusmdx","followers_url":"https://api.github.com/users/matheusmdx/followers","following_url":"https://api.github.com/users/matheusmdx/following{/other_user}","gists_url":"https://api.github.com/users/matheusmdx/gists{/gist_id}","starred_url":"https://api.github.com/users/matheusmdx/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/matheusmdx/subscriptions","organizations_url":"https://api.github.com/users/matheusmdx/orgs","repos_url":"https://api.github.com/users/matheusmdx/repos","events_url":"https://api.github.com/users/matheusmdx/events{/privacy}","received_events_url":"https://api.github.com/users/matheusmdx/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-10-10T00:22:01Z","updated_at":"2025-10-10T00:22:01Z","body":"@louiidev ATM what you can do is: Compile the engine from source cherry-picking #102248, compile from source reverting pr #95149 or use Godot 4.3 stable / 4.4 dev 3 or lower (the bug was introduced in Godot 4.4 dev 4).","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3387856342/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3935837573","html_url":"https://github.com/godotengine/godot/issues/99772#issuecomment-3935837573","issue_url":"https://api.github.com/repos/godotengine/godot/issues/99772","id":3935837573,"node_id":"IC_kwDOAO6SJc7qmB2F","user":{"login":"segaljared","id":9822677,"node_id":"MDQ6VXNlcjk4MjI2Nzc=","avatar_url":"https://avatars.githubusercontent.com/u/9822677?v=4","gravatar_id":"","url":"https://api.github.com/users/segaljared","html_url":"https://github.com/segaljared","followers_url":"https://api.github.com/users/segaljared/followers","following_url":"https://api.github.com/users/segaljared/following{/other_user}","gists_url":"https://api.github.com/users/segaljared/gists{/gist_id}","starred_url":"https://api.github.com/users/segaljared/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/segaljared/subscriptions","organizations_url":"https://api.github.com/users/segaljared/orgs","repos_url":"https://api.github.com/users/segaljared/repos","events_url":"https://api.github.com/users/segaljared/events{/privacy}","received_events_url":"https://api.github.com/users/segaljared/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-02-20T16:18:17Z","updated_at":"2026-02-20T16:18:17Z","body":"> The simple way of fixing this would be to make resources fold again in the inspector, which is basically what [#102248](https://github.com/godotengine/godot/pull/102248) does. That however can break the workflow of those that rely in the current behavior.\n> \n> Maybe a a better solution would be a customizable priority system of sorts? With editors like the animation panel in such list as the default. If an editor with lower priority or that isn't on the list attempts to appear on its own, it gets denied.\n\n@YeldhamDev The shader editor gets shown when we call [add_node here](https://github.com/godotengine/godot/blob/be587f3a2d92f42d52fd3801f94a8dda47e18e64/editor/animation/animation_track_editor.cpp#L3929). Maybe instead of a system of priority, which could be complicated to get the desired behavior, we add a way to select a node without having other editors pushed forward.\n\nCurrently, the shader editor gets pushed to the front in EditorNode::edit_item when we call _plugin_over_edit. What if there was a flag that could be applied when adding a node to the EditorSelection which told the editor **not** to show a new plugin. The flag could be cleared on the next add_node, but would allow us to do a check in edit_item which would prevent showing new plugins. The flag would get set in AnimationTrackEditGroup::gui_input when it is adding the node you've clicked to the selection, which would prevent the shader editor from being shown.","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3935837573/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3936824500","html_url":"https://github.com/godotengine/godot/issues/99772#issuecomment-3936824500","issue_url":"https://api.github.com/repos/godotengine/godot/issues/99772","id":3936824500,"node_id":"IC_kwDOAO6SJc7qpyy0","user":{"login":"KoBeWi","id":2223172,"node_id":"MDQ6VXNlcjIyMjMxNzI=","avatar_url":"https://avatars.githubusercontent.com/u/2223172?v=4","gravatar_id":"","url":"https://api.github.com/users/KoBeWi","html_url":"https://github.com/KoBeWi","followers_url":"https://api.github.com/users/KoBeWi/followers","following_url":"https://api.github.com/users/KoBeWi/following{/other_user}","gists_url":"https://api.github.com/users/KoBeWi/gists{/gist_id}","starred_url":"https://api.github.com/users/KoBeWi/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/KoBeWi/subscriptions","organizations_url":"https://api.github.com/users/KoBeWi/orgs","repos_url":"https://api.github.com/users/KoBeWi/repos","events_url":"https://api.github.com/users/KoBeWi/events{/privacy}","received_events_url":"https://api.github.com/users/KoBeWi/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-02-20T19:54:33Z","updated_at":"2026-02-21T12:56:58Z","body":"There is a dumb workaround for this issue - make the Shader Editor floating and hide it behind the main window. It will no longer appear nor steal focus.","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3936824500/reactions","total_count":2,"+1":2,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3938721833","html_url":"https://github.com/godotengine/godot/issues/99772#issuecomment-3938721833","issue_url":"https://api.github.com/repos/godotengine/godot/issues/99772","id":3938721833,"node_id":"IC_kwDOAO6SJc7qxCAp","user":{"login":"matheusmdx","id":44306054,"node_id":"MDQ6VXNlcjQ0MzA2MDU0","avatar_url":"https://avatars.githubusercontent.com/u/44306054?v=4","gravatar_id":"","url":"https://api.github.com/users/matheusmdx","html_url":"https://github.com/matheusmdx","followers_url":"https://api.github.com/users/matheusmdx/followers","following_url":"https://api.github.com/users/matheusmdx/following{/other_user}","gists_url":"https://api.github.com/users/matheusmdx/gists{/gist_id}","starred_url":"https://api.github.com/users/matheusmdx/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/matheusmdx/subscriptions","organizations_url":"https://api.github.com/users/matheusmdx/orgs","repos_url":"https://api.github.com/users/matheusmdx/repos","events_url":"https://api.github.com/users/matheusmdx/events{/privacy}","received_events_url":"https://api.github.com/users/matheusmdx/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-02-21T12:39:51Z","updated_at":"2026-02-21T12:39:51Z","body":"> There is a dumb workaround for this issue - make the Shader Editor floating and hide it behind the main window. It will no longer appear nor still focus.\n\nAs the current PR to solve this issue also brings an undesired side effect i think is a worth attempt","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3938721833/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null}]