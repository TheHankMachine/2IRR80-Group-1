.githubusercontent.com/u/32321?v=4","gravatar_id":"","url":"https://api.github.com/users/fire","html_url":"https://github.com/fire","followers_url":"https://api.github.com/users/fire/followers","following_url":"https://api.github.com/users/fire/following{/other_user}","gists_url":"https://api.github.com/users/fire/gists{/gist_id}","starred_url":"https://api.github.com/users/fire/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/fire/subscriptions","organizations_url":"https://api.github.com/users/fire/orgs","repos_url":"https://api.github.com/users/fire/repos","events_url":"https://api.github.com/users/fire/events{/privacy}","received_events_url":"https://api.github.com/users/fire/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-05-24T22:54:17Z","updated_at":"2025-05-24T22:54:17Z","body":"The pattern can be done for uv channels (texcoords) https://github.com/godotengine/godot/pull/99676","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2907292729/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2907327428","html_url":"https://github.com/godotengine/godot/pull/106786#issuecomment-2907327428","issue_url":"https://api.github.com/repos/godotengine/godot/issues/106786","id":2907327428,"node_id":"IC_kwDOAO6SJc6tSkvE","user":{"login":"TitanNano","id":4500858,"node_id":"MDQ6VXNlcjQ1MDA4NTg=","avatar_url":"https://avatars.githubusercontent.com/u/4500858?v=4","gravatar_id":"","url":"https://api.github.com/users/TitanNano","html_url":"https://github.com/TitanNano","followers_url":"https://api.github.com/users/TitanNano/followers","following_url":"https://api.github.com/users/TitanNano/following{/other_user}","gists_url":"https://api.github.com/users/TitanNano/gists{/gist_id}","starred_url":"https://api.github.com/users/TitanNano/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/TitanNano/subscriptions","organizations_url":"https://api.github.com/users/TitanNano/orgs","repos_url":"https://api.github.com/users/TitanNano/repos","events_url":"https://api.github.com/users/TitanNano/events{/privacy}","received_events_url":"https://api.github.com/users/TitanNano/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-05-24T23:05:40Z","updated_at":"2025-05-24T23:05:40Z","body":"> The pattern can be done for uv channels (texcoords) #99676\r\n\r\nYou would like to have the ability to remap UV coordinates for every kind of texture, right? I can look into what is done in that PR.","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2907327428/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2907724714","html_url":"https://github.com/godotengine/godot/pull/106786#issuecomment-2907724714","issue_url":"https://api.github.com/repos/godotengine/godot/issues/106786","id":2907724714,"node_id":"IC_kwDOAO6SJc6tUFuq","user":{"login":"TitanNano","id":4500858,"node_id":"MDQ6VXNlcjQ1MDA4NTg=","avatar_url":"https://avatars.githubusercontent.com/u/4500858?v=4","gravatar_id":"","url":"https://api.github.com/users/TitanNano","html_url":"https://github.com/TitanNano","followers_url":"https://api.github.com/users/TitanNano/followers","following_url":"https://api.github.com/users/TitanNano/following{/other_user}","gists_url":"https://api.github.com/users/TitanNano/gists{/gist_id}","starred_url":"https://api.github.com/users/TitanNano/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/TitanNano/subscriptions","organizations_url":"https://api.github.com/users/TitanNano/orgs","repos_url":"https://api.github.com/users/TitanNano/repos","events_url":"https://api.github.com/users/TitanNano/events{/privacy}","received_events_url":"https://api.github.com/users/TitanNano/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-05-25T09:48:06Z","updated_at":"2025-05-25T09:48:06Z","body":"@fire I looked into the linked PR and thought about your comment. \r\n\r\nI think implementing UV channel remapping is quite orthogonal to this PR. As it stands right now, the GLTF importer does not correctly import the UV channel of the occlusion map. This should be fixed for textures where the StandartMaterial3D supports using the secondary UV channel.  (It can be argued that his PR should also support the correct import of the UV channel of emission textures).\r\n\r\nAdding the ability to remap the UV channel would be a neat additional feature, but I would argue that is a new feature and not a fix to the default import behavior. Remapping would need to have the options {`Disabled`, `UV1`, `UV2`} where `Disabled` imports the UV channel as it was specified in the GLTF document.\r\n\r\nDid I miss something here?","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2907724714/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2907818980","html_url":"https://github.com/godotengine/godot/pull/106786#issuecomment-2907818980","issue_url":"https://api.github.com/repos/godotengine/godot/issues/106786","id":2907818980,"node_id":"IC_kwDOAO6SJc6tUcvk","user":{"login":"fire","id":32321,"node_id":"MDQ6VXNlcjMyMzIx","avatar_url":"https://avatars.githubusercontent.com/u/32321?v=4","gravatar_id":"","url":"https://api.github.com/users/fire","html_url":"https://github.com/fire","followers_url":"https://api.github.com/users/fire/followers","following_url":"https://api.github.com/users/fire/following{/other_user}","gists_url":"https://api.github.com/users/fire/gists{/gist_id}","starred_url":"https://api.github.com/users/fire/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/fire/subscriptions","organizations_url":"https://api.github.com/users/fire/orgs","repos_url":"https://api.github.com/users/fire/repos","events_url":"https://api.github.com/users/fire/events{/privacy}","received_events_url":"https://api.github.com/users/fire/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-05-25T13:11:37Z","updated_at":"2025-05-25T13:11:37Z","body":"My point is that in gltf tex coordinate 1 is arbitrarily assigned to uv2 but theres 0 to 7 tex coordinates. So I wanted a second opinion how to resolve this.","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2907818980/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2907981646","html_url":"https://github.com/godotengine/godot/pull/106786#issuecomment-2907981646","issue_url":"https://api.github.com/repos/godotengine/godot/issues/106786","id":2907981646,"node_id":"IC_kwDOAO6SJc6tVEdO","user":{"login":"TitanNano","id":4500858,"node_id":"MDQ6VXNlcjQ1MDA4NTg=","avatar_url":"https://avatars.githubusercontent.com/u/4500858?v=4","gravatar_id":"","url":"https://api.github.com/users/TitanNano","html_url":"https://github.com/TitanNano","followers_url":"https://api.github.com/users/TitanNano/followers","following_url":"https://api.github.com/users/TitanNano/following{/other_user}","gists_url":"https://api.github.com/users/TitanNano/gists{/gist_id}","starred_url":"https://api.github.com/users/TitanNano/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/TitanNano/subscriptions","organizations_url":"https://api.github.com/users/TitanNano/orgs","repos_url":"https://api.github.com/users/TitanNano/repos","events_url":"https://api.github.com/users/TitanNano/events{/privacy}","received_events_url":"https://api.github.com/users/TitanNano/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-05-25T18:07:41Z","updated_at":"2025-05-25T19:20:57Z","body":"Thanks for elaborating.\r\n\r\n> My point is that in gltf tex coordinate 1 is arbitrarily assigned to uv2 but theres 0 to 7\r\n\r\nIt's not arbitrary, though. `TEXCOORD_0` and `TEXCOORD_1` are already being imported as Godots UV and UV2. \r\nhttps://github.com/godotengine/godot/blob/45fc515ae3574e9c1f9deacaa6960dec68a7d38b/modules/gltf/gltf_document.cpp#L3373-L3378\r\nPerhaps if the UV channels 2 - 7 are encountered, though, a warning or error should be emitted, as this cannot be correctly imported.","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2907981646/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2910610497","html_url":"https://github.com/godotengine/godot/pull/106786#issuecomment-2910610497","issue_url":"https://api.github.com/repos/godotengine/godot/issues/106786","id":2910610497,"node_id":"IC_kwDOAO6SJc6tfGRB","user":{"login":"BlueCube3310","id":53150244,"node_id":"MDQ6VXNlcjUzMTUwMjQ0","avatar_url":"https://avatars.githubusercontent.com/u/53150244?v=4","gravatar_id":"","url":"https://api.github.com/users/BlueCube3310","html_url":"https://github.com/BlueCube3310","followers_url":"https://api.github.com/users/BlueCube3310/followers","following_url":"https://api.github.com/users/BlueCube3310/following{/other_