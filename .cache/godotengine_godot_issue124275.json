eo/received_events","type":"User","user_view_type":"public","site_admin":false},"open_issues":50,"closed_issues":0,"state":"open","created_at":"2026-06-24T20:03:09Z","updated_at":"2026-10-21T15:30:45Z","due_on":null,"closed_at":null},"comments":0,"created_at":"2026-10-08T04:40:42Z","updated_at":"2026-10-08T21:30:58Z","closed_at":null,"assignee":null,"author_association":"MEMBER","issue_field_values":[],"type":null,"active_lock_reason":null,"draft":false,"pull_request":{"url":"https://api.github.com/repos/godotengine/godot/pulls/124275","html_url":"https://github.com/godotengine/godot/pull/124275","diff_url":"https://github.com/godotengine/godot/pull/124275.diff","patch_url":"https://github.com/godotengine/godot/pull/124275.patch","merged_at":null},"body":"## What problem(s) does this PR solve?\r\n\r\n- Closes #109119\r\n- Supersedes/Closes #122982\r\n\r\n## Additional information\r\n\r\nInternally `linear_to_db()` is an approximation of `log10()`, but as the method name suggests, the purpose of the `linear_to_db()` function is not to get the `log()` result, but to get the \"dB\" value.\r\n\r\nWhile it is correct for `log()` to return `NaN` when passed a negative value, but it should be intuitive for `linear_to_db()` to return `-INF` when passed a negative value.\r\n\r\nThis PR means a minor breaking compat is included, but I think it is very rare for programs to depend on the case where `linear_to_db()` returns `NaN`, and if any such programs exist, there is a migration path to use `log()`.","closed_by":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/124275/reactions","total_count":7,"+1":4,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":3},"timeline_url":"https://api.github.com/repos/godotengine/godot/issues/124275/timeline","performed_via_github_app":null,"state_reason":null}