.0) {\n\t\t\tmm->set_pressure(trackpad_pressure);\t\n\t\t}\n\t} else if (subtype == NSEventSubtypeTabletPoint) {\n\t\tconst NSPoint p = [event tilt];\n\t\tmm->set_tilt(Vector2(p.x, -p.y));\n\t\tmm->set_pen_inverted(last_pen_inverted);\n\t} else if (subtype == NSEventSubtypeTabletProximity) {\n\t\t// Check if using the eraser end of pen only on proximity event.\n\t\tlast_pen_inverted = [event pointingDeviceType] == NSPointingDeviceTypeEraser;\n\t\tmm->set_pen_inverted(last_pen_inverted);\n\t}\n```","created_at":"2026-01-05T09:18:57Z","updated_at":"2026-01-05T09:19:00Z","html_url":"https://github.com/godotengine/godot/pull/114587#discussion_r2660797681","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/114587","_links":{"self":{"href":"https://api.github.com/repos/godotengine/godot/pulls/comments/2660797681"},"html":{"href":"https://github.com/godotengine/godot/pull/114587#discussion_r2660797681"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/114587"}},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/2660797681/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":531,"original_start_line":531,"start_side":"RIGHT","line":533,"original_line":533,"side":"RIGHT","author_association":"MEMBER","original_position":15,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/2660924206","pull_request_review_id":3626193820,"id":2660924206,"node_id":"PRRC_kwDOAO6SJc6emnsu","diff_hunk":"@@ -527,16 +528,18 @@ - (void)mouseMoved:(NSEvent *)event {\n \tmm->set_button_mask(ds->mouse_get_button_state());\n \tds->update_mouse_pos(wd, mpos);\n \tmm->set_position(wd.mouse_pos);\n-\tmm->set_pressure([event pressure]);\n+\tmm->set_pressure(trackpad_pressure);\n \tNSEventSubtype subtype = [event subtype];\n \tif (subtype == NSEventSubtypeTabletPoint) {","path":"platform/macos/godot_content_vi