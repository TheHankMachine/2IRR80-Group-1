ription":"","archived_at":null,"archived_by":null},{"id":572781997,"node_id":"MDU6TGFiZWw1NzI3ODE5OTc=","url":"https://api.github.com/repos/godotengine/godot/labels/topic:audio","name":"topic:audio","color":"ffee88","default":false,"description":"","archived_at":null,"archived_by":null},{"id":3240950060,"node_id":"MDU6TGFiZWwzMjQwOTUwMDYw","url":"https://api.github.com/repos/godotengine/godot/labels/performance","name":"performance","color":"447777","default":false,"description":"","archived_at":null,"archived_by":null}],"state":"closed","locked":false,"assignees":[],"milestone":{"url":"https://api.github.com/repos/godotengine/godot/milestones/25","html_url":"https://github.com/godotengine/godot/milestone/25","labels_url":"https://api.github.com/repos/godotengine/godot/milestones/25/labels","id":15520464,"node_id":"MI_kwDOAO6SJc4A7NLQ","number":25,"title":"4.8","description":"","creator":{"login":"Repiteo","id":17489292,"node_id":"MDQ6VXNlcjE3NDg5Mjky","avatar_url":"https://avatars.githubusercontent.com/u/17489292?v=4","gravatar_id":"","url":"https://api.github.com/users/Repiteo","html_url":"https://github.com/Repiteo","followers_url":"https://api.github.com/users/Repiteo/followers","following_url":"https://api.github.com/users/Repiteo/following{/other_user}","gists_url":"https://api.github.com/users/Repiteo/gists{/gist_id}","starred_url":"https://api.github.com/users/Repiteo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Repiteo/subscriptions","organizations_url":"https://api.github.com/users/Repiteo/orgs","repos_url":"https://api.github.com/users/Repiteo/repos","events_url":"https://api.github.com/users/Repiteo/events{/privacy}","received_events_url":"https://api.github.com/users/Repiteo/received_events","type":"User","user_view_type":"public","site_admin":false},"open_issues":345,"closed_issues":2335,"state":"open","created_at":"2026-04-13T15:59:35Z","updated_at":"2026-10-22T08:15:08Z","due_on":null,"closed_at":null},"comments":1,"created_at":"2026-08-31T13:46:56Z","updated_at":"2026-08-31T19:57:45Z","closed_at":"2026-08-31T19:55:07Z","assignee":null,"author_association":"CONTRIBUTOR","issue_field_values":[],"type":null,"active_lock_reason":null,"draft":false,"pull_request":{"url":"https://api.github.com/repos/godotengine/godot/pulls/123034","html_url":"https://github.com/godotengine/godot/pull/123034","diff_url":"https://github.com/godotengine/godot/pull/123034.diff","patch_url":"https://github.com/godotengine/godot/pull/123034.patch","merged_at":"2026-08-31T19:55:07Z"},"body":"## What problem(s) does this PR solve?\r\n\r\nThe main reason was to clean up this codeblock:\r\n\r\nhttps://github.com/godotengine/godot/blob/5ec4857b340b6284a18b49b2eda462bd250f219a/editor/audio/audio_stream_preview.cpp#L199-L207\r\n\r\nbut it turns out there's a real performance benefit - see below.\r\n\r\n## `AudioStreamPreview::preview`\r\n\r\nDoesn't need CoW.\r\n\r\nChanging this to `LocalVector` improves the performance of `AudioStreamPreview::get_max()` / `get_min()` by 10%, together with #123033 by 27%, which makes `AudioStreamImportSettingsDialog::_draw_preview()` faster by the same amount - see the other PR for more details on that.\r\n\r\nThis change doesn't hurt thread safety, as it's only accessed from `AudioStreamPreview` and `AudioStreamPreviewGenerator`, which don't copy it anywhere. There should probably be a Mutex, but that's not in the scope of this PR, and this bug existed before this change.\r\n\r\n## `Vector<AudioFrame> mix_chunk` in `AudioStreamPreviewGenerator::_preview_thread`\r\n\r\nDoesn't need CoW, but changing it to `LocalVector` doesn't produce any performance impact (the overhead is very small in this case), so it's only a codestyle change.\r\n\r\n## Additional information\r\n\r\nNo AI was used.\r\n","closed_by":{"login":"Repiteo","id":17489292,"node_id":"MDQ6VXNlcjE3NDg5Mjky","avatar_url":"https://avatars.githubusercontent.com/u/17489292?v=4","gravatar_id":"","url":"https://api.github.com/users/Repiteo","html_url":"https://github.com/Repiteo","followers_url":"https://api.github.com/users/Repiteo/followers","following_url":"https://api.github.com/users/Repiteo/following{/other_user}","gists_url":"https://api.github.com/users/Repiteo/gists{/gist_id}","starred_url":"https://api.github.com/users/Repiteo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Repiteo/subscriptions","organizations_url":"https://api.github.com/users/Repiteo/orgs","repos_url":"https://api.github.com/users/Repiteo/repos","events_url":"https://api.github.com/users/Repiteo/events{/privacy}","received_events_url":"https://api.github.com/users/Repiteo/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/123034/reactions","total_count":3,"+1":3,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/godotengine/godot/issues/123034/timeline","performed_via_github_app":null,"state_reason":null}