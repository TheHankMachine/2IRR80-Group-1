E2NTIxMzM5","avatar_url":"https://avatars.githubusercontent.com/u/16521339?v=4","gravatar_id":"","url":"https://api.github.com/users/clayjohn","html_url":"https://github.com/clayjohn","followers_url":"https://api.github.com/users/clayjohn/followers","following_url":"https://api.github.com/users/clayjohn/following{/other_user}","gists_url":"https://api.github.com/users/clayjohn/gists{/gist_id}","starred_url":"https://api.github.com/users/clayjohn/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/clayjohn/subscriptions","organizations_url":"https://api.github.com/users/clayjohn/orgs","repos_url":"https://api.github.com/users/clayjohn/repos","events_url":"https://api.github.com/users/clayjohn/events{/privacy}","received_events_url":"https://api.github.com/users/clayjohn/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-10-16T19:32:47Z","updated_at":"2025-10-16T19:32:47Z","body":"> See my comment just above yours, my bad thought that part was obvious from the description\r\n\r\nUnfortunately it still isn't obvious. What is wrong with the previous code?\r\n\r\n\"less than optimal code cases\" sounds like a performance concern and \"poor use of combination of methods\" does as well, but you also insist that it isn't a performance issue. ","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3412558133/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3412577813","html_url":"https://github.com/godotengine/godot/pull/111738#issuecomment-3412577813","issue_url":"https://api.github.com/repos/godotengine/godot/issues/111738","id":3412577813,"node_id":"IC_kwDOAO6SJc7LZ84V","user":{"login":"AThousandShips","id":96648715,"node_id":"U_kgDOBcK-Cw","avatar_url":"https://avatars.githubusercontent.com/u/96648715?v=4","gravatar_id":"","url":"https://api.github.com/users/AThousandShips","html_url":"https://github.com/AThousandShips","followers_url":"https://api.github.com/users/AThousandShips/followers","following_url":"https://api.github.com/users/AThousandShips/following{/other_user}","gists_url":"https://api.github.com/users/AThousandShips/gists{/gist_id}","starred_url":"https://api.github.com/users/AThousandShips/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/AThousandShips/subscriptions","organizations_url":"https://api.github.com/users/AThousandShips/orgs","repos_url":"https://api.github.com/users/AThousandShips/repos","events_url":"https://api.github.com/users/AThousandShips/events{/privacy}","received_events_url":"https://api.github.com/users/AThousandShips/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-10-16T19:38:57Z","updated_at":"2025-10-16T19:40:54Z","body":"What I said was that it wasn't specifically about performance\r\n\r\nThe issue here is redundancy, performing two operations in a row that are equivalent, `HashMap::has` is effectively the same as `HashMap::getptr != nullptr` (via `_lookup_idx`), so using `has` and then followed by any indexing operation is duplicated operations, which unless the compiler optimizes out the repeated action is a waste of operations (i.e. one is the subset of the other, and can be accomplished by the other)\r\n\r\nSo through that it's an attempt to avoid code that is inherently redundant, and improving the general usage of these to prevent them going forward (coupled with suggesting proper usage in new code)","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3412577813/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3412586984","html_url":"https://github.com/godotengine/godot/pull/111738#issuecomment-3412586984","issue_url":"https://api.github.com/repos/godotengine/godot/issues/111738","id":3412586984,"node_id":"IC_kwDOAO6SJc7LZ_Ho","user":{"login":"clayjohn","id":16521339,"node_id":"MDQ6VXNlcjE2NTIxMzM5","avatar_url":"https://avatars.githubusercontent.com/u/16521339?v=4","gravatar_id":"","url":"https://api.github.com/users/clayjohn","html_url":"https://github.com/clayjohn","followers_url":"https://api.github.com/users/clayjohn/followers","following_url":"https://api.github.com/users/clayjohn/following{/other_user}","gists_url":"https://api.github.com/users/clayjohn/gists{/gist_id}","starred_url":"https://api.github.com/users/clayjohn/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/clayjohn/subscriptions","organizations_url":"https://api.github.com/users/clayjohn/orgs","repos_url":"https://api.github.com/users/clayjohn/repos","events_url":"https://api.github.com/users/clayjohn/events{/privacy}","received_events_url":"https://api.github.com/users/clayjohn/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-10-16T19:42:06Z","updated_at":"2025-10-16T19:42:54Z","body":"Okay, so it _is_ a performance concern. Take a look at our optimization guidelines https://contributing.godotengine.org/en/latest/engine/guidelines/optimization.html#choosing-what-to-optimize since we discuss this situation there. ","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3412586984/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3412598541","html_url":"https://github.com/godotengine/godot/pull/111738#issuecomment-3412598541","issue_url":"https://api.github.com/repos/godo