ose for details).\n   at: cleanup (core\\object\\object.cpp:2415)\nERROR: 6 resources still in use at exit (run with --verbose for details).\n   at: clear (core\\io\\resource.cpp:634)\n\n\nThis should be unrelated to this issue, as the corresponding function is completely normal in 4.4.1. But I am not sure where to properly troubleshoot these error prompts, as they are functioning normally in the editor without any additional error prompts.","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2795640349/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2795759518","html_url":"https://github.com/godotengine/godot/issues/105260#issuecomment-2795759518","issue_url":"https://api.github.com/repos/godotengine/godot/issues/105260","id":2795759518,"node_id":"IC_kwDOAO6SJc6mo-ee","user":{"login":"rqelove510","id":53137827,"node_id":"MDQ6VXNlcjUzMTM3ODI3","avatar_url":"https://avatars.githubusercontent.com/u/53137827?v=4","gravatar_id":"","url":"https://api.github.com/users/rqelove510","html_url":"https://github.com/rqelove510","followers_url":"https://api.github.com/users/rqelove510/followers","following_url":"https://api.github.com/users/rqelove510/following{/other_user}","gists_url":"https://api.github.com/users/rqelove510/gists{/gist_id}","starred_url":"https://api.github.com/users/rqelove510/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/rqelove510/subscriptions","organizations_url":"https://api.github.com/users/rqelove510/orgs","repos_url":"https://api.github.com/users/rqelove510/repos","events_url":"https://api.github.com/users/rqelove510/events{/privacy}","received_events_url":"https://api.github.com/users/rqelove510/received_events","type":"User","user_view_type":"public","site_admin":false},"creat