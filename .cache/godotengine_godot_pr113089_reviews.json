57dd9&v=4","gravatar_id":"","url":"https://api.github.com/users/DeeJayLSP","html_url":"https://github.com/DeeJayLSP","followers_url":"https://api.github.com/users/DeeJayLSP/followers","following_url":"https://api.github.com/users/DeeJayLSP/following{/other_user}","gists_url":"https://api.github.com/users/DeeJayLSP/gists{/gist_id}","starred_url":"https://api.github.com/users/DeeJayLSP/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/DeeJayLSP/subscriptions","organizations_url":"https://api.github.com/users/DeeJayLSP/orgs","repos_url":"https://api.github.com/users/DeeJayLSP/repos","events_url":"https://api.github.com/users/DeeJayLSP/events{/privacy}","received_events_url":"https://api.github.com/users/DeeJayLSP/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"","state":"COMMENTED","html_url":"https://github.com/godotengine/godot/pull/113089#pullrequestreview-3517376907","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/113089","author_association":"CONTRIBUTOR","_links":{"html":{"href":"https://github.com/godotengine/godot/pull/113089#pullrequestreview-3517376907"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/113089"}},"submitted_at":"2025-11-28T03:39:23Z","commit_id":null},{"id":3517387254,"node_id":"PRR_kwDOAO6SJc7RpxH2","user":{"login":"DeeJayLSP","id":60024671,"node_id":"MDQ6VXNlcjYwMDI0Njcx","avatar_url":"https://avatars.githubusercontent.com/u/60024671?u=7e327c81e8a9552ea98ca69adcccac4a50657dd9&v=4","gravatar_id":"","url":"https://api.github.com/users/DeeJayLSP","html_url":"https://github.com/DeeJayLSP","followers_url":"https://api.github.com/users/DeeJayLSP/followers","following_url":"https://api.github.com/users/DeeJayLSP/following{/other_user}","gists_url":"https://api.github.com/users/DeeJayLSP/gists{/gist_id}","starred_url":"https://api.github.com/users/DeeJayLSP/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/DeeJayLSP/subscriptions","organizations_url":"https://api.github.com/users/DeeJayLSP/orgs","repos_url":"https://api.github.com/users/DeeJayLSP/repos","events_url":"https://api.github.com/users/DeeJayLSP/events{/privacy}","received_events_url":"https://api.github.com/users/DeeJayLSP/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"","state":"COMMENTED","html_url":"https://github.com/godotengine/godot/pull/113089#pullrequestreview-3517387254","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/113089","author_association":"CONTRIBUTOR","_links":{"html":{"href":"https://github.com/godotengine/godot/pull/113089#pullrequestreview-3517387254"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/113089"}},"submitted_at":"2025-11-28T03:50:23Z","commit_id":null},{"id":3520619560,"node_id":"PRR_kwDOAO6SJc7R2GQo","user":{"login":"Ivorforce","id":2308167,"node_id":"MDQ6VXNlcjIzMDgxNjc=","avatar_url":"https://avatars.githubusercontent.com/u/2308167?u=f7f8e0273f784f5ec6f6b7fe4a88d449896eb48a&v=4","gravatar_id":"","url":"https://api.github.com/users/Ivorforce","html_url":"https://github.com/Ivorforce","followers_url":"https://api.github.com/users/Ivorforce/followers","following_url":"https://api.github.com/users/Ivorforce/following{/other_user}","gists_url":"https://api.github.com/users/Ivorforce/gists{/gist_id}","starred_url":"https://api.github.com/users/Ivorforce/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Ivorforce/subscriptions","organizations_url":"https://api.github.com/users/Ivorforce/orgs","repos_url":"https://api.github.com/users/Ivorforce/repos","events_url":"https://api.github.com/users/Ivorforce/events{/privacy}","received_events_url":"https://api.github.com/users/Ivorforce/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"> Remember that a GDScript test has more overhead than just AHashMap lookups and is more prone to fluctuations.\r\n\r\nYes, this is the reason I usually test from C++ instead of from GDScript for core containers. I agree that GDScript performance tests are preferable in general, since they can show that the improvement has an actual impact on GDScript code. \r\nBut, that's only if the improvement is large enough for it to affect GDScript measurably. With container optimizations, this isn't often the case, because the GDScript bottlenecks lie elsewhere. Since the fluctuation is much higher than the improvement in your benchmarks, that makes these tests inadequate for this kind of change.\r\n\r\n> Note that in many cases, replacing HashMap with AHashMap may either cause mixed results or a slowdown, something I've seen many times and is now visible in https://github.com/godotengine/godot/pull/112039. And on the latter, having this PR on top actually sped things up even placing that on top of this.\r\n\r\nWhen I look at those results, I'm seeing measurement fluctuations more than 'mixed results'. You're trying to optimize something with an improvement threshold far below the cost of the bottleneck of what you're trying to measure. It's very easy to misinterpret results like this as improvements or regressions.\r\n\r\n> So, is this PR being judged more by my previous PRs than by itself?\r\n\r\nNo, I judge the code and tests first and foremost. I've commented my reservations multiple times above too.\r\nYou clearly put a lot of effort into profiling and benchmarking, and I appreciate that. That's exactly what we need for optimization PRs.\r\nBut so far, you've ignored the high fluctuations of your measurements, which often led to you amending your PRs to include various changes that are unlikely to have a performance impact. I highly suspect you're overinterpreting the fluctuations of your measurements, so I'm pleading with you to take a step back and review your targets and your methodology. If you're interested, we could have a chat about how.","state":"COMMENTED","html_url":"