acy}","received_events_url":"https://api.github.com/users/DanielKinsman/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-05-01T03:10:03Z","updated_at":"2025-05-01T03:10:03Z","body":"This PR is now back in a working state and ready for review. If any of you want me to keep it updated with master after today, add a comment, or perhaps let me know which meeting to attend.","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2843984707/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2846223239","html_url":"https://github.com/godotengine/godot/pull/104347#issuecomment-2846223239","issue_url":"https://api.github.com/repos/godotengine/godot/issues/104347","id":2846223239,"node_id":"IC_kwDOAO6SJc6ppeuH","user":{"login":"DanielKinsman","id":15639,"node_id":"MDQ6VXNlcjE1NjM5","avatar_url":"https://avatars.githubusercontent.com/u/15639?v=4","gravatar_id":"","url":"https://api.github.com/users/DanielKinsman","html_url":"https://github.com/DanielKinsman","followers_url":"https://api.github.com/users/DanielKinsman/followers","following_url":"https://api.github.com/users/DanielKinsman/following{/other_user}","gists_url":"https://api.github.com/users/DanielKinsman/gists{/gist_id}","starred_url":"https://api.github.com/users/DanielKinsman/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/DanielKinsman/subscriptions","organizations_url":"https://api.github.com/users/DanielKinsman/orgs","repos_url":"https://api.github.com/users/DanielKinsman/repos","events_url":"https://api.github.com/users/DanielKinsman/events{/privacy}","received_events_url":"https://api.github.com/users/DanielKinsman/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-05-02T03:16:37Z","updated_at":"2025-05-02T03:16:37Z","body":"I've made all the requested changes in a new commit to make re-reviewing easier, will squash them together before merge.","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2846223239/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2846664813","html_url":"https://github.com/godotengine/godot/pull/104347#issuecomment-2846664813","issue_url":"https://api.github.com/repos/godotengine/godot/issues/104347","id":2846664813,"node_id":"IC_kwDOAO6SJc6prKht","user":{"login":"akien-mga","id":4701338,"node_id":"MDQ6VXNlcjQ3MDEzMzg=","avatar_url":"https://avatars.githubusercontent.com/u/4701338?v=4","gravatar_id":"","url":"https://api.github.com/users/akien-mga","html_url":"https://github.com/akien-mga","followers_url":"https://api.github.com/users/akien-mga/followers","following_url":"https://api.github.com/users/akien-mga/following{/other_user}","gists_url":"https://api.github.com/users/akien-mga/gists{/gist_id}","starred_url":"https://api.github.com/users/akien-mga/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/akien-mga/subscriptions","organizations_url":"https://api.github.com/users/akien-mga/orgs","repos_url":"https://api.github.com/users/akien-mga/repos","events_url":"https://api.github.com/users/akien-mga/events{/privacy}","received_events_url":"https://api.github.com/users/akien-mga/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-05-02T08:33:46Z","updated_at":"2025-05-02T08:33:46Z","body":"I got a linking issue when building with the jpg module first, and then with the module disabled:\r\n```\r\nmold: error: undefined symbol: JpgLoader::JpgLoader()\r\n>>> referenced by tvgLoader.cpp\r\n>>>               bin/obj/modules/libmodule_svg.linuxbsd.editor.dev.x86_64.a(tvgLoader.linuxbsd.editor.dev.x86_64.o):(_find(FileType))\r\n```\r\n\r\nI'll look into it, SCons should normally properly recompile the dependent files if the config changed, so maybe we missed something.","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2846664813/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2846680755","html_url":"https://github.com/godotengine/godot/pull/104347#issuecomment-2846680755","issue_url":"https://api.github.com/repos/godotengine/godot/issues/104347","id":2846680755,"node_id":"IC_kwDOAO6SJc6prOaz","user":{"login":"akien-mga","id":4701338,"node_id":"MDQ6VXNlcjQ3MDEzMzg=","avatar_url":"https://avatars.githubusercontent.com/u/4701338?v=4","gravatar_id":"","url":"https://api.github.com/users/akien-mga","html_url":"https://github.com/akien-mga","followers_url":"https://api.github.com/users/akien-mga/followers","following_url":"https://api.github.com/users/akien-mga/following{/other_user}","gists_url":"https://api.github.com/users/akien-mga/gists{/gist_id}","starred_url":"https://api.github.com/users/akien-mga/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/akien-mga/subscriptions","organizations_url":"https://api.github.com/users/akien-mga/orgs","repos_url":"https://api.github.com/users/akien-mga/repos","events_url":"https://api.github.com/users/akien-mga/events{/privacy}","received_events_url":"https://api.github.com/users/akien-mga/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-05-02T08:42:16Z","updated_at":"2025-05-02T08:42:42Z","body":"The problem comes from my use of our `scons_cache` option, I don't think it's caused by this PR, but it's a bug in our cache handling.\r\n\r\nBuilding first with:\r\n```\r\nscons dev_build=yes dev_mode=yes linker=mold scu_build=all cache_path=/home/akien/.scons_cache/godot/ module_jpg_enabled=yes\r\n```\r\nand then:\r\n```\r\nscons dev_build=yes dev_mode=yes linker=mold scu_build=all cache_path=/home/akien/.scons_cache/godot/ module_jpg_enabled=no\r\n```\r\nI see:\r\n```\r\nRetrieved `bin/obj/thirdparty/thorvg/src/renderer/tvgLoader.linuxbsd.editor.dev.x86_64.o' from cache\r\n```\r\nwhile the `env_svg` should definitely have changed with the removal of the `THORVG_JPG_LOADER_SUPPORT` which should cause the `tvgLoader.cpp` file to be recompiled (together all other thorvg files).\r\n\r\nWithout `scons_cache`, all files properly get recompiled whenever the value of `module_jpg_enabled` changes.\r\n\r\nCC @Repiteo @AThousandShips \r\n\r\nThis shouldn't block merging this PR, it's an orthogonal issue.","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2846680755/reactions","total_count":2,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":1},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2846693000","html_url":"https://github.com/godotengine/godot/pull/104347#issuecomment-2846693000","issue_url":"https://api.github.com/repos/godotengine/godot/issues/104347","id":2846693000,"node_id":"IC_kwDOAO6SJc6prRaI","user":{"login":"akien-mga","id":4701338,"node_id":"MDQ6VXNlcjQ3MDEzMzg=","avatar_url":"https://avatars.githubusercontent.com/u/4701338?v=4","gravatar_id":"","url":"https://api.github.com/users/akien-mga","html_url":"https://github.com/akien-mga","followers_url":"https://api.github.com/users/akien-mga/followers","following_url":"https://api.github.com/users/akien-mga/following{/other_user}","gists_url":"https://api.github.com/users/akien-mga/gists{/gist_id}","starred_url":"https://api.github.com/users/akien-mga/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/akien-mga/subscriptions","organizations_url":"https://api.github.com/users/akien-mga/orgs","repos_url":"https://api.github.com/users/akien-mga/repos","events_url":"https://api.github.com/users/akien-mga/events{/privacy}","received_events_url":"https://api.github.com/users/akien-mga/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-05-02T08:48:38Z","updated_at":"2025-05-02T09:48:29Z","body":"On the other hand there's this one change that should be added too, even though currently it has no impact. It registers the svg module's two optional dependencies as such:\r\n```diff\r\ndiff --git a/modules/svg/config.py b/modules/svg/config.py\r\nindex d22f9454ed..d37f02188f 100644\r\n--- a/modules/svg/config.py\r\n+++ b/modules/svg/config.py\r\n@@ -1,4 +1,5 @@\r\n def can_build(env, platform):\r\n+    env.module_add_dependencies(\"svg\", [\"jpg\", \"webp\"], True)\r\n     return True\r\n \r\n \r\n```\r\n\r\n(`True` makes it optional. If not optional, then disabling one of those prevents building with that module enabled. The optional flag makes it do nothing, but we still track those, so in the future we might use it to provide useful context e.g. in the `--help` output, or print info messages that some features are disabled.)","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2846693000/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2846800592","html_url":"https://github.com/godotengine/godot/pull/104347#issuecomment-2846800592","issue_url":"https://api.github.com/repos/godotengine/godot/issues/104347","id":2846800592,"node_id":"IC_kwDOAO6SJc6prrrQ","user":{"login":"akien-mga","id":4701338,"node_id":"MDQ6VXNlcjQ3MDEzMzg=","avatar_url