.github.com/repos/godotengine/godot/issues/comments/4013870660/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4014070584","html_url":"https://github.com/godotengine/godot/pull/117160#issuecomment-4014070584","issue_url":"https://api.github.com/repos/godotengine/godot/issues/117160","id":4014070584,"node_id":"IC_kwDOAO6SJc7vQds4","user":{"login":"Naros","id":3255568,"node_id":"MDQ6VXNlcjMyNTU1Njg=","avatar_url":"https://avatars.githubusercontent.com/u/3255568?v=4","gravatar_id":"","url":"https://api.github.com/users/Naros","html_url":"https://github.com/Naros","followers_url":"https://api.github.com/users/Naros/followers","following_url":"https://api.github.com/users/Naros/following{/other_user}","gists_url":"https://api.github.com/users/Naros/gists{/gist_id}","starred_url":"https://api.github.com/users/Naros/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Naros/subscriptions","organizations_url":"https://api.github.com/users/Naros/orgs","repos_url":"https://api.github.com/users/Naros/repos","events_url":"https://api.github.com/users/Naros/events{/privacy}","received_events_url":"https://api.github.com/users/Naros/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-03-06T20:50:26Z","updated_at":"2026-03-06T20:52:56Z","body":"Hi @Bromeon, GDScript already has this via `@GlobalScope.type_string` method, as it is exposed there via the Variant Utility Functions contracts. So all that we needed is the parity with modules on the GDExtension side from what I saw. If I've missed something, please let me know.","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4014070584/reactions","total_count":2,"+1":0,"-1":2,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":