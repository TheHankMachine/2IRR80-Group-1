usercontent.com/u/180032?u=68d23e7ee9cdf810da125e8510b72f845b9dccc8&v=4","gravatar_id":"","url":"https://api.github.com/users/Calinou","html_url":"https://github.com/Calinou","followers_url":"https://api.github.com/users/Calinou/followers","following_url":"https://api.github.com/users/Calinou/following{/other_user}","gists_url":"https://api.github.com/users/Calinou/gists{/gist_id}","starred_url":"https://api.github.com/users/Calinou/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Calinou/subscriptions","organizations_url":"https://api.github.com/users/Calinou/orgs","repos_url":"https://api.github.com/users/Calinou/repos","events_url":"https://api.github.com/users/Calinou/events{/privacy}","received_events_url":"https://api.github.com/users/Calinou/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"Tested locally, it works as expected. Code looks good to me.\r\n\r\nNote that it's up to the developer to correct the aspect ratio, as distortion is allowed in this mode. Example with the viewport on the left being 256×512, and the one on the right being 1024×512:\r\n\r\n<img width=\"1598\" height=\"962\" alt=\"Image\" src=\"https://github.com/user-attachments/assets/84f375cb-0095-463b-ac56-9afd76e9e249\" />\r\n\r\n[This is sometimes desired](https://github.com/godotengine/godot-proposals/issues/11160), but it may increase the difficulty of using this feature in the most common use case scenario (pixel art games wishing to support widescreen with not too much hassle).\r\n\r\nIt might be worth having another mode that sets a fixed resolution, but stretches it automatically according to the SubViewportContainer's aspect ratio to avoid distortion. You would set the size assuming the SubViewportContainer has a 1:1 aspect ratio, then it would automatically compensate behind the scenes. For example, setting the size to 100×100 would result in a 177×100 viewport on 16:9.\r\n\r\nI still think we should make the shrink factor a float in the long run, but doing so would break GDExtension compatibility. To do so in a way that preserves compatibility, a new property needs to be introduced (with a different name), then `shrink` can be deprecated (and set the new property automatically when assigned a value).","state":"COMMENTED","html_url":"https://github.com/godotengine/godot/pull/117104#pullrequestreview-4298566987","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/117104","author_association":"MEMBER","_links":{"html":{"href":"https://github.com/godotengine/godot/pull/117104#pullrequestreview-4298566987"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/117104"}},"submitted_at":"2026-05-15T13:44:09Z","commit_id":"a7418e39581db82c1577a74c1557896722e1d196"},{"id":4301658949,"node_id":"PRR_kwDOAO6SJc8AAAABAGYbRQ","user":{"login":"EMBYRDEV","id":20043270,"node_id":"MDQ6VXNlcjIwMDQzMjcw","avatar_url":"https://avatars.githubusercontent.com/u/20043270?u=a0dedaf0413b5dc0797039d202876fcc246374d4&v=4","gravatar_id":"","url":"https://api.github.com/users/EMBYRDEV","html_url":"https://github.com/EMBYRDEV","followers_url":"https://api.github.com/users/EMBYRDEV/followers","following_url":"https://api.github.com/users/EMBYRDEV/following{/other_user}","gists_url":"https://api.github.com/users/EMBYRDEV/gists{/gist_id}","starred_url":"https://api.github.com/users/EMBYRDEV/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/EMBYRDEV/subscriptions","organizations_url":"https://api.github.com/users/EMBYRDEV/orgs","repos_url":"https://api.github.com/users/EMBYRDEV/repos","events_url":"https://api.github.com/users/EMBYRDEV/events{/privacy}","received_events_url":"https://api.github.com/users/EMBYRDEV/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"","state":"COMMENTED","html_url":"https://github.com/godotengine/godot/pull/117104#pullrequestreview-4301658949","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/117104","author_association":"CONTRIBUTOR","_links":{"html":{"href":"https://github.com/godotengine/godot/pull/117104#pullrequestreview-4301658949"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/117104"}},"submitted_at":"2026-05-15T22:02:58Z","commit_id":"a7418e39581db82c1577a74c1557896722e1d196"}]