[{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2910571168","html_url":"https://github.com/godotengine/godot/pull/106444#issuecomment-2910571168","issue_url":"https://api.github.com/repos/godotengine/godot/issues/106444","id":2910571168,"node_id":"IC_kwDOAO6SJc6te8qg","user":{"login":"IceflowRE","id":10883690,"node_id":"MDQ6VXNlcjEwODgzNjkw","avatar_url":"https://avatars.githubusercontent.com/u/10883690?v=4","gravatar_id":"","url":"https://api.github.com/users/IceflowRE","html_url":"https://github.com/IceflowRE","followers_url":"https://api.github.com/users/IceflowRE/followers","following_url":"https://api.github.com/users/IceflowRE/following{/other_user}","gists_url":"https://api.github.com/users/IceflowRE/gists{/gist_id}","starred_url":"https://api.github.com/users/IceflowRE/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/IceflowRE/subscriptions","organizations_url":"https://api.github.com/users/IceflowRE/orgs","repos_url":"https://api.github.com/users/IceflowRE/repos","events_url":"https://api.github.com/users/IceflowRE/events{/privacy}","received_events_url":"https://api.github.com/users/IceflowRE/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-05-26T20:15:50Z","updated_at":"2025-05-26T20:15:50Z","body":"IMHO, the POT Generator should get a public API. With a filter callback and more.\r\nMy first thoughts are:\r\n- Why only prefix? and not suffix?\r\n- Why limit it to one?\r\n\r\nNothing against this solution, but it feels like a short term solution  (for a special use case?), not something which would improve the POT generation configuration in long term.","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2910571168/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.co