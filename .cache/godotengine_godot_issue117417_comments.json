[{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4072498498","html_url":"https://github.com/godotengine/godot/pull/117417#issuecomment-4072498498","issue_url":"https://api.github.com/repos/godotengine/godot/issues/117417","id":4072498498,"node_id":"IC_kwDOAO6SJc7yvWVC","user":{"login":"Chaosus","id":3036176,"node_id":"MDQ6VXNlcjMwMzYxNzY=","avatar_url":"https://avatars.githubusercontent.com/u/3036176?v=4","gravatar_id":"","url":"https://api.github.com/users/Chaosus","html_url":"https://github.com/Chaosus","followers_url":"https://api.github.com/users/Chaosus/followers","following_url":"https://api.github.com/users/Chaosus/following{/other_user}","gists_url":"https://api.github.com/users/Chaosus/gists{/gist_id}","starred_url":"https://api.github.com/users/Chaosus/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Chaosus/subscriptions","organizations_url":"https://api.github.com/users/Chaosus/orgs","repos_url":"https://api.github.com/users/Chaosus/repos","events_url":"https://api.github.com/users/Chaosus/events{/privacy}","received_events_url":"https://api.github.com/users/Chaosus/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-03-17T05:40:55Z","updated_at":"2026-03-17T05:40:55Z","body":"> The texture gather limit is lower on Metal (hardcoded to -8; 7), which is going to cause compatibility issues for shaders that rely on higher/lower values than that.\r\n\r\nI asked Grok about it, and it said that a limit is exactly -8, 7 on all Apple platforms, IDK what to do with that - limit gather limit for all platforms to -8, 7?","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4072498498/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4074512696","html_url":"https://github.com/godotengine/godot/pull/117417#issuecomment-4074512696","issue_url":"https://api.github.com/repos/godotengine/godot/issues/117417","id":4074512696,"node_id":"IC_kwDOAO6SJc7y3CE4","user":{"login":"blueskythlikesclouds","id":19259897,"node_id":"MDQ6VXNlcjE5MjU5ODk3","avatar_url":"https://avatars.githubusercontent.com/u/19259897?v=4","gravatar_id":"","url":"https://api.github.com/users/blueskythlikesclouds","html_url":"https://github.com/blueskythlikesclouds","followers_url":"https://api.github.com/users/blueskythlikesclouds/followers","following_url":"https://api.github.com/users/blueskythlikesclouds/following{/other_user}","gists_url":"https://api.github.com/users/blueskythlikesclouds/gists{/gist_id}","starred_url":"https://api.github.com/users/blueskythlikesclouds/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/blueskythlikesclouds/subscriptions","organizations_url":"https://api.github.com/users/blueskythlikesclouds/orgs","repos_url":"https://api.github.com/users/blueskythlikesclouds/repos","events_url":"https://api.github.com/users/blueskythlikesclouds/events{/privacy}","received_events_url":"https://api.github.com/users/blueskythlikesclouds/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-03-17T12:12:17Z","updated_at":"2026-03-17T12:14:54Z","body":"The limit should probably be hardcoded to not break the shader baker. If a device has a different limit than the device where the shaders were baked, they would need to be recompiled at runtime.","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4074512696/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4074776288","html_url":"https://github.com/godotengine/godot/pull/117417#issu