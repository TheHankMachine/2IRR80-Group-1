yNzkxMjgwNDQ=","url":"https://api.github.com/repos/godotengine/godot/labels/confirmed","name":"confirmed","color":"aaddaa","default":false,"description":"","archived_at":null,"archived_by":null}],"state":"closed","locked":false,"assignees":[],"milestone":{"url":"https://api.github.com/repos/godotengine/godot/milestones/25","html_url":"https://github.com/godotengine/godot/milestone/25","labels_url":"https://api.github.com/repos/godotengine/godot/milestones/25/labels","id":15520464,"node_id":"MI_kwDOAO6SJc4A7NLQ","number":25,"title":"4.8","description":"","creator":{"login":"Repiteo","id":17489292,"node_id":"MDQ6VXNlcjE3NDg5Mjky","avatar_url":"https://avatars.githubusercontent.com/u/17489292?v=4","gravatar_id":"","url":"https://api.github.com/users/Repiteo","html_url":"https://github.com/Repiteo","followers_url":"https://api.github.com/users/Repiteo/followers","following_url":"https://api.github.com/users/Repiteo/following{/other_user}","gists_url":"https://api.github.com/users/Repiteo/gists{/gist_id}","starred_url":"https://api.github.com/users/Repiteo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Repiteo/subscriptions","organizations_url":"https://api.github.com/users/Repiteo/orgs","repos_url":"https://api.github.com/users/Repiteo/repos","events_url":"https://api.github.com/users/Repiteo/events{/privacy}","received_events_url":"https://api.github.com/users/Repiteo/received_events","type":"User","user_view_type":"public","site_admin":false},"open_issues":346,"closed_issues":2304,"state":"open","created_at":"2026-04-13T15:59:35Z","updated_at":"2026-10-21T09:34:58Z","due_on":null,"closed_at":null},"comments":7,"created_at":"2025-11-24T18:27:06Z","updated_at":"2026-08-10T16:14:40Z","closed_at":"2026-08-10T16:14:40Z","assignee":null,"author_association":"NONE","issue_field_values":[],"type":null,"active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"### Tested versions\n\nv4.6.dev4.official [bd2ca13]\n\n### System information\n\nlinux\n\n### Issue description\n\nThis is an issue with the display of small textures in the editor across different panels where they are visible.\n\nI haven’t tested this bug in other versions besides v4.6.dev4, but I believe it also occurs in other versions mentioned in #109332. This is also related to that issue specifically concerning texture display errors—i.e., it doesn’t affect the game’s functionality, but it is noticeable in the editor.\n\n### Steps to reproduce\n\nI only tested this on 2x2 textures, but it needs to be checked at what point this stops happening. Generally, I took a .glb model, created a 2x2 texture in Blender that is sufficient for the model to look normal, as this texturing method is commonly used in voxel games. After that, I see this:\n\n<img width=\"688\" height=\"503\" alt=\"Image\" src=\"https://github.com/user-attachments/assets/5b2a74f2-3eed-480d-8baa-44b5d8fa0565\" />\n\n<img width=\"679\" height=\"504\" alt=\"Image\" src=\"https://github.com/user-attachments/assets/5108a6bc-6514-454c-857d-d97f9e5c0a3d\" />\n\n<img width=\"676\" height=\"498\" alt=\"Image\" src=\"https://github.com/user-attachments/assets/f583aa62-c96a-4ac3-af69-8c65670f9de8\" />\n\n<img width=\"676\" height=\"506\" alt=\"Image\" src=\"https://github.com/user-attachments/assets/cb0e0422-d794-4858-b52c-3f9e47f25792\" />\n\n### Minimal reproduction project (MRP)\n\nSince texture display problems occur sporadically, as described in #109332, I don’t think MRP will help. I originally intended to indicate all versions from that issue, but when I tried, for example, version 4.4.1, it looked fine. However, as I described in #109332, version 4.4.1 does have texture display errors, though I still don’t understand why. It’s also noted there that incorrect displays and misplaced duplicates occur. Therefore, I still don’t know why this happens, but it is definitely not a project problem, because I have verified this.\n\nBut we can try to diagnose what it is. I am attaching a project in 4.6 dev4 that contains one texture that displays incorrectly.\n\n[bottle.zip](https://github.com/user-attachments/files/23729495/bottle.zip)\n\n<img width=\"540\" height=\"474\" alt=\"Image\" src=\"https://github.com/user-attachments/assets/d4179a8e-50dc-4f12-b606-4f20d20804c0\" />","closed_by":{"login":"Repiteo","id":17489292,"node_id":"MDQ6VXNlcjE3NDg5Mjky","avatar_url":"https://avatars.githubusercontent.com/u/17489292?v=4","gravatar_id":"","url":"https://api.github.com/users/Repiteo","html_url":"https://github.com/Repiteo","followers_url":"https://api.github.com/users/Repiteo/followers","following_url":"https://api.github.com/users/Repiteo/following{/other_user}","gists_url":"https://api.github.com/users/Repiteo/gists{/gist_id}","starred_url":"https://api.github.com/users/Repiteo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Repiteo/subscriptions","organizations_url":"https://api.github.com/users/Repiteo/orgs","repos_url":"https://api.github.com/users/Repiteo/repos","events_url":"https://api.github.com/users/Repiteo/events{/privacy}","received_events_url":"https://api.github.com/users/Repiteo/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/113121/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/godotengine/godot/issues/113121/timeline","performed_via_github_app":null,"state_reason":"completed","pinned_comment":null}