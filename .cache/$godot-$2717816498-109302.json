ivate_repos":0,"url":"https://api.github.com/users/BastiaanOlij"},"body":"","html_url":"https://github.com/godotengine/godot/pull/109302#pullrequestreview-3118908064","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/109302","author_association":"CONTRIBUTOR","submitted_at":"2025-08-14T05:09:01Z"},{"id":3118925689,"node_id":"PRR_kwDOAO6SJc655wd5","state":"COMMENTED","user":{"site_admin":false,"suspended":false,"updated_at":"0001-01-01T00:00:00Z","avatar_url":"https://avatars.githubusercontent.com/u/1945449?u=96b5dc9be2859dca5f31314c87d99a68a21e1576&v=4","created_at":"0001-01-01T00:00:00Z","followers":0,"following":0,"html_url":"https://github.com/BastiaanOlij","id":1945449,"node_id":"MDQ6VXNlcjE5NDU0NDk=","login":"BastiaanOlij","type":"User","owned_private_repos":0,"public_gists":0,"public_repos":0,"total_private_repos":0,"url":"https://api.github.com/users/BastiaanOlij"},"body":"","html_url":"https://github.com/godotengine/godot/pull/109302#pullrequestreview-3118925689","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/109302","author_association":"CONTRIBUTOR","submitted_at":"2025-08-14T05:13:47Z"},{"id":3137613772,"node_id":"PRR_kwDOAO6SJc67BC_M","state":"COMMENTED","user":{"site_admin":false,"suspended":false,"updated_at":"0001-01-01T00:00:00Z","avatar_url":"https://avatars.githubusercontent.com/u/191561?v=4","created_at":"0001-01-01T00:00:00Z","followers":0,"following":0,"html_url":"https://github.com/dsnopek","id":191561,"node_id":"MDQ6VXNlcjE5MTU2MQ==","login":"dsnopek","type":"User","owned_private_repos":0,"public_gists":0,"public_repos":0,"total_private_repos":0,"url":"https://api.github.com/users/dsnopek"},"body":"Thanks!\r\n\r\nThis is looking really great to me :-)\r\n\r\n> Only outstanding thing is having a decision on whether we keep the `is_promoted` logic or if we just rely on the logic in `get_requested_extensions`.\r\n\r\nThinking about it some more, I would lean toward getting rid of the `is_promoted()` logic. Since it appears to list even extensions we don't provide support for in Godot itself, and the API can be somewhat different between the extension and the promoted version, I could imagine a GDExtension supporting the old extension, and then not working correctly because Godot removed the old extension from the list of requested extensions. Ideally, we'd want a GDExtension built for an old version of Godot (which may have used an old version of OpenXR) to keep working with a newer version. Unless enabling the old extension would actively interfere with Godot's use of the promoted version?\r\n\r\nOne additional thing: We appear to still be using \"palm_pose\" in the \"godot\" action set. Should we add a \"grip_surface_pose\"? Also it would be nice to add \"palm\" or \"grip_surface\" (which ever name we decide to use) to the default suggestions in `XRServer::get_suggested_pose_names()`. (We don't seem to remove the \"_pose\" via `OpenXRInterface::create_action()` like we do with \"aim_pose\" and \"grip_pose\", so the suggestion may need to be \"palm_pose\" or \"grip_surface_pose\".) This is a really important feature of OpenXR 1.1 and we should make it as easy as possible for developers to use it\r\n\r\nFYI, I was able to successfully use `grip_surface` on the Quest 3 with this PR and the latest OpenXR loader! I have never successfully used the palm extension on Quest previously, but now I'm wondering if that was due to using on out-dated loader?","html_url":"https://github.com/godotengine/godot/pull/109302#pullrequestreview-3137613772","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/109302","author_association":"CONTRIBUTOR","submitted_at":"2025-08-20T18:02:25Z"},{"id":3144246663,"node_id":"PRR_kwDOAO6SJc67aWWH","state":"APPROVED","user":{"site_admin":false,"suspended":false,"updated_at":"0001-01-01T00:00:00Z","avatar_url":"https://avatars.githubusercontent.com/u/191561?v=4","created_at":"0001-01-01T00:00:00Z","followers":0,"followin