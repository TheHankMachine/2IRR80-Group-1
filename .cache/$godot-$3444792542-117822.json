tps://avatars.githubusercontent.com/u/96648715?u=af70f5d107e9c1447f296643d5a566dab53d25e8&v=4","created_at":"0001-01-01T00:00:00Z","followers":0,"following":0,"html_url":"https://github.com/AThousandShips","id":96648715,"node_id":"U_kgDOBcK-Cw","login":"AThousandShips","type":"User","owned_private_repos":0,"public_gists":0,"public_repos":0,"total_private_repos":0,"url":"https://api.github.com/users/AThousandShips"},"body":"Style looks good otherwise ","html_url":"https://github.com/godotengine/godot/pull/117822#pullrequestreview-4563739038","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/117822","author_association":"MEMBER","submitted_at":"2026-06-24T15:44:05Z"},{"id":4605822924,"node_id":"PRR_kwDOAO6SJc8AAAABEodHzA","state":"COMMENTED","commit_id":"1ed0eefd2d5ff53da4b9437cb76795b24c4c05d9","user":{"site_admin":false,"suspended":false,"updated_at":"0001-01-01T00:00:00Z","avatar_url":"https://avatars.githubusercontent.com/u/372476?v=4","created_at":"0001-01-01T00:00:00Z","followers":0,"following":0,"html_url":"https://github.com/timothyqiu","id":372476,"node_id":"MDQ6VXNlcjM3MjQ3Ng==","login":"timothyqiu","type":"User","owned_private_repos":0,"public_gists":0,"public_repos":0,"total_private_repos":0,"url":"https://api.github.com/users/timothyqiu"},"body":"Since the description in #116051 is a bit convoluted, let me reword the issue:\n\n> - `locale/fallback` is set to source language `X` (the language in which hardcoded strings are written)\n> - The project only provides translations for language `Y`\n> - The current locale is set to `X`\n>\n> When `X` and `Y` are related (e.g., `fr` and `fr_CA`, `en_GB` and `en_US`, `zh_Hans` and `zh_Hant`), the translation for language `Y` is used directly, rather than the original string.\n\nThis process does not actually involve `locale/fallback`, so skipping `locale/fallback` does not solve this problem.\n\nWhat you need is skipping the whole translation process in this situation I think.","html_url":"https://github.com/godotengine/godot/pull/117822#pullrequestreview-4605822924","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/117822","author_association":"MEMBER","submitted_at":"2026-07-01T04:45:23Z"}]