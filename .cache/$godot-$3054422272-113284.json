[{"id":3519419434,"node_id":"PRR_kwDOAO6SJc7RxhQq","state":"COMMENTED","user":{"site_admin":false,"suspended":false,"updated_at":"0001-01-01T00:00:00Z","avatar_url":"https://avatars.githubusercontent.com/u/96648715?u=af70f5d107e9c1447f296643d5a566dab53d25e8&v=4","created_at":"0001-01-01T00:00:00Z","followers":0,"following":0,"html_url":"https://github.com/AThousandShips","id":96648715,"node_id":"U_kgDOBcK-Cw","login":"AThousandShips","type":"User","owned_private_repos":0,"public_gists":0,"public_repos":0,"total_private_repos":0,"url":"https://api.github.com/users/AThousandShips"},"body":"","html_url":"https://github.com/godotengine/godot/pull/113284#pullrequestreview-3519419434","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/113284","author_association":"MEMBER","submitted_at":"2025-11-28T16:00:04Z"},{"id":3519490308,"node_id":"PRR_kwDOAO6SJc7RxykE","state":"COMMENTED","user":{"site_admin":false,"suspended":false,"updated_at":"0001-01-01T00:00:00Z","avatar_url":"https://avatars.githubusercontent.com/u/61938263?u=9b90963f1b4f17720e50bbbe495fbe8c84c8bc8e&v=4","created_at":"0001-01-01T00:00:00Z","followers":0,"following":0,"html_url":"https://github.com/TokageItLab","id":61938263,"node_id":"MDQ6VXNlcjYxOTM4MjYz","login":"TokageItLab","type":"User","owned_private_repos":0,"public_gists":0,"public_repos":0,"total_private_repos":0,"url":"https://api.github.com/users/TokageItLab"},"body":"","html_url":"https://github.com/godotengine/godot/pull/113284#pullrequestreview-3519490308","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/113284","author_association":"MEMBER","submitted_at":"2025-11-28T16:24:37Z"},{"id":3527411985,"node_id":"PRR_kwDOAO6SJc7SQAkR","state":"APPROVED","commit_id":"8fafdec0736d217d95b95ca56172513ea6408e12","user":{"site_admin":false,"suspended":false,"updated_at":"0001-01-01T00:00:00Z","avatar_url":"https://avatars.githubusercontent.com/u/32321?u=c2e06a3d2b49a467aa907e54aa259516440267cc&v=4","created_at":"0001-01-01T00:00:00Z","followers":0,"following":0,"html_url":"https://github.com/fire","id":32321,"node_id":"MDQ6VXNlcjMyMzIx","login":"fire","type":"User","owned_private_repos":0,"public_gists":0,"public_repos":0,"total_private_repos":0,"url":"https://api.github.com/users/fire"},"body":"Reviewed the math on the twist.\r\n\r\nRegarding the before and after of IK vs BoneTwistDisperser3D, a documentation solution was devised - see relevant comments above.\r\n\r\n@lyuma is also reviewing.\r\n\r\nLooks good to me.","html_url":"https://github.com/godotengine/godot/pull/113284#pullrequestreview-3527411985","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/113284","author_association":"MEMBER","submitted_at":"2025-12-01T22:57:53Z"},{"id":3529037495,"node_id":"PRR_kwDOAO6SJc7SWNa3","state":"APPROVED","user":{"site_admin":false,"suspended":false,"updated_at":"0001-01-01T00:00:00Z","avatar_url":"https://avatars.githubusercontent.com/u/39946030?v=4","created_at":"0001-01-01T00:00:00Z","followers":0,"following":0,"html_url":"https://github.com/lyuma","id":39946030,"node_id":"MDQ6VXNlcjM5OTQ2MDMw","login":"lyuma","type":"User","owned_private_repos":0,"public_gists":0,"public_repos":0,"total_private_repos":0,"url":"https://api.github.com/users/lyuma"},"body":"It looks correct.\r\n\r\nThere are some parts of the design that are unintuitive: notably, BoneTwistDisperser3D is difficult to use on many skeletons unless `extend_end_bone` is true, since otherwise you have to target a child of the target bone.\r\n\r\nAlso I found that it does not function as I would expect when targeting root_bone = Hips (due to Hips having a large origin relative to 0,0,0), but I'm not sure it's wrong, but rather this is mostly a documentation issue.\r\n\r\nExample showing how it can be used for twisting the spine of a character when solving IK for a character's spine.\r\n<img width=\"1920\" height=\"1080\" alt=\"godot_twist_disperser_renik2\" src=\"https://github.com/user-attachments/assets/0297ed06-b834-4de2-b7f5-30ecceae40fb\" />\r\n","html_url":"https://github.com/godotengine/godot/pull/113284#pullrequestreview-3529037495","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/113284","author_association":"CONTRIBUTOR","submitted_at":"2025-12-02T09:13:49Z"},{"id":3520610198,"node_id":"PRR_kwDOAO6SJc7R2D-W","state":"APPROVED","user":{"site_admin":false,"suspended":false,"updated_at":"0001-01-01T00:00:00Z","avatar_url":"https://avatars.githubusercontent.com/u/96648715?u=af70f5d107e9c1447f296643d5a566dab53d25e8&v=4","created_at":"0001-01-01T00:00:00Z","followers":0,"following":0,"html_url":"https://github.com/AThousandShips","id":96648715,"node_id":"U_kgDOBcK-Cw","login":"AThousandShips","type":"User","owned_private_repos":0,"public_gists":0,"public_repos":0,"total_private_repos":0,"url":"https://api.github.com/users/AThousandShips"},"body":"","html_url":"https://github.com/godotengine/godot/pull/113284#pullrequestreview-3520610198","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/113284","author_association":"MEMBER","submitted_at":"2025-12-02T09:53:15Z"},{"id":3529262403,"node_id":"PRR_kwDOAO6SJc7SXEVD","state":"COMMENTED","user":{"site_admin":false,"suspended":false,"updated_at":"0001-01-01T00:00:00Z","avatar_url":"https://avatars.githubusercontent.com/u/61938263?u=9b90963f1b4f17720e50bbbe495fbe8c84c8bc8e&v=4","created_at":"0001-01-01T00:00:00Z","followers":0,"following":0,"html_url":"https://github.com/TokageItLab","id":61938263,"node_id":"MDQ6VXNlcjYxOTM4MjYz","login":"TokageItLab","type":"User","owned_private_repos":0,"public_gists":0,"public_repos":0,"total_private_repos":0,"url":"https://api.github.com/users/TokageItLab"},"body":"","html_url":"https://github.com/godotengine/godot/pull/113284#pullrequestreview-3529262403","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/113284","author_association":"MEMBER","submitted_at":"2025-12-02T10:04:22Z"},{"id":3529323398,"node_