48a&v=4","gravatar_id":"","url":"https://api.github.com/users/Ivorforce","html_url":"https://github.com/Ivorforce","followers_url":"https://api.github.com/users/Ivorforce/followers","following_url":"https://api.github.com/users/Ivorforce/following{/other_user}","gists_url":"https://api.github.com/users/Ivorforce/gists{/gist_id}","starred_url":"https://api.github.com/users/Ivorforce/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Ivorforce/subscriptions","organizations_url":"https://api.github.com/users/Ivorforce/orgs","repos_url":"https://api.github.com/users/Ivorforce/repos","events_url":"https://api.github.com/users/Ivorforce/events{/privacy}","received_events_url":"https://api.github.com/users/Ivorforce/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"Adding a `profiler` option makes sense.\r\nBut, for ease of use, I think `profiler` should be deduced if not explicitly provided, using the previous logic. I really liked that I _didn't_ have to write explicitly which profiler should be used, in addition to the path. Especially, not handling the \"`profiler_path=` set but `profiler=` not set\" case could lead to confusion.","state":"CHANGES_REQUESTED","html_url":"https://github.com/godotengine/godot/pull/113342#pullrequestreview-3526851290","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/113342","author_association":"MEMBER","_links":{"html":{"href":"https://github.com/godotengine/godot/pull/113342#pullrequestreview-3526851290"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/113342"}},"submitted_at":"2025-12-01T20:27:58Z","commit_id":null},{"id":3530155970,"node_id":"PRR_kwDOAO6SJc7SaefC","user":{"login":"Ivorforce","id":2308167,"node_id":"MDQ6VXNlcjIzMDgxNjc=","avatar_url":"https://avatars.githubusercontent.com/u/2308167?u=f7f8e0273f784f5ec6f6b7fe4a88d449896eb48a&v=4","gravatar_id":"","url":"https://api.github.com/users/Ivorforce","html_url":"https://github.com/Ivorforce","followers_url":"https://api.github.com/users/Ivorforce/followers","following_url":"https://api.github.com/users/Ivorforce/following{/other_user}","gists_url":"https://api.github.com/users/Ivorforce/gists{/gist_id}","starred_url":"https://api.github.com/users/Ivorforce/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Ivorforce/subscriptions","organizations_url":"https://api.github.com/users/Ivorforce/orgs","repos_url":"https://api.github.com/users/Ivorforce/repos","events_url":"https://api.github.com/users/Ivorforce/events{/privacy}","received_events_url":"https://api.github.com/users/Ivorforce/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"> I would prefer adding quality of life improvements in the other direction: pass profiler=tracy, and have it automatically find the Tracy SDK in bin/build_deps/tracy downloaded via misc/scripts/download_tracy_sdk.py. profiler_path would remain as an advanced option for folks who want to keep their profiler out of tree (e.g. if they use it for other projects too, or contribute to it, as opposed to just download, build and forget).\r\n\r\nThis might also be nice. In my mind, both would be possible.\r\n\r\n> I won't die on that hill, but I think what I suggest is more in line with how we handle extra build time dependencies currently (mesa-nir-static, ANGLE, Pix, etc.).\r\n\r\nMe neither. Let's go with your suggestion then (handle incorrect states with helpful error messages).\r\n\r\nEdit: Also, this PR needs a rebase now, with #113279 merged, and the instruments case needs to declare `GodotProfileZoneGroupedFirstScript` and `godot_cleanup_profiler`.","state":"COMMENTED","html_url":"https://github.com/godotengine/godot/pull/113342#pullrequestreview-3530155970","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/113342","author_association":"MEMBER","_links":{"html":{"href":"https://github.com/godotengine/godot/pull/113342#pull