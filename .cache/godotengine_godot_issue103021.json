ype":"public","site_admin":false},"open_issues":8,"closed_issues":4466,"state":"closed","created_at":"2024-02-14T11:52:07Z","updated_at":"2026-10-05T23:48:31Z","due_on":"2025-03-03T00:00:00Z","closed_at":"2025-03-19T09:35:35Z"},"comments":2,"created_at":"2025-02-19T00:18:16Z","updated_at":"2025-02-20T07:03:21Z","closed_at":"2025-02-19T22:54:09Z","assignee":null,"author_association":"CONTRIBUTOR","issue_field_values":[],"type":null,"active_lock_reason":null,"draft":false,"pull_request":{"url":"https://api.github.com/repos/godotengine/godot/pulls/103021","html_url":"https://github.com/godotengine/godot/pull/103021","diff_url":"https://github.com/godotengine/godot/pull/103021.diff","patch_url":"https://github.com/godotengine/godot/pull/103021.patch","merged_at":"2025-02-19T22:54:09Z"},"body":"- Fixes #102985\r\n\r\n This PR should fix the startup location of the Embedded Game on Windows.\r\n\r\nI was able to reproduce the issue when using multiple monitors when the main monitor was on the right and when the editor was on the left monitor. \r\n\r\nThe issue was caused by a condition that skipped the offset recalculation when the game was embedded. This error was there since the beginning but was made apparent only since the input queue thread was detached between the editor and the game process, allowing the first game render to display before the editor reposition the game correctly.","closed_by":{"login":"Repiteo","id":17489292,"node_id":"MDQ6VXNlcjE3NDg5Mjky","avatar_url":"https://avatars.githubusercontent.com/u/17489292?v=4","gravatar_id":"","url":"https://api.github.com/users/Repiteo","html_url":"https://github.com/Repiteo","followers_url":"https://api.github.com/users/Repiteo/followers","following_url":"https://api.github.com/users/Repiteo/following{/other_user}","gists_url":"https://api.github.com/users/Repiteo/gists{/gist_id}","starred_url":"https://api.github.com/users/Repiteo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Repiteo/sub