11Z","updated_at":"2026-01-05T12:37:11Z","html_url":"https://github.com/godotengine/godot/pull/114621#discussion_r2661357354","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/114621","_links":{"self":{"href":"https://api.github.com/repos/godotengine/godot/pulls/comments/2661357354"},"html":{"href":"https://github.com/godotengine/godot/pull/114621#discussion_r2661357354"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/114621"}},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/2661357354/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":null,"original_line":487,"side":"RIGHT","author_association":"MEMBER","original_position":5,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/2661521017","pull_request_review_id":3626870246,"id":2661521017,"node_id":"PRRC_kwDOAO6SJc6eo5Z5","diff_hunk":"@@ -484,7 +484,7 @@ void ProjectDialog::_renderer_selected() {\n \tERR_FAIL_NULL(renderer_button_group->get_pressed_button());\n \n \tString renderer_type = renderer_button_group->get_pressed_button()->get_meta(SNAME(\"rendering_method\"));\n-\n+\trendering_device_supported = DisplayServer::is_rendering_device_supported();","path":"editor/project_manager/project_dialog.cpp","commit_id":"7886d10bcfda5cc5341d13ad483fbec7e3fe301c","original_commit_id":"7886d10bcfda5cc5341d13ad483fbec7e3fe301c","user":{"login":"matheusmdx","id":44306054,"node_id":"MDQ6VXNlcjQ0MzA2MDU0","avatar_url":"https://avatars.githubusercontent.com/u/44306054?v=4","gravatar_id":"","url":"https://api.github.com/users/matheusmdx","html_url":"https://github.com/matheusmdx","followers_url":"https://api.github.com/users/matheusmdx/followers","following_url":"https://api.github.com/users/matheusmdx/following{/other_user}","gists_url":"https://api.github.com/users/matheusmdx/gists{/gist_id}","starred_url":"https://api.github.com/users/matheusmdx/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/matheusmdx/subscriptions","organizations_url":"https://api.github.com/users/matheusmdx/orgs","repos_url":"https://api.github.com/users/matheusmdx/repos","events_url":"https://api.github.com/users/matheusmdx/events{/privacy}","received_events_url":"https://api.github.com/users/matheusmdx/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"This function is called when Project Manager appears because the `TRANSLATION_CHANGED` notification so runs before click on anything. About the `DisplayServer::is_rendering_device_supported()` the proper function cache the result in a static variable so the subsequent calls check the result of the first call.\r\n\r\nI tried to put this call on the `show_dialog()` but it didn't worked and analizing now i noticed that didn't worked because the invalid flag was already set and never cleaned. Anyways Kobewi already pointed the correct place to fix, so i'll do it now.","created_at":"2026-01-05T13:35:13Z","updated_at":"2026-01-05T13:35:13Z","html_url":"https://github.com/godotengine/godot/pull/114621#discussion_r2661521017","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/114621","_links":{"self":{"href":"https://api.github.com/repos/godotengine/godot/pulls/comments/2661521017"},"html":{"href":"https://github.com/godotengine/godot/pull/114621#discussion_r2661521017"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/114621"}},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/2661521017/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":null,"original_line":487,"side":"RIGHT","in_reply_to_id":2661357354,"author_association":"CONTRIBUTOR","original