14781\r\n\r\n## Additional information\r\n\r\nAdds a new \"Paste as Unique\" option for nodes within the scene tree dock. This command pastes nodes while duplicating built-in subresources, leaving external resources referenced as usual. Shared built-in resources within the pasted hierarchy continue to be shared through a remapping table, preserving their original relationships while making them independent of the source nodes.\r\n\r\n### Showcase in Editor:\r\n\r\nhttps://github.com/user-attachments/assets/3021d7fd-3371-4b0d-8649-da0d68eabe70\r\n\r\n### AI Disclosure:\r\nThis PR doesn't use AI, it's all human written code & same goes for the desc 🙃","labels":[{"id":73330066,"node_id":"MDU6TGFiZWw3MzMzMDA2Ng==","url":"https://api.github.com/repos/godotengine/godot/labels/enhancement","name":"enhancement","description":"","color":"aaccff","default":true,"archived_at":null,"archived_by":null},{"id":279096997,"node_id":"MDU6TGFiZWwyNzkwOTY5OTc=","url":"https://api.github.com/repos/godotengine/godot/labels/archived","name":"archived","description":"","color":"aaaaaa","default":false,"archived_at":null,"archived_by":null},{"id":279098219,"node_id":"MDU6TGFiZWwyNzkwOTgyMTk=","url":"https://api.github.com/repos/godotengine/godot/labels/topic:editor","name":"topic:editor","description":"","color":"ffee88","default":false,"archived_at":null,"archived_by":null}],"milestone":null,"active_lock_reason":null,"created_at":"2026-07-28T20:21:48Z","updated_at":"2026-08-13T08:21:35Z","closed_at":"2026-08-13T05:25:37Z","merged_at":null,"merge_commit_sha":"74890a9c2f4bd0b1d1d5aee623362de30ca34937","assignee":null,"assignees":[],"requested_reviewers":[],"requested_teams":[],"head":{"label":null,"ref":"paste-as-unique-scene-tree","repo":null,"sha":"a8a1cdc0c1009b57de30586da0ffb14554ed2a1c","user":null},"base":{"label":"godotengine:master","ref":"master","repo":{"id":15634981,"node_id":"MDEwOlJlcG9zaXRvcnkxNTYzNDk4MQ==","name":"godot","full_name":"godotengine/godot","owner":{"login":"godote