[{"id":4492741606,"node_id":"PRR_kwDOAO6SJc8AAAABC8nL5g","state":"COMMENTED","commit_id":"3ab39d33e96ffb655813d1634972d615a456c90e","user":{"site_admin":false,"suspended":false,"updated_at":"0001-01-01T00:00:00Z","avatar_url":"https://avatars.githubusercontent.com/u/115659614?u=814b2fac17e92630bd13d160a49008c7e4cc43fa&v=4","created_at":"0001-01-01T00:00:00Z","followers":0,"following":0,"html_url":"https://github.com/KolYev","id":115659614,"node_id":"U_kgDOBuTTXg","login":"KolYev","type":"User","owned_private_repos":0,"public_gists":0,"public_repos":0,"total_private_repos":0,"url":"https://api.github.com/users/KolYev"},"body":"I found the real root cause. The issue was in `_update_slots_size()` — \n`theme_cache.font_offset` was missing from the `name_size` calculation. \nThis value is subtracted from `text_limit` during label rendering in \n`NOTIFICATION_SORT_CHILDREN`, so without it the available width for \ntwo-digit labels was too narrow.","html_url":"https://github.com/godotengine/godot/pull/120264#pullrequestreview-4492741606","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/120264","author_association":"NONE","submitted_at":"2026-06-14T09:51:35Z"}]