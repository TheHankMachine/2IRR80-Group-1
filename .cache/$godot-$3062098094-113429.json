v=4","created_at":"0001-01-01T00:00:00Z","followers":0,"following":0,"html_url":"https://github.com/blueskythlikesclouds","id":19259897,"node_id":"MDQ6VXNlcjE5MjU5ODk3","login":"blueskythlikesclouds","type":"User","owned_private_repos":0,"public_gists":0,"public_repos":0,"total_private_repos":0,"url":"https://api.github.com/users/blueskythlikesclouds"},"body":"","html_url":"https://github.com/godotengine/godot/pull/113429#pullrequestreview-4973608692","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/113429","author_association":"MEMBER","submitted_at":"2026-08-19T15:03:34Z"},{"id":4974673067,"node_id":"PRR_kwDOAO6SJc8AAAABKIN8qw","state":"COMMENTED","commit_id":"bef5713999d4026da727a1f7bb4473c35d03c3ee","user":{"site_admin":false,"suspended":false,"updated_at":"0001-01-01T00:00:00Z","avatar_url":"https://avatars.githubusercontent.com/u/19259897?u=6ecace2ddb6505607f21e3c41da42157298bd406&v=4","created_at":"0001-01-01T00:00:00Z","followers":0,"following":0,"html_url":"https://github.com/blueskythlikesclouds","id":19259897,"node_id":"MDQ6VXNlcjE5MjU5ODk3","login":"blueskythlikesclouds","type":"User","owned_private_repos":0,"public_gists":0,"public_repos":0,"total_private_repos":0,"url":"https://api.github.com/users/blueskythlikesclouds"},"body":"","html_url":"https://github.com/godotengine/godot/pull/113429#pullrequestreview-4974673067","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/113429","author_association":"MEMBER","submitted_at":"2026-08-19T16:54:01Z"},{"id":4982544932,"node_id":"PRR_kwDOAO6SJc8AAAABKPuaJA","state":"APPROVED","commit_id":"44bc372e716f66d77add2f869209126e9336af29","user":{"site_admin":false,"suspended":false,"updated_at":"0001-01-01T00:00:00Z","avatar_url":"https://avatars.githubusercontent.com/u/19259897?u=6ecace2ddb6505607f21e3c41da42157298bd406&v=4","created_at":"0001-01-01T00:00:00Z","followers":0,"following":0,"html_url":"https://github.com/blueskythlikesclouds","id":19259897,"node_id":"MDQ6VXNlcjE5MjU5ODk3","login":"blueskythlikesclouds","type":"User","owned_private_repos":0,"public_gists":0,"public_repos":0,"total_private_repos":0,"url":"https://api.github.com/users/blueskythlikesclouds"},"body":"Looks great! All my implementation concerns have been addressed and it now works like I wanted it to: self contained and not affecting any of the main rendering systems negatively.\n\nWe should merge this now to get user feedback during the dev/beta period. Any further performance improvements can be done after the merge (I already have some I need to do like the RDG issue), this is already a very good baseline.\n\nI'll let @clayjohn do the final approval.","html_url":"https://github.com/godotengine/godot/pull/113429#pullrequestreview-4982544932","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/113429","author_association":"MEMBER","submitted_at":"2026-08-20T12:12:33Z"},{"id":5037567639,"node_id":"PRR_kwDOAO6SJc8AAAABLEMulw","state":"APPROVED","commit_id":"ed28e815c187da618df04e25b40dabefde42d2ce","user":{"site_admin":false,"suspended":false,"updated_at":"0001-01-01T00:00:00Z","avatar_url":"https://avatars.githubusercontent.com/u/16521339?u=e44a465cbebabb9ea2be80b59e6dc07966bef5b7&v=4","created_at":"0001-01-01T00:00:00Z","followers":0,"following":0,"html_url":"https://github.com/clayjohn","id":16521339,"node_id":"MDQ6VXNlcjE2NTIxMzM5","login":"clayjohn","type":"User","owned_private_repos":0,"public_gists":0,"public_repos":0,"total_private_repos":0,"url":"https://api.github.com/users/clayjohn"},"body":"Amazing work! This is looking really good. Let's get this merged ASAP to get as much testing as possible before stable. \n\nOne thing we need to follow up with before release is adding the `sampler2DStreamed` from [Juan's original proposal](https://github.com/godotengine/godot-proposals/issues/3177#issuecomment-2278832116). I know this technique doesn't do the funky stuff with indexing into texture arrays. But right now the code is hurting performance for every spatial shader, even if no streaming textures are used since streaming is enabled for every shader if the streaming module is enabled. \n\nIf we use `sampler2DStreamed` then we can define `TEXTURE_STREAMING` only for shaders that actually use a `StreamedTexture2D` and avoid paying the cost for streaming in all shaders. \n\nAt any rate, that's fine to do as a follow up so we can get this PR out the door. Again, great work! I am super happy to see this finally cross the finish line","html_url":"https://github.com/godotengine/godot/pull/113429#pullrequestreview-5037567639","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/113429","author_association":"MEMBER","submitted_at":"2026-08-27T05:39:11Z"},{"id":5044872321,"node_id":"PRR_kwDOAO6SJc8AAAABLLKkgQ","state":"COMMENTED","commit_id":"ed28e815c187da618df04e25b40dabefde42d2ce","user":{"site_admin":false,"suspended":false,"updated_at":"0001-01-01T00:00:00Z","avatar_url":"https://avatars.githubusercontent.com/u/2223172?u=fc85633b469acb6e7baef4dba5171f19a2a4ff85&v=4","created_at":"0001-01-01T00:00:00Z","followers":0,"following":0,"html_url":"https://github.com/KoBeWi","id":2223172,"node_id":"MDQ6VXNlcjIyMjMxNzI=","login":"KoBeWi","type":"User","owned_private_repos":0,"public_gists":0,"public_repos":0,"total_private_repos":0,"url":"https://api.github.com/users/KoBeWi"},"body":"","html_url":"https://github.com/godotengine/godot/pull/113429#pullrequestreview-5044872321","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/113429","author_association":"MEMBER","submitted_at":"2026-08-27T19:30:03Z"}]