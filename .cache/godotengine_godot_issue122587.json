id":2666705648,"node_id":"MDU6TGFiZWwyNjY2NzA1NjQ4","url":"https://api.github.com/repos/godotengine/godot/labels/topic:animation","name":"topic:animation","color":"ffee88","default":false,"description":"","archived_at":null,"archived_by":null}],"state":"open","locked":false,"assignees":[],"milestone":{"url":"https://api.github.com/repos/godotengine/godot/milestones/25","html_url":"https://github.com/godotengine/godot/milestone/25","labels_url":"https://api.github.com/repos/godotengine/godot/milestones/25/labels","id":15520464,"node_id":"MI_kwDOAO6SJc4A7NLQ","number":25,"title":"4.8","description":"","creator":{"login":"Repiteo","id":17489292,"node_id":"MDQ6VXNlcjE3NDg5Mjky","avatar_url":"https://avatars.githubusercontent.com/u/17489292?v=4","gravatar_id":"","url":"https://api.github.com/users/Repiteo","html_url":"https://github.com/Repiteo","followers_url":"https://api.github.com/users/Repiteo/followers","following_url":"https://api.github.com/users/Repiteo/following{/other_user}","gists_url":"https://api.github.com/users/Repiteo/gists{/gist_id}","starred_url":"https://api.github.com/users/Repiteo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Repiteo/subscriptions","organizations_url":"https://api.github.com/users/Repiteo/orgs","repos_url":"https://api.github.com/users/Repiteo/repos","events_url":"https://api.github.com/users/Repiteo/events{/privacy}","received_events_url":"https://api.github.com/users/Repiteo/received_events","type":"User","user_view_type":"public","site_admin":false},"open_issues":343,"closed_issues":2335,"state":"open","created_at":"2026-04-13T15:59:35Z","updated_at":"2026-10-22T06:28:22Z","due_on":null,"closed_at":null},"comments":5,"created_at":"2026-08-19T11:34:18Z","updated_at":"2026-09-14T17:01:16Z","closed_at":null,"assignee":null,"author_association":"NONE","issue_field_values":[],"type":null,"active_lock_reason":null,"draft":false,"pull_request":{"url":"https://api.github.com/repos/godotengine/godot/pulls/122587","html_url":"https://github.com/godotengine/godot/pull/122587","diff_url":"https://github.com/godotengine/godot/pull/122587.diff","patch_url":"https://github.com/godotengine/godot/pull/122587.patch","merged_at":null},"body":"### Issue\r\n\r\nThe track order in the Bezier Curve Editor could differ from the\r\nAnimation Track Editor when switching between the two views.\r\n\r\nThe Bezier editor used an RBMap to group tracks by base path. Since\r\nRBMap orders its keys, this could change the display order.\r\n\r\n### Fix\r\n\r\nPreserve the order in which track paths are encountered using a\r\nseparate Vector<String>, while keeping RBMap for grouping the tracks.\r\n\r\nThis keeps the Bezier Curve Editor track order consistent when switching\r\nbetween the Animation Track Editor and Bezier Curve Editor.\r\n\r\n### Testing\r\n\r\nTested with the minimal reproduction project.\r\n\r\nBefore:\r\n- Animation Track Editor and Bezier Curve Editor could show different orders.\r\n\r\nAfter:\r\n- Both editors preserve the same track order when switching between them.\r\n\r\nAI assistance was used to help investigate the issue and discuss the\r\nimplementation. I reviewed and tested the submitted change.\r\n\r\nFixes #122537","closed_by":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/122587/reactions","total_count":1,"+1":0,"-1":0,"laugh":0,"hooray":1,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/godotengine/godot/issues/122587/timeline","performed_via_github_app":null,"state_reason":null}