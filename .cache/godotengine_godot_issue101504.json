":"ffee88","default":false,"description":"","archived_at":null,"archived_by":null},{"id":3240950060,"node_id":"MDU6TGFiZWwzMjQwOTUwMDYw","url":"https://api.github.com/repos/godotengine/godot/labels/performance","name":"performance","color":"447777","default":false,"description":"","archived_at":null,"archived_by":null}],"state":"closed","locked":false,"assignees":[],"milestone":{"url":"https://api.github.com/repos/godotengine/godot/milestones/22","html_url":"https://github.com/godotengine/godot/milestone/22","labels_url":"https://api.github.com/repos/godotengine/godot/milestones/22/labels","id":12070367,"node_id":"MI_kwDOAO6SJc4AuC3f","number":22,"title":"4.5","description":"","creator":{"login":"Sauermann","id":6299227,"node_id":"MDQ6VXNlcjYyOTkyMjc=","avatar_url":"https://avatars.githubusercontent.com/u/6299227?v=4","gravatar_id":"","url":"https://api.github.com/users/Sauermann","html_url":"https://github.com/Sauermann","followers_url":"https://api.github.com/users/Sauermann/followers","following_url":"https://api.github.com/users/Sauermann/following{/other_user}","gists_url":"https://api.github.com/users/Sauermann/gists{/gist_id}","starred_url":"https://api.github.com/users/Sauermann/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Sauermann/subscriptions","organizations_url":"https://api.github.com/users/Sauermann/orgs","repos_url":"https://api.github.com/users/Sauermann/repos","events_url":"https://api.github.com/users/Sauermann/events{/privacy}","received_events_url":"https://api.github.com/users/Sauermann/received_events","type":"User","user_view_type":"public","site_admin":false},"open_issues":3,"closed_issues":3687,"state":"closed","created_at":"2024-12-19T08:51:28Z","updated_at":"2026-09-04T21:48:38Z","due_on":"2025-09-15T00:00:00Z","closed_at":"2025-09-18T17:13:14Z"},"comments":14,"created_at":"2025-01-13T18:45:29Z","updated_at":"2025-07-04T08:24:10Z","closed_at":"2025-03-30T14:06:55Z","assignee":null,"author_association":"MEMBER","issue_field_values":[],"type":null,"active_lock_reason":null,"draft":false,"pull_request":{"url":"https://api.github.com/repos/godotengine/godot/pulls/101504","html_url":"https://github.com/godotengine/godot/pull/101504","diff_url":"https://github.com/godotengine/godot/pull/101504.diff","patch_url":"https://github.com/godotengine/godot/pull/101504.patch","merged_at":"2025-03-30T14:06:55Z"},"body":"This is ready for extensive review but still a work in progress, keeping commits separate to handle transitioning changes and deciding on some more steps in this, but it should be feature complete\r\n\r\nWhat it especially needs is:\r\n* Extensive testing, I've done some basic testing of pathing but haven't tested avoidance or internal details beyond the CI and basic testing, as I don't know the details of most of these systems\r\n* Some further simplification of the 2D code, I've made a number of simplifications based on the change from 3D to 2D (like removing all use of `up`, and removing some cases that are distinctly 3D) but I suspect there might be some areas that still can be simplified now that it is 2D, but would need some further insight and testing\r\n* Opinions on the decisions of restructuring of performance and the moving of the original module, and if `Heap` should instead be put in `servers/navigation`\r\n* Feedback on the tests, see `TODO`s there, and if any specific tests needs to be added or modified\r\n* Placement and potential splitting of settings between 2D and 3D (like debug settings)\r\n\r\nSome additions I didn't make but that could be added, either in this or a follow-up:\r\n* Add an option to disable all navigation, disabling both the modules at once\r\n* Expand the `Triangle2` class to be fully featured and move to core\r\n\r\nOtherwise this is ready for testing, I will start using this in my own projects when I get around to working on them as well\r\n\r\n---\r\n\r\nFor context, currently the 2D navigation system just runs as a frontend for the 3D navigation server, this is not only inefficient and involves a lot of magic to convert it also means that all navigation is unavailable when building without 3D support\r\n\r\n---\r\nTodo:\r\n- [X] Integrate changes from https://github.com/godotengine/godot/pull/101505\r\n\r\n<!--\r\nPlease target the `master` branch in priority.\r\n\r\nRelevant fixes are cherry-picked for stable branches as needed by maintainers.\r\n\r\nTo speed up the contribution process and avoid CI errors, please set up pre-commit hooks locally:\r\nhttps://docs.godotengine.org/en/latest/contributing/development/code_style_guidelines.html\r\n-->\r\n","closed_by":{"login":"Repiteo","id":17489292,"node_id":"MDQ6VXNlcjE3NDg5Mjky","avatar_url":"https://avatars.githubusercontent.com/u/17489292?v=4","gravatar_id":"","url":"https://api.github.com/users/Repiteo","html_url":"https://github.com/Repiteo","followers_url":"https://api.github.com/users/Repiteo/followers","following_url":"https://api.github.com/users/Repiteo/following{/other_user}","gists_url":"https://api.github.com/users/Repiteo/gists{/gist_id}","starred_url":"https://api.github.com/users/Repiteo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Repiteo/subscriptions","organizations_url":"https://api.github.com/users/Repiteo/orgs","repos_url":"https://api.github.com/users/Repiteo/repos","events_url":"https://api.github.com/users/Repiteo/events{/privacy}","received_events_url":"https://api.github.com/users/Repiteo/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/101504/reactions","total_count":30,"+1":19,"-1":0,"laugh":0,"hooray":5,"confused":0,"heart":0,"rocket":3,"eyes":3},"timeline_url":"https://api.github.com/repos/godotengine/godot/issues/101504/timeline","performed_via_github_app":null,"state_reason":null}