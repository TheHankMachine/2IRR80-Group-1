ub.com/ajreckof","followers_url":"https://api.github.com/users/ajreckof/followers","following_url":"https://api.github.com/users/ajreckof/following{/other_user}","gists_url":"https://api.github.com/users/ajreckof/gists{/gist_id}","starred_url":"https://api.github.com/users/ajreckof/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/ajreckof/subscriptions","organizations_url":"https://api.github.com/users/ajreckof/orgs","repos_url":"https://api.github.com/users/ajreckof/repos","events_url":"https://api.github.com/users/ajreckof/events{/privacy}","received_events_url":"https://api.github.com/users/ajreckof/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-07-03T18:50:07Z","updated_at":"2026-07-03T18:50:07Z","body":"> Would you like to rebase this? I want to test it out to see if it fixes #120486 satisfactorily. If so, you should edit the description to say it does.\r\n\r\nI've rebased it. Feel free to test it. If you feel it is not satisfactory feel free to suggest changes to help fix the issue.","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4878744908/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4879266471","html_url":"https://github.com/godotengine/godot/pull/119162#issuecomment-4879266471","issue_url":"https://api.github.com/repos/godotengine/godot/issues/119162","id":4879266471,"node_id":"IC_kwDOAO6SJc8AAAABItOypw","user":{"login":"Synzorasize","id":60207816,"node_id":"MDQ6VXNlcjYwMjA3ODE2","avatar_url":"https://avatars.githubusercontent.com/u/60207816?v=4","gravatar_id":"","url":"https://api.github.com/users/Synzorasize","html_url":"https://github.com/Synzorasize","followers_url":"https://api.github.com/users/Synzorasize/followers","following_url":"ht