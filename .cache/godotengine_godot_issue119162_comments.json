1267,"node_id":"IC_kwDOAO6SJc8AAAABItXBMw","user":{"login":"ajreckof","id":66184050,"node_id":"MDQ6VXNlcjY2MTg0MDUw","avatar_url":"https://avatars.githubusercontent.com/u/66184050?v=4","gravatar_id":"","url":"https://api.github.com/users/ajreckof","html_url":"https://github.com/ajreckof","followers_url":"https://api.github.com/users/ajreckof/followers","following_url":"https://api.github.com/users/ajreckof/following{/other_user}","gists_url":"https://api.github.com/users/ajreckof/gists{/gist_id}","starred_url":"https://api.github.com/users/ajreckof/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/ajreckof/subscriptions","organizations_url":"https://api.github.com/users/ajreckof/orgs","repos_url":"https://api.github.com/users/ajreckof/repos","events_url":"https://api.github.com/users/ajreckof/events{/privacy}","received_events_url":"https://api.github.com/users/ajreckof/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-07-03T21:24:04Z","updated_at":"2026-07-03T21:24:04Z","body":"Yeah sorry I rebased a bit too quick I think it might have broke something. I will try to iron this bug out so that you can test it again.","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4879401267/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null}]