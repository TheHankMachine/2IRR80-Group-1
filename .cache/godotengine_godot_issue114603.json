ription":"","archived_at":null,"archived_by":null},{"id":1332303119,"node_id":"MDU6TGFiZWwxMzMyMzAzMTE5","url":"https://api.github.com/repos/godotengine/godot/labels/regression","name":"regression","color":"ff63ac","default":false,"description":"","archived_at":null,"archived_by":null},{"id":2666705648,"node_id":"MDU6TGFiZWwyNjY2NzA1NjQ4","url":"https://api.github.com/repos/godotengine/godot/labels/topic:animation","name":"topic:animation","color":"ffee88","default":false,"description":"","archived_at":null,"archived_by":null}],"state":"closed","locked":false,"assignees":[],"milestone":{"url":"https://api.github.com/repos/godotengine/godot/milestones/23","html_url":"https://github.com/godotengine/godot/milestone/23","labels_url":"https://api.github.com/repos/godotengine/godot/milestones/23/labels","id":12939969,"node_id":"MI_kwDOAO6SJc4AxXLB","number":23,"title":"4.6","description":"","creator":{"login":"Repiteo","id":17489292,"node_id":"MDQ6VXNlcjE3NDg5Mjky","avatar_url":"https://avatars.githubusercontent.com/u/17489292?v=4","gravatar_id":"","url":"https://api.github.com/users/Repiteo","html_url":"https://github.com/Repiteo","followers_url":"https://api.github.com/users/Repiteo/followers","following_url":"https://api.github.com/users/Repiteo/following{/other_user}","gists_url":"https://api.github.com/users/Repiteo/gists{/gist_id}","starred_url":"https://api.github.com/users/Repiteo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Repiteo/subscriptions","organizations_url":"https://api.github.com/users/Repiteo/orgs","repos_url":"https://api.github.com/users/Repiteo/repos","events_url":"https://api.github.com/users/Repiteo/events{/privacy}","received_events_url":"https://api.github.com/users/Repiteo/received_events","type":"User","user_view_type":"public","site_admin":false},"open_issues":3,"closed_issues":2978,"state":"closed","created_at":"2025-05-22T16:25:52Z","updated_at":"2026-10-04T16:23:23Z","due_on":null,"closed_at":"2026-01-26T18:09:14Z"},"comments":1,"created_at":"2026-01-04T20:20:05Z","updated_at":"2026-01-06T10:04:00Z","closed_at":"2026-01-06T10:03:55Z","assignee":null,"author_association":"CONTRIBUTOR","issue_field_values":[],"type":null,"active_lock_reason":null,"draft":false,"pull_request":{"url":"https://api.github.com/repos/godotengine/godot/pulls/114603","html_url":"https://github.com/godotengine/godot/pull/114603","diff_url":"https://github.com/godotengine/godot/pull/114603.diff","patch_url":"https://github.com/godotengine/godot/pull/114603.patch","merged_at":"2026-01-06T10:03:55Z"},"body":"When implementing https://github.com/godotengine/godot/pull/103416, I missed the case that if the AnimationPlayer was not selected when swapping back to the scene, then `make_visible(true)` would not be called on the `AnimationPlayerEditorPlugin`, meaning that `set_process(true)` would not be called on `AnimationPlayerEditor`, which meant the UI would not update. This fixes the issue by calling `plugin->make_visible(true)` just after the call to `edit`, which ensures the state is identical as when we select the node in the Scene Tree panel (see [`EditorNode::_plugin_over_edit`](https://github.com/godotengine/godot/blob/4036e90a4349740cb86e6245b9e11f38bb436897/editor/editor_node.cpp#L1195-L1205)).\r\n\r\nI also tested and considered just calling `set_process(true)`, but this approach avoids any other potential inconsistencies in how the editor is activated, so I thought it was the more reliable option. Open to thoughts/comments though.\r\n\r\nFixes https://github.com/godotengine/godot/issues/114443","closed_by":{"login":"akien-mga","id":4701338,"node_id":"MDQ6VXNlcjQ3MDEzMzg=","avatar_url":"https://avatars.githubusercontent.com/u/4701338?v=4","gravatar_id":"","url":"https://api.github.com/users/akien-mga","html_url":"https://github.com/akien-mga","followers_url":"https://api.github.com/users/akien-mga/followers","following_url":"https://api.github.com/users/akien-mga/following{/other_user}","gists_u