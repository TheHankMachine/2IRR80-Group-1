lowing script to the camera:\n```\nextends Camera2D\n\n@export var drag_lerp_speed := 30.0\n@export var pan_gesture_speed := 7.0\n\nvar is_held := false\n@onready var target_position := position\n\n\nfunc _unhandled_input(event: InputEvent) -> void:\n\tif event is InputEventMouseButton and event.button_index == MOUSE_BUTTON_LEFT:\n\t\tis_held = event.pressed\n\telif event is InputEventMouseMotion and is_held:\n\t\ttarget_position -= event.relative / zoom\n\telif event is InputEventPanGesture:\n\t\ttarget_position += (event.delta * pan_gesture_speed) / zoom\n\n\nfunc _process(delta: float) -> void:\n\tposition = position.lerp(target_position, drag_lerp_speed * delta)\n```","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4154772501/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4157363141","html_url":"https://github.com/godotengine/godot/issues/116563#issuecomment-4157363141","issue_url":"https://api.github.com/repos/godotengine/godot/issues/116563","id":4157363141,"node_id":"IC_kwDOAO6SJc73zFPF","user":{"login":"stuartcarnie","id":52852,"node_id":"MDQ6VXNlcjUyODUy","avatar_url":"https://avatars.githubusercontent.com/u/52852?v=4","gravatar_id":"","url":"https://api.github.com/users/stuartcarnie","html_url":"https://github.com/stuartcarnie","followers_url":"https://api.github.com/users/stuartcarnie/followers","following_url":"https://api.github.com/users/stuartcarnie/following{/other_user}","gists_url":"https://api.github.com/users/stuartcarnie/gists{/gist_id}","starred_url":"https://api.github.com/users/stuartcarnie/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/stuartcarnie/subscriptions","organizations_url":"https://api.github.com/users/stuartcarnie/orgs","repos_url":"https://api.github.com/users/stuartcarnie/repos","events_url":"https://api.github.com/users/stuartcarnie/events{/privacy}","received_events_url":"https://api.github.com/users/stuartcarnie/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-03-30T18:50:54Z","updated_at":"2026-03-30T18:50:54Z","body":"@Tralexium brilliant – that worked, and I can confirm my fix works. Thanks for the MRP 🔥 ","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4157363141/reactions","total_count":1,"+1":0,"-1":0,"laugh":0,"hooray":1,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null}]