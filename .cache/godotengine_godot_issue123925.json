hived_at":null,"archived_by":null},{"id":283518733,"node_id":"MDU6TGFiZWwyODM1MTg3MzM=","url":"https://api.github.com/repos/godotengine/godot/labels/usability","name":"usability","color":"447744","default":false,"description":"","archived_at":null,"archived_by":null},{"id":1609442062,"node_id":"MDU6TGFiZWwxNjA5NDQyMDYy","url":"https://api.github.com/repos/godotengine/godot/labels/topic:shaders","name":"topic:shaders","color":"ffee88","default":false,"description":"","archived_at":null,"archived_by":null}],"state":"open","locked":false,"assignees":[],"milestone":{"url":"https://api.github.com/repos/godotengine/godot/milestones/16","html_url":"https://github.com/godotengine/godot/milestone/16","labels_url":"https://api.github.com/repos/godotengine/godot/milestones/16/labels","id":8237783,"node_id":"MI_kwDOAO6SJc4AfbLX","number":16,"title":"4.x","description":"Issues and pull requests slated for an undetermined Godot 4 release.","creator":{"login":"akien-mga","id":4701338,"node_id":"MDQ6VXNlcjQ3MDEzMzg=","avatar_url":"https://avatars.githubusercontent.com/u/4701338?v=4","gravatar_id":"","url":"https://api.github.com/users/akien-mga","html_url":"https://github.com/akien-mga","followers_url":"https://api.github.com/users/akien-mga/followers","following_url":"https://api.github.com/users/akien-mga/following{/other_user}","gists_url":"https://api.github.com/users/akien-mga/gists{/gist_id}","starred_url":"https://api.github.com/users/akien-mga/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/akien-mga/subscriptions","organizations_url":"https://api.github.com/users/akien-mga/orgs","repos_url":"https://api.github.com/users/akien-mga/repos","events_url":"https://api.github.com/users/akien-mga/events{/privacy}","received_events_url":"https://api.github.com/users/akien-mga/received_events","type":"User","user_view_type":"public","site_admin":false},"open_issues":5790,"closed_issues":0,"state":"open","created_at":"2022-07-26T12:42:05Z","updated_at":"2026-10-22T08:16:48Z","due_on":null,"closed_at":null},"comments":4,"created_at":"2026-09-28T14:24:33Z","updated_at":"2026-10-15T05:40:09Z","closed_at":null,"assignee":null,"author_association":"MEMBER","issue_field_values":[],"type":null,"active_lock_reason":null,"draft":false,"pull_request":{"url":"https://api.github.com/repos/godotengine/godot/pulls/123925","html_url":"https://github.com/godotengine/godot/pull/123925","diff_url":"https://github.com/godotengine/godot/pull/123925.diff","patch_url":"https://github.com/godotengine/godot/pull/123925.patch","merged_at":null},"body":"Follow-up to #99404. This could be split if desired, but the adjustments go with each other (the stack cue requires the new border color to be actually visible).\r\n\r\n<img width=\"1096\" height=\"426\" alt=\"compare\" src=\"https://github.com/user-attachments/assets/63a14979-1138-49fc-827c-31e792eadcbe\" />\r\n\r\n\r\n# Detailed changes\r\n\r\n- Node groups UI:\r\n\t- Reworked the appearance of node group instances \r\n\t\t- Removed the \"Edit\" button in the header; editing groups can now be performed (1.) by double-clicking it (or double-tapping on touch devices) and (2.) by the respective item in the context menu\r\n\t\t- The group resource picker has more width to display the group resource file name (removed the redundant label in front)\r\n\t\t- Node groups now have a fading frame/card stack drawn below them as a visual cue. (shamelessly stolen from blender, but I evaluated a few cues and this just works the best - it's almost as if someone actually thought this through ;))\r\n\t\t- The node group icon is no longer displayed in the header (group name gets more space and the icon is already displayed in the resource picker below)\r\n- The background/border color of graph nodes was darker than the background which always felt a bit odd, especially since the property editors use the same colors as in the inspector. There is no reason to be different here compared to e.g. Unity's ShaderGraph or Blender, so I adjusted that. It now uses the surface base color, just like the inspector. Light mode is adjusted accordingly and the classic theme only gets the new border color (see screenshots in appendix below).\r\n- Cleaned up the VisualShaderGroup.svg which contained a few icon prototypes outside the viewbox.\r\n\r\n<details>\r\n<summary><h3>Appendix</h3></summary>\r\nLight mode:\r\n\r\n<br>\r\n<img width=\"248\" height=\"291\" alt=\"godot windows editor dev x86_64_UowA0XaPiC\" src=\"https://github.com/user-attachments/assets/9df40e53-e920-44f8-8526-11c8a44b7434\" />\r\n\r\nDark mode, zoom 50%\r\n\r\n\r\n<img width=\"489\" height=\"575\" alt=\"{339D3689-A6C3-474A-A14C-B0B49034D190}\" src=\"https://github.com/user-attachments/assets/aab2fa19-0882-4b40-97b6-7961e2997f5e\" />\r\n\r\n\r\nDark mode (classic style):\r\n\r\n<img width=\"715\" height=\"994\" alt=\"{6144C6F2-4485-4689-B83A-9F970B5C0E0E}\" src=\"https://github.com/user-attachments/assets/19b54614-cac2-4604-9fdb-4e2fbc7016aa\" />\r\n\r\n\r\n</details>\r\n","closed_by":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/123925/reactions","total_count":30,"+1":15,"-1":0,"laugh":1,"hooray":0,"confused":0,"heart":14,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/godotengine/godot/issues/123925/timeline","performed_via_github_app":null,"state_reason":null}