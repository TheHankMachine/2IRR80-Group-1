\"] + \"-\" + env[\"arch\"] + \"-macos\"\n+            print(angle_path)\n+            if os.path.exists(angle_path):\n+                env.Prepend(CPPPATH=[\"#thirdparty/angle/include\"])\n+                env.AppendUnique(CPPDEFINES=[\"ANGLE_ENABLED\", \"EGL_STATIC\"])\n+                env.Append(LINKFLAGS=[\"-L\" + angle_path])\n+                env.Append(LINKFLAGS=[\"-lANGLE.macos.\" + env[\"arch\"]])\n+                env.Append(LINKFLAGS=[\"-lEGL.macos.\" + env[\"arch\"]])\n+                env.Append(LINKFLAGS=[\"-lGLES.macos.\" + env[\"arch\"]])\n+            else:\n+                print_warning(\n+                    \"The ANGLE rendering driver requires dependencies to be installed.\\n\"\n+                    f\"You can install them by running `python {os.path.join('misc', 'scripts', 'install_`angle.py')}`.\\n\"","path":"platform/macos/detect.py","commit_id":"b6b3e592c2f574f515917bf025cb22ecf5c56d2b","original_commit_id":"b6b3e592c2f574f515917bf025cb22ecf5c56d2b","user":{"login":"Calinou","id":180032,"node_id":"MDQ6VXNlcjE4MDAzMg==","avatar_url":"https://avatars.githubusercontent.com/u/180032?v=4","gravatar_id":"","url":"https://api.github.com/users/Calinou","html_url":"https://github.com/Calinou","followers_url":"https://api.github.com/users/Calinou/followers","following_url":"https://api.github.com/users/Calinou/following{/other_user}","gists_url":"https://api.github.com/users/Calinou/gists{/gist_id}","starred_url":"https://api.github.com/users/Calinou/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Calinou/subscriptions","organizations_url":"https://api.github.com/users/Calinou/orgs","repos_url":"https://api.github.com/users/Calinou/repos","events_url":"https://api.github.com/users/Calinou/events{/privacy}","received_events_url":"https://api.github.com/users/Calinou/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"Typo:\n\n```suggestion\n                    f\"You can install them by runni