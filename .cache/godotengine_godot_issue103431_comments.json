[{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2692332997","html_url":"https://github.com/godotengine/godot/issues/103431#issuecomment-2692332997","issue_url":"https://api.github.com/repos/godotengine/godot/issues/103431","id":2692332997,"node_id":"IC_kwDOAO6SJc6geb3F","user":{"login":"bruvzg","id":7645683,"node_id":"MDQ6VXNlcjc2NDU2ODM=","avatar_url":"https://avatars.githubusercontent.com/u/7645683?v=4","gravatar_id":"","url":"https://api.github.com/users/bruvzg","html_url":"https://github.com/bruvzg","followers_url":"https://api.github.com/users/bruvzg/followers","following_url":"https://api.github.com/users/bruvzg/following{/other_user}","gists_url":"https://api.github.com/users/bruvzg/gists{/gist_id}","starred_url":"https://api.github.com/users/bruvzg/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/bruvzg/subscriptions","organizations_url":"https://api.github.com/users/bruvzg/orgs","repos_url":"https://api.github.com/users/bruvzg/repos","events_url":"https://api.github.com/users/bruvzg/events{/privacy}","received_events_url":"https://api.github.com/users/bruvzg/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-03-01T17:37:36Z","updated_at":"2025-03-01T17:39:31Z","body":"That's two different tags, `font` and `font_size`. Closing tag should be the same as opening tag.\n\n`[font size=34]Hello[/font size]` - opening tag is `font`, with optional `size=` argument, closing tag is invalid.\n`[font size=34]Hello[/font_size]` - opening tag is `font`, closing tag mismatching `font_size`.\n\n`font` tag can have multiple options in any order, not just `size` - see [Font options](https://docs.godotengine.org/en/stable/tutorials/ui/bbcode_in_richtextlabel.html#doc-bbcode-in-richtextlabel-font-options).","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2692332997/reactions","total_count":0,"+1":0,"-1":0,"laug