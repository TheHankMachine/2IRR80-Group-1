_by":null}],"state":"closed","locked":false,"assignees":[],"milestone":{"url":"https://api.github.com/repos/godotengine/godot/milestones/22","html_url":"https://github.com/godotengine/godot/milestone/22","labels_url":"https://api.github.com/repos/godotengine/godot/milestones/22/labels","id":12070367,"node_id":"MI_kwDOAO6SJc4AuC3f","number":22,"title":"4.5","description":"","creator":{"login":"Sauermann","id":6299227,"node_id":"MDQ6VXNlcjYyOTkyMjc=","avatar_url":"https://avatars.githubusercontent.com/u/6299227?v=4","gravatar_id":"","url":"https://api.github.com/users/Sauermann","html_url":"https://github.com/Sauermann","followers_url":"https://api.github.com/users/Sauermann/followers","following_url":"https://api.github.com/users/Sauermann/following{/other_user}","gists_url":"https://api.github.com/users/Sauermann/gists{/gist_id}","starred_url":"https://api.github.com/users/Sauermann/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Sauermann/subscriptions","organizations_url":"https://api.github.com/users/Sauermann/orgs","repos_url":"https://api.github.com/users/Sauermann/repos","events_url":"https://api.github.com/users/Sauermann/events{/privacy}","received_events_url":"https://api.github.com/users/Sauermann/received_events","type":"User","user_view_type":"public","site_admin":false},"open_issues":3,"closed_issues":3687,"state":"closed","created_at":"2024-12-19T08:51:28Z","updated_at":"2026-09-04T21:48:38Z","due_on":"2025-09-15T00:00:00Z","closed_at":"2025-09-18T17:13:14Z"},"comments":3,"created_at":"2024-12-28T19:05:04Z","updated_at":"2026-02-07T12:34:48Z","closed_at":"2025-03-13T14:04:11Z","assignee":null,"author_association":"CONTRIBUTOR","issue_field_values":[],"type":null,"active_lock_reason":null,"draft":false,"pull_request":{"url":"https://api.github.com/repos/godotengine/godot/pulls/100877","html_url":"https://github.com/godotengine/godot/pull/100877","diff_url":"https://github.com/godotengine/godot/pull/100877.diff","patch_url":"https://github.com/godotengine/godot/pull/100877.patch","merged_at":"2025-03-13T14:04:11Z"},"body":"There were many instances where either `EditorNode::load_scene()`/`open_request()` or `load_resource()` was called depending on if the file was a `PackedScene` or not. This PR is meant to simplify those cases and make the `PackedScene` checks more consistent. This also led to some minor bug fixes related to reopening closed scene tabs with the `Ctrl+Shift+T` command.\r\n\r\n### Add `EditorNode::load_scene_or_resource()`\r\n\r\n\r\nI was unsure if I should add this new function, or instead allow `load_resource()` to load scenes as well (instead of simply inspecting the `PackedScene` resource). Additionally, `load_resource()` could then have a new parameter `p_open_if_scene`, deciding between opening or inspecting.\r\n\r\n### Remove `EditorNode::open_request()`\r\n`open_request()` did two things:\r\n1. Remove scene from previous scenes list.\r\n2. Call `load_scene()`.\r\n\r\nThis meant that directly calling `load_scene()` would not update the previous scenes history. I removed `open_request()` and moved the updating of previous scenes  to `load_scene()` instead.\r\n\r\n### Refactor previous scenes logic\r\n\r\n- Rename related variables/functions to `prev_closed_scenes` to differentiate from `recent_scenes`.\r\n- Enable or disable `FILE_OPEN_PREV` menu_item/shortcut directly when updating previous scene list (instead of just after opening/closing the Scene menu.\r\n- Remove `opening_prev` member variable. It has no purpose and just caused clutter by setting it to `false` everywhere.","closed_by":{"login":"Repiteo","id":17489292,"node_id":"MDQ6VXNlcjE3NDg5Mjky","avatar_url":"https://avatars.githubusercontent.com/u/17489292?v=4","gravatar_id":"","url":"https://api.github.com/users/Repiteo","html_url":"https://github.com/Repiteo","followers_url":"https://api.github.com/users/Repiteo/followers","following_url":"https://api.github.com/users/Repiteo/following{/other_user}","gists_url":"https://api.github.com/users/Repiteo/gists{/gist_id}","starred_url":"https://api.github.com/users/Repiteo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Repiteo/subscriptions","organizations_url":"https://api.github.com/users/Repiteo/orgs","repos_url":"https://api.github.com/users/Repiteo/repos","events_url":"https://api.github.com/users/Repiteo/events{/privacy}","received_events_url":"https://api.github.com/users/Repiteo/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/100877/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/godotengine/godot/issues/100877/timeline","performed_via_github_app":null,"state_reason":null}