_url":"https://api.github.com/users/wokeraccoon/following{/other_user}","gists_url":"https://api.github.com/users/wokeraccoon/gists{/gist_id}","starred_url":"https://api.github.com/users/wokeraccoon/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/wokeraccoon/subscriptions","organizations_url":"https://api.github.com/users/wokeraccoon/orgs","repos_url":"https://api.github.com/users/wokeraccoon/repos","events_url":"https://api.github.com/users/wokeraccoon/events{/privacy}","received_events_url":"https://api.github.com/users/wokeraccoon/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-03-08T21:43:56Z","updated_at":"2025-03-08T21:43:56Z","body":"Tested this again with the Compatibility renderer in Windows, now it shows the border decorations (the behavior I was expecting from the beginning in MacOS)\n\n![Image](https://github.com/user-attachments/assets/671c7192-d495-43b7-a06e-3426aaaf3cf4)","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2708498136/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2708498244","html_url":"https://github.com/godotengine/godot/issues/103658#issuecomment-2708498244","issue_url":"https://api.github.com/repos/godotengine/godot/issues/103658","id":2708498244,"node_id":"IC_kwDOAO6SJc6hcGdE","user":{"login":"bruvzg","id":7645683,"node_id":"MDQ6VXNlcjc2NDU2ODM=","avatar_url":"https://avatars.githubusercontent.com/u/7645683?v=4","gravatar_id":"","url":"https://api.github.com/users/bruvzg","html_url":"https://github.com/bruvzg","followers_url":"https://api.github.com/users/bruvzg/followers","following_url":"https://api.github.com/users/bruvzg/following{/other_user}","gists_url":"https://api.github.com/users/bruvzg/gists{/gist_id}