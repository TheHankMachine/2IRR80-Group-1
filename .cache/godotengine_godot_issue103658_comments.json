m/users/bruvzg/following{/other_user}","gists_url":"https://api.github.com/users/bruvzg/gists{/gist_id}","starred_url":"https://api.github.com/users/bruvzg/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/bruvzg/subscriptions","organizations_url":"https://api.github.com/users/bruvzg/orgs","repos_url":"https://api.github.com/users/bruvzg/repos","events_url":"https://api.github.com/users/bruvzg/events{/privacy}","received_events_url":"https://api.github.com/users/bruvzg/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-03-08T21:34:15Z","updated_at":"2025-03-08T21:34:15Z","body":"In case of macOS, this limitation is artificial, and only added to match Windows behavior (It is not possible to keep normal window decorations for transparent window on Windows). So it technically can be changed, but usually features are implemented to work the same on all platform.","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2708495548/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2708497152","html_url":"https://github.com/godotengine/godot/issues/103658#issuecomment-2708497152","issue_url":"https://api.github.com/repos/godotengine/godot/issues/103658","id":2708497152,"node_id":"IC_kwDOAO6SJc6hcGMA","user":{"login":"wokeraccoon","id":13603525,"node_id":"MDQ6VXNlcjEzNjAzNTI1","avatar_url":"https://avatars.githubusercontent.com/u/13603525?v=4","gravatar_id":"","url":"https://api.github.com/users/wokeraccoon","html_url":"https://github.com/wokeraccoon","followers_url":"https://api.github.com/users/wokeraccoon/followers","following_url":"https://api.github.com/users/wokeraccoon/following{/other_user}","gists_url":"https://api.github.com/users/wokeraccoon/gists{/gist_id