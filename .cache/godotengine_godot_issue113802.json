cription":"","archived_at":null,"archived_by":null}],"state":"closed","locked":false,"assignees":[],"milestone":{"url":"https://api.github.com/repos/godotengine/godot/milestones/23","html_url":"https://github.com/godotengine/godot/milestone/23","labels_url":"https://api.github.com/repos/godotengine/godot/milestones/23/labels","id":12939969,"node_id":"MI_kwDOAO6SJc4AxXLB","number":23,"title":"4.6","description":"","creator":{"login":"Repiteo","id":17489292,"node_id":"MDQ6VXNlcjE3NDg5Mjky","avatar_url":"https://avatars.githubusercontent.com/u/17489292?v=4","gravatar_id":"","url":"https://api.github.com/users/Repiteo","html_url":"https://github.com/Repiteo","followers_url":"https://api.github.com/users/Repiteo/followers","following_url":"https://api.github.com/users/Repiteo/following{/other_user}","gists_url":"https://api.github.com/users/Repiteo/gists{/gist_id}","starred_url":"https://api.github.com/users/Repiteo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Repiteo/subscriptions","organizations_url":"https://api.github.com/users/Repiteo/orgs","repos_url":"https://api.github.com/users/Repiteo/repos","events_url":"https://api.github.com/users/Repiteo/events{/privacy}","received_events_url":"https://api.github.com/users/Repiteo/received_events","type":"User","user_view_type":"public","site_admin":false},"open_issues":3,"closed_issues":2978,"state":"closed","created_at":"2025-05-22T16:25:52Z","updated_at":"2026-10-04T16:23:23Z","due_on":null,"closed_at":"2026-01-26T18:09:14Z"},"comments":5,"created_at":"2025-12-09T13:32:52Z","updated_at":"2026-01-08T22:58:26Z","closed_at":"2025-12-11T00:17:04Z","assignee":null,"author_association":"MEMBER","issue_field_values":[],"type":null,"active_lock_reason":null,"draft":false,"pull_request":{"url":"https://api.github.com/repos/godotengine/godot/pulls/113802","html_url":"https://github.com/godotengine/godot/pull/113802","diff_url":"https://github.com/godotengine/godot/pull/113802.diff","patch_url":"https://github.com/godotengine/godot/pull/113802.patch","merged_at":"2025-12-11T00:17:04Z"},"body":"Let's see if we finally get a functional and reliable `CommandQueueMT`.\r\n\r\nIn order to allow `_flush()` to be called from multiple threads, we were considering making the mutex recursive. However, even after removing the unlock allowance logic that is indeed not needed here, there's still some condition variable logic that needs the mutex to be binary.\r\n\r\nIn the end, I've simply added a thread-local variable for the current thread to know if it should attempt to lock.\r\n\r\nMoreover, loosely related to re-entrancy, in the case of another thread requesting a flush while another thread performing one, I've added code so the former waits for the latter. Otherwise, we would be breaking the assumption that after calling a flush function all the commands added up to that point have been run.\r\n\r\n☣ Disclaimer: untested. ☣\r\n\r\nCC @brycehutchings\r\n\r\nFixes #113627.","closed_by":{"login":"Repiteo","id":17489292,"node_id":"MDQ6VXNlcjE3NDg5Mjky","avatar_url":"https://avatars.githubusercontent.com/u/17489292?v=4","gravatar_id":"","url":"https://api.github.com/users/Repiteo","html_url":"https://github.com/Repiteo","followers_url":"https://api.github.com/users/Repiteo/followers","following_url":"https://api.github.com/users/Repiteo/following{/other_user}","gists_url":"https://api.github.com/users/Repiteo/gists{/gist_id}","starred_url":"https://api.github.com/users/Repiteo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Repiteo/subscriptions","organizations_url":"https://api.github.com/users/Repiteo/orgs","repos_url":"https://api.github.com/users/Repiteo/repos","events_url":"https://api.github.com/users/Repiteo/events{/privacy}","received_events_url":"https://api.github.com/users/Repiteo/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/113802/reactions","total_count":3,"+1":3,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/godotengine/godot/issues/113802/timeline","performed_via_github_app":null,"state_reason":null}