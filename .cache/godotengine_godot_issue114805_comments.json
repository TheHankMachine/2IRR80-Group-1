24260","html_url":"https://github.com/godotengine/godot/issues/114805#issuecomment-3733324260","issue_url":"https://api.github.com/repos/godotengine/godot/issues/114805","id":3733324260,"node_id":"IC_kwDOAO6SJc7ehgHk","user":{"login":"AviseOffical","id":113899383,"node_id":"U_kgDOBsn3dw","avatar_url":"https://avatars.githubusercontent.com/u/113899383?v=4","gravatar_id":"","url":"https://api.github.com/users/AviseOffical","html_url":"https://github.com/AviseOffical","followers_url":"https://api.github.com/users/AviseOffical/followers","following_url":"https://api.github.com/users/AviseOffical/following{/other_user}","gists_url":"https://api.github.com/users/AviseOffical/gists{/gist_id}","starred_url":"https://api.github.com/users/AviseOffical/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/AviseOffical/subscriptions","organizations_url":"https://api.github.com/users/AviseOffical/orgs","repos_url":"https://api.github.com/users/AviseOffical/repos","events_url":"https://api.github.com/users/AviseOffical/events{/privacy}","received_events_url":"https://api.github.com/users/AviseOffical/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-01-10T18:06:55Z","updated_at":"2026-01-10T18:06:55Z","body":"[FIX]\n\nInput_Debouncer.gd\n```\nextends Node\n\n@export var input_buffer_time: float = 0.04\n\nvar _last_confirmed_vector: Dictionary = {} # Stores buffered vectors by name\nvar _buffer_timers: Dictionary = {}\n\nfunc _physics_process(delta: float) -> void:\n\t# This manager updates every physics frame to keep buffers in sync with states\n\tfor map_name in _buffer_timers.keys():\n\t\t_buffer_timers[map_name] += delta\n\nfunc get_buffered_vector(neg_x: String, pos_x: String, neg_y: String, pos_y: String) -> Vector2:\n\tvar id = neg_x + pos_x + neg_y + pos_y\n\tvar raw_input = Input.get_vector(neg_x, pos_x, neg_y, pos_y)\n\t\n\t# Initialize if not present\n\tif not _last_confirmed_vector.has(id):\n\t\t_last_confirmed_vector[id] = Vector2.ZERO\n\t\t_buffer_timers[id] = 0.0\n\t\n\t# 1. Instant Spam Bypass\n\tif raw_input != Vector2.ZERO and (raw_input == _last_confirmed_vector[id] or _last_confirmed_vector[id] == Vector2.ZERO):\n\t\t_last_confirmed_vector[id] = raw_input\n\t\t_buffer_timers[id] = 0.0\n\t\treturn raw_input\n\t\n\t# 2. Diagonal Buffer\n\telif raw_input != _last_confirmed_vector[id] and raw_input != Vector2.ZERO:\n\t\tif _buffer_timers[id] < input_buffer_time:\n\t\t\treturn _last_confirmed_vector[id] # Return previous until buffer clears\n\t\telse:\n\t\t\t_last_confirmed_vector[id] = raw_input\n\t\t\treturn raw_input\n\t\n\t# 3. Release/Idle\n\telse:\n\t\t_buffer_timers[id] = 0.0\n\t\tif raw_input == Vector2.ZERO:\n\t\t\t_last_confirmed_vector[id] = Vector2.ZERO\n\t\treturn raw_input\n```","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3733324260/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null}]