[{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3407840373","html_url":"https://github.com/godotengine/godot/issues/111689#issuecomment-3407840373","issue_url":"https://api.github.com/repos/godotengine/godot/issues/111689","id":3407840373,"node_id":"IC_kwDOAO6SJc7LH4R1","user":{"login":"AThousandShips","id":96648715,"node_id":"U_kgDOBcK-Cw","avatar_url":"https://avatars.githubusercontent.com/u/96648715?v=4","gravatar_id":"","url":"https://api.github.com/users/AThousandShips","html_url":"https://github.com/AThousandShips","followers_url":"https://api.github.com/users/AThousandShips/followers","following_url":"https://api.github.com/users/AThousandShips/following{/other_user}","gists_url":"https://api.github.com/users/AThousandShips/gists{/gist_id}","starred_url":"https://api.github.com/users/AThousandShips/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/AThousandShips/subscriptions","organizations_url":"https://api.github.com/users/AThousandShips/orgs","repos_url":"https://api.github.com/users/AThousandShips/repos","events_url":"https://api.github.com/users/AThousandShips/events{/privacy}","received_events_url":"https://api.github.com/users/AThousandShips/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-10-15T18:58:57Z","updated_at":"2025-10-15T18:58:57Z","body":"As far as I know the function key isn't actually a real key for the internal systems, it instead emulates another key","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3407840373/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3407858203","html_url":"https://github.com/godotengine/godot/issues/111689#issuecomment-3407858203","issue_url":"https://api.github.com/repos/godotengine/godot/issues/111689","id":3407858203,"node_id":"IC_kwDOAO6SJc7LH8ob","user":{"login":"bruvzg","id":7645683,"node_id":"MDQ6VXNlcjc2NDU2ODM=","avatar_url":"https://avatars.githubusercontent.com/u/7645683?v=4","gravatar_id":"","url":"https://api.github.com/users/bruvzg","html_url":"https://github.com/bruvzg","followers_url":"https://api.github.com/users/bruvzg/followers","following_url":"https://api.github.com/users/bruvzg/following{/other_user}","gists_url":"https://api.github.com/users/bruvzg/gists{/gist_id}","starred_url":"https://api.github.com/users/bruvzg/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/bruvzg/subscriptions","organizations_url":"https://api.github.com/users/bruvzg/orgs","repos_url":"https://api.github.com/users/bruvzg/repos","events_url":"https://api.github.com/users/bruvzg/events{/privacy}","received_events_url":"https://api.github.com/users/bruvzg/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-10-15T19:04:52Z","updated_at":"2025-10-15T19:04:52Z","body":"`Fn` is not a real key and do not produce events, but combinations with it should have modifier flag set, so it's probably possible to detect.\n\nNote: this only applies to `Fn` key on built-in MacBook keyboards (and maybe Apple keyboards), `Fn` key on most third-party keyboards is handled by the keyboard itself and is not detectable.","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3407858203/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3408102630","html_url":"https://github.com/godotengine/godot/issues/111689#issuecomment-3408102630","issue_url":"https://api.github.com/repos/godotengine/godot/issues/111689","id":3408102630,"node_id":"IC_kwDOAO6SJc7LI4Tm","user":{"login":"bruvzg","id":7645683,"node_id":"MDQ6VXNlcjc2NDU2ODM=","avatar_url":"https://avatars.githubusercontent.com/u/7645683?v=4","gravatar_id":"","url":"https://api.github.com/users/bruvzg","html_url":"https://github.com/bruvzg","followers_url":"https://api.github.com/users/bruvzg/followers","following_url":"https://api.github.com/users/bruvzg/following{/other_user}","gists_url":"https://api.github.com/users/bruvzg/gists{/gist_id}","starred_url":"https://api.github.com/users/bruvzg/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/bruvzg/subscriptions","organizations_url":"https://api.github.com/users/bruvzg/orgs","repos_url":"https://api.github.com/users/bruvzg/repos","events_url":"https://api.github.com/users/bruvzg/events{/privacy}","received_events_url":"https://api.github.com/users/bruvzg/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-10-15T20:16:16Z","updated_at":"2025-10-15T20:25:49Z","body":"> but combinations with it should have modifier flag set, so it's probably possible to detect.\n\nIt is, so it is possible to add support for it. We have two completely unused modifier flags `KPAD` and `GROUP_SWITCH`, so one of this can be repurposed as `Fn` without breaking changes.","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3408102630/reactions","total_count":1,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":1},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3507645592","html_url":"https://github.com/godotengine/godot/issues/111689#issuecomment-3507645592","issue_url":"https://api.github.com/repos/godotengine/godot/issues/111689","id":3507645592,"node_id":"IC_kwDOAO6SJc7REmyY","user":{"login":"jason-cahill","id":49805405,"node_id":"MDQ6VXNlcjQ5ODA1NDA1","avatar_url":"https://avatars.githubusercontent.com/u/49805405?v=4","gravatar_id":"","url":"https://api.github.com/users/jason-cahill","html_url":"https://github.com/jason-cahill","followers_url":"https://api.github.com/users/jason-cahill/followers","following_url":"https://api.github.com/users/jason-cahill/following{/other_user}","gists_url":"https://api.github.com/users/jason-cahill/gists{/gist_id}","starred_url":"https://api.github.com/users/jason-cahill/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/jason-cahill/subscriptions","organizations_url":"https://api.github.com/users/jason-cahill/orgs","repos_url":"https://api.github.com/users/jason-cahill/repos","events_url":"https://api.github.com/users/jason-cahill/events{/privacy}","received_events_url":"https://api.github.com/users/jason-cahill/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-11-09T08:09:11Z","updated_at":"2025-11-09T08:09:11Z","body":"I have verified that if a user on MacOS types Fn + Left Arrow, then KEY_HOME is correctly sent. So, some of the mappings you might want to catch are already handled on behalf of the OS to Godot.","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3507645592/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null}]