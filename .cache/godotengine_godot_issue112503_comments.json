c5ODc=","avatar_url":"https://avatars.githubusercontent.com/u/9957987?v=4","gravatar_id":"","url":"https://api.github.com/users/Meorge","html_url":"https://github.com/Meorge","followers_url":"https://api.github.com/users/Meorge/followers","following_url":"https://api.github.com/users/Meorge/following{/other_user}","gists_url":"https://api.github.com/users/Meorge/gists{/gist_id}","starred_url":"https://api.github.com/users/Meorge/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Meorge/subscriptions","organizations_url":"https://api.github.com/users/Meorge/orgs","repos_url":"https://api.github.com/users/Meorge/repos","events_url":"https://api.github.com/users/Meorge/events{/privacy}","received_events_url":"https://api.github.com/users/Meorge/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-11-07T16:23:16Z","updated_at":"2025-11-07T16:23:16Z","body":"Good to hear! Worst-case scenario, if something about how TileSet assignment works is fundamentally incompatible with how Instant Preview works, we may be able to hardcode that field to not allow Instant Preview while we investigate a better long-term solution (potentially reworking either Instant Preview or the TileSet property).","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3503499163/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3503554811","html_url":"https://github.com/godotengine/godot/issues/112503#issuecomment-3503554811","issue_url":"https://api.github.com/repos/godotengine/godot/issues/112503","id":3503554811,"node_id":"IC_kwDOAO6SJc7Q1AD7","user":{"login":"patwork","id":224215,"node_id":"MDQ6VXNlcjIyNDIxNQ==","avatar_url":"https://avatars.githubusercontent.com/u/224215?v=4","gravatar_id":"","url":"https://api.github.com/users/patwork","html_url":"https://github.com/patwork","followers_url":"https://api.github.com/users/patwork/followers","following_url":"https://api.github.com/users/patwork/following{/other_user}","gists_url":"https://api.github.com/users/patwork/gists{/gist_id}","starred_url":"https://api.github.com/users/patwork/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/patwork/subscriptions","organizations_url":"https://api.github.com/users/patwork/orgs","repos_url":"https://api.github.com/users/patwork/repos","events_url":"https://api.github.com/users/patwork/events{/privacy}","received_events_url":"https://api.github.com/users/patwork/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-11-07T16:35:06Z","updated_at":"2025-11-07T16:38:16Z","body":"It's not just the tileset; I've seen this behavior when selecting textures for materials, too (\"Select Texture2D\" window). Only when \"Instant Preview\" is on.","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3503554811/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3506023346","html_url":"https://github.com/godotengine/godot/issues/112503#issuecomment-3506023346","issue_url":"https://api.github.com/repos/godotengine/godot/issues/112503","id":3506023346,"node_id":"IC_kwDOAO6SJc7Q-auy","user":{"login":"Meorge","id":9957987,"node_id":"MDQ6VXNlcjk5NTc5ODc=","avatar_url":"https://avatars.githubusercontent.com/u/9957987?v=4","gravatar_id":"","url":"https://api.github.com/users/Meorge","html_url":"https://github.com/Meorge","followers_url":"https://api.github.com/users/Meorge/followers","following_url":"https://api.github.com/users/Meorge/following{/other_user}","gists_url":"https://api.github.com/users/Meorge/gists{/gist_id}","starred_url":"https://api.github.com/users/Meorge/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Meorge/subscriptions","organizations_url":"https://api.github.com/users/Meorge/orgs","repos_url":"https://api.github.com/users/Meorge/repos","events_url":"https://api.github.com/users/Meorge/events{/privacy}","received_events_url":"https://api.github.com/users/Meorge/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-11-08T05:50:46Z","updated_at":"2025-11-08T05:53:28Z","body":"I think I've found the cause of this issue. Unfortunately it's something that (at least for the moment) I'm not sure how we would fix. It looks like I ran into a similar issue [back here](https://github.com/godotengine/godot/pull/106947#issuecomment-2933473765), but now we *are* dealing with properties.\n\nWith the TileMapLayer, I believe this is the series of events that's occurring:\n- The `EditorResourcePicker` is created in the inspector when we select the TileMapLayer node.\n- Upon clicking the Quick Load button, the `EditorResourcePicker` opens the `EditorQuickOpenDialog`, with a callback **on itself**.\n- With Instant Preview enabled, when we click a Resource and preview it, `TileMapLayer::set_tile_set()` is called.\n  - This causes the inspector to update its property list (likely via `notify_property_list_changed()` although I haven't explicitly checked).\n  - Updating the property list causes the inspector widgets to be freed and new identical ones to be created in their place. **Now the callback we passed to the `EditorQuickOpenDialog` upon opening it is no longer valid – its `EditorResourcePicker` just got replaced!**\n- When we double-click an item in the `EditorQuickOpenDialog`, it first resets the property value to what it was when the dialog box was opened, so that the subsequent undo/redo operation makes sense.\n  - This step works; it's why the value reverts back.\n- Next, it's *supposed to* use the callback to perform the \"actual\" property value change, that has the undo/redo action associated with it. **But because the object owning the callback was deleted, the callback is no longer valid, and nothing happens with it!**\n\nIt's late for me now so I might not be thinking at full capacity now, but this seems to me like it would be quite a tricky thing to fix. The best solution I can think of is decoupling the resource-picking logic from `EditorResourcePicker` and moving it into an object that persists outside of the inspector. Then, `EditorResourcePicker` can pass a callback to *that* object to `EditorQuickOpenDialog`, and it'll still be valid once `EditorQuickOpenDialog` tries to finalize its selection.\n\nIf anyone else with knowledge of the codebase has other ideas on how to tackle it, or otherwise valuable insights, they would be much appreciated!","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3506023346/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3576398962","html_url":"https://github.com/godotengine/godot/issues/112503#issuecomment-3576398962","issue_url":"https://api.github.com/repos/godotengine/godot/issues/112503","id":3576398962,"node_id":"IC_kwDOAO6SJc7VK4Ry","user":{"login":"Meorge","id":9957987,"node_id":"MDQ6VXNlcjk5NTc5ODc=","avatar_url":"https://avatars.githubusercontent.com/u/9957987?v=4","gravatar_id":"","url":"https://api.github.com/users/Meorge","html_url":"https://github.com/Meorge","followers_url":"https://api.github.com/users/Meorge/followers","following_url":"https://api.github.com/users/Meorge/following{/other_user}","gists_url":"https://api.github.com/users/Meorge/gists{/gist_id}","starred_url":"https://api.github.com/users/Meorge/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Meorge/subscriptions","organizations_url":"https://api.github.com/users/Meorge/orgs","repos_url":"https://api.github.com/users/Meorge/repos","events_url":"https://api.github.com/users/Meorge/events{/privacy}","received_events_url":"https://api.github.com/users/Meorge/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-11-25T16:05:42Z","updated_at":"2025-11-25T16:05:42Z","body":"With the main fixing PR merged, is #112559 still under consideration for merging as well, or should I close it? I think it might be good to have as a fallback message for the user, in case there's a case the merged PR doesn't happen to cover. Rather than failing silently, the user receives a message telling them to disable Instant Preview for this resource type. They can do so to avoid stopping their work, but report the underlying behavior as a bug as well.","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3576398962/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null}]