[{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3924701415","html_url":"https://github.com/godotengine/godot/issues/116458#issuecomment-3924701415","issue_url":"https://api.github.com/repos/godotengine/godot/issues/116458","id":3924701415,"node_id":"IC_kwDOAO6SJc7p7jDn","user":{"login":"Nintorch","id":92302738,"node_id":"U_kgDOBYBtkg","avatar_url":"https://avatars.githubusercontent.com/u/92302738?v=4","gravatar_id":"","url":"https://api.github.com/users/Nintorch","html_url":"https://github.com/Nintorch","followers_url":"https://api.github.com/users/Nintorch/followers","following_url":"https://api.github.com/users/Nintorch/following{/other_user}","gists_url":"https://api.github.com/users/Nintorch/gists{/gist_id}","starred_url":"https://api.github.com/users/Nintorch/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Nintorch/subscriptions","organizations_url":"https://api.github.com/users/Nintorch/orgs","repos_url":"https://api.github.com/users/Nintorch/repos","events_url":"https://api.github.com/users/Nintorch/events{/privacy}","received_events_url":"https://api.github.com/users/Nintorch/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-02-19T04:59:55Z","updated_at":"2026-02-19T04:59:55Z","body":"Hello! As far as I know, Godot's built-in script editor is not designed for proper syntax highlighting and code completion for C# scripts, so I would say it's expected. I'm not sure we can rename the class, since that would be a compatibility breaking change. :(","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3924701415/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5936285211","html_url":"https://github.com/godotengine/godot/issues/116458#issuecomment-5936285211","issue_url":"https://api.github.com/repos/godotengine/godot/issues/116458","id":5936285211,"node_id":"IC_kwDOAO6SJc8AAAABYdSGGw","user":{"login":"raulsntos","id":3903059,"node_id":"MDQ6VXNlcjM5MDMwNTk=","avatar_url":"https://avatars.githubusercontent.com/u/3903059?v=4","gravatar_id":"","url":"https://api.github.com/users/raulsntos","html_url":"https://github.com/raulsntos","followers_url":"https://api.github.com/users/raulsntos/followers","following_url":"https://api.github.com/users/raulsntos/following{/other_user}","gists_url":"https://api.github.com/users/raulsntos/gists{/gist_id}","starred_url":"https://api.github.com/users/raulsntos/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/raulsntos/subscriptions","organizations_url":"https://api.github.com/users/raulsntos/orgs","repos_url":"https://api.github.com/users/raulsntos/repos","events_url":"https://api.github.com/users/raulsntos/events{/privacy}","received_events_url":"https://api.github.com/users/raulsntos/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-10-01T16:56:21Z","updated_at":"2026-10-01T16:56:21Z","body":"Besides some Godot classes using slightly different casing to match .NET naming conventions, non-Godot classes like `DateTime` or `Stream` will also not be recognized.\n\nGodot's internal script editor is not intended to be used in production for C#. Most C# users are used to dedicated C# IDEs and it would be a waste of effort to try to make Godot's script editor be as feature complete as C# IDEs like VS, VS Code or Rider.\n\nIt _can_ open C# files like it can open .txt or .json files, but it's not a supported use case. As such, I'm closing this as a subset of https://github.com/godotengine/godot/issues/73438.\n\nSee the docs on how to configure an external C# IDE: https://docs.godotengine.org/en/stable/tutorials/scripting/c_sharp/c_sharp_basics.html#configuring-an-external-editor","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5936285211/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null}]