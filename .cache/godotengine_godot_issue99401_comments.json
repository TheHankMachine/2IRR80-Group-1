[{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2484281207","html_url":"https://github.com/godotengine/godot/pull/99401#issuecomment-2484281207","issue_url":"https://api.github.com/repos/godotengine/godot/issues/99401","id":2484281207,"node_id":"IC_kwDOAO6SJc6UEx93","user":{"login":"KoBeWi","id":2223172,"node_id":"MDQ6VXNlcjIyMjMxNzI=","avatar_url":"https://avatars.githubusercontent.com/u/2223172?v=4","gravatar_id":"","url":"https://api.github.com/users/KoBeWi","html_url":"https://github.com/KoBeWi","followers_url":"https://api.github.com/users/KoBeWi/followers","following_url":"https://api.github.com/users/KoBeWi/following{/other_user}","gists_url":"https://api.github.com/users/KoBeWi/gists{/gist_id}","starred_url":"https://api.github.com/users/KoBeWi/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/KoBeWi/subscriptions","organizations_url":"https://api.github.com/users/KoBeWi/orgs","repos_url":"https://api.github.com/users/KoBeWi/repos","events_url":"https://api.github.com/users/KoBeWi/events{/privacy}","received_events_url":"https://api.github.com/users/KoBeWi/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2024-11-18T22:38:59Z","updated_at":"2024-11-18T22:38:59Z","body":"Looks like #61873, but actually working.","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2484281207/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2489826673","html_url":"https://github.com/godotengine/godot/pull/99401#issuecomment-2489826673","issue_url":"https://api.github.com/repos/godotengine/godot/issues/99401","id":2489826673,"node_id":"IC_kwDOAO6SJc6UZ71x","user":{"login":"kitbdev","id":10054226,"node_id":"MDQ6VXNlcjEwMDU0MjI2","avatar_url":"https://avatars.githubusercontent.com/u/10054226?v=4","gravatar_id":"","url":"https://api.github.com/users/kitbdev","html_url":"https://github.com/kitbdev","followers_url":"https://api.github.com/users/kitbdev/followers","following_url":"https://api.github.com/users/kitbdev/following{/other_user}","gists_url":"https://api.github.com/users/kitbdev/gists{/gist_id}","starred_url":"https://api.github.com/users/kitbdev/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/kitbdev/subscriptions","organizations_url":"https://api.github.com/users/kitbdev/orgs","repos_url":"https://api.github.com/users/kitbdev/repos","events_url":"https://api.github.com/users/kitbdev/events{/privacy}","received_events_url":"https://api.github.com/users/kitbdev/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2024-11-21T00:36:54Z","updated_at":"2024-11-21T00:36:54Z","body":"Some nodes have an incorrect gizmo position when in a Viewport not at the origin, like position indicators for Node2Ds or handles for Line2D, CollisionShape2D, etc.\r\n\r\n![image](https://github.com/user-attachments/assets/f211baf3-6388-4295-91d1-c12d875b8c65)\r\n\r\n![image](https://github.com/user-attachments/assets/d563d5e3-d191-4247-82ed-e0a6bf03cde8)\r\n\r\n![image](https://github.com/user-attachments/assets/65125872-790c-473c-8893-48365a4db52a)\r\n\r\nSelecting works and using the handles works, they're just offset and not rotated or scaled.\r\n\r\nAlso, If the viewport gets rotated or scaled, using the move or scale tools aren't correct, though the resize gizmos are fine.\r\n\r\n![image](https://github.com/user-attachments/assets/e00d2dfb-d76e-4aec-9b5a-f99cab01001f)\r\n\r\n","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2489826673/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2508389204","html_url":"https://github.com/godotengine/godot/pull/99401#issuecomment-2508389204","issue_url":"https://api.github.com/repos/godotengine/godot/issues/99401","id":2508389204,"node_id":"IC_kwDOAO6SJc6VgvtU","user":{"login":"kitbdev","id":10054226,"node_id":"MDQ6VXNlcjEwMDU0MjI2","avatar_url":"https://avatars.githubusercontent.com/u/10054226?v=4","gravatar_id":"","url":"https://api.github.com/users/kitbdev","html_url":"https://github.com/kitbdev","followers_url":"https://api.github.com/users/kitbdev/followers","following_url":"https://api.github.com/users/kitbdev/following{/other_user}","gists_url":"https://api.github.com/users/kitbdev/gists{/gist_id}","starred_url":"https://api.github.com/users/kitbdev/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/kitbdev/subscriptions","organizations_url":"https://api.github.com/users/kitbdev/orgs","repos_url":"https://api.github.com/users/kitbdev/repos","events_url":"https://api.github.com/users/kitbdev/events{/privacy}","received_events_url":"https://api.github.com/users/kitbdev/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2024-11-29T19:07:01Z","updated_at":"2024-11-29T19:07:01Z","body":"> On [GUI in 3D](https://github.com/godotengine/godot-demo-projects/tree/master/viewport/gui_in_3d), I can see the editing controls and interact with them, but nothing appears in the 2D editor viewport:\r\n\r\nThey also do not appear in 4.3 and in master. This is intentional since [SubViewport](https://docs.godotengine.org/en/latest/classes/class_subviewport.html) do not draw anything by themselves. In that scene, the SubViewport is rendered to a MeshInstance3D, so it will only show in the 3D Editor.\r\n\r\nSo instead, the nodes in a SubViewport without a SubViewportContainer should not be selectable or editable in the canvas editor.\r\n","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2508389204/reactions","total_count":2,"+1":2,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2508692667","html_url":"https://github.com/godotengine/godot/pull/99401#issuecomment-2508692667","issue_url":"https://api.github.com/repos/godotengine/godot/issues/99401","id":2508692667,"node_id":"IC_kwDOAO6SJc6Vh5y7","user":{"login":"akien-mga","id":4701338,"node_id":"MDQ6VXNlcjQ3MDEzMzg=","avatar_url":"https://avatars.githubusercontent.com/u/4701338?v=4","gravatar_id":"","url":"https://api.github.com/users/akien-mga","html_url":"https://github.com/akien-mga","followers_url":"https://api.github.com/users/akien-mga/followers","following_url":"https://api.github.com/users/akien-mga/following{/other_user}","gists_url":"https://api.github.com/users/akien-mga/gists{/gist_id}","starred_url":"https://api.github.com/users/akien-mga/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/akien-mga/subscriptions","organizations_url":"https://api.github.com/users/akien-mga/orgs","repos_url":"https://api.github.com/users/akien-mga/repos","events_url":"https://api.github.com/users/akien-mga/events{/privacy}","received_events_url":"https://api.github.com/users/akien-mga/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2024-11-29T21:56:51Z","updated_at":"2024-11-29T21:56:51Z","body":"Thanks!","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2508692667/reactions","total_count":2,"+1":0,"-1":0,"laugh":0,"hooray":2,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2564288831","html_url":"https://github.com/godotengine/godot/pull/99401#issuecomment-2564288831","iss