[{"id":2640233293,"node_id":"PRR_kwDOAO6SJc6dXsNN","user":{"login":"bruvzg","id":7645683,"node_id":"MDQ6VXNlcjc2NDU2ODM=","avatar_url":"https://avatars.githubusercontent.com/u/7645683?u=2867ee7fcd920bc19b7d1cbf4b10264b9bbc9326&v=4","gravatar_id":"","url":"https://api.github.com/users/bruvzg","html_url":"https://github.com/bruvzg","followers_url":"https://api.github.com/users/bruvzg/followers","following_url":"https://api.github.com/users/bruvzg/following{/other_user}","gists_url":"https://api.github.com/users/bruvzg/gists{/gist_id}","starred_url":"https://api.github.com/users/bruvzg/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/bruvzg/subscriptions","organizations_url":"https://api.github.com/users/bruvzg/orgs","repos_url":"https://api.github.com/users/bruvzg/repos","events_url":"https://api.github.com/users/bruvzg/events{/privacy}","received_events_url":"https://api.github.com/users/bruvzg/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"Not sure if calling `get(beg)` every time is OK, it should have some overhead and using raw `char32_t *` will likely have better performance.","state":"COMMENTED","html_url":"https://github.com/godotengine/godot/pull/103269#pullrequestreview-2640233293","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/103269","author_association":"MEMBER","_links":{"html":{"href":"https://github.com/godotengine/godot/pull/103269#pullrequestreview-2640233293"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/103269"}},"submitted_at":"2025-02-25T09:19:58Z","commit_id":null},{"id":2640336791,"node_id":"PRR_kwDOAO6SJc6dYFeX","user":{"login":"Ivorforce","id":2308167,"node_id":"MDQ6VXNlcjIzMDgxNjc=","avatar_url":"https://avatars.githubusercontent.com/u/2308167?u=f7f8e0273f784f5ec6f6b7fe4a88d449896eb48a&v=4","gravatar_id":"","url":"https://api.github.com/users/Ivorforce","html_url":"https://github.com/Ivorforce","followers_url":"https://api.github.com/users/Ivorforce/followers","following_url":"https://api.github.com/users/Ivorforce/following{/other_user}","gists_url":"https://api.github.com/users/Ivorforce/gists{/gist_id}","starred_url":"https://api.github.com/users/Ivorforce/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Ivorforce/subscriptions","organizations_url":"https://api.github.com/users/Ivorforce/orgs","repos_url":"https://api.github.com/users/Ivorforce/repos","events_url":"https://api.github.com/users/Ivorforce/events{/privacy}","received_events_url":"https://api.github.com/users/Ivorforce/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"I agree with @bruvzg that using a pointer would be appropriate for performance gains.\r\n\r\nTo the proposal itself: I do think that your proposed `strip` interface is more useful than the current `strip_edges` interface.\r\nHowever, I'm not sure I agree that defaulting to strip whitespace is good behavior when passing an empty string. What if you have the following situation:\r\n\r\n```gdscript\r\nstring.strip(file.get_strip_chars())\r\n```\r\n\r\nIn this situation, if `get_strip_chars()` is empty, i.e. it isn't supposed to strip anything, the function will switch to the default and cause unexpected behavior. While probably rare, it's a bug waiting to happen.\r\nInstead, I think it might be good to just have a static string with all whitespace and control characters and default to that. The implementation will be quite a lot slower with that, but it would be possible to compare pointers to it at the start of the function to optimize for this specific case if we care enough.","state":"COMMENTED","html_url":"https://github.com/godotengine/godot/pull/103269#pullrequestreview-2640336791","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/103269","author_association":"MEMBER","_links":{"html":{"href":"https://github.com/godotengine/godot/pull/103269#pullrequestreview-2640336791"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/103269"}},"submitted_at":"2025-02-25T09:48:13Z","commit_id":null},{"id":2641411742,"node_id":"PRR_kwDOAO6SJc6dcL6e","user":{"login":"mhilbrunner","id":1654763,"node_id":"MDQ6VXNlcjE2NTQ3NjM=","avatar_url":"https://avatars.githubusercontent.com/u/1654763?u=5c21c1fe21e9cef0ceb6fd36a941f6e336d45583&v=4","gravatar_id":"","url":"https://api.github.com/users/mhilbrunner","html_url":"https://github.com/mhilbrunner","followers_url":"https://api.github.com/users/mhilbrunner/followers","following_url":"https://api.github.com/users/mhilbrunner/following{/other_user}","gists_url":"https://api.github.com/users/mhilbrunner/gists{/gist_id}","starred_url":"https://api.github.com/users/mhilbrunner/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/mhilbrunner/subscriptions","organizations_url":"https://api.github.com/users/mhilbrunner/orgs","repos_url":"https://api.github.com/users/mhilbrunner/repos","events_url":"https://api.github.com/users/mhilbrunner/events{/privacy}","received_events_url":"https://api.github.com/users/mhilbrunner/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"","state":"COMMENTED","html_url":"https://github.com/godotengine/godot/pull/103269#pullrequestreview-2641411742","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/103269","author_association":"MEMBER","_links":{"html":{"href":"https://github.com/godotengine/godot/pull/103269#pullrequestreview-2641411742"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/103269"}},"submitted_at":"2025-02-25T15:00:28Z","commit_id":null}]