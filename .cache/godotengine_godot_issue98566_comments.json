.com/users/Repiteo/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-06-18T23:30:10Z","updated_at":"2025-06-18T23:30:10Z","body":"Thanks!","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2986024018/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2989930621","html_url":"https://github.com/godotengine/godot/pull/98566#issuecomment-2989930621","issue_url":"https://api.github.com/repos/godotengine/godot/issues/98566","id":2989930621,"node_id":"IC_kwDOAO6SJc6yNrh9","user":{"login":"Bromeon","id":708488,"node_id":"MDQ6VXNlcjcwODQ4OA==","avatar_url":"https://avatars.githubusercontent.com/u/708488?v=4","gravatar_id":"","url":"https://api.github.com/users/Bromeon","html_url":"https://github.com/Bromeon","followers_url":"https://api.github.com/users/Bromeon/followers","following_url":"https://api.github.com/users/Bromeon/following{/other_user}","gists_url":"https://api.github.com/users/Bromeon/gists{/gist_id}","starred_url":"https://api.github.com/users/Bromeon/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Bromeon/subscriptions","organizations_url":"https://api.github.com/users/Bromeon/orgs","repos_url":"https://api.github.com/users/Bromeon/repos","events_url":"https://api.github.com/users/Bromeon/events{/privacy}","received_events_url":"https://api.github.com/users/Bromeon/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-06-20T06:24:45Z","updated_at":"2025-06-20T06:24:45Z","body":"This PR introduces a breaking change into GDExtension: `VisualShader::set_graph_offset()` + `VisualShader::get_graph_offset()` have been removed. To my knowledge, they're not experimental.\r\n\r\nI think a compatibility method should be registered for those 2 methods.","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2989930621/reactions","total_count":5,"+1":5,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2990354832","html_url":"https://github.com/godotengine/godot/pull/98566#issuecomment-2990354832","issue_url":"https://api.github.com/repos/godotengine/godot/issues/98566","id":2990354832,"node_id":"IC_kwDOAO6SJc6yPTGQ","user":{"login":"KoBeWi","id":2223172,"node_id":"MDQ6VXNlcjIyMjMxNzI=","avatar_url":"https://avatars.githubusercontent.com/u/2223172?v=4","gravatar_id":"","url":"https://api.github.com/users/KoBeWi","html_url":"https://github.com/KoBeWi","followers_url":"https://api.github.com/users/KoBeWi/followers","following_url":"https://api.github.com/users/KoBeWi/following{/other_user}","gists_url":"https://api.github.com/users/KoBeWi/gists{/gist_id}","starred_url":"https://api.github.com/users/KoBeWi/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/KoBeWi/subscriptions","organizations_url":"https://api.github.com/users/KoBeWi/orgs","repos_url":"https://api.github.com/users/KoBeWi/repos","events_url":"https://api.github.com/users/KoBeWi/events{/privacy}","received_events_url":"https://api.github.com/users/KoBeWi/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-06-20T09:00:10Z","updated_at":"2025-06-20T09:00:10Z","body":"GraphEdit itself is marked as experimental.","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2990354832/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2990540470","html_url":"https://github.com/godotengine/godot/pull/98566#issuecomment-2990540470","issue_url":"https://api.github.com/repos/godotengine/godot/issues/98566","id":2990540470,"node_id":"IC_kwDOAO6SJc6yQAa2","user":{"login":"Geometror","id":50084500,"node_id":"MDQ6VXNlcjUwMDg0NTAw","avatar_url":"https://avatars.githubusercontent.com/u/50084500?v=4","gravatar_id":"","url":"https://api.github.com/users/Geometror","html_url":"https://github.com/Geometror","followers_url":"https://api.github.com/users/Geometror/followers","following_url":"https://api.github.com/users/Geometror/following{/other_user}","gists_url":"https://api.github.com/users/Geometror/gists{/gist_id}","starred_url":"https://api.github.com/users/Geometror/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Geometror/subscriptions","organizations_url":"https://api.github.com/users/Geometror/orgs","repos_url":"https://api.github.com/users/Geometror/repos","events_url":"https://api.github.com/users/Geometror/events{/privacy}","received_events_url":"https://api.github.com/users/Geometror/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-06-20T09:42:56Z","updated_at":"2025-06-20T09:43:24Z","body":"While `GraphEdit` is marked as experimental, `VisualShader` ist not.\n\nThe problem is, setting the graph offset via `VisualShader` was never functional (the Editor basically ignored it), so they shouldn't be used at all. \nThat said, theoretically someone could have used this property for their own stuff (e.g. for a custom VisualShader editor), but I highly doubt that.\nAdding compatibility mehods would be possible, but the only reasonable implementation would be to make them empty stubs.","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2990540470/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github