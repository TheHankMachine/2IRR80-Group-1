t":null,"archived_by":null},{"id":709269775,"node_id":"MDU6TGFiZWw3MDkyNjk3NzU=","url":"https://api.github.com/repos/godotengine/godot/labels/topic:dotnet","name":"topic:dotnet","color":"ffee88","default":false,"description":"","archived_at":null,"archived_by":null}],"state":"open","locked":false,"assignees":[],"milestone":{"url":"https://api.github.com/repos/godotengine/godot/milestones/16","html_url":"https://github.com/godotengine/godot/milestone/16","labels_url":"https://api.github.com/repos/godotengine/godot/milestones/16/labels","id":8237783,"node_id":"MI_kwDOAO6SJc4AfbLX","number":16,"title":"4.x","description":"Issues and pull requests slated for an undetermined Godot 4 release.","creator":{"login":"akien-mga","id":4701338,"node_id":"MDQ6VXNlcjQ3MDEzMzg=","avatar_url":"https://avatars.githubusercontent.com/u/4701338?v=4","gravatar_id":"","url":"https://api.github.com/users/akien-mga","html_url":"https://github.com/akien-mga","followers_url":"https://api.github.com/users/akien-mga/followers","following_url":"https://api.github.com/users/akien-mga/following{/other_user}","gists_url":"https://api.github.com/users/akien-mga/gists{/gist_id}","starred_url":"https://api.github.com/users/akien-mga/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/akien-mga/subscriptions","organizations_url":"https://api.github.com/users/akien-mga/orgs","repos_url":"https://api.github.com/users/akien-mga/repos","events_url":"https://api.github.com/users/akien-mga/events{/privacy}","received_events_url":"https://api.github.com/users/akien-mga/received_events","type":"User","user_view_type":"public","site_admin":false},"open_issues":5796,"closed_issues":0,"state":"open","created_at":"2022-07-26T12:42:05Z","updated_at":"2026-10-21T09:35:07Z","due_on":null,"closed_at":null},"comments":0,"created_at":"2026-09-26T17:32:17Z","updated_at":"2026-09-26T17:32:18Z","closed_at":null,"assignee":null,"author_association":"CONTRIBUTOR","issue_field_values":[],"type":null,"active_lock_reason":null,"draft":false,"pull_request":{"url":"https://api.github.com/repos/godotengine/godot/pulls/123868","html_url":"https://github.com/godotengine/godot/pull/123868","diff_url":"https://github.com/godotengine/godot/pull/123868.diff","patch_url":"https://github.com/godotengine/godot/pull/123868.patch","merged_at":null},"body":"## What problem(s) does this PR solve?\r\n\r\nRight now the mono build logic is overly isolated from the rest of the buildsystem for no real reason. I hope to gradually modernize its generation logic by ensuring that it can be incorporated into our usual buildsystem logic, without compromising its independence from SCons as a whole. This is a start to that separation by changing the current mono configuration of aborting when the module is unsupported & applying it to *all* modules.\r\n\r\nThis was done by adding error-handlers to `SConstruct` for explicitly enabled modules that can't be built. Aborts early if `werror` is passed; otherwise it simply prints a warning. These handlers are only triggered for modules enabled through the command-line specifically, but the \"disabled\" status is properly applied no matter what. Consequently, the logic in mono's `config.py` was updated to not handle aborting directly, and the `can_build` logic was lifted from the now-removed `mono_configure.py`.\r\n\r\n## Additional information\r\n\r\nN/A","closed_by":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/123868/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/godotengine/godot/issues/123868/timeline","performed_via_github_app":null,"state_reason":null}