ithub.com/users/AThousandShips","html_url":"https://github.com/AThousandShips","followers_url":"https://api.github.com/users/AThousandShips/followers","following_url":"https://api.github.com/users/AThousandShips/following{/other_user}","gists_url":"https://api.github.com/users/AThousandShips/gists{/gist_id}","starred_url":"https://api.github.com/users/AThousandShips/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/AThousandShips/subscriptions","organizations_url":"https://api.github.com/users/AThousandShips/orgs","repos_url":"https://api.github.com/users/AThousandShips/repos","events_url":"https://api.github.com/users/AThousandShips/events{/privacy}","received_events_url":"https://api.github.com/users/AThousandShips/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-09-28T10:42:20Z","updated_at":"2025-09-28T10:42:20Z","body":"Handled very well I agree! As a way to avoid similar confusion in the future it's always a good idea to comment on an issue saying you are interested in working on it, or saying you are working on a solution. Just make sure to communicate if you end up not working more on it so someone else can take over. We don't enforce any \"claiming\" of issues but we encourage people to respect each other's time and let the first one who says so work on it first.","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3342860376/reactions","total_count":6,"+1":6,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3419524786","html_url":"https://github.com/godotengine/godot/issues/110961#issuecomment-3419524786","issue_url":"https://api.github.com/repos/godotengine/godot/issues/110961","id":3419524786,"node_id":"IC_kwDOAO6SJc7L0c6y","user":{"login":"DevSavvySerge","id":149676797,"node_id":"U_kgDOCOvi_Q","avatar_url":"https://avatars.githubusercontent.com/u/149676797?v=4","gravatar_id":"","url":"https://api.github.com/users/DevSavvySerge","html_url":"https://github.com/DevSavvySerge","followers_url":"https://api.github.com/users/DevSavvySerge/followers","following_url":"https://api.github.com/users/DevSavvySerge/following{/other_user}","gists_url":"https://api.github.com/users/DevSavvySerge/gists{/gist_id}","starred_url":"https://api.github.com/users/DevSavvySerge/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/DevSavvySerge/subscriptions","organizations_url":"https://api.github.com/users/DevSavvySerge/orgs","repos_url":"https://api.github.com/users/DevSavvySerge/repos","events_url":"https://api.github.com/users/DevSavvySerge/events{/privacy}","received_events_url":"https://api.github.com/users/DevSavvySerge/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-10-19T09:40:42Z","updated_at":"2025-10-19T09:40:42Z","body":"Why not introducing an \"async\" keyword as a compiler hint?","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3419524786/reactions","total_count":2,"+1":2,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3419682816","html_url":"https://github.com/godotengine/godot/issues/110961#issuecomment-3419682816","issue_url":"https://api.github.com/repos/godotengine/godot/issues/110961","id":3419682816,"node_id":"IC_kwDOAO6SJc7L1DgA","user":{"login":"MikeSchulze","id":347037,"node_id":"MDQ6VXNlcjM0NzAzNw==","avatar_url":"https://avatars.githubusercontent.com/u/347037?v=4","gravatar_id":"","url":"https://api.github.com/users/MikeSchulze","html_url":"https://github.com/MikeSchulze","followers_url":"https://api.github.com/users/MikeSchulze/followers","following_url":"https://api.github.com/users/MikeSchulze/following{/other_user}","gists_url":"https://api.github.com/users/MikeSchulze/gists{/gist_id}","starred_url":"https://api.github.com/users/MikeSchulze/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/MikeSchulze/subscriptions","organizations_url":"https://api.github.com/users/MikeSchulze/orgs","repos_url":"https://api.github.com/users/MikeSchulze/repos","events_url":"https://api.github.com/users/MikeSchulze/events{/privacy}","received_events_url":"https://api.github.com/users/MikeSchulze/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-10-19T13:49:50Z","updated_at":"2025-10-19T13:49:50Z","body":"> Why not introducing an \"async\" keyword as a compiler hint?\n\nTo having `async` syntax would be a big improvement!","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3419682816/reactions","total_count":3,"+1":3,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3419690990","html_url":"https://github.com/godotengine/godot/issues/110961#issuecomment-3419690990","issue_url":"https://api.github.com/repos/godotengine/godot/issues/110961","id":3419690990,"node_id":"IC_kwDOAO6SJc7L1Ffu","user":{"login":"dalexeev","id":47700418,"node_id":"MDQ6VXNlcjQ3NzAwNDE4","avatar_url":"https://avatars.githubusercontent.com/u/47700418?v=4","gravatar_id":"","url":"https://api.github.com/users/dalexeev","html_url":"https://github.com/dalexeev","followers_url":"https://api.github.com/users/dalexeev/followers","following_url":"https://api.github.com/users/dalexeev/following{/other_user}","gists_url":"https://api.github.com/users/dalexeev/gists{/gist_id}","starred_url":"https://api.github.com/users/dalexeev/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/dalexeev/subscriptions","organizations_url":"https://api.github.com/users/dalexeev/orgs","repos_url":"https://api.github.com/users/dalexeev/repos","events_url":"https://api.github.com/users/dalexeev/events{/privacy}","received_events_url":"https://api.github.com/users/dalexeev/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-10-19T14:01:51Z","updated_at":"2025-10-19T14:01:51Z","body":"> Why not introducing an \"async\" keyword as a compiler hint?\n\nIn GDScript, using `await` inside a function doesn't require marking it as `async` (or `@async`), unlike in JavaScript. Whether a function is a coroutine is determined dynamically (plus, the static analyzer makes a best-effort guess about the function type for warnings). Changing this isn't possible in 4.x for compatibility reasons.","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3419690990/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4021731433","html_url":"https://github.com/godotengine/godot/issues/110961#issuecomment-4021731433","issue_url":"https://api.github.com/repos/godotengine/godot/issues/110961","id":4021731433,"node_id":"IC_kwDOAO6SJc7vtsBp","user":{"login":"imdongye","id":42573050,"node_id":"MDQ6VXNlcjQyNTczMDUw","avatar_url":"https://avatars.githubusercontent.com/u/42573050?v=4","gravatar_id":"","url":"https://api.github.com/users/imdongye","html_url":"https://github.com/imdongye","followers_url":"https://api.github.com/users/imdongye/followers","following_url":"https://api.github.com/users/imdongye/following{/other_user}","gists_url":"https://api.github.com/users/imdongye/gists{/gist_id}","starred_url":"https://api.github.com/users/imdongye/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/imdongye/subscriptions","organizations_url":"https://api.github.com/users/imdongye/orgs","repos_url":"https://api.github.com/users/imdongye/repos","events_url":"https://api.github.com/users/imdongye/events{/privacy}","received_events_url":"https://api.github.com/users/imdongye/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-03-09T07:30:37Z","updated_at":"2026-07-29T09:35:33Z","body":"I found that awaiting an @abstract function causes subsequent member-access expressions to return a GDScriptFunctionState instead of the actual value.\n\nin godot4.6.1-stable\n\n```\n# Parent Class\n@abstract func handshake_msg_port() -> bool # Intended to be overridden with async logic in child classes\n```\n```\n# Caller Logic (in another class)\n@warning_ignore(\"redundant_await\")\nvar handshake_rst: bool = await dp.handshake_msg_port()\n\nvar safe_extra_port: int = dp.extra_port # extra_port is -1 (int)\n\nprint(dp.extra_port)        # Output: -1\nprint(safe_extra_port)     # Output: -1\nprint(dp.extra_port < 0)    # Output: <GDScriptFunctionState#...> (BUG!)\nprint(safe_extra_port < 0) # Output: true (Expected)\n\nif dp.extra_port < 0:\n    # This block is skipped because the condition returned a FunctionState object,\n    # which evaluates to false in this context.\n    return true\n```\n\nfixed by \tif bool(dp.extra_port < 0):","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4021731433/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":{"reason":"off-topic"}},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4136920909","html_url":"https://github.com/godotengine/godot/issues/110961#issuecomment-4136920909","issue_url":"https://api.github.com/repos/godotengine/godot/issues/110961","id":4136920909,"node_id":"IC_kwDOAO6SJc72lGdN","user":{"login":"HolonProduction","id":99511741,"node_id":"U_kgDOBe5tvQ","avatar_url":"https://avatars.githubusercontent.com/u/99511741?v=4","gravatar_id":"","url":"https://api.github.com/users/HolonProduction","html_url":"https://github.com/HolonProduction","followers_url":"https://api.github.com/users/HolonProduction/followers","following_url":"https://api.github.com/users/HolonProduction/following{/other_user}","gists_url":"https://api.github.com/users/HolonProduction/gists{/gist_id}","starred_url":"https://api.github.com/users/HolonProduction/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/HolonProduction/subscriptions","organizations_url":"https://api.github.com/users/HolonProduction/orgs","repos_url":"https://api.github.com/users/HolonProduction/repos","events_url":"https://api.github.com/users/HolonProduction/events{/privacy}","received_events_url":"https://api.github.com/users/HolonProduction/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-03-26T17:42:27Z","updated_at":"2026-07-29T09:35:37Z","body":"> I found that awaiting an `@abstract` function causes subsequent member-access expressions to return a GDScriptFunctionState instead of the actual value.\n\nSee https://github.com/godotengine/godot/issues/112017\n\n","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4136920909/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":{"reason":"off-topic"}}]