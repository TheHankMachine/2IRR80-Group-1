MDU6TGFiZWw0MTAwNjQ0ODU=","url":"https://api.github.com/repos/godotengine/godot/labels/needs%20testing","name":"needs testing","color":"ffcc44","default":false,"description":"","archived_at":null,"archived_by":null},{"id":1327318271,"node_id":"MDU6TGFiZWwxMzI3MzE4Mjcx","url":"https://api.github.com/repos/godotengine/godot/labels/crash","name":"crash","color":"885544","default":false,"description":"","archived_at":null,"archived_by":null}],"state":"open","locked":false,"assignees":[],"milestone":{"url":"https://api.github.com/repos/godotengine/godot/milestones/16","html_url":"https://github.com/godotengine/godot/milestone/16","labels_url":"https://api.github.com/repos/godotengine/godot/milestones/16/labels","id":8237783,"node_id":"MI_kwDOAO6SJc4AfbLX","number":16,"title":"4.x","description":"Issues and pull requests slated for an undetermined Godot 4 release.","creator":{"login":"akien-mga","id":4701338,"node_id":"MDQ6VXNlcjQ3MDEzMzg=","avatar_url":"https://avatars.githubusercontent.com/u/4701338?v=4","gravatar_id":"","url":"https://api.github.com/users/akien-mga","html_url":"https://github.com/akien-mga","followers_url":"https://api.github.com/users/akien-mga/followers","following_url":"https://api.github.com/users/akien-mga/following{/other_user}","gists_url":"https://api.github.com/users/akien-mga/gists{/gist_id}","starred_url":"https://api.github.com/users/akien-mga/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/akien-mga/subscriptions","organizations_url":"https://api.github.com/users/akien-mga/orgs","repos_url":"https://api.github.com/users/akien-mga/repos","events_url":"https://api.github.com/users/akien-mga/events{/privacy}","received_events_url":"https://api.github.com/users/akien-mga/received_events","type":"User","user_view_type":"public","site_admin":false},"open_issues":5790,"closed_issues":0,"state":"open","created_at":"2022-07-26T12:42:05Z","updated_at":"2026-10-22T08:16:48Z","due_on":null,"closed_at":null},"comments":2,"created_at":"2026-10-11T07:44:25Z","updated_at":"2026-10-12T08:30:26Z","closed_at":null,"assignee":null,"author_association":"CONTRIBUTOR","issue_field_values":[],"type":null,"active_lock_reason":null,"draft":false,"pull_request":{"url":"https://api.github.com/repos/godotengine/godot/pulls/124371","html_url":"https://github.com/godotengine/godot/pull/124371","diff_url":"https://github.com/godotengine/godot/pull/124371.diff","patch_url":"https://github.com/godotengine/godot/pull/124371.patch","merged_at":null},"body":"## What problem(s) does this PR solve?\r\n\r\n`texture_create()` points `image_view_create_info.pNext` at a `VkImageViewASTCDecodeModeEXT` on its own stack, then stores the create info in `vk_view_create_info`. `texture_create_shared()` and `texture_create_shared_from_slice()` start from that stored copy, so on a device with `VK_EXT_astc_decode_mode` every shared view or slice of an ASTC texture passes `vkCreateImageView()` a pointer into a stack frame that's already gone. `texture_create_shared()` only replaces `pNext` when the format changes and `VK_KHR_maintenance2` is enabled, so same-format views always keep it.\r\n\r\nWhether it crashes depends on what's left on the stack. On my Pixel 6 (Mali-G78, Android 17) it's deterministic, and a proxy of an ASTC texture is enough:\r\n\r\n```gdscript\r\nvar texture: Texture2D = load(\"res://astc.png\") # VRAM compressed, so ASTC on Android\r\nvar proxy := RenderingServer.texture_proxy_create(texture.get_rid())\r\n```\r\n\r\nFixes #124392\r\n\r\n## Additional information\r\n\r\nAI was used to create the MRP:\r\n[astc-proxy-crash-mrp.zip](https://github.com/user-attachments/files/33298611/astc-proxy-crash-mrp.zip).\r\n\r\nTo run use Mobile renderer on Vulkan with ETC2/ASTC import enabled. Export it for Android and run it on a device with VK_EXT_astc_decode_mode. ","closed_by":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/124371/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/godotengine/godot/issues/124371/timeline","performed_via_github_app":null,"state_reason":null}