23129","html_url":"https://github.com/godotengine/godot/pull/122412#issuecomment-5296423129","issue_url":"https://api.github.com/repos/godotengine/godot/issues/122412","id":5296423129,"node_id":"IC_kwDOAO6SJc8AAAABO7EA2Q","user":{"login":"AThousandShips","id":96648715,"node_id":"U_kgDOBcK-Cw","avatar_url":"https://avatars.githubusercontent.com/u/96648715?v=4","gravatar_id":"","url":"https://api.github.com/users/AThousandShips","html_url":"https://github.com/AThousandShips","followers_url":"https://api.github.com/users/AThousandShips/followers","following_url":"https://api.github.com/users/AThousandShips/following{/other_user}","gists_url":"https://api.github.com/users/AThousandShips/gists{/gist_id}","starred_url":"https://api.github.com/users/AThousandShips/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/AThousandShips/subscriptions","organizations_url":"https://api.github.com/users/AThousandShips/orgs","repos_url":"https://api.github.com/users/AThousandShips/repos","events_url":"https://api.github.com/users/AThousandShips/events{/privacy}","received_events_url":"https://api.github.com/users/AThousandShips/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-08-14T17:45:44Z","updated_at":"2026-08-14T17:45:44Z","body":"Missed that was not a regression, good catch, but indeed a priority","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5296423129/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5296813413","html_url":"https://github.com/godotengine/godot/pull/122412#issuecomment-5296813413","issue_url":"https://api.github.com/repos/godotengine/godot/issues/122412","id":5296813413,"node_id":"IC_kwDOAO6SJc8AAAABO7b1ZQ","user":{"login":"akien-mga","id":4701338,"node_id":"MDQ6VXNlcjQ3MDEzMzg=","avatar_url":"https://avatars.githubusercontent.com/u/4701338?v=4","gravatar_id":"","url":"https://api.github.com/users/akien-mga","html_url":"https://github.com/akien-mga","followers_url":"https://api.github.com/users/akien-mga/followers","following_url":"https://api.github.com/users/akien-mga/following{/other_user}","gists_url":"https://api.github.com/users/akien-mga/gists{/gist_id}","starred_url":"https://api.github.com/users/akien-mga/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/akien-mga/subscriptions","organizations_url":"https://api.github.com/users/akien-mga/orgs","repos_url":"https://api.github.com/users/akien-mga/repos","events_url":"https://api.github.com/users/akien-mga/events{/privacy}","received_events_url":"https://api.github.com/users/akien-mga/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-08-14T18:29:37Z","updated_at":"2026-08-14T18:29:37Z","body":"> I opted for 6.0.1 in the interest of being somewhat conservative, as that seems to be the latest version that affects us in terms of breakage (as best I can tell) but if we'd rather just use the latest version (6.0.6 at the time of writing) that's fine as well.\r\n\r\nUsing 6.0.1 as the min version sounds good to me.\r\n\r\nWe could consider going for the latest version as our pinned version for official builds though, unless there are known issues/risks with changes made after 6.0.1. I see a bunch of stuff that might be interesting to experiment with, like `GROWABLE_ARRAYBUFFERS` (which they seemed to auto-enable in 6.0.2 but reverted to disabled in 6.0.3)... So maybe that's a good argument for staying on 6.0.1 for official builds and just experiment with newer versions in custom builds.","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5296813413/reactions","total_count":2,"+1":2,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5296862419","html_url":"https://github.com/godotengine/godot/pull/122412#issuecomment-5296862419","issue_url":"https://api.github.com/repos/godotengine/godot/issues/122412","id":5296862419,"node_id":"IC_kwDOAO6SJc8AAAABO7e00w","user":{"login":"Mickeon","id":66727710,"node_id":"MDQ6VXNlcjY2NzI3NzEw","avatar_url":"https://avatars.githubusercontent.com/u/66727710?v=4","gravatar_id":"","url":"https://api.github.com/users/Mickeon","html_url":"https://github.com/Mickeon","followers_url":"https://api.github.com/users/Mickeon/followers","following_url":"https://api.github.com/users/Mickeon/following{/other_user}","gists_url":"https://api.github.com/users/Mickeon/gists{/gist_id}","starred_url":"https://api.github.com/users/Mickeon/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Mickeon/subscriptions","organizations_url":"https://api.github.com/users/Mickeon/orgs","repos_url":"https://api.github.com/users/Mickeon/repos","events_url":"https://api.github.com/users/Mickeon/events{/privacy}","received_events_url":"https://api.github.com/users/Mickeon/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-08-14T18:35:49Z","updated_at":"2026-08-14T18:35:49Z","body":"Given the kind of bug this would address, I wonder if it would be reasonable to backport to _at least_ 4.7, or if it's too risky to do so","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5296862419/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5297052915","html_url":"https://github.com/godotengine/godot/pull/122412#issuecomment-5297052915","issue_url":"https://api.github.com/repos/godotengine/godot/issues/122412","id":5297052915,"node_id":"IC_kwDOAO6SJc8AAAABO7qc8w","user":{"login":"akien-mga","id":4701338,"node_id":"MDQ6VXNlcjQ3MDEzMzg=","avatar_url":"https://avatars.githubusercontent.com/u/4701338?v=4","gravatar_id":"","url":"https://api.github.com/users/akien-mga","html_url":"https://github.com/akien-mga","followers_url":"https://api.github.com/users/akien-mga/followers","following_url":"https://api.github.com/users/akien-mga/following{/other_user}","gists_url":"https://api.github.com/users/akien-mga/gists{/gist_id}","starred_url":"https://api.github.com/users/akien-mga/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/akien-mga/subscriptions","organizations_url":"https://api.github.com/users/akien-mga/orgs","repos_url":"https://api.github.com/users/akien-mga/repos","events_url":"https://api.github.com/users/akien-mga/events{/privacy}","received_events_url":"https://api.github.com/users/akien-mga/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-08-14T18:56:54Z","updated_at":"2026-08-14T19:06:04Z","body":"> Given the kind of bug this would address, I wonder if it would be reasonable to backport to _at least_ 4.7, or if it's too risky to do so\r\n\r\nSadly changing the version of Emscripten used to compile official builds is compatibility breaking for GDExtension, so we shouldn't do that change in a maintenance release.\r\n\r\nWe could look into patching Emscripten 4.0.20 in our build container to fix that bug in 4.7.x builds though, if the fix wouldn't break compatibility in itself with GDExtensions compiled with a non-patched Emscripten 4.0.20.","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5297052915/reactions","total_count":2,"+1":2,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5316161630","html_url":"https://github.com/godotengine/godot/pull/122412#issuecomment-5316161630","issue_url":"https://api.github.com/repos/godotengine/godot/issues/122412","id":5316161630,"node_id":"IC_kwDOAO6SJc8AAAABPN4wXg","user":{"login":"mihe","id":4884246,"node_id":"MDQ6VXNlcjQ4ODQyNDY=","avatar_url":"https://avatars.githubusercontent.com/u/4884246?v=4","gravatar_id":"","url":"https://api.github.com/users/mihe","html_url":"https://github.com/mihe","followers_url":"https://api.github.com/users/mihe/followers","following_url":"https://api.github.com/users/mihe/following{/other_user}","gists_url":"https://api.github.com/users/mihe/gists{/gist_id}","starred_url":"https://api.github.com/users/mihe/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/mihe/subscriptions","organizations_url":"https://api.github.com/users/mihe/orgs","repos_url":"https://api.github.com/users/mihe/repos","events_url":"https://api.github.com/users/mihe/events{/privacy}","received_events_url":"https://api.github.com/users/mihe/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-08-17T12:40:55Z","updated_at":"2026-08-17T12:40:55Z","body":"```\r\n5.0.7 - 04/30/26\r\n----------------\r\n- The filesystem opteration that create new files now honor the global umask,\r\n  which defaults for 0o222 and can be updated by calling `umask()`. (#50739)\r\n```\r\n\r\nFYI, this changelog entry was apparently mistyped upstream. The new default umask is `0o022` (see [here](https://github.com/emscripten-core/emscripten/pull/22589)), not `0o222`, changed from the previous default of `0o777`, so more permissive either way. So that shouldn't cause any trouble obviously, and as far as I can tell it only seems to relate to Emscripten's NODEFS filesystem anyway, as opposed to the IDBFS one we use.\r\n\r\n`select`/`poll` don't seem to be used in any files relevant to web either, so that to-do item can be considered resolved I guess.","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5316161630/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5318205489","html_url":"https://github.com/godotengine/godot/pull/122412#issuecomment-5318205489","issue_url":"https://api.github.com/repos/godotengine/godot/issues/122412","id":5318205489,"node_id":"IC_kwDOAO6SJc8AAAABPP1gMQ","user":{"login":"akien-mga","id":4701338,"node_id":"MDQ6VXNlcjQ3MDEzMzg=","avatar_url":"https://avatars.githubusercontent.com/u/4701338?v=4","gravatar_id":"","url":"https://api.github.com/users/akien-mga","html_url":"https://github.com/akien-mga","followers_url":"https://api.github.com/users/akien-mga/followers","following_url":"https://api.github.com/users/akien-mga/following{/other_user}","gists_url":"https://api.github.com/users/akien-mga/gists{/gist_id}","starred_url":"https://api.github.com/users/akien-mga/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/akien-mga/subscriptions","organizations_url":"https://api.github.com/users/akien-mga/orgs","repos_url":"https://api.github.com/users/akien-mga/repos","events_url":"https://api.github.com/users/akien-mga/events{/privacy}","received_events_url":"https://api.github.com/users/akien-mga/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-08-17T17:30:42Z","updated_at":"2026-08-17T17:30:42Z","body":"> [ ] Test GDExtension support (`dlink_enabled=yes`).\r\n\r\nI tested this briefly with https://github.com/akien-mga/threen\r\n\r\n- I built the GDExtension with Emscripten 4.0.20 and loaded it in a Godot 4.7.1-stable template fine (using latest godot-cpp and `api_version=4.3`)\r\n- I built a new template from this PR with Emscripten 6.0.1, used it as custom template in a Godot 4.8-dev Linux editor build and it also seemed to work fine with the 4.0.20-compiled extension (seems like my small extension doesn't trigger potential ABI breakage)\r\n- I rebuilt the GDExtension with Emscripten 6.0.1 and it also loaded fine with both the 4.0.20 (vanilla 4.7.1) and 6.0.1 (4.8-dev) templates.","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5318205489/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5327385427","html_url":"https://github.com/godotengine/godot/pull/122412#issuecomment-5327385427","issue_url":"https://api.github.com/repos/godotengine/godot/issues/122412","id":5327385427,"node_id":"IC_kwDOAO6SJc8AAAABPYlzUw","user":{"login":"akien-mga","id":4701338,"node_id":"MDQ6VXNlcjQ3MDEzMzg=","avatar_url":"https://avatars.githubusercontent.com/u/4701338?v=4","gravatar_id":"","url":"https://api.github.com/users/akien-mga","html_url":"https://github.com/akien-mga","followers_url":"https://api.github.com/users/akien-mga/followers","following_url":"https://api.github.com/users/akien-mga/following{/other_user}","gists_url":"https://api.github.com/users/akien-mga/gists{/gist_id}","starred_url":"https://api.github.com/users/akien-mga/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/akien-mga/subscriptions","organizations_url":"https://api.github.com/users/akien-mga/orgs","repos_url":"https://api.github.com/users/akien-mga/repos","events_url":"https://api.github.com/users/akien-mga/events{/privacy}","received_events_url":"https://api.github.com/users/akien-mga/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-08-18T11:15:50Z","updated_at":"2026-08-18T11:15:50Z","body":"> If someone could test `arch=wasm64` and confirm whether the breakage come