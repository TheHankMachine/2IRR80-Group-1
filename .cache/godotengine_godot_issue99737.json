ect(\"pressed\", Callable.From(delegate { GD.Print(\"pressed\"); }), (uint)ConnectFlags.Persist);\n    Node newButton = button.Duplicate();\n    container.AddChild(newButton);\n}\n```\n\nWhen I run the project, pressing the original button will print \"pressed\" to the console, and the duplicated button does nothing.\n\n### Minimal reproduction project (MRP)\n\n[connect-signal-persist.zip](https://github.com/user-attachments/files/17927495/connect-signal-persist.zip)\n","closed_by":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/99737/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/godotengine/godot/issues/99737/timeline","performed_via_github_app":null,"state_reason":null,"pinned_comment":null}