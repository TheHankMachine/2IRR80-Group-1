[{"id":5237632474,"node_id":"PRR_kwDOAO6SJc8AAAABOC_t2g","user":{"login":"Ivorforce","id":2308167,"node_id":"MDQ6VXNlcjIzMDgxNjc=","avatar_url":"https://avatars.githubusercontent.com/u/2308167?u=f7f8e0273f784f5ec6f6b7fe4a88d449896eb48a&v=4","gravatar_id":"","url":"https://api.github.com/users/Ivorforce","html_url":"https://github.com/Ivorforce","followers_url":"https://api.github.com/users/Ivorforce/followers","following_url":"https://api.github.com/users/Ivorforce/following{/other_user}","gists_url":"https://api.github.com/users/Ivorforce/gists{/gist_id}","starred_url":"https://api.github.com/users/Ivorforce/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Ivorforce/subscriptions","organizations_url":"https://api.github.com/users/Ivorforce/orgs","repos_url":"https://api.github.com/users/Ivorforce/repos","events_url":"https://api.github.com/users/Ivorforce/events{/privacy}","received_events_url":"https://api.github.com/users/Ivorforce/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"I think this is fine.\n\nI'm very uncomfortable with the status quo of this in general: \"Abstract\" coupled with \"exposed with the editor\" coupled with \"exposed at runtime\" doesn't make a lot of sense, and it shows in that neither adding a creation function nor not adding one seems quite right.\n\nIt's notable that this change would change `GDREGISTER_INTERNAL_CLASS` to register the class as abstract too.\nPractically that's more in line with the idea that `GDREGISTER_INTERNAL_CLASS` is \"neutral\" to not registering it at all, which is why I would consider it a win anyway.\n\nLong term I'd like to reduce the weird coupling, but yea that's future work.","state":"APPROVED","html_url":"https://github.com/godotengine/godot/pull/122840#pullrequestreview-5237632474","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/122840","author_association":"MEMBER","_links":{"html":{"href":"https://github.com/godotengine/godot/pull/122840#pullrequestreview-5237632474"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/122840"}},"submitted_at":"2026-09-17T15:07:08Z","commit_id":"9519779f2ef5c38ec12f62b7957308a26bdfe1e8"}]