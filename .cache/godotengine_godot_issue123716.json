lor":"e4e4e4","default":false,"description":"","archived_at":null,"archived_by":null},{"id":279128044,"node_id":"MDU6TGFiZWwyNzkxMjgwNDQ=","url":"https://api.github.com/repos/godotengine/godot/labels/confirmed","name":"confirmed","color":"aaddaa","default":false,"description":"","archived_at":null,"archived_by":null},{"id":890310664,"node_id":"MDU6TGFiZWw4OTAzMTA2NjQ=","url":"https://api.github.com/repos/godotengine/godot/labels/topic:input","name":"topic:input","color":"ffee88","default":false,"description":"","archived_at":null,"archived_by":null}],"state":"closed","locked":false,"assignees":[],"milestone":{"url":"https://api.github.com/repos/godotengine/godot/milestones/25","html_url":"https://github.com/godotengine/godot/milestone/25","labels_url":"https://api.github.com/repos/godotengine/godot/milestones/25/labels","id":15520464,"node_id":"MI_kwDOAO6SJc4A7NLQ","number":25,"title":"4.8","description":"","creator":{"login":"Repiteo","id":17489292,"node_id":"MDQ6VXNlcjE3NDg5Mjky","avatar_url":"https://avatars.githubusercontent.com/u/17489292?v=4","gravatar_id":"","url":"https://api.github.com/users/Repiteo","html_url":"https://github.com/Repiteo","followers_url":"https://api.github.com/users/Repiteo/followers","following_url":"https://api.github.com/users/Repiteo/following{/other_user}","gists_url":"https://api.github.com/users/Repiteo/gists{/gist_id}","starred_url":"https://api.github.com/users/Repiteo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Repiteo/subscriptions","organizations_url":"https://api.github.com/users/Repiteo/orgs","repos_url":"https://api.github.com/users/Repiteo/repos","events_url":"https://api.github.com/users/Repiteo/events{/privacy}","received_events_url":"https://api.github.com/users/Repiteo/received_events","type":"User","user_view_type":"public","site_admin":false},"open_issues":345,"closed_issues":2336,"state":"open","created_at":"2026-04-13T15:59:35Z","updated_at":"2026-10-22T08:21:32Z","due_on":null,"closed_at":null},"comments":2,"created_at":"2026-09-22T16:35:44Z","updated_at":"2026-09-23T14:52:53Z","closed_at":"2026-09-23T14:43:12Z","assignee":null,"author_association":"NONE","issue_field_values":[],"type":null,"active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"### Tested versions\n\n- Reproducible in Godot 4.7.2 stable (`ed1daf0bf`)\n- Not reproduced when Windows is configured to use the previous version of Microsoft IME\n- Earlier Godot versions have not been tested\n\n\n\n### System information\n\nWindows 11 Home, build 26200 - Godot 4.7.2 stable - Compatibility renderer (OpenGL 3.3) - NVIDIA GeForce RTX 3090, driver 32.0.16.1692\n\n### Issue description\n\nWhen using the current Microsoft Japanese IME in a `LineEdit` or `TextEdit`, typing a new character immediately after converting Japanese text, without pressing Enter to explicitly confirm the conversion, replaces the last converted segment.\n\nFor example:\n\n1. Type `yamakawa`.\n2. Press Space to convert it to `山川`.\n3. Without pressing Enter, type `a`.\n\nExpected display:\n\n```text\n山川あ\n```\n\n```text\n山あ\n```\n\nThe last converted segment, `川`, is replaced by the new composition text. This occurs in both LineEdit and TextEdit.\n\nThe issue does not occur when either of the following workarounds is used:\n- Press Enter to explicitly confirm `山川` before typing `a`.\n- Enable “Use previous version of Microsoft IME” in the Windows Microsoft IME compatibility settings.\n\n### Steps to reproduce\n\n1. On Windows 11, enable the current Microsoft Japanese IME.\n2. Create a project containing either a LineEdit or a TextEdit.\n3. Run the project and focus the text control.\n4. Enable Hiragana input.\n5. Type `yamakawa`.\n6. Press Space to convert the text to `山川`.\n7. Do not press Enter.\n8. Type `a`.\n9. Observe that the field displays `山あ` instead of `山川あ`. \n\n### Minimal reproduction project (MRP)\n\nA project containing only a focused LineEdit is sufficient to reproduce the issue. The issue is also reproducible after replacing the LineEdit with a TextEdit.","closed_by":{"login":"hukuda222","id":21185928,"node_id":"MDQ6VXNlcjIxMTg1OTI4","avatar_url":"https://avatars.githubusercontent.com/u/21185928?v=4","gravatar_id":"","url":"https://api.github.com/users/hukuda222","html_url":"https://github.com/hukuda222","followers_url":"https://api.github.com/users/hukuda222/followers","following_url":"https://api.github.com/users/hukuda222/following{/other_user}","gists_url":"https://api.github.com/users/hukuda222/gists{/gist_id}","starred_url":"https://api.github.com/users/hukuda222/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/hukuda222/subscriptions","organizations_url":"https://api.github.com/users/hukuda222/orgs","repos_url":"https://api.github.com/users/hukuda222/repos","events_url":"https://api.github.com/users/hukuda222/events{/privacy}","received_events_url":"https://api.github.com/users/hukuda222/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/123716/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/godotengine/godot/issues/123716/timeline","performed_via_github_app":null,"state_reason":"completed","pinned_comment":null}