fa8958834a78be4","user":{"login":"syntaxerror247","id":176927541,"node_id":"U_kgDOCouzNQ","avatar_url":"https://avatars.githubusercontent.com/u/176927541?v=4","gravatar_id":"","url":"https://api.github.com/users/syntaxerror247","html_url":"https://github.com/syntaxerror247","followers_url":"https://api.github.com/users/syntaxerror247/followers","following_url":"https://api.github.com/users/syntaxerror247/following{/other_user}","gists_url":"https://api.github.com/users/syntaxerror247/gists{/gist_id}","starred_url":"https://api.github.com/users/syntaxerror247/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/syntaxerror247/subscriptions","organizations_url":"https://api.github.com/users/syntaxerror247/orgs","repos_url":"https://api.github.com/users/syntaxerror247/repos","events_url":"https://api.github.com/users/syntaxerror247/events{/privacy}","received_events_url":"https://api.github.com/users/syntaxerror247/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"> Do you remember why it was necessary before? --> #108287\r\nThis PR removes some of these checks.\r\n\r\nWithout any checks, setting the padding here was being applied even in immersive mode on older devices, while it worked as expected on Android 11+ devices. To fix the issue on older versions, I had added the check to apply padding only when not in immersive mode. However, since newer devices were returning the correct insets padding, I kept it to add padding even in immersive mode.\r\n\r\nI missed that this change caused a slight window shrink when the keyboard appeared, so I’m now updating it to always skip padding in immersive mode across all devices.","created_at":"2025-11-11T03:01:38Z","updated_at":"2025-11-11T03:03:26Z","html_url":"https://github.com/godotengine/godot/pull/112585#discussion_r2512670970","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/112585","_links":{"self":{"href":"https://api.github.com/repos/godotengine/godot/pulls/comments/2512670970"},"html":{"href":"https://github.com/godotengine/godot/pull/112585#discussion_r2512670970"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/112585"}},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/2512670970/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":385,"original_line":385,"side":"LEFT","in_reply_to_id":2511611453,"author_association":"MEMBER","original_position":4,"position":4,"subject_type":"line"}]