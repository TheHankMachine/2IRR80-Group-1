$ for the needed capacity. That could be a normal `uint32_t` or even `int32_t`. Core currently recommends against dynamic size types because they're less predictable and thus more prone to bugs.","created_at":"2026-07-11T13:34:51Z","updated_at":"2026-07-11T13:39:08Z","html_url":"https://github.com/godotengine/godot/pull/120483#discussion_r3564260582","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/120483","_links":{"self":{"href":"https://api.github.com/repos/godotengine/godot/pulls/comments/3564260582"},"html":{"href":"https://github.com/godotengine/godot/pull/120483#discussion_r3564260582"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/120483"}},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/3564260582/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":52,"original_line":52,"side":"RIGHT","in_reply_to_id":3446916795,"author_association":"MEMBER","original_position":8,"position":8,"subject_type":"line"},{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/3759548524","pull_request_review_id":4908171647,"id":3759548524,"node_id":"PRRC_kwDOAO6SJc7gFihs","diff_hunk":"@@ -45,21 +45,50 @@\n  */\n class EditorLanguage {\n public:\n+\t/**\n+\t * Zero based position in code.\n+\t */\n+\tstruct Position {\n+\t\tuint_fast32_t line;","path":"core/object/editor_language.h","commit_id":"015b70220c1e90cab8197ad41ccbde1b16c484d8","original_commit_id":"3c13bb4bdc8dcdfc7c01ed2ee9739881d908b989","user":{"login":"HolonProduction","id":99511741,"node_id":"U_kgDOBe5tvQ","avatar_url":"https://avatars.githubusercontent.com/u/99511741?v=4","gravatar_id":"","url":"https://api.github.com/users/HolonProduction","html_url":"https://github.com/HolonProduction","followers_url":"https://api.github.com/users/HolonProduction/followers","following_url":"https://api.gith