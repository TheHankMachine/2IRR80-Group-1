rchived_by":null},{"id":3240950060,"node_id":"MDU6TGFiZWwzMjQwOTUwMDYw","url":"https://api.github.com/repos/godotengine/godot/labels/performance","name":"performance","color":"447777","default":false,"description":"","archived_at":null,"archived_by":null}],"state":"closed","locked":false,"assignees":[],"milestone":{"url":"https://api.github.com/repos/godotengine/godot/milestones/22","html_url":"https://github.com/godotengine/godot/milestone/22","labels_url":"https://api.github.com/repos/godotengine/godot/milestones/22/labels","id":12070367,"node_id":"MI_kwDOAO6SJc4AuC3f","number":22,"title":"4.5","description":"","creator":{"login":"Sauermann","id":6299227,"node_id":"MDQ6VXNlcjYyOTkyMjc=","avatar_url":"https://avatars.githubusercontent.com/u/6299227?v=4","gravatar_id":"","url":"https://api.github.com/users/Sauermann","html_url":"https://github.com/Sauermann","followers_url":"https://api.github.com/users/Sauermann/followers","following_url":"https://api.github.com/users/Sauermann/following{/other_user}","gists_url":"https://api.github.com/users/Sauermann/gists{/gist_id}","starred_url":"https://api.github.com/users/Sauermann/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Sauermann/subscriptions","organizations_url":"https://api.github.com/users/Sauermann/orgs","repos_url":"https://api.github.com/users/Sauermann/repos","events_url":"https://api.github.com/users/Sauermann/events{/privacy}","received_events_url":"https://api.github.com/users/Sauermann/received_events","type":"User","user_view_type":"public","site_admin":false},"open_issues":3,"closed_issues":3687,"state":"closed","created_at":"2024-12-19T08:51:28Z","updated_at":"2026-09-04T21:48:38Z","due_on":"2025-09-15T00:00:00Z","closed_at":"2025-09-18T17:13:14Z"},"comments":1,"created_at":"2025-03-21T16:37:20Z","updated_at":"2025-03-24T00:13:09Z","closed_at":"2025-03-24T00:09:10Z","assignee":null,"author_association":"MEMBER","issue_field_values":[],"type":null,"active_lock_reason":null,"draft":false,"pull_request":{"url":"https://api.github.com/repos/godotengine/godot/pulls/104450","html_url":"https://github.com/godotengine/godot/pull/104450","diff_url":"https://github.com/godotengine/godot/pull/104450.diff","patch_url":"https://github.com/godotengine/godot/pull/104450.patch","merged_at":"2025-03-24T00:09:10Z"},"body":"This change decreases editor startup time by ~0.44s (10%).\r\n\r\nI believe this fixes a regression introduced by #61772 (so technically a `4.0` regression).\r\n\r\nIt should be possible to cherry-pick this change to earlier versions, but it's technically a behavior change (fonts that were previously loaded may error now, if an invalid font face index was provided). I'll let folks be the judge if that's worth it.\r\n\r\nI tested loading fonts with an invalid font face index. It returns early from the function and prints an error, as expected.\r\n\r\n## Explanation\r\nWhen prompted to load a font, `TextServerAdv` first finds the number of available faces in the font by passing `-1` into `FT_Open_Face`. This feature is [documented](https://freetype.org/freetype2/docs/reference/ft2-face_creation.html#ft_open_face) in the function's description. Unfortunately, the function description does not mention that the function still fully loads the font. In effect, this means we've been loading fonts twice as often as needed. \r\n\r\n## Benchmark\r\nI profiled a ~0.44s decrease in editor startup time:\r\n```\r\n ❯ hyperfine -m25 -iw1 \"bin/godot.macos.editor.arm64.master --path /Users/lukas/dev/godot/empty-game --editor --quit\" \"bin/godot.macos.editor.arm64 --path /Users/lukas/dev/godot/empty-game --editor --quit\"\r\nBenchmark 1: bin/godot.macos.editor.arm64.master --path /Users/lukas/dev/godot/empty-game --editor --quit\r\n  Time (mean ± σ):      4.738 s ±  0.146 s    [User: 3.250 s, System: 0.400 s]\r\n  Range (min … max):    4.357 s …  4.925 s    25 runs\r\n\r\nBenchmark 2: bin/godot.macos.editor.arm64 --path /Users/lukas/dev/godot/empty-game --editor --quit\r\n  Time (mean ± σ):      4.297 s ±  0.093 s    [User: 2.827 s, System: 0.394 s]\r\n  Range (min … max):    4.133 s …  4.386 s    25 runs\r\n```\r\n\r\n## Addendum\r\nFont loading is still a large contributor to editor startup time (6%). It may be possible to further decrease the amount of times fonts are loaded. But this would require a more invasive change.","closed_by":{"login":"Repiteo","id":17489292,"node_id":"MDQ6VXNlcjE3NDg5Mjky","avatar_url":"https://avatars.githubusercontent.com/u/17489292?v=4","gravatar_id":"","url":"https://api.github.com/users/Repiteo","html_url":"https://github.com/Repiteo","followers_url":"https://api.github.com/users/Repiteo/followers","following_url":"https://api.github.com/users/Repiteo/following{/other_user}","gists_url":"https://api.github.com/users/Repiteo/gists{/gist_id}","starred_url":"https://api.github.com/users/Repiteo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Repiteo/subscriptions","organizations_url":"https://api.github.com/users/Repiteo/orgs","repos_url":"https://api.github.com/users/Repiteo/repos","events_url":"https://api.github.com/users/Repiteo/events{/privacy}","received_events_url":"https://api.github.com/users/Repiteo/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/104450/reactions","total_count":31,"+1":18,"-1":0,"laugh":0,"hooray":8,"confused":0,"heart":2,"rocket":3,"eyes":0},"timeline_url":"https://api.github.com/repos/godotengine/godot/issues/104450/timeline","performed_via_github_app":null,"state_reason":null}