[{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3794588127","html_url":"https://github.com/godotengine/godot/issues/115331#issuecomment-3794588127","issue_url":"https://api.github.com/repos/godotengine/godot/issues/115331","id":3794588127,"node_id":"IC_kwDOAO6SJc7iLNHf","user":{"login":"BinaryGleam","id":42295409,"node_id":"MDQ6VXNlcjQyMjk1NDA5","avatar_url":"https://avatars.githubusercontent.com/u/42295409?v=4","gravatar_id":"","url":"https://api.github.com/users/BinaryGleam","html_url":"https://github.com/BinaryGleam","followers_url":"https://api.github.com/users/BinaryGleam/followers","following_url":"https://api.github.com/users/BinaryGleam/following{/other_user}","gists_url":"https://api.github.com/users/BinaryGleam/gists{/gist_id}","starred_url":"https://api.github.com/users/BinaryGleam/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/BinaryGleam/subscriptions","organizations_url":"https://api.github.com/users/BinaryGleam/orgs","repos_url":"https://api.github.com/users/BinaryGleam/repos","events_url":"https://api.github.com/users/BinaryGleam/events{/privacy}","received_events_url":"https://api.github.com/users/BinaryGleam/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-01-24T12:56:33Z","updated_at":"2026-01-24T12:56:33Z","body":"Chat GPT said it was normal and there was nothing to do about it except playing or loading all the sounds manually but I don't trust what Chat GPT tells me, I wanted to have a more professional feedback on that. And even if it is true, I think that anyone using the engine professionally or casually would be surprised about such an easy way to have performance issue with a web build. As you can see in my MRP, there's literally NOTHING. Just 2 .ogg files and a play call from an audiostream. That's all you need to have performance issues","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/