[{"id":3713453426,"node_id":"PRR_kwDOAO6SJc7dVs1y","user":{"login":"bruvzg","id":7645683,"node_id":"MDQ6VXNlcjc2NDU2ODM=","avatar_url":"https://avatars.githubusercontent.com/u/7645683?u=2867ee7fcd920bc19b7d1cbf4b10264b9bbc9326&v=4","gravatar_id":"","url":"https://api.github.com/users/bruvzg","html_url":"https://github.com/bruvzg","followers_url":"https://api.github.com/users/bruvzg/followers","following_url":"https://api.github.com/users/bruvzg/following{/other_user}","gists_url":"https://api.github.com/users/bruvzg/gists{/gist_id}","starred_url":"https://api.github.com/users/bruvzg/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/bruvzg/subscriptions","organizations_url":"https://api.github.com/users/bruvzg/orgs","repos_url":"https://api.github.com/users/bruvzg/repos","events_url":"https://api.github.com/users/bruvzg/events{/privacy}","received_events_url":"https://api.github.com/users/bruvzg/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"`RegEx` is used a lot, so it makes sense to move it to the core.\n\n> as we were never using the 16-bit ones in practice (maybe ever, but certainly not since String used UTF-32 internally)\n\nProbably was use when `String` was `wchar_t` (which is 16-bit on Windows), but should not be needed now.","state":"COMMENTED","html_url":"https://github.com/godotengine/godot/pull/115474#pullrequestreview-3713453426","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/115474","author_association":"MEMBER","_links":{"html":{"href":"https://github.com/godotengine/godot/pull/115474#pullrequestreview-3713453426"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/115474"}},"submitted_at":"2026-01-27T21:05:06Z","commit_id":"8b4272cbe9eaa214dceb09f764cda9c3151a4d8f"},{"id":4810310621,"node_id":"PRR_kwDOAO6SJc8AAAABHreD3Q","user":{"login":"hpvb","id":2591099,"node_id":"MDQ6VXNlcjI1OTEwOTk=","avatar_url":"https://avatars.githubusercontent.com/u/2591099?u=7bcd4921b265b0b8cc1d8a15638a3fac93c87e68&v=4","gravatar_id":"","url":"https://api.github.com/users/hpvb","html_url":"https://github.com/hpvb","followers_url":"https://api.github.com/users/hpvb/followers","following_url":"https://api.github.com/users/hpvb/following{/other_user}","gists_url":"https://api.github.com/users/hpvb/gists{/gist_id}","starred_url":"https://api.github.com/users/hpvb/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/hpvb/subscriptions","organizations_url":"https://api.github.com/users/hpvb/orgs","repos_url":"https://api.github.com/users/hpvb/repos","events_url":"https://api.github.com/users/hpvb/events{/privacy}","received_events_url":"https://api.github.com/users/hpvb/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"We talked about this in the core meeting, we're come to the following conclusion: \r\n\r\n* Core/ depending on anything in modules/ is bad\r\n* Currently disabling the regex module disables random functionality and seems to pretend to work. For instance it changes the format in log files. This is unexpected behavior, and not what people would expect to sign up for.\r\n* If someone wants to take another stab at making PCRE compile-time optional we ask them to try again in such a way that it does not randomly changes non-regex behavior. So this would mean that all internal uses of Regex would have to be  rewritten so that disabling the regex functionality doesn't affect them.\r\n\r\nKill it with fire!","state":"APPROVED","html_url":"https://github.com/godotengine/godot/pull/115474#pullrequestreview-4810310621","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/115474","author_association":"MEMBER","_links":{"html":{"href":"https://github.com/godotengine/godot/pull/115474#pullrequestreview-4810310621"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/115474"}},"submitted_at":"2026-07-29T15:52:50Z","commit_id":"77ab4dcdf6398b79b4db4d42570aab62b9800b2f"}]