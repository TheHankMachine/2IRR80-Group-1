[{"id":4785641935,"node_id":"PRR_kwDOAO6SJc8AAAABHT8Zzw","state":"COMMENTED","commit_id":"70b825d4de78bf5edd416514da3308c0bd1ed8c0","user":{"site_admin":false,"suspended":false,"updated_at":"0001-01-01T00:00:00Z","avatar_url":"https://avatars.githubusercontent.com/u/2308167?u=f7f8e0273f784f5ec6f6b7fe4a88d449896eb48a&v=4","created_at":"0001-01-01T00:00:00Z","followers":0,"following":0,"html_url":"https://github.com/Ivorforce","id":2308167,"node_id":"MDQ6VXNlcjIzMDgxNjc=","login":"Ivorforce","type":"User","owned_private_repos":0,"public_gists":0,"public_repos":0,"total_private_repos":0,"url":"https://api.github.com/users/Ivorforce"},"body":"This looks ~ correct, but is incomplete: Crashes (https://github.com/godotengine/godot/issues/26131) will still trigger in the `validated_evaluate` path. \r\nThat's notably the case for release builds, which more eagerly use `validated_evaluate`.\r\n\r\nWorth noting that this is already the case for some other parts of this code too, since the `validated_evaluate` vs `evaluate` split doesn't seem to have a robust rule for how to deal with failing operands.\r\nSo perhaps worth approving and discussing the other parts some other time.","html_url":"https://github.com/godotengine/godot/pull/121740#pullrequestreview-4785641935","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/121740","author_association":"MEMBER","submitted_at":"2026-07-27T09:40:47Z"},{"id":4785690118,"node_id":"PRR_kwDOAO6SJc8AAAABHT_WBg","state":"COMMENTED","commit_id":"70b825d4de78bf5edd416514da3308c0bd1ed8c0","user":{"site_admin":false,"suspended":false,"updated_at":"0001-01-01T00:00:00Z","avatar_url":"https://avatars.githubusercontent.com/u/2308167?u=f7f8e0273f784f5ec6f6b7fe4a88d449896eb48a&v=4","created_at":"0001-01-01T00:00:00Z","followers":0,"following":0,"html_url":"https://github.com/Ivorforce","id":2308167,"node_id":"MDQ6VXNlcjIzMDgxNjc=","login":"Ivorforce","type":"User","owned_private_repos":0,"public_gists":0,"public_repos":0,"total_private_repos":0,"url":"https://api.github.com/users/Ivorforce"},"body":"Also worth noting that the `Vectorxi` <-> `int` paths are not covered and can crash the exact same way.\n\nShould probably address at least this one in the same PR.","html_url":"https://github.com/godotengine/godot/pull/121740#pullrequestreview-4785690118","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/121740","author_association":"MEMBER","submitted_at":"2026-07-27T09:47:23Z"},{"id":4891955567,"node_id":"PRR_kwDOAO6SJc8AAAABI5VRbw","state":"APPROVED","commit_id":"5c742ea0382425ad122a7b5806a0f2f39ceaf5ae","user":{"site_admin":false,"suspended":false,"updated_at":"0001-01-01T00:00:00Z","avatar_url":"https://avatars.githubusercontent.com/u/2308167?u=f7f8e0273f784f5ec6f6b7fe4a88d449896eb48a&v=4","created_at":"0001-01-01T00:00:00Z","followers":0,"following":0,"html_url":"https://github.com/Ivorforce","id":2308167,"node_id":"MDQ6VXNlcjIzMDgxNjc=","login":"Ivorforce","type":"User","owned_private_repos":0,"public_gists":0,"public_repos":0,"total_private_repos":0,"url":"https://api.github.com/users/Ivorforce"},"body":"Looks good.\nIt's a bit annoying that we have to do this, but I think this shape is good, and the minor boilerplate is worth the crash fix.","html_url":"https://github.com/godotengine/godot/pull/121740#pullrequestreview-4891955567","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/121740","author_association":"MEMBER","submitted_at":"2026-08-09T17:11:04Z"},{"id":4907782903,"node_id":"PRR_kwDOAO6SJc8AAAABJIbS9w","state":"CHANGES_REQUESTED","commit_id":"5c742ea0382425ad122a7b5806a0f2f39ceaf5ae","user":{"site_admin":false,"suspended":false,"updated_at":"0001-01-01T00:00:00Z","avatar_url":"https://avatars.githubusercontent.com/u/17489292?u=34072b401722100a7c0c0d61e37b376cf22b4545&v=4","created_at":"0001-01-01T00:00:00Z","followers":0,"following":0,"html_url":"https://github.com/Repiteo","id":17489292,"node_id":"MDQ6VXNlcjE3NDg5Mjky","login":"R