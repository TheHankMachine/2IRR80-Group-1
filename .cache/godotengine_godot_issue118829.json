macos","color":"e4e4e4","default":false,"description":"","archived_at":null,"archived_by":null},{"id":279098255,"node_id":"MDU6TGFiZWwyNzkwOTgyNTU=","url":"https://api.github.com/repos/godotengine/godot/labels/topic:platforms","name":"topic:platforms","color":"ffee88","default":false,"description":"","archived_at":null,"archived_by":null},{"id":1732720779,"node_id":"MDU6TGFiZWwxNzMyNzIwNzc5","url":"https://api.github.com/repos/godotengine/godot/labels/topic:gui","name":"topic:gui","color":"ffee88","default":false,"description":"","archived_at":null,"archived_by":null}],"state":"closed","locked":false,"assignees":[],"milestone":{"url":"https://api.github.com/repos/godotengine/godot/milestones/24","html_url":"https://github.com/godotengine/godot/milestone/24","labels_url":"https://api.github.com/repos/godotengine/godot/milestones/24/labels","id":14236899,"node_id":"MI_kwDOAO6SJc4A2Tzj","number":24,"title":"4.7","description":"","creator":{"login":"akien-mga","id":4701338,"node_id":"MDQ6VXNlcjQ3MDEzMzg=","avatar_url":"https://avatars.githubusercontent.com/u/4701338?v=4","gravatar_id":"","url":"https://api.github.com/users/akien-mga","html_url":"https://github.com/akien-mga","followers_url":"https://api.github.com/users/akien-mga/followers","following_url":"https://api.github.com/users/akien-mga/following{/other_user}","gists_url":"https://api.github.com/users/akien-mga/gists{/gist_id}","starred_url":"https://api.github.com/users/akien-mga/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/akien-mga/subscriptions","organizations_url":"https://api.github.com/users/akien-mga/orgs","repos_url":"https://api.github.com/users/akien-mga/repos","events_url":"https://api.github.com/users/akien-mga/events{/privacy}","received_events_url":"https://api.github.com/users/akien-mga/received_events","type":"User","user_view_type":"public","site_admin":false},"open_issues":3,"closed_issues":2535,"state":"closed","created_at":"2025-11-27T20:29:18Z","updated_at":"2026-10-20T18:39:31Z","due_on":null,"closed_at":"2026-06-19T16:54:35Z"},"comments":0,"created_at":"2026-04-22T02:10:27Z","updated_at":"2026-04-22T17:58:53Z","closed_at":"2026-04-22T17:57:22Z","assignee":null,"author_association":"NONE","issue_field_values":[],"type":null,"active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"### Tested versions\n\nFound in Godot 4.5.1, although I don't think much has changed with the Color Picker node since then.\n\n### System information\n\nGodot v4.5.1.stable.mono - macOS Tahoe (26.4.1) - Multi-window, 1 monitor - Metal (Forward+) - integrated Apple M4 Pro (Apple9) - Apple M4 Pro (14 threads) - 48.00 GiB memory\n\n### Issue description\n\nI received a complaint from a player asking why my game \"requires\" screen recording and was confused because it most certainly does not.\n\nThis issue concerns the Color Picker control node, I'm using the Color Picker to allow players to customize their color. The built-in color picker node provides a nicer user experience than separate RGB/HSL sliders so I thought I'd use it.\n\nOn macOS, the color picker emits this message saying that screen recording is not enabled, clicking the message takes them to their security settings to turn it on.\n\nI think this message appears because the Eye Dropper can't work without screen recording permission. However, there is no Eye Dropper in this color picker, so I don't know what the user gets for enabling this permission.\n\n<img width=\"604\" height=\"240\" alt=\"Image\" src=\"https://github.com/user-attachments/assets/e9048f4e-ed56-44b4-bae2-02355a0db64e\" />\n\nIn short: if **Sampler Visible** is turned off, this message should not show up because there is no sampler to require screen recording.\n\n### Steps to reproduce\n\n- (from a macOS device)\n- Ensure you do NOT have Screen Recording granted to Godot.\n- Create a Color Picker control node\n- You will see the `Screen Recording permission missing!` message, even in editor.\n- Uncheck all the boxes in the inspector, no matter how minimal you make the color picker, you cannot make this message go away.\n\n### Minimal reproduction project (MRP)\n\nI can upload an MRP if you really need one but this is trivial to reproduce.","closed_by":{"login":"Repiteo","id":17489292,"node_id":"MDQ6VXNlcjE3NDg5Mjky","avatar_url":"https://avatars.githubusercontent.com/u/17489292?v=4","gravatar_id":"","url":"https://api.github.com/users/Repiteo","html_url":"https://github.com/Repiteo","followers_url":"https://api.github.com/users/Repiteo/followers","following_url":"https://api.github.com/users/Repiteo/following{/other_user}","gists_url":"https://api.github.com/users/Repiteo/gists{/gist_id}","starred_url":"https://api.github.com/users/Repiteo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Repiteo/subscriptions","organizations_url":"https://api.github.com/users/Repiteo/orgs","repos_url":"https://api.github.com/users/Repiteo/repos","events_url":"https://api.github.com/users/Repiteo/events{/privacy}","received_events_url":"https://api.github.com/users/Repiteo/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/118829/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/godotengine/godot/issues/118829/timeline","performed_via_github_app":null,"state_reason":"completed","pinned_comment":null}