[{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2737102989","html_url":"https://github.com/godotengine/godot/issues/104369#issuecomment-2737102989","issue_url":"https://api.github.com/repos/godotengine/godot/issues/104369","id":2737102989,"node_id":"IC_kwDOAO6SJc6jJOCN","user":{"login":"Calinou","id":180032,"node_id":"MDQ6VXNlcjE4MDAzMg==","avatar_url":"https://avatars.githubusercontent.com/u/180032?v=4","gravatar_id":"","url":"https://api.github.com/users/Calinou","html_url":"https://github.com/Calinou","followers_url":"https://api.github.com/users/Calinou/followers","following_url":"https://api.github.com/users/Calinou/following{/other_user}","gists_url":"https://api.github.com/users/Calinou/gists{/gist_id}","starred_url":"https://api.github.com/users/Calinou/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Calinou/subscriptions","organizations_url":"https://api.github.com/users/Calinou/orgs","repos_url":"https://api.github.com/users/Calinou/repos","events_url":"https://api.github.com/users/Calinou/events{/privacy}","received_events_url":"https://api.github.com/users/Calinou/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-03-19T15:37:12Z","updated_at":"2025-03-19T15:38:39Z","body":"This is the nature of exclusive fullscreen. I'm surprised it only happens with V-Sync off though (perhaps because Windows forces V-Sync otherwise).\n\nThis won't happen if you use the Fullscreen mode instead of Exclusive Fullscreen, but latency may be higher. Visually, it should be identical to Exclusive Fullscreen after https://github.com/godotengine/godot/pull/88852 (which will be in 4.5).","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2737102989/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https