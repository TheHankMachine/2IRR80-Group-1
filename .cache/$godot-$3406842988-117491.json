0,"following":0,"html_url":"https://github.com/StarryWorm","id":41305715,"node_id":"MDQ6VXNlcjQxMzA1NzE1","login":"StarryWorm","type":"User","owned_private_repos":0,"public_gists":0,"public_repos":0,"total_private_repos":0,"url":"https://api.github.com/users/StarryWorm"},"body":"","html_url":"https://github.com/godotengine/godot/pull/117491#pullrequestreview-3960501692","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/117491","author_association":"CONTRIBUTOR","submitted_at":"2026-03-17T12:47:27Z"},{"id":3961061779,"node_id":"PRR_kwDOAO6SJc7sGQGT","state":"COMMENTED","user":{"site_admin":false,"suspended":false,"updated_at":"0001-01-01T00:00:00Z","avatar_url":"https://avatars.githubusercontent.com/u/4701338?u=4a42fd867f2c449fcc23adf635dd574dae98e6c2&v=4","created_at":"0001-01-01T00:00:00Z","followers":0,"following":0,"html_url":"https://github.com/akien-mga","id":4701338,"node_id":"MDQ6VXNlcjQ3MDEzMzg=","login":"akien-mga","type":"User","owned_private_repos":0,"public_gists":0,"public_repos":0,"total_private_repos":0,"url":"https://api.github.com/users/akien-mga"},"body":"","html_url":"https://github.com/godotengine/godot/pull/117491#pullrequestreview-3961061779","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/117491","author_association":"MEMBER","submitted_at":"2026-03-17T14:07:50Z"},{"id":3961377323,"node_id":"PRR_kwDOAO6SJc7sHdIr","state":"APPROVED","user":{"site_admin":false,"suspended":false,"updated_at":"0001-01-01T00:00:00Z","avatar_url":"https://avatars.githubusercontent.com/u/96648715?u=af70f5d107e9c1447f296643d5a566dab53d25e8&v=4","created_at":"0001-01-01T00:00:00Z","followers":0,"following":0,"html_url":"https://github.com/AThousandShips","id":96648715,"node_id":"U_kgDOBcK-Cw","login":"AThousandShips","type":"User","owned_private_repos":0,"public_gists":0,"public_repos":0,"total_private_repos":0,"url":"https://api.github.com/users/AThousandShips"},"body":"I think these changes make sense, the grouping is much clearer this way\r\n\r\nAutomating some of this would help a lot and ensure we maintain quality, and I don't see any issues in these files indicating that we're likely to run into any odd issues in PRs from this (and those would arguably just be surface level and not critically blocking a PR or causing issues, as far as I would guess)\r\n\r\nThe one thing I wish we could avoid is the space before the compat incs, might be possible some way but I don't think it's a blocker, and compared with the rest of the benefits from this I think it's absolutely a price worth paying for it\r\n\r\nTIWAGOS though as I've not evaluated any specific area concerns with include order, but that should probably be caught and we can get some feedback for specific cases\r\n\r\n---\r\n\r\nTL;DR; I agree with the changes in grouping and I think it helps improve readability and enforcement of this with minimal effort, but can't speak to the practical impact on the code itself","html_url":"https://github.com/godotengine/godot/pull/117491#pullrequestreview-3961377323","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/117491","author_association":"MEMBER","submitted_at":"2026-03-17T14:48:34Z"},{"id":3961467033,"node_id":"PRR_kwDOAO6SJc7sHzCZ","state":"COMMENTED","user":{"site_admin":false,"suspended":false,"updated_at":"0001-01-01T00:00:00Z","avatar_url":"https://avatars.githubusercontent.com/u/17489292?u=34072b401722100a7c0c0d61e37b376cf22b4545&v=4","created_at":"0001-01-01T00:00:00Z","followers":0,"following":0,"html_url":"https://github.com/Repiteo","id":17489292,"node_id":"MDQ6VXNlcjE3NDg5Mjky","login":"Repiteo","type":"User","owned_private_repos":0,"public_gists":0,"public_repos":0,"total_private_repos":0,"url":"https://api.github.com/users/Repiteo"},"body":"I like the idea of this a LOT, but from past experience with these options I'd say there's room to formalize matters even further. In particular: we should take advantage of `SortPriority`, to allow for ordering within a group without causing spaces. For example, the following would solve the gap issue for `*.compat.inc`:\n```diff\n   - Regex: ^\".*\\.compat\\.inc\"$\n-    Priority: 1\n+    Priority: 0\n+    SortPriority: 1\n```\nTrying to adjust this even further gets a bit messy, especially if we try to capture with a wildcard after the fact, but I would like to cover our bases as much as possible before fully formalizing anything","html_url":"https://github.com/godotengine/godot/pull/117491#pullrequestreview-3961467033","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/117491","author_association":"CONTRIBUTOR","submitted_at":"2026-03-17T14:57:22Z"},{"id":3961902461,"node_id":"PRR_kwDOAO6SJc7sJdV9","state":"APPROVED","user":{"site_admin":false,"suspended":false,"updated_at":"0001-01-01T00:00:00Z","avatar_url":"https://avatars.githubusercontent.com/u/96648715?u=af70f5d107e9c1447f296643d5a566dab53d25e8&v=4","created_at":"0001-01-01T00:00:00Z","followers":0,"following":0,"html_url":"https://github.com/AThousandShips","id":96648715,"node_id":"U_kgDOBcK-Cw","login":"AThousandShips","type":"User","owned_private_repos":0,"public_gists":0,"public_repos":0,"total_private_repos":0,"url":"https://api.github.com/users/AThousandShips"},"body":"Looks great now!","html_url":"https://github.com/godotengine/godot/pull/117491#pullrequestreview-3961902461","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/117491","author_association":"MEMBER","submitted_at":"2026-03-17T15:56:06Z"},{"id":3962942425,"node_id":"PRR_kwDOAO6SJc7sNbPZ","state":"APPROVED","user":{"site_admin":false,"suspended":false,"updated_at":"0001-01-01T00:00:00Z","avatar_url":"https://avatars.githubusercontent.com/u/17489292?u=34072b401722100a7c0c0d61e37b376cf22b4545&v=4","created_at":"0001-01-01T00:00:00Z","followers":0,"following":0,"html_url":"https://github.com/Repiteo","id":17489292,"node_id":"MDQ6VXNlcjE3NDg5Mjky","login":"Repiteo","type":"User","owned_private_repos":0,"public_gists":0,"public_repos":0,"total_private_repos":0,"url":"https://api.github.com/users/Repiteo"},"body":"While it could be further adjusted if desired, this is suitable for integration as-is","html_url":"https://github.com/godotengine/godot/pull/117491#pullrequestreview-3962942425","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/117491","author_association":"CONTRIBUTOR","submitted_at":"2026-03-17T18:37:02Z"},{"id":3962952802,"node_id":"PRR_kwDOAO6SJc7sNdxi","state":"COMMENTED","user":{"site_admin":false,"suspended":false,"updated_at":"0001-01-01T00:00:00Z","avatar_url":"https://avatars.githubusercontent.com/u/17489292?u=34072b401722100a7c0c0d61e37b376cf22b4545&v=4","created_at":"0001-01-01T00:00:00Z","followers":0,"following":0,"html_url":"https://github.com/Repiteo","id":17489292,"node_id":"MDQ6VXNlcjE3NDg5Mjky","login":"Repiteo","type":"User","owned_private_repos":0,"public_gists":0,"public_repos":0,"total_private_repos":0,"url":"https://api.github.com/users/Repiteo"},"body":"","html_url":"https://github.com/godotengine/godot/pull/117491#pullrequestreview-3962952802","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/117491","author_association":"CONTRIBUTOR","submitted_at":"2026-03-17T18:39:06Z"},{"id":3963145282,"node_id":"PRR_kwDOAO6SJc7sOMxC","state":"COMMENTED","user":{"site_admin":false,"suspended":false,"updated_at":"0001-01-01T00:00:00Z","avatar_url":"https://avatars.githubusercontent.com/u/4701338?u=4a42fd867f2c449fcc23adf635dd574dae98e6c2&v=4","created_at":"0001-01-01T00:00:00Z","followers":0,"following":0,"html_url":"https://github.com/akien-mga","id":4701338,"node_id":"MDQ6VXNlcjQ3MDEzMzg=","login":"akien-mga","type":"User","owned_private_repos":0,"public_gists":0,"public_repos":0,"total_private_repos":0,"url":"https://api.github.com/users/akien-mga"},"body":"","html_url":"https://github.com/godotengine/godot/pull/117491#pullrequestreview-3963145282","pull_request_url":"https://api.github.com/repos/