api.github.com/users/van800/followers","following_url":"https://api.github.com/users/van800/following{/other_user}","gists_url":"https://api.github.com/users/van800/gists{/gist_id}","starred_url":"https://api.github.com/users/van800/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/van800/subscriptions","organizations_url":"https://api.github.com/users/van800/orgs","repos_url":"https://api.github.com/users/van800/repos","events_url":"https://api.github.com/users/van800/events{/privacy}","received_events_url":"https://api.github.com/users/van800/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-03-15T10:35:15Z","updated_at":"2025-03-15T10:35:15Z","body":"@rsubtil  would you mind taking a look?","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2726427437/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2726443602","html_url":"https://github.com/godotengine/godot/issues/104078#issuecomment-2726443602","issue_url":"https://api.github.com/repos/godotengine/godot/issues/104078","id":2726443602,"node_id":"IC_kwDOAO6SJc6igjpS","user":{"login":"rsubtil","id":6501975,"node_id":"MDQ6VXNlcjY1MDE5NzU=","avatar_url":"https://avatars.githubusercontent.com/u/6501975?v=4","gravatar_id":"","url":"https://api.github.com/users/rsubtil","html_url":"https://github.com/rsubtil","followers_url":"https://api.github.com/users/rsubtil/followers","following_url":"https://api.github.com/users/rsubtil/following{/other_user}","gists_url":"https://api.github.com/users/rsubtil/gists{/gist_id}","starred_url":"https://api.github.com/users/rsubtil/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/rsubtil/subscriptions","organizations_url":"https://api.github.com/users/rsubtil/orgs","repos_url":"https://api.github.com/users/rsubtil/repos","events_url":"https://api.github.com/users/rsubtil/events{/privacy}","received_events_url":"https://api.github.com/users/rsubtil/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-03-15T11:02:16Z","updated_at":"2025-03-15T11:02:22Z","body":"> The issue is DAP-specific. Doesn't reproduce on Windows.\n\nThis detail here is intriguing. AFAIK the only changes made on DAP specific to Windows were https://github.com/godotengine/godot/commit/b8ae1c218c025f069b8017f2a84790f3f9869fd4. So the fact that this seems to crash on Linux is curious.\n\nAnyways, this has no issues on 4.1.2, so I'll do a bisect now and hopefully have news in a bit.","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2726443602/reactions","total_count":2,"+1":2,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2727574623","html_url":"https://github.com/godotengine/godot/issues/104078#issuecomment-2727574623","issue_url":"https://api.github.com/repos/godotengine/godot/issues/104078","id":2727574623,"node_id":"IC_kwDOAO6SJc6ik3xf","user":{"login":"rsubtil","id":6501975,"node_id":"MDQ6VXNlcjY1MDE5NzU=","avatar_url":"https://avatars.githubusercontent.com/u/6501975?v=4","gravatar_id":"","url":"https://api.github.com/users/rsubtil","html_url":"https://github.com/rsubtil","followers_url":"https://api.github.com/users/rsubtil/followers","following_url":"https://api.github.com/users/rsubtil/following{/other_user}","gists_url":"https://api.github.com/users/rsubtil/gists{/gist_id}","starred_url":"https://api.github.com/users/rsubtil/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/rsubtil/subscriptions","organizations_url":"https://api.github.com/users/rsubtil/orgs","repos_url":"https://api.github.com/users/rsubtil/repos","events_url":"https://api.github.com/users/rsubtil/events{/privacy}","received_events_url":"https://api.github.com/users/rsubtil/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-03-16T18:14:14Z","updated_at":"2025-03-16T18:14:14Z","body":"I've managed to find and fix this issue, which turned out to be an use-after-free bug. I didn't notice that the `breakpoint_list` array was having elements deleted while I'm iterating on it. Deferring this operation fixes the issue, and I've confirmed further with ASAN that there are no other pending issues of this nature.\n\nThere seems to have been some change in Godot between 4.2.2 and 4.3 that makes this crash very reliable on newer versions. When I initially said this had no issues on 4.1.2, the truth is that I had to \"spam\" breakpoints changes until eventually a crash occurs. I tried bisecting it out of curiosity to find which change made this behavior crash sooner, but I couldn't really pinpoint it.\n\nNow, while debugging this, I've found that my implementation of this part is, honestly, quite \"scuffed\" 😅. I noticed that new breakpoints keep being added with any DAP request without checking if they exist already, resulting in multiple breakpoints in the same place, growing exponentially. So, I want to delve a bit deeper on this to fix/rework the implementation to fix these bugs all in one go.","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2727574623/reactions","total_count":3,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":3,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2729953544","html_url":"https://github.com/godotengine/godot/issues/104078#issuecomment-2729953544","issue_url":"https://api.github.com/repos/godotengine/godot/issues/104078","id":2729953544,"node_id":"IC_kwDOAO6SJc6it8kI","user":{"login":"MetalDoppo","id":50968246,"node_id":"MDQ6VXNlcjUwOTY4MjQ2","avatar_url":"https://avatars.githubusercontent.com/u/50968246?v=4","gravatar_id":"","url":"https://api.github.com/users/MetalDoppo","html_url":"https://github.com/MetalDoppo","followers_url":"https://api.github.com/users/MetalDoppo/followers","following_url":"https://api.github.com/users/MetalDoppo/following{/other_user}","gists_url":"https://api.github.com/users/MetalDoppo/gists{/gist_id}","starred_url":"https://api.github.com/users/MetalDoppo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/MetalDoppo/subscriptions","organizations_url":"https://api.github.com/users/MetalDoppo/orgs","repos_url":"https://api.github.com/users/MetalDoppo/repos","events_url":"https://api.github.com/users/MetalDoppo/events{/privacy}","received_events_url":"https://api.github.com/users/MetalDoppo/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-03-17T15:27:31Z","updated_at":"2025-03-17T15:28:53Z","body":"@rsubtil I've observed another breakpoint-related behavior today. When debugging a GDScript code in the **external editor** if you hit a breakpoint and **change the code in the same line**, the breakpoint will be **removed till the end of the debug session**. But if in the same situation (start a debug session from an external editor) you'll change the code not in the external editor, but in the **godot engine script editor** and save your changes, **the breakpoint won't be removed**, and changes will be applied in the runtime. Do you think this issue might be connected to this bug report or if another ticket should be created for it?","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2729953544/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2734708082","html_url":"https://github.com/godotengine/godot/issues/104078#issuecomment-2734708082","issue_url":"https://api.github.com/repos/godotengine/godot/issues/104078","id":2734708082,"node_id":"IC_kwDOAO6SJc6jAFVy","user":{"login":"rsubtil","id":6501975,"node_id":"MDQ6VXNlcjY1MDE5NzU=","avatar_url":"https://avatars.githubusercontent.com/u/6501975?v=4","gravatar_id":"","url":"https://api.github.com/users/rsubtil","html_url":"https://github.com/rsubtil","followers_url":"https://api.github.com/users/rsubtil/followers","following_url":"https://api.github.com/users/rsubtil/following{/other_user}","gists_url":"https://api.github.com/users/rsubtil/gists{/gist_id}","starred_url":"https://api.github.com/users/rsubtil/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/rsubtil/subscriptions","organizations_url":"https://api.github.com/users/rsubtil/orgs","repos_url":"https://api.github.com/users/rsubtil/repos","events_url":"https://api.github.com/users/rsubtil/events{/privacy}","received_events_url":"https://api.github.com/users/rsubtil/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-03-18T20:56:04Z","updated_at":"2025-03-18T20:56:04Z","body":"It's very likely fixed with the other changes I'm making. I don't know which IDE you're using, but I haven't been able to replicate your scenario exactly in VSCode, because it doesn't send any request when the line numbers do not change since the last save. However, if I remove/add lines and save, I can replicate your issue.\n\nHopefully it does get fixed with the changes I'll make for this issue, but if it doesn't, and depending on the complexity of the changes that would be required, it might be better to open another ticket.","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/com