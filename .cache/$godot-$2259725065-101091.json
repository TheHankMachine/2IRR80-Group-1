[{"id":2541845014,"node_id":"PRR_kwDOAO6SJc6XgXoW","state":"COMMENTED","user":{"site_admin":false,"suspended":false,"updated_at":"0001-01-01T00:00:00Z","avatar_url":"https://avatars.githubusercontent.com/u/99511741?u=b7882c94f408976a2f79e8fe6e1ce27fbd48db74&v=4","created_at":"0001-01-01T00:00:00Z","followers":0,"following":0,"html_url":"https://github.com/HolonProduction","id":99511741,"node_id":"U_kgDOBe5tvQ","login":"HolonProduction","type":"User","owned_private_repos":0,"public_gists":0,"public_repos":0,"total_private_repos":0,"url":"https://api.github.com/users/HolonProduction"},"body":"In general I think that when the completion request arrives and the scene isn't loaded yet, we should not continue without owner and instead wait for loading to finish. The owner is not only used for node path completion, but also for argument options (e.g. suggesting animation names when doing `$AnimationPlayer.play()`).\r\n\r\nOtherwise two subsequent completion requests could lead to different results, I think that's not really great for the user experience.","html_url":"https://github.com/godotengine/godot/pull/101091#pullrequestreview-2541845014","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/101091","author_association":"MEMBER","submitted_at":"2025-01-10T09:28:19Z"},{"id":2542181153,"node_id":"PRR_kwDOAO6SJc6Xhpsh","state":"COMMENTED","user":{"site_admin":false,"suspended":false,"updated_at":"0001-01-01T00:00:00Z","avatar_url":"https://avatars.githubusercontent.com/u/50260825?u=646b8a3cba813e2ca0cd5e2e8a0dbfcaa8871169&v=4","created_at":"0001-01-01T00:00:00Z","followers":0,"following":0,"html_url":"https://github.com/dekaravanhoc","id":50260825,"node_id":"MDQ6VXNlcjUwMjYwODI1","login":"dekaravanhoc","type":"User","owned_private_repos":0,"public_gists":0,"public_repos":0,"total_private_repos":0,"url":"https://api.github.com/users/dekaravanhoc"},"body":"","html_url":"https://github.com/godotengine/godot/pull/101091#pullrequestreview-2542181153","pull