_at":"0001-01-01T00:00:00Z","followers":0,"following":0,"html_url":"https://github.com/dekaravanhoc","id":50260825,"node_id":"MDQ6VXNlcjUwMjYwODI1","login":"dekaravanhoc","type":"User","owned_private_repos":0,"public_gists":0,"public_repos":0,"total_private_repos":0,"url":"https://api.github.com/users/dekaravanhoc"},"body":"","html_url":"https://github.com/godotengine/godot/pull/101091#pullrequestreview-2542430280","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/101091","author_association":"CONTRIBUTOR","submitted_at":"2025-01-10T13:21:43Z"},{"id":2542440171,"node_id":"PRR_kwDOAO6SJc6Xio7r","state":"COMMENTED","user":{"site_admin":false,"suspended":false,"updated_at":"0001-01-01T00:00:00Z","avatar_url":"https://avatars.githubusercontent.com/u/99511741?u=b7882c94f408976a2f79e8fe6e1ce27fbd48db74&v=4","created_at":"0001-01-01T00:00:00Z","followers":0,"following":0,"html_url":"https://github.com/HolonProduction","id":99511741,"node_id":"U_kgDOBe5tvQ","login":"HolonProduction","type":"User","owned_private_repos":0,"public_gists":0,"public_repos":0,"total_private_repos":0,"url":"https://api.github.com/users/HolonProduction"},"body":"","html_url":"https://github.com/godotengine/godot/pull/101091#pullrequestreview-2542440171","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/101091","author_association":"MEMBER","submitted_at":"2025-01-10T13:26:36Z"},{"id":2670997203,"node_id":"PRR_kwDOAO6SJc6fNC7T","state":"CHANGES_REQUESTED","user":{"site_admin":false,"suspended":false,"updated_at":"0001-01-01T00:00:00Z","avatar_url":"https://avatars.githubusercontent.com/u/99511741?u=b7882c94f408976a2f79e8fe6e1ce27fbd48db74&v=4","created_at":"0001-01-01T00:00:00Z","followers":0,"following":0,"html_url":"https://github.com/HolonProduction","id":99511741,"node_id":"U_kgDOBe5tvQ","login":"HolonProduction","type":"User","owned_private_repos":0,"public_gists":0,"public_repos":0,"total_private_repos":0,"url":"https://api.github.com/users/HolonProduction"},"body":"Sorry for the long delay, had some exams to write.\r\n\r\nI tested the PR locally and it seems to work fine.\r\n\r\nI have to come back to one thing I brought up before though:\r\n\r\n> In general I think that when the completion request arrives and the scene isn't loaded yet, we should not continue without owner and instead wait for loading to finish.\r\n\r\nI was going to say, that this is not a deal breaker for me, but I read a bit more into the spec due to some other PR and noticed that implementation of file management (`didOpen`/`didClose`) is not required. I don't know any editor that does not implement those, but since it is part of the spec we should have a contingency plan for it. The easiest one, would be to block the current thread and finish loading inside of `get` (this would only happen on the first request, and not at all if `didOpen` is implemented and finished before).\r\n","html_url":"https://github.com/godotengine/godot/pull/101091#pullrequestreview-2670997203","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/101091","author_association":"MEMBER","submitted_at":"2025-03-10T15:36:01Z"},{"id":2671429674,"node_id":"PRR_kwDOAO6SJc6fOsgq","state":"COMMENTED","user":{"site_admin":false,"suspended":false,"updated_at":"0001-01-01T00:00:00Z","avatar_url":"https://avatars.githubusercontent.com/u/99511741?u=b7882c94f408976a2f79e8fe6e1ce27fbd48db74&v=4","created_at":"0001-01-01T00:00:00Z","followers":0,"following":0,"html_url":"https://github.com/HolonProduction","id":99511741,"node_id":"U_kgDOBe5tvQ","login":"HolonProduction","type":"User","owned_private_repos":0,"public_gists":0,"public_repos":0,"total_private_repos":0,"url":"https://api.github.com/users/HolonProduction"},"body":"","html_url":"https://github.com/godotengine/godot/pull/101091#pullrequestreview-2671429674","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/101091","author_association":"MEMBER","submitted_at":"2025-03-10T15:37:43Z"},{"id":2671942392,"node_id":"PRR_kwDOAO6SJc6fQpr4","state":"COMMENTED","user":{"site_admin":false,"suspended":false,"updated_at":"0001-01-01T00:00:00Z","avatar_url":"https://avatars.githubusercontent.com/u/99511741?u=b7882c94f408976a2f79e8fe6e1ce27fbd48db74&v=4","created_at":"0001-01-01T00:00:00Z","followers":0,"following":0,"html_url":"https://github.com/HolonProduction","id":99511741,"node_id":"U_kgDOBe5tvQ","login":"HolonProduction","type":"User","owned_private_repos":0,"public_gists":0,"public_repos":0,"total_private_repos":0,"url":"https://api.github.com/users/HolonProduction"},"body":"","html_url":"https://github.com/godotengine/godot/pull/101091#pullrequestreview-2671942392","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/101091","author_association":"MEMBER","submitted_at":"2025-03-10T19:01:51Z"},{"id":2740569181,"node_id":"PRR_kwDOAO6SJc6jWcRd","state":"COMMENTED","user":{"site_admin":false,"suspended":false,"updated_at":"0001-01-01T00:00:00Z","avatar_url":"https://avatars.githubusercontent.com/u/50260825?u=646b8a3cba813e2ca0cd5e2e8a0dbfcaa8871169&v=4","created_at":"0001-01-01T00:00:00Z","followers":0,"following":0,"html_url":"https://github.com/dekaravanhoc","id":50260825,"node_id":"MDQ6VXNlcjUwMjYwODI1","login":"dekaravanhoc","type":"User","owned_private_repos":0,"public_gists":0,"public_repos":0,"total_private_repos":0,"url":"https://api.github.com/users/dekaravanhoc"},"body":"","html_url":"https://github.com/godotengine/godot/pull/101091#pullrequestreview-2740569181","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/101091","author_association":"CONTRIBUTOR","submitted_at":"2025-04-03T16:48:47Z"},{"id":2740577308,"node_id":"PRR_kwDOAO6SJc6jWeQc","state":"COMMENTED","user":{"site_admin":false,"suspended":false,"updated_at":"0001-01-01T00:00:00Z","avatar_url":"https://avatars.githubusercontent.com/u/50260825?u=646b8a3cba813e2ca0cd5e2e8a0dbfcaa8871169&v=4","created_at":"0001-01-01T00:00:00Z","followers":0