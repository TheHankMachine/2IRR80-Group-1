.com/u/4701338?v=4","gravatar_id":"","url":"https://api.github.com/users/akien-mga","html_url":"https://github.com/akien-mga","followers_url":"https://api.github.com/users/akien-mga/followers","following_url":"https://api.github.com/users/akien-mga/following{/other_user}","gists_url":"https://api.github.com/users/akien-mga/gists{/gist_id}","starred_url":"https://api.github.com/users/akien-mga/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/akien-mga/subscriptions","organizations_url":"https://api.github.com/users/akien-mga/orgs","repos_url":"https://api.github.com/users/akien-mga/repos","events_url":"https://api.github.com/users/akien-mga/events{/privacy}","received_events_url":"https://api.github.com/users/akien-mga/received_events","type":"User","user_view_type":"public","site_admin":false},"open_issues":8,"closed_issues":4466,"state":"closed","created_at":"2024-02-14T11:52:07Z","updated_at":"2026-10-05T23:48:31Z","due_on":"2025-03-03T00:00:00Z","closed_at":"2025-03-19T09:35:35Z"},"comments":1,"created_at":"2024-11-11T01:12:04Z","updated_at":"2024-11-13T15:24:36Z","closed_at":"2024-11-13T14:39:26Z","assignee":{"login":"DarioSamo","id":538504,"node_id":"MDQ6VXNlcjUzODUwNA==","avatar_url":"https://avatars.githubusercontent.com/u/538504?v=4","gravatar_id":"","url":"https://api.github.com/users/DarioSamo","html_url":"https://github.com/DarioSamo","followers_url":"https://api.github.com/users/DarioSamo/followers","following_url":"https://api.github.com/users/DarioSamo/following{/other_user}","gists_url":"https://api.github.com/users/DarioSamo/gists{/gist_id}","starred_url":"https://api.github.com/users/DarioSamo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/DarioSamo/subscriptions","organizations_url":"https://api.github.com/users/DarioSamo/orgs","repos_url":"https://api.github.com/users/DarioSamo/repos","events_url":"https://api.github.com/users/DarioSamo/events{/privacy}","received_events_url":"https://api.github.com/users/DarioSamo/received_events","type":"User","user_view_type":"public","site_admin":false},"author_association":"NONE","issue_field_values":[],"type":null,"active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"### Tested versions\r\n\r\nI ran a delta and traced it back to PR #98701 \r\n\r\nReproducible in:\r\nedc60c63f1e29fafa5bdc058b18b346fde1f3b5b\r\n\r\nList of tested branches near the hit, crosses have broken shadows, ticks have working shadows.\r\n![384654029-f44e9289-732f-4756-affb-4881e5ec850b](https://github.com/user-attachments/assets/2c0a639e-73a4-469e-926c-1656f8237bb0)\r\n\r\n\r\n### System information\r\n\r\nGodot v4.4.dev.mono (edc60c63f) - Windows 10.0.19045 - Multi-window, 2 monitors - Vulkan (Forward+) - dedicated NVIDIA GeForce RTX 3070 Laptop GPU (NVIDIA; 31.0.15.3742) - 11th Gen Intel(R) Core(TM) i7-11800H @ 2.30GHz (16 threads)\r\n\r\n### Issue description\r\n\r\nThe issue does not present in the editor, it only shows up in the live scene (even with the mirror setup to run inside the Godot editor).\r\n\r\nBefore, shadows correctly drawn above and below transparent shapes:\r\n![384654212-ec1d3ecc-0716-4220-8897-24b6b07f0d4c](https://github.com/user-attachments/assets/540662a7-4f1e-4732-b6f0-e8a80fa65786)\r\n\r\nAfter:\r\n![384654583-5cb1415d-b09e-461d-92e4-4ce00ab3367d](https://github.com/user-attachments/assets/286c09de-9e7f-4234-aa99-0ab7f720a2ef)\r\n\r\nNote that there is no shadow above the transparent water surface (which is rendered via a view frustrum on a separate subview + camera). The orientation of the camera has an impact on what shadow detail is visible. If the camera goes below the water I disable the mirror/subviewport and the shadows draw correctly.\r\n\r\n### Steps to reproduce\r\n\r\nPlease note the MRP only shows the flaw when you run the scene, the shadows appear correct in the editor.\r\n\r\nI have included bare bone logic for reflection about a plane and linked the subviewport's texture to a transparent water texture. I have also ripped out most of the planner reflections logic such that this is not a valid example of a mirror. I included the reflection code for the frustum, disabled updates in-engine to simplify the code (dont change fit_mode).\r\n\r\nI whittled down the root cause to a single line, when the mirror camera's set_global_transform is passed a transform it has an impact on the shadow rendering on the scene's primary camera. In my MRP mirror.gd (line 138):\r\n`\tmirror_cam.set_global_transform(t)`\r\n\r\nIf you comment out this line then run the scene, uncommenting it will show the breakage of the scenes shadows.\r\n\r\n### Minimal reproduction project (MRP)\r\n\r\n[shadowbreakMRPTest.zip](https://github.com/user-attachments/files/17693844/shadowbreakMRPTest.zip)\r\n","closed_by":{"login":"Repiteo","id":17489292,"node_id":"MDQ6VXNlcjE3NDg5Mjky","avatar_url":"https://avatars.githubusercontent.com/u/17489292?v=4","gravatar_id":"","url":"https://api.github.com/users/Repiteo","html_url":"https://github.com/Repiteo","followers_url":"https://api.github.com/users/Repiteo/followers","following_url":"https://api.github.com/users/Repiteo/following{/other_user}","gists_url":"https://api.github.com/users/Repiteo/gists{/gist_id}","starred_url":"https://api.github.com/users/Repiteo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Repiteo/subscriptions","organizations_url":"https://api.github.com/users/Repiteo/orgs","repos_url":"https://api.github.com/users/Repiteo/repos","events_url":"https://api.github.com/users/Repiteo/events{/privacy}","received_events_url":"https://api.github.com/users/Repiteo/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/99040/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0