opic:gdscript","color":"ffee88","default":false,"description":"","archived_at":null,"archived_by":null},{"id":2304948121,"node_id":"MDU6TGFiZWwyMzA0OTQ4MTIx","url":"https://api.github.com/repos/godotengine/godot/labels/topic:codestyle","name":"topic:codestyle","color":"ffee88","default":false,"description":"","archived_at":null,"archived_by":null}],"state":"closed","locked":false,"assignees":[],"milestone":{"url":"https://api.github.com/repos/godotengine/godot/milestones/25","html_url":"https://github.com/godotengine/godot/milestone/25","labels_url":"https://api.github.com/repos/godotengine/godot/milestones/25/labels","id":15520464,"node_id":"MI_kwDOAO6SJc4A7NLQ","number":25,"title":"4.8","description":"","creator":{"login":"Repiteo","id":17489292,"node_id":"MDQ6VXNlcjE3NDg5Mjky","avatar_url":"https://avatars.githubusercontent.com/u/17489292?v=4","gravatar_id":"","url":"https://api.github.com/users/Repiteo","html_url":"https://github.com/Repiteo","followers_url":"https://api.github.com/users/Repiteo/followers","following_url":"https://api.github.com/users/Repiteo/following{/other_user}","gists_url":"https://api.github.com/users/Repiteo/gists{/gist_id}","starred_url":"https://api.github.com/users/Repiteo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Repiteo/subscriptions","organizations_url":"https://api.github.com/users/Repiteo/orgs","repos_url":"https://api.github.com/users/Repiteo/repos","events_url":"https://api.github.com/users/Repiteo/events{/privacy}","received_events_url":"https://api.github.com/users/Repiteo/received_events","type":"User","user_view_type":"public","site_admin":false},"open_issues":343,"closed_issues":2335,"state":"open","created_at":"2026-04-13T15:59:35Z","updated_at":"2026-10-22T06:28:22Z","due_on":null,"closed_at":null},"comments":3,"created_at":"2026-07-07T20:45:24Z","updated_at":"2026-07-09T18:21:49Z","closed_at":"2026-07-09T17:48:40Z","assignee":null,"author_association":"MEMBER","issue_field_values":[],"type":null,"active_lock_reason":null,"draft":false,"pull_request":{"url":"https://api.github.com/repos/godotengine/godot/pulls/121064","html_url":"https://github.com/godotengine/godot/pull/121064","diff_url":"https://github.com/godotengine/godot/pull/121064.diff","patch_url":"https://github.com/godotengine/godot/pull/121064.patch","merged_at":"2026-07-09T17:48:40Z"},"body":"## What problem(s) does this PR solve?\r\n\r\nUntil now, the GDScript AST had one `datatype` field which was present on all AST nodes, however access to this field was limited to certain subtypes (e.g. `ExpressionNode`, `ClassNode` and `FunctionNode`).\r\n\r\nThis PR removes the general datatype field and replaces it with dedicated type fields on subtypes, were relevant.\r\n\r\nThis makes working in the analyzer simpler, because things like \"Find usages\" doesn't flag a lot of irrelevant code. E.g. the type of variables and the type of expressions only interact in very limited places in the code, but previously with all storing the info in the same field it was very hard to narrow those down.\r\n\r\nIt also allowed untangling `decide_suite_type` which was used for multiple purposes and was written generically, taking `GDScriptParser::Node`. While splitting this for the specific usecases increases LOC count a little bit, I think it makes the code much easier to follow. I also predict that code could be further simplified for both of the usecases but that is out of scope for now.\r\n\r\n## Additional information\r\n\r\nThis PR is split into small commits, to make it easier to follow the reasoning behind the changes. So each commit represents a step for which it is reasonably possible to proof/check that no behavior is changed.\r\n\r\n","closed_by":{"login":"Repiteo","id":17489292,"node_id":"MDQ6VXNlcjE3NDg5Mjky","avatar_url":"https://avatars.githubusercontent.com/u/17489292?v=4","gravatar_id":"","url":"https://api.github.com/users/Repiteo","html_url":"https://github.com/Repiteo","followers_url":"https://api.github.com/users/Repiteo/followers","following_url":"https://api.github.com/users/Repiteo/following{/other_user}","gists_url":"https://api.github.com/users/Repiteo/gists{/gist_id}","starred_url":"https://api.github.com/users/Repiteo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Repiteo/subscriptions","organizations_url":"https://api.github.com/users/Repiteo/orgs","repos_url":"https://api.github.com/users/Repiteo/repos","events_url":"https://api.github.com/users/Repiteo/events{/privacy}","received_events_url":"https://api.github.com/users/Repiteo/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/121064/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/godotengine/godot/issues/121064/timeline","performed_via_github_app":null,"state_reason":null}