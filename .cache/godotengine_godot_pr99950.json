hat, when assigning an Array<T> to a PackedArray, that the array element is compatible with the packed array's element.\r\n\r\n![image](https://github.com/user-attachments/assets/385c0063-f6de-4de2-9f91-7e3ca3cd0122)\r\n\r\nThis is a potentially breaking change. Before this change, the invalid type would be converted to a default value. In this example, the packed array would silently become `[(0,0), (0,0)]`. This could be mitigated with a warning but I believe the proper behavior is to spout an error.","labels":[{"id":73330064,"node_id":"MDU6TGFiZWw3MzMzMDA2NA==","url":"https://api.github.com/repos/godotengine/godot/labels/bug","name":"bug","description":"","color":"ff6055","default":true,"archived_at":null,"archived_by":null},{"id":73330066,"node_id":"MDU6TGFiZWw3MzMzMDA2Ng==","url":"https://api.github.com/repos/godotengine/godot/labels/enhancement","name":"enhancement","description":"","color":"aaccff","default":true,"archived_at":null,"archived_by":null},{"id":279096997,"node_id":"MDU6TGFiZWwyNzkwOTY5OTc=","url":"https://api.github.com/repos/godotengine/godot/labels/archived","name":"archived","description":"","color":"aaaaaa","default":false,"archived_at":null,"archived_by":null},{"id":279097162,"node_id":"MDU6TGFiZWwyNzkwOTcxNjI=","url":"https://api.github.com/repos/godotengine/godot/labels/discussion","name":"discussion","description":"","color":"ccaaff","default":false,"archived_at":null,"archived_by":null},{"id":279098082,"node_id":"MDU6TGFiZWwyNzkwOTgwODI=","url":"https://api.github.com/repos/godotengine/godot/labels/topic:gdscript","name":"topic:gdscript","description":"","color":"ffee88","default":false,"archived_at":null,"archived_by":null},{"id":955079684,"node_id":"MDU6TGFiZWw5NTUwNzk2ODQ=","url":"https://api.github.com/repos/godotengine/godot/labels/breaks%20compat","name":"breaks compat","description":"","color":"b64245","default":false,"archived_at":null,"archived_by":null}],"milestone":null,"active_lock_reason":null,"created_at":"2024-12-03T04:19: