) (/home/tomek/Godot/Source/scene/gui/control.cpp:4685)\r\nControl::_notification_forwardv(Control * const this, int p_notification) (/home/tomek/Godot/Source/scene/gui/control.h:46)\r\nContainer::_notification_forwardv(Container * const this, int p_notification) (/home/tomek/Godot/Source/scene/gui/container.h:36)\r\nMarginContainer::_notification_forwardv(MarginContainer * const this, int p_notification) (/home/tomek/Godot/Source/scene/gui/margin_container.h:36)\r\nObject::_notification_forward(Object * const this, int p_notification) (/home/tomek/Godot/Source/core/object/object.cpp:910)\r\nObject::notification(Object * const this, int p_notification, bool p_reversed) (/home/tomek/Godot/Source/core/object/object.h:725)\r\nControl::set_theme_type_variation(Control * const this, const StringName & p_theme_type) (/home/tomek/Godot/Source/scene/gui/control.cpp:3710)\r\nSceneTreeDock::_update_create_root_dialog_visibility(SceneTreeDock * const this) (/home/tomek/Godot/Source/editor/docks/scene_tree_dock.cpp:4722)\r\nSceneTreeDock::set_edited_scene(SceneTreeDock * const this, Node * p_scene) (/home/tomek/Godot/Source/editor/docks/scene_tree_dock.cpp:3472)\r\nEditorNode::_set_current_scene_nocheck(EditorNode * const this, int p_idx, bool p_ignore_state) (/home/tomek/Godot/Source/editor/editor_node.cpp:4785)\r\nEditorNode::_set_current_scene(EditorNode * const this, int p_idx) (/home/tomek/Godot/Source/editor/editor_node.cpp:4753)\r\nEditorNode::new_scene(EditorNode * const this) (/home/tomek/Godot/Source/editor/editor_node.cpp:4880)\r\nFileSystemDock::_make_scene_confirm(FileSystemDock * const this) (/home/tomek/Godot/Source/editor/docks/filesystem_dock.cpp:1800)\r\ncall_with_variant_args_helper<FileSystemDock>(FileSystemDock*, void (FileSystemDock::*)(), Variant const**, Callable::CallError&, IndexSequence<>)(FileSystemDock * p_instance, void (FileSystemDock::*)(FileSystemDock * const) p_method, const Variant ** p_args, Callable::CallError & r_error) (/home/tomek/Godot/Source/core/variant/binder_common.h:59)\r\ncall_with_variant_args<FileSystemDock>(FileSystemDock * p_instance, void (FileSystemDock::*)(FileSystemDock * const) p_method, const Variant ** p_args, int p_argcount, Callable::CallError & r_error) (/home/tomek/Godot/Source/core/variant/binder_common.h:173)\r\n```","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4882741871/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4882907039","html_url":"https://github.com/godotengine/godot/pull/111165#issuecomment-4882907039","issue_url":"https://api.github.com/repos/godotengine/godot/issues/111165","id":4882907039,"node_id":"IC_kwDOAO6SJc8AAAABIws_nw","user":{"login":"HolonProduction","id":99511741,"node_id":"U_kgDOBe5tvQ","avatar_url":"https://avatars.githubusercontent.com/u/99511741?v=4","gravatar_id":"","url":"https://api.github.com/users/HolonProduction","html_url":"https://github.com/HolonProduction","followers_url":"https://api.github.com/users/HolonProduction/followers","following_url":"https://api.github.com/users/HolonProduction/following{/other_user}","gists_url":"https://api.github.com/users/HolonProduction/gists{/gist_id}","starred_url":"https://api.github.com/users/HolonProduction/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/HolonProduction/subscriptions","organizations_url":"https://api.github.com/users/HolonProduction/orgs","repos_url":"https://api.github.com/users/HolonProduction/repos","events_url":"https://api.github.com/users/HolonProduction/events{/privacy}","received_events_url":"https://api.github.com/users/HolonProduction/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-07-04T15:50:25Z","updated_at":"2026-07-04T15:51:54Z","body":"I can try to fix this. But the issue lies further up in the call chain. `is_ancestor_of` is called on a `nullptr`. It just didn't crash previously since no members of `this` were accessed and we only had an `== this` check.\r\n\r\nThe issue seems to be coming from `is_part_of_edited_scene` which assumes `get_edited_scene_root()->get_parent()` is not null.\r\n\r\nI'm not sure which of those is the case here:\r\n- `is_part_of_edited_scene` is missing a null check.\r\n- `get_edited_scene_root()` must be in-tree. In this case it is set too early when creating new scenes.\r\n\r\nSo not sure what the appropriate fix would be.\r\n\r\n\r\n<img width=\"587\" height=\"382\" alt=\"image\" src=\"https://github.com/user-attachments/assets/7122afd9-21dd-4263-afa0-fd3ae047389b\" />\r\n","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4882907039/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4882968607","html_url":"https://github.com/godotengine/godot/pull/111165#issuecomment-4882968607","issue_url":"https://api.github.com/repos/godotengine/godot/issues/111165","id":4882968607,"node_id":"IC_kwDOAO6SJc8AAAABIwwwHw","user":{"login":"Ivorforce","id":2308167,"node_id":"MDQ6VXNlcjIzMDgxNjc=","avatar_url":"https://avatars.githubusercontent.com/u/2308167?v=4","gravatar_id":"","url":"https://api.github.com/users/Ivorforce","html_url":"https://github.com/Ivorforce","followers_url":"https://api.github.com/users/Ivorforce/followers","following_url":"https://api.github.com/users/Ivorforce/following{/other_user}","gists_url":"https://api.github.com/users/Ivorforce/gists{/gist_id}","starred_url":"https://api.github.com/users/Ivorforce/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Ivorforce/subscriptions","organizations_url":"https://api.github.com/users/Ivorforce/orgs","repos_url":"https://api.github.com/users/Ivorforce/repos","events_url":"https://api.github.com/users/Ivorforce/events{/privacy}","received_events_url":"https://api.github.com/users/Ivorforce/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-07-04T16:00:21Z","updated_at":"2026-07-04T16:00:21Z","body":"One more for the \"every core change breaks somebody's bad code\" bucket 😅\r\nI would definitely add a `nullptr` check to `is_part_of_edited_scene`. Defensive code is seldom wrong, especially since it's exposed. I don't know anything about `get_edited_scene_root` but if it's wrong too it's worth looking at.","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4882968607/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4882995192","html_url":"https://github.com/godotengine/godot/pull/111165#issuecomment-4882995192","issue_url":"https://api.github.com/repos/godotengine/godot/issues/111165","id":4882995192,"node_id":"IC_kwDOAO6SJc8AAAABIwyX-A","user":{"login":"KoBeWi","id":2223172,"node_id":"MDQ6VXNlcjIyMjMxNzI=","avatar_url":"https://avatars.githubusercontent.com/u/2223172?v=4","gravatar_id":"","url":"https://api.github.com/users/KoBeWi","html_url":"https://github.com/KoBeWi","followers_url":"https://api.github.com/users/KoBeWi/followers","following_url":"https://api.github.com/users/KoBeWi/following{/other_user}","gists_url":"https://api.github.com/users/KoBeWi/gists{/gist_id}","starred_url":"https://api.github.com/users/KoBeWi/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/KoBeWi/subscriptions","organizations_url":"https://api.github.com/users/KoBeWi/orgs","repos_url":"https://api.github.com/users/KoBeWi/repos","events_url":"https://api.github.com/users/KoBeWi/events{/privacy}","received_events_url":"https://api.github.com/users/KoBeWi/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-07-04T16:07:38Z","updated_at":"2026-07-04T16:07:38Z","body":"> get_edited_scene_root() must be in-tree. In this case it is set too early when creating new scenes.\r\n\r\ntbh I was surprised it's not guaranteed to be in tree, so it needs to be looked into.\r\nBut adding extra null check is fine for now.","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4882995192/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4883034601","html_url":"https://github.com/godotengine/godot/pull/111165#issuecomment-4883034601","issue_url":"https://api.github.com/repos/godotengine/godot/issues/111165","id":4883034601,"node_id":"IC_kwDOAO6SJc8AAAABIw0x6Q","user":{"login":"HolonProduction","id":99511741,"node_id":"U_kgDOBe5tvQ","avatar_url":"https://avatars.githubusercontent.com/u/99511741?v=4","gravatar_id":"","url":"https://api.github.com/users/HolonProduction","html_url":"https://github.com/HolonProduction","followers_url":"https://api.github.com/users/HolonProduction/followers","following_url":"https://api.github.com/users/HolonProduction/following{/other_user}","gists_url":"https://api.github.com/users/HolonProduction/gists{/gist_id}","starred_url":"https://api.github.com/users/HolonProduction/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/HolonProduction/subscriptions","organizations_url":"https://api.github.com/users/HolonProduction/orgs","repos_url":"https://api.github.com/users/HolonProduction/repos","events_url":"https://api.github.com/users/HolonProduction/events{/privacy}","received_events_url":"https://api.github.com/u