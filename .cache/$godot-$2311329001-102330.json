5","login":"mrjustaguy","type":"User","owned_private_repos":0,"public_gists":0,"public_repos":0,"total_private_repos":0,"url":"https://api.github.com/users/mrjustaguy"},"body":"","html_url":"https://github.com/godotengine/godot/pull/102330#pullrequestreview-2713373789","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/102330","author_association":"CONTRIBUTOR","submitted_at":"2025-03-25T11:27:09Z"},{"id":2714041190,"node_id":"PRR_kwDOAO6SJc6hxPtm","state":"COMMENTED","user":{"site_admin":false,"suspended":false,"updated_at":"0001-01-01T00:00:00Z","avatar_url":"https://avatars.githubusercontent.com/u/180032?u=68d23e7ee9cdf810da125e8510b72f845b9dccc8&v=4","created_at":"0001-01-01T00:00:00Z","followers":0,"following":0,"html_url":"https://github.com/Calinou","id":180032,"node_id":"MDQ6VXNlcjE4MDAzMg==","login":"Calinou","type":"User","owned_private_repos":0,"public_gists":0,"public_repos":0,"total_private_repos":0,"url":"https://api.github.com/users/Calinou"},"body":"","html_url":"https://github.com/godotengine/godot/pull/102330#pullrequestreview-2714041190","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/102330","author_association":"MEMBER","submitted_at":"2025-03-25T14:42:00Z"},{"id":2714094737,"node_id":"PRR_kwDOAO6SJc6hxcyR","state":"COMMENTED","user":{"site_admin":false,"suspended":false,"updated_at":"0001-01-01T00:00:00Z","avatar_url":"https://avatars.githubusercontent.com/u/50302479?v=4","created_at":"0001-01-01T00:00:00Z","followers":0,"following":0,"html_url":"https://github.com/mrjustaguy","id":50302479,"node_id":"MDQ6VXNlcjUwMzAyNDc5","login":"mrjustaguy","type":"User","owned_private_repos":0,"public_gists":0,"public_repos":0,"total_private_repos":0,"url":"https://api.github.com/users/mrjustaguy"},"body":"","html_url":"https://github.com/godotengine/godot/pull/102330#pullrequestreview-2714094737","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/102330","author_association":"CONTRIBUTOR","submitted_at":"2025-03-25T14:55:36Z"},{"id":2714654987,"node_id":"PRR_kwDOAO6SJc6hzlkL","state":"COMMENTED","user":{"site_admin":false,"suspended":false,"updated_at":"0001-01-01T00:00:00Z","avatar_url":"https://avatars.githubusercontent.com/u/117452902?v=4","created_at":"0001-01-01T00:00:00Z","followers":0,"following":0,"html_url":"https://github.com/RGDTAB","id":117452902,"node_id":"U_kgDOBwAwZg","login":"RGDTAB","type":"User","owned_private_repos":0,"public_gists":0,"public_repos":0,"total_private_repos":0,"url":"https://api.github.com/users/RGDTAB"},"body":"","html_url":"https://github.com/godotengine/godot/pull/102330#pullrequestreview-2714654987","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/102330","author_association":"CONTRIBUTOR","submitted_at":"2025-03-25T17:46:46Z"},{"id":2714677110,"node_id":"PRR_kwDOAO6SJc6hzq92","state":"COMMENTED","user":{"site_admin":false,"suspended":false,"updated_at":"0001-01-01T00:00:00Z","avatar_url":"https://avatars.githubusercontent.com/u/180032?u=68d23e7ee9cdf810da125e8510b72f845b9dccc8&v=4","created_at":"0001-01-01T00:00:00Z","followers":0,"following":0,"html_url":"https://github.com/Calinou","id":180032,"node_id":"MDQ6VXNlcjE4MDAzMg==","login":"Calinou","type":"User","owned_private_repos":0,"public_gists":0,"public_repos":0,"total_private_repos":0,"url":"https://api.github.com/users/Calinou"},"body":"Tested locally, it fails to compile:\r\n\r\n```\r\nCompiling core/os/scu/scu_core_os.gen.cpp ...\r\nIn file included from servers/rendering/renderer_rd/effects/scu/scu_servers_rendering_renderer_rd_effects_1.gen.cpp:2:\r\n./servers/rendering/renderer_rd/effects/smaa.cpp: In constructor 'RendererRD::SMAA::SMAA()':\r\n./servers/rendering/renderer_rd/effects/smaa.cpp:126:45: error: 'core_bind' has not been declared\r\n  126 |                 Vector<uint8_t> png_bytes = core_bind::Marshalls::get_singleton()->base64_to_raw(areaTexPNG);\r\n      |                                             ^~~~~~~~~\r\nscons: *** [bin/obj/servers/rendering/renderer_rd/effects/scu/scu_servers_rendering_renderer_rd_effects_1.gen.linuxbsd.editor.x86_64.o] Error 1\r\nscons: building terminated because of errors.\r\nINFO: Time elapsed: 00:01:02.26 \r\n```\r\n\r\nReplacing `core_bind` with `CoreBind` fixes compilation.\r\n\r\nComparison between the [previous state](https://github.com/godotengine/godot/pull/102330#pullrequestreview-2599275683) and the current state of SMAA:\r\n\r\nOld SMAA | Current SMAA\r\n-|-\r\n![Old SMAA](https://github.com/user-attachments/assets/e01d74ff-ecce-4627-b804-627e34f64f70) | ![Current SMAA](https://github.com/user-attachments/assets/4a719f61-280b-459b-84fe-25a75a0165f5)\r\n\r\nIt looks much better now, likely thanks to the edge detection threshold tweak. It's much closer to Tesseract's SMAA implementation:\r\n\r\nCurrent SMAA | Tesseract SMAA\r\n-|-\r\n![Current SMAA](https://github.com/user-attachments/assets/4a719f61-280b-459b-84fe-25a75a0165f5) | ![Tesseract SMAA](https://github.com/user-attachments/assets/57eaeeef-6978-419b-a3ad-29b044d28a9c)","html_url":"https://github.com/godotengine/godot/pull/102330#pullrequestreview-2714677110","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/102330","author_association":"MEMBER","submitted_at":"2025-03-25T17:53:33Z"},{"id":2808806877,"node_id":"PRR_kwDOAO6SJc6nav3d","state":"COMMENTED","user":{"site_admin":false,"suspended":false,"updated_at":"0001-01-01T00:00:00Z","avatar_url":"https://avatars.githubusercontent.com/u/180032?u=68d23e7ee9cdf810da125e8510b72f845b9dccc8&v=4","created_at":"0001-01-01T00:00:00Z","followers":0,"following":0,"html_url":"https://github.com/Calinou","id":180032,"node_id":"MDQ6VXNlcjE4MDAzMg==","login":"Calinou","type":"User","owned_private_repos":0,"public_gists":0,"public_repos":0,"total_private_repos":0,"url":"https://api.github.com/users/Calinou"},"body":"Tested again, it works as expected on Forward+ only.\r\n\r\nIn Mobile, there's an issue where having SMAA enabled in the project settings has no effect in the running project (you need to change it at runtime for it to work). It will also be visible in the editor. In Forward+, it works on startup correctly. FXAA is also affected by this issue.\r\n\r\nIn Compatibility, there's now an error message printed when you try to enable either SMAA or FXAA (which is expected as neither is implemented there yet). We should probably harmonize these messages to turn them into warnings, but this can be done in a separate PR as there's many of them right now.\r\n\r\nIn the editor, a capitalization for `smaa` to `SMAA` should be added to this list in alphabetical order (as the **SMAA Edge Detection Threshold** project setting would then make use of it):\r\n\r\nhttps://github.com/godotengine/godot/blob/80a3d205f1ad22e779a64921fb56d62b893881ae/editor/editor_property_name_processor.cpp#L138\r\n\r\nAlso, I found a slight binary size optimization using oxipng:\r\n\r\n```\r\n❯ oxipng -Zso6 AreaTex.png SearchTex.png \r\nProcessing: AreaTex.png\r\nProcessing: SearchTex.png\r\n120 bytes (11.76% smaller): SearchTex.png\r\n27091 bytes (7.48% smaller): AreaTex.png\r\n```\r\n\r\nYou can integrate the textures from this ZIP to the PR: [smaa_textures.zip](https://github.com/user-attachments/files/19985156/smaa_textures.zip)\r\n\r\nI made sure fully transparent pixels are not affected this time (oxipng doesn't touch them by default).\r\n\r\n> [!NOTE]\r\n>\r\n> These figures take the above optimization I made into account.\r\n\r\nBinary size comparison for a Linux release export template:\r\n\r\n- `master`: 70,647,752 bytes\r\n- This PR: 70,713,320 bytes\r\n\r\nBinary size comparison for a web release export template:\r\n\r\n- `master`: 37,222,703 bytes\r\n- This PR: 37,225,000 bytes\r\n\r\nIt's only a 3 KB difference, but the web platform only includes the Compatibility rendering method, so this is expected.","html_url":"https://github.com/godotengine/godot/pull/102330#pullrequestreview-2808806877","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/102330","author_association":"MEMBER","submitted_at":"2025-04-30T23:22:22Z"},{"id":2808820484,"node_id":"PRR_kwDOAO6SJc6nazME","state":"COMMENTED","user":{"site_admin":false,"suspended":false,"updated_at":"0001-01-01T00:00:00Z","avatar_url":"https://avatars.githubusercontent.com/u/180032?u=68d23e7ee9cdf810da125e8510b72f845b9dccc8&v=4","created_at":"0001-01-01T00:00:00Z","followers":0,"following":0,"html_url":"https://github.com/Calinou","id":180032,"node_id":"MDQ6VXNlcjE4MDAzMg==","login":"Calinou","type":"User","owned_private_repos":0,"public_gists":0,"public_repos":0,"total_private_repos":0,"url":"https://api.github.com/users/Calinou"},"body":"","html_url":"https://github.com/godotengine/godot/pull/102330#pullrequestreview-2808820484","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/102330","author_association":"MEMBER","submitted_at":"2025-04-30T23:29:56Z"},{"id":2810892296,"node_id":"PRR_kwDOAO6SJc6nitAI","state":"COMMENTED","user":{"site_admin":false,"suspended":false,"updated_at":"0001-01-01T00:00:00Z","avatar_url":"https://avatars.githubusercontent.com/u/117452902?v=4","created_at":"0001-01-01T00:00:00Z","followers":0,"following":0,"html_url":"https://github.com/RGDTAB","id":117452902,"node_id":"U_kgDOBwAwZg","login":"RGDTAB","type":"User","owned_private_repos":0,"public_gists":0,"public_repos":0,"total_private_repos":0,"url":"https://api.github.com/users/RGDTAB"},"body":"","html_url":"https://github.com/godotengine/godot/pull/102330#pullrequestreview-2810892296","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/102330","author_association":"CONTRIBUTOR","submitted_at":"2025-05-01T22:52:38Z"},{"id":2831540942,"node_id":"PRR_kwDOAO6SJc6oxeLO","state":"COMMENTED","user":{"site_admin":false,"suspended":false,"updated_at":"0001-01-01T00:00:00Z","avatar_url":"https://avatars.githubusercontent.com/u/180032?u=68d23e7ee9cdf810da125e8510b72f845b9dccc8&v=4","created_at":"0001-01-01T00:00:00Z","followers":0,"following":0,"html_url":"https://github.com/Calinou","id":180032,"node_id":"MDQ6VXNlcjE4MDAzMg==","login":"Calinou","type":"User","owned_private_repos":0,"public_gists":0,"public_repos":0,"total_private_repos":0,"url":"https://api.github.com/users/Calinou"},"body":"","html_url":"https://github.com/godotengine/godot/pull/102330#pullrequestreview-2831540942","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/102330","author_association":"MEMBER","submitted_at":"2025-05-11T23:42:43Z"},{"id":2864997832,"node_id":"PRR_kwDOAO6SJc6qxGXI","state":"APPROVED","commit_id":"6b9960895041f93b729b62adcc972ecd42336292","user":{"site_admin":false,"suspended":false,"updated_at":"0001-01-01T00:00:00Z","avatar_url":"https://avatars.githubusercontent.com/u/16521339?u=e44a465cbebabb9ea2be80b59e6dc07966bef5b7&v=4","created_at":"0001-01-01T00:00:00Z","followers":0,"following":0,"html_url":"https://github.com/clayjohn","id":16521339,"node_id":"MDQ6VXNlcjE2NTIxMzM5","login":"clayjohn","type":"User","owned_private_repos":0,"public_gists":0,"public_repos":0,"total_private_repos":0,"url":"https://api.github.com/users/clayjohn"},"body":"","html_url":"https://github.com/godotengine/godot/pull/102330#pullrequestreview-2864997832","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/102330","author_association":"MEMBER","submitted_at":"2025-05-23T16:20:42Z"},{"id":2865231411,"node_id":"PRR_kwDOAO6SJc6qx_Yz","state":"APPROVED","commit_id":"6b9960895041f93b729b62adcc972ecd42336292","user":{"site_admin":false,"suspended":false,"updated_at":"0001-01-01T00:00:00Z","avatar_url":"https://avatars.githubusercontent.com/u/180032?u=68d23e7ee9cdf810da125e8510b72f845b9dccc8&v=4","created_at":"0001-01-01T00:00:00Z","followers":0,"following":0,"html_url":"https://github.com/Calinou","id":180032,"node_id":"MDQ6VXNlcjE4MDAzMg==","login":"Calinou","type":"User","owned_private_repos":0,"public_gists":0,"public_repos":0,"total_private_repos":0,"url":"https://api.github.com/users/Calinou"},"body":"Tested locally, it works as expected in all rendering methods (in Compatibility, an error is displayed as intended).\r\n\r\nI've also tested it in combination with TAA/FSR2 and it helps further reduce aliasing there, particularly in fast-moving scenes or just after a camera cut (the impact is more noticeable at lower FPS). Since SMAA doesn't blur the rendering as much as FXAA, it's more viable for this use case.","html_url":"https://github.com/godotengine/godot/pull/102330#pullrequestreview-2865231411","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/102330","author_association":"MEMBER","submitted_at":"2025-05-23T17:38:01Z"}]