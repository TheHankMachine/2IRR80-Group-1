20:00:06Z","body":"I found what change causes the crash (upgrade mingw-gcc from its Fedora 39 version to Fedora 42), so I'll rebuild Windows binaries (editor and export templates) with the previous toolchain for now.","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3447733640/reactions","total_count":2,"+1":2,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3447812590","html_url":"https://github.com/godotengine/godot/issues/112021#issuecomment-3447812590","issue_url":"https://api.github.com/repos/godotengine/godot/issues/112021","id":3447812590,"node_id":"IC_kwDOAO6SJc7NgXHu","user":{"login":"akien-mga","id":4701338,"node_id":"MDQ6VXNlcjQ3MDEzMzg=","avatar_url":"https://avatars.githubusercontent.com/u/4701338?v=4","gravatar_id":"","url":"https://api.github.com/users/akien-mga","html_url":"https://github.com/akien-mga","followers_url":"https://api.github.com/users/akien-mga/followers","following_url":"https://api.github.com/users/akien-mga/following{/other_user}","gists_url":"https://api.github.com/users/akien-mga/gists{/gist_id}","starred_url":"https://api.github.com/users/akien-mga/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/akien-mga/subscriptions","organizations_url":"https://api.github.com/users/akien-mga/orgs","repos_url":"https://api.github.com/users/akien-mga/repos","events_url":"https://api.github.com/users/akien-mga/events{/privacy}","received_events_url":"https://api.github.com/users/akien-mga/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-10-25T22:11:54Z","updated_at":"2025-10-25T22:11:54Z","body":"I rebuilt and replaced the Windows binaries (both the editor and the export templates) for 3.6.2-stable, so please download 3.6.2-stable again (and reinstall export templates if you managed to install them via a workaround, so you get the new Windows export templates too).\n\nPlease let me know if that solves the issue (it does for me in Wine on Linux but that's not the most representative test environment).","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3447812590/reactions","total_count":2,"+1":2,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3448085321","html_url":"https://github.com/godotengine/godot/issues/112021#issuecomment-3448085321","issue_url":"https://api.github.com/repos/godotengine/godot/issues/112021","id":3448085321,"node_id":"IC_kwDOAO6SJc7NhZtJ","user":{"login":"RoyalXXX","id":125651292,"node_id":"U_kgDOB31JXA","avatar_url":"https://avatars.githubusercontent.com/u/125651292?v=4","gravatar_id":"","url":"https://api.github.com/users/RoyalXXX","html_url":"https://github.com/RoyalXXX","followers_url":"https://api.github.com/users/RoyalXXX/followers","following_url":"https://api.github.com/users/RoyalXXX/following{/other_user}","gists_url":"https://api.github.com/users/RoyalXXX/gists{/gist_id}","starred_url":"https://api.github.com/users/RoyalXXX/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/RoyalXXX/subscriptions","organizations_url":"https://api.github.com/users/RoyalXXX/orgs","repos_url":"https://api.github.com/users/RoyalXXX/repos","events_url":"https://api.github.com/users/RoyalXXX/events{/privacy}","received_events_url":"https://api.github.com/users/RoyalXXX/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-10-26T07:21:50Z","updated_at":"2025-10-26T07:22:38Z","body":"I confirm that the fixed Godot does not crash. ","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godo