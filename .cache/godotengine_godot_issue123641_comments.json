hubusercontent.com/u/30739239?v=4","gravatar_id":"","url":"https://api.github.com/users/YeldhamDev","html_url":"https://github.com/YeldhamDev","followers_url":"https://api.github.com/users/YeldhamDev/followers","following_url":"https://api.github.com/users/YeldhamDev/following{/other_user}","gists_url":"https://api.github.com/users/YeldhamDev/gists{/gist_id}","starred_url":"https://api.github.com/users/YeldhamDev/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/YeldhamDev/subscriptions","organizations_url":"https://api.github.com/users/YeldhamDev/orgs","repos_url":"https://api.github.com/users/YeldhamDev/repos","events_url":"https://api.github.com/users/YeldhamDev/events{/privacy}","received_events_url":"https://api.github.com/users/YeldhamDev/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-09-21T17:03:53Z","updated_at":"2026-09-22T20:54:50Z","body":"I've unexposed the method, as per multiple requests.\r\n\r\n> Since this is a performance pr, please provide evidence of a solved bottleneck, according to our [optimisation guidelines](https://contributing.godotengine.org/en/latest/development/engine/optimization.html).\r\n\r\n> How does this compare to #111137 ?\r\n\r\n_Using a modified version of the benchmark in #111137 that only tests descendants:_\r\n||`master`|PR|#111137|\r\n|-|-|-|-|\r\n|n2|1592|840|191|\r\n|n6|2554|1415|224|\r\n|n10|2947|1817|221|\r\n|n14|2423|1851|182|\r\n|n18|2571|1808|233|","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5764374571/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5773743265","html_url":"https://github.com/godotengine/godot/pull/123641#issuecomment-5773743265","issue_url":"https://api.github.com/repos/godotengine/godot/issues/123641","id":5773743265,"node_id":"IC_kwDOAO6SJc8AAAABWCRUoQ","user":{"login":"Ivorforce","id":2308167,"node_id":"MDQ6VXNlcjIzMDgxNjc=","avatar_url":"https://avatars.githubusercontent.com/u/2308167?v=4","gravatar_id":"","url":"https://api.github.com/users/Ivorforce","html_url":"https://github.com/Ivorforce","followers_url":"https://api.github.com/users/Ivorforce/followers","following_url":"https://api.github.com/users/Ivorforce/following{/other_user}","gists_url":"https://api.github.com/users/Ivorforce/gists{/gist_id}","starred_url":"https://api.github.com/users/Ivorforce/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Ivorforce/subscriptions","organizations_url":"https://api.github.com/users/Ivorforce/orgs","repos_url":"https://api.github.com/users/Ivorforce/repos","events_url":"https://api.github.com/users/Ivorforce/events{/privacy}","received_events_url":"https://api.github.com/users/Ivorforce/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-09-22T08:53:26Z","updated_at":"2026-09-22T08:53:26Z","body":"Ah, sorry, that's on me.\n\nDo you happen to know why depth is not available out of tree?","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5773743265/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5773829184","html_url":"https://github.com/godotengine/godot/pull/123641#issuecomment-5773829184","issue_url":"https://api.github.com/repos/godotengine/godot/issues/123641","id":5773829184,"node_id":"IC_kwDOAO6SJc8AAAABWCWkQA","user":{"login":"HolonProduction","id":99511741,"node_id":"U_kgDOBe5tvQ","avatar_url":"https://avatars.githubusercontent.com/u/99511741?v=4","gravatar_id":"","url":"https://api.github.com/users/HolonProduction","html_url":"https://github.com/HolonProduction","followers_url":"https://api.github.com/users/HolonProduction/followers","following_url":"https://api.github.com/users/HolonProduction/following{/other_user}","gists_url":"https://api.github.com/users/HolonProduction/gists{/gist_id}","starred_url":"https://api.github.com/users/HolonProduction/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/HolonProduction/subscriptions","organizations_url":"https://api.github.com/users/HolonProduction/orgs","repos_url":"https://api.github.com/users/HolonProduction/repos","events_url":"https://api.github.com/users/HolonProduction/events{/privacy}","received_events_url":"https://api.github.com/users/HolonProduction/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-09-22T09:00:47Z","updated_at":"2026-09-22T09:01:37Z","body":"Because it's initialized in `_propagate_enter_tree`. Not sure why, it's been like this since `GODOT IS OPEN SOURCE`. My assumption is, the idea was to not repeatedly reiterate the tree when preparing nodes off-tree to add them to the tree in one swoop. \r\n\r\nE.g. our internal GUI structures are usually build from child to parent, so we would be triggering a lot of tree walking to keep the depth up to date.","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5773829184/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5784014585","html_url":"https://github.com/godotengine/godot/pull/123641#issuecomment-5784014585","issue_url":"https://api.github.com/repos/godotengine/godot/issues/123641","id":5784014585,"node_id":"IC_kwDOAO6SJc8AAAABWMEO-Q","user":{"login":"YeldhamDev","id":30739239,"node_id":"MDQ6VXNlcjMwNzM5MjM5","avatar_url":"https://avatars.githubusercontent.com/u/30739239?v=4","gravatar_id":"","url":"https://api.github.com/users/YeldhamDev","html_url":"https://github.com/YeldhamDev","followers_url":"https://api.github.com/users/YeldhamDev/followers","following_url":"https://api.github.com/users/YeldhamDev/following{/other_user}","gists_url":"https://api.github.com/users/YeldhamDev/gists{/gist_id}","starred_url":"https://api.github.com/users/YeldhamDev/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/YeldhamDev/subscriptions","organizations_url":"https://api.github.com/users/YeldhamDev/orgs","repos_url":"https://api.github.com/users/YeldhamDev/repos","events_url":"https://api.github.com/users/YeldhamDev/events{/privacy}","received_events_url":"https://api.github.com/users/YeldhamDev/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-09-22T20:55:19Z","updated_at":"2026-09-22T20:55:19Z","body":"Changes reverted, and benchmark _de-updated_. :melting_face:","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5784014585/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5784328686","html_url":"https://github.com/godotengine/godot/pull/123641#issuecomment-5784328686","issue_url":"https://api.github.com/repos/godotengine/godot/issues/123641","id":5784328686,"node_id":"IC_kwDOAO6SJc8AAAABWMXZ7g","user":{"login":"HolonProduction","id":99511741,"node_id":"U_kgDOBe5tvQ","avatar_url":"https://avatars.githubusercontent.com/u/99511741?v=4","gravatar_id":"","url":"https://api.github.com/users/HolonProduction","html_url":"https://github.com/HolonProduction","followers_url":"https://api.github.com/users/HolonProduction/followers","following_url":"https://api.github.com/users/HolonProduction/following{/other_user}","gists_url":"https://api.github.com/users/HolonProduction/gists{/gist_id}","starred_url":"https://api.github.com/users/HolonProduction/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/HolonProduction/subscriptions","organizations_url":"https://api.github.com/users/HolonProduction/orgs","repos_url":"https://api.github.com/users/HolonProduction/repos","events_url":"https://api.github.com/users/HolonProduction/events{/privacy}","received_events_url":"https://api.github.com/users/HolonProduction/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-09-22T21:18:48Z","updated_at":"2026-09-22T21:19:37Z","body":"IMHO performance wise this PR should achieve the following:\n1. duplicating scene instances out of tree should get significantly faster\n2. duplicating scene instances in-tree should not be slower than with https://github.com/godotengine/godot/pull/111137\n\nLooking at 2. I don't see that happening without a `depth` based fast-path. Otherwise we'd need to have a discussion on common usage patterns of `duplicate`.\n\n(Obviously under the assumption that my PR is a good change that should get merged. Call me biased 🤷)\n\n","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5784328686/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5791729714","html_url":"https://github.com/godotengine/godot/pull/123641#issuecomment-5791729714","issue_url":"https://api.github.com/repos/godotengine/godot/issues/123641","id":5791729714,"node_id":"IC_kwDOAO6SJc8AAAABWTbIMg","user":{"login":"HolonProduction","id":99511741,"node_id":"U_kgDOBe5tvQ","avatar_url":"https://avatars.githubusercontent.com/u/99511741?v=4","gravatar_id":"","url":"https://api.github.com/users/HolonProduction","html_url":"https://github.com/HolonProduction","followers_url":"https://api.github.com/users/HolonProduction/followers","following_url":"https://api.github.com/users/HolonProduction/following{/other_user}","gists_url":"https://api.github.com/users/HolonProduction/gists{/gist_id}","starred_url":"https://api.github.com/users/HolonProduction/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/HolonProduction/subscriptions","organizations_url":"https://api.github.com/users/HolonProduction/orgs","repos_url":"https://api.github.com/users/HolonProduction/repos","events_url":"https://api.github.com/users/HolonProduction/events{/privacy}","received_events_url":"https://api.github.com/users/HolonProduction/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-09-23T08:39:52Z","updated_at":"2026-09-23T08:39:52Z","body":"Completely different thought.\r\n\r\nIf I'm reading the code correct: `original` is always a direct child of `p_original`, so after https://github.com/godotengine/godot/pull/123617 couldn't we just use `get_name` instead of `get_path_to`?","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5791729714/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null}]