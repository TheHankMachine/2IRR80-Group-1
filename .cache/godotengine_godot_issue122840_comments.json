[{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5719293373","html_url":"https://github.com/godotengine/godot/pull/122840#issuecomment-5719293373","issue_url":"https://api.github.com/repos/godotengine/godot/issues/122840","id":5719293373,"node_id":"IC_kwDOAO6SJc8AAAABVOV9vQ","user":{"login":"dsnopek","id":191561,"node_id":"MDQ6VXNlcjE5MTU2MQ==","avatar_url":"https://avatars.githubusercontent.com/u/191561?v=4","gravatar_id":"","url":"https://api.github.com/users/dsnopek","html_url":"https://github.com/dsnopek","followers_url":"https://api.github.com/users/dsnopek/followers","following_url":"https://api.github.com/users/dsnopek/following{/other_user}","gists_url":"https://api.github.com/users/dsnopek/gists{/gist_id}","starred_url":"https://api.github.com/users/dsnopek/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/dsnopek/subscriptions","organizations_url":"https://api.github.com/users/dsnopek/orgs","repos_url":"https://api.github.com/users/dsnopek/repos","events_url":"https://api.github.com/users/dsnopek/events{/privacy}","received_events_url":"https://api.github.com/users/dsnopek/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-09-17T18:27:24Z","updated_at":"2026-09-17T18:27:24Z","body":"So long as this doesn't break GDExtension, I think it's fine.\r\n\r\nThe backstory on `GDREGISTER_INTERNAL_CLASS()` was that we needed to add it to godot-cpp for real technical reasons, and then added it to Godot itself only so that we weren't adding something to godot-cpp that was incompatible with modules\r\n\r\nWithin Godot, you shouldn't need to use it at all, since creating a new instance of an unregistered class will automatically register it as internal. So, ideally, the registration should look roughly the same with `GDREGISTER_INTERNAL_CLASS()` as with not registering and creating an instance","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5719293373/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5720924561","html_url":"https://github.com/godotengine/godot/pull/122840#issuecomment-5720924561","issue_url":"https://api.github.com/repos/godotengine/godot/issues/122840","id":5720924561,"node_id":"IC_kwDOAO6SJc8AAAABVP5hkQ","user":{"login":"HolonProduction","id":99511741,"node_id":"U_kgDOBe5tvQ","avatar_url":"https://avatars.githubusercontent.com/u/99511741?v=4","gravatar_id":"","url":"https://api.github.com/users/HolonProduction","html_url":"https://github.com/HolonProduction","followers_url":"https://api.github.com/users/HolonProduction/followers","following_url":"https://api.github.com/users/HolonProduction/following{/other_user}","gists_url":"https://api.github.com/users/HolonProduction/gists{/gist_id}","starred_url":"https://api.github.com/users/HolonProduction/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/HolonProduction/subscriptions","organizations_url":"https://api.github.com/users/HolonProduction/orgs","repos_url":"https://api.github.com/users/HolonProduction/repos","events_url":"https://api.github.com/users/HolonProduction/events{/privacy}","received_events_url":"https://api.github.com/users/HolonProduction/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-09-17T20:39:56Z","updated_at":"2026-09-17T20:39:56Z","body":"> Within Godot, you shouldn't need to use it at all, since creating a new instance of an unregistered class will automatically register it as internal.\r\n\r\nGenerally speaking this isn't an option anymore, since registration is limited to the main thread since iirc 4.7. So if the first instantiation happens from somewhere else it will lead to errors.\r\nThis is why GDScript started explicitly registering those few classes as internal.","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5720924561/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5732491814","html_url":"https://github.com/godotengine/godot/pull/122840#issuecomment-5732491814","issue_url":"https://api.github.com/repos/godotengine/godot/issues/122840","id":5732491814,"node_id":"IC_kwDOAO6SJc8AAAABVa7iJg","user":{"login":"Repiteo","id":17489292,"node_id":"MDQ6VXNlcjE3NDg5Mjky","avatar_url":"https://avatars.githubusercontent.com/u/17489292?v=4","gravatar_id":"","url":"https://api.github.com/users/Repiteo","html_url":"https://github.com/Repiteo","followers_url":"https://api.github.com/users/Repiteo/followers","following_url":"https://api.github.com/users/Repiteo/following{/other_user}","gists_url":"https://api.github.com/users/Repiteo/gists{/gist_id}","starred_url":"https://api.github.com/users/Repiteo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Repiteo/subscriptions","organizations_url":"https://api.github.com/users/Repiteo/orgs","repos_url":"https://api.github.com/users/Repiteo/repos","events_url":"https://api.github.com/users/Repiteo/events{/privacy}","received_events_url":"https://api.github.com/users/Repiteo/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-09-18T15:48:17Z","updated_at":"2026-09-18T15:48:17Z","body":"Thanks!","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5732491814/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null}]