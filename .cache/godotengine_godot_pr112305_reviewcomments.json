/not-my-username/gists{/gist_id}","starred_url":"https://api.github.com/users/not-my-username/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/not-my-username/subscriptions","organizations_url":"https://api.github.com/users/not-my-username/orgs","repos_url":"https://api.github.com/users/not-my-username/repos","events_url":"https://api.github.com/users/not-my-username/events{/privacy}","received_events_url":"https://api.github.com/users/not-my-username/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"Tested on MacOS and Linux. In theory IOS and Android should work, however they may need some permission set. Then again due to the nature of mobile oprating system, it would be unlikely you would be able / need to run 2 instances of the same godot project at the same time","created_at":"2025-11-04T00:34:07Z","updated_at":"2025-11-04T00:34:07Z","html_url":"https://github.com/godotengine/godot/pull/112305#discussion_r2488261574","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/112305","_links":{"self":{"href":"https://api.github.com/repos/godotengine/godot/pulls/comments/2488261574"},"html":{"href":"https://github.com/godotengine/godot/pull/112305#discussion_r2488261574"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/112305"}},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/2488261574/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":142,"original_line":142,"side":"RIGHT","in_reply_to_id":2486319840,"author_association":"CONTRIBUTOR","original_position":16,"position":16,"subject_type":"line"},{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/2488281120","pull_request_review_id":3413507745,"id":2488281120,"node_id":"PRRC_kwDOAO6SJc6UUCgg","diff_hunk":"@@ -547,10 +547,18 @@ void NetSocketWinSock::set_tcp_no_delay_enabled(bool p_enabled) {\n }\n \n void NetSocketWinSock::set_reuse_address_enabled(bool p_enabled) {\n-\tERR_FAIL_COND(!is_open());\n+\tERR_FAIL_COND(_sock == INVALID_SOCKET);\n+\n+\tint par = p_enabled ? 1 : 0;\n+\tif (setsockopt(_sock, SOL_SOCKET, SO_REUSEADDR, (const char *)&par, sizeof(int)) < 0) {\n+\t\tWARN_PRINT(\"Unable to set socket REUSEADDR option.\");\n+\t}\n+}","path":"drivers/windows/net_socket_winsock.cpp","commit_id":"1c8c7df0a824b13ffd8f8e70fb493c86c3cae5e4","original_commit_id":"1c8c7df0a824b13ffd8f8e70fb493c86c3cae5e4","user":{"login":"not-my-username","id":95655127,"node_id":"U_kgDOBbOU1w","avatar_url":"https://avatars.githubusercontent.com/u/95655127?v=4","gravatar_id":"","url":"https://api.github.com/users/not-my-username","html_url":"https://github.com/not-my-username","followers_url":"https://api.github.com/users/not-my-username/followers","following_url":"https://api.github.com/users/not-my-username/following{/other_user}","gists_url":"https://api.github.com/users/not-my-username/gists{/gist_id}","starred_url":"https://api.github.com/users/not-my-username/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/not-my-username/subscriptions","organizations_url":"https://api.github.com/users/not-my-username/orgs","repos_url":"https://api.github.com/users/not-my-username/repos","events_url":"https://api.github.com/users/not-my-username/events{/privacy}","received_events_url":"https://api.github.com/users/not-my-username/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"Good point. From doing a global search in the code base. The only times `NetSocketWinSock::set_reuse_address_enabled` is called is in `/core/io/udp_server.cpp` and `/core/io/tcp_server.cpp` on lines `109` and `56` respectively.\r\n\r\nFrom my research I don't believe it would cause any issues with existing behavior. Then again i try to stay away from Windows as a whole, so im no expert.\r\n\r\nIll push a new commit that moves the logic into `set_reuse_port_enabled` and keep `set_reuse_address_enabled` as a NOP like it originally was\r\n","created_at":"2025-11-04T00:48:36Z","updated_at":"2025-11-04T00:48:36Z","html_url":"https://github.com/godotengine/godot/pull/112305#discussion_r2488281120","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/112305","_links":{"self":{"href":"https://api.github.com/repos/godotengine/godot/pulls/comments/2488281120"},"html":{"href":"https://github.com/godotengine/godot/pull/112305#discussion_r2488281120"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/112305"}},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/2488281120/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":552,"original_start_line":552,"start_side":"RIGHT","line":556,"original_line":556,"side":"RIGHT","in_reply_to_id":2486409158,"author_association":"CONTRIBUTOR","original_position":11,"position":1,"subject_type":"line"}]