ed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5427004921","html_url":"https://github.com/godotengine/godot/pull/122475#issuecomment-5427004921","issue_url":"https://api.github.com/repos/godotengine/godot/issues/122475","id":5427004921,"node_id":"IC_kwDOAO6SJc8AAAABQ3mF-Q","user":{"login":"YeldhamDev","id":30739239,"node_id":"MDQ6VXNlcjMwNzM5MjM5","avatar_url":"https://avatars.githubusercontent.com/u/30739239?v=4","gravatar_id":"","url":"https://api.github.com/users/YeldhamDev","html_url":"https://github.com/YeldhamDev","followers_url":"https://api.github.com/users/YeldhamDev/followers","following_url":"https://api.github.com/users/YeldhamDev/following{/other_user}","gists_url":"https://api.github.com/users/YeldhamDev/gists{/gist_id}","starred_url":"https://api.github.com/users/YeldhamDev/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/YeldhamDev/subscriptions","organizations_url":"https://api.github.com/users/YeldhamDev/orgs","repos_url":"https://api.github.com/users/YeldhamDev/repos","events_url":"https://api.github.com/users/YeldhamDev/events{/privacy}","received_events_url":"https://api.github.com/users/YeldhamDev/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-08-26T14:43:03Z","updated_at":"2026-08-26T14:43:03Z","body":"> Without accounting for the label/separator/value, they can get too narrow & the value can overlap the arrows.\r\n\r\nI get that, and I'm suggesting the value could be ignored to allow it to be shrunk further. The real problem was the numbers being drawn on top of the arrows, and as long as the minimum width is big enough to avoid that, it's good enough.","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5427004921/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app"