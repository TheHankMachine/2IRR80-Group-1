,"node_id":"LA_kwDOAO6SJc8AAAAB4iS2Xw","url":"https://api.github.com/repos/godotengine/godot/labels/cherrypick:4.4","name":"cherrypick:4.4","color":"446699","default":false,"description":"Considered for cherry-picking into a future 4.4.x release","archived_at":null,"archived_by":null}],"state":"closed","locked":false,"assignees":[],"milestone":{"url":"https://api.github.com/repos/godotengine/godot/milestones/22","html_url":"https://github.com/godotengine/godot/milestone/22","labels_url":"https://api.github.com/repos/godotengine/godot/milestones/22/labels","id":12070367,"node_id":"MI_kwDOAO6SJc4AuC3f","number":22,"title":"4.5","description":"","creator":{"login":"Sauermann","id":6299227,"node_id":"MDQ6VXNlcjYyOTkyMjc=","avatar_url":"https://avatars.githubusercontent.com/u/6299227?v=4","gravatar_id":"","url":"https://api.github.com/users/Sauermann","html_url":"https://github.com/Sauermann","followers_url":"https://api.github.com/users/Sauermann/followers","following_url":"https://api.github.com/users/Sauermann/following{/other_user}","gists_url":"https://api.github.com/users/Sauermann/gists{/gist_id}","starred_url":"https://api.github.com/users/Sauermann/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Sauermann/subscriptions","organizations_url":"https://api.github.com/users/Sauermann/orgs","repos_url":"https://api.github.com/users/Sauermann/repos","events_url":"https://api.github.com/users/Sauermann/events{/privacy}","received_events_url":"https://api.github.com/users/Sauermann/received_events","type":"User","user_view_type":"public","site_admin":false},"open_issues":3,"closed_issues":3687,"state":"closed","created_at":"2024-12-19T08:51:28Z","updated_at":"2026-09-04T21:48:38Z","due_on":"2025-09-15T00:00:00Z","closed_at":"2025-09-18T17:13:14Z"},"comments":3,"created_at":"2025-07-03T21:17:56Z","updated_at":"2026-02-03T10:01:49Z","closed_at":"2025-07-07T15:14:05Z","assignee":null,"author_association":"CONTRIBUTOR","issue_field_values":[],"type":null,"active_lock_reason":null,"draft":false,"pull_request":{"url":"https://api.github.com/repos/godotengine/godot/pulls/108255","html_url":"https://github.com/godotengine/godot/pull/108255","diff_url":"https://github.com/godotengine/godot/pull/108255.diff","patch_url":"https://github.com/godotengine/godot/pull/108255.patch","merged_at":"2025-07-07T15:14:05Z"},"body":"`TabBars` and `TabContainers` were unable to start with no tabs selected, and couldn't properly retain their current tab value of \"-1\", also across editor restarts. \r\n\r\n### Fix for Issue:\r\nhttps://github.com/godotengine/godot/issues/108223\r\n\r\n### Cause\r\nAs the tabs were added to a TabBar (or children to a TabContainer) as the scene was set up, a bug in TabBar would always select tab index 0, even if deselection was enabled.\r\n\r\n### Repro (also in linked issue):\r\n![image](https://github.com/user-attachments/assets/a9f3dffa-d837-4ed7-af3a-9ce38c908058)\r\n\r\n### Before fix:\r\n![image](https://github.com/user-attachments/assets/994f05e3-ebde-4c5e-8ced-784f85713913)\r\n\r\n### Fixed via: \r\nA missing check for `deselect_enabled` was added in `TabBar.cpp` on the code path when a first tab is added to an empty bar. \r\n\r\n### After fix: \r\n![image](https://github.com/user-attachments/assets/6477f751-0cdd-41d9-a063-89312cfc2998)\r\n\r\n### Tests:\r\n- Modified 2 Test cases in [TabBar].\r\n- Added 1 Test case in [TabBar].\r\n\r\nVerified on Windows only via manual testing and  \r\n`./bin/godot.windows.editor.x86_64.console.exe --test --test-case=\"*[TabBar]*\"`\r\n\r\n* *Bugsquad edit, fixes: https://github.com/godotengine/godot/issues/108223*","closed_by":{"login":"Repiteo","id":17489292,"node_id":"MDQ6VXNlcjE3NDg5Mjky","avatar_url":"https://avatars.githubusercontent.com/u/17489292?v=4","gravatar_id":"","url":"https://api.github.com/users/Repiteo","html_url":"https://github.com/Repiteo","followers_url":"https://api.github.com/users/Repiteo/followers","following_url":"https://api.github.com/users/Repiteo/following{/other_user}","gists_url":"https://api.github.com/users/Repiteo/gists{/gist_id}","starred_url":"https://api.github.com/users/Repiteo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Repiteo/subscriptions","organizations_url":"https://api.github.com/users/Repiteo/orgs","repos_url":"https://api.github.com/users/Repiteo/repos","events_url":"https://api.github.com/users/Repiteo/events{/privacy}","received_events_url":"https://api.github.com/users/Repiteo/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/108255/reactions","total_count":2,"+1":2,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/godotengine/godot/issues/108255/timeline","performed_via_github_app":null,"state_reason":null}