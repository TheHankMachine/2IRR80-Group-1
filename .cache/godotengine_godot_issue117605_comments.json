98,"node_id":"MDQ6VXNlcjU5NTA5OA==","avatar_url":"https://avatars.githubusercontent.com/u/595098?v=4","gravatar_id":"","url":"https://api.github.com/users/voidexp","html_url":"https://github.com/voidexp","followers_url":"https://api.github.com/users/voidexp/followers","following_url":"https://api.github.com/users/voidexp/following{/other_user}","gists_url":"https://api.github.com/users/voidexp/gists{/gist_id}","starred_url":"https://api.github.com/users/voidexp/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/voidexp/subscriptions","organizations_url":"https://api.github.com/users/voidexp/orgs","repos_url":"https://api.github.com/users/voidexp/repos","events_url":"https://api.github.com/users/voidexp/events{/privacy}","received_events_url":"https://api.github.com/users/voidexp/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-04-13T08:43:14Z","updated_at":"2026-04-13T08:43:14Z","body":"Can confirm, happens to me too. ","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4235039955/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4237526207","html_url":"https://github.com/godotengine/godot/issues/117605#issuecomment-4237526207","issue_url":"https://api.github.com/repos/godotengine/godot/issues/117605","id":4237526207,"node_id":"IC_kwDOAO6SJc78k4S_","user":{"login":"KoBeWi","id":2223172,"node_id":"MDQ6VXNlcjIyMjMxNzI=","avatar_url":"https://avatars.githubusercontent.com/u/2223172?v=4","gravatar_id":"","url":"https://api.github.com/users/KoBeWi","html_url":"https://github.com/KoBeWi","followers_url":"https://api.github.com/users/KoBeWi/followers","following_url":"https://api.github.com/users/KoBeWi/following{/other_user}","gists_url":"https://api.github.com/users/KoBeWi/gists{/gist_id}","starred_url":"https://api.github.com/users/KoBeWi/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/KoBeWi/subscriptions","organizations_url":"https://api.github.com/users/KoBeWi/orgs","repos_url":"https://api.github.com/users/KoBeWi/repos","events_url":"https://api.github.com/users/KoBeWi/events{/privacy}","received_events_url":"https://api.github.com/users/KoBeWi/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-04-13T15:19:13Z","updated_at":"2026-04-13T15:23:41Z","body":"> Open inherited.tscn in the editor and save it.\n\nThis step is wrong. From my testing, the ID change only happens if the scene is already open during reimport, which causes the instance to reload with wrong ID. It only happens with inherited imported scenes, does not happen if the scene is an instance, or it's not imported. Also, reloading the scene manually fixes the ID if you didn't save it.","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4237526207/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4703337001","html_url":"https://github.com/godotengine/godot/issues/117605#issuecomment-4703337001","issue_url":"https://api.github.com/repos/godotengine/godot/issues/117605","id":4703337001,"node_id":"IC_kwDOAO6SJc8AAAABGFc6KQ","user":{"login":"ashelleyPurdue","id":8558767,"node_id":"MDQ6VXNlcjg1NTg3Njc=","avatar_url":"https://avatars.githubusercontent.com/u/8558767?v=4","gravatar_id":"","url":"https://api.github.com/users/ashelleyPurdue","html_url":"https://github.com/ashelleyPurdue","followers_url":"https://api.github.com/users/ashelleyPurdue/followers","following_url":"https://api.github.com/users/ashelleyPurdue/following{/other_user}","gists_url":"https://api.github.com/users/ashelleyPurdue/gists{/gist_id}","starred_url":"https://api.github.com/users/ashelleyPurdue/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/ashelleyPurdue/subscriptions","organizations_url":"https://api.github.com/users/ashelleyPurdue/orgs","repos_url":"https://api.github.com/users/ashelleyPurdue/repos","events_url":"https://api.github.com/users/ashelleyPurdue/events{/privacy}","received_events_url":"https://api.github.com/users/ashelleyPurdue/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-06-14T22:54:08Z","updated_at":"2026-06-14T22:54:08Z","body":"This is still happening for me on 4.6.3.  I upgraded my project from version 4.6.2 to 4.6.3 and ran the upgrade tool(and then committed the changes it made).  I then pulled those changes to another computer and re-ran the upgrade tool, expecting there to be no changes.  There _were_ changes, and they were all node ids getting re-randomized.\n\nTo reproduce:\n* Start a project in 4.6.2.\n* Import a glb model and put it in a scene\n* Mark the node of your model as \"editable children\"\n* Edit one of the children in some way\n* Commit your changes to version control\n* Close Godot 4.6.2\n* Open your project in Godot 4.6.3\n* Run the upgrade tool\n* Commit the changes\n* Pull your changes on a separate computer(ideally one that has done work on the project in the past)\n* On that separate computer, open the project in 4.6.3 and run the upgrade tool again\n* Look at the version control diff to see what changed\n\nExpected behavior: The second upgrade pass makes no changes\nActual behavior: The second upgrade pass regenerated the node id","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4703337001/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":nul