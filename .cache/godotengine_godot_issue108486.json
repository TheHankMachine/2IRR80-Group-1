ot the primary monitor.\n\n### Minimal reproduction project (MRP)\n\nDoesn't need a project, just open Godot","closed_by":{"login":"PistolSkin","id":163760743,"node_id":"U_kgDOCcLKZw","avatar_url":"https://avatars.githubusercontent.com/u/163760743?v=4","gravatar_id":"","url":"https://api.github.com/users/PistolSkin","html_url":"https://github.com/PistolSkin","followers_url":"https://api.github.com/users/PistolSkin/followers","following_url":"https://api.github.com/users/PistolSkin/following{/other_user}","gists_url":"https://api.github.com/users/PistolSkin/gists{/gist_id}","starred_url":"https://api.github.com/users/PistolSkin/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/PistolSkin/subscriptions","organizations_url":"https://api.github.com/users/PistolSkin/orgs","repos_url":"https://api.github.com/users/PistolSkin/repos","events_url":"https://api.github.com/users/PistolSkin/events{/privacy}","received_events_url":"https://api.github.com/users/PistolSkin/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/108486/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/godotengine/godot/issues/108486/timeline","performed_via_github_app":null,"state_reason":"completed","pinned_comment":null}