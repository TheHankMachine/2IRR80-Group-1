[{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2696957979","html_url":"https://github.com/godotengine/godot/issues/103544#issuecomment-2696957979","issue_url":"https://api.github.com/repos/godotengine/godot/issues/103544","id":2696957979,"node_id":"IC_kwDOAO6SJc6gwFAb","user":{"login":"KerekesDavid","id":9087461,"node_id":"MDQ6VXNlcjkwODc0NjE=","avatar_url":"https://avatars.githubusercontent.com/u/9087461?v=4","gravatar_id":"","url":"https://api.github.com/users/KerekesDavid","html_url":"https://github.com/KerekesDavid","followers_url":"https://api.github.com/users/KerekesDavid/followers","following_url":"https://api.github.com/users/KerekesDavid/following{/other_user}","gists_url":"https://api.github.com/users/KerekesDavid/gists{/gist_id}","starred_url":"https://api.github.com/users/KerekesDavid/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/KerekesDavid/subscriptions","organizations_url":"https://api.github.com/users/KerekesDavid/orgs","repos_url":"https://api.github.com/users/KerekesDavid/repos","events_url":"https://api.github.com/users/KerekesDavid/events{/privacy}","received_events_url":"https://api.github.com/users/KerekesDavid/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-03-04T10:18:29Z","updated_at":"2025-03-04T10:18:29Z","body":"I can reproduce this on:\nGodot v4.4.stable - Ubuntu 24.04.2 LTS 24.04 on Wayland - X11 display driver, Multi-window, 1 monitor - Vulkan (Forward+) - integrated Intel(R) UHD Graphics (CML GT2) - Intel(R) Core(TM) i7-10510U CPU @ 1.80GHz (8 threads)","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2696957979/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2699367086","html_url":"https://github.com/godotengine/godot/issues/103544#issuecomment-2699367086","issue_url":"https://api.github.com/repos/godotengine/godot/issues/103544","id":2699367086,"node_id":"IC_kwDOAO6SJc6g5RKu","user":{"login":"Calinou","id":180032,"node_id":"MDQ6VXNlcjE4MDAzMg==","avatar_url":"https://avatars.githubusercontent.com/u/180032?v=4","gravatar_id":"","url":"https://api.github.com/users/Calinou","html_url":"https://github.com/Calinou","followers_url":"https://api.github.com/users/Calinou/followers","following_url":"https://api.github.com/users/Calinou/following{/other_user}","gists_url":"https://api.github.com/users/Calinou/gists{/gist_id}","starred_url":"https://api.github.com/users/Calinou/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Calinou/subscriptions","organizations_url":"https://api.github.com/users/Calinou/orgs","repos_url":"https://api.github.com/users/Calinou/repos","events_url":"https://api.github.com/users/Calinou/events{/privacy}","received_events_url":"https://api.github.com/users/Calinou/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-03-05T00:43:19Z","updated_at":"2025-03-05T00:43:26Z","body":"Make sure to follow the steps from the [Reducing stutter from shader (pipeline) compilations](https://docs.godotengine.org/en/latest/tutorials/performance/pipeline_compilations.html) documentation. In particular, materials should be applied to Mesh resources' material properties, **not** Surface Material Override, Material Override or Material Overlay.","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2699367086/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2699463399","html_url":"https://github.com/godotengine/godot/issues/103544#issuecomment-2699463399","issue_url":"https://api.github.com/repos/godotengine/godot/issues/103544","id":2699463399,"node_id":"IC_kwDOAO6SJc6g5orn","user":{"login":"Pixelmusement","id":78319361,"node_id":"MDQ6VXNlcjc4MzE5MzYx","avatar_url":"https://avatars.githubusercontent.com/u/78319361?v=4","gravatar_id":"","url":"https://api.github.com/users/Pixelmusement","html_url":"https://github.com/Pixelmusement","followers_url":"https://api.github.com/users/Pixelmusement/followers","following_url":"https://api.github.com/users/Pixelmusement/following{/other_user}","gists_url":"https://api.github.com/users/Pixelmusement/gists{/gist_id}","starred_url":"https://api.github.com/users/Pixelmusement/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Pixelmusement/subscriptions","organizations_url":"https://api.github.com/users/Pixelmusement/orgs","repos_url":"https://api.github.com/users/Pixelmusement/repos","events_url":"https://api.github.com/users/Pixelmusement/events{/privacy}","received_events_url":"https://api.github.com/users/Pixelmusement/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-03-05T01:19:21Z","updated_at":"2025-03-05T01:19:21Z","body":"> Make sure to follow the steps from the [Reducing stutter from shader (pipeline) compilations](https://docs.godotengine.org/en/latest/tutorials/performance/pipeline_compilations.html) documentation. In particular, materials should be applied to Mesh resources' material properties, **not** Surface Material Override, Material Override or Material Overlay.\n\nOK, that actually clarifies a few things, meaning the behaviour seen here is likely intended, as making the changes suggested to shift everything from overrides to the mesh's resource did not solve the issue, but reading the details on how the pipelines and ubershaders work does indicate that what's going on is normal; That all shader features you intended to use need to be visible at launch to prevent recompilation later on.\n\nI didn't realize that though as I thought the presence of the ubershaders and shader caching was to prevent these kinds of stutters, but that those systems themselves still had their own considerations to deal with, plus seeing a stutter happen EVERY time which was significantly longer for one of my shaders in 4.4 compared to 4.3 had me worried as I haven't gotten far enough along in my project yet to introduce proper loading routines to force shaders to compile at boot.","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2699463399/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null}]