[{"id":2471469894,"node_id":"PRR_kwDOAO6SJc6TT6NG","state":"APPROVED","user":{"site_admin":false,"suspended":false,"updated_at":"0001-01-01T00:00:00Z","avatar_url":"https://avatars.githubusercontent.com/u/180032?u=68d23e7ee9cdf810da125e8510b72f845b9dccc8&v=4","created_at":"0001-01-01T00:00:00Z","followers":0,"following":0,"html_url":"https://github.com/Calinou","id":180032,"node_id":"MDQ6VXNlcjE4MDAzMg==","login":"Calinou","type":"User","owned_private_repos":0,"public_gists":0,"public_repos":0,"total_private_repos":0,"url":"https://api.github.com/users/Calinou"},"body":"Code looks good to me.\r\n\r\nNote that on my macOS system, `CCACHE` wasn't set by `brew install ccache`, so I opted to prepend `PATH` with its binaries from `/opt/homebrew` as advised by the post-install message. It works without this PR in this situation, but I think this PR still makes sense as not everyone would want to modify their `PATH`.","html_url":"https://github.com/godotengine/godot/pull/97810#pullrequestreview-2471469894","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/97810","author_association":"MEMBER","submitted_at":"2024-12-01T17:34:30Z"},{"id":2472640516,"node_id":"PRR_kwDOAO6SJc6TYYAE","state":"APPROVED","user":{"site_admin":false,"suspended":false,"updated_at":"0001-01-01T00:00:00Z","avatar_url":"https://avatars.githubusercontent.com/u/4701338?u=4a42fd867f2c449fcc23adf635dd574dae98e6c2&v=4","created_at":"0001-01-01T00:00:00Z","followers":0,"following":0,"html_url":"https://github.com/akien-mga","id":4701338,"node_id":"MDQ6VXNlcjQ3MDEzMzg=","login":"akien-mga","type":"User","owned_private_repos":0,"public_gists":0,"public_repos":0,"total_private_repos":0,"url":"https://api.github.com/users/akien-mga"},"body":"","html_url":"https://github.com/godotengine/godot/pull/97810#pullrequestreview-2472640516","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/97810","author_association":"MEMBER","submitted_at":"2024-12-02T13:04:34Z"},{"id":24726