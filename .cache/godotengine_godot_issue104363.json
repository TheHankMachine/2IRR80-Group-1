219,"node_id":"MDU6TGFiZWwyNzkwOTgyMTk=","url":"https://api.github.com/repos/godotengine/godot/labels/topic:editor","name":"topic:editor","color":"ffee88","default":false,"description":"","archived_at":null,"archived_by":null},{"id":279128044,"node_id":"MDU6TGFiZWwyNzkxMjgwNDQ=","url":"https://api.github.com/repos/godotengine/godot/labels/confirmed","name":"confirmed","color":"aaddaa","default":false,"description":"","archived_at":null,"archived_by":null},{"id":1332303119,"node_id":"MDU6TGFiZWwxMzMyMzAzMTE5","url":"https://api.github.com/repos/godotengine/godot/labels/regression","name":"regression","color":"ff63ac","default":false,"description":"","archived_at":null,"archived_by":null}],"state":"closed","locked":false,"assignees":[],"milestone":{"url":"https://api.github.com/repos/godotengine/godot/milestones/22","html_url":"https://github.com/godotengine/godot/milestone/22","labels_url":"https://api.github.com/repos/godotengine/godot/milestones/22/labels","id":12070367,"node_id":"MI_kwDOAO6SJc4AuC3f","number":22,"title":"4.5","description":"","creator":{"login":"Sauermann","id":6299227,"node_id":"MDQ6VXNlcjYyOTkyMjc=","avatar_url":"https://avatars.githubusercontent.com/u/6299227?v=4","gravatar_id":"","url":"https://api.github.com/users/Sauermann","html_url":"https://github.com/Sauermann","followers_url":"https://api.github.com/users/Sauermann/followers","following_url":"https://api.github.com/users/Sauermann/following{/other_user}","gists_url":"https://api.github.com/users/Sauermann/gists{/gist_id}","starred_url":"https://api.github.com/users/Sauermann/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Sauermann/subscriptions","organizations_url":"https://api.github.com/users/Sauermann/orgs","repos_url":"https://api.github.com/users/Sauermann/repos","events_url":"https://api.github.com/users/Sauermann/events{/privacy}","received_events_url":"https://api.github.com/users/Sauermann/received_events","type":"User","user_view_type":"public","site_admin":false},"open_issues":3,"closed_issues":3687,"state":"closed","created_at":"2024-12-19T08:51:28Z","updated_at":"2026-09-04T21:48:38Z","due_on":"2025-09-15T00:00:00Z","closed_at":"2025-09-18T17:13:14Z"},"comments":4,"created_at":"2025-03-19T13:29:39Z","updated_at":"2025-03-20T15:42:21Z","closed_at":"2025-03-20T15:42:21Z","assignee":null,"author_association":"NONE","issue_field_values":[],"type":null,"active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"### Tested versions\n\n- Godot 4.4 stable and 4.4-rc1\n- Downloaded from official website\n\n### System information\n\nGodot v4.4.1.rc1 - Windows 11 (build 26100) - Multi-window, 1 monitor - Vulkan (Forward+) - integrated AMD Radeon 780M Graphics (Advanced Micro Devices, Inc.; 32.0.12033.1030) - AMD Ryzen 7 7840HS w/ Radeon 780M Graphics (16 threads)\n\n### Issue description\n\nThe project icon in the Project Manager fails to update when the icon file contains non-ASCII characters (e.g., Chinese characters) in its filename. This issue affects both PNG and SVG formats. The icon remains as default regardless of the file being properly set in project settings.\n\n![Image](https://github.com/user-attachments/assets/3f91959c-e1ce-4c69-8913-411352acb72c)\n\n![Image](https://github.com/user-attachments/assets/55261dee-d4df-48ae-b1f1-25108cce7ef8)\n\n### Steps to reproduce\n\n1. Open Project Manager\n2. Create a new project or open existing project\n3. Go to Project Settings\n4. Navigate to Application > Config > Icon\n5. Set a custom icon file with non-ASCII characters in filename (e.g., \"项目图标.png\" or \"图标.svg\")\n6. Save settings and restart the editor\n7. Check Project Manager\n8. (Verification) Rename the same icon file to ASCII-only characters (e.g., \"icon.png\") - this works correctly\n\n**Expected behavior:**\nThe project should display the custom icon regardless of the icon filename containing non-ASCII characters.\n\n**Actual behavior:**\n- When icon filename contains non-ASCII characters: The project shows default Godot icon\n- When icon filename uses only ASCII characters: The icon updates correctly\n- This behavior is consistent for both PNG and SVG formats\n\n**Additional context:**\n- The issue is related to filename character encoding, not the file format\n- Both PNG and SVG formats work correctly when using ASCII-only filenames\n- This appears to be a filename handling issue rather than a format support issue\n\n### Minimal reproduction project (MRP)\n\nNot required as this can be reproduced with any new project.","closed_by":{"login":"akien-mga","id":4701338,"node_id":"MDQ6VXNlcjQ3MDEzMzg=","avatar_url":"https://avatars.githubusercontent.com/u/4701338?v=4","gravatar_id":"","url":"https://api.github.com/users/akien-mga","html_url":"https://github.com/akien-mga","followers_url":"https://api.github.com/users/akien-mga/followers","following_url":"https://api.github.com/users/akien-mga/following{/other_user}","gists_url":"https://api.github.com/users/akien-mga/gists{/gist_id}","starred_url":"https://api.github.com/users/akien-mga/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/akien-mga/subscriptions","organizations_url":"https://api.github.com/users/akien-mga/orgs","repos_url":"https://api.github.com/users/akien-mga/repos","events_url":"https://api.github.com/users/akien-mga/events{/privacy}","received_events_url":"https://api.github.com/users/akien-mga/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/104363/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/godotengine/godot/issues/104363/timeline","performed_via_github_app":null,"state_reason":"completed","pinned_comment":null}