iew_type":"public","site_admin":false},"open_issues":346,"closed_issues":2304,"state":"open","created_at":"2026-04-13T15:59:35Z","updated_at":"2026-10-21T09:34:58Z","due_on":null,"closed_at":null},"comments":3,"created_at":"2026-07-21T17:42:34Z","updated_at":"2026-07-28T14:42:24Z","closed_at":"2026-07-28T14:42:09Z","assignee":null,"author_association":"NONE","issue_field_values":[],"type":null,"active_lock_reason":null,"draft":false,"pull_request":{"url":"https://api.github.com/repos/godotengine/godot/pulls/121610","html_url":"https://github.com/godotengine/godot/pull/121610","diff_url":"https://github.com/godotengine/godot/pull/121610.diff","patch_url":"https://github.com/godotengine/godot/pull/121610.patch","merged_at":"2026-07-28T14:42:09Z"},"body":"Fixes #121201\r\n\r\n`cluster_render.glsl` picks one thread per group to do the `atomicOr` instead of all of them writing the same thing. Helper threads normally get skipped via `gl_HelperInvocation`.\r\n\r\nOn Apple/Metal `gl_HelperInvocation` is unreliable, so that skip got turned off; but the \"pick one thread\" part stayed. The picked thread can be a helper thread, and Metal throws away helper thread writes, so the light bit never lands and the tile ends up black.\r\n\r\nFix: when we can't trust the helper check, don't pick one thread; let them all write. `atomicOr` writing the same bit twice is harmless, and Metal already drops the helper threads' writes.","closed_by":{"login":"Repiteo","id":17489292,"node_id":"MDQ6VXNlcjE3NDg5Mjky","avatar_url":"https://avatars.githubusercontent.com/u/17489292?v=4","gravatar_id":"","url":"https://api.github.com/users/Repiteo","html_url":"https://github.com/Repiteo","followers_url":"https://api.github.com/users/Repiteo/followers","following_url":"https://api.github.com/users/Repiteo/following{/other_user}","gists_url":"https://api.github.com/users/Repiteo/gists{/gist_id}","starred_url":"https://api.github.com/users/Repiteo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Repiteo/subscriptions","organizations_url":"https://api.github.com/users/Repiteo/orgs","repos_url":"https://api.github.com/users/Repiteo/repos","events_url":"https://api.github.com/users/Repiteo/events{/privacy}","received_events_url":"https://api.github.com/users/Repiteo/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/121610/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/godotengine/godot/issues/121610/timeline","performed_via_github_app":null,"state_reason":null}