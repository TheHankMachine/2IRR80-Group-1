rmed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3907562457","html_url":"https://github.com/godotengine/godot/pull/116030#issuecomment-3907562457","issue_url":"https://api.github.com/repos/godotengine/godot/issues/116030","id":3907562457,"node_id":"IC_kwDOAO6SJc7o6KvZ","user":{"login":"Saul2022","id":97898580,"node_id":"U_kgDOBdXQVA","avatar_url":"https://avatars.githubusercontent.com/u/97898580?v=4","gravatar_id":"","url":"https://api.github.com/users/Saul2022","html_url":"https://github.com/Saul2022","followers_url":"https://api.github.com/users/Saul2022/followers","following_url":"https://api.github.com/users/Saul2022/following{/other_user}","gists_url":"https://api.github.com/users/Saul2022/gists{/gist_id}","starred_url":"https://api.github.com/users/Saul2022/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Saul2022/subscriptions","organizations_url":"https://api.github.com/users/Saul2022/orgs","repos_url":"https://api.github.com/users/Saul2022/repos","events_url":"https://api.github.com/users/Saul2022/events{/privacy}","received_events_url":"https://api.github.com/users/Saul2022/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-02-16T10:06:00Z","updated_at":"2026-02-16T10:06:00Z","body":"Maybe it would be a better idea  to double check the part of the code that makes uses of the artifact free lightmap  implementation as the reasson it might work as expected might be because it has bugs or not well implemented. ","author_association":"NONE","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3907562457/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3916656959","html_url":"https://github.com/godotengine/godot/pull/116030#issuecomment-3916656959","issue_url":"https://api.github.com/repos/godotengine/godot/issues/116030","id":3916656959,"node_id":"IC_kwDOAO6SJc7pc3E_","user":{"login":"expenses","id":13566135,"node_id":"MDQ6VXNlcjEzNTY2MTM1","avatar_url":"https://avatars.githubusercontent.com/u/13566135?v=4","gravatar_id":"","url":"https://api.github.com/users/expenses","html_url":"https://github.com/expenses","followers_url":"https://api.github.com/users/expenses/followers","following_url":"https://api.github.com/users/expenses/following{/other_user}","gists_url":"https://api.github.com/users/expenses/gists{/gist_id}","starred_url":"https://api.github.com/users/expenses/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/expenses/subscriptions","organizations_url":"https://api.github.com/users/expenses/orgs","repos_url":"https://api.github.com/users/expenses/repos","events_url":"https://api.github.com/users/expenses/events{/privacy}","received_events_url":"https://api.github.com/users/expenses/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-02-17T19:21:47Z","updated_at":"2026-02-17T19:21:47Z","body":"Here's my current hot take :)\r\n\r\nhttps://ndotl.wordpress.com/2018/08/29/baking-artifact-free-lightmaps/ is overrated (not that many people were rating it, exactly). It contains a lot of good info, but the hacks are fairly hacky. [Precomputed Global Illumination in Frostbite](https://media.contentapi.ea.com/content/dam/eacom/frostbite/files/gdc2018-precomputedgiobalilluminationinfrostbite.pdf) is my current go-to. The main thing that I'm learning is that supersampling gets you 90% of the way to good quality lightmaps. You then just add dilation and to clean up the seams.\r\n\r\nShadow leaks are still a problem, but IME the solution from artifact-free-lightmaps isn't that good. The one that the frostbite paper mentions is to track what % of rays hit a backface, and exclude texels that have a over 50% backface hit rate, replacing them with dilated values. This seems a lot cleaner to me.","author_association":"NONE","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3916656959/reactions","total_count":2,"+1":2,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null}]