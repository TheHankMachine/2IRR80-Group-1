583,"node_id":"MDQ6VXNlcjI5NDYwNTgz","avatar_url":"https://avatars.githubusercontent.com/u/29460583?v=4","gravatar_id":"","url":"https://api.github.com/users/ej-sanmartin","html_url":"https://github.com/ej-sanmartin","followers_url":"https://api.github.com/users/ej-sanmartin/followers","following_url":"https://api.github.com/users/ej-sanmartin/following{/other_user}","gists_url":"https://api.github.com/users/ej-sanmartin/gists{/gist_id}","starred_url":"https://api.github.com/users/ej-sanmartin/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/ej-sanmartin/subscriptions","organizations_url":"https://api.github.com/users/ej-sanmartin/orgs","repos_url":"https://api.github.com/users/ej-sanmartin/repos","events_url":"https://api.github.com/users/ej-sanmartin/events{/privacy}","received_events_url":"https://api.github.com/users/ej-sanmartin/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-01-03T00:49:13Z","updated_at":"2026-01-03T00:49:13Z","body":"I'll check and let you know if it fixes the issue!\n\nAnd yeah 5 years is a while, I don't see why we would remove the skeleton though. Hope it doesn't cause any issues downstream when I add it back in 🤞🏼","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3706548154/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3706554876","html_url":"https://github.com/godotengine/godot/issues/114110#issuecomment-3706554876","issue_url":"https://api.github.com/repos/godotengine/godot/issues/114110","id":3706554876,"node_id":"IC_kwDOAO6SJc7c7Yn8","user":{"login":"fire","id":32321,"node_id":"MDQ6VXNlcjMyMzIx","avatar_url":"https://avatars.githubusercontent.com/u/32321?v=4","gravatar_id":"","url":"https://api.github.com/users/fire","html_url":"https://github.com/fire","followers_url":"https://api.github.com/users/fire/followers","following_url":"https://api.github.com/users/fire/following{/other_user}","gists_url":"https://api.github.com/users/fire/gists{/gist_id}","starred_url":"https://api.github.com/users/fire/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/fire/subscriptions","organizations_url":"https://api.github.com/users/fire/orgs","repos_url":"https://api.github.com/users/fire/repos","events_url":"https://api.github.com/users/fire/events{/privacy}","received_events_url":"https://api.github.com/users/fire/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-01-03T00:59:12Z","updated_at":"2026-01-03T00:59:12Z","body":"It'll cause a lot of trouble, so I wanted to check if it's related.","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3706554876/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3707017535","html_url":"https://github.com/godotengine/godot/issues/114110#issuecomment-3707017535","issue_url":"https://api.github.com/repos/godotengine/godot/issues/114110","id":3707017535,"node_id":"IC_kwDOAO6SJc7c9Jk_","user":{"login":"unwave","id":39925416,"node_id":"MDQ6VXNlcjM5OTI1NDE2","avatar_url":"https://avatars.githubusercontent.com/u/39925416?v=4","gravatar_id":"","url":"https://api.github.com/users/unwave","html_url":"https://github.com/unwave","followers_url":"https://api.github.com/users/unwave/followers","following_url":"https://api.github.com/users/unwave/following{/other_user}","gists_url":"https://api.github.com/users/unwave/gists{/gist_id}","starred_url":"https://api.github.com/users/unwave/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/unwave/subscriptions","organizations_url":"https://api.github.com/users/unwave/orgs","repos_url":"https://api.github.com/users/unwave/repos","events_url":"https://api.github.com/users/unwave/events{/privacy}","received_events_url":"https://api.github.com/users/unwave/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-01-03T12:18:14Z","updated_at":"2026-01-03T12:29:26Z","body":"@fire \n\nI want to see the root bone animation being the same as in Godot. But it is just wrong. The bone is offset and barely moves. But it has some animation keys, so it signals that the conversion is bugged. I was not sure that the problem was only with the root bones. You can see the jittery movement of the root bone in the GIF, that is the animation I get.\n\nI have tried other glTF viewers to make sure that the issue is within the Godot's glTF conversion and not in the way Blender imports the file.","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3707017535/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3707929988","html_url":"https://github.com/godotengine/godot/issues/114110#issuecomment-3707929988","issue_url":"https://api.github.com/repos/godotengine/godot/issues/114110","id":3707929988,"node_id":"IC_kwDOAO6SJc7dAoWE","user":{"login":"ej-sanmartin","id":29460583,"node_id":"MDQ6VXNlcjI5NDYwNTgz","avatar_url":"https://avatars.githubusercontent.com/u/29460583?v=4","gravatar_id":"","url":"https://api.github.com/users/ej-sanmartin","html_url":"https://github.com/ej-sanmartin","followers_url":"https://api.github.com/users/ej-sanmartin/followers","following_url":"https://api.github.com/users/ej-sanmartin/following{/other_user}","gists_url":"https://api.github.com/users/ej-sanmartin/gists{/gist_id}","starred_url":"https://api.github.com/users/ej-sanmartin/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/ej-sanmartin/subscriptions","organizations_url":"https://api.github.com/users/ej-sanmartin/orgs","repos_url":"https://api.github.com/users/ej-sanmartin/repos","events_url":"https://api.github.com/users/ej-sanmartin/events{/privacy}","received_events_url":"https://api.github.com/users/ej-sanmartin/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-01-04T10:00:48Z","updated_at":"2026-01-04T10:01:35Z","body":"Adding the `Skeleton3D` instead of throwing it away during `glTF` exports preserves `Skeleton3D` during `export -> re-import` workflows, as well as the issue author's described use case. Even more so, it seems that the root bone transforms are defined *relative* to the `Skeleton3D`, so I'd hypothesize not having `Skeleton3D` would cause issues like we are seeing in this bug.\n\nSo exports would be updated from roughly this hierarchy:\n\n```\nParent Node\n├── RootBone\n└── ChildBone\n```\n\nTo this:\n\n```\nParent Node\n└── Skeleton3D Node\n    ├── RootBone\n    └── ChildBone\n```\n\nHowever, I imagine that lots of internal Godot codepaths and third party exporter tools depend on this structure and thus adding `Skeleton3D` would be a breaking change and we'd have to handle this carefully.\n\nSo we aren't *totally* breaking all `glTF` exports, we can add a toggle for this, defaulting to current export behavior. But silently discarding the `Skeleton3D` is wrong since its transform is meaningful data needed for correctly animating a model.","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3707929988/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3804358861","html_url":"https://github.com/godotengine/godot/issues/114110#issuecomment-3804358861","issue_url":"https://api.github.com/repos/godotengine/godot/issues/114110","id":3804358861,"node_id":"IC_kwDOAO6SJc7iwejN","user":{"login":"brumansniffer","id":248164060,"node_id":"U_kgDODsqu3A","avatar_url":"https://avatars.githubusercontent.com/u/248164060?v=4","gravatar_id":"","url":"https://api.github.com/users/brumansniffer","html_url":"https://github.com/brumansniffer","followers_url":"https://api.github.com/users/brumansniffer/followers","following_url":"https://api.github.com/users/brumansniffer/following{/other_user}","gists_url":"https://api.github.com/users/brumansniffer/gists{/gist_id}","starred_url":"https://api.github.com/users/brumansniffer/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/brumansniffer/subscriptions","organizations_url":"https://api.github.com/users/brumansniffer/orgs","repos_url":"https://api.github.com/users/brumansniffer/repos","events_url":"https://api.github.com/users/brumansniffer/events{/privacy}","received_events_url":"https://api.github.com/users/brumansniffer/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-01-27T10:27:51Z","updated_at":"2026-01-27T11:01:18Z","body":"Hello, im facing similar problem but on blender export and godot import.  My skeleton is set up as per last post. And still the root rotation rotates wrongfully.\n\n<img width=\"335\" height=\"406\" alt=\"Image\" src=\"https://github.com/user-attachments/assets/b8ba0d7c-a14e-405f-a666-c8705f6b7bb8\" />\n\nHere the turn around animation supposed to turn around and run in opposite direction, the root bone in blender rotates along the vertical axis. But in godot it is messed up..\n\nhttps://streamable.com/wvfs3j\n\nhttps://streamable.com/i15dy8\n\nIn godot import tab it looks correct\nhttps://streamable.com/aj6z7t\n\nBut when i do this:\n\n```\n\t\tvelocity = get_quaternion() * anim_player.get_root_motion_position() / delta\n\t\tset_quaternion(get_quaternion() * anim_player.get_root_motion_rotation())\n```\n\nThe rotation is messed up.\n\nRunning forward root motion works fine, but turn around not so much.\n\nGodot version 4.5.1 stable\n\nAny advice?\n\nEDIT:\n\nReimported with only deform bones. still same problem.. more tests, but i dont know what else to change.\n\nhttps://streamable.com/4pa4fn\n\n","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3804358861/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3805761293","html_url":"https://github.com/godotengine/godot/issues/114110#issuecomment-3805761293","issue_url":"https://api.github.com/repos/godotengine/godot/issues/114110","id":3805761293,"node_id":"IC_kwDOAO6SJc7i108N","user":{"login":"unwave","id":39925416,"node_id":"MDQ6VXNlcjM5OTI1NDE2","avatar_url":"https://avatars.githubusercontent.com/u/39925416?v=4","gravatar_id":"","url":"https://api.github.com/users/unwave","html_url":"https://github.com/unwave","followers_url":"https://api.github.com/users/unwave/followers","following_url":"https://api.github.com/users/unwave/following{/other_user}","gists_url":"https://api.github.com/users/unwave/gists{/gist_id}","starred_url":"https://api.github.com/users/unwave/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/unwave/subscriptions","organizations_url":"https://api.github.com/users/unwave/orgs","repos_url":"https://api.github.com/users/unwave/repos","events_url":"https://api.github.com/users/unwave/events{/privacy}","received_events_url":"https://api.github.com/users/unwave/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-01-27T15:10:47Z","updated_at":"2026-01-27T15:10:47Z","body":"@brumansniffer \nI think it's better to report your issue separately. While both can stem from some general mismanagement of the root bones, your issue is in importing into Godot, so it's a higher priority. The problems with exporting from a game engine back to a DCC software are rather disregarded across all the engines. It is often lossy with no workarounds.","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3805761293/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3835052142","html_url":"https://github.com/godotengine/godot/issues/114110#issuecomment-3835052142","issue_url":"https://api.github.com/repos/godotengine/godot/issues/114110","id":3835052142,"node_id":"IC_kwDOAO6SJc7klkBu","user":{"login":"brumansniffer","id":248164060,"node_id":"U_kgDODsqu3A","avatar_url":"https://avatars.githubusercontent.com/u/248164060?v=4","gravatar_id":"","url":"https://api.github.com/users/brumansniffer","html_url":"https://github.com/brumansniffer","followers_url":"https://api.github.com/users/brumansniffer/followers","following_url":"https://api.github.com/users/brumansniffer/following{/other_user}","gists_url":"https://api.github.com/users/brumansniffer/gists{/gist_id}","starred_url":"https://api.github.com/users/brumansniffer/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/brumansniffer/subscriptions","organizations_url":"https://api.github.com/users/brumansniffer/orgs","repos_url":"https://api.github.com/users/brumansniffer/repos","events_url":"https://api.github.com/users/brumansniffer/events{/privacy}","received_events_url":"https://api.github.com/users/brumansniffer/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-02-02T13:13:38Z","updated_at":"2026-02-02T13:13:38Z","body":"> [@brumansniffer](https://github.com/brumansniffer) I think it's better to report your issue separately. While both can stem from some general mismanagement of the root bones, your issue is in importing into Godot, so it's a higher priority. The problems with exporting from a game engine back to a DCC software are rather disregarded across all the engines. It is often lossy with no workarounds.\n\nYeah, sorry, posted in haste, didnt read that its export issue, wwhile i had import issue. But my issue was resolved, through trial and error. All i had to do is upon import into godot, do a new bone remap/map and specify bones, and it will generate new skeleton3D node and this will work fine. Not sure why the default skeleton that gets created upon import does not work.\n\nDocumentation kinda didnt explain that i would have to remap my skeleton in \"some\" cases. Only in root motion case this is to be done. ","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3835052142/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null}]