[{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2897463292","html_url":"https://github.com/godotengine/godot/issues/102500#issuecomment-2897463292","issue_url":"https://api.github.com/repos/godotengine/godot/issues/102500","id":2897463292,"node_id":"IC_kwDOAO6SJc6ss8f8","user":{"login":"paskausks","id":5221695,"node_id":"MDQ6VXNlcjUyMjE2OTU=","avatar_url":"https://avatars.githubusercontent.com/u/5221695?v=4","gravatar_id":"","url":"https://api.github.com/users/paskausks","html_url":"https://github.com/paskausks","followers_url":"https://api.github.com/users/paskausks/followers","following_url":"https://api.github.com/users/paskausks/following{/other_user}","gists_url":"https://api.github.com/users/paskausks/gists{/gist_id}","starred_url":"https://api.github.com/users/paskausks/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/paskausks/subscriptions","organizations_url":"https://api.github.com/users/paskausks/orgs","repos_url":"https://api.github.com/users/paskausks/repos","events_url":"https://api.github.com/users/paskausks/events{/privacy}","received_events_url":"https://api.github.com/users/paskausks/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-05-21T10:36:36Z","updated_at":"2025-05-21T10:36:36Z","body":"Added another repro case and adjusted the title to better reflect the nature of the issue.","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2897463292/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2897533575","html_url":"https://github.com/godotengine/godot/issues/102500#issuecomment-2897533575","issue_url":"https://api.github.com/repos/godotengine/godot/issues/102500","id":2897533575,"node_id":"IC_kwDOAO6SJc6stNqH","user":{"login":"YuriSizov","id":11782833,"node_id":"MDQ6VXNlcjExNzgyODMz","avatar_url":"https://avatars.githubusercontent.com/u/11782833?v=4","gravatar_id":"","url":"https://api.github.com/users/YuriSizov","html_url":"https://github.com/YuriSizov","followers_url":"https://api.github.com/users/YuriSizov/followers","following_url":"https://api.github.com/users/YuriSizov/following{/other_user}","gists_url":"https://api.github.com/users/YuriSizov/gists{/gist_id}","starred_url":"https://api.github.com/users/YuriSizov/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/YuriSizov/subscriptions","organizations_url":"https://api.github.com/users/YuriSizov/orgs","repos_url":"https://api.github.com/users/YuriSizov/repos","events_url":"https://api.github.com/users/YuriSizov/events{/privacy}","received_events_url":"https://api.github.com/users/YuriSizov/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-05-21T11:04:00Z","updated_at":"2025-05-21T12:58:11Z","body":"Doesn't seem to have anything to do with bluetooth! In fact, my (very cheap) BT in-ears don't even have a setting below 48k Hz 😅\n\nBut I tested with my USB Logitech PRO X headset, and if I set it to 16k in Windows settings, the sound just clicks and doesn't play. If I set it to 32k, it plays half a second of music and then turns into a very unpleasant, potentially ear-damaging high pitch signal. At 44.1k it's fine.\n\n<img width=\"233\" alt=\"Image\" src=\"https://github.com/user-attachments/assets/051663b4-0264-47a7-904f-c51d35b02b4f\" />\n\nGodot 4.3, btw.\n\n\nEdit: All this suggests that there is a buffer size problem of some sort. But I have no idea where and why. Probably the device's sample rate needs to be accounted for and be used as a cap, if I had to make a guess?","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2897533575/reactions","total_count":2,"+1":2,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2908677503","html_url":"https://github.com/godotengine/godot/issues/102500#issuecomment-2908677503","issue_url":"https://api.github.com/repos/godotengine/godot/issues/102500","id":2908677503,"node_id":"IC_kwDOAO6SJc6tXuV_","user":{"login":"MJacred","id":6639237,"node_id":"MDQ6VXNlcjY2MzkyMzc=","avatar_url":"https://avatars.githubusercontent.com/u/6639237?v=4","gravatar_id":"","url":"https://api.github.com/users/MJacred","html_url":"https://github.com/MJacred","followers_url":"https://api.github.com/users/MJacred/followers","following_url":"https://api.github.com/users/MJacred/following{/other_user}","gists_url":"https://api.github.com/users/MJacred/gists{/gist_id}","starred_url":"https://api.github.com/users/MJacred/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/MJacred/subscriptions","organizations_url":"https://api.github.com/users/MJacred/orgs","repos_url":"https://api.github.com/users/MJacred/repos","events_url":"https://api.github.com/users/MJacred/events{/privacy}","received_events_url":"https://api.github.com/users/MJacred/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-05-26T06:20:13Z","updated_at":"2025-05-26T06:20:13Z","body":"Possibly related to\n* https://github.com/godotengine/godot/issues/46595\n  * https://github.com/godotengine/godot/issues/23544\n\n","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2908677503/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2960751546","html_url":"https://github.com/godotengine/godot/issues/102500#issuecomment-2960751546","issue_url":"https://api.github.com/repos/godotengine/godot/issues/102500","id":2960751546,"node_id":"IC_kwDOAO6SJc6weXu6","user":{"login":"BuzzLord","id":11238951,"node_id":"MDQ6VXNlcjExMjM4OTUx","avatar_url":"https://avatars.githubusercontent.com/u/11238951?v=4","gravatar_id":"","url":"https://api.github.com/users/BuzzLord","html_url":"https://github.com/BuzzLord","followers_url":"https://api.github.com/users/BuzzLord/followers","following_url":"https://api.github.com/users/BuzzLord/following{/other_user}","gists_url":"https://api.github.com/users/BuzzLord/gists{/gist_id}","starred_url":"https://api.github.com/users/BuzzLord/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/BuzzLord/subscriptions","organizations_url":"https://api.github.com/users/BuzzLord/orgs","repos_url":"https://api.github.com/users/BuzzLord/repos","events_url":"https://api.github.com/users/BuzzLord/events{/privacy}","received_events_url":"https://api.github.com/users/BuzzLord/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-06-10T22:46:28Z","updated_at":"2025-06-10T22:46:28Z","body":"I was able to reproduce the issue, so I thought I'd take a look at this.\n\nFor a lowpass filter, when the cutoff frequency is above half the audio drivers sampling rate, then the coefficients that are calculated will cause a feedback loop, blowing up the audio samples. For cutoffs far above that halfway point, the explosion happens quickly, leading to the short click. When you pick something very close to the halfway point, like 16001 when using an audio device running 32 kHz, you'll hear a second or two of normal-ish sound before it eventually compounds and blows up (leading to a very unpleasant high pitched squeal).\n\nThere seems to be a guard for this at the start of `AudioFilterSW::prepare_coefficients`, \n\nhttps://github.com/godotengine/godot/blob/db57f282fa3994fc727638dc5c17679f30cb06f4/servers/audio/audio_filter_sw.cpp#L55-L58\n\nbut `sr_limit` has 512 added to it for some reason (making it not work for this issue), which I'm not entirely clear on. All audio filters (lowpass, highpass, bandpass, notch, etc) use this function to configure their coefficients, so maybe it's there for something else.\n\nI don't have the signal processing expertise to propose a fix, but maybe someone else will see this, and can see what's going on here. A potential work around would be to cap the LPF cutoff at `AudioServer.get_mix_rate() / 2` at runtime.","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2960751546/reactions","total_count":4,"+1":2,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":2,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5007233689","html_url":"https://github.com/godotengine/godot/issues/102500#issuecomment-5007233689","issue_url":"https://api.github.com/repos/godotengine/godot/issues/102500","id":5007233689,"node_id":"IC_kwDOAO6SJc8AAAABKnRSmQ","user":{"login":"jeybee","id":377127,"node_id":"MDQ6VXNlcjM3NzEyNw==","avatar_url":"https://avatars.githubusercontent.com/u/377127?v=4","gravatar_id":"","url":"https://api.github.com/users/jeybee","html_url":"https://github.com/jeybee","followers_url":"https://api.github.com/users/jeybee/followers","following_url":"https://api.github.com/users/jeybee/following{/other_user}","gists_url":"https://api.github.com/users/jeybee/gists{/gist_id}","starred_url":"https://api.github.com/users/jeybee/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/jeybee/subscriptions","organizations_url":"https://api.github.com/users/jeybee/orgs","repos_url":"https://api.github.com/users/jeybee/repos","events_url":"https://api.github.com/users/jeybee/events{/privacy}","received_events_url":"https://api.github.com/users/jeybee/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-07-17T20:31:24Z","updated_at":"2026-07-17T20:32:00Z","body":"Want to follow up on this still-existing issue which we just had multiple reports of with a newly released game where all audio was sounding like beeps.\n\nThe documentation for AudioStreamPlayer3D tells you to set attenuation_filter_cutoff_hz to 20500hz to disable the attenuation effect, but presumably because of the coefficients above, if someone is using a Bluetooth headset for audio while also using it for microphone and their sample rate is reduced to 16khz/24khz, and you set attenuation_filter_cutoff_hz to anything above half the AudioServer.get_mix_rate() your audio will collapse into the high pitched beep/squeal.\n\nYou can easily recreate this using Airpods on Mac, while recording with the microphone, and setting an AudioStreamPlayer3D  attenuation_filter_cutoff_hz to 20500hz.","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5007233689/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null}]