e_lock_reason":null,"draft":false,"pull_request":{"url":"https://api.github.com/repos/godotengine/godot/pulls/116459","html_url":"https://github.com/godotengine/godot/pull/116459","diff_url":"https://github.com/godotengine/godot/pull/116459.diff","patch_url":"https://github.com/godotengine/godot/pull/116459.patch","merged_at":null},"body":"\r\nFixes a regression where all .csv files are forced to open in the script/text editor. #115945\r\n\r\nIn 4.6, this breaks custom CSV importers (for example csv_data_importer) because imported resources exist and are remapped correctly, but the editor still opens the source CSV as text instead of loading the imported resource in Inspector.\r\n\r\nAdded Code: \r\n- Keep forcing `.csv` to text only for `Translation` CSV sources.\r\n- For non-`Translation` CSV files, try normal ResourceLoader::load() first.\r\n- Fall back to text opening only when resource loading is not applicable.\r\n\r\n\r\n\r\n","closed_by":{"login":"Bashar-R","id":191822660,"node_id":"U_kgDOC277RA","avatar_url":"https://avatars.githubusercontent.com/u/191822660?v=4","gravatar_id":"","url":"https://api.github.com/users/Bashar-R","html_url":"https://github.com/Bashar-R","followers_url":"https://api.github.com/users/Bashar-R/followers","following_url":"https://api.github.com/users/Bashar-R/following{/other_user}","gists_url":"https://api.github.com/users/Bashar-R/gists{/gist_id}","starred_url":"https://api.github.com/users/Bashar-R/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Bashar-R/subscriptions","organizations_url":"https://api.github.com/users/Bashar-R/orgs","repos_url":"https://api.github.com/users/Bashar-R/repos","events_url":"https://api.github.com/users/Bashar-R/events{/privacy}","received_events_url":"https://api.github.com/users/Bashar-R/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/116459/reactions","total_count":0,"+1"