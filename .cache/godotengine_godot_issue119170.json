.\n\n### Minimal reproduction project (MRP)\n\nN/A (issue occurs without any project)\n\nhttps://github.com/user-attachments/assets/0d4af494-23d6-4f41-9711-3279099f0dff","closed_by":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/119170/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/godotengine/godot/issues/119170/timeline","performed_via_github_app":null,"state_reason":null,"pinned_comment":null}