8/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":null,"original_line":330,"side":"RIGHT","author_association":"MEMBER","original_position":5,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/3887224305","pull_request_review_id":5058705359,"id":3887224305,"node_id":"PRRC_kwDOAO6SJc7nslXx","diff_hunk":"@@ -7518,6 +7549,7 @@ void Tree::_bind_methods() {\n \n \tADD_PROPERTY(PropertyInfo(Variant::INT, \"columns\"), \"set_columns\", \"get_columns\");\n \tADD_PROPERTY(PropertyInfo(Variant::BOOL, \"column_titles_visible\"), \"set_column_titles_visible\", \"are_column_titles_visible\");\n+\tADD_PROPERTY(PropertyInfo(Variant::BOOL, \"row_stripes_visible\"), \"set_row_stripes_visible\", \"are_row_stripes_visible\");","path":"scene/gui/tree.cpp","commit_id":"16fafb9a38dcd94d0441f6451873c6a23e56b085","original_commit_id":"16fafb9a38dcd94d0441f6451873c6a23e56b085","user":{"login":"Mickeon","id":66727710,"node_id":"MDQ6VXNlcjY2NzI3NzEw","avatar_url":"https://avatars.githubusercontent.com/u/66727710?v=4","gravatar_id":"","url":"https://api.github.com/users/Mickeon","html_url":"https://github.com/Mickeon","followers_url":"https://api.github.com/users/Mickeon/followers","following_url":"https://api.github.com/users/Mickeon/following{/other_user}","gists_url":"https://api.github.com/users/Mickeon/gists{/gist_id}","starred_url":"https://api.github.com/users/Mickeon/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Mickeon/subscriptions","organizations_url":"https://api.github.com/users/Mickeon/orgs","repos_url":"https://api.github.com/users/Mickeon/repos","events_url":"https://api.github.com/users/Mickeon/events{/privacy}","received_events_url":"https://api.github.com/users/Mickeon/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"Nnnnno. I am a bit concerned about this. I'm pretty sure this should be a theme item, but @godotengine/gui-nodes would have to back me up on this. My reasoning is:\n- This is a rather notable aesthetic change that _I would imagine_ most users would rather have propagate across a whole theme.\n- The `row_stripes` stylebox, which depends on this property, is already a theme item. So one \"variable\" propagates, but the other doesn't and still needs to be enabled on a case-by-case basis.\n\t- For more granularity it's still possible to override theme items for each Tree.\n\nNote that we are no strangers to using theme constants as makeshift boolean properties (`0` for `false`, anything else is `true`).\nSee `draw_relationship_lines` and `draw_guides` on **Tree** itself. One could argue this property should be a theme item named `draw_stripes` or similar, instead.","created_at":"2026-08-29T17:34:29Z","updated_at":"2026-08-29T17:38:04Z","html_url":"https://github.com/godotengine/godot/pull/111283#discussion_r3887224305","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/111283","_links":{"self":{"href":"https://api.github.com/repos/godotengine/godot/pulls/comments/3887224305"},"html":{"href":"https://github.com/godotengine/godot/pull/111283#discussion_r3887224305"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/111283"}},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/3887224305/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":null,"original_line":7552,"side":"RIGHT","author_association":"MEMBER","original_position":148,"position":1,"subject_type":"line"}]