[{"id":3663478452,"node_id":"PRR_kwDOAO6SJc7aXD60","user":{"login":"TokageItLab","id":61938263,"node_id":"MDQ6VXNlcjYxOTM4MjYz","avatar_url":"https://avatars.githubusercontent.com/u/61938263?u=9b90963f1b4f17720e50bbbe495fbe8c84c8bc8e&v=4","gravatar_id":"","url":"https://api.github.com/users/TokageItLab","html_url":"https://github.com/TokageItLab","followers_url":"https://api.github.com/users/TokageItLab/followers","following_url":"https://api.github.com/users/TokageItLab/following{/other_user}","gists_url":"https://api.github.com/users/TokageItLab/gists{/gist_id}","starred_url":"https://api.github.com/users/TokageItLab/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/TokageItLab/subscriptions","organizations_url":"https://api.github.com/users/TokageItLab/orgs","repos_url":"https://api.github.com/users/TokageItLab/repos","events_url":"https://api.github.com/users/TokageItLab/events{/privacy}","received_events_url":"https://api.github.com/users/TokageItLab/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"In #76052, what I fixed was that when the camera was parallel to the axis, the axis button display itself was inverted. Specifically, in Front View, the -Z (dark blue) button was displayed, resulting in an inconsistency where the button did not correctly indicate the user's current position. So I have fixed that.\r\n\r\nIn this PR, it internally adds a flag to determine if the clicking result should be inverted in that case. So the drawing itself remains unchanged. Since this approach maintains display consistency, I think it's fine to merge this and allow axis inversion by clicking.","state":"APPROVED","html_url":"https://github.com/godotengine/godot/pull/101209#pullrequestreview-3663478452","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/101209","author_association":"MEMBER","_links":{"html":{"href":"https://github.com/godotengine/godot/pull/101209#pullrequestreview-3663478452"},"p