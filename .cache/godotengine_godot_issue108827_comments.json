[{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3096134583","html_url":"https://github.com/godotengine/godot/issues/108827#issuecomment-3096134583","issue_url":"https://api.github.com/repos/godotengine/godot/issues/108827","id":3096134583,"node_id":"IC_kwDOAO6SJc64i0O3","user":{"login":"Changryy","id":35406747,"node_id":"MDQ6VXNlcjM1NDA2NzQ3","avatar_url":"https://avatars.githubusercontent.com/u/35406747?v=4","gravatar_id":"","url":"https://api.github.com/users/Changryy","html_url":"https://github.com/Changryy","followers_url":"https://api.github.com/users/Changryy/followers","following_url":"https://api.github.com/users/Changryy/following{/other_user}","gists_url":"https://api.github.com/users/Changryy/gists{/gist_id}","starred_url":"https://api.github.com/users/Changryy/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Changryy/subscriptions","organizations_url":"https://api.github.com/users/Changryy/orgs","repos_url":"https://api.github.com/users/Changryy/repos","events_url":"https://api.github.com/users/Changryy/events{/privacy}","received_events_url":"https://api.github.com/users/Changryy/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-07-21T10:38:20Z","updated_at":"2025-07-21T10:38:20Z","body":"It is documented that the order of the operations is read from right to left, but I agree that an additional example can be included to make it more clear.\n\n<img width=\"614\" height=\"274\" alt=\"Image\" src=\"https://github.com/user-attachments/assets/bd0dcd26-49eb-462d-ac21-f340895d689d\" />","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3096134583/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3096576449","html_url":"https://github.com/godotengine/godot/issues/108827#issuecomment-3096576449","issue_url":"https://api.github.com/repos/godotengine/godot/issues/108827","id":3096576449,"node_id":"IC_kwDOAO6SJc64kgHB","user":{"login":"dalexeev","id":47700418,"node_id":"MDQ6VXNlcjQ3NzAwNDE4","avatar_url":"https://avatars.githubusercontent.com/u/47700418?v=4","gravatar_id":"","url":"https://api.github.com/users/dalexeev","html_url":"https://github.com/dalexeev","followers_url":"https://api.github.com/users/dalexeev/followers","following_url":"https://api.github.com/users/dalexeev/following{/other_user}","gists_url":"https://api.github.com/users/dalexeev/gists{/gist_id}","starred_url":"https://api.github.com/users/dalexeev/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/dalexeev/subscriptions","organizations_url":"https://api.github.com/users/dalexeev/orgs","repos_url":"https://api.github.com/users/dalexeev/repos","events_url":"https://api.github.com/users/dalexeev/events{/privacy}","received_events_url":"https://api.github.com/users/dalexeev/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-07-21T12:37:49Z","updated_at":"2025-07-21T12:37:49Z","body":"`bind()` and `unbind()` do not modify a list of arguments bound to the callable, but create a wrapper over the previous callable, impose the \"effects\" of binding/unbinding arguments, which are applied in reverse order (from right to left) when the callable is called. I agree that this is a bit non-obvious, but this is the current design and it is already documented in some detail. Do you have any suggestions for improving this documentation?","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3096576449/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.co