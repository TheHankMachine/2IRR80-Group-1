/godotengine/godot/issues/103744","id":3707885080,"node_id":"IC_kwDOAO6SJc7dAdYY","user":{"login":"Nintorch","id":92302738,"node_id":"U_kgDOBYBtkg","avatar_url":"https://avatars.githubusercontent.com/u/92302738?v=4","gravatar_id":"","url":"https://api.github.com/users/Nintorch","html_url":"https://github.com/Nintorch","followers_url":"https://api.github.com/users/Nintorch/followers","following_url":"https://api.github.com/users/Nintorch/following{/other_user}","gists_url":"https://api.github.com/users/Nintorch/gists{/gist_id}","starred_url":"https://api.github.com/users/Nintorch/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Nintorch/subscriptions","organizations_url":"https://api.github.com/users/Nintorch/orgs","repos_url":"https://api.github.com/users/Nintorch/repos","events_url":"https://api.github.com/users/Nintorch/events{/privacy}","received_events_url":"https://api.github.com/users/Nintorch/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-01-04T09:00:08Z","updated_at":"2026-03-19T07:51:38Z","body":"Another possible candidate for the base of this PR: https://github.com/godotengine/godot/pull/117526 :D (well, when it's ready, that is...)","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3707885080/reactions","total_count":1,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":1,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4821244731","html_url":"https://github.com/godotengine/godot/pull/103744#issuecomment-4821244731","issue_url":"https://api.github.com/repos/godotengine/godot/issues/103744","id":4821244731,"node_id":"IC_kwDOAO6SJc8AAAABH15bOw","user":{"login":"nuke-haus","id":47336974,"node_id":"MDQ6VXNlcjQ3MzM2OTc0","avatar_url":"https://avatars.githubusercontent.com/u/47336974?v=4","gravatar_id":"","url":"https://api.github.com/users/nuke-haus","html_url":"https://github.com/nuke-haus","followers_url":"https://api.github.com/users/nuke-haus/followers","following_url":"https://api.github.com/users/nuke-haus/following{/other_user}","gists_url":"https://api.github.com/users/nuke-haus/gists{/gist_id}","starred_url":"https://api.github.com/users/nuke-haus/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/nuke-haus/subscriptions","organizations_url":"https://api.github.com/users/nuke-haus/orgs","repos_url":"https://api.github.com/users/nuke-haus/repos","events_url":"https://api.github.com/users/nuke-haus/events{/privacy}","received_events_url":"https://api.github.com/users/nuke-haus/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-06-27T20:21:02Z","updated_at":"2026-06-27T20:22:03Z","body":"+1 to this PR\r\n\r\nThe A button on Xbox is most definitely not the same as pressing B on Nintendo. \r\n\r\nA game will fail Nintendo's certification gauntlet if it does not properly handle their inputs as they expect.\r\n\r\nWe need the south button to have distinct events for each console type. This might mean requiring new categories for each instead of using a generic category that encompasses everything.\r\n\r\n<img width=\"918\" height=\"255\" alt=\"Screenshot 2026-06-27 161916\" src=\"https://github.com/user-attachments/assets/d4eeae36-4e7f-4552-8e86-423f30990160\" />\r\n\r\n\r\n","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4821244731/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null}]