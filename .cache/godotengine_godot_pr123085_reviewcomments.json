repos_url":"https://api.github.com/users/KoBeWi/repos","events_url":"https://api.github.com/users/KoBeWi/events{/privacy}","received_events_url":"https://api.github.com/users/KoBeWi/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"Not sure about keeping it for each selected TileMap. The cache is never cleared, so it will keep getting entries forever (even for the same nodes if you reload the scene).\n\nYou could remember it for the last used TileSet.","created_at":"2026-09-02T21:19:39Z","updated_at":"2026-09-02T21:21:57Z","html_url":"https://github.com/godotengine/godot/pull/123085#discussion_r3918778862","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/123085","_links":{"self":{"href":"https://api.github.com/repos/godotengine/godot/pulls/comments/3918778862"},"html":{"href":"https://github.com/godotengine/godot/pull/123085#discussion_r3918778862"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/123085"}},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/3918778862/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":341,"original_line":341,"side":"RIGHT","author_association":"MEMBER","original_position":5,"position":5,"subject_type":"line"},{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/3918843005","pull_request_review_id":5095302314,"id":3918843005,"node_id":"PRRC_kwDOAO6SJc7plMx9","diff_hunk":"@@ -337,6 +337,10 @@ class TileMapLayerEditorTerrainsPlugin : public TileMapLayerSubEditorPlugin {\n \tTileSet::TerrainsPattern selected_terrains_pattern;\n \tvoid _update_selection();\n \n+\t// Terrain selection restoration\n+\tHashMap<ObjectID, Vector2i> last_selected_terrain_by_layer;","path":"modules/tilemap/editor/tile_map_layer_editor.h","commit_id":"5d8ca92d225e5a1713e3a5b6ad437cc18f17aae3","original_commit_id":"e06526a1467048a51c6b2ea77915206badc341b4","user":{"login":"GiacomoPope","id":44242839,"node_id":"MDQ6VXNlcjQ0MjQyODM5","avatar_url":"https://avatars.githubusercontent.com/u/44242839?v=4","gravatar_id":"","url":"https://api.github.com/users/GiacomoPope","html_url":"https://github.com/GiacomoPope","followers_url":"https://api.github.com/users/GiacomoPope/followers","following_url":"https://api.github.com/users/GiacomoPope/following{/other_user}","gists_url":"https://api.github.com/users/GiacomoPope/gists{/gist_id}","starred_url":"https://api.github.com/users/GiacomoPope/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/GiacomoPope/subscriptions","organizations_url":"https://api.github.com/users/GiacomoPope/orgs","repos_url":"https://api.github.com/users/GiacomoPope/repos","events_url":"https://api.github.com/users/GiacomoPope/events{/privacy}","received_events_url":"https://api.github.com/users/GiacomoPope/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"So if I'm switching between several TileMapLayer within one scene (for example I have two primary tilesets for the world and then a third for hazards) I'd like all of them to be stateful. Remembering only just the last one wouldn't be enough here for me. \n\nCould we instead do something such as clear this whenever the scene is closed / reloaded etc so the TileMapLayer only caches terrains for active scenes being worked on?\n\nVery keen to learn best practices for memory management for this kind of thing but it seems like a fairly light allocation to be avoiding having a full memory for all TileMapLayers within the scene?","created_at":"2026-09-02T21:28:02Z","updated_at":"2026-09-02T21:28:02Z","html_url":"https://github.com/godotengine/godot/pull/123085#discussion_r3918843005","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/123085","_links":{"self":{"href":"https://api.github.com/repos/godotengine/godot/pulls/comments/3918843005"},"html":{"href":"https://github.com/godotengine/godot/pull/123085#discussion_r3918843005"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/123085"}},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/3918843005/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":341,"original_line":341,"side":"RIGHT","in_reply_to_id":3918778862,"author_association":"CONTRIBUTOR","original_position":5,"position":5,"subject_type":"line"},{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/3919145022","pull_request_review_id":5095653971,"id":3919145022,"node_id":"PRRC_kwDOAO6SJc7pmWg-","diff_hunk":"@@ -337,6 +337,10 @@ class TileMapLayerEditorTerrainsPlugin : public TileMapLayerSubEditorPlugin {\n \tTileSet::TerrainsPattern selected_terrains_pattern;\n \tvoid _update_selection();\n \n+\t// Terrain selection restoration\n+\tHashMap<ObjectID, Vector2i> last_selected_terrain_by_layer;","path":"modules/tilemap/editor/tile_map_layer_editor.h","commit_id":"5d8ca92d225e5a1713e3a5b6ad437cc18f17aae3","original_commit_id":"e06526a1467048a51c6b2ea77915206badc341b4","user":{"login":"KoBeWi","id":2223172,"node_id":"MDQ6VXNlcjIyMjMxNzI=","avatar_url":"https://avatars.githubusercontent.com/u/2223172?v=4","gravatar_id":"","url":"https://api.github.com/users/KoBeWi","html_url":"https://github.com/KoBeWi","followers_url":"https://api.github.com/users/KoBeWi/followers","following_url":"https://api.github.com/users/KoBeWi/following{/other_user}","gists_url":"https://api.github.com/users/KoBeWi/gists{/gist_id}","starred_url":"https://api.github.com/users/KoBeWi/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/KoBeWi/subscriptions","organizations_url":"https://api.github.com/users/KoBeWi/orgs","repos_url":"https://api.github.com/users/KoBeWi/repos","events_url":"https://api.github.com/users/KoBeWi/events{/privacy}","received_events_url":"https://api.github.com/users/KoBeWi/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"The non-terrain tile sources are remembered for a TileSet. And usually it's best to use a single TileSet with multiple sources through the project. But maybe it's different for terrains 🤔 I don't use them personally.\r\n\r\n> Very keen to learn best practices for memory management for this kind of thing but it seems like a fairly light allocation to be avoiding having a full memory for all TileMapLayers within the scene?\r\n\r\nIt's light, but since the entries are never removed, it's pretty much a memory leak.\r\n\r\n> Could we instead do something such as clear this whenever the scene is closed / reloaded etc so the TileMapLayer only caches terrains for active scenes being worked on?\r\n\r\nYeah not sure what would be the best time to clear the cache. Reloading a scene is not something you usually do. Closing a scene, what if the user closes another scene? Wouldn't it reset the cache in the scene you are working on? Clearing when switching scenes might be the best, but then if you work on multiple scenes, your sources will keep getting deselected.\r\n\r\nMaybe `_restore_terrain_selection()` could take care of removing invalid entries. Like, check if the key TileMapLayer still exists, and if not, remove it.","created_at":"2026-09-02T22:10:50Z","updated_at":"2026-09-02T22:10:50Z","html_url":"https://github.com/godotengine/godot/pull/123085#discussion_r3919145022","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/123085","_links":{"self":{"href":"https://api.github.com/repos/godotengine/godot/pulls/comments/3919145022"},"html":{"href":"https://github.com/godotengine/godot/pull/123085#discussion_r3919145022"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/123085"}},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/3919145022/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":341,"original_line":341,"side":"RIGHT","in_reply_to_id":3918778862,"author_association":"MEMBER","original_position":5,"position":5,"subject_type":"line"},{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/3919693845","pull_request_review_id":5096330485,"id":3919693845,"node_id":"PRRC_kwDOAO6SJc7pocgV","diff_hunk":"@@ -337,6 +337,10 @@ class TileMapLayerEditorTerrainsPlugin : public TileMapLayerSubEditorPlugin {\n \tTileSet::TerrainsPattern selected_terrains_pattern;\n \tvoid _update_selection();\n \n+\t// Terrain selection restoration\n+\tHashMap<ObjectID, Vector2i> last_selected_terrain_by_layer;","path":"modules/tilemap/editor/tile_map_layer_editor.h","commit_id":"5d8ca92d225e5a1713e3a5b6ad437cc18f17aae3","original_commit_id":"e06526a1467048a51c6b2ea77915206badc341b4","user":{"login":"GiacomoPope","id":44242839,"node_id":"MDQ6VXNlcjQ0MjQyODM5","avatar_url":"https://avatars.githubusercontent.com/u/44242839?v=4","gravatar_id":"","url":"https://api.github.com/users/GiacomoPope","html_url":"https://github.com/GiacomoPope","followers_url":"https://api.github.com/users/GiacomoPope/followers","following_url":"https://api.github.com/users/GiacomoPope/following{/other_user}","gists_url":"https://api.github.com/users/GiacomoPope/gists{/gist_id}","starred_url":"https://api.github.com/users/GiacomoPope/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/GiacomoPope/subscriptions","organizations_url":"https://api.github.com/users/GiacomoPope/orgs","repos_url":"https://api.github.com/users/GiacomoPope/repos","events_url":"https://api.github.com/users/GiacomoPope/events{/privacy}","received_events_url":"https://api.github.com/users/GiacomoPope/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"I took your advice a