atars.githubusercontent.com/u/20043270?v=4","gravatar_id":"","url":"https://api.github.com/users/EMBYRDEV","html_url":"https://github.com/EMBYRDEV","followers_url":"https://api.github.com/users/EMBYRDEV/followers","following_url":"https://api.github.com/users/EMBYRDEV/following{/other_user}","gists_url":"https://api.github.com/users/EMBYRDEV/gists{/gist_id}","starred_url":"https://api.github.com/users/EMBYRDEV/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/EMBYRDEV/subscriptions","organizations_url":"https://api.github.com/users/EMBYRDEV/orgs","repos_url":"https://api.github.com/users/EMBYRDEV/repos","events_url":"https://api.github.com/users/EMBYRDEV/events{/privacy}","received_events_url":"https://api.github.com/users/EMBYRDEV/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-06-04T19:12:59Z","updated_at":"2026-06-04T19:12:59Z","body":"Just looking to bump this one as this is a fairly bad issue and has lay dormant for a while!","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4625316183/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4663213007","html_url":"https://github.com/godotengine/godot/pull/109864#issuecomment-4663213007","issue_url":"https://api.github.com/repos/godotengine/godot/issues/109864","id":4663213007,"node_id":"IC_kwDOAO6SJc8AAAABFfL7zw","user":{"login":"apples","id":2352020,"node_id":"MDQ6VXNlcjIzNTIwMjA=","avatar_url":"https://avatars.githubusercontent.com/u/2352020?v=4","gravatar_id":"","url":"https://api.github.com/users/apples","html_url":"https://github.com/apples","followers_url":"https://api.github.com/users/apples/followers","following_url":"https://api.github.com/users/apples/following{/other_user}","gists_url":"https://api.github.com/users/apples/gists{/gist_id}","starred_url":"https://api.github.com/users/apples/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/apples/subscriptions","organizations_url":"https://api.github.com/users/apples/orgs","repos_url":"https://api.github.com/users/apples/repos","events_url":"https://api.github.com/users/apples/events{/privacy}","received_events_url":"https://api.github.com/users/apples/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-06-09T19:18:50Z","updated_at":"2026-06-09T19:19:13Z","body":"Can confirm that this fixes the issue when tested locally using the MRP.\r\n\r\nThe fix seems good:\r\n- The peer's `recv_sync_ids` will contain the object if and only if the object was spawned by a `MultiplayerSpawner` owned by that peer.\r\n- Similarly, the TrackedNode's `remote_peer` is only populated when spawned by a remote spawner.\r\n- Therefore, if a TrackedNode has a `remote_peer`, then that peer's `recv_sync_ids` must contain the object, and vice versa.\r\n\r\nIt's worth mentioning that this doesn't impact synchronizers which aren't related to a spawned object, as those synchronizers use path-based lookup instead of `recv_sync_ids`. (I'm not sure why all synchronizers don't just use path-based lookup, it seems like it would simplify things?) Also this fix works with synchronizers that change authority.\r\n\r\nAs an aside: Another possible fix is to check against `E.key == sync->get_multiplayer_authority()` instead of `uint32_t(E.key) == tobj.remote_peer`. Currently, these two conditions are equivalent, but I've got a local branch that allows spawners to transfer authority, in which case the TrackedNode's `remote_peer` won't match the peer that spawned it. But as the code is currently, either condition works and fixes the issue.","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4663213007/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4743504124","html_url":"https://github.com/godotengine/godot/pull/109864#issuecomment-4743504124","issue_url":"https://api.github.com/repos/godotengine/godot/issues/109864","id":4743504124,"node_id":"IC_kwDOAO6SJc8AAAABGrwg_A","user":{"login":"Repiteo","id":17489292,"node_id":"MDQ6VXNlcjE3NDg5Mjky","avatar_url":"https://avatars.githubusercontent.com/u/17489292?v=4","gravatar_id":"","url":"https://api.github.com/users/Repiteo","html_url":"https://github.com/Repiteo","followers_url":"https://api.github.com/users/Repiteo/followers","following_url":"https://api.github.com/users/Repiteo/following{/other_user}","gists_url":"https://api.github.com/users/Repiteo/gists{/gist_id}","starred_url":"https://api.github.com/users/Repiteo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Repiteo/subscriptions","organizations_url":"https://api.github.com/users/Repiteo/orgs","repos_url":"https://api.github.com/users/Repiteo/repos","events_url":"https://api.github.com/users/Repiteo/events{/privacy}","received_events_url":"https://api.github.com/users/Repiteo/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-06-18T15:25:26Z","updated_at":"2026-06-18T15:25:26Z","body":"Thanks! Congratulations on your first merged contribution! 🎉 ","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4743504124/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5071411546","html_url":"https://github.com/godotengine/godot/pull/109864#issuecomment-5071411546","issue_url":"https://api.github.com/r