5?v=4","gravatar_id":"","url":"https://api.github.com/users/Alex2782","html_url":"https://github.com/Alex2782","followers_url":"https://api.github.com/users/Alex2782/followers","following_url":"https://api.github.com/users/Alex2782/following{/other_user}","gists_url":"https://api.github.com/users/Alex2782/gists{/gist_id}","starred_url":"https://api.github.com/users/Alex2782/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Alex2782/subscriptions","organizations_url":"https://api.github.com/users/Alex2782/orgs","repos_url":"https://api.github.com/users/Alex2782/repos","events_url":"https://api.github.com/users/Alex2782/events{/privacy}","received_events_url":"https://api.github.com/users/Alex2782/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-01-08T11:17:53Z","updated_at":"2026-01-08T11:17:53Z","body":"> We don't use SDL on Android at the moment, so this PR shouldn't have any changes there :D\r\n\r\nYes, I saw your PR for Android SDL. But I'm interested in identifying the differences. `serial_number` is introduced, but it's not mentioned which operating systems support it?","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3723407981/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3724650812","html_url":"https://github.com/godotengine/godot/pull/113873#issuecomment-3724650812","issue_url":"https://api.github.com/repos/godotengine/godot/issues/113873","id":3724650812,"node_id":"IC_kwDOAO6SJc7eAak8","user":{"login":"RyanVail","id":111651152,"node_id":"U_kgDOBqepUA","avatar_url":"https://avatars.githubusercontent.com/u/111651152?v=4","gravatar_id":"","url":"https://api.github.com/users/RyanVail","html_url":"https://github.com/RyanVail","followers_url":"https://api.github.com/users/RyanVail/followers","following_url":"https://api.github.com/users/RyanVail/following{/other_user}","gists_url":"https://api.github.com/users/RyanVail/gists{/gist_id}","starred_url":"https://api.github.com/users/RyanVail/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/RyanVail/subscriptions","organizations_url":"https://api.github.com/users/RyanVail/orgs","repos_url":"https://api.github.com/users/RyanVail/repos","events_url":"https://api.github.com/users/RyanVail/events{/privacy}","received_events_url":"https://api.github.com/users/RyanVail/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-01-08T16:25:05Z","updated_at":"2026-01-08T16:25:05Z","body":"> Yes, I saw your PR for Android SDL. But I'm interested in identifying the differences. `serial_number` is introduced, but it's not mentioned which operating systems support it?\r\n\r\nGetting the serial number of controller will only be possible on platforms where Godot uses SDL with this change. I assume it would be possible to get the serial number of controllers on Android but `get_joy_info` currently only supports SDL enabled platforms [anyway](https://docs.godotengine.org/en/latest/classes/class_input.html#class-input-method-get-joy-info).","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3724650812/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3750543314","html_url":"https://github.com/godotengine/godot/pull/113873#issuecomment-3750543314","issue_url":"https://api.github.com/repos/godotengine/godot/issues/113873","id":3750543314,"node_id":"IC_kwDOAO6SJc7fjL_S","user":{"login":"Alex2782","id":41921395,"node_id":"MDQ6VXNlcjQxOTIxMzk1","avatar_url":"https://avatars.githubusercontent.com/u/41921395?v=4","gravatar_id":"","url":"https://api.github.com/users/Alex2782","html_url":"https://github.com/Alex2782","followers_url":"https://api.github.com/users/Alex2782/followers","following_url":"https://api.github.com/users/Alex2782/following{/other_user}","gists_url":"https://api.github.com/users/Alex2782/gists{/gist_id}","starred_url":"https://api.github.com/users/Alex2782/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Alex2782/subscriptions","organizations_url":"https://api.github.com/users/Alex2782/orgs","repos_url":"https://api.github.com/users/Alex2782/repos","events_url":"https://api.github.com/users/Alex2782/events{/privacy}","received_events_url":"https://api.github.com/users/Alex2782/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-01-14T16:55:21Z","updated_at":"2026-01-14T16:55:21Z","body":"Same with `Xbox Wireless Controller`, I could no longer connect it via Bluetooth, so I briefly tested it via USB cable.\r\n\r\n```\r\n+ Found newly connected joypad #0: Xbox One - 050038555e040000130b0000b4756d04\r\n{ \"raw_name\": \"Xbox One\", \"vendor_id\": \"1118\", \"product_id\": \"2835\", \"serial_number\": \"\", \"xinput_index\": \"0\" }\r\n```\r\n\r\n<img width=\"385\" height=\"274\" alt=\"Bildschirmfoto 2026-01-14 um 17 52 21\" src=\"https://github.com/user-attachments/assets/ad263d5e-594c-4613-8b20-b926ae73840f\" />\r\n\r\n","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3750543314/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3756140841","html_url":"https://github.com/godotengine/godot/pull/113873#issuecomment-3756140841","issue_url":"https://api.github.com/repos/godotengine/godot/issues/113873","id":3756140841,"node_id":"IC_kwDOAO6SJc7f4ikp","user":{"login":"RyanVail","id":111651152,"node_id":"U_kgDOBqepUA","avatar_url":"https://avatars.githubusercontent.com/u/111651152?v=4","gravatar_id":"","url":"https://api.github.com/users/RyanVail","html_url":"https://github.com/RyanVail","followers_url":"https://api.github.com/users/RyanVail/followers","following_url":"https://api.github.com/users/RyanVail/following{/other_user}","gists_url":"https://api.github.com/users/RyanVail/gists{/gist_id}","starred_url":"https://api.github.com/users/RyanVail/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/RyanVail/subscriptions","organizations_url":"https://api.github.com/users/RyanVail/orgs","repos_url":"https://api.github.com/users/RyanVail/repos","events_url":"https://api.github.com/users/RyanVail/events{/privacy}","received_events_url":"https://api.github.com/users/RyanVail/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-01-15T17:51:42Z","updated_at":"2026-01-15T17:51:42Z","body":"> @RyanVail How have you tested this PR so far, OS and gamepads?\r\n\r\nI've tested this on Linux with an _8BitDo Ultimate 2C Wireless Controller_ as that's the only controller I have access to right now.\r\n\r\nWhen I made this change I had just tested over wired USB but it seems that over Bluetooth the serial number of the 8BitDo controller is an empty string too.  Though I cannot vibrate my controller over Bluetooth either so it might just be outdated firmware.\r\n\r\nOver the wireless USB receiver the 8BitDo controller does vibrate and reports a serial number but oddly it's different than the one reported when wired. The serial number being reported might be the receiver's, I'm not sure.\r\n\r\nWhile connected through wired USB with the switch on the back set to Bluetooth the reported serial number is \"0000000000\" even though that switch shouldn't change anything when the controller is wired.\r\n\r\nI imagine there are going to be many more oddities with serial numbers for each type of controller but I think exposing the feature to GDscript for those who want to use it is a good idea. Also the `serial_number` field is no longer included in `joy_info` when it's an empty string.","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3756140841/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3756499055","html_url":"https://github.com/godotengine/godot/pull/113873#issuecomment-3756499055","issue_url":"https://api.github.com/repos/godotengine/godot/issues/113873","id":3756499055,"node_id":"IC_kwDOAO6SJc7f56Bv","user":{"login":"Alex2782","id":41921395,"node_id":"MDQ6VXNlcjQxOTIxMzk1","avatar_url":"https://avatars.githubusercontent.com/u/41921395?v=4","gravatar_id":"","url":"https://api.github.com/users/Alex2782","html_url":"https://github.com/Alex2782","followers_url":"https://api.github.com/users/Alex2782/followers","following_url":"https://api.github.com/users/Alex2782/following{/other_user}","gists_url":"https://api.github.com/users/Alex2782/gists{/gist_id}","starred_url":"https://api.github.com/users/Alex2782/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Alex2782/subscriptions","organizations_url":"https://api.github.com/users/Alex2782/orgs","repos_url":"https://api.github.com/users/Alex2782/repos","events_url":"https://api.github.com/users/Alex2782/events{/privacy}","received_events_url":"https://api.github.com/users/Alex2782/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-01-15T19:24:40Z","updated_at":"2026-01-15T19:27:10Z","body":"> Also the `serial_number` field is no longer included in `joy_info` when it's an empty string.\r\n\r\nI think that should also be in the documentation. \r\nSomething like: `This key won't be present ...` similar to other keys that are not always inserted.\r\n\r\n\r\n```\r\n[code]steam_input_index[/code]: The Steam Input gamepad index, \r\nif the device is not a Steam Input device this key won't be present.\r\n\r\nOn Windows, the dictionary can have an additional field:\r\n[code]xinput_index[/code]: The index of the controller in the XInput system. \r\nThis key won't be present for devices not handled by XInput.\r\n```","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3756499055/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3776205244","html_url":"https://github.com/godotengine/godot/pull/113873#issuecomment-3776205244","issue_url":"https://api.github.com/repos/godotengine/godot/issues/113873","id":3776205244,"node_id":"IC_kwDOAO6SJc7hFFG8","user":{"login":"Nintorch","id":92302738,"node_id":"U_kgDOBYBtkg","avatar_url":"https://avatars.githubusercontent.com/u/92302738?v=4","gravatar_id":"","url":"https://api.github.com/users/Nintorch","html_url":"https://github.com/Nintorch","followers_url":"https://api.github.com/users/Nintorch/followers","following_url":"https://api.github.com/users/Nintorch/following{/other_user}","gists_url":"https://api.github.com/users/Nintorch/gists{/gist_id}","starred_url":"https://api.github.com/users/Nintorch/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Nintorch/subscriptions","organizations_url":"https://api.github.com/users/Nintorch/orgs","repos_url":"https://api.github.com/users/Nintorch/repos","events_url":"https://api.github.com/users/Nintorch/events{/privacy}","received_events_url":"https://api.github.com/users/Nintorch/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-01-21T05:19:19Z","updated_at":"2026-01-21T05:19:19Z","body":"I will need to check if the serial number is only implemented on Linux or other platforms too.","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3776205244/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3776352364","html_url":"https://github.com/godotengine/godot/pull/113873#issuecomment-3776352364","issue_url":"https://api.github.com/repos/godotengine/godot/issues/113873","id":3776352364,"node_id":"IC_kwDOAO6SJc7hFpBs","user":{"login":"Nintorch","id":92302738,"node_id":"U_kgDOBYBtkg","avatar_url":"https://avatars.githubusercontent.com/u/92302738?v=4","gravatar_id":"","url":"https://api.github.com/users/Nintorch","html_url":"https://github.com/Nintorch","followers_url":"https://api.github.com/users/Nintorch/followers","following_url":"https://api.github.com/users/Nintorch/following{/other_user}","gists_url":"https://api.github.com/users/Nintorch/gists{/gist_id}","starred_url":"https://api.github.com/users/Nintorch/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Nintorch/subscriptions","organizations_url":"https://api.github.com/users/Nintorch/orgs","repos_url":"https://api.github.com/users/Nintorch/repos","events_url":"https://api.github.com/users/Nintorch/events{/privacy}","received_events_url":"https://api.github.com/users/Nintorch/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-01-21T06:03:36Z","updated_at":"2026-01-21T06:03:36Z","body":"As it turns out, it's implemented in HIDAPI on other platforms too\r\n\r\n> I've tried three different gamepads under Windows using USB cable. The `serial number` is unavailable.\r\n> \r\n> Perhaps this can be improved at some point through another pull request that can reliably identify the gamepads.\r\n> \r\n> ```\r\n> Godot Engine v4.6.rc.gh-113873.5ee8ccaad (2026-01-16 19:11:19 UTC) - https://godotengine.org\r\n> OpenGL API 3.3.0 Core Profile Context 25.12.1.251128 - Compatibility - Using Device: ATI Technologies Inc. - AMD Radeon 780M Graphics\r\n> \r\n> Found joypad #0: XInput Controller - 0300fa675e0400008e02000014017801\r\n> { \"raw_name\": \"Xbox 360 Controller\", \"vendor_id\": \"1118\", \"product_id\": \"654\", \"xinput_index\": \"0\" }\r\n> + Found newly connected joypad #0: XInput Controller - 0300fa675e0400008e02000014017801\r\n> \r\n> - Disconnected joypad #0.\r\n> + Found newly connected joypad #0: NVIDIA SHIELD Controller - 030028b6550900001472000025056800\r\n> { \"raw_name\": \"NVIDIA SHIELD Controller\", \"vendor_id\": \"2389\", \"product_id\": \"29204\", \"xinput_index\": \"0\" }\r\n> \r\n> - Disconnected joypad #0.\r\n> + Found newly connected joypad #0: XInput Controller - 0300fa675e040000ff02000000007801\r\n> { \"raw_name\": \"Xbox One Controller\", \"vendor_id\": \"1118\", \"product_id\": \"767\", \"xinput_index\": \"0\" }\r\n> ```\r\n\r\nMay I ask if the serial number is present on Xbox One controller on Windows (or if connected wirelessly, on macOS too) if [SDL_JOYSTICK_HIDAPI_XBOX](https://wiki.libsdl.org/SDL3/SDL_HINT_JOYSTICK_HIDAPI_XBOX) environment variable is set to 1?","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3776352364/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3791742931","html_url":"https://github.com/godotengine/godot/pull/113873#issuecomment-3791742931","issue_url":"https://api.github.com/repos/godotengine/godot/issues/113873","id":3791742931,"node_id":"IC_kwDOAO6SJc7iAWfT","user":{"login":"RyanVail","id":111651152,"node_id":"U_kgDOBqepUA","avatar_url":"https://avatars.githubusercontent.com/u/111651152?v=4","gravatar_id":"","url":"https://api.github.com/users/RyanVail","html_url":"https://github.com/RyanVail","followers_url":"https://api.github.com/users/RyanVail/followers","following_url":"https://api.github.com/users/RyanVail/following{/other_user}","gists_url":"https://api.github.com/users/RyanVail/gists{/gist_id}","starred_url":"https://api.github.com/users/RyanVail/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/RyanVail/subscriptions","organizations_url":"https://api.github.com/users/RyanVail/orgs","repos_url":"https://api.github.com/users/RyanVail/repos","events_url":"https://api.github.com/users/RyanVail/events{/privacy}","received_events_url":"https://api.github.com/users/RyanVail/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-01-23T18:41:42Z","updated_at":"2026-01-23T18:41:42Z","body":"> Personally, I'm not entirely sure how useful it is to get a serial number of a controller in a game though😅Please let me know if you feel it's useful!\r\n\r\nMy intended use case is for my game to recognize different local players by their controllers, because people often choose their favorite controllers, and automatically select their last used set of cosmetics to reduce the friction from starting the game to actually playing the game.","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3791742931/reactions","total_count":1,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":1},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3823048430","html_url":"https://github.com/godotengine/godot/pull/113873#issuecomment-3823048430","issue_url":"https://api.github.com/repos/godotengine/godot/issues/113873","id":3823048430,"node_id":"IC_kwDOAO6SJc7j3xbu","user":{"login":"akien-mga","id":4701338,"node_id":"MDQ6VXNlcjQ3MDEzMzg=","avatar_url":"https://avatars.githubusercontent.com/u/4701338?v=4","gravatar_id":"","url":"https://api.github.com/users/akien-mga","html_url":"https://github.com/akien-mga","followers_url":"https://api.github.com/users/akien-mga/followers","following_url":"https://api.github.com/users/akien-mga/following{/other_user}","gists_url":"https://api.github.com/users/akien-mga/gists{/gist_id}","starred_url":"https://api.github.com/users/akien-mga/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/akien-mga/subscriptions","organizations_url":"https://api.github.com/users/akien-mga/orgs","repos_url":"https://api.github.com/users/akien-mga/repos","events_url":"https://api.github.com/users/akien-mga/events{/privacy}","received_events_url":"https://api.github.com/users/akien-mga/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-01-30T10:41:01Z","updated_at":"2026-01-31T19:28:15Z","body":"> Be sure to add the patch to the thirdparty README:\r\n> \r\n> ```diff\r\n>  - `0006-fix-cs-environ.patch` ([GH-109283](https://github.com/godotengine/godot/pull/109283))\r\n> +- `0008-fix-linux-joycon-serial-num.patch` ([GH-113873](https://github.com/godotengine/godot/pull/113873))\r\n>  \r\n> ```\r\n\r\nShould also be `0007` if it's following `0006`.\r\n\r\nFinally, the commits should be squashed prior to merging. Let us know if that's bothersome, this could also be done by a repo maintainer.","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3823048430/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3841611891","html_url":"https://github.com/godotengine/godot/pull/113873#issuecomment-3841611891","issue_url":"https://api.github.com/repos/godotengine/godot/issues/113873","id":3841611891,"node_id":"IC_kwDOAO6SJc7k-lhz","user":{"login":"Repiteo","id":17489292,"node_id":"MDQ6VXNlcjE3NDg5Mjky","avatar_url":"https://avatars.githubusercontent.com/u/17489292?v=4","gravatar_id":"","url":"https://api.github.com/users/Repiteo","html_url":"https://github.com/Repiteo","followers_url":"https://api.github.com/users/Repiteo/followers","following_url":"https://api.github.com/users/Repiteo/following{/other_user}","gists_url":"https://api.github.com/users/Repiteo/gists{/gist_id}","starred_url":"https://api.github.com/users/Repiteo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Repiteo/subscriptions","organizations_url":"https://api.github.com/users/Repiteo/orgs","repos_url":"https://api.github.com/users/Repiteo/repos","events_url":"https://api.github.com/users/Repiteo/events{/privacy}","received_events_url":"https://api.github.com/users/Repiteo/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-02-03T14:18:48Z","updated_at":"2026-02-03T14:18:48Z","body":"Thanks! Congratulations on your first merged contribution! 🎉 ","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3841611891/reactions","total_count":3,"+1":0,"-1":0,"laugh":0,"hooray":3,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null}]