hub.com/user-attachments/files/27088512/bug-report.zip)","closed_by":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/118956/reactions","total_count":1,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":1},"timeline_url":"https://api.github.com/repos/godotengine/godot/issues/118956/timeline","performed_via_github_app":null,"state_reason":null,"pinned_comment":null}