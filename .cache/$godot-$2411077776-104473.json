.com/repos/godotengine/godot/pulls/104473","author_association":"MEMBER","submitted_at":"2025-03-25T03:59:39Z"},{"id":2712286624,"node_id":"PRR_kwDOAO6SJc6hqjWg","state":"COMMENTED","user":{"site_admin":false,"suspended":false,"updated_at":"0001-01-01T00:00:00Z","avatar_url":"https://avatars.githubusercontent.com/u/172810?u=54858f6dbc3e4adb7494836e8891a05c69e8e55d&v=4","created_at":"0001-01-01T00:00:00Z","followers":0,"following":0,"html_url":"https://github.com/theXYZT","id":172810,"node_id":"MDQ6VXNlcjE3MjgxMA==","login":"theXYZT","type":"User","owned_private_repos":0,"public_gists":0,"public_repos":0,"total_private_repos":0,"url":"https://api.github.com/users/theXYZT"},"body":"","html_url":"https://github.com/godotengine/godot/pull/104473#pullrequestreview-2712286624","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/104473","author_association":"NONE","submitted_at":"2025-03-25T04:04:48Z"},{"id":2716437927,"node_id":"PRR_kwDOAO6SJc6h6Y2n","state":"COMMENTED","user":{"site_admin":false,"suspended":false,"updated_at":"0001-01-01T00:00:00Z","avatar_url":"https://avatars.githubusercontent.com/u/9283098?u=a04daf8c4d579b733ac46d2e4d17324cca7870c0&v=4","created_at":"0001-01-01T00:00:00Z","followers":0,"following":0,"html_url":"https://github.com/kleonc","id":9283098,"node_id":"MDQ6VXNlcjkyODMwOTg=","login":"kleonc","type":"User","owned_private_repos":0,"public_gists":0,"public_repos":0,"total_private_repos":0,"url":"https://api.github.com/users/kleonc"},"body":"Overall looks good to me! :+1:\r\n\r\nTo (re)consider:\r\n- Given the most probable use case is obtaining the first/last key/value, it would be nice if `-1` would be allowed for referring to the last index. But note that e.g. `Array.get(index)` doesn't support negative indexing (while `Array.operator[](index)` does). If we want negative indexing to be allowed, should be supported right away (to avoid breaking compatibility in the future).\r\n- The naming, `key(index)`/`value(index)` was suggested in https://github.com/godotengine/godot/pull/104473#issuecomment-2745185716. Both fine for me but I prefer the current `get_key_at_index`/`get_value_at_index`:\r\n\t- Super clear, seem less likely to be misused.\r\n\t- No direct autocomplete conflict with existing `keys()`/`values()` (but still hinted).\r\n\t- Key/value/index are 3 different things, so `key(something1)`/`value(something2)` might be unclear (is `something1` index/value, is `something2` key/index?). I'd leave short/simple names for (key/value)-only methods.","html_url":"https://github.com/godotengine/godot/pull/104473#pullrequestreview-2716437927","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/104473","author_association":"MEMBER","submitted_at":"2025-03-26T10:04:08Z"},{"id":2717363698,"node_id":"PRR_kwDOAO6SJc6h963y","state":"COMMENTED","user":{"site_admin":false,"suspended":false,"updated_at":"0001-01-01T00:00:00Z","avatar_url":"https://avatars.githubusercontent.com/u/172810?u=54858f6dbc3e4adb7494836e8891a05c69e8e55d&v=4","created_at":"0001-01-01T00:00:00Z","followers":0,"following":0,"html_url":"https://github.com/theXYZT","id":172810,"node_id":"MDQ6VXNlcjE3MjgxMA==","login":"theXYZT","type":"User","owned_private_repos":0,"public_gists":0,"public_repos":0,"total_private_repos":0,"url":"https://api.github.com/users/theXYZT"},"body":"","html_url":"https://github.com/godotengine/godot/pull/104473#pullrequestreview-2717363698","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/104473","author_association":"NONE","submitted_at":"2025-03-26T14:10:23Z"},{"id":2717831693,"node_id":"PRR_kwDOAO6SJc6h_tIN","state":"COMMENTED","user":{"site_admin":false,"suspended":false,"updated_at":"0001-01-01T00:00:00Z","avatar_url":"https://avatars.githubusercontent.com/u/172810?u=54858f6dbc3e4adb7494836e8891a05c69e8e55d&v=4","created_at":"0001-01-01T00:00:00Z","followers":0,"following":0,"html_url":"https://github.com/theXYZT","id":172810,"node_id":"MDQ6VXNlcjE3MjgxM