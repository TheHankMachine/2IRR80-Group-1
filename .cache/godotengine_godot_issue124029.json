         scene/main/window.cpp:2088\n#08  call_with_variant_args_helper<Window, ...>           core/variant/binder_common.h:58\n#09  Callable::call<Ref<InputEvent>>(...)                 core/variant/variant.h:943\n#10  DisplayServerAndroid::_window_callback<...>(...)     platform/android/display_server_android.cpp:492\n#11  Input::_parse_input_event_impl(...)                  core/input/input.cpp:1129\n#12  Input::flush_buffered_events()                       core/input/input.cpp:1685\n#13  OS_Android::main_loop_iterate(bool*)                 platform/android/os_android.cpp:390\n#14  Java_org_godotengine_godot_GodotLib_step             platform/android/java_godot_lib_jni.cpp:407\n```\nI get line 0 for `#02  TabBar::gui_input(Ref<InputEvent> const&)`, but I cannot figure out why \n\n### Steps to reproduce\n\n1. Open the Editor\n2. Hold the \"Scene\" dock tab\n3. Move your finger slightly\n4. Release shortly after\n\nThis should be done quickly to reproduce the crash.\n\n### Minimal reproduction project (MRP)\n\nN/A","closed_by":{"login":"Repiteo","id":17489292,"node_id":"MDQ6VXNlcjE3NDg5Mjky","avatar_url":"https://avatars.githubusercontent.com/u/17489292?v=4","gravatar_id":"","url":"https://api.github.com/users/Repiteo","html_url":"https://github.com/Repiteo","followers_url":"https://api.github.com/users/Repiteo/followers","following_url":"https://api.github.com/users/Repiteo/following{/other_user}","gists_url":"https://api.github.com/users/Repiteo/gists{/gist_id}","starred_url":"https://api.github.com/users/Repiteo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Repiteo/subscriptions","organizations_url":"https://api.github.com/users/Repiteo/orgs","repos_url":"https://api.github.com/users/Repiteo/repos","events_url":"https://api.github.com/users/Repiteo/events{/privacy}","received_events_url":"https://api.github.com/users/Repiteo/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.git