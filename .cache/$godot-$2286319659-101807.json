odotengine.org/en/stable/tutorials/rendering/multiple_resolutions.html#desktop-game) (but are not using a 4K display yourself).\r\n\r\n![image](https://github.com/user-attachments/assets/fa121257-7dfd-4faa-a57f-cc661848e985)\r\n","html_url":"https://github.com/godotengine/godot/pull/101807#pullrequestreview-2565936045","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/101807","author_association":"MEMBER","submitted_at":"2025-01-22T00:16:46Z"},{"id":2565970889,"node_id":"PRR_kwDOAO6SJc6Y8ZvJ","state":"COMMENTED","user":{"site_admin":false,"suspended":false,"updated_at":"0001-01-01T00:00:00Z","avatar_url":"https://avatars.githubusercontent.com/u/81109165?u=fce765c3b4c5f5a9c65a4bb0ca663b27ccf96d96&v=4","created_at":"0001-01-01T00:00:00Z","followers":0,"following":0,"html_url":"https://github.com/Hilderin","id":81109165,"node_id":"MDQ6VXNlcjgxMTA5MTY1","login":"Hilderin","type":"User","owned_private_repos":0,"public_gists":0,"public_repos":0,"total_private_repos":0,"url":"https://api.github.com/users/Hilderin"},"body":"","html_url":"https://github.com/godotengine/godot/pull/101807#pullrequestreview-2565970889","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/101807","author_association":"CONTRIBUTOR","submitted_at":"2025-01-22T00:55:01Z"},{"id":2565995081,"node_id":"PRR_kwDOAO6SJc6Y8fpJ","state":"COMMENTED","user":{"site_admin":false,"suspended":false,"updated_at":"0001-01-01T00:00:00Z","avatar_url":"https://avatars.githubusercontent.com/u/81109165?u=fce765c3b4c5f5a9c65a4bb0ca663b27ccf96d96&v=4","created_at":"0001-01-01T00:00:00Z","followers":0,"following":0,"html_url":"https://github.com/Hilderin","id":81109165,"node_id":"MDQ6VXNlcjgxMTA5MTY1","login":"Hilderin","type":"User","owned_private_repos":0,"public_gists":0,"public_repos":0,"total_private_repos":0,"url":"https://api.github.com/users/Hilderin"},"body":"","html_url":"https://github.com/godotengine/godot/pull/101807#pullrequestreview-2565995081","pull_request_url":"