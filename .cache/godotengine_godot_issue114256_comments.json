[{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3684903243","html_url":"https://github.com/godotengine/godot/issues/114256#issuecomment-3684903243","issue_url":"https://api.github.com/repos/godotengine/godot/issues/114256","id":3684903243,"node_id":"IC_kwDOAO6SJc7boylL","user":{"login":"NiamhNikali","id":213225508,"node_id":"U_kgDODLWQJA","avatar_url":"https://avatars.githubusercontent.com/u/213225508?v=4","gravatar_id":"","url":"https://api.github.com/users/NiamhNikali","html_url":"https://github.com/NiamhNikali","followers_url":"https://api.github.com/users/NiamhNikali/followers","following_url":"https://api.github.com/users/NiamhNikali/following{/other_user}","gists_url":"https://api.github.com/users/NiamhNikali/gists{/gist_id}","starred_url":"https://api.github.com/users/NiamhNikali/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/NiamhNikali/subscriptions","organizations_url":"https://api.github.com/users/NiamhNikali/orgs","repos_url":"https://api.github.com/users/NiamhNikali/repos","events_url":"https://api.github.com/users/NiamhNikali/events{/privacy}","received_events_url":"https://api.github.com/users/NiamhNikali/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-12-23T03:06:43Z","updated_at":"2025-12-23T03:06:43Z","body":"I've bisected the bug and found that 97b1bc6bda is the first bad revision.","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3684903243/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3684918560","html_url":"https://github.com/godotengine/godot/issues/114256#issuecomment-3684918560","issue_url":"https://api.github.com/repos/godotengine/godot/issues/114256","id":3684918560,"node_id":"IC_kwDOAO6SJc7bo