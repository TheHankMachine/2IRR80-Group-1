following{/other_user}","gists_url":"https://api.github.com/users/Repiteo/gists{/gist_id}","starred_url":"https://api.github.com/users/Repiteo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Repiteo/subscriptions","organizations_url":"https://api.github.com/users/Repiteo/orgs","repos_url":"https://api.github.com/users/Repiteo/repos","events_url":"https://api.github.com/users/Repiteo/events{/privacy}","received_events_url":"https://api.github.com/users/Repiteo/received_events","type":"User","user_view_type":"public","site_admin":false},"open_issues":3,"closed_issues":2978,"state":"closed","created_at":"2025-05-22T16:25:52Z","updated_at":"2026-10-04T16:23:23Z","due_on":null,"closed_at":"2026-01-26T18:09:14Z"},"comments":0,"created_at":"2025-12-27T23:20:38Z","updated_at":"2026-01-05T18:13:13Z","closed_at":"2026-01-05T18:13:12Z","assignee":{"login":"bruvzg","id":7645683,"node_id":"MDQ6VXNlcjc2NDU2ODM=","avatar_url":"https://avatars.githubusercontent.com/u/7645683?v=4","gravatar_id":"","url":"https://api.github.com/users/bruvzg","html_url":"https://github.com/bruvzg","followers_url":"https://api.github.com/users/bruvzg/followers","following_url":"https://api.github.com/users/bruvzg/following{/other_user}","gists_url":"https://api.github.com/users/bruvzg/gists{/gist_id}","starred_url":"https://api.github.com/users/bruvzg/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/bruvzg/subscriptions","organizations_url":"https://api.github.com/users/bruvzg/orgs","repos_url":"https://api.github.com/users/bruvzg/repos","events_url":"https://api.github.com/users/bruvzg/events{/privacy}","received_events_url":"https://api.github.com/users/bruvzg/received_events","type":"User","user_view_type":"public","site_admin":false},"author_association":"NONE","issue_field_values":[],"type":null,"active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"### Tested versions\n\n- 4.5.1.stable, 4.6.beta2\n- [According to git blame](https://github.com/godotengine/godot/blame/63227bbc8ae5300319f14f8253c8158b846f355b/scene/resources/font.cpp#L1517), issue has likely existed since at least 4.0.stable\n\n### System information\n\nGodot v4.6.beta2 - openSUSE Tumbleweed 20251217 on Wayland - X11 display driver, Multi-window, 1 monitor - OpenGL 3 (Compatibility) - AMD Radeon Graphics (radeonsi, renoir, ACO, DRM 3.64, 6.18.1-1-default) - AMD Ryzen 7 5700U with Radeon Graphics (16 threads) - 14.97 GiB memory\n\n### Issue description\n\nWhen importing a binary BMFont file that uses the Unicode character set and includes characters beyond U+00FF, the following warning is spammed into the console:\n\n> **WARNING:** scene/resources/font.cpp:1728 - Invalid BMFont OEM character 164 (should be 0x00-0xFF).\n\nThe font is interpreted as using an OEM character set (specifically Latin-1), so any characters with code points greater than U+00FF are ignored and do not display properly.\n\nIn [the BMFont binary font file specification](https://www.angelcode.com/products/bmfont/doc/file_format.html#bin), bit 0 refers to the most significant bit `0x80` and bit 7 refers to the least significant bit `0x01`. Because of this, when BMFont generates a binary BMFont file in the Unicode character set, it sets the second most significant bit `0x40` in the bitField field in block 1. However, [Godot checks the second *least* significant bit `0x02` instead](https://github.com/godotengine/godot/blob/63227bbc8ae5300319f14f8253c8158b846f355b/scene/resources/font.cpp#L1517), which is always false because that bit is marked as reserved. This makes it so no binary BMFont file will be read as using the Unicode character set.\n\nThe italic and bold bits are also read incorrectly following this logic, checking `0x04` and `0x08` respectively instead of `0x20` and `0x10`. The texture packing bit in block 2 is read correctly as `0x01`, though.\n\n### Steps to reproduce\n\nWith the minimal reproduction project:\n\n- See Latin Extended-A characters rendered as tofu blocks\n- Reimport the provided font to trigger the OEM character warnings\n\nThe font used by the label can also be replaced with any font generated using BMFont with the following traits:\n\n- Character set is Unicode\n- Font descriptor is set to binary\n- Latin, Latin-1 Supplement, and Latin Extended-A character sets are included\n\n### Minimal reproduction project (MRP)\n\n[binary_bmfont.zip](https://github.com/user-attachments/files/24357176/binary_bmfont.zip)","closed_by":{"login":"Repiteo","id":17489292,"node_id":"MDQ6VXNlcjE3NDg5Mjky","avatar_url":"https://avatars.githubusercontent.com/u/17489292?v=4","gravatar_id":"","url":"https://api.github.com/users/Repiteo","html_url":"https://github.com/Repiteo","followers_url":"https://api.github.com/users/Repiteo/followers","following_url":"https://api.github.com/users/Repiteo/following{/other_user}","gists_url":"https://api.github.com/users/Repiteo/gists{/gist_id}","starred_url":"https://api.github.com/users/Repiteo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Repiteo/subscriptions","organizations_url":"https://api.github.com/users/Repiteo/orgs","repos_url":"https://api.github.com/users/Repiteo/repos","events_url":"https://api.github.com/users/Repiteo/events{/privacy}","received_events_url":"https://api.github.com/users/Repiteo/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/114383/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/godotengine/godot/issues/114383/timeline","performed_via_github_app":null,"state_reason":"completed","pinned_comment":null}