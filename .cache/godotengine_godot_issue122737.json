chived_by":null}],"state":"open","locked":false,"assignees":[],"milestone":null,"comments":0,"created_at":"2026-08-23T12:59:30Z","updated_at":"2026-08-24T09:29:29Z","closed_at":null,"assignee":null,"author_association":"CONTRIBUTOR","issue_field_values":[],"type":null,"active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"### Tested versions\n\nReproducible in 4.8.dev3\n\n### System information\n\nWindows11\n\n### Issue description\n\n`GDScriptDocGen` writes named enum constants into the same list of constants as all other class constants. The EditorHelpBit code does not filter this list correctly. This allows named enums to shadow other constants with the same name.\n\n\n\n### Steps to reproduce\n\nPaste MRP gdscript and check tooltip of A\n\n### Minimal reproduction project (MRP)\n\n```\n# main.gd\nextends Node\n\nenum Named {\n\tA = 10,\n}\n\nconst A = 5;\n\nfunc _ready() -> void:\n\tprint(A) # has tooltip (Constant \"main.gd\".A : Named = 10)\n```","closed_by":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/122737/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/godotengine/godot/issues/122737/timeline","performed_via_github_app":null,"state_reason":null,"pinned_comment":null}