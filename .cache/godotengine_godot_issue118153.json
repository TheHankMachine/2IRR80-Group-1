4e4","default":false,"description":"","archived_at":null,"archived_by":null},{"id":279098111,"node_id":"MDU6TGFiZWwyNzkwOTgxMTE=","url":"https://api.github.com/repos/godotengine/godot/labels/topic:rendering","name":"topic:rendering","color":"ffee88","default":false,"description":"","archived_at":null,"archived_by":null},{"id":279098255,"node_id":"MDU6TGFiZWwyNzkwOTgyNTU=","url":"https://api.github.com/repos/godotengine/godot/labels/topic:platforms","name":"topic:platforms","color":"ffee88","default":false,"description":"","archived_at":null,"archived_by":null}],"state":"closed","locked":false,"assignees":[],"milestone":null,"comments":2,"created_at":"2026-04-03T12:13:21Z","updated_at":"2026-04-07T15:51:36Z","closed_at":"2026-04-07T15:45:16Z","assignee":null,"author_association":"NONE","issue_field_values":[],"type":null,"active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"### Tested versions\n\nv4.6.2.stable.official [71f334935]\n\n### System information\n\nWindows 10 - Godot 4.6.2 Stable - Mobile\n\n### Issue description\n\nThere is a bug with some display/window/stretch settings since changing engine version from 4.5.1 to 4.5.2-4.6.2 Stable versions. Display/window/stretch → Mode: canvas_items and Aspect: expand don’t work as expected on android devices. Tested on different android devices. This bug appeared since Godot version 4.5.2 RC1. \n\nAny graphics (Sprite2D, etc.) on android devices just placed left in portrait view (except UI Graphics, Control node).\n\n![Image](https://github.com/user-attachments/assets/b99849db-cf9a-4231-af6d-7bad908ed588)\n![Image](https://github.com/user-attachments/assets/f0448f09-a847-430e-a1e3-3dbf24d41550)\n<img width=\"1920\" height=\"1080\" alt=\"Image\" src=\"https://github.com/user-attachments/assets/fc97c9ff-9aa9-4f37-a6ec-faaaf8a781f7\" />\n![Image](https://github.com/user-attachments/assets/174873ad-0b0e-47dd-8c0a-7d623ff40164)\n![Image](https://github.com/user-attachments/assets/722a54b9-f1ae-4eef-ae29-307765f4cc6c)\n\n### Steps to reproduce\n\n1. Create a new project\n2. Create a new scene\n3. Set in project settings/display/window: viewport width -> 1920, height -> 1080, stretch/mode -> canvas_items, stretch/aspect -> expand\n4. Put any sprite or graphics, except UI graphics, and fit it directly in viewport as in screenshots\n5. Build project to any android device\n6. Get this bug\n\n### Minimal reproduction project (MRP)\n\n[bug-test.zip](https://github.com/user-attachments/files/26459856/bug-test.zip)","closed_by":{"login":"syntaxerror247","id":176927541,"node_id":"U_kgDOCouzNQ","avatar_url":"https://avatars.githubusercontent.com/u/176927541?v=4","gravatar_id":"","url":"https://api.github.com/users/syntaxerror247","html_url":"https://github.com/syntaxerror247","followers_url":"https://api.github.com/users/syntaxerror247/followers","following_url":"https://api.github.com/users/syntaxerror247/following{/other_user}","gists_url":"https://api.github.com/users/syntaxerror247/gists{/gist_id}","starred_url":"https://api.github.com/users/syntaxerror247/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/syntaxerror247/subscriptions","organizations_url":"https://api.github.com/users/syntaxerror247/orgs","repos_url":"https://api.github.com/users/syntaxerror247/repos","events_url":"https://api.github.com/users/syntaxerror247/events{/privacy}","received_events_url":"https://api.github.com/users/syntaxerror247/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/118153/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/godotengine/godot/issues/118153/timeline","performed_via_github_app":null,"state_reason":"not_planned","pinned_co