6SJc7imNV2","user":{"login":"mikest","id":742517,"node_id":"MDQ6VXNlcjc0MjUxNw==","avatar_url":"https://avatars.githubusercontent.com/u/742517?v=4","gravatar_id":"","url":"https://api.github.com/users/mikest","html_url":"https://github.com/mikest","followers_url":"https://api.github.com/users/mikest/followers","following_url":"https://api.github.com/users/mikest/following{/other_user}","gists_url":"https://api.github.com/users/mikest/gists{/gist_id}","starred_url":"https://api.github.com/users/mikest/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/mikest/subscriptions","organizations_url":"https://api.github.com/users/mikest/orgs","repos_url":"https://api.github.com/users/mikest/repos","events_url":"https://api.github.com/users/mikest/events{/privacy}","received_events_url":"https://api.github.com/users/mikest/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-01-26T20:43:51Z","updated_at":"2026-01-26T20:43:51Z","body":"@Nick80835 that was it! Yes, this appears to be related to Editable Children. I will see if I can make a minimally reproducing scene file.","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3801666934/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3802056398","html_url":"https://github.com/godotengine/godot/issues/115402#issuecomment-3802056398","issue_url":"https://api.github.com/repos/godotengine/godot/issues/115402","id":3802056398,"node_id":"IC_kwDOAO6SJc7insbO","user":{"login":"cdemirer","id":41021322,"node_id":"MDQ6VXNlcjQxMDIxMzIy","avatar_url":"https://avatars.githubusercontent.com/u/41021322?v=4","gravatar_id":"","url":"https://api.github.com/users/cdemirer","html_url":"https://github.com/cdemirer","followers_url":"https://api.github.com/users/cdemirer/followers","following_url":"https://api.github.com/users/cdemirer/following{/other_user}","gists_url":"https://api.github.com/users/cdemirer/gists{/gist_id}","starred_url":"https://api.github.com/users/cdemirer/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/cdemirer/subscriptions","organizations_url":"https://api.github.com/users/cdemirer/orgs","repos_url":"https://api.github.com/users/cdemirer/repos","events_url":"https://api.github.com/users/cdemirer/events{/privacy}","received_events_url":"https://api.github.com/users/cdemirer/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-01-26T22:28:33Z","updated_at":"2026-01-26T22:28:33Z","body":"Here's an [MRP](https://github.com/user-attachments/files/24869632/editable-children-resource-local-to-scene.zip)\n\nSteps to observe:\n- Open `main.tscn`.\n- Select `TextureRect` in `Main` scene.\n- Assign **a new `ViewportTexture`** to the `Texture` property.\n- Choose the `SubViewport` of `Main` as the target.\n- Observe the text \"override in main\".\n- Save and reload the scene.\n- Observe the text \"scene default text\".","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3802056398/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3802442282","html_url":"https://github.com/godotengine/godot/issues/115402#issuecomment-3802442282","issue_url":"https://api.github.com/repos/godotengine/godot/issues/115402","id":3802442282,"node_id":"IC_kwDOAO6SJc7ipKoq","user":{"login":"Rindbee","id":30386067,"node_id":"MDQ6VXNlcjMwMzg2MDY3","avatar_url":"https://avatars.githubusercontent.com/u/30386067?v=4","gravatar_id":"","url":"https://api.github.com/users/Rindbee","html_url":"https://github.com/Rindbee","followers_url":"https://api.github.com/users/Rindbee/followers","following_url":"https://api.github.com/users/Rindbee/following{/other_user}","gists_url":"https://api.github.com/users/Rindbee/gists{/gist_id}","starred_url":"https://api.github.com/users/Rindbee/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Rindbee/subscriptions","organizations_url":"https://api.github.com/users/Rindbee/orgs","repos_url":"https://api.github.com/users/Rindbee/repos","events_url":"https://api.github.com/users/Rindbee/events{/privacy}","received_events_url":"https://api.github.com/users/Rindbee/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-01-27T00:26:19Z","updated_at":"2026-01-27T00:48:36Z","body":"> Here's an [MRP](https://github.com/user-attachments/files/24869632/editable-children-resource-local-to-scene.zip)\n\nThis is expected. It requires that the target `Viewport` and `ViewportTexture` be in the same scene. The scene to which a resource belongs is determined by the scene of the node to which it is attached. \n\n`viewport_path` is a relative path (from the local scene to the target viewport), relative to the `owner` of the node it is attached to, i.e., the local scene. Selecting a path from the **Select a Node** dialog will give you a node path relative to the root of the main scene. This path is not relative to the root of the sub-scene root.\n\n<img width=\"393\" height=\"152\" alt=\"Image\" src=\"https://github.com/user-attachments/assets/6668db26-df50-4ed3-a376-5ce71bff2fe0\" />\n\nPlease manually edit `viewport_path`.","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3802442282/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3808534113","html_url":"https://github.com/godotengine/godot/issues/115402#issuecomment-3808534113","issue_url":"https://api.github.com/repos/godotengine/godot/issues/115402","id":3808534113,"node_id":"IC_kwDOAO6SJc7jAZ5h","user":{"login":"mikest","id":742517,"node_id":"MDQ6VXNlcjc0MjUxNw==","avatar_url":"https://avatars.githubusercontent.com/u/742517?v=4","gravatar_id":"","url":"https://api.github.com/users/mikest","html_url":"https://github.com/mikest","followers_url":"https://api.github.com/users/mikest/followers","following_url":"https://api.github.com/users/mikest/following{/other_user}","gists_url":"https://api.github.com/users/mikest/gists{/gist_id}","starred_url":"https://api.github.com/users/mikest/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/mikest/subscriptions","organizations_url":"https://api.github.com/users/mikest/orgs","repos_url":"https://api.github.com/users/mikest/repos","events_url":"https://api.github.com/users/mikest/events{/privacy}","received_events_url":"https://api.github.com/users/mikest/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-01-28T02:02:31Z","updated_at":"2026-01-28T02:07:43Z","body":"> This is expected. It requires that the target Viewport and ViewportTexture be in the same scene.\n\nEDIT: @Rindbee I think I have incorrectly parsed the intent of your comment, and I see that you have pushed a pull request to fix the behavior. It sounds like we are in agreement.\n\nApologies!","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3808534113/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3842115144","html_url":"https://github.com/godotengine/godot/issues/115402#issuecomment-3842115144","issue_url":"https://api.github.com/repos/godotengine/godot/issues/115402","id":3842115144,"node_id":"IC_kwDOAO6SJc7lAgZI","user":{"login":"m4rr5","id":446570,"node_id":"MDQ6VXNlcjQ0NjU3MA==","avatar_url":"https://avatars.githubusercontent.com/u/446570?v=4","gravatar_id":"","url":"https://api.github.com/users/m4rr5","html_url":"https://github.com/m4rr5","followers_url":"https://api.github.com/users/m4rr5/followers","following_url":"https://api.github.com/users/m4rr5/following{/other_user}","gists_url":"https://api.github.com/users/m4rr5/gists{/gist_id}","starred_url":"https://api.github.com/users/m4rr5/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/m4rr5/subscriptions","organizations_url":"https://api.github.com/users/m4rr5/orgs","repos_url":"https://api.github.com/users/m4rr5/repos","events_url":"https://api.github.com/users/m4rr5/events{/privacy}","received_events_url":"https://api.github.com/users/m4rr5/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-02-03T15:48:46Z","updated_at":"2026-02-03T15:48:46Z","body":"I was running into the same issue with a couple of projects that worked just fine in 4.5(.1) and stopped showing the subviewport texture. Either editing the path by hand as suggested above by @Rindbee or applying the linked PR (and selecting the viewport again and then saving the project) works.","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3842115144/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3868189104","html_url":"https://github.com/godotengine/godot/issues/115402#issuecomment-3868189104","issue_url":"https://api.github.com/repos/godotengine/godot/issues/115402","id":3868189104,"node_id":"IC_kwDOAO6SJc7mj-Gw","user":{"login":"m4rr5","i