6VXNlcjQ3MDEzMzg=","avatar_url":"https://avatars.githubusercontent.com/u/4701338?v=4","gravatar_id":"","url":"https://api.github.com/users/akien-mga","html_url":"https://github.com/akien-mga","followers_url":"https://api.github.com/users/akien-mga/followers","following_url":"https://api.github.com/users/akien-mga/following{/other_user}","gists_url":"https://api.github.com/users/akien-mga/gists{/gist_id}","starred_url":"https://api.github.com/users/akien-mga/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/akien-mga/subscriptions","organizations_url":"https://api.github.com/users/akien-mga/orgs","repos_url":"https://api.github.com/users/akien-mga/repos","events_url":"https://api.github.com/users/akien-mga/events{/privacy}","received_events_url":"https://api.github.com/users/akien-mga/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-06-05T12:11:29Z","updated_at":"2025-06-05T12:22:35Z","body":"Pushed a commit to test enabling x86_64 assembly for Windows/MinGW again. It seems to work fine for me locally.\r\n\r\n*Edit:* So it's indeed failing on CI but not for me locally.\r\n\r\nOn CI it's using:\r\n```\r\nas -o thirdparty\\zstd\\decompress\\huf_decompress_amd64.windows.template_release.x86_64.o thirdparty\\zstd\\decompress\\huf_decompress_amd64.S\r\n```\r\nwhile locally I have:\r\n```\r\nx86_64-w64-mingw32-gcc -DTOOLS_ENABLED -DDEBUG_ENABLED -DDEV_ENABLED -DENGINE_UPDATE_CHECK_ENABLED -DNO_EDITOR_SPLASH -DWINDOWS_ENABLED -DWASAPI_ENABLED -DWINMIDI_ENABLED -DWINVER=0x0A00 -D_WIN32_WINNT=0x0A00 -DACCESSKIT_DYNAMIC -DACCESSKIT_ENABLED -DVULKAN_ENABLED -DRD_ENABLED -DGLES3_ENABLED -DMINGW_ENABLED -DMINGW_HAS_SECURE_API=1 -DMINIZIP_ENABLED -DBROTLI_ENABLED -DTHREADS_ENABLED -DCLIPPER2_ENABLED -DZLIB_DEBUG -DZSTD_STATIC_LINKING_ONLY -Iplatform/windows -I. -c -o bin/obj/thirdparty/zstd/decompress/huf_decompress_amd64.windows.editor.dev.x86_64.o thirdparty/zstd/decompress/huf_decompress_amd64.S\r\n```","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2943956828/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2944240027","html_url":"https://github.com/godotengine/godot/pull/103596#issuecomment-2944240027","issue_url":"https://api.github.com/repos/godotengine/godot/issues/103596","id":2944240027,"node_id":"IC_kwDOAO6SJc6vfYmb","user":{"login":"akien-mga","id":4701338,"node_id":"MDQ6VXNlcjQ3MDEzMzg=","avatar_url":"https://avatars.githubusercontent.com/u/4701338?v=4","gravatar_id":"","url":"https://api.github.com/users/akien-mga","html_url":"https://github.com/akien-mga","followers_url":"https://api.github.com/users/akien-mga/followers","following_url":"https://api.github.com/users/akien-mga/following{/other_user}","gists_url":"https://api.github.com/users/akien-mga/gists{/gist_id}","starred_url":"https://api.github.com/users/akien-mga/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/akien-mga/subscriptions","organizations_url":"https://api.github.com/users/akien-mga/orgs","repos_url":"https://api.github.com/users/akien-mga/repos","events_url":"https://api.github.com/users/akien-mga/events{/privacy}","received_events_url":"https://api.github.com/users/akien-mga/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-06-05T13:09:00Z","updated_at":"2025-06-05T13:12:07Z","body":"CC @bruvzg, that reminds me of e87377856174075e38b6d2ca338f28ffa0d9f59f.\r\n\r\nInterestingly in my case, locally, it's using `env[\"CC\"]` automatically.\r\nI put some prints around `env[\"AS\"]` and that's not what SCons uses for me to compile the `.S` file:\r\n```\r\n    print(env[\"AS\"])  # as\r\n    env[\"AS\"] = get_detected(env, \"as\")\r\n    print(env[\"AS\"])  # x86_64-w64-mingw32-as\r\n```\r\n\r\nI adapted my commit to be similar to what we did on Android, and now it passes on CI, using:\r\n```\r\nx86_64-w64-mingw32-gcc -c -o thirdparty\\zstd\\decompress\\huf_decompress_amd64.windows.template_release.x86_64.o thirdparty\\zstd\\decompress\\huf_decompress_amd64.S\r\n```\r\n\r\nOn my end it's still using the full `CC` and `CCFLAGS` though:\r\n```\r\nx86_64-w64-mingw32-gcc -c -DTOOLS_ENABLED -DDEBUG_ENABLED -DDEV_ENABLED -DENGINE_UPDATE_CHECK_ENABLED -DNO_EDITOR_SPLASH -DWINDOWS_ENABLED -DWASAPI_ENABLED -DWINMIDI_ENABLED -DWINVER=0x0A00 -D_WIN32_WINNT=0x0A00 -DACCESSKIT_DYNAMIC -DACCESSKIT_ENABLED -DVULKAN_ENABLED -DRD_ENABLED -DGLES3_ENABLED -DMINGW_ENABLED -DMINGW_HAS_SECURE_API=1 -DMINIZIP_ENABLED -DBROTLI_ENABLED -DTHREADS_ENABLED -DCLIPPER2_ENABLED -DZLIB_DEBUG -DZSTD_STATIC_LINKING_ONLY -Iplatform/windows -I. -c -o bin/obj/thirdparty/zstd/decompress/huf_decompress_amd64.windows.editor.dev.x86_64.o thirdparty/zstd/decompress/huf_decompress_amd64.S\r\n```\r\n\r\nThe lack of our Godot specific defines shouldn't be a problem here, but I can't explain why there is this discrepancy.","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2944240027/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2944271786","html_url":"https://github.com/godotengine/godot/pull/103596#issuecomment-2944271786","issue_url":"https://api.github.com/repos/godotengine/godot/issues/103596","id":2944271786,"node_id":"IC_kwDOAO6SJc6vfgWq","user":{"login":"bruvzg","id":7645683,"node_id":"MDQ6VXNlcjc2NDU2ODM=","avatar_url":"https://avatars.githubusercontent.com/u/7645683?v=4","gravatar_id":"","url":"https://api.github.com/users/bruvzg","html_url":"https://github.com/bruvzg","followers_url":"https://api.github.com/users/bruvzg/followers","following_url":"https://api.github.com/users/bruvzg/following{/other_user}","gists_url":"https://api.github.com/users/bruvzg/gists{/gist_id}","starred_url":"https://api.github.com/users/bruvzg/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/bruvzg/subscriptions","organizations_url":"https://api.github.com/users/bruvzg/orgs","repos_url":"https://api.github.com/users/bruvzg/repos","events_url":"https://api.github.com/users/bruvzg/events{/privacy}","received_events_url":"https://api.github.com/users/bruvzg/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-06-05T13:15:29Z","updated_at":"2025-06-05T13:15:29Z","body":"I think it depends on file extension `.s` and `.asm` gone directly to AS, and capital `.S` always preprocessed. ","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2944271786/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2944313565","html_url":"https://github.com/godotengine/godot/pull/103596#issuecomment-2944313565","issue_url":"https://api.github.com/repos/godotengine/godot/issues/103596","id":2944313565,"node_id":"IC_kwDOAO6SJc6vfqjd","user":{"login":"bruvzg","id":7645683,"node_id":"MDQ6VXNlcjc2NDU2ODM=","avatar_url":"https://avatars.githubusercontent.com/u/7645683?v=4","gravatar_id":"","url":"https://api.github.com/users/bruvzg","html_url":"https://github.com/bruvzg","followers_url":"https://api.github.com/users/bruvzg/followers","following_url":"https://api.github.com/users/bruvzg/following{/other_user}","gists_url":"https://api.github.com/users/bruvzg/gists{/gist_id}","starred_url":"https://api.github.com/users/bruvzg/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/bruvzg/subscriptions","organizations_url":"https://api.github.com/users/bruvzg/orgs","repos_url":"https://api.github.com/users/bruvzg/repos","events_url":"https://api.github.com/users/bruvzg/events{/privacy}","received_events_url":"https://api.github.com/users/bruvzg/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-06-05T13:25:00Z","updated_at":"2025-06-05T13:25:00Z","body":"`clang-cl` likely won't be able to build `.s` file, it might preprocess defines, but it's a GAS syntax file, and `clang-cl` probably will pass it to MSVC assembler.","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2944313565/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2944453422","html_url":"https://github.com/godotengine/godot/pull/103596#issuecomment-2944453422","issue_url":"https://api.github.com/repos/godotengine/godot/issues/103596","id":2944453422,"node_id":"IC_kwDOAO6SJc6vgMsu","user":{"login":"akien-mga","id":4701338,"node_id":"MDQ6VXNlcjQ3MDEzMzg=","avatar_url":"https://avatars.githubusercontent.com/u/4701338?v=4","gravatar_id":"","url":"https://api.github.com/users/akien-mga","html_url":"https://github.com/akien-mga","followers_url":"https://api.github.com/users/akien-mga/followers","following_url":"https://api.github.com/users/akien-mga/following{/other_user}","gists_url":"https://api.github.com/users/akien-mga/gists{/gist_id}","starred_url":"https://api.github.com/users/akien-mga/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/akien-mga/subscriptions","organizations_url":"https://api.github.com/users/akien-mga/orgs","repos_url":"https://api.github.com/users/akien-mga/repos","events_url":"https://api.github.com/users/akien-mga/events{/privacy}","received_events_url":"https://api.github.com/users/akien-mga/received_events","type":