os_url":"https://api.github.com/users/akien-mga/repos","events_url":"https://api.github.com/users/akien-mga/events{/privacy}","received_events_url":"https://api.github.com/users/akien-mga/received_events","type":"User","user_view_type":"public","site_admin":false},"open_issues":46,"closed_issues":202,"state":"open","created_at":"2024-09-11T14:28:19Z","updated_at":"2026-10-20T11:50:17Z","due_on":null,"closed_at":null},"comments":2,"created_at":"2025-10-29T16:06:14Z","updated_at":"2025-10-30T07:05:53Z","closed_at":"2025-10-30T07:05:44Z","assignee":null,"author_association":"MEMBER","issue_field_values":[],"type":null,"active_lock_reason":null,"draft":false,"pull_request":{"url":"https://api.github.com/repos/godotengine/godot/pulls/112170","html_url":"https://github.com/godotengine/godot/pull/112170","diff_url":"https://github.com/godotengine/godot/pull/112170.diff","patch_url":"https://github.com/godotengine/godot/pull/112170.patch","merged_at":"2025-10-30T07:05:44Z"},"body":"It turns out that hot swapping the audio driver causes crashes on my Android tablet, so I've hard coded muting to not be allowed on Android (editor and exports).\r\n\r\nRegression from #63458 .\r\n\r\nThe crash happens when you load the editor, then open an audio file and play in the editor. This triggers the muting on silence. In most cases, playing a game from the editor won't trigger muting.\r\n\r\n_The new muting feature is the most likely to cause regressions as we haven't tested it on all platforms and get limited testing of the development branch._\r\n\r\n## Notes\r\n* This isn't particularly pretty, but should work as a quick fix for 3.7 dev 1.\r\n* We can also add this to docs, but not really necessary at this stage, as we need more feedback from dev 1.\r\n* An alternative would have been to add overrides in project / editor settings set to off for Android. This would enable users to test muting on more devices, but on the flip side would be able to make exports which would likely crash, so probably better we test Android muting internally.\r\n* There is also the possibility it will cause problems on Mac or iOS, but without access to one we will probably just need to let testers of dev 1 try it. They should be able to turn off muting in the editor settings / project settings if it does cause problems.\r\n\r\n<!--\r\nPlease target the `master` branch in priority.\r\n\r\nRelevant fixes are cherry-picked for stable branches as needed by maintainers.\r\n\r\nTo speed up the contribution process and avoid CI errors, please set up pre-commit hooks locally:\r\nhttps://contributing.godotengine.org/en/latest/engine/guidelines/code_style.html\r\n-->\r\n","closed_by":{"login":"lawnjelly","id":21999379,"node_id":"MDQ6VXNlcjIxOTk5Mzc5","avatar_url":"https://avatars.githubusercontent.com/u/21999379?v=4","gravatar_id":"","url":"https://api.github.com/users/lawnjelly","html_url":"https://github.com/lawnjelly","followers_url":"https://api.github.com/users/lawnjelly/followers","following_url":"https://api.github.com/users/lawnjelly/following{/other_user}","gists_url":"https://api.github.com/users/lawnjelly/gists{/gist_id}","starred_url":"https://api.github.com/users/lawnjelly/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/lawnjelly/subscriptions","organizations_url":"https://api.github.com/users/lawnjelly/orgs","repos_url":"https://api.github.com/users/lawnjelly/repos","events_url":"https://api.github.com/users/lawnjelly/events{/privacy}","received_events_url":"https://api.github.com/users/lawnjelly/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/112170/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/godotengine/godot/issues/112170/timeline","performed_via_github_app":null,"state_reason":null}