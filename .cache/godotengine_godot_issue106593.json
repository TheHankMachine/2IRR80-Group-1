ithub.com/user-attachments/assets/5aee232e-d195-4039-a39a-8a21968523c8)\r\ngizmos mess with sort\r\n![image](https://github.com/user-attachments/assets/485b8d92-2822-4f53-b09f-5e172526b771)\r\n\r\nThe project I made for testing\r\n[project.zip](https://github.com/user-attachments/files/20297001/project.zip)\r\n\r\n","closed_by":{"login":"Faolan-Rad","id":46481567,"node_id":"MDQ6VXNlcjQ2NDgxNTY3","avatar_url":"https://avatars.githubusercontent.com/u/46481567?v=4","gravatar_id":"","url":"https://api.github.com/users/Faolan-Rad","html_url":"https://github.com/Faolan-Rad","followers_url":"https://api.github.com/users/Faolan-Rad/followers","following_url":"https://api.github.com/users/Faolan-Rad/following{/other_user}","gists_url":"https://api.github.com/users/Faolan-Rad/gists{/gist_id}","starred_url":"https://api.github.com/users/Faolan-Rad/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Faolan-Rad/subscriptions","organizations_url":"https://api.github.com/users/Faolan-Rad/orgs","repos_url":"https://api.github.com/users/Faolan-Rad/repos","events_url":"https://api.github.com/users/Faolan-Rad/events{/privacy}","received_events_url":"https://api.github.com/users/Faolan-Rad/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/106593/reactions","total_count":14,"+1":10,"-1":0,"laugh":0,"hooray":1,"confused":0,"heart":0,"rocket":0,"eyes":3},"timeline_url":"https://api.github.com/repos/godotengine/godot/issues/106593/timeline","performed_via_github_app":null,"state_reason":null}