ub.com/users/bruvzg/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/bruvzg/subscriptions","organizations_url":"https://api.github.com/users/bruvzg/orgs","repos_url":"https://api.github.com/users/bruvzg/repos","events_url":"https://api.github.com/users/bruvzg/events{/privacy}","received_events_url":"https://api.github.com/users/bruvzg/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-07-29T17:31:06Z","updated_at":"2025-07-29T17:31:06Z","body":"It's not ignored, but system fallback fonts always use the same settings as base font, and bitmap emoji font can't be rendered as MSDF (only works with monochrome vector fonts).","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3133428419/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3133618549","html_url":"https://github.com/godotengine/godot/issues/109091#issuecomment-3133618549","issue_url":"https://api.github.com/repos/godotengine/godot/issues/109091","id":3133618549,"node_id":"IC_kwDOAO6SJc66xzl1","user":{"login":"Koyper","id":33969780,"node_id":"MDQ6VXNlcjMzOTY5Nzgw","avatar_url":"https://avatars.githubusercontent.com/u/33969780?v=4","gravatar_id":"","url":"https://api.github.com/users/Koyper","html_url":"https://github.com/Koyper","followers_url":"https://api.github.com/users/Koyper/followers","following_url":"https://api.github.com/users/Koyper/following{/other_user}","gists_url":"https://api.github.com/users/Koyper/gists{/gist_id}","starred_url":"https://api.github.com/users/Koyper/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Koyper/subscriptions","organizations_url":"https://api.github.com/users/Koyper/orgs","repos_url":"https://api.github.com/users/Koyper/repos","events_url":"https://api.github.com/users/Koyper/events{/privacy}","received_events_url":"https://api.github.com/users/Koyper/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-07-29T18:34:19Z","updated_at":"2025-07-29T18:34:19Z","body":"The bitmapped emojis are definitely being combined with the MSDF rendered text when the fallback is set manually, so can we apply that approach for the system fallback fonts in the case of an emoji? It seems like there must be some duplicate code applying the system fallback font differently between when the fallback is specified manually vs. via `allow_system_fallback`?","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3133618549/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3133640984","html_url":"https://github.com/godotengine/godot/issues/109091#issuecomment-3133640984","issue_url":"https://api.github.com/repos/godotengine/godot/issues/109091","id":3133640984,"node_id":"IC_kwDOAO6SJc66x5EY","user":{"login":"bruvzg","id":7645683,"node_id":"MDQ6VXNlcjc2NDU2ODM=","avatar_url":"https://avatars.githubusercontent.com/u/7645683?v=4","gravatar_id":"","url":"https://api.github.com/users/bruvzg","html_url":"https://github.com/bruvzg","followers_url":"https://api.github.com/users/bruvzg/followers","following_url":"https://api.github.com/users/bruvzg/following{/other_user}","gists_url":"https://api.github.com/users/bruvzg/gists{/gist_id}","starred_url":"https://api.github.com/users/bruvzg/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/bruvzg/subscriptions","organizations_url":"https://api.github.com/users/bruvzg/orgs","repos_url":"https://api.github.com/users/bruvzg/repos","events_url":"https://api.github.com/users/bruvzg/events{/privacy}","received_events_url":"https://api.github.com/users/bruvzg/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-07-29T18:42:33Z","updated_at":"2025-07-29T18:42:33Z","body":"> It seems like there must be some duplicate code applying the system fallback font differently between when the fallback is specified manually vs. via allow_system_fallback?\n\nIt's completely different things, pretty much unrelated to each other. A manually added system font is a fully independent font and can be configured, but it is a specific-fixed font. Automatic system fallback is not, it's letting OS to decide which font to use for a porting of text, but it's probably OK to allow it disabling MSDF if found system font is a bitmap font or color font.","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3133640984/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3133768137","html_url":"https://github.com/godotengine/godot/issues/109091#issuecomment-3133768137","issue_url":"https://api.github.com/repos/godotengine/godot/issues/109091","id":3133768137,"node_id":"IC_kwDOAO6SJc66yYHJ","user":{"login":"Koyper","id":33969780,"node_id":"MDQ6VXNlcjMzOTY5Nzgw","avatar_url":"https://avatars.githubusercontent.com/u/33969780?v=4","gravatar_id":"","url":"https://api.github.com/users/Koyper","html_url":"https://github.com/Koyper","followers_url":"https://api.github.com/users/Koyper/followers","following_url":"https://api.github.com/users/Koyper/following{/other_user}","gists_url":"https://api.github.com/users/Koyper/gists{/gist_id}","starred_url":"https://api.github.com/users/Koyper/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Koyper/subscriptions","organizations_url":"https://api.github.com/users/Koyper/orgs","repos_url":"https://api.github.com/users/Koyper/repos","events_url":"https://api.github.com/users/Koyper/events{/privacy}","received_events_url":"https://api.github.com/users/Koyper/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-07-29T19:25:44Z","updated_at":"2025-07-29T19:25:44Z","body":"> but it's probably OK to allow it disabling MSDF if found system font is a bitmap font or color font.\n\nThanks this would definitely resolve this issue. Also, what you wrote about the manually added system font, points to solving any memory issue by saving the system font resource to disk and using that for all fonts necessary, rather than redundantly duplicating them in each font resource.","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3133768137/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null}]