e FBX file from your computer through a file explorer, drag and drop the file onto godot's window so that godot can import it.\n\n### Minimal reproduction project (MRP)\n\nNot necessary, its a brand new file.","closed_by":{"login":"RBbooms","id":142638527,"node_id":"U_kgDOCIB9vw","avatar_url":"https://avatars.githubusercontent.com/u/142638527?v=4","gravatar_id":"","url":"https://api.github.com/users/RBbooms","html_url":"https://github.com/RBbooms","followers_url":"https://api.github.com/users/RBbooms/followers","following_url":"https://api.github.com/users/RBbooms/following{/other_user}","gists_url":"https://api.github.com/users/RBbooms/gists{/gist_id}","starred_url":"https://api.github.com/users/RBbooms/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/RBbooms/subscriptions","organizations_url":"https://api.github.com/users/RBbooms/orgs","repos_url":"https://api.github.com/users/RBbooms/repos","events_url":"https://api.github.com/users/RBbooms/events{/privacy}","received_events_url":"https://api.github.com/users/RBbooms/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/102979/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/godotengine/godot/issues/102979/timeline","performed_via_github_app":null,"state_reason":"completed","pinned_comment":null}