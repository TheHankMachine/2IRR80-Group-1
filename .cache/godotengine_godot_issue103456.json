nts/assets/d2f7406e-efbe-42aa-a28b-3f824c2386fa)\n\n### Steps to reproduce\n\n1. Download project: https://github.com/geegaz/Multiple-Windows-tutorial\n2. Run the game and check if the character's background is transparent.\n3. If it's black, change the Rendering Method to gl_compatibility and run it again.\n\n### Minimal reproduction project (MRP)\n\nhttps://github.com/geegaz/Multiple-Windows-tutorial\n\nI just use this repo to reproduces the issue.","closed_by":{"login":"Calinou","id":180032,"node_id":"MDQ6VXNlcjE4MDAzMg==","avatar_url":"https://avatars.githubusercontent.com/u/180032?v=4","gravatar_id":"","url":"https://api.github.com/users/Calinou","html_url":"https://github.com/Calinou","followers_url":"https://api.github.com/users/Calinou/followers","following_url":"https://api.github.com/users/Calinou/following{/other_user}","gists_url":"https://api.github.com/users/Calinou/gists{/gist_id}","starred_url":"https://api.github.com/users/Calinou/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Calinou/subscriptions","organizations_url":"https://api.github.com/users/Calinou/orgs","repos_url":"https://api.github.com/users/Calinou/repos","events_url":"https://api.github.com/users/Calinou/events{/privacy}","received_events_url":"https://api.github.com/users/Calinou/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/103456/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/godotengine/godot/issues/103456/timeline","performed_via_github_app":null,"state_reason":"completed","pinned_comment":null}