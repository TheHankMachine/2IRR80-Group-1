ed_by":null},{"id":279098111,"node_id":"MDU6TGFiZWwyNzkwOTgxMTE=","url":"https://api.github.com/repos/godotengine/godot/labels/topic:rendering","name":"topic:rendering","color":"ffee88","default":false,"description":"","archived_at":null,"archived_by":null},{"id":3240950060,"node_id":"MDU6TGFiZWwzMjQwOTUwMDYw","url":"https://api.github.com/repos/godotengine/godot/labels/performance","name":"performance","color":"447777","default":false,"description":"","archived_at":null,"archived_by":null}],"state":"closed","locked":false,"assignees":[],"milestone":{"url":"https://api.github.com/repos/godotengine/godot/milestones/22","html_url":"https://github.com/godotengine/godot/milestone/22","labels_url":"https://api.github.com/repos/godotengine/godot/milestones/22/labels","id":12070367,"node_id":"MI_kwDOAO6SJc4AuC3f","number":22,"title":"4.5","description":"","creator":{"login":"Sauermann","id":6299227,"node_id":"MDQ6VXNlcjYyOTkyMjc=","avatar_url":"https://avatars.githubusercontent.com/u/6299227?v=4","gravatar_id":"","url":"https://api.github.com/users/Sauermann","html_url":"https://github.com/Sauermann","followers_url":"https://api.github.com/users/Sauermann/followers","following_url":"https://api.github.com/users/Sauermann/following{/other_user}","gists_url":"https://api.github.com/users/Sauermann/gists{/gist_id}","starred_url":"https://api.github.com/users/Sauermann/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Sauermann/subscriptions","organizations_url":"https://api.github.com/users/Sauermann/orgs","repos_url":"https://api.github.com/users/Sauermann/repos","events_url":"https://api.github.com/users/Sauermann/events{/privacy}","received_events_url":"https://api.github.com/users/Sauermann/received_events","type":"User","user_view_type":"public","site_admin":false},"open_issues":3,"closed_issues":3687,"state":"closed","created_at":"2024-12-19T08:51:28Z","updated_at":"2026-09-04T21:48:38Z","due_on":"2025-09-15T00:00:00Z","closed_at":"2025-09-18T17:13:14Z"},"comments":1,"created_at":"2025-03-03T22:40:07Z","updated_at":"2025-03-06T22:42:46Z","closed_at":"2025-03-06T22:42:15Z","assignee":null,"author_association":"MEMBER","issue_field_values":[],"type":null,"active_lock_reason":null,"draft":false,"pull_request":{"url":"https://api.github.com/repos/godotengine/godot/pulls/103529","html_url":"https://github.com/godotengine/godot/pull/103529","diff_url":"https://github.com/godotengine/godot/pull/103529.diff","patch_url":"https://github.com/godotengine/godot/pull/103529.patch","merged_at":"2025-03-06T22:42:15Z"},"body":"While discussing performance with @darksylinc I noticed that we have this bit of code that runs several times per frame: \r\n\r\nhttps://github.com/godotengine/godot/blob/9f68a816599412c56a4626dd6c47244ebc65ed1f/servers/rendering/renderer_rd/forward_mobile/render_forward_mobile.cpp#L1838-L1839\r\n\r\nThis is called for every light in the scene (1-4 times per directional light, and 2 or 6 times per omnilight). The resize therefore is guaranteed to shrink the array once (and call a bunch of destructors) and increase the size of the array several times. In the typically case the overall size won't actual change much between frames. \r\n\r\nImportantly, `resize()` doesn't free memory, so after a couple of frames this stabilizes and no longer allocates memory. However, it still risks calling constructors and destructors if the memory type is not trivially constructable/destructable. \r\n\r\nhttps://github.com/godotengine/godot/blob/9f68a816599412c56a4626dd6c47244ebc65ed1f/core/templates/local_vector.h#L151-L172\r\n\r\nI added the static asserts locally to check and surprise! `InstanceData` in the Mobile renderer was not trivially constructable! Therefore the constructor was being called for almost every element every frame unnecessarily. This PR fixes that and leaves the static asserts in so we don't accidentally make it non-trivially constructable again. \r\n\r\nCC @Ivorforce who might be interested","closed_by":{"login":"Repiteo","id":17489292,"node_id":"MDQ6VXNlcjE3NDg5Mjky","avatar_url":"https://avatars.githubusercontent.com/u/17489292?v=4","gravatar_id":"","url":"https://api.github.com/users/Repiteo","html_url":"https://github.com/Repiteo","followers_url":"https://api.github.com/users/Repiteo/followers","following_url":"https://api.github.com/users/Repiteo/following{/other_user}","gists_url":"https://api.github.com/users/Repiteo/gists{/gist_id}","starred_url":"https://api.github.com/users/Repiteo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Repiteo/subscriptions","organizations_url":"https://api.github.com/users/Repiteo/orgs","repos_url":"https://api.github.com/users/Repiteo/repos","events_url":"https://api.github.com/users/Repiteo/events{/privacy}","received_events_url":"https://api.github.com/users/Repiteo/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/103529/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/godotengine/godot/issues/103529/timeline","performed_via_github_app":null,"state_reason":null}