15,"node_id":"PRR_kwDOAO6SJc7KXpDr","state":"COMMENTED","user":{"site_admin":false,"suspended":false,"updated_at":"0001-01-01T00:00:00Z","avatar_url":"https://avatars.githubusercontent.com/u/180032?u=68d23e7ee9cdf810da125e8510b72f845b9dccc8&v=4","created_at":"0001-01-01T00:00:00Z","followers":0,"following":0,"html_url":"https://github.com/Calinou","id":180032,"node_id":"MDQ6VXNlcjE4MDAzMg==","login":"Calinou","type":"User","owned_private_repos":0,"public_gists":0,"public_repos":0,"total_private_repos":0,"url":"https://api.github.com/users/Calinou"},"body":"","html_url":"https://github.com/godotengine/godot/pull/111118#pullrequestreview-3395195115","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/111118","author_association":"MEMBER","submitted_at":"2025-10-29T18:19:55Z"},{"id":3401032379,"node_id":"PRR_kwDOAO6SJc7Kt6K7","state":"APPROVED","commit_id":"e06f015f959fddf3660863186a5947e49cb03166","user":{"site_admin":false,"suspended":false,"updated_at":"0001-01-01T00:00:00Z","avatar_url":"https://avatars.githubusercontent.com/u/4701338?u=4a42fd867f2c449fcc23adf635dd574dae98e6c2&v=4","created_at":"0001-01-01T00:00:00Z","followers":0,"following":0,"html_url":"https://github.com/akien-mga","id":4701338,"node_id":"MDQ6VXNlcjQ3MDEzMzg=","login":"akien-mga","type":"User","owned_private_repos":0,"public_gists":0,"public_repos":0,"total_private_repos":0,"url":"https://api.github.com/users/akien-mga"},"body":"Great work @YeldhamDev and @passivestar, and everyone reviewing so far!\r\n\r\nThis seems in a pretty good state to merge now and get more testing. The PR is already quite big and handling all remaining feedback in a big PR is cumbersome.\r\n\r\nSo we're aware that some feedback is still unaddressed, but let's keep track of it in dedicated issues and fix it in follow-up PRs, so we can fine tune the details and ensure most users are satisfied with the new theme by the time 4.6-stable releases.\r\n\r\nMerging this now means that the first version will be available in the upcoming 4.6-dev3 snapshot, but again further work will be done during the dev (and maybe beta) phase to polish it up.","html_url":"https://github.com/godotengine/godot/pull/111118#pullrequestreview-3401032379","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/111118","author_association":"MEMBER","submitted_at":"2025-10-30T18:22:37Z"},{"id":3402714444,"node_id":"PRR_kwDOAO6SJc7K0U1M","state":"COMMENTED","commit_id":"e06f015f959fddf3660863186a5947e49cb03166","user":{"site_admin":false,"suspended":false,"updated_at":"0001-01-01T00:00:00Z","avatar_url":"https://avatars.githubusercontent.com/u/1646875?u=24618295fece29a0bf5c850faf2555985232f5f2&v=4","created_at":"0001-01-01T00:00:00Z","followers":0,"following":0,"html_url":"https://github.com/aaronfranke","id":1646875,"node_id":"MDQ6VXNlcjE2NDY4NzU=","login":"aaronfranke","type":"User","owned_private_repos":0,"public_gists":0,"public_repos":0,"total_private_repos":0,"url":"https://api.github.com/users/aaronfranke"},"body":"","html_url":"https://github.com/godotengine/godot/pull/111118#pullrequestreview-3402714444","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/111118","author_association":"MEMBER","submitted_at":"2025-10-31T06:10:03Z"}]