ithub.com/users/zongxinYu/followers","following_url":"https://api.github.com/users/zongxinYu/following{/other_user}","gists_url":"https://api.github.com/users/zongxinYu/gists{/gist_id}","starred_url":"https://api.github.com/users/zongxinYu/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/zongxinYu/subscriptions","organizations_url":"https://api.github.com/users/zongxinYu/orgs","repos_url":"https://api.github.com/users/zongxinYu/repos","events_url":"https://api.github.com/users/zongxinYu/events{/privacy}","received_events_url":"https://api.github.com/users/zongxinYu/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-10-03T05:18:00Z","updated_at":"2025-10-03T05:18:00Z","body":"> [@zongxinYu](https://github.com/zongxinYu)\n> \n> Class name and *.cs filename need same?\n> \n> class BaseUIComponent { } = BaseUIComponent.cs\n\nYes, the file name does not match the class name. However, the file is not directly exposed to the engine (as it is located inside a folder containing a .gdignore file). This class serves as a base class (inheriting from Control and defined as partial), and only its child classes are used as scripts.\n\n","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3364293022/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3364446223","html_url":"https://github.com/godotengine/godot/issues/110608#issuecomment-3364446223","issue_url":"https://api.github.com/repos/godotengine/godot/issues/110608","id":3364446223,"node_id":"IC_kwDOAO6SJc7IiWAP","user":{"login":"iwangxiaodong","id":16535878,"node_id":"MDQ6VXNlcjE2NTM1ODc4","avatar_url":"https://avatars.githubusercontent.com/u/16535878?v=4","gravatar_id":"","url":"https://api.github.com/users/iwangxiaodong","html_url":"https://github.com/iwangxiaodong","followers_url":"https://api.github.com/users/iwangxiaodong/followers","following_url":"https://api.github.com/users/iwangxiaodong/following{/other_user}","gists_url":"https://api.github.com/users/iwangxiaodong/gists{/gist_id}","starred_url":"https://api.github.com/users/iwangxiaodong/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/iwangxiaodong/subscriptions","organizations_url":"https://api.github.com/users/iwangxiaodong/orgs","repos_url":"https://api.github.com/users/iwangxiaodong/repos","events_url":"https://api.github.com/users/iwangxiaodong/events{/privacy}","received_events_url":"https://api.github.com/users/iwangxiaodong/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-10-03T06:36:23Z","updated_at":"2025-10-03T06:36:23Z","body":"I mean class name and *.cs filename modify to same, Fixed this problem.\n\nMy project F5(RUN) no longer output this error.","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3364446223/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3364483181","html_url":"https://github.com/godotengine/godot/issues/110608#issuecomment-3364483181","issue_url":"https://api.github.com/repos/godotengine/godot/issues/110608","id":3364483181,"node_id":"IC_kwDOAO6SJc7IifBt","user":{"login":"zongxinYu","id":42226851,"node_id":"MDQ6VXNlcjQyMjI2ODUx","avatar_url":"https://avatars.githubusercontent.com/u/42226851?v=4","gravatar_id":"","url":"https://api.github.com/users/zongxinYu","html_url":"https://github.com/zongxinYu","followers_url":"https://api.github.com/users/zongxinYu/followers","following_url":"https://api.github.com/users/zongxinYu/following{/other_user}","gists_url":"https://api.github.com/users/zongxinYu/gists{/gist_id}","starred_url":"https://api.github.com/users/zongxinYu/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/zongxinYu/subscriptions","organizations_url":"https://api.github.com/users/zongxinYu/orgs","repos_url":"https://api.github.com/users/zongxinYu/repos","events_url":"https://api.github.com/users/zongxinYu/events{/privacy}","received_events_url":"https://api.github.com/users/zongxinYu/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-10-03T06:51:39Z","updated_at":"2025-10-03T06:51:39Z","body":"> I mean class name and *.cs filename modify to same, Fixed this problem.\n> \n> My project F5(RUN) no longer output this error.\n\nYes, I have tried that (renaming the file to match the class name), and it works with no error log output. However, this behavior should still be considered a bug. The engine should ​​either​​ output the correct error information ​​or​​ enable this scenario (classes not exposed to the engine should be ignored, with strict constraints applied only to script classes).\n\n@AThousandShips \n","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3364483181/reactions","total_count":2,"+1":2,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4018606833","html_url":"https://github.com/godotengine/godot/issues/110608#issuecomment-4018606833","issue_url":"https://api.github.com/repos/godotengine/godot/issues/110608","id":4018606833,"node_id":"IC_kwDOAO6SJc7vhxLx","user":{"login":"hjl12345","id":170017602,"node_id":"U_kgDOCiJDQg","avatar_url":"https://avatars.githubusercontent.com/u/170017602?v=4","gravatar_id":"","url":"https://api.github.com/users/hjl12345","html_url":"https://github.com/hjl12345","followers_url":"https://api.github.com/users/hjl12345/followers","following_url":"https://api.github.com/users/hjl12345/following{/other_user}","gists_url":"https://api.github.com/users/hjl12345/gists{/gist_id}","starred_url":"https://api.github.com/users/hjl12345/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/hjl12345/subscriptions","organizations_url":"https://api.github.com/users/hjl12345/orgs","repos_url":"https://api.github.com/users/hjl12345/repos","events_url":"https://api.github.com/users/hjl12345/events{/privacy}","received_events_url":"https://api.github.com/users/hjl12345/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-03-08T08:06:51Z","updated_at":"2026-03-08T08:06:51Z","body":"I've also encountered this issue, which occurred when migrating from 4.5 to 4.6. It often appears alongside \".NET: Failed to unload assemblies. Please check #78513 for more information.\" Additionally, no matter how many times I rebuild or restart the editor in the monitor, the warning \"This inspector might be out of date. Please build the C# project.\" keeps showing up. Simply put, a single C# script can only define one C# class, and the class name must match the file name. However, [no rules](https://docs.godotengine.org/en/stable/tutorials/scripting/c_sharp/diagnostics/) restrict this.","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4018606833/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4174199007","html_url":"https://github.com/godotengine/godot/issues/110608#issuecomment-4174199007","issue_url":"https://api.github.com/repos/godotengine/godot/issues/110608","id":4174199007,"node_id":"IC_kwDOAO6SJc74zTjf","user":{"login":"galloppinggryphon","id":26875847,"node_id":"MDQ6VXNlcjI2ODc1ODQ3","avatar_url":"https://avatars.githubusercontent.com/u/26875847?v=4","gravatar_id":"","url":"https://api.github.com/users/galloppinggryphon","html_url":"https://github.com/galloppinggryphon","followers_url":"https://api.github.com/users/galloppinggryphon/followers","following_url":"https://api.github.com/users/galloppinggryphon/following{/other_user}","gists_url":"https://api.github.com/users/galloppinggryphon/gists{/gist_id}","starred_url":"https://api.github.com/users/galloppinggryphon/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/galloppinggryphon/subscriptions","organizations_url":"https://api.github.com/users/galloppinggryphon/orgs","repos_url":"https://api.github.com/users/galloppinggryphon/repos","events_url":"https://api.github.com/users/galloppinggryphon/events{/privacy}","received_events_url":"https://api.github.com/users/galloppinggryphon/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-04-02T02:24:57Z","updated_at":"2026-04-02T02:24:57Z","body":"I ran into this issue with 4.6. In my case, the problem was caused by a file linked to a scene containing two classes that both extended Node. One of those classes were again extended in other files. Splitting up those classes into separate files resolved the problem.  Obviously they should have been split up to begin with, but these things happen.\n\nTo be clearer, this was the structure of the offending files:\n\n`A.cs` (linked to `A.scn`):\n- `A()`: Control\n- `B()`: Control (extended by `X()`, `Y()`, `Z()`, etc)\n\nThe solution was moving `B()` to `B.cs`. I believe I'd be able to produce a minimum reproduction of this problem if that's of any value. Lmk. ","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4174199007/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null}]