r offset (50px), ensuring proper alignment.\r\nModified hover, click, and drag detection logic to align with the new minimap position.\r\nAdded a new method set_scrollbar_touch_area_enabled in TextEdit to handle the dynamic adjustment of the scrollbar touch area.\r\n\r\nThe hardcoded offset (50px) matches the touch area size defined in editor_theme_manager.cpp.","closed_by":{"login":"appersoncory","id":84872642,"node_id":"MDQ6VXNlcjg0ODcyNjQy","avatar_url":"https://avatars.githubusercontent.com/u/84872642?v=4","gravatar_id":"","url":"https://api.github.com/users/appersoncory","html_url":"https://github.com/appersoncory","followers_url":"https://api.github.com/users/appersoncory/followers","following_url":"https://api.github.com/users/appersoncory/following{/other_user}","gists_url":"https://api.github.com/users/appersoncory/gists{/gist_id}","starred_url":"https://api.github.com/users/appersoncory/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/appersoncory/subscriptions","organizations_url":"https://api.github.com/users/appersoncory/orgs","repos_url":"https://api.github.com/users/appersoncory/repos","events_url":"https://api.github.com/users/appersoncory/events{/privacy}","received_events_url":"https://api.github.com/users/appersoncory/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/100225/reactions","total_count":2,"+1":0,"-1":0,"laugh":0,"hooray":2,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/godotengine/godot/issues/100225/timeline","performed_via_github_app":null,"state_reason":null}