ic:gdscript","color":"ffee88","default":false,"description":"","archived_at":null,"archived_by":null},{"id":279098219,"node_id":"MDU6TGFiZWwyNzkwOTgyMTk=","url":"https://api.github.com/repos/godotengine/godot/labels/topic:editor","name":"topic:editor","color":"ffee88","default":false,"description":"","archived_at":null,"archived_by":null},{"id":3240950060,"node_id":"MDU6TGFiZWwzMjQwOTUwMDYw","url":"https://api.github.com/repos/godotengine/godot/labels/performance","name":"performance","color":"447777","default":false,"description":"","archived_at":null,"archived_by":null}],"state":"closed","locked":false,"assignees":[],"milestone":{"url":"https://api.github.com/repos/godotengine/godot/milestones/24","html_url":"https://github.com/godotengine/godot/milestone/24","labels_url":"https://api.github.com/repos/godotengine/godot/milestones/24/labels","id":14236899,"node_id":"MI_kwDOAO6SJc4A2Tzj","number":24,"title":"4.7","description":"","creator":{"login":"akien-mga","id":4701338,"node_id":"MDQ6VXNlcjQ3MDEzMzg=","avatar_url":"https://avatars.githubusercontent.com/u/4701338?v=4","gravatar_id":"","url":"https://api.github.com/users/akien-mga","html_url":"https://github.com/akien-mga","followers_url":"https://api.github.com/users/akien-mga/followers","following_url":"https://api.github.com/users/akien-mga/following{/other_user}","gists_url":"https://api.github.com/users/akien-mga/gists{/gist_id}","starred_url":"https://api.github.com/users/akien-mga/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/akien-mga/subscriptions","organizations_url":"https://api.github.com/users/akien-mga/orgs","repos_url":"https://api.github.com/users/akien-mga/repos","events_url":"https://api.github.com/users/akien-mga/events{/privacy}","received_events_url":"https://api.github.com/users/akien-mga/received_events","type":"User","user_view_type":"public","site_admin":false},"open_issues":3,"closed_issues":2535,"state":"closed","created_at":"2025-11-27T20:29:18Z","updated_at":"2026-10-20T18:39:31Z","due_on":null,"closed_at":"2026-06-19T16:54:35Z"},"comments":1,"created_at":"2026-01-03T14:07:01Z","updated_at":"2026-04-26T14:18:17Z","closed_at":"2026-02-06T14:23:24Z","assignee":null,"author_association":"MEMBER","issue_field_values":[],"type":null,"active_lock_reason":null,"draft":false,"pull_request":{"url":"https://api.github.com/repos/godotengine/godot/pulls/114559","html_url":"https://github.com/godotengine/godot/pull/114559","diff_url":"https://github.com/godotengine/godot/pull/114559.diff","patch_url":"https://github.com/godotengine/godot/pull/114559.patch","merged_at":"2026-02-06T14:23:24Z"},"body":"Fixes https://github.com/godotengine/godot/issues/100934\r\n\r\nSupersedes https://github.com/godotengine/godot/pull/101091\r\n\r\nI originally was only going to fix up some style issues to get the PR ready for merge, but ended up with some structure changes that I did not want to push to the original PR. (CC @dekaravanhoc if you are fine with the changes and want to integrate them feel free to do so!)\r\n\r\nDifferences:\r\n- rebased onto recent LSP changes\r\n- removed some excessive includes\r\n- moved the scene cache into it's own file\r\n- renamed some methods and parameters -> most of this is pretty subjective, some of it is meant to disambiguate or align stuff with other code\r\n- adjusted the behaviour of `get` to do a blocking load as fallback -> this is a measure for edge cases when multiple clients are connected and was an easier solution for the edge case than refcounting the loaded instances.\r\n- flattened out the additional queue struct. It made the code more clear but made the adjustment to `get` more complicated than necessary.\r\n\r\n---\r\n\r\n### Short explanation\r\n\r\nGDScript autocompletion can provide certain options that are tied to a specific scene instance, e.g. node paths for `$Node` literals. In the builtin editor the opened scene is used for that so an instance is inherently present. For external editors we need a different approach. Previously we would search a scene, load it and instantiate it for every request from the external editor. This has shown to be too slow in certain situations.\r\n\r\nThis change introduces a cache that keeps those scene instances alive between requests.\r\n","closed_by":{"login":"Repiteo","id":17489292,"node_id":"MDQ6VXNlcjE3NDg5Mjky","avatar_url":"https://avatars.githubusercontent.com/u/17489292?v=4","gravatar_id":"","url":"https://api.github.com/users/Repiteo","html_url":"https://github.com/Repiteo","followers_url":"https://api.github.com/users/Repiteo/followers","following_url":"https://api.github.com/users/Repiteo/following{/other_user}","gists_url":"https://api.github.com/users/Repiteo/gists{/gist_id}","starred_url":"https://api.github.com/users/Repiteo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Repiteo/subscriptions","organizations_url":"https://api.github.com/users/Repiteo/orgs","repos_url":"https://api.github.com/users/Repiteo/repos","events_url":"https://api.github.com/users/Repiteo/events{/privacy}","received_events_url":"https://api.github.com/users/Repiteo/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/114559/reactions","total_count":2,"+1":2,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/godotengine/godot/issues/114559/timeline","performed_via_github_app":null,"state_reason":null}