 as a theme item, but you can manipulate the text paragraph objects directly now)","closed_by":{"login":"sockeye-d","id":106356149,"node_id":"U_kgDOBlbdtQ","avatar_url":"https://avatars.githubusercontent.com/u/106356149?v=4","gravatar_id":"","url":"https://api.github.com/users/sockeye-d","html_url":"https://github.com/sockeye-d","followers_url":"https://api.github.com/users/sockeye-d/followers","following_url":"https://api.github.com/users/sockeye-d/following{/other_user}","gists_url":"https://api.github.com/users/sockeye-d/gists{/gist_id}","starred_url":"https://api.github.com/users/sockeye-d/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/sockeye-d/subscriptions","organizations_url":"https://api.github.com/users/sockeye-d/orgs","repos_url":"https://api.github.com/users/sockeye-d/repos","events_url":"https://api.github.com/users/sockeye-d/events{/privacy}","received_events_url":"https://api.github.com/users/sockeye-d/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/112982/reactions","total_count":10,"+1":6,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":4},"timeline_url":"https://api.github.com/repos/godotengine/godot/issues/112982/timeline","performed_via_github_app":null,"state_reason":null}