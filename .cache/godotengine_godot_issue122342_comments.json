[{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5275880984","html_url":"https://github.com/godotengine/godot/issues/122342#issuecomment-5275880984","issue_url":"https://api.github.com/repos/godotengine/godot/issues/122342","id":5275880984,"node_id":"IC_kwDOAO6SJc8AAAABOneOGA","user":{"login":"mukarramarif","id":96686328,"node_id":"U_kgDOBcNQ-A","avatar_url":"https://avatars.githubusercontent.com/u/96686328?v=4","gravatar_id":"","url":"https://api.github.com/users/mukarramarif","html_url":"https://github.com/mukarramarif","followers_url":"https://api.github.com/users/mukarramarif/followers","following_url":"https://api.github.com/users/mukarramarif/following{/other_user}","gists_url":"https://api.github.com/users/mukarramarif/gists{/gist_id}","starred_url":"https://api.github.com/users/mukarramarif/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/mukarramarif/subscriptions","organizations_url":"https://api.github.com/users/mukarramarif/orgs","repos_url":"https://api.github.com/users/mukarramarif/repos","events_url":"https://api.github.com/users/mukarramarif/events{/privacy}","received_events_url":"https://api.github.com/users/mukarramarif/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-08-13T04:14:49Z","updated_at":"2026-08-13T04:14:49Z","body":"Couldn't reproduce in Godot v4.8.dev3.official [[51105cc](https://github.com/godotengine/godot/commit/51105ccbe58381774ecd7a7486d564b202a5192e)]\n\nSystem Info: Windows 11 - Direct3D12, AMD Ryzen 7500F, 9070xt \nCould you provide a recording of the issue?","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5275880984/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5276701567","html_url":"https://github.com/godotengine/godot/issues/122342#issuecomment-5276701567","issue_url":"https://api.github.com/repos/godotengine/godot/issues/122342","id":5276701567,"node_id":"IC_kwDOAO6SJc8AAAABOoQTfw","user":{"login":"mrjustaguy","id":50302479,"node_id":"MDQ6VXNlcjUwMzAyNDc5","avatar_url":"https://avatars.githubusercontent.com/u/50302479?v=4","gravatar_id":"","url":"https://api.github.com/users/mrjustaguy","html_url":"https://github.com/mrjustaguy","followers_url":"https://api.github.com/users/mrjustaguy/followers","following_url":"https://api.github.com/users/mrjustaguy/following{/other_user}","gists_url":"https://api.github.com/users/mrjustaguy/gists{/gist_id}","starred_url":"https://api.github.com/users/mrjustaguy/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/mrjustaguy/subscriptions","organizations_url":"https://api.github.com/users/mrjustaguy/orgs","repos_url":"https://api.github.com/users/mrjustaguy/repos","events_url":"https://api.github.com/users/mrjustaguy/events{/privacy}","received_events_url":"https://api.github.com/users/mrjustaguy/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-08-13T06:19:54Z","updated_at":"2026-08-13T06:19:54Z","body":"This is not a Godot issue, it is a Hardware issue.\n\nAre you Overclocking the CPU or IGPU? if so you're pushing them too much.\nIf not, Run Memory Diagnostic to see if you have faulty memory, and consider dropping the Memory speeds to see if that changes anything.\nAdditionally you could underclock the CPU/IGPU themselves and see how that changes anything.\nI'd also like to know the CPU temps that the system is running at both typical and peak.\n\nIf none of these steps help tho, I'm sorry to say but it's very likely that your hardware is dying","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5276701567/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5278958071","html_url":"https://github.com/godotengine/godot/issues/122342#issuecomment-5278958071","issue_url":"https://api.github.com/repos/godotengine/godot/issues/122342","id":5278958071,"node_id":"IC_kwDOAO6SJc8AAAABOqaB9w","user":{"login":"JuliusDRH","id":148134722,"node_id":"U_kgDOCNRbQg","avatar_url":"https://avatars.githubusercontent.com/u/148134722?v=4","gravatar_id":"","url":"https://api.github.com/users/JuliusDRH","html_url":"https://github.com/JuliusDRH","followers_url":"https://api.github.com/users/JuliusDRH/followers","following_url":"https://api.github.com/users/JuliusDRH/following{/other_user}","gists_url":"https://api.github.com/users/JuliusDRH/gists{/gist_id}","starred_url":"https://api.github.com/users/JuliusDRH/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/JuliusDRH/subscriptions","organizations_url":"https://api.github.com/users/JuliusDRH/orgs","repos_url":"https://api.github.com/users/JuliusDRH/repos","events_url":"https://api.github.com/users/JuliusDRH/events{/privacy}","received_events_url":"https://api.github.com/users/JuliusDRH/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-08-13T10:12:37Z","updated_at":"2026-08-13T10:12:37Z","body":"> This is not a Godot issue, it is a Hardware issue.\n> \n> Are you Overclocking the CPU or IGPU? if so you're pushing them too much.\n> If not, Run Memory Diagnostic to see if you have faulty memory, and consider dropping the Memory speeds to see if that changes anything.\n> Additionally you could underclock the CPU/IGPU themselves and see how that changes anything.\n> I'd also like to know the CPU temps that the system is running at both typical and peak.\n> \n> If none of these steps help tho, I'm sorry to say but it's very likely that your hardware is dying\n\nWell, I thought the same thing, but I'm not overclocking either the CPU or the iGPU, and everything else on my system seems fine. In fact, everything else I've worked on in Godot seems to run perfectly—except for that specific action, which is pretty strange. \n\nI haven't encountered any errors on my PC or in Godot other than that one, but I'll try running a memory diagnostic to see if anything turns up. \n\nSomething very odd is likely going on—and it might not even be related to Godot—but the fact that the error only happens when performing such a specific action (creating a new ShaderMaterial resource) is notable. I'll try a few things I've thought of to find a solution and post an update here if I find anything.\n\n","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5278958071/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5280654454","html_url":"https://github.com/godotengine/godot/issues/122342#issuecomment-5280654454","issue_url":"https://api.github.com/repos/godotengine/godot/issues/122342","id":5280654454,"node_id":"IC_kwDOAO6SJc8AAAABOsBkdg","user":{"login":"JuliusDRH","id":148134722,"node_id":"U_kgDOCNRbQg","avatar_url":"https://avatars.githubusercontent.com/u/148134722?v=4","gravatar_id":"","url":"https://api.github.com/users/JuliusDRH","html_url":"https://github.com/JuliusDRH","followers_url":"https://api.github.com/users/JuliusDRH/followers","following_url":"https://api.github.com/users/JuliusDRH/following{/other_user}","gists_url":"https://api.github.com/users/JuliusDRH/gists{/gist_id}","starred_url":"https://api.github.com/users/JuliusDRH/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/JuliusDRH/subscriptions","organizations_url":"https://api.github.com/users/JuliusDRH/orgs","repos_url":"https://api.github.com/users/JuliusDRH/repos","events_url":"https://api.github.com/users/JuliusDRH/events{/privacy}","received_events_url":"https://api.github.com/users/JuliusDRH/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-08-13T12:51:37Z","updated_at":"2026-08-13T12:53:46Z","body":"(I'm sorry if the text is poorly written; I'm using a translator)\n\nI ran a memory diagnostic, and it found no errors; I checked the drivers and CPU temperature, and everything is fine.\n\nI tried running a test by creating a new project in the oldest version of Godot I have (4.4.1 stable) and updating it to the latest version (4.8 dev3); everything worked fine in every version. However, when I create a project directly in version 4.8 dev3 and perform the procedure, it crashes.\n\nThese are the Godot versions I used for the test:\n\n4.4.1 stable: v4.4.1.stable.official [49a5bc7b6]\n\n4.5 stable: v4.5.stable.official [876b29033]\n\n4.6 stable: v4.6.stable.official [89cea1439]\n\n4.6.3 stable: v4.6.3.stable.official [7d41c59c4]\n\n4.7 stable: v4.7.stable.official [5b4e0cb0f]\n\n4.7.1 rc1: v4.7.1.rc1.official [17e2686e0]\n\n4.7.1 stable: v4.7.1.stable.official [a13da4feb]\n\n4.8 dev3: v4.8.dev3.official [51105ccbe]","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5280654454/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5280702462","html_url":"https://github.com/godotengine/godot/issues/122342#issuecomment-5280702462","issue_url":"https://api.github.com/repos/godotengine/godot/issues/122342","id":5280702462,"node_id":"IC_kwDOAO6SJc8AAAABOsEf_g","user":{"login":"mrjustaguy","id":50302479,"node_id":"MDQ6VXNlcjUwMzAyNDc5","avatar_url":"https://avatars.githubusercontent.com/u/50302479?v=4","gravatar_id":"","url":"https://api.github.com/users/mrjustaguy","html_url":"https://github.com/mrjustaguy","followers_url":"https://api.github.com/users/mrjustaguy/followers","following_url":"https://api.github.com/users/mrjustaguy/following{/other_user}","gists_url":"https://api.github.com/users/mrjustaguy/gists{/gist_id}","starred_url":"https://api.github.com/users/mrjustaguy/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/mrjustaguy/subscriptions","organizations_url":"https://api.github.com/users/mrjustaguy/orgs","repos_url":"https://api.github.com/users/mrjustaguy/repos","events_url":"https://api.github.com/users/mrjustaguy/events{/privacy}","received_events_url":"https://api.github.com/users/mrjustaguy/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-08-13T12:56:18Z","updated_at":"2026-08-13T12:56:18Z","body":"so 4.7.1 is not reproducable?","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5280702462/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5280712146","html_url":"https://github.com/godotengine/godot/issues/122342#issuecomment-5280712146","issue_url":"https://api.github.com/repos/godotengine/godot/issues/122342","id":5280712146,"node_id":"IC_kwDOAO6SJc8AAAABOsFF0g","user":{"login":"JuliusDRH","id":148134722,"node_id":"U_kgDOCNRbQg","avatar_url":"https://avatars.githubusercontent.com/u/148134722?v=4","gravatar_id":"","url":"https://api.github.com/users/JuliusDRH","html_url":"https://github.com/JuliusDRH","followers_url":"https://api.github.com/users/JuliusDRH/followers","following_url":"https://api.github.com/users/JuliusDRH/following{/other_user}","gists_url":"https://api.github.com/users/JuliusDRH/gists{/gist_id}","sta