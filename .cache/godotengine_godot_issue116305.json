zMjQwOTUwMDYw","url":"https://api.github.com/repos/godotengine/godot/labels/performance","name":"performance","color":"447777","default":false,"description":"","archived_at":null,"archived_by":null}],"state":"open","locked":false,"assignees":[],"milestone":{"url":"https://api.github.com/repos/godotengine/godot/milestones/16","html_url":"https://github.com/godotengine/godot/milestone/16","labels_url":"https://api.github.com/repos/godotengine/godot/milestones/16/labels","id":8237783,"node_id":"MI_kwDOAO6SJc4AfbLX","number":16,"title":"4.x","description":"Issues and pull requests slated for an undetermined Godot 4 release.","creator":{"login":"akien-mga","id":4701338,"node_id":"MDQ6VXNlcjQ3MDEzMzg=","avatar_url":"https://avatars.githubusercontent.com/u/4701338?v=4","gravatar_id":"","url":"https://api.github.com/users/akien-mga","html_url":"https://github.com/akien-mga","followers_url":"https://api.github.com/users/akien-mga/followers","following_url":"https://api.github.com/users/akien-mga/following{/other_user}","gists_url":"https://api.github.com/users/akien-mga/gists{/gist_id}","starred_url":"https://api.github.com/users/akien-mga/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/akien-mga/subscriptions","organizations_url":"https://api.github.com/users/akien-mga/orgs","repos_url":"https://api.github.com/users/akien-mga/repos","events_url":"https://api.github.com/users/akien-mga/events{/privacy}","received_events_url":"https://api.github.com/users/akien-mga/received_events","type":"User","user_view_type":"public","site_admin":false},"open_issues":5791,"closed_issues":0,"state":"open","created_at":"2022-07-26T12:42:05Z","updated_at":"2026-10-21T22:40:26Z","due_on":null,"closed_at":null},"comments":19,"created_at":"2026-02-15T06:10:46Z","updated_at":"2026-04-12T23:55:16Z","closed_at":null,"assignee":null,"author_association":"NONE","issue_field_values":[],"type":null,"active_lock_reason":null,"draft":true,"pull_request":{"url":"https://api.github.com/repos/godotengine/godot/pulls/116305","html_url":"https://github.com/godotengine/godot/pull/116305","diff_url":"https://github.com/godotengine/godot/pull/116305.diff","patch_url":"https://github.com/godotengine/godot/pull/116305.patch","merged_at":null},"body":"Fixes #89217\r\n\r\nThis PR builds on rookeee's work. It is almost entirely done on the C# side of Godot with the only exception being the C++ source code (\"glue code\") generator.\r\n\r\n- Vastly improve interop performance (up to ~10x in Editor mode!)\r\n- No unsafe code (`unsafe` keyword, but pretty safe `Unsafe.*` methods)\r\n- Non-invasive changes\r\n- ScriptMethodRegistry for registering and resolving methods (`ScriptMethodRegistry`)\r\n- Specialized method lookup cache with almost all method lookups being O(1) (`ScriptMethodCache`)\r\n- Added `scoped` and ìn` keywords where appropriate to guide the compiler to apply optimizations\r\n\r\nFuture:\r\n- Only instance methods for now, but static methods, getter/setter and signals should be easily extendable once the PR is considered to get accepted\r\n\r\n## Performance Uplift\r\nGenerally, running in the editor costs about 10% performance. But regardless, with this changes working with debug builds and/or running from the editor is not slow anymore!\r\n\r\n### PerformanceTestMRP_Godot4.5\r\n#### Game unoptimized, GodotSharp unoptimized\r\n100 buttons: 2030/1ms\r\n<img width=\"1326\" height=\"1041\" alt=\"grafik\" src=\"https://github.com/user-attachments/assets/2e6c175a-e825-4456-9fde-538f7a3decda\" />\r\n\r\n10000 buttons: 180FPS/8ms\r\n<img width=\"1368\" height=\"1041\" alt=\"grafik\" src=\"https://github.com/user-attachments/assets/64f40512-576f-4e8d-aff8-34a6bf978133\" />\r\n\r\nCompare that to vanilla 4.6 (10000 buttons): 18FPS/50ms!\r\n<img width=\"1248\" height=\"1041\" alt=\"grafik\" src=\"https://github.com/user-attachments/assets/aaf0f90e-17d6-4848-b834-8e3c49e70097\" />\r\n\r\n\r\n\r\n#### Game optimized, GodotSharp optimized\r\n100 Buttons: no change\r\n\r\n10000 Buttons: 400FPS/4ms\r\n<img width=\"1335\" height=\"1017\" alt=\"grafik\" src=\"https://github.com/user-attachments/assets/bcaa7bc7-dc0c-403e-b2ef-f56d4b0b7258\" />\r\n\r\n### test_mono_method_cache\r\n1000 elements: 1800FPS/3ms\r\n<img width=\"1212\" height=\"1023\" alt=\"grafik\" src=\"https://github.com/user-attachments/assets/d89ef097-2b18-40ab-b4ee-46363dd9f1a7\" />\r\n","closed_by":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/116305/reactions","total_count":41,"+1":5,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":26,"eyes":10},"timeline_url":"https://api.github.com/repos/godotengine/godot/issues/116305/timeline","performed_via_github_app":null,"state_reason":null}