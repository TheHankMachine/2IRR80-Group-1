raft":true,"pull_request":{"url":"https://api.github.com/repos/godotengine/godot/pulls/99916","html_url":"https://github.com/godotengine/godot/pull/99916","diff_url":"https://github.com/godotengine/godot/pull/99916.diff","patch_url":"https://github.com/godotengine/godot/pull/99916.patch","merged_at":null},"body":"This PR adds a VRS mode that builds the density map fully in our shader. No data needs to be calculated on the CPU and transferred to the GPU. This removes a lot of overhead and will allow us to more easily adjust the density map based on performance metrics.\r\n\r\nIdeally we deprecate `VRS_XR` in favour of this once its completed.\r\n\r\nStill todo:\r\n- [ ] Detect changes and skip drawing if nothing changed from previous update.\r\n- [ ] Add settings that allow control by the developer (ranges for mix/max radii). \r\n- [ ] Figure out a way to vary the radii based on current performance metrics.\r\n\r\nNote: Build on top of #99551","closed_by":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/99916/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/godotengine/godot/issues/99916/timeline","performed_via_github_app":null,"state_reason":null}