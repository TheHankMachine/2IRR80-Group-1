, String() });\n\t\t\t\tcontinue;\n\t\t\t}\n\t\t\tif (GetVolumeInformationW((LPCWSTR)cs.get_data(), (LPWSTR)wlabel, 4096, nullptr, nullptr, nullptr, nullptr, 0)) {\n```\n\nTo avoid unnecessary duplicate UTF-16 conversion.\n\nIn the FileDialog interface, name it is displayed as `X: (Name)`, so `[network]` will show with nested brackets. So it should be either empty string (will show as `X:`), or `Network`.","created_at":"2026-07-07T06:48:57Z","updated_at":"2026-07-07T07:43:43Z","html_url":"https://github.com/godotengine/godot/pull/120666#discussion_r3534241578","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/120666","_links":{"self":{"href":"https://api.github.com/repos/godotengine/godot/pulls/comments/3534241578"},"html":{"href":"https://github.com/godotengine/godot/pull/120666#discussion_r3534241578"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/120666"}},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/3534241578/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":146,"original_start_line":146,"start_side":"RIGHT","line":152,"original_line":152,"side":"RIGHT","author_association":"MEMBER","original_position":10,"position":10,"subject_type":"line"},{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/3538843151","pull_request_review_id":4647958317,"id":3538843151,"node_id":"PRRC_kwDOAO6SJc7S7nYP","diff_hunk":"@@ -143,6 +143,11 @@ void DirAccessWindows::_update_drives() {\n \t\t\tString drive = String::chr('A' + i) + ':';\n \t\t\tString path = drive + '\\\\';\n \t\t\tString label;\n+\t\t\tUINT type = GetDriveTypeW((LPCWSTR)(path).utf16().get_data());\n+\t\t\tif (type == DRIVE_REMOTE) {\n+\t\t\t\tdrives.push_back(DriveInfo{ drive, \"[network]\" });\n+\t\t\t\tcontinue;\n+\t\t\t}\n \t\t\tchar16_t wlabel[4096];\n \t\t\tif (GetVolumeInformationW((LPCWSTR)(path).utf16().get_data(), (LPWSTR)wlabel, 409