rm:windows","color":"e4e4e4","default":false,"description":"","archived_at":null,"archived_by":null},{"id":279098009,"node_id":"MDU6TGFiZWwyNzkwOTgwMDk=","url":"https://api.github.com/repos/godotengine/godot/labels/topic:buildsystem","name":"topic:buildsystem","color":"ffee88","default":false,"description":"","archived_at":null,"archived_by":null},{"id":279098255,"node_id":"MDU6TGFiZWwyNzkwOTgyNTU=","url":"https://api.github.com/repos/godotengine/godot/labels/topic:platforms","name":"topic:platforms","color":"ffee88","default":false,"description":"","archived_at":null,"archived_by":null}],"state":"closed","locked":false,"assignees":[],"milestone":{"url":"https://api.github.com/repos/godotengine/godot/milestones/25","html_url":"https://github.com/godotengine/godot/milestone/25","labels_url":"https://api.github.com/repos/godotengine/godot/milestones/25/labels","id":15520464,"node_id":"MI_kwDOAO6SJc4A7NLQ","number":25,"title":"4.8","description":"","creator":{"login":"Repiteo","id":17489292,"node_id":"MDQ6VXNlcjE3NDg5Mjky","avatar_url":"https://avatars.githubusercontent.com/u/17489292?v=4","gravatar_id":"","url":"https://api.github.com/users/Repiteo","html_url":"https://github.com/Repiteo","followers_url":"https://api.github.com/users/Repiteo/followers","following_url":"https://api.github.com/users/Repiteo/following{/other_user}","gists_url":"https://api.github.com/users/Repiteo/gists{/gist_id}","starred_url":"https://api.github.com/users/Repiteo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Repiteo/subscriptions","organizations_url":"https://api.github.com/users/Repiteo/orgs","repos_url":"https://api.github.com/users/Repiteo/repos","events_url":"https://api.github.com/users/Repiteo/events{/privacy}","received_events_url":"https://api.github.com/users/Repiteo/received_events","type":"User","user_view_type":"public","site_admin":false},"open_issues":346,"closed_issues":2304,"state":"open","created_at":"2026-04-13T15:59:35Z","updated_at":"2026-10-21T09:34:58Z","due_on":null,"closed_at":null},"comments":6,"created_at":"2025-11-27T09:43:16Z","updated_at":"2026-06-23T14:23:45Z","closed_at":"2026-06-23T12:02:21Z","assignee":null,"author_association":"CONTRIBUTOR","issue_field_values":[],"type":null,"active_lock_reason":null,"draft":false,"pull_request":{"url":"https://api.github.com/repos/godotengine/godot/pulls/113225","html_url":"https://github.com/godotengine/godot/pull/113225","diff_url":"https://github.com/godotengine/godot/pull/113225.diff","patch_url":"https://github.com/godotengine/godot/pull/113225.patch","merged_at":"2026-06-23T12:02:21Z"},"body":"Currently, Godot always exports `NvOptimusEnablement` and `AmdPowerXpressRequestHighPerformance` symbols on Windows, forcing the use of  discrete GPU on hybrid graphics systems when using OpenGL/GLES.\r\n\r\nThis change adds a build-time option to disable these symbols, allowing applications to respect OS and driver settings instead. This is useful for:\r\n- Laptop users wanting to save battery\r\n- Non-game applications (desktop pets, tools, etc.)\r\n- Projects that don't require high GPU performance\r\n\r\nThe default behavior is unchanged (`prefer_high_performance_gpu=yes`), preserving backward compatibility.\r\n\r\nUsage:\r\n```bash\r\n# Respect system GPU preferences (disable the hardcoded symbols)\r\nscons platform=windows prefer_high_performance_gpu=no\r\n\r\n# Default behavior (equivalent to current hardcoded behavior)\r\nscons platform=windows prefer_high_performance_gpu=yes\r\n```\r\n\r\nNote: Vulkan backend already supports runtime GPU selection via command-line arguments and is not affected by this change.","closed_by":{"login":"Repiteo","id":17489292,"node_id":"MDQ6VXNlcjE3NDg5Mjky","avatar_url":"https://avatars.githubusercontent.com/u/17489292?v=4","gravatar_id":"","url":"https://api.github.com/users/Repiteo","html_url":"https://github.com/Repiteo","followers_url":"https://api.github.com/users/Repiteo/followers","following_url":"https://api.github.com/users/Repiteo/following{/other_user}","gists_url":"https://api.github.com/users/Repiteo/gists{/gist_id}","starred_url":"https://api.github.com/users/Repiteo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Repiteo/subscriptions","organizations_url":"https://api.github.com/users/Repiteo/orgs","repos_url":"https://api.github.com/users/Repiteo/repos","events_url":"https://api.github.com/users/Repiteo/events{/privacy}","received_events_url":"https://api.github.com/users/Repiteo/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/113225/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/godotengine/godot/issues/113225/timeline","performed_via_github_app":null,"state_reason":null}