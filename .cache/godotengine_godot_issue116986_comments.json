{/gist_id}","starred_url":"https://api.github.com/users/nikitalita/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/nikitalita/subscriptions","organizations_url":"https://api.github.com/users/nikitalita/orgs","repos_url":"https://api.github.com/users/nikitalita/repos","events_url":"https://api.github.com/users/nikitalita/events{/privacy}","received_events_url":"https://api.github.com/users/nikitalita/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-05-10T08:10:08Z","updated_at":"2026-05-10T08:12:12Z","body":"Doesn't this require the bytecode version being bumped? Binary scripts of previous versions will no longer parse correctly due to this, the column numbers will be wrong and would lead to parsing errors.","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4414805267/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4414853530","html_url":"https://github.com/godotengine/godot/pull/116986#issuecomment-4414853530","issue_url":"https://api.github.com/repos/godotengine/godot/issues/116986","id":4414853530,"node_id":"IC_kwDOAO6SJc8AAAABByVRmg","user":{"login":"HolonProduction","id":99511741,"node_id":"U_kgDOBe5tvQ","avatar_url":"https://avatars.githubusercontent.com/u/99511741?v=4","gravatar_id":"","url":"https://api.github.com/users/HolonProduction","html_url":"https://github.com/HolonProduction","followers_url":"https://api.github.com/users/HolonProduction/followers","following_url":"https://api.github.com/users/HolonProduction/following{/other_user}","gists_url":"https://api.github.com/users/HolonProduction/gists{/gist_id}","starred_url":"https://api.github.com/users/HolonProduction/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/