_lock_reason":null,"draft":false,"pull_request":{"url":"https://api.github.com/repos/godotengine/godot/pulls/110058","html_url":"https://github.com/godotengine/godot/pull/110058","diff_url":"https://github.com/godotengine/godot/pull/110058.diff","patch_url":"https://github.com/godotengine/godot/pull/110058.patch","merged_at":"2025-09-30T23:39:00Z"},"body":"The current implementation for `Image::blit_rect` does a per-channel single pixel blit operation which, in particularly slow hardware, can be extremely expensive. The function itself assumes as a pre-condition that source and destination image formats are the same, which means we can take advantage of this to perform, as worst case scenario, a per line copy instead and, in cases in which the copy region is completely aligned and width between source, destination and blit region are the same, a single memcpy can be used instead.","closed_by":{"login":"Repiteo","id":17489292,"node_id":"MDQ6VXNlcjE3NDg5Mjky","avatar_url":"https://avatars.githubusercontent.com/u/17489292?v=4","gravatar_id":"","url":"https://api.github.com/users/Repiteo","html_url":"https://github.com/Repiteo","followers_url":"https://api.github.com/users/Repiteo/followers","following_url":"https://api.github.com/users/Repiteo/following{/other_user}","gists_url":"https://api.github.com/users/Repiteo/gists{/gist_id}","starred_url":"https://api.github.com/users/Repiteo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Repiteo/subscriptions","organizations_url":"https://api.github.com/users/Repiteo/orgs","repos_url":"https://api.github.com/users/Repiteo/repos","events_url":"https://api.github.com/users/Repiteo/events{/privacy}","received_events_url":"https://api.github.com/users/Repiteo/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/110058/reactions","total_count":4,"+1":2,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocke