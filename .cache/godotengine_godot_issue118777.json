:35Z"},"comments":6,"created_at":"2026-04-20T12:49:59Z","updated_at":"2026-04-23T13:45:14Z","closed_at":"2026-04-23T13:40:50Z","assignee":null,"author_association":"CONTRIBUTOR","issue_field_values":[],"type":null,"active_lock_reason":null,"draft":false,"pull_request":{"url":"https://api.github.com/repos/godotengine/godot/pulls/118777","html_url":"https://github.com/godotengine/godot/pull/118777","diff_url":"https://github.com/godotengine/godot/pull/118777.diff","patch_url":"https://github.com/godotengine/godot/pull/118777.patch","merged_at":"2026-04-23T13:40:50Z"},"body":"This PR just aims to make it possible to build `proxy_to_pthread` again and it does 2 changes to make possible:\r\n- Removes `-sTEXTDECODER=0`, if we search for the [PR number](https://github.com/emscripten-core/emscripten/issues/18034#issuecomment-3074897173) that was linked as fixing this issue in the full changes we can see that it got fixed in 3.1.72.\r\n<img width=\"1343\" height=\"551\" alt=\"image\" src=\"https://github.com/user-attachments/assets/954e992b-67de-4d76-bfb3-9c0f5f6735d7\" />\r\n \r\nAnd the support for it itself was removed in [4.0.12](https://github.com/emscripten-core/emscripten/pull/24700), so in this and newer versions it errors.\r\n<img width=\"1034\" height=\"340\" alt=\"image\" src=\"https://github.com/user-attachments/assets/05c44763-af52-4ea8-84bd-ddefeb591bb2\" />\r\n\r\n- Removes `_emscripten_proxy_main`. I tried to build godot with it in both 4.0.0 and 5.0.4, but emscripten complained about undefined exported symbol, and after removing it godot was build successfully.\r\n\r\nSeeing as minimum supported emscripten version(4.0.0) can work without these flags I didn't implement any version based differences and just removed them directly.","closed_by":{"login":"Repiteo","id":17489292,"node_id":"MDQ6VXNlcjE3NDg5Mjky","avatar_url":"https://avatars.githubusercontent.com/u/17489292?v=4","gravatar_id":"","url":"https://api.github.com/users/Repiteo","html_url":"https://github.com/Repiteo","followers_url":"https://api.github.com/users/Repiteo/followers","following_url":"https://api.github.com/users/Repiteo/following{/other_user}","gists_url":"https://api.github.com/users/Repiteo/gists{/gist_id}","starred_url":"https://api.github.com/users/Repiteo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Repiteo/subscriptions","organizations_url":"https://api.github.com/users/Repiteo/orgs","repos_url":"https://api.github.com/users/Repiteo/repos","events_url":"https://api.github.com/users/Repiteo/events{/privacy}","received_events_url":"https://api.github.com/users/Repiteo/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/118777/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/godotengine/godot/issues/118777/timeline","performed_via_github_app":null,"state_reason":null}