ub.com/users/sjl057/events{/privacy}","received_events_url":"https://api.github.com/users/sjl057/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-01-18T15:51:14Z","updated_at":"2026-01-18T15:51:14Z","body":"Title updated","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3765430033/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3765441263","html_url":"https://github.com/godotengine/godot/issues/115080#issuecomment-3765441263","issue_url":"https://api.github.com/repos/godotengine/godot/issues/115080","id":3765441263,"node_id":"IC_kwDOAO6SJc7gcBLv","user":{"login":"dalexeev","id":47700418,"node_id":"MDQ6VXNlcjQ3NzAwNDE4","avatar_url":"https://avatars.githubusercontent.com/u/47700418?v=4","gravatar_id":"","url":"https://api.github.com/users/dalexeev","html_url":"https://github.com/dalexeev","followers_url":"https://api.github.com/users/dalexeev/followers","following_url":"https://api.github.com/users/dalexeev/following{/other_user}","gists_url":"https://api.github.com/users/dalexeev/gists{/gist_id}","starred_url":"https://api.github.com/users/dalexeev/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/dalexeev/subscriptions","organizations_url":"https://api.github.com/users/dalexeev/orgs","repos_url":"https://api.github.com/users/dalexeev/repos","events_url":"https://api.github.com/users/dalexeev/events{/privacy}","received_events_url":"https://api.github.com/users/dalexeev/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-01-18T16:03:29Z","updated_at":"2026-01-18T16:03:29Z","body":"Probably a duplicate of the following issues:\n\n* https://github.com/godotengine/godot/issues/6784\n* https://github.com/godotengine/godot/issues/31166\n* https://github.com/godotengine/godot/issues/80834\n* https://github.com/godotengine/godot/issues/87151","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3765441263/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3765465795","html_url":"https://github.com/godotengine/godot/issues/115080#issuecomment-3765465795","issue_url":"https://api.github.com/repos/godotengine/godot/issues/115080","id":3765465795,"node_id":"IC_kwDOAO6SJc7gcHLD","user":{"login":"dalexeev","id":47700418,"node_id":"MDQ6VXNlcjQ3NzAwNDE4","avatar_url":"https://avatars.githubusercontent.com/u/47700418?v=4","gravatar_id":"","url":"https://api.github.com/users/dalexeev","html_url":"https://github.com/dalexeev","followers_url":"https://api.github.com/users/dalexeev/followers","following_url":"https://api.github.com/users/dalexeev/following{/other_user}","gists_url":"https://api.github.com/users/dalexeev/gists{/gist_id}","starred_url":"https://api.github.com/users/dalexeev/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/dalexeev/subscriptions","organizations_url":"https://api.github.com/users/dalexeev/orgs","repos_url":"https://api.github.com/users/dalexeev/repos","events_url":"https://api.github.com/users/dalexeev/events{/privacy}","received_events_url":"https://api.github.com/users/dalexeev/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-01-18T16:28:43Z","updated_at":"2026-01-18T16:28:43Z","body":"Yes, it looks like this is a duplicate of #6784. This is a long-running bug that we'd like to fix, but it's difficult both practically (requires a deep understanding of the core that few contributors have) and conceptually (`_notification(NOTIFICATION_PREDELETE)` is called when the reference count has already reached zero and shouldn't be incremented again, new references shouldn't leak outside the `_notification(NOTIFICATION_PREDELETE)` call).\n\nYou could try asking in the [#core](https://chat.godotengine.org/channel/core) channel, but I think we should close this issue as a duplicate for consolidation. Thanks for reporting this bug anyway!\n\n```gdscript\nclass Test extends RefCounted:\n    const NOTIFICATION_CUSTOM := 1000\n\n    func _notification(what: int) -> void:\n        prints(self, what)\n\nfunc _run() -> void:\n    var test := Test.new()\n    test.notification(Test.NOTIFICATION_CUSTOM)\n```\n\nPrints:\n\n```\n<RefCounted#-9223367918383706290> 1000\n<Object#null> 1\n<Object#null> 3\n```","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3765465795/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3765468457","html_url":"https://github.com/godotengine/godot/issues/115080#issuecomment-3765468457","issue_url":"https://api.github.com/repos/godotengine/godot/issues/115080","id":3765468457,"node_id":"IC_kwDOAO6SJc7gcH0p","user":{"login":"sjl057","id":8219159,"node_id":"MDQ6VXNlcjgyMTkxNTk=","avatar_url":"https://avatars.githubusercontent.com/u/8219159?v=4","gravatar_id":"","url":"https://api.github.com/users/sjl057","html_url":"https://github.com/sjl057","followers_url":"https://api.github.com/users/sjl057/followers","following_url":"https://api.github.com/users/sjl057/following{/other_user}","gists_url":"https://api.github.com/users/sjl057/gists{/gist_id}","starred_url":"https://api.github.com/users/sjl057/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/sjl057/subscriptions","organizations_url":"https://api.github.com/users/sjl057/orgs","repos_url":"https://api.github.com/users/sjl057/repos","events_url":"https://api.github.com/users/sjl057/events{/privacy}","received_events_url":"https://api.github.com/users/sjl057/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-01-18T16:31:03Z","updated_at":"2026-01-18T16:31:03Z","body":"thanks for looking into it!","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3765468457/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null}]