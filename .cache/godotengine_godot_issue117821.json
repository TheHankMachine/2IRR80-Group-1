fee88","default":false,"description":"","archived_at":null,"archived_by":null},{"id":1327318271,"node_id":"MDU6TGFiZWwxMzI3MzE4Mjcx","url":"https://api.github.com/repos/godotengine/godot/labels/crash","name":"crash","color":"885544","default":false,"description":"","archived_at":null,"archived_by":null},{"id":2231593685,"node_id":"MDU6TGFiZWwyMjMxNTkzNjg1","url":"https://api.github.com/repos/godotengine/godot/labels/topic:tests","name":"topic:tests","color":"ffee88","default":false,"description":"","archived_at":null,"archived_by":null}],"state":"closed","locked":false,"assignees":[],"milestone":{"url":"https://api.github.com/repos/godotengine/godot/milestones/25","html_url":"https://github.com/godotengine/godot/milestone/25","labels_url":"https://api.github.com/repos/godotengine/godot/milestones/25/labels","id":15520464,"node_id":"MI_kwDOAO6SJc4A7NLQ","number":25,"title":"4.8","description":"","creator":{"login":"Repiteo","id":17489292,"node_id":"MDQ6VXNlcjE3NDg5Mjky","avatar_url":"https://avatars.githubusercontent.com/u/17489292?v=4","gravatar_id":"","url":"https://api.github.com/users/Repiteo","html_url":"https://github.com/Repiteo","followers_url":"https://api.github.com/users/Repiteo/followers","following_url":"https://api.github.com/users/Repiteo/following{/other_user}","gists_url":"https://api.github.com/users/Repiteo/gists{/gist_id}","starred_url":"https://api.github.com/users/Repiteo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Repiteo/subscriptions","organizations_url":"https://api.github.com/users/Repiteo/orgs","repos_url":"https://api.github.com/users/Repiteo/repos","events_url":"https://api.github.com/users/Repiteo/events{/privacy}","received_events_url":"https://api.github.com/users/Repiteo/received_events","type":"User","user_view_type":"public","site_admin":false},"open_issues":341,"closed_issues":2335,"state":"open","created_at":"2026-04-13T15:59:35Z","updated_at":"2026-10-22T03:07:42Z","due_on":null,"closed_at":null},"comments":1,"created_at":"2026-03-25T11:49:29Z","updated_at":"2026-09-29T21:14:42Z","closed_at":"2026-09-29T19:11:39Z","assignee":null,"author_association":"MEMBER","issue_field_values":[],"type":null,"active_lock_reason":null,"draft":false,"pull_request":{"url":"https://api.github.com/repos/godotengine/godot/pulls/117821","html_url":"https://github.com/godotengine/godot/pull/117821","diff_url":"https://github.com/godotengine/godot/pull/117821.diff","patch_url":"https://github.com/godotengine/godot/pull/117821.patch","merged_at":"2026-09-29T19:11:39Z"},"body":"# What problems does this solve?\r\n\r\n- Unblocks https://github.com/godotengine/godot/pull/116938\r\n- Fixes https://github.com/godotengine/godot/issues/121901 (as confirmed on RC)\r\n- Fixes https://github.com/godotengine/godot/issues/92676\r\n- Supersedes and closes https://github.com/godotengine/godot/pull/92951\r\n\r\n# More information\r\n_Original description, from before the template:_\r\n\r\nhttps://github.com/godotengine/godot/pull/116938 adds a test which uses a non relative path. This works when running the tests, however when generating output this would fail, because we do not initialize the language in the same way when generating tests.\r\n\r\nThe reason for that, is that the cmd option for generating tests is handled in the language initialization. So if we tried to init the language when generating tests we would run into an infinite recursion.\r\n\r\nThis PR moves the entrypoint for generating test output to use `REGISTER_TEST_COMMAND`, so we can always run the language initialization.\r\n\r\nAs a result the cmd option changed from `--gdscript-generate-tests` to `--test gdscript-generate-tests`. This only effects developers, I also added an error message when using the old option. So I don't consider this compat breaking.\r\n\r\nAccompanying docs PR: https://github.com/godotengine/godot-docs/pull/11874\r\n","closed_by":{"login":"Repiteo","id":17489292,"node_id":"MDQ6VXNlcjE3NDg5Mjky","avatar_url":"https://avatars.githubusercontent.com/u/17489292?v=4","gravatar_id":"","url":"https://api.github.com/users/Repiteo","html_url":"https://github.com/Repiteo","followers_url":"https://api.github.com/users/Repiteo/followers","following_url":"https://api.github.com/users/Repiteo/following{/other_user}","gists_url":"https://api.github.com/users/Repiteo/gists{/gist_id}","starred_url":"https://api.github.com/users/Repiteo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Repiteo/subscriptions","organizations_url":"https://api.github.com/users/Repiteo/orgs","repos_url":"https://api.github.com/users/Repiteo/repos","events_url":"https://api.github.com/users/Repiteo/events{/privacy}","received_events_url":"https://api.github.com/users/Repiteo/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/117821/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/godotengine/godot/issues/117821/timeline","performed_via_github_app":null,"state_reason":null}