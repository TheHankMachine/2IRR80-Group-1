 so it's capable as a stack. It will be used to replace `List` based stack in following PR.","closed_by":{"login":"YYF233333","id":67693830,"node_id":"MDQ6VXNlcjY3NjkzODMw","avatar_url":"https://avatars.githubusercontent.com/u/67693830?v=4","gravatar_id":"","url":"https://api.github.com/users/YYF233333","html_url":"https://github.com/YYF233333","followers_url":"https://api.github.com/users/YYF233333/followers","following_url":"https://api.github.com/users/YYF233333/following{/other_user}","gists_url":"https://api.github.com/users/YYF233333/gists{/gist_id}","starred_url":"https://api.github.com/users/YYF233333/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/YYF233333/subscriptions","organizations_url":"https://api.github.com/users/YYF233333/orgs","repos_url":"https://api.github.com/users/YYF233333/repos","events_url":"https://api.github.com/users/YYF233333/events{/privacy}","received_events_url":"https://api.github.com/users/YYF233333/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/99955/reactions","total_count":2,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":2},"timeline_url":"https://api.github.com/repos/godotengine/godot/issues/99955/timeline","performed_via_github_app":null,"state_reason":null}