.com/users/yikescloud/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-07-04T19:27:02Z","updated_at":"2026-07-04T19:29:19Z","body":"Seems Godot 4 Gles3 seems still noticeable, but not much as vulkan.\nGodot 3 Gles3 | Godot 3 Gles2 | Godot 4 GLcompatible | Godot 4 Vulkan\n| ---- | ---- | ---- | ---- |\n<img width=\"695\" height=\"514\" alt=\"Image\" src=\"https://github.com/user-attachments/assets/e8e03260-6869-4b1f-b427-45fb5ff2bb84\" /> | <img width=\"636\" height=\"507\" alt=\"Image\" src=\"https://github.com/user-attachments/assets/1c733aff-583a-473b-ad58-c59d2e863d1f\" /> | <img width=\"598\" height=\"476\" alt=\"Image\" src=\"https://github.com/user-attachments/assets/c4801530-dc5a-4f9a-8530-e8b145ef6fbf\" /> | <img width=\"650\" height=\"453\" alt=\"Image\" src=\"https://github.com/user-attachments/assets/5bced741-2684-443f-a2f8-ec9f0ec97192\" />","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4883555700/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4884221336","html_url":"https://github.com/godotengine/godot/issues/120872#issuecomment-4884221336","issue_url":"https://api.github.com/repos/godotengine/godot/issues/120872","id":4884221336,"node_id":"IC_kwDOAO6SJc8AAAABIx9NmA","user":{"login":"hypotensor","id":184009339,"node_id":"U_kgDOCvfCew","avatar_url":"https://avatars.githubusercontent.com/u/184009339?v=4","gravatar_id":"","url":"https://api.github.com/users/hypotensor","html_url":"https://github.com/hypotensor","followers_url":"https://api.github.com/users/hypotensor/followers","following_url":"https://api.github.com/users/hypotensor/following{/other_user}","gists_url":"https://api.github.com/users/hypotensor/gists{/gist_id}","starred_url":"https://api.github.com/users/hypotensor/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/hypotensor/subscriptions","organizations_url":"https://api.github.com/users/hypotensor/orgs","repos_url":"https://api.github.com/users/hypotensor/repos","events_url":"https://api.github.com/users/hypotensor/events{/privacy}","received_events_url":"https://api.github.com/users/hypotensor/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-07-05T00:10:05Z","updated_at":"2026-07-05T00:10:05Z","body":"If you need a workaround to this, TAA effectively mitigates this issue. FXAA and SMAA partially mitigate it, so consider SMAA if you were previously only using MSAA.","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4884221336/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4884466803","html_url":"https://github.com/godotengine/godot/issues/120872#issuecomment-4884466803","issue_url":"https://api.github.com/repos/godotengine/godot/issues/120872","id":4884466803,"node_id":"IC_kwDOAO6SJc8AAAABIyMMcw","user":{"login":"zedrun00","id":104408400,"node_id":"U_kgDOBjklUA","avatar_url":"https://avatars.githubusercontent.com/u/104408400?v=4","gravatar_id":"","url":"https://api.github.com/users/zedrun00","html_url":"https://github.com/zedrun00","followers_url":"https://api.github.com/users/zedrun00/followers","following_url":"https://api.github.com/users/zedrun00/following{/other_user}","gists_url":"https://api.github.com/users/zedrun00/gists{/gist_id}","starred_url":"https://api.github.com/users/zedrun00/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/zedrun00/subscriptions","organizations_url":"https://api.github.com/users/zedrun00/orgs","repos_url":"https://api.github.com/users/zedrun00/repos","events_url":"https://api.github.com/users/zedrun00/events{/privacy}","received_events_url":"https://api.github.com/users/zedrun00/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-07-05T01:53:56Z","updated_at":"2026-07-05T01:53:56Z","body":"> If you need a workaround to this, TAA effectively mitigates this issue. FXAA and SMAA partially mitigate it, so consider SMAA if you were previously only using MSAA.\n\nBut why is this bug? I can’t figure it out.\n","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4884466803/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4885775966","html_url":"https://github.com/godotengine/godot/issues/120872#issuecomment-4885775966","issue_url":"https://api.github.com/repos/godotengine/godot/issues/120872","id":4885775966,"node_id":"IC_kwDOAO6SJc8AAAABIzcGXg","user":{"login":"mrjustaguy","id":50302479,"node_id":"MDQ6VXNlcjUwMzAyNDc5","avatar_url":"https://avatars.githubusercontent.com/u/50302479?v=4","gravatar_id":"","url":"https://api.github.com/users/mrjustaguy","html_url":"https://github.com/mrjustaguy","followers_url":"https://api.github.com/users/mrjustaguy/followers","following_url":"https://api.github.com/users/mrjustaguy/following{/other_user}","gists_url":"https://api.github.com/users/mrjustaguy/gists{/gist_id}","starred_url":"https://api.github.com/users/mrjustaguy/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/mrjustaguy/subscriptions","organizations_url":"https://api.github.com/users/mrjustaguy/orgs","repos_url":"https://api.github.com/users/mrjustaguy/repos","events_url":"https://api.github.com/users/mrjustaguy/events{/privacy}","received_events_url":"https://api.github.com/users/mrjustaguy/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-07-05T11:07:18Z","updated_at":"2026-07-05T11:07:18Z","body":"Godot's TAA isn't good, so it's not a solution to this problem. SMAA is the only option or using custom anti-firefly filters (which mind you are fairly simple to make so...)","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4885775966/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4893433195","html_url":"https://github.com/godotengine/godot/issues/120872#issuecomment-4893433195","issue_url":"https://api.github.com/repos/godotengine/godot/issues/120872","id":4893433195,"node_id":"IC_kwDOAO6SJc8AAAABI6vdaw","user":{"login":"LXK97","id":25954563,"node_id":"MDQ6VXNlcjI1OTU0NTYz","avatar_url":"https://avatars.githubusercontent.com/u/25954563?v=4","gravatar_id":"","url":"https://api.github.com/users/LXK97","html_url":"https://github.com/LXK97","followers_url":"https://api.github.com/users/LXK97/followers","following_url":"https://api.github.com/users/LXK97/following{/other_user}","gists_url":"https://api.github.com/users/LXK97/gists{/gist_id}","starred_url":"https://api.github.com/users/LXK97/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/LXK97/subscriptions","organizations_url":"https://api.github.com/users/LXK97/orgs","repos_url":"https://api.github.com/users/LXK97/repos","events_url":"https://api.github.com/users/LXK97/events{/privacy}","received_events_url":"https://api.github.com/users/LXK97/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-07-06T13:36:21Z","updated_at":"2026-07-06T14:23:49Z","body":"The root casue is roughness limiter.\n\n<img width=\"1920\" height=\"681\" alt=\"Image\" src=\"https://github.com/user-attachments/assets/3b642567-d514-445f-88a2-8eca70f1c8c5\" />\n\n<img width=\"1920\" height=\"678\" alt=\"Image\" src=\"https://github.com/user-attachments/assets/44ef43d6-c389-41b1-a1d6-fbe64e259bb2\" />\nIn shader, ddx(normal) and ddy(normal) make large roughness in grazing angle, so direct specular value go large too. I think amount and limit can deviate this situation.","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4893433195/reactions","total_count":2,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":2},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4894558460","html_url":"https://github.com/godotengine/godot/issues/120872#issuecomment-4894558460","issue_url":"https://api.github.com/repos/godotengine/godot/issues/120872","id":4894558460,"node_id":"IC_kwDOAO6SJc8AAAABI70I_A","user":{"login":"mrjustaguy","id":50302479,"node_id":"MDQ6VXNlcjUwMzAyNDc5","avatar_url":"https://avatars.githubusercontent.com/u/50302479?v=4","gravatar_id":"","url":"https://api.github.com/users/mrjustaguy","html_url":"https://github.com/mrjustaguy","followers_url":"https://api.github.com/users/mrjustaguy/followers","following_url":"https://api.github.com/users/mrjustaguy/following{/other_user}","gists_url":"https://api.github.com/users/mrjustaguy/gists{/gist_id}","starred_url":"https://api.github.com/users/mrjustaguy/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/mrjustaguy/subscriptions","organizations_url":"https://api.github.com/users/mrjustaguy/orgs","repos_url":"https://api.github.com/users/mrjustaguy/repos","events_url":"https://api.github.com/users/mrjustaguy/events{/privacy}","received_events_url":"https://api.github.com/users/mrjustaguy/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-07-06T15:25:52Z","updated_at":"2026-07-06T18:43:15Z","body":"Eh, the limiter has other problems. it generally causes pixelization issues on specular surfaces.\n\n<img width=\"1253\" height=\"580\" alt=\"Image\" src=\"https://github.com/user-attachments/assets/e8524593-1f78-419b-9511-d6175aa455b6\" />\n\n<img width=\"1302\" height=\"597\" alt=\"Image\" src=\"https://github.com/user-attachments/assets/1f422218-f2d1-4b45-b419-991a334030b3\" />\n\nHonestly I do not understand why it is on by default, I've had just a ton of problems with it so I just turn it off everywhere.\n\nIt also was funny a while back when TI went on an anti TAA rant and specifically pointed out and praised Godot for it. That was the best laugh I had in years at that point.","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4894558460/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":{"reason":"off-topic"}},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4898074343","html_url":"https://github.com/godotengine/godot/issues/120872#issuecomment-4898074343","issue_url":"https://api.github.com/repos/godotengine/godot/issues/120872","id":4898074343,"node_id":"IC_kwDOAO6SJc8AAAABI_Ku5w","user":{"login":"hypotensor","id":184009339,"node_id":"U_kgDOCvfCew","avatar_url":"https://avatars.githubusercontent.com/u/184009339?v=4","gravatar_id":"","url":"https://api.github.com/users/hypotensor","html_url":"https://github.com/hypotensor","followers_url":"https://api.github.com/users/hypotensor/followers","following_url":"https://api.github.com/users/hypotensor/following{/other_user}","gists_url":"https://api.github.com/users/hypotensor/gists{/gist_id}","starred_url":"https://api.github.com/users/hypotensor/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/hypotensor/subscriptions","organizations_url":"https://api.github.com/users/hypotensor/orgs","repos_url":"https://api.github.com/users/hypotensor/repos","events_url":"https://api.github.com/users/hypotensor/events{/privacy}","received_events_url":"https://api.github.com/users/hypotensor/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-07-06T22:12:35Z","updated_at":"2026-07-06T22:12:35Z","body":"It seems that disabling the roughness limiter mitigates the issue in almost all cases, but I think the issue of white fringing is still present, although nearly imperceptible except for in extreme circumstances. The roughness limiter is obviously contributing to or exacerbating the issue, but is not the root cause.\n\n<img width=\"844\" height=\"708\" alt=\"Image\" src=\"https://github.com/user-attachments/assets/65858842-50c4-4b65-a6ab-e02271292fd1\" />","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4898074343/reactions","total_count":2,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":1},"performed_via_github_app":null,"minimized":null}]