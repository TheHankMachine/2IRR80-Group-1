[{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4750363303","html_url":"https://github.com/godotengine/godot/issues/120439#issuecomment-4750363303","issue_url":"https://api.github.com/repos/godotengine/godot/issues/120439","id":4750363303,"node_id":"IC_kwDOAO6SJc8AAAABGyTKpw","user":{"login":"AThousandShips","id":96648715,"node_id":"U_kgDOBcK-Cw","avatar_url":"https://avatars.githubusercontent.com/u/96648715?v=4","gravatar_id":"","url":"https://api.github.com/users/AThousandShips","html_url":"https://github.com/AThousandShips","followers_url":"https://api.github.com/users/AThousandShips/followers","following_url":"https://api.github.com/users/AThousandShips/following{/other_user}","gists_url":"https://api.github.com/users/AThousandShips/gists{/gist_id}","starred_url":"https://api.github.com/users/AThousandShips/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/AThousandShips/subscriptions","organizations_url":"https://api.github.com/users/AThousandShips/orgs","repos_url":"https://api.github.com/users/AThousandShips/repos","events_url":"https://api.github.com/users/AThousandShips/events{/privacy}","received_events_url":"https://api.github.com/users/AThousandShips/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-06-19T09:36:37Z","updated_at":"2026-06-19T09:36:37Z","body":"> This issues appeared after the introduction of BaseButton: multitouch support\n#110893 as testing on 4.6.3 stable does not replicate the problem.\n\nDid you bisect it to this or are you just testing on 4.7 and 4.6.3?","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4750363303/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4750597222","html_url":"https://github.com/godotengine/godot/issues/120439#issuecomment-4750597222","issue_url":"https://api.github.com/repos/godotengine/godot/issues/120439","id":4750597222,"node_id":"IC_kwDOAO6SJc8AAAABGyhcZg","user":{"login":"syntaxerror247","id":176927541,"node_id":"U_kgDOCouzNQ","avatar_url":"https://avatars.githubusercontent.com/u/176927541?v=4","gravatar_id":"","url":"https://api.github.com/users/syntaxerror247","html_url":"https://github.com/syntaxerror247","followers_url":"https://api.github.com/users/syntaxerror247/followers","following_url":"https://api.github.com/users/syntaxerror247/following{/other_user}","gists_url":"https://api.github.com/users/syntaxerror247/gists{/gist_id}","starred_url":"https://api.github.com/users/syntaxerror247/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/syntaxerror247/subscriptions","organizations_url":"https://api.github.com/users/syntaxerror247/orgs","repos_url":"https://api.github.com/users/syntaxerror247/repos","events_url":"https://api.github.com/users/syntaxerror247/events{/privacy}","received_events_url":"https://api.github.com/users/syntaxerror247/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-06-19T10:10:59Z","updated_at":"2026-06-19T10:10:59Z","body":"I can reproduce the issue. It happens when `Action mode` is set to `Button press`.","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4750597222/reactions","total_count":2,"+1":2,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4750720338","html_url":"https://github.com/godotengine/godot/issues/120439#issuecomment-4750720338","issue_url":"https://api.github.com/repos/godotengine/godot/issues/120439","id":4750720338,"node_id":"IC_kwDOAO6SJc8AAAABGyo9Ug","user":{"login":"rbogdy","id":8807130,"node_id":"MDQ6VXNlcjg4MDcxMzA=","avatar_url":"https://avatars.githubusercontent.com/u/8807130?v=4","gravatar_id":"","url":"https://api.github.com/users/rbogdy","html_url":"https://github.com/rbogdy","followers_url":"https://api.github.com/users/rbogdy/followers","following_url":"https://api.github.com/users/rbogdy/following{/other_user}","gists_url":"https://api.github.com/users/rbogdy/gists{/gist_id}","starred_url":"https://api.github.com/users/rbogdy/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/rbogdy/subscriptions","organizations_url":"https://api.github.com/users/rbogdy/orgs","repos_url":"https://api.github.com/users/rbogdy/repos","events_url":"https://api.github.com/users/rbogdy/events{/privacy}","received_events_url":"https://api.github.com/users/rbogdy/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-06-19T10:30:09Z","updated_at":"2026-06-19T10:30:48Z","body":"I now ran multiple tests, starting with the first version before #110893 was released (which is v4.7.dev4.official [755fa449c]) and up to v4.7.beta3.official [860821708] the issue could not be replicated.\n    \nStarting with v4.7.beta4.official [dff2b9bb6] I can see the double output being printed. The only change that has something to do with the Button class seems to be [Fix Input.parse_input_event Button regression](https://github.com/godotengine/godot/pull/119329).","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4750720338/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4815223956","html_url":"https://github.com/godotengine/godot/issues/120439#issuecomment-4815223956","issue_url":"https://api.github.com/repos/godotengine/godot/issues/120439","id":4815223956,"node_id":"IC_kwDOAO6SJc8AAAABHwJ8lA","user":{"login":"ace24713","id":753186,"node_id":"MDQ6VXNlcjc1MzE4Ng==","avatar_url":"https://avatars.githubusercontent.com/u/753186?v=4","gravatar_id":"","url":"https://api.github.com/users/ace24713","html_url":"https://github.com/ace24713","followers_url":"https://api.github.com/users/ace24713/followers","following_url":"https://api.github.com/users/ace24713/following{/other_user}","gists_url":"https://api.github.com/users/ace24713/gists{/gist_id}","starred_url":"https://api.github.com/users/ace24713/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/ace24713/subscriptions","organizations_url":"https://api.github.com/users/ace24713/orgs","repos_url":"https://api.github.com/users/ace24713/repos","events_url":"https://api.github.com/users/ace24713/events{/privacy}","received_events_url":"https://api.github.com/users/ace24713/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-06-27T04:29:32Z","updated_at":"2026-06-27T04:29:32Z","body":"Ran into this one today, took a peek at some of the code to see if there was some sort of workaround I could employ (I haven't found one yet).\n\nBut I think I'm following the timeline of changes here:\n\n- before multitouch support was added to BaseButton, buttons simply didn't respond to touch inputs at all, so no problems with duplicate events.\n\n- multitouch support was added to make them respond to touch inputs, but to fix the duplicate event issue an early return statement was added to throw out emulated events.\n\n- of course this now broke all emulated events that were sent through parse_input_event, so that was then patched up by removing the early return statement, but now it is susceptible to being hit by multiple events again!\n\n- there was an attempt to fix this by ignoring emulated touch events, however on mobile the touch events are true, but the mouse events are emulated, so that doesn't prevent duplicates... and you can't fix it by also throwing out emulated mouse events because that would just kick the issue back to the previous broken state...\n\nAll that said, I have no idea how to actually fix this, any solution I can think of would be really hacky... personally I'm gonna just roll my project back to 4.6 for now.","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4815223956/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4865445606","html_url":"https://github.com/godotengine/godot/issues/120439#issuecomment-4865445606","issue_url":"https://api.github.com/repos/godotengine/godot/issues/120439","id":4865445606,"node_id":"IC_kwDOAO6SJc8AAAABIgDO5g","user":{"login":"KurodaKayn","id":146511017,"node_id":"U_kgDOCLuUqQ","avatar_url":"https://avatars.githubusercontent.com/u/146511017?v=4","gravatar_id":"","url":"https://api.github.com/users/KurodaKayn","html_url":"https://github.com/KurodaKayn","followers_url":"https://api.github.com/users/KurodaKayn/followers","following_url":"https://api.github.com/users/KurodaKayn/following{/other_user}","gists_url":"https://api.github.com/users/KurodaKayn/gists{/gist_id}","starred_url":"https://api.github.com/users/KurodaKayn/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/KurodaKayn/subscriptions","organizations_url":"https://api.github.com/users/KurodaKayn/orgs","repos_url":"https://api.github.com/users/KurodaKayn/repos","events_url":"https://api.github.com/users/KurodaKayn/events{/privacy}","received_events_url":"https://api.github.com/users/KurodaKayn/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-07-02T12:01:11Z","updated_at":"2026-07-02T12:05:31Z","body":"I looked into this and have a fix ready.\n\nThe duplicate `pressed` emission happens because touch input with mouse emulation enabled can deliver two GUI paths to `BaseButton`: first the touch-generated mouse event, then the original screen touch event. My first pass guarded the direct mouse-button path, but there was one extra edge to cover: if `ui_accept` can match the touch-emulated mouse button event, that event may still go through the action path and the real touch event can emit again.\n\nThe fix I prepared marks mouse button/motion events generated from touch, preserves that marker through event transforms, and has `BaseButton` ignore those touch-emulated mouse events for the mouse-button, mouse-motion, and `ui_accept` paths. Ordinary emulated mouse events are still accepted, so this should not reintroduce the earlier `Input.parse_input_event()` regression.\n\nI also added regression tests for:\n- touch input with mouse emulation only emitting `pressed` once,\n- the `ui_accept` edge case,\n- ordinary emulated mouse events still triggering buttons.\n\nI've already opened a PR to fix this issue","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4865445606/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5021683511","html_url":"https://github.com/godotengine/godot/issues/120439#issuecomment-5021683511","issue_url":"https://api.github.com/repos/godotengine/godot/issues/120439","id":5021683511,"node_id":"IC_kwDOAO6SJc8AAAABK1DPNw","user":{"login":"baz4096","id":6884187,"node_id":"MDQ6VXNlcjY4ODQxODc=","avatar_url":"https://avatars.githubusercontent.com/u/6884187?v=4","gravatar_id":"","url":"https://api.github.com/users/baz4096","html_url":"https://github.com/baz4096","followers_url":"https://api.github.com/users/baz4096/followers","following_url":"https://api.github.com/users/baz4096/following{/other_user}","gists_url":"https://api.github.com/users/baz4096/gists{/gist_id}","starred_url":"https://api.github.com/users/baz4096/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/baz4096/subscriptions","organizations_url":"https://api.github.com/users/baz4096/orgs","repos_url":"https://api.github.com/users/baz4096/repos","events_url":"https://api.github.com/users/baz4096/events{/privacy}","received_events_url":"https://api.github.com/users/baz4096/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-07-20T11:23:43Z","updated_at":"2026-07-20T11:24:25Z","body":"Came here to report the same bug, although discovered via a different method. We have our some buttons that use Toggle Mode. 4.6.3 saw these working perfectly on iOS. In 4.7 they stopped working as expected, after some digging we figured out they were getting mouse button events and duplicate touch events in the same frame, one toggling the button on, the other instantly toggling it off again. Our temporary workaround was to add this:\n\n```\nfunc _gui_input(event):\n\tif event is InputEventMouseButton and event.device == InputEvent.DEVICE_ID_EMULATION:\n\t\taccept_event()\n\t\treturn\n```\n\nWhich basically absorbs and ignores one of the events. For us it didn't matter which, just that we only registered one press instead of two. A bit hacky, but it'll do until the next release rolls the proper fix out.","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5021683511/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5022026019","html_url":"https://github.com/godotengine/godot/issues/120439#issuecomment-5022026019","issue_url":"https://api.github.com/repos/godotengine/godot/issues/120439","id":5022026019,"node_id":"IC_kwDOAO6SJc8AAAABK1YJIw","user":{"login":"syntaxerror247","id":176927541,"node_id":"U_kgDOCouzNQ","avatar_url":"https://avatars.githubusercontent.com/u/176927541?v=4","gravatar_id":"","url":"https://api.github.com/users/syntaxerror247","html_url":"https://github.com/syntaxerror247","followers_url":"https://api.github.com/users/syntaxerror247/followers","following_url":"https://api.github.com/users/syntaxerror247/following{/other_user}","gists_url":"https://api.github.com/users/syntaxerror247/gists{/gist_id}","starred_url":"https://api.github.com/users/syntaxerror247/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/syntaxerror247/subscriptions","organizations_url":"https://api.github.com/users/syntaxerror247/orgs","repos_url":"https://api.github.com/users/syntaxerror247/repos","events_url":"https://api.github.com/users/syntaxerror247/events{/privacy}","received_events_url":"https://api.github.com/users/syntaxerror247/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-07-20T12:05:58Z","updated_at":"2026-07-20T12:05:58Z","body":"@baz4096 Please test Godot 4.7.1, it contains the fix.\nhttps://godotengine.org/download/archive/4.7.1-stable/","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5022026019/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5022168702","html_url":"https://github.com/godotengine/godot/issues/120439#issuecomment-5022168702","issue_url":"https://api.github.com/repos/godotengine/godot/issues/120439","id":5022168702,"node_id":"IC_kwDOAO6SJc8AAAABK1g2fg","user":{"login":"baz4096","id":6884187,"node_id":"MDQ6VXNlcjY4ODQxODc=","avatar_url":"https://avatars.githubusercontent.com/u/6884187?v=4","gravatar_id":"","url":"https://api.github.com/users/baz4096","html_url":"https://github.com/baz4096","followers_url":"https://api.github.com/users/baz4096/followers","following_url":"https://api.github.com/users/baz4096/following{/other_user}","gists_url":"https://api.github.com/users/baz4096/gists{/gist_id}","starred_url":"https://api.github.com/users/baz4096/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/baz4096/subscriptions","organizations_url":"https://api.github.com/users/baz4096/orgs","repos_url":"https://api.github.com/users/baz4096/repos","events_url":"https://api.github.com/users/baz4096/events{/privacy}","received_events_url":"https://api.github.com/users/baz4096/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-07-20T12:22:25Z","updated_at":"2026-07-20T12:22:25Z","body":"> [@baz4096](https://github.com/baz4096) Please test Godot 4.7.1, it contains the fix. https://godotengine.org/download/archive/4.7.1-stable/\n\nI'm not seeing the fix in 4.7.1; it's listed as a 4.8 milestone, and present in master.\nI can replicate my issue in 4.7.1.\n\nMany thanks","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5022168702/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5022386207","html_url":"https://github.com/godotengine/godot/issues/120439#issuecomment-5022386207","issue_url":"https://api.github.com/repos/godotengine/godot/issues/120439","id":5022386207,"node_id":"IC_kwDOAO6SJc8AAAABK1uIHw","user":{"login":"syntaxerror247","id":176927541,"node_id":"U_kgDOCouzNQ","avatar_url":"https://avatars.githubusercontent.com/u/176927541?v=4","gravatar_id":"","url":"https://api.github.com/users/syntaxerror247","html_url":"https://github.com/syntaxerror247","followers_url":"https://api.github.com/users/syntaxerror247/followers","following_url":"https://api.github.com/users/syntaxerror247/following{/other_user}","gists_url":"https://api.github.com/users/syntaxerror247/gists{/gist_id}","starred_url":"https://api.github.com/users/syntaxerror247/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/syntaxerror247/subscriptions","organizations_url":"https://api.github.com/users/syntaxerror247/orgs","repos_url":"https://api.github.com/users/syntaxerror247/repos","events_url":"https://api.github.com/users/syntaxerror247/events{/privacy}","received_events_url":"https://api.github.com/users/syntaxerror247/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-07-20T12:46:36Z","updated_at":"2026-08-23T07:44:39Z","body":"> > [@baz4096](https://github.com/baz4096) Please test Godot 4.7.1, it contains the fix. https://godotengine.org/download/archive/4.7.1-stable/\n> \n> I'm not seeing the fix in 4.7.1; it's listed as a 4.8 milestone, and present in master. I can replicate my issue in 4.7.1.\n> \n> Many thanks\n\nAh, It's not cherry-picked yet. Sorry for trouble. ~It's in queue for 4.7.2~ Didn't got cherrypicked.","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5022386207/reactions","total_count":1,"+1":0,"-1":0,"laugh":0,"hooray":1,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5382752779","html_url":"https://github.com/godotengine/godot/issues/120439#issuecomment-5382752779","issue_url":"https://api.github.com/repos/godotengine/godot/issues/120439","id":5382752779,"node_id":"IC_kwDOAO6SJc8AAAABQNZKCw","user":{"login":"skysphr","id":46826615,"node_id":"MDQ6VXNlcjQ2ODI2NjE1","avatar_url":"https://avatars.githubusercontent.com/u/46826615?v=4","gravatar_id":"","url":"https://api.github.com/users/skysphr","html_url":"https://github.com/skysphr","followers_url":"https://api.github.com/users/skysphr/followers","following_url":"https://api.github.com/users/skysphr/following{/other_user}","gists_url":"https://api.github.com/users/skysphr/gists{/gist_id}","starred_url":"https://api.github.com/users/skysphr/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/skysphr/subscriptions","organizations_url":"https://api.github.com/users/skysphr/orgs","repos_url":"https://api.github.com/users/skysphr/repos","events_url":"https://api.github.com/users/skysphr/events{/privacy}","received_events_url":"https://api.github.com/users/skysphr/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-08-22T21:43:16Z","updated_at":"2026-08-22T21:53:54Z","body":"I'm running into this under 4.7.2. Disabling \"Emulate mouse from touch\" fixes it, but obviously some people might need that setting enabled.\n\nRelated: #122266","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5382752779/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5384931506","html_url":"https://github.com/godotengine/godot/issues/120439#issuecomment-5384931506","issue_url":"https://api.github.com/repos/godotengine/godot/issues/120439","id":5384931506,"node_id":"IC_kwDOAO6SJc8AAAABQPeIsg","user":{"login":"syntaxerror247","id":176927541,"node_id":"U_kgDOCouzNQ","avatar_url":"https://avatars.githubusercontent.com/u/176927541?v=4","gravatar_id":"","url":"https://api.github.com/users/syntaxerror247","html_url":"https://github.com/syntaxerror247","followers_url":"https://api.github.com/users/syntaxerror247/followers","following_url":"https://api.github.com/users/syntaxerror247/following{/other_user}","gists_url":"https://api.github.com/users/syntaxerror247/gists{/gist_id}","starred_url":"https://api.github.com/users/syntaxerror247/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/syntaxerror247/subscriptions","organizations_url":"https://api.github.com/users/syntaxerror247/orgs","repos_url":"https://api.github.com/users/syntaxerror247/repos","events_url":"https://api.github.com/users/syntaxerror247/events{/privacy}","received_events_url":"https://api.github.com/users/syntaxerror247/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-08-23T07:53:57Z","updated_at":"2026-08-23T07:53:57Z","body":"> I'm running into this under 4.7.2. Disabling \"Emulate mouse from touch\" fixes it, but obviously some people might need that setting enabled.\n\nYeah, this issue is still present in 4.7.2. The fix wasn't backported because doing so would have caused slight compat break, and godot's policy is to avoid breaking compatibility in patch releases.\nYou can use this as workaround https://github.com/godotengine/godot/issues/120439#issuecomment-5021683511 or keep `Action mode` to `Button release`.\n\n","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5384931506/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null}]