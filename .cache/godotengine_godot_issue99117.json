hived_at":null,"archived_by":null},{"id":279096997,"node_id":"MDU6TGFiZWwyNzkwOTY5OTc=","url":"https://api.github.com/repos/godotengine/godot/labels/archived","name":"archived","color":"aaaaaa","default":false,"description":"","archived_at":null,"archived_by":null},{"id":279098219,"node_id":"MDU6TGFiZWwyNzkwOTgyMTk=","url":"https://api.github.com/repos/godotengine/godot/labels/topic:editor","name":"topic:editor","color":"ffee88","default":false,"description":"","archived_at":null,"archived_by":null},{"id":283518733,"node_id":"MDU6TGFiZWwyODM1MTg3MzM=","url":"https://api.github.com/repos/godotengine/godot/labels/usability","name":"usability","color":"447744","default":false,"description":"","archived_at":null,"archived_by":null},{"id":2666708289,"node_id":"MDU6TGFiZWwyNjY2NzA4Mjg5","url":"https://api.github.com/repos/godotengine/godot/labels/topic:3d","name":"topic:3d","color":"ffee88","default":false,"description":"","archived_at":null,"archived_by":null}],"state":"closed","locked":false,"assignees":[],"milestone":null,"comments":4,"created_at":"2024-11-12T11:55:08Z","updated_at":"2026-02-07T12:37:12Z","closed_at":"2025-03-07T15:29:28Z","assignee":null,"author_association":"NONE","issue_field_values":[],"type":null,"active_lock_reason":null,"draft":false,"pull_request":{"url":"https://api.github.com/repos/godotengine/godot/pulls/99117","html_url":"https://github.com/godotengine/godot/pull/99117","diff_url":"https://github.com/godotengine/godot/pull/99117.diff","patch_url":"https://github.com/godotengine/godot/pull/99117.patch","merged_at":null},"body":"<!--\r\nPlease target the `master` branch in priority.\r\n\r\nRelevant fixes are cherry-picked for stable branches as needed by maintainers.\r\n\r\nTo speed up the contribution process and avoid CI errors, please set up pre-commit hooks locally:\r\nhttps://docs.godotengine.org/en/latest/contributing/development/code_style_guidelines.html\r\n-->\r\nImplements the proposal: https://github.com/godotengine/godot-proposals/issues/1798 , https://github.com/godotengine/godot-proposals/issues/11133\r\n\r\nThis PR adds a option menu and a shortcut to create Camera3D node from the current 3d editor view.\r\nMenu option button:\r\n![godotCam](https://github.com/user-attachments/assets/731d5f24-d7ea-45c9-a777-8a604924cfc2)\r\nBy using shortcuts: ``` CMD OR CTRL + ALT + C```\r\nDemonstration video:\r\n\r\nhttps://github.com/user-attachments/assets/d0a61e08-f414-4f83-abaf-ebd9febd6b96\r\n\r\n# Note\r\n1. The created camera takes and applies the properties from the current 3d editor view camera property such as VFOV, Z-Near, and Z-far.\r\n2. If there is no nodes selected in the scene then the base node would be the parent of the created camera from view.\r\n3. Only one selected node is allowed as a parent when creating the camera from the current view. If multiples nodes are selected then it won't create the camera from the current view.\r\n4. When in Orthogonal perspective view, it creates a Orthogonal Camera3d node.\r\n\r\n# Purpose of this PR.\r\nWith this anyone would be able to create Camera3d for the current 3d editor view quickly. So, that they can see which view (composition) would be best and can be used for taking screenshots and such. \r\nThis feature is present in various game engines such as CryEngine, Unreal Engine, etc.\r\nIn CryEngine 5:\r\n![CryCam](https://github.com/user-attachments/assets/5dfdcb7e-6685-4227-a856-47c85df8620b)\r\nIn Unreal Engine 4 or 5:\r\n![unrealCam](https://github.com/user-attachments/assets/929d1655-07fa-4698-8686-93031fc86109)\r\n\r\n\r\n\r\n","closed_by":{"login":"AbhijitL","id":28972945,"node_id":"MDQ6VXNlcjI4OTcyOTQ1","avatar_url":"https://avatars.githubusercontent.com/u/28972945?v=4","gravatar_id":"","url":"https://api.github.com/users/AbhijitL","html_url":"https://github.com/AbhijitL","followers_url":"https://api.github.com/users/AbhijitL/followers","following_url":"https://api.github.com/users/AbhijitL/following{/other_user}","gists_url":"https://api.github.com/users/AbhijitL/gists{/gist_id}","starred_url":"https://api.github.com/users/AbhijitL/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/AbhijitL/subscriptions","organizations_url":"https://api.github.com/users/AbhijitL/orgs","repos_url":"https://api.github.com/users/AbhijitL/repos","events_url":"https://api.github.com/users/AbhijitL/events{/privacy}","received_events_url":"https://api.github.com/users/AbhijitL/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/99117/reactions","total_count":8,"+1":8,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/godotengine/godot/issues/99117/timeline","performed_via_github_app":null,"state_reason":null}