archived_by":null}],"state":"closed","locked":false,"assignees":[],"milestone":{"url":"https://api.github.com/repos/godotengine/godot/milestones/25","html_url":"https://github.com/godotengine/godot/milestone/25","labels_url":"https://api.github.com/repos/godotengine/godot/milestones/25/labels","id":15520464,"node_id":"MI_kwDOAO6SJc4A7NLQ","number":25,"title":"4.8","description":"","creator":{"login":"Repiteo","id":17489292,"node_id":"MDQ6VXNlcjE3NDg5Mjky","avatar_url":"https://avatars.githubusercontent.com/u/17489292?v=4","gravatar_id":"","url":"https://api.github.com/users/Repiteo","html_url":"https://github.com/Repiteo","followers_url":"https://api.github.com/users/Repiteo/followers","following_url":"https://api.github.com/users/Repiteo/following{/other_user}","gists_url":"https://api.github.com/users/Repiteo/gists{/gist_id}","starred_url":"https://api.github.com/users/Repiteo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Repiteo/subscriptions","organizations_url":"https://api.github.com/users/Repiteo/orgs","repos_url":"https://api.github.com/users/Repiteo/repos","events_url":"https://api.github.com/users/Repiteo/events{/privacy}","received_events_url":"https://api.github.com/users/Repiteo/received_events","type":"User","user_view_type":"public","site_admin":false},"open_issues":351,"closed_issues":2337,"state":"open","created_at":"2026-04-13T15:59:35Z","updated_at":"2026-10-22T15:17:38Z","due_on":null,"closed_at":null},"comments":5,"created_at":"2025-07-21T06:22:08Z","updated_at":"2026-06-24T15:21:36Z","closed_at":"2026-06-24T15:21:14Z","assignee":null,"author_association":"CONTRIBUTOR","issue_field_values":[],"type":null,"active_lock_reason":null,"draft":false,"pull_request":{"url":"https://api.github.com/repos/godotengine/godot/pulls/108819","html_url":"https://github.com/godotengine/godot/pull/108819","diff_url":"https://github.com/godotengine/godot/pull/108819.diff","patch_url":"https://github.com/godotengine/godot/pull/108819.patch","merged_at":"2026-06-24T15:21:14Z"},"body":"Fix inconsistent error return in `vertex_format_create`\r\n\r\nWhen driver vertex format creation fails, `vertex_format_create()` returns `0` instead of `INVALID_ID`. This causes downstream validation failures because `0` isn't registered in the vertex format cache.\r\n\r\nThe inconsistency breaks the contract where invalid IDs should be `INVALID_ID`, not `0`. Callers expect either a valid format `ID` or `INVALID_ID` on failure.\r\n\r\nRoot cause: Driver failure returns falsy value, triggering `ERR_FAIL_COND_V(!driver_id, 0)` which returns 0 instead of the expected `INVALID_ID`.","closed_by":{"login":"Repiteo","id":17489292,"node_id":"MDQ6VXNlcjE3NDg5Mjky","avatar_url":"https://avatars.githubusercontent.com/u/17489292?v=4","gravatar_id":"","url":"https://api.github.com/users/Repiteo","html_url":"https://github.com/Repiteo","followers_url":"https://api.github.com/users/Repiteo/followers","following_url":"https://api.github.com/users/Repiteo/following{/other_user}","gists_url":"https://api.github.com/users/Repiteo/gists{/gist_id}","starred_url":"https://api.github.com/users/Repiteo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Repiteo/subscriptions","organizations_url":"https://api.github.com/users/Repiteo/orgs","repos_url":"https://api.github.com/users/Repiteo/repos","events_url":"https://api.github.com/users/Repiteo/events{/privacy}","received_events_url":"https://api.github.com/users/Repiteo/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/108819/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/godotengine/godot/issues/108819/timeline","performed_via_github_app":null,"state_reason":null}