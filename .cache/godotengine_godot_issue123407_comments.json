":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5675794904","html_url":"https://github.com/godotengine/godot/issues/123407#issuecomment-5675794904","issue_url":"https://api.github.com/repos/godotengine/godot/issues/123407","id":5675794904,"node_id":"IC_kwDOAO6SJc8AAAABUk3B2A","user":{"login":"YeldhamDev","id":30739239,"node_id":"MDQ6VXNlcjMwNzM5MjM5","avatar_url":"https://avatars.githubusercontent.com/u/30739239?v=4","gravatar_id":"","url":"https://api.github.com/users/YeldhamDev","html_url":"https://github.com/YeldhamDev","followers_url":"https://api.github.com/users/YeldhamDev/followers","following_url":"https://api.github.com/users/YeldhamDev/following{/other_user}","gists_url":"https://api.github.com/users/YeldhamDev/gists{/gist_id}","starred_url":"https://api.github.com/users/YeldhamDev/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/YeldhamDev/subscriptions","organizations_url":"https://api.github.com/users/YeldhamDev/orgs","repos_url":"https://api.github.com/users/YeldhamDev/repos","events_url":"https://api.github.com/users/YeldhamDev/events{/privacy}","received_events_url":"https://api.github.com/users/YeldhamDev/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-09-15T06:29:18Z","updated_at":"2026-09-15T06:29:18Z","body":"That is because those are added to the contextual segment of the menu bar. You will see it also appearing when selecting a `Control` node, for example. If you want an option to add it to the menu proper, you should open an [proposal](https://github.com/godotengine/godot-proposals) for that.\n\nSince the issue itself has been confirmed as not a bug, I will be closing this.","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5675794904/reactions",