2?v=4","gravatar_id":"","url":"https://api.github.com/users/Calinou","html_url":"https://github.com/Calinou","followers_url":"https://api.github.com/users/Calinou/followers","following_url":"https://api.github.com/users/Calinou/following{/other_user}","gists_url":"https://api.github.com/users/Calinou/gists{/gist_id}","starred_url":"https://api.github.com/users/Calinou/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Calinou/subscriptions","organizations_url":"https://api.github.com/users/Calinou/orgs","repos_url":"https://api.github.com/users/Calinou/repos","events_url":"https://api.github.com/users/Calinou/events{/privacy}","received_events_url":"https://api.github.com/users/Calinou/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-01-23T23:41:11Z","updated_at":"2025-01-23T23:41:11Z","body":"Thanks for the report! Consolidating in https://github.com/godotengine/godot/issues/99184, as this is due to the same cause.\n\nZ-fighting on TBDR GPUs (mobile/Apple GPUs) takes the form of these squares, so it looks different from standard Z-fighting on desktop GPUs, but it's the exact same cause.","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2611234706/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2613419266","html_url":"https://github.com/godotengine/godot/issues/101939#issuecomment-2613419266","issue_url":"https://api.github.com/repos/godotengine/godot/issues/101939","id":2613419266,"node_id":"IC_kwDOAO6SJc6bxZ0C","user":{"login":"RevoluPowered","id":748770,"node_id":"MDQ6VXNlcjc0ODc3MA==","avatar_url":"https://avatars.githubusercontent.com/u/748770?v=4","gravatar_id":"","url":"https://api.github.com/users/RevoluPowered","html_url":"https://github.c