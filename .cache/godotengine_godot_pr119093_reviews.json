rs/allenwp/orgs","repos_url":"https://api.github.com/users/allenwp/repos","events_url":"https://api.github.com/users/allenwp/events{/privacy}","received_events_url":"https://api.github.com/users/allenwp/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"**EDIT: Please disregard this comment. It originally described a problem with the macOS Preview app doing a bad job of rendering my PNG screenshots from Godot.**\r\n\r\nMRP: [float-srgb-test.zip](https://github.com/user-attachments/files/27532178/float-srgb-test.zip)","state":"COMMENTED","html_url":"https://github.com/godotengine/godot/pull/119093#pullrequestreview-4253541136","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/119093","author_association":"CONTRIBUTOR","_links":{"html":{"href":"https://github.com/godotengine/godot/pull/119093#pullrequestreview-4253541136"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/119093"}},"submitted_at":"2026-05-08T17:04:16Z","commit_id":"c71ce829f1c4dfd9ec8f02e9bc28039c6e94359d"},{"id":4284567746,"node_id":"PRR_kwDOAO6SJc7_YVDC","user":{"login":"allenwp","id":17506573,"node_id":"MDQ6VXNlcjE3NTA2NTcz","avatar_url":"https://avatars.githubusercontent.com/u/17506573?u=6e9313e254649f6dc55e92536596487ac10bf5a2&v=4","gravatar_id":"","url":"https://api.github.com/users/allenwp","html_url":"https://github.com/allenwp","followers_url":"https://api.github.com/users/allenwp/followers","following_url":"https://api.github.com/users/allenwp/following{/other_user}","gists_url":"https://api.github.com/users/allenwp/gists{/gist_id}","starred_url":"https://api.github.com/users/allenwp/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/allenwp/subscriptions","organizations_url":"https://api.github.com/users/allenwp/orgs","repos_url":"https://api.github.com/users/allenwp/repos","events_url":"https://api.github.com/users/allenwp/events{/privacy}","received_events_url":"https://api.github.com/users/allenwp/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"There are a couple of places where `img->convert(Image::FORMAT_RGBA8)` is no longer needed at all, so I've added some comments about them.\n\nIt seems that Image::convert does different rounding than my GPU driver on Windows when converting from float to int. One is probably doing `floor` and the other is doing `round`. The result is an image that has sRGB code values that are off by as much as `1`. Probably not worth addressing in this PR, but I'm mentioning it here just in case that's useful.\n\n[float-srgb-test.zip](https://github.com/user-attachments/files/27726737/float-srgb-test.zip)\n\nWindows GPU render | Godot generated screenshot\n--|--\n<img width=\"3840\" height=\"2071\" alt=\"Image\" src=\"https://github.com/user-attachments/assets/029f102c-01f3-42f2-8b17-bbf020342ab7\" />|<img width=\"3840\" height=\"2071\" alt=\"Image\" src=\"https://github.com/user-attachments/assets/a78497a7-4367-421f-8387-a04c678e5521\" />\n\nOn macOS, it's a little harder to test this because screenshots are saved with the P3 colour primaries, but after doing a basic conversion to sRGB... I think this rounding discrepancy doesn't happen(?)\n\nOtherwise, this looks great to me and is a very valuable improvement to HDR 2D support! Thanks!","state":"APPROVED","html_url":"https://github.com/godotengine/godot/pull/119093#pullrequestreview-4284567746","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/119093","author_association":"CONTRIBUTOR","_links":{"html":{"href":"https://github.com/godotengine/godot/pull/119093#pullrequestreview-4284567746"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/119093"}},"submitted_at":"2026-05-13T19:23:06Z","commit_id":"4d911597963b408fa6d622bda2c69c2588e4b259"}]