.github.com/repos/godotengine/godot/pulls/118265","html_url":"https://github.com/godotengine/godot/pull/118265","diff_url":"https://github.com/godotengine/godot/pull/118265.diff","patch_url":"https://github.com/godotengine/godot/pull/118265.patch","merged_at":"2026-05-15T20:49:46Z"},"body":"Fix #118218.\r\n\r\nBecause `BoneAttachment3D` enters the tree first, with `override_pose` enabled, ` sk->get_global_transform().affine_inverse() * get_global_transform();` runs during that enter tree step before the skeleton has even entered the tree. Hence why it throws `!is_inside_tree()`.\r\n\r\nThis PR makes it wait until the skeleton is actually inside the tree.\r\n\r\n","closed_by":{"login":"Repiteo","id":17489292,"node_id":"MDQ6VXNlcjE3NDg5Mjky","avatar_url":"https://avatars.githubusercontent.com/u/17489292?v=4","gravatar_id":"","url":"https://api.github.com/users/Repiteo","html_url":"https://github.com/Repiteo","followers_url":"https://api.github.com/users/Repiteo/followers","following_url":"https://api.github.com/users/Repiteo/following{/other_user}","gists_url":"https://api.github.com/users/Repiteo/gists{/gist_id}","starred_url":"https://api.github.com/users/Repiteo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Repiteo/subscriptions","organizations_url":"https://api.github.com/users/Repiteo/orgs","repos_url":"https://api.github.com/users/Repiteo/repos","events_url":"https://api.github.com/users/Repiteo/events{/privacy}","received_events_url":"https://api.github.com/users/Repiteo/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/118265/reactions","total_count":2,"+1":2,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/godotengine/godot/issues/118265/timeline","performed_via_github_app":null,"state_reason":null}