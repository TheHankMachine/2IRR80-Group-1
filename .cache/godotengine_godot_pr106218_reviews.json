base.","state":"APPROVED","html_url":"https://github.com/godotengine/godot/pull/106218#pullrequestreview-2915939649","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/106218","author_association":"MEMBER","_links":{"html":{"href":"https://github.com/godotengine/godot/pull/106218#pullrequestreview-2915939649"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/106218"}},"submitted_at":"2025-06-11T07:18:41Z","commit_id":null},{"id":2918873603,"node_id":"PRR_kwDOAO6SJc6t-noD","user":{"login":"Rindbee","id":30386067,"node_id":"MDQ6VXNlcjMwMzg2MDY3","avatar_url":"https://avatars.githubusercontent.com/u/30386067?u=aba5a323c950ddd46e8027fb0ced27b96d4856a1&v=4","gravatar_id":"","url":"https://api.github.com/users/Rindbee","html_url":"https://github.com/Rindbee","followers_url":"https://api.github.com/users/Rindbee/followers","following_url":"https://api.github.com/users/Rindbee/following{/other_user}","gists_url":"https://api.github.com/users/Rindbee/gists{/gist_id}","starred_url":"https://api.github.com/users/Rindbee/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Rindbee/subscriptions","organizations_url":"https://api.github.com/users/Rindbee/orgs","repos_url":"https://api.github.com/users/Rindbee/repos","events_url":"https://api.github.com/users/Rindbee/events{/privacy}","received_events_url":"https://api.github.com/users/Rindbee/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"","state":"COMMENTED","html_url":"https://github.com/godotengine/godot/pull/106218#pullrequestreview-2918873603","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/106218","author_association":"CONTRIBUTOR","_links":{"html":{"href":"https://github.com/godotengine/godot/pull/106218#pullrequestreview-2918873603"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/106218"}},"submitted_at":"2025-06-11T22:20:29Z","commit_id":null},{"id":292063963