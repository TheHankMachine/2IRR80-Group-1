r":"ffee88","default":false,"description":"","archived_at":null,"archived_by":null},{"id":865585000,"node_id":"MDU6TGFiZWw4NjU1ODUwMDA=","url":"https://api.github.com/repos/godotengine/godot/labels/topic:xr","name":"topic:xr","color":"ffee88","default":false,"description":"","archived_at":null,"archived_by":null}],"state":"closed","locked":false,"assignees":[],"milestone":{"url":"https://api.github.com/repos/godotengine/godot/milestones/23","html_url":"https://github.com/godotengine/godot/milestone/23","labels_url":"https://api.github.com/repos/godotengine/godot/milestones/23/labels","id":12939969,"node_id":"MI_kwDOAO6SJc4AxXLB","number":23,"title":"4.6","description":"","creator":{"login":"Repiteo","id":17489292,"node_id":"MDQ6VXNlcjE3NDg5Mjky","avatar_url":"https://avatars.githubusercontent.com/u/17489292?v=4","gravatar_id":"","url":"https://api.github.com/users/Repiteo","html_url":"https://github.com/Repiteo","followers_url":"https://api.github.com/users/Repiteo/followers","following_url":"https://api.github.com/users/Repiteo/following{/other_user}","gists_url":"https://api.github.com/users/Repiteo/gists{/gist_id}","starred_url":"https://api.github.com/users/Repiteo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Repiteo/subscriptions","organizations_url":"https://api.github.com/users/Repiteo/orgs","repos_url":"https://api.github.com/users/Repiteo/repos","events_url":"https://api.github.com/users/Repiteo/events{/privacy}","received_events_url":"https://api.github.com/users/Repiteo/received_events","type":"User","user_view_type":"public","site_admin":false},"open_issues":3,"closed_issues":2978,"state":"closed","created_at":"2025-05-22T16:25:52Z","updated_at":"2026-10-04T16:23:23Z","due_on":null,"closed_at":"2026-01-26T18:09:14Z"},"comments":2,"created_at":"2025-09-24T16:13:26Z","updated_at":"2025-09-30T16:41:21Z","closed_at":"2025-09-25T17:19:53Z","assignee":null,"author_association":"CONTRIBUTOR","issue_field_values":[],"type":null,"active_lock_reason":null,"draft":false,"pull_request":{"url":"https://api.github.com/repos/godotengine/godot/pulls/110865","html_url":"https://github.com/godotengine/godot/pull/110865","diff_url":"https://github.com/godotengine/godot/pull/110865.diff","patch_url":"https://github.com/godotengine/godot/pull/110865.patch","merged_at":"2025-09-25T17:19:53Z"},"body":"This fixes an issue with the usage of the depth buffer when using OpenXR with D3D12. Godot OpenXR code was using a helper function to generate a projection matrix, which has different behavior depending on what the active graphics API is because D3D12/VK/GL have different clip space conventions. The problem is that Godot is standardized on OpenGL convention and so using D3D clip space convention produced the wrong projection matrix. The projection matrix helper used by Godot OpenXR was taken from the Khronos OpenXR codebase and works well for samples that directly use these graphics APIs, but in Godot having this `graphicsApi` parameter is just inviting trouble because OpenGL clip space convention is the only correct use.\r\n\r\nFor these reasons I have removed the `graphicsApi` parameter and have it always follow OpenGL convention, along with cleaning up comments to reflect this.\r\n\r\n**Validation**\r\nMy team's product has an OpenXR runtime which uses the depth buffer for higher quality reprojection as well as having \"shell\" overlay UI intersecting with the app-provided renderings. \r\nGodot using Vulkan: I used my team's product to verify the depth was already good before my change and continued to be correct after my change. \r\nGodot using D3D12: I used my team's product to verify the depth was scaled wrong before my change but scaled correctly (overlay depth intersection was correct and reprojection instability improved) after my change.","closed_by":{"login":"Repiteo","id":17489292,"node_id":"MDQ6VXNlcjE3NDg5Mjky","avatar_url":"https://avatars.githubusercontent.com/u/17489292?v=4","gravatar_id":"","url":"https://api.github.com/users/Repiteo","html_url":"https://github.com/Repiteo","followers_url":"https://api.github.com/users/Repiteo/followers","following_url":"https://api.github.com/users/Repiteo/following{/other_user}","gists_url":"https://api.github.com/users/Repiteo/gists{/gist_id}","starred_url":"https://api.github.com/users/Repiteo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Repiteo/subscriptions","organizations_url":"https://api.github.com/users/Repiteo/orgs","repos_url":"https://api.github.com/users/Repiteo/repos","events_url":"https://api.github.com/users/Repiteo/events{/privacy}","received_events_url":"https://api.github.com/users/Repiteo/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/110865/reactions","total_count":1,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":1},"timeline_url":"https://api.github.com/repos/godotengine/godot/issues/110865/timeline","performed_via_github_app":null,"state_reason":null}