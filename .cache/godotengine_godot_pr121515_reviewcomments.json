api.github.com/users/Ivorforce/followers","following_url":"https://api.github.com/users/Ivorforce/following{/other_user}","gists_url":"https://api.github.com/users/Ivorforce/gists{/gist_id}","starred_url":"https://api.github.com/users/Ivorforce/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Ivorforce/subscriptions","organizations_url":"https://api.github.com/users/Ivorforce/orgs","repos_url":"https://api.github.com/users/Ivorforce/repos","events_url":"https://api.github.com/users/Ivorforce/events{/privacy}","received_events_url":"https://api.github.com/users/Ivorforce/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"This is incorrect. It's reading the mix rate _project setting_ and then applying it without even checking if the device supports this sampling rate. If it doesn't, the game won't have audio on that device. That makes the current implementation a hard footgun.\n","created_at":"2026-09-03T18:11:28Z","updated_at":"2026-09-03T18:14:39Z","html_url":"https://github.com/godotengine/godot/pull/121515#discussion_r3927353640","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/121515","_links":{"self":{"href":"https://api.github.com/repos/godotengine/godot/pulls/comments/3927353640"},"html":{"href":"https://github.com/godotengine/godot/pull/121515#discussion_r3927353640"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/121515"}},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/3927353640/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":null,"original_line":93,"side":"RIGHT","author_association":"MEMBER","original_position":23,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/3927625816","pull_request_review_id":5105579524,"id":3927625816,"node_id":"PRRC_kwDOAO6SJc7qGtBY","diff_hunk":"@@ -80,8 +79,19 @@ void AudioDriverOpenSL::_buffer_callbacks(\n \n \tad->_buffer_callback(queueItf);\n }\n+static int _sanitize_mix_rate(int p_mix_rate) {\n+\tstatic const int opensl_rates[] = { SL_SAMPLINGRATE_8, SL_SAMPLINGRATE_11_025, SL_SAMPLINGRATE_12, SL_SAMPLINGRATE_16, SL_SAMPLINGRATE_22_05, SL_SAMPLINGRATE_24, SL_SAMPLINGRATE_32, SL_SAMPLINGRATE_44_1, SL_SAMPLINGRATE_48, SL_SAMPLINGRATE_64, SL_SAMPLINGRATE_88_2, SL_SAMPLINGRATE_96, SL_SAMPLINGRATE_192 };\n+\tfor (const int samplerate : opensl_rates) {\n+\t\tif (p_mix_rate == samplerate / 1000) {\n+\t\t\treturn p_mix_rate;\n+\t\t}\n+\t}\n+\treturn AudioDriverOpenSL::DEFAULT_MIX_RATE;\n+}\n \n Error AudioDriverOpenSL::init() {\n+\tmix_rate = _sanitize_mix_rate(_get_configured_mix_rate());","path":"platform/android/audio_driver_opensl.cpp","commit_id":"171f34af1c1613126c6ed7297d247dd78b93d8c0","original_commit_id":"0da35139d9802d4413060b8fb62f8554387e97bb","user":{"login":"rekliner","id":4936039,"node_id":"MDQ6VXNlcjQ5MzYwMzk=","avatar_url":"https://avatars.githubusercontent.com/u/4936039?v=4","gravatar_id":"","url":"https://api.github.com/users/rekliner","html_url":"https://github.com/rekliner","followers_url":"https://api.github.com/users/rekliner/followers","following_url":"https://api.github.com/users/rekliner/following{/other_user}","gists_url":"https://api.github.com/users/rekliner/gists{/gist_id}","starred_url":"https://api.github.com/users/rekliner/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/rekliner/subscriptions","organizations_url":"https://api.github.com/users/rekliner/orgs","repos_url":"https://api.github.com/users/rekliner/repos","events_url":"https://api.github.com/users/rekliner/events{/privacy}","received_events_url":"https://api.github.com/users/rekliner/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"@Ivorforce OpenSL doesn't have a way of checking against android device support, it's a limitation of that library and probably one of the reasons there was effort made towards switching to Oboe.  The _sanitize_mix_rate() wrapper will force it to known OpenSL samplerates...if the project setting isn't found in the OpenSL set it falls back to the default samplerate of 44100 for backwards compatibility with the current hardcoded implementation.. It's not blindly trusting _get_configured_mix_rate().  \r\n\r\nDo you mean the OpenSL rates themselves might not be supported? There will be audio regardless...the Android system will resample to the device's native samplerate if it doesn't support one of the 13 default OpenSL ES samplerates...that's what's happening now when it gets the 44100 value on most devices.","created_at":"2026-09-03T18:45:32Z","updated_at":"2026-09-03T18:46:51Z","html_url":"https://github.com/godotengine/godot/pull/121515#discussion_r3927625816","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/121515","_links":{"self":{"href":"https://api.github.com/repos/godotengine/godot/pulls/comments/3927625816"},"html":{"href":"https://github.com/godotengine/godot/pull/121515#discussion_r3927625816"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/121515"}},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/3927625816/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":null,"original_line":93,"side":"RIGHT","in_reply_to_id":3927353640,"author_association":"NONE","original_position":23,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/3927907840","pull_request_review_id":5105899301,"id":3927907840,"node_id":"PRRC_kwDOAO6SJc7qHx4A","diff_hunk":"@@ -80,8 +79,19 @@ void AudioDriverOpenSL::_buffer_callbacks(\n \n \tad->_buffer_callback(queueItf);\n }\n+static int _sanitize_mix_rate(int p_mix_rate) {\n+\tstatic const int opensl_rates[] = { SL_SAMPLINGRATE_8, SL_SAMPLINGRATE_11_025, SL_SAMPLINGRATE_12, SL_SAMPLINGRATE_16, SL_SAMPLINGRATE_22_05, SL_SAMPLINGRATE_24, SL_SAMPLINGRATE_32, SL_SAMPLINGRATE_44_1, SL_SAMPLINGRATE_48, SL_SAMPLINGRATE_64, SL_SAMPLINGRATE_88_2, SL_SAMPLINGRATE_96, SL_SAMPLINGRATE_192 };\n+\tfor (const int samplerate : opensl_rates) {\n+\t\tif (p_mix_rate == samplerate / 1000) {\n+\t\t\treturn p_mix_rate;\n+\t\t}\n+\t}\n+\treturn AudioDriverOpenSL::DEFAULT_MIX_RATE;\n+}\n \n Error AudioDriverOpenSL::init() {\n+\tmix_rate = _sanitize_mix_rate(_get_configured_mix_rate());","path":"platform/android/audio_driver_opensl.cpp","commit_id":"171f34af1c1613126c6ed7297d247dd78b93d8c0","original_commit_id":"0da35139d9802d4413060b8fb62f8554387e97bb","user":{"login":"Ivorforce","id":2308167,"node_id":"MDQ6VXNlcjIzMDgxNjc=","avatar_url":"https://avatars.githubusercontent.com/u/2308167?v=4","gravatar_id":"","url":"https://api.github.com/users/Ivorforce","html_url":"https://github.com/Ivorforce","followers_url":"https://api.github.com/users/Ivorforce/followers","following_url":"https://api.github.com/users/Ivorforce/following{/other_user}","gists_url":"https://api.github.com/users/Ivorforce/gists{/gist_id}","starred_url":"https://api.github.com/users/Ivorforce/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Ivorforce/subscriptions","organizations_url":"https://api.github.com/users/Ivorforce/orgs","repos_url":"https://api.github.com/users/Ivorforce/repos","events_url":"https://api.github.com/users/Ivorforce/events{/privacy}","received_events_url":"https://api.github.com/users/Ivorforce/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"> OpenSL doesn't have a way of checking against android device support\r\n\r\nThat might be true, i don't know much about android. My cursory search found [`AudioManager.PROPERTY_OUTPUT_SAMPLE_RATE`](https://developer.android.com/ndk/guides/audio/opensl/opensl-prog-notes) - i assume it doesn't work?\r\n\r\n> The _sanitize_mix_rate() wrapper will force it to known OpenSL samplerates\r\n\r\nAha. Well if that's true, the resampling isn't ideal but better than no sound.\r\nI'd probably still just use 44.1khz, since it's near universal I'd guess it's very likely to work - more than some of the other frame rates OpenSL theoretically supports anyway. Without a way to query i wouldn't take the chance. But i'll leave that to the android maintainers to judge.","created_at":"2026-09-03T19:20:42Z","updated_at":"2026-09-03T19:33:30Z","html_url":"https://github.com/godotengine/godot/pull/121515#discussion_r3927907840","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/121515","_links":{"self":{"href":"https://api.github.com/repos/godotengine/godot/pulls/comments/3927907840"},"html":{"href":"https://github.com/godotengine/godot/pull/121515#discussion_r3927907840"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/121515"}},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/3927907840/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":null,"original_line":93,"side":"RIGHT","in_reply_to_id":3927353640,"author_association":"MEMBER","original_position":23,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/3928532747","pull_request_review_id":5106624065,"id":3928532747,"node_id":"PRRC_kwDOAO6SJc7qKKcL","diff_hunk":"@@ -80,8 +79,19 @@ void AudioDriverOpenSL::_buffer_callbacks(\n \n \tad->_buffer_callback(queueItf);\n }\n+static int _sanitize_mix_rate(int p_mix_rate) {\n+\tstatic const int opensl_rates[] = { SL_SAMPLINGRATE_8, SL_SAMPLINGRATE_11_025, SL_SAMPLINGRATE_12, SL_SAMPLINGRATE_16, SL_SAMPLINGRATE_22_05, SL_SAMPLINGRATE_24, SL_SAMPLINGRATE_32, SL_SAMPLINGRATE_44_1, SL_SAMPLINGRATE_48, SL_SAMPLINGRATE_64, SL_SAMPLINGRATE_88_2, SL_SAMPLINGRATE_96, SL_SAMPLINGRATE_192 };\n+\tfor (const int samplerate : opensl_rates) {\n+\t\tif (p_mix_rate == samplerate / 1000) {\n+\t\t\treturn p_mix_rate;\n+\t\t}\n+\t}\n+\treturn AudioDriverOpenSL::DEFAULT_MIX_RATE;\n+}\n \n Error AudioDriverOpenSL::init() {\n+\tmix_rate = _sanitize_mix_rate(_get_configured_mix_rate());","path":"platform/android/audio_driver_opensl.cpp","commit_id":"171f34af1c1613126c6ed7297d247dd78b93d8c0","original_commit_id":"0da35139d9802d4413060b8fb62f8554387e97bb","user":{"login":"rekliner","id":4936039,"node_id":"MDQ6VXNlcjQ5MzYwMzk=","avatar_url":"https://avatars.githubusercontent.com/u/4936039?v=4","gravatar_id":"","url":"https://api.github.com/users/rekliner","html_url":"https://github.com/rekliner","followers_url":"https://api.github.com/users/rekliner/followers","following_url":"https://api.github.com/users/rekliner/following{/other_user}","gists_url":"https://api.github.com/users/rekliner/gists{/gist_id}","starred_url":"https://api.github.com/users/rekliner/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/rekliner/subscriptions","organizations_url":"https://api.github.com/users/rekliner/orgs","repos_url":"https://api.github.com/users/rekliner/repos","events_url":"https://api.github.com/users/rekliner/events{/privacy}","received_events_url":"https://api.github.com/users/rekliner/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"Interesting approach with [PROPERTY_OUTPUT_SAMPLE_RATE](https://developer.android.com/ndk/guides/audio/opensl/opensl-prog-notes) .. going outside the driver and checking the system directly. That would solve the performance issue by ignoring _get_configured_mix_rate() entirely....which is fine with me!  It doesn't matter what the app intended to use, it'll be converted to the native rate eventually anyway (which google says is almost always 48k now).  There is the small issue of .005%-ish of users still on older android devices without API Level 17, so it would be kosher to add a version check that falls back to the default.  I'll work on squashing in an update with all this tonight.","created_at":"2026-09-03T20:41:33Z","updated_at":"2026-09-03T20:41:33Z","html_url":"https://github.com/godotengine/godot/pull/121515#discussion_r3928532747","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/121515","_links":{"self":{"href":"https://api.github.com/repos/godotengine/godot/pulls/comments/3928532747"},"html":{"href":"https://github.com/godotengine/godot/pull/121515#discussion_r3928532747"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/121515"}},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/3928532747/reactions","total_count":1,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":1,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":null,"original_line":93,"side":"RIGHT","in_reply_to_id":3927353640,"author_association":"NONE","original_position":23,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/3998190793","pull_request_review_id":5188864557,"id":3998190793,"node_id":"PRRC_kwDOAO6SJc7uT4zJ","diff_hunk":"@@ -80,8 +79,19 @@ void AudioDriverOpenSL::_buffer_callbacks(\n \n \tad->_buffer_callback(queueItf);\n }\n+static int _sanitize_mix_rate(int p_mix_rate) {\n+\tstatic const int opensl_rates[] = { SL_SAMPLINGRATE_8, SL_SAMPLINGRATE_11_025, SL_SAMPLINGRATE_12, SL_SAMPLINGRATE_16, SL_SAMPLINGRATE_22_05, SL_SAMPLINGRATE_24, SL_SAMPLINGRATE_32, SL_SAMPLINGRATE_44_1, SL_SAMPLINGRATE_48, SL_SAMPLINGRATE_64, SL_SAMPLINGRATE_88_2, SL_SAMPLINGRATE_96, SL_SAMPLINGRATE_192 };\n+\tfor (const int samplerate : opensl_rates) {\n+\t\tif (p_mix_rate == samplerate / 1000) {\n+\t\t\treturn p_mix_rate;\n+\t\t}\n+\t}\n+\treturn AudioDriverOpenSL::DEFAULT_MIX_RATE;\n+}\n \n Error AudioDriverOpenSL::init() {\n+\tmix_rate = _sanitize_mix_rate(_get_configured_mix_rate());","path":"platform/android/audio_driver_opensl.cpp","commit_id":"171f34af1c1613126c6ed7297d247dd78b93d8c0","original_commit_id":"0da35139d9802d4413060b8fb62f8554387e97bb","user":{"login":"rekliner","id":4936039,"node_id":"MDQ6VXNlcjQ5MzYwMzk=","avatar_url":"https://avatars.githubusercontent.com/u/4936039?v=4","gravatar_id":"","url":"https://api.github.com/users/rekliner","html_url":"https://github.com/rekliner","followers_url":"https://api.github.com/users/rekliner/followers","following_url":"https://api.github.com/users/rekliner/following{/other_user}","gists_url":"https://api.github.com/users/rekliner/gists{/gist_id}","starred_url":"https://api.github.com/users/rekliner/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/rekliner/subscriptions","organizations_url":"https://api.github.com/users/rekliner/orgs","repos_url":"https://api.github.com/users/rekliner/repos","events_url":"https://api.github.com/users/rekliner/events{/privacy}","received_events_url":"https://api.github.com/users/rekliner/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"I took the route of using GodotIOJavaWrapper to get PROPERTY_OUTPUT_SAMPLE_RATE.  After making that trip it would've been silly not to get PROPERTY_OUTPUT_FRAMES_PER_BUFFER as well since buffer_size was similarly hardocded.  This will allow android apps to use the optimal native audio settings reported by the device.  It will be a huge performance upgrade over the 44100 x 1024 that's been locked in for 13 years.  I put in a lot of handling for exceptions which always falls back to the previous hardcoded values for backwards compatibility. The API Level 17 worry ended up being nothing since Godot doesn't even support below level 24.","created_at":"2026-09-13T01:02:04Z","updated_at":"2026-09-13T01:02:04Z","html_url":"https://github.com/godotengine/godot/pull/121515#discussion_r3998190793","pull_request_url":