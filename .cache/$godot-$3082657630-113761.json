","created_at":"0001-01-01T00:00:00Z","followers":0,"following":0,"html_url":"https://github.com/syntaxerror247","id":176927541,"node_id":"U_kgDOCouzNQ","login":"syntaxerror247","type":"User","owned_private_repos":0,"public_gists":0,"public_repos":0,"total_private_repos":0,"url":"https://api.github.com/users/syntaxerror247"},"body":"","html_url":"https://github.com/godotengine/godot/pull/113761#pullrequestreview-3714546994","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/113761","author_association":"MEMBER","submitted_at":"2026-01-28T04:39:43Z"},{"id":3718622482,"node_id":"PRR_kwDOAO6SJc7dpa0S","state":"COMMENTED","user":{"site_admin":false,"suspended":false,"updated_at":"0001-01-01T00:00:00Z","avatar_url":"https://avatars.githubusercontent.com/u/914968?u=5f2b0cb28e37393252e96695f2eaa33494930285&v=4","created_at":"0001-01-01T00:00:00Z","followers":0,"following":0,"html_url":"https://github.com/m4gr3d","id":914968,"node_id":"MDQ6VXNlcjkxNDk2OA==","login":"m4gr3d","type":"User","owned_private_repos":0,"public_gists":0,"public_repos":0,"total_private_repos":0,"url":"https://api.github.com/users/m4gr3d"},"body":"","html_url":"https://github.com/godotengine/godot/pull/113761#pullrequestreview-3718622482","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/113761","author_association":"CONTRIBUTOR","submitted_at":"2026-01-28T19:16:27Z"},{"id":3719023131,"node_id":"PRR_kwDOAO6SJc7dq8ob","state":"CHANGES_REQUESTED","user":{"site_admin":false,"suspended":false,"updated_at":"0001-01-01T00:00:00Z","avatar_url":"https://avatars.githubusercontent.com/u/17489292?u=34072b401722100a7c0c0d61e37b376cf22b4545&v=4","created_at":"0001-01-01T00:00:00Z","followers":0,"following":0,"html_url":"https://github.com/Repiteo","id":17489292,"node_id":"MDQ6VXNlcjE3NDg5Mjky","login":"Repiteo","type":"User","owned_private_repos":0,"public_gists":0,"public_repos":0,"total_private_repos":0,"url":"https://api.github.com/users/Repiteo"},"body":"Oof, that error is a wonky one. It must be setting off from the changes made to [accomodate mingw-llvm](https://github.com/godotengine/godot/pull/113857), but that's now overlapping with Android clang. I think this can be safely fixed like this:\r\n```diff\r\n modules/text_server_adv/text_server_adv.h | 4 ++--\r\n 1 file changed, 2 insertions(+), 2 deletions(-)\r\n\r\ndiff --git a/modules/text_server_adv/text_server_adv.h b/modules/text_server_adv/text_server_adv.h\r\nindex a04c23bdfc..ae55824f85 100644\r\n--- a/modules/text_server_adv/text_server_adv.h\r\n+++ b/modules/text_server_adv/text_server_adv.h\r\n@@ -95,7 +95,7 @@ using namespace godot;\r\n // Thirdparty headers.\r\n \r\n GODOT_GCC_WARNING_PUSH_AND_IGNORE(\"-Wshadow\")\r\n-#if defined(__EMSCRIPTEN__) || __clang_major__ >= 21\r\n+#if defined(__EMSCRIPTEN__) || (defined(__MINGW32__) && __clang_major__ >= 21)\r\n GODOT_CLANG_WARNING_PUSH_AND_IGNORE(\"-Wunnecessary-virtual-specifier\")\r\n #endif\r\n \r\n@@ -113,7 +113,7 @@ GODOT_CLANG_WARNING_PUSH_AND_IGNORE(\"-Wunnecessary-virtual-specifier\")\r\n #include <unicode/utypes.h>\r\n \r\n GODOT_GCC_WARNING_POP\r\n-#if defined(__EMSCRIPTEN__) || __clang_major__ >= 21\r\n+#if defined(__EMSCRIPTEN__) || (defined(__MINGW32__) && __clang_major__ >= 21)\r\n GODOT_CLANG_WARNING_POP\r\n #endif\r\n \r\n```","html_url":"https://github.com/godotengine/godot/pull/113761#pullrequestreview-3719023131","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/113761","author_association":"CONTRIBUTOR","submitted_at":"2026-01-28T20:30:33Z"},{"id":3719613128,"node_id":"PRR_kwDOAO6SJc7dtMrI","state":"APPROVED","commit_id":"e86050e745ec8b2a2035744cc6a14cbbe2e75e33","user":{"site_admin":false,"suspended":false,"updated_at":"0001-01-01T00:00:00Z","avatar_url":"https://avatars.githubusercontent.com/u/17489292?u=34072b401722100a7c0c0d61e37b376cf22b4545&v=4","created_at":"0001-01-01T00:00:00Z","followers":0,"following":0,"html_url":"https://github.com/Repiteo","id":17489292,"node_id":"MDQ6VXNlcjE3NDg5Mjky","login":"Repiteo","type":"User","owned_private_repos":0,"public_gists":0,"public_repos":0,"total_private_repos":0,"url":"https://api.github.com/users/Repiteo"},"body":"","html_url":"https://github.com/godotengine/godot/pull/113761#pullrequestreview-3719613128","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/113761","author_association":"CONTRIBUTOR","submitted_at":"2026-01-28T23:13:33Z"}]