[{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2601837198","html_url":"https://github.com/godotengine/godot/issues/101823#issuecomment-2601837198","issue_url":"https://api.github.com/repos/godotengine/godot/issues/101823","id":2601837198,"node_id":"IC_kwDOAO6SJc6bFOKO","user":{"login":"rburing","id":229837,"node_id":"MDQ6VXNlcjIyOTgzNw==","avatar_url":"https://avatars.githubusercontent.com/u/229837?v=4","gravatar_id":"","url":"https://api.github.com/users/rburing","html_url":"https://github.com/rburing","followers_url":"https://api.github.com/users/rburing/followers","following_url":"https://api.github.com/users/rburing/following{/other_user}","gists_url":"https://api.github.com/users/rburing/gists{/gist_id}","starred_url":"https://api.github.com/users/rburing/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/rburing/subscriptions","organizations_url":"https://api.github.com/users/rburing/orgs","repos_url":"https://api.github.com/users/rburing/repos","events_url":"https://api.github.com/users/rburing/events{/privacy}","received_events_url":"https://api.github.com/users/rburing/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-01-20T09:13:23Z","updated_at":"2025-01-20T09:13:23Z","body":"Please add the MRP (e.g. just the project that you already have based on the screenshot) to make it easier for Godot/Jolt devs to investigate. Thank you.","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2601837198/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2602300887","html_url":"https://github.com/godotengine/godot/issues/101823#issuecomment-2602300887","issue_url":"https://api.github.com/repos/godotengine/godot/issues/101823","id":260