mihe/subscriptions","organizations_url":"https://api.github.com/users/mihe/orgs","repos_url":"https://api.github.com/users/mihe/repos","events_url":"https://api.github.com/users/mihe/events{/privacy}","received_events_url":"https://api.github.com/users/mihe/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-01-24T01:29:38Z","updated_at":"2025-01-25T15:37:22Z","body":"@cgodley I'm not quite sure what I should be looking for. Your ragdoll seems to explode when leaving the physics engine set to `DEFAULT` (i.e. `GodotPhysics3D`), but seems to work just fine when setting it to `Jolt Physics`?","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2611352886/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":{"reason":"resolved"}},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2611367206","html_url":"https://github.com/godotengine/godot/issues/101823#issuecomment-2611367206","issue_url":"https://api.github.com/repos/godotengine/godot/issues/101823","id":2611367206,"node_id":"IC_kwDOAO6SJc6bpk0m","user":{"login":"cgodley","id":1012191,"node_id":"MDQ6VXNlcjEwMTIxOTE=","avatar_url":"https://avatars.githubusercontent.com/u/1012191?v=4","gravatar_id":"","url":"https://api.github.com/users/cgodley","html_url":"https://github.com/cgodley","followers_url":"https://api.github.com/users/cgodley/followers","following_url":"https://api.github.com/users/cgodley/following{/other_user}","gists_url":"https://api.github.com/users/cgodley/gists{/gist_id}","starred_url":"https://api.github.com/users/cgodley/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/cgodley/subscriptions","organizations_url":"https://api.github.com/users/cgodley/orgs","repos_url":"https://api.github.com/users/cgodley/repos","events_url":"https://api.githu