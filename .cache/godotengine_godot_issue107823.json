OAO6SJc8AAAAB4iS2Xw","url":"https://api.github.com/repos/godotengine/godot/labels/cherrypick:4.4","name":"cherrypick:4.4","color":"446699","default":false,"description":"Considered for cherry-picking into a future 4.4.x release","archived_at":null,"archived_by":null}],"state":"closed","locked":false,"assignees":[],"milestone":{"url":"https://api.github.com/repos/godotengine/godot/milestones/22","html_url":"https://github.com/godotengine/godot/milestone/22","labels_url":"https://api.github.com/repos/godotengine/godot/milestones/22/labels","id":12070367,"node_id":"MI_kwDOAO6SJc4AuC3f","number":22,"title":"4.5","description":"","creator":{"login":"Sauermann","id":6299227,"node_id":"MDQ6VXNlcjYyOTkyMjc=","avatar_url":"https://avatars.githubusercontent.com/u/6299227?v=4","gravatar_id":"","url":"https://api.github.com/users/Sauermann","html_url":"https://github.com/Sauermann","followers_url":"https://api.github.com/users/Sauermann/followers","following_url":"https://api.github.com/users/Sauermann/following{/other_user}","gists_url":"https://api.github.com/users/Sauermann/gists{/gist_id}","starred_url":"https://api.github.com/users/Sauermann/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Sauermann/subscriptions","organizations_url":"https://api.github.com/users/Sauermann/orgs","repos_url":"https://api.github.com/users/Sauermann/repos","events_url":"https://api.github.com/users/Sauermann/events{/privacy}","received_events_url":"https://api.github.com/users/Sauermann/received_events","type":"User","user_view_type":"public","site_admin":false},"open_issues":3,"closed_issues":3687,"state":"closed","created_at":"2024-12-19T08:51:28Z","updated_at":"2026-09-04T21:48:38Z","due_on":"2025-09-15T00:00:00Z","closed_at":"2025-09-18T17:13:14Z"},"comments":2,"created_at":"2025-06-21T21:05:10Z","updated_at":"2025-06-25T20:30:08Z","closed_at":"2025-06-25T20:20:56Z","assignee":null,"author_association":"MEMBER","issue_field_values":[],"type":null,"active_lock_reason":null,"draft":false,"pull_request":{"url":"https://api.github.com/repos/godotengine/godot/pulls/107823","html_url":"https://github.com/godotengine/godot/pull/107823","diff_url":"https://github.com/godotengine/godot/pull/107823.diff","patch_url":"https://github.com/godotengine/godot/pull/107823.patch","merged_at":"2025-06-25T20:20:56Z"},"body":"Closes #70205\r\n\r\n> Note that a property must be present in [method get_property_list], otherwise this method will not be called.\r\n\r\nSo this note is wrong, but _not entirely_.\r\n\r\nSee, `_set()`/`_get()` are called when calling `set()`/`get()` on an object, with property name that doesn't match any built-in property. So you can do `object.get(\"this_property_totally_exists_trust_me\")`, and `_get()` will be called with this property name.\r\n\r\nWhen `_get_property_list()` matters is when inspecting or serializing the object. The editor/serializer must know that property \"exists\" and will call `set()`/`get()` on whatever is returned by `get_property_list()`. But if a property is not defined, nothing is stopping you from manually accessing it.\r\n\r\nFeel free to suggest how to better convey this information. Or maybe the description is already fine, idk.","closed_by":{"login":"Repiteo","id":17489292,"node_id":"MDQ6VXNlcjE3NDg5Mjky","avatar_url":"https://avatars.githubusercontent.com/u/17489292?v=4","gravatar_id":"","url":"https://api.github.com/users/Repiteo","html_url":"https://github.com/Repiteo","followers_url":"https://api.github.com/users/Repiteo/followers","following_url":"https://api.github.com/users/Repiteo/following{/other_user}","gists_url":"https://api.github.com/users/Repiteo/gists{/gist_id}","starred_url":"https://api.github.com/users/Repiteo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Repiteo/subscriptions","organizations_url":"https://api.github.com/users/Repiteo/orgs","repos_url":"https://api.github.com/users/Repiteo/repos","events_url":"https://api.github.com/users/Repiteo/events{/privacy}","received_events_url":"https://api.github.com/users/Repiteo/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/107823/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/godotengine/godot/issues/107823/timeline","performed_via_github_app":null,"state_reason":null}