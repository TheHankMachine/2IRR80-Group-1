[{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2807751450","html_url":"https://github.com/godotengine/godot/pull/105405#issuecomment-2807751450","issue_url":"https://api.github.com/repos/godotengine/godot/issues/105405","id":2807751450,"node_id":"IC_kwDOAO6SJc6nWuMa","user":{"login":"lodetrick","id":146759331,"node_id":"U_kgDOCL9eow","avatar_url":"https://avatars.githubusercontent.com/u/146759331?v=4","gravatar_id":"","url":"https://api.github.com/users/lodetrick","html_url":"https://github.com/lodetrick","followers_url":"https://api.github.com/users/lodetrick/followers","following_url":"https://api.github.com/users/lodetrick/following{/other_user}","gists_url":"https://api.github.com/users/lodetrick/gists{/gist_id}","starred_url":"https://api.github.com/users/lodetrick/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/lodetrick/subscriptions","organizations_url":"https://api.github.com/users/lodetrick/orgs","repos_url":"https://api.github.com/users/lodetrick/repos","events_url":"https://api.github.com/users/lodetrick/events{/privacy}","received_events_url":"https://api.github.com/users/lodetrick/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-04-15T23:23:11Z","updated_at":"2025-04-15T23:23:11Z","body":"I tried to make the changes without modifying object.h and object.cpp but the linux checks were failing because the object class didn't have the function. I'd rather not introduce a function that does nothing, but is there an alternative?","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2807751450/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2808670671","html_url":"https://github.com/godotengine/godot/pull/105405#issuecommen