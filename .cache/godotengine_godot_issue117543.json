ived_at":null,"archived_by":null},{"id":2666705648,"node_id":"MDU6TGFiZWwyNjY2NzA1NjQ4","url":"https://api.github.com/repos/godotengine/godot/labels/topic:animation","name":"topic:animation","color":"ffee88","default":false,"description":"","archived_at":null,"archived_by":null}],"state":"open","locked":false,"assignees":[],"milestone":{"url":"https://api.github.com/repos/godotengine/godot/milestones/25","html_url":"https://github.com/godotengine/godot/milestone/25","labels_url":"https://api.github.com/repos/godotengine/godot/milestones/25/labels","id":15520464,"node_id":"MI_kwDOAO6SJc4A7NLQ","number":25,"title":"4.8","description":"","creator":{"login":"Repiteo","id":17489292,"node_id":"MDQ6VXNlcjE3NDg5Mjky","avatar_url":"https://avatars.githubusercontent.com/u/17489292?v=4","gravatar_id":"","url":"https://api.github.com/users/Repiteo","html_url":"https://github.com/Repiteo","followers_url":"https://api.github.com/users/Repiteo/followers","following_url":"https://api.github.com/users/Repiteo/following{/other_user}","gists_url":"https://api.github.com/users/Repiteo/gists{/gist_id}","starred_url":"https://api.github.com/users/Repiteo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Repiteo/subscriptions","organizations_url":"https://api.github.com/users/Repiteo/orgs","repos_url":"https://api.github.com/users/Repiteo/repos","events_url":"https://api.github.com/users/Repiteo/events{/privacy}","received_events_url":"https://api.github.com/users/Repiteo/received_events","type":"User","user_view_type":"public","site_admin":false},"open_issues":341,"closed_issues":2335,"state":"open","created_at":"2026-04-13T15:59:35Z","updated_at":"2026-10-22T03:07:42Z","due_on":null,"closed_at":null},"comments":0,"created_at":"2026-03-17T23:10:47Z","updated_at":"2026-06-18T12:06:18Z","closed_at":null,"assignee":null,"author_association":"CONTRIBUTOR","issue_field_values":[],"type":null,"active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"### Tested versions\n\n- Reproducible in: v4.7.dev\n\n### System information\n\nGodot v4.7.dev (f9a8302c8) - Windows 11 (build 22631) - Multi-window, 3 monitors - Direct3D 12 (Forward+) - dedicated NVIDIA GeForce RTX 3070 (NVIDIA; 32.0.15.8088) - AMD Ryzen 9 7950X 16-Core Processor (32 threads) - 31.15 GiB memory\n\n### Issue description\n\nThe Animation editor has an `Alt + Shift + A` shortcut for `Go to Previous Keyframe`. When the timeline's position is at a keyframe and `Apply snapping to timeline cursor` is disabled, the shortcut doesn't work the first time. We have to press it twice to actually go to the previous keyframe.\n\nAlso, when cursor snapping is enabled, but the snapping step is too small, like 0.002, the same issue occurs with `Go to Next Keyframe`. It needs to be pressed twice, depending on the keyframe's time.\n\n### Steps to reproduce\n\n- On the MRP, make sure \"Apply snapping to timeline cursor\" is disabled (snapping step is 0.0333)\n- Place the timeline's cursor between the second-to-last and last keyframe of `combat_animations/animation` \n- Press `Alt + Shift + A`, it goes to the previous frame.\n- Press `Alt + Shift + A`, it doesn't work.\n- Press `Alt + Shift + A` again, now it goes to the previous frame.\n\nAlso\n\n- Enable \"Apply snapping to timeline cursor\" and set the snapping step as 0.0002\n- Place the timeline's cursor at the start of the `combat_animations/animation`\n- Press `Alt + Shift + D`, it goes to the previous frame.\n- Press `Alt + Shift + D`, it doesn't work.\n- Press `Alt + Shift + D` again, now it goes to the previous frame.\n\n### Minimal reproduction project (MRP)\n\n[go_to_keyframe_test_2026-04-13_16-15-31.zip](https://github.com/user-attachments/files/26686254/go_to_keyframe_test_2026-04-13_16-15-31.zip)","closed_by":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/117543/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/godotengine/godot/issues/117543/timeline","performed_via_github_app":null,"state_reason":null,"pinned_comment":null}