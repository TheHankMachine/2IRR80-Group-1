i.github.com/users/Kazox61/repos","events_url":"https://api.github.com/users/Kazox61/events{/privacy}","received_events_url":"https://api.github.com/users/Kazox61/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-02-19T15:05:14Z","updated_at":"2026-02-19T15:05:14Z","body":"Added the selection for the Resolution Presets to the Embedding Options.\r\n\r\nhttps://github.com/user-attachments/assets/4b1481c5-c275-479a-a6d1-164ae6fe2abe\r\n\r\n","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3927855066/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4735825553","html_url":"https://github.com/godotengine/godot/pull/111787#issuecomment-4735825553","issue_url":"https://api.github.com/repos/godotengine/godot/issues/111787","id":4735825553,"node_id":"IC_kwDOAO6SJc8AAAABGkb2kQ","user":{"login":"Calinou","id":180032,"node_id":"MDQ6VXNlcjE4MDAzMg==","avatar_url":"https://avatars.githubusercontent.com/u/180032?v=4","gravatar_id":"","url":"https://api.github.com/users/Calinou","html_url":"https://github.com/Calinou","followers_url":"https://api.github.com/users/Calinou/followers","following_url":"https://api.github.com/users/Calinou/following{/other_user}","gists_url":"https://api.github.com/users/Calinou/gists{/gist_id}","starred_url":"https://api.github.com/users/Calinou/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Calinou/subscriptions","organizations_url":"https://api.github.com/users/Calinou/orgs","repos_url":"https://api.github.com/users/Calinou/repos","events_url":"https://api.github.com/users/Calinou/events{/privacy}","received_events_url":"https://api.github.com/users/Calinou/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-06-17T21:46:01Z","updated_at":"2026-06-17T21:46:01Z","body":"@Kazox61 Can you look into rebasing this PR to fix merge conflicts? I'd like to review this for the 4.8 cycle.\r\n\r\nGiven the video in OP, I can give some early feedback still:\r\n\r\n- The dictionary keys should be String, not StringName. StringName should be reserved for strings that use very frequent lookups to benefit from string interning. Otherwise, it's not worth using  StringName.\r\n\r\n- The UX for editing settings isn't ideal, as the dictionary isn't typed and you can add invalid types as keys/values. Is it possible to use a typed dictionary for both new project settings?\r\n\r\n- Landscape and portrait hints for safe areas should be `.landscape` and `.portrait`. Like in [feature tags](https://docs.godotengine.org/en/latest/tutorials/export/feature_tags.html), we tend to avoid abbreviations for readability.\r\n  - Alternatively, is it possible to assume landscape mode for safe area definitions, and automatically rotate the area to match portrait mode when the viewport height is greater than the width? This would reduce the work needed to add a new device.\r\n\r\n- We should provide a few Android devices in the list as defaults. See the list in Chromium 150 (although we should use more recent devices):\r\n\r\n<img width=\"183\" height=\"411\" alt=\"image\" src=\"https://github.com/user-attachments/assets/92a61f9c-d867-49a3-a42e-105ea4a2f460\" />","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4735825553/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4741339306","html_url":"https://github.com/godotengine/godot/pull/111787#issuecomment-4741339306","issue_url":"https://api.github.com/repos/godotengine/godot/issues/111787","id":4741339306,"node_id":"IC_kwDOAO6SJc8AAAABGpsYqg","user":{"login":"Kazox61","id":93524528,"node_id":"U_kgDOBZMSMA","avatar_url":"https://avatars.githubusercontent.com/u/93524528?v=4","gravatar_id":"","url":"https://api.github.com/users/Kazox61","html_url":"https://github.com/Kazox61","followers_url":"https://api.github.com/users/Kazox61/followers","following_url":"https://api.github.com/users/Kazox61/following{/other_user}","gists_url":"https://api.github.com/users/Kazox61/gists{/gist_id}","starred_url":"https://api.github.com/users/Kazox61/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Kazox61/subscriptions","organizations_url":"https://api.github.com/users/Kazox61/orgs","repos_url":"https://api.github.com/users/Kazox61/repos","events_url":"https://api.github.com/users/Kazox61/events{/privacy}","received_events_url":"https://api.github.com/users/Kazox61/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-06-18T11:08:48Z","updated_at":"2026-06-18T11:08:48Z","body":"@Calinou I rebased and added all your suggestions.","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4741339306/reactions","total_count":1,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":1,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4797718312","html_url":"https://github.com/godotengine/godot/pull/111787#issuecomment-4797718312","issue_url":"https://api.github.com/repos/godotengine/godot/issues/111787","id":4797718312,"node_id":"IC_kwDOAO6SJc8AAAABHfdfKA","user":{"login":"Kazox61","id":93524528,"node_id":"U_kgDOBZMSMA","avatar_url":"https://avatars.githubusercontent.com/u/93524528?v=4","gravatar_id":"","url":"https://api.github.com/users/Kazox61","html_url":"https://github.com/Kazox61","followers_url":"https://api.github.com/users/Kazox61/followers","following_url":"https://api.github.com/users/Kazox61/following{/other_user}","gists_url":"https://api.github.com/users/Kazox61/gists{/gist_id}","starred_url":"https://api.github.com/users/Kazox61/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Kazox61/subscriptions","organizations_url":"https://api.github.com/users/Kazox61/orgs","repos_url":"https://api.github.com/users/Kazox61/repos","events_url":"https://api.github.com/users/Kazox61/events{/privacy}","received_events_url":"https://api.github.com/users/Kazox61/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-06-25T09:22:54Z","updated_at":"2026-06-25T09:22:54Z","body":"> When opening the editor, there is no resolution preset initially checked.\r\nInstead, the Default preset should be checked by default.\r\n\r\nFixed\r\n\r\n> With this PR, overrides set in the project settings are no longer obeyed when the resolution preset is set to Default\r\nInstead, it always uses the base window width/height defined in the project settings. This should be reverted to the previous behavior to match what happens when game embedding is disabled. The Default resolution text should also display the effective resolution that takes the override into account (if any).\r\n\r\nShould be fixed\r\n\r\n> The Samsung Galaxy S24 and S25 series presets have the exact same resolution. I suggest removing all Galaxy S24 entries to shorten the list.\r\nThe same goes for the OnePlus 12 and 13; you can remove the OnePlus 12 from the presets.\r\n\r\nDone \r\n\r\n> I noticed Android devices don't have a safe area defined in their presets. Is that intended?\r\n\r\nYes it is. Android doesn't have standardized safe area insets. The status bar and gesture bar heights vary by OEM, Android version, and user settings. Maybe we could use some default values there, but I don't know much about it so left them out for now.\r\n\r\n> The orientation project setting is incorrectly followed. All settings other than Landscape will use portrait mode for resolution presets. \r\nInstead, Landscape, Reverse Landscape and Sensor Landscape should use a landscape resolution.\r\n\r\nFixed\r\n\r\n> Resolution presets have no effect if the Stretch to Fit scale mode is selected in game embedding.\r\nTo allow for a smoother UX, I suggest automatically swapping back to Keep Aspect Ratio when selecting a preset. Also, when choosing Stretch to Fit, the previously selected preset should be unchecked in the list.\r\n\r\nSo you mean when \"Stretch to Fit\" is active and you select a preset, the \"Keep Aspect Ratio\" should be selected. And when you select  \"Stretch to Fit\" the selected preset should get unselected?\r\n\r\n> When choosing a preset, it enforces a maximum resolution and aspect ratio. It does not allow the viewport to render at a higher resolution than what's shown on screen, even when using the viewport stretch mode. This can result in different visuals than what you'll see on the target device due to the pixel count being different. Some shaders have resolution-dependent behavior, and of course, using the disabled stretch mode will also result in resolution-dependent visuals.\r\n\r\nAny idea how we can handle this?","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4797718312/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4802306890","html_url":"https://github.com/godotengine/godot/pull/111787#issuecomment-4802306890","issue_url":"https://api.github.com/repos/godotengine/godot/issues/111787","id":4802306890,"node_id":"IC_kwDOAO6SJc8AAAABHj1jSg","user":{"login":"Calinou","id":180032,"node_id":"MDQ6VXNlcjE4MDAzMg==","avatar_url":"https://avatars.githubusercontent.com/u/180032?v=4","gravatar_id":"","url":"https://api.github.com/users/Calinou","html_url":"https://github.com/Calinou","followers_url":"https://api.github.com/users/Calinou/followers","following_url":"https://api.github.com/users/Calinou/following{/other_user}","gists_url":"https://api.github.com/users/Calinou/gists{/gist_id}","starred_url":"https://api.github.com/users/Calinou/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Calinou/subscriptions","organizations_url":"https://api.github.com/users/Calinou/orgs","repos_url":"https://api.github.com/users/Calinou/repos","events_url":"https://api.github.com/users/Calinou/events{/privacy}","received_events_url":"https://api.github.com/users/Calinou/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-06-25T17:18:20Z","updated_at":"2026-06-25T17:18:20Z","body":"> So you mean when \"Stretch to Fit\" is active and you select a preset, the \"Keep Aspect Ratio\" should be selected. And when you select \"Stretch to Fit\" the selected preset should get unselected?\r\n\r\nYes :slightly_smiling_face: ","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4802306890/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4826085276","html_url":"https://github.com/godotengine/godot/pull/111787#issuecomment-4826085276","issue_url":"https://api.github.com/repos/godotengine/godot/issues/111787","id":4826085276,"node_id":"IC_kwDOAO6SJc8AAAABH6g3nA","user":{"login":"Kazox61","id":93524528,"node_id":"U_kgDOBZMSMA","avatar_url":"https://avatars.githubusercontent.com/u/93524528?v=4","gravatar_id":"","url":"https://api.github.com/users/Kazox61","html_url":"https://github.com/Kazox61","followers_url":"https://api.github.com/users/Kazox61/followers","following_url":"https://api.github.com/users/Kazox61/following{/other_user}","