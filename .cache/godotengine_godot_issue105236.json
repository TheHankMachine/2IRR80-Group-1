lt":false,"description":"","archived_at":null,"archived_by":null},{"id":279098219,"node_id":"MDU6TGFiZWwyNzkwOTgyMTk=","url":"https://api.github.com/repos/godotengine/godot/labels/topic:editor","name":"topic:editor","color":"ffee88","default":false,"description":"","archived_at":null,"archived_by":null}],"state":"closed","locked":false,"assignees":[],"milestone":{"url":"https://api.github.com/repos/godotengine/godot/milestones/23","html_url":"https://github.com/godotengine/godot/milestone/23","labels_url":"https://api.github.com/repos/godotengine/godot/milestones/23/labels","id":12939969,"node_id":"MI_kwDOAO6SJc4AxXLB","number":23,"title":"4.6","description":"","creator":{"login":"Repiteo","id":17489292,"node_id":"MDQ6VXNlcjE3NDg5Mjky","avatar_url":"https://avatars.githubusercontent.com/u/17489292?v=4","gravatar_id":"","url":"https://api.github.com/users/Repiteo","html_url":"https://github.com/Repiteo","followers_url":"https://api.github.com/users/Repiteo/followers","following_url":"https://api.github.com/users/Repiteo/following{/other_user}","gists_url":"https://api.github.com/users/Repiteo/gists{/gist_id}","starred_url":"https://api.github.com/users/Repiteo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Repiteo/subscriptions","organizations_url":"https://api.github.com/users/Repiteo/orgs","repos_url":"https://api.github.com/users/Repiteo/repos","events_url":"https://api.github.com/users/Repiteo/events{/privacy}","received_events_url":"https://api.github.com/users/Repiteo/received_events","type":"User","user_view_type":"public","site_admin":false},"open_issues":3,"closed_issues":2978,"state":"closed","created_at":"2025-05-22T16:25:52Z","updated_at":"2026-10-04T16:23:23Z","due_on":null,"closed_at":"2026-01-26T18:09:14Z"},"comments":10,"created_at":"2025-04-10T12:11:12Z","updated_at":"2026-01-28T13:32:04Z","closed_at":"2025-12-17T02:40:16Z","assignee":null,"author_association":"MEMBER","issue_field_values":[],"type":null,"active_lock_reason":null,"draft":false,"pull_request":{"url":"https://api.github.com/repos/godotengine/godot/pulls/105236","html_url":"https://github.com/godotengine/godot/pull/105236","diff_url":"https://github.com/godotengine/godot/pull/105236.diff","patch_url":"https://github.com/godotengine/godot/pull/105236.patch","merged_at":"2025-12-17T02:40:16Z"},"body":"Related to https://github.com/godotengine/godot-vscode-plugin/issues/842 (there is at least one other issue that makes the resolve not work).\r\nFixes https://github.com/GDQuest/zed-gdscript/issues/6\r\n\r\nSupersedes partially https://github.com/godotengine/godot/pull/103186 (this PR includes saveguards for all methods except `willSaveWaitUntil` and `didSave` which might still do weird stuff when editing non gdscript files).\r\n\r\nOur current approach for managing client owned content is as follows:\r\n- when the client sends changes we parse them and cache them\r\n- when we are interested in a file we look in the cache, if we don't have it we load it from disk\r\n\r\nThe catch: scripts with errors are cached differently, so if the client sends a change with parse errors it does not get cached correctly and subsequent requests (such as resolve) might reload the file from disk. Then the content that the server uses might not match with position information from the client which will result in early returns from the resolve endpoint.\r\n\r\nThis PR splits this solution up, by tracking client owned files separately from the parser cache (this is also relevant for https://github.com/godotengine/godot/pull/103186).\r\n\r\nIt also moves those caches to be per client, to prevent issues when multiple clients are connected.\r\n\r\nKnown issues:\r\n- https://github.com/godotengine/godot-vscode-plugin/issues/844\r\n\r\nTODO:\r\n- [x] Handle compatibility\r\n- [x] https://github.com/godotengine/godot/pull/104401 should be merged, since this PR relies on file paths to manage the index of client owned files.\r\n- [x] https://github.com/godotengine/godot-vscode-plugin/issues/844 should be resolved, since the VSCode extension would likely break if the server enforces the protocol","closed_by":{"login":"Repiteo","id":17489292,"node_id":"MDQ6VXNlcjE3NDg5Mjky","avatar_url":"https://avatars.githubusercontent.com/u/17489292?v=4","gravatar_id":"","url":"https://api.github.com/users/Repiteo","html_url":"https://github.com/Repiteo","followers_url":"https://api.github.com/users/Repiteo/followers","following_url":"https://api.github.com/users/Repiteo/following{/other_user}","gists_url":"https://api.github.com/users/Repiteo/gists{/gist_id}","starred_url":"https://api.github.com/users/Repiteo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Repiteo/subscriptions","organizations_url":"https://api.github.com/users/Repiteo/orgs","repos_url":"https://api.github.com/users/Repiteo/repos","events_url":"https://api.github.com/users/Repiteo/events{/privacy}","received_events_url":"https://api.github.com/users/Repiteo/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/105236/reactions","total_count":8,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":7,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/godotengine/godot/issues/105236/timeline","performed_via_github_app":null,"state_reason":null}