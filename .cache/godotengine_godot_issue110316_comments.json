[{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3266354132","html_url":"https://github.com/godotengine/godot/issues/110316#issuecomment-3266354132","issue_url":"https://api.github.com/repos/godotengine/godot/issues/110316","id":3266354132,"node_id":"IC_kwDOAO6SJc7CsJvU","user":{"login":"FFF27","id":19473020,"node_id":"MDQ6VXNlcjE5NDczMDIw","avatar_url":"https://avatars.githubusercontent.com/u/19473020?v=4","gravatar_id":"","url":"https://api.github.com/users/FFF27","html_url":"https://github.com/FFF27","followers_url":"https://api.github.com/users/FFF27/followers","following_url":"https://api.github.com/users/FFF27/following{/other_user}","gists_url":"https://api.github.com/users/FFF27/gists{/gist_id}","starred_url":"https://api.github.com/users/FFF27/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/FFF27/subscriptions","organizations_url":"https://api.github.com/users/FFF27/orgs","repos_url":"https://api.github.com/users/FFF27/repos","events_url":"https://api.github.com/users/FFF27/events{/privacy}","received_events_url":"https://api.github.com/users/FFF27/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-09-08T13:34:19Z","updated_at":"2025-09-08T20:03:26Z","body":"To access IME: (since there are no steps to reproduce)\n* Install Japanese language support:\n  * Settings App -> Time and Language -> Language and Region -> Add Language -> Japanese \n  * you MAY uncheck all optional features when asked\n* In Godot editor, open any gdscript file\n* In the taskbar, set your input language to Ⓙ Japanese and your input type to あ Hiragana\n* In the editor, type any Japanese word with multiple homophones such as 'san' and press SPACE","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3266354132/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_v