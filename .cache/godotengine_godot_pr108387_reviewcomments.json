 this can be handled in a separate PR","created_at":"2025-07-15T13:11:34Z","updated_at":"2025-07-15T13:11:34Z","html_url":"https://github.com/godotengine/godot/pull/108387#discussion_r2207440208","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/108387","_links":{"self":{"href":"https://api.github.com/repos/godotengine/godot/pulls/comments/2207440208"},"html":{"href":"https://github.com/godotengine/godot/pull/108387#discussion_r2207440208"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/108387"}},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/2207440208/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":243,"original_start_line":243,"start_side":"RIGHT","line":245,"original_line":245,"side":"RIGHT","in_reply_to_id":2206075270,"author_association":"CONTRIBUTOR","original_position":7,"position":7,"subject_type":"line"}]