rence112/following{/other_user}","gists_url":"https://api.github.com/users/clarence112/gists{/gist_id}","starred_url":"https://api.github.com/users/clarence112/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/clarence112/subscriptions","organizations_url":"https://api.github.com/users/clarence112/orgs","repos_url":"https://api.github.com/users/clarence112/repos","events_url":"https://api.github.com/users/clarence112/events{/privacy}","received_events_url":"https://api.github.com/users/clarence112/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-11-17T22:29:58Z","updated_at":"2025-11-17T22:29:58Z","body":"> What should we call `JOY_MODEL_STEAM_DECK` since Valve has announced the new Steam Controller with the same layout? :D\r\n\r\nMaybe just `JOY_MODEL_STEAM` ? Or keep as-is and add another entry for the controller, since it technically has that extra capacitive grip input that the deck doesn't, as well as traditional rumble motors in addition to haptics.  \r\nAnd maybe `JOY_MODEL_STEAM_LEGACY` or something for the original steam controller, too?  \r\n(idk if this is dependent on how SDL reports things tho, since I haven't looked too close at your code)","author_association":"NONE","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3544119996/reactions","total_count":1,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":1},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3544721854","html_url":"https://github.com/godotengine/godot/pull/112680#issuecomment-3544721854","issue_url":"https://api.github.com/repos/godotengine/godot/issues/112680","id":3544721854,"node_id":"IC_kwDOAO6SJc7TSCm-","user":{"login":"Nintorch","id":92302738,"node_id":"U_kgDOBYBtkg","avatar_url":"https://avatars.githubusercontent.com/u/92302738?v=4","gravatar_id":"","url":"https://api.github.com/users/Nintorch","html_url":"https://github.com/Nintorch","followers_url":"https://api.github.com/users/Nintorch/followers","following_url":"https://api.github.com/users/Nintorch/following{/other_user}","gists_url":"https://api.github.com/users/Nintorch/gists{/gist_id}","starred_url":"https://api.github.com/users/Nintorch/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Nintorch/subscriptions","organizations_url":"https://api.github.com/users/Nintorch/orgs","repos_url":"https://api.github.com/users/Nintorch/repos","events_url":"https://api.github.com/users/Nintorch/events{/privacy}","received_events_url":"https://api.github.com/users/Nintorch/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-11-18T02:15:03Z","updated_at":"2025-11-18T02:15:03Z","body":"> Or keep as-is and add another entry for the controller, since it technically has that extra capacitive grip input that the deck doesn't, as well as traditional rumble motors in addition to haptics\n\nHm, I think that's a good idea :D","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3544721854/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3547802821","html_url":"https://github.com/godotengine/godot/pull/112680#issuecomment-3547802821","issue_url":"https://api.github.com/repos/godotengine/godot/issues/112680","id":3547802821,"node_id":"IC_kwDOAO6SJc7TdyzF","user":{"login":"Nintorch","id":92302738,"node_id":"U_kgDOBYBtkg","avatar_url":"https://avatars.githubusercontent.com/u/92302738?v=4","gravatar_id":"","url":"https://api.github.com/users/Nintorch","html_url":"https://github.com/Nintorch","followers_url":"https://api.github.com/users/Nintorch/followers","following_url":"https://api.github.com/users/Nintorch/following{/other_user}","gists_url":"https://api.github.com/users/Nintorch/gists{/gist_id}","starred_url":"https://api.github.com/users/Nintorch/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Nintorch/subscriptions","organizations_url":"https://api.github.com/users/Nintorch/orgs","repos_url":"https://api.github.com/users/Nintorch/repos","events_url":"https://api.github.com/users/Nintorch/events{/privacy}","received_events_url":"https://api.github.com/users/Nintorch/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-11-18T14:09:13Z","updated_at":"2025-11-18T14:09:13Z","body":"Thank you for your review, AThousandShips! I included your suggested changes into the code!","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3547802821/reactions","total_count":1,"+1":0,"-1":0,"laugh":0,"hooray":1,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3559182920","html_url":"https://github.com/godotengine/godot/pull/112680#issuecomment-3559182920","issue_url":"https://api.github.com/repos/godotengine/godot/issues/112680","id":3559182920,"node_id":"IC_kwDOAO6SJc7UJNJI","user":{"login":"AL2009man","id":67606569,"node_id":"MDQ6VXNlcjY3NjA2NTY5","avatar_url":"https://avatars.githubusercontent.com/u/67606569?v=4","gravatar_id":"","url":"https://api.github.com/users/AL2009man","html_url":"https://github.com/AL2009man","followers_url":"https://api.github.com/users/AL2009man/followers","following_url":"https://api.github.com/users/AL2009man/following{/other_user}","gists_url":"https://api.github.com/users/AL2009man/gists{/gist_id}","starred_url":"https://api.github.com/users/AL2009man/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/AL2009man/subscriptions","organizations_url":"https://api.github.com/users/AL2009man/orgs","repos_url":"https://api.github.com/users/AL2009man/repos","events_url":"https://api.github.com/users/AL2009man/events{/privacy}","received_events_url":"https://api.github.com/users/AL2009man/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-11-20T17:17:06Z","updated_at":"2025-12-02T04:12:14Z","body":"> What should we call `JOY_MODEL_STEAM_DECK` since Valve has announced the new Steam Controller with the same layout? :D\r\n\r\nas of this writing: there isn't a Steam Hardware type for `SDL_GamepadType` yet (https://github.com/libsdl-org/SDL/issues/12250): you'd need to rely on something like `SDL_GetGamepadJoystick` and `SDL_GetJoystickVendor` for it. You'd need to grab the device's VID/PID (from [SDL/blob/main/src/joystick/controller_list.h](https://github.com/libsdl-org/SDL/blob/main/src/joystick/controller_list.h#L596)) and then do a make-shift Gamepad Type for Steam Controller (2015), Steam Deck and Steam Controller (2026)!\r\n\r\nthe bigger problem would be Steam Virtual Gamepad, as running the project under Steam's Game Mode on Steam Deck (in my testings) will hijack your custom Steam Hardware detection setup as a result. I've faced that problem myself while experimenting with it ([I have this example code, but don't use it](https://gist.github.com/AL2009man/ad5c41ce81bf81f2103c7ce23cc9829c)), and if it weren't for [VVVVVV's sourcecode](https://github.com/TerryCavanagh/VVVVVV/blob/master/desktop_version/src/ButtonGlyphs.cpp#L200): i would've been stuck.\r\n\r\nyou'd need to integrate `0x28de/0x11ff` (Steam Virtual Gamepad) into your existing SDL_GamepadGetType detection system just to avoid any sort of double input issues. the 0x11ff portion can be treated as a \"Joystick Device\", and assigned it as \"Steam Deck\". that'll address said issue.\r\n\r\nit's a bit annoying to deal with, but it'll have ot do.","author_association":"NONE","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3559182920/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3559237681","html_url":"https://github.com/godotengine/godot/pull/112680#issuecomment-3559237681","issue_url":"https://api.github.com/repos/godotengine/godot/issues/112680","id":3559237681,"node_id":"IC_kwDOAO6SJc7UJagx","user":{"login":"Nintorch","id":92302738,"node_id":"U_kgDOBYBtkg","avatar_url":"https://avatars.githubusercontent.com/u/92302738?v=4","gravatar_id":"","url":"https://api.github.com/users/Nintorch","html_url":"https://github.com/Nintorch","followers_url":"https://api.github.com/users/Nintorch/followers","following_url":"https://api.github.com/users/Nintorch/following{/other_user}","gists_url":"https://api.github.com/users/Nintorch/gists{/gist_id}","starred_url":"https://api.github.com/users/Nintorch/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Nintorch/subscriptions","organizations_url":"https://api.github.com/users/Nintorch/orgs","repos_url":"https://api.github.com/users/Nintorch/repos","events_url":"https://api.github.com/users/Nintorch/events{/privacy}","received_events_url":"https://api.github.com/users/Nintorch/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-11-20T17:29:11Z","updated_at":"2025-11-20T17:29:11Z","body":"> as of this writing: there isn't a Steam Hardware type for SDL_GamepadType yet (https://github.com/libsdl-org/SDL/issues/12250): you'd need to rely on something like SDL_GetGamepadJoystick and SDL_GetJoystickVendor for it. You'd need to grab the device's VID/PID (from [SDL/blob/main/src/joystick/controller_list.h](https://github.com/libsdl-org/SDL/blob/main/src/joystick/controller_list.h#L596)) and then do a make-shift Gamepad Type for Steam Controller (2015), Steam Deck and Steam Controller (2016)!\r\n\r\nThat's what I've done for `JoyModel::STEAM_DECK` :D\r\n\r\n> the bigger problem would be Steam Virtual Gamepad, as running the project under Steam's Game Mode on Steam Deck (in my testings) will hijack your custom Steam Hardware detection setup as a result. I've faced that problem myself while experimenting with it ([I have this example code, but don't use it](https://gist.github.com/AL2009man/ad5c41ce81bf81f2103c7ce23cc9829c)), and if it weren't for [VVVVVV's sourcecode](https://github.com/TerryCavanagh/VVVVVV/blob/master/desktop_version/src/ButtonGlyphs.cpp#L200): i would've been stuck.\r\n\r\nIf you mean we won't be able to get the type of the Steam Virtual Controller, I think SDL handles it for us since it works with Steam fairly well afaik.\r\n\r\n> you'd need to integrate 0x28de/0x11ff (Steam Virtual Gamepad) into your existing SDL_GamepadGetType detection system just to avoid any sort of double input issues. the 0x11ff portion can be treated as a \"Joystick Device\", and assigned it as \"Steam Deck\". that'll address said issue.\r\n\r\nIf you mean that the controllers will be duplicated when running with Steam, I think on Windows it should already work fine and on Linux/macOS it has been fixed with https://github.com/godotengine/godot/pull/108350 and https://github.com/godotengine/godot/pull/109283 . See also https://github.com/libsdl-org/SDL/blob/main/src/joystick/SDL_gamepad.c#L3249-L3253 and https://github.com/libsdl-org/SDL/blob/main/include/SDL3/SDL_hints.h#L984-L1000","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3559237681/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3559296331","html_url":"https://github.com/godotengine/godot/pull/112680#issuecomment-3559296331","issue_url":"https://api.github.com/repos/godotengine/godot/issues/112680","id":3559296331,"node_id":"IC_kwDOAO6SJc7UJo1L","user":{"login":"AL2009man","id":67606569,"node_id":"MDQ6VXNlcjY3NjA2NTY5","avatar_url":"https://avatars.githubusercontent.com/u/67606569?v=4","gravatar_id":"","url":"https://api.github.com/users/AL2009man","html_url":"https://github.com/AL2009man","followers_url":"https://api.github.com/users/AL2009man/followers","following_url":"https://api.github.com/users/AL2009man/following{/other_user}","gists_url":"https://api.github.com/users/AL2009man/gists{/gist_id}","starred_url":"https://api.github.com/users/AL2009man/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/AL2009man/subscriptions","organizations_url":"https://api.github.com/users/AL2009man/orgs","repos_url":"https://api.github.com/users/AL2009man/repos","events_url":"https://api.github.com/users/AL2009man/events{/privacy}","received_events_url":"https://api.github.com/users/AL2009man/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-11-20T17:45:44Z","updated_at":"2025-11-20T18:26:08Z","body":"> If you mean we won't be able to get the type of the Steam Virtual Controller, I think SDL handles it for us since it works with Steam fairly well afaik.\r\n\r\nMore about trying to get Steam Deck prompts to play nicely with Steam Deck's Game Mode\r\n\r\nIn my experimental testings: I've discovered that SDL under Steam Deck Inputs...under Game Mode just gives me Generic prompts. After searching around SDL code, I've discovered that `0x11ff` (Steam Virtual Gamepad) is basically it's own unique Controller Type, that outright ignores Steam Deck VID/PID. \r\n\r\nSince the experiment was done on a SDL2-based project, this might explain why PH3 Games' SDL Gamepad Type setup doesn't auto-detect it, since it'll use Xbox prompts by default...despite having Steam Deck prompts\r\n\r\nI found the best way to get Steam Virtual Gamepad to get proper Steam Deck prompts (on Steam Deck Inputs) is to give `0x11ff`, which I find ugly, but it's the best workaround for the time being. I'm still trying to find the best solution without resorting to that problematic setup tho.\r\n\r\nedit: just tried to workaround it, no dice. seems like the best way to avoid this problem is by adding \"Steam Virtual Gamepad\" Controller Type as a workaround, but i encourage experimenting with it first via Steam Deck.","author_association":"NONE","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3559296331/reactions","total_count":1,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":1},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3562002888","html_url":"https://github.com/godotengine/godot/pull/112680#issuecomment-3562002888","issue_url":"https://api.github.com/repos/godotengine/godot/issues/112680","id":3562002888,"node_id":"IC_kwDOAO6SJc7UT9nI","user":{"login":"Nintorch","id":92302738,"node_id":"U_kgDOBYBtkg","avatar_url":"https://avatars.githubusercontent.com/u/92302738?v=4","gravatar_id":"","url":"https://api.github.com/users/Nintorch","html_url":"https://github.com/Nintorch","followers_url":"https://api.github.com/users/Nintorch/followers","following_url":"https://api.github.com/users/Nintorch/following{/other_user}","gists_url":"https://api.github.com/users/Nintorch/gists{/gist_id}","starred_url":"https://api.github.com/users/Nintorch/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Nintorch/subscriptions","organizations_url":"https://api.github.com/users/Nintorch/orgs","repos_url":"https://api.github.com/users/Nintorch/repos","events_url":"https://api.github.com/users/Nintorch/events{/privacy}","received_events_url":"https://api.github.com/users/Nintorch/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-11-21T08:44:36Z","updated_at":"2025-11-21T08:44:36Z","body":"Should this PR also expose the number of buttons and axes on a joypad, or that seems unnecessary?","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3562002888/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3565287369","html_url":"https://github.com/godotengine/godot/pull/112680#issuecomment-3565287369","issue_url":"https://api.github.com/repos/godotengine/godot/issues/112680","id":3565287369,"node_id":"IC_kwDOAO6SJc7UgffJ","user":{"login":"clarence112","id":20058567,"node_id":"MDQ6VXNlcjIwMDU4NTY3","avatar_url":"https://avatars.githubusercontent.com/u/20058567?v=4","gravatar_id":"","url":"https://api.github.com/users/clarence112","html_url":"https://github.com/clarence112","followers_url":"https://api.github.com/users/clarence112/followers","following_url":"https://api.github.com/users/clarence112/following{/other_user}","gists_url":"https://api.github.com/users/clarence112/gists{/gist_id}","starred_url":"https://api.github.com/users/clarence112/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/clarence112/subscriptions","organizations_url":"https://api.github.com/users/clarence112/orgs","repos_url":"https://api.github.com/users/clarence112/repos","events_url":"https://api.github.com/users/clarence112/events{/privacy}","received_events_url":"https://api.github.com/users/clarence112/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-11-22T01:55:25Z","updated_at":"2025-11-22T01:55:25Z","body":"> Should this PR also expose the number of buttons and axes on a joypad, or that seems unnecessary?\r\n\r\nI think it would be useful","author_association":"NONE","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3565287369/reactions","total_count":1,"+1":1,"-