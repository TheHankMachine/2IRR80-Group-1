ents/2881414802"},"html":{"href":"https://github.com/godotengine/godot/pull/117046#discussion_r2881414802"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/117046"}},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/2881414802/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":null,"original_line":276,"side":"RIGHT","author_association":"CONTRIBUTOR","original_position":20,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/2881434703","pull_request_review_id":3886314408,"id":2881434703,"node_id":"PRRC_kwDOAO6SJc6rvzRP","diff_hunk":"@@ -572,6 +568,12 @@ void EditorResourcePreview::check_for_invalidation(const String &p_path) {\n \t\t\t\tcall_invalidated = true;\n \t\t\t}\n \t\t}\n+\n+\t\t// Evict the ID-based cache entry for the in-memory resource at p_path, if one exists.\n+\t\tRef<Resource> cached_res = ResourceCache::get_ref(p_path);","path":"editor/inspector/editor_resource_preview.cpp","commit_id":"b6e6dde18c288ecd004798088231446f0ca5cfc0","original_commit_id":"b6e6dde18c288ecd004798088231446f0ca5cfc0","user":{"login":"shoyguer","id":42917725,"node_id":"MDQ6VXNlcjQyOTE3NzI1","avatar_url":"https://avatars.githubusercontent.com/u/42917725?v=4","gravatar_id":"","url":"https://api.github.com/users/shoyguer","html_url":"https://github.com/shoyguer","followers_url":"https://api.github.com/users/shoyguer/followers","following_url":"https://api.github.com/users/shoyguer/following{/other_user}","gists_url":"https://api.github.com/users/shoyguer/gists{/gist_id}","starred_url":"https://api.github.com/users/shoyguer/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/shoyguer/subscriptions","organizations_url":"https://api.github.com/users/shoyguer/orgs","repos_url":"https://api.github.com/users/shoyguer/repos","events_url":"https://api.github.com/users/shoyguer/events{/privacy}","received_events_url":"https://api.github.com/users/shoyguer/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"This block is outside the `MutexLock lock(preview_mutex)` scope, so `cache` gets accessed without any lock. Every other `cache` write in this file holds `preview_mutex`, so this is a data race.\n\nIt also runs without a conditional, the entry gets removed even when the file doesn't change, because it is not inside the check: `if (modified_time != cache[p_path].modified_time)` check.\n\nIMO it would make more sense be something like this:\n\n```\nif (modified_time != cache[p_path].modified_time) {\n    cache.erase(p_path);\n    call_invalidated = true;\n    Ref<Resource> cached_res = ResourceCache::get_ref(p_path);\n    if (cached_res.is_valid()) {\n        cache.erase(\"ID:\" + itos(cached_res->get_instance_id()));\n    }\n}\n```\n\nWdyt?","created_at":"2026-03-04T02:16:40Z","updated_at":"2026-03-04T02:17:38Z","html_url":"https://github.com/godotengine/godot/pull/117046#discussion_r2881434703","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/117046","_links":{"self":{"href":"https://api.github.com/repos/godotengine/godot/pulls/comments/2881434703"},"html":{"href":"https://github.com/godotengine/godot/pull/117046#discussion_r2881434703"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/117046"}},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/2881434703/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":null,"original_line":573,"side":"RIGHT","author_association":"CONTRIBUTOR","original_position":42,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/2881609348","pull_request_review_id":3886501675,"