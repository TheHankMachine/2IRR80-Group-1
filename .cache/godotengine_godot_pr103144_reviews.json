(\"application/min_ios_version\").operator String().to_float();\r\n \t\tif (version < 14.0) {\r\n \t\t\terr += TTR(\"Metal renderer require iOS 14+.\") + \"\\n\";\r\n```","state":"APPROVED","html_url":"https://github.com/godotengine/godot/pull/103144#pullrequestreview-2634747938","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/103144","author_association":"MEMBER","_links":{"html":{"href":"https://github.com/godotengine/godot/pull/103144#pullrequestreview-2634747938"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/103144"}},"submitted_at":"2025-02-22T08:21:13Z","commit_id":null},{"id":2634755245,"node_id":"PRR_kwDOAO6SJc6dCyyt","user":{"login":"syntaxerror247","id":176927541,"node_id":"U_kgDOCouzNQ","avatar_url":"https://avatars.githubusercontent.com/u/176927541?u=25817fe797fcc7a812ba9d7f58f593f5a003abbb&v=4","gravatar_id":"","url":"https://api.github.com/users/syntaxerror247","html_url":"https://github.com/syntaxerror247","followers_url":"https://api.github.com/users/syntaxerror247/followers","following_url":"https://api.github.com/users/syntaxerror247/following{/other_user}","gists_url":"https://api.github.com/users/syntaxerror247/gists{/gist_id}","starred_url":"https://api.github.com/users/syntaxerror247/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/syntaxerror247/subscriptions","organizations_url":"https://api.github.com/users/syntaxerror247/orgs","repos_url":"https://api.github.com/users/syntaxerror247/repos","events_url":"https://api.github.com/users/syntaxerror247/events{/privacy}","received_events_url":"https://api.github.com/users/syntaxerror247/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"","state":"COMMENTED","html_url":"https://github.com/godotengine/godot/pull/103144#pullrequestreview-2634755245","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/103144","author_association":"MEMBER","_links":{"html":{"href":"h