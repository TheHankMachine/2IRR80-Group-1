ora","html_url":"https://github.com/Crystora","followers_url":"https://api.github.com/users/Crystora/followers","following_url":"https://api.github.com/users/Crystora/following{/other_user}","gists_url":"https://api.github.com/users/Crystora/gists{/gist_id}","starred_url":"https://api.github.com/users/Crystora/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Crystora/subscriptions","organizations_url":"https://api.github.com/users/Crystora/orgs","repos_url":"https://api.github.com/users/Crystora/repos","events_url":"https://api.github.com/users/Crystora/events{/privacy}","received_events_url":"https://api.github.com/users/Crystora/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-05-08T14:48:39Z","updated_at":"2026-05-08T14:48:39Z","body":"Thanks for the feedback. Updated the PR. could you please review again?","author_association":"NONE","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4407360551/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4408260716","html_url":"https://github.com/godotengine/godot/pull/119245#issuecomment-4408260716","issue_url":"https://api.github.com/repos/godotengine/godot/issues/119245","id":4408260716,"node_id":"IC_kwDOAO6SJc8AAAABBsC4bA","user":{"login":"hpvb","id":2591099,"node_id":"MDQ6VXNlcjI1OTEwOTk=","avatar_url":"https://avatars.githubusercontent.com/u/2591099?v=4","gravatar_id":"","url":"https://api.github.com/users/hpvb","html_url":"https://github.com/hpvb","followers_url":"https://api.github.com/users/hpvb/followers","following_url":"https://api.github.com/users/hpvb/following{/other_user}","gists_url":"https://api.github.com/users/hpvb/gists{/gist_id}","starred_url":"https://api.github.com/users/hpvb/starred{/owner}{/repo}","subscriptions_url":"htt