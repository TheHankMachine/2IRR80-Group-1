s to a local `tscn` file.\r\n\r\nExample config for nvim with a simple picker to select the custom scene to run.\r\n```lua\r\nlocal dap = require('dap')\r\ndap.configurations.gdscript = {\r\n  {\r\n    type = \"godot\",\r\n    request = \"launch\",\r\n    name = \"Launch scene\",\r\n    scene = function()\r\n      local path = vim.fn.input({\r\n        prompt = 'Path to scene: ',\r\n        default = vim.fn.getcwd() .. '/',\r\n        completion = 'file'\r\n      })\r\n      return (path and path ~= \"\") and path or dap.ABORT\r\n    end\r\n  }\r\n}\r\n```\r\n","labels":[{"id":73330068,"node_id":"MDU6TGFiZWw3MzMzMDA2OA==","url":"https://api.github.com/repos/godotengine/godot/labels/feature%20proposal","name":"feature proposal","description":"","color":"4466ff","default":false,"archived_at":null,"archived_by":null},{"id":279098219,"node_id":"MDU6TGFiZWwyNzkwOTgyMTk=","url":"https://api.github.com/repos/godotengine/godot/labels/topic:editor","name":"topic:editor","description":"","color":"ffee88","default":false,"archived_at":null,"archived_by":null}],"milestone":{"id":8237783,"node_id":"MI_kwDOAO6SJc4AfbLX","url":"https://api.github.com/repos/godotengine/godot/milestones/16","html_url":"https://github.com/godotengine/godot/milestone/16","labels_url":"https://api.github.com/repos/godotengine/godot/milestones/16/labels","number":16,"state":"open","title":"4.x","description":"Issues and pull requests slated for an undetermined Godot 4 release.","creator":{"login":"akien-mga","id":4701338,"node_id":"MDQ6VXNlcjQ3MDEzMzg=","avatar_url":"https://avatars.githubusercontent.com/u/4701338?v=4","gravatar_id":"","url":"https://api.github.com/users/akien-mga","html_url":"https://github.com/akien-mga","followers_url":"https://api.github.com/users/akien-mga/followers","following_url":"https://api.github.com/users/akien-mga/following{/other_user}","gists_url":"https://api.github.com/users/akien-mga/gists{/gist_id}","starred_url":"https://api.github.com/users/akien-mga/starred{/owner}