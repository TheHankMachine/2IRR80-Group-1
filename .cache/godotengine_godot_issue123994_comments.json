ts/5935343075/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5936675791","html_url":"https://github.com/godotengine/godot/issues/123994#issuecomment-5936675791","issue_url":"https://api.github.com/repos/godotengine/godot/issues/123994","id":5936675791,"node_id":"IC_kwDOAO6SJc8AAAABYdp7zw","user":{"login":"notroid5","id":87585310,"node_id":"MDQ6VXNlcjg3NTg1MzEw","avatar_url":"https://avatars.githubusercontent.com/u/87585310?v=4","gravatar_id":"","url":"https://api.github.com/users/notroid5","html_url":"https://github.com/notroid5","followers_url":"https://api.github.com/users/notroid5/followers","following_url":"https://api.github.com/users/notroid5/following{/other_user}","gists_url":"https://api.github.com/users/notroid5/gists{/gist_id}","starred_url":"https://api.github.com/users/notroid5/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/notroid5/subscriptions","organizations_url":"https://api.github.com/users/notroid5/orgs","repos_url":"https://api.github.com/users/notroid5/repos","events_url":"https://api.github.com/users/notroid5/events{/privacy}","received_events_url":"https://api.github.com/users/notroid5/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-10-01T17:18:27Z","updated_at":"2026-10-01T17:23:55Z","body":"> When you disable borderless on a maximized window, the window borders will take up the space that was previously taken by the window. This means the effective window size (in which the project can draw) has to be smaller.\n\nYes, but in my case it is ~75% smaller after disabling it once, then 50% smaller (compared to the start) after disabling it twice, that is far beyond the window borders.\n\n---\n\nUpdate:\nTested 4.8.dev7 now that it's available, still reproducible, added above again.\nSame for the XServer.","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5936675791/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null}]