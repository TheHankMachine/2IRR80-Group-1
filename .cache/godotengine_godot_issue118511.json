url":"https://api.github.com/users/Repiteo/orgs","repos_url":"https://api.github.com/users/Repiteo/repos","events_url":"https://api.github.com/users/Repiteo/events{/privacy}","received_events_url":"https://api.github.com/users/Repiteo/received_events","type":"User","user_view_type":"public","site_admin":false},"open_issues":341,"closed_issues":2335,"state":"open","created_at":"2026-04-13T15:59:35Z","updated_at":"2026-10-22T03:07:42Z","due_on":null,"closed_at":null},"comments":14,"created_at":"2026-04-13T08:20:47Z","updated_at":"2026-09-11T22:25:31Z","closed_at":"2026-09-11T22:25:27Z","assignee":{"login":"BastiaanOlij","id":1945449,"node_id":"MDQ6VXNlcjE5NDU0NDk=","avatar_url":"https://avatars.githubusercontent.com/u/1945449?v=4","gravatar_id":"","url":"https://api.github.com/users/BastiaanOlij","html_url":"https://github.com/BastiaanOlij","followers_url":"https://api.github.com/users/BastiaanOlij/followers","following_url":"https://api.github.com/users/BastiaanOlij/following{/other_user}","gists_url":"https://api.github.com/users/BastiaanOlij/gists{/gist_id}","starred_url":"https://api.github.com/users/BastiaanOlij/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/BastiaanOlij/subscriptions","organizations_url":"https://api.github.com/users/BastiaanOlij/orgs","repos_url":"https://api.github.com/users/BastiaanOlij/repos","events_url":"https://api.github.com/users/BastiaanOlij/events{/privacy}","received_events_url":"https://api.github.com/users/BastiaanOlij/received_events","type":"User","user_view_type":"public","site_admin":false},"author_association":"CONTRIBUTOR","issue_field_values":[],"type":null,"active_lock_reason":null,"draft":false,"pull_request":{"url":"https://api.github.com/repos/godotengine/godot/pulls/118511","html_url":"https://github.com/godotengine/godot/pull/118511","diff_url":"https://github.com/godotengine/godot/pull/118511.diff","patch_url":"https://github.com/godotengine/godot/pull/118511.patch","merged_at":"2026-09-11T22:25:27Z"},"body":"This PR implements support for OpenXR Foveated inset rendering if supported by the hardware.\r\n\r\nWhen using foveated inset rendering, the main viewport output renders a high FOV, lower resolution render which is augmented with a separate high resolution render pass at the users focal point.\r\n\r\nA good overview of the technique is explained [on Varjos website here](https://varjo.com/blog/make-the-best-out-of-your-varjo-experience-update-on-varjo-quad-view-eye-tracked-foveation-and-varjo-base-settings).\r\n\r\nIn order for the user to have quality control and ensure the camera settings can be configured, this PR introduces a new viewport node that controls the rendering of the foveated inset:\r\n<img width=\"502\" height=\"116\" alt=\"image\" src=\"https://github.com/user-attachments/assets/f2f2624a-2003-4a2c-948c-c97bf01a8a98\" />\r\nAn extra `XROrigin3D` node is required with a few lines of code so it is placed in the same location as the main `XROrigin3D` node.\r\nWe also have a separate `XRCamera3D` node with it's `tracker' set to 'inset` (note that I am still working on a nice solution for the dropdown here).\r\n\r\nTodos:\r\n- [ ] Loads of testing (few runtimes support this at the moment so this will be tricky).\r\n- [ ] Make sure we have proper feedback if inset rendering is enabled but our viewport is not supplied or incorrectly configured.\r\n- [ ] Figure out whether we need to worry about this being used in conjunction with frame synthesis and/or VRS.\r\n- [ ] Improve tracker selection dropdown (might become a separate PR).\r\n\r\nThis logic is all based on https://github.com/godotengine/godot/pull/115799 (merged) and  https://github.com/godotengine/godot/pull/116424\r\n\r\nA sample project can be found [here](https://codeberg.org/BastiaanOlij/test-foveated-inset).\r\n\r\nThis PR supersedes https://github.com/godotengine/godot/pull/81505 and https://github.com/godotengine/godot/pull/108156","closed_by":{"login":"Repiteo","id":17489292,"node_id":"MDQ6VXNlcjE3NDg5Mjky","avatar_url":"https://avatars.githubusercontent.com/u/17489292?v=4","gravatar_id":"","url":"https://api.github.com/users/Repiteo","html_url":"https://github.com/Repiteo","followers_url":"https://api.github.com/users/Repiteo/followers","following_url":"https://api.github.com/users/Repiteo/following{/other_user}","gists_url":"https://api.github.com/users/Repiteo/gists{/gist_id}","starred_url":"https://api.github.com/users/Repiteo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Repiteo/subscriptions","organizations_url":"https://api.github.com/users/Repiteo/orgs","repos_url":"https://api.github.com/users/Repiteo/repos","events_url":"https://api.github.com/users/Repiteo/events{/privacy}","received_events_url":"https://api.github.com/users/Repiteo/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/118511/reactions","total_count":1,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":1,"eyes":0},"timeline_url":"https://api.github.com/repos/godotengine/godot/issues/118511/timeline","performed_via_github_app":null,"state_reason":null}