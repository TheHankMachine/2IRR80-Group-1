[{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2563278804","html_url":"https://github.com/godotengine/godot/pull/100838#issuecomment-2563278804","issue_url":"https://api.github.com/repos/godotengine/godot/issues/100838","id":2563278804,"node_id":"IC_kwDOAO6SJc6YyIfU","user":{"login":"YYF233333","id":67693830,"node_id":"MDQ6VXNlcjY3NjkzODMw","avatar_url":"https://avatars.githubusercontent.com/u/67693830?v=4","gravatar_id":"","url":"https://api.github.com/users/YYF233333","html_url":"https://github.com/YYF233333","followers_url":"https://api.github.com/users/YYF233333/followers","following_url":"https://api.github.com/users/YYF233333/following{/other_user}","gists_url":"https://api.github.com/users/YYF233333/gists{/gist_id}","starred_url":"https://api.github.com/users/YYF233333/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/YYF233333/subscriptions","organizations_url":"https://api.github.com/users/YYF233333/orgs","repos_url":"https://api.github.com/users/YYF233333/repos","events_url":"https://api.github.com/users/YYF233333/events{/privacy}","received_events_url":"https://api.github.com/users/YYF233333/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2024-12-27T03:35:05Z","updated_at":"2024-12-27T03:54:19Z","body":"Note that `DISPATCH_CODE` series of macros is used to switch between two implementations, on compilers that support computed goto (namely gcc and clang), a version utilizing `goto` is used and thus need to be in one function. You may want to keep the old code for compatibility or delete them completely.","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2563278804/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2563280745",