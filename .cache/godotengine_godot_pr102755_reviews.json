[{"id":2611404601,"node_id":"PRR_kwDOAO6SJc6bpt85","user":{"login":"kiroxas","id":3176062,"node_id":"MDQ6VXNlcjMxNzYwNjI=","avatar_url":"https://avatars.githubusercontent.com/u/3176062?v=4","gravatar_id":"","url":"https://api.github.com/users/kiroxas","html_url":"https://github.com/kiroxas","followers_url":"https://api.github.com/users/kiroxas/followers","following_url":"https://api.github.com/users/kiroxas/following{/other_user}","gists_url":"https://api.github.com/users/kiroxas/gists{/gist_id}","starred_url":"https://api.github.com/users/kiroxas/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/kiroxas/subscriptions","organizations_url":"https://api.github.com/users/kiroxas/orgs","repos_url":"https://api.github.com/users/kiroxas/repos","events_url":"https://api.github.com/users/kiroxas/events{/privacy}","received_events_url":"https://api.github.com/users/kiroxas/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"I do not know how nodes and physics works internally, so feel free to ignore if this makes little sense. However this seems like it could have complications if some node have some costly code in response to when setVisible is called. Seems like you are targeting some specific nodes, which I assume does not have this property right now, but this use case ( toggle on then off in the same frame) is not something people will think of when adding new features, so that could easily bite them. Is there really no way to add a parameter to reset_physics_interpolation() so it consider the hidden nodes too? That would seem to be the way with less collateral damage.","state":"COMMENTED","html_url":"https://github.com/godotengine/godot/pull/102755#pullrequestreview-2611404601","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/102755","author_association":"CONTRIBUTOR","_links":{"html":{"href":"https://github.com/godotengine/godot/pull/102755#pullrequestreview-2611404601"},"pull_request":{"