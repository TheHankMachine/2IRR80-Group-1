[{"id":3531141133,"node_id":"PRR_kwDOAO6SJc7SePAN","user":{"login":"mihe","id":4884246,"node_id":"MDQ6VXNlcjQ4ODQyNDY=","avatar_url":"https://avatars.githubusercontent.com/u/4884246?v=4","gravatar_id":"","url":"https://api.github.com/users/mihe","html_url":"https://github.com/mihe","followers_url":"https://api.github.com/users/mihe/followers","following_url":"https://api.github.com/users/mihe/following{/other_user}","gists_url":"https://api.github.com/users/mihe/gists{/gist_id}","starred_url":"https://api.github.com/users/mihe/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/mihe/subscriptions","organizations_url":"https://api.github.com/users/mihe/orgs","repos_url":"https://api.github.com/users/mihe/repos","events_url":"https://api.github.com/users/mihe/events{/privacy}","received_events_url":"https://api.github.com/users/mihe/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"> There is some code that uses raw pointers to GameStateSnapshot objects - now that the snapshots are being freed, there's some risk that these pointers could point to already deleted objects.\n\nI feel like we should probably just change `SnapshotView` (and possibly other classes as well) to hold `Ref<GameStateSnapshot>` now instead of raw pointers. I can't really see the harm in it. We can do that in a future PR though.\n\nBesides the minor issue with using `dynamic_cast`, this all looks good to me.","state":"APPROVED","html_url":"https://github.com/godotengine/godot/pull/113366#pullrequestreview-3531141133","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/113366","author_association":"CONTRIBUTOR","_links":{"html":{"href":"https://github.com/godotengine/godot/pull/113366#pullrequestreview-3531141133"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/113366"}},"submitted_at":"2025-12-04T17:50:40Z","commit_id":null}]