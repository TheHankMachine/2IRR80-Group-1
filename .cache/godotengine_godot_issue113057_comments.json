engine/godot/issues/comments/3718876902","html_url":"https://github.com/godotengine/godot/issues/113057#issuecomment-3718876902","issue_url":"https://api.github.com/repos/godotengine/godot/issues/113057","id":3718876902,"node_id":"IC_kwDOAO6SJc7dqY7m","user":{"login":"prvak","id":2436340,"node_id":"MDQ6VXNlcjI0MzYzNDA=","avatar_url":"https://avatars.githubusercontent.com/u/2436340?v=4","gravatar_id":"","url":"https://api.github.com/users/prvak","html_url":"https://github.com/prvak","followers_url":"https://api.github.com/users/prvak/followers","following_url":"https://api.github.com/users/prvak/following{/other_user}","gists_url":"https://api.github.com/users/prvak/gists{/gist_id}","starred_url":"https://api.github.com/users/prvak/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/prvak/subscriptions","organizations_url":"https://api.github.com/users/prvak/orgs","repos_url":"https://api.github.com/users/prvak/repos","events_url":"https://api.github.com/users/prvak/events{/privacy}","received_events_url":"https://api.github.com/users/prvak/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-01-07T13:24:50Z","updated_at":"2026-01-07T13:24:50Z","body":"Removing .godot folder fixed the issue. At least on the surface. There is no error and path is visible in settings. But there is still a uid instead of a path in the project.godot, is that ok?","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3718876902/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3718886273","html_url":"https://github.com/godotengine/godot/issues/113057#issuecomment-3718886273","issue_url":"https://api.github.com/repos/godotengine/godot/issues/113057","id":3718886273,"node_id":"IC_kwDOAO