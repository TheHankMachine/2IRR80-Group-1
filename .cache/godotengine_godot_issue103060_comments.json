":"https://avatars.githubusercontent.com/u/65322242?v=4","gravatar_id":"","url":"https://api.github.com/users/STICKnoLOGIC","html_url":"https://github.com/STICKnoLOGIC","followers_url":"https://api.github.com/users/STICKnoLOGIC/followers","following_url":"https://api.github.com/users/STICKnoLOGIC/following{/other_user}","gists_url":"https://api.github.com/users/STICKnoLOGIC/gists{/gist_id}","starred_url":"https://api.github.com/users/STICKnoLOGIC/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/STICKnoLOGIC/subscriptions","organizations_url":"https://api.github.com/users/STICKnoLOGIC/orgs","repos_url":"https://api.github.com/users/STICKnoLOGIC/repos","events_url":"https://api.github.com/users/STICKnoLOGIC/events{/privacy}","received_events_url":"https://api.github.com/users/STICKnoLOGIC/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-02-20T13:14:56Z","updated_at":"2025-02-20T13:15:24Z","body":"then the `@export` variable/s became useless... what is the use of `@export`? to edit in editor, right?","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2671464250/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2671579019","html_url":"https://github.com/godotengine/godot/issues/103060#issuecomment-2671579019","issue_url":"https://api.github.com/repos/godotengine/godot/issues/103060","id":2671579019,"node_id":"IC_kwDOAO6SJc6fPQ-L","user":{"login":"arkology","id":43543909,"node_id":"MDQ6VXNlcjQzNTQzOTA5","avatar_url":"https://avatars.githubusercontent.com/u/43543909?v=4","gravatar_id":"","url":"https://api.github.com/users/arkology","html_url":"https://github.com/arkology","followers_url":"https://api.github.com/users/arkology/followers","following_url":"https://api.github.com/users/arkology/following{/other_user}","gists_url":"https://api.github.com/users/arkology/gists{/gist_id}","starred_url":"https://api.github.com/users/arkology/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/arkology/subscriptions","organizations_url":"https://api.github.com/users/arkology/orgs","repos_url":"https://api.github.com/users/arkology/repos","events_url":"https://api.github.com/users/arkology/events{/privacy}","received_events_url":"https://api.github.com/users/arkology/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-02-20T13:57:45Z","updated_at":"2025-02-20T13:57:45Z","body":"Honestly I don't understand what is the problem here, please elaborate.\n\nYou created single resource and expect that every scene which has this resource will have unique copy of resource? But resources are passed by reference. If you need unique copy of resource for every instanciated scene, enable \"Local to Scene\" checkbox and that's all.\n\n![Image](https://github.com/user-attachments/assets/a8662dd2-b1aa-4348-941f-a51ea0653f53)\n\nWhy do you think that `@export` annotation will be useless?\n\n> You could duplicate it by yourself in code inside _ready().\n\n```gdscript\nfunc _ready() -> void:\n\t$CollisionShape2D.shape = $CollisionShape2D.shape.duplicate()\n\t$Sprite2D.texture = $Sprite2D.texture.duplicate()\n\t$CollisionShape2D.shape.size.x=barsize\n\t$Sprite2D.texture.width=barsize*3.2\n\tprint($CollisionShape2D.shape.size.x)\n\tprint(barsize)\n```\n\n","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2671579019/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2671610622","html_url":"https://github.com/godotengine/godot/issues/103060#issuecomment-2671610622","issue_url":"https://api.github.com/repos/godotengine/godot/issues/103060","id":2671610622,"node_id":"IC_kwDOAO6SJc6fPYr-","user":{"login":"STICKnoLOGIC","id":65322242,"node_id":"MDQ6VXNlcjY1MzIyMjQy","avatar_url":"https://avatars.githubusercontent.com/u/65322242?v=4","gravatar_id":"","url":"https://api.github.com/users/STICKnoLOGIC","html_url":"https://github.com/STICKnoLOGIC","followers_url":"https://api.github.com/users/STICKnoLOGIC/followers","following_url":"https://api.github.com/users/STICKnoLOGIC/following{/other_user}","gists_url":"https://api.github.com/users/STICKnoLOGIC/gists{/gist_id}","starred_url":"https://api.github.com/users/STICKnoLOGIC/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/STICKnoLOGIC/subscriptions","organizations_url":"https://api.github.com/users/STICKnoLOGIC/orgs","repos_url":"https://api.github.com/users/STICKnoLOGIC/repos","events_url":"https://api.github.com/users/STICKnoLOGIC/events{/privacy}","received_events_url":"https://api.github.com/users/STICKnoLOGIC/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-02-20T14:07:59Z","updated_at":"2025-02-20T14:07:59Z","body":"I see, silly me I forgot to look at the resources section, I just dove in search engine right of the bat once the `make unique` doesn't work 😂😂🤣🤣... I think I misread/understand the difference between `make unique` and `local to scene` (I thought they are the same), gonna close this.","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2671610622/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2671644542","html_url":"https://github.com/godotengine/godot/issues/103060#issuecomment-2671644542","issue_url":"https://api.github.