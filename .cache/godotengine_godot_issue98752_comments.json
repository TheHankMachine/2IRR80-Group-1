com/users/ScaleShiftX/following{/other_user}","gists_url":"https://api.github.com/users/ScaleShiftX/gists{/gist_id}","starred_url":"https://api.github.com/users/ScaleShiftX/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/ScaleShiftX/subscriptions","organizations_url":"https://api.github.com/users/ScaleShiftX/orgs","repos_url":"https://api.github.com/users/ScaleShiftX/repos","events_url":"https://api.github.com/users/ScaleShiftX/events{/privacy}","received_events_url":"https://api.github.com/users/ScaleShiftX/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-08-05T00:10:57Z","updated_at":"2025-08-05T00:10:57Z","body":"It's been the source of great confusion over the past few days that _ExitTree() _**DOES**_ call in the .exe but _**NOT**_ in the editor.\n\nI'm doing threading and hooks which I would like to ensure are cleaned up for the end user when they quit the game. It would be very convenient and robust to put all of that in a method that I could know for sure would be called on exit.\n\nAt first it seemed like _ExitTree() would be a viable solution but then not, but then it did seem viable again when I was testing the build... It just doesn't seem like a good design to have that inconsistent behaviour that is also incongruous with the expectations of a lot of users of that method.","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3152853037/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3173118746","html_url":"https://github.com/godotengine/godot/issues/98752#issuecomment-3173118746","issue_url":"https://api.github.com/repos/godotengine/godot/issues/98752","id":3173118746,"node_id":"IC_kwDOAO6SJc69IfMa","user":{"login":"timothyqiu","id":372476,"node_id":"MDQ6VXNlcjM3MjQ3Ng==","avatar_url":"https://avatars.githubusercontent.com/u/372476?v=4","gravatar_id":"","url":"https://api.github.com/users/timothyqiu","html_url":"https://github.com/timothyqiu","followers_url":"https://api.github.com/users/timothyqiu/followers","following_url":"https://api.github.com/users/timothyqiu/following{/other_user}","gists_url":"https://api.github.com/users/timothyqiu/gists{/gist_id}","starred_url":"https://api.github.com/users/timothyqiu/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/timothyqiu/subscriptions","organizations_url":"https://api.github.com/users/timothyqiu/orgs","repos_url":"https://api.github.com/users/timothyqiu/repos","events_url":"https://api.github.com/users/timothyqiu/events{/privacy}","received_events_url":"https://api.github.com/users/timothyqiu/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-08-11T02:33:26Z","updated_at":"2025-08-11T02:34:38Z","body":"As far as I can tell, `_exit_tree()` _is_ called. But the debugger deattaches before that (or not got sent due to buffering, I'm not sure), so it's just not _printed_ to the Output panel.\n\nYou can find the printed text in the game's log file. You can also change the `print` to something like this:\n\n```gdscript\nfunc _exit_tree():\n    OS.shell_open(\"https://godotengine.org/\")\n```","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3173118746/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3173236845","html_url":"https://github.com/godotengine/godot/issues/98752#issuecomment-3173236845","issue_url":"https://api.github.com/repos/godotengine/godot/issues/98752","id":3173236845,"node_id":"IC_kwDOAO6SJc69I8Bt","user":{"login":"ScaleShi