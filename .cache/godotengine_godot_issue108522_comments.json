et_cache = false;\r\n};\r\n```\r\n\r\nDo you have any suggestions? This is my first time submitting a PR to Godot, and I'm not sure if there are any special requirements.","author_association":"NONE","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3062805453/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3062822359","html_url":"https://github.com/godotengine/godot/pull/108522#issuecomment-3062822359","issue_url":"https://api.github.com/repos/godotengine/godot/issues/108522","id":3062822359,"node_id":"IC_kwDOAO6SJc62jvXX","user":{"login":"AThousandShips","id":96648715,"node_id":"U_kgDOBcK-Cw","avatar_url":"https://avatars.githubusercontent.com/u/96648715?v=4","gravatar_id":"","url":"https://api.github.com/users/AThousandShips","html_url":"https://github.com/AThousandShips","followers_url":"https://api.github.com/users/AThousandShips/followers","following_url":"https://api.github.com/users/AThousandShips/following{/other_user}","gists_url":"https://api.github.com/users/AThousandShips/gists{/gist_id}","starred_url":"https://api.github.com/users/AThousandShips/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/AThousandShips/subscriptions","organizations_url":"https://api.github.com/users/AThousandShips/orgs","repos_url":"https://api.github.com/users/AThousandShips/repos","events_url":"https://api.github.com/users/AThousandShips/events{/privacy}","received_events_url":"https://api.github.com/users/AThousandShips/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-07-11T15:50:21Z","updated_at":"2025-07-11T15:50:21Z","body":"I don't have any good suggestions right now, but that alone means that this cannot be merged as is but that that problem needs to be solved, probably by making the offset part of the matrix\r\n\r\nBut that indicates to me that this isn't a good solution if it needs that much to solve it\r\n\r\nI think the solution instead is something like:\r\n* https://github.com/godotengine/godot/pull/99986\r\n\r\nWhich creates a dedicated `Frustum` class\r\n\r\nBut this doesn't seem to be the place to solve this, I think the solution should be in the rendering server somehow","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3062822359/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3062846793","html_url":"https://github.com/godotengine/godot/pull/108522#issuecomment-3062846793","issue_url":"https://api.github.com/repos/godotengine/godot/issues/108522","id":3062846793,"node_id":"IC_kwDOAO6SJc62j1VJ","user":{"login":"bruvzg","id":7645683,"node_id":"MDQ6VXNlcjc2NDU2ODM=","avatar_url":"https://avatars.githubusercontent.com/u/7645683?v=4","gravatar_id":"","url":"https://api.github.com/users/bruvzg","html_url":"https://github.com/bruvzg","followers_url":"https://api.github.com/users/bruvzg/followers","following_url":"https://api.github.com/users/bruvzg/following{/other_user}","gists_url":"https://api.github.com/users/bruvzg/gists{/gist_id}","starred_url":"https://api.github.com/users/bruvzg/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/bruvzg/subscriptions","organizations_url":"https://api.github.com/users/bruvzg/orgs","repos_url":"https://api.github.com/users/bruvzg/repos","events_url":"https://api.github.com/users/bruvzg/events{/privacy}","received_events_url":"https://api.github.com/users/bruvzg/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-07-11T15:57:55Z","updated_at":"2025-07-11T15:58:17Z","body":"Changing core type size and structure