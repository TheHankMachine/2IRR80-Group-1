nonymous> source21:6352155\n    <anonymous> source21:4093305\n    <anonymous> source21:3599097\n    <anonymous> source21:19838936\n    <anonymous> source21:3590601\n    <anonymous> source21:638830\n    <anonymous> source21:19290210\n    <anonymous> source21:45826580\n    <anonymous> source21:5778829\n    <anonymous> source21:2740161\n    <anonymous> source21:46818207\n    button_cb http://localhost:8060/tmp_js_export.js:9\n```\n\n## Steps to reproduce\n\n1. Create a project with an AudioStreamPlayer\n2. Set the stream to be a AudioStreamInteractive/AudioStreamPlaylist/AudioStreamSynchronized\n4. Run the project in a Browser\n3. Play the stream\n4. Pause the stream with `.set_stream_paused(true)`\n\nIn this reproduction. Start the project in a browser and click anywhere so the music starts. Press the \"Stop\" button to pause the stream and check the console.\n\n[pause-audio-stream-null-function.zip](https://github.com/user-attachments/files/19492131/pause-audio-stream-null-function.zip)\n\n","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2759060187/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2784286180","html_url":"https://github.com/godotengine/godot/issues/104645#issuecomment-2784286180","issue_url":"https://api.github.com/repos/godotengine/godot/issues/104645","id":2784286180,"node_id":"IC_kwDOAO6SJc6l9NXk","user":{"login":"michaelharmonart","id":15620900,"node_id":"MDQ6VXNlcjE1NjIwOTAw","avatar_url":"https://avatars.githubusercontent.com/u/15620900?v=4","gravatar_id":"","url":"https://api.github.com/users/michaelharmonart","html_url":"https://github.com/michaelharmonart","followers_url":"https://api.github.com/users/michaelharmonart/followers","following_url":"https://api.github.com/users/michaelharmonart/following{/other_user}","gists_url":"https://api.github.com/users/michaelharmonart/gists{/gist_id}","starred_url":"https://api.github.com/users/michaelharmonart/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/michaelharmonart/subscriptions","organizations_url":"https://api.github.com/users/michaelharmonart/orgs","repos_url":"https://api.github.com/users/michaelharmonart/repos","events_url":"https://api.github.com/users/michaelharmonart/events{/privacy}","received_events_url":"https://api.github.com/users/michaelharmonart/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-04-07T19:02:02Z","updated_at":"2025-04-07T19:02:02Z","body":"looks like based on the errors pointed out here: https://github.com/godotengine/godot/pull/105080#issuecomment-2783848097\n\nthis may be related to the same link-time issue as https://github.com/godotengine/godot/issues/104497\n\nmight be worth trying some export templates that are compiled without the link time optimization and seeing if that fixes the issue?","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2784286180/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2857476523","html_url":"https://github.com/godotengine/godot/issues/104645#issuecomment-2857476523","issue_url":"https://api.github.com/repos/godotengine/godot/issues/104645","id":2857476523,"node_id":"IC_kwDOAO6SJc6qUaGr","user":{"login":"milkiq","id":17810390,"node_id":"MDQ6VXNlcjE3ODEwMzkw","avatar_url":"https://avatars.githubusercontent.com/u/17810390?v=4","gravatar_id":"","url":"https://api.github.com/users/milkiq","html_url":"https://github.com/milkiq","followers_url":"https://api.github.com/users/milkiq/followers","following_url":"https://api.github.com/users/milkiq/following{/other_user}","gists_url":"https://api.github.com/users/milkiq/gists{/gist_id}","starred_url":"https://api.github.com/users/milkiq/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/milkiq/subscriptions","organizations_url":"https://api.github.com/users/milkiq/orgs","repos_url":"https://api.github.com/users/milkiq/repos","events_url":"https://api.github.com/users/milkiq/events{/privacy}","received_events_url":"https://api.github.com/users/milkiq/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-05-07T07:51:18Z","updated_at":"2025-05-07T07:51:18Z","body":"In my project, besides autoplay, if it doesn't stop playing before the node is freed, it will also crash. So I resolve this by playing the audio stream in the _ready function, and binding a script to each audio stream player node which stops it in the _exit_tree function.","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2857476523/reactions","total_count":4,"+1":4,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2888163386","html_url":"https://github.com/godotengine/godot/issues/104645#issuecomment-2888163386","issue_url":"https://api.github.com/repos/godotengine/godot/issues/104645","id":2888163386,"node_id":"IC_kwDOAO6SJc6sJeA6","user":{"login":"TranquilMarmot","id":504259,"node_id":"MDQ6VXNlcjUwNDI1OQ==","avatar_url":"https://avatars.githubusercontent.com/u/504259?v=4","gravatar_id":"","url":"https://api.github.com/users/TranquilMarmot","html_url":"https://github.com/TranquilMarmot","followers_url":"https://api.github.com/users/TranquilMarmot/followers","following_url":"https://api.github.com/users/TranquilMarmot/following{/other_user}","gists_url":"https://api.github.com/users/TranquilMarmot/gists{/gist_id}","starred_url":"https://api.github.com/users/TranquilMarmot/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/TranquilMarmot/subscriptions","organizations_url":"https://api.github.com/users/TranquilMarmot/orgs","repos_url":"https://api.github.com/users/TranquilMarmot/repos","events_url":"https://api.github.com/users/TranquilMarmot/events{/privacy}","received_events_url":"https://api.github.com/users/TranquilMarmot/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-05-17T07:07:23Z","updated_at":"2025-05-17T07:07:23Z","body":"Can confirm that this is still an issue with 4.5-dev4.\n\nAny `AudioStreamPlayer3D` or `AudioStreamPlayer` with `autoplay` set to `true` will crash. Maybe worth noting that in Firefox, it instead crashes with `indirect call to null` instead.\n\nI attached this script to my audio stream players to fix it...\n```gdscript\nextends AudioStreamPlayer\n## autoplaying audio streams are broken in Godot 4.4+ web exports\n## see https://github.com/godotengine/godot/issues/104645 for more info\n\n\nfunc _ready():\n\tplay()\n\n\nfunc _exit_tree():\n\tstop()\n\n```","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2888163386/reactions","total_count":5,"+1":5,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3033397421","html_url":"https://github.com/godotengine/godot/issues/104645#issuecomment-3033397421","issue_url":"https://api.github.com/repos/godotengine/godot/issues/104645","id":3033397421,"node_id":"IC_kwDOAO6SJc60zfit","user":{"login":"adamscott","id":270928,"node_id":"MDQ6VXNlcjI3MDkyOA==","avatar_url":"https://avatars.githubusercontent.com/u/270928?v=4","gravatar_id":"","url":"https://api.github.com/users/adamscott","html_url":"https://github.com/adamscott","followers_url":"https://api.github.com/users/adamscott/followers","following_url":"https://api.github.com/users/adamscott/following{/other_user}","gists_url":"https://api.github.com/users/adamscott/gists{/gist_id}","starred_url":"https://api.github.com/users/adamscott/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/adamscott/subscriptions","organizations_url":"https://api.github.com/users/adamscott/orgs","repos_url":"https://api.github.com/users/adamscott/repos","events_url":"https://api.github.com/users/adamscott/events{/privacy}","received_events_url":"https://api.github.com/users/adamscott/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-07-03T19:35:20Z","updated_at":"2025-07-03T19:35:20Z","body":"Fixed with Godot 4.5-beta1, as we updated Emscripten to 4.0.10.","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3033397421/reactions","total_count":2,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":2,"eyes":0},"performed_via_github_app":null,"minimized":null}]