 to see if anything looks obviously wasteful.","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3936889946/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3937060009","html_url":"https://github.com/godotengine/godot/pull/116552#issuecomment-3937060009","issue_url":"https://api.github.com/repos/godotengine/godot/issues/116552","id":3937060009,"node_id":"IC_kwDOAO6SJc7qqsSp","user":{"login":"Repiteo","id":17489292,"node_id":"MDQ6VXNlcjE3NDg5Mjky","avatar_url":"https://avatars.githubusercontent.com/u/17489292?v=4","gravatar_id":"","url":"https://api.github.com/users/Repiteo","html_url":"https://github.com/Repiteo","followers_url":"https://api.github.com/users/Repiteo/followers","following_url":"https://api.github.com/users/Repiteo/following{/other_user}","gists_url":"https://api.github.com/users/Repiteo/gists{/gist_id}","starred_url":"https://api.github.com/users/Repiteo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Repiteo/subscriptions","organizations_url":"https://api.github.com/users/Repiteo/orgs","repos_url":"https://api.github.com/users/Repiteo/repos","events_url":"https://api.github.com/users/Repiteo/events{/privacy}","received_events_url":"https://api.github.com/users/Repiteo/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-02-20T20:39:37Z","updated_at":"2026-02-20T20:39:37Z","body":"Thanks!","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3937060009/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null}]