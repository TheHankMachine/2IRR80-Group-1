s/Calinou/gists{/gist_id}","starred_url":"https://api.github.com/users/Calinou/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Calinou/subscriptions","organizations_url":"https://api.github.com/users/Calinou/orgs","repos_url":"https://api.github.com/users/Calinou/repos","events_url":"https://api.github.com/users/Calinou/events{/privacy}","received_events_url":"https://api.github.com/users/Calinou/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-03-26T19:28:22Z","updated_at":"2025-03-26T19:29:05Z","body":"> @Calinou, hey! What needs to be done to draw attention to this PR from the rendering team?\r\n\r\n~~I'm not the most knowledgeable with RenderingServer internals, but I suggest publishing a demo project that makes use of the new API. This allows the feature to document its own use (somewhat) and makes it easier to test for regressions later on.~~\r\n\r\n**Edit:** Nevermind, I didn't see https://github.com/godotengine/godot/pull/100710#issuecomment-2619904041 above which has a testing project.","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2755539149/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2756535711","html_url":"https://github.com/godotengine/godot/pull/100710#issuecomment-2756535711","issue_url":"https://api.github.com/repos/godotengine/godot/issues/100710","id":2756535711,"node_id":"IC_kwDOAO6SJc6kTWWf","user":{"login":"BastiaanOlij","id":1945449,"node_id":"MDQ6VXNlcjE5NDU0NDk=","avatar_url":"https://avatars.githubusercontent.com/u/1945449?v=4","gravatar_id":"","url":"https://api.github.com/users/BastiaanOlij","html_url":"https://github.com/BastiaanOlij","followers_url":"https://api.github.com/users/BastiaanOlij/followers","following_url":"https://api.github.com/users/BastiaanOlij/following{/other_user}","gists_url":"https://api.github.com/users/BastiaanOlij/gists{/gist_id}","starred_url":"https://api.github.com/users/BastiaanOlij/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/BastiaanOlij/subscriptions","organizations_url":"https://api.github.com/users/BastiaanOlij/orgs","repos_url":"https://api.github.com/users/BastiaanOlij/repos","events_url":"https://api.github.com/users/BastiaanOlij/events{/privacy}","received_events_url":"https://api.github.com/users/BastiaanOlij/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-03-27T03:46:55Z","updated_at":"2025-03-27T03:46:55Z","body":"Discussed briefly during rendering meeting, Clay is on holidays so we'll need to postpone on a decision until he is back.\r\n\r\nThis was build according to ideas I put forward in exposing storage classes as this will be needed at a later time for extending the render engine.\r\nHowever in last discussions with Clay he was in favor for a simpler approach more in line with @BadMachine 's original PR (e.g. adding specific functions to the rendering server.)","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2756535711/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2761723521","html_url":"https://github.com/godotengine/godot/pull/100710#issuecomment-2761723521","issue_url":"https://api.github.com/repos/godotengine/godot/issues/100710","id":2761723521,"node_id":"IC_kwDOAO6SJc6knI6B","user":{"login":"akien-mga","id":4701338,"node_id":"MDQ6VXNlcjQ3MDEzMzg=","avatar_url":"https://avatars.githubusercontent.com/u/4701338?v=4","gravatar_id":"","url":"https://api.github.com/users/akien-mga","html_url":"https://github.com/akien-mga","followers_url":"https://api.github.com/users/akien-mga/followers","following_url":"https://api.github.com/users/akien-mga/following{/other_user}","gists_url":"https://api.github.com/users/akien-mga/gists{/gist_id}","starred_url":"https://api.github.com/users/akien-mga/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/akien-mga/subscriptions","organizations_url":"https://api.github.com/users/akien-mga/orgs","repos_url":"https://api.github.com/users/akien-mga/repos","events_url":"https://api.github.com/users/akien-mga/events{/privacy}","received_events_url":"https://api.github.com/users/akien-mga/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-03-28T15:40:21Z","updated_at":"2025-03-28T15:40:21Z","body":"BTW for the next time this PR is updated, please amend the commit message to be clearer. It's currently titled \"Initial commit\" and the description has a lot of noise after squashing, it should be amended to have a clear title (like this PR) and description (e.g. like the PR description, or shorter).","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2761723521/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2899778414","html_url":"https://github.com/godotengine/godot/pull/100710#issuecomment-2899778414","issue_url":"https://api.github.com/repos/godotengine/godot/issues/100710","id":2899778414,"node_id":"IC_kwDOAO6SJc6s1xtu","user":{"login":"clayjohn","id":16521339,"node_id":"MDQ6VXNlcjE2NTIxMzM5","avatar_url":"https://avatars.githubusercontent.com/u/16521339?v=4","gravatar_id":"","url":"https://api.github.com/users/clayjohn","html_url":"https://github.com/clayjohn","followers_url":"https://api.github.com/users/clayjohn/followers","following_url":"https://api.github.com/users/clayjohn/following{/other_user}","gists_url":"https://api.github.com/users/clayjohn/gists{/gist_id}","starred_url":"https://api.github.com/users/clayjohn/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/clayjohn/subscriptions","organizations_url":"https://api.github.com/users/clayjohn/orgs","repos_url":"https://api.github.com/users/clayjohn/repos","events_url":"https://api.github.com/users/clayjohn/events{/privacy}","received_events_url":"https://api.github.com/users/clayjohn/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-05-22T03:17:30Z","updated_at":"2025-05-22T03:17:30Z","body":"We discussed this in the Rendering Meeting today and had a long discussion as this touches on a few important decision points that impact the future of the renderer. Particularly this impacts how and whether we expose the storage structs in a way that can be consumed by a GDExtension for the purpose of overriding the Forward+ or Mobile renderers through an extension. \r\n\r\nUltimately we agreed that the best way to expose these specific buffers is directly through the RenderData class. I.e. instead of exposing the storage classes directly and letting the storage classes bind the relevant getter methods, we implement a getter method in the RenderData class that handles grabbing the singleton and grabbing the requested data. That API is preferable for 2 reasons:\r\n1. It avoids exposing internal implementation details to the user and thus gives us the ability to modify internals without changing the user facing API\r\n2. It simplifies the interface for users. Just because it was useful for us to split the rendering data among various classes for the purposes of organization, doesn't mean that makes for a good user-facing API. The way Godot typically works is to expose one API for everything with dedicated methods (see the RenderingServer for example). For a user, it is much simpler to call the relevant getter on the RenderData struct then to have to know to request the relevant singleton then find the correct getter. Plus it means that autocomplete can help users find the correct getter. ","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2899778414/reactions","total_count":2,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":1},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2991070047","html_url":"https://github.com/godotengine/godot/pull/100710#issuecomment-2991070047","issue_url":"https://api.github.com/repos/godotengine/godot/issues/100710","id":2991070047,"node_id":"IC_kwDOAO6SJc6ySBtf","user":{"login":"BadMachine","id":50546204,"node_id":"MDQ6VXNlcjUwNTQ2MjA0","avatar_url":"https://avatars.githubusercontent.com/u/50546204?v=4","gravatar_id":"","url":"https://api.github.com/users/BadMachine","html_url":"https://github.com/BadMachine","followers_url":"https://api.github.com/users/BadMachine/followers","following_url":"https://api.github.com/users/BadMachine/following{/other_user}","gists_url":"https://api.github.com/users/BadMachine/gists{/gist_id}","starred_url":"https://api.github.com/users/BadMachine/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/BadMachine/subscriptions","organizations_url":"https://api.github.com/users/BadMachine/orgs","repos_url":"https://api.github.com/users/BadMachine/repos","events_url":"https://api.github.com/users/BadMachine/events{/privacy}","received_events_url":"https://api.github.com/users/BadMachine/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-06-20T11:19:43Z","updated_at":"2025-06-20T11:22:15Z","body":"The current api is:\r\n```gdscript\r\n  var directional_light_buffer: RID = render_scene_data.get_directional_light_buffer();\r\n  var omni_light_buffer: RID = render_scene_data.get_omni_light_buffer();\r\n  var spot_light_buffer: RID = render_scene_data.get_spot_light_buffer();\r\n  var decal_atlas = render_scene_data.decal_atlas_get_texture();\r\n  var shadow_atlas: RID = render_scene_data.directional_shadow_get_texture();\r\n```\r\n\r\n","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2991070047/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3348162054","html_url":"https://github.com/godotengine/godot/pull/100710#issuecomment-3348162054","issue_url":"https://api.github.com/repos/godotengine/godot/issues/100710","id":3348162054,"node_id":"IC_kwDOAO6SJc7HkOYG","user":{"login":"BadMachine","id":50546204,"node_id":"MDQ6VXNlcjUwNTQ2MjA0","avatar_url":"https://avatars.githubusercontent.com/u/50546204?v=4","gravatar_id":"","url":"https://api.github.com/users/BadMachine","html_url":"https://github.com/BadMachine","followers_url":"https://api.github.com/users/BadMachine/followers","following_url":"https://api.github.com/users/BadMachine/following{/other_user}","gists_url":"https://api.github.com/users/BadMachine/gists{/gist_id}","starred_url":"https://api.github.com/users/BadMachine/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/BadMachine/subscriptions","organizations_url":"https://api.github.com/users/BadMachine/orgs","repos_url":"https://api.github.com/users/BadMachine/repos","events_url":"https://api.github.com/users/BadMachine/events{/privacy}","received_events_url":"https://api.github.com/users/BadMachine/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-09-29T17:26:03Z","updated_at":"2025-09-29T17:48:29Z","body":"@AThousandShips Does this PR finally look fine? If so, can we merge it?) ","author_association":"CONTRIBUTOR","r