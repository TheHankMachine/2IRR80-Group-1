rs/Repiteo/received_events","type":"User","user_view_type":"public","site_admin":false},"open_issues":333,"closed_issues":2373,"state":"open","created_at":"2026-04-13T15:59:35Z","updated_at":"2026-10-23T15:30:30Z","due_on":null,"closed_at":null},"comments":1,"created_at":"2026-10-19T08:25:54Z","updated_at":"2026-10-19T16:51:19Z","closed_at":"2026-10-19T16:51:02Z","assignee":null,"author_association":"MEMBER","issue_field_values":[],"type":null,"active_lock_reason":null,"draft":false,"pull_request":{"url":"https://api.github.com/repos/godotengine/godot/pulls/124635","html_url":"https://github.com/godotengine/godot/pull/124635","diff_url":"https://github.com/godotengine/godot/pull/124635.diff","patch_url":"https://github.com/godotengine/godot/pull/124635.patch","merged_at":"2026-10-19T16:51:02Z"},"body":"## What problem(s) does this PR solve?\r\n\r\n- Fix double-free in DisplayServerX11 destructor when freeing `move` cursor, reported against my Fedora package: https://bugzilla.redhat.com/show_bug.cgi?id=2555331\r\n\r\n## Additional information\r\n\r\nWhen the cursor theme lacks a `move` cursor, `CURSOR_MOVE` aliased the `CURSOR_DRAG` image, which the destructor then freed twice. Reload the `CURSOR_DRAG` image instead so we can free it without risk.\r\n\r\nThis is old code and thus the bug has been there for a while, so it's likely pretty rare that it reproduces in the wild, as it needs a specific theme without `move` cursor (seems to be the Fedora bug's OP's case with Cinnamon's `Bluecurve-inverse` theme, which lacks `move` and `dragging` but has `fleur`, and evidently doesn't seem to have Awaita to fall back to).\r\nWe could cherry-pick to 4.7.x as it should be pretty safe, but it's not high priority either.\r\n\r\nAnother option I considered is to memcpy the image, but reloading was a shorter diff. Third option would be to special case the destructor call to not free `CURSOR_MOVE` if it's an alias to `CURSOR_DRAG` but I figured it's better to handle the edge case only once.","closed_by":{"login":"Repiteo","id":17489292,"node_id":"MDQ6VXNlcjE3NDg5Mjky","avatar_url":"https://avatars.githubusercontent.com/u/17489292?v=4","gravatar_id":"","url":"https://api.github.com/users/Repiteo","html_url":"https://github.com/Repiteo","followers_url":"https://api.github.com/users/Repiteo/followers","following_url":"https://api.github.com/users/Repiteo/following{/other_user}","gists_url":"https://api.github.com/users/Repiteo/gists{/gist_id}","starred_url":"https://api.github.com/users/Repiteo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Repiteo/subscriptions","organizations_url":"https://api.github.com/users/Repiteo/orgs","repos_url":"https://api.github.com/users/Repiteo/repos","events_url":"https://api.github.com/users/Repiteo/events{/privacy}","received_events_url":"https://api.github.com/users/Repiteo/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/124635/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/godotengine/godot/issues/124635/timeline","performed_via_github_app":null,"state_reason":null}