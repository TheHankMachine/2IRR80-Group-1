repos/godotengine/godot/pulls/123752"}},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/4081239816/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":155,"original_line":155,"side":"RIGHT","in_reply_to_id":4081102651,"author_association":"CONTRIBUTOR","original_position":4,"position":4,"subject_type":"line"},{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/4081267123","pull_request_review_id":5289566448,"id":4081267123,"node_id":"PRRC_kwDOAO6SJc7zQzGz","diff_hunk":"@@ -152,10 +152,11 @@ bool GDType::bind_method(MethodBind *p_method, bool p_take_ownership) {\n \tERR_FAIL_COND_V(init_state != InitState::MUTABLE, false);\n \n \tif (_members.has(p_method->get_name())) {\n+\t\tERR_PRINT(vformat(\"Object '%s' already has member '%s'.\", get_name(), p_method->get_name()));","path":"core/object/gdtype.cpp","commit_id":"75333f5990bbe88faba9d0dc97513da120dad78f","original_commit_id":"75333f5990bbe88faba9d0dc97513da120dad78f","user":{"login":"Ivorforce","id":2308167,"node_id":"MDQ6VXNlcjIzMDgxNjc=","avatar_url":"https://avatars.githubusercontent.com/u/2308167?v=4","gravatar_id":"","url":"https://api.github.com/users/Ivorforce","html_url":"https://github.com/Ivorforce","followers_url":"https://api.github.com/users/Ivorforce/followers","following_url":"https://api.github.com/users/Ivorforce/following{/other_user}","gists_url":"https://api.github.com/users/Ivorforce/gists{/gist_id}","starred_url":"https://api.github.com/users/Ivorforce/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Ivorforce/subscriptions","organizations_url":"https://api.github.com/users/Ivorforce/orgs","repos_url":"https://api.github.com/users/Ivorforce/repos","events_url":"https://api.github.com/users/Ivorforce/events{/privacy}","received_events_url":"https://api.github.com/users/Ivorforce/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"Yea the error message could be made clearer, but it's already actionable as-is. There's only one combination of member-name and class name that it could refer to, so you can find it by looking at your class and `ctrl-f`-ing the member name. If anything, I'd add the name of the class with which the member conflicts.","created_at":"2026-09-23T10:06:37Z","updated_at":"2026-09-23T11:06:51Z","html_url":"https://github.com/godotengine/godot/pull/123752#discussion_r4081267123","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/123752","_links":{"self":{"href":"https://api.github.com/repos/godotengine/godot/pulls/comments/4081267123"},"html":{"href":"https://github.com/godotengine/godot/pull/123752#discussion_r4081267123"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/123752"}},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/4081267123/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":155,"original_line":155,"side":"RIGHT","in_reply_to_id":4081102651,"author_association":"MEMBER","original_position":4,"position":4,"subject_type":"line"}]