[{"id":3157244208,"node_id":"PRR_kwDOAO6SJc68L7kw","state":"APPROVED","commit_id":"90ff46c2929b39b336f19495db0345b25162116c","user":{"site_admin":false,"suspended":false,"updated_at":"0001-01-01T00:00:00Z","avatar_url":"https://avatars.githubusercontent.com/u/32321?u=c2e06a3d2b49a467aa907e54aa259516440267cc&v=4","created_at":"0001-01-01T00:00:00Z","followers":0,"following":0,"html_url":"https://github.com/fire","id":32321,"node_id":"MDQ6VXNlcjMyMzIx","login":"fire","type":"User","owned_private_repos":0,"public_gists":0,"public_repos":0,"total_private_repos":0,"url":"https://api.github.com/users/fire"},"body":"","html_url":"https://github.com/godotengine/godot/pull/109990#pullrequestreview-3157244208","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/109990","author_association":"MEMBER","submitted_at":"2025-08-26T20:41:39Z"},{"id":3157268994,"node_id":"PRR_kwDOAO6SJc68MBoC","state":"APPROVED","commit_id":"90ff46c2929b39b336f19495db0345b25162116c","user":{"site_admin":false,"suspended":false,"updated_at":"0001-01-01T00:00:00Z","avatar_url":"https://avatars.githubusercontent.com/u/180032?u=68d23e7ee9cdf810da125e8510b72f845b9dccc8&v=4","created_at":"0001-01-01T00:00:00Z","followers":0,"following":0,"html_url":"https://github.com/Calinou","id":180032,"node_id":"MDQ6VXNlcjE4MDAzMg==","login":"Calinou","type":"User","owned_private_repos":0,"public_gists":0,"public_repos":0,"total_private_repos":0,"url":"https://api.github.com/users/Calinou"},"body":"Tested locally, it works as expected. Code looks good to me.\r\n\r\n**Testing project:** [test_pr_109990.zip](https://github.com/user-attachments/files/21995499/test_pr_109990.zip)\r\n\r\nTop-left: Subdivided plane\r\nTop-right: Subdivided plane with Blender's To Sphere operation set to 0.5\r\nBottom-left: UV sphere, smooth-shaded\r\nBottom-right: Icosphere, smooth-shaded (this one can LOD quite a bit more aggressively than the UV sphere).\r\n\r\n### Before\r\n\r\n[master.webm](https://github.com/user-attachments/assets/1a082431-096f-4255-973a-19259212341f)\r\n\r\n### After\r\n\r\n:warning: **Contains flashing images.** :warning: \r\n\r\n[pr.webm](https://github.com/user-attachments/assets/29c7fff9-4852-4f78-ba95-797f9ef1e47b)\r\n\r\nThere's a curious change for the plane LODs, where it will appear very different when the mesh LOD threshold is very close to `0.0`. In `master`, the planes' appearance doesn't change regardless of its value, unless you set it exactly to `0.0` or a negative value, which will disable the use of mesh LODs entirely.\r\n","html_url":"https://github.com/godotengine/godot/pull/109990#pullrequestreview-3157268994","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/109990","author_association":"MEMBER","submitted_at":"2025-08-26T20:48:49Z"},{"id":3235374066,"node_id":"PRR_kwDOAO6SJc7A1-Py","state":"APPROVED","commit_id":"90ff46c2929b39b336f19495db0345b25162116c","user":{"site_admin":false,"suspended":false,"updated_at":"0001-01-01T00:00:00Z","avatar_url":"https://avatars.githubusercontent.com/u/53150244?u=ecf97ffa17ae1eba1167a03358dd88d2b6934497&v=4","created_at":"0001-01-01T00:00:00Z","followers":0,"following":0,"html_url":"https://github.com/BlueCube3310","id":53150244,"node_id":"MDQ6VXNlcjUzMTUwMjQ0","login":"BlueCube3310","type":"User","owned_private_repos":0,"public_gists":0,"public_repos":0,"total_private_repos":0,"url":"https://api.github.com/users/BlueCube3310"},"body":"","html_url":"https://github.com/godotengine/godot/pull/109990#pullrequestreview-3235374066","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/109990","author_association":"CONTRIBUTOR","submitted_at":"2025-09-17T16:53:24Z"}]