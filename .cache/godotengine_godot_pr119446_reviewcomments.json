e/events{/privacy}","received_events_url":"https://api.github.com/users/Ivorforce/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"Why this change?","created_at":"2026-05-19T08:14:01Z","updated_at":"2026-05-19T08:14:01Z","html_url":"https://github.com/godotengine/godot/pull/119446#discussion_r3264690113","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/119446","_links":{"self":{"href":"https://api.github.com/repos/godotengine/godot/pulls/comments/3264690113"},"html":{"href":"https://github.com/godotengine/godot/pull/119446#discussion_r3264690113"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/119446"}},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/3264690113/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":41,"original_start_line":41,"start_side":"RIGHT","line":42,"original_line":42,"side":"RIGHT","author_association":"MEMBER","original_position":5,"position":5,"subject_type":"line"},{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/3264921217","pull_request_review_id":4317297392,"id":3264921217,"node_id":"PRRC_kwDOAO6SJc7Cmr6B","diff_hunk":"@@ -47,6 +47,7 @@ class AudioStreamPlaybackOggVorbis : public AudioStreamPlaybackResampled {\n \tbool looping_override = false;\n \tbool looping = false;\n \tint loops = 0;\n+\tbool beat_loop = false;","path":"modules/vorbis/audio_stream_ogg_vorbis.h","commit_id":"5bcf1dd05c6a03e057ba261bb753aecbf23e53f4","original_commit_id":"d7ff48b74ed28a5e03b9a7d7525b3024fe02396f","user":{"login":"Akosmo","id":95504962,"node_id":"U_kgDOBbFKQg","avatar_url":"https://avatars.githubusercontent.com/u/95504962?v=4","gravatar_id":"","url":"https://api.github.com/users/Akosmo","html_url":"https://github.com/Akosmo","followers_url":"https://api.github.com/users/Akosmo/followers","following_url":"https://api.github.com/users/Akosmo/following{/other_user}","gists_url":"https://api.github.com/users/Akosmo/gists{/gist_id}","starred_url":"https://api.github.com/users/Akosmo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Akosmo/subscriptions","organizations_url":"https://api.github.com/users/Akosmo/orgs","repos_url":"https://api.github.com/users/Akosmo/repos","events_url":"https://api.github.com/users/Akosmo/events{/privacy}","received_events_url":"https://api.github.com/users/Akosmo/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"I wanted to avoid code duplication. That value is already used in [another function](https://github.com/godotengine/godot/blob/ef02314f2bd0305035ecbe907883401a393da7a7/modules/mp3/audio_stream_mp3.cpp#L54), so instead of copying the same line(s), I just moved `beat_loop` to the header so I could reuse it in `seek()`. I can go with your method if you prefer/it's the right approach. It just seemed unnecessary to me.","created_at":"2026-05-19T08:49:57Z","updated_at":"2026-05-19T08:49:58Z","html_url":"https://github.com/godotengine/godot/pull/119446#discussion_r3264921217","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/119446","_links":{"self":{"href":"https://api.github.com/repos/godotengine/godot/pulls/comments/3264921217"},"html":{"href":"https://github.com/godotengine/godot/pull/119446#discussion_r3264921217"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/119446"}},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/3264921217/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":null,"original_line":50,"side":"RIGHT","in_reply_to_id":3264688252,"author_association":"MEMBER","original_position":4,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/3264922131","pull_request_review_id":4317298367,"id":3264922131,"node_id":"PRRC_kwDOAO6SJc7CmsIT","diff_hunk":"@@ -38,6 +38,9 @@ const float TRIM_DB_LIMIT = -50;\n const int TRIM_FADE_OUT_FRAMES = 500;\n \n void AudioStreamPlaybackWAV::start(double p_from_pos) {\n+\tsign = 1;\n+\tactive = true;","path":"scene/resources/audio_stream_wav.cpp","commit_id":"0afaa2d2ae96525e1f5fd9a14b5e12f65aed051b","original_commit_id":"d7ff48b74ed28a5e03b9a7d7525b3024fe02396f","user":{"login":"Akosmo","id":95504962,"node_id":"U_kgDOBbFKQg","avatar_url":"https://avatars.githubusercontent.com/u/95504962?v=4","gravatar_id":"","url":"https://api.github.com/users/Akosmo","html_url":"https://github.com/Akosmo","followers_url":"https://api.github.com/users/Akosmo/followers","following_url":"https://api.github.com/users/Akosmo/following{/other_user}","gists_url":"https://api.github.com/users/Akosmo/gists{/gist_id}","starred_url":"https://api.github.com/users/Akosmo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Akosmo/subscriptions","organizations_url":"https://api.github.com/users/Akosmo/orgs","repos_url":"https://api.github.com/users/Akosmo/repos","events_url":"https://api.github.com/users/Akosmo/events{/privacy}","received_events_url":"https://api.github.com/users/Akosmo/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"Same thing as the other one: avoid duplication - but in this case, it's less clear.\r\nBefore returning an error, `active` has to be set to `false`, since I'm stopping the stream.\r\nIn MP3 and OggVorbis, this is not a problem. When `start()` is called (which is the same as `play()`), it sets `active` to `true`, then calls `seek()` with the time. I can set `active` to `false` in it (or call `stop()`, as I'm doing in this PR) when time is invalid, and all is well ([function](https://github.com/godotengine/godot/blob/ef02314f2bd0305035ecbe907883401a393da7a7/modules/mp3/audio_stream_mp3.cpp#L110)). However, in WAV, within the `start()` function, `seek()` is called first, then `active` is set to `true`. So even if I set `active` to `false` within `seek()`, it'd be set right back to `true` when the `seek()` call is over, continuing/starting the stream.\r\nMy initial idea was to have the same conditional in `seek()`, inside `start()` too, but that seemed unnecessary. Instead, I just changed the order of operations to be the same as MP3 and Ogg Vorbis: set `active` first, then `seek()`.","created_at":"2026-05-19T08:50:04Z","updated_at":"2026-05-19T08:50:04Z","html_url":"https://github.com/godotengine/godot/pull/119446#discussion_r3264922131","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/119446","_links":{"self":{"href":"https://api.github.com/repos/godotengine/godot/pulls/comments/3264922131"},"html":{"href":"https://github.com/godotengine/godot/pull/119446#discussion_r3264922131"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/119446"}},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/3264922131/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":41,"original_start_line":41,"start_side":"RIGHT","line":42,"original_line":42,"side":"RIGHT","in_reply_to_id":3264690113,"author_association":"MEMBER","original_position":5,"position":5,"subject_type":"line"},{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/3264969917","pull_request_review_id":4317360722,"id":3264969917,"node_id":"PRRC_kwDOAO6SJc7Cm3y9","diff_hunk":"@@ -47,6 +47,7 @@ class AudioStreamPlaybackOggVorbis : public AudioStreamPlaybackResampled {\n \tbool looping_override = false;\n \tbool looping = false;\n \tint loops = 0;\n+\tbool beat_loop = false;","path":"modules/vorbis/audio_stream_ogg_vorbis.h","commit_id":"5bcf1dd05c6a03e057ba261bb753aecbf23e53f4","original_commit_id":"d7ff48b74ed28a5e03b9a7d7525b3024fe02396f","user":{"login":"Ivorforce","id":2308167,"node_id":"MDQ6VXNlcjIzMDgxNjc=","avatar_url":"https://avatars.githubusercontent.com/u/2308167?v=4","gravatar_id":"","url":"https://api.github.com/users/Ivorforce","html_url":"https://github.com/Ivorforce","followers_url":"https://api.github.com/users/Ivorforce/followers","following_url":"https://api.github.com/users/Ivorforce/following{/other_user}","gists_url":"https://api.github.com/users/Ivorforce/gists{/gist_id}","starred_url":"https://api.github.com/users/Ivorforce/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Ivorforce/subscriptions","organizations_url":"https://api.github.com/users/Ivorforce/orgs","repos_url":"https://api.github.com/users/Ivorforce/repos","events_url":"https://api.github.com/users/Ivorforce/events{/privacy}","received_events_url":"https://api.github.com/users/Ivorforce/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"Avoiding state is usually more important than avoiding code duplication. New or duplicate state is a common source of bugs.\r\nIn this case you can probably avoid both by creating a small helper function.","created_at":"2026-05-19T08:57:04Z","updated_at":"2026-05-19T09:00:35Z","html_url":"https://github.com/godotengine/godot/pull/119446#discussion_r3264969917","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/119446","_links":{"self":{"href":"https://api.github.com/repos/godotengine/godot/pulls/comments/3264969917"},"html":{"href":"https://github.com/godotengine/godot/pull/119446#discussion_r3264969917"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/119446"}},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/3264969917/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":null,"original_line":50,"side":"RIGHT","in_reply_to_id":3264688252,"author_association":"MEMBER","original_position":4,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/3265182650","pull_request_review_id":4317630208,"id":3265182650,"node_id":"PRRC_kwDOAO6SJc7Cnru6","diff_hunk":"@@ -47,6 +47,7 @@ class AudioStreamPlaybackOggVorbis : public AudioStreamPlaybackResampled {\n \tbool looping_override = false;\n \tbool looping = false;\n \tint loops = 0;\n+\tbool beat_loop = false;","path":"modules/vorbis/audio_stream_ogg_vorbis.h","commit_id":"5bcf1dd05c6a03e057ba261bb753aecbf23e53f4","original_commit_id":"d7ff48b74ed28a5e03b9a7d7525b3024fe02396f","user":{"login":"Akosmo","id":95504962,"node_id":"U_kgDOBbFKQg","avatar_url":"https://avatars.githubusercontent.com/u/95504962?v=4","gravatar_id":"","url":"https://api.github.com/users/Akosmo","html_url":"https://github.com/Akosmo","followers_url":"https://api.github.com/users/Akosmo/followers","following_url":"https://api.github.com/users/Akosmo/following{/other_user}","gists_url":"https://api.github.com/users/Akosmo/gists{/gist_id}","starred_url":"https://api.github.com/users/Akosmo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Akosmo/subscriptions","organizations_url":"https://api.github.com/users/Akosmo/orgs","repos_url":"https://api.github.com/users/Akosmo/repos","events_url":"https://api.github.com/users/Akosmo/events{/privacy}","received_events_url":"https://api.github.com/users/Akosmo/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"Will update. May I ask what do you mean by \"state\"? I'm unfamiliar with the term in this context and would like to learn more.","created_at":"2026-05-19T09:29:27Z","updated_at":"2026-05-19T09:29:27Z","html_url":"https://github.com/godotengine/godot/pull/119446#discussion_r3265182650","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/119446","_links":{"self":{"href":"https://api.github.com/repos/godotengine/godot/pulls/comments/3265182650"},"html":{"href":"https://github.com/godotengine/godot/pull/119446#discussion_r3265182650"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/119446"}},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/3265182650/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":null,"original_line":50,"side":"RIGHT","in_reply_to_id":3264688252,"author_association":"MEMBER","original_position":4,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/3265391066","pull_request_review_id":4317880949,"id":3265391066,"node_id":"PRRC_kwDOAO6SJc7Coena","diff_hunk":"@@ -47,6 +47,7 @@ class AudioStreamPlaybackOggVorbis : public AudioStreamPlaybackResampled {\n \tbool looping_override = false;\n \tbool looping = false;\n \tint loops = 0;\n+\tbool beat_loop = false;","path":"modules/vorbis/audio_stream_ogg_vorbis.h","commit_id":"5bcf1dd05c6a03e057ba261bb753aecbf23e53f4","original_commit_id":"d7ff48b74ed28a5e03b9a7d7525b3024fe02396f","user":{"login":"Ivorforce","id":2308167,"node_id":"MDQ6VXNlcjIzMDgxNjc=","avatar_url":"https://avatars.githubusercontent.com/u/2308167?v=4","gravatar_id":"","url":"https://api.github.com/users/Ivorforce","html_url":"https://github.com/Ivorforce","followers_url":"https://api.github.com/users/Ivorforce/followers","following_url":"https://api.github.com/users/Ivorforce/following{/other_user}","gists_url":"https://api.github.com/users/Ivorforce/gists{/gist_id}","starred_url":"https://api.github.com/users/Ivorforce/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Ivorforce/subscriptions","organizations_url":"https://api.github.com/users/Ivorforce/orgs","repos_url":"https://api.github.com/users/Ivorforce/repos","events_url":"https://api.github.com/users/Ivorforce/events{/privacy}","received_events_url":"https://api.github.com/users/Ivorforce/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"I'm realizing it's surprisingly hard to explain :D\nBasically, state is any value that persists, e.g. a field to the object.\nThat means when you call a function, the output/behavior depends not only on the function arguments but also the state of the object.\nIf you have no state, a function is perfectly deterministic: whatever goes in dictates what comes out. That makes it easy to understand and reason about.\nWhen you have state, that also influences behavior, making it more complex. For example, there is the risk that your `beat_loop` boolean desynchronizes from the value it \"should be\", for example because of execution order, and you suddenly have a bug.\nAudio stream players already have state of course, but more state means more complexity, which means more risk of bugs.","created_at":"2026-05-19T09:58:06Z","updated_at":"2026-05-19T10:00:47Z","html_url":"https://github.com/godotengine/godot/pull/119446#discussion_r3265391066","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/119446","_links":{"self":{"href":"https://api.github.com/repos/godotengine/godot/pulls/comments/3265391066"},"html":{"href":"https://github.com/godotengine/godot/pull/119446#discussion_r3265391066"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/119446"}},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/3265391066/reactions","total_count":2,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":1,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":null,"original_line":50,"side":"RIGHT","in_reply_to_id":3264688252,"author_association":"MEMBER","original_position":4,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/3277677758","pull_request_review_id":4332813792,"id":3277677758,"node_id":"PRRC_kwDOA