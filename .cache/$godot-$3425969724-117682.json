[{"id":3982941948,"node_id":"PRR_kwDOAO6SJc7tZt78","state":"DISMISSED","user":{"site_admin":false,"suspended":false,"updated_at":"0001-01-01T00:00:00Z","avatar_url":"https://avatars.githubusercontent.com/u/2308167?u=f7f8e0273f784f5ec6f6b7fe4a88d449896eb48a&v=4","created_at":"0001-01-01T00:00:00Z","followers":0,"following":0,"html_url":"https://github.com/Ivorforce","id":2308167,"node_id":"MDQ6VXNlcjIzMDgxNjc=","login":"Ivorforce","type":"User","owned_private_repos":0,"public_gists":0,"public_repos":0,"total_private_repos":0,"url":"https://api.github.com/users/Ivorforce"},"body":"This is not how `GDType` is intended to work.\r\nAdding signals should only happen in `_register_methods`, which should only happen during the app launch lifecycle on the main thread. \r\nDoing it elsewhere would be a violation of typing semantics / coherence, and would lead to problems when we further try to optimize and consolidate the type system.\r\n\r\nCould you explain why the plugin system is trying to register signals from another thread, outside `_bind_methods`?\r\n_(for readers' context: All other systems in Godot are required to register everything in `_register_methods` as well, as are GDExtensions)_","html_url":"https://github.com/godotengine/godot/pull/117682#pullrequestreview-3982941948","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/117682","author_association":"MEMBER","submitted_at":"2026-03-20T17:21:14Z"},{"id":3983323167,"node_id":"PRR_kwDOAO6SJc7tbLAf","state":"COMMENTED","user":{"site_admin":false,"suspended":false,"updated_at":"0001-01-01T00:00:00Z","avatar_url":"https://avatars.githubusercontent.com/u/914968?u=5f2b0cb28e37393252e96695f2eaa33494930285&v=4","created_at":"0001-01-01T00:00:00Z","followers":0,"following":0,"html_url":"https://github.com/m4gr3d","id":914968,"node_id":"MDQ6VXNlcjkxNDk2OA==","login":"m4gr3d","type":"User","owned_private_repos":0,"public_gists":0,"public_repos":0,"total_private_repos":0,"url":"https://api.github.com/u