e_id":"LA_kwDOAO6SJc8AAAAB5NI2wQ","url":"https://api.github.com/repos/godotengine/godot/labels/topic:i18n","name":"topic:i18n","color":"ffee88","default":false,"description":"","archived_at":null,"archived_by":null}],"state":"closed","locked":false,"assignees":[],"milestone":{"url":"https://api.github.com/repos/godotengine/godot/milestones/22","html_url":"https://github.com/godotengine/godot/milestone/22","labels_url":"https://api.github.com/repos/godotengine/godot/milestones/22/labels","id":12070367,"node_id":"MI_kwDOAO6SJc4AuC3f","number":22,"title":"4.5","description":"","creator":{"login":"Sauermann","id":6299227,"node_id":"MDQ6VXNlcjYyOTkyMjc=","avatar_url":"https://avatars.githubusercontent.com/u/6299227?v=4","gravatar_id":"","url":"https://api.github.com/users/Sauermann","html_url":"https://github.com/Sauermann","followers_url":"https://api.github.com/users/Sauermann/followers","following_url":"https://api.github.com/users/Sauermann/following{/other_user}","gists_url":"https://api.github.com/users/Sauermann/gists{/gist_id}","starred_url":"https://api.github.com/users/Sauermann/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Sauermann/subscriptions","organizations_url":"https://api.github.com/users/Sauermann/orgs","repos_url":"https://api.github.com/users/Sauermann/repos","events_url":"https://api.github.com/users/Sauermann/events{/privacy}","received_events_url":"https://api.github.com/users/Sauermann/received_events","type":"User","user_view_type":"public","site_admin":false},"open_issues":3,"closed_issues":3687,"state":"closed","created_at":"2024-12-19T08:51:28Z","updated_at":"2026-09-04T21:48:38Z","due_on":"2025-09-15T00:00:00Z","closed_at":"2025-09-18T17:13:14Z"},"comments":4,"created_at":"2025-02-07T21:41:08Z","updated_at":"2025-03-27T15:37:14Z","closed_at":"2025-03-24T20:36:00Z","assignee":null,"author_association":"MEMBER","issue_field_values":[],"type":null,"active_lock_reason":null,"draft":false,"pull_request":{"url":"https://api.github.com/repos/godotengine/godot/pulls/102562","html_url":"https://github.com/godotengine/godot/pull/102562","diff_url":"https://github.com/godotengine/godot/pull/102562.diff","patch_url":"https://github.com/godotengine/godot/pull/102562.patch","merged_at":"2025-03-24T20:36:00Z"},"body":"Currently changing editor language requires editor restart. Godot has a good auto-translation system, which is under-utilized in the editor. For a long time the editor auto-translation was completely disabled. Then there is TTR method which we use everywhere, which makes it impossible to auto-translate, because it immediately translates the string.\r\n\r\n#75012 enabled auto-translation to work in the editor, and recently there were some efforts to replace TTR with TTRC (e.g. #99158). Also in 4.4 there were various GUI enhancements that added better localization support to many Control nodes.\r\n\r\nThis PR makes another step - it actually enables language switching in the editor.\r\n\r\nhttps://github.com/user-attachments/assets/4f8bf1a4-a8b4-437d-85ce-84f118ab63cf\r\n\r\nThough as you can see, it's very basic right now. For proper language switching we need to use TTRC where possible, and NOTIFICATION_TRANSLATION_CHANGED where not (e.g. in format strings). Thus, while the PR makes changing the language setting have immediate effect, the user is still prompted to restart the editor as before.\r\n\r\nIMO enabling this before the editor is ready is harmless, while it allows for easier testing of auto-translation. Eventually we will be able to properly switch editor language without restart at all.\r\n\r\nIncluded some extra changes to the top menu bar, to make it more obvious that the language has changed.","closed_by":{"login":"Repiteo","id":17489292,"node_id":"MDQ6VXNlcjE3NDg5Mjky","avatar_url":"https://avatars.githubusercontent.com/u/17489292?v=4","gravatar_id":"","url":"https://api.github.com/users/Repiteo","html_url":"https://github.com/Repiteo","followers_url":"https://api.github.com/users/Repiteo/followers","following_url":"https://api.github.com/users/Repiteo/following{/other_user}","gists_url":"https://api.github.com/users/Repiteo/gists{/gist_id}","starred_url":"https://api.github.com/users/Repiteo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Repiteo/subscriptions","organizations_url":"https://api.github.com/users/Repiteo/orgs","repos_url":"https://api.github.com/users/Repiteo/repos","events_url":"https://api.github.com/users/Repiteo/events{/privacy}","received_events_url":"https://api.github.com/users/Repiteo/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/102562/reactions","total_count":34,"+1":15,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":9,"rocket":7,"eyes":3},"timeline_url":"https://api.github.com/repos/godotengine/godot/issues/102562/timeline","performed_via_github_app":null,"state_reason":null}