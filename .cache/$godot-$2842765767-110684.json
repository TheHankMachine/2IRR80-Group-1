[{"id":3244843453,"node_id":"PRR_kwDOAO6SJc7BaGG9","state":"COMMENTED","user":{"site_admin":false,"suspended":false,"updated_at":"0001-01-01T00:00:00Z","avatar_url":"https://avatars.githubusercontent.com/u/180032?u=68d23e7ee9cdf810da125e8510b72f845b9dccc8&v=4","created_at":"0001-01-01T00:00:00Z","followers":0,"following":0,"html_url":"https://github.com/Calinou","id":180032,"node_id":"MDQ6VXNlcjE4MDAzMg==","login":"Calinou","type":"User","owned_private_repos":0,"public_gists":0,"public_repos":0,"total_private_repos":0,"url":"https://api.github.com/users/Calinou"},"body":"Using `RS::get_singleton()->is_low_end()` will change the created code depending on the current rendering driver, which means that if you convert a BaseMaterial3D to a ShaderMaterial while using Compatibility, it will break on Forward+/Mobile and vice versa. This is an issue if you switch rendering methods during development, or even if an automatic fallback is applied on the user's device.\r\n\r\nWe should use the shader preprocessor instead, but it's currently broken when used in BaseMaterial3D (as I mentioned in https://github.com/godotengine/godot/issues/87486#issuecomment-2663688834).","html_url":"https://github.com/godotengine/godot/pull/110684#pullrequestreview-3244843453","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/110684","author_association":"MEMBER","submitted_at":"2025-09-19T13:20:32Z"},{"id":3301625667,"node_id":"PRR_kwDOAO6SJc7Eys9D","state":"CHANGES_REQUESTED","user":{"site_admin":false,"suspended":false,"updated_at":"0001-01-01T00:00:00Z","avatar_url":"https://avatars.githubusercontent.com/u/16521339?u=e44a465cbebabb9ea2be80b59e6dc07966bef5b7&v=4","created_at":"0001-01-01T00:00:00Z","followers":0,"following":0,"html_url":"https://github.com/clayjohn","id":16521339,"node_id":"MDQ6VXNlcjE2NTIxMzM5","login":"clayjohn","type":"User","owned_private_repos":0,"public_gists":0,"public_repos":0,"total_private_repos":0,"url":"https://api.github.com/users/clayjohn"}