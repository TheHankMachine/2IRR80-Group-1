ssignees":[],"milestone":{"url":"https://api.github.com/repos/godotengine/godot/milestones/24","html_url":"https://github.com/godotengine/godot/milestone/24","labels_url":"https://api.github.com/repos/godotengine/godot/milestones/24/labels","id":14236899,"node_id":"MI_kwDOAO6SJc4A2Tzj","number":24,"title":"4.7","description":"","creator":{"login":"akien-mga","id":4701338,"node_id":"MDQ6VXNlcjQ3MDEzMzg=","avatar_url":"https://avatars.githubusercontent.com/u/4701338?v=4","gravatar_id":"","url":"https://api.github.com/users/akien-mga","html_url":"https://github.com/akien-mga","followers_url":"https://api.github.com/users/akien-mga/followers","following_url":"https://api.github.com/users/akien-mga/following{/other_user}","gists_url":"https://api.github.com/users/akien-mga/gists{/gist_id}","starred_url":"https://api.github.com/users/akien-mga/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/akien-mga/subscriptions","organizations_url":"https://api.github.com/users/akien-mga/orgs","repos_url":"https://api.github.com/users/akien-mga/repos","events_url":"https://api.github.com/users/akien-mga/events{/privacy}","received_events_url":"https://api.github.com/users/akien-mga/received_events","type":"User","user_view_type":"public","site_admin":false},"open_issues":3,"closed_issues":2535,"state":"closed","created_at":"2025-11-27T20:29:18Z","updated_at":"2026-10-20T18:39:31Z","due_on":null,"closed_at":"2026-06-19T16:54:35Z"},"comments":6,"created_at":"2026-02-12T08:54:06Z","updated_at":"2026-02-25T15:59:15Z","closed_at":"2026-02-25T15:34:13Z","assignee":null,"author_association":"MEMBER","issue_field_values":[],"type":null,"active_lock_reason":null,"draft":false,"pull_request":{"url":"https://api.github.com/repos/godotengine/godot/pulls/116199","html_url":"https://github.com/godotengine/godot/pull/116199","diff_url":"https://github.com/godotengine/godot/pull/116199.diff","patch_url":"https://github.com/godotengine/godot/pull/116199.patch","merged_at":"2026-02-25T15:34:13Z"},"body":"<!--\r\nPlease target the `master` branch in priority.\r\n\r\nRelevant fixes are cherry-picked for stable branches as needed by maintainers.\r\n\r\nTo speed up the contribution process and avoid CI errors, please set up pre-commit hooks locally:\r\nhttps://contributing.godotengine.org/en/latest/engine/guidelines/code_style.html\r\n-->\r\nMaking improvements to several class reference files for AudioEffects. Mostly adding missing info and changing wording, but also describing some effects in more depth, while not making it too verbose, so that it could be helpful to someone who's not familiar with them, and let people experienced with audio know their tools in detail.\r\n\r\nHere's what I did:\r\n\r\n- [x] Added missing info to `AudioEffectDistortion`\r\n- [x] Added missing info to `AudioEffectLimiter`\r\n- [x] Added missing info to `AudioEffectChorus`\r\n- [x] Polish other audio effects (explanations, fixing mistakes, etc.)\r\n\r\nThere are some weird things about some effects, but I documented them as they exist.\r\n\r\nI'm very interested about audio and I know a couple of things. Unfortunately, I see that this area of the engine is really lacking, so I'm doing my best to improve it. There were some things that lacked descriptions or were not explained properly; the user is left to guess how things work, or searching a lot outside of the engine.\r\n\r\nChallenges:\r\nI am an experienced music producer, not an audio developer. As stated, I don't have much idea how these things work in code. I did my best to understand by researching online, reading Godot's code, and running tests.\r\nI'm also not a technical writer, and English isn't my first language. While I'm confident in day-to-day communication, writing easy-to-understand documentation is not my strong suit. I did my best to follow the guidelines.","closed_by":{"login":"Repiteo","id":17489292,"node_id":"MDQ6VXNlcjE3NDg5Mjky","avatar_url":"https://avatars.githubusercontent.com/u/17489292?v=4","gravatar_id":"","url":"https://api.github.com/users/Repiteo","html_url":"https://github.com/Repiteo","followers_url":"https://api.github.com/users/Repiteo/followers","following_url":"https://api.github.com/users/Repiteo/following{/other_user}","gists_url":"https://api.github.com/users/Repiteo/gists{/gist_id}","starred_url":"https://api.github.com/users/Repiteo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Repiteo/subscriptions","organizations_url":"https://api.github.com/users/Repiteo/orgs","repos_url":"https://api.github.com/users/Repiteo/repos","events_url":"https://api.github.com/users/Repiteo/events{/privacy}","received_events_url":"https://api.github.com/users/Repiteo/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/116199/reactions","total_count":17,"+1":12,"-1":0,"laugh":0,"hooray":5,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/godotengine/godot/issues/116199/timeline","performed_via_github_app":null,"state_reason":null}