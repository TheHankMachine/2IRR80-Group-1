b.com/repos/godotengine/godot/labels/topic:rendering","name":"topic:rendering","color":"ffee88","default":false,"description":"","archived_at":null,"archived_by":null},{"id":3240950060,"node_id":"MDU6TGFiZWwzMjQwOTUwMDYw","url":"https://api.github.com/repos/godotengine/godot/labels/performance","name":"performance","color":"447777","default":false,"description":"","archived_at":null,"archived_by":null}],"state":"closed","locked":false,"assignees":[],"milestone":{"url":"https://api.github.com/repos/godotengine/godot/milestones/23","html_url":"https://github.com/godotengine/godot/milestone/23","labels_url":"https://api.github.com/repos/godotengine/godot/milestones/23/labels","id":12939969,"node_id":"MI_kwDOAO6SJc4AxXLB","number":23,"title":"4.6","description":"","creator":{"login":"Repiteo","id":17489292,"node_id":"MDQ6VXNlcjE3NDg5Mjky","avatar_url":"https://avatars.githubusercontent.com/u/17489292?v=4","gravatar_id":"","url":"https://api.github.com/users/Repiteo","html_url":"https://github.com/Repiteo","followers_url":"https://api.github.com/users/Repiteo/followers","following_url":"https://api.github.com/users/Repiteo/following{/other_user}","gists_url":"https://api.github.com/users/Repiteo/gists{/gist_id}","starred_url":"https://api.github.com/users/Repiteo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Repiteo/subscriptions","organizations_url":"https://api.github.com/users/Repiteo/orgs","repos_url":"https://api.github.com/users/Repiteo/repos","events_url":"https://api.github.com/users/Repiteo/events{/privacy}","received_events_url":"https://api.github.com/users/Repiteo/received_events","type":"User","user_view_type":"public","site_admin":false},"open_issues":3,"closed_issues":2978,"state":"closed","created_at":"2025-05-22T16:25:52Z","updated_at":"2026-10-04T16:23:23Z","due_on":null,"closed_at":"2026-01-26T18:09:14Z"},"comments":3,"created_at":"2025-10-17T11:33:46Z","updated_at":"2026-01-15T09:16:02Z","closed_at":"2025-11-04T09:55:20Z","assignee":null,"author_association":"MEMBER","issue_field_values":[],"type":null,"active_lock_reason":null,"draft":false,"pull_request":{"url":"https://api.github.com/repos/godotengine/godot/pulls/111762","html_url":"https://github.com/godotengine/godot/pull/111762","diff_url":"https://github.com/godotengine/godot/pull/111762.diff","patch_url":"https://github.com/godotengine/godot/pull/111762.patch","merged_at":"2025-11-04T09:55:20Z"},"body":"Follow-up PR to https://github.com/godotengine/godot/pull/111356.\r\n\r\n## Shader Conversion Time Reduction\r\n\r\nPartner PR: https://github.com/godotengine/godot-nir-static/pull/23\r\n\r\nReduces shader conversion time up to 2x - 2.5x depending on the project. In TPS Demo, the loading screen goes from 82 seconds to 33 seconds on my system. For reference, Vulkan is 15 seconds.\r\n\r\nNOTE: If you want to make a comparison yourself, you need to clear both Godot and driver shader caches before each launch to have a fair comparison:\r\n- Editor shader cache: `project/.godot/shader_cache`\r\n- Game shader cache: `%APPDATA%/Godot/app_userdata/project/shader_cache`\r\n- NVIDIA shader cache: `%LOCALAPPDATA%/NVIDIA`\r\n- AMD shader cache: `%LOCALAPPDATA%/AMD`\r\n\r\n## Specialization Constants Bitmasking Fix\r\n\r\nPartner PR: https://github.com/godotengine/godot-nir-static/pull/22\r\n\r\nOld behavior used to set the second MSB to 1, then mask that out inside the DXIL shader. We shouldn't do that anymore now that we allow all of the specialization constant bits. \r\n\r\nThis was causing less shadow map samples to be used, notably with the \"Soft High (Slow)\" mode for \"Soft Shadow Filter Quality\" parameter:\r\n\r\n|Upstream|This PR|\r\n|-|-|\r\n|<img width=\"1356\" height=\"836\" alt=\"Upstream\" src=\"https://github.com/user-attachments/assets/331390e5-e5d3-4abe-b6d4-f068c734f6a8\" />|<img width=\"1356\" height=\"836\" alt=\"PR\" src=\"https://github.com/user-attachments/assets/e2388417-406d-4876-8fe0-50aba3c31dcf\" />|","closed_b