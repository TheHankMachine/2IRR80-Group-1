mann/repos","events_url":"https://api.github.com/users/Sauermann/events{/privacy}","received_events_url":"https://api.github.com/users/Sauermann/received_events","type":"User","user_view_type":"public","site_admin":false},"open_issues":3,"closed_issues":3687,"state":"closed","created_at":"2024-12-19T08:51:28Z","updated_at":"2026-09-04T21:48:38Z","due_on":"2025-09-15T00:00:00Z","closed_at":"2025-09-18T17:13:14Z"},"comments":8,"created_at":"2025-05-15T06:37:48Z","updated_at":"2025-05-19T13:04:33Z","closed_at":"2025-05-19T13:04:27Z","assignee":{"login":"bruvzg","id":7645683,"node_id":"MDQ6VXNlcjc2NDU2ODM=","avatar_url":"https://avatars.githubusercontent.com/u/7645683?v=4","gravatar_id":"","url":"https://api.github.com/users/bruvzg","html_url":"https://github.com/bruvzg","followers_url":"https://api.github.com/users/bruvzg/followers","following_url":"https://api.github.com/users/bruvzg/following{/other_user}","gists_url":"https://api.github.com/users/bruvzg/gists{/gist_id}","starred_url":"https://api.github.com/users/bruvzg/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/bruvzg/subscriptions","organizations_url":"https://api.github.com/users/bruvzg/orgs","repos_url":"https://api.github.com/users/bruvzg/repos","events_url":"https://api.github.com/users/bruvzg/events{/privacy}","received_events_url":"https://api.github.com/users/bruvzg/received_events","type":"User","user_view_type":"public","site_admin":false},"author_association":"NONE","issue_field_values":[],"type":null,"active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"### Tested versions\n\nv4.4.1.stable.official [49a5bc7b6]\n\n### System information\n\nGodot Engine v4.4.1.stable.official.49a5bc7b6 - https://godotengine.org OpenGL API 4.1 Metal - 89.3 - Compatibility - Using Device: Apple - Apple M2 Max\n\n### Issue description\n\nOpenType SVG font glyphs aren't being rendered with proper kerning.\n\nThe font `KerningTest-Regular.otf` (included in minimal repro project below) defines glyphs for `⓪①②③④⑤⑥⑦⑧⑨`.  In other programs (eg. Notes app) the font is rendered like this:\n\n<img width=\"992\" alt=\"Image\" src=\"https://github.com/user-attachments/assets/74bcfae8-bef1-43f4-bc48-cca93bf2259a\" />\n\nIn Godot, the glyphs show up in the editor like this (Note how the bounding box seems to be cutting off the glyphs.):\n<img width=\"1570\" alt=\"Image\" src=\"https://github.com/user-attachments/assets/daba121f-708c-4cc4-9e2d-09c86837240f\" />\n\nWhen you run the game, it looks similar (Note how the glyphs are all squished together and not respecting kerning compared to the Notes app screenshot):\n<img width=\"512\" alt=\"Image\" src=\"https://github.com/user-attachments/assets/5c5badfe-1330-412e-b1cc-36cbd161060b\" />\n\nThe bounding box problem also manifests as clipping the glyphs if you set Clip Text to true:\n<img width=\"642\" alt=\"Image\" src=\"https://github.com/user-attachments/assets/b01485e3-c66e-46b7-91c0-f560c94ad712\" />\n\nFor reference, what the bounding box for Label looks like for this text using the system font (Clip Text is true):\n<img width=\"637\" alt=\"Image\" src=\"https://github.com/user-attachments/assets/5c6b9368-124e-4a12-8ddd-2d059f213b20\" />\n\nIf you install the included KerningTest-Regular.otf, you can test what the proper kerning behavior should be in the text editor of your choice.\n\n### Steps to reproduce\n\nCreate a Label node with the following text:\n```\n⓪①②③④⑤⑥⑦⑧⑨\n```\n\nSet Theme Override -> Font to use the SVG OpenType font `KerningTest-Regular.otf` (included in minimal repro project below).\n\n### Minimal reproduction project (MRP)\n\n[kerningbug.zip](https://github.com/user-attachments/files/20222267/kerningbug.zip)","closed_by":{"login":"Repiteo","id":17489292,"node_id":"MDQ6VXNlcjE3NDg5Mjky","avatar_url":"https://avatars.githubusercontent.com/u/17489292?v=4","gravatar_id":"","url":"https://api.github.com/users/Repiteo","html_url":"https://github.com/Repiteo","followers_url":"https://api.github.com/users/Repiteo/followers","following_url":"https://api.github.com/users/Repiteo/following{/other_user}","gists_url":"https://api.github.com/users/Repiteo/gists{/gist_id}","starred_url":"https://api.github.com/users/Repiteo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Repiteo/subscriptions","organizations_url":"https://api.github.com/users/Repiteo/orgs","repos_url":"https://api.github.com/users/Repiteo/repos","events_url":"https://api.github.com/users/Repiteo/events{/privacy}","received_events_url":"https://api.github.com/users/Repiteo/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/106429/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/godotengine/godot/issues/106429/timeline","performed_via_github_app":null,"state_reason":"completed","pinned_comment":null}