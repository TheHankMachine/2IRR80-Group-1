[{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3442942181","html_url":"https://github.com/godotengine/godot/issues/111991#issuecomment-3442942181","issue_url":"https://api.github.com/repos/godotengine/godot/issues/111991","id":3442942181,"node_id":"IC_kwDOAO6SJc7NNyDl","user":{"login":"AThousandShips","id":96648715,"node_id":"U_kgDOBcK-Cw","avatar_url":"https://avatars.githubusercontent.com/u/96648715?v=4","gravatar_id":"","url":"https://api.github.com/users/AThousandShips","html_url":"https://github.com/AThousandShips","followers_url":"https://api.github.com/users/AThousandShips/followers","following_url":"https://api.github.com/users/AThousandShips/following{/other_user}","gists_url":"https://api.github.com/users/AThousandShips/gists{/gist_id}","starred_url":"https://api.github.com/users/AThousandShips/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/AThousandShips/subscriptions","organizations_url":"https://api.github.com/users/AThousandShips/orgs","repos_url":"https://api.github.com/users/AThousandShips/repos","events_url":"https://api.github.com/users/AThousandShips/events{/privacy}","received_events_url":"https://api.github.com/users/AThousandShips/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-10-24T12:40:44Z","updated_at":"2025-10-24T12:40:44Z","body":"> Canvaslayer: The elements inside are flipped in the opposite direction.\n\nDo you mean that they are right to left or left to right? `CanvasLayer` isn't expected to obey the right to left switch in itself, you need to use controls inside it to handle this\n\nPlease provide an MRP to make this easier to test and fix:\n- A small Godot project which reproduces the issue, with no unnecessary files included. Be sure to not include the `.godot` folder in the archive (but keep `project.godot`).\n- Having an MRP is very important for contributors to be able to reproduce the bug in the same way that you are experiencing it. When testing a potential fix for the issue, contributors will use the MRP to validate that the fix is working as intended.\n- Drag and drop a ZIP archive to upload it (max 10 MB). **Do not select another field until the project is done uploading.**\n- **Note for C# users:** If your issue is *not* C#-specific, please upload a minimal reproduction project written in GDScript. This will make it easier for contributors to reproduce the issue locally as not everyone has a .NET setup available. ","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3442942181/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3446143085","html_url":"https://github.com/godotengine/godot/issues/111991#issuecomment-3446143085","issue_url":"https://api.github.com/repos/godotengine/godot/issues/111991","id":3446143085,"node_id":"IC_kwDOAO6SJc7NZ_ht","user":{"login":"helloworld3012","id":189220499,"node_id":"U_kgDOC0dGkw","avatar_url":"https://avatars.githubusercontent.com/u/189220499?v=4","gravatar_id":"","url":"https://api.github.com/users/helloworld3012","html_url":"https://github.com/helloworld3012","followers_url":"https://api.github.com/users/helloworld3012/followers","following_url":"https://api.github.com/users/helloworld3012/following{/other_user}","gists_url":"https://api.github.com/users/helloworld3012/gists{/gist_id}","starred_url":"https://api.github.com/users/helloworld3012/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/helloworld3012/subscriptions","organizations_url":"https://api.github.com/users/helloworld3012/orgs","repos_url":"https://api.github.com/users/helloworld3012/repos","events_url":"https://api.github.com/users/helloworld3012/events{/privacy}","received_events_url":"https://api.github.com/users/helloworld3012/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-10-25T07:58:25Z","updated_at":"2025-10-25T08:36:38Z","body":"![Image](https://github.com/user-attachments/assets/dbaf39af-82a2-4fcc-9052-913052408f01)\n\nYou can easily reproduce this yourself:\n\n1. Create new Godot project  \n2. Add TileMap node\n3. In Editor Settings → Interface → Layout Direction → Set to 'Right-to-Left'\n4. Try to pan/move the image preview in TileSet editor - you'll see the movement is restricted and broken Towards the right.\n\nThe issue is in the TileSet editor UI, not in my specific project setup.\n\nI've already attached an image showing the problem, and I can create a video demonstration if needed.","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3446143085/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3446442417","html_url":"https://github.com/godotengine/godot/issues/111991#issuecomment-3446442417","issue_url":"https://api.github.com/repos/godotengine/godot/issues/111991","id":3446442417,"node_id":"IC_kwDOAO6SJc7NbImx","user":{"login":"AThousandShips","id":96648715,"node_id":"U_kgDOBcK-Cw","avatar_url":"https://avatars.githubusercontent.com/u/96648715?v=4","gravatar_id":"","url":"https://api.github.com/users/AThousandShips","html_url":"https://github.com/AThousandShips","followers_url":"https://api.github.com/users/AThousandShips/followers","following_url":"https://api.github.com/users/AThousandShips/following{/other_user}","gists_url":"https://api.github.com/users/AThousandShips/gists{/gist_id}","starred_url":"https://api.github.com/users/AThousandShips/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/AThousandShips/subscriptions","organizations_url":