el/following{/other_user}","gists_url":"https://api.github.com/users/FabriceCastel/gists{/gist_id}","starred_url":"https://api.github.com/users/FabriceCastel/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/FabriceCastel/subscriptions","organizations_url":"https://api.github.com/users/FabriceCastel/orgs","repos_url":"https://api.github.com/users/FabriceCastel/repos","events_url":"https://api.github.com/users/FabriceCastel/events{/privacy}","received_events_url":"https://api.github.com/users/FabriceCastel/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-04-27T22:42:18Z","updated_at":"2026-04-27T22:42:18Z","body":"Sure thing. These recordings are the repro project attached above. FWIW I'm on macOS 15.0 (yes yes I'm really overdue for an update...)\n\nWorking as intended on 4.7dev4\n\nhttps://github.com/user-attachments/assets/d49e41b7-aae0-4024-aaf9-c4d86002197f\n\nAnd the broken behavior (seeing the same on everything in 4.7dev5 and onward - this recording was on 4.7beta1)\n\nhttps://github.com/user-attachments/assets/9b6133c9-130e-451d-ab2b-bdb73f2914f7","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4330990867/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4331806636","html_url":"https://github.com/godotengine/godot/issues/118941#issuecomment-4331806636","issue_url":"https://api.github.com/repos/godotengine/godot/issues/118941","id":4331806636,"node_id":"IC_kwDOAO6SJc8AAAABAjIfrA","user":{"login":"Alex2782","id":41921395,"node_id":"MDQ6VXNlcjQxOTIxMzk1","avatar_url":"https://avatars.githubusercontent.com/u/41921395?v=4","gravatar_id":"","url":"https://api.github.com/users/Alex2782","html_url":"https://github.com/Alex2782","followers_url":"https://api.github.com/users/Alex2782/followers","following_url":"https://api.github.com/users/Alex2782/following{/other_user}","gists_url":"https://api.github.com/users/Alex2782/gists{/gist_id}","starred_url":"https://api.github.com/users/Alex2782/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Alex2782/subscriptions","organizations_url":"https://api.github.com/users/Alex2782/orgs","repos_url":"https://api.github.com/users/Alex2782/repos","events_url":"https://api.github.com/users/Alex2782/events{/privacy}","received_events_url":"https://api.github.com/users/Alex2782/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-04-28T02:00:45Z","updated_at":"2026-04-28T02:13:37Z","body":"\nI couldn't reproduce it (MacOS 26), but I do see changes to the code made a month ago in this function. \nCan you reproduce it with `Embedded` disabled? @FabriceCastel \n\n```cpp\nvoid DisplayServerMacOSEmbedded::warp_mouse(const Point2i &p_position) {\n\t_THREAD_SAFE_METHOD_\n\tInput::get_singleton()->set_mouse_position(p_position);\n\t// Convert from game pixels to points for the editor.\n\tfloat inv_scale = 1.0f / screen_get_max_scale();\n\tEngineDebugger::get_singleton()->send_message(\"game_view:warp_mouse\", { Point2i(inv_scale * p_position) });\n}\n```\n\n--------------\n\n**EDIT:** You could also check if the function `screen_get_max_scale` returns identical values.\nPresumably `inv_scale` = 0 when position 0 is being calculated.\n\nhttps://docs.godotengine.org/en/stable/classes/class_displayserver.html#class-displayserver-method-screen-get-max-scale\n","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4331806636/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4364968546","html_url":"https://github.com/godotengine/godot/issues/118941#issuecomment-4364968546","issue_url":"https://api.github.com/repos/godotengine/godot/issues/118941","id":4364968546,"node_id":"IC_kwDOAO6SJc8AAAABBCwiYg","user":{"login":"FabriceCastel","id":2886675,"node_id":"MDQ6VXNlcjI4ODY2NzU=","avatar_url":"https://avatars.githubusercontent.com/u/2886675?v=4","gravatar_id":"","url":"https://api.github.com/users/FabriceCastel","html_url":"https://github.com/FabriceCastel","followers_url":"https://api.github.com/users/FabriceCastel/followers","following_url":"https://api.github.com/users/FabriceCastel/following{/other_user}","gists_url":"https://api.github.com/users/FabriceCastel/gists{/gist_id}","starred_url":"https://api.github.com/users/FabriceCastel/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/FabriceCastel/subscriptions","organizations_url":"https://api.github.com/users/FabriceCastel/orgs","repos_url":"https://api.github.com/users/FabriceCastel/repos","events_url":"https://api.github.com/users/FabriceCastel/events{/privacy}","received_events_url":"https://api.github.com/users/FabriceCastel/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-05-02T23:45:16Z","updated_at":"2026-05-02T23:45:16Z","body":"@Alex2782 your instincts are correct - the bug does not happen if I run the game and disable the embedded window option","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4364968546/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4511560693","html_url":"https://github.com/godotengine/godot/issues/118941#issuecomment-4511560693","issue_url":"https://api.github.com/repos/godotengine/godot/issues/118941","id":4511560693,"node_id":"IC_kwDOAO6SJc8AAAA