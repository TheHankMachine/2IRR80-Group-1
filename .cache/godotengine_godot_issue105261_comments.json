llowers","following_url":"https://api.github.com/users/kitbear444/following{/other_user}","gists_url":"https://api.github.com/users/kitbear444/gists{/gist_id}","starred_url":"https://api.github.com/users/kitbear444/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/kitbear444/subscriptions","organizations_url":"https://api.github.com/users/kitbear444/orgs","repos_url":"https://api.github.com/users/kitbear444/repos","events_url":"https://api.github.com/users/kitbear444/events{/privacy}","received_events_url":"https://api.github.com/users/kitbear444/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-04-11T15:31:12Z","updated_at":"2025-04-11T15:31:12Z","body":"Looking great, thanks for jumping on it so quick! I'll continue to monitor the pull request.","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2797243303/reactions","total_count":1,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":1,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2797248067","html_url":"https://github.com/godotengine/godot/issues/105261#issuecomment-2797248067","issue_url":"https://api.github.com/repos/godotengine/godot/issues/105261","id":2797248067,"node_id":"IC_kwDOAO6SJc6mup5D","user":{"login":"ytianle","id":61530469,"node_id":"MDQ6VXNlcjYxNTMwNDY5","avatar_url":"https://avatars.githubusercontent.com/u/61530469?v=4","gravatar_id":"","url":"https://api.github.com/users/ytianle","html_url":"https://github.com/ytianle","followers_url":"https://api.github.com/users/ytianle/followers","following_url":"https://api.github.com/users/ytianle/following{/other_user}","gists_url":"https://api.github.com/users/ytianle/gists{/gist_id}","starred_url":"https://api.github.com/users/ytianle/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/ytianle/subscriptions","organizations_url":"https://api.github.com/users/ytianle/orgs","repos_url":"https://api.github.com/users/ytianle/repos","events_url":"https://api.github.com/users/ytianle/events{/privacy}","received_events_url":"https://api.github.com/users/ytianle/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-04-11T15:33:01Z","updated_at":"2025-04-11T15:35:19Z","body":"After seeing the PR comments, I dug a little bit.. It seems more complicated than my previous thoughts. I am working on fixing it with a new way.","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2797248067/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2797655130","html_url":"https://github.com/godotengine/godot/issues/105261#issuecomment-2797655130","issue_url":"https://api.github.com/repos/godotengine/godot/issues/105261","id":2797655130,"node_id":"IC_kwDOAO6SJc6mwNRa","user":{"login":"beicause","id":75941842,"node_id":"MDQ6VXNlcjc1OTQxODQy","avatar_url":"https://avatars.githubusercontent.com/u/75941842?v=4","gravatar_id":"","url":"https://api.github.com/users/beicause","html_url":"https://github.com/beicause","followers_url":"https://api.github.com/users/beicause/followers","following_url":"https://api.github.com/users/beicause/following{/other_user}","gists_url":"https://api.github.com/users/beicause/gists{/gist_id}","starred_url":"https://api.github.com/users/beicause/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/beicause/subscriptions","organizations_url":"https://api.github.com/users/beicause/orgs","repos_url":"https://api.github.com/users/beicause/repos","events_url":"https://api.github.com/users/beicause/events{/privacy}","received_events_url":"https://api.github.com/users/beicause/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-04-11T17:56:12Z","updated_at":"2025-04-11T17:56:12Z","body":"Is this really a problem? In GradientTexture, we return the image through `RenderingServer.texture_2d_get`. However, in NoiseTexture, we store the image and then return it. The get_image() function is declared as const, and we can't update the image within it.","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2797655130/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2797838213","html_url":"https://github.com/godotengine/godot/issues/105261#issuecomment-2797838213","issue_url":"https://api.github.com/repos/godotengine/godot/issues/105261","id":2797838213,"node_id":"IC_kwDOAO6SJc6mw5-F","user":{"login":"kleonc","id":9283098,"node_id":"MDQ6VXNlcjkyODMwOTg=","avatar_url":"https://avatars.githubusercontent.com/u/9283098?v=4","gravatar_id":"","url":"https://api.github.com/users/kleonc","html_url":"https://github.com/kleonc","followers_url":"https://api.github.com/users/kleonc/followers","following_url":"https://api.github.com/users/kleonc/following{/other_user}","gists_url":"https://api.github.com/users/kleonc/gists{/gist_id}","starred_url":"https://api.github.com/users/kleonc/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/kleonc/subscriptions","organizations_url":"https://api.github.com/users/kleonc/orgs","repos_url":"https://api.github.com/users/kleonc/repos","events_url":"https://api.github.com/users/kleonc/events{/privacy}","received_events_url":"https://api.github.com/users/kleonc/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-04-11T19:19:46Z","updated_at":"2025-04-11T19:19:46Z","body":"> `NoiseTexture2D` doesn't return an image object from `get_image()` during `_ready()` the first time the Node is created. If you `await texture.changed` before the first call, `get_image()` will return an Image properly. However, this workaround isn't ideal, since if the Node is created again beyond this first time, the `changed` signal won't be called again due to the `NoiseTexture2D` being instantiated already.\n\nThis should do as a workaround:\n```gdscript\nvar noise_texture: NoiseTexture2D = ...\nvar image := noise_texture.get_image()\nif image == null:\n\tawait noise_texture.changed\n\timage = noise_texture.get_image()\n...\n```","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2797838213/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2797844123","html_url":"https://github.com/godotengine/godot/issues/105261#issuecomment-2797844123","issue_url":"https://api.github.com/repos/godotengine/godot/issues/105261","id":2797844123,"node_id":"IC_kwDOAO6SJc6mw7ab","user":{"login":"kleonc","id":9283098,"node_id":"MDQ6VXNlcjkyODMwOTg=","avatar_url":"https://avatars.githubusercontent.com/u/9283098?v=4","gravatar_id":"","url":"https://api.github.com/users/kleonc","html_url":"https://github.com/kleonc","followers_url":"https://api.github.com/users/kleonc/followers","following_url":"https://api.github.com/users/kleonc/following{/other_user}","gists_url":"https://api.github.com/users/kleonc/gists{/gist_id}","starred_url":"https://api.github.com/users/kleonc/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/kleonc/subscriptions","organizations_url":"https://api.github.com/users/kleonc/orgs","repos_url":"https://api.github.com/users/kleonc/repos","events_url":"https://api.github.com/users/kleonc/events{/privacy}","received_events_url":"https://api.github.com/users/kleonc/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-04-11T19:23:14Z","updated_at":"2025-04-11T19:23:14Z","body":"Also note the issue is already documented:\nhttps://github.com/godotengine/godot/blob/215acd52e82f4c575abb715e25e54558deeef998/modules/noise/doc_classes/NoiseTexture2D.xml#L8-L15\n\nHence I'm not sure if we should consider this being a bug in the first place.","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2797844123/reactions","total_count":1,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":1,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2797854839","html_url":"https://github.com/godotengine/godot/issues/105261#issuecomment-2797854839","issue_url":"https://api.github.com/repos/godotengine/godot/issues/105261","id":2797854839,"node_id":"IC_kwDOAO6SJc6mw-B3","user":{"login":"ytianle","id":61530469,"node_id":"MDQ6VXNlcjYxNTMwNDY5","avatar_url":"https://avatars.githubusercontent.com/u/61530469?v=4","gravatar_id":"","url":"https://api.github.com/users/ytianle","html_url":"https://github.com/ytianle","followers_url":"https://api.github.com/users/ytianle/followers","following_url":"https://api.github.com/users/ytianle/following{/other_user}","gists_url":"https://api.github.com/users/ytianle/gists{/gist_id}","starred_url":"https://api.github.com/users/ytianle/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/ytianle/subscriptions","organizations_url":"https://api.github.com/users/ytianle/orgs","repos_url":"https://api.github.com/users/ytianle/repos","events_url":"https://api.github.com/users/ytianle/events{/privacy}","received_events_url":"https://api.github.com/users/ytianle/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-04-11T19:29:15Z","updated_at":"2025-04-11T19:33:03Z","body":"> Also note the issue is already documented:\n> \n> [godot/modules/noise/doc_classes/NoiseTexture2D.xml](https://github.com/godotengine/godot/blob/215acd52e82f4c575abb715e25e54558deeef998/modules/noise/doc_classes/NoiseTexture2D.xml#L8-L15)\n> \n> Lines 8 to 15 in [215acd5](/godotengine/godot/commit/215acd52e82f4c575abb715e25e54558deeef998)\n> \n>  The class uses [Thread]s to generate the texture data internally, so [method Texture2D.get_image] may return [code]null[/code] if the generation process has not completed yet. In that case, you need to wait for the texture to be generated before accessing the image and the generated byte data: \n>  [codeblock] \n>  var texture = NoiseTexture2D.new() \n>  texture.noise = FastNoiseLite.new() \n>  await texture.changed \n>  var image = texture.get_image() \n>  var data = image.get_data() \n>  [/codeblock] \n> Hence I'm not sure if we should consider this being a bug in the first place.\n\nYeah, it was designed as asynchronous. I am going to keep my eyes on this lol. Very interesting as my first project. Thanks for the suggestions.","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2797854839/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2798283045","html_url":"https://github.com/godotengine/godot/issues/105261#issuecomment-2798283045","issue_url":"https://api.github.com/repos/godotengine/godot/issues/105261","id":2798283045,"node_id":"IC_kwDOAO6SJc6mymkl","user":{"login":"kitbear444","id":161773838,"node_id":"U_kgDOCaR5Dg","avatar_url":"https://avatars.githubusercontent.com/u/161773838?v=4","gravatar_id":"","url":"https://api.github.com/users/kitbear444","html_url":"https://github.com/kitbear444","followers_url":"https://api.github.com/users/kitbear444/followers","following_url":"https://api.github.com/users/kitbear444/following{/other_user}","gists_url":"https://api.github.com/users/kitbear444/gists{/gist_id}","starred_url":"https://api.github.com/users/kitbear444/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/kitbear444/subscriptions","organizations_url":"https://api.github.com/users/kitbear444/orgs","repos_url":"https://api.github.com/users/kitbear444/repos","events_url":"https://api.github.com/users/kitbear444/events{/privacy}","received_events_url":"https://api.github.com/users/kitbear444/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-04-12T00:42:33Z","updated_at":"2025-04-12T00:42:33Z","body":"I figured that this might be a case where it was running asynchronously and might have been intended, which makes this not a bug but rather just a consequence of the design decision. In my implementation, I just had incorrect logic to detect when the image was null and needed to await for the changed signal, and I've fixed that now due to your code snippet @kleonc, so thanks for that! And thanks for everyone that took a look at this!","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2798283045/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2798727724","html_url":"https://github.com/godotengine/godot/issues/105261#issuecomment-2798727724","issue_url":"https://api.github.com/repos/godotengine/godot/issues/105261","id":2798727724,"node_id":"IC_kwDOAO6SJc6m0TIs","user":{"login":"beicause","id":75941842,"node_id":"MDQ6VXNlcjc1OTQxODQy","avatar_url":"https://avatars.githubusercontent.com/u/75941842?v=4","gravatar_id":"","url":"https://api.github.com/users/beicause","html_url":"https://github.com/beicause","followers_url":"https://api.github.com/users/beicause/followers","following_url":"https://api.github.com/users/beicause/following{/other_user}","gists_url":"https://api.github.com/users/beicause/gists{/gist_id}","starred_url":"https://api.github.com/users/beicause/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/beicause/subscriptions","organizations_url":"https://api.github.com/users/beicause/orgs","repos_url":"https://api.github.com/users/beicause/repos","events_url":"https://api.github.com/users/beicause/events{/privacy}","received_events_url":"https://api.github.com/users/beicause/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-04-12T08:06:00Z","updated_at":"2025-04-12T08:06:00Z","body":"I don't think this should be closed. We can still adopt the same approach as GradientTexture, by not storing the image field in NoiseTexture and using RenderingServe to update and retrieve image.\n\nCaching the image in NoiseTexture is unnecessary. It can only speed up get_image(), but increases memory usage.","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2798727724/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2798904830","html_url":"https://github.com/godotengine/godot/issues/105261#issuecomment-2798904830","issue_url":"https://api.github.com/repos/godotengine/godot/issues/105261","id":2798904830,"node_id":"IC_kwDOAO6SJc6m0-X-","user":{"login":"ytianle","id":61530469,"node_id":"MDQ6VXNlcjYxNTMwNDY5","avatar_url":"https://avatars.githubusercontent.com/u/61530469?v=4","gravatar_id":"","url":"https://api.github.com/users/ytianle","html_url":"https://github.com/ytianle","followers_url":"https://api.github.com/users/ytianle/followers","following_url":"https://api.github.com/users/ytianle/following{/other_user}","gists_url":"https://api.github.com/users/ytianle/gists{/gist_id}","starred_url":"https://api.github.com/users/ytianle/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/ytianle/subscriptions","organizations_url":"https://api.github.com/users/ytianle/orgs","repos_url":"https://api.github.com/users/ytianle/repos","events_url":"https://api.github.com/users/ytianle/events{/privacy}","received_events_url":"https://api.github.com/users/ytianle/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-04-12T16:53:32Z","updated_at":"2025-04-12T16:53:32Z","body":"This will be an epic for NoiseTexture. I would wait for the team to provide the best solution.\ncc @kleonc @AThousandShips ","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2798904830/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null}]