":[],"type":null,"active_lock_reason":null,"draft":false,"pull_request":{"url":"https://api.github.com/repos/godotengine/godot/pulls/117903","html_url":"https://github.com/godotengine/godot/pull/117903","diff_url":"https://github.com/godotengine/godot/pull/117903.diff","patch_url":"https://github.com/godotengine/godot/pull/117903.patch","merged_at":null},"body":"After renaming a node in the AnimationNodeBlendTree, the node could unexpectedly change its position and continue moving until the user interacted with the graph (clicking on the screen).\r\n\r\nThis happens because the GraphNode state becomes desynchronized from the underlying BlendTree data after a rename operation, causing stale position updates to be applied.\r\n\r\nFix this by preventing the node from updating while in this state, avoiding unintended position changes and ensuring stable behavior after renaming.","closed_by":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/117903/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/godotengine/godot/issues/117903/timeline","performed_via_github_app":null,"state_reason":null}