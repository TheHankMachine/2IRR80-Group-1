hived_at":null,"archived_by":null}],"state":"closed","locked":false,"assignees":[],"milestone":{"url":"https://api.github.com/repos/godotengine/godot/milestones/22","html_url":"https://github.com/godotengine/godot/milestone/22","labels_url":"https://api.github.com/repos/godotengine/godot/milestones/22/labels","id":12070367,"node_id":"MI_kwDOAO6SJc4AuC3f","number":22,"title":"4.5","description":"","creator":{"login":"Sauermann","id":6299227,"node_id":"MDQ6VXNlcjYyOTkyMjc=","avatar_url":"https://avatars.githubusercontent.com/u/6299227?v=4","gravatar_id":"","url":"https://api.github.com/users/Sauermann","html_url":"https://github.com/Sauermann","followers_url":"https://api.github.com/users/Sauermann/followers","following_url":"https://api.github.com/users/Sauermann/following{/other_user}","gists_url":"https://api.github.com/users/Sauermann/gists{/gist_id}","starred_url":"https://api.github.com/users/Sauermann/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Sauermann/subscriptions","organizations_url":"https://api.github.com/users/Sauermann/orgs","repos_url":"https://api.github.com/users/Sauermann/repos","events_url":"https://api.github.com/users/Sauermann/events{/privacy}","received_events_url":"https://api.github.com/users/Sauermann/received_events","type":"User","user_view_type":"public","site_admin":false},"open_issues":3,"closed_issues":3687,"state":"closed","created_at":"2024-12-19T08:51:28Z","updated_at":"2026-09-04T21:48:38Z","due_on":"2025-09-15T00:00:00Z","closed_at":"2025-09-18T17:13:14Z"},"comments":4,"created_at":"2025-01-08T18:43:32Z","updated_at":"2025-03-09T14:16:00Z","closed_at":"2025-03-09T14:11:35Z","assignee":null,"author_association":"MEMBER","issue_field_values":[],"type":null,"active_lock_reason":null,"draft":false,"pull_request":{"url":"https://api.github.com/repos/godotengine/godot/pulls/101304","html_url":"https://github.com/godotengine/godot/pull/101304","diff_url":"https://github.com/godotengine/godot/pull/101304.diff","patch_url":"https://github.com/godotengine/godot/pull/101304.patch","merged_at":"2025-03-09T14:11:35Z"},"body":"The function will log errors if any characters above value 127 are found. This is most similar to `parse_latin1`, but `parse_latin1` will silently and incorrectly parse values above 127 as 'extended latin set' characters, when `ASCII` only is expected. This would be especially incorrect if the input is `utf8`, because the string will silently have incorrect length and misinterpreted characters.\r\n\r\nAs discussed in https://github.com/godotengine/godot/pull/101293#discussion_r1907518247, two functions in `plist` are known to expect `ASCII`-only strings, so they are used as an excuse to call the new function. It would be correct to call `parse_ascii` on many other occasions (see https://github.com/godotengine/godot/issues/100641), but I do not have the broad knowledge to search out all these instances. Instead, the function is added here such that future contributions can call it to safely parse `ASCII` when it is expected.\r\n\r\nRequires and includes #101293 (because of implicit conversions).","closed_by":{"login":"Repiteo","id":17489292,"node_id":"MDQ6VXNlcjE3NDg5Mjky","avatar_url":"https://avatars.githubusercontent.com/u/17489292?v=4","gravatar_id":"","url":"https://api.github.com/users/Repiteo","html_url":"https://github.com/Repiteo","followers_url":"https://api.github.com/users/Repiteo/followers","following_url":"https://api.github.com/users/Repiteo/following{/other_user}","gists_url":"https://api.github.com/users/Repiteo/gists{/gist_id}","starred_url":"https://api.github.com/users/Repiteo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Repiteo/subscriptions","organizations_url":"https://api.github.com/users/Repiteo/orgs","repos_url":"https://api.github.com/users/Repiteo/repos","events_url":"https://api.github.com/users/Repiteo/events{/privacy}","received_events_url":"https://api.github.com/users/Repiteo/received_events"