_url":"https://api.github.com/users/kitbdev/following{/other_user}","gists_url":"https://api.github.com/users/kitbdev/gists{/gist_id}","starred_url":"https://api.github.com/users/kitbdev/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/kitbdev/subscriptions","organizations_url":"https://api.github.com/users/kitbdev/orgs","repos_url":"https://api.github.com/users/kitbdev/repos","events_url":"https://api.github.com/users/kitbdev/events{/privacy}","received_events_url":"https://api.github.com/users/kitbdev/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-03-23T19:46:07Z","updated_at":"2026-03-23T19:46:07Z","body":"- See https://github.com/godotengine/godot/pull/115980","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4113264316/reactions","total_count":3,"+1":0,"-1":0,"laugh":1,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":2},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4113415715","html_url":"https://github.com/godotengine/godot/pull/117757#issuecomment-4113415715","issue_url":"https://api.github.com/repos/godotengine/godot/issues/117757","id":4113415715,"node_id":"IC_kwDOAO6SJc71Lb4j","user":{"login":"WhalesState","id":53877170,"node_id":"MDQ6VXNlcjUzODc3MTcw","avatar_url":"https://avatars.githubusercontent.com/u/53877170?v=4","gravatar_id":"","url":"https://api.github.com/users/WhalesState","html_url":"https://github.com/WhalesState","followers_url":"https://api.github.com/users/WhalesState/followers","following_url":"https://api.github.com/users/WhalesState/following{/other_user}","gists_url":"https://api.github.com/users/WhalesState/gists{/gist_id}","starred_url":"https://api.github.com/users/WhalesState/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/WhalesState/subscriptions","organizations_url":"https://api.github.com/users/WhalesState/orgs","repos_url":"https://api.github.com/users/WhalesState/repos","events_url":"https://api.github.com/users/WhalesState/events{/privacy}","received_events_url":"https://api.github.com/users/WhalesState/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-03-23T20:14:28Z","updated_at":"2026-03-23T20:14:29Z","body":"> * See [Fix WindowWrapper leaking all key inputs to parent #115980](https://github.com/godotengine/godot/pull/115980)\r\n\r\nI kept trying fixing it and I was like: Why is the editor receiving input when unfocused??? This must be wrong. Then, i have found this 😭\r\n\r\n```C++\r\n\t\t\t// HACK: Propagate the window input to the editor main window to handle global shortcuts.\r\n\t\t\tgrandparent_window->push_input(p_event);\r\n```\r\n\r\nClosing this now, it should be fixed by #115980.","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4113415715/reactions","total_count":3,"+1":3,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null}]