ived_by":null},{"id":3240950060,"node_id":"MDU6TGFiZWwzMjQwOTUwMDYw","url":"https://api.github.com/repos/godotengine/godot/labels/performance","name":"performance","color":"447777","default":false,"description":"","archived_at":null,"archived_by":null}],"state":"open","locked":false,"assignees":[],"milestone":{"url":"https://api.github.com/repos/godotengine/godot/milestones/16","html_url":"https://github.com/godotengine/godot/milestone/16","labels_url":"https://api.github.com/repos/godotengine/godot/milestones/16/labels","id":8237783,"node_id":"MI_kwDOAO6SJc4AfbLX","number":16,"title":"4.x","description":"Issues and pull requests slated for an undetermined Godot 4 release.","creator":{"login":"akien-mga","id":4701338,"node_id":"MDQ6VXNlcjQ3MDEzMzg=","avatar_url":"https://avatars.githubusercontent.com/u/4701338?v=4","gravatar_id":"","url":"https://api.github.com/users/akien-mga","html_url":"https://github.com/akien-mga","followers_url":"https://api.github.com/users/akien-mga/followers","following_url":"https://api.github.com/users/akien-mga/following{/other_user}","gists_url":"https://api.github.com/users/akien-mga/gists{/gist_id}","starred_url":"https://api.github.com/users/akien-mga/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/akien-mga/subscriptions","organizations_url":"https://api.github.com/users/akien-mga/orgs","repos_url":"https://api.github.com/users/akien-mga/repos","events_url":"https://api.github.com/users/akien-mga/events{/privacy}","received_events_url":"https://api.github.com/users/akien-mga/received_events","type":"User","user_view_type":"public","site_admin":false},"open_issues":5791,"closed_issues":0,"state":"open","created_at":"2022-07-26T12:42:05Z","updated_at":"2026-10-21T22:40:26Z","due_on":null,"closed_at":null},"comments":5,"created_at":"2026-03-12T12:35:57Z","updated_at":"2026-03-12T13:18:16Z","closed_at":null,"assignee":null,"author_association":"CONTRIBUTOR","issue_field_values":[],"type":null,"active_lock_reason":null,"draft":false,"pull_request":{"url":"https://api.github.com/repos/godotengine/godot/pulls/117370","html_url":"https://github.com/godotengine/godot/pull/117370","diff_url":"https://github.com/godotengine/godot/pull/117370.diff","patch_url":"https://github.com/godotengine/godot/pull/117370.patch","merged_at":null},"body":"## Description\r\n\r\nThis PR optimizes the performance and memory footprint of `get_with_code_lines`. \r\nThe previous implementation relied on `String::split()` and `vformat()` within a loop, which caused excessive heap allocations, temporary array generation, and repeated string concatenations.\r\nThese overheads scaled poorly when processing large source files. \r\n\r\nIt also caused some debugging issues for us tracking down a memory issue due to number of allocations on a specific platform.\r\nIn public branch currently only used by `ShaderRD::_compile_variant`. We use it in a few other places.\r\nEasily could be expanded to take optional error or highlight line var if you want the format\r\n```\r\n     4 |  code\r\nE    5 >  code\r\n     6 |  code\r\n```\r\n\r\n## Refactor details\r\n\r\n- Pre-calculation: Scans the source string once to count newlines and pre-calculate exact memory requirements.\r\n- Single Allocation: Replaces multiple allocations with a single resize_uninitialized() call for the destination buffer.\r\n- Zero-allocation Formatting: Replaces vformat() with a stack-allocated buffer and snprintf for integer formatting.\r\n- Data Transfer: Uses memcpy() to transfer string segments directly into the buffer, improving cache friendliness.\r\n- Scalability: Dynamically adjusts line number padding to support files exceeding 9,999 lines.","closed_by":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/117370/reactions","total_count":5,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":4,"eyes":1},"timeline_url":"https://api.github.com/repos/godotengine/godot/issues/117370/timeline","performed_via_github_app":null,"state_reason":null}