otengine/godot/issues/comments/3920268040/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3920471205","html_url":"https://github.com/godotengine/godot/pull/114316#issuecomment-3920471205","issue_url":"https://api.github.com/repos/godotengine/godot/issues/114316","id":3920471205,"node_id":"IC_kwDOAO6SJc7praSl","user":{"login":"bruvzg","id":7645683,"node_id":"MDQ6VXNlcjc2NDU2ODM=","avatar_url":"https://avatars.githubusercontent.com/u/7645683?v=4","gravatar_id":"","url":"https://api.github.com/users/bruvzg","html_url":"https://github.com/bruvzg","followers_url":"https://api.github.com/users/bruvzg/followers","following_url":"https://api.github.com/users/bruvzg/following{/other_user}","gists_url":"https://api.github.com/users/bruvzg/gists{/gist_id}","starred_url":"https://api.github.com/users/bruvzg/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/bruvzg/subscriptions","organizations_url":"https://api.github.com/users/bruvzg/orgs","repos_url":"https://api.github.com/users/bruvzg/repos","events_url":"https://api.github.com/users/bruvzg/events{/privacy}","received_events_url":"https://api.github.com/users/bruvzg/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-02-18T12:10:05Z","updated_at":"2026-02-18T12:10:05Z","body":"It seems it only supports `SDL_SENSOR_GYRO` but not `SDL_SENSOR_ACCEL`, this corresponds to the system API data, which also return false for https://developer.apple.com/documentation/gamecontroller/gcmotion/hasgravityanduseracceleration?language=objc. So it's not a SDL bug, but either iOS limitation, or issue with specific controller (maybe incompatible firmware).","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3920471205/reactions","total_count":1,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":1},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3920881995","html_url":"https://github.com/godotengine/godot/pull/114316#issuecomment-3920881995","issue_url":"https://api.github.com/repos/godotengine/godot/issues/114316","id":3920881995,"node_id":"IC_kwDOAO6SJc7ps-lL","user":{"login":"Nintorch","id":92302738,"node_id":"U_kgDOBYBtkg","avatar_url":"https://avatars.githubusercontent.com/u/92302738?v=4","gravatar_id":"","url":"https://api.github.com/users/Nintorch","html_url":"https://github.com/Nintorch","followers_url":"https://api.github.com/users/Nintorch/followers","following_url":"https://api.github.com/users/Nintorch/following{/other_user}","gists_url":"https://api.github.com/users/Nintorch/gists{/gist_id}","starred_url":"https://api.github.com/users/Nintorch/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Nintorch/subscriptions","organizations_url":"https://api.github.com/users/Nintorch/orgs","repos_url":"https://api.github.com/users/Nintorch/repos","events_url":"https://api.github.com/users/Nintorch/events{/privacy}","received_events_url":"https://api.github.com/users/Nintorch/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-02-18T13:38:04Z","updated_at":"2026-02-18T13:38:04Z","body":"I'm not entirely sure SDL (and this PR) supports controllers for visionOS, so I think it's probably a good idea to mark it as only for iOS for now.\nBut if later it turns out it does, I think we can update the documentation/this PR accordingly. If not, we can create a Godot proposal to support controllers on visionOS.","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3920881995/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_