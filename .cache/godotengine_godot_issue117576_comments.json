1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4315756708","html_url":"https://github.com/godotengine/godot/pull/117576#issuecomment-4315756708","issue_url":"https://api.github.com/repos/godotengine/godot/issues/117576","id":4315756708,"node_id":"IC_kwDOAO6SJc8AAAABAT04pA","user":{"login":"wwrzal","id":3277121,"node_id":"MDQ6VXNlcjMyNzcxMjE=","avatar_url":"https://avatars.githubusercontent.com/u/3277121?v=4","gravatar_id":"","url":"https://api.github.com/users/wwrzal","html_url":"https://github.com/wwrzal","followers_url":"https://api.github.com/users/wwrzal/followers","following_url":"https://api.github.com/users/wwrzal/following{/other_user}","gists_url":"https://api.github.com/users/wwrzal/gists{/gist_id}","starred_url":"https://api.github.com/users/wwrzal/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/wwrzal/subscriptions","organizations_url":"https://api.github.com/users/wwrzal/orgs","repos_url":"https://api.github.com/users/wwrzal/repos","events_url":"https://api.github.com/users/wwrzal/events{/privacy}","received_events_url":"https://api.github.com/users/wwrzal/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-04-24T19:32:42Z","updated_at":"2026-04-24T19:32:42Z","body":"@lyuma @TokageItLab \r\nI have updated to more features, check PR description for how it is now.\r\nI'm not sure about:\r\n- property names - in theory what I show right now in Properties > Animation Frame is number of last frame, not sure on the naming here\r\n- if there are any boundary conditions in calculations that could be off, seems that playing manually with slider and spin box they stay in sync, but maybe I'm missing sth.","author_association":"NONE","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4315756708/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4526078227","html_url":"https://github.com/godotengine/godot/pull/117576#issuecomment-4526078227","issue_url":"https://api.github.com/repos/godotengine/godot/issues/117576","id":4526078227,"node_id":"IC_kwDOAO6SJc8AAAABDcZ5Ew","user":{"login":"wwrzal","id":3277121,"node_id":"MDQ6VXNlcjMyNzcxMjE=","avatar_url":"https://avatars.githubusercontent.com/u/3277121?v=4","gravatar_id":"","url":"https://api.github.com/users/wwrzal","html_url":"https://github.com/wwrzal","followers_url":"https://api.github.com/users/wwrzal/followers","following_url":"https://api.github.com/users/wwrzal/following{/other_user}","gists_url":"https://api.github.com/users/wwrzal/gists{/gist_id}","starred_url":"https://api.github.com/users/wwrzal/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/wwrzal/subscriptions","organizations_url":"https://api.github.com/users/wwrzal/orgs","repos_url":"https://api.github.com/users/wwrzal/repos","events_url":"https://api.github.com/users/wwrzal/events{/privacy}","received_events_url":"https://api.github.com/users/wwrzal/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-05-23T17:29:54Z","updated_at":"2026-05-23T17:29:54Z","body":"Is there any way I can help get this PR going forward?","author_association":"NONE","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4526078227/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5242149530","html_url":"https://github.com/godotengine/godot/pull/117576#issuecomment-5242149530","issue_url":"https://api.github.com/repos/godotengine/godot/issues/117576","id":5242149530,"node_id":"IC_kwDOAO6SJc8AAAABOHTamg","user":{"login":"wwrzal","id":3277121,"node_id":"MDQ6VXNlcjMyNzcxMjE=","avatar_url":"https://avatars.githubusercontent.com/u/3277121?v=4","gravatar_id":"","url":"https://api.github.com/users/wwrzal","html_url":"https://github.com/wwrzal","followers_url":"https://api.github.com/users/wwrzal/followers","following_url":"https://api.github.com/users/wwrzal/following{/other_user}","gists_url":"https://api.github.com/users/wwrzal/gists{/gist_id}","starred_url":"https://api.github.com/users/wwrzal/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/wwrzal/subscriptions","organizations_url":"https://api.github.com/users/wwrzal/orgs","repos_url":"https://api.github.com/users/wwrzal/repos","events_url":"https://api.github.com/users/wwrzal/events{/privacy}","received_events_url":"https://api.github.com/users/wwrzal/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-08-10T15:09:46Z","updated_at":"2026-08-10T15:09:46Z","body":"> Approved in meeting.\r\n> \r\n> The only bug I ran into is that the step on the animation_slider is hardcoded to 1/100.0 on line 1848:\r\n> \r\n> ```\r\n> \tanimation_slider->set_step(1.0 / 100.0);\r\n> ```\r\n> \r\n> This needs to be corrected to use `set_step(1.0 / animation_fps)` and updated in all the places that `animation_fps` changes.\r\n> \r\n> To reproduce the bug, set animation fps to 120 in import settings, and scroll through the spinbox up and down, and you will see it skips lots of frames sometimes, due to bouncing back and forth from spinbox to slider (with the wrong step)\r\n\r\nI think it might be desirable for slider to be able to move between frames for smooth animation when dragging. Now when I import with low FPS like 10, I can still smoothly drag the slider and see smooth animation. \r\nI tested dummy change. Limiting number of steps to 10 results in choppy animation when dragging.\r\n\r\nPersonally I think \"jumping over\" some frames on the spinner when dragging the slider if better of the two options.\r\n","author_association":"NONE","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5242149530/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5242727990","html_url":"https://github.com/godotengine/godot/pull/117576#issuecomment-5242727990","issue_url":"https://api.github.com/repos/godotengine/godot/issues/117576","id":5242727990,"node_id":"IC_kwDOAO6SJc8AAAABOH2uNg","user":{"login":"lyuma","id":39946030,"node_id":"MDQ6VXNlcjM5OTQ2MDMw","avatar_url":"https://avatars.githubusercontent.com/u/39946030?v=4","gravatar_id":"","url":"https://api.github.com/users/lyuma","html_url":"https://github.com/lyuma","followers_url":"https://api.github.com/users/lyuma/followers","following_url":"https://api.github.com/users/lyuma/following{/other_user}","gists_url":"https://api.github.com/users/lyuma/gists{/gist_id}","starred_url":"https://api.github.com/users/lyuma/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/lyuma/subscriptions","organizations_url":"https://api.github.com/users/lyuma/orgs","repos_url":"https://api.github.com/users/lyuma/repos","events_url":"https://api.github.com/users/lyuma/events{/privacy}","received_events_url":"https://api.github.com/users/lyuma/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-08-10T16:00:33Z","updated_at":"2026-08-10T16:00:43Z","body":"> when dragging the slider\r\n\r\nMy review feedback was not about dragging the slider. Your comment dismisses the main issues I had when testing this change. Please reread what I wrote or follow my test procedure.\r\n\r\nAlso, can you clarify if you originally authored the actual code? When you say an LLM agent was used, which parts of the code were copied and pasted from the agent, versus which lines were edited by the AI agent itself? Knowing which may be helpful","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5242727990/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5250070608","html_url":"https://github.com/godotengine/godot/pull/117576#issuecomment-5250070608","issue_url":"https://api.github.com/repos/godotengine/godot/issues/117576","id":5250070608,"node_id":"IC_kwDOAO6SJc8AAAABOO24UA","user":{"login":"wwrzal","id":3277121,"node_id":"MDQ6VXNlcjMyNzcxMjE=","avatar_url":"https://avatars.githubusercontent.com/u/3277121?v=4","gravatar_id":"","url":"https://api.github.com/users/wwrzal","html_url":"https://github.com/wwrzal","followers_url":"https://api.github.com/users/wwrzal/followers","following_url":"https://api.github.com/users/wwrzal/following{/other_user}","gists_url":"https://api.github.com/users/wwrzal/gists{/gist_id}","starred_url":"https://api.github.com/users/wwrzal/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/wwrzal/subscriptions","organizations_url":"https://api.github.com/users/wwrzal/orgs","repos_url":"https://api.github.com/users/wwrzal/repos","events_url":"https://api.github.com/users/wwrzal/events{/privacy}","received_events_url":"https://api.github.com/users/wwrzal/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-08-11T07:04:31Z","updated_at":"2026-08-11T07:04:31Z","body":"> > when dragging the slider\r\n> \r\n> My review feedback was not about dragging the slider. Your comment dismisses the main issues I had when testing this change. Please reread what I wrote or follow my test procedure.\r\n> \r\n> Also, can you clarify if you originally authored the actual code? When you say an LLM agent was used, which parts of the code were copied and pasted from the agent, versus which lines were edited by the AI agent itself? Knowing which may be helpful\r\n\r\nYes, the issue is there. My statement is still valid though - if we go to code like:\r\n`animation_slider->set_step(1.0 / animation_fps)`\r\nthen dragging slider will result in choppy animations. \r\n\r\nNot yet sure what the right solution is. \r\nMaybe step size needs to be min(1.0/100, 1.0/animation_fps)?\r\nOr maybe the logic of the changing the value in the spin box should always jump up/down one frame and the recalculate closest position on the slider?\r\n\r\nAs for AI - it was used mainly for getting the understanding of the code base, finding correct places where all the data is available. And then just for autocomplete when I knew what I wanted to code.\r\n\r\n\r\n","author_association":"NONE","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5250070608/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5250219435","html_url":"https://github.com/godotengine/godot/pull/117576#issuecomment-5250219435","issue_url":"https://api.github.com/repos/godotengine/godot/issues/117576","id":5250219435,"node_id":"IC_kwDOAO6SJc8AAAABOO_9qw","user":{"login":"wwrzal","id":3277121,"node_id":"MDQ6VXNlcjMyNzcxMjE=","avatar_url":"https://avatars.githubusercontent.com/u/3277121?v=4","gravatar_id":"","url":"https://api.github.com/users/wwrzal","html_url":"https://github.com/wwrzal","followers_url":"https://api.github.com/users/wwrzal/followers","following_url":"https://api.github.com/users/wwrzal/following{/other_user}","gists_url":"https://api.github.com/users/wwrzal/gists{/gist_id}","starred_url":"https://api.github.com/users/wwrzal/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/wwrzal/subscriptions","organizations_url":"https://api.github.com/users/wwrzal/orgs","repos_url":"https://api.github.com/users/wwrzal/repos","events_url":"https://api.github.com/users/wwrzal/events{/privacy}","received_events_url":"https://api.github.com/users/wwrzal/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-08-11T07:22:03Z","updated_at":"2026-08-11T07:22:03Z","body":"I have added on branch solution with no round trip from set spinner value -> slider value -> spinner value. Seems like easiest solution without any obvious glaring issues.\r\nPlease let me know if you think there is a better solution.","author_association":"NONE","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5250219435/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null}]