[{"id":2882155887,"node_id":"PRR_kwDOAO6SJc6ryjVv","user":{"login":"Mickeon","id":66727710,"node_id":"MDQ6VXNlcjY2NzI3NzEw","avatar_url":"https://avatars.githubusercontent.com/u/66727710?u=8069d9b7bc6ab503ce83dfcfa53fd021672aeccf&v=4","gravatar_id":"","url":"https://api.github.com/users/Mickeon","html_url":"https://github.com/Mickeon","followers_url":"https://api.github.com/users/Mickeon/followers","following_url":"https://api.github.com/users/Mickeon/following{/other_user}","gists_url":"https://api.github.com/users/Mickeon/gists{/gist_id}","starred_url":"https://api.github.com/users/Mickeon/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Mickeon/subscriptions","organizations_url":"https://api.github.com/users/Mickeon/orgs","repos_url":"https://api.github.com/users/Mickeon/repos","events_url":"https://api.github.com/users/Mickeon/events{/privacy}","received_events_url":"https://api.github.com/users/Mickeon/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"Documentation on tooltips were a concern of mine, at first. In actuality, you _can_ click on the type. So not even that is a problem.\r\n![image](https://github.com/user-attachments/assets/3f87a0bd-78b9-437b-99c9-52a6507e06c4)\r\nThat's assuming tooltips work as they should, _and they're often reported not to_, But that's no reason to stop this PR.\r\n\r\nWe could have it so that if you click on a `param` tag it sends you to the parameter's type, or at least hints about it.\r\nCurrently `param` is mostly aesthetic, and *you* personally even discourage it due to localization, but it is very useful to bring attention to the function's signature. Hmm...\r\n\r\nThis PR also highlights how utterly void of information some of these descriptions are. Sometimes it's justified, other times... not so much.\r\nPart of the reason started my own localization work is to see how shoddy some of these are.\r\nI don't think it's this PR's purpose to flesh these descriptions out, especially since requires more knowledge on the subjects, but it's worth noting. We can fix a few typos in and there, too.\r\n\r\n","state":"COMMENTED","html_url":"https://github.com/godotengine/godot/pull/106159#pullrequestreview-2882155887","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/106159","author_association":"MEMBER","_links":{"html":{"href":"https://github.com/godotengine/godot/pull/106159#pullrequestreview-2882155887"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/106159"}},"submitted_at":"2025-05-30T23:36:35Z","commit_id":null},{"id":2883143665,"node_id":"PRR_kwDOAO6SJc6r2Ufx","user":{"login":"timothyqiu","id":372476,"node_id":"MDQ6VXNlcjM3MjQ3Ng==","avatar_url":"https://avatars.githubusercontent.com/u/372476?v=4","gravatar_id":"","url":"https://api.github.com/users/timothyqiu","html_url":"https://github.com/timothyqiu","followers_url":"https://api.github.com/users/timothyqiu/followers","following_url":"https://api.github.com/users/timothyqiu/following{/other_user}","gists_url":"https://api.github.com/users/timothyqiu/gists{/gist_id}","starred_url":"https://api.github.com/users/timothyqiu/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/timothyqiu/subscriptions","organizations_url":"https://api.github.com/users/timothyqiu/orgs","repos_url":"https://api.github.com/users/timothyqiu/repos","events_url":"https://api.github.com/users/timothyqiu/events{/privacy}","received_events_url":"https://api.github.com/users/timothyqiu/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"","state":"COMMENTED","html_url":"https://github.com/godotengine/godot/pull/106159#pullrequestreview-2883143665","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/106159","author_association":"MEMBER","_links":{"html":{"href":"https://github.com/godotengine/godot/pull/106159#pullrequestreview-2883143665"},"pull_request":{"href":"https://api.githu