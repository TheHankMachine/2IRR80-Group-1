[{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/1925716916","pull_request_review_id":2567870661,"id":1925716916,"node_id":"PRRC_kwDOAO6SJc5yyBu0","diff_hunk":"@@ -1509,8 +1509,19 @@ void TextureStorage::_texture_set_data(RID p_texture, const Ref<Image> &p_image,\n \tGLenum internal_format;\n \tbool compressed = false;\n \n+\tbool needs_decompress = texture->resize_to_po2;\n+\n+#ifdef WEB_ENABLED","path":"drivers/gles3/storage/texture_storage.cpp","commit_id":"2221f6ed13d9426db2e146c10c904616771bfb26","original_commit_id":"3280813f9b636d99285375d3a24272ba1baaebbd","user":{"login":"clayjohn","id":16521339,"node_id":"MDQ6VXNlcjE2NTIxMzM5","avatar_url":"https://avatars.githubusercontent.com/u/16521339?v=4","gravatar_id":"","url":"https://api.github.com/users/clayjohn","html_url":"https://github.com/clayjohn","followers_url":"https://api.github.com/users/clayjohn/followers","following_url":"https://api.github.com/users/clayjohn/following{/other_user}","gists_url":"https://api.github.com/users/clayjohn/gists{/gist_id}","starred_url":"https://api.github.com/users/clayjohn/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/clayjohn/subscriptions","organizations_url":"https://api.github.com/users/clayjohn/orgs","repos_url":"https://api.github.com/users/clayjohn/repos","events_url":"https://api.github.com/users/clayjohn/events{/privacy}","received_events_url":"https://api.github.com/users/clayjohn/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"After looking into it, this seems to be true for all GLES3 contexts since they rely on [`EXT_texture_compression_rgtc `](https://registry.khronos.org/OpenGL/extensions/EXT/EXT_texture_compression_rgtc.txt) which explicitly does not support 3D textures. \r\n\r\nTherefore, I think this needs to use `is_gles_over_gl()` instead to capture any time we use a GLES3 context (i.e. web, mobile, and ANGLE on desktop). \r\n\r\nI am not 100% sure about ANGLE on desktop though, it might work anyway despite not being guaranteed by the spec","created_at":"2025-01-22T17:36:55Z","updated_at":"2025-01-22T17:36:55Z","html_url":"https://github.com/godotengine/godot/pull/101909#discussion_r1925716916","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/101909","_links":{"self":{"href":"https://api.github.com/repos/godotengine/godot/pulls/comments/1925716916"},"html":{"href":"https://github.com/godotengine/godot/pull/101909#discussion_r1925716916"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/101909"}},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/1925716916/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":null,"original_line":1514,"side":"RIGHT","author_association":"MEMBER","original_position":6,"position":1,"subject_type":"line"}]