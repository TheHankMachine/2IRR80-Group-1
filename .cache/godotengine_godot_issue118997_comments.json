[{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4327740301","html_url":"https://github.com/godotengine/godot/pull/118997#issuecomment-4327740301","issue_url":"https://api.github.com/repos/godotengine/godot/issues/118997","id":4327740301,"node_id":"IC_kwDOAO6SJc8AAAABAfQTjQ","user":{"login":"nikolay-egorov","id":28873057,"node_id":"MDQ6VXNlcjI4ODczMDU3","avatar_url":"https://avatars.githubusercontent.com/u/28873057?v=4","gravatar_id":"","url":"https://api.github.com/users/nikolay-egorov","html_url":"https://github.com/nikolay-egorov","followers_url":"https://api.github.com/users/nikolay-egorov/followers","following_url":"https://api.github.com/users/nikolay-egorov/following{/other_user}","gists_url":"https://api.github.com/users/nikolay-egorov/gists{/gist_id}","starred_url":"https://api.github.com/users/nikolay-egorov/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/nikolay-egorov/subscriptions","organizations_url":"https://api.github.com/users/nikolay-egorov/orgs","repos_url":"https://api.github.com/users/nikolay-egorov/repos","events_url":"https://api.github.com/users/nikolay-egorov/events{/privacy}","received_events_url":"https://api.github.com/users/nikolay-egorov/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-04-27T14:21:51Z","updated_at":"2026-04-27T14:21:51Z","body":"@AThousandShips, is there a preferred way in this repo to stack changes -- add fixes and then after green light do a cleanup forcepush, or could it be forcepushed after review iteration? ","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4327740301/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4327746839","html_url":"https://github.com/godotengine/godot/pull/118997#issuecomment-4327746839","issue_url":"https://api.github.com/repos/godotengine/godot/issues/118997","id":4327746839,"node_id":"IC_kwDOAO6SJc8AAAABAfQtFw","user":{"login":"AThousandShips","id":96648715,"node_id":"U_kgDOBcK-Cw","avatar_url":"https://avatars.githubusercontent.com/u/96648715?v=4","gravatar_id":"","url":"https://api.github.com/users/AThousandShips","html_url":"https://github.com/AThousandShips","followers_url":"https://api.github.com/users/AThousandShips/followers","following_url":"https://api.github.com/users/AThousandShips/following{/other_user}","gists_url":"https://api.github.com/users/AThousandShips/gists{/gist_id}","starred_url":"https://api.github.com/users/AThousandShips/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/AThousandShips/subscriptions","organizations_url":"https://api.github.com/users/AThousandShips/orgs","repos_url":"https://api.github.com/users/AThousandShips/repos","events_url":"https://api.github.com/users/AThousandShips/events{/privacy}","received_events_url":"https://api.github.com/users/AThousandShips/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-04-27T14:22:46Z","updated_at":"2026-04-27T14:22:46Z","body":"You don't need to squash your commits until the PR is ready to merge ","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4327746839/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4332549637","html_url":"https://github.com/godotengine/godot/pull/118997#issuecomment-4332549637","issue_url":"https://api.github.com/repos/godotengine/godot/issues/118997","id":4332549637,"node_id":"IC_kwDOAO6SJc8AAAABAj12BQ","user":{"login":"nikolay-egorov","id":28873057,"node_id":"MDQ6VXNlcjI4ODczMDU3","avatar_url":"https://avatars.githubusercontent.com/u/28873057?v=4","gravatar_id":"","url":"https://api.github.com/users/nikolay-egorov","html_url":"https://github.com/nikolay-egorov","followers_url":"https://api.github.com/users/nikolay-egorov/followers","following_url":"https://api.github.com/users/nikolay-egorov/following{/other_user}","gists_url":"https://api.github.com/users/nikolay-egorov/gists{/gist_id}","starred_url":"https://api.github.com/users/nikolay-egorov/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/nikolay-egorov/subscriptions","organizations_url":"https://api.github.com/users/nikolay-egorov/orgs","repos_url":"https://api.github.com/users/nikolay-egorov/repos","events_url":"https://api.github.com/users/nikolay-egorov/events{/privacy}","received_events_url":"https://api.github.com/users/nikolay-egorov/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-04-28T05:21:59Z","updated_at":"2026-04-28T05:21:59Z","body":"It seems I finally learned how to run checks locally xD\r\n\r\nShould I wait for formal approval before squashing? ","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4332549637/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4336576260","html_url":"https://github.com/godotengine/godot/pull/118997#issuecomment-4336576260","issue_url":"https://api.github.com/repos/godotengine/godot/issues/118997","id":4336576260,"node_id":"IC_kwDOAO6SJc8AAAABAnrnBA","user":{"login":"fire","id":32321,"node_id":"MDQ6VXNlcjMyMzIx","avatar_url":"https://avatars.githubusercontent.com/u/32321?v=4","gravatar_id":"","url":"https://api.github.com/users/fire","html_url":"https://github.com/fire","followers_url":"https://api.github.com/users/fire/followers","following_url":"https://api.github.com/users/fire/following{/other_user}","gists_url":"https://api.github.com/users/fire/gists{/gist_id}","starred_url":"https://api.github.com/users/fire/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/fire/subscriptions","organizations_url":"https://api.github.com/users/fire/orgs","repos_url":"https://api.github.com/users/fire/repos","events_url":"https://api.github.com/users/fire/events{/privacy}","received_events_url":"https://api.github.com/users/fire/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-04-28T15:09:38Z","updated_at":"2026-04-28T15:10:22Z","body":"Godot tends to use Basis (3x3 matrix) for storage of rotations and Quaternion rotations at runtime. I am not that familar with the physics system to decide which one to use here.\r\n\r\nThere's two singularities with Quaternion which may cause issues with robotics / physics sims.","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4336576260/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4337438325","html_url":"https://github.com/godotengine/godot/pull/118997#issuecomment-4337438325","issue_url":"https://api.github.com/repos/godotengine/godot/issues/118997","id":4337438325,"node_id":"IC_kwDOAO6SJc8AAAABAogOdQ","user":{"login":"nikolay-egorov","id":28873057,"node_id":"MDQ6VXNlcjI4ODczMDU3","avatar_url":"https://avatars.githubusercontent.com/u/28873057?v=4","gravatar_id":"","url":"https://api.github.com/users/nikolay-egorov","html_url":"https://github.com/nikolay-egorov","followers_url":"https://api.github.com/users/nikolay-egorov/followers","following_url":"https://api.github.com/users/nikolay-egorov/following{/other_user}","gists_url":"https://api.github.com/users/nikolay-egorov/gists{/gist_id}","starred_url":"https://api.github.com/users/nikolay-egorov/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/nikolay-egorov/subscriptions","organizations_url":"https://api.github.com/users/nikolay-egorov/orgs","repos_url":"https://api.github.com/users/nikolay-egorov/repos","events_url":"https://api.github.com/users/nikolay-egorov/events{/privacy}","received_events_url":"https://api.github.com/users/nikolay-egorov/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-04-28T17:00:19Z","updated_at":"2026-04-28T17:00:19Z","body":"Hmm, I think Quaternion is a bit more suitable here for several reasons:\r\n- `(1, 0, 0, 0) === (-1, 0, 0, 0)` is [handled](https://github.com/godotengine/godot/blob/320e81846979bd716341e0669231954543c4afbd/thirdparty/jolt_physics/Jolt/Physics/Constraints/ConstraintPart/SwingTwistConstraintPart.h#L185) by Jolt, in general seems like it should not be a client's side problem\r\n- Jolt's `SixDOFConstraint` takes `JPH::Quat` for target orientation, sticking with Basis would introduce a round-trip through Quaternion(basis) on every call, a scalable overhead that can be avoided \r\n- from what I see in the repo, [JointLimitation3D::solve](https://github.com/godotengine/godot/blob/320e81846979bd716341e0669231954543c4afbd/scene/resources/3d/joint_limitation_3d.h#L50) also accepts Quaternion\r\n\r\nSurely, I could be missing something","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4337438325/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4345395595","html_url":"https://github.com/godotengine/godot/pull/118997#issuecomment-4345395595","issue_url":"https://api.github.com/repos/godotengine/godot/issues/118997","id":4345395595,"node_id":"IC_kwDOAO6SJc8AAAABAwF5iw","user":{"login":"fire","id":32321,"node_id":"MDQ6VXNlcjMyMzIx","avatar_url":"https://avatars.githubusercontent.com/u/32321?v=4","gravatar_id":"","url":"https://api.github.com/users/fire","html_url":"https://github.com/fire","followers_url":"https://api.github.com/users/fire/followers","following_url":"https://api.github.com/users/fire/following{/other_user}","gists_url":"https://api.github.com/users/fire/gists{/gist_id}","starred_url":"https://api.github.com/users/fire/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/fire/subscriptions","organizations_url":"https://api.github.com/users/fire/orgs","repos_url":"https://api.github.com/users/fire/repos","events_url":"https://api.github.com/users/fire/events{/privacy}","received_events_url":"https://api.github.com/users/fire/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-04-29T16:00:27Z","updated_at":"2026-04-29T16:00:27Z","body":"To be clear I'm not blocking this.","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4345395595/reactions","total_count":1,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":1,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4365761363","html_url":"https://github.com/godotengine/godot/pull/118997#issuecomment-4365761363","issue_url":"https://api.github.com/repos/godotengine/godot/issues/118997","id":4365761363,"node_id":"IC_kwDOAO6SJc8AAAABBDg7Uw","user":{"login":"nikolay-egorov","id":28873057,"node_id":"MDQ6VXNlcjI4ODczMDU3","avatar_url":"https://avatars.githubusercontent.com/u/28873057?v=4","gravatar_id":"","url":"https://api.github.com/users/nikolay-egorov","html_url":"https://github.com/nikolay-egorov","followers_url":"https://api.github.com/users/nikolay-egorov/followers","following_url":"https://api.github.com/users/nikolay-egorov/following{/other_user}","gists_url":"https://api.github.com/users/nikolay-egorov/gists{/gist_id}","starred_url":"https://api.github.com/users/nikolay-egorov/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/nikolay-egorov/subscriptions","organizations_url":"https://api.github.com/users/nikolay-egorov/orgs","repos_url":"https://api.github.com/users/nikolay-egorov/repos","events_url":"https://api.github.com/users/nikolay-egorov/events{/privacy}","received_events_url":"https://api.github.com/users/nikolay-egorov/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-05-03T08:33:58Z","updated_at":"2026-05-03T08:33:58Z","body":"Looking at the updated behaviour with Euler path, a question appeared: \r\nShould the angular spring equilibrium point now be body-space like `SetTargetOrientationBS`, or keep legacy CS behaviour?\r\n\r\nBasically, to remove inversion here: \r\n`target_cs = Basis::from_euler(Vector3(-eq_x, -eq_y, -eq_z), ZYX);`\r\n\r\n","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4365761363/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4365850122","html_url":"https://github.com/godotengine/godot/pull/118997#issuecomment-4365850122","issue_url":"https://api.github.com/repos/godotengine/godot/issues/118997","id":4365850122,"node_id":"IC_kwDOAO6SJc8AAAABBDmWCg","user":{"login":"jrouwe","id":1621693,"node_id":"MDQ6VXNlcjE2MjE2OTM=","avatar_url":"https://avatars.githubusercontent.com/u/1621693?v=4","gravatar_id":"","url":"https://api.github.com/users/jrouwe","html_url":"https://github.com/jrouwe","followers_url":"https://api.github.com/users/jrouwe/followers","following_url":"https://api.github.com/users/jrouwe/following{/other_user}","gists_url":"https://api.github.com/users/jrouwe/gists{/gist_id}","starred_url":"https://api.github.com/users/jrouwe/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/jrouwe/subscriptions","organizations_url":"https://api.github.com/users/jrouwe/orgs","repos_url":"https://api.github.com/users/jrouwe/repos","events_url":"https://api.github.com/users/jrouwe/events{/privacy}","received_events_url":"https://api.github.com/users/jrouwe/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-05-03T09:26:20Z","updated_at":"2026-05-03T09:26:20Z","body":"> Looking at the updated behaviour with Euler path, a question appeared: Should the angular spring equilibrium point now be body-space like `SetTargetOrientationBS`, or keep legacy CS behaviour?\r\n> \r\n> Basically, to remove inversion here: `target_cs = Basis::from_euler(Vector3(-eq_x, -eq_y, -eq_z), ZYX);`\r\n\r\nThat inversion was specifically added to be compatible with Godot 3: https://github.com/godot-jolt/godot-jolt/pull/726. Godot Physics in 4.x doesn't implement the equilibrium point at all:\r\n\r\nhttps://github.com/godotengine/godot/blob/16bb065ac31b79c0ed24b3b944d3b5275123e854/modules/godot_physics_3d/joints/godot_generic_6dof_joint_3d.cpp#L526-L527\r\n\r\n@mihe did you compare the behavior between Godot 3 and Godot Jolt when the 6DOF joint was placed with a rotation (so that constraint space != body space)? \r\n\r\nA cursory glance into the Godot 3 code suggests that it is indeed working in constraint space:\r\n\r\nhttps://github.com/godotengine/godot/blob/da1b2b5d5727a63ff5e2a3a5a43c4c8b98dc64a0/modules/bullet/generic_6dof_joint_bullet.cpp#L172-L173\r\n\r\nhttps://github.com/godotengine/godot/blob/da1b2b5d5727a63ff5e2a3a5a43c4c8b98dc64a0/thirdparty/bullet/BulletDynamics/ConstraintSolver/btGeneric6DofSpring2Constraint.cpp#L271-L275\r\n\r\nhttps://github.com/godotengine/godot/blob/da1b2b5d5727a63ff5e2a3a5a43c4c8b98dc64a0/thirdparty/bullet/BulletDynamics/ConstraintSolver/btGeneric6DofSpring2Constraint.cpp#L418-L419\r\n\r\nThe documentation is also not helpful here:\r\n\r\nhttps://docs.godotengine.org/en/stable/classes/class_generic6dofjoint3d.html#class-generic6dofjoint3d-property-angular-spring-x-equilibrium-point\r\n\r\n","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4365850122/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4365902574","html_url":"https://github.com/godotengine/godot/pull/118997#issuecomment-4365902574","issue_url":"https://api.github.com/repos/godotengine/godot/issues/118997","id":4365902574,"node_id":"IC_kwDOAO6SJc8AAAABBDpi7g","user":{"login":"nikolay-egorov","id":28873057,"node_id":"MDQ6VXNlcjI4ODczMDU3","avatar_url":"https://avatars.githubusercontent.com/u/28873057?v=4","gravatar_id":"","url":"https://api.github.com/users/nikolay-egorov","html_url":"https://github.com/nikolay-egorov","followers_url":"https://api.github.com/users/nikolay-egorov/followers","following_url":"https://api.github.com/users/nikolay-egorov/following{/other_user}","gists_url":"https://api.github.com/users/nikolay-egorov/gists{/gist_id}","starred_url":"https://api.github.com/users/nikolay-egorov/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/nikolay-egorov/subscriptions","organizations_url":"https://api.github.com/users/nikolay-egorov/orgs","repos_url":"https://api.github.com/users/nikolay-egorov/repos","events_url":"https://api.github.com/users/nikolay-egorov/events{/privacy}","received_events_url":"https://api.github.com/users/nikolay-egorov/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-05-03T09:59:13Z","updated_at":"2026-05-03T09:59:13Z","body":"Thanks, that makes sense. Then I won't try to change the existing Euler equilibrium behaviour in this PR, looks like a bit of investigation/verification is required. \r\n\r\nfollow-up: I've made a simple script for the updated demo project (hopefully correct), which shows that the legacy Euler equilibrium path is not equivalent to a body-space target when the joint frame is rotated, so I kept that path unchanged. \r\n[probe.gd.zip](https://github.com/user-attachments/files/27315676/probe.gd.zip)\r\n\r\nThat just numbers for the visual behaviour that can already be seen in the demo, with the adjusted behaviour we discussed, will push the commit \r\n","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4365902574/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4368513723","html_url":"https://github.com/godotengine/godot/pull/118997#issuecomment-4368513723","issue_url":"https://api.github.com/repos/godotengine/godot/issues/118997","id":4368513723,"node_id":"IC_kwDOAO6SJc8AAAABBGI6uw","user":{"login":"nikolay-egorov","id":28873057,"node_id":"MDQ6VXNlcjI4ODczMDU3","avatar_url":"https://avatars.githubusercontent.com/u/28873057?v=4","gravatar_id":"","url":"https://api.github.com/users/nikolay-egorov","html_url":"https://github.com/nikolay-egorov","followers_url":"https://api.github.com/users/nikolay-egorov/followers","following_url":"https://api.github.com/users/nikolay-egorov/following{/other_user}","gists_url":"https://api.github.com/users/nikolay-egorov/gists{/gist_id}","starred_url":"https://api.github.com/users/nikolay-egorov/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/nikolay-egorov/subscriptions","organizations_url":"https://api.github.com/users/nikolay-egorov/orgs","repos_url":"https://api.github.com/users/nikolay-egorov/repos","events_url":"https://api.github.com/users/nikolay-egorov/events{/privacy}","received_events_url":"https://api.github.com/users/nikolay-egorov/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-05-04T05:27:29Z","updated_at":"2026-05-04T05:27:29Z","body":"At first, I tried to approach this problem exactly with the existing equilibrium point API, and I indeed got lost. Given that at the time, my understanding of such transforms was even worse than it is now, I also bumped into the issues with order/sign conventions. \r\nSince the first approach means several parameter writes rather than one backend-level target orientation update, I also shot my leg several times, exposing a transient one-step mismatch if only part of the derived equilibrium state is visible before the backend update.\r\n\r\nSo I thought it'd require much less time to deliver an already sound approach from Jolt rather than knocking on this door. \r\n\r\nThank you, @jrouwe, for your participation and efforts in explaining things along the way. As well as you guys @fire @AThousandShips \r\n\r\nI'll squash the changes and push one commit ","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4368513723/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4778975256","html_url":"https://github.com/godotengine/godot/pull/118997#issuecomment-4778975256","issue_url":"https://api.github.com/repos/godotengine/godot/issues/118997","id":4778975256,"node_id":"IC_kwDOAO6SJc8AAAABHNlgGA","user":{"login":"Repiteo","id":17489292,"node_id":"MDQ6VXNlcjE3NDg5Mjky","avatar_url":"https://avatars.githubusercontent.com/u/17489292?v=4","gravatar_id":"","url":"https://api.github.com/users/Repiteo","html_url":"https://github.com/Repiteo","followers_url":"https://api.github.com/users/Repiteo/followers","following_url":"https://api.github.com/users/Repiteo/following{/other_user}","gists_url":"https://api.github.com/users/Repiteo/gists{/gist_id}","starred_url":"https://api.github.com/users/Repiteo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Repiteo/subscriptions","organizations_url":"https://api.github.com/users/Repiteo/orgs","repos_url":"https://api.github.com/users/Repiteo/repos","events_url":"https://api.github.com/users/Repiteo/events{/privacy}","received_events_url":"https://api.github.com/users/Repiteo/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-06-23T12:02:22Z","updated_at":"2026-06-23T12:02:22Z","body":"Thanks! Congratulations on your first merged contribution! 🎉 ","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4778975256/reactions","total_count":5,"+1":0,"-1":0,"laugh":0,"hooray":4,"confused":0,"heart":1,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5087415411","html_url":"https://github.com/godotengine/godot/pull/118997#issuecomment-5087415411","issue_url":"https://api.github.com/repos/godotengine/godot/issues/118997","id":5087415411,"node_id":"IC_kwDOAO6SJc8AAAABLzvMcw","user":{"login":"V1LLz","id":125107512,"node_id":"U_kgDOB3T9OA","avatar_url":"https://avatars.githubusercontent.com/u/125107512?v=4","gravatar_id":"","url":"https://api.github.com/users/V1LLz","html_url":"https://github.com/V1LLz","followers_url":"https://api.github.com/users/V1LLz/followers","following_url":"https://api.github.com/users/V1LLz/following{/other_user}","gists_url":"https://api.github.com/users/V1LLz/gists{/gist_id}","starred_url":"https://api.github.com/users/V1LLz/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/V1LLz/subscriptions","organizations_url":"https://api.github.com/users/V1LLz/orgs","repos_url":"https://api.github.com/users/V1LLz/repos","events_url":"https://api.github.com/users/V1LLz/events{/privacy}","received_events_url":"https://api.github.com/users/V1LLz/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-07-27T04:55:42Z","updated_at":"2026-07-27T04:55:42Z","body":"\r\nThis is amazing!! Thanks so much for this great contribution. I had a question regarding `PhysicalBone3D`: are there any plans to bring or support more `Generic6DOFJoint3D `features over to them? I feel like `PhysicalBone3D `joints are missing quite a few options that the standalone node already has, like motors, ERP, Angular Restitution, Angular Damping, etc. From some tests I ran, it seems the 6DOF joint node itself already supports these natively.\r\n\r\nPart of why this would be great is that `PhysicalBones3D ` are just so much faster to set up than manually wiring individual `RigidBodies3D ` with separate joints. It'd be nice not to have to give that convenience up just to get access to the extra tuning options.\r\n\r\nAt one point I managed to get by with some advice from Mihe on using Angular Spring and the Equilibrium Point to build active ragdolls, similar to what was discussed in the conversation. Even though it works and gets decent results (after 2 years of trial and error XD), it feels like it requires a pretty complex setup and constantly fighting with the elastic behavior. I end up having to create a unique combination of mass, offsets, damping, and stiffness for every single bone and for every animation of the skeleton I'm trying to replicate.\r\n\r\nAt some point before 4.6, back when it was an extension, I remember reading a conversation where it was mentioned that this migration fell more under Godot's scope than Jolt's. But now that new Jolt-exclusive fields are being added (like the 6DOFJoint's \"Angular drive\" in 4.8), I wanted to ask if this is something that's currently possible. \r\n\r\nThanks again in advance for all your work :D","author_association":"NONE","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5087415411/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5094228569","html_url":"https://github.com/godotengine/godot/pull/118997#issuecomment-5094228569","issue_url":"https://api.github.com/repos/godotengine/godot/issues/118997","id":5094228569,"node_id":"IC_kwDOAO6SJc8AAAABL6PCWQ","user":{"login":"Norgorim","id":157975999,"node_id":"U_kgDOCWqFvw","avatar_url":"https://avatars.githubusercontent.com/u/157975999?v=4","gravatar_id":"","url":"https://api.github.com/users/Norgorim","html_url":"https://github.com/Norgorim","followers_url":"https://api.github.com/users/Norgorim/followers","following_url":"https://api.github.com/users/Norgorim/following{/other_user}","gists_url":"https://api.github.com/users/Norgorim/gists{/gist_id}","starred_url":"https://api.github.com/users/Norgorim/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Norgorim/subscriptions","organizations_url":"https://api.github.com/users/Norgorim/orgs","repos_url":"https://api.github.com/users/Norgorim/repos","events_url":"https://api.github.com/users/Norgorim/events{/privacy}","received_events_url":"https://api.github.com/users/Norgorim/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-07-27T16:55:02Z","updated_at":"2026-07-27T16:55:02Z","body":"Hey just wanted to give a quick thank you as this is just the feature I was looking for, right when I needed it. Updraded my project to the newest snapshot, tried it, and it seems to work exactly as expected, thanks a lot!\r\n\r\n(I hope this is appropriate to comment here, I am new to Github)","author_association":"NONE","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5094228569/reactions","total_count":2,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":2,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null}]