90 .\r\nProblem:\r\ncolor correction wasn't being applied in forward mobile backend unless glow was enabled\r\n\r\nCause:\r\n\"using_subpass_post_process\" was only disabled when glow, auto exposure, DOF, or canvas background were active. Color correction was missing from this condition, so when only color correction was enabled, the post-process pass was skipped entirely.\r\n\r\nFix:\r\nAdded `environment_get_color_correction_enabled()` to the condition so the post-process pass runs correctly when color correction is active.","labels":[{"id":73330064,"node_id":"MDU6TGFiZWw3MzMzMDA2NA==","url":"https://api.github.com/repos/godotengine/godot/labels/bug","name":"bug","description":"","color":"ff6055","default":true,"archived_at":null,"archived_by":null},{"id":279096997,"node_id":"MDU6TGFiZWwyNzkwOTY5OTc=","url":"https://api.github.com/repos/godotengine/godot/labels/archived","name":"archived","description":"","color":"aaaaaa","default":false,"archived_at":null,"archived_by":null},{"id":279098111,"node_id":"MDU6TGFiZWwyNzkwOTgxMTE=","url":"https://api.github.com/repos/godotengine/godot/labels/topic:rendering","name":"topic:rendering","description":"","color":"ffee88","default":false,"archived_at":null,"archived_by":null},{"id":1332303119,"node_id":"MDU6TGFiZWwxMzMyMzAzMTE5","url":"https://api.github.com/repos/godotengine/godot/labels/regression","name":"regression","description":"","color":"ff63ac","default":false,"archived_at":null,"archived_by":null}],"milestone":null,"active_lock_reason":null,"created_at":"2026-03-30T02:55:41Z","updated_at":"2026-04-13T08:14:47Z","closed_at":"2026-04-02T10:49:07Z","merged_at":null,"merge_commit_sha":"c772c88b0b94a7d0d500df0f07b48e6a906dbff1","assignee":null,"assignees":[],"requested_reviewers":[],"requested_teams":[],"head":{"label":"Alex-Dev-Beep:fix/color-correction-mobile-renderer","ref":"fix/color-correction-mobile-renderer","repo":null,"sha":"504130193c9165391a1b8ba9bd978a7eac36fa0e","user":{"login":"Alex-Dev-Beep","id":1856227