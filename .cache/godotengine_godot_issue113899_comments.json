[{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3643155837","html_url":"https://github.com/godotengine/godot/issues/113899#issuecomment-3643155837","issue_url":"https://api.github.com/repos/godotengine/godot/issues/113899","id":3643155837,"node_id":"IC_kwDOAO6SJc7ZJiV9","user":{"login":"AThousandShips","id":96648715,"node_id":"U_kgDOBcK-Cw","avatar_url":"https://avatars.githubusercontent.com/u/96648715?v=4","gravatar_id":"","url":"https://api.github.com/users/AThousandShips","html_url":"https://github.com/AThousandShips","followers_url":"https://api.github.com/users/AThousandShips/followers","following_url":"https://api.github.com/users/AThousandShips/following{/other_user}","gists_url":"https://api.github.com/users/AThousandShips/gists{/gist_id}","starred_url":"https://api.github.com/users/AThousandShips/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/AThousandShips/subscriptions","organizations_url":"https://api.github.com/users/AThousandShips/orgs","repos_url":"https://api.github.com/users/AThousandShips/repos","events_url":"https://api.github.com/users/AThousandShips/events{/privacy}","received_events_url":"https://api.github.com/users/AThousandShips/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-12-11T18:02:56Z","updated_at":"2025-12-11T18:02:56Z","body":"Please explain more in detail, with the game embedded there isn't a separate game window, so I'm not sure what is described here","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3643155837/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3643217570","html_url":"https://github.com/godotengine/godot/issues/113899#issuecomment-3643217570","issue_url":"https://api.github.com/repos/godotengine/godot/issues/113899","id":3643217570,"node_id":"IC_kwDOAO6SJc7ZJxai","user":{"login":"bruvzg","id":7645683,"node_id":"MDQ6VXNlcjc2NDU2ODM=","avatar_url":"https://avatars.githubusercontent.com/u/7645683?v=4","gravatar_id":"","url":"https://api.github.com/users/bruvzg","html_url":"https://github.com/bruvzg","followers_url":"https://api.github.com/users/bruvzg/followers","following_url":"https://api.github.com/users/bruvzg/following{/other_user}","gists_url":"https://api.github.com/users/bruvzg/gists{/gist_id}","starred_url":"https://api.github.com/users/bruvzg/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/bruvzg/subscriptions","organizations_url":"https://api.github.com/users/bruvzg/orgs","repos_url":"https://api.github.com/users/bruvzg/repos","events_url":"https://api.github.com/users/bruvzg/events{/privacy}","received_events_url":"https://api.github.com/users/bruvzg/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-12-11T18:21:24Z","updated_at":"2025-12-11T18:21:24Z","body":"macOS version? Are you using floating embedded window?\n\nOn macOS, the game window can't go behind anything, since there's no game window, embedding is handled by the view in the editor window.","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3643217570/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3645227127","html_url":"https://github.com/godotengine/godot/issues/113899#issuecomment-3645227127","issue_url":"https://api.github.com/repos/godotengine/godot/issues/113899","id":3645227127,"node_id":"IC_kwDOAO6SJc7ZRcB3","user":{"login":"CubeOfCheese","id":16740469,"node_id":"MDQ6VXNlcjE2NzQwNDY5","avatar_url":"https://avatars.githubusercontent.com/u/16740469?v=4","gravatar_id":"","url":"https://api.github.com/users/CubeOfCheese","html_url":"https://github.com/CubeOfCheese","followers_url":"https://api.github.com/users/CubeOfCheese/followers","following_url":"https://api.github.com/users/CubeOfCheese/following{/other_user}","gists_url":"https://api.github.com/users/CubeOfCheese/gists{/gist_id}","starred_url":"https://api.github.com/users/CubeOfCheese/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/CubeOfCheese/subscriptions","organizations_url":"https://api.github.com/users/CubeOfCheese/orgs","repos_url":"https://api.github.com/users/CubeOfCheese/repos","events_url":"https://api.github.com/users/CubeOfCheese/events{/privacy}","received_events_url":"https://api.github.com/users/CubeOfCheese/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-12-12T07:15:32Z","updated_at":"2025-12-12T07:15:32Z","body":"It is most definitely a separate game window. \n\nFrom the release notes of 4.5 I was expecting it to be an embedded window and was surprised when it was still a separate window. \n\nOne thing I noticed that I think could be critical is there are checkboxes for embedded and floating and they are both checked by default, which makes no sense to me. \n\nI will get a screen recording tomorrow. ","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3645227127/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3645283959","html_url":"https://github.com/godotengine/godot/issues/113899#issuecomment-3645283959","issue_url":"https://api.github.com/repos/godotengine/godot/issues/113899","id":3645283959,"node_id":"IC_kwDOAO6SJc7ZRp53","user":{"login":"bruvzg","id":7645683,"node_id":"MDQ6VXNlcjc2NDU2ODM=","avatar_url":"https://avatars.githubusercontent.com/u/7645683?v=4","gravatar_id":"","url":"https://api.github.com/users/bruvzg","html_url":"https://github.com/bruvzg","followers_url":"https://api.github.com/users/bruvzg/followers","following_url":"https://api.github.com/users/bruvzg/following{/other_user}","gists_url":"https://api.github.com/users/bruvzg/gists{/gist_id}","starred_url":"https://api.github.com/users/bruvzg/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/bruvzg/subscriptions","organizations_url":"https://api.github.com/users/bruvzg/orgs","repos_url":"https://api.github.com/users/bruvzg/repos","events_url":"https://api.github.com/users/bruvzg/events{/privacy}","received_events_url":"https://api.github.com/users/bruvzg/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-12-12T07:37:00Z","updated_at":"2025-12-12T07:39:13Z","body":"> One thing I noticed that I think could be critical is there are checkboxes for embedded and floating and they are both checked by default, which makes no sense to me.\n\nIf you have `floating` enabled, it should be a separate window (but it's a separate editor window, not a game window). If you want it to be in the Game tab, uncheck `floating`.\n\nThe state of these toggles is saved per project. But there is editor setting to set default behavior for all new project.","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3645283959/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3648545299","html_url":"https://github.com/godotengine/godot/issues/113899#issuecomment-3648545299","issue_url":"https://api.github.com/repos/godotengine/godot/issues/113899","id":3648545299,"node_id":"IC_kwDOAO6SJc7ZeGIT","user":{"login":"CubeOfCheese","id":16740469,"node_id":"MDQ6VXNlcjE2NzQwNDY5","avatar_url":"https://avatars.githubusercontent.com/u/16740469?v=4","gravatar_id":"","url":"https://api.github.com/users/CubeOfCheese","html_url":"https://github.com/CubeOfCheese","followers_url":"https://api.github.com/users/CubeOfCheese/followers","following_url":"https://api.github.com/users/CubeOfCheese/following{/other_user}","gists_url":"https://api.github.com/users/CubeOfCheese/gists{/gist_id}","starred_url":"https://api.github.com/users/CubeOfCheese/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/CubeOfCheese/subscriptions","organizations_url":"https://api.github.com/users/CubeOfCheese/orgs","repos_url":"https://api.github.com/users/CubeOfCheese/repos","events_url":"https://api.github.com/users/CubeOfCheese/events{/privacy}","received_events_url":"https://api.github.com/users/CubeOfCheese/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-12-12T23:55:00Z","updated_at":"2025-12-12T23:55:00Z","body":"I'm still working on reproducing the error, but in the meantime, this is what I was talking about.\nI don't understand why by default both \"Embed Game on next play\" and \"Make game workspace floating on next play\" are checked on. Aren't these options contradictory? It seems like it should be one toggle: floating/embedded, not two toggles\n\n<img width=\"342\" height=\"95\" alt=\"Image\" src=\"https://github.com/user-attachments/assets/f8dc21f9-cb21-4649-9a2f-113743db8a3e\" />","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3648545299/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3648564674","html_url":"https://github.com/godotengine/godot/issues/113899#issuecomment-3648564674","issue_url":"https://api.github.com/repos/godotengine/godot/issues/113899","id":3648564674,"node_id":"IC_kwDOAO6SJc7ZeK3C","user":{"login":"CubeOfCheese","id":16740469,"node_id":"MDQ6VXNlcjE2NzQwNDY5","avatar_url":"https://avatars.githubusercontent.com/u/16740469?v=4","gravatar_id":"","url":"https://api.github.com/users/CubeOfCheese","html_url":"https://github.com/CubeOfCheese","followers_url":"https://api.github.com/users/CubeOfCheese/followers","following_url":"https://api.github.com/users/CubeOfCheese/following{/other_user}","gists_url":"https://api.github.com/users/CubeOfCheese/gists{/gist_id}","starred_url":"https://api.github.com/users/CubeOfCheese/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/CubeOfCheese/subscriptions","organizations_url":"https://api.github.com/users/CubeOfCheese/orgs","repos_url":"https://api.github.com/users/CubeOfCheese/repos","events_url":"https://api.github.com/users/CubeOfCheese/events{/privacy}","received_events_url":"https://api.github.com/users/CubeOfCheese/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-12-13T00:08:45Z","updated_at":"2025-12-13T00:08:45Z","body":"I was not able to reproduce the problem just now by myself but I see a ton of my students dealing with it. I will continue to investigate.\n\nI'm guessing it's something tricky like a race condition or something based on it being inconsistent. Like maybe I'm not seeing the problem because my test projects were too small.","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3648564674/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3714618812","html_url":"https://github.com/godotengine/godot/issues/113899#issuecomment-3714618812","issue_url":"https://api.github.com/repos/godotengine/godot/issues/113899","id":3714618812,"node_id":"IC_kwDOAO6SJc7daJW8","user":{"login":"sdjmchattie","id":1999241,"node_id":"MDQ6VXNlcjE5OTkyNDE=","avatar_url":"https://avatars.githubusercontent.com/u/1999241?v=4","gravatar_id":"","url":"https://api.github.com/users/sdjmchattie","html_url":"https://github.com/sdjmchattie","followers_url":"https://api.github.com/users/sdjmchattie/followers","following_url":"https://api.github.com/users/sdjmchattie/following{/other_user}","gists_url":"https://api.github.com/users/sdjmchattie/gists{/gist_id}","starred_url":"https://api.github.com/users/sdjmchattie/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/sdjmchattie/subscriptions","organizations_url":"https://api.github.com/users/sdjmchattie/orgs","repos_url":"https://api.github.com/users/sdjmchattie/repos","events_url":"https://api.github.com/users/sdjmchattie/events{/privacy}","received_events_url":"https://api.github.com/users/sdjmchattie/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-01-06T13:01:52Z","updated_at":"2026-01-06T13:01:52Z","body":"I can reproduce the problem.  It occurs when the tooltip is shown for the play button.  If you click play and move the cursor away from the button immediately, the problem doesn't occur.  The tooltip pulls the focus back to the main window which then moves in front of the game window.","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3714618812/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3752380164","html_url":"https://github.com/godotengine/godot/issues/113899#issuecomment-3752380164","issue_url":"https://api.github.com/repos/godotengine/godot/issues/113899","id":3752380164,"node_id":"IC_kwDOAO6SJc7fqMcE","user":{"login":"jason-alt2","id":219924387,"node_id":"U_kgDODRvHow","avatar_url":"https://avatars.githubusercontent.com/u/219924387?v=4","gravatar_id":"","url":"https://api.github.com/users/jason-alt2","html_url":"https://github.com/jason-alt2","followers_url":"https://api.github.com/users/jason-alt2/followers","following_url":"https://api.github.com/users/jason-alt2/following{/other_user}","gists_url":"https://api.github.com/users/jason-alt2/gists{/gist_id}","starred_url":"https://api.github.com/users/jason-alt2/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/jason-alt2/subscriptions","organizations_url":"https://api.github.com/users/jason-alt2/orgs","repos_url":"https://api.github.com/users/jason-alt2/repos","events_url":"https://api.github.com/users/jason-alt2/events{/privacy}","received_events_url":"https://api.github.com/users/jason-alt2/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-01-15T00:57:05Z","updated_at":"2026-01-15T00:57:05Z","body":"I can also re-produce this issue on Tahoe 26.1 and on Godot mono v4.5.1. As mentioned by others its not consistent and doesn't happen everytime the editor is run. As @sdjmchattie mentioned it does seem to be a case where the tooltip pulls focus back to the main window and then dismisses the player window.\n\n","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3752380164/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3752385397","html_url":"https://github.com/godotengine/godot/issues/113899#issuecomment-3752385397","issue_url":"https://api.github.com/repos/godotengine/godot/issues/113899","id":3752385397,"node_id":"IC_kwDOAO6SJc7fqNt1","user":{"login":"jason-alt2","id":219924387,"node_id":"U_kgDODRvHow","avatar_url":"https://avatars.githubusercontent.com/u/219924387?v=4","gravatar_id":"","url":"https://api.github.com/users/jason-alt2","html_url":"https://github.com/jason-alt2","followers_url":"https://api.github.com/users/jason-alt2/followers","following_url":"https://api.github.com/users/jason-alt2/following{/other_user}","gists_url":"https://api.github.com/users/jason-alt2/gists{/gist_id}","starred_url":"https://api.github.com/users/jason-alt2/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/jason-alt2/subscriptions","organizations_url":"https://api.github.com/users/jason-alt2/orgs","repos_url":"https://api.github.com/users/jason-alt2/repos","events_url":"https://api.github.com/users/jason-alt2/events{/privacy}","received_events_url":"https://api.github.com/users/jason-alt2/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-01-15T00:59:50Z","updated_at":"2026-01-15T00:59:50Z","body":"For a workaround for anyone that might need one:\n`Editor Settings > Run > Window Placement > Game Embed Mode`\n\nAnd switch it to `Embed Game` (you then won't get a floating window at all and it will run in the editor)","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3752385397/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null}]