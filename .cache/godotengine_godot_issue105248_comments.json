com/users/diegopau/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/diegopau/subscriptions","organizations_url":"https://api.github.com/users/diegopau/orgs","repos_url":"https://api.github.com/users/diegopau/repos","events_url":"https://api.github.com/users/diegopau/events{/privacy}","received_events_url":"https://api.github.com/users/diegopau/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-09-08T17:38:37Z","updated_at":"2025-09-08T17:38:37Z","body":"@clayjohn do you mean both 4.3 and 4.5 beta 4? That would be useful input, it is possible that a different computer configuration or different OS / drivers, reduce that difference I notice or even (as in your case) removes the performance difference completely, after all 20% is not a huge difference anymore.","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3267280920/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3267328719","html_url":"https://github.com/godotengine/godot/issues/105248#issuecomment-3267328719","issue_url":"https://api.github.com/repos/godotengine/godot/issues/105248","id":3267328719,"node_id":"IC_kwDOAO6SJc7Cv3rP","user":{"login":"clayjohn","id":16521339,"node_id":"MDQ6VXNlcjE2NTIxMzM5","avatar_url":"https://avatars.githubusercontent.com/u/16521339?v=4","gravatar_id":"","url":"https://api.github.com/users/clayjohn","html_url":"https://github.com/clayjohn","followers_url":"https://api.github.com/users/clayjohn/followers","following_url":"https://api.github.com/users/clayjohn/following{/other_user}","gists_url":"https://api.github.com/users/clayjohn/gists{/gist_id}","starred_url":"https://api.github.com/users/clayjohn/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/clayjohn/subscriptions","organizations_url":"https://api.github.com/users/clayjohn/orgs","repos_url":"https://api.github.com/users/clayjohn/repos","events_url":"https://api.github.com/users/clayjohn/events{/privacy}","received_events_url":"https://api.github.com/users/clayjohn/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-09-08T17:55:19Z","updated_at":"2025-09-08T17:55:19Z","body":"Yes, sorry I meant 4.3 and 4.5 beta 4. \n\nAnd ya, it's entirely possible that the remaining issue is hardware dependent ","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3267328719/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3590677051","html_url":"https://github.com/godotengine/godot/issues/105248#issuecomment-3590677051","issue_url":"https://api.github.com/repos/godotengine/godot/issues/105248","id":3590677051,"node_id":"IC_kwDOAO6SJc7WBWI7","user":{"login":"cccccz","id":60713799,"node_id":"MDQ6VXNlcjYwNzEzNzk5","avatar_url":"https://avatars.githubusercontent.com/u/60713799?v=4","gravatar_id":"","url":"https://api.github.com/users/cccccz","html_url":"https://github.com/cccccz","followers_url":"https://api.github.com/users/cccccz/followers","following_url":"https://api.github.com/users/cccccz/following{/other_user}","gists_url":"https://api.github.com/users/cccccz/gists{/gist_id}","starred_url":"https://api.github.com/users/cccccz/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/cccccz/subscriptions","organizations_url":"https://api.github.com/users/cccccz/orgs","repos_url":"https://api.github.com/users/cccccz/repos","events_url":"https://api.github.com/users/cccccz/events{/privacy}","received_events_url":"https://api.github.com/users/cccccz/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-11-28T23:08:52Z","updated_at":"2025-11-28T23:08:52Z","body":"I checked the Monitors tab in the editor and I noticed that there is a huge discrepancy in how the RenderingServer handles these shapes:\n\n4.3-stable: 58 Draw Calls (Batching is active). 4.5-beta4: 48,426 Draw Calls (Batching is inactive).\n\n<img width=\"1205\" height=\"838\" alt=\"Image\" src=\"https://github.com/user-attachments/assets/711b2d96-ee01-4fb4-8e1f-fd63f72fb738\" />\n\nIt seems that `BoxShape3D::get_debug_arraymesh_faces` (introduced in #90644) creates a new unique `ArrayMesh` via `memnew` for every instance. If every shape has a unique Mesh RID, I think the RenderingServer is logically forced to issue separate draw calls, breaking hardware instancing. Could this be the cause of the remaining regression?","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3590677051/reactions","total_count":2,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":2},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3639712322","html_url":"https://github.com/godotengine/godot/issues/105248#issuecomment-3639712322","issue_url":"https://api.github.com/repos/godotengine/godot/issues/105248","id":3639712322,"node_id":"IC_kwDOAO6SJc7Y8ZpC","user":{"login":"clayjohn","id":16521339,"node_id":"MDQ6VXNlcjE2NTIxMzM5","avatar_url":"https://avatars.githubusercontent.com/u/16521339?v=4","gravatar_id":"","url":"https://api.github.com/users/clayjohn","html_url":"https://github.com/clayjohn","followers_url":"https://api.github.com/users/clayjohn/followers","following_url":"https://api.github.com/users/clayjohn/following{/other_user}","gists_url":"https://api.github.com/users/clayjohn/gists{/gist_id}","starred_url":"https://api.github.com/users/clayjohn/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/clayjohn/subscriptions","organizations_url":"https://api.github.com/users/clayjohn/orgs","repos_url":"https://api.github.com/users/clayjohn/repos","events_url":"https://api.github.com/users/clayjohn/events{/privacy}","received_events_url":"https://api.github.com/users/clayjohn/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-12-11T02:03:25Z","updated_at":"2025-12-11T02:03:25Z","body":"@cccccz Yes, that could definitely be it. ","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3639712322/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3777280963","html_url":"https://github.com/godotengine/godot/issues/105248#issuecomment-3777280963","issue_url":"https://api.github.com/repos/godotengine/godot/issues/105248","id":3777280963,"node_id":"IC_kwDOAO6SJc7hJLvD","user":{"login":"diegopau","id":315149,"node_id":"MDQ6VXNlcjMxNTE0OQ==","avatar_url":"https://avatars.githubusercontent.com/u/315149?v=4","gravatar_id":"","url":"https://api.github.com/users/diegopau","html_url":"https://github.com/diegopau","followers_url":"https://api.github.com/users/diegopau/followers","following_url":"https://api.github.com/users/diegopau/following{/other_user}","gists_url":"https://api.github.com/users/diegopau/gists{/gist_id}","starred_url":"https://api.github.com/users/diegopau/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/diegopau/subscriptions","organizations_url":"https://api.github.com/users/diegopau/orgs","repos_url":"https://api.github.com/users/diegopau/repos","events_url":"https://api.github.com/users/diegopau/events{/privacy}","received_events_url":"https://api.github.com/users/diegopau/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-01-21T10:17:59Z","updated_at":"2026-01-21T10:32:23Z","body":"From my testing there is a further performance downgrade of about 10% moving from Godot 4.5.1 to 4.6rc2. This would be on top of what was previously reported here.\n\n<img width=\"2560\" height=\"1408\" alt=\"Image\" src=\"https://github.com/user-attachments/assets/67c9f1d7-7d83-43b3-83dc-a40a2cf5beb7\" />\n\nYou can test with this simple project in both 4.5.1 and 4.6.rc2 (you just need to enable \"Debug -> Visible Collision Shapes\" and run the project):\n\n[collisions performance MRP-4_4_1.zip](https://github.com/user-attachments/files/19688865/collisions.performance.MRP-4_4_1.zip)\n\nI think you don't need to change anything in Godot.4.6.rc2 to make it use GodotPhysics3D because since the project was created with and old version it should use that instead of Jolt by default (which is what we want to have a fair comparison with the project running in 4.5.1 and the previous versions here reported)\nThis is under Windows 10 and the rendering device is set to Vulkan in both 4.5.1 and 4.6.rc2 (i think now the default is Direct3D 12 for windows but this project was tested using vulkan)","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3777280963/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null}]