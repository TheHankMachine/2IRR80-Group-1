uest_url":"https://api.github.com/repos/godotengine/godot/pulls/117599","author_association":"MEMBER","submitted_at":"2026-03-18T22:40:56Z"},{"id":3971407789,"node_id":"PRR_kwDOAO6SJc7stt-t","state":"COMMENTED","user":{"site_admin":false,"suspended":false,"updated_at":"0001-01-01T00:00:00Z","avatar_url":"https://avatars.githubusercontent.com/u/2308167?u=f7f8e0273f784f5ec6f6b7fe4a88d449896eb48a&v=4","created_at":"0001-01-01T00:00:00Z","followers":0,"following":0,"html_url":"https://github.com/Ivorforce","id":2308167,"node_id":"MDQ6VXNlcjIzMDgxNjc=","login":"Ivorforce","type":"User","owned_private_repos":0,"public_gists":0,"public_repos":0,"total_private_repos":0,"url":"https://api.github.com/users/Ivorforce"},"body":"","html_url":"https://github.com/godotengine/godot/pull/117599#pullrequestreview-3971407789","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/117599","author_association":"MEMBER","submitted_at":"2026-03-18T23:08:52Z"},{"id":3972060605,"node_id":"PRR_kwDOAO6SJc7swNW9","state":"COMMENTED","user":{"site_admin":false,"suspended":false,"updated_at":"0001-01-01T00:00:00Z","avatar_url":"https://avatars.githubusercontent.com/u/41305715?u=a27600b43b5278ada0f7abc144fcb1b615bdef8e&v=4","created_at":"0001-01-01T00:00:00Z","followers":0,"following":0,"html_url":"https://github.com/StarryWorm","id":41305715,"node_id":"MDQ6VXNlcjQxMzA1NzE1","login":"StarryWorm","type":"User","owned_private_repos":0,"public_gists":0,"public_repos":0,"total_private_repos":0,"url":"https://api.github.com/users/StarryWorm"},"body":"As far as the implementation goes, it looks like a clean copy with no loss of functionality (except ordering, which is a good thing). \r\n<sub> Edit: should have looked much closer :/ </sub>\r\nSome minor things to potentially consider but overall looks good to me. \r\n\r\nI am surprised by the reported loss of performance (haven't checked on my machine, so I can't confirm nor deny, and will trust DeeJay). But the only additional costs I can see are a few cases where you get an extra pointer indirection, but that shouldn't be very expensive. Remarkably, I would actually expect it to get faster thanks to eliminating some for loops in favor of `GDType`'s self & combined maps. ","html_url":"https://github.com/godotengine/godot/pull/117599#pullrequestreview-3972060605","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/117599","author_association":"CONTRIBUTOR","submitted_at":"2026-03-19T02:01:54Z"},{"id":3972810496,"node_id":"PRR_kwDOAO6SJc7szEcA","state":"COMMENTED","user":{"site_admin":false,"suspended":false,"updated_at":"0001-01-01T00:00:00Z","avatar_url":"https://avatars.githubusercontent.com/u/60024671?u=7e327c81e8a9552ea98ca69adcccac4a50657dd9&v=4","created_at":"0001-01-01T00:00:00Z","followers":0,"following":0,"html_url":"https://github.com/DeeJayLSP","id":60024671,"node_id":"MDQ6VXNlcjYwMDI0Njcx","login":"DeeJayLSP","type":"User","owned_private_repos":0,"public_gists":0,"public_repos":0,"total_private_repos":0,"url":"https://api.github.com/users/DeeJayLSP"},"body":"","html_url":"https://github.com/godotengine/godot/pull/117599#pullrequestreview-3972810496","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/117599","author_association":"CONTRIBUTOR","submitted_at":"2026-03-19T04:43:43Z"},{"id":3973110853,"node_id":"PRR_kwDOAO6SJc7s0NxF","state":"COMMENTED","user":{"site_admin":false,"suspended":false,"updated_at":"0001-01-01T00:00:00Z","avatar_url":"https://avatars.githubusercontent.com/u/3682588?u=c50cd4578b88ec1f4336c8f40c81f61465c8ed9e&v=4","created_at":"0001-01-01T00:00:00Z","followers":0,"following":0,"html_url":"https://github.com/Shadows-of-Fire","id":3682588,"node_id":"MDQ6VXNlcjM2ODI1ODg=","login":"Shadows-of-Fire","type":"User","owned_private_repos":0,"public_gists":0,"public_repos":0,"total_private_repos":0,"url":"https://api.github.com/users/Shadows-of-Fire"},"body":"","html_url":"https://github.com/godotengine/godot/pull/117599#pullreque