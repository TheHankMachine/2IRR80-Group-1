01-01T00:00:00Z","followers":0,"following":0,"html_url":"https://github.com/StarryWorm","id":41305715,"node_id":"MDQ6VXNlcjQxMzA1NzE1","login":"StarryWorm","type":"User","owned_private_repos":0,"public_gists":0,"public_repos":0,"total_private_repos":0,"url":"https://api.github.com/users/StarryWorm"},"body":"","html_url":"https://github.com/godotengine/godot/pull/117599#pullrequestreview-4059461168","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/117599","author_association":"CONTRIBUTOR","submitted_at":"2026-04-05T13:05:48Z"},{"id":4059471647,"node_id":"PRR_kwDOAO6SJc7x9p8f","state":"APPROVED","user":{"site_admin":false,"suspended":false,"updated_at":"0001-01-01T00:00:00Z","avatar_url":"https://avatars.githubusercontent.com/u/41305715?u=a27600b43b5278ada0f7abc144fcb1b615bdef8e&v=4","created_at":"0001-01-01T00:00:00Z","followers":0,"following":0,"html_url":"https://github.com/StarryWorm","id":41305715,"node_id":"MDQ6VXNlcjQxMzA1NzE1","login":"StarryWorm","type":"User","owned_private_repos":0,"public_gists":0,"public_repos":0,"total_private_repos":0,"url":"https://api.github.com/users/StarryWorm"},"body":"LGTM!\n\nThe type disabling issues should be adressed in a follow-up PR, but are safe to leave as-is since the disabling behavior is seemingly never used (possibly dead code). \nCould be worth moving the `if (type->disabled)` checks outside of the loop to avoid an unnecessary lookup and the iterations which will all fail if disabled, but that's not a blocker in any way. ","html_url":"https://github.com/godotengine/godot/pull/117599#pullrequestreview-4059471647","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/117599","author_association":"CONTRIBUTOR","submitted_at":"2026-04-05T13:19:28Z"},{"id":4059622849,"node_id":"PRR_kwDOAO6SJc7x-O3B","state":"COMMENTED","user":{"site_admin":false,"suspended":false,"updated_at":"0001-01-01T00:00:00Z","avatar_url":"https://avatars.githubusercontent.com/u/3682588?u=c50cd4578b88ec1f43