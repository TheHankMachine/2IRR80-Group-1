:macos","color":"e4e4e4","default":false,"description":"","archived_at":null,"archived_by":null},{"id":2909900850,"node_id":"MDU6TGFiZWwyOTA5OTAwODUw","url":"https://api.github.com/repos/godotengine/godot/labels/topic:export","name":"topic:export","color":"ffee88","default":false,"description":"","archived_at":null,"archived_by":null}],"state":"closed","locked":false,"assignees":[],"milestone":{"url":"https://api.github.com/repos/godotengine/godot/milestones/23","html_url":"https://github.com/godotengine/godot/milestone/23","labels_url":"https://api.github.com/repos/godotengine/godot/milestones/23/labels","id":12939969,"node_id":"MI_kwDOAO6SJc4AxXLB","number":23,"title":"4.6","description":"","creator":{"login":"Repiteo","id":17489292,"node_id":"MDQ6VXNlcjE3NDg5Mjky","avatar_url":"https://avatars.githubusercontent.com/u/17489292?v=4","gravatar_id":"","url":"https://api.github.com/users/Repiteo","html_url":"https://github.com/Repiteo","followers_url":"https://api.github.com/users/Repiteo/followers","following_url":"https://api.github.com/users/Repiteo/following{/other_user}","gists_url":"https://api.github.com/users/Repiteo/gists{/gist_id}","starred_url":"https://api.github.com/users/Repiteo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Repiteo/subscriptions","organizations_url":"https://api.github.com/users/Repiteo/orgs","repos_url":"https://api.github.com/users/Repiteo/repos","events_url":"https://api.github.com/users/Repiteo/events{/privacy}","received_events_url":"https://api.github.com/users/Repiteo/received_events","type":"User","user_view_type":"public","site_admin":false},"open_issues":3,"closed_issues":2978,"state":"closed","created_at":"2025-05-22T16:25:52Z","updated_at":"2026-10-04T16:23:23Z","due_on":null,"closed_at":"2026-01-26T18:09:14Z"},"comments":3,"created_at":"2025-12-05T17:27:49Z","updated_at":"2025-12-18T14:05:33Z","closed_at":"2025-12-18T14:05:28Z","assignee":null,"author_association":"NONE","issue_field_values":[],"type":null,"active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"### Tested versions\n\n- Reproducible in 4.5 & 4.5.1\n\n### System information\n\nGodot v4.5.1.stable.mono - macOS Tahoe (26.1.0) - Multi-window, 1 monitor - Metal (Forward+) - integrated Apple M1 Pro (Apple7) - Apple M1 Pro (8 threads) - 32.00 GiB memory\n\n### Issue description\n\nWhen exporting an app for macOS, in the Application section the Copyright field has no special character validation and drops the string directly into the Info.plist file. Apple doesn't support special characters or requires them to be wrapped in some way. Signing and notarization doesn't fail in Godot, but the app is considered malformed and cannot be opened and Apple will reject the notarization on their server with `The binary is not signed with a valid Developer ID certificate.`\n\n<img width=\"2306\" height=\"1470\" alt=\"Image\" src=\"https://github.com/user-attachments/assets/59deedda-2a70-45d1-a2aa-fcc43df5a403\" />\n\nRunning `spctl -vvv --assess --type exec ~/Downloads/Connect4\\ Observer.app` on the broken app yields\n`/Users/joshuafhiggins/Downloads/Connect4 Observer.app: a required plist file or resource is malformed`\n\n### Steps to reproduce\n\n1. Go to export any project for macOS\n2. Add any special characters to the `Copyright` field (eg. %&#@$)\n3. Exported app will not open\n\n### Minimal reproduction project (MRP)\n\n[new-game-project.zip](https://github.com/user-attachments/files/23966530/new-game-project.zip)\n\nYou'll need to enter your own code signing credentials.","closed_by":{"login":"akien-mga","id":4701338,"node_id":"MDQ6VXNlcjQ3MDEzMzg=","avatar_url":"https://avatars.githubusercontent.com/u/4701338?v=4","gravatar_id":"","url":"https://api.github.com/users/akien-mga","html_url":"https://github.com/akien-mga","followers_url":"https://api.github.com/users/akien-mga/followers","following_url":"https://api.github.com/users/akien-mga/following{/other_user}","gists_url":"https://api.github.com/users/akien-mga/gists{/gist_id}","starred_url":"https://api.github.com/users/akien-mga/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/akien-mga/subscriptions","organizations_url":"https://api.github.com/users/akien-mga/orgs","repos_url":"https://api.github.com/users/akien-mga/repos","events_url":"https://api.github.com/users/akien-mga/events{/privacy}","received_events_url":"https://api.github.com/users/akien-mga/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/113641/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/godotengine/godot/issues/113641/timeline","performed_via_github_app":null,"state_reason":"completed","pinned_comment":null}