s://api.github.com/users/van800/events{/privacy}","received_events_url":"https://api.github.com/users/van800/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-12-10T14:09:45Z","updated_at":"2025-12-10T14:09:45Z","body":"Sure, I will try within today-tomorrow.","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3637266069/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3638896532","html_url":"https://github.com/godotengine/godot/pull/105236#issuecomment-3638896532","issue_url":"https://api.github.com/repos/godotengine/godot/issues/105236","id":3638896532,"node_id":"IC_kwDOAO6SJc7Y5SeU","user":{"login":"van800","id":1482681,"node_id":"MDQ6VXNlcjE0ODI2ODE=","avatar_url":"https://avatars.githubusercontent.com/u/1482681?v=4","gravatar_id":"","url":"https://api.github.com/users/van800","html_url":"https://github.com/van800","followers_url":"https://api.github.com/users/van800/followers","following_url":"https://api.github.com/users/van800/following{/other_user}","gists_url":"https://api.github.com/users/van800/gists{/gist_id}","starred_url":"https://api.github.com/users/van800/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/van800/subscriptions","organizations_url":"https://api.github.com/users/van800/orgs","repos_url":"https://api.github.com/users/van800/repos","events_url":"https://api.github.com/users/van800/events{/privacy}","received_events_url":"https://api.github.com/users/van800/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-12-10T20:46:00Z","updated_at":"2025-12-10T20:46:00Z","body":"At the moment Rider doesn't send anything about non-gd files.\r\nI haven't spotted any problems while working with Godot from this pull request.\r\n\r\nIt would be interesting to know what the benefits of tracking the metadata of non-gd files are. Do any document links like gd-tscn work in Zed?\r\n","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3638896532/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3640730685","html_url":"https://github.com/godotengine/godot/pull/105236#issuecomment-3640730685","issue_url":"https://api.github.com/repos/godotengine/godot/issues/105236","id":3640730685,"node_id":"IC_kwDOAO6SJc7ZASQ9","user":{"login":"HolonProduction","id":99511741,"node_id":"U_kgDOBe5tvQ","avatar_url":"https://avatars.githubusercontent.com/u/99511741?v=4","gravatar_id":"","url":"https://api.github.com/users/HolonProduction","html_url":"https://github.com/HolonProduction","followers_url":"https://api.github.com/users/HolonProduction/followers","following_url":"https://api.github.com/users/HolonProduction/following{/other_user}","gists_url":"https://api.github.com/users/HolonProduction/gists{/gist_id}","starred_url":"https://api.github.com/users/HolonProduction/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/HolonProduction/subscriptions","organizations_url":"https://api.github.com/users/HolonProduction/orgs","repos_url":"https://api.github.com/users/HolonProduction/repos","events_url":"https://api.github.com/users/HolonProduction/events{/privacy}","received_events_url":"https://api.github.com/users/HolonProduction/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-12-11T08:08:28Z","updated_at":"2025-12-11T08:08:28Z","body":"> It would be interesting to know what the benefits of tracking the metadata of non-gd files are. Do any document links like gd-tscn work in Zed?\r\n\r\nZed does no client side filtering and sends lifecycle messages for all files to the server. So we need to filter for GDScript on the server side. Keeping track of the metadata is necessary for that. Because the language id associated with a file only gets send when it is first opened.\r\n\r\nIf we would just discard all non gdscript metadata and later receive some change notification for e.g. a scene file. It would not be clear whether the file is no GDScript or the client is broken (the VSCode extension used to send change requests without opening documents properly).","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3640730685/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3641094705","html_url":"https://github.com/godotengine/godot/pull/105236#issuecomment-3641094705","issue_url":"https://api.github.com/repos/godotengine/godot/issues/105236","id":3641094705,"node_id":"IC_kwDOAO6SJc7ZBrIx","user":{"login":"van800","id":1482681,"node_id":"MDQ6VXNlcjE0ODI2ODE=","avatar_url":"https://avatars.githubusercontent.com/u/1482681?v=4","gravatar_id":"","url":"https://api.github.com/users/van800","html_url":"https://github.com/van800","followers_url":"https://api.github.com/users/van800/followers","following_url":"https://api.github.com/users/van800/following{/other_user}","gists_url":"https://api.github.com/users/van800/gists{/gist_id}","starred_url":"https://api.github.com/users/van800/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/van800/subscriptions","organizations_url":"https://api.github.com/users/van800/orgs","repos_url":"https://api.github.com/users/van800/repos","events_url":"https://api.github.com/users/van800/events{/privacy}","received_events_url":"https://api.github.com/users/van800/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-12-11T09:43:23Z","updated_at":"2025-12-11T09:43:23Z","body":"If it just satisfies Zed, why shouldn't it be fixed there?\r\n\r\nThat said, I confirm, I haven't found any regressions introduced by this pull request.\r\n\r\nI have made a [ticket](https://youtrack.jetbrains.com/issue/RIDER-133752/Change-languageId-for-Godot-to-gdscript) for myself to update languageId in Rider to \"gdscript\" to be aligned with other lsp clients. In this PR the case is handled nicely.\r\n","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3641094705/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3641694829","html_url":"https://github.com/godotengine/godot/pull/105236#issuecomment-3641694829","issue_url":"https://api.github.com/repos/godotengine/godot/issues/105236","id":3641694829,"node_id":"IC_kwDOAO6SJc7ZD9pt","user":{"login":"HolonProduction","id":99511741,"node_id":"U_kgDOBe5tvQ","avatar_url":"https://avatars.githubusercontent.com/u/99511741?v=4","gravatar_id":"","url":"https://api.github.com/users/HolonProduction","html_url":"https://github.com/HolonProduction","followers_url":"https://api.github.com/users/HolonProduction/followers","following_url":"https://api.github.com/users/HolonProduction/following{/other_user}","gists_url":"https://api.github.com/users/HolonProduction/gists{/gist_id}","starred_url":"https://api.github.com/users/HolonProduction/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/HolonProduction/subscriptions","organizations_url":"https://api.github.com/users/HolonProduction/orgs","repos_url":"https://api.github.com/users/HolonProduction/repos","events_url":"https://api.github.com/users/HolonProduction/event