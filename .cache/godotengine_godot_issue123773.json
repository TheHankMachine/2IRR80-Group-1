ved_at":null,"archived_by":null},{"id":283518733,"node_id":"MDU6TGFiZWwyODM1MTg3MzM=","url":"https://api.github.com/repos/godotengine/godot/labels/usability","name":"usability","color":"447744","default":false,"description":"","archived_at":null,"archived_by":null},{"id":1609442062,"node_id":"MDU6TGFiZWwxNjA5NDQyMDYy","url":"https://api.github.com/repos/godotengine/godot/labels/topic:shaders","name":"topic:shaders","color":"ffee88","default":false,"description":"","archived_at":null,"archived_by":null}],"state":"closed","locked":false,"assignees":[],"milestone":{"url":"https://api.github.com/repos/godotengine/godot/milestones/25","html_url":"https://github.com/godotengine/godot/milestone/25","labels_url":"https://api.github.com/repos/godotengine/godot/milestones/25/labels","id":15520464,"node_id":"MI_kwDOAO6SJc4A7NLQ","number":25,"title":"4.8","description":"","creator":{"login":"Repiteo","id":17489292,"node_id":"MDQ6VXNlcjE3NDg5Mjky","avatar_url":"https://avatars.githubusercontent.com/u/17489292?v=4","gravatar_id":"","url":"https://api.github.com/users/Repiteo","html_url":"https://github.com/Repiteo","followers_url":"https://api.github.com/users/Repiteo/followers","following_url":"https://api.github.com/users/Repiteo/following{/other_user}","gists_url":"https://api.github.com/users/Repiteo/gists{/gist_id}","starred_url":"https://api.github.com/users/Repiteo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Repiteo/subscriptions","organizations_url":"https://api.github.com/users/Repiteo/orgs","repos_url":"https://api.github.com/users/Repiteo/repos","events_url":"https://api.github.com/users/Repiteo/events{/privacy}","received_events_url":"https://api.github.com/users/Repiteo/received_events","type":"User","user_view_type":"public","site_admin":false},"open_issues":345,"closed_issues":2336,"state":"open","created_at":"2026-04-13T15:59:35Z","updated_at":"2026-10-22T08:21:32Z","due_on":null,"closed_at":null},"comments":3,"created_at":"2026-09-23T20:50:18Z","updated_at":"2026-09-29T19:12:05Z","closed_at":"2026-09-29T19:11:39Z","assignee":null,"author_association":"MEMBER","issue_field_values":[],"type":null,"active_lock_reason":null,"draft":false,"pull_request":{"url":"https://api.github.com/repos/godotengine/godot/pulls/123773","html_url":"https://github.com/godotengine/godot/pull/123773","diff_url":"https://github.com/godotengine/godot/pull/123773.diff","patch_url":"https://github.com/godotengine/godot/pull/123773.patch","merged_at":"2026-09-29T19:11:39Z"},"body":"This is a follow-up to https://github.com/godotengine/godot/pull/99404, adding one important UX improvement that speeds up node group creation significantly.\r\nAs always, this was a bit more sophisticated than anticipated.\r\n\r\n<img width=\"1425\" height=\"693\" alt=\"Animation\" src=\"https://github.com/user-attachments/assets/8cabc4cb-c489-42f3-a84f-af3cf5364bb2\" />\r\n\r\n\r\n## Detailed changes:\r\n- Adds a context menu option (\"Make Group\") for creating a group based on the current selection in the VisualShader editor\r\n\t- Replaces the selection after validating (to prevent cycles or forbidden nodes moving in) with a node group instance (everything stays connected, so the operation is seamless); undo/redo works of course \r\n\t- Multiple connections from the same output port share one group port; group ports are sorted based on the position of the source nodes to minimize \"entanglement\"; group port names are based on the inner port they are connected to (with a fallback to that node's caption).\r\n- Refactoring along the way:\r\n\t- Made NodeMenuOptions and ConnectionMenuOptions enum class to avoid the MAKE_GROUP name clash (+ we want to move to enum class in general)\r\n\t- Refactor node deletion a bit (use LocalVector instead of List)\r\n\r\n## Notes:\r\n- A remaining TODO is to add a shortcut (Ctrl + G) for this, but that might conflict with grouping in the 2D/3D editor (need to investigate)\r\n- I'd really like to deprecate `VisualShaderNodeGroupBase` since it's a relic from the past. Ideally the Expression node should be overhauled to use the same mechanisms for port management as node groups.\r\n- I have a refactor/cleanup PR for the port expansion code in the works which should get rid of ~300 LOC.\r\n\r\nAI Disclosure: AI was used as part of a review pass at the end; resulting changes were done manually or in the form of surgical instructions.","closed_by":{"login":"Repiteo","id":17489292,"node_id":"MDQ6VXNlcjE3NDg5Mjky","avatar_url":"https://avatars.githubusercontent.com/u/17489292?v=4","gravatar_id":"","url":"https://api.github.com/users/Repiteo","html_url":"https://github.com/Repiteo","followers_url":"https://api.github.com/users/Repiteo/followers","following_url":"https://api.github.com/users/Repiteo/following{/other_user}","gists_url":"https://api.github.com/users/Repiteo/gists{/gist_id}","starred_url":"https://api.github.com/users/Repiteo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Repiteo/subscriptions","organizations_url":"https://api.github.com/users/Repiteo/orgs","repos_url":"https://api.github.com/users/Repiteo/repos","events_url":"https://api.github.com/users/Repiteo/events{/privacy}","received_events_url":"https://api.github.com/users/Repiteo/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/123773/reactions","total_count":21,"+1":8,"-1":0,"laugh":0,"hooray":5,"confused":0,"heart":4,"rocket":4,"eyes":0},"timeline_url":"https://api.github.com/repos/godotengine/godot/issues/123773/timeline","performed_via_github_app":null,"state_reason":null}