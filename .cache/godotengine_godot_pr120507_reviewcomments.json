d_events_url":"https://api.github.com/users/neclor/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"No, the mirroring is not lost - it's converted into a flag before being normalized. The pattern is identical to what `canvas_item_add_texture_rect_region` already does for regular rects.","created_at":"2026-06-22T22:55:03Z","updated_at":"2026-06-22T22:55:04Z","html_url":"https://github.com/godotengine/godot/pull/120507#discussion_r3455945761","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/120507","_links":{"self":{"href":"https://api.github.com/repos/godotengine/godot/pulls/comments/3455945761"},"html":{"href":"https://github.com/godotengine/godot/pull/120507#discussion_r3455945761"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/120507"}},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/3455945761/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":1732,"original_line":1732,"side":"RIGHT","in_reply_to_id":3454376353,"author_association":"CONTRIBUTOR","original_position":9,"position":9,"subject_type":"line"}]