archived_at":null,"archived_by":null},{"id":8133949121,"node_id":"LA_kwDOAO6SJc8AAAAB5NI2wQ","url":"https://api.github.com/repos/godotengine/godot/labels/topic:i18n","name":"topic:i18n","color":"ffee88","default":false,"description":"","archived_at":null,"archived_by":null}],"state":"closed","locked":false,"assignees":[],"milestone":{"url":"https://api.github.com/repos/godotengine/godot/milestones/22","html_url":"https://github.com/godotengine/godot/milestone/22","labels_url":"https://api.github.com/repos/godotengine/godot/milestones/22/labels","id":12070367,"node_id":"MI_kwDOAO6SJc4AuC3f","number":22,"title":"4.5","description":"","creator":{"login":"Sauermann","id":6299227,"node_id":"MDQ6VXNlcjYyOTkyMjc=","avatar_url":"https://avatars.githubusercontent.com/u/6299227?v=4","gravatar_id":"","url":"https://api.github.com/users/Sauermann","html_url":"https://github.com/Sauermann","followers_url":"https://api.github.com/users/Sauermann/followers","following_url":"https://api.github.com/users/Sauermann/following{/other_user}","gists_url":"https://api.github.com/users/Sauermann/gists{/gist_id}","starred_url":"https://api.github.com/users/Sauermann/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Sauermann/subscriptions","organizations_url":"https://api.github.com/users/Sauermann/orgs","repos_url":"https://api.github.com/users/Sauermann/repos","events_url":"https://api.github.com/users/Sauermann/events{/privacy}","received_events_url":"https://api.github.com/users/Sauermann/received_events","type":"User","user_view_type":"public","site_admin":false},"open_issues":3,"closed_issues":3687,"state":"closed","created_at":"2024-12-19T08:51:28Z","updated_at":"2026-09-04T21:48:38Z","due_on":"2025-09-15T00:00:00Z","closed_at":"2025-09-18T17:13:14Z"},"comments":1,"created_at":"2025-05-27T01:56:55Z","updated_at":"2025-05-27T14:52:44Z","closed_at":"2025-05-27T14:50:36Z","assignee":null,"author_association":"MEMBER","issue_field_values":[],"type":null,"active_lock_reason":null,"draft":false,"pull_request":{"url":"https://api.github.com/repos/godotengine/godot/pulls/106855","html_url":"https://github.com/godotengine/godot/pull/106855","diff_url":"https://github.com/godotengine/godot/pull/106855.diff","patch_url":"https://github.com/godotengine/godot/pull/106855.patch","merged_at":"2025-05-27T14:50:36Z"},"body":"Calling `Translation::set_locale()` automatically propagates `NOTIFICATION_TRANSLATION_CHANGED` in the scene tree if translation for the target locale exists.\r\n\r\nThis behavior was added in https://github.com/godotengine/godot/commit/db3b05d2893dcaddeb3bcb10b845ff150eb50895 and has never been documented.\r\n\r\nIt seems strange and unreasonable:\r\n\r\n- The `Translation` object might not be registered in the translation server. In this case, it refreshes the scene tree for nothing.\r\n- This logic won't be executed when loading a translation for the default `en` locale (e.g., for projects using identifiers for translatable fields instead of actual text).\r\n- When loading a large number of different translations, it's easy to cause the scene tree to refresh multiple times, which is unnecessary.\r\n\r\nI don't know if there are any user code that depend on this behavior, but I think we can try to remove it in beta.","closed_by":{"login":"Repiteo","id":17489292,"node_id":"MDQ6VXNlcjE3NDg5Mjky","avatar_url":"https://avatars.githubusercontent.com/u/17489292?v=4","gravatar_id":"","url":"https://api.github.com/users/Repiteo","html_url":"https://github.com/Repiteo","followers_url":"https://api.github.com/users/Repiteo/followers","following_url":"https://api.github.com/users/Repiteo/following{/other_user}","gists_url":"https://api.github.com/users/Repiteo/gists{/gist_id}","starred_url":"https://api.github.com/users/Repiteo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Repiteo/subscriptions","organizations_url":"https://api.github.com/users/Repiteo/orgs","repos_url":"https://api.github.com/users/Repiteo/repos","events_url":"https://api.github.com/users/Repiteo/events{/privacy}","received_events_url":"https://api.github.com/users/Repiteo/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/106855/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/godotengine/godot/issues/106855/timeline","performed_via_github_app":null,"state_reason":null}