ontent.com/u/17489292?v=4","gravatar_id":"","url":"https://api.github.com/users/Repiteo","html_url":"https://github.com/Repiteo","followers_url":"https://api.github.com/users/Repiteo/followers","following_url":"https://api.github.com/users/Repiteo/following{/other_user}","gists_url":"https://api.github.com/users/Repiteo/gists{/gist_id}","starred_url":"https://api.github.com/users/Repiteo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Repiteo/subscriptions","organizations_url":"https://api.github.com/users/Repiteo/orgs","repos_url":"https://api.github.com/users/Repiteo/repos","events_url":"https://api.github.com/users/Repiteo/events{/privacy}","received_events_url":"https://api.github.com/users/Repiteo/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-11-12T17:37:20Z","updated_at":"2025-11-12T17:37:20Z","body":"Thanks!","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3523112438/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3526299668","html_url":"https://github.com/godotengine/godot/pull/111909#issuecomment-3526299668","issue_url":"https://api.github.com/repos/godotengine/godot/issues/111909","id":3526299668,"node_id":"IC_kwDOAO6SJc7SLxAU","user":{"login":"clayjohn","id":16521339,"node_id":"MDQ6VXNlcjE2NTIxMzM5","avatar_url":"https://avatars.githubusercontent.com/u/16521339?v=4","gravatar_id":"","url":"https://api.github.com/users/clayjohn","html_url":"https://github.com/clayjohn","followers_url":"https://api.github.com/users/clayjohn/followers","following_url":"https://api.github.com/users/clayjohn/following{/other_user}","gists_url":"https://api.github.com/users/clayjohn/gists{/gist_id}","starred_url":"https://api.github.com/users/clayjohn/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/clayjohn/subscriptions","organizations_url":"https://api.github.com/users/clayjohn/orgs","repos_url":"https://api.github.com/users/clayjohn/repos","events_url":"https://api.github.com/users/clayjohn/events{/privacy}","received_events_url":"https://api.github.com/users/clayjohn/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-11-13T08:14:17Z","updated_at":"2025-11-13T08:14:17Z","body":"With this PR I can no longer run an exported Android project. Using the default config for Android exports, I get an endless spam of \r\n\r\n```\r\nERROR: Scene path was specified on the command line, but this Godot binary was compiled without support for path overrides. Aborting. To be able to use it, use the `disable_path_overrides=no` SCons option when compiling Godot.\r\n```\r\n\r\nI have not done anything to specify Scene path on the command line. \r\n\r\nIt sounds like Android exports were implicitly relying on path overrides somewhere. ","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3526299668/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3526336977","html_url":"https://github.com/godotengine/godot/pull/111909#issuecomment-3526336977","issue_url":"https://api.github.com/repos/godotengine/godot/issues/111909","id":3526336977,"node_id":"IC_kwDOAO6SJc7SL6HR","user":{"login":"bruvzg","id":7645683,"node_id":"MDQ6VXNlcjc2NDU2ODM=","avatar_url":"https://avatars.githubusercontent.com/u/7645683?v=4","gravatar_id":"","url":"https://api.github.com/users/bruvzg","html_url":"https://github.com/bruvzg","followers_url":"https://api.github.com/users/bruvzg/followers","following_url":"https://api.github.com/users/bruvzg/following{/other_user}","gists_url":"https://api.github.com/users/bruvzg/gists{/gist_id}","starred_url":"https://api.github.com/users/bruvzg/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/bruvzg/subscriptions","organizations_url":"https://api.github.com/users/bruvzg/orgs","repos_url":"https://api.github.com/users/bruvzg/repos","events_url":"https://api.github.com/users/bruvzg/events{/privacy}","received_events_url":"https://api.github.com/users/bruvzg/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-11-13T08:19:34Z","updated_at":"2025-11-13T08:19:34Z","body":"> It sounds like Android exports were implicitly relying on path overrides somewhere.\r\n\r\nWill check it in a moment, it should not depend on scene path.","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3526336977/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3526359608","html_url":"https://github.com/godotengine/godot/pull/111909#issuecomment-3526359608","issue_url":"https://api.github.com/repos/godotengine/godot/issues/111909","id":3526359608,"node_id":"IC_kwDOAO6SJc7SL_o4","user":{"login":"clayjohn","id":16521339,"node_id":"MDQ6VXNlcjE2NTIxMzM5","avatar_url":"https://avatars.githubusercontent.com/u/16521339?v=4","gravatar_id":"","url":"https://api.github.com/users/clayjohn","html_url":"https://github.com/clayjohn","followers_url":"https://api.github.com/users/clayjohn/followers","following_url":"https://api.github.com/users/clayjohn/following{/other_user}","gists_url":"https://api.github.com/users/clayjohn/gists{/gist_id}","starred_url":"https://api.github.com/users/clayjohn/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/clayjohn/subscriptions","organizations_url":"https://api.github.com/users/clayjohn/orgs","repos_url":"https://api.github.com/users/clayjohn/repos","events_url":"https://api.github.com/users/clayjohn/events{/privacy}","received_events_url":"https://api.github.com/users/clayjohn/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-11-13T08:22:49Z","updated_at":"2025-11-13T08:24:07Z","body":"> ERROR: Scene path was specified on the command line, but this Godot binary was compiled without support for path overrides. Aborting. To be able to use it, use the `disable_path_overrides=no` SCons option when compiling Godot.\r\n\r\nLooks like the logic is just incorrect\r\n\r\n```\r\n\t\t} else if (E->get().length() && E->get()[0] != '-' && positional_arg.is_empty() && game_path.is_empty()) {\r\n#if defined(OVERRIDE_PATH_ENABLED)\r\n\t\t\tpositional_arg = E->get();\r\n\r\n\t\t\tString scene_path = ResourceUID::ensure_path(E->get());\r\n\t\t\tif (scene_path.ends_with(\".scn\") ||\r\n\t\t\t\t\tscene_path.ends_with(\".tscn\") ||\r\n\t\t\t\t\tscene_path.ends_with(\".escn\") ||\r\n\t\t\t\t\tscene_path.ends_with(\".res\") ||\r\n\t\t\t\t\tscene_path.ends_with(\".tres\")) {\r\n\t\t\t\t// Only consider the positional argument to be a scene path if it ends with\r\n\t\t\t\t// a file extension associated with Godot scenes. This makes it possible\r\n\t\t\t\t// for projects to parse command-line arguments for custom CLI arguments\r\n\t\t\t\t// or other file extensions without trouble. This can be used to implement\r\n\t\t\t\t// \"drag-and-drop onto executable\" logic, which can prove helpful\r\n\t\t\t\t// for non-game applications.\r\n\t\t\t\tgame_path = scene_path;\r\n\t\t\t}\r\n#else\r\n\t\t\tERR_PRINT(\r\n\t\t\t\t\t\"Scene path was specified on the command line, but this Godot binary was compiled without support for path overrides. Aborting.\\n\"\r\n\t\t\t\t\t\"To be able to use it, use the `disable_path_overrides=no` SCons option when compiling Godot.\\n\");\r\n\t\t\treturn EXIT_FAILURE;\r\n#endif // defined(OVERRIDE_PATH_ENABLED)\r\n```\r\n\r\nIt currently fails without even checking if scene paths are used\r\n\r\nIn other words, when override path is disabled it just always fails if it reaches this block. But it reaches this block if there is an argument starting with \"-\", so it catches way too much","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3526359608/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3526373437","html_url":"https://github.com/godotengine/godot/pull/111909#issuecomment-3526373437","issue_url":"https://api.github.com/repos/godotengine/godot/issues/111909","id":3526373437,"node_id":"IC_kwDOAO6SJc7SMDA9","user":{"login":"bruvzg","id":7645683,"node_id":"MDQ6VXNlcjc2NDU2ODM=","avatar_url":"https://avatars.githubusercontent.com/u/7645683?v=4","gravatar_id":"","url":"https://api.github.com/users/bruvzg","html_url":"https://github.com/bruvzg","followers_url":"https://api.github.com/users/bruvzg/followers","following_url":"https://api.github.com/users/bruvzg/following{/other_user}","gists_url":"https://api.github.com/users/bruvzg/gists{/gist_id}","starred_url":"https://api.github.com/users/bruvzg/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/bruvzg/subscriptions","organizations_url":"https://api.github.com/users/bruvzg/orgs","repos_url":"https://api.github.com/users/bruvzg/repos","events_url":"https://api.github.com/users/bruvzg/events{/privacy}","received_events_url":"https://api.github.com/users/bruvzg/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-11-13T08:24:44Z","updated_at":"2025-11-13T08:24:44Z","body":"Yes, it's likely it, and should only disable in the `game_path` setting section.","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3526373437/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3526387753","html_url":"https://github.com/godotengine/godot/pull/111909#issuecomment-3526387753","issue_url":"https://api.github.com/repos/godotengine/godot/issues/111909","id":3526387753,"node_id":"IC_kwDOAO6SJc7SMGgp","user":{"login":"clayjohn","id":16521339,"node_id":"MDQ6VXNlcjE2NTIxMzM5","avatar_url":"https://avatars.githubusercontent.com/u/16521339?v=4","gravatar_id":"","url":"https://api.github.com/users/clayjohn","html_url":"https://github.com/clayjohn","followers_url":"https://api.github.com/users/clayjohn/followers","following_url":"https://api.github.com/users/clayjohn/following{/other_user}","gists_url":"https://api.github.com/users/clayjohn/gists{/gist_id}","starred_url":"https://api.github.com/users/clayjohn/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/clayjohn/subscriptions","organizations_url":"https://api.github.com/users/clayjohn/orgs","repos_url":"https://api.github.com/users/clayjohn/repos","events_url":"https://api.github.com/users/clayjohn/events{/privacy}","received_events_url":"https://api.github.com/users/clayjohn/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-11-13T08:26:49Z","updated_at":"2025-11-13T08:26:49Z","body":"> Yes, it's likely it, and should only disable in the `game_path` setting section.\r\n\r\nYa, it should only fail if the user attempts to use a scene_path. If scene_path is empty, it shouldn't fail","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3526387753/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3597762762","html_url":"https://github.com/godotengine/godot/pull/111909#issuecomment-3597762762","issue_url":"https://api.github.com/repos/godotengine/godot/issues/111909","id":3597762762,"node_id":"IC_kwDOAO6SJc7WcYDK","user":{"login":"FeldrinH","id":5256211,"node_id":"MDQ6VXNlcjUyNTYyMTE=","avatar_url":"https://avatars.githubusercontent.com/u/5256211?v=4","gravatar_id":"","url":"https://api.github.com/users/FeldrinH","html_url":"https://github.com/FeldrinH","followers_url":"https://api.github.com/users/FeldrinH/followers","following_url":"https://api.github.com/users/FeldrinH/following{/other_user}","gists_url":"https://api.github.com/users/FeldrinH/gists{/gist_id}","starred_url":"https://api.github.com/users/FeldrinH/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/FeldrinH/subscriptions","organizations_url":"https://api.github.com/users/FeldrinH/orgs","repos_url":"https://api.github.com/users/FeldrinH/repos","events_url":"https://api.github.com/users/FeldrinH/events{/privacy}","received_events_url":"https://api.github.com/users/FeldrinH/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-12-01T17:02:43Z","updated_at":"2025-12-01T17:03:29Z","body":"It seems I'm a bit late to the party, but I wanted to add that I have developed some mod loaders for Godot-based games (https://github.com/FeldrinH/TASmaniac, https://github.com/FeldrinH/Luckloader) and the `--script` entrypoint was extremely clean and powerful for this.\r\n\r\nI'm not sure I understand why this needed to be disabled by default, while override.cfg based injection points remain enabled by default.","author_association":"NONE","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3597762762/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3597806098","html_url":"https://github.com/godotengine/godot/pull/111909#issuecomment-3597806098","issue_url":"https://api.github.com/repos/godotengine/godot/issues/111909","id":3597806098,"node_id":"IC_kwDOAO6SJc7WcioS","user":{"login":"FeldrinH","id":5256211,"node_id":"MDQ6VXNlcjUyNTYyMTE=","avatar_url":"https://avatars.githubusercontent.com/u/5256211?v=4","gravatar_id":"","url":"https://api.github.com/users/FeldrinH","html_url":"https://github.com/FeldrinH","followers_url":"https://api.github.com/users/FeldrinH/followers","following_url":"https://api.github.com/users/FeldrinH/following{/other_user}","gists_url":"https://api.github.com/users/FeldrinH/gists{/gist_id}","starred_url":"https://api.github.com/users/FeldrinH/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/FeldrinH/subscriptions","organizations_url":"https://api.github.com/users/FeldrinH/orgs","repos_url":"https://api.github.com/users/FeldrinH/repos","events_url":"https://api.github.com/users/FeldrinH/events{/privacy}","received_events_url":"https://api.github.com/users/FeldrinH/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-12-01T17:11:19Z","updated_at":"2025-12-01T17:13:04Z","body":"Also, am I correct that with this change all options to override the main loop are disabled by default? TASmaniac (linked above) currently overrides the main loop to sleep between frames (this is used together with --fixed-fps to get fully deterministic frame times while running the game in real time).","author_association":"NONE","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3597806098/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3597888069","html_url":"https://github.com/godotengine/godot/pull/111909#issuecomment-3597888069","issue_url":"https://api.github.com/repos/godotengine/godot/issues/111909","id":3597888069,"node_id":"IC_kwDOAO6SJc7Wc2pF","user":{"login":"bruvzg","id":7645683,"node_id":"MDQ6VXNlcjc2NDU2ODM=","avatar_url":"https://avatars.githubusercontent.com/u/7645683?v=4","gravatar_id":"","url":"https://api.github.com/users/bruvzg","html_url":"https://github.com/bruvzg","followers_url":"https://api.github.com/users/bruvzg/followers","following_url":"https://api.github.com/users/bruvzg/following{/other_user}","gists_url":"https://api.github.com/users/bruvzg/gists{/gist_id}","starred_url":"https://api.github.com/users/bruvzg/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/bruvzg/subscriptions","organizations_url":"https://api.github.com/users/bruvzg/orgs","repos_url":"https://api.github.com/users/bruvzg/repos","events_url":"https://api.github.com/users/bruvzg/events{/privacy}","received_events_url":"https://api.github.com/users/bruvzg/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-12-01T17:28:04Z","updated_at":"2025-12-01T17:28:04Z","body":"> I'm not sure I understand why this needed to be disabled by default, while override.cfg based injection points remain enabled by default.\r\n\r\nUnlike `--script`, `override.cfg` require adding files directly to the game folder, which (in case of reasonable setup) is only possible if deliberately done by the user or app with admin privileges.\r\n\r\nAlso, `override.cfg` can be disabled in the project settings as well.\r\n\r\n> Also, am I correct that with this change all options to override the main loop are disabled by default?\r\n\r\nYes, main loop override is disabled as well.\r\n\r\nAll these options existed for development purpose only, are still available in the editor builds, and can be enabled for a custom build.","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3597888069/reactions","total_count":2,"+1":2,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3597931141","html_url":"https://github.com/godotengine/godot/pull/111909#issuecomment-3597931141","issue_url":"https://api.github.com/repos/godotengine/godot/issues/111909","id":3597931141,"node_id":"IC_kwDOAO6SJc7WdBKF","user":{"login":"FeldrinH","id":5256211,"node_id":"MDQ6VXNlcjUyNTYyMTE=","avatar_url":"https://avatars.githubusercontent.com/u/5256211?v=4","gravatar_id":"","url":"https://api.github.com/users/FeldrinH","html_url":"https://github.com/FeldrinH","followers_url":"https://api.github.com/users/FeldrinH/followers","following_url":"https://api.github.com/users/FeldrinH/following{/other_user}","gists_url":"https://api.github.com/users/FeldrinH/gists{/gist_id}","starred_url":"https://api.github.com/users/FeldrinH/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/FeldrinH/subscriptions","organizations_url":"https://api.github.com/users/FeldrinH/orgs","repos_url":"https://api.github.com/users/FeldrinH/repos","events_url":"https://api.github.com/users/FeldrinH/events{/privacy}","received_events_url":"https://api.github.com/users/FeldrinH/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-12-01T17:35:50Z","updated_at":"2025-12-01T17:35:50Z","body":"> All these options existed for development purpose only, are still available in the editor builds, and can be enabled for a custom build.\r\n\r\nThat's kind of unfortunate for me, since I'm trying to mod games using release builds. I guess I'll have to see if I can make things work without control over the main loop.","author_association":"NONE","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3597931141/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3597945237","html_url":"https://github.com/godotengine/godot/pull/111909#issuecomment-3597945237","issue_url":"https://api.github.com/repos/godotengine/godot/issues/111909","id":3597945237,"node_id":"IC_kwDOAO6SJc7WdEmV","user":{"login":"Ivorforce","id":2308167,"node_id":"MDQ6VXNlcjIzMDgxNjc=","avatar_url":"https://avatars.githubusercontent.com/u/2308167?v=4","gravatar_id":"","url":"https://api.github.com/users/Ivorforce","html_url":"https://github.com/Ivorforce","followers_url":"https://api.github.com/users/Ivorforce/followers","following_url":"https://api.github.com/users/Ivorforce/following{/other_user}","gists_url":"https://api.github.com/users/Ivorforce/gists{/gist_id}","starred_url":"https://api.github.com/users/Ivorforce/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Ivorforce/subscriptions","organizations_url":"https://api.github.com/users/Ivorforce/orgs","repos_url":"https://api.github.com/users/Ivorforce/repos","events_url":"https://api.github.com/users/Ivorforce/events{/privacy}","received_events_url":"https://api.github.com/users/Ivorforce/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-12-01T17:38:35Z","updated_at":"2025-12-01T17:39:31Z","body":"> That's kind of unfortunate for me, since I'm trying to mod games using release builds. I guess I'll have to see if I can make things work without control over the main loop.\r\n\r\nSorry about making things more difficult for you!\r\nWhile we're removing features from release builds for security purposes, we are interested in working with mod (loader) authors such as you to bring those back in a secure way.\r\n\r\nIf you have been relying on main loop replacement, I want to encourage you to open a proposal to re-implement this in a wa