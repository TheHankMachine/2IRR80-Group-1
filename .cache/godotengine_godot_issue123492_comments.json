/users/m4gr3d/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-09-14T19:47:07Z","updated_at":"2026-09-14T19:47:07Z","body":"> @m4gr3d to clarify my understanding, by using an existing project with existing export presets is the debug.keystore not created?\n\nThe keystore should be created for projects with existing Android export presets.\nAre you running into an issue where that doesn't happen?","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5669836384/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5675405693","html_url":"https://github.com/godotengine/godot/issues/123492#issuecomment-5675405693","issue_url":"https://api.github.com/repos/godotengine/godot/issues/123492","id":5675405693,"node_id":"IC_kwDOAO6SJc8AAAABUkfRfQ","user":{"login":"comminux","id":14937307,"node_id":"MDQ6VXNlcjE0OTM3MzA3","avatar_url":"https://avatars.githubusercontent.com/u/14937307?v=4","gravatar_id":"","url":"https://api.github.com/users/comminux","html_url":"https://github.com/comminux","followers_url":"https://api.github.com/users/comminux/followers","following_url":"https://api.github.com/users/comminux/following{/other_user}","gists_url":"https://api.github.com/users/comminux/gists{/gist_id}","starred_url":"https://api.github.com/users/comminux/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/comminux/subscriptions","organizations_url":"https://api.github.com/users/comminux/orgs","repos_url":"https://api.github.com/users/comminux/repos","events_url":"https://api.github.com/users/comminux/events{/privacy}","received_events_url":"https://api.github.com/users/comminux/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-09-15T05:49:14Z","updated_at":"2026-09-15T05:49:14Z","body":"If I'm not mistaken, the last time I reinstalled Linux or Windows, I had to download Android Studio, create a new test project using a template, build it, and the necessary debug keys become available for Godot. ","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5675405693/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5677827557","html_url":"https://github.com/godotengine/godot/issues/123492#issuecomment-5677827557","issue_url":"https://api.github.com/repos/godotengine/godot/issues/123492","id":5677827557,"node_id":"IC_kwDOAO6SJc8AAAABUmzF5Q","user":{"login":"SoloRobo","id":20973406,"node_id":"MDQ6VXNlcjIwOTczNDA2","avatar_url":"https://avatars.githubusercontent.com/u/20973406?v=4","gravatar_id":"","url":"https://api.github.com/users/SoloRobo","html_url":"https://github.com/SoloRobo","followers_url":"https://api.github.com/users/SoloRobo/followers","following_url":"https://api.github.com/users/SoloRobo/following{/other_user}","gists_url":"https://api.github.com/users/SoloRobo/gists{/gist_id}","starred_url":"https://api.github.com/users/SoloRobo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/SoloRobo/subscriptions","organizations_url":"https://api.github.com/users/SoloRobo/orgs","repos_url":"https://api.github.com/users/SoloRobo/repos","events_url":"https://api.github.com/users/SoloRobo/events{/privacy}","received_events_url":"https://api.github.com/users/SoloRobo/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-09-15T09:23:20Z","updated_at":"2026-09-15T09:23:20Z","body":"@m4gr3d my project in particular appears to be using the Editor > Editor Settings > Export > Android > Debug Keystore which are all at defaults as this is a totally fresh Godot 4.8 dev 5 running on Linux.\n\nI don't see any Debug Keystore settings on a Project level.\n\nIt feels to me that the \"Setup Android Build...\" is perhaps getting ahead of itself and not running the keytool task after the built in Java is downloaded?","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5677827557/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5720161514","html_url":"https://github.com/godotengine/godot/issues/123492#issuecomment-5720161514","issue_url":"https://api.github.com/repos/godotengine/godot/issues/123492","id":5720161514,"node_id":"IC_kwDOAO6SJc8AAAABVPK86g","user":{"login":"m4gr3d","id":914968,"node_id":"MDQ6VXNlcjkxNDk2OA==","avatar_url":"https://avatars.githubusercontent.com/u/914968?v=4","gravatar_id":"","url":"https://api.github.com/users/m4gr3d","html_url":"https://github.com/m4gr3d","followers_url":"https://api.github.com/users/m4gr3d/followers","following_url":"https://api.github.com/users/m4gr3d/following{/other_user}","gists_url":"https://api.github.com/users/m4gr3d/gists{/gist_id}","starred_url":"https://api.github.com/users/m4gr3d/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/m4gr3d/subscriptions","organizations_url":"https://api.github.com/users/m4gr3d/orgs","repos_url":"https://api.github.com/users/m4gr3d/repos","events_url":"https://api.github.com/users/m4gr3d/events{/privacy}","received_events_url":"https://api.github.com/users/m4gr3d/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-09-17T19:39:44Z","updated_at":"2026-09-17T19:39:44Z","body":"> It feels to me that the \"Setup Android Build...\" is perhaps getting ahead of itself and not running the keytool task after the built in Java is downloaded?\n\n@SoloRobo The issue is being fixed in https://github.com/godotengine/godot/pull/123585.\n\n> [@m4gr3d](https://github.com/m4gr3d) my project in particular appears to be using the Editor > Editor Settings > Export > Android > Debug Keystore which are all at defaults as this is a totally fresh Godot 4.8 dev 5 running on Linux.\n> \n> I don't see any Debug Keystore settings on a Project level.\n\nThat's expected behavior. The export preset will prioritize the project defined debug keystore, but if that's not defined, it'll fall back to the one defined in the editor settings.\nNote that this does not apply to the release keystore, which is only defined at the project level and doesn't have a fallback.","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5720161514/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5720671552","html_url":"https://github.com/godotengine/godot/issues/123492#issuecomment-5720671552","issue_url":"https://api.github.com/repos/godotengine/godot/issues/123492","id":5720671552,"node_id":"IC_kwDOAO6SJc8AAAABVPqFQA","user":{"login":"SoloRobo","id":20973406,"node_id":"MDQ6VXNlcjIwOTczNDA2","avatar_url":"https://avatars.githubusercontent.com/u/20973406?v=4","gravatar_id":"","url":"https://api.github.com/users/SoloRobo","html_url":"https://github.com/SoloRobo","followers_url":"https://api.github.com/users/SoloRobo/followers","following_url":"https://api.github.com/users/SoloRobo/following{/other_user}","gists_url":"https://api.github.com/users/SoloRobo/gists{/gist_id}","starred_url":"https://api.github.com/users/SoloRobo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/SoloRobo/subscriptions","organizations_url":"https://api.github.com/users/SoloRobo/orgs","repos_url":"https://api.github.com/users/SoloRobo/repos","events_url":"https://api.github.com/users/SoloRobo/events{/privacy}","received_events_url":"https://api.github.com/users/SoloRobo/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-09-17T20:18:29Z","updated_at":"2026-09-17T20:18:29Z","body":"> That's expected behavior. The export preset will prioritize the project defined debug keystore, but if that's not defined, it'll fall back to the one defined in the editor settings.\n\n@m4gr3d thank you, this reply prompted me to find and subsequently locate the per project debug store in the Export settings when enabling \"Advanced Options\"","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5720671552/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null}]