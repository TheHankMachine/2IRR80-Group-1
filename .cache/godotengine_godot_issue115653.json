ame":"topic:rendering","color":"ffee88","default":false,"description":"","archived_at":null,"archived_by":null}],"state":"closed","locked":false,"assignees":[],"milestone":{"url":"https://api.github.com/repos/godotengine/godot/milestones/25","html_url":"https://github.com/godotengine/godot/milestone/25","labels_url":"https://api.github.com/repos/godotengine/godot/milestones/25/labels","id":15520464,"node_id":"MI_kwDOAO6SJc4A7NLQ","number":25,"title":"4.8","description":"","creator":{"login":"Repiteo","id":17489292,"node_id":"MDQ6VXNlcjE3NDg5Mjky","avatar_url":"https://avatars.githubusercontent.com/u/17489292?v=4","gravatar_id":"","url":"https://api.github.com/users/Repiteo","html_url":"https://github.com/Repiteo","followers_url":"https://api.github.com/users/Repiteo/followers","following_url":"https://api.github.com/users/Repiteo/following{/other_user}","gists_url":"https://api.github.com/users/Repiteo/gists{/gist_id}","starred_url":"https://api.github.com/users/Repiteo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Repiteo/subscriptions","organizations_url":"https://api.github.com/users/Repiteo/orgs","repos_url":"https://api.github.com/users/Repiteo/repos","events_url":"https://api.github.com/users/Repiteo/events{/privacy}","received_events_url":"https://api.github.com/users/Repiteo/received_events","type":"User","user_view_type":"public","site_admin":false},"open_issues":346,"closed_issues":2304,"state":"open","created_at":"2026-04-13T15:59:35Z","updated_at":"2026-10-21T09:34:58Z","due_on":null,"closed_at":null},"comments":13,"created_at":"2026-01-30T21:25:21Z","updated_at":"2026-10-15T10:06:26Z","closed_at":"2026-09-22T15:21:21Z","assignee":null,"author_association":"CONTRIBUTOR","issue_field_values":[],"type":null,"active_lock_reason":null,"draft":false,"pull_request":{"url":"https://api.github.com/repos/godotengine/godot/pulls/115653","html_url":"https://github.com/godotengine/godot/pull/115653","diff_url":"https://github.com/godotengine/godot/pull/115653.diff","patch_url":"https://github.com/godotengine/godot/pull/115653.patch","merged_at":"2026-09-22T15:21:21Z"},"body":"This is a feature enhancement for DrawableTextures, based on Rendering Meeting conversations with @QbieShay. \r\n\r\nThe desired behavior was to use DrawableTextures to animate Decals, however because Decals are read from a Decal Atlas, blits to the DrawableTexture would not update the Atlas unless fully rebuilt. This PR adds new methods, in both rendering servers, to allow redrawing singular textures in the Atlas without a full rebuild. This is currently only invoked by Drawable_Texture_Blit_Rect, but could also be useful for other cases where an Atlas uses a Texture that may have its data changed, such as [Texture Update Partial](https://github.com/godotengine/godot/pull/109985)\r\n\r\n[draw-decal.zip](https://github.com/user-attachments/files/24974407/draw-decal.zip)\r\nAttached is a minimal project featuring DrawableTextures being synced to a Decal Atlas - Decal Atlas instantiates new Decals, each of which with their own DrawableTexture being faded by periodic Blit_rect calls.\r\n","closed_by":{"login":"Repiteo","id":17489292,"node_id":"MDQ6VXNlcjE3NDg5Mjky","avatar_url":"https://avatars.githubusercontent.com/u/17489292?v=4","gravatar_id":"","url":"https://api.github.com/users/Repiteo","html_url":"https://github.com/Repiteo","followers_url":"https://api.github.com/users/Repiteo/followers","following_url":"https://api.github.com/users/Repiteo/following{/other_user}","gists_url":"https://api.github.com/users/Repiteo/gists{/gist_id}","starred_url":"https://api.github.com/users/Repiteo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Repiteo/subscriptions","organizations_url":"https://api.github.com/users/Repiteo/orgs","repos_url":"https://api.github.com/users/Repiteo/repos","events_url":"https://api.github.com/users/Repiteo/events{/privacy}","received_events_url":"https://api.github.com/users/Repiteo/r