347,"node_id":"MDQ6VXNlcjUxMzgzNDc=","avatar_url":"https://avatars.githubusercontent.com/u/5138347?v=4","gravatar_id":"","url":"https://api.github.com/users/krishnabm","html_url":"https://github.com/krishnabm","followers_url":"https://api.github.com/users/krishnabm/followers","following_url":"https://api.github.com/users/krishnabm/following{/other_user}","gists_url":"https://api.github.com/users/krishnabm/gists{/gist_id}","starred_url":"https://api.github.com/users/krishnabm/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/krishnabm/subscriptions","organizations_url":"https://api.github.com/users/krishnabm/orgs","repos_url":"https://api.github.com/users/krishnabm/repos","events_url":"https://api.github.com/users/krishnabm/events{/privacy}","received_events_url":"https://api.github.com/users/krishnabm/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-07-01T10:36:29Z","updated_at":"2025-07-01T10:36:29Z","body":"> Copy Property Path copies a string, so it uses the OS clipboard.\n> \n> Copy Value could be any Variant value, so the copied value is indeed stored inside the editor instead. The value can only be access by the \"Paste Value\" menu item. So this is not a bug. See [#39404](https://github.com/godotengine/godot/pull/39404).\n\nThat's fair, I am able to paste this in a `StringName` field. This may not be a bug, however I feel there is some functionality missing. In my provided MRP, if you were to copy a Dictionary/Array element's numerical value, there is currently no way to do this.\n\nFor example, here I am unable to copy a large number at debug time -\n(This doesn't work for the string value \"678\" either, but I am able to highlight the string field and copy it using Ctrl+C, which is a workaround)\n![Image](https://github.com/user-attachments/assets/470a438d-e9bc-4d87-92ef-850a6f73924e)\n\nThis _seems_ like a bug since the Copy command is enabled but doesn't copy to either the OS Clipboard of the engine's copy buffer.\nLet me know if I should create a new Issue/Proposal or whatever would be the right way to address this.","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3023300729/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3026109878","html_url":"https://github.com/godotengine/godot/issues/108139#issuecomment-3026109878","issue_url":"https://api.github.com/repos/godotengine/godot/issues/108139","id":3026109878,"node_id":"IC_kwDOAO6SJc60XsW2","user":{"login":"timothyqiu","id":372476,"node_id":"MDQ6VXNlcjM3MjQ3Ng==","avatar_url":"https://avatars.githubusercontent.com/u/372476?v=4","gravatar_id":"","url":"https://api.github.com/users/timothyqiu","html_url":"https://github.com/timothyqiu","followers_url":"https://api.github.com/users/timothyqiu/followers","following_url":"https://api.github.com/users/timothyqiu/following{/other_user}","gists_url":"https://api.github.com/users/timothyqiu/gists{/gist_id}","starred_url":"https://api.github.com/users/timothyqiu/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/timothyqiu/subscriptions","organizations_url":"https://api.github.com/users/timothyqiu/orgs","repos_url":"https://api.github.com/users/timothyqiu/repos","events_url":"https://api.github.com/users/timothyqiu/events{/privacy}","received_events_url":"https://api.github.com/users/timothyqiu/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-07-02T02:11:08Z","updated_at":"2025-07-02T02:11:08Z","body":"Text copying works as long as it's a LineEdit.\n\nhttps://github.com/user-attachments/assets/af2e5c23-5d34-4f97-b697-b2ab7c1acfe0\n\nI think the only problem here is that there is no way to copy read-only numeric values since the control (EditorSpinSlider) is custom drawn. Regular text selection does not work and there is no context menu available.\n\nI suggest opening a dedicated issue for that.","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3026109878/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3026772463","html_url":"https://github.com/godotengine/godot/issues/108139#issuecomment-3026772463","issue_url":"https://api.github.com/repos/godotengine/godot/issues/108139","id":3026772463,"node_id":"IC_kwDOAO6SJc60aOHv","user":{"login":"krishnabm","id":5138347,"node_id":"MDQ6VXNlcjUxMzgzNDc=","avatar_url":"https://avatars.githubusercontent.com/u/5138347?v=4","gravatar_id":"","url":"https://api.github.com/users/krishnabm","html_url":"https://github.com/krishnabm","followers_url":"https://api.github.com/users/krishnabm/followers","following_url":"https://api.github.com/users/krishnabm/following{/other_user}","gists_url":"https://api.github.com/users/krishnabm/gists{/gist_id}","starred_url":"https://api.github.com/users/krishnabm/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/krishnabm/subscriptions","organizations_url":"https://api.github.com/users/krishnabm/orgs","repos_url":"https://api.github.com/users/krishnabm/repos","events_url":"https://api.github.com/users/krishnabm/events{/privacy}","received_events_url":"https://api.github.com/users/krishnabm/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-07-02T07:31:44Z","updated_at":"2025-07-02T07:31:44Z","body":"> Text copying works as long as it's a LineEdit.\n> Peek.2025-07-02.10-00.mp4\n> \n> I think the only problem here is that there is no way to copy read-only numeric values since the control (EditorSpinSlider) is cust