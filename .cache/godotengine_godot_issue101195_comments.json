[{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2574167487","html_url":"https://github.com/godotengine/godot/issues/101195#issuecomment-2574167487","issue_url":"https://api.github.com/repos/godotengine/godot/issues/101195","id":2574167487,"node_id":"IC_kwDOAO6SJc6Zbq2_","user":{"login":"DinoMC","id":9079110,"node_id":"MDQ6VXNlcjkwNzkxMTA=","avatar_url":"https://avatars.githubusercontent.com/u/9079110?v=4","gravatar_id":"","url":"https://api.github.com/users/DinoMC","html_url":"https://github.com/DinoMC","followers_url":"https://api.github.com/users/DinoMC/followers","following_url":"https://api.github.com/users/DinoMC/following{/other_user}","gists_url":"https://api.github.com/users/DinoMC/gists{/gist_id}","starred_url":"https://api.github.com/users/DinoMC/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/DinoMC/subscriptions","organizations_url":"https://api.github.com/users/DinoMC/orgs","repos_url":"https://api.github.com/users/DinoMC/repos","events_url":"https://api.github.com/users/DinoMC/events{/privacy}","received_events_url":"https://api.github.com/users/DinoMC/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-01-07T00:30:45Z","updated_at":"2025-01-07T00:31:09Z","body":"Can confirm.\nAlso happens if the physics interpolation is enabled at startup, but you disable it temporarily (eg. to scroll instantly) and reenable it at runtime.\nDisabling and reenabling the camera also makes it work again in my case (thus, no need to keep on calling force_update_scroll())","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2574167487/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2574281694","html_url":"https://github.com/godotengine/godot/issues/101195#issuecomment-2574281694","issue_url":"https://api.github.com/repos/godotengine/godot/issues/101195","id":2574281694,"node_id":"IC_kwDOAO6SJc6ZcGve","user":{"login":"KeyboardDanni","id":34800072,"node_id":"MDQ6VXNlcjM0ODAwMDcy","avatar_url":"https://avatars.githubusercontent.com/u/34800072?v=4","gravatar_id":"","url":"https://api.github.com/users/KeyboardDanni","html_url":"https://github.com/KeyboardDanni","followers_url":"https://api.github.com/users/KeyboardDanni/followers","following_url":"https://api.github.com/users/KeyboardDanni/following{/other_user}","gists_url":"https://api.github.com/users/KeyboardDanni/gists{/gist_id}","starred_url":"https://api.github.com/users/KeyboardDanni/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/KeyboardDanni/subscriptions","organizations_url":"https://api.github.com/users/KeyboardDanni/orgs","repos_url":"https://api.github.com/users/KeyboardDanni/repos","events_url":"https://api.github.com/users/KeyboardDanni/events{/privacy}","received_events_url":"https://api.github.com/users/KeyboardDanni/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-01-07T02:38:42Z","updated_at":"2025-01-07T02:40:30Z","body":"No need to disable all of physics interpolation to teleport the camera. You should just be able to call `reset_physics_interpolation()` on the camera after you move it.","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2574281694/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2575106126","html_url":"https://github.com/godotengine/godot/issues/101195#issuecomment-2575106126","issue_url":"https://api.github.com/repos/godotengine/godot/issues/101195","id":2575106126,"node_id":"IC_kwDOAO6SJc6ZfQBO","user":{"login":"lawnjelly","id":21999379,"node_id":"MDQ6VXNlcjIxOTk5Mzc5","avatar_url":"https://avatars.githubusercontent.com/u/21999379?v=4","gravatar_id":"","url":"https://api.github.com/users/lawnjelly","html_url":"https://github.com/lawnjelly","followers_url":"https://api.github.com/users/lawnjelly/followers","following_url":"https://api.github.com/users/lawnjelly/following{/other_user}","gists_url":"https://api.github.com/users/lawnjelly/gists{/gist_id}","starred_url":"https://api.github.com/users/lawnjelly/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/lawnjelly/subscriptions","organizations_url":"https://api.github.com/users/lawnjelly/orgs","repos_url":"https://api.github.com/users/lawnjelly/repos","events_url":"https://api.github.com/users/lawnjelly/events{/privacy}","received_events_url":"https://api.github.com/users/lawnjelly/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-01-07T11:58:05Z","updated_at":"2025-01-07T11:58:05Z","body":"Same as #101192 this isn't strictly speaking supported, but I'll try and have a look if there's an easy fix.","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2575106126/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2575343375","html_url":"https://github.com/godotengine/godot/issues/101195#issuecomment-2575343375","issue_url":"https://api.github.com/repos/godotengine/godot/issues/101195","id":2575343375,"node_id":"IC_kwDOAO6SJc6ZgJ8P","user":{"login":"lawnjelly","id":21999379,"node_id":"MDQ6VXNlcjIxOTk5Mzc5","avatar_url":"https://avatars.githubusercontent.com/u/21999379?v=4","gravatar_id":"","url":"https://api.github.com/users/lawnjelly","html_url":"https://github.com/lawnjelly","followers_url":"https://api.github.com/users/lawnjelly/followers","following_url":"https://api.github.com/users/lawnjelly/following{/other_user}","gists_url":"https://api.github.com/users/lawnjelly/gists{/gist_id}","starred_url":"https://api.github.com/users/lawnjelly/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/lawnjelly/subscriptions","organizations_url":"https://api.github.com/users/lawnjelly/orgs","repos_url":"https://api.github.com/users/lawnjelly/repos","events_url":"https://api.github.com/users/lawnjelly/events{/privacy}","received_events_url":"https://api.github.com/users/lawnjelly/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-01-07T13:50:35Z","updated_at":"2025-01-07T15:19:36Z","body":"If you do this using by toggling `physics_interpolation_mode` on the root rather than using the `SceneTree`, it works.\n\nAlso if you do this with the `SceneTree`, if you add a `make_current()` to the camera after changing the interpolation global switch, it seems to work.\n\nI'll see if I can add a small PR to do this automatically.\n\nThe reason is that the process modes get set when making the camera current (according to whether interpolation is active or not), and setting the global switch bypasses this state change.\n\nUPDATE:\nI can't yet replicate this in 3.x, maybe there is something I have missed about the project.\nIf you can produce MRP in 3.x I can fix.\n\nIt could be I'm missing something converting the MRP, or maybe there is some small difference between 3.x and 4.x here. If there is a difference, it seems adding the `make_current()` to force `_update_process_mode()` will do the trick.\n\nUPDATE:\nAh, got it, it has to start with physics interpolation disabled. Sorry I had to convert the project manually by looking at the project files, must have missed this. Will fix. 👍 \n\nIt's actually a pain in the behind in 3.x because getting the current 2D cameras is not supported.. 😁 \nMaster has #38317 .\nMight have to backport something like that, or just document to use the root method at runtime rather than the global switch. 🤔 Unless there's another way can come up with.","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2575343375/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2692360438","html_url":"https://github.com/godotengine/godot/issues/101195#issuecomment-2692360438","issue_url":"https://api.github.com/repos/godotengine/godot/issues/101195","id":2692360438,"node_id":"IC_kwDOAO6SJc6geij2","user":{"login":"jonycase","id":143220519,"node_id":"U_kgDOCIlfJw","avatar_url":"https://avatars.githubusercontent.com/u/143220519?v=4","gravatar_id":"","url":"https://api.github.com/users/jonycase","html_url":"https://github.com/jonycase","followers_url":"https://api.github.com/users/jonycase/followers","following_url":"https://api.github.com/users/jonycase/following{/other_user}","gists_url":"https://api.github.com/users/jonycase/gists{/gist_id}","starred_url":"https://api.github.com/users/jonycase/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/jonycase/subscriptions","organizations_url":"https://api.github.com/users/jonycase/orgs","repos_url":"https://api.github.com/users/jonycase/repos","events_url":"https://api.github.com/users/jonycase/events{/privacy}","received_events_url":"https://api.github.com/users/jonycase/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-03-01T18:39:51Z","updated_at":"2025-03-01T18:39:51Z","body":"+1 \noccurs in 4.4 rc3","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2692360438/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2869137998","html_url":"https://github.com/godotengine/godot/issues/101195#issuecomment-2869137998","issue_url":"https://api.github.com/repos/godotengine/godot/issues/101195","id":2869137998,"node_id":"IC_kwDOAO6SJc6rA5JO","user":{"login":"ansdor","id":5995577,"node_id":"MDQ6VXNlcjU5OTU1Nzc=","avatar_url":"https://avatars.githubusercontent.com/u/5995577?v=4","gravatar_id":"","url":"https://api.github.com/users/ansdor","html_url":"https://github.com/ansdor","followers_url":"https://api.github.com/users/ansdor/followers","following_url":"https://api.github.com/users/ansdor/following{/other_user}","gists_url":"https://api.github.com/users/ansdor/gists{/gist_id}","starred_url":"https://api.github.com/users/ansdor/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/ansdor/subscriptions","organizations_url":"https://api.github.com/users/ansdor/orgs","repos_url":"https://api.github.com/users/ansdor/repos","events_url":"https://api.github.com/users/ansdor/events{/privacy}","received_events_url":"https://api.github.com/users/ansdor/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-05-10T20:13:44Z","updated_at":"2025-05-10T20:13:44Z","body":"this is happening to me too. my case is a little different, I have the camera being moved by an AnimationPlayer, but it also doesn't work unless I disable physics interpolation in the Camera2D node, but then it becomes jittery\n\nadding a call to reset_physics_interpolation() on the camera solves the problem","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2869137998/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2870269392","html_url":"https://github.com/godotengine/godot/issues/101195#issuecomment-2870269392","issue_url":"https://api.github.com/repos/godotengine/godot/issues/101195","id":2870269392,"node_id":"IC_kwDOAO6SJc6rFNXQ","user":{"login":"KeyboardDanni","id":34800072,"node_id":"MDQ6VXNlcjM0ODAwMDcy","avatar_url":"https://avatars.githubusercontent.com/u/34800072?v=4","gravatar_id":"","url":"https://api.github.com/users/KeyboardDanni","html_url":"https://github.com/KeyboardDanni","followers_url":"https://api.github.com/users/KeyboardDanni/followers","following_url":"https://api.github.com/users/KeyboardDanni/following{/other_user}","gists_url":"https://api.github.com/users/KeyboardDanni/gists{/gist_id}","starred_url":"https://api.github.com/users/KeyboardDanni/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/KeyboardDanni/subscriptions","organizations_url":"https://api.github.com/users/KeyboardDanni/orgs","repos_url":"https://api.github.com/users/KeyboardDanni/repos","events_url":"https://api.github.com/users/KeyboardDanni/events{/privacy}","received_events_url":"https://api.github.com/users/KeyboardDanni/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-05-11T23:06:14Z","updated_at":"2025-05-11T23:06:14Z","body":"Hey, I'm currently consolidating important 2D sidescroller-related fixes in a custom fork (so far it includes #101245 and #100031, and I hope to add more as time goes on). It's called Godot for Sidescrollers and you can find it [here](https://github.com/KeyboardDanni/godot-for-sidescrollers). Please let me know what you think, and let me know if there's anything else you'd like me to include!\n\nI'd like to request that this issue get more attention from the Godot maintainers. Right now the only physics interpolation maintainer appears to be busy with 3D interpolation. I had a patch that fixed this issue before it was unceremoniously closed without my input.\n\nCan we also get this issue tagged as a bug, please?","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2870269392/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2870448307","html_url":"https://github.com/godotengine/godot/issues/101195#issuecomment-2870448307","issue_url":"https://api.github.com/repos/godotengine/godot/issues/101195","id":2870448307,"node_id":"IC_kwDOAO6SJc6rF5Cz","user":{"login":"KeyboardDanni","id":34800072,"node_id":"MDQ6VXNlcjM0ODAwMDcy","avatar_url":"https://avatars.githubusercontent.com/u/34800072?v=4","gravatar_id":"","url":"https://api.github.com/users/KeyboardDanni","html_url":"https://github.com/KeyboardDanni","followers_url":"https://api.github.com/users/KeyboardDanni/followers","following_url":"https://api.github.com/users/KeyboardDanni/following{/other_user}","gists_url":"https://api.github.com/users/KeyboardDanni/gists{/gist_id}","starred_url":"https://api.github.com/users/KeyboardDanni/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/KeyboardDanni/subscriptions","organizations_url":"https://api.github.com/users/KeyboardDanni/orgs","repos_url":"https://api.github.com/users/KeyboardDanni/repos","events_url":"https://api.github.com/users/KeyboardDanni/events{/privacy}","received_events_url":"https://api.github.com/users/KeyboardDanni/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-05-12T01:12:04Z","updated_at":"2025-05-12T01:12:04Z","body":"@ansdor Do you think you could provide an MRP of the issue you're facing?","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2870448307/reactions","total_count":0,"+1":0,"-1"