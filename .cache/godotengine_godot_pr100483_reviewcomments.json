as/repos","events_url":"https://api.github.com/users/kiroxas/events{/privacy}","received_events_url":"https://api.github.com/users/kiroxas/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"Maybe assign nullptr to p_name in both cases ? Or else the caller is still valid after the call, which is fine by move standard, but could be error prone.","created_at":"2024-12-17T11:03:36Z","updated_at":"2024-12-17T11:07:19Z","html_url":"https://github.com/godotengine/godot/pull/100483#discussion_r1888327809","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/100483","_links":{"self":{"href":"https://api.github.com/repos/godotengine/godot/pulls/comments/1888327809"},"html":{"href":"https://github.com/godotengine/godot/pull/100483#discussion_r1888327809"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/100483"}},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/1888327809/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":199,"original_line":199,"side":"RIGHT","in_reply_to_id":1888321414,"author_association":"CONTRIBUTOR","original_position":12,"position":12,"subject_type":"line"},{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/1888339951","pull_request_review_id":2508581226,"id":1888339951,"node_id":"PRRC_kwDOAO6SJc5wjcfv","diff_hunk":"@@ -188,8 +188,22 @@ class StringName {\n \t};\n \n \tStringName &operator=(const StringName &p_name);\n+\tStringName &operator=(StringName &&p_name) {\n+\t\tif (_data == p_name._data) {\n+\t\t\treturn *this;\n+\t\t}\n+\n+\t\tunref();\n+\t\t_data = p_name._data;\n+\t\tp_name._data = nullptr;\n+\t\treturn *this;","path":"core/string/string_name.h","commit_id":"8c4e674770c0eaecae55ca5433d72b18e196956f","original_commit_id":"8c4e674770c0eaecae55ca5433d72b18e196956f","user":{"login":"Ivorforce","id":2308167,"node_id":"MDQ6VXNlcjIzMDgxNjc=","avatar_url":"https://avatars.githubusercontent.com/u/2308167?v=4","gravatar_id":"","url":"https://api.github.com/users/Ivorforce","html_url":"https://github.com/Ivorforce","followers_url":"https://api.github.com/users/Ivorforce/followers","following_url":"https://api.github.com/users/Ivorforce/following{/other_user}","gists_url":"https://api.github.com/users/Ivorforce/gists{/gist_id}","starred_url":"https://api.github.com/users/Ivorforce/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Ivorforce/subscriptions","organizations_url":"https://api.github.com/users/Ivorforce/orgs","repos_url":"https://api.github.com/users/Ivorforce/repos","events_url":"https://api.github.com/users/Ivorforce/events{/privacy}","received_events_url":"https://api.github.com/users/Ivorforce/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"`nullptr` cannot be assigned to the caller because the `if (_data != p_name._data) {` test covers `this == &p_name` - so we could accidentally be setting our own pointer to `nullptr` accidentally. Besides, if we set its data to `nullptr` without taking ownership of it, we would need to `unref` it. `move` semantics aren't guaranteed to destruct the param anyway, but they _are_ guaranteed to keep it in a valid state.\r\nRegarding your code change suggestion, like last time I still prefer early exit to indented blocks :)","created_at":"2024-12-17T11:12:55Z","updated_at":"2024-12-17T11:14:23Z","html_url":"https://github.com/godotengine/godot/pull/100483#discussion_r1888339951","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/100483","_links":{"self":{"href":"https://api.github.com/repos/godotengine/godot/pulls/comments/1888339951"},"html":{"href":"https://github.com/godotengine/godot/pull/100483#discussion_r1888339951"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/100483"}},"reactions":{"url":"http