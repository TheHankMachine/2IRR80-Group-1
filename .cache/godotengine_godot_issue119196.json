y":null},{"id":279098255,"node_id":"MDU6TGFiZWwyNzkwOTgyNTU=","url":"https://api.github.com/repos/godotengine/godot/labels/topic:platforms","name":"topic:platforms","color":"ffee88","default":false,"description":"","archived_at":null,"archived_by":null}],"state":"closed","locked":false,"assignees":[],"milestone":{"url":"https://api.github.com/repos/godotengine/godot/milestones/25","html_url":"https://github.com/godotengine/godot/milestone/25","labels_url":"https://api.github.com/repos/godotengine/godot/milestones/25/labels","id":15520464,"node_id":"MI_kwDOAO6SJc4A7NLQ","number":25,"title":"4.8","description":"","creator":{"login":"Repiteo","id":17489292,"node_id":"MDQ6VXNlcjE3NDg5Mjky","avatar_url":"https://avatars.githubusercontent.com/u/17489292?v=4","gravatar_id":"","url":"https://api.github.com/users/Repiteo","html_url":"https://github.com/Repiteo","followers_url":"https://api.github.com/users/Repiteo/followers","following_url":"https://api.github.com/users/Repiteo/following{/other_user}","gists_url":"https://api.github.com/users/Repiteo/gists{/gist_id}","starred_url":"https://api.github.com/users/Repiteo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Repiteo/subscriptions","organizations_url":"https://api.github.com/users/Repiteo/orgs","repos_url":"https://api.github.com/users/Repiteo/repos","events_url":"https://api.github.com/users/Repiteo/events{/privacy}","received_events_url":"https://api.github.com/users/Repiteo/received_events","type":"User","user_view_type":"public","site_admin":false},"open_issues":342,"closed_issues":2335,"state":"open","created_at":"2026-04-13T15:59:35Z","updated_at":"2026-10-22T05:57:34Z","due_on":null,"closed_at":null},"comments":4,"created_at":"2026-05-03T14:33:46Z","updated_at":"2026-07-06T15:14:34Z","closed_at":"2026-06-26T13:55:22Z","assignee":null,"author_association":"CONTRIBUTOR","issue_field_values":[],"type":null,"active_lock_reason":null,"draft":false,"pull_request":{"url":"https://api.github.com/repos/godotengine/godot/pulls/119196","html_url":"https://github.com/godotengine/godot/pull/119196","diff_url":"https://github.com/godotengine/godot/pull/119196.diff","patch_url":"https://github.com/godotengine/godot/pull/119196.patch","merged_at":"2026-06-26T13:55:22Z"},"body":"macOS supports display cutouts like iOS and Android. Particularly newer MacBooks have a notch on the top edge of the screen, and the screen area left and right of the notch cannot be occupied by applications. \r\n\r\nThe implementation of `DisplayServer::get_display_safe_area` differs from `DisplayServer::screen_get_usable_rect` in that the former only subtracts physical insets from the screen rectangle, while the latter returns the area of the screen that is not covered by the system UI elements (status bar and dock).\r\n\r\nUsing `DisplayServer::get_display_safe_area` is now the simplest way to get the correct size or aspect ratio of a full-screen window on macOS.\r\n\r\n\r\nBefore, with the fallback to `screen_get_usable_rect`:\r\n<img width=\"1800\" height=\"1169\" alt=\"Screenshot 2026-05-03 at 16 28 01\" src=\"https://github.com/user-attachments/assets/6cd80637-af80-4397-a882-34b051db9464\" />\r\n\r\nAfter, with inset based implementation:\r\n<img width=\"1800\" height=\"1169\" alt=\"Screenshot 2026-05-03 at 16 27 13\" src=\"https://github.com/user-attachments/assets/a7e5b021-bc57-42fe-a7c1-7f6e39904861\" />\r\n\r\n(The example uses a system dock that is positioned on the left side of the screen. This results in the usable rect width being reduced.)","closed_by":{"login":"Repiteo","id":17489292,"node_id":"MDQ6VXNlcjE3NDg5Mjky","avatar_url":"https://avatars.githubusercontent.com/u/17489292?v=4","gravatar_id":"","url":"https://api.github.com/users/Repiteo","html_url":"https://github.com/Repiteo","followers_url":"https://api.github.com/users/Repiteo/followers","following_url":"https://api.github.com/users/Repiteo/following{/other_user}","gists_url":"https://api.github.com/users/Repiteo/gists{/gist_id}","starred_url":"https://api.github.com/users/Repiteo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Repiteo/subscriptions","organizations_url":"https://api.github.com/users/Repiteo/orgs","repos_url":"https://api.github.com/users/Repiteo/repos","events_url":"https://api.github.com/users/Repiteo/events{/privacy}","received_events_url":"https://api.github.com/users/Repiteo/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/119196/reactions","total_count":2,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":1},"timeline_url":"https://api.github.com/repos/godotengine/godot/issues/119196/timeline","performed_via_github_app":null,"state_reason":null}