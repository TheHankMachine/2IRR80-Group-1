[{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5121878914","html_url":"https://github.com/godotengine/godot/issues/121896#issuecomment-5121878914","issue_url":"https://api.github.com/repos/godotengine/godot/issues/121896","id":5121878914,"node_id":"IC_kwDOAO6SJc8AAAABMUmrgg","user":{"login":"smix8","id":52464204,"node_id":"MDQ6VXNlcjUyNDY0MjA0","avatar_url":"https://avatars.githubusercontent.com/u/52464204?v=4","gravatar_id":"","url":"https://api.github.com/users/smix8","html_url":"https://github.com/smix8","followers_url":"https://api.github.com/users/smix8/followers","following_url":"https://api.github.com/users/smix8/following{/other_user}","gists_url":"https://api.github.com/users/smix8/gists{/gist_id}","starred_url":"https://api.github.com/users/smix8/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/smix8/subscriptions","organizations_url":"https://api.github.com/users/smix8/orgs","repos_url":"https://api.github.com/users/smix8/repos","events_url":"https://api.github.com/users/smix8/events{/privacy}","received_events_url":"https://api.github.com/users/smix8/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-07-29T18:22:57Z","updated_at":"2026-07-29T18:22:57Z","body":"You need to wait for the server region and map syncs else your map graph is still empty and has no navmesh geometry, aka your path is empty.\n\nThe regions and maps are running  async iteration updates on threads by default in newer Godot versions.\nThread tasks and joins naturally create a delay because they break out from the main thread loop.\n\nIf you want the old main-thread behavior back you can disable the thread use in the ProjectSettings or by using the NavigationServer API to toggle it for specific maps and regions. Search for async iterations in the Editor build-in documentation and you see all the related functions and settings.","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url"