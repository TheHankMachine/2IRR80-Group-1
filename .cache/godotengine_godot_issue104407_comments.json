[{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2746800812","html_url":"https://github.com/godotengine/godot/pull/104407#issuecomment-2746800812","issue_url":"https://api.github.com/repos/godotengine/godot/issues/104407","id":2746800812,"node_id":"IC_kwDOAO6SJc6juNqs","user":{"login":"BenLubar","id":4257305,"node_id":"MDQ6VXNlcjQyNTczMDU=","avatar_url":"https://avatars.githubusercontent.com/u/4257305?v=4","gravatar_id":"","url":"https://api.github.com/users/BenLubar","html_url":"https://github.com/BenLubar","followers_url":"https://api.github.com/users/BenLubar/followers","following_url":"https://api.github.com/users/BenLubar/following{/other_user}","gists_url":"https://api.github.com/users/BenLubar/gists{/gist_id}","starred_url":"https://api.github.com/users/BenLubar/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/BenLubar/subscriptions","organizations_url":"https://api.github.com/users/BenLubar/orgs","repos_url":"https://api.github.com/users/BenLubar/repos","events_url":"https://api.github.com/users/BenLubar/events{/privacy}","received_events_url":"https://api.github.com/users/BenLubar/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-03-24T03:39:43Z","updated_at":"2025-03-24T03:39:43Z","body":"@AThousandShips it looks like the Windows/editor/llvm build needs a retry.","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2746800812/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3530366202","html_url":"https://github.com/godotengine/godot/pull/104407#issuecomment-3530366202","issue_url":"https://api.github.com/repos/godotengine/godot/issues/104407","id":3530366202,"node_id":"IC_kwDOAO6SJc7SbRz6","user":{"login":"apples","id":2352020,"node_id":"MDQ6VXNlcjIzNTIwMjA=","avatar_url":"https://avatars.githubusercontent.com/u/2352020?v=4","gravatar_id":"","url":"https://api.github.com/users/apples","html_url":"https://github.com/apples","followers_url":"https://api.github.com/users/apples/followers","following_url":"https://api.github.com/users/apples/following{/other_user}","gists_url":"https://api.github.com/users/apples/gists{/gist_id}","starred_url":"https://api.github.com/users/apples/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/apples/subscriptions","organizations_url":"https://api.github.com/users/apples/orgs","repos_url":"https://api.github.com/users/apples/repos","events_url":"https://api.github.com/users/apples/events{/privacy}","received_events_url":"https://api.github.com/users/apples/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-11-14T01:00:48Z","updated_at":"2025-11-14T01:00:48Z","body":"Just rebased and tested this, it seems to work well!\r\n\r\nThis is necessary for implementing custom tilemaps that match the behavior of TileMapLayer.","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3530366202/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3567084619","html_url":"https://github.com/godotengine/godot/pull/104407#issuecomment-3567084619","issue_url":"https://api.github.com/repos/godotengine/godot/issues/104407","id":3567084619,"node_id":"IC_kwDOAO6SJc7UnWRL","user":{"login":"Ivorforce","id":2308167,"node_id":"MDQ6VXNlcjIzMDgxNjc=","avatar_url":"https://avatars.githubusercontent.com/u/2308167?v=4","gravatar_id":"","url":"https://api.github.com/users/Ivorforce","html_url":"https://github.com/Ivorforce","followers_url":"https://api.github.com/users/Ivorforce/followers","following_url":"https://api.github.com/users/Ivorforce/following{/other_user}","gists_url":"https://api.github.com/users/Ivorforce/gists{/gist_id}","starred_url":"https://api.github.com/users/Ivorforce/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Ivorforce/subscriptions","organizations_url":"https://api.github.com/users/Ivorforce/orgs","repos_url":"https://api.github.com/users/Ivorforce/repos","events_url":"https://api.github.com/users/Ivorforce/events{/privacy}","received_events_url":"https://api.github.com/users/Ivorforce/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-11-22T22:05:54Z","updated_at":"2025-11-22T22:05:54Z","body":"Hi, thank you for opening a pull request!\r\n\r\nFor new features (including newly exposed APIs), we need to know why they're needed to justify merging them. Please add some description about what problems exposing these methods solves, ideally by opening [a proposal](https://github.com/godotengine/godot-proposals/issues).","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3567084619/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3568304317","html_url":"https://github.com/godotengine/godot/pull/104407#issuecomment-3568304317","issue_url":"https://api.github.com/repos/godotengine/godot/issues/104407","id":3568304317,"node_id":"IC_kwDOAO6SJc7UsAC9","user":{"login":"kleonc","id":9283098,"node_id":"MDQ6VXNlcjkyODMwOTg=","avatar_url":"https://avatars.githubusercontent.com/u/9283098?v=4","gravatar_id":"","url":"https://api.github.com/users/kleonc","html_url":"https://github.com/kleonc","followers_url":"https://api.github.com/users/kleonc/followers","following_url":"https://api.github.com/users/kleonc/following{/other_user}","gists_url":"https://api.github.com/users/kleonc/gists{/gist_id}","starred_url":"https://api.github.com/users/kleonc/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/kleonc/subscriptions","organizations_url":"https://api.github.com/users/kleonc/orgs","repos_url":"https://api.github.com/users/kleonc/repos","events_url":"https://api.github.com/users/kleonc/events{/privacy}","received_events_url":"https://api.github.com/users/kleonc/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-11-23T20:25:05Z","updated_at":"2025-11-23T20:25:05Z","body":"Proposal for `merge_many_polygons`:\r\n- https://github.com/godotengine/godot-proposals/issues/13594\r\n\r\nRelated:\r\n- https://github.com/godotengine/godot-proposals/issues/10395\r\n- #108654\r\n- #112750\r\n\r\n","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3568304317/reactions","total_count":4,"+1":4,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3568312617","html_url":"https://github.com/godotengine/godot/pull/104407#issuecomment-3568312617","issue_url":"https://api.github.com/repos/godotengine/godot/issues/104407","id":3568312617,"node_id":"IC_kwDOAO6SJc7UsCEp","user":{"login":"Ivorforce","id":2308167,"node_id":"MDQ6VXNlcjIzMDgxNjc=","avatar_url":"https://avatars.githubusercontent.com/u/2308167?v=4","gravatar_id":"","url":"https://api.github.com/users/Ivorforce","html_url":"https://github.com/Ivorforce","followers_url":"https://api.github.com/users/Ivorforce/followers","following_url":"https://api.github.com/users/Ivorforce/following{/other_user}","gists_url":"https://api.github.com/users/Ivorforce/gists{/gist_id}","starred_url":"https://api.github.com/users/Ivorforce/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Ivorforce/subscriptions","organizations_url":"https://api.github.com/users/Ivorforce/orgs","repos_url":"https://api.github.com/users/Ivorforce/repos","events_url":"https://api.github.com/users/Ivorforce/events{/privacy}","received_events_url":"https://api.github.com/users/Ivorforce/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-11-23T20:35:55Z","updated_at":"2025-11-23T20:36:32Z","body":"Thanks @kleonc, that's good information to have.\r\nI'm not very familiar with 2D geometry code, but I'm guessing this PR is also thematically related to https://github.com/godotengine/godot/pull/99911?\r\n\r\nSo I gather exposing `merge_many_polygons` is mainly a performance concern? If yes, this PR needs benchmarks, as per our [optimization guidelines](https://contributing.godotengine.org/en/latest/engine/guidelines/optimization.html).\r\n\r\nWe need similar motivation for `decompose_many_polygons_in_convex`.","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3568312617/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3568374966","html_url":"https://github.com/godotengine/godot/pull/104407#issuecomment-3568374966","issue_url":"https://api.github.com/repos/godotengine/godot/issues/104407","id":3568374966,"node_id":"IC_kwDOAO6SJc7UsRS2","user":{"login":"KeyboardDanni","id":34800072,"node_id":"MDQ6VXNlcjM0ODAwMDcy","avatar_url":"https://avatars.githubusercontent.com/u/34800072?v=4","gravatar_id":"","url":"https://api.github.com/users/KeyboardDanni","html_url":"https://github.com/KeyboardDanni","followers_url":"https://api.github.com/users/KeyboardDanni/followers","following_url":"https://api.github.com/users/KeyboardDanni/following{/other_user}","gists_url":"https://api.github.com/users/KeyboardDanni/gists{/gist_id}","starred_url":"https://api.github.com/users/KeyboardDanni/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/KeyboardDanni/subscriptions","organizations_url":"https://api.github.com/users/KeyboardDanni/orgs","repos_url":"https://api.github.com/users/KeyboardDanni/repos","events_url":"https://api.github.com/users/KeyboardDanni/events{/privacy}","received_events_url":"https://api.github.com/users/KeyboardDanni/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-11-23T21:57:50Z","updated_at":"2025-11-23T22:01:36Z","body":"This is also a functional issue. Per the proposal:\r\n\r\n> Plus, in order for it to work, you need to make sure that polygons that are merged are touching the previously merged polygons, otherwise merge_poylgons() will generate multiple polygons. I was handling this by splitting them up into sorted \"islands\" via breadth-first search (BFS), and it works but is inefficient.\r\n\r\nBasically if you wanted to merge this into one polygon:\r\n\r\n🟦🟦🟦\r\n🟦🟦🟦\r\n\r\nBut the polygons were ordered like this:\r\n\r\n1️⃣5️⃣2️⃣\r\n4️⃣6️⃣3️⃣\r\n\r\nThe existing `merge_polygons` would generate multiple polygons and you would have to handle this scenario from within the script somehow. Not only is that extra work for the user, but doing it through script will likely be a lot slower than using a specialized algorithm on the C++ side (at the very least due to time complexity).\r\n\r\nAlso, the last time I used a script to generate optimized tile collision, it could not support this scenario:\r\n\r\n🟦🟦🟦\r\n🟦⬜🟦\r\n🟦🟦🟦\r\n\r\nWith the white square being empty space.\r\n\r\nThis was one of the motivations for chunked tilemap physics in-engine in the first place.","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3568374966/reactions","total_count":2,"+1":2,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3572331188","html_url":"https://github.com/godotengine/godot/pull/104407#issuecomment-3572331188","issue_url":"https://api.github.com/repos/godotengine/godot/issues/104407","id":3572331188,"node_id":"IC_kwDOAO6SJc7U7XK0","user":{"login":"apples","id":2352020,"node_id":"MDQ6VXNlcjIzNTIwMjA=","avatar_url":"https://avatars.githubusercontent.com/u/2352020?v=4","gravatar_id":"","url":"https://api.github.com/users/apples","html_url":"https://github.com/apples","followers_url":"https://api.github.com/users/apples/followers","following_url":"https://api.github.com/users/apples/following{/other_user}","gists_url":"https://api.github.com/users/apples/gists{/gist_id}","starred_url":"https://api.github.com/users/apples/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/apples/subscriptions","organizations_url":"https://api.github.com/users/apples/orgs","repos_url":"https://api.github.com/users/apples/repos","events_url":"https://api.github.com/users/apples/events{/privacy}","received_events_url":"https://api.github.com/users/apples/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-11-24T19:15:22Z","updated_at":"2025-11-24T21:04:45Z","body":"I agree that this is mainly a **functional** issue, not a performance one.\r\n\r\nFor `merge_many_polygons`, the alternative of using `merge_polygons` is very difficult, as described above and in the linked proposal. Additionally, as mentioned above, it does not support holes at all. (It can *generate* holes, but then you have no way to deal with them afterwards.)\r\n\r\nAs for `decompose_many_polygons_in_convex`, my understanding is that it is not possible to match its behavior. There is an existing `decompose_polygon_in_convex` method, but it does not handle holes at all (which means you can't even use the output of `merge_polygons` with it, because `merge_polygons` can generate holes).\r\n\r\nIn fact, looking at the implementation of the existing `decompose_polygon_in_convex` method, you'll see that it actually just calls `decompose_many_polygons_in_convex` anyways, with an empty holes array:\r\n\r\nhttps://github.com/godotengine/godot/blob/bbe965432747f49ac647883c871a38ade26bdc4a/core/math/geometry_2d.cpp#L121-L123\r\n\r\nAlso, I think it's important to mention that these two methods (`merge_many_polygons` and `decompose_many_polygons_in_convex`) would often used together.\r\n\r\nProposals should probably include both methods.\r\n\r\nFor example, here is where `TileMapLayer` uses them together to produce the convex collision shapes:\r\n\r\nhttps://github.com/godotengine/godot/blob/bbe965432747f49ac647883c871a38ade26bdc4a/scene/2d/tile_map_layer.cpp#L929-L943\r\n","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3572331188/reactions","total_count":2,"+1":2,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3572387119","html_url":"https://github.com/godotengine/godot/pull/104407#issuecomment-3572387119","issue_url":"https://api.github.com/repos/godotengine/godot/issues/104407","id":3572387119,"node_id":"IC_kwDOAO6SJc7U7k0v","user":{"login":"Ivorforce","id":2308167,"node_id":"MDQ6VXNlcjIzMDgxNjc=","avatar_url":"https://avatars.githubusercontent.com/u/2308167?v=4","gravatar_id":"","url":"https://api.github.com/users/Ivorforce","html_url":"https://github.com/Ivorforce","followers_url":"https://api.github.com/users/Ivorforce/followers","following_url":"https://api.github.com/users/Ivorforce/following{/other_user}","gists_url":"https://api.github.com/users/Ivorforce/gists{/gist_id}","starred_url":"https://api.github.com/users/Ivorforce/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Ivorforce/subscriptions","organizations_url":"https://api.github.com/users/Ivorforce/orgs","repos_url":"https://api.github.com/users/Ivorforce/repos","events_url":"https://api.github.com/users/Ivorforce/events{/privacy}","received_events_url":"https://api.github.com/users/Ivorforce/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-11-24T19:28:29Z","updated_at":"2025-11-24T19:28:29Z","body":"Thank you three for clarifying. This helps a lot.\r\n\r\nI'm still a bit sceptical about the proposed interface. The current implementation necessitates quite a lot of data allocation and conversions. Is there any reason not to just accept an `Array[Array]` (for lack of deep type hints, no type on the inner array, but it could be added to the documentation).","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3572387119/reactions","total_count":3,"+1":3,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3700816925","html_url":"https://github.com/godotengine/godot/pull/104407#issuecomment-3700816925","issue_url":"https://api.github.com/repos/godotengine/godot/issues/104407","id":3700816925,"node_id":"IC_kwDOAO6SJc7clfwd","user":{"login":"apples","id":2352020,"node_id":"MDQ6VXNlcjIzNTIwMjA=","avatar_url":"https://avatars.githubusercontent.com/u/2352020?v=4","gravatar_id":"","url":"https://api.github.com/users/apples","html_url":"https://github.com/apples","followers_url":"https://api.github.com/users/apples/followers","following_url":"https://api.github.com/users/apples/following{/other_user}","gists_url":"https://api.github.com/users/apples/gists{/gist_id}","starred_url":"https://api.github.com/users/apples/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/apples/subscriptions","organizations_url":"https://api.github.com/users/apples/orgs","repos_url":"https://api.github.com/users/apples/repos","events_url":"https://api.github.com/users/apples/events{/privacy}","received_events_url":"https://api.github.com/users/apples/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-12-30T23:19:26Z","updated_at":"2025-12-30T23:19:26Z","body":"> I'm still a bit sceptical about the proposed interface.\r\n\r\nAfter another review, I agree with this. The extra allocations do seem unnecessary.\r\n\r\nFor what it's worth, anecdotally, when using this to generate collision shapes: whatever inefficiencies are caused by the extra allocations, are made up for in several orders of magnitude by how much faster the combined collision shapes are able to be added to the scene.\r\n\r\nWould probably be an issue if you were calling these methods every frame though.\r\n\r\nIf I can find the time to do so, I'll see if I can gather some benchmarks comparing this PR to a more optimized implementation.","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3700816925/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null}]