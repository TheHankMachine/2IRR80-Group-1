or":"ffddff","default":true,"description":"","archived_at":null,"archived_by":null},{"id":2666705648,"node_id":"MDU6TGFiZWwyNjY2NzA1NjQ4","url":"https://api.github.com/repos/godotengine/godot/labels/topic:animation","name":"topic:animation","color":"ffee88","default":false,"description":"","archived_at":null,"archived_by":null}],"state":"closed","locked":false,"assignees":[],"milestone":null,"comments":4,"created_at":"2025-03-27T06:16:11Z","updated_at":"2025-04-05T19:34:16Z","closed_at":"2025-04-02T15:43:25Z","assignee":null,"author_association":"NONE","issue_field_values":[],"type":null,"active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"### Tested versions\n\n4.4.1 Stable and 4.5 dev1\n\n\n### System information\n\nWindows 10, Godot 4.4.1 Stable and 4.5 dev1, NVIDIA GeForce GTX 650\n\n### Issue description\n\nWhen animating while AnimationMixer.callback_mode_discrete == FORCE CONTINUOUS, when transitioning between animations that have discrete track keys the following errors will be shown in console:\n\n![Image](https://github.com/user-attachments/assets/feb3cc40-0001-4274-9dbc-0fa519fdeade)\n\nAnd this is the AnimationStateMachineNode with the transitions:\n\n![Image](https://github.com/user-attachments/assets/a8f71b51-6c5a-48ca-a1fc-4193f58a0824)\n\nSo when transitioning from idle to reload, console shows errors that seem to be a transition between Strings \"idle\" and \"reload\", which are 2 animations in my AnimatedSprite2D node, and the longer the xfade is, the longer the string transition will be.\nBasically what it is doing is transitioning the String for AnimatedSprite2D.animation and trying to play animations that don't exist.\n\n![Image](https://github.com/user-attachments/assets/aeaaf25e-b4d0-4bd9-a422-300d937e7c72)\n\nDid not know transitions between strings even existed haha.\n\n### Steps to reproduce\n\nnone\n\n### Minimal reproduction project (MRP)\n\n[test_2025-03-27_00-08-16.zip](https://github.com/user-attachments/files/19480368/test_2025-03-27_00-08-16.zip)","closed_by":{"login":"TokageItLab","id":61938263,"node_id":"MDQ6VXNlcjYxOTM4MjYz","avatar_url":"https://avatars.githubusercontent.com/u/61938263?v=4","gravatar_id":"","url":"https://api.github.com/users/TokageItLab","html_url":"https://github.com/TokageItLab","followers_url":"https://api.github.com/users/TokageItLab/followers","following_url":"https://api.github.com/users/TokageItLab/following{/other_user}","gists_url":"https://api.github.com/users/TokageItLab/gists{/gist_id}","starred_url":"https://api.github.com/users/TokageItLab/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/TokageItLab/subscriptions","organizations_url":"https://api.github.com/users/TokageItLab/orgs","repos_url":"https://api.github.com/users/TokageItLab/repos","events_url":"https://api.github.com/users/TokageItLab/events{/privacy}","received_events_url":"https://api.github.com/users/TokageItLab/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/104683/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/godotengine/godot/issues/104683/timeline","performed_via_github_app":null,"state_reason":"not_planned","pinned_comment":null}