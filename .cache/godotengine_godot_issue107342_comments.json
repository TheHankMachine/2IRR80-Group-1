rs.githubusercontent.com/u/23084771?v=4","gravatar_id":"","url":"https://api.github.com/users/CaperCube","html_url":"https://github.com/CaperCube","followers_url":"https://api.github.com/users/CaperCube/followers","following_url":"https://api.github.com/users/CaperCube/following{/other_user}","gists_url":"https://api.github.com/users/CaperCube/gists{/gist_id}","starred_url":"https://api.github.com/users/CaperCube/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/CaperCube/subscriptions","organizations_url":"https://api.github.com/users/CaperCube/orgs","repos_url":"https://api.github.com/users/CaperCube/repos","events_url":"https://api.github.com/users/CaperCube/events{/privacy}","received_events_url":"https://api.github.com/users/CaperCube/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-08-20T18:56:43Z","updated_at":"2025-08-20T18:56:43Z","body":"This would be great to have working!\nMy workaround at the moment is to just check `tile_map_data` every so often for changes. Not very elegant, but it kinda suits my needs for now.","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3207657330/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3282840561","html_url":"https://github.com/godotengine/godot/issues/107342#issuecomment-3282840561","issue_url":"https://api.github.com/repos/godotengine/godot/issues/107342","id":3282840561,"node_id":"IC_kwDOAO6SJc7DrCvx","user":{"login":"AstroStucky","id":17039973,"node_id":"MDQ6VXNlcjE3MDM5OTcz","avatar_url":"https://avatars.githubusercontent.com/u/17039973?v=4","gravatar_id":"","url":"https://api.github.com/users/AstroStucky","html_url":"https://github.com/AstroStucky","followers_url":"https://api.github.com/users/AstroStucky/followers","following_url":"https://api.github.com/users/AstroStucky/following{/other_user}","gists_url":"https://api.github.com/users/AstroStucky/gists{/gist_id}","starred_url":"https://api.github.com/users/AstroStucky/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/AstroStucky/subscriptions","organizations_url":"https://api.github.com/users/AstroStucky/orgs","repos_url":"https://api.github.com/users/AstroStucky/repos","events_url":"https://api.github.com/users/AstroStucky/events{/privacy}","received_events_url":"https://api.github.com/users/AstroStucky/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-09-11T22:34:28Z","updated_at":"2025-09-11T22:34:28Z","body":"I found a very simple work around if you don't mind extending the TileMapLayer class: just implement the `_update_cells` virtual method. \n```GDScript\nextends TileMapLayer\n\nfunc _update_cells(_coords: Array[Vector2i], _forced_clean: bool) -> void:\n\tchanged.emit()\n```","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3282840561/reactions","total_count":5,"+1":5,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3369289759","html_url":"https://github.com/godotengine/godot/issues/107342#issuecomment-3369289759","issue_url":"https://api.github.com/repos/godotengine/godot/issues/107342","id":3369289759,"node_id":"IC_kwDOAO6SJc7I00gf","user":{"login":"lotovik","id":62682141,"node_id":"MDQ6VXNlcjYyNjgyMTQx","avatar_url":"https://avatars.githubusercontent.com/u/62682141?v=4","gravatar_id":"","url":"https://api.github.com/users/lotovik","html_url":"https://github.com/lotovik","followers_url":"https://api.github.com/users/lotovik/followers","following_url":"https://api.github.com/users/lotovik/following{/other_user}","gists_url":"https://api.github.com/users/lotovik/gists{/gist_id}","starred_url":"https://api.github.com/users/lotovik/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/lotovik/subscriptions","organizations_url":"https://api.github.com/users/lotovik/orgs","repos_url":"https://api.github.com/users/lotovik/repos","events_url":"https://api.github.com/users/lotovik/events{/privacy}","received_events_url":"https://api.github.com/users/lotovik/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-10-05T20:00:29Z","updated_at":"2025-10-05T20:27:13Z","body":"still not working in 4.5 stable and it's so frustrating to not have this working!\n\nEDIT:\n> I found a very simple work around if you don't mind extending the TileMapLayer class: just implement the `_update_cells` virtual method.\n\nfor some reason implementing that method makes so that every time a terrain is painted it exits the terrain tool, forcing me to manually select it again - making things very annoying to build.","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3369289759/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3393608693","html_url":"https://github.com/godotengine/godot/issues/107342#issuecomment-3393608693","issue_url":"https://api.github.com/repos/godotengine/godot/issues/107342","id":3393608693,"node_id":"IC_kwDOAO6SJc7KRlv1","user":{"login":"hexagon-0","id":34105941,"node_id":"MDQ6VXNlcjM0MTA1OTQx","avatar_url":"https://avatars.githubusercontent.com/u/34105941?v=4","gravatar_id":"","url":"https://api.github.com/users/hexagon-0","html_url":"https://github.com/hexagon-0","followers_url":"https://api.github.com/users/hexagon-0/followers","following_url":"https://api.github.com/users/hexagon-0/following{/other_user}","gists_url":"https://api.github.com/users/hexagon-0/gists{/gist_id}","starred_url":"https://api.github.com/users/hexagon-0/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/hexagon-0/subscriptions","organizations_url":"https://api.github.com/users/hexagon-0/orgs","repos_url":"https://api.github.com/users/hexagon-0/repos","events_url":"https://api.github.com/users/hexagon-0/events{/privacy}","received_events_url":"https://api.github.com/users/hexagon-0/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-10-11T19:26:55Z","updated_at":"2025-10-11T19:26:55Z","body":"Related: godotengine/godot-proposals#10917\n\nPersonally, I'm in favor of making the signal be emitted as a lightweight alternative to the `_update_cells` virtual method when the user doesn't need to know which cells have changed.\n\nHowever, there are things to be considered:\n\n- There may be performance implications. I'm not familiar with `TileMap`/`TileMapLayer` code to tell that for sure. The signal would always be emitted even if no one is listening, while `_update_cells` is only called if implemented. But the signal would not provide any data, so it probably doesn't have the same impact.\n\n- Existing code that listens to this signal could trigger more often, which may be unwanted, and even considered compatibility-breaking to some extent. This could be solved by creating a separate signal only for cell changes.","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3393608693/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5542988778","html_url":"https://github.com/godotengine/godot/issues/107342#issuecomment-5542988778","issue_url":"https://api.github.com/repos/godotengine/godot/issues/107342","id":5542988778,"node_id":"IC_kwDOAO6SJc8AAAABSmNL6g","user":{"login":"GiacomoPope","id":44242839,"node_id":"MDQ6VXNlcjQ0MjQyODM5","avatar_url":"https://avatars.githubusercontent.com/u/44242839?v=4","gravatar_id":"","url":"https://api.github.com/users/GiacomoPope","html_url":"https://github.com/GiacomoPope","followers_url":"https://api.github.com/users/GiacomoPope/followers","following_url":"https://api.github.com/users/GiacomoPope/following{/other_user}","gists_url":"https://api.github.com/users/GiacomoPope/gists{/gist_id}","starred_url":"https://api.github.com/users/GiacomoPope/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/GiacomoPope/subscriptions","organizations_url":"https://api.github.com/users/GiacomoPope/orgs","repos_url":"https://api.github.com/users/GiacomoPope/repos","events_url":"https://api.github.com/users/GiacomoPope/events{/privacy}","received_events_url":"https://api.github.com/users/GiacomoPope/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-09-04T15:47:58Z","updated_at":"2026-09-04T15:47:58Z","body":"@lotovik I looked into this in https://github.com/godotengine/godot/issues/123193#event-30565022472 and the outcome was that emitting changed is the wrong thing to do. Instead you need a custom signal such as `cells_changed`","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5542988778/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null}]