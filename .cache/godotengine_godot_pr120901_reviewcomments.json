531740090"},"html":{"href":"https://github.com/godotengine/godot/pull/120901#discussion_r3531740090"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/120901"}},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/3531740090/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":755,"original_line":755,"side":"RIGHT","in_reply_to_id":3525338729,"author_association":"CONTRIBUTOR","original_position":5,"position":5,"subject_type":"line"},{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/3531848716","pull_request_review_id":4639509071,"id":3531848716,"node_id":"PRRC_kwDOAO6SJc7Sg7wM","diff_hunk":"@@ -107,16 +108,14 @@ uint encode_norm_to_uint_oct(vec3 base) {\n \n uint encode_tang_to_uint_oct(vec4 base) {\n \tvec2 oct = vec3_to_oct(base.xyz);\n+\n+\t// 0.5 cannot be represented in UNORM16\n+\toct.y = clamp(oct.y, 1.0 / 65535.0, 65534.0 / 65535.0);\n+\n \t// Encode binormal sign in y component\n \toct.y = oct.y * 0.5f + 0.5f;\n \toct.y = base.w >= 0.0f ? oct.y : 1 - oct.y;\n \n-\tif (oct.x == 0.0 && oct.y == 1.0) {\n-\t\t// (1, 1) and (0, 1) decode to the same value, but (0, 1) messes with our compression detection.\n-\t\t// So we sanitize here.\n-\t\toct.x = 1.0;\n-\t}\n-","path":"servers/rendering/renderer_rd/shaders/skeleton.glsl","commit_id":"5ae06178f2da85f5a4d28d3420737ffb872e6a23","original_commit_id":"a5ca958b4d2fcd9e4e28922a74e9cebba4dbb508","user":{"login":"Gaktan","id":1674095,"node_id":"MDQ6VXNlcjE2NzQwOTU=","avatar_url":"https://avatars.githubusercontent.com/u/1674095?v=4","gravatar_id":"","url":"https://api.github.com/users/Gaktan","html_url":"https://github.com/Gaktan","followers_url":"https://api.github.com/users/Gaktan/followers","following_url":"https://api.github.com/users/Gaktan/following{/other_user}","gists_url":"https://api.github.com/users/Gaktan/gists{/gist_id}","starred_url":"https://api.github.com/users/Gaktan/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Gaktan/subscriptions","organizations_url":"https://api.github.com/users/Gaktan/orgs","repos_url":"https://api.github.com/users/Gaktan/repos","events_url":"https://api.github.com/users/Gaktan/events{/privacy}","received_events_url":"https://api.github.com/users/Gaktan/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"All normal values cannot be represented with Octahedral encoding anyway.\r\n\r\nAccording to this paper: https://jcgt.org/published/0003/02/01/paper.pdf\r\n\r\nOct32 (Oct 2x16bits) has a mean error of 0.00131° and a max error of 0.0037°. Worst case scenario, this would introduce an error of 0.0074° (max error x2 since we remove two non-adjacent possible values out of 65535).\r\n\r\nI believe this is more than acceptable for a normal encoding. From my own investigations, I found that 2x12 bits is more than enough to represent a normal vector accurately with no visible artifacts.\r\n\r\nBesides, the modified code here is only used for tangent encoding, which requires even less precision in theory.\r\n\r\nThe other alternative to clamping is to check the 0.5 value case specifically, but floating point comparison is always a pain. I find my method more elegant than this + the encoding detection from before, although a bit more convoluted perhaps.","created_at":"2026-07-06T20:25:57Z","updated_at":"2026-07-06T20:25:58Z","html_url":"https://github.com/godotengine/godot/pull/120901#discussion_r3531848716","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/120901","_links":{"self":{"href":"https://api.github.com/repos/godotengine/godot/pulls/comments/3531848716"},"html":{"href":"https://github.com/godotengine/godot/pull/120901#discussion_r3531848716"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/120901"}},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/3531848716/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":114,"original_start_line":114,"start_side":"LEFT","line":119,"original_line":119,"side":"LEFT","in_reply_to_id":3525341468,"author_association":"CONTRIBUTOR","original_position":27,"position":27,"subject_type":"line"},{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/3531935033","pull_request_review_id":4639615205,"id":3531935033,"node_id":"PRRC_kwDOAO6SJc7ShQ05","diff_hunk":"@@ -752,7 +752,7 @@ void _unpack_vertex_attributes(vec4 p_vertex_in, vec3 p_compressed_aabb_position\n \t\t// Uncompressed format.\n \t\tvec2 signed_tangent_attrib = p_normal_in.zw * 2.0 - 1.0;\n \t\tr_tangent = oct_to_vec3(vec2(signed_tangent_attrib.x, abs(signed_tangent_attrib.y) * 2.0 - 1.0));\n-\t\tbinormal_sign = sign(signed_tangent_attrib.y);\n+\t\tbinormal_sign = signed_tangent_attrib.y >= 0.0 ? 1.0 : -1.0;","path":"servers/rendering/renderer_rd/shaders/forward_clustered/scene_forward_clustered.glsl","commit_id":"5ae06178f2da85f5a4d28d3420737ffb872e6a23","original_commit_id":"a5ca958b4d2fcd9e4e28922a74e9cebba4dbb508","user":{"login":"clayjohn","id":16521339,"node_id":"MDQ6VXNlcjE2NTIxMzM5","avatar_url":"https://avatars.githubusercontent.com/u/16521339?v=4","gravatar_id":"","url":"https://api.github.com/users/clayjohn","html_url":"https://github.com/clayjohn","followers_url":"https://api.github.com/users/clayjohn/followers","following_url":"https://api.github.com/users/clayjohn/following{/other_user}","gists_url":"https://api.github.com/users/clayjohn/gists{/gist_id}","starred_url":"https://api.github.com/users/clayjohn/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/clayjohn/subscriptions","organizations_url":"https://api.github.com/users/clayjohn/orgs","repos_url":"https://api.github.com/users/clayjohn/repos","events_url":"https://api.github.com/users/clayjohn/events{/