[{"id":4068140934,"node_id":"PRR_kwDOAO6SJc7yeueG","user":{"login":"akien-mga","id":4701338,"node_id":"MDQ6VXNlcjQ3MDEzMzg=","avatar_url":"https://avatars.githubusercontent.com/u/4701338?u=4a42fd867f2c449fcc23adf635dd574dae98e6c2&v=4","gravatar_id":"","url":"https://api.github.com/users/akien-mga","html_url":"https://github.com/akien-mga","followers_url":"https://api.github.com/users/akien-mga/followers","following_url":"https://api.github.com/users/akien-mga/following{/other_user}","gists_url":"https://api.github.com/users/akien-mga/gists{/gist_id}","starred_url":"https://api.github.com/users/akien-mga/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/akien-mga/subscriptions","organizations_url":"https://api.github.com/users/akien-mga/orgs","repos_url":"https://api.github.com/users/akien-mga/repos","events_url":"https://api.github.com/users/akien-mga/events{/privacy}","received_events_url":"https://api.github.com/users/akien-mga/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"I tested this locally to confirm that the generated nupkgs work for both the Mono and Dotnet module builds.\n\nI checked out this PR and built it with `module_mono_enabled=yes` and `export GODOT_VERSION_STATUS=dotnet3`. This is to be able to test against the Dotnet module build from https://github.com/akien-mga/godot/releases/tag/4.7-dotnet3.\n\nAfter building assemblies and installing in my local nuget source (`Godot.NET.Sdk.4.7.0-dotnet.3.nupkg`), I confirmed that both flavors of the editor could compile and run Dodge the Creeps with C# (with the `dotnet3` Dotnet module build successfully performing the project conversion).\n","state":"APPROVED","html_url":"https://github.com/godotengine/godot/pull/118001#pullrequestreview-4068140934","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/118001","author_association":"MEMBER","_links":{"html":{"href":"https://github.com/godotengine/godot/pull/118001#pullrequestrev