[{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2823069599","html_url":"https://github.com/godotengine/godot/issues/105669#issuecomment-2823069599","issue_url":"https://api.github.com/repos/godotengine/godot/issues/105669","id":2823069599,"node_id":"IC_kwDOAO6SJc6oRJ-f","user":{"login":"Rindbee","id":30386067,"node_id":"MDQ6VXNlcjMwMzg2MDY3","avatar_url":"https://avatars.githubusercontent.com/u/30386067?v=4","gravatar_id":"","url":"https://api.github.com/users/Rindbee","html_url":"https://github.com/Rindbee","followers_url":"https://api.github.com/users/Rindbee/followers","following_url":"https://api.github.com/users/Rindbee/following{/other_user}","gists_url":"https://api.github.com/users/Rindbee/gists{/gist_id}","starred_url":"https://api.github.com/users/Rindbee/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Rindbee/subscriptions","organizations_url":"https://api.github.com/users/Rindbee/orgs","repos_url":"https://api.github.com/users/Rindbee/repos","events_url":"https://api.github.com/users/Rindbee/events{/privacy}","received_events_url":"https://api.github.com/users/Rindbee/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-04-23T05:05:46Z","updated_at":"2025-04-23T05:12:47Z","body":"The text files are missing from the provided MRP. There is `project.binary` but no `project.godot`. \n\nPlease provide a MRP that can be opened directly from the official gdoot editor.","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2823069599/reactions","total_count":3,"+1":3,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2825323943","html_url":"https://github.com/godotengine/godot/issues/105669#issuecomment-2825323943","issue_url":"https://api.github.com/repos/godotengine/godot/issues/105669","id":2825323943,"node_id":"IC_kwDOAO6SJc6oZwWn","user":{"login":"GrahameGW","id":8879714,"node_id":"MDQ6VXNlcjg4Nzk3MTQ=","avatar_url":"https://avatars.githubusercontent.com/u/8879714?v=4","gravatar_id":"","url":"https://api.github.com/users/GrahameGW","html_url":"https://github.com/GrahameGW","followers_url":"https://api.github.com/users/GrahameGW/followers","following_url":"https://api.github.com/users/GrahameGW/following{/other_user}","gists_url":"https://api.github.com/users/GrahameGW/gists{/gist_id}","starred_url":"https://api.github.com/users/GrahameGW/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/GrahameGW/subscriptions","organizations_url":"https://api.github.com/users/GrahameGW/orgs","repos_url":"https://api.github.com/users/GrahameGW/repos","events_url":"https://api.github.com/users/GrahameGW/events{/privacy}","received_events_url":"https://api.github.com/users/GrahameGW/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-04-23T19:31:02Z","updated_at":"2025-04-23T19:31:02Z","body":"Shoot I thought it did a text version when using \"Export PCK/ZIP\" out of the editor. I've manually zipped up the project and reuploaded in the main comment: https://github.com/godotengine/godot/issues/105669#issue-3012279626.\n\nI'll try to do a GDScript example today as well and confirm/deny that it's a problem there.","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2825323943/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2825976313","html_url":"https://github.com/godotengine/godot/issues/105669#issuecomment-2825976313","issue_url":"https://api.github.com/repos/godotengine/godot/issues/105669","id":2825976313,"node_i