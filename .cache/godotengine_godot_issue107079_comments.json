[{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2934929646","html_url":"https://github.com/godotengine/godot/pull/107079#issuecomment-2934929646","issue_url":"https://api.github.com/repos/godotengine/godot/issues/107079","id":2934929646,"node_id":"IC_kwDOAO6SJc6u73ju","user":{"login":"bruvzg","id":7645683,"node_id":"MDQ6VXNlcjc2NDU2ODM=","avatar_url":"https://avatars.githubusercontent.com/u/7645683?v=4","gravatar_id":"","url":"https://api.github.com/users/bruvzg","html_url":"https://github.com/bruvzg","followers_url":"https://api.github.com/users/bruvzg/followers","following_url":"https://api.github.com/users/bruvzg/following{/other_user}","gists_url":"https://api.github.com/users/bruvzg/gists{/gist_id}","starred_url":"https://api.github.com/users/bruvzg/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/bruvzg/subscriptions","organizations_url":"https://api.github.com/users/bruvzg/orgs","repos_url":"https://api.github.com/users/bruvzg/repos","events_url":"https://api.github.com/users/bruvzg/events{/privacy}","received_events_url":"https://api.github.com/users/bruvzg/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-06-03T12:05:03Z","updated_at":"2025-06-03T12:21:03Z","body":"> Huh, that's an odd workaround\r\n\r\nSome fonts have a single SVG for all glyphs, and specific glyph elements have id set to \"glyphXXXXX\", so we are filtering elements by id. There's also a common \"defs\" section defining subelements referenced by multiple glyphs. And in case of flags, some use subelements with id \"glyphXXXXX\" for a different glyph (e.g., white flag as background), this change disables filtering for the \"defs\" section to avoid losing such subelements.\r\n\r\n```xml\r\n<defs>\r\n    <something id=\"glyph1000.0\">... # white flag background, this was inclrrectly filtered out when drawing 0x2000\r\n    ...\r\n</defs>\r\n...\r\n<something id=\"glyph1000.0\"><a xlink:href=\"glyph1000\">... # white flag glyph, this should be filtered out when drawing 0x2000\r\n<something id=\"glyph2000.0\"><a xlink:href=\"glyph1000\">... # some other flag, reusing white background\r\n...\r\n```","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2934929646/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2937145036","html_url":"https://github.com/godotengine/godot/pull/107079#issuecomment-2937145036","issue_url":"https://api.github.com/repos/godotengine/godot/issues/107079","id":2937145036,"node_id":"IC_kwDOAO6SJc6vEUbM","user":{"login":"Repiteo","id":17489292,"node_id":"MDQ6VXNlcjE3NDg5Mjky","avatar_url":"https://avatars.githubusercontent.com/u/17489292?v=4","gravatar_id":"","url":"https://api.github.com/users/Repiteo","html_url":"https://github.com/Repiteo","followers_url":"https://api.github.com/users/Repiteo/followers","following_url":"https://api.github.com/users/Repiteo/following{/other_user}","gists_url":"https://api.github.com/users/Repiteo/gists{/gist_id}","starred_url":"https://api.github.com/users/Repiteo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Repiteo/subscriptions","organizations_url":"https://api.github.com/users/Repiteo/orgs","repos_url":"https://api.github.com/users/Repiteo/repos","events_url":"https://api.github.com/users/Repiteo/events{/privacy}","received_events_url":"https://api.github.com/users/Repiteo/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-06-03T20:47:32Z","updated_at":"2025-06-03T20:47:32Z","body":"Thanks!","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2937145036/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null}]