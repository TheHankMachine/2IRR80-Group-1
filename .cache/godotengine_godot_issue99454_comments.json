[{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2487843302","html_url":"https://github.com/godotengine/godot/issues/99454#issuecomment-2487843302","issue_url":"https://api.github.com/repos/godotengine/godot/issues/99454","id":2487843302,"node_id":"IC_kwDOAO6SJc6USXnm","user":{"login":"raulsntos","id":3903059,"node_id":"MDQ6VXNlcjM5MDMwNTk=","avatar_url":"https://avatars.githubusercontent.com/u/3903059?v=4","gravatar_id":"","url":"https://api.github.com/users/raulsntos","html_url":"https://github.com/raulsntos","followers_url":"https://api.github.com/users/raulsntos/followers","following_url":"https://api.github.com/users/raulsntos/following{/other_user}","gists_url":"https://api.github.com/users/raulsntos/gists{/gist_id}","starred_url":"https://api.github.com/users/raulsntos/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/raulsntos/subscriptions","organizations_url":"https://api.github.com/users/raulsntos/orgs","repos_url":"https://api.github.com/users/raulsntos/repos","events_url":"https://api.github.com/users/raulsntos/events{/privacy}","received_events_url":"https://api.github.com/users/raulsntos/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2024-11-20T08:14:54Z","updated_at":"2024-11-20T08:14:54Z","body":"Unbound generics are not supported in exported properties, this applies to every generic type (like `Godot.Collections.Array<T>`). However, Godot didn't support type hints for Dictionaries until 4.4 so that's why you are only running into this now. Before 4.4 we were exporting untyped Dictionaries in these cases, but now we try to generate the proper type hints and since the type is unbound we can't.\n\nRelated:\n- https://github.com/godotengine/godot/issues/74960\n- https://github.com/godotengine/godot/pull/92082","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2487843302/reactions","total_co