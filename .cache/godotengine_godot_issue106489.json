_by":null},{"id":279098082,"node_id":"MDU6TGFiZWwyNzkwOTgwODI=","url":"https://api.github.com/repos/godotengine/godot/labels/topic:gdscript","name":"topic:gdscript","color":"ffee88","default":false,"description":"","archived_at":null,"archived_by":null},{"id":1327318271,"node_id":"MDU6TGFiZWwxMzI3MzE4Mjcx","url":"https://api.github.com/repos/godotengine/godot/labels/crash","name":"crash","color":"885544","default":false,"description":"","archived_at":null,"archived_by":null}],"state":"closed","locked":false,"assignees":[],"milestone":{"url":"https://api.github.com/repos/godotengine/godot/milestones/22","html_url":"https://github.com/godotengine/godot/milestone/22","labels_url":"https://api.github.com/repos/godotengine/godot/milestones/22/labels","id":12070367,"node_id":"MI_kwDOAO6SJc4AuC3f","number":22,"title":"4.5","description":"","creator":{"login":"Sauermann","id":6299227,"node_id":"MDQ6VXNlcjYyOTkyMjc=","avatar_url":"https://avatars.githubusercontent.com/u/6299227?v=4","gravatar_id":"","url":"https://api.github.com/users/Sauermann","html_url":"https://github.com/Sauermann","followers_url":"https://api.github.com/users/Sauermann/followers","following_url":"https://api.github.com/users/Sauermann/following{/other_user}","gists_url":"https://api.github.com/users/Sauermann/gists{/gist_id}","starred_url":"https://api.github.com/users/Sauermann/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Sauermann/subscriptions","organizations_url":"https://api.github.com/users/Sauermann/orgs","repos_url":"https://api.github.com/users/Sauermann/repos","events_url":"https://api.github.com/users/Sauermann/events{/privacy}","received_events_url":"https://api.github.com/users/Sauermann/received_events","type":"User","user_view_type":"public","site_admin":false},"open_issues":3,"closed_issues":3687,"state":"closed","created_at":"2024-12-19T08:51:28Z","updated_at":"2026-09-04T21:48:38Z","due_on":"2025-09-15T00:00:00Z","closed_at":"2025-09-18T17:13:14Z"},"comments":2,"created_at":"2025-05-16T12:31:59Z","updated_at":"2025-07-01T23:04:10Z","closed_at":"2025-07-01T23:04:10Z","assignee":null,"author_association":"CONTRIBUTOR","issue_field_values":[],"type":null,"active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"### Tested versions\n\n- Reproducible in `4.0-stable`, `4.3-stable` and the recent `4.4.1-stable` (must be an old issue)\n- Reproducible in `4.5-dev4`\n- Not reproducible with `dev_build=yes`\n\nTested on Linux and macOS.\n\n\n### System information\n\nGodot v4.5.dev4 - Arch Linux #1 SMP PREEMPT_DYNAMIC Fri, 02 May 2025 06:44:33 +0000 on Wayland - Wayland display driver, Multi-window, 2 monitors - Vulkan (Forward+) - dedicated NVIDIA GeForce RTX 3060 Laptop GPU - 11th Gen Intel(R) Core(TM) i7-11800H @ 2.30GHz (16 threads)\n\n### Issue description\n\nGDScript stack traces involving coroutines do not report proper line numbers:\n\n<img width=\"599\" alt=\"Screenshot 2025-04-23 at 21 51 43\" src=\"https://github.com/user-attachments/assets/c6da1b4d-5206-4f48-8a5b-705cc0511d65\" />\n\n f1, f2, f3 are coroutines.\n\n_Originally posted by @limbonaut in https://github.com/godotengine/godot/pull/91006#pullrequestreview-2788548486_\n \nThis is unrelated to the script backtrace PR, as I can reproduce it on stable versions as well:\n\n<img width=\"471\" alt=\"Image\" src=\"https://github.com/user-attachments/assets/a690fca0-e669-4842-bbbf-b4ce407654a7\" />\n\n### Steps to reproduce\n\nMRP provided. Run a project with the following script to trigger an error and check the `Debugger -> Stack Trace`:\n\n```gdscript\nextends Node2D\n\n\nfunc _ready() -> void:\n\tawait f1()\n\tvar a\n\ta.hello() # trigger nullref access error\n\n\nfunc f1():\n\tprint(\"starting f1\")\n\tawait f2()\n\tprint(\"finishing f1\")\n\n\nfunc f2():\n\tprint(\"starting f2\")\n\tawait f3()\n\tprint(\"finishing f2\")\n\n\nfunc f3():\n\tprint(\"starting f3\")\n\tawait get_tree().process_frame\n\tprint(\"finishing f3\")\n\n```\n\nYou should see something similar in the editor:\n\n<img width=\"471\" alt=\"Image\" src=\"https://github.com/user-attachments/assets/a690fca0-e669-4842-bbbf-b4ce407654a7\" />\n\nNote the line numbers in the stack trace.\n\nUPDATE:\nMake sure you are building with `dev_build=no`. Apparently it's not reproducible with `dev_build=yes`.\n\n### Minimal reproduction project (MRP)\n\n[mrp-coroutine-stack-trace-issue.zip](https://github.com/user-attachments/files/20243852/mrp-coroutine-stack-trace-issue.zip)","closed_by":{"login":"Repiteo","id":17489292,"node_id":"MDQ6VXNlcjE3NDg5Mjky","avatar_url":"https://avatars.githubusercontent.com/u/17489292?v=4","gravatar_id":"","url":"https://api.github.com/users/Repiteo","html_url":"https://github.com/Repiteo","followers_url":"https://api.github.com/users/Repiteo/followers","following_url":"https://api.github.com/users/Repiteo/following{/other_user}","gists_url":"https://api.github.com/users/Repiteo/gists{/gist_id}","starred_url":"https://api.github.com/users/Repiteo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Repiteo/subscriptions","organizations_url":"https://api.github.com/users/Repiteo/orgs","repos_url":"https://api.github.com/users/Repiteo/repos","events_url":"https://api.github.com/users/Repiteo/events{/privacy}","received_events_url":"https://api.github.com/users/Repiteo/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/106489/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/godotengine/godot/issues/106489/timeline","performed_via_github_app":null,"state_reason":"completed","pinned_comment":null}