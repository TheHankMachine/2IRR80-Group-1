y":null},{"id":283518733,"node_id":"MDU6TGFiZWwyODM1MTg3MzM=","url":"https://api.github.com/repos/godotengine/godot/labels/usability","name":"usability","color":"447744","default":false,"description":"","archived_at":null,"archived_by":null},{"id":2304948121,"node_id":"MDU6TGFiZWwyMzA0OTQ4MTIx","url":"https://api.github.com/repos/godotengine/godot/labels/topic:codestyle","name":"topic:codestyle","color":"ffee88","default":false,"description":"","archived_at":null,"archived_by":null}],"state":"closed","locked":false,"assignees":[],"milestone":{"url":"https://api.github.com/repos/godotengine/godot/milestones/22","html_url":"https://github.com/godotengine/godot/milestone/22","labels_url":"https://api.github.com/repos/godotengine/godot/milestones/22/labels","id":12070367,"node_id":"MI_kwDOAO6SJc4AuC3f","number":22,"title":"4.5","description":"","creator":{"login":"Sauermann","id":6299227,"node_id":"MDQ6VXNlcjYyOTkyMjc=","avatar_url":"https://avatars.githubusercontent.com/u/6299227?v=4","gravatar_id":"","url":"https://api.github.com/users/Sauermann","html_url":"https://github.com/Sauermann","followers_url":"https://api.github.com/users/Sauermann/followers","following_url":"https://api.github.com/users/Sauermann/following{/other_user}","gists_url":"https://api.github.com/users/Sauermann/gists{/gist_id}","starred_url":"https://api.github.com/users/Sauermann/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Sauermann/subscriptions","organizations_url":"https://api.github.com/users/Sauermann/orgs","repos_url":"https://api.github.com/users/Sauermann/repos","events_url":"https://api.github.com/users/Sauermann/events{/privacy}","received_events_url":"https://api.github.com/users/Sauermann/received_events","type":"User","user_view_type":"public","site_admin":false},"open_issues":3,"closed_issues":3687,"state":"closed","created_at":"2024-12-19T08:51:28Z","updated_at":"2026-09-04T21:48:38Z","due_on":"2025-09-15T00:00:00Z","closed_at":"2025-09-18T17:13:14Z"},"comments":2,"created_at":"2025-03-12T20:05:08Z","updated_at":"2025-03-14T15:17:49Z","closed_at":"2025-03-14T15:13:09Z","assignee":null,"author_association":"MEMBER","issue_field_values":[],"type":null,"active_lock_reason":null,"draft":false,"pull_request":{"url":"https://api.github.com/repos/godotengine/godot/pulls/104049","html_url":"https://github.com/godotengine/godot/pull/104049","diff_url":"https://github.com/godotengine/godot/pull/104049.diff","patch_url":"https://github.com/godotengine/godot/pull/104049.patch","merged_at":"2025-03-14T15:13:09Z"},"body":"This PR removes an implementation for `String` from a single `char32_t`, in favour of just using the `Span<char32_t>`  based one.\r\n\r\n`String::chr` is very fast even when using the `Span` based implementation. I don't think it's worth keeping around an entire separate implementation for a tiny speed benefit (measured below). I don't think this difference is likely to cause a bottleneck. \r\n\r\nThis PR includes https://github.com/godotengine/godot/pull/100314 which made the first step in this direction.\r\n\r\n## Benchmark\r\n\r\nI measured a 3.8% (1 nanosecond per call) performance regression for `String::chr` (comparing to https://github.com/godotengine/godot/pull/100314):\r\n```c++\r\n\tauto t0 = std::chrono::high_resolution_clock::now();\r\n\tfor (int i = 0; i < 50000000; i ++) {\r\n\t\t// Test\r\n\t\tString s1 = String::chr('a');\r\n\t}\r\n\tauto t1 = std::chrono::high_resolution_clock::now();\r\n\tstd::cout << std::chrono::duration_cast<std::chrono::milliseconds>(t1 - t0).count() << \"ms\\n\";\r\n```\r\n\r\nThis printed\r\n- `1362ms` on the reference (https://github.com/godotengine/godot/pull/100314)\r\n- `1414ms` on this branch\r\n\r\nNotably, `master` currently calls a `strlen` based implementation right now, which is likely a bit slower than both of the implementations I tested. So in total, this PR should still speed up `String::chr` by a tiny fraction.\r\n\r\nI also measured a somewhat surprising 31kb reduction in the binary size due to the change. No idea where that's coming from; at this point I think the compiler might just be having a giggle or something.\r\n\r\n## Caveats\r\n\r\nThis PR changes behavior when a `\\0` character is passed into `String::chr`. Previously, it would return an empty string. Now, it will return a String of length 1, with `0xfffd` as the only symbol (designated replacement char). I think it unlikely anybody is relying on the old behavior, and I think the new behavior is more desirable.","closed_by":{"login":"Repiteo","id":17489292,"node_id":"MDQ6VXNlcjE3NDg5Mjky","avatar_url":"https://avatars.githubusercontent.com/u/17489292?v=4","gravatar_id":"","url":"https://api.github.com/users/Repiteo","html_url":"https://github.com/Repiteo","followers_url":"https://api.github.com/users/Repiteo/followers","following_url":"https://api.github.com/users/Repiteo/following{/other_user}","gists_url":"https://api.github.com/users/Repiteo/gists{/gist_id}","starred_url":"https://api.github.com/users/Repiteo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Repiteo/subscriptions","organizations_url":"https://api.github.com/users/Repiteo/orgs","repos_url":"https://api.github.com/users/Repiteo/repos","events_url":"https://api.github.com/users/Repiteo/events{/privacy}","received_events_url":"https://api.github.com/users/Repiteo/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/104049/reactions","total_count":3,"+1":2,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":1,"eyes":0},"timeline_url":"https://api.github.com/repos/godotengine/godot/issues/104049/timeline","performed_via_github_app":null,"state_reason":null}