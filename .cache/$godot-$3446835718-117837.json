[{"id":4053701539,"node_id":"PRR_kwDOAO6SJc7xnpOj","state":"APPROVED","commit_id":"29c31285635e89d3e932e80228bfc6cb11854111","user":{"site_admin":false,"suspended":false,"updated_at":"0001-01-01T00:00:00Z","avatar_url":"https://avatars.githubusercontent.com/u/180032?u=68d23e7ee9cdf810da125e8510b72f845b9dccc8&v=4","created_at":"0001-01-01T00:00:00Z","followers":0,"following":0,"html_url":"https://github.com/Calinou","id":180032,"node_id":"MDQ6VXNlcjE4MDAzMg==","login":"Calinou","type":"User","owned_private_repos":0,"public_gists":0,"public_repos":0,"total_private_repos":0,"url":"https://api.github.com/users/Calinou"},"body":"Tested locally on Windows 11 24H2, it works as expected. Code looks good to me.\n\nIn terms of performance, it's hard to say whether this has a big impact, as I can't get above 1242 FPS both before and after this PR (even in an empty scene with a tiny window and HDR output disabled). I'm using optimized MSVC 2022 binaries to test, but even then, I should definitely be able to get a higher framerate when nothing is going on (I can get 5-digit FPS numbers on Linux in the same scenario).\n\nIn terms of usability, it's unlikely people are adjusting SDR content brightness frequently, so having it only apply on refocus should be fine.","html_url":"https://github.com/godotengine/godot/pull/117837#pullrequestreview-4053701539","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/117837","author_association":"MEMBER","submitted_at":"2026-04-02T23:58:51Z"},{"id":4054291995,"node_id":"PRR_kwDOAO6SJc7xp5Yb","state":"APPROVED","commit_id":"29c31285635e89d3e932e80228bfc6cb11854111","user":{"site_admin":false,"suspended":false,"updated_at":"0001-01-01T00:00:00Z","avatar_url":"https://avatars.githubusercontent.com/u/1929107?v=4","created_at":"0001-01-01T00:00:00Z","followers":0,"following":0,"html_url":"https://github.com/DarkKilauea","id":1929107,"node_id":"MDQ6VXNlcjE5MjkxMDc=","login":"DarkKilauea","type":"User","owned_private_repos":0,"public_gists":0,"public_repos":0,"total_private_repos":0,"url":"https://api.github.com/users/DarkKilauea"},"body":"One notable difference in this approach is it does change how Windows responds to changes in the OS reference luminance compared to Wayland or macOS, which will both update immediately as far as I know.\n\nIf we merge this change, we should probably note that in the documentation. Other than that nitpick, I don't have an issue with this change. If we find a better solution in the future that updates the reference luminance only when it changes, we should be able to improve the windows implementation to use it.","html_url":"https://github.com/godotengine/godot/pull/117837#pullrequestreview-4054291995","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/117837","author_association":"CONTRIBUTOR","submitted_at":"2026-04-03T05:07:09Z"},{"id":4067417943,"node_id":"PRR_kwDOAO6SJc7yb99X","state":"APPROVED","commit_id":"29c31285635e89d3e932e80228bfc6cb11854111","user":{"site_admin":false,"suspended":false,"updated_at":"0001-01-01T00:00:00Z","avatar_url":"https://avatars.githubusercontent.com/u/19259897?u=6ecace2ddb6505607f21e3c41da42157298bd406&v=4","created_at":"0001-01-01T00:00:00Z","followers":0,"following":0,"html_url":"https://github.com/blueskythlikesclouds","id":19259897,"node_id":"MDQ6VXNlcjE5MjU5ODk3","login":"blueskythlikesclouds","type":"User","owned_private_repos":0,"public_gists":0,"public_repos":0,"total_private_repos":0,"url":"https://api.github.com/users/blueskythlikesclouds"},"body":"Looks good. My performance numbers roughly match with yours, but previously I'd get much worse stutters (up to 1.14 ms!), this PR eliminates those.\n\nGot a minor code convention nitpick.","html_url":"https://github.com/godotengine/godot/pull/117837#pullrequestreview-4067417943","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/117837","author_association":"MEMBER","submitted_at":"2026-04-07T10:33:33Z"},{"id":4068844439,"node_id":"PRR_kwDOAO6SJc7yhaOX","state":"COMMENTED","commit_id":"29c31285635e89d3e932e80228bfc6cb11854111","user":{"site_admin":false,"suspended":false,"updated_at":"0001-01-01T00:00:00Z","avatar_url":"https://avatars.githubusercontent.com/u/17506573?u=6e9313e254649f6dc55e92536596487ac10bf5a2&v=4","created_at":"0001-01-01T00:00:00Z","followers":0,"following":0,"html_url":"https://github.com/allenwp","id":17506573,"node_id":"MDQ6VXNlcjE3NTA2NTcz","login":"allenwp","type":"User","owned_private_repos":0,"public_gists":0,"public_repos":0,"total_private_repos":0,"url":"https://api.github.com/users/allenwp"},"body":"","html_url":"https://github.com/godotengine/godot/pull/117837#pullrequestreview-4068844439","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/117837","author_association":"CONTRIBUTOR","submitted_at":"2026-04-07T14:23:20Z"}]