[{"id":2574057674,"node_id":"PRR_kwDOAO6SJc6ZbQDK","user":{"login":"bruvzg","id":7645683,"node_id":"MDQ6VXNlcjc2NDU2ODM=","avatar_url":"https://avatars.githubusercontent.com/u/7645683?u=2867ee7fcd920bc19b7d1cbf4b10264b9bbc9326&v=4","gravatar_id":"","url":"https://api.github.com/users/bruvzg","html_url":"https://github.com/bruvzg","followers_url":"https://api.github.com/users/bruvzg/followers","following_url":"https://api.github.com/users/bruvzg/following{/other_user}","gists_url":"https://api.github.com/users/bruvzg/gists{/gist_id}","starred_url":"https://api.github.com/users/bruvzg/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/bruvzg/subscriptions","organizations_url":"https://api.github.com/users/bruvzg/orgs","repos_url":"https://api.github.com/users/bruvzg/repos","events_url":"https://api.github.com/users/bruvzg/events{/privacy}","received_events_url":"https://api.github.com/users/bruvzg/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"> Changing the \"Date Created\" date appears to be less trivial - I think the easiest way to go about that would be to create the .app directory itself from scratch, then copy all subdirectories from the template bundle into this newly-created directory.\r\n\r\nThis seems to be the easiest way to do it, and since `.app` bundle always contain only a single `Content` folder should be as easy as:\r\n```diff\r\ndiff --git a/platform/macos/SCsub b/platform/macos/SCsub\r\nindex 429cec2234..cdeb02675e 100644\r\n--- a/platform/macos/SCsub\r\n+++ b/platform/macos/SCsub\r\n@@ -33,7 +33,8 @@ def generate_bundle(target, source, env):\r\n         templ = Dir(\"#misc/dist/macos_tools.app\").abspath\r\n         if os.path.exists(app_dir):\r\n             shutil.rmtree(app_dir)\r\n-        shutil.copytree(templ, app_dir, ignore=shutil.ignore_patterns(\"Contents/Info.plist\"))\r\n+        os.mkdir(app_dir)\r\n+        shutil.copytree(templ + \"/Contents\", app_dir + \"/Contents\")\r\n         if not os.path.isdir(app_dir + \"/Contents/MacOS\"):\r\n             os.mkdir(app_dir + \"/Contents/MacOS\")\r\n         if target_bin != \"\":\r\n```","state":"COMMENTED","html_url":"https://github.com/godotengine/godot/pull/102003#pullrequestreview-2574057674","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/102003","author_association":"MEMBER","_links":{"html":{"href":"https://github.com/godotengine/godot/pull/102003#pullrequestreview-2574057674"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/102003"}},"submitted_at":"2025-01-25T17:41:08Z","commit_id":null},{"id":2577342637,"node_id":"PRR_kwDOAO6SJc6ZnyCt","user":{"login":"bruvzg","id":7645683,"node_id":"MDQ6VXNlcjc2NDU2ODM=","avatar_url":"https://avatars.githubusercontent.com/u/7645683?u=2867ee7fcd920bc19b7d1cbf4b10264b9bbc9326&v=4","gravatar_id":"","url":"https://api.github.com/users/bruvzg","html_url":"https://github.com/bruvzg","followers_url":"https://api.github.com/users/bruvzg/followers","following_url":"https://api.github.com/users/bruvzg/following{/other_user}","gists_url":"https://api.github.com/users/bruvzg/gists{/gist_id}","starred_url":"https://api.github.com/users/bruvzg/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/bruvzg/subscriptions","organizations_url":"https://api.github.com/users/bruvzg/orgs","repos_url":"https://api.github.com/users/bruvzg/repos","events_url":"https://api.github.com/users/bruvzg/events{/privacy}","received_events_url":"https://api.github.com/users/bruvzg/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"","state":"APPROVED","html_url":"https://github.com/godotengine/godot/pull/102003#pullrequestreview-2577342637","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/102003","author_association":"MEMBER","_links":{"html":{"href":"https://github.com/godotengine/godot/pull/102003#pullrequestreview-2577342637"},"pull_request":{"href":"