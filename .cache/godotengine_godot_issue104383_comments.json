 animationName in lib.GetAnimationList()) {\n>         var animation = lib.GetAnimation(animationName);\n>         var numTracks = animation.GetTrackCount();\n>         for (var trackIdx = 0; trackIdx < numTracks; trackIdx++) {\n>             if (animation.TrackGetKeyCount(trackIdx) != 1 ||\n>                 animation.TrackGetKeyTime(trackIdx, 0) != 0) {\n> \n>                 continue;\n>             }\n>             animation.RemoveTrack(trackIdx);\n>             trackIdx--;\n>             numTracks--;\n>         }\n>     }\n> }\n\nthis workaround doesn't work for me, cause it is deleting some nedeed original tracks (originaly with a position key)","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3161566099/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3180504384","html_url":"https://github.com/godotengine/godot/issues/104383#issuecomment-3180504384","issue_url":"https://api.github.com/repos/godotengine/godot/issues/104383","id":3180504384,"node_id":"IC_kwDOAO6SJc69kqVA","user":{"login":"Meorge","id":9957987,"node_id":"MDQ6VXNlcjk5NTc5ODc=","avatar_url":"https://avatars.githubusercontent.com/u/9957987?v=4","gravatar_id":"","url":"https://api.github.com/users/Meorge","html_url":"https://github.com/Meorge","followers_url":"https://api.github.com/users/Meorge/followers","following_url":"https://api.github.com/users/Meorge/following{/other_user}","gists_url":"https://api.github.com/users/Meorge/gists{/gist_id}","starred_url":"https://api.github.com/users/Meorge/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Meorge/subscriptions","organizations_url":"https://api.github.com/users/Meorge/orgs","repos_url":"https://api.github.com/users/Meorge/repos","events_url":"https://api.github.com/users/Meorge/events{/privacy}","received_events_url":"https://api.github.com/users/Meorge/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-08-12T18:25:32Z","updated_at":"2025-08-12T18:25:32Z","body":"I've just run into this problem as well and it's unfortunately putting a big damper on my workflow... I might see if I can find and fix it in a PR, but no promises at this point 😅 ","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3180504384/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3180741822","html_url":"https://github.com/godotengine/godot/issues/104383#issuecomment-3180741822","issue_url":"https://api.github.com/repos/godotengine/godot/issues/104383","id":3180741822,"node_id":"IC_kwDOAO6SJc69lkS-","user":{"login":"adamwych","id":6526954,"node_id":"MDQ6VXNlcjY1MjY5NTQ=","avatar_url":"https://avatars.githubusercontent.com/u/6526954?v=4","gravatar_id":"","url":"https://api.github.com/users/adamwych","html_url":"https://github.com/adamwych","followers_url":"https://api.github.com/users/adamwych/followers","following_url":"https://api.github.com/users/adamwych/following{/other_user}","gists_url":"https://api.github.com/users/adamwych/gists{/gist_id}","starred_url":"https://api.github.com/users/adamwych/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/adamwych/subscriptions","organizations_url":"https://api.github.com/users/adamwych/orgs","repos_url":"https://api.github.com/users/adamwych/repos","events_url":"https://api.github.com/users/adamwych/events{/privacy}","received_events_url":"https://api.github.com/users/adamwych/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-08-12T19:34:47Z","updated_at":"2025-08-12T19:40:50Z","body":"<img width=\"619\" height=\"431\" alt=\"Image\" src=\"https://github.com/user-attachments/assets/89cac580-f3ae-4dc1-a78f-98d3a8f41c46\" />\n\nChanging \"Import Tracks\" option to `IfPresent` (from `IfPresentForAll`) seems to fix this issue, but I couldn't find any documentation regarding why it's set to `IfPresentForAll` by default.\n\nEdit: This feature was added in https://github.com/godotengine/godot/pull/53782, and the description of this PR offers more insight regarding why it exists, though there should probably also be a tooltip in the editor explaining those modes.","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3180741822/reactions","total_count":8,"+1":3,"-1":0,"laugh":0,"hooray":3,"confused":0,"heart":2,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3182168578","html_url":"https://github.com/godotengine/godot/issues/104383#issuecomment-3182168578","issue_url":"https://api.github.com/repos/godotengine/godot/issues/104383","id":3182168578,"node_id":"IC_kwDOAO6SJc69rAoC","user":{"login":"vagran","id":6065976,"node_id":"MDQ6VXNlcjYwNjU5NzY=","avatar_url":"https://avatars.githubusercontent.com/u/6065976?v=4","gravatar_id":"","url":"https://api.github.com/users/vagran","html_url":"https://github.com/vagran","followers_url":"https://api.github.com/users/vagran/followers","following_url":"https://api.github.com/users/vagran/following{/other_user}","gists_url":"https://api.github.com/users/vagran/gists{/gist_id}","starred_url":"https://api.github.com/users/vagran/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/vagran/subscriptions","organizations_url":"https://api.github.com/users/vagran/orgs","repos_url":"https://api.github.com/users/vagran/repos","events_url":"https://api.github.com/users/vagran/events{/privacy}","received_events_url":"https://api.github.com/users/vagran/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-08-13T04:50:52Z","updated_at":"2025-08-13T04:50:52Z","body":"Looks like it is default to ensure any two animations can be blended.\n\nAlso I found useful current situation when handling RESET animation, which needs a track with a single keyframe for each used channel for all animations. However, most probably it can also be created procedurally in import script.","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3182168578/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3479145409","html_url":"https://github.com/godotengine/godot/issues/104383#issuecomment-3479145409","issue_url":"https://api.github.com/repos/godotengine/godot/issues/104383","id":3479145409,"node_id":"IC_kwDOAO6SJc7PX4vB","user":{"login":"Oblepikha","id":77234360,"node_id":"MDQ6VXNlcjc3MjM0MzYw","avatar_url":"https://avatars.githubusercontent.com/u/77234360?v=4","gravatar_id":"","url":"https://api.github.com/users/Oblepikha","html_url":"https://github.com/Oblepikha","followers_url":"https://api.github.com/users/Oblepikha/followers","following_url":"https://api.github.com/users/Oblepikha/following{/other_user}","gists_url":"https://api.github.com/users/Oblepikha/gists{/gist_id}","starred_url":"https://api.github.com/users/Oblepikha/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Oblepikha/subscriptions","organizations_url":"https://api.github.com/users/Oblepikha/orgs","repos_url":"https://api.github.com/users/Oblepikha/repos","events_url":"https://api.github.com/users/Oblepikha/events{/privacy}","received_events_url":"https://api.github.com/users/Oblepikha/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-11-03T06:54:37Z","updated_at":"2025-11-03T07:10:36Z","body":"> Changing \"Import Tracks\" option to `IfPresent` (from `IfPresentForAll`) seems to fix this issue, but I couldn't find any documentation regarding why it's set to `IfPresentForAll` by default.\n\nThe combination of \"IfPresent\" and \"Import Rest as RESET\" creates an empty RESET track with no keyframes.\nAnd the `reset_on_save` in the AnimationPlayer does not work with an empty RESET track\n\n","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3479145409/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null}]