[{"id":3919267193,"node_id":"PRR_kwDOAO6SJc7pm0V5","user":{"login":"TokageItLab","id":61938263,"node_id":"MDQ6VXNlcjYxOTM4MjYz","avatar_url":"https://avatars.githubusercontent.com/u/61938263?u=9b90963f1b4f17720e50bbbe495fbe8c84c8bc8e&v=4","gravatar_id":"","url":"https://api.github.com/users/TokageItLab","html_url":"https://github.com/TokageItLab","followers_url":"https://api.github.com/users/TokageItLab/followers","following_url":"https://api.github.com/users/TokageItLab/following{/other_user}","gists_url":"https://api.github.com/users/TokageItLab/gists{/gist_id}","starred_url":"https://api.github.com/users/TokageItLab/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/TokageItLab/subscriptions","organizations_url":"https://api.github.com/users/TokageItLab/orgs","repos_url":"https://api.github.com/users/TokageItLab/repos","events_url":"https://api.github.com/users/TokageItLab/events{/privacy}","received_events_url":"https://api.github.com/users/TokageItLab/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"As I've mentioned in the proposal, I am not opposed to implementing this, but I feel more improvements are necessary\r\n \r\n- Regarding SyncMode naming, it should use \"Independent\" instead of \"Discrete\", and \"Phase\" or \"Cyclic\" instead of \"Continuous\"\r\n- Performing division every frame is costly, so I believe we need to cache the divided values per point and perform simple addition instead. You can refer AnimatedSprite time progression process\r\n- In addition to runtime warnings, clearer preventive measures are needed, such as displaying a popup warning in the Animation Tree Editor (similar to the Animation Player's ReadOnly warning) or marking points with \"×\" if the point is **not** AnimationNodeAnimation (We cannot guarantee that they are finite and immutable in length except for AnimationNodeAnimation)\r\n\r\n<img width=\"537\" height=\"322\" alt=\"Image\" src=\"https://github.com/user-attachments/assets/47fae73d-f405-4cc2-9cd7-3bfedd5c154a\" />\r\n\r\n<img width=\"91\" height=\"80\" alt=\"Image\" src=\"https://github.com/user-attachments/assets/19df5598-1da9-40ee-8bfc-9508ae1f414f\" />","state":"CHANGES_REQUESTED","html_url":"https://github.com/godotengine/godot/pull/117275#pullrequestreview-3919267193","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/117275","author_association":"MEMBER","_links":{"html":{"href":"https://github.com/godotengine/godot/pull/117275#pullrequestreview-3919267193"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/117275"}},"submitted_at":"2026-03-10T02:15:32Z","commit_id":null},{"id":3919950705,"node_id":"PRR_kwDOAO6SJc7ppbNx","user":{"login":"TokageItLab","id":61938263,"node_id":"MDQ6VXNlcjYxOTM4MjYz","avatar_url":"https://avatars.githubusercontent.com/u/61938263?u=9b90963f1b4f17720e50bbbe495fbe8c84c8bc8e&v=4","gravatar_id":"","url":"https://api.github.com/users/TokageItLab","html_url":"https://github.com/TokageItLab","followers_url":"https://api.github.com/users/TokageItLab/followers","following_url":"https://api.github.com/users/TokageItLab/following{/other_user}","gists_url":"https://api.github.com/users/TokageItLab/gists{/gist_id}","starred_url":"https://api.github.com/users/TokageItLab/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/TokageItLab/subscriptions","organizations_url":"https://api.github.com/users/TokageItLab/orgs","repos_url":"https://api.github.com/users/TokageItLab/repos","events_url":"https://api.github.com/users/TokageItLab/events{/privacy}","received_events_url":"https://api.github.com/users/TokageItLab/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"","state":"CHANGES_REQUESTED","html_url":"https://github.com/godotengine/godot/pull/117275#pullrequestreview-3919950705","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/117275","author_association":"MEMBER","_links"