[{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2667893545","html_url":"https://github.com/godotengine/godot/pull/103026#issuecomment-2667893545","issue_url":"https://api.github.com/repos/godotengine/godot/issues/103026","id":2667893545,"node_id":"IC_kwDOAO6SJc6fBNMp","user":{"login":"bruvzg","id":7645683,"node_id":"MDQ6VXNlcjc2NDU2ODM=","avatar_url":"https://avatars.githubusercontent.com/u/7645683?v=4","gravatar_id":"","url":"https://api.github.com/users/bruvzg","html_url":"https://github.com/bruvzg","followers_url":"https://api.github.com/users/bruvzg/followers","following_url":"https://api.github.com/users/bruvzg/following{/other_user}","gists_url":"https://api.github.com/users/bruvzg/gists{/gist_id}","starred_url":"https://api.github.com/users/bruvzg/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/bruvzg/subscriptions","organizations_url":"https://api.github.com/users/bruvzg/orgs","repos_url":"https://api.github.com/users/bruvzg/repos","events_url":"https://api.github.com/users/bruvzg/events{/privacy}","received_events_url":"https://api.github.com/users/bruvzg/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-02-19T08:26:54Z","updated_at":"2025-02-19T08:26:54Z","body":"Additionally removed `_NOVAL` from properties and added some info about values to the docs. We should probably check other `_NOVAL` properties as well. ","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2667893545/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2667915281","html_url":"https://github.com/godotengine/godot/pull/103026#issuecomment-2667915281","issue_url":"https://api.github.com/repos/godotengine/godot/issues/103026","id":2667915281,"node_id":"IC_kwDOAO6SJc6fBSgR","user":{"login":"clayjohn","id":16521339,"node_id":"MDQ6VXNlcjE2NTIxMzM5","avatar_url":"https://avatars.githubusercontent.com/u/16521339?v=4","gravatar_id":"","url":"https://api.github.com/users/clayjohn","html_url":"https://github.com/clayjohn","followers_url":"https://api.github.com/users/clayjohn/followers","following_url":"https://api.github.com/users/clayjohn/following{/other_user}","gists_url":"https://api.github.com/users/clayjohn/gists{/gist_id}","starred_url":"https://api.github.com/users/clayjohn/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/clayjohn/subscriptions","organizations_url":"https://api.github.com/users/clayjohn/orgs","repos_url":"https://api.github.com/users/clayjohn/repos","events_url":"https://api.github.com/users/clayjohn/events{/privacy}","received_events_url":"https://api.github.com/users/clayjohn/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-02-19T08:35:40Z","updated_at":"2025-02-19T08:35:40Z","body":"Maybe this would be more suitable for 4.5? Is there any reason to rush this and merge it in the RC phase?","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2667915281/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2667924743","html_url":"https://github.com/godotengine/godot/pull/103026#issuecomment-2667924743","issue_url":"https://api.github.com/repos/godotengine/godot/issues/103026","id":2667924743,"node_id":"IC_kwDOAO6SJc6fBU0H","user":{"login":"bruvzg","id":7645683,"node_id":"MDQ6VXNlcjc2NDU2ODM=","avatar_url":"https://avatars.githubusercontent.com/u/7645683?v=4","gravatar_id":"","url":"https://api.github.com/users/bruvzg","html_url":"https://github.com/bruvzg","followers_url":"https://api.github.com/users/bruvzg/followers","following_url":"https://api.github.com/users/bruvzg/following{/other_user}","gists_url":"https://api.github.com/users/bruvzg/gists{/gist_id}","starred_url":"https://api.github.com/users/bruvzg/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/bruvzg/subscriptions","organizations_url":"https://api.github.com/users/bruvzg/orgs","repos_url":"https://api.github.com/users/bruvzg/repos","events_url":"https://api.github.com/users/bruvzg/events{/privacy}","received_events_url":"https://api.github.com/users/bruvzg/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-02-19T08:40:16Z","updated_at":"2025-02-19T08:40:16Z","body":"> Is there any reason to rush this and merge it in the RC phase?\r\n\r\nImpossibility of picking iOS rendering driver when using Intel macs is an issue, but I'm not sure if it's something absolutely necessary for 4.4. Default value is OK in most cases, and absolute majority of iOS developers will use Apple Silicon macs.","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2667924743/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2667933251","html_url":"https://github.com/godotengine/godot/pull/103026#issuecomment-2667933251","issue_url":"https://api.github.com/repos/godotengine/godot/issues/103026","id":2667933251,"node_id":"IC_kwDOAO6SJc6fBW5D","user":{"login":"bruvzg","id":7645683,"node_id":"MDQ6VXNlcjc2NDU2ODM=","avatar_url":"https://avatars.githubusercontent.com/u/7645683?v=4","gravatar_id":"","url":"https://api.github.com/users/bruvzg","html_url":"https://github.com/bruvzg","followers_url":"https://api.github.com/users/bruvzg/followers","following_url":"https://api.github.com/users/bruvzg/following{/other_user}","gists_url":"https://api.github.com/users/bruvzg/gists{/gist_id}","starred_url":"https://api.github.com/users/bruvzg/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/bruvzg/subscriptions","organizations_url":"https://api.github.com/users/bruvzg/orgs","repos_url":"https://api.github.com/users/bruvzg/repos","events_url":"https://api.github.com/users/bruvzg/events{/privacy}","received_events_url":"https://api.github.com/users/bruvzg/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-02-19T08:44:22Z","updated_at":"2025-02-19T08:44:22Z","body":"> We should probably check other _NOVAL properties as well.\r\n\r\nOther `_NOVAL` properties:\r\n\r\n- 🟢 OK, `_NOVAL` use seems reasonable:\r\n  - `rendering/gl_compatibility/force_angle_on_devices` - OK, we do not want a huge block list in the docs.\r\n  - `editor/script/search_in_file_extensions`, different value for .NET version, so should be OK.\r\n- 🟡 OK, but no reason to use `_NOVAL`:\r\n  - `display/display_server/driver` (and overrides), all values are selectable on all platforms. Default value is always `default`.\r\n  - `input_devices/pen_tablet/driver` (and override), all values are selectable on all platforms. Default value is always empty string.\r\n  - `rendering/scaling_3d/mode` (iOS and macOS overrides), all values are selectable on all platforms. Default value is always `Bilinear`.\r\n- 🔴 Can be an issue if you try to override the value:\r\n  - `audio/driver/driver`, uses platform specific values, probably should be changed to `auto` + platform specific overrides as well.\r\n  - `gui/common/swap_cancel_ok`, uses platform specific default value.","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2667933251/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2667957830","html_url":"https://github.com/godotengine/godot/pull/103026#issuecomment-2667957830","issue_url":"https://api.github.com/repos/godotengine/godot/issues/103026","id":2667957830,"node_id":"IC_kwDOAO6SJc6fBc5G","user":{"login":"akien-mga","id":4701338,"node_id":"MDQ6VXNlcjQ3MDEzMzg=","avatar_url":"https://avatars.githubusercontent.com/u/4701338?v=4","gravatar_id":"","url":"https://api.github.com/users/akien-mga","html_url":"https://github.com/akien-mga","followers_url":"https://api.github.com/users/akien-mga/followers","following_url":"https://api.github.com/users/akien-mga/following{/other_user}","gists_url":"https://api.github.com/users/akien-mga/gists{/gist_id}","starred_url":"https://api.github.com/users/akien-mga/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/akien-mga/subscriptions","organizations_url":"https://api.github.com/users/akien-mga/orgs","repos_url":"https://api.github.com/users/akien-mga/repos","events_url":"https://api.github.com/users/akien-mga/events{/privacy}","received_events_url":"https://api.github.com/users/akien-mga/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-02-19T08:56:02Z","updated_at":"2025-02-19T08:56:02Z","body":"I think for 4.4 we should change this to not be platform/driver specific:\r\n```\r\n\t\t{\r\n\t\t\tVector<String> driver_hints_arr;\r\n#ifdef VULKAN_ENABLED\r\n\t\t\tdriver_hints_arr.push_back(\"vulkan\");\r\n#endif\r\n\t\t\tdriver_hints = String(\",\").join(driver_hints_arr);\r\n\r\n#ifdef D3D12_ENABLED\r\n\t\t\tdriver_hints_arr.push_back(\"d3d12\");\r\n#endif\r\n\t\t\tdriver_hints_with_d3d12 = String(\",\").join(driver_hints_arr);\r\n\r\n#ifdef METAL_ENABLED\r\n\t\t\t// Make metal the preferred and default driver.\r\n\t\t\tdriver_hints_arr.insert(0, \"metal\");\r\n#endif\r\n\t\t\tdriver_hints_with_metal = String(\",\").join(driver_hints_arr);\r\n\t\t}\r\n```\r\n\r\nWe should let any version of Godot choose any driver for the project, as it might run on a different device. If editing a macOS or iOS project on Windows, you should still be able to configure whether it should use Metal or Vulkan.","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2667957830/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2667964499","html_url":"https://github.com/godotengine/godot/pull/103026#issuecomment-2667964499","issue_url":"https://api.github.com/repos/godotengine/godot/issues/103026","id":2667964499,"node_id":"IC_kwDOAO6SJc6fBehT","user":{"login":"bruvzg","id":7645683,"node_id":"MDQ6VXNlcjc2NDU2ODM=","avatar_url":"https://avatars.githubusercontent.com/u/7645683?v=4","gravatar_id":"","url":"https://api.github.com/users/bruvzg","html_url":"https://github.com/bruvzg","followers_url":"https://api.github.com/users/bruvzg/followers","following_url":"https://api.github.com/users/bruvzg/following{/other_user}","gists_url":"https://api.github.com/users/bruvzg/gists{/gist_id}","starred_url":"https://api.github.com/users/bruvzg/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/bruvzg/subscriptions","organizations_url":"https://api.github.com/users/bruvzg/orgs","repos_url":"https://api.github.com/users/bruvzg/repos","events_url":"https://api.github.com/users/bruvzg/events{/privacy}","received_events_url":"https://api.github.com/users/bruvzg/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-02-19T08:59:04Z","updated_at":"2025-02-19T08:59:04Z","body":"> We should let any version of Godot choose any driver for the project, as it might run on a different device. If editing a macOS or iOS project on Windows, you should still be able to configure whether it should use Metal or Vulkan.\r\n\r\nApart for additional notes in the docs, this is the only thing this PR do. OpenGL part is the same, but only relevant if you build an editor w/o GL support, so not important.","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2667964499/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2667992684","html_url":"https://github.com/godotengine/godot/pull/103026#issuecomment-2667992684","issue_url":"https://api.github.com/repos/godotengine/godot/issues/103026","id":2667992684,"node_id":"IC_kwDOAO6SJc6fBlZs","user":{"login":"akien-mga","id":4701338,"node_id":"MDQ6VXNlcjQ3MDEzMzg=","avatar_url":"https://avatars.githubusercontent.com/u/4701338?v=4","gravatar_id":"","url":"https://api.github.com/users/akien-mga","html_url":"https://github.com/akien-mga","followers_url":"https://api.github.com/users/akien-mga/followers","following_url":"https://api.github.com/users/akien-mga/following{/other_user}","gists_url":"https://api.github.com/users/akien-mga/gists{/gist_id}","starred_url":"https://api.github.com/users/akien-mga/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/akien-mga/subscriptions","organizations_url":"https://api.github.com/users/akien-mga/orgs","repos_url":"https://api.github.com/users/akien-mga/repos","events_url":"https://api.github.com/users/akien-mga/events{/privacy}","received_events_url":"https://api.github.com/users/akien-mga/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-02-19T09:08:57Z","updated_at":"2025-02-19T09:08:57Z","body":"I think we might want this for 4.4 to solve the current weird platform-specific available issue for configuration.\r\n\r\nI'll see if I can think of a more minimal subset that does not introduce \"auto\" to avoid changing config so late in the cycle, but from a quick look I'm not sure I see such subset, so we might want to just go all the way and merge this for 4.4.rc1, and document clearly that those settings are now \"auto\" by default.","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2667992684/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2668025761","html_url":"https://github.com/godotengine/godot/pull/103026#issuecomment-2668025761","issue_url":"https://api.github.com/repos/godotengine/godot/issues/103026","id":2668025761,"node_id":"IC_kwDOAO6SJc6fBteh","user":{"login":"bruvzg","id":7645683,"node_id":"MDQ6VXNlcjc2NDU2ODM=","avatar_url":"https://avatars.githubusercontent.com/u/7645683?v=4","gravatar_id":"","url":"https://api.github.com/users/bruvzg","html_url":"https://github.com/bruvzg","followers_url":"https://api.github.com/users/bruvzg/followers","following_url":"https://api.github.com/users/bruvzg/following{/other_user}","gists_url":"https://api.github.com/users/bruvzg/gists{/gist_id}","starred_url":"https://api.github.com/users/bruvzg/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/bruvzg/subscriptions","organizations_url":"https://api.github.com/users/bruvzg/orgs","repos_url":"https://api.github.com/users/bruvzg/repos","events_url":"https://api.github.com/users/bruvzg/events{/privacy}","received_events_url":"https://api.github.com/users/bruvzg/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-02-19T09:22:54Z","updated_at":"2025-02-19T09:22:54Z","body":"> I'll see if I can think of a more minimal subset that does not introduce \"auto\" to avoid changing config so late in the cycle, but from a quick look I'm not sure I see such subset, so we might want to just go all the way and merge this for 4.4.rc1, and document clearly that those settings are now \"auto\" by default.\r\n\r\nSince it was not (and is not) saving default values, valid existing project configs should not change. If it was default, it's still default (with the same behavior and not saved), and if it was set to other value, it will stay with this value. So for most users it will be a minor editor UI change. The only affected cases are iOS config when using editor on Intel Mac, and custom builds with disabled renderers.","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2668025761/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2671914396","html_url":"https://github.com/godotengine/godot/pull/103026#issuecomment-2671914396","issue_url":"https://api.github.com/repos/godotengine/godot/issues/103026","id":2671914396,"node_id":"IC_kwDOAO6SJc6fQi2c","user":{"login":"akien-mga","id":4701338,"node_id":"MDQ6VXNlcjQ3MDEzMzg=","avatar_url":"https://avatars.githubusercontent.com/u/4701338?v=4","gravatar_id":"","url":"https://api.github.com/users/akien-mga","html_url":"https://github.com/akien-mga","followers_url":"https://api.github.com/users/akien-mga/followers","following_url":"https://api.github.com/users/akien-mga/following{/other_user}","gists_url":"https://api.github.com/users/akien-mga/gists{/gist_id}","starred_url":"https://api.github.com/users/akien-mga/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/akien-mga/subscriptions","organizations_url":"https://api.github.com/users/akien-mga/orgs","repos_url":"https://api.github.com/users/akien-mga/repos","events_url":"https://api.github.com/users/akien-mga/events{/privacy}","received_events_url":"https://api.github.com/users/akien-mga/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-02-20T15:53:27Z","updated_at":"2025-02-20T15:53:27Z","body":"Thanks!","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2671914396/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null}]