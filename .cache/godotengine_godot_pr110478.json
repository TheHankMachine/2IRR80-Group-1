e path, which maybe wrong):\r\nhttps://github.com/godotengine/godot/blob/bfa330dd5dc6f4894efc956db1be20e4bc2d0064/scene/resources/animation.cpp#L1067\r\nWe can optimize NodePath to String by using the cached concatenated path.\r\n\r\nTested in gdscript\r\n```gdscript\r\n\tvar t1 := Time.get_ticks_msec()\r\n\tvar p := NodePath(\"gsesfs/dawd/fesj/wadfr:dawjjfes:fnsnjk:fasef\")\r\n\tvar s := str(p)\r\n\tprint(s)\r\n\tfor i in range(1000000):\r\n\t\ts = str(p)\r\n\tprint(Time.get_ticks_msec()-t1)\r\n```\r\nBefore: 702, After: 373","labels":[{"id":73330066,"node_id":"MDU6TGFiZWw3MzMzMDA2Ng==","url":"https://api.github.com/repos/godotengine/godot/labels/enhancement","name":"enhancement","description":"","color":"aaccff","default":true,"archived_at":null,"archived_by":null},{"id":279097966,"node_id":"MDU6TGFiZWwyNzkwOTc5NjY=","url":"https://api.github.com/repos/godotengine/godot/labels/topic:core","name":"topic:core","description":"","color":"ffee88","default":false,"archived_at":null,"archived_by":null},{"id":3240950060,"node_id":"MDU6TGFiZWwzMjQwOTUwMDYw","url":"https://api.github.com/repos/godotengine/godot/labels/performance","name":"performance","description":"","color":"447777","default":false,"archived_at":null,"archived_by":null}],"milestone":{"id":12939969,"node_id":"MI_kwDOAO6SJc4AxXLB","url":"https://api.github.com/repos/godotengine/godot/milestones/23","html_url":"https://github.com/godotengine/godot/milestone/23","labels_url":"https://api.github.com/repos/godotengine/godot/milestones/23/labels","number":23,"state":"closed","title":"4.6","description":"","creator":{"login":"Repiteo","id":17489292,"node_id":"MDQ6VXNlcjE3NDg5Mjky","avatar_url":"https://avatars.githubusercontent.com/u/17489292?v=4","gravatar_id":"","url":"https://api.github.com/users/Repiteo","html_url":"https://github.com/Repiteo","followers_url":"https://api.github.com/users/Repiteo/followers","following_url":"https://api.github.com/users/Repiteo/following{/other_user}","gists_url":"https://api.