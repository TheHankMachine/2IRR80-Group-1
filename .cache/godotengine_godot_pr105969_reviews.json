[{"id":2810059679,"node_id":"PRR_kwDOAO6SJc6nfhuf","user":{"login":"RedMser","id":5117197,"node_id":"MDQ6VXNlcjUxMTcxOTc=","avatar_url":"https://avatars.githubusercontent.com/u/5117197?u=d7a341cd0900d3ef72e121c6a8bb86b35aba4a54&v=4","gravatar_id":"","url":"https://api.github.com/users/RedMser","html_url":"https://github.com/RedMser","followers_url":"https://api.github.com/users/RedMser/followers","following_url":"https://api.github.com/users/RedMser/following{/other_user}","gists_url":"https://api.github.com/users/RedMser/gists{/gist_id}","starred_url":"https://api.github.com/users/RedMser/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/RedMser/subscriptions","organizations_url":"https://api.github.com/users/RedMser/orgs","repos_url":"https://api.github.com/users/RedMser/repos","events_url":"https://api.github.com/users/RedMser/events{/privacy}","received_events_url":"https://api.github.com/users/RedMser/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"There are other methods in `Tree` which error when `blocked > 0` (a state which only occurs during mouse event propagation). Those methods are `set_columns` and `clear`.\r\n\r\nThe docs remark you added should probably be added to those methods as well? Otherwise it's weirdly inconsistent.\r\n\r\nAlso I strongly urge you to modify the three error macros that check for `blocked > 0` to include an *error message*, to make it easier to understand why it fails, for example:\r\n\r\n```diff\r\n- ERR_FAIL_COND(blocked > 0);\r\n+ ERR_FAIL_COND_MSG(blocked > 0, \"Tree is locked during mouse selection events. Use \\\"call_deferred()\\\" to modify the tree.\");\r\n```","state":"COMMENTED","html_url":"https://github.com/godotengine/godot/pull/105969#pullrequestreview-2810059679","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/105969","author_association":"CONTRIBUTOR","_links":{"html":{"href":"https://github.com/godotengine/godot/pull/105969#pullrequestreview-2810059679"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/105969"}},"submitted_at":"2025-05-01T15:44:40Z","commit_id":"467282046ceae0203dde32258f943cf73c4690c1"}]