c_repos":0,"total_private_repos":0,"url":"https://api.github.com/users/Ivorforce"},"body":"","html_url":"https://github.com/godotengine/godot/pull/111767#pullrequestreview-3378287259","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/111767","author_association":"MEMBER","submitted_at":"2025-10-24T18:30:06Z"},{"id":3379100336,"node_id":"PRR_kwDOAO6SJc7JaPqw","state":"COMMENTED","user":{"site_admin":false,"suspended":false,"updated_at":"0001-01-01T00:00:00Z","avatar_url":"https://avatars.githubusercontent.com/u/2308167?u=f7f8e0273f784f5ec6f6b7fe4a88d449896eb48a&v=4","created_at":"0001-01-01T00:00:00Z","followers":0,"following":0,"html_url":"https://github.com/Ivorforce","id":2308167,"node_id":"MDQ6VXNlcjIzMDgxNjc=","login":"Ivorforce","type":"User","owned_private_repos":0,"public_gists":0,"public_repos":0,"total_private_repos":0,"url":"https://api.github.com/users/Ivorforce"},"body":"","html_url":"https://github.com/godotengine/godot/pull/111767#pullrequestreview-3379100336","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/111767","author_association":"MEMBER","submitted_at":"2025-10-24T22:33:49Z"},{"id":3379189149,"node_id":"PRR_kwDOAO6SJc7JalWd","state":"COMMENTED","user":{"site_admin":false,"suspended":false,"updated_at":"0001-01-01T00:00:00Z","avatar_url":"https://avatars.githubusercontent.com/u/17489292?u=34072b401722100a7c0c0d61e37b376cf22b4545&v=4","created_at":"0001-01-01T00:00:00Z","followers":0,"following":0,"html_url":"https://github.com/Repiteo","id":17489292,"node_id":"MDQ6VXNlcjE3NDg5Mjky","login":"Repiteo","type":"User","owned_private_repos":0,"public_gists":0,"public_repos":0,"total_private_repos":0,"url":"https://api.github.com/users/Repiteo"},"body":"","html_url":"https://github.com/godotengine/godot/pull/111767#pullrequestreview-3379189149","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/111767","author_association":"CONTRIBUTOR","submitted_at":"2025-10-24T23:37:03Z"},{"id":3379195727,"node_id":"PRR_kwDOAO6SJc7Jam9P","state":"COMMENTED","user":{"site_admin":false,"suspended":false,"updated_at":"0001-01-01T00:00:00Z","avatar_url":"https://avatars.githubusercontent.com/u/17489292?u=34072b401722100a7c0c0d61e37b376cf22b4545&v=4","created_at":"0001-01-01T00:00:00Z","followers":0,"following":0,"html_url":"https://github.com/Repiteo","id":17489292,"node_id":"MDQ6VXNlcjE3NDg5Mjky","login":"Repiteo","type":"User","owned_private_repos":0,"public_gists":0,"public_repos":0,"total_private_repos":0,"url":"https://api.github.com/users/Repiteo"},"body":"","html_url":"https://github.com/godotengine/godot/pull/111767#pullrequestreview-3379195727","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/111767","author_association":"CONTRIBUTOR","submitted_at":"2025-10-24T23:43:54Z"},{"id":3497917106,"node_id":"PRR_kwDOAO6SJc7Qffqy","state":"APPROVED","commit_id":"ad02128137a90c27c67bb8733bf51990528e73bd","user":{"site_admin":false,"suspended":false,"updated_at":"0001-01-01T00:00:00Z","avatar_url":"https://avatars.githubusercontent.com/u/2308167?u=f7f8e0273f784f5ec6f6b7fe4a88d449896eb48a&v=4","created_at":"0001-01-01T00:00:00Z","followers":0,"following":0,"html_url":"https://github.com/Ivorforce","id":2308167,"node_id":"MDQ6VXNlcjIzMDgxNjc=","login":"Ivorforce","type":"User","owned_private_repos":0,"public_gists":0,"public_repos":0,"total_private_repos":0,"url":"https://api.github.com/users/Ivorforce"},"body":"I tested this change and it compiled successfully, ~10% faster than `master`.\r\nCode looks good to me now. I appreciate simplifying the implementation to this level!\r\n\r\nI really hope that this won't cause too many issues down the line (I can imagine there will be a few), but the 10% compile time boost is worth it in my opinion.\r\nIf it ends up being too frail in practice, we could switch to transitive libc++ by default, and support non-transitive on a best-effort basis.\r\n\r\n(I'm actually surprised at how few patches are required to get this working. I would have fully expected we'd need to disable this optimization for 3rd party libs.)","html_url":"https://github.com/godotengine/godot/pull/111767#pullrequestreview-3497917106","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/111767","author_association":"MEMBER","submitted_at":"2025-11-23T17:54:19Z"},{"id":3537268689,"node_id":"PRR_kwDOAO6SJc7S1m_R","state":"APPROVED","commit_id":"ad02128137a90c27c67bb8733bf51990528e73bd","user":{"site_admin":false,"suspended":false,"updated_at":"0001-01-01T00:00:00Z","avatar_url":"https://avatars.githubusercontent.com/u/4701338?u=4a42fd867f2c449fcc23adf635dd574dae98e6c2&v=4","created_at":"0001-01-01T00:00:00Z","followers":0,"following":0,"html_url":"https://github.com/akien-mga","id":4701338,"node_id":"MDQ6VXNlcjQ3MDEzMzg=","login":"akien-mga","type":"User","owned_private_repos":0,"public_gists":0,"public_repos":0,"total_private_repos":0,"url":"https://api.github.com/users/akien-mga"},"body":"Seems fine.\r\n\r\nCould you propose these changes upstream to the various libraries patched here? So hopefully they get merged and we can drop our patches eventually.","html_url":"https://github.com/godotengine/godot/pull/111767#pullrequestreview-3537268689","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/111767","author_association":"MEMBER","submitted_at":"2025-12-03T23:04:06Z"}]