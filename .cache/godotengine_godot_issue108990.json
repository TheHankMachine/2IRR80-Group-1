url":"https://api.github.com/repos/godotengine/godot/labels/crash","name":"crash","color":"885544","default":false,"description":"","archived_at":null,"archived_by":null},{"id":1332303119,"node_id":"MDU6TGFiZWwxMzMyMzAzMTE5","url":"https://api.github.com/repos/godotengine/godot/labels/regression","name":"regression","color":"ff63ac","default":false,"description":"","archived_at":null,"archived_by":null}],"state":"closed","locked":false,"assignees":[],"milestone":{"url":"https://api.github.com/repos/godotengine/godot/milestones/22","html_url":"https://github.com/godotengine/godot/milestone/22","labels_url":"https://api.github.com/repos/godotengine/godot/milestones/22/labels","id":12070367,"node_id":"MI_kwDOAO6SJc4AuC3f","number":22,"title":"4.5","description":"","creator":{"login":"Sauermann","id":6299227,"node_id":"MDQ6VXNlcjYyOTkyMjc=","avatar_url":"https://avatars.githubusercontent.com/u/6299227?v=4","gravatar_id":"","url":"https://api.github.com/users/Sauermann","html_url":"https://github.com/Sauermann","followers_url":"https://api.github.com/users/Sauermann/followers","following_url":"https://api.github.com/users/Sauermann/following{/other_user}","gists_url":"https://api.github.com/users/Sauermann/gists{/gist_id}","starred_url":"https://api.github.com/users/Sauermann/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Sauermann/subscriptions","organizations_url":"https://api.github.com/users/Sauermann/orgs","repos_url":"https://api.github.com/users/Sauermann/repos","events_url":"https://api.github.com/users/Sauermann/events{/privacy}","received_events_url":"https://api.github.com/users/Sauermann/received_events","type":"User","user_view_type":"public","site_admin":false},"open_issues":3,"closed_issues":3687,"state":"closed","created_at":"2024-12-19T08:51:28Z","updated_at":"2026-09-04T21:48:38Z","due_on":"2025-09-15T00:00:00Z","closed_at":"2025-09-18T17:13:14Z"},"comments":3,"created_at":"2025-07-26T09:12:45Z","updated_at":"2025-07-27T15:31:38Z","closed_at":"2025-07-27T15:31:38Z","assignee":null,"author_association":"CONTRIBUTOR","issue_field_values":[],"type":null,"active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"### Tested versions\n\nReproducible in: 4.5.beta [0dd9178269e447aca805bc4b4a9a840119c10275]\nNot reproducible in: 4.5.beta [8acc596bcfbeab009c2aded1e9da20448d392fdc]\n\n### System information\n\nGodot v4.5.beta (0dd917826) - Fedora Linux 42 (Adams) on Wayland - X11 display driver, Multi-window, 2 monitors - Vulkan (Forward+) - dedicated AMD Radeon RX 9070 XT (RADV GFX1201) - AMD Ryzen 9 9950X3D 16-Core Processor (32 threads) - 60.39 GiB memory\n\n### Issue description\n\nWhen running `--headless --import` on seemingly any project that has any autoload singleton, you get the following crash: `signal SIGSEGV: address not mapped to object` with this backtrace:\n\n```\nSceneTree::get_root() const (scene/main/scene_tree.h:300)\nEditorAutoloadSettings::init_autoloads() (editor/settings/editor_autoload_settings.cpp:454)\nProjectSettingsEditor::init_autoloads() (editor/settings/project_settings_editor.cpp:117)\nEditorFileSystem::_first_scan_filesystem() (editor/file_system/editor_file_system.cpp:340)\nEditorFileSystem::scan() (editor/file_system/editor_file_system.cpp:1070)\nEditorNode::_begin_first_scan() (editor/editor_node.cpp:5623)\nEditorNode::_notification(int) (editor/editor_node.cpp:854)\nEditorNode::_notification_forwardv(int) (editor/editor_node.h:118)\nObject::_notification_forward(int) (core/object/object.cpp:931)\nObject::notification(int, bool) (core/object/object.h:890)\nNode::_propagate_enter_tree() (scene/main/node.cpp:341)\nNode::_propagate_enter_tree() (scene/main/node.cpp:360)\nNode::_set_tree(SceneTree*) (scene/main/node.cpp:3311)\nSceneTree::initialize() (scene/main/scene_tree.cpp:568)\nOS_LinuxBSD::run() (platform/linuxbsd/os_linuxbsd.cpp:975)\nmain (platform/linuxbsd/godot_linuxbsd.cpp:85)\n```\n\nWhich seems to be because this error gets tripped:\n\nhttps://github.com/godotengine/godot/blob/0dd9178269e447aca805bc4b4a9a840119c10275/scene/main/node.h#L505-L508\n\nThis seems to be a regression from #108893.\n\n### Steps to reproduce\n\n1. Run Godot with `--headless --import` in the MRP.\n2. Note the crash after the `first_scan_filesystem | Creating autoload scripts...` step.\n3. Also note the error saying `ERROR: Parameter \"data.tree\" is null.`.\n\n### Minimal reproduction project (MRP)\n\n[autoload-import-crash.zip](https://github.com/user-attachments/files/21442683/autoload-import-crash.zip)","closed_by":{"login":"Repiteo","id":17489292,"node_id":"MDQ6VXNlcjE3NDg5Mjky","avatar_url":"https://avatars.githubusercontent.com/u/17489292?v=4","gravatar_id":"","url":"https://api.github.com/users/Repiteo","html_url":"https://github.com/Repiteo","followers_url":"https://api.github.com/users/Repiteo/followers","following_url":"https://api.github.com/users/Repiteo/following{/other_user}","gists_url":"https://api.github.com/users/Repiteo/gists{/gist_id}","starred_url":"https://api.github.com/users/Repiteo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Repiteo/subscriptions","organizations_url":"https://api.github.com/users/Repiteo/orgs","repos_url":"https://api.github.com/users/Repiteo/repos","events_url":"https://api.github.com/users/Repiteo/events{/privacy}","received_events_url":"https://api.github.com/users/Repiteo/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/108990/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/godotengine/godot/issues/108990/timeline","performed_via_github_app":null,"state_reason":"completed","pinned_comment":null}