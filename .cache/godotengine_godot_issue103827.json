that csv in LibreOffice Calc, edit it, and save it. Keep LibreOffice Calc open\n- Go back to the Godot project and observe that the csv has failed to import correctly\n- Double click on the asset to try to open it\n- Observe editor crash\n\n### Minimal reproduction project (MRP)\n\n[editor_crash_from_csv.zip](https://github.com/user-attachments/files/19145044/editor_crash_from_csv.zip)\n\n[Crashdump.zip](https://github.com/user-attachments/files/19145073/Crashdump.zip)","closed_by":{"login":"matheusmdx","id":44306054,"node_id":"MDQ6VXNlcjQ0MzA2MDU0","avatar_url":"https://avatars.githubusercontent.com/u/44306054?v=4","gravatar_id":"","url":"https://api.github.com/users/matheusmdx","html_url":"https://github.com/matheusmdx","followers_url":"https://api.github.com/users/matheusmdx/followers","following_url":"https://api.github.com/users/matheusmdx/following{/other_user}","gists_url":"https://api.github.com/users/matheusmdx/gists{/gist_id}","starred_url":"https://api.github.com/users/matheusmdx/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/matheusmdx/subscriptions","organizations_url":"https://api.github.com/users/matheusmdx/orgs","repos_url":"https://api.github.com/users/matheusmdx/repos","events_url":"https://api.github.com/users/matheusmdx/events{/privacy}","received_events_url":"https://api.github.com/users/matheusmdx/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/103827/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/godotengine/godot/issues/103827/timeline","performed_via_github_app":null,"state_reason":"completed","pinned_comment":null}