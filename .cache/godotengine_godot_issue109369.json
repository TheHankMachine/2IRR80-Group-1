chived_at":null,"archived_by":null}],"state":"closed","locked":false,"assignees":[],"milestone":{"url":"https://api.github.com/repos/godotengine/godot/milestones/23","html_url":"https://github.com/godotengine/godot/milestone/23","labels_url":"https://api.github.com/repos/godotengine/godot/milestones/23/labels","id":12939969,"node_id":"MI_kwDOAO6SJc4AxXLB","number":23,"title":"4.6","description":"","creator":{"login":"Repiteo","id":17489292,"node_id":"MDQ6VXNlcjE3NDg5Mjky","avatar_url":"https://avatars.githubusercontent.com/u/17489292?v=4","gravatar_id":"","url":"https://api.github.com/users/Repiteo","html_url":"https://github.com/Repiteo","followers_url":"https://api.github.com/users/Repiteo/followers","following_url":"https://api.github.com/users/Repiteo/following{/other_user}","gists_url":"https://api.github.com/users/Repiteo/gists{/gist_id}","starred_url":"https://api.github.com/users/Repiteo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Repiteo/subscriptions","organizations_url":"https://api.github.com/users/Repiteo/orgs","repos_url":"https://api.github.com/users/Repiteo/repos","events_url":"https://api.github.com/users/Repiteo/events{/privacy}","received_events_url":"https://api.github.com/users/Repiteo/received_events","type":"User","user_view_type":"public","site_admin":false},"open_issues":3,"closed_issues":2978,"state":"closed","created_at":"2025-05-22T16:25:52Z","updated_at":"2026-10-04T16:23:23Z","due_on":null,"closed_at":"2026-01-26T18:09:14Z"},"comments":5,"created_at":"2025-08-06T17:35:01Z","updated_at":"2026-02-07T12:35:22Z","closed_at":"2025-09-16T14:54:35Z","assignee":null,"author_association":"CONTRIBUTOR","issue_field_values":[],"type":null,"active_lock_reason":null,"draft":false,"pull_request":{"url":"https://api.github.com/repos/godotengine/godot/pulls/109369","html_url":"https://github.com/godotengine/godot/pull/109369","diff_url":"https://github.com/godotengine/godot/pull/109369.diff","patch_url":"https://github.com/godotengine/godot/pull/109369.patch","merged_at":"2025-09-16T14:54:35Z"},"body":"Bug fixes for two issues related to Material Conversions.\r\n\r\n**Bug 1:**  Select user behaviors could call a Material Conversion Plugin on a Material that has not yet initialized, throwing errors to the console, and performing a destructive conversion, deleting the original material and producing an incorrect converted result.\r\n<img width=\"719\" height=\"263\" alt=\"Screenshot 2025-08-06 at 10 16 41 AM\" src=\"https://github.com/user-attachments/assets/3d986d5a-6a7e-47e1-b1ff-5fd6bb903e1a\" />\r\n**Steps to Recreate:** New Project, create a new CanvasItemMaterial resource, duplicate the CanvasItemMaterial, right click and \"Convert to ShaderMaterial\" on the duplicate resource.\r\nOR\r\nNew Project, create a new CanvasItemMaterial resource, close project, reopen project, right click and \"Convert to ShaderMaterial\" on the CanvasItemMaterial resource.\r\n\r\n**Fix:** Expose Material.is_initialized() as a public function instead of protected so the ConversionPlugin can check initialization state to throw the error earlier in the process. The same behaviors now produce a more clear error, and don't modify/delete any files.\r\n<img width=\"765\" height=\"127\" alt=\"Screenshot 2025-08-06 at 10 25 16 AM\" src=\"https://github.com/user-attachments/assets/7661f0c8-d691-47bb-86e0-480b5a06e226\" />\r\n\r\n\r\n\r\n**Bug 2:** FileSystem Dock didn't actually handle the failure of a ConversionPlugin returning a Null Ref<Resource> and would crash the editor trying to use the result.\r\n**Steps to Recreate:** I couldn't find an in-editor way to produce this crash, because the Material Conversion plugins had only the most basic failure state (mat.is_null) which should never happen. If you edit a MaterialConversionPlugin to `ERR_FAIL_COND_V(true, Ref<Resource>());`, build Godot, and use that conversion plugin, you can see the crash occur from FileSystemDock.\r\n**Fix:** FileSystemDock handling a convert action has a check `ERR_FAIL_COND(converted_res.is_null());`","closed_by":{"login":"Repiteo","id":17489292,"node_id":"MDQ6VXNlcjE3NDg5Mjky","avatar_url":"https://avatars.githubusercontent.com/u/17489292?v=4","gravatar_id":"","url":"https://api.github.com/users/Repiteo","html_url":"https://github.com/Repiteo","followers_url":"https://api.github.com/users/Repiteo/followers","following_url":"https://api.github.com/users/Repiteo/following{/other_user}","gists_url":"https://api.github.com/users/Repiteo/gists{/gist_id}","starred_url":"https://api.github.com/users/Repiteo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Repiteo/subscriptions","organizations_url":"https://api.github.com/users/Repiteo/orgs","repos_url":"https://api.github.com/users/Repiteo/repos","events_url":"https://api.github.com/users/Repiteo/events{/privacy}","received_events_url":"https://api.github.com/users/Repiteo/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/109369/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/godotengine/godot/issues/109369/timeline","performed_via_github_app":null,"state_reason":null}