Op7T9A","user":{"login":"vaner-org","id":9658355,"node_id":"MDQ6VXNlcjk2NTgzNTU=","avatar_url":"https://avatars.githubusercontent.com/u/9658355?v=4","gravatar_id":"","url":"https://api.github.com/users/vaner-org","html_url":"https://github.com/vaner-org","followers_url":"https://api.github.com/users/vaner-org/followers","following_url":"https://api.github.com/users/vaner-org/following{/other_user}","gists_url":"https://api.github.com/users/vaner-org/gists{/gist_id}","starred_url":"https://api.github.com/users/vaner-org/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/vaner-org/subscriptions","organizations_url":"https://api.github.com/users/vaner-org/orgs","repos_url":"https://api.github.com/users/vaner-org/repos","events_url":"https://api.github.com/users/vaner-org/events{/privacy}","received_events_url":"https://api.github.com/users/vaner-org/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-08-13T09:22:34Z","updated_at":"2026-09-02T02:15:53Z","body":"Has this been cherry picked? @Repiteo","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5278454772/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null}]