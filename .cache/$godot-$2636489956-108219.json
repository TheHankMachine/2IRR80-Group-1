:"https://api.github.com/repos/godotengine/godot/pulls/108219","author_association":"CONTRIBUTOR","submitted_at":"2025-12-16T12:25:51Z"},{"id":3585492499,"node_id":"PRR_kwDOAO6SJc7VtkYT","state":"COMMENTED","user":{"site_admin":false,"suspended":false,"updated_at":"0001-01-01T00:00:00Z","avatar_url":"https://avatars.githubusercontent.com/u/180032?u=68d23e7ee9cdf810da125e8510b72f845b9dccc8&v=4","created_at":"0001-01-01T00:00:00Z","followers":0,"following":0,"html_url":"https://github.com/Calinou","id":180032,"node_id":"MDQ6VXNlcjE4MDAzMg==","login":"Calinou","type":"User","owned_private_repos":0,"public_gists":0,"public_repos":0,"total_private_repos":0,"url":"https://api.github.com/users/Calinou"},"body":"","html_url":"https://github.com/godotengine/godot/pull/108219#pullrequestreview-3585492499","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/108219","author_association":"MEMBER","submitted_at":"2025-12-17T00:27:24Z"},{"id":3585496686,"node_id":"PRR_kwDOAO6SJc7VtlZu","state":"COMMENTED","user":{"site_admin":false,"suspended":false,"updated_at":"0001-01-01T00:00:00Z","avatar_url":"https://avatars.githubusercontent.com/u/180032?u=68d23e7ee9cdf810da125e8510b72f845b9dccc8&v=4","created_at":"0001-01-01T00:00:00Z","followers":0,"following":0,"html_url":"https://github.com/Calinou","id":180032,"node_id":"MDQ6VXNlcjE4MDAzMg==","login":"Calinou","type":"User","owned_private_repos":0,"public_gists":0,"public_repos":0,"total_private_repos":0,"url":"https://api.github.com/users/Calinou"},"body":"","html_url":"https://github.com/godotengine/godot/pull/108219#pullrequestreview-3585496686","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/108219","author_association":"MEMBER","submitted_at":"2025-12-17T00:29:07Z"},{"id":3599597704,"node_id":"PRR_kwDOAO6SJc7WjYCI","state":"COMMENTED","user":{"site_admin":false,"suspended":false,"updated_at":"0001-01-01T00:00:00Z","avatar_url":"https://avatars.githubusercontent.com/u/53947784?u=1bf2304