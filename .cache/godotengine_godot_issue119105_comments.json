bmaszyna/materials/material_manager.gd\"\n-MaterialParser=\"*res://addons/libmaszyna/materials/material_parser.gd\"\n-E3DParser=\"*res://addons/libmaszyna/e3d/e3d_parser.gd\"\n-E3DModelManager=\"*res://addons/libmaszyna/e3d/e3d_model_manager.gd\"\n-E3DNodesInstancer=\"*res://addons/libmaszyna/e3d/e3d_nodes_instancer.gd\"\n-UserSettings=\"*res://addons/libmaszyna/settings/user_settings.gd\"\n-E3DModelInstanceManager=\"*res://addons/libmaszyna/e3d/e3d_model_instance_manager.gd\"\n-AudioStreamManager=\"*res://addons/libmaszyna/sound/audio_stream_manager.gd\"\n+SceneryResourceLoader=\"*uid://bgkb12fiqj2y2\"\n+MaszynaEnvironment=\"*uid://3nkx0u4dgdws\"\n+Console=\"*uid://d046w0soh2iou\"\n+MaterialManager=\"*uid://dokfadkw7wrhi\"\n+MaterialParser=\"*uid://7b48fl428yqa\"\n+E3DParser=\"*uid://d08el7q5iodf4\"\n+E3DModelManager=\"*uid://b2v733o52i40x\"\n+E3DNodesInstancer=\"*uid://dl44jll5gimwi\"\n+UserSettings=\"*uid://dd2pj6a7hturn\"\n+E3DModelInstanceManager=\"*uid://bt2jcd405kweg\"\n+AudioStreamManager=\"*uid://cp8sgfk334adm\"\n TrackRenderingServer=\"*res://addons/libmaszyna/servers/track_rendering_server.gd\"\n \n [debug]\n```","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4351197880/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4351212826","html_url":"https://github.com/godotengine/godot/issues/119105#issuecomment-4351212826","issue_url":"https://api.github.com/repos/godotengine/godot/issues/119105","id":4351212826,"node_id":"IC_kwDOAO6SJc8AAAABA1o9Gg","user":{"login":"AThousandShips","id":96648715,"node_id":"U_kgDOBcK-Cw","avatar_url":"https://avatars.githubusercontent.com/u/96648715?v=4","gravatar_id":"","url":"https://api.github.com/users/AThousandShips","html_url":"https://github.com/AThousandShips","followers_url":"https://api.github.com/users/AThousandShips/followers","following_url":"https://api.github.com/users/AThousandShips/following{/other_user}","gists_url":"https://api.github.com/users/AThousandShips/gists{/gist_id}","starred_url":"https://api.github.com/users/AThousandShips/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/AThousandShips/subscriptions","organizations_url":"https://api.github.com/users/AThousandShips/orgs","repos_url":"https://api.github.com/users/AThousandShips/repos","events_url":"https://api.github.com/users/AThousandShips/events{/privacy}","received_events_url":"https://api.github.com/users/AThousandShips/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-04-30T09:17:38Z","updated_at":"2026-04-30T09:17:38Z","body":"That's not an error though that's how the engine handles those things, see the proposal for more discussion \n\nUIDs are preferred because they improve file management\n\nFor errors in those failing to be found that could be any number of causes, please ask for support in the community channels to pin down what's wrong, if you find a bug after that please open a new issue here ","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4351212826/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4351412845","html_url":"https://github.com/godotengine/godot/issues/119105#issuecomment-4351412845","issue_url":"https://api.github.com/repos/godotengine/godot/issues/119105","id":4351412845,"node_id":"IC_kwDOAO6SJc8AAAABA11KbQ","user":{"login":"marcinn","id":139032,"node_id":"MDQ6VXNlcjEzOTAzMg==","avatar_url":"https://avatars.githubusercontent.com/u/139032?v=4","gravatar_id":"","url":"https://api.github.com/users/marcinn","html_url":"https://github.com/marcinn","followers_url":"https://api.github.com/users/marcinn/followers","following_url":"https://api.github.com/users/marcinn/following{/other_user}","gists_url":"https://api.github.com/users/marcinn/gists{/gist_id}","starred_url":"https://api.github.com/users/marcinn/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/marcinn/subscriptions","organizations_url":"https://api.github.com/users/marcinn/orgs","repos_url":"https://api.github.com/users/marcinn/repos","events_url":"https://api.github.com/users/marcinn/events{/privacy}","received_events_url":"https://api.github.com/users/marcinn/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-04-30T09:47:33Z","updated_at":"2026-04-30T09:47:33Z","body":"I understand. \n\nUIDs are doing mess in diffs and project settings. Messages like \"In external resource #0, invalid UID: 'uid://bi5evsb6qv0rj'\"  are common, and we cannot ride out them. This makes it seem like an engine/editor bug, sorry.","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4351412845/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4351426477","html_url":"https://github.com/godotengine/godot/issues/119105#issuecomment-4351426477","issue_url":"https://api.github.com/repos/godotengine/godot/issues/119105","id":4351426477,"node_id":"IC_kwDOAO6SJc8AAAABA11_rQ","user":{"login":"AThousandShips","id":96648715,"node_id":"U_kgDOBcK-Cw","avatar_url":"https://avatars.githubusercontent.com/u/96648715?v=4","gravatar_id":"","url":"https://api.github.com/users/AThousandShips","html_url":"https://github.com/AThousandShips","followers_url":"https://api.github.com/users/AThousandShips/followers","following_url":"https://api.github.com/users/AThousandShips/following{/other_user}","gists_url":"https://api.github.com/users/AThousandShips/gists{/gist_id}","starred_url":"https://api.github.com/users/AThousandShips/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/AThousandShips/subscriptions","organizations_url":"https://api.github.com/users/AThousandShips/orgs","repos_url":"https://api.github.com/users/AThousandShips/repos","events_url":"https://api.github.com/users/AThousandShips/events{/privacy}","received_events_url":"https://api.github.com/users/AThousandShips/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-04-30T09:49:39Z","updated_at":"2026-04-30T09:49:39Z","body":"This doesn't happen for most users, so we would need the specific conditions that cause this for you, it might be errors in use, for example you might have forgotten to add the `.uid` files to version control, or moved files incorrectly ","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4351426477/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4351571060","html_url":"https://github.com/godotengine/godot/issues/119105#issuecomment-4351571060","issue_url":"https://api.github.com/repos/godotengine/godot/issues/119105","id":4351571060,"node_id":"IC_kwDOAO6SJc8AAAABA1-0dA","user":{"login":"marcinn","id":139032,"node_id":"MDQ6VXNlcjEzOTAzMg==","avatar_url":"https://avatars.githubusercontent.com/u/139032?v=4","gravatar_id":"","url":"https://api.github.com/users/marcinn","html_url":"https://github.com/marcinn","followers_url":"https://api.github.com/users/marcinn/followers","following_url":"https://api.github.com/users/marcinn/following{/other_user}","gists_url":"https://api.github.com/users/marcinn/gists{/gist_id}","starred_url":"https://api.github.com/users/marcinn/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/marcinn/subscriptions","organizations_url":"https://api.github.com/users/marcinn/orgs","repos_url":"https://api.github.com/users/marcinn/repos","events_url":"https://api.github.com/users/marcinn/events{/privacy}","received_events_url":"https://api.github.com/users/marcinn/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-04-30T10:11:28Z","updated_at":"2026-04-30T10:12:04Z","body":"We have uid files saved in the repo.\n \n1. Branches and merges. Probably uids can be generated differently on different machines.\n2. Branches and merges -> uids makes tscn conflicts, which are quite hard to resolve, because you can easily corrupt tscn file and get parse error. UIDs are taken from other branch, they are probably invalid, and local editor (after merge) regenerates them.  \n3. It is easy to remove  UID  from tscn manually (then editor will regenerate them)\n4. UID probably changes when you're removing then adding same node to the scene (this could happen under development quite often) \n5. Binary res files stores uids / paths to scripts when Resource is dependent on custom classes / other resources. We're storing some data in res files, because it is native for Godot (and very good format, tbh).\n","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4351571060/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4351591995","html_url":"https://github.com/godotengine/godot/issues/119105#issuecomment-4351591995","issue_url":"https://api.github.com/repos/godotengine/godot/issues/119105","id":4351591995,"node_id":"IC_kwDOAO6SJc8AAAABA2AGOw","user":{"login":"AThousandShips","id":96648715,"node_id":"U_kgDOBcK-Cw","avatar_url":"https://avatars.githubusercontent.com/u/96648715?v=4","gravatar_id":"","url":"https://api.github.com/users/AThousandShips","html_url":"https://github.com/AThousandShips","followers_url":"https://api.github.com/users/AThousandShips/followers","following_url":"https://api.github.com/users/AThousandShips/following{/other_user}","gists_url":"https://api.github.com/users/AThousandShips/gists{/gist_id}","starred_url":"https://api.github.com/users/AThousandShips/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/AThousandShips/subscriptions","organizations_url":"https://api.github.com/users/AThousandShips/orgs","repos_url":"https://api.github.com/users/AThousandShips/repos","events_url":"https://api.github.com/users/AThousandShips/events{/privacy}","received_events_url":"https://api.github.com/users/AThousandShips/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-04-30T10:14:28Z","updated_at":"2026-04-30T10:18:27Z","body":"> UID probably changes when you're removing then adding same node to the scene (this could happen under development quite often)\n\nIt does not\n\n> Branches and merges. Probably uids can be generated differently on different machines.\n\nThey are generally not, not for the identical file\n\nBut please ask for support in the other channels and return here if you identify a bug\n\nEdit: though looking at your project it's pretty obviously user error if it's inside the demo, as you haven't included the addon you're referencing","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4351591995/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4351804902","html_url":"https://github.com/godotengine/godot/issues/119105#issuecomment-4351804902","issue_url":"https://api.github.com/repos/godotengine/godot/issues/119105","id":4351804902,"node_id":"IC_kwDOAO6SJc8AAAABA2NF5g","user":{"login":"marcinn","id":139032,"node_id":"MDQ6VXNlcjEzOTAzMg==","avatar_url":"https://avatars.githubusercontent.com/u/139032?v=4","gravatar_id":"","url":"https://api.github.com/users/marcinn","html_url":"https://github.com/marcinn","followers_url":"https://api.github.com/users/marcinn/followers","following_url":"https://api.github.com/users/marcinn/following{/other_user}","gists_url":"https://api.github.com/users/marcinn/gists{/gist_id}","starred_url":"https://api.github.com/users/marcinn/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/marcinn/subscriptions","organizations_url":"https://api.github.com/users/marcinn/orgs","repos_url":"https://api.github.com/users/marcinn/repos","events_url":"https://api.github.com/users/marcinn/events{/privacy}","received_events_url":"https://api.github.com/users/marcinn/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-04-30T10:49:02Z","updated_at":"2026-04-30T10:49:02Z","body":"Thanks. I have no time to fight with uids, nor reproduce cases when they changing, so I'll wait until I can disable them. \n\nPS. Addon is always included by symlink.","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4351804902/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4351822061","html_url":"https://github.com/godotengine/godot/issues/119105#issuecomment-4351822061","issue_url":"https://api.github.com/repos/godotengine/godot/issues/119105","id":4351822061,"node_id":"IC_kwDOAO6SJc8AAAABA2OI7Q","user":{"login":"AThousandShips","id":96648715,"node_id":"U_kgDOBcK-Cw","avatar_url":"https://avatars.githubusercontent.com/u/96648715?v=4","gravatar_id":"","url":"https://api.github.com/users/AThousandShips","html_url":"https://github.com/AThousandShips","followers_url":"https://api.github.com/users/AThousandShips/followers","following_url":"https://api.github.com/users/AThousandShips/following{/other_user}","gists_url":"https://api.github.com/users/AThousandShips/gists{/gist_id}","starred_url":"https://api.github.com/users/AThousandShips/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/AThousandShips/subscriptions","organizations_url":"https://api.github.com/users/AThousandShips/orgs","repos_url":"https://api.github.com/users/AThousandShips/repos","events_url":"https://api.github.com/users/AThousandShips/events{/privacy}","received_events_url":"https://api.github.com/users/AThousandShips/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-04-30T10:51:44Z","updated_at":"2026-04-30T10:51:44Z","body":"Try using without symlinks, they're not a guaranteed thing to be supported in the editor, nor are they necessarily included in VCS (they aren't at least in the GitHub of your repo, so probably causing the problem)\n\nBut in that case do add your support to those proposals, and if you run into a concrete bug please report it, but otherwise please refer to the other community channels","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4351822061/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4356574041","html_url":"https://github.com/godotengine/godot/issues/119105#issuecomment-4356574041","issue_url":"https://api.github.com/repos/godotengine/godot/issues/119105","id":4356574041,"node_id":"IC_kwDOAO6SJc8AAAABA6wLWQ","user":{"login":"marcinn","id":139032,"node_id":"MDQ6VXNlcjEzOTAzMg==","avatar_url":"https://avatars.githubusercontent.com/u/139032?v=4","gravatar_id":"","url":"https://api.github.com/users/marcinn","html_url":"https://github.com/marcinn","followers_url":"https://api.github.com/users/marcinn/followers","following_url":"https://api.github.com/users/marcinn/following{/other_user}","gists_url":"https://api.github.com/users/marcinn/gists{/gist_id}","starred_url":"https://api.github.com/users/marcinn/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/marcinn/subscriptions","organizations_url":"https://api.github.com/users/marcinn/orgs","repos_url":"https://api.github.com/users/marcinn/repos","events_url":"https://api.github.com/users/marcinn/events{/privacy}","received_events_url":"https://api.github.com/users/marcinn/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-04-30T22:24:45Z","updated_at":"2026-04-30T22:25:07Z","body":"Thanks. Symlinks are fine, transparent to the editor, and guaranteed by build system.\n\nI read proposals mentioned by you, and I saw that others have similar issues and thoughts. I understand that uid system solves some rare cases related to renaming, but it also introduces new difficulties.\n\nGodot can handle resources without and with uids. The thing is just about accepting a PR with a project setting, which will stop adding UIDs by the editor. That's all. Thanks.\n","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4356574041/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null}]