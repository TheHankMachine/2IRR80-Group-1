itor with `python3 -m SCons platform=macos target=editor dev_build=yes metal=yes vulkan=no angle=no accesskit=no -j8`\r\n\r\n\r\nhttps://github.com/user-attachments/assets/4e7c134e-6f1d-4d12-8f80-9ab2c34d53ae\r\n\r\nAI assistance was used for debugging this issue.\r\n","closed_by":{"login":"aukaukauk","id":87893880,"node_id":"MDQ6VXNlcjg3ODkzODgw","avatar_url":"https://avatars.githubusercontent.com/u/87893880?v=4","gravatar_id":"","url":"https://api.github.com/users/aukaukauk","html_url":"https://github.com/aukaukauk","followers_url":"https://api.github.com/users/aukaukauk/followers","following_url":"https://api.github.com/users/aukaukauk/following{/other_user}","gists_url":"https://api.github.com/users/aukaukauk/gists{/gist_id}","starred_url":"https://api.github.com/users/aukaukauk/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/aukaukauk/subscriptions","organizations_url":"https://api.github.com/users/aukaukauk/orgs","repos_url":"https://api.github.com/users/aukaukauk/repos","events_url":"https://api.github.com/users/aukaukauk/events{/privacy}","received_events_url":"https://api.github.com/users/aukaukauk/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/119193/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/godotengine/godot/issues/119193/timeline","performed_via_github_app":null,"state_reason":null}