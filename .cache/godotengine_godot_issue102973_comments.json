odot/issues/comments/2892029368/reactions","total_count":1,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":1,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2892032212","html_url":"https://github.com/godotengine/godot/issues/102973#issuecomment-2892032212","issue_url":"https://api.github.com/repos/godotengine/godot/issues/102973","id":2892032212,"node_id":"IC_kwDOAO6SJc6sYOjU","user":{"login":"ytianle","id":61530469,"node_id":"MDQ6VXNlcjYxNTMwNDY5","avatar_url":"https://avatars.githubusercontent.com/u/61530469?v=4","gravatar_id":"","url":"https://api.github.com/users/ytianle","html_url":"https://github.com/ytianle","followers_url":"https://api.github.com/users/ytianle/followers","following_url":"https://api.github.com/users/ytianle/following{/other_user}","gists_url":"https://api.github.com/users/ytianle/gists{/gist_id}","starred_url":"https://api.github.com/users/ytianle/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/ytianle/subscriptions","organizations_url":"https://api.github.com/users/ytianle/orgs","repos_url":"https://api.github.com/users/ytianle/repos","events_url":"https://api.github.com/users/ytianle/events{/privacy}","received_events_url":"https://api.github.com/users/ytianle/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-05-19T19:15:46Z","updated_at":"2025-05-19T19:15:46Z","body":"Gotcha, thanks! That makes sense to me :)","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2892032212/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2892720570","html_url":"https://github.com/godotengine/godot/issues/102973#issuecomment-2892720570","issue_url":"https://api.github.com/repos/godotengine/godot/issues/102973","id":2892720570,"node_id":"IC_kwDOAO6SJc6sa2m6","user":{"login":"ytianle","id":61530469,"node_id":"MDQ6VXNlcjYxNTMwNDY5","avatar_url":"https://avatars.githubusercontent.com/u/61530469?v=4","gravatar_id":"","url":"https://api.github.com/users/ytianle","html_url":"https://github.com/ytianle","followers_url":"https://api.github.com/users/ytianle/followers","following_url":"https://api.github.com/users/ytianle/following{/other_user}","gists_url":"https://api.github.com/users/ytianle/gists{/gist_id}","starred_url":"https://api.github.com/users/ytianle/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/ytianle/subscriptions","organizations_url":"https://api.github.com/users/ytianle/orgs","repos_url":"https://api.github.com/users/ytianle/repos","events_url":"https://api.github.com/users/ytianle/events{/privacy}","received_events_url":"https://api.github.com/users/ytianle/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-05-20T02:22:07Z","updated_at":"2025-05-20T02:22:07Z","body":"I think the smooth shading issue can be avoided using what Calinou said: \"One way to work around this issue is to design your geometry with smooth shading in mind. Create additional edge loops in Blender and (optionally) make the box's edges slightly rounded in the process. The Bevel modifier can help with this.\"\n\nThe core reason the normal is integrated is that each visual vertex has been merged (in create_from_trimesh()) from the physics vertices and the visual vertex's normal is calculated by the average of the face normal. Thus no matter if we are using flat mode in shader or not, the vertices's normal is already integrated.\n\nSo I think unless we want to avoid these visual nodes merging (which I think is not available considering the engine efficiency), the best way is to use another more complex mesh cube (subdivided or modified by Bevel). \n\nI will stop digging into this. Please let me know if the team wants me to help to substitute the default cube mesh. Thanks!","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2892720570/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2894812278","html_url":"https://github.com/godotengine/godot/issues/102973#issuecomment-2894812278","issue_url":"https://api.github.com/repos/godotengine/godot/issues/102973","id":2894812278,"node_id":"IC_kwDOAO6SJc6si1R2","user":{"login":"Calinou","id":180032,"node_id":"MDQ6VXNlcjE4MDAzMg==","avatar_url":"https://avatars.githubusercontent.com/u/180032?v=4","gravatar_id":"","url":"https://api.github.com/users/Calinou","html_url":"https://github.com/Calinou","followers_url":"https://api.github.com/users/Calinou/followers","following_url":"https://api.github.com/users/Calinou/following{/other_user}","gists_url":"https://api.github.com/users/Calinou/gists{/gist_id}","starred_url":"https://api.github.com/users/Calinou/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Calinou/subscriptions","organizations_url":"https://api.github.com/users/Calinou/orgs","repos_url":"https://api.github.com/users/Calinou/repos","events_url":"https://api.github.com/users/Calinou/events{/privacy}","received_events_url":"https://api.github.com/users/Calinou/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-05-20T15:16:02Z","updated_at":"2025-05-20T15:16:02Z","body":"> I will stop digging into this. Please let me know if the team wants me to help to substitute the default cube mesh. Thanks!\n\nWe should keep the default BoxMesh as-is, but it might be worth thinking about adding a property to make it have rounded edges. This would also benefit the 3D material preview.","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2894812278/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null}]