0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2649322162","html_url":"https://github.com/godotengine/godot/issues/102108#issuecomment-2649322162","issue_url":"https://api.github.com/repos/godotengine/godot/issues/102108","id":2649322162,"node_id":"IC_kwDOAO6SJc6d6XKy","user":{"login":"a-johnston","id":9058941,"node_id":"MDQ6VXNlcjkwNTg5NDE=","avatar_url":"https://avatars.githubusercontent.com/u/9058941?v=4","gravatar_id":"","url":"https://api.github.com/users/a-johnston","html_url":"https://github.com/a-johnston","followers_url":"https://api.github.com/users/a-johnston/followers","following_url":"https://api.github.com/users/a-johnston/following{/other_user}","gists_url":"https://api.github.com/users/a-johnston/gists{/gist_id}","starred_url":"https://api.github.com/users/a-johnston/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/a-johnston/subscriptions","organizations_url":"https://api.github.com/users/a-johnston/orgs","repos_url":"https://api.github.com/users/a-johnston/repos","events_url":"https://api.github.com/users/a-johnston/events{/privacy}","received_events_url":"https://api.github.com/users/a-johnston/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-02-10T21:50:56Z","updated_at":"2025-02-10T21:52:42Z","body":"No worries, I was mostly asking because so far nobody else has mentioned being able to repro and it seems potentially multifaceted. I cleaned up the stashed changes I was messing around with last week here https://github.com/a-johnston/godot/commit/f230e9722b6c228d306308b69315c983825ac809 and while I think this addresses the issue I also don't know if it's just less likely (since it seems like a race) or if this goes too far and impacts some other functionality.\n\nEdit- maybe should mention I was testing opening/closing a tab, switching between two tabs with possible pins, and having multiple pinnable nodes within the same tab","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2649322162/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null}]