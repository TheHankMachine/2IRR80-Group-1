[{"id":3455850749,"node_id":"PRR_kwDOAO6SJc7N_Bj9","state":"COMMENTED","user":{"site_admin":false,"suspended":false,"updated_at":"0001-01-01T00:00:00Z","avatar_url":"https://avatars.githubusercontent.com/u/2308167?u=f7f8e0273f784f5ec6f6b7fe4a88d449896eb48a&v=4","created_at":"0001-01-01T00:00:00Z","followers":0,"following":0,"html_url":"https://github.com/Ivorforce","id":2308167,"node_id":"MDQ6VXNlcjIzMDgxNjc=","login":"Ivorforce","type":"User","owned_private_repos":0,"public_gists":0,"public_repos":0,"total_private_repos":0,"url":"https://api.github.com/users/Ivorforce"},"body":"We discussed this fix in the core meeting.\r\nWe agree that the approach you take (rejecting the object deletion in the editor only) is appropriate.\r\n\r\nHowever, there are two changes I think are needed:\r\n\r\n- Check for whether it's actually the editor via `Engine::get_singleton()->is_editor_hint()`. Otherwise, the runtime using the editor binary will also reject the deletion, causing a discrepancy in `DEBUG` vs `RELEASE`.\r\n- Move this check to `node.cpp` in the `NOTIFICATION_PREDELETE` handler, right after the `is_main_thread` check. This will prevent the same kind of bug when using `.free()` and `memdelete`. You can reject deletion here using `cancel_free()` (and `return`).\r\n","html_url":"https://github.com/godotengine/godot/pull/112401#pullrequestreview-3455850749","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/112401","author_association":"MEMBER","submitted_at":"2025-11-12T22:54:55Z"},{"id":3459629929,"node_id":"PRR_kwDOAO6SJc7ONcNp","state":"APPROVED","user":{"site_admin":false,"suspended":false,"updated_at":"0001-01-01T00:00:00Z","avatar_url":"https://avatars.githubusercontent.com/u/2308167?u=f7f8e0273f784f5ec6f6b7fe4a88d449896eb48a&v=4","created_at":"0001-01-01T00:00:00Z","followers":0,"following":0,"html_url":"https://github.com/Ivorforce","id":2308167,"node_id":"MDQ6VXNlcjIzMDgxNjc=","login":"Ivorforce","type":"User","owned_private_repos":0,"public_gists":0,"public_repos":0,"total_private_repos":0,"url":"https://api.github.com/users/Ivorforce"},"body":"Looks good to me, thanks for adjusting.\n\nI tested that this new version still fixes the issue.","html_url":"https://github.com/godotengine/godot/pull/112401#pullrequestreview-3459629929","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/112401","author_association":"MEMBER","submitted_at":"2025-11-13T12:46:54Z"},{"id":3459712466,"node_id":"PRR_kwDOAO6SJc7ONwXS","state":"COMMENTED","user":{"site_admin":false,"suspended":false,"updated_at":"0001-01-01T00:00:00Z","avatar_url":"https://avatars.githubusercontent.com/u/96648715?u=af70f5d107e9c1447f296643d5a566dab53d25e8&v=4","created_at":"0001-01-01T00:00:00Z","followers":0,"following":0,"html_url":"https://github.com/AThousandShips","id":96648715,"node_id":"U_kgDOBcK-Cw","login":"AThousandShips","type":"User","owned_private_repos":0,"public_gists":0,"public_repos":0,"total_private_repos":0,"url":"https://api.github.com/users/AThousandShips"},"body":"","html_url":"https://github.com/godotengine/godot/pull/112401#pullrequestreview-3459712466","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/112401","author_association":"MEMBER","submitted_at":"2025-11-13T13:06:55Z"},{"id":3459737859,"node_id":"PRR_kwDOAO6SJc7ON2kD","state":"COMMENTED","commit_id":"63d131967482bc81e1d50e25881e4cace2da4e9e","user":{"site_admin":false,"suspended":false,"updated_at":"0001-01-01T00:00:00Z","avatar_url":"https://avatars.githubusercontent.com/u/96648715?u=af70f5d107e9c1447f296643d5a566dab53d25e8&v=4","created_at":"0001-01-01T00:00:00Z","followers":0,"following":0,"html_url":"https://github.com/AThousandShips","id":96648715,"node_id":"U_kgDOBcK-Cw","login":"AThousandShips","type":"User","owned_private_repos":0,"public_gists":0,"public_repos":0,"total_private_repos":0,"url":"https://api.github.com/users/AThousandShips"},"body":"","html_url":"https://github.com/godotengine/godot/pull/112401#pul