github.com/users/Mickeon/repos","events_url":"https://api.github.com/users/Mickeon/events{/privacy}","received_events_url":"https://api.github.com/users/Mickeon/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"","state":"COMMENTED","html_url":"https://github.com/godotengine/godot/pull/111498#pullrequestreview-3333265484","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/111498","author_association":"MEMBER","_links":{"html":{"href":"https://github.com/godotengine/godot/pull/111498#pullrequestreview-3333265484"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/111498"}},"submitted_at":"2025-10-13T22:43:57Z","commit_id":null},{"id":3335116489,"node_id":"PRR_kwDOAO6SJc7GydbJ","user":{"login":"dsnopek","id":191561,"node_id":"MDQ6VXNlcjE5MTU2MQ==","avatar_url":"https://avatars.githubusercontent.com/u/191561?v=4","gravatar_id":"","url":"https://api.github.com/users/dsnopek","html_url":"https://github.com/dsnopek","followers_url":"https://api.github.com/users/dsnopek/followers","following_url":"https://api.github.com/users/dsnopek/following{/other_user}","gists_url":"https://api.github.com/users/dsnopek/gists{/gist_id}","starred_url":"https://api.github.com/users/dsnopek/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/dsnopek/subscriptions","organizations_url":"https://api.github.com/users/dsnopek/orgs","repos_url":"https://api.github.com/users/dsnopek/repos","events_url":"https://api.github.com/users/dsnopek/events{/privacy}","received_events_url":"https://api.github.com/users/dsnopek/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"> I updated this PR with these changes:\r\n> \r\n> * Serialize NaN as `null` instead of `\"NaN\"`.\r\n> * Print a warning when encoding NaN similar to PR [Core: Enforce strict JSON for non-finite numbers, document native workaround #111608](https://github.com/godotengine/godot/pull/111608) (not the same message, and not for Infinity)\r\n> * Add a warning to the documentation similar to PR [Core: Enforce strict JSON for non-finite numbers, document native workaround #111608](https://github.com/godotengine/godot/pull/111608) (not the same docs, but similar, thanks @Repiteo).\r\n\r\nOk, so with these changes, I think this is now satisfying the requirements (as I remember them) that were set out at the core team meeting:\r\n\r\n1. We match the behavior of another big project. I don't know how \"big\" graphite-web is, but serializing `NaN` as `null` also matches the behavior of `JSON.stringify()` in web browsers (if I open Chrome's devtools and type `JSON.stringify({\"a\": NaN\"})` into the console it outputs `'{\"a\":null}'`) which is certainly a big enough target :-)\r\n2. We print a warning, so developers have a clue to follow if they get unexpected results from a web service or whatever application they are giving the JSON to\r\n\r\nSo, I approve! However, since this was reverted, it should probably get a few more approvals before going forward","state":"APPROVED","html_url":"https://github.com/godotengine/godot/pull/111498#pullrequestreview-3335116489","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/111498","author_association":"CONTRIBUTOR","_links":{"html":{"href":"https://github.com/godotengine/godot/pull/111498#pullrequestreview-3335116489"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/111498"}},"submitted_at":"2025-10-14T11:29:40Z","commit_id":null},{"id":3336158882,"node_id":"PRR_kwDOAO6SJc7G2b6i","user":{"login":"Repiteo","id":17489292,"node_id":"MDQ6VXNlcjE3NDg5Mjky","avatar_url":"https://avatars.githubusercontent.com/u/17489292?u=34072b401722100a7c0c0d61e37b376cf22b4545&v=4","gravatar_id":"","url":"https://api.github.com/users/Repiteo","html_url":"https://github.com/Repiteo","followers_url":"https://api.github.com/users/Repiteo/followers","following_url":"https://api.github.com/users/Repiteo/following{/other_user}","gists_url":"https://api.github.com/users/Repiteo/gists{/gist_id}","starred_url":"https://api.github.com/users/Repiteo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Repiteo/subscriptions","organizations_url":"https://api.github.com/users/Repiteo/orgs","repos_url":"https://api.github.com/users/Repiteo/repos","events_url":"https://api.github.com/users/Repiteo/events{/privacy}","received_events_url":"https://api.github.com/users/Repiteo/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"I stand by my initial approval; even moreso with the added documentation and using `null` instead of `\"NaN\"`. It does still need core consensus before going anywhere, so we'll be sure to discuss the refactored implementation at tomorrow's core meeting","state":"APPROVED","html_url":"https://github.com/godotengine/godot/pull/111498#pullrequestreview-3336158882","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/111498","author_association":"CONTRIBUTOR","_links":{"html":{"href":"https://github.com/godotengine/godot/pull/111498#pullrequestreview-3336158882"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/111498"}},"submitted_at":"2025-10-14T15:02:16Z","commit_id":null},{"id":3394968747,"node_id":"PRR_kwDOAO6SJc7KWxyr","user":{"login":"Ivorforce","id":2308167,"node_id":"MDQ6VXNlcjIzMDgxNjc=","avatar_url":"https://avatars.githubusercontent.com/u/2308167?u=f7f8e0273f784f5ec6f6b7fe4a88d449896eb48a&v=4","gravatar_id":"","url":"https://api.github.com/users/Ivorforce","html_url":"https://github.com/Ivorforce","followers_url":"https://api.github.com/users/Ivorforce/followers","following_url":"https://api.github.com/users/Ivorforce/following{/other_user}","gists_url":"https://api.github.com/users/Ivorforce/gists{/gist_id}","starred_url":"https://api.github.com/users/Ivorforce/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Ivorforce/su