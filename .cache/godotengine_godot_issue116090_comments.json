s.githubusercontent.com/u/52852?v=4","gravatar_id":"","url":"https://api.github.com/users/stuartcarnie","html_url":"https://github.com/stuartcarnie","followers_url":"https://api.github.com/users/stuartcarnie/followers","following_url":"https://api.github.com/users/stuartcarnie/following{/other_user}","gists_url":"https://api.github.com/users/stuartcarnie/gists{/gist_id}","starred_url":"https://api.github.com/users/stuartcarnie/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/stuartcarnie/subscriptions","organizations_url":"https://api.github.com/users/stuartcarnie/orgs","repos_url":"https://api.github.com/users/stuartcarnie/repos","events_url":"https://api.github.com/users/stuartcarnie/events{/privacy}","received_events_url":"https://api.github.com/users/stuartcarnie/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-02-10T03:03:53Z","updated_at":"2026-02-10T03:03:53Z","body":"> It seems that SAMPLER_REPEAT_MODE_CLAMP_TO_BORDER was not used previously and has been introduced in [#110077](https://github.com/godotengine/godot/pull/110077).\n> \n> https://github.com/search?q=repo%3Agodotengine%2Fgodot%20SAMPLER_REPEAT_MODE_CLAMP_TO_BORDER&type=code\n\n🤦🏻 Of course – you are right! Setting the borderColor property is benign if none of the repeat modes are ClampToBorder…\n\n@clayjohn, @cpl-s-matsuyama narrowed it down. Only Apple7+ GPUs support clamp-to-border, which is surprising… I'm not sure how it's affecting the output or if its generating rendering artefacts. My iPhone 12 Pro has an Apple7 GPU, so I can't verify.","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3875057469/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3875121789","html_url":"https://github.com/godotengine/godot/issues/116090#issuecomment-3875121789","issue_url":"https://api.github.com/repos/godotengine/godot/issues/116090","id":3875121789,"node_id":"IC_kwDOAO6SJc7m-ap9","user":{"login":"clayjohn","id":16521339,"node_id":"MDQ6VXNlcjE2NTIxMzM5","avatar_url":"https://avatars.githubusercontent.com/u/16521339?v=4","gravatar_id":"","url":"https://api.github.com/users/clayjohn","html_url":"https://github.com/clayjohn","followers_url":"https://api.github.com/users/clayjohn/followers","following_url":"https://api.github.com/users/clayjohn/following{/other_user}","gists_url":"https://api.github.com/users/clayjohn/gists{/gist_id}","starred_url":"https://api.github.com/users/clayjohn/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/clayjohn/subscriptions","organizations_url":"https://api.github.com/users/clayjohn/orgs","repos_url":"https://api.github.com/users/clayjohn/repos","events_url":"https://api.github.com/users/clayjohn/events{/privacy}","received_events_url":"https://api.github.com/users/clayjohn/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-02-10T03:31:35Z","updated_at":"2026-02-10T03:31:35Z","body":"We can just switch to CLAMP_TO_EDGE. The difference is subtle and not worth having to maintain a fallback. \n\nIf we reeeeaally wanted to support it, we should have a fallback in the MetalDeviceDriver that checks for support for `CLAMP_TO_BORDER` and falls back to `CLAMP_TO_EDGE` when unsupported","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3875121789/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3875157890","html_url":"https://github.com/godotengine/godot/issues/116090#issuecomment-3875157890","issue_url":"http