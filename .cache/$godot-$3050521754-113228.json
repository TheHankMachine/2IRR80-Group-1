":0,"public_repos":0,"total_private_repos":0,"url":"https://api.github.com/users/dalexeev"},"body":"","html_url":"https://github.com/godotengine/godot/pull/113228#pullrequestreview-3649510848","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/113228","author_association":"CONTRIBUTOR","submitted_at":"2026-01-12T07:54:31Z"},{"id":3649778860,"node_id":"PRR_kwDOAO6SJc7ZizSs","state":"COMMENTED","commit_id":"6d06b3a7d6250cece1c21f7a44312cc97383d99c","user":{"site_admin":false,"suspended":false,"updated_at":"0001-01-01T00:00:00Z","avatar_url":"https://avatars.githubusercontent.com/u/47700418?u=0565b5d99d54afd5fda6712cd8eb05893572baed&v=4","created_at":"0001-01-01T00:00:00Z","followers":0,"following":0,"html_url":"https://github.com/dalexeev","id":47700418,"node_id":"MDQ6VXNlcjQ3NzAwNDE4","login":"dalexeev","type":"User","owned_private_repos":0,"public_gists":0,"public_repos":0,"total_private_repos":0,"url":"https://api.github.com/users/dalexeev"},"body":"","html_url":"https://github.com/godotengine/godot/pull/113228#pullrequestreview-3649778860","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/113228","author_association":"CONTRIBUTOR","submitted_at":"2026-01-12T09:12:06Z"},{"id":3657787708,"node_id":"PRR_kwDOAO6SJc7aBWk8","state":"COMMENTED","commit_id":"6d06b3a7d6250cece1c21f7a44312cc97383d99c","user":{"site_admin":false,"suspended":false,"updated_at":"0001-01-01T00:00:00Z","avatar_url":"https://avatars.githubusercontent.com/u/99511741?u=b7882c94f408976a2f79e8fe6e1ce27fbd48db74&v=4","created_at":"0001-01-01T00:00:00Z","followers":0,"following":0,"html_url":"https://github.com/HolonProduction","id":99511741,"node_id":"U_kgDOBe5tvQ","login":"HolonProduction","type":"User","owned_private_repos":0,"public_gists":0,"public_repos":0,"total_private_repos":0,"url":"https://api.github.com/users/HolonProduction"},"body":"","html_url":"https://github.com/godotengine/godot/pull/113228#pullrequestreview-3657787708","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/113228","author_association":"MEMBER","submitted_at":"2026-01-13T20:16:59Z"},{"id":3657822709,"node_id":"PRR_kwDOAO6SJc7aBfH1","state":"APPROVED","commit_id":"6d06b3a7d6250cece1c21f7a44312cc97383d99c","user":{"site_admin":false,"suspended":false,"updated_at":"0001-01-01T00:00:00Z","avatar_url":"https://avatars.githubusercontent.com/u/99511741?u=b7882c94f408976a2f79e8fe6e1ce27fbd48db74&v=4","created_at":"0001-01-01T00:00:00Z","followers":0,"following":0,"html_url":"https://github.com/HolonProduction","id":99511741,"node_id":"U_kgDOBe5tvQ","login":"HolonProduction","type":"User","owned_private_repos":0,"public_gists":0,"public_repos":0,"total_private_repos":0,"url":"https://api.github.com/users/HolonProduction"},"body":"LGTM. If the change to regular constant folding has any unwanted effects we will find out I guess.\n\nI don't think the \"compat break\" with packed arrays is of much concern. Since there was never a writeback for methods like `append` it was no way to monitor array changes reliable anyway. So I don't see any usecase for the old behavior.","html_url":"https://github.com/godotengine/godot/pull/113228#pullrequestreview-3657822709","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/113228","author_association":"MEMBER","submitted_at":"2026-01-13T20:27:40Z"},{"id":3678020775,"node_id":"PRR_kwDOAO6SJc7bOiSn","state":"APPROVED","commit_id":"6d06b3a7d6250cece1c21f7a44312cc97383d99c","user":{"site_admin":false,"suspended":false,"updated_at":"0001-01-01T00:00:00Z","avatar_url":"https://avatars.githubusercontent.com/u/2308167?u=f7f8e0273f784f5ec6f6b7fe4a88d449896eb48a&v=4","created_at":"0001-01-01T00:00:00Z","followers":0,"following":0,"html_url":"https://github.com/Ivorforce","id":2308167,"node_id":"MDQ6VXNlcjIzMDgxNjc=","login":"Ivorforce","type":"User","owned_private_repos":0,"public_gists":0,"public_repos":0,"total_private_repos":0,"url":"https://api.github.com/users/Ivorforce"},"body":"Core changes look good. Packed arrays are indeed shared inside `Variant`.\r\n\r\nHowever, I think the history of the function should be considered before merge:\r\n\r\n- The function started in GODOT IS OPEN SOURCE without considering packed arrays as shared.\r\n- Later, @vnen changed this via https://github.com/godotengine/godot/pull/62462/, to fix setter related bugs.\r\n- Later still, @vnen reverted this change via https://github.com/godotengine/godot/pull/72398 because packed arrays \"are copied on C++/script boundaries\".\r\n\r\nIndeed, packed arrays behave differently inside and outside `Variant`. For example, `Variant` based calls copy the arrays across the boundary, while the `ptrcall` does not cause a copy to be made.\r\nI still think `is_type_shared` makes sense to be `true` for packed arrays in the context of `Variant`, but we should tread carefully to not overinterpret this information.\r\nI checked `is_type_shared` and `is_shared`, and they seem to only be used inside GDScript / the GDScript vm. \r\n\r\nSo please confirm you're confident the GDScript changes are fine, especially with regards to https://github.com/godotengine/godot/pull/72398 / https://github.com/godotengine/godot/issues/62857. If so, I agree we should merge this.","html_url":"https://github.com/godotengine/godot/pull/113228#pullrequestreview-3678020775","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/113228","author_association":"MEMBER","submitted_at":"2026-01-19T13:06:43Z"},{"id":3678118055,"node_id":"PRR_kwDOAO6SJc7bO6Cn","state":"COMMENTED","commit_id":"6d06b3a7d6250cece1c21f7a44312cc97383d99c","user":{"site_admin":false,"suspended":false,"updated_at":"0001-01-01T00:00:00Z","avatar_url":"https://avatars.githubusercontent.com/u/4884246?v=4","created_at":"0001-01-01T00:00:00Z","followers":0,"following":0,"html_url":"https://github.com/mihe","id":4884246,"node_id":"MDQ6VXNlcjQ4ODQyNDY=","login":"mihe","type":"User","owned_private_repos":0,"public_gists":0,"public_repos":0,"total_private_repos":0,"url":"https://api.github.com/users/mihe"},"body":"","html_url":"https://github.com/godotengine/godot/pull/113228#pullrequestreview-3678118055","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/113228","author_association":"CONTRIBUTOR","submitted_at":"2026-01-19T13:31:45Z"}]