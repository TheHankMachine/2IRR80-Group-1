.com/users/bruvzg/orgs","repos_url":"https://api.github.com/users/bruvzg/repos","events_url":"https://api.github.com/users/bruvzg/events{/privacy}","received_events_url":"https://api.github.com/users/bruvzg/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-03-18T09:47:57Z","updated_at":"2025-03-18T09:47:57Z","body":"> Currently, either half of the texture gets corrupted, or it causes the editor to crash\r\n\r\nWill fix in a moment, I have used the wrong `width` in one place.\r\n\r\n> I can't find where this code actually resizes the source image.\r\n\r\nIt is not (neither this nor etcpak). It's only adding padding to the raw image data.\r\n","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2732373310/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2732439951","html_url":"https://github.com/godotengine/godot/pull/104275#issuecomment-2732439951","issue_url":"https://api.github.com/repos/godotengine/godot/issues/104275","id":2732439951,"node_id":"IC_kwDOAO6SJc6i3bmP","user":{"login":"bruvzg","id":7645683,"node_id":"MDQ6VXNlcjc2NDU2ODM=","avatar_url":"https://avatars.githubusercontent.com/u/7645683?v=4","gravatar_id":"","url":"https://api.github.com/users/bruvzg","html_url":"https://github.com/bruvzg","followers_url":"https://api.github.com/users/bruvzg/followers","following_url":"https://api.github.com/users/bruvzg/following{/other_user}","gists_url":"https://api.github.com/users/bruvzg/gists{/gist_id}","starred_url":"https://api.github.com/users/bruvzg/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/bruvzg/subscriptions","organizations_url":"https://api.github.com/users/bruvzg/orgs","repos_url":"https://api.github.com/users/bruvzg/repos","events_url":"https://api.github.com/users/bruvzg/events{/privacy}","received_events_url":"https://api.github.com/users/bruvzg/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-03-18T09:58:34Z","updated_at":"2025-03-18T09:58:34Z","body":"> Smear the last 3 pixels on x and y instead of resizing could work, but the user would have to know this was done and adjust all their texture coordinates to (x / x + 3) which is really confusing. The fact that it will subtly break UVs is why I don't think we can do this.\r\n\r\nYes, but this is already the case with software `etcpak` (if you disable GPU compression in settings).","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2732439951/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2733158806","html_url":"https://github.com/godotengine/godot/pull/104275#issuecomment-2733158806","issue_url":"https://api.github.com/repos/godotengine/godot/issues/104275","id":2733158806,"node_id":"IC_kwDOAO6SJc6i6LGW","user":{"login":"BlueCube3310","id":53150244,"node_id":"MDQ6VXNlcjUzMTUwMjQ0","avatar_url":"https://avatars.githubusercontent.com/u/53150244?v=4","gravatar_id":"","url":"https://api.github.com/users/BlueCube3310","html_url":"https://github.com/BlueCube3310","followers_url":"https://api.github.com/users/BlueCube3310/followers","following_url":"https://api.github.com/users/BlueCube3310/following{/other_user}","gists_url":"https://api.github.com/users/BlueCube3310/gists{/gist_id}","starred_url":"https://api.github.com/users/BlueCube3310/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/BlueCube3310/subscriptions","organizations_url":"https://api.github.com/users/BlueCube3310/orgs","repos_url":"https://api.github.com/users/BlueCube3310/repos","events