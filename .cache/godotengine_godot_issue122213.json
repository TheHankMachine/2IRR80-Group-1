olor":"ffee88","default":false,"description":"","archived_at":null,"archived_by":null},{"id":955079684,"node_id":"MDU6TGFiZWw5NTUwNzk2ODQ=","url":"https://api.github.com/repos/godotengine/godot/labels/breaks%20compat","name":"breaks compat","color":"b64245","default":false,"description":"","archived_at":null,"archived_by":null}],"state":"closed","locked":false,"assignees":[],"milestone":{"url":"https://api.github.com/repos/godotengine/godot/milestones/25","html_url":"https://github.com/godotengine/godot/milestone/25","labels_url":"https://api.github.com/repos/godotengine/godot/milestones/25/labels","id":15520464,"node_id":"MI_kwDOAO6SJc4A7NLQ","number":25,"title":"4.8","description":"","creator":{"login":"Repiteo","id":17489292,"node_id":"MDQ6VXNlcjE3NDg5Mjky","avatar_url":"https://avatars.githubusercontent.com/u/17489292?v=4","gravatar_id":"","url":"https://api.github.com/users/Repiteo","html_url":"https://github.com/Repiteo","followers_url":"https://api.github.com/users/Repiteo/followers","following_url":"https://api.github.com/users/Repiteo/following{/other_user}","gists_url":"https://api.github.com/users/Repiteo/gists{/gist_id}","starred_url":"https://api.github.com/users/Repiteo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Repiteo/subscriptions","organizations_url":"https://api.github.com/users/Repiteo/orgs","repos_url":"https://api.github.com/users/Repiteo/repos","events_url":"https://api.github.com/users/Repiteo/events{/privacy}","received_events_url":"https://api.github.com/users/Repiteo/received_events","type":"User","user_view_type":"public","site_admin":false},"open_issues":343,"closed_issues":2335,"state":"open","created_at":"2026-04-13T15:59:35Z","updated_at":"2026-10-22T06:28:22Z","due_on":null,"closed_at":null},"comments":2,"created_at":"2026-08-08T17:32:19Z","updated_at":"2026-08-12T14:59:52Z","closed_at":"2026-08-11T16:46:20Z","assignee":null,"author_association":"MEMBER","issue_field_values":[],"type":null,"active_lock_reason":null,"draft":false,"pull_request":{"url":"https://api.github.com/repos/godotengine/godot/pulls/122213","html_url":"https://github.com/godotengine/godot/pull/122213","diff_url":"https://github.com/godotengine/godot/pull/122213.diff","patch_url":"https://github.com/godotengine/godot/pull/122213.patch","merged_at":"2026-08-11T16:46:20Z"},"body":"## What problem(s) does this PR solve?\r\n\r\n- The documentation claims that the local debugger `-d`/`--debug` works in release templates. We also try to initialize the debugger in those templates (while we do already error for `--remote-debug`). However debugging is not functional in those templates (tested using GDScript). So we might as well make this an explicit error. This would allow to exclude debugging infrastructure from release templates (see also https://github.com/godotengine/godot/pull/122210)\r\n\r\n## Additional information\r\n\r\nMRP to validate that local debugging does not work in release: \r\n\r\n[test_export_debugger.zip](https://github.com/user-attachments/files/30860372/test_export_debugger.zip)\r\n\r\nBoth `./<exported bin> -d` (should trigger a `breakpoint` statement) and `./<export bin> -d -b \"res://main.gd:6\"` (should stop at the specified breakpoint) do not halt execution after exporting the project for release.\r\n\r\nIn a very technical sense this breaks compat, since now specifying `-d` does halt the exported program whereas previously it did run the project as if `-d` wasn't specified. I think making users aware of their mistake is more important.\r\n","closed_by":{"login":"Repiteo","id":17489292,"node_id":"MDQ6VXNlcjE3NDg5Mjky","avatar_url":"https://avatars.githubusercontent.com/u/17489292?v=4","gravatar_id":"","url":"https://api.github.com/users/Repiteo","html_url":"https://github.com/Repiteo","followers_url":"https://api.github.com/users/Repiteo/followers","following_url":"https://api.github.com/users/Repiteo/following{/other_user}","gists_url":"https://api.github.com/users/Repiteo/gists{/gist_id}","starred_url":"https://api.github.com/users/Repiteo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Repiteo/subscriptions","organizations_url":"https://api.github.com/users/Repiteo/orgs","repos_url":"https://api.github.com/users/Repiteo/repos","events_url":"https://api.github.com/users/Repiteo/events{/privacy}","received_events_url":"https://api.github.com/users/Repiteo/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/122213/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/godotengine/godot/issues/122213/timeline","performed_via_github_app":null,"state_reason":null}