sers/wolf-walker/following{/other_user}","gists_url":"https://api.github.com/users/wolf-walker/gists{/gist_id}","starred_url":"https://api.github.com/users/wolf-walker/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/wolf-walker/subscriptions","organizations_url":"https://api.github.com/users/wolf-walker/orgs","repos_url":"https://api.github.com/users/wolf-walker/repos","events_url":"https://api.github.com/users/wolf-walker/events{/privacy}","received_events_url":"https://api.github.com/users/wolf-walker/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-06-15T23:57:19Z","updated_at":"2026-06-15T23:57:19Z","body":"I want to create a game with precise aiming and shooting, which makes it difficult for me to immediately respond to finger movements because the first InputEventScreenDrag event requires 13 pixels to trigger. Is there any other way to achieve precise screen touch feedback?","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4713524055/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4713847439","html_url":"https://github.com/godotengine/godot/issues/120322#issuecomment-4713847439","issue_url":"https://api.github.com/repos/godotengine/godot/issues/120322","id":4713847439,"node_id":"IC_kwDOAO6SJc8AAAABGPeajw","user":{"login":"wolf-walker","id":15865849,"node_id":"MDQ6VXNlcjE1ODY1ODQ5","avatar_url":"https://avatars.githubusercontent.com/u/15865849?v=4","gravatar_id":"","url":"https://api.github.com/users/wolf-walker","html_url":"https://github.com/wolf-walker","followers_url":"https://api.github.com/users/wolf-walker/followers","following_url":"https://api.github.com/users/wolf-walker/following{/other_user}","gists_url":"https://api.github.com/users/wolf-walker/gists{/gist_id}","starred_url":"https://api.github.com/users/wolf-walker/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/wolf-walker/subscriptions","organizations_url":"https://api.github.com/users/wolf-walker/orgs","repos_url":"https://api.github.com/users/wolf-walker/repos","events_url":"https://api.github.com/users/wolf-walker/events{/privacy}","received_events_url":"https://api.github.com/users/wolf-walker/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-06-16T00:52:21Z","updated_at":"2026-06-16T00:52:21Z","body":"ProjectSettings.set_setting(\"gui/common/drag_threshold\", 1)\nSetting drag threshold in project settings is invalid, triggering InputEventScreenDrag still requires 13 pixels","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4713847439/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4716633554","html_url":"https://github.com/godotengine/godot/issues/120322#issuecomment-4716633554","issue_url":"https://api.github.com/repos/godotengine/godot/issues/120322","id":4716633554,"node_id":"IC_kwDOAO6SJc8AAAABGSId0g","user":{"login":"AThousandShips","id":96648715,"node_id":"U_kgDOBcK-Cw","avatar_url":"https://avatars.githubusercontent.com/u/96648715?v=4","gravatar_id":"","url":"https://api.github.com/users/AThousandShips","html_url":"https://github.com/AThousandShips","followers_url":"https://api.github.com/users/AThousandShips/followers","following_url":"https://api.github.com/users/AThousandShips/following{/other_user}","gists_url":"https://api.github.com/users/AThousandShips/gists{/gist_id}","starred_url":"https://api.github.com/users/AThousandShips/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/AThousandShips/subscriptions","organizations_url":"https://api.github.com/users/AThousandShips/orgs","repos_url":"https://api.github.com/users/AThousandShips/repos","events_url":"https://api.github.com/users/AThousandShips/events{/privacy}","received_events_url":"https://api.github.com/users/AThousandShips/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-06-16T08:46:21Z","updated_at":"2026-06-16T08:46:21Z","body":"> Setting drag threshold in project settings is invalid, triggering InputEventScreenDrag still requires 13 pixels\n\nBecause that's unrelated, that's for drag and drop\n\nThe code if it exists is probably under `platform/android`","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4716633554/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4716822356","html_url":"https://github.com/godotengine/godot/issues/120322#issuecomment-4716822356","issue_url":"https://api.github.com/repos/godotengine/godot/issues/120322","id":4716822356,"node_id":"IC_kwDOAO6SJc8AAAABGST_VA","user":{"login":"wolf-walker","id":15865849,"node_id":"MDQ6VXNlcjE1ODY1ODQ5","avatar_url":"https://avatars.githubusercontent.com/u/15865849?v=4","gravatar_id":"","url":"https://api.github.com/users/wolf-walker","html_url":"https://github.com/wolf-walker","followers_url":"https://api.github.com/users/wolf-walker/followers","following_url":"https://api.github.com/users/wolf-walker/following{/other_user}","gists_url":"https://api.github.com/users/wolf-walker/gists{/gist_id}","starred_url":"https://api.github.com/users/wolf-walker/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/wolf-walker/subscriptions","organizations_url":"https://api.github.com/users/wolf-walker/orgs","repos_url":"https://api.github.com/users/wolf-walker/repos","events_url":"https://api.github.com/users/wolf-walker/events{/privacy}","received_events_url":"https://api.github.com/users/wolf-walker/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-06-16T09:08:58Z","updated_at":"2026-06-16T09:10:43Z","body":"I have been researching the source code for 8 hours now, and the problem has been identified in the files \"GodotInputHandler. java\" and \"GodotGestureHandler. kt\"\n\n```kt\npublic boolean onTouchEvent(final MotionEvent event) {\n\tlastSeenToolType.set(getEventToolType(event));\n\n\tthis.scaleGestureDetector.onTouchEvent(event);\n\tif (this.gestureDetector.onTouchEvent(event)) {\n\t\t// The gesture detector has handled the event.\n\t\treturn true;\n                **used the \"onScroll\" method of Android GestureDetector here, which consumes and blocks the\n                    \"InputEventScreenDrag\" event from passing, resulting in it not being received in Godot**\n\t}\n\n\tif (godotGestureHandler.onMotionEvent(event)) {\n\t\t// The gesture handler has handled the event.\n\t\treturn true;\n\t}\n\n\t// Drag events are handled by the [GodotGestureHandler]\n\tif (event.getActionMasked() == MotionEvent.ACTION_MOVE) {\n\t\treturn true;\n\t}\n\n\tif (isMouseEvent(event)) {\n\t\treturn handleMouseEvent(event);\n\t}\n\n\treturn handleTouchEvent(event);\n}\n```","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4716822356/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4716841069","html_url":"https://github.com/godotengine/godot/issues/120322#issuecomment-4716841069","issue_url":"https://api.github.com/repos/godotengine/godot/issues/120322","id":4716841069,"node_id":"IC_kwDOAO6SJc8AAAABGSVIbQ","user":{"login":"AThousandShips","id":96648715,"node_id":"U_kgDOBcK-Cw","avatar_url":"https://avatars.githubusercontent.com/u/96648715?v=4","gravatar_id":"","url":"https://api.github.com/users/AThousandShips","html_url":"https://github.com/AThousandShips","followers_url":"https://api.github.com/users/AThousandShips/followers","following_url":"https://api.github.com/users/AThousandShips/following{/other_user}","gists_url":"https://api.github.com/users/AThousandShips/gists{/gist_id}","starred_url":"https://api.github.com/users/AThousandShips/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/AThousandShips/subscriptions","organizations_url":"https://api.github.com/users/AThousandShips/orgs","repos_url":"https://api.github.com/users/AThousandShips/repos","events_url":"https://api.github.com/users/AThousandShips/events{/privacy}","received_events_url":"https://api.github.com/users/AThousandShips/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-06-16T09:11:09Z","updated_at":"2026-06-16T09:11:09Z","body":"Please explain how that does that","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4716841069/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4716945948","html_url":"https://github.com/godotengine/godot/issues/120322#issuecomment-4716945948","issue_url":"https://api.github.com/repos/godotengine/godot/issues/120322","id":4716945948,"node_id":"IC_kwDOAO6SJc8AAAABGSbiHA","user":{"login":"wolf-walker","id":15865849,"node_id":"MDQ6VXNlcjE1ODY1ODQ5","avatar_url":"https://avatars.githubusercontent.com/u/15865849?v=4","gravatar_id":"","url":"https://api.github.com/users/wolf-walker","html_url":"https://github.com/wolf-walker","followers_url":"https://api.github.com/users/wolf-walker/followers","following_url":"https://api.github.com/users/wolf-walker/following{/other_user}","gists_url":"https://api.github.com/users/wolf-walker/gists{/gist_id}","starred_url":"https://api.github.com/users/wolf-walker/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/wolf-walker/subscriptions","organizations_url":"https://api.github.com/users/wolf-walker/orgs","repos_url":"https://api.github.com/users/wolf-walker/repos","events_url":"https://api.github.com/users/wolf-walker/events{/privacy}","received_events_url":"https://api.github.com/users/wolf-walker/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-06-16T09:23:04Z","updated_at":"2026-06-16T09:23:04Z","body":"When the GestureDetector.onTouchEvent() method handles the ACTION_MOVE event, it checks whether the touch has moved by touchSlop pixels. If the movement exceeds this threshold, the onScroll() callback is triggered; otherwise, the callback is not invoked. The InputEventScreenDrag event is dispatched within onScroll().","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4716945948/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4724954927","html_url":"https://github.com/godotengine/godot/issues/120322#issuecomment-4724954927","issue_url":"https://api.github.com/repos/godotengine/godot/issues/120322","id":4724954927,"node_id":"IC_kwDOAO6SJc8AAAABGaEXLw","user":{"login":"wolf-walker","id":15865849,"node_id":"MDQ6VXNlcjE1ODY1ODQ5","avatar_url":"https://avatars.githubusercontent.com/u/15865849?v=4","gravatar_id":"","url":"https://api.github.com/users/wolf-walker","html_url":"https://github.com/wolf-walker","followers_url":"https://api.github.com/users/wolf-walker/followers","following_url":"https://api.github.com/users/wolf-walker/following{/other_user}","gists_url":"https://api.github.com/users/wolf-walker/gists{/gist_id}","starred_url":"https://api.github.com/users/wolf-walker/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/wolf-walker/subscriptions","organizations_url":"https://api.github.com/users/wolf-walker/orgs","repos_url":"https://api.github.com/users/wolf-walker/repos","events_url":"https://api.github.com/users/wolf-walker/events{/privacy}","received_events_url":"https://api.github.com/users/wolf-walker/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-06-17T00:59:59Z","updated_at":"2026-06-17T00:59:59Z","body":"I suggest adding a 'InputEventScreenMove' event to inform all movement information without affecting the processing flow of the 'InputEventScreenDrag' event. This way, operations that require precise screen movement only need to focus on the 'InputEventScreenMove' event.","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4724954927/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null}]