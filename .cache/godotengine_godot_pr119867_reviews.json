uns). The performance benefit is likely more significant on slower GPUs, particularly mobile (I can test later if needed).","state":"COMMENTED","html_url":"https://github.com/godotengine/godot/pull/119867#pullrequestreview-5281486012","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/119867","author_association":"MEMBER","_links":{"html":{"href":"https://github.com/godotengine/godot/pull/119867#pullrequestreview-5281486012"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/119867"}},"submitted_at":"2026-09-22T17:32:08Z","commit_id":"a7dd4f818b76e4c0fb71843328f4eee15e69eb2c"},{"id":5281761235,"node_id":"PRR_kwDOAO6SJc8AAAABOtFH0w","user":{"login":"Image-unavailable","id":56268917,"node_id":"MDQ6VXNlcjU2MjY4OTE3","avatar_url":"https://avatars.githubusercontent.com/u/56268917?v=4","gravatar_id":"","url":"https://api.github.com/users/Image-unavailable","html_url":"https://github.com/Image-unavailable","followers_url":"https://api.github.com/users/Image-unavailable/followers","following_url":"https://api.github.com/users/Image-unavailable/following{/other_user}","gists_url":"https://api.github.com/users/Image-unavailable/gists{/gist_id}","starred_url":"https://api.github.com/users/Image-unavailable/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Image-unavailable/subscriptions","organizations_url":"https://api.github.com/users/Image-unavailable/orgs","repos_url":"https://api.github.com/users/Image-unavailable/repos","events_url":"https://api.github.com/users/Image-unavailable/events{/privacy}","received_events_url":"https://api.github.com/users/Image-unavailable/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"","state":"COMMENTED","html_url":"https://github.com/godotengine/godot/pull/119867#pullrequestreview-5281761235","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/119867","author_association":"CONTRIBUTOR","_links":{"html":{"href":