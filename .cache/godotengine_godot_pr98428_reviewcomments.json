b.com/pafuent","followers_url":"https://api.github.com/users/pafuent/followers","following_url":"https://api.github.com/users/pafuent/following{/other_user}","gists_url":"https://api.github.com/users/pafuent/gists{/gist_id}","starred_url":"https://api.github.com/users/pafuent/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/pafuent/subscriptions","organizations_url":"https://api.github.com/users/pafuent/orgs","repos_url":"https://api.github.com/users/pafuent/repos","events_url":"https://api.github.com/users/pafuent/events{/privacy}","received_events_url":"https://api.github.com/users/pafuent/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"I tried that at the beginning, but I noticed that when `pressed()` is being executed, the popup is not visible anymore because you click outside of it (which hides the popup). If this code is implemented into `pressed()`, `popup->is_visible()` will always return false and that will lead to assume that the popup should be open.\r\nTo overcome that, I implemented this code into `gui_input` which gets executed before the popup is hidden due to a click was made outside of it.","created_at":"2024-11-19T02:52:04Z","updated_at":"2024-11-19T02:52:04Z","html_url":"https://github.com/godotengine/godot/pull/98428#discussion_r1847567014","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/98428","_links":{"self":{"href":"https://api.github.com/repos/godotengine/godot/pulls/comments/1847567014"},"html":{"href":"https://github.com/godotengine/godot/pull/98428#discussion_r1847567014"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/98428"}},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/1847567014/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":2493,"original_line":2493,"side"