er_user}","gists_url":"https://api.github.com/users/fire/gists{/gist_id}","starred_url":"https://api.github.com/users/fire/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/fire/subscriptions","organizations_url":"https://api.github.com/users/fire/orgs","repos_url":"https://api.github.com/users/fire/repos","events_url":"https://api.github.com/users/fire/events{/privacy}","received_events_url":"https://api.github.com/users/fire/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"The logic to check for empty properties to avoid the crash makes sense. Also, the crash has been confirmed. Thirdly, I don't see how it will break the code even if it's wrong, so the risk of merging is low and the benefit of fixing a crash is high.","state":"APPROVED","html_url":"https://github.com/godotengine/godot/pull/99148#pullrequestreview-2433869223","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/99148","author_association":"MEMBER","_links":{"html":{"href":"https://github.com/godotengine/godot/pull/99148#pullrequestreview-2433869223"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/99148"}},"submitted_at":"2024-11-13T16:55:11Z","commit_id":"d1ba15219759e8a7c59d6848a2241b498cf13972"},{"id":2434395375,"node_id":"PRR_kwDOAO6SJc6RGezv","user":{"login":"TokageItLab","id":61938263,"node_id":"MDQ6VXNlcjYxOTM4MjYz","avatar_url":"https://avatars.githubusercontent.com/u/61938263?u=9b90963f1b4f17720e50bbbe495fbe8c84c8bc8e&v=4","gravatar_id":"","url":"https://api.github.com/users/TokageItLab","html_url":"https://github.com/TokageItLab","followers_url":"https://api.github.com/users/TokageItLab/followers","following_url":"https://api.github.com/users/TokageItLab/following{/other_user}","gists_url":"https://api.github.com/users/TokageItLab/gists{/gist_id}","starred_url":"https://api.github.com/users/TokageItLab/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/TokageItLab/subscriptions","organizations_url":"https://api.github.com/users/TokageItLab/orgs","repos_url":"https://api.github.com/users/TokageItLab/repos","events_url":"https://api.github.com/users/TokageItLab/events{/privacy}","received_events_url":"https://api.github.com/users/TokageItLab/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"I cannot reproduce the crash in my environment when I perform the same operation as in the video, so it may be an environment-dependent (Linux?) issue.\r\n\r\nWhat I am concerned about is that this fix is not directly related to the animation, but is a check on the processing timing of the inspector plugin.\r\n\r\nConsidering that the inspector is displayed correctly after the fix, is it possible that the inspector plugin is being called multiple times and somewhere along the way null accesses are occurring? I think we need to take a closer look at why the property is missing there.\r\n\r\nWell, as fire's comment says, it should be a safe change, so I think it's okay with merging it to prevent crashes for now.","state":"APPROVED","html_url":"https://github.com/godotengine/godot/pull/99148#pullrequestreview-2434395375","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/99148","author_association":"MEMBER","_links":{"html":{"href":"https://github.com/godotengine/godot/pull/99148#pullrequestreview-2434395375"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/99148"}},"submitted_at":"2024-11-13T20:56:23Z","commit_id":"d1ba15219759e8a7c59d6848a2241b498cf13972"},{"id":2438222684,"node_id":"PRR_kwDOAO6SJc6RVFNc","user":{"login":"akien-mga","id":4701338,"node_id":"MDQ6VXNlcjQ3MDEzMzg=","avatar_url":"https://avatars.githubusercontent.com/u/4701338?u=4a42fd867f2c449fcc23adf635dd574dae98e6c2&v=4","gravatar_id":"","url":"https://api.github.com/users/akien-mga","html_url":"https://github.com/akien-mga","followers_url":"https://api.github.com/users/akien-mga/followe