09:35:07Z","due_on":null,"closed_at":null},"comments":4,"created_at":"2026-01-06T18:43:53Z","updated_at":"2026-04-16T17:52:48Z","closed_at":null,"assignee":null,"author_association":"NONE","issue_field_values":[],"type":null,"active_lock_reason":null,"draft":false,"pull_request":{"url":"https://api.github.com/repos/godotengine/godot/pulls/114656","html_url":"https://github.com/godotengine/godot/pull/114656","diff_url":"https://github.com/godotengine/godot/pull/114656.diff","patch_url":"https://github.com/godotengine/godot/pull/114656.patch","merged_at":null},"body":"Description:\r\n\r\nFixes #98993\r\n\r\nOmni and Spot light shadow culling in _light_instance_update_shadow() was missing the visibility range check that directional light shadows have in _scene_cull(). This caused objects to cast shadows even when hidden by visibility range.\r\n\r\nAdds the visibility range distance check to all three shadow culling paths (omni dual paraboloid, omni cube, spot).\r\nExample of fix:\r\n[Example.webm](https://github.com/user-attachments/assets/83672fff-cf64-4381-a80a-02728955c3f5)\r\n\r\nAnd example of 4.6-beta2 on MRP:\r\n<img width=\"555\" height=\"440\" alt=\"Screenshot_20260106_135741\" src=\"https://github.com/user-attachments/assets/fc2ebc48-61d7-49db-a17f-74641eccce27\" />\r\nAnd the fix on MRP:\r\n<img width=\"653\" height=\"538\" alt=\"Screenshot_20260106_135829\" src=\"https://github.com/user-attachments/assets/526ce03f-bc71-4404-b37c-6617a7eb1749\" />\r\n","closed_by":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/114656/reactions","total_count":4,"+1":0,"-1":0,"laugh":0,"hooray":4,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/godotengine/godot/issues/114656/timeline","performed_via_github_app":null,"state_reason":null}