xMjgwNDQ=","url":"https://api.github.com/repos/godotengine/godot/labels/confirmed","name":"confirmed","color":"aaddaa","default":false,"description":"","archived_at":null,"archived_by":null}],"state":"open","locked":false,"assignees":[],"milestone":null,"comments":1,"created_at":"2025-05-18T12:22:13Z","updated_at":"2025-06-05T10:43:08Z","closed_at":null,"assignee":null,"author_association":"CONTRIBUTOR","issue_field_values":[],"type":null,"active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"### Tested versions\n\nOfficial 4.4.1.stable\n\n### System information\n\nFedora 42\n\n### Issue description\n\nWhen a node has been added to the scene tree that is based on a script with a `class_name`, the type information does not update when the script's class name is modified.\n\n### Steps to reproduce\n\n1. Create a simple UI scene.\n2. Create a script called `parent.gd` that extend `Node` and has `class_name` set as `Parent`.\n3. Using the `+` button add the Parent node type as a child in the scene tree.\n4. Go back into the script tab and change the script's global class name to `ParentNode` and save.\n5. Hover over the node in the scene tree that was added in 3, it still shows `Type: Parent`.\n\nThe only time the type updates will be if you add a new node as a child to the node in step 3 of that refers to the script with the new global class name.  Adding a sibling node of the new type will not update the scene tree state for any existing nodes.\n\n### Minimal reproduction project (MRP)\n\nN/A","closed_by":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/106559/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/godotengine/godot/issues/106559/timeline","performed_via_github_app":null,"state_reason":null,"pinned_comment":null}