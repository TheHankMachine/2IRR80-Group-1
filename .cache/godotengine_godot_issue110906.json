engine/godot/labels/platform:linuxbsd","name":"platform:linuxbsd","color":"e4e4e4","default":false,"description":"","archived_at":null,"archived_by":null},{"id":890310664,"node_id":"MDU6TGFiZWw4OTAzMTA2NjQ=","url":"https://api.github.com/repos/godotengine/godot/labels/topic:input","name":"topic:input","color":"ffee88","default":false,"description":"","archived_at":null,"archived_by":null},{"id":1332303119,"node_id":"MDU6TGFiZWwxMzMyMzAzMTE5","url":"https://api.github.com/repos/godotengine/godot/labels/regression","name":"regression","color":"ff63ac","default":false,"description":"","archived_at":null,"archived_by":null}],"state":"closed","locked":false,"assignees":[],"milestone":{"url":"https://api.github.com/repos/godotengine/godot/milestones/23","html_url":"https://github.com/godotengine/godot/milestone/23","labels_url":"https://api.github.com/repos/godotengine/godot/milestones/23/labels","id":12939969,"node_id":"MI_kwDOAO6SJc4AxXLB","number":23,"title":"4.6","description":"","creator":{"login":"Repiteo","id":17489292,"node_id":"MDQ6VXNlcjE3NDg5Mjky","avatar_url":"https://avatars.githubusercontent.com/u/17489292?v=4","gravatar_id":"","url":"https://api.github.com/users/Repiteo","html_url":"https://github.com/Repiteo","followers_url":"https://api.github.com/users/Repiteo/followers","following_url":"https://api.github.com/users/Repiteo/following{/other_user}","gists_url":"https://api.github.com/users/Repiteo/gists{/gist_id}","starred_url":"https://api.github.com/users/Repiteo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Repiteo/subscriptions","organizations_url":"https://api.github.com/users/Repiteo/orgs","repos_url":"https://api.github.com/users/Repiteo/repos","events_url":"https://api.github.com/users/Repiteo/events{/privacy}","received_events_url":"https://api.github.com/users/Repiteo/received_events","type":"User","user_view_type":"public","site_admin":false},"open_issues":3,"closed_issues":2978,"state":"closed","created_at":"2025-05-22T16:25:52Z","updated_at":"2026-10-04T16:23:23Z","due_on":null,"closed_at":"2026-01-26T18:09:14Z"},"comments":5,"created_at":"2025-09-25T17:57:43Z","updated_at":"2025-12-15T23:46:36Z","closed_at":"2025-12-15T23:45:51Z","assignee":null,"author_association":"CONTRIBUTOR","issue_field_values":[],"type":null,"active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"### Tested versions\n\n- Reproducible in: 4.5.stable\n- Not reproducible in: 4.4.1.stable\n\n### System information\n\nGodot v4.5.stable.mono - Manjaro Linux #1 SMP PREEMPT_DYNAMIC Sat, 30 Aug 2025 05:31:45 +0000 on Wayland - X11 display driver, Multi-window, 3 monitors - Vulkan (Forward+) - dedicated AMD Radeon RX 7700S (RADV NAVI33) - AMD Ryzen 9 7940HS w/ Radeon 780M Graphics (16 threads) - 30.65 GiB memory\n\n### Issue description\n\nI recently upgraded my project (that has controller support) to Godot 4.5.  However, I have started seeing joypads being detected even when no joypad is plugged in.  On closer inspection I've found that, with no joypad plugged in, `Input.get_connected_joypads()` is now returning:\n```\n[0, 1]\n```\nand `Input.get_joy_name()` with each of these devices returns:\n```\nFramework Laptop 16 Numpad Module System Control\nFramework Laptop 16 Keyboard Module - ISO System Control\n```\n\nIn Godot 4.4.1 (and presumably earlier versions, although I haven't tested them), nothing was returned by `Input.get_connected_joypads()` when nothing is plugged in (as expected).  I'm guessing this has to do with the upgrade to SDL3 for controller support.\n\n### Steps to reproduce\n\nAs far as I'm aware this is only reproducible on Framework laptops but it may affect other laptops (or other keyboards and mice) as well.\n\n1. Create a new project in Godot 4.5\n2. Add a node with this line in `_ready()`:\n    ```\n    print(Input.get_connected_joypads())\n    ```\n3. Unplug all controllers\n4. Run the project\n\nExpected behaviour:\n* Nothing is printed\n\nActual behaviour:\n* A list with some entries (typically `[0, 1]`) is printed even when no controllers are plugged in\n\n### Minimal reproduction project (MRP)\n\n[JoypadTest.zip](https://github.com/user-attachments/files/22544682/JoypadTest.zip)","closed_by":{"login":"Repiteo","id":17489292,"node_id":"MDQ6VXNlcjE3NDg5Mjky","avatar_url":"https://avatars.githubusercontent.com/u/17489292?v=4","gravatar_id":"","url":"https://api.github.com/users/Repiteo","html_url":"https://github.com/Repiteo","followers_url":"https://api.github.com/users/Repiteo/followers","following_url":"https://api.github.com/users/Repiteo/following{/other_user}","gists_url":"https://api.github.com/users/Repiteo/gists{/gist_id}","starred_url":"https://api.github.com/users/Repiteo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Repiteo/subscriptions","organizations_url":"https://api.github.com/users/Repiteo/orgs","repos_url":"https://api.github.com/users/Repiteo/repos","events_url":"https://api.github.com/users/Repiteo/events{/privacy}","received_events_url":"https://api.github.com/users/Repiteo/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/110906/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/godotengine/godot/issues/110906/timeline","performed_via_github_app":null,"state_reason":"completed","pinned_comment":null}