.github.com/users/van800/orgs","repos_url":"https://api.github.com/users/van800/repos","events_url":"https://api.github.com/users/van800/events{/privacy}","received_events_url":"https://api.github.com/users/van800/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-06-02T15:54:15Z","updated_at":"2026-06-02T15:54:15Z","body":"2026.2 EAP is available https://www.jetbrains.com/rider/nextversion/","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4604201878/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4605070195","html_url":"https://github.com/godotengine/godot/pull/118598#issuecomment-4605070195","issue_url":"https://api.github.com/repos/godotengine/godot/issues/118598","id":4605070195,"node_id":"IC_kwDOAO6SJc8AAAABEnvLcw","user":{"login":"Calinou","id":180032,"node_id":"MDQ6VXNlcjE4MDAzMg==","avatar_url":"https://avatars.githubusercontent.com/u/180032?v=4","gravatar_id":"","url":"https://api.github.com/users/Calinou","html_url":"https://github.com/Calinou","followers_url":"https://api.github.com/users/Calinou/followers","following_url":"https://api.github.com/users/Calinou/following{/other_user}","gists_url":"https://api.github.com/users/Calinou/gists{/gist_id}","starred_url":"https://api.github.com/users/Calinou/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Calinou/subscriptions","organizations_url":"https://api.github.com/users/Calinou/orgs","repos_url":"https://api.github.com/users/Calinou/repos","events_url":"https://api.github.com/users/Calinou/events{/privacy}","received_events_url":"https://api.github.com/users/Calinou/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-06-02T17:21:57Z","updated_at":"2026-06-02T17:24:03Z","body":"Tested locally, it works as expected.\r\n\r\nGodot script editor:\r\n\r\n<img width=\"769\" height=\"138\" alt=\"image\" src=\"https://github.com/user-attachments/assets/51726b63-35e6-4908-bf51-f7e0441dd5f4\" />\r\n\r\nRider 2026.2 EAP4:\r\n\r\n<img width=\"465\" height=\"174\" alt=\"image\" src=\"https://github.com/user-attachments/assets/25deab19-554c-41c1-9093-5e2829316265\" />\r\n\r\nThere's a color mismatch since HTML color `green` is darker than Godot's color `green`, but it's not critical. We could replace `green` with `lime` if we wanted to get matching colors.\r\n\r\nAs an aside, I noticed Rider on Linux thinks the project path is mismatched if it's a symlinked folder (both the Godot editor and Rider project use the same symlinked folder path). I had to open Rider and Godot on the actual folder for the paths to actually be considered matching, and the LSP to be functional.\r\n","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4605070195/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4699420150","html_url":"https://github.com/godotengine/godot/pull/118598#issuecomment-4699420150","issue_url":"https://api.github.com/repos/godotengine/godot/issues/118598","id":4699420150,"node_id":"IC_kwDOAO6SJc8AAAABGBt19g","user":{"login":"HolonProduction","id":99511741,"node_id":"U_kgDOBe5tvQ","avatar_url":"https://avatars.githubusercontent.com/u/99511741?v=4","gravatar_id":"","url":"https://api.github.com/users/HolonProduction","html_url":"https://github.com/HolonProduction","followers_url":"https://api.github.com/users/HolonProduction/followers","following_url":"https://api.github.com/users/HolonProduction/following{/other_user}","gists_url":"https://api.github.com/users/HolonProduction/gists{/gist_id}","starred_url":"https://api.github.com/users/HolonProduction/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/HolonProduction/subscriptions","organizations_url":"https://api.github.com/users/HolonProduction/orgs","repos_url":"https://api.github.com/users/HolonProduction/repos","events_url":"https://api.github.com/users/HolonProduction/events{/privacy}","received_events_url":"https://api.github.com/users/HolonProduction/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-06-13T18:34:48Z","updated_at":"2026-06-13T18:34:48Z","body":"> There's a color mismatch since HTML color `green` is darker than Godot's color `green`, but it's not critical. We could replace `green` with `lime` if we wanted to get matching colors.\r\n\r\nComing back to this for a second. Why keep color names in the first place? Wouldn't it make more sense to convert all colors to html notation using [`Color::from_string`](https://docs.godotengine.org/en/stable/classes/class_color.html#class-color-method-from-string)?","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4699420150/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4709097308","html_url":"https://github.com/godotengine/godot/pull/118598#issuecomment-4709097308","issue_url":"https://api.github.com/repos/godotengine/godot/issues/118598","id":4709097308,"node_id":"IC_kwDOAO6SJc8AAAABGK8fXA","user":{"login":"Finishxx","id":78695266,"node_id":"MDQ6VXNlcjc4Njk1MjY2","avatar_url":"https://avatars.githubusercontent.com/u/78695266?v=4","gravatar_id":"","url":"https://api.github.com/users/Finishxx","html_url":"https://github.com/Finishxx","followers_url":"https://api.github.com/users/Finishxx/followers","following_url":"https://api.github.com/users/Finishxx/following{/other_user}","gists_url":"https://api.github.com/users/Finishxx/gists{/gist_id}","starred_url":"https://api.github.com/users/Finishxx/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Finishxx/subscriptions","organizations_url":"https://api.github.com/users/Finishxx/orgs","repos_url":"https://api.github.com/users/Finishxx/repos","events_url":"https://api.github.com/users/Finishxx/events{/privacy}","received_events_url":"https://api.github.com/users/Finishxx/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-06-15T14:42:32Z","updated_at":"2026-06-15T14:42:32Z","body":"> > There's a color mismatch since HTML color `green` is darker than Godot's color `green`, but it's not critical. We could replace `green` with `lime` if we wanted to get matching colors.\r\n> \r\n> Coming back to this for a second. Why keep color names in the first place? Wouldn't it make more sense to convert all colors to html notation using [`Color::from_string`](https://docs.godotengine.org/en/stable/classes/class_color.html#class-color-method-from-string)?\r\n\r\nI like that idea - keeps the colors consistent with Godot's built-in editor across the IDEs. Fixed in the last push\r\n\r\nRider' green is now same as Godot's:\r\n<img width=\"418\" height=\"269\" alt=\"Screenshot_2026-06-15_16-22-26\" src=\"https://github.com/user-attachments/assets/5ac3839f-abdb-4732-94b1-da3bf67e586c\" />\r\n\r\n","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4709097308/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4768183310","html_url":"https://github.com/godotengine/godot/pull/118598#issuecomment-4768183310","issue_url":"https://api.github.com/repos/godotengine/godot/issues/118598","id":4768183310,"node_id":"IC_kwDOAO6SJc8AAAABHDS0Dg","user":{"login":"Finishxx","id":78695266,"node_id":"MDQ6VXNlcjc4Njk1MjY2","avatar_url":"https://avatars.githubusercontent.com/u/78695266?v=4","gravatar_id":"","url":"https://api.github.com/users/Finishxx","html_url":"https://github.com/Finishxx","followers_url":"https://api.github.com/users/Finishxx/followers","following_url":"https://api.github.com/users/Finishxx/following{/other_user}","gists_url":"https://api.github.com/users/Finishxx/gists{/gist_id}","starred_url":"https://api.github.com/users/Finishxx/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Finishxx/subscriptions","organizations_url":"https://api.github.com/users/Finishxx/orgs","repos_url":"https://api.github.com/users/Finishxx/repos","events_url":"https://api.github.com/users/Finishxx/events{/privacy}","received_events_url":"https://api.github.com/users/Finishxx/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-06-22T12:16:50Z","updated_at":"2026-06-22T12:17:00Z","body":"> I'm a bit concerned about the nested color thing. But I think we can fix that on its own, if it actually comes up for users.\r\n\r\nI think the concern is justified, as this is a clear deviation from how the built-in editor displays it. I checked, and the [url] tag handling in the LSP currently has the same limitation as [color]. \r\n\r\nCouldn't find anyone bothered by the [url] not handling nesting, so I also think it should be fine to leave [color] like this, too. If [color] were to handle nesting, it should definitely use the same apparatus (most likely a [stack of tags](https://github.com/godotengine/godot/blob/c309339ec6b3d1c17ef9e49b27306e30e721a182/editor/doc/editor_help.cpp#L2534) would be involved) for [url] as well, which feels out of scope for this PR.\r\n","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4768183310/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4799921597","html_url":"https://github.com/godotengine/godot/pull/118598#issuecomment-4799921597","issue_url":"https://api.github.com/repos/godotengine/godot/issues/118598","id":4799921597,"node_id":"IC_kwDOAO6SJc8AAAABHhj9vQ","user":{"login":"Repiteo","id":17489292,"node_id":"MDQ6VXNlcjE3NDg5Mjky","avatar_url":"https://avatars.githubusercontent.com/u/17489292?v=4","gravatar_id":"","url":"https://api.github.com/users/Repiteo","html_url":"https://github.com/Repiteo","followers_url":"https://api.github.com/users/Repiteo/followers","following_url":"https://api.github.com/users/Repiteo/following{/other_user}","gists_url":"https://api.github.com/users/Repiteo/gists{/gist_id}","starred_url":"https://api.github.com/users/Repiteo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Repiteo/subscriptions","organizations_url":"https://api.github.com/users/Repiteo/orgs","repos_url":"https://api.github.com/users/Repiteo/repos","events_url":"https://api.github.com/users/Repiteo/events{/privacy}","received_events_url":"https://api.github.com/users/Repiteo/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-06-25T13:37:34Z","updated_at":"2026-06-25T13:37:34Z","body":"Thanks! Congratulations on your first merged contribution! 🎉 ","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4799921597/reactions","total_count":1,"+1":0,"-1":0,"laugh":0,"hooray":1,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null}]