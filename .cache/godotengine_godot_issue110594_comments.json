ficial/gists{/gist_id}","starred_url":"https://api.github.com/users/VSofficial/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/VSofficial/subscriptions","organizations_url":"https://api.github.com/users/VSofficial/orgs","repos_url":"https://api.github.com/users/VSofficial/repos","events_url":"https://api.github.com/users/VSofficial/events{/privacy}","received_events_url":"https://api.github.com/users/VSofficial/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-08-10T04:18:38Z","updated_at":"2026-08-10T04:18:50Z","body":"In iOS, the application bundle (the .app folder where your executable lives) is strictly read-only once installed.\nAnd I know it for tvOS that it does not even allow storing any data due to nature of platform it encourages iCloud.\nMaybe the issue is more with writing upon bundle folder and if we divert the path from bundle folder it would be achievable, have to test it","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5235808645/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5361154852","html_url":"https://github.com/godotengine/godot/issues/110594#issuecomment-5361154852","issue_url":"https://api.github.com/repos/godotengine/godot/issues/110594","id":5361154852,"node_id":"IC_kwDOAO6SJc8AAAABP4y7JA","user":{"login":"lexum0","id":2546522,"node_id":"MDQ6VXNlcjI1NDY1MjI=","avatar_url":"https://avatars.githubusercontent.com/u/2546522?v=4","gravatar_id":"","url":"https://api.github.com/users/lexum0","html_url":"https://github.com/lexum0","followers_url":"https://api.github.com/users/lexum0/followers","following_url":"https://api.github.com/users/lexum0/following{/other_user}","gists_url":"https://api.github.com/users/lexum0/gists{/gist_id}","starred_url":"https://api.github.com/users/lexum0/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/lexum0/subscriptions","organizations_url":"https://api.github.com/users/lexum0/orgs","repos_url":"https://api.github.com/users/lexum0/repos","events_url":"https://api.github.com/users/lexum0/events{/privacy}","received_events_url":"https://api.github.com/users/lexum0/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-08-20T20:14:31Z","updated_at":"2026-08-20T20:14:31Z","body":"Still not working on Godot 4.7.2.\n\nI'm getting the following error and now I'm not being asked for the Local Network access permission. \nOpening Settings > Privacy & Security > Local Network doesn't show the app either, so it seems it's not even triggering the permission dialog, so it doesn't have Local Network access permission, so the whole process just fails.\n```\ncore/io/stream_peer_tcp.cpp:90:connect_to_host(): Connection to remote host failed! Connection to remote host failed!\ncore/io/remote_filesystem_client.cpp:158:_synchronize_with_server(): Unable to open connection to remote file server (192.168.0.4, port 6010) failed. Condition \"err != OK\" is true. Returning: err\nCould not connect to remotefs: 192.168.0.4:6010.\n```\n\nThis is a regression","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5361154852/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5361171224","html_url":"https://github.com/godotengine/godot/issues/110594#issuecomment-5361171224","issue_url":"https://api.github.com/repos/godotengine/godot/issues/110594","id":5361171224,"node_id":"IC_kwDOAO6SJc8AAAABP4z7GA","user":{"login":"lexum0","id":2546522,"node_id":"MDQ6VXNlcjI1NDY1MjI=","avatar_url":"https://avatars.githubusercontent.com/u/2546522?v=4","gravatar_id":"","url":"https://api.github.com/users/lexum0","html_url":"https://github.com/lexum0","followers_url":"https://api.github.com/users/lexum0/followers","following_url":"https://api.github.com/users/lexum0/following{/other_user}","gists_url":"https://api.github.com/users/lexum0/gists{/gist_id}","starred_url":"https://api.github.com/users/lexum0/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/lexum0/subscriptions","organizations_url":"https://api.github.com/users/lexum0/orgs","repos_url":"https://api.github.com/users/lexum0/repos","events_url":"https://api.github.com/users/lexum0/events{/privacy}","received_events_url":"https://api.github.com/users/lexum0/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-08-20T20:16:09Z","updated_at":"2026-08-20T20:16:09Z","body":"This used to work before on iOS on Godot 2 and Godot 3, by using a path that is writeable @VSofficial. \nIt does seem to be the problem due to the log. Maybe someone could confirm if the path was changed.","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5361171224/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5361314613","html_url":"https://github.com/godotengine/godot/issues/110594#issuecomment-5361314613","issue_url":"https://api.github.com/repos/godotengine/godot/issues/110594","id":5361314613,"node_id":"IC_kwDOAO6SJc8AAAABP48rNQ","user":{"login":"lexum0","id":2546522,"node_id":"MDQ6VXNlcjI1NDY1MjI=","avatar_url":"https://avatars.githubusercontent.com/u/2546522?v=4","gravatar_id":"","url":"https://api.github.com/users/lexum0","html_url":"https://github.com/lexum0","followers_url":"https://api.github.com/users/lexum0/followers","following_url":"https://api.github.com/users/lexum0/following{/other_user}","gists_url":"https://api.github.com/users/lexum0/gists{/gist_id}","starred_url":"https://api.github.com/users/lexum0/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/lexum0/subscriptions","organizations_url":"https://api.github.com/users/lexum0/orgs","repos_url":"https://api.github.com/users/lexum0/repos","events_url":"https://api.github.com/users/lexum0/events{/privacy}","received_events_url":"https://api.github.com/users/lexum0/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-08-20T20:30:34Z","updated_at":"2026-08-20T20:30:34Z","body":"I just discovered a way to make it trigger the Local Network access permission. Instead of using an IP use the hostname\n\nOn Xcode, open Product > Scheme > Edit Scheme > Arguments > Arguments Passed on Launch and add your hostname:\n`--remote-fs Mac.local`\n\nIt won't resolve the hostname to the IP, but will ask for the Local Network permission and will appear now in Settings > Privacy & Security > Local Network.\nSo now you switch back to using the IP and you need to change the name of the .pck file so it doesn't read it, and now it works on iOS.\n\nI think what needs to get fixed is:\n1. Trigger Local Network permission dialog when using an IP (not a hostname like `Mac.local`)\n2. Resolve the hostname to the IP if using a hostname instead of an IP \n4. If the launch argument is `--remote-fs` then it should prioritize or simply use the remote filesystem which you are asking, not the local .pck file. In Godot 2 or 3 it used to fallback to the .pck file when the connection failed, not try it first regardless of the launch argument so this is a regression\n\nThe local hostname doesn't change and is easier to use while the IP may change, so it's more natural to work with the hostname","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5361314613/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5364790330","html_url":"https://github.com/godotengine/godot/issues/110594#issuecomment-5364790330","issue_url":"https://api.github.com/repos/godotengine/godot/issues/110594","id":5364790330,"node_id":"IC_kwDOAO6SJc8AAAABP8Q0Og","user":{"login":"VSofficial","id":39454933,"node_id":"MDQ6VXNlcjM5NDU0OTMz","avatar_url":"https://avatars.githubusercontent.com/u/39454933?v=4","gravatar_id":"","url":"https://api.github.com/users/VSofficial","html_url":"https://github.com/VSofficial","followers_url":"https://api.github.com/users/VSofficial/followers","following_url":"https://api.github.com/users/VSofficial/following{/other_user}","gists_url":"https://api.github.com/users/VSofficial/gists{/gist_id}","starred_url":"https://api.github.com/users/VSofficial/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/VSofficial/subscriptions","organizations_url":"https://api.github.com/users/VSofficial/orgs","repos_url":"https://api.github.com/users/VSofficial/repos","events_url":"https://api.github.com/users/VSofficial/events{/privacy}","received_events_url":"https://api.github.com/users/VSofficial/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-08-21T03:20:43Z","updated_at":"2026-08-21T03:20:43Z","body":"> This used to work before on iOS on Godot 2 and Godot 3, by using a path that is writeable [@VSofficial](https://github.com/VSofficial). It does seem to be the problem due to the log. Maybe someone could confirm if the path was changed.\n\nI haven't worked with --remote-fs so I was referring of it with local file system and not server host file system. Sorry for the confusions.","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5364790330/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null}]