ived_by":null}],"state":"closed","locked":false,"assignees":[],"milestone":{"url":"https://api.github.com/repos/godotengine/godot/milestones/23","html_url":"https://github.com/godotengine/godot/milestone/23","labels_url":"https://api.github.com/repos/godotengine/godot/milestones/23/labels","id":12939969,"node_id":"MI_kwDOAO6SJc4AxXLB","number":23,"title":"4.6","description":"","creator":{"login":"Repiteo","id":17489292,"node_id":"MDQ6VXNlcjE3NDg5Mjky","avatar_url":"https://avatars.githubusercontent.com/u/17489292?v=4","gravatar_id":"","url":"https://api.github.com/users/Repiteo","html_url":"https://github.com/Repiteo","followers_url":"https://api.github.com/users/Repiteo/followers","following_url":"https://api.github.com/users/Repiteo/following{/other_user}","gists_url":"https://api.github.com/users/Repiteo/gists{/gist_id}","starred_url":"https://api.github.com/users/Repiteo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Repiteo/subscriptions","organizations_url":"https://api.github.com/users/Repiteo/orgs","repos_url":"https://api.github.com/users/Repiteo/repos","events_url":"https://api.github.com/users/Repiteo/events{/privacy}","received_events_url":"https://api.github.com/users/Repiteo/received_events","type":"User","user_view_type":"public","site_admin":false},"open_issues":3,"closed_issues":2978,"state":"closed","created_at":"2025-05-22T16:25:52Z","updated_at":"2026-10-04T16:23:23Z","due_on":null,"closed_at":"2026-01-26T18:09:14Z"},"comments":1,"created_at":"2025-11-21T22:17:04Z","updated_at":"2026-01-25T09:48:21Z","closed_at":"2025-11-25T19:03:30Z","assignee":null,"author_association":"CONTRIBUTOR","issue_field_values":[],"type":null,"active_lock_reason":null,"draft":false,"pull_request":{"url":"https://api.github.com/repos/godotengine/godot/pulls/113028","html_url":"https://github.com/godotengine/godot/pull/113028","diff_url":"https://github.com/godotengine/godot/pull/113028.diff","patch_url":"https://github.com/godotengine/godot/pull/113028.patch","merged_at":"2025-11-25T19:03:30Z"},"body":"I noticed `DisplayServerEmbeddedState::serialize` (in platform/macos/display_server_embedded.mm) had its assertion at the end fixed by @stuartcarnie from\r\n`DEV_ASSERT((data - r_data.ptrw()) >= r_data.size());`\r\nto\r\n`DEV_ASSERT(r_data.size() >= (data - r_data.ptrw()));`\r\nin commit c62ad8dc655c410b28bc80bce251d0e0f7e170ad\r\n\r\nThis makes sense, but I wanted to compare this change to similar asserts elsewhere.\r\nEventually this lead me to core/input/input_event_codec.cpp, which has a handful of equivalent assertions, also by @stuartcarnie.\r\n\r\nIt makes sense because we want to assert the buffer we are reading from / writing to is *at least as long* as the amount we have moved our `data`pointer while decoding/encoding.\r\n\r\nThis PR just follows his example and applies that fix to the `DEV_ASSERT`s in input_event_codec.cpp as well.","closed_by":{"login":"Repiteo","id":17489292,"node_id":"MDQ6VXNlcjE3NDg5Mjky","avatar_url":"https://avatars.githubusercontent.com/u/17489292?v=4","gravatar_id":"","url":"https://api.github.com/users/Repiteo","html_url":"https://github.com/Repiteo","followers_url":"https://api.github.com/users/Repiteo/followers","following_url":"https://api.github.com/users/Repiteo/following{/other_user}","gists_url":"https://api.github.com/users/Repiteo/gists{/gist_id}","starred_url":"https://api.github.com/users/Repiteo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Repiteo/subscriptions","organizations_url":"https://api.github.com/users/Repiteo/orgs","repos_url":"https://api.github.com/users/Repiteo/repos","events_url":"https://api.github.com/users/Repiteo/events{/privacy}","received_events_url":"https://api.github.com/users/Repiteo/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/113028/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/godotengine/godot/issues/113028/timeline","performed_via_github_app":null,"state_reason":null}