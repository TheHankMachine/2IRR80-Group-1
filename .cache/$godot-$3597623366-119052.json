8f7b97f65c6f793","user":{"site_admin":false,"suspended":false,"updated_at":"0001-01-01T00:00:00Z","avatar_url":"https://avatars.githubusercontent.com/u/96648715?u=af70f5d107e9c1447f296643d5a566dab53d25e8&v=4","created_at":"0001-01-01T00:00:00Z","followers":0,"following":0,"html_url":"https://github.com/AThousandShips","id":96648715,"node_id":"U_kgDOBcK-Cw","login":"AThousandShips","type":"User","owned_private_repos":0,"public_gists":0,"public_repos":0,"total_private_repos":0,"url":"https://api.github.com/users/AThousandShips"},"body":"","html_url":"https://github.com/godotengine/godot/pull/119052#pullrequestreview-4203941925","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/119052","author_association":"MEMBER","submitted_at":"2026-04-30T09:20:58Z"},{"id":4200300676,"node_id":"PRR_kwDOAO6SJc76W4CE","state":"APPROVED","commit_id":"f23b0631ff851dae48401bef28f7b97f65c6f793","user":{"site_admin":false,"suspended":false,"updated_at":"0001-01-01T00:00:00Z","avatar_url":"https://avatars.githubusercontent.com/u/2223172?u=fc85633b469acb6e7baef4dba5171f19a2a4ff85&v=4","created_at":"0001-01-01T00:00:00Z","followers":0,"following":0,"html_url":"https://github.com/KoBeWi","id":2223172,"node_id":"MDQ6VXNlcjIyMjMxNzI=","login":"KoBeWi","type":"User","owned_private_repos":0,"public_gists":0,"public_repos":0,"total_private_repos":0,"url":"https://api.github.com/users/KoBeWi"},"body":"Some minor code problems left, but otherwise looks fine.\n\n> The way it is exposed conflicts with https://github.com/godotengine/godot/pull/109746. Which way should be preferred?\n\nWell, there are 2 problems with this:\n- That PR is not merged yet\n- ScenePaint2DEditor is not a plugin (the exposed methods would need to be moved)\n\nThe reason I opened that PR was because someone exposed a plugin with no way to access it properly. Unless I missed it, no one even suggested using EditorInterface for that 😅\n\nThen again, all classes accessible via EditorInterface are core editor components, not plugins (with the exception of ScriptEditor, which has a parent plugin). So we don't really have established way for exposing plugins. Using EditorInterface is better for discoverability at least.","html_url":"https://github.com/godotengine/godot/pull/119052#pullrequestreview-4200300676","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/119052","author_association":"MEMBER","submitted_at":"2026-04-30T11:38:32Z"},{"id":4206128960,"node_id":"PRR_kwDOAO6SJc76tG9A","state":"COMMENTED","commit_id":"f23b0631ff851dae48401bef28f7b97f65c6f793","user":{"site_admin":false,"suspended":false,"updated_at":"0001-01-01T00:00:00Z","avatar_url":"https://avatars.githubusercontent.com/u/92402263?v=4","created_at":"0001-01-01T00:00:00Z","followers":0,"following":0,"html_url":"https://github.com/DexterFstone","id":92402263,"node_id":"U_kgDOBYHyVw","login":"DexterFstone","type":"User","owned_private_repos":0,"public_gists":0,"public_repos":0,"total_private_repos":0,"url":"https://api.github.com/users/DexterFstone"},"body":"","html_url":"https://github.com/godotengine/godot/pull/119052#pullrequestreview-4206128960","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/119052","author_association":"CONTRIBUTOR","submitted_at":"2026-04-30T14:49:28Z"}]