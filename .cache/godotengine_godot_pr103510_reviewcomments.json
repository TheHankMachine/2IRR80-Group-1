are/dotnet\r\nRun actions/checkout@v4\r\n  with:\r\n    submodules: recursive\r\n    repository: godotengine/godot-cpp\r\n    path: godot-cpp\r\n    token: ***\r\n    ssh-strict: true\r\n    ssh-user: git\r\n    persist-credentials: true\r\n    clean: true\r\n    sparse-checkout-cone-mode: true\r\n    fetch-depth: 1\r\n    fetch-tags: false\r\n    show-progress: true\r\n    lfs: false\r\n    set-safe-directory: true\r\n  env:\r\n    GODOT_BASE_BRANCH: master\r\n    SCONSFLAGS: verbose=yes warnings=extra werror=yes module_text_server_fb_enabled=yes strict_checks=yes\r\n    DOTNET_NOLOGO: true\r\n    DOTNET_CLI_TELEMETRY_OPTOUT: true\r\n    TSAN_OPTIONS: suppressions=misc/error_suppressions/tsan.txt\r\n    UBSAN_OPTIONS: suppressions=misc/error_suppressions/ubsan.txt\r\n    pythonLocation: /opt/hostedtoolcache/Python/3.13.2/x64\r\n    PKG_CONFIG_PATH: /opt/hostedtoolcache/Python/3.13.2/x64/lib/pkgconfig\r\n    Python_ROOT_DIR: /opt/hostedtoolcache/Python/3.13.2/x64\r\n    Python2_ROOT_DIR: /opt/hostedtoolcache/Python/3.13.2/x64\r\n    Python3_ROOT_DIR: /opt/hostedtoolcache/Python/3.13.2/x64\r\n    LD_LIBRARY_PATH: /opt/hostedtoolcache/Python/3.13.2/x64/lib\r\n    DOTNET_ROOT: /usr/share/dotnet\r\n```\r\nso we might have a config issue.","created_at":"2025-03-03T17:04:06Z","updated_at":"2025-03-03T17:04:07Z","html_url":"https://github.com/godotengine/godot/pull/103510#discussion_r1977871266","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/103510","_links":{"self":{"href":"https://api.github.com/repos/godotengine/godot/pulls/comments/1977871266"},"html":{"href":"https://github.com/godotengine/godot/pull/103510#discussion_r1977871266"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/103510"}},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/1977871266/reactions","total_count":1,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":1,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_st