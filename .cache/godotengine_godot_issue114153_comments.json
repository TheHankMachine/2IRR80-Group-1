.com/users/KoBeWi/subscriptions","organizations_url":"https://api.github.com/users/KoBeWi/orgs","repos_url":"https://api.github.com/users/KoBeWi/repos","events_url":"https://api.github.com/users/KoBeWi/events{/privacy}","received_events_url":"https://api.github.com/users/KoBeWi/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-01-12T11:26:11Z","updated_at":"2026-01-12T11:50:47Z","body":"The empty warning might be caused by #114812.\n\nEDIT:\nYeah, based on https://github.com/godotengine/godot/issues/114153#issuecomment-3734204600, the dialog appears as child of quick open, which becomes invisible. Deferring the dialog fixes the bug.\n\nThe quick preview loop is worse problem.","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3738091149/reactions","total_count":3,"+1":2,"-1":0,"laugh":0,"hooray":1,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3739678666","html_url":"https://github.com/godotengine/godot/issues/114153#issuecomment-3739678666","issue_url":"https://api.github.com/repos/godotengine/godot/issues/114153","id":3739678666,"node_id":"IC_kwDOAO6SJc7e5vfK","user":{"login":"lostminds","id":17763524,"node_id":"MDQ6VXNlcjE3NzYzNTI0","avatar_url":"https://avatars.githubusercontent.com/u/17763524?v=4","gravatar_id":"","url":"https://api.github.com/users/lostminds","html_url":"https://github.com/lostminds","followers_url":"https://api.github.com/users/lostminds/followers","following_url":"https://api.github.com/users/lostminds/following{/other_user}","gists_url":"https://api.github.com/users/lostminds/gists{/gist_id}","starred_url":"https://api.github.com/users/lostminds/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/lostminds/subscriptions","organizations_url":"https://api.github.com/users/lostminds/orgs"