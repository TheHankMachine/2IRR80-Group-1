s/Repiteo/gists{/gist_id}","starred_url":"https://api.github.com/users/Repiteo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Repiteo/subscriptions","organizations_url":"https://api.github.com/users/Repiteo/orgs","repos_url":"https://api.github.com/users/Repiteo/repos","events_url":"https://api.github.com/users/Repiteo/events{/privacy}","received_events_url":"https://api.github.com/users/Repiteo/received_events","type":"User","user_view_type":"public","site_admin":false},"open_issues":3,"closed_issues":2978,"state":"closed","created_at":"2025-05-22T16:25:52Z","updated_at":"2026-10-04T16:23:23Z","due_on":null,"closed_at":"2026-01-26T18:09:14Z"},"comments":1,"created_at":"2025-07-28T16:50:08Z","updated_at":"2025-11-18T20:05:09Z","closed_at":"2025-11-18T20:03:54Z","assignee":{"login":"bruvzg","id":7645683,"node_id":"MDQ6VXNlcjc2NDU2ODM=","avatar_url":"https://avatars.githubusercontent.com/u/7645683?v=4","gravatar_id":"","url":"https://api.github.com/users/bruvzg","html_url":"https://github.com/bruvzg","followers_url":"https://api.github.com/users/bruvzg/followers","following_url":"https://api.github.com/users/bruvzg/following{/other_user}","gists_url":"https://api.github.com/users/bruvzg/gists{/gist_id}","starred_url":"https://api.github.com/users/bruvzg/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/bruvzg/subscriptions","organizations_url":"https://api.github.com/users/bruvzg/orgs","repos_url":"https://api.github.com/users/bruvzg/repos","events_url":"https://api.github.com/users/bruvzg/events{/privacy}","received_events_url":"https://api.github.com/users/bruvzg/received_events","type":"User","user_view_type":"public","site_admin":false},"author_association":"NONE","issue_field_values":[],"type":null,"active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"### Tested versions\n\nReproducible in both 4.4.stable and 4.1.stable (I didn't test any other)\n\n### System information\n\nGodot v4.4.stable - macOS Sequoia (15.3.2) - Multi-window, 1 monitor - Metal (Forward+) - integrated Apple M4 (Apple9) - Apple M4 (10 threads)\n\nI tested and **cannot reproduce** on Windows:\nGodot v4.4.stable - Windows 11 (build 26100) - Multi-window, 2 monitors - Vulkan (Forward+) - dedicated NVIDIA GeForce RTX 4070 Ti SUPER (NVIDIA; 32.0.15.7680) - AMD Ryzen 7 7800X3D 8-Core Processor (16 threads)\n\n### Issue description\n\nThe Godot game (not the editor) crashes when freeing a Control node that was just presented under the mouse cursor.\n\n### Steps to reproduce\n\n- Add a control in a scene (e.g. a `ColorRect`)\n- Listen to the `mouse_entered` and `mouse_exited` signals\n- On mouse entered, present a new control on top of the current one (as if it were a tooltip)\n- On mouse exited, remove and `queue_free` that makeshift \"tooltip\"\n- Moving your mouse around the main control shows the tooltip, then immediately mouse_exited is called which hides and free the tooltip, and mouse entered is called again in a loop. The game then crashes\n\nThe game doesn't crash if you don't call `queue_free` on that \"tooltip\" control, but it's never deleted from memory (tested by attaching a script to it and logging `NOTIFICATION_PREDELETE`).\n\nThe game also doesn't crash if presenting a regular Node2D, or setting the control's mouse filter to `MOUSE_FILTER_IGNORE`.\n\n### Minimal reproduction project (MRP)\n\n[godot-mouseover-crash.zip](https://github.com/user-attachments/files/21473697/godot-mouseover-crash.zip)\n\nThe code to reproduce is very simple, just attach this to any control node in a scene:\n```gdscript\nextends ColorRect\n\nvar currentPopup: Control = null\n\nfunc _ready() -> void:\n\tmouse_entered.connect(Callable(self, \"on_mouse_enter\"))\n\tmouse_exited.connect(Callable(self, \"on_mouse_exit\"))\n\nfunc on_mouse_enter():\n\tcurrentPopup = ColorRect.new()\n\tcurrentPopup.color = Color.BLUE\n\tcurrentPopup.size = Vector2(120, 80)\n\tget_parent().add_child(currentPopup)\n\tcurrentPopup.set_position(self.get_screen_position())\n\nfunc on_mouse_exit():\n\tif currentPopup != null:\n\t\tget_parent().remove_child(currentPopup)\n\t\tcurrentPopup.queue_free()\n\t\tcurrentPopup = null\n```","closed_by":{"login":"Repiteo","id":17489292,"node_id":"MDQ6VXNlcjE3NDg5Mjky","avatar_url":"https://avatars.githubusercontent.com/u/17489292?v=4","gravatar_id":"","url":"https://api.github.com/users/Repiteo","html_url":"https://github.com/Repiteo","followers_url":"https://api.github.com/users/Repiteo/followers","following_url":"https://api.github.com/users/Repiteo/following{/other_user}","gists_url":"https://api.github.com/users/Repiteo/gists{/gist_id}","starred_url":"https://api.github.com/users/Repiteo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Repiteo/subscriptions","organizations_url":"https://api.github.com/users/Repiteo/orgs","repos_url":"https://api.github.com/users/Repiteo/repos","events_url":"https://api.github.com/users/Repiteo/events{/privacy}","received_events_url":"https://api.github.com/users/Repiteo/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/109053/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/godotengine/godot/issues/109053/timeline","performed_via_github_app":null,"state_reason":"completed","pinned_comment":null}