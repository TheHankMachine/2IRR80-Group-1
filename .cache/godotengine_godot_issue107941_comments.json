b.com/users/Neon-Sphere","html_url":"https://github.com/Neon-Sphere","followers_url":"https://api.github.com/users/Neon-Sphere/followers","following_url":"https://api.github.com/users/Neon-Sphere/following{/other_user}","gists_url":"https://api.github.com/users/Neon-Sphere/gists{/gist_id}","starred_url":"https://api.github.com/users/Neon-Sphere/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Neon-Sphere/subscriptions","organizations_url":"https://api.github.com/users/Neon-Sphere/orgs","repos_url":"https://api.github.com/users/Neon-Sphere/repos","events_url":"https://api.github.com/users/Neon-Sphere/events{/privacy}","received_events_url":"https://api.github.com/users/Neon-Sphere/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-10-02T19:11:06Z","updated_at":"2025-10-02T19:11:06Z","body":"As of Godot 4.5.stable I am still having this problem where new highlights are not working until I reload the script. I am using the android editor.","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3362595956/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3403256427","html_url":"https://github.com/godotengine/godot/issues/107941#issuecomment-3403256427","issue_url":"https://api.github.com/repos/godotengine/godot/issues/107941","id":3403256427,"node_id":"IC_kwDOAO6SJc7K2ZJr","user":{"login":"NicholasBolen","id":98554429,"node_id":"U_kgDOBd_SPQ","avatar_url":"https://avatars.githubusercontent.com/u/98554429?v=4","gravatar_id":"","url":"https://api.github.com/users/NicholasBolen","html_url":"https://github.com/NicholasBolen","followers_url":"https://api.github.com/users/NicholasBolen/followers","following_url":"https://api.github.com/users/NicholasBolen/following{/other_user}","gists_url":"https://api.github.com/users/NicholasBolen/gists{/gist_id}","starred_url":"https://api.github.com/users/NicholasBolen/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/NicholasBolen/subscriptions","organizations_url":"https://api.github.com/users/NicholasBolen/orgs","repos_url":"https://api.github.com/users/NicholasBolen/repos","events_url":"https://api.github.com/users/NicholasBolen/events{/privacy}","received_events_url":"https://api.github.com/users/NicholasBolen/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-10-14T19:19:09Z","updated_at":"2025-10-14T19:19:09Z","body":"This inconsistency is causing confusions for my team. Wasn't this also [mentioned by Calinou](https://github.com/godotengine/godot/pull/74393#pullrequestreview-2044393228) in the original PR? I'm surprised it was merged without first fixing this.\n\nI'd prefer the old syntax highlighting over inconsistent behaviour, though I doubt this is high enough priority to consider reverting.","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3403256427/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3550147051","html_url":"https://github.com/godotengine/godot/issues/107941#issuecomment-3550147051","issue_url":"https://api.github.com/repos/godotengine/godot/issues/107941","id":3550147051,"node_id":"IC_kwDOAO6SJc7TmvHr","user":{"login":"Orphaeus","id":22770416,"node_id":"MDQ6VXNlcjIyNzcwNDE2","avatar_url":"https://avatars.githubusercontent.com/u/22770416?v=4","gravatar_id":"","url":"https://api.github.com/users/Orphaeus","html_url":"https://github.com/Orphaeus","followers_url":"https://api.github.com/users/Orphaeus/followers","following_url":"https://api.github.com/users/Orphaeus/following{/other_user}","gists_url":"https://api.github.com/users/Orphaeus/gists{/gist_id}","starred_url":"https://api.github.com/users/Orphaeus/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Orphaeus/subscriptions","organizations_url":"https://api.github.com/users/Orphaeus/orgs","repos_url":"https://api.github.com/users/Orphaeus/repos","events_url":"https://api.github.com/users/Orphaeus/events{/privacy}","received_events_url":"https://api.github.com/users/Orphaeus/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-11-19T01:23:54Z","updated_at":"2025-11-19T01:23:54Z","body":"I have no idea if this is helpful information or not, but just to add some data: In addition to manually reloading the script, another thing I've noticed that causes the member variable highlighting to update is running the project *twice*, then editing the script in some way (e.g., adding a line or character). Running the project a single time will not cause the highlighting to update, even if you edit the script afterward. It only happens when editing the script after the *second* time running the project.\n\nI tested this in the project I was working on when I noticed this behavior as well as an MRP with a single `Node` and a two-line script attached to it. I only bothered mentioning this because it seems odd that it requires two runs and an edit to cause the update.\n\nSorry if this is easily explained by something I'm not aware of!","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3550147051/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3601046135","html_url":"https://github.com/godotengine/godot/issues/107941#issuecomment-3601046135","issue_url":"https://api.github.com/repos/godotengine/godot/issues/107941","id":3601046135,"node_id":"IC_kwDOAO6SJc7Wo5p3","user":{"login":"madokadev","id":139037401,"node_id":"U_kgDOCEmK2Q","avatar_url":"https://avatars.githubusercontent.com/u/139037401?v=4","gravatar_id":"","url":"https://api.github.com/users/madokadev","html_url":"https://github.com/madokadev","followers_url":"https://api.github.com/users/madokadev/followers","following_url":"https://api.github.com/users/madokadev/following{/other_user}","gists_url":"https://api.github.com/users/madokadev/gists{/gist_id}","starred_url":"https://api.github.com/users/madokadev/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/madokadev/subscriptions","organizations_url":"https://api.github.com/users/madokadev/orgs","repos_url":"https://api.github.com/users/madokadev/repos","events_url":"https://api.github.com/users/madokadev/events{/privacy}","received_events_url":"https://api.github.com/users/madokadev/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-12-02T09:23:38Z","updated_at":"2025-12-02T10:35:39Z","body":"At this point, wouldn't it be better to revert the original change until - if ever - this issue gets fixed?\nEven with the fix, coloring custom member variables the same as built-in ones is very confusing and shouldn't have been merged based on a single feature request. Typos really aren't a problem with code completion. Having a custom syntax color for these would have been much better.\n\nEdit: Oh no, it seems it also works in reverse. If you delete a member variable it will still remain colored. This is hell.","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3601046135/reactions","total_count":2,"+1":2,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3601214612","html_url":"https://github.com/godotengine/godot/issues/107941#issuecomment-3601214612","issue_url":"https://api.github.com/repos/godotengine/godot/issues/107941","id":3601214612,"node_id":"IC_kwDOAO6SJc7WpiyU","user":{"login":"dalexeev","id":47700418,"node_id":"MDQ6VXNlcjQ3NzAwNDE4","avatar_url":"https://avatars.githubusercontent.com/u/47700418?v=4","gravatar_id":"","url":"https://api.github.com/users/dalexeev","html_url":"https://github.com/dalexeev","followers_url":"https://api.github.com/users/dalexeev/followers","following_url":"https://api.github.com/users/dalexeev/following{/other_user}","gists_url":"https://api.github.com/users/dalexeev/gists{/gist_id}","starred_url":"https://api.github.com/users/dalexeev/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/dalexeev/subscriptions","organizations_url":"https://api.github.com/users/dalexeev/orgs","repos_url":"https://api.github.com/users/dalexeev/repos","events_url":"https://api.github.com/users/dalexeev/events{/privacy}","received_events_url":"https://api.github.com/users/dalexeev/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-12-02T10:04:20Z","updated_at":"2025-12-02T10:04:20Z","body":"> At this point, wouldn't it be better to revert the original change until - if ever - this issue gets fixed?\n\nThis could be an option, but:\n\n1. We need to decide what level of syntax highlighting we want in the long term. Should it be just syntax/grammar highlighting, or do we want contextual features that depend on the definitions and data types used in the script? Syntax highlighting has become increasingly colorful lately, and some differences don't fit the \"highlight only syntax\" concept. For example, we have three colors for type highlighting (**Base Type Color**, **Engine Type Color**, **User Type Color**), but we use **Base Type Color** when the type isn't global.\n2. Note that this isn't the only case where saving a script is required for new changes to take effect. It's simply the most noticeable. For example, documentation tooltips may display incomplete/outdated information until you save the script. Should we revert documentation tooltips as well?\n\nI may be biased since I implemented this feature, but for me this flaw isn't a major inconvenience. For old class members (after the last script save), highlighting works correctly. For new class members, it doesn't cause confusion: I remember them because I just added them (sometimes this flaw even helps me spot newly added variables). Personally, the biggest drawback is that the highlighter doesn't detect inner classes and that **Symbol Color** by default is too similar to **Member Variable Color** (but you can edit this in the Editor Settings).","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3601214612/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3601462925","html_url":"https://github.com/godotengine/godot/issues/107941#issuecomment-3601462925","issue_url":"https://api.github.com/repos/godotengine/godot/issues/107941","id":3601462925,"node_id":"IC_kwDOAO6SJc7WqfaN","user":{"login":"madokadev","id":139037401,"node_id":"U_kgDOCEmK2Q","avatar_url":"https://avatars.githubusercontent.com/u/139037401?v=4","gravatar_id":"","url":"https://api.github.com/users/madokadev","html_url":"https://github.com/madokadev","followers_url":"https://api.github.com/users/madokadev/followers","following_url":"https://api.github.com/users/madokadev/following{/other_user}","gists_url":"https://api.github.com/users/madokadev/gists{/gist_id}","starred_url":"https://api.github.com/users/madokadev/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/madokadev/subscriptions","organizations_url":"https://api.github.com/users/madokadev/orgs","repos_url":"https://api.github.com/users/madokadev/repos","events_url":"https://api.github.com/users/madokadev/events{/privacy}","received_events_url":"https://api.github.com/users/madokadev/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-12-02T11:04:30Z","updated_at":"2025-12-02T11:12:14Z","body":"> I may be biased since I implemented this feature, but for me this flaw isn't a major inconvenience.\n\nI regularly swap between scripts while working on features, and don't save in the meantime, so it can take some time until they're reloaded. When I return it then confuses me that a certain variable is apparently local while it's colored as a global member variable. In fact that happening is what caused me to make the edit.\n\n> the biggest drawback is that the highlighter doesn't detect inner classes and that Symbol Color by default is too similar to Member Variable Color\n\nI personally mostly dislike that built-in members are the same color as custom members. Though thinking about it, I earlier already found it confusing that signals are the same color as built-in variables and function names (e.g. for distinguishing button_pressed and pressed). It turns a script file into a mess of blue, where it's actually \"member variable\" \"symbol\" \"signal\" \"function\":\n<img width=\"525\" height=\"303\" alt=\"Image\" src=\"https://github.com/user-attachments/assets/5c749dc6-2de7-49b9-8c98-09ef979a06f9\" />\n\nSo yeah, probably the issue is more to do with syntax highlighting in general, and that the old way was a good method for distinguishing custom from built-in member variables and signals. I think that vexes me more than having to press ctrl+s more regularly.","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3601462925/reactions","total_count":5,"+1":5,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3601534149","html_url":"https://github.com/godotengine/godot/issues/107941#issuecomment-3601534149","issue_url":"https://api.github.com/repos/godotengine/godot/issues/107941","id":3601534149,"node_id":"IC_kwDOAO6SJc7WqwzF","user":{"login":"KoBeWi","id":2223172,"node_id":"MDQ6VXNlcjIyMjMxNzI=","avatar_url":"https://avatars.githubusercontent.com/u/2223172?v=4","gravatar_id":"","url":"https://api.github.com/users/KoBeWi","html_url":"https://github.com/KoBeWi","followers_url":"https://api.github.com/users/KoBeWi/followers","following_url":"https://api.github.com/users/KoBeWi/following{/other_user}","gists_url":"https://api.github.com/users/KoBeWi/gists{/gist_id}","starred_url":"https://api.github.com/users/KoBeWi/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/KoBeWi/subscriptions","organizations_url":"https://api.github.com/users/KoBeWi/orgs","repos_url":"https://api.github.com/users/KoBeWi/repos","events_url":"https://api.github.com/users/KoBeWi/events{/privacy}","received_events_url":"https://api.github.com/users/KoBeWi/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-12-02T11:22:14Z","updated_at":"2025-12-02T11:22:14Z","body":"The workaround for this bug is changing the colors in settings to be the same. `member_variable_color` is a new color, setting it to the same as `text_color` should do the trick.","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3601534149/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3601575103","html_url":"https://github.com/godotengine/godot/issues/107941#issuecomment-3601575103","issue_url":"https://api.github.com/repos/godotengine/godot/issues/107941","id":3601575103,"node_id":"IC_kwDOAO6SJc7Wq6y_","user":{"login":"madokadev","id":139037401,"node_id":"U_kgDOCEmK2Q","avatar_url":"https://avatars.githubusercontent.com/u/139037401?v=4","gravatar_id":"","url":"https://api.github.com/users/madokadev","html_url":"https://github.com/madokadev","followers_url":"https://api.github.com/users/madokadev/followers","following_url":"https://api.github.com/users/madokadev/following{/other_user}","gists_url":"https://api.github.com/users/madokadev/gists{/gist_id}","starred_url":"https://api.github.com/users/madokadev/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/madokadev/subscriptions","organizations_url":"https://api.github.com/users/madokadev/orgs","repos_url":"https://api.github.com/users/madokadev/repos","events_url":"https://api.github.com/users/madokadev/events{/privacy}","received_events_url":"https://api.github.com/users/madokadev/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-12-02T11:31:13Z","updated_at":"2025-12-02T11:32:08Z","body":"> The workaround for this bug is changing the colors in settings to be the same. member_variable_color is a new color, setting it to the same as text_color should do the trick.\n\nNot exactly. That also changes the built-in variables and signals to the `text_color`. So it technically fixes the bug, but gets confusing since I don't necessarily know the names of built-in variables and them having a unique color really helps.\nThe color also already existed in 4.4 (at least), where it only applied to built-in variables and signals.","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3601575103/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4163863398","html_url":"https://github.com/godotengine/godot/issues/107941#issuecomment-4163863398","issue_url":"https://api.github.com/repos/godotengine/godot/issues/107941","id":4163863398,"node_id":"IC_kwDOAO6SJc74L4Nm","user":{"login":"Copperplate","id":16230743,"node_id":"MDQ6VXNlcjE2MjMwNzQz","avatar_url":"https://avatars.githubusercontent.com/u/16230743?v=4","gravatar_id":"","url":"https://api.github.com/users/Copperplate","html_url":"https://github.com/Copperplate","followers_url":"https://api.github.com/users/Copperplate/followers","following_url":"https://api.github.com/users/Copperplate/following{/other_user}","gists_url":"https://api.github.com/users/Copperplate/gists{/gist_id}","starred_url":"https://api.github.com/users/Copperplate/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Copperplate/subscriptions","organizations_url":"https://api.github.com/users/Copperplate/orgs","repos_url":"https://api.github.com/users/Copperplate/repos","events_url":"https://api.github.com/users/Copperplate/events{/privacy}","received_events_url":"https://api.github.com/users/Copperplate/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-03-31T16:23:36Z","updated_at":"2026-03-31T16:23:36Z","body":"I just came across this too after using a custom member variable color for better visibility. Newly typed variables will instead get a plain white color instead of my custom color. The workaround is usually saving the script and then typing a new line, which will cause any incorrect colors to update after a few moments, but sometimes this technique doesn't work for some reason.","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4163863398/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"