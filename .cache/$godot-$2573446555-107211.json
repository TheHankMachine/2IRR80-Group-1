ull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/107211","author_association":"MEMBER","submitted_at":"2025-06-08T14:03:21Z"},{"id":2908491328,"node_id":"PRR_kwDOAO6SJc6tXA5A","state":"COMMENTED","user":{"site_admin":false,"suspended":false,"updated_at":"0001-01-01T00:00:00Z","avatar_url":"https://avatars.githubusercontent.com/u/7645683?u=2867ee7fcd920bc19b7d1cbf4b10264b9bbc9326&v=4","created_at":"0001-01-01T00:00:00Z","followers":0,"following":0,"html_url":"https://github.com/bruvzg","id":7645683,"node_id":"MDQ6VXNlcjc2NDU2ODM=","login":"bruvzg","type":"User","owned_private_repos":0,"public_gists":0,"public_repos":0,"total_private_repos":0,"url":"https://api.github.com/users/bruvzg"},"body":"","html_url":"https://github.com/godotengine/godot/pull/107211#pullrequestreview-2908491328","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/107211","author_association":"MEMBER","submitted_at":"2025-06-08T14:04:50Z"},{"id":2908604277,"node_id":"PRR_kwDOAO6SJc6tXcd1","state":"COMMENTED","user":{"site_admin":false,"suspended":false,"updated_at":"0001-01-01T00:00:00Z","avatar_url":"https://avatars.githubusercontent.com/u/39946030?v=4","created_at":"0001-01-01T00:00:00Z","followers":0,"following":0,"html_url":"https://github.com/lyuma","id":39946030,"node_id":"MDQ6VXNlcjM5OTQ2MDMw","login":"lyuma","type":"User","owned_private_repos":0,"public_gists":0,"public_repos":0,"total_private_repos":0,"url":"https://api.github.com/users/lyuma"},"body":"In terms of workfloq and time save, I can be on board with this, though it creates a new workflow that outshines the advanced dialog and may lead to even fewer users trying out the advanced dialog material edit workflow for example, once we merge that\r\n\r\nI get why it was written this way. It does solve one specific workflow but in a way that deviates from the 4.x approach. The advantage is that extraction of materials is no longer dependent on the partial import which is done to open the advanced import dialog, but doing it in-line with a normal import comes with it a risk of inconsistency, duplicate code and bugs\r\n\r\ni would double check to make sure that this is done as close as possible to where pre_import would have done things... for exmplae, is it correct to extract materials before the post_fix INTERNAL_IMPORT_CATEGORY_MATERIAL scripts have been processed?","html_url":"https://github.com/godotengine/godot/pull/107211#pullrequestreview-2908604277","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/107211","author_association":"CONTRIBUTOR","submitted_at":"2025-06-08T18:50:27Z"},{"id":2908621135,"node_id":"PRR_kwDOAO6SJc6tXglP","state":"COMMENTED","user":{"site_admin":false,"suspended":false,"updated_at":"0001-01-01T00:00:00Z","avatar_url":"https://avatars.githubusercontent.com/u/7645683?u=2867ee7fcd920bc19b7d1cbf4b10264b9bbc9326&v=4","created_at":"0001-01-01T00:00:00Z","followers":0,"following":0,"html_url":"https://github.com/bruvzg","id":7645683,"node_id":"MDQ6VXNlcjc2NDU2ODM=","login":"bruvzg","type":"User","owned_private_repos":0,"public_gists":0,"public_repos":0,"total_private_repos":0,"url":"https://api.github.com/users/bruvzg"},"body":"","html_url":"https://github.com/godotengine/godot/pull/107211#pullrequestreview-2908621135","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/107211","author_association":"MEMBER","submitted_at":"2025-06-08T19:49:45Z"},{"id":2908628008,"node_id":"PRR_kwDOAO6SJc6tXiQo","state":"COMMENTED","user":{"site_admin":false,"suspended":false,"updated_at":"0001-01-01T00:00:00Z","avatar_url":"https://avatars.githubusercontent.com/u/7645683?u=2867ee7fcd920bc19b7d1cbf4b10264b9bbc9326&v=4","created_at":"0001-01-01T00:00:00Z","followers":0,"following":0,"html_url":"https://github.com/bruvzg","id":7645683,"node_id":"MDQ6VXNlcjc2NDU2ODM=","login":"bruvzg","type":"User","owned_private_repos":0,"public_gists":0,"public_repos":0,"total_private_repos":0,"url":"https://api.github.com