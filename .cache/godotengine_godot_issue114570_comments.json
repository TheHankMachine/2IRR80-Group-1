[{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3707266768","html_url":"https://github.com/godotengine/godot/issues/114570#issuecomment-3707266768","issue_url":"https://api.github.com/repos/godotengine/godot/issues/114570","id":3707266768,"node_id":"IC_kwDOAO6SJc7c-GbQ","user":{"login":"bruvzg","id":7645683,"node_id":"MDQ6VXNlcjc2NDU2ODM=","avatar_url":"https://avatars.githubusercontent.com/u/7645683?v=4","gravatar_id":"","url":"https://api.github.com/users/bruvzg","html_url":"https://github.com/bruvzg","followers_url":"https://api.github.com/users/bruvzg/followers","following_url":"https://api.github.com/users/bruvzg/following{/other_user}","gists_url":"https://api.github.com/users/bruvzg/gists{/gist_id}","starred_url":"https://api.github.com/users/bruvzg/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/bruvzg/subscriptions","organizations_url":"https://api.github.com/users/bruvzg/orgs","repos_url":"https://api.github.com/users/bruvzg/repos","events_url":"https://api.github.com/users/bruvzg/events{/privacy}","received_events_url":"https://api.github.com/users/bruvzg/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-01-03T18:37:47Z","updated_at":"2026-01-03T18:37:47Z","body":"Default theme and editor fonts are not directly related in any way.\n\n- Editor font is `Inter` (built-in, or font specified in the editor settings) with the following fallbacks:\n  1. system `Noto Sans CJK` (variant for current locale is preferred)\n  2. `Vazirmatn` (built-in, Arabic)\n  3. subset of `Noto Sans` fonts (built-in, Bengali, Devanagari, Georgian, Hebrew, Malayalam, Oriya, Sinhala, Tamil, Telugu, Thai)\n  4. `Droid Sans Fallback` (built-in, CJK)\n  5. `Droid Sans Japanese` (built-in, CJK)\n  6. system emoji font (first found from the following list is used: `Apple Color Emoji`, `Segoe UI Emoji`, `Noto Color Emoji`, `Twitter Color Emoji`, `OpenMoji`, `EmojiOne Color`)\n\n- Default project 