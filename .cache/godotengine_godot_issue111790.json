default":false,"description":"","archived_at":null,"archived_by":null},{"id":1332303119,"node_id":"MDU6TGFiZWwxMzMyMzAzMTE5","url":"https://api.github.com/repos/godotengine/godot/labels/regression","name":"regression","color":"ff63ac","default":false,"description":"","archived_at":null,"archived_by":null},{"id":1732720779,"node_id":"MDU6TGFiZWwxNzMyNzIwNzc5","url":"https://api.github.com/repos/godotengine/godot/labels/topic:gui","name":"topic:gui","color":"ffee88","default":false,"description":"","archived_at":null,"archived_by":null}],"state":"closed","locked":false,"assignees":[],"milestone":{"url":"https://api.github.com/repos/godotengine/godot/milestones/23","html_url":"https://github.com/godotengine/godot/milestone/23","labels_url":"https://api.github.com/repos/godotengine/godot/milestones/23/labels","id":12939969,"node_id":"MI_kwDOAO6SJc4AxXLB","number":23,"title":"4.6","description":"","creator":{"login":"Repiteo","id":17489292,"node_id":"MDQ6VXNlcjE3NDg5Mjky","avatar_url":"https://avatars.githubusercontent.com/u/17489292?v=4","gravatar_id":"","url":"https://api.github.com/users/Repiteo","html_url":"https://github.com/Repiteo","followers_url":"https://api.github.com/users/Repiteo/followers","following_url":"https://api.github.com/users/Repiteo/following{/other_user}","gists_url":"https://api.github.com/users/Repiteo/gists{/gist_id}","starred_url":"https://api.github.com/users/Repiteo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Repiteo/subscriptions","organizations_url":"https://api.github.com/users/Repiteo/orgs","repos_url":"https://api.github.com/users/Repiteo/repos","events_url":"https://api.github.com/users/Repiteo/events{/privacy}","received_events_url":"https://api.github.com/users/Repiteo/received_events","type":"User","user_view_type":"public","site_admin":false},"open_issues":3,"closed_issues":2978,"state":"closed","created_at":"2025-05-22T16:25:52Z","updated_at":"2026-10-04T16:23:23Z","due_on":null,"closed_at":"2026-01-26T18:09:14Z"},"comments":2,"created_at":"2025-10-18T13:55:13Z","updated_at":"2025-10-27T15:08:46Z","closed_at":"2025-10-27T15:06:28Z","assignee":null,"author_association":"NONE","issue_field_values":[],"type":null,"active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"### Tested versions\n\nReproducible in: v4.5.stable.official [876b29033]\nNot reproducible in: v4.4.1.stable.official [49a5bc7b6]\n\n\n\n\n### System information\n\nWindows 10 (build 19045) - Multi-window, 1 monitor - Vulkan (Forward+) - dedicated NVIDIA GeForce RTX 3050 (NVIDIA; 32.0.15.6094) - 12th Gen Intel(R) Core(TM) i5-12400F (12 threads) - 63.86 GiB memory\n\n### Issue description\n\nPopupMenu nodes with a lot of items, that are the child of a MenuBar node, do not adhere to the max_size set for them. The property is ignored, because something keeps overwriting the min_size property during run time. As a result the popup menu spans the entire window. Setting the min_size to a fixed value and wrap_controls to false does not prevent this from happening. \n\nThis unexpected behavior occurs in Godot 4.5 and 4.5.1. \n<img width=\"1273\" height=\"742\" alt=\"Image\" src=\"https://github.com/user-attachments/assets/a490e95d-9db7-45db-96af-b99adb367294\" />\n\nIn Godot 4.4.1 the PopupMenu node works as expected.\n<img width=\"1268\" height=\"739\" alt=\"Image\" src=\"https://github.com/user-attachments/assets/341e13e8-b2a5-4cd6-b421-a18fbd25919e\" />\n\n### Steps to reproduce\n\nCreate a scene with a MenuBar node as the main node. Through the editor or code add a PopupMenu node as a child and set max_size, min_size and wrap_controls. Add an amount of items to the PopupMenu node that would exceed the size of the window, e.g.:\n\n```gdscript\nextends MenuBar\n\nfunc _ready() -> void:\n\tvar popup = PopupMenu.new()\n\tpopup.wrap_controls = false\n\tpopup.min_size = Vector2(50,50)\n\tpopup.max_size = Vector2(200,100)\n\tadd_child(popup)\n\tfor counter in range(1,50):\n\t\tpopup.add_item(str(counter))\n\tpass\n```\n\n### Minimal reproduction project (MRP)\n\nN/A but I already made one\n\n[test.zip](https://github.com/user-attachments/files/22984684/test.zip)","closed_by":{"login":"Repiteo","id":17489292,"node_id":"MDQ6VXNlcjE3NDg5Mjky","avatar_url":"https://avatars.githubusercontent.com/u/17489292?v=4","gravatar_id":"","url":"https://api.github.com/users/Repiteo","html_url":"https://github.com/Repiteo","followers_url":"https://api.github.com/users/Repiteo/followers","following_url":"https://api.github.com/users/Repiteo/following{/other_user}","gists_url":"https://api.github.com/users/Repiteo/gists{/gist_id}","starred_url":"https://api.github.com/users/Repiteo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Repiteo/subscriptions","organizations_url":"https://api.github.com/users/Repiteo/orgs","repos_url":"https://api.github.com/users/Repiteo/repos","events_url":"https://api.github.com/users/Repiteo/events{/privacy}","received_events_url":"https://api.github.com/users/Repiteo/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/111790/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/godotengine/godot/issues/111790/timeline","performed_via_github_app":null,"state_reason":"completed","pinned_comment":null}