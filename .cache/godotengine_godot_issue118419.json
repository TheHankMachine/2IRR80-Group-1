thub.com/users/akien-mga/events{/privacy}","received_events_url":"https://api.github.com/users/akien-mga/received_events","type":"User","user_view_type":"public","site_admin":false},"open_issues":3,"closed_issues":2535,"state":"closed","created_at":"2025-11-27T20:29:18Z","updated_at":"2026-10-20T18:39:31Z","due_on":null,"closed_at":"2026-06-19T16:54:35Z"},"comments":0,"created_at":"2026-04-11T17:40:27Z","updated_at":"2026-04-13T20:53:21Z","closed_at":"2026-04-13T20:53:21Z","assignee":{"login":"mihe","id":4884246,"node_id":"MDQ6VXNlcjQ4ODQyNDY=","avatar_url":"https://avatars.githubusercontent.com/u/4884246?v=4","gravatar_id":"","url":"https://api.github.com/users/mihe","html_url":"https://github.com/mihe","followers_url":"https://api.github.com/users/mihe/followers","following_url":"https://api.github.com/users/mihe/following{/other_user}","gists_url":"https://api.github.com/users/mihe/gists{/gist_id}","starred_url":"https://api.github.com/users/mihe/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/mihe/subscriptions","organizations_url":"https://api.github.com/users/mihe/orgs","repos_url":"https://api.github.com/users/mihe/repos","events_url":"https://api.github.com/users/mihe/events{/privacy}","received_events_url":"https://api.github.com/users/mihe/received_events","type":"User","user_view_type":"public","site_admin":false},"author_association":"CONTRIBUTOR","issue_field_values":[],"type":null,"active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"### Tested versions\n\n- Reproducible in: 4.7.dev [1aabcb9e9bc7a222a972731523831ec86b77ee20]\n- Likely reproducible in many 4.x versions\n\n### System information\n\nGodot v4.7.dev (1aabcb9e9) - Fedora Linux 43 (Forty Three) on Wayland - X11 display driver, Single-window, 2 monitors - Vulkan (Forward+) - dedicated AMD Radeon RX 9070 XT (RADV GFX1201) - AMD Ryzen 9 9950X3D 16-Core Processor (32 threads) - 60.39 GiB memory\n\n### Issue description\n\nWhen creating areas through `PhysicsServer*D` using Godot Physics (2D or 3D), just the act of adding the area to the physics space (through `area_set_space`) will not in itself cause other areas to pick up on any overlap with them (as they should). Instead you're forced to do things like change the transform of the area you just added to the physics space, which will then cause the overlap to be detected.\n\nThe reason for this is because `GodotArea3D::set_space` and `GodotArea2D::set_space` look like this:\n\nhttps://github.com/godotengine/godot/blob/1aabcb9e9bc7a222a972731523831ec86b77ee20/modules/godot_physics_2d/godot_area_2d.cpp#L65-L79\n\n... which is missing this part (as found in several other `GodotArea*D` methods):\n\nhttps://github.com/godotengine/godot/blob/1aabcb9e9bc7a222a972731523831ec86b77ee20/modules/godot_physics_2d/godot_area_2d.cpp#L91-L93\n\nThis is unlike `GodotBody*D::set_space`, which has what can be considered the equivalent of this:\n\nhttps://github.com/godotengine/godot/blob/1aabcb9e9bc7a222a972731523831ec86b77ee20/modules/godot_physics_2d/godot_body_2d.cpp#L409-L415\n\nNote that this is not really an issue with the regular `Area3D`/`Area2D` nodes, as they always set their transform when entering any physics space, circumventing this issue. It only becomes a problem when you're creating custom areas through the physics servers.\n\n### Steps to reproduce\n\n1. Run the MRP.\n2. Note how the `*d_server_area.tscn` tests are missing enter/exit messages for the re-enter and free steps.\n3. Switch the 3D physics server to Jolt.\n4. Run the MRP again.\n5. Note how the `3d_server_area.tscn` test now emits enter/exit messages for the re-enter and exit steps\n\n### Minimal reproduction project (MRP)\n\n[area-missing-enters.zip](https://github.com/user-attachments/files/26647774/area-missing-enters.zip)","closed_by":{"login":"Repiteo","id":17489292,"node_id":"MDQ6VXNlcjE3NDg5Mjky","avatar_url":"https://avatars.githubusercontent.com/u/17489292?v=4","gravatar_id":"","url":"https://api.github.com/users/Repiteo","html_url":"https://github.com/Repiteo","followers_url":"https://api.github.com/users/Repiteo/followers","following_url":"https://api.github.com/users/Repiteo/following{/other_user}","gists_url":"https://api.github.com/users/Repiteo/gists{/gist_id}","starred_url":"https://api.github.com/users/Repiteo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Repiteo/subscriptions","organizations_url":"https://api.github.com/users/Repiteo/orgs","repos_url":"https://api.github.com/users/Repiteo/repos","events_url":"https://api.github.com/users/Repiteo/events{/privacy}","received_events_url":"https://api.github.com/users/Repiteo/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/118419/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/godotengine/godot/issues/118419/timeline","performed_via_github_app":null,"state_reason":"completed","pinned_comment":null}