st_id}","starred_url":"https://api.github.com/users/AThousandShips/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/AThousandShips/subscriptions","organizations_url":"https://api.github.com/users/AThousandShips/orgs","repos_url":"https://api.github.com/users/AThousandShips/repos","events_url":"https://api.github.com/users/AThousandShips/events{/privacy}","received_events_url":"https://api.github.com/users/AThousandShips/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-09-28T14:35:23Z","updated_at":"2026-09-28T14:35:23Z","body":"Okay! Did not know that was a feature, please create a new issue with the template or copy the template to make this properly filled in to help tracking, thank you","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5872152169/reactions","total_count":1,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":1},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5872194063","html_url":"https://github.com/godotengine/godot/issues/123926#issuecomment-5872194063","issue_url":"https://api.github.com/repos/godotengine/godot/issues/123926","id":5872194063,"node_id":"IC_kwDOAO6SJc8AAAABXgKSDw","user":{"login":"TOWUK","id":28830162,"node_id":"MDQ6VXNlcjI4ODMwMTYy","avatar_url":"https://avatars.githubusercontent.com/u/28830162?v=4","gravatar_id":"","url":"https://api.github.com/users/TOWUK","html_url":"https://github.com/TOWUK","followers_url":"https://api.github.com/users/TOWUK/followers","following_url":"https://api.github.com/users/TOWUK/following{/other_user}","gists_url":"https://api.github.com/users/TOWUK/gists{/gist_id}","starred_url":"https://api.github.com/users/TOWUK/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/TOWUK/subscriptions","organizations_url":"https://api.github.com/users/TOWUK/orgs","repos_url":"https://api.github.com/users/TOWUK/repos","events_url":"https://api.github.com/users/TOWUK/events{/privacy}","received_events_url":"https://api.github.com/users/TOWUK/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-09-28T14:37:30Z","updated_at":"2026-09-28T14:38:09Z","body":"**ubuntu 26 (wsl2)\nhere is the full build pipeline:**\n\n```sh\nsudo apt update && sudo apt full-upgrade -y\nsudo apt install -y scons pkg-config clang mold gettext \\\n  libx11-dev libxcursor-dev libxinerama-dev libxi-dev libxrandr-dev \\\n  libwayland-dev libxkbcommon-dev libasound2-dev libpulse-dev\nwget https://github.com/mstorsjo/llvm-mingw/releases/download/20260922/llvm-mingw-20260922-ucrt-ubuntu-22.04-x86_64.tar.xz\nsudo mkdir -p /opt/llvm-mingw\nsudo tar xf llvm-mingw-*.tar.xz -C /opt/llvm-mingw --strip-components=1\nrm llvm-mingw-*.tar.xz\n\ncd ~ && git clone https://github.com/godotengine/godot.git && cd godot\n\ncat > build.sh <<'EOF'\n#!/usr/bin/env bash\nset -e\nexport PATH=/opt/llvm-mingw/bin:$PATH\nexport MINGW_PREFIX=/opt/llvm-mingw\nexport SCRIPT_AES256_ENCRYPTION_KEY=\"8c74e225dd263c6c3fd740b78b2c067052edb4f1ae991a33b16caf9372b6b754\"\n\nFLAGS=\"optimize=size_extra lto=full deprecated=no \\\n  forward_plus_renderer=yes forward_mobile_renderer=no opengl3=no d3d12=no \\\n  accesskit=no angle=no engine_update_check=no disable_xr=yes \\\n  builtin_openxr=no module_mobile_vr_enabled=no module_openxr_enabled=no \\\n  module_visionos_xr_enabled=no module_webxr_enabled=no\"\n\nfor T in editor template_debug template_release; do\n  scons platform=windows arch=x86_64 target=$T use_mingw=yes use_llvm=yes $FLAGS -j$(nproc)\ndone\nfor T in template_debug template_release; do\n  scons platform=linuxbsd arch=x86_64 target=$T use_llvm=yes linker=mold $FLAGS -j$(nproc)\ndone\n\nls -lh bin/\nEOF\nchmod +x build.sh && ./build.sh\n```","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5872194063/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5872211147","html_url":"https://github.com/godotengine/godot/issues/123926#issuecomment-5872211147","issue_url":"https://api.github.com/repos/godotengine/godot/issues/123926","id":5872211147,"node_id":"IC_kwDOAO6SJc8AAAABXgLUyw","user":{"login":"TOWUK","id":28830162,"node_id":"MDQ6VXNlcjI4ODMwMTYy","avatar_url":"https://avatars.githubusercontent.com/u/28830162?v=4","gravatar_id":"","url":"https://api.github.com/users/TOWUK","html_url":"https://github.com/TOWUK","followers_url":"https://api.github.com/users/TOWUK/followers","following_url":"https://api.github.com/users/TOWUK/following{/other_user}","gists_url":"https://api.github.com/users/TOWUK/gists{/gist_id}","starred_url":"https://api.github.com/users/TOWUK/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/TOWUK/subscriptions","organizations_url":"https://api.github.com/users/TOWUK/orgs","repos_url":"https://api.github.com/users/TOWUK/repos","events_url":"https://api.github.com/users/TOWUK/events{/privacy}","received_events_url":"https://api.github.com/users/TOWUK/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-09-28T14:38:19Z","updated_at":"2026-09-28T14:38:19Z","body":"> Ладно! Не знал, что это функция, пожалуйста, создайте новую проблему с шаблоном или скопируйте шаблон, чтобы её правильно заполнили и помочь с отслеживанием, спасибо.\n\nOkay, I'll close this form and give you more details in the new issue template.","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5872211147/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app