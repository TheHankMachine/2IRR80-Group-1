cky! (mockup attached)\r\n<img width=\"2068\" height=\"1462\" alt=\"image\" src=\"https://github.com/user-attachments/assets/c5466263-6f1d-4758-a176-b9ac1c648c9e\" />\r\n\r\nI also think it could be good to add it to quick settings aswell? So people can disable it in the case they dislike it.\r\n<img width=\"655\" height=\"414\" alt=\"image\" src=\"https://github.com/user-attachments/assets/1fb77026-0b03-4ced-a32d-769dec954eca\" />\r\n\r\n","author_association":"NONE","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5395217785/reactions","total_count":4,"+1":4,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5395329169","html_url":"https://github.com/godotengine/godot/pull/122757#issuecomment-5395329169","issue_url":"https://api.github.com/repos/godotengine/godot/issues/122757","id":5395329169,"node_id":"IC_kwDOAO6SJc8AAAABQZYwkQ","user":{"login":"KoBeWi","id":2223172,"node_id":"MDQ6VXNlcjIyMjMxNzI=","avatar_url":"https://avatars.githubusercontent.com/u/2223172?v=4","gravatar_id":"","url":"https://api.github.com/users/KoBeWi","html_url":"https://github.com/KoBeWi","followers_url":"https://api.github.com/users/KoBeWi/followers","following_url":"https://api.github.com/users/KoBeWi/following{/other_user}","gists_url":"https://api.github.com/users/KoBeWi/gists{/gist_id}","starred_url":"https://api.github.com/users/KoBeWi/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/KoBeWi/subscriptions","organizations_url":"https://api.github.com/users/KoBeWi/orgs","repos_url":"https://api.github.com/users/KoBeWi/repos","events_url":"https://api.github.com/users/KoBeWi/events{/privacy}","received_events_url":"https://api.github.com/users/KoBeWi/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-08-24T12:41:16Z","updated_at":"2026-08-24T12: