[{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2576092151","html_url":"https://github.com/godotengine/godot/pull/100786#issuecomment-2576092151","issue_url":"https://api.github.com/repos/godotengine/godot/issues/100786","id":2576092151,"node_id":"IC_kwDOAO6SJc6ZjAv3","user":{"login":"lyuma","id":39946030,"node_id":"MDQ6VXNlcjM5OTQ2MDMw","avatar_url":"https://avatars.githubusercontent.com/u/39946030?v=4","gravatar_id":"","url":"https://api.github.com/users/lyuma","html_url":"https://github.com/lyuma","followers_url":"https://api.github.com/users/lyuma/followers","following_url":"https://api.github.com/users/lyuma/following{/other_user}","gists_url":"https://api.github.com/users/lyuma/gists{/gist_id}","starred_url":"https://api.github.com/users/lyuma/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/lyuma/subscriptions","organizations_url":"https://api.github.com/users/lyuma/orgs","repos_url":"https://api.github.com/users/lyuma/repos","events_url":"https://api.github.com/users/lyuma/events{/privacy}","received_events_url":"https://api.github.com/users/lyuma/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-01-07T19:42:30Z","updated_at":"2025-01-07T19:42:30Z","body":"@fire if you think the change is good and just needs the missing pieces implemented, such as animation slices, I will implement the missing parts next week. I just wanted get approval for the overall concept before feature freeze.","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2576092151/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2576114691","html_url":"https://github.com/godotengine/godot/pull/100786#issuecomment-2576114691","issue_url":"https://api.github.com/repos/godotengine/godot/issues/100786","id":2576114691,"node_id":"IC_kwDOAO6SJc6ZjGQD","user":{"login":"fire","id":32321,"node_id":"MDQ6VXNlcjMyMzIx","avatar_url":"https://avatars.githubusercontent.com/u/32321?v=4","gravatar_id":"","url":"https://api.github.com/users/fire","html_url":"https://github.com/fire","followers_url":"https://api.github.com/users/fire/followers","following_url":"https://api.github.com/users/fire/following{/other_user}","gists_url":"https://api.github.com/users/fire/gists{/gist_id}","starred_url":"https://api.github.com/users/fire/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/fire/subscriptions","organizations_url":"https://api.github.com/users/fire/orgs","repos_url":"https://api.github.com/users/fire/repos","events_url":"https://api.github.com/users/fire/events{/privacy}","received_events_url":"https://api.github.com/users/fire/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-01-07T19:56:27Z","updated_at":"2025-01-07T19:56:27Z","body":"It makes sense that uid works everywhere.","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2576114691/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2582027761","html_url":"https://github.com/godotengine/godot/pull/100786#issuecomment-2582027761","issue_url":"https://api.github.com/repos/godotengine/godot/issues/100786","id":2582027761,"node_id":"IC_kwDOAO6SJc6Z5p3x","user":{"login":"makinori","id":8362329,"node_id":"MDQ6VXNlcjgzNjIzMjk=","avatar_url":"https://avatars.githubusercontent.com/u/8362329?v=4","gravatar_id":"","url":"https://api.github.com/users/makinori","html_url":"https://github.com/makinori","followers_url":"https://api.github.com/users/makinori/followers","following_url":"https://api.github.com/users/makinori/following{/other_user}","gists_url":"https://api.github.com/users/makinori/gists{/gist_id}","starred_url":"https://api.github.com/users/makinori/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/makinori/subscriptions","organizations_url":"https://api.github.com/users/makinori/orgs","repos_url":"https://api.github.com/users/makinori/repos","events_url":"https://api.github.com/users/makinori/events{/privacy}","received_events_url":"https://api.github.com/users/makinori/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-01-10T08:17:23Z","updated_at":"2025-01-10T08:17:23Z","body":"Thanks for the PR, I was having this exact issue. However, I noticed if I select an external material under mesh import in the UI, the res:// path is shown but the uid:// path is saved in the .import file. You mentioned that \"the UID path isn't obvious and readable\" and got confused when the engine deals with this issue","author_association":"NONE","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2582027761/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2588508163","html_url":"https://github.com/godotengine/godot/pull/100786#issuecomment-2588508163","issue_url":"https://api.github.com/repos/godotengine/godot/issues/100786","id":2588508163,"node_id":"IC_kwDOAO6SJc6aSYAD","user":{"login":"Jordyfel","id":76705401,"node_id":"MDQ6VXNlcjc2NzA1NDAx","avatar_url":"https://avatars.githubusercontent.com/u/76705401?v=4","gravatar_id":"","url":"https://api.github.com/users/Jordyfel","html_url":"https://github.com/Jordyfel","followers_url":"https://api.github.com/users/Jordyfel/followers","following_url":"https://api.github.com/users/Jordyfel/following{/other_user}","gists_url":"https://api.github.com/users/Jordyfel/gists{/gist_id}","starred_url":"https://api.github.com/users/Jordyfel/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Jordyfel/subscriptions","organizations_url":"https://api.github.com/users/Jordyfel/orgs","repos_url":"https://api.github.com/users/Jordyfel/repos","events_url":"https://api.github.com/users/Jordyfel/events{/privacy}","received_events_url":"https://api.github.com/users/Jordyfel/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-01-14T00:38:43Z","updated_at":"2025-01-14T00:40:48Z","body":"Fixes #95637\r\n\r\nThe path import option can currently be set not only in `_save_dir_confirm()`, which is called only when the batch extraction dialog is used (\"Actions...\" button in the top left of the advanced import dialog brings that up), but also by the custom inspector thing which is the `SceneImportSettingsData` class in the same file.\r\n\r\nWhat I'm thinking is that a user wouldn't really need to change the path after it was set, they would just move the extracted file in the filesystem instead.\r\n\r\nThis could justify something like, instead of introducing a new uid import option, store the uid in the currently existing path import option and use `ResourceUID.ensure_path()` for compatibility. If the user wants to reset the path and extract again, they would set the `enabled` option to false and use the other dialog (through `_save_dir_confirm()`) again. Following this logic it also makes sense to hide the import option so that it is only saved but not editable in the custom inspector thing.","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2588508163/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2589935150","html_url":"https://github.com/godotengine/godot/pull/100786#issuecomment-2589935150","issue_url":"https://api.github.com/repos/godotengine/godot/issues/100786","id":2589935150,"node_id":"IC_kwDOAO6SJc6aX0Yu","user":{"login":"KoBeWi","id":2223172,"node_id":"MDQ6VXNlcjIyMjMxNzI=","avatar_url":"https://avatars.githubusercontent.com/u/2223172?v=4","gravatar_id":"","url":"https://api.github.com/users/KoBeWi","html_url":"https://github.com/KoBeWi","followers_url":"https://api.github.com/users/KoBeWi/followers","following_url":"https://api.github.com/users/KoBeWi/following{/other_user}","gists_url":"https://api.github.com/users/KoBeWi/gists{/gist_id}","starred_url":"https://api.github.com/users/KoBeWi/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/KoBeWi/subscriptions","organizations_url":"https://api.github.com/users/KoBeWi/orgs","repos_url":"https://api.github.com/users/KoBeWi/repos","events_url":"https://api.github.com/users/KoBeWi/events{/privacy}","received_events_url":"https://api.github.com/users/KoBeWi/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-01-14T13:38:57Z","updated_at":"2025-01-14T13:38:57Z","body":"I tested this with simple cube and somehow ended up with this\r\n\r\n![image](https://github.com/user-attachments/assets/aade2358-3460-4b22-b03a-8b8b4506c83e)\r\n\r\nwhich is related to this issue: #101256\r\n\r\nI think it's caused by EditorPropertyPath automatically converting paths to UID. Not sure if there is a way to disable this behavior, but I think splitting between path and uid makes sense. It just has to work properly.","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2589935150/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2636532810","html_ur