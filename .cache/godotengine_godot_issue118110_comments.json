engine/godot/issues/118110#issuecomment-4200474586","issue_url":"https://api.github.com/repos/godotengine/godot/issues/118110","id":4200474586,"node_id":"IC_kwDOAO6SJc76Xifa","user":{"login":"clayjohn","id":16521339,"node_id":"MDQ6VXNlcjE2NTIxMzM5","avatar_url":"https://avatars.githubusercontent.com/u/16521339?v=4","gravatar_id":"","url":"https://api.github.com/users/clayjohn","html_url":"https://github.com/clayjohn","followers_url":"https://api.github.com/users/clayjohn/followers","following_url":"https://api.github.com/users/clayjohn/following{/other_user}","gists_url":"https://api.github.com/users/clayjohn/gists{/gist_id}","starred_url":"https://api.github.com/users/clayjohn/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/clayjohn/subscriptions","organizations_url":"https://api.github.com/users/clayjohn/orgs","repos_url":"https://api.github.com/users/clayjohn/repos","events_url":"https://api.github.com/users/clayjohn/events{/privacy}","received_events_url":"https://api.github.com/users/clayjohn/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-04-07T16:09:24Z","updated_at":"2026-04-07T16:09:24Z","body":"Looks like this issue is specifically when using the AUTOMATIC process mode and falling back on to realtime updates (due to using TIME). If you select the REALTIME process mode it works fine. So https://github.com/godotengine/godot/pull/118121 is definitely the wrong fix","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4200474586/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4201585644","html_url":"https://github.com/godotengine/godot/issues/118110#issuecomment-4201585644","issue_url":"https://api.github.com/repos/godotengine/godot/issues/118110","id":4201585644,"node_id":"IC_kwDOAO6SJc76bxvs","user":{"login":"clayjohn","id":16521339,"node_id":"MDQ6VXNlcjE2NTIxMzM5","avatar_url":"https://avatars.githubusercontent.com/u/16521339?v=4","gravatar_id":"","url":"https://api.github.com/users/clayjohn","html_url":"https://github.com/clayjohn","followers_url":"https://api.github.com/users/clayjohn/followers","following_url":"https://api.github.com/users/clayjohn/following{/other_user}","gists_url":"https://api.github.com/users/clayjohn/gists{/gist_id}","starred_url":"https://api.github.com/users/clayjohn/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/clayjohn/subscriptions","organizations_url":"https://api.github.com/users/clayjohn/orgs","repos_url":"https://api.github.com/users/clayjohn/repos","events_url":"https://api.github.com/users/clayjohn/events{/privacy}","received_events_url":"https://api.github.com/users/clayjohn/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-04-07T19:16:17Z","updated_at":"2026-04-07T19:37:26Z","body":"Aaaaaah actually I fixed this in a branch a few months ago but never pushed the fix it seems. Let's see if I can find it. Its an issue that has existed in the codebase since 4.0, but just happened not to create obvious artifacts until recently\n\n_edit: Found it https://github.com/clayjohn/godot/commit/c5c191c7e7d83872e3c16210b2eca005bc2ef7d9_","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4201585644/reactions","total_count":1,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":1,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4202459766","html_url":"https://github.com/godotengine/godot/issues/118110#issuecomment-4202459766","issue_url":"https://api.github.com/repos/godotengine/godot/issues/118110","id":4202459766,"node_id":"IC_kwDOAO6SJc76fHJ2","user":{"login":"TokisanGames","id":632766,"node_id":"MDQ6VXNlcjYzMjc2Ng==","avatar_url":"https://avatars.githubusercontent.com/u/632766?v=4","gravatar_id":"","url":"https://api.github.com/users/TokisanGames","html_url":"https://github.com/TokisanGames","followers_url":"https://api.github.com/users/TokisanGames/followers","following_url":"https://api.github.com/users/TokisanGames/following{/other_user}","gists_url":"https://api.github.com/users/TokisanGames/gists{/gist_id}","starred_url":"https://api.github.com/users/TokisanGames/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/TokisanGames/subscriptions","organizations_url":"https://api.github.com/users/TokisanGames/orgs","repos_url":"https://api.github.com/users/TokisanGames/repos","events_url":"https://api.github.com/users/TokisanGames/events{/privacy}","received_events_url":"https://api.github.com/users/TokisanGames/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-04-07T22:01:13Z","updated_at":"2026-04-07T22:01:13Z","body":"Many of us have been tracking this issue on my discord as it affects Sky3D in 4.6.2 only, and only for some users or conditions apparently. Sorry, we should have provided our notes earlier.\n\nWe also had identified this is triggered specifically using Automatic process mode.  Some testing from @cavemanike suggests it might also be alleviated by setting Radiance Size to anything but 256. It seems the combination of Automatic + RS 256 + TIME in the shader.\n\nHowever, these settings are the defaults. So anyone making a new environment, or using Sky3D, or making their own sky shader potentially runs into the bug in 4.6.2.\n","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4202459766/reactions","total_count":1,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":1},"performed_via_github_app":null,"minimized":null},{