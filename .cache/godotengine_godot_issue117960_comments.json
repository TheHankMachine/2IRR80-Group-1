/godot/issues/comments/4154928775/reactions","total_count":3,"+1":3,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4155187831","html_url":"https://github.com/godotengine/godot/issues/117960#issuecomment-4155187831","issue_url":"https://api.github.com/repos/godotengine/godot/issues/117960","id":4155187831,"node_id":"IC_kwDOAO6SJc73qyJ3","user":{"login":"chlingzool","id":173458448,"node_id":"U_kgDOClbEEA","avatar_url":"https://avatars.githubusercontent.com/u/173458448?v=4","gravatar_id":"","url":"https://api.github.com/users/chlingzool","html_url":"https://github.com/chlingzool","followers_url":"https://api.github.com/users/chlingzool/followers","following_url":"https://api.github.com/users/chlingzool/following{/other_user}","gists_url":"https://api.github.com/users/chlingzool/gists{/gist_id}","starred_url":"https://api.github.com/users/chlingzool/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/chlingzool/subscriptions","organizations_url":"https://api.github.com/users/chlingzool/orgs","repos_url":"https://api.github.com/users/chlingzool/repos","events_url":"https://api.github.com/users/chlingzool/events{/privacy}","received_events_url":"https://api.github.com/users/chlingzool/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-03-30T13:48:12Z","updated_at":"2026-03-30T13:48:12Z","body":"@kleonc so i need check points is legal in code?","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4155187831/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4162088621","html_url":"https://github.com/godotengine/godot/issues/117960#issuecomment-4162088621","issue_url":"https://api.github.com/repos/godotengine/godot/issues/117960","id":4162088621,"node_id":"IC_kwDOAO6SJc74FG6t","user":{"login":"kleonc","id":9283098,"node_id":"MDQ6VXNlcjkyODMwOTg=","avatar_url":"https://avatars.githubusercontent.com/u/9283098?v=4","gravatar_id":"","url":"https://api.github.com/users/kleonc","html_url":"https://github.com/kleonc","followers_url":"https://api.github.com/users/kleonc/followers","following_url":"https://api.github.com/users/kleonc/following{/other_user}","gists_url":"https://api.github.com/users/kleonc/gists{/gist_id}","starred_url":"https://api.github.com/users/kleonc/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/kleonc/subscriptions","organizations_url":"https://api.github.com/users/kleonc/orgs","repos_url":"https://api.github.com/users/kleonc/repos","events_url":"https://api.github.com/users/kleonc/events{/privacy}","received_events_url":"https://api.github.com/users/kleonc/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-03-31T11:54:24Z","updated_at":"2026-03-31T11:54:24Z","body":"> **`@kleonc`** so i need check points is legal in code?\n\nI'd say you need to fix your generation algorithm to always produce a valid polygon points (no segment intersections). No idea what's your goal etc., but if you'd e.g. calculate minimum radius for all your original \"coast\" polyline points, then adding the const-radius polyline in the opposite direction at a little smaller radius than the calculated minimum should always give you a valid polygon.\nAnyway, this is not a place to ask for help with your own project/logic/algorithm/etc. Check out [other communities](https://godotengine.org/community/) for such help.\n\n> \n> Engine-wise, these are not rendered because the triangulation fails. It should probably error? 🤔 Specifically here it returns an empty index arrays because of the failure:\n> \n> [godot/scene/2d/polygon_2d.cpp](https://github.com/godotengine/godot/blob/2af785641ae249573f45eb61852d22e0b1a8a03c/scene/2d/polygon_2d.cpp#L328)\n> \n> Line 328 in [2af7856](/godotengine/godot/commit/2af785641ae249573f45eb61852d22e0b1a8a03c)\n>  index_array = Geometry2D::triangulate_polygon(points);\n\nNote the failing `Geometry2D::triangulate_polygon` function used internally by Polygon2D is exposed/binded as [`Geometry2D.triangulate_polygon`](https://docs.godotengine.org/en/4.6/classes/class_geometry2d.html#class-geometry2d-method-triangulate-polygon), so you could use it to ensure your points won't fail to be triangulated when assigned to `Polygon2D.polygon`:\n\n```gdscript\nif Geometry2D.triangulate_polygon(polygon_points).is_empty():\n\t# Fail somehow / log error / etc.\n```\n\nBut I suggest using such check only for debugging (as it has a performance cost). A not failing polygon generation algorithm would be better.","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4162088621/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4167366182","html_url":"https://github.com/godotengine/godot/issues/117960#issuecomment-4167366182","issue_url":"https://api.github.com/repos/godotengine/godot/issues/117960","id":4167366182,"node_id":"IC_kwDOAO6SJc74ZPYm","user":{"login":"Omniologist","id":94089255,"node_id":"U_kgDOBZuwJw","avatar_url":"https://avatars.githubusercontent.com/u/94089255?v=4","gravatar_id":"","url":"https://api.github.com/users/Omniologist","html_url":"https://github.com/Omniologist","followers_url":"https://api.github.com/users/Omniologist/followers","following_url":"https://api.github.com/users/Omniologist/following{/other_user}","gists_url":"https://api.github.com/users/Omniologist/gists{/gist_id}","starred_url":"https://api.github.com/users/Omniologist/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Omniologist/subscriptions","organizations_url":"https://api.github.com/users/Omniologist/orgs","repos_url":"https://api.github.com/users/Omniologist/repos","events_url":"https://api.github.com/users/Omniologist/events{/privacy}","received_events_url":"https://api.github.com/users/Omniologist/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-04-01T04:27:16Z","updated_at":"2026-04-01T04:27:16Z","body":"pr #118057 ","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4167366182/reactions","total_count":7,"+1":3,"-1":0,"laugh":0,"hooray":2,"confused":0,"heart":2,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null}]