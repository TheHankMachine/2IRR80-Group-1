[{"id":2526696780,"node_id":"PRR_kwDOAO6SJc6WmlVM","user":{"login":"smix8","id":52464204,"node_id":"MDQ6VXNlcjUyNDY0MjA0","avatar_url":"https://avatars.githubusercontent.com/u/52464204?u=4854f17c9d330a8a9d274f0cb7b943fc2bb6dd44&v=4","gravatar_id":"","url":"https://api.github.com/users/smix8","html_url":"https://github.com/smix8","followers_url":"https://api.github.com/users/smix8/followers","following_url":"https://api.github.com/users/smix8/following{/other_user}","gists_url":"https://api.github.com/users/smix8/gists{/gist_id}","starred_url":"https://api.github.com/users/smix8/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/smix8/subscriptions","organizations_url":"https://api.github.com/users/smix8/orgs","repos_url":"https://api.github.com/users/smix8/repos","events_url":"https://api.github.com/users/smix8/events{/privacy}","received_events_url":"https://api.github.com/users/smix8/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"Using self-listing to avoid looping over everything makes sense. It works better than LocalVector lists when there are only a few bodies and areas on the move all the time while having thousands of objects idle in the background. I did a similar change recently for navigation that also did brute force loops over everything before for the same reason. As long as people are not changing all their space / map objects all the time, which should be the majority of projects, it will be a net performance win.\r\n\r\nCant say that much for the API. My only concern is if this entire API change is still thread safe? Because Self-Lists are very error prone when not used with locks should users push changes from threads while the list is processed. I think the physics uses a MT wrapper in this case to avoid these problems, right?","state":"APPROVED","html_url":"https://github.com/godotengine/godot/pull/100983#pullrequestreview-2526696780","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/100983","author_association":"CONTRIBUTOR","_links":{"html":{"href":"https://github.com/godotengine/godot/pull/100983#pullrequestreview-2526696780"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/100983"}},"submitted_at":"2024-12-31T20:44:46Z","commit_id":null},{"id":2526867652,"node_id":"PRR_kwDOAO6SJc6WnPDE","user":{"login":"jrouwe","id":1621693,"node_id":"MDQ6VXNlcjE2MjE2OTM=","avatar_url":"https://avatars.githubusercontent.com/u/1621693?u=14b293a7095d074e6653d7ad73269a5e785e1399&v=4","gravatar_id":"","url":"https://api.github.com/users/jrouwe","html_url":"https://github.com/jrouwe","followers_url":"https://api.github.com/users/jrouwe/followers","following_url":"https://api.github.com/users/jrouwe/following{/other_user}","gists_url":"https://api.github.com/users/jrouwe/gists{/gist_id}","starred_url":"https://api.github.com/users/jrouwe/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/jrouwe/subscriptions","organizations_url":"https://api.github.com/users/jrouwe/orgs","repos_url":"https://api.github.com/users/jrouwe/repos","events_url":"https://api.github.com/users/jrouwe/events{/privacy}","received_events_url":"https://api.github.com/users/jrouwe/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"Other than these 2 remarks below, the code looks good to me.","state":"COMMENTED","html_url":"https://github.com/godotengine/godot/pull/100983#pullrequestreview-2526867652","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/100983","author_association":"CONTRIBUTOR","_links":{"html":{"href":"https://github.com/godotengine/godot/pull/100983#pullrequestreview-2526867652"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/100983"}},"submitted_at":"2025-01-01T14:31:54Z","commit_id":null},{"id":2526925926,"node_id":"PRR_kwDOAO6SJc6WndRm","user":{"login":"mihe","id":4884246,"node_id":"MDQ6VXNlcjQ4ODQyNDY=","avatar_url":"