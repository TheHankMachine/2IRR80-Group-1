node_id":"MDU6TGFiZWwyNjY2NzA4Mjg5","url":"https://api.github.com/repos/godotengine/godot/labels/topic:3d","name":"topic:3d","color":"ffee88","default":false,"description":"","archived_at":null,"archived_by":null}],"state":"closed","locked":false,"assignees":[],"milestone":{"url":"https://api.github.com/repos/godotengine/godot/milestones/22","html_url":"https://github.com/godotengine/godot/milestone/22","labels_url":"https://api.github.com/repos/godotengine/godot/milestones/22/labels","id":12070367,"node_id":"MI_kwDOAO6SJc4AuC3f","number":22,"title":"4.5","description":"","creator":{"login":"Sauermann","id":6299227,"node_id":"MDQ6VXNlcjYyOTkyMjc=","avatar_url":"https://avatars.githubusercontent.com/u/6299227?v=4","gravatar_id":"","url":"https://api.github.com/users/Sauermann","html_url":"https://github.com/Sauermann","followers_url":"https://api.github.com/users/Sauermann/followers","following_url":"https://api.github.com/users/Sauermann/following{/other_user}","gists_url":"https://api.github.com/users/Sauermann/gists{/gist_id}","starred_url":"https://api.github.com/users/Sauermann/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Sauermann/subscriptions","organizations_url":"https://api.github.com/users/Sauermann/orgs","repos_url":"https://api.github.com/users/Sauermann/repos","events_url":"https://api.github.com/users/Sauermann/events{/privacy}","received_events_url":"https://api.github.com/users/Sauermann/received_events","type":"User","user_view_type":"public","site_admin":false},"open_issues":3,"closed_issues":3687,"state":"closed","created_at":"2024-12-19T08:51:28Z","updated_at":"2026-09-04T21:48:38Z","due_on":"2025-09-15T00:00:00Z","closed_at":"2025-09-18T17:13:14Z"},"comments":2,"created_at":"2025-03-18T11:25:38Z","updated_at":"2025-03-18T14:07:24Z","closed_at":"2025-03-18T12:52:20Z","assignee":null,"author_association":"CONTRIBUTOR","issue_field_values":[],"type":null,"active_lock_reason":null,"draft":false,"pull_request":{"url":"https://api.github.com/repos/godotengine/godot/pulls/104310","html_url":"https://github.com/godotengine/godot/pull/104310","diff_url":"https://github.com/godotengine/godot/pull/104310.diff","patch_url":"https://github.com/godotengine/godot/pull/104310.patch","merged_at":"2025-03-18T12:52:20Z"},"body":"Fixes #104309.\r\n\r\nThis fixes the issue of `ConcavePolygonShape3D` always behaving as if its `backface_collision` was enabled when using Jolt Physics as the 3D physics engine.\r\n\r\nPrior to godot-jolt/godot-jolt#967 the `JoltCustomDoubleSidedShape` decorator shape was conditionally wrapped around the `ConcavePolygonShape3D`'s underlying `JPH::MeshShape`, which meant we could always override `JPH::CollideShapeSettings::mBackFaceMode` and `JPH::ShapeCastSettings::mBackFaceModeTriangles` with `JPH::EBackFaceMode::CollideWithBackFaces`.\r\n\r\nHowever, godot-jolt/godot-jolt#967 changed this so that we _always_ wrapped the underlying `JPH::MeshShape`, and instead provided a boolean member variable (`JoltCustomDoubleSidedShape::back_face_collision`) to indicate whether back-face collisions were enabled or not, and I forgot to add a condition to the above mentioned overrides of `mBackFaceMode` and `mBackFaceModeTriangles` in the process.\r\n\r\nSo this PR fixes this by simply adding said conditions.","closed_by":{"login":"akien-mga","id":4701338,"node_id":"MDQ6VXNlcjQ3MDEzMzg=","avatar_url":"https://avatars.githubusercontent.com/u/4701338?v=4","gravatar_id":"","url":"https://api.github.com/users/akien-mga","html_url":"https://github.com/akien-mga","followers_url":"https://api.github.com/users/akien-mga/followers","following_url":"https://api.github.com/users/akien-mga/following{/other_user}","gists_url":"https://api.github.com/users/akien-mga/gists{/gist_id}","starred_url":"https://api.github.com/users/akien-mga/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/akien-mga/subscriptions","organizations_url":"https://api.github.com/users/akien-mga/orgs"