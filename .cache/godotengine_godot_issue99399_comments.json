following{/other_user}","gists_url":"https://api.github.com/users/Calinou/gists{/gist_id}","starred_url":"https://api.github.com/users/Calinou/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Calinou/subscriptions","organizations_url":"https://api.github.com/users/Calinou/orgs","repos_url":"https://api.github.com/users/Calinou/repos","events_url":"https://api.github.com/users/Calinou/events{/privacy}","received_events_url":"https://api.github.com/users/Calinou/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2024-12-03T14:54:40Z","updated_at":"2024-12-03T14:54:53Z","body":"I found the issue: when using Compatibility, the radiance map doesn't update according to the **Default Clear Color** project setting.\n\nIf you set the clear color in `_ready()` instead (or even in `_init()`), it'll work:\n\n```gdscript\nRenderingServer.set_default_clear_color(Color(1, 1, 1))\n```\n\n","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2514797013/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2514797433","html_url":"https://github.com/godotengine/godot/issues/99399#issuecomment-2514797433","issue_url":"https://api.github.com/repos/godotengine/godot/issues/99399","id":2514797433,"node_id":"IC_kwDOAO6SJc6V5MN5","user":{"login":"varianttombstones","id":47457619,"node_id":"MDQ6VXNlcjQ3NDU3NjE5","avatar_url":"https://avatars.githubusercontent.com/u/47457619?v=4","gravatar_id":"","url":"https://api.github.com/users/varianttombstones","html_url":"https://github.com/varianttombstones","followers_url":"https://api.github.com/users/varianttombstones/followers","following_url":"https://api.github.com/users/varianttombstones/following{/other_user}","gists_url":"https://api.github.com/users/varianttombstones/gists{/gist_id}","starred_url":"https://api.github.com/users/varianttombstones/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/varianttombstones/subscriptions","organizations_url":"https://api.github.com/users/varianttombstones/orgs","repos_url":"https://api.github.com/users/varianttombstones/repos","events_url":"https://api.github.com/users/varianttombstones/events{/privacy}","received_events_url":"https://api.github.com/users/varianttombstones/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2024-12-03T14:54:50Z","updated_at":"2024-12-03T14:54:50Z","body":"> I tried the MRP locally. There's no lights in the main scene.\n> \n>     * the cube is black on _Compatibility_\n> \n>     * the cube is lit on _Forward+_\n\nI want to alert both of you to the fact that my post originally said the issue is when testing web exports, I forgot to add lighting and got confused, so I guess it's 2 issues as I just tested the web exports based on both of your comments and even with lighting it renders pitch black just for 1 pixel thin textures.","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2514797433/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2514801741","html_url":"https://github.com/godotengine/godot/issues/99399#issuecomment-2514801741","issue_url":"https://api.github.com/repos/godotengine/godot/issues/99399","id":2514801741,"node_id":"IC_kwDOAO6SJc6V5NRN","user":{"login":"varianttombstones","id":47457619,"node_id":"MDQ6VXNlcjQ3NDU3NjE5","avatar_url":"https://avatars.githubusercontent.com/u/47457619?v=4","gravatar_id":"","url":"https://api.github.com/users/varianttombstones","html_url":"https://github.com/varianttombstones","fo