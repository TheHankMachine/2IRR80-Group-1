[{"id":2840643851,"node_id":"PRR_kwDOAO6SJc6pUMkL","user":{"login":"KoBeWi","id":2223172,"node_id":"MDQ6VXNlcjIyMjMxNzI=","avatar_url":"https://avatars.githubusercontent.com/u/2223172?u=fc85633b469acb6e7baef4dba5171f19a2a4ff85&v=4","gravatar_id":"","url":"https://api.github.com/users/KoBeWi","html_url":"https://github.com/KoBeWi","followers_url":"https://api.github.com/users/KoBeWi/followers","following_url":"https://api.github.com/users/KoBeWi/following{/other_user}","gists_url":"https://api.github.com/users/KoBeWi/gists{/gist_id}","starred_url":"https://api.github.com/users/KoBeWi/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/KoBeWi/subscriptions","organizations_url":"https://api.github.com/users/KoBeWi/orgs","repos_url":"https://api.github.com/users/KoBeWi/repos","events_url":"https://api.github.com/users/KoBeWi/events{/privacy}","received_events_url":"https://api.github.com/users/KoBeWi/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"","state":"COMMENTED","html_url":"https://github.com/godotengine/godot/pull/105848#pullrequestreview-2840643851","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/105848","author_association":"MEMBER","_links":{"html":{"href":"https://github.com/godotengine/godot/pull/105848#pullrequestreview-2840643851"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/105848"}},"submitted_at":"2025-05-14T15:26:41Z","commit_id":"ed35b9e181bb7b38128625ffdc49466572d804bf"},{"id":2840683887,"node_id":"PRR_kwDOAO6SJc6pUWVv","user":{"login":"aaronfranke","id":1646875,"node_id":"MDQ6VXNlcjE2NDY4NzU=","avatar_url":"https://avatars.githubusercontent.com/u/1646875?u=24618295fece29a0bf5c850faf2555985232f5f2&v=4","gravatar_id":"","url":"https://api.github.com/users/aaronfranke","html_url":"https://github.com/aaronfranke","followers_url":"https://api.github.com/users/aaronfranke/followers","following_url":"https://api.github.com/users/aaronfranke/following{/other_user}","gists_url":"https://api.github.com/users/aaronfranke/gists{/gist_id}","starred_url":"https://api.github.com/users/aaronfranke/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/aaronfranke/subscriptions","organizations_url":"https://api.github.com/users/aaronfranke/orgs","repos_url":"https://api.github.com/users/aaronfranke/repos","events_url":"https://api.github.com/users/aaronfranke/events{/privacy}","received_events_url":"https://api.github.com/users/aaronfranke/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"From a glTF perspective, having exported glTF artifacts from tests available after a test run is a good idea so they can be inspected, so I don't think what @demolke suggests is such a good idea. However, we also want to prevent files from building up, and we want to ensure that all test artifacts are from that specific test run, so deleting before running like this PR does is the right move IMO.","state":"COMMENTED","html_url":"https://github.com/godotengine/godot/pull/105848#pullrequestreview-2840683887","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/105848","author_association":"MEMBER","_links":{"html":{"href":"https://github.com/godotengine/godot/pull/105848#pullrequestreview-2840683887"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/105848"}},"submitted_at":"2025-05-14T15:39:39Z","commit_id":"ed35b9e181bb7b38128625ffdc49466572d804bf"},{"id":2840776192,"node_id":"PRR_kwDOAO6SJc6pUs4A","user":{"login":"clayjohn","id":16521339,"node_id":"MDQ6VXNlcjE2NTIxMzM5","avatar_url":"https://avatars.githubusercontent.com/u/16521339?u=e44a465cbebabb9ea2be80b59e6dc07966bef5b7&v=4","gravatar_id":"","url":"https://api.github.com/users/clayjohn","html_url":"https://github.com/clayjohn","followers_url":"https://api.github.com/users/clayjohn/followers","following_url":"https://api.github.com/users/clayjohn/following{/other_user}","gists_url":"https://api.github.com/users/clayjohn/gists{/gist_id}","starred_url":"https://api.github.com/users/clayjohn/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/clayjohn/subscriptions","organizations_url":"https://api.github.com/users/clayjohn/orgs","repos_url":"https://api.github.com/users/clayjohn/repos","events_url":"https://api.github.com/users/clayjohn/events{/privacy}","received_events_url":"https://api.github.com/users/clayjohn/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"Approved in core meeting: We discussed alternatives\r\n1. Keep DirAccess in memory instead of writing to disk (https://github.com/godotengine/godot/pull/99851)\r\n2. Use temporary directories so they are automatically cleaned up\r\n3. Delete the godot_tests directory at the end of running tests. \r\n\r\nIn the end we decided that the approach in this PR is likely the best for a couple of reasons:\r\n1. It is simple and keeps the solution local (https://docs.godotengine.org/en/latest/contributing/development/best_practices_for_engine_contributors.html#prefer-local-solutions)\r\n2. It doesn't require complicated handling code if tests fail \r\n3. It allows developers to manually inspect the generated files after running tests. This is especially important for the GLTF export tests which output GLTF files that need to be loaded into another program to test. \r\n\r\nWe are concerned about having another place in the engine that recursively deletes a folder from the user's disk. But we agreed the proper solution there is to add more warnings (or a confirmation dialogue in user space) before deleting folders recursively. But that is something for a future PR","state":"APPROVED","html_url":"https://github.com/godotengine/godot/pull/105848#pullrequestreview-2840776192","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/105848","author_association":"MEMBER","_links":{"html":{"href":"https://github.com/godotengine/godot/pull/105848#pullrequestreview-2840776192"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/105848"}},"submitted_at":"2025-05-14T16:09:20Z","commit_id":"ed35b9e181bb7b38128625ffdc49466572d804bf"}]