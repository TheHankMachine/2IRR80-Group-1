:"","archived_at":null,"archived_by":null}],"state":"closed","locked":false,"assignees":[],"milestone":{"url":"https://api.github.com/repos/godotengine/godot/milestones/22","html_url":"https://github.com/godotengine/godot/milestone/22","labels_url":"https://api.github.com/repos/godotengine/godot/milestones/22/labels","id":12070367,"node_id":"MI_kwDOAO6SJc4AuC3f","number":22,"title":"4.5","description":"","creator":{"login":"Sauermann","id":6299227,"node_id":"MDQ6VXNlcjYyOTkyMjc=","avatar_url":"https://avatars.githubusercontent.com/u/6299227?v=4","gravatar_id":"","url":"https://api.github.com/users/Sauermann","html_url":"https://github.com/Sauermann","followers_url":"https://api.github.com/users/Sauermann/followers","following_url":"https://api.github.com/users/Sauermann/following{/other_user}","gists_url":"https://api.github.com/users/Sauermann/gists{/gist_id}","starred_url":"https://api.github.com/users/Sauermann/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Sauermann/subscriptions","organizations_url":"https://api.github.com/users/Sauermann/orgs","repos_url":"https://api.github.com/users/Sauermann/repos","events_url":"https://api.github.com/users/Sauermann/events{/privacy}","received_events_url":"https://api.github.com/users/Sauermann/received_events","type":"User","user_view_type":"public","site_admin":false},"open_issues":3,"closed_issues":3687,"state":"closed","created_at":"2024-12-19T08:51:28Z","updated_at":"2026-09-04T21:48:38Z","due_on":"2025-09-15T00:00:00Z","closed_at":"2025-09-18T17:13:14Z"},"comments":5,"created_at":"2025-05-15T11:54:27Z","updated_at":"2025-05-15T15:46:46Z","closed_at":"2025-05-15T15:29:33Z","assignee":null,"author_association":"MEMBER","issue_field_values":[],"type":null,"active_lock_reason":null,"draft":false,"pull_request":{"url":"https://api.github.com/repos/godotengine/godot/pulls/106438","html_url":"https://github.com/godotengine/godot/pull/106438","diff_url":"https://github.com/godotengine/godot/pull/106438.diff","patch_url":"https://github.com/godotengine/godot/pull/106438.patch","merged_at":"2025-05-15T15:29:33Z"},"body":"There is currently an undocumented feature to disable CI entirely, by setting `DISABLE_GODOT_CI` to `1` in the environment variables.\r\n\r\nHowever, it is impossible right now to manually trigger CI when it is disabled, because if the `Re-run all jobs` button is clicked, it will just skip the CI again.\r\n\r\nThis PR rectifies this, by ignoring `DISABLE_GODOT_CI` on the second run attempt:\r\n\r\n![SCR-20250515-mjlh](https://github.com/user-attachments/assets/6b434ff0-cc55-4de2-b3ad-013bba4b8db5)\r\n\r\n## Relations\r\nIt was proposed in https://github.com/godotengine/godot/pull/75336 to add a manual `workflow_dispatch` trigger. \r\nHowever, this trigger would not work for this use case, because if `DISABLE_GODOT_CI` is set, the workflow would be skipped even on manual dispatch.\r\nIt would be possible to allow CI to ignore `DISABLE_GODOT_CI` on `workflow_dispatch` events, but as @YuriSizov described in https://github.com/godotengine/godot/pull/75336, there is no reason to add this dispatch if we already have the `Re-run all jobs` button.","closed_by":{"login":"Repiteo","id":17489292,"node_id":"MDQ6VXNlcjE3NDg5Mjky","avatar_url":"https://avatars.githubusercontent.com/u/17489292?v=4","gravatar_id":"","url":"https://api.github.com/users/Repiteo","html_url":"https://github.com/Repiteo","followers_url":"https://api.github.com/users/Repiteo/followers","following_url":"https://api.github.com/users/Repiteo/following{/other_user}","gists_url":"https://api.github.com/users/Repiteo/gists{/gist_id}","starred_url":"https://api.github.com/users/Repiteo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Repiteo/subscriptions","organizations_url":"https://api.github.com/users/Repiteo/orgs","repos_url":"https://api.github.com/users/Repiteo/repos","events_url":"https://api.github.com/users/Repiteo/events{/privacy}","received_events_url":"https://api.github.com/users/Repiteo/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/106438/reactions","total_count":2,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":1},"timeline_url":"https://api.github.com/repos/godotengine/godot/issues/106438/timeline","performed_via_github_app":null,"state_reason":null}