ized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3460594184","html_url":"https://github.com/godotengine/godot/issues/101142#issuecomment-3460594184","issue_url":"https://api.github.com/repos/godotengine/godot/issues/101142","id":3460594184,"node_id":"IC_kwDOAO6SJc7ORHoI","user":{"login":"c-m-z-fan","id":230925023,"node_id":"U_kgDODcOi3w","avatar_url":"https://avatars.githubusercontent.com/u/230925023?v=4","gravatar_id":"","url":"https://api.github.com/users/c-m-z-fan","html_url":"https://github.com/c-m-z-fan","followers_url":"https://api.github.com/users/c-m-z-fan/followers","following_url":"https://api.github.com/users/c-m-z-fan/following{/other_user}","gists_url":"https://api.github.com/users/c-m-z-fan/gists{/gist_id}","starred_url":"https://api.github.com/users/c-m-z-fan/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/c-m-z-fan/subscriptions","organizations_url":"https://api.github.com/users/c-m-z-fan/orgs","repos_url":"https://api.github.com/users/c-m-z-fan/repos","events_url":"https://api.github.com/users/c-m-z-fan/events{/privacy}","received_events_url":"https://api.github.com/users/c-m-z-fan/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-10-29T09:36:55Z","updated_at":"2025-10-29T09:36:55Z","body":"I don't know if it's the same bug or I just did the math wrong, but the projection matrix from xr_interface.get_projection_for_view(view_index, eye_aspect_ratio, camera.near, camera.far) gave me wrong perspective in y axis, and I fixed it by negate proj.z[1]\n```\nproj.x[0], proj.x[1], proj.x[2], 0.0, \nproj.y[0], proj.y[1], proj.y[2], 0.0,\nproj.z[0], -proj.z[1], proj.z[2],-1.0,\nproj.w[0], proj.w[1], proj.w[2], 0.0\n```\n\n(godot 4.5, vulkan)","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3460594184/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null}]