thub.com/users/Repiteo","html_url":"https://github.com/Repiteo","followers_url":"https://api.github.com/users/Repiteo/followers","following_url":"https://api.github.com/users/Repiteo/following{/other_user}","gists_url":"https://api.github.com/users/Repiteo/gists{/gist_id}","starred_url":"https://api.github.com/users/Repiteo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Repiteo/subscriptions","organizations_url":"https://api.github.com/users/Repiteo/orgs","repos_url":"https://api.github.com/users/Repiteo/repos","events_url":"https://api.github.com/users/Repiteo/events{/privacy}","received_events_url":"https://api.github.com/users/Repiteo/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-07-28T16:04:13Z","updated_at":"2025-07-28T16:04:13Z","body":"Assigning @KoBeWi because it's possible this has overlap with the various UID changes in 4.5; if I'm mistaken, feel free to reassign","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3127937431/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3128108509","html_url":"https://github.com/godotengine/godot/issues/108973#issuecomment-3128108509","issue_url":"https://api.github.com/repos/godotengine/godot/issues/108973","id":3128108509,"node_id":"IC_kwDOAO6SJc66cyXd","user":{"login":"KoBeWi","id":2223172,"node_id":"MDQ6VXNlcjIyMjMxNzI=","avatar_url":"https://avatars.githubusercontent.com/u/2223172?v=4","gravatar_id":"","url":"https://api.github.com/users/KoBeWi","html_url":"https://github.com/KoBeWi","followers_url":"https://api.github.com/users/KoBeWi/followers","following_url":"https://api.github.com/users/KoBeWi/following{/other_user}","gists_url":"https://api.github.com/users/KoBeWi/gists{/gist_id}","starred_url":"https://api.github.com/users/KoBeWi/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/KoBeWi/subscriptions","organizations_url":"https://api.github.com/users/KoBeWi/orgs","repos_url":"https://api.github.com/users/KoBeWi/repos","events_url":"https://api.github.com/users/KoBeWi/events{/privacy}","received_events_url":"https://api.github.com/users/KoBeWi/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-07-28T16:45:20Z","updated_at":"2025-07-28T16:45:20Z","body":"It's unrelated to UIDs.","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3128108509/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3128398443","html_url":"https://github.com/godotengine/godot/issues/108973#issuecomment-3128398443","issue_url":"https://api.github.com/repos/godotengine/godot/issues/108973","id":3128398443,"node_id":"IC_kwDOAO6SJc66d5Jr","user":{"login":"mihe","id":4884246,"node_id":"MDQ6VXNlcjQ4ODQyNDY=","avatar_url":"https://avatars.githubusercontent.com/u/4884246?v=4","gravatar_id":"","url":"https://api.github.com/users/mihe","html_url":"https://github.com/mihe","followers_url":"https://api.github.com/users/mihe/followers","following_url":"https://api.github.com/users/mihe/following{/other_user}","gists_url":"https://api.github.com/users/mihe/gists{/gist_id}","starred_url":"https://api.github.com/users/mihe/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/mihe/subscriptions","organizations_url":"https://api.github.com/users/mihe/orgs","repos_url":"https://api.github.com/users/mihe/repos","events_url":"https://api.github.com/users/mihe/events{/privacy}","received_events_url":"https://api.github.com/users/mihe/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-07-28T18:04:05Z","updated_at":"2025-07-28T18:14:38Z","body":"I had a brief chat with @reduz about this earlier today, and it seemed like the fact that `Resource::generate_scene_unique_id` is deterministic for these particular IDs likely wasn't the intention of the PR (#97362) that added it, as it was mainly meant to deal with the IDs of _internal_ resources.\n\nSo I guess this bug should have rightfully manifested as the ID changing with every single save, but the IDs happened to be made stable (and to \"collide\") by #97362.\n\nIt seemed like the best solution to all this would be to just scrap the external resource IDs altogether, as they seem to be rather redundant when we have UIDs for all resources anyway, and `ExtResource` could just reference those instead. That might however be a bit drastic this late in the release cycle.\n\nI feel like the solution could also be as simple as just moving `Resource::set_id_for_path` from `ResourceLoaderText::_parse_ext_resource` to somewhere in `ResourceLoaderText::load`, and cache the IDs based on the `ext_resource` in the \"header\" rather than what's found as an `ExtResource` reference. I'll be trying that out, but if someone more knowledgeable about this area would have a look as well, that'd be appreciated.\n\nEDIT: The hash \"collision\" part of it can (and probably should) be fixed by basing the `id` on the UID of the resource instead, but that alone doesn't resolve the changing of IDs after upgrading unfortunately.","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3128398443/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3135842509","html_url":"https://github.com/godotengine/godot/issues/108973#issuecomment-3135842509","issue_url":"https://api.github.com/repos/godotengine/godot/issues/108973","id":3135842509,"node_id":"IC_kwDOAO6SJc666SjN","user":{"login":"mihe","id":4884246,"node_id":"MDQ6VXNlcjQ4ODQyNDY=","avatar_url":"https://avatars.githubusercontent.com/u/4884246?v=4","gravatar_id":"","url":"https://api.github.com/users/mihe","html_url":"https://github.com/mihe","followers_url":"https://api.github.com/users/mihe/followers","following_url":"https://api.github.com/users/mihe/following{/other_user}","gists_url":"https://api.github.com/users/mihe/gists{/gist_id}","starred_url":"https://api.github.com/users/mihe/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/mihe/subscriptions","organizations_url":"https://api.github.com/users/mihe/orgs","repos_url":"https://api.github.com/users/mihe/repos","events_url":"https://api.github.com/users/mihe/events{/privacy}","received_events_url":"https://api.github.com/users/mihe/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-07-30T11:12:15Z","updated_at":"2025-07-30T11:12:15Z","body":"I've put up a tentative fix for this: #109122\n\nNote that it doesn't address the way in which the hashes are calculated, as I suggested in my previous comment. I figured it's not as pressing of an issue, and we really should look into replacing these external resource IDs with UID references in 4.6 instead.","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3135842509/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null}]