gist_id}","starred_url":"https://api.github.com/users/kitbdev/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/kitbdev/subscriptions","organizations_url":"https://api.github.com/users/kitbdev/orgs","repos_url":"https://api.github.com/users/kitbdev/repos","events_url":"https://api.github.com/users/kitbdev/events{/privacy}","received_events_url":"https://api.github.com/users/kitbdev/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-07-28T18:10:06Z","updated_at":"2026-07-28T18:13:07Z","body":"I cannot reproduce on desktop, the script editor always responds to window resizes and can shrink the script name fully.\n\nThe editor window and the EditorTitleBar have minimum sizes, but once I remove them manually then then it shrinks. (On android the EditorTitleBar is hidden and I assume the root window min size is set small enough).\nEx Or in a floating window:\n<img width=\"582\" height=\"76\" alt=\"Image\" src=\"https://github.com/user-attachments/assets/8d1969d6-8f1e-46b1-855b-62ac93d15c9a\" />","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5107953174/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5110297116","html_url":"https://github.com/godotengine/godot/issues/121854#issuecomment-5110297116","issue_url":"https://api.github.com/repos/godotengine/godot/issues/121854","id":5110297116,"node_id":"IC_kwDOAO6SJc8AAAABMJjyHA","user":{"login":"StarryWorm","id":41305715,"node_id":"MDQ6VXNlcjQxMzA1NzE1","avatar_url":"https://avatars.githubusercontent.com/u/41305715?v=4","gravatar_id":"","url":"https://api.github.com/users/StarryWorm","html_url":"https://github.com/StarryWorm","followers_url":"https://api.github.com/users/StarryWorm/followers","followin