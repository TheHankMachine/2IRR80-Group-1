[{"id":3249371083,"node_id":"PRR_kwDOAO6SJc7BrXfL","state":"COMMENTED","user":{"site_admin":false,"suspended":false,"updated_at":"0001-01-01T00:00:00Z","avatar_url":"https://avatars.githubusercontent.com/u/71766835?v=4","created_at":"0001-01-01T00:00:00Z","followers":0,"following":0,"html_url":"https://github.com/j20001970","id":71766835,"node_id":"MDQ6VXNlcjcxNzY2ODM1","login":"j20001970","type":"User","owned_private_repos":0,"public_gists":0,"public_repos":0,"total_private_repos":0,"url":"https://api.github.com/users/j20001970"},"body":"","html_url":"https://github.com/godotengine/godot/pull/110720#pullrequestreview-3249371083","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/110720","author_association":"CONTRIBUTOR","submitted_at":"2025-09-21T03:31:53Z"},{"id":3250027032,"node_id":"PRR_kwDOAO6SJc7Bt3oY","state":"APPROVED","user":{"site_admin":false,"suspended":false,"updated_at":"0001-01-01T00:00:00Z","avatar_url":"https://avatars.githubusercontent.com/u/71766835?v=4","created_at":"0001-01-01T00:00:00Z","followers":0,"following":0,"html_url":"https://github.com/j20001970","id":71766835,"node_id":"MDQ6VXNlcjcxNzY2ODM1","login":"j20001970","type":"User","owned_private_repos":0,"public_gists":0,"public_repos":0,"total_private_repos":0,"url":"https://api.github.com/users/j20001970"},"body":"","html_url":"https://github.com/godotengine/godot/pull/110720#pullrequestreview-3250027032","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/110720","author_association":"CONTRIBUTOR","submitted_at":"2025-09-21T13:32:04Z"},{"id":3354919337,"node_id":"PRR_kwDOAO6SJc7H-AGp","state":"CHANGES_REQUESTED","commit_id":"4dc0c56d5c87e1f36570d5d41a3ef198ac6a7262","user":{"site_admin":false,"suspended":false,"updated_at":"0001-01-01T00:00:00Z","avatar_url":"https://avatars.githubusercontent.com/u/914968?u=5f2b0cb28e37393252e96695f2eaa33494930285&v=4","created_at":"0001-01-01T00:00:00Z","followers":0,"following":0,"html_url":"https://github.com/m4gr3d","id":914968,"node_id":"MDQ6VXNlcjkxNDk2OA==","login":"m4gr3d","type":"User","owned_private_repos":0,"public_gists":0,"public_repos":0,"total_private_repos":0,"url":"https://api.github.com/users/m4gr3d"},"body":"> * Why Lifecycle Management?\n>   Android invalidates camera resources when the app is paused or the device rotates. These methods properly handle these events by deactivating/reactivating camera sessions and refreshing metadata to maintain correct functionality.\n> * Race Condition Details\n>   Previously, if deactivate_feed() was called while onImage() callback was executing, it could access freed resources. The callback_mutex ensures thread-safe cleanup, and the corrected order (device → reader → request) prevents use-after-free errors.\n> * Front Camera Mirror Effect\n>   Users expect front cameras to behave like mirrors. We apply horizontal flip via Transform2D scaling (-1.0, 1.0) before rotation, matching standard camera app behavior.\n> * Metadata Refresh Mechanism\n>   During configuration changes (rotation), Android camera metadata (sensor orientation, formats) may become invalid. refresh_camera_metadata() re-fetches this data from the camera manager, ensuring the camera state stays synchronized with the system.\n> * Safety Philosophy\n>   Multiple defensive checks prevent crashes in unexpected states: null metadata, invalid format indices, zero dimensions, and inactive feeds. When problems are detected, the code attempts recovery (metadata refresh) or gracefully skips processing rather than crashing.\n\nThis will need to be split into multiple PRs:\n- One PR for the YUV_420_888 strides fix\n- Another PR for the rotation bug\n- Another PR for the front camera mirror effect","html_url":"https://github.com/godotengine/godot/pull/110720#pullrequestreview-3354919337","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/110720","author_association":"CONTRIBUTOR","submitted_at":"2025-10-20T03:44:12Z"},{"id":3358998920,"node_id":"PRR_kwDOAO6SJc7INkGI","state":"COMMENTED","commit_id":"9a943c0405e4ce359635b30030795f86af0f788b","user":{"site_admin":false,"suspended":false,"updated_at":"0001-01-01T00:00:00Z","avatar_url":"https://avatars.githubusercontent.com/u/914968?u=5f2b0cb28e37393252e96695f2eaa33494930285&v=4","created_at":"0001-01-01T00:00:00Z","followers":0,"following":0,"html_url":"https://github.com/m4gr3d","id":914968,"node_id":"MDQ6VXNlcjkxNDk2OA==","login":"m4gr3d","type":"User","owned_private_repos":0,"public_gists":0,"public_repos":0,"total_private_repos":0,"url":"https://api.github.com/users/m4gr3d"},"body":"","html_url":"https://github.com/godotengine/godot/pull/110720#pullrequestreview-3358998920","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/110720","author_association":"CONTRIBUTOR","submitted_at":"2025-10-21T06:57:40Z"},{"id":3359132672,"node_id":"PRR_kwDOAO6SJc7IOEwA","state":"COMMENTED","commit_id":"9a943c0405e4ce359635b30030795f86af0f788b","user":{"site_admin":false,"suspended":false,"updated_at":"0001-01-01T00:00:00Z","avatar_url":"https://avatars.githubusercontent.com/u/1295639?v=4","created_at":"0001-01-01T00:00:00Z","followers":0,"following":0,"html_url":"https://github.com/shiena","id":1295639,"node_id":"MDQ6VXNlcjEyOTU2Mzk=","login":"shiena","type":"User","owned_private_repos":0,"public_gists":0,"public_repos":0,"total_private_repos":0,"url":"https://api.github.com/users/shiena"},"body":"","html_url":"https://github.com/godotengine/godot/pull/110720#pullrequestreview-3359132672","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/110720","author_association":"CONTRIBUTOR","submitted_at":"2025-10-21T07:29:47Z"},{"id":3611613299,"node_id":"PRR_kwDOAO6SJc7XRNhz","state":"COMMENTED","user":{"site_admin":false,"suspended":false,"updated_at":"0001-01-01T00:00:00Z","avatar_url":"https://avatars.githubusercontent.com/u/41921395?u=74caa4e396a8e2995ac648a80f7488601d679e63&v=4","created_at":"0001-01-01T00:00:00Z","followers":0,"following":0,"html_url":"https://github.com/Alex2782","id":41921395,"node_id":"MDQ6VXNlcjQxOTIxMzk1","login":"Alex2782","type":"User","owned_private_repos":0,"public_gists":0,"public_repos":0,"total_private_repos":0,"url":"https://api.github.com/users/Alex2782"},"body":"\nTested on these two devices, first with `v4.5.1-stable`:\n- Pixel 4a, Qualcomm - Adreno (TM) 618\n- Samsung Tab S 7, Qualcomm - Adreno (TM) 650\n\nReproducible on both devices (black screen), Pixel 4a also crashed after 2 to 3 seconds.\n\n---------------\n\n**This PR:**\n- On my `Samsung Tab S7` I see the \"CameraFeed\", but as soon as I press \"Reload\" or select a different camera (Back / Front), it stops working and the screen remains black.\n\n- On my `Pixel 4a`, I see the \"CameraFeed\" for 2 to 3 seconds, then the app keeps crashing. Should I debug this with Android Studio?\n","html_url":"https://github.com/godotengine/godot/pull/110720#pullrequestreview-3611613299","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/110720","author_association":"MEMBER","submitted_at":"2025-12-24T21:58:08Z"},{"id":3628711299,"node_id":"PRR_kwDOAO6SJc7YSb2D","state":"APPROVED","user":{"site_admin":false,"suspended":false,"updated_at":"0001-01-01T00:00:00Z","avatar_url":"https://avatars.githubusercontent.com/u/41921395?u=74caa4e396a8e2995ac648a80f7488601d679e63&v=4","created_at":"0001-01-01T00:00:00Z","followers":0,"following":0,"html_url":"https://github.com/Alex2782","id":41921395,"node_id":"MDQ6VXNlcjQxOTIxMzk1","login":"Alex2782","type":"User","owned_private_repos":0,"public_gists":0,"public_repos":0,"total_private_repos":0,"url":"https://api.github.com/users/Alex2782"},"body":"It looks great on both of my devices now!\r\n\r\nI can't say much about the code (I'm not very familiar with it)\r\n\r\nExcept that you should avoid `auto`. \r\nhttps://contributing.godotengine.org/en/latest/engine/guidelines/cpp_usage_guidelines.html#auto-keyword\r\n\r\nHowever, a line of code containing `auto` was already accepted 8 months ago. (`CameraFeedAndroid::onDisconnected`)","html_url":"https://github.com/godotengine/godot/pull/110720#pullrequestreview-3628711299","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/110720","author_association":"MEMBER","submitted_at":"2026-01-05T23:13:11Z"},{"id":3631703327,"node_id":"PRR_kwDOAO6SJc7Yd2Uf","state":"APPROVED","user":{"site_admin":false,"suspended":false,"updated_at":"0001-01-01T00:00:00Z","avatar_url":"https://avatars.githubusercontent.com/u/914968?u=5f2b0cb28e37393252e96695f2eaa33494930285&v=4","created_at":"0001-01-01T00:00:00Z","followers":0,"following":0,"html_url":"https://github.com/m4gr3d","id":914968,"node_id":"MDQ6VXNlcjkxNDk2OA==","login":"m4gr3d","type":"User","owned_private_repos":0,"public_gists":0,"public_repos":0,"total_private_repos":0,"url":"https://api.github.com/users/m4gr3d"},"body":"The code looks good. Can you squash the commits.","html_url":"https://github.com/godotengine/godot/pull/110720#pullrequestreview-3631703327","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/110720","author_association":"CONTRIBUTOR","submitted_at":"2026-01-06T16:59:47Z"},{"id":3631823684,"node_id":"PRR_kwDOAO6SJc7YeTtE","state":"COMMENTED","user":{"site_admin":false,"suspended":false,"updated_at":"0001-01-01T00:00:00Z","avatar_url":"https://avatars.githubusercontent.com/u/4701338?u=4a42fd867f2c449fcc23adf635dd574dae98e6c2&v=4","created_at":"0001-01-01T00:00:00Z","followers":0,"following":0,"html_url":"https://github.com/akien-mga","id":4701338,"node_id":"MDQ6VXNlcjQ3MDEzMzg=","login":"akien-mga","type":"User","owned_private_repos":0,"public_gists":0,"public_repos":0,"total_private_repos":0,"url":"https://api.github.com/users/akien-mga"},"body":"","html_url":"https://github.com/godotengine/godot/pull/110720#pullrequestreview-3631823684","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/110720","author_association":"MEMBER","submitted_at":"2026-01-