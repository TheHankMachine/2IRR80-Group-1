[{"id":2679621722,"node_id":"PRR_kwDOAO6SJc6ft8ha","state":"APPROVED","user":{"site_admin":false,"suspended":false,"updated_at":"0001-01-01T00:00:00Z","avatar_url":"https://avatars.githubusercontent.com/u/191561?v=4","created_at":"0001-01-01T00:00:00Z","followers":0,"following":0,"html_url":"https://github.com/dsnopek","id":191561,"node_id":"MDQ6VXNlcjE5MTU2MQ==","login":"dsnopek","type":"User","owned_private_repos":0,"public_gists":0,"public_repos":0,"total_private_repos":0,"url":"https://api.github.com/users/dsnopek"},"body":"Thanks!\r\n\r\nThis is really great. :-) I like how it unifies some of the manifest changes (metadata and features) in both Gradle and APK-based builds.\r\n\r\nI tested doing an OpenXR build using just an APK-based export (with an APK built from https://github.com/godot-sdk-integrations/godot-meta-toolkit/pull/15) and it worked great. I also \"decompiled\" the APK with apktool and the manifest all looks good.\r\n\r\nHowever, I'm not sure this is a good one for cherry-picking, at least not right away. There's the virtual method that's added here (which we don't usually add in patch releases), but it also just seems like a lot of changes. Maybe wait until it's gotten a bunch more testing in 4.5-dev releases first? I know there's some fixes mixed in here too - if some of them don't depend on the feature changes, maybe they could be extracted to another PR?","html_url":"https://github.com/godotengine/godot/pull/103173#pullrequestreview-2679621722","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/103173","author_association":"CONTRIBUTOR","submitted_at":"2025-03-12T20:11:33Z"},{"id":2682241120,"node_id":"PRR_kwDOAO6SJc6f38Bg","state":"COMMENTED","user":{"site_admin":false,"suspended":false,"updated_at":"0001-01-01T00:00:00Z","avatar_url":"https://avatars.githubusercontent.com/u/96648715?u=af70f5d107e9c1447f296643d5a566dab53d25e8&v=4","created_at":"0001-01-01T00:00:00Z","followers":0,"following":0,"html_url":"https://github.