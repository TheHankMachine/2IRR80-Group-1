etwork errors, or occasional changes in how the Vulkan SDK is distributed which require editing our script.\r\n\r\nToday it started failing because https://sdk.lunarg.com/ returns error 502: Bad Gateway.\r\n\r\nA drawback of this change is that if the Vulkan SDK does change setup and the step fails due to other aspects than network errors, we won't catch it right away. We'd need to manually check the log once in a while to confirm that it's still being installed and enabled fine. But it's probably ok.","labels":[{"id":73330066,"node_id":"MDU6TGFiZWw3MzMzMDA2Ng==","url":"https://api.github.com/repos/godotengine/godot/labels/enhancement","name":"enhancement","description":"","color":"aaccff","default":true,"archived_at":null,"archived_by":null},{"id":279097780,"node_id":"MDU6TGFiZWwyNzkwOTc3ODA=","url":"https://api.github.com/repos/godotengine/godot/labels/platform:macos","name":"platform:macos","description":"","color":"e4e4e4","default":false,"archived_at":null,"archived_by":null},{"id":279098009,"node_id":"MDU6TGFiZWwyNzkwOTgwMDk=","url":"https://api.github.com/repos/godotengine/godot/labels/topic:buildsystem","name":"topic:buildsystem","description":"","color":"ffee88","default":false,"archived_at":null,"archived_by":null},{"id":8089024095,"node_id":"LA_kwDOAO6SJc8AAAAB4iS2Xw","url":"https://api.github.com/repos/godotengine/godot/labels/cherrypick:4.4","name":"cherrypick:4.4","description":"Considered for cherry-picking into a future 4.4.x release","color":"446699","default":false,"archived_at":null,"archived_by":null}],"milestone":{"id":12070367,"node_id":"MI_kwDOAO6SJc4AuC3f","url":"https://api.github.com/repos/godotengine/godot/milestones/22","html_url":"https://github.com/godotengine/godot/milestone/22","labels_url":"https://api.github.com/repos/godotengine/godot/milestones/22/labels","number":22,"state":"closed","title":"4.5","description":"","creator":{"login":"Sauermann","id":6299227,"node_id":"MDQ6VXNlcjYyOTkyMjc=","avatar_url":"https://avatars.githubuserc