`on_sync_receive` functions perform unsigned arithmetic (`p_buffer_len - ofs`) that can underflow if `ofs` exceeds `p_buffer_len`. A malicious client can craft packets that bypass size validation, leading to out-of-bounds memory access.\n\n## Fix\n\nAdded explicit bounds checks (`ofs > p_buffer_len || ...`) before each unsigned subtraction to ensure the offset never exceeds the buffer length before performing safe arithmetic.\n\n## Files Changed\n\n- `modules/multiplayer/scene_replication_interface.cpp`","labels":[{"id":279096997,"node_id":"MDU6TGFiZWwyNzkwOTY5OTc=","url":"https://api.github.com/repos/godotengine/godot/labels/archived","name":"archived","description":"","color":"aaaaaa","default":false,"archived_at":null,"archived_by":null},{"id":6051509301,"node_id":"LA_kwDOAO6SJc8AAAABaLK0NQ","url":"https://api.github.com/repos/godotengine/godot/labels/spam","name":"spam","description":"","color":"E94A26","default":false,"archived_at":null,"archived_by":null}],"milestone":null,"active_lock_reason":null,"created_at":"2026-07-14T15:15:14Z","updated_at":"2026-07-15T08:12:23Z","closed_at":"2026-07-15T08:12:15Z","merged_at":null,"merge_commit_sha":"441c5a01fa10fc12117c4b5049ac73cb5d0866c9","assignee":null,"assignees":[],"requested_reviewers":[],"requested_teams":[],"head":{"label":"warsang:fix/bounds-check-underflow","ref":"fix/bounds-check-underflow","repo":{"id":1172939991,"node_id":"R_kgDORemk1w","name":"godot","full_name":"warsang/godot","owner":{"login":"warsang","id":9167018,"node_id":"MDQ6VXNlcjkxNjcwMTg=","avatar_url":"https://avatars.githubusercontent.com/u/9167018?v=4","gravatar_id":"","url":"https://api.github.com/users/warsang","html_url":"https://github.com/warsang","followers_url":"https://api.github.com/users/warsang/followers","following_url":"https://api.github.com/users/warsang/following{/other_user}","gists_url":"https://api.github.com/users/warsang/gists{/gist_id}","starred_url":"https://api.github.com/users/warsang/starred{/owner}{/repo}","subscrip