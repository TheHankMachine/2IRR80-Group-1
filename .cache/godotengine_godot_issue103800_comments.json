busercontent.com/u/44306054?v=4","gravatar_id":"","url":"https://api.github.com/users/matheusmdx","html_url":"https://github.com/matheusmdx","followers_url":"https://api.github.com/users/matheusmdx/followers","following_url":"https://api.github.com/users/matheusmdx/following{/other_user}","gists_url":"https://api.github.com/users/matheusmdx/gists{/gist_id}","starred_url":"https://api.github.com/users/matheusmdx/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/matheusmdx/subscriptions","organizations_url":"https://api.github.com/users/matheusmdx/orgs","repos_url":"https://api.github.com/users/matheusmdx/repos","events_url":"https://api.github.com/users/matheusmdx/events{/privacy}","received_events_url":"https://api.github.com/users/matheusmdx/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-03-09T08:51:30Z","updated_at":"2025-03-09T08:51:30Z","body":"Could you test the versions between 4.3 stable and 4.4 stable to find when this problem started? You can download them here: https://godotengine.org/download/archive/ ","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2708742198/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2711166978","html_url":"https://github.com/godotengine/godot/issues/103800#issuecomment-2711166978","issue_url":"https://api.github.com/repos/godotengine/godot/issues/103800","id":2711166978,"node_id":"IC_kwDOAO6SJc6hmSAC","user":{"login":"cinderous","id":5582199,"node_id":"MDQ6VXNlcjU1ODIxOTk=","avatar_url":"https://avatars.githubusercontent.com/u/5582199?v=4","gravatar_id":"","url":"https://api.github.com/users/cinderous","html_url":"https://github.com/cinderous","followers_url":"https://api.github.com/users/cinderous/followers","following_url":"https://api.github.com/users/cinderous/following{/other_user}","gists_url":"https://api.github.com/users/cinderous/gists{/gist_id}","starred_url":"https://api.github.com/users/cinderous/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/cinderous/subscriptions","organizations_url":"https://api.github.com/users/cinderous/orgs","repos_url":"https://api.github.com/users/cinderous/repos","events_url":"https://api.github.com/users/cinderous/events{/privacy}","received_events_url":"https://api.github.com/users/cinderous/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-03-10T16:29:44Z","updated_at":"2025-03-10T16:29:44Z","body":"From further testing, my previous comments about 4.3 working was only due to compatibility render mode. If I use forward+ it still happens in 4.3 stable. Let me try to use a different computer perhaps and do further testing. It will be a few days before I can setup my other computer. Please leave this open if you deem necessary. ","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2711166978/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2711287563","html_url":"https://github.com/godotengine/godot/issues/103800#issuecomment-2711287563","issue_url":"https://api.github.com/repos/godotengine/godot/issues/103800","id":2711287563,"node_id":"IC_kwDOAO6SJc6hmvcL","user":{"login":"Calinou","id":180032,"node_id":"MDQ6VXNlcjE4MDAzMg==","avatar_url":"https://avatars.githubusercontent.com/u/180032?v=4","gravatar_id":"","url":"https://api.github.com/users/Calinou","html_url":"https://github.com/Calinou","followers_url":"https://api.github.com/users/Calinou/followers","following_url":"https://api.github.com/users/Calinou/following{/other_user}","gists_url":"https://api.github.com/users/Calinou/gists{/gist_id}","starred_url":"https://api.github.com/users/Calinou/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Calinou/subscriptions","organizations_url":"https://api.github.com/users/Calinou/orgs","repos_url":"https://api.github.com/users/Calinou/repos","events_url":"https://api.github.com/users/Calinou/events{/privacy}","received_events_url":"https://api.github.com/users/Calinou/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-03-10T17:12:19Z","updated_at":"2025-03-10T17:13:17Z","body":"Can you reproduce this after switching back to Forward+/Mobile, then changing `rendering_driver.windows` to `d3d12` in the Project Settings and restarting the editor?\n\nThis is almost certainly caused by a negative interaction between the OBS Vulkan layer and Godot. This layer should probably be blocked from Godot to avoid crashes, but it's not listed here:\n\nhttps://github.com/godotengine/godot/blob/30bb49ec1ff3b3fc463074b8d28bc97d4db50b9f/main/main.cpp#L2515-L2535","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2711287563/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2711432089","html_url":"https://github.com/godotengine/godot/issues/103800#issuecomment-2711432089","issue_url":"https://api.github.com/repos/godotengine/godot/issues/103800","id":2711432089,"node_id":"IC_kwDOAO6SJc6hnSuZ","user":{"login":"cinderous","id":5582199,"node_id":"MDQ6VXNlcjU1ODIxOTk=","avatar_url":"https://avatars.githubusercontent.com/u/5582199?v=4","gravatar_id":"","url":"https://api.github.com/users/cinderous","html_url":"https://github.com/cinderous","followers_url":"https://api.github.com/users/cinderous/followers","following_url":"https://api.github.com/users/cinderous/following{/other_user}","gists_url":"https://api.github.com/users/cinderous/gists{/gist_id}","starred_url":"https://api.github.com/users/cinderous/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/cinderous/subscriptions","organizations_url":"https://api.github.com/users/cinderous/orgs","repos_url":"https://api.github.com/users/cinderous/repos","events_url":"https://api.github.com/users/cinderous/events{/privacy}","received_events_url":"https://api.github.com/users/cinderous/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-03-10T18:10:53Z","updated_at":"2025-03-10T18:10:53Z","body":"Thank you. Confirming in 4.3 and 4.4 stables that switching to d3d12 forward+ allows my OBS scene switching plugin to flawlessly detect the windows. The vulkan seems to be culprit.\n\nWith vulkan = crash when switching windows\nwith d3d12 = perfect","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2711432089/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2711437868","html_url":"https://github.com/godotengine/godot/issues/103800#issuecomment-2711437868","issue_url":"https://api.github.com/repos/godotengine/godot/issues/103800","id":2711437868,"node_id":"IC_kwDOAO6SJc6hnUIs","user":{"login":"cinderous","id":5582199,"node_id":"MDQ6VXNlcjU1ODIxOTk=","avatar_url":"https://avatars.githubusercontent.com/u/5582199?v=4","gravatar_id":"","url":"https://api.github.com/users/cinderous","html_url":"https://github.com/cinderous","followers_url":"https://api.github.com/users/cinderous/followers","following_url":"https://api.github.com/users/cinderous/following{/other_user}","gists_url":"https://api.github.com/users/cinderous/gists{/gist_id}","starred_url":"https://api.github.com/users/cinderous/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/cinderous/subscriptions","organizations_url":"https://api.github.com/users/cinderous/orgs","repos_url":"https://api.github.com/users/cinderous/repos","events_url":"https://api.github.com/users/cinderous/events{/privacy}","received_events_url":"https://api.github.com/users/cinderous/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-03-10T18:13:25Z","updated_at":"2025-03-10T18:13:25Z","body":"To clarify, when in vulkan forward plus. I can tab into Godot fine, but as soon as I tab out, it closes. \n\nIf this is a problem related to the plugin of obs, fair enough. THe plugin that detects windows is\n\nhttps://obsproject.com/forum/resources/advanced-scene-switcher.395/\n\nspecifically the Automatic Scene Switcher tool","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2711437868/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2725681031","html_url":"https://github.com/godotengine/godot/issues/103800#issuecomment-2725681031","issue_url":"https://api.github.com/repos/godotengine/godot/issues/103800","id":2725681031,"node_id":"IC_kwDOAO6SJc6idpeH","user":{"login":"unvermuthet","id":40361609,"node_id":"MDQ6VXNlcjQwMzYxNjA5","avatar_url":"https://avatars.githubusercontent.com/u/40361609?v=4","gravatar_id":"","url":"https://api.github.com/users/unvermuthet","html_url":"https://github.com/unvermuthet","followers_url":"https://api.github.com/users/unvermuthet/followers","following_url":"https://api.github.com/users/unvermuthet/following{/other_user}","gists_url":"https://api.github.com/users/unvermuthet/gists{/gist_id}","starred_url":"https://api.github.com/users/unvermuthet/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/unvermuthet/subscriptions","organizations_url":"https://api.github.com/users/unvermuthet/orgs","repos_url":"https://api.github.com/users/unvermuthet/repos","events_url":"https://api.github.com/users/unvermuthet/events{/privacy}","received_events_url":"https://api.github.com/users/unvermuthet/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-03-14T20:26:18Z","updated_at":"2025-03-14T20:26:18Z","body":"You linked `Advanced Scene Switcher`. OBS has `Automatic Scene Switcher` built in. I assume this is about the one you linked?","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2725681031/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2725703681","html_url":"https://github.com/godotengine/godot/issues/103800#issuecomment-2725703681","issue_url":"https://api.github.com/repos/godotengine/godot/issues/103800","id":2725703681,"node_id":"IC_kwDOAO6SJc6idvAB","user":{"login":"unvermuthet","id":40361609,"node_id":"MDQ6VXNlcjQwMzYxNjA5","avatar_url":"https://avatars.githubusercontent.com/u/40361609?v=4","gravatar_id":"","url":"https://api.github.com/users/unvermuthet","html_url":"https://github.com/unvermuthet","followers_url":"https://api.github.com/users/unvermuthet/followers","following_url":"https://api.github.com/users/unvermuthet/following{/other_user}","gists_url":"https://api.github.com/users/unvermuthet/gists{/gist_id}","starred_url":"https://api.github.com/users/unvermuthet/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/unvermuthet/subscriptions","organizations_url":"https://api.github.com/users/unvermuthet/orgs","repos_url":"https://api.github.com/users/unvermuthet/repos","events_url":"https://api.github.com/users/unvermuthet/events{/privacy}","received_events_url":"https://api.github.com/users/unvermuthet/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-03-14T20:40:44Z","updated_at":"2025-03-14T21:27:46Z","body":"I can replicate this without any scene switchers. Only affects OBS's `Game Capture` source and Vulkan drivers in Godot. Nothing in the verbose logs. Doesn't even require switching scenes. Hiding and unhiding the source a few times does the trick too.\n\n```\nGodot v4.4.stable - Windows 11 (build 22631) - Multi-window, 2 monitors - Vulkan (Forward+) - dedicated NVIDIA GeForce RTX 3060 Ti (NVIDIA; 32.0.15.6094) - 12th Gen Intel(R) Core(TM) i5-12400F (12 threads)\n```\n\nhttps://github.com/user-attachments/assets/d37412ff-da98-4b98-bb99-b4e364924775","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2725703681/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2725813720","html_url":"https://github.com/godotengine/godot/issues/103800#issuecomment-2725813720","issue_url":"https://api.github.com/repos/godotengine/godot/issues/103800","id":2725813720,"node_id":"IC_kwDOAO6SJc6ieJ3Y","user":{"login":"unvermuthet","id":40361609,"node_id":"MDQ6VXNlcjQwMzYxNjA5","avatar_url":"https://avatars.githubusercontent.com/u/40361609?v=4","gravatar_id":"","url":"https://api.github.com/users/unvermuthet","html_url":"https://github.com/unvermuthet","followers_url":"https://api.github.com/users/unvermuthet/followers","following_url":"https://api.github.com/users/unvermuthet/following{/other_user}","gists_url":"https://api.github.com/users/unvermuthet/gists{/gist_id}","starred_url":"https://api.github.com/users/unvermuthet/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/unvermuthet/subscriptions","organizations_url":"https://api.github.com/users/unvermuthet/orgs","repos_url":"https://api.github.com/users/unvermuthet/repos","events_url":"https://api.github.com/users/unvermuthet/events{/privacy}","received_events_url":"https://api.github.com/users/unvermuthet/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-03-14T21:27:35Z","updated_at":"2025-03-14T22:44:35Z","body":"Setting the environment variable `DISABLE_VULKAN_OBS_CAPTURE=1` completely fixes the problem for me. Good call @Calinou. Guess I'm making a PR to add that to `main.cpp`.\n\nCan you check if this fixes it for you too, @cinderous? In cmd run `set DISABLE_VULKAN_OBS_CAPTURE=1` then the Godot executable from there.","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2725813720/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null}]