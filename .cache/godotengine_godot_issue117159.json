ist_id}","starred_url":"https://api.github.com/users/akien-mga/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/akien-mga/subscriptions","organizations_url":"https://api.github.com/users/akien-mga/orgs","repos_url":"https://api.github.com/users/akien-mga/repos","events_url":"https://api.github.com/users/akien-mga/events{/privacy}","received_events_url":"https://api.github.com/users/akien-mga/received_events","type":"User","user_view_type":"public","site_admin":false},"open_issues":3,"closed_issues":2535,"state":"closed","created_at":"2025-11-27T20:29:18Z","updated_at":"2026-10-20T18:39:31Z","due_on":null,"closed_at":"2026-06-19T16:54:35Z"},"comments":2,"created_at":"2026-03-06T19:56:15Z","updated_at":"2026-03-30T18:51:49Z","closed_at":"2026-03-30T18:51:49Z","assignee":{"login":"bruvzg","id":7645683,"node_id":"MDQ6VXNlcjc2NDU2ODM=","avatar_url":"https://avatars.githubusercontent.com/u/7645683?v=4","gravatar_id":"","url":"https://api.github.com/users/bruvzg","html_url":"https://github.com/bruvzg","followers_url":"https://api.github.com/users/bruvzg/followers","following_url":"https://api.github.com/users/bruvzg/following{/other_user}","gists_url":"https://api.github.com/users/bruvzg/gists{/gist_id}","starred_url":"https://api.github.com/users/bruvzg/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/bruvzg/subscriptions","organizations_url":"https://api.github.com/users/bruvzg/orgs","repos_url":"https://api.github.com/users/bruvzg/repos","events_url":"https://api.github.com/users/bruvzg/events{/privacy}","received_events_url":"https://api.github.com/users/bruvzg/received_events","type":"User","user_view_type":"public","site_admin":false},"author_association":"CONTRIBUTOR","issue_field_values":[],"type":null,"active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"### Tested versions\n\n- Reproducible since 4.5 (accesskit integration)\n\n### System information\n\nGodot v4.6.stable - Linux Mint 22.3 (Zena) on X11 - X11 display driver, Multi-window, 3 monitors - OpenGL 3 (Compatibility) - NVIDIA GeForce GTX 1050 (nvidia; 535.288.01) - Intel(R) Core(TM) i5-8300H CPU @ 2.30GHz (8 threads) - 23.19 GiB memory\n\n### Issue description\n\nIn the editor, there is a setting to turn on accessibility warnings that show up on controls that are missing a text accessibility_name. I think this is a useful feature! If it was just applied to nodes that are relevant. I do want to know if a button is missing it. Having it show up on every container with the text \"Accessibility name must not be empty\" is incorrect and might have developers implement accessibility incorrectly (like me!).\n\n<img width=\"278\" height=\"226\" alt=\"Screenshot of godot editor tree view with a dozen control nodes of various types showing a yellow warning triangle\" src=\"https://github.com/user-attachments/assets/73d37909-31f0-4102-a007-72738282da3d\" />\n\nYou should not be encouraged to add an accessibility name on every container. Most screen readers will probably skip it because it's not an interactive element, but some may not. And some elements are \"interactive\" like the ScrollContainer where you probably don't want the screen reader to speak its accessibility name.\n\nThere are controls that clearly need it, like a button. And there are controls that clearly don't need it, like a vbox. Then there are a few controls that are up for debate: ScrollContainer, and Custom nodes to name two. I think the best choice here would be to display a warning on those, and change the tooltip to \"Accessibility name is empty. Consider adding the name and description if this control should be announced by the screen reader.\"\n\n### Steps to reproduce\n\nN/A\n\n### Minimal reproduction project (MRP)\n\nN/A","closed_by":{"login":"Repiteo","id":17489292,"node_id":"MDQ6VXNlcjE3NDg5Mjky","avata