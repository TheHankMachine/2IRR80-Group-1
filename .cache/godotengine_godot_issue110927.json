rgs","repos_url":"https://api.github.com/users/Repiteo/repos","events_url":"https://api.github.com/users/Repiteo/events{/privacy}","received_events_url":"https://api.github.com/users/Repiteo/received_events","type":"User","user_view_type":"public","site_admin":false},"open_issues":3,"closed_issues":2978,"state":"closed","created_at":"2025-05-22T16:25:52Z","updated_at":"2026-10-04T16:23:23Z","due_on":null,"closed_at":"2026-01-26T18:09:14Z"},"comments":8,"created_at":"2025-09-26T12:15:02Z","updated_at":"2025-10-21T15:55:43Z","closed_at":"2025-10-21T15:44:30Z","assignee":{"login":"dsnopek","id":191561,"node_id":"MDQ6VXNlcjE5MTU2MQ==","avatar_url":"https://avatars.githubusercontent.com/u/191561?v=4","gravatar_id":"","url":"https://api.github.com/users/dsnopek","html_url":"https://github.com/dsnopek","followers_url":"https://api.github.com/users/dsnopek/followers","following_url":"https://api.github.com/users/dsnopek/following{/other_user}","gists_url":"https://api.github.com/users/dsnopek/gists{/gist_id}","starred_url":"https://api.github.com/users/dsnopek/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/dsnopek/subscriptions","organizations_url":"https://api.github.com/users/dsnopek/orgs","repos_url":"https://api.github.com/users/dsnopek/repos","events_url":"https://api.github.com/users/dsnopek/events{/privacy}","received_events_url":"https://api.github.com/users/dsnopek/received_events","type":"User","user_view_type":"public","site_admin":false},"author_association":"NONE","issue_field_values":[],"type":null,"active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"### Tested versions\n\nReproducible in: 4.4.1.stable.mono, 4.5.stable.mono\nNot reproducible in: manually modified 4.5; I looked into git blame, the line in the issue was there for a very long time.\n\n### System information\n\nWindows 10 - (exporting for android) - Godot v4.5.stable\n\n### Issue description\n\nXR_EXT_eye_gaze_interaction is not active on Magic Leap 2.\nWith enabled verbose OpenXR and stdout you can see that XR_EXT_eye_gaze_interaction was found in the list of supported system extensions, but not enabled.\nFurther debugging shows that in https://github.com/godotengine/godot/blob/1f7630f1bfd9a7c65a5c144f85be38b4b64e3717/modules/openxr/extensions/openxr_eye_gaze_interaction.cpp#L59\nYou get `xr/openxr/extensions/eye_gaze_interaction` as **true**, `OS::get_singleton()->has_feature(\"mobile\")` as **true** and `OS::get_singleton()->has_feature(XR_EXT_EYE_GAZE_INTERACTION_EXTENSION_NAME)` as **false**. The last one prevents the extension from being requested at all. Commenting out this check enables the extension, and everything works.\nI couldn't find any reference to an OS or a project feature called XR_EXT_eye_gaze_interaction, which leads me to believe that it is not a real feature, or at least not universal.\nThe similar check in this file \nhttps://github.com/godotengine/godot/blob/1f7630f1bfd9a7c65a5c144f85be38b4b64e3717/modules/openxr/extensions/openxr_eye_gaze_interaction.cpp#L93\nchecks the feature \"PERMISSION_XR_EXT_eye_gaze_interaction\" which actually makes sense. Maybe it is supposed to be in above one to.\n\n### Steps to reproduce\n\nTo reproduce: take a magic leap and follow the docs: https://docs.godotengine.org/en/stable/tutorials/xr/openxr_settings.html\n\n\n### Minimal reproduction project (MRP)\n\n[mr-godot-project-template.zip](https://github.com/user-attachments/files/22559921/mr-godot-project-template.zip)\nA minimal project, that initializes openxr and eye tracking.\nThe project requires godot-openxr-vendors plugin to work and Android export templates installed.\nI included the log file in the logcat.log\nThe Cube.cs and EyeGazeDebugger.cs are not strictly necessary for the project to run, but they help to see some more diagnostics.","closed_by":{"login":"m4gr3d","