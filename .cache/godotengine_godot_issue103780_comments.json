i.github.com/users/blackthorncyber/followers","following_url":"https://api.github.com/users/blackthorncyber/following{/other_user}","gists_url":"https://api.github.com/users/blackthorncyber/gists{/gist_id}","starred_url":"https://api.github.com/users/blackthorncyber/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/blackthorncyber/subscriptions","organizations_url":"https://api.github.com/users/blackthorncyber/orgs","repos_url":"https://api.github.com/users/blackthorncyber/repos","events_url":"https://api.github.com/users/blackthorncyber/events{/privacy}","received_events_url":"https://api.github.com/users/blackthorncyber/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-03-11T07:06:26Z","updated_at":"2025-03-11T07:06:26Z","body":"I've also had this same issue occur on my Mac M4 Mini 16GB RAM - Godot 4.4 Stable. Godot works for a while, then menus become randomly unclickable within the editor itself - usually drop down menus in the inspector, as well as pop up dialogues such as the save dialogue.\n\nI have been unable to reliably reproduce.\n\nI have found that keyboard inputs continue to work - eg navigating the save dialogue once the mouse inputs have begun to stop working.","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2712900028/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2728498930","html_url":"https://github.com/godotengine/godot/issues/103780#issuecomment-2728498930","issue_url":"https://api.github.com/repos/godotengine/godot/issues/103780","id":2728498930,"node_id":"IC_kwDOAO6SJc6ioZby","user":{"login":"Pixelmusement","id":78319361,"node_id":"MDQ6VXNlcjc4MzE5MzYx","avatar_url":"https://avatars.githubusercontent.com/u/78319361?v=4","gravatar_id":"","url":"https://api.github.com/users/Pixelmusement","html_url":"https://github.com/Pixelmusement","followers_url":"https://api.github.com/users/Pixelmusement/followers","following_url":"https://api.github.com/users/Pixelmusement/following{/other_user}","gists_url":"https://api.github.com/users/Pixelmusement/gists{/gist_id}","starred_url":"https://api.github.com/users/Pixelmusement/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Pixelmusement/subscriptions","organizations_url":"https://api.github.com/users/Pixelmusement/orgs","repos_url":"https://api.github.com/users/Pixelmusement/repos","events_url":"https://api.github.com/users/Pixelmusement/events{/privacy}","received_events_url":"https://api.github.com/users/Pixelmusement/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-03-17T07:58:19Z","updated_at":"2025-03-17T08:01:57Z","body":"I'm encountering similar issues since upgrading to 4.4 stable, but for me when things go unresponsive they go REALLY unresponsive and I cannot get things to continue working again at all.\n\nIt's also 100% random if/when a freeze will occur. They've happened doing work in VR, they've happened outside of VR, I could be in the middle of some complex task, I could be in the middle of editing project settings, it's even happened once while I was just sitting motionless in the Godot editor, hands off the mouse and keyboard, trying to decide what to do about something, and after about 30 seconds the framerate ticker on the main window suddenly freezes and I check and the whole program is frozen with ZERO input from me.\n\nA freeze can happen within minutes after starting the Godot editor, sometimes it takes a half hour, and sometimes it doesn't happen at all. I can't find any common factor as to what's causing this, other than that this absolutely was not happening in 4.3. I will also note that if it happens while debugging  a running game, the game ALSO freezes, not just the editor.\n\nEDIT: One other thing of note: These freezes appear to be an infinite loop of some sort, as it pegs one of my CPU cores to 100%, continues burning GPU power in the process, and Windows will also automatically put the task into \"Efficiency Mode\" likely to prevent it from locking up anything else.\n\nSystem Specs: Godot v4.4.stable (4c311cbee) - Windows 11 (build 26100) - Vulkan (Forward+) - NVIDIA GeForce GTX 1070 (NVIDIA; 32.0.15.6636) - AMD Ryzen 9 5900X 12-Core Processor (24 threads)","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2728498930/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2745867342","html_url":"https://github.com/godotengine/godot/issues/103780#issuecomment-2745867342","issue_url":"https://api.github.com/repos/godotengine/godot/issues/103780","id":2745867342,"node_id":"IC_kwDOAO6SJc6jqpxO","user":{"login":"SudoThis913","id":62456168,"node_id":"MDQ6VXNlcjYyNDU2MTY4","avatar_url":"https://avatars.githubusercontent.com/u/62456168?v=4","gravatar_id":"","url":"https://api.github.com/users/SudoThis913","html_url":"https://github.com/SudoThis913","followers_url":"https://api.github.com/users/SudoThis913/followers","following_url":"https://api.github.com/users/SudoThis913/following{/other_user}","gists_url":"https://api.github.com/users/SudoThis913/gists{/gist_id}","starred_url":"https://api.github.com/users/SudoThis913/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/SudoThis913/subscriptions","organizations_url":"https://api.github.com/users/SudoThis913/orgs","repos_url":"https://api.github.com/users/SudoThis913/repos","events_url":"https://api.github.com/users/SudoThis913/events{/privacy}","received_events_url":"https://api.github.com/users/SudoThi