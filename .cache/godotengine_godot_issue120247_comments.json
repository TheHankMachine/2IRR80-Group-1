otengine/godot/issues/120247","id":4699666082,"node_id":"IC_kwDOAO6SJc8AAAABGB82og","user":{"login":"PeterDrake","id":889193,"node_id":"MDQ6VXNlcjg4OTE5Mw==","avatar_url":"https://avatars.githubusercontent.com/u/889193?v=4","gravatar_id":"","url":"https://api.github.com/users/PeterDrake","html_url":"https://github.com/PeterDrake","followers_url":"https://api.github.com/users/PeterDrake/followers","following_url":"https://api.github.com/users/PeterDrake/following{/other_user}","gists_url":"https://api.github.com/users/PeterDrake/gists{/gist_id}","starred_url":"https://api.github.com/users/PeterDrake/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/PeterDrake/subscriptions","organizations_url":"https://api.github.com/users/PeterDrake/orgs","repos_url":"https://api.github.com/users/PeterDrake/repos","events_url":"https://api.github.com/users/PeterDrake/events{/privacy}","received_events_url":"https://api.github.com/users/PeterDrake/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-06-13T20:14:40Z","updated_at":"2026-06-13T20:14:40Z","body":"Certainly a screenreader accessing a web page allows the user to navigate between groups and then descend into elements within them. Is there no way to get even that level of control? I'm new to screenreaders, but I find that surprising.","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4699666082/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4710080978","html_url":"https://github.com/godotengine/godot/issues/120247#issuecomment-4710080978","issue_url":"https://api.github.com/repos/godotengine/godot/issues/120247","id":4710080978,"node_id":"IC_kwDOAO6SJc8AAAABGL4h0g","user":{"login":"PeterDrake","id":889193,"node_