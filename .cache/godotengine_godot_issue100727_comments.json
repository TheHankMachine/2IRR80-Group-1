imized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2558526922","html_url":"https://github.com/godotengine/godot/issues/100727#issuecomment-2558526922","issue_url":"https://api.github.com/repos/godotengine/godot/issues/100727","id":2558526922,"node_id":"IC_kwDOAO6SJc6YgAXK","user":{"login":"mdelorme","id":2743366,"node_id":"MDQ6VXNlcjI3NDMzNjY=","avatar_url":"https://avatars.githubusercontent.com/u/2743366?v=4","gravatar_id":"","url":"https://api.github.com/users/mdelorme","html_url":"https://github.com/mdelorme","followers_url":"https://api.github.com/users/mdelorme/followers","following_url":"https://api.github.com/users/mdelorme/following{/other_user}","gists_url":"https://api.github.com/users/mdelorme/gists{/gist_id}","starred_url":"https://api.github.com/users/mdelorme/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/mdelorme/subscriptions","organizations_url":"https://api.github.com/users/mdelorme/orgs","repos_url":"https://api.github.com/users/mdelorme/repos","events_url":"https://api.github.com/users/mdelorme/events{/privacy}","received_events_url":"https://api.github.com/users/mdelorme/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2024-12-22T17:22:39Z","updated_at":"2024-12-22T17:28:39Z","body":"Ok, I think we can solve simply the problem. I'm sorry I made a mistake in my assessment: the root of the scene already exists when we give the title to the project manager initially. So we can give it a title instead of going directly to the `DisplayServer`. I'm testing a few more things and if that works I'll try to push a fix.","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2558526922/reactions","total_count":1,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":1},"performed_via_github_app":null,"minimized":null}]