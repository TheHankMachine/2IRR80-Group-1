_events_url":"https://api.github.com/users/mihe/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-04-25T11:37:50Z","updated_at":"2026-04-25T11:37:50Z","body":"The fix is up: #118948","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4319527977/reactions","total_count":1,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":1,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null}]