s, saying the overload is ambigious. if you do\r\n```\r\nvoid func(const std::vector<int> &v) { ... }\r\nvoid func(std::vector<int>&& v) { ... }\r\n```\r\nthen it correctly resolves to the second overload.\r\n\r\nstd::vector's push_back does the same thing: https://en.cppreference.com/w/cpp/container/vector/push_back.html","created_at":"2025-06-13T12:49:19Z","updated_at":"2025-06-13T12:49:20Z","html_url":"https://github.com/godotengine/godot/pull/106997#discussion_r2145025426","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/106997","_links":{"self":{"href":"https://api.github.com/repos/godotengine/godot/pulls/comments/2145025426"},"html":{"href":"https://github.com/godotengine/godot/pull/106997#discussion_r2145025426"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/106997"}},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/2145025426/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":171,"original_line":171,"side":"RIGHT","in_reply_to_id":2144994125,"author_association":"CONTRIBUTOR","original_position":75,"position":75,"subject_type":"line"},{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/2145029920","pull_request_review_id":2924701588,"id":2145029920,"node_id":"PRRC_kwDOAO6SJc5_2o8g","diff_hunk":"@@ -136,6 +168,12 @@ class FixedVector {\n \t\t_size++;\n \t}\n \n+\tconstexpr void push_back(T &&p_val) {","path":"core/templates/fixed_vector.h","commit_id":"c3476b8205d5246abd7050ad63ce26c09d065262","original_commit_id":"c3476b8205d5246abd7050ad63ce26c09d065262","user":{"login":"AThousandShips","id":96648715,"node_id":"U_kgDOBcK-Cw","avatar_url":"https://avatars.githubusercontent.com/u/96648715?v=4","gravatar_id":"","url":"https://api.github.com/users/AThousandShips","html_url":"https://github.com/AThousandShips","followers_url":"https://