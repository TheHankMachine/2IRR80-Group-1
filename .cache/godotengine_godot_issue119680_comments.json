[{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4811455106","html_url":"https://github.com/godotengine/godot/pull/119680#issuecomment-4811455106","issue_url":"https://api.github.com/repos/godotengine/godot/issues/119680","id":4811455106,"node_id":"IC_kwDOAO6SJc8AAAABHsj6gg","user":{"login":"Pizzaandy","id":47232037,"node_id":"MDQ6VXNlcjQ3MjMyMDM3","avatar_url":"https://avatars.githubusercontent.com/u/47232037?v=4","gravatar_id":"","url":"https://api.github.com/users/Pizzaandy","html_url":"https://github.com/Pizzaandy","followers_url":"https://api.github.com/users/Pizzaandy/followers","following_url":"https://api.github.com/users/Pizzaandy/following{/other_user}","gists_url":"https://api.github.com/users/Pizzaandy/gists{/gist_id}","starred_url":"https://api.github.com/users/Pizzaandy/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Pizzaandy/subscriptions","organizations_url":"https://api.github.com/users/Pizzaandy/orgs","repos_url":"https://api.github.com/users/Pizzaandy/repos","events_url":"https://api.github.com/users/Pizzaandy/events{/privacy}","received_events_url":"https://api.github.com/users/Pizzaandy/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-06-26T16:30:12Z","updated_at":"2026-06-26T16:30:12Z","body":"There was a `p_flip_fov` parameter in `Projection::set_perspective` that I didn't know about. I set it to false to fix the editor shadow artifacts and shadow quality is now equivalent to master. It's probably best to keep `directional_shadow_min_fov` as a vertical FOV since that's the default on cameras.","author_association":"NONE","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4811455106/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4887360968",