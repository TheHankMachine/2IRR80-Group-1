hived_by":null},{"id":410064485,"node_id":"MDU6TGFiZWw0MTAwNjQ0ODU=","url":"https://api.github.com/repos/godotengine/godot/labels/needs%20testing","name":"needs testing","color":"ffcc44","default":false,"description":"","archived_at":null,"archived_by":null}],"state":"open","locked":false,"assignees":[],"milestone":null,"comments":2,"created_at":"2025-04-04T21:58:20Z","updated_at":"2025-04-08T17:36:19Z","closed_at":null,"assignee":null,"author_association":"NONE","issue_field_values":[],"type":null,"active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"### Tested versions\n\nRunning Godot 4.3 stable build with Compatibility render mode. I have encountered the bug using the following configuration\n\n### System information\n\nWindows 10, Godot 4.3 stable (no addons), Android export with gradle custom build, Debug device: Samsung S10 Lite\n\n### Issue description\n\nEncountered a bug where after exactly 3 minutes and 48 seconds after remote debugging over android device, the screen freezes, but the game continues to run (audio player and scripts continue to execute).\nBug was triggered by enabling 'Adjustments' in a WorldEnvironment node, in the main scene, and having compatibility render mode enabled. Length of time for the bug to appear probably varies with each android device. I used a Samsung S10 Lite with the game running at 60FPS. \n\n### Steps to reproduce\n\nUse Godot 4.3\nEnable custom gradle build\nSet render to compatibility\nCreate WorldEnvironment node and enable 'Adjustments'\nEnable remote deploy with debug\nBegin debugging Android device and wait for roughly 200 seconds\n\n\n### Minimal reproduction project (MRP)\n\nN/A","closed_by":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/105031/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket