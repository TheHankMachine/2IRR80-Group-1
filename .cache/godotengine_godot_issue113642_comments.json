s/comments/3712062859","html_url":"https://github.com/godotengine/godot/pull/113642#issuecomment-3712062859","issue_url":"https://api.github.com/repos/godotengine/godot/issues/113642","id":3712062859,"node_id":"IC_kwDOAO6SJc7dQZWL","user":{"login":"kitbdev","id":10054226,"node_id":"MDQ6VXNlcjEwMDU0MjI2","avatar_url":"https://avatars.githubusercontent.com/u/10054226?v=4","gravatar_id":"","url":"https://api.github.com/users/kitbdev","html_url":"https://github.com/kitbdev","followers_url":"https://api.github.com/users/kitbdev/followers","following_url":"https://api.github.com/users/kitbdev/following{/other_user}","gists_url":"https://api.github.com/users/kitbdev/gists{/gist_id}","starred_url":"https://api.github.com/users/kitbdev/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/kitbdev/subscriptions","organizations_url":"https://api.github.com/users/kitbdev/orgs","repos_url":"https://api.github.com/users/kitbdev/repos","events_url":"https://api.github.com/users/kitbdev/events{/privacy}","received_events_url":"https://api.github.com/users/kitbdev/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-01-05T20:58:01Z","updated_at":"2026-01-05T20:58:01Z","body":"The ProgressDialog singleton is never set to null, it just gets deleted.\r\nSo setting it to null in the ProgressDialog destructor together with the `ProgressDialog::get_singleton() != nullptr` check should fix it.\r\n```cpp\r\n~ProgressDialog() {\r\n\tsingleton = nullptr;\r\n}\r\n```\r\n\r\nJust setting it to null makes also it easier to debug, since a debugger will break when it is used without needing the sanitizer.","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3712062859/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3715273005","html_url":"https://github.com/godotengine/godot/pull/113642#issuecomment-3715273005","issue_url":"https://api.github.com/repos/godotengine/godot/issues/113642","id":3715273005,"node_id":"IC_kwDOAO6SJc7dcpEt","user":{"login":"Repiteo","id":17489292,"node_id":"MDQ6VXNlcjE3NDg5Mjky","avatar_url":"https://avatars.githubusercontent.com/u/17489292?v=4","gravatar_id":"","url":"https://api.github.com/users/Repiteo","html_url":"https://github.com/Repiteo","followers_url":"https://api.github.com/users/Repiteo/followers","following_url":"https://api.github.com/users/Repiteo/following{/other_user}","gists_url":"https://api.github.com/users/Repiteo/gists{/gist_id}","starred_url":"https://api.github.com/users/Repiteo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Repiteo/subscriptions","organizations_url":"https://api.github.com/users/Repiteo/orgs","repos_url":"https://api.github.com/users/Repiteo/repos","events_url":"https://api.github.com/users/Repiteo/events{/privacy}","received_events_url":"https://api.github.com/users/Repiteo/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-01-06T16:02:26Z","updated_at":"2026-01-06T16:02:26Z","body":"Thanks!","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3715273005/reactions","total_count":1,"+1":0,"-1":0,"laugh":0,"hooray":1,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null}]