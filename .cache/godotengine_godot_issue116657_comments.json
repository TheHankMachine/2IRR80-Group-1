cked from commit 9c7669d32c075b338d90789e48750c9197ee14e4)\n\n editor/scene/3d/skeleton_3d_editor_plugin.cpp | 58 +++++++++++++++++++++++++++++++++++++++++++++++++++-------\n editor/scene/3d/skeleton_3d_editor_plugin.h   |  2 ++\n 2 files changed, 53 insertions(+), 7 deletions(-)\n```","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3944614184/reactions","total_count":2,"+1":2,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3944628918","html_url":"https://github.com/godotengine/godot/issues/116657#issuecomment-3944628918","issue_url":"https://api.github.com/repos/godotengine/godot/issues/116657","id":3944628918,"node_id":"IC_kwDOAO6SJc7rHkK2","user":{"login":"AThousandShips","id":96648715,"node_id":"U_kgDOBcK-Cw","avatar_url":"https://avatars.githubusercontent.com/u/96648715?v=4","gravatar_id":"","url":"https://api.github.com/users/AThousandShips","html_url":"https://github.com/AThousandShips","followers_url":"https://api.github.com/users/AThousandShips/followers","following_url":"https://api.github.com/users/AThousandShips/following{/other_user}","gists_url":"https://api.github.com/users/AThousandShips/gists{/gist_id}","starred_url":"https://api.github.com/users/AThousandShips/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/AThousandShips/subscriptions","organizations_url":"https://api.github.com/users/AThousandShips/orgs","repos_url":"https://api.github.com/users/AThousandShips/repos","events_url":"https://api.github.com/users/AThousandShips/events{/privacy}","received_events_url":"https://api.github.com/users/AThousandShips/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-02-23T12:54:42Z","updated_at":"2026-02-23T12:55:44Z","body":"Must be interacting with some 4.5 code