s_url":"https://api.github.com/users/Zireael07/followers","following_url":"https://api.github.com/users/Zireael07/following{/other_user}","gists_url":"https://api.github.com/users/Zireael07/gists{/gist_id}","starred_url":"https://api.github.com/users/Zireael07/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Zireael07/subscriptions","organizations_url":"https://api.github.com/users/Zireael07/orgs","repos_url":"https://api.github.com/users/Zireael07/repos","events_url":"https://api.github.com/users/Zireael07/events{/privacy}","received_events_url":"https://api.github.com/users/Zireael07/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-07-21T07:28:13Z","updated_at":"2026-07-21T07:28:13Z","body":"Yes, PRs should be specific to a feature or bugfix. This PR is this feature. Your other bugfix belongs in a separate PR","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5031276386/reactions","total_count":2,"+1":2,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5031304019","html_url":"https://github.com/godotengine/godot/pull/121579#issuecomment-5031304019","issue_url":"https://api.github.com/repos/godotengine/godot/issues/121579","id":5031304019,"node_id":"IC_kwDOAO6SJc8AAAABK-ObUw","user":{"login":"bluebirdsan","id":60063904,"node_id":"MDQ6VXNlcjYwMDYzOTA0","avatar_url":"https://avatars.githubusercontent.com/u/60063904?v=4","gravatar_id":"","url":"https://api.github.com/users/bluebirdsan","html_url":"https://github.com/bluebirdsan","followers_url":"https://api.github.com/users/bluebirdsan/followers","following_url":"https://api.github.com/users/bluebirdsan/following{/other_user}","gists_url":"https://api.github.com/users/bluebirdsan/gists{/gist_id}","starred_url":"https://api.github.com/users/bluebirdsan/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/bluebirdsan/subscriptions","organizations_url":"https://api.github.com/users/bluebirdsan/orgs","repos_url":"https://api.github.com/users/bluebirdsan/repos","events_url":"https://api.github.com/users/bluebirdsan/events{/privacy}","received_events_url":"https://api.github.com/users/bluebirdsan/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-07-21T07:31:48Z","updated_at":"2026-07-21T07:31:48Z","body":"Thanks! I now noticed my question was phrased incorrectly.\n\nI meant to ask: after doing other work, should I create a new PR for this new feature? (The PR is not for the bug fixes but this new feature)","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5031304019/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5038397060","html_url":"https://github.com/godotengine/godot/pull/121579#issuecomment-5038397060","issue_url":"https://api.github.com/repos/godotengine/godot/issues/121579","id":5038397060,"node_id":"IC_kwDOAO6SJc8AAAABLE_WhA","user":{"login":"AThousandShips","id":96648715,"node_id":"U_kgDOBcK-Cw","avatar_url":"https://avatars.githubusercontent.com/u/96648715?v=4","gravatar_id":"","url":"https://api.github.com/users/AThousandShips","html_url":"https://github.com/AThousandShips","followers_url":"https://api.github.com/users/AThousandShips/followers","following_url":"https://api.github.com/users/AThousandShips/following{/other_user}","gists_url":"https://api.github.com/users/AThousandShips/gists{/gist_id}","starred_url":"https://api.github.com/users/AThousandShips/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/AThousandShips/subscriptions","organizations_url":"https://api.github.com/users/AThousandShips/orgs","repos_url":"https://api.github.com/users/AThousandShips/repos","events_url":"https://api.github.com/users/AThousandShips/events{/privacy}","received_events_url":"https://api.github.com/users/AThousandShips/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-07-21T19:51:29Z","updated_at":"2026-07-21T19:51:29Z","body":"I would say the first step would be to wait for proper support to be clear, the proposals this is linked to have nearly no support behind them despite one of them being over two years old, so there's not really much support for this feature in the first place, and features should only be added if there's well known demand for it","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5038397060/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5039378842","html_url":"https://github.com/godotengine/godot/pull/121579#issuecomment-5039378842","issue_url":"https://api.github.com/repos/godotengine/godot/issues/121579","id":5039378842,"node_id":"IC_kwDOAO6SJc8AAAABLF7Rmg","user":{"login":"bluebirdsan","id":60063904,"node_id":"MDQ6VXNlcjYwMDYzOTA0","avatar_url":"https://avatars.githubusercontent.com/u/60063904?v=4","gravatar_id":"","url":"https://api.github.com/users/bluebirdsan","html_url":"https://github.com/bluebirdsan","followers_url":"https://api.github.com/users/bluebirdsan/followers","following_url":"https://api.github.com/users/bluebirdsan/following{/other_user}","gists_url":"https://api.github.com/users/bluebirdsan/gists{/gist_id}","starred_url":"https://api.github.com/users/bluebirdsan/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/bluebirdsan/subscriptions","organizations_url":"https://api.github.com/users/bluebirdsan/orgs","repos_url":"https://api.github.com/users/bluebirdsan/repos","events_url":"https://api.github.com/users/bluebirdsan/events{/privacy}","received_events_url":"https://api.github.com/users/bluebirdsan/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-07-21T21:48:19Z","updated_at":"2026-07-21T21:48:19Z","body":"But is it possible there's no demand because people search the online docs and when they read the [internalization docs](https://docs.godotengine.org/en/stable/tutorials/i18n/index.html), especially the [PO files part](https://docs.godotengine.org/en/stable/tutorials/i18n/localization_using_gettext.html), they can't find any mention on how to have exported variables that are also translated?\r\n\r\nI mean sure, there is some mention about this:\r\n\r\n<img width=\"823\" height=\"290\" alt=\"image\" src=\"https://github.com/user-attachments/assets/ab4bfc33-2a2f-4d87-8e3a-78e9ed2071ae\" />\r\n\r\nBut if you want to have exported strings that are on a `LineEdit` node, then you can't use those names, because they are already used by the class.\r\nAnd the workaround, mentioned in the proposal, of appending string names with `_text` is not documented plus it works only in the `PackedScene` parser. (I also feel strongly against forcing users to use a certain naming convention, especially if you code in a different human language, where `_text` would be out of place, but annotating would eliminate this problem.)\r\n\r\nAlso, subresources in `PackedScene` are not parsed currently, so you must create a resource first, then add it to the template generation list, then drag it to the exported variable, instead of just creating the resource on the exported variable (without saving it as a file). And if you have to do this lots of times, then the time saved by not having to do that would, at least in my mind, be worth it.\r\n\r\n\r\nI hope I'm not overstepping any boundaries and sorry if I sound angry, I'm not. I'm just passionate about this, because I want to make a game that I'd want to translate, but without this feature it would be a hassle to do translations. For example when creating a dialog system, if I had to save every DialogLine resource as a file first, instead of creating one in the exported variable, I'd have to select a bunch of files in the template generator file list AND there would be lots of small files in the directory, where a few larger Dialog resource files would be much better. And if I needed to change a line, I could open the Dialog resource and see all the lines, which would show the context of the lines around the one I want to edit.\r\n\r\nI'm not sure if it would be possible to create this annotation feature as a plugin, because it implements a new `PROPERTY_USAGE_*`, but if it is I would happily create it and use it in my projects.\r\n\r\nSorry for the long message, but it feels nice to talk with someone about coding :) . (I code alone, so the best I can do is talk to myself when developing the game... :/ )","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5039378842/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5043669040","html_url":"https://github.com/godotengine/godot/pull/121579#issuecomment-5043669040","issue_url":"https://api.github.com/repos/godotengine/godot/issues/121579","id":5043669040,"node_id":"IC_kwDOAO6SJc8AAAABLKBIMA","user":{"login":"AThousandShips","id":96648715,"node_id":"U_kgDOBcK-Cw","avatar_url":"https://avatars.githubusercontent.com/u/96648715?v=4","gravatar_id":"","url":"https://api.github.com/users/AThousandShips","html_url":"https://github.com/AThousandShips","followers_url":"https://api.github.com/users/AThousandShips/followers","following_url":"https://api.github.com/users/AThousandShips/following{/other_user}","gists_url":"https://api.github.com/users/AThousandShips/gists{/gist_id}","starred_url":"https://api.github.com/users/AThousandShips/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/AThousandShips/subscriptions","organizations_url":"https://api.github.com/users/AThousandShips/orgs","repos_url":"https://api.github.com/users/AThousandShips/repos","events_url":"https://api.github.com/users/AThousandShips/events{/privacy}","received_events_url":"https://api.github.com/users/AThousandShips/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-07-22T08:33:55Z","updated_at":"2026-07-22T08:33:55Z","body":"That still means they don't really find a need for this solution I'd say, and we can't really base decisions on assumed demand that just isn't shown ","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5043669040/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5043725311","html_url":"https://github.com/godotengine/godot/pull/121579#issuecomment-5043725311","issue_url":"https://api.github.com/repos/godotengine/godot/issues/121579","id":5043725311,"node_id":"IC_kwDOAO6SJc8AAAABLKEj_w","user":{"login":"HolonProduction","id":99511741,"node_id":"U_kgDOBe5tvQ","avatar_url":"https://avatars.githubusercontent.com/u/99511741?v=4","gravatar_id":"","url":"https://api.github.com/users/HolonProduction","html_url":"https://github.com/HolonProduction","followers_url":"https://api.github.com/users/HolonProduction/followers","following_url":"https://api.github.com/users/HolonProduction/following{/other_user}","gists_url":"https://api.github.com/users/HolonProduction/gists{/gist_id}","starred_url":"https://api.github.com/users/HolonProduction/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/HolonProduction/subscriptions","organizations_url":"https://api.github.com/users/HolonProduction/orgs","repos_url":"https://api.github.com/users/HolonProduction/repos","events_url":"https://api.github.com/users/HolonProduction/events{/privacy}","received_events_url":"https://api.github.com/users/HolonProduction/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-07-22T08:39:12Z","updated_at":"2026-07-22T08:39:28Z","body":"Worth noting though, that the linked proposal is asking for automatically applying translations to those props, while this PR (from my understanding) only is about making them discoverable from the translation parser. So the proposal doesn't seem to be a 100% fit.","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5043725311/reactions","total_count":2,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":1},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5044548732","html_url":"https://github.com/godotengine/godot/pull/121579#issuecomment-5044548732","issue_url":"https://api.github.com/repos/godotengine/godot/issues/121579","id":5044548732,"node_id":"IC_kwDOAO6SJc8AAAABLK20fA","user":{"login":"bluebirdsan","id":60063904,"node_id":"MDQ6VXNlcjYwMDYzOTA0","avatar_url":"https://avatars.githubusercontent.com/u/60063904?v=4","gravatar_id":"","url":"https://api.github.com/users/bluebirdsan","html_url":"https://github.com/bluebirdsan","followers_url":"https://api.github.com/users/bluebirdsan/followers","following_url":"https://api.github.com/users/bluebirdsan/following{/other_user}","gists_url":"https://api.github.com/users/bluebirdsan/gists{/gist_id}","starred_url":"https://api.github.com/users/bluebirdsan/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/bluebirdsan/subscriptions","organizations_url":"https://api.github.com/users/bluebirdsan/orgs","repos_url":"https://api.github.com/users/bluebirdsan/repos","events_url":"https://api.github.com/users/bluebirdsan/events{/privacy}","received_events_url":"https://api.github.com/users/bluebirdsan/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-07-22T10:08:36Z","updated_at":"2026-07-22T10:08:36Z","body":"I checked to make sure, but in my opinion automatically applying translations to the properties themselves makes this less useful.\r\n\r\nFor example, if you write IDs in those strings (WORD_ORANGE, TEXT_GREETING, etc.), then in code you could compare them if needed and these ID's wouldn't change. But if they would be translated in the property then you couldn't do this. But if needed you could still call `tr(string_id)` and would get the translated string. I think that 90% of the time you will put the string inside a Control node, which get automatically translated anyway.\r\n\r\nShort video showing this https://youtu.be/mQK6TA5mN6Q\r\n\r\nAnd as the video shows, if you'd like to check if the current value is some id, you can just do `string_id == \"WORD_ORANGE\"`, but if it would be translated, then this check wouldn't work at all, because even the English translation would make `string_id` be `\"orange\"` and the check would fail.","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5044548732/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5044897932","html_url":"https://github.com/godotengine/godot/pull/121579#issuecomment-5044897932","issue_url":"https://api.github.com/repos/godotengine/godot/issues/121579","id":5044897932,"node_id":"IC_kwDOAO6SJc8AAAABLLMIjA","user":{"login":"HolonProduction","id":99511741,"node_id":"U_kgDOBe5tvQ","avatar_url":"https://avatars.githubusercontent.com/u/99511741?v=4","gravatar_id":"","url":"https://api.github.com/users/HolonProduction","html_url":"https://github.com/HolonProduction","followers_url":"https://api.github.com/users/HolonProduction/followers","following_url":"https://api.github.com/users/HolonProduction/following{/other_user}","gists_url":"https://api.github.com/users/HolonProduction/gists{/gist_id}","starred_url":"https://api.github.com/users/HolonProduction/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/HolonProduction/subscriptions","organizations_url":"https://api.github.com/users/HolonProduction/orgs","repos_url":"https://api.github.com/users/HolonProduction/repos","events_url":"https://api.github.com/users/HolonProduction/events{/privacy}","received_events_url":"https://api.github.com/users/HolonProduction/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-07-22T10:49:29Z","updated_at":"2026-07-22T10:49:29Z","body":"> I checked to make sure, but in my opinion automatically applying translations to the properties themselves makes this less useful.\r\n\r\nI tend to agree. My point was more: Judging support for the PR based on the proposal might be a bit misleading.","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5044897932/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5044906860","html_url":"https://github.com/godotengine/godot/pull/121579#issuecomment-5044906860","issue_url":"https://api.github.com/repos/godotengine/godot/issues/121579","id":5044906860,"node_id":"IC_kwDOAO6SJc8AAAABLLMrbA","user":{"login":"AThousandShips","id":96648715,"node_id":"U_kgDOBcK-Cw","avatar_url":"https://avatars.githubusercontent.com/u/96648715?v=4","gravatar_id":"","url":"https://api.github.com/users/AThousandShips","html_url":"https://github.com/AThousandShips","followers_url":"https://api.github.com/users/AThousandShips/followers","following_url":"https://api.github.com/users/AThousandShips/following{/other_user}","gists_url":"https://api.github.com/users/AThousandShips/gists{/gist_id}","starred_url":"https://api.github.com/users/AThousandShips/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/AThousandShips/subscriptions","organizations_url":"https://api.github.com/users/AThousandShips/orgs","repos_url":"https://api.github.com/users/AThousandShips/repos","events_url":"https://api.github.com/users/AThousandShips/events{/privacy}","received_events_url":"https://api.github.com/users/AThousandShips/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-07-22T10:50:32Z","updated_at":"2026-07-22T10:50:32Z","body":"If there isn't a fitting proposal then one should be made","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5044906860/reactions","total_count":1,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":1,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null}]