i.github.com/users/lyuma/orgs","repos_url":"https://api.github.com/users/lyuma/repos","events_url":"https://api.github.com/users/lyuma/events{/privacy}","received_events_url":"https://api.github.com/users/lyuma/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"Which number to hardcode isn't exactly my concern. The concern is this is technically as much a compatibility breakage for FBX as it is for GLTF, and the correct thing to do would be to add a FBX Compatibility import setting similar to the gLTF one.\r\n\r\nSpeaking of which, is there a risk that the .blend importer also has a similar issue, since it is also not a gltf file, but needs the compatibility option?","created_at":"2025-06-10T06:19:36Z","updated_at":"2025-06-10T06:19:36Z","html_url":"https://github.com/godotengine/godot/pull/106537#discussion_r2137004835","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/106537","_links":{"self":{"href":"https://api.github.com/repos/godotengine/godot/pulls/comments/2137004835"},"html":{"href":"https://github.com/godotengine/godot/pull/106537#discussion_r2137004835"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/106537"}},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/2137004835/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":null,"original_line":2224,"side":"RIGHT","in_reply_to_id":2136938761,"author_association":"CONTRIBUTOR","original_position":5,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/2137011257","pull_request_review_id":2912111558,"id":2137011257,"node_id":"PRRC_kwDOAO6SJc5_YDQ5","diff_hunk":"@@ -2221,7 +2221,7 @@ Error FBXDocument::_parse_fbx_state(Ref<FBXState> p_state, const String &p_searc\n \tERR_FAIL_COND_V(err != OK, ERR_PARSE_ERROR);\n \n \t/* CREATE SKELETONS */\n-\terr = SkinTool::_create_skeletons(p_state->unique_names, p_state->skins, p_state->nodes, p_state->skeleton3d_to_fbx_skeleton, p_state->skeletons, p_state->scene_nodes);\n+\terr = SkinTool::_create_skeletons(p_state->unique_names, p_state->skins, p_state->nodes, p_state->skeleton3d_to_fbx_skeleton, p_state->skeletons, p_state->scene_nodes, 2);","path":"modules/fbx/fbx_document.cpp","commit_id":"8350919575c02ade9efa9efbcbb7bad03d9af09e","original_commit_id":"832ce66df89f1ba7af659d3f2b004faa491af2bd","user":{"login":"aaronfranke","id":1646875,"node_id":"MDQ6VXNlcjE2NDY4NzU=","avatar_url":"https://avatars.githubusercontent.com/u/1646875?v=4","gravatar_id":"","url":"https://api.github.com/users/aaronfranke","html_url":"https://github.com/aaronfranke","followers_url":"https://api.github.com/users/aaronfranke/followers","following_url":"https://api.github.com/users/aaronfranke/following{/other_user}","gists_url":"https://api.github.com/users/aaronfranke/gists{/gist_id}","starred_url":"https://api.github.com/users/aaronfranke/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/aaronfranke/subscriptions","organizations_url":"https://api.github.com/users/aaronfranke/orgs","repos_url":"https://api.github.com/users/aaronfranke/repos","events_url":"https://api.github.com/users/aaronfranke/events{/privacy}","received_events_url":"https://api.github.com/users/aaronfranke/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"We don't expose the glTF naming version in the `.blend` file import options, so users directly importing `.blend` files always have the latest glTF naming version setting.\r\n\r\nRecent fixes like PR #104184 and PR #103332 have the goal of improving compatibility with Blender, so I'm not sure that users would ever want to use older naming versions, it would just mean that the node tree in Godot would be different from the node tree in Blender.","created_at":"2025-06-10T06:24:13Z","updated_at":"2025-06-10T06:27:43Z","html_url":"https://github.com/godotengine/godot/pull/106537#discussion_r2137011257","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/106537","_links":{"self":{"href":"https://api.github.com/repos/godotengine/godot/pulls/comments/2137011257"},"html":{"href":"https://github.com/godotengine/godot/pull/106537#discussion_r2137011257"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/106537"}},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/2137011257/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":null,"original_line":2224,"side":"RIGHT","in_reply_to_id":2136938761,"author_association":"MEMBER","original_position":5,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/2137032987","pull_request_review_id":2912147118,"id":2137032987,"node_id":"PRRC_kwDOAO6SJc5_YIkb","diff_hunk":"@@ -2221,7 +2221,7 @@ Error FBXDocument::_parse_fbx_state(Ref<FBXState> p_state, const String &p_searc\n \tERR_FAIL_COND_V(err != OK, ERR_PARSE_ERROR);\n \n \t/* CREATE SKELETONS */\n-\terr = SkinTool::_create_skeletons(p_state->unique_names, p_state->skins, p_state->nodes, p_state->skeleton3d_to_fbx_skeleton, p_state->skeletons, p_state->scene_nodes);\n+\terr = SkinTool::_create_skeletons(p_state->unique_names, p_state->skins, p_state->nodes, p_state->skeleton3d_to_fbx_skeleton, p_state->skeletons, p_state->scene_nodes, 2);","path":"modules/fbx/fbx_document.cpp","commit_id":"8350919575c02ade9efa9efbcbb7bad03d9af09e","original_commit_id":"832ce66df89f1ba7af659d3f2b004faa491af2bd","user":{"login":"lyuma","id":39946030,"node_id":"MDQ6VXNlcjM5OTQ2MDMw","avatar_url":"https://avatars.githubusercontent.com/u/39946030?v=4","gravatar_id":"","url":"https://api.github.com/users/lyuma","html_url":"https://github.com/lyuma","followers_url":"https://api.github.com/users/lyuma/followers","following_url":"https://api.github.com/users/lyuma/following{/other_user}","gists_url":"https://api.github.com/users/lyuma/gists{/gist_id}","starred_url":"https://api.github.com/users/lyuma/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/lyuma/subscriptions","organizations_url":"https://api.github.com/users/lyuma/orgs","repos_url":"https://api.github.com/users/lyuma/repos","events_url":"https://api.github.com/users/lyuma/events{/privacy}","received_events_url":"https://api.github.com/users/lyuma/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"The issue isn't that users *want* the old naming scheme. I don't think anyone would choose the old system by choice... that's the same for gltf, blend or fbx. The issue is that existing projects might have already imported files and users might have extended those scenes or somehow reference data from them in their projects.\r\n\r\nFor any such users, upon upgrade to 4.5, all of their existing node paths will break, and inherited scenes might just lose data when the referenced nodepaths no longer exist. These users might prefer to keep their projects functional rather than to have the latest bugfixes for node naming. That is why we have the naming compatibility, and that's why it is just as important for FBX and Blend as it is for glTF.","created_at":"2025-06-10T06:37:51Z","updated_at":"2025-06-10T06:37:51Z","html_url":"https://github.com/godotengine/godot/pull/106537#discussion_r2137032987","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/106537","_links":{"self":{"href":"https://api.github.com/repos/godotengine/godot/pulls/comments/2137032987"},"html":{"href":"https://github.com/godotengine/godot/pull/106537#discussion_r2137032987"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/106537"}},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/2137032987/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":null,"original_line":2224,"side":"RIGHT","in_reply_to_id":2136938761,"author_association":"CONTRIBUTOR","original_position":5,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/2137227685","pull_request_review_id":2912473970,"id":2137227685,"node_id":"PRRC_kwDOAO6SJc5_Y4Gl","diff_hunk":"@@ -2221,7 +2221,7 @@ Error FBXDocument::_parse_fbx_state(Ref<FBXState> p_state, const String &p_searc\n \tERR_FAIL_COND_V(err != OK, ERR_PARSE_ERROR);\n \n \t/* CREATE SKELETONS */\n-\terr = SkinTool::_create_skeletons(p_state->unique_names, p_state->skins, p_state->nodes, p_state->skeleton3d_to_fbx_skeleton, p_state->skeletons, p_state->scene_nodes);\n+\terr = SkinTool::_create_skeletons(p_state->unique_names, p_state->skins, p_state->nodes, p_state->skeleton3d_to_fbx_skeleton, p_state->skeletons, p_state->scene_nodes, 2);","path":"modules/fbx/fbx_document.cpp","commit_id":"8350919575c02ade9efa9efbcbb7bad03d9af09e","original_commit_id":"832ce66df89f1ba7af659d3f2b004faa491af2bd","user":{"login":"aaronfranke","id":1646875,"node_id":"MDQ6VXNlcjE2NDY4NzU=","avatar_url":"https://avatars.githubusercontent.com/u/1646875?v=4","gravatar_id":"","url":"https://api.github.com/users/aaronfranke","html_url":"https://github.com/aaronfranke","followers_url":"https://api.github.com/users/aaronfranke/followers","following_url":"https://api.github.com/users/aaronfranke/following{/other_user}","gists_url":"https://api.github.com/users/aaronfranke/gists{/gist_id}","starred_url":"https://api.github.com/users/aaronfranke/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/aaronfranke/subscriptions","organizations_url":"https://api.github.com/users/aaronfranke/orgs","repos_url":"https://api.github.com/users/aaronfran