ved_at":null,"archived_by":null}],"state":"closed","locked":false,"assignees":[],"milestone":{"url":"https://api.github.com/repos/godotengine/godot/milestones/23","html_url":"https://github.com/godotengine/godot/milestone/23","labels_url":"https://api.github.com/repos/godotengine/godot/milestones/23/labels","id":12939969,"node_id":"MI_kwDOAO6SJc4AxXLB","number":23,"title":"4.6","description":"","creator":{"login":"Repiteo","id":17489292,"node_id":"MDQ6VXNlcjE3NDg5Mjky","avatar_url":"https://avatars.githubusercontent.com/u/17489292?v=4","gravatar_id":"","url":"https://api.github.com/users/Repiteo","html_url":"https://github.com/Repiteo","followers_url":"https://api.github.com/users/Repiteo/followers","following_url":"https://api.github.com/users/Repiteo/following{/other_user}","gists_url":"https://api.github.com/users/Repiteo/gists{/gist_id}","starred_url":"https://api.github.com/users/Repiteo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Repiteo/subscriptions","organizations_url":"https://api.github.com/users/Repiteo/orgs","repos_url":"https://api.github.com/users/Repiteo/repos","events_url":"https://api.github.com/users/Repiteo/events{/privacy}","received_events_url":"https://api.github.com/users/Repiteo/received_events","type":"User","user_view_type":"public","site_admin":false},"open_issues":3,"closed_issues":2978,"state":"closed","created_at":"2025-05-22T16:25:52Z","updated_at":"2026-10-04T16:23:23Z","due_on":null,"closed_at":"2026-01-26T18:09:14Z"},"comments":6,"created_at":"2025-07-21T16:05:02Z","updated_at":"2025-10-11T01:48:06Z","closed_at":"2025-10-10T15:37:55Z","assignee":null,"author_association":"MEMBER","issue_field_values":[],"type":null,"active_lock_reason":null,"draft":false,"pull_request":{"url":"https://api.github.com/repos/godotengine/godot/pulls/108837","html_url":"https://github.com/godotengine/godot/pull/108837","diff_url":"https://github.com/godotengine/godot/pull/108837.diff","patch_url":"https://github.com/godotengine/godot/pull/108837.patch","merged_at":"2025-10-10T15:37:54Z"},"body":"Fixes #89777\r\n\r\nThe JSON specification does not support NaN or Infinity values. However, it does support scientific notation. https://www.json.org/json-en.html\r\n\r\nWithout this PR, trying to export JSON containing NaN or Infinity will result in invalid JSON, which cannot be parsed back by Godot, nor can it be parsed by web browsers.\r\n\r\nWith this PR, trying to export JSON containing NaN and Infinity will result in valid JSON, with Infinity being replaced with extremely large numbers, and NaN being replaced with null. These large values are read in as Infinity both by Godot and by web browsers, and this seems to be a common trick in the JSON ecosystem. See https://github.com/graphite-project/graphite-web/issues/813\r\n\r\nThe unit tests added in this PR include examples of round-trip parsing, and the same tests fail without the other changes.\r\n\r\nWhy `1e99999`: This is greater than the maximum value of an IEEE-standard 256-bit octuple-precision float, which is a bit over `1e78913`, pretty much guaranteeing an overflow to infinity since it will happen for all IEEE-standard floating point sizes. Also, just as a general note, this number is big enough that human readers should be able to tell that this is not intended to be a finite float value.","closed_by":{"login":"Repiteo","id":17489292,"node_id":"MDQ6VXNlcjE3NDg5Mjky","avatar_url":"https://avatars.githubusercontent.com/u/17489292?v=4","gravatar_id":"","url":"https://api.github.com/users/Repiteo","html_url":"https://github.com/Repiteo","followers_url":"https://api.github.com/users/Repiteo/followers","following_url":"https://api.github.com/users/Repiteo/following{/other_user}","gists_url":"https://api.github.com/users/Repiteo/gists{/gist_id}","starred_url":"https://api.github.com/users/Repiteo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Repiteo/subscriptions","organizations_url":"https://api.github.com/users/Repiteo/orgs","repos_url":"https://api.github.com/users/Repiteo/repos","events_url":"https://api.github.com/users/Repiteo/events{/privacy}","received_events_url":"https://api.github.com/users/Repiteo/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/108837/reactions","total_count":9,"+1":7,"-1":0,"laugh":0,"hooray":0,"confused":2,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/godotengine/godot/issues/108837/timeline","performed_via_github_app":null,"state_reason":null}