d/followers","following_url":"https://api.github.com/users/m4gr3d/following{/other_user}","gists_url":"https://api.github.com/users/m4gr3d/gists{/gist_id}","starred_url":"https://api.github.com/users/m4gr3d/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/m4gr3d/subscriptions","organizations_url":"https://api.github.com/users/m4gr3d/orgs","repos_url":"https://api.github.com/users/m4gr3d/repos","events_url":"https://api.github.com/users/m4gr3d/events{/privacy}","received_events_url":"https://api.github.com/users/m4gr3d/received_events","type":"User","user_view_type":"public","site_admin":false},"author_association":"CONTRIBUTOR","issue_field_values":[],"type":null,"active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"### Tested versions\n\n- Reproducible in Godot 4.5 Mono beta7 Linux build\n- Reproducible in Godot 4.5 Mono beta7 MacOs build\n\n### System information\n\nAndroid 16\n\n### Issue description\n\n[Starting November 1st, 2025, all new apps and app updates that use native C/C++ code targeting Android 15+ devices submitted to Google Play must support 16 KB page sizes.](https://android-developers.googleblog.com/2025/07/transition-to-16-kb-page-sizes-android-apps-games-android-studio.html#:~:text=Starting%20November%201st%2C%202025%2C%20all,on%20the%20latest%20Android%20hardware.)\n\nThe update was done for non-dotnet export templates and we assumed that'd be sufficient to also cover dotnet export templates. \nHowever by default dotnet Godot projects use `net8.0` but support for 16kb page size was only added to `net9.0`. \nAs a result, gradle builds using the default `net8.0` end up with their dotnet native libraries not being 16kb page aligned.\n\n<img width=\"1038\" height=\"556\" alt=\"Image\" src=\"https://github.com/user-attachments/assets/1eecffbb-aede-4307-b536-f2d509beb716\" />\n\n### Steps to reproduce\n\n- Download Godot Mono 4.5 beta 7\n- Create a new dotnet project, and attach a C# script\n- Download the export templates, and install the android build template\n- Create the Android export option and enable `Gradle build`\n- Export an Android build\n- Analyse the generated build using [Android Studio APK Analyser](https://developer.android.com/studio/debug/apk-analyzer)\n\n### Minimal reproduction project (MRP)\n\nNew dotnet project","closed_by":{"login":"Repiteo","id":17489292,"node_id":"MDQ6VXNlcjE3NDg5Mjky","avatar_url":"https://avatars.githubusercontent.com/u/17489292?v=4","gravatar_id":"","url":"https://api.github.com/users/Repiteo","html_url":"https://github.com/Repiteo","followers_url":"https://api.github.com/users/Repiteo/followers","following_url":"https://api.github.com/users/Repiteo/following{/other_user}","gists_url":"https://api.github.com/users/Repiteo/gists{/gist_id}","starred_url":"https://api.github.com/users/Repiteo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Repiteo/subscriptions","organizations_url":"https://api.github.com/users/Repiteo/orgs","repos_url":"https://api.github.com/users/Repiteo/repos","events_url":"https://api.github.com/users/Repiteo/events{/privacy}","received_events_url":"https://api.github.com/users/Repiteo/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/110262/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/godotengine/godot/issues/110262/timeline","performed_via_github_app":null,"state_reason":"completed","pinned_comment":null}