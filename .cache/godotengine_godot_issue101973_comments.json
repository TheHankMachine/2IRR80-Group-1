[{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2611561777","html_url":"https://github.com/godotengine/godot/pull/101973#issuecomment-2611561777","issue_url":"https://api.github.com/repos/godotengine/godot/issues/101973","id":2611561777,"node_id":"IC_kwDOAO6SJc6bqUUx","user":{"login":"michaelharmonart","id":15620900,"node_id":"MDQ6VXNlcjE1NjIwOTAw","avatar_url":"https://avatars.githubusercontent.com/u/15620900?v=4","gravatar_id":"","url":"https://api.github.com/users/michaelharmonart","html_url":"https://github.com/michaelharmonart","followers_url":"https://api.github.com/users/michaelharmonart/followers","following_url":"https://api.github.com/users/michaelharmonart/following{/other_user}","gists_url":"https://api.github.com/users/michaelharmonart/gists{/gist_id}","starred_url":"https://api.github.com/users/michaelharmonart/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/michaelharmonart/subscriptions","organizations_url":"https://api.github.com/users/michaelharmonart/orgs","repos_url":"https://api.github.com/users/michaelharmonart/repos","events_url":"https://api.github.com/users/michaelharmonart/events{/privacy}","received_events_url":"https://api.github.com/users/michaelharmonart/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-01-24T04:38:28Z","updated_at":"2025-01-24T04:40:32Z","body":"love to see performance optimizations like this coming down the pipe! \r\n\r\nthey might not be as flashy, but those of us developing for tight performance targets like standalone VR really appreciate it!\r\n\r\n(I remember profiling some scenes a while back in renderdoc and thinking the procedural sky render was taking oddly long for what I assumed it needed to actually do, so this is great news)","author_association":"NONE","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2611561777/reactions","total_count":8,"+1":8,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2814196445","html_url":"https://github.com/godotengine/godot/pull/101973#issuecomment-2814196445","issue_url":"https://api.github.com/repos/godotengine/godot/issues/101973","id":2814196445,"node_id":"IC_kwDOAO6SJc6nvTrd","user":{"login":"clayjohn","id":16521339,"node_id":"MDQ6VXNlcjE2NTIxMzM5","avatar_url":"https://avatars.githubusercontent.com/u/16521339?v=4","gravatar_id":"","url":"https://api.github.com/users/clayjohn","html_url":"https://github.com/clayjohn","followers_url":"https://api.github.com/users/clayjohn/followers","following_url":"https://api.github.com/users/clayjohn/following{/other_user}","gists_url":"https://api.github.com/users/clayjohn/gists{/gist_id}","starred_url":"https://api.github.com/users/clayjohn/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/clayjohn/subscriptions","organizations_url":"https://api.github.com/users/clayjohn/orgs","repos_url":"https://api.github.com/users/clayjohn/repos","events_url":"https://api.github.com/users/clayjohn/events{/privacy}","received_events_url":"https://api.github.com/users/clayjohn/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-04-17T23:26:58Z","updated_at":"2025-04-17T23:26:58Z","body":"> Tested locally on Linux + NVIDIA, I noticed sky cover textures no longer appear to be seamless (even when the source texture is seamless):\r\n\r\nThanks for testing, I pushed up a quick change to the calculation of panorama coords last night that must have done this. I'll fix it quick. \r\n\r\nAs for the sun rendering, the falloff curve for the glow is a little bit different since we are no longer using acos. The visual change is, IMO, acceptable for doubling the performance of the shader\r\n","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2814196445/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2814612554","html_url":"https://github.com/godotengine/godot/pull/101973#issuecomment-2814612554","issue_url":"https://api.github.com/repos/godotengine/godot/issues/101973","id":2814612554,"node_id":"IC_kwDOAO6SJc6nw5RK","user":{"login":"clayjohn","id":16521339,"node_id":"MDQ6VXNlcjE2NTIxMzM5","avatar_url":"https://avatars.githubusercontent.com/u/16521339?v=4","gravatar_id":"","url":"https://api.github.com/users/clayjohn","html_url":"https://github.com/clayjohn","followers_url":"https://api.github.com/users/clayjohn/followers","following_url":"https://api.github.com/users/clayjohn/following{/other_user}","gists_url":"https://api.github.com/users/clayjohn/gists{/gist_id}","starred_url":"https://api.github.com/users/clayjohn/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/clayjohn/subscriptions","organizations_url":"https://api.github.com/users/clayjohn/orgs","repos_url":"https://api.github.com/users/clayjohn/repos","events_url":"https://api.github.com/users/clayjohn/events{/privacy}","received_events_url":"https://api.github.com/users/clayjohn/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-04-18T05:58:06Z","updated_at":"2025-04-18T05:58:06Z","body":"I've made the suggested changes and optimized all three materials now! This PR should be ready for review/merging. \r\n\r\nPlease note, there is a slight change in the appearance of ProceduralSkyMaterials (as you can see in Calinou's screenshots). The penumbra around the sun has a different falloff due to the switch from angle space to cosine space. I include an approximation so the falloff at default settings is very close. But at larger sun sizes / angles the curve gets further from the original. I think this is a fine tradeoff given the huge improvement to performance","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2814612554/reactions","total_count":1,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":1,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2822699509","html_url":"https://github.com/godotengine/godot/pull/101973#issuecomment-2822699509","issue_url":"https://api.github.com/repos/godotengine/godot/issues/101973","id":2822699509,"node_id":"IC_kwDOAO6SJc6oPvn1","user":{"login":"Repiteo","id":17489292,"node_id":"MDQ6VXNlcjE3NDg5Mjky","avatar_url":"https://avatars.githubusercontent.com/u/17489292?v=4","gravatar_id":"","url":"https://api.github.com/users/Repiteo","html_url":"https://github.com/Repiteo","followers_url":"https://api.github.com/users/Repiteo/followers","following_url":"https://api.github.com/users/Repiteo/following{/other_user}","gists_url":"https://api.github.com/users/Repiteo/gists{/gist_id}","starred_url":"https://api.github.com/users/Repiteo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Repiteo/subscriptions","organizations_url":"https://api.github.com/users/Repiteo/orgs","repos_url":"https://api.github.com/users/Repiteo/repos","events_url":"https://api.github.com/users/Repiteo/events{/privacy}","received_events_url":"https://api.github.com/users/Repiteo/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-04-22T23:28:53Z","updated_at":"2025-04-22T23:28:53Z","body":"Thanks!","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2822699509/reactions","total_count":2,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":2,"eyes":0},"performed_via_github_app":null,"minimized":null}]