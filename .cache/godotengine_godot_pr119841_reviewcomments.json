l/119841#discussion_r3317550024","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/119841","_links":{"self":{"href":"https://api.github.com/repos/godotengine/godot/pulls/comments/3317550024"},"html":{"href":"https://github.com/godotengine/godot/pull/119841#discussion_r3317550024"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/119841"}},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/3317550024/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":null,"original_line":4280,"side":"RIGHT","in_reply_to_id":3316741415,"author_association":"CONTRIBUTOR","original_position":5,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/3317572920","pull_request_review_id":4380703625,"id":3317572920,"node_id":"PRRC_kwDOAO6SJc7FviU4","diff_hunk":"@@ -4276,6 +4276,13 @@ void RichTextLabel::add_text(const String &p_text) {\n \n \t\tpos = end + 1;\n \t}\n+\n+\tif (!parsing_bbcode.load()) {","path":"scene/gui/rich_text_label.cpp","commit_id":"149a34a86bd8e2d4c3532a31916603604f48badf","original_commit_id":"8bb39ce41ef2a316cce79737ca7891f1ead385c1","user":{"login":"mgiuca","id":228433,"node_id":"MDQ6VXNlcjIyODQzMw==","avatar_url":"https://avatars.githubusercontent.com/u/228433?v=4","gravatar_id":"","url":"https://api.github.com/users/mgiuca","html_url":"https://github.com/mgiuca","followers_url":"https://api.github.com/users/mgiuca/followers","following_url":"https://api.github.com/users/mgiuca/following{/other_user}","gists_url":"https://api.github.com/users/mgiuca/gists{/gist_id}","starred_url":"https://api.github.com/users/mgiuca/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/mgiuca/subscriptions","organizations_url":"https://api.github.com/users/mgiuca/orgs","repos_url":"https://api.github.com/users/mgiuca/repos","events_url":"https://api.github.com/users/mgiuca/events{/privacy}","received_events_url":"https://api.github.com/users/mgiuca/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"Self-review: I realized after some thought that the previous version ([`fd064b5b`](https://github.com/godotengine/godot/compare/fd064b5b6308ef8354203eccbca40decf61b762b..8bb39ce41ef2a316cce79737ca7891f1ead385c1)) was creating quadratic behaviour if you set a bbcode with lots of tags while `visible_characters` was not -1. (It would call `add_text` for every piece of text inside the bbcode, which would then call `get_total_character_count`, which is linear in the number of items, hence O(N^2)).\n\nTo fix that, there are now two different paths to recalculating:\n\n- If bbcode is disabled, it calls `_recalculate_visible_ratio` here in `add_text`.\n- If bbcode is enabled, it does not call it here. Instead, it calls it at the end of `append_text`.\n\nAdded a test making sure it still works if bbcode is enabled.","created_at":"2026-05-28T11:56:20Z","updated_at":"2026-05-28T11:56:32Z","html_url":"https://github.com/godotengine/godot/pull/119841#discussion_r3317572920","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/119841","_links":{"self":{"href":"https://api.github.com/repos/godotengine/godot/pulls/comments/3317572920"},"html":{"href":"https://github.com/godotengine/godot/pull/119841#discussion_r3317572920"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/119841"}},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/3317572920/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":4334,"original_line":4280,"side":"RIGHT","author_association":"CONTRIBUTOR","original_position":5,"position":5,"subject_type":"line"}]