23172?v=4","gravatar_id":"","url":"https://api.github.com/users/KoBeWi","html_url":"https://github.com/KoBeWi","followers_url":"https://api.github.com/users/KoBeWi/followers","following_url":"https://api.github.com/users/KoBeWi/following{/other_user}","gists_url":"https://api.github.com/users/KoBeWi/gists{/gist_id}","starred_url":"https://api.github.com/users/KoBeWi/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/KoBeWi/subscriptions","organizations_url":"https://api.github.com/users/KoBeWi/orgs","repos_url":"https://api.github.com/users/KoBeWi/repos","events_url":"https://api.github.com/users/KoBeWi/events{/privacy}","received_events_url":"https://api.github.com/users/KoBeWi/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-06-24T08:03:28Z","updated_at":"2025-06-24T08:03:28Z","body":"Documentation needs update.","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2999250838/reactions","total_count":2,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":1,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3001110943","html_url":"https://github.com/godotengine/godot/pull/107920#issuecomment-3001110943","issue_url":"https://api.github.com/repos/godotengine/godot/issues/107920","id":3001110943,"node_id":"IC_kwDOAO6SJc6y4VGf","user":{"login":"jeronimo-schreyer","id":29764541,"node_id":"MDQ6VXNlcjI5NzY0NTQx","avatar_url":"https://avatars.githubusercontent.com/u/29764541?v=4","gravatar_id":"","url":"https://api.github.com/users/jeronimo-schreyer","html_url":"https://github.com/jeronimo-schreyer","followers_url":"https://api.github.com/users/jeronimo-schreyer/followers","following_url":"https://api.github.com/users/jeronimo-schreyer/following{/other_user}","gists_url":"https://api.github.com/users/jeronimo-schreyer/gists{/gist_id}","starred_url":"https://api.github.com/users/jeronimo-schreyer/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/jeronimo-schreyer/subscriptions","organizations_url":"https://api.github.com/users/jeronimo-schreyer/orgs","repos_url":"https://api.github.com/users/jeronimo-schreyer/repos","events_url":"https://api.github.com/users/jeronimo-schreyer/events{/privacy}","received_events_url":"https://api.github.com/users/jeronimo-schreyer/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-06-24T16:16:44Z","updated_at":"2025-06-24T16:18:57Z","body":"> Also, why does it only change the value if the new value is larger instead of just different than the current time_left?\r\n\r\nThis change aims to keep the node state as clean and consistent as possible. Setting a `time_left` larger than `wait_time` will make the current cycle longer than the rest. I think this also works consistently with a timer functionality, where, if you reduce the wait_time, eventually, you'll expect to hit 0 faster than another regular timer, and trigger the timeout signal. And if you make `time_left` grow eventually you'll hit `wait_time`, limiting it.\r\nIn the case you _want_ to have one cycle bigger than the rest, then you would need to make it explicit, changing `wait_time` and then back. I think this corner case makes little sense and somewhat confusing","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3001110943/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3001204718","html_url":"https://github.com/godotengine/godot/pull/107920#issuecomment-3001204718","issue_url":"https://api.github.com/repos/godotengine/godot/issues/107920","id":3001204718,"node_id":"IC_kwDOAO6SJc6y4r_u","user":{"login":"jeronimo-s