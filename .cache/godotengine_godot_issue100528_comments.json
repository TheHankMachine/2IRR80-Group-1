[{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2549480363","html_url":"https://github.com/godotengine/godot/pull/100528#issuecomment-2549480363","issue_url":"https://api.github.com/repos/godotengine/godot/issues/100528","id":2549480363,"node_id":"IC_kwDOAO6SJc6X9fur","user":{"login":"adamscott","id":270928,"node_id":"MDQ6VXNlcjI3MDkyOA==","avatar_url":"https://avatars.githubusercontent.com/u/270928?v=4","gravatar_id":"","url":"https://api.github.com/users/adamscott","html_url":"https://github.com/adamscott","followers_url":"https://api.github.com/users/adamscott/followers","following_url":"https://api.github.com/users/adamscott/following{/other_user}","gists_url":"https://api.github.com/users/adamscott/gists{/gist_id}","starred_url":"https://api.github.com/users/adamscott/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/adamscott/subscriptions","organizations_url":"https://api.github.com/users/adamscott/orgs","repos_url":"https://api.github.com/users/adamscott/repos","events_url":"https://api.github.com/users/adamscott/events{/privacy}","received_events_url":"https://api.github.com/users/adamscott/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2024-12-17T19:54:38Z","updated_at":"2024-12-17T19:54:38Z","body":"Unless I'm mistaken, exposing the API to scripting makes it available to dotnet and GDExtension. So it can be useful to expose something that cannot be used by GDScript.","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2549480363/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2550659555","html_url":"https://github.com/godotengine/godot/pull/100528#issuecomment-2550659555","issue_url":"https://api.github.com/repos/godotengine/godot/issues/100528","id":2550659555,"node_id":"IC_kwDOAO6SJc6YB_nj","user":{"login":"bruvzg","id":7645683,"node_id":"MDQ6VXNlcjc2NDU2ODM=","avatar_url":"https://avatars.githubusercontent.com/u/7645683?v=4","gravatar_id":"","url":"https://api.github.com/users/bruvzg","html_url":"https://github.com/bruvzg","followers_url":"https://api.github.com/users/bruvzg/followers","following_url":"https://api.github.com/users/bruvzg/following{/other_user}","gists_url":"https://api.github.com/users/bruvzg/gists{/gist_id}","starred_url":"https://api.github.com/users/bruvzg/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/bruvzg/subscriptions","organizations_url":"https://api.github.com/users/bruvzg/orgs","repos_url":"https://api.github.com/users/bruvzg/repos","events_url":"https://api.github.com/users/bruvzg/events{/privacy}","received_events_url":"https://api.github.com/users/bruvzg/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2024-12-18T08:22:29Z","updated_at":"2024-12-18T08:22:29Z","body":"> No point exposing to scripting as there is no uint64 type in GDScript.\r\n\r\nGDScript does not have dedicated unsigned int type, but it can store all uint64_t values, lack of support only relevant for math operations. And the reverse operation is already exposed (https://docs.godotengine.org/en/stable/classes/class_string.html#class-string-method-num-uint64).","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2550659555/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2550923677","html_url":"https://github.com/godotengine/godot/pull/100528#issuecomment-2550923677","issue_url":"https://api.github.com/repos/godotengine/godot/issues/100528","id":2550923677,"node_id":"IC_kwDOAO6SJc6YDAGd","u