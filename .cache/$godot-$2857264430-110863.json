n":"fire","type":"User","owned_private_repos":0,"public_gists":0,"public_repos":0,"total_private_repos":0,"url":"https://api.github.com/users/fire"},"body":"","html_url":"https://github.com/godotengine/godot/pull/110863#pullrequestreview-3270447226","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/110863","author_association":"MEMBER","submitted_at":"2025-09-26T07:02:35Z"},{"id":3270450184,"node_id":"PRR_kwDOAO6SJc7C7xwI","state":"COMMENTED","user":{"site_admin":false,"suspended":false,"updated_at":"0001-01-01T00:00:00Z","avatar_url":"https://avatars.githubusercontent.com/u/32321?u=c2e06a3d2b49a467aa907e54aa259516440267cc&v=4","created_at":"0001-01-01T00:00:00Z","followers":0,"following":0,"html_url":"https://github.com/fire","id":32321,"node_id":"MDQ6VXNlcjMyMzIx","login":"fire","type":"User","owned_private_repos":0,"public_gists":0,"public_repos":0,"total_private_repos":0,"url":"https://api.github.com/users/fire"},"body":"","html_url":"https://github.com/godotengine/godot/pull/110863#pullrequestreview-3270450184","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/110863","author_association":"MEMBER","submitted_at":"2025-09-26T07:03:07Z"},{"id":3270795263,"node_id":"PRR_kwDOAO6SJc7C9F__","state":"COMMENTED","user":{"site_admin":false,"suspended":false,"updated_at":"0001-01-01T00:00:00Z","avatar_url":"https://avatars.githubusercontent.com/u/406832?v=4","created_at":"0001-01-01T00:00:00Z","followers":0,"following":0,"html_url":"https://github.com/kisg","id":406832,"node_id":"MDQ6VXNlcjQwNjgzMg==","login":"kisg","type":"User","owned_private_repos":0,"public_gists":0,"public_repos":0,"total_private_repos":0,"url":"https://api.github.com/users/kisg"},"body":"","html_url":"https://github.com/godotengine/godot/pull/110863#pullrequestreview-3270795263","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/110863","author_association":"CONTRIBUTOR","submitted_at":"2025-09-26T08:17:48Z"},{"id":3290501481,"node_id":"PRR_kwDOAO6SJc7EIRFp","state":"CHANGES_REQUESTED","user":{"site_admin":false,"suspended":false,"updated_at":"0001-01-01T00:00:00Z","avatar_url":"https://avatars.githubusercontent.com/u/17489292?u=34072b401722100a7c0c0d61e37b376cf22b4545&v=4","created_at":"0001-01-01T00:00:00Z","followers":0,"following":0,"html_url":"https://github.com/Repiteo","id":17489292,"node_id":"MDQ6VXNlcjE3NDg5Mjky","login":"Repiteo","type":"User","owned_private_repos":0,"public_gists":0,"public_repos":0,"total_private_repos":0,"url":"https://api.github.com/users/Repiteo"},"body":"Excellent job so far! This is obviously something that has been in the works for a looong time.\r\n\r\nThe buildsystem side of things is *mostly* accounted for, but there's a few things that need tweaking. Most notably: we shouldn't be hardcoding the platforms which support compiling as a library. This information can be conveyed through the \"supports\" flag that platforms can pass. As this is a more involved change, I've opted to put this implementation specifically in a dedicated diff:\r\n\r\n<details>\r\n<summary>diff</summary>\r\n\r\n```diff\r\n SConstruct                  | 14 +++++++-------\r\n platform/linuxbsd/detect.py |  2 +-\r\n platform/macos/detect.py    |  2 +-\r\n platform/windows/detect.py  |  2 +-\r\n 4 files changed, 10 insertions(+), 10 deletions(-)\r\n\r\ndiff --git a/SConstruct b/SConstruct\r\nindex 4ccf237cc8..326b4ab88a 100644\r\n--- a/SConstruct\r\n+++ b/SConstruct\r\n@@ -356,13 +356,6 @@ if not env[\"platform\"]:\r\n     if env[\"platform\"]:\r\n         print(f\"Automatically detected platform: {env['platform']}\")\r\n \r\n-# Library Support\r\n-if env[\"library_type\"] != \"executable\":\r\n-    if env[\"platform\"] not in [\"linuxbsd\", \"macos\", \"windows\"]:\r\n-        print_error(f\"Library builds not yet supported for {env['platform']}\")\r\n-        Exit(255)\r\n-    env.Append(CPPDEFINES=[\"LIBGODOT_ENABLED\"])\r\n-\r\n # Deprecated aliases kept for compatibility.\r\n if env[\"platform\"] in compatibility_platform_aliases:\r\n     alias = env[\"platform\"]\r\n@@ -571,6 +564,13 @@ if not env[\"deprecated\"]:\r\n if env[\"precision\"] == \"double\":\r\n     env.Append(CPPDEFINES=[\"REAL_T_IS_DOUBLE\"])\r\n \r\n+# Library Support\r\n+if env[\"library_type\"] != \"executable\":\r\n+    if \"library\" not in env.get(\"supported\", []):\r\n+        print_error(f\"Library builds unsupported for {env['platform']}\")\r\n+        Exit(255)\r\n+    env.Append(CPPDEFINES=[\"LIBGODOT_ENABLED\"])\r\n+\r\n # Default num_jobs to local cpu count if not user specified.\r\n # SCons has a peculiarity where user-specified options won't be overridden\r\n # by SetOption, so we can rely on this to know if we should use our default.\r\ndiff --git a/platform/linuxbsd/detect.py b/platform/linuxbsd/detect.py\r\nindex 5f929c5925..03fdddd5de 100644\r\n--- a/platform/linuxbsd/detect.py\r\n+++ b/platform/linuxbsd/detect.py\r\n@@ -67,7 +67,7 @@ def get_doc_path():\r\n def get_flags():\r\n     return {\r\n         \"arch\": detect_arch(),\r\n-        \"supported\": [\"mono\"],\r\n+        \"supported\": [\"library\", \"mono\"],\r\n     }\r\n \r\n \r\ndiff --git a/platform/macos/detect.py b/platform/macos/detect.py\r\nindex 9873233baa..c5846c34a1 100644\r\n--- a/platform/macos/detect.py\r\n+++ b/platform/macos/detect.py\r\n@@ -61,7 +61,7 @@ def get_flags():\r\n         \"arch\": detect_arch(),\r\n         \"use_volk\": False,\r\n         \"metal\": True,\r\n-        \"supported\": [\"metal\", \"mono\"],\r\n+        \"supported\": [\"library\", \"metal\", \"mono\"],\r\n     }\r\n \r\n \r\ndiff --git a/platform/windows/detect.py b/platform/windows/detect.py\r\nindex d5a8eb5f85..973be3e6b2 100644\r\n--- a/platform/windows/detect.py\r\n+++ b/platform/windows/detect.py\r\n@@ -233,7 +233,7 @@ def get_flags():\r\n \r\n     return {\r\n         \"arch\": arch,\r\n-        \"supported\": [\"d3d12\", \"dcomp\", \"mono\", \"xaudio2\"],\r\n+        \"supported\": [\"d3d12\", \"dcomp\", \"library\", \"mono\", \"xaudio2\"],\r\n     }\r\n \r\n \r\n```\r\n</details>\r\n\r\nEverything else is covered in the following suggestions","html_url":"https://github.com/godotengine/godot/pull/110863#pullrequestreview-3290501481","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/110863","author_association":"CONTRIBUTOR","submitted_at":"2025-10-01T19:05:31Z"},{"id":3299260855,"node_id":"PRR_kwDOAO6SJc7Eprm3","state":"CHANGES_REQUESTED","user":{"site_admin":false,"suspended":false,"updated_at":"0001-01-01T00:00:00Z","avatar_url":"https://avatars.githubusercontent.com/u/17489292?u=34072b401722100a7c0c0d61e37b376cf22b4545&v=4","created_at":"0001-01-01T00:00:00Z","followers":0,"following":0,"html_url":"https://github.com/Repiteo","id":17489292,"node_id":"MDQ6VXNlcjE3NDg5Mjky","login":"Repiteo","type":"User","owned_private_repos":0,"public_gists":0,"public_repos":0,"total_private_repos":0,"url":"https://api.github.com/users/Repiteo"},"body":"That applies most of the suggested changes, but you still need to apply the [above diff](https://github.com/godotengine/godot/pull/110863#pullrequestreview-3290501481). If you missed it, the `> diff` part can be expanded by clicking","html_url":"https://github.com/godotengine/godot/pull/110863#pullrequestreview-3299260855","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/110863","author_association":"CONTRIBUTOR","submitted_at":"2025-10-03T14:21:55Z"},{"id":3266256876,"node_id":"PRR_kwDOAO6SJc7Crx_s","state":"COMMENTED","user":{"site_admin":false,"suspended":false,"updated_at":"0001-01-01T00:00:00Z","avatar_url":"https://avatars.githubusercontent.com/u/96648715?u=af70f5d107e9c1447f296643d5a566dab53d25e8&v=4","created_at":"0001-01-01T00:00:00Z","followers":0,"following":0,"html_url":"https://github.com/AThousandShips","id":96648715,"node_id":"U_kgDOBcK-Cw","login":"AThousandShips","type":"User","owned_private_repos":0,"public_gists":0,"public_repos":0,"total_private_repos":0,"url":"https://api.github.com/users/AThousandShips"},"body":"","html_url":"https://github.com/godotengine/godot/pull/110863#pullrequestreview-3266256876","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/110863","author_association":"MEMBER","submitted_at":"2025-10-03T14:23:20Z"},{"id":3299463437,"node_id":"PRR_kwDOAO6SJc7EqdEN","state":"COMMENTED","user":{"site_admin":false,"suspended":false,"updated_at":"0001-01-01T00:00:00Z","avatar_url":"https://avatars.githubusercontent.com/u/191561?v=4","created_at":"0001-01-01T00:00:00Z","followers":0,"following":0,"html_url":"https://github.com/dsnopek","id":191561,"node_id":"MDQ6VXNlcjE5MTU2MQ==","login":"dsnopek","type":"User","owned_private_repos":0,"public_gists":0,"public_repos":0,"total_private_repos":0,"url":"https://api.github.com/users/dsnopek"},"body":"","html_url":"https://github.com/godotengine/godot/pull/110863#pullrequestreview-3299463437","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/110863","author_association":"CONTRIBUTOR","submitted_at":"2025-10-03T14:58:45Z"},{"id":3299534657,"node_id":"PRR_kwDOAO6SJc7EqudB","state":"COMMENTED","user":{"site_admin":false,"suspended":false,"updated_at":"0001-01-01T00:00:00Z","avatar_url":"https://avatars.githubusercontent.com/u/191561?v=4","created_at":"0001-01-01T00:00:00Z","followers":0,"following":0,"html_url":"https://github.com/dsnopek","id":191561,"node_id":"MDQ6VXNlcjE5MTU2MQ==","login":"dsnopek","type":"User","owned_private_repos":0,"public_gists":0,"public_repos":0,"total_private_repos":0,"url":"https://api.github.com/users/dsnopek"},"body":"I've finally had a chance to give this a proper review.\r\n\r\nOnce all suggestions from @AThousandShips are applied, the GDExtension bits look good to me. :-) It also looks like the build system diff from @Repiteo still hasn't been applied.\r\n\r\nBut after those things are done, I'd be happy to give this PR my approval!","html_url":"https://github.com/godotengine/godot/pull/11086