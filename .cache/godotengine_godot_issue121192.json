chived_by":null},{"id":279098255,"node_id":"MDU6TGFiZWwyNzkwOTgyNTU=","url":"https://api.github.com/repos/godotengine/godot/labels/topic:platforms","name":"topic:platforms","color":"ffee88","default":false,"description":"","archived_at":null,"archived_by":null}],"state":"closed","locked":false,"assignees":[],"milestone":{"url":"https://api.github.com/repos/godotengine/godot/milestones/25","html_url":"https://github.com/godotengine/godot/milestone/25","labels_url":"https://api.github.com/repos/godotengine/godot/milestones/25/labels","id":15520464,"node_id":"MI_kwDOAO6SJc4A7NLQ","number":25,"title":"4.8","description":"","creator":{"login":"Repiteo","id":17489292,"node_id":"MDQ6VXNlcjE3NDg5Mjky","avatar_url":"https://avatars.githubusercontent.com/u/17489292?v=4","gravatar_id":"","url":"https://api.github.com/users/Repiteo","html_url":"https://github.com/Repiteo","followers_url":"https://api.github.com/users/Repiteo/followers","following_url":"https://api.github.com/users/Repiteo/following{/other_user}","gists_url":"https://api.github.com/users/Repiteo/gists{/gist_id}","starred_url":"https://api.github.com/users/Repiteo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Repiteo/subscriptions","organizations_url":"https://api.github.com/users/Repiteo/orgs","repos_url":"https://api.github.com/users/Repiteo/repos","events_url":"https://api.github.com/users/Repiteo/events{/privacy}","received_events_url":"https://api.github.com/users/Repiteo/received_events","type":"User","user_view_type":"public","site_admin":false},"open_issues":343,"closed_issues":2335,"state":"open","created_at":"2026-04-13T15:59:35Z","updated_at":"2026-10-22T06:28:22Z","due_on":null,"closed_at":null},"comments":2,"created_at":"2026-07-10T19:41:41Z","updated_at":"2026-07-30T16:37:37Z","closed_at":"2026-07-10T21:23:17Z","assignee":null,"author_association":"NONE","issue_field_values":[],"type":null,"active_lock_reason":null,"draft":false,"pull_request":{"url":"https://api.github.com/repos/godotengine/godot/pulls/121192","html_url":"https://github.com/godotengine/godot/pull/121192","diff_url":"https://github.com/godotengine/godot/pull/121192.diff","patch_url":"https://github.com/godotengine/godot/pull/121192.patch","merged_at":"2026-07-10T21:23:17Z"},"body":"\r\n## What problem(s) does this PR solve?\r\n\r\n- Closes #120649\r\n\r\n## Additional information\r\n\r\nchecks whether a drive is a network drive before querying it with GetVolumeInformationW, which I have noticed hangs for about 8 seconds on disconnected network drives.\r\n\r\nI don't know that this is the best way to resolve this, but it is a way.\r\n\r\nI tested by launching godot editor with and without this change and without it it hangs for ~30 seconds and with it it opens right away\r\n<img width=\"129\" height=\"111\" alt=\"image\" src=\"https://github.com/user-attachments/assets/946fb815-4695-4cd2-9c85-1bee9feb4420\" />\r\n\r\n\r\nThis is a continuation of #120666\r\nI didn't find a satisfactory way to update the other one while still being a single commit.\r\nany advice in this would be greatly appreciated, and I am happy to clean these up to fit the desired protocol.\r\nI couldn't find anything speaking to it in the guidelines.\r\n*edit* it's in there, https://contributing.godotengine.org/en/latest/pull_requests/creating_pull_requests.html#modifying-a-pull-request\r\n\r\nI will also note here that I have never used godot's file dialog before, I always set it to native, and so didn't even know where these would be displayed.\r\nThis commit does fix the editor taking forever to open, but if you go and click on a network drive in \"game\" with the godot file dialog and then click on a ```<network>``` drive, it hangs for that ~8 seconds","closed_by":{"login":"Repiteo","id":17489292,"node_id":"MDQ6VXNlcjE3NDg5Mjky","avatar_url":"https://avatars.githubusercontent.com/u/17489292?v=4","gravatar_id":"","url":"https://api.github.com/users/Repiteo","html_url":"https://github.com/Repiteo","followers_url":"https://api.github.com/users/Repiteo/followers","following_url":"https://api.github.com/users/Repiteo/following{/other_user}","gists_url":"https://api.github.com/users/Repiteo/gists{/gist_id}","starred_url":"https://api.github.com/users/Repiteo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Repiteo/subscriptions","organizations_url":"https://api.github.com/users/Repiteo/orgs","repos_url":"https://api.github.com/users/Repiteo/repos","events_url":"https://api.github.com/users/Repiteo/events{/privacy}","received_events_url":"https://api.github.com/users/Repiteo/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/121192/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/godotengine/godot/issues/121192/timeline","performed_via_github_app":null,"state_reason":null}