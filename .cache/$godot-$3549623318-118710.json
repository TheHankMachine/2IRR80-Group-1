 list, which makes it feel more like a proper cleanup when you're cleaning up templates from older versions.","html_url":"https://github.com/godotengine/godot/pull/118710#pullrequestreview-4134313189","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/118710","author_association":"CONTRIBUTOR","submitted_at":"2026-04-18T12:06:38Z"},{"id":4134324183,"node_id":"PRR_kwDOAO6SJc72bMfX","state":"APPROVED","commit_id":"b07bbf6ed25c3818a8a9cd395bb52153e450f1e8","user":{"site_admin":false,"suspended":false,"updated_at":"0001-01-01T00:00:00Z","avatar_url":"https://avatars.githubusercontent.com/u/5611323?v=4","created_at":"0001-01-01T00:00:00Z","followers":0,"following":0,"html_url":"https://github.com/AdriaandeJongh","id":5611323,"node_id":"MDQ6VXNlcjU2MTEzMjM=","login":"AdriaandeJongh","type":"User","owned_private_repos":0,"public_gists":0,"public_repos":0,"total_private_repos":0,"url":"https://api.github.com/users/AdriaandeJongh"},"body":"Alllright, delaying the inevitable complaints that \"there's no way to remove the Godot versions from the export template godot version list!!!11!\". Fine.","html_url":"https://github.com/godotengine/godot/pull/118710#pullrequestreview-4134324183","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/118710","author_association":"CONTRIBUTOR","submitted_at":"2026-04-18T12:15:16Z"},{"id":4134631224,"node_id":"PRR_kwDOAO6SJc72cXc4","state":"APPROVED","commit_id":"b07bbf6ed25c3818a8a9cd395bb52153e450f1e8","user":{"site_admin":false,"suspended":false,"updated_at":"0001-01-01T00:00:00Z","avatar_url":"https://avatars.githubusercontent.com/u/180032?u=68d23e7ee9cdf810da125e8510b72f845b9dccc8&v=4","created_at":"0001-01-01T00:00:00Z","followers":0,"following":0,"html_url":"https://github.com/Calinou","id":180032,"node_id":"MDQ6VXNlcjE4MDAzMg==","login":"Calinou","type":"User","owned_private_repos":0,"public_gists":0,"public_repos":0,"total_private_repos":0,"url":"https://api.github.com/users/Calinou"},"body":