ithub.com/users/Mickeon/followers","following_url":"https://api.github.com/users/Mickeon/following{/other_user}","gists_url":"https://api.github.com/users/Mickeon/gists{/gist_id}","starred_url":"https://api.github.com/users/Mickeon/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Mickeon/subscriptions","organizations_url":"https://api.github.com/users/Mickeon/orgs","repos_url":"https://api.github.com/users/Mickeon/repos","events_url":"https://api.github.com/users/Mickeon/events{/privacy}","received_events_url":"https://api.github.com/users/Mickeon/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-11-19T18:49:32Z","updated_at":"2025-11-19T18:49:32Z","body":"> > Question for anyone reviewing / better knowledge of this area: Should there be some backwards compatibility supplied for moving any existing `search_hhistory` config forward to `search_history`?\r\n>\r\n> I do not think it is possible for export settings.\r\n\r\nWhile we normally can't, we probably should find a way to do this. Changing the properties' names is quite destructive because all 4 corresponding strings, as the developer inputted them, will be lost when the export settings are loaded. This typo fix is the kind of thing that some have surely noticed during importing, yet nothing was done about it because it's not _that_ big of a deal. ","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3554167458/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3559103000","html_url":"https://github.com/godotengine/godot/pull/103953#issuecomment-3559103000","issue_url":"https://api.github.com/repos/godotengine/godot/issues/103953","id":3559103000,"node_id":"IC_kwDOAO6SJc7UI5oY","user":{"login":"akien-mga","id":4701338,"node_id":"MDQ6VXNlcjQ3MDEzMzg=","avatar_url":"https://avatars.githubusercontent.com/u/4701338?v=4","gravatar_id":"","url":"https://api.github.com/users/akien-mga","html_url":"https://github.com/akien-mga","followers_url":"https://api.github.com/users/akien-mga/followers","following_url":"https://api.github.com/users/akien-mga/following{/other_user}","gists_url":"https://api.github.com/users/akien-mga/gists{/gist_id}","starred_url":"https://api.github.com/users/akien-mga/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/akien-mga/subscriptions","organizations_url":"https://api.github.com/users/akien-mga/orgs","repos_url":"https://api.github.com/users/akien-mga/repos","events_url":"https://api.github.com/users/akien-mga/events{/privacy}","received_events_url":"https://api.github.com/users/akien-mga/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-11-20T17:00:08Z","updated_at":"2025-11-20T17:00:08Z","body":"> > I do not think it is possible for export settings.\r\n> \r\n> While we normally can't, we probably should find a way to do this.\r\n\r\nThis might be possible with some clever use of `_set`/`_get` in the export preset object, but since this was ineffective due to the typo, I don't think we need to bother with compatibility here. If some users relied on this niche option, they must have figured out that it's not actually working and found another way to enable it (like editing the `Info.plist` directly, presumably).","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3559103000/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3559135370","html_url":"https://github.com/godotengine/godot/pull/103953#issuecomment-3559135370","issue_url":"https://api.github.com/repos/godotengine/godot/issues/103953","id":3559135370,"node_id":"IC_kwDOAO6SJc7UJBiK","user":{"login":"bruvzg","id":7645683,"node_id":"MDQ6VXNlcjc2NDU2ODM=","avatar_url":"https://avatars.githubusercontent.com/u/7645683?v=4","gravatar_id":"","url":"https://api.github.com/users/bruvzg","html_url":"https://github.com/bruvzg","followers_url":"https://api.github.com/users/bruvzg/followers","following_url":"https://api.github.com/users/bruvzg/following{/other_user}","gists_url":"https://api.github.com/users/bruvzg/gists{/gist_id}","starred_url":"https://api.github.com/users/bruvzg/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/bruvzg/subscriptions","organizations_url":"https://api.github.com/users/bruvzg/orgs","repos_url":"https://api.github.com/users/bruvzg/repos","events_url":"https://api.github.com/users/bruvzg/events{/privacy}","received_events_url":"https://api.github.com/users/bruvzg/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-11-20T17:07:38Z","updated_at":"2025-11-20T17:07:38Z","body":"> If some users relied on this niche option, they must have figured out that it's not actually working\r\n\r\nIt was working, just named wrong in the export dialogs and settings. So it can break some export configs.","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3559135370/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3559191856","html_url":"https://github.com/godotengine/godot/pull/103953#issuecomment-3559191856","issue_url":"https://api.github.com/repos/godotengine/godot/issues/103953","id":3559191856,"node_id":"IC_kwDOAO6SJc7UJPUw","user":{"login":"Repiteo","id":17489292,"node_id":"MDQ6VXNlcjE3NDg5Mjky","avatar_url":"https://avatars.githubusercontent