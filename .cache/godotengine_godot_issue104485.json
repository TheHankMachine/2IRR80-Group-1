ved_by":null},{"id":283518733,"node_id":"MDU6TGFiZWwyODM1MTg3MzM=","url":"https://api.github.com/repos/godotengine/godot/labels/usability","name":"usability","color":"447744","default":false,"description":"","archived_at":null,"archived_by":null},{"id":890310664,"node_id":"MDU6TGFiZWw4OTAzMTA2NjQ=","url":"https://api.github.com/repos/godotengine/godot/labels/topic:input","name":"topic:input","color":"ffee88","default":false,"description":"","archived_at":null,"archived_by":null}],"state":"closed","locked":false,"assignees":[],"milestone":{"url":"https://api.github.com/repos/godotengine/godot/milestones/22","html_url":"https://github.com/godotengine/godot/milestone/22","labels_url":"https://api.github.com/repos/godotengine/godot/milestones/22/labels","id":12070367,"node_id":"MI_kwDOAO6SJc4AuC3f","number":22,"title":"4.5","description":"","creator":{"login":"Sauermann","id":6299227,"node_id":"MDQ6VXNlcjYyOTkyMjc=","avatar_url":"https://avatars.githubusercontent.com/u/6299227?v=4","gravatar_id":"","url":"https://api.github.com/users/Sauermann","html_url":"https://github.com/Sauermann","followers_url":"https://api.github.com/users/Sauermann/followers","following_url":"https://api.github.com/users/Sauermann/following{/other_user}","gists_url":"https://api.github.com/users/Sauermann/gists{/gist_id}","starred_url":"https://api.github.com/users/Sauermann/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Sauermann/subscriptions","organizations_url":"https://api.github.com/users/Sauermann/orgs","repos_url":"https://api.github.com/users/Sauermann/repos","events_url":"https://api.github.com/users/Sauermann/events{/privacy}","received_events_url":"https://api.github.com/users/Sauermann/received_events","type":"User","user_view_type":"public","site_admin":false},"open_issues":3,"closed_issues":3687,"state":"closed","created_at":"2024-12-19T08:51:28Z","updated_at":"2026-09-04T21:48:38Z","due_on":"2025-09-15T00:00:00Z","closed_at":"2025-09-18T17:13:14Z"},"comments":7,"created_at":"2025-03-22T13:58:17Z","updated_at":"2025-04-01T13:07:24Z","closed_at":"2025-04-01T13:07:03Z","assignee":null,"author_association":"CONTRIBUTOR","issue_field_values":[],"type":null,"active_lock_reason":null,"draft":false,"pull_request":{"url":"https://api.github.com/repos/godotengine/godot/pulls/104485","html_url":"https://github.com/godotengine/godot/pull/104485","diff_url":"https://github.com/godotengine/godot/pull/104485.diff","patch_url":"https://github.com/godotengine/godot/pull/104485.patch","merged_at":"2025-04-01T13:07:03Z"},"body":"Hi again, it's been a while.\r\n\r\nSee my comment here for further context: https://github.com/godotengine/godot/pull/104366#issuecomment-2745278021\r\n\r\nFixes #104313\r\nFixes #99524\r\nFixes #88234\r\n\r\nIn addition to my above comment, if you whack a breakpoint down and look at `resolved_nodes_without_context`, it contains a list of all nodes without a \"context\", i.e. global. May want to review which of these should actually be global. Note that this list will change as different parts of the editor are loaded, if context has not been set. The list in the pic below are just from initial load.\r\n\r\n![image](https://github.com/user-attachments/assets/e20de80a-ad60-4594-83c6-e7274916cc8e)\r\n\r\nNote that the changes to `SceneTree` are optional I think. They are an improvement on the default behaviour (somewhat), but if there are still shortcuts unintentionally being registered as global then it does nothing to stop them from being triggered.\r\n\r\nI'll also specifically quote part of my comment from above to possibly drive further discussion about this feature (might warrant an issue/proposal):\r\n> I think part of the problem with the \"shortcut context\" system is that by default, every single node will have its shortcut_input be global unless it opts-in to the context system by using set_shortcut_context. This means if someone forgets to use set_shortcut_context when writing some UI, the shortcuts can be pretty messed up since everything is considered global.\r\n\r\n>This doesn't seem like it is leading developers to the \"pit of success\". I'm not sure if there is a good way to fix it, but perhaps the logic should somehow be flipped so that being a global shortcut is opt-in. In this scenario, by default all controls would essentially have set_shortcut_context(this) in their constructor. That could be overridden on a case-by-case basis to give shortcuts a larger scope.","closed_by":{"login":"Repiteo","id":17489292,"node_id":"MDQ6VXNlcjE3NDg5Mjky","avatar_url":"https://avatars.githubusercontent.com/u/17489292?v=4","gravatar_id":"","url":"https://api.github.com/users/Repiteo","html_url":"https://github.com/Repiteo","followers_url":"https://api.github.com/users/Repiteo/followers","following_url":"https://api.github.com/users/Repiteo/following{/other_user}","gists_url":"https://api.github.com/users/Repiteo/gists{/gist_id}","starred_url":"https://api.github.com/users/Repiteo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Repiteo/subscriptions","organizations_url":"https://api.github.com/users/Repiteo/orgs","repos_url":"https://api.github.com/users/Repiteo/repos","events_url":"https://api.github.com/users/Repiteo/events{/privacy}","received_events_url":"https://api.github.com/users/Repiteo/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/104485/reactions","total_count":6,"+1":5,"-1":0,"laugh":0,"hooray":1,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/godotengine/godot/issues/104485/timeline","performed_via_github_app":null,"state_reason":null}