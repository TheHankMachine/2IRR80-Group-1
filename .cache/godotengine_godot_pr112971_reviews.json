[{"id":3484801899,"node_id":"PRR_kwDOAO6SJc7Ptdtr","user":{"login":"Ivorforce","id":2308167,"node_id":"MDQ6VXNlcjIzMDgxNjc=","avatar_url":"https://avatars.githubusercontent.com/u/2308167?u=f7f8e0273f784f5ec6f6b7fe4a88d449896eb48a&v=4","gravatar_id":"","url":"https://api.github.com/users/Ivorforce","html_url":"https://github.com/Ivorforce","followers_url":"https://api.github.com/users/Ivorforce/followers","following_url":"https://api.github.com/users/Ivorforce/following{/other_user}","gists_url":"https://api.github.com/users/Ivorforce/gists{/gist_id}","starred_url":"https://api.github.com/users/Ivorforce/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Ivorforce/subscriptions","organizations_url":"https://api.github.com/users/Ivorforce/orgs","repos_url":"https://api.github.com/users/Ivorforce/repos","events_url":"https://api.github.com/users/Ivorforce/events{/privacy}","received_events_url":"https://api.github.com/users/Ivorforce/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"Makes sense in principle to have `String` conversions that don't involve `Variant`.\r\n\r\nI'm a bit torn on adding normal constructors to `String`. Currently, it's not possible to e.g. convert from `double` to `String` without calling `num_real` explicitly. \r\nOn the one hand, being able to convert anything to `String` is convenient and expected. Like the `str` function in `Python`, you can just expect anything to describe itself conveniently.\r\nOn the other hand, it's not 100% unambiguous what a conversion from a primitive to `String` means (bool and `nullptr_t` especially). For example in Rust, this is solved not by conversion operators, but by implementing traits `Debug` and `Display`, which are a bit more explicit about what kind of `String` conversion is expected. \r\n\r\nSo in the end, I'm not sure we want to add non-contextual `String` conversion by default. Maybe something for another core meeting?","state":"COMMENTED","html_url":"https://github.com/godotengine/godot/pull/112971#pullrequestreview-3484801899","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/112971","author_association":"MEMBER","_links":{"html":{"href":"https://github.com/godotengine/godot/pull/112971#pullrequestreview-3484801899"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/112971"}},"submitted_at":"2025-11-19T21:33:28Z","commit_id":null},{"id":3488599569,"node_id":"PRR_kwDOAO6SJc7P784R","user":{"login":"Repiteo","id":17489292,"node_id":"MDQ6VXNlcjE3NDg5Mjky","avatar_url":"https://avatars.githubusercontent.com/u/17489292?u=34072b401722100a7c0c0d61e37b376cf22b4545&v=4","gravatar_id":"","url":"https://api.github.com/users/Repiteo","html_url":"https://github.com/Repiteo","followers_url":"https://api.github.com/users/Repiteo/followers","following_url":"https://api.github.com/users/Repiteo/following{/other_user}","gists_url":"https://api.github.com/users/Repiteo/gists{/gist_id}","starred_url":"https://api.github.com/users/Repiteo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Repiteo/subscriptions","organizations_url":"https://api.github.com/users/Repiteo/orgs","repos_url":"https://api.github.com/users/Repiteo/repos","events_url":"https://api.github.com/users/Repiteo/events{/privacy}","received_events_url":"https://api.github.com/users/Repiteo/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"","state":"COMMENTED","html_url":"https://github.com/godotengine/godot/pull/112971#pullrequestreview-3488599569","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/112971","author_association":"CONTRIBUTOR","_links":{"html":{"href":"https://github.com/godotengine/godot/pull/112971#pullrequestreview-3488599569"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/112971"}},"submitted_at":"2025-11-20T15:52:29Z","commit_id":null}]