[{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/2501359305","pull_request_review_id":3431169620,"id":2501359305,"node_id":"PRRC_kwDOAO6SJc6VF7bJ","diff_hunk":"@@ -1040,6 +1040,7 @@\n \t\t</constant>\n \t\t<constant name=\"CONNECT_PERSIST\" value=\"2\" enum=\"ConnectFlags\">\n \t\t\tPersisting connections are stored when the object is serialized (such as when using [method PackedScene.pack]). In the editor, connections created through the Node dock are always persisting.\n+\t\t\t[b]Note:[/b] Connections to lambda functions (i.e. when the function code is embedded in the [method connect] call) cannot be made persistent.","path":"doc/classes/Object.xml","commit_id":"831f645841d62b88a22aac1b3dcbefad205253aa","original_commit_id":"831f645841d62b88a22aac1b3dcbefad205253aa","user":{"login":"Mickeon","id":66727710,"node_id":"MDQ6VXNlcjY2NzI3NzEw","avatar_url":"https://avatars.githubusercontent.com/u/66727710?v=4","gravatar_id":"","url":"https://api.github.com/users/Mickeon","html_url":"https://github.com/Mickeon","followers_url":"https://api.github.com/users/Mickeon/followers","following_url":"https://api.github.com/users/Mickeon/following{/other_user}","gists_url":"https://api.github.com/users/Mickeon/gists{/gist_id}","starred_url":"https://api.github.com/users/Mickeon/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Mickeon/subscriptions","organizations_url":"https://api.github.com/users/Mickeon/orgs","repos_url":"https://api.github.com/users/Mickeon/repos","events_url":"https://api.github.com/users/Mickeon/events{/privacy}","received_events_url":"https://api.github.com/users/Mickeon/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"Okay so, this ambiguity is why I personally adamantly avoid both \"e.g.\" and \"i.e.\": Because of what \"i.e.\" literally stands for, this note strongly implies that \"lambda\" functions are when code is embedded in `connect()`, and that's really the only exception to `CONNECT_PERSIST`.\r\n\r\nWe know both statements aren't true, or at least it's quite misleading, so no point explaining it. However, I must note that we're working with \"Callables\" here, not just \"functions\".\r\nIn fact, what could be worth testing for this purpose is one _fire-sure way_ to [determine whether a Callable is a lambda or not](https://docs.godotengine.org/en/4.5/classes/class_callable.html#class-callable-method-is-custom).\r\n\r\nNo suggestion yet, it's late at night.","created_at":"2025-11-07T01:13:29Z","updated_at":"2025-11-07T01:14:51Z","html_url":"https://github.com/godotengine/godot/pull/112487#discussion_r2501359305","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/112487","_links":{"self":{"href":"https://api.github.com/repos/godotengine/godot/pulls/comments/2501359305"},"html":{"href":"https://github.com/godotengine/godot/pull/112487#discussion_r2501359305"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/112487"}},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/2501359305/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":null,"original_line":1043,"side":"RIGHT","author_association":"MEMBER","original_position":4,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/2501871301","pull_request_review_id":3431911488,"id":2501871301,"node_id":"PRRC_kwDOAO6SJc6VH4bF","diff_hunk":"@@ -1040,6 +1040,7 @@\n \t\t</constant>\n \t\t<constant name=\"CONNECT_PERSIST\" value=\"2\" enum=\"ConnectFlags\">\n \t\t\tPersisting connections are stored when the object is serialized (such as when using [method PackedScene.pack]). In the editor, connections created through the Node dock are always persisting.\n+\t\t\t[b]Note:[/b] Connections to lambda functions (i.e. when the function code is embedded in the [method connect] call) cannot be made persistent.","path":"doc/classes/Object.xml","commit_id":"831f645841d62b88a22aac1b3dcbefad205253aa","original_commit_id":"831f645841d62b88a22aac1b3dcbefad205253aa","user":{"login":"moonvent","id":51057725,"node_id":"MDQ6VXNlcjUxMDU3NzI1","avatar_url":"https://avatars.githubusercontent.com/u/51057725?v=4","gravatar_id":"","url":"https://api.github.com/users/moonvent","html_url":"https://github.com/moonvent","followers_url":"https://api.github.com/users/moonvent/followers","following_url":"https://api.github.com/users/moonvent/following{/other_user}","gists_url":"https://api.github.com/users/moonvent/gists{/gist_id}","starred_url":"https://api.github.com/users/moonvent/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/moonvent/subscriptions","organizations_url":"https://api.github.com/users/moonvent/orgs","repos_url":"https://api.github.com/users/moonvent/repos","events_url":"https://api.github.com/users/moonvent/events{/privacy}","received_events_url":"https://api.github.com/users/moonvent/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"And maybe you can add this description on the connections page?","created_at":"2025-11-07T06:44:11Z","updated_at":"2025-11-07T06:44:12Z","html_url":"https://github.com/godotengine/godot/pull/112487#discussion_r2501871301","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/112487","_links":{"self":{"href":"https://api.github.com/repos/godotengine/godot/pulls/comments/2501871301"},"html":{"href":"https://github.com/godotengine/godot/pull/112487#discussion_r2501871301"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/112487"}},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/2501871301/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side"