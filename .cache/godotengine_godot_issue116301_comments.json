26320/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5908161287","html_url":"https://github.com/godotengine/godot/pull/116301#issuecomment-5908161287","issue_url":"https://api.github.com/repos/godotengine/godot/issues/116301","id":5908161287,"node_id":"IC_kwDOAO6SJc8AAAABYCdjBw","user":{"login":"NoctemCat","id":22471296,"node_id":"MDQ6VXNlcjIyNDcxMjk2","avatar_url":"https://avatars.githubusercontent.com/u/22471296?v=4","gravatar_id":"","url":"https://api.github.com/users/NoctemCat","html_url":"https://github.com/NoctemCat","followers_url":"https://api.github.com/users/NoctemCat/followers","following_url":"https://api.github.com/users/NoctemCat/following{/other_user}","gists_url":"https://api.github.com/users/NoctemCat/gists{/gist_id}","starred_url":"https://api.github.com/users/NoctemCat/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/NoctemCat/subscriptions","organizations_url":"https://api.github.com/users/NoctemCat/orgs","repos_url":"https://api.github.com/users/NoctemCat/repos","events_url":"https://api.github.com/users/NoctemCat/events{/privacy}","received_events_url":"https://api.github.com/users/NoctemCat/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-09-30T09:20:28Z","updated_at":"2026-09-30T09:23:23Z","body":"Here https://docs.godotengine.org/en/stable/classes/class_object.html#class-object-private-method-init\r\n> Note: If [_init()](https://docs.godotengine.org/en/stable/classes/class_object.html#class-object-private-method-init) is defined with required parameters, the Object with script may only be created directly. If any other means (such as [PackedScene.instantiate()](https://docs.godotengine.org/en/stable/classes/class_packedscene.html#class-packedscene-method-instantiate) or [Node.duplicate()](https://docs.godotengine.org/en/stable/classes/class_node.html#class-node-method-duplicate)) are used, the script's initialization will fail.\r\n\r\nTbh it is strange that the GDScript reference itself doesn't mention it directly, and it is only mentioned in the `Object` documentation https://docs.godotengine.org/en/stable/tutorials/scripting/gdscript/gdscript_basics.html#class-constructor","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5908161287/reactions","total_count":2,"+1":2,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5908255792","html_url":"https://github.com/godotengine/godot/pull/116301#issuecomment-5908255792","issue_url":"https://api.github.com/repos/godotengine/godot/issues/116301","id":5908255792,"node_id":"IC_kwDOAO6SJc8AAAABYCjUMA","user":{"login":"AThousandShips","id":96648715,"node_id":"U_kgDOBcK-Cw","avatar_url":"https://avatars.githubusercontent.com/u/96648715?v=4","gravatar_id":"","url":"https://api.github.com/users/AThousandShips","html_url":"https://github.com/AThousandShips","followers_url":"https://api.github.com/users/AThousandShips/followers","following_url":"https://api.github.com/users/AThousandShips/following{/other_user}","gists_url":"https://api.github.com/users/AThousandShips/gists{/gist_id}","starred_url":"https://api.github.com/users/AThousandShips/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/AThousandShips/subscriptions","organizations_url":"https://api.github.com/users/AThousandShips/orgs","repos_url":"https://api.github.com/users/AThousandShips/repos","events_url":"https://api.github.com/users/AThousandShips/events{/privacy}","received_events_url":"https://api.github.com/users/AThousandShips/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-09-30T09:25:35Z","updated_at":"2026-09-30T09:25:35Z","body":"It's also mentioned [here](https://docs.godotengine.org/en/stable/tutorials/scripting/resources.html#creating-your-own-resources)","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5908255792/reactions","total_count":2,"+1":2,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5909210375","html_url":"https://github.com/godotengine/godot/pull/116301#issuecomment-5909210375","issue_url":"https://api.github.com/repos/godotengine/godot/issues/116301","id":5909210375,"node_id":"IC_kwDOAO6SJc8AAAABYDdlBw","user":{"login":"Delsin-Yu","id":71481700,"node_id":"MDQ6VXNlcjcxNDgxNzAw","avatar_url":"https://avatars.githubusercontent.com/u/71481700?v=4","gravatar_id":"","url":"https://api.github.com/users/Delsin-Yu","html_url":"https://github.com/Delsin-Yu","followers_url":"https://api.github.com/users/Delsin-Yu/followers","following_url":"https://api.github.com/users/Delsin-Yu/following{/other_user}","gists_url":"https://api.github.com/users/Delsin-Yu/gists{/gist_id}","starred_url":"https://api.github.com/users/Delsin-Yu/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Delsin-Yu/subscriptions","organizations_url":"https://api.github.com/users/Delsin-Yu/orgs","repos_url":"https://api.github.com/users/Delsin-Yu/repos","events_url":"https://api.github.com/users/Delsin-Yu/events{/privacy}","received_events_url":"https://api.github.com/users/Delsin-Yu/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-09-30T10:16:11Z","updated_at":"2026-09-30T10:16:11Z","body":"> Note: If [_init()](https://docs.godotengine.org/en/stable/classes/class_object.html#class-object-private-method-init) is defined with required parameters, the Object with script may only be created directly. If any other means (such as [PackedScene.instantiate()](https://docs.godotengine.org/en/stable/classes/class_packedscene.html#class-packedscene-method-instantiate) or [Node.duplicate()](https://docs.godotengine.org/en/stable/classes/class_node.html#class-node-method-duplicate)) are used, the script's initialization will fail.\r\n\r\nThen this should be a legit feature that needs to be supported by this PR (C#, Script Type, No Parameterless Constructors must compile and error out correctly on engine-side creation).","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5909210375/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5915488116","html_url":"https://github.com/godotengine/godot/pull/116301#issuecomment-5915488116","issue_url":"https://api.github.com/repos/godotengine/godot/issues/116301","id":5915488116,"node_id":"IC_kwDOAO6SJc8AAAABYJcvdA","user":{"login":"neikeq","id":7718100,"node_id":"MDQ6VXNlcjc3MTgxMDA=","avatar_url":"https://avatars.githubusercontent.com/u/7718100?v=4","gravatar_id":"","url":"https://api.github.com/users/neikeq","html_url":"https://github.com/neikeq","followers_url":"https://api.github.com/users/neikeq/followers","following_url":"https://api.github.com/users/neikeq/following{/other_user}","gists_url":"https://api.github.com/users/neikeq/gists{/gist_id}","starred_url":"https://api.github.com/users/neikeq/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/neikeq/subscriptions","organizations_url":"https://api.github.com/users/neikeq/orgs","repos_url":"https://api.github.com/users/neikeq/repos","events_url":"https://api.github.com/users/neikeq/events{/privacy}","received_events_url":"https://api.github.com/users/neikeq/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-09-30T16:34:09Z","updated_at":"2026-09-30T16:34:09Z","body":"> While testing a 4.7.2 backport of this PR, I hit CS0117 for a script class whose only constructor takes a managed-only argument, such as System.IO.Stream.\r\n> \r\n> The constructor is filtered out as not Variant-compatible, so ScriptMethodsGenerator omits GetGodotConstructorTrampolines. However, TrampolineCollectorDispatchGenerator still generates a call to that method, breaking an otherwise valid C# class.\r\n> \r\n> Could the generator emit an empty constructor collector when no eligible constructors exist, or consistently skip the corresponding dispatch? Constructors used only from C# shouldn’t need Variant-compatible parameters.\r\n\r\nI'm not rebasing this for now, as it can't be merged until the 4.9 dev cycle at the earliest. I'll fix this once that version opens.\r\n\r\n> Parameter-only script is supported in GDScript, so C# not supporting it would be strange. Well if we ignore that `[Tool]` scripts needs parameterless ctor to be reloadable, it should work in other scenarious.\r\n> \r\n> You only required to have them if it is a node type stored in the `PackedScene` or a saved resource type.\r\n\r\nThis is beyond the scope of this PR. That being said, if this is allowed in GDScript, then it makes sense to support that in C# as well. Although I think it would be better to still give a warning with a clear explanation on the C#, which the user could suppress if it's intentional.","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5915488116/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5916132563","html_url":"https://github.com/godotengine/godot/pull/116301#issuecomment-5916132563","issue_url":"https://api.github.com/repos/godotengine/godot/issues/116301","id":5916132563,"node_id":"IC_kwDOAO6SJc8AAAABYKEE0w","user":{"login":"NoctemCat","id":22471296,"node_id":"MDQ6VXNlcjIyNDcxMjk2","avatar_url":"https://avatars.githubusercontent.com/u/22471296?v=4","gravatar_id":"","url":"https://api.github.com/users/NoctemCat","html_url":"https://github.com/NoctemCat","followers_url":"https://api.github.com/users/NoctemCat/followers","following_url":"https://api.github.com/users/NoctemCat/following{/other_user}","gists_url":"https://api.github.com/users/NoctemCat/gists{/gist_id}","starred_url":"https://api.github.com/users/NoctemCat/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/NoctemCat/subscriptions","organizations_url":"https://api.github.com/users/NoctemCat/orgs","repos_url":"https://api.github.com/users/NoctemCat/repos","events_url":"https://api.github.com/users/NoctemCat/events{/privacy}","received_events_url":"https://api.github.com/users/NoctemCat/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-09-30T17:15:55Z","updated_at":"2026-09-30T17:26:38Z","body":"> This is beyond the scope of this PR.\r\n\r\nIt already works correctly, so not supporting it is a clear regression\r\n<img width=\"782\" height=\"563\" alt=\"image\" src=\"https://github.com/user-attachments/assets/10563b63-1f48-46ca-8ca8-cc01b348aaec\" />\r\n\r\nEdit: Tbh cross scripting is also somewhat of a mess, you can only call compatible ctors on a `Script`:\r\n<img width=\"985\" height=\"361\" alt=\"image\" src=\"https://github.com/user-attachments/assets/6a4f6f17-d434-41dd-8b2a-cee817808f89\" />\r\n","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5916132563/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5919002315","html_url":"https://github.com/godotengine/godot/pull/116301#issuecomment-5919002315","issue_url":"https://api.github.com/repos/godotengine/godot/issues/116301","id":5919002315,"node_id":"IC_kwDOAO6SJc8AAAABYMzOyw","user":{"login":"raulsntos","id":3903059,"node_id":"MDQ6VXNlcjM5MDMwNTk=","avatar_url":"https://avatars.githubusercontent.com/u/3903059?v=4","gravatar_id":"","url":"https://api.github.com/users/raulsntos","html_url":"https://github.com/raulsntos","followers_url":"https://api.github.com/users/raulsntos/followers","following_url":"https://api.github.com/users/raulsntos/following{/other_user}","gists_url":"https://api.github.com/users/raulsntos/gists{/gist_id}","starred_url":"https://api.github.com/users/raulsntos/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/raulsntos/subscriptions","organizations_url":"https://api.github.com/users/raulsntos/orgs","repos_url":"https://api.github.com/users/raulsntos/repos","events_url":"https://api.github.com/users/raulsntos/events{/privacy}","received_events_url":"https://api.github.com/users/raulsntos/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-09-30T20:21:10Z","updated_at":"2026-09-30T20:21:10Z","body":"> Tbh cross scripting is also somewhat of a mess, you can only call compatible ctors on a `Script`\r\n\r\nThat's https://github.com/godotengine/godot/issues/109189 and it's because GDScript is specifically looking for a method called `_init`. If you add a `_init` method (see https://github.com/godotengine/godot/issues/109189#issuecomment-5804323966), then GDScript will be able to find your ctor. The `_init` method itself doesn't get called. The problem is if there are multiple ctors we wouldn't know which one to register, but otherwise we could fix it.","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5919002315/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5920887176","html_url":"https://github.com/godotengine/godot/pull/116301#issuecomment-5920887176","issue_url":"https://api.github.com/repos/godotengine/godot/issues/116301","id":5920887176,"node_id":"IC_kwDOAO6SJc8AAAABYOmRiA","user":{"login":"neikeq","id":7718100,"node_id":"MDQ6VXNlcjc3MTgxMDA=","avatar_url":"https://avatars.githubusercontent.com/u/7718100?v=4","gravatar_id":"","url":"https://api.github.com/users/neikeq","html_url":"https://github.com/neikeq","followers_url":"https://api.github.com/users/neikeq/followers","following_url":"https://api.github.com/users/neikeq/following{/other_user}","gists_url":"https://api.github.com/users/neikeq/gists{/gist_id}","starred_url":"https://api.github.com/users/neikeq/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/neikeq/subscriptions","organizations_url":"https://api.github.com/users/neikeq/orgs","repos_url":"https://api.github.com/users/neikeq/repos","events_url":"https://api.github.com/users/neikeq/events{/privacy}","received_events_url":"https://api.github.com/users/neikeq/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-09-30T22:33:50Z","updated_at":"2026-09-30T22:33:50Z","body":"> It already works correctly, so not supporting it is a clear regression\r\n\r\nYou mean that it was working before and stopped working with this PR?","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5920887176/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5922798679","html_url":"https://github.com/godotengine/godot/pull/116301#issuecomment-5922798679","issue_url":"https://api.github.com/repos/godotengine/godot/issues/116301","id":5922798679,"node_id":"IC_kwDOAO6SJc8AAAABYQa8Vw","user":{"login":"NoctemCat","id":22471296,"node_id":"MDQ6VXNlcjIyNDcxMjk2","avatar_url":"https://avatars.githubusercontent.com/u/22471296?v=4","gravatar_id":"","url":"https://api.github.com/users/NoctemCat","html_url":"https://github.com/NoctemCat","followers_url":"https://api.github.com/users/NoctemCat/followers","following_url":"https://api.github.com/users/NoctemCat/following{/other_user}","gists_url":"https://api.github.com/users/NoctemCat/gists{/gist_id}","starred_url":"https://api.github.com/users/NoctemCat/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/NoctemCat/subscriptions","organizations_url":"https://api.github.com/users/NoctemCat/orgs","repos_url":"https://api.github.com/users/NoctemCat/repos","events_url":"https://api.github.com/users/NoctemCat/events{/privacy}","received_events_url":"https://api.github.com/users/NoctemCat/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-10-01T01:21:24Z","updated_at":"2026-10-01T01:30:39Z","body":"> You mean that it was working before and stopped working with this PR?\r\n\r\nYeah, see https://github.com/godotengine/godot/pull/116301#issuecomment-5907288302\r\n> While testing a 4.7.2 backport of this PR, I hit CS0117 for a script class whose only constructor takes a managed-only argument, such as System.IO.Stream.\r\n> \r\n> The constructor is filtered out as not Variant-compatible, so ScriptMethodsGenerator omits GetGodotConstructorTrampolines. However, TrampolineCollectorDispatchGenerator still generates a call to that method, breaking an otherwise valid C# class.\r\n\r\nOther comment:\r\n> That's https://github.com/godotengine/godot/issues/109189 and it's because GDScript is specifically looking for a method called _init. If you add a _init method (see https://github.com/godotengine/godot/issues/109189#issuecomment-5804323966), then GDScript will be able to find your ctor. The _init method itself doesn't get called. The problem is if there are multiple ctors we wouldn't know which one to register, but otherwise we could fix it.\r\n\r\nWonder if it makes sense to register the single constructor by type directly, and use varargs type when there are several of them.","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5922798679/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null}]