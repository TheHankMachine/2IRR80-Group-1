[{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/3125656504","pull_request_review_id":4156545639,"id":3125656504,"node_id":"PRRC_kwDOAO6SJc66Tbu4","diff_hunk":"@@ -125,12 +125,17 @@ class [[nodiscard]] StringName {\n \t\treturn (void *)_data;\n \t}\n \n-\t_FORCE_INLINE_ operator String() const {\n-\t\tif (_data) {\n-\t\t\treturn _data->name;\n-\t\t}\n+\t_FORCE_INLINE_ const String &string() const {\n+\t\t// Quick trick to avoid dereferencing unrelated memory:\n+\t\t// String is just a pointer. StringName is just a pointer.\n+\t\t// If _data is null, this is identical memory-wise to an empty String.\n+\t\tstatic_assert(sizeof(String) == sizeof(this));\n+\t\tstatic_assert(sizeof(String) == sizeof(void *));\n+\t\treturn _data ? _data->name : *reinterpret_cast<const String *>(this);","path":"core/string/string_name.h","commit_id":"e84c4f87fc0700b52829f4c1cdac5f6b387ce490","original_commit_id":"46665de3aee1a97e961f6b74304c60ba56342c75","user":{"login":"Ivorforce","id":2308167,"node_id":"MDQ6VXNlcjIzMDgxNjc=","avatar_url":"https://avatars.githubusercontent.com/u/2308167?v=4","gravatar_id":"","url":"https://api.github.com/users/Ivorforce","html_url":"https://github.com/Ivorforce","followers_url":"https://api.github.com/users/Ivorforce/followers","following_url":"https://api.github.com/users/Ivorforce/following{/other_user}","gists_url":"https://api.github.com/users/Ivorforce/gists{/gist_id}","starred_url":"https://api.github.com/users/Ivorforce/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Ivorforce/subscriptions","organizations_url":"https://api.github.com/users/Ivorforce/orgs","repos_url":"https://api.github.com/users/Ivorforce/repos","events_url":"https://api.github.com/users/Ivorforce/events{/privacy}","received_events_url":"https://api.github.com/users/Ivorforce/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"This is a performance trick I thought I might as well do while I'm at it.\