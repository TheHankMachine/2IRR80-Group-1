d_by":null},{"id":2666705648,"node_id":"MDU6TGFiZWwyNjY2NzA1NjQ4","url":"https://api.github.com/repos/godotengine/godot/labels/topic:animation","name":"topic:animation","color":"ffee88","default":false,"description":"","archived_at":null,"archived_by":null}],"state":"closed","locked":false,"assignees":[],"milestone":null,"comments":5,"created_at":"2026-02-13T13:38:15Z","updated_at":"2026-02-13T23:45:39Z","closed_at":"2026-02-13T18:53:43Z","assignee":null,"author_association":"NONE","issue_field_values":[],"type":null,"active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"### Tested versions\n\n- Reproducible on 6.1 and v4.6.1.rc1.official [7bfffc846]\n- Not reproducible on 5.1\n\n### System information\n\nGodot v4.6.1.rc1 - Pop!_OS 24.04 LTS on Wayland - X11 display driver, Multi-window, 2 monitors - OpenGL 3 (Compatibility) - NVIDIA GeForce RTX 3060 (nvidia; 580.119.02) - AMD Ryzen 7 3800X 8-Core Processor (16 threads) - 31.25 GiB memory\n\n### Issue description\n\nIf a sufficiently complicated animated model is re-imported in a certain scenario, the editor runs out of message memory and crashes.\n\n**Workaround 1:** Increase `memory/limits/message_queue/max_size_mb` from the default 32 MB to 64 MB.\n\n**Workaround 2:** Do not have the **AnimationTree** selected when the model gets imported.\n\n### Steps to reproduce\n\n1. Open the repro project.\n2. Open `scene.tscn`.\n3. Select **AnimationTree** in the **Scene** view.\n4. Right click `mdl_ash.glb` in the **FileSystem** view and press **Reimport**.\n\nIt crashes while reimporting the asset.\n\n### Minimal reproduction project (MRP)\n\n[re-import-crash.zip](https://github.com/user-attachments/files/25292387/re-import-crash.zip)","closed_by":{"login":"TokageItLab","id":61938263,"node_id":"MDQ6VXNlcjYxOTM4MjYz","avatar_url":"https://avatars.githubusercontent.com/u/61938263?v=4","gravatar_id":"","url":"https://api.github.com/users/TokageItLab","html_url":"https://github.com/TokageItLab","followers_url":"https://api.github.com/users/TokageItLab/followers","following_url":"https://api.github.com/users/TokageItLab/following{/other_user}","gists_url":"https://api.github.com/users/TokageItLab/gists{/gist_id}","starred_url":"https://api.github.com/users/TokageItLab/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/TokageItLab/subscriptions","organizations_url":"https://api.github.com/users/TokageItLab/orgs","repos_url":"https://api.github.com/users/TokageItLab/repos","events_url":"https://api.github.com/users/TokageItLab/events{/privacy}","received_events_url":"https://api.github.com/users/TokageItLab/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/116249/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/godotengine/godot/issues/116249/timeline","performed_via_github_app":null,"state_reason":"duplicate","pinned_comment":null}