ub.com/users/Saul2022","html_url":"https://github.com/Saul2022","followers_url":"https://api.github.com/users/Saul2022/followers","following_url":"https://api.github.com/users/Saul2022/following{/other_user}","gists_url":"https://api.github.com/users/Saul2022/gists{/gist_id}","starred_url":"https://api.github.com/users/Saul2022/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Saul2022/subscriptions","organizations_url":"https://api.github.com/users/Saul2022/orgs","repos_url":"https://api.github.com/users/Saul2022/repos","events_url":"https://api.github.com/users/Saul2022/events{/privacy}","received_events_url":"https://api.github.com/users/Saul2022/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-06-24T17:02:11Z","updated_at":"2025-06-24T17:02:11Z","body":"\r\n> I haven't done the mobile renderer implementation yet!\r\n\r\nik but even selecting the mobile renderer gives the same result as with forward+","author_association":"NONE","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3001226205/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3001241487","html_url":"https://github.com/godotengine/godot/pull/107923#issuecomment-3001241487","issue_url":"https://api.github.com/repos/godotengine/godot/issues/107923","id":3001241487,"node_id":"IC_kwDOAO6SJc6y40-P","user":{"login":"clayjohn","id":16521339,"node_id":"MDQ6VXNlcjE2NTIxMzM5","avatar_url":"https://avatars.githubusercontent.com/u/16521339?v=4","gravatar_id":"","url":"https://api.github.com/users/clayjohn","html_url":"https://github.com/clayjohn","followers_url":"https://api.github.com/users/clayjohn/followers","following_url":"https://api.github.com/users/clayjohn/following{/other_user}","gists_url":"https://api.github.com/users/clayjohn/gists{/gist_id}","starred_url":"https://api.github.com/users/clayjohn/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/clayjohn/subscriptions","organizations_url":"https://api.github.com/users/clayjohn/orgs","repos_url":"https://api.github.com/users/clayjohn/repos","events_url":"https://api.github.com/users/clayjohn/events{/privacy}","received_events_url":"https://api.github.com/users/clayjohn/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-06-24T17:07:50Z","updated_at":"2025-06-24T17:07:50Z","body":"> > I haven't done the mobile renderer implementation yet!\r\n> \r\n> ik but even selecting the mobile renderer gives the same result as with forward+\r\n\r\nOh alright, I'll make sure to test on Android before marking this as ready for review. ","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3001241487/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3025334182","html_url":"https://github.com/godotengine/godot/pull/107923#issuecomment-3025334182","issue_url":"https://api.github.com/repos/godotengine/godot/issues/107923","id":3025334182,"node_id":"IC_kwDOAO6SJc60Uu-m","user":{"login":"clayjohn","id":16521339,"node_id":"MDQ6VXNlcjE2NTIxMzM5","avatar_url":"https://avatars.githubusercontent.com/u/16521339?v=4","gravatar_id":"","url":"https://api.github.com/users/clayjohn","html_url":"https://github.com/clayjohn","followers_url":"https://api.github.com/users/clayjohn/followers","following_url":"https://api.github.com/users/clayjohn/following{/other_user}","gists_url":"https://api.github.com/users/clayjohn/gists{/gist_id}","starred_url":"https://api.github.com/users/clayjohn/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/clayjohn/subscriptions","organizations_url":"https://api.github.com/users/clayjohn/orgs","repos_url":"https://api.github.com/users/clayjohn/repos","events_url":"https://api.github.com/users/clayjohn/events{/privacy}","received_events_url":"https://api.github.com/users/clayjohn/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-07-01T19:59:15Z","updated_at":"2025-07-01T19:59:15Z","body":"Tested now on MacOS, PopOS, and Android. \r\n\r\nOn my M2 macbook, I can't measure a difference. \r\n\r\nOn my Intel integrated GPU I get a consistent 5%ish improvement in the test scene from https://github.com/godotengine/godot/issues/68959. I get similar results on my Pixel 7 (Mali-G710) and pixel 4 (Adreno 640)\r\n\r\nOn other scenes more broadly I suspect the average performance benefit will be lower than 5% since the bottlenecks are often fragment processing and this does little to help with that. But at any rate, this is a free improvement to performance (in some cases) and battery life in all cases","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3025334182/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3025335841","html_url":"https://github.com/godotengine/godot/pull/107923#issuecomment-3025335841","issue_url":"https://api.github.com/repos/godotengine/godot/issues/107923","id":3025335841,"node_id":"IC_kwDOAO6SJc60UvYh","user":{"login":"clayjohn","id":16521339,"node_id":"MDQ6VXNlcjE2NTIxMzM5","avatar_url":"https://avatars.githubusercontent.com/u/16521339?v=4","gravatar_id":"","url":"https://api.github.com/users/clayjohn","html_url":"https://github.com/clayjohn","followers_url":"https://api.github.com/users/clayjohn/followers","following_url":"https://api.github.com/users/clayjohn/following{/other_user}","gists_url":"https://api.github.com/users/clayjohn/gists{/gist_id}","starred_url":"https://api.github.com/users/clayjohn/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/clayjohn/subscriptions","organizations_url":"https://api.github.com/users/clayjohn/orgs","repos_url":"https://api.github.com/users/clayjohn/repos","events_url":"https://api.github.com/users/clayjohn/events{/privacy}","received_events_url":"https://api.github.com/users/clayjohn/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-07-01T19:59:55Z","updated_at":"2025-07-01T19:59:55Z","body":"Tagging this for 4.6 dev 1. It should be a pretty safe change, but it is a little risky for the Beta cycle","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3025335841/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3090565791","html_url":"https://github.com/godotengine/godot/pull/107923#issuecomment-3090565791","issue_url":"https://api.github.com/repos/godotengine/godot/issues/107923","id":3090565791,"node_id":"IC_kwDOAO6SJc64Nkqf","user":{"login":"Gaktan","id":1674095,"node_id":"MDQ6VXNlcjE2NzQwOTU=","avatar_url":"https://avatars.githubusercontent.com/u/1674095?v=4","gravatar_id":"","url":"https://api.github.com/users/Gaktan","html_url":"https://github.com/Gaktan","followers_url":"https://api.github.com/users/Gaktan/followers","following_url":"https://api.github.com/users/Gaktan/following{/other_user}","gists_url":"https://api.github.com/users/Gaktan/gists{/gist_id}","starred_url":"https://api.github.com/users/Gaktan/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Gaktan/subscriptions","organizations_url":"https://api.github.com/users/Gaktan/orgs","repos_url":"https://api.github.com/users/Gaktan/repos","events_url":"https://api.github.com/users/Gaktan/events{/privacy}","received_events_url":"https://api.github.com/users/Gaktan/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-07-18T19:53:43Z","updated_at":"2025-07-18T19:53:43Z","body":"You can save some padding by using a mat4x3 instead.\r\n\r\nThe register count should be the same, but the instruction count should be a bit lower (fewer loads).\r\n\r\nMatrices need to be transposed when filling the constant buffer on the CPU, and multiplication order needs to be swapped in glsl.","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3090565791/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3095706996","html_url":"https://github.com/godotengine/godot/pull/107923#issuecomment-3095706996","issue_url":"https://api.github.com/repos/godotengine/godot/issues/107923","id":3095706996,"node_id":"IC_kwDOAO6SJc64hL10","user":{"login":"clayjohn","id":16521339,"node_id":"MDQ6VXNlcjE2NTIxMzM5","avatar_url":"https://avatars.githubusercontent.com/u/16521339?v=4","gravatar_id":"","url":"https://api.github.com/users/clayjohn","html_url":"https://github.com/clayjohn","followers_url":"https://api.github.com/users/clayjohn/followers","following_url":"https://api.github.com/users/clayjohn/following{/other_user}","gists_url":"https://api.github.com/users/clayjohn/gists{/gist_id}","starred_url":"https://api.github.com/users/clayjohn/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/clayjohn/subscriptions","organizations_url":"https://api.github.com/users/clayjohn/orgs","repos_url":"https://api.github.com/users/clayjohn/repos","events_url":"https://api.github.com/users/clayjohn/events{/privacy}","received_events_url":"https://api.github.com/users/clayjohn/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-07-21T08:24:53Z","updated_at":"2025-07-21T08:25:53Z","body":"@Gaktan You have it backwards. `mat4x3` stores 4 `vec3` so it requires 4 floats of padding (which will be inserted automatically). `mat3x4` stores 3 `vec4` so there is no padding. \r\n\r\n`mat3x4` unfortunately thus requires doing a `transpose` operation in the shader which costs a few extra cycles. But is worth it because we save more cycles on the multiplication _and_ we save the bandwidth as well. \r\n\r\nI have tested this code in a compiler and reviewed the disassembly and confirmed that reduces load ops, instructions, and results in a reduced bandwidth usage. ","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3095706996/reactions","total_count":2,"+1":2,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3097623176","html_url":"https://github.com/godotengine/godot/pull/107923#issuecomment-3097623176","issue_url":"https://api.github.com/repos/godotengine/godot/issues/107923","id":3097623176,"node_id":"IC_kwDOAO6SJc64ofqI","user":{"login":"Gaktan","id":1674095,"node_id":"MDQ6VXNlcjE2NzQwOTU=","avatar_url":"https://avatars.githubusercontent.com/u/1674095?v=4","gravatar_id":"","url":"https://api.github.com/users/Gaktan","html_url":"https://github.com/Gaktan","followers_url":"https://api.github.com/users/Gaktan/followers","following_url":"https://api.github.com/users/Gaktan/following{/other_user}","gists_url":"https://api.github.com/users/Gaktan/gists{/gist_id}","starred_url":"https://api.github.com/users/Gaktan/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Gaktan/subscriptions","organizations_url":"https://api.github.com/users/Gaktan/orgs","repos_url":"https://api.github.com/users/Gaktan/repos","events_url":"https://api.github.com/users/Gaktan/events{/privacy}","received_events_url":"https://api.github.com/users/Gaktan/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-07-21T17:06:18Z","updated_at":"2025-07-21T17:06:18Z","body":"> @Gaktan You have it backwards. `mat4x3` stores 4 `vec3` so it requires 4 floats of padding (which will be inserted automatically). `mat3x4` stores 3 `vec4` so there is no padding.\r\n\r\nGot it, my bad. I assumed it was the same as HLSL.\r\n\r\nThe `transpose()` is not necessary as you can just swap the multiplication order. But either way it should be free, since a transpose is just a register shuffle.","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3097623176/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3106497850","html_url":"https://github.com/godotengine/godot/pull/107923#issuecomment-3106497850","issue_url":"https://api.github.com/repos/godotengine/godot/issues/107923","id":3106497850,"node_id":"IC_kwDOAO6SJc65KWU6","user":{"login":"clayjohn","id":16521339,"node_id":"MDQ6VXNlcjE2NTIxMzM5","avatar_url":"https://avatars.githubusercontent.com/u/16521339?v=4","gravatar_id":"","url":"https://api.github.com/users/clayjohn","html_url":"https://github.com/clayjohn","followers_url":"https://api.github.com/users/clayjohn/followers","following_url":"https://api.github.com/users/clayjohn/following{/other_user}","gists_url":"https://api.github.com/users/clayjohn/gists{/gist_id}","starred_url":"https://api.github.com/users/clayjohn/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/clayjohn/subscriptions","organizations_url":"https://api.github.com/users/clayjohn/orgs","repos_url":"https://api.github.com/users/clayjohn/repos","events_url":"https://api.github.com/users/clayjohn/events{/privacy}","received_events_url":"https://api.github.com/users/clayjohn/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-07-23T08:29:31Z","updated_at":"2025-07-23T08:29:31Z","body":"> The `transpose()` is not necessary as you can just swap the multiplication order. But either way it should be free, since a transpose is just a register shuffle.\r\n\r\nI can't swap the multiplication order in user code 🙃 ","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3106497850/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3354131299","html_url":"https://github.com/godotengine/godot/pull/107923#issuecomment-3354131299","issue_url":"https://api.github.com/repos/godotengine/godot/issues/107923","id":3354131299,"node_id":"IC_kwDOAO6SJc7H6_tj","user":{"login":"Repiteo","id":17489292,"node_id":"MDQ6VXNlcjE3NDg5Mjky","avatar_url":"https://avatars.githubusercontent.com/u/17489292?v=4","gravatar_id":"","url":"https://api.github.com/users/Repiteo","html_url":"https://github.com/Repiteo","followers_url":"https://api.github.com/users/Repiteo/followers","following_url":"https://api.github.com/users/Repiteo/following{/other_user}","gists_url":"https://api.github.com/users/Repiteo/gists{/gist_id}","starred_url":"https://api.github.com/users/Repiteo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Repiteo/subscriptions","organizations_url":"https://api.github.com/users/Repiteo/orgs","repos_url":"https://api.github.com/users/Repiteo/repos","events_url":"https://api.github.com/users/Repiteo/events{/privacy}","received_events_url":"https://api.github.com/users/Repiteo/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-09-30T23:39:51Z","updated_at":"2025-09-30T23:39:51Z","body":"Thanks!","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3354131299/reactions","total_count":1,"+1":0,"-1":0,"laugh":0,"hooray":1,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null}]