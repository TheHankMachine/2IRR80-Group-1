es":[],"milestone":{"url":"https://api.github.com/repos/godotengine/godot/milestones/25","html_url":"https://github.com/godotengine/godot/milestone/25","labels_url":"https://api.github.com/repos/godotengine/godot/milestones/25/labels","id":15520464,"node_id":"MI_kwDOAO6SJc4A7NLQ","number":25,"title":"4.8","description":"","creator":{"login":"Repiteo","id":17489292,"node_id":"MDQ6VXNlcjE3NDg5Mjky","avatar_url":"https://avatars.githubusercontent.com/u/17489292?v=4","gravatar_id":"","url":"https://api.github.com/users/Repiteo","html_url":"https://github.com/Repiteo","followers_url":"https://api.github.com/users/Repiteo/followers","following_url":"https://api.github.com/users/Repiteo/following{/other_user}","gists_url":"https://api.github.com/users/Repiteo/gists{/gist_id}","starred_url":"https://api.github.com/users/Repiteo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Repiteo/subscriptions","organizations_url":"https://api.github.com/users/Repiteo/orgs","repos_url":"https://api.github.com/users/Repiteo/repos","events_url":"https://api.github.com/users/Repiteo/events{/privacy}","received_events_url":"https://api.github.com/users/Repiteo/received_events","type":"User","user_view_type":"public","site_admin":false},"open_issues":343,"closed_issues":2335,"state":"open","created_at":"2026-04-13T15:59:35Z","updated_at":"2026-10-22T06:28:22Z","due_on":null,"closed_at":null},"comments":2,"created_at":"2026-08-04T18:29:48Z","updated_at":"2026-09-18T16:19:25Z","closed_at":"2026-08-05T14:52:34Z","assignee":null,"author_association":"NONE","issue_field_values":[],"type":null,"active_lock_reason":null,"draft":false,"pull_request":{"url":"https://api.github.com/repos/godotengine/godot/pulls/122098","html_url":"https://github.com/godotengine/godot/pull/122098","diff_url":"https://github.com/godotengine/godot/pull/122098.diff","patch_url":"https://github.com/godotengine/godot/pull/122098.patch","merged_at":"2026-08-05T14:52:34Z"},"body":"## What problem(s) does this PR solve?\r\n`OpenXRUtil::string_from_xruuid` was generating the wrong hexadecimal string from `XrUuid`, due to `>>` having higher precedence than `&`.\r\n\r\nIn particular, this:\r\n```c++\r\nchar a = xr_uuid.data[i] & 0xF0 >> 4;\r\nchar b = xr_uuid.data[i] & 0x0F;\r\n```\r\n\r\nIs equivalent to\r\n```c++\r\nchar a = xr_uuid.data[i] & 0x0F;\r\nchar b = xr_uuid.data[i] & 0x0F;\r\n```\r\n\r\nThis would result in the hexadecimal string appearing to duplicate the last 4 bits of each 8 bit number.\r\nFor example, the base 10 value of `33` would incorrectly become `0x11` (`33` is `0x21`)\r\n\r\nThis PR adds parenthesis so that `&` is evaluated before `>>`","closed_by":{"login":"Repiteo","id":17489292,"node_id":"MDQ6VXNlcjE3NDg5Mjky","avatar_url":"https://avatars.githubusercontent.com/u/17489292?v=4","gravatar_id":"","url":"https://api.github.com/users/Repiteo","html_url":"https://github.com/Repiteo","followers_url":"https://api.github.com/users/Repiteo/followers","following_url":"https://api.github.com/users/Repiteo/following{/other_user}","gists_url":"https://api.github.com/users/Repiteo/gists{/gist_id}","starred_url":"https://api.github.com/users/Repiteo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Repiteo/subscriptions","organizations_url":"https://api.github.com/users/Repiteo/orgs","repos_url":"https://api.github.com/users/Repiteo/repos","events_url":"https://api.github.com/users/Repiteo/events{/privacy}","received_events_url":"https://api.github.com/users/Repiteo/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/122098/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/godotengine/godot/issues/122098/timeline","performed_via_github_app":null,"state_reason":null}