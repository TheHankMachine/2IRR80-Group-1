s should give us the best performance. ","created_at":"2024-12-14T00:31:55Z","updated_at":"2024-12-14T00:54:55Z","html_url":"https://github.com/godotengine/godot/pull/100283#discussion_r1884677637","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/100283","_links":{"self":{"href":"https://api.github.com/repos/godotengine/godot/pulls/comments/1884677637"},"html":{"href":"https://github.com/godotengine/godot/pull/100283#discussion_r1884677637"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/100283"}},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/1884677637/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":1128,"original_line":1128,"side":"RIGHT","author_association":"MEMBER","original_position":71,"position":71,"subject_type":"line"},{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/1884687014","pull_request_review_id":2503409465,"id":1884687014,"node_id":"PRRC_kwDOAO6SJc5wVgqm","diff_hunk":"@@ -1830,4 +1992,12 @@ void main() {\n #endif //MODE_MULTIPLE_RENDER_TARGETS\n \n #endif //MODE_RENDER_DEPTH\n+\n+#ifdef MODE_RENDER_MOTION_VECTORS\n+\tvec3 ndc = screen_position.xyz / screen_position.w;\n+\tndc.y = -ndc.y;\n+\tvec3 prev_ndc = prev_screen_position.xyz / prev_screen_position.w;","path":"servers/rendering/renderer_rd/shaders/forward_mobile/scene_forward_mobile.glsl","commit_id":"3b70fbdc3cd0fea0e8c3de193ab6c8db2d37049b","original_commit_id":"28185a911beab7e7ac1b15151a9dfb1c7727e956","user":{"login":"clayjohn","id":16521339,"node_id":"MDQ6VXNlcjE2NTIxMzM5","avatar_url":"https://avatars.githubusercontent.com/u/16521339?v=4","gravatar_id":"","url":"https://api.github.com/users/clayjohn","html_url":"https://github.com/clayjohn","followers_url":"https://api.github.com/users/clayjohn/followers","following_url":"https://api.github.com/users/c