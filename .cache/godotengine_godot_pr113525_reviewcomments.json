repos/godotengine/godot/pulls/113525","_links":{"self":{"href":"https://api.github.com/repos/godotengine/godot/pulls/comments/2586556129"},"html":{"href":"https://github.com/godotengine/godot/pull/113525#discussion_r2586556129"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/113525"}},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/2586556129/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":null,"original_line":111,"side":"RIGHT","author_association":"MEMBER","original_position":34,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/2586574376","pull_request_review_id":3536858334,"id":2586574376,"node_id":"PRRC_kwDOAO6SJc6aK_4o","diff_hunk":"@@ -164,46 +173,43 @@ class CommandQueueMT {\n \t\t\treturn;\n \t\t}\n \n-\t\tchar cmd_backup[MAX_COMMAND_SIZE];\n+\t\tchar cmd_copy_mem[MAX_COMMAND_SIZE];\n \n \t\twhile (flush_read_ptr < command_mem.size()) {\n \t\t\tuint64_t size = *(uint64_t *)&command_mem[flush_read_ptr];\n \t\t\tflush_read_ptr += sizeof(uint64_t);\n \n-\t\t\tCommandBase *cmd = reinterpret_cast<CommandBase *>(&command_mem[flush_read_ptr]);\n-\n \t\t\t// Protect against race condition between this thread\n \t\t\t// during the call to the command and other threads potentially\n \t\t\t// invalidating the pointer due to reallocs.\n-\t\t\tmemcpy(cmd_backup, (char *)cmd, size);\n+\t\t\tCommandBase *cmd_copy;\n+\t\t\t{\n+\t\t\t\tCommandBase *cmd = reinterpret_cast<CommandBase *>(&command_mem[flush_read_ptr]);\n+\t\t\t\tcmd_copy = cmd->move_to(&cmd_copy_mem);\n+\t\t\t\tcmd->~CommandBase();","path":"core/templates/command_queue_mt.h","commit_id":"67de6b6778a0790fee903024069b922178ea02b7","original_commit_id":"67de6b6778a0790fee903024069b922178ea02b7","user":{"login":"Ivorforce","id":2308167,"node_id":"MDQ6VXNlcjIzMDgxNjc=","avatar_url":"https://avatars.githubusercontent.com/u/2308167?v=4","gravatar_id":"","url":"https://api.github.com/users/Ivorforce","html_url":"https://github.com/Ivorforce","followers_url":"https://api.github.com/users/Ivorforce/followers","following_url":"https://api.github.com/users/Ivorforce/following{/other_user}","gists_url":"https://api.github.com/users/Ivorforce/gists{/gist_id}","starred_url":"https://api.github.com/users/Ivorforce/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Ivorforce/subscriptions","organizations_url":"https://api.github.com/users/Ivorforce/orgs","repos_url":"https://api.github.com/users/Ivorforce/repos","events_url":"https://api.github.com/users/Ivorforce/events{/privacy}","received_events_url":"https://api.github.com/users/Ivorforce/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"If you're just using `std::move`, and then calling the destructor, that means any access of `command_mem` as `CommandBase *` is now invalid (because the destructor has already been called).\n\nIn this case, you might as well use relocation semantics (call `memcpy` and don't call the destructor). Which would put us back to where we started.\n\nCan you explain why changing to move semantics here should help if `command_mem` is never accessed as `CommandBase *` after this anyway?","created_at":"2025-12-03T20:51:21Z","updated_at":"2025-12-03T20:51:25Z","html_url":"https://github.com/godotengine/godot/pull/113525#discussion_r2586574376","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/113525","_links":{"self":{"href":"https://api.github.com/repos/godotengine/godot/pulls/comments/2586574376"},"html":{"href":"https://github.com/godotengine/godot/pull/113525#discussion_r2586574376"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/113525"}},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/2586574376/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":187,"start_side":"RIGHT","line":null,"original_line":189,"side":"RIGHT","author_association":"MEMBER","original_position":60,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/2586716006","pull_request_review_id":3537060817,"id":2586716006,"node_id":"PRRC_kwDOAO6SJc6aLidm","diff_hunk":"@@ -164,46 +173,43 @@ class CommandQueueMT {\n \t\t\treturn;\n \t\t}\n \n-\t\tchar cmd_backup[MAX_COMMAND_SIZE];\n+\t\tchar cmd_copy_mem[MAX_COMMAND_SIZE];\n \n \t\twhile (flush_read_ptr < command_mem.size()) {\n \t\t\tuint64_t size = *(uint64_t *)&command_mem[flush_read_ptr];\n \t\t\tflush_read_ptr += sizeof(uint64_t);\n \n-\t\t\tCommandBase *cmd = reinterpret_cast<CommandBase *>(&command_mem[flush_read_ptr]);\n-\n \t\t\t// Protect against race condition between this thread\n \t\t\t// during the call to the command and other threads potentially\n \t\t\t// invalidating the pointer due to reallocs.\n-\t\t\tmemcpy(cmd_backup, (char *)cmd, size);\n+\t\t\tCommandBase *cmd_copy;\n+\t\t\t{\n+\t\t\t\tCommandBase *cmd = reinterpret_cast<CommandBase *>(&command_mem[flush_read_ptr]);\n+\t\t\t\tcmd_copy = cmd->move_to(&cmd_copy_mem);\n+\t\t\t\tcmd->~CommandBase();","path":"core/templates/command_queue_mt.h","commit_id":"67de6b6778a0790fee903024069b922178ea02b7","original_commit_id":"67de6b6778a0790fee903024069b922178ea02b7","user":{"login":"brycehutchings","id":5100250,"node_id":"MDQ6VXNlcjUxMDAyNTA=","avatar_url":"https://avatars.githubusercontent.com/u/5100250?v=4","gravatar_id":"","url":"https://api.github.com/users/brycehutchings","html_url":"https://github.com/brycehutchings","followers_url":"https://api.github.com/users/brycehutchings/followers","following_url":"https://api.github.com/users/brycehutchings/following{/other_user}","gists_url":"https://api.github.com/users/brycehutchings/gists{/gist_id}","starred_url":"https://api.github.com/users/brycehutchings/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/brycehutchings/subscriptions","organizations_url":"https://api.github.com/users/brycehutchings/orgs","repos_url":"https://api.github.com/users/brycehutchings/repos","events_url":"https://api.github.com/users/brycehutchings/events{/privacy}","received_events_url":"https://api.github.com/users/brycehutchings/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"From what I understood, only \"trivially copyable\" types can be memcpy'd safely according to C++ standard. See https://en.cppreference.com/w/cpp/types/is_trivially_copyable.html:\r\n\r\n> Objects of trivially-copyable types that are not potentially-overlapping subobjects are the only C++ objects that may be safely copied with [std::memcpy](https://en.cppreference.com/w/cpp/string/byte/memcpy.html) [...]\r\n\r\nSince command_queue_mt is handling non-trivially copyable types, I didn't think any solution that involves memcpy is technically correct. I can imagine a C++ object that would not work correctly with memcpy (imagine one that has a member field that points to another member field. after a memcpy, that pointer will still point to the old location and not the new location). So I wanted to make a fix that stayed away from \"undefined behavior\" territory. \r\n\r\nHowever, in researching things to reply here, I see that it looks like Godot uses `realloc` which I would not have considered safe with C++ types since it's essentially doing a memcpy under the hood. So I am wondering if Godot types are generally written in a way that allows for memcpy to work in practice?\r\n\r\nAll that to say, I think what you say is in line with how Godot is written and I can change this to memcpy and not destroy the original copy.","created_at":"2025-12-03T21:47:02Z","updated_at":"2025-12-03T21:47:02Z","html_url":"https://github.com/godotengine/godot/pull/113525#discussion_r2586716006","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/113525","_links":{"self":{"href":"https://api.github.com/repos/godotengine/godot/pulls/comments/2586716006"},"html":{"href":"https://github.com/godotengine/godot/pull/113525#discussion_r2586716006"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/113525"}},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/2586716006/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":187,"start_side":"RIGHT","line":null,"original_line":189,"side":"RIGHT","in_reply_to_id":2586574376,"author_association":"CONTRIBUTOR","original_position":60,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/2586724710","pull_request_review_id":3537075388,"id":2586724710,"node_id":"PRRC_kwDOAO6SJc6aLklm","diff_hunk":"@@ -164,46 +173,43 @@ class CommandQueueMT {\n \t\t\treturn;\n \t\t}\n \n-\t\tchar cmd_backup[MAX_COMMAND_SIZE];\n+\t\tchar cmd_copy_mem[MAX_COMMAND_SIZE];\n \n \t\twhile (flush_read_ptr < command_mem.size()) {\n \t\t\tuint64_t size = *(uint64_t *)&command_mem[flush_read_ptr];\n \t\t\tflush_read_ptr += sizeof(uint64_t);\n \n-\t\t\tCommandBase *cmd = reinterpret_cast<CommandBase *>(&command_mem[flush_read_ptr]);\n-\n \t\t\t// Protect against race condition between this thread\n \t\t\t// during the call to the command and other threads potentially\n \t\t\t// invalidating the pointer due to reallocs.\n-\t\t\tmemcpy(cmd_backup, (char *)cmd, size);\n+\t\t\tCommandBase *cmd_copy;\n+\t\t\t{\n+\t\t\t\tCommandBase *cmd = reinterpret_cast<CommandBase *>(&command_mem[flush_read_ptr]);\n+\t\t\t\tcmd_copy = cmd->move_to(&cmd_copy_mem);\n+\t\t\t\tcmd->~CommandBase();","path":"core/templates/command_queue_mt.h","commit_id":"67de6b6778a0790fee903024069b922178ea02b7","original_commit_id":"67de6b6778a0790fee903024069b922178ea02b7","user":{"login":"Ivorforce","id":2308167,"node_id":"MDQ6VXNlcjIzMDgxNjc=","avatar_url":"https://avatars.githubusercontent.com/u/2308167?v=4","gravatar_id":"","url":"https://api.github.com/users/Ivorforce","html_url":"https://github.com/Ivorforce","followers_url":"https://api.github.com/users/Ivorforce/followers","following_url":"https://api.github.com/users/Ivorforce/following{/other_user}","gists_url":"https://api.github.com/users/Ivorforce/gists{/gist_id}","starred_url":"https://api.github.com/users/Ivorforce/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Ivorforce/subscriptions","organizations_url":"https://api.github.com/users/Ivorforce/orgs","repos_url":"https://api.github.com/users/Ivorforce/repos","events_url":"https://api.github.com/users/Ivorforce/events{/privacy}","received_events_url":"https://api.github.com/users/Ivorforce/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"> From what I understood, only \"trivially copyable\" types can be memcpy'd safely according to C++ standard. See https://en.cppreference.com/w/cpp/types/is_trivially_copyable.html:\r\n\r\nThis isn't totally true. Another use-case for `memcpy` is [trivial relocation](https://open-std.org/JTC1/SC22/WG21/docs/papers/2020/p1144r5.html), a concept that has only recently been formalized.\r\n\r\nFor Godot, we have made the decision to assume all (non-heap) objects must be trivially relocatable to make use of `memcpy` for improved speed (see https://github.com/godotengine/godot/issues/100509).","created_at":"2025-12-03T21:50:23Z","updated_at":"2025-12-03T21:50:23Z","html_url":"https://github.com/godotengine/godot/pull/113525#discussion_r2586724710","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/113525","_links":{"self":{"href":"https://api.github.com/repos/godotengine/godot/pulls/comments/2586724710"},"html":{"href":"https://github.com/godotengine/godot/pull/113525#discussion_r2586724710"},"pull_requ