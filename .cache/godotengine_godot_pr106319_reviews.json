://api.github.com/users/adamscott/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"","state":"COMMENTED","html_url":"https://github.com/godotengine/godot/pull/106319#pullrequestreview-2834601511","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/106319","author_association":"MEMBER","_links":{"html":{"href":"https://github.com/godotengine/godot/pull/106319#pullrequestreview-2834601511"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/106319"}},"submitted_at":"2025-05-12T21:17:12Z","commit_id":null},{"id":2836365995,"node_id":"PRR_kwDOAO6SJc6pD4Kr","user":{"login":"adamscott","id":270928,"node_id":"MDQ6VXNlcjI3MDkyOA==","avatar_url":"https://avatars.githubusercontent.com/u/270928?u=a5fd9a203c90bd196083e33bbf0e21324e8c68f8&v=4","gravatar_id":"","url":"https://api.github.com/users/adamscott","html_url":"https://github.com/adamscott","followers_url":"https://api.github.com/users/adamscott/followers","following_url":"https://api.github.com/users/adamscott/following{/other_user}","gists_url":"https://api.github.com/users/adamscott/gists{/gist_id}","starred_url":"https://api.github.com/users/adamscott/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/adamscott/subscriptions","organizations_url":"https://api.github.com/users/adamscott/orgs","repos_url":"https://api.github.com/users/adamscott/repos","events_url":"https://api.github.com/users/adamscott/events{/privacy}","received_events_url":"https://api.github.com/users/adamscott/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"","state":"COMMENTED","html_url":"https://github.com/godotengine/godot/pull/106319#pullrequestreview-2836365995","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/106319","author_association":"MEMBER","_links":{"html":{"href":"https://github.com/godotengine/godot/pull/106319#pullrequestreview-2836365995"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/106319"}},"submitted_at":"2025-05-13T11:31:30Z","commit_id":null},{"id":2837288612,"node_id":"PRR_kwDOAO6SJc6pHZak","user":{"login":"Calinou","id":180032,"node_id":"MDQ6VXNlcjE4MDAzMg==","avatar_url":"https://avatars.githubusercontent.com/u/180032?u=68d23e7ee9cdf810da125e8510b72f845b9dccc8&v=4","gravatar_id":"","url":"https://api.github.com/users/Calinou","html_url":"https://github.com/Calinou","followers_url":"https://api.github.com/users/Calinou/followers","following_url":"https://api.github.com/users/Calinou/following{/other_user}","gists_url":"https://api.github.com/users/Calinou/gists{/gist_id}","starred_url":"https://api.github.com/users/Calinou/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Calinou/subscriptions","organizations_url":"https://api.github.com/users/Calinou/orgs","repos_url":"https://api.github.com/users/Calinou/repos","events_url":"https://api.github.com/users/Calinou/events{/privacy}","received_events_url":"https://api.github.com/users/Calinou/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"Tested locally, it works as expected. Code looks good to me.\r\n\r\n## Benchmark\r\n\r\n<details open>\r\n\r\n<summary>PC specifications</summary>\r\n\r\n- **CPU:** Intel Core i9-13900K\r\n- **GPU:** NVIDIA GeForce RTX 4090\r\n- **RAM:** 64 GB (2×32 GB DDR5-5800 C30)\r\n- **SSD:** Solidigm P44 Pro 2 TB\r\n- **OS:** Linux (Fedora 42)\r\n</details>\r\n\r\nUsing 480 Hz V-Sync so that we don't hit any framerate cap in either browser. Monitor resolution is limited to 1080p with this mode, so we are far from being GPU-bottlenecked here.\r\n\r\nI waited 30 seconds for the framerate to settle after clicking buttons to add barrels.\r\n\r\n### Firefox 138\r\n\r\n#### \"+ 100 barrels\" clicked 3 times\r\n\r\nBefore | After\r\n-|-\r\n![Screenshot_20250513_172553](https://github.com/user-attachments/assets/051b322c-1ceb-4032-ad59-fc7f4303930e) | ![Screenshot_20250513_172644](https://github.com/user-attachments/assets/f3ec529f-42fe-4b9e-bce9-5642aa5b7e3c)\r\n\r\n#### \"+ 100 barrels\" clicked 6 times\r\n\r\n*We start to hit a \"physics spiral of death\" situation with SIMD disabled here, which is why performance plummets.*\r\n\r\nBefore | After\r\n-|-\r\n![Screenshot_20250513_172351](https://github.com/user-attachments/assets/d2a77328-1283-4abc-b56d-16c4424e9071) | ![Screenshot_20250513_172619](https://github.com/user-attachments/assets/3a398931-d5e4-43e2-b333-78c24e8f19f3)\r\n\r\n### Chromium 134\r\n\r\n#### \"+ 100 barrels\" clicked 3 times\r\n\r\nBefore | After\r\n-|-\r\n![Screenshot_20250513_172158](https://github.com/user-attachments/assets/785e45eb-8ccd-4af7-9b0b-60368e3bffcf) | ![Screenshot_20250513_172256](https://github.com/user-attachments/assets/5ef8a4b6-35e7-4888-ac56-cfed75a9a557)\r\n\r\n#### \"+ 100 barrels\" clicked 6 times\r\n\r\n*We start to hit a \"physics spiral of death\" situation with SIMD disabled here, which is why performance plummets.*\r\n\r\nBefore | After\r\n-|-\r\n![Screenshot_20250513_172126](https://github.com/user-attachments/assets/b18f98b0-db4a-4feb-8f2f-92cc81f2cb5b) | ![Screenshot_20250513_172241](https://github.com/user-attachments/assets/4445fc10-6966-42b3-b3fc-98803f9f80b1)\r\n\r\n### Binary size\r\n\r\nThe binary is 130 KB larger with SIMD enabled, but it compresses to a smaller size (-210 KB), so it's actually a tad faster to download.\r\n\r\n#### Without SIMD\r\n\r\n![image](https://github.com/user-attachments/assets/aa10b47e-984e-43cc-8264-9bbdd64e7d0a)\r\n\r\n#### With SIMD\r\n\r\n![image](https://github.com/user-attachments/assets/79536c22-d466-4d1d-a36c-74be2ffec27e)\r\n","state":"APPROVED","html_url":"https://github.com/godotengine/godot/pull/106319#pullrequestreview-2837288612","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/106319","author_association":"MEMBER","_links":{"html":{"href":"https://github.com/godotengine/godot/pull/106319#pullrequestrev