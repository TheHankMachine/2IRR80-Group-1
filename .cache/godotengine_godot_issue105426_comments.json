hub.com/repos/godotengine/godot/issues/comments/2807192466/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2807199858","html_url":"https://github.com/godotengine/godot/pull/105426#issuecomment-2807199858","issue_url":"https://api.github.com/repos/godotengine/godot/issues/105426","id":2807199858,"node_id":"IC_kwDOAO6SJc6nUnhy","user":{"login":"hidemat","id":6559151,"node_id":"MDQ6VXNlcjY1NTkxNTE=","avatar_url":"https://avatars.githubusercontent.com/u/6559151?v=4","gravatar_id":"","url":"https://api.github.com/users/hidemat","html_url":"https://github.com/hidemat","followers_url":"https://api.github.com/users/hidemat/followers","following_url":"https://api.github.com/users/hidemat/following{/other_user}","gists_url":"https://api.github.com/users/hidemat/gists{/gist_id}","starred_url":"https://api.github.com/users/hidemat/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/hidemat/subscriptions","organizations_url":"https://api.github.com/users/hidemat/orgs","repos_url":"https://api.github.com/users/hidemat/repos","events_url":"https://api.github.com/users/hidemat/events{/privacy}","received_events_url":"https://api.github.com/users/hidemat/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-04-15T19:01:54Z","updated_at":"2025-04-15T19:04:20Z","body":"I understand that, but this issue is still the same `Viewport.set_input_as_handled()` is confusing by itself. I had to research elsewhere to figure that out. Shouldn't the docs be clear enough to where we don't need to look elsewhere?\r\n\r\n> If absolutely needed, this example probably belongs more in Viewport's set_input_as_handled.\r\n\r\nWould it be ok if I just do this?","author_association":"NONE","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comme