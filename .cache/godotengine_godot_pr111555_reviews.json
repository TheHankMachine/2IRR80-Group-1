[{"id":3328832101,"node_id":"PRR_kwDOAO6SJc7GafJl","user":{"login":"Ivorforce","id":2308167,"node_id":"MDQ6VXNlcjIzMDgxNjc=","avatar_url":"https://avatars.githubusercontent.com/u/2308167?u=f7f8e0273f784f5ec6f6b7fe4a88d449896eb48a&v=4","gravatar_id":"","url":"https://api.github.com/users/Ivorforce","html_url":"https://github.com/Ivorforce","followers_url":"https://api.github.com/users/Ivorforce/followers","following_url":"https://api.github.com/users/Ivorforce/following{/other_user}","gists_url":"https://api.github.com/users/Ivorforce/gists{/gist_id}","starred_url":"https://api.github.com/users/Ivorforce/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Ivorforce/subscriptions","organizations_url":"https://api.github.com/users/Ivorforce/orgs","repos_url":"https://api.github.com/users/Ivorforce/repos","events_url":"https://api.github.com/users/Ivorforce/events{/privacy}","received_events_url":"https://api.github.com/users/Ivorforce/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"Looks generally good to me.\r\nAs akien mentioned, this likely won't have a large effect on compile time, since the include is only removed in 4 isolated compile units. But it's a nice and safe improvement, and it's good practice to not include anything that isn't explicitly needed.\r\n\r\nOne thing, I don't think the `STATIC_ASSERT_INCOMPLETE_TYPE` are needed. The macro is designed to prevent regressions of includes added to the associated _header_ files. Since the headers haven't included `ClassDB` before, and are unlikely to do so accidentally in the future, I don't think we need to protect ourselves from this explicitly.","state":"COMMENTED","html_url":"https://github.com/godotengine/godot/pull/111555#pullrequestreview-3328832101","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/111555","author_association":"MEMBER","_links":{"html":{"href":"https://github.com/godotengine/godot/pull/111555#pullrequestreview-3328832101"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/111555"}},"submitted_at":"2025-10-12T15:05:15Z","commit_id":null},{"id":3329356104,"node_id":"PRR_kwDOAO6SJc7GcfFI","user":{"login":"Ivorforce","id":2308167,"node_id":"MDQ6VXNlcjIzMDgxNjc=","avatar_url":"https://avatars.githubusercontent.com/u/2308167?u=f7f8e0273f784f5ec6f6b7fe4a88d449896eb48a&v=4","gravatar_id":"","url":"https://api.github.com/users/Ivorforce","html_url":"https://github.com/Ivorforce","followers_url":"https://api.github.com/users/Ivorforce/followers","following_url":"https://api.github.com/users/Ivorforce/following{/other_user}","gists_url":"https://api.github.com/users/Ivorforce/gists{/gist_id}","starred_url":"https://api.github.com/users/Ivorforce/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Ivorforce/subscriptions","organizations_url":"https://api.github.com/users/Ivorforce/orgs","repos_url":"https://api.github.com/users/Ivorforce/repos","events_url":"https://api.github.com/users/Ivorforce/events{/privacy}","received_events_url":"https://api.github.com/users/Ivorforce/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"Looks fine to me.\nI have hunch that some of these files might use `class_db.h` transitive includees somewhere, since it's quite a wide include hub. But if they do, they're provided from elsewhere too, since it compiles fine. So I think it's good to go.","state":"APPROVED","html_url":"https://github.com/godotengine/godot/pull/111555#pullrequestreview-3329356104","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/111555","author_association":"MEMBER","_links":{"html":{"href":"https://github.com/godotengine/godot/pull/111555#pullrequestreview-3329356104"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/111555"}},"submitted_at":"2025-10-12T18:54:09Z","commit_id":"89b73f38263b5d3730ce7a1af2e878fae2eb4130"}]