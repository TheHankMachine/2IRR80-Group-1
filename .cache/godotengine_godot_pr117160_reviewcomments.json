[{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/2953347151","pull_request_review_id":3967726353,"id":2953347151,"node_id":"PRRC_kwDOAO6SJc6wCIBP","diff_hunk":"@@ -4978,6 +4978,28 @@\n             ],\n             \"since\": \"4.1\"\n         },\n+        {\n+            \"name\": \"variant_get_type_by_name\",\n+            \"return_value\": {\n+                \"type\": \"GDExtensionVariantType\",\n+                \"description\": [\n+                    \"The variant type for the given name; otherwise VARIANT_MAX if name is invalid.\"\n+                ]","path":"core/extension/gdextension_interface.json","commit_id":"31fb4d42861148bc6c331af6b0f079ed3c0098cb","original_commit_id":"31fb4d42861148bc6c331af6b0f079ed3c0098cb","user":{"login":"Bromeon","id":708488,"node_id":"MDQ6VXNlcjcwODQ4OA==","avatar_url":"https://avatars.githubusercontent.com/u/708488?v=4","gravatar_id":"","url":"https://api.github.com/users/Bromeon","html_url":"https://github.com/Bromeon","followers_url":"https://api.github.com/users/Bromeon/followers","following_url":"https://api.github.com/users/Bromeon/following{/other_user}","gists_url":"https://api.github.com/users/Bromeon/gists{/gist_id}","starred_url":"https://api.github.com/users/Bromeon/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Bromeon/subscriptions","organizations_url":"https://api.github.com/users/Bromeon/orgs","repos_url":"https://api.github.com/users/Bromeon/repos","events_url":"https://api.github.com/users/Bromeon/events{/privacy}","received_events_url":"https://api.github.com/users/Bromeon/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"This is a minor compatibility hazard:\r\n\r\n- Version 4.7 checks `if (variant_get_type_by_name(...) == VARIANT_MAX)`\r\n- Version 4.8 adds a new variant type\r\n- This changes the value of `VARIANT_MAX`\r\n- The extension written under 4.7 but run under 4.8 will now have a silent runtime bug\r\n\r\nThis _can_ be OK if the caller just wants to check whether a variant of that type exists, but a user may assume \"the variant type exists _and I know about it_\".\r\n\r\nMaybe documenting something like:\r\n\r\n> Checking `type != VARIANT_MAX` may return true, even if none of the statically known variant types matches (namely, when the extension runs in a newer Godot version that has additional variant types).","created_at":"2026-03-18T13:12:04Z","updated_at":"2026-03-18T13:16:48Z","html_url":"https://github.com/godotengine/godot/pull/117160#discussion_r2953347151","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/117160","_links":{"self":{"href":"https://api.github.com/repos/godotengine/godot/pulls/comments/2953347151"},"html":{"href":"https://github.com/godotengine/godot/pull/117160#discussion_r2953347151"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/117160"}},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/2953347151/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":4984,"original_start_line":4984,"start_side":"RIGHT","line":4987,"original_line":4987,"side":"RIGHT","author_association":"CONTRIBUTOR","original_position":10,"position":10,"subject_type":"line"},{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/2953498573","pull_request_review_id":3967892726,"id":2953498573,"node_id":"PRRC_kwDOAO6SJc6wCs_N","diff_hunk":"@@ -4978,6 +4978,28 @@\n             ],\n             \"since\": \"4.1\"\n         },\n+        {\n+            \"name\": \"variant_get_type_by_name\",\n+            \"return_value\": {\n+                \"type\": \"GDExtensionVariantType\",\n+                \"description\": [\n+                    \"The variant type for the given name; otherwise VARIANT_MAX if name is invalid.\"\n+                ]","path":"core/extension/gdextension_interface.json","commit_id":"31fb4d42861148bc6c331af6b0f079ed3c0098cb","original_commit_id":"31fb4d42861148bc6c331af6b0f079ed3c0098cb","user":{"login":"dsnopek","id":191561,"node_id":"MDQ6VXNlcjE5MTU2MQ==","avatar_url":"https://avatars.githubusercontent.com/u/191561?v=4","gravatar_id":"","url":"https://api.github.com/users/dsnopek","html_url":"https://github.com/dsnopek","followers_url":"https://api.github.com/users/dsnopek/followers","following_url":"https://api.github.com/users/dsnopek/following{/other_user}","gists_url":"https://api.github.com/users/dsnopek/gists{/gist_id}","starred_url":"https://api.github.com/users/dsnopek/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/dsnopek/subscriptions","organizations_url":"https://api.github.com/users/dsnopek/orgs","repos_url":"https://api.github.com/users/dsnopek/repos","events_url":"https://api.github.com/users/dsnopek/events{/privacy}","received_events_url":"https://api.github.com/users/dsnopek/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"Perhaps we should suggest checking for `type >= VARIANT_MAX`? If a new variant type was added, the GDExtension doesn't know about it, so it's invalid as far as its concerned anyway","created_at":"2026-03-18T13:36:29Z","updated_at":"2026-03-18T13:36:29Z","html_url":"https://github.com/godotengine/godot/pull/117160#discussion_r2953498573","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/117160","_links":{"self":{"href":"https://api.github.com/repos/godotengine/godot/pulls/comments/2953498573"},"html":{"href":"https://github.com/godotengine/godot/pull/117160#discussion_r2953498573"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/117160"}},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/2953498573/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":4984,"original_start_line":4984,"start_side":"RIGHT","line":4987,"original_line":4987,"side":"RIGHT","in_reply_to_id":2953347151,"author_association":"CONTRIBUTOR","original_position":10,"position":10,"subject_type":"line"},{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/2954149162","pull_request_review_id":3968588650,"id":2954149162,"node_id":"PRRC_kwDOAO6SJc6wFL0q","diff_hunk":"@@ -4978,6 +4978,28 @@\n             ],\n             \"since\": \"4.1\"\n         },\n+        {\n+            \"name\": \"variant_get_type_by_name\",\n+            \"return_value\": {\n+                \"type\": \"GDExtensionVariantType\",\n+                \"description\": [\n+                    \"The variant type for the given name; otherwise VARIANT_MAX if name is invalid.\"\n+                ]","path":"core/extension/gdextension_interface.json","commit_id":"31fb4d42861148bc6c331af6b0f079ed3c0098cb","original_commit_id":"31fb4d42861148bc6c331af6b0f079ed3c0098cb","user":{"login":"Naros","id":3255568,"node_id":"MDQ6VXNlcjMyNTU1Njg=","avatar_url":"https://avatars.githubusercontent.com/u/3255568?v=4","gravatar_id":"","url":"https://api.github.com/users/Naros","html_url":"https://github.com/Naros","followers_url":"https://api.github.com/users/Naros/followers","following_url":"https://api.github.com/users/Naros/following{/other_user}","gists_url":"https://api.github.com/users/Naros/gists{/gist_id}","starred_url":"https://api.github.com/users/Naros/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Naros/subscriptions","organizations_url":"https://api.github.com/users/Naros/orgs","repos_url":"https://api.github.com/users/Naros/repos","events_url":"https://api.github.com/users/Naros/events{/privacy}","received_events_url":"https://api.github.com/users/Naros/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"So if I understand correctly, the suggestion would then be to handle this on the godot-cpp in the sibling PR https://github.com/godotengine/godot-cpp/pull/1946?\r\n\r\nThere we could use the `result >= VARIANT_MAX` check and easily deal with when the engine returns a new variant type that godot-cpp does not yet know about.  Is that correct?\r\n\r\nHere we would just amend the documentation to clarify this corner case.","created_at":"2026-03-18T15:09:51Z","updated_at":"2026-03-18T15:10:28Z","html_url":"https://github.com/godotengine/godot/pull/117160#discussion_r2954149162","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/117160","_links":{"self":{"href":"https://api.github.com/repos/godotengine/godot/pulls/comments/2954149162"},"html":{"href":"https://github.com/godotengine/godot/pull/117160#discussion_r2954149162"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/117160"}},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/2954149162/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":4984,"original_start_line":4984,"start_side":"RIGHT","line":4987,"original_line":4987,"side":"RIGHT","in_reply_to_id":2953347151,"author_association":"CONTRIBUTOR","original_position":10,"position":10,"subject_type":"line"},{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/2954301932","pull_request_review_id":3968752985,"id":2954301932,"node_id":"PRRC_kwDOAO6SJc6wFxHs","diff_hunk":"@@ -4978,6 +4978,28 @@\n             ],\n             \"since\": \"4.1\"\n         },\n+        {\n+            \"name\": \"variant_get_type_by_name\",\n+            \"return_value\": {\n+                \"type\": \"GDExtensionVariantType\",\n+                \"description\": [\n+                    \"The variant type for the given name; otherwise VARIANT_MAX if name is invalid.\"\n+                ]","path":"core/extension/gdextension_interface.json","commit_id":"31fb4d42861148bc6c331af6b0f079ed3c0098cb","original_commit_id":"31fb4d42861148bc6c331af6b0f079ed3c0098cb","user":{"login":"dalexeev","id":47700418,"node_id":"MDQ6VXNlcjQ3NzAwNDE4","avatar_url":"https://avatars.githubusercontent.com/u/47700418?v=4","gravatar_id":"","url":"https://api.github.com/users/dalexeev","html_url":"https://github.com/dalexeev","followers_url":"https://api.github.com/users/dalexeev/followers","following_url":"https://api.github.com/users/dalexeev/following{/other_user}","gists_url":"https://api.github.com/users/dalexeev/gists{/gist_id}","starred_url":"https://api.github.com/users/dalexeev/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/dalexeev/subscriptions","organizations_url":"https://api.github.com/users/dalexeev/orgs","repos_url":"https://api.github.com/users/dalexeev/repos","events_url":"https://api.github.com/users/dalexeev/events{/privacy}","received_events_url":"https://api.github.com/users/dalexeev/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"GDExtension isn't my area of ​​expertise, but in my opinion, `variant_get_type_by_name()` isn't a function that's required in the GDExtension interface for communicating with the engine. The list of `Variant` types is already present in `extension_api.json`, and binding generators can already recreate an equivalent of `Variant::get_type_by_name()` on the extension side.\r\n\r\nWhy don't we add more comprehensive and unified reflection for global symbols and `Variant` members in the form of `Variant` utility functions:\r\n\r\n```gdscript\r\nget_global_scope_enum_list() -> Array[Dictionary]\r\nget_global_scope_constant_list() -> Array[Dictionary]\r\nget_global_scope_function_list() -> Array[Dictionary]\r\n\r\nget_variant_enum_list(type: Variant.Type) -> Array[Dictionary]\r\nget_variant_constant_list(type: Variant.Type) -> Array[Dictionary]\r\nget_variant_method_list(type: Variant.Type) -> Array[Dictionary]\r\nget_variant_property_list(type: Variant.Type) -> Array[Dictionary]\r\n```\r\n\r\nThen both extensions and scripts could get the list of `Variant` types from the global `Variant.Type` enum (to populate the dictionary/hashmap `String -> Variant.Type`).","created_at":"2026-03-18T15:27:59Z","updated_at":"2026-03-18T15:39:39Z","html_url":"https://github.com/godotengine/godot/pull/117160#discussion_r2954301932","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/117160","_links":{"self":{"href":"https://api.github.com/repos/godotengine/godot/pulls/comments/2954301932"},"html":{"href":"https://github.com/godotengine/godot/pull/117160#discussion_r2954301932"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/117160"}},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/2954301932/reactions","total_count":3,"+1":3,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":4984,"original_start_line":4984,"start_side":"RIGHT","line":4987,"original_line":4987,"side":"RIGHT","in_reply_to_id":2953347151,"author_association":"CONTRIBUTOR","original_position":10,"position":10,"subject_type":"line"},{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/2954794389","pull_request_review_id":3969293764,"id":2954794389,"node_id":"PRRC_kwDOAO6SJc6wHpWV","diff_hunk":"@@ -4978,6 +4978,28 @@\n             ],\n             \"since\": \"4.1\"\n         },\n+        {\n+            \"name\": \"variant_get_type_by_name\",\n+            \"return_value\": {\n+                \"type\": \"GDExtensionVariantType\",\n+                \"description\": [\n+                    \"The variant type for the given name; otherwise VARIANT_MAX if name is invalid.\"\n+                ]","path":"core/extension/gdextension_interface.json","commit_id":"31fb4d42861148bc6c331af6b0f079ed3c0098cb","original_commit_id":"31fb4d42861148bc6c331af6b0f079ed3c0098cb","user":{"login":"dsnopek","id":191561,"node_id":"MDQ6VXNlcjE5MTU2MQ==","avatar_url":"https://avatars.githubusercontent.com/u/191561?v=4","gravatar_id":"","url":"https://api.github.com/users/dsnopek","html_url":"https://github.com/dsnopek","followers_url":"https://api.github.com/users/dsnopek/followers","following_url":"https://api.github.com/users/dsnopek/following{/other_user}","gists_url":"https://api.github.com/users/dsnopek/gists{/gist_id}","starred_url":"https://api.github.com/users/dsnopek/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/dsnopek/subscriptions","organizations_url":"https://api.github.com/users/dsnopek/orgs","repos_url":"https://api.github.com/users/dsnopek/repos","events_url":"https://api.github.com/users/dsnopek/events{/privacy}","received_events_url":"https://api.github.com/users/dsnopek/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"> Why don't we add more comprehensive and unified reflection for global symbols and `Variant` members in the form of `Variant` utility functions\r\n\r\nWe should do this!\r\n\r\nHowever, we already have `variant_get_type_name` in the GDExtension interface, and, in my opinion, it makes sense to have `variant_get_type_by_name` to go in the other direction as well.\r\n\r\nPersonally, I don't think we should block adding a missing method (which I suspect was just an oversight) on solving the bigger problem","created_at":"2026-03-18T16:41:06Z","updated_at":"2026-03-18T16:41:07Z","html_url":"https://github.com/godotengine/godot/pull/117160#discussion_r2954794389","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/117160","_links":{"self":{"href":"https://api.github.com/repos/godotengine/godot/pulls/comments/2954794389"},"html":{"href":"https://github.com/godotengine/godot/pull/117160#discussion_r2954794389"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/117160"}},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/2954794389/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":4984,"original_start_line":4984,"start_side":"RIGHT","line":4987,"original_line":4987,"side":"RIGHT","in_reply_to_id":2953347151,"author_association":"CONTRIBUTOR","original_position":10,"position":10,"subject_type":"line"},{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/2954810835","pull_request_review_id":3969313939,"id":2954810835,"node_id":"PRRC_kwDOAO6SJc6wHtXT","diff_hunk":"@@ -4978,6 +4978,28 @@\n             ],\n             \"since\": \"4.1\"\n         },\n+        {\n+            \"name\": \"variant_get_type_by_name\",\n+            \"return_value\": {\n+                \"type\": \"GDExtensionVariantType\",\n+                \"description\": [\n+                    \"The variant type for the given name; otherwise VARIANT_MAX if name is invalid.\"\n+                ]","path":"core/extension/gdextension_interface.json","commit_id":"31fb4d42861148bc6c331af6b0f079ed3c0098cb","original_commit_id":"31fb4d42861148bc6c331af6b0f079ed3c0098cb","user":{"login":"dsnopek","id":191561,"node_id":"MDQ6VXNlcjE5MTU2MQ==","avatar_url":"https://avatars.githubusercontent.com/u/191561?v=4","gravatar_id":"","url":"https://api.github.com/users/dsnopek","html_url":"https://github.com/dsnopek","followers_url":"https://api.github.com/users/dsnopek/followers","following_url":"https://api.github.com/users/dsnopek/following{/other_user}","gists_url":"https://api.github.com/users/dsnopek/gists{/gist_id}","starred_url":"https://api.github.com/users/dsnopek/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/dsnopek/subscriptions","organizations_url":"https://api.github.com/users/dsnopek/orgs","repos_url":"https://api.github.com/users/dsnopek/repos","events_url":"https://api.github.com/users/dsnopek/events{/privacy}","received_events_url":"https://api.github.com/users/dsnopek/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"> So if I understand correctly, the suggestion would then be to handle this on the godot-cpp in the sibling PR [godotengine/godot-cpp#1946](https://github.com/godotengine/godot-cpp/pull/1946)?\r\n\r\nThe suggestion is just about updating the docs. I don't know that we can do anything in godot-cpp, we'd just need to pass on the same docs to users of godot-cpp","created_at":"2026-03-18T16:43:39Z","updated_at":"2026-03-18T16:43:40Z","html_url":"https://github.com/godotengine/godot/pull/117160#discussion_r2954810835","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/117160","_links":{"self":{"href":"https://api.github.com/repos/godotengine/godot/pulls/comments/2954810835"},"html":{"href":"https://github.com/godotengine/godot/pull/117160#discussion_r2954810835"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/117160"}},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/2954810835/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":4984,"original_start_line":4984,"start_side":"RIGHT","line":4987,"original_line":4987,"side":"RIGHT","in_reply_to_id":2953347151,"author_association":"CONTRIBUTOR","original_position":10,"position":10,"subject_type":"line"},{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/2955945893","pull_request_review_id":3970526731,"id":2955945893,"node_id":"PRRC_kwDOAO6SJc6wMCel","diff_hunk":"@@ -4978,6 +4978,28 @@\n             ],\n             \"since\": \"4.1\"\n         },\n+        {\n+            \"name\": \"variant_get_type_by_name\",\n+            \"return_value\": {\n+                \"type\": \"GDExtensionVariantType\",\n+                \"description\": [\n+                    \"The variant type for the given name; otherwise VARIANT_MAX if name is invalid.\"\n+                ]","path":"core/extension/gdextension_interface.json","commit_id":"31fb4d42861148bc6c331af6b0f079ed3c0098cb","original_commit_id":"31fb4d42861148bc6c331af6b0f079ed3c0098cb","user":{"login":"Bromeon","id":708488,"node_id":"MDQ6VXNlcjcwODQ4OA==","avatar_url":"https://avatars.githubusercontent.com/u/708488?v=4","gravatar_id":"","url":"https://api.github.com/users/Bromeon","html_url":"https://github.com/Bromeon","followers_url":"https://api.github.com/users/Bromeon/followers","following_url":"https://api.github.com/users/Bromeon/following{/other_user}","gists_url":"https://api.github.com/users/Bromeon/gists{/gist_id}","starred_url":"https://api.github.com/users/Bromeon/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Bromeon/subscriptions","organizations_url":"https://api.github.com/users/Bromeon/orgs","repos_url":"https://api.github.com/users/Bromeon/repos","events_url":"https://api.github.com/users/Bromeon/events{/privacy}","received_events_url":"https://api.github.com/users/Bromeon/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"> Personally, I don't think we should block adding a missing method (which I suspect was just an oversight) on solving the bigger problem\r\n\r\nIt does mean though that there's one more way to achieve the same thing. One could argue that `variant_get_type_name` is already redundant, no need to make it two :wink: and if we end up adding a general way to do these lookups in the future, there's yet another way :sweat_smile:\r\n\r\nIt's not a disaster, but it will increase redundancy in the available API and possibly require deprecations at some point.\r\n\r\n---\r\n\r\n> Perhaps we should suggest checking for `type >= VARIANT_MAX`? If a new variant type was added, the GDExtension doesn't know about it, so it's invalid as far as its concerned anyway\r\n\r\nTo circle back to the `VARIANT_MAX` issue, the subtle difference here is that the behavior depends on the runtime version of Godot, not the compiled GDExtension API (as one might suggest). I'm not sure if that discrepancy is clear from the docs alone.\r\n\r\nAnd given the potential for bugs, I'm no longer sure if adding this method provides actual benefits over iterating the static list of variant types (which the extension _knows_ it can work with).\r\n\r\n","created_at":"2026-03-18T20:08:33Z","updated_at":"2026-03-18T20:08:33Z","html_url":"https://github.com/godotengine/godot/pull/117160#discussion_r2955945893","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/117160","_links":{"self":{"href":"https://api.github.com/repos/godotengine/godot/pulls/comments/2955945893"},"html":{"href":"https://github.com/godotengine/godot/pull/117160#discussion_r2955945893"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/117160"}},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/2955945893/reactions","total_count":2,"+1":2,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":4984,"original_start_line":4984,"start_side":"RIGHT","line":4987,"original_line":4987,"side":"RIGHT","in_reply_to_id":2953347151,"author_association":"CONTRIBUTOR","original_position":10,"position":10,"subject_type":"line"},{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/2995449429","pull_request_review_id":4014829924,"id":2995449429,"node_id":"PRRC_kwDOAO6SJc6yiu5V","diff_hunk":"@@ -4978,6 +4978,28 @@\n             ],\n             \"since\": \"4.1\"\n         },\n+        {\n+            \"name\": \"variant_get_type_by_name\",\n+            \"return_value\": {\n+                \"type\": \"GDExtensionVariantType\",\n+                \"description\": [\n+                    \"The variant type for the given name; otherwise VARIANT_MAX if name is invalid.\"\n+                ]","path":"core/extension/gdextension_interface.json","commit_id":"31fb4d42861148bc6c331af6b0f079ed3c0098cb","original_commit_id":"31fb4d42861148bc6c331af6b0f079ed3c0098cb","user":{"login":"akien-mga","id":4701338,"node_id":"MDQ6VXNlcjQ3MDEzMzg=","avatar_url":"https://avatars.githubusercontent.com/u/4701338?v=4","gravatar_id":"","url":"https://api.github.com/users/akien-mga","html_url":"https://github.com/akien-mga","followers_url":"https://api.github.com/users/akien-mga/followers","following_url":"https://api.github.com/users/akien-mga/following{/other_user}","gists_url":"https://api.github.com/users/akien-mga/gists{/gist_id}","starred_url":"https://api.github.com/users/akien-mga/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/akien-mga/subscriptions","organizations_url":"https://api.github.com/users/akien-mga/orgs","repos_url":"https://api.github.com/users/akien-mga/repos","events_url":"https://api.github.com/users/akien-mga/events{/privacy}","received_events_url":"https://api.github.com/users/akien-mga/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"So is this blocking or should we go ahead with the PR as is?","created_at":"2026-03-26T14:39:09Z","updated_at":"2026-03-26T14:39:09Z","html_url":"https://github.com/godotengine/godot/pull/117160#discussion_r2995449429","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/117160","_links":{"self":{"href":"https://api.github.com/repos/godotengine/godot/pulls/comments/2995449429"},"html":{"href":"https://github.com/godotengine/godot/pull/117160#discussion_r2995449429"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/117160"}},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/2995449429/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":4984,"original_start_line":4984,"start_side":"RIGHT","line":4987,"original_line":4987,"side":"RIGHT","in_reply_to_id":2953347151,"author_association":"MEMBER","original_position":10,"position":10,"subject_type":"line"},{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/2995596855","pull_request_review_id":4014991566,"id":2995596855,"node_id":"PRRC_kwDOAO6SJc6yjS43","diff_hunk":"@@ -4978,6 +4978,28 @@\n             ],\n             \"since\": \"4.1\"\n         },\n+        {\n+            \"name\": \"variant_get_type_by_name\",\n+            \"return_value\": {\n+                \"type\": \"GDExtensionVariantType\",\n+                \"description\": [\n+                    \"The variant type for the given name; otherwise VARIANT_MAX if name is invalid.\"\n+                ]","path":"core/extension/gdextension_interface.json","commit_id":"31fb4d42861148bc6c331af6b0f079ed3c0098cb","original_commit_id":"31fb4d42861148bc6c331af6b0f079ed3c0098cb","user":{"login":"dsnopek","id":191561,"node_id":"MDQ6VXNlcjE5MTU2MQ==","avatar_url":"https://avatars.githubusercontent.com/u/191561?v=4","gravatar_id":"","url":"https://api.github.com/users/dsnopek","html_url":"https://github.com/dsnopek","followers_url":"https://api.github.com/users/dsnopek/followers","following_url":"https://api.github.com/users/dsnopek/following{/other_user}","gists_url":"https://api.github.com/users/dsnopek/gists{/gist_id}","starred_url":"https://api.github.com/users/dsnopek/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/dsnopek/subscriptions","organizations_url":"https://api.github.com/users/dsnopek/orgs","repos_url":"https://api.github.com/users/dsnopek/repos","events_url":"https://api.github.com/users/dsnopek/events{/privacy}","received_events_url":"https://api.github.com/users/dsnopek/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"I'm still personally in favor of this PR. Even if the GDExtension doesn't understand all the variant types, this at least allows round-tripping the values. I'd be happy with just updating the note in the docs to say \"otherwise VARIANT_MAX or greater, if name is invalid\". I'm also not personally that worried about this duplicating a future generic solution, given that this is such a tiny addition, and no one is even working on the generic solution.\r\n\r\nThat said, this PR has gotten way more push back than I would have expected, so we should probably discuss it at a GDExtension team meeting and try to get closer to consensus :-)","created_at":"2026-03-26T14:56:27Z","updated_at":"2026-03-26T14:58:37Z","html_url":"https://github.com/godotengine/godot/pull/117160#discussion_r2995596855","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/117160","_links":{"self":{"href":"https://api.github.com/repos/godotengine/godot/pulls/comments/2995596855"},"html":{"href":"https://github.com/godotengine/godot/pull/117160#discussion_r2995596855"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/117160"}},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/2995596855/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":4984,"original_start_line":4984,"start_side":"RIGHT","line":4987,"original_line":4987,"side":"RIGHT","in_reply_to_id":2953347151,"author_association":"CONTRIBUTOR","original_position":10,"position":10,"subject_type":"line"},{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/2996123547","pull_request_review_id":4015568139,"id":2996123547,"node_id":"PRRC_kwDOAO6SJc6ylTeb","diff_hunk":"@@ -4978,6 +4978,28 @@\n             ],\n             \"since\": \"4.1\"\n         },\n+        {\n+            \"name\": \"variant_get_type_by_name\",\n+            \"return_value\": {\n+                \"type\": \"GDExtensionVariantType\",\n+                \"description\": [\n+                    \"The variant type for the given name; otherwise VARIANT_MAX if name is invalid.\"\n+                ]","path":"core/extension/gdextension_interface.json","commit_id":"31fb4d42861148bc6c331af6b0f079ed3c0098cb","original_commit_id":"31fb4d42861148bc6c331af6b0f079ed3c0098cb","user":{"login":"Bromeon","id":708488,"node_id":"MDQ6VXNlcjcwODQ4OA==","avatar_url":"https://avatars.githubusercontent.com/u/708488?v=4","gravatar_id":"","url":"https://api.github.com/users/Bromeon","html_url":"https://github.com/Bromeon","followers_url":"https://api.github.com/users/Bromeon/followers","following_url":"https://api.github.com/users/Bromeon/following{/other_user}","gists_url":"https://api.github.com/users/Bromeon/gists{/gist_id}","starred_url":"https://api.github.com/users/Bromeon/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Bromeon/subscriptions","organizations_url":"https://api.github.com/users/Bromeon/orgs","repos_url":"https://api.github.com/users/Bromeon/repos","events_url":"https://api.github.com/users/Bromeon/events{/privacy}","received_events_url":"https://api.github.com/users/Bromeon/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"Pushback might be unjustified -- for me it's mostly that I haven't seen a use case for this feature that wouldn't be better solved with the statically known `VariantType` constants :slightly_smiling_face: also in the interest of not increasing GDExtension complexity/redundancy unnecessarily.\r\n\r\nA meeting sounds good, would be nice if stakeholders of the proposal could be present.","created_at":"2026-03-26T16:15:29Z","updated_at":"2026-03-26T16:15:29Z","html_url":"https://github.com/godotengine/godot/pull/117160#discussion_r2996123547","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/117160","_links":{"self":{"href":"https://api.github.com/repos/godotengine/godot/pulls/comments/2996123547"},"html":{"href":"https://github.com/godotengine/godot/pull/117160#discussion_r2996123547"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/117160"}},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/2996123547/reactions","total_count":2,"+1":2,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":4984,"original_start_line":4984,"start_side":"RIGHT","line":4987,"original_line":4987,"side":"RIGHT","in_reply_to_id":2953347151,"author_association":"CONTRIBUTOR","original_position":10,"position":10,"subject_type":"line"}]