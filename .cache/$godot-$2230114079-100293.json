ars.githubusercontent.com/u/2308167?u=f7f8e0273f784f5ec6f6b7fe4a88d449896eb48a&v=4","created_at":"0001-01-01T00:00:00Z","followers":0,"following":0,"html_url":"https://github.com/Ivorforce","id":2308167,"node_id":"MDQ6VXNlcjIzMDgxNjc=","login":"Ivorforce","type":"User","owned_private_repos":0,"public_gists":0,"public_repos":0,"total_private_repos":0,"url":"https://api.github.com/users/Ivorforce"},"body":"","html_url":"https://github.com/godotengine/godot/pull/100293#pullrequestreview-2564107346","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/100293","author_association":"MEMBER","submitted_at":"2025-01-21T10:12:52Z"},{"id":2652924641,"node_id":"PRR_kwDOAO6SJc6eIGrh","state":"APPROVED","user":{"site_admin":false,"suspended":false,"updated_at":"0001-01-01T00:00:00Z","avatar_url":"https://avatars.githubusercontent.com/u/17489292?u=34072b401722100a7c0c0d61e37b376cf22b4545&v=4","created_at":"0001-01-01T00:00:00Z","followers":0,"following":0,"html_url":"https://github.com/Repiteo","id":17489292,"node_id":"MDQ6VXNlcjE3NDg5Mjky","login":"Repiteo","type":"User","owned_private_repos":0,"public_gists":0,"public_repos":0,"total_private_repos":0,"url":"https://api.github.com/users/Repiteo"},"body":"Codestyle checks out & the use of more modern C++ concepts is a welcome addition","html_url":"https://github.com/godotengine/godot/pull/100293#pullrequestreview-2652924641","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/100293","author_association":"CONTRIBUTOR","submitted_at":"2025-03-03T02:02:13Z"},{"id":2668762851,"node_id":"PRR_kwDOAO6SJc6fEhbj","state":"COMMENTED","user":{"site_admin":false,"suspended":false,"updated_at":"0001-01-01T00:00:00Z","avatar_url":"https://avatars.githubusercontent.com/u/16521339?u=e44a465cbebabb9ea2be80b59e6dc07966bef5b7&v=4","created_at":"0001-01-01T00:00:00Z","followers":0,"following":0,"html_url":"https://github.com/clayjohn","id":16521339,"node_id":"MDQ6VXNlcjE2NTIxMzM5","login":"clayjohn","type":"User","owned_private_repos":0,"public_gists":0,"public_repos":0,"total_private_repos":0,"url":"https://api.github.com/users/clayjohn"},"body":"I think this is ready to go. But we need to settle the `size_t` debate. Personally I lean towards just making it a `uint64_t`  and calling it a day. \r\n\r\nI appreciate the reasons for `size_t`, but I think the pain of having a changing size isn't going to be worth the slight optimization for 32 bit systems. If you look at download numbers, almost no one uses the 32 bit version of Godot. And, ultimately, we need to prioritize developer ergonomics in this case. Have a fixed size that we can count on and that matches our equivalent container types is IMO the most important consideration. \r\n\r\nCC @lawnjelly @hpvb It would be great for you two to weigh in with your thoughts sometime soon so we can merge this and begin the process of migrating over to Span","html_url":"https://github.com/godotengine/godot/pull/100293#pullrequestreview-2668762851","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/100293","author_association":"MEMBER","submitted_at":"2025-03-08T01:55:03Z"},{"id":2669270232,"node_id":"PRR_kwDOAO6SJc6fGdTY","state":"COMMENTED","user":{"site_admin":false,"suspended":false,"updated_at":"0001-01-01T00:00:00Z","avatar_url":"https://avatars.githubusercontent.com/u/67693830?u=5127cb92ac85d3db01550c026a62da13254bd17e&v=4","created_at":"0001-01-01T00:00:00Z","followers":0,"following":0,"html_url":"https://github.com/YYF233333","id":67693830,"node_id":"MDQ6VXNlcjY3NjkzODMw","login":"YYF233333","type":"User","owned_private_repos":0,"public_gists":0,"public_repos":0,"total_private_repos":0,"url":"https://api.github.com/users/YYF233333"},"body":"","html_url":"https://github.com/godotengine/godot/pull/100293#pullrequestreview-2669270232","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/100293","author_association":"CONTRIBUTOR","submitted_at":"2025-03-08T21:53:29Z"},{"id":26694338