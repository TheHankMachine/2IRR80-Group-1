[{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5803691572","html_url":"https://github.com/godotengine/godot/pull/123724#issuecomment-5803691572","issue_url":"https://api.github.com/repos/godotengine/godot/issues/123724","id":5803691572,"node_id":"IC_kwDOAO6SJc8AAAABWe1ONA","user":{"login":"Komariarii","id":301026105,"node_id":"U_kgDOEfFLOQ","avatar_url":"https://avatars.githubusercontent.com/u/301026105?v=4","gravatar_id":"","url":"https://api.github.com/users/Komariarii","html_url":"https://github.com/Komariarii","followers_url":"https://api.github.com/users/Komariarii/followers","following_url":"https://api.github.com/users/Komariarii/following{/other_user}","gists_url":"https://api.github.com/users/Komariarii/gists{/gist_id}","starred_url":"https://api.github.com/users/Komariarii/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Komariarii/subscriptions","organizations_url":"https://api.github.com/users/Komariarii/orgs","repos_url":"https://api.github.com/users/Komariarii/repos","events_url":"https://api.github.com/users/Komariarii/events{/privacy}","received_events_url":"https://api.github.com/users/Komariarii/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-09-23T22:01:54Z","updated_at":"2026-09-23T22:06:10Z","body":"(Sorry for the prek failures, spent a little time getting that setup locally so that shouldn't happen in the future :bow:)\r\n\r\nInstead of just setting the vertical size flag to shrink center, the toolbar group now pulls in the default font size of the theme, and then adds a, I suppose, magic number of 18 to it. This should be unnoticeable if you use the default font size of 14, as this results in the previous fixed value of 32. \r\n\r\nThe magic number isn't really my favorite, but I wasn't sure if it was really worth the added complexity of pulling in a bunch of margin values from both parents and children of the group...\r\n\r\nBig font:\r\n<img width=\"1877\" height=\"1139\" alt=\"image\" src=\"https://github.com/user-attachments/assets/7d8e9d8f-1c47-437d-a54b-e9b7a99aefb9\" />\r\n\r\n\r\nSmall font:\r\n<img width=\"1871\" height=\"943\" alt=\"image\" src=\"https://github.com/user-attachments/assets/9ed6c7cc-345b-4149-9e12-74cc4a5d4364\" />\r\n","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5803691572/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5818945468","html_url":"https://github.com/godotengine/godot/pull/123724#issuecomment-5818945468","issue_url":"https://api.github.com/repos/godotengine/godot/issues/123724","id":5818945468,"node_id":"IC_kwDOAO6SJc8AAAABWtYPvA","user":{"login":"Repiteo","id":17489292,"node_id":"MDQ6VXNlcjE3NDg5Mjky","avatar_url":"https://avatars.githubusercontent.com/u/17489292?v=4","gravatar_id":"","url":"https://api.github.com/users/Repiteo","html_url":"https://github.com/Repiteo","followers_url":"https://api.github.com/users/Repiteo/followers","following_url":"https://api.github.com/users/Repiteo/following{/other_user}","gists_url":"https://api.github.com/users/Repiteo/gists{/gist_id}","starred_url":"https://api.github.com/users/Repiteo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Repiteo/subscriptions","organizations_url":"https://api.github.com/users/Repiteo/orgs","repos_url":"https://api.github.com/users/Repiteo/repos","events_url":"https://api.github.com/users/Repiteo/events{/privacy}","received_events_url":"https://api.github.com/users/Repiteo/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-09-24T17:29:18Z","updated_at":"2026-09-24T17:29:18Z","body":"Thanks!","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine