ull},{"id":283518733,"node_id":"MDU6TGFiZWwyODM1MTg3MzM=","url":"https://api.github.com/repos/godotengine/godot/labels/usability","name":"usability","color":"447744","default":false,"description":"","archived_at":null,"archived_by":null}],"state":"closed","locked":false,"assignees":[],"milestone":{"url":"https://api.github.com/repos/godotengine/godot/milestones/22","html_url":"https://github.com/godotengine/godot/milestone/22","labels_url":"https://api.github.com/repos/godotengine/godot/milestones/22/labels","id":12070367,"node_id":"MI_kwDOAO6SJc4AuC3f","number":22,"title":"4.5","description":"","creator":{"login":"Sauermann","id":6299227,"node_id":"MDQ6VXNlcjYyOTkyMjc=","avatar_url":"https://avatars.githubusercontent.com/u/6299227?v=4","gravatar_id":"","url":"https://api.github.com/users/Sauermann","html_url":"https://github.com/Sauermann","followers_url":"https://api.github.com/users/Sauermann/followers","following_url":"https://api.github.com/users/Sauermann/following{/other_user}","gists_url":"https://api.github.com/users/Sauermann/gists{/gist_id}","starred_url":"https://api.github.com/users/Sauermann/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Sauermann/subscriptions","organizations_url":"https://api.github.com/users/Sauermann/orgs","repos_url":"https://api.github.com/users/Sauermann/repos","events_url":"https://api.github.com/users/Sauermann/events{/privacy}","received_events_url":"https://api.github.com/users/Sauermann/received_events","type":"User","user_view_type":"public","site_admin":false},"open_issues":3,"closed_issues":3687,"state":"closed","created_at":"2024-12-19T08:51:28Z","updated_at":"2026-09-04T21:48:38Z","due_on":"2025-09-15T00:00:00Z","closed_at":"2025-09-18T17:13:14Z"},"comments":9,"created_at":"2025-03-22T17:12:34Z","updated_at":"2026-02-07T12:34:58Z","closed_at":"2025-05-23T14:49:34Z","assignee":null,"author_association":"CONTRIBUTOR","issue_field_values":[],"type":null,"active_lock_reason":null,"draft":false,"pull_request":{"url":"https://api.github.com/repos/godotengine/godot/pulls/104490","html_url":"https://github.com/godotengine/godot/pull/104490","diff_url":"https://github.com/godotengine/godot/pull/104490.diff","patch_url":"https://github.com/godotengine/godot/pull/104490.patch","merged_at":"2025-05-23T14:49:34Z"},"body":"Restore part of functionality of reverted PR https://github.com/godotengine/godot/pull/97860. \r\nAs I see from discussion, several concerns were raised about the original changes:\r\n- The viewable area became too short when the field was not empty (https://github.com/godotengine/godot/pull/97860#pullrequestreview-2350629401, https://github.com/godotengine/godot/pull/97860#issuecomment-2599105410)\r\n- Load options were removed from dropdown menu.\r\n\r\nAs described in https://github.com/godotengine/godot/pull/102196:\r\n\r\n> User feedback has shown that this change isn't always a clear improvement, because:\r\n> \r\n> 1. The icon eats up horizontal space that's already limited here, cutting the text or previews significantly.\r\n> 2. The \"Load\" functionality was completely removed, while it's still useful for many.\r\n> 3. It breaks user expectations to no longer have load options next to Clear/Save/etc.\r\n\r\nIn this PR:\r\n - (1) is addressed by only displaying the \"Quick Load\" button when the field is empty.\r\n - (2) and (3) are avoided entirely, as the existing code for load options is preserved.\r\n \r\nSo now current functionality has not degraded and at the same time initial setup for empty field became quicker. While this may be a not complete solution, it is still usability improvement (Perfect is the enemy of good).\r\n\r\nI'm sure there could be other opinions, so feedback is welcome.\r\n\r\nPreview:\r\n\r\nhttps://github.com/user-attachments/assets/161f897f-88f3-4a0d-883f-673493b5516f","closed_by":{"login":"Repiteo","id":17489292,"node_id":"MDQ6VXNlcjE3NDg5Mjky","avatar_url":"https://avatars.githubusercontent.com/u/17489292?v=4","gravatar_id":"","url":"https://api.github.com/users/Repiteo","html_url":"https://github.com/Repiteo","followers_url":"https://api.github.com/users/Repiteo/followers","following_url":"https://api.github.com/users/Repiteo/following{/other_user}","gists_url":"https://api.github.com/users/Repiteo/gists{/gist_id}","starred_url":"https://api.github.com/users/Repiteo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Repiteo/subscriptions","organizations_url":"https://api.github.com/users/Repiteo/orgs","repos_url":"https://api.github.com/users/Repiteo/repos","events_url":"https://api.github.com/users/Repiteo/events{/privacy}","received_events_url":"https://api.github.com/users/Repiteo/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/104490/reactions","total_count":14,"+1":14,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/godotengine/godot/issues/104490/timeline","performed_via_github_app":null,"state_reason":null}