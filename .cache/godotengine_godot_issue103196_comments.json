ithub.com/users/MichaelDawe/events{/privacy}","received_events_url":"https://api.github.com/users/MichaelDawe/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-02-28T22:51:30Z","updated_at":"2025-02-28T22:51:30Z","body":"> [@MichaelDawe](https://github.com/MichaelDawe) [@akien-mga](https://github.com/akien-mga) I tracked down the issue with mouse capture not working in `_ready`, and mouse capture input being dropped, and pushed [#103413](https://github.com/godotengine/godot/pull/103413) to address them.\n> \n> [@MichaelDawe](https://github.com/MichaelDawe) Can you test build templates generated from the PR and see if it addresses the described issues - https://github.com/godotengine/godot/actions/runs/13597173696/artifacts/2673402287\n\nYes!  This works on both my Samsung Tab s8+ and Pixel 8a, thanks :)","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2691678084/reactions","total_count":2,"+1":2,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2704445954","html_url":"https://github.com/godotengine/godot/issues/103196#issuecomment-2704445954","issue_url":"https://api.github.com/repos/godotengine/godot/issues/103196","id":2704445954,"node_id":"IC_kwDOAO6SJc6hMpIC","user":{"login":"MichaelDawe","id":75983563,"node_id":"MDQ6VXNlcjc1OTgzNTYz","avatar_url":"https://avatars.githubusercontent.com/u/75983563?v=4","gravatar_id":"","url":"https://api.github.com/users/MichaelDawe","html_url":"https://github.com/MichaelDawe","followers_url":"https://api.github.com/users/MichaelDawe/followers","following_url":"https://api.github.com/users/MichaelDawe/following{/other_user}","gists_url":"https://api.github.com/users/MichaelDawe/gists{/gist_id}","starred_url":"https://api.github.com/users/MichaelDawe/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/MichaelDawe/subscriptions","organizations_url":"https://api.github.com/users/MichaelDawe/orgs","repos_url":"https://api.github.com/users/MichaelDawe/repos","events_url":"https://api.github.com/users/MichaelDawe/events{/privacy}","received_events_url":"https://api.github.com/users/MichaelDawe/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-03-06T17:10:12Z","updated_at":"2025-03-06T17:10:12Z","body":"Hi again, mouse capture still doesn't work on the Meta Quest 2.  I know this is a very niche use case, and it could be a limitation of the headset, but if anyone knows more about it it might be worth investigating.\nI'm using a custom build of the latest master branch which includes the previous fix, it works fine on the Samsung Tab S8+ and Pixel 8a still :)","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2704445954/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2704706439","html_url":"https://github.com/godotengine/godot/issues/103196#issuecomment-2704706439","issue_url":"https://api.github.com/repos/godotengine/godot/issues/103196","id":2704706439,"node_id":"IC_kwDOAO6SJc6hNouH","user":{"login":"m4gr3d","id":914968,"node_id":"MDQ6VXNlcjkxNDk2OA==","avatar_url":"https://avatars.githubusercontent.com/u/914968?v=4","gravatar_id":"","url":"https://api.github.com/users/m4gr3d","html_url":"https://github.com/m4gr3d","followers_url":"https://api.github.com/users/m4gr3d/followers","following_url":"https://api.github.com/users/m4gr3d/following{/other_user}","gists_url":"https://api.github.com/users/m4gr3d/gists{/gist_id}","starred_url":"https://api.github.com/users/m4gr3d/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/m4gr3d/subscriptions","organizations_url":"https://api.github.com/users/m4gr3d/orgs","repos_url":"https://api.github.com/users/m4gr3d/repos","events_url":"https://api.github.com/users/m4gr3d/events{/privacy}","received_events_url":"https://api.github.com/users/m4gr3d/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-03-06T19:03:24Z","updated_at":"2025-03-06T19:03:24Z","body":"> Hi again, mouse capture still doesn't work on the Meta Quest 2. I know this is a very niche use case, and it could be a limitation of the headset, but if anyone knows more about it it might be worth investigating. I'm using a custom build of the latest master branch which includes the previous fix, it works fine on the Samsung Tab S8+ and Pixel 8a still :)\n\nhey @MichaelDawe, that's expected behavior. Mouse capture is not yet supported on the Quest headset so we've disabled the logic there in https://github.com/godotengine/godot/blob/134da374975114ef8e05cf81d1d30eff645e310e/platform/android/java/lib/src/org/godotengine/godot/GodotRenderView.java#L72","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2704706439/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null}]