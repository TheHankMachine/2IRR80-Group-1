ngs += [\"-Wshadow\", \"-Wno-misleading-indentation\"]\n+        common_warnings = [\"-Wshadow\", \"-Wno-misleading-indentation\"]\n         if cc_version_major < 11:\n             # Regression in GCC 9/10, spams so much in our variadic templates\n             # that we need to outright disable it.\n             common_warnings += [\"-Wno-type-limits\"]\n         if cc_version_major >= 12:  # False positives in our error macros, see GH-58747.\n             common_warnings += [\"-Wno-return-type\"]\n     elif methods.using_clang(env) or methods.using_emcc(env):\n+        common_warnings = [\"-Wenum-conversion\"]  # Only enable for Clang, not GCC","path":"SConstruct","commit_id":"e1c006f39bd2ab6c39b6dbcbd95f013f5d567a94","original_commit_id":"b6580ce2d598496cfaf557f82f080065206fa9dc","user":{"login":"maxcomperatore","id":131000419,"node_id":"U_kgDOB87oYw","avatar_url":"https://avatars.githubusercontent.com/u/131000419?v=4","gravatar_id":"","url":"https://api.github.com/users/maxcomperatore","html_url":"https://github.com/maxcomperatore","followers_url":"https://api.github.com/users/maxcomperatore/followers","following_url":"https://api.github.com/users/maxcomperatore/following{/other_user}","gists_url":"https://api.github.com/users/maxcomperatore/gists{/gist_id}","starred_url":"https://api.github.com/users/maxcomperatore/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/maxcomperatore/subscriptions","organizations_url":"https://api.github.com/users/maxcomperatore/orgs","repos_url":"https://api.github.com/users/maxcomperatore/repos","events_url":"https://api.github.com/users/maxcomperatore/events{/privacy}","received_events_url":"https://api.github.com/users/maxcomperatore/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"Done","created_at":"2025-05-05T18:33:00Z","updated_at":"2025-05-05T18:33:00Z","html_url":"https://github.com/godotengine/godot/pull/106065#discussion_r2073967620","pull_request_url":"https://a