03119,"node_id":"MDU6TGFiZWwxMzMyMzAzMTE5","url":"https://api.github.com/repos/godotengine/godot/labels/regression","name":"regression","color":"ff63ac","default":false,"description":"","archived_at":null,"archived_by":null}],"state":"open","locked":false,"assignees":[],"milestone":{"url":"https://api.github.com/repos/godotengine/godot/milestones/25","html_url":"https://github.com/godotengine/godot/milestone/25","labels_url":"https://api.github.com/repos/godotengine/godot/milestones/25/labels","id":15520464,"node_id":"MI_kwDOAO6SJc4A7NLQ","number":25,"title":"4.8","description":"","creator":{"login":"Repiteo","id":17489292,"node_id":"MDQ6VXNlcjE3NDg5Mjky","avatar_url":"https://avatars.githubusercontent.com/u/17489292?v=4","gravatar_id":"","url":"https://api.github.com/users/Repiteo","html_url":"https://github.com/Repiteo","followers_url":"https://api.github.com/users/Repiteo/followers","following_url":"https://api.github.com/users/Repiteo/following{/other_user}","gists_url":"https://api.github.com/users/Repiteo/gists{/gist_id}","starred_url":"https://api.github.com/users/Repiteo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Repiteo/subscriptions","organizations_url":"https://api.github.com/users/Repiteo/orgs","repos_url":"https://api.github.com/users/Repiteo/repos","events_url":"https://api.github.com/users/Repiteo/events{/privacy}","received_events_url":"https://api.github.com/users/Repiteo/received_events","type":"User","user_view_type":"public","site_admin":false},"open_issues":341,"closed_issues":2335,"state":"open","created_at":"2026-04-13T15:59:35Z","updated_at":"2026-10-22T03:07:42Z","due_on":null,"closed_at":null},"comments":10,"created_at":"2026-02-06T18:16:30Z","updated_at":"2026-06-18T12:02:26Z","closed_at":null,"assignee":null,"author_association":"CONTRIBUTOR","issue_field_values":[],"type":null,"active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"### Tested versions\n\n- Reproducible in: 4.6.stable\n- Reproducible in: 4.7.dev [56f3e2611daadb0b1894b46737ee3000e82e33f9]\n\n### System information\n\nGodot v4.5.1.stable - Fedora Linux 43 (Forty Three) on Wayland - X11 display driver, Multi-window, 2 monitors - Vulkan (Forward+) - dedicated AMD Radeon RX 9070 XT (RADV GFX1201) - AMD Ryzen 9 9950X3D 16-Core Processor (32 threads) - 60.39 GiB memory\n\n### Issue description\n\nThere seems to have been a regression to export determinism in 4.6, which stems from #106837.\n\nThe ID generation for the new `unique_id` that's added to every scene node is seemingly not deterministic, which means it gets regenerated on every export if you haven't re-saved a particular scene file, which in turn means the scene is incorrectly considered to have been modified when doing things like exporting patch PCKs.\n\n### Steps to reproduce\n\n1. Open the MRP.\n2. Export PCK/ZIP using any preset.\n4. Open `.godot/exported/[some_number]/` in the MRP project.\n5. Calculate the hash of `export-*-some_other_scene.scn`.\n6. Delete `export-*-some_other_scene.scn`.\n7. Export PCK/ZIP again.\n8. Calculate the hash of `export-*-some_other_scene.scn` again.\n9. Note how the hash is different.\n10. Open `some_other_scene.tscn` and save it.\n11. Do the whole thing again.\n12. Note how the hash is now stable.\n\n### Minimal reproduction project (MRP)\n\n[non-deterministic-scene-exports.zip](https://github.com/user-attachments/files/25134618/non-deterministic-scene-exports.zip)","closed_by":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/115971/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/godotengine/godot/issues/115971/timeline","performed_via_github_app":null,"state_reason":null,"pinned_comment":null}