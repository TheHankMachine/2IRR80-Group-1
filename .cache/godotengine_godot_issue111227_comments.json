nt_facing) {\r\n4092 |          discard;\r\n4093 |  }\r\n4094 | #endif\r\n4095 | #ifdef MODE_DUAL_PARABOLOID\r\n4096 |\r\n4097 |  if (dp_clip > 0.0) {\r\n4098 |          discard;\r\n4099 |  }\r\n4100 | #endif\r\n4101 |\r\n4102 |  fragment_shader(scene_data_block.data);\r\n4103 | }\r\n4104 |\r\n4105 |\r\n   at: ShaderRD::compile_stages (servers\\rendering\\renderer_rd\\shader_rd.cpp:992)\r\n   at: ShaderRD::_compile_variant (servers\\rendering\\renderer_rd\\shader_rd.cpp:306)\r\nERROR:   at: ShaderRD::compile_stages (servers\\rendering\\renderer_rd\\shader_rd.cpp:992)\r\n   at: ShaderRD::compile_stages (servers\\rendering\\renderer_rd\\shader_rd.cpp:992)\r\nERROR:   at: ShaderRD::compile_stages (servers\\rendering\\renderer_rd\\shader_rd.cpp:992)\r\n   at: ShaderRD::_compile_variant (servers\\rendering\\renderer_rd\\shader_rd.cpp:306)\r\n   at: ShaderRD::compile_stages (servers\\rendering\\renderer_rd\\shader_rd.cpp:992)\r\n Condition \"variant_stages.is_empty()\" is true.\r\nERROR:   at: ShaderRD::_compile_variant (servers\\rendering\\renderer_rd\\shader_rd.cpp:306)\r\n Condition \"variant_stages.is_empty()\" is true.\r\n Condition \"variant_stages.is_empty()\" is true.\r\nERROR:   at: ShaderRD::_compile_variant (servers\\rendering\\renderer_rd\\shader_rd.cpp:306)\r\n   at: ShaderRD::_compile_variant (servers\\rendering\\renderer_rd\\shader_rd.cpp:306)\r\n Condition \"variant_stages.is_empty()\" is true.\r\n   at: ShaderRD::_compile_variant (servers\\rendering\\renderer_rd\\shader_rd.cpp:306)\r\n   at: ShaderRD::_compile_variant (servers\\rendering\\renderer_rd\\shader_rd.cpp:306)\r\n Condition \"variant_stages.is_empty()\" is true.\r\n   at: ShaderRD::_compile_variant (servers\\rendering\\renderer_rd\\shader_rd.cpp:306)\r\nERROR: Condition \"variant_stages.is_empty()\" is true.\r\n   at: ShaderRD::_compile_variant (servers\\rendering\\renderer_rd\\shader_rd.cpp:306)\r\nERROR: Condition \"variant_stages.is_empty()\" is true.\r\n   at: ShaderRD::_compile_variant (servers\\rendering\\renderer_rd\\shader_rd.cpp:306)\r\nERROR: Condition \"variant_stages.is_empty()\" is true.\r\n   at: ShaderRD::_compile_variant (servers\\rendering\\renderer_rd\\shader_rd.cpp:306)\r\nERROR: Condition \"variant_stages.is_empty()\" is true.\r\n   at: ShaderRD::_compile_variant (servers\\rendering\\renderer_rd\\shader_rd.cpp:306)\r\nERROR: Condition \"variant_stages.is_empty()\" is true.\r\n   at: ShaderRD::_compile_variant (servers\\rendering\\renderer_rd\\shader_rd.cpp:306)\r\n   ERROR: FATAL: Index p_index = 3 is out of bounds (size() = 0).\r\n   at: CowData<class RID>::get (core\\templates\\cowdata.h:193)\r\n```","author_association":"NONE","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3375553117/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3376210541","html_url":"https://github.com/godotengine/godot/pull/111227#issuecomment-3376210541","issue_url":"https://api.github.com/repos/godotengine/godot/issues/111227","id":3376210541,"node_id":"IC_kwDOAO6SJc7JPOJt","user":{"login":"akien-mga","id":4701338,"node_id":"MDQ6VXNlcjQ3MDEzMzg=","avatar_url":"https://avatars.githubusercontent.com/u/4701338?v=4","gravatar_id":"","url":"https://api.github.com/users/akien-mga","html_url":"https://github.com/akien-mga","followers_url":"https://api.github.com/users/akien-mga/followers","following_url":"https://api.github.com/users/akien-mga/following{/other_user}","gists_url":"https://api.github.com/users/akien-mga/gists{/gist_id}","starred_url":"https://api.github.com/users/akien-mga/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/akien-mga/subscriptions","organizations_url":"https://api.github.com/users/akien-mga/orgs","repos_url":"https://api.github.com/users/akien-mga/repos","events_url":"https://api.github.com/users/akien-mga/events{/privacy}","received_events_url":"https://api.github.com/users/akien-mga/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-10-07T10:21:33Z","updated_at":"2025-10-07T12:32:16Z","body":"@packed-and-compressed I tested this PR and can't reproduce the error with the steps you outlined in #111352. Are you testing with the same steps or a more complex project that may trigger another bug?\r\n\r\n*Edit:* Actually I had the MRP open in the background while doing other work, and coming back to it an hour later, I did get some errors, notably:\r\n\r\n```\r\nERROR: ./servers/rendering/renderer_rd/shader_rd.cpp:306 - Condition \"variant_stages.is_empty()\" is true.\r\n  ERROR: ./servers/rendering/renderer_rd/shader_rd.cpp:306 - Condition \"variant_stages.is_empty()\" is true.\r\n  ERROR: ./servers/rendering/renderer_rd/shader_rd.cpp:988 - Error compiling Fragment shader.\r\n  ERROR: ./servers/rendering/renderer_rd/shader_rd.cpp:989 - Failed parse:\r\n  ERROR: ERROR: 0:1064: '=' :  cannot convert from 'layout( column_major std140) global highp 3X4 matrix of float' to ' temp highp 4X4 matrix of float'\r\n  ERROR: ERROR: 0:1064: '' : missing #endif \r\n  ERROR: ERROR: 0:1064: '' : compilation terminated \r\n  ERROR: ERROR: 3 compilation errors.  No code generated.\r\n```\r\n\r\nSeems to happen around here:\r\n```\r\nERROR: 1042 | void light_compute(hvec3 N, hvec3 L, hvec3 V, half A, hvec3 light_color, bool is_directional, half attenuation, hvec3 f0, half roughness, half metallic, half specular_amount, hvec3 albedo, inout half alpha, vec2 screen_uv, hvec3 energy_compensation,\r\n  ERROR: 1043 | #ifdef LIGHT_BACKLIGHT_USED\r\n  ERROR: 1044 | \t\thvec3 backlight,\r\n  ERROR: 1045 | #endif\r\n  ERROR: 1046 | #ifdef LIGHT_TRANSMITTANCE_USED\r\n  ERROR: 1047 | \t\thvec4 transmittance_color,\r\n  ERROR: 1048 | \t\thalf transmittance_depth,\r\n  ERROR: 1049 | \t\thalf transmittance_boost,\r\n  ERROR: 1050 | \t\thalf transmittance_z,\r\n  ERROR: 1051 | #endif\r\n  ERROR: 1052 | #ifdef LIGHT_RIM_USED\r\n  ERROR: 1053 | \t\thalf rim, half rim_tint,\r\n  ERROR: 1054 | #endif\r\n  ERROR: 1055 | #ifdef LIGHT_CLEARCOAT_USED\r\n  ERROR: 1056 | \t\thalf clearcoat, half clearcoat_roughness, hvec3 vertex_normal,\r\n  ERROR: 1057 | #endif\r\n  ERROR: 1058 | #ifdef LIGHT_ANISOTROPY_USED\r\n  ERROR: 1059 | \t\thvec3 B, hvec3 T, half anisotropy,\r\n  ERROR: 1060 | #endif\r\n  ERROR: 1061 | \t\tinout hvec3 diffuse_light, inout hvec3 specular_light) {\r\n  ERROR: 1062 | #if defined(LIGHT_CODE_USED)\r\n  ERROR: 1063 | \t\r\n  ERROR: 1064 | \tmat4 inv_view_matrix = scene_data_block.data.inv_view_matrix;\r\n  ERROR: 1065 | \tmat4 read_view_matrix = scene_data_block.data.view_matrix;\r\n```\r\n\r\nNot 100% about line numbers as I got multiple 4000 lines shader dumps and that exceeds the history of the Output panel. The errors linked above were below a shader dump where I only have access to lines 3000 to 4000-ish. Then it dumps another shader which has the excerpt pasted above, but no explicit syntax error reported.\r\n\r\nThe errors still look like the fix is not applied, so I suspect SCons isn't properly regenerating the files from the modified .glsl code. ~I suspect the fact that's its an `inc.glsl` file meant to be included in other shaders breaks the dependency detection (there's no header to generate for this changed file).~\r\n\r\n*Edit 2:* I might have been testing the wrong instance of Godot when I got this error, so nevermind.","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3376210541/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3377406736","html_url":"https://github.com/godotengine/godot/pull/111227#issuecomment-3377406736","issue_url":"https://api.github.com/