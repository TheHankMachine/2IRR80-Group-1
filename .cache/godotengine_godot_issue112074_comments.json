2572093/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3452577137","html_url":"https://github.com/godotengine/godot/issues/112074#issuecomment-3452577137","issue_url":"https://api.github.com/repos/godotengine/godot/issues/112074","id":3452577137,"node_id":"IC_kwDOAO6SJc7NyiVx","user":{"login":"llama-nl","id":94882246,"node_id":"U_kgDOBafJxg","avatar_url":"https://avatars.githubusercontent.com/u/94882246?v=4","gravatar_id":"","url":"https://api.github.com/users/llama-nl","html_url":"https://github.com/llama-nl","followers_url":"https://api.github.com/users/llama-nl/followers","following_url":"https://api.github.com/users/llama-nl/following{/other_user}","gists_url":"https://api.github.com/users/llama-nl/gists{/gist_id}","starred_url":"https://api.github.com/users/llama-nl/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/llama-nl/subscriptions","organizations_url":"https://api.github.com/users/llama-nl/orgs","repos_url":"https://api.github.com/users/llama-nl/repos","events_url":"https://api.github.com/users/llama-nl/events{/privacy}","received_events_url":"https://api.github.com/users/llama-nl/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-10-27T17:46:51Z","updated_at":"2025-10-27T17:46:51Z","body":"> If this is for accessing data in the current project's `user://` directory you can see:\n> \n> * [Show `user://` in the FileSystem dock godot-proposals#2362](https://github.com/godotengine/godot-proposals/issues/2362)\n> \n> And related proposals\n\nYeah this is releted to this issues. ","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3452577137/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0}