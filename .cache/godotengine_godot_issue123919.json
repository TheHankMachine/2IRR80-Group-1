lse,"description":"","archived_at":null,"archived_by":null},{"id":2231593685,"node_id":"MDU6TGFiZWwyMjMxNTkzNjg1","url":"https://api.github.com/repos/godotengine/godot/labels/topic:tests","name":"topic:tests","color":"ffee88","default":false,"description":"","archived_at":null,"archived_by":null}],"state":"open","locked":false,"assignees":[],"milestone":{"url":"https://api.github.com/repos/godotengine/godot/milestones/25","html_url":"https://github.com/godotengine/godot/milestone/25","labels_url":"https://api.github.com/repos/godotengine/godot/milestones/25/labels","id":15520464,"node_id":"MI_kwDOAO6SJc4A7NLQ","number":25,"title":"4.8","description":"","creator":{"login":"Repiteo","id":17489292,"node_id":"MDQ6VXNlcjE3NDg5Mjky","avatar_url":"https://avatars.githubusercontent.com/u/17489292?v=4","gravatar_id":"","url":"https://api.github.com/users/Repiteo","html_url":"https://github.com/Repiteo","followers_url":"https://api.github.com/users/Repiteo/followers","following_url":"https://api.github.com/users/Repiteo/following{/other_user}","gists_url":"https://api.github.com/users/Repiteo/gists{/gist_id}","starred_url":"https://api.github.com/users/Repiteo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Repiteo/subscriptions","organizations_url":"https://api.github.com/users/Repiteo/orgs","repos_url":"https://api.github.com/users/Repiteo/repos","events_url":"https://api.github.com/users/Repiteo/events{/privacy}","received_events_url":"https://api.github.com/users/Repiteo/received_events","type":"User","user_view_type":"public","site_admin":false},"open_issues":345,"closed_issues":2336,"state":"open","created_at":"2026-04-13T15:59:35Z","updated_at":"2026-10-22T08:21:32Z","due_on":null,"closed_at":null},"comments":3,"created_at":"2026-09-28T12:47:40Z","updated_at":"2026-10-16T12:17:44Z","closed_at":null,"assignee":null,"author_association":"NONE","issue_field_values":[],"type":null,"active_lock_reason":null,"draft":false,"pull_request":{"url":"https://api.github.com/repos/godotengine/godot/pulls/123919","html_url":"https://github.com/godotengine/godot/pull/123919","diff_url":"https://github.com/godotengine/godot/pull/123919.diff","patch_url":"https://github.com/godotengine/godot/pull/123919.patch","merged_at":null},"body":"## What problem(s) does this PR solve?\r\n\r\n- Unit tests in modules/visual_shader/tests/ were being skipped entirely during --test runs.\r\n\r\n## Description & Solution\r\n\r\ntest_visual_shader.cpp was a .cpp file using TEST_FORCE_LINK, but Godot's module test runner only collects tests from modules/*/tests/*.h headers into modules_tests.gen.h, which is why this file never got compiled in.\r\n\r\n**Changes made:**\r\n- Renamed it to test_visual_shader.h\r\n- wrapped it in namespace TestVisualShader\r\n- added #pragma once, and removed the outdated TEST_FORCE_LINK.\r\n\r\n## Additional information\r\n\r\n### Test Output Verification\r\n\r\n- **Before:** `test cases: 0 | 0 passed | 0 failed | 1432 skipped`\r\n- **After:** `test cases: 3 | 3 passed | 0 failed | 1429 skipped` (`103 assertions passed`)\r\n\r\nUse of AI: AI was used to check my understanding of Godot's module test infrastructure. It did not write the code.\r\n\r\nFixes  #123904\r\n","closed_by":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/123919/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/godotengine/godot/issues/123919/timeline","performed_via_github_app":null,"state_reason":null}