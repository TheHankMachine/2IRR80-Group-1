16771999/reactions","total_count":2,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":1,"heart":0,"rocket":0,"eyes":1},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2616960972","html_url":"https://github.com/godotengine/godot/pull/102042#issuecomment-2616960972","issue_url":"https://api.github.com/repos/godotengine/godot/issues/102042","id":2616960972,"node_id":"IC_kwDOAO6SJc6b-6fM","user":{"login":"ChildLearningClub","id":25701774,"node_id":"MDQ6VXNlcjI1NzAxNzc0","avatar_url":"https://avatars.githubusercontent.com/u/25701774?v=4","gravatar_id":"","url":"https://api.github.com/users/ChildLearningClub","html_url":"https://github.com/ChildLearningClub","followers_url":"https://api.github.com/users/ChildLearningClub/followers","following_url":"https://api.github.com/users/ChildLearningClub/following{/other_user}","gists_url":"https://api.github.com/users/ChildLearningClub/gists{/gist_id}","starred_url":"https://api.github.com/users/ChildLearningClub/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/ChildLearningClub/subscriptions","organizations_url":"https://api.github.com/users/ChildLearningClub/orgs","repos_url":"https://api.github.com/users/ChildLearningClub/repos","events_url":"https://api.github.com/users/ChildLearningClub/events{/privacy}","received_events_url":"https://api.github.com/users/ChildLearningClub/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-01-27T21:44:27Z","updated_at":"2025-01-27T21:44:27Z","body":"I hope what I did fixed it? \r\n\r\n`git log --oneline`\r\n```\r\neef17e0c35 (HEAD -> master, origin/master, origin/HEAD) Changed if false to if true \"Emoji and Symbols\" menu is enabled.b15b24b087 (upstream/master) Merge pull request #101688 from TCROC/fix-gpu-particles-2d-set_one_shot-seed-randomization\r\nb298f6f479 Merge pull request #101936 from Hilderin/disable-game-embedding-single-window-mode\r\n```\r\n`git reset --hard eef17e0c35`\r\n\r\n`git checkout master`\r\n\r\nthen I did a `git fetch origin`,  `git rebase origin/master` and lastly, `git push --force`. ","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2616960972/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2619685361","html_url":"https://github.com/godotengine/godot/pull/102042#issuecomment-2619685361","issue_url":"https://api.github.com/repos/godotengine/godot/issues/102042","id":2619685361,"node_id":"IC_kwDOAO6SJc6cJTnx","user":{"login":"akien-mga","id":4701338,"node_id":"MDQ6VXNlcjQ3MDEzMzg=","avatar_url":"https://avatars.githubusercontent.com/u/4701338?v=4","gravatar_id":"","url":"https://api.github.com/users/akien-mga","html_url":"https://github.com/akien-mga","followers_url":"https://api.github.com/users/akien-mga/followers","following_url":"https://api.github.com/users/akien-mga/following{/other_user}","gists_url":"https://api.github.com/users/akien-mga/gists{/gist_id}","starred_url":"https://api.github.com/users/akien-mga/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/akien-mga/subscriptions","organizations_url":"https://api.github.com/users/akien-mga/orgs","repos_url":"https://api.github.com/users/akien-mga/repos","events_url":"https://api.github.com/users/akien-mga/events{/privacy}","received_events_url":"https://api.github.com/users/akien-mga/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-01-28T17:50:04Z","updated_at":"2025-01-28T17:50:04Z","body":"> then I did a `git fetch origin`, `git rebase origin/master` and lastly, `git push --force`.\r\n\r\nThis didn't work, because your `origin` is your own fork, so rebasing on `origin/master` is rebasing on the branch you used to make this PR (so no change).\r\n\r\nYou need to add the upstream Godot repo as a remote and rebase on top of that one:\r\n\r\n```\r\ngit remote add upstream https://github.com/godotengine/godot\r\ngit fetch upstream master\r\ngit rebase upstream/master\r\ngit push --force\r\n```\r\n\r\nI did this locally and updated your fork's branch directly (GitHub allows maintainer to do this by default, unless disabled when opening the PR).\r\n\r\nOne last thing before merging:\r\n\r\nYour commit seems not to be linked to your GitHub account. See: [Why are my commits linked to the wrong user?](https://docs.github.com/en/pull-requests/committing-changes-to-your-project/troubleshooting-commits/why-are-my-commits-linked-to-the-wrong-user) for more info.\r\n\r\nYou can add the email used for this commit in your GitHub settings and it should then appear as authored by you. Alternatively the email can be changed to your GitHub account's anonymous email, I can do this if you want.","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2619685361/reactions","total_count":1,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":1,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2620061352","html_url":"https://github.com/godotengine/godot/pull/102042#issuecomment-2620061352","issue_url":"https://api.github.com/repos/godotengine/godot/issues/102042","id":2620061352,"node_id":"IC_kwDOAO6SJc6cKvao","user":{"login":"ChildLearningClub","id":25701774,"node_id":"MDQ6VXNlcjI1NzAxNzc0","avatar_url":"https://avatars.githubusercontent.com/u/25701774?v=4","gravatar_id":"","url":"https://api.github.com/users/ChildLearningClub","html_url":"https://github.com/ChildLearningClub","followers_url":"https://api.github.com/users/ChildLearningClub/followers","following_url":"https://api.github.com/users/ChildLearningClub/following{/other_user}","gists_url":"htt