ol, script->get_path(), base, result);\r\n    if (lc_error != OK) {\r\n        return;\r\n    }\r\n\r\n    switch (result.type) {\r\n        // ...\r\n    }\r\n}\r\n\r\nif (!doc_symbol.is_empty()) {\r\n    EditorHelpBitTooltip::show_tooltip(code_editor->get_text_editor(), doc_symbol, String(), true);\r\n}\r\n```\r\n\r\nYes, this will require increasing the indentation level of the large `switch`, but I think it's ok in this case.","created_at":"2025-01-03T18:52:40Z","updated_at":"2025-01-03T19:22:26Z","html_url":"https://github.com/godotengine/godot/pull/100803#discussion_r1902072624","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/100803","_links":{"self":{"href":"https://api.github.com/repos/godotengine/godot/pulls/comments/1902072624"},"html":{"href":"https://github.com/godotengine/godot/pull/100803#discussion_r1902072624"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/100803"}},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/1902072624/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":1109,"start_side":"RIGHT","line":null,"original_line":1115,"side":"RIGHT","author_association":"CONTRIBUTOR","original_position":5,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/1902075699","pull_request_review_id":2529563187,"id":1902075699,"node_id":"PRRC_kwDOAO6SJc5xX18z","diff_hunk":"@@ -277,6 +277,7 @@ class EditorHelpBit : public VBoxContainer {\n \t\tString value;\n \t\tVector<ArgumentData> arguments;\n \t\tString qualifiers;\n+\t\tString resource_path;","path":"editor/editor_help.h","commit_id":"e813d3021b2ee79e4e34a63c3f4990c0bb606d18","original_commit_id":"95475c429f1dafeb736589eb03443cd0e05fa658","user":{"login":"dalexeev","id":47700418,"node_id":"MDQ6VXNlcjQ3NzAwNDE4","avatar_url":"https://avatars.githubusercontent.com/u/47700418