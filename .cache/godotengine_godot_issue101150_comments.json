/comments/2571693402/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2584614785","html_url":"https://github.com/godotengine/godot/issues/101150#issuecomment-2584614785","issue_url":"https://api.github.com/repos/godotengine/godot/issues/101150","id":2584614785,"node_id":"IC_kwDOAO6SJc6aDheB","user":{"login":"cwook","id":1891696,"node_id":"MDQ6VXNlcjE4OTE2OTY=","avatar_url":"https://avatars.githubusercontent.com/u/1891696?v=4","gravatar_id":"","url":"https://api.github.com/users/cwook","html_url":"https://github.com/cwook","followers_url":"https://api.github.com/users/cwook/followers","following_url":"https://api.github.com/users/cwook/following{/other_user}","gists_url":"https://api.github.com/users/cwook/gists{/gist_id}","starred_url":"https://api.github.com/users/cwook/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/cwook/subscriptions","organizations_url":"https://api.github.com/users/cwook/orgs","repos_url":"https://api.github.com/users/cwook/repos","events_url":"https://api.github.com/users/cwook/events{/privacy}","received_events_url":"https://api.github.com/users/cwook/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-01-10T22:43:24Z","updated_at":"2025-01-10T22:43:24Z","body":"Hi @JamesMWestbrook \nI don't believe you should be running scons directly from the Developer Command Prompt, I received the same error trying that. Run from regular cmd or powershell.\n\nI had the same string length problem. If you have an older version of Visual Studio/MSVC installed alongside 2022 that might be the problem. I had to uninstall visual studio 2019 and 2022 and reinstall vs 2022 to get it working.\n\nYou might also check that your scons is up to date `scons --version`. You can update it with `python -m pip install --upgrade 