ist_id}","starred_url":"https://api.github.com/users/Repiteo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Repiteo/subscriptions","organizations_url":"https://api.github.com/users/Repiteo/orgs","repos_url":"https://api.github.com/users/Repiteo/repos","events_url":"https://api.github.com/users/Repiteo/events{/privacy}","received_events_url":"https://api.github.com/users/Repiteo/received_events","type":"User","user_view_type":"public","site_admin":false},"open_issues":3,"closed_issues":2978,"state":"closed","created_at":"2025-05-22T16:25:52Z","updated_at":"2026-10-04T16:23:23Z","due_on":null,"closed_at":"2026-01-26T18:09:14Z"},"comments":0,"created_at":"2025-08-29T01:06:42Z","updated_at":"2025-10-31T14:33:38Z","closed_at":"2025-10-31T14:33:37Z","assignee":{"login":"bruvzg","id":7645683,"node_id":"MDQ6VXNlcjc2NDU2ODM=","avatar_url":"https://avatars.githubusercontent.com/u/7645683?v=4","gravatar_id":"","url":"https://api.github.com/users/bruvzg","html_url":"https://github.com/bruvzg","followers_url":"https://api.github.com/users/bruvzg/followers","following_url":"https://api.github.com/users/bruvzg/following{/other_user}","gists_url":"https://api.github.com/users/bruvzg/gists{/gist_id}","starred_url":"https://api.github.com/users/bruvzg/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/bruvzg/subscriptions","organizations_url":"https://api.github.com/users/bruvzg/orgs","repos_url":"https://api.github.com/users/bruvzg/repos","events_url":"https://api.github.com/users/bruvzg/events{/privacy}","received_events_url":"https://api.github.com/users/bruvzg/received_events","type":"User","user_view_type":"public","site_admin":false},"author_association":"NONE","issue_field_values":[],"type":null,"active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"### Tested versions\n\n- Reproducible in: 4.5.beta6\n- Not reproducible in: 4.4.1.stable (N/A because embedded player did not exist for macOS)\n\n### System information\n\nGodot v4.5.beta (4ebf67c12) - macOS Sequoia (15.6.1) - Multi-window, 1 monitor - OpenGL 3 (Compatibility) - Apple M2 - Apple M2 (8 threads) - 8.00 GiB memory\n\n### Issue description\n\nWhen running a game in the embedded Game player in the Godot editor, the method `DisplayServer.keyboard_get_label_from_physical` returns 0 for all keys. After unchecking \"Embed game on next play\" and running the game in its own window, the method returns expected values.\n\n### Steps to reproduce\n\n1. Add this script to a node\n2. On the Game tab in the editor, check \"Embed game on next play\"\n3. Run the game and check the output\n\n```gdscript\nextends Node2D\n\nfunc _ready():\n\tvar key := Key.KEY_SPACE\n\tvar physical_key := DisplayServer.keyboard_get_label_from_physical(key)\n\n    # Embedded player: outputs \"physical key for 32 is 0\" \n    # Non-embedded player: outputs \"physical key for 32 is 32\" \n\tprint(\"physical key for %s is %s\" % [key, physical_key]) # outputs\n```\n\n### Minimal reproduction project (MRP)\n\n[MRP.zip](https://github.com/user-attachments/files/22035474/MRP.zip)","closed_by":{"login":"Repiteo","id":17489292,"node_id":"MDQ6VXNlcjE3NDg5Mjky","avatar_url":"https://avatars.githubusercontent.com/u/17489292?v=4","gravatar_id":"","url":"https://api.github.com/users/Repiteo","html_url":"https://github.com/Repiteo","followers_url":"https://api.github.com/users/Repiteo/followers","following_url":"https://api.github.com/users/Repiteo/following{/other_user}","gists_url":"https://api.github.com/users/Repiteo/gists{/gist_id}","starred_url":"https://api.github.com/users/Repiteo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Repiteo/subscriptions","organizations_url":"https://api.github.com/users/Repiteo/orgs","repos_url":"https://api.github.com/users/Repiteo/repos","events_url":"https://api.github.