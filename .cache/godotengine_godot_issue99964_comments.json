pi.github.com/users/clayjohn/subscriptions","organizations_url":"https://api.github.com/users/clayjohn/orgs","repos_url":"https://api.github.com/users/clayjohn/repos","events_url":"https://api.github.com/users/clayjohn/events{/privacy}","received_events_url":"https://api.github.com/users/clayjohn/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-02-05T21:31:45Z","updated_at":"2025-02-05T21:32:32Z","body":"On my device I get:\n```\n//before 427ba09\nUpdated PSO cache (3.3 MiB)\n2113.838\n\n//after 427ba09\nUpdated PSO cache (10.0 MiB)\n6636.551\n\n// with no-unroll\nUpdated PSO cache (6.1 MiB)\n1158.878\n```\n\nLet's add no-unroll for the ubershader for 4.4 and then evaluate if we want to do more shenanigans with loop unrolling in future releases. ","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2638069201/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2638680719","html_url":"https://github.com/godotengine/godot/issues/99964#issuecomment-2638680719","issue_url":"https://api.github.com/repos/godotengine/godot/issues/99964","id":2638680719,"node_id":"IC_kwDOAO6SJc6dRxKP","user":{"login":"clayjohn","id":16521339,"node_id":"MDQ6VXNlcjE2NTIxMzM5","avatar_url":"https://avatars.githubusercontent.com/u/16521339?v=4","gravatar_id":"","url":"https://api.github.com/users/clayjohn","html_url":"https://github.com/clayjohn","followers_url":"https://api.github.com/users/clayjohn/followers","following_url":"https://api.github.com/users/clayjohn/following{/other_user}","gists_url":"https://api.github.com/users/clayjohn/gists{/gist_id}","starred_url":"https://api.github.com/users/clayjohn/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/clayjohn/subscriptions","o