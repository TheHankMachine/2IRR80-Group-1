ps://github.com/godotengine/godot/issues/113620#issuecomment-3616683077","issue_url":"https://api.github.com/repos/godotengine/godot/issues/113620","id":3616683077,"node_id":"IC_kwDOAO6SJc7XkjRF","user":{"login":"akien-mga","id":4701338,"node_id":"MDQ6VXNlcjQ3MDEzMzg=","avatar_url":"https://avatars.githubusercontent.com/u/4701338?v=4","gravatar_id":"","url":"https://api.github.com/users/akien-mga","html_url":"https://github.com/akien-mga","followers_url":"https://api.github.com/users/akien-mga/followers","following_url":"https://api.github.com/users/akien-mga/following{/other_user}","gists_url":"https://api.github.com/users/akien-mga/gists{/gist_id}","starred_url":"https://api.github.com/users/akien-mga/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/akien-mga/subscriptions","organizations_url":"https://api.github.com/users/akien-mga/orgs","repos_url":"https://api.github.com/users/akien-mga/repos","events_url":"https://api.github.com/users/akien-mga/events{/privacy}","received_events_url":"https://api.github.com/users/akien-mga/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-12-05T12:23:42Z","updated_at":"2025-12-05T12:23:42Z","body":"Well it's not a duplicate actually, we fixed the other known regression but this issue isn't fixed.","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3616683077/reactions","total_count":2,"+1":2,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3616811478","html_url":"https://github.com/godotengine/godot/issues/113620#issuecomment-3616811478","issue_url":"https://api.github.com/repos/godotengine/godot/issues/113620","id":3616811478,"node_id":"IC_kwDOAO6SJc7XlCnW","user":{"login":"mihe","id":4884246,"node_id":"MDQ6VXNlcjQ4ODQyNDY=","avatar_url":"https://avatars.githubusercontent.com/u/4884246?v=4","gravatar_id":"","url":"https://api.github.com/users/mihe","html_url":"https://github.com/mihe","followers_url":"https://api.github.com/users/mihe/followers","following_url":"https://api.github.com/users/mihe/following{/other_user}","gists_url":"https://api.github.com/users/mihe/gists{/gist_id}","starred_url":"https://api.github.com/users/mihe/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/mihe/subscriptions","organizations_url":"https://api.github.com/users/mihe/orgs","repos_url":"https://api.github.com/users/mihe/repos","events_url":"https://api.github.com/users/mihe/events{/privacy}","received_events_url":"https://api.github.com/users/mihe/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-12-05T12:49:32Z","updated_at":"2025-12-05T13:01:00Z","body":"It looks like this is the deadlock:\n\n#### Main thread\n\n```\n__GI___lll_lock_wait\n__pthread_mutex_lock@GLIBC_2.2.5\n__gthread_mutex_lock(pthread_mutex_t*)\nstd::mutex::lock()\nstd::unique_lock<std::mutex>::lock()\nstd::unique_lock<std::mutex>::unique_lock(std::mutex&)\nMutexLock<MutexImpl<std::mutex>>::MutexLock(MutexImpl<std::mutex> const&) (core/os/mutex.h:77)\nvoid CommandQueueMT::_push_internal<CommandQueueMT::Command<PhysicsServer3DWrapMT, void (PhysicsServer3DWrapMT::*)(), true>, true, PhysicsServer3DWrapMT*&, void (PhysicsServer3DWrapMT::*&)()>(PhysicsServer3DWrapMT*&, void (PhysicsServer3DWrapMT::*&)()) (core/templates/command_queue_mt.h:137)\nvoid CommandQueueMT::push_and_sync<PhysicsServer3DWrapMT, void (PhysicsServer3DWrapMT::*)()>(PhysicsServer3DWrapMT*, void (PhysicsServer3DWrapMT::*)()) (core/templates/command_queue_mt.h:237)\nPhysicsServer3DWrapMT::sync() (servers/physics_3d/physics_server_3d_wrap_mt.cpp:68)\nMain::iteration() (main/main.cpp:4821)\nOS_LinuxBSD::run() (platform/linuxbsd/os_linuxbsd.cpp:994)\nmain (platform/linuxbsd/godot_linuxbsd.cpp:121)\n```\n\n#### Worker thread\n\n```\n__GI___lll_lock_wait\n__pthread_mutex_lock@GLIBC_2.2.5\n__gthread_mutex_lock(pthread_mutex_t*)\nstd::mutex::lock()\nstd::unique_lock<std::mutex>::lock()\nstd::unique_lock<std::mutex>::unique_lock(std::mutex&)\nMutexLock<MutexImpl<std::mutex>>::MutexLock(MutexImpl<std::mutex> const&) (core/os/mutex.h:77)\nCommandQueueMT::_flush() (core/templates/command_queue_mt.h:160)\nCommandQueueMT::flush_if_pending() (core/templates/command_queue_mt.h:250)\nPhysicsServer3DWrapMT::body_add_collision_exception(RID, RID) (servers/physics_3d/physics_server_3d_wrap_mt.h:256)\nJoltJoint3D::set_collision_disabled(bool) (modules/jolt_physics/joints/jolt_joint_3d.cpp:215)\nJoltPhysicsServer3D::joint_disable_collisions_between_bodies(RID, bool) (modules/jolt_physics/jolt_physics_server_3d.cpp:1574)\nvoid CommandQueueMT::Command<PhysicsServer3D, void (PhysicsServer3D::*)(RID, bool), false, RID&, bool&>::call_impl<0ul, 1ul>(IndexSequence<0ul, 1ul>) (core/templates/command_queue_mt.h:71)\nCommandQueueMT::Command<PhysicsServer3D, void (PhysicsServer3D::*)(RID, bool), false, RID&, bool&>::call() (core/templates/command_queue_mt.h:64)\nCommandQueueMT::_flush() (core/templates/command_queue_mt.h:188)\nCommandQueueMT::flush_all() (core/templates/command_queue_mt.h:255)\nPhysicsServer3DWrapMT::_thread_loop() (servers/physics_3d/physics_server_3d_wrap_mt.cpp:47)\nvoid call_with_variant_args_helper<PhysicsServer3DWrapMT>(PhysicsServer3DWrapMT*, void (PhysicsServer3DWrapMT::*)(), Variant const**, Callable::CallError&, IndexSequence<...>) (core/variant/binder_common.h:224)\nvoid call_with_variant_args<PhysicsServer3DWrapMT>(PhysicsServer3DWrapMT*, void (PhysicsServer3DWrapMT::*)(), Variant const**, int, Callable::CallError&) (core/variant/binder_common.h:338)\nCallableCustomMethodPointer<PhysicsServer3DWrapMT, void>::call(Variant const**, int, Variant&, Callable::CallError&) const (core/object/callable_method_pointer.h:103)\nCallable::callp(Variant const**, int, Variant&, Callable::CallError&) const (core/variant/callable.cpp:57)\nVariant Callable::call<>() const (core/variant/variant.h:950)\nWorkerThreadPool::_process_task(WorkerThreadPool::Task*) (core/object/worker_thread_pool.cpp:145)\nWorkerThreadPool::_thread_function(void*) (core/object/worker_thread_pool.cpp:218)\nThread::callback(unsigned long, Thread::Settings const&, void (*)(void*), void*) (core/os/thread.cpp:64)\n```\n\nI guess that explains the discrepancy between the Jolt Physics implementation and the Godot Physics implementation, since Godot Physics doesn't call out to `PhysicsServer3D::body_add_collision_exception` as part of disabling collisions for the joint bodies.\n\nI can fix this fairly easily, by simply switching to use `JoltPhysicsServer3D` instead of `PhysicsServer3D`, which I probably should have done to begin with. I'll put up a PR.\n\nHaving such \"nested\" server calls deadlock still seems like a bug though, so might warrant being fixed properly in some way.","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3616811478/reactions","total_count":2,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":1,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3616836323","html_url":"https://github.com/godotengine/godot/issues/113620#issuecomment-3616836323","issue_url":"https://api.github.com/repos/godotengine/godot/issues/113620","id":3616836323,"node_id":"IC_kwDOAO6SJc7XlIrj","user":{"login":"mihe","id":4884246,"node_id":"MDQ6VXNlcjQ4ODQyNDY=","avatar_url":"https://avatars.githubusercontent.com/u/4884246?v=4","gravatar_id":"","url":"https://api.github.com/users/mihe","html_url":"https://github.com/mihe","followers_url":"https://api.github.com/users/mihe/followers","following_url":"https://api.github.com/users/mihe/following{/other_user}","gists_url":"https://api.github.com/users/mihe/gists{/gist_id}","starred_ur