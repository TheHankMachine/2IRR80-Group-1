+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3623176314","html_url":"https://github.com/godotengine/godot/issues/113636#issuecomment-3623176314","issue_url":"https://api.github.com/repos/godotengine/godot/issues/113636","id":3623176314,"node_id":"IC_kwDOAO6SJc7X9Uh6","user":{"login":"wenekar","id":100775364,"node_id":"U_kgDOBgG1xA","avatar_url":"https://avatars.githubusercontent.com/u/100775364?v=4","gravatar_id":"","url":"https://api.github.com/users/wenekar","html_url":"https://github.com/wenekar","followers_url":"https://api.github.com/users/wenekar/followers","following_url":"https://api.github.com/users/wenekar/following{/other_user}","gists_url":"https://api.github.com/users/wenekar/gists{/gist_id}","starred_url":"https://api.github.com/users/wenekar/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/wenekar/subscriptions","organizations_url":"https://api.github.com/users/wenekar/orgs","repos_url":"https://api.github.com/users/wenekar/repos","events_url":"https://api.github.com/users/wenekar/events{/privacy}","received_events_url":"https://api.github.com/users/wenekar/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-12-07T20:15:54Z","updated_at":"2025-12-07T20:15:54Z","body":"Hello there! On my Cachyos system running KDE Wayland 6.5.3, I am unable to reproduce this issue, both in godot stable 4.5.1, and current master build of commit dec5a373. \n\nBoth XWayland and Wayland work just fine...\n\nDo you not have xdg-desktop-portal installed/running? Can you check with:\n `ps aux | grep xdg-desktop-portal`\n\nShould display:\n```\nwenekar     1042  0.0  0.0 1029200 18620 ?       SNsl 22:52   0:00 /usr/lib/xdg-desktop-portal\nwenekar     1514  0.0  0.0 535568 26076 ?        SNsl 22:52   0:00 /usr/lib/xdg-desktop-portal-gtk\nwenekar     1775  0.0  0.2 1105812 76596 ?       SNsl 22:52   0:00 /usr/lib/xdg-desktop-portal-kde\n```\n","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3623176314/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3623217491","html_url":"https://github.com/godotengine/godot/issues/113636#issuecomment-3623217491","issue_url":"https://api.github.com/repos/godotengine/godot/issues/113636","id":3623217491,"node_id":"IC_kwDOAO6SJc7X9elT","user":{"login":"bruvzg","id":7645683,"node_id":"MDQ6VXNlcjc2NDU2ODM=","avatar_url":"https://avatars.githubusercontent.com/u/7645683?v=4","gravatar_id":"","url":"https://api.github.com/users/bruvzg","html_url":"https://github.com/bruvzg","followers_url":"https://api.github.com/users/bruvzg/followers","following_url":"https://api.github.com/users/bruvzg/following{/other_user}","gists_url":"https://api.github.com/users/bruvzg/gists{/gist_id}","starred_url":"https://api.github.com/users/bruvzg/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/bruvzg/subscriptions","organizations_url":"https://api.github.com/users/bruvzg/orgs","repos_url":"https://api.github.com/users/bruvzg/repos","events_url":"https://api.github.com/users/bruvzg/events{/privacy}","received_events_url":"https://api.github.com/users/bruvzg/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-12-07T20:41:48Z","updated_at":"2025-12-07T20:41:48Z","body":"On Wayland and XWayland `org.freedesktop.portal.Screenshot` is the only way to pick color, there's no legacy picker for Wayland (no other API for doing it), and it is disabled for X11 driver if XWayland is detected (legacy picker will instantly crash on XWayland since it's not supported by Wayland). So it likely reproducible only on a real X11 system, there are check of the `org.freedesktop.portal.Screenshot` support, so not sure what's exactly wrong.","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3623217491/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3623958792","html_url":"https://github.com/godotengine/godot/issues/113636#issuecomment-3623958792","issue_url":"https://api.github.com/repos/godotengine/godot/issues/113636","id":3623958792,"node_id":"IC_kwDOAO6SJc7YATkI","user":{"login":"timothyqiu","id":372476,"node_id":"MDQ6VXNlcjM3MjQ3Ng==","avatar_url":"https://avatars.githubusercontent.com/u/372476?v=4","gravatar_id":"","url":"https://api.github.com/users/timothyqiu","html_url":"https://github.com/timothyqiu","followers_url":"https://api.github.com/users/timothyqiu/followers","following_url":"https://api.github.com/users/timothyqiu/following{/other_user}","gists_url":"https://api.github.com/users/timothyqiu/gists{/gist_id}","starred_url":"https://api.github.com/users/timothyqiu/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/timothyqiu/subscriptions","organizations_url":"https://api.github.com/users/timothyqiu/orgs","repos_url":"https://api.github.com/users/timothyqiu/repos","events_url":"https://api.github.com/users/timothyqiu/events{/privacy}","received_events_url":"https://api.github.com/users/timothyqiu/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-12-08T00:41:16Z","updated_at":"2025-12-08T00:41:16Z","body":"> Do you not have xdg-desktop-portal installed/running?\n\nYes. Portal features like native file dialog work correctly.\n\n```\n$ ps aux | grep xdg-desktop-portal\ntimothy     1695  0.0  0.0 699368 15460 ?        Ssl  08:21   0:00 /usr/lib/xdg-desktop-portal\ntimothy     1790  0.3  0.3 2217056 55100 ?       Ssl  08:21   0:00 /usr/lib/xdg-desktop-portal-gtk\ntimothy     1837  0.0  0.2 537428 34488 ?        Ssl  08:21   0:00 /usr/lib/xdg-desktop-portal-xapp\n```\n\n`DisplayServer.has_feature(DisplayServer.FEATURE_NATIVE_COLOR_PICKER)` returns `true` for me.\n\n","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3623958792/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3624501772","html_url":"https://github.com/godotengine/godot/issues/113636#issuecomment-3624501772","issue_url":"https://api.github.com/repos/godotengine/godot/issues/113636","id":3624501772,"node_id":"IC_kwDOAO6SJc7YCYIM","user":{"login":"timothyqiu","id":372476,"node_id":"MDQ6VXNlcjM3MjQ3Ng==","avatar_url":"https://avatars.githubusercontent.com/u/372476?v=4","gravatar_id":"","url":"https://api.github.com/users/timothyqiu","html_url":"https://github.com/timothyqiu","followers_url":"https://api.github.com/users/timothyqiu/followers","following_url":"https://api.github.com/users/timothyqiu/following{/other_user}","gists_url":"https://api.github.com/users/timothyqiu/gists{/gist_id}","starred_url":"https://api.github.com/users/timothyqiu/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/timothyqiu/subscriptions","organizations_url":"https://api.github.com/users/timothyqiu/orgs","repos_url":"https://api.github.com/users/timothyqiu/repos","events_url":"https://api.github.com/users/timothyqiu/events{/privacy}","received_events_url":"https://api.github.com/users/timothyqiu/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-12-08T03:39:17Z","updated_at":"2025-12-08T03:41:17Z","body":"Upon further investigation, I discovered that my previous description was incorrect. My system does support `org.freedesktop.portal.Screenshot`, but the invocation consistently fails.\n\nEach time the color picker button is clicked, `xdg-desktop-portal-xapp` outputs an error in its log:\n\n```\nFailed to pick color: Cannot invoke method; proxy is for the well-known name org.Cinnamon without an owner, and proxy was constructed with the G_DBUS_PROXY_FLAGS_DO_NOT_AUTO_START flag\n```\n\nLooks like the root cause is an `xdg-desktop-portal-xapp` problem as it does not seem to send a relevant error response upon failure.[^1]\n\nDuring the investigation, I also discovered that Godot does not fall back to the legacy implementation when the portal implementation reports a picking failure. I'm unsure if this is the intended behavior. If it is expected, I believe this issue can be closed.\n\n[^1]: https://github.com/linuxmint/xdg-desktop-portal-xapp/blame/1b59f2c3c69f7f652a2de1c5575583c3d3c03211/src/screenshot.c#L130","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3624501772/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3625158662","html_url":"https://github.com/godotengine/godot/issues/113636#issuecomment-3625158662","issue_url":"https://api.github.com/repos/godotengine/godot/issues/113636","id":3625158662,"node_id":"IC_kwDOAO6SJc7YE4gG","user":{"login":"bruvzg","id":7645683,"node_id":"MDQ6VXNlcjc2NDU2ODM=","avatar_url":"https://avatars.githubusercontent.com/u/7645683?v=4","gravatar_id":"","url":"https://api.github.com/users/bruvzg","html_url":"https://github.com/bruvzg","followers_url":"https://api.github.com/users/bruvzg/followers","following_url":"https://api.github.com/users/bruvzg/following{/other_user}","gists_url":"https://api.github.com/users/bruvzg/gists{/gist_id}","starred_url":"https://api.github.com/users/bruvzg/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/bruvzg/subscriptions","organizations_url":"https://api.github.com/users/bruvzg/orgs","repos_url":"https://api.github.com/users/bruvzg/repos","events_url":"https://api.github.com/users/bruvzg/events{/privacy}","received_events_url":"https://api.github.com/users/bruvzg/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-12-08T06:11:27Z","updated_at":"2025-12-08T06:11:27Z","body":"> Looks like the root cause is an xdg-desktop-portal-xapp problem as it does not seem to send a relevant error response upon failure.\n\nhttps://flatpak.github.io/xdg-desktop-portal/docs/doc-org.freedesktop.portal.Request.html#org-freedesktop-portal-request-response\n\n`response = 1` is canceled by user, not failed, it won't be correct to use fallback in this state.\n`response = 2` is `interaction was ended in some other way`, so not sure if this is intended to indicate a failure. Currently, Godot is only checking if it's `0` and assume any other value is `cancel`. Fallback is used if interface is not available or request fail.","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3625158662/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3625636888","html_url":"https://github.com/godotengine/godot/issues/113636#issuecomment-3625636888","issue_url":"https://api.github.com/repos/godotengine/godot/issues/113636","id":3625636888,"node_id":"IC_kwDOAO6SJc7YGtQY","user":{"login":"timothyqiu","id":372476,"node_id":"MDQ6VXNlcjM3MjQ3Ng==","avatar_url":"https://avatars.githubusercontent.com/u/372476?v=4","gravatar_id":"","url":"https://api.github.com/users/timothyqiu","html_url":"https://github.com/timothyqiu","followers_url":"https://api.github.com/users/timothyqiu/followers","following_url":"https://api.github.com/users/timothyqiu/following{/other_user}","gists_url":"https://api.github.com/users/timothyqiu/gists{/gist_id}","starred_url":"https://api.github.com/users/timothyqiu/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/timothyqiu/subscriptions","organizations_url":"https://api.github.com/users/timothyqiu/orgs","repos_url":"https://api.github.com/users/timothyqiu/repos","events_url":"https://api.github.com/users/timothyqiu/events{/privacy}","received_events_url":"https://api.github.com/users/timothyqiu/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-12-08T08:31:09Z","updated_at":"2025-12-08T08:31:09Z","body":"Makes sense. Closing as the main cause is not from the Godot side.","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3625636888/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null}]