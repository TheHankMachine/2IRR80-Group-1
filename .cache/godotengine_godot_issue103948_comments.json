57305?v=4","gravatar_id":"","url":"https://api.github.com/users/BenLubar","html_url":"https://github.com/BenLubar","followers_url":"https://api.github.com/users/BenLubar/followers","following_url":"https://api.github.com/users/BenLubar/following{/other_user}","gists_url":"https://api.github.com/users/BenLubar/gists{/gist_id}","starred_url":"https://api.github.com/users/BenLubar/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/BenLubar/subscriptions","organizations_url":"https://api.github.com/users/BenLubar/orgs","repos_url":"https://api.github.com/users/BenLubar/repos","events_url":"https://api.github.com/users/BenLubar/events{/privacy}","received_events_url":"https://api.github.com/users/BenLubar/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-03-11T03:10:35Z","updated_at":"2025-03-11T03:10:35Z","body":"Amended to remove a tab that the style checker didn't like.\r\n\r\n> Shouldn't this be a shadow_mesh property?\r\n\r\nUnless there's a way to set the shadow mesh on an `ImporterMesh`, I don't think that would make sense.\r\n\r\nI'm not opposed to it, but other things in Godot that only have getters don't have properties associated with them.","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2712452326/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2713260278","html_url":"https://github.com/godotengine/godot/pull/103948#issuecomment-2713260278","issue_url":"https://api.github.com/repos/godotengine/godot/issues/103948","id":2713260278,"node_id":"IC_kwDOAO6SJc6huRD2","user":{"login":"AThousandShips","id":96648715,"node_id":"U_kgDOBcK-Cw","avatar_url":"https://avatars.githubusercontent.com/u/96648715?v=4","gravatar_id":"","url":"https://api.github.com/users/AThousandShips","html_url":"https://github.com/AThousandShips","followers_url":"https://api.github.com/users/AThousandShips/followers","following_url":"https://api.github.com/users/AThousandShips/following{/other_user}","gists_url":"https://api.github.com/users/AThousandShips/gists{/gist_id}","starred_url":"https://api.github.com/users/AThousandShips/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/AThousandShips/subscriptions","organizations_url":"https://api.github.com/users/AThousandShips/orgs","repos_url":"https://api.github.com/users/AThousandShips/repos","events_url":"https://api.github.com/users/AThousandShips/events{/privacy}","received_events_url":"https://api.github.com/users/AThousandShips/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-03-11T09:11:59Z","updated_at":"2025-03-11T09:11:59Z","body":"In the future, please comment on the original PR to ask for a rebase. If nothing happens, wait at least a week before opening a new PR to salvage it.","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2713260278/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2713833857","html_url":"https://github.com/godotengine/godot/pull/103948#issuecomment-2713833857","issue_url":"https://api.github.com/repos/godotengine/godot/issues/103948","id":2713833857,"node_id":"IC_kwDOAO6SJc6hwdGB","user":{"login":"BenLubar","id":4257305,"node_id":"MDQ6VXNlcjQyNTczMDU=","avatar_url":"https://avatars.githubusercontent.com/u/4257305?v=4","gravatar_id":"","url":"https://api.github.com/users/BenLubar","html_url":"https://github.com/BenLubar","followers_url":"https://api.github.com/users/BenLubar/followers","following_url":"https://api.github.com/users/BenLubar/following{/other_user}","gists_url":"https://api.github.com/users/BenLubar/gists{/gist_id}","starred_url":"https://api.github.com/users/BenLubar/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/BenLubar/subscriptions","organizations_url":"https://api.github.com/users/BenLubar/orgs","repos_url":"https://api.github.com/users/BenLubar/repos","events_url":"https://api.github.com/users/BenLubar/events{/privacy}","received_events_url":"https://api.github.com/users/BenLubar/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-03-11T11:41:47Z","updated_at":"2025-03-11T11:41:47Z","body":"> In the future, please comment on the original PR to ask for a rebase. If nothing happens, wait at least a week before opening a new PR to salvage it.\r\n\r\n:+1: I figured someone else asking in October shortly after the PR was last updated was good enough.\r\n\r\n> These need descriptions\r\n\r\nAdded.\r\n\r\n---\r\n\r\nSeparately from the changes in this PR, the code for `create_shadow_mesh` looks like it would do the wrong thing for a mesh that doesn't have indices. (It removes vertices without creating the array that tells the GPU where to look for each vertex if there are no indices in the original mesh.)\r\n\r\nAnd `clear` doesn't affect the shadow mesh, but that's fine as long as any code that's reusing an `ImporterMesh` calls or doesn't call `create_shadow_mesh` consistently.\r\n\r\nI can create issues for these if that's useful.","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2713833857/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null}]