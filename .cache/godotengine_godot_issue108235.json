":"MDU6TGFiZWwyNjY2NzA4Mjg5","url":"https://api.github.com/repos/godotengine/godot/labels/topic:3d","name":"topic:3d","color":"ffee88","default":false,"description":"","archived_at":null,"archived_by":null},{"id":3240950060,"node_id":"MDU6TGFiZWwzMjQwOTUwMDYw","url":"https://api.github.com/repos/godotengine/godot/labels/performance","name":"performance","color":"447777","default":false,"description":"","archived_at":null,"archived_by":null}],"state":"closed","locked":false,"assignees":[],"milestone":{"url":"https://api.github.com/repos/godotengine/godot/milestones/22","html_url":"https://github.com/godotengine/godot/milestone/22","labels_url":"https://api.github.com/repos/godotengine/godot/milestones/22/labels","id":12070367,"node_id":"MI_kwDOAO6SJc4AuC3f","number":22,"title":"4.5","description":"","creator":{"login":"Sauermann","id":6299227,"node_id":"MDQ6VXNlcjYyOTkyMjc=","avatar_url":"https://avatars.githubusercontent.com/u/6299227?v=4","gravatar_id":"","url":"https://api.github.com/users/Sauermann","html_url":"https://github.com/Sauermann","followers_url":"https://api.github.com/users/Sauermann/followers","following_url":"https://api.github.com/users/Sauermann/following{/other_user}","gists_url":"https://api.github.com/users/Sauermann/gists{/gist_id}","starred_url":"https://api.github.com/users/Sauermann/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Sauermann/subscriptions","organizations_url":"https://api.github.com/users/Sauermann/orgs","repos_url":"https://api.github.com/users/Sauermann/repos","events_url":"https://api.github.com/users/Sauermann/events{/privacy}","received_events_url":"https://api.github.com/users/Sauermann/received_events","type":"User","user_view_type":"public","site_admin":false},"open_issues":3,"closed_issues":3687,"state":"closed","created_at":"2024-12-19T08:51:28Z","updated_at":"2026-09-04T21:48:38Z","due_on":"2025-09-15T00:00:00Z","closed_at":"2025-09-18T17:13:14Z"},"comments":1,"created_at":"2025-07-03T12:40:11Z","updated_at":"2025-07-03T17:51:50Z","closed_at":"2025-07-03T17:27:12Z","assignee":null,"author_association":"CONTRIBUTOR","issue_field_values":[],"type":null,"active_lock_reason":null,"draft":false,"pull_request":{"url":"https://api.github.com/repos/godotengine/godot/pulls/108235","html_url":"https://github.com/godotengine/godot/pull/108235","diff_url":"https://github.com/godotengine/godot/pull/108235.diff","patch_url":"https://github.com/godotengine/godot/pull/108235.patch","merged_at":"2025-07-03T17:27:12Z"},"body":"This addresses a very minor performance issue when using Jolt Physics and dealing with objects that all have their shapes set to be `disabled`. In such a case, they would get a special \"empty\" shape type that technically ignores all collisions already, but which will still add overhead during the narrow-phase collision checks.\r\n\r\nThis is mentioned in [the documentation](https://jrouwe.github.io/JoltPhysics/class_empty_shape.html) for Jolt's `JPH::EmptyShape`:\r\n\r\n> Note that, if possible, you should also put your body in an ObjectLayer that doesn't collide with anything. This ensures that collisions will be filtered out at broad phase level instead of at narrow phase level, this is more efficient.\r\n\r\nThis PR achieves this by simply treating shapeless objects as if they have both `collision_layer` and `collision_mask` set to 0, in which case any collision checks against such an object will be filtered out in `JoltLayers::ShouldCollide(JPH::ObjectLayer, JPH::ObjectLayer)`.\r\n\r\nIf you want to see the performance gain for yourself, [this very contrived MRP](https://github.com/user-attachments/files/21036993/jolt-shapeless-perf.zip) creates 500 always-awake `RigidBody3D` on top of eachother, that all have their shapes disabled. I see physics processing time go from roughly 3 ms to 0.8 ms.\r\n\r\nThis should be a very low risk change, so I'll queue it up for 4.5, but it's arguably low reward as well, so I'm happy to punt it to 4.6.","closed_by":{"login":"Repiteo","id":17489292,"node_id":"MDQ6VXNlcjE3NDg5Mjky","avatar_url":"https://avatars.githubusercontent.com/u/17489292?v=4","gravatar_id":"","url":"https://api.github.com/users/Repiteo","html_url":"https://github.com/Repiteo","followers_url":"https://api.github.com/users/Repiteo/followers","following_url":"https://api.github.com/users/Repiteo/following{/other_user}","gists_url":"https://api.github.com/users/Repiteo/gists{/gist_id}","starred_url":"https://api.github.com/users/Repiteo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Repiteo/subscriptions","organizations_url":"https://api.github.com/users/Repiteo/orgs","repos_url":"https://api.github.com/users/Repiteo/repos","events_url":"https://api.github.com/users/Repiteo/events{/privacy}","received_events_url":"https://api.github.com/users/Repiteo/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/108235/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/godotengine/godot/issues/108235/timeline","performed_via_github_app":null,"state_reason":null}