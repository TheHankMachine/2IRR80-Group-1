s://avatars.githubusercontent.com/u/19652075?v=4","gravatar_id":"","url":"https://api.github.com/users/PabloDevGit","html_url":"https://github.com/PabloDevGit","followers_url":"https://api.github.com/users/PabloDevGit/followers","following_url":"https://api.github.com/users/PabloDevGit/following{/other_user}","gists_url":"https://api.github.com/users/PabloDevGit/gists{/gist_id}","starred_url":"https://api.github.com/users/PabloDevGit/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/PabloDevGit/subscriptions","organizations_url":"https://api.github.com/users/PabloDevGit/orgs","repos_url":"https://api.github.com/users/PabloDevGit/repos","events_url":"https://api.github.com/users/PabloDevGit/events{/privacy}","received_events_url":"https://api.github.com/users/PabloDevGit/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-06-06T06:52:52Z","updated_at":"2025-06-06T06:52:52Z","body":"With compatibility mode, it also works without issues.\n","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2948280901/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2948418110","html_url":"https://github.com/godotengine/godot/issues/107140#issuecomment-2948418110","issue_url":"https://api.github.com/repos/godotengine/godot/issues/107140","id":2948418110,"node_id":"IC_kwDOAO6SJc6vvUo-","user":{"login":"bruvzg","id":7645683,"node_id":"MDQ6VXNlcjc2NDU2ODM=","avatar_url":"https://avatars.githubusercontent.com/u/7645683?v=4","gravatar_id":"","url":"https://api.github.com/users/bruvzg","html_url":"https://github.com/bruvzg","followers_url":"https://api.github.com/users/bruvzg/followers","following_url":"https://api.github.com/users/bruvzg/following{/other_user}","gists_url":"https://api.github.com/users/bruvzg/gists{/gist_id}","starred_url":"https://api.github.com/users/bruvzg/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/bruvzg/subscriptions","organizations_url":"https://api.github.com/users/bruvzg/orgs","repos_url":"https://api.github.com/users/bruvzg/repos","events_url":"https://api.github.com/users/bruvzg/events{/privacy}","received_events_url":"https://api.github.com/users/bruvzg/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-06-06T07:58:48Z","updated_at":"2025-06-06T08:03:34Z","body":"> Every time the cursor moves from one monitor to the other, flickering happens on the monitor that contains Godot in fullscreen mode.\n\nThis is pretty usual for exclusive full-screen, specific behavior depends on the renderer and GPU drivers a lot. Making borderless window with the size of a screen won't help, since drivers almost will always force it to exclusive mode as well.\n\nIn 4.x there's a dedicated non-exclusive fullscreen mode (`MODE_FULLSCREEN` - used by editor, `MODE_EXCLUSIVE_FULLSCREEN` is equivalent of 3.x fullscreen) specifically to allow interactions outside the full-screen window.","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2948418110/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2970966811","html_url":"https://github.com/godotengine/godot/issues/107140#issuecomment-2970966811","issue_url":"https://api.github.com/repos/godotengine/godot/issues/107140","id":2970966811,"node_id":"IC_kwDOAO6SJc6xFVsb","user":{"login":"KeyboardDanni","id":34800072,"node_id":"MDQ6VXNlcjM0ODAwMDcy","avatar_url":"https://avatars.githubusercontent.com/u/34800072?v=4","gravatar_id":"","url":"https://api.github.com/users/KeyboardDanni","html_url":"https://github.com/KeyboardDanni","followers_url":"https://api.github.com/users/KeyboardDanni/followers","following_url":"https://api.github.com/users/KeyboardDanni/following{/other_user}","gists_url":"https://api.github.com/users/KeyboardDanni/gists{/gist_id}","starred_url":"https://api.github.com/users/KeyboardDanni/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/KeyboardDanni/subscriptions","organizations_url":"https://api.github.com/users/KeyboardDanni/orgs","repos_url":"https://api.github.com/users/KeyboardDanni/repos","events_url":"https://api.github.com/users/KeyboardDanni/events{/privacy}","received_events_url":"https://api.github.com/users/KeyboardDanni/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-06-13T16:57:42Z","updated_at":"2025-06-13T16:57:42Z","body":"My humble opinion is that defeating direct scanout should only be done as a last resort because going through the compositor is likely to introduce jitter/stutter. It also might not even work on Windows 11 due to improvements to windowed optimizations.\n\nQuestions for OP:\n\n- Is MPO enabled or disabled in driver settings?\n- Is there a mismatch between the displays in terms of DPI scaling, refresh rate, or G-Sync/FreeSync availability?\n- In the nVidia Control Panel, is \"Vulkan/OpenGL present method\" set to \"Prefer native\" or \"Prefer layered on DXGI Swapchain\"?","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2970966811/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3237338186","html_url":"https://github.com/godotengine/godot/issues/107140#issuecomment-3237338186","issue_url":"https://api.github.com/repos/godotengine/godot/issues/107140","id":3237338186,"node_id":"IC_kwDOAO6SJc7A9dxK","user":{"login":"lawnjelly","id":21999379,"node_id":"MDQ6VXNlcjIxOTk5Mzc5","avatar_url":"https://avatars.githubusercontent.com/u/21999379?v=4","gravatar_id":"","url":"https://api.github.com/users/lawnjelly","html_url":"https://github.com/lawnjelly","followers_url":"https://api.github.com/users/lawnjelly/followers","following_url":"https://api.github.com/users/lawnjelly/following{/other_user}","gists_url":"https://api.github.com/users/lawnjelly/gists{/gist_id}","starred_url":"https://api.github.com/users/lawnjelly/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/lawnjelly/subscriptions","organizations_url":"https://api.github.com/users/lawnjelly/orgs","repos_url":"https://api.github.com/users/lawnjelly/repos","events_url":"https://api.github.com/users/lawnjelly/events{/privacy}","received_events_url":"https://api.github.com/users/lawnjelly/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-08-29T14:57:59Z","updated_at":"2025-08-29T14:57:59Z","body":"Fixed by #107583 .","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3237338186/reactions","total_count":2,"+1":2,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null}]