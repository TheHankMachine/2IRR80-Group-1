o/repos","events_url":"https://api.github.com/users/Akosmo/events{/privacy}","received_events_url":"https://api.github.com/users/Akosmo/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-06-12T17:33:29Z","updated_at":"2026-06-12T17:33:29Z","body":"Cannot reproduce this either. v4.7.rc2.official [3df26a02c]\n@chamelopi if you're having this issue on newer versions, could you provide an MRP? Would be great if you could also tell us the latest version things worked correctly, if any.","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4693726040/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4882152222","html_url":"https://github.com/godotengine/godot/issues/107644#issuecomment-4882152222","issue_url":"https://api.github.com/repos/godotengine/godot/issues/107644","id":4882152222,"node_id":"IC_kwDOAO6SJc8AAAABIv-7Hg","user":{"login":"chamelopi","id":20842395,"node_id":"MDQ6VXNlcjIwODQyMzk1","avatar_url":"https://avatars.githubusercontent.com/u/20842395?v=4","gravatar_id":"","url":"https://api.github.com/users/chamelopi","html_url":"https://github.com/chamelopi","followers_url":"https://api.github.com/users/chamelopi/followers","following_url":"https://api.github.com/users/chamelopi/following{/other_user}","gists_url":"https://api.github.com/users/chamelopi/gists{/gist_id}","starred_url":"https://api.github.com/users/chamelopi/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/chamelopi/subscriptions","organizations_url":"https://api.github.com/users/chamelopi/orgs","repos_url":"https://api.github.com/users/chamelopi/repos","events_url":"https://api.github.com/users/chamelopi/events{/privacy}","received_events_url":"https://api.github.com/users/chamelopi/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-07-04T13:23:23Z","updated_at":"2026-07-04T13:23:23Z","body":"> Cannot reproduce this either. v4.7.rc2.official [[3df26a0](https://github.com/godotengine/godot/commit/3df26a02c446710c979daa541b74f87edeca81b0)] [@chamelopi](https://github.com/chamelopi) if you're having this issue on newer versions, could you provide an MRP? Would be great if you could also tell us the latest version things worked correctly, if any.\n\nSorry for the very late reply, I did not get a notification for this comment for some reason.\n\nWill try to create an MRP! I don't think I could easily provide a last working version for this, since I started this project on 4.6 🤔 But maybe we can figure it out from the MRP.","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4882152222/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4882239523","html_url":"https://github.com/godotengine/godot/issues/107644#issuecomment-4882239523","issue_url":"https://api.github.com/repos/godotengine/godot/issues/107644","id":4882239523,"node_id":"IC_kwDOAO6SJc8AAAABIwEQIw","user":{"login":"chamelopi","id":20842395,"node_id":"MDQ6VXNlcjIwODQyMzk1","avatar_url":"https://avatars.githubusercontent.com/u/20842395?v=4","gravatar_id":"","url":"https://api.github.com/users/chamelopi","html_url":"https://github.com/chamelopi","followers_url":"https://api.github.com/users/chamelopi/followers","following_url":"https://api.github.com/users/chamelopi/following{/other_user}","gists_url":"https://api.github.com/users/chamelopi/gists{/gist_id}","starred_url":"https://api.github.com/users/chamelopi/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/chamelopi/subscriptions","organizations_url":"https://api.github.com/users/chamelopi/orgs","repos_url":"https://api.github.com/users/chamelopi/repos","events_url":"https://api.github.com/users/chamelopi/events{/privacy}","received_events_url":"https://api.github.com/users/chamelopi/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-07-04T13:46:25Z","updated_at":"2026-07-04T13:46:25Z","body":"Okay, this was a problem on my end, sorry. My `handler()` function above kept getting called again and again, restarting the sound effect every time, so that `finished` was never emitted. So I'm pretty sure that this is not a bug, or at least, I can no longer reproduce it this way when I fix that issue. Basically I had\n\n```gdscript\nfunc _physics_process(_delta: float) -> void:\n    if falling:\n        var collision = get_last_slide_collision()\n        if collision and collision.get_collider() is TileMapLayer:\n            handler()\n```\n\nBut what I needed was\n\n```gdscript\nfunc _physics_process(_delta: float) -> void:\n    if falling:\n        var collision = get_last_slide_collision()\n        if collision and collision.get_collider() is TileMapLayer:\n            # Stop handler from being called multiple times\n            falling = false\n            handler()\n```\n\n-> Can no longer reproduce this. The minimal project I tested & fixed this in is here, in case that helps anyone https://github.com/chamelopi/audiostreamplayer-finished-signal-repro\n\n@Akosmo I am not the original reporter of this bug, but the problem I had at least was on my end :) Sorry for the confusion and for stealing your time for this. Probably this issue can be closed","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4882239523/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4882260938","html_url":"https://github.com/godotengine/godot/issues/107644#issuecomment-4882260938","issue_url":"https://api.github.com/repos/godotengine/godot/issues/107644","id":4882260938,"node_id":"IC_kwDOAO6SJc8AAAABIwFjyg","user":{"login":"Akosmo","id":95504962,"node_id":"U_kgDOBbFKQg","avatar_url":"https://avatars.githubusercontent.com/u/95504962?v=4","gravatar_id":"","url":"https://api.github.com/users/Akosmo","html_url":"https://github.com/Akosmo","followers_url":"https://api.github.com/users/Akosmo/followers","following_url":"https://api.github.com/users/Akosmo/following{/other_user}","gists_url":"https://api.github.com/users/Akosmo/gists{/gist_id}","starred_url":"https://api.github.com/users/Akosmo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Akosmo/subscriptions","organizations_url":"https://api.github.com/users/Akosmo/orgs","repos_url":"https://api.github.com/users/Akosmo/repos","events_url":"https://api.github.com/users/Akosmo/events{/privacy}","received_events_url":"https://api.github.com/users/Akosmo/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-07-04T13:53:37Z","updated_at":"2026-07-04T13:53:37Z","body":"No worries! Thanks for the help :)","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4882260938/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null}]