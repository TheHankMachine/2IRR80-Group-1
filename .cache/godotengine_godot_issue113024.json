MDU6TGFiZWwzNjI0ODM0NzY=","url":"https://api.github.com/repos/godotengine/godot/labels/tracker","name":"tracker","color":"ffddcc","default":false,"description":"","archived_at":null,"archived_by":null}],"state":"closed","locked":false,"assignees":[],"milestone":{"url":"https://api.github.com/repos/godotengine/godot/milestones/24","html_url":"https://github.com/godotengine/godot/milestone/24","labels_url":"https://api.github.com/repos/godotengine/godot/milestones/24/labels","id":14236899,"node_id":"MI_kwDOAO6SJc4A2Tzj","number":24,"title":"4.7","description":"","creator":{"login":"akien-mga","id":4701338,"node_id":"MDQ6VXNlcjQ3MDEzMzg=","avatar_url":"https://avatars.githubusercontent.com/u/4701338?v=4","gravatar_id":"","url":"https://api.github.com/users/akien-mga","html_url":"https://github.com/akien-mga","followers_url":"https://api.github.com/users/akien-mga/followers","following_url":"https://api.github.com/users/akien-mga/following{/other_user}","gists_url":"https://api.github.com/users/akien-mga/gists{/gist_id}","starred_url":"https://api.github.com/users/akien-mga/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/akien-mga/subscriptions","organizations_url":"https://api.github.com/users/akien-mga/orgs","repos_url":"https://api.github.com/users/akien-mga/repos","events_url":"https://api.github.com/users/akien-mga/events{/privacy}","received_events_url":"https://api.github.com/users/akien-mga/received_events","type":"User","user_view_type":"public","site_admin":false},"open_issues":3,"closed_issues":2535,"state":"closed","created_at":"2025-11-27T20:29:18Z","updated_at":"2026-10-20T18:39:31Z","due_on":null,"closed_at":"2026-06-19T16:54:35Z"},"comments":3,"created_at":"2025-11-21T21:12:29Z","updated_at":"2026-02-20T10:29:13Z","closed_at":"2026-02-20T10:29:03Z","assignee":null,"author_association":"MEMBER","issue_field_values":[],"type":null,"active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"### Tested versions\n\n4.6 after 67735cf213009c57e617f2dee7e1d7b0b8924366\n\n### Issue description\n\nNow that #108647 was merged, the bottom docks need to be upgraded. Currently they use the legacy `bottom_panel->add_item()` method to be added, which needs to be changed to `editor_dock_manager->add_dock()`, with the default slot being `DOCK_SLOT_BOTTOM`.\n\nList of docks that need to be converted:\n- [x] EditorLog* #113065\n- [x] AnimationPlayerEditor #113255\n- [x] AnimationTreeEditor #113255\n- [x] EditorAudioBuses #113241\n- [x] EditorDebuggerNode #113133\n- [x] ResourcePreloaderEditor #113257\n- [x] SpriteFramesEditor #113275\n- [x] _Polygon2DEditor_ #113338\n- [x] TileMapLayerEditor and TileSetEditor #113034\n- [x] ThemeEditor* #113108\n- [x] FindInFilesContainer* #113450\n- [x] _ShaderEditorPlugin_ #113181\n- [x] _VersionControlEditorPlugin_ #113454\n- [x] GridMapEditor #113396\n- [x] ReplicationEditor #113396\n- [x] OpenXRActionMapEditor #113457\n- [x] MSBuildPanel #113115\n- [x] ShaderFileEditor #113616\n\nI will be converting them myself, but feel free to help. I marked with * docks that I will have to convert, because they will require some changes to the dock system. The _cursive_ ones are using a secondary container, so may not be possible to be directly converted. MSBuildPanel is written in C#.\n\nThe general instructions for converting a dock are:\n- Change the class to inherit EditorDock.\n- Make sure the layout is not broken (if the class wasn't MarginContainer).\n- Replace bottom_panel->add_item() with editor_dock_manager->add_dock()\n- Setup EditorDock properties (title, shortcut), set available layouts to HORIZONTAL and default slot to BOTTOM.\n- Determine whether the dock should be global (appear in Editor>Docks menu). Most likely only applies to permanent docks (Audio, Animation etc.)\n- See if the dock can work with other layouts (vertical, floating). Note that supporting vertical layout may require some changes in the dock's structure.\n- Resolve dock-related TODOs and remove/replace legacy stuff (like Shader Editor's WindowWrapper/float button, or the Debugger tab TODO)\n- Ideally, each dock should also get an icon, but it can be added separately from the conversion.\n","closed_by":{"login":"KoBeWi","id":2223172,"node_id":"MDQ6VXNlcjIyMjMxNzI=","avatar_url":"https://avatars.githubusercontent.com/u/2223172?v=4","gravatar_id":"","url":"https://api.github.com/users/KoBeWi","html_url":"https://github.com/KoBeWi","followers_url":"https://api.github.com/users/KoBeWi/followers","following_url":"https://api.github.com/users/KoBeWi/following{/other_user}","gists_url":"https://api.github.com/users/KoBeWi/gists{/gist_id}","starred_url":"https://api.github.com/users/KoBeWi/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/KoBeWi/subscriptions","organizations_url":"https://api.github.com/users/KoBeWi/orgs","repos_url":"https://api.github.com/users/KoBeWi/repos","events_url":"https://api.github.com/users/KoBeWi/events{/privacy}","received_events_url":"https://api.github.com/users/KoBeWi/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/113024/reactions","total_count":17,"+1":14,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":3},"timeline_url":"https://api.github.com/repos/godotengine/godot/issues/113024/timeline","performed_via_github_app":null,"state_reason":"completed","pinned_comment":null}