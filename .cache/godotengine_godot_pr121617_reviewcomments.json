PAGATE expects an Error-returning expression\"); \\\r\n\t\treturn _err_propagate_error; \\\r\n```\r\nThis keeps the tighly-packed formatting of the original, but propogates (heh) the type error only when attempting the return:\r\n```\r\nStatic assertion failed due to requirement 'std::is_same_v<float, Error>': ERR_PROPAGATE expects an Error-returning expressionclang(static_assert_requirement_failed)\r\nCannot initialize return object of type 'Error' with an lvalue of type 'float'\r\n```","created_at":"2026-07-22T15:01:17Z","updated_at":"2026-07-22T15:01:52Z","html_url":"https://github.com/godotengine/godot/pull/121617#discussion_r3631340937","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/121617","_links":{"self":{"href":"https://api.github.com/repos/godotengine/godot/pulls/comments/3631340937"},"html":{"href":"https://github.com/godotengine/godot/pull/121617#discussion_r3631340937"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/121617"}},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/3631340937/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":133,"original_start_line":126,"start_side":"RIGHT","line":135,"original_line":128,"side":"RIGHT","in_reply_to_id":3631005245,"author_association":"CONTRIBUTOR","original_position":10,"position":10,"subject_type":"line"},{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/3631936851","pull_request_review_id":4756474471,"id":3631936851,"node_id":"PRRC_kwDOAO6SJc7YevVT","diff_hunk":"@@ -119,6 +119,16 @@ void _physics_interpolation_warning(const char *p_function, const char *p_file,\n  * issues when expanded e.g. after an `if (cond) ERR_FAIL();` without braces.\n  */\n \n+/**\n+ * Evaluate the expression. If it results in an Error != OK, silently return the error.\n+ */\n+#define ERR_PROPAGATE(m_exp) \\\n+\tif (Error _err_propagate_error = (m_exp); unlikely(_err_propagate_error != OK)) { \\\n+\t\tstatic_assert(std::is_same_v<std::decay_t<decltype(m_exp)>, Error>, \"ERR_PROPAGATE expects an Error-returning expression\"); \\\n+\t\treturn _err_propagate_error; \\","path":"core/error/error_macros.h","commit_id":"00120405f4e26933b6a4429331a7d0d0b3a60dc3","original_commit_id":"0234cfc0c996f3e17d20a9b4861b236946cdd87e","user":{"login":"Ivorforce","id":2308167,"node_id":"MDQ6VXNlcjIzMDgxNjc=","avatar_url":"https://avatars.githubusercontent.com/u/2308167?v=4","gravatar_id":"","url":"https://api.github.com/users/Ivorforce","html_url":"https://github.com/Ivorforce","followers_url":"https://api.github.com/users/Ivorforce/followers","following_url":"https://api.github.com/users/Ivorforce/following{/other_user}","gists_url":"https://api.github.com/users/Ivorforce/gists{/gist_id}","starred_url":"https://api.github.com/users/Ivorforce/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Ivorforce/subscriptions","organizations_url":"https://api.github.com/users/Ivorforce/orgs","repos_url":"https://api.github.com/users/Ivorforce/repos","events_url":"https://api.github.com/users/Ivorforce/events{/privacy}","received_events_url":"https://api.github.com/users/Ivorforce/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"That's an interesting idea too :)\r\nPractically the reason I have the `static_assert` is not to improve the error message, but to avoid implicit conversion to `Error` because `Error` is not an `enum class`. So it implicitly converts from and to `int` which would defeat the purpose of adding the macro only for errors.\r\n\r\nThat being said, I'm open to the `auto` approach if you think we should improve upon the standard compiler message for mismatching types.","created_at":"2026-07-22T16:22:17Z","updated_at":"2026-07-22T16:22:17Z","html_url":"https://github.com/godotengine/godot/pull/121617#discussion_r3631936851","pull_request_url":"https://api.github.com/repos/godo