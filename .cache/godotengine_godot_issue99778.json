ed":false,"assignees":[],"milestone":{"url":"https://api.github.com/repos/godotengine/godot/milestones/16","html_url":"https://github.com/godotengine/godot/milestone/16","labels_url":"https://api.github.com/repos/godotengine/godot/milestones/16/labels","id":8237783,"node_id":"MI_kwDOAO6SJc4AfbLX","number":16,"title":"4.x","description":"Issues and pull requests slated for an undetermined Godot 4 release.","creator":{"login":"akien-mga","id":4701338,"node_id":"MDQ6VXNlcjQ3MDEzMzg=","avatar_url":"https://avatars.githubusercontent.com/u/4701338?v=4","gravatar_id":"","url":"https://api.github.com/users/akien-mga","html_url":"https://github.com/akien-mga","followers_url":"https://api.github.com/users/akien-mga/followers","following_url":"https://api.github.com/users/akien-mga/following{/other_user}","gists_url":"https://api.github.com/users/akien-mga/gists{/gist_id}","starred_url":"https://api.github.com/users/akien-mga/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/akien-mga/subscriptions","organizations_url":"https://api.github.com/users/akien-mga/orgs","repos_url":"https://api.github.com/users/akien-mga/repos","events_url":"https://api.github.com/users/akien-mga/events{/privacy}","received_events_url":"https://api.github.com/users/akien-mga/received_events","type":"User","user_view_type":"public","site_admin":false},"open_issues":5790,"closed_issues":0,"state":"open","created_at":"2022-07-26T12:42:05Z","updated_at":"2026-10-22T08:16:48Z","due_on":null,"closed_at":null},"comments":12,"created_at":"2024-11-28T03:15:43Z","updated_at":"2026-02-17T20:10:45Z","closed_at":null,"assignee":null,"author_association":"CONTRIBUTOR","issue_field_values":[],"type":null,"active_lock_reason":null,"draft":false,"pull_request":{"url":"https://api.github.com/repos/godotengine/godot/pulls/99778","html_url":"https://github.com/godotengine/godot/pull/99778","diff_url":"https://github.com/godotengine/godot/pull/99778.diff","patch_url":"https://github.com/godotengine/godot/pull/99778.patch","merged_at":null},"body":"Add support for immutable variable using the `let` qualifier in GDScript. This variable must be assigned a value at the declaration site. It can never be modified after the initial assignment.\r\n\r\nNote that immutability differs from `const` as it can be applied to any runtime variable, whereas `const` requires that the expression be resolved at compile-time.\r\n\r\nImplements and closes https://github.com/godotengine/godot-proposals/issues/820_\r\n\r\nThis works in the following contexts:\r\n1. local variables.\r\n    * `let value = 10.0`\r\n2. function parameters\r\n    * add optional `let` in function signature to make immutable\r\n    * `func foo(let bar: float)`\r\n3. class level variables\r\n    * works for static variables\r\n    * works with @onready\r\n    * `@onready let parent = $\"..\"`\r\n\r\n![image](https://github.com/user-attachments/assets/ec133963-0aed-4db8-b0f5-b4ba9887cd36).\r\n\r\n=====\r\n\r\nTODO:\r\n\r\n- [ ] Reach consensus on syntax.\r\n- [ ] Explore where immutability should be checked at runtime. In the VM, or in `GDScriptInstance::set()`?\r\n- [ ] Condense the tests into shared files.\r\n\r\nFUTURE TODO (not in the scope of this change):\r\n- Would be nice to not require an initial assignment at the declaration site, but still guarantee it is set only one time.\r\n     * e.g. could be set individually in each branch of a match statement\r\n     * e.g. could be set once in the constructor or ready()\r\n     * Both these cases would throw an error if we attempt to access the value before it is assigned.\r\n","closed_by":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/99778/reactions","total_count":30,"+1":12,"-1":0,"laugh":0,"hooray":2,"confused":6,"heart":6,"rocket":0,"eyes":4},"timeline_url":"https://api.github.com/repos/godotengine/godot/issues/99778/timeline","performed_via_github_app":null,"state_reason":null}