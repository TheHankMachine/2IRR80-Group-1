-657a-4179-b4e5-5c7d772547d1\" />\r\n\r\nThe results are a little blurrier, but this is intended since it allows the screen-space antialiasing to do its job correctly. Edge coverage works a lot better than in `master`.","state":"APPROVED","html_url":"https://github.com/godotengine/godot/pull/113413#pullrequestreview-3527447655","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/113413","author_association":"MEMBER","_links":{"html":{"href":"https://github.com/godotengine/godot/pull/113413#pullrequestreview-3527447655"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/113413"}},"submitted_at":"2025-12-01T23:05:43Z","commit_id":null},{"id":3646391563,"node_id":"PRR_kwDOAO6SJc7ZV4UL","user":{"login":"Kaleb-Reid","id":78945904,"node_id":"MDQ6VXNlcjc4OTQ1OTA0","avatar_url":"https://avatars.githubusercontent.com/u/78945904?v=4","gravatar_id":"","url":"https://api.github.com/users/Kaleb-Reid","html_url":"https://github.com/Kaleb-Reid","followers_url":"https://api.github.com/users/Kaleb-Reid/followers","following_url":"https://api.github.com/users/Kaleb-Reid/following{/other_user}","gists_url":"https://api.github.com/users/Kaleb-Reid/gists{/gist_id}","starred_url":"https://api.github.com/users/Kaleb-Reid/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Kaleb-Reid/subscriptions","organizations_url":"https://api.github.com/users/Kaleb-Reid/orgs","repos_url":"https://api.github.com/users/Kaleb-Reid/repos","events_url":"https://api.github.com/users/Kaleb-Reid/events{/privacy}","received_events_url":"https://api.github.com/users/Kaleb-Reid/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"","state":"COMMENTED","html_url":"https://github.com/godotengine/godot/pull/113413#pullrequestreview-3646391563","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/113413","author_association":"CONTRIBUTOR","_links":{"html":{"href":"https://github.com/godotengine/g