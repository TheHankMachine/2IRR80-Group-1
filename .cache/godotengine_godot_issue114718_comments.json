.github.com/users/brunosrz/followers","following_url":"https://api.github.com/users/brunosrz/following{/other_user}","gists_url":"https://api.github.com/users/brunosrz/gists{/gist_id}","starred_url":"https://api.github.com/users/brunosrz/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/brunosrz/subscriptions","organizations_url":"https://api.github.com/users/brunosrz/orgs","repos_url":"https://api.github.com/users/brunosrz/repos","events_url":"https://api.github.com/users/brunosrz/events{/privacy}","received_events_url":"https://api.github.com/users/brunosrz/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-01-09T01:14:05Z","updated_at":"2026-01-09T01:14:05Z","body":"Do you know where I used AI? I used it to understand how the engine's organization works, how the themedb works, I used it to create the XML documentation, the icons, and the markdowns that I presented.","author_association":"NONE","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3726636411/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3726646540","html_url":"https://github.com/godotengine/godot/pull/114718#issuecomment-3726646540","issue_url":"https://api.github.com/repos/godotengine/godot/issues/114718","id":3726646540,"node_id":"IC_kwDOAO6SJc7eIB0M","user":{"login":"brunosrz","id":244238563,"node_id":"U_kgDODo7I4w","avatar_url":"https://avatars.githubusercontent.com/u/244238563?v=4","gravatar_id":"","url":"https://api.github.com/users/brunosrz","html_url":"https://github.com/brunosrz","followers_url":"https://api.github.com/users/brunosrz/followers","following_url":"https://api.github.com/users/brunosrz/following{/other_user}","gists_url":"https://api.github.com/users/brunosrz/gists{/gist_id}","starred_url":"https://api.github.com/users/brunosrz/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/brunosrz/subscriptions","organizations_url":"https://api.github.com/users/brunosrz/orgs","repos_url":"https://api.github.com/users/brunosrz/repos","events_url":"https://api.github.com/users/brunosrz/events{/privacy}","received_events_url":"https://api.github.com/users/brunosrz/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-01-09T01:19:04Z","updated_at":"2026-01-09T01:19:39Z","body":"> Observe que já existe uma solicitação de pull request aberta implementando um nó de joystick virtual:\r\n> \r\n> * [Adicionar VirtualJoystick  #110933](https://github.com/godotengine/godot/pull/110933)\r\n\r\nHis system uses system/user-named input events similar to a touchpad button, mine doesn't; mine is an input device, hence the name \"Virtual Devices.\" It's not just a joystick; it consists of 5 non-abstract nodes plus 1 abstract node that is the virtual device and has logic for multitouch.","author_association":"NONE","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3726646540/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3726948185","html_url":"https://github.com/godotengine/godot/pull/114718#issuecomment-3726948185","issue_url":"https://api.github.com/repos/godotengine/godot/issues/114718","id":3726948185,"node_id":"IC_kwDOAO6SJc7eJLdZ","user":{"login":"Alex2782","id":41921395,"node_id":"MDQ6VXNlcjQxOTIxMzk1","avatar_url":"https://avatars.githubusercontent.com/u/41921395?v=4","gravatar_id":"","url":"https://api.github.com/users/Alex2782","html_url":"https://github.com/Alex2782","followers_url":"https://api.github.com/users/Alex2782/followers","following_url":"https://api.github.com/users/Alex2782/following{/other_user}","gists_url":"https://api.github.com/users/Alex2782/gists{/gist_id}","starred_url":"https://api.github.com/users/Alex2782/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Alex2782/subscriptions","organizations_url":"https://api.github.com/users/Alex2782/orgs","repos_url":"https://api.github.com/users/Alex2782/repos","events_url":"https://api.github.com/users/Alex2782/events{/privacy}","received_events_url":"https://api.github.com/users/Alex2782/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-01-09T03:34:38Z","updated_at":"2026-01-09T03:46:35Z","body":"> I tested what I did by compiling the engine and testing it in practice in games. I sent the executable to friends who also tested it. It didn't pass your criteria or the GitHub Actions criteria, but to say that I didn't test it is the same as throwing away two months of my work. You're saying it's unfair for me to submit the commit for you to review and test, but what about me, who's being penalized when I'm just trying to contribute to your work?\r\n\r\nThat sounds amazing if it works in your games! \r\nWhy didn't you attach any pictures and videos showing your hard two months of work in action? \r\n\r\n\r\nYou need to understand that there are strict guidelines; every new line of text increases the effort required to maintain the code. **Step 1** is to read and understand this and try to follow it as best you can to reduce maintenance for everyone involved: https://contributing.godotengine.org/en/latest/pull_requests/pr_workflow.html\r\n\r\nHowever, after seeing the PR description and your proposal, I’m afraid that you won’t make an effort to read it carefully or to understand it.","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3726948185/reactions","total_count":5,"+1":5,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null}]