08167?v=4","gravatar_id":"","url":"https://api.github.com/users/Ivorforce","html_url":"https://github.com/Ivorforce","followers_url":"https://api.github.com/users/Ivorforce/followers","following_url":"https://api.github.com/users/Ivorforce/following{/other_user}","gists_url":"https://api.github.com/users/Ivorforce/gists{/gist_id}","starred_url":"https://api.github.com/users/Ivorforce/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Ivorforce/subscriptions","organizations_url":"https://api.github.com/users/Ivorforce/orgs","repos_url":"https://api.github.com/users/Ivorforce/repos","events_url":"https://api.github.com/users/Ivorforce/events{/privacy}","received_events_url":"https://api.github.com/users/Ivorforce/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-11-13T22:30:24Z","updated_at":"2025-11-13T22:30:24Z","body":"Ohh, this is really nice. I can't believe I haven't actively noticed it's using text right now instead of symbols.\r\n\r\nHow is this activated in your current PR? Is it an option for themes? \r\nI would definitely expect this to be the default on macOS — all applications have shortcut symbols in their menu bar, so it's something users should be very used to.","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3529981966/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3530997410","html_url":"https://github.com/godotengine/godot/pull/110161#issuecomment-3530997410","issue_url":"https://api.github.com/repos/godotengine/godot/issues/110161","id":3530997410,"node_id":"IC_kwDOAO6SJc7Sdr6i","user":{"login":"bruvzg","id":7645683,"node_id":"MDQ6VXNlcjc2NDU2ODM=","avatar_url":"https://avatars.githubusercontent.com/u/7645683?v=4","gravatar_id":"","url":"https://api.github.com/users/bruvzg","html_url":"https://github.com/bruvzg","followers_url":"https://api.github.com/users/bruvzg/followers","following_url":"https://api.github.com/users/bruvzg/following{/other_user}","gists_url":"https://api.github.com/users/bruvzg/gists{/gist_id}","starred_url":"https://api.github.com/users/bruvzg/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/bruvzg/subscriptions","organizations_url":"https://api.github.com/users/bruvzg/orgs","repos_url":"https://api.github.com/users/bruvzg/repos","events_url":"https://api.github.com/users/bruvzg/events{/privacy}","received_events_url":"https://api.github.com/users/bruvzg/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-11-14T06:05:18Z","updated_at":"2025-11-14T08:38:17Z","body":"> How is this activated in your current PR? Is it an option for themes?\r\n\r\nAs a tir-state (auto/enabled/disabled) `PopupMenu` property, defaults to `auto` (enabled on macOS/iOS), but I guess theme property might make more sense. The only downside, it won't have enum hint and just show up as raw `int` (_Edit: made PR for this https://github.com/godotengine/godot/pull/112752_).","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3530997410/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3539317320","html_url":"https://github.com/godotengine/godot/pull/110161#issuecomment-3539317320","issue_url":"https://api.github.com/repos/godotengine/godot/issues/110161","id":3539317320,"node_id":"IC_kwDOAO6SJc7S9bJI","user":{"login":"Mickeon","id":66727710,"node_id":"MDQ6VXNlcjY2NzI3NzEw","avatar_url":"https://avatars.githubusercontent.com/u/66727710?v=4","gravatar_id":"","url":"https://api.github.com/users/Mickeon","html_url"