l":"https://api.github.com/repos/godotengine/godot/pulls/118526","html_url":"https://github.com/godotengine/godot/pull/118526","diff_url":"https://github.com/godotengine/godot/pull/118526.diff","patch_url":"https://github.com/godotengine/godot/pull/118526.patch","merged_at":null},"body":"The audio bus volume slider in the editor did not update when the\r\nAudioServer volume was changed externally (e.g. by the audio import\r\nsettings dialog resetting the master bus to 0 dB). This caused the\r\nslider to display a stale value after reimport, making it appear as\r\nif the volume was unchanged until the user manually moved the slider.\r\n\r\nAdd a lightweight check in EditorAudioBus::NOTIFICATION_PROCESS that\r\ncompares the current AudioServer bus volume against the slider value\r\nand syncs the slider when they diverge.","closed_by":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/118526/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/godotengine/godot/issues/118526/timeline","performed_via_github_app":null,"state_reason":null}