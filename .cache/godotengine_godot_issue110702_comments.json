it works.\n\nHere's the chunk of code that does it (it must be placed inside the _process function):\n\nif current_index < full_text.length()\n\t\ttimer += _delta\n\t\tif timer >= TypingTimeDialogue / CurrentDialogue.length():\n\t\t\ttimer = 0.0\n\t\t\tRichText.text = Current_Effect + full_text.substr(0, current_index + 1)\n\t\t\tcurrent_index += 1","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3566804976/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3900076736","html_url":"https://github.com/godotengine/godot/issues/110702#issuecomment-3900076736","issue_url":"https://api.github.com/repos/godotengine/godot/issues/110702","id":3900076736,"node_id":"IC_kwDOAO6SJc7odnLA","user":{"login":"SylvanSign","id":18179992,"node_id":"MDQ6VXNlcjE4MTc5OTky","avatar_url":"https://avatars.githubusercontent.com/u/18179992?v=4","gravatar_id":"","url":"https://api.github.com/users/SylvanSign","html_url":"https://github.com/SylvanSign","followers_url":"https://api.github.com/users/SylvanSign/followers","following_url":"https://api.github.com/users/SylvanSign/following{/other_user}","gists_url":"https://api.github.com/users/SylvanSign/gists{/gist_id}","starred_url":"https://api.github.com/users/SylvanSign/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/SylvanSign/subscriptions","organizations_url":"https://api.github.com/users/SylvanSign/orgs","repos_url":"https://api.github.com/users/SylvanSign/repos","events_url":"https://api.github.com/users/SylvanSign/events{/privacy}","received_events_url":"https://api.github.com/users/SylvanSign/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-02-13T23:28:21Z","updated_at":"2026-02-13T23:28:21Z","body":"> This is expected b