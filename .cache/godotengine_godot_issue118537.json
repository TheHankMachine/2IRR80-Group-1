ull,"active_lock_reason":null,"draft":false,"pull_request":{"url":"https://api.github.com/repos/godotengine/godot/pulls/118537","html_url":"https://github.com/godotengine/godot/pull/118537","diff_url":"https://github.com/godotengine/godot/pull/118537.diff","patch_url":"https://github.com/godotengine/godot/pull/118537.patch","merged_at":null},"body":"This PR adds property filtering to arrays and dictionaries. If those contain resources with properties that match the filter, they will stay, and only show the elements that contains those resources. It will also search inside nested arrays/dicts.\r\n\r\nJust so this PR isn't misunderstood, I will reiterate this is just for searching **resource properties** inside arrays/dicts, as this is the purpose of the inspector filter. It won't search for values like strings or integers.\r\n\r\nCloses #102370.\r\n\r\n<img width=\"280\" height=\"699\" alt=\"image\" src=\"https://github.com/user-attachments/assets/323ba676-ae2c-454d-8c26-33fdb9d1c083\" />","closed_by":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/118537/reactions","total_count":4,"+1":4,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/godotengine/godot/issues/118537/timeline","performed_via_github_app":null,"state_reason":null}