e/godot/pulls/comments/3844782867"},"html":{"href":"https://github.com/godotengine/godot/pull/122751#discussion_r3844782867"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/122751"}},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/3844782867/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":982,"original_line":982,"side":"LEFT","author_association":"CONTRIBUTOR","original_position":111,"position":111,"subject_type":"line"},{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/3844896188","pull_request_review_id":5009413771,"id":3844896188,"node_id":"PRRC_kwDOAO6SJc7lLHW8","diff_hunk":"@@ -376,7 +376,10 @@ bool Object::set_native(const StringName &p_name, const Variant &p_value, bool *\n \t\t\t\t}\n \t\t\t\treturn true;\n \t\t\t}\n-\t\t\tdefault: {","path":"core/object/object.cpp","commit_id":"7bdffaec462dd37d9ed211ba1f9bab5a4ef598ce","original_commit_id":"7bdffaec462dd37d9ed211ba1f9bab5a4ef598ce","user":{"login":"StarryWorm","id":41305715,"node_id":"MDQ6VXNlcjQxMzA1NzE1","avatar_url":"https://avatars.githubusercontent.com/u/41305715?v=4","gravatar_id":"","url":"https://api.github.com/users/StarryWorm","html_url":"https://github.com/StarryWorm","followers_url":"https://api.github.com/users/StarryWorm/followers","following_url":"https://api.github.com/users/StarryWorm/following{/other_user}","gists_url":"https://api.github.com/users/StarryWorm/gists{/gist_id}","starred_url":"https://api.github.com/users/StarryWorm/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/StarryWorm/subscriptions","organizations_url":"https://api.github.com/users/StarryWorm/orgs","repos_url":"https://api.github.com/users/StarryWorm/repos","events_url":"https://api.github.com/users/StarryWorm/events{/privacy}","received_events_url":"https://api.github.com/users/StarryWorm/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"I don't think this change is a good idea, as the `default` case is future-proof, whereas manual listing of cases is not. It also adds verbosity where it is not needed and, in my opinion, now reads as \"if it is one of these other cases\" instead of \"if it is not a setget\".","created_at":"2026-08-24T15:22:03Z","updated_at":"2026-08-24T15:49:35Z","html_url":"https://github.com/godotengine/godot/pull/122751#discussion_r3844896188","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/122751","_links":{"self":{"href":"https://api.github.com/repos/godotengine/godot/pulls/comments/3844896188"},"html":{"href":"https://github.com/godotengine/godot/pull/122751#discussion_r3844896188"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/122751"}},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/3844896188/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":379,"original_line":379,"side":"LEFT","author_association":"CONTRIBUTOR","original_position":4,"position":4,"subject_type":"line"},{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/3845019815","pull_request_review_id":5009413771,"id":3845019815,"node_id":"PRRC_kwDOAO6SJc7lLlin","diff_hunk":"@@ -443,6 +446,13 @@ bool Object::get_native(const StringName &p_name, Variant &r_value, bool *r_vali\n \t\t\t\tr_value = Signal(this, p_name);\n \t\t\t\treturn true;\n \t\t\t}\n+\t\t\tcase GDType::Property::Type::ENUM: {\n+\t\t\t\tif (r_valid) {\n+\t\t\t\t\t*r_valid = false;\n+\t\t\t\t}\n+\t\t\t\tr_value = Variant();\n+\t\t\t\treturn true;","path":"core/object/object.cpp","commit_id":"7bdffaec462dd37d9ed211ba1f9bab5a4ef598ce","original_commit_id":"7bdffaec462dd37d9ed211ba1f9bab5a4ef598ce","user":{"login":"StarryWorm","id":41305715,"node_id":"MDQ6VXNlcjQxMzA1NzE1","avatar_url":"https://avatars.githubusercontent.com/u/41305715?v=4","gravatar_id":"","url":"https://api.github.com/users/StarryWorm","html_url":"https://github.com/StarryWorm","followers_url":"https://api.github.com/users/StarryWorm/followers","following_url":"https://api.github.com/users/StarryWorm/following{/other_user}","gists_url":"https://api.github.com/users/StarryWorm/gists{/gist_id}","starred_url":"https://api.github.com/users/StarryWorm/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/StarryWorm/subscriptions","organizations_url":"https://api.github.com/users/StarryWorm/orgs","repos_url":"https://api.github.com/users/StarryWorm/repos","events_url":"https://api.github.com/users/StarryWorm/events{/privacy}","received_events_url":"https://api.github.com/users/StarryWorm/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"This changes the behavior for enums from returning `false` to returning `true`. Looking at callers of this method, it doesn't seem like it would pose an issue anywhere. It might actually give a slight performance boost to `Object::get()` in the enum case. \nSomeone more experienced with it would need to double-check that the resulting GDScript VM's `OPCODE(OPCODE_GET_MEMBER)` behavior change does not have any negative downstream impacts, as it would have returned an error and triggered `OPCODE_BREAK` in the past for enums in the `DEBUG_ENABLED` case (since this method would return `false`).","created_at":"2026-08-24T15:36:51Z","updated_at":"2026-08-24T15:49:35Z","html_url":"https://github.com/godotengine/godot/pull/122751#discussion_r3845019815","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/122751","_links":{"self":{"href":"https://api.github.com/repos/godotengine/godot/pulls/comments/3845019815"},"html":{"href":"https://github.com/godotengine/godot/pull/122751#discussion_r3845019815"},"pull_request":{"href":"https://api.githu