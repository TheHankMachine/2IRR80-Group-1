er_view_type":"public","site_admin":false},"body":"Oh right, I noted this bug while coding but ended up uploading the PR a few days later so I forgot to mention it.\r\n\r\nGood thing you brought it up!","created_at":"2026-08-24T16:09:35Z","updated_at":"2026-08-24T16:09:43Z","html_url":"https://github.com/godotengine/godot/pull/122751#discussion_r3845274899","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/122751","_links":{"self":{"href":"https://api.github.com/repos/godotengine/godot/pulls/comments/3845274899"},"html":{"href":"https://github.com/godotengine/godot/pull/122751#discussion_r3845274899"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/122751"}},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/3845274899/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":982,"original_line":982,"side":"LEFT","in_reply_to_id":3844782867,"author_association":"MEMBER","original_position":111,"position":111,"subject_type":"line"},{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/3845294297","pull_request_review_id":5010026609,"id":3845294297,"node_id":"PRRC_kwDOAO6SJc7lMojZ","diff_hunk":"@@ -376,7 +376,10 @@ bool Object::set_native(const StringName &p_name, const Variant &p_value, bool *\n \t\t\t\t}\n \t\t\t\treturn true;\n \t\t\t}\n-\t\t\tdefault: {","path":"core/object/object.cpp","commit_id":"7bdffaec462dd37d9ed211ba1f9bab5a4ef598ce","original_commit_id":"7bdffaec462dd37d9ed211ba1f9bab5a4ef598ce","user":{"login":"Ivorforce","id":2308167,"node_id":"MDQ6VXNlcjIzMDgxNjc=","avatar_url":"https://avatars.githubusercontent.com/u/2308167?v=4","gravatar_id":"","url":"https://api.github.com/users/Ivorforce","html_url":"https://github.com/Ivorforce","followers_url":"https://api.github.com/users/Ivorforce/followers","following_url":"https://api.github.com/users/Ivorforce/following{/other_user}","gists_url":"https://api.github.com/users/Ivorforce/gists{/gist_id}","starred_url":"https://api.github.com/users/Ivorforce/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Ivorforce/subscriptions","organizations_url":"https://api.github.com/users/Ivorforce/orgs","repos_url":"https://api.github.com/users/Ivorforce/repos","events_url":"https://api.github.com/users/Ivorforce/events{/privacy}","received_events_url":"https://api.github.com/users/Ivorforce/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"I see it the exact opposite way actually: I consider explicit cases to be more 'future proof', because the compiler will complain when a new case is added, and the programmer adding a new case will have to consider the implications and make an intentional decision how to handle it.\r\n\r\nOn the other hand, `default` just swallows the new case, and you don't get to decide. We don't know today what a future case would be, so the decision can't be made today.","created_at":"2026-08-24T16:12:04Z","updated_at":"2026-08-24T16:13:32Z","html_url":"https://github.com/godotengine/godot/pull/122751#discussion_r3845294297","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/122751","_links":{"self":{"href":"https://api.github.com/repos/godotengine/godot/pulls/comments/3845294297"},"html":{"href":"https://github.com/godotengine/godot/pull/122751#discussion_r3845294297"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/122751"}},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/3845294297/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":379,"original_line":379,"side":"LEFT","in_reply_to_id":3844896188,"author_association":"MEMBER","original_position":4,"position":4,"subject_type":"l