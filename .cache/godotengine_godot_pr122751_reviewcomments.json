9ed211ba1f9bab5a4ef598ce","user":{"login":"lawnjelly","id":21999379,"node_id":"MDQ6VXNlcjIxOTk5Mzc5","avatar_url":"https://avatars.githubusercontent.com/u/21999379?v=4","gravatar_id":"","url":"https://api.github.com/users/lawnjelly","html_url":"https://github.com/lawnjelly","followers_url":"https://api.github.com/users/lawnjelly/followers","following_url":"https://api.github.com/users/lawnjelly/following{/other_user}","gists_url":"https://api.github.com/users/lawnjelly/gists{/gist_id}","starred_url":"https://api.github.com/users/lawnjelly/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/lawnjelly/subscriptions","organizations_url":"https://api.github.com/users/lawnjelly/orgs","repos_url":"https://api.github.com/users/lawnjelly/repos","events_url":"https://api.github.com/users/lawnjelly/events{/privacy}","received_events_url":"https://api.github.com/users/lawnjelly/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"This is a good spot.\r\n\r\nSo it changes the behaviour for enums from a loud failure to a silent success with an uninitialized variable?\r\n\r\nHow well does the GDScript analyzer deal with this?\r\n* static error checking - if you accidentally query an enum type on an instance without providing a key, does the analyzer catch it\r\n* if the analyzer misses it - VM generates an `OPCODE_GET_MEMBER` with an empty Variant rather than flagging an error. Can this cause knock on problems?\r\n\r\nJust want to make sure these are not a problem before going forward.","created_at":"2026-08-26T10:19:37Z","updated_at":"2026-08-26T10:19:37Z","html_url":"https://github.com/godotengine/godot/pull/122751#discussion_r3861775144","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/122751","_links":{"self":{"href":"https://api.github.com/repos/godotengine/godot/pulls/comments/3861775144"},"html":{"href":"https://github.com/godotengine/godot/pull/122751#discussion_r3861775144"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/122751"}},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/3861775144/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":454,"original_line":454,"side":"RIGHT","in_reply_to_id":3845019815,"author_association":"MEMBER","original_position":30,"position":30,"subject_type":"line"},{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/3861850723","pull_request_review_id":5029356200,"id":3861850723,"node_id":"PRRC_kwDOAO6SJc7mLypj","diff_hunk":"@@ -443,6 +446,13 @@ bool Object::get_native(const StringName &p_name, Variant &r_value, bool *r_vali\n \t\t\t\tr_value = Signal(this, p_name);\n \t\t\t\treturn true;\n \t\t\t}\n+\t\t\tcase GDType::Property::Type::ENUM: {\n+\t\t\t\tif (r_valid) {\n+\t\t\t\t\t*r_valid = false;\n+\t\t\t\t}\n+\t\t\t\tr_value = Variant();\n+\t\t\t\treturn true;","path":"core/object/object.cpp","commit_id":"7bdffaec462dd37d9ed211ba1f9bab5a4ef598ce","original_commit_id":"7bdffaec462dd37d9ed211ba1f9bab5a4ef598ce","user":{"login":"Ivorforce","id":2308167,"node_id":"MDQ6VXNlcjIzMDgxNjc=","avatar_url":"https://avatars.githubusercontent.com/u/2308167?v=4","gravatar_id":"","url":"https://api.github.com/users/Ivorforce","html_url":"https://github.com/Ivorforce","followers_url":"https://api.github.com/users/Ivorforce/followers","following_url":"https://api.github.com/users/Ivorforce/following{/other_user}","gists_url":"https://api.github.com/users/Ivorforce/gists{/gist_id}","starred_url":"https://api.github.com/users/Ivorforce/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Ivorforce/subscriptions","organizations_url":"https://api.github.com/users/Ivorforce/orgs","repos_url":"https://api.github.com/users/Ivorforce/repos","events_url":"https://api.github.com/users/Ivorforce/events{/privacy}","received_events_url":"https://api.github.com/users/Ivorforce/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"As far as I can tell, it doesn't affect the analyzer.\r\n\r\n`Object::get` / `Object::set` behaves identically as before (`r_valid` set to `false`, `Variant` returned).\r\n\r\n`ClassDB::get_property` does change; it returns `true` for \"property exists\" and `Variant()` as the property, and it has no way to tell that the property is invalid. This also used to be the case when e.g. a property has no getter.\r\n`ClassDB::get_property` is exposed, but only called internally from the VM from `OPCODE_GET_MEMBER` (i.e. the runtime \"native get\" path).","created_at":"2026-08-26T10:28:29Z","updated_at":"2026-08-26T10:28:29Z","html_url":"https://github.com/godotengine/godot/pull/122751#discussion_r3861850723","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/122751","_links":{"self":{"href":"https://api.github.com/repos/godotengine/godot/pulls/comments/3861850723"},"html":{"href":"https://github.com/godotengine/godot/pull/122751#discussion_r3861850723"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/122751"}},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/3861850723/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":454,"original_line":454,"side":"RIGHT","in_reply_to_id":3845019815,"author_association":"MEMBER","original_position":30,"position":30,"subject_type":"line"},{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/3861867863","pull_request_review_id":5029377731,"id":3861867863,"node_id":"PRRC_kwDOAO6SJc7mL21X","diff_hunk":"@@ -443,6 +446,13 @@ bool Object::get_native(const StringName &p_name, Variant &r_value, bool *r_vali\n \t\t\t\tr_value = Signal(this, p_name);\n \t\t\t\treturn true;\n \t\t\t}\n+\t\t\tcase GDType::Property::Type::ENUM: {\n+\t\t\t\tif (r_valid) {\n+\t\t\t\t\t*r_valid = false;\n+\t\t\t\t}\n+\t\t\t\tr_value = Variant();\n+\t\t\t\treturn true;","path":"core/object/object.cpp","commit_id":"7bdffaec462dd37d9ed211ba1f9bab5a4ef598ce","original_commit_id":"7bdffaec462dd37d9ed211ba1f9bab5a4ef598ce","user":{"login":"Ivorforce","id":2308167,"node_id":"MDQ6VXNlcjIzMDgxNjc=","avatar_url":"https://avatars.githubusercontent.com/u/2308167?v=4","gravatar_id":"","url":"https://api.github.com/users/Ivorforce","html_url":"https://github.com/Ivorforce","followers_url":"https://api.github.com/users/Ivorforce/followers","following_url":"https://api.github.com/users/Ivorforce/following{/other_user}","gists_url":"https://api.github.com/users/Ivorforce/gists{/gist_id}","starred_url":"https://api.github.com/users/Ivorforce/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Ivorforce/subscriptions","organizations_url":"https://api.github.com/users/Ivorforce/orgs","repos_url":"https://api.github.com/users/Ivorforce/repos","events_url":"https://api.github.com/users/Ivorforce/events{/privacy}","received_events_url":"https://api.github.com/users/Ivorforce/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"Theoretically the analyzer could be looking at whether a member exists for compilation, but it doesn't use `GDType` yet at all, and the `ClassDB` doesn't expose a way to tell if a member exists (only for specific member types one by one, like `has_method`).","created_at":"2026-08-26T10:30:29Z","updated_at":"2026-08-26T10:35:40Z","html_url":"https://github.com/godotengine/godot/pull/122751#discussion_r3861867863","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/122751","_links":{"self":{"href":"https://api.github.com/repos/godotengine/godot/pulls/comments/3861867863"},"html":{"href":"https://github.com/godotengine/godot/pull/122751#discussion_r3861867863"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/122751"}},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/3861867863/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":454,"original_line":454,"side":"RIGHT","in_reply_to_id":3845019815,"author_association":"MEMBER","original_position":30,"position":30,"subject_type":"line"}]