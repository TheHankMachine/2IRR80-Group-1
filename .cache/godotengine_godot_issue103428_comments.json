[{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2692295155","html_url":"https://github.com/godotengine/godot/issues/103428#issuecomment-2692295155","issue_url":"https://api.github.com/repos/godotengine/godot/issues/103428","id":2692295155,"node_id":"IC_kwDOAO6SJc6geSnz","user":{"login":"theraot","id":1212509,"node_id":"MDQ6VXNlcjEyMTI1MDk=","avatar_url":"https://avatars.githubusercontent.com/u/1212509?v=4","gravatar_id":"","url":"https://api.github.com/users/theraot","html_url":"https://github.com/theraot","followers_url":"https://api.github.com/users/theraot/followers","following_url":"https://api.github.com/users/theraot/following{/other_user}","gists_url":"https://api.github.com/users/theraot/gists{/gist_id}","starred_url":"https://api.github.com/users/theraot/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/theraot/subscriptions","organizations_url":"https://api.github.com/users/theraot/orgs","repos_url":"https://api.github.com/users/theraot/repos","events_url":"https://api.github.com/users/theraot/events{/privacy}","received_events_url":"https://api.github.com/users/theraot/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-03-01T15:59:18Z","updated_at":"2025-03-01T15:59:18Z","body":"I would like to bring this to context:\n\n- https://github.com/godotengine/godot-proposals/discussions/11785#discussioncomment-12215685","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2692295155/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2692901519","html_url":"https://github.com/godotengine/godot/issues/103428#issuecomment-2692901519","issue_url":"https://api.github.com/repos/godotengine/godot/issues/103428","id":2692901519,"node_id":"IC_kwDOAO6SJc6ggmqP","user":{"login":"akien-mga","id":4701338,"node_id":"MDQ6VXNlcjQ3MDEzMzg=","avatar_url":"https://avatars.githubusercontent.com/u/4701338?v=4","gravatar_id":"","url":"https://api.github.com/users/akien-mga","html_url":"https://github.com/akien-mga","followers_url":"https://api.github.com/users/akien-mga/followers","following_url":"https://api.github.com/users/akien-mga/following{/other_user}","gists_url":"https://api.github.com/users/akien-mga/gists{/gist_id}","starred_url":"https://api.github.com/users/akien-mga/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/akien-mga/subscriptions","organizations_url":"https://api.github.com/users/akien-mga/orgs","repos_url":"https://api.github.com/users/akien-mga/repos","events_url":"https://api.github.com/users/akien-mga/events{/privacy}","received_events_url":"https://api.github.com/users/akien-mga/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-03-02T20:50:37Z","updated_at":"2025-03-02T20:50:37Z","body":"CC @Hilderin @Calinou ","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2692901519/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2692922796","html_url":"https://github.com/godotengine/godot/issues/103428#issuecomment-2692922796","issue_url":"https://api.github.com/repos/godotengine/godot/issues/103428","id":2692922796,"node_id":"IC_kwDOAO6SJc6ggr2s","user":{"login":"Hilderin","id":81109165,"node_id":"MDQ6VXNlcjgxMTA5MTY1","avatar_url":"https://avatars.githubusercontent.com/u/81109165?v=4","gravatar_id":"","url":"https://api.github.com/users/Hilderin","html_url":"https://github.com/Hilderin","followers_url":"https://api.github.com/users/Hilderin/followers","following_url":"https://api.github.com/users/Hilderin/following{/other_user}","gists_url":"https://api.github.com/users/Hilderin/gists{/gist_id}","starred_url":"https://api.github.com/users/Hilderin/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Hilderin/subscriptions","organizations_url":"https://api.github.com/users/Hilderin/orgs","repos_url":"https://api.github.com/users/Hilderin/repos","events_url":"https://api.github.com/users/Hilderin/events{/privacy}","received_events_url":"https://api.github.com/users/Hilderin/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-03-02T21:43:57Z","updated_at":"2025-03-02T21:43:57Z","body":"I understand the point of the OR. Before Beta 3, it was easier to test with or without fullscreen simply by enabling or disabling embedding. The new validation, which disables embedding when the project is set to fullscreen, was added after complaints that upgrading to 4.4 caused project settings to no longer be respected. That’s also a valid point, which is why I’m not 100% sure about reverting to the behavior before Beta 3.\n\nAdditionally, if I understand correctly, before the Game View and embedding were introduced, switching between fullscreen and windowed mode required going into Project Settings for each run. Now, the user can leave embedding enabled and achieve the same effect:  \n- When fullscreen is enabled, the game starts in fullscreen without embedding (even if embedding is enabled).  \n- When fullscreen is disabled, the game runs embedded.  \n\nIt’s not perfect, but it’s equivalent to version 4.3.\n\nAnother suggestion is to allow users to set the fullscreen mode in code at runtime when the game starts, using something like this:\n\n```gdscript\nif !Engine.is_embedded_in_editor():\n    DisplayServer.window_set_mode(DisplayServer.WINDOW_MODE_FULLSCREEN)\n```\n\nThis way, if embedding is enabled, the game starts in windowed mode, and if embedding is disabled, it starts in fullscreen.\n\nI think what’s really missing is an option within the Game View to easily change the window size for the next run, without needing to go into Project Settings or Editor Settings.","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2692922796/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2722565701","html_url":"https://github.com/godotengine/godot/issues/103428#issuecomment-2722565701","issue_url":"https://api.github.com/repos/godotengine/godot/issues/103428","id":2722565701,"node_id":"IC_kwDOAO6SJc6iRw5F","user":{"login":"andreasng","id":5521571,"node_id":"MDQ6VXNlcjU1MjE1NzE=","avatar_url":"https://avatars.githubusercontent.com/u/5521571?v=4","gravatar_id":"","url":"https://api.github.com/users/andreasng","html_url":"https://github.com/andreasng","followers_url":"https://api.github.com/users/andreasng/followers","following_url":"https://api.github.com/users/andreasng/following{/other_user}","gists_url":"https://api.github.com/users/andreasng/gists{/gist_id}","starred_url":"https://api.github.com/users/andreasng/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/andreasng/subscriptions","organizations_url":"https://api.github.com/users/andreasng/orgs","repos_url":"https://api.github.com/users/andreasng/repos","events_url":"https://api.github.com/users/andreasng/events{/privacy}","received_events_url":"https://api.github.com/users/andreasng/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-03-13T20:02:01Z","updated_at":"2025-03-13T20:02:01Z","body":"I cant understand why the embedded player shouldnt be able to go to fullscreen.\n\n\nI normally do (did) this, and it was perfectly fine!\n\n\n`\tif Input.is_action_just_pressed(\"fullscreen\"):\n\t\tprint(\"Fullscreen toggle is requested!\")\n\t\tif DisplayServer.window_get_mode() == DisplayServer.WINDOW_MODE_FULLSCREEN:\n\t\t\tDisplayServer.window_set_mode(DisplayServer.WINDOW_MODE_WINDOWED)\n\t\t\tprint(\"Fullscreen is exited!\")\n\t\telse:\n\t\t\tDisplayServer.window_set_mode(DisplayServer.WINDOW_MODE_FULLSCREEN)\n\t\t\tprint(\"Fullscreen is entered!\")`","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2722565701/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3841959244","html_url":"https://github.com/godotengine/godot/issues/103428#issuecomment-3841959244","issue_url":"https://api.github.com/repos/godotengine/godot/issues/103428","id":3841959244,"node_id":"IC_kwDOAO6SJc7k_6VM","user":{"login":"RogerLevy","id":74073,"node_id":"MDQ6VXNlcjc0MDcz","avatar_url":"https://avatars.githubusercontent.com/u/74073?v=4","gravatar_id":"","url":"https://api.github.com/users/RogerLevy","html_url":"https://github.com/RogerLevy","followers_url":"https://api.github.com/users/RogerLevy/followers","following_url":"https://api.github.com/users/RogerLevy/following{/other_user}","gists_url":"https://api.github.com/users/RogerLevy/gists{/gist_id}","starred_url":"https://api.github.com/users/RogerLevy/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/RogerLevy/subscriptions","organizations_url":"https://api.github.com/users/RogerLevy/orgs","repos_url":"https://api.github.com/users/RogerLevy/repos","events_url":"https://api.github.com/users/RogerLevy/events{/privacy}","received_events_url":"https://api.github.com/users/RogerLevy/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-02-03T15:18:33Z","updated_at":"2026-02-03T15:21:04Z","body":"I agree with @andreasng, there is no good reason the embedded game window shouldn't be able to take over the editor window with its own toggle-able fullscreen mode.  This would be useful.  I get smoother (i.e. closer to release build) framerates with embedded game window, and it's inconvenient to have to change a project setting and mess with your workflow just to see the game in fullscreen more quickly than exporting a build and getting to the point in the game where you would like to see how it looks fullscreen.  Currently toggling fullscreen in an embedded game window seems to be disabled in 4.5.  \n\nBut I also think that embedded game window should always start embedded, regardless of the project's fullscreen setting.","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3841959244/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3842020789","html_url":"https://github.com/godotengine/godot/issues/103428#issuecomment-3842020789","issue_url":"https://api.github.com/repos/godotengine/godot/issues/103428","id":3842020789,"node_id":"IC_kwDOAO6SJc7lAJW1","user":{"login":"Calinou","id":180032,"node_id":"MDQ6VXNlcjE4MDAzMg==","avatar_url":"https://avatars.githubusercontent.com/u/180032?v=4","gravatar_id":"","url":"https://api.github.com/users/Calinou","html_url":"https://github.com/Calinou","followers_url":"https://api.github.com/users/Calinou/followers","following_url":"https://api.github.com/users/Calinou/following{/other_user}","gists_url":"https://api.github.com/users/Calinou/gists{/gist_id}","starred_url":"https://api.github.com/users/Calinou/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Calinou/subscriptions","organizations_url":"https://api.github.com/users/Calinou/orgs","repos_url":"https://api.github.com/users/Calinou/repos","events_url":"https://api.github.com/users/Calinou/events{/privacy}","received_events_url":"https://api.github.com/users/Calinou/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-02-03T15:30:35Z","updated_at":"2026-02-03T15:31:03Z","body":"It would be possible to implement fullscreen toggle on an embedded window, but if you expect the embedded controls to be hidden in this state (making the window actually fullscreen), it would be a lot more work.\n\nIf we don't hide the embedded controls, then exclusive fullscreen will have to act as non-exclusive fullscreen so that the embedded window can show up on top of the controls.","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3842020789/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3842105894","html_url":"https://github.com/godotengine/godot/issues/103428#issuecomment-3842105894","issue_url":"https://api.github.com/repos/godotengine/godot/issues/103428","id":3842105894,"node_id":"IC_kwDOAO6SJc7lAeIm","user":{"login":"RogerLevy","id":74073,"node_id":"MDQ6VXNlcjc0MDcz","avatar_url":"https://avatars.githubusercontent.com/u/74073?v=4","gravatar_id":"","url":"https://api.github.com/users/RogerLevy","html_url":"https://github.com/RogerLevy","followers_url":"https://api.github.com/users/RogerLevy/followers","following_url":"https://api.github.com/users/RogerLevy/following{/other_user}","gists_url":"https://api.github.com/users/RogerLevy/gists{/gist_id}","starred_url":"https://api.github.com/users/RogerLevy/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/RogerLevy/subscriptions","organizations_url":"https://api.github.com/users/RogerLevy/orgs","repos_url":"https://api.github.com/users/RogerLevy/repos","events_url":"https://api.github.com/users/RogerLevy/events{/privacy}","received_events_url":"https://api.github.com/users/RogerLevy/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-02-03T15:47:02Z","updated_at":"2026-02-03T15:47:02Z","body":"Having the controls be visible would be an acceptable tradeoff for me.  Seeing the game \"as big as possible\" quickly is the desire more than anything else.","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3842105894/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null}]