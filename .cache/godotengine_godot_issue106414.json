iew_type":"public","site_admin":false},"open_issues":3,"closed_issues":3687,"state":"closed","created_at":"2024-12-19T08:51:28Z","updated_at":"2026-09-04T21:48:38Z","due_on":"2025-09-15T00:00:00Z","closed_at":"2025-09-18T17:13:14Z"},"comments":1,"created_at":"2025-05-14T21:31:49Z","updated_at":"2025-06-18T23:30:15Z","closed_at":"2025-06-18T23:29:52Z","assignee":null,"author_association":"MEMBER","issue_field_values":[],"type":null,"active_lock_reason":null,"draft":false,"pull_request":{"url":"https://api.github.com/repos/godotengine/godot/pulls/106414","html_url":"https://github.com/godotengine/godot/pull/106414","diff_url":"https://github.com/godotengine/godot/pull/106414.diff","patch_url":"https://github.com/godotengine/godot/pull/106414.patch","merged_at":"2025-06-18T23:29:52Z"},"body":"Fixes #105908.\r\nFixes #106284.\r\n\r\nThis issue came from the frame-based refactoring done in the multiwin PR.\r\n\r\nIt looks like some (all?) compositors group certain events alongside `wl_pointer::leave`, which I absolutely did not expect. The docs don't seem to mention it either from what I can tell.\r\n\r\nWe now fall-back on the old pointed window if and only if the current window is invalid and the old one isn't. Each state fetch is guarded with an `ERR_FAIL_NULL` so this should still catch any potentially corrupted window with missing data but a valid ID.\r\n\r\nI also added the usual big comment so that this \"quirk\" does not get lost to time.\r\n","closed_by":{"login":"Repiteo","id":17489292,"node_id":"MDQ6VXNlcjE3NDg5Mjky","avatar_url":"https://avatars.githubusercontent.com/u/17489292?v=4","gravatar_id":"","url":"https://api.github.com/users/Repiteo","html_url":"https://github.com/Repiteo","followers_url":"https://api.github.com/users/Repiteo/followers","following_url":"https://api.github.com/users/Repiteo/following{/other_user}","gists_url":"https://api.github.com/users/Repiteo/gists{/gist_id}","starred_url":"https://api.github.com/users/Repiteo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Repiteo/subscriptions","organizations_url":"https://api.github.com/users/Repiteo/orgs","repos_url":"https://api.github.com/users/Repiteo/repos","events_url":"https://api.github.com/users/Repiteo/events{/privacy}","received_events_url":"https://api.github.com/users/Repiteo/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/106414/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/godotengine/godot/issues/106414/timeline","performed_via_github_app":null,"state_reason":null}