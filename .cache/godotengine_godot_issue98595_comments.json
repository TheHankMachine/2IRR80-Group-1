odot/issues/comments/2442814590","html_url":"https://github.com/godotengine/godot/issues/98595#issuecomment-2442814590","issue_url":"https://api.github.com/repos/godotengine/godot/issues/98595","id":2442814590,"node_id":"IC_kwDOAO6SJc6RmmR-","user":{"login":"a-johnston","id":9058941,"node_id":"MDQ6VXNlcjkwNTg5NDE=","avatar_url":"https://avatars.githubusercontent.com/u/9058941?v=4","gravatar_id":"","url":"https://api.github.com/users/a-johnston","html_url":"https://github.com/a-johnston","followers_url":"https://api.github.com/users/a-johnston/followers","following_url":"https://api.github.com/users/a-johnston/following{/other_user}","gists_url":"https://api.github.com/users/a-johnston/gists{/gist_id}","starred_url":"https://api.github.com/users/a-johnston/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/a-johnston/subscriptions","organizations_url":"https://api.github.com/users/a-johnston/orgs","repos_url":"https://api.github.com/users/a-johnston/repos","events_url":"https://api.github.com/users/a-johnston/events{/privacy}","received_events_url":"https://api.github.com/users/a-johnston/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2024-10-28T22:46:49Z","updated_at":"2024-10-28T22:46:49Z","body":"> > Sounds like a duplicate of #98309. Make sure the array property is typed when serialized to the scene, it should look like: `Array[int]([0, 1, 2])`\r\n> \r\n> Doing `new Array<int>{0};` did not work ([0]) doesn't work\r\n\r\nthey're referring to how the array is serialized by the resource/scene. For example, in the example project I linked above, `main.tscn` has these two lines in it (in the case of having a non-null default value):\r\n```\r\nenumArray = Array[int]([0, 1, 2])\r\nintArray = [null, 1, 2]\r\n```","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2442814590/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2442853880","html_url":"https://github.com/godotengine/godot/issues/98595#issuecomment-2442853880","issue_url":"https://api.github.com/repos/godotengine/godot/issues/98595","id":2442853880,"node_id":"IC_kwDOAO6SJc6Rmv34","user":{"login":"InkONat","id":61206149,"node_id":"MDQ6VXNlcjYxMjA2MTQ5","avatar_url":"https://avatars.githubusercontent.com/u/61206149?v=4","gravatar_id":"","url":"https://api.github.com/users/InkONat","html_url":"https://github.com/InkONat","followers_url":"https://api.github.com/users/InkONat/followers","following_url":"https://api.github.com/users/InkONat/following{/other_user}","gists_url":"https://api.github.com/users/InkONat/gists{/gist_id}","starred_url":"https://api.github.com/users/InkONat/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/InkONat/subscriptions","organizations_url":"https://api.github.com/users/InkONat/orgs","repos_url":"https://api.github.com/users/InkONat/repos","events_url":"https://api.github.com/users/InkONat/events{/privacy}","received_events_url":"https://api.github.com/users/InkONat/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2024-10-28T23:20:39Z","updated_at":"2024-10-28T23:21:01Z","body":"> > > Sounds like a duplicate of #98309. Make sure the array property is typed when serialized to the scene, it should look like: `Array[int]([0, 1, 2])`\r\n> > \r\n> > \r\n> > Doing `new Array<int>{0};` did not work ([0]) doesn't work\r\n> \r\n> they're referring to how the array is serialized by the resource/scene. For example, in the example project I linked above, `main.tscn` has these two lines in it (in the case of having a non-null default value):\r\n> \r\n> ```\r\n> enumArray = Array[int]([0, 1, 2])\r\n> intArray = [null, 1, 2]\r\n> ```\r\n\r\nhttps://github.com/godotengine/godot/issues/98595#issuecomment-2442814590\r\n![image](https://github.com/user-attachments/assets/7d23eab4-3460-4cc0-9104-f78261351110)\r\n\r\nThe array is already set to another value in this function, which is called in an Initialize() function of the ItemManager\r\nIn the same node script where the behavior happens:\r\n![image](https://github.com/user-attachments/assets/fde93f9f-08fa-4e44-be65-07680fcb6765)\r\n","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2442853880/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2445404841","html_url":"https://github.com/godotengine/godot/issues/98595#issuecomment-2445404841","issue_url":"https://api.github.com/repos/godotengine/godot/issues/98595","id":2445404841,"node_id":"IC_kwDOAO6SJc6Rweqp","user":{"login":"InkONat","id":61206149,"node_id":"MDQ6VXNlcjYxMjA2MTQ5","avatar_url":"https://avatars.githubusercontent.com/u/61206149?v=4","gravatar_id":"","url":"https://api.github.com/users/InkONat","html_url":"https://github.com/InkONat","followers_url":"https://api.github.com/users/InkONat/followers","following_url":"https://api.github.com/users/InkONat/following{/other_user}","gists_url":"https://api.github.com/users/InkONat/gists{/gist_id}","starred_url":"https://api.github.com/users/InkONat/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/InkONat/subscriptions","organizations_url":"https://api.github.com/users/InkONat/orgs","repos_url":"https://api.github.com/users/InkONat/repos","events_url":"https://api.github.com/users/InkONat/events{/privacy}","received_events_url":"https://api.github.com/users/InkONat/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2024-10-29T21:57:57Z","updated_at":"2024-10-29T21:57:57Z","body":"A workaround I found was just using `int[]` instead of `Array<int>`, since Godot thinks of `int[]` as a PackedInt32Array. But the issue persists with normal Arrays.","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2445404841/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2453469552","html_url":"https://github.com/godotengine/godot/issues/98595#issuecomment-2453469552","issue_url":"https://api.github.com/repos/godotengine/godot/issues/98595","id":2453469552,"node_id":"IC_kwDOAO6SJc6SPPlw","user":{"login":"InkONat","id":61206149,"node_id":"MDQ6VXNlcjYxMjA2MTQ5","avatar_url":"https://avatars.githubusercontent.com/u/61206149?v=4","gravatar_id":"","url":"https://api.github.com/users/InkONat","html_url":"https://github.com/InkONat","followers_url":"https://api.github.com/users/InkONat/followers","following_url":"https://api.github.com/users/InkONat/following{/other_user}","gists_url":"https://api.github.com/users/InkONat/gists{/gist_id}","starred_url":"https://api.github.com/users/InkONat/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/InkONat/subscriptions","organizations_url":"https://api.github.com/users/InkONat/orgs","repos_url":"https://api.github.com/users/InkONat/repos","events_url":"https://api.github.com/users/InkONat/events{/privacy}","received_events_url":"https://api.github.com/users/InkONat/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2024-11-03T15:36:43Z","updated_at":"2024-11-03T15:36:43Z","body":"Can someone add the confirmed label?","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2453469552/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":