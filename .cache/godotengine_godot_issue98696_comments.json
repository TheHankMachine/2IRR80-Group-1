tention\r\nResult: {\"time\":51.29}\r\n\r\nRunning benchmark 6 of 16: core/object_db/2_threads_half_contention\r\nResult: {\"time\":34.03}\r\n\r\nRunning benchmark 7 of 16: core/object_db/2_threads_little_contention\r\nResult: {\"time\":22.25}\r\n\r\nRunning benchmark 8 of 16: core/object_db/4_threads_full_contention\r\nResult: {\"time\":173.6}\r\n\r\nRunning benchmark 9 of 16: core/object_db/4_threads_half_contention\r\nResult: {\"time\":95.34}\r\n\r\nRunning benchmark 10 of 16: core/object_db/4_threads_little_contention\r\nResult: {\"time\":32.9}\r\n\r\nRunning benchmark 11 of 16: core/object_db/4_threads_slope_contention\r\nResult: {\"time\":127.7}\r\n\r\nRunning benchmark 12 of 16: core/object_db/8_threads_full_contention\r\nResult: {\"time\":785.5}\r\n\r\nRunning benchmark 13 of 16: core/object_db/8_threads_half_contention\r\nResult: {\"time\":461.2}\r\n\r\nRunning benchmark 14 of 16: core/object_db/8_threads_little_contention\r\nResult: {\"time\":102.2}\r\n\r\nRunning benchmark 15 of 16: core/object_db/8_threads_slope_contention\r\nResult: {\"time\":410.2}\r\n\r\nRunning benchmark 16 of 16: core/object_db/single\r\nResult: {\"time\":17.71}\r\n","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2465975816/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2466015479","html_url":"https://github.com/godotengine/godot/pull/98696#issuecomment-2466015479","issue_url":"https://api.github.com/repos/godotengine/godot/issues/98696","id":2466015479,"node_id":"IC_kwDOAO6SJc6S_Gj3","user":{"login":"clayjohn","id":16521339,"node_id":"MDQ6VXNlcjE2NTIxMzM5","avatar_url":"https://avatars.githubusercontent.com/u/16521339?v=4","gravatar_id":"","url":"https://api.github.com/users/clayjohn","html_url":"https://github.com/clayjohn","followers_url":"https://api.github.com/users/clayjohn/followers","following_url":"https://api.github.com/users/clayjohn/following{/other_user}","gists_url":"https://api.github.com/users/clayjohn/gists{/gist_id}","starred_url":"https://api.github.com/users/clayjohn/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/clayjohn/subscriptions","organizations_url":"https://api.github.com/users/clayjohn/orgs","repos_url":"https://api.github.com/users/clayjohn/repos","events_url":"https://api.github.com/users/clayjohn/events{/privacy}","received_events_url":"https://api.github.com/users/clayjohn/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2024-11-09T03:23:23Z","updated_at":"2024-11-09T03:23:23Z","body":"Maybe the TPS demo? https://github.com/godotengine/tps-demo I suspect that it won't have much thread contention as it is mostly single threaded though","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2466015479/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2466480742","html_url":"https://github.com/godotengine/godot/pull/98696#issuecomment-2466480742","issue_url":"https://api.github.com/repos/godotengine/godot/issues/98696","id":2466480742,"node_id":"IC_kwDOAO6SJc6TA4Jm","user":{"login":"stuartcarnie","id":52852,"node_id":"MDQ6VXNlcjUyODUy","avatar_url":"https://avatars.githubusercontent.com/u/52852?v=4","gravatar_id":"","url":"https://api.github.com/users/stuartcarnie","html_url":"https://github.com/stuartcarnie","followers_url":"https://api.github.com/users/stuartcarnie/followers","following_url":"https://api.github.com/users/stuartcarnie/following{/other_user}","gists_url":"https://api.github.com/users/stuartcarnie/gists{/gist_id}","starred_url":"https://api.github.com/users/stuartcarnie/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/stuartcarnie/subscriptions","organizations_url":"https://api.github.com/users/stuartcarnie/orgs","repos_url":"https://api.github.com/users/stuartcarnie/repos","events_url":"https://api.github.com/users/stuartcarnie/events{/privacy}","received_events_url":"https://api.github.com/users/stuartcarnie/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2024-11-09T22:21:25Z","updated_at":"2024-11-09T22:21:25Z","body":"> Normally unfair lock will block, which defeats the purpose of spin locks.\r\n\r\nThey don't block if they are not contested, which is probably likely under normal conditions. This is also evident in the single threaded benchmark result, where both are almost identical in performance. \r\n\r\nI reformatted your results into a table, so they are easier to read and compare (I don't know the time units):\r\n\r\n| Benchmark                                   | Before | After  | ± change |\r\n|:--------------------------------------------|:-------|:-------|----------|\r\n| core/object_db/single                       | 18.65  | 17.71  | 1.05     |\r\n| core/object_db/2_threads_full_contention    | 59.71  | 51.29  | 1.16     |\r\n| core/object_db/2_threads_half_contention    | 38.24  | 34.03  | 1.12     |\r\n| core/object_db/2_threads_little_contention  | 22.54  | 22.25  | 1.01     |\r\n| core/object_db/4_threads_full_contention    | 180.6  | 173.6  | 1.04     |\r\n| core/object_db/4_threads_half_contention    | 101.4  | 95.34  | 1.06     |\r\n| core/object_db/4_threads_little_contention  | 35.11  | 32.9   | 1.07     |\r\n| core/object_db/4_threads_slope_contention   | 135.5  | 127.7  | 1.06     |\r\n| core/object_db/8_threads_full_contention    | 516.4  | 785.5  | 0.66     |\r\n| core/object_db/8_threads_half_contention    | 299.4  | 461.2  | 0.65     |\r\n| core/object_db/8_threads_little_contention  | 74.33  | 102.2  | 0.73     |\r\n| core/object_db/8_threads_slope_contention   | 314.4  | 410.2  | 0.77     |\r\n| core/object_db/12_threads_full_contention   | 1317.0 | 1991.0 | 0.66     |\r\n| core/object_db/12_threads_half_contention   | 643.7  | 1055.0 | 0.61     |\r\n| core/object_db/12_threads_little_contention | 138.5  | 204.6  | 0.68     |\r\n| core/object_db/12_threads_slope_contention  | 586.1  | 1017.0 | 0.58     |\r\n\r\nMy interpretation is that it is slightly better when there are few threads (2 - 4 threads), but as the thread count increases, the worst case is much worse than the current implementation. This is likely a combination of number of available CPUs, and overall system activity, and so blocking is better, as it forces the thread to yield sooner to give the other threads a chance to make progress.\r\n\r\nI suspect if you have a 16 core Mac, you might see the improved performance extend to 8 and possibly even 12 threads.\r\n\r\n## TL;DR\r\n\r\nI'd argue that although best case is slightly better, worst case is significantly worse.","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2466480742/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2466524779","html_url":"https://github.com/godotengine/godot/pull/98696#issuecomment-2466524779","issue_url":"https://api.github.com/repos/godotengine/godot/issues/98696","id":2466524779,"node_id":"IC_kwDOAO6SJc6TBC5r","user":{"login":"mrsaturnsan","id":32889818,"node_id":"MDQ6VXNlcjMyODg5ODE4","avatar_url":"https://avatars.githubusercontent.com/u/32889818?v=4","gravatar_id":"","url":"https://api.github.com/users/mrsaturnsan","html_url":"https://github.com/mrsaturnsan","followers_url":"https://api.github.com/users/mrsaturnsan/followers","following_url":"https://api.github.com/users/mrsaturnsan/following{/other_user}","gists_url":"https://api.github.com/users/mrsaturnsan/gists{/gist_id}","starred_url":"https://api.github.com/users/mrsaturnsan/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/mrsaturnsan/subscriptions","organizations_url":"https://api.github.com/users/mrsaturnsan/orgs","repos_url":"https://api.github.com/users/mrsaturnsan/repos","events_url":"https://api.github.com/users/mrsaturnsan/events{/privacy}","received_events_url":"https://api.github.com/users/mrsaturnsan/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2024-11-10T00:31:55Z","updated_at":"2024-11-10T00:31:55Z","body":"Yes, I think maybe using the adaptive spin won't be much of a benefit after all. Appreciate everyone's time looking at this PR.","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2466524779/reactions","total_count":3,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":3,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null}]