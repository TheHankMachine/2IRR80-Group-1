g3MzM=","url":"https://api.github.com/repos/godotengine/godot/labels/usability","name":"usability","color":"447744","default":false,"description":"","archived_at":null,"archived_by":null}],"state":"open","locked":false,"assignees":[],"milestone":{"url":"https://api.github.com/repos/godotengine/godot/milestones/16","html_url":"https://github.com/godotengine/godot/milestone/16","labels_url":"https://api.github.com/repos/godotengine/godot/milestones/16/labels","id":8237783,"node_id":"MI_kwDOAO6SJc4AfbLX","number":16,"title":"4.x","description":"Issues and pull requests slated for an undetermined Godot 4 release.","creator":{"login":"akien-mga","id":4701338,"node_id":"MDQ6VXNlcjQ3MDEzMzg=","avatar_url":"https://avatars.githubusercontent.com/u/4701338?v=4","gravatar_id":"","url":"https://api.github.com/users/akien-mga","html_url":"https://github.com/akien-mga","followers_url":"https://api.github.com/users/akien-mga/followers","following_url":"https://api.github.com/users/akien-mga/following{/other_user}","gists_url":"https://api.github.com/users/akien-mga/gists{/gist_id}","starred_url":"https://api.github.com/users/akien-mga/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/akien-mga/subscriptions","organizations_url":"https://api.github.com/users/akien-mga/orgs","repos_url":"https://api.github.com/users/akien-mga/repos","events_url":"https://api.github.com/users/akien-mga/events{/privacy}","received_events_url":"https://api.github.com/users/akien-mga/received_events","type":"User","user_view_type":"public","site_admin":false},"open_issues":5791,"closed_issues":0,"state":"open","created_at":"2022-07-26T12:42:05Z","updated_at":"2026-10-21T22:40:26Z","due_on":null,"closed_at":null},"comments":29,"created_at":"2026-06-05T15:36:17Z","updated_at":"2026-09-28T16:02:31Z","closed_at":null,"assignee":null,"author_association":"MEMBER","issue_field_values":[],"type":null,"active_lock_reason":null,"draft":false,"pull_request":{"url":"https://api.github.com/repos/godotengine/godot/pulls/120033","html_url":"https://github.com/godotengine/godot/pull/120033","diff_url":"https://github.com/godotengine/godot/pull/120033.diff","patch_url":"https://github.com/godotengine/godot/pull/120033.patch","merged_at":null},"body":"<!--\r\nPlease target the `master` branch. We will take care of backporting relevant fixes to older versions.\r\n\r\nBefore submitting, please read our checklist for contributors:\r\nhttps://contributing.godotengine.org/en/latest/engine/introduction.html#checklist-for-new-contributors\r\n\r\nUse of AI must be disclosed and should include a description of how it was used.\r\n-->\r\n\r\n## What problem(s) does this PR solve?\r\n\r\nThe follow-up to https://github.com/godotengine/godot/pull/116312#issuecomment-3921041448\r\n- Closes https://github.com/godotengine/godot-proposals/issues/9676\r\n- Closes https://github.com/godotengine/godot-proposals/issues/10006\r\n\r\n## Additional information\r\n\r\nThis PR allows infinite amount of dock slots to be created based on the current layout. You can add extra side columns, add more rows to columns, add docks below all columns, add side bottom docks or bottomer docks or more bottom panels.\r\n\r\nhttps://github.com/user-attachments/assets/712d301c-4e21-44b6-968f-f5e93f39a69a\r\n\r\nThere is no limit on how many slots can be added, so you can have every dock visible at once if you have space.\r\n\r\n<img width=\"1920\" height=\"1030\" alt=\"image\" src=\"https://github.com/user-attachments/assets/17f12e3b-f7e3-452c-88b7-87f5ceb8f67c\" />\r\n\r\nLooks cool, but it's incredibly duck-taped together :D\r\nWhat's missing before this can be ready:\r\n- The default layout needs to be fixed. The size of columns is not loaded properly.\r\n- The extra slots need to be saved in editor layout.\r\n- There might be a better way to split columns/rows than a bunch of random buttons called Side/Down.\r\n- New dock slots don't show drag hint for some reason, needs to be fixed.\r\n- The naming needs to be made consistent. I originally called it \"far docks\" (because extra columns on the far side), but there might be a better name, and it has to be used consistently in the internals.\r\n- Code needs cleanup, lots of hard-coded things.\r\n\r\nNote that the extra slots don't appear in the dock grid. Not sure if it's even feasible to support that.","closed_by":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/120033/reactions","total_count":55,"+1":19,"-1":0,"laugh":1,"hooray":7,"confused":1,"heart":16,"rocket":8,"eyes":3},"timeline_url":"https://api.github.com/repos/godotengine/godot/issues/120033/timeline","performed_via_github_app":null,"state_reason":null}