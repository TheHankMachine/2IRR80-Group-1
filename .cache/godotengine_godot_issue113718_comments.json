[{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3632146947","html_url":"https://github.com/godotengine/godot/issues/113718#issuecomment-3632146947","issue_url":"https://api.github.com/repos/godotengine/godot/issues/113718","id":3632146947,"node_id":"IC_kwDOAO6SJc7YfioD","user":{"login":"blueskythlikesclouds","id":19259897,"node_id":"MDQ6VXNlcjE5MjU5ODk3","avatar_url":"https://avatars.githubusercontent.com/u/19259897?v=4","gravatar_id":"","url":"https://api.github.com/users/blueskythlikesclouds","html_url":"https://github.com/blueskythlikesclouds","followers_url":"https://api.github.com/users/blueskythlikesclouds/followers","following_url":"https://api.github.com/users/blueskythlikesclouds/following{/other_user}","gists_url":"https://api.github.com/users/blueskythlikesclouds/gists{/gist_id}","starred_url":"https://api.github.com/users/blueskythlikesclouds/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/blueskythlikesclouds/subscriptions","organizations_url":"https://api.github.com/users/blueskythlikesclouds/orgs","repos_url":"https://api.github.com/users/blueskythlikesclouds/repos","events_url":"https://api.github.com/users/blueskythlikesclouds/events{/privacy}","received_events_url":"https://api.github.com/users/blueskythlikesclouds/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-12-09T12:59:38Z","updated_at":"2025-12-09T13:08:47Z","body":"This shader has UB.\n\nSee the following line:\n\n```glsl\nfloat easeOutInCubic(float x) { return (4.0 * pow(x - 0.5, 3.0)) + 0.5; }\n```\n\nThe shader provides a negative value to `pow` in the first half of the animation. This is undefined behavior on GLSL, and returns NaN on HLSL.\n\nThe shader broke the same exact way as D3D12 on my AMD GPU with Vulkan, so this is not Godot's responsibility to fix.","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3632146947/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3632323292","html_url":"https://github.com/godotengine/godot/issues/113718#issuecomment-3632323292","issue_url":"https://api.github.com/repos/godotengine/godot/issues/113718","id":3632323292,"node_id":"IC_kwDOAO6SJc7YgNrc","user":{"login":"akien-mga","id":4701338,"node_id":"MDQ6VXNlcjQ3MDEzMzg=","avatar_url":"https://avatars.githubusercontent.com/u/4701338?v=4","gravatar_id":"","url":"https://api.github.com/users/akien-mga","html_url":"https://github.com/akien-mga","followers_url":"https://api.github.com/users/akien-mga/followers","following_url":"https://api.github.com/users/akien-mga/following{/other_user}","gists_url":"https://api.github.com/users/akien-mga/gists{/gist_id}","starred_url":"https://api.github.com/users/akien-mga/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/akien-mga/subscriptions","organizations_url":"https://api.github.com/users/akien-mga/orgs","repos_url":"https://api.github.com/users/akien-mga/repos","events_url":"https://api.github.com/users/akien-mga/events{/privacy}","received_events_url":"https://api.github.com/users/akien-mga/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-12-09T13:39:52Z","updated_at":"2025-12-09T13:39:52Z","body":"Thanks for checking. Closing as not a Godot issue then.","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3632323292/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3632410225","html_url":"https://github.com/godotengine/godot/issues/113718#issuecomment-3632410225"