archived_at":null,"archived_by":null},{"id":1332303119,"node_id":"MDU6TGFiZWwxMzMyMzAzMTE5","url":"https://api.github.com/repos/godotengine/godot/labels/regression","name":"regression","color":"ff63ac","default":false,"description":"","archived_at":null,"archived_by":null},{"id":1732720779,"node_id":"MDU6TGFiZWwxNzMyNzIwNzc5","url":"https://api.github.com/repos/godotengine/godot/labels/topic:gui","name":"topic:gui","color":"ffee88","default":false,"description":"","archived_at":null,"archived_by":null}],"state":"closed","locked":false,"assignees":[],"milestone":null,"comments":1,"created_at":"2025-03-15T10:38:11Z","updated_at":"2025-03-21T11:59:16Z","closed_at":"2025-03-21T11:56:47Z","assignee":null,"author_association":"CONTRIBUTOR","issue_field_values":[],"type":null,"active_lock_reason":null,"draft":false,"pull_request":{"url":"https://api.github.com/repos/godotengine/godot/pulls/104173","html_url":"https://github.com/godotengine/godot/pull/104173","diff_url":"https://github.com/godotengine/godot/pull/104173.diff","patch_url":"https://github.com/godotengine/godot/pull/104173.patch","merged_at":null},"body":"This PR assumes PR #103610 will be merged (This is a sub branch of that branch).\r\n\r\nThis PR aims to fix all the issues mentioned in that one, that is #93832, and #48935 (Although I couldn't reproduce #48935 even by doing it in my own project.)\r\n\r\nAs talked about in the aforementioned PR, the best solution would be to overhaul `Control::set_position()`. However, due to my inexperience with the Godot codebase, I was unable to find a fix that would not introduce more bugs, or downright break the Control. I apologize.\r\n\r\nEssentially this PR splits the logic for determining whether the position and the size has changed into two, one which is accurate and triggers even for floating point errors, and another which is not as accurate but is immune to floating point errors. In my PR, I used the immune one for calling the `resized` signal, and used the non-immune one everywhere else.","closed_by":{"login":"WinnerWind","id":71366717,"node_id":"MDQ6VXNlcjcxMzY2NzE3","avatar_url":"https://avatars.githubusercontent.com/u/71366717?v=4","gravatar_id":"","url":"https://api.github.com/users/WinnerWind","html_url":"https://github.com/WinnerWind","followers_url":"https://api.github.com/users/WinnerWind/followers","following_url":"https://api.github.com/users/WinnerWind/following{/other_user}","gists_url":"https://api.github.com/users/WinnerWind/gists{/gist_id}","starred_url":"https://api.github.com/users/WinnerWind/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/WinnerWind/subscriptions","organizations_url":"https://api.github.com/users/WinnerWind/orgs","repos_url":"https://api.github.com/users/WinnerWind/repos","events_url":"https://api.github.com/users/WinnerWind/events{/privacy}","received_events_url":"https://api.github.com/users/WinnerWind/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/104173/reactions","total_count":1,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":1},"timeline_url":"https://api.github.com/repos/godotengine/godot/issues/104173/timeline","performed_via_github_app":null,"state_reason":null}