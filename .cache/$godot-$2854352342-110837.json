[{"id":3264436169,"node_id":"PRR_kwDOAO6SJc7Ck1fJ","state":"APPROVED","commit_id":"e366471fdcd1959bb3eb23e19f8a395a00220f76","user":{"site_admin":false,"suspended":false,"updated_at":"0001-01-01T00:00:00Z","avatar_url":"https://avatars.githubusercontent.com/u/2308167?u=f7f8e0273f784f5ec6f6b7fe4a88d449896eb48a&v=4","created_at":"0001-01-01T00:00:00Z","followers":0,"following":0,"html_url":"https://github.com/Ivorforce","id":2308167,"node_id":"MDQ6VXNlcjIzMDgxNjc=","login":"Ivorforce","type":"User","owned_private_repos":0,"public_gists":0,"public_repos":0,"total_private_repos":0,"url":"https://api.github.com/users/Ivorforce"},"body":"While this is quite a bit of churn for no immediate benefit, I think this is a necessary change:\r\n\r\n- Without `GDSOFTCLASS`, future contributors or module authors might run into the same issue as https://github.com/godotengine/godot/issues/110693.\r\n- We should have consistency in the codebase about what it means to derive from `Object`.\r\n- We may decide to add more semantics to `GDSOFTCLASS`, which may make it necessary for these classes to use the macro.\r\n\r\nI actually may propose to require the use of `GDSOFTCLASS` / `GDCLASS`, but for now, this is an appropriate improvement.\r\n\r\nThank you again @wheatear-dev for going through the trouble of identifying and patching these!","html_url":"https://github.com/godotengine/godot/pull/110837#pullrequestreview-3264436169","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/110837","author_association":"MEMBER","submitted_at":"2025-09-24T19:43:50Z"},{"id":3268467927,"node_id":"PRR_kwDOAO6SJc7C0NzX","state":"APPROVED","commit_id":"e366471fdcd1959bb3eb23e19f8a395a00220f76","user":{"site_admin":false,"suspended":false,"updated_at":"0001-01-01T00:00:00Z","avatar_url":"https://avatars.githubusercontent.com/u/17489292?u=34072b401722100a7c0c0d61e37b376cf22b4545&v=4","created_at":"0001-01-01T00:00:00Z","followers":0,"following":0,"html_url":"https://github.com/Repiteo",