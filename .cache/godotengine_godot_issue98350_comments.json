ps://api.github.com/users/Repiteo/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2024-11-01T01:29:53Z","updated_at":"2024-11-01T01:29:53Z","body":"Thanks!","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2451125212/reactions","total_count":4,"+1":0,"-1":0,"laugh":0,"hooray":4,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2495325974","html_url":"https://github.com/godotengine/godot/pull/98350#issuecomment-2495325974","issue_url":"https://api.github.com/repos/godotengine/godot/issues/98350","id":2495325974,"node_id":"IC_kwDOAO6SJc6Uu6cW","user":{"login":"ThatSimpleDev","id":189414013,"node_id":"U_kgDOC0o6fQ","avatar_url":"https://avatars.githubusercontent.com/u/189414013?v=4","gravatar_id":"","url":"https://api.github.com/users/ThatSimpleDev","html_url":"https://github.com/ThatSimpleDev","followers_url":"https://api.github.com/users/ThatSimpleDev/followers","following_url":"https://api.github.com/users/ThatSimpleDev/following{/other_user}","gists_url":"https://api.github.com/users/ThatSimpleDev/gists{/gist_id}","starred_url":"https://api.github.com/users/ThatSimpleDev/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/ThatSimpleDev/subscriptions","organizations_url":"https://api.github.com/users/ThatSimpleDev/orgs","repos_url":"https://api.github.com/users/ThatSimpleDev/repos","events_url":"https://api.github.com/users/ThatSimpleDev/events{/privacy}","received_events_url":"https://api.github.com/users/ThatSimpleDev/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2024-11-23T05:34:18Z","updated_at":"2024-11-23T05:34:18Z","body":"\r\n@syntaxerror247 Just tested the test apk provided here and when opening the resources it doesn't open the native file picker is that intentional? \r\nAlso it says you don't have enough permissions as you can see in the screenshot below 👇 \r\n\r\n![Screenshot_2024-11-23-03-07-05-35_b62382514e18f27f1d9e6a66d3a6598c](https://github.com/user-attachments/assets/4230b4dc-0c1b-45b7-b5f7-cbbe5eb8aa8f)\r\n\r\nI also tested this on v4.4 Dev 5 and when I try to use the native file dialog (not through code) and setting the access as ACCESS_FILESYSTEM the app immediately closes when I press the button. I believe I have checked the needed read user directory permissions (It asked to enable the same permission as the test apk you provided). Did you do this through code? ","author_association":"NONE","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2495325974/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2495361144","html_url":"https://github.com/godotengine/godot/pull/98350#issuecomment-2495361144","issue_url":"https://api.github.com/repos/godotengine/godot/issues/98350","id":2495361144,"node_id":"IC_kwDOAO6SJc6UvDB4","user":{"login":"syntaxerror247","id":176927541,"node_id":"U_kgDOCouzNQ","avatar_url":"https://avatars.githubusercontent.com/u/176927541?v=4","gravatar_id":"","url":"https://api.github.com/users/syntaxerror247","html_url":"https://github.com/syntaxerror247","followers_url":"https://api.github.com/users/syntaxerror247/followers","following_url":"https://api.github.com/users/syntaxerror247/following{/other_user}","gists_url":"https://api.github.com/users/syntaxerror247/gists{/gist_id}","starred_url":"https://api.github.com/users/syntaxerror247/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/syntaxerror247/subscriptions","organizations_url":"https://api.github.com/users/syntaxerror247/orgs","repos_url":"https://api.github.com/users/syntaxerror247/repos","events_url":"https://api.github.com/users/syntaxerror247/events{/privacy}","received_events_url":"https://api.github.com/users/syntaxerror247/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2024-11-23T06:13:09Z","updated_at":"2024-11-23T06:14:41Z","body":"> Just tested the test apk provided here and when opening the resources it doesn't open the native file picker is that intentional?\r\n\r\n@ThatSimpleDev Yes, that intentional. Android doesn't allow access to user:// and res:// directory, that's why it fallbacks to custom Filedialog.\r\n\r\n> I also tested this on v4.4 Dev 5 and when I try to use the native file dialog (not through code) and setting the access as ACCESS_FILESYSTEM the app immediately closes when I press the button.\r\n\r\nYes, This is a [regression](https://github.com/godotengine/godot/issues/99326) due an update to FileDialog. This issue wasn't present in dev4. This will be solved after these two PRs https://github.com/godotengine/godot/pull/99350 and https://github.com/godotengine/godot/pull/99385 are merged.\r\n\r\nFor now, you can use it via code.","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2495361144/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2881842807","html_url":"https://github.com/godotengine/godot/pull/98350#issuecomment-2881842807","issue_url":"https://api.github.com/repos/godotengine/godot/issues/98350","id":2881842807,"node_id":"IC_kwDOAO6SJc6rxW53","user":{"login":"PostPollux","id":9008901,"node_id":"MDQ6VXNlcjkwMDg5MDE=","avatar_url":"https://avatars.githubusercontent.com/u/9008901?v=4","gravatar_id":"","url":"https://api.github.com/users/PostPollux","html_url":"https://github.com/PostPollux","followers_url":"https://api.github.com/users/PostPollux/followers","following_url":"https://api.github.com/users/PostPollux/following{/other_user}","gists_url":"https://api.github.com/users/PostPollux/gists{/gist_id}","starred_url":"https://api.github.com/users/PostPollux/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/PostPollux/subscriptions","organizations_url":"https://api.github.com/users/PostPollux/orgs","repos_url":"https://api.github.com/users/PostPollux/repos","events_url":"https://api.github.com/users/PostPollux/events{/privacy}","received_events_url":"https://api.github.com/users/PostPollux/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-05-14T23:48:23Z","updated_at":"2025-05-14T23:48:23Z","body":"@syntaxerror247 \r\nFirst of all, thank you for your work! Very appreciated! \r\nI tried to use the new native dialog but I have a hard time to get anything meaningful done with it. The native dialog opens and i can select a file. The \"file_selected\" signal also fires and it returns the correct path of the file. Up to this point everything works fine and I guess this is what this PR was implementing.\r\nWhere the problem starts is when I want to read that file, as I still do not have permissions for that. I thought this was handled by the SAF (Storage Access Framework) automatically. But I guess it's not the case. I noticed that the test.apk you uploaded here asked for the \"MANAGE_EXTERNAL_STORAGE\" permission. I guess if I add that to my application it works as well, but that is no option. I want to release my app in Google Play and this permission is something google only allows for apps like file managers, as it is a dangerous permission.\r\nSo my question is: Is there currently any way in Godot to read a file selected with the native dialog in Android other than adding that \"MANAGER_EXTERNAL_STORAGE\" permission? Or would I have to write a plugin that somehow reads that file with SAF access management. Or is there another effort or PR that's tackling that problem? I did not find any with a quick search. Thanks.","author_association":"NONE","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2881842807/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3025195278","html_url":"https://github.com/godotengine/godot/pull/98350#issuecomment-3025195278","issue_url":"https://api.github.com/repos/godotengine/godot/issues/98350","id":3025195278,"node_id":"IC_kwDOAO6SJc60UNEO","user":{"login":"Rocket-007","id":82693254,"node_id":"MDQ6VXNlcjgyNjkzMjU0","avatar_url":"https://avatars.githubusercontent.com/u/82693254?v=4","gravatar_id":"","url":"https://api.github.com/users/Rocket-007","html_url":"https://github.com/Rocket-007","followers_url":"https://api.github.com/users/Rocket-007/followers","following_url":"https://api.github.com/users/Rocket-007/following{/other_user}","gists_url":"https://api.github.com/users/Rocket-007/gists{/gist_id}","starred_url":"https://api.github.com/users/Rocket-007/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Rocket-007/subscriptions","organizations_url":"https://api.github.com/users/Rocket-007/orgs","repos_url":"https://api.github.com/users/Rocket-007/repos","events_url":"https://api.github.com/users/Rocket-007/events{/privacy}","received_events_url":"https://api.github.com/users/Rocket-007/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-07-01T19:01:20Z","updated_at":"2025-07-01T19:01:20Z","body":"@PostPollux \r\nHave you found a way to achieve this yet?","author_association":"NONE","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3025195278/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3025975418","html_url":"https://github.com/godotengine/godot/pull/98350#issuecomment-3025975418","issue_url":"https://api.github.com/repos/godotengine/godot/issues/98350","id":3025975418,"node_id":"IC_kwDOAO6SJc60XLh6","user":{"login":"syntaxerror247","id":176927541,"node_id":"U_kgDOCouzNQ","avatar_url":"https://avatars.githubusercontent.com/u/176927541?v=4","gravatar_id":"","url":"https://api.github.com/users/syntaxerror247","html_url":"https://github.com/syntaxerror247","followers_url":"https://api.github.com/users/syntaxerror247/followers","following_url":"https://api.github.com/users/syntaxerror247/following{/other_user}","gists_url":"https://api.github.com/users/syntaxerror247/gists{/gist_id}","starred_url":"https://api.github.com/users/syntaxerror247/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/syntaxerror247/subscriptions","organizations_url":"https://api.github.com/users/syntaxerror247/orgs","repos_url":"https://api.github.com/users/syntaxerror247/repos","events_url":"https://api.github.com/users/syntaxerror247/events{/privacy}","received_events_url":"https://api.github.com/users/syntaxerror247/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-07-02T01:05:59Z","updated_at":"2025-07-02T01:05:59Z","body":"@PostPollux @Rocket-007 \r\nSee https://github.com/godotengine/godot-proposals/issues/12669\r\n\r\nYou can still use the file picker with the limitations that app would be only able to save to Download and Documents directory and it would be only able to access files it's has created. If you are working with media files then you can enable permission like READ_MEDIA_IMAGES to get broader read access.","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3025975418/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3030025388","html_url":"https://github.com/godotengine/godot/pull/98350#issuecomment-3030025388","issue_url":"https://api.github.com/repos/godotengine/godot/issues/98350","id":3030025388,"node_id":"IC_kwDOAO6SJc60moSs","user":{"login":"PostPollux","id":9008901,"node_id":"MDQ6VXNlcjkwMDg5MDE=","avatar_url":"https://avatars.githubusercontent.com/u/9008901?v=4","gravatar_id":"","url":"https://api.github.com/users/PostPollux","html_url":"https://github.com/PostPollux","followers_url":"https://api.github.com/users/PostPollux/followers","following_url":"https://api.github.com/users/PostPollux/following{/other_user}","gists_url":"https://api.github.com/users/PostPollux/gists{/gist_id}","starred_url":"https://api.github.com/users/PostPollux/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/PostPollux/subscriptions","organizations_url":"https://api.github.com/users/PostPollux/orgs","repos_url":"https://api.github.com/users/PostPollux/repos","events_url":"https://api.github.com/users/PostPollux/events{/privacy}","received_events_url":"https://api.github.com/users/PostPollux/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-07-03T01:26:39Z","updated_at":"2025-07-03T01:32:27Z","body":"> @PostPollux Have you found a way to achieve this yet?\r\n\r\n@Rocket-007 \r\nYes, I actually used this plugin:  https://github.com/SeppNel/Godot-File-Picker which is an updated fork from https://github.com/pattlebass/Godot-File-Picker\r\n\r\n\r\nWhat it does is also opening the native file browser, but it then copies the selected file to a location where Godot has access to without any additional permissions needed. However, you are then responsible for deleting those files again when they are not needed anymore. But that's fine.","author_association":"NONE","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3030025388/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null}]