[{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2424469249","html_url":"https://github.com/godotengine/godot/pull/98350#issuecomment-2424469249","issue_url":"https://api.github.com/repos/godotengine/godot/issues/98350","id":2424469249,"node_id":"IC_kwDOAO6SJc6QgncB","user":{"login":"syntaxerror247","id":176927541,"node_id":"U_kgDOCouzNQ","avatar_url":"https://avatars.githubusercontent.com/u/176927541?v=4","gravatar_id":"","url":"https://api.github.com/users/syntaxerror247","html_url":"https://github.com/syntaxerror247","followers_url":"https://api.github.com/users/syntaxerror247/followers","following_url":"https://api.github.com/users/syntaxerror247/following{/other_user}","gists_url":"https://api.github.com/users/syntaxerror247/gists{/gist_id}","starred_url":"https://api.github.com/users/syntaxerror247/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/syntaxerror247/subscriptions","organizations_url":"https://api.github.com/users/syntaxerror247/orgs","repos_url":"https://api.github.com/users/syntaxerror247/repos","events_url":"https://api.github.com/users/syntaxerror247/events{/privacy}","received_events_url":"https://api.github.com/users/syntaxerror247/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2024-10-20T02:54:56Z","updated_at":"2024-10-20T19:40:25Z","body":"I think we cannot implement selected_file_index callback it would work with single file section ( I can get file mime type) but would create problem in multiple section mode (if user selects multiple type of files from storage).","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2424469249/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":{"reason":"outdated"}},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2424470391","html_url":"