users/MatthiasBae/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-09-27T10:11:51Z","updated_at":"2025-09-27T10:14:13Z","body":"> Check your \"PerformanceFast.csproj\" file The two projects utilize net8 and net9 respectively, which might be the primary reason\n\nYou are right. But changing the .NET version to .NET 8 or 9 in both projects did not affect the FPS in any way","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3341472490/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3341549816","html_url":"https://github.com/godotengine/godot/issues/110945#issuecomment-3341549816","issue_url":"https://api.github.com/repos/godotengine/godot/issues/110945","id":3341549816,"node_id":"IC_kwDOAO6SJc7HLAD4","user":{"login":"MatthiasBae","id":52577744,"node_id":"MDQ6VXNlcjUyNTc3NzQ0","avatar_url":"https://avatars.githubusercontent.com/u/52577744?v=4","gravatar_id":"","url":"https://api.github.com/users/MatthiasBae","html_url":"https://github.com/MatthiasBae","followers_url":"https://api.github.com/users/MatthiasBae/followers","following_url":"https://api.github.com/users/MatthiasBae/following{/other_user}","gists_url":"https://api.github.com/users/MatthiasBae/gists{/gist_id}","starred_url":"https://api.github.com/users/MatthiasBae/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/MatthiasBae/subscriptions","organizations_url":"https://api.github.com/users/MatthiasBae/orgs","repos_url":"https://api.github.com/users/MatthiasBae/repos","events_url":"https://api.github.com/users/MatthiasBae/events{/privacy}","received_events_url":"https://api.github.com/users/MatthiasBae/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-09-27T11:25:46Z","updated_at":"2025-09-27T11:25:46Z","body":"Okay I guess I found the \"Issue\". It was a forgotten project setting I messed around months ago. Physics Interpolation was turned on (turned off in the new project). Turning it off increases the performance from 90 to 500 PFS.\n\nSorry for the inconvenience!","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3341549816/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3341889419","html_url":"https://github.com/godotengine/godot/issues/110945#issuecomment-3341889419","issue_url":"https://api.github.com/repos/godotengine/godot/issues/110945","id":3341889419,"node_id":"IC_kwDOAO6SJc7HMS-L","user":{"login":"Calinou","id":180032,"node_id":"MDQ6VXNlcjE4MDAzMg==","avatar_url":"https://avatars.githubusercontent.com/u/180032?v=4","gravatar_id":"","url":"https://api.github.com/users/Calinou","html_url":"https://github.com/Calinou","followers_url":"https://api.github.com/users/Calinou/followers","following_url":"https://api.github.com/users/Calinou/following{/other_user}","gists_url":"https://api.github.com/users/Calinou/gists{/gist_id}","starred_url":"https://api.github.com/users/Calinou/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Calinou/subscriptions","organizations_url":"https://api.github.com/users/Calinou/orgs","repos_url":"https://api.github.com/users/Calinou/repos","events_url":"https://api.github.com/users/Calinou/events{/privacy}","received_events_url":"https://api.github.com/users/Calinou/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-09-27T16:11:49Z","updated_at":"2025-09-27T16:12:19Z","body":"> Physics Interpolation was turned on (turned off in the new project). Turning it off increases the performance from 90 to 500 PFS.\n\nI don't think enabling physics interpolation should have such a large performance impact (that's a 9.1 mspf difference). There's definitely something wrong here.\n\ncc @lawnjelly ","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3341889419/reactions","total_count":2,"+1":2,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3342569999","html_url":"https://github.com/godotengine/godot/issues/110945#issuecomment-3342569999","issue_url":"https://api.github.com/repos/godotengine/godot/issues/110945","id":3342569999,"node_id":"IC_kwDOAO6SJc7HO5IP","user":{"login":"lawnjelly","id":21999379,"node_id":"MDQ6VXNlcjIxOTk5Mzc5","avatar_url":"https://avatars.githubusercontent.com/u/21999379?v=4","gravatar_id":"","url":"https://api.github.com/users/lawnjelly","html_url":"https://github.com/lawnjelly","followers_url":"https://api.github.com/users/lawnjelly/followers","following_url":"https://api.github.com/users/lawnjelly/following{/other_user}","gists_url":"https://api.github.com/users/lawnjelly/gists{/gist_id}","starred_url":"https://api.github.com/users/lawnjelly/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/lawnjelly/subscriptions","organizations_url":"https://api.github.com/users/lawnjelly/orgs","repos_url":"https://api.github.com/users/lawnjelly/repos","events_url":"https://api.github.com/users/lawnjelly/events{/privacy}","received_events_url":"https://api.github.com/users/lawnjelly/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-09-28T08:33:11Z","updated_at":"2025-09-28T08:33:11Z","body":"Unfortunately I can't run the MRP as I don't have the C# stuff.\nIf an issue is not to do with C#, the MRP should be gdscript, I think we have something about this in the issue template.\n\nPhysics interpolation can potentially slow a project, but it depends on the project and where the bottlenecks are. In particular 4.x doesn't have 2D hierarchical culling, but I can't say any more without being able to run / profile. ","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3342569999/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3344068402","html_url":"https://github.com/godotengine/godot/issues/110945#issuecomment-3344068402","issue_url":"https://api.github.com/repos/godotengine/godot/issues/110945","id":3344068402,"node_id":"IC_kwDOAO6SJc7HUm8y","user":{"login":"MatthiasBae","id":52577744,"node_id":"MDQ6VXNlcjUyNTc3NzQ0","avatar_url":"https://avatars.githubusercontent.com/u/52577744?v=4","gravatar_id":"","url":"https://api.github.com/users/MatthiasBae","html_url":"https://github.com/MatthiasBae","followers_url":"https://api.github.com/users/MatthiasBae/followers","following_url":"https://api.github.com/users/MatthiasBae/following{/other_user}","gists_url":"https://api.github.com/users/MatthiasBae/gists{/gist_id}","starred_url":"https://api.github.com/users/MatthiasBae/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/MatthiasBae/subscriptions","organizations_url":"https://api.github.com/users/MatthiasBae/orgs","repos_url":"https://api.github.com/users/MatthiasBae/repos","events_url":"https://api.github.com/users/MatthiasBae/events{/privacy}","received_events_url":"https://api.github.com/users/MatthiasBae/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-09-28T18:18:09Z","updated_at":"2025-09-28T18:33:35Z","body":"> > Physics Interpolation was turned on (turned off in the new project). Turning it off