s/bruvzg/subscriptions","organizations_url":"https://api.github.com/users/bruvzg/orgs","repos_url":"https://api.github.com/users/bruvzg/repos","events_url":"https://api.github.com/users/bruvzg/events{/privacy}","received_events_url":"https://api.github.com/users/bruvzg/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-11-25T09:08:44Z","updated_at":"2025-11-25T09:08:44Z","body":"Indeed, it's something with alignment (or calculation of it), `DATA_OFFSET` somehow evaluates to `24` while it should be aligned to `alignof(max_align_t)` which is `16`.","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3574571688/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3574640938","html_url":"https://github.com/godotengine/godot/issues/113113#issuecomment-3574640938","issue_url":"https://api.github.com/repos/godotengine/godot/issues/113113","id":3574640938,"node_id":"IC_kwDOAO6SJc7VELEq","user":{"login":"Ivorforce","id":2308167,"node_id":"MDQ6VXNlcjIzMDgxNjc=","avatar_url":"https://avatars.githubusercontent.com/u/2308167?v=4","gravatar_id":"","url":"https://api.github.com/users/Ivorforce","html_url":"https://github.com/Ivorforce","followers_url":"https://api.github.com/users/Ivorforce/followers","following_url":"https://api.github.com/users/Ivorforce/following{/other_user}","gists_url":"https://api.github.com/users/Ivorforce/gists{/gist_id}","starred_url":"https://api.github.com/users/Ivorforce/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Ivorforce/subscriptions","organizations_url":"https://api.github.com/users/Ivorforce/orgs","repos_url":"https://api.github.com/users/Ivorforce/repos","events_url":"https://api.github.com/users/Ivorforce/events{/privacy}","received_events_url":"https://api.github.com/users/Ivorforce/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-11-25T09:26:53Z","updated_at":"2025-11-25T09:26:53Z","body":"> Indeed, it's something with alignment (or calculation of it), `DATA_OFFSET` somehow evaluates to `24` while it should be aligned to `alignof(max_align_t)` which is `16`.\n\nDid you check this in a 32-bit binary? I had another look at `Memory::get_aligned_address` and can't see a fault with it.\n\nA full stracktrace (and possible variable dump) could be useful. I have a Windows PC (64-bit) at home, I've never developed anything on it but now could be a time to start I suppose.","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3574640938/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3574656833","html_url":"https://github.com/godotengine/godot/issues/113113#issuecomment-3574656833","issue_url":"https://api.github.com/repos/godotengine/godot/issues/113113","id":3574656833,"node_id":"IC_kwDOAO6SJc7VEO9B","user":{"login":"bruvzg","id":7645683,"node_id":"MDQ6VXNlcjc2NDU2ODM=","avatar_url":"https://avatars.githubusercontent.com/u/7645683?v=4","gravatar_id":"","url":"https://api.github.com/users/bruvzg","html_url":"https://github.com/bruvzg","followers_url":"https://api.github.com/users/bruvzg/followers","following_url":"https://api.github.com/users/bruvzg/following{/other_user}","gists_url":"https://api.github.com/users/bruvzg/gists{/gist_id}","starred_url":"https://api.github.com/users/bruvzg/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/bruvzg/subscriptions","organizations_url":"https://api.github.com/users/bruvzg/orgs","repos_url":"https://api.github.com/users/bruvzg/repos","events_url":"https://api.github.com/users/bruvzg/events{/privacy}","received_events_url":"https://api.github.com/users/bruvzg/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-11-25T09:30:45Z","updated_at":"2025-11-25T09:30:45Z","body":"It is a 32-bit binary, and `alignof(max_align_t)` might be completely broken, it seems to be returning either 8 or 16 different times its called.","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3574656833/reactions","total_count":1,"+1":0,"-1":0,"laugh":1,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3574679511","html_url":"https://github.com/godotengine/godot/issues/113113#issuecomment-3574679511","issue_url":"https://api.github.com/repos/godotengine/godot/issues/113113","id":3574679511,"node_id":"IC_kwDOAO6SJc7VEUfX","user":{"login":"Ivorforce","id":2308167,"node_id":"MDQ6VXNlcjIzMDgxNjc=","avatar_url":"https://avatars.githubusercontent.com/u/2308167?v=4","gravatar_id":"","url":"https://api.github.com/users/Ivorforce","html_url":"https://github.com/Ivorforce","followers_url":"https://api.github.com/users/Ivorforce/followers","following_url":"https://api.github.com/users/Ivorforce/following{/other_user}","gists_url":"https://api.github.com/users/Ivorforce/gists{/gist_id}","starred_url":"https://api.github.com/users/Ivorforce/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Ivorforce/subscriptions","organizations_url":"https://api.github.com/users/Ivorforce/orgs","repos_url":"https://api.github.com/users/Ivorforce/repos","events_url":"https://api.github.com/users/Ivorforce/events{/privacy}","received_events_url":"https://api.github.com/users/Ivorforce/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-11-25T09:36:00Z","updated_at":"2025-11-25T09:36:00Z","body":"That's wild. So I guess it might be a different alignment in different compile units? That could explain the issue.\n\nShould be fixable if we exchange `max_align_t` with our own typedef, though I'm not sure what's a reliable way to set it. I guess we could use `max_align_t` on all platforms except 32-bit windows, where we hardcode it to 8.","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3574679511/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3574688392","html_url":"https://github.com/godotengine/godot/issues/113113#issuecomment-3574688392","issue_url":"https://api.github.com/repos/godotengine/godot/issues/113113","id":3574688392,"node_id":"IC_kwDOAO6SJc7VEWqI","user":{"login":"AThousandShips","id":96648715,"node_id":"U_kgDOBcK-Cw","avatar_url":"https://avatars.githubusercontent.com/u/96648715?v=4","gravatar_id":"","url":"https://api.github.com/users/AThousandShips","html_url":"https://github.com/AThousandShips","followers_url":"https://api.github.com/users/AThousandShips/followers","following_url":"https://api.github.com/users/AThousandShips/following{/other_user}","gists_url":"https://api.github.com/users/AThousandShips/gists{/gist_id}","starred_url":"https://api.github.com/users/AThousandShips/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/AThousandShips/subscriptions","organizations_url":"https://api.github.com/users/AThousandShips/orgs","repos_url":"https://api.github.com/users/AThousandShips/repos","events_url":"https://api.github.com/users/AThousandShips/events{/privacy}","received_events_url":"https://api.github.com/users/AThousandShips/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-11-25T09:38:19Z","updated_at":"2025-11-25T09:38:19Z","body":"That sounds like a good band-aid at least until we can identify what's going on, could be a compiler quirk. Looked around but couldn't find any known defects so far","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3574688392/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3574706012","html_url":"https://github.com/godotengine/godot/issues/113113#issuecomment-3574706012","issue_url":"https://api.github.com/repos/godotengine/godot/issues/113113","id":3574706012,"node_id":"IC_kwDOAO6SJc7VEa9c","user":{"login":"bruvzg","id":7645683,"node_id":"MDQ6VXNlcjc2NDU2ODM=","avatar_url":"https://avatars.githubusercontent.com/u/7645683?v=4","gravatar_id":"","url":"https://api.github.com/users/bruvzg","html_url":"https://github.com/bruvzg","followers_url":"https://api.github.com/users/bruvzg/followers","following_url":"https://api.github.com/users/bruvzg/following{/other_user}","gists_url":"https://api.github.com/users/bruvzg/gists{/gist_id}","starred_url":"https://api.github.com/users/bruvzg/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/bruvzg/subscriptions","organizations_url":"https://api.github.com/users/bruvzg/orgs","repos_url":"https://api.github.com/users/bruvzg/repos","events_url":"https://api.github.com/users/bruvzg/events{/privacy}","received_events_url":"https://api.github.com/users/bruvzg/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-11-25T09:42:46Z","updated_at":"2025-11-25T09:42:46Z","body":"```c++\n\t_FORCE_INLINE_ T &operator[](typename CowData<T>::Size p_index) {\n\t\tif (p_index >= ((Vector<T> *)(this))->_cowdata.size()) {\n\t\t\tprintf(\"align: %lld maxal: %lld\\n\", (uint64_t)alignof(T), (uint64_t)alignof(max_align_t));\n\t\t}\n\t\tCRASH_BAD_INDEX(p_index, ((Vector<T> *)(this))->_cowdata.size());\n\n\t\treturn ((Vector<T> *)(this))->_cowdata.ptrw()[p_index];\n\t}\n```\nThis in the `vector.h` prints `align: 4 maxal: 16` for the crashing vector, but in `main.cpp` it's `8`. So I guess it is different, probably depending on defined structs in the unit.","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3574706012/reactions","total_count":2,"+1":2,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3574724547","html_url":"https://github.com/godotengine/godot/issues/113113#issuecomment-3574724547","issue_url":"https://api.github.com/repos/godotengine/godot/issues/113113","id":3574724547,"node_id":"IC_kwDOAO6SJc7VEffD","user":{"login":"bruvzg","id":7645683,"node_id":"MDQ6VXNlcjc2NDU2ODM=","avatar_url":"https://avatars.githubusercontent.com/u/7645683?v=4","gravatar_id":"","url":"https://api.github.com/users/bruvzg","html_url":"https://github.com/bruvzg","followers_url":"https://api.github.com/users/bruvzg/followers","following_url":"https://api.github.com/users/bruvzg/following{/other_user}","gists_url":"https://api.github.com/users/bruvzg/gists{/gist_id}","starred_url":"https://api.github.com/users/bruvzg/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/bruvzg/subscriptions","organizations_url":"https://api.github.com/users/bruvzg/orgs","repos_url":"https://api.github.com/users/bruvzg/repos","events_url":"https://api.github.com/users/bruvzg/events{/privacy}","received_events_url":"https://api.github.com/users/bruvzg/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-11-25T09:46:20Z","updated_at":"2025-11-25T09:46:20Z","body":"> Should be fixable if we exchange max_align_t with our own typedef, though I'm not sure what's a reliable way to set it. I guess we could use max_align_t on all platforms except 32-bit windows, where we hardcode it to 8.\n\nWe were using hardcoded aligns in the past, so I would replace it with something like `MAX(alignof(max_align_t), 16)` at least as a temporary fix.","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3574724547/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3574749576","html_url":"https://github.com/godotengine/godot/issues/113113#issuecomment-3574749576","issue_url":"https://api.github.com/repos/godotengine/godot/issues/113113","id":3574749576,"node_id":"IC_kwDOAO6SJc7VElmI","user":{"login":"bruvzg","id":7645683,"node_id":"MDQ6VXNlcjc2NDU2ODM=","avatar_url":"https://avatars.githubusercontent.com/u/7645683?v=4","gravatar_id":"","url":"https://api.github.com/users/bruvzg","html_url":"https://github.com/bruvzg","followers_url":"https://api.github.com/users/bruvzg/followers","following_url":"https://api.github.com/users/bruvzg/following{/other_user}","gists_url":"https://api.github.com/users/bruvzg/gists{/gist_id}","starred_url":"https://api.github.com/users/bruvzg/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/bruvzg/subscriptions","organizations_url":"https://api.github.com/users/bruvzg/orgs","repos_url":"https://api.github.com/users/bruvzg/repos","events_url":"https://api.github.com/users/bruvzg/events{/privacy}","received_events_url":"https://api.github.com/users/bruvzg/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-11-25T09:52:33Z","updated_at":"2025-11-25T09:52:33Z","body":"Ir just a hardcoded value with static assert to check `alignof(max_align_t)` is not bigger.