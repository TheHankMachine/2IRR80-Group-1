 22 +++++\n core/string/ustring.cpp                                                      |   4 +-\n core/string/ustring.h                                                        |  13 ++-\n core/templates/cowdata.h                                                     | 443 +++++++++++++++++++++++++++++++++++++++++++++++++++++++++------------------------------\n core/templates/local_vector.h                                                |   8 +-\n core/templates/vector.h                                                      |  18 ++--\n core/variant/array.cpp                                                       |   5 +\n core/variant/array.h                                                         |   1 +\n modules/mono/glue/GodotSharp/GodotSharp/Core/NativeInterop/InteropStructs.cs |  36 +++----\n modules/mono/glue/GodotSharp/GodotSharp/Core/NativeInterop/NativeFuncs.cs    |  26 ++++++\n modules/mono/glue/runtime_interop.cpp                                        |  60 ++++++++++++\n 11 files changed, 438 insertions(+), 198 deletions(-)\n```\n\nBisects to https://github.com/godotengine/godot/pull/105928","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3574223556/reactions","total_count":2,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":2},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3574387555","html_url":"https://github.com/godotengine/godot/issues/113113#issuecomment-3574387555","issue_url":"https://api.github.com/repos/godotengine/godot/issues/113113","id":3574387555,"node_id":"IC_kwDOAO6SJc7VDNNj","user":{"login":"AThousandShips","id":96648715,"node_id":"U_kgDOBcK-Cw","avatar_url":"https://avatars.githubusercontent.com/u/96648715?v=4","gravatar_id":"","url":"https://api.github.com/users/AThousandShips","html_url":"https://github.com/AThousandShips","followers_url":"https://api.github.com