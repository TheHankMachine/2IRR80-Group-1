or":"ffee88","default":false,"description":"","archived_at":null,"archived_by":null},{"id":2666708289,"node_id":"MDU6TGFiZWwyNjY2NzA4Mjg5","url":"https://api.github.com/repos/godotengine/godot/labels/topic:3d","name":"topic:3d","color":"ffee88","default":false,"description":"","archived_at":null,"archived_by":null}],"state":"closed","locked":false,"assignees":[],"milestone":{"url":"https://api.github.com/repos/godotengine/godot/milestones/22","html_url":"https://github.com/godotengine/godot/milestone/22","labels_url":"https://api.github.com/repos/godotengine/godot/milestones/22/labels","id":12070367,"node_id":"MI_kwDOAO6SJc4AuC3f","number":22,"title":"4.5","description":"","creator":{"login":"Sauermann","id":6299227,"node_id":"MDQ6VXNlcjYyOTkyMjc=","avatar_url":"https://avatars.githubusercontent.com/u/6299227?v=4","gravatar_id":"","url":"https://api.github.com/users/Sauermann","html_url":"https://github.com/Sauermann","followers_url":"https://api.github.com/users/Sauermann/followers","following_url":"https://api.github.com/users/Sauermann/following{/other_user}","gists_url":"https://api.github.com/users/Sauermann/gists{/gist_id}","starred_url":"https://api.github.com/users/Sauermann/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Sauermann/subscriptions","organizations_url":"https://api.github.com/users/Sauermann/orgs","repos_url":"https://api.github.com/users/Sauermann/repos","events_url":"https://api.github.com/users/Sauermann/events{/privacy}","received_events_url":"https://api.github.com/users/Sauermann/received_events","type":"User","user_view_type":"public","site_admin":false},"open_issues":3,"closed_issues":3687,"state":"closed","created_at":"2024-12-19T08:51:28Z","updated_at":"2026-09-04T21:48:38Z","due_on":"2025-09-15T00:00:00Z","closed_at":"2025-09-18T17:13:14Z"},"comments":1,"created_at":"2025-04-18T15:05:21Z","updated_at":"2025-04-21T13:31:38Z","closed_at":"2025-04-21T13:31:07Z","assignee":null,"author_association":"CONTRIBUTOR","issue_field_values":[],"type":null,"active_lock_reason":null,"draft":false,"pull_request":{"url":"https://api.github.com/repos/godotengine/godot/pulls/105525","html_url":"https://github.com/godotengine/godot/pull/105525","diff_url":"https://github.com/godotengine/godot/pull/105525.diff","patch_url":"https://github.com/godotengine/godot/pull/105525.patch","merged_at":"2025-04-21T13:31:07Z"},"body":"Improves the spherical harmonics evaluation code based on https://github.com/kayru/Probulator/blob/master/Source/Probulator/SphericalHarmonics.h and https://cseweb.ucsd.edu/~ravir/papers/envmap/envmap.pdf . \r\n\r\nAs a result, the coefficients in the diffuse evaluation process more closely resemble the ones from the lightmapper, making the code slightly easier to comprehend.\r\nAdditionally, the magic numbers resulting from the convolution of directional SH are documented as equations.\r\n\r\nResulting numbers comparison:\r\n| SH coeff | Old | Old (calculated) | New | New (calculated) |\r\n|----------|-----|------------------|-----|------------------|\r\n| 0 | 0.886227 | 0.886227 | 0.886227 | 0.886227 | 0.886227 |\r\n| 1 | 0.511664 * 2.0 * y | 1.023328 * y | 1.023327 * y | 1.023327 * y |\r\n| 2 | 0.511664 * 2.0 * z | 1.023328 * z | 1.023327 * z | 1.023327 * z |\r\n| 3 | 0.511664 * 2.0 * x | 1.023328 * x | 1.023327 * x | 1.023327 * x |\r\n| 4 | 0.429043 * 2.0 * x*y | 0.858086 * x*y | 0.858086 * x*y | 0.858086 * x*y |\r\n| 5 | 0.429043 * 2.0 * y*z | 0.858086 * y*z | 0.858086 * y*z | 0.858086 * y*z |\r\n| 6 | 0.743125 * z*z - 0.247708 | 0.743125 * z*z - 0.247708 | 0.247708 * (3.0 * z*z - 1.0) | 0.743124 * z*z - 0.247708 |\r\n| 7 | 0.429043 * 2.0 * x*z | 0.858086 * x*z | 0.858086 * x*z | 0.858086 * x*z |\r\n| 8 | 0.429043 * (x*x - y*y) | 0.429043 * (x*x - y*y) | 0.429043 * (x*x - y*y) | 0.429043 * (x*x - y*y) |","closed_by":{"login":"Repiteo","id":17489292,"node_id":"MDQ6VXNlcjE3NDg5Mjky","avatar_url":"https://avatars.githubusercontent.com/u/17489292?v=4","gravatar_id":"","url":"https://api.github.com/users/Repiteo","html_url":"https://github.com/Repiteo","followers_url":"https://api.github.com/users/Repiteo/followers","following_url":"https://api.github.com/users/Repiteo/following{/other_user}","gists_url":"https://api.github.com/users/Repiteo/gists{/gist_id}","starred_url":"https://api.github.com/users/Repiteo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Repiteo/subscriptions","organizations_url":"https://api.github.com/users/Repiteo/orgs","repos_url":"https://api.github.com/users/Repiteo/repos","events_url":"https://api.github.com/users/Repiteo/events{/privacy}","received_events_url":"https://api.github.com/users/Repiteo/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/105525/reactions","total_count":4,"+1":3,"-1":0,"laugh":0,"hooray":1,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/godotengine/godot/issues/105525/timeline","performed_via_github_app":null,"state_reason":null}