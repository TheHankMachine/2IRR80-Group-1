[{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2775690160","html_url":"https://github.com/godotengine/godot/issues/104966#issuecomment-2775690160","issue_url":"https://api.github.com/repos/godotengine/godot/issues/104966","id":2775690160,"node_id":"IC_kwDOAO6SJc6lcauw","user":{"login":"Rudolph-B","id":52322745,"node_id":"MDQ6VXNlcjUyMzIyNzQ1","avatar_url":"https://avatars.githubusercontent.com/u/52322745?v=4","gravatar_id":"","url":"https://api.github.com/users/Rudolph-B","html_url":"https://github.com/Rudolph-B","followers_url":"https://api.github.com/users/Rudolph-B/followers","following_url":"https://api.github.com/users/Rudolph-B/following{/other_user}","gists_url":"https://api.github.com/users/Rudolph-B/gists{/gist_id}","starred_url":"https://api.github.com/users/Rudolph-B/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Rudolph-B/subscriptions","organizations_url":"https://api.github.com/users/Rudolph-B/orgs","repos_url":"https://api.github.com/users/Rudolph-B/repos","events_url":"https://api.github.com/users/Rudolph-B/events{/privacy}","received_events_url":"https://api.github.com/users/Rudolph-B/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-04-03T12:50:48Z","updated_at":"2025-04-03T12:50:48Z","body":"I was able to replicate the behavior you described. I believe this is expected/intended behavior since Godot doesn't constantly poll the file system for changes to resources but instead works from cached resources.\n\nIf you want this type of behavior, you would need to manually reload the texture for the `Sprite2D` node in your GDScript, using something like this:\n```\nvar sprite = get_node(\"Saved\")\nvar new_texture = ResourceLoader.load(save_path, \"\", ResourceLoader.CACHE_MODE_IGNORE)\nsprite.set_texture(new_texture)\n```","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2775690160/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2775739747","html_url":"https://github.com/godotengine/godot/issues/104966#issuecomment-2775739747","issue_url":"https://api.github.com/repos/godotengine/godot/issues/104966","id":2775739747,"node_id":"IC_kwDOAO6SJc6lcm1j","user":{"login":"beicause","id":75941842,"node_id":"MDQ6VXNlcjc1OTQxODQy","avatar_url":"https://avatars.githubusercontent.com/u/75941842?v=4","gravatar_id":"","url":"https://api.github.com/users/beicause","html_url":"https://github.com/beicause","followers_url":"https://api.github.com/users/beicause/followers","following_url":"https://api.github.com/users/beicause/following{/other_user}","gists_url":"https://api.github.com/users/beicause/gists{/gist_id}","starred_url":"https://api.github.com/users/beicause/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/beicause/subscriptions","organizations_url":"https://api.github.com/users/beicause/orgs","repos_url":"https://api.github.com/users/beicause/repos","events_url":"https://api.github.com/users/beicause/events{/privacy}","received_events_url":"https://api.github.com/users/beicause/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-04-03T13:09:57Z","updated_at":"2025-04-03T13:09:57Z","body":"Renaming PortableCompressedTexture can also make it update, but it will additionally generate a duplicate with original filename.\nThis should not be an expected behavior. I also tried modifying GradientTexture2D in tool script and saving it, and it can update normally.","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2775739747/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2776192950","html_url":"https://github.com/godotengine/godot/issues/104966#issuecomment-2776192950","issue_url":"https://api.github.com/repos/godotengine/godot/issues/104966","id":2776192950,"node_id":"IC_kwDOAO6SJc6leVe2","user":{"login":"Rudolph-B","id":52322745,"node_id":"MDQ6VXNlcjUyMzIyNzQ1","avatar_url":"https://avatars.githubusercontent.com/u/52322745?v=4","gravatar_id":"","url":"https://api.github.com/users/Rudolph-B","html_url":"https://github.com/Rudolph-B","followers_url":"https://api.github.com/users/Rudolph-B/followers","following_url":"https://api.github.com/users/Rudolph-B/following{/other_user}","gists_url":"https://api.github.com/users/Rudolph-B/gists{/gist_id}","starred_url":"https://api.github.com/users/Rudolph-B/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Rudolph-B/subscriptions","organizations_url":"https://api.github.com/users/Rudolph-B/orgs","repos_url":"https://api.github.com/users/Rudolph-B/repos","events_url":"https://api.github.com/users/Rudolph-B/events{/privacy}","received_events_url":"https://api.github.com/users/Rudolph-B/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-04-03T15:30:22Z","updated_at":"2025-04-03T15:37:19Z","body":"Would you say your issue is similar to #24646? or #30302","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2776192950/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2865270420","html_url":"https://github.com/godotengine/godot/issues/104966#issuecomment-2865270420","issue_url":"https://api.github.com/repos/godotengine/godot/issues/104966","id":2865270420,"node_id":"IC_kwDOAO6SJc6qyI6U","user":{"login":"timothyqiu","id":372476,"node_id":"MDQ6VXNlcjM3MjQ3Ng==","avatar_url":"https://avatars.githubusercontent.com/u/372476?v=4","gravatar_id":"","url":"https://api.github.com/users/timothyqiu","html_url":"https://github.com/timothyqiu","followers_url":"https://api.github.com/users/timothyqiu/followers","following_url":"https://api.github.com/users/timothyqiu/following{/other_user}","gists_url":"https://api.github.com/users/timothyqiu/gists{/gist_id}","starred_url":"https://api.github.com/users/timothyqiu/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/timothyqiu/subscriptions","organizations_url":"https://api.github.com/users/timothyqiu/orgs","repos_url":"https://api.github.com/users/timothyqiu/repos","events_url":"https://api.github.com/users/timothyqiu/events{/privacy}","received_events_url":"https://api.github.com/users/timothyqiu/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-05-09T06:18:41Z","updated_at":"2025-05-09T06:22:10Z","body":"You can force reimport the file:\n\n```gdscript\nEditorInterface.get_resource_filesystem().reimport_files([save_path])\n```\n\nor use `CACHE_MODE_REPLACE` to update existing instances:\n\n```gdscript\nResourceLoader.load(save_path, \"\", ResourceLoader.CACHE_MODE_REPLACE)\n```","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2865270420/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2993614682","html_url":"https://github.com/godotengine/godot/issues/104966#issuecomment-2993614682","issue_url":"https://api.github.com/repos/godotengine/godot/issues/104966","id":2993614682,"node_id":"IC_kwDOAO6SJc6ybu9a","user":{"login":"pirey0","id":38705070,"node_id":"MDQ6VXNlcjM4NzA1MDcw","avatar_url":"https://avatars.githubusercontent.com/u/38705070?v=4","gravatar_id":"","url":"https://api.github.com/users/pirey0","html_url":"https://github.com/pirey0","followers_url":"https://api.github.com/users/pirey0/followers","following_url":"https://api.github.com/users/pirey0/following{/other_user}","gists_url":"https://api.github.com/users/pirey0/gists{/gist_id}","starred_url":"https://api.github.com/users/pirey0/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/pirey0/subscriptions","organizations_url":"https://api.github.com/users/pirey0/orgs","repos_url":"https://api.github.com/users/pirey0/repos","events_url":"https://api.github.com/users/pirey0/events{/privacy}","received_events_url":"https://api.github.com/users/pirey0/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-06-21T14:39:55Z","updated_at":"2025-06-21T14:43:28Z","body":"Could reproduce in both v4.5-beta1 and v4.4.1 (So this is not a 4.5 regression)\n\n`Godot v4.5.beta1 - Windows 11 (build 26100) - Multi-window, 2 monitors - Vulkan (Mobile) - dedicated NVIDIA GeForce RTX 4060 Laptop GPU (NVIDIA; 32.0.15.7270) - 13th Gen Intel(R) Core(TM) i9-13900HX (32 threads) - 47.72 GiB memory `\n\n`Godot v4.4.1.stable - Windows 11 (build 26100) - Multi-window, 2 monitors - Vulkan (Mobile) - dedicated NVIDIA GeForce RTX 4060 Laptop GPU (NVIDIA; 32.0.15.7270) - 13th Gen Intel(R) Core(TM) i9-13900HX (32 threads)`\n\nRunning \t`ResourceLoader.load(save_path, \"\", ResourceLoader.CACHE_MODE_REPLACE)` solves the issues in both versions.\n\nI agree that this is currently intended behaviour, but we could add a SaverFlags flag to do or maybe invalidate the cache automatically after save.\n \n","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2993614682/reactions","total_count":2,"+1":2,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2994111048","html_url":"https://github.com/godotengine/godot/issues/104966#issuecomment-2994111048","issue_url":"https://api.github.com/repos/godotengine/godot/issues/104966","id":2994111048,"node_id":"IC_kwDOAO6SJc6ydoJI","user":{"login":"beicause","id":75941842,"node_id":"MDQ6VXNlcjc1OTQxODQy","avatar_url":"https://avatars.githubusercontent.com/u/75941842?v=4","gravatar_id":"","url":"https://api.github.com/users/beicause","html_url":"https://github.com/beicause","followers_url":"https://api.github.com/users/beicause/followers","following_url":"https://api.github.com/users/beicause/following{/other_user}","gists_url":"https://api.github.com/users/beicause/gists{/gist_id}","starred_url":"https://api.github.com/users/beicause/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/beicause/subscriptions","organizations_url":"https://api.github.com/users/beicause/orgs","repos_url":"https://api.github.com/users/beicause/repos","events_url":"https://api.github.com/users/beicause/events{/privacy}","received_events_url":"https://api.github.com/users/beicause/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-06-22T10:34:08Z","updated_at":"2025-06-22T10:34:08Z","body":"By the way, the editor's resource saving also has this issue. If you first create a `BoxMesh` and then save a `PlaneMesh` to the same path to overwrite it, the resource will not update anywhere, neither in the inspector nor 3D scene.\n\nAt least, the editor's own resource saving should be fixed, although this may be a known issue for a long time (https://github.com/godotengine/godot/issues/30302)","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2994111048/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_