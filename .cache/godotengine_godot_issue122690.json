false,"description":"","archived_at":null,"archived_by":null}],"state":"closed","locked":false,"assignees":[],"milestone":{"url":"https://api.github.com/repos/godotengine/godot/milestones/25","html_url":"https://github.com/godotengine/godot/milestone/25","labels_url":"https://api.github.com/repos/godotengine/godot/milestones/25/labels","id":15520464,"node_id":"MI_kwDOAO6SJc4A7NLQ","number":25,"title":"4.8","description":"","creator":{"login":"Repiteo","id":17489292,"node_id":"MDQ6VXNlcjE3NDg5Mjky","avatar_url":"https://avatars.githubusercontent.com/u/17489292?v=4","gravatar_id":"","url":"https://api.github.com/users/Repiteo","html_url":"https://github.com/Repiteo","followers_url":"https://api.github.com/users/Repiteo/followers","following_url":"https://api.github.com/users/Repiteo/following{/other_user}","gists_url":"https://api.github.com/users/Repiteo/gists{/gist_id}","starred_url":"https://api.github.com/users/Repiteo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Repiteo/subscriptions","organizations_url":"https://api.github.com/users/Repiteo/orgs","repos_url":"https://api.github.com/users/Repiteo/repos","events_url":"https://api.github.com/users/Repiteo/events{/privacy}","received_events_url":"https://api.github.com/users/Repiteo/received_events","type":"User","user_view_type":"public","site_admin":false},"open_issues":343,"closed_issues":2335,"state":"open","created_at":"2026-04-13T15:59:35Z","updated_at":"2026-10-22T06:28:22Z","due_on":null,"closed_at":null},"comments":1,"created_at":"2026-08-21T11:05:20Z","updated_at":"2026-08-21T16:33:22Z","closed_at":"2026-08-21T16:25:19Z","assignee":null,"author_association":"CONTRIBUTOR","issue_field_values":[],"type":null,"active_lock_reason":null,"draft":false,"pull_request":{"url":"https://api.github.com/repos/godotengine/godot/pulls/122690","html_url":"https://github.com/godotengine/godot/pull/122690","diff_url":"https://github.com/godotengine/godot/pull/122690.diff","patch_url":"https://github.com/godotengine/godot/pull/122690.patch","merged_at":"2026-08-21T16:25:19Z"},"body":"## What problem(s) does this PR solve?\r\n\r\nCurrently `TypedArray<T>` and `TypedDictionary<K, V>` always create a new `StringName` on their creation, this PR makes them use either a reference from the class or an empty reference. It's needed to avoid the global mutex that is being used when non-empty `StringName` is created.\r\n\r\n## Additional information\r\n\r\n`get_object_class_name_or_empty` is only used for typed containers, so this should be pretty safe. And as it is a `StringName` it can be easily turned into `String` on site if anyone needs the original behaviour.\r\n\r\nAlso previously it didn't create new `StringName` here\r\nCode in 4.5.2:\r\nhttps://github.com/godotengine/godot/blob/6ce3de25aa58466e14ef354703ba8d9791a417da/core/variant/typed_array.h#L50-L51\r\n\r\nCode in 4.6:\r\nhttps://github.com/godotengine/godot/blob/89cea143987d564363e15d207438530651d943ac/core/variant/typed_array.h#L43-L44\r\n\r\nIt's being auto created by the `StringName` ctor:\r\nhttps://github.com/godotengine/godot/blob/6ce3de25aa58466e14ef354703ba8d9791a417da/core/variant/array.h#L189","closed_by":{"login":"Repiteo","id":17489292,"node_id":"MDQ6VXNlcjE3NDg5Mjky","avatar_url":"https://avatars.githubusercontent.com/u/17489292?v=4","gravatar_id":"","url":"https://api.github.com/users/Repiteo","html_url":"https://github.com/Repiteo","followers_url":"https://api.github.com/users/Repiteo/followers","following_url":"https://api.github.com/users/Repiteo/following{/other_user}","gists_url":"https://api.github.com/users/Repiteo/gists{/gist_id}","starred_url":"https://api.github.com/users/Repiteo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Repiteo/subscriptions","organizations_url":"https://api.github.com/users/Repiteo/orgs","repos_url":"https://api.github.com/users/Repiteo/repos","events_url":"https://api.github.com/users/Repiteo/events{/privacy}","received_events_url":"https://api.github.com/users/Repiteo/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/122690/reactions","total_count":2,"+1":2,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/godotengine/godot/issues/122690/timeline","performed_via_github_app":null,"state_reason":null}