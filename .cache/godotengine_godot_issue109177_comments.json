ub.com/users/bruvzg/following{/other_user}","gists_url":"https://api.github.com/users/bruvzg/gists{/gist_id}","starred_url":"https://api.github.com/users/bruvzg/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/bruvzg/subscriptions","organizations_url":"https://api.github.com/users/bruvzg/orgs","repos_url":"https://api.github.com/users/bruvzg/repos","events_url":"https://api.github.com/users/bruvzg/events{/privacy}","received_events_url":"https://api.github.com/users/bruvzg/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-08-03T20:43:27Z","updated_at":"2025-08-03T20:43:34Z","body":"Can't fully reproduce on macOS. Headless export produce smaller ZIP (I assume no baked shaders), but both exports look the same.","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3148687040/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3201974610","html_url":"https://github.com/godotengine/godot/issues/109177#issuecomment-3201974610","issue_url":"https://api.github.com/repos/godotengine/godot/issues/109177","id":3201974610,"node_id":"IC_kwDOAO6SJc6-2kFS","user":{"login":"DarioSamo","id":538504,"node_id":"MDQ6VXNlcjUzODUwNA==","avatar_url":"https://avatars.githubusercontent.com/u/538504?v=4","gravatar_id":"","url":"https://api.github.com/users/DarioSamo","html_url":"https://github.com/DarioSamo","followers_url":"https://api.github.com/users/DarioSamo/followers","following_url":"https://api.github.com/users/DarioSamo/following{/other_user}","gists_url":"https://api.github.com/users/DarioSamo/gists{/gist_id}","starred_url":"https://api.github.com/users/DarioSamo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/DarioSamo/subscriptions","organizati