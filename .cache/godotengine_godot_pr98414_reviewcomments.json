dotengine/godot/pull/98414#discussion_r1935438731"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/98414"}},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/1935438731/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":null,"original_line":899,"side":"RIGHT","in_reply_to_id":1935412293,"author_association":"MEMBER","original_position":12,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/1935445535","pull_request_review_id":2583628431,"id":1935445535,"node_id":"PRRC_kwDOAO6SJc5zXI4f","diff_hunk":"@@ -895,6 +896,7 @@ void EditorSettings::_load_defaults(Ref<ConfigFile> p_extra_config) {\n \tEDITOR_SETTING(Variant::FLOAT, PROPERTY_HINT_RANGE, \"editors/polygon_editor/auto_bake_delay\", 1.5, \"-1.0,10.0,0.01\");\n \n \t// Animation\n+\t_initial_set(\"editors/animation/default_animation_step\", Animation::DEFAULT_STEP);","path":"editor/editor_settings.cpp","commit_id":"c2813b902c09c8e0f09fc784302d284fbfb7941a","original_commit_id":"95f2cf1ba4eb73f917f8f0a3704fcd3f96dfa68d","user":{"login":"TokageItLab","id":61938263,"node_id":"MDQ6VXNlcjYxOTM4MjYz","avatar_url":"https://avatars.githubusercontent.com/u/61938263?v=4","gravatar_id":"","url":"https://api.github.com/users/TokageItLab","html_url":"https://github.com/TokageItLab","followers_url":"https://api.github.com/users/TokageItLab/followers","following_url":"https://api.github.com/users/TokageItLab/following{/other_user}","gists_url":"https://api.github.com/users/TokageItLab/gists{/gist_id}","starred_url":"https://api.github.com/users/TokageItLab/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/TokageItLab/subscriptions","organizations_url":"https://api.github.com/users/TokageItLab/orgs","repos_url":"https://api.github.com/users/TokageItLab/repos","events_url":"https://api.github.com/users/TokageItLab/events{/privacy}","received_events_url":"https://api.github.com/users/TokageItLab/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"Does that mean that default_animation_step is always seconds? If so, that would make sense. However, I think it would be better to have a note in the documentation that says, “If you want 10 FPS to be the default, you need to set 0.1\".\r\n\r\nFor FPS compatible mode, see https://github.com/godotengine/godot/pull/99013. This is an option that internally sets whether it snaps to FPS or not.\r\n\r\nTo give a concrete example, in the case of 0.333 snaps:\r\n- If FPSCompatible mode is disabled, the key reaches 0.999 after 3 moves from 0\r\n- If FPSCompatible mode is enabled, the key reaches 1.0 after 3 moves from 0\r\n\r\nIn other words, if you want 30 FPS to be the default, you must have one of two cases: set it to 0.033 and use FPS mode, or set it to 0.033 and have FPS Compatible mode enabled in SecondMode.\r\n\r\nIf you want the 0.3 second snap to be the default, you need to set it to 0.3 and disable FPS compatible mode in Second mode.","created_at":"2025-01-30T11:23:50Z","updated_at":"2025-01-30T11:37:25Z","html_url":"https://github.com/godotengine/godot/pull/98414#discussion_r1935445535","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/98414","_links":{"self":{"href":"https://api.github.com/repos/godotengine/godot/pulls/comments/1935445535"},"html":{"href":"https://github.com/godotengine/godot/pull/98414#discussion_r1935445535"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/98414"}},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/1935445535/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":null,"original_line":899,"side":"RIGHT","in_reply_to_id":1