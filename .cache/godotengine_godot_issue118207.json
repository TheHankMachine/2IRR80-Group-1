ll,"active_lock_reason":null,"draft":false,"pull_request":{"url":"https://api.github.com/repos/godotengine/godot/pulls/118207","html_url":"https://github.com/godotengine/godot/pull/118207","diff_url":"https://github.com/godotengine/godot/pull/118207.diff","patch_url":"https://github.com/godotengine/godot/pull/118207.patch","merged_at":null},"body":"This commit tries to avoid calling `queue_redraw`, when possible, in the `RayCast2D::set_enabled` and `ShapeCast2D::set_enabled` methods so the redraw logic can be skipped.\r\n\r\nAdds a fast path if `set_enabled` was called with the existing `enabled` value, meaning it has no effect.\r\n\r\nAdds a check that only queues a redraw if collisions are being debugged because, based on what I can tell, ray casts and shape casts are only drawn when collisions are being debugged.","closed_by":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/118207/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/godotengine/godot/issues/118207/timeline","performed_via_github_app":null,"state_reason":null}