[{"id":4363008255,"node_id":"PRR_kwDOAO6SJc8AAAABBA44_w","user":{"login":"syntaxerror247","id":176927541,"node_id":"U_kgDOCouzNQ","avatar_url":"https://avatars.githubusercontent.com/u/176927541?u=25817fe797fcc7a812ba9d7f58f593f5a003abbb&v=4","gravatar_id":"","url":"https://api.github.com/users/syntaxerror247","html_url":"https://github.com/syntaxerror247","followers_url":"https://api.github.com/users/syntaxerror247/followers","following_url":"https://api.github.com/users/syntaxerror247/following{/other_user}","gists_url":"https://api.github.com/users/syntaxerror247/gists{/gist_id}","starred_url":"https://api.github.com/users/syntaxerror247/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/syntaxerror247/subscriptions","organizations_url":"https://api.github.com/users/syntaxerror247/orgs","repos_url":"https://api.github.com/users/syntaxerror247/repos","events_url":"https://api.github.com/users/syntaxerror247/events{/privacy}","received_events_url":"https://api.github.com/users/syntaxerror247/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"I have a few concerns here: \n\n1. Users can extend the build directory with custom code and files, such as notification icons, modifying gradle dependencies, and other changes. If we auto delete the build directory when exporting from a newer version, users could accidentally lose those modifications. So instead, I think we should only install the build template when it is not already present. If there is a version mismatch, we should show a dialog with two actions: Open the existing build directory, so users can review or copy their modifications if needed. And delete and reinstall the gradle template.\n\n2. We should also keep the `Install Android Build Template` menu option. When the Android export template is not present or downloaded, it currently provides an option to Install from a file.\nRemoving this dialog would remove the ability to manually install a build template.","state":"CHANGES_REQUESTED","html_url":"https://github.com/godotengine/godot/pull/119771#pullrequestreview-4363008255","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/119771","author_association":"MEMBER","_links":{"html":{"href":"https://github.com/godotengine/godot/pull/119771#pullrequestreview-4363008255"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/119771"}},"submitted_at":"2026-05-26T10:40:23Z","commit_id":"09e96543dcf05d5bb16de839e76fefc73524ead6"},{"id":4842244358,"node_id":"PRR_kwDOAO6SJc8AAAABIJ7JBg","user":{"login":"syntaxerror247","id":176927541,"node_id":"U_kgDOCouzNQ","avatar_url":"https://avatars.githubusercontent.com/u/176927541?u=25817fe797fcc7a812ba9d7f58f593f5a003abbb&v=4","gravatar_id":"","url":"https://api.github.com/users/syntaxerror247","html_url":"https://github.com/syntaxerror247","followers_url":"https://api.github.com/users/syntaxerror247/followers","following_url":"https://api.github.com/users/syntaxerror247/following{/other_user}","gists_url":"https://api.github.com/users/syntaxerror247/gists{/gist_id}","starred_url":"https://api.github.com/users/syntaxerror247/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/syntaxerror247/subscriptions","organizations_url":"https://api.github.com/users/syntaxerror247/orgs","repos_url":"https://api.github.com/users/syntaxerror247/repos","events_url":"https://api.github.com/users/syntaxerror247/events{/privacy}","received_events_url":"https://api.github.com/users/syntaxerror247/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"","state":"COMMENTED","html_url":"https://github.com/godotengine/godot/pull/119771#pullrequestreview-4842244358","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/119771","author_association":"MEMBER","_links":{"html":{"href":"https://github.com/godotengine/godot/pull/119771#pullrequestreview-4842244358"},"pull_request":{"href":"https:/