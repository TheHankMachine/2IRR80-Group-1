ps://api.github.com/repos/godotengine/godot/labels/topic:gui","name":"topic:gui","color":"ffee88","default":false,"description":"","archived_at":null,"archived_by":null}],"state":"closed","locked":false,"assignees":[],"milestone":{"url":"https://api.github.com/repos/godotengine/godot/milestones/24","html_url":"https://github.com/godotengine/godot/milestone/24","labels_url":"https://api.github.com/repos/godotengine/godot/milestones/24/labels","id":14236899,"node_id":"MI_kwDOAO6SJc4A2Tzj","number":24,"title":"4.7","description":"","creator":{"login":"akien-mga","id":4701338,"node_id":"MDQ6VXNlcjQ3MDEzMzg=","avatar_url":"https://avatars.githubusercontent.com/u/4701338?v=4","gravatar_id":"","url":"https://api.github.com/users/akien-mga","html_url":"https://github.com/akien-mga","followers_url":"https://api.github.com/users/akien-mga/followers","following_url":"https://api.github.com/users/akien-mga/following{/other_user}","gists_url":"https://api.github.com/users/akien-mga/gists{/gist_id}","starred_url":"https://api.github.com/users/akien-mga/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/akien-mga/subscriptions","organizations_url":"https://api.github.com/users/akien-mga/orgs","repos_url":"https://api.github.com/users/akien-mga/repos","events_url":"https://api.github.com/users/akien-mga/events{/privacy}","received_events_url":"https://api.github.com/users/akien-mga/received_events","type":"User","user_view_type":"public","site_admin":false},"open_issues":3,"closed_issues":2535,"state":"closed","created_at":"2025-11-27T20:29:18Z","updated_at":"2026-10-20T18:39:31Z","due_on":null,"closed_at":"2026-06-19T16:54:35Z"},"comments":6,"created_at":"2026-05-07T15:18:59Z","updated_at":"2026-05-13T16:13:05Z","closed_at":"2026-05-13T14:58:24Z","assignee":null,"author_association":"CONTRIBUTOR","issue_field_values":[],"type":null,"active_lock_reason":null,"draft":false,"pull_request":{"url":"https://api.github.com/repos/godotengine/godot/pulls/119312","html_url":"https://github.com/godotengine/godot/pull/119312","diff_url":"https://github.com/godotengine/godot/pull/119312.diff","patch_url":"https://github.com/godotengine/godot/pull/119312.patch","merged_at":"2026-05-13T14:58:24Z"},"body":"Fixes #119050.\r\nFixes #119311.\r\n\r\nThis does a number of things to try to fix accessibility for `PopupMenu` (and `EditorResourcePicker` as a result):\r\n\r\n1. Removes the hiding of search bar focus when the `PopupMenu` is first opened.\r\n1. Fixes the sizing and positioning of the accessibility region (mostly through trial-and-error).\r\n1. Excludes hidden items from being included in the total item count.\r\n1. Sets `AccessibilityFlags::FLAG_HIDDEN` based on the value of `Item::visible`.\r\n1. Allows `ui_up`/`ui_down` to release focus from the search bar, allowing narration of the menu items when the search bar is enabled.\r\n1. Removed `PopupMenu::_search_bar_input`, since it's not needed if we're releasing focus from the search bar on `ui_up`/`ui_down`.\r\n1. Added `PopupMenu::_search_bar_focus_entered` to deselect any selected item when the search bar gains focus again.\r\n\r\nRemaining issues:\r\n\r\n1. ~~Positioning of accessibility region is still borked for submenus.~~\r\n    - Dealt with in #119328.\r\n1. Scaling a parent `Node2D` still results in borked sizing/positioning of the accessibility region.\r\n1. ~~`ui_focus_next`/`ui_focus_prev` does nothing when search bar is focused.~~\r\n    - Dealt with by enabling `FOCUS_ALL` on `control` and changing it to be a new `PopupMenuItems` class that forward `get_focused_accessibility_element` to `PopupMenu`.\r\n\r\n---\r\n_Disclaimer: AI tooling was used to help triage parts of this, as well as make some minor edits, as part of #118571. Any code not physically typed out by myself has been carefully reviewed to the best of my ability._","closed_by":{"login":"Repiteo","id":17489292,"node_id":"MDQ6VXNlcjE3NDg5Mjky","avatar_url":"https://avatars.githubusercontent.com/u/17489292?v=4","gravatar_id":"","url":"https://api.github.com/users/Repiteo","html_url":"https://github.com/Repiteo","followers_url":"https://api.github.com/users/Repiteo/followers","following_url":"https://api.github.com/users/Repiteo/following{/other_user}","gists_url":"https://api.github.com/users/Repiteo/gists{/gist_id}","starred_url":"https://api.github.com/users/Repiteo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Repiteo/subscriptions","organizations_url":"https://api.github.com/users/Repiteo/orgs","repos_url":"https://api.github.com/users/Repiteo/repos","events_url":"https://api.github.com/users/Repiteo/events{/privacy}","received_events_url":"https://api.github.com/users/Repiteo/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/119312/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/godotengine/godot/issues/119312/timeline","performed_via_github_app":null,"state_reason":null}