:"ffee88","default":false,"description":"","archived_at":null,"archived_by":null},{"id":2666708289,"node_id":"MDU6TGFiZWwyNjY2NzA4Mjg5","url":"https://api.github.com/repos/godotengine/godot/labels/topic:3d","name":"topic:3d","color":"ffee88","default":false,"description":"","archived_at":null,"archived_by":null}],"state":"open","locked":false,"assignees":[],"milestone":{"url":"https://api.github.com/repos/godotengine/godot/milestones/16","html_url":"https://github.com/godotengine/godot/milestone/16","labels_url":"https://api.github.com/repos/godotengine/godot/milestones/16/labels","id":8237783,"node_id":"MI_kwDOAO6SJc4AfbLX","number":16,"title":"4.x","description":"Issues and pull requests slated for an undetermined Godot 4 release.","creator":{"login":"akien-mga","id":4701338,"node_id":"MDQ6VXNlcjQ3MDEzMzg=","avatar_url":"https://avatars.githubusercontent.com/u/4701338?v=4","gravatar_id":"","url":"https://api.github.com/users/akien-mga","html_url":"https://github.com/akien-mga","followers_url":"https://api.github.com/users/akien-mga/followers","following_url":"https://api.github.com/users/akien-mga/following{/other_user}","gists_url":"https://api.github.com/users/akien-mga/gists{/gist_id}","starred_url":"https://api.github.com/users/akien-mga/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/akien-mga/subscriptions","organizations_url":"https://api.github.com/users/akien-mga/orgs","repos_url":"https://api.github.com/users/akien-mga/repos","events_url":"https://api.github.com/users/akien-mga/events{/privacy}","received_events_url":"https://api.github.com/users/akien-mga/received_events","type":"User","user_view_type":"public","site_admin":false},"open_issues":5791,"closed_issues":0,"state":"open","created_at":"2022-07-26T12:42:05Z","updated_at":"2026-10-21T22:40:26Z","due_on":null,"closed_at":null},"comments":0,"created_at":"2026-01-20T15:34:31Z","updated_at":"2026-02-17T20:09:50Z","closed_at":null,"assignee":null,"author_association":"CONTRIBUTOR","issue_field_values":[],"type":null,"active_lock_reason":null,"draft":false,"pull_request":{"url":"https://api.github.com/repos/godotengine/godot/pulls/115178","html_url":"https://github.com/godotengine/godot/pull/115178","diff_url":"https://github.com/godotengine/godot/pull/115178.diff","patch_url":"https://github.com/godotengine/godot/pull/115178.patch","merged_at":null},"body":"As of upstream, baked AO map follow the same sampling filtering of all other textures in a StandardMaterial. This is not always the best option since, for stylized games, one could want to use nearest neighbour filtering for albedo texture but still rely on linear filtered baked AO map for a more realistic look.\r\n\r\nThis commit adds a new option in the editor to specify the sampling filter to use specifically for AO map.\r\nWith this new option, developers can setup combination of different filtering between albedo and AO map to fit their vision (Nearest + Nearest for a full Retro look, Nearest + Linear for a stylized 3D pixel art with realistic lighting and Linear + Linear for a full realistic scenario)\r\n\r\nAttaching two screenshots showing the new option in place:\r\n<img width=\"2560\" height=\"1440\" alt=\"nearest\" src=\"https://github.com/user-attachments/assets/c2e66476-3f6d-40cb-9550-5d612f50856f\" />\r\n\r\n<img width=\"2560\" height=\"1440\" alt=\"linear\" src=\"https://github.com/user-attachments/assets/df0f96ac-678c-41c8-a0be-aa3109f6b285\" />\r\n","closed_by":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/115178/reactions","total_count":6,"+1":2,"-1":0,"laugh":0,"hooray":3,"confused":0,"heart":0,"rocket":0,"eyes":1},"timeline_url":"https://api.github.com/repos/godotengine/godot/issues/115178/timeline","performed_via_github_app":null,"state_reason":null}