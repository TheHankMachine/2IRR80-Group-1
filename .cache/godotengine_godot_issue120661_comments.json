4?v=4","gravatar_id":"","url":"https://api.github.com/users/matheusmdx","html_url":"https://github.com/matheusmdx","followers_url":"https://api.github.com/users/matheusmdx/followers","following_url":"https://api.github.com/users/matheusmdx/following{/other_user}","gists_url":"https://api.github.com/users/matheusmdx/gists{/gist_id}","starred_url":"https://api.github.com/users/matheusmdx/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/matheusmdx/subscriptions","organizations_url":"https://api.github.com/users/matheusmdx/orgs","repos_url":"https://api.github.com/users/matheusmdx/repos","events_url":"https://api.github.com/users/matheusmdx/events{/privacy}","received_events_url":"https://api.github.com/users/matheusmdx/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-07-01T18:36:30Z","updated_at":"2026-07-01T18:36:30Z","body":"Reverting PR #118824 fixes the issue. CC @hpvb","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4858978236/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4881119829","html_url":"https://github.com/godotengine/godot/issues/120661#issuecomment-4881119829","issue_url":"https://api.github.com/repos/godotengine/godot/issues/120661","id":4881119829,"node_id":"IC_kwDOAO6SJc8AAAABIu_6VQ","user":{"login":"Nichgon","id":10327349,"node_id":"MDQ6VXNlcjEwMzI3MzQ5","avatar_url":"https://avatars.githubusercontent.com/u/10327349?v=4","gravatar_id":"","url":"https://api.github.com/users/Nichgon","html_url":"https://github.com/Nichgon","followers_url":"https://api.github.com/users/Nichgon/followers","following_url":"https://api.github.com/users/Nichgon/following{/other_user}","gists_url":"https://api.github.com/users/Nichgon/gists{/gist_id}","starred_url":"https://api.github.com/users/Nichgon/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Nichgon/subscriptions","organizations_url":"https://api.github.com/users/Nichgon/orgs","repos_url":"https://api.github.com/users/Nichgon/repos","events_url":"https://api.github.com/users/Nichgon/events{/privacy}","received_events_url":"https://api.github.com/users/Nichgon/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-07-04T07:21:21Z","updated_at":"2026-07-04T07:22:32Z","body":"In my Godot 4.7 project, I am using `ResourceLoader.load_threaded_request` but with default `use_sub_threads` (false) and it showed same 'Leaked instance: RefCounted'. In 4.6, it worked fine.","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4881119829/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4883091712","html_url":"https://github.com/godotengine/godot/issues/120661#issuecomment-4883091712","issue_url":"https://api.github.com/repos/godotengine/godot/issues/120661","id":4883091712,"node_id":"IC_kwDOAO6SJc8AAAABIw4RAA","user":{"login":"DeltachangeOG","id":66188483,"node_id":"MDQ6VXNlcjY2MTg4NDgz","avatar_url":"https://avatars.githubusercontent.com/u/66188483?v=4","gravatar_id":"","url":"https://api.github.com/users/DeltachangeOG","html_url":"https://github.com/DeltachangeOG","followers_url":"https://api.github.com/users/DeltachangeOG/followers","following_url":"https://api.github.com/users/DeltachangeOG/following{/other_user}","gists_url":"https://api.github.com/users/DeltachangeOG/gists{/gist_id}","starred_url":"https://api.github.com/users/DeltachangeOG/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/DeltachangeOG/subscriptions","organizations_url":"https://api.github.com/users/DeltachangeOG/orgs","repos_url":"https://api.github.com/users/DeltachangeOG/repos","events_url":"https://api.github.com/users/DeltachangeOG/events{/privacy}","received_events_url":"https://api.github.com/users/DeltachangeOG/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-07-04T16:40:37Z","updated_at":"2026-07-04T16:41:03Z","body":"p_use_sub_threads=true exposes a path where _run_load_task() gets an extra LoadToken ref, but some cleaning_tasks have early exits that don't handle the unreference(). I am testing currently for reproduction and fixing.","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4883091712/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4891381746","html_url":"https://github.com/godotengine/godot/issues/120661#issuecomment-4891381746","issue_url":"https://api.github.com/repos/godotengine/godot/issues/120661","id":4891381746,"node_id":"IC_kwDOAO6SJc8AAAABI4yP8g","user":{"login":"DeltachangeOG","id":66188483,"node_id":"MDQ6VXNlcjY2MTg4NDgz","avatar_url":"https://avatars.githubusercontent.com/u/66188483?v=4","gravatar_id":"","url":"https://api.github.com/users/DeltachangeOG","html_url":"https://github.com/DeltachangeOG","followers_url":"https://api.github.com/users/DeltachangeOG/followers","following_url":"https://api.github.com/users/DeltachangeOG/following{/other_user}","gists_url":"https://api.github.com/users/DeltachangeOG/gists{/gist_id}","starred_url":"https://api.github.com/users/DeltachangeOG/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/DeltachangeOG/subscriptions","organizations_url":"https://api.github.com/users/DeltachangeOG/orgs","repos_url":"https://api.github.com/users/DeltachangeOG/repos","events_url":"https://api.github.com/users/DeltachangeOG/events{/privacy}","received_events_url":"https://api.github.com/users/DeltachangeOG/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-07-06T09:47:59Z","updated_at":"2026-07-06T09:47:59Z","body":"To follow up, confirmed with logging _run_load_task can be the final handler but it ignores unreference() == true leaving 0 counted LoadToken objects allocated.","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4891381746/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5966557999","html_url":"https://github.com/godotengine/godot/issues/120661#issuecomment-5966557999","issue_url":"https://api.github.com/repos/godotengine/godot/issues/120661","id":5966557999,"node_id":"IC_kwDOAO6SJc8AAAABY6JzLw","user":{"login":"reatang","id":8022923,"node_id":"MDQ6VXNlcjgwMjI5MjM=","avatar_url":"https://avatars.githubusercontent.com/u/8022923?v=4","gravatar_id":"","url":"https://api.github.com/users/reatang","html_url":"https://github.com/reatang","followers_url":"https://api.github.com/users/reatang/followers","following_url":"https://api.github.com/users/reatang/following{/other_user}","gists_url":"https://api.github.com/users/reatang/gists{/gist_id}","starred_url":"https://api.github.com/users/reatang/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/reatang/subscriptions","organizations_url":"https://api.github.com/users/reatang/orgs","repos_url":"https://api.github.com/users/reatang/repos","events_url":"https://api.github.com/users/reatang/events{/privacy}","received_events_url":"https://api.github.com/users/reatang/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-10-03T06:58:35Z","updated_at":"2026-10-03T06:58:35Z","body":"Confirming on **4.7.2-stable** from pure GDScript, with the default `use_sub_threads = false`. `load_threaded_get()` is called normally for every request.\n\n**Deterministic repro:** background-load a scene whose root script `preload()`s N resources that aren't cached yet. Exactly N `LoadToken`s leak, each showing up as `Leaked instance: RefCounted:<id> - Reference count: 0`. In my case, N = 16 gave +16 objects compared with a plain `ResourceLoader.load()` on the main thread, every run. In a real project with several scenes, that comes to 27–38 leaked instances per scene change.\n\n**What seems to happen:** the scene is loaded inside a WorkerThreadPool task. When the script compiles, each `preload()` calls `ResourceLoader::load()` from inside that pool task. That gives `LOAD_THREAD_SPAWN_SINGLE`, so a new pool task is queued. Then `_load_complete_inner()` takes the `loader_is_wtp` branch, takes an extra ref and runs `_run_load_task()` inline. Once the caller drops its `Ref`, the only remaining ref belongs to the queued task. When that task runs later, it sees `started_load` on another thread, goes into the wait branch, and calls `load_task.load_token->unreference()`. The count hits 0, but the return value is ignored, so nothing deletes the token. This matches what @DeltachangeOG found, and #121025 should cover it.\n\n**Workaround until that lands:** load from a plain `Thread` with `ResourceLoader.load(path)` and poll `is_alive()` from the main thread. The caller isn't a pool task, so nested loads use `LOAD_THREAD_FROM_CURRENT` and run inline without spawning tasks. With this I get no leaks.\n","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5966557999/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/6191742947","html_url":"https://github.com/godotengine/godot/issues/120661#issuecomment-6191742947","issue_url":"https://api.github.com/repos/godotengine/godot/issues/120661","id":6191742947,"node_id":"IC_kwDOAO6SJc8AAAABcQ5_4w","user":{"login":"arkennexel","id":315220865,"node_id":"U_kgDOEsnjgQ","avatar_url":"https://avatars.githubusercontent.com/u/315220865?v=4","gravatar_id":"","url":"https://api.github.com/users/arkennexel","html_url":"https://github.com/arkennexel","followers_url":"https://api.github.com/users/arkennexel/followers","following_url":"https://api.github.com/users/arkennexel/following{/other_user}","gists_url":"https://api.github.com/users/arkennexel/gists{/gist_id}","starred_url":"https://api.github.com/users/arkennexel/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/arkennexel/subscriptions","organizations_url":"https://api.github.com/users/arkennexel/orgs","repos_url":"https://api.github.com/users/arkennexel/repos","events_url":"https://api.github.com/users/arkennexel/events{/privacy}","received_events_url":"https://api.github.com/users/arkennexel/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-10-15T12:11:49Z","updated_at":"2026-10-15T12:11:49Z","body":"Additional data point: this also reproduces on **4.6.2-stable** from pure GDScript, with `use_sub_threads = false` and every request claimed by `load_threaded_get()`. 4.6.2 does not contain #118824 (there is no `started_load` in `resource_loader.cpp`). That suggests the unchecked `unreference()` at the end of `_run_load_task()` could already leak before that regression, and #118824 made it easier to hit.\n\n### Tested versions\n\n- Reproducible: v4.6.2.stable.official [001aa128b]\n- Not tested: 4.6.3, 4.7.x, master\n\n### System information\n\nWindows 11 (build 26200), `--headless`\n\n### Trigger\n\nPoll `load_threaded_get_status()` and call `load_threaded_get()` as soon as it reports `THREAD_LOAD_LOADED`. The worker publishes `LOADED` and unlocks `thread_load_mutex` before it reaches the final `load_task.load_token->unreference()` (4.6.2 `core/io/resource_loader.cpp:488`). If the main thread claims the token in that window, it drops the user reference first (`load_threaded_get` → `unreference()` returns false). The worker's final `unreference()` then reaches 0, but the return value is ignored, so the token is never deleted.\n\n### MRP results (100 iterations per run, `CACHE_MODE_IGNORE` so every iteration uses a worker)\n\n| claim timing | leaked `RefCounted` (ref 0) | leaked `Resource` | runs |\n|---|---|---|---|\n| immediately after `LOADED` | 100 / 100 | 99 | 2 |\n| 3 frames after `LOADED` | 1 / 1 | 0 | 2 |\n\nThe leaked `Resource` instances are held by the stale `thread_load_tasks` entries of the leaked tokens.\n\nTo confirm the call site, I built 4.6.2 with logging added only where `unreference()` returns true at the two unchecked sites (`_run_load_task` end and `clear_thread_load_tasks`), with no behavior change. With immediate claim, 99 `site=run_load_task` events matched the 99 leaked IDs. In a separate run where a request was never claimed, the leaked ID matched the `clear_thread_load_tasks` site. That second case is the #102476 situation. Both sites are the ones changed in #121025.\n\n### MRP\n\nSingle file; run it with an empty `project.godot` (`config_version=5`).\n\n```gdscript\nextends SceneTree\n# godot --headless --verbose --path . -s res://mrp.gd -- --delay-frames=0   -> leaks\n# godot --headless --verbose --path . -s res://mrp.gd -- --delay-frames=3   -> (almost) no leaks\n\nconst PATH := \"user://loadtoken_mrp_data.tres\"\nconst ITERATIONS := 100\n\nfunc _initialize() -> void:\n\t_run.call_deferred()\n\nfunc _run() -> void:\n\tvar delay_frames := 0\n\tfor arg in OS.get_cmdline_user_args():\n\t\tif arg.begins_with(\"--delay-frames=\"):\n\t\t\tdelay_frames = int(arg.get_slice(\"=\", 1))\n\n\tvar data := Resource.new()\n\tvar payload := PackedInt32Array()\n\tpayload.resize(20000)\n\tfor i in payload.size():\n\t\tpayload[i] = i\n\tdata.set_meta(\"payload\", payload)\n\tResourceSaver.save(data, PATH)\n\n\tfor i in ITERATIONS:\n\t\tResourceLoader.load_threaded_request(PATH, \"\", false, ResourceLoader.CACHE_MODE_IGNORE)\n\t\twhile ResourceLoader.load_threaded_get_status(PATH) == ResourceLoader.THREAD_LOAD_IN_PROGRESS:\n\t\t\tpass\n\t\tfor f in delay_frames:\n\t\t\tawait process_frame\n\t\tResourceLoader.load_threaded_get(PATH)\n\n\tfor f in 5:\n\t\tawait process_frame\n\tquit()\n```\n\nIn a real project, this shows up as an occasional single `Leaked instance: RefCounted:<id> - Reference count: 0` at exit. It came from polling once per frame for BGM streams, roughly 0–1 per run. It has no gameplay impact, but it makes strict leak-checking test runs flaky. Delaying the claim reduces it but doesn't eliminate it, so a fix along the lines of #121025 would be welcome, ideally with a 4.6 backport.\n","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/6191742947/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null}]