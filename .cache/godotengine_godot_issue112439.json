 not correctly resolved.\r\n\r\nDepth resolve is a long standing issue. https://github.com/godotengine/godot/pull/78598 implements depth resolve for vulkan. This PR implements depth resolve for metal.\r\n\r\nNOTE: Dependency on https://github.com/godotengine/godot/pull/109975 can be detached if someone can provide a better use case to test MSAA depth resolve on metal.","closed_by":{"login":"huisedenanhai","id":22026948,"node_id":"MDQ6VXNlcjIyMDI2OTQ4","avatar_url":"https://avatars.githubusercontent.com/u/22026948?v=4","gravatar_id":"","url":"https://api.github.com/users/huisedenanhai","html_url":"https://github.com/huisedenanhai","followers_url":"https://api.github.com/users/huisedenanhai/followers","following_url":"https://api.github.com/users/huisedenanhai/following{/other_user}","gists_url":"https://api.github.com/users/huisedenanhai/gists{/gist_id}","starred_url":"https://api.github.com/users/huisedenanhai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/huisedenanhai/subscriptions","organizations_url":"https://api.github.com/users/huisedenanhai/orgs","repos_url":"https://api.github.com/users/huisedenanhai/repos","events_url":"https://api.github.com/users/huisedenanhai/events{/privacy}","received_events_url":"https://api.github.com/users/huisedenanhai/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/112439/reactions","total_count":1,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":1},"timeline_url":"https://api.github.com/repos/godotengine/godot/issues/112439/timeline","performed_via_github_app":null,"state_reason":null}