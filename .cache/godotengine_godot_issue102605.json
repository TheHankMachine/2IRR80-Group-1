e_id":"MDU6TGFiZWwyNzkwOTgyMTk=","url":"https://api.github.com/repos/godotengine/godot/labels/topic:editor","name":"topic:editor","color":"ffee88","default":false,"description":"","archived_at":null,"archived_by":null},{"id":391232995,"node_id":"MDU6TGFiZWwzOTEyMzI5OTU=","url":"https://api.github.com/repos/godotengine/godot/labels/topic:assetlib","name":"topic:assetlib","color":"ffee88","default":false,"description":"","archived_at":null,"archived_by":null}],"state":"closed","locked":false,"assignees":[],"milestone":null,"comments":4,"created_at":"2025-02-08T23:46:17Z","updated_at":"2026-02-07T12:34:52Z","closed_at":"2026-01-05T18:53:50Z","assignee":null,"author_association":"CONTRIBUTOR","issue_field_values":[],"type":null,"active_lock_reason":null,"draft":false,"pull_request":{"url":"https://api.github.com/repos/godotengine/godot/pulls/102605","html_url":"https://github.com/godotengine/godot/pull/102605","diff_url":"https://github.com/godotengine/godot/pull/102605.diff","patch_url":"https://github.com/godotengine/godot/pull/102605.patch","merged_at":null},"body":"<!--\r\nPlease target the `master` branch in priority.\r\n\r\nRelevant fixes are cherry-picked for stable branches as needed by maintainers.\r\n\r\nTo speed up the contribution process and avoid CI errors, please set up pre-commit hooks locally:\r\nhttps://docs.godotengine.org/en/latest/contributing/development/code_style_guidelines.html\r\n-->\r\n(I messed up the git in another PR so I had to delete it)\r\n\r\nThis implements \"favorite assets\", based on https://github.com/godotengine/godot-proposals/issues/3521 and https://github.com/godotengine/godot-proposals/issues/11080.\r\n\r\nWhat this does:\r\n- Adds a Star button to the right of AssetLibraryItems, toggling the Asset's favorite status.\r\n- Adds a `Favorites...` button next to the search bar, opening a popup with the list of favorited assets.\r\n- Stores \"favorites\" data in an editor setting `asset_library/favorites`, which is a Dictionary.\r\n  - Keys are the asset_id as an int. Values are a Dictionary, caching the minimum info needed to spawn an AssetLibraryItem in the favorites list.\r\n- Syncs the favorite status for the star toggle by listening to and emitting `settings_changed` in EditorSettings.\r\n- Shows template_only assets only from the project manager, and the others only from the editor.\r\n\r\nImages:\r\n![image](https://github.com/user-attachments/assets/95c0603a-7e0f-4857-9fa3-17c9bf9d0b2c)\r\n![image](https://github.com/user-attachments/assets/1012c04b-5693-4b0d-a4d4-06ecb7a4aaf6)\r\n![image](https://github.com/user-attachments/assets/81e52894-f3c3-420f-8e1b-f391b9f24562)\r\n\r\n- *Production edit: This closes https://github.com/godotengine/godot-proposals/issues/3521.*","closed_by":{"login":"dugramen","id":54819319,"node_id":"MDQ6VXNlcjU0ODE5MzE5","avatar_url":"https://avatars.githubusercontent.com/u/54819319?v=4","gravatar_id":"","url":"https://api.github.com/users/dugramen","html_url":"https://github.com/dugramen","followers_url":"https://api.github.com/users/dugramen/followers","following_url":"https://api.github.com/users/dugramen/following{/other_user}","gists_url":"https://api.github.com/users/dugramen/gists{/gist_id}","starred_url":"https://api.github.com/users/dugramen/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/dugramen/subscriptions","organizations_url":"https://api.github.com/users/dugramen/orgs","repos_url":"https://api.github.com/users/dugramen/repos","events_url":"https://api.github.com/users/dugramen/events{/privacy}","received_events_url":"https://api.github.com/users/dugramen/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/102605/reactions","total_count":13,"+1":8,"-1":0,"laugh":0,"hooray":5,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/godotengine/godot/issues/102605/timeline","performed_via_gith