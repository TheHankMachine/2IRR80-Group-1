rendered with a multimesh.\r\n\r\nShould be a net-gain for all projects but projects with a lot of agents and longer path stability (aka not querying a new path every frame like a madman) will see the biggest performance boost by this change.\r\n\r\nSince line width is not supported by mesh line primitives (and never worked great to begin with on a lot of hardware) the option is deprecated and hidden from the inspector.\r\n\r\n<!--\r\nPlease target the `master` branch in priority.\r\n\r\nRelevant fixes are cherry-picked for stable branches as needed by maintainers.\r\n\r\nTo speed up the contribution process and avoid CI errors, please set up pre-commit hooks locally:\r\nhttps://docs.godotengine.org/en/latest/contributing/development/code_style_guidelines.html\r\n-->\r\n","closed_by":{"login":"smix8","id":52464204,"node_id":"MDQ6VXNlcjUyNDY0MjA0","avatar_url":"https://avatars.githubusercontent.com/u/52464204?v=4","gravatar_id":"","url":"https://api.github.com/users/smix8","html_url":"https://github.com/smix8","followers_url":"https://api.github.com/users/smix8/followers","following_url":"https://api.github.com/users/smix8/following{/other_user}","gists_url":"https://api.github.com/users/smix8/gists{/gist_id}","starred_url":"https://api.github.com/users/smix8/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/smix8/subscriptions","organizations_url":"https://api.github.com/users/smix8/orgs","repos_url":"https://api.github.com/users/smix8/repos","events_url":"https://api.github.com/users/smix8/events{/privacy}","received_events_url":"https://api.github.com/users/smix8/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/107290/reactions","total_count":4,"+1":3,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":1,"eyes":0},"timeline_url":"https://api.github.com/repos/godotengine/godot/issues/107290/timeline","performed_via_github_app":null,"