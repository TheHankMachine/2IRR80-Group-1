endlyGeek42/gists{/gist_id}","starred_url":"https://api.github.com/users/BigFriendlyGeek42/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/BigFriendlyGeek42/subscriptions","organizations_url":"https://api.github.com/users/BigFriendlyGeek42/orgs","repos_url":"https://api.github.com/users/BigFriendlyGeek42/repos","events_url":"https://api.github.com/users/BigFriendlyGeek42/events{/privacy}","received_events_url":"https://api.github.com/users/BigFriendlyGeek42/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-09-25T16:40:22Z","updated_at":"2026-09-25T16:40:22Z","body":"OK, I confirm that I could not see any other changes because the scale I used was too small","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5835969103/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5837731224","html_url":"https://github.com/godotengine/godot/issues/123829#issuecomment-5837731224","issue_url":"https://api.github.com/repos/godotengine/godot/issues/123829","id":5837731224,"node_id":"IC_kwDOAO6SJc8AAAABW_S1mA","user":{"login":"billuo","id":43804776,"node_id":"MDQ6VXNlcjQzODA0Nzc2","avatar_url":"https://avatars.githubusercontent.com/u/43804776?v=4","gravatar_id":"","url":"https://api.github.com/users/billuo","html_url":"https://github.com/billuo","followers_url":"https://api.github.com/users/billuo/followers","following_url":"https://api.github.com/users/billuo/following{/other_user}","gists_url":"https://api.github.com/users/billuo/gists{/gist_id}","starred_url":"https://api.github.com/users/billuo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/billuo/subscriptions","organizations_url":"https://api.github.com/users/billuo/orgs","repos_url":"https://api.github.com/users/billuo/repos","events_url":"https://api.github.com/users/billuo/events{/privacy}","received_events_url":"https://api.github.com/users/billuo/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-09-25T18:44:25Z","updated_at":"2026-09-25T18:44:25Z","body":"The problem turns out to be two separate cases:\n\n1. Missing theme items definition in the editor theme. This mostly affects the Modern theme, which defines fewer items than Classic. Without explicit definition, it falls back to using the default theme, which has `gui/theme/default_theme_scale` baked in. This happens for the version underline and the \"icon spacing\".\n  \n    Suggestion: Define the missing items in the editor themes: `TabContainer.icon_separation`, `TabBar.tab_separation`, `LinkButton.underline_spacing`, etc.\n\n2. Editor code measuring controls before they enter the tree. A `Control` that isn't inside the tree has no theme context, so it always uses the default theme -- the scaled one -- and then the result gets cached in `custom_minimum_size`, forever. This happens for both the editor scene tabs and the output filter buttons.\n\n    Suggestion: Resolve those sizes in `NOTIFICATION_POST_ENTER_TREE` instead, as well as `NOTIFICATION_THEME_CHANGED` for later theme changes.","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5837731224/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null}]