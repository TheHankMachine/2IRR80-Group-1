[{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2572262615","html_url":"https://github.com/godotengine/godot/issues/101164#issuecomment-2572262615","issue_url":"https://api.github.com/repos/godotengine/godot/issues/101164","id":2572262615,"node_id":"IC_kwDOAO6SJc6ZUZzX","user":{"login":"Rindbee","id":30386067,"node_id":"MDQ6VXNlcjMwMzg2MDY3","avatar_url":"https://avatars.githubusercontent.com/u/30386067?v=4","gravatar_id":"","url":"https://api.github.com/users/Rindbee","html_url":"https://github.com/Rindbee","followers_url":"https://api.github.com/users/Rindbee/followers","following_url":"https://api.github.com/users/Rindbee/following{/other_user}","gists_url":"https://api.github.com/users/Rindbee/gists{/gist_id}","starred_url":"https://api.github.com/users/Rindbee/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Rindbee/subscriptions","organizations_url":"https://api.github.com/users/Rindbee/orgs","repos_url":"https://api.github.com/users/Rindbee/repos","events_url":"https://api.github.com/users/Rindbee/events{/privacy}","received_events_url":"https://api.github.com/users/Rindbee/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-01-06T04:39:54Z","updated_at":"2025-01-06T04:39:54Z","body":"This is caused by adding child nodes in the Inspector without removing the old child nodes first. This causes the height to temporarily increase and then the `ItemList` to lose its scroll position.\n\nWhen the child nodes are removed, the height is restored, but the scroll position is lost.\n\nYou can use `remove_child()` to remove these child nodes first to prevent them from interfering with the height.","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2572262615/reactions","total_count":2,"+1":2,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimize