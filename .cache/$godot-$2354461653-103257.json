ugramen","type":"User","owned_private_repos":0,"public_gists":0,"public_repos":0,"total_private_repos":0,"url":"https://api.github.com/users/dugramen"},"body":"","html_url":"https://github.com/godotengine/godot/pull/103257#pullrequestreview-3391084186","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/103257","author_association":"CONTRIBUTOR","submitted_at":"2025-10-28T22:37:36Z"},{"id":3391139898,"node_id":"PRR_kwDOAO6SJc7KILA6","state":"COMMENTED","user":{"site_admin":false,"suspended":false,"updated_at":"0001-01-01T00:00:00Z","avatar_url":"https://avatars.githubusercontent.com/u/2223172?u=fc85633b469acb6e7baef4dba5171f19a2a4ff85&v=4","created_at":"0001-01-01T00:00:00Z","followers":0,"following":0,"html_url":"https://github.com/KoBeWi","id":2223172,"node_id":"MDQ6VXNlcjIyMjMxNzI=","login":"KoBeWi","type":"User","owned_private_repos":0,"public_gists":0,"public_repos":0,"total_private_repos":0,"url":"https://api.github.com/users/KoBeWi"},"body":"","html_url":"https://github.com/godotengine/godot/pull/103257#pullrequestreview-3391139898","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/103257","author_association":"MEMBER","submitted_at":"2025-10-28T23:06:05Z"},{"id":3392952657,"node_id":"PRR_kwDOAO6SJc7KPFlR","state":"APPROVED","user":{"site_admin":false,"suspended":false,"updated_at":"0001-01-01T00:00:00Z","avatar_url":"https://avatars.githubusercontent.com/u/4701338?u=4a42fd867f2c449fcc23adf635dd574dae98e6c2&v=4","created_at":"0001-01-01T00:00:00Z","followers":0,"following":0,"html_url":"https://github.com/akien-mga","id":4701338,"node_id":"MDQ6VXNlcjQ3MDEzMzg=","login":"akien-mga","type":"User","owned_private_repos":0,"public_gists":0,"public_repos":0,"total_private_repos":0,"url":"https://api.github.com/users/akien-mga"},"body":"Code changes look fine to me, and overall the usability improvement is massive so this is great.\r\n\r\nRegarding the recent discussion on the position of the Delete button, given the lack of consensus I would have kept it on the right side for now (consistent with other UIs and how it was until now) to evaluate further in another PR. Because with it on the left side, I foresee some potential pushback from some users on this PR because they don't like the new icon placement. (I personally agree with Yuri's remark that the delete icon next to the resource selector is a problem, but it's a pre-existing issue that's orthogonal to what this PR was meant for, and I'm not convinced by the solution so far.)\r\n\r\nBut we can try it as is and adjust later in follow-ups. If the feedback is that people love the gain of usable space but dislike the icon, we can deal with that specifically.","html_url":"https://github.com/godotengine/godot/pull/103257#pullrequestreview-3392952657","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/103257","author_association":"MEMBER","submitted_at":"2025-10-29T11:57:27Z"},{"id":3393688298,"node_id":"PRR_kwDOAO6SJc7KR5Lq","state":"APPROVED","user":{"site_admin":false,"suspended":false,"updated_at":"0001-01-01T00:00:00Z","avatar_url":"https://avatars.githubusercontent.com/u/66184050?u=48fa4d9bc97ee884ea8987ec8d70bbacddccb12f&v=4","created_at":"0001-01-01T00:00:00Z","followers":0,"following":0,"html_url":"https://github.com/ajreckof","id":66184050,"node_id":"MDQ6VXNlcjY2MTg0MDUw","login":"ajreckof","type":"User","owned_private_repos":0,"public_gists":0,"public_repos":0,"total_private_repos":0,"url":"https://api.github.com/users/ajreckof"},"body":"The code from this last version is really good and the change is something that was needed for quite some time. I agree with akien that i think we should not move the delete edit button in this PR but keep it in a separate proposal PR to not slow this one down with the consideration of where is the best place to put it.\r\n\r\nPersonnaly the center option seems the most elegant and the least likely to have misclicks.","html_url":"https://github.com/godotengine/godot/pull/103257#pullrequestreview-3393688298","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/103257","author_association":"MEMBER","submitted_at":"2025-10-29T14:06:29Z"}]