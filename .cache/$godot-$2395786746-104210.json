[{"id":2688615578,"node_id":"PRR_kwDOAO6SJc6gQQSa","state":"APPROVED","user":{"site_admin":false,"suspended":false,"updated_at":"0001-01-01T00:00:00Z","avatar_url":"https://avatars.githubusercontent.com/u/6639237?u=89d4350f70d480d0457417ef122a7aaa1bb633f7&v=4","created_at":"0001-01-01T00:00:00Z","followers":0,"following":0,"html_url":"https://github.com/MJacred","id":6639237,"node_id":"MDQ6VXNlcjY2MzkyMzc=","login":"MJacred","type":"User","owned_private_repos":0,"public_gists":0,"public_repos":0,"total_private_repos":0,"url":"https://api.github.com/users/MJacred"},"body":"Tested with simple setups from my Navgiation Area tests. Worked like a charm.\r\n\r\nIf possible, show a dialog with a message such as \"You're attempting to bake multiple NavigationRegion3D nodes. This can freeze the Editor temporarily.\" *Continue* | *Cancel*.  \r\nBut only if Godot has such a function such as showing a checkbutton between the message and the dialog buttons stating \"Don't show this warning again.\"\r\n\r\nThe best case would be a queue on a separate thread to prevent potential Editor freezing… Could this be easily achievable with WorkerThreadPool?","html_url":"https://github.com/godotengine/godot/pull/104210#pullrequestreview-2688615578","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/104210","author_association":"CONTRIBUTOR","submitted_at":"2025-03-16T11:19:53Z"},{"id":2688620979,"node_id":"PRR_kwDOAO6SJc6gQRmz","state":"COMMENTED","user":{"site_admin":false,"suspended":false,"updated_at":"0001-01-01T00:00:00Z","avatar_url":"https://avatars.githubusercontent.com/u/52464204?u=4854f17c9d330a8a9d274f0cb7b943fc2bb6dd44&v=4","created_at":"0001-01-01T00:00:00Z","followers":0,"following":0,"html_url":"https://github.com/smix8","id":52464204,"node_id":"MDQ6VXNlcjUyNDY0MjA0","login":"smix8","type":"User","owned_private_repos":0,"public_gists":0,"public_repos":0,"total_private_repos":0,"url":"https://api.github.com/users/smix8"},"body":"","html_url":"https://git