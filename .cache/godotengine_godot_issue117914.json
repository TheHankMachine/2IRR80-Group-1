te_admin":false},"open_issues":3,"closed_issues":2535,"state":"closed","created_at":"2025-11-27T20:29:18Z","updated_at":"2026-10-20T18:39:31Z","due_on":null,"closed_at":"2026-06-19T16:54:35Z"},"comments":4,"created_at":"2026-03-27T19:15:24Z","updated_at":"2026-04-13T16:47:47Z","closed_at":"2026-04-13T16:47:47Z","assignee":null,"author_association":"NONE","issue_field_values":[],"type":null,"active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"### Tested versions\n\nReproducible in:\nv4.7.dev3.official [60fff00a6]\n\nNot reproducible in:\nv4.7.dev2.official [778cf54da]\nv4.6.2.rc2.official [638b2f1e9]\nv4.6.1.stable.official [14d19694e]\n\n### System information\n\nGodot v4.7.dev3 - Windows 11 (build 26100) - Multi-window, 1 monitor - OpenGL 3 (Compatibility) - GeForce GTX 550 Ti - Intel(R) Core(TM) i3-2100 CPU @ 3.10GHz (4 threads) - 11.95 GiB memory\n\n### Issue description\n\nTyping a period after an enum variable in Godot 4.7.dev3 shows:\n> ERROR: core/object/class_db.cpp:1210 - Parameter \"type\" is null.\n\nThere's no error in the last three Godot versions before 4.7.dev3.\n\n### Steps to reproduce\n\n- open the project: [enum-dot-parameter-type-is-null.zip](https://github.com/user-attachments/files/26312924/enum-dot-parameter-type-is-null.zip)\n- near the bottom left corner, click on the `Output` button to open its bottom panel\n- in the file system panel, open the script: `new_script.gd`\n- it looks like this:\n```\nextends Node\n\nenum x {\n\ta,\n\tb,\n\tc\n}\n\nfunc _ready() -> void:\n\tprint(x)\n```\n- in the script editor, on the last line, in the print statement, mouse left click after the letter `x`.\n- type a period: `.` \n\n### Issue:\nThe output panel shows:\n>   ERROR: core/object/class_db.cpp:1210 - Parameter \"type\" is null.\n\nIt's repeatable:\n- press: `backspace`\n- type a period: `.`\n\n<img width=\"833\" height=\"569\" alt=\"Image\" src=\"https://github.com/user-attachments/assets/6605d663-7586-491e-bfcf-b46bf6eed705\" />\n\n### Expected:\nThere shouldn't be an error.\nThere's no error in previous versions:\nNot reproduced in:\n- v4.7.dev2.official [778cf54da]\n- v4.6.2.rc2.official [638b2f1e9]\n- v4.6.1.stable.official [14d19694e]\n\n### Videos\n\n#### 4.7.dev3 Error\n\nhttps://github.com/user-attachments/assets/9b3d662b-7003-40cf-b27a-939865bf8174\n\n#### 4.7.dev2 Expected\n\nhttps://github.com/user-attachments/assets/5aaa5c5e-8e05-43e3-ac44-937e29837f65\n\n### Minimal reproduction project (MRP)\n\n[enum-dot-parameter-type-is-null.zip](https://github.com/user-attachments/files/26312924/enum-dot-parameter-type-is-null.zip)","closed_by":{"login":"Repiteo","id":17489292,"node_id":"MDQ6VXNlcjE3NDg5Mjky","avatar_url":"https://avatars.githubusercontent.com/u/17489292?v=4","gravatar_id":"","url":"https://api.github.com/users/Repiteo","html_url":"https://github.com/Repiteo","followers_url":"https://api.github.com/users/Repiteo/followers","following_url":"https://api.github.com/users/Repiteo/following{/other_user}","gists_url":"https://api.github.com/users/Repiteo/gists{/gist_id}","starred_url":"https://api.github.com/users/Repiteo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Repiteo/subscriptions","organizations_url":"https://api.github.com/users/Repiteo/orgs","repos_url":"https://api.github.com/users/Repiteo/repos","events_url":"https://api.github.com/users/Repiteo/events{/privacy}","received_events_url":"https://api.github.com/users/Repiteo/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/117914/reactions","total_count":1,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":1},"timeline_url":"https://api.github.com/repos/godotengine/godot/issues/117914/timeline","performed_via_github_app":null,"state_reason":"