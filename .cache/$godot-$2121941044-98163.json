[{"id":2369101433,"node_id":"PRR_kwDOAO6SJc6NNZ55","state":"APPROVED","user":{"site_admin":false,"suspended":false,"updated_at":"0001-01-01T00:00:00Z","avatar_url":"https://avatars.githubusercontent.com/u/191561?v=4","created_at":"0001-01-01T00:00:00Z","followers":0,"following":0,"html_url":"https://github.com/dsnopek","id":191561,"node_id":"MDQ6VXNlcjE5MTU2MQ==","login":"dsnopek","type":"User","owned_private_repos":0,"public_gists":0,"public_repos":0,"total_private_repos":0,"url":"https://api.github.com/users/dsnopek"},"body":"Overall, this restructuring of the action map data makes sense to me!\r\n\r\nThis is also a breaking change with regard to code that programmatically creates an action map with multiple paths per binding. However, I think it's pretty rare to programmatically create an action map, and even so, it would only affect bindings with multiple paths, which even further reduces the affected code. I personally think this is acceptable.\r\n\r\nIn 99.9% of cases, developers will create action maps in the editor, and this should correctly load and convert existing action maps (although, I haven't tested it - only reviewed the code).\r\n\r\nTL;DR LGTM :-)\r\n\r\nOnly a handful of minor notes.","html_url":"https://github.com/godotengine/godot/pull/98163#pullrequestreview-2369101433","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/98163","author_association":"CONTRIBUTOR","submitted_at":"2024-10-15T12:10:23Z"},{"id":2365964655,"node_id":"PRR_kwDOAO6SJc6NBcFv","state":"COMMENTED","user":{"site_admin":false,"suspended":false,"updated_at":"0001-01-01T00:00:00Z","avatar_url":"https://avatars.githubusercontent.com/u/96648715?u=af70f5d107e9c1447f296643d5a566dab53d25e8&v=4","created_at":"0001-01-01T00:00:00Z","followers":0,"following":0,"html_url":"https://github.com/AThousandShips","id":96648715,"node_id":"U_kgDOBcK-Cw","login":"AThousandShips","type":"User","owned_private_repos":0,"public_gists":0,"public_repos":0,"total_private_repos":0,