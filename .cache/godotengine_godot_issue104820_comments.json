github.com/users/akien-mga/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/akien-mga/subscriptions","organizations_url":"https://api.github.com/users/akien-mga/orgs","repos_url":"https://api.github.com/users/akien-mga/repos","events_url":"https://api.github.com/users/akien-mga/events{/privacy}","received_events_url":"https://api.github.com/users/akien-mga/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-10-24T09:33:04Z","updated_at":"2025-10-24T09:33:04Z","body":"@iocron What's your system and how did you install Godot? The bug should be fixed in 4.5-stable and later, but if you're using a distro package linked against system mbedtls, they may still trigger the issue if their mbedtls is not configured properly for TLSv1.3.","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3442118700/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3825532652","html_url":"https://github.com/godotengine/godot/issues/104820#issuecomment-3825532652","issue_url":"https://api.github.com/repos/godotengine/godot/issues/104820","id":3825532652,"node_id":"IC_kwDOAO6SJc7kBP7s","user":{"login":"Kenshij","id":11033477,"node_id":"MDQ6VXNlcjExMDMzNDc3","avatar_url":"https://avatars.githubusercontent.com/u/11033477?v=4","gravatar_id":"","url":"https://api.github.com/users/Kenshij","html_url":"https://github.com/Kenshij","followers_url":"https://api.github.com/users/Kenshij/followers","following_url":"https://api.github.com/users/Kenshij/following{/other_user}","gists_url":"https://api.github.com/users/Kenshij/gists{/gist_id}","starred_url":"https://api.github.com/users/Kenshij/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Kenshij/subscriptions","organ