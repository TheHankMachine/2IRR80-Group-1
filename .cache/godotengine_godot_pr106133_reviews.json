[{"id":2820222263,"node_id":"PRR_kwDOAO6SJc6oGS03","user":{"login":"raulsntos","id":3903059,"node_id":"MDQ6VXNlcjM5MDMwNTk=","avatar_url":"https://avatars.githubusercontent.com/u/3903059?u=1b0467024f137e562b21748eb6bf12f97dfa5bf6&v=4","gravatar_id":"","url":"https://api.github.com/users/raulsntos","html_url":"https://github.com/raulsntos","followers_url":"https://api.github.com/users/raulsntos/followers","following_url":"https://api.github.com/users/raulsntos/following{/other_user}","gists_url":"https://api.github.com/users/raulsntos/gists{/gist_id}","starred_url":"https://api.github.com/users/raulsntos/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/raulsntos/subscriptions","organizations_url":"https://api.github.com/users/raulsntos/orgs","repos_url":"https://api.github.com/users/raulsntos/repos","events_url":"https://api.github.com/users/raulsntos/events{/privacy}","received_events_url":"https://api.github.com/users/raulsntos/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"Thanks for contributing to the .NET module!\r\n\r\nThe `movable` types are only meant to be used to store them in classes (like `StringName`) where we can't store ref structs. None of them implement any API other than for conversion. So I think it was intentional to not implement `GetHashCode`.\r\n\r\nHowever, as you noticed, we likely meant to call the `godot_string_name.GetHashCode` method (which is implemented) from the `StringName.GetHashCode` implementation. So the fix should be something like this:\r\n\r\n```diff\r\ndiff --git a/modules/mono/glue/GodotSharp/GodotSharp/Core/StringName.cs b/modules/mono/glue/GodotSharp/GodotSharp/Core/StringName.cs\r\nindex 21d9ada127..a28230636f 100644\r\n--- a/modules/mono/glue/GodotSharp/GodotSharp/Core/StringName.cs\r\n+++ b/modules/mono/glue/GodotSharp/GodotSharp/Core/StringName.cs\r\n@@ -161,7 +161,7 @@ namespace Godot\r\n \r\n         public override int GetHashCode()\r\n         {\r\n-            return NativeValue.GetHashCode();\r\n+            return NativeValue.DangerousSelfRef.GetHashCode();\r\n         }\r\n     }\r\n }\r\n\r\n```","state":"CHANGES_REQUESTED","html_url":"https://github.com/godotengine/godot/pull/106133#pullrequestreview-2820222263","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/106133","author_association":"MEMBER","_links":{"html":{"href":"https://github.com/godotengine/godot/pull/106133#pullrequestreview-2820222263"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/106133"}},"submitted_at":"2025-05-07T03:25:36Z","commit_id":null},{"id":2823149577,"node_id":"PRR_kwDOAO6SJc6oRdgJ","user":{"login":"raulsntos","id":3903059,"node_id":"MDQ6VXNlcjM5MDMwNTk=","avatar_url":"https://avatars.githubusercontent.com/u/3903059?u=1b0467024f137e562b21748eb6bf12f97dfa5bf6&v=4","gravatar_id":"","url":"https://api.github.com/users/raulsntos","html_url":"https://github.com/raulsntos","followers_url":"https://api.github.com/users/raulsntos/followers","following_url":"https://api.github.com/users/raulsntos/following{/other_user}","gists_url":"https://api.github.com/users/raulsntos/gists{/gist_id}","starred_url":"https://api.github.com/users/raulsntos/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/raulsntos/subscriptions","organizations_url":"https://api.github.com/users/raulsntos/orgs","repos_url":"https://api.github.com/users/raulsntos/repos","events_url":"https://api.github.com/users/raulsntos/events{/privacy}","received_events_url":"https://api.github.com/users/raulsntos/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"Looks good to me, thanks!","state":"APPROVED","html_url":"https://github.com/godotengine/godot/pull/106133#pullrequestreview-2823149577","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/106133","author_association":"MEMBER","_links":{"html":{"href":"https://github.com/godotengine/godot/pull/1