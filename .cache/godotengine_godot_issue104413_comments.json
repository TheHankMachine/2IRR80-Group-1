otengine/godot/issues/comments/2880854250/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2880918634","html_url":"https://github.com/godotengine/godot/issues/104413#issuecomment-2880918634","issue_url":"https://api.github.com/repos/godotengine/godot/issues/104413","id":2880918634,"node_id":"IC_kwDOAO6SJc6rt1Rq","user":{"login":"kitbdev","id":10054226,"node_id":"MDQ6VXNlcjEwMDU0MjI2","avatar_url":"https://avatars.githubusercontent.com/u/10054226?v=4","gravatar_id":"","url":"https://api.github.com/users/kitbdev","html_url":"https://github.com/kitbdev","followers_url":"https://api.github.com/users/kitbdev/followers","following_url":"https://api.github.com/users/kitbdev/following{/other_user}","gists_url":"https://api.github.com/users/kitbdev/gists{/gist_id}","starred_url":"https://api.github.com/users/kitbdev/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/kitbdev/subscriptions","organizations_url":"https://api.github.com/users/kitbdev/orgs","repos_url":"https://api.github.com/users/kitbdev/repos","events_url":"https://api.github.com/users/kitbdev/events{/privacy}","received_events_url":"https://api.github.com/users/kitbdev/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-05-14T16:54:13Z","updated_at":"2025-05-14T16:54:13Z","body":"- The warnings not working was probably caused by https://github.com/godotengine/godot/pull/106297\n","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2880918634/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2880950009","html_url":"https://github.com/godotengine/godot/issues/104413#issuecomment-2880950009","issue_url":"https://api.github.com/repos/godotengine/godot/issues/104413","id":2880950009,"node_id":"IC_kwDOAO6SJc6rt875","user":{"login":"jorgekorgut","id":70108521,"node_id":"MDQ6VXNlcjcwMTA4NTIx","avatar_url":"https://avatars.githubusercontent.com/u/70108521?v=4","gravatar_id":"","url":"https://api.github.com/users/jorgekorgut","html_url":"https://github.com/jorgekorgut","followers_url":"https://api.github.com/users/jorgekorgut/followers","following_url":"https://api.github.com/users/jorgekorgut/following{/other_user}","gists_url":"https://api.github.com/users/jorgekorgut/gists{/gist_id}","starred_url":"https://api.github.com/users/jorgekorgut/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/jorgekorgut/subscriptions","organizations_url":"https://api.github.com/users/jorgekorgut/orgs","repos_url":"https://api.github.com/users/jorgekorgut/repos","events_url":"https://api.github.com/users/jorgekorgut/events{/privacy}","received_events_url":"https://api.github.com/users/jorgekorgut/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-05-14T17:06:16Z","updated_at":"2025-05-14T17:14:31Z","body":"Indeed. Changing the orders of ```_update_warnings``` and ```_update_errors``` does give me back the warnings highlight. I will dig deeper to discover why.\n\nedit :\nIt seems like the logic for the ```_update_errors``` is cleanning up the previous setted line backgrounds if no errors were found.\nOne way I propose to solve this issue is to get the previous setted background color instead of erasing the color.","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2880950009/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2881037827","html_url":"https://github.com/godotengine/godot/issues/104413#issuecomment-2881037827","issue_url":"https://api.github.com/repos/godotengine/godot/issues/104413","id":2881037827,"node_id":"IC_kwDOAO6SJc6ruSYD","user":{"login":"kitbdev","id":10054226,"node_id":"MDQ6VXNlcjEwMDU0MjI2","avatar_url":"https://avatars.githubusercontent.com/u/10054226?v=4","gravatar_id":"","url":"https://api.github.com/users/kitbdev","html_url":"https://github.com/kitbdev","followers_url":"https://api.github.com/users/kitbdev/followers","following_url":"https://api.github.com/users/kitbdev/following{/other_user}","gists_url":"https://api.github.com/users/kitbdev/gists{/gist_id}","starred_url":"https://api.github.com/users/kitbdev/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/kitbdev/subscriptions","organizations_url":"https://api.github.com/users/kitbdev/orgs","repos_url":"https://api.github.com/users/kitbdev/repos","events_url":"https://api.github.com/users/kitbdev/events{/privacy}","received_events_url":"https://api.github.com/users/kitbdev/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-05-14T17:40:25Z","updated_at":"2025-05-14T17:42:53Z","body":"> It seems like the logic for the _update_errors is cleanning up the previous setted line backgrounds if no errors were found.\nOne way I propose to solve this issue is to get the previous setted background color instead of erasing the color.\n\nThat sounds like previous errors won't get cleared when fixed. I think the `_update_warnings` can just have the logic to clear the line color instead, and the `_update_error` only sets it if there is an error. Or the line colors can all be updated at the same time afterwards.","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2881037827/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null}]