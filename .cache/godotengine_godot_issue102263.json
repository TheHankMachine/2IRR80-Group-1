description":"","archived_at":null,"archived_by":null},{"id":279098219,"node_id":"MDU6TGFiZWwyNzkwOTgyMTk=","url":"https://api.github.com/repos/godotengine/godot/labels/topic:editor","name":"topic:editor","color":"ffee88","default":false,"description":"","archived_at":null,"archived_by":null},{"id":2666708289,"node_id":"MDU6TGFiZWwyNjY2NzA4Mjg5","url":"https://api.github.com/repos/godotengine/godot/labels/topic:3d","name":"topic:3d","color":"ffee88","default":false,"description":"","archived_at":null,"archived_by":null}],"state":"closed","locked":false,"assignees":[],"milestone":null,"comments":4,"created_at":"2025-01-31T21:45:01Z","updated_at":"2025-02-02T03:15:13Z","closed_at":"2025-02-02T02:48:54Z","assignee":null,"author_association":"CONTRIBUTOR","issue_field_values":[],"type":null,"active_lock_reason":null,"draft":true,"pull_request":{"url":"https://api.github.com/repos/godotengine/godot/pulls/102263","html_url":"https://github.com/godotengine/godot/pull/102263","diff_url":"https://github.com/godotengine/godot/pull/102263.diff","patch_url":"https://github.com/godotengine/godot/pull/102263.patch","merged_at":null},"body":"<!--\r\nPlease target the `master` branch in priority.\r\n\r\nRelevant fixes are cherry-picked for stable branches as needed by maintainers.\r\n\r\nTo speed up the contribution process and avoid CI errors, please set up pre-commit hooks locally:\r\nhttps://docs.godotengine.org/en/latest/contributing/development/code_style_guidelines.html\r\n-->\r\n\r\nAdd a setting ```docks/filesystem/scene_thumbnail_capture_method``` to toggle between **FREE** / **FIXED** thumbnail captures, **FREE** is the default behavior, which captures scene thumbnail by the current camera view. This PR adds a **FIXED** option to always capture scene thumbnails with a 3/4 fixed view (in 3d), also ensures all visual elements are within the capture.\r\n\r\n![scene_thumbnail_fixed](https://github.com/user-attachments/assets/4d1b396f-c0cc-4ba2-b9e0-6a7e87bc5f5e)\r\n\r\nhttps://github.com/user-attachments/assets/4524f572-d47a-4db9-8fe3-69e24154dcad\r\n\r\nTODO:\r\n - [ ] Set fixed camera zoom / fov when capturing\r\n - [ ] Hide gizmo when capturing thumbnails\r\n - [ ] Exclude node types that are generally not concerned in thumbnails from AABB calculation (light, particles, probes, skeletons, colliders)\r\n - [ ] Implement FIXED thumbnail capturing for 2d scenes\r\n - [ ] Check if performance is okay for large scenes with large number of nodes\r\n\r\n___\r\n\r\n- *Production edit: This partially addresses https://github.com/godotengine/godot-proposals/issues/7232 (3D only).*","closed_by":{"login":"daniel080400","id":26960237,"node_id":"MDQ6VXNlcjI2OTYwMjM3","avatar_url":"https://avatars.githubusercontent.com/u/26960237?v=4","gravatar_id":"","url":"https://api.github.com/users/daniel080400","html_url":"https://github.com/daniel080400","followers_url":"https://api.github.com/users/daniel080400/followers","following_url":"https://api.github.com/users/daniel080400/following{/other_user}","gists_url":"https://api.github.com/users/daniel080400/gists{/gist_id}","starred_url":"https://api.github.com/users/daniel080400/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/daniel080400/subscriptions","organizations_url":"https://api.github.com/users/daniel080400/orgs","repos_url":"https://api.github.com/users/daniel080400/repos","events_url":"https://api.github.com/users/daniel080400/events{/privacy}","received_events_url":"https://api.github.com/users/daniel080400/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/102263/reactions","total_count":19,"+1":11,"-1":0,"laugh":0,"hooray":3,"confused":0,"heart":3,"rocket":0,"eyes":2},"timeline_url":"https://api.github.com/repos/godotengine/godot/issues/102263/timeline","performed_via_github_app":null,"state_reason":null}