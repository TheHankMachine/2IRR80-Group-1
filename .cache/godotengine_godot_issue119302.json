pi.github.com/users/akien-mga/orgs","repos_url":"https://api.github.com/users/akien-mga/repos","events_url":"https://api.github.com/users/akien-mga/events{/privacy}","received_events_url":"https://api.github.com/users/akien-mga/received_events","type":"User","user_view_type":"public","site_admin":false},"open_issues":3,"closed_issues":2535,"state":"closed","created_at":"2025-11-27T20:29:18Z","updated_at":"2026-10-20T18:39:31Z","due_on":null,"closed_at":"2026-06-19T16:54:35Z"},"comments":6,"created_at":"2026-05-07T03:40:43Z","updated_at":"2026-05-11T16:15:14Z","closed_at":"2026-05-11T16:12:58Z","assignee":{"login":"Nintorch","id":92302738,"node_id":"U_kgDOBYBtkg","avatar_url":"https://avatars.githubusercontent.com/u/92302738?v=4","gravatar_id":"","url":"https://api.github.com/users/Nintorch","html_url":"https://github.com/Nintorch","followers_url":"https://api.github.com/users/Nintorch/followers","following_url":"https://api.github.com/users/Nintorch/following{/other_user}","gists_url":"https://api.github.com/users/Nintorch/gists{/gist_id}","starred_url":"https://api.github.com/users/Nintorch/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Nintorch/subscriptions","organizations_url":"https://api.github.com/users/Nintorch/orgs","repos_url":"https://api.github.com/users/Nintorch/repos","events_url":"https://api.github.com/users/Nintorch/events{/privacy}","received_events_url":"https://api.github.com/users/Nintorch/received_events","type":"User","user_view_type":"public","site_admin":false},"author_association":"NONE","issue_field_values":[],"type":null,"active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"### Tested versions\n\n- Reproducible in 4.6.2.stable\n\n### System information\n\nArch Linux - Godot V4.6.2.stable - graphics unlikely to play a part\n\n### Issue description\n\nI have found that when using a Huion Kamvas 13 drawing tablet on a system that I am running a project on, ui_up and ui_left are pegged at 1.0 until the window is moved (at which point they yield to true inputs).\n\nThe behavior is exactly as described and demonstrated in [issue 110536](https://github.com/godotengine/godot/issues/110536).\n\nI have verified that the drawing tablet is the issue by opening the project with the tablet connected and observing the issue, opening the project with the tablet unplugged and observing no issue, then opening the project with the tablet connected and observing the issue again.\n\nI have also verified that the tablet shows up under the output of  Input.get_joy_name() and Input.get_joy_info() show the huion tablet as two inputs:\n1. a touch bar (not implemented on this model's hardware, but in the drivers for it)\n2. the tablet itself\nmoving the pen near the drawing tablet does not have any effect.\n\nI did not see any issues open related to this or any PRs that would have fixed the issue, but I have missed things before and will undoubtedly do so again.\n\n### Steps to reproduce\n\nConnect a Huion Kamvas 13 to a computer\n\ncreate a project that reads and prints the value of `Input.is_action_pressed(\"ui_up\")` and `Input.is_action_pressed(\"ui_left\")`\n\nrun the project and observe the inputs to be true until the window is moved.\n\n### Minimal reproduction project (MRP)\n\n[issue.zip](https://github.com/user-attachments/files/27464793/issue.zip)","closed_by":{"login":"Repiteo","id":17489292,"node_id":"MDQ6VXNlcjE3NDg5Mjky","avatar_url":"https://avatars.githubusercontent.com/u/17489292?v=4","gravatar_id":"","url":"https://api.github.com/users/Repiteo","html_url":"https://github.com/Repiteo","followers_url":"https://api.github.com/users/Repiteo/followers","following_url":"https://api.github.com/users/Repiteo/following{/other_user}","gists_url":"https://api.github.com/users/Repiteo/gists{/gist_id}","starred_url":"https://api.github.com/users/Rep