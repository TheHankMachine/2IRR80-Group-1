154\r\n\r\nScope: fixes Linux trackpad scrolling on Wayland, and fixes MacOS trackpad scrolling. Windows is unchanged, and mouse scrolling on Linux/MacOS is unchanged.\r\n\r\nOn Linux/Wayland and MacOS, get_delta() returns a value intended to be interpreted as a measurement proportional to a pixel, however previously it was being multiplied by the page size, which makes no sense; the delta is not a proportion of the page size. This has been fixed.\r\n\r\nRelevant docs for MacOS:\r\n    https://developer.apple.com/documentation/appkit/nsevent/scrollingdeltay\r\n    https://developer.apple.com/documentation/appkit/nsevent/scrollingdeltax\r\n\r\n","labels":[{"id":73330064,"node_id":"MDU6TGFiZWw3MzMzMDA2NA==","url":"https://api.github.com/repos/godotengine/godot/labels/bug","name":"bug","description":"","color":"ff6055","default":true,"archived_at":null,"archived_by":null},{"id":279098219,"node_id":"MDU6TGFiZWwyNzkwOTgyMTk=","url":"https://api.github.com/repos/godotengine/godot/labels/topic:editor","name":"topic:editor","description":"","color":"ffee88","default":false,"archived_at":null,"archived_by":null},{"id":283518733,"node_id":"MDU6TGFiZWwyODM1MTg3MzM=","url":"https://api.github.com/repos/godotengine/godot/labels/usability","name":"usability","description":"","color":"447744","default":false,"archived_at":null,"archived_by":null},{"id":890310664,"node_id":"MDU6TGFiZWw4OTAzMTA2NjQ=","url":"https://api.github.com/repos/godotengine/godot/labels/topic:input","name":"topic:input","description":"","color":"ffee88","default":false,"archived_at":null,"archived_by":null}],"milestone":{"id":15520464,"node_id":"MI_kwDOAO6SJc4A7NLQ","url":"https://api.github.com/repos/godotengine/godot/milestones/25","html_url":"https://github.com/godotengine/godot/milestone/25","labels_url":"https://api.github.com/repos/godotengine/godot/milestones/25/labels","number":25,"state":"open","title":"4.8","description":"","creator":{"login":"Repiteo","id":17489292,"node_id":"MDQ6VXNlcjE3NDg5Mjky",