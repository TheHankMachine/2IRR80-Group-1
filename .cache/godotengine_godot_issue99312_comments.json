[{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2480520555","html_url":"https://github.com/godotengine/godot/issues/99312#issuecomment-2480520555","issue_url":"https://api.github.com/repos/godotengine/godot/issues/99312","id":2480520555,"node_id":"IC_kwDOAO6SJc6T2b1r","user":{"login":"AThousandShips","id":96648715,"node_id":"U_kgDOBcK-Cw","avatar_url":"https://avatars.githubusercontent.com/u/96648715?v=4","gravatar_id":"","url":"https://api.github.com/users/AThousandShips","html_url":"https://github.com/AThousandShips","followers_url":"https://api.github.com/users/AThousandShips/followers","following_url":"https://api.github.com/users/AThousandShips/following{/other_user}","gists_url":"https://api.github.com/users/AThousandShips/gists{/gist_id}","starred_url":"https://api.github.com/users/AThousandShips/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/AThousandShips/subscriptions","organizations_url":"https://api.github.com/users/AThousandShips/orgs","repos_url":"https://api.github.com/users/AThousandShips/repos","events_url":"https://api.github.com/users/AThousandShips/events{/privacy}","received_events_url":"https://api.github.com/users/AThousandShips/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2024-11-16T10:47:55Z","updated_at":"2024-11-16T10:47:55Z","body":"See also:\r\n* https://github.com/godotengine/godot/issues/45354","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2480520555/reactions","total_count":3,"+1":3,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2480528774","html_url":"https://github.com/godotengine/godot/issues/99312#issuecomment-2480528774","issue_url":"https://api.github.com/repos/godotengine/godot/issues/99312","id":2480528774,"node_id":"IC_kwDOAO6SJc6T2d2G","user":{"login":"JayTheCoderX","id":99644884,"node_id":"U_kgDOBfB11A","avatar_url":"https://avatars.githubusercontent.com/u/99644884?v=4","gravatar_id":"","url":"https://api.github.com/users/JayTheCoderX","html_url":"https://github.com/JayTheCoderX","followers_url":"https://api.github.com/users/JayTheCoderX/followers","following_url":"https://api.github.com/users/JayTheCoderX/following{/other_user}","gists_url":"https://api.github.com/users/JayTheCoderX/gists{/gist_id}","starred_url":"https://api.github.com/users/JayTheCoderX/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/JayTheCoderX/subscriptions","organizations_url":"https://api.github.com/users/JayTheCoderX/orgs","repos_url":"https://api.github.com/users/JayTheCoderX/repos","events_url":"https://api.github.com/users/JayTheCoderX/events{/privacy}","received_events_url":"https://api.github.com/users/JayTheCoderX/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2024-11-16T11:24:05Z","updated_at":"2024-11-16T11:24:05Z","body":"Notably, even files that shouldn't have been saved, like the shaders which weren't even open at the time, were wiped","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2480528774/reactions","total_count":5,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":5},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2495441316","html_url":"https://github.com/godotengine/godot/issues/99312#issuecomment-2495441316","issue_url":"https://api.github.com/repos/godotengine/godot/issues/99312","id":2495441316,"node_id":"IC_kwDOAO6SJc6UvWmk","user":{"login":"KoBeWi","id":2223172,"node_id":"MDQ6VXNlcjIyMjMxNzI=","avatar_url":"https://avatars.githubusercontent.com/u/2223172?v=4","gravatar_id":"","url":"https://api.github.com/users/KoBeWi","html_url":"https://github.com/KoBeWi","followers_url":"https://api.github.com/users/KoBeWi/followers","following_url":"https://api.github.com/users/KoBeWi/following{/other_user}","gists_url":"https://api.github.com/users/KoBeWi/gists{/gist_id}","starred_url":"https://api.github.com/users/KoBeWi/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/KoBeWi/subscriptions","organizations_url":"https://api.github.com/users/KoBeWi/orgs","repos_url":"https://api.github.com/users/KoBeWi/repos","events_url":"https://api.github.com/users/KoBeWi/events{/privacy}","received_events_url":"https://api.github.com/users/KoBeWi/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2024-11-23T11:05:52Z","updated_at":"2024-11-23T11:05:52Z","body":"> Side note: I feel like this could be fixed by when attempting to save a file, first make a copy, verify that the copy saved correctly, if it did then override the original, if that saves correctly then you can remove a copy.\n\nThis should be already happening and it's called \"safe save\". Sometimes it can fail when file is read-only and you are left with tmp files in your project; the original file is untouched.","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2495441316/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2495441706","html_url":"https://github.com/godotengine/godot/issues/99312#issuecomment-2495441706","issue_url":"https://api.github.com/repos/godotengine/godot/issues/99312","id":2495441706,"node_id":"IC_kwDOAO6SJc6UvWsq","user":{"login":"AThousandShips","id":96648715,"node_id":"U_kgDOBcK-Cw","avatar_url":"https://avatars.githubusercontent.com/u/96648715?v=4","gravatar_id":"","url":"https://api.github.com/users/AThousandShips","html_url":"https://github.com/AThousandShips","followers_url":"https://api.github.com/users/AThousandShips/followers","following_url":"https://api.github.com/users/AThousandShips/following{/other_user}","gists_url":"https://api.github.com/users/AThousandShips/gists{/gist_id}","starred_url":"https://api.github.com/users/AThousandShips/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/AThousandShips/subscriptions","organizations_url":"https://api.github.com/users/AThousandShips/orgs","repos_url":"https://api.github.com/users/AThousandShips/repos","events_url":"https://api.github.com/users/AThousandShips/events{/privacy}","received_events_url":"https://api.github.com/users/AThousandShips/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2024-11-23T11:07:29Z","updated_at":"2024-11-23T11:08:42Z","body":"The problem is that the safe save won't help if the engine doesn't detect that the file system is full, unless it does correctly detect failure and stops writing back, in that case it just writes empty to the old file because that's what's in the new one","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2495441706/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2495444151","html_url":"https://github.com/godotengine/godot/issues/99312#issuecomment-2495444151","issue_url":"https://api.github.com/repos/godotengine/godot/issues/99312","id":2495444151,"node_id":"IC_kwDOAO6SJc6UvXS3","user":{"login":"KoBeWi","id":2223172,"node_id":"MDQ6VXNlcjIyMjMxNzI=","avatar_url":"https://avatars.githubusercontent.com/u/2223172?v=4","gravatar_id":"","url":"https://api.github.com/users/KoBeWi","html_url":"https://github.com/KoBeWi","followers_url":"https://api.github.com/users/KoBeWi/followers","following_url":"https://api.github.com/users/KoBeWi/following{/other_user}","gists_url":"https://api.github.com/users/KoBeWi/gists{/gist_id}","starred_url":"https://api.github.com/users/KoBeWi/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/KoBeWi/subscriptions","organizations_url":"https://api.github.com/users/KoBeWi/orgs","repos_url":"https://api.github.com/users/KoBeWi/repos","events_url":"https://api.github.com/users/KoBeWi/events{/privacy}","received_events_url":"https://api.github.com/users/KoBeWi/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2024-11-23T11:17:32Z","updated_at":"2024-11-23T11:17:32Z","body":"Shouldn't it fail at OS level though? In that case Godot would be able to handle it. Do apps normally account for full disk space?","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2495444151/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2495444674","html_url":"https://github.com/godotengine/godot/issues/99312#issuecomment-2495444674","issue_url":"https://api.github.com/repos/godotengine/godot/issues/99312","id":2495444674,"node_id":"IC_kwDOAO6SJc6UvXbC","user":{"login":"AThousandShips","id":96648715,"node_id":"U_kgDOBcK-Cw","avatar_url":"https://avatars.githubusercontent.com/u/96648715?v=4","gravatar_id":"","url":"https://api.github.com/users/AThousandShips","html_url":"https://github.com/AThousandShips","followers_url":"https://api.github.com/users/AThousandShips/followers","following_url":"https://api.github.com/users/AThousandShips/following{/other_user}","gists_url":"https://api.github.com/users/AThousandShips/gists{/gist_id}","starred_url":"https://api.github.com/users/AThousandShips/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/AThousandShips/subscriptions","organizations_url":"https://api.github.com/users/AThousandShips/orgs","repos_url":"https://api.github.com/users/AThousandShips/repos","events_url":"https://api.github.com/users/AThousandShips/events{/privacy}","received_events_url":"https://api.github.com/users/AThousandShips/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2024-11-23T11:19:41Z","updated_at":"2024-11-23T11:19:41Z","body":"I don't expect that would or should fail, it renames one file onto another I think, that should *reduce* the amount of data on the drive","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2495444674/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2495445728","html_url":"https://github.com/godotengine/godot/issues/99312#issuecomment-2495445728","issue_url":"https://api.github.com/repos/godotengine/godot/issues/99312","id":2495445728,"node_id":"IC_kwDOAO6SJc6UvXrg","user":{"login":"KoBeWi","id":2223172,"node_id":"MDQ6VXNlcjIyMjMxNzI=","avatar_url":"https://avatars.githubusercontent.com/u/2223172?v=4","gravatar_id":"","url":"https://api.github.com/users/KoBeWi","html_url":"https://github.com/KoBeWi","followers_url":"https://api.github.com/users/KoBeWi/followers","following_url":"https://api.github.com/users/KoBeWi/following{/other_user}","gists_url":"https://api.github.com/users/KoBeWi/gists{/gist_id}","starred_url":"https://api.github.com/users/KoBeWi/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/KoBeWi/subscriptions","organizations_url":"https://api.github.com/users/KoBeWi/orgs","repos_url":"https://api.github.com/users/KoBeWi/repos","events_url":"https://api.github.com/users/KoBeWi/events{/privacy}","received_events_url":"https://api.github.com/users/KoBeWi/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2024-11-23T11:23:33Z","updated_at":"2024-11-23T11:23:47Z","body":"No, but the safe save first writes a file and if writing fails, stops the operation; otherwise it renames it over old file. If that doesn't prevent errors, it means you can write the file with no enough space.","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2495445728/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2495446422","html_url":"https://github.com/godotengine/godot/issues/99312#issuecomment-2495446422","issue_url":"https://api.github.com/repos/godotengine/godot/issues/99312","id":2495446422,"node_id":"IC_kwDOAO6SJc6UvX2W","user":{"login":"AThousandShips","id":96648715,"node_id":"U_kgDOBcK-Cw","avatar_url":"https://avatars.githubusercontent.com/u/96648715?v=4","gravatar_id":"","url":"https://api.github.com/users/AThousandShips","html_url":"https://github.com/AThousandShips","followers_url":"https://api.github.com/users/AThousandShips/followers","following_url":"https://api.github.com/users/AThousandShips/following{/other_user}","gists_url":"https://api.github.com/users/AThousandShips/gists{/gist_id}","starred_url":"https://api.github.com/users/AThousandShips/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/AThousandShips/subscriptions","organizations_url":"https://api.github.com/users/AThousandShips/orgs","repos_url":"https://api.github.com/users/AThousandShips/repos","events_url":"https://api.github.com/users/AThousandShips/events{/privacy}","received_events_url":"https://api.github.com/users/AThousandShips/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2024-11-23T11:26:16Z","updated_at":"2024-11-23T11:26:16Z","body":"That is the assumption yes, but unsure exactly how the detection works, and when things go wrong\n\nIt's possible that the OS causes issues due to temporary storage in memory before writing back etc.\n\nHaven't dug into the small details here, and could be due to various issues with the detection and writing multiple files\n\nTheoretically one part of the operation could fail because space ran out at a critical point etc.\n\nAlso depends on how the rename itself works, it might be the OS doesn't recover gracefully etc.","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2495446422/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2495448429","html_url":"https://github.com/godotengine/godot/issues/99312#issuecomment-2495448429","issue_url":"https://api.github.com/repos/godotengine/godot/issues/99312","id":2495448429,"node_id":"IC_kwDOAO6SJc6UvYVt","user":{"login":"AThousandShips","id":96648715,"node_id":"U_kgDOBcK-Cw","avatar_url":"https://avatars.githubusercontent.com/u/96648715?v=4","gravatar_id":"","url":"https://api.github.com/users/AThousandShips","html_url":"https://github.com/AThousandShips","followers_url":"https://api.github.com/users/AThousandShips/followers","following_url":"https://api.github.com/users/AThousandShips/following{/other_user}","gists_url":"https://api.github.com/users/AThousandShips/gists{/gist_id}","starred_url":"https://api.github.com/users/AThousandShips/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/AThousandShips/subscriptions","organizations_url":"https://api.github.com/users/AThousandShips/orgs","repos_url":"https://api.github.com/users/AThousandShips/repos","events_url":"https://api.github.com/users/AThousandShips/events{/privacy}","received_events_url":"https://api.github.com/users/AThousandShips/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2024-11-23T11:32:55Z","updated_at":"2024-11-23T11:41:24Z","body":"Not sure how the detection would work but the closing operation of `FileAccess` on windows doesn't check if any errors occured, so I'm not sure how this would recover assuming the file creation succeeded and then writing to the temporary file failed\n\nSo as long as the temporary file was created, any error writing to it meanwhile doesn't seem to matter, and the empty temporary file just overwrites the original \n\nI might be missing something in the code but I don't see anything that would prevent this scenario \n\nNote that the safe save feature is there to prevent lost data due to the engine not finishing working on a file, i.e. crashing or turning off before safely closing a file handle, the system seems to fully trust that when a file is properly closed the data in the temporary file is to be trusted as what you want to save","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2495448429/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2495453136","html_url":"https://github.com/godotengine/godot/issues/99312#issuecomment-2495453136","issue_url":"https://api.github.com/repos/godotengine/godot/issues/99312","id":2495453136,"node_id":"IC_kwDOAO6SJc6UvZfQ","user":{"login":"huwpascoe","id":1812087,"node_id":"MDQ6VXNlcjE4MTIwODc=","avatar_url":"https://avatars.githubusercontent.com/u/1812087?v=4","gravatar_id":"","url":"https://api.github.com/users/huwpascoe","html_url":"https://github.com/huwpascoe","followers_url":"https://api.github.com/users/huwpascoe/followers","following_url":"https://api.github.com/users/huwpascoe/following{/other_user}","gists_url":"https://api.github.com/users/huwpascoe/gists{/gist_id}","starred_url":"https://api.github.com/users/huwpascoe/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/huwpascoe/subscriptions","organizations_url":"https://api.github.com/users/huwpascoe/orgs","repos_url":"https://api.github.com/users/huwpascoe/repos","events_url":"https://api.github.com/users/huwpascoe/events{/privacy}","received_events_url":"https://api.github.com/users/huwpascoe/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2024-11-23T11:51:42Z","updated_at":"2024-11-23T11:51:42Z","body":"Windows can create mountable vhd from the partition manager and Linux can do anything with ramdrives etc, so there's no reason why we can't test this problem.","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2495453136/reactions","total_count":1,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":1,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2495454570","html_url":"https://github.com/godotengine/godot/issues/99312#issuecomment-2495454570","issue_url":"https://api.github.com/repos/godotengine/godot/issues/99312","id":2495454570,"node_id":"IC_kwDOAO6SJc6UvZ1q","user":{"login":"AThousandShips","id":96648715,"node_id":"U_kgDOBcK-Cw","avatar_url":"https://avatars.githubusercontent.com/u/96648715?v=4","gravatar_id":"","url":"https://api.github.com/users/AThousandShips","html_url":"https://github.com/AThousandShips","followers_url":"https://api.github.com/users/AThousandShips/followers","following_url":"https://api.github.com/users/AThousandShips/following{/other_user}","gists_url":"https://api.github.com/users/AThousandShips/gists{/gist_id}","starred_url":