ithub_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4006148060","html_url":"https://github.com/godotengine/godot/pull/105243#issuecomment-4006148060","issue_url":"https://api.github.com/repos/godotengine/godot/issues/105243","id":4006148060,"node_id":"IC_kwDOAO6SJc7uyPfc","user":{"login":"passivestar","id":60579014,"node_id":"MDQ6VXNlcjYwNTc5MDE0","avatar_url":"https://avatars.githubusercontent.com/u/60579014?v=4","gravatar_id":"","url":"https://api.github.com/users/passivestar","html_url":"https://github.com/passivestar","followers_url":"https://api.github.com/users/passivestar/followers","following_url":"https://api.github.com/users/passivestar/following{/other_user}","gists_url":"https://api.github.com/users/passivestar/gists{/gist_id}","starred_url":"https://api.github.com/users/passivestar/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/passivestar/subscriptions","organizations_url":"https://api.github.com/users/passivestar/orgs","repos_url":"https://api.github.com/users/passivestar/repos","events_url":"https://api.github.com/users/passivestar/events{/privacy}","received_events_url":"https://api.github.com/users/passivestar/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-03-05T16:07:06Z","updated_at":"2026-03-05T16:07:06Z","body":"> I am a bit iffy on the mouse wheel icons, still. They're an improvement, sure, but are still somewhat unreadable at a distance, mostly because the tip of the up and down arrows have no clear-cut defining line.\r\n\r\nArrow visibility could be improved by ditching the arrow tail and just using a big triangle [like Kenney did](https://kenney.nl/media/pages/assets/input-prompts/adef521913-1744026995/preview-keyboard-mouse.png).","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4006148060/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hoor