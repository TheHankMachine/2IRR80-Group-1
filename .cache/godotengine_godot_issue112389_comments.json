t=\"AcceptDialog\" index=\"2\"]\n+[node name=\"Icon\" type=\"Sprite2D\" parent=\"AcceptDialog\" index=\"3\"]\n position = Vector2(265, 222)\n texture = ExtResource(\"2_d04bu\")\n```","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3493741880/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null}]