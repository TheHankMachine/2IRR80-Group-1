w-4025791554","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/117275","author_association":"MEMBER","submitted_at":"2026-03-28T17:22:40Z"},{"id":4027107093,"node_id":"PRR_kwDOAO6SJc7wCMcV","state":"COMMENTED","user":{"site_admin":false,"suspended":false,"updated_at":"0001-01-01T00:00:00Z","avatar_url":"https://avatars.githubusercontent.com/u/45907836?u=81ff9417b54ba7cb18e202e7f83c1cd7dcaa5888&v=4","created_at":"0001-01-01T00:00:00Z","followers":0,"following":0,"html_url":"https://github.com/uno1982","id":45907836,"node_id":"MDQ6VXNlcjQ1OTA3ODM2","login":"uno1982","type":"User","owned_private_repos":0,"public_gists":0,"public_repos":0,"total_private_repos":0,"url":"https://api.github.com/users/uno1982"},"body":"","html_url":"https://github.com/godotengine/godot/pull/117275#pullrequestreview-4027107093","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/117275","author_association":"CONTRIBUTOR","submitted_at":"2026-03-29T18:28:34Z"},{"id":4097667701,"node_id":"PRR_kwDOAO6SJc70PXJ1","state":"APPROVED","commit_id":"7f7677f281fee7b1cb5568ccc95d7cf1e331735b","user":{"site_admin":false,"suspended":false,"updated_at":"0001-01-01T00:00:00Z","avatar_url":"https://avatars.githubusercontent.com/u/96648715?u=af70f5d107e9c1447f296643d5a566dab53d25e8&v=4","created_at":"0001-01-01T00:00:00Z","followers":0,"following":0,"html_url":"https://github.com/AThousandShips","id":96648715,"node_id":"U_kgDOBcK-Cw","login":"AThousandShips","type":"User","owned_private_repos":0,"public_gists":0,"public_repos":0,"total_private_repos":0,"url":"https://api.github.com/users/AThousandShips"},"body":"Style and docs look good to me","html_url":"https://github.com/godotengine/godot/pull/117275#pullrequestreview-4097667701","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/117275","author_association":"MEMBER","submitted_at":"2026-04-13T09:24:29Z"}]