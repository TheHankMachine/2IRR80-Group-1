://api.github.com/users/solitaryurt/followers","following_url":"https://api.github.com/users/solitaryurt/following{/other_user}","gists_url":"https://api.github.com/users/solitaryurt/gists{/gist_id}","starred_url":"https://api.github.com/users/solitaryurt/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/solitaryurt/subscriptions","organizations_url":"https://api.github.com/users/solitaryurt/orgs","repos_url":"https://api.github.com/users/solitaryurt/repos","events_url":"https://api.github.com/users/solitaryurt/events{/privacy}","received_events_url":"https://api.github.com/users/solitaryurt/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-02-11T23:38:58Z","updated_at":"2025-02-11T23:38:58Z","body":"Confirmed issue on MacOS Intel X86_64 4.4-beta2\nForward+ builds fine, compatibility is broken.","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2652302564/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2652384970","html_url":"https://github.com/godotengine/godot/issues/102696#issuecomment-2652384970","issue_url":"https://api.github.com/repos/godotengine/godot/issues/102696","id":2652384970,"node_id":"IC_kwDOAO6SJc6eGC7K","user":{"login":"stuartcarnie","id":52852,"node_id":"MDQ6VXNlcjUyODUy","avatar_url":"https://avatars.githubusercontent.com/u/52852?v=4","gravatar_id":"","url":"https://api.github.com/users/stuartcarnie","html_url":"https://github.com/stuartcarnie","followers_url":"https://api.github.com/users/stuartcarnie/followers","following_url":"https://api.github.com/users/stuartcarnie/following{/other_user}","gists_url":"https://api.github.com/users/stuartcarnie/gists{/gist_id}","starred_url":"https://api.github.com/users/stuartcarnie/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/stuartcarnie/subscriptions","organizations_url":"https://api.github.com/users/stuartcarnie/orgs","repos_url":"https://api.github.com/users/stuartcarnie/repos","events_url":"https://api.github.com/users/stuartcarnie/events{/privacy}","received_events_url":"https://api.github.com/users/stuartcarnie/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-02-12T00:49:28Z","updated_at":"2025-02-12T00:49:28Z","body":"> Does it work with the rendering driver for `macos` set to `vulkan` in the Project Settings? (Remember to restart the editor after changing it.)\n\n@etherealxx confirmed it works if the renderer is Mobile (which is Metal), and that the problem is only if the renderer is Compatibility. \n\nI can also confirm that it works fine on macOS if the UI renderer is RendererRD based (Forward+ or Mobile), but breaks if UI renderer is Compatibility. I wonder if this is broken on other platforms?\n\nI will take a look to see if there is anything macOS specific causing the issue.","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2652384970/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2652428809","html_url":"https://github.com/godotengine/godot/issues/102696#issuecomment-2652428809","issue_url":"https://api.github.com/repos/godotengine/godot/issues/102696","id":2652428809,"node_id":"IC_kwDOAO6SJc6eGNoJ","user":{"login":"stuartcarnie","id":52852,"node_id":"MDQ6VXNlcjUyODUy","avatar_url":"https://avatars.githubusercontent.com/u/52852?v=4","gravatar_id":"","url":"https://api.github.com/users/stuartcarnie","html_url":"https://github.com/stuartcarnie","followers_url":"https://api.github.com/users/stuartcarnie/followers","following_url":"https://api.github.com/users/stuartcarnie/following{/other_user}","gists_url":"https://api.github.com/users/stuartcarnie/gists{/gist_id}","starred_url":"https://api.github.com/users/stuartcarnie/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/stuartcarnie/subscriptions","organizations_url":"https://api.github.com/users/stuartcarnie/orgs","repos_url":"https://api.github.com/users/stuartcarnie/repos","events_url":"https://api.github.com/users/stuartcarnie/events{/privacy}","received_events_url":"https://api.github.com/users/stuartcarnie/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-02-12T01:25:14Z","updated_at":"2025-02-12T01:25:14Z","body":"Appears unrelated, but I'm seeing the error inside the gles3 code that probably needs to be fixed, as it isn't releasing the texture:\n\n![Image](https://github.com/user-attachments/assets/82c8eb28-5f41-4671-be95-516873f04c40)","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2652428809/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2652432870","html_url":"https://github.com/godotengine/godot/issues/102696#issuecomment-2652432870","issue_url":"https://api.github.com/repos/godotengine/godot/issues/102696","id":2652432870,"node_id":"IC_kwDOAO6SJc6eGOnm","user":{"login":"stuartcarnie","id":52852,"node_id":"MDQ6VXNlcjUyODUy","avatar_url":"https://avatars.githubusercontent.com/u/52852?v=4","gravatar_id":"","url":"https://api.github.com/users/stuartcarnie","html_url":"https://github.com/stuartcarnie","followers_url":"https://api.github.com/users/stuartcarnie/followers","following_url":"https://api.github.com/users/stuartcarnie/following{/other_user}","gists_url":"https://api.github.com/users/stuartcarnie/gists{/gist_id}","starred_url":"https://api.github.com/users/stuartcarnie/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/stuartcarnie/subscriptions","organizations_url":"https://api.github.com/users/stuartcarnie/orgs","repos_url":"https://api.github.com/users/stuartcarnie/repos","events_url":"https://api.github.com/users/stuartcarnie/events{/privacy}","received_events_url":"https://api.github.com/users/stuartcarnie/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-02-12T01:29:00Z","updated_at":"2025-02-12T01:29:00Z","body":"The `lightmap_gi.exr` file is correctly generated:\n\n![Image](https://github.com/user-attachments/assets/7cde50c1-1195-4649-a08a-e7ed9535cf37)\n\nHowever, when the `LightmapGI::_save_and_reimport_atlas_texture` function is executed (Retrieving textures phase), it expects to reload the compressed textures, which are `bptc` and `astc`, both of which report false for the `GLES3` driver:\n\n![Image](https://github.com/user-attachments/assets/feb784c9-0f0f-490c-ae14-919fa75213b0)","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2652432870/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2652575662","html_url":"https://github.com/godotengine/godot/issues/102696#issuecomment-2652575662","issue_url":"https://api.github.com/repos/godotengine/godot/issues/102696","id":2652575662,"node_id":"IC_kwDOAO6SJc6eGxeu","user":{"login":"etherealxx","id":64251396,"node_id":"MDQ6VXNlcjY0MjUxMzk2","avatar_url":"https://avatars.githubusercontent.com/u/64251396?v=4","gravatar_id":"","url":"https://api.github.com/users/etherealxx","html_url":"https://github.com/etherealxx","followers_url":"https://api.github.com/users/etherealxx/followers","following_url":"https://api.github.com/users/etherealxx/following{/other_user}","gists_url":"https://api.github.com/users/etherealxx/gists{/gist_id}","starred_url":"https://api.github.com/users/etherealxx/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/etherealxx/subscriptions","organizations_url":"https://api.github.com/users/etherealxx/orgs","repos_url":"https://api.github.com/users/etherealxx/repos","events_url":"https://api.github.com/users/etherealxx/events{/privacy}","received_events_url":"https://api.github.com/users/etherealxx/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-02-12T03:29:51Z","updated_at":"2025-02-12T03:29:51Z","body":"> Does it work with the rendering driver for macos set to vulkan in the Project Settings? (Remember to restart the editor after changing it.)\n\ndoesn't work (error shows up) both on vulkan and metal\n\n![Image](https://github.com/user-attachments/assets/a1f2a187-2b03-45e6-8263-2c642116fee9)","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2652575662/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2652593880","html_url":"https://github.com/godotengine/godot/issues/102696#issuecomment-2652593880","issue_url":"https://api.github.com/repos/godotengine/godot/issues/102696","id":2652593880,"node_id":"IC_kwDOAO6SJc6eG17Y","user":{"login":"stuartcarnie","id":52852,"node_id":"MDQ6VXNlcjUyODUy","avatar_url":"https://avatars.githubusercontent.com/u/52852?v=4","gravatar_id":"","url":"https://api.github.com/users/stuartcarnie","html_url":"https://github.com/stuartcarnie","followers_url":"https://api.github.com/users/stuartcarnie/followers","following_url":"https://api.github.com/users/stuartcarnie/following{/other_user}","gists_url":"https://api.github.com/users/stuartcarnie/gists{/gist_id}","starred_url":"https://api.github.com/users/stuartcarnie/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/stuartcarnie/subscriptions","organizations_url":"https://api.github.com/users/stuartcarnie/orgs","repos_url":"https://api.github.com/users/stuartcarnie/repos","events_url":"https://api.github.com/users/stuartcarnie/events{/privacy}","received_events_url":"https://api.github.com/users/stuartcarnie/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-02-12T03:47:52Z","updated_at":"2025-02-12T05:18:56Z","body":"Thanks @etherealxx, I expected that outcome, as these settings don't affect baking. \n\nThe issue is that the macOS OpenGL driver does not support BPTC or ASTC compression, which is required by the backing process when it re-imports the textures. I expect this issue is not limited to macOS, and may occur on other platforms when using the compatibility renderer, as apparently only about 50% of OpenGL platforms support ASTC [per GPUInfo](https://opengl.gpuinfo.org/listextensions.php).\n\nWe'll need other Godot team members to weigh in on possible solutions.\n","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2652593880/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2652726078","html_url":"https://github.com/godotengine/godot/issues/102696#issuecomment-2652726078","issue_url":"https://api.github.com/repos/godotengine/godot/issues/102696","id":2652726078,"node_id":"IC_kwDOAO6SJc6eHWM-","user":{"login":"clayjohn","id":16521339,"node_id":"MDQ6VXNlcjE2NTIxMzM5","avatar_url":"https://avatars.githubusercontent.com/u/16521339?v=4","gravatar_id":"","url":"https://api.github.com/users/clayjohn","html_url":"https://github.com/clayjohn","followers_url":"https://api.github.com/users/clayjohn/followers","following_url":"https://api.github.com/users/clayjohn/following{/other_user}","gists_url":"https://api.github.com/users/clayjohn/gists{/gist_id}","starred_url":"https://api.github.com/users/clayjohn/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/clayjohn/subscriptions","organizations_url":"https://api.github.com/users/clayjohn/orgs","repos_url":"https://api.github.com/users/clayjohn/repos","events_url":"https://api.github.com/users/clayjohn/events{/privacy}","received_events_url":"https://api.github.com/users/clayjohn/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-02-12T05:47:59Z","updated_at":"2025-02-12T05:47:59Z","body":"@etherealxx as a workaround you can disable texture compression on the generated lightmap ext file in the import settings. That will restore the behaviour of 4.3 and earlier. \n\n","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2652726078/reactions","total_count":3,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":3,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2652776073","html_url":"https://github.com/godotengine/godot/issues/102696#issuecomment-2652776073","issue_url":"https://api.github.com/repos/godotengine/godot/issues/102696","id":2652776073,"node_id":"IC_kwDOAO6SJc6eHiaJ","user":{"login":"etherealxx","id":64251396,"node_id":"MDQ6VXNlcjY0MjUxMzk2","avatar_url":"https://avatars.githubusercontent.com/u/64251396?v=4","gravatar_id":"","url":"https://api.github.com/users/etherealxx","html_url":"https://github.com/etherealxx","followers_url":"https://api.github.com/users/etherealxx/followers","following_url":"https://api.github.com/users/etherealxx/following{/other_user}","gists_url":"https://api.github.com/users/etherealxx/gists{/gist_id}","starred_url":"https://api.github.com/users/etherealxx/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/etherealxx/subscriptions","organizations_url":"https://api.github.com/users/etherealxx/orgs","repos_url":"https://api.github.com/users/etherealxx/repos","events_url":"https://api.github.com/users/etherealxx/events{/privacy}","received_events_url":"https://api.github.com/users/etherealxx/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-02-12T06:25:16Z","updated_at":"2025-02-13T07:47:24Z","body":"@clayjohn thanks, it works atleast for running the game with the baked lightmap. Btw as a note, **without** your workaround, if i export a game project with a baked lightmap to iOS with Mobile renderer (both vulkan and/or metal rendering device), it'll look pinkish like this on iPhone 12.\n\n![Image](https://github.com/user-attachments/assets/627239b0-7032-4cef-9946-01aaf3a3dd5c)\n\nDespite it looks fine when being ran from the editor on the Mac Mini on Mobile renderer","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2652776073/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2653167135","html_url":"https://github.com/godotengine/godot/issues/102696#issuecomment-2653167135","issue_url":"https://api.github.com/repos/godotengine/godot/issues/102696","id":2653167135,"node_id":"IC_kwDOAO6SJc6eJB4f","user":{"login":"BlueCube3310","id":53150244,"node_id":"MDQ6VXNlcjUzMTUwMjQ0","avatar_url":"https://avatars.githubusercontent.com/u/53150244?v=4","gravatar_id":"","url":"https://api.github.com/users/BlueCube3310","html_url":"https://github.com/BlueCube3310","followers_url":"https://api.github.com/users/BlueCube3310/followers","following_url":"https://api.github.com/users/BlueCube3310/following{/other_user}","gists_url":"https://api.github.com/users/BlueCube3310/gists{/gist_id}","starred_url":"https://api.github.com/users/BlueCube3310/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/BlueCube3310/subscriptions","organizations_url":"https://api.github.com/users/BlueCube3310/orgs","repos_url":"https://api.github.com/users/BlueCube3310/repos","events_url":"https://api.github.com/users/BlueCube3310/events{/privacy}","received_events_url":"https://api.github.com/users/BlueCube3310/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-02-12T09:47:25Z","updated_at":"2025-02-12T09:47:25Z","body":"> thanks, it works atleast for running the game with the baked lightmap. Btw as a note, **without** your workaround, if i export a game project with a baked lightmap to iOS with Mobile renderer (both vulkan and/or metal rendering device), it'll look pinkish like this on iPhone 14.\n> \n> ![Image](https://github.com/user-attachments/assets/627239b0-7032-4cef-9946-01aaf3a3dd5c)\n> \n> Despite it looks fine when being ran from the editor on the Mac Mini on Mobile renderer\n\nThis is most likely due to the fact that we now force ASTC to decode in the ldr color space, even for hdr textures, which causes hdr textures to break. This should be fixed by #102461","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2653167135/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2654052614","html_url":"https://github.com/godotengine/godot/issues/102696#issuecomment-2654052614","issue_url":"https://api.github.com/repos/godotengine/godot/issues/102696","id":2654052614,"node_id":"IC_kwDOAO6SJc6eMaEG","user":{"login":"darksylinc","id":3395130,"node_id":"MDQ6VXNlcjMzOTUxMzA=","avatar_url":"https://avatars.githubusercontent.com/u/3395130?v=4","gravatar_id":"","url":"https://api.github.com/users/darksylinc","html_url":"https://github.com/darksylinc","followers_url":"https://api.github.com/users/darksylinc/followers","following_url":"https://api.github.com/users/darksylinc/following{/other_user}","gists_url":"https://api.github.com/users/darksylinc/gists{/gist_id}","starred_url":"https://api.github.com/users/darksylinc/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/darksylinc/subscriptions","organizations_url":"https://api.github.com/users/darksylinc/orgs","repos_url":"https://api.github.com/users/darksylinc/repos","events_url":"https://api.github.com/users/darksylinc/events{/privacy}","received_events_url":"https://api.github.com/users/darksylinc/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-02-12T15:26:22Z","updated_at":"2025-02-12T15:26:22Z","body":"> This is most likely due to the fact that we now force ASTC to decode in the ldr color space, even for hdr textures, which causes hdr textures to break.\n\nThat's unlikely to be the reason: if I'm reading this correctly the problem is being reported for iOS. iOS uses MoltenVK, and MoltenVK does not provide `VK_EXT_astc_decode_mode` extension. And if using the native Metal backend, there is no such toggle either.","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2654052614/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2654101205","html_url":"https://github.com/godotengine/godot/issues/102696#issuecomment-2654101205","issue_url":"https://api.github.com/repos/godotengine/godot/issues/102696","id":2654101205,"node_id":"IC_kwDOAO6SJc6eMl7V","user":{"login":"darksylinc","id":3395130,"node_id":"MDQ6VXNlcjMzOTUxMzA=","avatar_url":"https://avatars.githubusercontent.com/u/3395130?v=4","gravatar_id":"","url":"https://api.github.com/users/darksylinc","html_url":"https://github.com/darksylinc","followers_url":"https://api.github.com/users/darksylinc/followers","following_url":"https://api.github.com/users/darksylinc/following{/other_user}","gists_url":"https://api.github.com/users/darksylinc/gists{/gist_id}","starred_url":"https://api.github.com/users/darksylinc/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/darksylinc/subscriptions","organizations_url":"https://api.github.com/users/darksylinc/orgs","repos_url":"https://api.github.com/users/darksylinc/repos","events_url":"https://api.github.com/users/darksylinc/events{/privacy}","received_events_url":"https://api.github.com/users/darksylinc/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-02-12T15:42:08Z","updated_at":"2025-02-12T16:28:23Z","body":"I shall point out that there is no `DATA_FORMAT_ASTC_4x4_HDR_BLOCK` in Godot (rendering_device_commons.h).\n\nThe Image class in core/io/image.h properly has HDR variants:\n - FORMAT_ASTC_4x4\n - FORMAT_ASTC_4x4_HDR\n - FORMAT_ASTC_8x8\n - FORMAT_ASTC_8x8_HDR\n\nBut `RenderingDeviceCommons::DataFormat` not having HDR ASTC formats is a big blocker to getting HDR ASTC running on Vulkan and Metal backends. It would only work in Compatibility (and Compatibility is broken on mac because Apple only offers minimum support)\n\n**Edit:** I'm putting up together a PR.\n**Edit 2:** The [PR is up](https://github.com/godotengine/godot/pull/102777).","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2654101205/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2654537255","html_url":"https://github.com/godotengine/godot/issues/102696#issuecomment-2654537255","issue_url":"https://api.github.com/repos/godotengine/godot/issues/102696","id":2654537255,"node_id":"IC_kwDOAO6SJc6eOQYn","user":{"login":"BlueCube3310","id":53150244,"node_id":"MDQ6VXNlcjUzMTUwMjQ0","avatar_url":"https://avatars.githubusercontent.com/u/53150244?v=4","gravatar_id":"","url":"https://api.github.com/users/BlueCube3310","html_url":"https://github.com/BlueCube3310","followers_url":"https://api.github.com/users/BlueCube3310/followers","following_url":"https://api.github.com/users/BlueCube3310/following{/other_user}","gists_url":"https://api.github.com/users/BlueCube3310/gists{/gist_id}","starred_url":"https://api.github.com/users/BlueCube3310/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/BlueCube3310/subscriptions","organizations_url":"https://api.github.com/users/BlueCube3310/orgs","repos_url":"https://api.github.com/users/BlueCube3310/repos","events_url":"https://api.github.com/users/BlueCube3310/events{/privacy}","received_events_url":"https://api.github.com/users/BlueCube3310/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-02-12T18:31:38Z","updated_at":"2025-02-12T18:31:38Z","body":"#102782 should fix this, I disabled bptc and astc when testing to ensure a similar scenario to this issue and it appears to work","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2654537255/reactions","total_count":3,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":2,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2676557762","html_url":"https://github.com/godotengi