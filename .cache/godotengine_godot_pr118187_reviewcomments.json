oBeWi/repos","events_url":"https://api.github.com/users/KoBeWi/events{/privacy}","received_events_url":"https://api.github.com/users/KoBeWi/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"It would be nice to also send the object in some form, but the `_popup_menu` only supports strings, so it's tricky. Maybe stringified ObjectID would work? (it's awkward though)","created_at":"2026-04-05T10:48:36Z","updated_at":"2026-04-05T10:49:29Z","html_url":"https://github.com/godotengine/godot/pull/118187#discussion_r3036711229","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/118187","_links":{"self":{"href":"https://api.github.com/repos/godotengine/godot/pulls/comments/3036711229"},"html":{"href":"https://github.com/godotengine/godot/pull/118187#discussion_r3036711229"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/118187"}},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/3036711229/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":null,"original_line":121,"side":"RIGHT","author_association":"MEMBER","original_position":5,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/3037112761","pull_request_review_id":4059663738,"id":3037112761,"node_id":"PRRC_kwDOAO6SJc61Bqm5","diff_hunk":"@@ -117,5 +117,8 @@\n \t\t\t[/codeblock]\n \t\t\tThe paths array is empty if there weren't any nodes under cursor. The option callback will receive a typed array of [CanvasItem] nodes.\n \t\t</constant>\n+\t\t<constant name=\"CONTEXT_SLOT_INSPECTOR_PROPERTY\" value=\"7\" enum=\"ContextMenuSlot\">\n+\t\t\tContext menu of the inspectors right-click menu. [method _popup_menu] will be called with the name of the clicked property, while option callback will receive the EditorProperty directly.","path":"doc/classes/EditorContextMenuPlugin.xml","commit_id":"c0edc5a4ab4d179372959f51f35b5b3221bbbb8d","original_commit_id":"869473b66f5540d432d25edfa60c343032cd6114","user":{"login":"SirLich","id":18729296,"node_id":"MDQ6VXNlcjE4NzI5Mjk2","avatar_url":"https://avatars.githubusercontent.com/u/18729296?v=4","gravatar_id":"","url":"https://api.github.com/users/SirLich","html_url":"https://github.com/SirLich","followers_url":"https://api.github.com/users/SirLich/followers","following_url":"https://api.github.com/users/SirLich/following{/other_user}","gists_url":"https://api.github.com/users/SirLich/gists{/gist_id}","starred_url":"https://api.github.com/users/SirLich/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/SirLich/subscriptions","organizations_url":"https://api.github.com/users/SirLich/orgs","repos_url":"https://api.github.com/users/SirLich/repos","events_url":"https://api.github.com/users/SirLich/events{/privacy}","received_events_url":"https://api.github.com/users/SirLich/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"There are two systems at play:\r\n\r\n1. `_popup_menu`, and it's argument (always a string list). This is used primarily to decide whether to show a menu item or not.\r\n2. The callback, which is fired when the item is clicked. This can send a single variant value I believe. Usually a list of *objects* that were clicked. \r\n\r\nIf you read the documentation for other CONTEXT_SLOT_* you will see that each of them handles this differently, by sending the best-possible data given the limitations. It feels like it's always a compromise. \r\n\r\nFor our particular case you could for example invent a format like [\"objectID:property_name\"], or since only a single property can be right-clicked at once, even something as crazy as [\"objectID\", \"property_name\"]. I view these as not desirable, since they both require parsing...\r\n\r\nIMO, it would be better if the argument passed to `_popup_menu` and the callback would somehow be aligned. It's weird that you can only gain access to the clicked object after it's been clicked. \r\n\r\nI view this as potentially of out-of-scope for this PR though? A proper fix would include deprecating `_popup_menu` and providing a new version with some different signature. Probably a dictionary of some kind.","created_at":"2026-04-05T17:14:09Z","updated_at":"2026-04-05T17:14:09Z","html_url":"https://github.com/godotengine/godot/pull/118187#discussion_r3037112761","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/118187","_links":{"self":{"href":"https://api.github.com/repos/godotengine/godot/pulls/comments/3037112761"},"html":{"href":"https://github.com/godotengine/godot/pull/118187#discussion_r3037112761"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/118187"}},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/3037112761/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":null,"original_line":121,"side":"RIGHT","in_reply_to_id":3036711229,"author_association":"CONTRIBUTOR","original_position":5,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/3037202444","pull_request_review_id":4059726571,"id":3037202444,"node_id":"PRRC_kwDOAO6SJc61CAgM","diff_hunk":"@@ -117,5 +117,8 @@\n \t\t\t[/codeblock]\n \t\t\tThe paths array is empty if there weren't any nodes under cursor. The option callback will receive a typed array of [CanvasItem] nodes.\n \t\t</constant>\n+\t\t<constant name=\"CONTEXT_SLOT_INSPECTOR_PROPERTY\" value=\"7\" enum=\"ContextMenuSlot\">\n+\t\t\tContext menu of the inspectors right-click menu. [method _popup_menu] will be called with the name of the clicked property, while option callback will receive the EditorProperty directly.","path":"doc/classes/EditorContextMenuPlugin.xml","commit_id":"c0edc5a4ab4d179372959f51f35b5b3221bbbb8d","original_commit_id":"869473b66f5540d432d25edfa60c343032cd6114","user":{"login":"KoBeWi","id":2223172,"node_id":"MDQ6VXNlcjIyMjMxNzI=","avatar_url":"https://avatars.githubusercontent.com/u/2223172?v=4","gravatar_id":"","url":"https://api.github.com/users/KoBeWi","html_url":"https://github.com/KoBeWi","followers_url":"https://api.github.com/users/KoBeWi/followers","following_url":"https://api.github.com/users/KoBeWi/following{/other_user}","gists_url":"https://api.github.com/users/KoBeWi/gists{/gist_id}","starred_url":"https://api.github.com/users/KoBeWi/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/KoBeWi/subscriptions","organizations_url":"https://api.github.com/users/KoBeWi/orgs","repos_url":"https://api.github.com/users/KoBeWi/repos","events_url":"https://api.github.com/users/KoBeWi/events{/privacy}","received_events_url":"https://api.github.com/users/KoBeWi/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"> even something as crazy as [\"objectID\", \"property_name\"]. I view these as not desirable, since they both require parsing...\r\n\r\nI mean, that wouldn't be this bad. At least it allows to know the object and property.\r\n\r\n> It's weird that you can only gain access to the clicked object after it's been clicked.\r\n\r\nEditorProperty also gives access to the object.","created_at":"2026-04-05T18:35:40Z","updated_at":"2026-04-05T18:35:40Z","html_url":"https://github.com/godotengine/godot/pull/118187#discussion_r3037202444","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/118187","_links":{"self":{"href":"https://api.github.com/repos/godotengine/godot/pulls/comments/3037202444"},"html":{"href":"https://github.com/godotengine/godot/pull/118187#discussion_r3037202444"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/118187"}},"reactions":{"url":"https://api.github.c