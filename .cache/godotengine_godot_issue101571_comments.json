nt.com/u/32321?v=4","gravatar_id":"","url":"https://api.github.com/users/fire","html_url":"https://github.com/fire","followers_url":"https://api.github.com/users/fire/followers","following_url":"https://api.github.com/users/fire/following{/other_user}","gists_url":"https://api.github.com/users/fire/gists{/gist_id}","starred_url":"https://api.github.com/users/fire/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/fire/subscriptions","organizations_url":"https://api.github.com/users/fire/orgs","repos_url":"https://api.github.com/users/fire/repos","events_url":"https://api.github.com/users/fire/events{/privacy}","received_events_url":"https://api.github.com/users/fire/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-01-15T18:41:42Z","updated_at":"2025-01-15T18:41:42Z","body":"This is a general thing, but how do we deal with things that may spam per frame, and the logging is worse than the bug?","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2593686876/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2594194801","html_url":"https://github.com/godotengine/godot/pull/101571#issuecomment-2594194801","issue_url":"https://api.github.com/repos/godotengine/godot/issues/101571","id":2594194801,"node_id":"IC_kwDOAO6SJc6aoEVx","user":{"login":"TokageItLab","id":61938263,"node_id":"MDQ6VXNlcjYxOTM4MjYz","avatar_url":"https://avatars.githubusercontent.com/u/61938263?v=4","gravatar_id":"","url":"https://api.github.com/users/TokageItLab","html_url":"https://github.com/TokageItLab","followers_url":"https://api.github.com/users/TokageItLab/followers","following_url":"https://api.github.com/users/TokageItLab/following{/other_user}","gists_url":"https://api.github.com/users/TokageItLab/gists{/gist_id}","starred_url":"https://api.github.com/users/TokageItLab/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/TokageItLab/subscriptions","organizations_url":"https://api.github.com/users/TokageItLab/orgs","repos_url":"https://api.github.com/users/TokageItLab/repos","events_url":"https://api.github.com/users/TokageItLab/events{/privacy}","received_events_url":"https://api.github.com/users/TokageItLab/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-01-16T00:17:59Z","updated_at":"2025-01-16T00:25:29Z","body":"Since validation occurs only at the timing of value set, this should only cause spam if you ignore the warning and continue to change the value of the joint settings. In other words, the warning will not occur frame by frame unless you keep changing the joint settings.\r\n\r\nHowever, if you have a chain of bones, warnings for all those joints may look like spam.\r\n\r\nSo when checking multiple axes at the same time, it might be bale to store a pair of setting and joints in a dictionary, so that we notify it in only one warning. However, I don't remember any other place in core that does that, so I don't know if I should do that.\r\n\r\nAt any rate, the possibility of spamming each frame does not occur in normal use, so I don't think there is any problem with merging as is.","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2594194801/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2597110391","html_url":"https://github.com/godotengine/godot/pull/101571#issuecomment-2597110391","issue_url":"https://api.github.com/repos/godotengine/godot/issues/101571","id":2597110391,"node_id":"IC_kwDOAO6SJc6azMJ3","user":{"login":"Repiteo","id":17489292,"node_id":"MDQ6VXNlcjE3NDg5Mjky","avatar_url":"https://avatars.githubusercontent.com/u/17489292?v=4","gravatar_id":"","url":"https://api.github.com/users/Repiteo","html_url":"https://github.com/Repiteo","followers_url":"https://api.github.com/users/Repiteo/followers","following_url":"https://api.github.com/users/Repiteo/following{/other_user}","gists_url":"https://api.github.com/users/Repiteo/gists{/gist_id}","starred_url":"https://api.github.com/users/Repiteo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Repiteo/subscriptions","organizations_url":"https://api.github.com/users/Repiteo/orgs","repos_url":"https://api.github.com/users/Repiteo/repos","events_url":"https://api.github.com/users/Repiteo/events{/privacy}","received_events_url":"https://api.github.com/users/Repiteo/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-01-16T23:24:41Z","updated_at":"2025-01-16T23:24:41Z","body":"Thanks!","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2597110391/reactions","total_count":1,"+1":0,"-1":0,"laugh":0,"hooray":1,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null}]