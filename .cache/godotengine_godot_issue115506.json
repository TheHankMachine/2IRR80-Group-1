ference the first script and access both signals\n5. there appears to be no difference in autocomplete\n\n### Minimal reproduction project (MRP)\n\n[MRP_signal_autocomplete.zip](https://github.com/user-attachments/files/24908035/MRP_signal_autocomplete.zip)","closed_by":{"login":"KoBeWi","id":2223172,"node_id":"MDQ6VXNlcjIyMjMxNzI=","avatar_url":"https://avatars.githubusercontent.com/u/2223172?v=4","gravatar_id":"","url":"https://api.github.com/users/KoBeWi","html_url":"https://github.com/KoBeWi","followers_url":"https://api.github.com/users/KoBeWi/followers","following_url":"https://api.github.com/users/KoBeWi/following{/other_user}","gists_url":"https://api.github.com/users/KoBeWi/gists{/gist_id}","starred_url":"https://api.github.com/users/KoBeWi/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/KoBeWi/subscriptions","organizations_url":"https://api.github.com/users/KoBeWi/orgs","repos_url":"https://api.github.com/users/KoBeWi/repos","events_url":"https://api.github.com/users/KoBeWi/events{/privacy}","received_events_url":"https://api.github.com/users/KoBeWi/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/115506/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/godotengine/godot/issues/115506/timeline","performed_via_github_app":null,"state_reason":"completed","pinned_comment":null}