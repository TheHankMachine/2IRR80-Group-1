odotengine/godot/issues/113673#issuecomment-3619879993","issue_url":"https://api.github.com/repos/godotengine/godot/issues/113673","id":3619879993,"node_id":"IC_kwDOAO6SJc7Xwvw5","user":{"login":"zhehangd","id":9572364,"node_id":"MDQ6VXNlcjk1NzIzNjQ=","avatar_url":"https://avatars.githubusercontent.com/u/9572364?v=4","gravatar_id":"","url":"https://api.github.com/users/zhehangd","html_url":"https://github.com/zhehangd","followers_url":"https://api.github.com/users/zhehangd/followers","following_url":"https://api.github.com/users/zhehangd/following{/other_user}","gists_url":"https://api.github.com/users/zhehangd/gists{/gist_id}","starred_url":"https://api.github.com/users/zhehangd/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/zhehangd/subscriptions","organizations_url":"https://api.github.com/users/zhehangd/orgs","repos_url":"https://api.github.com/users/zhehangd/repos","events_url":"https://api.github.com/users/zhehangd/events{/privacy}","received_events_url":"https://api.github.com/users/zhehangd/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-12-06T10:31:53Z","updated_at":"2025-12-06T10:31:53Z","body":"Can/should there be a function that can be called to explicitly request a redraw? Otherwise for example animated compositor effects (I am working with animated volumetric clouds) cannot work properly without some humorous hacks (e.g. placing a forever-moving invisible mesh instance in the nscene).","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3619879993/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3619881379","html_url":"https://github.com/godotengine/godot/issues/113673#issuecomment-3619881379","issue_url":"https://api.github.com/repos/godotengine/godot/issues/113673","id":3619881379,"node_id":"IC_kwDOAO6SJc7XwwGj","user":{"login":"AThousandShips","id":96648715,"node_id":"U_kgDOBcK-Cw","avatar_url":"https://avatars.githubusercontent.com/u/96648715?v=4","gravatar_id":"","url":"https://api.github.com/users/AThousandShips","html_url":"https://github.com/AThousandShips","followers_url":"https://api.github.com/users/AThousandShips/followers","following_url":"https://api.github.com/users/AThousandShips/following{/other_user}","gists_url":"https://api.github.com/users/AThousandShips/gists{/gist_id}","starred_url":"https://api.github.com/users/AThousandShips/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/AThousandShips/subscriptions","organizations_url":"https://api.github.com/users/AThousandShips/orgs","repos_url":"https://api.github.com/users/AThousandShips/repos","events_url":"https://api.github.com/users/AThousandShips/events{/privacy}","received_events_url":"https://api.github.com/users/AThousandShips/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-12-06T10:33:04Z","updated_at":"2025-12-06T10:33:04Z","body":"Not sure, but you can just change the setting to make it redraw like the game, at the cost of performance ","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3619881379/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3621507728","html_url":"https://github.com/godotengine/godot/issues/113673#issuecomment-3621507728","issue_url":"https://api.github.com/repos/godotengine/godot/issues/113673","id":3621507728,"node_id":"IC_kwDOAO6SJc7X29KQ","user":{"login":"zhehangd","id":9572364,"node_id":"MDQ6VXNlcjk1NzIzNjQ=","avatar_url":"https://avatars.githubusercontent.com/u/9572364?v=4","gravatar_id":"","url":"https://api.github.com/users/zhehangd","html_url":"https://github.com/zhehangd","followers_url":"https://api.github.com/users/zhehangd/followers","following_url":"https://api.github.com/users/zhehangd/following{/other_user}","gists_url":"https://api.github.com/users/zhehangd/gists{/gist_id}","starred_url":"https://api.github.com/users/zhehangd/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/zhehangd/subscriptions","organizations_url":"https://api.github.com/users/zhehangd/orgs","repos_url":"https://api.github.com/users/zhehangd/repos","events_url":"https://api.github.com/users/zhehangd/events{/privacy}","received_events_url":"https://api.github.com/users/zhehangd/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-12-07T02:31:28Z","updated_at":"2025-12-07T02:48:45Z","body":"It looks like `RenderingServerDefault::redraw_request()` is what the engine uses to mark a change. However this is not a public function for GDScript to call. I wonder if we can expose this function. I can't think of any drawback of doing so, at least it shouldn't be more dangerous or less useful than `force_draw()`.\n\nHm.. why `redraw_request` is a static function (and the only one in `RenderingServerDefault`)? It does not make sense to me.","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3621507728/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3621830836","html_url":"https://github.com/godotengine/godot/issues/113673#issuecomment-3621830836","issue_url":"https://api.github.com/repos/godotengine/godot/issues/113673","id":3621830836,"node_id":"IC_kwDOAO6SJc7X4MC0","user":{"login":"AThousandShips","id":96648715,"node_id":"U_kgDOBcK-Cw","avatar_url":"https://avatars.githubusercontent.com/u/96648715?v=4","gravatar_id":"","url":"https://api.github.com/users/AThousandShips","html_url":"https://github.com/AThousandShips","followers_url":"https://api.github.com/users/AThousandShips/followers","following_url":"https://api.github.com/users/AThousandShips/following{/other_user}","gists_url":"https://api.github.com/users/AThousandShips/gists{/gist_id}","starred_url":"https://api.github.com/users/AThousandShips/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/AThousandShips/subscriptions","organizations_url":"https://api.github.com/users/AThousandShips/orgs","repos_url":"https://api.github.com/users/AThousandShips/repos","events_url":"https://api.github.com/users/AThousandShips/events{/privacy}","received_events_url":"https://api.github.com/users/AThousandShips/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-12-07T08:51:51Z","updated_at":"2025-12-07T08:51:51Z","body":"You can probably just do `queue_redraw` on the editor interface or a plugin, not sure though, but I don't think there's a bug here, and figuring out how to achieve what you want is something to discuss in the [other community channels](https://godotengine.org/community/)","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3621830836/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3621849035","html_url":"https://github.com/godotengine/godot/issues/113673#issuecomment-3621849035","issue_url":"https://api.github.com/repos/godotengine/godot/issues/113673","id":3621849035,"node_id":"IC_kwDOAO6SJc7X4QfL","user":{"login":"zhehangd","id":9572364,"node_id":"MDQ6VXNlcjk1NzIzNjQ=","avatar_url":"https://avatars.githubusercontent.com/u/9572364?v=4","gravatar_id":"","url":"https://api.github.com/users/zhehangd","html_url":"https://github.com/zhehangd","followers_url":"https://api.github.com/users/zhehangd/followers","following_url":"https://api.github.com/users/zhehangd/following{/other_user}","gists_url":"https://api.github.com/users/zhehangd/gists{/gist_id}","starred_url":"https://api.github.com/users/zhehangd/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/zhehangd/subscriptions","organizations_url":"https://api.github.com/users/zhehangd/orgs","repos_url":"https://api.github.com/users/zhehangd/repos","events_url":"https://api.github.com/users/zhehangd/events{/privacy}","received_events_url":"https://api.github.com/users/zhehangd/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-12-07T09:18:20Z","updated_at":"2025-12-07T09:18:20Z","body":"I agree that this is not a bug and the engine has a very good reason to behave like this. I am just thinking that if the engine is missing some functions for users to fully utilize compositor effects. There are certainly many ways to trigger a redraw, but they are essentially workarounds, not the logically right way. Overusing hacks is not good for Godot in the long run, we should avoid it while we can.\n","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3621849035/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3621851605","html_url":"https://github.com/godotengine/godot/issues/113673#issuecomment-3621851605","issue_url":"https://api.github.com/repos/godotengine/godot/issues/113673","id":3621851605,"node_id":"IC_kwDOAO6SJc7X4RHV","user":{"login":"AThousandShips","id":96648715,"node_id":"U_kgDOBcK-Cw","avatar_url":"https://avatars.githubusercon