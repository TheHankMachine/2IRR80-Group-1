-d0e335004915\" />\n\n[inspector-dict.zip](https://github.com/user-attachments/files/22244676/inspector-dict.zip)","closed_by":{"login":"ajreckof","id":66184050,"node_id":"MDQ6VXNlcjY2MTg0MDUw","avatar_url":"https://avatars.githubusercontent.com/u/66184050?v=4","gravatar_id":"","url":"https://api.github.com/users/ajreckof","html_url":"https://github.com/ajreckof","followers_url":"https://api.github.com/users/ajreckof/followers","following_url":"https://api.github.com/users/ajreckof/following{/other_user}","gists_url":"https://api.github.com/users/ajreckof/gists{/gist_id}","starred_url":"https://api.github.com/users/ajreckof/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/ajreckof/subscriptions","organizations_url":"https://api.github.com/users/ajreckof/orgs","repos_url":"https://api.github.com/users/ajreckof/repos","events_url":"https://api.github.com/users/ajreckof/events{/privacy}","received_events_url":"https://api.github.com/users/ajreckof/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/110368/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/godotengine/godot/issues/110368/timeline","performed_via_github_app":null,"state_reason":"duplicate","pinned_comment":null}