groud/followers","following_url":"https://api.github.com/users/groud/following{/other_user}","gists_url":"https://api.github.com/users/groud/gists{/gist_id}","starred_url":"https://api.github.com/users/groud/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/groud/subscriptions","organizations_url":"https://api.github.com/users/groud/orgs","repos_url":"https://api.github.com/users/groud/repos","events_url":"https://api.github.com/users/groud/events{/privacy}","received_events_url":"https://api.github.com/users/groud/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-06-26T12:13:42Z","updated_at":"2025-06-26T12:13:42Z","body":"Aside from the small nitpick above and CI not passing (looks unrelated to your change though, so you might just have to rebase on latest master), it looks good to me!","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3008276866/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3037932195","html_url":"https://github.com/godotengine/godot/pull/107969#issuecomment-3037932195","issue_url":"https://api.github.com/repos/godotengine/godot/issues/107969","id":3037932195,"node_id":"IC_kwDOAO6SJc61Eyqj","user":{"login":"chocola-mint","id":56677134,"node_id":"MDQ6VXNlcjU2Njc3MTM0","avatar_url":"https://avatars.githubusercontent.com/u/56677134?v=4","gravatar_id":"","url":"https://api.github.com/users/chocola-mint","html_url":"https://github.com/chocola-mint","followers_url":"https://api.github.com/users/chocola-mint/followers","following_url":"https://api.github.com/users/chocola-mint/following{/other_user}","gists_url":"https://api.github.com/users/chocola-mint/gists{/gist_id}","starred_url":"https://api.github.com/users/chocola-mint/starred{/owner}{/r