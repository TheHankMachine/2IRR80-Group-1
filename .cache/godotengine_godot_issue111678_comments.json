 and the error did not occur.\n\nThere may be other triggers, but I couldn't identify them yet.\n\n","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3550437755/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3573723419","html_url":"https://github.com/godotengine/godot/issues/111678#issuecomment-3573723419","issue_url":"https://api.github.com/repos/godotengine/godot/issues/111678","id":3573723419,"node_id":"IC_kwDOAO6SJc7VArEb","user":{"login":"adamscott","id":270928,"node_id":"MDQ6VXNlcjI3MDkyOA==","avatar_url":"https://avatars.githubusercontent.com/u/270928?v=4","gravatar_id":"","url":"https://api.github.com/users/adamscott","html_url":"https://github.com/adamscott","followers_url":"https://api.github.com/users/adamscott/followers","following_url":"https://api.github.com/users/adamscott/following{/other_user}","gists_url":"https://api.github.com/users/adamscott/gists{/gist_id}","starred_url":"https://api.github.com/users/adamscott/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/adamscott/subscriptions","organizations_url":"https://api.github.com/users/adamscott/orgs","repos_url":"https://api.github.com/users/adamscott/repos","events_url":"https://api.github.com/users/adamscott/events{/privacy}","received_events_url":"https://api.github.com/users/adamscott/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-11-25T04:22:02Z","updated_at":"2025-11-25T04:22:02Z","body":"I'm having this same issue when opening https://github.com/100-Devs-1-Game/Sixwaystosuffer in Compatibility mode on my Mac. (running on master)\nGodot v4.6.dev (9fa0af2af) - macOS Tahoe (26.2.0) - Multi-window, 1 monitor - OpenGL 3 (Compatibility) - Apple M3 Max - Apple M3 Max (16 threa