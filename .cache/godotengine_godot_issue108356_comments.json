s","organizations_url":"https://api.github.com/users/fire/orgs","repos_url":"https://api.github.com/users/fire/repos","events_url":"https://api.github.com/users/fire/events{/privacy}","received_events_url":"https://api.github.com/users/fire/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-08-04T14:51:58Z","updated_at":"2025-08-04T14:52:41Z","body":"Saw https://github.com/KhronosGroup/glTF-Blender-IO/issues/2554 discussion on some channels.","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3151113163/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3192379712","html_url":"https://github.com/godotengine/godot/pull/108356#issuecomment-3192379712","issue_url":"https://api.github.com/repos/godotengine/godot/issues/108356","id":3192379712,"node_id":"IC_kwDOAO6SJc6-R9lA","user":{"login":"neonmoe","id":22432472,"node_id":"MDQ6VXNlcjIyNDMyNDcy","avatar_url":"https://avatars.githubusercontent.com/u/22432472?v=4","gravatar_id":"","url":"https://api.github.com/users/neonmoe","html_url":"https://github.com/neonmoe","followers_url":"https://api.github.com/users/neonmoe/followers","following_url":"https://api.github.com/users/neonmoe/following{/other_user}","gists_url":"https://api.github.com/users/neonmoe/gists{/gist_id}","starred_url":"https://api.github.com/users/neonmoe/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/neonmoe/subscriptions","organizations_url":"https://api.github.com/users/neonmoe/orgs","repos_url":"https://api.github.com/users/neonmoe/repos","events_url":"https://api.github.com/users/neonmoe/events{/privacy}","received_events_url":"https://api.github.com/users/neonmoe/received_events","type":"User","user_view_type":"public","site_admin":false},"create