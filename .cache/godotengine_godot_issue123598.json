_at":null,"archived_by":null},{"id":955079684,"node_id":"MDU6TGFiZWw5NTUwNzk2ODQ=","url":"https://api.github.com/repos/godotengine/godot/labels/breaks%20compat","name":"breaks compat","color":"b64245","default":false,"description":"","archived_at":null,"archived_by":null},{"id":1732720779,"node_id":"MDU6TGFiZWwxNzMyNzIwNzc5","url":"https://api.github.com/repos/godotengine/godot/labels/topic:gui","name":"topic:gui","color":"ffee88","default":false,"description":"","archived_at":null,"archived_by":null}],"state":"open","locked":false,"assignees":[],"milestone":{"url":"https://api.github.com/repos/godotengine/godot/milestones/16","html_url":"https://github.com/godotengine/godot/milestone/16","labels_url":"https://api.github.com/repos/godotengine/godot/milestones/16/labels","id":8237783,"node_id":"MI_kwDOAO6SJc4AfbLX","number":16,"title":"4.x","description":"Issues and pull requests slated for an undetermined Godot 4 release.","creator":{"login":"akien-mga","id":4701338,"node_id":"MDQ6VXNlcjQ3MDEzMzg=","avatar_url":"https://avatars.githubusercontent.com/u/4701338?v=4","gravatar_id":"","url":"https://api.github.com/users/akien-mga","html_url":"https://github.com/akien-mga","followers_url":"https://api.github.com/users/akien-mga/followers","following_url":"https://api.github.com/users/akien-mga/following{/other_user}","gists_url":"https://api.github.com/users/akien-mga/gists{/gist_id}","starred_url":"https://api.github.com/users/akien-mga/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/akien-mga/subscriptions","organizations_url":"https://api.github.com/users/akien-mga/orgs","repos_url":"https://api.github.com/users/akien-mga/repos","events_url":"https://api.github.com/users/akien-mga/events{/privacy}","received_events_url":"https://api.github.com/users/akien-mga/received_events","type":"User","user_view_type":"public","site_admin":false},"open_issues":5790,"closed_issues":0,"state":"open","created_at":"2022-07-26T12:42:05Z","updated_at":"2026-10-22T08:16:48Z","due_on":null,"closed_at":null},"comments":3,"created_at":"2026-09-18T08:15:29Z","updated_at":"2026-09-18T17:08:10Z","closed_at":null,"assignee":null,"author_association":"CONTRIBUTOR","issue_field_values":[],"type":null,"active_lock_reason":null,"draft":false,"pull_request":{"url":"https://api.github.com/repos/godotengine/godot/pulls/123598","html_url":"https://github.com/godotengine/godot/pull/123598","diff_url":"https://github.com/godotengine/godot/pull/123598.diff","patch_url":"https://github.com/godotengine/godot/pull/123598.patch","merged_at":null},"body":"Improved the wording in all text-drawing related documentation and clarified several confusing things.\r\n\r\nHighlights:\r\n\r\n- Improved wording overall, fixed some clear-cut language mistakes.\r\n- `width == 0` means text is drawn without clipping, this was previously wrong in a few places and I fixed it.\r\n- Fixed TextLine's outline drawing method being a copy-paste of its corresponding text drawing method.\r\n- Clarified on all text outline drawing methods that they are typically used before their corresponding text drawing methods. Not drawing in this order results in the outline eating into the text, which can be hard to notice if it's small, so I believe this is important to mention here (as opposed to just \"See also [other method]\").\r\n- Referenced some relevant methods where appropriate.\r\n- Renamed `size` to `outline_size`. This was already used in TextLine and TextParagraph, as otherwise it's really unclear what a parameter with such a generic name does on methods that can have 10+ parameters - especially when just using method completion hints.\r\n- Renamed `pos` parameters to `position` throughout. `pos` was only used for these methods, and it makes the description feel distracting and awkward when you try to use it as a word.\r\n- Renamed `dc_color` to `dropcap_color`, I've not used these methods but I understood what they do, and this parameter name still confused me so much I had to look at the code.\r\n\r\nI tried to maintain a reasonable scope, I could go on and standardize more related things but it would blow out of proportion. I'm mostly just wondering now why the parameter for specifying the color of the text drawn is called `modulate`, except in TextLine and TextParagraph where it's `color`.\r\n\r\nCloses https://github.com/godotengine/godot-proposals/issues/15524","closed_by":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/123598/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/godotengine/godot/issues/123598/timeline","performed_via_github_app":null,"state_reason":null}