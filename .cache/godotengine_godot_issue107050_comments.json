[{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2936224951","html_url":"https://github.com/godotengine/godot/issues/107050#issuecomment-2936224951","issue_url":"https://api.github.com/repos/godotengine/godot/issues/107050","id":2936224951,"node_id":"IC_kwDOAO6SJc6vAzy3","user":{"login":"kitbdev","id":10054226,"node_id":"MDQ6VXNlcjEwMDU0MjI2","avatar_url":"https://avatars.githubusercontent.com/u/10054226?v=4","gravatar_id":"","url":"https://api.github.com/users/kitbdev","html_url":"https://github.com/kitbdev","followers_url":"https://api.github.com/users/kitbdev/followers","following_url":"https://api.github.com/users/kitbdev/following{/other_user}","gists_url":"https://api.github.com/users/kitbdev/gists{/gist_id}","starred_url":"https://api.github.com/users/kitbdev/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/kitbdev/subscriptions","organizations_url":"https://api.github.com/users/kitbdev/orgs","repos_url":"https://api.github.com/users/kitbdev/repos","events_url":"https://api.github.com/users/kitbdev/events{/privacy}","received_events_url":"https://api.github.com/users/kitbdev/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-06-03T16:29:08Z","updated_at":"2025-06-03T16:29:08Z","body":"It is intentional that it adjusts the viewport until it is in view instead of centers it. If you need to center it, you can use `center_viewport_to_caret` instead.\nThe documentation should be updated to reflect the actual behavior.","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2936224951/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2936872641","html_url":"https://github.com/godotengine/godot/issues/107050#issuecomment-2936872641","issue_url":"https://api.github.com/repos/godotengine/godot/issues/107050","id":2936872641,"node_id":"IC_kwDOAO6SJc6vDR7B","user":{"login":"Novark","id":8756569,"node_id":"MDQ6VXNlcjg3NTY1Njk=","avatar_url":"https://avatars.githubusercontent.com/u/8756569?v=4","gravatar_id":"","url":"https://api.github.com/users/Novark","html_url":"https://github.com/Novark","followers_url":"https://api.github.com/users/Novark/followers","following_url":"https://api.github.com/users/Novark/following{/other_user}","gists_url":"https://api.github.com/users/Novark/gists{/gist_id}","starred_url":"https://api.github.com/users/Novark/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Novark/subscriptions","organizations_url":"https://api.github.com/users/Novark/orgs","repos_url":"https://api.github.com/users/Novark/repos","events_url":"https://api.github.com/users/Novark/events{/privacy}","received_events_url":"https://api.github.com/users/Novark/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-06-03T19:32:16Z","updated_at":"2025-06-03T19:32:16Z","body":"> It is intentional that it adjusts the viewport until it is in view instead of centers it. If you need to center it, you can use `center_viewport_to_caret` instead. The documentation should be updated to reflect the actual behavior.\n\nI had no idea this was a thing!  Not sure how I didn't come across this while searching for a solution to my problem.\n\nI agree it would be helpful to mention the expected behaviour in the documentation - along with a reference to `center_viewport_to_caret`, since I think it would be a common desired behaviour when calling `set_caret_line` with `adjust_viewport = true`.  I'll leave this issue open so that it can be tracked as a documentation issue.\n\nThank you for the clarification and further info!","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2936872641/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null}]