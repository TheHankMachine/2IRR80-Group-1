_at":null,"archived_by":null}],"state":"open","locked":false,"assignees":[],"milestone":{"url":"https://api.github.com/repos/godotengine/godot/milestones/25","html_url":"https://github.com/godotengine/godot/milestone/25","labels_url":"https://api.github.com/repos/godotengine/godot/milestones/25/labels","id":15520464,"node_id":"MI_kwDOAO6SJc4A7NLQ","number":25,"title":"4.8","description":"","creator":{"login":"Repiteo","id":17489292,"node_id":"MDQ6VXNlcjE3NDg5Mjky","avatar_url":"https://avatars.githubusercontent.com/u/17489292?v=4","gravatar_id":"","url":"https://api.github.com/users/Repiteo","html_url":"https://github.com/Repiteo","followers_url":"https://api.github.com/users/Repiteo/followers","following_url":"https://api.github.com/users/Repiteo/following{/other_user}","gists_url":"https://api.github.com/users/Repiteo/gists{/gist_id}","starred_url":"https://api.github.com/users/Repiteo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Repiteo/subscriptions","organizations_url":"https://api.github.com/users/Repiteo/orgs","repos_url":"https://api.github.com/users/Repiteo/repos","events_url":"https://api.github.com/users/Repiteo/events{/privacy}","received_events_url":"https://api.github.com/users/Repiteo/received_events","type":"User","user_view_type":"public","site_admin":false},"open_issues":343,"closed_issues":2335,"state":"open","created_at":"2026-04-13T15:59:35Z","updated_at":"2026-10-22T06:28:22Z","due_on":null,"closed_at":null},"comments":9,"created_at":"2026-05-26T11:55:48Z","updated_at":"2026-07-20T16:04:03Z","closed_at":null,"assignee":null,"author_association":"CONTRIBUTOR","issue_field_values":[],"type":null,"active_lock_reason":null,"draft":false,"pull_request":{"url":"https://api.github.com/repos/godotengine/godot/pulls/119780","html_url":"https://github.com/godotengine/godot/pull/119780","diff_url":"https://github.com/godotengine/godot/pull/119780.diff","patch_url":"https://github.com/godotengine/godot/pull/119780.patch","merged_at":null},"body":"## Summary\r\n\r\n- `ExceptionUtils.LogException` now always calls `GD.PushError` after optionally sending to the script debugger, matching `LogUnhandledException`.\r\n- Fixes caught C# exceptions not appearing in `OS.add_logger()` custom loggers, file logging, or the standard `OS.print_error` pipeline during editor play when the script debugger is active.\r\n\r\n## Problem\r\n\r\nWhen the script debugger is active (typical editor run), caught C# exceptions were sent only via `godotsharp_internal_script_debugger_send_error` → `RemoteDebugger::send_error`. They never went through `GD.PushError` → `_err_print_error` → `OS::print_error`, so custom loggers and project file logging did not see them. The editor debugger UI still showed them.\r\n\r\nPreviously, `GD.PushError` ran only in the `else` branch (debugger inactive).\r\n\r\n## Solution\r\n\r\nAlways call `GD.PushError(e.ToString())` after `SendToScriptDebugger`, same pattern as `LogUnhandledException`.\r\n\r\n\r\nCloses: https://github.com/godotengine/godot/issues/115283\r\nCloses: https://github.com/godotengine/godot/issues/54389\r\n","closed_by":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/119780/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/godotengine/godot/issues/119780/timeline","performed_via_github_app":null,"state_reason":null}