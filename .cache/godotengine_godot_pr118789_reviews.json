.com/users/TokageItLab/following{/other_user}","gists_url":"https://api.github.com/users/TokageItLab/gists{/gist_id}","starred_url":"https://api.github.com/users/TokageItLab/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/TokageItLab/subscriptions","organizations_url":"https://api.github.com/users/TokageItLab/orgs","repos_url":"https://api.github.com/users/TokageItLab/repos","events_url":"https://api.github.com/users/TokageItLab/events{/privacy}","received_events_url":"https://api.github.com/users/TokageItLab/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"That should be fine for the most part. It should be documented that Observers are available (such as link and sample code) in the extension classes of AnimationNodes that support Observers.\r\n\r\nSince we are currently in feature freeze for 4.7, we will review this later at the AnimationMeeting as scope for 4.8.","state":"COMMENTED","html_url":"https://github.com/godotengine/godot/pull/118789#pullrequestreview-4173520785","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/118789","author_association":"MEMBER","_links":{"html":{"href":"https://github.com/godotengine/godot/pull/118789#pullrequestreview-4173520785"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/118789"}},"submitted_at":"2026-04-24T21:31:26Z","commit_id":"564a34f1ff4dda93eff8972f787ff377e0c2ac60"},{"id":4294409757,"node_id":"PRR_kwDOAO6SJc7_934d","user":{"login":"TokageItLab","id":61938263,"node_id":"MDQ6VXNlcjYxOTM4MjYz","avatar_url":"https://avatars.githubusercontent.com/u/61938263?u=9b90963f1b4f17720e50bbbe495fbe8c84c8bc8e&v=4","gravatar_id":"","url":"https://api.github.com/users/TokageItLab","html_url":"https://github.com/TokageItLab","followers_url":"https://api.github.com/users/TokageItLab/followers","following_url":"https://api.github.com/users/TokageItLab/following{/other_user}","gists_url":"https://api.github.com/users/TokageItLab/gists{/gist_id}","starred_url":"https://api.github.com/users/TokageItLab/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/TokageItLab/subscriptions","organizations_url":"https://api.github.com/users/TokageItLab/orgs","repos_url":"https://api.github.com/users/TokageItLab/repos","events_url":"https://api.github.com/users/TokageItLab/events{/privacy}","received_events_url":"https://api.github.com/users/TokageItLab/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"","state":"COMMENTED","html_url":"https://github.com/godotengine/godot/pull/118789#pullrequestreview-4294409757","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/118789","author_association":"MEMBER","_links":{"html":{"href":"https://github.com/godotengine/godot/pull/118789#pullrequestreview-4294409757"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/118789"}},"submitted_at":"2026-05-15T00:30:23Z","commit_id":"46e1c6bdf578c89b17cd011a8e64546d2350a9f0"},{"id":4835375253,"node_id":"PRR_kwDOAO6SJc8AAAABIDX4lQ","user":{"login":"lyuma","id":39946030,"node_id":"MDQ6VXNlcjM5OTQ2MDMw","avatar_url":"https://avatars.githubusercontent.com/u/39946030?v=4","gravatar_id":"","url":"https://api.github.com/users/lyuma","html_url":"https://github.com/lyuma","followers_url":"https://api.github.com/users/lyuma/followers","following_url":"https://api.github.com/users/lyuma/following{/other_user}","gists_url":"https://api.github.com/users/lyuma/gists{/gist_id}","starred_url":"https://api.github.com/users/lyuma/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/lyuma/subscriptions","organizations_url":"https://api.github.com/users/lyuma/orgs","repos_url":"https://api.github.com/users/lyuma/repos","events_url":"https://api.github.com/users/lyuma/events{/privacy}","received_events_url":"https://api.github.com/users/lyuma/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"At the Animation meeting, we all agree on having functionality and the design of the observer pattern. Using a Resource type to hold Signals seems good.\n\nThe next step is to so testing ane make some demo project.\n\nI also raised a question of maybe passing the AnimationNode as a signal parameter, so you can reuse the same observer object for more than one node. Right now you need to create a new observer instance for each node since you have no way to bind a different signal for each node otherwise","state":"COMMENTED","html_url":"https://github.com/godotengine/godot/pull/118789#pullrequestreview-4835375253","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/118789","author_association":"CONTRIBUTOR","_links":{"html":{"href":"https://github.com/godotengine/godot/pull/118789#pullrequestreview-4835375253"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/118789"}},"submitted_at":"2026-08-01T18:27:23Z","commit_id":"97527df99d73f230a6e9e0c0603153118a3210f7"},{"id":5000763120,"node_id":"PRR_kwDOAO6SJc8AAAABKhGW8A","user":{"login":"lyuma","id":39946030,"node_id":"MDQ6VXNlcjM5OTQ2MDMw","avatar_url":"https://avatars.githubusercontent.com/u/39946030?v=4","gravatar_id":"","url":"https://api.github.com/users/lyuma","html_url":"https://github.com/lyuma","followers_url":"https://api.github.com/users/lyuma/followers","following_url":"https://api.github.com/users/lyuma/following{/other_user}","gists_url":"https://api.github.com/users/lyuma/gists{/gist_id}","starred_url":"https://api.github.com/users/lyuma/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/lyuma/subscriptions","organizations_url":"https://api.github.com/users/lyuma/orgs","repos_url":"https://api.github.com/users/lyuma/repos","events_url":"https://api.github.com/users/lyuma/events{/privacy}","received_events_url":"https://api.github.com/users/lyuma/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"We approved this in the meeting.\n\nI was worried that the BlendSpace `closest_point_changed` is only correct for the Discrete blend mode, but Tokage's test project looks good.\n\nMy other concern was if we want to change the signal callbacks to have more arguments like the \"reason\" field in the original proposal. However, these APIs are marked as experimental, so I feel better about being able to change them in the future based on feedback.\n\nThere was an issue raised that signals are single threaded, but currently the whole AnimationTree runs on a single thread, so I do not anticipate this being an issue.\n\n> This is because you can modify other animation nodes before the animation is applied. Even if you manage to get the “closest” node, changing that animation won't take effect until the next frame. That's why it needs to be a signal. ","state":"APPROVED","html_url":"https://github.com/godotengine/godot/pull/118789#pullrequestreview-5000763120","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/118789","author_association":"CONTRIBUTOR","_links":{"html":{"href":"https://github.com/godotengine/godot/pull/118789#pullrequestreview-5000763120"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/118789"}},"submitted_at":"2026-08-22T18:14:28Z","commit_id":"97527df99d73f230a6e9e0c0603153118a3210f7"}]