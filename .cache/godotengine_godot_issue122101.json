:null},{"id":8133949121,"node_id":"LA_kwDOAO6SJc8AAAAB5NI2wQ","url":"https://api.github.com/repos/godotengine/godot/labels/topic:i18n","name":"topic:i18n","color":"ffee88","default":false,"description":"","archived_at":null,"archived_by":null}],"state":"closed","locked":false,"assignees":[],"milestone":{"url":"https://api.github.com/repos/godotengine/godot/milestones/25","html_url":"https://github.com/godotengine/godot/milestone/25","labels_url":"https://api.github.com/repos/godotengine/godot/milestones/25/labels","id":15520464,"node_id":"MI_kwDOAO6SJc4A7NLQ","number":25,"title":"4.8","description":"","creator":{"login":"Repiteo","id":17489292,"node_id":"MDQ6VXNlcjE3NDg5Mjky","avatar_url":"https://avatars.githubusercontent.com/u/17489292?v=4","gravatar_id":"","url":"https://api.github.com/users/Repiteo","html_url":"https://github.com/Repiteo","followers_url":"https://api.github.com/users/Repiteo/followers","following_url":"https://api.github.com/users/Repiteo/following{/other_user}","gists_url":"https://api.github.com/users/Repiteo/gists{/gist_id}","starred_url":"https://api.github.com/users/Repiteo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Repiteo/subscriptions","organizations_url":"https://api.github.com/users/Repiteo/orgs","repos_url":"https://api.github.com/users/Repiteo/repos","events_url":"https://api.github.com/users/Repiteo/events{/privacy}","received_events_url":"https://api.github.com/users/Repiteo/received_events","type":"User","user_view_type":"public","site_admin":false},"open_issues":343,"closed_issues":2335,"state":"open","created_at":"2026-04-13T15:59:35Z","updated_at":"2026-10-22T06:28:22Z","due_on":null,"closed_at":null},"comments":3,"created_at":"2026-08-04T21:15:10Z","updated_at":"2026-08-05T15:03:56Z","closed_at":"2026-08-05T14:52:34Z","assignee":null,"author_association":"MEMBER","issue_field_values":[],"type":null,"active_lock_reason":null,"draft":false,"pull_request":{"url":"https://api.github.com/repos/godotengine/godot/pulls/122101","html_url":"https://github.com/godotengine/godot/pull/122101","diff_url":"https://github.com/godotengine/godot/pull/122101.diff","patch_url":"https://github.com/godotengine/godot/pull/122101.patch","merged_at":"2026-08-05T14:52:34Z"},"body":"Ever since the dawn of time of this repository, errors sent by GDScript's utility functions (`range`, `ord`, `len`, etc.) were made to be translated, and thus appear on Weblate like any other string.\r\nAcross the whole engine, this has been a huge exception and quite the oddity.\r\nThese kinds of errors are never, ever translated. Imagine changing the language of a game and the errors in the log also being in a whole other language. Contrary to what it may seem, it makes troubleshooting and asking for assistance much harder.\r\n\r\nThis PR removes the `RTR` macro from around these messages, and also tweaks them slightly while at it.\r\n\r\nSee also the [remark on RocketChat](https://chat.godotengine.org/channel/translation?msg=HyWKZXNNkQyrEBXs8):\r\n> but yeah, they shouldn't be translated. We don't translate stuff that's printed to console, only what appears in the UI\r\n\r\nI'm surprised no one noticed or cared until now. It's weird.","closed_by":{"login":"Repiteo","id":17489292,"node_id":"MDQ6VXNlcjE3NDg5Mjky","avatar_url":"https://avatars.githubusercontent.com/u/17489292?v=4","gravatar_id":"","url":"https://api.github.com/users/Repiteo","html_url":"https://github.com/Repiteo","followers_url":"https://api.github.com/users/Repiteo/followers","following_url":"https://api.github.com/users/Repiteo/following{/other_user}","gists_url":"https://api.github.com/users/Repiteo/gists{/gist_id}","starred_url":"https://api.github.com/users/Repiteo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Repiteo/subscriptions","organizations_url":"https://api.github.com/users/Repiteo/orgs","repos_url":"https://api.github.com/users/Repiteo/repos","events_url":"https://api.github.com/users/Repiteo/events{/privacy}","received_events_url":"https://api.github.com/users/Repiteo/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/122101/reactions","total_count":3,"+1":2,"-1":0,"laugh":0,"hooray":0,"confused":1,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/godotengine/godot/issues/122101/timeline","performed_via_github_app":null,"state_reason":null}