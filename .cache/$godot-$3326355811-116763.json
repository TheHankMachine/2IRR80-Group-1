524528?u=e3e0b822e52420dad22e97cabb110e92626dde68&v=4","created_at":"0001-01-01T00:00:00Z","followers":0,"following":0,"html_url":"https://github.com/Kazox61","id":93524528,"node_id":"U_kgDOBZMSMA","login":"Kazox61","type":"User","owned_private_repos":0,"public_gists":0,"public_repos":0,"total_private_repos":0,"url":"https://api.github.com/users/Kazox61"},"body":"","html_url":"https://github.com/godotengine/godot/pull/116763#pullrequestreview-4572418605","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/116763","author_association":"CONTRIBUTOR","submitted_at":"2026-06-25T15:27:13Z"},{"id":4574081380,"node_id":"PRR_kwDOAO6SJc8AAAABEKLxZA","state":"COMMENTED","commit_id":"e1e3707607d176899a1111c86913add6d1eff178","user":{"site_admin":false,"suspended":false,"updated_at":"0001-01-01T00:00:00Z","avatar_url":"https://avatars.githubusercontent.com/u/30739239?u=ccfc0c8ff4c980eb77e097aa72e9ad04749294a9&v=4","created_at":"0001-01-01T00:00:00Z","followers":0,"following":0,"html_url":"https://github.com/YeldhamDev","id":30739239,"node_id":"MDQ6VXNlcjMwNzM5MjM5","login":"YeldhamDev","type":"User","owned_private_repos":0,"public_gists":0,"public_repos":0,"total_private_repos":0,"url":"https://api.github.com/users/YeldhamDev"},"body":"","html_url":"https://github.com/godotengine/godot/pull/116763#pullrequestreview-4574081380","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/116763","author_association":"MEMBER","submitted_at":"2026-06-25T18:55:58Z"},{"id":4582470006,"node_id":"PRR_kwDOAO6SJc8AAAABESLxdg","state":"COMMENTED","commit_id":"bb88582cae78f7cce91247477fb6710f4311acf0","user":{"site_admin":false,"suspended":false,"updated_at":"0001-01-01T00:00:00Z","avatar_url":"https://avatars.githubusercontent.com/u/180032?u=68d23e7ee9cdf810da125e8510b72f845b9dccc8&v=4","created_at":"0001-01-01T00:00:00Z","followers":0,"following":0,"html_url":"https://github.com/Calinou","id":180032,"node_id":"MDQ6VXNlcjE4MDAzMg==","login":"Calinou","type":"User","owned_private_repos":0,"public_gists":0,"public_repos":0,"total_private_repos":0,"url":"https://api.github.com/users/Calinou"},"body":"Tested locally, it works as expected. Code looks good to me.\r\n\r\nSome feedback:\r\n\r\n- It's possible to use negative hit margins, which makes the button *harder* to hit with the mouse (clicking on the button's edges won't press it).\r\n\r\n  - With large negative values, the rect size can become negative, causing this error to be spammed:\r\n\r\n```\r\nERROR: Rect2 size is negative, this is not supported. Use Rect2.abs() to get a Rect2 with a positive size.\r\n   at: has_point (./core/math/rect2.h:185)\r\n```\r\n\r\n  I would clamp the final rect size to 0 to avoid this.\r\n\r\n- To improve usability, the editor could use a default hit margin of `Math::round(2 * EDSCALE)` pixels on desktop platforms, and `Math::round(4 * EDSCALE)` pixels on the Android editor (for touchscreens).\r\n\r\n  - The slight margin on desktop platforms is designed to help when moving the mouse quickly and clicking on various buttons, so you don't need to be as precise. It's subtle, but should help a lot already.","html_url":"https://github.com/godotengine/godot/pull/116763#pullrequestreview-4582470006","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/116763","author_association":"MEMBER","submitted_at":"2026-06-26T20:13:08Z"},{"id":4587891414,"node_id":"PRR_kwDOAO6SJc8AAAABEXWq1g","state":"APPROVED","commit_id":"3ef0cdfd61558a955332507eb6a1202aa705e94b","user":{"site_admin":false,"suspended":false,"updated_at":"0001-01-01T00:00:00Z","avatar_url":"https://avatars.githubusercontent.com/u/30739239?u=ccfc0c8ff4c980eb77e097aa72e9ad04749294a9&v=4","created_at":"0001-01-01T00:00:00Z","followers":0,"following":0,"html_url":"https://github.com/YeldhamDev","id":30739239,"node_id":"MDQ6VXNlcjMwNzM5MjM5","login":"YeldhamDev","type":"User","owned_private_repos":0,"public_gists":0,"public_repos":0,"total_private_repos":0,"url":"https://api.github.com/users/YeldhamDev"},"body":"Seems good to me, what about you, @Calinou?","html_url":"https://github.com/godotengine/godot/pull/116763#pullrequestreview-4587891414","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/116763","author_association":"MEMBER","submitted_at":"2026-06-28T17:43:43Z"},{"id":4596167350,"node_id":"PRR_kwDOAO6SJc8AAAABEfPytg","state":"COMMENTED","commit_id":"3ef0cdfd61558a955332507eb6a1202aa705e94b","user":{"site_admin":false,"suspended":false,"updated_at":"0001-01-01T00:00:00Z","avatar_url":"https://avatars.githubusercontent.com/u/180032?u=68d23e7ee9cdf810da125e8510b72f845b9dccc8&v=4","created_at":"0001-01-01T00:00:00Z","followers":0,"following":0,"html_url":"https://github.com/Calinou","id":180032,"node_id":"MDQ6VXNlcjE4MDAzMg==","login":"Calinou","type":"User","owned_private_repos":0,"public_gists":0,"public_repos":0,"total_private_repos":0,"url":"https://api.github.com/users/Calinou"},"body":"","html_url":"https://github.com/godotengine/godot/pull/116763#pullrequestreview-4596167350","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/116763","author_association":"MEMBER","submitted_at":"2026-06-29T23:37:36Z"},{"id":4596167787,"node_id":"PRR_kwDOAO6SJc8AAAABEfP0aw","state":"COMMENTED","commit_id":"3ef0cdfd61558a955332507eb6a1202aa705e94b","user":{"site_admin":false,"suspended":false,"updated_at":"0001-01-01T00:00:00Z","avatar_url":"https://avatars.githubusercontent.com/u/180032?u=68d23e7ee9cdf810da125e8510b72f845b9dccc8&v=4","created_at":"0001-01-01T00:00:00Z","followers":0,"following":0,"html_url":"https://github.com/Calinou","id":180032,"node_id":"MDQ6VXNlcjE4MDAzMg==","login":"Calinou","type":"User","owned_private_repos":0,"public_gists":0,"public_repos":0,"total_private_repos":0,"url":"https://api.github.com/users/Calinou"},"body":"","html_url":"https://github.com/godotengine/godot/pull/116763#pullrequestreview-4596167787","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/116763","author_association":"MEMBER","submitted_at":"2026-06-29T23:37:44Z"},{"id":4596171557,"node_id":"PRR_kwDOAO6SJc8AAAABEfQDJQ","state":"APPROVED","commit_id":"3ef0cdfd61558a955332507eb6a1202aa705e94b","user":{"site_admin":false,"suspended":false,"updated_at":"0001-01-01T00:00:00Z","avatar_url":"https://avatars.githubusercontent.com/u/180032?u=68d23e7ee9cdf810da125e8510b72f845b9dccc8&v=4","created_at":"0001-01-01T00:00:00Z","followers":0,"following":0,"html_url":"https://github.com/Calinou","id":180032,"node_id":"MDQ6VXNlcjE4MDAzMg==","login":"Calinou","type":"User","owned_private_repos":0,"public_gists":0,"public_repos":0,"total_private_repos":0,"url":"https://api.github.com/users/Calinou"},"body":"Works great now 🙂 \r\n\r\nThe click margin in the editor is subtle, but it should help avoid a lot of missed clicks in the long run, particularly between aligned buttons (like the filter category icons in the Output panel).\r\n\r\nWhile testing this, I noticed it's not possible to override theme items on an entire abstract class in the Theme editor with either of the ways to add new theme items:\r\n\r\n<img width=\"337\" height=\"134\" alt=\"Image\" src=\"https://github.com/user-attachments/assets/87fdc234-e54f-4a18-a008-fa8c3247e39d\" />\r\n\r\n<img width=\"617\" height=\"155\" alt=\"Image\" src=\"https://github.com/user-attachments/assets/5ce65ef0-8b0b-494f-91b7-61ebbe7e39dc\" />\r\n\r\n`click_margin` doesn't appear in search results and can't be overriden at all using the **Manage Items...** dialog. It can be overridden using the sidebar still (the first method), but only on BaseButton subclasses (Button, LinkButton, TextureButton).\r\n\r\nIn the long term, we should base the Android click margin based on the input method used to perform the input, but this can be implemented in a future PR (likely by introducing `click_margin_touch` and keeping the current constant for mouse usage only). This depends on https://github.com/godotengine/godot/pull/110893 being implemented first, so that it can distinguish touch inputs from mouse inputs.\r\n\r\nThis constant could also be implemented in LineEdit and TextEdit in future PRs, as it would also help improve usability for those controls.","html_url":"https://github.com/godotengine/godot/pull/116763#pullrequestreview-4596171557","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/116763","author_association":"MEMBER","submitted_at":"2026-06-29T23:38:42Z"}]