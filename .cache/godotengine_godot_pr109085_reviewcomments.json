10054226,"node_id":"MDQ6VXNlcjEwMDU0MjI2","avatar_url":"https://avatars.githubusercontent.com/u/10054226?v=4","gravatar_id":"","url":"https://api.github.com/users/kitbdev","html_url":"https://github.com/kitbdev","followers_url":"https://api.github.com/users/kitbdev/followers","following_url":"https://api.github.com/users/kitbdev/following{/other_user}","gists_url":"https://api.github.com/users/kitbdev/gists{/gist_id}","starred_url":"https://api.github.com/users/kitbdev/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/kitbdev/subscriptions","organizations_url":"https://api.github.com/users/kitbdev/orgs","repos_url":"https://api.github.com/users/kitbdev/repos","events_url":"https://api.github.com/users/kitbdev/events{/privacy}","received_events_url":"https://api.github.com/users/kitbdev/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"Sorting also happens on resize. \nIts also on theme changed and child size flag or child minimum size changed, but we probably don't need to mention all of them.\nIt also happens in other cases depending on the container, so we should leave it a bit more open-ended to not suggest that the mentioned times are the only times it is resorted. `Sorting may also occur in other cases when relevant container parameters change` or something.\n\nWe could also add mention `queue_sort` to trigger it manually?\n\nMaybe it should be worded as \"after\" child nodes are added etc instead of \"when\" since it is deferred.\n","created_at":"2026-02-27T18:32:52Z","updated_at":"2026-02-27T18:36:29Z","html_url":"https://github.com/godotengine/godot/pull/109085#discussion_r2865649896","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/109085","_links":{"self":{"href":"https://api.github.com/repos/godotengine/godot/pulls/comments/2865649896"},"html":{"href":"https://github.com/godotengine/godot/pull/109085#discussion_r2865649896"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/109085"}},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/2865649896/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":53,"original_line":53,"side":"RIGHT","author_association":"CONTRIBUTOR","original_position":19,"position":19,"subject_type":"line"},{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/2865656794","pull_request_review_id":3868427213,"id":2865656794,"node_id":"PRRC_kwDOAO6SJc6qznPa","diff_hunk":"","path":"doc/classes/Container.xml","commit_id":"12f52a4f68cf4879f4719ef1b1c0c04d3e726b55","original_commit_id":"12f52a4f68cf4879f4719ef1b1c0c04d3e726b55","user":{"login":"kitbdev","id":10054226,"node_id":"MDQ6VXNlcjEwMDU0MjI2","avatar_url":"https://avatars.githubusercontent.com/u/10054226?v=4","gravatar_id":"","url":"https://api.github.com/users/kitbdev","html_url":"https://github.com/kitbdev","followers_url":"https://api.github.com/users/kitbdev/followers","following_url":"https://api.github.com/users/kitbdev/following{/other_user}","gists_url":"https://api.github.com/users/kitbdev/gists{/gist_id}","starred_url":"https://api.github.com/users/kitbdev/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/kitbdev/subscriptions","organizations_url":"https://api.github.com/users/kitbdev/orgs","repos_url":"https://api.github.com/users/kitbdev/repos","events_url":"https://api.github.com/users/kitbdev/events{/privacy}","received_events_url":"https://api.github.com/users/kitbdev/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"The description for these should be adjusted to match, since they are basically the same as the signals.\n\nThere could also be links between notifications and the signals.","created_at":"2026-02-27T18:34:41Z","updated_at":"2026-02-27T18:36:29Z","html_url":"https://github.com/godotengin