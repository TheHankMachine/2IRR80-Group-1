node_id":"MDU6TGFiZWwzMjQwOTUwMDYw","url":"https://api.github.com/repos/godotengine/godot/labels/performance","name":"performance","color":"447777","default":false,"description":"","archived_at":null,"archived_by":null}],"state":"closed","locked":false,"assignees":[],"milestone":{"url":"https://api.github.com/repos/godotengine/godot/milestones/22","html_url":"https://github.com/godotengine/godot/milestone/22","labels_url":"https://api.github.com/repos/godotengine/godot/milestones/22/labels","id":12070367,"node_id":"MI_kwDOAO6SJc4AuC3f","number":22,"title":"4.5","description":"","creator":{"login":"Sauermann","id":6299227,"node_id":"MDQ6VXNlcjYyOTkyMjc=","avatar_url":"https://avatars.githubusercontent.com/u/6299227?v=4","gravatar_id":"","url":"https://api.github.com/users/Sauermann","html_url":"https://github.com/Sauermann","followers_url":"https://api.github.com/users/Sauermann/followers","following_url":"https://api.github.com/users/Sauermann/following{/other_user}","gists_url":"https://api.github.com/users/Sauermann/gists{/gist_id}","starred_url":"https://api.github.com/users/Sauermann/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Sauermann/subscriptions","organizations_url":"https://api.github.com/users/Sauermann/orgs","repos_url":"https://api.github.com/users/Sauermann/repos","events_url":"https://api.github.com/users/Sauermann/events{/privacy}","received_events_url":"https://api.github.com/users/Sauermann/received_events","type":"User","user_view_type":"public","site_admin":false},"open_issues":3,"closed_issues":3687,"state":"closed","created_at":"2024-12-19T08:51:28Z","updated_at":"2026-09-04T21:48:38Z","due_on":"2025-09-15T00:00:00Z","closed_at":"2025-09-18T17:13:14Z"},"comments":2,"created_at":"2025-05-21T18:07:51Z","updated_at":"2025-05-22T19:01:14Z","closed_at":"2025-05-22T17:22:10Z","assignee":null,"author_association":"CONTRIBUTOR","issue_field_values":[],"type":null,"active_lock_reason":null,"draft":false,"pull_request":{"url":"https://api.github.com/repos/godotengine/godot/pulls/106689","html_url":"https://github.com/godotengine/godot/pull/106689","diff_url":"https://github.com/godotengine/godot/pull/106689.diff","patch_url":"https://github.com/godotengine/godot/pull/106689.patch","merged_at":"2025-05-22T17:22:10Z"},"body":"Updated `RingBuffer` to use `LocalVector` instead of `Vector`, to avoid `_copy_on_write` overhead when writing to the buffer.\r\n\r\nThis makes `StreamPeerGZIP` decompression around 2x faster, measured with gdscript below:\r\n\r\n```gdscript\r\nfunc _ready() -> void:\r\n\tvar compressed_bytes := get_compressed_bytes()\r\n\tvar start := Time.get_ticks_msec()\r\n\tfor i in 10:\r\n\t\tvar decompress := StreamPeerGZIP.new()\r\n\t\tdecompress.start_decompression()\r\n\t\tvar result := process_byte_array(compressed_bytes, decompress, false)\r\n\tvar end := Time.get_ticks_msec()\r\n\tprint(\"%dms\" % [end - start])\r\n\r\nfunc get_compressed_bytes() -> PackedByteArray:\r\n\tvar str := \"test string\".repeat(1000000)\r\n\tvar str_bytes = str.to_ascii_buffer()\r\n\tvar compress := StreamPeerGZIP.new()\r\n\tcompress.start_compression()\r\n\treturn process_byte_array(str_bytes, compress, true)\r\n\r\nfunc process_byte_array(input: PackedByteArray, stream_peer: StreamPeerGZIP, compress: bool) -> PackedByteArray:\r\n\tvar remaining := input\r\n\tvar result: PackedByteArray = []\r\n\twhile remaining.size() > 0:\r\n\t\tvar sent_bytes = stream_peer.put_partial_data(remaining)[1]\r\n\t\tremaining = remaining.slice(sent_bytes)\r\n\t\tresult.append_array(stream_peer.get_data(stream_peer.get_available_bytes())[1])\r\n\tif compress:\r\n\t\tstream_peer.finish()\r\n\t\tresult.append_array(stream_peer.get_data(stream_peer.get_available_bytes())[1])\r\n\treturn result\r\n```\r\n\r\nResults:\r\n```\r\nold: 557ms\r\nnew: 241ms\r\n```\r\n\r\n<!--\r\nPlease target the `master` branch in priority.\r\n\r\nRelevant fixes are cherry-picked for stable branches as needed by maintainers.\r\n\r\nTo speed up the contribution process and avoid CI errors, please set up pre-commit hooks locally:\r\nhttps://docs.godotengine.org/en/latest/contributing/development/code_style_guidelines.html\r\n-->\r\n\r\n- *Production edit: See https://github.com/godotengine/godot/issues/106632.*\r\n","closed_by":{"login":"Repiteo","id":17489292,"node_id":"MDQ6VXNlcjE3NDg5Mjky","avatar_url":"https://avatars.githubusercontent.com/u/17489292?v=4","gravatar_id":"","url":"https://api.github.com/users/Repiteo","html_url":"https://github.com/Repiteo","followers_url":"https://api.github.com/users/Repiteo/followers","following_url":"https://api.github.com/users/Repiteo/following{/other_user}","gists_url":"https://api.github.com/users/Repiteo/gists{/gist_id}","starred_url":"https://api.github.com/users/Repiteo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Repiteo/subscriptions","organizations_url":"https://api.github.com/users/Repiteo/orgs","repos_url":"https://api.github.com/users/Repiteo/repos","events_url":"https://api.github.com/users/Repiteo/events{/privacy}","received_events_url":"https://api.github.com/users/Repiteo/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/106689/reactions","total_count":10,"+1":8,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":2,"eyes":0},"timeline_url":"https://api.github.com/repos/godotengine/godot/issues/106689/timeline","performed_via_github_app":null,"state_reason":null}