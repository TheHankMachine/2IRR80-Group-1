.h:138:28,\r\n    inlined from 'List<T, A>::Element* List<T, A>::push_back(const T&) [with T = ScriptLanguage::CodeCompletionOption; A = DefaultAllocator]' at ./core/templates/list.h:297:16,\r\n    inlined from 'void CodeEdit::add_code_completion_option(CodeCompletionKind, const String&, const String&, const Color&, const Ref<Resource>&, const Variant&, int)' at scene\\gui\\code_edit.cpp:2238:44:\r\n./core/os/memory.h:221:23: error: using a dangling pointer to 'C.1282' [-Werror=dangling-pointer=]\r\n  221 |                 memcpy((uint8_t *)p_dst, (uint8_t *)p_src, p_num * sizeof(T));\r\n      |                 ~~~~~~^~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~\r\n./core/object/script_language.h: In member function 'void CodeEdit::add_code_completion_option(CodeCompletionKind, const String&, const String&, const Color&, const Ref<Resource>&, const Variant&, int)':\r\n./core/object/script_language.h:322:40: note: 'C.1282' declared here\r\n  322 |                 CodeCompletionOption() {}\r\n      |                                        ^\r\n```","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2943662343/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2952743750","html_url":"https://github.com/godotengine/godot/pull/105928#issuecomment-2952743750","issue_url":"https://api.github.com/repos/godotengine/godot/issues/105928","id":2952743750,"node_id":"IC_kwDOAO6SJc6v_0tG","user":{"login":"Ivorforce","id":2308167,"node_id":"MDQ6VXNlcjIzMDgxNjc=","avatar_url":"https://avatars.githubusercontent.com/u/2308167?v=4","gravatar_id":"","url":"https://api.github.com/users/Ivorforce","html_url":"https://github.com/Ivorforce","followers_url":"https://api.github.com/users/Ivorforce/followers","following_url":"https://api.github.com/u