[{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3097998737","html_url":"https://github.com/godotengine/godot/issues/108844#issuecomment-3097998737","issue_url":"https://api.github.com/repos/godotengine/godot/issues/108844","id":3097998737,"node_id":"IC_kwDOAO6SJc64p7WR","user":{"login":"Changryy","id":35406747,"node_id":"MDQ6VXNlcjM1NDA2NzQ3","avatar_url":"https://avatars.githubusercontent.com/u/35406747?v=4","gravatar_id":"","url":"https://api.github.com/users/Changryy","html_url":"https://github.com/Changryy","followers_url":"https://api.github.com/users/Changryy/followers","following_url":"https://api.github.com/users/Changryy/following{/other_user}","gists_url":"https://api.github.com/users/Changryy/gists{/gist_id}","starred_url":"https://api.github.com/users/Changryy/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Changryy/subscriptions","organizations_url":"https://api.github.com/users/Changryy/orgs","repos_url":"https://api.github.com/users/Changryy/repos","events_url":"https://api.github.com/users/Changryy/events{/privacy}","received_events_url":"https://api.github.com/users/Changryy/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-07-21T18:53:44Z","updated_at":"2025-07-21T18:53:44Z","body":"`Array` does not have a function called `reversed()`. Use `reverse()` instead.\n`reverse()` does not make a reversed copy of the array, instead it reverses the array that it was called on. This means that your code should look something like this:\n```gdscript\nprint(level.object_data) # not reversed\nlevel.object_data.reverse()\nprint(level.object_data) # reversed\n```","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3097998737/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3099899303","html_url":"https://github.com/godotengine/godot/issues/108844#issuecomment-3099899303","issue_url":"https://api.github.com/repos/godotengine/godot/issues/108844","id":3099899303,"node_id":"IC_kwDOAO6SJc64xLWn","user":{"login":"Calinou","id":180032,"node_id":"MDQ6VXNlcjE4MDAzMg==","avatar_url":"https://avatars.githubusercontent.com/u/180032?v=4","gravatar_id":"","url":"https://api.github.com/users/Calinou","html_url":"https://github.com/Calinou","followers_url":"https://api.github.com/users/Calinou/followers","following_url":"https://api.github.com/users/Calinou/following{/other_user}","gists_url":"https://api.github.com/users/Calinou/gists{/gist_id}","starred_url":"https://api.github.com/users/Calinou/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Calinou/subscriptions","organizations_url":"https://api.github.com/users/Calinou/orgs","repos_url":"https://api.github.com/users/Calinou/repos","events_url":"https://api.github.com/users/Calinou/events{/privacy}","received_events_url":"https://api.github.com/users/Calinou/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-07-21T23:26:53Z","updated_at":"2025-07-22T00:06:32Z","body":"Closing per @Changryy's comment, as this is not a bug. `reverse()` works in-place (it modifies the existing array's value), so it does not return a value.\n\nAdding a `reversed()` method is mentioned in https://github.com/godotengine/godot-proposals/issues/7197.","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3099899303/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null}]