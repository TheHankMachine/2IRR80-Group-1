ontent.com/u/93914?v=4","gravatar_id":"","url":"https://api.github.com/users/khaledhosny","html_url":"https://github.com/khaledhosny","followers_url":"https://api.github.com/users/khaledhosny/followers","following_url":"https://api.github.com/users/khaledhosny/following{/other_user}","gists_url":"https://api.github.com/users/khaledhosny/gists{/gist_id}","starred_url":"https://api.github.com/users/khaledhosny/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/khaledhosny/subscriptions","organizations_url":"https://api.github.com/users/khaledhosny/orgs","repos_url":"https://api.github.com/users/khaledhosny/repos","events_url":"https://api.github.com/users/khaledhosny/events{/privacy}","received_events_url":"https://api.github.com/users/khaledhosny/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-10-13T08:35:38Z","updated_at":"2025-10-13T08:35:38Z","body":"> > Not sure if changes to TextServerAdvanced are needed to use them, though.\r\n> \r\n> Most likely, it will require support in FreeType for it to work. This test font doesn't work, and I have not found a single app that can open in, so this feature unlikely will be relevant any time soon.\r\n\r\nThe support in HarfBuzz is for hb-draw APIs (`VARC` has no effect on shaping). If you don’t use hb-draw then you will see no difference in handling fonts with `VARC` table.","author_association":"NONE","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3396426121/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3396945745","html_url":"https://github.com/godotengine/godot/pull/111569#issuecomment-3396945745","issue_url":"https://api.github.com/repos/godotengine/godot/issues/111569","id":3396945745,"node_id":"IC_kwDOAO6SJc7KeUdR","user":{"login":"bruvzg","id":7645683,"node_id":"MDQ6VXNlcjc2NDU2ODM=","avatar_url":"https://avatars.githubusercontent.com/u/7645683?v=4","gravatar_id":"","url":"https://api.github.com/users/bruvzg","html_url":"https://github.com/bruvzg","followers_url":"https://api.github.com/users/bruvzg/followers","following_url":"https://api.github.com/users/bruvzg/following{/other_user}","gists_url":"https://api.github.com/users/bruvzg/gists{/gist_id}","starred_url":"https://api.github.com/users/bruvzg/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/bruvzg/subscriptions","organizations_url":"https://api.github.com/users/bruvzg/orgs","repos_url":"https://api.github.com/users/bruvzg/repos","events_url":"https://api.github.com/users/bruvzg/events{/privacy}","received_events_url":"https://api.github.com/users/bruvzg/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-10-13T10:47:11Z","updated_at":"2025-10-13T10:47:11Z","body":"> If you don’t use hb-draw then you will see no difference in handling fonts with VARC table.\r\n\r\nWe do not use `hb-draw`.","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3396945745/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3398072041","html_url":"https://github.com/godotengine/godot/pull/111569#issuecomment-3398072041","issue_url":"https://api.github.com/repos/godotengine/godot/issues/111569","id":3398072041,"node_id":"IC_kwDOAO6SJc7Kinbp","user":{"login":"DeeJayLSP","id":60024671,"node_id":"MDQ6VXNlcjYwMDI0Njcx","avatar_url":"https://avatars.githubusercontent.com/u/60024671?v=4","gravatar_id":"","url":"https://api.github.com/users/DeeJayLSP","html_url":"https://github.com/DeeJayLSP","followers_url":"https://api.github.com/users/DeeJayLSP/followers","following_url":"https://api.github.com/users/DeeJayLSP/following{/other_user}","gists_url":"https://api.github.com/users/DeeJayLSP/gists{/gist_id}","starred_url":"https://api.github.com/users/DeeJayLSP/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/DeeJayLSP/subscriptions","organizations_url":"https://api.github.com/users/DeeJayLSP/orgs","repos_url":"https://api.github.com/users/DeeJayLSP/repos","events_url":"https://api.github.com/users/DeeJayLSP/events{/privacy}","received_events_url":"https://api.github.com/users/DeeJayLSP/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-10-13T15:48:32Z","updated_at":"2025-10-13T18:14:11Z","body":"> Note: we do not use HarfBuzz subsetter, so all `hb-subset-` files probably can be removed, but this requires some testing, so probably should be done separately from update.\r\n\r\nCan confirm the engine builds and runs fine with all `hb-subset-*` files out. \r\n\r\nThere two files in the source that include most `.cc` files at once: `harfbuzz.cc` and `harfbuzz-subset.cc`, the difference being that the latter includes the `hb-subset-*` files. Considering they're used as a reference, wouldn't it be wise to just leave subset files out?\r\n\r\n**Edit**: I went ahead and commented out all of them.","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3398072041/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3398636512","html_url":"https://github.com/godotengine/godot/pull/111569#issuecomment-3398636512","issue_url":"https://api.github.com/repos/godotengine/godot/issues/111569","id":3398636512,"node_id":"IC_kwDOAO6SJc7KkxPg","user":{"login":"DeeJayLSP","id":60024671,"node_id":"MDQ6VXNlcjYwMDI0Njcx","avatar_url":"https://avatars.githubusercontent.com/u/60024671?v=4","gravatar_id":"","url":"https://api.github.com/users/DeeJayLSP","html_url":"https://github.com/DeeJayLSP","followers_url":"https://api.github.com/users/DeeJayLSP/followers","following_url":"https://api.github.com/users/DeeJayLSP/following{/other_user}","gists_url":"https://api.github.com/users/DeeJayLSP/gists{/gist_id}","starred_url":"https://api.github.com/users/DeeJayLSP/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/DeeJayLSP/subscriptions","organizations_url":"https://api.github.com/users/DeeJayLSP/orgs","repos_url":"https://api.github.com/users/DeeJayLSP/repos","events_url":"https://api.github.com/users/DeeJayLSP/events{/privacy}","received_events_url":"https://api.github.com/users/DeeJayLSP/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-10-13T18:35:32Z","updated_at":"2025-10-13T18:39:25Z","body":"> We do not use `hb-draw`.\r\n\r\nHarfBuzz (or at least this version) has many `#ifndef`s that disable a lot of features, including a `HB_NO_DRAW` (not available before this change, and the engine builds just fine with it).","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3398636512/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3398651627","html_url":"https://github.com/godotengine/godot/pull/111569#issuecomment-3398651627","issue_url":"https://api.github.com/repos/godotengine/godot/issues/111569","id":3398651627,"node_id":"IC_kwDOAO6SJc7Kk07r","user":{"login":"khaledhosny","id":93914,"node_id":"MDQ6VXNlcjkzOTE0","avatar_url":"https://avatars.githubusercontent.com/u/93914?v=4","gravatar_id":"","url":"https://api.github.com/users/khaledhosny","html_url":"https://github.com/khaledhosny","followers_url":"https://api.gith