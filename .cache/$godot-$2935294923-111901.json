[{"id":3366978392,"node_id":"PRR_kwDOAO6SJc7IsANY","state":"COMMENTED","user":{"site_admin":false,"suspended":false,"updated_at":"0001-01-01T00:00:00Z","avatar_url":"https://avatars.githubusercontent.com/u/180032?u=68d23e7ee9cdf810da125e8510b72f845b9dccc8&v=4","created_at":"0001-01-01T00:00:00Z","followers":0,"following":0,"html_url":"https://github.com/Calinou","id":180032,"node_id":"MDQ6VXNlcjE4MDAzMg==","login":"Calinou","type":"User","owned_private_repos":0,"public_gists":0,"public_repos":0,"total_private_repos":0,"url":"https://api.github.com/users/Calinou"},"body":"Tested locally, it works as expected. Code looks good to me.\r\n\r\n> On macOS it is sometimes Cmd+G, but it seems like it is Cmd+L is more common\r\n\r\nTo accomodate for this, you could bind it to *both* <kbd>Ctrl + G</kbd> and <kbd>Ctrl + L</kbd> on all platforms with `ED_SHORTCUT_ARRAY()`. We don't have any conflicts while in the script editor currently.\r\n\r\nThis is also good for muscle memory if you regularly switch between macOS and other platforms (like yours truly).","html_url":"https://github.com/godotengine/godot/pull/111901#pullrequestreview-3366978392","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/111901","author_association":"MEMBER","submitted_at":"2025-10-22T18:17:16Z"},{"id":3371612071,"node_id":"PRR_kwDOAO6SJc7I9ren","state":"APPROVED","commit_id":"d08d9d3f49bf48d295c32f047a2102cd036358e7","user":{"site_admin":false,"suspended":false,"updated_at":"0001-01-01T00:00:00Z","avatar_url":"https://avatars.githubusercontent.com/u/180032?u=68d23e7ee9cdf810da125e8510b72f845b9dccc8&v=4","created_at":"0001-01-01T00:00:00Z","followers":0,"following":0,"html_url":"https://github.com/Calinou","id":180032,"node_id":"MDQ6VXNlcjE4MDAzMg==","login":"Calinou","type":"User","owned_private_repos":0,"public_gists":0,"public_repos":0,"total_private_repos":0,"url":"https://api.github.com/users/Calinou"},"body":"Looks good to me, given the above comments.","html_url":"https://gi