hments/files/17926939/stop_on_slopes_fix.zip)\r\n","closed_by":{"login":"yosoyfreeman","id":64601424,"node_id":"MDQ6VXNlcjY0NjAxNDI0","avatar_url":"https://avatars.githubusercontent.com/u/64601424?v=4","gravatar_id":"","url":"https://api.github.com/users/yosoyfreeman","html_url":"https://github.com/yosoyfreeman","followers_url":"https://api.github.com/users/yosoyfreeman/followers","following_url":"https://api.github.com/users/yosoyfreeman/following{/other_user}","gists_url":"https://api.github.com/users/yosoyfreeman/gists{/gist_id}","starred_url":"https://api.github.com/users/yosoyfreeman/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/yosoyfreeman/subscriptions","organizations_url":"https://api.github.com/users/yosoyfreeman/orgs","repos_url":"https://api.github.com/users/yosoyfreeman/repos","events_url":"https://api.github.com/users/yosoyfreeman/events{/privacy}","received_events_url":"https://api.github.com/users/yosoyfreeman/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/99731/reactions","total_count":5,"+1":0,"-1":0,"laugh":0,"hooray":5,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/godotengine/godot/issues/99731/timeline","performed_via_github_app":null,"state_reason":null}