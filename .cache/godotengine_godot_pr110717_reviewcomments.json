_request_url":"https://api.github.com/repos/godotengine/godot/pulls/110717","_links":{"self":{"href":"https://api.github.com/repos/godotengine/godot/pulls/comments/2365341240"},"html":{"href":"https://github.com/godotengine/godot/pull/110717#discussion_r2365341240"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/110717"}},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/2365341240/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":1818,"original_line":1818,"side":"RIGHT","author_association":"CONTRIBUTOR","original_position":13,"position":16,"subject_type":"line"},{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/2365341969","pull_request_review_id":3248536526,"id":2365341969,"node_id":"PRRC_kwDOAO6SJc6M_EER","diff_hunk":"@@ -1813,7 +1814,7 @@ Variant GDScriptFunction::call(GDScriptInstance *p_instance, const Variant **p_a\n \t\t\t\tGET_INSTRUCTION_ARG(dst, argc);\n \t\t\t\t*dst = Variant(); // Clear potential previous typed array.\n \n-\t\t\t\t*dst = Array(array, builtin_type, native_type, *script_type);\n+\t\t\t\t*dst = array;","path":"modules/gdscript/gdscript_vm.cpp","commit_id":"b18beb2cc21259bf7a4a9780a44b160dedf22802","original_commit_id":"0badca09b022d6c1aff20dade4a6149fbd61ce35","user":{"login":"Shadows-of-Fire","id":3682588,"node_id":"MDQ6VXNlcjM2ODI1ODg=","avatar_url":"https://avatars.githubusercontent.com/u/3682588?v=4","gravatar_id":"","url":"https://api.github.com/users/Shadows-of-Fire","html_url":"https://github.com/Shadows-of-Fire","followers_url":"https://api.github.com/users/Shadows-of-Fire/followers","following_url":"https://api.github.com/users/Shadows-of-Fire/following{/other_user}","gists_url":"https://api.github.com/users/Shadows-of-Fire/gists{/gist_id}","starred_url":"https://api.github.com/users/Shadows-of-Fire/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Shadows-of-Fire/subscriptions","organizations_url":"https://api.github.com/users/Shadows-of-Fire/orgs","repos_url":"https://api.github.com/users/Shadows-of-Fire/repos","events_url":"https://api.github.com/users/Shadows-of-Fire/events{/privacy}","received_events_url":"https://api.github.com/users/Shadows-of-Fire/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"Actually I'm not sure if that's even relevant, since `dst` is a `Variant`. So that's first going to have to do an implicit conversion to `Variant` and then do a move assignment from the rvalue. I wonder if the implicit conversion from local to `Variant` would benefit from `std::move`...","created_at":"2025-09-20T06:00:03Z","updated_at":"2025-09-20T06:00:03Z","html_url":"https://github.com/godotengine/godot/pull/110717#discussion_r2365341969","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/110717","_links":{"self":{"href":"https://api.github.com/repos/godotengine/godot/pulls/comments/2365341969"},"html":{"href":"https://github.com/godotengine/godot/pull/110717#discussion_r2365341969"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/110717"}},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/2365341969/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":1818,"original_line":1818,"side":"RIGHT","in_reply_to_id":2365341240,"author_association":"CONTRIBUTOR","original_position":13,"position":16,"subject_type":"line"},{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/2365345448","pull_request_review_id":3248542345,"id":2365345448,"node_id":"PRRC_kwDOAO6SJc6M_E6o","diff_hunk":"@@ -1813,7 +1814,7 @@ Variant GDScriptFunction::call(GDScriptInstance *p_instance, const Variant **p_a\n \t\t\t\tGET_INSTRUCTION_ARG(dst, argc);\n \t\t\t\t*dst = Variant(); // Clear potential previous typed array.\n \n-\t\t\t\t*dst = Array(array, builtin_type, native_type, *script_type);\n+\t\t\t\t*dst = array;","path":"modules/gdscript/gdscript_vm.cpp","commit_id":"b18beb2cc21259bf7a4a9780a44b160dedf22802","original_commit_id":"0badca09b022d6c1aff20dade4a6149fbd61ce35","user":{"login":"Shadows-of-Fire","id":3682588,"node_id":"MDQ6VXNlcjM2ODI1ODg=","avatar_url":"https://avatars.githubusercontent.com/u/3682588?v=4","gravatar_id":"","url":"https://api.github.com/users/Shadows-of-Fire","html_url":"https://github.com/Shadows-of-Fire","followers_url":"https://api.github.com/users/Shadows-of-Fire/followers","following_url":"https://api.github.com/users/Shadows-of-Fire/following{/other_user}","gists_url":"https://api.github.com/users/Shadows-of-Fire/gists{/gist_id}","starred_url":"https://api.github.com/users/Shadows-of-Fire/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Shadows-of-Fire/subscriptions","organizations_url":"https://api.github.com/users/Shadows-of-Fire/orgs","repos_url":"https://api.github.com/users/Shadows-of-Fire/repos","events_url":"https://api.github.com/users/Shadows-of-Fire/events{/privacy}","received_events_url":"https://api.github.com/users/Shadows-of-Fire/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"Hm, no, probably not relevant, since both `Dictionary` and `Array` are wrappers around internal heap-allocated data and their copy constructors are fairly trivial. Plus the construction of a `Variant` is not primed to accept an rvalue anyway, so the rvalue would go back into an lvalue for the conversion.","created_at":"2025-09-20T06:12:57Z","updated_at":"2025-09-20T06:12:57Z","html_url":"https://github.com/godotengine/godot/pull/110717#discussion_r2365345448","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/110717","_links":{"self":{"href":"https://api.github.com/repos/godotengine/godot/pulls/comments/2365345448"},"html":{"href":"https://github.com/godotengine/godot/pull/110717#discussion_r2365345448"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/110717"}},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/2365345448/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":1818,"original_line":1818,"side":"RIGHT","in_reply_to_id":2365341240,"author_association":"CONTRIBUTOR","original_position":13,"position":16,"subject_type":"line"},{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/2365598037","pull_request_review_id":3249009061,"id":2365598037,"node_id":"PRRC_kwDOAO6SJc6NAClV","diff_hunk":"@@ -1805,15 +1805,17 @@ Variant GDScriptFunction::call(GDScriptInstance *p_instance, const Variant **p_a\n \t\t\t\tconst StringName native_type = _global_names_ptr[native_type_idx];\n \n \t\t\t\tArray array;\n+\t\t\t\tarray.set_typed(builtin_type, native_type, *script_type);","path":"modules/gdscript/gdscript_vm.cpp","commit_id":"b18beb2cc21259bf7a4a9780a44b160dedf22802","original_commit_id":"b18beb2cc21259bf7a4a9780a44b160dedf22802","user":{"login":"Ivorforce","id":2308167,"node_id":"MDQ6VXNlcjIzMDgxNjc=","avatar_url":"https://avatars.githubusercontent.com/u/2308167?v=4","gravatar_id":"","url":"https://api.github.com/users/Ivorforce","html_url":"https://github.com/Ivorforce","followers_url":"https://api.github.com/users/Ivorforce/followers","following_url":"https://api.github.com/users/Ivorforce/following{/other_user}","gists_url":"https://api.github.com/users/Ivorforce/gists{/gist_id}","starred_url":"https://api.github.com/users/Ivorforce/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Ivorforce/subscriptions","organizations_url":"https://api.github.com/users/Ivorforce/orgs","repos_url":"https://api.github.com/users/Ivorforce/repos","events_url":"https://api.github.com/users/Ivorforce/events{/privacy}","received_events_url":"https://api.github.com/users/Ivorforce/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"Note that typed array resize needs to construct all elements as empty elements of the needed type. And then `.set` needs to replace them with the actual values.\r\n\r\nIt might still be faster than repeated `push_back` calls, but I'm guessing not by as much as might be expected. This should probably be tested. \r\nOnce `Array` gets `reserve` (scheduled for early 4.6 dev), I'm pretty sure the `reserve` + `push_back` approach should be faster than `resize` + `set`.","created_at":"2025-09-20T11:40:02Z","updated_at":"2025-09-20T11:41:53Z","html_url":"https://github.com/godotengine/godot/pull/110717#discussion_r2365598037","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/110717","_links":{"self":{"href":"https://api.github.com/repos/godotengine/godot/pulls/comments/2365598037"},"html":{"href":"https://github.com/godotengine/godot/pull/110717#discussion_r2365598037"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/110717"}},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/2365598037/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":1808,"original_line":1808,"side":"RIGHT","author_association":"MEMBER","original_position":4,"position":4,"subject_type":"line"},{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/2365913680","pull_request_review_id":3249355779,"id":2365913680,"node_id":"PRRC_kwDOAO6SJc6NBPpQ","diff_hunk":"@@ -1805,15 +1805,17 @@ Variant GDScriptFunction::call(GDScriptInstance *p_instance, const Variant **p_a\n \t\t\t\tconst StringName native_type = _global_names_ptr[native_type_idx];\n \n \t\t\t\tArray array;\n+\t\t\t\tarray.set_typed(builtin_type, native_type, *script_type);","path":"modules/gdscript/gdscript_vm.cpp","commit_id":"b18beb2cc21259bf7a4a9780a44b160dedf22802","original_commit_id":"b18beb2cc21259bf7a4a9780a44b160dedf22802","user":{"login":"Shadows-of-Fire","id":3682588,"node_id":"MDQ6VXNlcjM2ODI1ODg=","avatar_url":"https://avatars.githubusercontent.com/u/3682588?v=4","gravatar_id":"","url":"https://api.github.com/users/Shadows-of-Fire","html_url":"https://github.com/Shadows-of-Fire","followers_url":"https://api.github.com/users/Shadows-of-Fire/followers","following_url":"https://api.github.com/users/Shadows-of-Fire/following{/other_user}","gists_url":"https://api.github.com/users/Shadows-of-Fire/gists{/gist_id}","starred_url":"https://api.github.com/users/Shadows-of-Fire/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Shadows-of-Fire/subscriptions","organizations_url":"https://api.github.com/users/Shadows-of-Fire/orgs","repos_url":"https://api.github.com/users/Shadows-of-Fire/repos","events_url":"https://api.github.com/users/Shadows-of-Fire/events{/privacy}","received_events_url":"https://api.github.com/users/Shadows-of-Fire/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"I ran a similar test to the dictionary one with an array of length 40; the time difference between the approaches for `Array` is negligible. In both cases the typed array is about 50% slower than the untyped array. \r\n\r\n```\r\nPrior to this change:\r\ntime untyped: 2396ms\r\ntime typed: 3691ms\r\n\r\nAfter this change:\r\ntime untyped: 2400ms\r\ntime typed: 3542ms\r\n```\r\n\r\nSo it's ever so slightly faster; enough to mean we don't need to explicitly hold this change for `reserve`, but it would be better if `reserve` was present.","created_at":"2025-09-21T02:57:18Z","updated_at":"2025-09-21T02:57:18Z","html_url":"https://github.com/godotengine/godot/pull/110717#discussion_r2365913680","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/110717","_links":{"self":{"href":"https://api.github.com/repos/godotengine/godot/pulls/comments/2365913680"},"html":{"href":"https://github.com/godotengine/godot/pull/110717#discussion_r2365913680"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/110717"}},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/2365913680/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":1808,"original_line":1808,"side":"RIGHT","in_reply_to_id":2365598037,"author_association":"CONTRIBUTOR","original_position":4,"position":4,"subject_type":"line"},{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/2366198829","pull_request_review_id":3249998537,"id":2366198829,"node_id":"PRRC_kwDOAO6SJc6NCVQt","diff_hunk":"@@ -1805,15 +1805,17 @@ Variant GDScriptFunction::call(GDScriptInstance *p_instance, const Variant **p_a\n \t\t\t\tconst StringName native_type = _global_names_ptr[native_type_idx];\n \n \t\t\t\tArray array;\n+\t\t\t\tarray.set_typed(builtin_type, native_type, *script_type);","path":"modules/gdscript/gdscript_vm.cpp","commit_id":"b18beb2cc21259bf7a4a9780a44b160dedf22802","original_commit_id":"b18beb2cc21259bf7a4a9780a44b160dedf22802","user":{"login":"Ivorforce","id":2308167,"node_id":"MDQ6VXNlcjIzMDgxNjc=","avatar_url":"https://avatars.githubusercontent.com/u/2308167?v=4","gravatar_id":"","url":"https://api.github.com/users/Ivorforce","html_url":"https://github.com/Ivorforce","followers_url":"https://api.github.com/users/Ivorforce/followers","following_url":"https://api.github.com/users/Ivorforce/following{/other_user}","gists_url":"https://api.github.com/users/Ivorforce/gists{/gist_id}","starred_url":"https://api.github.com/users/Ivorforce/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Ivorforce/subscriptions","organizations_url":"https://api.github.com/users/Ivorforce/orgs","repos_url":"https://api.github.com/users/Ivorforce/repos","events_url":"https://api.github.com/users/Ivorforce/events{/privacy}","received_events_url":"https://api.github.com/users/Ivorforce/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"Ok, thanks for testing! \r\nPersonally, since both approaches are the same speed, I'd take this as an indication to use `push_back` instead, since it's simpler than `resize` and `set`. Plus, we'll be able to insert `reserve` when it's here. But either would be fine for me right now, since we normally don't plan for future code changes.","created_at":"2025-09-21T12:00:21Z","updated_at":"2025-09-21T12:00:21Z","html_url":"https://github.com/godotengine/godot/pull/110717#discussion_r2366198829","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/110717","_links":{"self":{"href":"https://api.github.com/repos/godotengine/godot/pulls/comments/2366198829"},"html":{"href":"https://github.com/godotengine/godot/pull/110717#discussion_r2366198829"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/110717"}},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/2366198829/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":1808,"original_line":1808,"side":"RIGHT","in_reply_to_id":2365598037,"author_association":"MEMBER","original_position":4,"position":4,"subject_type":"line"}]