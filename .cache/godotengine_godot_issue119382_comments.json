ine/godot/issues/comments/4429524040/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4432183787","html_url":"https://github.com/godotengine/godot/issues/119382#issuecomment-4432183787","issue_url":"https://api.github.com/repos/godotengine/godot/issues/119382","id":4432183787,"node_id":"IC_kwDOAO6SJc8AAAABCC3B6w","user":{"login":"Calinou","id":180032,"node_id":"MDQ6VXNlcjE4MDAzMg==","avatar_url":"https://avatars.githubusercontent.com/u/180032?v=4","gravatar_id":"","url":"https://api.github.com/users/Calinou","html_url":"https://github.com/Calinou","followers_url":"https://api.github.com/users/Calinou/followers","following_url":"https://api.github.com/users/Calinou/following{/other_user}","gists_url":"https://api.github.com/users/Calinou/gists{/gist_id}","starred_url":"https://api.github.com/users/Calinou/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Calinou/subscriptions","organizations_url":"https://api.github.com/users/Calinou/orgs","repos_url":"https://api.github.com/users/Calinou/repos","events_url":"https://api.github.com/users/Calinou/events{/privacy}","received_events_url":"https://api.github.com/users/Calinou/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-05-12T15:34:10Z","updated_at":"2026-05-22T14:59:21Z","body":"We should adjust the manipulation gizmo size to compensate for FOV, similar to using a [widescreen compensation algorithm](https://en.wikipedia.org/wiki/Field_of_view_in_video_games) on the gizmo size.\n\n[We do something similar when the viewport height is very small](https://github.com/godotengine/godot/pull/31048), which leads to a high FOV (the editor camera is Hor+). This particular check should be removed once we switch to FOV-based compensation (to avoid double compensation).","author_assoc