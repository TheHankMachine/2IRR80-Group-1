[{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2993589101","html_url":"https://github.com/godotengine/godot/issues/107733#issuecomment-2993589101","issue_url":"https://api.github.com/repos/godotengine/godot/issues/107733","id":2993589101,"node_id":"IC_kwDOAO6SJc6ybott","user":{"login":"WinnerWind","id":71366717,"node_id":"MDQ6VXNlcjcxMzY2NzE3","avatar_url":"https://avatars.githubusercontent.com/u/71366717?v=4","gravatar_id":"","url":"https://api.github.com/users/WinnerWind","html_url":"https://github.com/WinnerWind","followers_url":"https://api.github.com/users/WinnerWind/followers","following_url":"https://api.github.com/users/WinnerWind/following{/other_user}","gists_url":"https://api.github.com/users/WinnerWind/gists{/gist_id}","starred_url":"https://api.github.com/users/WinnerWind/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/WinnerWind/subscriptions","organizations_url":"https://api.github.com/users/WinnerWind/orgs","repos_url":"https://api.github.com/users/WinnerWind/repos","events_url":"https://api.github.com/users/WinnerWind/events{/privacy}","received_events_url":"https://api.github.com/users/WinnerWind/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-06-21T13:38:39Z","updated_at":"2025-06-21T13:39:36Z","body":"I'll be looking into this, but since my C++ skills are very weak, I'll keep you posted whether or not I am able to do this or not.\n\nIdeally the user shouldn't be allowed to set threads to 0, but I'll need to study the codebase to figure out what is going on.\n\nEDIT: Just looked at ProjectSettings, and seeing the existence of `-1`, I think threads being `0` should be completely disallowed.","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2993589101/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_git