88","default":false,"description":"","archived_at":null,"archived_by":null}],"state":"closed","locked":false,"assignees":[],"milestone":{"url":"https://api.github.com/repos/godotengine/godot/milestones/22","html_url":"https://github.com/godotengine/godot/milestone/22","labels_url":"https://api.github.com/repos/godotengine/godot/milestones/22/labels","id":12070367,"node_id":"MI_kwDOAO6SJc4AuC3f","number":22,"title":"4.5","description":"","creator":{"login":"Sauermann","id":6299227,"node_id":"MDQ6VXNlcjYyOTkyMjc=","avatar_url":"https://avatars.githubusercontent.com/u/6299227?v=4","gravatar_id":"","url":"https://api.github.com/users/Sauermann","html_url":"https://github.com/Sauermann","followers_url":"https://api.github.com/users/Sauermann/followers","following_url":"https://api.github.com/users/Sauermann/following{/other_user}","gists_url":"https://api.github.com/users/Sauermann/gists{/gist_id}","starred_url":"https://api.github.com/users/Sauermann/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Sauermann/subscriptions","organizations_url":"https://api.github.com/users/Sauermann/orgs","repos_url":"https://api.github.com/users/Sauermann/repos","events_url":"https://api.github.com/users/Sauermann/events{/privacy}","received_events_url":"https://api.github.com/users/Sauermann/received_events","type":"User","user_view_type":"public","site_admin":false},"open_issues":3,"closed_issues":3687,"state":"closed","created_at":"2024-12-19T08:51:28Z","updated_at":"2026-09-04T21:48:38Z","due_on":"2025-09-15T00:00:00Z","closed_at":"2025-09-18T17:13:14Z"},"comments":2,"created_at":"2025-03-19T11:42:23Z","updated_at":"2025-05-16T13:54:17Z","closed_at":"2025-04-09T23:18:11Z","assignee":null,"author_association":"CONTRIBUTOR","issue_field_values":[],"type":null,"active_lock_reason":null,"draft":false,"pull_request":{"url":"https://api.github.com/repos/godotengine/godot/pulls/104357","html_url":"https://github.com/godotengine/godot/pull/104357","diff_url":"https://github.com/godotengine/godot/pull/104357.diff","patch_url":"https://github.com/godotengine/godot/pull/104357.patch","merged_at":"2025-04-09T23:18:11Z"},"body":"Fixes #100536\r\nCurrently, the Control set_position method uses the object's \"size_cache\" field in order to recompute its anchors/offsets. However, the size_cache is set in _size_changed() to be at least as large as the combined minimum size of the Control, meaning that setting its position while the combined minimum size is larger than the the bounding rectangle given by the offsets and anchors essentially resizes it.\r\nThis makes the Control unable to automatically shrink as seen with the GraphNode in the original issue this addresses. The issue focused mostly on the GraphEdit and GraphNode, but it can actually occur with other kinds of object as illustrated here (the rectangle on the left is a HBoxContainer):\r\n\r\nhttps://github.com/user-attachments/assets/c6ec0e65-eef3-4a58-b5fe-c6b0bcd7010f\r\n\r\nTo fix this, I made it so set_position is based solely on the size obtained through the offsets and anchors instead of the size_cache:\r\n\r\nhttps://github.com/user-attachments/assets/e1a0c836-8801-4d2e-a586-1f515c51cc2c\r\n\r\nI have also added a new test case to make sure Control objects are able to shrink in this scenario.","closed_by":{"login":"Repiteo","id":17489292,"node_id":"MDQ6VXNlcjE3NDg5Mjky","avatar_url":"https://avatars.githubusercontent.com/u/17489292?v=4","gravatar_id":"","url":"https://api.github.com/users/Repiteo","html_url":"https://github.com/Repiteo","followers_url":"https://api.github.com/users/Repiteo/followers","following_url":"https://api.github.com/users/Repiteo/following{/other_user}","gists_url":"https://api.github.com/users/Repiteo/gists{/gist_id}","starred_url":"https://api.github.com/users/Repiteo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Repiteo/subscriptions","organizations_url":"https://api.github.com/users/Repiteo/orgs","repos_url":"https://api.github.com/users/Repiteo/repos","events_url":"https://api.github.com/users/Repiteo/events{/privacy}","received_events_url":"https://api.github.com/users/Repiteo/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/104357/reactions","total_count":3,"+1":3,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/godotengine/godot/issues/104357/timeline","performed_via_github_app":null,"state_reason":null}