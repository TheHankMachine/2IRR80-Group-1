_url":"https://api.github.com/users/Repiteo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Repiteo/subscriptions","organizations_url":"https://api.github.com/users/Repiteo/orgs","repos_url":"https://api.github.com/users/Repiteo/repos","events_url":"https://api.github.com/users/Repiteo/events{/privacy}","received_events_url":"https://api.github.com/users/Repiteo/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"Come to think of it, this use of the three-way operator was redundant. I can just change it to the functionally-equivalent:\r\n```suggestion\r\n\tif (x == p_other.x) {\r\n```","created_at":"2024-12-23T17:57:09Z","updated_at":"2024-12-23T17:57:09Z","html_url":"https://github.com/godotengine/godot/pull/100749#discussion_r1895998948","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/100749","_links":{"self":{"href":"https://api.github.com/repos/godotengine/godot/pulls/comments/1895998948"},"html":{"href":"https://github.com/godotengine/godot/pull/100749#discussion_r1895998948"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/100749"}},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/1895998948/reactions","total_count":2,"+1":2,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":null,"original_line":null,"side":"RIGHT","in_reply_to_id":1895990521,"author_association":"CONTRIBUTOR","original_position":29,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/1895999209","pull_request_review_id":2520975509,"id":1895999209,"node_id":"PRRC_kwDOAO6SJc5xAqbp","diff_hunk":"@@ -243,12 +240,11 @@ _FORCE_INLINE_ Vector2 Vector2::operator-() const {\n \treturn Vector2(-x, -y);\n }\n \n-_FORCE_INLINE_ bool Vector2::operator==(const Vector2 &p_vec2) const {\n-\treturn x == p_vec2.x && y == p_ve