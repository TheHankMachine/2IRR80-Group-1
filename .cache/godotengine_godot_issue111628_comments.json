[{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3502416554","html_url":"https://github.com/godotengine/godot/pull/111628#issuecomment-3502416554","issue_url":"https://api.github.com/repos/godotengine/godot/issues/111628","id":3502416554,"node_id":"IC_kwDOAO6SJc7QwqKq","user":{"login":"gaheldev","id":78329601,"node_id":"MDQ6VXNlcjc4MzI5NjAx","avatar_url":"https://avatars.githubusercontent.com/u/78329601?v=4","gravatar_id":"","url":"https://api.github.com/users/gaheldev","html_url":"https://github.com/gaheldev","followers_url":"https://api.github.com/users/gaheldev/followers","following_url":"https://api.github.com/users/gaheldev/following{/other_user}","gists_url":"https://api.github.com/users/gaheldev/gists{/gist_id}","starred_url":"https://api.github.com/users/gaheldev/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/gaheldev/subscriptions","organizations_url":"https://api.github.com/users/gaheldev/orgs","repos_url":"https://api.github.com/users/gaheldev/repos","events_url":"https://api.github.com/users/gaheldev/events{/privacy}","received_events_url":"https://api.github.com/users/gaheldev/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-11-07T12:59:50Z","updated_at":"2025-11-07T12:59:50Z","body":"I'm really missing this shortcut, it would be nice if this gets merged or if extra mouse buttons could be mapped.\r\nI do agree this should be default like many applications do, also with alt+left / alt+right, .\r\n\r\nThere is also an history in Inspector that should use the same shortcuts IMO.","author_association":"NONE","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3502416554/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3670069119","html_url":"https://github.