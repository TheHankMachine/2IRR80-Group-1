[{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2623594060","html_url":"https://github.com/godotengine/godot/issues/102173#issuecomment-2623594060","issue_url":"https://api.github.com/repos/godotengine/godot/issues/102173","id":2623594060,"node_id":"IC_kwDOAO6SJc6cYN5M","user":{"login":"clayjohn","id":16521339,"node_id":"MDQ6VXNlcjE2NTIxMzM5","avatar_url":"https://avatars.githubusercontent.com/u/16521339?v=4","gravatar_id":"","url":"https://api.github.com/users/clayjohn","html_url":"https://github.com/clayjohn","followers_url":"https://api.github.com/users/clayjohn/followers","following_url":"https://api.github.com/users/clayjohn/following{/other_user}","gists_url":"https://api.github.com/users/clayjohn/gists{/gist_id}","starred_url":"https://api.github.com/users/clayjohn/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/clayjohn/subscriptions","organizations_url":"https://api.github.com/users/clayjohn/orgs","repos_url":"https://api.github.com/users/clayjohn/repos","events_url":"https://api.github.com/users/clayjohn/events{/privacy}","received_events_url":"https://api.github.com/users/clayjohn/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-01-30T06:06:22Z","updated_at":"2025-01-30T06:06:22Z","body":"It's an even bigger hit in D3D12. I think we should just remove the call to `update_memory_info` in release builds. \n\nIf users really need it in release builds, then we can just use a dirty flag and lazily update them only when requested. ","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2623594060/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2705247695","html_url":"https://github.com/godotengine/godot/issues/102173#issuecomment-2705247695","issue_url":"https://api.github.com/repos/godotengine/godot/issues/102173","id":2705247695,"node_id":"IC_kwDOAO6SJc6hPs3P","user":{"login":"Ryan-000","id":73148864,"node_id":"MDQ6VXNlcjczMTQ4ODY0","avatar_url":"https://avatars.githubusercontent.com/u/73148864?v=4","gravatar_id":"","url":"https://api.github.com/users/Ryan-000","html_url":"https://github.com/Ryan-000","followers_url":"https://api.github.com/users/Ryan-000/followers","following_url":"https://api.github.com/users/Ryan-000/following{/other_user}","gists_url":"https://api.github.com/users/Ryan-000/gists{/gist_id}","starred_url":"https://api.github.com/users/Ryan-000/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Ryan-000/subscriptions","organizations_url":"https://api.github.com/users/Ryan-000/orgs","repos_url":"https://api.github.com/users/Ryan-000/repos","events_url":"https://api.github.com/users/Ryan-000/events{/privacy}","received_events_url":"https://api.github.com/users/Ryan-000/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-03-07T00:33:58Z","updated_at":"2025-03-07T00:33:58Z","body":"`RenderingDevice::update_perf_report` more specifally `RenderingDeviceDriverVulkan::get_lazily_memory_used()` is now contributing to this problem\n\n![Image](https://github.com/user-attachments/assets/ef7adee7-fde1-49d4-81c3-f44fea972a48)","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2705247695/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2705266261","html_url":"https://github.com/godotengine/godot/issues/102173#issuecomment-2705266261","issue_url":"https://api.github.com/repos/godotengine/godot/issues/102173","id":2705266261,"node_id":"IC_kwDOAO6SJc6hPxZV","user":{"login":"clayjohn","id":16521339,"node_id":"MDQ6VXNlcjE2NTIxMzM5","avatar_url":"https://avatars.githubusercontent.com/u/16521339?v=4","gravatar_id":"","url":"https://api.github.com/users/clayjohn","html_url":"https://github.com/clayjohn","followers_url":"https://api.github.com/users/clayjohn/followers","following_url":"https://api.github.com/users/clayjohn/following{/other_user}","gists_url":"https://api.github.com/users/clayjohn/gists{/gist_id}","starred_url":"https://api.github.com/users/clayjohn/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/clayjohn/subscriptions","organizations_url":"https://api.github.com/users/clayjohn/orgs","repos_url":"https://api.github.com/users/clayjohn/repos","events_url":"https://api.github.com/users/clayjohn/events{/privacy}","received_events_url":"https://api.github.com/users/clayjohn/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-03-07T00:50:15Z","updated_at":"2025-03-07T00:50:15Z","body":"Oof. Ya. Same thing, this should only be called in debug builds and only when needed. \n\n@darksylinc Is there any reason we can't delay `update_perf_report()` and only call it when `get_perf_report()` is called?","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2705266261/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2705316116","html_url":"https://github.com/godotengine/godot/issues/102173#issuecomment-2705316116","issue_url":"https://api.github.com/repos/godotengine/godot/issues/102173","id":2705316116,"node_id":"IC_kwDOAO6SJc6hP9kU","user":{"login":"darksylinc","id":3395130,"node_id":"MDQ6VXNlcjMzOTUxMzA=","avatar_url":"https://avatars.githubusercontent.com/u/3395130?v=4","gravatar_id":"","url":"https://api.github.com/users/darksylinc","html_url":"https://github.com/darksylinc","followers_url":"https://api.github.com/users/darksylinc/followers","following_url":"https://api.github.com/users/darksylinc/following{/other_user}","gists_url":"https://api.github.com/users/darksylinc/gists{/gist_id}","starred_url":"https://api.github.com/users/darksylinc/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/darksylinc/subscriptions","organizations_url":"https://api.github.com/users/darksylinc/orgs","repos_url":"https://api.github.com/users/darksylinc/repos","events_url":"https://api.github.com/users/darksylinc/events{/privacy}","received_events_url":"https://api.github.com/users/darksylinc/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-03-07T01:36:43Z","updated_at":"2025-03-07T01:37:16Z","body":"> Is there any reason we can't delay update_perf_report() and only call it when get_perf_report() is called?\n\nIt can be delayed but care must be taken.\n\nImagine the following:\n\n\n```cpp\n// All of this happens per frame:\nwhile( true )\n{\n  gpu_copy_count = 0;\n  // ... gpu_copy_count starts being incremented ...\n  get_perf_report(); // Called by whatever (C++ or GDScript)\n  // ... gpu_copy_count continues being incremented ...\n}\n```\n\nThe result is that `get_perf_report()` now underestimates the real value. It's better to report last frame's (which is the current behavior).\n\nHowever I'm noticing something curious: \n\n```cpp\nvoid RenderingDevice::update_perf_report() {\n\tperf_report_text = \"\";\n\tperf_report_text += \" gpu:\" + String::num_int64(gpu_copy_count);\n\tperf_report_text += \" direct:\" + String::num_int64(direct_copy_count);\n\tperf_report_text += \" bytes:\" + String::num_int64(copy_bytes_count);\n\n\tperf_report_text += \" lazily alloc:\" + String::num_int64(driver->get_lazily_memory_used());\n\n\tgpu_copy_count = 0;\n\tdirect_copy_count = 0;\n\tcopy_bytes_count = 0;\n}\n```\n\nAll the `*_copy_count` variables are cheap and report how many data was transferred during the frame. This can stay as is.\n\nHowever `driver->get_lazily_memory_used())` reports how much lazy memory is \"allocated\", and that can be delayed to whenever `get_perf_report()` is called.","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2705316116/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2705354332","html_url":"https://github.com/godotengine/godot/issues/102173#issuecomment-2705354332","issue_url":"https://api.github.com/repos/godotengine/godot/issues/102173","id":2705354332,"node_id":"IC_kwDOAO6SJc6hQG5c","user":{"login":"clayjohn","id":16521339,"node_id":"MDQ6VXNlcjE2NTIxMzM5","avatar_url":"https://avatars.githubusercontent.com/u/16521339?v=4","gravatar_id":"","url":"https://api.github.com/users/clayjohn","html_url":"https://github.com/clayjohn","followers_url":"https://api.github.com/users/clayjohn/followers","following_url":"https://api.github.com/users/clayjohn/following{/other_user}","gists_url":"https://api.github.com/users/clayjohn/gists{/gist_id}","starred_url":"https://api.github.com/users/clayjohn/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/clayjohn/subscriptions","organizations_url":"https://api.github.com/users/clayjohn/orgs","repos_url":"https://api.github.com/users/clayjohn/repos","events_url":"https://api.github.com/users/clayjohn/events{/privacy}","received_events_url":"https://api.github.com/users/clayjohn/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-03-07T02:07:33Z","updated_at":"2025-03-07T02:07:33Z","body":"> The result is that get_perf_report() now underestimates the real value. It's better to report last frame's (which is the current behavior).\n\nThis could also easily be worked around with a check:\n\n```\nif (last_called_frame != current_frame) {\n    update_perf_report();\n    last_called_frame = current_frame;\n}\n``\n","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2705354332/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2705364234","html_url":"https://github.com/godotengine/godot/issues/102173#issuecomment-2705364234","issue_url":"https://api.github.com/repos/godotengine/godot/issues/102173","id":2705364234,"node_id":"IC_kwDOAO6SJc6hQJUK","user":{"login":"darksylinc","id":3395130,"node_id":"MDQ6VXNlcjMzOTUxMzA=","avatar_url":"https://avatars.githubusercontent.com/u/3395130?v=4","gravatar_id":"","url":"https://api.github.com/users/darksylinc","html_url":"https://github.com/darksylinc","followers_url":"https://api.github.com/users/darksylinc/followers","following_url":"https://api.github.com/users/darksylinc/following{/other_user}","gists_url":"https://api.github.com/users/darksylinc/gists{/gist_id}","starred_url":"https://api.github.com/users/darksylinc/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/darksylinc/subscriptions","organizations_url":"https://api.github.com/users/darksylinc/orgs","repos_url":"https://api.github.com/users/darksylinc/repos","events_url":"https://api.github.com/users/darksylinc/events{/privacy}","received_events_url":"https://api.github.com/users/darksylinc/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-03-07T02:17:36Z","updated_at":"2025-03-07T02:17:36Z","body":"> > The result is that get_perf_report() now underestimates the real value. It's better to report last frame's (which is the current behavior).\n> \n> This could also easily be worked around with a check:\n> \n> ```\n> if (last_called_frame != current_frame) {\n>     update_perf_report();\n>     last_called_frame = current_frame;\n> }\n> ``\n> ```\n\nThat would still underestimate it? It's important that `update_perf_report();` is only called when we are sure `gpu_copy_count` will no longer continue increasing.","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2705364234/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2705537132","html_url":"https://github.com/godotengine/godot/issues/102173#issuecomment-2705537132","issue_url":"https://api.github.com/repos/godotengine/godot/issues/102173","id":2705537132,"node_id":"IC_kwDOAO6SJc6hQzhs","user":{"login":"clayjohn","id":16521339,"node_id":"MDQ6VXNlcjE2NTIxMzM5","avatar_url":"https://avatars.githubusercontent.com/u/16521339?v=4","gravatar_id":"","url":"https://api.github.com/users/clayjohn","html_url":"https://github.com/clayjohn","followers_url":"https://api.github.com/users/clayjohn/followers","following_url":"https://api.github.com/users/clayjohn/following{/other_user}","gists_url":"https://api.github.com/users/clayjohn/gists{/gist_id}","starred_url":"https://api.github.com/users/clayjohn/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/clayjohn/subscriptions","organizations_url":"https://api.github.com/users/clayjohn/orgs","repos_url":"https://api.github.com/users/clayjohn/repos","events_url":"https://api.github.com/users/clayjohn/events{/privacy}","received_events_url":"https://api.github.com/users/clayjohn/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-03-07T05:03:12Z","updated_at":"2025-03-07T05:03:12Z","body":"Ooooh right. Good point","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2705537132/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2707871486","html_url":"https://github.com/godotengine/godot/issues/102173#issuecomment-2707871486","issue_url":"https://api.github.com/repos/godotengine/godot/issues/102173","id":2707871486,"node_id":"IC_kwDOAO6SJc6hZtb-","user":{"login":"clayjohn","id":16521339,"node_id":"MDQ6VXNlcjE2NTIxMzM5","avatar_url":"https://avatars.githubusercontent.com/u/16521339?v=4","gravatar_id":"","url":"https://api.github.com/users/clayjohn","html_url":"https://github.com/clayjohn","followers_url":"https://api.github.com/users/clayjohn/followers","following_url":"https://api.github.com/users/clayjohn/following{/other_user}","gists_url":"https://api.github.com/users/clayjohn/gists{/gist_id}","starred_url":"https://api.github.com/users/clayjohn/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/clayjohn/subscriptions","organizations_url":"https://api.github.com/users/clayjohn/orgs","repos_url":"https://api.github.com/users/clayjohn/repos","events_url":"https://api.github.com/users/clayjohn/events{/privacy}","received_events_url":"https://api.github.com/users/clayjohn/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-03-08T01:35:38Z","updated_at":"2025-03-08T01:35:38Z","body":"Profiling with an optimized build on Windows with Vulkan, I am seeing that the combined cost of `get_total_memory_used()` and `get_lazily_memory_used()` is about 4us per frame. I tested both on a project that is several gigabytes large and one that is only a few kilobytes. In the small project the percentage cost was similar to what you show in your screenshots (~1% of frame time) but that's because the frame time on that project is about 400 us.\n\nI still think this change is worth making as I know these functions can be more expensive on some hardware and I think they are more expensive with D3D12 as well","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2707871486/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2708016161","html_url":"https://github.com/godotengine/godot/issues/102173#issuecomment-2708016161","issue_url":"https://api.github.com/repos/godotengine/godot/issues/102173","id":2708016161,"node_id":"IC_kwDOAO6SJc6haQwh","user":{"login":"Ryan-000","id":73148864,"node_id":"MDQ6VXNlcjczMTQ4ODY0","avatar_url":"https://avatars.githubusercontent.com/u/73148864?v=4","gravatar_id":"","url":"https://api.github.com/users/Ryan-000","html_url":"https://github.com/Ryan-000","followers_url":"https://api.github.com/users/Ryan-000/followers","following_url":"https://api.github.com/users/Ryan-000/following{/other_user}","gists_url":"https://api.github.com/users/Ryan-000/gists{/gist_id}","starred_url":"https://api.github.com/users/Ryan-000/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Ryan-000/subscriptions","organizations_url":"https://api.github.com/users/Ryan-000/orgs","repos_url":"https://api.github.com/users/Ryan-000/repos","events_url":"https://api.github.com/users/Ryan-000/events{/privacy}","received_events_url":"https://api.github.com/users/Ryan-000/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-03-08T04:43:57Z","updated_at":"2025-03-08T04:43:57Z","body":"I just did more testing (just doing Time::get_ticks around the operations), and the baseline in my large project (at approx 90fps) is this:\n`RSG::utilities->update_memory_info();` takes 0.112 ms (median)\n`RenderingDevice::update_perf_report()` takes 0.5105 ms (median)\n\nNot ideal, but it's still not great that over 0.62 milliseconds are being burned.\n\nNow here's the fun part, I initially created this issue while I was optimizing my project and things have changed, more specifically I've removed over ~100K unused GPUParticles3D nodes, and they actually do contribute to the issue because each individual instance allocates VRAM (Buffer Memory).\n\nBoth `vmaCalculateLazilyAllocatedBytes` and `vmaCalculateStatistics` mention in their doc comment\n\n> This function is called \"calculate\" not \"get\" because it has to traverse all\n> internal data structures, so it may be quite slow.\n\nSo when artificially adding them back, \n\n`RSG::utilities->update_memory_info();` takes 1.354 ms (median)\n`RenderingDevice::update_perf_report()` takes 1.558 ms (median)\n\nIt burns almost 3ms, which eats away 20 of my FPS bringing me to down to 70....\n\nHere is the script I used to artificially add them back if you would like to test it as well\n\n```gdscript\nextends Node\n\n@export var amount: int = 100\n@export var count: int = 100_000\n@export var is_generated: bool:\n\tset(v):\n\t\tif v:\n\t\t\t_generate_particles()\n\t\telse:\n\t\t\t_remove_particles()\n\nvar _gpu_particles: Array[GPUParticles3D] = []\n\nfunc _generate_particles():\n\tfor i in count:\n\t\tvar particles := GPUParticles3D.new()\n\t\tparticles.amount = amount\n\t\t_gpu_particles.append(particles)\n\nfunc _remove_particles():\n\tfor g in _gpu_particles:\n\t\tg.amount = 1 # probaly not needed\n\t\tg.free()\n\t_gpu_particles.clear()\n\n```","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2708016161/reactions","total_count":2,"+1":2,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2708103946","html_url":"https://github.com/godotengine/godot/issues/102173#issuecomment-2708103946","issue_url":"https://api.github.com/repos/godotengine/godot/issues/102173","id":2708103946,"node_id":"IC_kwDOAO6SJc6hamMK","user":{"login":"clayjohn","id":16521339,"node_id":"MDQ6VXNlcjE2NTIxMzM5","avatar_url":"https://avatars.githubusercontent.com/u/16521339?v=4","gravatar_id":"","url":"https://api.github.com/users/clayjohn","html_url":"https://github.com/clayjohn","followers_url":"https://api.github.com/users/clayjohn/followers","following_url":"https://api.github.com/users/clayjohn/following{/other_user}","gists_url":"https://api.github.com/users/clayjohn/gists{/gist_id}","starred_url":"https://api.github.com/users/clayjohn/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/clayjohn/subscriptions","organizations_url":"https://api.github.com/users/clayjohn/orgs","repos_url":"https://api.github.com/users/clayjohn/repos","events_url":"https://api.github.com/users/clayjohn/events{/privacy}","received_events_url":"https://api.github.com/users/clayjohn/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-03-08T07:50:43Z","updated_at":"2025-03-08T07:50:43Z","body":"That's perfect, thank you","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2708103946/reactions","total_count":1,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":1,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2708308864","html_url":"https://github.com/godotengine/godot/issues/102173#issuecomment-2708308864","issue_url":"https://api.github.com/repos/godotengine/godot/issues/102173","id":2708308864,"node_id":"IC_kwDOAO6SJc6hbYOA","user":{"login":"darksylinc","id":3395130,"node_id":"MDQ6VXNlcjMzOTUxMzA=","avatar_url":"https://avatars.githubusercontent.com/u/3395130?v=4","gravatar_id":"","url":"https://api.github.com/users/darksylinc","html_url":"https://github.com/darksylinc","followers_url":"https://api.github.com/users/darksylinc/followers","following_url":"https://api.github.com/users/darksylinc/following{/other_user}","gists_url":"https://api.github.com/users/darksylinc/gists{/gist_id}","starred_url":"https://api.github.com/users/darksylinc/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/darksylinc/subscriptions","organizations_url":"https://api.github.com/users/darksylinc/orgs","repos_url":"https://api.github.com/users/darksylinc/repos","events_url":"https://api.github.com/users/darksylinc/events{/privacy}","received_events_url":"https://api.github.com/users/darksylinc/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-03-08T14:27:02Z","updated_at":"2025-03-08T14:27:02Z","body":"Submitted #103814 to deal with the update_perf_report problem","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2708308864/reactions","total_count":2,"+1":2,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null}]