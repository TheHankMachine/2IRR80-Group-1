on? i.e. `this->is_class(\"Node\") === this instanceof Node`?~~\r\n\r\nEdit: I believe the answer is \"yes\", at which point this is a solid way to implement this operation.","created_at":"2025-08-05T06:17:48Z","updated_at":"2025-08-05T06:53:37Z","html_url":"https://github.com/godotengine/godot/pull/105793#discussion_r2253263088","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/105793","_links":{"self":{"href":"https://api.github.com/repos/godotengine/godot/pulls/comments/2253263088"},"html":{"href":"https://github.com/godotengine/godot/pull/105793#discussion_r2253263088"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/105793"}},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/2253263088/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":2097,"original_line":2049,"side":"RIGHT","author_association":"CONTRIBUTOR","original_position":49,"position":31,"subject_type":"line"},{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/2253341925","pull_request_review_id":3086857542,"id":2253341925,"node_id":"PRRC_kwDOAO6SJc6GT0Tl","diff_hunk":"@@ -311,6 +311,22 @@ struct MethodInfo {\n class MethodBind;\n class GDExtension;\n \n+class GDType {\n+\tconst GDType *super_type;\n+\n+\tStringName name;\n+\t/// Contains all the class names in order:\n+\t/// `name` is the first element and `Object` is the last.\n+\tVector<StringName> name_hierarchy;","path":"core/object/object.h","commit_id":"c5021b1cba18502e241e414415b0c17ad5c988aa","original_commit_id":"c5021b1cba18502e241e414415b0c17ad5c988aa","user":{"login":"Shadows-of-Fire","id":3682588,"node_id":"MDQ6VXNlcjM2ODI1ODg=","avatar_url":"https://avatars.githubusercontent.com/u/3682588?v=4","gravatar_id":"","url":"https://api.github.com/users/Shadows-of-Fire","html_url":"https://github.com/Shadows-of-Fire","followers_url":"https://api.github.com/users/Shadows-of-Fire/followers","following_url":"https://api.github.com/users/Shadows-of-Fire/following{/other_user}","gists_url":"https://api.github.com/users/Shadows-of-Fire/gists{/gist_id}","starred_url":"https://api.github.com/users/Shadows-of-Fire/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Shadows-of-Fire/subscriptions","organizations_url":"https://api.github.com/users/Shadows-of-Fire/orgs","repos_url":"https://api.github.com/users/Shadows-of-Fire/repos","events_url":"https://api.github.com/users/Shadows-of-Fire/events{/privacy}","received_events_url":"https://api.github.com/users/Shadows-of-Fire/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"Is there a point to have this at all rather than traversing the chain of superclasses? It seems like the issue is (potentially) memory locality, but seeing as `StringName` is interned \"somewhere else\" (meaning the accesses to evaluate `==` will need to reach that \"else\"), the space used by having a `Vector` on each `GDType` might not be worth it.","created_at":"2025-08-05T06:59:21Z","updated_at":"2025-08-05T07:00:32Z","html_url":"https://github.com/godotengine/godot/pull/105793#discussion_r2253341925","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/105793","_links":{"self":{"href":"https://api.github.com/repos/godotengine/godot/pulls/comments/2253341925"},"html":{"href":"https://github.com/godotengine/godot/pull/105793#discussion_r2253341925"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/105793"}},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/2253341925/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":null,"original_line":320,"side":"RIGHT","author_association":"CONTRIBUTOR","original_position":10,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/2253534090","pull_request_review_id":3087132549,"id":2253534090,"node_id":"PRRC_kwDOAO6SJc6GUjOK","diff_hunk":"@@ -311,6 +311,22 @@ struct MethodInfo {\n class MethodBind;\n class GDExtension;\n \n+class GDType {\n+\tconst GDType *super_type;\n+\n+\tStringName name;\n+\t/// Contains all the class names in order:\n+\t/// `name` is the first element and `Object` is the last.\n+\tVector<StringName> name_hierarchy;","path":"core/object/object.h","commit_id":"c5021b1cba18502e241e414415b0c17ad5c988aa","original_commit_id":"c5021b1cba18502e241e414415b0c17ad5c988aa","user":{"login":"Ivorforce","id":2308167,"node_id":"MDQ6VXNlcjIzMDgxNjc=","avatar_url":"https://avatars.githubusercontent.com/u/2308167?v=4","gravatar_id":"","url":"https://api.github.com/users/Ivorforce","html_url":"https://github.com/Ivorforce","followers_url":"https://api.github.com/users/Ivorforce/followers","following_url":"https://api.github.com/users/Ivorforce/following{/other_user}","gists_url":"https://api.github.com/users/Ivorforce/gists{/gist_id}","starred_url":"https://api.github.com/users/Ivorforce/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Ivorforce/subscriptions","organizations_url":"https://api.github.com/users/Ivorforce/orgs","repos_url":"https://api.github.com/users/Ivorforce/repos","events_url":"https://api.github.com/users/Ivorforce/events{/privacy}","received_events_url":"https://api.github.com/users/Ivorforce/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"I benchmarked a 3x speed improvement over the old `is_class` (hot access, cold should be even better). Having a `Vector<StringName>` for each `GDType` is not a big cost, so I'd argue it's worth it.\r\nHowever, I've been second guessing adding this in the first \"GDType\" draft so I might revise / supersede the PR soon and propose this change later.","created_at":"2025-08-05T08:22:30Z","updated_at":"2025-08-05T08:22:31Z","html_url":"https://github.com/godotengine/godot/pull/105793#discussion_r2253534090","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/105793","_links":{"self":{"href":"https://api.github.com/repos/godotengine/godot/pulls/comments/2253534090"},"html":{"href":"https://github.com/godotengine/godot/pull/105793#discussion_r2253534090"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/105793"}},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/2253534090/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":null,"original_line":320,"side":"RIGHT","in_reply_to_id":2253341925,"author_association":"MEMBER","original_position":10,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/2253535633","pull_request_review_id":3087134577,"id":2253535633,"node_id":"PRRC_kwDOAO6SJc6GUjmR","diff_hunk":"@@ -2026,18 +2037,34 @@ uint32_t Object::get_edited_version() const {\n }\n #endif\n \n+const GDType &Object::get_gdtype() const {\n+\tif (unlikely(!_gdtype_ptr)) {\n+\t\t// While class is initializing / deinitializing, constructors and destructors\n+\t\t// need access to the proper type at the proper stage.\n+\t\treturn _get_typev();\n+\t}\n+\treturn *_gdtype_ptr;\n+}\n+\n+bool Object::is_class(const String &p_class) const {","path":"core/object/object.cpp","commit_id":"ac85d24e6470e040ba0656a4a0764f30b0eb61aa","original_commit_id":"c5021b1cba18502e241e414415b0c17ad5c988aa","user":{"login":"Ivorforce","id":2308167,"node_id":"MDQ6VXNlcjIzMDgxNjc=","avatar_url":"https://avatars.githubusercontent.com/u/2308167?v=4","gravatar_id":"","url":"https://api.github.com/users/Ivorforce","html_url":"https://github.com/Ivorforce","followers_url":"https://api.github.com/users/Ivorforce/followers",