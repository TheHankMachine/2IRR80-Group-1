s/Shadows-of-Fire/following{/other_user}","gists_url":"https://api.github.com/users/Shadows-of-Fire/gists{/gist_id}","starred_url":"https://api.github.com/users/Shadows-of-Fire/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Shadows-of-Fire/subscriptions","organizations_url":"https://api.github.com/users/Shadows-of-Fire/orgs","repos_url":"https://api.github.com/users/Shadows-of-Fire/repos","events_url":"https://api.github.com/users/Shadows-of-Fire/events{/privacy}","received_events_url":"https://api.github.com/users/Shadows-of-Fire/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"In the theme of promoting the type-first architecture, maybe this PR should introduce `Object::is_subtype_of(GDType const&)` (optionally with an `is_subtype_of(String)` overload that resolves the type and calls the other one).\r\n\r\nI realize right now we do a lot of \"pass the StringName around and do lookups with it\", but we ought to be in the mindset of \"Pass the GDType around and do stuff with that directly\"","created_at":"2025-08-05T08:31:48Z","updated_at":"2025-08-05T08:31:48Z","html_url":"https://github.com/godotengine/godot/pull/105793#discussion_r2253556791","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/105793","_links":{"self":{"href":"https://api.github.com/repos/godotengine/godot/pulls/comments/2253556791"},"html":{"href":"https://github.com/godotengine/godot/pull/105793#discussion_r2253556791"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/105793"}},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/2253556791/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":2097,"original_line":2049,"side":"RIGHT","in_reply_to_id":2253263088,"author_association":"CONTRIBUTOR","original_position":49,"position":31,"sub