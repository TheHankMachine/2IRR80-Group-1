BeWi/following{/other_user}","gists_url":"https://api.github.com/users/KoBeWi/gists{/gist_id}","starred_url":"https://api.github.com/users/KoBeWi/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/KoBeWi/subscriptions","organizations_url":"https://api.github.com/users/KoBeWi/orgs","repos_url":"https://api.github.com/users/KoBeWi/repos","events_url":"https://api.github.com/users/KoBeWi/events{/privacy}","received_events_url":"https://api.github.com/users/KoBeWi/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-01-07T23:11:38Z","updated_at":"2025-01-07T23:11:38Z","body":"Should be fixed now, although I had to modify EditorFileDialog to emit `file_selected` before hiding. This might break some code.","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2576401766/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2577740929","html_url":"https://github.com/godotengine/godot/pull/99844#issuecomment-2577740929","issue_url":"https://api.github.com/repos/godotengine/godot/issues/99844","id":2577740929,"node_id":"IC_kwDOAO6SJc6ZpTSB","user":{"login":"Hilderin","id":81109165,"node_id":"MDQ6VXNlcjgxMTA5MTY1","avatar_url":"https://avatars.githubusercontent.com/u/81109165?v=4","gravatar_id":"","url":"https://api.github.com/users/Hilderin","html_url":"https://github.com/Hilderin","followers_url":"https://api.github.com/users/Hilderin/followers","following_url":"https://api.github.com/users/Hilderin/following{/other_user}","gists_url":"https://api.github.com/users/Hilderin/gists{/gist_id}","starred_url":"https://api.github.com/users/Hilderin/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Hilderin/subscriptions","organizations_url":"https://api.github.com/