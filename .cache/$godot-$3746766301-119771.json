[{"id":4363008255,"node_id":"PRR_kwDOAO6SJc8AAAABBA44_w","state":"CHANGES_REQUESTED","commit_id":"09e96543dcf05d5bb16de839e76fefc73524ead6","user":{"site_admin":false,"suspended":false,"updated_at":"0001-01-01T00:00:00Z","avatar_url":"https://avatars.githubusercontent.com/u/176927541?u=25817fe797fcc7a812ba9d7f58f593f5a003abbb&v=4","created_at":"0001-01-01T00:00:00Z","followers":0,"following":0,"html_url":"https://github.com/syntaxerror247","id":176927541,"node_id":"U_kgDOCouzNQ","login":"syntaxerror247","type":"User","owned_private_repos":0,"public_gists":0,"public_repos":0,"total_private_repos":0,"url":"https://api.github.com/users/syntaxerror247"},"body":"I have a few concerns here: \n\n1. Users can extend the build directory with custom code and files, such as notification icons, modifying gradle dependencies, and other changes. If we auto delete the build directory when exporting from a newer version, users could accidentally lose those modifications. So instead, I think we should only install the build template when it is not already present. If there is a version mismatch, we should show a dialog with two actions: Open the existing build directory, so users can review or copy their modifications if needed. And delete and reinstall the gradle template.\n\n2. We should also keep the `Install Android Build Template` menu option. When the Android export template is not present or downloaded, it currently provides an option to Install from a file.\nRemoving this dialog would remove the ability to manually install a build template.","html_url":"https://github.com/godotengine/godot/pull/119771#pullrequestreview-4363008255","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/119771","author_association":"MEMBER","submitted_at":"2026-05-26T10:40:23Z"},{"id":4842244358,"node_id":"PRR_kwDOAO6SJc8AAAABIJ7JBg","state":"COMMENTED","commit_id":"664ff25ea19c809b18cc688b69f909f929cb7360","user":{"site_admin":false,"suspended":false,"updated_at":"0001-01-01T00:00:00Z","avatar_url":"https://avatars.githubusercontent.com/u/176927541?u=25817fe797fcc7a812ba9d7f58f593f5a003abbb&v=4","created_at":"0001-01-01T00:00:00Z","followers":0,"following":0,"html_url":"https://github.com/syntaxerror247","id":176927541,"node_id":"U_kgDOCouzNQ","login":"syntaxerror247","type":"User","owned_private_repos":0,"public_gists":0,"public_repos":0,"total_private_repos":0,"url":"https://api.github.com/users/syntaxerror247"},"body":"","html_url":"https://github.com/godotengine/godot/pull/119771#pullrequestreview-4842244358","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/119771","author_association":"MEMBER","submitted_at":"2026-08-03T08:40:41Z"},{"id":4842509158,"node_id":"PRR_kwDOAO6SJc8AAAABIKLTZg","state":"COMMENTED","commit_id":"664ff25ea19c809b18cc688b69f909f929cb7360","user":{"site_admin":false,"suspended":false,"updated_at":"0001-01-01T00:00:00Z","avatar_url":"https://avatars.githubusercontent.com/u/176927541?u=25817fe797fcc7a812ba9d7f58f593f5a003abbb&v=4","created_at":"0001-01-01T00:00:00Z","followers":0,"following":0,"html_url":"https://github.com/syntaxerror247","id":176927541,"node_id":"U_kgDOCouzNQ","login":"syntaxerror247","type":"User","owned_private_repos":0,"public_gists":0,"public_repos":0,"total_private_repos":0,"url":"https://api.github.com/users/syntaxerror247"},"body":"","html_url":"https://github.com/godotengine/godot/pull/119771#pullrequestreview-4842509158","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/119771","author_association":"MEMBER","submitted_at":"2026-08-03T09:16:50Z"},{"id":4842526784,"node_id":"PRR_kwDOAO6SJc8AAAABIKMYQA","state":"COMMENTED","commit_id":"664ff25ea19c809b18cc688b69f909f929cb7360","user":{"site_admin":false,"suspended":false,"updated_at":"0001-01-01T00:00:00Z","avatar_url":"https://avatars.githubusercontent.com/u/176927541?u=25817fe797fcc7a812ba9d7f58f593f5a003abbb&v=4","created_at":"0001-01-01T00:00:00Z","followers":0,"following":0,"html_url":"