_by":null},{"id":2666705648,"node_id":"MDU6TGFiZWwyNjY2NzA1NjQ4","url":"https://api.github.com/repos/godotengine/godot/labels/topic:animation","name":"topic:animation","color":"ffee88","default":false,"description":"","archived_at":null,"archived_by":null}],"state":"open","locked":false,"assignees":[],"milestone":{"url":"https://api.github.com/repos/godotengine/godot/milestones/16","html_url":"https://github.com/godotengine/godot/milestone/16","labels_url":"https://api.github.com/repos/godotengine/godot/milestones/16/labels","id":8237783,"node_id":"MI_kwDOAO6SJc4AfbLX","number":16,"title":"4.x","description":"Issues and pull requests slated for an undetermined Godot 4 release.","creator":{"login":"akien-mga","id":4701338,"node_id":"MDQ6VXNlcjQ3MDEzMzg=","avatar_url":"https://avatars.githubusercontent.com/u/4701338?v=4","gravatar_id":"","url":"https://api.github.com/users/akien-mga","html_url":"https://github.com/akien-mga","followers_url":"https://api.github.com/users/akien-mga/followers","following_url":"https://api.github.com/users/akien-mga/following{/other_user}","gists_url":"https://api.github.com/users/akien-mga/gists{/gist_id}","starred_url":"https://api.github.com/users/akien-mga/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/akien-mga/subscriptions","organizations_url":"https://api.github.com/users/akien-mga/orgs","repos_url":"https://api.github.com/users/akien-mga/repos","events_url":"https://api.github.com/users/akien-mga/events{/privacy}","received_events_url":"https://api.github.com/users/akien-mga/received_events","type":"User","user_view_type":"public","site_admin":false},"open_issues":5790,"closed_issues":0,"state":"open","created_at":"2022-07-26T12:42:05Z","updated_at":"2026-10-22T08:16:48Z","due_on":null,"closed_at":null},"comments":4,"created_at":"2026-10-03T16:45:48Z","updated_at":"2026-10-06T19:27:02Z","closed_at":null,"assignee":null,"author_association":"CONTRIBUTOR","issue_field_values":[],"type":null,"active_lock_reason":null,"draft":false,"pull_request":{"url":"https://api.github.com/repos/godotengine/godot/pulls/124133","html_url":"https://github.com/godotengine/godot/pull/124133","diff_url":"https://github.com/godotengine/godot/pull/124133.diff","patch_url":"https://github.com/godotengine/godot/pull/124133.patch","merged_at":null},"body":"**What problem(s) does this PR solve?**\r\nCalling set_length, set_loop_mode, or set_step on an Animation always emits the changed signal, even if the value has not changed. When multiple AnimationPlayer or AnimationMixer nodes share the same animation resource, setting any of these properties clears and rebuilds the animation caches for every player on the next frame.\r\n\r\nThis becomes a performance issue when many instanced nodes share a single animation resource and set properties like loop_mode before calling play. One character setting a property to its existing value triggers an unnecessary cache rebuild for all other instances.\r\n\r\nAdds early returns to these three setters when the new value equals the current value, matching the standard setter behavior used throughout the engine.\r\n\r\n**Additional information**\r\nIncludes unit tests in test_animation.cpp ensuring changed is emitted only when values actually change. Tested with 200 AnimationPlayer instances sharing a single animation, where avoiding unnecessary cache rebuilds significantly reduces frame overhead.","closed_by":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/124133/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/godotengine/godot/issues/124133/timeline","performed_via_github_app":null,"state_reason":null}