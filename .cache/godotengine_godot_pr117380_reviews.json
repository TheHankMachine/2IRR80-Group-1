 to Vertex:**\r\n  - Hold (shortcut key) to highlight another node's vertex, then click to teleport the selected node to the highlighted vertex.","state":"COMMENTED","html_url":"https://github.com/godotengine/godot/pull/117380#pullrequestreview-3956083457","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/117380","author_association":"MEMBER","_links":{"html":{"href":"https://github.com/godotengine/godot/pull/117380#pullrequestreview-3956083457"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/117380"}},"submitted_at":"2026-03-16T19:16:14Z","commit_id":null},{"id":3956700383,"node_id":"PRR_kwDOAO6SJc7r1nTf","user":{"login":"Calinou","id":180032,"node_id":"MDQ6VXNlcjE4MDAzMg==","avatar_url":"https://avatars.githubusercontent.com/u/180032?u=68d23e7ee9cdf810da125e8510b72f845b9dccc8&v=4","gravatar_id":"","url":"https://api.github.com/users/Calinou","html_url":"https://github.com/Calinou","followers_url":"https://api.github.com/users/Calinou/followers","following_url":"https://api.github.com/users/Calinou/following{/other_user}","gists_url":"https://api.github.com/users/Calinou/gists{/gist_id}","starred_url":"https://api.github.com/users/Calinou/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Calinou/subscriptions","organizations_url":"https://api.github.com/users/Calinou/orgs","repos_url":"https://api.github.com/users/Calinou/repos","events_url":"https://api.github.com/users/Calinou/events{/privacy}","received_events_url":"https://api.github.com/users/Calinou/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"","state":"COMMENTED","html_url":"https://github.com/godotengine/godot/pull/117380#pullrequestreview-3956700383","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/117380","author_association":"MEMBER","_links":{"html":{"href":"https://github.com/godotengine/godot/pull/117380#pullrequestreview-3956700383"},"pull_request":{"href":"htt