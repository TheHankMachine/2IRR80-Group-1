api.github.com/repos/godotengine/godot/issues/comments/5704658855/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5721188689","html_url":"https://github.com/godotengine/godot/issues/123125#issuecomment-5721188689","issue_url":"https://api.github.com/repos/godotengine/godot/issues/123125","id":5721188689,"node_id":"IC_kwDOAO6SJc8AAAABVQJpUQ","user":{"login":"romgerman","id":1517367,"node_id":"MDQ6VXNlcjE1MTczNjc=","avatar_url":"https://avatars.githubusercontent.com/u/1517367?v=4","gravatar_id":"","url":"https://api.github.com/users/romgerman","html_url":"https://github.com/romgerman","followers_url":"https://api.github.com/users/romgerman/followers","following_url":"https://api.github.com/users/romgerman/following{/other_user}","gists_url":"https://api.github.com/users/romgerman/gists{/gist_id}","starred_url":"https://api.github.com/users/romgerman/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/romgerman/subscriptions","organizations_url":"https://api.github.com/users/romgerman/orgs","repos_url":"https://api.github.com/users/romgerman/repos","events_url":"https://api.github.com/users/romgerman/events{/privacy}","received_events_url":"https://api.github.com/users/romgerman/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-09-17T21:03:08Z","updated_at":"2026-09-17T21:06:15Z","body":"> Could you try to isolate the performance regression to a smaller scene that you can upload here?\n\nI just tried running a 3d demo scene from this addon https://store.godotengine.org/asset/antz/antz-debug-menu/. It looks like when you run a scene for the first time (or after converting a project to a newer version, 4.7 in my case, I had the 10FPS difference I was talking about) it runs worse than after launching the project for the second time (fully restarting the editor and all). In comparison to 4.6 I had at most 5FPS difference in the end. I had disabled vsync before tests and ran it at 1600x900 in an embeded window. It also feels more choppy in 4.7 (?) but that maybe that weird thing when you run the game in a window and it \"lags\" for some reason, but then you run it again and it's fine.","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5721188689/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null}]