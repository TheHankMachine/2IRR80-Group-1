[{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2589924834","html_url":"https://github.com/godotengine/godot/pull/101531#issuecomment-2589924834","issue_url":"https://api.github.com/repos/godotengine/godot/issues/101531","id":2589924834,"node_id":"IC_kwDOAO6SJc6aXx3i","user":{"login":"dsnopek","id":191561,"node_id":"MDQ6VXNlcjE5MTU2MQ==","avatar_url":"https://avatars.githubusercontent.com/u/191561?v=4","gravatar_id":"","url":"https://api.github.com/users/dsnopek","html_url":"https://github.com/dsnopek","followers_url":"https://api.github.com/users/dsnopek/followers","following_url":"https://api.github.com/users/dsnopek/following{/other_user}","gists_url":"https://api.github.com/users/dsnopek/gists{/gist_id}","starred_url":"https://api.github.com/users/dsnopek/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/dsnopek/subscriptions","organizations_url":"https://api.github.com/users/dsnopek/orgs","repos_url":"https://api.github.com/users/dsnopek/repos","events_url":"https://api.github.com/users/dsnopek/events{/privacy}","received_events_url":"https://api.github.com/users/dsnopek/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-01-14T13:34:11Z","updated_at":"2025-01-14T13:34:11Z","body":"Removing an unused virtual method should be fine.\r\n\r\nWhen a virtual method is called, Godot asks the GDExtension if it has an implementation of that virtual method. Removing the virtual method basically means Godot will never ask, which won't lead to any crashes or anything.\r\n\r\nThe only compatibility break would be if existing GDExtensions had implementations of this virtual method, and their functionality depended on it being called. But since it's unused, there shouldn't be any such GDExtensions.","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2589924834/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null}]