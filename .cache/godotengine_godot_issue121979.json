08:31Z","updated_at":"2026-08-03T19:27:04Z","closed_at":"2026-08-03T19:26:59Z","assignee":null,"author_association":"CONTRIBUTOR","issue_field_values":[],"type":null,"active_lock_reason":null,"draft":false,"pull_request":{"url":"https://api.github.com/repos/godotengine/godot/pulls/121979","html_url":"https://github.com/godotengine/godot/pull/121979","diff_url":"https://github.com/godotengine/godot/pull/121979.diff","patch_url":"https://github.com/godotengine/godot/pull/121979.patch","merged_at":"2026-08-03T19:26:59Z"},"body":"I'm contributing to [Museum of All Things](https://github.com/m4ym4y/museum-of-all-things), which dynamically downloads hundreds of images (in an average play session) from the Wikipedia to display in a 3D museum.\r\n\r\nBecause it's downloading these images as PNGs, JPEGs, etc they are uploaded to the GPU uncompressed. On mobile, this means we're using more of our scarce VRAM, as well as more memory bandwidth (which can have a large impact on performance).\r\n\r\nI think compressing the images as ETC could help with this!\r\n\r\nUnfortunately, Godot only supports ETC (and S3TC) compression on editor builds, without a SCons option to enable them on export templates.\r\n\r\nIn https://github.com/godotengine/godot/pull/111015, a SCons option was added to allow including CVTT and Betsy compression in export templates, so this PR adds a similar option for S3TC and ETC!\r\n\r\nIt's disabled by default, so official Godot builds will still only include this in editor builds; developers will need to compile Godot themselves to turn this on.","closed_by":{"login":"Repiteo","id":17489292,"node_id":"MDQ6VXNlcjE3NDg5Mjky","avatar_url":"https://avatars.githubusercontent.com/u/17489292?v=4","gravatar_id":"","url":"https://api.github.com/users/Repiteo","html_url":"https://github.com/Repiteo","followers_url":"https://api.github.com/users/Repiteo/followers","following_url":"https://api.github.com/users/Repiteo/following{/other_user}","gists_url":"https://api.github.com/users/Repiteo/gists{/gist_id}","starred_url":"https://api.github.com/users/Repiteo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Repiteo/subscriptions","organizations_url":"https://api.github.com/users/Repiteo/orgs","repos_url":"https://api.github.com/users/Repiteo/repos","events_url":"https://api.github.com/users/Repiteo/events{/privacy}","received_events_url":"https://api.github.com/users/Repiteo/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/121979/reactions","total_count":2,"+1":2,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/godotengine/godot/issues/121979/timeline","performed_via_github_app":null,"state_reason":null}