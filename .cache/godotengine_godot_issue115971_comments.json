ps://api.github.com/repos/godotengine/godot/issues/comments/4179200369/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4389647212","html_url":"https://github.com/godotengine/godot/issues/115971#issuecomment-4389647212","issue_url":"https://api.github.com/repos/godotengine/godot/issues/115971","id":4389647212,"node_id":"IC_kwDOAO6SJc8AAAABBaSzbA","user":{"login":"hpvb","id":2591099,"node_id":"MDQ6VXNlcjI1OTEwOTk=","avatar_url":"https://avatars.githubusercontent.com/u/2591099?v=4","gravatar_id":"","url":"https://api.github.com/users/hpvb","html_url":"https://github.com/hpvb","followers_url":"https://api.github.com/users/hpvb/followers","following_url":"https://api.github.com/users/hpvb/following{/other_user}","gists_url":"https://api.github.com/users/hpvb/gists{/gist_id}","starred_url":"https://api.github.com/users/hpvb/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/hpvb/subscriptions","organizations_url":"https://api.github.com/users/hpvb/orgs","repos_url":"https://api.github.com/users/hpvb/repos","events_url":"https://api.github.com/users/hpvb/events{/privacy}","received_events_url":"https://api.github.com/users/hpvb/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-05-06T15:33:13Z","updated_at":"2026-05-06T15:33:13Z","body":"> Ideally the ID generation for these unique node IDs would be made stable instead, perhaps by seeding it with the UID of the scene along with the node path, or something like that.\n\nI don't think that is going to work, `Resource::generate_scene_unique_id()` is a static method, it doesn't know what it is generating an UID for. \n\nI think filtering them out on export is probably the correct fix. ","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4389647212/reactions","total_count":2,"+1":2,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4501681897","html_url":"https://github.com/godotengine/godot/issues/115971#issuecomment-4501681897","issue_url":"https://api.github.com/repos/godotengine/godot/issues/115971","id":4501681897,"node_id":"IC_kwDOAO6SJc8AAAABDFI26Q","user":{"login":"KoBeWi","id":2223172,"node_id":"MDQ6VXNlcjIyMjMxNzI=","avatar_url":"https://avatars.githubusercontent.com/u/2223172?v=4","gravatar_id":"","url":"https://api.github.com/users/KoBeWi","html_url":"https://github.com/KoBeWi","followers_url":"https://api.github.com/users/KoBeWi/followers","following_url":"https://api.github.com/users/KoBeWi/following{/other_user}","gists_url":"https://api.github.com/users/KoBeWi/gists{/gist_id}","starred_url":"https://api.github.com/users/KoBeWi/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/KoBeWi/subscriptions","organizations_url":"https://api.github.com/users/KoBeWi/orgs","repos_url":"https://api.github.com/users/KoBeWi/repos","events_url":"https://api.github.com/users/KoBeWi/events{/privacy}","received_events_url":"https://api.github.com/users/KoBeWi/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-05-20T19:00:57Z","updated_at":"2026-05-20T19:00:57Z","body":"> If you're working on a large-scale project with hundreds/thousands of scenes this is also less likely to happen naturally, assuming you don't know to run the \"Upgrade Project Files...\" tool after upgrading to 4.6.\n\nSo what's the problem with running the upgrade tool? That's what it is for.","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4501681897/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"hear