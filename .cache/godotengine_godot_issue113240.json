d":"MDU6TGFiZWwyOTA5OTAwODUw","url":"https://api.github.com/repos/godotengine/godot/labels/topic:export","name":"topic:export","color":"ffee88","default":false,"description":"","archived_at":null,"archived_by":null}],"state":"open","locked":false,"assignees":[],"milestone":{"url":"https://api.github.com/repos/godotengine/godot/milestones/16","html_url":"https://github.com/godotengine/godot/milestone/16","labels_url":"https://api.github.com/repos/godotengine/godot/milestones/16/labels","id":8237783,"node_id":"MI_kwDOAO6SJc4AfbLX","number":16,"title":"4.x","description":"Issues and pull requests slated for an undetermined Godot 4 release.","creator":{"login":"akien-mga","id":4701338,"node_id":"MDQ6VXNlcjQ3MDEzMzg=","avatar_url":"https://avatars.githubusercontent.com/u/4701338?v=4","gravatar_id":"","url":"https://api.github.com/users/akien-mga","html_url":"https://github.com/akien-mga","followers_url":"https://api.github.com/users/akien-mga/followers","following_url":"https://api.github.com/users/akien-mga/following{/other_user}","gists_url":"https://api.github.com/users/akien-mga/gists{/gist_id}","starred_url":"https://api.github.com/users/akien-mga/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/akien-mga/subscriptions","organizations_url":"https://api.github.com/users/akien-mga/orgs","repos_url":"https://api.github.com/users/akien-mga/repos","events_url":"https://api.github.com/users/akien-mga/events{/privacy}","received_events_url":"https://api.github.com/users/akien-mga/received_events","type":"User","user_view_type":"public","site_admin":false},"open_issues":5796,"closed_issues":0,"state":"open","created_at":"2022-07-26T12:42:05Z","updated_at":"2026-10-21T09:35:07Z","due_on":null,"closed_at":null},"comments":0,"created_at":"2025-11-27T15:21:57Z","updated_at":"2026-08-18T11:22:40Z","closed_at":null,"assignee":null,"author_association":"CONTRIBUTOR","issue_field_values":[],"type":null,"active_lock_reason":null,"draft":true,"pull_request":{"url":"https://api.github.com/repos/godotengine/godot/pulls/113240","html_url":"https://github.com/godotengine/godot/pull/113240","diff_url":"https://github.com/godotengine/godot/pull/113240.diff","patch_url":"https://github.com/godotengine/godot/pull/113240.patch","merged_at":null},"body":"> [!IMPORTANT]\r\n> This currently depends on (and therefore includes) #112764. To see the actual relevant changes, open just the last commit, or see [this](https://github.com/mihe/godot/compare/export-cleanup...mihe:godot:export-source-path-filtering) diff.\r\n\r\nThe filter text fields that can be found in both the \"Encryption\" and \"Patching\" tabs in the export dialog are currently a bit strange, as they operate solely on the exported/remapped paths of resources. This means that if you want to (for example) include/exclude all the textures that you have in your `res://textures/` folder, you will be unable to do so, because once exported all textures will typically end up in a flat structure, with a path in the format of `res://.godot/imported/[name].[ext]-[hash].ctex`.\r\n\r\nThis fixes that, with the help of the `source_path` property/parameter introduced in #112764, by also checking if the filters apply to the source path.\r\n\r\nNote that this is technically a breaking change, since the encryption filters will now potentially apply to paths that maybe they weren't meant to. I do however think that this is a worthwhile breakage, and I have a hard time imagining there being many projects out there that would be impacted by this.","closed_by":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/113240/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/godotengine/godot/issues/113240/timeline","performed_via_github_app":null,"state_reason":null}