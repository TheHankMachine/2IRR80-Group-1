33:45Z","updated_at":"2026-03-19T20:45:36Z","closed_at":"2026-03-19T20:45:09Z","assignee":null,"author_association":"CONTRIBUTOR","issue_field_values":[],"type":null,"active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"### Tested versions\n\nReproducible in: v4.7.dev.custom_build [a9afde840]\nNot reproducible in: v4.6.1.stable.official [14d19694e]\n\n### System information\n\nGodot v4.7.dev (a9afde840) - macOS Tahoe (26.3.1) - Multi-window, 2 monitors - Metal (Forward+) - integrated Apple M1 Max (Apple7) - Apple M1 Max (10 threads) - 32.00 GiB memory\n\n### Issue description\n\nThe AnimationTree editor no longer saves blend points for BlendSpace1D nodes.  Blend points added in the session do not register, and an error is produced on play.  \n\n### Steps to reproduce\n\n1. Open MRP (or create a new project).\n2. Add an AnimationTree (configured with an AnimationPlayer) with its root set to AnimationNodeBlendSpace1D\n    - You will see an error: \n        - `AnimationNodeBlendSpace1D at 'parameters/' has errors.  No blend points exist, so blending cannot take place.`\n3. Add a blend point anywhere (Click -> Add Animation -> Some Animation)\n    - The new blend point will appear in the blendspace editor\n5. Run the scene: the following errors will be produced\n    - `E add_blend_point: Condition \"p_name == StringName()\" is true.\n  <C++ Source>  scene/animation/animation_blend_space_1d.cpp:149 @ add_blend_point()`\n    - `E set_blend_point_position: Index p_point = 0 is out of bounds (blend_points_used = 0).\n  <C++ Source>  scene/animation/animation_blend_space_1d.cpp:170 @ set_blend_point_position()`\n    - `E set_blend_point_position: Index p_point = 0 is out of bounds (blend_points_used = 0).\n  <C++ Source>  scene/animation/animation_blend_space_1d.cpp:170 @ set_blend_point_position()`\n\nSaving the scene will not save the newly-added blend point.\n\nThe MRP has this set up, so just attempting to add an Animation to the AnimationTree's root BlendSpace1D will show this error.\n\n### Minimal reproduction project (MRP)\n\n[no-blendspace-points_2026-03-16_17-27-28.zip](https://github.com/user-attachments/files/26037794/no-blendspace-points_2026-03-16_17-27-28.zip)","closed_by":{"login":"Repiteo","id":17489292,"node_id":"MDQ6VXNlcjE3NDg5Mjky","avatar_url":"https://avatars.githubusercontent.com/u/17489292?v=4","gravatar_id":"","url":"https://api.github.com/users/Repiteo","html_url":"https://github.com/Repiteo","followers_url":"https://api.github.com/users/Repiteo/followers","following_url":"https://api.github.com/users/Repiteo/following{/other_user}","gists_url":"https://api.github.com/users/Repiteo/gists{/gist_id}","starred_url":"https://api.github.com/users/Repiteo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Repiteo/subscriptions","organizations_url":"https://api.github.com/users/Repiteo/orgs","repos_url":"https://api.github.com/users/Repiteo/repos","events_url":"https://api.github.com/users/Repiteo/events{/privacy}","received_events_url":"https://api.github.com/users/Repiteo/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/117490/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/godotengine/godot/issues/117490/timeline","performed_via_github_app":null,"state_reason":"completed","pinned_comment":null}