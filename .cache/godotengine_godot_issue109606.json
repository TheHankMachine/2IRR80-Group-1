(party_positions.values(), TYPE_OBJECT, &\"Hero\", Hero)\n\n```\n\n### Minimal reproduction project (MRP)\n\n[typed_test_2025-08-14_12-44-53.zip](https://github.com/user-attachments/files/21771130/typed_test_2025-08-14_12-44-53.zip)","closed_by":{"login":"FFF27","id":19473020,"node_id":"MDQ6VXNlcjE5NDczMDIw","avatar_url":"https://avatars.githubusercontent.com/u/19473020?v=4","gravatar_id":"","url":"https://api.github.com/users/FFF27","html_url":"https://github.com/FFF27","followers_url":"https://api.github.com/users/FFF27/followers","following_url":"https://api.github.com/users/FFF27/following{/other_user}","gists_url":"https://api.github.com/users/FFF27/gists{/gist_id}","starred_url":"https://api.github.com/users/FFF27/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/FFF27/subscriptions","organizations_url":"https://api.github.com/users/FFF27/orgs","repos_url":"https://api.github.com/users/FFF27/repos","events_url":"https://api.github.com/users/FFF27/events{/privacy}","received_events_url":"https://api.github.com/users/FFF27/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/109606/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/godotengine/godot/issues/109606/timeline","performed_via_github_app":null,"state_reason":"completed","pinned_comment":null}