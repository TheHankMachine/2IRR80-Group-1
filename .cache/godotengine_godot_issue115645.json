rchived_by":null},{"id":1332303119,"node_id":"MDU6TGFiZWwxMzMyMzAzMTE5","url":"https://api.github.com/repos/godotengine/godot/labels/regression","name":"regression","color":"ff63ac","default":false,"description":"","archived_at":null,"archived_by":null}],"state":"closed","locked":false,"assignees":[],"milestone":{"url":"https://api.github.com/repos/godotengine/godot/milestones/24","html_url":"https://github.com/godotengine/godot/milestone/24","labels_url":"https://api.github.com/repos/godotengine/godot/milestones/24/labels","id":14236899,"node_id":"MI_kwDOAO6SJc4A2Tzj","number":24,"title":"4.7","description":"","creator":{"login":"akien-mga","id":4701338,"node_id":"MDQ6VXNlcjQ3MDEzMzg=","avatar_url":"https://avatars.githubusercontent.com/u/4701338?v=4","gravatar_id":"","url":"https://api.github.com/users/akien-mga","html_url":"https://github.com/akien-mga","followers_url":"https://api.github.com/users/akien-mga/followers","following_url":"https://api.github.com/users/akien-mga/following{/other_user}","gists_url":"https://api.github.com/users/akien-mga/gists{/gist_id}","starred_url":"https://api.github.com/users/akien-mga/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/akien-mga/subscriptions","organizations_url":"https://api.github.com/users/akien-mga/orgs","repos_url":"https://api.github.com/users/akien-mga/repos","events_url":"https://api.github.com/users/akien-mga/events{/privacy}","received_events_url":"https://api.github.com/users/akien-mga/received_events","type":"User","user_view_type":"public","site_admin":false},"open_issues":3,"closed_issues":2535,"state":"closed","created_at":"2025-11-27T20:29:18Z","updated_at":"2026-10-20T18:39:31Z","due_on":null,"closed_at":"2026-06-19T16:54:35Z"},"comments":1,"created_at":"2026-01-30T17:46:53Z","updated_at":"2026-02-06T14:24:08Z","closed_at":"2026-02-06T14:23:30Z","assignee":null,"author_association":"NONE","issue_field_values":[],"type":null,"active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"### Tested versions\n\nReproducible in version 4.6 does not work as previous version. \n\nNon-reproducible in version 4.5.1 works as intended.\n\n\n\n### System information\n\nGodot v4.6.stable - Windows 11 (build 26200) - Multi-window, 1 monitor - Vulkan (Forward+) - dedicated NVIDIA GeForce RTX 4060 (NVIDIA; 32.0.15.6094) - 12th Gen Intel(R) Core(TM) i5-12600KF (16 threads) - 31.83 GiB memory\n\n### Issue description\n\nThe camera node was set as a separate scene, has a child with a custom script known as \"camera switch area\", that node has a child CollisionShape3D. In order to edit the collision shape the camera was made local then editable children was selected. Make unique was attempted to be selected but it was grayed out and unable to be used as intended, unfortunately.\n\n<img width=\"2302\" height=\"1252\" alt=\"Image\" src=\"https://github.com/user-attachments/assets/9ee9366d-86f3-4320-b0b4-b81da0a825ac\" />\n\n<img width=\"2306\" height=\"1296\" alt=\"Image\" src=\"https://github.com/user-attachments/assets/dc48b61d-a48a-4197-924b-8e7d5ce682a7\" />\n\n<img width=\"2299\" height=\"1252\" alt=\"Image\" src=\"https://github.com/user-attachments/assets/159760f3-8977-491c-af52-355b80164fda\" />\n\n<img width=\"2302\" height=\"1252\" alt=\"Image\" src=\"https://github.com/user-attachments/assets/a57f4394-822c-4d12-81c6-b83edd6a330d\" />\n\n<img width=\"2302\" height=\"1295\" alt=\"Image\" src=\"https://github.com/user-attachments/assets/7e441c4f-1f89-48ca-a082-54a49e5fd60b\" />\n\n### Steps to reproduce\n\nCreate a camera as a root in a new scene, set a child of area 3d, attach a script to area 3d, create collision shape 3d child of area 3d, select box shape. Copy the camera root.\nCreate new scene, paste camera into the new scene, select editable children and/or make local, unable to make unique.\n\n### Minimal reproduction project (MRP)\n\nAttempting to reproduce the issue in a fresh project replicates the issue. The relevant code is included in the project itself.\n\n[Make unique bug.zip](https://github.com/user-attachments/files/24969368/Make.unique.bug.zip)","closed_by":{"login":"Repiteo","id":17489292,"node_id":"MDQ6VXNlcjE3NDg5Mjky","avatar_url":"https://avatars.githubusercontent.com/u/17489292?v=4","gravatar_id":"","url":"https://api.github.com/users/Repiteo","html_url":"https://github.com/Repiteo","followers_url":"https://api.github.com/users/Repiteo/followers","following_url":"https://api.github.com/users/Repiteo/following{/other_user}","gists_url":"https://api.github.com/users/Repiteo/gists{/gist_id}","starred_url":"https://api.github.com/users/Repiteo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Repiteo/subscriptions","organizations_url":"https://api.github.com/users/Repiteo/orgs","repos_url":"https://api.github.com/users/Repiteo/repos","events_url":"https://api.github.com/users/Repiteo/events{/privacy}","received_events_url":"https://api.github.com/users/Repiteo/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/115645/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/godotengine/godot/issues/115645/timeline","performed_via_github_app":null,"state_reason":"completed","pinned_comment":null}