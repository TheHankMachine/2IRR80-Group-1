[{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2941064855","html_url":"https://github.com/godotengine/godot/pull/107119#issuecomment-2941064855","issue_url":"https://api.github.com/repos/godotengine/godot/issues/107119","id":2941064855,"node_id":"IC_kwDOAO6SJc6vTRaX","user":{"login":"DarioSamo","id":538504,"node_id":"MDQ6VXNlcjUzODUwNA==","avatar_url":"https://avatars.githubusercontent.com/u/538504?v=4","gravatar_id":"","url":"https://api.github.com/users/DarioSamo","html_url":"https://github.com/DarioSamo","followers_url":"https://api.github.com/users/DarioSamo/followers","following_url":"https://api.github.com/users/DarioSamo/following{/other_user}","gists_url":"https://api.github.com/users/DarioSamo/gists{/gist_id}","starred_url":"https://api.github.com/users/DarioSamo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/DarioSamo/subscriptions","organizations_url":"https://api.github.com/users/DarioSamo/orgs","repos_url":"https://api.github.com/users/DarioSamo/repos","events_url":"https://api.github.com/users/DarioSamo/events{/privacy}","received_events_url":"https://api.github.com/users/DarioSamo/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-06-04T18:48:38Z","updated_at":"2025-06-04T18:48:38Z","body":"Heads-up, there's currently a major visual regression in Forward+ which I'm currently tracking down, which seems to be related to one of the changes to the common lighting file.","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2941064855/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2941305696","html_url":"https://github.com/godotengine/godot/pull/107119#issuecomment-2941305696","issue_url":"https://api.github.com/repos/godotengine/godot/issues/107119","id":2941305696,"node_id":"IC_kwDOAO6SJc6vUMNg","user":{"login":"clayjohn","id":16521339,"node_id":"MDQ6VXNlcjE2NTIxMzM5","avatar_url":"https://avatars.githubusercontent.com/u/16521339?v=4","gravatar_id":"","url":"https://api.github.com/users/clayjohn","html_url":"https://github.com/clayjohn","followers_url":"https://api.github.com/users/clayjohn/followers","following_url":"https://api.github.com/users/clayjohn/following{/other_user}","gists_url":"https://api.github.com/users/clayjohn/gists{/gist_id}","starred_url":"https://api.github.com/users/clayjohn/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/clayjohn/subscriptions","organizations_url":"https://api.github.com/users/clayjohn/orgs","repos_url":"https://api.github.com/users/clayjohn/repos","events_url":"https://api.github.com/users/clayjohn/events{/privacy}","received_events_url":"https://api.github.com/users/clayjohn/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-06-04T20:02:39Z","updated_at":"2025-06-04T20:22:43Z","body":"I tested with the mobile renderer on an Adreno 640 device and cannot see any visual regressions. But I did note a consistent 10% improvement to the frame time in the TPS demo!\r\n\r\n\r\nOn Mali G710 the results are even more impressive, I see a consistent 10% improvement in the opaque pass and the shadow pass. But, this change also eliminates all of the random frame spikes we normally see, so the impact on average frame time is closer to 25%!\r\n\r\n_Before: Notice the frequent spikes in frame time_\r\n![Screenshot from 2025-06-04 13-18-05](https://github.com/user-attachments/assets/3eef0162-8a86-4f79-a822-de946f6ac02b)\r\n\r\n_after: The height is pretty similar (only 10% less), but no spikes!_\r\n![image](https://github.com/user-attachments/assets/e1a6d772-0f8d-4bc0-aca9-da4656bf8539)\r\n","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2941305696/reactions","total_count":10,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":1,"rocket":9,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2944740920","html_url":"https://github.com/godotengine/godot/pull/107119#issuecomment-2944740920","issue_url":"https://api.github.com/repos/godotengine/godot/issues/107119","id":2944740920,"node_id":"IC_kwDOAO6SJc6vhS44","user":{"login":"DarioSamo","id":538504,"node_id":"MDQ6VXNlcjUzODUwNA==","avatar_url":"https://avatars.githubusercontent.com/u/538504?v=4","gravatar_id":"","url":"https://api.github.com/users/DarioSamo","html_url":"https://github.com/DarioSamo","followers_url":"https://api.github.com/users/DarioSamo/followers","following_url":"https://api.github.com/users/DarioSamo/following{/other_user}","gists_url":"https://api.github.com/users/DarioSamo/gists{/gist_id}","starred_url":"https://api.github.com/users/DarioSamo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/DarioSamo/subscriptions","organizations_url":"https://api.github.com/users/DarioSamo/orgs","repos_url":"https://api.github.com/users/DarioSamo/repos","events_url":"https://api.github.com/users/DarioSamo/events{/privacy}","received_events_url":"https://api.github.com/users/DarioSamo/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-06-05T14:28:38Z","updated_at":"2025-06-05T14:28:38Z","body":"> Heads-up, there's currently a major visual regression in Forward+ which I'm currently tracking down, which seems to be related to one of the changes to the common lighting file.\r\n\r\nThis should be fixed now.","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2944740920/reactions","total_count":3,"+1":0,"-1":0,"laugh":0,"hooray":3,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2956492822","html_url":"https://github.com/godotengine/godot/pull/107119#issuecomment-2956492822","issue_url":"https://api.github.com/repos/godotengine/godot/issues/107119","id":2956492822,"node_id":"IC_kwDOAO6SJc6wOIAW","user":{"login":"clayjohn","id":16521339,"node_id":"MDQ6VXNlcjE2NTIxMzM5","avatar_url":"https://avatars.githubusercontent.com/u/16521339?v=4","gravatar_id":"","url":"https://api.github.com/users/clayjohn","html_url":"https://github.com/clayjohn","followers_url":"https://api.github.com/users/clayjohn/followers","following_url":"https://api.github.com/users/clayjohn/following{/other_user}","gists_url":"https://api.github.com/users/clayjohn/gists{/gist_id}","starred_url":"https://api.github.com/users/clayjohn/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/clayjohn/subscriptions","organizations_url":"https://api.github.com/users/clayjohn/orgs","repos_url":"https://api.github.com/users/clayjohn/repos","events_url":"https://api.github.com/users/clayjohn/events{/privacy}","received_events_url":"https://api.github.com/users/clayjohn/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-06-09T17:45:23Z","updated_at":"2025-06-09T17:45:23Z","body":"Note for maintainers:\r\n\r\nThis PR represents a fundamental change in how we manage half float values in the mobile renderer. Previously we used highp/mediump widely in the shader (but not consistently enough) which are basically hints to the GPU driver to use the highest precision available, or use a slightly lower precision (generally 32/16 bits respectively, but on older devices could be 24/16). These hints are not supported on Apple devices and have inconsistent quality/support on many Android devices.\r\n\r\nThis approach relies on an extension [VK_KHR_shader_float16_int8](https://vulkan.gpuinfo.org/displayextensiondetail.php?extension=VK_KHR_shader_float16_int8) which has wide support (80% across the board, basically 100% for new devices). When supported, this extension results in tidier and more optimized code. Using mediump we were unable to get a performance gain (https://github.com/godotengine/godot/pull/99767). \r\n\r\n### Device Support\r\n\r\nOur goal for the mobile renderer is specifically to be for newer devices that have good Vulkan support. So the number of supported devices should be much higher than the 80% support across the ecosystem as a whole. \r\n\r\nFurther, modern desktop GPUs are now coming out with support for explicit FP16. So this system can be extended to the Forward+ renderer in a follow up PR (FSR already makes heavy use of FP16). \r\n\r\n### Driver Support on Android\r\n\r\nIn both cases driver support on Android is inconsistent. On many devices there are nasty bugs with mediump and on others there are issues with explicit FP16. I don't know which one has more bugs, but going forward explicit FP16 will be the one with more support. \r\n\r\nAdditionally, explicit FP16 gives us more control. We can more easily create a blacklist and fall back to full FP32 on any device that has issues with FP16. Using mediump it is not feasible to have a fallback for blacklisted devices. ","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2956492822/reactions","total_count":7,"+1":5,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":2,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2957153643","html_url":"https://github.com/godotengine/godot/pull/107119#issuecomment-2957153643","issue_url":"https://api.github.com/repos/godotengine/godot/issues/107119","id":2957153643,"node_id":"IC_kwDOAO6SJc6wQpVr","user":{"login":"Repiteo","id":17489292,"node_id":"MDQ6VXNlcjE3NDg5Mjky","avatar_url":"https://avatars.githubusercontent.com/u/17489292?v=4","gravatar_id":"","url":"https://api.github.com/users/Repiteo","html_url":"https://github.com/Repiteo","followers_url":"https://api.github.com/users/Repiteo/followers","following_url":"https://api.github.com/users/Repiteo/following{/other_user}","gists_url":"https://api.github.com/users/Repiteo/gists{/gist_id}","starred_url":"https://api.github.com/users/Repiteo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Repiteo/subscriptions","organizations_url":"https://api.github.com/users/Repiteo/orgs","repos_url":"https://api.github.com/users/Repiteo/repos","events_url":"https://api.github.com/users/Repiteo/events{/privacy}","received_events_url":"https://api.github.com/users/Repiteo/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-06-09T22:13:34Z","updated_at":"2025-06-09T22:13:34Z","body":"Thanks!","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2957153643/reactions","total_count":1,"+1":0,"-1":0,"laugh":0,"hooray":1,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null}]