ption":"","archived_at":null,"archived_by":null},{"id":283518839,"node_id":"MDU6TGFiZWwyODM1MTg4Mzk=","url":"https://api.github.com/repos/godotengine/godot/labels/documentation","name":"documentation","color":"ffddff","default":true,"description":"","archived_at":null,"archived_by":null}],"state":"closed","locked":false,"assignees":[],"milestone":{"url":"https://api.github.com/repos/godotengine/godot/milestones/25","html_url":"https://github.com/godotengine/godot/milestone/25","labels_url":"https://api.github.com/repos/godotengine/godot/milestones/25/labels","id":15520464,"node_id":"MI_kwDOAO6SJc4A7NLQ","number":25,"title":"4.8","description":"","creator":{"login":"Repiteo","id":17489292,"node_id":"MDQ6VXNlcjE3NDg5Mjky","avatar_url":"https://avatars.githubusercontent.com/u/17489292?v=4","gravatar_id":"","url":"https://api.github.com/users/Repiteo","html_url":"https://github.com/Repiteo","followers_url":"https://api.github.com/users/Repiteo/followers","following_url":"https://api.github.com/users/Repiteo/following{/other_user}","gists_url":"https://api.github.com/users/Repiteo/gists{/gist_id}","starred_url":"https://api.github.com/users/Repiteo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Repiteo/subscriptions","organizations_url":"https://api.github.com/users/Repiteo/orgs","repos_url":"https://api.github.com/users/Repiteo/repos","events_url":"https://api.github.com/users/Repiteo/events{/privacy}","received_events_url":"https://api.github.com/users/Repiteo/received_events","type":"User","user_view_type":"public","site_admin":false},"open_issues":346,"closed_issues":2304,"state":"open","created_at":"2026-04-13T15:59:35Z","updated_at":"2026-10-21T09:34:58Z","due_on":null,"closed_at":null},"comments":3,"created_at":"2026-04-11T13:10:09Z","updated_at":"2026-08-10T16:19:54Z","closed_at":"2026-08-10T16:14:38Z","assignee":null,"author_association":"MEMBER","issue_field_values":[],"type":null,"active_lock_reason":null,"draft":false,"pull_request":{"url":"https://api.github.com/repos/godotengine/godot/pulls/118410","html_url":"https://github.com/godotengine/godot/pull/118410","diff_url":"https://github.com/godotengine/godot/pull/118410.diff","patch_url":"https://github.com/godotengine/godot/pull/118410.patch","merged_at":"2026-08-10T16:14:38Z"},"body":"In Godot's auto-generated documentation, all singletons are added to `@GlobalScope.xml` to indicate their existence. However, this brings a problem: Singletons provided by third-party modules show up in this file as well, making the module no longer self-contained as soon as singletons are added to it.\r\n\r\nBefore, this was just a minor annoyance, and I could just commit these diffs along with the commit that adds the module as a submodule. However, Godot's CI checks now include more comprehensive documentation checks, meaning that I'm \"damned if I do and damned if I don't\". Without the `@GlobalScope.xml` changes committed, doctool will find diffs. With the `@GlobalScope.xml` committed, the RST generation check fails with \"Unresolved type\":\r\n\r\n<img width=\"552\" height=\"440\" alt=\"Screenshot 2026-04-11 at 4 37 12 AM\" src=\"https://github.com/user-attachments/assets/2f77ea6d-2ff4-43d9-a3ce-830962b2f0c0\" />\r\n\r\nThis PR excludes user singletons from `@GlobalScope.xml`, allowing module authors to opt out of their singletons being included in `@GlobalScope.xml` if they register them as \"user singletons\", making the module self-contained, and allows Godot's CI to pass without doctool modifying the `@GlobalScope.xml`.","closed_by":{"login":"Repiteo","id":17489292,"node_id":"MDQ6VXNlcjE3NDg5Mjky","avatar_url":"https://avatars.githubusercontent.com/u/17489292?v=4","gravatar_id":"","url":"https://api.github.com/users/Repiteo","html_url":"https://github.com/Repiteo","followers_url":"https://api.github.com/users/Repiteo/followers","following_url":"https://api.github.com/users/Repiteo/following{/other_user}","gists_url":"https://api.github.com/users/Repiteo/gists{/gist_id}","starred_url":"https://api.github.com/users/Repiteo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Repiteo/subscriptions","organizations_url":"https://api.github.com/users/Repiteo/orgs","repos_url":"https://api.github.com/users/Repiteo/repos","events_url":"https://api.github.com/users/Repiteo/events{/privacy}","received_events_url":"https://api.github.com/users/Repiteo/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/118410/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/godotengine/godot/issues/118410/timeline","performed_via_github_app":null,"state_reason":null}