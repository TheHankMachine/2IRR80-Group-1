lt":false,"description":"","archived_at":null,"archived_by":null}],"state":"closed","locked":false,"assignees":[],"milestone":{"url":"https://api.github.com/repos/godotengine/godot/milestones/25","html_url":"https://github.com/godotengine/godot/milestone/25","labels_url":"https://api.github.com/repos/godotengine/godot/milestones/25/labels","id":15520464,"node_id":"MI_kwDOAO6SJc4A7NLQ","number":25,"title":"4.8","description":"","creator":{"login":"Repiteo","id":17489292,"node_id":"MDQ6VXNlcjE3NDg5Mjky","avatar_url":"https://avatars.githubusercontent.com/u/17489292?v=4","gravatar_id":"","url":"https://api.github.com/users/Repiteo","html_url":"https://github.com/Repiteo","followers_url":"https://api.github.com/users/Repiteo/followers","following_url":"https://api.github.com/users/Repiteo/following{/other_user}","gists_url":"https://api.github.com/users/Repiteo/gists{/gist_id}","starred_url":"https://api.github.com/users/Repiteo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Repiteo/subscriptions","organizations_url":"https://api.github.com/users/Repiteo/orgs","repos_url":"https://api.github.com/users/Repiteo/repos","events_url":"https://api.github.com/users/Repiteo/events{/privacy}","received_events_url":"https://api.github.com/users/Repiteo/received_events","type":"User","user_view_type":"public","site_admin":false},"open_issues":343,"closed_issues":2335,"state":"open","created_at":"2026-04-13T15:59:35Z","updated_at":"2026-10-22T06:28:22Z","due_on":null,"closed_at":null},"comments":3,"created_at":"2026-07-16T09:01:47Z","updated_at":"2026-07-17T17:42:51Z","closed_at":"2026-07-17T17:33:08Z","assignee":null,"author_association":"MEMBER","issue_field_values":[],"type":null,"active_lock_reason":null,"draft":false,"pull_request":{"url":"https://api.github.com/repos/godotengine/godot/pulls/121448","html_url":"https://github.com/godotengine/godot/pull/121448","diff_url":"https://github.com/godotengine/godot/pull/121448.diff","patch_url":"https://github.com/godotengine/godot/pull/121448.patch","merged_at":"2026-07-17T17:33:08Z"},"body":"## What problem(s) does this PR solve?\r\n\r\nThis change might improve compile times, since `physics_server_2d.h` isn't small and `world_2d.h` is included in a ton of places. I am not sure though, since I have not benchmarked it.\r\n\r\nThe main motivation for submitting this PR is that I was getting this warning from `clangd-tidy`:\r\n\r\n<img width=\"950\" height=\"350\" alt=\"Screenshot 2026-07-16 at 1 51 21 AM\" src=\"https://github.com/user-attachments/assets/87eebd7a-d4bb-4395-8b51-ef8a1e21be54\" />\r\n\r\n## Additional information\r\n\r\nhttps://github.com/aaronfranke/godot/actions/runs/29461470481/job/87505739258\r\n\r\nThe CI fails here even though the only change in the commit that CI is running on is the addition of a comment:\r\n\r\nhttps://github.com/aaronfranke/godot/commit/c51a32d4bcd3401fb62350c8e0fbd7234cf433ed#diff-401fe5486e156fdcfcf97874b0b2f6547d407b101f00160f41695f67aff91ff6R43\r\n\r\nIn order to fix the problem, this PR replaces the `physics_server_2d.h` include with a forward declaration of `class PhysicsDirectSpaceState2D;` which is vastly simpler than including the entire PhysicsServer2D header, though it does require that several other files be updated to explicitly include `physics_server_2d.h`.","closed_by":{"login":"Repiteo","id":17489292,"node_id":"MDQ6VXNlcjE3NDg5Mjky","avatar_url":"https://avatars.githubusercontent.com/u/17489292?v=4","gravatar_id":"","url":"https://api.github.com/users/Repiteo","html_url":"https://github.com/Repiteo","followers_url":"https://api.github.com/users/Repiteo/followers","following_url":"https://api.github.com/users/Repiteo/following{/other_user}","gists_url":"https://api.github.com/users/Repiteo/gists{/gist_id}","starred_url":"https://api.github.com/users/Repiteo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Repiteo/subscriptions","organizations_url":"https://api.github.com/users/Repiteo/orgs","repos_url":"https://api.github.com/users/Repiteo/repos","events_url":"https://api.github.com/users/Repiteo/events{/privacy}","received_events_url":"https://api.github.com/users/Repiteo/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/121448/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/godotengine/godot/issues/121448/timeline","performed_via_github_app":null,"state_reason":null}