[{"id":3863610540,"node_id":"PRR_kwDOAO6SJc7mSgSs","user":{"login":"Ivorforce","id":2308167,"node_id":"MDQ6VXNlcjIzMDgxNjc=","avatar_url":"https://avatars.githubusercontent.com/u/2308167?u=f7f8e0273f784f5ec6f6b7fe4a88d449896eb48a&v=4","gravatar_id":"","url":"https://api.github.com/users/Ivorforce","html_url":"https://github.com/Ivorforce","followers_url":"https://api.github.com/users/Ivorforce/followers","following_url":"https://api.github.com/users/Ivorforce/following{/other_user}","gists_url":"https://api.github.com/users/Ivorforce/gists{/gist_id}","starred_url":"https://api.github.com/users/Ivorforce/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Ivorforce/subscriptions","organizations_url":"https://api.github.com/users/Ivorforce/orgs","repos_url":"https://api.github.com/users/Ivorforce/repos","events_url":"https://api.github.com/users/Ivorforce/events{/privacy}","received_events_url":"https://api.github.com/users/Ivorforce/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"I'm almost surprised to say but I'm fine with the `class_db.h` explicit include.\r\nIt's a great approach: Just add it to all the implementation files of `Object` subclasses. Makes for a real simple PR, and one that unlocks us from removing the include from headers much easier.\r\n\r\nI'm not 100% sure about the `.compat.inc`. Both positions come with potential downsides: If it's at the start it cannot use the `.cpp` file's static functions, if it's at the end, the `.cpp` files cannot use compat functions (though perhaps they shouldn't need to?). Overall I don't have a strong preference for this which is why I haven't made an official proposal to change this so far. Maybe it would be ideal to actually have it be a separate `.cpp` file altogether, and one that only affects the header by declaring like `_bind_compat_functions` or something like that. But I'm not sure it's worth the churn to change it at all right now? \r\n\r\nAnyway, enough rambling, i'd say it at least needs some separate discussion.","state":"APPROVED","html_url":"https://github.com/godotengine/godot/pull/116826#pullrequestreview-3863610540","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/116826","author_association":"MEMBER","_links":{"html":{"href":"https://github.com/godotengine/godot/pull/116826#pullrequestreview-3863610540"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/116826"}},"submitted_at":"2026-02-26T21:21:20Z","commit_id":null},{"id":3863775333,"node_id":"PRR_kwDOAO6SJc7mTIhl","user":{"login":"Ivorforce","id":2308167,"node_id":"MDQ6VXNlcjIzMDgxNjc=","avatar_url":"https://avatars.githubusercontent.com/u/2308167?u=f7f8e0273f784f5ec6f6b7fe4a88d449896eb48a&v=4","gravatar_id":"","url":"https://api.github.com/users/Ivorforce","html_url":"https://github.com/Ivorforce","followers_url":"https://api.github.com/users/Ivorforce/followers","following_url":"https://api.github.com/users/Ivorforce/following{/other_user}","gists_url":"https://api.github.com/users/Ivorforce/gists{/gist_id}","starred_url":"https://api.github.com/users/Ivorforce/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Ivorforce/subscriptions","organizations_url":"https://api.github.com/users/Ivorforce/orgs","repos_url":"https://api.github.com/users/Ivorforce/repos","events_url":"https://api.github.com/users/Ivorforce/events{/privacy}","received_events_url":"https://api.github.com/users/Ivorforce/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"Thanks for adjusting!\n","state":"APPROVED","html_url":"https://github.com/godotengine/godot/pull/116826#pullrequestreview-3863775333","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/116826","author_association":"MEMBER","_links":{"html":{"href":"https://github.com/godotengine/godot/pull/116826#pullrequestreview-3863775333"},"pull_request":{"href":"https://api.github.com/repos/godo