[{"id":3886069142,"node_id":"PRR_kwDOAO6SJc7noLWW","user":{"login":"Ansraer","id":6329420,"node_id":"MDQ6VXNlcjYzMjk0MjA=","avatar_url":"https://avatars.githubusercontent.com/u/6329420?u=9b6df29991f0ca8186e28f269b6391ae5dd1bb63&v=4","gravatar_id":"","url":"https://api.github.com/users/Ansraer","html_url":"https://github.com/Ansraer","followers_url":"https://api.github.com/users/Ansraer/followers","following_url":"https://api.github.com/users/Ansraer/following{/other_user}","gists_url":"https://api.github.com/users/Ansraer/gists{/gist_id}","starred_url":"https://api.github.com/users/Ansraer/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Ansraer/subscriptions","organizations_url":"https://api.github.com/users/Ansraer/orgs","repos_url":"https://api.github.com/users/Ansraer/repos","events_url":"https://api.github.com/users/Ansraer/events{/privacy}","received_events_url":"https://api.github.com/users/Ansraer/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"Ok, read through the changes before bed and so far what I have seen make sense.\n\nMind you, I have never really tried to do raytracing stuff myself, so there might be some considerations I am missing due to my lack of practical experience, but at least in theory this looks good to me.\n\nDocumentations looks good as well, but maybe you could upload your rt gdscript test project somewhere people will actually find it?\n\nWhile I am certain that any experienced rendering engineer will have no trouble figuring out how to properly configure the ASGeometry (should be trivial with a look at the vulkan rt docs and maybe some knowledge about how godot expose the flags and format enums) I think it would still be nice to have some example code available for users to reference.\n\n\n@fire I don't think any performance benchmarks will be necessary for this PR. The RT API in godot is still experimental and this is a clear improvement that is in line with the current industry standards. We really should get this in now before people start using the RT API in it's current form.","state":"APPROVED","html_url":"https://github.com/godotengine/godot/pull/116962#pullrequestreview-3886069142","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/116962","author_association":"CONTRIBUTOR","_links":{"html":{"href":"https://github.com/godotengine/godot/pull/116962#pullrequestreview-3886069142"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/116962"}},"submitted_at":"2026-03-04T00:34:50Z","commit_id":null},{"id":3882153549,"node_id":"PRR_kwDOAO6SJc7nZPZN","user":{"login":"AThousandShips","id":96648715,"node_id":"U_kgDOBcK-Cw","avatar_url":"https://avatars.githubusercontent.com/u/96648715?u=af70f5d107e9c1447f296643d5a566dab53d25e8&v=4","gravatar_id":"","url":"https://api.github.com/users/AThousandShips","html_url":"https://github.com/AThousandShips","followers_url":"https://api.github.com/users/AThousandShips/followers","following_url":"https://api.github.com/users/AThousandShips/following{/other_user}","gists_url":"https://api.github.com/users/AThousandShips/gists{/gist_id}","starred_url":"https://api.github.com/users/AThousandShips/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/AThousandShips/subscriptions","organizations_url":"https://api.github.com/users/AThousandShips/orgs","repos_url":"https://api.github.com/users/AThousandShips/repos","events_url":"https://api.github.com/users/AThousandShips/events{/privacy}","received_events_url":"https://api.github.com/users/AThousandShips/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"","state":"COMMENTED","html_url":"https://github.com/godotengine/godot/pull/116962#pullrequestreview-3882153549","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/116962","author_association":"MEMBER","_links":{"html":{"href":"https://github.com/godotengine/godot/pull/116962#pullreque