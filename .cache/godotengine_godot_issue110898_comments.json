[{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3341397421","html_url":"https://github.com/godotengine/godot/pull/110898#issuecomment-3341397421","issue_url":"https://api.github.com/repos/godotengine/godot/issues/110898","id":3341397421,"node_id":"IC_kwDOAO6SJc7HKa2t","user":{"login":"bruvzg","id":7645683,"node_id":"MDQ6VXNlcjc2NDU2ODM=","avatar_url":"https://avatars.githubusercontent.com/u/7645683?v=4","gravatar_id":"","url":"https://api.github.com/users/bruvzg","html_url":"https://github.com/bruvzg","followers_url":"https://api.github.com/users/bruvzg/followers","following_url":"https://api.github.com/users/bruvzg/following{/other_user}","gists_url":"https://api.github.com/users/bruvzg/gists{/gist_id}","starred_url":"https://api.github.com/users/bruvzg/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/bruvzg/subscriptions","organizations_url":"https://api.github.com/users/bruvzg/orgs","repos_url":"https://api.github.com/users/bruvzg/repos","events_url":"https://api.github.com/users/bruvzg/events{/privacy}","received_events_url":"https://api.github.com/users/bruvzg/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-09-27T08:24:38Z","updated_at":"2025-09-27T08:24:38Z","body":"2.1 seems to be runnable on macOS 26, so its AGL code might be dead (or framework still exists in Rosetta, and only removed from SDK). 2.x build fails for unrelated reasons.","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3341397421/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3342463432","html_url":"https://github.com/godotengine/godot/pull/110898#issuecomment-3342463432","issue_url":"https://api.github.com/repos/godotengine/godot/issues/110898","id":3342463432,"node_id":"IC_kwDOAO6SJc7HOfHI","user":{"login":"bruvzg","id":7645683,"node_id":"MDQ6VXNlcjc2NDU2ODM=","avatar_url":"https://avatars.githubusercontent.com/u/7645683?v=4","gravatar_id":"","url":"https://api.github.com/users/bruvzg","html_url":"https://github.com/bruvzg","followers_url":"https://api.github.com/users/bruvzg/followers","following_url":"https://api.github.com/users/bruvzg/following{/other_user}","gists_url":"https://api.github.com/users/bruvzg/gists{/gist_id}","starred_url":"https://api.github.com/users/bruvzg/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/bruvzg/subscriptions","organizations_url":"https://api.github.com/users/bruvzg/orgs","repos_url":"https://api.github.com/users/bruvzg/repos","events_url":"https://api.github.com/users/bruvzg/events{/privacy}","received_events_url":"https://api.github.com/users/bruvzg/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-09-28T07:29:24Z","updated_at":"2025-09-28T07:29:24Z","body":"> 2.1 seems to be runnable on macOS 26, so its AGL code might be dead (or framework still exists in Rosetta, and only removed from SDK). 2.x build fails for unrelated reasons.\r\n\r\n2.1 also builds and runs on macOS 26 with the following small patch, so AGL code is unused.\r\n\r\n<details>\r\n  <summary>Patch</summary>\r\n\r\n```diff\r\ndiff --git a/platform/osx/detect.py b/platform/osx/detect.py\r\nindex 20d313809e..321241b7f2 100644\r\n--- a/platform/osx/detect.py\r\n+++ b/platform/osx/detect.py\r\n@@ -81,7 +81,7 @@ def configure(env):\r\n     env.Append(LIBS=['pthread'])\r\n     #env.Append(CPPFLAGS=['-F/Developer/SDKs/MacOSX10.4u.sdk/System/Library/Frameworks', '-isysroot', '/Developer/SDKs/MacOSX10.4u.sdk', '-mmacosx-version-min=10.4'])\r\n     #env.Append(LINKFLAGS=['-mmacosx-version-min=10.4', '-isysroot', '/Developer/SDKs/MacOSX10.4u.sdk', '-Wl,-syslibroot,/Developer/SDKs/MacOSX10.4u.sdk'])\r\n-    env.Append(LINKFLAGS=['-framework', 'Cocoa', '-framework', 'Carbon', '-framework', 'OpenGL', '-framework', 'AGL', '-framework', 'AudioUnit', '-framework', 'CoreAudio', '-lz', '-framework', 'IOKit', '-framework', 'ForceFeedback'])\r\n+    env.Append(LINKFLAGS=['-framework', 'Cocoa', '-framework', 'Carbon', '-framework', 'OpenGL', '-framework', 'AudioUnit', '-framework', 'CoreAudio', '-lz', '-framework', 'IOKit', '-framework', 'ForceFeedback'])\r\n     env.Append(LINKFLAGS=[\"-mmacosx-version-min=10.9\"])\r\n\r\n     if (env[\"CXX\"] == \"clang++\"):\r\ndiff --git a/thirdparty/libpng/pngpriv.h b/thirdparty/libpng/pngpriv.h\r\nindex 57e1bf989b..d8f5e6d277 100644\r\n--- a/thirdparty/libpng/pngpriv.h\r\n+++ b/thirdparty/libpng/pngpriv.h\r\n@@ -518,7 +518,7 @@\r\n #  include <float.h>\r\n\r\n #  if (defined(__MWERKS__) && defined(macintosh)) || defined(applec) || \\\r\n-    defined(THINK_C) || defined(__SC__) || defined(TARGET_OS_MAC)\r\n+    defined(THINK_C) || defined(__SC__)\r\n    /* We need to check that <math.h> hasn't already been included earlier\r\n     * as it seems it doesn't agree with <fp.h>, yet we should really use\r\n     * <fp.h> if possible.\r\ndiff --git a/thirdparty/zlib/zutil.h b/thirdparty/zlib/zutil.h\r\nindex b079ea6a80..ea705c61a1 100644\r\n--- a/thirdparty/zlib/zutil.h\r\n+++ b/thirdparty/zlib/zutil.h\r\n@@ -27,6 +27,7 @@\r\n #  endif\r\n #  include <string.h>\r\n #  include <stdlib.h>\r\n+#  include <stdio.h>\r\n #endif\r\n\r\n #ifdef Z_SOLO\r\n```\r\n\r\n<details>\r\n","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3342463432/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3351270444","html_url":"https://github.com/godotengine/godot/pull/110898#issuecomment-3351270444","issue_url":"https://api.github.com/repos/godotengine/godot/issues/110898","id":3351