gnees":[],"milestone":{"url":"https://api.github.com/repos/godotengine/godot/milestones/25","html_url":"https://github.com/godotengine/godot/milestone/25","labels_url":"https://api.github.com/repos/godotengine/godot/milestones/25/labels","id":15520464,"node_id":"MI_kwDOAO6SJc4A7NLQ","number":25,"title":"4.8","description":"","creator":{"login":"Repiteo","id":17489292,"node_id":"MDQ6VXNlcjE3NDg5Mjky","avatar_url":"https://avatars.githubusercontent.com/u/17489292?v=4","gravatar_id":"","url":"https://api.github.com/users/Repiteo","html_url":"https://github.com/Repiteo","followers_url":"https://api.github.com/users/Repiteo/followers","following_url":"https://api.github.com/users/Repiteo/following{/other_user}","gists_url":"https://api.github.com/users/Repiteo/gists{/gist_id}","starred_url":"https://api.github.com/users/Repiteo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Repiteo/subscriptions","organizations_url":"https://api.github.com/users/Repiteo/orgs","repos_url":"https://api.github.com/users/Repiteo/repos","events_url":"https://api.github.com/users/Repiteo/events{/privacy}","received_events_url":"https://api.github.com/users/Repiteo/received_events","type":"User","user_view_type":"public","site_admin":false},"open_issues":343,"closed_issues":2335,"state":"open","created_at":"2026-04-13T15:59:35Z","updated_at":"2026-10-22T06:28:22Z","due_on":null,"closed_at":null},"comments":1,"created_at":"2026-07-21T00:05:08Z","updated_at":"2026-08-10T17:36:29Z","closed_at":"2026-08-10T16:14:38Z","assignee":null,"author_association":"CONTRIBUTOR","issue_field_values":[],"type":null,"active_lock_reason":null,"draft":false,"pull_request":{"url":"https://api.github.com/repos/godotengine/godot/pulls/121588","html_url":"https://github.com/godotengine/godot/pull/121588","diff_url":"https://github.com/godotengine/godot/pull/121588.diff","patch_url":"https://github.com/godotengine/godot/pull/121588.patch","merged_at":"2026-08-10T16:14:37Z"},"body":"## What problem(s) does this PR solve?\r\n\r\nFixes a RichTextLabel BBCode regression introduced after 4.6 where nesting `[p]` inside `[font_size]` adds an unwanted empty first line.\r\n\r\nRepro:\r\n- Correct: `[p][font_size=22]aaa[/font_size][/p]`\r\n- Broken before this fix: `[font_size=22][p]aaa[/p][/font_size]`\r\n\r\nRoot cause:\r\n- `ITEM_FONT_SIZE` was not treated as formatting-only in layout-subitem detection.\r\n- When `[font_size]` appeared before `[p]`, paragraph insertion logic treated it as prior layout content and split to a new line.\r\n\r\nFix:\r\n- Treat `ITEM_FONT_SIZE` as formatting-only in `_find_layout_subitem()` so paragraph insertion does not create a leading blank line in this nesting case.\r\n\r\nRegression coverage:\r\n- Added a unit test that checks both tag orders produce one line and one paragraph, with no empty first line.\r\n\r\n- Closes #120933","closed_by":{"login":"Repiteo","id":17489292,"node_id":"MDQ6VXNlcjE3NDg5Mjky","avatar_url":"https://avatars.githubusercontent.com/u/17489292?v=4","gravatar_id":"","url":"https://api.github.com/users/Repiteo","html_url":"https://github.com/Repiteo","followers_url":"https://api.github.com/users/Repiteo/followers","following_url":"https://api.github.com/users/Repiteo/following{/other_user}","gists_url":"https://api.github.com/users/Repiteo/gists{/gist_id}","starred_url":"https://api.github.com/users/Repiteo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Repiteo/subscriptions","organizations_url":"https://api.github.com/users/Repiteo/orgs","repos_url":"https://api.github.com/users/Repiteo/repos","events_url":"https://api.github.com/users/Repiteo/events{/privacy}","received_events_url":"https://api.github.com/users/Repiteo/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/121588/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0