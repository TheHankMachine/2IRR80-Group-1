[{"id":3721471924,"node_id":"PRR_kwDOAO6SJc7d0Se0","state":"COMMENTED","user":{"site_admin":false,"suspended":false,"updated_at":"0001-01-01T00:00:00Z","avatar_url":"https://avatars.githubusercontent.com/u/96648715?u=af70f5d107e9c1447f296643d5a566dab53d25e8&v=4","created_at":"0001-01-01T00:00:00Z","followers":0,"following":0,"html_url":"https://github.com/AThousandShips","id":96648715,"node_id":"U_kgDOBcK-Cw","login":"AThousandShips","type":"User","owned_private_repos":0,"public_gists":0,"public_repos":0,"total_private_repos":0,"url":"https://api.github.com/users/AThousandShips"},"body":"","html_url":"https://github.com/godotengine/godot/pull/115554#pullrequestreview-3721471924","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/115554","author_association":"MEMBER","submitted_at":"2026-01-29T09:03:48Z"},{"id":3771963958,"node_id":"PRR_kwDOAO6SJc7g05o2","state":"COMMENTED","user":{"site_admin":false,"suspended":false,"updated_at":"0001-01-01T00:00:00Z","avatar_url":"https://avatars.githubusercontent.com/u/5611323?v=4","created_at":"0001-01-01T00:00:00Z","followers":0,"following":0,"html_url":"https://github.com/AdriaandeJongh","id":5611323,"node_id":"MDQ6VXNlcjU2MTEzMjM=","login":"AdriaandeJongh","type":"User","owned_private_repos":0,"public_gists":0,"public_repos":0,"total_private_repos":0,"url":"https://api.github.com/users/AdriaandeJongh"},"body":"Haven't reviewed the code, but this feature is a great addition to the editor and this PR a good step into the right direction. However, alongside the other fuzzy matching option at `filesystem/quick_open_dialog/enable_fuzzy_matching`, we should probably give the two new settings proposed here the same names and the same options, including the 'fuzzy misses'. No idea how much more complication that adds to this PR, but if we're going to add this functionality we might as well do it right in one go – instead of relying on a follow up PR.","html_url":"https://github.com/godotengine/godot/pull/115554#pullrequestreview-3771963958","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/115554","author_association":"CONTRIBUTOR","submitted_at":"2026-02-09T08:51:09Z"},{"id":3955231272,"node_id":"PRR_kwDOAO6SJc7rwAoo","state":"COMMENTED","user":{"site_admin":false,"suspended":false,"updated_at":"0001-01-01T00:00:00Z","avatar_url":"https://avatars.githubusercontent.com/u/2223172?u=fc85633b469acb6e7baef4dba5171f19a2a4ff85&v=4","created_at":"0001-01-01T00:00:00Z","followers":0,"following":0,"html_url":"https://github.com/KoBeWi","id":2223172,"node_id":"MDQ6VXNlcjIyMjMxNzI=","login":"KoBeWi","type":"User","owned_private_repos":0,"public_gists":0,"public_repos":0,"total_private_repos":0,"url":"https://api.github.com/users/KoBeWi"},"body":"","html_url":"https://github.com/godotengine/godot/pull/115554#pullrequestreview-3955231272","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/115554","author_association":"MEMBER","submitted_at":"2026-03-16T16:57:37Z"},{"id":3957886187,"node_id":"PRR_kwDOAO6SJc7r6Izr","state":"COMMENTED","user":{"site_admin":false,"suspended":false,"updated_at":"0001-01-01T00:00:00Z","avatar_url":"https://avatars.githubusercontent.com/u/56970759?v=4","created_at":"0001-01-01T00:00:00Z","followers":0,"following":0,"html_url":"https://github.com/voylin","id":56970759,"node_id":"MDQ6VXNlcjU2OTcwNzU5","login":"voylin","type":"User","owned_private_repos":0,"public_gists":0,"public_repos":0,"total_private_repos":0,"url":"https://api.github.com/users/voylin"},"body":"","html_url":"https://github.com/godotengine/godot/pull/115554#pullrequestreview-3957886187","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/115554","author_association":"CONTRIBUTOR","submitted_at":"2026-03-17T02:51:16Z"},{"id":3957949494,"node_id":"PRR_kwDOAO6SJc7r6YQ2","state":"COMMENTED","user":{"site_admin":false,"suspended":false,"updated_at":"0001-01-01T00:00:00Z","avatar_url":"https://avatars.githubusercontent.com/u/56970759?v=4","created_at":"0001-01-01T00:00:00Z","followers":0,"following":0,"html_url":"https://github.com/voylin","id":56970759,"node_id":"MDQ6VXNlcjU2OTcwNzU5","login":"voylin","type":"User","owned_private_repos":0,"public_gists":0,"public_repos":0,"total_private_repos":0,"url":"https://api.github.com/users/voylin"},"body":"","html_url":"https://github.com/godotengine/godot/pull/115554#pullrequestreview-3957949494","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/115554","author_association":"CONTRIBUTOR","submitted_at":"2026-03-17T03:17:56Z"},{"id":4533828962,"node_id":"PRR_kwDOAO6SJc8AAAABDjy9Yg","state":"COMMENTED","commit_id":"218a909778396198ac7a006447e8b695bcbfcfff","user":{"site_admin":false,"suspended":false,"updated_at":"0001-01-01T00:00:00Z","avatar_url":"https://avatars.githubusercontent.com/u/2223172?u=fc85633b469acb6e7baef4dba5171f19a2a4ff85&v=4","created_at":"0001-01-01T00:00:00Z","followers":0,"following":0,"html_url":"https://github.com/KoBeWi","id":2223172,"node_id":"MDQ6VXNlcjIyMjMxNzI=","login":"KoBeWi","type":"User","owned_private_repos":0,"public_gists":0,"public_repos":0,"total_private_repos":0,"url":"https://api.github.com/users/KoBeWi"},"body":"The implementation seems good now, but after testing the feature, I'm not so sure about it. The search results feel much less accurate than before. Fuzzy search is fine in quick open, because the results are sorted by score and the matched part is highlighted. Here it's used as a simple filter, so the best matches may be hidden somewhere deep in the tree.","html_url":"https://github.com/godotengine/godot/pull/115554#pullrequestreview-4533828962","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/115554","author_association":"MEMBER","submitted_at":"2026-06-19T15:13:26Z"}]