s.githubusercontent.com/u/176927541?v=4","gravatar_id":"","url":"https://api.github.com/users/syntaxerror247","html_url":"https://github.com/syntaxerror247","followers_url":"https://api.github.com/users/syntaxerror247/followers","following_url":"https://api.github.com/users/syntaxerror247/following{/other_user}","gists_url":"https://api.github.com/users/syntaxerror247/gists{/gist_id}","starred_url":"https://api.github.com/users/syntaxerror247/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/syntaxerror247/subscriptions","organizations_url":"https://api.github.com/users/syntaxerror247/orgs","repos_url":"https://api.github.com/users/syntaxerror247/repos","events_url":"https://api.github.com/users/syntaxerror247/events{/privacy}","received_events_url":"https://api.github.com/users/syntaxerror247/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"> Are these the only values supported on Android (no Left/Right/Upside variants)?\r\n\r\nAndroid only provides App orientation change callbacks for portrait and landscape. It does not distinguish between left/right landscape or upside-down portrait.\r\n\r\nWe can infer those cases using device rotation ( also called sensor-based orientation). However, these APIs do not respect user orientation preferences (auto-rotate is disabled in system settings) so would need to handle those cases as well.\r\n\r\nI went with the current approach since knowing whether it's portrait or landscape should be enough?","created_at":"2026-01-27T11:42:10Z","updated_at":"2026-01-27T11:46:58Z","html_url":"https://github.com/godotengine/godot/pull/115434#discussion_r2731602614","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/115434","_links":{"self":{"href":"https://api.github.com/repos/godotengine/godot/pulls/comments/2731602614"},"html":{"href":"https://github.com/godotengine/godot/pull/115434#discussion_r2731602614"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/115434"}},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/2731602614/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":2541,"original_line":2541,"side":"RIGHT","in_reply_to_id":2731389147,"author_association":"MEMBER","original_position":9,"position":9,"subject_type":"line"},{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/2731614296","pull_request_review_id":3710700805,"id":2731614296,"node_id":"PRRC_kwDOAO6SJc6i0SBY","diff_hunk":"@@ -2533,6 +2533,16 @@\n \t\t\t</description>\n \t\t</method>\n \t</methods>\n+\t<signals>\n+\t\t<signal name=\"orientation_changed\">\n+\t\t\t<param index=\"0\" name=\"orientation\" type=\"int\" />\n+\t\t\t<description>\n+\t\t\t\tEmitted when the device orientation changes. [param orientation] is the new orientation.\n+\t\t\t\tReturns [code]1[/code] for portrait, [code]2[/code] for landscape, and [code]0[/code] if the orientation is undefined.\n+\t\t\t\t[b]Note:[/b] This method is implemented on Android.","path":"doc/classes/DisplayServer.xml","commit_id":"16954e14d40c38e44e0f88e60352e73279b2e1e5","original_commit_id":"16954e14d40c38e44e0f88e60352e73279b2e1e5","user":{"login":"syntaxerror247","id":176927541,"node_id":"U_kgDOCouzNQ","avatar_url":"https://avatars.githubusercontent.com/u/176927541?v=4","gravatar_id":"","url":"https://api.github.com/users/syntaxerror247","html_url":"https://github.com/syntaxerror247","followers_url":"https://api.github.com/users/syntaxerror247/followers","following_url":"https://api.github.com/users/syntaxerror247/following{/other_user}","gists_url":"https://api.github.com/users/syntaxerror247/gists{/gist_id}","starred_url":"https://api.github.com/users/syntaxerror247/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/syntaxerror247/subscriptions","organizations_url":"https://api.g