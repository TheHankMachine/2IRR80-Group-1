[{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3776325386","html_url":"https://github.com/godotengine/godot/issues/115187#issuecomment-3776325386","issue_url":"https://api.github.com/repos/godotengine/godot/issues/115187","id":3776325386,"node_id":"IC_kwDOAO6SJc7hFicK","user":{"login":"ColinSORourke","id":44822820,"node_id":"MDQ6VXNlcjQ0ODIyODIw","avatar_url":"https://avatars.githubusercontent.com/u/44822820?v=4","gravatar_id":"","url":"https://api.github.com/users/ColinSORourke","html_url":"https://github.com/ColinSORourke","followers_url":"https://api.github.com/users/ColinSORourke/followers","following_url":"https://api.github.com/users/ColinSORourke/following{/other_user}","gists_url":"https://api.github.com/users/ColinSORourke/gists{/gist_id}","starred_url":"https://api.github.com/users/ColinSORourke/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/ColinSORourke/subscriptions","organizations_url":"https://api.github.com/users/ColinSORourke/orgs","repos_url":"https://api.github.com/users/ColinSORourke/repos","events_url":"https://api.github.com/users/ColinSORourke/events{/privacy}","received_events_url":"https://api.github.com/users/ColinSORourke/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-01-21T05:55:37Z","updated_at":"2026-01-21T05:55:37Z","body":"Tested and verified the behavior in Godot 4.6 and Godot 4.5. This is downstream of https://github.com/godotengine/godot/issues/66381, which is well known and referenced in the tool documentation. \n\nTool Scripts are currently only soft reloaded upon modify + save, but to generate a correct Script Instance need to be hard reloaded. This is not the same for Non-Tool Scripts, because in-editor they are generated as PlaceHolderScriptInstances, and have _update_exports called to sync to the Inspector.\n\nhttps://github.com/godotengine/godot/pull/92099 exists and would resolve this issue as well if my commented suggestion was added.\n\n","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3776325386/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null}]