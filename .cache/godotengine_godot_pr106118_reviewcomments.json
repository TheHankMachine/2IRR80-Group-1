ms so much in our variadic templates\n             # that we need to outright disable it.\n             common_warnings += [\"-Wno-type-limits\"]","path":"SConstruct","commit_id":"f09ffeedd0e28cb58093f66f20580bf2f1d6b1fc","original_commit_id":"f09ffeedd0e28cb58093f66f20580bf2f1d6b1fc","user":{"login":"Repiteo","id":17489292,"node_id":"MDQ6VXNlcjE3NDg5Mjky","avatar_url":"https://avatars.githubusercontent.com/u/17489292?v=4","gravatar_id":"","url":"https://api.github.com/users/Repiteo","html_url":"https://github.com/Repiteo","followers_url":"https://api.github.com/users/Repiteo/followers","following_url":"https://api.github.com/users/Repiteo/following{/other_user}","gists_url":"https://api.github.com/users/Repiteo/gists{/gist_id}","starred_url":"https://api.github.com/users/Repiteo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Repiteo/subscriptions","organizations_url":"https://api.github.com/users/Repiteo/orgs","repos_url":"https://api.github.com/users/Repiteo/repos","events_url":"https://api.github.com/users/Repiteo/events{/privacy}","received_events_url":"https://api.github.com/users/Repiteo/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"I say we leave it; no need to fuss over these older versions if we're already covering our bases","created_at":"2025-05-06T12:57:12Z","updated_at":"2025-05-06T12:57:12Z","html_url":"https://github.com/godotengine/godot/pull/106118#discussion_r2075421849","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/106118","_links":{"self":{"href":"https://api.github.com/repos/godotengine/godot/pulls/comments/2075421849"},"html":{"href":"https://github.com/godotengine/godot/pull/106118#discussion_r2075421849"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/106118"}},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/2075421849/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confuse