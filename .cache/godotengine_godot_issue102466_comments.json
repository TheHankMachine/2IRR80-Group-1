i.github.com/repos/godotengine/godot/issues/comments/2638003493/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2638095665","html_url":"https://github.com/godotengine/godot/issues/102466#issuecomment-2638095665","issue_url":"https://api.github.com/repos/godotengine/godot/issues/102466","id":2638095665,"node_id":"IC_kwDOAO6SJc6dPiUx","user":{"login":"ydeltastar","id":133662278,"node_id":"U_kgDOB_eGRg","avatar_url":"https://avatars.githubusercontent.com/u/133662278?v=4","gravatar_id":"","url":"https://api.github.com/users/ydeltastar","html_url":"https://github.com/ydeltastar","followers_url":"https://api.github.com/users/ydeltastar/followers","following_url":"https://api.github.com/users/ydeltastar/following{/other_user}","gists_url":"https://api.github.com/users/ydeltastar/gists{/gist_id}","starred_url":"https://api.github.com/users/ydeltastar/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/ydeltastar/subscriptions","organizations_url":"https://api.github.com/users/ydeltastar/orgs","repos_url":"https://api.github.com/users/ydeltastar/repos","events_url":"https://api.github.com/users/ydeltastar/events{/privacy}","received_events_url":"https://api.github.com/users/ydeltastar/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-02-05T21:48:09Z","updated_at":"2025-02-05T22:30:11Z","body":"I used `git bisect` to find it.\nI updated the driver again and confirmed the issue returned on master. Then I reverted 06cae04b878c98e9cd89ed25e5f25421e973c9f0 on top of master and it indeed fixes it.\n\nMy only guess for the cause is data/memory corruption. The font's binary is corrupted or the size for the data in `load_internal_font()` is wrong, or this font in particular causes an edge case bug on the font rendering or driver.","author_as