com/users/Calinou/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Calinou/subscriptions","organizations_url":"https://api.github.com/users/Calinou/orgs","repos_url":"https://api.github.com/users/Calinou/repos","events_url":"https://api.github.com/users/Calinou/events{/privacy}","received_events_url":"https://api.github.com/users/Calinou/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-07-09T13:23:43Z","updated_at":"2025-07-09T13:24:11Z","body":"> Seems to be a duplicate of https://github.com/godotengine/godot/issues/82033.\n\nThis issue was bisected to https://github.com/godotengine/godot/pull/92645 though, which was created (and merged) after #82033 was opened.","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3052663775/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3056243142","html_url":"https://github.com/godotengine/godot/issues/108407#issuecomment-3056243142","issue_url":"https://api.github.com/repos/godotengine/godot/issues/108407","id":3056243142,"node_id":"IC_kwDOAO6SJc62KpHG","user":{"login":"WhalesState","id":53877170,"node_id":"MDQ6VXNlcjUzODc3MTcw","avatar_url":"https://avatars.githubusercontent.com/u/53877170?v=4","gravatar_id":"","url":"https://api.github.com/users/WhalesState","html_url":"https://github.com/WhalesState","followers_url":"https://api.github.com/users/WhalesState/followers","following_url":"https://api.github.com/users/WhalesState/following{/other_user}","gists_url":"https://api.github.com/users/WhalesState/gists{/gist_id}","starred_url":"https://api.github.com/users/WhalesState/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/WhalesState/subscriptions","organizations_url":"https://api.github.com/users/WhalesState/orgs","repos_url":"https://api.github.com/users/WhalesState/repos","events_url":"https://api.github.com/users/WhalesState/events{/privacy}","received_events_url":"https://api.github.com/users/WhalesState/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-07-10T08:13:27Z","updated_at":"2025-07-10T08:15:08Z","body":"`TextureRect` fails when `expand_mode` is set to `keep width` and the `HBoxContainer` minimum size's height is small, tried up to 164 and it crashes.\nIn the MRP, I just changed the expand_mode from 2 to 1 in `repre.tscn` file and it no longer crashes.\n\n<img width=\"840\" height=\"492\" alt=\"Image\" src=\"https://github.com/user-attachments/assets/53943858-1e41-46e5-9cff-4bbf50c95a0b\" />","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3056243142/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3059571268","html_url":"https://github.com/godotengine/godot/issues/108407#issuecomment-3059571268","issue_url":"https://api.github.com/repos/godotengine/godot/issues/108407","id":3059571268,"node_id":"IC_kwDOAO6SJc62XVpE","user":{"login":"WhalesState","id":53877170,"node_id":"MDQ6VXNlcjUzODc3MTcw","avatar_url":"https://avatars.githubusercontent.com/u/53877170?v=4","gravatar_id":"","url":"https://api.github.com/users/WhalesState","html_url":"https://github.com/WhalesState","followers_url":"https://api.github.com/users/WhalesState/followers","following_url":"https://api.github.com/users/WhalesState/following{/other_user}","gists_url":"https://api.github.com/users/WhalesState/gists{/gist_id}","starred_url":"https://api.github.com/users/WhalesState/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/WhalesState/subscriptions","organizations_url":"https://api.github.com/users/WhalesState/orgs","repos_url":"https://api.github.com/users/WhalesState/repos","events_url":"https://api.github.com/users/WhalesState/events{/privacy}","received_events_url":"https://api.github.com/users/WhalesState/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-07-10T23:49:34Z","updated_at":"2025-07-11T05:47:34Z","body":"Tested with 4.1.1 stable, the MRP opens but the crash still happens while resizing the `HBoxContainer`, https://github.com/godotengine/godot/issues/82033.\n\nAlso this issue explains it https://github.com/godotengine/godot/issues/73071.\n\nWas able to fix the crash by returning a valid minimum height from `TextureRect` instead of 0 when using `expand_mode` FIT_WIDTH, but it prevents the Editor from resizing the node so it's not the actual fix, at the end we know that this is a `TextureRect` issue causing all of that.\n\nNote: The crash happens also while resizing a `HBoxContainer` that have two TextureRect children with horizontal size flags set to expand and one uses fit width while the other uses fit height. confirmed in 4.1.1 stable too.\n\nhttps://github.com/user-attachments/assets/7169c1f9-b24a-419a-9319-1e35bb7f97b9\n","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3059571268/reactions","total_count":2,"+1":2,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3411455216","html_url":"https://github.com/godotengine/godot/issues/108407#issuecomment-3411455216","issue_url":"https://api.github.com/repos/godotengine/godot/issues/108407","id":3411455216,"node_id":"IC_kwDOAO6SJc7LVqzw","user":{"login":"gkwaerp","id":35116814,"node_id":"MDQ6VXNlcjM1MTE2ODE0","avatar_url":"https://avatars.githubusercontent.com/u/35116814?v=4","g