48:38Z","due_on":"2025-09-15T00:00:00Z","closed_at":"2025-09-18T17:13:14Z"},"comments":7,"created_at":"2025-05-18T09:51:06Z","updated_at":"2026-02-07T12:36:27Z","closed_at":"2025-05-26T16:30:23Z","assignee":null,"author_association":"CONTRIBUTOR","issue_field_values":[],"type":null,"active_lock_reason":null,"draft":false,"pull_request":{"url":"https://api.github.com/repos/godotengine/godot/pulls/106553","html_url":"https://github.com/godotengine/godot/pull/106553","diff_url":"https://github.com/godotengine/godot/pull/106553.diff","patch_url":"https://github.com/godotengine/godot/pull/106553.patch","merged_at":"2025-05-26T16:30:23Z"},"body":"Fixes and closes: https://github.com/godotengine/godot/issues/106081\r\n\r\nDue to the fact that holding ctrl, shift, and alt have been used for other handlings in the editor, the original implementation of pr #105147 is not dedicate enough.\r\n\r\nThis time I turned it into a small plugin button at the right of the Sprite2D plugin. The icon of the new button is “KeepAspect” (not sure if there are any better icon for this). The button is togglable so only when it is pressed can you drag the selected sprite to resize its `region_rect`, otherwise you will resize its `scale`.\r\n","closed_by":{"login":"Repiteo","id":17489292,"node_id":"MDQ6VXNlcjE3NDg5Mjky","avatar_url":"https://avatars.githubusercontent.com/u/17489292?v=4","gravatar_id":"","url":"https://api.github.com/users/Repiteo","html_url":"https://github.com/Repiteo","followers_url":"https://api.github.com/users/Repiteo/followers","following_url":"https://api.github.com/users/Repiteo/following{/other_user}","gists_url":"https://api.github.com/users/Repiteo/gists{/gist_id}","starred_url":"https://api.github.com/users/Repiteo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Repiteo/subscriptions","organizations_url":"https://api.github.com/users/Repiteo/orgs","repos_url":"https://api.github.com/users/Repiteo/repos","events_url":"https://api.github.com/u