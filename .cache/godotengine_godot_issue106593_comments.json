4","gravatar_id":"","url":"https://api.github.com/users/Faolan-Rad","html_url":"https://github.com/Faolan-Rad","followers_url":"https://api.github.com/users/Faolan-Rad/followers","following_url":"https://api.github.com/users/Faolan-Rad/following{/other_user}","gists_url":"https://api.github.com/users/Faolan-Rad/gists{/gist_id}","starred_url":"https://api.github.com/users/Faolan-Rad/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Faolan-Rad/subscriptions","organizations_url":"https://api.github.com/users/Faolan-Rad/orgs","repos_url":"https://api.github.com/users/Faolan-Rad/repos","events_url":"https://api.github.com/users/Faolan-Rad/events{/privacy}","received_events_url":"https://api.github.com/users/Faolan-Rad/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-05-21T09:06:42Z","updated_at":"2025-05-21T09:06:42Z","body":"@clayjohn I have implemented a new sort key for transparent explicitly and for stacked order I just flip the sign bit so the order works the only thing I am a bit questionable on is if I should just do bitwise equal for the same depth check it will work for the submeshes and and other stuff because they share an owner but for meshes that are literately on top of each other it could brake given how they got on top of each other to be honest I am sort of 50 50 on it","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2897188412/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2897317074","html_url":"https://github.com/godotengine/godot/pull/106593#issuecomment-2897317074","issue_url":"https://api.github.com/repos/godotengine/godot/issues/106593","id":2897317074,"node_id":"IC_kwDOAO6SJc6ssYzS","user":{"login":"Faolan-Rad","id":46481567,"node_