/gist_id}","starred_url":"https://api.github.com/users/ghost/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/ghost/subscriptions","organizations_url":"https://api.github.com/users/ghost/orgs","repos_url":"https://api.github.com/users/ghost/repos","events_url":"https://api.github.com/users/ghost/events{/privacy}","received_events_url":"https://api.github.com/users/ghost/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-07-29T13:00:48Z","updated_at":"2026-07-29T13:00:48Z","body":"> Other issues I spotted:\r\n> \r\n> * The suffix is also ignored for minimum size. It can overlap arrows and go out of bounds.\r\n> * Changing `label` does not update minimum size immediately.\r\n> \r\n> However they can be fixed in a separate PR, as they don't cause problems in the inspector.\r\n\r\nI'll open a follow up PR after this gets merged with the fixes for those\r\n\r\n","author_association":"NONE","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5118089336/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5127951093","html_url":"https://github.com/godotengine/godot/pull/121797#issuecomment-5127951093","issue_url":"https://api.github.com/repos/godotengine/godot/issues/121797","id":5127951093,"node_id":"IC_kwDOAO6SJc8AAAABMaZS9Q","user":{"login":"bruvzg","id":7645683,"node_id":"MDQ6VXNlcjc2NDU2ODM=","avatar_url":"https://avatars.githubusercontent.com/u/7645683?v=4","gravatar_id":"","url":"https://api.github.com/users/bruvzg","html_url":"https://github.com/bruvzg","followers_url":"https://api.github.com/users/bruvzg/followers","following_url":"https://api.github.com/users/bruvzg/following{/other_user}","gists_url":"https://api.github.com/users/bruvzg/gists{/gist_id}","starred_url":"https://api.github.com/users/bruvzg/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/bruvzg/subscriptions","organizations_url":"https://api.github.com/users/bruvzg/orgs","repos_url":"https://api.github.com/users/bruvzg/repos","events_url":"https://api.github.com/users/bruvzg/events{/privacy}","received_events_url":"https://api.github.com/users/bruvzg/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-07-30T07:31:16Z","updated_at":"2026-07-30T07:31:16Z","body":"A quick fix for clip offsets:\r\n\r\n```diff\r\ndiff --git a/editor/gui/editor_spin_slider.cpp b/editor/gui/editor_spin_slider.cpp\r\nindex e50403515c..2bda499f8f 100644\r\n--- a/editor/gui/editor_spin_slider.cpp\r\n+++ b/editor/gui/editor_spin_slider.cpp\r\n@@ -408,14 +408,15 @@ void EditorSpinSlider::_draw_spin_slider() {\r\n                Ref<Texture2D> updown2 = read_only ? theme_cache.updown_disabled_icon : theme_cache.updown_icon;\r\n\r\n                if (rtl) {\r\n-                       // Clip text before the up/down icon\r\n-                       float icon_end = sb->get_margin(SIDE_LEFT) + updown2->get_width();\r\n-\r\n-                       // Convert the control-space position to shaped-text coordinates\r\n-                       clip_l = MAX(0.0f, icon_end - text_ofs.x);\r\n+                       clip_l = text_start + sb->get_margin(SIDE_LEFT) + updown2->get_width();\r\n                } else {\r\n-                       // Clip text before it reaches the up/down icon\r\n-                       clip_r = size.width - sb->get_margin(SIDE_RIGHT) - updown2->get_width() - text_start;\r\n+                       clip_r = size.width - sb->get_margin(SIDE_RIGHT) - updown2->get_width();\r\n+               }\r\n+       } else {\r\n+               if (rtl) {\r\n+                       clip_l = text_start + sb->get_margin(SIDE_LEFT);\r\n+               } else {\r\n+                       clip_r = size.width - sb->get_margin(SIDE_RIGHT);\r\n                }\r\n        }\r\n\r\n@@ -423,7 +424,9 @@ void EditorSpinSlider::_draw_spin_slider() {\r\n                RID value_rid = TS->create_shaped_text();\r\n                TS->shaped_text_add_string(value_rid, numstr, font->get_rids(), font_size, font->get_opentype_features());\r\n\r\n-               TS->shaped_text_draw(value_rid, ci, text_ofs, clip_l, clip_r, fc);\r\n+               if (clip_r == -1 || clip_r - text_ofs.x > 0) {\r\n+                       TS->shaped_text_draw(value_rid, ci, text_ofs, (clip_l >=0) ? clip_l - text_ofs.x : -1, (clip_r >=0) ? clip_r - text_ofs.x : -1, fc);\r\n+               }\r\n\r\n                TS->free_rid(value_rid);\r\n        }\r\n@@ -432,9 +435,11 @@ void EditorSpinSlider::_draw_spin_slider() {\r\n                RID suffix_rid = TS->create_shaped_text();\r\n                TS->shaped_text_add_string(suffix_rid, String::chr(0x2009) + suffix, font->get_rids(), font_size, font->get_opentype_features());\r\n\r\n-               float value_width = TS->shaped_text_get_width(num_rid) - TS->shaped_text_get_width(suffix_rid);\r\n+               Vector2 value_offset = text_ofs + Vector2(TS->shaped_text_get_width(num_rid) - TS->shaped_text_get_width(suffix_rid), 0);\r\n\r\n-               TS->shaped_text_draw(suffix_rid, ci, text_ofs + Vector2(value_width, 0), clip_l, clip_r, fc * Color(1, 1, 1, 0.4));\r\n+               if (clip_r == -1 || clip_r - value_offset.x > 0) {\r\n+                       TS->shaped_text_draw(suffix_rid, ci, value_offset, (clip_l >=0) ? clip_l - value_offset.x : -1, (clip_r >=0) ? clip_r - value_offset.x : -1, fc * Color(1, 1, 1, 0.4));\r\n+               }\r\n\r\n                TS->free_rid(suffix_rid);\r\n        }\r\n```","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5127951093/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null}]