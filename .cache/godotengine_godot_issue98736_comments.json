dotengine/godot/pull/97257).","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2452646671/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2452714339","html_url":"https://github.com/godotengine/godot/pull/98736#issuecomment-2452714339","issue_url":"https://api.github.com/repos/godotengine/godot/issues/98736","id":2452714339,"node_id":"IC_kwDOAO6SJc6SMXNj","user":{"login":"YeldhamDev","id":30739239,"node_id":"MDQ6VXNlcjMwNzM5MjM5","avatar_url":"https://avatars.githubusercontent.com/u/30739239?v=4","gravatar_id":"","url":"https://api.github.com/users/YeldhamDev","html_url":"https://github.com/YeldhamDev","followers_url":"https://api.github.com/users/YeldhamDev/followers","following_url":"https://api.github.com/users/YeldhamDev/following{/other_user}","gists_url":"https://api.github.com/users/YeldhamDev/gists{/gist_id}","starred_url":"https://api.github.com/users/YeldhamDev/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/YeldhamDev/subscriptions","organizations_url":"https://api.github.com/users/YeldhamDev/orgs","repos_url":"https://api.github.com/users/YeldhamDev/repos","events_url":"https://api.github.com/users/YeldhamDev/events{/privacy}","received_events_url":"https://api.github.com/users/YeldhamDev/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2024-11-01T23:26:55Z","updated_at":"2024-11-01T23:26:55Z","body":"@dsnopek Missed that one, thank you. Strangely, my compiler didn't spit any errors about this while also compiling with `target=template_debug`.","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2452714339/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"hear