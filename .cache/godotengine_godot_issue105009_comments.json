sues/comments/2960316670/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2984656181","html_url":"https://github.com/godotengine/godot/issues/105009#issuecomment-2984656181","issue_url":"https://api.github.com/repos/godotengine/godot/issues/105009","id":2984656181,"node_id":"IC_kwDOAO6SJc6x5j01","user":{"login":"Alex2782","id":41921395,"node_id":"MDQ6VXNlcjQxOTIxMzk1","avatar_url":"https://avatars.githubusercontent.com/u/41921395?v=4","gravatar_id":"","url":"https://api.github.com/users/Alex2782","html_url":"https://github.com/Alex2782","followers_url":"https://api.github.com/users/Alex2782/followers","following_url":"https://api.github.com/users/Alex2782/following{/other_user}","gists_url":"https://api.github.com/users/Alex2782/gists{/gist_id}","starred_url":"https://api.github.com/users/Alex2782/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Alex2782/subscriptions","organizations_url":"https://api.github.com/users/Alex2782/orgs","repos_url":"https://api.github.com/users/Alex2782/repos","events_url":"https://api.github.com/users/Alex2782/events{/privacy}","received_events_url":"https://api.github.com/users/Alex2782/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-06-18T15:18:09Z","updated_at":"2025-06-18T15:18:09Z","body":"v4.5.beta.custom_build [46c495ca2]\n\nI could not reproduce it, or less extreme, on a 10 year old smartphone: `LG Google Nexus 5X, Android 8.1, Adreno 4xx GPU`\n\n<details><summary>video</summary>\n\nhttps://github.com/user-attachments/assets/e34c3771-f9f9-4d86-b03f-20ff8c51e7b7\n\n</details>\n\n------------------------\n\n```gdscript\n\tawait download_file(\"http://165.232.71.204/animations.pck\")\n\tprint(ProjectSettings.load_resource_pack(\"user://animations.pck\"))\n```\n\n@MinatoTW \n- Is the file `animations.pck` still the same as in the video?\n- On which device did you test it?\n\nI'm removing this issue from the `4.x Release Blockers` tracker. Please test again soon, once the 4.5 beta is released.\n\n","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2984656181/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3032908878","html_url":"https://github.com/godotengine/godot/issues/105009#issuecomment-3032908878","issue_url":"https://api.github.com/repos/godotengine/godot/issues/105009","id":3032908878,"node_id":"IC_kwDOAO6SJc60xoRO","user":{"login":"MinatoTW","id":31851651,"node_id":"MDQ6VXNlcjMxODUxNjUx","avatar_url":"https://avatars.githubusercontent.com/u/31851651?v=4","gravatar_id":"","url":"https://api.github.com/users/MinatoTW","html_url":"https://github.com/MinatoTW","followers_url":"https://api.github.com/users/MinatoTW/followers","following_url":"https://api.github.com/users/MinatoTW/following{/other_user}","gists_url":"https://api.github.com/users/MinatoTW/gists{/gist_id}","starred_url":"https://api.github.com/users/MinatoTW/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/MinatoTW/subscriptions","organizations_url":"https://api.github.com/users/MinatoTW/orgs","repos_url":"https://api.github.com/users/MinatoTW/repos","events_url":"https://api.github.com/users/MinatoTW/events{/privacy}","received_events_url":"https://api.github.com/users/MinatoTW/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-07-03T16:42:48Z","updated_at":"2025-07-03T16:42:48Z","body":"Yes, the animations.pck is same. We tested on a Xiaomi device from last year as well as Google Pixel 9 pro.","author_association":"NONE","pin":null,"reactions":{"url":"https://a