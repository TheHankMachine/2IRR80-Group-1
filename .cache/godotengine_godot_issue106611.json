hived_by":null},{"id":3240950060,"node_id":"MDU6TGFiZWwzMjQwOTUwMDYw","url":"https://api.github.com/repos/godotengine/godot/labels/performance","name":"performance","color":"447777","default":false,"description":"","archived_at":null,"archived_by":null}],"state":"open","locked":false,"assignees":[],"milestone":{"url":"https://api.github.com/repos/godotengine/godot/milestones/16","html_url":"https://github.com/godotengine/godot/milestone/16","labels_url":"https://api.github.com/repos/godotengine/godot/milestones/16/labels","id":8237783,"node_id":"MI_kwDOAO6SJc4AfbLX","number":16,"title":"4.x","description":"Issues and pull requests slated for an undetermined Godot 4 release.","creator":{"login":"akien-mga","id":4701338,"node_id":"MDQ6VXNlcjQ3MDEzMzg=","avatar_url":"https://avatars.githubusercontent.com/u/4701338?v=4","gravatar_id":"","url":"https://api.github.com/users/akien-mga","html_url":"https://github.com/akien-mga","followers_url":"https://api.github.com/users/akien-mga/followers","following_url":"https://api.github.com/users/akien-mga/following{/other_user}","gists_url":"https://api.github.com/users/akien-mga/gists{/gist_id}","starred_url":"https://api.github.com/users/akien-mga/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/akien-mga/subscriptions","organizations_url":"https://api.github.com/users/akien-mga/orgs","repos_url":"https://api.github.com/users/akien-mga/repos","events_url":"https://api.github.com/users/akien-mga/events{/privacy}","received_events_url":"https://api.github.com/users/akien-mga/received_events","type":"User","user_view_type":"public","site_admin":false},"open_issues":5793,"closed_issues":0,"state":"open","created_at":"2022-07-26T12:42:05Z","updated_at":"2026-10-22T14:39:14Z","due_on":null,"closed_at":null},"comments":9,"created_at":"2025-05-19T22:11:27Z","updated_at":"2026-07-22T15:20:32Z","closed_at":null,"assignee":null,"author_association":"NONE","issue_field_values":[],"type":null,"active_lock_reason":null,"draft":false,"pull_request":{"url":"https://api.github.com/repos/godotengine/godot/pulls/106611","html_url":"https://github.com/godotengine/godot/pull/106611","diff_url":"https://github.com/godotengine/godot/pull/106611.diff","patch_url":"https://github.com/godotengine/godot/pull/106611.patch","merged_at":null},"body":"# Single-pass String::format implementation\r\n\r\nThe current implementation of String::format involves repeatedly replacing each specified key with its corresponding value in the template string. There are two issues with this:\r\n\r\n- It can be inefficient in that it generates intermediate strings for each replaced key.\r\n- If early keys are replaced with strings that match subsequent keys, those will be replaced with the subsequent replacements. This is awkward and dependent upon the ordering of the replacements.\r\n\r\nThe implementation in this PR finds all replacements in the template string before performing the replacements. So it can be more efficient, copying the template only once, and it does not replace early values with later values even if they match.\r\n\r\nWe have added more String::format tests to evaluate more cases and verify the repeated replacement behavior is fixed.\r\n\r\nSince it's possible that some users of String::format rely upon the earlier repeated replacement behavior, it may be useful to document this change in behavior somewhere.","closed_by":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/106611/reactions","total_count":2,"+1":2,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/godotengine/godot/issues/106611/timeline","performed_via_github_app":null,"state_reason":null}