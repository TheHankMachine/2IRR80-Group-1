hub.com/users/KoBeWi/gists{/gist_id}","starred_url":"https://api.github.com/users/KoBeWi/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/KoBeWi/subscriptions","organizations_url":"https://api.github.com/users/KoBeWi/orgs","repos_url":"https://api.github.com/users/KoBeWi/repos","events_url":"https://api.github.com/users/KoBeWi/events{/privacy}","received_events_url":"https://api.github.com/users/KoBeWi/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-06-21T22:46:08Z","updated_at":"2025-06-21T22:46:08Z","body":"Ah right, if you have a path only, there is `is_resource_file()` method in String. `is_built_in()` is only useful when you already have a Resource reference.","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2993804004/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2993805216","html_url":"https://github.com/godotengine/godot/issues/107813#issuecomment-2993805216","issue_url":"https://api.github.com/repos/godotengine/godot/issues/107813","id":2993805216,"node_id":"IC_kwDOAO6SJc6ycdeg","user":{"login":"Notgoyome","id":113891088,"node_id":"U_kgDOBsnXEA","avatar_url":"https://avatars.githubusercontent.com/u/113891088?v=4","gravatar_id":"","url":"https://api.github.com/users/Notgoyome","html_url":"https://github.com/Notgoyome","followers_url":"https://api.github.com/users/Notgoyome/followers","following_url":"https://api.github.com/users/Notgoyome/following{/other_user}","gists_url":"https://api.github.com/users/Notgoyome/gists{/gist_id}","starred_url":"https://api.github.com/users/Notgoyome/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Notgoyome/subscriptions","organizations_url":"https://api.github.com/users/Notgoyome/orgs","repos_url":"https://api.github.com/users/Notgoyome/repos","events_url":"https://api.github.com/users/Notgoyome/events{/privacy}","received_events_url":"https://api.github.com/users/Notgoyome/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-06-21T22:49:48Z","updated_at":"2025-06-21T22:49:48Z","body":"oooh nice ty!  it's litteraly the same condition, how did you find it ???","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2993805216/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2993840969","html_url":"https://github.com/godotengine/godot/issues/107813#issuecomment-2993840969","issue_url":"https://api.github.com/repos/godotengine/godot/issues/107813","id":2993840969,"node_id":"IC_kwDOAO6SJc6ycmNJ","user":{"login":"KoBeWi","id":2223172,"node_id":"MDQ6VXNlcjIyMjMxNzI=","avatar_url":"https://avatars.githubusercontent.com/u/2223172?v=4","gravatar_id":"","url":"https://api.github.com/users/KoBeWi","html_url":"https://github.com/KoBeWi","followers_url":"https://api.github.com/users/KoBeWi/followers","following_url":"https://api.github.com/users/KoBeWi/following{/other_user}","gists_url":"https://api.github.com/users/KoBeWi/gists{/gist_id}","starred_url":"https://api.github.com/users/KoBeWi/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/KoBeWi/subscriptions","organizations_url":"https://api.github.com/users/KoBeWi/orgs","repos_url":"https://api.github.com/users/KoBeWi/repos","events_url":"https://api.github.com/users/KoBeWi/events{/privacy}","received_events_url":"https://api.github.com/users/KoBeWi/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-06-22T00:33:19Z","updated_at":"2025-06-22T00:33:19Z","body":"I have my ways 👀","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2993840969/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2994434438","html_url":"https://github.com/godotengine/godot/issues/107813#issuecomment-2994434438","issue_url":"https://api.github.com/repos/godotengine/godot/issues/107813","id":2994434438,"node_id":"IC_kwDOAO6SJc6ye3GG","user":{"login":"Notgoyome","id":113891088,"node_id":"U_kgDOBsnXEA","avatar_url":"https://avatars.githubusercontent.com/u/113891088?v=4","gravatar_id":"","url":"https://api.github.com/users/Notgoyome","html_url":"https://github.com/Notgoyome","followers_url":"https://api.github.com/users/Notgoyome/followers","following_url":"https://api.github.com/users/Notgoyome/following{/other_user}","gists_url":"https://api.github.com/users/Notgoyome/gists{/gist_id}","starred_url":"https://api.github.com/users/Notgoyome/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Notgoyome/subscriptions","organizations_url":"https://api.github.com/users/Notgoyome/orgs","repos_url":"https://api.github.com/users/Notgoyome/repos","events_url":"https://api.github.com/users/Notgoyome/events{/privacy}","received_events_url":"https://api.github.com/users/Notgoyome/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-06-22T20:33:48Z","updated_at":"2025-06-22T20:34:12Z","body":"it seems like \n\n```cpp\nbool String::is_resource_file() const {\n\treturn begins_with(\"res://\") && find(\"::\") == -1;\n}\n\n```\ndoes check if it's a **resource file** but\n\n`!is_resource_file()` check if it **doesn't** begin_with `res://` **OR** has `::`\n\nso it won't work with `.gd` external files like **test files** that are not in `res://` like [class_name.gd](https://github.com/godotengine/godot/blob/master/modules/gdscript/tests/scripts/parser/features/class_name.gd) \nand is also not the condition as [godot 3.6 check](https://github.com/godotengine/godot/blob/ac8b19e5abb64d910482f45801ab0eaa599bacdf/modules/gdscript/gdscript_parser.cpp#L3763)\n\nI had this idea:\n\n```cpp\nif (!script_path.is_resource_file() && script_path.begins_with(\"res://\"))\n```\n\nwhich is the same result as \n```cpp\nbegins_with(\"res://\") && find(\"::\") != -1\n``` \n\nwhat do you think ? :melting_face:","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2994434438/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2994473241","html_url":"https://github.com/godotengine/godot/issues/107813#issuecomment-2994473241","issue_url":"https://api.github.com/repos/godotengine/godot/issues/107813","id":2994473241,"node_id":"IC_kwDOAO6SJc6yfAkZ","user":{"login":"KoBeWi","id":2223172,"node_id":"MDQ6VXNlcjIyMjMxNzI=","avatar_url":"https://avatars.githubusercontent.com/u/2223172?v=4","gravatar_id":"","url":"https://api.github.com/users/KoBeWi","html_url":"https://github.com/KoBeWi","followers_url":"https://api.github.com/users/KoBeWi/followers","following_url":"https://api.github.com/users/KoBeWi/following{/other_user}","gists_url":"https://api.github.com/users/KoBeWi/gists{/gist_id}","starred_url":"https://api.github.com/users/KoBeWi/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/KoBeWi/subscriptions","organizations_url":"https://api.github.com/users/KoBeWi/orgs","repos_url":"https://api.github.com/users/KoBeWi/repos","events_url":"https://api.github.com/users/KoBeWi/events{/privacy}","received_events_url":"https://api.github.com/users/KoBeWi/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-06-22T21:53:14Z","updated_at":"2025-06-22T21:53:14Z","body":"I mean, `is_resource_file()` is just a helper method. It should be preferred _when possible_, but if not possible, you can use different checks.","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2994473241/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null}]