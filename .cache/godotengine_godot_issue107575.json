AAAABCNCFwA","url":"https://api.github.com/repos/godotengine/godot/labels/topic:particles","name":"topic:particles","color":"ffee88","default":false,"description":"","archived_at":null,"archived_by":null}],"state":"closed","locked":false,"assignees":[],"milestone":{"url":"https://api.github.com/repos/godotengine/godot/milestones/22","html_url":"https://github.com/godotengine/godot/milestone/22","labels_url":"https://api.github.com/repos/godotengine/godot/milestones/22/labels","id":12070367,"node_id":"MI_kwDOAO6SJc4AuC3f","number":22,"title":"4.5","description":"","creator":{"login":"Sauermann","id":6299227,"node_id":"MDQ6VXNlcjYyOTkyMjc=","avatar_url":"https://avatars.githubusercontent.com/u/6299227?v=4","gravatar_id":"","url":"https://api.github.com/users/Sauermann","html_url":"https://github.com/Sauermann","followers_url":"https://api.github.com/users/Sauermann/followers","following_url":"https://api.github.com/users/Sauermann/following{/other_user}","gists_url":"https://api.github.com/users/Sauermann/gists{/gist_id}","starred_url":"https://api.github.com/users/Sauermann/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Sauermann/subscriptions","organizations_url":"https://api.github.com/users/Sauermann/orgs","repos_url":"https://api.github.com/users/Sauermann/repos","events_url":"https://api.github.com/users/Sauermann/events{/privacy}","received_events_url":"https://api.github.com/users/Sauermann/received_events","type":"User","user_view_type":"public","site_admin":false},"open_issues":3,"closed_issues":3687,"state":"closed","created_at":"2024-12-19T08:51:28Z","updated_at":"2026-09-04T21:48:38Z","due_on":"2025-09-15T00:00:00Z","closed_at":"2025-09-18T17:13:14Z"},"comments":0,"created_at":"2025-06-15T22:32:48Z","updated_at":"2025-07-04T15:25:12Z","closed_at":"2025-07-04T15:24:51Z","assignee":null,"author_association":"CONTRIBUTOR","issue_field_values":[],"type":null,"active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"### Tested versions\n\nReproducible in v4.5.dev.custom_build [1218a16de]\n\n### System information\n\nGodot v4.5.dev (1218a16de) - macOS Sequoia (15.5.0) - Multi-window, 2 monitors - OpenGL 3 (Compatibility) - Apple M4 Pro - Apple M4 Pro (14 threads) - 24.00 GiB memory\n\n### Issue description\n\nWhen setting the `emitting` property of a GPUParticles2D node to `true`, the size of existing particles appears to be re-calculated. This has a very jarring effect.\n\nhttps://github.com/user-attachments/assets/f8241c7b-1e67-435c-9569-6c8307764ce2\n\nAs I was preparing to file this report, I found https://github.com/godotengine/godot/issues/104511 which sounds like basically the same problem, except with the 3D particle system instead of the 2D one. A merged PR that sounds like it should've fixed the issue, including for GPUParticles2D, is linked there, but for me it seems the issue persists (or is a different one).\n\n### Steps to reproduce\n\nCreate a GPUParticles2D system with a ParticleProcessMaterial where the display scale has a range. Disable `emitting`, then re-enable it; any particles that were already there will change their scale instantaneously.\n\n### Minimal reproduction project (MRP)\n\n[test-emitting-particles-wrong_2025-06-15_15-29-49.zip](https://github.com/user-attachments/files/20747817/test-emitting-particles-wrong_2025-06-15_15-29-49.zip)\n\nRun this MRP, and press the Enter key to toggle the particle system's emission. When emission is enabled, you should see the scale of the on-screen particles change randomly, as seen in the video above.","closed_by":{"login":"Repiteo","id":17489292,"node_id":"MDQ6VXNlcjE3NDg5Mjky","avatar_url":"https://avatars.githubusercontent.com/u/17489292?v=4","gravatar_id":"","url":"https://api.github.com/users/Repiteo","html_url":"https://github.com/Repiteo","followers_url":"https://api.github.com/users/Repiteo/followers","following_url":"https://api.github.com/users/Repiteo/following{/other_user}","gists_url":"https://api.github.com/users/Repiteo/gists{/gist_id}","starred_url":"https://api.github.com/users/Repiteo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Repiteo/subscriptions","organizations_url":"https://api.github.com/users/Repiteo/orgs","repos_url":"https://api.github.com/users/Repiteo/repos","events_url":"https://api.github.com/users/Repiteo/events{/privacy}","received_events_url":"https://api.github.com/users/Repiteo/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/107575/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/godotengine/godot/issues/107575/timeline","performed_via_github_app":null,"state_reason":"completed","pinned_comment":null}