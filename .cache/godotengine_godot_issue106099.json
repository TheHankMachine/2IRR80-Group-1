ived_by":null}],"state":"closed","locked":false,"assignees":[],"milestone":{"url":"https://api.github.com/repos/godotengine/godot/milestones/23","html_url":"https://github.com/godotengine/godot/milestone/23","labels_url":"https://api.github.com/repos/godotengine/godot/milestones/23/labels","id":12939969,"node_id":"MI_kwDOAO6SJc4AxXLB","number":23,"title":"4.6","description":"","creator":{"login":"Repiteo","id":17489292,"node_id":"MDQ6VXNlcjE3NDg5Mjky","avatar_url":"https://avatars.githubusercontent.com/u/17489292?v=4","gravatar_id":"","url":"https://api.github.com/users/Repiteo","html_url":"https://github.com/Repiteo","followers_url":"https://api.github.com/users/Repiteo/followers","following_url":"https://api.github.com/users/Repiteo/following{/other_user}","gists_url":"https://api.github.com/users/Repiteo/gists{/gist_id}","starred_url":"https://api.github.com/users/Repiteo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Repiteo/subscriptions","organizations_url":"https://api.github.com/users/Repiteo/orgs","repos_url":"https://api.github.com/users/Repiteo/repos","events_url":"https://api.github.com/users/Repiteo/events{/privacy}","received_events_url":"https://api.github.com/users/Repiteo/received_events","type":"User","user_view_type":"public","site_admin":false},"open_issues":3,"closed_issues":2978,"state":"closed","created_at":"2025-05-22T16:25:52Z","updated_at":"2026-10-04T16:23:23Z","due_on":null,"closed_at":"2026-01-26T18:09:14Z"},"comments":5,"created_at":"2025-05-05T17:57:38Z","updated_at":"2026-02-07T12:35:47Z","closed_at":"2025-11-07T16:37:19Z","assignee":null,"author_association":"CONTRIBUTOR","issue_field_values":[],"type":null,"active_lock_reason":null,"draft":false,"pull_request":{"url":"https://api.github.com/repos/godotengine/godot/pulls/106099","html_url":"https://github.com/godotengine/godot/pull/106099","diff_url":"https://github.com/godotengine/godot/pull/106099.diff","patch_url":"https://github.com/godotengine/godot/pull/106099.patch","merged_at":"2025-11-07T16:37:19Z"},"body":"Fixes #91473 - First PR (first time using C++)\r\n\r\nFixes Inspector not opening Resource from inside Array or Dictionary when\r\nclicking \"Edit\", by properly signaling `resource_selected`.\r\n\r\nWhen clicking \"Edit\" on a Resource in the Inspector, the `resource_selected`\r\nsignal is emitted. This works correctly when the Resource is a standalone\r\nexported property, and the signal reaches `EditorInspector::_resource_selected`.\r\n\r\nHowever, when the Resource is stored inside an Array or Dictionary, the signal\r\nwas not reaching the EditorInspector, because it was blocked by the container\r\nproperty (Array/Dictionary) in between.\r\n\r\nThis fix forwards the `resource_selected` signal from the nested Resource\r\nthrough the container (Array or Dictionary), up to the Inspector, allowing it\r\nto display the selected Resource as expected.","closed_by":{"login":"Repiteo","id":17489292,"node_id":"MDQ6VXNlcjE3NDg5Mjky","avatar_url":"https://avatars.githubusercontent.com/u/17489292?v=4","gravatar_id":"","url":"https://api.github.com/users/Repiteo","html_url":"https://github.com/Repiteo","followers_url":"https://api.github.com/users/Repiteo/followers","following_url":"https://api.github.com/users/Repiteo/following{/other_user}","gists_url":"https://api.github.com/users/Repiteo/gists{/gist_id}","starred_url":"https://api.github.com/users/Repiteo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Repiteo/subscriptions","organizations_url":"https://api.github.com/users/Repiteo/orgs","repos_url":"https://api.github.com/users/Repiteo/repos","events_url":"https://api.github.com/users/Repiteo/events{/privacy}","received_events_url":"https://api.github.com/users/Repiteo/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/106099/reactions","total_count":10,"+1":9,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":1,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/godotengine/godot/issues/106099/timeline","performed_via_github_app":null,"state_reason":null}