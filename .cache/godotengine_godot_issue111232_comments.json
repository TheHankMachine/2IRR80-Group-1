0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3387760802","html_url":"https://github.com/godotengine/godot/pull/111232#issuecomment-3387760802","issue_url":"https://api.github.com/repos/godotengine/godot/issues/111232","id":3387760802,"node_id":"IC_kwDOAO6SJc7J7SCi","user":{"login":"alliephante","id":112137107,"node_id":"U_kgDOBq8Tkw","avatar_url":"https://avatars.githubusercontent.com/u/112137107?v=4","gravatar_id":"","url":"https://api.github.com/users/alliephante","html_url":"https://github.com/alliephante","followers_url":"https://api.github.com/users/alliephante/followers","following_url":"https://api.github.com/users/alliephante/following{/other_user}","gists_url":"https://api.github.com/users/alliephante/gists{/gist_id}","starred_url":"https://api.github.com/users/alliephante/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/alliephante/subscriptions","organizations_url":"https://api.github.com/users/alliephante/orgs","repos_url":"https://api.github.com/users/alliephante/repos","events_url":"https://api.github.com/users/alliephante/events{/privacy}","received_events_url":"https://api.github.com/users/alliephante/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-10-09T23:20:16Z","updated_at":"2025-10-09T23:39:24Z","body":"I fucked up the rebase, sorry. Fixed it, but it seems to have tagged like every team for review :(\r\n\r\n\r\n> Probably codebase refactor moving files around. You need to rebase with `master`.\r\n\r\nI thought the tests would compile the specific PR, not test by compiling against the current master with the PR cherry picked in. Regardless, I did a rebase (after some struggle...) and it didn't change anything. Still compiles and runs fine on my machine. Tests still seem to fail with the same reason though.\r\n\r\nEdit: If I had to guess, this PR is what is causing issues https://github.com/godotengine/godot/pull/111274\r\n\r\nI guess through some other header it used to include `FileAccess` but now it doesn't. Very strange that it still compiles fine locally, but I went and explicitly added an include for `core/io/file_access.h` and now it seems fine.\r\nStrange that it always compiled fine for me locally, maybe there was something out of sync or cached weirdly or something. (I even did a clean build with scons and it still compiled fine last time.)\r\n\r\nThanks again for the help!\r\n","author_association":"NONE","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3387760802/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3506937443","html_url":"https://github.com/godotengine/godot/pull/111232#issuecomment-3506937443","issue_url":"https://api.github.com/repos/godotengine/godot/issues/111232","id":3506937443,"node_id":"IC_kwDOAO6SJc7RB55j","user":{"login":"KoBeWi","id":2223172,"node_id":"MDQ6VXNlcjIyMjMxNzI=","avatar_url":"https://avatars.githubusercontent.com/u/2223172?v=4","gravatar_id":"","url":"https://api.github.com/users/KoBeWi","html_url":"https://github.com/KoBeWi","followers_url":"https://api.github.com/users/KoBeWi/followers","following_url":"https://api.github.com/users/KoBeWi/following{/other_user}","gists_url":"https://api.github.com/users/KoBeWi/gists{/gist_id}","starred_url":"https://api.github.com/users/KoBeWi/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/KoBeWi/subscriptions","organizations_url":"https://api.github.com/users/KoBeWi/orgs","repos_url":"https://api.github.com/users/KoBeWi/repos","events_url":"https://api.github.com/users/KoBeWi/events{/privacy}","received_events_url":"https://api.github.com/users/KoBeWi/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-11-08T21:24:40Z","updated_at":"2025-11-08T21:24:40Z","body":"Alternative, and probably simpler, implementation is having a `custom_tooltip_callback` Callable, called by viewport when making the default tooltip.","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3506937443/reactions","total_count":1,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":1},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3506976351","html_url":"https://github.com/godotengine/godot/pull/111232#issuecomment-3506976351","issue_url":"https://api.github.com/repos/godotengine/godot/issues/111232","id":3506976351,"node_id":"IC_kwDOAO6SJc7RCDZf","user":{"login":"alliephante","id":112137107,"node_id":"U_kgDOBq8Tkw","avatar_url":"https://avatars.githubusercontent.com/u/112137107?v=4","gravatar_id":"","url":"https://api.github.com/users/alliephante","html_url":"https://github.com/alliephante","followers_url":"https://api.github.com/users/alliephante/followers","following_url":"https://api.github.com/users/alliephante/following{/other_user}","gists_url":"https://api.github.com/users/alliephante/gists{/gist_id}","starred_url":"https://api.github.com/users/alliephante/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/alliephante/subscriptions","organizations_url":"https://api.github.com/users/alliephante/orgs","repos_url":"https://api.github.com/users/alliephante/repos","events_url":"https://api.github.com/users/alliephante/events{/privacy}","received_events_url":"https://api.github.com/users/alliephante/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-11-08T21:52:44Z","updated_at":"2025-11-08T22:18:37Z","body":"> Alternative, and probably simpler, implementation is having a `custom_tooltip_callback` Callable, called by viewport when making the default tooltip.\r\n\r\nI believe this will generally fall into some of the same traps with the current method. While that would solve the problem I mention for a bulk of the existing UI elements (excluding if you use subviewports anywhere, because you'd have to remember to use the same callback for any of those), it does not solve the issue for any element that has a PopUp involved, which will have it's own hidden viewport (OptionButton, MenuButton, etc). It would mean for any of those types, you'd have to create a custom script to get your tooltip working again. My goal with this proposal was to generally simplify the process for having your custom tooltips across the entire project, so that you don't need to create a script/custom type _just_ to give it a custom tooltip. \r\n\r\nThe point of the default setting is to ensure any viewports/windows that get created from those elements will also have the tooltip scene you want, and I actually only added it after making the viewport function as I noticed the issue with PopUps at that time. (It also ended up simplifying the user experience as now you just change a project setting and you have custom tooltips, instead of needing to use a script)","author_association":"NONE","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3506976351/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4145649344","html_url":"https://github.com/godotengine/godot/pull/111232#issuecomment-4145649344","issue_url":"https://api.github.com/repos/godotengine/godot/issues/111232","id":4145649344,"node_id":"IC_kwDOAO6SJc73GZbA","user":{"login":"alliephante","id":112137107,"node_id":"U_kgDOBq8Tkw","avatar_url":"https://avatars.githubusercontent.com/u/112137107?v=4","gravatar_id":"","url":"https://api.github.com/users/alliephante","html_url":"https://github.com/alliephante","followers_url":"https://api.github.com/users/alliephante/followers","following_url":"https://api.github.com/users/alliephante/following{/other_user}","gists_url":"https://api.github.com/users/alliephante/gists{/gist_id}","starred_url":"https://api.github.com/users/alliephante/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/alliephante/subscriptions","organizations_url":"https://api.github.com/users/alliephante/orgs","repos_url":"https://api.github.com/users/alliephante/repos","events_url":"https://api.github.com/users/alliephante/events{/privacy}","received_events_url":"https://api.github.com/users/alliephante/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-03-27T22:15:02Z","updated_at":"2026-03-27T22:15:02Z","body":"Could I request a review from the appropriate team(s)? I suspect all the teams were dropped a few months ago when I messed up my rebase.\r\n\r\n","author_association":"NONE","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4145649344/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null}]