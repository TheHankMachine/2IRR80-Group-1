.github.com/users/DeeJayLSP/orgs","repos_url":"https://api.github.com/users/DeeJayLSP/repos","events_url":"https://api.github.com/users/DeeJayLSP/events{/privacy}","received_events_url":"https://api.github.com/users/DeeJayLSP/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-11-06T23:36:14Z","updated_at":"2025-11-07T00:15:58Z","body":"I'd like to take a moment to suggest something...\r\n\r\n<img width=\"158\" height=\"56\" alt=\"image\" src=\"https://github.com/user-attachments/assets/21c156e0-50db-4d7f-95b0-02ba699fd3a7\" />\r\n\r\n___\r\n\r\n<img width=\"251\" height=\"85\" alt=\"image\" src=\"https://github.com/user-attachments/assets/54a2b42b-56f8-4f42-86fe-84da0f090617\" />\r\n\r\nLike I mentioned, the round corners make bringing back the top highlight... ugly. But it would look less ugly if left and right borders are also highlighted IMO.\r\n\r\nI would advise caution when copypasting colors from the classic theme, to avoid stuff like #112443","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3499840478/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3500556200","html_url":"https://github.com/godotengine/godot/pull/112324#issuecomment-3500556200","issue_url":"https://api.github.com/repos/godotengine/godot/issues/112324","id":3500556200,"node_id":"IC_kwDOAO6SJc7Qpj-o","user":{"login":"TheESN","id":102585253,"node_id":"U_kgDOBh1TpQ","avatar_url":"https://avatars.githubusercontent.com/u/102585253?v=4","gravatar_id":"","url":"https://api.github.com/users/TheESN","html_url":"https://github.com/TheESN","followers_url":"https://api.github.com/users/TheESN/followers","following_url":"https://api.github.com/users/TheESN/following{/other_user}","gists_url":"https://api.github.com/users/TheESN/gists{/gist_id}","starred_url":"https://api.github.com/users/TheESN/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/TheESN/subscriptions","organizations_url":"https://api.github.com/users/TheESN/orgs","repos_url":"https://api.github.com/users/TheESN/repos","events_url":"https://api.github.com/users/TheESN/events{/privacy}","received_events_url":"https://api.github.com/users/TheESN/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-11-07T03:46:20Z","updated_at":"2025-11-07T03:46:20Z","body":"> I'd like to take a moment to suggest something...\r\n> <img alt=\"image\" width=\"158\" height=\"56\" src=\"https://private-user-images.githubusercontent.com/60024671/511043981-21c156e0-50db-4d7f-95b0-02ba699fd3a7.png?jwt=eyJ0eXAiOiJKV1QiLCJhbGciOiJIUzI1NiJ9..SfytE69rD4afhgLm7s7mjYkz0Z3eJ0XEIibfDVzpVv4\"> <img alt=\"image\" width=\"251\" height=\"85\" src=\"https://private-user-images.githubusercontent.com/60024671/511044403-54a2b42b-56f8-4f42-86fe-84da0f090617.png?jwt=eyJ0eXAiOiJKV1QiLCJhbGciOiJIUzI1NiJ9..TsjzgSqjl3bxTCpviGOll8UTNCNJEtN9eFq-mM9Ydf8\">\r\n> \r\n> Like I mentioned, the round corners make bringing back the top highlight... ugly. But it would look less ugly if left and right borders are also highlighted IMO.\r\n> \r\n> I would advise caution when copypasting colors from the classic theme, to avoid stuff like #112443\r\n\r\nCan you show how these tabs look on full screenshots please?","author_association":"NONE","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3500556200/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3501234499","html_url":"https://github.com/godotengine/godot/pull/112324#issuecomment-3501234499","issue_url":"https://api.github.com/repos/godotengine/godot/issues/112324","id":3501234499,"node_id":"IC_kwDOAO6SJc7QsJlD","user":{"login":"akien-mga","id":4701338,"node_id":"MDQ6VXNlcjQ3MDEzMzg=","avatar_url":"https://avatars.githubusercontent.com/u/4701338?v=4","gravatar_id":"","url":"https://api.github.com/users/akien-mga","html_url":"https://github.com/akien-mga","followers_url":"https://api.github.com/users/akien-mga/followers","following_url":"https://api.github.com/users/akien-mga/following{/other_user}","gists_url":"https://api.github.com/users/akien-mga/gists{/gist_id}","starred_url":"https://api.github.com/users/akien-mga/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/akien-mga/subscriptions","organizations_url":"https://api.github.com/users/akien-mga/orgs","repos_url":"https://api.github.com/users/akien-mga/repos","events_url":"https://api.github.com/users/akien-mga/events{/privacy}","received_events_url":"https://api.github.com/users/akien-mga/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-11-07T08:19:37Z","updated_at":"2025-11-07T08:19:37Z","body":"I'm neutral on this, but I agree that the rounded corners make the thin highlight a bit weird. It should also be tested with various DPI scales (on HiDPI it should be 2px tall).\r\n\r\nAnother idea if a highlight is really needed would be to underline the tab name with the accent color. Either the actual text if we can do that, or the whole tab (so introducing a line between the tab and its container).\r\nJust quick thoughts, I haven't mocked it up to see if it would look good.","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3501234499/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3501405664","html_url":"https://github.com/godotengine/godot/pull/112324#issuecomment-3501405664","issue_url":"https://api.github.com/repos/godotengine/godot/issues/112324","id":3501405664,"node_id":"IC_kwDOAO6SJc7QszXg","user":{"login":"passivestar","id":60579014,"node_id":"MDQ6VXNlcjYwNTc5MDE0","avatar_url":"https://avatars.githubusercontent.com/u/60579014?v=4","gravatar_id":"","url":"https://api.github.com/users/passivestar","html_url":"https://github.com/passivestar","followers_url":"https://api.github.com/users/passivestar/followers","following_url":"https://api.github.com/users/passivestar/following{/other_user}","gists_url":"https://api.github.com/users/passivestar/gists{/gist_id}","starred_url":"https://api.github.com/users/passivestar/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/passivestar/subscriptions","organizations_url":"https://api.github.com/users/passivestar/orgs","repos_url":"https://api.github.com/users/passivestar/repos","events_url":"https://api.github.com/users/passivestar/events{/privacy}","received_events_url":"https://api.github.com/users/passivestar/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-11-07T09:08:46Z","updated_at":"2025-11-07T09:08:46Z","body":"This is a matter of preference, but personally I agree that the line doesn't work as well on rounded tabs compared to the old rectangular ones. That's probably the reason it's rare to see rounded tabs with a top accent in UI nowadays.\r\n\r\nAlso note that unlike some apps that use an extra tab accent for app-wide focus indication and have only one accented tab at a time on screen, godot draws it per tabbar which makes the UI look busier.","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3501405664/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3501513198","html_url":"https://github.com/godotengine/godot/pull/112324#issuecomment-3501513198","issue_url":"https://api.github.com/repos/godotengine/godot/issues/112324","id":3501513198,"node_id":"IC_kwDOAO6SJc7QtNnu","user":{"login":"groud","id":6093119,"node_id":"MDQ6VXNlcjYwOTMxMTk=","avatar_url":"https://avatars.githubusercontent.com/u/6093119?v=4","gravatar_id":"","url":"https://api.github.com/users/groud","html_url":"https://github.com/groud","followers_url":"https://api.github.com/users/groud/followers","following_url":"https://api.github.com/users/groud/following{/other_user}","gists_url":"https://api.github.com/users/groud/gists{/gist_id}","starred_url":"https://api.github.com/users/groud/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/groud/subscriptions","organizations_url":"https://api.github.com/users/groud/orgs","repos_url":"https://api.github.com/users/groud/repos","events_url":"https://api.github.com/users/groud/events{/privacy}","received_events_url":"https://api.github.com/users/groud/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-11-07T09:36:19Z","updated_at":"2025-11-07T09:36:19Z","body":"I think the thin line does not look great, and indeed, I agree with @passivestar that, in general, those line do not work well with rounded UIs.\r\n\r\nAlso, I would like to point out that it does not bring a lot, UX-wise, to add that highlight there. It drags the attention too much on a thing that does not really need more attention IMO. If the contrast is still too low, I guess it could be increased again. Yet adding a accent color there is unneeded I think.\r\n\r\nI suspect many like this proposal because it looks aesthetically pleasing to add a bit more accent color. So while I don't think adding it to the tabs would work well with the new theme, there may be other places where we could do some touch-ups and add colors back. I would like it, but that's just a personal preference, and I am not sure about how and where it could be implemented.","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3501513198/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3503096126","html_url":"https://github.com/godotengine/godot/pull/112324#issuecomment-3503096126","issue_url":"https://api.github.com/repos/godotengine/godot/issues/112324","id":3503096126,"node_id":"IC_kwDOAO6SJc7QzQE-","user":{"login":"DeeJayLSP","id":60024671,"node_id":"MDQ6VXNlcjYwMDI0Njcx","avatar_url":"https://avatars.githubusercontent.com/u/60024671?v=4","gravatar_id":"","url":"https://api.github.com/users/DeeJayLSP","html_url":"https://github.com/DeeJayLSP","followers_url":"https://api.github.com/users/DeeJayLSP/followers","following_url":"https://api.github.com/users/DeeJayLSP/following{/other_user}","gists_url":"https://api.github.com/users/DeeJayLSP/gists{/gist_id}","starred_url":"https://api.github.com/users/DeeJayLSP/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/DeeJayLSP/subscriptions","organizations_url":"https://api.github.com/users/DeeJayLSP/orgs","repos_url":"https://api.github.com/users/DeeJayLSP/repos","events_url":"https://api.github.com/users/DeeJayLSP/events{/privacy}","received_events_url":"https://api.github.com/users/DeeJayLSP/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-11-07T15:09:17Z","updated_at":"2025-11-07T15:37:17Z","body":"Two alternatives in practice (both with a 2px line):\r\n\r\n| Surrounding line | Under line |\r\n|-|-|\r\n| ![surrounding](https://github.com/user-attachments/assets/196c1bca-1836-4cd7-ae87-2bf8dbbb1654)| ![bottom_line](https://github.com/user-attachments/assets/7ea124fb-7c55-4442-b5e2-b0f35ea226ab) |\r\n\r\nBoth bring the highlight back without looking ugly due to round borders.\r\n\r\nIf we did any change, I think I would agree with the under line, as it's neither ugly due to clashing with round corners, nor draws too much attention like the surrounding line.","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3503096126/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3503420465","html_url":"https://github.com/godotengine/godot/pull/112324#issuecomment-3503420465","issue_url":"https://api.github.com/repos/godotengine/godot/issues/112324","id":3503420465,"node_id":"IC_kwDOAO6SJc7Q0fQx","user":{"login":"groud","id":6093119,"node_id":"MDQ6VXNlcjYwOTMxMTk=","avatar_url":"https://avatars.githubusercontent.com/u/6093119?v=4","gravatar_id":"","url":"https://api.github.com/users/groud","html_url":"https://github.com/groud","followers_url":"https://api.github.com/users/groud/followers","following_url":"https://api.github.com/users/groud/following{/other_user}","gists_url":"https://api.github.com/users/groud/gists{/gist_id}","starred_url":"https://api.github.com/users/groud/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/groud/subscriptions","organizations_url":"https://api.github.com/users/groud/orgs","repos_url":"https://api.github.com/users/groud/repos","events_url":"https://api.github.com/users/groud/events{/privacy}","received_events_url":"https://api.github.com/users/groud/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-11-07T16:07:42Z","updated_at":"2025-11-07T16:07:42Z","body":"I think the first one still looks bad. And for the underline, the problem is that is creates a logical border between the tab name and its content. It really makes it look like two separated blocks, which is not great I believe.","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3503420465/reactions","total_count":3,"+1":3,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3503909237","html_url":"https://github.com/godotengine/godot/pull/112324#issuecomment-3503909237","issue_url":"https://api.github.com/repos/godotengine/godot/issues/112324","id":3503909237,"node_id":"IC_kwDOAO6SJc7Q2Wl1","user":{"login":"Mickeon","id":66727710,"node_id":"MDQ6VXNlcjY2NzI3NzEw","avatar_url":"https://avatars.githubusercontent.com/u/66727710?v=4","gravatar_id":"","url":"https://api.github.com/users/Mickeon","html_url":"https://github.com/Mickeon","followers_url":"https://api.github.com/users/Mickeon/followers","following_url":"https://api.github.com/users/Mickeon/following{/other_user}","gists_url":"https://api.github.com/users/Mickeon/gists{/gist_id}","starred_url":"https://api.github.com/users/Mickeon/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Mickeon/subscriptions","organizations_url":"https://api.github.com/users/Mickeon/orgs","repos_url":"https://api.github.com/users/Mickeon/repos","events_url":"https://api.github.com/users/Mickeon/events{/privacy}","received_events_url":"https://api.github.com/users/Mickeon/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-11-07T17:47:09Z","updated_at":"2025-11-07T17:47:09Z","body":"There's so much differing opinions on this highlight. Professionally, it doesn't belong in the new theme. Casually, some users genuinely like the highlight by sheer virtue of existing.\r\n\r\nI would heavily suggest opening a proposal as a result, and potentially gather more community feedback in other ways.","author_association":"MEMBER","reactions":{"url":"https://api.github.com/rep