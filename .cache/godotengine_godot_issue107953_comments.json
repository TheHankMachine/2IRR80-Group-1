7953","id":3012317304,"node_id":"IC_kwDOAO6SJc6zjFB4","user":{"login":"syntaxerror247","id":176927541,"node_id":"U_kgDOCouzNQ","avatar_url":"https://avatars.githubusercontent.com/u/176927541?v=4","gravatar_id":"","url":"https://api.github.com/users/syntaxerror247","html_url":"https://github.com/syntaxerror247","followers_url":"https://api.github.com/users/syntaxerror247/followers","following_url":"https://api.github.com/users/syntaxerror247/following{/other_user}","gists_url":"https://api.github.com/users/syntaxerror247/gists{/gist_id}","starred_url":"https://api.github.com/users/syntaxerror247/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/syntaxerror247/subscriptions","organizations_url":"https://api.github.com/users/syntaxerror247/orgs","repos_url":"https://api.github.com/users/syntaxerror247/repos","events_url":"https://api.github.com/users/syntaxerror247/events{/privacy}","received_events_url":"https://api.github.com/users/syntaxerror247/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-06-27T09:19:04Z","updated_at":"2025-06-27T09:19:04Z","body":"It’s not a major issue, but I don’t think it's too much work to change it. Personally, I’d prefer if the permission names used upper snake case, for consistency with how permissions are referenced to request them (android.permission.READ_EXTERNAL_STORAGE).","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3012317304/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3012320036","html_url":"https://github.com/godotengine/godot/pull/107953#issuecomment-3012320036","issue_url":"https://api.github.com/repos/godotengine/godot/issues/107953","id":3012320036,"node_id":"IC_kwDOAO6SJc6zjFsk","user":{"login":"AThousandShi