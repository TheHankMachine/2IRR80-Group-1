518733,"node_id":"MDU6TGFiZWwyODM1MTg3MzM=","url":"https://api.github.com/repos/godotengine/godot/labels/usability","name":"usability","color":"447744","default":false,"description":"","archived_at":null,"archived_by":null},{"id":2304948121,"node_id":"MDU6TGFiZWwyMzA0OTQ4MTIx","url":"https://api.github.com/repos/godotengine/godot/labels/topic:codestyle","name":"topic:codestyle","color":"ffee88","default":false,"description":"","archived_at":null,"archived_by":null}],"state":"closed","locked":false,"assignees":[],"milestone":{"url":"https://api.github.com/repos/godotengine/godot/milestones/22","html_url":"https://github.com/godotengine/godot/milestone/22","labels_url":"https://api.github.com/repos/godotengine/godot/milestones/22/labels","id":12070367,"node_id":"MI_kwDOAO6SJc4AuC3f","number":22,"title":"4.5","description":"","creator":{"login":"Sauermann","id":6299227,"node_id":"MDQ6VXNlcjYyOTkyMjc=","avatar_url":"https://avatars.githubusercontent.com/u/6299227?v=4","gravatar_id":"","url":"https://api.github.com/users/Sauermann","html_url":"https://github.com/Sauermann","followers_url":"https://api.github.com/users/Sauermann/followers","following_url":"https://api.github.com/users/Sauermann/following{/other_user}","gists_url":"https://api.github.com/users/Sauermann/gists{/gist_id}","starred_url":"https://api.github.com/users/Sauermann/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Sauermann/subscriptions","organizations_url":"https://api.github.com/users/Sauermann/orgs","repos_url":"https://api.github.com/users/Sauermann/repos","events_url":"https://api.github.com/users/Sauermann/events{/privacy}","received_events_url":"https://api.github.com/users/Sauermann/received_events","type":"User","user_view_type":"public","site_admin":false},"open_issues":3,"closed_issues":3687,"state":"closed","created_at":"2024-12-19T08:51:28Z","updated_at":"2026-09-04T21:48:38Z","due_on":"2025-09-15T00:00:00Z","closed_at":"2025-09-18T17:13:14Z"},"comments":1,"created_at":"2025-03-31T16:00:43Z","updated_at":"2025-04-03T21:58:53Z","closed_at":"2025-04-03T21:56:21Z","assignee":null,"author_association":"CONTRIBUTOR","issue_field_values":[],"type":null,"active_lock_reason":null,"draft":false,"pull_request":{"url":"https://api.github.com/repos/godotengine/godot/pulls/104850","html_url":"https://github.com/godotengine/godot/pull/104850","diff_url":"https://github.com/godotengine/godot/pull/104850.diff","patch_url":"https://github.com/godotengine/godot/pull/104850.patch","merged_at":"2025-04-03T21:56:21Z"},"body":"While looking into potential PRs for tackling ignored errors in a more methodical manner, I've realized just how invasive a lot of these suppression fields really are. Inspired by similar wrappers from some of our thirdparty libraries, this PR integrates new macros to streamline and consolidate the warning suppression process.\r\n\r\nBefore:\r\n```cpp\r\n#if defined(__GNUC__) && !defined(__clang__)\r\n#pragma GCC diagnostic push\r\n#pragma GCC diagnostic ignored \"-Wsome-warning\"\r\n#endif\r\n...\r\n#if defined(__GNUC__) && !defined(__clang__)\r\n#pragma GCC diagnostic pop\r\n#endif\r\n```\r\nAfter:\r\n```cpp\r\nGODOT_GCC_WARNING_PUSH_AND_IGNORE(\"-Wsome-warning\")\r\n...\r\nGODOT_GCC_WARNING_POP\r\n```\r\n\r\nThe name is a bit verbose, but that's the intent; this isn't something we want misused. To ensure no clashes, and to abide by the standard forbidding leading underscores, `GODOT` was chosen as the prefix for all of these macros. The next section is the compiler, in this case one of `GCC`, `CLANG`, or `MSVC`. Following that is the primary action, which has two instances: `PRAGMA` and `WARNING`. `WARNING` has subcategories for the common suppression calls: `PUSH`, `IGNORE`, and `POP`. There's one hybrid subcategory, `PUSH_AND_IGNORE`, for the instances with only a single warning to allow for one-liners.","closed_by":{"login":"Repiteo","id":17489292,"node_id":"MDQ6VXNlcjE3NDg5Mjky","avatar_url":"https://avatars.githubusercontent.com/u/17489292?v=4","gravatar_id":"","url":"https://api.github.com/users/Repiteo","html_url":"https://github.com/Repiteo","followers_url":"https://api.github.com/users/Repiteo/followers","following_url":"https://api.github.com/users/Repiteo/following{/other_user}","gists_url":"https://api.github.com/users/Repiteo/gists{/gist_id}","starred_url":"https://api.github.com/users/Repiteo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Repiteo/subscriptions","organizations_url":"https://api.github.com/users/Repiteo/orgs","repos_url":"https://api.github.com/users/Repiteo/repos","events_url":"https://api.github.com/users/Repiteo/events{/privacy}","received_events_url":"https://api.github.com/users/Repiteo/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/104850/reactions","total_count":3,"+1":3,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/godotengine/godot/issues/104850/timeline","performed_via_github_app":null,"state_reason":null}