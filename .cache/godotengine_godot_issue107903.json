\tStat.WRD : 10,\n}\n\nvar stats_growth : Dictionary[Stat, int] = {\n\tStat.HP_MAX : 30,\n\tStat.ATK : 10,\n\tStat.DEF : 20,\n\tStat.MAG : 5,\n\tStat.WRD : 10,\n}\n\nfunc leveled(lv : int) -> Dictionary[Stat, int]:\n\tvar dict : Dictionary[Stat, int] = {}\n\n\tfor s in Stat:     ## <-- Swap first \"for...\" w/second \n\t# for s in 5:     ## <----- to make this functional\n\t\tdict[s] = stats_base[s] + (stats_growth[s] * lv)\n\treturn dict\n\t\nfunc _ready() -> void:\n\tprint(str( leveled(1) ))\n\tprint(str( leveled(15) ))\n\tprint(str( leveled(70) ))\n\tprint(str( leveled(200) ))\n```\n\n### Minimal reproduction project (MRP)\n\n[dict_enum.zip](https://github.com/user-attachments/files/20869876/dict_enum.zip)","closed_by":{"login":"HolonProduction","id":99511741,"node_id":"U_kgDOBe5tvQ","avatar_url":"https://avatars.githubusercontent.com/u/99511741?v=4","gravatar_id":"","url":"https://api.github.com/users/HolonProduction","html_url":"https://github.com/HolonProduction","followers_url":"https://api.github.com/users/HolonProduction/followers","following_url":"https://api.github.com/users/HolonProduction/following{/other_user}","gists_url":"https://api.github.com/users/HolonProduction/gists{/gist_id}","starred_url":"https://api.github.com/users/HolonProduction/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/HolonProduction/subscriptions","organizations_url":"https://api.github.com/users/HolonProduction/orgs","repos_url":"https://api.github.com/users/HolonProduction/repos","events_url":"https://api.github.com/users/HolonProduction/events{/privacy}","received_events_url":"https://api.github.com/users/HolonProduction/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/107903/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/godotengine/godot/issues/1