.com/repos/godotengine/godot/issues/comments/3701340623/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3701571761","html_url":"https://github.com/godotengine/godot/issues/114341#issuecomment-3701571761","issue_url":"https://api.github.com/repos/godotengine/godot/issues/114341","id":3701571761,"node_id":"IC_kwDOAO6SJc7coYCx","user":{"login":"Kn1feKillz","id":251789733,"node_id":"U_kgDODwIBpQ","avatar_url":"https://avatars.githubusercontent.com/u/251789733?v=4","gravatar_id":"","url":"https://api.github.com/users/Kn1feKillz","html_url":"https://github.com/Kn1feKillz","followers_url":"https://api.github.com/users/Kn1feKillz/followers","following_url":"https://api.github.com/users/Kn1feKillz/following{/other_user}","gists_url":"https://api.github.com/users/Kn1feKillz/gists{/gist_id}","starred_url":"https://api.github.com/users/Kn1feKillz/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Kn1feKillz/subscriptions","organizations_url":"https://api.github.com/users/Kn1feKillz/orgs","repos_url":"https://api.github.com/users/Kn1feKillz/repos","events_url":"https://api.github.com/users/Kn1feKillz/events{/privacy}","received_events_url":"https://api.github.com/users/Kn1feKillz/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-12-31T06:49:15Z","updated_at":"2025-12-31T06:49:15Z","body":"This PR  #114467  should fix this issue. ","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3701571761/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null}]