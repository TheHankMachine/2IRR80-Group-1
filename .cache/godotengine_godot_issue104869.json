the original source wav in the godot folder\n\n### Minimal reproduction project (MRP)\n\n[wav-re-import-issue.zip](https://github.com/user-attachments/files/19544869/wav-re-import-issue.zip)\n\n- Open `boop.wav` in the inspector, and note how the waveform is small.\n- Re-import `boop.wav` with normalization turned on. Note how, despite it sounding louder, the waveform is still visually the same.\n- Close and re-open the project\n- Note how the waveform now accurately depicts the audio.","closed_by":{"login":"Calinou","id":180032,"node_id":"MDQ6VXNlcjE4MDAzMg==","avatar_url":"https://avatars.githubusercontent.com/u/180032?v=4","gravatar_id":"","url":"https://api.github.com/users/Calinou","html_url":"https://github.com/Calinou","followers_url":"https://api.github.com/users/Calinou/followers","following_url":"https://api.github.com/users/Calinou/following{/other_user}","gists_url":"https://api.github.com/users/Calinou/gists{/gist_id}","starred_url":"https://api.github.com/users/Calinou/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Calinou/subscriptions","organizations_url":"https://api.github.com/users/Calinou/orgs","repos_url":"https://api.github.com/users/Calinou/repos","events_url":"https://api.github.com/users/Calinou/events{/privacy}","received_events_url":"https://api.github.com/users/Calinou/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/104869/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/godotengine/godot/issues/104869/timeline","performed_via_github_app":null,"state_reason":"completed","pinned_comment":null}