00 } }) },\r\n\t\t{ Vector2(), \"v2\" },\r\n\t};\r\n\r\n\tCHECK(dict.size() == 4);\r\n\tCHECK(dict[0] == \"int\");\r\n\tCHECK(PackedStringArray(dict[\"packed_string_array\"])[2] == \"values\");\r\n\tCHECK(Dictionary(dict[\"key\"])[\"nested\"] == Variant(200));\r\n\tCHECK(dict[Vector2()] == \"v2\");\r\n}\r\n```\r\n\r\nNote that PackedStringArray has list initialiaztion available, but not Array. It's not implemented by https://github.com/godotengine/godot/pull/95920 either.","created_at":"2024-11-29T11:31:06Z","updated_at":"2024-11-29T11:31:13Z","html_url":"https://github.com/godotengine/godot/pull/99751#discussion_r1863386505","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/99751","_links":{"self":{"href":"https://api.github.com/repos/godotengine/godot/pulls/comments/1863386505"},"html":{"href":"https://github.com/godotengine/godot/pull/99751#discussion_r1863386505"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/99751"}},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/1863386505/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":98,"start_side":"RIGHT","line":null,"original_line":117,"side":"RIGHT","author_association":"MEMBER","original_position":11,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/1863389623","pull_request_review_id":2469718869,"id":1863389623,"node_id":"PRRC_kwDOAO6SJc5vERG3","diff_hunk":"@@ -95,6 +95,15 @@ TEST_CASE(\"[Dictionary] Assignment using bracket notation ([])\") {\n \tCHECK(map.size() == length);\n }\n \n+TEST_CASE(\"[Dictionary] List init\") {\n+\tDictionary dict{ { 0, \"int\" }, { \"key\", 200 }, { Vector2(), \"v2\" } };\n+\n+\tCHECK(dict.size() == 3);\n+\tCHECK(dict[0] == \"int\");\n+\tCHECK(dict[\"key\"] == Variant(200));\n+\tCHECK(dict[Vector2()] == \"v2\");\n+}","path":"tests/core/variant/test_