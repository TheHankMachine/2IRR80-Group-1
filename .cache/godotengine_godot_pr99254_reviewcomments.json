gine/godot/pull/99254#discussion_r1843520986"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/99254"}},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/1843520986/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":null,"original_line":null,"side":"RIGHT","author_association":"MEMBER","original_position":4,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/1844318052","pull_request_review_id":2439389028,"id":1844318052,"node_id":"PRRC_kwDOAO6SJc5t7g9k","diff_hunk":"@@ -205,9 +215,37 @@ int OS::get_exit_code() const {\n }\n \n void OS::set_exit_code(int p_code) {\n+\t// Don't allow setting the exit code to success if an error has\n+\t// occurred. Error tracking only happens when fail on error is enabled.\n+\tif (p_code == EXIT_SUCCESS && _error_occurred) {\n+\t\tWARN_PRINT_ONCE(\"Cannot set exit code to 0 after an error has occurred.\");\n+\t\treturn;\n+\t}","path":"core/os/os.cpp","commit_id":"1eb8583aa70da0a0a8c38d32eb9b7414c1504066","original_commit_id":"e79503dbb4cda832335fb11b5edb10e704530167","user":{"login":"Calinou","id":180032,"node_id":"MDQ6VXNlcjE4MDAzMg==","avatar_url":"https://avatars.githubusercontent.com/u/180032?v=4","gravatar_id":"","url":"https://api.github.com/users/Calinou","html_url":"https://github.com/Calinou","followers_url":"https://api.github.com/users/Calinou/followers","following_url":"https://api.github.com/users/Calinou/following{/other_user}","gists_url":"https://api.github.com/users/Calinou/gists{/gist_id}","starred_url":"https://api.github.com/users/Calinou/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Calinou/subscriptions","organizations_url":"https://api.github.com/users/Calinou/orgs","repos_url":"https://api.github.com/users/Calinou/repos","events_url":"https://api.github.com/users/Calinou/events{/privacy}","received_events_url":"https://api.github.com/users/Calinou/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"Shouldn't this behavior only apply with `--fail-on-error`? This may break some user expectations otherwise, as the exit code can be specified as an optional parameter to `get_tree().quit()`.","created_at":"2024-11-15T18:49:45Z","updated_at":"2024-11-15T18:49:45Z","html_url":"https://github.com/godotengine/godot/pull/99254#discussion_r1844318052","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/99254","_links":{"self":{"href":"https://api.github.com/repos/godotengine/godot/pulls/comments/1844318052"},"html":{"href":"https://github.com/godotengine/godot/pull/99254#discussion_r1844318052"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/99254"}},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/1844318052/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":null,"original_line":null,"side":"RIGHT","author_association":"MEMBER","original_position":26,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/1844381394","pull_request_review_id":2439484992,"id":1844381394,"node_id":"PRRC_kwDOAO6SJc5t7wbS","diff_hunk":"@@ -205,9 +215,37 @@ int OS::get_exit_code() const {\n }\n \n void OS::set_exit_code(int p_code) {\n+\t// Don't allow setting the exit code to success if an error has\n+\t// occurred. Error tracking only happens when fail on error is enabled.\n+\tif (p_code == EXIT_SUCCESS && _error_occurred) {\n+\t\tWARN_PRINT_ONCE(\"Cannot set exit code to 0 after an error has occurred.\");\n+\t\treturn;\n+\t}","path":"core/os/os.cpp","commit_id":"1eb8583aa70da0a0a8c38d32eb9b7414c1504066","original_commit_id":"e79503dbb4cda832335fb11b5edb10e704530167","user":{"login":"dbnicholson","id":6495518,"node_id":"MDQ6VXNlcjY0OTU1MTg=","avatar_url":"https://avatars.githubusercontent.com/u/6495518?v=4","gravatar_id":"","url":"https://api.github.com/users/dbnicholson","html_url":"https://github.com/dbnicholson","followers_url":"https://api.github.com/users/dbnicholson/followers","following_url":"https://api.github.com/users/dbnicholson/following{/other_user}","gists_url":"https://api.github.com/users/dbnicholson/gists{/gist_id}","starred_url":"https://api.github.com/users/dbnicholson/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/dbnicholson/subscriptions","organizations_url":"https://api.github.com/users/dbnicholson/orgs","repos_url":"https://api.github.com/users/dbnicholson/repos","events_url":"https://api.github.com/users/dbnicholson/events{/privacy}","received_events_url":"https://api.github.com/users/dbnicholson/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"It sorta does. Currently `_error_occurred` is only set by the error handler when `_fail_on_error` is also true. So, implicitly `_error_occurred` also means `_fail_on_error`. Originally `_error_occurred` was just a private boolean, but I later added the accessors when writing the test so I could check and restore the value without failing the whole process. So, `_error_occurred` no longer guarantees `_fail_on_error` since some other part of Godot could call `set_error_occurred(true)`. So, maybe the conditional should be expanded to check both flags to ensure this only happens with `--fail-on-error` and that an error was detected.\r\n\r\nThe whole point of this part is about how users call `get_tree().quit()`. Since Godot will carry on in the face of script errors, you could have a reasonable `quit()` or `quit(0)` in an unrelated location that would be executed and revert the exit code to 0. Here's a contrived example:\r\n\r\n```\r\nextends SceneTree\r\n\r\n\r\nfunc _init():\r\n\tvar a = Node.new()\r\n\ta.free()\r\n\tvar b: Node = a\r\n\r\n\r\nfunc _process(_delta):\r\n\tquit()\r\n```\r\n\r\nWithout the above block, this script would exit 0 even with `--fail-on-error`. You may be wondering why `_error_occurred` is needed at all. If this only checked `_fail_on_error`, then that once `quit(1)` was called, it couldn't be changed back with `quit(0)`. In other words, `_error_occurred` is being used as a proxy for \"the exit code was changed to a failure because an error was handled\". It's trying to maintain flexibility for users calling `quit()` while preventing them from inadvertently changing it back to 0 since they have no way to know an error occurred.\r\n\r\nIt would be nice if there was a way to stop the main loop without also setting the exit code. For example, if the `quit()` default exit code was -1, then users could call a bare `quit()` and not influence the exit code. Then it would be less likely for this block to be needed since someone would have to explicitly be calling `quit(0)`, and that seems less likely than `quit()`. Would likely still break someone's usage and it would change the API.","created_at":"2024-11-15T19:48:53Z","updated_at":"2024-11-15T19:48:53Z","html_url":"https://github.com/godotengine/godot/pull/99254#discussion_r1844381394","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/99254","_links":{"self":{"href":"https://api.github.com/repos/godotengine/godot/pulls/comments/1844381394"},"html":{"href":"https://github.com/godotengine/godot/pull/99254#discussion_r1844381394"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/99254"}},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/1844381394/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":null,"original_line":null,"side":"RIGHT","in_reply_to_id":1844318052,"author_association":"CONTRIBUTOR","original_position":26,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/1846730051","pull_request_review_id":2442862067,"id":1846730051,"node_id":"PRRC_kwDOAO6SJc5uEt1D","diff_hunk":"@@ -205,9 +215,37 @@ int OS::get_exit_code() const {\n }\n \n void OS::set_exit_code(int p_code) {\n+\t// Don't allow setting the exit code to success if an error has\n+\t// occurred. Error tracking only happens when fail on error is enabled.\n+\tif (p_code == EXIT_SUCCESS && _error_occurred) {\n+\t\tWARN_PRINT_ONCE(\"Cannot set exit code to 0 after an error has occurred.\");\n+\t\treturn;\n+\t}","path":"core/os/os.cpp","commit_id":"1eb8583aa70da0a0a8c38d32eb9b7414c1504066","original_commit_id":"e79503dbb4cda832335fb11b5edb10e704530167","user":{"login":"dbnicholson","id":6495518,"node_id":"MDQ6VXNlcjY0OTU1MTg=","avatar_url":"https://avatars.githubusercontent.com/u/6495518?v=4","gravatar_id":"","url":"https://api.github.com/users/dbnicholson","html_url":"https://github.com/dbnicholson","followers_url":"https://api.github.com/users/dbnicholson/followers","following_url":"https://api.github.com/users/dbnicholson/following{/other_user}","gists_url":"https://api.github.com/users/dbnicholson/gists{/gist_id}","starred_url":"https://api.github.com/users/dbnicholson/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/dbnicholson/subscriptions","organizations_url":"https://api.github.com/users/dbnicholson/orgs","repos_url":"https://api.github.com/users/dbnicholson/repos","events_url":"https://api.github.com/users/dbnicholson/events{/privacy}","received_events_url":"https://api.github.com/users/dbnicholson/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"Sorry, that was a big tangent about `quit()`. I agree that guarding `set_exit_code` should only happen when fail on error is enabled and pushed a fixup with that change. I can squash it into the first commit if you agree.","created_at":"2024-11-18T14:55:16Z","updated_at":"2024-11-18T14:55:16Z","html_url":"https://github.com/godotengine/godot/pull/99254#discussion_r1846730051","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/99254","_links":{"self":{"href":"https://api.github.com/repos/godotengine/godot/pulls/comments/1846730051"},"html":{"href":"https://github.com/godotengine/godot/pull/99254#discussion_r1846730051"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/99254"}},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/1846730051/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":null,"original_line":null,"side":"RIGHT","in_reply_to_id":1844318052,"author_association":"CONTRIBUTOR","original_position":26,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/1847319649","pull_request_review_id":2443799942,"id":1847319649,"node_id":"PRRC_kwDOAO6SJc5uG9xh","diff_hunk":"@@ -621,6 +621,9 @@ void Main::print_help(const char *p_binary) {\n \tprint_help_title(\"Debug options\");\n \tprint_help_option(\"-d, --debug\", \"Debug (local stdout debugger).\\n\");\n \tprint_help_option(\"-b, --breakpoints\", \"Breakpoint list as source::line comma-separated pairs, no spaces (use %%20 instead).\\n\");\n+#ifdef DEBUG_ENABLED\n+\tprint_help_option(\"--fail-on-error\", \"Exit with a failure code if any errors are encountered.\\n\", CLI_OPTION_AVAILABILITY_TEMPLATE_DEBUG);\n+#endif","path":"main/main.cpp","commit_id":"1eb8583aa70da0a0a8c38d32eb9b7414c1504066","original_commit_id":"065c9f79672dc112e6310a65f813f95b1b22b272","user":{"login":"Calinou","id":180032,"node_id":"MDQ6VXNlcjE4MDAzMg==","avatar_url":"https://avatars.githubusercontent.com/u/180032?v=4","gravatar_id":"","url":"https://api.github.com/users/Calinou","html_url":"https:/