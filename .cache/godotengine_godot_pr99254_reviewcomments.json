3658/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":null,"original_line":null,"side":"RIGHT","in_reply_to_id":1847320908,"author_association":"CONTRIBUTOR","original_position":5,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/1848656247","pull_request_review_id":2445955963,"id":1848656247,"node_id":"PRRC_kwDOAO6SJc5uMEF3","diff_hunk":"@@ -205,9 +215,37 @@ int OS::get_exit_code() const {\n }\n \n void OS::set_exit_code(int p_code) {\n+\t// Don't allow setting the exit code to success if an error has\n+\t// occurred. Error tracking only happens when fail on error is enabled.\n+\tif (p_code == EXIT_SUCCESS && _error_occurred) {\n+\t\tWARN_PRINT_ONCE(\"Cannot set exit code to 0 after an error has occurred.\");\n+\t\treturn;\n+\t}","path":"core/os/os.cpp","commit_id":"1eb8583aa70da0a0a8c38d32eb9b7414c1504066","original_commit_id":"e79503dbb4cda832335fb11b5edb10e704530167","user":{"login":"dbnicholson","id":6495518,"node_id":"MDQ6VXNlcjY0OTU1MTg=","avatar_url":"https://avatars.githubusercontent.com/u/6495518?v=4","gravatar_id":"","url":"https://api.github.com/users/dbnicholson","html_url":"https://github.com/dbnicholson","followers_url":"https://api.github.com/users/dbnicholson/followers","following_url":"https://api.github.com/users/dbnicholson/following{/other_user}","gists_url":"https://api.github.com/users/dbnicholson/gists{/gist_id}","starred_url":"https://api.github.com/users/dbnicholson/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/dbnicholson/subscriptions","organizations_url":"https://api.github.com/users/dbnicholson/orgs","repos_url":"https://api.github.com/users/dbnicholson/repos","events_url":"https://api.github.com/users/dbnicholson/events{/privacy}","received_events_url":"https://api.github.com/users/dbnicholson/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"I had one more thought here. Since `fail_on_error` and `error_occurred` are independent, then the error handler should always set `error_occurred` and `set_error_occurred` should check whether `fail_on_error` is set before changing the exit code. It's a minor change, but that way if something calls `OS::set_error_occurred(true)`, it doesn't fail the process unless `fail_on_error` is `true`.\r\n\r\nSimilarly, if the error handler always sets `error_occurred`, then you can reliably query it from other places. I could see in the future where the flags are in the bound interface and it would be really useful to check `OS.error_occurred` in a script to know if there was an error somewhere.\r\n\r\nDoes that make sense? I pushed a fixup commit with that change.","created_at":"2024-11-19T16:13:36Z","updated_at":"2024-11-19T16:13:36Z","html_url":"https://github.com/godotengine/godot/pull/99254#discussion_r1848656247","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/99254","_links":{"self":{"href":"https://api.github.com/repos/godotengine/godot/pulls/comments/1848656247"},"html":{"href":"https://github.com/godotengine/godot/pull/99254#discussion_r1848656247"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/99254"}},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/1848656247/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":null,"original_line":null,"side":"RIGHT","in_reply_to_id":1844318052,"author_association":"CONTRIBUTOR","original_position":26,"position":1,"subject_type":"line"}]