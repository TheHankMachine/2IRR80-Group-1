Z"},{"id":4173830036,"node_id":"PRR_kwDOAO6SJc74x5eU","state":"COMMENTED","commit_id":"e6521e45b4bc65f04f07835c48c035c5a3eec274","user":{"site_admin":false,"suspended":false,"updated_at":"0001-01-01T00:00:00Z","avatar_url":"https://avatars.githubusercontent.com/u/17818610?u=b86b707bdb9ecd2f5ddc85ce261b8d42bde99422&v=4","created_at":"0001-01-01T00:00:00Z","followers":0,"following":0,"html_url":"https://github.com/h1v9","id":17818610,"node_id":"MDQ6VXNlcjE3ODE4NjEw","login":"h1v9","type":"User","owned_private_repos":0,"public_gists":0,"public_repos":0,"total_private_repos":0,"url":"https://api.github.com/users/h1v9"},"body":"","html_url":"https://github.com/godotengine/godot/pull/118922#pullrequestreview-4173830036","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/118922","author_association":"CONTRIBUTOR","submitted_at":"2026-04-24T22:47:41Z"},{"id":4174344362,"node_id":"PRR_kwDOAO6SJc74z3Cq","state":"COMMENTED","commit_id":"7ce719fc669483f8e7a6111a17875aa5b5eaec8e","user":{"site_admin":false,"suspended":false,"updated_at":"0001-01-01T00:00:00Z","avatar_url":"https://avatars.githubusercontent.com/u/73148864?v=4","created_at":"0001-01-01T00:00:00Z","followers":0,"following":0,"html_url":"https://github.com/Ryan-000","id":73148864,"node_id":"MDQ6VXNlcjczMTQ4ODY0","login":"Ryan-000","type":"User","owned_private_repos":0,"public_gists":0,"public_repos":0,"total_private_repos":0,"url":"https://api.github.com/users/Ryan-000"},"body":"","html_url":"https://github.com/godotengine/godot/pull/118922#pullrequestreview-4174344362","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/118922","author_association":"CONTRIBUTOR","submitted_at":"2026-04-25T01:13:09Z"},{"id":4174371338,"node_id":"PRR_kwDOAO6SJc74z9oK","state":"COMMENTED","commit_id":"7ce719fc669483f8e7a6111a17875aa5b5eaec8e","user":{"site_admin":false,"suspended":false,"updated_at":"0001-01-01T00:00:00Z","avatar_url":"https://avatars.githubusercontent.com/u/17818610?u=b86b70