GNORE(\"-Wshadow\")\r\n-#if defined(__EMSCRIPTEN__) || __clang_major__ >= 21\r\n+#if defined(__EMSCRIPTEN__) || (defined(__MINGW32__) && __clang_major__ >= 21)\r\n GODOT_CLANG_WARNING_PUSH_AND_IGNORE(\"-Wunnecessary-virtual-specifier\")\r\n #endif\r\n \r\n@@ -113,7 +113,7 @@ GODOT_CLANG_WARNING_PUSH_AND_IGNORE(\"-Wunnecessary-virtual-specifier\")\r\n #include <unicode/utypes.h>\r\n \r\n GODOT_GCC_WARNING_POP\r\n-#if defined(__EMSCRIPTEN__) || __clang_major__ >= 21\r\n+#if defined(__EMSCRIPTEN__) || (defined(__MINGW32__) && __clang_major__ >= 21)\r\n GODOT_CLANG_WARNING_POP\r\n #endif\r\n \r\n```","state":"CHANGES_REQUESTED","html_url":"https://github.com/godotengine/godot/pull/113761#pullrequestreview-3719023131","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/113761","author_association":"CONTRIBUTOR","_links":{"html":{"href":"https://github.com/godotengine/godot/pull/113761#pullrequestreview-3719023131"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/113761"}},"submitted_at":"2026-01-28T20:30:33Z","commit_id":null},{"id":3719613128,"node_id":"PRR_kwDOAO6SJc7dtMrI","user":{"login":"Repiteo","id":17489292,"node_id":"MDQ6VXNlcjE3NDg5Mjky","avatar_url":"https://avatars.githubusercontent.com/u/17489292?u=34072b401722100a7c0c0d61e37b376cf22b4545&v=4","gravatar_id":"","url":"https://api.github.com/users/Repiteo","html_url":"https://github.com/Repiteo","followers_url":"https://api.github.com/users/Repiteo/followers","following_url":"https://api.github.com/users/Repiteo/following{/other_user}","gists_url":"https://api.github.com/users/Repiteo/gists{/gist_id}","starred_url":"https://api.github.com/users/Repiteo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Repiteo/subscriptions","organizations_url":"https://api.github.com/users/Repiteo/orgs","repos_url":"https://api.github.com/users/Repiteo/repos","events_url":"https://api.github.com/users/Repiteo/events{/privacy}","received_events_url":"http