d still, so the export still fails.\n\nI'm also puzzled why this file is copied just for iOS as I've tested `.NET 8` and `.NET 9` with Native AOT enabled on other platforms and it doesn't seem to make a difference that it's not copied there. Maybe on other platforms my code didn't require the presence of that file or the export process is different and it is actually being included, I'm not sure.","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2525287073/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2525291502","html_url":"https://github.com/godotengine/godot/issues/100123#issuecomment-2525291502","issue_url":"https://api.github.com/repos/godotengine/godot/issues/100123","id":2525291502,"node_id":"IC_kwDOAO6SJc6WhOPu","user":{"login":"atlasapplications","id":60163495,"node_id":"MDQ6VXNlcjYwMTYzNDk1","avatar_url":"https://avatars.githubusercontent.com/u/60163495?v=4","gravatar_id":"","url":"https://api.github.com/users/atlasapplications","html_url":"https://github.com/atlasapplications","followers_url":"https://api.github.com/users/atlasapplications/followers","following_url":"https://api.github.com/users/atlasapplications/following{/other_user}","gists_url":"https://api.github.com/users/atlasapplications/gists{/gist_id}","starred_url":"https://api.github.com/users/atlasapplications/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/atlasapplications/subscriptions","organizations_url":"https://api.github.com/users/atlasapplications/orgs","repos_url":"https://api.github.com/users/atlasapplications/repos","events_url":"https://api.github.com/users/atlasapplications/events{/privacy}","received_events_url":"https://api.github.com/users/atlasapplications/received_events","type":"User","user_