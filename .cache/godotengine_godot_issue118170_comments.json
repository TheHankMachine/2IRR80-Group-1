/api.github.com/users/mashumafi/gists{/gist_id}","starred_url":"https://api.github.com/users/mashumafi/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/mashumafi/subscriptions","organizations_url":"https://api.github.com/users/mashumafi/orgs","repos_url":"https://api.github.com/users/mashumafi/repos","events_url":"https://api.github.com/users/mashumafi/events{/privacy}","received_events_url":"https://api.github.com/users/mashumafi/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-04-07T15:45:00Z","updated_at":"2026-04-07T15:45:00Z","body":"in favor of https://github.com/godotengine/godot/pull/114872","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4200315130/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null}]