oSamo/following{/other_user}","gists_url":"https://api.github.com/users/DarioSamo/gists{/gist_id}","starred_url":"https://api.github.com/users/DarioSamo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/DarioSamo/subscriptions","organizations_url":"https://api.github.com/users/DarioSamo/orgs","repos_url":"https://api.github.com/users/DarioSamo/repos","events_url":"https://api.github.com/users/DarioSamo/events{/privacy}","received_events_url":"https://api.github.com/users/DarioSamo/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-07-24T18:16:00Z","updated_at":"2025-07-24T18:16:00Z","body":"This line should be wrapped with `if frames not empty` check based on the render graph's own state instead.\r\n\r\nhttps://github.com/godotengine/godot/blob/e0603aeda3ce0e15c5843f5202172a56f3ff5534/servers/rendering/rendering_device_graph.cpp#L1578","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3114404437/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3128026351","html_url":"https://github.com/godotengine/godot/pull/108919#issuecomment-3128026351","issue_url":"https://api.github.com/repos/godotengine/godot/issues/108919","id":3128026351,"node_id":"IC_kwDOAO6SJc66ceTv","user":{"login":"Repiteo","id":17489292,"node_id":"MDQ6VXNlcjE3NDg5Mjky","avatar_url":"https://avatars.githubusercontent.com/u/17489292?v=4","gravatar_id":"","url":"https://api.github.com/users/Repiteo","html_url":"https://github.com/Repiteo","followers_url":"https://api.github.com/users/Repiteo/followers","following_url":"https://api.github.com/users/Repiteo/following{/other_user}","gists_url":"https://api.github.com/users/Repiteo/gists{/gist_id}","starred_url":"https://api.github.com/users/Repiteo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Repiteo/subscriptions","organizations_url":"https://api.github.com/users/Repiteo/orgs","repos_url":"https://api.github.com/users/Repiteo/repos","events_url":"https://api.github.com/users/Repiteo/events{/privacy}","received_events_url":"https://api.github.com/users/Repiteo/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-07-28T16:24:03Z","updated_at":"2025-07-28T16:24:03Z","body":"@KeyboardDanni Have you gotten the chance to integrate Dario's suggestions?","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3128026351/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3128227907","html_url":"https://github.com/godotengine/godot/pull/108919#issuecomment-3128227907","issue_url":"https://api.github.com/repos/godotengine/godot/issues/108919","id":3128227907,"node_id":"IC_kwDOAO6SJc66dPhD","user":{"login":"KeyboardDanni","id":34800072,"node_id":"MDQ6VXNlcjM0ODAwMDcy","avatar_url":"https://avatars.githubusercontent.com/u/34800072?v=4","gravatar_id":"","url":"https://api.github.com/users/KeyboardDanni","html_url":"https://github.com/KeyboardDanni","followers_url":"https://api.github.com/users/KeyboardDanni/followers","following_url":"https://api.github.com/users/KeyboardDanni/following{/other_user}","gists_url":"https://api.github.com/users/KeyboardDanni/gists{/gist_id}","starred_url":"https://api.github.com/users/KeyboardDanni/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/KeyboardDanni/subscriptions","organizations_url":"https://api.github.com/users/KeyboardDanni/orgs","repos_url":"https://api.github.com/users/KeyboardDanni/repos","events_url":"https://api.github.com/users/KeyboardDanni/events{/privacy}","received_events_url":"https://api.github.com/users/KeyboardDanni/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-07-28T17:18:20Z","updated_at":"2025-07-28T17:18:20Z","body":"@Repiteo Requested change has been made.","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3128227907/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3128292831","html_url":"https://github.com/godotengine/godot/pull/108919#issuecomment-3128292831","issue_url":"https://api.github.com/repos/godotengine/godot/issues/108919","id":3128292831,"node_id":"IC_kwDOAO6SJc66dfXf","user":{"login":"DarioSamo","id":538504,"node_id":"MDQ6VXNlcjUzODUwNA==","avatar_url":"https://avatars.githubusercontent.com/u/538504?v=4","gravatar_id":"","url":"https://api.github.com/users/DarioSamo","html_url":"https://github.com/DarioSamo","followers_url":"https://api.github.com/users/DarioSamo/followers","following_url":"https://api.github.com/users/DarioSamo/following{/other_user}","gists_url":"https://api.github.com/users/DarioSamo/gists{/gist_id}","starred_url":"https://api.github.com/users/DarioSamo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/DarioSamo/subscriptions","organizations_url":"https://api.github.com/users/DarioSamo/orgs","repos_url":"https://api.github.com/users/DarioSamo/repos","events_url":"https://api.github.com/users/DarioSamo/events{/privacy}","received_events_url":"https://api.github.com/users/DarioSamo/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-07-28T17:35:57Z","updated_at":"2025-07-28T17:36:30Z","body":"Changes look good to me, but I'm a bit suspect about the SM 6.1 change.\r\n\r\nAs per [this page](https://github.com/microsoft/DirectXShaderCompiler/wiki/Shader-Model-6.1), the additions to SM 6.1 seem to be:\r\n```md\r\n[SV_ViewID](https://github.com/microsoft/DirectXShaderCompiler/wiki/SV_ViewID). This feature enables instancing of the graphics pipeline by \"view\", in a manner that is orthogonal to draw instancing.\r\n[SV_Barycentrics](https://github.com/microsoft/DirectXShaderCompiler/wiki/SV_Barycentrics). This is a new system-generated value available in pixel shaders, used for example to perform interpolation over small or unaligned values like a few bits from a 32-bit value.\r\n```\r\nViewID is only relevant for multiview (XR), so unless it is enabled, it won't get compiled. And I don't think there's a GLSL construct for barycentrics. I'm not sure the provided comment is good enough of a justification to bump the minimum SM required unless we get something that proves it necessary.","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3128292831/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3130234838","html_url":"https://github.com/godotengine/godot/pull/108919#issuecomment-3130234838","issue_url":"https://api.github.com/repos/godotengine/godot/issues/108919","id":3130234838,"node_id":"IC_kwDOAO6SJc66k5fW","user":{"login":"KeyboardDanni","id":34800072,"node_id":"MDQ6VXNlcjM0ODAwMDcy","avatar_url":"https://avatars.githubusercontent.com/u/34800072?v=4","gravatar_id":"","url":"https://api.github.com/users/KeyboardDanni","html_url":"https://github.com/KeyboardDanni","followers_url":"https://api.github.com/users/KeyboardDanni/followers","following_url":"https://api.github.com/users/KeyboardDanni/following{/other_user}","gists_url":"https://api.github.com/users/KeyboardDanni/gists{/gist_id}","starred_url":"https://api.github.com/user