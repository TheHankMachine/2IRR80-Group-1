Ships/following{/other_user}","gists_url":"https://api.github.com/users/AThousandShips/gists{/gist_id}","starred_url":"https://api.github.com/users/AThousandShips/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/AThousandShips/subscriptions","organizations_url":"https://api.github.com/users/AThousandShips/orgs","repos_url":"https://api.github.com/users/AThousandShips/repos","events_url":"https://api.github.com/users/AThousandShips/events{/privacy}","received_events_url":"https://api.github.com/users/AThousandShips/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-08-27T21:34:26Z","updated_at":"2025-08-27T21:34:26Z","body":"It's not really a bug, adding checks for finite numbers would be expensive for a rare edge case of user error","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3229815727/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3229868829","html_url":"https://github.com/godotengine/godot/issues/110011#issuecomment-3229868829","issue_url":"https://api.github.com/repos/godotengine/godot/issues/110011","id":3229868829,"node_id":"IC_kwDOAO6SJc7Ag-Md","user":{"login":"SuperBidi","id":61278063,"node_id":"MDQ6VXNlcjYxMjc4MDYz","avatar_url":"https://avatars.githubusercontent.com/u/61278063?v=4","gravatar_id":"","url":"https://api.github.com/users/SuperBidi","html_url":"https://github.com/SuperBidi","followers_url":"https://api.github.com/users/SuperBidi/followers","following_url":"https://api.github.com/users/SuperBidi/following{/other_user}","gists_url":"https://api.github.com/users/SuperBidi/gists{/gist_id}","starred_url":"https://api.github.com/users/SuperBidi/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/SuperBidi/subscriptions","organizations_url":"https://api.github.com/users/SuperBidi/orgs","repos_url":"https://api.github.com/users/SuperBidi/repos","events_url":"https://api.github.com/users/SuperBidi/events{/privacy}","received_events_url":"https://api.github.com/users/SuperBidi/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-08-27T21:58:58Z","updated_at":"2025-08-27T22:14:58Z","body":"The issue is that Godot then behaves in a weird way.\nFirst, it throws errors when sorting Nodes. Second a single Node catches all gui_inputs. So at that stage, Godot becomes rather unusable.\nAlso, it is the kind of things that can be done only in debug. Having clear feedback when you make a mistake is a plus.\n\nAnyway, I've found my bug so it's on your hands now. At least, if someone reports something similar, they'll be able to find this discussion.","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3229868829/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null}]