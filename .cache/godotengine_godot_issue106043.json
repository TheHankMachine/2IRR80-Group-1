iption":"","archived_at":null,"archived_by":null},{"id":370471795,"node_id":"MDU6TGFiZWwzNzA0NzE3OTU=","url":"https://api.github.com/repos/godotengine/godot/labels/topic:thirdparty","name":"topic:thirdparty","color":"ffee88","default":false,"description":"","archived_at":null,"archived_by":null}],"state":"closed","locked":false,"assignees":[],"milestone":null,"comments":1,"created_at":"2025-05-03T00:07:59Z","updated_at":"2025-06-15T20:32:00Z","closed_at":"2025-06-15T15:22:22Z","assignee":null,"author_association":"NONE","issue_field_values":[],"type":null,"active_lock_reason":null,"draft":false,"pull_request":{"url":"https://api.github.com/repos/godotengine/godot/pulls/106043","html_url":"https://github.com/godotengine/godot/pull/106043","diff_url":"https://github.com/godotengine/godot/pull/106043.diff","patch_url":"https://github.com/godotengine/godot/pull/106043.patch","merged_at":null},"body":"fixes #106006. converting white (rgb 1,1,1) to okhsv was returning nan for saturation due to a divide-by-zero when chroma is zero. this happens because lab.a and lab.b are both zero for white, so chroma is zero, and the code tries to normalize it anyway.\n\nthis adds a check for near-zero chroma (less than 1e-8) and returns sensible default values instead. hue is set to 0 (arbitrary), saturation to 0, and value is based on luminance from the lab color.\n\nthis avoids floating point exceptions and gives stable output for grayscale colors. fix is minimal and isolated.","closed_by":{"login":"maxcomperatore","id":131000419,"node_id":"U_kgDOB87oYw","avatar_url":"https://avatars.githubusercontent.com/u/131000419?v=4","gravatar_id":"","url":"https://api.github.com/users/maxcomperatore","html_url":"https://github.com/maxcomperatore","followers_url":"https://api.github.com/users/maxcomperatore/followers","following_url":"https://api.github.com/users/maxcomperatore/following{/other_user}","gists_url":"https://api.github.com/users/maxcomperatore/gists{/gist_id}","starred_url":"https:/