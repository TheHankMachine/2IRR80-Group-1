s/MarianoGnu/orgs","repos_url":"https://api.github.com/users/MarianoGnu/repos","events_url":"https://api.github.com/users/MarianoGnu/events{/privacy}","received_events_url":"https://api.github.com/users/MarianoGnu/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-09-14T15:20:00Z","updated_at":"2026-09-14T15:20:15Z","body":"I detected many bugs that needs fixing:\r\n- When using dir picker to import a project, the project added has a trailing `/` in the path, this causes the project to appear repeated when a `scan` runs again (but not if reloading the page)\r\n- When drag and droping a folder, the name of the folder is stripped from the project path\r\n- You can combine the previous 2 issues to get a duplicated entry\r\n- Drag and drop a ZIP file seems to stop working\r\n\r\n<img width=\"1920\" height=\"1040\" alt=\"image\" src=\"https://github.com/user-attachments/assets/7208454a-45ba-44db-b299-00a09a5facb8\" />\r\n","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5666302529/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5697683509","html_url":"https://github.com/godotengine/godot/pull/123149#issuecomment-5697683509","issue_url":"https://api.github.com/repos/godotengine/godot/issues/123149","id":5697683509,"node_id":"IC_kwDOAO6SJc8AAAABU5vANQ","user":{"login":"Arnklit","id":4955051,"node_id":"MDQ6VXNlcjQ5NTUwNTE=","avatar_url":"https://avatars.githubusercontent.com/u/4955051?v=4","gravatar_id":"","url":"https://api.github.com/users/Arnklit","html_url":"https://github.com/Arnklit","followers_url":"https://api.github.com/users/Arnklit/followers","following_url":"https://api.github.com/users/Arnklit/following{/other_user}","gists_url":"https://api.github.com/users/Arnklit/gists{/gist_id}","starred_url":"https://api.github.com/users/Arnklit/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Arnklit/subscriptions","organizations_url":"https://api.github.com/users/Arnklit/orgs","repos_url":"https://api.github.com/users/Arnklit/repos","events_url":"https://api.github.com/users/Arnklit/events{/privacy}","received_events_url":"https://api.github.com/users/Arnklit/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-09-16T12:48:49Z","updated_at":"2026-09-16T12:48:49Z","body":"I tried it out now without looking at the code and for the most part it works great. I did notice a few things:\r\n\r\nOne issue I ran into was on Firefox, when you use the download function, it doesn't give you a popup to name the file with \".zip\" appended. It just downloads the file directly with no file extension. On Chrome it works as expected.\r\n\r\nI wonder if the `Download backup before deleting` checkbox should be greyed out until the `I understand` is checked as well. Not sure what is the standard UX here, but it feels like this box does nothing until you've accepted the `I understand`, so there is no reason to toggle it until you've checked `I understand`\r\n\r\n<img width=\"615\" height=\"351\" alt=\"image\" src=\"https://github.com/user-attachments/assets/f21b862e-20f3-4959-84af-0f3d5f4e14d3\" />\r\n\r\n","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5697683509/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5697888977","html_url":"https://github.com/godotengine/godot/pull/123149#issuecomment-5697888977","issue_url":"https://api.github.com/repos/godotengine/godot/issues/123149","id":5697888977,"node_id":"IC_kwDOAO6SJc8AAAABU57i0Q","user":{"login":"M