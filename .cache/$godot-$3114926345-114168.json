.com/repos/godotengine/godot/pulls/114168","author_association":"CONTRIBUTOR","submitted_at":"2026-05-18T16:24:42Z"},{"id":4312091781,"node_id":"PRR_kwDOAO6SJc8AAAABAQVMhQ","state":"COMMENTED","commit_id":"f6edc05ed534ba7c9505a5a30acca05edff1c591","user":{"site_admin":false,"suspended":false,"updated_at":"0001-01-01T00:00:00Z","avatar_url":"https://avatars.githubusercontent.com/u/9957987?u=64fc5e539030609be0447a74243d9fc643fa9bf3&v=4","created_at":"0001-01-01T00:00:00Z","followers":0,"following":0,"html_url":"https://github.com/Meorge","id":9957987,"node_id":"MDQ6VXNlcjk5NTc5ODc=","login":"Meorge","type":"User","owned_private_repos":0,"public_gists":0,"public_repos":0,"total_private_repos":0,"url":"https://api.github.com/users/Meorge"},"body":"","html_url":"https://github.com/godotengine/godot/pull/114168#pullrequestreview-4312091781","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/114168","author_association":"CONTRIBUTOR","submitted_at":"2026-05-18T16:52:58Z"},{"id":4312224316,"node_id":"PRR_kwDOAO6SJc8AAAABAQdSPA","state":"COMMENTED","commit_id":"f6edc05ed534ba7c9505a5a30acca05edff1c591","user":{"site_admin":false,"suspended":false,"updated_at":"0001-01-01T00:00:00Z","avatar_url":"https://avatars.githubusercontent.com/u/9957987?u=64fc5e539030609be0447a74243d9fc643fa9bf3&v=4","created_at":"0001-01-01T00:00:00Z","followers":0,"following":0,"html_url":"https://github.com/Meorge","id":9957987,"node_id":"MDQ6VXNlcjk5NTc5ODc=","login":"Meorge","type":"User","owned_private_repos":0,"public_gists":0,"public_repos":0,"total_private_repos":0,"url":"https://api.github.com/users/Meorge"},"body":"","html_url":"https://github.com/godotengine/godot/pull/114168#pullrequestreview-4312224316","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/114168","author_association":"CONTRIBUTOR","submitted_at":"2026-05-18T17:15:46Z"},{"id":4460956436,"node_id":"PRR_kwDOAO6SJc8AAAABCeTLFA","state":"COMMENTED","commit_id":"34cfa9e463c44c563b31fdd4cc1b13d4ae323015","user":{"site_admin":false,"suspended":false,"updated_at":"0001-01-01T00:00:00Z","avatar_url":"https://avatars.githubusercontent.com/u/10054226?u=f0c85fe8c24debe91dc14d7efa97b51a19250b47&v=4","created_at":"0001-01-01T00:00:00Z","followers":0,"following":0,"html_url":"https://github.com/kitbdev","id":10054226,"node_id":"MDQ6VXNlcjEwMDU0MjI2","login":"kitbdev","type":"User","owned_private_repos":0,"public_gists":0,"public_repos":0,"total_private_repos":0,"url":"https://api.github.com/users/kitbdev"},"body":"> So, I think this would need to be addressed with a separate PR that changes the UNTYPED_DECLARATION warning to only show for the declaration line. https://github.com/godotengine/godot/pull/114168/#issuecomment-4196115803\r\n\r\nSimilar to `UNTYPED_DECLARATION`, warnings that apply to the entire class highlight the entire class over LSP, such as `redundant_static_unload` and `missing_tool`. These should also probably be limited to just the class declaration line since highlighting the entire file isn't helpful. Also for a future PR.\r\nThe script editor has a custom limit to make sure the warnings aren't too long which is why it only shows on the LSP side (`ScriptTextEditor::_update_background_color`).\r\n\r\n---\r\nTested for lots of warnings in editor and over LSP, it mostly works well.\r\n\r\nClass-level warnings caused code actions to not work at all over LSP, (like `missing_tool` and `redundant_static_unload`) it just says no code actions available. If those warnings are not present, then it works fine for other warnings.\r\n\r\n","html_url":"https://github.com/godotengine/godot/pull/114168#pullrequestreview-4460956436","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/114168","author_association":"CONTRIBUTOR","submitted_at":"2026-06-09T20:27:31Z"},{"id":4463201052,"node_id":"PRR_kwDOAO6SJc8AAAABCgcLHA","state":"COMMENTED","commit_id":"34cfa9e463c44c563b31fdd4cc1b13d4ae323015","user":{"site_admin":false,"suspended":fa