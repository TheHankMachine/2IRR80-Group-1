..\n \tglow.rgb = clamp(glow.rgb, vec3(0.0f), vec3(1.0f));\n \tcolor.rgb = max((color.rgb + glow.rgb) - (color.rgb * glow.rgb), vec3(0.0));","path":"drivers/gles3/shaders/effects/post.glsl","commit_id":"ff5707b9cb92a90122c6cd1d214214fcf5d618c3","original_commit_id":"d630297b72408ba0d7295f66db6b5c220ea871a4","user":{"login":"Lielay9","id":40064911,"node_id":"MDQ6VXNlcjQwMDY0OTEx","avatar_url":"https://avatars.githubusercontent.com/u/40064911?v=4","gravatar_id":"","url":"https://api.github.com/users/Lielay9","html_url":"https://github.com/Lielay9","followers_url":"https://api.github.com/users/Lielay9/followers","following_url":"https://api.github.com/users/Lielay9/following{/other_user}","gists_url":"https://api.github.com/users/Lielay9/gists{/gist_id}","starred_url":"https://api.github.com/users/Lielay9/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Lielay9/subscriptions","organizations_url":"https://api.github.com/users/Lielay9/orgs","repos_url":"https://api.github.com/users/Lielay9/repos","events_url":"https://api.github.com/users/Lielay9/events{/privacy}","received_events_url":"https://api.github.com/users/Lielay9/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"Screen-glow doesn't really work in any other range than 0 to 1. Screen is a linear function with pivot at (1,1). If there were colors above 1 then you'd have nonsensical results with brighter colors at less glow. Technically negative values would work, though I highly doubt the value can be negative as neither softlight or additive have checks for negative color. (+ If color could be negative you would probably want to use the negative range and omit max).","created_at":"2025-09-04T17:10:18Z","updated_at":"2025-09-04T17:10:18Z","html_url":"https://github.com/godotengine/godot/pull/110239#discussion_r2322849885","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/110239","_links":{"self":{"href":"https://api.github.com/repos