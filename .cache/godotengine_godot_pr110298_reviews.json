[{"id":3232310683,"node_id":"PRR_kwDOAO6SJc7AqSWb","user":{"login":"TokageItLab","id":61938263,"node_id":"MDQ6VXNlcjYxOTM4MjYz","avatar_url":"https://avatars.githubusercontent.com/u/61938263?u=9b90963f1b4f17720e50bbbe495fbe8c84c8bc8e&v=4","gravatar_id":"","url":"https://api.github.com/users/TokageItLab","html_url":"https://github.com/TokageItLab","followers_url":"https://api.github.com/users/TokageItLab/followers","following_url":"https://api.github.com/users/TokageItLab/following{/other_user}","gists_url":"https://api.github.com/users/TokageItLab/gists{/gist_id}","starred_url":"https://api.github.com/users/TokageItLab/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/TokageItLab/subscriptions","organizations_url":"https://api.github.com/users/TokageItLab/orgs","repos_url":"https://api.github.com/users/TokageItLab/repos","events_url":"https://api.github.com/users/TokageItLab/events{/privacy}","received_events_url":"https://api.github.com/users/TokageItLab/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"For now, since this is an experimental feature, I approve it.\r\n\r\nHowever, scaling is still not recommended.\r\n\r\nIn my opinion, cases like normalized + flipped (like `-1, 1`) might be computable without significant overhead. However, I believe we cannot support non-uniform scaling (like `1, 0.5`) or unnormalized scaling (like `2, 2`).\r\n\r\nThis is because they modify bone lengths and global orientation. Bone lengths are typically cached under the assumption they are not modified during IK calculations, so if we support them would impact performance and make code complicated.","state":"APPROVED","html_url":"https://github.com/godotengine/godot/pull/110298#pullrequestreview-3232310683","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/110298","author_association":"MEMBER","_links":{"html":{"href":"https://github.com/godotengine/godot/pull/110298#pullrequestreview-3232310683"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/110298"}},"submitted_at":"2025-09-17T02:24:20Z","commit_id":"bc0eba52960a5c6e4ce192a158da2caf4900e5b4"}]