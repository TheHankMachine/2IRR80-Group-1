ction project (MRP)\n\n![image](https://github.com/user-attachments/assets/1f7d4735-52b0-4e2e-9d71-05df6ea61a80)\r\n","closed_by":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/98593/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/godotengine/godot/issues/98593/timeline","performed_via_github_app":null,"state_reason":null,"pinned_comment":null}