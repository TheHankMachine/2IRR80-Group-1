[{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2685889658","html_url":"https://github.com/godotengine/godot/pull/103329#issuecomment-2685889658","issue_url":"https://api.github.com/repos/godotengine/godot/issues/103329","id":2685889658,"node_id":"IC_kwDOAO6SJc6gF2x6","user":{"login":"arthurlw","id":126365160,"node_id":"U_kgDOB4gt6A","avatar_url":"https://avatars.githubusercontent.com/u/126365160?v=4","gravatar_id":"","url":"https://api.github.com/users/arthurlw","html_url":"https://github.com/arthurlw","followers_url":"https://api.github.com/users/arthurlw/followers","following_url":"https://api.github.com/users/arthurlw/following{/other_user}","gists_url":"https://api.github.com/users/arthurlw/gists{/gist_id}","starred_url":"https://api.github.com/users/arthurlw/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/arthurlw/subscriptions","organizations_url":"https://api.github.com/users/arthurlw/orgs","repos_url":"https://api.github.com/users/arthurlw/repos","events_url":"https://api.github.com/users/arthurlw/events{/privacy}","received_events_url":"https://api.github.com/users/arthurlw/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-02-26T18:39:44Z","updated_at":"2025-02-26T18:39:44Z","body":"Thanks for the clarification! Returning a `Variant` holding `NIL` makes sense, but wouldn't that mean we won't catch the out of bounds error?","author_association":"NONE","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2685889658/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2685898093","html_url":"https://github.com/godotengine/godot/pull/103329#issuecomment-2685898093","issue_url":"https://api.github.com/repos/godotengine/godot/issues/103329","id":2685898093,"node_id":"IC_kwDOAO6SJc6gF41t","user":{"login":"Ivorforce","id":2308167,"node_id":"MDQ6VXNlcjIzMDgxNjc=","avatar_url":"https://avatars.githubusercontent.com/u/2308167?v=4","gravatar_id":"","url":"https://api.github.com/users/Ivorforce","html_url":"https://github.com/Ivorforce","followers_url":"https://api.github.com/users/Ivorforce/followers","following_url":"https://api.github.com/users/Ivorforce/following{/other_user}","gists_url":"https://api.github.com/users/Ivorforce/gists{/gist_id}","starred_url":"https://api.github.com/users/Ivorforce/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Ivorforce/subscriptions","organizations_url":"https://api.github.com/users/Ivorforce/orgs","repos_url":"https://api.github.com/users/Ivorforce/repos","events_url":"https://api.github.com/users/Ivorforce/events{/privacy}","received_events_url":"https://api.github.com/users/Ivorforce/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-02-26T18:43:43Z","updated_at":"2025-02-26T18:44:50Z","body":"> Returning a Variant holding NIL makes sense, but wouldn't that mean we won't catch the out of bounds error?\r\n\r\nGood question!\r\n`ERR_FAIL_INDEX_V_MSG` would still log an error and show it in the Godot console. Note that Godot doesn't use c++ exceptions, so it's impossible to exit a function early without returning a legal value. `ERR_FAIL_INDEX_MSG` does just the same: It logs an error, and then just returns void!","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2685898093/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2685928689","html_url":"https://github.com/godotengine/godot/pull/103329#issuecomment-2685928689","issue_url":"https://api.github.com/repos/godotengine/godot/issues/103329","id":2685928689,"node_id":"IC_kwDOAO6SJc6gGATx","user":{"login":"arthurlw","id":126365160,"node_id":"U_kgDOB4gt6A","avatar_url":"https://avatars.githubusercontent.com/u/126365160?v=4","gravatar_id":"","url":"https://api.github.com/users/arthurlw","html_url":"https://github.com/arthurlw","followers_url":"https://api.github.com/users/arthurlw/followers","following_url":"https://api.github.com/users/arthurlw/following{/other_user}","gists_url":"https://api.github.com/users/arthurlw/gists{/gist_id}","starred_url":"https://api.github.com/users/arthurlw/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/arthurlw/subscriptions","organizations_url":"https://api.github.com/users/arthurlw/orgs","repos_url":"https://api.github.com/users/arthurlw/repos","events_url":"https://api.github.com/users/arthurlw/events{/privacy}","received_events_url":"https://api.github.com/users/arthurlw/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-02-26T18:57:22Z","updated_at":"2025-02-26T18:57:22Z","body":"I see. Would changing the return type to a `Variant` cause issues in other parts of the file that should be noted?","author_association":"NONE","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2685928689/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2685940856","html_url":"https://github.com/godotengine/godot/pull/103329#issuecomment-2685940856","issue_url":"https://api.github.com/repos/godotengine/godot/issues/103329","id":2685940856,"node_id":"IC_kwDOAO6SJc6gGDR4","user":{"login":"Ivorforce","id":2308167,"node_id":"MDQ6VXNlcjIzMDgxNjc=","avatar_url":"https://avatars.githubusercontent.com/u/2308167?v=4","gravatar_id":"","url":"https://api.github.com/users/Ivorforce","html_url":"https://github.com/Ivorforce","followers_url":"https://api.github.com/users/Ivorforce/followers","following_url":"https://api.github.com/users/Ivorforce/following{/other_user}","gists_url":"https://api.github.com/users/Ivorforce/gists{/gist_id}","starred_url":"https://api.github.com/users/Ivorforce/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Ivorforce/subscriptions","organizations_url":"https://api.github.com/users/Ivorforce/orgs","repos_url":"https://api.github.com/users/Ivorforce/repos","events_url":"https://api.github.com/users/Ivorforce/events{/privacy}","received_events_url":"https://api.github.com/users/Ivorforce/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-02-26T19:02:17Z","updated_at":"2025-02-26T19:02:47Z","body":"I don't know. It might cause compile issues, and definitely will cause some performance regressions, but I'd have to try it out to know for sure.","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2685940856/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2686037391","html_url":"https://github.com/godotengine/godot/pull/103329#issuecomment-2686037391","issue_url":"https://api.github.com/repos/godotengine/godot/issues/103329","id":2686037391,"node_id":"IC_kwDOAO6SJc6gGa2P","user":{"login":"arthurlw","id":126365160,"node_id":"U_kgDOB4gt6A","avatar_url":"https://avatars.githubusercontent.com/u/126365160?v=4","gravatar_id":"","url":"https://api.github.com/users/arthurlw","html_url":"https://github.com/arthurlw","followers_url":"https://api.github.com/users/arthurlw/followers","following_url":"https://api.github.com/users/arthurlw/following{/other_user}","gists_url":"https://api.github.com/users/arthurlw/gists{/gist_id}","starred_url":"https://api.github.com/users/arthurlw/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/arthurlw/subscriptions","organizations_url":"https://api.github.com/users/arthurlw/orgs","repos_url":"https://api.github.com/users/arthurlw/repos","events_url":"https://api.github.com/users/arthurlw/events{/privacy}","received_events_url":"https://api.github.com/users/arthurlw/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-02-26T19:47:56Z","updated_at":"2025-02-26T19:47:56Z","body":"Alright, I will update the pull request and change the return type to `Variant` then.","author_association":"NONE","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2686037391/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2686620116","html_url":"https://github.com/godotengine/godot/pull/103329#issuecomment-2686620116","issue_url":"https://api.github.com/repos/godotengine/godot/issues/103329","id":2686620116,"node_id":"IC_kwDOAO6SJc6gIpHU","user":{"login":"arthurlw","id":126365160,"node_id":"U_kgDOB4gt6A","avatar_url":"https://avatars.githubusercontent.com/u/126365160?v=4","gravatar_id":"","url":"https://api.github.com/users/arthurlw","html_url":"https://github.com/arthurlw","followers_url":"https://api.github.com/users/arthurlw/followers","following_url":"https://api.github.com/users/arthurlw/following{/other_user}","gists_url":"https://api.github.com/users/arthurlw/gists{/gist_id}","starred_url":"https://api.github.com/users/arthurlw/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/arthurlw/subscriptions","organizations_url":"https://api.github.com/users/arthurlw/orgs","repos_url":"https://api.github.com/users/arthurlw/repos","events_url":"https://api.github.com/users/arthurlw/events{/privacy}","received_events_url":"https://api.github.com/users/arthurlw/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-02-27T02:05:03Z","updated_at":"2025-02-27T02:06:29Z","body":"I was testing the code, and compiling it causes errors in other parts of the codebase, mostly because they expect a reference type instead of a value. For example:\r\n\r\n- [Line 595 in `/core/variant/array.cpp`:](https://github.com/godotengine/godot/blob/master/core/variant/array.cpp?plain=1#L595)\r\n`argptrs[0] = &get(i);`\r\n\r\nI'm not entirely sure on how to proceed given that I don't have much experience with the codebase.","author_association":"NONE","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2686620116/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2687705548","html_url":"https://github.com/godotengine/godot/pull/103329#issuecomment-2687705548","issue_url":"https://api.github.com/repos/godotengine/godot/issues/103329","id":2687705548,"node_id":"IC_kwDOAO6SJc6gMyHM","user":{"login":"Ivorforce","id":2308167,"node_id":"MDQ6VXNlcjIzMDgxNjc=","avatar_url":"https://avatars.githubusercontent.com/u/2308167?v=4","gravatar_id":"","url":"https://api.github.com/users/Ivorforce","html_url":"https://github.com/Ivorforce","followers_url":"https://api.github.com/users/Ivorforce/followers","following_url":"https://api.github.com/users/Ivorforce/following{/other_user}","gists_url":"https://api.github.com/users/Ivorforce/gists{/gist_id}","starred_url":"https://api.github.com/users/Ivorforce/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Ivorforce/subscriptions","organizations_url":"https://api.github.com/users/Ivorforce/orgs","repos_url":"https://api.github.com/users/Ivorforce/repos","events_url":"https://api.github.com/users/Ivorforce/events{/privacy}","received_events_url":"https://api.github.com/users/Ivorforce/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-02-27T11:41:28Z","updated_at":"2025-02-27T11:45:06Z","body":"> I would suggest using CRASH_BAD_INDEX(p_index, size()); like CowData do.\r\n\r\n`Array` already calls `CRASH_BAD_INDEX` from CowData on bad index, because it uses `CowData` internally. Adding it again here wouldn't help, especially to solve https://github.com/godotengine/godot/issues/103328.\r\n\r\n> > [] operators are fully expected to crash if index is wrong, you can't add checks like this since operators should return reference to a persistent value (not Variant() which is a local variable on stack).\r\n\r\nThis may be true in normal circumstances, but the current design can already lead to hard to debug issues (https://github.com/godotengine/godot/issues/93702). Personally, I think it's time to rethink how `Array` and `Dictionary` interfaces are defined to work better with both GDScript and C++. But this is definitely outside the scope of a small PR to fix, and should be discussed with the core team.\r\n","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2687705548/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2687730472","html_url":"https://github.com/godotengine/godot/pull/103329#issuecomment-2687730472","issue_url":"https://api.github.com/repos/godotengine/godot/issues/103329","id":2687730472,"node_id":"IC_kwDOAO6SJc6gM4Mo","user":{"login":"Ivorforce","id":2308167,"node_id":"MDQ6VXNlcjIzMDgxNjc=","avatar_url":"https://avatars.githubusercontent.com/u/2308167?v=4","gravatar_id":"","url":"https://api.github.com/users/Ivorforce","html_url":"https://github.com/Ivorforce","followers_url":"https://api.github.com/users/Ivorforce/followers","following_url":"https://api.github.com/users/Ivorforce/following{/other_user}","gists_url":"https://api.github.com/users/Ivorforce/gists{/gist_id}","starred_url":"https://api.github.com/users/Ivorforce/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Ivorforce/subscriptions","organizations_url":"https://api.github.com/users/Ivorforce/orgs","repos_url":"https://api.github.com/users/Ivorforce/repos","events_url":"https://api.github.com/users/Ivorforce/events{/privacy}","received_events_url":"https://api.github.com/users/Ivorforce/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-02-27T11:52:49Z","updated_at":"2025-02-27T11:52:49Z","body":"I've only just realized the functions have only been bound to 4.4. They were bound differently than `[]` subscript is bound, leading to a discrepancy of error handling behavior.\r\n\r\nI no longer think this is the right spot to fix the problem. I've added a comment to https://github.com/godotengine/godot/issues/103328 with my thoughts.","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2687730472/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2687735892","html_url":"https://github.com/godotengine/godot/pull/103329#issuecomment-2687735892","issue_url":"https://api.github.com/repos/godotengine/godot/issues/103329","id":2687735892,"node_id":"IC_kwDOAO6SJc6gM5hU","user":{"login":"bruvzg","id":7645683,"node_id":"MDQ6VXNlcjc2NDU2ODM=","avatar_url":"https://avatars.githubusercontent.com/u/7645683?v=4","gravatar_id":"","url":"https://api.github.com/users/bruvzg","html_url":"https://github.com/bruvzg","followers_url":"https://api.github.com/users/bruvzg/followers","following_url":"https://api.github.com/users/bruvzg/following{/other_user}","gists_url":"https://api.github.com/users/bruvzg/gists{/gist_id}","starred_url":"https://api.github.com/users/bruvzg/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/bruvzg/subscriptions","organizations_url":"https://api.github.com/users/bruvzg/orgs","repos_url":"https://api.github.com/users/bruvzg/repos","events_url":"https://api.github.com/users/bruvzg/events{/privacy}","received_events_url":"https://api.github.com/users/bruvzg/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-02-27T11:55:27Z","updated_at":"2025-02-27T11:55:27Z","body":"> Anyway, I completely missed that https://github.com/godotengine/godot/issues/103328 only occurs on .get, not normal array access. This is because get is bound directly while the [] subscript is bound through variant_setget.cpp, where bounds checks are performed. I think a better short-term fix for this issue would be to bind .get through variant_setget.cpp also.\r\n\r\nFor scripting access, probably yes. Adding a wrapper with bounds check is probably fine (for both `Array` and `Packed*Array`s which already have `VARCALL_PACKED_GETTER` wrapper, but w/o bounds check).\r\n\r\nFor C++ caller is responsible for checking bounds, and I do not think any checks needed.","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2687735892/reactions","total_count":2,"+1":2,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2687739595","html_url":"https://github.com/godotengine/godot/pull/103329#issuecomment-2687739595","issue_url":"https://api.github.com/repos/godotengine/godot/issues/103329","id":2687739595,"node_id":"IC_kwDOAO6SJc6gM6bL","user":{"login":"bruvzg","id":7645683,"node_id":"MDQ6VXNlcjc2NDU2ODM=","avatar_url":"https://avatars.githubusercontent.com/u/7645683?v=4","gravatar_id":"","url":"https://api.github.com/users/bruvzg","html_url":"https://github.com/bruvzg","followers_url":"https://api.github.com/users/bruvzg/followers","following_url":"https://api.github.com/users/bruvzg/following{/other_user}","gists_url":"https://api.github.com/users/bruvzg/gists{/gist_id}","starred_url":"https://api.github.com/users/bruvzg/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/bruvzg/subscriptions","organizations_url":"https://api.github.com/users/bruvzg/orgs","repos_url":"https://api.github.com/users/bruvzg/repos","events_url":"https://api.github.com/users/bruvzg/events{/privacy}","received_events_url":"https://api.github.com/users/bruvzg/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-02-27T11:57:20Z","updated_at":"2025-02-27T15:45:29Z","body":"Something like\r\n```diff\r\ndiff --git a/core/variant/variant_call.cpp b/core/variant/variant_call.cpp\r\nindex 7521632974..badcf7499f 100644\r\n--- a/core/variant/variant_call.cpp\r\n+++ b/core/variant/variant_call.cpp\r\n@@ -659,6 +659,7 @@ static _FORCE_INLINE_ void vc_ptrcall(void (*method)(T *, P...), void *p_base, c\r\n \r\n #define VARCALL_PACKED_GETTER(m_packed_type, m_return_type)                                       \\\r\n \tstatic m_return_type func_##m_packed_type##_get(m_packed_type *p_instance, int64_t p_index) { \\\r\n+\t\tERR_FAIL_INDEX_V(p_index, p_instance->size(), m_return_type());                           \\\r\n \t\treturn p_instance->get(p_index);                                                          \\\r\n \t}\r\n \r\n@@ -674,6 +675,11 @@ struct _VariantCall {\r\n \tVARCALL_PACKED_GETTER(PackedVector3Array, Vector3)\r\n \tVARCALL_PACKED_GETTER(PackedVector4Array, Vector4)\r\n \r\n+\tstatic Variant func_Array_get(Array *p_instance, int64_t p_index) {\r\n+\t\tERR_FAIL_INDEX_V(p_index, p_instance->size(), Variant());\r\n+\t\treturn p_instance->get(p_index);\r\n+\t}\r\n+\r\n \tstatic String func_PackedByteArray_get_string_from_ascii(PackedByteArray *p_instance) {\r\n \t\tString s;\r\n \t\tif (p_instance->size() > 0) {\r\n@@ -2354,7 +2360,7 @@ static void _register_variant_builtin_methods_array() {\r\n \tbind_method(Array, clear, sarray(), varray());\r\n \tbind_method(Array, hash, sarray(), varray());\r\n \tbind_method(Array, assign, sarray(\"array\"), varray());\r\n-\tbind_method(Array, get, sarray(\"index\"), varray());\r\n+\tbind_function(Array, get, _VariantCall::func_Array_get, sarray(\"index\"), varray());\r\n \tbind_method(Array, set, sarray(\"index\", \"value\"), varray());\r\n \tbind_method(Array, push_back, sarray(\"value\"), varray());\r\n \tbind_method(Array, push_front, sarray(\"value\"), varray());\r\n```\r\n\r\nOpened https://github.com/godotengine/godot/pull/103362","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2687739595/reactions","total_count":2,"+1":2,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2688600773","html_url":"https://github.com/godotengine/godot/pull/103329#issuecomment-2688600773","issue_url":"https://api.github.com/repos/godotengine/godot/issues/103329","id":2688600773,"node_id":"IC_kwDOAO6SJc6gQMrF","user":{"login":"akien-mga","id":4701338,"node_id":"MDQ6VXNlcjQ3MDEzMzg=","avatar_url":"https://avatars.githubusercontent.com/u/4701338?v=4","gravatar_id":"","url":"https://api.github.com/users/akien-mga","html_url":"https://github.com/akien-mga","followers_url":"https://api.github.com/users/akien-mga/followers","following_url":"https://api.github.com/users/akien-mga/following{/other_user}","gists_url":"https://api.github.com/users/akien-mga/gists{/gist_id}","starred_url":"https://api.github.com/users/akien-mga/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/akien-mga/subscriptions","organizations_url":"https://api.github.com/users/akien-mga/orgs","repos_url":"https://api.github.com/users/akien-mga/repos","events_url":"https://api.github.com/users/akien-mga/events{/privacy}","received_events_url":"https://api.github.com/users/akien-mga/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-02-27T17:13:27Z","updated_at":"2025-02-27T17:13:27Z","body":"Superseded by #103362. Thanks for the contribution!","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2688600773/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null}]