ithub.com/users/syntaxerror247/repos","events_url":"https://api.github.com/users/syntaxerror247/events{/privacy}","received_events_url":"https://api.github.com/users/syntaxerror247/received_events","type":"User","user_view_type":"public","site_admin":false},"author_association":"NONE","issue_field_values":[],"type":null,"active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"### Tested versions\n\n- Reproducible in 4.5.beta2\n- Not reproducible in 4.4.1.stable\n\n### System information\n\nGodot v4.5.beta2 - Windows 11 (build 26100) - Multi-window, 1 monitor - OpenGL 3 (Compatibility) - Intel(R) UHD Graphics (Intel Corporation; 31.0.101.2127) - Intel(R) Core(TM) i7-10510U CPU @ 1.80GHz (8 threads) - 15.78 GiB memory\n\n### Issue description\n\nWhen exporting a build for Android, it's no longer possible to override the colour of the launching splash screen.\nPreviously, it was possible to set colour inside android/build/res/values/themes.xml like this\n```\n<style name=\"GodotAppSplashTheme\" parent=\"Theme.SplashScreen\">\n\t<item name=\"android:windowSplashScreenBackground\">#031926</item>\n</style>\n```\nIn 4.5.beta2 this file is auto-generated, which is actually great, but the issue is, `windowSplashScreenBackground` is a reserved attribute, and even when I specify it in custom theme attributes during project export, it is ignored, based on this logic:\nhttps://github.com/godotengine/godot/blob/4d1f26e1fd1fa46f2223fe0b6ac300744bf79b88/platform/android/export/export_plugin.cpp#L1089\n\nI understand that beta version is not stable, but I need to use it because it's the only one that supports Android API 35, without which my app will be deleted from the store by the end of August, and this new splash background behaviour seems like a bug. Is there a different way to override the splash screen colour that I am missing?\n\n### Steps to reproduce\n\n- Create a new project in Godot 4.5.beta2\n- Install Android build template for 4.5.beta2\n- set a custom theme attribute with key \"[splash]android:windowSplashScreenBackground\" and value \"#031926\" (any colour)\n<img width=\"1895\" height=\"852\" alt=\"Image\" src=\"https://github.com/user-attachments/assets/3575518f-c373-4547-b21e-bf93370e3548\" />\n\n- export project\n- value in themes.xml is unchanged, and when the app launches, the splash screen background is white instead of the provided colour\n\n\n### Minimal reproduction project (MRP)\n\nN/A","closed_by":{"login":"Repiteo","id":17489292,"node_id":"MDQ6VXNlcjE3NDg5Mjky","avatar_url":"https://avatars.githubusercontent.com/u/17489292?v=4","gravatar_id":"","url":"https://api.github.com/users/Repiteo","html_url":"https://github.com/Repiteo","followers_url":"https://api.github.com/users/Repiteo/followers","following_url":"https://api.github.com/users/Repiteo/following{/other_user}","gists_url":"https://api.github.com/users/Repiteo/gists{/gist_id}","starred_url":"https://api.github.com/users/Repiteo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Repiteo/subscriptions","organizations_url":"https://api.github.com/users/Repiteo/orgs","repos_url":"https://api.github.com/users/Repiteo/repos","events_url":"https://api.github.com/users/Repiteo/events{/privacy}","received_events_url":"https://api.github.com/users/Repiteo/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/108438/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/godotengine/godot/issues/108438/timeline","performed_via_github_app":null,"state_reason":"completed","pinned_comment":null}