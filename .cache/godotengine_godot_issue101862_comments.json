pi.github.com/users/Calinou/followers","following_url":"https://api.github.com/users/Calinou/following{/other_user}","gists_url":"https://api.github.com/users/Calinou/gists{/gist_id}","starred_url":"https://api.github.com/users/Calinou/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Calinou/subscriptions","organizations_url":"https://api.github.com/users/Calinou/orgs","repos_url":"https://api.github.com/users/Calinou/repos","events_url":"https://api.github.com/users/Calinou/events{/privacy}","received_events_url":"https://api.github.com/users/Calinou/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-01-21T20:45:06Z","updated_at":"2025-01-21T20:45:42Z","body":"RigidBody3D does not support convave (trimesh) collision shapes. Only StaticBody3DD supports concave collision shapes.\n\nTo achieve concave collision with a RigidBody3D, use convex decomposition instead (which recreates the concave shape using multiple convex shapes).","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2605701900/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2605829457","html_url":"https://github.com/godotengine/godot/issues/101862#issuecomment-2605829457","issue_url":"https://api.github.com/repos/godotengine/godot/issues/101862","id":2605829457,"node_id":"IC_kwDOAO6SJc6bUc1R","user":{"login":"tritonian","id":53919963,"node_id":"MDQ6VXNlcjUzOTE5OTYz","avatar_url":"https://avatars.githubusercontent.com/u/53919963?v=4","gravatar_id":"","url":"https://api.github.com/users/tritonian","html_url":"https://github.com/tritonian","followers_url":"https://api.github.com/users/tritonian/followers","following_url":"https://api.github.com/users/tritonian/following{/other_user}","gists_url":"https://api.github.com/users/tritonian/gists{/gist_id}","starred_url":"https://api.github.com/users/tritonian/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/tritonian/subscriptions","organizations_url":"https://api.github.com/users/tritonian/orgs","repos_url":"https://api.github.com/users/tritonian/repos","events_url":"https://api.github.com/users/tritonian/events{/privacy}","received_events_url":"https://api.github.com/users/tritonian/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-01-21T22:01:53Z","updated_at":"2025-01-21T22:03:16Z","body":"I would argue that it's not strictly true that Rigidbody3D does not support trimesh collision shapes. A trimesh rigidbody will collide with a convex rigidbody in my testing. It feels more accurate to say that trimesh-trimesh collisions aren't supported, irrespective of being a static or rigid body, as well as the warning about trimesh rigidbodies not behaving well.\n\nI might just be being pedantic at this point. It doesn't seem like a bug with the engine, I was just confused with the docs and I think I inferred too much from the note.\n\nI have also been trying to use convex mesh decomposition and haven't had success with it. That would be a different issue though.","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2605829457/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null}]