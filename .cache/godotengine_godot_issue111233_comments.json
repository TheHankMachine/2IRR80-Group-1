.github.com/users/ThePuzzlemaker/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/ThePuzzlemaker/subscriptions","organizations_url":"https://api.github.com/users/ThePuzzlemaker/orgs","repos_url":"https://api.github.com/users/ThePuzzlemaker/repos","events_url":"https://api.github.com/users/ThePuzzlemaker/events{/privacy}","received_events_url":"https://api.github.com/users/ThePuzzlemaker/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-10-04T20:21:18Z","updated_at":"2025-10-04T20:21:18Z","body":"I need to make one more change that I overlooked, relating to the hat events. I will do this sometime soon.","author_association":"NONE","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3368517888/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3368622048","html_url":"https://github.com/godotengine/godot/pull/111233#issuecomment-3368622048","issue_url":"https://api.github.com/repos/godotengine/godot/issues/111233","id":3368622048,"node_id":"IC_kwDOAO6SJc7IyRfg","user":{"login":"ThePuzzlemaker","id":12666617,"node_id":"MDQ6VXNlcjEyNjY2NjE3","avatar_url":"https://avatars.githubusercontent.com/u/12666617?v=4","gravatar_id":"","url":"https://api.github.com/users/ThePuzzlemaker","html_url":"https://github.com/ThePuzzlemaker","followers_url":"https://api.github.com/users/ThePuzzlemaker/followers","following_url":"https://api.github.com/users/ThePuzzlemaker/following{/other_user}","gists_url":"https://api.github.com/users/ThePuzzlemaker/gists{/gist_id}","starred_url":"https://api.github.com/users/ThePuzzlemaker/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/ThePuzzlemaker/subscriptions","organizations_url":"https://api.github.com/users/ThePuzzlemaker/orgs","repos_url":"https://api.github.com/users/ThePuzzlemaker/repos","events_url":"https://api.github.com/users/ThePuzzlemaker/events{/privacy}","received_events_url":"https://api.github.com/users/ThePuzzlemaker/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-10-05T00:14:23Z","updated_at":"2025-10-05T00:23:21Z","body":"[Crossposting from the Godot chat site](https://chat.godotengine.org/channel/input?msg=Dpa2oFT9WqzefnfkY)\r\n\r\nI'm not quite sure how hats should be handled in \"raw input\" mode. Currently, they are mapped to the D-Pad if no mapping already exists, but at least with my joystick (Thrustmaster T.16000M) doing this for raw mode conflicts with existing button indices. Additionally, some joysticks (such as the VKB Gladiator NXT EVO, which I am upgrading to soon) have multiple hats and so those may not work at all.\r\n\r\nIn SDL, they are an entity completely separate from axes and buttons, but I'm not sure introducing this distinction into Godot is useful, or even relevant at this point (though it would not necessarily be a breaking change, so it may be worthwhile). I'm not sure whether to map them in raw mode to axes or to buttons, or both?\r\n\r\nWhat are everyone's thoughts on this? I've marked the PR as a draft until this blocker is resolved.","author_association":"NONE","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3368622048/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3368697652","html_url":"https://github.com/godotengine/godot/pull/111233#issuecomment-3368697652","issue_url":"https://api.github.com/repos/godotengine/godot/issues/111233","id":3368697652,"node_id":"IC_kwDOAO6SJc7Iyj80","user":{"login":"ThePuzzlemaker","id":12666617,"node_id":"MDQ6VXNlcjEyNjY2NjE3","avatar_url":"https://avatars.githubusercontent.com/u/12666617?v=4","gravatar_id":"","url":"https://api.github.com/users/ThePuzzlemaker","html_url":"https://github.com/ThePuzzlemaker","followers_url":"https://api.github.com/users/ThePuzzlemaker/followers","following_url":"https://api.github.com/users/ThePuzzlemaker/following{/other_user}","gists_url":"https://api.github.com/users/ThePuzzlemaker/gists{/gist_id}","starred_url":"https://api.github.com/users/ThePuzzlemaker/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/ThePuzzlemaker/subscriptions","organizations_url":"https://api.github.com/users/ThePuzzlemaker/orgs","repos_url":"https://api.github.com/users/ThePuzzlemaker/repos","events_url":"https://api.github.com/users/ThePuzzlemaker/events{/privacy}","received_events_url":"https://api.github.com/users/ThePuzzlemaker/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-10-05T02:45:40Z","updated_at":"2025-10-05T02:46:52Z","body":"I've successfully prototyped `Input.get_joy_hat(device, hat)` (which works whether or not raw input is enabled) and a new `InputEventJoypadHat` (which is only emitted in raw input mode) but I'm not sure if this is the best design, and I'm also not sure what to do about editor support for raw input handling -- it may be useful to add some type of way to deal with raw input in the input map editor, but I'm not sure how is the best way to do that (and if it should be in a different PR if this one is merged)\r\n\r\nhttps://github.com/user-attachments/assets/da6fd497-e2a6-458a-8dbe-4a8ec89821fb\r\n\r\n","author_association":"NONE","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3368697652/reactions","total_count":1,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":1},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3368705365","html_url":"https://github.com/godotengine/godot/pull/111233#issue