s.githubusercontent.com/u/2308167?v=4","gravatar_id":"","url":"https://api.github.com/users/Ivorforce","html_url":"https://github.com/Ivorforce","followers_url":"https://api.github.com/users/Ivorforce/followers","following_url":"https://api.github.com/users/Ivorforce/following{/other_user}","gists_url":"https://api.github.com/users/Ivorforce/gists{/gist_id}","starred_url":"https://api.github.com/users/Ivorforce/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Ivorforce/subscriptions","organizations_url":"https://api.github.com/users/Ivorforce/orgs","repos_url":"https://api.github.com/users/Ivorforce/repos","events_url":"https://api.github.com/users/Ivorforce/events{/privacy}","received_events_url":"https://api.github.com/users/Ivorforce/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-07-28T08:28:53Z","updated_at":"2026-07-28T08:28:53Z","body":"I didn't manage to track down where `p_soft_reload` was added. The tools got it in 2016 (which means it was likely not discussed), but the all tools function got it much later. Any idea what the `p_soft = false` path is intended for? Would it be covered by unloading and loading the language instead?","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5101776983/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5101880257","html_url":"https://github.com/godotengine/godot/pull/121567#issuecomment-5101880257","issue_url":"https://api.github.com/repos/godotengine/godot/issues/121567","id":5101880257,"node_id":"IC_kwDOAO6SJc8AAAABMBiDwQ","user":{"login":"HolonProduction","id":99511741,"node_id":"U_kgDOBe5tvQ","avatar_url":"https://avatars.githubusercontent.com/u/99511741?v=4","gravatar_id":"","url":"https://api.github.com/users/HolonProduction","html_url":"https://github.com/HolonProduction","followers_url":"https://api.github.com/users/HolonProduction/followers","following_url":"https://api.github.com/users/HolonProduction/following{/other_user}","gists_url":"https://api.github.com/users/HolonProduction/gists{/gist_id}","starred_url":"https://api.github.com/users/HolonProduction/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/HolonProduction/subscriptions","organizations_url":"https://api.github.com/users/HolonProduction/orgs","repos_url":"https://api.github.com/users/HolonProduction/repos","events_url":"https://api.github.com/users/HolonProduction/events{/privacy}","received_events_url":"https://api.github.com/users/HolonProduction/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-07-28T08:40:11Z","updated_at":"2026-07-28T08:40:27Z","body":"As far as I can tell it was introduced with https://github.com/godotengine/godot/commit/f8f30662d93a46eb4b1ece6d45be28760d5ad58c -> so it was only meant for tool scripts originally, but I'm not able to gather much more about intentions\r\n\r\n`reload_scripts` was only added much later but has it since it was added in https://github.com/godotengine/godot/commit/cde478bda6a7ca5239daf96d0fd3cb6344c064a6\r\n\r\nThe code in this branch has to do with reconstructing all instances of the script. However looking at https://github.com/godotengine/godot/pull/116368 we need to do that selectively anyway to convert `PlaceholderScriptInstance` to real instances when a script becomes a `@tool`. So distinguishing this doesn't really make sense.\r\n\r\nEveryone will be happier if we focus on one reload implementation and get it working reliably.","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5101880257/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github