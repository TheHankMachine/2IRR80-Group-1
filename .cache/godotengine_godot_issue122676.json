n":"","archived_at":null,"archived_by":null},{"id":890310502,"node_id":"MDU6TGFiZWw4OTAzMTA1MDI=","url":"https://api.github.com/repos/godotengine/godot/labels/topic:import","name":"topic:import","color":"ffee88","default":false,"description":"","archived_at":null,"archived_by":null}],"state":"closed","locked":false,"assignees":[],"milestone":{"url":"https://api.github.com/repos/godotengine/godot/milestones/25","html_url":"https://github.com/godotengine/godot/milestone/25","labels_url":"https://api.github.com/repos/godotengine/godot/milestones/25/labels","id":15520464,"node_id":"MI_kwDOAO6SJc4A7NLQ","number":25,"title":"4.8","description":"","creator":{"login":"Repiteo","id":17489292,"node_id":"MDQ6VXNlcjE3NDg5Mjky","avatar_url":"https://avatars.githubusercontent.com/u/17489292?v=4","gravatar_id":"","url":"https://api.github.com/users/Repiteo","html_url":"https://github.com/Repiteo","followers_url":"https://api.github.com/users/Repiteo/followers","following_url":"https://api.github.com/users/Repiteo/following{/other_user}","gists_url":"https://api.github.com/users/Repiteo/gists{/gist_id}","starred_url":"https://api.github.com/users/Repiteo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Repiteo/subscriptions","organizations_url":"https://api.github.com/users/Repiteo/orgs","repos_url":"https://api.github.com/users/Repiteo/repos","events_url":"https://api.github.com/users/Repiteo/events{/privacy}","received_events_url":"https://api.github.com/users/Repiteo/received_events","type":"User","user_view_type":"public","site_admin":false},"open_issues":343,"closed_issues":2335,"state":"open","created_at":"2026-04-13T15:59:35Z","updated_at":"2026-10-22T06:28:22Z","due_on":null,"closed_at":null},"comments":3,"created_at":"2026-08-20T23:13:45Z","updated_at":"2026-10-02T18:03:18Z","closed_at":"2026-08-21T16:25:19Z","assignee":null,"author_association":"MEMBER","issue_field_values":[],"type":null,"active_lock_reason":null,"draft":false,"pull_request":{"url":"https://api.github.com/repos/godotengine/godot/pulls/122676","html_url":"https://github.com/godotengine/godot/pull/122676","diff_url":"https://github.com/godotengine/godot/pull/122676.diff","patch_url":"https://github.com/godotengine/godot/pull/122676.patch","merged_at":"2026-08-21T16:25:19Z"},"body":"## What problem(s) does this PR solve?\r\n\r\nWhen opening a Godot project with GDExtension compilation artifacts in it, Godot has dedicated code in the OBJ importer to skip Windows COFF `.obj` files. This uses a hard-coded list of file header prefixes.\r\n\r\nHowever, Windows Arm64 was missing from this list, so opening this project on Windows for Arm took an hour, as the editor showed these messages for significant fractions of a minute, while the console spammed with errors:\r\n\r\n<img width=\"518\" height=\"137\" alt=\"Screenshot 2026-08-20 at 2 20 10 PM\" src=\"https://github.com/user-attachments/assets/f5164534-bc78-48c1-ac10-70d00cb564e2\" />\r\n\r\nThis PR fixes the problem by adding Arm64(/ec/x) to the list. I also threw in an alternate Arm32 prefix, and RISC-V. The full list provided by Microsoft has many more, but I don't think we ever expect Godot to support most of those.\r\n\r\n## Additional information\r\n\r\nI used AI to search through the code and find the COFF header code. After that, all the code edits were done manually.\r\n\r\nThis PR should be cherry-picked to all supported branches.","closed_by":{"login":"Repiteo","id":17489292,"node_id":"MDQ6VXNlcjE3NDg5Mjky","avatar_url":"https://avatars.githubusercontent.com/u/17489292?v=4","gravatar_id":"","url":"https://api.github.com/users/Repiteo","html_url":"https://github.com/Repiteo","followers_url":"https://api.github.com/users/Repiteo/followers","following_url":"https://api.github.com/users/Repiteo/following{/other_user}","gists_url":"https://api.github.com/users/Repiteo/gists{/gist_id}","starred_url":"https://api.github.com/users/Repiteo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Repiteo/subscriptions","organizations_url":"https://api.github.com/users/Repiteo/orgs","repos_url":"https://api.github.com/users/Repiteo/repos","events_url":"https://api.github.com/users/Repiteo/events{/privacy}","received_events_url":"https://api.github.com/users/Repiteo/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/122676/reactions","total_count":3,"+1":3,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/godotengine/godot/issues/122676/timeline","performed_via_github_app":null,"state_reason":null}