ized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5437617208","html_url":"https://github.com/godotengine/godot/pull/121833#issuecomment-5437617208","issue_url":"https://api.github.com/repos/godotengine/godot/issues/121833","id":5437617208,"node_id":"IC_kwDOAO6SJc8AAAABRBt0OA","user":{"login":"AThousandShips","id":96648715,"node_id":"U_kgDOBcK-Cw","avatar_url":"https://avatars.githubusercontent.com/u/96648715?v=4","gravatar_id":"","url":"https://api.github.com/users/AThousandShips","html_url":"https://github.com/AThousandShips","followers_url":"https://api.github.com/users/AThousandShips/followers","following_url":"https://api.github.com/users/AThousandShips/following{/other_user}","gists_url":"https://api.github.com/users/AThousandShips/gists{/gist_id}","starred_url":"https://api.github.com/users/AThousandShips/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/AThousandShips/subscriptions","organizations_url":"https://api.github.com/users/AThousandShips/orgs","repos_url":"https://api.github.com/users/AThousandShips/repos","events_url":"https://api.github.com/users/AThousandShips/events{/privacy}","received_events_url":"https://api.github.com/users/AThousandShips/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-08-27T10:20:41Z","updated_at":"2026-08-27T10:20:41Z","body":"> Disabling blocks of GDScript without modifying every line.\r\n> Easier than placing # at the start of every line.\r\n\r\nThis feels like a hack (and are really the same thing)","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5437617208/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5437718440","html_url":"https://github.com/godotengine/godot/pull/121833#is