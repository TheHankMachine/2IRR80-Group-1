:58Z"},{"id":4986184870,"node_id":"PRR_kwDOAO6SJc8AAAABKTMkpg","state":"COMMENTED","commit_id":"26643c46eb58d95f3a2f5c02ff2954083c32c3bf","user":{"site_admin":false,"suspended":false,"updated_at":"0001-01-01T00:00:00Z","avatar_url":"https://avatars.githubusercontent.com/u/47152052?u=7f3c243e5d49c4a158e099edfb548e77102dfea1&v=4","created_at":"0001-01-01T00:00:00Z","followers":0,"following":0,"html_url":"https://github.com/aterray","id":47152052,"node_id":"MDQ6VXNlcjQ3MTUyMDUy","login":"aterray","type":"User","owned_private_repos":0,"public_gists":0,"public_repos":0,"total_private_repos":0,"url":"https://api.github.com/users/aterray"},"body":"","html_url":"https://github.com/godotengine/godot/pull/113970#pullrequestreview-4986184870","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/113970","author_association":"CONTRIBUTOR","submitted_at":"2026-08-20T18:38:42Z"},{"id":4990014237,"node_id":"PRR_kwDOAO6SJc8AAAABKW2THQ","state":"COMMENTED","commit_id":"26643c46eb58d95f3a2f5c02ff2954083c32c3bf","user":{"site_admin":false,"suspended":false,"updated_at":"0001-01-01T00:00:00Z","avatar_url":"https://avatars.githubusercontent.com/u/47152052?u=7f3c243e5d49c4a158e099edfb548e77102dfea1&v=4","created_at":"0001-01-01T00:00:00Z","followers":0,"following":0,"html_url":"https://github.com/aterray","id":47152052,"node_id":"MDQ6VXNlcjQ3MTUyMDUy","login":"aterray","type":"User","owned_private_repos":0,"public_gists":0,"public_repos":0,"total_private_repos":0,"url":"https://api.github.com/users/aterray"},"body":"","html_url":"https://github.com/godotengine/godot/pull/113970#pullrequestreview-4990014237","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/113970","author_association":"CONTRIBUTOR","submitted_at":"2026-08-21T05:47:59Z"},{"id":4994013957,"node_id":"PRR_kwDOAO6SJc8AAAABKaqbBQ","state":"COMMENTED","commit_id":"26643c46eb58d95f3a2f5c02ff2954083c32c3bf","user":{"site_admin":false,"suspended":false,"updated_at":"0001-01-01T00:00:00Z","