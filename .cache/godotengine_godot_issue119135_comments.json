tails>\n\n> Godot v4.7.beta (860821708) - macOS Tahoe (26.3.0) - Multi-window, 1 monitor - Metal (Forward+) - integrated Apple M5 Max (Apple9) - Apple M5 Max (18 threads) - 48.00 GiB memory - CoreAudio (48000 Hz, Stereo/mono)","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4511302725/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4519765490","html_url":"https://github.com/godotengine/godot/issues/119135#issuecomment-4519765490","issue_url":"https://api.github.com/repos/godotengine/godot/issues/119135","id":4519765490,"node_id":"IC_kwDOAO6SJc8AAAABDWYl8g","user":{"login":"blueskythlikesclouds","id":19259897,"node_id":"MDQ6VXNlcjE5MjU5ODk3","avatar_url":"https://avatars.githubusercontent.com/u/19259897?v=4","gravatar_id":"","url":"https://api.github.com/users/blueskythlikesclouds","html_url":"https://github.com/blueskythlikesclouds","followers_url":"https://api.github.com/users/blueskythlikesclouds/followers","following_url":"https://api.github.com/users/blueskythlikesclouds/following{/other_user}","gists_url":"https://api.github.com/users/blueskythlikesclouds/gists{/gist_id}","starred_url":"https://api.github.com/users/blueskythlikesclouds/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/blueskythlikesclouds/subscriptions","organizations_url":"https://api.github.com/users/blueskythlikesclouds/orgs","repos_url":"https://api.github.com/users/blueskythlikesclouds/repos","events_url":"https://api.github.com/users/blueskythlikesclouds/events{/privacy}","received_events_url":"https://api.github.com/users/blueskythlikesclouds/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-05-22T14:53:10Z","updated_at":"2026-05-22T14:56:21Z","body":"It's not showing 