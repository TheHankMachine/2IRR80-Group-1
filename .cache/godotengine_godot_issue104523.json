28Z","updated_at":"2026-09-04T21:48:38Z","due_on":"2025-09-15T00:00:00Z","closed_at":"2025-09-18T17:13:14Z"},"comments":5,"created_at":"2025-03-23T18:07:36Z","updated_at":"2025-04-01T05:47:53Z","closed_at":"2025-04-01T00:03:14Z","assignee":null,"author_association":"MEMBER","issue_field_values":[],"type":null,"active_lock_reason":null,"draft":false,"pull_request":{"url":"https://api.github.com/repos/godotengine/godot/pulls/104523","html_url":"https://github.com/godotengine/godot/pull/104523","diff_url":"https://github.com/godotengine/godot/pull/104523.diff","patch_url":"https://github.com/godotengine/godot/pull/104523.patch","merged_at":"2025-04-01T00:03:14Z"},"body":"Closes #104078\r\nCloses #95998 (very very likely)\r\n\r\nThis fixes an `use-after-free` bug that would occur when deleting a breakpoint, because the breakpoint list was being iterated and deleted at the same time. This step is divided into two to prevent this issue. I've tested DAP usage in general under ASAN, and didn't find any other similar problems.\r\n\r\nThis also includes other fixes for bugs that I identified while fixing it, and since I haven't found cases reporting similar behavior, I decided to bundle it all here as well:\r\n\r\n- Adding breakpoints did not check if they existed previously. This resulted in duplicated information that grows exponentially (e.g adding breakpoints on lines 1 2 3, due to the DAP workflow, would result in 3 requests, and end up with breakpoints 1, 1 2, 1 2 3).\r\n- Some cases that used `List` unnecessarily when `Vector` is more efficient and straighforward\r\n- Separate `DAP::Stackframe` info from scope IDs mapping, not only to simplify the code, but to avoid using the map inneficiently (it was used to search for keys and values)\r\n- Update checksums of `DAP::Source` whenever breakpoints are requested, as it's likely the file may have changed in this case\r\n  - Following on that, `DAP::Source`s are also now cached and shared between different objects.","closed_by":{"login":"Repiteo","id":17489292,"node_id":"MDQ6VXNlcjE3NDg5Mjky","avatar_url":"https://avatars.githubusercontent.com/u/17489292?v=4","gravatar_id":"","url":"https://api.github.com/users/Repiteo","html_url":"https://github.com/Repiteo","followers_url":"https://api.github.com/users/Repiteo/followers","following_url":"https://api.github.com/users/Repiteo/following{/other_user}","gists_url":"https://api.github.com/users/Repiteo/gists{/gist_id}","starred_url":"https://api.github.com/users/Repiteo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Repiteo/subscriptions","organizations_url":"https://api.github.com/users/Repiteo/orgs","repos_url":"https://api.github.com/users/Repiteo/repos","events_url":"https://api.github.com/users/Repiteo/events{/privacy}","received_events_url":"https://api.github.com/users/Repiteo/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/104523/reactions","total_count":2,"+1":0,"-1":0,"laugh":0,"hooray":2,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/godotengine/godot/issues/104523/timeline","performed_via_github_app":null,"state_reason":null}