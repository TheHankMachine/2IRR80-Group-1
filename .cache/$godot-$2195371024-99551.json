[{"id":2455938140,"node_id":"PRR_kwDOAO6SJc6SYqRc","state":"COMMENTED","user":{"site_admin":false,"suspended":false,"updated_at":"0001-01-01T00:00:00Z","avatar_url":"https://avatars.githubusercontent.com/u/1945449?u=96b5dc9be2859dca5f31314c87d99a68a21e1576&v=4","created_at":"0001-01-01T00:00:00Z","followers":0,"following":0,"html_url":"https://github.com/BastiaanOlij","id":1945449,"node_id":"MDQ6VXNlcjE5NDU0NDk=","login":"BastiaanOlij","type":"User","owned_private_repos":0,"public_gists":0,"public_repos":0,"total_private_repos":0,"url":"https://api.github.com/users/BastiaanOlij"},"body":"","html_url":"https://github.com/godotengine/godot/pull/99551#pullrequestreview-2455938140","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/99551","author_association":"CONTRIBUTOR","submitted_at":"2024-11-22T23:00:52Z"},{"id":2455950991,"node_id":"PRR_kwDOAO6SJc6SYtaP","state":"CHANGES_REQUESTED","user":{"site_admin":false,"suspended":false,"updated_at":"0001-01-01T00:00:00Z","avatar_url":"https://avatars.githubusercontent.com/u/1945449?u=96b5dc9be2859dca5f31314c87d99a68a21e1576&v=4","created_at":"0001-01-01T00:00:00Z","followers":0,"following":0,"html_url":"https://github.com/BastiaanOlij","id":1945449,"node_id":"MDQ6VXNlcjE5NDU0NDk=","login":"BastiaanOlij","type":"User","owned_private_repos":0,"public_gists":0,"public_repos":0,"total_private_repos":0,"url":"https://api.github.com/users/BastiaanOlij"},"body":"This is looking excellent and I think we're just down to final choices.\r\nMost remarks I have probably hark back to early choices made in my own PR that I don't feel are right anymore.\r\n\r\nMy main concern is that we are exposing too much of the choice between the two approaches to the rendering engine implementation. I think we can internalise a lot inside of the rendering driver, that by simply choosing upfront which extension we're using, the rendering driver can do the right thing so the code in `renderer_rd` doesn't need to be bothered by it.\r\nThat should also future proof us to an eventual Metal and DirectX implementation.","html_url":"https://github.com/godotengine/godot/pull/99551#pullrequestreview-2455950991","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/99551","author_association":"CONTRIBUTOR","submitted_at":"2024-11-22T23:42:02Z"},{"id":2458377080,"node_id":"PRR_kwDOAO6SJc6Sh9t4","state":"COMMENTED","user":{"site_admin":false,"suspended":false,"updated_at":"0001-01-01T00:00:00Z","avatar_url":"https://avatars.githubusercontent.com/u/538504?u=45f09996711edf524a11181d136e38113210b6ce&v=4","created_at":"0001-01-01T00:00:00Z","followers":0,"following":0,"html_url":"https://github.com/DarioSamo","id":538504,"node_id":"MDQ6VXNlcjUzODUwNA==","login":"DarioSamo","type":"User","owned_private_repos":0,"public_gists":0,"public_repos":0,"total_private_repos":0,"url":"https://api.github.com/users/DarioSamo"},"body":"","html_url":"https://github.com/godotengine/godot/pull/99551#pullrequestreview-2458377080","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/99551","author_association":"CONTRIBUTOR","submitted_at":"2024-11-25T13:01:46Z"},{"id":2460359032,"node_id":"PRR_kwDOAO6SJc6Sphl4","state":"COMMENTED","user":{"site_admin":false,"suspended":false,"updated_at":"0001-01-01T00:00:00Z","avatar_url":"https://avatars.githubusercontent.com/u/1945449?u=96b5dc9be2859dca5f31314c87d99a68a21e1576&v=4","created_at":"0001-01-01T00:00:00Z","followers":0,"following":0,"html_url":"https://github.com/BastiaanOlij","id":1945449,"node_id":"MDQ6VXNlcjE5NDU0NDk=","login":"BastiaanOlij","type":"User","owned_private_repos":0,"public_gists":0,"public_repos":0,"total_private_repos":0,"url":"https://api.github.com/users/BastiaanOlij"},"body":"","html_url":"https://github.com/godotengine/godot/pull/99551#pullrequestreview-2460359032","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/99551","author_association":"CONTRIBUTOR","submitted_at":"2024-11-26T05:37:14Z"},{