nOlij","type":"User","owned_private_repos":0,"public_gists":0,"public_repos":0,"total_private_repos":0,"url":"https://api.github.com/users/BastiaanOlij"},"body":"","html_url":"https://github.com/godotengine/godot/pull/99551#pullrequestreview-2470849502","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/99551","author_association":"CONTRIBUTOR","submitted_at":"2024-11-30T09:28:02Z"},{"id":2707105301,"node_id":"PRR_kwDOAO6SJc6hWyYV","state":"COMMENTED","commit_id":"efda589fcddfa5d7be382b1936ed84aabac8b893","user":{"site_admin":false,"suspended":false,"updated_at":"0001-01-01T00:00:00Z","avatar_url":"https://avatars.githubusercontent.com/u/191561?v=4","created_at":"0001-01-01T00:00:00Z","followers":0,"following":0,"html_url":"https://github.com/dsnopek","id":191561,"node_id":"MDQ6VXNlcjE5MTU2MQ==","login":"dsnopek","type":"User","owned_private_repos":0,"public_gists":0,"public_repos":0,"total_private_repos":0,"url":"https://api.github.com/users/dsnopek"},"body":"","html_url":"https://github.com/godotengine/godot/pull/99551#pullrequestreview-2707105301","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/99551","author_association":"CONTRIBUTOR","submitted_at":"2025-03-21T19:53:11Z"},{"id":2714221603,"node_id":"PRR_kwDOAO6SJc6hx7wj","state":"COMMENTED","commit_id":"76d709be74d6fa76ec3cd22af24e74b4b93602eb","user":{"site_admin":false,"suspended":false,"updated_at":"0001-01-01T00:00:00Z","avatar_url":"https://avatars.githubusercontent.com/u/538504?u=45f09996711edf524a11181d136e38113210b6ce&v=4","created_at":"0001-01-01T00:00:00Z","followers":0,"following":0,"html_url":"https://github.com/DarioSamo","id":538504,"node_id":"MDQ6VXNlcjUzODUwNA==","login":"DarioSamo","type":"User","owned_private_repos":0,"public_gists":0,"public_repos":0,"total_private_repos":0,"url":"https://api.github.com/users/DarioSamo"},"body":"Gave it a general review after I haven't looked at this PR for a while, all seems good to me. Will need approval from somebody else.","html_url":"https://github.com/godotengine/godot/pull/99551#pullrequestreview-2714221603","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/99551","author_association":"CONTRIBUTOR","submitted_at":"2025-03-25T15:28:31Z"},{"id":2714414452,"node_id":"PRR_kwDOAO6SJc6hyq10","state":"APPROVED","commit_id":"76d709be74d6fa76ec3cd22af24e74b4b93602eb","user":{"site_admin":false,"suspended":false,"updated_at":"0001-01-01T00:00:00Z","avatar_url":"https://avatars.githubusercontent.com/u/191561?v=4","created_at":"0001-01-01T00:00:00Z","followers":0,"following":0,"html_url":"https://github.com/dsnopek","id":191561,"node_id":"MDQ6VXNlcjE5MTU2MQ==","login":"dsnopek","type":"User","owned_private_repos":0,"public_gists":0,"public_repos":0,"total_private_repos":0,"url":"https://api.github.com/users/dsnopek"},"body":"I have tested this PR on the following headsets:\r\n\r\n- Quest 2\r\n- Quest Pro\r\n- Quest 3\r\n- Pico 4 Ultra\r\n- HTC Vive XR Elite\r\n\r\nPreviously, this PR was crashing on Quest 2, Quest Pro and HTC Vive XR Elite for me - this is no longer the case!\r\n\r\n@BastiaanOlij reported it crashing on Pico 4 (non-Ultra) as well, but I don't have one of those headsets to test. However, given that it's the same chip and driver as Quest 2, I would expect that to be fixed as well.\r\n\r\nOn all headsets it's working perfectly and I can see the lower resolution where I expect it - with the exception of HTC Vive XR Elite where there are some very strange visual artifacts. That said, this was a feature that didn't work at all before on that headset, and it's not crashing, so I think it'd be fine to address that later in a follow-up.","html_url":"https://github.com/godotengine/godot/pull/99551#pullrequestreview-2714414452","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/99551","author_association":"CONTRIBUTOR","submitted_at":"2025-03-25T16:25:26Z"},{"id":2715957980,"node_id":"PRR_kwDOAO6SJc6h4jrc","state":"APPROVED","commit_id":"76d709be74d6fa76ec3cd22af24e74b4b93602eb","user":{"site_admin":false,"suspended":false,"updated_at":"0001-01-01T00:00:00Z","avatar_url":"https://avatars.githubusercontent.com/u/1945449?u=96b5dc9be2859dca5f31314c87d99a68a21e1576&v=4","created_at":"0001-01-01T00:00:00Z","followers":0,"following":0,"html_url":"https://github.com/BastiaanOlij","id":1945449,"node_id":"MDQ6VXNlcjE5NDU0NDk=","login":"BastiaanOlij","type":"User","owned_private_repos":0,"public_gists":0,"public_repos":0,"total_private_repos":0,"url":"https://api.github.com/users/BastiaanOlij"},"body":"Seeing David already tested many headsets, I just tested on the missing one.\r\n\r\nOn Pico 4 (OG) this works as well. Note btw @dsnopek, if you want to make it absolutely clear foveated rendering is working, add this into your code:\r\n```\r\nopenxr_interface.vrs_min_radius = 5.0\r\nopenxr_interface.vrs_strength = 10.0\r\n```\r\nBasically makes everything but the focal point render at lowest quality :)\r\n\r\nI did notice one thing, but I don't think it's this PR, when turning verbose output on (which I was doing to verify us doing the right thing), PICO crashes at startup. I think its trying to log some junk somewhere.\r\n\r\nAlso likely unrelated to this PR but Dario, do double check:\r\n![image](https://github.com/user-attachments/assets/2b3834d4-00b5-4fa9-b03b-736c5802b933)\r\n\r\nI did all my testing with: https://github.com/BastiaanOlij/godot-xr-tools2/tree/weapon_demo","html_url":"https://github.com/godotengine/godot/pull/99551#pullrequestreview-2715957980","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/99551","author_association":"CONTRIBUTOR","submitted_at":"2025-03-26T05:41:33Z"}]