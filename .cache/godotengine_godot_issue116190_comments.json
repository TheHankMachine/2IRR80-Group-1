":"https://api.github.com/users/matheusmdx/gists{/gist_id}","starred_url":"https://api.github.com/users/matheusmdx/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/matheusmdx/subscriptions","organizations_url":"https://api.github.com/users/matheusmdx/orgs","repos_url":"https://api.github.com/users/matheusmdx/repos","events_url":"https://api.github.com/users/matheusmdx/events{/privacy}","received_events_url":"https://api.github.com/users/matheusmdx/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-02-12T23:40:35Z","updated_at":"2026-02-12T23:40:35Z","body":"Bisected to PR #110867. CC @Repiteo ","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3893989264/reactions","total_count":2,"+1":2,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3941718735","html_url":"https://github.com/godotengine/godot/issues/116190#issuecomment-3941718735","issue_url":"https://api.github.com/repos/godotengine/godot/issues/116190","id":3941718735,"node_id":"IC_kwDOAO6SJc7q8drP","user":{"login":"dukeman74","id":73570126,"node_id":"MDQ6VXNlcjczNTcwMTI2","avatar_url":"https://avatars.githubusercontent.com/u/73570126?v=4","gravatar_id":"","url":"https://api.github.com/users/dukeman74","html_url":"https://github.com/dukeman74","followers_url":"https://api.github.com/users/dukeman74/followers","following_url":"https://api.github.com/users/dukeman74/following{/other_user}","gists_url":"https://api.github.com/users/dukeman74/gists{/gist_id}","starred_url":"https://api.github.com/users/dukeman74/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/dukeman74/subscriptions","organizations_url":"https://api.github.com/users/dukeman74/orgs","repos_url":"https://api.github.com/users/dukeman74/repos","events_url":"https://api.github.com/users/dukeman74/events{/privacy}","received_events_url":"https://api.github.com/users/dukeman74/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-02-22T21:13:19Z","updated_at":"2026-02-23T21:42:35Z","body":"it appears that a workaround for this is to also have the code remove the \\r s from the command string when it is to be machine run.  This makes the MRP work correctly.  I'll test to see if this is sufficient for my real use case\n\ncause echo to put newlines: `replace('-ne', \"-e\")`\nstop echoing carriage returns at all `replace(r'\\r', \"\")`","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3941718735/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3947486893","html_url":"https://github.com/godotengine/godot/issues/116190#issuecomment-3947486893","issue_url":"https://api.github.com/repos/godotengine/godot/issues/116190","id":3947486893,"node_id":"IC_kwDOAO6SJc7rSd6t","user":{"login":"dukeman74","id":73570126,"node_id":"MDQ6VXNlcjczNTcwMTI2","avatar_url":"https://avatars.githubusercontent.com/u/73570126?v=4","gravatar_id":"","url":"https://api.github.com/users/dukeman74","html_url":"https://github.com/dukeman74","followers_url":"https://api.github.com/users/dukeman74/followers","following_url":"https://api.github.com/users/dukeman74/following{/other_user}","gists_url":"https://api.github.com/users/dukeman74/gists{/gist_id}","starred_url":"https://api.github.com/users/dukeman74/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/dukeman74/subscriptions","organizations_url":"https://api.github.com/users/dukeman74/orgs","repos_url":"https://api.github.com/users/dukeman74/repos","events_url":"https://api.github.com/users/dukeman74/events{/privacy}","received_events_url":"https://api.github.com/users/dukeman74/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-02-23T21:42:28Z","updated_at":"2026-02-23T21:42:28Z","body":"Cleansing the command of carriage returns does return my intended functionality.\nThis is technically still a regression, so I will leave my issue open, and defer the choice of whether or not to close it to a member.\nI am no longer personally invested in the issue or seeing a change be made to godot source related to it.\nThank you matheusmdx for finding the PR with the change, that made it possible to figure out a workaround.","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3947486893/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4544999385","html_url":"https://github.com/godotengine/godot/issues/116190#issuecomment-4544999385","issue_url":"https://api.github.com/repos/godotengine/godot/issues/116190","id":4544999385,"node_id":"IC_kwDOAO6SJc8AAAABDucv2Q","user":{"login":"Repiteo","id":17489292,"node_id":"MDQ6VXNlcjE3NDg5Mjky","avatar_url":"https://avatars.githubusercontent.com/u/17489292?v=4","gravatar_id":"","url":"https://api.github.com/users/Repiteo","html_url":"https://github.com/Repiteo","followers_url":"https://api.github.com/users/Repiteo/followers","following_url":"https://api.github.com/users/Repiteo/following{/other_user}","gists_url":"https://api.github.com/users/Repiteo/gists{/gist_id}","starred_url":"https://api.github.com/users/Repiteo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Repiteo/subscriptions","organizations_url":"https://api.github.com/users/Repiteo/orgs","repos_url":"https://api.github.com/users/Repiteo/repos","events_url":"https://api.github.com/users/Repiteo/events{/privacy}","received_events_url":"https://api.github.com/users/Repiteo/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-05-26T14:23:34Z","updated_at":"2026-05-26T14:23:34Z","body":"`\\r` in isolation is a newline break as of 4.6, so this is working as intended. If this were changed, it'd likely be in a way that still passes `\\r` as a valid character, instead of filtering it out completely like before, so this workaround would likely be necessary no matter what (unless you wanted to explicitly rely on an isolated carridge-return). How we should handle standalone `\\r`—if at all—warrants further discussion, but not in the context of this specific issue; thank you for making us aware of this scenario though!","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4544999385/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null}]