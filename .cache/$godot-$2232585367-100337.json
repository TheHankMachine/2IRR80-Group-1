[{"id":2500818944,"node_id":"PRR_kwDOAO6SJc6VD3gA","state":"APPROVED","user":{"site_admin":false,"suspended":false,"updated_at":"0001-01-01T00:00:00Z","avatar_url":"https://avatars.githubusercontent.com/u/2591099?u=7bcd4921b265b0b8cc1d8a15638a3fac93c87e68&v=4","created_at":"0001-01-01T00:00:00Z","followers":0,"following":0,"html_url":"https://github.com/hpvb","id":2591099,"node_id":"MDQ6VXNlcjI1OTEwOTk=","login":"hpvb","type":"User","owned_private_repos":0,"public_gists":0,"public_repos":0,"total_private_repos":0,"url":"https://api.github.com/users/hpvb"},"body":"At the risk of bikeshedding, I think we might as well just set `-mssse3` that is supported by every CPU that has at least 2 cores. The newest cpu to support it is AMD's \"bobcat\" architecture which is from early 2011.\r\n\r\nEvery single \"atom\" branded CPU has it too. On the Intel side this makes the oldest required CPU a \"Core 2 duo\" or a 64bit capable P4.\r\n\r\nNow I don't want this to bikeshed forever, I am just approving this. But I would also just approve an `-mssse3` if presented! ","html_url":"https://github.com/godotengine/godot/pull/100337#pullrequestreview-2500818944","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/100337","author_association":"MEMBER","submitted_at":"2024-12-12T21:31:27Z"},{"id":2500825185,"node_id":"PRR_kwDOAO6SJc6VD5Bh","state":"COMMENTED","user":{"site_admin":false,"suspended":false,"updated_at":"0001-01-01T00:00:00Z","avatar_url":"https://avatars.githubusercontent.com/u/17489292?u=34072b401722100a7c0c0d61e37b376cf22b4545&v=4","created_at":"0001-01-01T00:00:00Z","followers":0,"following":0,"html_url":"https://github.com/Repiteo","id":17489292,"node_id":"MDQ6VXNlcjE3NDg5Mjky","login":"Repiteo","type":"User","owned_private_repos":0,"public_gists":0,"public_repos":0,"total_private_repos":0,"url":"https://api.github.com/users/Repiteo"},"body":"","html_url":"https://github.com/godotengine/godot/pull/100337#pullrequestreview-2500825185","pull_request_u