:39:27Z","commit_id":null},{"id":3677712931,"node_id":"PRR_kwDOAO6SJc7bNXIj","user":{"login":"Ivorforce","id":2308167,"node_id":"MDQ6VXNlcjIzMDgxNjc=","avatar_url":"https://avatars.githubusercontent.com/u/2308167?u=f7f8e0273f784f5ec6f6b7fe4a88d449896eb48a&v=4","gravatar_id":"","url":"https://api.github.com/users/Ivorforce","html_url":"https://github.com/Ivorforce","followers_url":"https://api.github.com/users/Ivorforce/followers","following_url":"https://api.github.com/users/Ivorforce/following{/other_user}","gists_url":"https://api.github.com/users/Ivorforce/gists{/gist_id}","starred_url":"https://api.github.com/users/Ivorforce/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Ivorforce/subscriptions","organizations_url":"https://api.github.com/users/Ivorforce/orgs","repos_url":"https://api.github.com/users/Ivorforce/repos","events_url":"https://api.github.com/users/Ivorforce/events{/privacy}","received_events_url":"https://api.github.com/users/Ivorforce/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"You're right, independent from whether we want to make a change callee-side, fixing this problem takes priority.\n\nI can confirm this is a safe change. `can_process` is non-virtual, so the `ERR_FAIL_COND` will indeed be triggered in call cases without this fix.","state":"APPROVED","html_url":"https://github.com/godotengine/godot/pull/114966#pullrequestreview-3677712931","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/114966","author_association":"MEMBER","_links":{"html":{"href":"https://github.com/godotengine/godot/pull/114966#pullrequestreview-3677712931"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/114966"}},"submitted_at":"2026-01-19T11:52:52Z","commit_id":null}]