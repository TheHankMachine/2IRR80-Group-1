otengine/godot/pull/122802#discussion_r3855078787","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/122802","_links":{"self":{"href":"https://api.github.com/repos/godotengine/godot/pulls/comments/3855078787"},"html":{"href":"https://github.com/godotengine/godot/pull/122802#discussion_r3855078787"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/122802"}},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/3855078787/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":null,"original_line":3120,"side":"RIGHT","author_association":"CONTRIBUTOR","original_position":5,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/3855132108","pull_request_review_id":5021379645,"id":3855132108,"node_id":"PRRC_kwDOAO6SJc7lyKXM","diff_hunk":"@@ -95,6 +95,9 @@\n \t</methods>\n \t<members>\n \t\t<member name=\"accessibility_region\" type=\"bool\" setter=\"set_accessibility_region\" getter=\"is_accessibility_region\" overrides=\"Container\" default=\"true\" />\n+\t\t<member name=\"allow_switch_screen\" type=\"bool\" setter=\"set_allow_switch_screen\" getter=\"is_allow_switch_screen\" default=\"false\">\n+\t\t\tIf [code]true[/code], the editor can switch away from this dock if it's docked in the main screen. If [code]false[/code], actions like selecting 2D or 3D nodes won't switch away from this dock.","path":"doc/classes/EditorDock.xml","commit_id":"355ffe16850cdc373eb5c00c34e990f48bf0dcd8","original_commit_id":"355ffe16850cdc373eb5c00c34e990f48bf0dcd8","user":{"login":"kitbdev","id":10054226,"node_id":"MDQ6VXNlcjEwMDU0MjI2","avatar_url":"https://avatars.githubusercontent.com/u/10054226?v=4","gravatar_id":"","url":"https://api.github.com/users/kitbdev","html_url":"https://github.com/kitbdev","followers_url":"https://api.github.com/users/kitbdev/followers","following_url":"https://api.github.com/users/kitbdev/following{/other_user}","gists_url":"https://api.github.com/users/kitbdev/gists{/gist_id}","starred_url":"https://api.github.com/users/kitbdev/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/kitbdev/subscriptions","organizations_url":"https://api.github.com/users/kitbdev/orgs","repos_url":"https://api.github.com/users/kitbdev/repos","events_url":"https://api.github.com/users/kitbdev/events{/privacy}","received_events_url":"https://api.github.com/users/kitbdev/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"I think we should emphasize that this is just for selecting 2D/3D nodes (and switching scenes).\nThere are actions that switch the main screen that ignores this setting, so saying the editor can only switch away if true is misleading. Actions like pressing play or editing a script (or other resource that a custom main screen handles) always switch for example.\nMaybe the name could be `switch_on_node_select` even.","created_at":"2026-08-25T16:35:58Z","updated_at":"2026-08-25T16:48:06Z","html_url":"https://github.com/godotengine/godot/pull/122802#discussion_r3855132108","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/122802","_links":{"self":{"href":"https://api.github.com/repos/godotengine/godot/pulls/comments/3855132108"},"html":{"href":"https://github.com/godotengine/godot/pull/122802#discussion_r3855132108"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/122802"}},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/3855132108/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":null,"original_line":99,"side":"RIGHT","author_association":"CONTRIBUTOR","original_position":5,"position":1,"subject_type":"line"},{"url":"ht