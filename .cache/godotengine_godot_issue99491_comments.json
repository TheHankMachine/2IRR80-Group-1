53014?v=4","gravatar_id":"","url":"https://api.github.com/users/tetrapod00","html_url":"https://github.com/tetrapod00","followers_url":"https://api.github.com/users/tetrapod00/followers","following_url":"https://api.github.com/users/tetrapod00/following{/other_user}","gists_url":"https://api.github.com/users/tetrapod00/gists{/gist_id}","starred_url":"https://api.github.com/users/tetrapod00/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/tetrapod00/subscriptions","organizations_url":"https://api.github.com/users/tetrapod00/orgs","repos_url":"https://api.github.com/users/tetrapod00/repos","events_url":"https://api.github.com/users/tetrapod00/events{/privacy}","received_events_url":"https://api.github.com/users/tetrapod00/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2024-11-22T02:40:01Z","updated_at":"2024-11-22T02:40:01Z","body":"And for the record I think that the current state of postprocessing docs can be *much* improved, I would really like some page that compares the pros, cons, and limitations of each approach, especially now that the Compositor is implemented. It's just a large piece of work to to that.","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2492764274/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2492942703","html_url":"https://github.com/godotengine/godot/issues/99491#issuecomment-2492942703","issue_url":"https://api.github.com/repos/godotengine/godot/issues/99491","id":2492942703,"node_id":"IC_kwDOAO6SJc6Ul0lv","user":{"login":"SephReed","id":14002040,"node_id":"MDQ6VXNlcjE0MDAyMDQw","avatar_url":"https://avatars.githubusercontent.com/u/14002040?v=4","gravatar_id":"","url":"https://api.github.com/users/SephReed","html_ur