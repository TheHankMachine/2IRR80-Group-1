hived_at":null,"archived_by":null},{"id":890310664,"node_id":"MDU6TGFiZWw4OTAzMTA2NjQ=","url":"https://api.github.com/repos/godotengine/godot/labels/topic:input","name":"topic:input","color":"ffee88","default":false,"description":"","archived_at":null,"archived_by":null}],"state":"open","locked":false,"assignees":[],"milestone":null,"comments":7,"created_at":"2025-09-23T02:38:18Z","updated_at":"2026-09-01T21:53:30Z","closed_at":null,"assignee":null,"author_association":"NONE","issue_field_values":[],"type":null,"active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"### Tested versions\n\n- Reproducible in v4.5.stable.official [876b29033]\n\n### System information\n\nGodot v4.5.stable - macOS Tahoe (26.0.0) - Multi-window, 1 monitor - Metal (Forward+) - integrated Apple M2 (Apple8) - Apple M2 (8 threads) - 8.00 GiB memory\n\n### Issue description\n\nAttempting to change the cursor to a custom image using Input.set_custom_mouse_cursor() does not immediately change the cursor.\n\nIn order for the change to actually happen, you have to move the cursor off-screen and then move it back onto the active window.\n\n### Steps to reproduce\n\nThe MRP will initialize with a custom cursor (POINTER).\n\n1. Pressing [SPACE] will run the method to update the cursor (HAND)\n2. The cursor does not update\n3. Move the cursor off-screen\n4. Move the cursor back on-screen\n5. Observe that the cursor has now been updated\n\n### Minimal reproduction project (MRP)\n\n[mouse-cursor-mac-test.zip](https://github.com/user-attachments/files/22483196/mouse-cursor-mac-test.zip)","closed_by":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/110800/reactions","total_count":5,"+1":5,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/godotengine/godot/issues/1108