ckeon/orgs","repos_url":"https://api.github.com/users/Mickeon/repos","events_url":"https://api.github.com/users/Mickeon/events{/privacy}","received_events_url":"https://api.github.com/users/Mickeon/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"This entire PR is not necessary for a lot of small miscellaneous reasons that I am not sure are worth explaining, because of the questionable nature of the PR.\n\nI, for one, would gladly elaborate if I was confident a *human* contributor was willing to listen.","state":"CHANGES_REQUESTED","html_url":"https://github.com/godotengine/godot/pull/119536#pullrequestreview-4311231431","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/119536","author_association":"MEMBER","_links":{"html":{"href":"https://github.com/godotengine/godot/pull/119536#pullrequestreview-4311231431"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/119536"}},"submitted_at":"2026-05-18T14:53:20Z","commit_id":"13f89c89a5a6af9fe85906da7c2d27aaa382fe25"},{"id":4353268841,"node_id":"PRR_kwDOAO6SJc8AAAABA3mcaQ","user":{"login":"Mickeon","id":66727710,"node_id":"MDQ6VXNlcjY2NzI3NzEw","avatar_url":"https://avatars.githubusercontent.com/u/66727710?u=8069d9b7bc6ab503ce83dfcfa53fd021672aeccf&v=4","gravatar_id":"","url":"https://api.github.com/users/Mickeon","html_url":"https://github.com/Mickeon","followers_url":"https://api.github.com/users/Mickeon/followers","following_url":"https://api.github.com/users/Mickeon/following{/other_user}","gists_url":"https://api.github.com/users/Mickeon/gists{/gist_id}","starred_url":"https://api.github.com/users/Mickeon/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Mickeon/subscriptions","organizations_url":"https://api.github.com/users/Mickeon/orgs","repos_url":"https://api.github.com/users/Mickeon/repos","events_url":"https://api.github.com/users/Mickeon/events{/privacy}","received_events_url":"https://api.github.com/users/Mickeon/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"Okay, so. Even assuming that the accidentally-added **PacketPeerExtension** descriptions from https://github.com/godotengine/godot/pull/119533 were removed since they're an error, I don't personally think this PR is necessary for reasons I will highlight individually.\r\n\r\nIt mostly boils down to introducing information that is either unnecessary, or too specific. Sometimes saying less is good.\r\n\r\nAs a side note, you can see that the [static checks are failing](https://github.com/godotengine/godot/actions/runs/26018124573/job/76480012837?pr=119536) because there are trailing spaces at the end of some sentences. Beware of this. If you're using an IDE, most of them have a \"Trim trailing spaces\" shortcut.\r\n\r\nAnd, as a tip, there's many [documentation issues](https://github.com/godotengine/godot/issues?q=is%3Aissue%20state%3Aopen%20label%3Adocumentation) open which you can look up via the `documentation` label. Similar case in the [Godot-docs repository](https://github.com/godotengine/godot-docs/issues?q=is%3Aissue%20state%3Aopen%20label%3A%22area%3Aclass%20reference%22).\r\nThe solution to them may involve writing something extra, or fixing existing inaccuracies. Although it's not always that easy, they should give you a general clue on what is missing. [The problem comes before the solution](https://contributing.godotengine.org/en/latest/engine/guidelines/best_practices.html#to-solve-the-problem-it-has-to-exist-in-the-first-place).","state":"COMMENTED","html_url":"https://github.com/godotengine/godot/pull/119536#pullrequestreview-4353268841","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/119536","author_association":"MEMBER","_links":{"html":{"href":"https://github.com/godotengine/godot/pull/119536#pullrequestreview-4353268841"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/119536"}},"submitted_at":"2026-05-24T19:46:49Z","commit_id":"13f89c89a5a6af9fe85906da7c2d27aaa382fe25"}]