02738?v=4","gravatar_id":"","url":"https://api.github.com/users/Nintorch","html_url":"https://github.com/Nintorch","followers_url":"https://api.github.com/users/Nintorch/followers","following_url":"https://api.github.com/users/Nintorch/following{/other_user}","gists_url":"https://api.github.com/users/Nintorch/gists{/gist_id}","starred_url":"https://api.github.com/users/Nintorch/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Nintorch/subscriptions","organizations_url":"https://api.github.com/users/Nintorch/orgs","repos_url":"https://api.github.com/users/Nintorch/repos","events_url":"https://api.github.com/users/Nintorch/events{/privacy}","received_events_url":"https://api.github.com/users/Nintorch/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-01-05T04:47:53Z","updated_at":"2026-01-05T04:52:17Z","body":"> Would the other fix, to correct the controller configs, be feasible? That feels more right.\n> \n> https://github.com/mdqinc/SDL_GameControllerDB/pull/908\n> \n> We could also update the default android mapping:\n> https://github.com/godotengine/godot/compare/master...Randroids-Dojo:godot:fix-android-default-gamepad-triggers?expand=1\n\nHm, I think SDL on Android should be tested and checked if they have this problem with the same mappings, I'm not sure they do since I tried to implement SDL for Android in Godot once and this problem was fixed.\nSo it looks like a Godot issue, in my opinion we should update the code to match SDL behavior in this case","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3708930219/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3709455764","html_url":"https://github.com/godotengine/godot/pull/114363#issuecomment-3709455764","issue_url":"https://api.github.com/repos/godotengine/godot/issues/114363","id":3709455764,"node_id":"IC_kwDOAO6SJc7dGc2U","user":{"login":"Nintorch","id":92302738,"node_id":"U_kgDOBYBtkg","avatar_url":"https://avatars.githubusercontent.com/u/92302738?v=4","gravatar_id":"","url":"https://api.github.com/users/Nintorch","html_url":"https://github.com/Nintorch","followers_url":"https://api.github.com/users/Nintorch/followers","following_url":"https://api.github.com/users/Nintorch/following{/other_user}","gists_url":"https://api.github.com/users/Nintorch/gists{/gist_id}","starred_url":"https://api.github.com/users/Nintorch/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Nintorch/subscriptions","organizations_url":"https://api.github.com/users/Nintorch/orgs","repos_url":"https://api.github.com/users/Nintorch/repos","events_url":"https://api.github.com/users/Nintorch/events{/privacy}","received_events_url":"https://api.github.com/users/Nintorch/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-01-05T08:45:01Z","updated_at":"2026-01-05T08:45:01Z","body":"Since randroid88's PR for the controller DB was rejected, it seems that my second suggestion of fixing this bug in https://github.com/godotengine/godot/issues/114362#issuecomment-3693832140 (and the one used in this PR) seems to be the one we should use, unless there are other solutions I can't think of at the moment :D","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3709455764/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3709466889","html_url":"https://github.com/godotengine/godot/pull/114363#issuecomment-3709466889","issue_url":"https://api.github.com/repos/godotengine/godot/issues/114363","id":3709466889,"node_id":"IC_kwDOAO6SJc7dGfkJ","user":{"login":"akien-mga","id":4701338,"node_id":"MDQ6VXNlcjQ3MDEzMzg=","avatar_url":"https://avatars.githubusercontent.com/u/4701338?v=4","gravatar_id":"","url":"https://api.github.com/users/akien-mga","html_url":"https://github.com/akien-mga","followers_url":"https://api.github.com/users/akien-mga/followers","following_url":"https://api.github.com/users/akien-mga/following{/other_user}","gists_url":"https://api.github.com/users/akien-mga/gists{/gist_id}","starred_url":"https://api.github.com/users/akien-mga/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/akien-mga/subscriptions","organizations_url":"https://api.github.com/users/akien-mga/orgs","repos_url":"https://api.github.com/users/akien-mga/repos","events_url":"https://api.github.com/users/akien-mga/events{/privacy}","received_events_url":"https://api.github.com/users/akien-mga/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-01-05T08:48:27Z","updated_at":"2026-01-05T08:52:11Z","body":"Does SDL special case this for Android too?\r\n\r\nAnd does your PR switching the Android joypad driver to SDL fix it too?","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3709466889/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3709486049","html_url":"https://github.com/godotengine/godot/pull/114363#issuecomment-3709486049","issue_url":"https://api.github.com/repos/godotengine/godot/issues/114363","id":3709486049,"node_id":"IC_kwDOAO6SJc7dGkPh","user":{"login":"Nintorch","id":92302738,"node_id":"U_kgDOBYBtkg","avatar_url":"https://avatars.githubusercontent.com/u/92302738?v=4","gravatar_id":"","url":"https://api.github.com/users/Nintorch","html_url":"https://github.com/Nintorch","followers_url":"https://api.github.com/users/Nintorch/followers","following_url":"https://api.github.com/users/Nintorch/following{/other_user}","gists_url":"https://api.github.com/users/Nintorch/gists{/gist_id}","starred_url":"https://api.github.com/users/Nintorch/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Nintorch/subscriptions","organizations_url":"https://api.github.com/users/Nintorch/orgs","repos_url":"https://api.github.com/users/Nintorch/repos","events_url":"https://api.github.com/users/Nintorch/events{/privacy}","received_events_url":"https://api.github.com/users/Nintorch/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-01-05T08:54:53Z","updated_at":"2026-01-05T08:54:53Z","body":"> Does SDL special case this for Android too?\r\n\r\nHm, I might need to check the SDL's code.\r\n\r\n> And does your PR switching the Android joypad driver to SDL fix it too?\r\n\r\nYes, it did: https://github.com/godotengine/godot/pull/109645. See the \"1. Trigger axes values were not reset after the user stops pressing on them;\" section","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3709486049/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3709537375","html_url":"https://github.com/godotengine/godot/pull/114363#issuecomment-3709537375","issue_url":"https://api.github.com/repos/godotengine/godot/issues/114363","id":3709537375,"node_id":"IC_kwDOAO6SJc7dGwxf","user":{"login":"Nintorch","id":92302738,"node_id":"U_kgDOBYBtkg","avatar_url":"https://avatars.githubusercontent.com/u/92302738?v=4","gravatar_id":"","url":"https://api.github.com/users/Nintorch","html_url":"https://github.com/Nintorch","followers_url":"https://api.github.com/users/Nintorch/followers","following_url":"https://api.github.com/users/Nintorch/following{/other_user}","gists_url":"https://api.github.com/users/Nintorch/gists{/gist_id}","starred_url":"https://api.github.com/users/Nintorch/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Nintorch/subscriptions","organizations_url":"https://api.github.com/users/Nintorch/orgs","repos_url":"https://api.github.com/users/Nintorch/repos","events_url":"https://api.github.com/users/Nintorch/events{/privacy}","received_events_url":"https://api.github.com/users/Nintorch/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-01-05T09:10:16Z","updated_at":"2026-01-05T09:13:06Z","body":"Hm, I found something interesting!\r\nhttps://github.com/libsdl-org/SDL/blob/cced3ce8b971c7f4b50e31f3daaa48816a2fffe5/android-project/app/src/main/java/org/libsdl/app/SDLControllerManager.java#L333\r\n```java\r\n                for (int i = 0; i < joystick.axes.size(); i++) {\r\n                    InputDevice.MotionRange range = joystick.axes.get(i);\r\n                    /* Normalize the value to -1...1 */\r\n                    float value = (event.getAxisValue(range.getAxis(), actionPointerIndex) - range.getMin()) / range.getRange() * 2.0f - 1.0f;\r\n                    SDLControllerManager.onNativeJoy(joystick.device_id, i, value);\r\n                }\r\n```\r\nhttps://github.com/libsdl-org/SDL/blob/cced3ce8b971c7f4b50e31f3daaa48816a2fffe5/src/joystick/android/SDL_sysjoystick.c#L237-L251\r\n```c\r\nbool Android_OnJoy(int device_id, int axis, float value)\r\n{\r\n    Uint64 timestamp = SDL_GetTicksNS();\r\n    // Android gives joy info normalized as [-1.0, 1.0] or [0.0, 1.0]\r\n    SDL_joylist_item *item;\r\n\r\n    SDL_LockJoysticks();\r\n    item = JoystickByDeviceId(device_id);\r\n    if (item && item->joystick) {\r\n        SDL_SendJoystickAxis(timestamp, item->joystick, axis, (Sint16)(32767. * value));\r\n    }\r\n    SDL_UnlockJoysticks();\r\n\r\n    return true;\r\n}\r\n```\r\nMaybe in this case Android is treating trigger axes as \"full range\" (thus returning full range for `range.getRange()` so the value is normalized to [-1;1]), but still only returns non-negative values?","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3709537375/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3711172384","html_url":"https://github.com/godotengine/godot/pull/114363#issuecomment-3711172384","issue_url":"https://api.github.com/repos/godotengine/godot/issues/114363","id":3711172384,"node_id":"IC_kwDOAO6SJc7dM_8g","user":{"login":"Alex2782","id":41921395,"node_id":"MDQ6VXNlcjQxOTIxMzk1","avatar_url":"https://avatars.githubusercontent.com/u/41921395?v=4","gravatar_id":"","url":"https://api.github.com/users/Alex2782","html_url":"https://github.com/Alex2782","followers_url":"https://api.github.com/users/Alex2782/followers","following_url":"https://api.github.com/users/Alex2782/following{/other_user}","gists_url":"https://api.github.com/users/Alex2782/gists{/gist_id}","starred_url":"https://api.github.com/users/Alex2782/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Alex2782/subscriptions","organizations_url":"https://api.github.com/users/Alex2782/orgs","repos_url":"https://api.github.com/users/Alex2782/repos","events_url":"https://api.github.com/users/Alex2782/events{/privacy}","received_events_url":"https://api.github.com/users/Alex2782/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-01-05T16:27:21Z","updated_at":"2026-01-05T16:37:34Z","body":"https://github.com/godotengine/godot/issues/114362#issuecomment-3693832140\r\n\r\n\r\nThis problem sounds familiar; I had it with my Xbox controller. However, I'm not sure if we should disable it for all controllers. I lack the testing capabilities to say for sure.\r\n\r\n\r\n--------------\r\n\r\n\r\nMy PR for Xbox controller: https://github.com/godotengine/godot/pull/106021\r\n\r\n\r\nPerhaps it would be better to insert it here? `godotcontrollerdb.txt` \r\nThis file is used to override the SDL 2.0 configuration.\r\n\r\nhttps://github.com/godotengine/godot/blob/63227bbc8ae5300319f14f8253c8158b846f355b/core/input/godotcontrollerdb.txt#L6-L20\r\n\r\n\r\n\r\n\r\nhttps://github.com/godotengine/godot/blob/63227bbc8ae5300319f14f8253c8158b846f355b/core/input/gamecontrollerdb.txt#L1-L2\r\n\r\n\r\nThe SDL 2.0 configuration file `gamecontrollerdb.txt` will be overwritten at some point. We last did this 7 months ago; perhaps we should do it again?\r\n","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3711172384/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3711230871","html_url":"https://github.com/godotengine/godot/pull/114363#issuecomment-3711230871","issue_url":"https://api.github.com/repos/godotengine/godot/issues/114363","id":3711230871,"node_id":"IC_kwDOAO6SJc7dNOOX","user":{"login":"Nintorch","id":92302738,"node_id":"U_kgDOBYBtkg","avatar_url":"https://avatars.githubusercontent.com/u/92302738?v=4","gravatar_id":"","url":"https://api.github.com/users/Nintorch","html_url":"https://github.com/Nintorch","followers_url":"https://api.github.com/users/Nintorch/followers","following_url":"https://api.github.com/users/Nintorch/following{/other_user}","gists_url":"https://api.github.com/users/Nintorch/gists{/gist_id}","starred_url":"https://api.github.com/users/Nintorch/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Nintorch/subscriptions","organizations_url":"https://api.github.com/users/Nintorch/orgs","repos_url":"https://api.github.com/users/Nintorch/repos","events_url":"https://api.github.com/users/Nintorch/events{/privacy}","received_events_url":"https://api.github.com/users/Nintorch/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-01-05T16:43:16Z","updated_at":"2026-01-05T16:43:16Z","body":"> Perhaps it would be better to insert it here? godotcontrollerdb.txt\n>This file is used to override the SDL 2.0 configuration.\n\nBut what about other controllers with triggers?\n\nThe code I disabled in this PR transforms the axes from [-1;1] to [0;1], but that's assuming the axes *can* take negative values. I'm not entirely sure there are other controllers on Android that report negative values for axes 😅","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3711230871/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3711238743","html_url":"https://github.com/godotengine/godot/pull/114363#issuecomment-3711238743","issue_url":"https://api.github.com/repos/godotengine/godot/issues/114363","id":3711238743,"node_id":"IC_kwDOAO6SJc7dNQJX","user":{"login":"Alex2782","id":41921395,"node_id":"MDQ6VXNlcjQxOTIxMzk1","avatar_url":"https://avatars.githubusercontent.com/u/41921395?v=4","gravatar_id":"","url":"https://api.github.com/users/Alex2782","html_url":"https://github.com/Alex2782","followers_url":"https://api.github.com/users/Alex2782/followers","following_url":"https://api.github.com/users/Alex2782/following{/other_user}","gists_url":"https://api.github.com/users/Alex2782/gists{/gist_id}","starred_url":"https://api.github.com/users/Alex2782/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Alex2782/subscriptions","organizations_url":"https://api.github.com/users/Alex2782/orgs","repos_url":"https://api.github.com/users/Alex2782/repos","events_url":"https://api.github.com/users/Alex2782/events{/privacy}","received_events_url":"https://api.github.com/users/Alex2782/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-01-05T16:45:25Z","updated_at":"2026-01-05T16:45:25Z","body":"> Maybe in this case Android is treating trigger axes as \"full range\" (thus returning full range for `range.getRange()` so the value is normalized to [-1;1]), but still only returns non-negative values?\r\n\r\n`// Android gives joy info normalized as [-1.0, 1.0] or [0.0, 1.0]`\r\nThis comment sounds to me like it's hardware-dependent.\r\n\r\n------------------------\r\n\r\n`SDL_SendJoystickAxis(timestamp, item->joystick, axis, (Sint16)(32767. * value));`\r\nThis code should also correctly convert negative (`signed`) values.\r\n\r\nhttps://github.com/libsdl-org/SDL/blob/6c2f9bc41e8667a0002d14307a566ec1b53345e5/include/SDL3/SDL_stdinc.h#L456-L461\r\n\r\n```cpp\r\n/**\r\n * A signed 16-bit integer type.\r\n *\r\n * \\since This macro is available since SDL 3.2.0.\r\n */\r\ntypedef int16_t Sint16;\r\n```\r\n","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3711238743/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3711308669","html_url":"https://github.com/godotengine/godot/pull/114363#issuecomment-3711308669","issue_url":"https://api.github.com/repos/godotengine/godot/issues/114363","id":3711308669,"node_id":"IC_kwDOAO6SJc7dNhN9","user":{"login":"Alex2782","id":41921395,"node_id":"MDQ6VXNlcjQxOTIxMzk1","avatar_url":"https://avatars.githubusercontent.com/u/41921395?v=4","gravatar_id":"","url":"https://api.github.com/users/Alex2782","html_url":"https://github.com/Alex2782","followers_url":"https://api.github.com/users/Alex2782/followers","following_url":"https://api.github.com/users/Alex2782/following{/other_user}","gists_url":"https://api.github.com/users/Alex2782/gists{/gist_id}","starred_url":"https://api.github.com/users/Alex2782/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Alex2782/subscriptions","organizations_url":"https://api.github.com/users/Alex2782/orgs","repos_url":"https://api.github.com/users/Alex2782/repos","events_url":"https://api.github.com/users/Alex2782/events{/privacy}","received_events_url":"https://api.github.com/users/Alex2782/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-01-05T17:04:23Z","updated_at":"2026-01-05T17:04:23Z","body":"> But what about other controllers with triggers?\r\n> \r\n> The code I disabled in this PR transforms the axes from [-1;1] to [0;1], but that's assuming the axes _can_ take negative values. I'm not entirely sure there are other controllers on Android that report negative values for axes 😅\r\n\r\nI'm not sure either, so my suggestion is to first adjust this file (`godotcontrollerdb.txt`) to avoid possible regressions.\r\n\r\n----------\r\n\r\nIn our `gamecontrollerdb.txt` file (updated 7 months ago) I see 295 GUID Android controllers, sometimes with a `+` configured for triggers. But only 8 of them.\r\n\r\n<img width=\"794\" height=\"204\" alt=\"image\" src=\"https://github.com/user-attachments/assets/ea46bfc5-69e1-421d-a345-6d02f270bc4f\" />\r\n\r\n","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3711308669/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3711309411","html_url":"https://github.com/godotengine/godot/pull/114363#issuecomment-3711309411","issue_url":"https://api.github.com/repos/godotengine/godot/issues/114363","id":3711309411,"node_id":"IC_kwDOAO6SJc7dNhZj","user":{"login":"akien-mga","id":4701338,"node_id":"MDQ6VXNlcjQ3MDEzMzg=","avatar_url":"https://avatars.githubusercontent.com/u/4701338?v=4","gravatar_id":"","url":"https://api.github.com/users/akien-mga","html_url":"https://github.com/akien-mga","followers_url":"https://api.github.com/users/akien-mga/followers","following_url":"https://api.github.com/users/akien-mga/following{/other_user}","gists_url":"https://api.github.com/users/akien-mga/gists{/gist_id}","starred_url":"https://api.github.com/users/akien-mga/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/akien-mga/subscriptions","organizations_url":"https://api.github.com/users/akien-mga/orgs","repos_url":"https://api.github.com/users/akien-mga/repos","events_url":"https://api.github.com/users/akien-mga/events{/privacy}","received_events_url":"https://api.github.com/users/akien-mga/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-01-05T17:04:35Z","updated_at":"2026-01-05T17:04:35Z","body":"In general, if SDL doesn't need custom mappings to deal with triggers on Android, we shouldn't need either. If https://developer.android.com/reference/android/view/MotionEvent#AXIS_RTRIGGER claims that all trigger events will be normalized in `[0, 1]`, this might be true? Maybe the SDL comment is outdated.","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3711309411/reactions","total_count":5,"+1":5,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3711393080","html_url":"https://github.com/godotengine/godot/pull/114363#issuecomment-3711393080","issue_url":"https://api.github.com/repos/godotengine/godot/issues/114363","id":3711393080,"node_id":"IC_kwDOAO6SJc7dN104","user":{"login":"randroid88","id":11371505,"node_id":"MDQ6VXNlcjExMzcxNTA1","avatar_url":"https://avatars.githubusercontent.com/u/11371505?v=4","gravatar_id":"","url":"https://api.github.com/users/randroid88","html_url":"https://github.com/randroid88","followers_url":"https://api.github.com/users/randroid88/followers","following_url":"https://api.github.com/users/randroid88/following{/other_user}","gists_url":"https://api.github.com/users/randroid88/gists{/gist_id}","starred_url":"https://api.github.com/users/randroid88/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/randroid88/subscriptions","organizations_url":"https://api.github.com/users/randroid88/orgs","repos_url":"https://api.github.com/users/randroid88/repos","events_url":"https://api.github.com/users/randroid88/events{/privacy}","received_events_url":"https://api.github.com/users/randroid88/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-01-05T17:28:36Z","updated_at":"2026-01-05T17:28:36Z","body":"@Nintorch does the controller you're testing with have the + prefix? Is it possible to add it and recompile to see if that alone fixes your issue.","author_association":"NONE","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3711393080/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3711403185","html_url":"https://github.com/godotengine/godot/pull/114363#issuecomment-3711403185","issue_url":"https://api.github.com/repos/godotengine/godot/issues/114363","id":3711403185,"node_id":"IC_kwDOAO6SJc7dN4Sx","user":{"login":"Alex2782","id":41921395,"node_id":"MDQ6VXNlcjQxOTIxMzk1","avatar_url":"https://avatars.githubusercontent.com/u/41921395?v=4","gravatar_id":"","url":"https://api.github.com/users/Alex2782","html_url":"htt