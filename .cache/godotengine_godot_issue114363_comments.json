[{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3707993127","html_url":"https://github.com/godotengine/godot/pull/114363#issuecomment-3707993127","issue_url":"https://api.github.com/repos/godotengine/godot/issues/114363","id":3707993127,"node_id":"IC_kwDOAO6SJc7dA3wn","user":{"login":"Nintorch","id":92302738,"node_id":"U_kgDOBYBtkg","avatar_url":"https://avatars.githubusercontent.com/u/92302738?v=4","gravatar_id":"","url":"https://api.github.com/users/Nintorch","html_url":"https://github.com/Nintorch","followers_url":"https://api.github.com/users/Nintorch/followers","following_url":"https://api.github.com/users/Nintorch/following{/other_user}","gists_url":"https://api.github.com/users/Nintorch/gists{/gist_id}","starred_url":"https://api.github.com/users/Nintorch/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Nintorch/subscriptions","organizations_url":"https://api.github.com/users/Nintorch/orgs","repos_url":"https://api.github.com/users/Nintorch/repos","events_url":"https://api.github.com/users/Nintorch/events{/privacy}","received_events_url":"https://api.github.com/users/Nintorch/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-01-04T11:18:40Z","updated_at":"2026-01-04T11:18:40Z","body":"Thank you for your review, syntaxerror247! :)","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3707993127/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3708496530","html_url":"https://github.com/godotengine/godot/pull/114363#issuecomment-3708496530","issue_url":"https://api.github.com/repos/godotengine/godot/issues/114363","id":3708496530,"node_id":"IC_kwDOAO6SJc7dCyqS","user":{"login":"randroid88","id":11371505,"node_id":"MDQ6VXNlcjExMzcxNTA1"