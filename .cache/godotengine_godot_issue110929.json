hived_by":null}],"state":"closed","locked":false,"assignees":[],"milestone":{"url":"https://api.github.com/repos/godotengine/godot/milestones/23","html_url":"https://github.com/godotengine/godot/milestone/23","labels_url":"https://api.github.com/repos/godotengine/godot/milestones/23/labels","id":12939969,"node_id":"MI_kwDOAO6SJc4AxXLB","number":23,"title":"4.6","description":"","creator":{"login":"Repiteo","id":17489292,"node_id":"MDQ6VXNlcjE3NDg5Mjky","avatar_url":"https://avatars.githubusercontent.com/u/17489292?v=4","gravatar_id":"","url":"https://api.github.com/users/Repiteo","html_url":"https://github.com/Repiteo","followers_url":"https://api.github.com/users/Repiteo/followers","following_url":"https://api.github.com/users/Repiteo/following{/other_user}","gists_url":"https://api.github.com/users/Repiteo/gists{/gist_id}","starred_url":"https://api.github.com/users/Repiteo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Repiteo/subscriptions","organizations_url":"https://api.github.com/users/Repiteo/orgs","repos_url":"https://api.github.com/users/Repiteo/repos","events_url":"https://api.github.com/users/Repiteo/events{/privacy}","received_events_url":"https://api.github.com/users/Repiteo/received_events","type":"User","user_view_type":"public","site_admin":false},"open_issues":3,"closed_issues":2978,"state":"closed","created_at":"2025-05-22T16:25:52Z","updated_at":"2026-10-04T16:23:23Z","due_on":null,"closed_at":"2026-01-26T18:09:14Z"},"comments":3,"created_at":"2025-09-26T13:45:53Z","updated_at":"2025-11-18T20:04:55Z","closed_at":"2025-11-18T20:03:56Z","assignee":null,"author_association":"NONE","issue_field_values":[],"type":null,"active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"### Tested versions\n\nVersion: 4.5.stable [876b29033]\n\n### System information\n\nmacOS Tahoe - M1 Mackbook Air\n\n### Issue description\n\nI followed the Command line tutorial in the Godot Docs.\nhttps://docs.godotengine.org/en/stable/tutorials/editor/command_line_tutorial.html#running-a-script\n\nI created a GDScript file and added executable permission to it using `chmod +x`.\n\nAfter confirming that the script runs correctly from the CLI, I edited and saved the file in the Godot editor. \n\nWhen I tried to run the script again, I got a \"permission denied\" error.\n\nIt seems that saving the file in the editor removes the executable permission.\n\n### Steps to reproduce\n\n1. Create a GDScript and save it as `sayhello.gd`:\n```gdscript\n#!/usr/bin/env -S godot -s\nextends SceneTree\n\nfunc _init():\n    print(\"Hello!\")\n    quit()\n```\n\n2. Make the file executable and run it:\n```\n$ chmod +x sayhello.gd\n$ ./sayhello.gd\nHello!\n```\n\n3. Edit the file in the Godot editor and save it:\n```gdscript\n#!/usr/bin/env -S godot -s\nextends SceneTree\n\nfunc _init():\n    print(\"Hello Again!\")\n    quit()\n```\n\n4. Try running it again:\n```\n$ ./sayhello.gd\nzsh: permission denied: ./sayhello.gd\n```\n\n\n### Minimal reproduction project (MRP)\n\n[Godot-permission-issue.zip](https://github.com/user-attachments/files/22561539/Godot-permission-issue.zip)","closed_by":{"login":"Repiteo","id":17489292,"node_id":"MDQ6VXNlcjE3NDg5Mjky","avatar_url":"https://avatars.githubusercontent.com/u/17489292?v=4","gravatar_id":"","url":"https://api.github.com/users/Repiteo","html_url":"https://github.com/Repiteo","followers_url":"https://api.github.com/users/Repiteo/followers","following_url":"https://api.github.com/users/Repiteo/following{/other_user}","gists_url":"https://api.github.com/users/Repiteo/gists{/gist_id}","starred_url":"https://api.github.com/users/Repiteo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Repiteo/subscriptions","organizations_url":"https://api.github.com/users/Repiteo/orgs","repos_url":"https://api.github.com/users/Repiteo/repos","events_url":"https://api.github.com/users/Repiteo/events{/privacy}","received_events_url":"https://api.github.com/users/Repiteo/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/110929/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/godotengine/godot/issues/110929/timeline","performed_via_github_app":null,"state_reason":"completed","pinned_comment":null}