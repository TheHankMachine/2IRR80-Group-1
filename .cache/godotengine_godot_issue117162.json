scription":"","archived_at":null,"archived_by":null},{"id":572781997,"node_id":"MDU6TGFiZWw1NzI3ODE5OTc=","url":"https://api.github.com/repos/godotengine/godot/labels/topic:audio","name":"topic:audio","color":"ffee88","default":false,"description":"","archived_at":null,"archived_by":null},{"id":3240950060,"node_id":"MDU6TGFiZWwzMjQwOTUwMDYw","url":"https://api.github.com/repos/godotengine/godot/labels/performance","name":"performance","color":"447777","default":false,"description":"","archived_at":null,"archived_by":null}],"state":"closed","locked":false,"assignees":[],"milestone":{"url":"https://api.github.com/repos/godotengine/godot/milestones/25","html_url":"https://github.com/godotengine/godot/milestone/25","labels_url":"https://api.github.com/repos/godotengine/godot/milestones/25/labels","id":15520464,"node_id":"MI_kwDOAO6SJc4A7NLQ","number":25,"title":"4.8","description":"","creator":{"login":"Repiteo","id":17489292,"node_id":"MDQ6VXNlcjE3NDg5Mjky","avatar_url":"https://avatars.githubusercontent.com/u/17489292?v=4","gravatar_id":"","url":"https://api.github.com/users/Repiteo","html_url":"https://github.com/Repiteo","followers_url":"https://api.github.com/users/Repiteo/followers","following_url":"https://api.github.com/users/Repiteo/following{/other_user}","gists_url":"https://api.github.com/users/Repiteo/gists{/gist_id}","starred_url":"https://api.github.com/users/Repiteo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Repiteo/subscriptions","organizations_url":"https://api.github.com/users/Repiteo/orgs","repos_url":"https://api.github.com/users/Repiteo/repos","events_url":"https://api.github.com/users/Repiteo/events{/privacy}","received_events_url":"https://api.github.com/users/Repiteo/received_events","type":"User","user_view_type":"public","site_admin":false},"open_issues":341,"closed_issues":2335,"state":"open","created_at":"2026-04-13T15:59:35Z","updated_at":"2026-10-22T03:07:42Z","due_on":null,"closed_at":null},"comments":9,"created_at":"2026-03-06T20:59:18Z","updated_at":"2026-08-20T11:13:17Z","closed_at":"2026-08-19T22:21:38Z","assignee":null,"author_association":"CONTRIBUTOR","issue_field_values":[],"type":null,"active_lock_reason":null,"draft":false,"pull_request":{"url":"https://api.github.com/repos/godotengine/godot/pulls/117162","html_url":"https://github.com/godotengine/godot/pull/117162","diff_url":"https://github.com/godotengine/godot/pull/117162.diff","patch_url":"https://github.com/godotengine/godot/pull/117162.patch","merged_at":"2026-08-19T22:21:38Z"},"body":"Audio: let CoreAudio go to sleep when nothing is playing and reduce busy work\r\nwhen idling. \r\n\r\nThis changes the macOS audio path so we stop the CoreAudio output unit when\r\nthe engine has been idle for a short time, instead of keeping it running.\r\n\r\nI added a small output sleep/wake capability to AudioDriver (optional by\r\nbackend), then wired it up in CoreAudio with AudioOutputUnitStop/Start.\r\n\r\nOn the AudioServer side, we now keep an atomic count of active stream\r\nplaybacks, update it when playbacks are added/removed, and use it to detect\r\ntrue stream idleness. After 3 seconds with no active streams, we ask the\r\ndriver to sleep. As soon as playback starts again, we wake it immediately.\r\n\r\nI also added a removal guard on playback nodes to avoid double-removal races,\r\nand adjusted CoreAudio device switching so output/input device changes still\r\napply even while output is asleep.\r\n\r\nThis builds on previous work and previous efforts:\r\n\r\nhttps://github.com/godotengine/godot/pull/45948\r\nhttps://github.com/godotengine/godot/pull/51296\r\n\r\nAlso fixes: https://github.com/godotengine/godot/issues/28039\r\nFixes: https://github.com/godotengine/godot/issues/118375\r\n\r\nThis is part of the ongoing saga to reduce the busy work while idling:\r\n\r\nhttps://github.com/godotengine/godot/issues/116845\r\n\r\nBy keeping the audio going, Godot prevents MacOS from sleeping, with\r\nthis change, your machine can actually go to sleep.\r\n","closed_by":{"login":"Repiteo","id":17489292,"node_id":"MDQ6VXNlcjE3NDg5Mjky","avatar_url":"https://avatars.githubusercontent.com/u/17489292?v=4","gravatar_id":"","url":"https://api.github.com/users/Repiteo","html_url":"https://github.com/Repiteo","followers_url":"https://api.github.com/users/Repiteo/followers","following_url":"https://api.github.com/users/Repiteo/following{/other_user}","gists_url":"https://api.github.com/users/Repiteo/gists{/gist_id}","starred_url":"https://api.github.com/users/Repiteo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Repiteo/subscriptions","organizations_url":"https://api.github.com/users/Repiteo/orgs","repos_url":"https://api.github.com/users/Repiteo/repos","events_url":"https://api.github.com/users/Repiteo/events{/privacy}","received_events_url":"https://api.github.com/users/Repiteo/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/117162/reactions","total_count":30,"+1":20,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":3,"rocket":7,"eyes":0},"timeline_url":"https://api.github.com/repos/godotengine/godot/issues/117162/timeline","performed_via_github_app":null,"state_reason":null}