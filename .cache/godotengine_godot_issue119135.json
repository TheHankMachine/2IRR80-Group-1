d_by":null},{"id":2666708289,"node_id":"MDU6TGFiZWwyNjY2NzA4Mjg5","url":"https://api.github.com/repos/godotengine/godot/labels/topic:3d","name":"topic:3d","color":"ffee88","default":false,"description":"","archived_at":null,"archived_by":null}],"state":"closed","locked":false,"assignees":[],"milestone":null,"comments":5,"created_at":"2026-05-01T07:28:46Z","updated_at":"2026-06-30T21:55:48Z","closed_at":"2026-06-30T21:55:35Z","assignee":null,"author_association":"NONE","issue_field_values":[],"type":null,"active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"### Tested versions\n\n- Reproducible in v4.7.beta1.official [1c8cc9e7e]\n\n### System information\n\nOperating System: Manjaro Linux  KDE Plasma Version: 6.5.6 KDE Frameworks Version: 6.24.0 Qt Version: 6.10.2 Kernel Version: 6.18.18-1-MANJARO (64-bit) Graphics Platform: Wayland Processors: 24 × AMD Ryzen 9 5900X 12-Core Processor Memory: 128 GiB of RAM (125,7 GiB usable) Graphics Processor: AMD Radeon RX 7900 XT Manufacturer: Gigabyte Technology Co., Ltd. Product Name: B550 AORUS ELITE AX V2\n\n### Issue description\n\nAreaLight3D is visible with Bake Mode `Dynamic` and `Disabled`, but is not contributing to lighting at all with `Static`.\n\n<img width=\"1561\" height=\"818\" alt=\"Image\" src=\"https://github.com/user-attachments/assets/321e969a-556a-49c2-87e4-880448c9f71f\" />\n\n<img width=\"1563\" height=\"812\" alt=\"Image\" src=\"https://github.com/user-attachments/assets/83c94625-ffad-4c0d-b252-08fd739044c9\" />\n\nIt is visible when there is no LightmapGI baked first, but as soon as you have baked Lighting, it is not rendered at all!\n\n<img width=\"1905\" height=\"869\" alt=\"Image\" src=\"https://github.com/user-attachments/assets/40b3fb84-a0ef-4097-a1b7-57d26b65564c\" />\n\n<img width=\"1905\" height=\"869\" alt=\"Image\" src=\"https://github.com/user-attachments/assets/6bec674c-7d58-44cc-8f5f-1e5f08b0c4bf\" />\n\n### Steps to reproduce\n\n- Place LightmapGI, Bake Light with atleast one Lightmap generated\n- Place AreaLight3D where it should affect a statically baked object\n- Set it's Bake Mode to `Static`\n- See how the light influence disappears at runtime and baking Lightmaps are not affected\n\n### Minimal reproduction project (MRP)\n\n[area_light_3d_mrp.zip](https://github.com/user-attachments/files/27270983/area_light_3d_mrp.zip)","closed_by":{"login":"clayjohn","id":16521339,"node_id":"MDQ6VXNlcjE2NTIxMzM5","avatar_url":"https://avatars.githubusercontent.com/u/16521339?v=4","gravatar_id":"","url":"https://api.github.com/users/clayjohn","html_url":"https://github.com/clayjohn","followers_url":"https://api.github.com/users/clayjohn/followers","following_url":"https://api.github.com/users/clayjohn/following{/other_user}","gists_url":"https://api.github.com/users/clayjohn/gists{/gist_id}","starred_url":"https://api.github.com/users/clayjohn/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/clayjohn/subscriptions","organizations_url":"https://api.github.com/users/clayjohn/orgs","repos_url":"https://api.github.com/users/clayjohn/repos","events_url":"https://api.github.com/users/clayjohn/events{/privacy}","received_events_url":"https://api.github.com/users/clayjohn/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/119135/reactions","total_count":1,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":1},"timeline_url":"https://api.github.com/repos/godotengine/godot/issues/119135/timeline","performed_via_github_app":null,"state_reason":"completed","pinned_comment":null}