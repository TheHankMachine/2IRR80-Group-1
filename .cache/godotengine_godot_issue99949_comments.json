hub.com/user-attachments/assets/c1405958-f649-4f0b-8f68-719e0a9d9b8f)\r\nBut there is no way to solve that right now.\r\n\r\nEDIT:\r\nI opened #101468\r\nIf it's merged first, this PR can be merged without further changes.","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2585880391/reactions","total_count":1,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":1,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3932899136","html_url":"https://github.com/godotengine/godot/pull/99949#issuecomment-3932899136","issue_url":"https://api.github.com/repos/godotengine/godot/issues/99949","id":3932899136,"node_id":"IC_kwDOAO6SJc7qa0dA","user":{"login":"ryevdokimov","id":105675984,"node_id":"U_kgDOBkx80A","avatar_url":"https://avatars.githubusercontent.com/u/105675984?v=4","gravatar_id":"","url":"https://api.github.com/users/ryevdokimov","html_url":"https://github.com/ryevdokimov","followers_url":"https://api.github.com/users/ryevdokimov/followers","following_url":"https://api.github.com/users/ryevdokimov/following{/other_user}","gists_url":"https://api.github.com/users/ryevdokimov/gists{/gist_id}","starred_url":"https://api.github.com/users/ryevdokimov/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/ryevdokimov/subscriptions","organizations_url":"https://api.github.com/users/ryevdokimov/orgs","repos_url":"https://api.github.com/users/ryevdokimov/repos","events_url":"https://api.github.com/users/ryevdokimov/events{/privacy}","received_events_url":"https://api.github.com/users/ryevdokimov/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-02-20T10:23:07Z","updated_at":"2026-02-20T10:23:07Z","body":"May need another pass from @KoBeWi for translation/2D. ","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/go