kwDOAO6SJc7QAWhr","user":{"login":"bruvzg","id":7645683,"node_id":"MDQ6VXNlcjc2NDU2ODM=","avatar_url":"https://avatars.githubusercontent.com/u/7645683?v=4","gravatar_id":"","url":"https://api.github.com/users/bruvzg","html_url":"https://github.com/bruvzg","followers_url":"https://api.github.com/users/bruvzg/followers","following_url":"https://api.github.com/users/bruvzg/following{/other_user}","gists_url":"https://api.github.com/users/bruvzg/gists{/gist_id}","starred_url":"https://api.github.com/users/bruvzg/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/bruvzg/subscriptions","organizations_url":"https://api.github.com/users/bruvzg/orgs","repos_url":"https://api.github.com/users/bruvzg/repos","events_url":"https://api.github.com/users/bruvzg/events{/privacy}","received_events_url":"https://api.github.com/users/bruvzg/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-11-05T07:36:19Z","updated_at":"2025-11-05T07:36:19Z","body":"With update FreeType and manually configured `Inter+NotoColorEmoji` (with system fallback disabled), both sequences also rendered correctly:\n\n<img width=\"401\" height=\"158\" alt=\"Image\" src=\"https://github.com/user-attachments/assets/5c6ea06d-1fa0-4c19-b7da-438a95f9e6e1\" />","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3489753195/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3490039733","html_url":"https://github.com/godotengine/godot/issues/112394#issuecomment-3490039733","issue_url":"https://api.github.com/repos/godotengine/godot/issues/112394","id":3490039733,"node_id":"IC_kwDOAO6SJc7QBce1","user":{"login":"bruvzg","id":7645683,"node_id":"MDQ6VXNlcjc2NDU2ODM=","avatar_url":"https://avatars.githubusercontent.com/u/7645683?v=4","gravatar_id":"","url":"https://api.github.com/users/bruvzg","html_url":"https://github.com/bruvzg","followers_url":"https://api.github.com/users/bruvzg/followers","following_url":"https://api.github.com/users/bruvzg/following{/other_user}","gists_url":"https://api.github.com/users/bruvzg/gists{/gist_id}","starred_url":"https://api.github.com/users/bruvzg/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/bruvzg/subscriptions","organizations_url":"https://api.github.com/users/bruvzg/orgs","repos_url":"https://api.github.com/users/bruvzg/repos","events_url":"https://api.github.com/users/bruvzg/events{/privacy}","received_events_url":"https://api.github.com/users/bruvzg/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-11-05T09:04:52Z","updated_at":"2025-11-05T09:04:52Z","body":"> Linux Mint 22.2 Cinnamon 6.4.8\n\nThis might be a distro specific font fallback issue. Godot editor attempt to load the following emoji fonts directly:\n```\n\t\"Apple Color Emoji\",\n\t\"Segoe UI Emoji\",\n\t\"Noto Color Emoji\",\n\t\"Twitter Color Emoji\",\n\t\"OpenMoji\",\n\t\"EmojiOne Color\"\n```\nAnd then request `fontconfig` for a fallback fonts if everything else fails. It is possible that emoji font on your system have different name, and `fontconfig` is not returning it when Godot is requesting fallbacks for \"Inter\", but do when requesting fallback for \"Noto Sans\" (since it's also part of Noto family for example).","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3490039733/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3490531329","html_url":"https://github.com/godotengine/godot/issues/112394#issuecomment-3490531329","issue_url":"https://a