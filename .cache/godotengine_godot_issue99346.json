ode_id":"MDU6TGFiZWwyNzkwOTgyMTk=","url":"https://api.github.com/repos/godotengine/godot/labels/topic:editor","name":"topic:editor","color":"ffee88","default":false,"description":"","archived_at":null,"archived_by":null},{"id":1332303119,"node_id":"MDU6TGFiZWwxMzMyMzAzMTE5","url":"https://api.github.com/repos/godotengine/godot/labels/regression","name":"regression","color":"ff63ac","default":false,"description":"","archived_at":null,"archived_by":null}],"state":"closed","locked":false,"assignees":[],"milestone":null,"comments":2,"created_at":"2024-11-17T04:05:07Z","updated_at":"2024-11-18T11:05:51Z","closed_at":"2024-11-18T11:05:39Z","assignee":null,"author_association":"NONE","issue_field_values":[],"type":null,"active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"### Tested versions\n\nGodot 4.4 Dev 4  36e6207bb48fafd43b98a458d0c461ad982b4e68\r\n\r\nhttps://github.com/godotengine/godot/commit/36e6207bb48fafd43b98a458d0c461ad982b4e68\r\n\r\nNot present in 4.3\n\n### System information\n\nWindos 11 24H2 Intel 13900HX CPU, Nvidia 4080 RTX\n\n### Issue description\n\nWhen using the menu option, Editor->Manage Editor Features. Create a new profile. I named mine 2D Games. In the left hand box, Configure Selected Profile under Main Features, uncheck AssetLib and then click OK. I expect the AssetLib option at the top of the editor to be removed. In 4.4 Dev 4 it remains on the screen and now when creating new scenes and trying to add nodes the node selection box doesn't popup so you can't select a node. If you click 2D Scene, 3D Scene, or User Interface it will be created and added to the scene but the only options for the node are Attach Script, Copy Node Path, and Open Documentation. You can't add any other nodes to it.\n\n### Steps to reproduce\n\n1. 4.4 Dev Create a new project\r\n2. In the menu select editor->manage editor features\r\n3. Create a new profile\r\n4. In the Left Box \"Configure Selected Profile\"\r\n5. Under \"Main Features\"\r\n6. Uncheck AssetLib\n\n### Minimal reproduction project (MRP)\n\n[mrproject.zip](https://github.com/user-attachments/files/17788810/mrproject.zip)\r\nI'm not sure if this project will actually be useful. I don't think the editor features profile is contained within so you'll have to create one.","closed_by":{"login":"AThousandShips","id":96648715,"node_id":"U_kgDOBcK-Cw","avatar_url":"https://avatars.githubusercontent.com/u/96648715?v=4","gravatar_id":"","url":"https://api.github.com/users/AThousandShips","html_url":"https://github.com/AThousandShips","followers_url":"https://api.github.com/users/AThousandShips/followers","following_url":"https://api.github.com/users/AThousandShips/following{/other_user}","gists_url":"https://api.github.com/users/AThousandShips/gists{/gist_id}","starred_url":"https://api.github.com/users/AThousandShips/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/AThousandShips/subscriptions","organizations_url":"https://api.github.com/users/AThousandShips/orgs","repos_url":"https://api.github.com/users/AThousandShips/repos","events_url":"https://api.github.com/users/AThousandShips/events{/privacy}","received_events_url":"https://api.github.com/users/AThousandShips/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/99346/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/godotengine/godot/issues/99346/timeline","performed_via_github_app":null,"state_reason":"completed","pinned_comment":null}