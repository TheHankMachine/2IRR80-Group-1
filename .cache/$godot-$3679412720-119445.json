[{"id":4287311119,"node_id":"PRR_kwDOAO6SJc7_iy0P","state":"COMMENTED","commit_id":"c72aca202c9c7b82edbdbc7b64be20d1ede44163","user":{"site_admin":false,"suspended":false,"updated_at":"0001-01-01T00:00:00Z","avatar_url":"https://avatars.githubusercontent.com/u/4701338?u=4a42fd867f2c449fcc23adf635dd574dae98e6c2&v=4","created_at":"0001-01-01T00:00:00Z","followers":0,"following":0,"html_url":"https://github.com/akien-mga","id":4701338,"node_id":"MDQ6VXNlcjQ3MDEzMzg=","login":"akien-mga","type":"User","owned_private_repos":0,"public_gists":0,"public_repos":0,"total_private_repos":0,"url":"https://api.github.com/users/akien-mga"},"body":"","html_url":"https://github.com/godotengine/godot/pull/119445#pullrequestreview-4287311119","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/119445","author_association":"MEMBER","submitted_at":"2026-05-14T04:43:56Z"},{"id":4291104221,"node_id":"PRR_kwDOAO6SJc7_xQ3d","state":"COMMENTED","commit_id":"c72aca202c9c7b82edbdbc7b64be20d1ede44163","user":{"site_admin":false,"suspended":false,"updated_at":"0001-01-01T00:00:00Z","avatar_url":"https://avatars.githubusercontent.com/u/60024671?u=7e327c81e8a9552ea98ca69adcccac4a50657dd9&v=4","created_at":"0001-01-01T00:00:00Z","followers":0,"following":0,"html_url":"https://github.com/DeeJayLSP","id":60024671,"node_id":"MDQ6VXNlcjYwMDI0Njcx","login":"DeeJayLSP","type":"User","owned_private_repos":0,"public_gists":0,"public_repos":0,"total_private_repos":0,"url":"https://api.github.com/users/DeeJayLSP"},"body":"","html_url":"https://github.com/godotengine/godot/pull/119445#pullrequestreview-4291104221","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/119445","author_association":"CONTRIBUTOR","submitted_at":"2026-05-14T15:17:30Z"},{"id":4293022286,"node_id":"PRR_kwDOAO6SJc7_4lJO","state":"CHANGES_REQUESTED","commit_id":"1ade2b8e517f7f0e404afd5dd90962e34d92b4aa","user":{"site_admin":false,"suspended":false,"updated_at":"0001-01-01T00:00:00Z","avatar_url":"https://avatars.githubusercontent.com/u/17489292?u=34072b401722100a7c0c0d61e37b376cf22b4545&v=4","created_at":"0001-01-01T00:00:00Z","followers":0,"following":0,"html_url":"https://github.com/Repiteo","id":17489292,"node_id":"MDQ6VXNlcjE3NDg5Mjky","login":"Repiteo","type":"User","owned_private_repos":0,"public_gists":0,"public_repos":0,"total_private_repos":0,"url":"https://api.github.com/users/Repiteo"},"body":"I don't think we should be unilaterally suppressing a warning when only a single scenario is triggering it. I'd sooner recommend suppressing the warning within the macro itself:\r\n```diff\r\ndiff --git a/core/typedefs.h b/core/typedefs.h\r\nindex 91f5fda2ec5..1195379fb33 100644\r\n--- a/core/typedefs.h\r\n+++ b/core/typedefs.h\r\n@@ -339,8 +339,10 @@ constexpr bool is_fully_defined_v = is_fully_defined<T>::value;\r\n /// This can be used to reduce include coupling and keep compile times low.\r\n /// The check must be made at the top of the corresponding .cpp file of a header.\r\n #define STATIC_ASSERT_INCOMPLETE_TYPE(m_keyword, m_type) \\\r\n+\tGODOT_GCC_WARNING_PUSH_AND_IGNORE(\"-Wsfinae-incomplete\") \\\r\n \tm_keyword m_type; \\\r\n-\tstatic_assert(!is_fully_defined_v<m_type>, #m_type \" was unexpectedly fully defined. Please check the include hierarchy of '\" __FILE__ \"' and remove includes that resolve the \" #m_keyword \".\");\r\n+\tstatic_assert(!is_fully_defined_v<m_type>, #m_type \" was unexpectedly fully defined. Please check the include hierarchy of '\" __FILE__ \"' and remove includes that resolve the \" #m_keyword \".\"); \\\r\n+\tGODOT_GCC_WARNING_POP\r\n #else\r\n #define STATIC_ASSERT_INCOMPLETE_TYPE(m_keyword, m_type)\r\n #endif\r\n```\r\n(This is assuming that the warning is suppressable during SFINAE. If not, disregard)","html_url":"https://github.com/godotengine/godot/pull/119445#pullrequestreview-4293022286","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/119445","author_association":"CONTRIBUTOR","submitted_at":"2026-05-14T20:00:38Z"},{"id":4293124561,"node_id":"PRR_kwDOAO6SJc7_4-HR","state":"APPROVED","commit_id":"1ade2b8e517f7f0e404afd5dd90962e34d92b4aa","user":{"site_admin":false,"suspended":false,"updated_at":"0001-01-01T00:00:00Z","avatar_url":"https://avatars.githubusercontent.com/u/17489292?u=34072b401722100a7c0c0d61e37b376cf22b4545&v=4","created_at":"0001-01-01T00:00:00Z","followers":0,"following":0,"html_url":"https://github.com/Repiteo","id":17489292,"node_id":"MDQ6VXNlcjE3NDg5Mjky","login":"Repiteo","type":"User","owned_private_repos":0,"public_gists":0,"public_repos":0,"total_private_repos":0,"url":"https://api.github.com/users/Repiteo"},"body":"","html_url":"https://github.com/godotengine/godot/pull/119445#pullrequestreview-4293124561","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/119445","author_association":"CONTRIBUTOR","submitted_at":"2026-05-14T20:16:31Z"},{"id":4293150522,"node_id":"PRR_kwDOAO6SJc7_5Ec6","state":"APPROVED","commit_id":"1ade2b8e517f7f0e404afd5dd90962e34d92b4aa","user":{"site_admin":false,"suspended":false,"updated_at":"0001-01-01T00:00:00Z","avatar_url":"https://avatars.githubusercontent.com/u/4701338?u=4a42fd867f2c449fcc23adf635dd574dae98e6c2&v=4","created_at":"0001-01-01T00:00:00Z","followers":0,"following":0,"html_url":"https://github.com/akien-mga","id":4701338,"node_id":"MDQ6VXNlcjQ3MDEzMzg=","login":"akien-mga","type":"User","owned_private_repos":0,"public_gists":0,"public_repos":0,"total_private_repos":0,"url":"https://api.github.com/users/akien-mga"},"body":"","html_url":"https://github.com/godotengine/godot/pull/119445#pullrequestreview-4293150522","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/119445","author_association":"MEMBER","submitted_at":"2026-05-14T20:20:12Z"}]