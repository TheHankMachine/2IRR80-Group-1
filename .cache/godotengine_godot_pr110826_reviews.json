.com/godotengine/godot/pull/110826#pullrequestreview-3258807571"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/110826"}},"submitted_at":"2025-09-23T16:30:48Z","commit_id":null},{"id":3258983025,"node_id":"PRR_kwDOAO6SJc7CQCJx","user":{"login":"Repiteo","id":17489292,"node_id":"MDQ6VXNlcjE3NDg5Mjky","avatar_url":"https://avatars.githubusercontent.com/u/17489292?u=34072b401722100a7c0c0d61e37b376cf22b4545&v=4","gravatar_id":"","url":"https://api.github.com/users/Repiteo","html_url":"https://github.com/Repiteo","followers_url":"https://api.github.com/users/Repiteo/followers","following_url":"https://api.github.com/users/Repiteo/following{/other_user}","gists_url":"https://api.github.com/users/Repiteo/gists{/gist_id}","starred_url":"https://api.github.com/users/Repiteo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Repiteo/subscriptions","organizations_url":"https://api.github.com/users/Repiteo/orgs","repos_url":"https://api.github.com/users/Repiteo/repos","events_url":"https://api.github.com/users/Repiteo/events{/privacy}","received_events_url":"https://api.github.com/users/Repiteo/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"A little clunky to have a conditional to dead code if verbosity is disabled, but that's part of a broader problem with the print error macros not having conditional equivalents & outside this PR's scope","state":"APPROVED","html_url":"https://github.com/godotengine/godot/pull/110826#pullrequestreview-3258983025","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/110826","author_association":"CONTRIBUTOR","_links":{"html":{"href":"https://github.com/godotengine/godot/pull/110826#pullrequestreview-3258983025"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/110826"}},"submitted_at":"2025-09-23T17:26:30Z","commit_id":null},{"id":3259046232,"node_id":"PRR_kwDOAO6SJc7CQRlY","user":{"login":"Repiteo","id":17489292,"node_id":"MDQ6VXNlcjE3NDg5Mjky","avatar_url":"https://avatars.githubusercontent.com/u/17489292?u=34072b401722100a7c0c0d61e37b376cf22b4545&v=4","gravatar_id":"","url":"https://api.github.com/users/Repiteo","html_url":"https://github.com/Repiteo","followers_url":"https://api.github.com/users/Repiteo/followers","following_url":"https://api.github.com/users/Repiteo/following{/other_user}","gists_url":"https://api.github.com/users/Repiteo/gists{/gist_id}","starred_url":"https://api.github.com/users/Repiteo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Repiteo/subscriptions","organizations_url":"https://api.github.com/users/Repiteo/orgs","repos_url":"https://api.github.com/users/Repiteo/repos","events_url":"https://api.github.com/users/Repiteo/events{/privacy}","received_events_url":"https://api.github.com/users/Repiteo/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"Actually, off the heels of #107721, these changes would make a *lot* of files have an implicit `ustring.h` dependency, and risks circular dependencies with `span.h`. Wish I caught this sooner, because we can actually simplify it *even further* with more forward-declares:\r\n```diff\r\n core/string/print_string.h | 5 +++--\r\n 1 file changed, 3 insertions(+), 2 deletions(-)\r\n\r\ndiff --git a/core/string/print_string.h b/core/string/print_string.h\r\nindex 7f44e8a5eb..302d657993 100644\r\n--- a/core/string/print_string.h\r\n+++ b/core/string/print_string.h\r\n@@ -30,8 +30,9 @@\r\n \r\n #pragma once\r\n \r\n-#include \"core/string/ustring.h\"\r\n-\r\n+template <typename T>\r\n+class Span;\r\n+class String;\r\n class Variant;\r\n \r\n extern void (*_print_func)(String);\r\n```\r\nThe way this is spread out is really ugly and warrants a dedicated pass to consolidate this print/error logic, but this should be an acceptable stopgap","state":"CHANGES_REQUESTED","html_url":"https://github.com/godotengine/godot/pull/110826#pullrequestreview-3259046232","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/110826","author_association":"CONTRIBUTOR","_links":{"html":{"href":"https://github.com/godotengine/godot/pull/110826#pullrequestreview-3259046232"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/110826"}},"submitted_at":"2025-09-23T17:48:05Z","commit_id":null},{"id":3259088972,"node_id":"PRR_kwDOAO6SJc7CQcBM","user":{"login":"Repiteo","id":17489292,"node_id":"MDQ6VXNlcjE3NDg5Mjky","avatar_url":"https://avatars.githubusercontent.com/u/17489292?u=34072b401722100a7c0c0d61e37b376cf22b4545&v=4","gravatar_id":"","url":"https://api.github.com/users/Repiteo","html_url":"https://github.com/Repiteo","followers_url":"https://api.github.com/users/Repiteo/followers","following_url":"https://api.github.com/users/Repiteo/following{/other_user}","gists_url":"https://api.github.com/users/Repiteo/gists{/gist_id}","starred_url":"https://api.github.com/users/Repiteo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Repiteo/subscriptions","organizations_url":"https://api.github.com/users/Repiteo/orgs","repos_url":"https://api.github.com/users/Repiteo/repos","events_url":"https://api.github.com/users/Repiteo/events{/privacy}","received_events_url":"https://api.github.com/users/Repiteo/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"The only thing that would prevent is including `print_string.h` in `error_macros.h` directly, so it should be fine for now","state":"APPROVED","html_url":"https://github.com/godotengine/godot/pull/110826#pullrequestreview-3259088972","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/110826","author_association":"CONTRIBUTOR","_links":{"html":{"href":"https://github.com/godotengine/godot/pull/110826#pullrequestreview-3259088972"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/110826"}},"submitted_at":"2025-09-23T18:01:28Z","commit_id":null}]