navoidable here, but worth further examination.\r\n\r\nThe solution I started using in spatial entities may provide a way forward. This is something I want to start using more broadly and possibly retrofit in a few other places (the way we do binding modifiers is similar to what you're doing here and would benefit from the same upgrade). ","html_url":"https://github.com/godotengine/godot/pull/109431#pullrequestreview-3302682408","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/109431","author_association":"CONTRIBUTOR","submitted_at":"2025-10-06T01:46:57Z"},{"id":3302722710,"node_id":"PRR_kwDOAO6SJc7E24yW","state":"COMMENTED","user":{"site_admin":false,"suspended":false,"updated_at":"0001-01-01T00:00:00Z","avatar_url":"https://avatars.githubusercontent.com/u/191561?v=4","created_at":"0001-01-01T00:00:00Z","followers":0,"following":0,"html_url":"https://github.com/dsnopek","id":191561,"node_id":"MDQ6VXNlcjE5MTU2MQ==","login":"dsnopek","type":"User","owned_private_repos":0,"public_gists":0,"public_repos":0,"total_private_repos":0,"url":"https://api.github.com/users/dsnopek"},"body":"","html_url":"https://github.com/godotengine/godot/pull/109431#pullrequestreview-3302722710","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/109431","author_association":"CONTRIBUTOR","submitted_at":"2025-10-06T02:38:38Z"},{"id":3347575972,"node_id":"PRR_kwDOAO6SJc7Hh_Sk","state":"COMMENTED","user":{"site_admin":false,"suspended":false,"updated_at":"0001-01-01T00:00:00Z","avatar_url":"https://avatars.githubusercontent.com/u/1945449?u=96b5dc9be2859dca5f31314c87d99a68a21e1576&v=4","created_at":"0001-01-01T00:00:00Z","followers":0,"following":0,"html_url":"https://github.com/BastiaanOlij","id":1945449,"node_id":"MDQ6VXNlcjE5NDU0NDk=","login":"BastiaanOlij","type":"User","owned_private_repos":0,"public_gists":0,"public_repos":0,"total_private_repos":0,"url":"https://api.github.com/users/BastiaanOlij"},"body":"","html_url":"https://github.com/god