/godot/pulls/comments/3634692607"},"html":{"href":"https://github.com/godotengine/godot/pull/121656#discussion_r3634692607"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/121656"}},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/3634692607/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":477,"start_side":"RIGHT","line":null,"original_line":478,"side":"RIGHT","author_association":"CONTRIBUTOR","original_position":3,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/3634720134","pull_request_review_id":4759744084,"id":3634720134,"node_id":"PRRC_kwDOAO6SJc7YpW2G","diff_hunk":"@@ -476,7 +476,7 @@ void EditorInspectorPluginMaterial::_undo_redo_inspector_callback(Object *p_undo\n \n \t// For BaseMaterial3D, if a roughness or metallic textures is being assigned to an empty slot,\n \t// set the respective metallic or roughness factor to 1.0 as a convenience feature\n-\tBaseMaterial3D *base_material = Object::cast_to<StandardMaterial3D>(p_edited);\n+\tBaseMaterial3D *base_material = Object::cast_to<BaseMaterial3D>(p_edited);","path":"editor/scene/material_editor_plugin.cpp","commit_id":"ac9fa50c9ecbf4af503fd09bab119691b54ca8ea","original_commit_id":"96c4caf38c0226ea4008922d402b490fd768d8bb","user":{"login":"Meorge","id":9957987,"node_id":"MDQ6VXNlcjk5NTc5ODc=","avatar_url":"https://avatars.githubusercontent.com/u/9957987?v=4","gravatar_id":"","url":"https://api.github.com/users/Meorge","html_url":"https://github.com/Meorge","followers_url":"https://api.github.com/users/Meorge/followers","following_url":"https://api.github.com/users/Meorge/following{/other_user}","gists_url":"https://api.github.com/users/Meorge/gists{/gist_id}","starred_url":"https://api.github.com/users/Meorge/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Meorge/subscriptions","organizations_url":"https://api.github.com/users/Meorge/orgs","repos_url":"https://api.github.com/users/Meorge/repos","events_url":"https://api.github.com/users/Meorge/events{/privacy}","received_events_url":"https://api.github.com/users/Meorge/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"Someone with more C++ experience than myself may be able to offer more insight here. I'm a bit worried that changing this cast could introduce issues in an edge case where someone subclasses `BaseMaterial3D` and gives it properties named `roughness_texture`, `metallic_texture`, or `orm_texture`, but they do _not_ also give it properties named `roughness`, `metallic`, and `ao_enabled`. The `if (base_material)` and `if (texture)` checks would pass, and so would the `if (p_property = \"...\")` checks, but the `add_do_property()` (and similar later calls within those blocks) would be addressing nonexistent properties.\n\nI'm not sure how Godot handles assigning to nonexistent properties like this. If it just ends up being a no-op then I think it would be fine, but if it throws errors then we may want to cast the material to the specific subclass (`StandardMaterial3D` or `ORMMaterial3D`) and check if that cast is valid before performing operations on specific properties.","created_at":"2026-07-23T00:00:03Z","updated_at":"2026-07-23T00:01:49Z","html_url":"https://github.com/godotengine/godot/pull/121656#discussion_r3634720134","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/121656","_links":{"self":{"href":"https://api.github.com/repos/godotengine/godot/pulls/comments/3634720134"},"html":{"href":"https://github.com/godotengine/godot/pull/121656#discussion_r3634720134"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/121656"}},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/3634720134/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confu