[{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5036874395","html_url":"https://github.com/godotengine/godot/pull/121599#issuecomment-5036874395","issue_url":"https://api.github.com/repos/godotengine/godot/issues/121599","id":5036874395,"node_id":"IC_kwDOAO6SJc8AAAABLDiamw","user":{"login":"bluebirdsan","id":60063904,"node_id":"MDQ6VXNlcjYwMDYzOTA0","avatar_url":"https://avatars.githubusercontent.com/u/60063904?v=4","gravatar_id":"","url":"https://api.github.com/users/bluebirdsan","html_url":"https://github.com/bluebirdsan","followers_url":"https://api.github.com/users/bluebirdsan/followers","following_url":"https://api.github.com/users/bluebirdsan/following{/other_user}","gists_url":"https://api.github.com/users/bluebirdsan/gists{/gist_id}","starred_url":"https://api.github.com/users/bluebirdsan/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/bluebirdsan/subscriptions","organizations_url":"https://api.github.com/users/bluebirdsan/orgs","repos_url":"https://api.github.com/users/bluebirdsan/repos","events_url":"https://api.github.com/users/bluebirdsan/events{/privacy}","received_events_url":"https://api.github.com/users/bluebirdsan/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-07-21T17:09:36Z","updated_at":"2026-07-21T17:09:36Z","body":"Sorry for taking a while! But I found another problem: when deleting a folder itself, then the \"file_removed\" signal is not emitted. So probably there's a bug in `DependencyRemoveDialog::ok_pressed()` where when removing a folder, it doesn't emit the signal for removing folder's files. Will investigate more.","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5036874395/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5037123879","html_url":"https://github.com/godotengine/godot/pull/121599#issuecomment-5037123879","issue_url":"https://api.github.com/repos/godotengine/godot/issues/121599","id":5037123879,"node_id":"IC_kwDOAO6SJc8AAAABLDxpJw","user":{"login":"bluebirdsan","id":60063904,"node_id":"MDQ6VXNlcjYwMDYzOTA0","avatar_url":"https://avatars.githubusercontent.com/u/60063904?v=4","gravatar_id":"","url":"https://api.github.com/users/bluebirdsan","html_url":"https://github.com/bluebirdsan","followers_url":"https://api.github.com/users/bluebirdsan/followers","following_url":"https://api.github.com/users/bluebirdsan/following{/other_user}","gists_url":"https://api.github.com/users/bluebirdsan/gists{/gist_id}","starred_url":"https://api.github.com/users/bluebirdsan/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/bluebirdsan/subscriptions","organizations_url":"https://api.github.com/users/bluebirdsan/orgs","repos_url":"https://api.github.com/users/bluebirdsan/repos","events_url":"https://api.github.com/users/bluebirdsan/events{/privacy}","received_events_url":"https://api.github.com/users/bluebirdsan/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-07-21T17:35:57Z","updated_at":"2026-07-21T17:35:57Z","body":"Changed signal to \"resource_removed\" so that this works even when a folder itself is deleted.\r\n\r\nA bit unrelated, but when doing changes while GitHub Workflow checks are running should I wait before they are completed or can I push changes without waiting? (Don't want to break things :D )","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5037123879/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5047968699","html_url":"https://github.com/godotengine/godot/pull/121599#issuecomment-5047968699","issue_url":"https://api.github.com/repos/godotengine/godot/issues/121599","id":5047968699,"node_id":"IC_kwDOAO6SJc8AAAABLOHjuw","user":{"login":"KoBeWi","id":2223172,"node_id":"MDQ6VXNlcjIyMjMxNzI=","avatar_url":"https://avatars.githubusercontent.com/u/2223172?v=4","gravatar_id":"","url":"https://api.github.com/users/KoBeWi","html_url":"https://github.com/KoBeWi","followers_url":"https://api.github.com/users/KoBeWi/followers","following_url":"https://api.github.com/users/KoBeWi/following{/other_user}","gists_url":"https://api.github.com/users/KoBeWi/gists{/gist_id}","starred_url":"https://api.github.com/users/KoBeWi/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/KoBeWi/subscriptions","organizations_url":"https://api.github.com/users/KoBeWi/orgs","repos_url":"https://api.github.com/users/KoBeWi/repos","events_url":"https://api.github.com/users/KoBeWi/events{/privacy}","received_events_url":"https://api.github.com/users/KoBeWi/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-07-22T15:15:28Z","updated_at":"2026-07-22T15:15:28Z","body":"Seems like `resource_removed` is unreliable. The resource has to be currently loaded for it to emit, but the Audio dock does not actually load the resource. You can still reproduce the bug when you use Save As to save the bus layout and then immediately delete the file.\r\n\r\nFixing it is probably out of scope for this PR though.","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5047968699/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5048034724","html_url":"https://github.com/godotengine/godot/pull/121599#issuecomment-5048034724","issue_url":"https://api.github.c