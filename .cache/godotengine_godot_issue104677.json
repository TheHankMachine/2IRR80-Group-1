8AAAAB4iS2Xw","url":"https://api.github.com/repos/godotengine/godot/labels/cherrypick:4.4","name":"cherrypick:4.4","color":"446699","default":false,"description":"Considered for cherry-picking into a future 4.4.x release","archived_at":null,"archived_by":null}],"state":"closed","locked":false,"assignees":[],"milestone":{"url":"https://api.github.com/repos/godotengine/godot/milestones/22","html_url":"https://github.com/godotengine/godot/milestone/22","labels_url":"https://api.github.com/repos/godotengine/godot/milestones/22/labels","id":12070367,"node_id":"MI_kwDOAO6SJc4AuC3f","number":22,"title":"4.5","description":"","creator":{"login":"Sauermann","id":6299227,"node_id":"MDQ6VXNlcjYyOTkyMjc=","avatar_url":"https://avatars.githubusercontent.com/u/6299227?v=4","gravatar_id":"","url":"https://api.github.com/users/Sauermann","html_url":"https://github.com/Sauermann","followers_url":"https://api.github.com/users/Sauermann/followers","following_url":"https://api.github.com/users/Sauermann/following{/other_user}","gists_url":"https://api.github.com/users/Sauermann/gists{/gist_id}","starred_url":"https://api.github.com/users/Sauermann/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Sauermann/subscriptions","organizations_url":"https://api.github.com/users/Sauermann/orgs","repos_url":"https://api.github.com/users/Sauermann/repos","events_url":"https://api.github.com/users/Sauermann/events{/privacy}","received_events_url":"https://api.github.com/users/Sauermann/received_events","type":"User","user_view_type":"public","site_admin":false},"open_issues":3,"closed_issues":3687,"state":"closed","created_at":"2024-12-19T08:51:28Z","updated_at":"2026-09-04T21:48:38Z","due_on":"2025-09-15T00:00:00Z","closed_at":"2025-09-18T17:13:14Z"},"comments":1,"created_at":"2025-03-27T02:14:41Z","updated_at":"2025-03-28T14:07:53Z","closed_at":"2025-03-28T13:39:43Z","assignee":null,"author_association":"MEMBER","issue_field_values":[],"type":null,"active_lock_reason":null,"draft":false,"pull_request":{"url":"https://api.github.com/repos/godotengine/godot/pulls/104677","html_url":"https://github.com/godotengine/godot/pull/104677","diff_url":"https://github.com/godotengine/godot/pull/104677.diff","patch_url":"https://github.com/godotengine/godot/pull/104677.patch","merged_at":"2025-03-28T13:39:43Z"},"body":"Fixes #104665.\r\n\r\nTileMapLayer's `self_modulate` was being applied:\r\n- for each tile drawing command,\r\n- for each quadrants' canvas item (used for drawing tiles), but only on specific rendering changes (not when creating such canvas items):\r\nhttps://github.com/godotengine/godot/blob/594d64ec244b6b99321e2096987d4d69de4c8845/scene/2d/tile_map_layer.cpp#L376-L390\r\n\r\n#104665 revealed the bug because the specific steps to reproduce resulted in changes to `self_modulate` updating only the quadrants' canvas items' `self_modulate`. The tile drawing commands were not being reissued (as not needed / nothing changed), hence they were still using old `self_modulate` when such draw commands were issued (specifically `0.0`, hence tiles ended up invisible).\r\n\r\nThis PR removes modulation argument from `TileMapLayer::draw_tile` as not needed / unused, `self_modulate` is now applied only per quadrants' canvas items (including on creation).","closed_by":{"login":"akien-mga","id":4701338,"node_id":"MDQ6VXNlcjQ3MDEzMzg=","avatar_url":"https://avatars.githubusercontent.com/u/4701338?v=4","gravatar_id":"","url":"https://api.github.com/users/akien-mga","html_url":"https://github.com/akien-mga","followers_url":"https://api.github.com/users/akien-mga/followers","following_url":"https://api.github.com/users/akien-mga/following{/other_user}","gists_url":"https://api.github.com/users/akien-mga/gists{/gist_id}","starred_url":"https://api.github.com/users/akien-mga/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/akien-mga/subscriptions","organizations_url":"https://api.github.com/users/akien-mga/orgs","repos_url":"https://api.github.com/users/akien-mga/repos","events_url":"https://api.github.com/users/akien-mga/events{/privacy}","received_events_url":"https://api.github.com/users/akien-mga/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/104677/reactions","total_count":1,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":1},"timeline_url":"https://api.github.com/repos/godotengine/godot/issues/104677/timeline","performed_via_github_app":null,"state_reason":null}