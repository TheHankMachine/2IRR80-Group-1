 height=\"412\" alt=\"image\" src=\"https://github.com/user-attachments/assets/6c145cf7-33f0-4cfc-a25a-98b98b83c1fa\" />\r\n\r\nAnd after the change:\r\n<img width=\"1364\" height=\"415\" alt=\"image\" src=\"https://github.com/user-attachments/assets/9d0ad5c2-77c6-4222-9514-399efbb04bdf\" />\r\n","author_association":"NONE","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3146396220/reactions","total_count":2,"+1":2,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3146397773","html_url":"https://github.com/godotengine/godot/pull/109222#issuecomment-3146397773","issue_url":"https://api.github.com/repos/godotengine/godot/issues/109222","id":3146397773,"node_id":"IC_kwDOAO6SJc67ijhN","user":{"login":"AThousandShips","id":96648715,"node_id":"U_kgDOBcK-Cw","avatar_url":"https://avatars.githubusercontent.com/u/96648715?v=4","gravatar_id":"","url":"https://api.github.com/users/AThousandShips","html_url":"https://github.com/AThousandShips","followers_url":"https://api.github.com/users/AThousandShips/followers","following_url":"https://api.github.com/users/AThousandShips/following{/other_user}","gists_url":"https://api.github.com/users/AThousandShips/gists{/gist_id}","starred_url":"https://api.github.com/users/AThousandShips/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/AThousandShips/subscriptions","organizations_url":"https://api.github.com/users/AThousandShips/orgs","repos_url":"https://api.github.com/users/AThousandShips/repos","events_url":"https://api.github.com/users/AThousandShips/events{/privacy}","received_events_url":"https://api.github.com/users/AThousandShips/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-08-02T09:47:28Z","updated_at":"2025-08-02T09:47:28Z","body":"That's good! Now the question is if the naming 