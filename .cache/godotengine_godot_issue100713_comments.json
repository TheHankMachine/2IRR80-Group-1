thub.com/users/deralmas/following{/other_user}","gists_url":"https://api.github.com/users/deralmas/gists{/gist_id}","starred_url":"https://api.github.com/users/deralmas/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/deralmas/subscriptions","organizations_url":"https://api.github.com/users/deralmas/orgs","repos_url":"https://api.github.com/users/deralmas/repos","events_url":"https://api.github.com/users/deralmas/events{/privacy}","received_events_url":"https://api.github.com/users/deralmas/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-01-20T00:28:08Z","updated_at":"2025-01-20T00:28:08Z","body":"Hi, thank you for your report! I'm currently looking into it. It looks like some keys are getting \"stuck\" for some reason.","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2601099759/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2601105902","html_url":"https://github.com/godotengine/godot/issues/100713#issuecomment-2601105902","issue_url":"https://api.github.com/repos/godotengine/godot/issues/100713","id":2601105902,"node_id":"IC_kwDOAO6SJc6bCbnu","user":{"login":"deralmas","id":31065808,"node_id":"MDQ6VXNlcjMxMDY1ODA4","avatar_url":"https://avatars.githubusercontent.com/u/31065808?v=4","gravatar_id":"","url":"https://api.github.com/users/deralmas","html_url":"https://github.com/deralmas","followers_url":"https://api.github.com/users/deralmas/followers","following_url":"https://api.github.com/users/deralmas/following{/other_user}","gists_url":"https://api.github.com/users/deralmas/gists{/gist_id}","starred_url":"https://api.github.com/users/deralmas/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/deralmas/subscriptions","organizations_url":"https://api.github.com/users/deralmas/orgs","repos_url":"https://api.github.com/users/deralmas/repos","events_url":"https://api.github.com/users/deralmas/events{/privacy}","received_events_url":"https://api.github.com/users/deralmas/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-01-20T00:36:42Z","updated_at":"2025-01-20T00:36:56Z","body":"Welp that was quick. It looks like every single key got stuck in a phantom state that apparently only specific things cared about if the window got unfocused while said keys were pressed. I assumed that the compositor would release them at the right time but I was wrong.\n\nThe fix is, like, a single line lol. PR incoming!\n\nAlso, FTR, I don't think this is a regression, I _always_ assumed this behavior :P","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2601105902/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2601112777","html_url":"https://github.com/godotengine/godot/issues/100713#issuecomment-2601112777","issue_url":"https://api.github.com/repos/godotengine/godot/issues/100713","id":2601112777,"node_id":"IC_kwDOAO6SJc6bCdTJ","user":{"login":"deralmas","id":31065808,"node_id":"MDQ6VXNlcjMxMDY1ODA4","avatar_url":"https://avatars.githubusercontent.com/u/31065808?v=4","gravatar_id":"","url":"https://api.github.com/users/deralmas","html_url":"https://github.com/deralmas","followers_url":"https://api.github.com/users/deralmas/followers","following_url":"https://api.github.com/users/deralmas/following{/other_user}","gists_url":"https://api.github.com/users/deralmas/gists{/gist_id}","starred_url":"https://api.github.com/users/deralmas/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/deralmas/subscriptions","organizations_url":"https://api.github.com/users/deralmas/orgs","repos_url":"https://api.github.com/users/deralmas/repos","events_url":"https://api.github.com/users/deralmas/events{/privacy}","received_events_url":"https://api.github.com/users/deralmas/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-01-20T00:46:24Z","updated_at":"2025-01-20T00:46:24Z","body":"The PR is in, please confirm whether that fixes the issue for you :D\n\n#101819","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2601112777/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2601632879","html_url":"https://github.com/godotengine/godot/issues/100713#issuecomment-2601632879","issue_url":"https://api.github.com/repos/godotengine/godot/issues/100713","id":2601632879,"node_id":"IC_kwDOAO6SJc6bEcRv","user":{"login":"Giganzo","id":158825920,"node_id":"U_kgDOCXd9wA","avatar_url":"https://avatars.githubusercontent.com/u/158825920?v=4","gravatar_id":"","url":"https://api.github.com/users/Giganzo","html_url":"https://github.com/Giganzo","followers_url":"https://api.github.com/users/Giganzo/followers","following_url":"https://api.github.com/users/Giganzo/following{/other_user}","gists_url":"https://api.github.com/users/Giganzo/gists{/gist_id}","starred_url":"https://api.github.com/users/Giganzo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Giganzo/subscriptions","organizations_url":"https://api.github.com/users/Giganzo/orgs","repos_url":"https://api.github.com/users/Giganzo/repos","events_url":"https://api.github.com/users/Giganzo/events{/privacy}","received_events_url":"https://api.github.com/users/Giganzo/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-01-20T07:38:43Z","updated_at":"2025-01-20T07:39:36Z","body":"> Also, FTR, I don't think this is a regression, I _always_ assumed this behavior :P\n\nI see\nBut it's strange that I cannot trigger it from 4.3 to 4.4.dev6 then. Something must have changed in dev7 to make it have this effect on tooltips now.\n\n> The PR is in, please confirm whether that fixes the issue for you :D\n\nNo still same problem. \n\nWith fix:\n\nhttps://github.com/user-attachments/assets/5d17690d-4f91-44c3-97fb-99d8498d03cf\n\n4.4.dev6:\n\nhttps://github.com/user-attachments/assets/eaa29bf3-d3c6-4a53-b3d5-2033414f7b2a\n\n\n\nThere is a difference with the fix, if I tab to another window and back the tooltips will be back. In beta1 I have to restart the editor.","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2601632879/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2602244531","html_url":"https://github.com/godotengine/godot/issues/100713#issuecomment-2602244531","issue_url":"https://api.github.com/repos/godotengine/godot/issues/100713","id":2602244531,"node_id":"IC_kwDOAO6SJc6bGxmz","user":{"login":"deralmas","id":31065808,"node_id":"MDQ6VXNlcjMxMDY1ODA4","avatar_url":"https://avatars.githubusercontent.com/u/31065808?v=4","gravatar_id":"","url":"https://api.github.com/users/deralmas","html_url":"https://github.com/deralmas","followers_url":"https://api.github.com/users/deralmas/followers","following_url":"https://api.github.com/users/deralmas/following{/other_user}","gists_url":"https://api.github.com/users/deralmas/gists{/gist_id}","starred_url":"https://api.github.com/users/deralmas/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/deralmas/subscriptions","organizations_url":"https://api.github.com/users/deralmas/orgs","repos_url":"https://api.github.com/users/deralmas/repos","events_url":"https://api.github.com/users/deralmas/events{/privacy}","received_events_url":"https://api.github.com/users/deralmas/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-01-20T12:03:53Z","updated_at":"2025-01-20T12:03:53Z","body":"@Giganzo I see, thank you for testing the change further. The fact that things work again when you focus/unfocus implies that some buttons still get stuck; not sure how though.","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2602244531/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2602363212","html_url":"https://github.com/godotengine/godot/issues/100713#issuecomment-2602363212","issue_url":"https://api.github.com/repos/godotengine/godot/issues/100713","id":2602363212,"node_id":"IC_kwDOAO6SJc6bHOlM","user":{"login":"deralmas","id":31065808,"node_id":"MDQ6VXNlcjMxMDY1ODA4","avatar_url":"https://avatars.githubusercontent.com/u/31065808?v=4","gravatar_id":"","url":"https://api.github.com/users/deralmas","html_url":"https://github.com/deralmas","followers_url":"https://api.github.com/users/deralmas/followers","following_url":"https://api.github.com/users/deralmas/following{/other_user}","gists_url":"https://api.github.com/users/deralmas/gists{/gist_id}","starred_url":"https://api.github.com/users/deralmas/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/deralmas/subscriptions","organizations_url":"https://api.github.com/users/deralmas/orgs","repos_url":"https://api.github.com/users/deralmas/repos","events_url":"https://api.github.com/users/deralmas/events{/privacy}","received_events_url":"https://api.github.com/users/deralmas/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-01-20T12:57:36Z","updated_at":"2025-01-20T13:54:52Z","body":"All right, I think I found the final culprit and it's actually quite crazy.\n\nThis diff will tell us any stuck keys:\n\n```patch\ndiff --git a/core/input/input.cpp b/core/input/input.cpp\nindex 4413c426cf..27dfeb12a5 100644\n--- a/core/input/input.cpp\n+++ b/core/input/input.cpp\n@@ -296,6 +296,22 @@ bool Input::is_anything_pressed() const {\n \t}\n \n \tif (!keys_pressed.is_empty() || !joy_buttons_pressed.is_empty() || !mouse_button_mask.is_empty()) {\n+\n+\t\tif(!keys_pressed.is_empty()) {\n+\t\t\tprint_line(\"KEYS PRESSED:\");\n+\t\t\tfor (const Key &key : keys_pressed) {\n+\t\t\t\tprint_line(key);\n+\t\t\t}\n+\t\t}\n+\n+\t\tif(!joy_buttons_pressed.is_empty()) {\n+\t\t\tprint_line(\"JOY BUTTONS PRESSED\");\n+\t\t}\n+\n+\t\tif(!mouse_button_mask.is_empty()) {\n+\t\t\tprint_line(\"MOUSE BUTTON MASK\");\n+\t\t}\n+\n \t\treturn true;\n \t}\n ```\n\nAfter some keyboard mashing it reported only `95`, which meant an underscore (`_`)\n\nI could consistently replicate the issue by:\n\n 1. Pressing `Shift` and `-`, resulting in `_`, and let the key repeat do its job for a second or so;\n 2. While keeping the `-` key pressed, releasing `Shift`, and let they key repeat do its thing a bit more;\n 3. Releasing everything.\n\nI'm quite sure this is related to #99633. That PR correctly makes keys fully Unicode aware but some code somewhere still assumes that the physical key matters, which is not always true.\n\nUpdate: I think it's the key repetition code that does not handle keyboard state changes properly.","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2602363212/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2603223020","html_url":"https://github.com/godotengine/godot/issues/100713#issuecomment-2603223020","issue_url":"https://api.github.com/repos/godotengine/godot/issues/100713","id":2603223020,"node_id":"IC_kwDOAO6SJc6bKgfs","user":{"login":"deralmas","id":31065808,"node_id":"MDQ6VXNlcjMxMDY1ODA4","avatar_url":"https://avatars.githubusercontent.com/u/31065808?v=4","gravatar_id":"","url":"https://api.github.com/users/deralmas","html_url":"https://github.com/deralmas","followers_url":"https://api.github.com/users/deralmas/followers","following_url":"https://api.github.com/users/deralmas/following{/other_user}","gists_url":"https://api.github.com/users/deralmas/gists{/gist_id}","starred_url":"https://api.github.com/users/deralmas/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/deralmas/subscriptions","organizations_url":"https://api.github.com/users/deralmas/orgs","repos_url":"https://api.github.com/users/deralmas/repos","events_url":"https://api.github.com/users/deralmas/events{/privacy}","received_events_url":"https://api.github.com/users/deralmas/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-01-20T21:00:44Z","updated_at":"2025-01-20T21:00:54Z","body":"Hi, I pushed a new update which should fix the issue once and for all: #101848\n\nSee also issue #100879.","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2603223020/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null}]