[{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2596976875","html_url":"https://github.com/godotengine/godot/issues/100713#issuecomment-2596976875","issue_url":"https://api.github.com/repos/godotengine/godot/issues/100713","id":2596976875,"node_id":"IC_kwDOAO6SJc6ayrjr","user":{"login":"Giganzo","id":158825920,"node_id":"U_kgDOCXd9wA","avatar_url":"https://avatars.githubusercontent.com/u/158825920?v=4","gravatar_id":"","url":"https://api.github.com/users/Giganzo","html_url":"https://github.com/Giganzo","followers_url":"https://api.github.com/users/Giganzo/followers","following_url":"https://api.github.com/users/Giganzo/following{/other_user}","gists_url":"https://api.github.com/users/Giganzo/gists{/gist_id}","starred_url":"https://api.github.com/users/Giganzo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Giganzo/subscriptions","organizations_url":"https://api.github.com/users/Giganzo/orgs","repos_url":"https://api.github.com/users/Giganzo/repos","events_url":"https://api.github.com/users/Giganzo/events{/privacy}","received_events_url":"https://api.github.com/users/Giganzo/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-01-16T21:52:15Z","updated_at":"2025-01-16T21:52:15Z","body":"Is this something that should be added to release blockers?\nThis bug is always triggered after working in a project and writing some amount of code. So if you need help from a tooltip you have to restart the editor to get them back.\n\n\n","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2596976875/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2597108317","html_url":"https://github.com/godotengine/godot/issues/100713#issuecomment-259710