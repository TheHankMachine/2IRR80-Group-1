"id":709269775,"node_id":"MDU6TGFiZWw3MDkyNjk3NzU=","url":"https://api.github.com/repos/godotengine/godot/labels/topic:dotnet","name":"topic:dotnet","color":"ffee88","default":false,"description":"","archived_at":null,"archived_by":null}],"state":"open","locked":false,"assignees":[],"milestone":{"url":"https://api.github.com/repos/godotengine/godot/milestones/16","html_url":"https://github.com/godotengine/godot/milestone/16","labels_url":"https://api.github.com/repos/godotengine/godot/milestones/16/labels","id":8237783,"node_id":"MI_kwDOAO6SJc4AfbLX","number":16,"title":"4.x","description":"Issues and pull requests slated for an undetermined Godot 4 release.","creator":{"login":"akien-mga","id":4701338,"node_id":"MDQ6VXNlcjQ3MDEzMzg=","avatar_url":"https://avatars.githubusercontent.com/u/4701338?v=4","gravatar_id":"","url":"https://api.github.com/users/akien-mga","html_url":"https://github.com/akien-mga","followers_url":"https://api.github.com/users/akien-mga/followers","following_url":"https://api.github.com/users/akien-mga/following{/other_user}","gists_url":"https://api.github.com/users/akien-mga/gists{/gist_id}","starred_url":"https://api.github.com/users/akien-mga/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/akien-mga/subscriptions","organizations_url":"https://api.github.com/users/akien-mga/orgs","repos_url":"https://api.github.com/users/akien-mga/repos","events_url":"https://api.github.com/users/akien-mga/events{/privacy}","received_events_url":"https://api.github.com/users/akien-mga/received_events","type":"User","user_view_type":"public","site_admin":false},"open_issues":5793,"closed_issues":0,"state":"open","created_at":"2022-07-26T12:42:05Z","updated_at":"2026-10-22T14:39:14Z","due_on":null,"closed_at":null},"comments":2,"created_at":"2025-06-15T19:01:42Z","updated_at":"2026-02-17T20:10:23Z","closed_at":null,"assignee":null,"author_association":"NONE","issue_field_values":[],"type":null,"active_lock_reason":null,"draft":false,"pull_request":{"url":"https://api.github.com/repos/godotengine/godot/pulls/107569","html_url":"https://github.com/godotengine/godot/pull/107569","diff_url":"https://github.com/godotengine/godot/pull/107569.diff","patch_url":"https://github.com/godotengine/godot/pull/107569.patch","merged_at":null},"body":"Bundling the entire .NET runtime with every game build is likely undesirable for many use cases, game distribution services (e.g. Steam) also offer the ability to automatically install the runtime along with your game which can then be shared between multiple games.\r\n\r\nThis PR introduces the option to toggle off the `self-contained` flag for `dotnet publish`, as well as modifying the logic for finding the `hostfxr` dll by always falling back to trying to find it at the .NET install location (which is the default behavior for in-engine builds).\r\n\r\nTested on Windows only, there might exist platforms for which this option makes no sense (self-contained publishing is necessary) but since it's simply a new option with the status quo as the standard value I don't think this should be too problematic.","closed_by":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/107569/reactions","total_count":7,"+1":5,"-1":0,"laugh":0,"hooray":2,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/godotengine/godot/issues/107569/timeline","performed_via_github_app":null,"state_reason":null}