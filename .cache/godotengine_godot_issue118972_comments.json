ub.com/users/lajawi/followers","following_url":"https://api.github.com/users/lajawi/following{/other_user}","gists_url":"https://api.github.com/users/lajawi/gists{/gist_id}","starred_url":"https://api.github.com/users/lajawi/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/lajawi/subscriptions","organizations_url":"https://api.github.com/users/lajawi/orgs","repos_url":"https://api.github.com/users/lajawi/repos","events_url":"https://api.github.com/users/lajawi/events{/privacy}","received_events_url":"https://api.github.com/users/lajawi/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-04-30T09:37:27Z","updated_at":"2026-04-30T09:37:27Z","body":"> Did you delete `.godot/exported` folder? The invalid scenes are cached.\n\nAaah, that did the trick indeed! I did see something similar on a different issue or pull request, but didn't remember to do it in my scenario too. It works now, thanks for the quick fix and help!","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4351341905/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null}]