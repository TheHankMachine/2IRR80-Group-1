ed_at":null,"archived_by":null}],"state":"open","locked":false,"assignees":[],"milestone":{"url":"https://api.github.com/repos/godotengine/godot/milestones/16","html_url":"https://github.com/godotengine/godot/milestone/16","labels_url":"https://api.github.com/repos/godotengine/godot/milestones/16/labels","id":8237783,"node_id":"MI_kwDOAO6SJc4AfbLX","number":16,"title":"4.x","description":"Issues and pull requests slated for an undetermined Godot 4 release.","creator":{"login":"akien-mga","id":4701338,"node_id":"MDQ6VXNlcjQ3MDEzMzg=","avatar_url":"https://avatars.githubusercontent.com/u/4701338?v=4","gravatar_id":"","url":"https://api.github.com/users/akien-mga","html_url":"https://github.com/akien-mga","followers_url":"https://api.github.com/users/akien-mga/followers","following_url":"https://api.github.com/users/akien-mga/following{/other_user}","gists_url":"https://api.github.com/users/akien-mga/gists{/gist_id}","starred_url":"https://api.github.com/users/akien-mga/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/akien-mga/subscriptions","organizations_url":"https://api.github.com/users/akien-mga/orgs","repos_url":"https://api.github.com/users/akien-mga/repos","events_url":"https://api.github.com/users/akien-mga/events{/privacy}","received_events_url":"https://api.github.com/users/akien-mga/received_events","type":"User","user_view_type":"public","site_admin":false},"open_issues":5791,"closed_issues":0,"state":"open","created_at":"2022-07-26T12:42:05Z","updated_at":"2026-10-21T22:40:26Z","due_on":null,"closed_at":null},"comments":5,"created_at":"2026-04-17T22:47:31Z","updated_at":"2026-04-19T13:08:20Z","closed_at":null,"assignee":null,"author_association":"MEMBER","issue_field_values":[],"type":null,"active_lock_reason":null,"draft":false,"pull_request":{"url":"https://api.github.com/repos/godotengine/godot/pulls/118699","html_url":"https://github.com/godotengine/godot/pull/118699","diff_url":"https://github.com/godotengine/godot/pull/118699.diff","patch_url":"https://github.com/godotengine/godot/pull/118699.patch","merged_at":null},"body":"Keep only `version.py` and the general `methods.py` top-level.\r\n\r\nThe intention is to declutter the top-level folder which I'm admittedly pretty territorial about (and @Repiteo seems to be too :D).\r\n\r\nProof of concept for now, this is not the cleanest way to deal with this in SCons (we might want to consider making better use of SCons `tools` like godot-cpp does: https://github.com/godotengine/godot-cpp/tree/master/tools ), but this might be good enough for now.\r\n\r\nI kept the `importlib` modules registered with a non-scoped identifier despite the subfolders, aside from `scu_builders.py` which I consolidated with `misc.utility.color`. This was mainly to avoid having to modify a bunch of platform code to include `platform.platform_methods` instead of `platform_methods`. It also didn't like the circular dependency between `methods.py` and `platform_methods.py` registered as a module, so I tweaked it a bit.","closed_by":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/118699/reactions","total_count":10,"+1":6,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":4},"timeline_url":"https://api.github.com/repos/godotengine/godot/issues/118699/timeline","performed_via_github_app":null,"state_reason":null}