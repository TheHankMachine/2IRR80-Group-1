_id}","starred_url":"https://api.github.com/users/TCROC/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/TCROC/subscriptions","organizations_url":"https://api.github.com/users/TCROC/orgs","repos_url":"https://api.github.com/users/TCROC/repos","events_url":"https://api.github.com/users/TCROC/events{/privacy}","received_events_url":"https://api.github.com/users/TCROC/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-01-15T22:43:31Z","updated_at":"2025-01-15T22:43:31Z","body":"Whatever the Godot powers that be command of me, I shall do 😎","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2594087022/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2594100366","html_url":"https://github.com/godotengine/godot/pull/101596#issuecomment-2594100366","issue_url":"https://api.github.com/repos/godotengine/godot/issues/101596","id":2594100366,"node_id":"IC_kwDOAO6SJc6antSO","user":{"login":"TCROC","id":24307049,"node_id":"MDQ6VXNlcjI0MzA3MDQ5","avatar_url":"https://avatars.githubusercontent.com/u/24307049?v=4","gravatar_id":"","url":"https://api.github.com/users/TCROC","html_url":"https://github.com/TCROC","followers_url":"https://api.github.com/users/TCROC/followers","following_url":"https://api.github.com/users/TCROC/following{/other_user}","gists_url":"https://api.github.com/users/TCROC/gists{/gist_id}","starred_url":"https://api.github.com/users/TCROC/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/TCROC/subscriptions","organizations_url":"https://api.github.com/users/TCROC/orgs","repos_url":"https://api.github.com/users/TCROC/repos","events_url":"https://api.github.com/users/TCROC/events{/privacy}","received_events_url":"https://api.github.com/users/TCROC/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-01-15T22:52:33Z","updated_at":"2025-01-15T22:52:33Z","body":"I do agree with @QbieShay though. I personally don't care that much about it one way or the other. Yes doing this introduces (imo) an unnecessary call to randomize the seed since this is just a setter. But I don't call set_one_shot often (never actually in my case) to care one way or the other. So I didn't bother bringing it up as I'd rather the PR just go through. But if I am to offer some input, I do agree with @QbieShay that randomizing the seed should be left to the restart method rather than this setter. In most cases, doing it here will be redundant.","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2594100366/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2594179245","html_url":"https://github.com/godotengine/godot/pull/101596#issuecomment-2594179245","issue_url":"https://api.github.com/repos/godotengine/godot/issues/101596","id":2594179245,"node_id":"IC_kwDOAO6SJc6aoAit","user":{"login":"TCROC","id":24307049,"node_id":"MDQ6VXNlcjI0MzA3MDQ5","avatar_url":"https://avatars.githubusercontent.com/u/24307049?v=4","gravatar_id":"","url":"https://api.github.com/users/TCROC","html_url":"https://github.com/TCROC","followers_url":"https://api.github.com/users/TCROC/followers","following_url":"https://api.github.com/users/TCROC/following{/other_user}","gists_url":"https://api.github.com/users/TCROC/gists{/gist_id}","starred_url":"https://api.github.com/users/TCROC/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/TCROC/subscriptions","organizations_url":"https://api.github.com/users/TCROC/orgs","repos_url":"https://api.github.com/users/TCROC/repos","events_url":"https://api.github.com/users/TCROC/events{/privacy}","received_events_url":"https://api.github.com/users/TCROC/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-01-16T00:03:30Z","updated_at":"2025-01-16T00:03:30Z","body":"So I guess with that said, @clayjohn do you like it as it is (your suggestion) or would you like me to go back to the way the pr was (@QbieShay and my suggestion).\r\n","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2594179245/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2596405186","html_url":"https://github.com/godotengine/godot/pull/101596#issuecomment-2596405186","issue_url":"https://api.github.com/repos/godotengine/godot/issues/101596","id":2596405186,"node_id":"IC_kwDOAO6SJc6awf_C","user":{"login":"QbieShay","id":7917475,"node_id":"MDQ6VXNlcjc5MTc0NzU=","avatar_url":"https://avatars.githubusercontent.com/u/7917475?v=4","gravatar_id":"","url":"https://api.github.com/users/QbieShay","html_url":"https://github.com/QbieShay","followers_url":"https://api.github.com/users/QbieShay/followers","following_url":"https://api.github.com/users/QbieShay/following{/other_user}","gists_url":"https://api.github.com/users/QbieShay/gists{/gist_id}","starred_url":"https://api.github.com/users/QbieShay/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/QbieShay/subscriptions","organizations_url":"https://api.github.com/users/QbieShay/orgs","repos_url":"https://api.github.com/users/QbieShay/repos","events_url":"https://api.github.com/users/QbieShay/events{/privacy}","received_events_url":"https://api.github.com/users/QbieShay/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-01-16T18:19:52Z","updated_at":"2025-01-16T18:19:52Z","body":"Clay and I discussed in chat https://chat.godotengine.org/channel/rendering?msg=Mgd4xD8bH3TZKrQND\r\n\r\nThe outocme is that it should be reverted to what it was before, and the seed logic shoudl be added. The same thing should be done with GPUParticles2D. I hadn't seen it when i did the PR, but they should behave the same.","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2596405186/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2596414947","html_url":"https://github.com/godotengine/godot/pull/101596#issuecomment-2596414947","issue_url":"https://api.github.com/repos/godotengine/godot/issues/101596","id":2596414947,"node_id":"IC_kwDOAO6SJc6awiXj","user":{"login":"TCROC","id":24307049,"node_id":"MDQ6VXNlcjI0MzA3MDQ5","avatar_url":"https://avatars.githubusercontent.com/u/24307049?v=4","gravatar_id":"","url":"https://api.github.com/users/TCROC","html_url":"https://github.com/TCROC","followers_url":"https://api.github.com/users/TCROC/followers","following_url":"https://api.github.com/users/TCROC/following{/other_user}","gists_url":"https://api.github.com/users/TCROC/gists{/gist_id}","starred_url":"https://api.github.com/users/TCROC/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/TCROC/subscriptions","organizations_url":"https://api.github.com/users/TCROC/orgs","repos_url":"https://api.github.com/users/TCROC/repos","events_url":"https://api.github.com/users/TCROC/events{/privacy}","received_events_url":"https://api.github.com/users/TCROC/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-01-16T18:25:30Z","updated_at":"2025-01-16T18:25:30Z","body":"> Clay and I discussed in chat https://chat.godotengine.org/channel/rendering?msg=Mgd4xD8bH3TZKrQND\r\n> \r\n> The outocme is that it should be reverted to what it was before, and the seed logic shoudl be added. The same thing should be done with GPUParticles2D. I hadn't seen it when i did the PR, but they should behave the same.\r\n\r\nI responded in that chat.  I'm looking at the old source code and I believe @clayjohn may be mistaken.  It does not look like this method ever set the seed when set_one_shot was called.  Pushing the PR through as it currently is would **actually** be changing the behavior compared to how it behaves in 4.3.","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2596414947/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2596564475","html_url":"https://github.com/godotengine/godot/pull/101596#issuecomment-2596564475","issue_url":"https://api.github.com/repos/godotengine/godot/issues/101596","id":2596564475,"node_id":"IC_kwDOAO6SJc6axG37","user":{"login":"TCROC","id":24307049,"node_id":"MDQ6VXNlcjI0MzA3MDQ5","avatar_url":"https://avatars.githubusercontent.com/u/24307049?v=4","gravatar_id":"","url":"https://api.github.com/users/TCROC","html_url":"https://github.com/TCROC","followers_url":"https://api.github.com/users/TCROC/followers","following_url":"https://api.github.com/users/TCROC/following{/other_user}","gists_url":"https://api.github.com/users/TCROC/gists{/gist_id}","starred_url":"https://api.github.com/users/TCROC/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/TCROC/subscriptions","organizations_url":"https://api.github.com/users/TCROC/orgs","repos_url":"https://api.github.com/users/TCROC/repos","events_url":"https://api.github.com/users/TCROC/events{/privacy}","received_events_url":"https://api.github.com/user