criptions_url":"https://api.github.com/users/AThousandShips/subscriptions","organizations_url":"https://api.github.com/users/AThousandShips/orgs","repos_url":"https://api.github.com/users/AThousandShips/repos","events_url":"https://api.github.com/users/AThousandShips/events{/privacy}","received_events_url":"https://api.github.com/users/AThousandShips/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-04-20T11:47:21Z","updated_at":"2025-04-20T11:47:21Z","body":"There's no need to squash until the PR is ready and approved","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2817132483/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2817134186","html_url":"https://github.com/godotengine/godot/pull/105513#issuecomment-2817134186","issue_url":"https://api.github.com/repos/godotengine/godot/issues/105513","id":2817134186,"node_id":"IC_kwDOAO6SJc6n6g5q","user":{"login":"MJacred","id":6639237,"node_id":"MDQ6VXNlcjY2MzkyMzc=","avatar_url":"https://avatars.githubusercontent.com/u/6639237?v=4","gravatar_id":"","url":"https://api.github.com/users/MJacred","html_url":"https://github.com/MJacred","followers_url":"https://api.github.com/users/MJacred/followers","following_url":"https://api.github.com/users/MJacred/following{/other_user}","gists_url":"https://api.github.com/users/MJacred/gists{/gist_id}","starred_url":"https://api.github.com/users/MJacred/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/MJacred/subscriptions","organizations_url":"https://api.github.com/users/MJacred/orgs","repos_url":"https://api.github.com/users/MJacred/repos","events_url":"https://api.github.com/users/MJacred/events{/privacy}","received_events_url":"https://api.github.com/users/MJacred/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-04-20T11:52:21Z","updated_at":"2025-04-20T11:53:31Z","body":"Personally, I also prefer squashing at the very end.  \r\nBut then you might get an approval and merge in quick succession, before you can squash it…  \r\nAnd I've been told before by core maintainers to squash right away (maybe that changed over time?)","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2817134186/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2817135478","html_url":"https://github.com/godotengine/godot/pull/105513#issuecomment-2817135478","issue_url":"https://api.github.com/repos/godotengine/godot/issues/105513","id":2817135478,"node_id":"IC_kwDOAO6SJc6n6hN2","user":{"login":"AThousandShips","id":96648715,"node_id":"U_kgDOBcK-Cw","avatar_url":"https://avatars.githubusercontent.com/u/96648715?v=4","gravatar_id":"","url":"https://api.github.com/users/AThousandShips","html_url":"https://github.com/AThousandShips","followers_url":"https://api.github.com/users/AThousandShips/followers","following_url":"https://api.github.com/users/AThousandShips/following{/other_user}","gists_url":"https://api.github.com/users/AThousandShips/gists{/gist_id}","starred_url":"https://api.github.com/users/AThousandShips/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/AThousandShips/subscriptions","organizations_url":"https://api.github.com/users/AThousandShips/orgs","repos_url":"https://api.github.com/users/AThousandShips/repos","events_url":"https://api.github.com/users/AThousandShips/events{/privacy}","received_events_url":"https://api.github.com/users/AThousandShips/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-04-20T11:56:05Z","updated_at":"2025-04-20T11:57:31Z","body":"The PR will be squashed by maintainers if needed, or it can just be squashed by the author at request by maintainers, but we allow contributors to have separate commits for their own organization, but it's up to each contributor how they want to do things\r\n\r\nBut we prefer to not ask that contributors squash before the PR is ready, to avoid unnecessary work if the PR needs further changes, or gets rejected, and that's why we wait until it is ready\r\n\r\nBut regardless it's best to leave up to maintainers to handle requesting that","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2817135478/reactions","total_count":2,"+1":2,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2843939197","html_url":"https://github.com/godotengine/godot/pull/105513#issuecomment-2843939197","issue_url":"https://api.github.com/repos/godotengine/godot/issues/105513","id":2843939197,"node_id":"IC_kwDOAO6SJc6pgxF9","user":{"login":"Raftatul","id":80292778,"node_id":"MDQ6VXNlcjgwMjkyNzc4","avatar_url":"https://avatars.githubusercontent.com/u/80292778?v=4","gravatar_id":"","url":"https://api.github.com/users/Raftatul","html_url":"https://github.com/Raftatul","followers_url":"https://api.github.com/users/Raftatul/followers","following_url":"https://api.github.com/users/Raftatul/following{/other_user}","gists_url":"https://api.github.com/users/Raftatul/gists{/gist_id}","starred_url":"https://api.github.com/users/Raftatul/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Raftatul/subscriptions","organizations_url":"https://api.github.com/users/Raftatul/orgs","repos_url":"https://api.github.com/users/Raftatul/repos","events_url":"https://api.github.com/users/Raftatul/events{/privacy}","received_events_url":"https://api.github.com/users/Raftatul/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-05-01T02:24:13Z","updated_at":"2025-05-01T02:24:13Z","body":"> For consistent naming, please use `joypad` instead of `gamepad`\r\n> \r\n> _EDIT_: and add a note that this does **not** stop Godot from capturing/connecting to the joypad itself. For that, you need a per-platform implementation. See [this proposal](https://github.com/godotengine/godot-proposals/issues/8391) for information\r\n\r\nShould I also rename the project settings category from `Controller` to `Joypad` ?\r\n\r\n![image](https://github.com/user-attachments/assets/29b69f9f-a26e-4ef8-a6af-8ace4f0225d5)\r\n","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2843939197/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2895410522","html_url":"https://github.com/godotengine/godot/pull/105513#issuecomment-2895410522","issue_url":"https://api.github.com/repos/godotengine/godot/issues/105513","id":2895410522,"node_id":"IC_kwDOAO6SJc6slHVa","user":{"login":"Raftatul","id":80292778,"node_id":"MDQ6VXNlcjgwMjkyNzc4","avatar_url":"https://avatars.githubusercontent.com/u/80292778?v=4","gravatar_id":"","url":"https://api.github.com/users/Raftatul","html_url":"https://github.com/Raftatul","followers_url":"https://api.github.com/users/Raftatul/followers","following_url":"https://api.github.com/users/Raftatul/following{/other_user}","gists_url":"https://api.github.com/users/Raftatul/gists{/gist_id}","starred_url":"https://api.github.com/users/Raftatul/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Raftatul/subscriptions","organizations_url":"https://api.github.com/users/Raftatul/orgs","repos_url":"https://api.github.com/users/Raftatul/repos","events_url":"https://api.github.com/users/Raftatul/events{/privacy}","received_events_url":"https://api.github.com/users/Raftatul/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-05-20T18:21:57Z","updated_at":"2025-05-20T18:21:57Z","body":"> This should be added to the docs in ProjectSettings.xml:\r\n> \r\n> ```\r\n> To control this at runtime, use [member Input.joypad_enabled].\r\n> ```\r\n> \r\n> apart from that, LGTM\r\n\r\nDone","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2895410522/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3394945752","html_url":"https://github.com/godotengine/godot/pull/105513#issuecomment-3394945752","issue_url":"https://api.github.com/repos/godotengine/godot/issues/105513","id":3394945752,"node_id":"IC_kwDOAO6SJc7KWsLY","user":{"login":"Raftatul","id":80292778,"node_id":"MDQ6VXNlcjgwMjkyNzc4","avatar_url":"https://avatars.githubusercontent.com/u/80292778?v=4","gravatar_id":"","url":"https://api.github.com/users/Raftatul","html_url":"https://github.com/Raftatul","followers_url":"https://api.github.com/users/Raftatul/followers","following_url":"https://api.github.com/users/Raftatul/following{/other_user}","gists_url":"https://api.github.com/users/Raftatul/gists{/gist_id}","starred_url":"https://api.github.com/users/Raftatul/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Raftatul/subscriptions","organizations_url":"https://api.github.com/users/Raftatul/orgs","repos_url":"https://api.github.com/users/Raftatul/repos","events_url":"https://api.github.com/users/Raftatul/events{/privacy}","received_events_url":"https://api.github.com/users/Raftatul/received_events","type":"User","user_view_