efault":false,"description":"","archived_at":null,"archived_by":null},{"id":1732720779,"node_id":"MDU6TGFiZWwxNzMyNzIwNzc5","url":"https://api.github.com/repos/godotengine/godot/labels/topic:gui","name":"topic:gui","color":"ffee88","default":false,"description":"","archived_at":null,"archived_by":null}],"state":"open","locked":false,"assignees":[],"milestone":{"url":"https://api.github.com/repos/godotengine/godot/milestones/14","html_url":"https://github.com/godotengine/godot/milestone/14","labels_url":"https://api.github.com/repos/godotengine/godot/milestones/14/labels","id":7806203,"node_id":"MI_kwDOAO6SJc4Adxz7","number":14,"title":"3.x","description":"Issues and pull requests slated for an undetermined Godot 3 release.","creator":{"login":"akien-mga","id":4701338,"node_id":"MDQ6VXNlcjQ3MDEzMzg=","avatar_url":"https://avatars.githubusercontent.com/u/4701338?v=4","gravatar_id":"","url":"https://api.github.com/users/akien-mga","html_url":"https://github.com/akien-mga","followers_url":"https://api.github.com/users/akien-mga/followers","following_url":"https://api.github.com/users/akien-mga/following{/other_user}","gists_url":"https://api.github.com/users/akien-mga/gists{/gist_id}","starred_url":"https://api.github.com/users/akien-mga/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/akien-mga/subscriptions","organizations_url":"https://api.github.com/users/akien-mga/orgs","repos_url":"https://api.github.com/users/akien-mga/repos","events_url":"https://api.github.com/users/akien-mga/events{/privacy}","received_events_url":"https://api.github.com/users/akien-mga/received_events","type":"User","user_view_type":"public","site_admin":false},"open_issues":1263,"closed_issues":1,"state":"open","created_at":"2022-03-26T10:06:00Z","updated_at":"2026-10-22T08:37:51Z","due_on":null,"closed_at":null},"comments":1,"created_at":"2025-04-24T07:42:14Z","updated_at":"2025-05-27T12:12:56Z","closed_at":null,"assignee":null,"author_association":"NONE","issue_field_values":[],"type":null,"active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"### Tested versions\n\nv3.7.dev.custom_build [5155fe5a4]\n\n### System information\n\nw11\n\n### Issue description\n\nI'm not sure whether this is a bug in the documentation (since it states that a Viewport will adopt the size of the ViewportContainer it is inside) or a bug in either the Viewport or ViewportContainer nodes themselves.\n\nLink to doc:\nhttps://docs.godotengine.org/en/3.6/classes/class_viewport.html#class-viewport\n\nThe issue: Making a Viewport visible in the editor involves some rather unusual steps.\n\nPossible problem with the Viewport documentation: The documentation states that if a Viewport is added as a child of a ViewportContainer, it will adopt the size of the container. However, this doesn't seem to happen in this example.\n\nIn order to make a Viewport visible in the editor, I need to perform — among other things — two particularly strange steps:\n\nManually set the size of the Viewport, even though it is a child of a ViewportContainer. According to the documentation, the Viewport should inherit the size of the container, but this does not appear to happen.\n\nToggle the \"Stretch\" option on the ViewportContainer off and on again (or vice versa).\n\nPlease refer to the attached video for the exact steps required to make the Viewport visible in the editor:\n\nhttps://youtu.be/_ImhNf5H48g\n\n### Steps to reproduce\n\nSee the video\n\n### Minimal reproduction project (MRP)\n\n[testViewport.zip](https://github.com/user-attachments/files/19955461/testViewport.zip)","closed_by":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/105702/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/godotengine/godot/issues/105702/timeline","performed_via_github_app":null,"state_reason":null,"pinned_comment":null}