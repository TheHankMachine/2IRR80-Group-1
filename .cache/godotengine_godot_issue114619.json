ription":"","archived_at":null,"archived_by":null},{"id":1332303119,"node_id":"MDU6TGFiZWwxMzMyMzAzMTE5","url":"https://api.github.com/repos/godotengine/godot/labels/regression","name":"regression","color":"ff63ac","default":false,"description":"","archived_at":null,"archived_by":null}],"state":"closed","locked":false,"assignees":[],"milestone":{"url":"https://api.github.com/repos/godotengine/godot/milestones/23","html_url":"https://github.com/godotengine/godot/milestone/23","labels_url":"https://api.github.com/repos/godotengine/godot/milestones/23/labels","id":12939969,"node_id":"MI_kwDOAO6SJc4AxXLB","number":23,"title":"4.6","description":"","creator":{"login":"Repiteo","id":17489292,"node_id":"MDQ6VXNlcjE3NDg5Mjky","avatar_url":"https://avatars.githubusercontent.com/u/17489292?v=4","gravatar_id":"","url":"https://api.github.com/users/Repiteo","html_url":"https://github.com/Repiteo","followers_url":"https://api.github.com/users/Repiteo/followers","following_url":"https://api.github.com/users/Repiteo/following{/other_user}","gists_url":"https://api.github.com/users/Repiteo/gists{/gist_id}","starred_url":"https://api.github.com/users/Repiteo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Repiteo/subscriptions","organizations_url":"https://api.github.com/users/Repiteo/orgs","repos_url":"https://api.github.com/users/Repiteo/repos","events_url":"https://api.github.com/users/Repiteo/events{/privacy}","received_events_url":"https://api.github.com/users/Repiteo/received_events","type":"User","user_view_type":"public","site_admin":false},"open_issues":3,"closed_issues":2978,"state":"closed","created_at":"2025-05-22T16:25:52Z","updated_at":"2026-10-04T16:23:23Z","due_on":null,"closed_at":"2026-01-26T18:09:14Z"},"comments":1,"created_at":"2026-01-05T10:56:49Z","updated_at":"2026-01-05T18:13:14Z","closed_at":"2026-01-05T18:13:13Z","assignee":null,"author_association":"CONTRIBUTOR","issue_field_values":[],"type":null,"active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"### Tested versions\n\n- Reproducible in: v4.6.beta.custom_build [8dcf5b4eaf]  (latest master)\n- Not reproducible in: v4.6.beta2.official [551ce8d47]\n\n### System information\n\nGodot v4.6.beta2 - Windows 10 (build 19045) - Multi-window, 2 monitors - Vulkan (Forward+) - dedicated AMD Radeon RX 580 2048SP (Advanced Micro Devices, Inc.; 31.0.21923.11000) - AMD Ryzen 5 3600 6-Core Processor (12 threads) - 31.91 GiB memory\n\n### Issue description\n\nAfter PR #114330 when you attempt to import an existing project with editor settings for create a new project as Forward or Mobile renderer, the confirmation button to import will be always disabled, even with a valid project selected. This happens because #114330 rely on a variable that's only setted when  you click on the `+Create` button for create a new project.\n\n\nhttps://github.com/user-attachments/assets/32e355bd-2cbe-4284-9eda-eed35a8e4984\n\n<br>\n\nWhen the Project Manager starts, `ProjectDialog::_renderer_selected()` is called and based in the default renderer setted in editor, `rd_error` will be setted using the inverse value of `rendering_device_supported`. \n\nhttps://github.com/godotengine/godot/blob/8dcf5b4eafff013b7d7022c5c1b3e33dc15e5947/editor/project_manager/project_dialog.cpp#L483-L526\n\n<br>\n\nThe problem is `rendering_device_supported` default value is `false` and it's only setted when you click on the `+Create` button, so in `ProjectDialog::_renderer_selected()` `rd_error` will be always `true` and this will disable the confirmation button unless your default renderer is Compatibility or until you open the New Project dialog at least once.\n\n### Steps to reproduce\n\n1. Make sure your editor settings is setted to create a new project with `Forward` or `Mobile` renderer (Settings -> Edit All Settings -> Project Manager -> Default Renderer)\n2. Attempt to import any existing project\n\n\n### Minimal reproduction project (MRP)\n\nN/A","closed_by":{"login":"Repiteo","id":17489292,"node_id":"MDQ6VXNlcjE3NDg5Mjky","avatar_url":"https://avatars.githubusercontent.com/u/17489292?v=4","gravatar_id":"","url":"https://api.github.com/users/Repiteo","html_url":"https://github.com/Repiteo","followers_url":"https://api.github.com/users/Repiteo/followers","following_url":"https://api.github.com/users/Repiteo/following{/other_user}","gists_url":"https://api.github.com/users/Repiteo/gists{/gist_id}","starred_url":"https://api.github.com/users/Repiteo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Repiteo/subscriptions","organizations_url":"https://api.github.com/users/Repiteo/orgs","repos_url":"https://api.github.com/users/Repiteo/repos","events_url":"https://api.github.com/users/Repiteo/events{/privacy}","received_events_url":"https://api.github.com/users/Repiteo/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/114619/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/godotengine/godot/issues/114619/timeline","performed_via_github_app":null,"state_reason":"completed","pinned_comment":null}