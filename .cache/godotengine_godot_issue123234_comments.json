66850567/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5593640395","html_url":"https://github.com/godotengine/godot/pull/123234#issuecomment-5593640395","issue_url":"https://api.github.com/repos/godotengine/godot/issues/123234","id":5593640395,"node_id":"IC_kwDOAO6SJc8AAAABTWgtyw","user":{"login":"gumaciel","id":20030153,"node_id":"MDQ6VXNlcjIwMDMwMTUz","avatar_url":"https://avatars.githubusercontent.com/u/20030153?v=4","gravatar_id":"","url":"https://api.github.com/users/gumaciel","html_url":"https://github.com/gumaciel","followers_url":"https://api.github.com/users/gumaciel/followers","following_url":"https://api.github.com/users/gumaciel/following{/other_user}","gists_url":"https://api.github.com/users/gumaciel/gists{/gist_id}","starred_url":"https://api.github.com/users/gumaciel/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/gumaciel/subscriptions","organizations_url":"https://api.github.com/users/gumaciel/orgs","repos_url":"https://api.github.com/users/gumaciel/repos","events_url":"https://api.github.com/users/gumaciel/events{/privacy}","received_events_url":"https://api.github.com/users/gumaciel/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-09-09T00:02:34Z","updated_at":"2026-09-09T00:10:18Z","body":"@AThousandShips Yes, I wrote the code, designed the implementation, and made all the decisions; I analyzed an issue reported by a user regarding my plugin (https://github.com/poingstudios/godot-admob-plugin/discussions/510) and saw that minification wasn't implemented in Godot. I looked into what it entailed and decided to implement it in the source code, given that there is an open [enhancement/bug](https://github.com/godotengine/godot/issues/43363) issue and a previous attempt at a [PR](https://github.com/godotengine/godot/pull/31509) for it.\r\n\r\nRegarding the PR description: I used tooling to format the before-and-after comparison tables clearly alongside the details. I reviewed and verified everything, and it wasn't generated by AI on its own.\r\n\r\nI've previously contributed this feature PR: https://github.com/godotengine/godot/pull/116939.\r\n\r\nI believe that if we want to add minification for Android, this is the required change, and I'm happy to address any review feedback.\r\n","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5593640395/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5598655241","html_url":"https://github.com/godotengine/godot/pull/123234#issuecomment-5598655241","issue_url":"https://api.github.com/repos/godotengine/godot/issues/123234","id":5598655241,"node_id":"IC_kwDOAO6SJc8AAAABTbSzCQ","user":{"login":"AThousandShips","id":96648715,"node_id":"U_kgDOBcK-Cw","avatar_url":"https://avatars.githubusercontent.com/u/96648715?v=4","gravatar_id":"","url":"https://api.github.com/users/AThousandShips","html_url":"https://github.com/AThousandShips","followers_url":"https://api.github.com/users/AThousandShips/followers","following_url":"https://api.github.com/users/AThousandShips/following{/other_user}","gists_url":"https://api.github.com/users/AThousandShips/gists{/gist_id}","starred_url":"https://api.github.com/users/AThousandShips/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/AThousandShips/subscriptions","organizations_url":"https://api.github.com/users/AThousandShips/orgs","repos_url":"https://api.github.com/users/AThousandShips/repos","events_url":"https://api.github.com/users/AThousandShips/events{/privacy}","received_events_url":"https://api.github.com/users/AThousandSh