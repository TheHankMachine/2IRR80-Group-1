1327318271,"node_id":"MDU6TGFiZWwxMzI3MzE4Mjcx","url":"https://api.github.com/repos/godotengine/godot/labels/crash","name":"crash","color":"885544","default":false,"description":"","archived_at":null,"archived_by":null}],"state":"open","locked":false,"assignees":[],"milestone":{"url":"https://api.github.com/repos/godotengine/godot/milestones/16","html_url":"https://github.com/godotengine/godot/milestone/16","labels_url":"https://api.github.com/repos/godotengine/godot/milestones/16/labels","id":8237783,"node_id":"MI_kwDOAO6SJc4AfbLX","number":16,"title":"4.x","description":"Issues and pull requests slated for an undetermined Godot 4 release.","creator":{"login":"akien-mga","id":4701338,"node_id":"MDQ6VXNlcjQ3MDEzMzg=","avatar_url":"https://avatars.githubusercontent.com/u/4701338?v=4","gravatar_id":"","url":"https://api.github.com/users/akien-mga","html_url":"https://github.com/akien-mga","followers_url":"https://api.github.com/users/akien-mga/followers","following_url":"https://api.github.com/users/akien-mga/following{/other_user}","gists_url":"https://api.github.com/users/akien-mga/gists{/gist_id}","starred_url":"https://api.github.com/users/akien-mga/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/akien-mga/subscriptions","organizations_url":"https://api.github.com/users/akien-mga/orgs","repos_url":"https://api.github.com/users/akien-mga/repos","events_url":"https://api.github.com/users/akien-mga/events{/privacy}","received_events_url":"https://api.github.com/users/akien-mga/received_events","type":"User","user_view_type":"public","site_admin":false},"open_issues":5790,"closed_issues":0,"state":"open","created_at":"2022-07-26T12:42:05Z","updated_at":"2026-10-22T08:16:48Z","due_on":null,"closed_at":null},"comments":1,"created_at":"2026-10-04T08:29:27Z","updated_at":"2026-10-09T05:17:40Z","closed_at":null,"assignee":null,"author_association":"CONTRIBUTOR","issue_field_values":[],"type":null,"active_lock_reason":null,"draft":false,"pull_request":{"url":"https://api.github.com/repos/godotengine/godot/pulls/124147","html_url":"https://github.com/godotengine/godot/pull/124147","diff_url":"https://github.com/godotengine/godot/pull/124147.diff","patch_url":"https://github.com/godotengine/godot/pull/124147.patch","merged_at":null},"body":"## What problem(s) does this PR solve?\r\n\r\n- Closes #124144\r\n\r\n## Additional information\r\n\r\nProblems with crashes and various other bugs caused by a mutex not being used where it should be and not protecting the variables it is supposed to protect are one of the hardest bugs to fix in Godot in my experience, due to the random nature of these bugs(crashes, asan reports, memory corruption etc.).\r\n\r\nIn rust, the mutex owns the variable/structure and the only way to access the data is through .lock(), so the compiler forces users to access the data with proper synchronization.\r\n\r\nThis PR contains both a quite simple implementation of such a Mutex and an example usage in ResourceUID. I think that all(or almost all) mutexes should be converted to this class\r\n\r\nIt will also help to clearly distinguish variables that can be used in other threads from those which cannot be used. For example, when reading AudioDriver/AudioServer I have a problem understanding which exact variables should be used directly and which through the mutex.\r\n","closed_by":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/124147/reactions","total_count":2,"+1":2,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/godotengine/godot/issues/124147/timeline","performed_via_github_app":null,"state_reason":null}