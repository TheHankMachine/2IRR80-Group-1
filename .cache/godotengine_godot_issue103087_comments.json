"following_url":"https://api.github.com/users/pbeart/following{/other_user}","gists_url":"https://api.github.com/users/pbeart/gists{/gist_id}","starred_url":"https://api.github.com/users/pbeart/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/pbeart/subscriptions","organizations_url":"https://api.github.com/users/pbeart/orgs","repos_url":"https://api.github.com/users/pbeart/repos","events_url":"https://api.github.com/users/pbeart/events{/privacy}","received_events_url":"https://api.github.com/users/pbeart/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-05-26T14:07:19Z","updated_at":"2025-05-26T14:07:19Z","body":"Single window mode fixes this but the new 4.4 embedded game windows won't work with it - seems like this feature will become more important and it would be a pity for Intel cards (which appear to be continuing to be released) not to be able to take advantage of it. Definitely some kind of driver problem on Intel's part however if there is a work around Godot can do that would be great.","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2909875565/reactions","total_count":3,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":3},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3008156355","html_url":"https://github.com/godotengine/godot/issues/103087#issuecomment-3008156355","issue_url":"https://api.github.com/repos/godotengine/godot/issues/103087","id":3008156355,"node_id":"IC_kwDOAO6SJc6zTNLD","user":{"login":"NeonMika","id":15616599,"node_id":"MDQ6VXNlcjE1NjE2NTk5","avatar_url":"https://avatars.githubusercontent.com/u/15616599?v=4","gravatar_id":"","url":"https://api.github.com/users/NeonMika","html_url":"https://github.com/NeonMika","followers_url":"https://api.github.com/users/NeonMika/followers","following_url":"https