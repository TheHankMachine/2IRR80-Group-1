":null},{"id":2666708059,"node_id":"MDU6TGFiZWwyNjY2NzA4MDU5","url":"https://api.github.com/repos/godotengine/godot/labels/topic:2d","name":"topic:2d","color":"ffee88","default":false,"description":"","archived_at":null,"archived_by":null}],"state":"closed","locked":false,"assignees":[],"milestone":{"url":"https://api.github.com/repos/godotengine/godot/milestones/24","html_url":"https://github.com/godotengine/godot/milestone/24","labels_url":"https://api.github.com/repos/godotengine/godot/milestones/24/labels","id":14236899,"node_id":"MI_kwDOAO6SJc4A2Tzj","number":24,"title":"4.7","description":"","creator":{"login":"akien-mga","id":4701338,"node_id":"MDQ6VXNlcjQ3MDEzMzg=","avatar_url":"https://avatars.githubusercontent.com/u/4701338?v=4","gravatar_id":"","url":"https://api.github.com/users/akien-mga","html_url":"https://github.com/akien-mga","followers_url":"https://api.github.com/users/akien-mga/followers","following_url":"https://api.github.com/users/akien-mga/following{/other_user}","gists_url":"https://api.github.com/users/akien-mga/gists{/gist_id}","starred_url":"https://api.github.com/users/akien-mga/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/akien-mga/subscriptions","organizations_url":"https://api.github.com/users/akien-mga/orgs","repos_url":"https://api.github.com/users/akien-mga/repos","events_url":"https://api.github.com/users/akien-mga/events{/privacy}","received_events_url":"https://api.github.com/users/akien-mga/received_events","type":"User","user_view_type":"public","site_admin":false},"open_issues":3,"closed_issues":2535,"state":"closed","created_at":"2025-11-27T20:29:18Z","updated_at":"2026-10-20T18:39:31Z","due_on":null,"closed_at":"2026-06-19T16:54:35Z"},"comments":0,"created_at":"2025-04-04T21:14:06Z","updated_at":"2026-04-01T23:15:56Z","closed_at":"2026-04-01T23:14:22Z","assignee":null,"author_association":"MEMBER","issue_field_values":[],"type":null,"active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"### Tested versions\n\n- Reproducible in: 4.3.stable, 4.4.1.stable\n\n### System information\n\nGodot v4.4.1.stable - Windows 11 (build 26100) - Multi-window, 1 monitor - Vulkan (Mobile) - dedicated NVIDIA GeForce RTX 4090 (NVIDIA; 32.0.15.6636) - 13th Gen Intel(R) Core(TM) i9-13900K (32 threads)\n\n### Issue description\n\nCanvasItem `draw_*()` antialiasing makes lines appear thicker than intended. This is due to the feather being added to the existing line thickness, without the line thickness being reduced to compensate for the feather's width.\n\nThis is reproducible on all rendering methods.\n\nhttps://github.com/user-attachments/assets/2e07d8f5-53c8-4eff-99f0-46f11e3fe883\n\nIf you compensate for width by using a width of `0.5` instead of `1.0` when using antialiasing (for thin lines), or subtracting `1.0` to the line width (for thick lines), you get a much closer result:\n\nhttps://github.com/user-attachments/assets/6c1d0e0b-25dd-479e-b32c-9668ab449b48\n\nWe should perform this width compensaton at the RenderingServer level so that it's automatically applied, without needing to modify your project.\n\n2D MSAA is not affected by this issue, but it's slower and not supported in Compatibility.\n\n### Steps to reproduce\n\n- Enable antialiasing in a CanvasItem `draw()` method that supports it by passing `true` for the `antialiased` parameter.\n\n### Minimal reproduction project (MRP)\n\n[custom_drawing_no_width_compensation.zip](https://github.com/user-attachments/files/19610364/custom_drawing_no_width_compensation.zip)\n\nThis is the same as https://github.com/godotengine/godot-demo-projects/pull/1185, but with line width compensation edited out. Any fix should be developed using this MRP specifically.","closed_by":{"login":"Repiteo","id":17489292,"node_id":"MDQ6VXNlcjE3NDg5Mjky","avatar_url":"https://avatars.githubusercontent.com/u/17489292?v=4","gravatar_id":"","url":"https://api.github.com/users/Repiteo","html_url":"https://github.com/Repiteo","followers_url":"https://api.github.com/users/Repiteo/followers","following_url":"https://api.github.com/users/Repiteo/following{/other_user}","gists_url":"https://api.github.com/users/Repiteo/gists{/gist_id}","starred_url":"https://api.github.com/users/Repiteo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Repiteo/subscriptions","organizations_url":"https://api.github.com/users/Repiteo/orgs","repos_url":"https://api.github.com/users/Repiteo/repos","events_url":"https://api.github.com/users/Repiteo/events{/privacy}","received_events_url":"https://api.github.com/users/Repiteo/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/105027/reactions","total_count":2,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":1},"timeline_url":"https://api.github.com/repos/godotengine/godot/issues/105027/timeline","performed_via_github_app":null,"state_reason":"completed","pinned_comment":null}