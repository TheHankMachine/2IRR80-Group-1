node_id":"MDQ6VXNlcjEwMDU0MjI2","avatar_url":"https://avatars.githubusercontent.com/u/10054226?v=4","gravatar_id":"","url":"https://api.github.com/users/kitbdev","html_url":"https://github.com/kitbdev","followers_url":"https://api.github.com/users/kitbdev/followers","following_url":"https://api.github.com/users/kitbdev/following{/other_user}","gists_url":"https://api.github.com/users/kitbdev/gists{/gist_id}","starred_url":"https://api.github.com/users/kitbdev/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/kitbdev/subscriptions","organizations_url":"https://api.github.com/users/kitbdev/orgs","repos_url":"https://api.github.com/users/kitbdev/repos","events_url":"https://api.github.com/users/kitbdev/events{/privacy}","received_events_url":"https://api.github.com/users/kitbdev/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-08-16T14:08:31Z","updated_at":"2026-08-16T14:09:13Z","body":"When I tried 8x8 the icon was too pixelated.\r\nAnd the reason there is empty space below the icon is tiling artifacts show up otherwise.","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5307840341/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5308397444","html_url":"https://github.com/godotengine/godot/pull/122456#issuecomment-5308397444","issue_url":"https://api.github.com/repos/godotengine/godot/issues/122456","id":5308397444,"node_id":"IC_kwDOAO6SJc8AAAABPGe3hA","user":{"login":"MewPurPur","id":85438892,"node_id":"MDQ6VXNlcjg1NDM4ODky","avatar_url":"https://avatars.githubusercontent.com/u/85438892?v=4","gravatar_id":"","url":"https://api.github.com/users/MewPurPur","html_url":"https://github.com/MewPurPur","followers_url":"https://api.github.com/users/MewPurPur/followers","following_url":"https://api.github.com/users/MewPurPur/following{/other_user}","gists_url":"https://api.github.com/users/MewPurPur/gists{/gist_id}","starred_url":"https://api.github.com/users/MewPurPur/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/MewPurPur/subscriptions","organizations_url":"https://api.github.com/users/MewPurPur/orgs","repos_url":"https://api.github.com/users/MewPurPur/repos","events_url":"https://api.github.com/users/MewPurPur/events{/privacy}","received_events_url":"https://api.github.com/users/MewPurPur/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-08-16T16:16:28Z","updated_at":"2026-08-16T16:20:27Z","body":"Oh I see, I'd suggest something like 16x10 with one space above and below, for a smaller texture without that issue. Also, why is the underline going past the end of the text?","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5308397444/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5308655299","html_url":"https://github.com/godotengine/godot/pull/122456#issuecomment-5308655299","issue_url":"https://api.github.com/repos/godotengine/godot/issues/122456","id":5308655299,"node_id":"IC_kwDOAO6SJc8AAAABPGumww","user":{"login":"kitbdev","id":10054226,"node_id":"MDQ6VXNlcjEwMDU0MjI2","avatar_url":"https://avatars.githubusercontent.com/u/10054226?v=4","gravatar_id":"","url":"https://api.github.com/users/kitbdev","html_url":"https://github.com/kitbdev","followers_url":"https://api.github.com/users/kitbdev/followers","following_url":"https://api.github.com/users/kitbdev/following{/other_user}","gists_url":"https://api.github.com/users/kitbdev/gists{/gist_id}","starred_url":"https://api.github.com/users/kitbdev/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/kitbdev/subscriptions","organizations_url":"https://api.github.com/users/kitbdev/orgs","repos_url":"https://api.github.com/users/kitbdev/repos","events_url":"https://api.github.com/users/kitbdev/events{/privacy}","received_events_url":"https://api.github.com/users/kitbdev/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-08-16T17:17:07Z","updated_at":"2026-08-16T17:17:07Z","body":"16x10 works, I'll update it.\r\n\r\nIn the image, that is because the text actually continues there, I no longer clamp it to the last visible character. it does stop at the end of the line.\r\nIt's the same behavior as selections.\r\n- Related https://github.com/godotengine/godot/pull/120900","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5308655299/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5345118055","html_url":"https://github.com/godotengine/godot/pull/122456#issuecomment-5345118055","issue_url":"https://api.github.com/repos/godotengine/godot/issues/122456","id":5345118055,"node_id":"IC_kwDOAO6SJc8AAAABPpgHZw","user":{"login":"kitbdev","id":10054226,"node_id":"MDQ6VXNlcjEwMDU0MjI2","avatar_url":"https://avatars.githubusercontent.com/u/10054226?v=4","gravatar_id":"","url":"https://api.github.com/users/kitbdev","html_url":"https://github.com/kitbdev","followers_url":"https://api.github.com/users/kitbdev/followers","following_url":"https://api.github.com/users/kitbdev/following{/other_user}","gists_url":"https://api.github.com/users/kitbdev/gists{/gist_id}","starred_url":"https://api.github.com/users/kitbdev/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/kitbdev/subscriptions","organizations_url":"https://api.github.com/users/kitbdev/orgs","repos_url":"https://api.github.com/users/kitbdev/repos","events_url":"https://api.github.com/users/kitbdev/events{/privacy}","received_events_url":"https://api.github.com/users/kitbdev/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-08-19T16:36:29Z","updated_at":"2026-08-19T16:36:29Z","body":"> I think I can see the seam between the instances of the squiggle icon\r\n\r\nThe svg covers the entire width and it uses texture tiling, so I don't think its possible to have a seam? At least I haven't noticed one on my screen. \r\nI can't really overlap it unless moving the svg outside of the bounds is possible. And overlapping it would be noticeable if it is transparent.\r\n\r\n> The squiggle itself feels like maybe it's the tiniest bit too tall, in my opinion? \r\n\r\nIt is taller than before, right now it is exactly half as tall as it is wide (for a single cycle). Before it was ~10:3, now its 2:1. IMO this ratio is good, but if we want I could change the svg height to change the ratio, or the scale to affect the height+frequency. Though changing the frequency affects the overlap handling, so it should be a multiple of the char width.\r\n","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5345118055/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5345414902","html_url":"https://github.com/godotengine/godot/pull/122456#issuecomment-5345414902","issue_url":"https://api.github.com/repos/godotengine/godot/issues/122456","id":5345414902,"node_id":"IC_kwDOAO6SJc8AAAABPpyO9g","user":{"login":"Meorge","id":9957987,"node_id":"MDQ6VXNlcjk5NTc5ODc=","avatar_url":"https://avatars.githubusercontent.com/u/9957987?v=4","gravatar_id":"","url":"https://api.github.com/users/Meorge","html_url":"https://github.com/Meorge","followers_url":"https://api.github.com/users/Meorge/followers","following_url":"https://api.github.com/users/Meorge/following{/other_user}","gists_url":"https://api.github.com/users/Meorge/gists{/gist_id}","starred_url":"https://api.github.com/users/Meorge/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Meorge/subscriptions","organizations_url":"https://api.github.com/users/Meorge/orgs","repos_url":"https://api.github.com/users/Meorge/repos","events_url":"https://api.github.com/users/Meorge/events{/privacy}","received_events_url":"https://api.github.com/users/Meorge/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-08-19T17:02:49Z","updated_at":"2026-08-19T17:02:49Z","body":"> The svg covers the entire width and it uses texture tiling, so I don't think its possible to have a seam? At least I haven't noticed one on my screen.\r\n\r\nBizarrely, when zoomed in I don't see the seam:\r\n<img width=\"640\" height=\"482\" alt=\"CleanShot 2026-08-19 at 09 56 38@2x\" src=\"https://github.com/user-attachments/assets/e5317cd5-ac2e-4367-bee2-7a37100cc700\" />\r\n\r\nHowever, zoomed _out_, I feel like I can see it ever-so-slightly at the bottom:\r\n<img width=\"274\" height=\"208\" alt=\"CleanShot 2026-08-19 at 09 57 04@2x\" src=\"https://github.com/user-attachments/assets/2933665b-3b08-4ef9-ae36-d279b2c0a031\" />\r\nI think it might have to do with the bottom row of pixels on that part being a smidge darker than the corresponding row along the top edge? Either way, it's so small that I don't want to worry too much about it 😅\r\n\r\n> IMO this ratio is good, but if we want I could change the svg height to change the ratio, or the scale to affect the height+frequency.\r\n\r\nI suppose we can see if anyone else has a strong opinion on it, but if no one objects, I think it's good as-is. It does its job of grabbing the user's attention well, and that's what's most important. Again, I don't want to spend so long worrying about these nearly-imperceptible things that we end up delaying the progress as a whole. \r\n\r\nThanks again for taking on this task and improving performance so much! 😄 ","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5345414902/reactions","total_count":2,"+1":2,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5439861181","html_url":"https://github.com/godotengine/godot/pull/122456#issuecomment-5439861181","issue_url":"https://api.github.com/repos/godotengine/godot/issues/122456","id":5439861181,"node_id":"IC_kwDOAO6SJc8AAAABRD2xvQ","user":{"login":"Ansraer","id":6329420,"node_id":"MDQ6VXNlcjYzMjk0MjA=","avatar_url":"https://avatars.githubusercontent.com/u/6329420?v=4","gravatar_id":"","url":"https://api.github.com/users/Ansraer","html_url":"https://github.com/Ansraer","followers_url":"https://api.github.com/users/Ansraer/followers","following_url":"https://api.github.com/users/Ansraer/following{/other_user}","gists_url":"https://api.github.com/users/Ansraer/gists{/gist_id}","starred_url":"https://api.github.com/users/Ansraer/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Ansraer/subscriptions","organizations_url":"https://api.github.com/users/Ansraer/orgs","repos_url":"https://api.github.com/users/Ansraer/repos","events_url":"https://api.github.com/users/Ansraer/events{/privacy}","received_events_url":"https://api.github.com/users/Ansraer/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-08-27T13:30:58Z","updated_at":"2026-08-27T13:30:58Z","body":"Huh, looks like the underline is running into sub pixel alignment and anti aliasing issue. This is a well known problem that tends to occur when you are rendering text. \r\nI know that we handle this properly in our text renderer, but have no idea how easy it would be to reuse the relevant code for rendering this icon. Crazy idea, but what if we make a special \"font\" with just one character (the squiggle) and draw that over the regular text?","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5439861181/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null}]