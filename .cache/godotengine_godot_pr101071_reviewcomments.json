[{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/1950336990","pull_request_review_id":2607861458,"id":1950336990,"node_id":"PRRC_kwDOAO6SJc50P8fe","diff_hunk":"@@ -189,9 +190,10 @@ template <typename TBase, int TDefaultCapacity>\n class JoltQueryCollectorClosestMulti final : public TBase {\n public:\n \ttypedef typename TBase::ResultType Hit;\n+\ttypedef JPH::Array<Hit, JPH::STLLocalAllocator<Hit, TDefaultCapacity + 1>> HitArray;","path":"modules/jolt_physics/spaces/jolt_query_collectors.h","commit_id":"5d2a54e6b1e6710b173d0cfc9c0fccb5885b4ff7","original_commit_id":"69add56817e3e320c2940affb4e28533bdab11db","user":{"login":"jrouwe","id":1621693,"node_id":"MDQ6VXNlcjE2MjE2OTM=","avatar_url":"https://avatars.githubusercontent.com/u/1621693?v=4","gravatar_id":"","url":"https://api.github.com/users/jrouwe","html_url":"https://github.com/jrouwe","followers_url":"https://api.github.com/users/jrouwe/followers","following_url":"https://api.github.com/users/jrouwe/following{/other_user}","gists_url":"https://api.github.com/users/jrouwe/gists{/gist_id}","starred_url":"https://api.github.com/users/jrouwe/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/jrouwe/subscriptions","organizations_url":"https://api.github.com/users/jrouwe/orgs","repos_url":"https://api.github.com/users/jrouwe/repos","events_url":"https://api.github.com/users/jrouwe/events{/privacy}","received_events_url":"https://api.github.com/users/jrouwe/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"One thing I just realized: Because `TDefaultCapacity + 1` is not a power of 2 and because the `Array` grows in powers of two, you will actually overflow to heap when you add the `TDefaultCapacity + 1`-th element. To get around this you should call `reserve(TDefaultCapacity + 1)` in the constructor of `JoltQueryCollectorClosestMulti`. I'll change the `Array` class so that it is aware of `STLLocalAllocator` and will try to stay within the buffer. Please add the `reserve` here for now as it's a less risky change.","created_at":"2025-02-11T07:09:46Z","updated_at":"2025-02-11T07:09:46Z","html_url":"https://github.com/godotengine/godot/pull/101071#discussion_r1950336990","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/101071","_links":{"self":{"href":"https://api.github.com/repos/godotengine/godot/pulls/comments/1950336990"},"html":{"href":"https://github.com/godotengine/godot/pull/101071#discussion_r1950336990"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/101071"}},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/1950336990/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":199,"original_line":199,"side":"RIGHT","author_association":"CONTRIBUTOR","original_position":40,"position":54,"subject_type":"line"},{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/1950607076","pull_request_review_id":2608318772,"id":1950607076,"node_id":"PRRC_kwDOAO6SJc50Q-bk","diff_hunk":"@@ -189,9 +190,10 @@ template <typename TBase, int TDefaultCapacity>\n class JoltQueryCollectorClosestMulti final : public TBase {\n public:\n \ttypedef typename TBase::ResultType Hit;\n+\ttypedef JPH::Array<Hit, JPH::STLLocalAllocator<Hit, TDefaultCapacity + 1>> HitArray;","path":"modules/jolt_physics/spaces/jolt_query_collectors.h","commit_id":"5d2a54e6b1e6710b173d0cfc9c0fccb5885b4ff7","original_commit_id":"69add56817e3e320c2940affb4e28533bdab11db","user":{"login":"mihe","id":4884246,"node_id":"MDQ6VXNlcjQ4ODQyNDY=","avatar_url":"https://avatars.githubusercontent.com/u/4884246?v=4","gravatar_id":"","url":"https://api.github.com/users/mihe","html_url":"https://github.com/mihe","followers_url":"https://api.github.com/users/mihe/followers","following_url":"https://api.github.com/users/mihe/following{/other_user}"