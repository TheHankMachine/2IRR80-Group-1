_ignores_shape_position_2026-07-21_00-17-21.zip](https://github.com/user-attachments/files/30204578/gltf_import_ignores_shape_position_2026-07-21_00-17-21.zip)","closed_by":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/121570/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/godotengine/godot/issues/121570/timeline","performed_via_github_app":null,"state_reason":null,"pinned_comment":null}