[{"id":3957888714,"node_id":"PRR_kwDOAO6SJc7r6JbK","user":{"login":"ryevdokimov","id":105675984,"node_id":"U_kgDOBkx80A","avatar_url":"https://avatars.githubusercontent.com/u/105675984?v=4","gravatar_id":"","url":"https://api.github.com/users/ryevdokimov","html_url":"https://github.com/ryevdokimov","followers_url":"https://api.github.com/users/ryevdokimov/followers","following_url":"https://api.github.com/users/ryevdokimov/following{/other_user}","gists_url":"https://api.github.com/users/ryevdokimov/gists{/gist_id}","starred_url":"https://api.github.com/users/ryevdokimov/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/ryevdokimov/subscriptions","organizations_url":"https://api.github.com/users/ryevdokimov/orgs","repos_url":"https://api.github.com/users/ryevdokimov/repos","events_url":"https://api.github.com/users/ryevdokimov/events{/privacy}","received_events_url":"https://api.github.com/users/ryevdokimov/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"","state":"COMMENTED","html_url":"https://github.com/godotengine/godot/pull/117496#pullrequestreview-3957888714","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/117496","author_association":"CONTRIBUTOR","_links":{"html":{"href":"https://github.com/godotengine/godot/pull/117496#pullrequestreview-3957888714"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/117496"}},"submitted_at":"2026-03-17T02:52:21Z","commit_id":"e961aadd6b3a135fbbdfc29c61f8440be7d914ae"},{"id":4334789152,"node_id":"PRR_kwDOAO6SJc8AAAABAl-iIA","user":{"login":"TokageItLab","id":61938263,"node_id":"MDQ6VXNlcjYxOTM4MjYz","avatar_url":"https://avatars.githubusercontent.com/u/61938263?u=9b90963f1b4f17720e50bbbe495fbe8c84c8bc8e&v=4","gravatar_id":"","url":"https://api.github.com/users/TokageItLab","html_url":"https://github.com/TokageItLab","followers_url":"https://api.github.com/users/TokageItLab/followers","following_url":"https://api.github.com/users/TokageItLab/following{/other_user}","gists_url":"https://api.github.com/users/TokageItLab/gists{/gist_id}","starred_url":"https://api.github.com/users/TokageItLab/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/TokageItLab/subscriptions","organizations_url":"https://api.github.com/users/TokageItLab/orgs","repos_url":"https://api.github.com/users/TokageItLab/repos","events_url":"https://api.github.com/users/TokageItLab/events{/privacy}","received_events_url":"https://api.github.com/users/TokageItLab/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"This is not good approach, and it may corrupt the pose.\r\n\r\nIf you want to retrieve the modified pose, you should call `get_bone_pose` within the `skeleton_updated` signal, rather than adding `get_bone_pose_final` to `Skeleton3D`. When you first select the Skeleton, you can set the dirty flag and call `NOTIFICATION_UPDATE_SKELETON` to trigger `skeleton_updated` at will, allowing you to retrieve the modified pose. You can refer to `Skeleton3DEditor::insert_keys()` for the example.\r\n\r\nBy doing above, we should be able to follow modified pose in any place. However, we must never allow the handles (blue/yellow circle) to follow modified pose.\r\n\r\nSince setting the \"modified pose\" to the Skeleton \"original pose\" will cause issues such as time paradoxes and break the behavior of the Modifier. For example, if you move only the arm using IK and adjust the finger pose using handles, there is no issue since the finger is a bone that is not directly affected by the Modifier. However, if you move the arm using IK and adjust the arm’s pose using handles, a paradox occurs and the system breaks down.\r\n\r\nSo you will likely need to implement an option to force the Modifiers to be disabled when entering BoneEditMode. Or, you need to retrieve the list of bones marked with `Bone.make_bone_modified` and disable only those handles.","state":"CHANGES_REQUESTED","html_url":"https://github.com/godotengine/godot/pull/117496#pullrequestreview-4334789152","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/117496","author_association":"MEMBER","_links":{"html":{"href":"https://github.com/godotengine/godot/pull/117496#pullrequestreview-4334789152"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/117496"}},"submitted_at":"2026-05-21T07:20:13Z","commit_id":"a271501b59df7994b757fd332a0698b8101123bf"}]