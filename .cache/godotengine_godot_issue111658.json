godotengine/godot/labels/topic:rendering","name":"topic:rendering","color":"ffee88","default":false,"description":"","archived_at":null,"archived_by":null}],"state":"closed","locked":false,"assignees":[],"milestone":{"url":"https://api.github.com/repos/godotengine/godot/milestones/23","html_url":"https://github.com/godotengine/godot/milestone/23","labels_url":"https://api.github.com/repos/godotengine/godot/milestones/23/labels","id":12939969,"node_id":"MI_kwDOAO6SJc4AxXLB","number":23,"title":"4.6","description":"","creator":{"login":"Repiteo","id":17489292,"node_id":"MDQ6VXNlcjE3NDg5Mjky","avatar_url":"https://avatars.githubusercontent.com/u/17489292?v=4","gravatar_id":"","url":"https://api.github.com/users/Repiteo","html_url":"https://github.com/Repiteo","followers_url":"https://api.github.com/users/Repiteo/followers","following_url":"https://api.github.com/users/Repiteo/following{/other_user}","gists_url":"https://api.github.com/users/Repiteo/gists{/gist_id}","starred_url":"https://api.github.com/users/Repiteo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Repiteo/subscriptions","organizations_url":"https://api.github.com/users/Repiteo/orgs","repos_url":"https://api.github.com/users/Repiteo/repos","events_url":"https://api.github.com/users/Repiteo/events{/privacy}","received_events_url":"https://api.github.com/users/Repiteo/received_events","type":"User","user_view_type":"public","site_admin":false},"open_issues":3,"closed_issues":2978,"state":"closed","created_at":"2025-05-22T16:25:52Z","updated_at":"2026-10-04T16:23:23Z","due_on":null,"closed_at":"2026-01-26T18:09:14Z"},"comments":1,"created_at":"2025-10-14T22:32:29Z","updated_at":"2026-01-25T10:23:01Z","closed_at":"2025-10-16T17:54:06Z","assignee":null,"author_association":"CONTRIBUTOR","issue_field_values":[],"type":null,"active_lock_reason":null,"draft":false,"pull_request":{"url":"https://api.github.com/repos/godotengine/godot/pulls/111658","html_url":"https://github.com/godotengine/godot/pull/111658","diff_url":"https://github.com/godotengine/godot/pull/111658.diff","patch_url":"https://github.com/godotengine/godot/pull/111658.patch","merged_at":"2025-10-16T17:54:06Z"},"body":"I am working on a project to display texture resources in Godot that are shared from another process. To do this I require interop with the underlying rendering primitives (e.g. ID3D12Device/VkLogicalDevice, ID3D12CommandQueue/VkQueue, ID3D12Resource/VkImage). I found with D3D12 that the wrong memory addresses were being returned by RenderingDevice::get_driver_resource in two cases:\r\n\r\n* When querying for `DRIVER_RESOURCE_COMMAND_QUEUE`, a pointer to an internal structure (`CommandQueueInfo *`) rather than the `ID3D12CommandQueue *` pointer was being returned.\r\n* When querying for `DRIVER_RESOURCE_TEXTURE`, a pointer to an internal structure was being returned (`(uint64_t)tex_info->main_texture` is a `TextureInfo *`). Instead, this should be returning the `ID3D12Resource *` pointer. In fact, looking back in the history, I can see that this is what was done before a big refactor to avoid code duplication between D3D12 and VK (See the old definition of `texture_get_native_handle` in rendering_device_d3d12.cpp - #83452).","closed_by":{"login":"Repiteo","id":17489292,"node_id":"MDQ6VXNlcjE3NDg5Mjky","avatar_url":"https://avatars.githubusercontent.com/u/17489292?v=4","gravatar_id":"","url":"https://api.github.com/users/Repiteo","html_url":"https://github.com/Repiteo","followers_url":"https://api.github.com/users/Repiteo/followers","following_url":"https://api.github.com/users/Repiteo/following{/other_user}","gists_url":"https://api.github.com/users/Repiteo/gists{/gist_id}","starred_url":"https://api.github.com/users/Repiteo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Repiteo/subscriptions","organizations_url":"https://api.github.com/users/Repiteo/orgs","repos_url":"https://api.github.com/users/Repiteo/repos","events_url":"https://api.github.com/users/Repiteo/events{/privacy}","received_events_url":"https://api.github.com/users/Repiteo/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/111658/reactions","total_count":2,"+1":2,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/godotengine/godot/issues/111658/timeline","performed_via_github_app":null,"state_reason":null}