rl":"https://api.github.com/users/Repiteo/gists{/gist_id}","starred_url":"https://api.github.com/users/Repiteo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Repiteo/subscriptions","organizations_url":"https://api.github.com/users/Repiteo/orgs","repos_url":"https://api.github.com/users/Repiteo/repos","events_url":"https://api.github.com/users/Repiteo/events{/privacy}","received_events_url":"https://api.github.com/users/Repiteo/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"","state":"COMMENTED","html_url":"https://github.com/godotengine/godot/pull/111767#pullrequestreview-3379195727","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/111767","author_association":"CONTRIBUTOR","_links":{"html":{"href":"https://github.com/godotengine/godot/pull/111767#pullrequestreview-3379195727"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/111767"}},"submitted_at":"2025-10-24T23:43:54Z","commit_id":null},{"id":3497917106,"node_id":"PRR_kwDOAO6SJc7Qffqy","user":{"login":"Ivorforce","id":2308167,"node_id":"MDQ6VXNlcjIzMDgxNjc=","avatar_url":"https://avatars.githubusercontent.com/u/2308167?u=f7f8e0273f784f5ec6f6b7fe4a88d449896eb48a&v=4","gravatar_id":"","url":"https://api.github.com/users/Ivorforce","html_url":"https://github.com/Ivorforce","followers_url":"https://api.github.com/users/Ivorforce/followers","following_url":"https://api.github.com/users/Ivorforce/following{/other_user}","gists_url":"https://api.github.com/users/Ivorforce/gists{/gist_id}","starred_url":"https://api.github.com/users/Ivorforce/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Ivorforce/subscriptions","organizations_url":"https://api.github.com/users/Ivorforce/orgs","repos_url":"https://api.github.com/users/Ivorforce/repos","events_url":"https://api.github.com/users/Ivorforce/events{/privacy}","received_events_url":"https://api.github.com/users/Ivorforce/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"I tested this change and it compiled successfully, ~10% faster than `master`.\r\nCode looks good to me now. I appreciate simplifying the implementation to this level!\r\n\r\nI really hope that this won't cause too many issues down the line (I can imagine there will be a few), but the 10% compile time boost is worth it in my opinion.\r\nIf it ends up being too frail in practice, we could switch to transitive libc++ by default, and support non-transitive on a best-effort basis.\r\n\r\n(I'm actually surprised at how few patches are required to get this working. I would have fully expected we'd need to disable this optimization for 3rd party libs.)","state":"APPROVED","html_url":"https://github.com/godotengine/godot/pull/111767#pullrequestreview-3497917106","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/111767","author_association":"MEMBER","_links":{"html":{"href":"https://github.com/godotengine/godot/pull/111767#pullrequestreview-3497917106"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/111767"}},"submitted_at":"2025-11-23T17:54:19Z","commit_id":"ad02128137a90c27c67bb8733bf51990528e73bd"},{"id":3537268689,"node_id":"PRR_kwDOAO6SJc7S1m_R","user":{"login":"akien-mga","id":4701338,"node_id":"MDQ6VXNlcjQ3MDEzMzg=","avatar_url":"https://avatars.githubusercontent.com/u/4701338?u=4a42fd867f2c449fcc23adf635dd574dae98e6c2&v=4","gravatar_id":"","url":"https://api.github.com/users/akien-mga","html_url":"https://github.com/akien-mga","followers_url":"https://api.github.com/users/akien-mga/followers","following_url":"https://api.github.com/users/akien-mga/following{/other_user}","gists_url":"https://api.github.com/users/akien-mga/gists{/gist_id}","starred_url":"https://api.github.com/users/akien-mga/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/akien-mga/subscriptions","organizations_url":"https://api.github.com/users/akien-mga/orgs","repos_url":"https://api.github.com/users/akien-mga/repos","events_url":"https://api.github.com/users/akien-mga/events{/privacy}","received_events_url":"https://api.github.com/users/akien-mga/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"Seems fine.\r\n\r\nCould you propose these changes upstream to the various libraries patched here? So hopefully they get merged and we can drop our patches eventually.","state":"APPROVED","html_url":"https://github.com/godotengine/godot/pull/111767#pullrequestreview-3537268689","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/111767","author_association":"MEMBER","_links":{"html":{"href":"https://github.com/godotengine/godot/pull/111767#pullrequestreview-3537268689"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/111767"}},"submitted_at":"2025-12-03T23:04:06Z","commit_id":"ad02128137a90c27c67bb8733bf51990528e73bd"}]