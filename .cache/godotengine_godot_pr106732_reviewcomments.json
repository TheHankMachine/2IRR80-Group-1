t/pulls/comments/2103541360/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":null,"original_line":422,"side":"RIGHT","in_reply_to_id":2103527901,"author_association":"MEMBER","original_position":5,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/2105375374","pull_request_review_id":2865640732,"id":2105375374,"node_id":"PRRC_kwDOAO6SJc59fXqO","diff_hunk":"@@ -45,6 +45,10 @@ - (void)setShouldMaximizeConcurrentCompilation:(BOOL)v;\n }\n \n Error RenderingContextDriverMetal::initialize() {\n+\tif (String v = OS::get_singleton()->get_environment(U\"METAL_DEVICE_WRAPPER_TYPE\"); v == U\"1\") {","path":"drivers/metal/rendering_context_driver_metal.mm","commit_id":"7d93119353a0b47ce7ce1e715a0ead9b3e6db2fa","original_commit_id":"4c5beeaacff4886bd36cc17766d40db597984dda","user":{"login":"akien-mga","id":4701338,"node_id":"MDQ6VXNlcjQ3MDEzMzg=","avatar_url":"https://avatars.githubusercontent.com/u/4701338?v=4","gravatar_id":"","url":"https://api.github.com/users/akien-mga","html_url":"https://github.com/akien-mga","followers_url":"https://api.github.com/users/akien-mga/followers","following_url":"https://api.github.com/users/akien-mga/following{/other_user}","gists_url":"https://api.github.com/users/akien-mga/gists{/gist_id}","starred_url":"https://api.github.com/users/akien-mga/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/akien-mga/subscriptions","organizations_url":"https://api.github.com/users/akien-mga/orgs","repos_url":"https://api.github.com/users/akien-mga/repos","events_url":"https://api.github.com/users/akien-mga/events{/privacy}","received_events_url":"https://api.github.com/users/akien-mga/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"Why not simply?\r\n```suggestion\r\n\tif (OS::get_singleton()->get_environment(U\"METAL_DEVICE_WRAPPER_TYPE\") == U\"1\") {\r\n```\r\n\r\nI read the current code 3 times wondering why you were fetching an environment variable before overwriting it with `v = U\"1\"`, before I finally noticed that it's `v == U\"1\"`. This syntax is powerful but really not readable IMO :/\r\n\r\nI'm slowly warming up to this syntax:\r\n```cpp\r\nif (Node *node = Object::cast_to<Node>(obj)) {\r\n// do stuff with `node`\r\n}\r\n```\r\n\r\nBut the variant with a second statement chained in the same `if ()` conditional is straight out of the C++ purgatory :smiling_imp: ","created_at":"2025-05-23T20:29:38Z","updated_at":"2025-05-23T20:30:10Z","html_url":"https://github.com/godotengine/godot/pull/106732#discussion_r2105375374","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/106732","_links":{"self":{"href":"https://api.github.com/repos/godotengine/godot/pulls/comments/2105375374"},"html":{"href":"https://github.com/godotengine/godot/pull/106732#discussion_r2105375374"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/106732"}},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/2105375374/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":null,"original_line":48,"side":"RIGHT","author_association":"MEMBER","original_position":4,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/2105394907","pull_request_review_id":2865678867,"id":2105394907,"node_id":"PRRC_kwDOAO6SJc59fcbb","diff_hunk":"@@ -45,6 +45,10 @@ - (void)setShouldMaximizeConcurrentCompilation:(BOOL)v;\n }\n \n Error RenderingContextDriverMetal::initialize() {\n+\tif (String v = OS::get_singleton()->get_environment(U\"METAL_DEVICE_WRAPPER_TYPE\"); v == U\"1\") {","path":"drivers/metal/rendering_context_driver_metal.mm","commit_id":"7d93119353a0b47ce7ce1e715a0ead9b3e6db2fa","original_commit_id":"4c5beeaacff4886bd36cc17766d40db597984dda","user":{"login":"stuartcarnie","id":52852,"node_id":"MDQ6VXNlcjUyODUy","avatar_url":"https://avatars.githubusercontent.com/u/52852?v=4","gravatar_id":"","url":"https://api.github.com/users/stuartcarnie","html_url":"https://github.com/stuartcarnie","followers_url":"https://api.github.com/users/stuartcarnie/followers","following_url":"https://api.github.com/users/stuartcarnie/following{/other_user}","gists_url":"https://api.github.com/users/stuartcarnie/gists{/gist_id}","starred_url":"https://api.github.com/users/stuartcarnie/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/stuartcarnie/subscriptions","organizations_url":"https://api.github.com/users/stuartcarnie/orgs","repos_url":"https://api.github.com/users/stuartcarnie/repos","events_url":"https://api.github.com/users/stuartcarnie/events{/privacy}","received_events_url":"https://api.github.com/users/stuartcarnie/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"Will change 👍🏻 \r\n\r\n## Some thoughts\r\n\r\nI have written a lot of code in Swift, Rust, and Go, all of which support this similar syntax, so I'm quite used to it and a hard habit to break, but understand if you haven't used those languages it looks different. It is arguably similar to `for`, which has an initialiser expression.\r\n\r\nIn this case, I agree it is excessive, as we don't use `v` inside the `if` block or in alternative cases.\r\n\r\nIn cases where you want to test the value and then check it multiple times, such as:\r\n\r\n```c++\r\nif (String v = OS::get_singleton()->get_environment(U\"METAL_DEVICE_WRAPPER_TYPE\"); v == \"1\") {\r\n  // \r\n} else if (v == \"2\") { \r\n  //\r\n}\r\n// v no longer valid and keeps the stack smaller in debug builds\r\n```\r\n\r\nArguably cleaner than the following, as `v` outlasts the `if` block:\r\n\r\n```c++\r\nString v = OS::get_singleton()->get_environment(U\"METAL_DEVICE_WRAPPER_TYPE\");\r\nif (v == \"1\") {\r\n} else if (v == \"2\") {\r\n}\r\n// v still valid\r\n```\r\n\r\nAnother nice use case is capturing a pointer, so that you don't have an invalid pointer outside the scope of the `if` block:\r\n\r\n```c++\r\nif (SomeObj *v = Server::get_obj(\"name\"); v != nullptr) {\r\n  // use v\r\n}\r\n// v is out of scope\r\n```\r\n\r\nvs\r\n\r\n```c++\r\nSomeObj *v = Server::get_obj(\"name\");\r\nif (v) {\r\n}\r\n// v is a null pointer\r\n```\r\n\r\nI would argue that the following is more readable, as it conveys the programmer explicitly meant to test for `nullptr` vs accidentally using `=` vs `==`:\r\n\r\n```c++\r\nif (Node *node = Object::cast_to<Node>(obj); node != nullptr) {\r\n// do stuff with `node`\r\n}\r\n```\r\n\r\nJust trying to plead a case to have the syntax considered 😝 ","created_at":"2025-05-23T20:45:12Z","updated_at":"2025-05-23T20:45:13Z","html_url":"https://github.com/godotengine/godot/pull/106732#discussion_r2105394907","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/106732","_links":{"self":{"href":"https://api.github.com/repos/godotengine/godot/pulls/comments/2105394907"},"html":{"href":"https://github.com/godotengine/godot/pull/106732#discussion_r2105394907"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/106732"}},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/2105394907/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":null,"original_line":48,"side":"RIGHT","in_reply_to_id":2105375374,"author_association":"CONTRIBUTOR","original_position":4,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/2105399924","pull_request_review_id":2865687678,"id":2105399924,"node_id":"PRRC_kwDOAO6SJc59fdp0","diff_hunk":"@@ -45,6 +45,10 @@ - (void)setShouldMaximizeConcurrentCompilation:(BOOL)v;\n }\n \n Error RenderingContextDriverMetal::initialize() {\n+\tif (String v = OS::get_singleton()->get_environment(U\"METAL_DEVICE_WRAPPER_TYPE\"); v == U\"1\") {","path":"drivers/metal/rendering_context_driver_metal.mm","commit_id":"7d93119353a0b47ce7ce1e715a0ead9b3e6db2fa","original_commit_id":"4c5beeaacff4886bd36cc17766d40db597984dda","user":{"login":"stuartcarnie","id":52852,"node_id":"MDQ6VXNlcjUyODUy","avatar_url":"https://avatars.githubusercontent.com/u/52852?v=4","gravatar_id":"","url":"https://api.github.com/users/stuartcarnie","html_url":"https://github.com/stuartcarnie","followers_url":"https://api.github.com/users/stuartcarnie/followers","following_url":"https://api.github.com/users/stuartcarnie/following{/other_user}","gists_url":"https://api.github.com/users/stuartcarnie/gists{/gist_id}","starred_url":"https://api.github.com/users/stuartcarnie/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/stuartcarnie/subscriptions","organizations_url":"https://api.github.com/users/stuartcarnie/orgs","repos_url":"https://api.github.com/users/stuartcarnie/repos","events_url":"https://api.github.com/users/stuartcarnie/events{/privacy}","received_events_url":"https://api.github.com/users/stuartcarnie/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"Changed!","created_at":"2025-05-23T20:49:55Z","updated_at":"2025-05-23T20:49:55Z","html_url":"https://github.com/godotengine/godot/pull/106732#discussion_r2105399924","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/106732","_links":{"self":{"href":"https://api.github.com/repos/godotengine/godot/pulls/comments/2105399924"},"html":{"href":"https://github.com/godotengine/godot/pull/106732#discussion_r2105399924"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/106732"}},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/2105399924/reactions","total_count":