d_at":null,"archived_by":null}],"state":"closed","locked":false,"assignees":[],"milestone":{"url":"https://api.github.com/repos/godotengine/godot/milestones/25","html_url":"https://github.com/godotengine/godot/milestone/25","labels_url":"https://api.github.com/repos/godotengine/godot/milestones/25/labels","id":15520464,"node_id":"MI_kwDOAO6SJc4A7NLQ","number":25,"title":"4.8","description":"","creator":{"login":"Repiteo","id":17489292,"node_id":"MDQ6VXNlcjE3NDg5Mjky","avatar_url":"https://avatars.githubusercontent.com/u/17489292?v=4","gravatar_id":"","url":"https://api.github.com/users/Repiteo","html_url":"https://github.com/Repiteo","followers_url":"https://api.github.com/users/Repiteo/followers","following_url":"https://api.github.com/users/Repiteo/following{/other_user}","gists_url":"https://api.github.com/users/Repiteo/gists{/gist_id}","starred_url":"https://api.github.com/users/Repiteo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Repiteo/subscriptions","organizations_url":"https://api.github.com/users/Repiteo/orgs","repos_url":"https://api.github.com/users/Repiteo/repos","events_url":"https://api.github.com/users/Repiteo/events{/privacy}","received_events_url":"https://api.github.com/users/Repiteo/received_events","type":"User","user_view_type":"public","site_admin":false},"open_issues":343,"closed_issues":2335,"state":"open","created_at":"2026-04-13T15:59:35Z","updated_at":"2026-10-22T06:28:22Z","due_on":null,"closed_at":null},"comments":2,"created_at":"2026-06-18T09:21:16Z","updated_at":"2026-06-30T14:10:10Z","closed_at":"2026-06-18T18:19:40Z","assignee":null,"author_association":"MEMBER","issue_field_values":[],"type":null,"active_lock_reason":null,"draft":false,"pull_request":{"url":"https://api.github.com/repos/godotengine/godot/pulls/120393","html_url":"https://github.com/godotengine/godot/pull/120393","diff_url":"https://github.com/godotengine/godot/pull/120393.diff","patch_url":"https://github.com/godotengine/godot/pull/120393.patch","merged_at":"2026-06-18T18:19:40Z"},"body":"## What problem(s) does this PR solve?\r\n\r\nSilences this benign but annoying warning on Fedora 44 where Mesa ships the D3D12/WSL Dozen driver:\r\n\r\n```\r\nWARNING: GENERAL - Message Id Number: 0 | Message Id Name: Loader Message\r\n        terminator_CreateInstance: Received return code -9 from call to vkCreateInstance in ICD /usr/lib64/libvulkan_dzn.so. Skipping this driver.\r\n        Objects - 1\r\n                Object[0] - VK_OBJECT_TYPE_INSTANCE, Handle 850961280\r\n     at: _debug_messenger_callback (drivers/vulkan/rendering_context_driver_vulkan.cpp:646)\r\n```\r\n\r\n## Additional information\r\n\r\nThe warning was also present on Fedora 43 with an earlier version of Mesa, albeit with return code -3 (`VK_ERROR_INITIALIZATION_FAILED`). This was changed in https://gitlab.freedesktop.org/mesa/mesa/-/work_items/14341, which I hoped would fully remove this warning, but it seems the Vulkan loader still raises it if the error code is `VK_ERROR_INCOMPATIBLE_DRIVER`.\r\n\r\nThis should probably be changed in the loader itself, but for now let's silence it downstream. I'm not silencing the `code -3` case, as this could still flag actual initialization errors that the user may need to be aware of.\r\n\r\n- *Edit:* I proposed a change to Vulkan-Loader to silence it directly there: https://github.com/KhronosGroup/Vulkan-Loader/pull/1937. If that is accepted, we don't need to do it downstream, unless we want to do it temporarily until all common Linux distros are up-to-date (might take a year).\r\n  * *Edit 2:* This doesn't seem to be appropriate for upstream, so let's go with the downstream hack.","closed_by":{"login":"Repiteo","id":17489292,"node_id":"MDQ6VXNlcjE3NDg5Mjky","avatar_url":"https://avatars.githubusercontent.com/u/17489292?v=4","gravatar_id":"","url":"https://api.github.com/users/Repiteo","html_url":"https://github.com/Repiteo","followers_url":"https://api.github.com/users/Repiteo/followers","following_url":"https://api.github.com/users/Repiteo/following{/other_user}","gists_url":"https://api.github.com/users/Repiteo/gists{/gist_id}","starred_url":"https://api.github.com/users/Repiteo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Repiteo/subscriptions","organizations_url":"https://api.github.com/users/Repiteo/orgs","repos_url":"https://api.github.com/users/Repiteo/repos","events_url":"https://api.github.com/users/Repiteo/events{/privacy}","received_events_url":"https://api.github.com/users/Repiteo/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/120393/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/godotengine/godot/issues/120393/timeline","performed_via_github_app":null,"state_reason":null}