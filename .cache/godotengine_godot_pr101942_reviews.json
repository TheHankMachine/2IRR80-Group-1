[{"id":2647443977,"node_id":"PRR_kwDOAO6SJc6dzMoJ","user":{"login":"Nodragem","id":10520249,"node_id":"MDQ6VXNlcjEwNTIwMjQ5","avatar_url":"https://avatars.githubusercontent.com/u/10520249?u=d71d985bd08d9add33a64bf2f1c81288393da61d&v=4","gravatar_id":"","url":"https://api.github.com/users/Nodragem","html_url":"https://github.com/Nodragem","followers_url":"https://api.github.com/users/Nodragem/followers","following_url":"https://api.github.com/users/Nodragem/following{/other_user}","gists_url":"https://api.github.com/users/Nodragem/gists{/gist_id}","starred_url":"https://api.github.com/users/Nodragem/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Nodragem/subscriptions","organizations_url":"https://api.github.com/users/Nodragem/orgs","repos_url":"https://api.github.com/users/Nodragem/repos","events_url":"https://api.github.com/users/Nodragem/events{/privacy}","received_events_url":"https://api.github.com/users/Nodragem/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"I don't see any approve button with a grey checkmark on my side. But here is a first attempt at reviewing.\r\n\r\nWork as intended, but the code is introducing a distinction between the id of the selected item in the palette (i.e. `selected_mesh_palette_idx`) and its id in the mesh library (i.e. `selected_library_item_id`). \r\n\r\nThis means that the two variables have to be synced. Although @jamesmintram added functions to set their values and keep them in sync, I am a bit concerned that it could introduce bugs in the future as new developers may not know they should use these functions.\r\n\r\nIs there a way to only rely on only one id and convert it only when needed? ","state":"COMMENTED","html_url":"https://github.com/godotengine/godot/pull/101942#pullrequestreview-2647443977","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/101942","author_association":"CONTRIBUTOR","_links":{"html":{"href":"https://github.com/godotengine/godot/pull/101942#pullrequestreview-2647443977"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/101942"}},"submitted_at":"2025-02-27T12:59:58Z","commit_id":"fb0df41a4ddf20e0d5bee60f8c9f7fa01c37f088"},{"id":2730491980,"node_id":"PRR_kwDOAO6SJc6iwABM","user":{"login":"jamesmintram","id":108040,"node_id":"MDQ6VXNlcjEwODA0MA==","avatar_url":"https://avatars.githubusercontent.com/u/108040?u=865a6cb5f441328051d2e8e26d4213ddf967188f&v=4","gravatar_id":"","url":"https://api.github.com/users/jamesmintram","html_url":"https://github.com/jamesmintram","followers_url":"https://api.github.com/users/jamesmintram/followers","following_url":"https://api.github.com/users/jamesmintram/following{/other_user}","gists_url":"https://api.github.com/users/jamesmintram/gists{/gist_id}","starred_url":"https://api.github.com/users/jamesmintram/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/jamesmintram/subscriptions","organizations_url":"https://api.github.com/users/jamesmintram/orgs","repos_url":"https://api.github.com/users/jamesmintram/repos","events_url":"https://api.github.com/users/jamesmintram/events{/privacy}","received_events_url":"https://api.github.com/users/jamesmintram/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"","state":"COMMENTED","html_url":"https://github.com/godotengine/godot/pull/101942#pullrequestreview-2730491980","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/101942","author_association":"CONTRIBUTOR","_links":{"html":{"href":"https://github.com/godotengine/godot/pull/101942#pullrequestreview-2730491980"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/101942"}},"submitted_at":"2025-03-31T20:57:54Z","commit_id":"fb0df41a4ddf20e0d5bee60f8c9f7fa01c37f088"},{"id":2730493516,"node_id":"PRR_kwDOAO6SJc6iwAZM","user":{"login":"jamesmintram","id":108040,"node_id":"MDQ6VXNlcjEwODA0MA==","avatar_url":"https://avatars.git