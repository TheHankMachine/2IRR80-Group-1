_lock_reason":null,"draft":false,"pull_request":{"url":"https://api.github.com/repos/godotengine/godot/pulls/104462","html_url":"https://github.com/godotengine/godot/pull/104462","diff_url":"https://github.com/godotengine/godot/pull/104462.diff","patch_url":"https://github.com/godotengine/godot/pull/104462.patch","merged_at":"2025-05-13T21:28:00Z"},"body":"This is a maintenance update for the Arm astcenc ASTC compressor, updating to the upstream 5.3.0 release. This brings the compressor inline with the latest Khronos Data Format Specification, v1.4.0, which clarified some ambiguous compressor functionality. There are no major changes in terms of core codec functionality compared to the 4.8.0 release that Godot had been using, but many minor optimizations, bug fixes, and image quality improvements.\r\n\r\nThe biggest improvement for Godot users is that builds using the Visual Studio `cl.exe` compiler will now correctly default to the SSE2-optimized backend (on x86-64) and NEON-optimized backend (on Arm64) rather than the reference C backend. This makes compression more than 3 times faster. Builds using other compilers (GCC, LLVM/Clang) were not impacted by the underlying issue, and see no performance uplift.\r\n\r\n(For avoidance of doubt, I'm the upstream maintainer for astcenc at Arm).","closed_by":{"login":"Repiteo","id":17489292,"node_id":"MDQ6VXNlcjE3NDg5Mjky","avatar_url":"https://avatars.githubusercontent.com/u/17489292?v=4","gravatar_id":"","url":"https://api.github.com/users/Repiteo","html_url":"https://github.com/Repiteo","followers_url":"https://api.github.com/users/Repiteo/followers","following_url":"https://api.github.com/users/Repiteo/following{/other_user}","gists_url":"https://api.github.com/users/Repiteo/gists{/gist_id}","starred_url":"https://api.github.com/users/Repiteo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Repiteo/subscriptions","organizations_url":"https://api.github.com/users/Repiteo/orgs","repos_url":"https://api.github.com/users/Repiteo/repos","events_url":"https://api.github.com/users/Repiteo/events{/privacy}","received_events_url":"https://api.github.com/users/Repiteo/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/104462/reactions","total_count":6,"+1":3,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":3,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/godotengine/godot/issues/104462/timeline","performed_via_github_app":null,"state_reason":null}