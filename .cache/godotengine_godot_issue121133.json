default":false,"description":"","archived_at":null,"archived_by":null},{"id":279098219,"node_id":"MDU6TGFiZWwyNzkwOTgyMTk=","url":"https://api.github.com/repos/godotengine/godot/labels/topic:editor","name":"topic:editor","color":"ffee88","default":false,"description":"","archived_at":null,"archived_by":null}],"state":"closed","locked":false,"assignees":[],"milestone":{"url":"https://api.github.com/repos/godotengine/godot/milestones/25","html_url":"https://github.com/godotengine/godot/milestone/25","labels_url":"https://api.github.com/repos/godotengine/godot/milestones/25/labels","id":15520464,"node_id":"MI_kwDOAO6SJc4A7NLQ","number":25,"title":"4.8","description":"","creator":{"login":"Repiteo","id":17489292,"node_id":"MDQ6VXNlcjE3NDg5Mjky","avatar_url":"https://avatars.githubusercontent.com/u/17489292?v=4","gravatar_id":"","url":"https://api.github.com/users/Repiteo","html_url":"https://github.com/Repiteo","followers_url":"https://api.github.com/users/Repiteo/followers","following_url":"https://api.github.com/users/Repiteo/following{/other_user}","gists_url":"https://api.github.com/users/Repiteo/gists{/gist_id}","starred_url":"https://api.github.com/users/Repiteo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Repiteo/subscriptions","organizations_url":"https://api.github.com/users/Repiteo/orgs","repos_url":"https://api.github.com/users/Repiteo/repos","events_url":"https://api.github.com/users/Repiteo/events{/privacy}","received_events_url":"https://api.github.com/users/Repiteo/received_events","type":"User","user_view_type":"public","site_admin":false},"open_issues":343,"closed_issues":2335,"state":"open","created_at":"2026-04-13T15:59:35Z","updated_at":"2026-10-22T06:28:22Z","due_on":null,"closed_at":null},"comments":6,"created_at":"2026-07-09T12:09:47Z","updated_at":"2026-07-16T04:02:06Z","closed_at":"2026-07-15T17:00:28Z","assignee":null,"author_association":"CONTRIBUTOR","issue_field_values":[],"type":null,"active_lock_reason":null,"draft":false,"pull_request":{"url":"https://api.github.com/repos/godotengine/godot/pulls/121133","html_url":"https://github.com/godotengine/godot/pull/121133","diff_url":"https://github.com/godotengine/godot/pull/121133.diff","patch_url":"https://github.com/godotengine/godot/pull/121133.patch","merged_at":"2026-07-15T17:00:28Z"},"body":"## What problem(s) does this PR solve?\n\n- Closes #96003\n\nif you accidentally type `..` instead of `.` in an expression, like `obj..method()`, gdscript throws a misleading error that points at the wrong place (e.g. `Expected \":\" after \"if\" condition`). the reason is `..` (the `PERIOD_PERIOD` token) has no infix rule in the expression parser, so the parser just stops there and leaves the stray `..` sitting unconsumed. then whatever demands a token next (the colon after the if here) is what complains, so the error blames the colon instead of the actual `..`.\n\n## Additional information\n\ngave `PERIOD_PERIOD` an infix handler in the parser rules table that reports `Unexpected \"..\", did you mean \".\"?` and then recovers by treating it as a single `.`, so you get one clear error instead of the misleading one.\n\nthis only touches expressions - the valid `..` rest pattern in `match` goes through a separate code path, so it is untouched (checked it still parses fine). also confirmed normal `.` access still works. added a parser regression test at `parser/errors/double_dot`.","closed_by":{"login":"Repiteo","id":17489292,"node_id":"MDQ6VXNlcjE3NDg5Mjky","avatar_url":"https://avatars.githubusercontent.com/u/17489292?v=4","gravatar_id":"","url":"https://api.github.com/users/Repiteo","html_url":"https://github.com/Repiteo","followers_url":"https://api.github.com/users/Repiteo/followers","following_url":"https://api.github.com/users/Repiteo/following{/other_user}","gists_url":"https://api.github.com/users/Repiteo/gists{/gist_id}","starred_url":"https://api.github.com/users/Repiteo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Repiteo/subscriptions","organizations_url":"https://api.github.com/users/Repiteo/orgs","repos_url":"https://api.github.com/users/Repiteo/repos","events_url":"https://api.github.com/users/Repiteo/events{/privacy}","received_events_url":"https://api.github.com/users/Repiteo/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/121133/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/godotengine/godot/issues/121133/timeline","performed_via_github_app":null,"state_reason":null}