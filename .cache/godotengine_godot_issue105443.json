t":null,"archived_by":null},{"id":279097162,"node_id":"MDU6TGFiZWwyNzkwOTcxNjI=","url":"https://api.github.com/repos/godotengine/godot/labels/discussion","name":"discussion","color":"ccaaff","default":false,"description":"","archived_at":null,"archived_by":null},{"id":955079684,"node_id":"MDU6TGFiZWw5NTUwNzk2ODQ=","url":"https://api.github.com/repos/godotengine/godot/labels/breaks%20compat","name":"breaks compat","color":"b64245","default":false,"description":"","archived_at":null,"archived_by":null},{"id":1732720779,"node_id":"MDU6TGFiZWwxNzMyNzIwNzc5","url":"https://api.github.com/repos/godotengine/godot/labels/topic:gui","name":"topic:gui","color":"ffee88","default":false,"description":"","archived_at":null,"archived_by":null}],"state":"closed","locked":false,"assignees":[],"milestone":null,"comments":5,"created_at":"2025-04-15T22:17:54Z","updated_at":"2025-08-07T18:14:45Z","closed_at":"2025-08-07T18:08:09Z","assignee":null,"author_association":"CONTRIBUTOR","issue_field_values":[],"type":null,"active_lock_reason":null,"draft":false,"pull_request":{"url":"https://api.github.com/repos/godotengine/godot/pulls/105443","html_url":"https://github.com/godotengine/godot/pull/105443","diff_url":"https://github.com/godotengine/godot/pull/105443.diff","patch_url":"https://github.com/godotengine/godot/pull/105443.patch","merged_at":null},"body":"The new method `_get_connection_list_from_node` is named with the keyword `from`. `GraphEdit` already uses the keyword `from` to distinguish whether a connection is `from` or `to` a node or port, so this keyword incorrectly implies that the method returns a list of all connections `from` a given node (instead of returning all connections on the node, regardless of direction).\r\n\r\nAdditionally, `_get_connection_list` and `_get_connection_list_from_node` refer to the list of connections as `connection_list`, which is inconsistent with other methods such as `_get_connections_intersecting_with_rect`, `set_connections`, `clear_connections`, and `get_connections_description` that simply use `connections`.\r\n\r\nThis change resolves both linguistic issues by renaming `_get_connection_list` to `_get_connections` and `_get_connection_list_from_node` to `_get_connections_by_node`.\r\n\r\nRenaming `_get_connection_list` breaks compatibility with Godot 4.4","closed_by":{"login":"dawdle-deer","id":29020074,"node_id":"MDQ6VXNlcjI5MDIwMDc0","avatar_url":"https://avatars.githubusercontent.com/u/29020074?v=4","gravatar_id":"","url":"https://api.github.com/users/dawdle-deer","html_url":"https://github.com/dawdle-deer","followers_url":"https://api.github.com/users/dawdle-deer/followers","following_url":"https://api.github.com/users/dawdle-deer/following{/other_user}","gists_url":"https://api.github.com/users/dawdle-deer/gists{/gist_id}","starred_url":"https://api.github.com/users/dawdle-deer/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/dawdle-deer/subscriptions","organizations_url":"https://api.github.com/users/dawdle-deer/orgs","repos_url":"https://api.github.com/users/dawdle-deer/repos","events_url":"https://api.github.com/users/dawdle-deer/events{/privacy}","received_events_url":"https://api.github.com/users/dawdle-deer/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/105443/reactions","total_count":1,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":1},"timeline_url":"https://api.github.com/repos/godotengine/godot/issues/105443/timeline","performed_via_github_app":null,"state_reason":null}