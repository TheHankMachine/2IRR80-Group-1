ED","user":{"site_admin":false,"suspended":false,"updated_at":"0001-01-01T00:00:00Z","avatar_url":"https://avatars.githubusercontent.com/u/2223172?u=fc85633b469acb6e7baef4dba5171f19a2a4ff85&v=4","created_at":"0001-01-01T00:00:00Z","followers":0,"following":0,"html_url":"https://github.com/KoBeWi","id":2223172,"node_id":"MDQ6VXNlcjIyMjMxNzI=","login":"KoBeWi","type":"User","owned_private_repos":0,"public_gists":0,"public_repos":0,"total_private_repos":0,"url":"https://api.github.com/users/KoBeWi"},"body":"","html_url":"https://github.com/godotengine/godot/pull/117072#pullrequestreview-4022298584","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/117072","author_association":"MEMBER","submitted_at":"2026-03-27T16:30:41Z"},{"id":4113891373,"node_id":"PRR_kwDOAO6SJc71NQAt","state":"APPROVED","user":{"site_admin":false,"suspended":false,"updated_at":"0001-01-01T00:00:00Z","avatar_url":"https://avatars.githubusercontent.com/u/7645683?u=2867ee7fcd920bc19b7d1cbf4b10264b9bbc9326&v=4","created_at":"0001-01-01T00:00:00Z","followers":0,"following":0,"html_url":"https://github.com/bruvzg","id":7645683,"node_id":"MDQ6VXNlcjc2NDU2ODM=","login":"bruvzg","type":"User","owned_private_repos":0,"public_gists":0,"public_repos":0,"total_private_repos":0,"url":"https://api.github.com/users/bruvzg"},"body":"Seems to be working as expected. Code looks good.\n\nI would not list `*console.exe` wrapers as separate items, since these are tiny and not useful on their own, but it is fine to keep it as is (might make more sense to change Windows template structure to use ZIPs in the future).","html_url":"https://github.com/godotengine/godot/pull/117072#pullrequestreview-4113891373","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/117072","author_association":"MEMBER","submitted_at":"2026-04-15T13:21:49Z"},{"id":4114095759,"node_id":"PRR_kwDOAO6SJc71OB6P","state":"COMMENTED","user":{"site_admin":false,"suspended":false,"updated_at":"0001-01-01T00:00:00Z","avatar_url":"https://avatars.githubusercontent.com/u/4701338?u=4a42fd867f2c449fcc23adf635dd574dae98e6c2&v=4","created_at":"0001-01-01T00:00:00Z","followers":0,"following":0,"html_url":"https://github.com/akien-mga","id":4701338,"node_id":"MDQ6VXNlcjQ3MDEzMzg=","login":"akien-mga","type":"User","owned_private_repos":0,"public_gists":0,"public_repos":0,"total_private_repos":0,"url":"https://api.github.com/users/akien-mga"},"body":"","html_url":"https://github.com/godotengine/godot/pull/117072#pullrequestreview-4114095759","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/117072","author_association":"MEMBER","submitted_at":"2026-04-15T13:47:22Z"},{"id":4114162153,"node_id":"PRR_kwDOAO6SJc71OSHp","state":"COMMENTED","user":{"site_admin":false,"suspended":false,"updated_at":"0001-01-01T00:00:00Z","avatar_url":"https://avatars.githubusercontent.com/u/2223172?u=fc85633b469acb6e7baef4dba5171f19a2a4ff85&v=4","created_at":"0001-01-01T00:00:00Z","followers":0,"following":0,"html_url":"https://github.com/KoBeWi","id":2223172,"node_id":"MDQ6VXNlcjIyMjMxNzI=","login":"KoBeWi","type":"User","owned_private_repos":0,"public_gists":0,"public_repos":0,"total_private_repos":0,"url":"https://api.github.com/users/KoBeWi"},"body":"","html_url":"https://github.com/godotengine/godot/pull/117072#pullrequestreview-4114162153","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/117072","author_association":"MEMBER","submitted_at":"2026-04-15T13:55:57Z"},{"id":4116677777,"node_id":"PRR_kwDOAO6SJc71X4SR","state":"APPROVED","commit_id":"32ed89c094594d563ac0f6cc3ee01e3406c74054","user":{"site_admin":false,"suspended":false,"updated_at":"0001-01-01T00:00:00Z","avatar_url":"https://avatars.githubusercontent.com/u/41921395?u=74caa4e396a8e2995ac648a80f7488601d679e63&v=4","created_at":"0001-01-01T00:00:00Z","followers":0,"following":0,"html_url":"https://github.com/Alex2782","id":41921395,"node_id":"MDQ6VXNlcjQxOTIxMzk1","login":"Alex2782","type":"User","owned_private_repos":0,"public_gists":0,"public_repos":0,"total_private_repos":0,"url":"https://api.github.com/users/Alex2782"},"body":"Looks good!\n\nTested with https://godotengine.org/mirrorlist/4.7.dev4.json\nand code for Zip and HTTP requests checked.\n\n------------\n\nThe configuration/settings icon for downloading all files might be confusing for some users. I would simply display the download icon again if there aren't any more suitable icons available.\n\n<img width=\"723\" height=\"152\" alt=\"Image\" src=\"https://github.com/user-attachments/assets/8b23916a-275d-4ea1-a4fd-bade73f68a49\" />\n\n\n\n","html_url":"https://github.com/godotengine/godot/pull/117072#pullrequestreview-4116677777","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/117072","author_association":"MEMBER","submitted_at":"2026-04-15T20:41:55Z"},{"id":4116975895,"node_id":"PRR_kwDOAO6SJc71ZBEX","state":"APPROVED","commit_id":"32ed89c094594d563ac0f6cc3ee01e3406c74054","user":{"site_admin":false,"suspended":false,"updated_at":"0001-01-01T00:00:00Z","avatar_url":"https://avatars.githubusercontent.com/u/4701338?u=4a42fd867f2c449fcc23adf635dd574dae98e6c2&v=4","created_at":"0001-01-01T00:00:00Z","followers":0,"following":0,"html_url":"https://github.com/akien-mga","id":4701338,"node_id":"MDQ6VXNlcjQ3MDEzMzg=","login":"akien-mga","type":"User","owned_private_repos":0,"public_gists":0,"public_repos":0,"total_private_repos":0,"url":"https://api.github.com/users/akien-mga"},"body":"","html_url":"https://github.com/godotengine/godot/pull/117072#pullrequestreview-4116975895","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/117072","author_association":"MEMBER","submitted_at":"2026-04-15T21:33:12Z"},{"id":4117487226,"node_id":"PRR_kwDOAO6SJc71a956","state":"COMMENTED","commit_id":"32ed89c094594d563ac0f6cc3ee01e3406c74054","user":{"site_admin":false,"suspended":false,"updated_at":"0001-01-01T00:00:00Z","avatar_url":"https://avatars.githubusercontent.com/u/180032?u=68d23e7ee9cdf810da125e8510b72f845b9dccc8&v=4","created_at":"0001-01-01T00:00:00Z","followers":0,"following":0,"html_url":"https://github.com/Calinou","id":180032,"node_id":"MDQ6VXNlcjE4MDAzMg==","login":"Calinou","type":"User","owned_private_repos":0,"public_gists":0,"public_repos":0,"total_private_repos":0,"url":"https://api.github.com/users/Calinou"},"body":"","html_url":"https://github.com/godotengine/godot/pull/117072#pullrequestreview-4117487226","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/117072","author_association":"MEMBER","submitted_at":"2026-04-15T23:24:53Z"},{"id":4117529449,"node_id":"PRR_kwDOAO6SJc71bINp","state":"COMMENTED","commit_id":"32ed89c094594d563ac0f6cc3ee01e3406c74054","user":{"site_admin":false,"suspended":false,"updated_at":"0001-01-01T00:00:00Z","avatar_url":"https://avatars.githubusercontent.com/u/180032?u=68d23e7ee9cdf810da125e8510b72f845b9dccc8&v=4","created_at":"0001-01-01T00:00:00Z","followers":0,"following":0,"html_url":"https://github.com/Calinou","id":180032,"node_id":"MDQ6VXNlcjE4MDAzMg==","login":"Calinou","type":"User","owned_private_repos":0,"public_gists":0,"public_repos":0,"total_private_repos":0,"url":"https://api.github.com/users/Calinou"},"body":"Tested locally, it works as expected.\n\nSome feedback:\n\n- With this PR, it's no longer possible to install a `.tpz` file in the editor. I don't think this was used often in the 4.x days (as third-party builds that were available for multiple platforms became rarer), but it's worth noting.\n\n- When in offline mode, \"Error getting the list of mirrors\" still shows up when using a development build after a small delay:\n\n<img width=\"660\" height=\"755\" alt=\"Image\" src=\"https://github.com/user-attachments/assets/a43a5fb9-549e-497b-be4e-122b8e2ff761\" />\n\n- Removing export templates should have a confirmation dialog, as there's no way to undo the operation. While official templates can be easily redownloaded, this is not the case if you are far away from an Internet connection, or if you installed third-party export templates.\n\n  - The confirmation dialog could be skipped by holding <kbd>Shift</kbd> when clicking the delete icon.\n\nFor future PRs:\n\n- There should be a way to remove all export templates for an associated version, so you can quickly clean up old data after upgrading to a new version.\n\n  - In the long term, it might be worth deprecating the concept of a `.tpz` file and switch to a flat structure with ZIP files directly being downloaded (likely after moving the Windows/Linux templates to ZIPs). This could simplify the editor code significantly, and allow for CI platforms to download specific platforms easily.\n\n  - Alternatively, we could add a command line argument to download specific platforms for CI usage, but this requires a Godot process to be spun up, which takes more time to start than `curl` or `wget`.","html_url":"https://github.com/godotengine/godot/pull/117072#pullrequestreview-4117529449","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/117072","author_association":"MEMBER","submitted_at":"2026-04-15T23:39:58Z"}]