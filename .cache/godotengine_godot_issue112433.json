active_lock_reason":null,"draft":false,"pull_request":{"url":"https://api.github.com/repos/godotengine/godot/pulls/112433","html_url":"https://github.com/godotengine/godot/pull/112433","diff_url":"https://github.com/godotengine/godot/pull/112433.diff","patch_url":"https://github.com/godotengine/godot/pull/112433.patch","merged_at":null},"body":"In the past, folks have complained about `PhysicsDirectSpaceState3D::interset_ray()` returning a `Dictionary`\r\n\r\nThis PR demonstrates how we could instead have it fill a native struct when using the API via GDExtension.\r\n\r\nIt reuses an existing native struct (`PhysicsServer3DExtensionRayResult`) we already had registered to allow GDExtensions to define their own physics servers, and just moves it over to `physics_server_3d.h`. I think the name still works because \"Extension\" could refer to it being usable via GDExtension.\r\n\r\nThis is marked as a DRAFT because I haven't actually tested it yet, and we'd probably want to expose a few more things with native structs too (perhaps `RayParameters`, `ShapeResult`, `ShapeParameters` and `ShapeRestInfo`?)","closed_by":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/112433/reactions","total_count":20,"+1":14,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":6},"timeline_url":"https://api.github.com/repos/godotengine/godot/issues/112433/timeline","performed_via_github_app":null,"state_reason":null}