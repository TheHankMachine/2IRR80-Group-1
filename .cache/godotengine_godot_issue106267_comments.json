users/clayjohn/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-05-20T23:38:43Z","updated_at":"2025-05-20T23:38:43Z","body":"@Calinou https://github.com/godotengine/godot/issues/18320 did turn out to be a different issue, but it was an easy fix so I included it here as well!\r\n\r\nThis should be ready to go now","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2896065910/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2899157503","html_url":"https://github.com/godotengine/godot/pull/106267#issuecomment-2899157503","issue_url":"https://api.github.com/repos/godotengine/godot/issues/106267","id":2899157503,"node_id":"IC_kwDOAO6SJc6szaH_","user":{"login":"clayjohn","id":16521339,"node_id":"MDQ6VXNlcjE2NTIxMzM5","avatar_url":"https://avatars.githubusercontent.com/u/16521339?v=4","gravatar_id":"","url":"https://api.github.com/users/clayjohn","html_url":"https://github.com/clayjohn","followers_url":"https://api.github.com/users/clayjohn/followers","following_url":"https://api.github.com/users/clayjohn/following{/other_user}","gists_url":"https://api.github.com/users/clayjohn/gists{/gist_id}","starred_url":"https://api.github.com/users/clayjohn/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/clayjohn/subscriptions","organizations_url":"https://api.github.com/users/clayjohn/orgs","repos_url":"https://api.github.com/users/clayjohn/repos","events_url":"https://api.github.com/users/clayjohn/events{/privacy}","received_events_url":"https://api.github.com/users/clayjohn/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-05-21T20:30:19Z","updated_at":"2025-05-21T20:30:19Z","body":"> I'm not sure if we can make it so the driver will override the MSAA level in the root Viewport, which would make it behave closer to how forcing MSAA works on older OpenGL/D3D applications. I recall forcing MSAA in the driver worked correctly on Godot 2.x, but only sometimes…\r\n\r\nIt only applies to the Window's framebuffer. To make the override work we would need to render directly to the Window and not use the root Viewport.\r\n\r\nTo be clear, its not worth spending any time trying to support the NVidia MSAA overrides. There is a good reason they don't let you do this for Vulkan applications. ","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2899157503/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2902015456","html_url":"https://github.com/godotengine/godot/pull/106267#issuecomment-2902015456","issue_url":"https://api.github.com/repos/godotengine/godot/issues/106267","id":2902015456,"node_id":"IC_kwDOAO6SJc6s-T3g","user":{"login":"Repiteo","id":17489292,"node_id":"MDQ6VXNlcjE3NDg5Mjky","avatar_url":"https://avatars.githubusercontent.com/u/17489292?v=4","gravatar_id":"","url":"https://api.github.com/users/Repiteo","html_url":"https://github.com/Repiteo","followers_url":"https://api.github.com/users/Repiteo/followers","following_url":"https://api.github.com/users/Repiteo/following{/other_user}","gists_url":"https://api.github.com/users/Repiteo/gists{/gist_id}","starred_url":"https://api.github.com/users/Repiteo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Repiteo/subscriptions","organizations_url":"https://api.github.com/users/Repiteo/orgs","repos_url":"https://api.github.com/users/Repiteo/repos","events_url":"https://api.github.com/users/Repiteo/events{/privacy}","received_events_url":"https://api.github.com/users/Repiteo/received_eve