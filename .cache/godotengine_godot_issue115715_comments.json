users/Llerey/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Llerey/subscriptions","organizations_url":"https://api.github.com/users/Llerey/orgs","repos_url":"https://api.github.com/users/Llerey/repos","events_url":"https://api.github.com/users/Llerey/events{/privacy}","received_events_url":"https://api.github.com/users/Llerey/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-02-06T07:21:49Z","updated_at":"2026-02-06T07:21:49Z","body":"or only .csproj","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3858482874/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3860253232","html_url":"https://github.com/godotengine/godot/issues/115715#issuecomment-3860253232","issue_url":"https://api.github.com/repos/godotengine/godot/issues/115715","id":3860253232,"node_id":"IC_kwDOAO6SJc7mFsow","user":{"login":"oxygen","id":4642698,"node_id":"MDQ6VXNlcjQ2NDI2OTg=","avatar_url":"https://avatars.githubusercontent.com/u/4642698?v=4","gravatar_id":"","url":"https://api.github.com/users/oxygen","html_url":"https://github.com/oxygen","followers_url":"https://api.github.com/users/oxygen/followers","following_url":"https://api.github.com/users/oxygen/following{/other_user}","gists_url":"https://api.github.com/users/oxygen/gists{/gist_id}","starred_url":"https://api.github.com/users/oxygen/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/oxygen/subscriptions","organizations_url":"https://api.github.com/users/oxygen/orgs","repos_url":"https://api.github.com/users/oxygen/repos","events_url":"https://api.github.com/users/oxygen/events{/privacy}","received_events_url":"https://api.github.com/users/oxygen/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-02-06T12:46:43Z","updated_at":"2026-02-06T16:55:57Z","body":"I think you may test using the default export from Godot from the default template with an empty class extending Node as the main .cs script.\n\nJust set `<IlcDisableReflection>true</IlcDisableReflection>` in the generated .csproj.\n\nlibgodot_android.so is specifically crafted to look for a parameterless constructor for at least the main .cs script in the C# NativeAOT game assembly.","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3860253232/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3864587311","html_url":"https://github.com/godotengine/godot/issues/115715#issuecomment-3864587311","issue_url":"https://api.github.com/repos/godotengine/godot/issues/115715","id":3864587311,"node_id":"IC_kwDOAO6SJc7mWOwv","user":{"login":"Llerey","id":95129675,"node_id":"U_kgDOBauQSw","avatar_url":"https://avatars.githubusercontent.com/u/95129675?v=4","gravatar_id":"","url":"https://api.github.com/users/Llerey","html_url":"https://github.com/Llerey","followers_url":"https://api.github.com/users/Llerey/followers","following_url":"https://api.github.com/users/Llerey/following{/other_user}","gists_url":"https://api.github.com/users/Llerey/gists{/gist_id}","starred_url":"https://api.github.com/users/Llerey/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Llerey/subscriptions","organizations_url":"https://api.github.com/users/Llerey/orgs","repos_url":"https://api.github.com/users/Llerey/repos","events_url":"https://api.github.com/users/Llerey/events{/privacy}","received_events_url":"https://api.github.com/users/Llerey/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-02-07T14:20:09Z","updated_at":"2026-02-07T14:20:09Z","body":"What version of DotNet are you using? I can't compile Android AOT without replacing the compiler in .dotNet and modifying the project file to add the Android NDK.\nI'm making a modification similar to this one for Android NDK\nhttps://github.com/josephmoresena/NativeAOT-AndroidHelloJniLib\n\nand I replace the assembly arguments like this\n```\n#!/usr/bin/env bash\n[ -n \"$BASH_VERSION\" ]  exec /usr/bin/env bash bash \"$0\" \"$@\"\n\nREAL_DOTNET=\"/home/llerey/_dotnet/dotnet\"\n\nneed_bionic_fix=0\nargs=()\n\nargv=(\"$@\")\nn=${#argv[@]}\n\ni=0\nwhile (( i < n )); do\n  a=\"${argv[i]}\"\n\n  if [[ \"$a\" == \"-r\"  \"$a\" == \"--runtime\" ]]; then\n    if (( i + 1 < n )); then\n      rid=\"${argv[i+1]}\"\n      [[ \"$rid\" == linux-bionic-* ]] && need_bionic_fix=1\n      args+=(\"$a\" \"$rid\")\n      (( i += 2 ))\n      continue\n    else\n      args+=(\"$a\")\n      (( i += 1 ))\n      continue\n    fi\n  fi\n\n  if [[ \"$a\" == -rlinux-bionic-* || \"$a\" == --runtimelinux-bionic-* ]]; then\n    need_bionic_fix=1\n    args+=(\"$a\")\n    (( i += 1 ))\n    continue\n  fi\n\n  [[ \"$a\" == linux-bionic-* ]] && need_bionic_fix=1\n\n  args+=(\"$a\")\n  (( i += 1 ))\ndone\n\nif (( need_bionic_fix == 1 )); then\n  args+=(\"-p:DisableUnsupportedError=true\" \"-p:PublishAotUsingRuntimePack=true\")\nfi\n\nexec \"$REAL_DOTNET\" \"${args[@]}\"\n```\n\n\nWithout these tricks, I can't compile AOT. I also need to enable Linux Bionic in the project settings.","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3864587311/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3865084888","html_url":"https://github.com/godotengine/godot/issues/115715#issuecomment-3865084888","issue_url":"https://api.github.com/repos/godotengine/godot/issues/115715","id":3865084888,"node_id":"IC_kwDOAO6SJc7mYIPY","user":{"login":"oxygen","id":4642698,"node_id":"MDQ6VXNlcjQ2NDI2OTg=","avatar_url":"https://avatars.githubusercontent.com/u/4642698?v=4","gravatar_id":"","url":"https://api.github.com/users/oxygen","html_url":"https://github.com/oxygen","followers_url":"https://api.github.com/users/oxygen/followers","following_url":"https://api.github.com/users/oxygen/following{/other_user}","gists_url":"https://api.github.com/users/oxygen/gists{/gist_id}","starred_url":"https://api.github.com/users/oxygen/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/oxygen/subscriptions","organizations_url":"https://api.github.com/users/oxygen/orgs","repos_url":"https://api.github.com/users/oxygen/repos","events_url":"https://api.github.com/users/oxygen/events{/privacy}","received_events_url":"https://api.github.com/users/oxygen/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-02-07T18:51:03Z","updated_at":"2026-02-07T18:54:26Z","body":"Yes, you need to enable Linux Bionic.\n\nnet8.0\n\nI had to do some weird stuff to make things work before that Linux Bionic checkbox existed and haven't rolled back since.\n\nI extracted parts of csproj which is huge with other unrelated stuff:\n\n```xml\n<ItemGroup Condition=\"'$(RuntimeIdentifier)' == 'linux-bionic-arm64'\">\n    <LinkerArg Include=\"-Wl,--undefined-version\" />\n  </ItemGroup>\n\n<PropertyGroup>\n    <UseSystemHttpClient>true</UseSystemHttpClient>\n\n    <Configuration>ExportRelease</Configuration>\n\n    <TargetFramework>net8.0</TargetFramework>\n    <IlcOptimize>AggressiveInlining</IlcOptimize>\n\n    <EnableDynamicLoading>true</EnableDynamicLoading>\n    <JsonSerializerSourceGeneration>false</JsonSerializerSourceGeneration>\n    <JsonSourceGenerationMode>JsonDocument</JsonSourceGenerationMode>\n\n    <DisableUnsupportedError Condition=\"'$(RuntimeIdentifier)' == 'linux-bionic-arm64'\">true</DisableUnsupportedError>\n    <PublishAotUsingRuntimePack Condition=\"'$(RuntimeIdentifier)' == 'linux-bionic-arm64'\">true</PublishAotUsingRuntimePack>\n  \t<CppCompilerAndLinker Condition=\"'$(RuntimeIdentifier)' == 'linux-bionic-arm64' and '$(OS)' != 'Windows_NT'\">/Users/oxygen/Library/Android/sdk/ndk/29.0.13846066/toolchains/llvm/prebuilt/current-os/bin/clang</CppCompilerAndLinker>\n    <CppCompilerAndLinker Condition=\"'$(RuntimeIdentifier)' == 'linux-bionic-arm64' and '$(OS)' == 'Windows_NT'\">C:\\AndroidSDK\\ndk\\29.0.13846066\\toolchains\\llvm\\prebuilt\\current-os\\bin\\clang.exe</CppCompilerAndLinker>\n<StripSymbols Condition=\"'$(RuntimeIdentifier)' == 'linux-bionic-arm64'\">false</StripSymbols>\n\n    <PublishTrimmed>true</PublishTrimmed>\n    <EnableTrimAnalyzer>true</EnableTrimAnalyzer><!--this is true anyway if PublishTrimmed is true-->\n    <!-- <TrimUnusedDependencies>true</TrimUnusedDependencies> -->\n    <TrimmerSingleWarn>false</TrimmerSingleWarn>\n    <TrimmerRemoveSymbols>true</TrimmerRemoveSymbols>\n    <TrimMode>link</TrimMode><!-- full/link -->\n    <TrimmerDefaultAction>link</TrimmerDefaultAction>\n    <InvariantGlobalization Condition=\"'$(RuntimeIdentifier)' == 'linux-bionic-arm64'\">true</InvariantGlobalization>\n\n\n    <IlcGenerateStackTraceData>false</IlcGenerateStackTraceData>\n    <IlcGenerateCompleteTypeMetadata>false</IlcGenerateCompleteTypeMetadata>\n    <IlcTrimMetadata>true</IlcTrimMetadata>\n\n\n    <!-- https://github.com/MichalStrehovsky/sizoscope -->\n    <IlcGenerateDgmlFile>true</IlcGenerateDgmlFile>\n    <IlcGenerateMstatFile>true</IlcGenerateMstatFile>\n\n    <!-- <IlcSingleMethodSanityCheck>false</IlcSingleMethodSanityCheck> -->\n    <IlcOptimizationPreference>Size</IlcOptimizationPreference>\n    <IlcFoldIdenticalMethodBodies>true</IlcFoldIdenticalMethodBodies>\n\n    <AutoreleasePoolSupport>false</AutoreleasePoolSupport> \n    <DebuggerSupport>false</DebuggerSupport>\n    <EnableUnsafeBinaryFormatterSerialization>false</EnableUnsafeBinaryFormatterSerialization>\n    <EnableUnsafeUTF7Encoding>false</EnableUnsafeUTF7Encoding>\n    <EventSourceSupport>false</EventSourceSupport>\n    <Http3Support>false</Http3Support>\n    <HttpActivityPropagationSupport>false</HttpActivityPropagationSupport>\n    <InvariantGlobalization>true</InvariantGlobalization>\n    <MetadataUpdaterSupport>false</MetadataUpdaterSupport>\n    <MetricsSupport>false</MetricsSupport>\n    <StackTraceSupport>false</StackTraceSupport>\n    <UseNativeHttpHandler>true</UseNativeHttpHandler>\n    <UseSizeOptimizedLinq>true</UseSizeOptimizedLinq>\n    <UseSystemResourceKeys>true</UseSystemResourceKeys> <!-- UseSystemResourceKeys controls whether .NET includes full exception messages and resource strings or replaces them with resource keys (identifiers).-->\n\n    <PublishAot Condition=\"'$(RuntimeIdentifier)' == 'linux-bionic-arm64'\">true</PublishAot>\n    <Optimize>true</Optimize>\n\n    <IlcInstructionSet Condition=\"'$(RuntimeIdentifier)' == 'linux-bionic-arm64'\">neon</IlcInstructionSet>\n    <OptimizationPreference>Size</OptimizationPreference>\n\n    <DebugType Condition=\"'$(RuntimeIdentifier)' == 'linux-bionic-arm64'\">none</DebugType>\n    <DebugSymbols Condition=\"'$(RuntimeIdentifier)' == 'linux-bionic-arm64'\">false</DebugSymbols>\n    <IlcGenerateMapFile Condition=\"'$(RuntimeIdentifier)' == 'linux-bionic-arm64'\">false</IlcGenerateMapFile>\n    <IlcDisableUnsupportedError Condition=\"'$(RuntimeIdentifier)' == 'linux-bionic-arm64'\">true</IlcDisableUnsupportedError>\n\n    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>\n    <GenerateTargetFrameworkAttribute>false</GenerateTargetFrameworkAttribute>\n</PropertyGroup>\n```\n\n","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3865084888/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":