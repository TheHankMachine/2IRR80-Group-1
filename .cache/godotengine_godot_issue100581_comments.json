ents{/privacy}","received_events_url":"https://api.github.com/users/YeldhamDev/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-06-11T23:11:55Z","updated_at":"2025-06-11T23:11:55Z","body":"@lyuma The folding bug is fixed in #107430.","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2964513856/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null}]