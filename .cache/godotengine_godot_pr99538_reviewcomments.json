 \t\t\tt.max_bounds[2] = taabb.position.z + MAX(taabb.size.z, 0.0001);\n-\t\t\tt.pad0 = t.pad1 = 0; //make valgrind not complain\n+\n+\t\t\tt.cull_mode = RendererRD::MaterialStorage::ShaderData::CULL_BACK;\n+\n+\t\t\tRID material = mi.data.material[i];\n+\t\t\tif (material.is_valid()) {\n+\t\t\t\t// TODO: Switch based on rendering method.\n+\t\t\t\tif (OS::get_singleton()->get_current_rendering_method() == \"gl_compatibility\") {\n+\t\t\t\t\tGLES3::MaterialStorage *material_storage = GLES3::MaterialStorage::get_singleton();","path":"modules/lightmapper_rd/lightmapper_rd.cpp","commit_id":"a3525bc01509e3922095dc7ef687dfeaf9b7a00e","original_commit_id":"cb7de2e6ba0e079a55456782f07eccda2d7352dc","user":{"login":"clayjohn","id":16521339,"node_id":"MDQ6VXNlcjE2NTIxMzM5","avatar_url":"https://avatars.githubusercontent.com/u/16521339?v=4","gravatar_id":"","url":"https://api.github.com/users/clayjohn","html_url":"https://github.com/clayjohn","followers_url":"https://api.github.com/users/clayjohn/followers","following_url":"https://api.github.com/users/clayjohn/following{/other_user}","gists_url":"https://api.github.com/users/clayjohn/gists{/gist_id}","starred_url":"https://api.github.com/users/clayjohn/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/clayjohn/subscriptions","organizations_url":"https://api.github.com/users/clayjohn/orgs","repos_url":"https://api.github.com/users/clayjohn/repos","events_url":"https://api.github.com/users/clayjohn/events{/privacy}","received_events_url":"https://api.github.com/users/clayjohn/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"We shouldn't be accessing the internals of the renderer like this. We need to expose it though the RenderingServer. See `shader_get_code()` for an example of how that is done. \r\n\r\nEven better, we can avoid moving CullMode into ShaderData and just check the shader's mode, i.e.:\r\n```\r\nString MaterialStorage::shader_get_cull_mode(RID p_shader) const {\r\n\tconst GLES3::Shader *shader = shader_owner.get_or_null(p_shader);\r\n\tERR_FAIL_NULL_V(shader, RS::CULL_DISABLED);\r\n\tif (shader->mode == RS::SHADER_SPATIAL && shader->data) {\r\n\t\treturn shader->data->cull_mode; // Need to do a cast here to ensure it is SceneShaderData\r\n\t}\r\n\treturn RS::CULL_DISABLED; // RS::CullMode needs to be added\r\n}\r\n```\r\nThen you can also remove the `Cull` enum from `SceneShaderData` and use the `RS::CullMode` directly","created_at":"2024-11-22T19:24:20Z","updated_at":"2024-11-22T19:27:14Z","html_url":"https://github.com/godotengine/godot/pull/99538#discussion_r1854543031","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/99538","_links":{"self":{"href":"https://api.github.com/repos/godotengine/godot/pulls/comments/1854543031"},"html":{"href":"https://github.com/godotengine/godot/pull/99538#discussion_r1854543031"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/99538"}},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/1854543031/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":480,"start_side":"RIGHT","line":null,"original_line":481,"side":"RIGHT","author_association":"MEMBER","original_position":20,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/godotengine/godot/pulls/comments/1855233794","pull_request_review_id":2456446983,"id":1855233794,"node_id":"PRRC_kwDOAO6SJc5ulJ8C","diff_hunk":"@@ -470,7 +471,23 @@ void LightmapperRD::_create_acceleration_structures(RenderingDevice *rd, Size2i\n \t\t\tt.max_bounds[0] = taabb.position.x + MAX(taabb.size.x, 0.0001);\n \t\t\tt.max_bounds[1] = taabb.position.y + MAX(taabb.size.y, 0.0001);\n \t\t\tt.max_bounds[2] = taabb.position.z + MAX(taabb.size.z, 0.0001);\n-\t\t\tt.pad0 = t.pad1 = 0; //make valgrind not complain\n+\n+\t\t\tt.cull_mode = RendererRD::MaterialStorage::ShaderData::CULL_BACK;\n+\n+\t\t\tRID material = mi.data.material[i];\n+\t\t\tif (material.is_valid()) {\n+\t\t\t\t// TODO: Switch based on rendering method.\n+\t\t\t\tif (OS::get_singleton()->get_current_rendering_method() == \"gl_compatibility\") {\n+\t\t\t\t\tGLES3::MaterialStorage *material_storage = GLES3::MaterialStorage::get_singleton();","path":"modules/lightmapper_rd/lightmapper_rd.cpp","commit_id":"a3525bc01509e3922095dc7ef687dfeaf9b7a00e","original_commit_id":"cb7de2e6ba0e079a55456782f07eccda2d7352dc","user":{"login":"Geometror","id":50084500,"node_id":"MDQ6VXNlcjUwMDg0NTAw","avatar_url":"https://avatars.githubusercontent.com/u/50084500?v=4","gravatar_id":"","url":"https://api.github.com/users/Geometror","html_url":"https://github.com/Geometror","followers_url":"https://api.github.com/users/Geometror/followers","following_url":"https://api.github.com/users/Geometror/following{/other_user}","gists_url":"https://api.github.com/users/Geometror/gists{/gist_id}","starred_url":"https://api.github.com/users/Geometror/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Geometror/subscriptions","organizations_url":"https://api.github.com/users/Geometror/orgs","repos_url":"https://api.github.com/users/Geometror/repos","events_url":"https://api.github.com/users/Geometror/events{/privacy}","received_events_url":"https://api.github.com/users/Geometror/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"Done, feels cleaner this way. Although `shader_get_cull_mode` in MaterialStorage (RD) has to do two casts, not sure if there's a better way: \r\n```cpp\r\nRS::CullMode MaterialStorage::shader_get_cull_mode(RID p_shader) const {\r\n\tconst RendererRD::MaterialStorage::Shader *shader = shader_owner.get_or_null(p_shader);\r\n\tERR_FAIL_NULL_V(shader, RS::CULL_MODE_DISABLED);\r\n\tif (shader->type == ShaderType::SHADER_TYPE_3D && shader->data) {\r\n\t\tRendererSceneRenderImplementation::SceneShaderForwardClustered::Shade