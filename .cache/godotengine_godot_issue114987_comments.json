26-03-28T15:23:24Z","body":"It's in \"Project Settings\" under \"XR\" -> \"OpenXR\". The field is called \"Target API Version\":\n\n<img width=\"813\" height=\"246\" alt=\"Image\" src=\"https://github.com/user-attachments/assets/82ccbab8-ed58-45d1-9dc8-a9fe312ea3f9\" />\n\n","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4148256343/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4314779940","html_url":"https://github.com/godotengine/godot/issues/114987#issuecomment-4314779940","issue_url":"https://api.github.com/repos/godotengine/godot/issues/114987","id":4314779940,"node_id":"IC_kwDOAO6SJc8AAAABAS5RJA","user":{"login":"modelmode","id":161167636,"node_id":"U_kgDOCZs5FA","avatar_url":"https://avatars.githubusercontent.com/u/161167636?v=4","gravatar_id":"","url":"https://api.github.com/users/modelmode","html_url":"https://github.com/modelmode","followers_url":"https://api.github.com/users/modelmode/followers","following_url":"https://api.github.com/users/modelmode/following{/other_user}","gists_url":"https://api.github.com/users/modelmode/gists{/gist_id}","starred_url":"https://api.github.com/users/modelmode/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/modelmode/subscriptions","organizations_url":"https://api.github.com/users/modelmode/orgs","repos_url":"https://api.github.com/users/modelmode/repos","events_url":"https://api.github.com/users/modelmode/events{/privacy}","received_events_url":"https://api.github.com/users/modelmode/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-04-24T16:39:04Z","updated_at":"2026-04-24T16:39:04Z","body":"This worked! Thanks everyone!! Is there a more permanent fix for this incoming though? Is this something Meta has to do? ","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4314779940/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4315452797","html_url":"https://github.com/godotengine/godot/issues/114987#issuecomment-4315452797","issue_url":"https://api.github.com/repos/godotengine/godot/issues/114987","id":4315452797,"node_id":"IC_kwDOAO6SJc8AAAABATiVfQ","user":{"login":"dsnopek","id":191561,"node_id":"MDQ6VXNlcjE5MTU2MQ==","avatar_url":"https://avatars.githubusercontent.com/u/191561?v=4","gravatar_id":"","url":"https://api.github.com/users/dsnopek","html_url":"https://github.com/dsnopek","followers_url":"https://api.github.com/users/dsnopek/followers","following_url":"https://api.github.com/users/dsnopek/following{/other_user}","gists_url":"https://api.github.com/users/dsnopek/gists{/gist_id}","starred_url":"https://api.github.com/users/dsnopek/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/dsnopek/subscriptions","organizations_url":"https://api.github.com/users/dsnopek/orgs","repos_url":"https://api.github.com/users/dsnopek/repos","events_url":"https://api.github.com/users/dsnopek/events{/privacy}","received_events_url":"https://api.github.com/users/dsnopek/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-04-24T18:34:59Z","updated_at":"2026-04-24T18:34:59Z","body":"As far as we can tell, this is a bug on Meta's side, and there's nothing we can other than the workaround with \"Target API Version\"","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4315452797/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"pe