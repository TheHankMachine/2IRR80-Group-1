archived_by":null},{"id":283518733,"node_id":"MDU6TGFiZWwyODM1MTg3MzM=","url":"https://api.github.com/repos/godotengine/godot/labels/usability","name":"usability","color":"447744","default":false,"description":"","archived_at":null,"archived_by":null},{"id":283518839,"node_id":"MDU6TGFiZWwyODM1MTg4Mzk=","url":"https://api.github.com/repos/godotengine/godot/labels/documentation","name":"documentation","color":"ffddff","default":true,"description":"","archived_at":null,"archived_by":null}],"state":"closed","locked":false,"assignees":[],"milestone":{"url":"https://api.github.com/repos/godotengine/godot/milestones/25","html_url":"https://github.com/godotengine/godot/milestone/25","labels_url":"https://api.github.com/repos/godotengine/godot/milestones/25/labels","id":15520464,"node_id":"MI_kwDOAO6SJc4A7NLQ","number":25,"title":"4.8","description":"","creator":{"login":"Repiteo","id":17489292,"node_id":"MDQ6VXNlcjE3NDg5Mjky","avatar_url":"https://avatars.githubusercontent.com/u/17489292?v=4","gravatar_id":"","url":"https://api.github.com/users/Repiteo","html_url":"https://github.com/Repiteo","followers_url":"https://api.github.com/users/Repiteo/followers","following_url":"https://api.github.com/users/Repiteo/following{/other_user}","gists_url":"https://api.github.com/users/Repiteo/gists{/gist_id}","starred_url":"https://api.github.com/users/Repiteo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Repiteo/subscriptions","organizations_url":"https://api.github.com/users/Repiteo/orgs","repos_url":"https://api.github.com/users/Repiteo/repos","events_url":"https://api.github.com/users/Repiteo/events{/privacy}","received_events_url":"https://api.github.com/users/Repiteo/received_events","type":"User","user_view_type":"public","site_admin":false},"open_issues":351,"closed_issues":2337,"state":"open","created_at":"2026-04-13T15:59:35Z","updated_at":"2026-10-22T15:17:38Z","due_on":null,"closed_at":null},"comments":20,"created_at":"2025-10-07T17:29:55Z","updated_at":"2026-09-08T15:25:06Z","closed_at":"2026-08-05T14:52:34Z","assignee":null,"author_association":"CONTRIBUTOR","issue_field_values":[],"type":null,"active_lock_reason":null,"draft":false,"pull_request":{"url":"https://api.github.com/repos/godotengine/godot/pulls/111375","html_url":"https://github.com/godotengine/godot/pull/111375","diff_url":"https://github.com/godotengine/godot/pull/111375.diff","patch_url":"https://github.com/godotengine/godot/pull/111375.patch","merged_at":"2026-08-05T14:52:34Z"},"body":"<!--\r\nPlease target the `master` branch in priority.\r\n\r\nRelevant fixes are cherry-picked for stable branches as needed by maintainers.\r\n\r\nTo speed up the contribution process and avoid CI errors, please set up pre-commit hooks locally:\r\nhttps://contributing.godotengine.org/en/latest/engine/guidelines/code_style.html\r\n-->\r\nBased on and supersedes #63079, this adds a few fixes and touch-ups to the work done by @Calinou.\r\n\r\nThis PR adds support for admonitions/callouts to the editor's help (and tooltips), as well as to the `make_rst.py` script. Four admonition types are supported: `[note]`, [`warning]`, `[tip]`, and `[important]`. Nesting admonitions is supported by the editor but *not* supported by `make_rst.py`, and is not recommended.\r\n\r\n<img width=\"272\" height=\"145\" alt=\"image\" src=\"https://github.com/user-attachments/assets/74395075-4e03-4c2b-9103-b9906bd8aa86\" />\r\n<img width=\"272\" height=\"145\" alt=\"image\" src=\"https://github.com/user-attachments/assets/7262f221-ce26-4d21-b1f9-cab3c67d7d32\" />\r\n\r\nNote that these tags also work inline, but are obviously intended to be used as separate blocks. Multi-paragraph admonitions are also supported.\r\n\r\n<img width=\"515\" height=\"68\" alt=\"image\" src=\"https://github.com/user-attachments/assets/9626378d-7682-42a1-965a-690b83556462\" />\r\n\r\nConverting all existing class reference XML files to this new format was removed from #63079, because of the noise it introduces in the PR, the conflicts after each rebase, and because actually converting the files is better left for a separate PR. At the time of this writing, the number of occurrences for each type of admonition is the following:\r\n\r\n- Regex used: `\\[b\\](Note|Warning|Important|Tip) *: *\\[/b\\] *(.+?)\\n`\r\n- Notes: 3,382\r\n- Warnings: 127\r\n- Tips: 4\r\n- Important: 2\r\n- Replacing all occurrences can be done with `[\\L\\1\\E]\\2[/\\L\\1]\\n`\r\n\r\nhttps://github.com/godotengine/godot-docs/pull/12017 should be merged first, as `make_rst.py` does generate `.. classref_note::` for the Packed*Array types.","closed_by":{"login":"Repiteo","id":17489292,"node_id":"MDQ6VXNlcjE3NDg5Mjky","avatar_url":"https://avatars.githubusercontent.com/u/17489292?v=4","gravatar_id":"","url":"https://api.github.com/users/Repiteo","html_url":"https://github.com/Repiteo","followers_url":"https://api.github.com/users/Repiteo/followers","following_url":"https://api.github.com/users/Repiteo/following{/other_user}","gists_url":"https://api.github.com/users/Repiteo/gists{/gist_id}","starred_url":"https://api.github.com/users/Repiteo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Repiteo/subscriptions","organizations_url":"https://api.github.com/users/Repiteo/orgs","repos_url":"https://api.github.com/users/Repiteo/repos","events_url":"https://api.github.com/users/Repiteo/events{/privacy}","received_events_url":"https://api.github.com/users/Repiteo/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/111375/reactions","total_count":20,"+1":10,"-1":0,"laugh":0,"hooray":3,"confused":0,"heart":3,"rocket":4,"eyes":0},"timeline_url":"https://api.github.com/repos/godotengine/godot/issues/111375/timeline","performed_via_github_app":null,"state_reason":null}