d_by":null},{"id":2666708289,"node_id":"MDU6TGFiZWwyNjY2NzA4Mjg5","url":"https://api.github.com/repos/godotengine/godot/labels/topic:3d","name":"topic:3d","color":"ffee88","default":false,"description":"","archived_at":null,"archived_by":null}],"state":"closed","locked":false,"assignees":[],"milestone":{"url":"https://api.github.com/repos/godotengine/godot/milestones/25","html_url":"https://github.com/godotengine/godot/milestone/25","labels_url":"https://api.github.com/repos/godotengine/godot/milestones/25/labels","id":15520464,"node_id":"MI_kwDOAO6SJc4A7NLQ","number":25,"title":"4.8","description":"","creator":{"login":"Repiteo","id":17489292,"node_id":"MDQ6VXNlcjE3NDg5Mjky","avatar_url":"https://avatars.githubusercontent.com/u/17489292?v=4","gravatar_id":"","url":"https://api.github.com/users/Repiteo","html_url":"https://github.com/Repiteo","followers_url":"https://api.github.com/users/Repiteo/followers","following_url":"https://api.github.com/users/Repiteo/following{/other_user}","gists_url":"https://api.github.com/users/Repiteo/gists{/gist_id}","starred_url":"https://api.github.com/users/Repiteo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Repiteo/subscriptions","organizations_url":"https://api.github.com/users/Repiteo/orgs","repos_url":"https://api.github.com/users/Repiteo/repos","events_url":"https://api.github.com/users/Repiteo/events{/privacy}","received_events_url":"https://api.github.com/users/Repiteo/received_events","type":"User","user_view_type":"public","site_admin":false},"open_issues":341,"closed_issues":2335,"state":"open","created_at":"2026-04-13T15:59:35Z","updated_at":"2026-10-22T03:07:42Z","due_on":null,"closed_at":null},"comments":2,"created_at":"2026-04-28T21:11:37Z","updated_at":"2026-07-04T01:29:41Z","closed_at":"2026-06-18T15:25:19Z","assignee":null,"author_association":"MEMBER","issue_field_values":[],"type":null,"active_lock_reason":null,"draft":false,"pull_request":{"url":"https://api.github.com/repos/godotengine/godot/pulls/119071","html_url":"https://github.com/godotengine/godot/pull/119071","diff_url":"https://github.com/godotengine/godot/pull/119071.diff","patch_url":"https://github.com/godotengine/godot/pull/119071.patch","merged_at":"2026-06-18T15:25:19Z"},"body":"The existing glTF code contained this:\r\n\r\n<img width=\"1300\" height=\"1120\" alt=\"Screenshot 2026-04-28 at 2 03 42 PM\" src=\"https://github.com/user-attachments/assets/1c947f49-5573-4247-8ab3-6b0e65e64207\" />\r\n\r\nWith the old code, the top part would copy `p_state` into a new `state` variable. In normal cases, when a valid GLTFState is passed in, this would be fine, but useless.\r\n\r\nThen, that top code would \"handle\" it being null by instantiating `state`. This is useless, because it means the glTF data will be imported into a temporary object that disappears as soon as the function ends.\r\n\r\nFurthermore, it didn't use `state` consistently: `p_state` was used at the bottom. So it would fail anyway.\r\n\r\nThe correct behavior is: Check for `p_state` being null immediately at the start of the function. Don't copy or instantiate.\r\n\r\nBonus: I made the `Error` code consistently `ERR_INVALID_PARAMETER` instead of being `FAILED` in a few places.","closed_by":{"login":"Repiteo","id":17489292,"node_id":"MDQ6VXNlcjE3NDg5Mjky","avatar_url":"https://avatars.githubusercontent.com/u/17489292?v=4","gravatar_id":"","url":"https://api.github.com/users/Repiteo","html_url":"https://github.com/Repiteo","followers_url":"https://api.github.com/users/Repiteo/followers","following_url":"https://api.github.com/users/Repiteo/following{/other_user}","gists_url":"https://api.github.com/users/Repiteo/gists{/gist_id}","starred_url":"https://api.github.com/users/Repiteo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Repiteo/subscriptions","organizations_url":"https://api.github.com/users/Repiteo/orgs","repos_url":"https://api.github.com/users/Repiteo/repos","events_url":"https://api.github.com/users/Repiteo/events{/privacy}","received_events_url":"https://api.github.com/users/Repiteo/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/119071/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/godotengine/godot/issues/119071/timeline","performed_via_github_app":null,"state_reason":null}