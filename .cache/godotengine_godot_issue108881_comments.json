sers/notroid5/gists{/gist_id}","starred_url":"https://api.github.com/users/notroid5/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/notroid5/subscriptions","organizations_url":"https://api.github.com/users/notroid5/orgs","repos_url":"https://api.github.com/users/notroid5/repos","events_url":"https://api.github.com/users/notroid5/events{/privacy}","received_events_url":"https://api.github.com/users/notroid5/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-07-31T16:16:38Z","updated_at":"2025-07-31T16:16:38Z","body":"So what does this mean? Is it not supposed to be used like this? Or is this a bug that should be fixed?","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3140557771/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3140569924","html_url":"https://github.com/godotengine/godot/issues/108881#issuecomment-3140569924","issue_url":"https://api.github.com/repos/godotengine/godot/issues/108881","id":3140569924,"node_id":"IC_kwDOAO6SJc67MUtE","user":{"login":"AThousandShips","id":96648715,"node_id":"U_kgDOBcK-Cw","avatar_url":"https://avatars.githubusercontent.com/u/96648715?v=4","gravatar_id":"","url":"https://api.github.com/users/AThousandShips","html_url":"https://github.com/AThousandShips","followers_url":"https://api.github.com/users/AThousandShips/followers","following_url":"https://api.github.com/users/AThousandShips/following{/other_user}","gists_url":"https://api.github.com/users/AThousandShips/gists{/gist_id}","starred_url":"https://api.github.com/users/AThousandShips/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/AThousandShips/subscriptions","organizations_url":"https://api.github.com/users/AThousandShips/orgs","repos_url":"https://api.github.com/users/AThousandShips/repos","events_url":"https://api.github.com/users/AThousandShips/events{/privacy}","received_events_url":"https://api.github.com/users/AThousandShips/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-07-31T16:21:07Z","updated_at":"2025-07-31T17:51:42Z","body":"Try using `AnimatableBody2D` and see if the problem remains, `StaticBody2D` moves instantaneously to the target and doesn't affect other bodies, as per the documentation:\n> When `StaticBody2D` is moved, it is teleported to its new position without affecting other physics bodies in its path. If this is not desired, use `AnimatableBody2D` instead.\n\nSo if you are going to use `move_and_collide` I'd say you should use `AnimatableBody2D`, `StaticBody2D` is not designed for moving with physics, as documented","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3140569924/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null}]