[{"id":4229796274,"node_id":"PRR_kwDOAO6SJc78HZGy","user":{"login":"Ivorforce","id":2308167,"node_id":"MDQ6VXNlcjIzMDgxNjc=","avatar_url":"https://avatars.githubusercontent.com/u/2308167?u=f7f8e0273f784f5ec6f6b7fe4a88d449896eb48a&v=4","gravatar_id":"","url":"https://api.github.com/users/Ivorforce","html_url":"https://github.com/Ivorforce","followers_url":"https://api.github.com/users/Ivorforce/followers","following_url":"https://api.github.com/users/Ivorforce/following{/other_user}","gists_url":"https://api.github.com/users/Ivorforce/gists{/gist_id}","starred_url":"https://api.github.com/users/Ivorforce/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Ivorforce/subscriptions","organizations_url":"https://api.github.com/users/Ivorforce/orgs","repos_url":"https://api.github.com/users/Ivorforce/repos","events_url":"https://api.github.com/users/Ivorforce/events{/privacy}","received_events_url":"https://api.github.com/users/Ivorforce/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"The explicit copy in https://github.com/godotengine/godot/pull/115093/ wasn't a mistake. It was merely agnostic.\n\nWhen making core changes, we don't have time to understand every single caller. So instead of trying to fix them, risking introducing bugs, we make the interface change and change callers to do the same as they did before.\n\nMeanwhile, we hope people will in follow-ups fix the problems this kind of changes surfaces. As you do here :)\n\nIn this case it seems safe to use a reference since this is (observably) a leaf function. ","state":"APPROVED","html_url":"https://github.com/godotengine/godot/pull/118221#pullrequestreview-4229796274","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/118221","author_association":"MEMBER","_links":{"html":{"href":"https://github.com/godotengine/godot/pull/118221#pullrequestreview-4229796274"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/p