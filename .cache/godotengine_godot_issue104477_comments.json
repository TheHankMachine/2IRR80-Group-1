.github.com/users/martin951/subscriptions","organizations_url":"https://api.github.com/users/martin951/orgs","repos_url":"https://api.github.com/users/martin951/repos","events_url":"https://api.github.com/users/martin951/events{/privacy}","received_events_url":"https://api.github.com/users/martin951/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-05-08T12:52:43Z","updated_at":"2025-05-08T12:56:13Z","body":"Hey just want to +1 this issue. In my case, when I enable sub_emitter_keep_velocity, the sub emitter does inherit it, but the subemitter does not respect inherit_velocity_ratio. \n\nIs it possible you forgot to enable sub_emitter_keep_velocity where your subemitter does spawn particles, but they remain hidden behind the main particle?\nv4.4.1.stable.steam [49a5bc7b6]\n","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2862949005/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2866098018","html_url":"https://github.com/godotengine/godot/issues/104477#issuecomment-2866098018","issue_url":"https://api.github.com/repos/godotengine/godot/issues/104477","id":2866098018,"node_id":"IC_kwDOAO6SJc6q1S9i","user":{"login":"QbieShay","id":7917475,"node_id":"MDQ6VXNlcjc5MTc0NzU=","avatar_url":"https://avatars.githubusercontent.com/u/7917475?v=4","gravatar_id":"","url":"https://api.github.com/users/QbieShay","html_url":"https://github.com/QbieShay","followers_url":"https://api.github.com/users/QbieShay/followers","following_url":"https://api.github.com/users/QbieShay/following{/other_user}","gists_url":"https://api.github.com/users/QbieShay/gists{/gist_id}","starred_url":"https://api.github.com/users/QbieShay/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/QbieShay/subscriptions","organizations_url":"https://api.github.com/users/QbieShay/orgs","repos_url":"https://api.github.com/users/QbieShay/repos","events_url":"https://api.github.com/users/QbieShay/events{/privacy}","received_events_url":"https://api.github.com/users/QbieShay/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-05-09T10:51:39Z","updated_at":"2025-05-09T10:51:39Z","body":"@martin951 I think that's worth a separate bug report. Was there a version where this worked?","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2866098018/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2877054977","html_url":"https://github.com/godotengine/godot/issues/104477#issuecomment-2877054977","issue_url":"https://api.github.com/repos/godotengine/godot/issues/104477","id":2877054977,"node_id":"IC_kwDOAO6SJc6rfGAB","user":{"login":"BMagnu","id":6238428,"node_id":"MDQ6VXNlcjYyMzg0Mjg=","avatar_url":"https://avatars.githubusercontent.com/u/6238428?v=4","gravatar_id":"","url":"https://api.github.com/users/BMagnu","html_url":"https://github.com/BMagnu","followers_url":"https://api.github.com/users/BMagnu/followers","following_url":"https://api.github.com/users/BMagnu/following{/other_user}","gists_url":"https://api.github.com/users/BMagnu/gists{/gist_id}","starred_url":"https://api.github.com/users/BMagnu/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/BMagnu/subscriptions","organizations_url":"https://api.github.com/users/BMagnu/orgs","repos_url":"https://api.github.com/users/BMagnu/repos","events_url":"https://api.github.com/users/BMagnu/events{/privacy}","received_events_url":"https://api.github.com/users/BMagnu/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-05-13T15:51:59Z","updated_at":"2025-05-13T15:51:59Z","body":"As a hotfix, the following seems to work around the issue:\n\n```gdscript\nextends GPUParticles3D\n\nclass_name GPUParticles3DFix\n\n@onready\nvar last_global_position := global_position\n\nfunc _ready() -> void:\n\tset_process_internal(false)\n\tset_physics_process_internal(false)\n\nfunc _physics_process(delta : float) -> void:\n\tRenderingServer.particles_set_emitter_velocity(get_base(), (global_position - last_global_position) / delta)\n\tlast_global_position = global_position\n```","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2877054977/reactions","total_count":4,"+1":4,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3589878553","html_url":"https://github.com/godotengine/godot/issues/104477#issuecomment-3589878553","issue_url":"https://api.github.com/repos/godotengine/godot/issues/104477","id":3589878553,"node_id":"IC_kwDOAO6SJc7V-TMZ","user":{"login":"liljohn360","id":8534384,"node_id":"MDQ6VXNlcjg1MzQzODQ=","avatar_url":"https://avatars.githubusercontent.com/u/8534384?v=4","gravatar_id":"","url":"https://api.github.com/users/liljohn360","html_url":"https://github.com/liljohn360","followers_url":"https://api.github.com/users/liljohn360/followers","following_url":"https://api.github.com/users/liljohn360/following{/other_user}","gists_url":"https://api.github.com/users/liljohn360/gists{/gist_id}","starred_url":"https://api.github.com/users/liljohn360/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/liljohn360/subscriptions","organizations_url":"https://api.github.com/users/liljohn360/orgs","repos_url":"https://api.github.com/users/liljohn360/repos","events_url":"https://api.github.com/users/liljohn360/events{/privacy}","received_events_url":"https://api.github.com/users/liljohn360/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-11-28T16:33:22Z","updated_at":"2025-11-28T16:33:22Z","body":"> As a hotfix, the following seems to work around the issue:\n> \n> extends GPUParticles3D\n> \n> class_name GPUParticles3DFix\n> \n> @onready\n> var last_global_position := global_position\n> \n> func _ready() -> void:\n> \tset_process_internal(false)\n> \tset_physics_process_internal(false)\n> \n> func _physics_process(delta : float) -> void:\n> \tRenderingServer.particles_set_emitter_velocity(get_base(), (global_position - last_global_position) / delta)\n> \tlast_global_position = global_position\n\nThis hotfix appears to only work if the particle emitter is set to \"emitting\" in the editor before the game starts. If it isn't emitting, and begins to emit during the game, even on ready(), the velocity inheritance remains broken.","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3589878553/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3782980344","html_url":"https://github.com/godotengine/godot/issues/104477#issuecomment-3782980344","issue_url":"https://api.github.com/repos/godotengine/godot/issues/104477","id":3782980344,"node_id":"IC_kwDOAO6SJc7he7L4","user":{"login":"zommerfelds","id":1260622,"node_id":"MDQ6VXNlcjEyNjA2MjI=","avatar_url":"https://avatars.githubusercontent.com/u/1260622?v=4","gravatar_id":"","url":"https://api.github.com/users/zommerfelds","html_url":"https://github.com/zommerfelds","followers_url":"https://api.github.com/users/zommerfelds/followers","following_url":"https://api.github.com/users/zommerfelds/following{/other_user}","gists_url":"https://api.github.com/users/zommerfelds/gists{/gist_id}","starred_url":"https://api.github.com/users/zommerfelds/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/zommerfelds/subscriptions","organizations_url":"https://api.github.com/users/zommerfelds/orgs","repos_url":"https://api.github.com/users/zommerfelds/repos","events_url":"https://api.github.com/users/zommerfelds/events{/privacy}","received_events_url":"https://api.github.com/users/zommerfelds/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-01-22T07:38:47Z","updated_at":"2026-01-22T08:41:07Z","body":"EDITED\n\nThe workaround seems to also mess with the orign of the particles. I tried to fix it by applying a change to emission_shape_offset based on the velocity, but I couldn't get it to work reasonably.","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3782980344/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5078372632","html_url":"https://github.com/godotengine/godot/issues/104477#issuecomment-5078372632","issue_url":"https://api.github.com/repos/godotengine/godot/issues/104477","id":5078372632,"node_id":"IC_kwDOAO6SJc8AAAABLrHRGA","user":{"login":"levidavidmurray","id":46084870,"node_id":"MDQ6VXNlcjQ2MDg0ODcw","avatar_url":"https://avatars.githubusercontent.com/u/46084870?v=4","gravatar_id":"","url":"https://api.github.com/users/levidavidmurray","html_url":"https://github.com/levidavidmurray","followers_url":"https://api.github.com/users/levidavidmurray/followers","following_url":"https://api.github.com/users/levidavidmurray/following{/other_user}","gists_url":"https://api.github.com/users/levidavidmurray/gists{/gist_id}","starred_url":"https://api.github.com/users/levidavidmurray/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/levidavidmurray/subscriptions","organizations_url":"https://api.github.com/users/levidavidmurray/orgs","repos_url":"https://api.github.com/users/levidavidmurray/repos","events_url":"https://api.github.com/users/levidavidmurray/events{/privacy}","received_events_url":"https://api.github.com/users/levidavidmurray/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-07-25T11:49:08Z","updated_at":"2026-07-25T12:14:06Z","body":"> This hotfix appears to only work if the particle emitter is set to \"emitting\" in the editor before the game starts. If it isn't emitting, and begins to emit during the game, even on ready(), the velocity inheritance remains broken.\n\nThis is because internally `GPUParticles3D::set_emitting` calls `set_process_internal(true)` when `p_emitting` is true. I added this check to ensure internal processing is always disabled (although technically only needs to happen when emitting changes to true)\n```gdscript\nclass_name GPUParticles3D_InheritVelocityFix\nextends GPUParticles3D\n\nvar prev_position: Vector3\nvar prev_emitting: bool\n\nfunc _ready() -> void:\n\tprev_position = global_position\n\tprev_emitting = emitting\n\t_disable_internal_processing.call_deferred()\n\n\nfunc _physics_process(delta : float) -> void:\n\tRenderingServer.particles_set_emitter_velocity(get_base(), (global_position - prev_position) / delta)\n\n\tif emitting != prev_emitting:\n\t\t_disable_internal_processing.call_deferred()\n\t\tset_process_internal(false)\n\t\tset_physics_process_internal(false)\n\n\tprev_position = global_position\n\tprev_emitting = emitting\n\n\nfunc _disable_internal_processing() -> void:\n\tset_process_internal(false)\n\tset_physics_process_internal(false)\n\n```","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5078372632/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5088535208","html_url":"https://github.com/godotengine/godot/issues/104477#issuecomment-5088535208","issue_url":"https://api.github.com/repos/godotengine/godot/issues/104477","id":5088535208,"node_id":"IC_kwDOAO6SJc8AAAABL0ziqA","user":{"login":"zommerfelds","id":1260622,"node_id":"MDQ6VXNlcjEyNjA2MjI=","avatar_url":"https://avatars.githubusercontent.com/u/1260622?v=4","gravatar_id":"","url":"https://api.github.com/users/zommerfelds","html_url":"https://github.com/zommerfelds","followers_url":"https://api.github.com/users/zommerfelds/followers","following_url":"https://api.github.com/users/zommerfelds/following{/other_user}","gists_url":"https://api.github.com/users/zommerfelds/gists{/gist_id}","starred_url":"https://api.github.com/users/zommerfelds/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/zommerfelds/subscriptions","organizations_url":"https://api.github.com/users/zommerfelds/orgs","repos_url":"https://api.github.com/users/zommerfelds/repos","events_url":"https://api.github.com/users/zommerfelds/events{/privacy}","received_events_url":"https://api.github.com/users/zommerfelds/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-07-27T07:31:25Z","updated_at":"2026-07-27T07:31:25Z","body":"> This is because internally `GPUParticles3D::set_emitting` calls `set_process_internal(true)` when `p_emitting` is true. I added this check to ensure internal processing is always disabled (although technically only needs to happen when emitting changes to true) ...\n\nI don't change emitting, so this did not change anything.\n\nWithout workaround (velocity is wrong, particles should be going away from the center):\n<img width=\"1894\" height=\"1148\" alt=\"Image\" src=\"https://github.com/user-attachments/assets/40da518c-4e0d-4769-b0dd-db58daee0fa0\" />\n\nWith workaround (spawn point is wrong, should fire from the same spot):\n<img width=\"1894\" height=\"1148\" alt=\"Image\" src=\"https://github.com/user-attachments/assets/b22f6c2f-a485-47ae-8c22-5bcd88758ac1\" />\n\nGiven that the workaround doesn't work it would be really nice to have this issue addressed :)","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5088535208/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null}]