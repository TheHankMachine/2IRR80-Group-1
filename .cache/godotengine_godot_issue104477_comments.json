godotengine/godot/issues/104477","id":2745753050,"node_id":"IC_kwDOAO6SJc6jqN3a","user":{"login":"Thomasasia","id":19173387,"node_id":"MDQ6VXNlcjE5MTczMzg3","avatar_url":"https://avatars.githubusercontent.com/u/19173387?v=4","gravatar_id":"","url":"https://api.github.com/users/Thomasasia","html_url":"https://github.com/Thomasasia","followers_url":"https://api.github.com/users/Thomasasia/followers","following_url":"https://api.github.com/users/Thomasasia/following{/other_user}","gists_url":"https://api.github.com/users/Thomasasia/gists{/gist_id}","starred_url":"https://api.github.com/users/Thomasasia/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Thomasasia/subscriptions","organizations_url":"https://api.github.com/users/Thomasasia/orgs","repos_url":"https://api.github.com/users/Thomasasia/repos","events_url":"https://api.github.com/users/Thomasasia/events{/privacy}","received_events_url":"https://api.github.com/users/Thomasasia/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-03-22T21:14:05Z","updated_at":"2025-03-22T21:15:28Z","body":"In the other issue, in 4.3 this feature is functional but buggy. In this issue for 4.4 it does not function at all.\n\nIf this should nevertheless be in that issue, I will close this and move my report there. I just figured that since this is a clear regression it needs to be it's own report","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2745753050/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2745762434","html_url":"https://github.com/godotengine/godot/issues/104477#issuecomment-2745762434","issue_url":"https://api.github.com/repos/godotengine/godot/issues/104477","id":2745762434,"node_id":"IC_kwDOAO6SJc6jqQK