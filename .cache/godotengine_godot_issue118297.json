RP)\n\nN/A","closed_by":{"login":"ryevdokimov","id":105675984,"node_id":"U_kgDOBkx80A","avatar_url":"https://avatars.githubusercontent.com/u/105675984?v=4","gravatar_id":"","url":"https://api.github.com/users/ryevdokimov","html_url":"https://github.com/ryevdokimov","followers_url":"https://api.github.com/users/ryevdokimov/followers","following_url":"https://api.github.com/users/ryevdokimov/following{/other_user}","gists_url":"https://api.github.com/users/ryevdokimov/gists{/gist_id}","starred_url":"https://api.github.com/users/ryevdokimov/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/ryevdokimov/subscriptions","organizations_url":"https://api.github.com/users/ryevdokimov/orgs","repos_url":"https://api.github.com/users/ryevdokimov/repos","events_url":"https://api.github.com/users/ryevdokimov/events{/privacy}","received_events_url":"https://api.github.com/users/ryevdokimov/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/118297/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/godotengine/godot/issues/118297/timeline","performed_via_github_app":null,"state_reason":"duplicate","pinned_comment":null}