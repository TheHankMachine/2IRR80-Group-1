 (MRP)\r\n\r\n[4.4dev3mrp.zip](https://github.com/user-attachments/files/17652129/4.4dev3mrp.zip)\r\n","closed_by":{"login":"Nexusbeeyst","id":21175526,"node_id":"MDQ6VXNlcjIxMTc1NTI2","avatar_url":"https://avatars.githubusercontent.com/u/21175526?v=4","gravatar_id":"","url":"https://api.github.com/users/Nexusbeeyst","html_url":"https://github.com/Nexusbeeyst","followers_url":"https://api.github.com/users/Nexusbeeyst/followers","following_url":"https://api.github.com/users/Nexusbeeyst/following{/other_user}","gists_url":"https://api.github.com/users/Nexusbeeyst/gists{/gist_id}","starred_url":"https://api.github.com/users/Nexusbeeyst/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Nexusbeeyst/subscriptions","organizations_url":"https://api.github.com/users/Nexusbeeyst/orgs","repos_url":"https://api.github.com/users/Nexusbeeyst/repos","events_url":"https://api.github.com/users/Nexusbeeyst/events{/privacy}","received_events_url":"https://api.github.com/users/Nexusbeeyst/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/98903/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/godotengine/godot/issues/98903/timeline","performed_via_github_app":null,"state_reason":"completed","pinned_comment":null}