[{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2997905245","html_url":"https://github.com/godotengine/godot/issues/107912#issuecomment-2997905245","issue_url":"https://api.github.com/repos/godotengine/godot/issues/107912","id":2997905245,"node_id":"IC_kwDOAO6SJc6ysGdd","user":{"login":"AThousandShips","id":96648715,"node_id":"U_kgDOBcK-Cw","avatar_url":"https://avatars.githubusercontent.com/u/96648715?v=4","gravatar_id":"","url":"https://api.github.com/users/AThousandShips","html_url":"https://github.com/AThousandShips","followers_url":"https://api.github.com/users/AThousandShips/followers","following_url":"https://api.github.com/users/AThousandShips/following{/other_user}","gists_url":"https://api.github.com/users/AThousandShips/gists{/gist_id}","starred_url":"https://api.github.com/users/AThousandShips/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/AThousandShips/subscriptions","organizations_url":"https://api.github.com/users/AThousandShips/orgs","repos_url":"https://api.github.com/users/AThousandShips/repos","events_url":"https://api.github.com/users/AThousandShips/events{/privacy}","received_events_url":"https://api.github.com/users/AThousandShips/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-06-23T20:50:19Z","updated_at":"2025-06-23T20:50:19Z","body":"Is the plugin built for 4.5?","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2997905245/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2997909104","html_url":"https://github.com/godotengine/godot/issues/107912#issuecomment-2997909104","issue_url":"https://api.github.com/repos/godotengine/godot/issues/107912","id":2997909104,"node_id":"IC_kwDOAO6SJc6ysHZw","user":{"login":"owlnewworlds","id":156072785,"node_id":"U_kgDOCU17UQ","avatar_url":"https://avatars.githubusercontent.com/u/156072785?v=4","gravatar_id":"","url":"https://api.github.com/users/owlnewworlds","html_url":"https://github.com/owlnewworlds","followers_url":"https://api.github.com/users/owlnewworlds/followers","following_url":"https://api.github.com/users/owlnewworlds/following{/other_user}","gists_url":"https://api.github.com/users/owlnewworlds/gists{/gist_id}","starred_url":"https://api.github.com/users/owlnewworlds/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/owlnewworlds/subscriptions","organizations_url":"https://api.github.com/users/owlnewworlds/orgs","repos_url":"https://api.github.com/users/owlnewworlds/repos","events_url":"https://api.github.com/users/owlnewworlds/events{/privacy}","received_events_url":"https://api.github.com/users/owlnewworlds/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-06-23T20:52:05Z","updated_at":"2025-06-23T20:52:05Z","body":"> Is the plugin built for 4.5?\n\nNot yet. So there is a change in Godot and/or export template and it requires a new build from the plugin creator?","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2997909104/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2997918139","html_url":"https://github.com/godotengine/godot/issues/107912#issuecomment-2997918139","issue_url":"https://api.github.com/repos/godotengine/godot/issues/107912","id":2997918139,"node_id":"IC_kwDOAO6SJc6ysJm7","user":{"login":"AThousandShips","id":96648715,"node_id":"U_kgDOBcK-Cw","avatar_url":"https://avatars.githubusercontent.com/u/96648715?v=4","gravatar_id":"","url":"https://api.github.com/users/AThousandShips","html_url":"https://github.com/AThousandShips","followers_url":"https://api.github.com/users/AThousandShips/followers","following_url":"https://api.github.com/users/AThousandShips/following{/other_user}","gists_url":"https://api.github.com/users/AThousandShips/gists{/gist_id}","starred_url":"https://api.github.com/users/AThousandShips/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/AThousandShips/subscriptions","organizations_url":"https://api.github.com/users/AThousandShips/orgs","repos_url":"https://api.github.com/users/AThousandShips/repos","events_url":"https://api.github.com/users/AThousandShips/events{/privacy}","received_events_url":"https://api.github.com/users/AThousandShips/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-06-23T20:55:56Z","updated_at":"2025-06-23T20:55:56Z","body":"I don't know, but that's something that should be checked, that's probably the cause","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2997918139/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2997964063","html_url":"https://github.com/godotengine/godot/issues/107912#issuecomment-2997964063","issue_url":"https://api.github.com/repos/godotengine/godot/issues/107912","id":2997964063,"node_id":"IC_kwDOAO6SJc6ysU0f","user":{"login":"Alex2782","id":41921395,"node_id":"MDQ6VXNlcjQxOTIxMzk1","avatar_url":"https://avatars.githubusercontent.com/u/41921395?v=4","gravatar_id":"","url":"https://api.github.com/users/Alex2782","html_url":"https://github.com/Alex2782","followers_url":"https://api.github.com/users/Alex2782/followers","following_url":"https://api.github.com/users/Alex2782/following{/other_user}","gists_url":"https://api.github.com/users/Alex2782/gists{/gist_id}","starred_url":"https://api.github.com/users/Alex2782/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Alex2782/subscriptions","organizations_url":"https://api.github.com/users/Alex2782/orgs","repos_url":"https://api.github.com/users/Alex2782/repos","events_url":"https://api.github.com/users/Alex2782/events{/privacy}","received_events_url":"https://api.github.com/users/Alex2782/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-06-23T21:15:06Z","updated_at":"2025-06-23T21:15:06Z","body":" > it requires a new build from the plugin creator?\n\nI think yes.\n\n-------------\n`Suggestion: add 'tools:replace=\"android:value\"' to element at AndroidManifest.xml to override.`\n\nI had a similar error message myself a week ago when I was testing different PRs.\n\nI use `scu_build` and `ccache`. When I tried without them, this problem was no longer reproducible. \n_(Afterward, I reactivated scu and ccache.)_\n\n```\n                \"platform=android\",\n                \"target=template_debug\",\n                \"arch=arm64\",\n                \"generate_apk=true\",\n                \"generate_android_binaries=true\",\n                \"c_compiler_launcher=ccache\",\n                \"cpp_compiler_launcher=ccache\",\n                \"scu_build=true\",\n                \"scu_limit=256\",\n```\n\n\n\n\n","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2997964063/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2998004185","html_url":"https://github.com/godotengine/godot/issues/107912#issuecomment-2998004185","issue_url":"https://api.github.com/repos/godotengine/godot/issues/107912","id":2998004185,"node_id":"IC_kwDOAO6SJc6ysenZ","user":{"login":"synta