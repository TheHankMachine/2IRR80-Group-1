5683?u=2867ee7fcd920bc19b7d1cbf4b10264b9bbc9326&v=4","gravatar_id":"","url":"https://api.github.com/users/bruvzg","html_url":"https://github.com/bruvzg","followers_url":"https://api.github.com/users/bruvzg/followers","following_url":"https://api.github.com/users/bruvzg/following{/other_user}","gists_url":"https://api.github.com/users/bruvzg/gists{/gist_id}","starred_url":"https://api.github.com/users/bruvzg/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/bruvzg/subscriptions","organizations_url":"https://api.github.com/users/bruvzg/orgs","repos_url":"https://api.github.com/users/bruvzg/repos","events_url":"https://api.github.com/users/bruvzg/events{/privacy}","received_events_url":"https://api.github.com/users/bruvzg/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"It seems to fix the regression, so should be OK. But I'm not entirely sure how `Local to Scene` is supposed and expected to work.","state":"APPROVED","html_url":"https://github.com/godotengine/godot/pull/121983#pullrequestreview-5099077294","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/121983","author_association":"MEMBER","_links":{"html":{"href":"https://github.com/godotengine/godot/pull/121983#pullrequestreview-5099077294"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/121983"}},"submitted_at":"2026-09-03T07:33:28Z","commit_id":"9abe7bda81d8ca23fa2bd829615be77a641d9024"},{"id":5559460170,"node_id":"PRR_kwDOAO6SJc8AAAABS16hSg","user":{"login":"KoBeWi","id":2223172,"node_id":"MDQ6VXNlcjIyMjMxNzI=","avatar_url":"https://avatars.githubusercontent.com/u/2223172?u=fc85633b469acb6e7baef4dba5171f19a2a4ff85&v=4","gravatar_id":"","url":"https://api.github.com/users/KoBeWi","html_url":"https://github.com/KoBeWi","followers_url":"https://api.github.com/users/KoBeWi/followers","following_url":"https://api.github.com/users/KoBeWi/following{/other_user}","gists_url":"https://api.github.com/users/KoBeWi/gists{/gist_id}","starred_url":"https://api.github.com/users/KoBeWi/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/KoBeWi/subscriptions","organizations_url":"https://api.github.com/users/KoBeWi/orgs","repos_url":"https://api.github.com/users/KoBeWi/repos","events_url":"https://api.github.com/users/KoBeWi/events{/privacy}","received_events_url":"https://api.github.com/users/KoBeWi/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"This is incorrect. While the PR does fix the linked issues, it creates an opposite problem. `local_to_scene` is supposed to make the resource unique for each instance, but only at runtime. With this PR, external resources are never made unique, while built-in resources still become unique in the editor.\n\nThat's the expectation at least, based on the linked issues. The documentation also points to that, but it could be more explicit that it's not supposed to work in the editor (or at least not in the edited scene). Looks like the code completely does not account for instances and inherited scenes, GEN_EDIT_STATE_MAIN is used for the current scene in the editor.","state":"CHANGES_REQUESTED","html_url":"https://github.com/godotengine/godot/pull/121983#pullrequestreview-5559460170","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/121983","author_association":"MEMBER","_links":{"html":{"href":"https://github.com/godotengine/godot/pull/121983#pullrequestreview-5559460170"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/121983"}},"submitted_at":"2026-10-17T18:49:37Z","commit_id":"9abe7bda81d8ca23fa2bd829615be77a641d9024"}]