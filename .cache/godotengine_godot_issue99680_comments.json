s{/gist_id}","starred_url":"https://api.github.com/users/YeldhamDev/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/YeldhamDev/subscriptions","organizations_url":"https://api.github.com/users/YeldhamDev/orgs","repos_url":"https://api.github.com/users/YeldhamDev/repos","events_url":"https://api.github.com/users/YeldhamDev/events{/privacy}","received_events_url":"https://api.github.com/users/YeldhamDev/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2024-12-21T21:56:13Z","updated_at":"2024-12-21T21:56:13Z","body":"The selection limit has been implemented.","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2558250501/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2578681410","html_url":"https://github.com/godotengine/godot/pull/99680#issuecomment-2578681410","issue_url":"https://api.github.com/repos/godotengine/godot/issues/99680","id":2578681410,"node_id":"IC_kwDOAO6SJc6Zs45C","user":{"login":"clayjohn","id":16521339,"node_id":"MDQ6VXNlcjE2NTIxMzM5","avatar_url":"https://avatars.githubusercontent.com/u/16521339?v=4","gravatar_id":"","url":"https://api.github.com/users/clayjohn","html_url":"https://github.com/clayjohn","followers_url":"https://api.github.com/users/clayjohn/followers","following_url":"https://api.github.com/users/clayjohn/following{/other_user}","gists_url":"https://api.github.com/users/clayjohn/gists{/gist_id}","starred_url":"https://api.github.com/users/clayjohn/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/clayjohn/subscriptions","organizations_url":"https://api.github.com/users/clayjohn/orgs","repos_url":"https://api.github.com/users/clayjohn/repos","events_url":"https://api.github.com/users/clayjohn/events{/privacy}","received_events_url":"https://api.github.com/users/clayjohn/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-01-08T21:14:09Z","updated_at":"2025-01-08T21:14:09Z","body":"Having investigated this a bit, I notice that most of the code for `_find_3d_items_at_rect()` is copied from `Node3DEditorViewport::_select_region()`, but adapted to the SceneDebugger. This creates a couple problems:\r\n1. The code to support orthogonal cameras was lost in translation. This PR only works for perspective cameras\r\n2. There are a lot of unnecessary calculations that make the code difficult to read and run much slower than it should\r\n3. The code mixes the camera override with the scene camera at times leading to issues when you switch back to the scene camera after changing the camera override\r\n\r\nIt needs to be cleaned up before merging. ","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2578681410/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2578813879","html_url":"https://github.com/godotengine/godot/pull/99680#issuecomment-2578813879","issue_url":"https://api.github.com/repos/godotengine/godot/issues/99680","id":2578813879,"node_id":"IC_kwDOAO6SJc6ZtZO3","user":{"login":"YeldhamDev","id":30739239,"node_id":"MDQ6VXNlcjMwNzM5MjM5","avatar_url":"https://avatars.githubusercontent.com/u/30739239?v=4","gravatar_id":"","url":"https://api.github.com/users/YeldhamDev","html_url":"https://github.com/YeldhamDev","followers_url":"https://api.github.com/users/YeldhamDev/followers","following_url":"https://api.github.com/users/YeldhamDev/following{/other_user}","gists_url":"https://api.github.com/users/YeldhamDev/gists{/gist_id}","starred_url":"https://api.github.com/users/YeldhamDev/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/YeldhamDev/subscriptions","organizations_url":"https://api.github.com/users/YeldhamDev/orgs","repos_url":"https://api.github.com/users/YeldhamDev/repos","events_url":"https://api.github.com/users/YeldhamDev/events{/privacy}","received_events_url":"https://api.github.com/users/YeldhamDev/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-01-08T22:39:19Z","updated_at":"2025-01-08T22:39:19Z","body":"@clayjohn\r\n\r\n1. That was because I couldn't get the perspective selection to work, so I didn't think I would fare any better with orthogonal.\r\n2. Would help if you pointed to specific sections.\r\n3. Could you give me a step-by-step? I'm unable to reproduce this issue on my end.","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2578813879/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2578905351","html_url":"https://github.com/godotengine/godot/pull/99680#issuecomment-2578905351","issue_url":"https://api.github.com/repos/godotengine/godot/issues/99680","id":2578905351,"node_id":"IC_kwDOAO6SJc6ZtvkH","user":{"login":"clayjohn","id":16521339,"node_id":"MDQ6VXNlcjE2NTIxMzM5","avatar_url":"https://avatars.githubusercontent.com/u/16521339?v=4","gravatar_id":"","url":"https://api.github.com/users/clayjohn","html_url":"https://github.com/clayjohn","followers_url":"https://api.github.com/users/clayjohn/followers","following_url":"https://api.github.com/users/clayjohn/following{/other_user}","gists_url":"https://api.github.com/users/clayjohn/gists{/gist_id}","starred_url":"https://api.github.com/users/clayjohn/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/clayjohn/subscriptions","organizations_url":"https:/