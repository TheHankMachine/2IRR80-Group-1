[{"id":2947964295,"node_id":"PRR_kwDOAO6SJc6vtl2H","user":{"login":"kitbdev","id":10054226,"node_id":"MDQ6VXNlcjEwMDU0MjI2","avatar_url":"https://avatars.githubusercontent.com/u/10054226?u=f0c85fe8c24debe91dc14d7efa97b51a19250b47&v=4","gravatar_id":"","url":"https://api.github.com/users/kitbdev","html_url":"https://github.com/kitbdev","followers_url":"https://api.github.com/users/kitbdev/followers","following_url":"https://api.github.com/users/kitbdev/following{/other_user}","gists_url":"https://api.github.com/users/kitbdev/gists{/gist_id}","starred_url":"https://api.github.com/users/kitbdev/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/kitbdev/subscriptions","organizations_url":"https://api.github.com/users/kitbdev/orgs","repos_url":"https://api.github.com/users/kitbdev/repos","events_url":"https://api.github.com/users/kitbdev/events{/privacy}","received_events_url":"https://api.github.com/users/kitbdev/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"The column should also be 1 indexed.\r\n\r\nWe can't completely change to a 1 index system internally in the future, it would just cause lots of issues. The lines are stored in a vector which is always going to be 0 indexed, and it would cause compatibility issues if we change TextEdit and CodeEdit methods to be 1 indexed as well. I also doubt those editors all actually use 1 indexed internally, its just the interface.\r\nSo there is always going to be conversion between them, we just need to better define where it happens.\r\nWe already display line numbers in the editor as starting from 1, and `EditorInterface::edit_script` looks like it is already 1 indexed.","state":"COMMENTED","html_url":"https://github.com/godotengine/godot/pull/107816#pullrequestreview-2947964295","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/107816","author_association":"CONTRIBUTOR","_links":{"html":{"href":"https://github.com/godotengine/godot/pull/107816#pullrequestreview-2947964295"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/107816"}},"submitted_at":"2025-06-21T20:23:35Z","commit_id":null},{"id":2951156422,"node_id":"PRR_kwDOAO6SJc6v5xLG","user":{"login":"Meorge","id":9957987,"node_id":"MDQ6VXNlcjk5NTc5ODc=","avatar_url":"https://avatars.githubusercontent.com/u/9957987?u=64fc5e539030609be0447a74243d9fc643fa9bf3&v=4","gravatar_id":"","url":"https://api.github.com/users/Meorge","html_url":"https://github.com/Meorge","followers_url":"https://api.github.com/users/Meorge/followers","following_url":"https://api.github.com/users/Meorge/following{/other_user}","gists_url":"https://api.github.com/users/Meorge/gists{/gist_id}","starred_url":"https://api.github.com/users/Meorge/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Meorge/subscriptions","organizations_url":"https://api.github.com/users/Meorge/orgs","repos_url":"https://api.github.com/users/Meorge/repos","events_url":"https://api.github.com/users/Meorge/events{/privacy}","received_events_url":"https://api.github.com/users/Meorge/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"","state":"COMMENTED","html_url":"https://github.com/godotengine/godot/pull/107816#pullrequestreview-2951156422","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/107816","author_association":"CONTRIBUTOR","_links":{"html":{"href":"https://github.com/godotengine/godot/pull/107816#pullrequestreview-2951156422"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/107816"}},"submitted_at":"2025-06-23T18:33:17Z","commit_id":null},{"id":2951228734,"node_id":"PRR_kwDOAO6SJc6v6C0-","user":{"login":"kitbdev","id":10054226,"node_id":"MDQ6VXNlcjEwMDU0MjI2","avatar_url":"https://avatars.githubusercontent.com/u/10054226?u=f0c85fe8c24debe91dc14d7efa97b51a19250b47&v=4","gravatar_id":"","url":"https://api.github.com/users/kitbdev","html_url":"https://github.com/k