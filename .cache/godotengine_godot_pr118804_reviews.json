ythlikesclouds/repos","events_url":"https://api.github.com/users/blueskythlikesclouds/events{/privacy}","received_events_url":"https://api.github.com/users/blueskythlikesclouds/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"This should be fine. Also appears to work properly from my tests.\n\nThe FBO and color objects have the same life time. So checking for FBO's existence will have the same behavior as before, while also accounting for Android.\n\nThe PR needs rebase to collapse all commits into a single one.","state":"DISMISSED","html_url":"https://github.com/godotengine/godot/pull/118804#pullrequestreview-4163202000","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/118804","author_association":"MEMBER","_links":{"html":{"href":"https://github.com/godotengine/godot/pull/118804#pullrequestreview-4163202000"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/118804"}},"submitted_at":"2026-04-23T14:14:19Z","commit_id":"24e76381d193dcb90d19d309a4caaaa4963087da"},{"id":4163310201,"node_id":"PRR_kwDOAO6SJc74JxJ5","user":{"login":"blueskythlikesclouds","id":19259897,"node_id":"MDQ6VXNlcjE5MjU5ODk3","avatar_url":"https://avatars.githubusercontent.com/u/19259897?u=6ecace2ddb6505607f21e3c41da42157298bd406&v=4","gravatar_id":"","url":"https://api.github.com/users/blueskythlikesclouds","html_url":"https://github.com/blueskythlikesclouds","followers_url":"https://api.github.com/users/blueskythlikesclouds/followers","following_url":"https://api.github.com/users/blueskythlikesclouds/following{/other_user}","gists_url":"https://api.github.com/users/blueskythlikesclouds/gists{/gist_id}","starred_url":"https://api.github.com/users/blueskythlikesclouds/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/blueskythlikesclouds/subscriptions","organizations_url":"https://api.github.com/users/blueskythlikesclouds/orgs","repos_url":"https://api.github.com/users/blueskythlikesclouds/repos","events_url":"https://api.github.com/users/blueskythlikesclouds/events{/privacy}","received_events_url":"https://api.github.com/users/blueskythlikesclouds/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"Actually, I noticed a potential issue. This can still happen with the initial code you submitted.\r\n\r\nImagine the following scenario:\r\n- The MSAA framebuffer gets created. The intermediate texture gets attached to it in the Android path.\r\n- At some point in the next frame, \"use_internal_buffer\" becomes false.\r\n- The intermediate texture gets freed. The MSAA framebuffer is now attached to stale, freed textures, because it thinks there is no need to reconfigure it.\r\n\r\nThis scenario cannot happen in upstream because the MSAA framebuffer gets recreated, or is configured to be ignored, each time the function is called.","state":"COMMENTED","html_url":"https://github.com/godotengine/godot/pull/118804#pullrequestreview-4163310201","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/118804","author_association":"MEMBER","_links":{"html":{"href":"https://github.com/godotengine/godot/pull/118804#pullrequestreview-4163310201"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/118804"}},"submitted_at":"2026-04-23T14:27:13Z","commit_id":"24e76381d193dcb90d19d309a4caaaa4963087da"}]