.github.com/users/Mickeon/following{/other_user}","gists_url":"https://api.github.com/users/Mickeon/gists{/gist_id}","starred_url":"https://api.github.com/users/Mickeon/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Mickeon/subscriptions","organizations_url":"https://api.github.com/users/Mickeon/orgs","repos_url":"https://api.github.com/users/Mickeon/repos","events_url":"https://api.github.com/users/Mickeon/events{/privacy}","received_events_url":"https://api.github.com/users/Mickeon/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-06-02T12:40:43Z","updated_at":"2026-06-02T12:40:43Z","body":"I hope I do not sound scorn here. The entire note added by this PR could be replaced by saying \"Each value in the array should be a **non-negative** floating-point number\" instead. It's the same overall meaning, but does not require 20+ more words to explain it.\r\n\r\nIt is exceedingly unlikely that, due of the way weights are already described here, one would pass negative values **on purpose**. So that extra remark would not interest them.\r\n\r\nDespite this, I do think that the method _at least_ not sending warnings for the negative values is a big problem.","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4602466481/reactions","total_count":2,"+1":2,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4602499604","html_url":"https://github.com/godotengine/godot/pull/119948#issuecomment-4602499604","issue_url":"https://api.github.com/repos/godotengine/godot/issues/119948","id":4602499604,"node_id":"IC_kwDOAO6SJc8AAAABElSSFA","user":{"login":"PodunkGames","id":286503757,"node_id":"U_kgDOEROzTQ","avatar_url":"https://avatars.githubusercontent.com/u/286503757?v=4","gravatar_id":"","url":"https://api.github.com/users/PodunkGames","html_url":"https://github.com/PodunkGames","followers_url":"https://api.github.com/users/PodunkGames/followers","following_url":"https://api.github.com/users/PodunkGames/following{/other_user}","gists_url":"https://api.github.com/users/PodunkGames/gists{/gist_id}","starred_url":"https://api.github.com/users/PodunkGames/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/PodunkGames/subscriptions","organizations_url":"https://api.github.com/users/PodunkGames/orgs","repos_url":"https://api.github.com/users/PodunkGames/repos","events_url":"https://api.github.com/users/PodunkGames/events{/privacy}","received_events_url":"https://api.github.com/users/PodunkGames/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-06-02T12:45:13Z","updated_at":"2026-06-02T12:45:13Z","body":"> It's the same overall meaning, but does not require 20+ more words to explain it.\n\nBrevity has never been my strong point, I agree it could be written better.\n\nFor the sake of the warning bit, I'll get a report made when I get home. Thanks all. \n","author_association":"NONE","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4602499604/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4605977391","html_url":"https://github.com/godotengine/godot/pull/119948#issuecomment-4605977391","issue_url":"https://api.github.com/repos/godotengine/godot/issues/119948","id":4605977391,"node_id":"IC_kwDOAO6SJc8AAAABEomjLw","user":{"login":"kleonc","id":9283098,"node_id":"MDQ6VXNlcjkyODMwOTg=","avatar_url":"https://avatars.githubusercontent.com/u/9283098?v=4","gravatar_id":"","url":"https://api.github.com/users/kleonc","html_url":"https://github.com/kleonc","followers_url":"https://api.github.com/users/kleonc/followers","following_url":"https://api.github.com/users/kleonc/following{/other_user}","gists_url":"https://api.github.com/users/kleonc/gists{/gist_id}","starred_url":"https://api.github.com/users/kleonc/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/kleonc/subscriptions","organizations_url":"https://api.github.com/users/kleonc/orgs","repos_url":"https://api.github.com/users/kleonc/repos","events_url":"https://api.github.com/users/kleonc/events{/privacy}","received_events_url":"https://api.github.com/users/kleonc/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-06-02T18:45:45Z","updated_at":"2026-06-02T18:45:45Z","body":"> This more reasonable to add a note that weights should be non-negative, and have non-zero sum (and maybe add a checks).\r\n\r\nMentioning the \"non-zero sum\" part I don't think is needed. When passing an array full of zeros `rand_weighted` will (currently) return `-1` which is correct/sensible result (each entry has zero probability to be picked hence `-1` aka \"none\" is returned).","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4605977391/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4625958197","html_url":"https://github.com/godotengine/godot/pull/119948#issuecomment-4625958197","issue_url":"https://api.github.com/repos/godotengine/godot/issues/119948","id":4625958197,"node_id":"IC_kwDOAO6SJc8AAAABE7qFNQ","user":{"login":"PodunkGames","id":286503757,"node_id":"U_kgDOEROzTQ","avatar_url":"https://avatars.githubusercontent.com/u/286503757?v=4","gravatar_id":"","url":"https://api.github.com/users/PodunkGames","html_url":"https://github.com/PodunkGames","followers_url":"https://api.github.com/users/PodunkGames/followers","following_url