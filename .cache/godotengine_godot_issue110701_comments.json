":"https://api.github.com/users/betalars/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-10-03T21:46:50Z","updated_at":"2025-10-03T21:47:43Z","body":"Testing now on both Linux _and_ Max. So far I am only getting some wayland specific issues. (*I think that has to do more with the state of godot wayland and not hdr*)","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3367306025/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3373246596","html_url":"https://github.com/godotengine/godot/pull/110701#issuecomment-3373246596","issue_url":"https://api.github.com/repos/godotengine/godot/issues/110701","id":3373246596,"node_id":"IC_kwDOAO6SJc7JD6iE","user":{"login":"ArchercatNEO","id":108980279,"node_id":"U_kgDOBn7oNw","avatar_url":"https://avatars.githubusercontent.com/u/108980279?v=4","gravatar_id":"","url":"https://api.github.com/users/ArchercatNEO","html_url":"https://github.com/ArchercatNEO","followers_url":"https://api.github.com/users/ArchercatNEO/followers","following_url":"https://api.github.com/users/ArchercatNEO/following{/other_user}","gists_url":"https://api.github.com/users/ArchercatNEO/gists{/gist_id}","starred_url":"https://api.github.com/users/ArchercatNEO/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/ArchercatNEO/subscriptions","organizations_url":"https://api.github.com/users/ArchercatNEO/orgs","repos_url":"https://api.github.com/users/ArchercatNEO/repos","events_url":"https://api.github.com/users/ArchercatNEO/events{/privacy}","received_events_url":"https://api.github.com/users/ArchercatNEO/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-10-06T18:24:29Z","updated_at":"2025-10-06T18:24:29Z","body":"> Testing now on both Linux and Max. So far I am only getting some wayland specific issues. (I think that has to do more with the state of godot wayland and not hdr)\r\n\r\nCould you elaborate on what the issues are? Even if they're godot wayland issues they should be addressed and having bug reports is good.\r\n\r\nJust in case, quick checklist from other issues.\r\n1. You've definitely enabled the wayland server *within godot*? One of the remaining issues is warning if you try to use X11 and HDR but so far we don't have consensus on that.\r\n2. What compositor/version are you using? KDE Plasma 4.3+ is known working and there where some other issues with GNOME, not sure how other compositors fare with HDR so far.","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3373246596/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3378648492","html_url":"https://github.com/godotengine/godot/pull/110701#issuecomment-3378648492","issue_url":"https://api.github.com/repos/godotengine/godot/issues/110701","id":3378648492,"node_id":"IC_kwDOAO6SJc7JYhWs","user":{"login":"betalars","id":18014034,"node_id":"MDQ6VXNlcjE4MDE0MDM0","avatar_url":"https://avatars.githubusercontent.com/u/18014034?v=4","gravatar_id":"","url":"https://api.github.com/users/betalars","html_url":"https://github.com/betalars","followers_url":"https://api.github.com/users/betalars/followers","following_url":"https://api.github.com/users/betalars/following{/other_user}","gists_url":"https://api.github.com/users/betalars/gists{/gist_id}","starred_url":"https://api.github.com/users/betalars/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/betalars/subscriptions","organizations_url":"https://api.github.com/users/betalars/orgs","repos_url":"https://api.github.com/users/betalars/repos","events_url":"https://api.github.com/users/betalars/events{/privacy}","received_events_url":"https://api.github.com/users/betalars/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-10-07T20:44:21Z","updated_at":"2025-10-07T20:46:16Z","body":"> Could you elaborate on what the issues are? Even if they're godot wayland issues they should be addressed and having bug reports is good.\r\n\r\nThere was some  error spam that I read about in another PR/issue thread already so I did not bother to investigate further. Also I think the sizing of popup windows was a bit over the place at times. Can look into it. From what I've read wayland support seemed experimental. But if this is a misunderstanding, I will be more vigilant for weird behavior.\r\n\r\nIf I find anything new, I will make sure to see if there's an issue for that and if not make a new one.\r\n\r\nam on kde","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3378648492/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3619402015","html_url":"https://github.com/godotengine/godot/pull/110701#issuecomment-3619402015","issue_url":"https://api.github.com/repos/godotengine/godot/issues/110701","id":3619402015,"node_id":"IC_kwDOAO6SJc7Xu7Ef","user":{"login":"allenwp","id":17506573,"node_id":"MDQ6VXNlcjE3NTA2NTcz","avatar_url":"https://avatars.githubusercontent.com/u/17506573?v=4","gravatar_id":"","url":"https://api.github.com/users/allenwp","html_url":"https://github.com/allenwp","followers_url":"https://api.github.com/users/allenwp/followers","following_url":"https://api.github.com/users/allenwp/following{/other_user}","gists_url":"https://api.github.com/users/allenwp/gists{/gist_id}","starred_u