chived_by":null}],"state":"open","locked":false,"assignees":[],"milestone":{"url":"https://api.github.com/repos/godotengine/godot/milestones/16","html_url":"https://github.com/godotengine/godot/milestone/16","labels_url":"https://api.github.com/repos/godotengine/godot/milestones/16/labels","id":8237783,"node_id":"MI_kwDOAO6SJc4AfbLX","number":16,"title":"4.x","description":"Issues and pull requests slated for an undetermined Godot 4 release.","creator":{"login":"akien-mga","id":4701338,"node_id":"MDQ6VXNlcjQ3MDEzMzg=","avatar_url":"https://avatars.githubusercontent.com/u/4701338?v=4","gravatar_id":"","url":"https://api.github.com/users/akien-mga","html_url":"https://github.com/akien-mga","followers_url":"https://api.github.com/users/akien-mga/followers","following_url":"https://api.github.com/users/akien-mga/following{/other_user}","gists_url":"https://api.github.com/users/akien-mga/gists{/gist_id}","starred_url":"https://api.github.com/users/akien-mga/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/akien-mga/subscriptions","organizations_url":"https://api.github.com/users/akien-mga/orgs","repos_url":"https://api.github.com/users/akien-mga/repos","events_url":"https://api.github.com/users/akien-mga/events{/privacy}","received_events_url":"https://api.github.com/users/akien-mga/received_events","type":"User","user_view_type":"public","site_admin":false},"open_issues":5791,"closed_issues":0,"state":"open","created_at":"2022-07-26T12:42:05Z","updated_at":"2026-10-21T22:40:26Z","due_on":null,"closed_at":null},"comments":1,"created_at":"2026-05-06T15:24:06Z","updated_at":"2026-10-19T13:14:58Z","closed_at":null,"assignee":null,"author_association":"NONE","issue_field_values":[],"type":null,"active_lock_reason":null,"draft":false,"pull_request":{"url":"https://api.github.com/repos/godotengine/godot/pulls/119284","html_url":"https://github.com/godotengine/godot/pull/119284","diff_url":"https://github.com/godotengine/godot/pull/119284.diff","patch_url":"https://github.com/godotengine/godot/pull/119284.patch","merged_at":null},"body":"For now, Godot has nodes like: LineEdit, TextEdit, that accepts user's input.\r\nBut then I need a text editor that user can input and style the texts\r\nWe have a RichTextLabel already, but it cannot let user input on it, it's only for displaying texts.\r\nSo I wrote a new node [RichTextEdit], which extends from TextEdit, that user can input on it, then implemented RichTextLabel's BBcode styling feature on this [RichTextEdit] node,\r\nso it becomes a WYSIWYG text editor.\r\n\r\nI also created a new node called [RichTextEditToolbar], which is meant to be a demonstration to let user quickly know how to add style to the text, and also for someone who doesn't want to implement the toolbar themself, they can simply use this build-in toolbar as a prototype for thier project.\r\n\r\nI thought Godot's user might need a RichText Editor from time to time, so I want to add it to Godot engine.\r\nthere might be Godot's plugins that did this thing, but people tend to prefer built-in solutions over add-on plugins, and this newly added RichTextEdit node is purely C++ code,  integrates seamlessly into the core.\r\n\r\n----- Snapshots -----\r\n  ↓ RichTextEdit and the Text Sytle Toolbar\r\n<img width=\"1916\" height=\"1038\" alt=\"Scene\" src=\"https://github.com/user-attachments/assets/ddb8d97e-4d79-466d-9ede-5358281d839e\" />\r\n  \r\n  \r\n  \r\n  ↓ My C# code for testing, when text changed, printing the plain text and it's BBcode text\r\n<img width=\"904\" height=\"556\" alt=\"Demo_Code\" src=\"https://github.com/user-attachments/assets/bf229445-b024-43d2-a40f-35f3fa79da6c\" />\r\n\r\n  \r\n  \r\n  \r\n  \r\n\r\n\r\nhttps://github.com/user-attachments/assets/40172912-a854-41cf-bb3c-83aa34bf2a89\r\n\r\n\r\n\r\n- *Bugsquad edit: This closes https://github.com/godotengine/godot-proposals/issues/1781.*","closed_by":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/119284/reactions","total_count":21,"+1":9,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":9,"rocket":0,"eyes":3},"timeline_url":"https://api.github.com/repos/godotengine/godot/issues/119284/timeline","performed_via_github_app":null,"state_reason":null}