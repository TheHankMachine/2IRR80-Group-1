tps://api.github.com/users/smix8/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2024-12-11T11:37:48Z","updated_at":"2024-12-11T16:12:01Z","body":"Added editor menu option to create a `NavigationRegion2D` with a navigation mesh baked from the CSG result.\r\nAdded the option to script bake the CSG result to a navigation mesh with `bake_navigation_mesh()`.\r\nAdded the option to script bake the CSG result to an array of `OccluderPolygon2D` with `bake_light_occluders()`.","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2535669882/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2540171083","html_url":"https://github.com/godotengine/godot/pull/99911#issuecomment-2540171083","issue_url":"https://api.github.com/repos/godotengine/godot/issues/99911","id":2540171083,"node_id":"IC_kwDOAO6SJc6XZ-9L","user":{"login":"smix8","id":52464204,"node_id":"MDQ6VXNlcjUyNDY0MjA0","avatar_url":"https://avatars.githubusercontent.com/u/52464204?v=4","gravatar_id":"","url":"https://api.github.com/users/smix8","html_url":"https://github.com/smix8","followers_url":"https://api.github.com/users/smix8/followers","following_url":"https://api.github.com/users/smix8/following{/other_user}","gists_url":"https://api.github.com/users/smix8/gists{/gist_id}","starred_url":"https://api.github.com/users/smix8/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/smix8/subscriptions","organizations_url":"https://api.github.com/users/smix8/orgs","repos_url":"https://api.github.com/users/smix8/repos","events_url":"https://api.github.com/users/smix8/events{/privacy}","received_events_url":"https://api.github.com/users/smix8/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2024-12-12T22:54:36Z","updated_at":"2024-12-12T22:54:36Z","body":"Added a full fledged polygon editor with toolbar for the CSGPolygon2D.","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2540171083/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2540194063","html_url":"https://github.com/godotengine/godot/pull/99911#issuecomment-2540194063","issue_url":"https://api.github.com/repos/godotengine/godot/issues/99911","id":2540194063,"node_id":"IC_kwDOAO6SJc6XaEkP","user":{"login":"smix8","id":52464204,"node_id":"MDQ6VXNlcjUyNDY0MjA0","avatar_url":"https://avatars.githubusercontent.com/u/52464204?v=4","gravatar_id":"","url":"https://api.github.com/users/smix8","html_url":"https://github.com/smix8","followers_url":"https://api.github.com/users/smix8/followers","following_url":"https://api.github.com/users/smix8/following{/other_user}","gists_url":"https://api.github.com/users/smix8/gists{/gist_id}","starred_url":"https://api.github.com/users/smix8/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/smix8/subscriptions","organizations_url":"https://api.github.com/users/smix8/orgs","repos_url":"https://api.github.com/users/smix8/repos","events_url":"https://api.github.com/users/smix8/events{/privacy}","received_events_url":"https://api.github.com/users/smix8/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2024-12-12T23:13:32Z","updated_at":"2024-12-12T23:13:32Z","body":"Fixed a bug where the CSG would not react when the child node order changes.\r\nThis code was a direct copy from the 3D CSG that seem to have the same problem.","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2540194063/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2610399111","html_url":"https://github.com/godotengine/godot/pull/99911#issuecomment-2610399111","issue_url":"https://api.github.com/repos/godotengine/godot/issues/99911","id":2610399111,"node_id":"IC_kwDOAO6SJc6bl4eH","user":{"login":"KoBeWi","id":2223172,"node_id":"MDQ6VXNlcjIyMjMxNzI=","avatar_url":"https://avatars.githubusercontent.com/u/2223172?v=4","gravatar_id":"","url":"https://api.github.com/users/KoBeWi","html_url":"https://github.com/KoBeWi","followers_url":"https://api.github.com/users/KoBeWi/followers","following_url":"https://api.github.com/users/KoBeWi/following{/other_user}","gists_url":"https://api.github.com/users/KoBeWi/gists{/gist_id}","starred_url":"https://api.github.com/users/KoBeWi/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/KoBeWi/subscriptions","organizations_url":"https://api.github.com/users/KoBeWi/orgs","repos_url":"https://api.github.com/users/KoBeWi/repos","events_url":"https://api.github.com/users/KoBeWi/events{/privacy}","received_events_url":"https://api.github.com/users/KoBeWi/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-01-23T16:48:20Z","updated_at":"2025-01-23T22:31:57Z","body":"Baking CollisionShape fails for simple case:\r\n![image](https://github.com/user-attachments/assets/03bff50b-f5c3-47cd-8d9a-4e92b32f0f7d)\r\nEither it should create ConcavePolygonShape2D here, or you could add an option for CollisionPolygon2D (or the option could automatically fallback to CollisionPolygon2D if shape fails).\r\n\r\nAlso the bigger rectangle for rectangle shape looks weird:\r\n![image](https://github.com/user-attachments/assets/328dbf2e-5ad8-400b-9211-cce1c50051fe)\r\nIt makes sense for other shapes, because it allows to make e.g. ovals, but for rectangle it's redundant. They don't need to be scaled I think.\r\n\r\nEDIT:\r\nCSGCombiner has a weird gizmo that can be used to move it only left.\r\n![image](https://github.com/user-attachments/assets/f0aea274-1320-4817-be65-c8188fd0a216)\r\nIt appears only if it has 0 effective size.\r\n\r\nEDIT2:\r\nSomething is wrong with `debug_show_brush`.\r\n![image](https://github.com/user-attachments/assets/aa4e3fd4-4a3c-48de-91a7-d95564b5631c)\r\nAll 3 squares have the same size. Duplicating a shape with enabled debug will create shape with wrong debug. Not sure how the wrong-sized one got created.\r\nEDIT4: It breaks when you change size and undo.\r\n\r\nEDIT3:\r\nI made a tetronimo from squares and combiner, and it has weird geometry.\r\n![image](https://github.com/user-attachments/assets/4d682544-93a7-441e-b2f2-5f979e33646d)\r\nidk if it's expected.\r\n\r\nEDIT5:\r\nWhen you bake a shape with `vertex_color` into Polygon2D, the polygon does not use the same color. Intended?","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2610399111/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2639257516","html_url":"https://github.com/godotengine/godot/pull/99911#issuecomment-2639257516","issue_url":"https://api.github.com/repos/godotengine/godot/issues/99911","id":2639257516,"node_id":"IC_kwDOAO6SJc6dT9-s","user":{"login":"smix8","id":52464204,"node_id":"MDQ6VXNlcjUyNDY0MjA0","avatar_url":"https://avatars.githubusercontent.com/u/52464204?v=4","gravatar_id":"","url":"https://api.github.com/users/smix8","html_url":"https://github.com/smix8","followers_url":"https://api.github.com/users/smix8/followers","following_url":"https://api.github.com/users/smix8/following{/other_user}","gists_url":"https://api.github.com/users/smix8/gists{/gist_id}","starred_url":"https://api.github.com/users/smix8/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/smix8/subscriptions","organizations_url":"https://api.github.com/users/smix8/orgs","repos_url":"https://api.github.com/users/smix8/repos","events_url":"https://api.github.com/users/smix8/events{/privacy}","received_events_url":"https://api.github.com/users/smix8/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-02-06T09:24:12Z","updated_at":"2025-02-06T09:26:25Z","body":"> I made a tetronimo from squares and combiner, and it has weird geometry.\r\n\r\nThat is because the editor tooling for `Polygon2D` is broken when using the multi `polygons` array instead of the single `polygon` array. Your shape is concave so it is multiple polygons and Polygon2D can not display that correctly in the editor.\r\n\r\n> Baking CollisionShape fails for simple case:\r\n\r\nSimple is relative. Outline based boolean ops regularly \"fail\" on perfectly axis-aligned geometry due to precision and because the interpretation of the outline becomes a coin flip when things are perfectly symmetrical.\r\n\r\nFor the algorithm it does not matter if you only use 1-2 outlines with an expected \"obvious result\" or 100-200 outlines. If one outline gets interpreted wrong it has a chance to fail the convex decomposition. It is the failed convex decomp which results in no shapes being generated no matter what node type you are using. Like if you have broken outline data and convert it to a convex CollisionPolygon that is also set to use convex shapes you have the same problems.\r\n\r\n> Also the bigger rectangle for rectangle shape looks weird:\r\n\r\nI think the scaling rect looks and feels bad for all shapes but I added it for consistency with other 2d toolings. In general I do not like scaling of 2d nodes, it all just adds up to causing precision problems especially in all those lowres pixel focused 2d games.\r\n\r\n> When you bake a shape with vertex_color into Polygon2D, the polygon does not use the same color. Intended?\r\n\r\nIf you bake to a mesh it copies the set vertex color over but by default color is set to white. The editor display of the CSG is very different not just in color, but also because it has edge line and face geometry.","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2639257516/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2655268318","html_url":"https://github.com/godotengine/godot/pull/99911#issuecomment-2655268318","issue_url":"https://api.github.com/repos/godotengine/godot/issues/99911","id":2655268318,"node_id":"IC_kwDOAO6SJc6eRC3e","user":{"login":"smix8","id":52464204,"node_id":"MDQ6VXNlcjUyNDY0MjA0","avatar_url":"https://avatars.githubusercontent.com/u/52464204?v=4","gravatar_id":"","url":"https://api.github.com/users/smix8","html_url":"https://github.com/smix8","followers_url":"https://api.github.com/users/smix8/followers","following_url":"https://api.github.com/users/smix8/following{/other_user}","gists_url":"https://api.github.com/users/smix8/gists{/gist_id}","starred_url":"https://api.github.com/users/smix8/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/smix8/subscriptions","organizations_url":"https://api.github.com/users/smix8/orgs","repos_url":"https://api.github.com/users/smix8/repos","events_url":"https://api.github.com/users/smix8/events{/privacy}","received_events_url":"https://api.github.com/users/smix8/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-02-13T02:06:20Z","updated_at":"2025-02-13T02:06:20Z","body":"> This does not occur with other baking types ...\r\n\r\nThere are other bake types that can result into multiple shapes or nodes depending on settings and composition, e.g. the light occluders. I added them but frankly those (s) behind node names look visually poor, especially on buttons.\r\n\r\n> Bake Polygon2D does not reuse the vertex color ...\r\n\r\nAdded that if `use_vertex_color` is enabled on the CSG that the baked Poygon2D has that color copied into the `vertex_colors` property.","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2655268318/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2657639518","html_url":"https://github.com/godotengine/godot/pull/99911#issuecomment-2657639518","issue_url":"https://api.github.com/repos/godotengine/godot/issues/99911","id":2657639518,"node_id":"IC_kwDOAO6SJc6eaFxe","user":{"login":"KoBeWi","id":2223172,"node_id":"MDQ6VXNlcjIyMjMxNzI=","avatar_url":"https://avatars.githubusercontent.com/u/2223172?v=4","gravatar_id":"","url":"https://api.github.com/users/KoBeWi","html_url":"https://github.com/KoBeWi","followers_url":"https://api.github.com/users/KoBeWi/followers","following_url":"https://api.github.com/users/KoBeWi/following{/other_user}","gists_url":"https://api.github.com/users/KoBeWi/gists{/gist_id}","starred_url":"https://api.github.com/users/KoBeWi/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/KoBeWi/subscriptions","organizations_url":"https://api.github.com/users/KoBeWi/orgs","repos_url":"https://api.github.com/users/KoBeWi/repos","events_url":"https://api.github.com/users/KoBeWi/events{/privacy}","received_events_url":"https://api.github.com/users/KoBeWi/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-02-13T20:25:39Z","updated_at":"2025-02-13T20:26:21Z","body":"From the things I reported previously, only the polygon color was fixed.\r\nYou should fix at least debug brushes, because they are completely broken with undo and duplication, and the empty combiner gizmo.\r\n\r\nYou could also resolve my point about failed CollisionShape2D baking. Polygon2D is already an option, so fallback to CollisionPolygon2D is possible too. CollisionShape2D and PolygonShape2D are more or less interchangeable and you can use the same data as in Polygon2D.\r\n![image](https://github.com/user-attachments/assets/4a425665-f22b-4d72-94db-ebdda643c338)\r\n\r\n> I added it for consistency with other 2d toolings. In general I do not like scaling of 2d nodes\r\n\r\nThen you don't need to add it ;)\r\nEspecially for CSGRectangle2D it's almost useless and looks ugly. Scaling is still possible without gizmos with the Scale Tool.","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2657639518/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2957182056","html_url":"https://github.com/godotengine/godot/pull/99911#issuecomment-2957182056","issue_url":"https://api.github.com/repos/godotengine/godot/issues/99911","id":2957182056,"node_id":"IC_kwDOAO6SJc6wQwRo","user":{"login":"smix8","id":52464204,"node_id":"MDQ6VXNlcjUyNDY0MjA0","avatar_url":"https://avatars.githubusercontent.com/u/52464204?v=4","gravatar_id":"","url":"https://api.github.com/users/smix8","html_url":"https://github.com/smix8","followers_url":"https://api.github.com/users/smix8/followers","following_url":"https://api.github.com/users/smix8/following{/other_user}","gists_url":"https://api.github.com/users/smix8/gists{/gist_id}","starred_url":"https://api.github.com/users/smix8/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/smix8/subscriptions","organizations_url":"https://api.github.com/users/smix8/orgs","repos_url":"https://api.github.com/users/smix8/repos","events_url":"https://api.github.com/users/smix8/events{/privacy}","received_events_url":"https://api.github.com/users/smix8/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-06-09T22:29:41Z","updated_at":"2025-06-10T22:14:15Z","body":"I rebased to not be 3500++ PRs behind master (time flies).\r\n\r\n- Addressed the documentation comments from ship (I think?)\r\n- Removed the Node2D rect related scaling boxes.\r\n\r\nI have not found the right place yet where it may miss a queue redraw or something that causes the debug wit the debug brush sometimes not updating on node duplicates.\r\n\r\nNot sure how to address kobi's comments on the collision bake breaking sometimes. The breaking of \"simple\" looking boolean ops is a very general issue with clip operations that involve convex decomp at the end. We have that issue for Geometry2D, navmesh baking, tilemap collision baking, ... everything that is using a convex decomp that is very brittle to overlap issues. I fear this PR will not be able to change much about this as it is more a core problem.\r\n\r\nThe fallback to CollisionPolygon2D is imo not a solution to do by default because that polygon is just a visual outline that also need to convert to convex polygons or segments when used as collision. If a user sets it to convex it will break either way when the input breaks it as it uses the same convex decomp behind the scene as the csg. The only reason why it may seem to not break is because all that back and forth might fix some tiny float errors but it is not a real fix, it just hides the same issue by luck. The mode that avoids all that is the segment collision is it does not usse the convex decomp. May add CollisionPolygon2D as a general node option to the menu though, just not as a default fallback.\r\n","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2957182056/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2962206391","html_url":"https://github.com/godotengine/godot/pull/99911#issuecomment-2962206391","issue_url":"https://api.github.com/repos/godotengine/godot/issues/99911","id":2962206391,"node_id":"IC_kwDOAO6SJc6wj663","user":{"login":"KoBeWi","id":2223172,"node_id":"MDQ6VXNlcjIyMjMxNzI=","avatar_url":"https://avatars.githubusercontent.com/u/2223172?v=4","gravatar_id":"","url":"https://api.github.com/users/KoBeWi","html_url":"https://github.com/KoBeWi","followers_url":"https://api.github.com/users/KoBeWi/followers","following_url":"https://api.github.com/users/KoBeWi/following{/other_user}","gists_url":"https://api.github.com/users/KoBeWi/gists{/gist_id}","starred_url":"https://api.github.com/users/KoBeWi/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/KoBeWi/subscriptions","organizations_url":"https://api.github.com/users/KoBeWi/orgs","repos_url":"https://api.github.com/users/KoBeWi/repos","events_url":"https://api.github.com/users/KoBeWi/events{/privacy}","received_events_url":"https://api.github.com/users/KoBeWi/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-06-11T10:51:47Z","updated_at":"2025-06-11T11:12:35Z","body":"> The fallback to CollisionPolygon2D is imo not a solution to do by default because that polygon is just a visual outline that also need to convert to convex polygons or segments when used as collision. If a user sets it to convex it will break either way when the input breaks it as it uses the same convex decomp behind the scene as the csg.\r\n\r\nRight now there is no way to make CollisionPolygon2D at all. You need to make Polygon2D and then change type, afterwards the polygon works correctly. I don't see why this can't be an option. The reason conversion \"fails\" is because CollisionShape2D is very limited. You can't bake e.g. a triangle, which is a perfectly valid shape.\r\n![image](https://github.com/user-attachments/assets/7e39c3f0-b25a-4842-bc8a-b56582b42fca)\r\n\r\nEDIT:\r\nActually baking shape seems to be completely broken.\r\n\r\nhttps://github.com/user-attachments/assets/02546022-a85b-4704-8dbe-3f8644aa9cee\r\n\r\nidk what I need to make it create a shape.\r\n\r\nEDIT2:\r\n> I have not found the right place yet where it may miss a queue redraw or something that causes the debug wit the debug brush sometimes not updating on node duplicates.\r\n\r\nIt fails to draw because `brush_mesh()` is not initialized. Calling `force_update_shape()` fixes it.","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2962206391/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2964046408","html_url":"https://github.com/godotengine/godot/pull/99911#issuecomment-2964046408","issue_url":"https://api.github.com/repos/godotengine/godot/issues/99911","id":2964046408,"node_id":"IC_kwDOAO6SJc6wq8JI","user":{"login":"smix8","id":52464204,"node_id":"MDQ6VXNlcjUyNDY0MjA0","avatar_url":"https://avatars.githubusercontent.com/u/52464204?v=4","gravatar_id":"","url":"https://api.github.com/users/smix8","html_url":"https://github.com/smix8","followers_url":"https://api.github.com/users/smix8/followers","following_url":"https://api.github.com/users/smix8/following{/other_user}","gists_url":"https://api.github.com/users/smix8/gists{/gist_id}","starred_url":"https://api.github.com/users/smix8/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/smix8/subscriptions","organizations_url":"https://api.github.com/users/smix8/orgs","repos_url":"https://api.github.com/users/smix8/repos","events_url":"https://api.github.com/users/smix8/events{/privacy}","received_events_url":"https://api.github.com/users/smix8/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-06-11T20:22:36Z","updated_at":"2025-06-11T20:22:36Z","body":"@KoBeWi silly question but did you forget to enable `use_collision` in your tests on the root node?\r\n> Note that certain Editor toolbar menu bake options (see further below) require that collision is enabled. Without collision enabled some of the very expensive shape data is not created so it can not be exported.\r\n\r\nBecause without `use_collision` enabled I get the very same bake errors as you with that same node and shape setup. With collision enabled it all works just fine for me.","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2964046408/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2964082530","html_url":"https://github.com/godotengine/godot/pull/99911#issuecomment-2964082530","issue_url":"https://api.github.com/repos/godotengine/godot/issues/99911","id":2964082530,"node_id":"IC_kwDOAO6SJc6wrE9i","user":{"login":"KoBeWi","id":2223172,"node_id":"MDQ6VXNlcjIyMjMxNzI=","avatar_url":"https://avatars.githubusercontent.com/u/2223172?v=4","gravatar_id":"","url":"https://api.github.com/users/KoBeWi","html_url":"https://github.com/KoBeWi","followers_url":"https://api.github.com/users/KoBeWi/followers","following_url":"https://api.github.com/users/KoBeWi/following{/other_user}","gists_url":"https://api.github.com/users/KoBeWi/gists{/gist_id}","starred_url":"https://api.github.com/users/KoBeWi/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/KoBeWi/subscriptions","organizations_url":"https://api.github.com/users/KoBeWi/orgs","repos_url":"https://api.github.com/users/KoBeWi/repos","events_url":"https://api.github.com/users/KoBeWi/events{/privacy}","received_events_url":"https://api.github.com/users/KoBeWi/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-06-11T20:37:26Z","updated_at":"2025-06-11T20:37:26Z","body":"This needs to be mentioned somewhere. Also collision baking should be disabled when `use_collision` is disabled, if it does nothing.","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2964082530/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2965454103","html_url":"https://github.com/godotengine/godot/pull/99911#issuecomment-2965454103","issue_url":"https://api.github.com/repos/godotengine/godot/issues/99911","id":2965454103,"node_id":"IC_kwDOAO6SJc6wwT0X","user":{"login":"akien-mga","id":4701338,"node_id":"MDQ6VXNlcjQ3MDEzMzg=","avatar_url":"https://avatars.githubusercontent.com/u/4701338?v=4","gravatar_id":"","url":"https://api.github.com/users/akien-mga","html_url":"https://github.com/akien-mga","followers_url":"https://api.github.com/users/akien-mga/followers","following_url":"https://api.github.com/users/akien-mga/following{/other_user}","gists_url":"https://api.github.com/users/akien-mga/gists{/gist_id}","starred_url":"https://api.github.com/users/akien-mga/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/akien-mga/subscriptions","organizations_url":"https://api.github.com/users/akien-mga/orgs","repos_url":"https://api.github.com/users/akien-mga/repos","events_url":"https://api.github.com/users/akien-mga/events{/privacy}","received_events_url":"https://api.github.com/users/akien-mga/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-06-12T07:29:07Z","updated_at":"2025-06-12T07:29:07Z","body":"Moving this to the 4.6 milestone as we're entering feature freeze.\r\nImplementation wise this PR seems mostly ready so it could nearly have made it into 4.5 before freeze, but after discussion we think that we need some more time to evaluate how needed this feature is in the first place.\r\n\r\nThe proposal it implements got a total of 4 upvotes in 4 years, which isn't much. This PR has significantly higher success but it also just sounds cool :sunglasses: which doesn't necessarily correlate an actual need for users.\r\n\r\nWe should also evaluate this in context of other related proposals such as https://github.com/godotengine/godot-proposals/issues/1126 (which on the other hand has very high demand) and #100574 and #99210 which implement it (and conversely have seen less organic engagement than this PR).\r\n\r\nAll this to say, this might very well be the right tool for the job, but let's make sure this is properly assessed and solves the needs from the community.","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2965454103/reactions","total_count":5,"+1":3,"-1":2,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3092250607","html_url":"https://github.com/godotengine/godot/pull/99911#issuecomment-3092250607","issue_url":"https://api.github.com/repos/godotengine/godot/issues/99911","id":3092250607,"node_id":"IC_kwDOAO6SJc64T__v","user":{"login":"smix8","id":52464204,"node_id":"MDQ6VXNlcjUyNDY0MjA0","avatar_url":"https://avatars.githubusercontent.com/u/52464204?v=4","gravatar_id":"","url":"https://api.github.com/users/smix8","html_url":"https://github.com/smix8","followers_url":"https://api.github.com/users/smix8/followers","following_url":"https://api.github.com/users/smix8/following{/other_user}","gists_url":"https://api.github.com/users/smix8/gists{/gist_id}","starred_url":"https://api.github.com/users/smix8/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/smix8/subscriptions","organizations_url":"https://api.github.com/users/smix8/orgs","repos_url":"https://api.github.com/users/smix8/repos","events_url":"https://api.github.com/users/smix8/events{/privacy}","received_events_url":"https://api.github.com/users/smix8/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-07-19T10:33:31Z","updated_at":"2025-07-19T10:33:31Z","body":"> This needs to be mentioned somewhere. Also collision baking should be disabled when `use_collision` is disabled, if it does nothing.\r\n\r\nChanged it so that when no csg collision exists or is enabled that the editor menu option and function create all the collision shapes procedural.","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3092250607/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3092576845","html_url":"https://github.com/godotengine/godot/pull/99911#issuecomment-3092576845","issue_url":"https://api.github.com/repos/godotengine/godot/issues/99911","id":3092576845,"node_id":"IC_kwDOAO6SJc64VPpN","user":{"login":"KoBeWi","id":2223172,"node_id":"MDQ6VXNlcjIyMjMxNzI=","avatar_url":"https://avatars.githubusercontent.com/u/2223172?v=4","gravatar_id":"","url":"https://api.github.com/users/KoBeWi","html_url":"https://github.com/KoBeWi","followers_url":"https://api.github.com/users/KoBeWi/followers","following_url":"https://api.github.com/users/KoBeWi/following{/other_user}","gists_url":"https://api.github.com/users/KoBeWi/gists{/gist_id}","starred_url":"https://api.github.com/users/KoBeWi/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/KoBeWi/subscriptions","organizations_url":"https://api.github.com/users/KoBeWi/orgs","repos_url":"https://api.github.com/users/KoBeWi/repos","events_url":"https://api.github.com/users/KoBeWi/events{/privacy}","received_events_url":"https://api.github.com/users/KoBeWi/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-07-19T21:16:42Z","updated_at":"2025-07-19T21:16:42Z","body":"The `debug_show_brush` bug I mentioned earlier still exists, and there is a similar bug where if you duplicate a shape under CSGCombiner, the CSG menu will appear while it shouldn't. Though I think this can be ironed out later, all other problems seem to be resolved.","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3092576845/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3097977418","html_url":"https://github.com/godotengine/godot/pull/99911#issuecomment-3097977418","issue_url":"https://api.github.com/repos/godotengine/godot/issues/99911","id":3097977418,"node_id":"IC_kwDOAO6SJc64p2JK","user":{"login":"kitbdev","id":10054226,"node_id":"MDQ6VXNlcjEwMDU0MjI2","avatar_url":"https://avatars.githubusercontent.com/u/10054226?v=4","gravatar_id":"","url":"https://api.github.com/users/kitbdev","html_url":"https://github.com/kitbdev","followers_url":"https://api.github.com/users/kitbdev/followers","following_url":"https://api.github.com/users/kitbdev/following{/other_user}","gists_url":"https://api.github.com/users/kitbdev/gists{/gist_id}","starred_url":"https://api.github.com/users/kitbdev/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/kitbdev/subscriptions","organizations_url":"https://api.github.com/users/kitbdev/orgs","repos_url":"https://api.github.com/users/kitbdev/repos","events_url":"https://api.github.com/users/kitbdev/events{/privacy}","received_events_url":"https://api.github.com/users/kitbdev/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-07-21T18:45:02Z","updated_at":"2025-07-21T18:45:02Z","body":"The proposal is lacking detail and mentions destructive terrain as a use case, but that was already called out as not being a good fit. So the use case for this seems to be prototyping, just like 3D CSG.\r\nBut I don't think it is really needed in 2D.\r\nI feel like 2D CSG isn't as popular as 3D CSG since there are other easy ways to make 2D shapes. We have Polygon2D which can already be used to create custom shapes. Also sprites can be used instead in many cases.\r\n\r\nFor basic shapes, https://github.com/godotengine/godot-proposals/issues/1126, I think either https://github.com/godotengine/godot/pull/100574  or https://github.com/godotengine/godot/pull/99210 are a better fit. Those approaches are simpler, easier to use, and don't have the performance considerations that this does.\r\nFor more complex shapes, you can use multiple shapes together and Polygon2D.\r\nIf the user needs it to be a single combined 2D mesh and Polygon2D won't work for some reason, then it's more niche or not really a prototype anymore.\r\n\r\nI'm sure 2D CSG is good for some workflows, so I think 2D CSG would be a better fit as an addon. As mentioned, the base functionality for it is already available through Geometry2D, and it is very self-contained.","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3097977418/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3368148233","html_url":"https://github.com/godotengine/godot/pull/99911#issuecomment-3368148233","issue_url":"https://api.github.com/repos/godotengine/godot/issues/99911","id":3368148233,"node_id":"IC_kwDOAO6SJc7Iwd0J","user":{"login":"shafnaz","id":37254287,"node_id":"MDQ6VXNlcjM3MjU0Mjg3","avatar_url":"https://avatars.githubusercontent.com/u/37254287?v=4","gravatar_id":"","url":"https://api.github.com/users/shafnaz","html_url":"https://github.com/shafnaz","followers_url":"https://api.github.com/users/shafnaz/followers","following_url":"https://api.github.com/users/shafnaz/following{/other_user}","gists_url":"https://api.github.com/users/shafnaz/gists{/gist_id}","starred_url":"https://api.github.com/users/shafnaz/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/shafnaz/subscriptions","organizations_url":"https://api.github.com/users/shafnaz/orgs","repos_url":"https://api.github.com/users/shafnaz/repos","events_url":"https://api.github.com/users/shafnaz/events{/privacy}","received_events_url":"https://api.github.com/users/shafnaz/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-10-04T11:33:53Z","updated_at":"2025-12-09T22:35:35Z","body":"Is this going to be available in 4.6?","author_association":"NONE","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3368148233/reactions","total_count":1,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":1},"performed_via_github_app":null,"minimized":{"reason":"off-topic"}}]