[{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2510362156","html_url":"https://github.com/godotengine/godot/pull/99911#issuecomment-2510362156","issue_url":"https://api.github.com/repos/godotengine/godot/issues/99911","id":2510362156,"node_id":"IC_kwDOAO6SJc6VoRYs","user":{"login":"fire","id":32321,"node_id":"MDQ6VXNlcjMyMzIx","avatar_url":"https://avatars.githubusercontent.com/u/32321?v=4","gravatar_id":"","url":"https://api.github.com/users/fire","html_url":"https://github.com/fire","followers_url":"https://api.github.com/users/fire/followers","following_url":"https://api.github.com/users/fire/following{/other_user}","gists_url":"https://api.github.com/users/fire/gists{/gist_id}","starred_url":"https://api.github.com/users/fire/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/fire/subscriptions","organizations_url":"https://api.github.com/users/fire/orgs","repos_url":"https://api.github.com/users/fire/repos","events_url":"https://api.github.com/users/fire/events{/privacy}","received_events_url":"https://api.github.com/users/fire/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2024-12-02T01:08:48Z","updated_at":"2024-12-02T01:08:48Z","body":"Awesome, need some time to test and fix up the integration tests but looks promising.","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2510362156/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2511346180","html_url":"https://github.com/godotengine/godot/pull/99911#issuecomment-2511346180","issue_url":"https://api.github.com/repos/godotengine/godot/issues/99911","id":2511346180,"node_id":"IC_kwDOAO6SJc6VsBoE","user":{"login":"fire","id":32321,"node_id":"MDQ6VXNlcjMyMzIx","avatar_url":"https://avat