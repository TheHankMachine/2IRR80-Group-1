[{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2625155161","html_url":"https://github.com/godotengine/godot/issues/102037#issuecomment-2625155161","issue_url":"https://api.github.com/repos/godotengine/godot/issues/102037","id":2625155161,"node_id":"IC_kwDOAO6SJc6ceLBZ","user":{"login":"olanti-p","id":60584843,"node_id":"MDQ6VXNlcjYwNTg0ODQz","avatar_url":"https://avatars.githubusercontent.com/u/60584843?v=4","gravatar_id":"","url":"https://api.github.com/users/olanti-p","html_url":"https://github.com/olanti-p","followers_url":"https://api.github.com/users/olanti-p/followers","following_url":"https://api.github.com/users/olanti-p/following{/other_user}","gists_url":"https://api.github.com/users/olanti-p/gists{/gist_id}","starred_url":"https://api.github.com/users/olanti-p/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/olanti-p/subscriptions","organizations_url":"https://api.github.com/users/olanti-p/orgs","repos_url":"https://api.github.com/users/olanti-p/repos","events_url":"https://api.github.com/users/olanti-p/events{/privacy}","received_events_url":"https://api.github.com/users/olanti-p/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-01-30T17:39:34Z","updated_at":"2025-01-30T17:39:34Z","body":"I had similar error recently on 4.3 stable, solved it by rearranging level geometry to avoid thin triangles as described in #96123 (which this issue may be a dupe of). These two look like they may be the cause.\n![Image](https://github.com/user-attachments/assets/51d359c8-95a9-431f-b499-2d02c2ded1ed)\n\n","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2625155161/reactions","total_count":2,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":1},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2626363543","html_url":"https://github.com/godotengine/godot/issues/102037#issuecomment-2626363543","issue_url":"https://api.github.com/repos/godotengine/godot/issues/102037","id":2626363543,"node_id":"IC_kwDOAO6SJc6ciyCX","user":{"login":"oxeron","id":587942,"node_id":"MDQ6VXNlcjU4Nzk0Mg==","avatar_url":"https://avatars.githubusercontent.com/u/587942?v=4","gravatar_id":"","url":"https://api.github.com/users/oxeron","html_url":"https://github.com/oxeron","followers_url":"https://api.github.com/users/oxeron/followers","following_url":"https://api.github.com/users/oxeron/following{/other_user}","gists_url":"https://api.github.com/users/oxeron/gists{/gist_id}","starred_url":"https://api.github.com/users/oxeron/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/oxeron/subscriptions","organizations_url":"https://api.github.com/users/oxeron/orgs","repos_url":"https://api.github.com/users/oxeron/repos","events_url":"https://api.github.com/users/oxeron/events{/privacy}","received_events_url":"https://api.github.com/users/oxeron/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-01-31T05:51:48Z","updated_at":"2025-01-31T05:51:48Z","body":"Thanks you very much, that would explain why some trees lead to this error, and some not.\nI will try to modify the collision shapes of the trees, but this does not look like a real solution to the problem, more like a patch on my side :)\nI'll keep you informed !","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2626363543/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2627851937","html_url":"https://github.com/godotengine/godot/issues/102037#issuecomment-2627851937","issue_url":"https://api.github.com/repos/godotengine/godot/issues/102037","id":2627851937,"node_id":"IC_kwDOAO6SJc6codah","user":{"login":"smix8","id":52464204,"node_id":"MDQ6VXNlcjUyNDY0MjA0","avatar_url":"https://avatars.githubusercontent.com/u/52464204?v=4","gravatar_id":"","url":"https://api.github.com/users/smix8","html_url":"https://github.com/smix8","followers_url":"https://api.github.com/users/smix8/followers","following_url":"https://api.github.com/users/smix8/following{/other_user}","gists_url":"https://api.github.com/users/smix8/gists{/gist_id}","starred_url":"https://api.github.com/users/smix8/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/smix8/subscriptions","organizations_url":"https://api.github.com/users/smix8/orgs","repos_url":"https://api.github.com/users/smix8/repos","events_url":"https://api.github.com/users/smix8/events{/privacy}","received_events_url":"https://api.github.com/users/smix8/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-01-31T17:20:54Z","updated_at":"2025-01-31T17:21:18Z","body":"This is caused by more than 2 edges trying to occupy the same navigation map raster cells. The default cell size is 1 pixel which might be too large for such a small scaled layout with a lot of thin edge detail. You can lower the navigation map rasterization cell size in the ProjectSettings 2d navigation or using the NavigationServer API.","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2627851937/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2628386404","html_url":"https://github.com/godotengine/godot/issues/102037#issuecomment-2628386404","issue_url":"https://api.github.com/repos/godotengine/godot/issues/102037","id":2628386404,"node_id":"IC_kwDOAO6SJc6cqf5k","user":{"login":"oxeron","id":587942,"node_id":"MDQ6VXNlcjU4Nzk0Mg==","avatar_url":"https://avatars.githubusercontent.com/u/587942?v=4","gravatar_id":"","url":"https://api.github.com/users/oxeron","html_url":"https://github.com/oxeron","followers_url":"https://api.github.com/users/oxeron/followers","following_url":"https://api.github.com/users/oxeron/following{/other_user}","gists_url":"https://api.github.com/users/oxeron/gists{/gist_id}","starred_url":"https://api.github.com/users/oxeron/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/oxeron/subscriptions","organizations_url":"https://api.github.com/users/oxeron/orgs","repos_url":"https://api.github.com/users/oxeron/repos","events_url":"https://api.github.com/users/oxeron/events{/privacy}","received_events_url":"https://api.github.com/users/oxeron/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-01-31T20:57:50Z","updated_at":"2025-01-31T20:58:13Z","body":"If I set the default cell size to 0,05 in project settings, error in log disappears, but I have no idea if there is an impact somewhere .. (0,2 and 0,1 still display the error)\n\n![Image](https://github.com/user-attachments/assets/604bdb89-11da-4bbd-b050-ec128e0b8798)","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2628386404/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2628603825","html_url":"https://github.com/godotengine/godot/issues/102037#issuecomment-2628603825","issue_url":"https://api.github.com/repos/godotengine/godot/issues/102037","id":2628603825,"node_id":"IC_kwDOAO6SJc6crU-x","user":{"login":"smix8","id":52464204,"node_id":"MDQ6VXNlcjUyNDY0MjA0","avatar_url":"https://avatars.githubusercontent.com/u/52464204?v=4","gravatar_id":"","url":"https://api.github.com/users/smix8","html_url":"https://github.com/smix8","followers_url":"https://api.github.com/users/smix8/followers","following_url":"https://api.github.com/users/smix8/following{/other_user}","gists_url":"https://api.github.com/users/smix8/gists{/gist_id}","starred_url":"https://api.github.com/users/smix8/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/smix8/subscriptions","organizations_url":"https://api.github.com/users/smix8/orgs","repos_url":"https://api.github.com/users/smix8/repos","events_url":"https://api.github.com/users/smix8/events{/privacy}","received_events_url":"https://api.github.com/users/smix8/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-02-01T00:14:41Z","updated_at":"2025-02-01T00:14:41Z","body":"The impact of a very small cell size is that if you ever end up with a layout that has float precision problems you will likely have a lot unmerged edges as they will all fall into different cells. This becomes more noticeable on larger worlds that in general struggle with float precision.","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2628603825/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2636042831","html_url":"https://github.com/godotengine/godot/issues/102037#issuecomment-2636042831","issue_url":"https://api.github.com/repos/godotengine/godot/issues/102037","id":2636042831,"node_id":"IC_kwDOAO6SJc6dHtJP","user":{"login":"smix8","id":52464204,"node_id":"MDQ6VXNlcjUyNDY0MjA0","avatar_url":"https://avatars.githubusercontent.com/u/52464204?v=4","gravatar_id":"","url":"https://api.github.com/users/smix8","html_url":"https://github.com/smix8","followers_url":"https://api.github.com/users/smix8/followers","following_url":"https://api.github.com/users/smix8/following{/other_user}","gists_url":"https://api.github.com/users/smix8/gists{/gist_id}","starred_url":"https://api.github.com/users/smix8/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/smix8/subscriptions","organizations_url":"https://api.github.com/users/smix8/orgs","repos_url":"https://api.github.com/users/smix8/repos","events_url":"https://api.github.com/users/smix8/events{/privacy}","received_events_url":"https://api.github.com/users/smix8/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-02-05T08:21:36Z","updated_at":"2025-02-05T08:21:36Z","body":"I think this is solved now so closing the issue.\nFeel free to ping and reply in case it isn't.","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2636042831/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4321478609","html_url":"https://github.com/godotengine/godot/issues/102037#issuecomment-4321478609","issue_url":"https://api.github.com/repos/godotengine/godot/issues/102037","id":4321478609,"node_id":"IC_kwDOAO6SJc8AAAABAZSH0Q","user":{"login":"jackdarker","id":17355643,"node_id":"MDQ6VXNlcjE3MzU1NjQz","avatar_url":"https://avatars.githubusercontent.com/u/17355643?v=4","gravatar_id":"","url":"https://api.github.com/users/jackdarker","html_url":"https://github.com/jackdarker","followers_url":"https://api.github.com/users/jackdarker/followers","following_url":"https://api.github.com/users/jackdarker/following{/other_user}","gists_url":"https://api.github.com/users/jackdarker/gists{/gist_id}","starred_url":"https://api.github.com/users/jackdarker/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/jackdarker/subscriptio