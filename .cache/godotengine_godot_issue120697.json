2026-10-21T22:40:26Z","due_on":null,"closed_at":null},"comments":1,"created_at":"2026-06-27T17:41:36Z","updated_at":"2026-09-18T20:42:37Z","closed_at":null,"assignee":null,"author_association":"MEMBER","issue_field_values":[],"type":null,"active_lock_reason":null,"draft":false,"pull_request":{"url":"https://api.github.com/repos/godotengine/godot/pulls/120697","html_url":"https://github.com/godotengine/godot/pull/120697","diff_url":"https://github.com/godotengine/godot/pull/120697.diff","patch_url":"https://github.com/godotengine/godot/pull/120697.patch","merged_at":null},"body":"Currently, when you import a scene into a library with the `MeshLibrary` editor, it tags the library with a metadata called `_editor_source_scene` that contains the scene's path, and then enabled the option to update from it. However, that connection is implicit and fickle:\r\n- If the scene is moved, the path is not updated.\r\n- The editor doesn't check for it again once the library is reopened, unless you import a scene to it again.\r\n\r\nThis PR makes that tie more explicit:\r\n- The scene's path is now stored as an UID. So moving the scene updates it as well.\r\n- The editor now always check if a source scene is available.\r\n- You can now untie the scene from it if you want to.\r\n- Export a scene into a `MeshLibrary` via the the \"Scene\" menu also sets a source scene as well.","closed_by":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/120697/reactions","total_count":8,"+1":3,"-1":0,"laugh":0,"hooray":3,"confused":0,"heart":2,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/godotengine/godot/issues/120697/timeline","performed_via_github_app":null,"state_reason":null}