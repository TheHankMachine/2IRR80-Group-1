[{"id":4619413785,"node_id":"PRR_kwDOAO6SJc8AAAABE1apGQ","user":{"login":"clayjohn","id":16521339,"node_id":"MDQ6VXNlcjE2NTIxMzM5","avatar_url":"https://avatars.githubusercontent.com/u/16521339?u=e44a465cbebabb9ea2be80b59e6dc07966bef5b7&v=4","gravatar_id":"","url":"https://api.github.com/users/clayjohn","html_url":"https://github.com/clayjohn","followers_url":"https://api.github.com/users/clayjohn/followers","following_url":"https://api.github.com/users/clayjohn/following{/other_user}","gists_url":"https://api.github.com/users/clayjohn/gists{/gist_id}","starred_url":"https://api.github.com/users/clayjohn/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/clayjohn/subscriptions","organizations_url":"https://api.github.com/users/clayjohn/orgs","repos_url":"https://api.github.com/users/clayjohn/repos","events_url":"https://api.github.com/users/clayjohn/events{/privacy}","received_events_url":"https://api.github.com/users/clayjohn/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"This is correct, these should behave the same as `get_shader_parameter_list()` which also uses `FUNC2SC()`. If we don't sync the command queue then there is no guarantee the list is populated before it is accessed in the calling function. \n\nI think this slipped through since generally we return data instead of modifying one of the arguments. Any function that returns data automatically synchronizes (the R suffix enforces synchronization too). ","state":"APPROVED","html_url":"https://github.com/godotengine/godot/pull/120858#pullrequestreview-4619413785","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/120858","author_association":"MEMBER","_links":{"html":{"href":"https://github.com/godotengine/godot/pull/120858#pullrequestreview-4619413785"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/120858"}},"submitted_at":"2026-07-02T16:29:03Z","commit_id":"1b414da560e2d02f41b448d6c016eea032d