odify the exported property of foo\r\n9. save scene\r\n10. open bar.tscn file with other text editor to check if the value is stored.\r\n\r\n### Minimal reproduction project (MRP)\r\n\r\n[test_export_dictionary.zip](https://github.com/user-attachments/files/17635941/test_export_dictionary.zip)\r\n","closed_by":{"login":"jinyangcruise","id":42859362,"node_id":"MDQ6VXNlcjQyODU5MzYy","avatar_url":"https://avatars.githubusercontent.com/u/42859362?v=4","gravatar_id":"","url":"https://api.github.com/users/jinyangcruise","html_url":"https://github.com/jinyangcruise","followers_url":"https://api.github.com/users/jinyangcruise/followers","following_url":"https://api.github.com/users/jinyangcruise/following{/other_user}","gists_url":"https://api.github.com/users/jinyangcruise/gists{/gist_id}","starred_url":"https://api.github.com/users/jinyangcruise/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/jinyangcruise/subscriptions","organizations_url":"https://api.github.com/users/jinyangcruise/orgs","repos_url":"https://api.github.com/users/jinyangcruise/repos","events_url":"https://api.github.com/users/jinyangcruise/events{/privacy}","received_events_url":"https://api.github.com/users/jinyangcruise/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/98857/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/godotengine/godot/issues/98857/timeline","performed_via_github_app":null,"state_reason":"completed","pinned_comment":null}