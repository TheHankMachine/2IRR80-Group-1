busercontent.com/u/2223172?v=4","gravatar_id":"","url":"https://api.github.com/users/KoBeWi","html_url":"https://github.com/KoBeWi","followers_url":"https://api.github.com/users/KoBeWi/followers","following_url":"https://api.github.com/users/KoBeWi/following{/other_user}","gists_url":"https://api.github.com/users/KoBeWi/gists{/gist_id}","starred_url":"https://api.github.com/users/KoBeWi/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/KoBeWi/subscriptions","organizations_url":"https://api.github.com/users/KoBeWi/orgs","repos_url":"https://api.github.com/users/KoBeWi/repos","events_url":"https://api.github.com/users/KoBeWi/events{/privacy}","received_events_url":"https://api.github.com/users/KoBeWi/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-09-04T11:17:54Z","updated_at":"2026-09-04T11:17:54Z","body":"Instead of adding a hard-coded option, could this reuse EditorResourceConversionPlugin instead? Like, there is Convert to Shader option to convert a file, and Create Material from Shader would create a new file instead (which would duplicate the resource and convert it).","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5539672454/reactions","total_count":2,"+1":2,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5551002376","html_url":"https://github.com/godotengine/godot/pull/117613#issuecomment-5551002376","issue_url":"https://api.github.com/repos/godotengine/godot/issues/117613","id":5551002376,"node_id":"IC_kwDOAO6SJc8AAAABSt2TCA","user":{"login":"realkotob","id":43449832,"node_id":"MDQ6VXNlcjQzNDQ5ODMy","avatar_url":"https://avatars.githubusercontent.com/u/43449832?v=4","gravatar_id":"","url":"https://api.github.com/users/realkotob","html_url":"https://github.com/realkotob","followers_url":"https://api.github.com/users/realkotob/followers","following_url":"https://api.github.com/users/realkotob/following{/other_user}","gists_url":"https://api.github.com/users/realkotob/gists{/gist_id}","starred_url":"https://api.github.com/users/realkotob/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/realkotob/subscriptions","organizations_url":"https://api.github.com/users/realkotob/orgs","repos_url":"https://api.github.com/users/realkotob/repos","events_url":"https://api.github.com/users/realkotob/events{/privacy}","received_events_url":"https://api.github.com/users/realkotob/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-09-05T09:51:37Z","updated_at":"2026-09-05T09:52:36Z","body":"@KoBeWi I updated the PR to use the existing convention that I found for EditorResourceConversionPlugin, let me know if you have any feedback.\r\n\r\nI had to add a new boolean since this creates a new file instead of replacing one, other than that I tried not to introduce any new stuff.\r\n\r\nI tested it out on an empty project and everything works as expected.\r\n\r\nNote that this will now always use \"new_shader_material.tres\" for the suggested new file name in the dialog instead of the trick I was doing before to suggest a more relevant name. I left it like that for now, I think it's best to leave the name improvements to a later smaller enhancement PR maybe when I have time to look over other places that can benefit from such stuff.","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5551002376/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5656384525","html_url":"https://github.com/godotengine/godot/pull/117613#issuecomment-5656384525","issue_url":"https://api.github.com/repos/godotengine/godot/issues/117613","id":5656384525,"node_id":"IC_kwDOAO6SJc8AAAABUSWUDQ","user":{"login":"KoBeWi","id":2223172,"node_id":"MDQ6VXNlcjIyMjMxNzI=","avatar_url":"https://avatars.githubusercontent.com/u/2223172?v=4","gravatar_id":"","url":"https://api.github.com/users/KoBeWi","html_url":"https://github.com/KoBeWi","followers_url":"https://api.github.com/users/KoBeWi/followers","following_url":"https://api.github.com/users/KoBeWi/following{/other_user}","gists_url":"https://api.github.com/users/KoBeWi/gists{/gist_id}","starred_url":"https://api.github.com/users/KoBeWi/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/KoBeWi/subscriptions","organizations_url":"https://api.github.com/users/KoBeWi/orgs","repos_url":"https://api.github.com/users/KoBeWi/repos","events_url":"https://api.github.com/users/KoBeWi/events{/privacy}","received_events_url":"https://api.github.com/users/KoBeWi/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-09-13T21:49:16Z","updated_at":"2026-09-13T21:49:16Z","body":"> there is Convert to Shader option to convert a file\r\n\r\nHeh, so turns out there is no such option 🙃\r\nWhat I had in mind was being able to both replacing a file and creating a new file using a single plugin. Basically all conversion plugins would just get the new option automatically. But I checked the conversion plugins again and such functionality is actually questionable (like, replaceing Shader with ShaderMaterial would break references...).\r\n\r\nYour implementation is fine though.","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5656384525/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null}]