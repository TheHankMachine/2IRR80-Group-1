[{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3829035957","html_url":"https://github.com/godotengine/godot/issues/115683#issuecomment-3829035957","issue_url":"https://api.github.com/repos/godotengine/godot/issues/115683","id":3829035957,"node_id":"IC_kwDOAO6SJc7kOnO1","user":{"login":"clayjohn","id":16521339,"node_id":"MDQ6VXNlcjE2NTIxMzM5","avatar_url":"https://avatars.githubusercontent.com/u/16521339?v=4","gravatar_id":"","url":"https://api.github.com/users/clayjohn","html_url":"https://github.com/clayjohn","followers_url":"https://api.github.com/users/clayjohn/followers","following_url":"https://api.github.com/users/clayjohn/following{/other_user}","gists_url":"https://api.github.com/users/clayjohn/gists{/gist_id}","starred_url":"https://api.github.com/users/clayjohn/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/clayjohn/subscriptions","organizations_url":"https://api.github.com/users/clayjohn/orgs","repos_url":"https://api.github.com/users/clayjohn/repos","events_url":"https://api.github.com/users/clayjohn/events{/privacy}","received_events_url":"https://api.github.com/users/clayjohn/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-01-31T18:42:59Z","updated_at":"2026-01-31T18:44:21Z","body":"The documentation should specify which compression options are available at run time. \n\nIIRC BPTC is not exposed at run time since the library would add a lot to the engine binary size and the overall speed of compression is really slow. You'll need to make a custom build of Godot using the `cvtt_export_templates` option if you want to compress to BPTC at run time ","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3829035957/reactions","total_count":2,"+1":2,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3829055110","html_url":"https://github.com/godotengine/godot/issues/115683#issuecomment-3829055110","issue_url":"https://api.github.com/repos/godotengine/godot/issues/115683","id":3829055110,"node_id":"IC_kwDOAO6SJc7kOr6G","user":{"login":"miruji","id":147953988,"node_id":"U_kgDOCNGZRA","avatar_url":"https://avatars.githubusercontent.com/u/147953988?v=4","gravatar_id":"","url":"https://api.github.com/users/miruji","html_url":"https://github.com/miruji","followers_url":"https://api.github.com/users/miruji/followers","following_url":"https://api.github.com/users/miruji/following{/other_user}","gists_url":"https://api.github.com/users/miruji/gists{/gist_id}","starred_url":"https://api.github.com/users/miruji/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/miruji/subscriptions","organizations_url":"https://api.github.com/users/miruji/orgs","repos_url":"https://api.github.com/users/miruji/repos","events_url":"https://api.github.com/users/miruji/events{/privacy}","received_events_url":"https://api.github.com/users/miruji/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-01-31T18:53:43Z","updated_at":"2026-01-31T18:53:43Z","body":"> The documentation should specify which compression options are available at run time.\n\nIf I had known this, I wouldn’t have written such code. But it didn’t throw any errors or warnings. It could have at least highlighted it in the editor or forbidden its use, but there’s nothing like that. And the build itself doesn’t catch it either.\n","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3829055110/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3832339766","html_url":"https://