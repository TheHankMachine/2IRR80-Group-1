odot/issues/comments/2984385913/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2984391634","html_url":"https://github.com/godotengine/godot/issues/107669#issuecomment-2984391634","issue_url":"https://api.github.com/repos/godotengine/godot/issues/107669","id":2984391634,"node_id":"IC_kwDOAO6SJc6x4jPS","user":{"login":"AThousandShips","id":96648715,"node_id":"U_kgDOBcK-Cw","avatar_url":"https://avatars.githubusercontent.com/u/96648715?v=4","gravatar_id":"","url":"https://api.github.com/users/AThousandShips","html_url":"https://github.com/AThousandShips","followers_url":"https://api.github.com/users/AThousandShips/followers","following_url":"https://api.github.com/users/AThousandShips/following{/other_user}","gists_url":"https://api.github.com/users/AThousandShips/gists{/gist_id}","starred_url":"https://api.github.com/users/AThousandShips/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/AThousandShips/subscriptions","organizations_url":"https://api.github.com/users/AThousandShips/orgs","repos_url":"https://api.github.com/users/AThousandShips/repos","events_url":"https://api.github.com/users/AThousandShips/events{/privacy}","received_events_url":"https://api.github.com/users/AThousandShips/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-06-18T14:12:31Z","updated_at":"2025-06-18T14:12:31Z","body":"In the engine, see [here](https://docs.godotengine.org/en/latest/tutorials/scripting/nodes_and_scene_instances.html#creating-nodes) for example","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2984391634/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2984654471","html_url":"https://github.com/godotengine/godot/issues/107669#issuecomment-2984654471","issue_url":"https://api.github.com/repos/godotengine/godot/issues/107669","id":2984654471,"node_id":"IC_kwDOAO6SJc6x5jaH","user":{"login":"MatthiasBae","id":52577744,"node_id":"MDQ6VXNlcjUyNTc3NzQ0","avatar_url":"https://avatars.githubusercontent.com/u/52577744?v=4","gravatar_id":"","url":"https://api.github.com/users/MatthiasBae","html_url":"https://github.com/MatthiasBae","followers_url":"https://api.github.com/users/MatthiasBae/followers","following_url":"https://api.github.com/users/MatthiasBae/following{/other_user}","gists_url":"https://api.github.com/users/MatthiasBae/gists{/gist_id}","starred_url":"https://api.github.com/users/MatthiasBae/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/MatthiasBae/subscriptions","organizations_url":"https://api.github.com/users/MatthiasBae/orgs","repos_url":"https://api.github.com/users/MatthiasBae/repos","events_url":"https://api.github.com/users/MatthiasBae/events{/privacy}","received_events_url":"https://api.github.com/users/MatthiasBae/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-06-18T15:17:36Z","updated_at":"2025-06-18T15:17:36Z","body":"> In the engine, see [here](https://docs.godotengine.org/en/latest/tutorials/scripting/nodes_and_scene_instances.html#creating-nodes) for example\n\nI tested in 4.4.1 and still happens in there","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2984654471/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2984975785","html_url":"https://github.com/godotengine/godot/issues/107669#issuecomment-2984975785","issue_url":"https://api.github.com/repos/godotengine/godot/issues/107669","id":2984975785,"node_id":"IC_kwDOAO6SJc6x6x2p","user":{"login":"smix8","id":52464204,"node_id":"MDQ6VXNlcjUyNDY0MjA0","avatar_url":"https://avatars.githubusercontent.com/u/52464204?v=4","gravatar_id":"","url":"https://api.github.com/users/smix8","html_url":"https://github.com/smix8","followers_url":"https://api.github.com/users/smix8/followers","following_url":"https://api.github.com/users/smix8/following{/other_user}","gists_url":"https://api.github.com/users/smix8/gists{/gist_id}","starred_url":"https://api.github.com/users/smix8/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/smix8/subscriptions","organizations_url":"https://api.github.com/users/smix8/orgs","repos_url":"https://api.github.com/users/smix8/repos","events_url":"https://api.github.com/users/smix8/events{/privacy}","received_events_url":"https://api.github.com/users/smix8/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-06-18T16:43:08Z","updated_at":"2025-06-18T16:50:35Z","body":"Especially nodes that range from simple to highly complex have a giant amount of both internal and external dependencies that need to clean up gracefully. User can not and should not bother to try to understand and track them. Hence why there such a strong documentation emphasis on using `queue_free()` for nodes.\n\nUsing `free()` in any context where you cant be 100% sure that this is 100% ok is always wrong usage. To be 100% sure you basically need to be an experienced engine programmer and not even they often dare to use free() when it is not an internal class or struct that they fully control.\n\nThe correct way to delete a node is to `queue_free()` it. If that delay is a problem because the node lingers in the SceneTree until the deferred delete `remove_child()` it from the tree first.","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2984975785/reactions","total_count":2,"+1":2,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2985477960","html_url":"https://github.com/godotengine/godot/issues/107669#issuecomment-2985477960","issue_url":"https://api.github.com/repos/godotengine/godot/issues/107669","id":2985477960,"node_id":"IC_kwDOAO6SJc6x8sdI","user":{"login":"MatthiasBae","id":52577744,"node_id":"MDQ6VXNlcjUyNTc3NzQ0","avatar_url":"https://avatars.githubusercontent.com/u/52577744?v=4","gravatar_id":"","url":"https://api.github.com/users/MatthiasBae","html_url":"https://github.com/MatthiasBae","followers_url":"https://api.github.com/users/MatthiasBae/followers","following_url":"https://api.github.com/users/MatthiasBae/following{/other_user}","gists_url":"https://api.github.com/users/MatthiasBae/gists{/gist_id}","starred_url":"https://api.github.com/users/MatthiasBae/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/MatthiasBae/subscriptions","organizations_url":"https://api.github.com/users/MatthiasBae/orgs","repos_url":"https://api.github.com/users/MatthiasBae/repos","events_url":"https://api.github.com/users/MatthiasBae/events{/privacy}","received_events_url":"https://api.github.com/users/MatthiasBae/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-06-18T19:36:55Z","updated_at":"2025-06-18T19:36:55Z","body":"Okay, so I used it wrong and I will close the issue. Thanks for clarifying :) !","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2985477960/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null}]