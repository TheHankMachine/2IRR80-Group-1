d_by":null},{"id":279098219,"node_id":"MDU6TGFiZWwyNzkwOTgyMTk=","url":"https://api.github.com/repos/godotengine/godot/labels/topic:editor","name":"topic:editor","color":"ffee88","default":false,"description":"","archived_at":null,"archived_by":null},{"id":3240950060,"node_id":"MDU6TGFiZWwzMjQwOTUwMDYw","url":"https://api.github.com/repos/godotengine/godot/labels/performance","name":"performance","color":"447777","default":false,"description":"","archived_at":null,"archived_by":null}],"state":"closed","locked":false,"assignees":[],"milestone":{"url":"https://api.github.com/repos/godotengine/godot/milestones/21","html_url":"https://github.com/godotengine/godot/milestone/21","labels_url":"https://api.github.com/repos/godotengine/godot/milestones/21/labels","id":11568492,"node_id":"MI_kwDOAO6SJc4AsIVs","number":21,"title":"3.7","description":"","creator":{"login":"akien-mga","id":4701338,"node_id":"MDQ6VXNlcjQ3MDEzMzg=","avatar_url":"https://avatars.githubusercontent.com/u/4701338?v=4","gravatar_id":"","url":"https://api.github.com/users/akien-mga","html_url":"https://github.com/akien-mga","followers_url":"https://api.github.com/users/akien-mga/followers","following_url":"https://api.github.com/users/akien-mga/following{/other_user}","gists_url":"https://api.github.com/users/akien-mga/gists{/gist_id}","starred_url":"https://api.github.com/users/akien-mga/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/akien-mga/subscriptions","organizations_url":"https://api.github.com/users/akien-mga/orgs","repos_url":"https://api.github.com/users/akien-mga/repos","events_url":"https://api.github.com/users/akien-mga/events{/privacy}","received_events_url":"https://api.github.com/users/akien-mga/received_events","type":"User","user_view_type":"public","site_admin":false},"open_issues":45,"closed_issues":203,"state":"open","created_at":"2024-09-11T14:28:19Z","updated_at":"2026-10-22T10:00:39Z","due_on":null,"closed_at":null},"comments":1,"created_at":"2025-07-01T16:19:39Z","updated_at":"2026-02-07T12:36:29Z","closed_at":"2025-07-01T16:53:39Z","assignee":null,"author_association":"MEMBER","issue_field_values":[],"type":null,"active_lock_reason":null,"draft":false,"pull_request":{"url":"https://api.github.com/repos/godotengine/godot/pulls/108169","html_url":"https://github.com/godotengine/godot/pull/108169","diff_url":"https://github.com/godotengine/godot/pull/108169.diff","patch_url":"https://github.com/godotengine/godot/pull/108169.patch","merged_at":"2025-07-01T16:53:39Z"},"body":"Adds a cached version of `EDITOR_GET` to match the functionality in `GLOBAL_GET_CACHED`.\r\n\r\nWe added `GLOBAL_GET_CACHED` in #105910 for 3.x and 4.x, and at the time it was suggested that we should do the same for editor settings.\r\n\r\nThis is the 3.x version, in spirit the same approach as with `ProjectSettings`.\r\n\r\n## EditorSettingsQuick\r\nThe only slightly interesting things to note here, is that I noticed that \"text_editor/completion/use_single_quotes\" was being grabbed from multiple locations, and figured rather than place statics in each and multiple spinlocks, it might be better to have a small system for heavily used editor settings, so added a small class for this.\r\n\r\nIt is fairly easy to refresh this on `EditorSettings::notify_changes()`. The only exception is the initial settings at startup, where it isn't well defined where to do a refresh. I've done this after the editor node creation, and indeed the only setting used (`use_single_quotes`) seems to be set by this point.\r\n\r\n\r\n## Notes\r\n* I've converted most of what seem to be the runtime cases.\r\n* In some cases editor settings were grabbed in loops which is very bad, and I moved out of the loop.\r\n* I've not added any thread protection for `EditorSettingsQuick` as yet, but it doesn't really need any for the single bool used so far. If necessary we can put a spinlock on it or something later if we use it for more variables.\r\n* Also applicable in 4.x.\r\n\r\n\r\n<!--\r\nPlease target the `master` branch in priority.\r\n\r\nRelevant fixes are cherry-picked for stable branches as needed by maintainers.\r\n\r\nTo speed up the contribution process and avoid CI errors, please set up pre-commit hooks locally:\r\nhttps://docs.godotengine.org/en/latest/contributing/development/code_style_guidelines.html\r\n-->\r\n","closed_by":{"login":"lawnjelly","id":21999379,"node_id":"MDQ6VXNlcjIxOTk5Mzc5","avatar_url":"https://avatars.githubusercontent.com/u/21999379?v=4","gravatar_id":"","url":"https://api.github.com/users/lawnjelly","html_url":"https://github.com/lawnjelly","followers_url":"https://api.github.com/users/lawnjelly/followers","following_url":"https://api.github.com/users/lawnjelly/following{/other_user}","gists_url":"https://api.github.com/users/lawnjelly/gists{/gist_id}","starred_url":"https://api.github.com/users/lawnjelly/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/lawnjelly/subscriptions","organizations_url":"https://api.github.com/users/lawnjelly/orgs","repos_url":"https://api.github.com/users/lawnjelly/repos","events_url":"https://api.github.com/users/lawnjelly/events{/privacy}","received_events_url":"https://api.github.com/users/lawnjelly/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/108169/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/godotengine/godot/issues/108169/timeline","performed_via_github_app":null,"state_reason":null}