.github.com/repos/godotengine/godot/issues/comments/2588371404","html_url":"https://github.com/godotengine/godot/pull/101513#issuecomment-2588371404","issue_url":"https://api.github.com/repos/godotengine/godot/issues/101513","id":2588371404,"node_id":"IC_kwDOAO6SJc6aR2nM","user":{"login":"WhalesState","id":53877170,"node_id":"MDQ6VXNlcjUzODc3MTcw","avatar_url":"https://avatars.githubusercontent.com/u/53877170?v=4","gravatar_id":"","url":"https://api.github.com/users/WhalesState","html_url":"https://github.com/WhalesState","followers_url":"https://api.github.com/users/WhalesState/followers","following_url":"https://api.github.com/users/WhalesState/following{/other_user}","gists_url":"https://api.github.com/users/WhalesState/gists{/gist_id}","starred_url":"https://api.github.com/users/WhalesState/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/WhalesState/subscriptions","organizations_url":"https://api.github.com/users/WhalesState/orgs","repos_url":"https://api.github.com/users/WhalesState/repos","events_url":"https://api.github.com/users/WhalesState/events{/privacy}","received_events_url":"https://api.github.com/users/WhalesState/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-01-13T22:37:36Z","updated_at":"2025-01-13T22:37:36Z","body":"> > I see a revert of #101266\r\n> \r\n> It's not reverting it, only a tiny part that was wrong (legacy picker). Fix for real X11 is still there.\r\n\r\nSorry, I was confused, forgot that i have added it in two places :') ","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2588371404/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2588372682","html_url":"https://github.com/godotengine/godot/pull/101513#issuecomment-2588372682","issue_url":"https://api.github.com/repos/godotengine/godot/issues/101513","id":2588372682,"node_id":"IC_kwDOAO6SJc6aR27K","user":{"login":"akien-mga","id":4701338,"node_id":"MDQ6VXNlcjQ3MDEzMzg=","avatar_url":"https://avatars.githubusercontent.com/u/4701338?v=4","gravatar_id":"","url":"https://api.github.com/users/akien-mga","html_url":"https://github.com/akien-mga","followers_url":"https://api.github.com/users/akien-mga/followers","following_url":"https://api.github.com/users/akien-mga/following{/other_user}","gists_url":"https://api.github.com/users/akien-mga/gists{/gist_id}","starred_url":"https://api.github.com/users/akien-mga/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/akien-mga/subscriptions","organizations_url":"https://api.github.com/users/akien-mga/orgs","repos_url":"https://api.github.com/users/akien-mga/repos","events_url":"https://api.github.com/users/akien-mga/events{/privacy}","received_events_url":"https://api.github.com/users/akien-mga/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-01-13T22:38:29Z","updated_at":"2025-01-13T22:40:18Z","body":"There seems to be an effect to the code being removed on my config (XWayland multi window, which is likely the most common configuration nowadays as most distros now default to Wayland and we default to X11 multi window).\r\n\r\nIf I just do what @WhalesState suggests, I get:\r\n\r\n![image](https://github.com/user-attachments/assets/9f3627cc-b732-4394-8625-69a85f5e695e)\r\n\r\nWhich seems to be marginally better than what I have with this PR.\r\n\r\n```diff\r\ndiff --git a/scene/gui/color_picker.cpp b/scene/gui/color_picker.cpp\r\nindex f5be4c59a9..affbd7270a 100644\r\n--- a/scene/gui/color_picker.cpp\r\n+++ b/scene/gui/color_picker.cpp\r\n@@ -1982,9 +1982,11 @@ void ColorPicker::_picker_texture_input(const Ref<InputEvent> &p_event) {\r\n \t\t\tpicker_preview_style_box_color->set_bg_color(picker_color);\r\n \t\t\tpicker_preview_style_box->set_bg_color(picker_color.get_luminance() < 0.5 ? Color(1.0f, 1.0f, 1.0f) : Color(0.0f, 0.0f, 0.0f));\r\n \r\n-\t\t\tRef<AtlasTexture> atlas = picker_texture_zoom->get_texture();\r\n-\t\t\tif (atlas.is_valid()) {\r\n-\t\t\t\tatlas->set_region(Rect2i(ofs.x - 8, ofs.y - 8, 17, 17));\r\n+\t\t\tif (picker_texture_zoom) {\r\n+\t\t\t\tRef<AtlasTexture> atlas = picker_texture_zoom->get_texture();\r\n+\t\t\t\tif (atlas.is_valid()) {\r\n+\t\t\t\t\tatlas->set_region(Rect2i(ofs.x - 8, ofs.y - 8, 17, 17));\r\n+\t\t\t\t}\r\n \t\t\t}\r\n \t\t}\r\n \t}\r\n```\r\n\r\nIt's still imperfect, as the preview square is weirdly offset to the bottom right of the pointer, but it's better.\r\n\r\nI think we're starting to get confused by the terminology of legacy, single/multi window, embedded, and `FEATURE_SCREEN_EXCLUDE_FROM_CAPTURE`. The resulting code is quite a spaghetti mess we'll need to clean up one day...","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2588372682/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2588378360","html_url":"https://github.com/godotengine/godot/pull/101513#issuecomment-2588378360","issue_url":"https://api.github.com/repos/godotengine/godot/issues/101513","id":2588378360,"node_id":"IC_kwDOAO6SJc6aR4T4","user":{"login":"bruvzg","id":7645683,"node_id":"MDQ6VXNlcjc2NDU2ODM=","avatar_url":"https://avatars.githubusercontent.com/u/7645683?v=4","gravatar_id":"","url":"https://api.github.com/users/bruvzg","html_url":"https://github.com/bruvzg","followers_url":"https://api.github.com/users/bruvzg/followers","following_url":"https://api.github.com/users/bruvzg/following{/other_user}","gists_url":"https://api.github.com/users/bruvzg/gists{/gist_id}","starred_url":"https://api.github.com/users/bruvzg/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/bruvzg/subscriptions","organizations_url":"https://api.github.com/users/bruvzg/orgs","repos_url":"https://api.github.com/users/bruvzg/repos","events_url":"https://api.github.com/users/bruvzg/events{/privacy}","received_events_url":"https://api.github.com/users/bruvzg/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-01-13T22:42:24Z","updated_at":"2025-01-13T22:42:24Z","body":"Added missing part for XWayland (different texture setup branch from embedded legacy picker).","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2588378360/reactions","total_count":2,"+1":2,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2588386146","html_url":"https://github.com/godotengine/godot/pull/101513#issuecomment-2588386146","issue_url":"https://api.github.com/repos/godotengine/godot/issues/101513","id":2588386146,"node_id":"IC_kwDOAO6SJc6aR6Ni","user":{"login":"akien-mga","id":4701338,"node_id":"MDQ6VXNlcjQ3MDEzMzg=","avatar_url":"https://avatars.githubusercontent.com/u/4701338?v=4","gravatar_id":"","url":"https://api.github.com/users/akien-mga","html_url":"https://github.com/akien-mga","followers_url":"https://api.github.com/users/akien-mga/followers","following_url":"https://api.github.com/users/akien-mga/following{/other_user}","gists_url":"https://api.github.com/users/akien-mga/gists{/gist_id}","starred_url":"https://api.github.com/users/akien-mga/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/akien-mga/subscriptions","organizations_url":"https://api.github.com/users/akien-mga/orgs","repos_url":"https://api.github.com/users/akien-mga/repos","events_url":"https://api.github.com/users/akien-mga/events{/privacy}","received_events_url":"https://api.github.com/users/akien-mga/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-01-13T22:47:39Z","updated_at":"2025-01-13T22:47:39Z","body":"That works great on XWayland multi-window:\r\n\r\n![image](https://github.com/user-attachments/assets/4b9f2c28-2a38-47b6-b5b8-a89ea78f6591)\r\n\r\nMy last nitpick is that there's still an unexpected shrinking of the window with a black bar at the bottom (the window was full screen before). The top black bar is understandable, that's where the window decorations would be, to compare with:\r\n\r\n![image](https://github.com/user-attachments/assets/496f29d2-6d64-4b14-9c68-ada3e4486eb9)\r\n\r\nIn 4.3 as shown above, I'm not getting this shrinking.\r\n\r\nBut that's outside the scope of this PR.\r\n\r\nI'll test XWayland single-window, Wayland single-window, and real X11 multi/single-window.","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2588386146/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2588386755","html_url":"https://github.com/godotengine/godot/pull/101513#issuecomment-2588386755","issue_url":"https://api.github.com/repos/godotengine/godot/issues/101513","id":2588386755,"node_id":"IC_kwDOAO6SJc6aR6XD","user":{"login":"bruvzg","id":7645683,"node_id":"MDQ6VXNlcjc2NDU2ODM=","avatar_url":"https://avatars.githubusercontent.com/u/7645683?v=4","gravatar_id":"","url":"https://api.github.com/users/bruvzg","html_url":"https://github.com/bruvzg","followers_url":"https://api.github.com/users/bruvzg/followers","following_url":"https://api.github.com/users/bruvzg/following{/other_user}","gists_url":"https://api.github.com/users/bruvzg/gists{/gist_id}","starred_url":"https://api.github.com/users/bruvzg/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/bruvzg/subscriptions","organizations_url":"https://api.github.com/users/bruvzg/orgs","repos_url":"https://api.github.com/users/bruvzg/repos","events_url":"https://api.github.com/users/bruvzg/events{/privacy}","received_events_url":"https://api.github.com/users/bruvzg/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-01-13T22:48:07Z","updated_at":"2025-01-13T22:48:07Z","body":"> I think we're starting to get confused by the terminology of legacy, single/multi window, embedded, and FEATURE_SCREEN_EXCLUDE_FROM_CAPTURE. The resulting code is quite a spaghetti mess we'll need to clean up one day...\r\n\r\nFor reference there are the following cases:\r\n\r\n- Embedded windows (on any platform) and Wayland (since it's currently singe window), use legacy picker with zoom preview.\r\n- `FEATURE_SCREEN_EXCLUDE_FROM_CAPTURE` and `FEATURE_SCREEN_CAPTURE` available (Windows and macOS) - native window picker with zoom preview.\r\n- Only `FEATURE_SCREEN_CAPTURE` available (native X11) - native window picker without zoom preview.\r\n- Neither is available (XWayland) - legacy picker with zoom preview (but instead of using window texture, it's using a separate window with texture composed of all app windows, that's what causing resizing of the window with black bars).","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2588386755/reactions","total_count":2,"+1":2,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2588397141","html_url":"https://github.com/godotengine/godot/pull/101513#issuecomment-2588397141","issue_url":"https://api.github.com/repos/godotengine/godot/issues/101513","id":2588397141,"node_id":"IC_kwDOAO6SJc6aR85V","user":{"login":"akien-mga","id":4701338,"node_id":"MDQ6VXNlcjQ3MDEzMzg=","avatar_url":"https://avatars.githubusercontent.com/u/4701338?v=4","gravatar_id":"","url":"https://api.github.com/users/akien-mga","html_url":"https://github.com/akien-mga","followers_url":"https://api.github.com/users/akien-mga/followers","following_url":"https://api.github.com/users/akien-mga/following{/other_user}","gists_url":"https://api.github.com/users/akien-mga/gists{/gist_id}","starred_url":"https://api.github.com/users/akien-mga/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/akien-mga/subscriptions","organizations_url":"https://api.github.com/users/akien-mga/orgs","repos_url":"https://api.github.com/users/akien-mga/repos","events_url":"https://api.github.com/users/akien-mga/events{/privacy}","received_events_url":"https://api.github.com/users/akien-mga/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-01-13T22:53:46Z","updated_at":"2025-01-13T22:53:46Z","body":"- XWayland single-window: It seems to work fine for the most part:\r\n\r\n![image](https://github.com/user-attachments/assets/3bffb785-34fe-4fec-9543-6c0efa769b40)\r\n\r\nThere's one minor issue though, when clicking the picker button, a full size copy of the editor window is instantiated as a new window. When moving the cursor, it then disappears and is replaced by the proper preview picker with zoom. Here's an example of what it looks like:\r\n\r\n![image](https://github.com/user-attachments/assets/cf17f397-11ee-4b61-91b2-b1c0ddd7c8df)\r\n\r\nMaybe we should send a small mouse event to update the window contents?\r\n\r\n- Wayland single-window: Same behavior as XWayland single-window, including the full window copy.\r\n\r\n![image](https://github.com/user-attachments/assets/6f69dfcb-c0f4-4a35-af42-6dad81421329)\r\n\r\nSwitching to X11 to test the other cases.","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2588397141/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2588397483","html_url":"https://github.com/godotengine/godot/pull/101513#issuecomment-2588397483","issue_url":"https://api.github.com/repos/godotengine/godot/issues/101513","id":2588397483,"node_id":"IC_kwDOAO6SJc6aR8-r","user":{"login":"WhalesState","id":53877170,"node_id":"MDQ6VXNlcjUzODc3MTcw","avatar_url":"https://avatars.githubusercontent.com/u/53877170?v=4","gravatar_id":"","url":"https://api.github.com/users/WhalesState","html_url":"https://github.com/WhalesState","followers_url":"https://api.github.com/users/WhalesState/followers","following_url":"https://api.github.com/users/WhalesState/following{/other_user}","gists_url":"https://api.github.com/users/WhalesState/gists{/gist_id}","starred_url":"https://api.github.com/users/WhalesState/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/WhalesState/subscriptions","organizations_url":"https://api.github.com/users/WhalesState/orgs","repos_url":"https://api.github.com/users/WhalesState/repos","events_url":"https://api.github.com/users/WhalesState/events{/privacy}","received_events_url":"https://api.github.com/users/WhalesState/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-01-13T22:54:02Z","updated_at":"2025-01-13T22:54:02Z","body":"Before doing a cleanup, I have those two PRs that fixes other Picker issues\r\n\r\n* https://github.com/godotengine/godot/pull/101100\r\n* https://github.com/godotengine/godot/pull/88072","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2588397483/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2588416888","html_url":"https://github.com/godotengine/godot/pull/101513#issuecomment-2588416888","issue_url":"https://api.github.com/repos/godotengine/godot/issues/101513","id":2588416888,"node_id":"IC_kwDOAO6SJc6aSBt4","user":{"login":"bruvzg","id":7645683,"node_id":"MDQ6VXNlcjc2NDU2ODM=","avatar_url":"https://avatars.githubusercontent.com/u/7645683?v=4","gravatar_id":"","url":"https://api.github.com/users/bruvzg","html_url":"https://github.com/bruvzg","followers_url":"https://api.github.com/users/bruvzg/followers","following_url":"https://api.github.com/users/bruvzg/following{/other_user}","gists_url":"https://api.github.com/users/bruvzg/gists{/gist_id}","starred_url":"https://api.github.com/users/bruvzg/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/bruvzg/subscriptions","organizations_url":"https://api.github.com/users/bruvzg/orgs","repos_url":"https://api.github.com/users/bruvzg/repos","events_url":"https://api.github.com/users/bruvzg/events{/privacy}","received_events_url":"https://api.github.com/users/bruvzg/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-01-13T23:08:14Z","updated_at":"2025-01-13T23:08:14Z","body":"> There's one minor issue though, when clicking the picker button, a full size copy of the editor window is instantiated as a new window. When moving the cursor, it then disappears and is replaced by the proper preview picker with zoom. Here's an example of what it looks like:\r\n\r\nI can't reproduce it, but I see what can cause it. Added `set_region` to force preview window size.","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2588416888/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2588428931","html_url":"https://github.com/godotengine/godot/pull/101513#issuecomment-2588428931","issue_url":"https://api.github.com/repos/godotengine/godot/issues/101513","id":2588428931,"node_id":"IC_kwDOAO6SJc6aSEqD","user":{"login":"akien-mga","id":4701338,"node_id":"MDQ6VXNlcjQ3MDEzMzg=","avatar_url":"https://avatars.githubusercontent.com/u/4701338?v=4","gravatar_id":"","url":"https://api.github.com/users/akien-mga","html_url":"https://github.com/akien-mga","followers_url":"https://api.github.com/users/akien-mga/followers","following_url":"https://api.github.com/users/akien-mga/following{/other_user}","gists_url":"https://api.github.com/users/akien-mga/gists{/gist_id}","starred_url":"https://api.github.com/users/akien-mga/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/akien-mga/subscriptions","organizations_url":"https://api.github.com/users/akien-mga/orgs","repos_url":"https://api.github.com/users/akien-mga/repos","events_url":"https://api.github.com/users/akien-mga/events{/privacy}","received_events_url":"https://api.github.com/users/akien-mga/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-01-13T23:17:14Z","updated_at":"2025-01-13T23:25:28Z","body":"> Switching to X11 to test the other cases.\r\n\r\nTested the last two commits (886d519 and 34ebefd).\r\n\r\n- Native X11 single-window:\r\n  * 886d519: Same behavior as XWayland or Wayland single-window, including window copy.\r\n  * 34ebefd: I confirm this fixes the full sized preview window duplicating the editor window. The only remaining annoyance I see is that the preview window is not instantiated where the picker button was clicked, but at its last known position (top-left corner initially, then wherever it was last clicked/canceled). When the mouse cursor is then moved, it warps to where the cursor is.\r\n\r\n![image](https://github.com/user-attachments/assets/1a3b9cb1-2469-4636-8f90-7f6f8a2a4abc)\r\n\r\n- Native X11 multi-window: Same behavior in both commits. This has a preview flickering bug, with different offsets based on the mouse cursor. It's hard to capture in a screenshot, so I made a screen recording:\r\n\r\nhttps://github.com/user-attachments/assets/9f0c7139-4ca4-4551-ad06-9e64fe88277b\r\n\r\nThat last bug also seems to exist in 4.4.dev7, albeit in a worst form where the full size preview with zoom flickers black and white rapidly (epilepsy warning if you test). *Edit:* That seems to be #100797.","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2588428931/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2588445880","html_url":"https://github.com/godotengine/godot/pull/101513#issuecomment-2588445880","issue_url":"https://api.github.com/repos/godotengine/godot/issues/101513","id":2588445880,"node_id":"IC_kwDOAO6SJc6aSIy4","user":{"login":"bruvzg","id":7645683,"node_id":"MDQ6VXNlcjc2NDU2ODM=","avatar_url":"https://avatars.githubusercontent.com/u/7645683?v=4","gravatar_id":"","url":"https://api.github.com/users/bruvzg","html_url":"https://github.com/bruvzg","followers_url":"https://api.github.com/users/bruvzg/followers","following_url":"https://api.github.com/users/bruvzg/following{/other_user}","gists_url":"https://api.github.com/users/bruvzg/gists{/gist_id}","starred_url":"https://api.github.com/users/bruvzg/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/bruvzg/subscriptions","organizations_url":"https://api.github.com/users/bruvzg/orgs","repos_url":"https://api.github.com/users/bruvzg/repos","events_url":"https://api.github.com/users/bruvzg/events{/privacy}","received_events_url":"https://api.github.com/users/bruvzg/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-01-13T23:25:41Z","updated_at":"2025-01-13T23:25:41Z","body":"X11 flicker bug is what https://github.com/godotengine/godot/pull/101485 should fix.","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2588445880/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2588464130","html_url":"https://github.com/godotengine/godot/pull/101513#issuecomment-2588464130","issue_url":"https://api.github.com/repos/godotengine/godot/issues/101513","id":2588464130,"node_id":"IC_kwDOAO6SJc6aSNQC","user":{"login":"akien-mga","id":4701338,"node_id":"MDQ6VXNlcjQ3MDEzMzg=","avatar_url":"https://avatars.githubusercontent.com/u/4701338?v=4","gravatar_id":"","url":"https://api.github.com/users/akien-mga","html_url":"https://github.com/akien-mga","followers_url":"https://api.github.com/users/akien-mga/followers","following_url":"https://api.github.com/users/akien-mga/following{/other_user}","gists_url":"https://api.github.com/users/akien-mga/gists{/gist_id}","starred_url":"https://api.github.com/users/akien-mga/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/akien-mga/subscriptions","organizations_url":"https://api.github.com/users/akien-mga/orgs","repos_url":"https://api.github.com/users/akien-mga/repos","events_url":"https://api.github.com/users/akien-mga/events{/privacy}","received_events_url":"https://api.github.com/users/akien-mga/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-01-13T23:38:32Z","updated_at":"2025-01-13T23:38:52Z","body":"> X11 flicker bug is what #101485 should fix.\r\n\r\nIndeed, removing this line solves #100797 on native X11 multi-window:\r\n\r\n![image](https://github.com/user-attachments/assets/e188aebe-2068-45de-88ee-7023767a0a9a)\r\n\r\nI'd suggest adding it in this PR so it can fix #101412, #100797 and #101328 altogether. It's going to conflict with #101485 anyway so we may as well keep that PR only for code style improvements and fix the known bugs here.\r\n\r\n```diff\r\ndiff --git a/scene/gui/color_picker.cpp b/scene/gui/color_picker.cpp\r\nindex 6024ea7b96..d1cff07a40 100644\r\n--- a/scene/gui/color_picker.cpp\r\n+++ b/scene/gui/color_picker.cpp\r\n@@ -159,7 +159,6 @@ void ColorPicker::_notification(int p_what) {\r\n                        }\r\n                        DisplayServer *ds = DisplayServer::get_singleton();\r\n                        Vector2 ofs = ds->mouse_get_position();\r\n-                       picker_window->set_position(ofs - Vector2(28, 28));\r\n \r\n                        Color c = DisplayServer::get_singleton()->screen_get_pixel(ofs);\r\n```\r\n\r\n---\r\n\r\nWith this change, the only remaining issues I've seen, for future issues/PRs:\r\n\r\n- Single-window (native X11):  The preview window is not instantiated where the picker button was clicked, but at its last known position (top-left corner initially, then wherever it was last clicked/canceled). When the mouse cursor is then moved, it warps to where the cursor is.\r\n\r\n- Multi-window (native X11): Even with the flickering fixed, the way the cursor changes offset based on where it is in the window (seemingly based on the quadrant?) seems quite distracting to me. It would probably be better if it stayed always at the bottom right of the cursor, and only flipped to the left and/or top when nearing one of the 3 window corners where it would make sense.","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2588464130/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2589132775","html_url":"https://github.com/godotengine/godot/pull/101513#issuecomment-2589132775","issue_url":"https://api.github.com/repos/godotengine/godot/issues/101513","id":2589132775,"node_id":"IC_kwDOAO6SJc6aUwfn","user":{"login":"bruvzg","id":7645683,"node_id":"MDQ6VXNlcjc2NDU2ODM=","avatar_url":"https://avatars.githubusercontent.com/u/7645683?v=4","gravatar_id":"","url":"https://api.github.com/users/bruvzg","html_url":"https://github.com/bruvzg","followers_url":"https://api.github.com/users/bruvzg/followers","following_url":"https://api.github.com/users/bruvzg/following{/other_user}","gists_url":"https://api.github.com/users/bruvzg/gists{/gist_id}","starred_url":"https://api.github.com/users/bruvzg/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/bruvzg/subscriptions","organizations_url":"https://api.github.com/users/bruvzg/orgs","repos_url":"https://api.github.com/users/bruvzg/repos","events_url":"https://api.github.com/users/bruvzg/events{/privacy}","received_events_url":"https://api.github.com/users/bruvzg/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-01-14T06:28:11Z","updated_at":"2025-01-14T06:28:11Z","body":"> I'd suggest adding it in this PR\r\n\r\nDone.\r\n\r\nAlso added initial position to the picker for single-window and changed native X11 preview to always have same offset from cursor except for the bottom and right border of the screen.","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2589132775/reactions","total_count":2,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":2,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/2589635699","html_url":"https://github.com/godotengine/godot/pull/101513#issuecomment-2589635699","issue_url":"https://api.github.com/repos/godotengine/godot/issues/101513","id":2589635699,"node_id":"IC_kwDOAO6SJc6aWrRz","user":{"login":"akien-mga","id":4701338,"node_id":"MDQ6VXNlcjQ3MDEzMzg=","avat