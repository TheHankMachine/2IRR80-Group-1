[{"id":3870798113,"node_id":"PRR_kwDOAO6SJc7mt7Eh","user":{"login":"AdriaandeJongh","id":5611323,"node_id":"MDQ6VXNlcjU2MTEzMjM=","avatar_url":"https://avatars.githubusercontent.com/u/5611323?v=4","gravatar_id":"","url":"https://api.github.com/users/AdriaandeJongh","html_url":"https://github.com/AdriaandeJongh","followers_url":"https://api.github.com/users/AdriaandeJongh/followers","following_url":"https://api.github.com/users/AdriaandeJongh/following{/other_user}","gists_url":"https://api.github.com/users/AdriaandeJongh/gists{/gist_id}","starred_url":"https://api.github.com/users/AdriaandeJongh/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/AdriaandeJongh/subscriptions","organizations_url":"https://api.github.com/users/AdriaandeJongh/orgs","repos_url":"https://api.github.com/users/AdriaandeJongh/repos","events_url":"https://api.github.com/users/AdriaandeJongh/events{/privacy}","received_events_url":"https://api.github.com/users/AdriaandeJongh/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"Tested this PR a bit.\n\n1. Disabling Auto Font Size doesn't revert the font size back to the default.\n\n2. In my opinion, Min and Max should be spelled out as Minimum and Maximum in the inspector, for accessibility reasons.\n\n3. When Minimum Font Size > Maximum Font Size, the minimum font size takes precedent. I guess either way is fine, but I expected the opposite. Should be documented in each property's description.\n\n4. For all the nodes that also have an associated icon or other control that is not technically a font (Button, CheckBox, and CheckButton), I think this implementation is not going to fly. IMO either we strip those node types out of this PR (which I think I'd prefer), or this PR introduces more specialized controls that help manage the icon / addition control sizes in a more encompassing way. I think this PR would stand a higher chance of being merged if it just focussed on Label and RichTextLabel initially, and introduce auto font sizing on other nodes should there be sufficient requests and a more specific proposal that also addresses how icons and other controls part of the parent control should be managed.","state":"CHANGES_REQUESTED","html_url":"https://github.com/godotengine/godot/pull/116791#pullrequestreview-3870798113","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/116791","author_association":"CONTRIBUTOR","_links":{"html":{"href":"https://github.com/godotengine/godot/pull/116791#pullrequestreview-3870798113"},"pull_request":{"href":"https://api.github.com/repos/godotengine/godot/pulls/116791"}},"submitted_at":"2026-02-28T21:10:07Z","commit_id":null},{"id":3870821969,"node_id":"PRR_kwDOAO6SJc7muA5R","user":{"login":"bruvzg","id":7645683,"node_id":"MDQ6VXNlcjc2NDU2ODM=","avatar_url":"https://avatars.githubusercontent.com/u/7645683?u=2867ee7fcd920bc19b7d1cbf4b10264b9bbc9326&v=4","gravatar_id":"","url":"https://api.github.com/users/bruvzg","html_url":"https://github.com/bruvzg","followers_url":"https://api.github.com/users/bruvzg/followers","following_url":"https://api.github.com/users/bruvzg/following{/other_user}","gists_url":"https://api.github.com/users/bruvzg/gists{/gist_id}","starred_url":"https://api.github.com/users/bruvzg/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/bruvzg/subscriptions","organizations_url":"https://api.github.com/users/bruvzg/orgs","repos_url":"https://api.github.com/users/bruvzg/repos","events_url":"https://api.github.com/users/bruvzg/events{/privacy}","received_events_url":"https://api.github.com/users/bruvzg/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"","state":"COMMENTED","html_url":"https://github.com/godotengine/godot/pull/116791#pullrequestreview-3870821969","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/116791","author_association":"MEMBER","_links":{"html":{"href":"https://github.com/godotengine/