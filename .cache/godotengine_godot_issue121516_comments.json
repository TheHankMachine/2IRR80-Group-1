g.","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5013349902/reactions","total_count":1,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":1},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5015293793","html_url":"https://github.com/godotengine/godot/issues/121516#issuecomment-5015293793","issue_url":"https://api.github.com/repos/godotengine/godot/issues/121516","id":5015293793,"node_id":"IC_kwDOAO6SJc8AAAABKu9PYQ","user":{"login":"Radule614","id":78875131,"node_id":"MDQ6VXNlcjc4ODc1MTMx","avatar_url":"https://avatars.githubusercontent.com/u/78875131?v=4","gravatar_id":"","url":"https://api.github.com/users/Radule614","html_url":"https://github.com/Radule614","followers_url":"https://api.github.com/users/Radule614/followers","following_url":"https://api.github.com/users/Radule614/following{/other_user}","gists_url":"https://api.github.com/users/Radule614/gists{/gist_id}","starred_url":"https://api.github.com/users/Radule614/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Radule614/subscriptions","organizations_url":"https://api.github.com/users/Radule614/orgs","repos_url":"https://api.github.com/users/Radule614/repos","events_url":"https://api.github.com/users/Radule614/events{/privacy}","received_events_url":"https://api.github.com/users/Radule614/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-07-19T10:01:08Z","updated_at":"2026-07-19T10:01:08Z","body":"@JekSun97 \n\nHello,\n\nI might be missing the point, but doing this seems to work when `Use as Albedo` is checked. Is this what you had in mind? 😄 \n\n```\nRef<SurfaceTool> st;\nst.instantiate();\nst->begin(Mesh::PRIMITIVE_TRIANGLES);\n\nfor (int i = 0; i < tree.mVertCount; i++) {\n\tst->set_color(Color(0.0, 1.0, 0.0, 1.0));\n\tst->add_vertex(Vector3(tree.mVert[i].x, tree.mVert[i].y, tree.mVert[i].z));\n}\n\nfor (int i = 0; i < tree.mFaceCount; i++) {\n\tst->add_index(tree.mFace[i].x);\n\tst->add_index(tree.mFace[i].y);\n\tst->add_index(tree.mFace[i].z);\n}\n\nst->optimize_indices_for_cache();\nset_mesh(st->commit());\n\nRef<Material> mat = ResourceLoader::get_singleton()->load(\"res://testVertCol.tres\");\nset_surface_override_material(0, mat);\n```","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5015293793/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/5015304545","html_url":"https://github.com/godotengine/godot/issues/121516#issuecomment-5015304545","issue_url":"https://api.github.com/repos/godotengine/godot/issues/121516","id":5015304545,"node_id":"IC_kwDOAO6SJc8AAAABKu95YQ","user":{"login":"JekSun97","id":130399274,"node_id":"U_kgDOB8W8Kg","avatar_url":"https://avatars.githubusercontent.com/u/130399274?v=4","gravatar_id":"","url":"https://api.github.com/users/JekSun97","html_url":"https://github.com/JekSun97","followers_url":"https://api.github.com/users/JekSun97/followers","following_url":"https://api.github.com/users/JekSun97/following{/other_user}","gists_url":"https://api.github.com/users/JekSun97/gists{/gist_id}","starred_url":"https://api.github.com/users/JekSun97/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/JekSun97/subscriptions","organizations_url":"https://api.github.com/users/JekSun97/orgs","repos_url":"https://api.github.com/users/JekSun97/repos","events_url":"https://api.github.com/users/JekSun97/events{/privacy}","received_events_url":"https://api.github.com/users/JekSun97/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-07-19T10:04:49Z","updated_at":"2026-07-19T10:04:49Z","body":"