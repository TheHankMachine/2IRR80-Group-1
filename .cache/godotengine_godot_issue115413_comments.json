[{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3831228532","html_url":"https://github.com/godotengine/godot/issues/115413#issuecomment-3831228532","issue_url":"https://api.github.com/repos/godotengine/godot/issues/115413","id":3831228532,"node_id":"IC_kwDOAO6SJc7kW-h0","user":{"login":"CopperFr","id":15486071,"node_id":"MDQ6VXNlcjE1NDg2MDcx","avatar_url":"https://avatars.githubusercontent.com/u/15486071?v=4","gravatar_id":"","url":"https://api.github.com/users/CopperFr","html_url":"https://github.com/CopperFr","followers_url":"https://api.github.com/users/CopperFr/followers","following_url":"https://api.github.com/users/CopperFr/following{/other_user}","gists_url":"https://api.github.com/users/CopperFr/gists{/gist_id}","starred_url":"https://api.github.com/users/CopperFr/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/CopperFr/subscriptions","organizations_url":"https://api.github.com/users/CopperFr/orgs","repos_url":"https://api.github.com/users/CopperFr/repos","events_url":"https://api.github.com/users/CopperFr/events{/privacy}","received_events_url":"https://api.github.com/users/CopperFr/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-02-01T15:40:32Z","updated_at":"2026-02-01T15:40:32Z","body":"I had a similar issue with my Windows x86_32 export in Godot 4.6 (Windows x86_64 was ok) and it seems the problem was the second VirtualProtect call in install_iat_hook. The last parameter should not be null so I replaced nullptr by &old_protect (could be better to use another variable) like this :\n\n`VirtualProtect((LPVOID)(&first_thunk->u1.Function), 8, old_protect, &old_protect);`","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3831228532/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null}]