[{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3205928949","html_url":"https://github.com/godotengine/godot/pull/109800#issuecomment-3205928949","issue_url":"https://api.github.com/repos/godotengine/godot/issues/109800","id":3205928949,"node_id":"IC_kwDOAO6SJc6_Fpf1","user":{"login":"KoBeWi","id":2223172,"node_id":"MDQ6VXNlcjIyMjMxNzI=","avatar_url":"https://avatars.githubusercontent.com/u/2223172?v=4","gravatar_id":"","url":"https://api.github.com/users/KoBeWi","html_url":"https://github.com/KoBeWi","followers_url":"https://api.github.com/users/KoBeWi/followers","following_url":"https://api.github.com/users/KoBeWi/following{/other_user}","gists_url":"https://api.github.com/users/KoBeWi/gists{/gist_id}","starred_url":"https://api.github.com/users/KoBeWi/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/KoBeWi/subscriptions","organizations_url":"https://api.github.com/users/KoBeWi/orgs","repos_url":"https://api.github.com/users/KoBeWi/repos","events_url":"https://api.github.com/users/KoBeWi/events{/privacy}","received_events_url":"https://api.github.com/users/KoBeWi/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-08-20T11:52:06Z","updated_at":"2025-08-20T11:52:06Z","body":"> This PR includes the changing of double literals to float literals, and using real_t consistently to avoid needless casting.\r\n\r\nIsn't the casting done at compile time? Why using float literals even matter?","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3205928949/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3206073743","html_url":"https://github.com/godotengine/godot/pull/109800#issuecomment-3206073743","issue_url":"https://api.github.com/repos/godotengine/godot/issues/109800","id":3206073743,"node_id":"IC_kwDOAO6SJc6_GM2P","user":{"login":"aaronfranke","id":1646875,"node_id":"MDQ6VXNlcjE2NDY4NzU=","avatar_url":"https://avatars.githubusercontent.com/u/1646875?v=4","gravatar_id":"","url":"https://api.github.com/users/aaronfranke","html_url":"https://github.com/aaronfranke","followers_url":"https://api.github.com/users/aaronfranke/followers","following_url":"https://api.github.com/users/aaronfranke/following{/other_user}","gists_url":"https://api.github.com/users/aaronfranke/gists{/gist_id}","starred_url":"https://api.github.com/users/aaronfranke/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/aaronfranke/subscriptions","organizations_url":"https://api.github.com/users/aaronfranke/orgs","repos_url":"https://api.github.com/users/aaronfranke/repos","events_url":"https://api.github.com/users/aaronfranke/events{/privacy}","received_events_url":"https://api.github.com/users/aaronfranke/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-08-20T12:16:42Z","updated_at":"2025-08-20T12:16:42Z","body":"@KoBeWi If you have `something.length() > 0.0` then it will cast `something.length()` to a double at runtime if Godot is compiled with `real_t` defined as `float`. However, `something.length() > 0.0f` has no runtime casts, because it's either float on both sides, or if Godot is compiled with doubles, `0.0f` is compile-time casted to double.","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/3206073743/reactions","total_count":4,"+1":4,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/godotengine/godot/issues/comments/4790853661","html_url":"https://github.com/godotengine/godot/pull/109800#issuecomment-4790853661","issue_url":"https://api.github.com/repos/godotengine/godot/issues/109800","id"