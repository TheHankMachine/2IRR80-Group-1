ub.com/repos/godotengine/godot/pulls/121251","html_url":"https://github.com/godotengine/godot/pull/121251","diff_url":"https://github.com/godotengine/godot/pull/121251.diff","patch_url":"https://github.com/godotengine/godot/pull/121251.patch","merged_at":"2026-07-13T15:44:20Z"},"body":"## What problem(s) does this PR solve?\r\n\r\nFixes #121250\r\nSometime between the 4.7-dev2 and dev3 cycle, zoom factor stopped getting applied to the script editor should the editor start with it displayed, only applying once visibility changes (such as moving to 2D view and then back to the script view) \r\n\r\nThis applies the zoom just before the scripts are initialized, letting the edit method pull the correct value.\r\n\r\n","closed_by":{"login":"Repiteo","id":17489292,"node_id":"MDQ6VXNlcjE3NDg5Mjky","avatar_url":"https://avatars.githubusercontent.com/u/17489292?v=4","gravatar_id":"","url":"https://api.github.com/users/Repiteo","html_url":"https://github.com/Repiteo","followers_url":"https://api.github.com/users/Repiteo/followers","following_url":"https://api.github.com/users/Repiteo/following{/other_user}","gists_url":"https://api.github.com/users/Repiteo/gists{/gist_id}","starred_url":"https://api.github.com/users/Repiteo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Repiteo/subscriptions","organizations_url":"https://api.github.com/users/Repiteo/orgs","repos_url":"https://api.github.com/users/Repiteo/repos","events_url":"https://api.github.com/users/Repiteo/events{/privacy}","received_events_url":"https://api.github.com/users/Repiteo/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/121251/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/godotengine/godot/issues/121251/timeline","performed_via_github_app":null,"state_reason":null}