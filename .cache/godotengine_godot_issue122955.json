/Repiteo/gists{/gist_id}","starred_url":"https://api.github.com/users/Repiteo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Repiteo/subscriptions","organizations_url":"https://api.github.com/users/Repiteo/orgs","repos_url":"https://api.github.com/users/Repiteo/repos","events_url":"https://api.github.com/users/Repiteo/events{/privacy}","received_events_url":"https://api.github.com/users/Repiteo/received_events","type":"User","user_view_type":"public","site_admin":false},"open_issues":345,"closed_issues":2335,"state":"open","created_at":"2026-04-13T15:59:35Z","updated_at":"2026-10-22T08:15:08Z","due_on":null,"closed_at":null},"comments":4,"created_at":"2026-08-28T22:11:03Z","updated_at":"2026-10-15T15:21:24Z","closed_at":"2026-10-15T15:21:23Z","assignee":{"login":"QbieShay","id":7917475,"node_id":"MDQ6VXNlcjc5MTc0NzU=","avatar_url":"https://avatars.githubusercontent.com/u/7917475?v=4","gravatar_id":"","url":"https://api.github.com/users/QbieShay","html_url":"https://github.com/QbieShay","followers_url":"https://api.github.com/users/QbieShay/followers","following_url":"https://api.github.com/users/QbieShay/following{/other_user}","gists_url":"https://api.github.com/users/QbieShay/gists{/gist_id}","starred_url":"https://api.github.com/users/QbieShay/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/QbieShay/subscriptions","organizations_url":"https://api.github.com/users/QbieShay/orgs","repos_url":"https://api.github.com/users/QbieShay/repos","events_url":"https://api.github.com/users/QbieShay/events{/privacy}","received_events_url":"https://api.github.com/users/QbieShay/received_events","type":"User","user_view_type":"public","site_admin":false},"author_association":"NONE","issue_field_values":[],"type":null,"active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"### Tested versions\n\nReproducible in 4.8-dev4\n(Class was not present in previous versions)\n\n### System information\n\nGodot v4.8.dev4 - Windows 11 (build 26200) - Multi-window, 2 monitors (2560x1440 @ 165.00 Hz, 2880x1620 @ 60.00 Hz) - Direct3D 12 (Forward+) - dedicated NVIDIA GeForce RTX 3060 Laptop GPU (NVIDIA; 32.0.16.1088) - 12th Gen Intel(R) Core(TM) i7-12700H (20 threads) - 63.74 GiB memory - WASAPI (48000 Hz, Stereo/mono)\n\n### Issue description\n\n_Note: I am unsure if this should be reported as a bug or if it should be treated more like an observation, but I'll report it just so it gets eyes on it, in case something needs to be adjusted, since #117107 mentions that the Trail3D addition is based on the CozyCube addon._\n\nAs user of the specific CozyCube lines and trails addon from before the latest dev release, I was looking into possibly replacing the addon with the native implementation and ran into one particular instance where I could not reproduce the same behavior from the addon, even trying my best to keep the parameters the closest to what I had before.\n\nHere's a comparison:\n\n**CozyCube addon + wireframe + parameters:**\n\nhttps://github.com/user-attachments/assets/dd6f0cdf-de03-469c-b49a-b3d23dbbcb14\n\nhttps://github.com/user-attachments/assets/5dea1d4f-57e7-4f54-905c-0c856d47dfaf\n\n<img width=\"297\" height=\"349\" alt=\"Image\" src=\"https://github.com/user-attachments/assets/ebae9e6d-0b13-44dd-b68d-1271464b3b1c\" />\n\n\n**Native + wireframe + parameters:**\n\nhttps://github.com/user-attachments/assets/12f5e6be-5ff3-4d72-8ab9-a6086a1080d4\n\nhttps://github.com/user-attachments/assets/cb1db53e-f70a-41b3-a0bb-f15418787a16\n\n<img width=\"295\" height=\"365\" alt=\"Image\" src=\"https://github.com/user-attachments/assets/827834b2-992c-4498-a6d7-f0d455d12ca0\" />\n\n\nAs you can see, the trail seems to produce some unwanted rotational artifacts when moving back and forth that just do not happen with the addon Trail3D implementation. I am not sure of how this is implemented natively, compared to the addon, but I thought it would be a valid thing to point out.\n\n### Steps to reproduce\n\nThis is a very specific visual problem and requires the `lines_and_trails_3d` from https://codeberg.org/MajorMcDoom/cozy-cube-godot-addons\n\n1 - Download `lines_and_trails_3d` from the linked repository\n2 - Put it in addon folder of your project\n3 - Rename the addon classes to something else (or it will shadow the native class)\n4 - Create a quick back and forth animation with the trails and see different behavior.\n\n### Minimal reproduction project (MRP)\n\nAlthough it does not have my specific animation, I have created a simple back and forth animation that still exposes the issue. The project also has the addon included with the classes renamed to `Line3DAddon` and `Trail3DAddon`.\n\nhttps://github.com/user-attachments/assets/5715ebcb-3673-438b-baf9-239ba437b1c9\n\n[trail-addon-native-comparison.zip](https://github.com/user-attachments/files/31576446/trail-addon-native-comparison.zip)\n\n\n\n_Edit: Native video had some different parameters from addon trail and the actual result in the video was slightly different than it should be, so I updated the videos and parameters._","closed_by":{"login":"KoBeWi","id":2223172,"node_id":"MDQ6VXNlcjIyMjMxNzI=","avatar_url":"https://avatars.githubusercontent.com/u/2223172?v=4","gravatar_id":"","url":"https://api.github.com/users/KoBeWi","html_url":"https://github.com/KoBeWi","followers_url":"https://api.github.com/users/KoBeWi/followers","following_url":"https://api.github.com/users/KoBeWi/following{/other_user}","gists_url":"https://api.github.com/users/KoBeWi/gists{/gist_id}","starred_url":"https://api.github.com/users/KoBeWi/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/KoBeWi/subscriptions","organizations_url":"https://api.github.com/users/KoBeWi/orgs","repos_url":"https://api.github.com/users/KoBeWi/repos","events_url":"https://api.github.com/users/KoBeWi/events{/privacy}","received_events_url":"https://api.github.com/users/KoBeWi/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/godotengine/godot/issues/122955/reactions","total_count":3,"+1":2,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":1,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/godotengine/godot/issues/122955/timeline","performed_via_github_app":null,"state_reason":"completed","pinned_comment":null}