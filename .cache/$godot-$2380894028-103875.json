[{"id":2671592148,"node_id":"PRR_kwDOAO6SJc6fPULU","state":"COMMENTED","user":{"site_admin":false,"suspended":false,"updated_at":"0001-01-01T00:00:00Z","avatar_url":"https://avatars.githubusercontent.com/u/180032?u=68d23e7ee9cdf810da125e8510b72f845b9dccc8&v=4","created_at":"0001-01-01T00:00:00Z","followers":0,"following":0,"html_url":"https://github.com/Calinou","id":180032,"node_id":"MDQ6VXNlcjE4MDAzMg==","login":"Calinou","type":"User","owned_private_repos":0,"public_gists":0,"public_repos":0,"total_private_repos":0,"url":"https://api.github.com/users/Calinou"},"body":"I suggest adding a tooltip to the **Edit**/**Run** buttons to mention that you can hold <kbd>Alt</kbd> to enable verbose mode. (Note that on macOS or Linux, this will only have a visible effect for **Run** if the editor was run from a terminal.)\r\n\r\nAlso, on Linux, this will not work out of the box on GNOME and Xfce because they use <kbd>Alt</kbd> for window manipulation shortcuts by default. There is no way for us to fix this, unless we allow an *alternative* shortcut like <kbd>Meta</kbd>. KDE defaults to <kbd>Meta</kbd> for window manipulation since 2022, so it's not affected by this issue anymore.\r\n\r\nTherefore, it may be preferable to add the actions with a dropdown menu, similar to what was done for the Edit button in the [recovery mode PR](https://github.com/godotengine/godot/pull/92563).","html_url":"https://github.com/godotengine/godot/pull/103875#pullrequestreview-2671592148","pull_request_url":"https://api.github.com/repos/godotengine/godot/pulls/103875","author_association":"MEMBER","submitted_at":"2025-03-10T16:33:15Z"},{"id":2708079309,"node_id":"PRR_kwDOAO6SJc6hagLN","state":"COMMENTED","user":{"site_admin":false,"suspended":false,"updated_at":"0001-01-01T00:00:00Z","avatar_url":"https://avatars.githubusercontent.com/u/2223172?u=fc85633b469acb6e7baef4dba5171f19a2a4ff85&v=4","created_at":"0001-01-01T00:00:00Z","followers":0,"following":0,"html_url":"https://github.com/KoBeWi","id"